-- Evaluate checked compile-time computations with a shared work budget.
-- The caller supplies a program checked in its compile-time namespace.
module Cinch.StageEval where
  import Cinch.Check (CheckedProgram)
  import Cinch.Core
  import Cinch.Guarded (guarded-reading)
  import Cinch.Proof (Arithmetic, AInteger)
  import Cinch.Instance (CoreInstance, find-instance, field-at)
  import Cinch.Nominal (stage-quotation-module, global-stage-str-nat)
  import Text.Scan (string-strip)
  import Cinch.Ast (Expr, Decl, DInterface)
  import Cinch.Builtin (scalar-intrinsic)
  import Cinch.Load (contract-intrinsic)
  import Cinch.ExportType (export-global)
  import Cinch.Infer (elaboration-core, elaboration-declarations, elaboration-method-scope, elaboration-instances)
  import Cinch.Report (Diagnostic)
  import Cinch.TotalSemantics (total-numeric-operation, total-numeric-comparison, arithmetic-constant)
  import Cinch.Total (parse-decimal-value, total-decimal-value)
  import Cinch.Type (UType, UCon, KType, integer-literal-valid, mono, scheme-arity)
  import Data.List (list-length)
  import Text.Show (nat-to-string)
  import Data.Int (int-add, int-sub, int-mul, int-neg)
  import Text.Lex (Span)

  export StageValue, StageInteger, StageBoolean, StageString, StageUnit, StageQuoted, StageCode, evaluate-stage
  export StageMachine, StageConversion, StageCallable, StageNominal, StageField, StageFieldsEnd
  export StageTemplate
  export stage-quotation-constructor

  -- The synthesized stage module and its constructor names come from
  -- Cinch.Nominal, which owns the one code identity both `Code` and
  -- `#StageCode` resolve to.
  stage-quotation-constructor :: String
  stage-quotation-constructor = "#stage-value"

  -- One quotation's template. The carrier is the `t` of its `Code t`; the
  -- body is the resolved expression whose splice sites the expander fills
  -- when the quotation is constructed. Declared before `StageValue`, which
  -- carries it: a data type cannot mention one declared later.
  record StageTemplate where
    carrier :: String
    body :: Expr

  data StageValue where
    StageInteger :: Int -> StageValue
    StageMachine :: String -> Int -> StageValue
    StageConversion :: String -> String -> StageValue
    StageBoolean :: Bool -> StageValue
    StageString :: String -> StageValue
    StageCallable :: String -> String -> UType -> StageValue -> StageValue
    StageNominal :: String -> StageValue -> StageValue
    StageField :: StageValue -> StageValue -> StageValue
    StageFieldsEnd :: StageValue
    StageUnit :: StageValue
    -- A checked scalar the stage evaluator computed, reified back into a
    -- term at its splice site.
    StageQuoted :: StageValue -> StageValue
    -- A typed quotation (modules specification section 7): its resolved
    -- template with every splice still in place, and the carrier type it
    -- produces. The template travels as source because the expander
    -- re-checks it where the code lands, exactly as the seed retains its
    -- template beside the reified body.
    StageCode :: StageTemplate -> StageValue

  record StageEnvironment where
    definitions :: List CoreDefinition
    declarations :: List Decl
    scope :: ProofScope
    instances :: List CoreInstance
    self :: Option (String, CoreInstance)

  data StageMatch where
    Match :: List (Nat, StageValue) -> StageMatch
    NoMatch :: StageMatch
    UnavailablePattern :: Span -> StageMatch

  stage-error :: forall a. Span -> String -> Result (List Diagnostic) a
  stage-error site message = Err [Diagnostic "bootstrap.stage" site message]

  definition-for :: String -> List CoreDefinition -> Option CoreDefinition
  definition-for name definitions = case definitions of
    [] -> None
    definition : rest -> if definition.name == name then Some definition else definition-for name rest

  exported-definition :: String -> List CoreDefinition -> Option CoreDefinition
  exported-definition name definitions = case definitions of
    [] -> None
    definition : rest -> case export-global (definition.name) of
      Ok identity -> if identity == name then Some definition else exported-definition name rest
      Err message -> exported-definition name rest

  evaluate-stage :: CheckedProgram -> Span -> String -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-stage checked site name fuel = let typed = checked.elaboration in
    let definitions = elaboration-core typed in
    let scope = elaboration-method-scope typed in
    case exported-definition name definitions of
      Some definition -> evaluate-definition (StageEnvironment definitions (elaboration-declarations typed) scope (elaboration-instances typed) None) site definition [] fuel
      None -> stage-error site (string-concat "missing checked compile-time definition: " name)

  match-stage-pattern :: CorePattern -> StageValue -> List (Nat, StageValue) -> StageMatch
  match-stage-pattern pattern value locals = case pattern of
    CPVar site ty id name -> Match ((id, value) : locals)
    CPAs site ty id name nested -> match-stage-pattern nested value ((id, value) : locals)
    CPWild site ty -> Match locals
    CPInt site ty text -> case (total-decimal-value text, value) of
      (Some expected, StageInteger actual) -> if expected == actual then Match locals else NoMatch
      other -> NoMatch
    CPString site ty text -> case value of
      StageString actual -> if text == actual then Match locals else NoMatch
      other -> NoMatch
    CPConstructor site result name actuals ty fields -> case value of
      StageBoolean actual -> if name == (if actual then "True" else "False") then match-stage-fields fields StageFieldsEnd locals else NoMatch
      StageNominal constructor values -> if name == constructor then match-stage-fields fields values locals else NoMatch
      other -> NoMatch
    other -> UnavailablePattern (Span 0 0 0 0)

  match-stage-fields :: CorePattern -> StageValue -> List (Nat, StageValue) -> StageMatch
  match-stage-fields fields values locals = case (fields, values) of
    (CPDone site, StageFieldsEnd) -> Match locals
    (CPField at pattern tail, StageField first rest) -> (case match-stage-pattern pattern first locals of
      Match found -> match-stage-fields tail rest found
      other -> other)
    other -> NoMatch

  match-stage-patterns :: List CorePattern -> List StageValue -> List (Nat, StageValue) -> StageMatch
  match-stage-patterns patterns values locals = case (patterns, values) of
    ([], []) -> Match locals
    (pattern : rest, value : more) -> case match-stage-pattern pattern value locals of
      Match found -> match-stage-patterns rest more found
      NoMatch -> NoMatch
      UnavailablePattern site -> UnavailablePattern site
    other -> NoMatch

  stage-local :: Nat -> List (Nat, StageValue) -> Option StageValue
  stage-local id locals = case locals of
    [] -> None
    (key, value) : rest -> if id == key then Some value else stage-local id rest

  evaluate-definition :: StageEnvironment -> Span -> CoreDefinition -> List StageValue -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-definition definitions site definition values fuel = case definition.givens of
    [] -> evaluate-clauses definitions site (definition.name) (definition.clauses) values fuel
    other -> stage-error site "dictionary arguments are unavailable in compile-time evaluation"

  evaluate-clauses :: StageEnvironment -> Span -> String -> List CoreClause -> List StageValue -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-clauses definitions site name clauses values fuel = if fuel == 0 then stage-error site "compile-time evaluation exhausted its work budget" else
    case clauses of
      [] -> stage-error site (string-concat-all ["no checked compile-time clause matches ", name, " with ", nat-to-string (list-length values), " arguments"])
      (CoreClause clause-site patterns body) : rest -> case match-stage-patterns patterns values [] of
        Match locals -> evaluate-term definitions locals clause-site body (fuel - 1)
        NoMatch -> evaluate-clauses definitions site name rest values (fuel - 1)
        UnavailablePattern pattern-site -> stage-error pattern-site "pattern is unavailable in compile-time evaluation"

  -- Calls evaluate operands before invoking the checked target. A refused
  -- inner intrinsic is reported even when the outer call is also unavailable.
  evaluate-terms :: StageEnvironment -> List (Nat, StageValue) -> Span -> List CoreTerm -> Nat -> Result (List Diagnostic) (List StageValue, Nat)
  evaluate-terms definitions locals site arguments fuel = case arguments of
    [] -> Ok ([], fuel)
    first : rest -> case evaluate-term definitions locals site first fuel of
      Err errors -> Err errors
      Ok (value, remaining) -> case evaluate-terms definitions locals site rest remaining of
        Err errors -> Err errors
        Ok (values, done) -> Ok (value : values, done)

  evaluate-use :: StageEnvironment -> Span -> UType -> String -> String -> List StageValue -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-use definitions site ty name role values fuel =
    if role == "intrinsic" || role == "foreign" then
      (case (if role == "intrinsic" then conversion-shape name else None) of
        Some (source, result) -> apply-conversion site source result values fuel
        None -> stage-error site (string-concat-all ["primitive `", name, "` is not available at compile time"]))
    else if role == "external" && name == global-stage-str-nat then (case values of
      [StageString text] -> case parse-decimal-value (string-strip text) of
        Some value | value >= 0 -> Ok (StageInteger value, fuel)
        Some negative -> stage-error site "`strNat` rejects a negative `Nat`"
        None -> stage-error site (string-concat-all ["`strNat` needs decimal digits, got `", text, "`"])
      other -> stage-error site "`strNat` requires one string")
    else if role == "constructor" then
      (if list-length values < scheme-arity (mono ty) then Ok (StageCallable name role ty (stage-fields values), fuel)
       else evaluate-constructor site ty name values fuel)
    else case definition-for name (definitions.definitions) of
      Some definition -> (case definition.clauses of
        (CoreClause at patterns body) : rest | list-length values < list-length patterns ->
          Ok (StageCallable name role ty (stage-fields values), fuel)
        other -> evaluate-definition definitions site definition values fuel)
      None -> case (definitions, export-global name) of
        (StageEnvironment core declarations scope instances self, Ok identity) | (role == "external") ->
          (case imported-conversion identity declarations of
            Some (source, result) -> apply-conversion site source result values fuel
            None -> stage-error site (string-concat "definition is not available at compile time: " name))
        other -> stage-error site (string-concat "definition is not available at compile time: " name)

  -- Widening preserves the mathematical value at both carrier boundaries.
  -- An imported binding is identified by its defining intrinsic declaration.
  conversion-shape :: String -> Option (String, String)
  conversion-shape symbol = case scalar-intrinsic symbol of
    Some operation -> (case operation.operation-arguments of
      [source] | (operation.operation-code == "widen") ->
        Some (source.shape-name, operation.operation-result.shape-name)
      other -> None)
    None -> if symbol == "cinch.runtime.intFromI64" then Some ("I64", "Int")
      else if symbol == "cinch.runtime.natFromI64" then Some ("I64", "Nat") else None

  apply-conversion :: Span -> String -> String -> List StageValue -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  apply-conversion site source result values fuel = case values of
    [] -> Ok (StageConversion source result, fuel)
    [StageMachine carrier value] | (source == carrier) && integer-literal-valid (UCon result KType) value ->
      Ok (if result == "Nat" || result == "Int" then StageInteger value else StageMachine result value, fuel)
    other -> stage-error site "invalid compile-time integer conversion"

  imported-conversion :: String -> List Decl -> Option (String, String)
  imported-conversion identity declarations = case declarations of
    [] -> None
    (DInterface sp owner hash metadata) : rest -> (case contract-intrinsic identity owner metadata of
      Some symbol -> conversion-shape symbol
      None -> imported-conversion identity rest)
    other : rest -> imported-conversion identity rest

  stage-fields :: List StageValue -> StageValue
  stage-fields values = case values of
    [] -> StageFieldsEnd
    first : rest -> StageField first (stage-fields rest)

  prepend-stage-fields :: StageValue -> List StageValue -> List StageValue
  prepend-stage-fields fields values = case fields of
    StageField first rest -> first : (prepend-stage-fields rest values)
    other -> values

  evaluate-constructor :: Span -> UType -> String -> List StageValue -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-constructor site ty name values fuel =
    if not (scheme-arity (mono ty) == list-length values) then stage-error site "unsaturated compile-time constructor"
    else case (ty, values) of
      (UCon carrier KType, []) | (carrier == "Bool") && (name == "True" || name == "False") -> Ok (StageBoolean (name == "True"), fuel)
      (other, [value]) -> (case export-global name of
        Ok identity | (identity == string-concat-all [stage-quotation-module, ".", stage-quotation-constructor]) -> Ok (StageQuoted value, fuel)
        other -> Ok (StageNominal name (stage-fields values), fuel))
      other -> Ok (StageNominal name (stage-fields values), fuel)

  evaluate-alternatives :: StageEnvironment -> List (Nat, StageValue) -> Span -> StageValue -> CoreTerm -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-alternatives definitions locals site value arms fuel = if fuel == 0 then stage-error site "compile-time evaluation exhausted its work budget" else
    case arms of
      CAlternative at pattern body rest -> (case match-stage-pattern pattern value locals of
        Match found -> evaluate-term definitions found at body (fuel - 1)
        NoMatch -> evaluate-alternatives definitions locals site value rest (fuel - 1)
        UnavailablePattern sp -> stage-error sp "pattern is unavailable in compile-time evaluation")
      other -> stage-error site "no checked compile-time case alternative matches"

  evaluate-application :: StageEnvironment -> List (Nat, StageValue) -> Span -> CoreTerm -> List CoreTerm -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-application definitions locals site term arguments fuel = if fuel == 0 then stage-error site "compile-time evaluation exhausted its work budget" else
    case term of
      CApply at ty f x -> evaluate-application definitions locals at f (x : arguments) (fuel - 1)
      CUse at ty name role actuals -> case evaluate-terms definitions locals site arguments (fuel - 1) of
        Err errors -> Err errors
        Ok (values, remaining) -> evaluate-use definitions at ty name role values remaining
      CMethod at ty name owner slot actuals [evidence] -> (case evaluate-terms definitions locals at arguments (fuel - 1) of
        Ok (values, remaining) -> evaluate-method definitions at term slot evidence arguments values remaining
        Err errors -> Err errors)
      other -> case evaluate-term definitions locals site term (fuel - 1) of
        Ok (StageCallable name role ty captured, next) -> (case evaluate-terms definitions locals site arguments next of
          Ok (values, remaining) -> evaluate-use definitions site ty name role (prepend-stage-fields captured values) remaining
          Err errors -> Err errors)
        Ok (StageConversion source result, next) -> (case evaluate-terms definitions locals site arguments next of
          Ok (values, remaining) -> apply-conversion site source result values remaining
          Err errors -> Err errors)
        Ok other-value -> stage-error site "indirect application is unavailable in compile-time evaluation"
        Err errors -> Err errors

  -- The checked factory or method's lexical self evidence selects the field.
  -- Imported arithmetic is interpreted from the selected field's total body.
  evaluate-method :: StageEnvironment -> Span -> CoreTerm -> Nat -> CoreEvidence -> List CoreTerm -> List StageValue -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-method environment site method slot evidence arguments values fuel = case environment of
    StageEnvironment core declarations scope instances self ->
      let source = (case (evidence, self) of
        (CEInstance at ty name actuals (CEArgumentsEnd end), other) -> find-instance name instances
        (CEGiven at ty name, Some (symbol, dictionary)) | (name == symbol) -> Some dictionary
        other -> None) in
      (case source of
        Some dictionary -> (case field-at slot (dictionary.fields) of
          Some field -> let definition = field.field-definition in (case definition.givens of
            [given] -> evaluate-clauses (StageEnvironment core declarations scope instances (Some (given.symbol, dictionary)))
              site (definition.name) (definition.clauses) values fuel
            other -> stage-error site "selected compile-time method requires additional dictionary arguments")
          None -> stage-error site "selected compile-time dictionary has no method at this slot")
        None -> (case arguments of
          [first, second] -> (case selected-method-function scope method (core-type first) (core-type second) of
            Some function -> (case (case total-numeric-operation function of Some op -> Some op; None -> total-numeric-comparison function) of
              Some op -> evaluate-primitive site op values fuel
              None -> stage-error site "selected method body is unavailable in compile-time evaluation")
            None -> stage-error site "selected method body is unavailable in compile-time evaluation")
          other -> stage-error site "selected method body is unavailable in compile-time evaluation"))

  primitive-arguments :: CoreTerm -> List CoreTerm
  primitive-arguments term = case term of
    CArgument site first rest -> first : (primitive-arguments rest)
    other -> []

  evaluate-numeric-primitive :: Span -> String -> Int -> Int -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-numeric-primitive site operation left right fuel =
    case operation of
    "+" -> Ok (StageInteger (int-add left right), fuel)
    "-" -> Ok (StageInteger (int-sub left right), fuel)
    "*" -> Ok (StageInteger (int-mul left right), fuel)
    "==" -> Ok (StageBoolean (left == right), fuel)
    "/=" -> Ok (StageBoolean (left /= right), fuel)
    "<" -> Ok (StageBoolean (left < right), fuel)
    "<=" -> Ok (StageBoolean (left <= right), fuel)
    ">" -> Ok (StageBoolean (left > right), fuel)
    ">=" -> Ok (StageBoolean (left >= right), fuel)
    _ -> stage-error site (string-concat "operation is unavailable in compile-time evaluation: " operation)

  evaluate-primitive :: Span -> String -> List StageValue -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-primitive site operation values fuel = case values of
    [] -> if operation == "decision-true" || operation == "decision-false" then Ok (StageBoolean (operation == "decision-true"), fuel)
      else stage-error site (string-concat "operation is unavailable in compile-time evaluation: " operation)
    [StageInteger value] -> if operation == "negate" then Ok (StageInteger (int-neg value), fuel)
      else stage-error site (string-concat "operation is unavailable in compile-time evaluation: " operation)
    (StageInteger left) : ([StageInteger right]) -> evaluate-numeric-primitive site operation left right fuel
    other -> stage-error site (string-concat "operation is unavailable in compile-time evaluation: " operation)

  natural-arguments :: List StageValue -> Option (List Arithmetic)
  natural-arguments values = case values of
    [] -> Some []
    (StageInteger n) : rest | n >= 0 -> (case natural-arguments rest of
      Some more -> Some ((AInteger n) : more)
      None -> None)
    other -> None

  -- Only the checked discharge can admit a conditional body. Read its
  -- defining expression with the actual values from this call.
  evaluate-discharged :: StageEnvironment -> List (Nat, StageValue) -> Span -> CoreTerm -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-discharged environment locals site body fuel = case environment of
    StageEnvironment core declarations scope instances self -> (case guarded-call-spine scope body [] of
      None -> evaluate-term environment locals site body fuel
      Some (binding, arguments) -> (case evaluate-terms environment locals site arguments fuel of
        Err errors -> Err errors
        Ok (values, remaining) -> (case natural-arguments values of
          Some inputs -> (case guarded-reading binding inputs of
            Some expression -> (case arithmetic-constant expression of
              Some result | result >= 0 -> Ok (StageInteger result, remaining)
              other -> stage-error site "conditional compile-time body returned an invalid Nat")
            None -> stage-error site "conditional compile-time body has no checked reading")
          None -> stage-error site "conditional compile-time body requires Nat arguments")))

  evaluate-term :: StageEnvironment -> List (Nat, StageValue) -> Span -> CoreTerm -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-term definitions locals site term fuel = if fuel == 0 then stage-error site "compile-time evaluation exhausted its work budget" else
    let remaining = fuel - 1 in case term of
      CInt at (UCon carrier KType) text -> (case total-decimal-value text of
        Some value | integer-literal-valid (UCon carrier KType) value ->
          Ok (if carrier == "Nat" || carrier == "Int" then StageInteger value else StageMachine carrier value, remaining)
        other -> stage-error at "invalid checked compile-time integer")
      CString at ty text -> Ok (StageString text, remaining)
      CUnit at ty -> Ok (StageUnit, remaining)
      CLocal at ty id name actuals -> case stage-local id locals of
        Some value -> Ok (value, remaining)
        None -> stage-error at "missing checked compile-time local binding"
      CUse at ty name role actuals -> evaluate-use definitions at ty name role [] remaining
      CApply at ty f x -> evaluate-application definitions locals at f [x] remaining
      CApplyEff at ty row f x -> stage-error at "effectful call is unavailable in compile-time evaluation"
      CLet at ty id name sc rhs body -> case evaluate-term definitions locals at rhs remaining of
        Err errors -> Err errors
        Ok (value, next) -> evaluate-term definitions ((id, value) : locals) at body next
      CCase at ty subject arms -> (case evaluate-term definitions locals at subject remaining of
        Ok (value, next) -> evaluate-alternatives definitions locals at value arms next
        Err errors -> Err errors)
      CIf at ty condition yes no -> case evaluate-term definitions locals at condition remaining of
        Err errors -> Err errors
        Ok (StageBoolean branch, next) -> evaluate-term definitions locals at (if branch then yes else no) next
        Ok other -> stage-error at "checked compile-time branch requires Bool"
      CProved at ty certificate body -> evaluate-term definitions locals at body remaining
      CRefine at ty certificate body -> evaluate-term definitions locals at body remaining
      CForget at ty body -> evaluate-term definitions locals at body remaining
      CCast at ty body -> evaluate-term definitions locals at body remaining
      CDischarge at ty proofs _ body -> evaluate-discharged definitions locals at body remaining
      CPrimitive at ty operation arguments -> case evaluate-terms definitions locals at (primitive-arguments arguments) remaining of
        Err errors -> Err errors
        Ok (values, next) -> evaluate-primitive at operation values next
      other -> stage-error site "expression is unavailable in compile-time evaluation"
