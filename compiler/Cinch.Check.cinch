-- Cinch.Check: rung 3 of the bootstrap ladder, the fragment checker.
--
-- `check-program` walks the tree `Cinch.Ast` declares and returns the
-- list of failures, empty meaning the program is accepted. Every failure is
-- a named, spanned `Cinch.Report` diagnostic: an unbound variable, a
-- type mismatch, an arity mismatch against a declared signature, a missing
-- or duplicated signature, a constructor used at the wrong arity, and every
-- form outside this rung's fragment refused BY NAME (including each
-- `*Unmodeled` node, with the source text the parser recorded).
--
-- THE FRAGMENT. Types: `Int`, `Bool`, `Unit`, `String`, `Char`, and a
-- program-declared type name (with arguments). Terms: integer, string and
-- character literals, `Unit`; variables; application; `EBin` over `+ - * /`
-- (with both sides `Int`, result `Int`), `== /=` (both sides the same
-- comparable type, result `Bool`) and `< > <= >=` (both sides `Int`, result
-- `Bool`); `EIf`; `EAnn`; `ELet` (a binding spine, scoped sequentially);
-- `ELam`; `ECase`; and constructor application. Patterns: wildcard,
-- variable, integer, string and character literals, and a constructor
-- applied to argument patterns. Declarations: `DSig` + `DFun` (the clause's
-- patterns consume a prefix of the signature; its body checks against the
-- remaining function type, and a clause an
-- earlier clause already matches is refused), recursion between top-level
-- functions (the registry is built before any body is checked), and `DData`
-- (each constructor's argument types and its result type, which must be the
-- type it is declared under).
--
-- Cinch.Infer now checks rank-one schemes, inferred lambdas, let
-- generalization and regular parameterized constructors. It validates
-- kinds, rigid variables, positivity and pattern coverage. Dictionaries,
-- effects, existential/indexed constructors and refinements still need
-- their full elaboration. The legacy scalar path below preserves the
-- rung's diagnostics while typed elaboration and lowering are ported.
--
-- LEGACY TYPES. This path carries its own small type language (`Ty`, below)
-- rather than reusing `TypeExpr`: a body is checked against a known type
-- (the signature's, an annotation's, or an inferred function's), and the
-- only "unknown" is `TyHole`, which compares equal to everything so one
-- failure does not cascade into a dozen. There is no unifier: an expression
-- whose type cannot be inferred syntactically (a lambda with no expected
-- function type) is refused by name rather than guessed at.
module Cinch.Check where

  import Text.Lex (Span, span-start, span-end, span-line, span-col)
  import Algebra.Semigroup
  import Cinch.Ast
  import Cinch.Report
  import Cinch.Document
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Cinch.Core (CoreDefinition)
  import Cinch.Parallel (CompileTuning, default-tuning)
  import Cinch.Load (LoadedInterface, ValidatedInterfaces)
  import Cinch.Infer (Elaboration, elaborate-with-interfaces, elaborate-with-admitted-interfaces, elaborate-with-interfaces-tuned, elaborate-with-admitted-interfaces-tuned, prepare-admitted-elaboration, prepare-admitted-elaboration-tuned, prepare-admitted-elaboration-cached, needs-inference, infer-program)

  export check-program, CheckedProgram, with-generated, check-and-retain, check-and-retain-with-interfaces, check-and-retain-with-admitted-interfaces
  export check-and-retain-with-interfaces-tuned, check-and-retain-with-admitted-interfaces-tuned
  export prepare-admitted-check, prepare-admitted-check-tuned, prepare-admitted-check-cached

  -- The constructor stays private. A backend receives the resolved source
  -- and retained typed declarations only after the current independent
  -- global/kind/term/proof checks have accepted that same program.
  record CheckedProgram where
    surface :: Program
    elaboration :: Elaboration
    generated :: List (String, List String)

  with-generated :: List (String, List String) -> CheckedProgram -> CheckedProgram
  with-generated names checked = case checked of CheckedProgram surface typed generated -> CheckedProgram surface typed names

  check-and-retain :: Program -> Result (List Diagnostic) CheckedProgram
  check-and-retain program = check-and-retain-with-interfaces [] program
  check-and-retain-with-interfaces :: List LoadedInterface -> Program -> Result (List Diagnostic) CheckedProgram
  check-and-retain-with-interfaces known program = check-and-retain-with-interfaces-tuned default-tuning known program
  check-and-retain-with-interfaces-tuned :: CompileTuning -> List LoadedInterface -> Program -> Result (List Diagnostic) CheckedProgram
  check-and-retain-with-interfaces-tuned tuning known program = check-and-retain-using (elaborate-with-interfaces-tuned tuning known rung) program
  check-and-retain-with-admitted-interfaces :: ValidatedInterfaces -> Program -> Result (List Diagnostic) CheckedProgram
  check-and-retain-with-admitted-interfaces admitted program = check-and-retain-with-admitted-interfaces-tuned default-tuning admitted program
  check-and-retain-with-admitted-interfaces-tuned :: CompileTuning -> ValidatedInterfaces -> Program -> Result (List Diagnostic) CheckedProgram
  check-and-retain-with-admitted-interfaces-tuned tuning admitted program = check-and-retain-using (elaborate-with-admitted-interfaces-tuned tuning admitted rung) program
  prepare-admitted-check :: ValidatedInterfaces -> (Bool -> Program -> Result (List Diagnostic) CheckedProgram)
  prepare-admitted-check admitted = prepare-admitted-check-tuned default-tuning admitted
  prepare-admitted-check-tuned :: CompileTuning -> ValidatedInterfaces -> (Bool -> Program -> Result (List Diagnostic) CheckedProgram)
  prepare-admitted-check-tuned tuning admitted =
    let elaborate = prepare-admitted-elaboration-tuned tuning admitted rung in
    \retained program -> check-and-retain-using (elaborate retained) program
  prepare-admitted-check-cached :: ValidatedInterfaces -> (CompileTuning -> Bool -> HashMap String CoreDefinition -> Program -> Result (List Diagnostic) CheckedProgram)
  prepare-admitted-check-cached admitted =
    let elaborate = prepare-admitted-elaboration-cached admitted rung in
    \tuning retained cached program -> check-and-retain-using (elaborate tuning retained cached) program
  check-and-retain-using :: (Program -> Elaboration) -> Program -> Result (List Diagnostic) CheckedProgram
  check-and-retain-using elaborate program =
    let legacy = if needs-inference program then [] else case program of Program s modules -> check-modules modules in
    case legacy of
      first : rest -> Err legacy
      [] -> let typed = elaborate program in
        case typed.errors of
          [] -> Ok (CheckedProgram program typed [])
          found -> Err found

  -- The diagnostics list is appended with the `Semigroup` operator (the
  -- prelude spells list append through it). Its defining module supplies
  -- the fixity with the imported operator.

  -- The rung's name in every diagnostic it renders.
  rung :: String
  rung = "bootstrap.check"

  -- A zero-width span at the start of the file: a node the checker
  -- synthesizes (a registry entry's spine) has no source position.
  zero-span :: Span
  zero-span = Span 0 0 0 0

  -- One failure, at `s`, with `msg`.
  fail :: Span -> String -> List Diagnostic
  fail s msg = [Diagnostic rung s msg]

  -- ------------------------------------------------------------------ types

  -- The checker's type language: the fragment's closed set, a function
  -- type, a named type applied to an argument spine, the spine cells
  -- themselves, and the error type.
  data Ty where
    TyInt :: Ty
    TyBool :: Ty
    TyUnit :: Ty
    TyStr :: Ty
    TyChr :: Ty
    TyFun :: Ty -> Ty -> Ty
    TyCon :: String -> Ty -> Ty
    TyTuple :: Ty -> Ty
    TyArg :: Span -> Ty -> Ty -> Ty
    TyArgsEnd :: Span -> Ty
    TyHole :: Ty

  -- ------------------------------------------------------------------ the
  -- top-level registry: one entry per signature and per constructor,
  -- collected before any body is checked so top-level functions may be
  -- mutually recursive.

  record Registry where
    signatures :: HashMap String Ty
    constructors :: HashMap String ()
    globals :: HashMap String Ty

  record Environment where
    locals :: List (String, Ty)
    globals :: HashMap String Ty

  -- ----------------------------------------------------------- type display

  -- A type as the diagnostics name it.
  ty-text :: Ty -> String
  ty-text t = case t of
    TyInt -> "Int"
    TyBool -> "Bool"
    TyUnit -> "Unit"
    TyStr -> "String"
    TyChr -> "Char"
    TyHole -> "_"
    TyFun a b -> string-concat "(" (string-concat (ty-text a) (string-concat " -> " (string-concat (ty-text b) ")")))
    TyCon n args -> string-concat n (ty-args-text args)
    TyTuple args -> string-concat "(" (string-concat (ty-args-text args) ")")
    TyArg s x rest -> string-concat " " (string-concat (ty-text x) (ty-args-text rest))
    TyArgsEnd s -> empty-string

  ty-args-text :: Ty -> String
  ty-args-text t = case t of
    TyArgsEnd s -> empty-string
    TyArg s x rest -> string-concat " " (string-concat (ty-text x) (ty-args-text rest))
    other -> empty-string

  -- ----------------------------------------------------------- type equality

  -- Structural equality; `TyHole` is unknown and equal to everything, so a
  -- failure is reported once, where it happened, instead of at every use.
  ty-equal :: Ty -> Ty -> Bool
  ty-equal a b = case a of
    TyHole -> True
    TyInt -> ty-is b "int"
    TyBool -> ty-is b "bool"
    TyUnit -> ty-is b "unit"
    TyStr -> ty-is b "string"
    TyChr -> ty-is b "char"
    TyFun d1 c1 -> case b of
      TyFun d2 c2 -> if ty-equal d1 d2 then ty-equal c1 c2 else False
      other -> False
    TyCon n1 sp1 -> case b of
      TyCon n2 sp2 -> if n1 == n2 then ty-spine-equal sp1 sp2 else False
      other -> False
    TyTuple xs -> case b of
      TyTuple ys -> ty-spine-equal xs ys
      other -> False
    TyArg s x rest -> case b of
      TyArg s2 y rest2 -> if ty-equal x y then ty-spine-equal rest rest2 else False
      other -> False
    TyArgsEnd s -> case b of
      TyArgsEnd s2 -> True
      other -> False

  -- A nullary tag's comparison: kept separate so `ty-equal`'s equations
  -- stay readable.
  ty-is :: Ty -> String -> Bool
  ty-is t tag =
    case tag of
    "int" -> ty-is-int t
    "bool" -> ty-is-bool t
    "unit" -> ty-is-unit t
    "string" -> ty-is-str t
    _ -> ty-is-chr t

  ty-is-int :: Ty -> Bool
  ty-is-int t = case t of
    TyInt -> True
    other -> False

  ty-is-bool :: Ty -> Bool
  ty-is-bool t = case t of
    TyBool -> True
    other -> False

  ty-is-unit :: Ty -> Bool
  ty-is-unit t = case t of
    TyUnit -> True
    other -> False

  ty-is-str :: Ty -> Bool
  ty-is-str t = case t of
    TyStr -> True
    other -> False

  ty-is-chr :: Ty -> Bool
  ty-is-chr t = case t of
    TyChr -> True
    other -> False

  ty-spine-equal :: Ty -> Ty -> Bool
  ty-spine-equal a b = case a of
    TyArgsEnd s -> case b of
      TyArgsEnd s2 -> True
      other -> False
    TyArg s x rest -> case b of
      TyArg s2 y rest2 -> if ty-equal x y then ty-spine-equal rest rest2 else False
      other -> False
    other -> False

  -- --------------------------------------------------- type shape helpers

  -- The number of arrows in a type: a clause's parameter count.
  ty-arity :: Ty -> Nat
  ty-arity t = case t of
    TyFun a b -> 1 + ty-arity b
    other -> 0

  -- The argument types, left to right.
  ty-arg-types :: Ty -> List Ty
  ty-arg-types t = case t of
    TyFun a b -> a : (ty-arg-types b)
    other -> []

  -- The type under every arrow.
  ty-result :: Ty -> Ty
  ty-result t = case t of
    TyFun a b -> ty-result b
    other -> t

  -- A definition may return a function rather than bind every argument.
  -- Only arrows consumed by actual clause patterns leave the expected type.
  ty-after-args :: Ty -> Nat -> Ty
  ty-after-args ty count = if count == 0 then ty else case ty of
    TyFun domain result -> ty-after-args result (count - 1)
    other -> TyHole

  -- The head name of a named type (used to match a constructor pattern's
  -- expected type against the constructor's result).
  ty-head-name :: Ty -> Option String
  ty-head-name t = case t of
    TyCon n sp -> Some n
    other -> None

  -- Whether a type is worth comparing with `==`: a function is not.
  ty-comparable :: Ty -> Bool
  ty-comparable t = case t of
    TyFun a b -> False
    other -> True

  -- A spine of the argument types collected so far.
  ty-spine-of-list :: List Ty -> Ty
  ty-spine-of-list ts = case ts of
    [] -> TyArgsEnd zero-span
    t : rest -> TyArg zero-span t (ty-spine-of-list rest)

  -- A constructor's function type: its argument types arrowed onto the
  -- type it constructs.
  ctor-ty :: String -> Ty -> Ty
  ctor-ty owner args = case args of
    TyArgsEnd s -> TyCon owner (TyArgsEnd zero-span)
    TyArg s x rest -> TyFun x (ctor-ty owner rest)
    other -> TyCon owner (TyArgsEnd zero-span)

  -- A mismatch at `s`, when the two types really differ.
  ty-compare :: Span -> Ty -> Ty -> List Diagnostic
  ty-compare s found expected =
    if ty-equal found expected then []
    else fail s (string-concat "type mismatch: expected " (string-concat (ty-text expected) (string-concat ", found " (ty-text found))))

  -- ----------------------------------------------------------- TypeExpr -> Ty

  -- The primitives by name; anything else is a named type with no
  -- arguments (a program-declared type, or a name this fragment treats as
  -- opaque).
  prim-ty :: String -> Ty
  prim-ty n =
    case n of
    "Int" -> TyInt
    "Bool" -> TyBool
    "Unit" -> TyUnit
    "String" -> TyStr
    "Char" -> TyChr
    _ -> TyCon n (TyArgsEnd zero-span)

  type-head-name :: TypeExpr -> Option String
  type-head-name t = case t of
    TName s n -> Some n
    TApp s h args -> type-head-name h
    other -> None

  type-to-ty :: TypeExpr -> (Ty, List Diagnostic)
  type-to-ty t = case t of
    TName s n -> (prim-ty n, [])
    TIndex s n -> (TyHole, fail s "unsupported type: index literal")
    TNegate s x -> (TyHole, fail s "unsupported type: index negation")
    TIndexLambda s name body -> (TyHole, fail s "an index lambda needs a checked proposition operand")
    TInfix s op a b -> (TyHole, fail s "unsupported type: predicate or index operation")
    TRefined s predicate carrier -> (TyHole, fail s "unsupported type: refined result")
    TApp s h args -> type-app-to-ty h args
    TFun s a b -> case type-to-ty a of
      (ta, da) -> case type-to-ty b of
        (tb, db) -> (TyFun ta tb, da <> db)
    TFunEff s a row b -> (TyHole, fail s "unsupported type: effect arrow")
    TUsageArrow s usage arrow -> (TyHole, fail s "usage-annotated arrow requires ownership checking")
    TRow s labels tail -> (TyHole, fail s "unsupported type: effect row")
    TTuple s xs -> case ty-spine-to-ty xs of
      (args, ds) -> (TyTuple args, ds)
    TList s xs -> (TyHole, fail s "unsupported type: type-level list")
    TStrLit s text -> (TyHole, fail s "unsupported type: type-level string literal")
    TSigma s name dom body -> (TyHole, fail s "unsupported type: sigma")
    TForall s vs body -> (TyHole, fail s "unsupported type: forall")
    TQuantifier s name is-implicit kind rest -> (TyHole, fail s "unsupported type: quantifier binder")
    TQuantifiersEnd s -> (TyHole, fail s "unsupported type: quantifier end")
    TNoKind s -> (TyHole, fail s "unsupported type: missing kind annotation")
    TUsing s bounds body -> (TyHole, fail s "unsupported type: implicit using")
    TArg s x rest -> (TyHole, fail s "unsupported type: type spine cell")
    TArgsEnd s -> (TyHole, fail s "unsupported type: type spine end")
    TBound s name ty rest -> (TyHole, fail s "unsupported type: implicit bound")
    TBoundsEnd s -> (TyHole, fail s "unsupported type: implicit bounds end")
    TEvidenceField s name ty -> (TyHole, fail s "record evidence fields require checked proposition elaboration")
    TUnpackField s enabled ty -> (TyHole, fail s "record layout requires checked nominal elaboration")
    TUnmodeled s text -> (TyHole, fail s (string-concat "unmodeled type: " text))

  type-app-to-ty :: TypeExpr -> TypeExpr -> (Ty, List Diagnostic)
  type-app-to-ty h args = case type-head-name h of
    None -> (TyHole, fail (type-expr-span h) "unsupported type: application of a non-constructor type")
    Some name -> case ty-spine-to-ty args of
      (spine, ds) -> (TyCon name spine, ds)

  -- An argument spine of `TypeExpr` as a spine of `Ty`.
  ty-spine-to-ty :: TypeExpr -> (Ty, List Diagnostic)
  ty-spine-to-ty t = case t of
    TArgsEnd s -> (TyArgsEnd s, [])
    TArg s x rest -> case type-to-ty x of
      (tx, dx) -> case ty-spine-to-ty rest of
        (tr, dr) -> (TyArg s tx tr, dx <> dr)
    other -> (TyArgsEnd (type-expr-span other), fail (type-expr-span other) "malformed type spine")

  -- ------------------------------------------------------ spine wellformedness

  -- Whether an expression spine ends in its end marker (the AST's `*-of`
  -- walkers answer the empty list for anything else, so a consumer that
  -- wants to report a malformed spine asks this first).
  spine-ok-exprs :: Expr -> Bool
  spine-ok-exprs e = case e of
    EArgsEnd s -> True
    EArg s x rest -> spine-ok-exprs rest
    other -> False

  spine-ok-pats :: Pat -> Bool
  spine-ok-pats p = case p of
    PArgsEnd s -> True
    PArg s x rest -> spine-ok-pats rest
    other -> False

  -- ------------------------------------------------------------- the registry

  -- Signatures and constructors have separate duplicate rules. A body
  -- lookup sees the most recent entry in either category, after locals
  -- and the two built-in Bool constructors.
  base-env :: Registry -> Environment
  base-env registry = case registry of
    Registry signatures constructors globals ->
      Environment [] (hash-map-insert "True" TyBool (hash-map-insert "False" TyBool globals))

  extend-env :: String -> Ty -> Environment -> Environment
  extend-env name ty env = case env of
    Environment locals globals -> Environment ((name, ty) : locals) globals

  env-lookup :: String -> Environment -> Option Ty
  env-lookup name env = case env of
    Environment locals globals -> lookup-local-or-global name locals globals

  lookup-local-or-global :: String -> List (String, Ty) -> HashMap String Ty -> Option Ty
  lookup-local-or-global name locals globals = case locals of
    [] -> hash-map-lookup name globals
    (key, ty) : rest -> if key == name then Some ty else lookup-local-or-global name rest globals

  -- ------------------------------------------------------------- expressions

  check-expr :: Environment -> Expr -> Ty -> List Diagnostic
  check-expr env e expected = case e of
    ELam s ps body -> check-lam env s ps body expected
    EIf s c t f -> check-if env s c t f expected
    ECase s scrut alts -> check-case env s scrut alts expected
    ELet s bs body -> check-let env s bs body expected
    ELetScope sp body -> check-expr env body expected
    ELocalGroup sp (ELocalStrict at (PTuple site fields) rhs (ELocalEnd end)) body -> check-case env sp rhs (alt-spine sp [(PTuple site fields, body)]) expected
    EAnn s x t -> check-ann-against env s x t expected
    other -> case infer-expr env other of
      (t, ds) -> ds <> (ty-compare (expr-span other) t expected)

  infer-expr :: Environment -> Expr -> (Ty, List Diagnostic)
  infer-expr env e = case e of
    EVar s n -> case env-lookup n env of
      None -> (TyHole, fail s (string-concat "unbound variable: " n))
      Some t -> (t, [])
    EFamilyCon s fallback candidate args -> infer-con env s fallback args
    ECon s n args -> infer-con env s n args
    ERecord s name fields -> (TyHole, fail s "record construction requires typed record elaboration")
    ERecordField s name value rest -> (TyHole, fail s "record field spine is not an expression")
    EProject s value name -> (TyHole, fail s "field projection requires typed record elaboration")
    ELitInt s text -> (TyInt, [])
    ELitStr s text -> (TyStr, [])
    ELitSym s text -> (TyCon "Sym" (TyArgsEnd s), [])
    ELitChar s text -> (TyChr, [])
    EUnit s -> (TyUnit, [])
    EApp s f a -> infer-app env s f a
    EBin s op l r -> infer-bin env s op l r
    ENeg s x -> (TyInt, check-expr env x TyInt)
    EIf s c t f -> infer-if env s c t f
    ECase s scrut alts -> infer-case env s scrut alts
    EGuarded s guard body -> (TyHole, fail s "a guarded body is valid only inside a case alternative")
    ELet s bs body -> infer-let env s bs body
    ELetScope sp body -> infer-expr env body
    ELocalGroup sp (ELocalStrict at (PTuple site fields) rhs (ELocalEnd end)) body -> infer-expr env (ECase sp rhs (alt-spine sp [(PTuple site fields, body)]))
    EAnn s x t -> check-ann env s x t
    ELam s ps body -> (TyHole, (fail s "cannot infer the type of this lambda: give it a type annotation"))
    EForall s vs body -> (TyHole, fail s "unsupported expression: forall")
    EUsing s bounds body -> (TyHole, fail s "unsupported expression: implicit using")
    EBind s n rhs -> (TyHole, fail s "unsupported expression: bind statement")
    EDoLet s simple stmts -> (TyHole, fail s "unsupported expression: do let group")
    EDo s stmts -> (TyHole, fail s "unsupported expression: do block")
    EHandle s body h -> (TyHole, fail s "unsupported expression: handle")
    EHandler s label clauses -> (TyHole, fail s "unsupported expression: handler")
    EHandlerClause s name pats continuation body rest -> (TyHole, fail s "unsupported expression: handler clause")
    EHandlerEnd s -> (TyHole, fail s "unsupported expression: handler clause end")
    ESupplied s bs body -> (TyHole, fail s "unsupported expression: capability supply")
    EWith s bs body -> (TyHole, fail s "unsupported expression: with")
    ETuple s xs -> case spine-ok-exprs xs of
      False -> (TyHole, fail s "malformed tuple expression spine")
      True -> case infer-tuple-fields env (exprs-of xs) of
        (fields, ds) -> (TyTuple fields, ds)
    EList s xs -> (TyHole, fail s "unsupported expression: list literal")
    ERange s xs -> (TyHole, fail s "unsupported expression: range literal")
    EMap s xs -> (TyHole, fail s "unsupported expression: map literal")
    ELitFloat s text -> (TyHole, fail s "unsupported expression: float literal")
    EArg s x rest -> (TyHole, fail s "unsupported expression: argument spine cell")
    EArgsEnd s -> (TyHole, fail s "unsupported expression: argument spine end")
    EBinding s n rhs rest -> (TyHole, fail s "unsupported expression: binding spine cell")
    EBindingsEnd s -> (TyHole, fail s "unsupported expression: binding spine end")
    ELocalGroup sp bindings body -> (TyHole, fail sp "a local binding group requires the typed checker")
    ELetRec sp bindings body -> (TyHole, fail sp "a recursive binding group requires the typed checker")
    ELocalStrict sp pattern value rest -> (TyHole, fail sp "a local binding entry requires its enclosing group")
    ELocalMemo sp name value rest -> (TyHole, fail sp "a local binding entry requires its enclosing group")
    ELocalSignature sp name ty rest -> (TyHole, fail sp "a local binding entry requires its enclosing group")
    ELocalEnd sp -> (TyHole, fail sp "a local binding entry requires its enclosing group")
    EAlt s p body rest -> (TyHole, fail s "unsupported expression: alternative spine cell")
    EAltsEnd s -> (TyHole, fail s "unsupported expression: alternative spine end")
    EQuote s body -> (TyHole, fail s "a quotation requires the typed checker")
    ESplice s expression -> (TyHole, fail s "a splice requires a compile-time quotation")
    ESyntaxNamed s home name source -> (TyHole, fail s "unresolved syntax construction reached checking")
    EDefinitionName s home name -> (TyHole, fail s "unresolved macro definition reference reached checking")
    ESyntaxReference s key name -> (TyHole, fail s "unresolved macro binding reference reached checking")
    ESyntaxCaptureUnder s key name body -> (TyHole, fail s "unresolved macro scope reached type checking")
    ETemplateScope s home body -> (TyHole, fail s "unresolved macro scope reached type checking")
    EArgumentScope s body -> (TyHole, fail s "unresolved macro scope reached type checking")
    EMacroCall s path tokens -> (TyHole, fail s "a macro invocation requires compile-time expansion")
    EForget s atoms x -> (TyHole, fail s "named conjunct weakening needs the refinement checker")
    EUnmodeled s text -> (TyHole, fail s (string-concat "unmodeled expression: " text))

  infer-tuple-fields :: Environment -> List Expr -> (Ty, List Diagnostic)
  infer-tuple-fields env xs = case xs of
    [] -> (TyArgsEnd zero-span, [])
    x : rest -> case infer-expr env x of
      (tx, dx) -> case infer-tuple-fields env rest of
        (fields, ds) -> (TyArg (expr-span x) tx fields, dx <> ds)

  -- `f a`: the domain is the argument's expected type, the codomain the
  -- result. A head whose type is unknown does not add a failure.
  infer-app :: Environment -> Span -> Expr -> Expr -> (Ty, List Diagnostic)
  infer-app env s f a = case infer-expr env f of
    (tf, df) -> case tf of
      TyFun d c -> (c, df <> (check-expr env a d))
      TyHole -> (TyHole, df)
      other -> (TyHole, df <> (fail s (string-concat "cannot apply a value of type " (ty-text other))))

  -- Constructor values may retain unapplied arrows, just like functions.
  -- Check supplied arguments and return the remaining function type;
  -- over-application remains an arity error. Patterns still require every
  -- declared argument and use the exact ctor-arity-diag below.
  infer-con :: Environment -> Span -> String -> Expr -> (Ty, List Diagnostic)
  infer-con env s n args = case env-lookup n env of
    None -> (TyHole, fail s (string-concat "unknown constructor: " n))
    Some ty -> case spine-ok-exprs args of
      False -> (TyHole, fail s "malformed argument spine")
      True -> let count = list-length (exprs-of args) in
        case check-args env (ty-arg-types ty) (exprs-of args) (ty-after-args ty count) of
          (r, ds) -> (r, ds <> (if count <= ty-arity ty then [] else fail s (ctor-arity-message n count (ty-arity ty))))

  -- The arity failure for a constructor used with the wrong number of
  -- arguments, empty when the count matches its declaration.
  ctor-arity-diag :: Span -> String -> Nat -> Ty -> List Diagnostic
  ctor-arity-diag s n given ty =
    if given == ty-arity ty then [] else fail s (ctor-arity-message n given (ty-arity ty))

  check-args :: Environment -> List Ty -> List Expr -> Ty -> (Ty, List Diagnostic)
  check-args env tys es result = case tys of
    [] -> check-extra-args env es result
    t : trest -> case es of
      [] -> (result, [])
      e : erest -> case check-expr env e t of
        ds -> case check-args env trest erest result of
          (r, d2) -> (r, ds <> d2)

  -- Arguments past the declared arity are still checked, against the error
  -- type: the arity failure is the report, and a form outside the fragment
  -- inside one of them is still named.
  check-extra-args :: Environment -> List Expr -> Ty -> (Ty, List Diagnostic)
  check-extra-args env es result = case es of
    [] -> (result, [])
    e : rest -> case check-expr env e TyHole of
      ds -> case check-extra-args env rest result of
        (r, d2) -> (r, ds <> d2)

  -- ------------------------------------------------------------ the operators

  is-arith-op :: String -> Bool
  is-arith-op op =
    case op of
    "+" -> True
    "-" -> True
    "*" -> True
    _ -> op == "/"

  is-rel-op :: String -> Bool
  is-rel-op op =
    case op of
    "<" -> True
    ">" -> True
    "<=" -> True
    _ -> op == ">="

  is-eq-op :: String -> Bool
  is-eq-op op =
    if op == "==" then True
    else op == "/="

  -- The natural frames: `Int -> Int -> Int` for arithmetic, `Int -> Int ->
  -- Bool` for the ordering comparisons, and same-type comparison for `==`.
  infer-bin :: Environment -> Span -> String -> Expr -> Expr -> (Ty, List Diagnostic)
  infer-bin env s op l r =
    if is-arith-op op then (TyInt, (check-expr env l TyInt) <> (check-expr env r TyInt))
    else if is-rel-op op then (TyBool, (check-expr env l TyInt) <> (check-expr env r TyInt))
    else if is-eq-op op then infer-equality env s op l r
    else (TyHole, fail s (string-concat "unsupported operator: " op))

  infer-equality :: Environment -> Span -> String -> Expr -> Expr -> (Ty, List Diagnostic)
  infer-equality env s op l r = case infer-expr env l of
    (tl, dl) -> case infer-expr env r of
      (tr, dr) -> case ty-equal tl tr of
        False -> (TyHole, dl <> dr <> (fail s (equality-mismatch-message op tl tr)))
        True -> case ty-comparable tl of
          False -> (TyHole, dl <> dr <> (fail s (string-concat "cannot compare values of type " (ty-text tl))))
          True -> (TyBool, dl <> dr)

  equality-mismatch-message :: String -> Ty -> Ty -> String
  equality-mismatch-message op a b =
    string-concat "the two sides of " (string-concat op (string-concat " have different types: " (string-concat (ty-text a) (string-concat " and " (ty-text b)))))

  -- --------------------------------------------------------------- branches

  check-if :: Environment -> Span -> Expr -> Expr -> Expr -> Ty -> List Diagnostic
  check-if env s c t f expected =
    (check-expr env c TyBool) <> ((check-expr env t expected) <> (check-expr env f expected))

  infer-if :: Environment -> Span -> Expr -> Expr -> Expr -> (Ty, List Diagnostic)
  infer-if env s c t f = case infer-expr env t of
    (tt, dt) -> case infer-expr env f of
      (tf, df) -> case ty-equal tt tf of
        True -> (tt, (check-expr env c TyBool) <> (dt <> df))
        False -> (TyHole, (check-expr env c TyBool) <> (dt <> (df <> (fail s (branch-mismatch-message tt tf)))))

  branch-mismatch-message :: Ty -> Ty -> String
  branch-mismatch-message a b =
    string-concat "the two branches of this if have different types: " (string-concat (ty-text a) (string-concat " and " (ty-text b)))

  -- ------------------------------------------------------------ case matching

  -- An empty alternative spine is an empty match. Whether the scrutinee type
  -- admits one is the elaborator's decision: this fragment's `Ty` has no
  -- constructor sets, while `Cinch.Infer`'s coverage check accepts an
  -- empty match exactly on an empty data family.
  check-case :: Environment -> Span -> Expr -> Expr -> Ty -> List Diagnostic
  check-case env s scrut alts expected = case infer-expr env scrut of
    (ts, ds) -> case alts-of alts of
      [] -> ds
      a : rest -> ds <> (check-alts env ts (a : rest) expected)

  check-alts :: Environment -> Ty -> List (Pat, Expr) -> Ty -> List Diagnostic
  check-alts env ts alts expected = case alts of
    [] -> []
    a : rest -> case a of
      (p, body) -> case check-pat env p ts of
        (env2, dp) -> (dp <> (check-alt-body env2 body expected)) <> (check-alts env ts rest expected)

  check-alt-body :: Environment -> Expr -> Ty -> List Diagnostic
  check-alt-body env body expected = case body of
    EGuarded s guard rhs -> check-expr env guard TyBool <> check-expr env rhs expected
    other -> check-expr env other expected

  infer-alt-body :: Environment -> Expr -> (Ty, List Diagnostic)
  infer-alt-body env body = case body of
    EGuarded s guard rhs -> case infer-expr env rhs of
      (ty, ds) -> (ty, check-expr env guard TyBool <> ds)
    other -> infer-expr env other

  infer-case :: Environment -> Span -> Expr -> Expr -> (Ty, List Diagnostic)
  infer-case env s scrut alts = case infer-expr env scrut of
    (ts, ds) -> case alts-of alts of
      [] -> (TyHole, ds)
      a : rest -> case a of
        (p, body) -> case check-pat env p ts of
          (env2, dp) -> case infer-alt-body env2 body of
            (t1, d1) -> (t1, ds <> (dp <> (d1 <> (check-alts env ts rest t1))))

  -- --------------------------------------------------------------- let binding

  bind-let :: Environment -> Expr -> (Environment, List Diagnostic)
  bind-let env bs = case bs of
    EBindingsEnd s -> (env, [])
    EBinding s n rhs rest -> case spine-ok-bindings rest of
      False -> (env, fail s "malformed let binding spine")
      True -> case infer-expr env rhs of
        (t, d) -> case bind-let (extend-env n t env) rest of
          (env2, d2) -> (env2, d <> d2)
    other -> (env, fail (expr-span other) "malformed let binding spine")

  spine-ok-bindings :: Expr -> Bool
  spine-ok-bindings e = case e of
    EBindingsEnd s -> True
    EBinding s n rhs rest -> spine-ok-bindings rest
    other -> False

  check-let :: Environment -> Span -> Expr -> Expr -> Ty -> List Diagnostic
  check-let env s bs body expected = case bind-let env bs of
    (env2, ds) -> ds <> (check-expr env2 body expected)

  infer-let :: Environment -> Span -> Expr -> Expr -> (Ty, List Diagnostic)
  infer-let env s bs body = case bind-let env bs of
    (env2, ds) -> case infer-expr env2 body of
      (t, d) -> (t, ds <> d)

  -- ----------------------------------------------------------- annotations

  -- An annotation is checked against the expression and fixes its type.
  check-ann :: Environment -> Span -> Expr -> TypeExpr -> (Ty, List Diagnostic)
  check-ann env s x t = case type-to-ty t of
    (ty, dt) -> (ty, dt <> (check-expr env x ty))

  check-ann-against :: Environment -> Span -> Expr -> TypeExpr -> Ty -> List Diagnostic
  check-ann-against env s x t expected = case type-to-ty t of
    (ty, dt) -> dt <> ((check-expr env x ty) <> (ty-compare s ty expected))

  -- --------------------------------------------------------------- lambdas

  -- A lambda is checkable only against a known function type: the
  -- parameter's type has to come from somewhere, and this rung has no
  -- unifier to invent it. Once the parameters are bound (one arrow each),
  -- the body is checked against what is left of the type.
  check-lam :: Environment -> Span -> List Pat -> Expr -> Ty -> List Diagnostic
  check-lam env s ps body expected = case expected of
    TyHole -> fail s "cannot infer the type of this lambda: give it a type annotation"
    other -> case bind-lam env s ps expected of
      (env2, ds) -> ds <> (check-expr env2 body (lam-result ps expected))

  -- The lambda's parameters, bound against the arrows of its type.
  bind-lam :: Environment -> Span -> List Pat -> Ty -> (Environment, List Diagnostic)
  bind-lam env s ps expected = case ps of
    [] -> (env, [])
    p : rest -> case expected of
      TyFun d c -> case check-pat env p d of
        (env2, dp) -> case bind-lam env2 s rest c of
          (env3, d2) -> (env3, dp <> d2)
      other -> (env, fail s (string-concat "this lambda cannot be checked against " (string-concat (ty-text expected) ", which is not a function type")))

  -- The type left after one arrow per parameter.
  lam-result :: List Pat -> Ty -> Ty
  lam-result ps t = case ps of
    [] -> t
    p : rest -> case t of
      TyFun d c -> lam-result rest c
      other -> TyHole

  -- --------------------------------------------------------------- patterns

  check-pat :: Environment -> Pat -> Ty -> (Environment, List Diagnostic)
  check-pat env p expected = case p of
    PWild s -> (env, [])
    PVar s n -> (extend-env n expected env, [])
    PLitInt s text -> (env, ty-compare s TyInt expected)
    PLitStr s text -> (env, ty-compare s TyStr expected)
    PLitSym s text -> (env, ty-compare s (TyCon "Sym" (TyArgsEnd s)) expected)
    PLitChar s text -> (env, ty-compare s TyChr expected)
    PFamilyCon s fallback candidate args -> check-con-pat env s fallback args expected
    PCon s n args -> check-con-pat env s n args expected
    PRecord s name fields -> (env, fail s "record pattern requires typed record elaboration")
    PRecordField s name value rest -> (env, fail s "record field spine is not a pattern")
    PTuple s xs -> check-tuple-pat env s xs expected
    PList s xs -> (env, fail s "unsupported pattern: list literal")
    PCons s h t -> (env, fail s "unsupported pattern: list cons")
    PAs s n inner -> (env, fail s "unsupported pattern: as binding")
    PAnn s inner t -> (env, fail s "unsupported pattern: type annotation")
    PArg s x rest -> (env, fail s "unsupported pattern: pattern spine cell")
    PArgsEnd s -> (env, fail s "unsupported pattern: pattern spine end")
    PUnmodeled s text -> (env, fail s (string-concat "unmodeled pattern: " text))

  tuple-field-types :: Ty -> List Ty
  tuple-field-types fields = case fields of
    TyArg s x rest -> x : (tuple-field-types rest)
    other -> []

  check-tuple-pat :: Environment -> Span -> Pat -> Ty -> (Environment, List Diagnostic)
  check-tuple-pat env s xs expected = case spine-ok-pats xs of
    False -> (env, fail s "malformed tuple pattern spine")
    True -> case expected of
      TyTuple fields -> let expected-fields = tuple-field-types fields in
        let patterns = pats-of xs in
        let expected-count = list-length expected-fields in
        let actual-count = list-length patterns in
        case bind-pats env expected-fields patterns of
          (bound, ds) ->
            if expected-count == actual-count then (bound, ds)
            else (bound, ds <> fail s (string-concat-all ["tuple pattern has ", nat-to-string actual-count,
              " components but the tuple type has ", nat-to-string expected-count]))
      TyUnit -> case pats-of xs of
        [] -> (env, [])
        other-pats -> case bind-extra-pats env other-pats of
          (bound, ds) -> (bound, ds <> fail s "a tuple pattern requires a tuple type")
      other -> case bind-extra-pats env (pats-of xs) of
        (bound, ds) -> (bound, ds <> fail s "a tuple pattern requires a tuple type")

  -- The pattern's arguments are bound even when the count is wrong, so the
  -- arity failure does not drag an unbound variable along with it.
  check-con-pat :: Environment -> Span -> String -> Pat -> Ty -> (Environment, List Diagnostic)
  check-con-pat env s n args expected = case env-lookup n env of
    None -> (env, fail s (string-concat "unknown constructor: " n))
    Some ty ->
      let d0 = con-pat-type-diag s ty expected in
      case spine-ok-pats args of
        False -> (env, d0 <> (fail s "malformed argument spine"))
        True -> case bind-pats env (ty-arg-types ty) (pats-of args) of
          (env2, dp) -> (env2, d0 <> dp <> (ctor-arity-diag s n (list-length (pats-of args)) ty))

  -- The pattern's expected type must be the type the constructor builds
  -- (compared by head name: the arguments a declared type is applied to are
  -- not tracked inside a data declaration).
  con-pat-type-diag :: Span -> Ty -> Ty -> List Diagnostic
  con-pat-type-diag s ctor-ty-here expected = case ty-head-name ctor-ty-here of
    None -> []
    Some owner -> case ty-head-name expected of
      None -> []
      Some eo -> if owner == eo then [] else ty-compare s (TyCon owner (TyArgsEnd zero-span)) expected

  bind-pats :: Environment -> List Ty -> List Pat -> (Environment, List Diagnostic)
  bind-pats env tys pats = case tys of
    [] -> bind-extra-pats env pats
    t : trest -> case pats of
      [] -> (env, [])
      p : prest -> case check-pat env p t of
        (env2, d) -> case bind-pats env2 trest prest of
          (env3, d2) -> (env3, d <> d2)

  -- Patterns past the declared arity are still bound (against the error
  -- type), so the arity failure is the only report.
  bind-extra-pats :: Environment -> List Pat -> (Environment, List Diagnostic)
  bind-extra-pats env pats = case pats of
    [] -> (env, [])
    p : rest -> case check-pat env p TyHole of
      (env2, d) -> case bind-extra-pats env2 rest of
        (env3, d2) -> (env3, d <> d2)

  -- ----------------------------------------------------------- clause coverage

  pat-covers :: Pat -> Pat -> Bool
  pat-covers a b = case a of
    PWild s -> True
    PVar s n -> True
    PLitInt s t -> case b of
      PLitInt s2 t2 -> t == t2
      other -> False
    PLitStr s t -> case b of
      PLitStr s2 t2 -> t == t2
      other -> False
    PLitSym s t -> (case b of PLitSym s2 t2 -> t == t2; other -> False)
    PLitChar s t -> case b of
      PLitChar s2 t2 -> t == t2
      other -> False
    PCon s n args -> case b of
      PCon s2 n2 args2 -> if n == n2 then pat-spine-covers (pats-of args) (pats-of args2) else False
      other -> False
    other -> False

  pat-spine-covers :: List Pat -> List Pat -> Bool
  pat-spine-covers a b = case a of
    [] -> case b of
      [] -> True
      other -> False
    pa : resta -> case b of
      [] -> False
      pb : restb -> if pat-covers pa pb then pat-spine-covers resta restb else False

  -- Whether `a` matches every list `b` matches (same length, every
  -- position covered).
  clause-covers :: List Pat -> List Pat -> Bool
  clause-covers a b = case a of
    [] -> case b of
      [] -> True
      other -> False
    pa : resta -> case b of
      [] -> False
      pb : restb -> if pat-covers pa pb then clause-covers resta restb else False

  covered :: List (List Pat) -> List Pat -> Bool
  covered earlier pats = case earlier of
    [] -> False
    e : rest -> if clause-covers e pats then True else covered rest pats

  -- A clause an earlier clause already matches is unreachable: the check
  -- this rung's non-overlap requirement comes down to.
  check-overlap :: List (List Pat, Expr) -> List (List Pat) -> List Diagnostic
  check-overlap clauses earlier = case clauses of
    [] -> []
    c : rest -> case c of
      (pats, body) -> case covered earlier pats of
        True -> (fail (clause-span pats) "unreachable clause: an earlier clause already matches these patterns") <> (check-overlap rest (pats : earlier))
        False -> check-overlap rest (pats : earlier)

  clause-span :: List Pat -> Span
  clause-span pats = case pats of
    [] -> zero-span
    p : rest -> pat-span p

  -- --------------------------------------------------------------- functions

  check-fun :: HashMap String Ty -> Environment -> Span -> String -> List (List Pat, Expr) -> List Diagnostic
  check-fun signatures env s name clauses = case hash-map-lookup name signatures of
    None -> fail s (string-concat "no signature for " name)
    Some ty -> case clauses of
      [] -> fail s (string-concat "a function declaration with no clauses: " name)
      c : rest -> check-clauses name env ty (ty-arity ty) clauses

  check-clauses :: String -> Environment -> Ty -> Nat -> List (List Pat, Expr) -> List Diagnostic
  check-clauses name env ty arity clauses =
    (check-clause-list name env ty arity clauses) <> (check-overlap clauses [])

  check-clause-list :: String -> Environment -> Ty -> Nat -> List (List Pat, Expr) -> List Diagnostic
  check-clause-list name env ty arity clauses = case clauses of
    [] -> []
    c : rest -> case c of
      (pats, body) -> (check-clause name env ty arity pats body) <> (check-clause-list name env ty arity rest)

  check-clause :: String -> Environment -> Ty -> Nat -> List Pat -> Expr -> List Diagnostic
  check-clause name env ty arity pats body = case list-length pats <= arity of
    False -> fail (clause-span pats) (arity-mismatch-message name (list-length pats) arity)
    True -> case bind-pats env (ty-arg-types ty) pats of
      (env2, dp) -> dp <> (check-expr env2 body (ty-after-args ty (list-length pats)))

  arity-mismatch-message :: String -> Nat -> Nat -> String
  arity-mismatch-message name given expected =
    string-concat "arity mismatch: " (string-concat name (string-concat ": signature arity " (string-concat (nat-to-string expected) (string-concat ", clause arity " (nat-to-string given)))))

  ctor-arity-message :: String -> Nat -> Nat -> String
  ctor-arity-message name given expected =
    string-concat "arity mismatch: constructor " (string-concat name (string-concat ": declared arity " (string-concat (nat-to-string expected) (string-concat ", used arity " (nat-to-string given)))))

  ctor-return-message :: String -> String -> String
  ctor-return-message name owner =
    string-concat "constructor " (string-concat name (string-concat " must return " owner))

  -- --------------------------------------------------------------- the scan

  -- Pass one: register every signature and constructor, and report the
  -- duplicates. Declaration order within a module is not required for the
  -- registry, so top-level functions may be mutually recursive.
  push-diagnostics :: List Diagnostic -> List Diagnostic -> List Diagnostic
  push-diagnostics diagnostics acc = case diagnostics of
    [] -> acc
    first : rest -> push-diagnostics rest (first : acc)

  scan-signature :: Span -> String -> Ty -> List Diagnostic -> Registry -> List Diagnostic -> (Registry, List Diagnostic)
  scan-signature at name ty diagnostics registry acc = case registry of
    Registry signatures constructors globals -> case hash-map-lookup name signatures of
      Some prior -> (registry, push-diagnostics (fail at (string-concat "duplicate signature for " name)) acc)
      None -> (Registry (hash-map-insert name ty signatures) constructors (hash-map-insert name ty globals), push-diagnostics diagnostics acc)

  scan-decl :: Decl -> Registry -> List Diagnostic -> (Registry, List Diagnostic)
  scan-decl d registry acc = case d of
    DExternal s name kind (Some t) metadata ->
      if kind == "value" then case type-to-ty t of
        (ty, diagnostics) -> case scan-signature s name ty diagnostics registry acc of
          (entries, errors) ->
            let word-errors = if external-word-type t then [] else fail s "imported value needs quantified, nominal or effect-aware checking" in
            let arity-errors = (case external-field "arity" metadata of
              JNum arity -> if arity == nat-to-int (ty-arity ty) then [] else fail s "imported value arity disagrees with its checked scheme"
              other -> fail s "imported value has no arity metadata") in
            (entries, push-diagnostics arity-errors (push-diagnostics word-errors errors))
      else (registry, acc)
    DSig s name t -> case type-to-ty t of
      (ty, diagnostics) -> scan-signature s name ty diagnostics registry acc
    DData s n params ctors -> scan-ctors n ctors registry acc
    DDecl s x rest -> case scan-decl x registry acc of
      (next, errors) -> scan-decl rest next errors
    other -> (registry, acc)

  external-field :: String -> Json -> Json
  external-field name metadata = case metadata of
    JObj key value rest -> if key == name then value else external-field name rest
    other -> JNull

  external-word-type :: TypeExpr -> Bool
  external-word-type ty = case ty of
    TName s name -> name == "Int" || name == "Bool" || name == "Unit" || name == "()"
    TFun s a b -> external-word-type a && external-word-type b
    other -> False

  scan-ctors :: String -> List (String, TypeExpr) -> Registry -> List Diagnostic -> (Registry, List Diagnostic)
  scan-ctors owner ctors registry acc = case ctors of
    [] -> (registry, acc)
    (name, texpr) : rest -> case registry of
      Registry signatures constructors globals -> case hash-map-lookup name constructors of
        Some prior -> scan-ctors owner rest registry (push-diagnostics (fail (type-expr-span texpr) (string-concat "duplicate constructor: " name)) acc)
        None -> case constructor-type name owner texpr of
          (ty, diagnostics) -> scan-ctors owner rest
            (Registry signatures (hash-map-insert name () constructors) (hash-map-insert name ty globals))
            (push-diagnostics diagnostics acc)

  constructor-type :: String -> String -> TypeExpr -> (Ty, List Diagnostic)
  constructor-type name owner texpr = case type-to-ty texpr of
    (ty, diagnostics) ->
      let value = ctor-ty owner (ty-spine-of-list (ty-arg-types ty)) in
      let valid = (case ty-result ty of TyCon n spine -> n == owner; other -> False) in
      (value, if valid then diagnostics else diagnostics <> fail (type-expr-span texpr) (ctor-return-message name owner))

  scan-decls :: List Decl -> Registry -> List Diagnostic -> (Registry, List Diagnostic)
  scan-decls ds registry acc = case ds of
    [] -> (registry, reverse acc)
    d : rest -> case scan-decl d registry acc of
      (next, errors) -> scan-decls rest next errors

  -- ------------------------------------------------------- pass two: checking

  check-decl :: HashMap String Ty -> Environment -> Decl -> List Diagnostic
  check-decl signatures env d = case d of
    DSource s name metadata -> []
    DInterface s name hash metadata -> []
    DExternal s name kind scheme metadata ->
      if kind == "builtin" then fail s (string-concat "builtin needs region, capability and effect elaboration: " name)
      else if kind == "builtin-syntax" then fail s (string-concat "builtin syntax needs dependent predicate elaboration: " name)
      else if kind == "builtin-constructor" then fail s (string-concat "builtin constructor needs proposition instantiation and erasure checking: " name)
      else if kind == "value" then case scheme of
        Some ty -> []
        None -> fail s "imported value has no parsed type metadata"
      else fail s (string-concat-all ["imported ", kind, " needs kind, constructor or dictionary elaboration: ", name])
    DSig s n t -> []
    DLaw s name syntax -> fail s "class laws require checked proposition elaboration"
    DRewrite s name syntax -> fail s "a rewrite needs a checked equation and justification"
    DMethod s label name t -> fail s "resolved signature methods require typed elaboration"
    DFun s n clauses -> check-fun signatures env s n clauses
    DData s n params ctors -> case params of
      [] -> []
      p : rest -> fail s "parameterized data declarations are not supported in this rung"
    DOpaque s name params kind -> fail s "opaque declarations require checked kind and nominal elaboration"
    DRefine s n params binder predicate -> fail s "named refinement declarations need proof checking, which is not supported in this rung"
    DTypeFamily s n params rkind closed eqs -> fail s "type family declarations require typed elaboration"
    DTypeInstance s n args rhs -> fail s "type instance declarations require typed elaboration"
    DDataFamily s n params -> fail s "data family declarations require typed elaboration"
    DDataInstance s n args ctors -> fail s "data instance declarations require typed elaboration"
    DClass s n params members -> fail s "class declarations are not supported in this rung"
    DInstance s is-implicit name params class-app members -> fail s "instance declarations are not supported in this rung"
    DFixity s assoc prec ops -> fail s "fixity declarations are not supported in this rung"
    DImport s path mods alias members hidden args -> fail s "module imports need interface resolution, which is not supported in this rung"
    DExport s text items -> []
    DRecord s n params fields -> fail s "record declarations are not supported in this rung"
    DCodata s n params observations -> fail s "codata declarations require checked observations"
    DCorec s body -> fail s "a corec declaration requires guarded recursion checking"
    DEffect s n params ops -> fail s "effect declarations are not supported in this rung"
    DForeign s direction conv symbol foreign-name t -> fail s "foreign declarations are not supported in this rung"
    DPrim s name ty spec-opt bodies -> fail s "inline primitives require checked signatures and target containment"
    DModuleProfile s profile -> []
    DProof s body -> fail s "a proof declaration requires erased checking"
    DSpec s body -> fail s "a spec declaration requires erased checking"
    DMacroBinding s name -> fail s "unresolved macro declaration"
    DMacro s body -> fail s "a macro declaration requires compile-time expansion"
    DStage s body -> fail s "a stage declaration requires compile-time checking"
    DGenerate s actions -> fail s "a generate block requires compile-time expansion"
    DNamedDeclaration s hole body -> fail s "a name splice is only meaningful inside a `quoteDecls` template"
    DDeclarationMacro s name patterns template -> fail s "a declaration macro requires compile-time expansion"
    DEmitMacro s name tokens -> fail s "emit requires a generate block"
    DGeneratedGroup s owner macro-name template -> fail s "generated declarations require lexical resolution"
    DStageEmit s template -> fail s "emit requires a generate block"
    DStageLet s bindings -> fail s "stage let requires a generate block"
    DStageEmitValue s value -> fail s "emit requires a generate block"
    DStageBranch s condition yes no -> fail s "a staged branch requires a generate block"
    -- A temporal contract is verified by the elaboration that owns the
    -- definition's checked Core and its per-step write log, so this
    -- untyped rung has nothing to check it against.
    DContract s keyword name subject clauses -> fail s "a temporal contract needs the checked write log of the definition it names"
    DMachine s name syntax -> fail s "a state machine declaration requires full temporal elaboration"
    DRefines s concrete syntax -> fail s "a refinement declaration requires full temporal elaboration"
    -- A target-selected declaration is checked as the declaration it wraps.
    -- Pruning against the active profile happens before this rung sees it,
    -- so a clause that survived here is one the build satisfies.
    DConditional s clauses inner -> check-decl signatures env inner
    DDecl s x rest -> (check-decl signatures env x) <> (check-decl signatures env rest)
    DDeclsEnd s -> []
    DWrapperLayout s name repr label -> []
    DUnpackFields s name fields -> []
    DInlineHint s name hint -> (case hint of Ok value -> []; Err message -> fail s message)
    DUnrollHint s name hint -> (case hint of Ok value -> []; Err message -> fail s message)
    DTestAttr s name tspec -> (case tspec of Ok value -> []; Err message -> fail s message)
    DUnmodeled s text -> fail s (string-concat "unmodeled declaration: " text)

  check-decls :: HashMap String Ty -> Environment -> List Decl -> List Diagnostic
  check-decls signatures env ds = case ds of
    [] -> []
    d : rest -> (check-decl signatures env d) <> (check-decls signatures env rest)

  check-modules :: List Module -> List Diagnostic
  check-modules ms = case ms of
    [] -> []
    m : rest -> case scan-decls (module-decls m) (Registry hash-map-empty hash-map-empty hash-map-empty) [] of
      (registry, registry-diags) -> case registry of
        Registry signatures constructors globals ->
          registry-diags <> check-decls signatures (base-env registry) (module-decls m) <> check-modules rest

  -- Each module owns its registry. Private names from another module
  -- cannot satisfy a reference or collide with a local declaration.
  -- Imported interfaces must be resolved before extending that registry.
  check-program :: Program -> List Diagnostic
  check-program p = if needs-inference p then infer-program rung p else case p of
    Program s ms -> check-modules ms
