-- The total-body wire format numbers slots in binding order. Keep blocks
-- newest first with sizes 1, 3, 7, ... . A push merges the first two equal
-- blocks with a new root, so it takes constant work. A lookup skips whole
-- blocks and then descends one tree in logarithmic work.
module Cinch.BodyScope where

  export BodyScope, empty-body-scope, push-body-slot, body-scope-from-list, body-slot

  data ScopeTree a where
    ScopeLeaf :: a -> ScopeTree a
    ScopeBranch :: a -> ScopeTree a -> ScopeTree a -> ScopeTree a
  data ScopeBlocks a where
    NoScopeBlocks :: ScopeBlocks a
    ScopeBlock :: Nat -> ScopeTree a -> ScopeBlocks a -> ScopeBlocks a
  data BodyScope a where
    BodyScope :: Nat -> ScopeBlocks a -> BodyScope a

  empty-body-scope :: forall a. BodyScope a
  empty-body-scope = BodyScope 0 NoScopeBlocks

  push-body-slot :: forall a. BodyScope a -> a -> BodyScope a
  push-body-slot scope value = case scope of
    BodyScope count blocks -> BodyScope (count + 1) (push-scope-block value blocks)

  push-scope-block :: forall a. a -> ScopeBlocks a -> ScopeBlocks a
  push-scope-block value blocks = case blocks of
    ScopeBlock first-size first (ScopeBlock next-size next rest) | first-size == next-size ->
      ScopeBlock (2 * first-size + 1) (ScopeBranch value first next) rest
    other -> ScopeBlock 1 (ScopeLeaf value) blocks

  body-scope-from-list :: forall a. List a -> BodyScope a
  body-scope-from-list values = push-body-slots values empty-body-scope

  push-body-slots :: forall a. List a -> BodyScope a -> BodyScope a
  push-body-slots values scope = case values of
    Nil -> scope
    Cons first rest -> push-body-slots rest (push-body-slot scope first)

  body-slot :: forall a. Nat -> BodyScope a -> Option a
  body-slot slot scope = case scope of
    BodyScope count blocks -> if slot < count then scope-block-slot (count - (slot + 1)) blocks else None

  scope-block-slot :: forall a. Nat -> ScopeBlocks a -> Option a
  scope-block-slot index blocks = case blocks of
    NoScopeBlocks -> None
    ScopeBlock size tree rest ->
      if index < size then scope-tree-slot index size tree else scope-block-slot (index - size) rest

  scope-tree-slot :: forall a. Nat -> Nat -> ScopeTree a -> Option a
  scope-tree-slot index size tree = case tree of
    ScopeLeaf value -> Some value
    ScopeBranch value first next ->
      if index == 0 then Some value else
        let half = size / 2 in
        if index <= half then scope-tree-slot (index - 1) half first
        else scope-tree-slot (index - (half + 1)) half next
