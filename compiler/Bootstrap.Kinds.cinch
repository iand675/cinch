-- Recheck annotated types against actual nominal and lexical kind contexts.
-- A printed name or a cached Kind annotation never introduces a declaration.
module Bootstrap.Kinds where
  import Bootstrap.Type
  import Bootstrap.Index
  import Data.Char (is-ascii-alpha-numeric)
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Text.Lex (Span)

  export TypeScope, MkTypeScope, empty-type-scope, scope-bound, scope-rigid, scope-locals, add-local-scheme, add-value-parameter
  export type-well-formed, kind-well-formed, scheme-well-formed, scheme-type-scope
  export KindIndex, index-kinds, extend-kind-index, kind-at, nominal-index-closed
  export KindDeclarations, kind-declarations, declared-kinds, declaration-kind-index, add-kind-declaration, prefix-kind-declarations
  export type-well-formed-in, kind-well-formed-in, scheme-well-formed-in, scheme-type-scope-in, argument-well-formed-in
  export nominal-kinds-closed, add-rigid-kind, constructor-index-key
  export proper-type, argument-well-formed, symbolic-effect-spelling
  export borrow-scope-conflict, open-memo-region, in-memo-region

  data TypeScope where
    MkTypeScope :: List (Nat, Kind) -> List (Nat, Kind) -> List (Nat, Scheme) -> List Nat -> TypeScope
  empty-type-scope :: TypeScope
  empty-type-scope = MkTypeScope Nil Nil Nil Nil
  -- A polytype's binders are in scope, as bound variables, over its body.
  bind-quant-scope :: List Quant -> TypeScope -> TypeScope
  bind-quant-scope qs scope = case qs of
    Nil -> scope
    Cons q rest -> case bind-quant-scope rest scope of
      MkTypeScope bound rigid locals memos -> MkTypeScope (Cons (quant-id q, quant-kind q) bound) rigid locals memos
  scope-bound :: TypeScope -> List (Nat, Kind)
  scope-bound scope = case scope of MkTypeScope bound rigid locals memos -> bound
  scope-rigid :: TypeScope -> List (Nat, Kind)
  scope-rigid scope = case scope of MkTypeScope bound rigid locals memos -> rigid
  scope-locals :: TypeScope -> List (Nat, Scheme)
  scope-locals scope = case scope of MkTypeScope bound rigid locals memos -> locals
  scope-memos :: TypeScope -> List Nat
  scope-memos scope = case scope of MkTypeScope bound rigid locals memos -> memos
  open-memo-region :: Nat -> TypeScope -> Option TypeScope
  open-memo-region id scope = case add-rigid-kind id KRegion scope of
    Some (MkTypeScope bound rigid locals memos) -> Some (MkTypeScope bound rigid locals (Cons id memos))
    None -> None
  in-memo-region :: UType -> TypeScope -> Bool
  in-memo-region region scope = case region of
    URigid id name level KRegion -> has-memo-id id (scope-memos scope)
    other -> False
  has-memo-id :: Nat -> List Nat -> Bool
  has-memo-id id memos = case memos of
    Nil -> False
    Cons first rest -> first == id || has-memo-id id rest
  same :: String -> String -> Bool
  same a b = string-compare a b == 0
  lookup-id :: Nat -> List (Nat, Kind) -> Option Kind
  lookup-id id entries = case entries of Nil -> None; Cons (key, kind) rest -> if id == key then Some kind else lookup-id id rest
  data KindIndex where
    KindIndex :: Nat -> HashMap String Kind -> KindIndex

  -- Declaration order gives the first name authority over later entries.
  index-kinds :: List (String, Kind) -> KindIndex
  index-kinds rows = collect-kinds rows 0 hash-map-empty

  extend-kind-index :: KindIndex -> List (String, Kind) -> KindIndex
  extend-kind-index (KindIndex size table) rows = collect-kinds rows size table

  collect-kinds :: List (String, Kind) -> Nat -> HashMap String Kind -> KindIndex
  collect-kinds rows size table = case rows of
    Nil -> KindIndex size table
    Cons (name, kind) rest -> (case hash-map-lookup name table of
      Some _ -> collect-kinds rest size table
      None -> collect-kinds rest (size + 1) (hash-map-insert name kind table))

  kind-at :: String -> KindIndex -> Option Kind
  kind-at name (KindIndex size table) = hash-map-lookup name table

  -- Keep declaration order and its first-binding index together. Remember
  -- duplicate rows so the independent closure check can still refuse them.
  data KindDeclarations where
    KindDeclarations :: List (String, Kind) -> KindIndex -> KindDeclarations
  kind-declarations :: List (String, Kind) -> KindDeclarations
  kind-declarations rows = KindDeclarations rows (index-kinds rows)
  declared-kinds :: KindDeclarations -> List (String, Kind)
  declared-kinds (KindDeclarations rows indexed) = rows
  declaration-kind-index :: KindDeclarations -> KindIndex
  declaration-kind-index (KindDeclarations rows indexed) = indexed
  add-kind-declaration :: String -> Kind -> KindDeclarations -> KindDeclarations
  add-kind-declaration name kind (KindDeclarations rows (KindIndex size table)) =
    let count = (case hash-map-lookup name table of None -> size + 1; Some old -> size) in
    KindDeclarations (Cons (name, kind) rows) (KindIndex count (hash-map-insert name kind table))
  prefix-kind-declarations :: List (String, Kind) -> KindDeclarations -> KindDeclarations
  prefix-kind-declarations prefix declarations = case prefix of
    Nil -> declarations
    Cons (name, kind) rest -> add-kind-declaration name kind (prefix-kind-declarations rest declarations)

  equal-type :: UType -> UType -> Bool
  equal-type a b = valid-type a && valid-type b && (case store-errors (unify (Span 0 0 1 1) (without-index-levels a) (without-index-levels b) (empty-store "kind scope")) of Nil -> True; other -> False)
  add-rigid-kind :: Nat -> Kind -> TypeScope -> Option TypeScope
  add-rigid-kind id kind scope = case lookup-id id (scope-rigid scope) of
    Some prior -> None
    None -> (case lookup-local id (scope-locals scope) of Some prior -> None; None -> Some (MkTypeScope (scope-bound scope) (Cons (id, kind) (scope-rigid scope)) (scope-locals scope) (scope-memos scope)))
  add-bound-kind :: Nat -> Kind -> TypeScope -> Option TypeScope
  add-bound-kind id kind scope = case lookup-id id (scope-bound scope) of
    Some prior -> None
    None -> Some (MkTypeScope (Cons (id, kind) (scope-bound scope)) (scope-rigid scope) (scope-locals scope) (scope-memos scope))
  lookup-local :: Nat -> List (Nat, Scheme) -> Option Scheme
  lookup-local id locals = case locals of Nil -> None; Cons (key, sc) rest -> if id == key then Some sc else lookup-local id rest
  add-local-scheme :: Nat -> Scheme -> TypeScope -> Option TypeScope
  add-local-scheme id sc scope = case (lookup-id id (scope-rigid scope), lookup-local id (scope-locals scope)) of
    (None, None) -> if borrow-scope-conflict scope (scheme-body sc) then None
      else Some (MkTypeScope (scope-bound scope) (scope-rigid scope) (Cons (id, sc) (scope-locals scope)) (scope-memos scope))
    other -> None
  borrow-scope-conflict :: TypeScope -> UType -> Bool
  borrow-scope-conflict scope ty = case borrow-regions ty of
    Nil -> False
    loans -> borrow-local-conflict loans (scope-locals scope)
  borrow-local-conflict :: List (Bool, UType) -> List (Nat, Scheme) -> Bool
  borrow-local-conflict loans locals = case locals of
    Nil -> False
    Cons (id, scheme) rest ->
      borrow-region-conflict loans (borrow-regions (scheme-body scheme)) || borrow-local-conflict loans rest
  -- A forall value has both its actual rigid index kind and a term binding
  -- at that kind's carrier. Ordinary locals still cannot shadow rigid ids.
  add-value-parameter :: Nat -> UType -> TypeScope -> Option TypeScope
  add-value-parameter id carrier scope = case (lookup-id id (scope-rigid scope), lookup-local id (scope-locals scope)) of
    (Some kind, None) -> if kind-equal kind (value-kind carrier) then Some (MkTypeScope (scope-bound scope) (scope-rigid scope) (Cons (id, mono carrier) (scope-locals scope)) (scope-memos scope)) else None
    other -> None
  highest :: Nat -> Nat -> Nat
  highest a b = if a > b then a else b
  kind-level :: Kind -> Nat
  kind-level kind = case kind of KFun a b -> highest (kind-level a) (kind-level b); KValue carrier -> type-level carrier; other -> 0
  index-level :: IndexTerm -> Nat
  index-level value = case value of
    IRigid id name level -> level
    IApply f x -> highest (index-level f) (index-level x)
    ILambda id name body -> index-level body
    IAdd a b -> highest (index-level a) (index-level b)
    ISubtract a b -> highest (index-level a) (index-level b)
    IMultiply a b -> highest (index-level a) (index-level b)
    other -> 0
  type-level :: UType -> Nat
  type-level ty = case ty of
    URigid id name level kind -> highest level (kind-level kind)
    UBound id name kind -> kind-level kind
    UCon name kind -> kind-level kind
    UMeta id kind -> kind-level kind
    UIndex carrier value -> highest (type-level carrier) (index-level value)
    URefine id name carrier predicate -> highest (type-level carrier) (type-level predicate)
    URefineFormer name ids body -> type-level body
    UPi id name a row b -> highest (type-level row) (highest (type-level a) (type-level b))
    UFunEff a row b -> highest (type-level row) (highest (type-level a) (type-level b))
    UProofFun a row b -> highest (type-level row) (highest (type-level a) (type-level b))
    UApp a b -> highest (type-level a) (type-level b)
    UFun a b -> highest (type-level a) (type-level b)
    URow labels -> type-level labels
    URowJoin a b -> highest (type-level a) (type-level b)
    UTuple fields -> type-level fields
    USigma id name domain body -> highest (type-level domain) (type-level body)
    UForall qs body -> type-level body
    UArg a b -> highest (type-level a) (type-level b)
    UCompare op a b -> highest (type-level a) (type-level b)
    UPropAnd a b -> highest (type-level a) (type-level b)
    UPropOr a b -> highest (type-level a) (type-level b)
    URequire a b -> highest (type-level a) (type-level b)
    UPropNot body -> type-level body
    UPropNonZero body -> type-level body
    UPropNotNull body -> type-level body
    UPropAscii body -> type-level body
    UPropOrdered body -> type-level body
    UPropNonZeroPending body -> type-level body
    UIndexForget body -> type-level body
    UIndexPromote body -> type-level body
    UIndexByteLength body -> type-level body
    UIndexMeasure measure body -> type-level body
    UIndexStringLength body -> type-level body
    UIndexBorrowRead body -> type-level body
    UIndexConstructor name arrow input -> highest (type-level arrow) (type-level input)
    UIndexList element fields -> highest (type-level element) (type-level fields)
    UIndexCall function args -> type-level args
    UIndexMath op a b -> highest (type-level a) (type-level b)
    other -> 0
  local-carrier :: UType -> Nat -> TypeScope -> Bool
  local-carrier carrier id scope = case lookup-local id (scope-locals scope) of
    Some sc -> (case scheme-requirements sc of
      Nil -> (case fresh-for-types [carrier, scheme-body sc] (restore-level (highest (type-level carrier) (type-level (scheme-body sc)) + 1) (empty-store "local index carrier")) of
        (fresh, prepared) -> case open-scheme False sc prepared of
          (expected, pairs, opened) -> (case store-errors (unify (Span 0 0 1 1) expected carrier opened) of Nil -> True; other -> False))
      other -> False)
    None -> False
  kind-well-formed-in :: KindIndex -> TypeScope -> Kind -> Bool
  kind-well-formed-in kinds scope kind = valid-kind kind && kind-authorized kinds scope kind

  kind-authorized :: KindIndex -> TypeScope -> Kind -> Bool
  kind-authorized kinds scope kind = case kind of
    KFun domain result -> kind-authorized kinds scope domain && kind-authorized kinds scope result
    KValue carrier -> type-authorized kinds scope carrier
    other -> True
  index-binding :: UType -> Nat -> List (Nat, Kind) -> Bool
  index-binding carrier id entries = case lookup-id id entries of
    Some kind -> (case value-carrier kind of Some expected -> equal-type expected carrier; None -> False)
    None -> False
  index-well-formed :: KindIndex -> TypeScope -> UType -> IndexTerm -> Bool
  index-well-formed kinds scope carrier value = case value of
    ICharacter c -> same-shape carrier (UCon "Char" KType)
    IInteger n -> integer-literal-valid carrier n
    IBound id name -> index-binding carrier id (scope-bound scope)
    IRigid id name level -> index-binding carrier id (scope-rigid scope) || local-carrier carrier id scope
    IAdd a b -> index-well-formed kinds scope carrier a && index-well-formed kinds scope carrier b
    ISubtract a b -> index-well-formed kinds scope carrier a && index-well-formed kinds scope carrier b
    IMultiply a b -> index-well-formed kinds scope carrier a && index-well-formed kinds scope carrier b
    other -> False
  binder-body :: KindIndex -> TypeScope -> Nat -> UType -> UType -> Bool
  binder-body kinds scope id carrier body = type-authorized kinds scope carrier && (case add-bound-kind id (value-kind carrier) scope of
    Some bound -> type-authorized kinds bound body
    None -> False)
  -- | Recheck nominal and lexical authority, interpreting mutation labels only inside effect rows.
  -- This namespace is reserved at context closure. Only the independently
  -- supplied nominal data table can contribute a constructor signature.
  nominal-name :: String -> Bool
  nominal-name name = let bytes = string-to-bytes name in bytes-len bytes > 0 && bytes-get bytes 0 /= 64
  constructor-index-key :: String -> String
  constructor-index-key name = string-concat "@constructor:" name

  -- `valid-type` checks the shape of the entire input before authority is
  -- visited. Repeating it at each child rescans deeply nested types.
  type-well-formed-in :: KindIndex -> TypeScope -> UType -> Bool
  type-well-formed-in kinds scope ty = valid-type ty && type-authorized kinds scope ty

  type-authorized :: KindIndex -> TypeScope -> UType -> Bool
  type-authorized kinds scope ty = case ty of
    UCon name actual ->
      if promoted-ctor-name name || promoted-str-name name then True
      else (case kind-at name kinds of Some expected -> kind-equal actual expected && (case expected of KValue carrier -> nominal-name name; other -> True); None -> False)
    UBound id name actual -> (case lookup-id id (scope-bound scope) of Some expected -> kind-equal actual expected; None -> False)
    URigid id name level actual -> (case lookup-id id (scope-rigid scope) of Some expected -> kind-equal actual expected; None -> case value-carrier actual of Some carrier -> type-authorized kinds scope carrier && local-carrier carrier id scope; None -> False)
    UMeta id kind -> False
    UError -> False
    UIndex carrier value -> type-authorized kinds scope carrier && index-runtime-admissible carrier value && index-well-formed kinds scope carrier value
    URefine id name carrier predicate -> binder-body kinds scope id carrier predicate
    URefineFormer name ids body -> (case (kind-at name kinds, scheme-type-scope-in kinds empty-type-scope (refinement-formals ids)) of
      (Some declared, Some bound) -> kind-equal declared (type-kind ty) && type-authorized kinds bound body
      other -> False)
    UPi id name domain row result -> binder-body kinds scope id domain (UArg row (UArg result UEnd))
    UApp f x -> type-authorized kinds scope f && type-authorized kinds scope x
    UFun a b -> type-authorized kinds scope a && type-authorized kinds scope b
    UFunEff a row b -> type-authorized kinds scope a && type-authorized kinds scope row && type-authorized kinds scope b
    UUsageArrow usage arrow -> type-authorized kinds scope arrow
    UProofFun a row b -> type-authorized kinds scope a && type-authorized kinds scope row && type-authorized kinds scope b
    UIndexForget value -> type-authorized kinds scope value
    UIndexPromote value -> type-authorized kinds scope value
    UIndexByteLength value -> type-authorized kinds scope value
    UIndexMeasure measure value -> type-authorized kinds scope value
    UIndexStringLength value -> type-authorized kinds scope value
    UIndexBorrowRead value -> type-authorized kinds scope value
    UIndexConstructor name arrow input -> (case kind-at (constructor-index-key name) kinds of
      Some (KValue declared) -> same-shape arrow declared && type-authorized kinds scope arrow && type-authorized kinds scope input
      other -> False)
    UIndexList element fields -> type-authorized kinds scope element && type-authorized kinds scope fields
    UIndexCall function args -> type-authorized kinds scope args
    UIndexMath op a b -> type-authorized kinds scope a && type-authorized kinds scope b
    URow labels -> row-labels-well-formed kinds scope labels
    URowJoin a b -> type-authorized kinds scope a && type-authorized kinds scope b
    UTuple fields -> type-authorized kinds scope fields
    USigma id name domain body -> binder-body kinds scope id domain body
    UForall qs body -> type-authorized kinds (bind-quant-scope (quants-list qs) scope) body
    UArg first rest -> type-authorized kinds scope first && type-authorized kinds scope rest
    UCompare relation a b -> type-authorized kinds scope a && type-authorized kinds scope b
    UPropAnd a b -> type-authorized kinds scope a && type-authorized kinds scope b
    UPropOr a b -> type-authorized kinds scope a && type-authorized kinds scope b
    UPropNot body -> type-authorized kinds scope body
    UPropNonZero body -> type-authorized kinds scope body
    UPropNotNull body -> type-authorized kinds scope body
    UPropAscii body -> type-authorized kinds scope body
    UPropOrdered body -> type-authorized kinds scope body
    UPropNonZeroPending body -> type-authorized kinds scope body
    URequire predicates body -> type-authorized kinds scope predicates && type-authorized kinds scope body
    UPropLit value -> True
    UEnd -> True

  -- | Check every closed row label without giving effect-only constructor kinds ordinary nominal authority.
  row-labels-well-formed :: KindIndex -> TypeScope -> UType -> Bool
  row-labels-well-formed kinds scope labels = case labels of
    UEnd -> True
    UArg first rest -> row-label-well-formed kinds scope first && row-labels-well-formed kinds scope rest
    other -> False

  -- A symbolic label has no operations or declaration identity. Accept a bare
  -- constructor spelling only inside a row, with at most one scoped Region.
  symbolic-effect-spelling :: String -> Bool
  symbolic-effect-spelling name = case unpack name of
    Cons first rest -> char-code first >= 65 && char-code first <= 90 && symbolic-effect-tail rest
    Nil -> False

  symbolic-effect-tail :: List Char -> Bool
  symbolic-effect-tail chars = case chars of
    Nil -> True
    Cons ch rest -> (is-ascii-alpha-numeric ch || char-code ch == 95 || char-code ch == 45 || char-code ch == 39) && symbolic-effect-tail rest

  row-label-well-formed :: KindIndex -> TypeScope -> UType -> Bool
  row-label-well-formed kinds scope label = case label of
    UApp (UCon name actual) region -> if same name "Mut" then
      kind-equal actual (KFun KRegion KEffect)
        && kind-equal (type-kind region) KRegion && type-authorized kinds scope region
        && (case kind-at "Mut" kinds of Some declared -> kind-equal declared borrow-constructor-kind; None -> False)
      else (case kind-at name kinds of
        Some declared -> type-authorized kinds scope label
        None -> symbolic-effect-spelling name && kind-equal actual (KFun KRegion KEffect)
          && kind-equal (type-kind region) KRegion && type-authorized kinds scope region)
    UCon name KEffect -> (case kind-at name kinds of
      Some declared -> kind-equal declared KEffect
      None -> symbolic-effect-spelling name)
    other -> type-authorized kinds scope label
  scheme-type-scope-in :: KindIndex -> TypeScope -> List Quant -> Option TypeScope
  scheme-type-scope-in kinds scope qs = case qs of
    Nil -> Some scope
    Cons q rest -> if kind-well-formed-in kinds scope (quant-kind q) then
      (case add-bound-kind (quant-id q) (quant-kind q) scope of Some bound -> scheme-type-scope-in kinds bound rest; None -> None)
      else None
  requirements-well-formed :: KindIndex -> TypeScope -> List Requirement -> Bool
  requirements-well-formed kinds scope requirements = case requirements of Nil -> True; Cons r rest -> type-well-formed-in kinds scope (requirement-type r) && requirements-well-formed kinds scope rest
  scheme-well-formed-in :: KindIndex -> TypeScope -> Scheme -> Bool
  scheme-well-formed-in kinds scope sc = case scheme-type-scope-in kinds scope (scheme-params sc) of
    -- A declaration's type is a value type or a proposition: `same :: (value
    -- :: Bool) -> Eq value value` declares a proof former, whose scheme body
    -- is a goal rather than a value. `proper-type` still governs every
    -- position that must be a value.
    Some bound -> declared-type (scheme-body sc) && type-authorized kinds bound (scheme-body sc) && requirements-well-formed kinds bound (scheme-requirements sc)
    None -> False
  declared-type :: UType -> Bool
  declared-type ty = proper-type ty || (valid-type ty && kind-equal (type-kind ty) KProp)
  proper-type :: UType -> Bool
  proper-type ty = valid-type ty && kind-equal (type-kind ty) KType && valid-kind (value-kind ty)
  argument-well-formed-in :: KindIndex -> TypeScope -> UType -> Bool
  argument-well-formed-in kinds scope ty = (case type-kind ty of
    KType -> proper-type ty
    KValue carrier -> typed-index-admissible ty
    other -> valid-type ty) && type-authorized kinds scope ty
  nominal-index-closed :: KindIndex -> List (String, Kind) -> Bool
  nominal-index-closed kinds entries = case kinds of
    KindIndex size table -> size == list-length entries && nominal-entries-closed kinds entries

  nominal-entries-closed :: KindIndex -> List (String, Kind) -> Bool
  nominal-entries-closed kinds entries = case entries of
    Nil -> True
    Cons (name, kind) rest -> nominal-name name
      && kind-well-formed-in kinds empty-type-scope kind && nominal-entries-closed kinds rest

  nominal-kinds-closed :: List (String, Kind) -> Bool
  nominal-kinds-closed kinds = nominal-index-closed (index-kinds kinds) kinds

  type-well-formed :: List (String, Kind) -> TypeScope -> UType -> Bool
  type-well-formed kinds = type-well-formed-in (index-kinds kinds)
  kind-well-formed :: List (String, Kind) -> TypeScope -> Kind -> Bool
  kind-well-formed kinds = kind-well-formed-in (index-kinds kinds)
  scheme-type-scope :: List (String, Kind) -> TypeScope -> List Quant -> Option TypeScope
  scheme-type-scope kinds = scheme-type-scope-in (index-kinds kinds)
  scheme-well-formed :: List (String, Kind) -> TypeScope -> Scheme -> Bool
  scheme-well-formed kinds = scheme-well-formed-in (index-kinds kinds)
  argument-well-formed :: List (String, Kind) -> TypeScope -> UType -> Bool
  argument-well-formed kinds = argument-well-formed-in (index-kinds kinds)
