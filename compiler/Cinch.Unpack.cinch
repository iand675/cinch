-- Compile source-order record fields into checked physical slots. Keep
-- the constructor and its type arguments for rebuilding a projected product.
module Cinch.Unpack where
  import Cinch.Ast
  import Cinch.Core
  import Cinch.Type
  import Cinch.Nominal (interface-global)
  import Text.Lex (Span)
  import Text.Scan (string-starts-with, string-ends-with, string-drop, string-take, string-split-on)
  import Data.Bytes (bytes-compare)
  import Cinch.Document
  import Algebra.Semigroup

  export check-unpacked-records, unpacked-abi

  data RecordRequest where
    ObservationType :: String -> RecordRequest
    Fields :: Span -> String -> List String -> List (String, Bool) -> Option Json -> RecordRequest

  field :: String -> Json -> Json
  field key doc = case doc of JObj k v more -> if key == k then v else field key more; other -> JNull
  labels :: Json -> List String
  labels rows = case rows of JArr (JStr name) more -> name : (labels more); other -> []
  exported :: String -> Json -> Option Json
  exported name rows = case rows of
    JArr row more -> (case field "name" row of JStr key | (key == name) -> Some row; other -> exported name more)
    other -> None

  unpacked-labels :: String -> Option (List String)
  unpacked-labels repr = let size = string-length repr in
    if 8 <= size && string-starts-with "unpack(" repr && string-ends-with ")" repr then
      Some (string-split-on "," (string-take (size - 8) (string-drop 7 repr)))
    else None

  imported :: Span -> String -> Json -> Json -> List RecordRequest -> List RecordRequest
  imported sp home types rows tail = case rows of
    JArr row more -> let rest = imported sp home types more tail in
      (case (field "repr" row, field "type" row) of
        (JStr repr, JStr name) ->
          (case (unpacked-labels repr, exported name types) of
            (Some wanted, Some ty) -> (case field "identity" ty of
              JStr identity | (identity == home <> "." <> name) ->
                (Fields sp (interface-global identity) (labels (field "fields" ty)) (map (\label -> (label, True)) wanted) (Some row)) : rest
              other -> rest)
            other -> rest)
        other -> rest)
    other -> tail
  source-labels :: String -> List Decl -> List String
  source-labels name ds = case ds of
    (DRecord sp owner params fields) : rest | (name == owner) -> map (\pair -> case pair of (label, ty) -> label) fields
    other : rest -> source-labels name rest
    [] -> []
  requests :: List Decl -> List Decl -> List RecordRequest
  requests all ds = case ds of
    [] -> []
    (DExternal sp name category syntax metadata) : rest | (category == "type") -> (case field "kind" metadata of
      JStr kind | (kind == "codata") -> (ObservationType name) : (requests all rest)
      other -> requests all rest)
    (DCodata sp name params fields) : rest -> (ObservationType name) : (requests all rest)
    (DUnpackFields sp name wanted) : rest -> (Fields sp name (source-labels name all) wanted None) : (requests all rest)
    (DInterface sp home hash doc) : rest -> imported sp home (field "types" (field "exports" doc)) (field "layouts" (field "abi" doc)) (requests all rest)
    other : rest -> requests all rest
  lookup-request :: String -> List RecordRequest -> Option RecordRequest
  lookup-request name rows = case rows of
    [] -> None
    (ObservationType owner) : rest -> if name == owner then Some (ObservationType owner) else lookup-request name rest
    (Fields sp n names wanted abi) : rest -> if name == n then Some (Fields sp n names wanted abi) else lookup-request name rest
  enabled :: String -> List (String, Bool) -> Bool
  enabled label wanted = case wanted of [] -> False; (name, flag) : rest -> if label == name then flag else enabled label rest
  needs-storage :: List (String, Bool) -> Bool
  needs-storage wanted = case wanted of [] -> False; (name, flag) : rest -> flag || needs-storage rest

  product-type :: UType -> List UType -> Option (String, List UType)
  product-type ty args = case ty of UCon name kind -> Some (name, args); UApp fn arg -> product-type fn (arg : args); other -> None
  find-data :: String -> List CoreData -> Option CoreData
  find-data name ds = case ds of [] -> None; d : rest -> if name == core-data-name d then Some d else find-data name rest
  parameters :: List Quant -> List UType -> Option (List (Nat, UType))
  parameters qs args = case (qs, args) of
    ([], []) -> Some []
    (q : more, arg : rest) | kind-equal (q.kind) KType -> (case parameters more rest of
      Some pairs -> Some ((q.id, arg) : pairs)
      None -> None)
    other -> None
  storage-requested :: String -> List RecordRequest -> Bool
  storage-requested name rs = case lookup-request name rs of Some (Fields sp n names wanted abi) -> needs-storage wanted; Some (ObservationType owner) -> True; None -> False
  product-slot :: String -> UType -> List CoreData -> List RecordRequest -> Option RecordSlot
  product-slot label ty ds rs = case product-type ty [] of
    Some (name, args) -> (case find-data name ds of
      Some d -> (case (core-data-layout d, core-data-constructors d) of
        (UniformData, [c]) | not (storage-requested name rs) -> (case (parameters (scheme-params (c.constructor-scheme)) args, core-constructor-fields c) of
          (Some pairs, first : more) -> Some (ProductSlot label ty c args (map (substitute-bound pairs) (first : more)))
          other -> None)
        other -> None)
      None -> None)
    None -> None
  record-slots :: List String -> List (String, Bool) -> UType -> List CoreData -> List RecordRequest -> Result String (List RecordSlot)
  record-slots names wanted arrow ds rs = case (names, arrow) of
    (name : rest, UProofFun predicate effects result) -> if enabled name wanted then Err ("cannot unpack erased field " <> name) else record-slots rest wanted result ds rs
    (name : rest, UPi id binder ty effects result) -> checked-slot name ty rest wanted result ds rs
    (name : rest, UFun ty result) -> checked-slot name ty rest wanted result ds rs
    ([], UCon owner kind) -> Ok []
    other -> Err "unpack layout disagrees with its record constructor"
  checked-slot :: String -> UType -> List String -> List (String, Bool) -> UType -> List CoreData -> List RecordRequest -> Result String (List RecordSlot)
  checked-slot label ty names wanted result ds rs = case (if enabled label wanted then product-slot label ty ds rs else Some (OrdinarySlot label ty)) of
    None -> Err ("unpack on " <> label <> " requires a monomorphic single-constructor native product")
    Some slot -> (case record-slots names wanted result ds rs of Ok more -> Ok (slot : more); Err msg -> Err msg)

  slot-name :: RecordSlot -> String
  slot-name slot = case slot of OrdinarySlot name ty -> name; ProductSlot name ty c args fields -> name
  unpacked-names :: List RecordSlot -> String -> String
  unpacked-names slots separator = case slots of
    [] -> ""
    (ProductSlot name ty c args fields) : rest -> separator <> name <> unpacked-names rest ","
    other : rest -> unpacked-names rest separator
  field-bytes :: List UType -> Nat
  field-bytes fields = case fields of
    [] -> 0
    ty : rest -> (case ty of UCon name kind | (name == "I128") || name == "U128" -> 16; other -> 8) + field-bytes rest
  abi-fields :: List RecordSlot -> Nat -> (Nat, Json)
  abi-fields slots offset = case slots of
    [] -> (offset, JArrEnd)
    slot : rest -> let size = field-bytes (slot-types slot) in
      case abi-fields rest (offset + size) of
        (total, fields) -> (total, JArr (JObj "name" (JStr (slot-name slot)) (JObj "offset" (JNum (nat-to-int offset))
          (JObj "size" (JNum (nat-to-int size)) (JObj "align" (JNum 8) JObjEnd)))) fields)
  unpacked-abi :: List RecordSlot -> Json
  unpacked-abi slots = case abi-fields slots 0 of
    (size, fields) -> JObj "size" (JNum (nat-to-int size)) (JObj "align" (JNum 8) (JObj "fields" fields (JObj "repr" (JStr ("unpack(" <> unpacked-names slots "" <> ")")) JObjEnd)))

  abi-agrees :: Json -> Json -> Bool
  abi-agrees published computed =
    let layout = JObj "size" (field "size" published) (JObj "align" (field "align" published)
          (JObj "fields" (field "fields" published) (JObj "repr" (field "repr" published) JObjEnd))) in
    bytes-compare (canonical-bytes layout) (canonical-bytes computed) == 0
  checked-layout :: RecordRequest -> CoreData -> List CoreData -> List RecordRequest -> Result String CoreData
  checked-layout request d ds rs = case request of
    ObservationType owner -> Ok d
    Fields sp owner names wanted abi -> (case core-data-layout d of
      UniformData -> if not (needs-storage wanted) then Ok d else
        (case (core-data-params d, core-data-constructors d) of
          ([], [ctor]) -> (case record-slots names wanted (scheme-body (ctor.constructor-scheme)) ds rs of
            Err msg -> Err msg
            Ok slots -> (case abi of Some row | not (abi-agrees row (unpacked-abi slots)) -> Err "unpack ABI layout disagrees with its represented fields"; other -> Ok (with-data-layout (UnpackedRecord slots) d)))
          other -> Err "unpack requires a monomorphic record with native layout")
      other -> Err "field unpacking requires a native record layout")
  attach :: List RecordRequest -> List CoreData -> List CoreData -> Store -> (List CoreData, Store)
  attach rs ds remaining st = case remaining of
    [] -> ([], st)
    d : rest -> case attach rs ds rest st of
      (more, done) -> (case lookup-request (core-data-name d) rs of
        None -> (d : more, done)
        Some (ObservationType owner) -> (d : more, done)
        Some (Fields sp owner labels wanted abi) -> (case checked-layout (Fields sp owner labels wanted abi) d ds rs of
          Err msg -> (d : more, add-error sp msg done)
          Ok laid-out -> (laid-out : more, done)))
  check-unpacked-records :: List Decl -> (List CoreData, Store) -> (List CoreData, Store)
  check-unpacked-records ds checked = case requests ds ds of
    [] -> checked
    rs -> (case checked of (datas, st) -> attach rs datas datas st)
