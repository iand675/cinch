-- | Unaligned little-endian machine-word access to byte buffers.
-- Bounds are explicit preconditions in the public signatures. Reads and writes
-- access exactly the proved byte range. Private LLVM loads retain the backing
-- buffer until completion; raw pointers never enter the public interface. The
-- packed words feed SIMD and SWAR kernels. Wire order is independent of host
-- endianness. Concurrent mutation follows the same rules as Data.Bytes.
module Data.Bytes.Word where

  import Data.Bytes
  import Data.Machine
  import Data.Nat

  export bytes-read-le32, bytes-read-le64, bytes-write-le32, bytes-write-le64

  -- | Read exactly 4 bytes as a little-endian U32. Alignment is unrestricted. The caller must prove pos + 4 <= bytes-len b; no tail bytes are read.
  bytes-read-le32 :: using (pos + 4 <= bytes-len b) => (b :: Bytes) -> (pos :: Nat) -> U32
  bytes-read-le32 b pos = hold-bytes b (load-le32 (bytes-data b) (nat-to-i64 pos))

  -- | Write exactly 4 low-to-high bytes of a U32. The caller must prove pos + 4 <= bytes-len b; bytes outside that range are preserved.
  bytes-write-le32 :: using (pos + 4 <= bytes-len b) => (b :: Bytes) -> (pos :: Nat) -> U32 -> Unit
  bytes-write-le32 b pos x =
    let w0 = bytes-set b pos (u8-to-nat (wrapping-u32-to-u8 x)) in
    let w1 = bytes-set b (pos + 1) (u8-to-nat (wrapping-u32-to-u8 (wrapping-shr-u32 x 8))) in
    let w2 = bytes-set b (pos + 2) (u8-to-nat (wrapping-u32-to-u8 (wrapping-shr-u32 x 16))) in
    bytes-set b (pos + 3) (u8-to-nat (wrapping-u32-to-u8 (wrapping-shr-u32 x 24)))

  -- | Read exactly 8 bytes as a little-endian U64. Alignment is unrestricted. The caller must prove pos + 8 <= bytes-len b; no tail bytes are read.
  bytes-read-le64 :: using (pos + 8 <= bytes-len b) => (b :: Bytes) -> (pos :: Nat) -> U64
  bytes-read-le64 b pos = hold-bytes b (load-le64 (bytes-data b) (nat-to-i64 pos))

  -- | Write exactly 8 low-to-high bytes of a U64. The caller must prove pos + 8 <= bytes-len b; bytes outside that range are preserved.
  bytes-write-le64 :: using (pos + 8 <= bytes-len b) => (b :: Bytes) -> (pos :: Nat) -> U64 -> Unit
  bytes-write-le64 b pos x =
    let w0 = bytes-set b pos (u8-to-nat (wrapping-u64-to-u8 x)) in
    let w1 = bytes-set b (pos + 1) (u8-to-nat (wrapping-u64-to-u8 (wrapping-shr-u64 x 8))) in
    let w2 = bytes-set b (pos + 2) (u8-to-nat (wrapping-u64-to-u8 (wrapping-shr-u64 x 16))) in
    let w3 = bytes-set b (pos + 3) (u8-to-nat (wrapping-u64-to-u8 (wrapping-shr-u64 x 24))) in
    let w4 = bytes-set b (pos + 4) (u8-to-nat (wrapping-u64-to-u8 (wrapping-shr-u64 x 32))) in
    let w5 = bytes-set b (pos + 5) (u8-to-nat (wrapping-u64-to-u8 (wrapping-shr-u64 x 40))) in
    let w6 = bytes-set b (pos + 6) (u8-to-nat (wrapping-u64-to-u8 (wrapping-shr-u64 x 48))) in
    bytes-set b (pos + 7) (u8-to-nat (wrapping-u64-to-u8 (wrapping-shr-u64 x 56)))

  -- | Load exactly 4 bytes from a proved private address, normalizing host endianness.
  prim load-le32 :: I64 -> I64 -> U32 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %at = getelementptr i8, ptr %base, i64 %1
      %word = load i32, ptr %at, align 1
      ret i32 %word
    } when endian little
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %at = getelementptr i8, ptr %base, i64 %1
      %word = load i32, ptr %at, align 1
      %value = call i32 @llvm.bswap.i32(i32 %word)
      ret i32 %value
    } when endian big

  -- | Load exactly 8 bytes from a proved private address, normalizing host endianness.
  prim load-le64 :: I64 -> I64 -> U64 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %at = getelementptr i8, ptr %base, i64 %1
      %word = load i64, ptr %at, align 1
      ret i64 %word
    } when endian little
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %at = getelementptr i8, ptr %base, i64 %1
      %word = load i64, ptr %at, align 1
      %value = call i64 @llvm.bswap.i64(i64 %word)
      ret i64 %value
    } when endian big

  -- | Keep the backing buffer alive until a raw load has completed. The strict
  -- argument and runtime length read retain the owner across inline kernels.
  hold-bytes :: forall a. Bytes -> a -> a
  hold-bytes b value = case bytes-len b of
    _ -> value

module Data.Json where

  import Data.String
  export Json, JNull, JBool, JNum, JFloat, JStr, JArr, JObj, JArrEnd, JObjEnd


  -- The `Json`-shaped value a file converter binds for a JSON file with
  -- no declared type (surface grammar local amendments section 11); with
  -- a declared record type the converter decodes into it instead. An
  -- array is a cons spine (`JArr item tail`, ended by `JArrEnd`) and an
  -- object entry is `JObj key value tail` (ended by `JObjEnd`): the
  -- positivity discipline allows only direct recursive occurrences, so
  -- the payloads stay inside the family.
  data Json where
    JNull :: Json
    JBool :: Bool -> Json
    JNum :: Int -> Json
    JFloat :: F64 -> Json
    JStr :: String -> Json
    JArr :: Json -> Json -> Json
    JObj :: String -> Json -> Json -> Json
    JArrEnd :: Json
    JObjEnd :: Json


-- Text.Codec: conversion to and from `Bytes` and `Json`.
--
-- Module scheme (design/base-library.md): `Text.Codec` aligns with the
-- A6 `CodecGenerator.derive` vocabulary (modules specification
-- section 11): the generated codec pair is `encodeT :: T -> Bytes`
-- and `decodeT :: Bytes -> Option T`, in a fixed little-endian column
-- format. The class states that pair once so the generator's output
-- and hand-written codecs share one vocabulary.
--
-- Derived codec instances where expressible: exactly the A6 column
-- encoders' covered set (decision D65), `I64` as 8 bytes
-- little-endian (Data.Machine) and `Bool` as one byte (Data.Bool).
-- REAL needs float bit access and TEXT a length-prefixed copy (D65);
-- those instances land with their generators. The class law shape is
-- the round trip: `decode (encode x) == Some x` (asserted over sample
-- values in seed/tests/prelude_split.rs).
--
-- `JsonCodec` is the JSON-value column beside it (P31): the same law
-- shape over the `Json` family, with a named decode error instead of
-- `Option` (a JSON column carries a shape to report). Its instances
-- live with their types (Data.Machine's `JsonCodec I64`, Data.Bool's
-- `JsonCodec Bool`, and `Text.Json`'s identity column), and the
-- error vocabulary sits with the class, like `Text.Parse`'s
-- `ParseError` sits with its parsers.

module Text.Codec where

  import Data.Json
  import Data.Result

  export Codec, encode, decode
  export JsonCodec, encode-json, decode-json
  export JsonDecodeError, TypeMismatch, OutOfRange, json-error-message

  signature Codec a where
    encode :: a -> Bytes
    decode :: Bytes -> Option a

  -- The named decode errors: a wrong shape (the expected column kind)
  -- and a value outside the column's range.
  data JsonDecodeError where
    TypeMismatch :: String -> JsonDecodeError
    OutOfRange :: String -> JsonDecodeError

  json-error-message :: JsonDecodeError -> String
  json-error-message e = case e of
    TypeMismatch expected -> string-concat "expected " expected
    OutOfRange what -> string-concat "out of range: " what

  signature JsonCodec a where
    encode-json :: a -> Json
    decode-json :: Json -> Result JsonDecodeError a


-- | Explicit bridges between dynamic JSON and the established Json-shaped codec family.
-- Integer spellings become arbitrary-precision integers; fractional or exponent
-- spellings become finite binary64 values. Exact-number spelling and typed null
-- collection identity are intentionally projected by this explicit conversion.
-- Malformed application text, invalid numbers and malformed legacy spines are
-- refused instead of being silently repaired. Existing legacy APIs are unchanged.
-- Opaque typed application payloads are projected through their encoding capability
-- once, then decoded with exact number spellings before the established projection.

-- | Retain the original byte-writer application under the selected source context.
module Main where
  import Data.Bytes
  import Data.Machine
  import Data.Bytes.Word
  -- | Reach the checked writer without introducing other library clients.
  main :: Int
  main = let b = bytes-new 8 in let done = bytes-write-le32 b 0 (wrapping-i64-to-u32 5) in 0
