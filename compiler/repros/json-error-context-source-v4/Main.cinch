    Observe "quoted" True True True "pretty" False "{\n\t   \"value\": \"true\"\n\t }" False 0 "" 0,
    Observe "quoted" True True True "empty-indent" True "{\n\"value\": \"true\"\n}" False 0 "" 0,
    Observe "quoted" True True True "empty-indent" False "{\n\"value\": \"true\"\n}" False 0 "" 0,
