  -- | Preserve the first independent row index as a nonzero process result.
  status :: Nat
  status =
    let result0 = group rows0 0 in
    if result0 > 0 then result0 else
    let result1 = group rows1 16 in
    if result1 > 0 then result1 else
    let result2 = group rows2 32 in
    if result2 > 0 then result2 else
    let result3 = group rows3 48 in
    if result3 > 0 then result3 else
    let result4 = group rows4 64 in
    if result4 > 0 then result4 else
    let result5 = group rows5 80 in
    if result5 > 0 then result5 else
    let result6 = group rows6 96 in
    if result6 > 0 then result6 else
    let result7 = group rows7 112 in
    if result7 > 0 then result7 else
    let result8 = group rows8 128 in
    if result8 > 0 then result8 else
    let result9 = group rows9 144 in
    if result9 > 0 then result9 else
    let result10 = group rows10 160 in
    if result10 > 0 then result10 else
    let result11 = group rows11 176 in
    if result11 > 0 then result11 else
    let result12 = group rows12 192 in
    if result12 > 0 then result12 else
    let result13 = group rows13 208 in
    if result13 > 0 then result13 else
    let result14 = group rows14 224 in
    if result14 > 0 then result14 else
    let result15 = group rows15 240 in
    if result15 > 0 then result15 else
    let result16 = group rows16 256 in
    if result16 > 0 then result16 else
    let result17 = group rows17 272 in
    if result17 > 0 then result17 else
    0

  -- | Preserve the original reporting-disabled descriptor refusal with its exact published application type label.
  retained :: Unit -> Bool
  retained unit =
    let counter = bytes-new 1 in
    let selected = json-type-with-methods (named "main.pointerMethods" json-bool-type) (json-methods (Some (True, (\options value -> let count = called counter in Ok (string-to-bytes "\"method\"")))) None None None) in
    check selected (runtime-bool True) "main.pointerMethods" counter (Observe "quoted" True False False "compact" True "{\"value\"" True 9 "/value" 0)

  -- | Check the retained descriptor refusal before every new policy/format observation.
  main :: Int
  main = if retained () then nat-to-int status else 10001
