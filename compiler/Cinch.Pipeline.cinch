-- Rung 6: the pipeline. Every earlier rung is one step; this module is the
-- chain that turns a source file into a RUNNING native binary: read the
-- bytes, parse to the shared tree, check the fragment, refuse with named
-- diagnostics if either stage objects, emit LLVM IR, hand the module to a
-- spawned clang, run the artifact, and report both exit codes.
--
-- See compiler/README.md for the ladder and design/bootstrap-ladder.md for
-- the decisions. The imports are SELECTED rather than wholesale on purpose:
-- several rungs export a helper called `rung` (and the ladder's coherence
-- test already caught two modules exporting `bytes-equal-from`), so a
-- consumer that composes them unqualified gets an ambiguity, and the
-- language's remedy is a selection.
--
-- The runnable entry reads four words from its own command line: source,
-- IR module, executable and report. Arguments are never split on whitespace.

module Cinch.Pipeline where

  import Cinch.Ast (Program, Module, module-decls, module-name-index, Decl, DClass)
  import Cinch.Check (CheckedProgram, check-and-retain-with-interfaces, check-and-retain-with-admitted-interfaces, check-and-retain-with-interfaces-tuned, check-and-retain-with-admitted-interfaces-tuned, prepare-admitted-check, prepare-admitted-check-tuned, prepare-admitted-check-cached, with-generated)
  import Cinch.Core (CoreDefinition)
  import Cinch.CoreBody (dense-claims-verified)
  import Cinch.Infer (elaboration-core)
  import Cinch.Driver (link-and-report, link-only-and-report)
  import Cinch.Ir (emit-checked-diagnostics, emit-checked-program)
  import Cinch.RuntimeIr (check-runtime-entry, emit-runtime-program, emit-runtime-program-counting, runtime-library-unit-roots, emit-runtime-library-object-with-object)
  import Cinch.RuntimeIr (emit-runtime-program-for-profile, emit-runtime-program-for-profile-tuned, emit-runtime-program-for-profile-cached, emit-runtime-library-artifact-for-profile, emit-runtime-library-artifact-for-profile-tuned, UnitIrCache, empty-unit-ir-cache)
  import Cinch.Parallel (CompileStrategy, Latency, Throughput, CompileTuning, default-tuning, tuning-with-strategy, tuning-with-workers, tuning-is-latency, tuning-is-throughput, parse-compile-strategy, parse-nat-word, apply-worker-budget)
  import Cinch.Incremental (ProgramIndex, index-body-count, IncrementalPlan, PlanReuseIr, PlanBodyOnly, PlanFullRebuild, IncrementalSession, empty-incremental-session, plan-incremental-build, record-incremental-success, invalidate-incremental-session, render-ready-event, render-plan-event, render-done-event, render-error-event, render-stats-event)
  import Cinch.Object (RuntimeObject, RuntimeObjectConfig, read-object-unit-roots, read-runtime-object-publication, read-runtime-object-config, runtime-object-input-files, read-runtime-object-mode, read-runtime-object-client-mode, admit-runtime-object-client-mode, admit-runtime-object-package-client, admit-runtime-object-mode, object-has-unit-symbol)
  import Cinch.PackageWrite (encode-interface-package, encode-object-package)
  import Cinch.Parse (parse-program)
  import Cinch.Parse (parse-program-with, parse-program-with-index, parse-program-with-index-tuned)
  import Cinch.Load (LoadedInterface, load-interface, validate-interface-set, ValidatedInterfaces, canonical-interface-validation)
  import Cinch.Inputs (InterfaceInputs, read-validated-interfaces, embedded-library-home, read-interface-inputs, interface-input-files, interface-package-file, load-client-interface-inputs)
  import Cinch.Host (compiler-epoch)
  import Cinch.Object (PackedClient, read-packed-client, packed-client-key, admit-packed-client)
  import Cinch.Contracts (interface-headers, interface-fixity-headers)
  import Cinch.Resolve (resolve-program, resolve-program-with, resolve-admitted-signature-overlays, prepare-admitted-resolution, resolve-overlay-with, unshadowed-interfaces)
  import Cinch.Stage (expand-stages-with-report, explain-expansion-errors)
  import Cinch.Report (Diagnostic, render-diagnostics, render-source-diagnostics)
  import Cinch.Export (export-interfaces-aliased, export-object-interfaces, interface-hash, build-generated-manifest, checked-primitive-rows)
  import Cinch.Interface (fnv-source-hash, sha256-hex)
  import Cinch.TargetLiterals (target-literal-errors)
  import Cinch.Target (TargetProfile, selection-arch, target-ir-header, target-profile, target-view-program, host-profile)
  import Algebra.Semigroup
  import Effect.Process (process-run, command)
  import Cinch.Document
  import Data.Bytes (bytes-compare, bytes-len)
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Data.List (map, reverse)
  import Data.Nat (nat-to-int)
  import Data.Path (Path, path-from-string, path-to-string, path-is-absolute, path-normalize, path-stem, path-dirname, path-join)
  import Data.String (string-concat, string-concat-all, string-from-bytes, string-to-bytes)
  import Effect.Fs (FsError, FileIsFile, file-meta-kind, file-meta-size, fs-metadata, fs-read, fs-rename, fs-write)
  import Text.Scan (string-contains, string-strip, string-starts-with, string-drop)
  import Text.Lex (bytes-slice)
  import Text.Parse (Bundle, Failed, ParseError, ParseOutcome, Parsed, render-bundle)
  import Text.Show (int-to-string)
  import Relation.Eq (Eq)

  foreign import ccall "cinch.runtime.randomBytes" package-stage-entropy :: Nat -> Bytes
  foreign import ccall "cinch.runtime.fsMkdir" make-package-stage :: Bytes -> Bool -> I64
  foreign import ccall "cinch.runtime.fsRemove" remove-package-stage :: Bytes -> Bool -> I64

  -- Check-only preserves all frontend checks while stopping before emission.
  -- Compile-only emits and links without running the generated program.
  data PipelineMode where
    TypesOnly :: PipelineMode
    CheckOnly :: PipelineMode
    BodiesOnly :: PipelineMode
    IrOnly :: PipelineMode
    ServeIr :: PipelineMode
    ServeStream :: PipelineMode
    EmitOnly :: PipelineMode
    EmitWithInterfaces :: PipelineMode
    InterfacesOnly :: PipelineMode
    ObjectOnly :: PipelineMode
    CompileOnly :: PipelineMode
    CompileAndRun :: PipelineMode

  implicit instance Eq_PipelineMode :: Eq PipelineMode where
    (==) a b = case (a, b) of
      (TypesOnly, TypesOnly) -> True
      (CheckOnly, CheckOnly) -> True
      (BodiesOnly, BodiesOnly) -> True
      (IrOnly, IrOnly) -> True
      (ServeIr, ServeIr) -> True
      (ServeStream, ServeStream) -> True
      (EmitOnly, EmitOnly) -> True
      (EmitWithInterfaces, EmitWithInterfaces) -> True
      (InterfacesOnly, InterfacesOnly) -> True
      (ObjectOnly, ObjectOnly) -> True
      (CompileOnly, CompileOnly) -> True
      (CompileAndRun, CompileAndRun) -> True
      _ -> False
    (/=) a b = not (a == b)

  -- ----------------------------------------------------------------- exits

  -- One code per stage, so a run says where it stopped rather than only
  -- that it stopped. The link stage's codes are the driver rung's own.

  pipeline-ok :: Int
  pipeline-ok = 0

  pipeline-bad-args :: Int
  pipeline-bad-args = 1

  pipeline-read-failed :: Int
  pipeline-read-failed = 2

  pipeline-parse-failed :: Int
  pipeline-parse-failed = 3

  pipeline-check-refused :: Int
  pipeline-check-refused = 4

  pipeline-emit-refused :: Int
  pipeline-emit-refused = 5

  pipeline-write-failed :: Int
  pipeline-write-failed = 6

  pipeline-interface-failed :: Int
  pipeline-interface-failed = 7

  -- --------------------------------------------------------------- helpers

  -- The refusal file sits beside the IR module: a `.diagnostics` suffix on
  -- the path the caller asked for, so a failed run leaves its evidence
  -- exactly where the caller looks for the module.
  refusal-path :: Path -> Path
  refusal-path ir = path-from-string (string-concat (path-to-string ir) ".diagnostics")

  -- Write a refusal's text and answer with the stage's code; a write that
  -- itself fails is its own code, because then the evidence is missing.
  write-failure :: forall r. using (io :: Io r) => Path -> String -> Int ->{IO r} Int
  write-failure ir text code = write-runtime-output ir (failure-output text code)

  -- A refusal the caller reads where the artifact would have gone: the
  -- diagnostic file beside the IR path, with the stage's code.
  report-target-refusal :: forall r. using (io :: Io r) => Path -> String ->{IO r} Int
  report-target-refusal ir message = write-failure ir message pipeline-bad-args

  -- The four argument words, or None when the caller gave fewer.
  four-words :: List String -> Option (String, String, String, String)
  four-words ws = case ws of
    [a, b, c, d] -> Some (a, b, c, d)
    _ -> None

  -- ------------------------------------------------------------ the chain

  -- Source to running binary. Each stage hands its artifact to the next,
  -- and the first refusal stops the run with the code that names it.
  --
  -- The selected profile controls source conditions and the target of the
  -- emitted runtime module, including its parallel runtime entry points.
  compile-source :: forall r. using (io :: Io r) => Bool -> Bool -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source inlining reclaim source ir exe report = compile-source-mode-at inlining reclaim None CompileAndRun source ir exe report

  compile-source-mode :: forall r. using (io :: Io r) => Bool -> Bool -> PipelineMode -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-mode inlining reclaim mode source ir exe report = compile-source-mode-at inlining reclaim None mode source ir exe report

  compile-source-mode-at :: forall r. using (io :: Io r) => Bool -> Bool -> Option String -> PipelineMode -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-mode-at inlining reclaim wanted mode source ir exe report =
    compile-source-profile-mode inlining reclaim (target-profile wanted) mode source ir exe report
  effective-inlining :: CompileTuning -> Bool -> Bool
  effective-inlining tuning requested = if tuning-is-latency tuning then False else requested

  compile-source-profile-mode :: forall r. using (io :: Io r) => Bool -> Bool -> Result String TargetProfile -> PipelineMode -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-profile-mode inlining reclaim selection mode source ir exe report =
    compile-source-profile-mode-tuned default-tuning inlining reclaim selection mode source ir exe report
  compile-source-profile-mode-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Result String TargetProfile -> PipelineMode -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-profile-mode-tuned tuning inlining reclaim selection mode source ir exe report = case selection of
    Err message -> write-failure ir message pipeline-bad-args
    Ok profile -> case mode of
      InterfacesOnly -> compile-source-interfaces-tuned tuning profile [] source ir
      ObjectOnly -> pipeline-bad-args
      EmitWithInterfaces -> pipeline-bad-args
      other -> case fs-read (path-from-string source) of
        Err e -> pipeline-read-failed
        Ok src -> after-parse-tuned tuning (effective-inlining tuning inlining) reclaim profile mode source src (parse-program-with-index-tuned tuning source src hash-map-empty) ir exe report

  compile-source-with-manifest :: forall r. using (io :: Io r) => Bool -> Bool -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-with-manifest inlining reclaim manifest source ir exe report = compile-source-with-manifest-mode-at inlining reclaim None CompileAndRun manifest source ir exe report

  compile-source-with-manifest-mode :: forall r. using (io :: Io r) => Bool -> Bool -> PipelineMode -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-with-manifest-mode inlining reclaim mode manifest source ir exe report = compile-source-with-manifest-mode-at inlining reclaim None mode manifest source ir exe report

  compile-source-with-manifest-mode-at :: forall r. using (io :: Io r) => Bool -> Bool -> Option String -> PipelineMode -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-with-manifest-mode-at inlining reclaim wanted mode manifest source ir exe report =
    compile-manifest-profile-mode inlining reclaim (target-profile wanted) mode manifest source ir exe report
  compile-manifest-profile-mode :: forall r. using (io :: Io r) => Bool -> Bool -> Result String TargetProfile -> PipelineMode -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-manifest-profile-mode inlining reclaim selection mode manifest source ir exe report =
    compile-manifest-profile-mode-tuned default-tuning inlining reclaim selection mode manifest source ir exe report
  compile-manifest-profile-mode-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Result String TargetProfile -> PipelineMode -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-manifest-profile-mode-tuned tuning inlining reclaim selection mode manifest source ir exe report = case selection of
    Err message -> write-failure ir message pipeline-bad-args
    Ok profile -> if interface-output-conflict mode ir manifest then pipeline-bad-args else case read-validated-interfaces manifest of
      Err message -> write-failure ir (string-concat "bootstrap.interfaces: " message) pipeline-interface-failed
      Ok admitted ->
        let interfaces = admitted.interfaces-members in
        (case mode of
          InterfacesOnly -> compile-source-interfaces-tuned tuning profile interfaces source ir
          ObjectOnly -> pipeline-bad-args
          EmitWithInterfaces -> pipeline-bad-args
          other -> (case fs-read (path-from-string source) of
            Err error -> pipeline-read-failed
            Ok src -> after-parse-with-tuned tuning (effective-inlining tuning inlining) reclaim profile mode admitted source src (parse-program-with-index-tuned tuning source src (module-name-index (interface-fixity-headers interfaces))) ir exe report))

  -- `debug` selects debug counting (`--rc-debug`): the emitted program's
  -- count operations call the runtime's checked out-of-line entries.
  -- `reclaim` is the other half of the same choice (`--no-reclaim`): with
  -- it off no ownership operation is emitted at all and the program leaks.
  -- `inlining` selects unit copying; `--no-inline` turns it off.
  compile-source-with-object :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> String -> String -> String -> Path ->{IO r, Diverge} Int
  compile-source-with-object inlining debug reclaim manifest object-config source ir = compile-source-object inlining debug reclaim None False manifest object-config source ir
  compile-source-with-object-interfaces :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> String -> String -> String -> Path ->{IO r, Diverge} Int
  compile-source-with-object-interfaces inlining debug reclaim manifest object-config source ir = compile-source-object inlining debug reclaim None True manifest object-config source ir
  compile-source-object :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> Option String -> Bool -> String -> String -> String -> Path ->{IO r, Diverge} Int
  compile-source-object inlining debug reclaim wanted publish manifest object-config source ir =
    compile-source-object-mode inlining debug reclaim wanted (if publish then EmitWithInterfaces else EmitOnly) manifest object-config source ir
  compile-source-object-mode :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> Option String -> PipelineMode -> String -> String -> String -> Path ->{IO r, Diverge} Int
  compile-source-object-mode inlining debug reclaim wanted mode manifest object-config source ir =
    compile-object-profile-mode inlining debug reclaim (target-profile wanted) mode manifest object-config source ir
  compile-object-profile-mode :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> Result String TargetProfile -> PipelineMode -> String -> String -> String -> Path ->{IO r, Diverge} Int
  compile-object-profile-mode inlining debug reclaim selection mode manifest object-config source ir =
    compile-object-profile-mode-tuned default-tuning inlining debug reclaim selection mode manifest object-config source ir
  compile-object-profile-mode-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Bool -> Result String TargetProfile -> PipelineMode -> String -> String -> String -> Path ->{IO r, Diverge} Int
  compile-object-profile-mode-tuned tuning inlining debug reclaim selection mode manifest object-config source ir = case selection of
    Err message -> write-failure ir message pipeline-bad-args
    Ok profile -> case mode of
      EmitWithInterfaces -> publish-object-client-tuned tuning (effective-inlining tuning inlining) debug reclaim profile manifest object-config source ir
      ServeIr -> serve-object-client-tuned tuning inlining debug reclaim profile manifest object-config source ir
      ServeStream -> serve-stream-client-tuned tuning inlining debug reclaim profile manifest object-config source ir
      IrOnly -> emit-admitted-object-client-tuned tuning (effective-inlining tuning inlining) debug reclaim profile IrOnly manifest object-config source ir
      EmitOnly -> emit-admitted-object-client-tuned tuning (effective-inlining tuning inlining) debug reclaim profile EmitOnly manifest object-config source ir
      other -> pipeline-bad-args
  emit-admitted-object-client :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> TargetProfile -> PipelineMode -> String -> String -> String -> Path ->{IO r, Diverge} Int
  emit-admitted-object-client inlining debug reclaim profile mode manifest object-config source ir =
    emit-admitted-object-client-tuned default-tuning inlining debug reclaim profile mode manifest object-config source ir
  emit-admitted-object-client-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Bool -> TargetProfile -> PipelineMode -> String -> String -> String -> Path ->{IO r, Diverge} Int
  emit-admitted-object-client-tuned tuning inlining debug reclaim profile mode manifest object-config source ir =
    let arena = arena-new phase-arena-first-chunk in
    let status = (case load-object-client reclaim (read-interface-inputs manifest) (read-runtime-object-config object-config) of
      Err message -> write-failure ir message pipeline-interface-failed
      Ok (checked, provider, metadata, object-path, code) -> if not (provider-matches-profile metadata profile) then write-failure ir "bootstrap.object: runtime object target mismatch" pipeline-interface-failed else emit-object-client-tuned tuning inlining debug reclaim profile mode checked provider source ir) in
    case arena-leave arena of _ -> status

  load-object-client :: forall r. using (io :: Io r) => Bool -> Result String InterfaceInputs -> Result String RuntimeObjectConfig ->{IO r} Result String (ValidatedInterfaces, RuntimeObject, Json, String, Bytes)
  load-object-client reclaim references configuration = case references of
    Err message -> Err ("bootstrap.interfaces: " <> message)
    Ok inputs ->
      let metadata = (case configuration of Err message -> None; Ok config -> Some (config.object-metadata-file)) in
      (case load-client-interface-inputs inputs metadata of
        Err message -> Err ("bootstrap.interfaces: " <> message)
        Ok (checked, snapshot) -> (case configuration of
          Err message -> Err ("bootstrap.object: " <> message)
          Ok config ->
            let admitted = (case snapshot of
                  None -> admit-runtime-object-client-mode reclaim checked config
                  Some package -> admit-runtime-object-package-client reclaim checked config package) in
            (case admitted of
              Err message -> Err ("bootstrap.object: " <> message)
              Ok (provider, metadata, path, code) -> Ok (checked, provider, metadata, path, code))))

  data IncrementalStep where
    StepSuccess :: RuntimeOutput -> IncrementalSession -> String -> Nat -> Nat -> Nat -> Nat -> IncrementalStep
    StepFailure :: RuntimeOutput -> IncrementalSession -> String -> Int -> IncrementalStep

  write-stream-text :: forall r. using (io :: Io r) => Bool -> String ->{IO r} Unit
  write-stream-text enabled text =
    if enabled then case ioWrite (string-to-bytes text) of _ -> ()
    else ()

  record ServeEnv where
    profile :: TargetProfile
    inlining :: Bool
    debug :: Bool
    reclaim :: Bool
    interfaces :: List LoadedInterface
    headers :: HashMap String Module
    provider :: RuntimeObject
    resolve :: Program -> List LoadedInterface -> (Program, List Diagnostic, Bool)
    retain-cached :: CompileTuning -> Bool -> HashMap String CoreDefinition -> Program -> Result (List Diagnostic) CheckedProgram
    source :: String

  -- Execute one resident incremental build request (shared by --serve-ir and
  -- --serve-stream). Uses REAPER item fingerprinting + INCR body-only recheck
  -- + LINK per-unit IR cache reuse when the surface holds, and falls back
  -- cleanly to the parallel full build on surface/proof/overlay changes.
  run-incremental-request-env :: forall r. using (io :: Io r) => Bool -> CompileTuning -> ServeEnv -> Bytes -> IncrementalSession ->{IO r, Diverge} IncrementalStep
  run-incremental-request-env streaming tuning env src session = case env of
    ServeEnv profile inlining debug reclaim interfaces headers provider resolve retain-cached source ->
      let next-rev = session.revision + 1 in
      let use-inline = effective-inlining tuning inlining in
      case parse-program-with-index-tuned tuning source src headers of
        Failed bundle ->
          let msg = render-bundle bundle in
          StepFailure (failure-output msg pipeline-parse-failed) (invalidate-incremental-session session) msg pipeline-parse-failed
        Parsed program (err : more) ->
          let msg = render-bundle (Bundle source src (err : more)) in
          StepFailure (failure-output msg pipeline-parse-failed) (invalidate-incremental-session session) msg pipeline-parse-failed
        Parsed program [] -> case target-view-program profile program of
          Err message ->
            StepFailure (failure-output message pipeline-check-refused) (invalidate-incremental-session session) message pipeline-check-refused
          Ok view -> case object-source-conflict (view.modules) interfaces of
            Some name ->
              let msg = "bootstrap.object: module " <> name <> " is already supplied by the library object; rebuild the library to change it" in
              StepFailure (failure-output msg pipeline-check-refused) (invalidate-incremental-session session) msg pipeline-check-refused
            None ->
              let overlays = (if not (has-signature-overlay (view.modules)) then [] else
                    case recheck-source-overlays profile src view interfaces interfaces [] of
                      Ok (remaining, effective, rows) -> (case matched-object-overlays rows interfaces of
                        Some (first : rest) -> first : rest
                        other -> [])
                      Err message -> []) in
              let stage-resolve = \input -> case resolve input overlays of (resolved, errors, retained) -> (resolved, errors) in
              case expand-stages-with-report stage-resolve (\unit -> interface-headers interfaces) view of
                Err errors ->
                  let msg = render-source-diagnostics src errors in
                  StepFailure (failure-output msg pipeline-check-refused) (invalidate-incremental-session session) msg pipeline-check-refused
                Ok (expanded, generated) -> case resolve expanded overlays of
                  (resolved, err : more, retained) ->
                    let msg = render-source-diagnostics src (explain-expansion-errors expanded (err : more)) in
                    StepFailure (failure-output msg pipeline-check-refused) (invalidate-incremental-session session) msg pipeline-check-refused
                  (resolved, [], retained) ->
                    let active-session = case overlays of [] -> session; first : rest -> empty-incremental-session in
                    case plan-incremental-build active-session resolved of
                      PlanReuseIr new-idx cached-ir reused-n ->
                        case write-stream-text streaming (render-plan-event next-rev "noop" 0 reused-n) of
                          _ -> StepSuccess (RuntimeOutput (string-to-bytes cached-ir) (string-to-bytes "") pipeline-ok) session "noop" 0 reused-n 0 0
                      PlanBodyOnly new-idx dirty-list dirty-set reusable-core dirty-n reused-n ->
                        case write-stream-text streaming (render-plan-event next-rev "body-only" dirty-n reused-n) of
                          _ -> case retain-resolved-source profile (retain-cached tuning retained reusable-core) (resolved, []) of
                            Err errors ->
                              let msg = render-source-diagnostics src (explain-expansion-errors expanded errors) in
                              StepFailure (failure-output msg pipeline-check-refused) (invalidate-incremental-session session) msg pipeline-check-refused
                            Ok checked0 ->
                              let checked = with-generated generated checked0 in
                              case emit-runtime-program-for-profile-cached tuning profile use-inline debug reclaim checked (Some provider) (active-session.unit-cache) dirty-set of
                                Err errors ->
                                  let msg = render-diagnostics errors in
                                  StepFailure (failure-output msg pipeline-emit-refused) (invalidate-incremental-session session) msg pipeline-emit-refused
                                Ok (ir-text, next-cache, emitted-n, reused-units) ->
                                  let next-session = record-incremental-success session new-idx checked next-cache ir-text in
                                  StepSuccess (RuntimeOutput (string-to-bytes ir-text) (string-to-bytes "") pipeline-ok) next-session "body-only" dirty-n reused-n emitted-n reused-units
                      PlanFullRebuild new-idx ->
                        let total-bodies = index-body-count new-idx in
                        case write-stream-text streaming (render-plan-event next-rev "full" total-bodies 0) of
                          _ -> case retain-resolved-source profile (retain-cached tuning retained hash-map-empty) (resolved, []) of
                            Err errors ->
                              let msg = render-source-diagnostics src (explain-expansion-errors expanded errors) in
                              StepFailure (failure-output msg pipeline-check-refused) (invalidate-incremental-session session) msg pipeline-check-refused
                            Ok checked0 ->
                              let checked = with-generated generated checked0 in
                              case emit-runtime-program-for-profile-cached tuning profile use-inline debug reclaim checked (Some provider) empty-unit-ir-cache hash-map-empty of
                                Err errors ->
                                  let msg = render-diagnostics errors in
                                  StepFailure (failure-output msg pipeline-emit-refused) (invalidate-incremental-session session) msg pipeline-emit-refused
                                Ok (ir-text, next-cache, emitted-n, reused-units) ->
                                  let next-session = record-incremental-success session new-idx checked next-cache ir-text in
                                  StepSuccess (RuntimeOutput (string-to-bytes ir-text) (string-to-bytes "") pipeline-ok) next-session "full" total-bodies 0 emitted-n reused-units

  -- Hold the admitted contracts and provider for the life of the session.
  -- Each newline on stdin requests an IR build from the current source
  -- file. Stdout carries a readiness line followed by one status per
  -- request. EOF ends the session.
  serve-object-client :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> TargetProfile -> String -> String -> String -> Path ->{IO r, Diverge} Int
  serve-object-client inlining debug reclaim profile manifest object-config source ir =
    serve-object-client-tuned default-tuning inlining debug reclaim profile manifest object-config source ir
  serve-object-client-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Bool -> TargetProfile -> String -> String -> String -> Path ->{IO r, Diverge} Int
  serve-object-client-tuned tuning inlining debug reclaim profile manifest object-config source ir =
    let references = read-interface-inputs manifest in
    let configuration = read-runtime-object-config object-config in
    let normalize = \name -> path-to-string (path-normalize (path-from-string name)) in
    let outputs = map normalize [path-to-string ir, path-to-string (refusal-path ir)] in
    let interface-files = case references of Ok inputs -> interface-input-files inputs; Err message -> [] in
    let object-files = case configuration of Ok config -> runtime-object-input-files config; Err message -> [] in
    if object-input-overlaps outputs (map normalize ([manifest, object-config, source] <> interface-files <> object-files)) then pipeline-bad-args else
    case load-object-client reclaim references configuration of
      Err message -> write-failure ir message pipeline-interface-failed
      Ok (checked, provider, metadata, object-path, code) ->
        if not (provider-matches-profile metadata profile) then write-failure ir "bootstrap.object: runtime object target mismatch" pipeline-interface-failed else
        let interfaces = checked.interfaces-members in
        let headers = module-name-index (interface-fixity-headers interfaces) in
        let admitted = canonical-interface-validation checked in
        let resolve = prepare-admitted-resolution admitted in
        let retain-cached = (case admitted of Ok canonical -> prepare-admitted-check-cached canonical; Err message -> \cur-tuning retained cached -> check-and-retain-with-interfaces-tuned cur-tuning interfaces) in
        let env = ServeEnv profile inlining debug reclaim interfaces headers provider resolve retain-cached source in
        case ioWrite (string-to-bytes "ready\n") of
          _ -> serve-object-builds (string-to-bytes "\n") (path-from-string source) ir tuning env None empty-incremental-session

  serve-object-builds :: forall r. using (io :: Io r) => Bytes -> Path -> Path -> CompileTuning -> ServeEnv -> Option (Bytes, RuntimeOutput) -> IncrementalSession ->{IO r, Diverge} Int
  serve-object-builds newline source ir tuning env previous session = case ioRead 1 of
    None -> pipeline-ok
    Some token -> if bytes-compare token newline /= 0 then pipeline-bad-args else
      case fs-read source of
        Err error -> (case write-failure ir "bootstrap.object: cannot read source" pipeline-read-failed of
          status -> case ioWrite (string-to-bytes (int-to-string status <> "\n")) of
            _ -> serve-object-builds newline source ir tuning env None (invalidate-incremental-session session))
        Ok src -> case previous of
          Some (old-source, old-output) | bytes-compare old-source src == 0 ->
            (case write-resident-output ir previous old-output of
              status -> case ioWrite (string-to-bytes (int-to-string status <> "\n")) of
                _ -> serve-object-builds newline source ir tuning env (Some (src, old-output)) session)
          other -> case run-incremental-request-env False tuning env src session of
            StepSuccess output next-session kind rechecked reused-bodies emitted-units reused-units ->
              (case write-resident-output ir previous output of
                status -> case ioWrite (string-to-bytes (int-to-string status <> "\n")) of
                  _ -> serve-object-builds newline source ir tuning env (Some (src, output)) next-session)
            StepFailure output next-session message err-status ->
              (case write-resident-output ir previous output of
                status -> case ioWrite (string-to-bytes (int-to-string status <> "\n")) of
                  _ -> serve-object-builds newline source ir tuning env (Some (src, output)) next-session)

  read-stdin-line :: forall r. using (io :: Io r) => Bytes -> Bytes -> List String ->{IO r, Diverge} Option String
  read-stdin-line newline cr acc = case ioRead 1 of
    None -> case acc of
      [] -> None
      first : rest -> Some (string-concat-all (reverse acc))
    Some chunk ->
      if bytes-compare chunk newline == 0 then Some (string-concat-all (reverse acc))
      else if bytes-compare chunk cr == 0 then read-stdin-line newline cr acc
      else case string-from-bytes chunk of
        Some piece -> read-stdin-line newline cr (piece : acc)
        None -> read-stdin-line newline cr acc

  -- Streaming JSONL incremental server (--serve-stream).
  -- Commands on stdin (one per line):
  --   "" or "rebuild"       -> incremental compile, streaming plan + done/error JSONL events
  --   "mode latency"        -> switch to low-latency hot-reload strategy
  --   "mode throughput"     -> switch to full-build throughput strategy
  --   "workers N"           -> dynamically adjust worker pool budget
  --   "invalidate"          -> drop incremental caches
  --   "stats"               -> emit current session cache and tuning stats
  --   "quit" or EOF         -> exit cleanly
  serve-stream-client-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Bool -> TargetProfile -> String -> String -> String -> Path ->{IO r, Diverge} Int
  serve-stream-client-tuned tuning inlining debug reclaim profile manifest object-config source ir =
    let references = read-interface-inputs manifest in
    let configuration = read-runtime-object-config object-config in
    let normalize = \name -> path-to-string (path-normalize (path-from-string name)) in
    let outputs = map normalize [path-to-string ir, path-to-string (refusal-path ir)] in
    let interface-files = case references of Ok inputs -> interface-input-files inputs; Err message -> [] in
    let object-files = case configuration of Ok config -> runtime-object-input-files config; Err message -> [] in
    if object-input-overlaps outputs (map normalize ([manifest, object-config, source] <> interface-files <> object-files)) then pipeline-bad-args else
    case load-object-client reclaim references configuration of
      Err message -> write-failure ir message pipeline-interface-failed
      Ok (checked, provider, metadata, object-path, code) ->
        if not (provider-matches-profile metadata profile) then write-failure ir "bootstrap.object: runtime object target mismatch" pipeline-interface-failed else
        let interfaces = checked.interfaces-members in
        let headers = module-name-index (interface-fixity-headers interfaces) in
        let admitted = canonical-interface-validation checked in
        let resolve = prepare-admitted-resolution admitted in
        let retain-cached = (case admitted of Ok canonical -> prepare-admitted-check-cached canonical; Err message -> \cur-tuning retained cached -> check-and-retain-with-interfaces-tuned cur-tuning interfaces) in
        let env = ServeEnv profile inlining debug reclaim interfaces headers provider resolve retain-cached source in
        case ioWrite (string-to-bytes (render-ready-event tuning)) of
          _ -> serve-stream-loop (string-to-bytes "\n") (string-to-bytes "\r") (path-from-string source) ir env inlining tuning None empty-incremental-session

  serve-stream-loop :: forall r. using (io :: Io r) => Bytes -> Bytes -> Path -> Path -> ServeEnv -> Bool -> CompileTuning -> Option (Bytes, RuntimeOutput) -> IncrementalSession ->{IO r, Diverge} Int
  serve-stream-loop newline cr source ir env inlining tuning previous session =
    case read-stdin-line newline cr [] of
      None -> pipeline-ok
      Some raw ->
        let cmd = string-strip raw in
        if cmd == "quit" then pipeline-ok
        else if cmd == "stats" then
          case ioWrite (string-to-bytes (render-stats-event session tuning)) of
            _ -> serve-stream-loop newline cr source ir env inlining tuning previous session
        else if cmd == "invalidate" then
          let cleared = invalidate-incremental-session session in
          case ioWrite (string-to-bytes (render-stats-event cleared tuning)) of
            _ -> serve-stream-loop newline cr source ir env inlining tuning None cleared
        else if string-starts-with "mode " cmd then
          let arg = string-strip (string-drop 5 cmd) in
          case parse-compile-strategy arg of
            Some next-strat ->
              let next-tuning = tuning-with-strategy next-strat tuning in
              let changed-inline = effective-inlining tuning inlining /= effective-inlining next-tuning inlining in
              let next-session = if changed-inline then invalidate-incremental-session session else session in
              let next-prev = if changed-inline then None else previous in
              case ioWrite (string-to-bytes (render-stats-event next-session next-tuning)) of
                _ -> serve-stream-loop newline cr source ir env inlining next-tuning next-prev next-session
            None ->
              case ioWrite (string-to-bytes (render-error-event (session.revision) pipeline-bad-args ("unknown compile strategy: " <> arg))) of
                _ -> serve-stream-loop newline cr source ir env inlining tuning previous session
        else if string-starts-with "workers " cmd then
          let arg = string-strip (string-drop 8 cmd) in
          case parse-nat-word arg of
            Some count ->
              case apply-worker-budget count of
                _ ->
                  let next-tuning = tuning-with-workers count tuning in
                  case ioWrite (string-to-bytes (render-stats-event session next-tuning)) of
                    _ -> serve-stream-loop newline cr source ir env inlining next-tuning previous session
            None ->
              case ioWrite (string-to-bytes (render-error-event (session.revision) pipeline-bad-args ("invalid worker count: " <> arg))) of
                _ -> serve-stream-loop newline cr source ir env inlining tuning previous session
        else if cmd == "" || cmd == "rebuild" then
          let next-rev = session.revision + 1 in
          case fs-read source of
            Err error ->
              let msg = "bootstrap.object: cannot read source" in
              case write-failure ir msg pipeline-read-failed of
                status -> case ioWrite (string-to-bytes (render-error-event next-rev status msg)) of
                  _ -> serve-stream-loop newline cr source ir env inlining tuning None (invalidate-incremental-session session)
            Ok src -> case run-incremental-request-env True tuning env src session of
              StepSuccess output next-session kind rechecked reused-bodies emitted-units reused-units ->
                case write-resident-output ir previous output of
                  status -> case ioWrite (string-to-bytes (render-done-event next-rev status kind rechecked reused-bodies emitted-units reused-units)) of
                    _ -> serve-stream-loop newline cr source ir env inlining tuning (Some (src, output)) next-session
              StepFailure output next-session message err-status ->
                case write-resident-output ir previous output of
                  status -> case ioWrite (string-to-bytes (render-error-event next-rev err-status message)) of
                    _ -> serve-stream-loop newline cr source ir env inlining tuning (Some (src, output)) next-session
        else
          case ioWrite (string-to-bytes (render-error-event (session.revision) pipeline-bad-args ("unknown stream command: " <> cmd))) of
            _ -> serve-stream-loop newline cr source ir env inlining tuning previous session

  publish-object-client :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> TargetProfile -> String -> String -> String -> Path ->{IO r, Diverge} Int
  publish-object-client inlining debug reclaim profile manifest object-config source ir =
    publish-object-client-tuned default-tuning inlining debug reclaim profile manifest object-config source ir
  publish-object-client-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Bool -> TargetProfile -> String -> String -> String -> Path ->{IO r, Diverge} Int
  publish-object-client-tuned tuning inlining debug reclaim profile manifest object-config source ir =
    let arena = arena-new phase-arena-first-chunk in
    let status = (
      let output = build-manifest-path ir in
      let normalize-name = \name -> path-to-string (path-normalize (path-from-string name)) in
      let package = interface-output-path ir in
      let outputs = map normalize-name [path-to-string ir, path-to-string (refusal-path ir), path-to-string output, path-to-string package] in
      let direct = map normalize-name [manifest, object-config, source] in
      if not (object-paths-distinct (outputs <> direct)) then pipeline-bad-args else
        let references = read-interface-inputs manifest in
        let configuration = read-runtime-object-config object-config in
        let interface-inputs = (case references of Err message -> []; Ok rows -> interface-input-files rows) in
        let object-inputs = (case configuration of Err message -> []; Ok config -> runtime-object-input-files config) in
        if object-input-overlaps outputs (map normalize-name (interface-inputs <> object-inputs)) then pipeline-bad-args else
          (case invalidate-interface-package package of
            Err message -> pipeline-write-failed
            Ok ready -> (case fs-write output (string-to-bytes "") of
              Err error -> pipeline-write-failed
              Ok cleared -> case load-object-client reclaim references configuration of
                Err message -> write-failure ir message pipeline-interface-failed
                Ok (checked, provider, metadata, object-path, code) ->
                  if not (provider-matches-profile metadata profile) then write-failure ir "bootstrap.object: runtime object target mismatch" pipeline-interface-failed else
                    emit-object-client-tuned tuning inlining debug reclaim profile EmitWithInterfaces checked provider source ir))) in
    case arena-leave arena of _ -> status

  object-input-overlaps :: List String -> List String -> Bool
  object-input-overlaps outputs inputs = case inputs of
    [] -> False
    first : rest -> object-path-member first outputs || object-input-overlaps outputs rest

  build-manifest-path :: Path -> Path
  build-manifest-path ir = path-from-string (path-to-string ir <> ".manifest.json")
  emit-object-client :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> TargetProfile -> PipelineMode -> ValidatedInterfaces -> RuntimeObject -> String -> Path ->{IO r, Diverge} Int
  emit-object-client inlining debug reclaim profile mode admitted provider source ir =
    emit-object-client-tuned default-tuning inlining debug reclaim profile mode admitted provider source ir
  emit-object-client-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Bool -> TargetProfile -> PipelineMode -> ValidatedInterfaces -> RuntimeObject -> String -> Path ->{IO r, Diverge} Int
  emit-object-client-tuned tuning inlining debug reclaim profile mode admitted provider source ir =
    let interfaces = admitted.interfaces-members in
    let headers = module-name-index (interface-fixity-headers interfaces) in
    emit-object-client-using-tuned tuning inlining debug reclaim profile mode interfaces provider
      (\name src -> parse-program-with-index-tuned tuning name src headers) (\bytes program -> check-object-client-tuned tuning profile bytes program admitted) source ir
  emit-object-client-using :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> TargetProfile -> PipelineMode -> List LoadedInterface -> RuntimeObject -> (String -> Bytes -> ParseOutcome Program) -> (Bytes -> Program -> Result String CheckedProgram) -> String -> Path ->{IO r, Diverge} Int
  emit-object-client-using inlining debug reclaim profile mode interfaces provider parse check source ir =
    emit-object-client-using-tuned default-tuning inlining debug reclaim profile mode interfaces provider parse check source ir
  emit-object-client-using-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Bool -> TargetProfile -> PipelineMode -> List LoadedInterface -> RuntimeObject -> (String -> Bytes -> ParseOutcome Program) -> (Bytes -> Program -> Result String CheckedProgram) -> String -> Path ->{IO r, Diverge} Int
  emit-object-client-using-tuned tuning inlining debug reclaim profile mode interfaces provider parse check source ir =
    case fs-read (path-from-string source) of
      Err error -> write-failure ir "bootstrap.object: cannot read source" pipeline-read-failed
      Ok src -> case checked-object-bytes profile parse check source src of
        Err (message, status) -> write-failure ir message status
        Ok (view, checked) -> case mode of
          IrOnly -> write-runtime-module ir (emit-target-program-tuned tuning profile inlining debug reclaim checked (Some provider))
          other -> let admitted = unshadowed-interfaces (view.modules) interfaces in
            let entry = path-stem (path-from-string source) in
            let exported = export-interfaces-aliased checked admitted src in
            case serialize-exported checked profile entry admitted [] exported of
              done -> after-object-client-tuned tuning profile inlining debug reclaim (case mode of EmitWithInterfaces -> True; other -> False) admitted provider checked entry exported ir

  checked-object-bytes :: TargetProfile -> (String -> Bytes -> ParseOutcome Program) -> (Bytes -> Program -> Result String CheckedProgram) -> String -> Bytes -> Result (String, Int) (Program, CheckedProgram)
  checked-object-bytes profile parse check source src = case parse source src of
    Failed bundle -> Err (render-bundle bundle, pipeline-parse-failed)
    Parsed program [] -> case target-view-program profile program of
      Err message -> Err (message, pipeline-check-refused)
      Ok view -> case check src view of
        Err message -> Err (message, pipeline-check-refused)
        Ok checked -> Ok (view, checked)
    Parsed program errors -> Err (render-bundle (Bundle source src errors), pipeline-parse-failed)

  -- Interface publication and ordinary compilation share the same checked rows.
  after-object-client :: forall r. using (io :: Io r) => TargetProfile -> Bool -> Bool -> Bool -> Bool -> List LoadedInterface -> RuntimeObject -> CheckedProgram -> String -> Result String (List (String, Json)) -> Path ->{IO r, Diverge} Int
  after-object-client profile inlining debug reclaim publish admitted provider checked entry exported ir =
    after-object-client-tuned default-tuning profile inlining debug reclaim publish admitted provider checked entry exported ir
  after-object-client-tuned :: forall r. using (io :: Io r) => CompileTuning -> TargetProfile -> Bool -> Bool -> Bool -> Bool -> List LoadedInterface -> RuntimeObject -> CheckedProgram -> String -> Result String (List (String, Json)) -> Path ->{IO r, Diverge} Int
  after-object-client-tuned tuning profile inlining debug reclaim publish admitted provider checked entry exported ir =
    if not publish then write-runtime-module ir (emit-target-program-tuned tuning profile inlining debug reclaim checked (Some provider))
    else case exported of
      Err message -> write-failure ir ("bootstrap.export: " <> message) pipeline-emit-refused
      Ok rows -> case write-interface-output ir (Ok rows) of
        0 -> case write-runtime-module ir (emit-target-program-tuned tuning profile inlining debug reclaim checked (Some provider)) of
          0 -> (case fs-write (build-manifest-path ir)
              (canonical-bytes (build-generated-manifest (checked.generated) (checked-primitive-rows checked) entry (manifest-target profile) admitted rows)) of
            Ok written -> pipeline-ok
            Err error -> write-failure ir "bootstrap.export: cannot write build manifest" pipeline-write-failed)
          code -> code
        code -> code

  run-source-with-object :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> String -> String -> String -> String -> String -> List String ->{IO r, Diverge} Int
  run-source-with-object inlining debug reclaim manifest config runtime prefix source words = run-source-with-object-at inlining debug reclaim host-profile manifest config runtime prefix source words

  run-source-with-object-at :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> TargetProfile -> String -> String -> String -> String -> String -> List String ->{IO r, Diverge} Int
  run-source-with-object-at inlining debug reclaim profile manifest config runtime prefix source words =
    link-source-with-object inlining debug reclaim profile manifest config runtime prefix source "clang" (Some words)

  link-source-with-object :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> TargetProfile -> String -> String -> String -> String -> String -> String -> Option (List String) ->{IO r, Diverge} Int
  link-source-with-object inlining debug reclaim profile manifest config runtime prefix source clang run =
    link-source-with-object-tuned default-tuning inlining debug reclaim profile manifest config runtime prefix source clang run
  link-source-with-object-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Bool -> TargetProfile -> String -> String -> String -> String -> String -> String -> Option (List String) ->{IO r, Diverge} Int
  link-source-with-object-tuned tuning inlining debug reclaim profile manifest config runtime prefix source clang run =
    let use-inline = effective-inlining tuning inlining in
    let ir = path-from-string (prefix <> ".ll") in
    let executable = prefix <> ".exe" in
    let object-copy = prefix <> ".library.o" in
    let normalize-path = \name -> path-to-string (path-normalize (path-from-string name)) in
    let paths = map normalize-path [manifest, config, runtime, source, path-to-string ir, path-to-string (refusal-path ir), executable, object-copy] in
    if not (object-paths-distinct paths) then pipeline-bad-args
    else let references = read-interface-inputs manifest in
      let configuration = read-runtime-object-config config in
      case (references, configuration) of
        (Ok inputs, Ok settings) -> (case interface-package-file inputs of
          Some package | (package == settings.object-metadata-file) ->
            let receipt = path-from-string (prefix <> ".ll.receipt") in
            let receipt-name = normalize-path (path-to-string receipt) in
            let additional = map normalize-path (runtime-object-input-files settings) in
            if object-path-member receipt-name (paths <> additional) || object-input-overlaps (map normalize-path [path-to-string ir, path-to-string (refusal-path ir), executable, object-copy]) additional then pipeline-bad-args
            else case read-packed-client settings of
              Err message -> write-failure ir message pipeline-interface-failed
              Ok packed -> case prepare-packed-build-tuned tuning packed profile use-inline debug reclaim source ir receipt of
                0 -> finish-native-build-tuned tuning ir executable object-copy runtime (profile.triple) (packed.client-code) clang run
                code -> code
          other -> link-uncached-client-tuned tuning use-inline debug reclaim profile references configuration source paths ir executable object-copy runtime clang run)
        other -> link-uncached-client-tuned tuning use-inline debug reclaim profile references configuration source paths ir executable object-copy runtime clang run

  link-uncached-client :: forall r. using (io :: Io r) => Bool -> Bool -> Bool -> TargetProfile -> Result String InterfaceInputs -> Result String RuntimeObjectConfig -> String -> List String -> Path -> String -> String -> String -> String -> Option (List String) ->{IO r, Diverge} Int
  link-uncached-client inlining debug reclaim profile references configuration source paths ir executable object-copy runtime clang run =
    link-uncached-client-tuned default-tuning inlining debug reclaim profile references configuration source paths ir executable object-copy runtime clang run
  link-uncached-client-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Bool -> TargetProfile -> Result String InterfaceInputs -> Result String RuntimeObjectConfig -> String -> List String -> Path -> String -> String -> String -> String -> Option (List String) ->{IO r, Diverge} Int
  link-uncached-client-tuned tuning inlining debug reclaim profile references configuration source paths ir executable object-copy runtime clang run =
    case load-object-client reclaim references configuration of
      Err message -> write-failure ir message pipeline-interface-failed
      Ok (checked, provider, metadata, object-path, object-bytes) ->
        if not (provider-matches-profile metadata profile) then write-failure ir "bootstrap.object: runtime object target mismatch" pipeline-interface-failed
        else if object-path-member (path-to-string (path-normalize (path-from-string object-path))) paths then pipeline-bad-args
        else
          let arena = arena-new phase-arena-first-chunk in
          let emitted = emit-object-client-tuned tuning inlining debug reclaim profile IrOnly checked provider source ir in
          case arena-leave arena of
            _ -> case emitted of
              0 -> finish-native-build-tuned tuning ir executable object-copy runtime (profile.triple) object-bytes clang run
              code -> code

  prepare-packed-build :: forall r. using (io :: Io r) => PackedClient -> TargetProfile -> Bool -> Bool -> Bool -> String -> Path -> Path ->{IO r} Int
  prepare-packed-build packed profile inlining debug reclaim source ir receipt =
    prepare-packed-build-tuned default-tuning packed profile inlining debug reclaim source ir receipt
  prepare-packed-build-tuned :: forall r. using (io :: Io r) => CompileTuning -> PackedClient -> TargetProfile -> Bool -> Bool -> Bool -> String -> Path -> Path ->{IO r} Int
  prepare-packed-build-tuned tuning packed profile inlining debug reclaim source ir receipt =
    let arena = arena-new phase-arena-first-chunk in
    let status = (case packed-client-key packed of
      (triple, object-hash, package-hash) ->
        if triple /= profile.triple then write-failure ir "bootstrap.object: runtime object target mismatch" pipeline-interface-failed
        else case fs-read (path-from-string source) of
          Err error -> write-failure ir "bootstrap.object: cannot read source" pipeline-read-failed
          Ok src ->
            let key = sha256-hex (canonical-bytes (JObj "compiler" (JStr compiler-epoch)
              (JObj "source" (JStr source) (JObj "source_sha256" (JStr (sha256-hex src))
                (JObj "package" (JStr package-hash) (JObj "object" (JStr object-hash)
                  (JObj "profile" (manifest-target profile) (JObj "inline" (JBool inlining)
                    (JObj "rc_debug" (JBool debug) (JObj "reclaim" (JBool reclaim) JObjEnd)))))))))) in
            if cached-native-ir receipt key ir then
              (case refresh-resident-file (refusal-path ir) (string-to-bytes "") (string-to-bytes "") of
                Err error -> pipeline-write-failed
                Ok cleared -> pipeline-ok)
            else case admit-packed-client packed reclaim of
              Err message -> write-failure ir message pipeline-interface-failed
              Ok (admitted, provider, metadata) -> if not (provider-matches-profile metadata profile)
                then write-failure ir "bootstrap.object: runtime object target mismatch" pipeline-interface-failed
                else
                  let interfaces = admitted.interfaces-members in
                  let headers = module-name-index (interface-fixity-headers interfaces) in
                  let parse = \name input -> parse-program-with-index-tuned tuning name input headers in
                  let check = \bytes program -> check-object-client-tuned tuning profile bytes program admitted in
                  let output = (case checked-object-bytes profile parse check source src of
                    Err (message, status) -> failure-output message status
                    Ok (view, checked) -> runtime-module-output (emit-target-program-tuned tuning profile inlining debug reclaim checked (Some provider))) in
                  write-native-ir ir receipt key output) in
    case arena-leave arena of _ -> status

  write-native-ir :: forall r. using (io :: Io r) => Path -> Path -> String -> RuntimeOutput ->{IO r} Int
  write-native-ir ir receipt key output = case output of
    RuntimeOutput code diagnostics status -> case write-runtime-output ir output of
      0 -> (case replace-object-package receipt (native-ir-receipt key code) of
        _ -> pipeline-ok)
      failed -> failed

  native-ir-receipt :: String -> Bytes -> Bytes
  native-ir-receipt key code = string-to-bytes (key <> "\n" <> sha256-hex code <> "\n")

  cached-native-ir :: forall r. using (io :: Io r) => Path -> String -> Path ->{IO r} Bool
  cached-native-ir receipt key ir = case fs-metadata receipt of
    Ok meta | file-meta-size meta == 130 -> (case fs-read receipt of
      Ok recorded | bytes-len recorded == 130 && bytes-compare (bytes-slice recorded 0 65) (string-to-bytes (key <> "\n")) == 0 ->
        (case fs-read ir of
          Ok code -> bytes-len code > 0 && bytes-compare recorded (native-ir-receipt key code) == 0
          Err error -> False)
      other -> False)
    other -> False

  finish-native-build :: forall r. using (io :: Io r) => Path -> String -> String -> String -> String -> Bytes -> String -> Option (List String) ->{IO r, Diverge} Int
  finish-native-build ir executable object-copy runtime triple code clang run =
    finish-native-build-tuned default-tuning ir executable object-copy runtime triple code clang run
  finish-native-build-tuned :: forall r. using (io :: Io r) => CompileTuning -> Path -> String -> String -> String -> String -> Bytes -> String -> Option (List String) ->{IO r, Diverge} Int
  finish-native-build-tuned tuning ir executable object-copy runtime triple code clang run =
    case refresh-resident-file (path-from-string object-copy) code code of
      Err error -> pipeline-write-failed
      Ok written -> link-object-client-tuned tuning ir executable object-copy runtime triple clang run

  link-object-client :: forall r. using (io :: Io r) => Path -> String -> String -> String -> String -> String -> Option (List String) ->{IO r, Diverge} Int
  link-object-client ir executable object-copy runtime triple clang run =
    link-object-client-tuned default-tuning ir executable object-copy runtime triple clang run
  link-object-client-tuned :: forall r. using (io :: Io r) => CompileTuning -> Path -> String -> String -> String -> String -> String -> Option (List String) ->{IO r, Diverge} Int
  link-object-client-tuned tuning ir executable object-copy runtime triple clang run =
    let opt-flag = if tuning-is-latency tuning then "-O0" else "-O2" in
    let arguments = [opt-flag, "-Wno-override-module", path-to-string ir, object-copy, runtime, "-o", executable] in
    let system-libs = if string-contains "-linux" triple then ["-ldl", "-lpthread", "-lm"] else [] in
    case process-run (command (path-from-string clang) (arguments <> system-libs)) "" of
      Ok (0, output) -> (case run of
        None -> pipeline-ok
        Some words -> let program = path-from-string executable in
          let program-path = if path-is-absolute program then program else path-from-string ("./" <> executable) in
          (case process-run (command program-path words) "" of
            Ok (status, output) -> case ioWrite output of _ -> nat-to-int status
            Err error -> write-failure ir "bootstrap.driver: cannot execute linked program" pipeline-emit-refused))
      other -> write-failure ir "bootstrap.driver: could not link executable and runtime objects" pipeline-emit-refused

  -- The interface-only path shares the real parser, resolver and retained
  -- checker. It never asks another compiler to manufacture source contracts.
  checked-source :: TargetProfile -> Program -> List LoadedInterface -> Result (List Diagnostic) CheckedProgram
  checked-source profile program interfaces = checked-source-tuned default-tuning profile program interfaces
  checked-source-tuned :: CompileTuning -> TargetProfile -> Program -> List LoadedInterface -> Result (List Diagnostic) CheckedProgram
  checked-source-tuned tuning profile program interfaces = check-source-phase-tuned tuning profile interfaces (\input -> resolve-program-with input interfaces) program
  checked-admitted-source :: TargetProfile -> ValidatedInterfaces -> List LoadedInterface -> Program -> Result (List Diagnostic) CheckedProgram
  checked-admitted-source profile checked overlays program = checked-admitted-source-tuned default-tuning profile checked overlays program
  checked-admitted-source-tuned :: CompileTuning -> TargetProfile -> ValidatedInterfaces -> List LoadedInterface -> Program -> Result (List Diagnostic) CheckedProgram
  checked-admitted-source-tuned tuning profile checked overlays program =
    let interfaces = checked.interfaces-members in
    let admitted = canonical-interface-validation checked in
    let check = (case admitted of
      Ok canonical -> check-and-retain-with-admitted-interfaces-tuned tuning canonical
      Err message -> check-and-retain-with-interfaces-tuned tuning interfaces) in
    checked-admitted-source-using profile interfaces check
      (\input replacements -> resolve-admitted-signature-overlays input admitted replacements) overlays program
  checked-admitted-source-using :: TargetProfile -> List LoadedInterface -> (Program -> Result (List Diagnostic) CheckedProgram) -> (Program -> List LoadedInterface -> (Program, List Diagnostic)) -> List LoadedInterface -> Program -> Result (List Diagnostic) CheckedProgram
  checked-admitted-source-using profile interfaces check resolve overlays program =
    check-source-using profile interfaces check (\input -> resolve input overlays) program
  -- Both closures were prepared from the same admitted package. Only the
  -- final resolution can attest to the documents the checker receives.
  checked-prepared-source :: TargetProfile -> List LoadedInterface -> (Bool -> Program -> Result (List Diagnostic) CheckedProgram) -> (Program -> List LoadedInterface -> (Program, List Diagnostic, Bool)) -> List LoadedInterface -> Program -> Result (List Diagnostic) CheckedProgram
  checked-prepared-source profile interfaces check resolve overlays program =
    let stage-resolve = \input -> case resolve input overlays of (resolved, errors, retained) -> (resolved, errors) in
    let finish = \input -> (case resolve input overlays of
      (resolved, errors, retained) -> retain-resolved-source profile (check retained) (resolved, errors)) in
    check-expanded-source interfaces stage-resolve finish program
  check-source-phase :: TargetProfile -> List LoadedInterface -> (Program -> (Program, List Diagnostic)) -> Program -> Result (List Diagnostic) CheckedProgram
  check-source-phase profile interfaces resolve program =
    check-source-phase-tuned default-tuning profile interfaces resolve program
  check-source-phase-tuned :: CompileTuning -> TargetProfile -> List LoadedInterface -> (Program -> (Program, List Diagnostic)) -> Program -> Result (List Diagnostic) CheckedProgram
  check-source-phase-tuned tuning profile interfaces resolve program =
    check-source-using profile interfaces (check-and-retain-with-interfaces-tuned tuning interfaces) resolve program
  check-source-using :: TargetProfile -> List LoadedInterface -> (Program -> Result (List Diagnostic) CheckedProgram) -> (Program -> (Program, List Diagnostic)) -> Program -> Result (List Diagnostic) CheckedProgram
  check-source-using profile interfaces check resolve program =
    check-expanded-source interfaces resolve (\expanded -> retain-resolved-source profile check (resolve expanded)) program
  check-expanded-source :: List LoadedInterface -> (Program -> (Program, List Diagnostic)) -> (Program -> Result (List Diagnostic) CheckedProgram) -> Program -> Result (List Diagnostic) CheckedProgram
  check-expanded-source interfaces resolve finish program = case expand-stages-with-report resolve (\unit -> interface-headers interfaces) program of
    Err errors -> Err errors
    Ok (expanded, generated) -> case finish expanded of
      Err errors -> Err (explain-expansion-errors expanded errors)
      Ok checked -> Ok (with-generated generated checked)
  retain-resolved-source :: TargetProfile -> (Program -> Result (List Diagnostic) CheckedProgram) -> (Program, List Diagnostic) -> Result (List Diagnostic) CheckedProgram
  retain-resolved-source profile check result = case result of
    (resolved, []) -> case check resolved of
      Ok checked -> (case target-literal-errors (profile.word-size) (checked.elaboration) of
        [] -> check-runtime-entry checked
        errors -> Err errors)
      Err errors -> Err errors
    (resolved, errors) -> Err errors
  overlay-interface :: String -> List LoadedInterface -> Option LoadedInterface
  overlay-interface name interfaces = case interfaces of
    [] -> None
    entry : rest -> if name == entry.name then Some entry else overlay-interface name rest
  overlay-interface-index :: List LoadedInterface -> HashMap String LoadedInterface -> HashMap String LoadedInterface
  overlay-interface-index interfaces indexed = case interfaces of
    [] -> indexed
    entry : rest -> overlay-interface-index rest (hash-map-insert (entry.name) entry indexed)
  overlay-dependencies :: List (String, String) -> HashMap String LoadedInterface -> HashMap String Unit -> List LoadedInterface -> Result String (List LoadedInterface)
  overlay-dependencies pending all seen found = case pending of
    [] -> Ok found
    (name, hash) : rest -> case hash-map-lookup name seen of
      Some existing -> overlay-dependencies rest all seen found
      None -> case hash-map-lookup name all of
        None -> Err (string-concat "missing source replacement dependency: " name)
        Some dependency -> overlay-dependencies (dependency.imports <> rest) all (hash-map-insert name () seen) (dependency : found)
  overlay-module :: String -> List Module -> List Module -> Option (Module, List Module)
  overlay-module name modules before = case modules of
    [] -> None
    candidate : rest -> if name == candidate.name then Some (candidate, reverse before <> rest)
      else overlay-module name rest (candidate : before)
  replace-overlay-interface :: LoadedInterface -> List LoadedInterface -> List LoadedInterface
  replace-overlay-interface fresh interfaces = case interfaces of
    [] -> []
    previous : rest -> if fresh.name == previous.name then fresh : rest
      else previous : (replace-overlay-interface fresh rest)
  checked-overlay-source :: TargetProfile -> Program -> List LoadedInterface -> Option LoadedInterface -> Result (List Diagnostic) CheckedProgram
  checked-overlay-source profile program dependencies facade = case facade of
    Some entry -> check-source-phase profile dependencies (\input -> resolve-overlay-with input dependencies entry) program
    None -> checked-source profile program dependencies
  rebuild-source-interface :: TargetProfile -> Bytes -> Program -> String -> List LoadedInterface -> Option LoadedInterface -> Result String (LoadedInterface, Json)
  rebuild-source-interface profile source program name dependencies facade = case checked-overlay-source profile program dependencies facade of
    Err errors -> Err (render-source-diagnostics source errors)
    Ok checked -> case export-interfaces-aliased checked dependencies source of
      Err message -> Err (string-concat "bootstrap.export: " message)
      Ok ([(owner, doc)]) -> if owner == name then
        (case load-interface owner (interface-hash doc) (canonical-bytes doc) of
          Err message -> Err (string-concat "bootstrap.interfaces: " message)
          Ok fresh -> Ok (fresh, doc))
        else Err "bootstrap.interfaces: source replacement changed the defining module"
      Ok other -> Err "bootstrap.interfaces: expected one checked source replacement"
  -- Recheck a base source home with its own dependency closure before
  -- admitting it into the cached set. This keeps the Prelude facade out
  -- of early homes and checks every retained consumer against fresh hashes.
  recheck-source-overlays :: TargetProfile -> Bytes -> Program -> List LoadedInterface -> List LoadedInterface -> List (String, Json) -> Result String (Program, List LoadedInterface, List (String, Json))
  recheck-source-overlays profile source program order interfaces written =
    recheck-indexed-overlays profile source (overlay-source-homes (program.modules) hash-map-empty) program order interfaces written
  overlay-source-homes :: List Module -> HashMap String Unit -> HashMap String Unit
  overlay-source-homes modules homes = case modules of
    [] -> homes
    first : rest -> let name = first.name in
      if embedded-library-home name then overlay-source-homes rest (hash-map-insert name () homes)
      else overlay-source-homes rest homes
  recheck-indexed-overlays :: TargetProfile -> Bytes -> HashMap String Unit -> Program -> List LoadedInterface -> List LoadedInterface -> List (String, Json) -> Result String (Program, List LoadedInterface, List (String, Json))
  recheck-indexed-overlays profile source homes program order interfaces written = case order of
    [] -> (case written of
      [] -> Ok (program, interfaces, [])
      other -> case validate-interface-set interfaces of
        Err message -> Err (string-concat "bootstrap.interfaces: " message)
        Ok checked -> Ok (program, checked, reverse written))
    previous : rest -> let name = previous.name in
      (case hash-map-lookup name homes of
        Some present -> (case overlay-module name (program.modules) [] of
          None -> recheck-indexed-overlays profile source homes program rest interfaces written
          Some (replacement, remaining) -> case overlay-dependencies (previous.imports) (overlay-interface-index interfaces hash-map-empty) hash-map-empty [] of
            Err message -> Err (string-concat "bootstrap.interfaces: " message)
            Ok dependencies -> let sp = program.span in
              case rebuild-source-interface profile source (Program sp [replacement]) name dependencies (overlay-interface "Prelude" interfaces) of
                Err message -> Err message
                Ok (fresh, doc) -> recheck-indexed-overlays profile source homes (Program sp remaining) rest (replace-overlay-interface fresh interfaces) ((name, doc) : written))
        None -> recheck-indexed-overlays profile source homes program rest interfaces written)

  -- A base-package home the client declares itself is the client's version of
  -- that module: the object's copy stays internal and unused, so the source
  -- may shadow it. Any other name the object supplies is closed, and a
  -- source module of that name would silently disagree with the object it
  -- links against.
  object-source-conflict :: List Module -> List LoadedInterface -> Option String
  object-source-conflict modules interfaces = case modules of
    [] -> None
    first : rest -> let name = first.name in
      if embedded-library-home name then object-source-conflict rest interfaces
      else (case overlay-interface name interfaces of
        Some prior -> Some name
        None -> object-source-conflict rest interfaces)

  declares-signature :: List Decl -> Bool
  declares-signature ds = case ds of
    [] -> False
    (DClass sp name parameters members) : rest -> True
    other : rest -> declares-signature rest
  has-signature-overlay :: List Module -> Bool
  has-signature-overlay modules = case modules of
    [] -> False
    m : rest -> (embedded-library-home (m.name) && declares-signature (module-decls m)) || has-signature-overlay rest
  -- Compare all checked ABI, dependency, law and default-body rows. Only
  -- producer and source provenance differ between an embedded compilation
  -- and rechecking the same public contract from a client's source bundle.
  overlay-contract-bytes :: Json -> Bytes
  overlay-contract-bytes doc = canonical-bytes (object-set "compiler" JNull (object-set "source_hash" JNull doc))
  matched-object-overlays :: List (String, Json) -> List LoadedInterface -> Option (List LoadedInterface)
  matched-object-overlays rows interfaces = case rows of
    [] -> Some []
    (name, fresh) : rest -> case overlay-interface name interfaces of
      Some previous | bytes-compare (overlay-contract-bytes fresh) (overlay-contract-bytes (previous.doc)) == 0 ->
        (case matched-object-overlays rest interfaces of Some more -> Some (previous : more); None -> None)
      other -> None
  check-object-source :: TargetProfile -> List LoadedInterface -> (List LoadedInterface -> Program -> Result (List Diagnostic) CheckedProgram) -> Bytes -> Program -> Result (List Diagnostic) CheckedProgram
  check-object-source profile interfaces check source program =
    let run-check = \overlays -> check overlays program in
    if not (has-signature-overlay (program.modules)) then run-check [] else
      case recheck-source-overlays profile source program interfaces interfaces [] of
        Ok (remaining, effective, rows) -> (case matched-object-overlays rows interfaces of
          Some (first : rest) -> run-check (first : rest)
          other -> run-check [])
        Err message -> run-check []

  check-object-client :: TargetProfile -> Bytes -> Program -> ValidatedInterfaces -> Result String CheckedProgram
  check-object-client profile source program checked =
    check-object-client-tuned default-tuning profile source program checked
  check-object-client-tuned :: CompileTuning -> TargetProfile -> Bytes -> Program -> ValidatedInterfaces -> Result String CheckedProgram
  check-object-client-tuned tuning profile source program checked =
    check-object-client-using profile (checked.interfaces-members) (checked-admitted-source-tuned tuning profile checked) source program
  check-object-client-using :: TargetProfile -> List LoadedInterface -> (List LoadedInterface -> Program -> Result (List Diagnostic) CheckedProgram) -> Bytes -> Program -> Result String CheckedProgram
  check-object-client-using profile interfaces check source program = case object-source-conflict (program.modules) interfaces of
    Some name -> Err ("bootstrap.object: module " <> name <> " is already supplied by the library object; rebuild the library to change it")
    None -> case check-object-source profile interfaces check source program of
      Err errors -> Err (render-source-diagnostics source errors)
      Ok result -> Ok result

  compile-source-interfaces :: forall r. using (io :: Io r) => TargetProfile -> List LoadedInterface -> String -> Path ->{IO r, Diverge} Int
  compile-source-interfaces profile interfaces source prefix =
    compile-source-interfaces-tuned default-tuning profile interfaces source prefix
  compile-source-interfaces-tuned :: forall r. using (io :: Io r) => CompileTuning -> TargetProfile -> List LoadedInterface -> String -> Path ->{IO r, Diverge} Int
  compile-source-interfaces-tuned tuning profile interfaces source prefix =
    if interface-output-conflict InterfacesOnly prefix source then pipeline-bad-args else
    case invalidate-interface-package (interface-output-path prefix) of
      Err message -> write-failure prefix ("bootstrap.export: " <> message) pipeline-write-failed
      Ok ready -> emit-source-interfaces-tuned tuning profile interfaces source prefix
  emit-source-interfaces :: forall r. using (io :: Io r) => TargetProfile -> List LoadedInterface -> String -> Path ->{IO r, Diverge} Int
  emit-source-interfaces profile interfaces source prefix =
    emit-source-interfaces-tuned default-tuning profile interfaces source prefix
  emit-source-interfaces-tuned :: forall r. using (io :: Io r) => CompileTuning -> TargetProfile -> List LoadedInterface -> String -> Path ->{IO r, Diverge} Int
  emit-source-interfaces-tuned tuning profile interfaces source prefix = case fs-read (path-from-string source) of
    Err error -> write-failure prefix "bootstrap.export: cannot read source" pipeline-read-failed
    Ok src -> case parse-program-with-index-tuned tuning source src (module-name-index (interface-fixity-headers interfaces)) of
      Failed bundle -> write-failure prefix (render-bundle bundle) pipeline-parse-failed
      Parsed program [] -> case target-view-program profile program of
        Err message -> write-failure prefix message pipeline-check-refused
        Ok view -> (case recheck-source-overlays profile src view interfaces interfaces [] of
          Err message -> write-failure prefix message pipeline-check-refused
          Ok (remaining, effective, replaced) -> case (remaining.modules, replaced) of
            ([], first : rest) -> write-interface-output prefix (Ok replaced)
            other -> case checked-source-tuned tuning profile remaining effective of
              Err errors -> write-failure prefix (render-source-diagnostics src errors) pipeline-check-refused
              Ok checked -> case export-interfaces-aliased checked effective src of
                Err message -> write-interface-output prefix (Err message)
                Ok rows -> write-interface-output prefix (Ok (replaced <> rows)))
      Parsed program errors -> write-failure prefix (render-bundle (Bundle source src errors)) pipeline-parse-failed
  interface-output-path :: Path -> Path
  interface-output-path prefix = path-from-string (path-to-string prefix <> ".cpk")
  interface-output-conflict :: PipelineMode -> Path -> String -> Bool
  interface-output-conflict mode prefix input = case mode of
    InterfacesOnly ->
      let package = path-to-string (interface-output-path prefix) in
      let normalize-name = \name -> path-to-string (path-normalize (path-from-string name)) in
      object-path-member (normalize-name input)
        (map normalize-name [path-to-string prefix, path-to-string (refusal-path prefix), package])
    other -> False
  invalidate-interface-package :: forall r. using (io :: Io r) => Path ->{IO r} Result String Unit
  invalidate-interface-package path = case fs-metadata path of
    Err absent -> Ok ()
    Ok previous -> replace-object-package path (string-to-bytes "")
  write-interface-package :: forall r. using (io :: Io r) => Path -> List (String, String, Json) ->{IO r, Diverge} Result String Unit
  write-interface-package path rows = case encode-interface-package rows of
    Err message -> Err message
    Ok bytes -> replace-object-package path bytes

  write-interface-output :: forall r. using (io :: Io r) => Path -> Result String (List (String, Json)) ->{IO r, Diverge} Int
  write-interface-output prefix output = case output of
    Err message -> write-failure prefix (string-concat "bootstrap.export: " message) pipeline-emit-refused
    Ok rows -> case (case rows of
      [] -> Ok ()
      other -> write-interface-package (interface-output-path prefix) (map object-package-row rows)) of
      Err message -> write-failure prefix (string-concat "bootstrap.export: " message) pipeline-write-failed
      Ok done -> case fs-write (refusal-path prefix) (string-to-bytes "") of
        Err error -> pipeline-write-failed
        Ok written -> pipeline-ok

  -- `ParseOutcome`'s `Parsed` carries the value AND the errors a recovering
  -- parse produced, so a clean parse is `Parsed prog Nil`. This rung accepts
  -- only a clean parse: a recovered one stops the pipeline and writes the
  -- recoverable errors beside the module, because handing a half-understood
  -- tree to the checker would be the silent drop the ladder forbids.
  after-parse :: forall r. using (io :: Io r) => Bool -> Bool -> TargetProfile -> PipelineMode -> String -> Bytes -> ParseOutcome Program -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-parse inlining reclaim profile mode name src outcome ir exe report =
    after-parse-tuned default-tuning inlining reclaim profile mode name src outcome ir exe report
  after-parse-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> TargetProfile -> PipelineMode -> String -> Bytes -> ParseOutcome Program -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-parse-tuned tuning inlining reclaim profile mode name src outcome ir exe report = case outcome of
    Failed bundle -> write-failure ir (render-bundle bundle) pipeline-parse-failed
    Parsed prog [] -> case target-view-program profile prog of
      Err message -> write-failure ir message pipeline-check-refused
      Ok view -> after-resolve-tuned tuning profile inlining reclaim mode src view ir exe report
    Parsed prog recoverable -> write-failure ir (render-bundle (Bundle name src recoverable)) pipeline-parse-failed

  after-parse-with :: forall r. using (io :: Io r) => Bool -> Bool -> TargetProfile -> PipelineMode -> ValidatedInterfaces -> String -> Bytes -> ParseOutcome Program -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-parse-with inlining reclaim profile mode admitted name src outcome ir exe report =
    after-parse-with-tuned default-tuning inlining reclaim profile mode admitted name src outcome ir exe report
  after-parse-with-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> TargetProfile -> PipelineMode -> ValidatedInterfaces -> String -> Bytes -> ParseOutcome Program -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-parse-with-tuned tuning inlining reclaim profile mode admitted name src outcome ir exe report = case outcome of
    Failed bundle -> write-failure ir (render-bundle bundle) pipeline-parse-failed
    Parsed prog [] -> let interfaces = admitted.interfaces-members in case target-view-program profile prog of
      Err message -> write-failure ir message pipeline-check-refused
      Ok view -> (if checks-only mode then case recheck-source-overlays profile src view interfaces interfaces [] of
          Err message -> write-failure ir (source-overlay-error profile src view interfaces message) pipeline-check-refused
          Ok (remaining, effective, replaced) -> case (remaining.modules, replaced) of
            ([], first : rest) -> (case mode of
              CheckOnly -> case serialize-artifacts [] JArrEnd profile (path-stem (path-from-string name)) effective replaced of
                done -> write-interface-output ir (Ok [])
              other -> write-interface-output ir (Ok []))
            (other, []) -> after-check-artifacts-tuned tuning profile inlining reclaim mode name src effective []
              (checked-admitted-source-tuned tuning profile admitted [] remaining) ir exe report
            other -> after-check-artifacts-tuned tuning profile inlining reclaim mode name src effective replaced (checked-source-tuned tuning profile remaining effective) ir exe report
        else after-check-artifacts-tuned tuning profile inlining reclaim mode name src interfaces [] (checked-admitted-source-tuned tuning profile admitted [] view) ir exe report)
    Parsed prog recoverable -> write-failure ir (render-bundle (Bundle name src recoverable)) pipeline-parse-failed

  -- A changed library module can invalidate a cached dependent while the
  -- client also contains a source error. Include the error from checking the
  -- original source group, where both defining nominal identities are visible.
  source-overlay-error :: TargetProfile -> Bytes -> Program -> List LoadedInterface -> String -> String
  source-overlay-error profile bytes program interfaces message =
    if string-contains "stale interface dependency:" message then case checked-source profile program interfaces of
      Err errors -> message <> "\n" <> render-source-diagnostics bytes errors
      Ok checked -> message
    else message

  -- Check-only modes validate source overlays against the admitted interfaces.
  checks-only :: PipelineMode -> Bool
  checks-only mode = case mode of
    TypesOnly -> True
    CheckOnly -> True
    BodiesOnly -> True
    other -> False

  -- A checked check, build or run leaves the driver's artifacts in the
  -- working directory's `build/`: the checked interface closure in
  -- `<entry>.cpk` and the target and module identities in
  -- `<entry>.manifest.json`. A checked source module supersedes the
  -- admitted interface of the same name.
  after-check-artifacts :: forall r. using (io :: Io r) => TargetProfile -> Bool -> Bool -> PipelineMode -> String -> Bytes -> List LoadedInterface -> List (String, Json) -> Result (List Diagnostic) CheckedProgram -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-check-artifacts profile inlining reclaim mode name src interfaces replaced result ir exe report =
    after-check-artifacts-tuned default-tuning profile inlining reclaim mode name src interfaces replaced result ir exe report
  after-check-artifacts-tuned :: forall r. using (io :: Io r) => CompileTuning -> TargetProfile -> Bool -> Bool -> PipelineMode -> String -> Bytes -> List LoadedInterface -> List (String, Json) -> Result (List Diagnostic) CheckedProgram -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-check-artifacts-tuned tuning profile inlining reclaim mode name src interfaces replaced result ir exe report = case (mode, result) of
    (InterfacesOnly, other) -> after-check-tuned tuning profile inlining reclaim mode src result ir exe report
    (ObjectOnly, other) -> after-check-tuned tuning profile inlining reclaim mode src result ir exe report
    (IrOnly, other) -> after-check-tuned tuning profile inlining reclaim mode src result ir exe report
    (TypesOnly, other) -> after-check-tuned tuning profile inlining reclaim mode src result ir exe report
    (BodiesOnly, other) -> after-check-tuned tuning profile inlining reclaim mode src result ir exe report
    (other, Err found) -> after-check-tuned tuning profile inlining reclaim mode src result ir exe report
    (other, Ok checked) -> let admitted = unshadowed-interfaces (checked.surface.modules) interfaces in
      case serialize-exported checked profile (path-stem (path-from-string name)) admitted replaced (export-interfaces-aliased checked admitted src) of
        done -> after-check-tuned tuning profile inlining reclaim mode src result ir exe report

  -- The artifact set is best effort: the frontend's own refusal codes stay
  -- the ones a caller reads, and an interface the checker admits but cannot
  -- project does not turn a passing check into an emission failure.

  -- The first chunk of the serialization arena: one megabyte, one module's
  -- worth of rendered spellings and hash material in a phase. Growth
  -- doubles, so a wider interface set asks for another chunk instead of
  -- copying one.
  arena-first-chunk :: I64
  arena-first-chunk = 1048576

  -- Four-megabyte initial chunk for whole-phase batch compilation arenas.
  -- Growth doubles up to 64 MiB; all KIND_CTOR / KIND_CLOSURE / KIND_DICT
  -- blocks allocated in the phase carry RC_IMMORTAL (zero atomic RC writes
  -- across parallel workers) and are freed wholesale at phase exit.
  phase-arena-first-chunk :: I64
  phase-arena-first-chunk = 4194304

  -- The arena entries (`seed/runtime/src/arena.rs`). The symbol
  -- namespace is reserved (D73), so a program reaches them only by
  -- spelling the intrinsic and only the checker's own intrinsic table
  -- types that spelling: nothing else in the language can obtain one.
  foreign import ccall "cinch.runtime.arenaNew" arena-new :: I64 -> I64
  foreign import ccall "cinch.runtime.arenaLeave" arena-leave :: I64 -> I64
  foreign import ccall "cinch.runtime.arenaEnterPhase" arena-enter-phase :: I64 -> I64
  foreign import ccall "cinch.runtime.arenaExitPhase" arena-exit-phase :: I64 -> I64

  -- Interface serialization is the one finished phase whose whole output
  -- is files: the documents themselves are built before this scope (the
  -- manifest embeds them) and what the scope allocates is their rendering,
  -- which nothing reads once the bytes are written. So the scope can hold
  -- its own churn and free it wholesale, and no word it served outlives it.
  -- `CINCH_ARENA=1` enables the scope; unset makes both entries no-ops,
  -- so the same build measures the same phase with every block back on
  -- the counted heap.
  serialize-exported :: forall r. using (io :: Io r) => CheckedProgram -> TargetProfile -> String -> List LoadedInterface -> List (String, Json) -> Result String (List (String, Json)) ->{IO r, Diverge} Unit
  serialize-exported checked profile entry admitted replaced exported = case exported of
    Err message -> ()
    Ok rows -> serialize-artifacts (checked.generated) (checked-primitive-rows checked) profile entry admitted (replaced <> rows)

  serialize-artifacts :: forall r. using (io :: Io r) => List (String, List String) -> Json -> TargetProfile -> String -> List LoadedInterface -> List (String, Json) ->{IO r, Diverge} Unit
  serialize-artifacts generated primitives profile entry admitted rows =
    let arena = arena-new arena-first-chunk in
    let written = ignore-artifact-outcome (write-build-artifacts generated primitives profile entry admitted rows) in
    case arena-leave arena of _ -> written

  -- The artifact write's outcome is already reported through the files it
  -- left (the caller's exit code does not read it), and the value must
  -- not leave the arena, so this reduces it to the unit word inside.
  ignore-artifact-outcome :: Result String Unit -> Unit
  ignore-artifact-outcome outcome = case outcome of
    Err message -> ()
    Ok done -> ()

  write-build-artifacts :: forall r. using (io :: Io r) => List (String, List String) -> Json -> TargetProfile -> String -> List LoadedInterface -> List (String, Json) ->{IO r, Diverge} Result String Unit
  write-build-artifacts generated primitives profile entry interfaces rows =
    case process-run (command (path-from-string "mkdir") ["-p", "build"]) "" of
      Ok (0, output) -> (case write-interface-package (path-from-string ("build/" <> entry <> ".cpk"))
          (complete-build-interfaces interfaces rows) of
        Err message -> Err message
        Ok done -> case fs-write (path-from-string (string-concat "build/" (string-concat entry ".manifest.json")))
            (canonical-bytes (build-generated-manifest generated primitives entry (manifest-target profile) interfaces rows)) of
          Ok written -> Ok ()
          Err error -> Err "cannot write build manifest")
      other -> Err "cannot create the build directory"

  complete-build-interfaces :: List LoadedInterface -> List (String, Json) -> List (String, String, Json)
  complete-build-interfaces interfaces rows =
    let compiled = overlay-build-interface-names rows hash-map-empty in
    map object-package-row rows <> admitted-build-interfaces compiled interfaces
  overlay-build-interface-names :: List (String, Json) -> HashMap String Unit -> HashMap String Unit
  overlay-build-interface-names rows names = case rows of
    [] -> names
    (name, doc) : rest -> overlay-build-interface-names rest (hash-map-insert name () names)
  admitted-build-interfaces :: HashMap String Unit -> List LoadedInterface -> List (String, String, Json)
  admitted-build-interfaces compiled interfaces = case interfaces of
    [] -> []
    entry : rest -> let name = entry.name in (case hash-map-lookup name compiled of
      Some present -> admitted-build-interfaces compiled rest
      None -> (name, entry.hash, entry.doc) : (admitted-build-interfaces compiled rest))

  capability-array :: List String -> Json
  capability-array values = case values of
    [] -> JArrEnd
    value : rest -> JArr (JStr value) (capability-array rest)

  manifest-target :: TargetProfile -> Json
  manifest-target profile = JObj "triple" (JStr (profile.triple))
    (JObj "os" (JStr (profile.os)) (JObj "arch" (JStr (selection-arch profile))
      (JObj "libc" (JStr (profile.libc)) (JObj "word_size" (JNum (nat-to-int (profile.word-size)))
        (JObj "endian" (JStr (profile.endian)) (JObj "features" (capability-array (profile.features))
          (JObj "required" (capability-array (profile.required)) JObjEnd)))))))

  provider-matches-profile :: Json -> TargetProfile -> Bool
  provider-matches-profile document profile = case object-field "target" document of
    JStr triple -> triple == profile.triple
    other -> False

  emit-target-program :: TargetProfile -> Bool -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-target-program profile inlining debug reclaim checked provider =
    emit-target-program-tuned default-tuning profile inlining debug reclaim checked provider
  emit-target-program-tuned :: CompileTuning -> TargetProfile -> Bool -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-target-program-tuned tuning profile inlining debug reclaim checked provider =
    emit-runtime-program-for-profile-tuned tuning profile inlining debug reclaim checked provider

  after-resolve :: forall r. using (io :: Io r) => TargetProfile -> Bool -> Bool -> PipelineMode -> Bytes -> Program -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-resolve profile inlining reclaim mode src prog ir exe report =
    after-resolve-tuned default-tuning profile inlining reclaim mode src prog ir exe report
  after-resolve-tuned :: forall r. using (io :: Io r) => CompileTuning -> TargetProfile -> Bool -> Bool -> PipelineMode -> Bytes -> Program -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-resolve-tuned tuning profile inlining reclaim mode src prog ir exe report = after-check-tuned tuning profile inlining reclaim mode src (check-source-phase-tuned tuning profile [] resolve-program prog) ir exe report

  -- The dense body artifact: every checked definition, each with its own
  -- type side table. A consumer decodes one definition at a time.
  dense-bodies-document :: CheckedProgram -> Option Json
  dense-bodies-document checked = case dense-claims-verified (elaboration-core (checked.elaboration)) of
    Some bodies -> Some (JObj "schema" (JNum 1) (JObj "bodies" bodies JObjEnd))
    None -> None

  finish-check :: forall r. using (io :: Io r) => Path ->{IO r} Int
  finish-check ir = case fs-write (refusal-path ir) (string-to-bytes "") of
    Ok written -> pipeline-ok
    Err e -> pipeline-write-failed

  after-check :: forall r. using (io :: Io r) => TargetProfile -> Bool -> Bool -> PipelineMode -> Bytes -> Result (List Diagnostic) CheckedProgram -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-check profile inlining reclaim mode src result ir exe report =
    after-check-tuned default-tuning profile inlining reclaim mode src result ir exe report
  after-check-tuned :: forall r. using (io :: Io r) => CompileTuning -> TargetProfile -> Bool -> Bool -> PipelineMode -> Bytes -> Result (List Diagnostic) CheckedProgram -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-check-tuned tuning profile inlining reclaim mode src result ir exe report = case result of
    Ok prog -> case mode of
      TypesOnly -> finish-check ir
      CheckOnly -> finish-check ir
      BodiesOnly -> case dense-bodies-document prog of
        Some doc -> (case fs-write ir (canonical-bytes doc) of
          Ok written -> pipeline-ok
          Err e -> pipeline-write-failed)
        None -> write-failure ir "dense body document does not round trip" pipeline-emit-refused
      IrOnly -> write-runtime-module ir (emit-target-program-tuned tuning profile inlining False reclaim prog None)
      EmitOnly -> write-runtime-module ir (emit-target-program-tuned tuning profile inlining False reclaim prog None)
      other -> after-emit mode (emit-checked-diagnostics prog) prog ir exe report
    Err found -> write-failure ir (render-source-diagnostics src found) pipeline-check-refused

  after-emit :: forall r. using (io :: Io r) => PipelineMode -> List Diagnostic -> CheckedProgram -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-emit mode found prog ir exe report = case found of
    [] -> write-module mode ir (emit-checked-program prog) exe report
    d : rest -> write-failure ir (render-diagnostics found) pipeline-emit-refused

  -- The typed backend emits a complete shared-runtime LLVM module. Linking
  -- is separate in this mode, so an unavailable lowering cannot fall back
  -- to the standalone fragment's representation or run an old artifact.
  record RuntimeOutput where
    code :: Bytes
    diagnostics :: Bytes
    status :: Int

  failure-output :: String -> Int -> RuntimeOutput
  failure-output text status = RuntimeOutput (string-to-bytes "") (string-to-bytes text) status

  runtime-module-output :: Result (List Diagnostic) String -> RuntimeOutput
  runtime-module-output result = case result of
    Err found -> failure-output (render-diagnostics found) pipeline-emit-refused
    Ok text -> RuntimeOutput (string-to-bytes text) (string-to-bytes "") pipeline-ok

  write-runtime-output :: forall r. using (io :: Io r) => Path -> RuntimeOutput ->{IO r} Int
  write-runtime-output ir (RuntimeOutput code diagnostics status) = case fs-write ir code of
    Err error -> pipeline-write-failed
    Ok done -> case fs-write (refusal-path ir) diagnostics of
      Err error -> pipeline-write-failed
      Ok cleared -> status

  write-runtime-module :: forall r. using (io :: Io r) => Path -> Result (List Diagnostic) String ->{IO r} Int
  write-runtime-module ir result = write-runtime-output ir (runtime-module-output result)

  -- Output paths are caller-owned. Check the bytes before treating a repeat
  -- as done, so a deleted or replaced artifact is restored by the next request.
  refresh-resident-file :: forall r. using (io :: Io r) => Path -> Bytes -> Bytes ->{IO r} Result FsError Unit
  refresh-resident-file path previous content =
    if bytes-compare previous content /= 0 then fs-write path content else
      case fs-metadata path of
        Ok meta -> (case file-meta-kind meta of
          FileIsFile | file-meta-size meta == bytes-len content ->
            if bytes-len content == 0 then Ok () else
              (case fs-read path of
                Ok actual | bytes-compare actual content == 0 -> Ok ()
                other -> fs-write path content)
          other -> fs-write path content)
        Err error -> fs-write path content

  write-resident-output :: forall r. using (io :: Io r) => Path -> Option (Bytes, RuntimeOutput) -> RuntimeOutput ->{IO r} Int
  write-resident-output ir previous output = case (previous, output) of
    (Some (source, RuntimeOutput old-code old-diagnostics old-status), RuntimeOutput code diagnostics status) ->
      (case refresh-resident-file ir old-code code of
        Err error -> pipeline-write-failed
        Ok done -> (case refresh-resident-file (refusal-path ir) old-diagnostics diagnostics of
          Err error -> pipeline-write-failed
          Ok cleared -> status))
    other -> write-runtime-output ir output

  -- The last stage: the module lands, then the driver rung links it, runs
  -- the artifact and writes the report the caller reads.
  write-module :: forall r. using (io :: Io r) => PipelineMode -> Path -> String -> Path -> Path ->{IO r, Diverge} Int
  write-module mode ir text exe report = case fs-write ir (string-to-bytes text) of
    Err e -> pipeline-write-failed
    Ok u -> case mode of
      CompileOnly -> link-only-and-report ir exe report
      CompileAndRun -> link-and-report ir exe report
      TypesOnly -> pipeline-emit-refused
      CheckOnly -> pipeline-emit-refused
      BodiesOnly -> pipeline-emit-refused
      IrOnly -> pipeline-emit-refused
      ServeIr -> pipeline-emit-refused
      ServeStream -> pipeline-emit-refused
      EmitOnly -> pipeline-emit-refused
      EmitWithInterfaces -> pipeline-emit-refused
      InterfacesOnly -> pipeline-emit-refused
      ObjectOnly -> pipeline-emit-refused

  -- Library objects use this same checked frontend. The assembler and
  -- relocatable linker receive individual argument words, never a shell.
  -- A provider copy binds the linked bytes to the authenticated admission
  -- above, even when the original provider path changes during compilation.
  object-field :: String -> Json -> Json
  object-field name doc = case doc of
    JObj key value rest -> if name == key then value else object-field name rest
    other -> JNull
  object-set :: String -> Json -> Json -> Json
  object-set name value doc = case doc of
    JObj key old rest -> if name == key then JObj key value rest else JObj key old (object-set name value rest)
    other -> JObj name value JObjEnd
  object-append :: Json -> Json -> Json
  object-append first second = case first of JArr row rest -> JArr row (object-append rest second); JArrEnd -> second; other -> JNull
  object-interface-row :: String -> String -> Json -> Json
  object-interface-row name hash doc = JObj "module" (JStr name) (JObj "iface_hash" (JStr hash) (JObj "interface" doc JObjEnd))
  object-provider-closure :: Bool -> List LoadedInterface -> Json -> Result String Json
  object-provider-closure merged admitted provider = case object-field "interface_refs" provider of
    JNull -> Ok (object-field "interfaces" provider)
    refs -> if merged then
      (let public = overlay-interface-index admitted hash-map-empty in
      let private = object-field "private_interfaces" provider in
      expand-object-interfaces refs public private)
      else Ok refs
  expand-object-interfaces :: Json -> HashMap String LoadedInterface -> Json -> Result String Json
  expand-object-interfaces refs public private = case refs of
    JArr row rest -> (case (object-field "module" row, object-field "iface_hash" row) of
      (JStr name, JStr identity) ->
        let document = (case hash-map-lookup name public of
          Some admitted | (admitted.hash == identity) -> admitted.doc
          other -> private-object-contract name identity private) in
        (case document of
          JNull -> Err "object interface references require their checked contracts"
          other -> (case expand-object-interfaces rest public private of
            Err message -> Err message
            Ok tail -> Ok (JArr (object-set "interface" document row) tail)))
      other -> Err "malformed object interface reference")
    JArrEnd -> Ok JArrEnd
    other -> Err "malformed object interface references"
  private-object-contract :: String -> String -> Json -> Json
  private-object-contract name identity rows = case rows of
    JArr row JArrEnd -> (case (object-field "module" row, object-field "iface_hash" row) of
      (JStr home, JStr hash) | (home == name) && hash == identity -> object-field "interface" row
      other -> JNull)
    other -> JNull
  object-delete :: String -> Json -> Json
  object-delete name doc = case doc of
    JObj key value rest -> if key == name then rest else JObj key value (object-delete name rest)
    other -> other
  -- A provider's private contract stays in the ABI section. Only public
  -- contracts belong in the module directory.
  object-package-closure :: Json -> Json -> List (String, String, Json) -> List Json -> Result String (List (String, String, Json), Json)
  object-package-closure rows private public refs = case rows of
    JArr row rest -> (case (object-field "module" row, object-field "iface_hash" row, object-field "interface" row) of
      (JStr name, JStr hash, JObj key item tail) ->
        let ref = object-delete "interface" row in
        let published = (case private-object-contract name hash private of
          JNull -> (name, hash, object-field "interface" row) : public
          other -> public) in
        object-package-closure rest private published (ref : refs)
      other -> Err "invalid packed object contract")
    JArrEnd -> Ok (reverse public, object-refs refs JArrEnd)
    other -> Err "invalid packed object closure"
  object-refs :: List Json -> Json -> Json
  object-refs refs ordered = case refs of
    [] -> ordered
    row : rest -> object-refs rest (JArr row ordered)
  object-interface-hashes :: Json -> HashMap String String -> HashMap String String
  object-interface-hashes rows hashes = case rows of
    JArr row rest -> (case (object-field "module" row, object-field "iface_hash" row) of
      (JStr name, JStr hash) -> (case hash-map-lookup name hashes of
        Some previous -> object-interface-hashes rest hashes
        None -> object-interface-hashes rest (hash-map-insert name hash hashes))
      other -> hashes)
    other -> hashes
  object-interface-closure :: List (String, Json) -> Json -> Result String Json
  object-interface-closure rows old = add-object-interfaces rows (object-interface-hashes old hash-map-empty) old
  add-object-interfaces :: List (String, Json) -> HashMap String String -> Json -> Result String Json
  add-object-interfaces rows hashes old = case rows of
    [] -> Ok old
    (name, doc) : rest -> let hash = interface-hash doc in
      case hash-map-lookup name hashes of
        Some actual -> if actual == hash then add-object-interfaces rest hashes old else Err "object source disagrees with an admitted interface identity"
        None -> add-object-interfaces rest (hash-map-insert name hash hashes) (JArr (object-interface-row name hash doc) old)
  -- The admitted provider already indexes its physical symbols. Index only
  -- the generated units and share that map with conditional method lookup.
  index-object-output-units :: Json -> RuntimeObject -> HashMap String Json -> Option (HashMap String Json)
  index-object-output-units rows provider indexed = case rows of
    JArr row rest -> (case object-field "symbol" row of
      JStr name | not (object-has-unit-symbol name provider) -> (case hash-map-lookup name indexed of
        Some prior -> None
        None -> index-object-output-units rest provider (hash-map-insert name row indexed))
      other -> None)
    JArrEnd -> Some indexed
    other -> None
  object-merge-fields :: Json -> Json -> Json
  object-merge-fields newer older = case newer of
    JObj key value rest -> object-merge-fields rest (object-set key value older)
    JObjEnd -> older
    other -> JNull
  keep-old-families :: HashMap String Nat -> Json -> Json
  keep-old-families updated rows = case rows of
    JArr row rest -> (case object-field "class" row of
      JStr name -> (case hash-map-lookup name updated of
        Some index -> keep-old-families updated rest
        None -> JArr row (keep-old-families updated rest))
      other -> JArr row (keep-old-families updated rest))
    other -> JArrEnd
  latest-family-rows :: Json -> Nat -> HashMap String Nat -> Option (HashMap String Nat)
  latest-family-rows rows index updated = case rows of
    JArr row rest -> (case object-field "class" row of
      JStr name -> latest-family-rows rest (index + 1) (hash-map-insert name index updated)
      other -> None)
    JArrEnd -> Some updated
    other -> None
  prepend-new-families :: Json -> Nat -> HashMap String Nat -> Json -> Json
  prepend-new-families rows index updated merged = case rows of
    JArr row rest -> (case object-field "class" row of
      JStr name -> (case hash-map-lookup name updated of
        Some latest | latest == index -> prepend-new-families rest (index + 1) updated (JArr row merged)
        other -> prepend-new-families rest (index + 1) updated merged)
      other -> JNull)
    JArrEnd -> merged
    other -> JNull
  -- Later rows replace earlier rows of the same class. Surviving new rows
  -- are prepended in the original visitation order, leaving old rows ordered.
  object-merge-families :: Json -> Json -> Json
  object-merge-families newer older = case newer of
    JArrEnd -> older
    other -> (case latest-family-rows newer 0 hash-map-empty of
      Some updated -> prepend-new-families newer 0 updated (keep-old-families updated older)
      None -> JNull)
  -- Conditional instances have private physical method entries and no
  -- unrestricted constructor. Publish the checked slot order alongside
  -- the object units so a separately checked client can call those entries.
  object-method-field :: String -> HashMap String Json -> Option Json
  object-method-field name units = case hash-map-lookup name units of
    Some row -> (case (object-field "params" row, object-field "result" row) of
      (JArr first more, result) -> Some (JStr "O")
      (JArrEnd, JStr result) -> Some (JStr result)
      other -> None)
    None -> None
  object-method-fields :: Json -> HashMap String Json -> Result String Json
  object-method-fields methods units = case methods of
    JArrEnd -> Ok JArrEnd
    JArr (JStr name) rest -> (case (object-method-field name units, object-method-fields rest units) of
      (Some field, Ok fields) -> Ok (JArr field fields)
      (None, other) -> Err ("conditional method has no compiled object unit: " <> name)
      (other, Err error) -> Err error)
    other -> Err "invalid conditional method list"
  object-instance-methods :: Json -> HashMap String Json -> Json -> Result String Json
  object-instance-methods rows units acc = case rows of
    JArr row rest -> (case (object-field "resolved" row, object-field "method_contracts" row) of
      (JNull, JArr first more) -> (case (object-field "id" row, object-field "class" row, object-field "ctx" row) of
        (JStr name, JStr owner, JArrEnd) -> let methods = object-field "methods" row in (case object-method-fields methods units of
          Ok fields -> let physical = JObj "class" (JStr owner) (JObj "context_arity" (JNum 0) (JObj "fields" fields (JObj "methods" methods JObjEnd))) in
            object-instance-methods rest units (JObj name physical acc)
          Err error -> Err error)
        other -> Err "invalid closed conditional instance")
      other -> object-instance-methods rest units acc)
    JArrEnd -> Ok acc
    other -> Err "invalid instance inventory"
  object-conditional-methods :: List (String, Json) -> HashMap String Json -> Json -> Result String Json
  object-conditional-methods interfaces units acc = case interfaces of
    [] -> Ok acc
    (name, doc) : rest -> (case object-instance-methods (object-field "instances" (object-field "exports" doc)) units acc of
      Ok rows -> object-conditional-methods rest units rows
      Err error -> Err error)

  -- Blocks describe themselves, so the manifest carries no layout table:
  -- the combined object states its constructors' descriptions as facts.
  object-manifest :: Json -> Json -> Json -> Json -> String -> Bytes -> Json
  object-manifest provider interfaces units facts ir code =
    let actual = (object-set "method_families" (object-merge-families (object-field "method_families" facts) (object-field "method_families" provider))
      (object-set "constructors" (object-merge-fields (object-field "constructors" facts) (object-field "constructors" provider))
        (object-set "self_describing" (JBool True) (object-delete "interfaces" provider)))) in
    object-set "interface_refs" interfaces
      (object-set "dictionaries" (object-merge-fields (object-field "dictionaries" facts) (object-field "dictionaries" provider))
      (object-set "units" (object-append (object-field "units" provider) units)
        (object-set "ir_content_hash" (JStr (fnv-source-hash (string-to-bytes ir)))
          (object-set "object_content_hash" (JStr (fnv-source-hash code)) actual))))
  object-paths-distinct :: List String -> Bool
  object-paths-distinct paths = case paths of
    [] -> True
    first : rest -> not (object-path-member first rest) && object-paths-distinct rest
  object-path-member :: String -> List String -> Bool
  object-path-member path paths = case paths of [] -> False; first : rest -> path == first || object-path-member path rest
  -- Each writer owns a fresh staging directory on the destination volume.
  -- Another writer can never truncate an inode already published to readers.
  replace-object-package :: forall r. using (io :: Io r) => Path -> Bytes ->{IO r} Result String Unit
  replace-object-package path bytes =
    let entropy = package-stage-entropy 16 in
    let parent = path-from-string (path-dirname path) in
    let staging-directory = path-join parent (path-from-string (".cinch-package-" <> sha256-hex entropy)) in
    let staging-path = string-to-bytes (path-to-string staging-directory) in
    case make-package-stage staging-path False of
      0 -> let temp = path-join staging-directory (path-from-string "package") in
        (case (case fs-write temp bytes of
          Err error -> Err "cannot write object package"
          Ok done -> (case fs-rename temp path of
            Err error -> Err "cannot publish object package"
            Ok done -> Ok ())) of
          written -> (case remove-package-stage staging-path True of
            0 -> written
            other -> (case written of
              Err message -> Err message
              Ok done -> Err "cannot remove object package staging directory")))
      other -> Err "cannot create object package staging directory"
  compile-source-library-object :: forall r. using (io :: Io r) => Bool -> String -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-library-object inlining manifest configuration source ir object abi =
    compile-source-library-object-at inlining host-profile manifest configuration source ir object abi

  compile-source-library-object-at :: forall r. using (io :: Io r) => Bool -> TargetProfile -> String -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-library-object-at inlining profile manifest configuration source ir object abi =
    compile-source-library-object-at-tuned default-tuning inlining profile manifest configuration source ir object abi
  compile-source-library-object-at-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> TargetProfile -> String -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-library-object-at-tuned tuning inlining profile manifest configuration source ir object abi =
    compile-source-library-object-roots-tuned tuning (effective-inlining tuning inlining) profile [] manifest configuration source ir object abi

  compile-requested-library-object :: forall r. using (io :: Io r) => Bool -> TargetProfile -> String -> String -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-requested-library-object inlining profile roots manifest configuration source ir object abi =
    compile-requested-library-object-tuned default-tuning inlining profile roots manifest configuration source ir object abi
  compile-requested-library-object-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> TargetProfile -> String -> String -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-requested-library-object-tuned tuning inlining profile roots manifest configuration source ir object abi =
    if object-path-member roots [source, manifest, configuration, path-to-string ir, path-to-string object, path-to-string abi, path-to-string object <> ".new.o", path-to-string object <> ".provider.o"] then pipeline-bad-args else
      case read-object-unit-roots roots of
        Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-emit-refused
        Ok requested -> compile-source-library-object-roots-tuned tuning (effective-inlining tuning inlining) profile requested manifest configuration source ir object abi

  compile-source-library-object-roots :: forall r. using (io :: Io r) => Bool -> TargetProfile -> List (String, List Nat) -> String -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-library-object-roots inlining profile requested manifest configuration source ir object abi =
    compile-source-library-object-roots-tuned default-tuning inlining profile requested manifest configuration source ir object abi
  compile-source-library-object-roots-tuned :: forall r. using (io :: Io r) => CompileTuning -> Bool -> TargetProfile -> List (String, List Nat) -> String -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-library-object-roots-tuned tuning inlining profile requested manifest configuration source ir object abi =
    let ir-name = path-to-string ir in let object-name = path-to-string object in let abi-name = path-to-string abi in
    if not (object-paths-distinct [manifest, configuration, source, ir-name, object-name, abi-name, object-name <> ".new.o", object-name <> ".provider.o"]) then pipeline-bad-args else
      case replace-object-package abi (string-to-bytes "") of
        Err error -> pipeline-write-failed
        Ok cleared -> case read-validated-interfaces manifest of
          Err message -> write-failure ir ("bootstrap.interfaces: " <> message) pipeline-interface-failed
          -- A caller that takes no object (`-`) takes no merged manifest
          -- either, so the provider's embedded contracts are never written
          -- back and the carved read a client uses is enough.
          Ok admitted -> let interfaces = admitted.interfaces-members in case (if object-name == "-" then read-runtime-object-client-mode True admitted configuration else read-runtime-object-publication admitted configuration) of
            Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-interface-failed
            Ok (provider, document, provider-path, provider-code) ->
              if not (provider-matches-profile document profile) then write-failure ir "bootstrap.object: runtime object target mismatch" pipeline-interface-failed else
              if object-path-member provider-path [source, ir-name, object-name, abi-name, object-name <> ".new.o", object-name <> ".provider.o"] then write-failure ir "bootstrap.object: provider and output paths collide" pipeline-bad-args else
                case fs-read (path-from-string source) of
                  Err error -> write-failure ir "bootstrap.object: cannot read source" pipeline-read-failed
                  Ok bytes -> case parse-program-with-index-tuned tuning source bytes (module-name-index (interface-fixity-headers interfaces)) of
                    Failed bundle -> write-failure ir (render-bundle bundle) pipeline-parse-failed
                    Parsed program [] -> case target-view-program profile program of
                      Err message -> write-failure ir message pipeline-check-refused
                      Ok view -> (case check-object-client-tuned tuning profile bytes view admitted of
                        Err message -> write-failure ir message pipeline-check-refused
                        Ok checked -> prepare-library-object-tuned tuning profile inlining requested checked interfaces bytes provider document provider-code ir object abi)
                    Parsed program errors -> write-failure ir (render-bundle (Bundle source bytes errors)) pipeline-parse-failed
  prepare-library-object :: forall r. using (io :: Io r) => TargetProfile -> Bool -> List (String, List Nat) -> CheckedProgram -> List LoadedInterface -> Bytes -> RuntimeObject -> Json -> Bytes -> Path -> Path -> Path ->{IO r, Diverge} Int
  prepare-library-object profile inlining requested checked interfaces source provider document provider-code ir object abi =
    prepare-library-object-tuned default-tuning profile inlining requested checked interfaces source provider document provider-code ir object abi
  prepare-library-object-tuned :: forall r. using (io :: Io r) => CompileTuning -> TargetProfile -> Bool -> List (String, List Nat) -> CheckedProgram -> List LoadedInterface -> Bytes -> RuntimeObject -> Json -> Bytes -> Path -> Path -> Path ->{IO r, Diverge} Int
  prepare-library-object-tuned tuning profile inlining requested checked interfaces source provider document provider-code ir object abi = case runtime-library-unit-roots checked requested of
    Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-emit-refused
    Ok roots -> case export-object-interfaces checked interfaces source of
      Err message -> write-failure ir ("bootstrap.export: " <> message) pipeline-emit-refused
      Ok exported -> case (case object-provider-closure (path-to-string object /= "-") interfaces document of
        Err message -> Err message
        Ok provider-rows -> object-interface-closure exported provider-rows) of
        Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-emit-refused
        Ok closure -> case emit-runtime-library-artifact-for-profile-tuned tuning profile False inlining checked (Some provider) roots of
          Err errors -> write-failure ir (render-diagnostics errors) pipeline-emit-refused
          Ok (text, units, facts) -> if (case object-field "unpublished_dictionaries" facts of JBool True -> True; other -> False) then write-failure ir "bootstrap.object: reached source dictionaries require physical factory and method metadata" pipeline-emit-refused else
            case index-object-output-units units provider hash-map-empty of
              None -> write-failure ir "bootstrap.object: source and provider symbols collide" pipeline-emit-refused
              Some indexed -> case object-conditional-methods exported indexed JObjEnd of
                Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-emit-refused
                Ok rows -> write-library-object profile document closure exported text units (object-set "dictionaries" rows facts) provider-code ir object abi
  write-library-object :: forall r. using (io :: Io r) => TargetProfile -> Json -> Json -> List (String, Json) -> String -> Json -> Json -> Bytes -> Path -> Path -> Path ->{IO r, Diverge} Int
  write-library-object profile document closure exported text units facts provider-code ir object abi =
    case fs-write ir (string-to-bytes text) of
      Err error -> pipeline-write-failed
      Ok done -> if path-to-string object == "-" then publish-library-package (map object-package-row exported) (JObj "facts" facts (JObj "units" units JObjEnd)) ir abi
        else case fs-write (path-from-string (path-to-string object <> ".provider.o")) provider-code of
          Err error -> pipeline-write-failed
          Ok done -> assemble-library-object (profile.triple) document closure text units facts ir object abi
  -- An object path of `-` asks for the module without its object: the IR,
  -- the checked interfaces and what the module adds to a manifest, and no
  -- assembler or linker run. A build that compiles the IR itself
  -- (tooling/module_build.py optimises it in pieces and links the modules
  -- once) has no use for an unoptimised object or for the provider with
  -- that object merged in, and for a large module producing them is a
  -- quarter of the compile. It has no use for the provider's manifest
  -- written out again with the module merged in either: it assembles
  -- providers itself. So the manifest path receives the module's units and
  -- its facts alone, the two things `object-manifest` would have merged.
  object-package-row :: (String, Json) -> (String, String, Json)
  object-package-row (name, doc) = (name, interface-hash doc, doc)
  publish-library-package :: forall r. using (io :: Io r) => List (String, String, Json) -> Json -> Path -> Path ->{IO r, Diverge} Int
  publish-library-package rows metadata ir abi =
    case encode-object-package rows metadata of
      Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-write-failed
      Ok bytes -> case fs-write (refusal-path ir) (string-to-bytes "") of
        Err error -> pipeline-write-failed
        Ok done -> case replace-object-package abi bytes of
          Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-write-failed
          Ok done -> pipeline-ok
  assemble-library-object :: forall r. using (io :: Io r) => String -> Json -> Json -> String -> Json -> Json -> Path -> Path -> Path ->{IO r, Diverge} Int
  assemble-library-object triple document closure text units facts ir object abi =
    let object-name = path-to-string object in
    case process-run (command (path-from-string "clang") ["--target=" <> triple, "-Wno-override-module", "-c", path-to-string ir, "-o", object-name <> ".new.o"]) "" of
      Err error -> write-failure ir "bootstrap.object: cannot start object assembler" pipeline-emit-refused
      Ok (0, output) -> (case process-run (command (path-from-string "clang") ["--target=" <> triple, "-r", "-nostdlib", object-name <> ".provider.o", object-name <> ".new.o", "-o", object-name]) "" of
        Err error -> write-failure ir "bootstrap.object: cannot start dependency linker" pipeline-emit-refused
        Ok (0, output) -> (case fs-read object of
          Err error -> write-failure ir "bootstrap.object: cannot read linked object" pipeline-read-failed
          Ok code -> (case object-package-closure closure (object-field "private_interfaces" document) [] [] of
            Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-write-failed
            Ok (rows, refs) -> publish-library-package rows (object-manifest document refs units facts text code) ir abi))
        Ok (status, output) -> write-failure ir "bootstrap.object: dependency linker refused" pipeline-emit-refused)
      Ok (status, output) -> write-failure ir "bootstrap.object: object assembler refused" pipeline-emit-refused
