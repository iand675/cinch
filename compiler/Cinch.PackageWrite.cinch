-- Emit the same sectioned package read by Cinch.Package. Contract bodies
-- are postorder nodes whether they came from source or an admitted package.
module Cinch.PackageWrite where

  import Algebra.Semigroup
  import Cinch.Document
  import Cinch.PackedBody
  import Data.Bytes (bytes-copy-range, bytes-len, bytes-new)
  import Data.Bytes.Word (bytes-write-le32)
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Data.List (list-length, reverse, sort, sort-by)
  import Data.Nat (nat-from-int, nat-to-i64, saturating-sub)
  import Effect.Sequencing (ResultSequencing)

  export encode-interface-package, encode-object-package

  record Tape where
    count :: Nat
    words :: List Nat

  empty-tape :: Tape
  empty-tape = Tape 0 []

  append-words :: List Nat -> Tape -> Tape
  append-words words (Tape count backwards) = case words of
    [] -> Tape count backwards
    word : more -> append-words more (Tape (count + 1) (word : backwards))

  record Strings where
    index :: HashMap String (Nat, Nat, Nat)
    count :: Nat
    size :: Nat
    spans :: Tape
    chunks :: List Bytes

  empty-strings :: Strings
  empty-strings = Strings hash-map-empty 0 0 empty-tape []

  intern :: String -> Strings -> ((Nat, Nat, Nat), Strings)
  intern text pool = case pool of
    Strings index count size spans chunks -> (case hash-map-lookup text index of
      Some row -> (row, pool)
      None ->
        let bytes = string-to-bytes text in let width = bytes-len bytes in
        let row = (count, size, width) in
        (row, Strings (hash-map-insert text row index) (count + 1) (size + width)
          (append-words [size, width] spans) (bytes : chunks)))

  intern-id :: String -> Strings -> (Nat, Strings)
  intern-id text pool = case intern text pool of ((id, offset, size), next) -> (id, next)

  field :: String -> Json -> Json
  field name document = case document of
    JObj key value rest -> if key == name then value else field name rest
    other -> JNull

  compare-text :: String -> String -> Ordering
  compare-text left right =
    let order = string-compare left right in if order < 0 then LT else if order == 0 then EQ else GT

  compare-fields :: (String, Json) -> (String, Json) -> Ordering
  compare-fields (left, value) (right, other) = compare-text left right

  array-items :: Json -> List Json
  array-items value = case value of
    JArr first rest -> first : (array-items rest)
    other -> []

  object-fields :: Json -> List (String, Json)
  object-fields value = case value of
    JObj key item rest -> (key, item) : (object-fields rest)
    other -> []

  -- Definitions repeated in several exported closures are represented once.
  record Definitions where
    field0 :: HashMap String Json
    field1 :: List (String, Json)

  collect-definitions :: Json -> Definitions -> Result String Definitions
  collect-definitions rows state = case rows of
    JArr row rest -> (case (field "identity" row, state) of
      (JStr identity, Definitions index ordered) -> (case hash-map-lookup identity index of
        Some old -> if json-eq old row then collect-definitions rest state else Err "conflicting packed body definitions"
        None -> collect-definitions rest (Definitions (hash-map-insert identity row index) ((identity, row) : ordered)))
      other -> Err "missing packed body identity")
    JArrEnd -> Ok state
    other -> Err "invalid packed body definition table"

  collect-member :: String -> Json -> Definitions -> Result String Definitions
  collect-member key item state =
    if key /= "total_body" then collect-bodies item state else
    case item of
      JNull -> Ok state
      other -> (case field "version" item of
        JNum 1 -> collect-definitions (field "definitions" item) state
        other -> Err "unsupported packed body version")

  collect-bodies :: using (seq :: ResultSequencing String) => Json -> Definitions -> Result String Definitions
  collect-bodies value state = case value of
    JArr first rest -> do
      next <- collect-bodies first state
      collect-bodies rest next
    JObj key item rest -> do
      next <- collect-member key item state
      collect-bodies rest next
    other -> Ok state

  index-bodies :: List (String, Json) -> Nat -> HashMap String Nat -> HashMap String Nat
  index-bodies rows position index = case rows of
    [] -> index
    (name, value) : rest -> index-bodies rest (position + 1) (hash-map-insert name position index)

  record Nodes where
    pool :: Strings
    nodes :: Tape
    operands :: Tape
    targets :: List Nat

  add-node :: Nat -> Nat -> Nat -> Nat -> Nodes -> (Nat, Nodes)
  add-node tag first second third (Nodes pool nodes operands targets) =
    (nodes.count / 4, Nodes pool (append-words [tag, first, second, third] nodes) operands targets)

  data Expression where
    LocalNode :: Nat -> Expression
    NumberNode :: String -> String -> Expression
    BoolNode :: Bool -> Expression
    ApplicationNode :: Bool -> String -> Arguments -> Expression
    LetNode :: Json -> Json -> Expression
    IfNode :: Json -> Json -> Json -> Expression
    BadNode :: Expression

  data Arguments where
    DocumentArguments :: Json -> Arguments
    SpanArguments :: PackedArguments -> Arguments

  read-expression :: Json -> Expression
  read-expression value = case value of
    JTerm term -> (case packed-node term of
      PackedLocal slot -> LocalNode slot
      PackedNumber sort decimal -> NumberNode sort decimal
      PackedBool yes -> BoolNode yes
      PackedPrimitive operation args -> ApplicationNode False operation (SpanArguments args)
      PackedCall callee args -> ApplicationNode True callee (SpanArguments args)
      PackedLet bound body -> LetNode (JTerm bound) (JTerm body)
      PackedIf condition yes no -> IfNode (JTerm condition) (JTerm yes) (JTerm no)
      InvalidPackedTerm -> BadNode)
    other -> (case field "node" value of
      JStr "local" -> (case field "slot" value of JNum slot | slot >= 0 -> LocalNode (nat-from-int slot); other -> BadNode)
      JStr "number" -> (case (field "sort" value, field "decimal" value) of (JStr sort, JStr decimal) -> NumberNode sort decimal; other -> BadNode)
      JStr "bool" -> (case field "value" value of JBool yes -> BoolNode yes; other -> BadNode)
      JStr "primitive" -> (case field "operation" value of JStr operation -> ApplicationNode False operation (DocumentArguments (field "arguments" value)); other -> BadNode)
      JStr "call" -> (case field "target" value of JStr callee -> ApplicationNode True callee (DocumentArguments (field "arguments" value)); other -> BadNode)
      JStr "let" -> LetNode (field "value" value) (field "body" value)
      JStr "if" -> IfNode (field "condition" value) (field "yes" value) (field "no" value)
      other -> BadNode)

  argument-head :: Arguments -> Option (Json, Arguments)
  argument-head args = case args of
    DocumentArguments rows -> (case rows of JArr first rest -> Some (first, DocumentArguments rest); other -> None)
    SpanArguments span -> (case packed-argument-node span of
      NoPackedArguments -> None
      NextPackedArgument first rest -> Some (JTerm first, SpanArguments rest))

  emit-arguments :: using (seq :: ResultSequencing String) => HashMap String Nat -> Nat -> Arguments -> List Nat -> Nat -> Nodes -> Result String (Nat, Nat, Nodes)
  emit-arguments index depth args backwards count state = case argument-head args of
    None -> (case state of
      Nodes pool nodes operands targets ->
        Ok (operands.count, count, Nodes pool nodes (append-words (reverse backwards) operands) targets))
    Some (item, rest) -> do
      emitted <- emit-expression index depth item state
      case emitted of
        (id, next) -> emit-arguments index depth rest (id : backwards) (count + 1) next

  emit-application :: HashMap String Nat -> Bool -> String -> Nat -> Nat -> Nodes -> Result String (Nat, Nodes)
  emit-application index call name start count (Nodes pool nodes operands targets) =
    if call then (case hash-map-lookup name index of
      None -> Err ("missing packed call target " <> name)
      Some id -> Ok (add-node 4 id start count (Nodes pool nodes operands (id : targets))))
    else let (id, next) = intern-id name pool in Ok (add-node 3 id start count (Nodes next nodes operands targets))

  emit-expression :: using (seq :: ResultSequencing String) => HashMap String Nat -> Nat -> Json -> Nodes -> Result String (Nat, Nodes)
  emit-expression index depth expression state =
    if depth == 0 then Err "over-nested packed body" else
    let next = depth - 1 in
    case read-expression expression of
      LocalNode slot -> Ok (add-node 0 slot 0 0 state)
      NumberNode sort decimal -> (case state of
        Nodes pool nodes operands targets ->
          let (sort-id, first) = intern-id sort pool in let (decimal-id, second) = intern-id decimal first in
          Ok (add-node 1 sort-id decimal-id 0 (Nodes second nodes operands targets)))
      BoolNode yes -> Ok (add-node 2 (if yes then 1 else 0) 0 0 state)
      ApplicationNode call name args -> do
        emitted <- emit-arguments index next args [] 0 state
        case emitted of
          (start, count, following) -> emit-application index call name start count following
      LetNode bound body -> do
        first <- emit-expression index next bound state
        case first of
          (left, following) -> do
            second <- emit-expression index next body following
            case second of
              (right, final) -> Ok (add-node 5 left right 0 final)
      IfNode condition yes no -> do
        c-res <- emit-expression index next condition state
        case c-res of
          (test, following) -> do
            y-res <- emit-expression index next yes following
            case y-res of
              (left, middle) -> do
                n-res <- emit-expression index next no middle
                case n-res of
                  (right, final) -> Ok (add-node 6 test left right final)
      BadNode -> Err "invalid packed body node"

  emit-parameters :: Json -> Tape -> Strings -> Result String (Tape, Strings)
  emit-parameters values tape pool = case values of
    JArr (JStr sort) rest ->
      let (id, next) = intern-id sort pool in emit-parameters rest (append-words [id] tape) next
    JArrEnd -> Ok (tape, pool)
    other -> Err "invalid packed body parameter sort"

  write-targets :: List Nat -> Option Nat -> Tape -> Tape
  write-targets values previous tape = case values of
    [] -> tape
    first : rest -> (case previous of
      Some old | old == first -> write-targets rest previous tape
      other -> write-targets rest (Some first) (append-words [first] tape))

  emit-bodies :: List (String, Json) -> HashMap String Nat -> Tape -> Tape -> Nodes -> Result String (Tape, Tape, Nodes)
  emit-bodies definitions index bodies edges state = case definitions of
    [] -> Ok (bodies, edges, state)
    (name, definition) : rest -> (case (state, field "result" definition) of
      (Nodes pool nodes operands ignored, JStr result) ->
        let start = operands.count in
        (case emit-parameters (field "parameters" definition) operands pool of
          Err error -> Err error
          Ok (params, strings) ->
            let count = saturating-sub (params.count) start in
            (case emit-expression index 256 (field "body" definition) (Nodes strings nodes params []) of
              Err error -> Err error
              Ok (root, Nodes term-strings term-nodes term-operands targets) ->
                let edge-start = edges.count in
                let next-edges = write-targets (sort targets) None edges in
                let (name-id, first) = intern-id name term-strings in
                let (result-id, final) = intern-id result first in
                let next-bodies = append-words [name-id, result-id, start, count, root, edge-start, saturating-sub (next-edges.count) edge-start, 0] bodies in
                emit-bodies rest index next-bodies next-edges (Nodes final term-nodes term-operands [])))
      other -> Err "invalid packed body result sort")

  body-root :: Json -> Option String
  body-root fields = case field "symbol" fields of
    JStr name -> Some name
    other -> (case field "implementation" fields of
      JStr name -> Some name
      other -> (case field "identity" fields of JStr name -> Some name; other -> None))

  emit-body-root :: HashMap String Nat -> Json -> Tape -> Strings -> Result String (Tape, Strings)
  emit-body-root index doc tape pool = case body-root doc of
    None -> Err "missing packed body root"
    Some name -> (case hash-map-lookup name index of
      None -> Err ("missing packed body definition " <> name)
      Some id -> Ok (append-words [9, id] tape, pool))

  emit-number :: Int -> Tape -> Strings -> Result String (Tape, Strings)
  emit-number number tape pool =
    let magnitude = if number < 0 then 0 - number else number in
    if magnitude >= 0 && magnitude < 18446744073709551616 then
      let value = nat-from-int magnitude in
      Ok (append-words [if number < 0 then 8 else 3, value % 4294967296, value / 4294967296] tape, pool)
    else Err "integer exceeds packed format width"

  emit-items :: using (seq :: ResultSequencing String) => Option (HashMap String Nat) -> Nat -> List Json -> Tape -> Strings -> Result String (Tape, Strings)
  emit-items index depth items tape pool = case items of
    [] -> Ok (tape, pool)
    item : rest -> do
      emitted <- emit-value index depth item tape pool
      case emitted of
        (next, strings) -> emit-items index depth rest next strings

  emit-fields :: using (seq :: ResultSequencing String) => Option (HashMap String Nat) -> Nat -> Json -> List (String, Json) -> Tape -> Strings -> Result String (Tape, Strings)
  emit-fields index depth parent fields tape pool = case fields of
    [] -> Ok (tape, pool)
    (name, value) : rest -> do
      let (id, strings) = intern-id name pool
      let start = append-words [id] tape
      emitted <- case (index, value) of
        (Some bodies, JObj key item tail) | name == "total_body" -> emit-body-root bodies parent start strings
        other -> emit-value index depth value start strings
      case emitted of
        (next, following) -> emit-fields index depth parent rest next following

  emit-value :: Option (HashMap String Nat) -> Nat -> Json -> Tape -> Strings -> Result String (Tape, Strings)
  emit-value index depth value tape pool =
    if depth == 0 then Err "over-nested packed document" else
    let next = depth - 1 in
    case value of
      JNull -> Ok (append-words [0] tape, pool)
      JBool yes -> Ok (append-words [if yes then 2 else 1] tape, pool)
      JNum number -> emit-number number tape pool
      JStr text ->
        let (id, strings) = intern-id text pool in Ok (append-words [4, id] tape, strings)
      JArrEnd -> Ok (append-words [5, 0] tape, pool)
      JObjEnd -> Ok (append-words [6, 0] tape, pool)
      JArr first rest ->
        let items = array-items value in emit-items index next items (append-words [5, list-length items] tape) pool
      JObj key item rest ->
        let fields = sort-by compare-fields (object-fields value) in
        emit-fields index next value fields (append-words [6, list-length fields] tape) pool
      JTerm term -> emit-value index depth (term-document term) tape pool
      JFloat number -> Err "floating-point number in packed document"

  compare-values :: Json -> Json -> Ordering
  compare-values left right = case (field "name" left, field "name" right) of
    (JStr one, JStr two) -> compare-text one two
    other -> EQ

  emit-value-rows :: HashMap String Nat -> List Json -> Tape -> Strings -> Result String (Tape, Strings)
  emit-value-rows index rows tape pool = case rows of
    [] -> Ok (tape, pool)
    row : rest -> (case (field "name" row, field "symbol" row, field "scheme" row, field "arity" row) of
      (JStr name, JStr symbol, JStr scheme, JNum arity) | arity >= 0 ->
        let root = (case field "total_body" row of
          JNull -> Some 4294967295
          other -> hash-map-lookup symbol index) in
        (case root of
          None -> Err "missing packed value body"
          Some id ->
            let ((name-id, name-at, name-size), first) = intern name pool in
            let ((symbol-id, symbol-at, symbol-size), second) = intern symbol first in
            let ((scheme-id, scheme-at, scheme-size), third) = intern scheme second in
            emit-value-rows index rest (append-words [name-at, name-size, symbol-at, symbol-size, scheme-at, scheme-size, nat-from-int arity, id] tape) third)
      other -> Err "invalid packed value export")

  compare-modules :: (String, String, Json) -> (String, String, Json) -> Ordering
  compare-modules (left, digest, doc) (right, hash, other) = compare-text left right

  collect-modules :: using (seq :: ResultSequencing String) => List (String, String, Json) -> Definitions -> Result String Definitions
  collect-modules rows state = case rows of
    [] -> Ok state
    (name, hash, doc) : rest -> do
      next <- collect-bodies (field "exports" doc) state
      collect-modules rest next

  module-indices :: List (String, String, Json) -> Nat -> HashMap String Nat -> Result String (HashMap String Nat)
  module-indices rows position index = case rows of
    [] -> Ok index
    (name, hash, doc) : rest -> (case hash-map-lookup name index of
      Some old -> Err "duplicate packed module"
      None -> module-indices rest (position + 1) (hash-map-insert name position index))

  record Directories where
    field0 :: Tape
    field1 :: Tape
    field2 :: Tape
    field3 :: Strings

  emit-modules :: HashMap String Nat -> HashMap String Nat -> List (String, String, Json) -> List (String, String, Json) -> Directories -> Result String Directories
  emit-modules index bodies sorted original state = case (sorted, original, state) of
    ([], [], directories) -> Ok directories
    ((name, hash, doc) : rest, (input, digest, source) : inputs, Directories modules values contracts pool) ->
      (case hash-map-lookup input index of
        None -> Err "missing packed module position"
        Some position -> (case emit-value (Some bodies) 256 doc contracts pool of
          Err error -> Err error
          Ok (document-tape, strings) ->
            let exports = sort-by compare-values (array-items (field "values" (field "exports" doc))) in
            let ((name-id, name-at, name-size), first) = intern name strings in
            let ((hash-id, hash-at, hash-size), second) = intern hash first in
            (case emit-value-rows bodies exports values second of
              Err error -> Err error
              Ok (rows, final) ->
                let start = 4 * contracts.count in
                let width = saturating-sub (4 * document-tape.count) start in
                let directory = append-words [name-at, name-size, hash-at, hash-size, values.count / 8, list-length exports, start, width, position] modules in
                emit-modules index bodies rest inputs (Directories directory rows document-tape final))))
    other -> Err "inconsistent packed module count"

  write-words :: Bytes -> Nat -> List Nat -> Result String Unit
  write-words out end backwards = case backwards of
    [] -> Ok ()
    word : rest ->
      if end >= 4 && end <= bytes-len out && word <= 4294967295 then
        let at = end - 4 in
        let written = bytes-write-le32 out at (wrapping-i64-to-u32 (nat-to-i64 word)) in
        write-words out at rest
      else Err "packed package exceeds the word range"

  write-tape :: Bytes -> Nat -> Tape -> Result String Unit
  write-tape out start (Tape count backwards) = write-words out (start + 4 * count) backwards

  write-chunks :: Bytes -> Nat -> List Bytes -> Result String Unit
  write-chunks out end backwards = case backwards of
    [] -> Ok ()
    source : rest ->
      let width = bytes-len source in
      if width <= end && end <= bytes-len out then
        let at = end - width in
        let copied = bytes-copy-range out source at 0 width in write-chunks out at rest
      else Err "packed string bytes outside the package"

  describe-sections :: Nat -> List Tape -> Tape -> (Nat, Tape)
  describe-sections start sections header = case sections of
    [] -> (start, header)
    tape : rest ->
      let width = 4 * tape.count in
      describe-sections (start + width) rest (append-words [start, width] header)

  write-sections :: using (seq :: ResultSequencing String) => Bytes -> Nat -> List Tape -> Result String Unit
  write-sections out start sections = case sections of
    [] -> Ok ()
    tape : rest -> do
      _ <- write-tape out start tape
      write-sections out (start + 4 * tape.count) rest

  assemble :: using (seq :: ResultSequencing String) => Strings -> List Tape -> Result String Bytes
  assemble (Strings index count size spans chunks) sections =
    let strings-width = 4 + 4 * spans.count + size in
    let strings-end = 88 + strings-width in
    let (length, region-pairs) = describe-sections strings-end sections (append-words [88, strings-width] empty-tape) in
    if length > 4294967295 then Err "packed package exceeds the 32-bit format" else do
      let out = bytes-new length
      _ <- write-tape out 0 (append-words [1129204035, 877350984, length, 4] empty-tape)
      _ <- write-tape out 16 region-pairs
      _ <- write-tape out 88 (append-words [count] empty-tape)
      _ <- write-tape out 92 spans
      _ <- write-chunks out strings-end chunks
      _ <- write-sections out strings-end sections
      Ok out

  -- The caller supplies checked contracts in dependency visitation order.
  encode-object-package :: List (String, String, Json) -> Json -> Result String Bytes
  encode-object-package rows abi = encode-package rows (Some abi)

  encode-interface-package :: List (String, String, Json) -> Result String Bytes
  encode-interface-package rows = encode-package rows None

  encode-package :: using (seq :: ResultSequencing String) => List (String, String, Json) -> Option Json -> Result String Bytes
  encode-package rows abi = do
    let sorted = sort-by compare-modules rows
    indices <- module-indices sorted 0 hash-map-empty
    collected <- collect-modules sorted (Definitions hash-map-empty [])
    case collected of
      Definitions definitions order -> do
        let body-rows = sort-by compare-fields order
        let body-ids = index-bodies body-rows 0 hash-map-empty
        emitted-bodies <- emit-bodies body-rows body-ids empty-tape empty-tape (Nodes empty-strings empty-tape empty-tape [])
        case emitted-bodies of
          (bodies, edges, Nodes body-strings nodes operands targets) -> do
            dirs <- emit-modules indices body-ids sorted rows (Directories empty-tape empty-tape empty-tape body-strings)
            case dirs of
              Directories modules values contracts strings ->
                encode-abi abi strings [modules, values, bodies, edges, nodes, operands, contracts]

  encode-abi :: using (seq :: ResultSequencing String) => Option Json -> Strings -> List Tape -> Result String Bytes
  encode-abi abi (Strings index count size spans chunks) sections = case abi of
    None -> assemble (Strings index count size spans chunks) (sections <> [empty-tape])
    Some document -> do
      emitted <- emit-value None 256 document (append-words [count] empty-tape) (Strings index count size spans chunks)
      case emitted of
        (metadata, strings) -> assemble strings (sections <> [metadata])
