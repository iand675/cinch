-- Data.Bytes: boxed byte buffers.
--
-- `Bytes` is a core runtime type: indices and lengths are `Nat`, and a
-- byte is an `InRange 0 255 Nat`. Every operation is total by
-- construction (design/no-faults.md): a read or write takes evidence
-- that its index is below `bytes-len b`, a range copy evidence that both
-- ranges end inside their buffers, a read's result carries its range and
-- a write's value must prove it. A buffer's length is fixed when it is
-- made, so a fact over `bytes-len b` survives writes to `b`, and
-- `bytes-new n` gives `bytes-len out == n` to the name it is bound to.
-- A length no allocation can hold is the heap `Exhausted` exit.
--
-- Module scheme (design/base-library.md): the type's home carries its
-- instance family: `FromList` (`[1, 2, 3]` at `Bytes` fills a buffer)
-- over `U8` elements, so a literal's numerals are range-checked as
-- bytes at compile time, and the key pair `Eq`/`Hash` (a byte slice is
-- a plausible key: a compiler's names arrive as the lexer's bytes).
module Data.Bytes where

  import Algebra.Arithmetic
  import Data.Hash
  import Data.List
  import Data.Nat

  export bytes-new, bytes-len, bytes-get, bytes-set, bytes-data, bytes-copy-range, bytes-compare, bytes-from-list, bytes-from-u8s, sha256-bytes


  -- `nat-cmp`/`int-cmp` return the raw -1/0/1 immediate at `I64`, so
  -- equality is `eq-i64 (int-cmp a b) 0`.

  -- `Bytes`: boxed byte buffers. `bytes-len` comes first: the other
  -- signatures name it. A length is an `i64` in the runtime, so it is at
  -- most `2^63 - 1` and every index below it converts to `I64`. The
  -- index obligation is `nat-sub`'s shape: a loop's own guard (`if i <
  -- bytes-len b`), a fresh buffer's length or an enclosing `using (i <=
  -- bytes-len b)` supplies it. A string literal's read-only backing is
  -- never one of these buffers: it lives inside a `String`, and every
  -- conversion out of a `String` copies.
  foreign import ccall "cinch.runtime.bytesLen" bytes-len :: Bytes -> InRange 0 9223372036854775807 Nat
  foreign import ccall "cinch.runtime.bytesNew" bytes-new :: (n :: Nat) -> refined (bytes-len out == n) Bytes
  foreign import ccall "cinch.runtime.bytesGet" bytes-get :: using (i < bytes-len b) => (b :: Bytes) -> (i :: Nat) -> InRange 0 255 Nat
  foreign import ccall "cinch.runtime.bytesSet" bytes-set :: using (i < bytes-len b) => (b :: Bytes) -> (i :: Nat) -> InRange 0 255 Nat -> Unit

  -- `bytes-data b`: the address of the buffer's payload as a machine
  -- word. This is how a buffer reaches the operating system: a `prim`
  -- body or a `foreign import ccall` takes the address and the length
  -- separately, exactly as the C interface does. The buffer never moves
  -- and the address is valid while the handle is live, so a caller that
  -- wants a C string NUL-terminates it itself (a fresh buffer one byte
  -- longer, the bytes copied in, the last byte zeroed).
  foreign import ccall "cinch.runtime.bytesData" bytes-data :: Bytes -> I64

  -- `bytes-copy-range dst src di si n`: the `n` bytes of `src` from `si`
  -- into `dst` at `di`, as one runtime `memmove` (the two may be the
  -- same buffer and overlap). A copy loop written here would box a `Nat`
  -- for every index step, so every bulk copy goes through this.
  foreign import ccall "cinch.runtime.bytesCopy" bytes-copy-range :: using (di + n <= bytes-len dst, si + n <= bytes-len src) => (dst :: Bytes) -> (src :: Bytes) -> (di :: Nat) -> (si :: Nat) -> (n :: Nat) -> Unit

  -- The lexicographic order of two buffers' contents as the raw -1/0/1
  -- immediate (the `nat-cmp` convention), read in place: no copy and
  -- no allocation.
  foreign import ccall "cinch.runtime.bytesCompare" bytes-compare :: Bytes -> Bytes -> I64

  -- SHA-256 (FIPS 180-4) at content-addressing strength over a
  -- buffer (the P31 content identity; `compiler/runtime/src/text.rs`,
  -- the `cinch.runtime.textSha256` intrinsic, nm-verified there): the
  -- digest as a fresh 32-byte buffer.
  foreign import ccall "cinch.runtime.textSha256" sha256-bytes :: Bytes -> Bytes

  -- The list's bytes, in order. A byte is an `InRange 0 255 Nat`, so a
  -- list of numerals decides each element at compile time and a
  -- computed list carries its elements' ranges.
  bytes-from-list :: List (InRange 0 255 Nat) -> Bytes
  bytes-from-list xs = bytes-fill-from 0 xs

  -- The elements from index `i` on: the buffer is made once, at the end
  -- of the list, sized to `i` plus nothing more, and each element is
  -- written on the way back. The result's refinement (`i <= bytes-len
  -- out`) is the bound every write proves, so no index is guessed.
  bytes-fill-from :: (i :: Nat) -> List (InRange 0 255 Nat) -> refined (i <= bytes-len out) Bytes
  bytes-fill-from i xs = case xs of
    Nil -> bytes-new i
    Cons y ys ->
      let out = bytes-fill-from (i + 1) ys in
      let u = bytes-set out i y in
      out

  -- A `U8` as the byte it is (`Data.Machine`'s `u8-to-i64` intrinsic,
  -- declared here because `Data.Machine` imports this module): its
  -- promised range is the evidence `nat-from-i64` takes, and the result
  -- keeps it.
  foreign import ccall "cinch.prim.u8ToI64" byte-word :: (x :: U8) -> refined (InRange 0 255 r && r == x) I64

  byte-of-u8 :: U8 -> InRange 0 255 Nat
  byte-of-u8 x = let w = byte-word x in nat-from-i64 w

  -- The `FromList` buffer: `bytes-from-list`'s shape over `U8`.
  bytes-from-u8s :: List U8 -> Bytes
  bytes-from-u8s xs = u8s-fill-from 0 xs

  u8s-fill-from :: (i :: Nat) -> List U8 -> refined (i <= bytes-len out) Bytes
  u8s-fill-from i xs = case xs of
    Nil -> bytes-new i
    Cons y ys ->
      let out = u8s-fill-from (i + 1) ys in
      let u = bytes-set out i (byte-of-u8 y) in
      out

  implicit instance FromList_Bytes :: FromList Bytes U8 where
    from-list xs = bytes-from-u8s xs

  -- Byte-for-byte equality over the backing: the in-place compare answers
  -- equal when the lengths agree and every byte agrees, reading the common
  -- prefix a word at a time. The keyed structures need `Eq` beside `Hash`
  -- (Data.HashMap's header): hashing alone cannot decide a digest
  -- collision, so an instance that hashes without comparing is not a
  -- key.
  implicit instance Eq_Bytes :: Eq Bytes where
    (==) x y = eq-i64 (bytes-compare x y) 0
    (/=) x y = ne-i64 (bytes-compare x y) 0

  -- The digest fold is FNV-1a in a 64-bit word: the accumulator starts at
  -- the offset basis, every byte is mixed in as `(h xor byte) * prime`
  -- under WRAPPING multiplication, and the word is reduced to `Nat` once,
  -- after the fold.
  --
  -- INVARIANT: the accumulator is a `U64` at every step, so a product is
  -- taken modulo 2^64 and no value is ever out of the word's range. The
  -- only boxed `Nat` a digest allocates is the one the reduction returns.
  --
  -- Why the word, not `Nat`. The earlier fold was `h * 31 + byte` over
  -- `Nat`: two bignum operations and about 73 allocations per
  -- compiler-length name, 1,700 ns for the digest of an 8 to 40 byte
  -- identifier. A hash index only pays when a digest costs less than the
  -- scan it replaces, and at that price none did (design/compilation-speed.md
  -- 2.9 measures the old instance against the short scans it lost to).
  --
  -- The digest is a bucket key, so the class law is the only obligation
  -- (Data.Hash): equal slices hash alike because the fold reads content
  -- only, the result is a pure function of the bytes (no address, no time,
  -- so it is reproducible across runs), and distinct slices may still
  -- share a digest (the bucket scan's job).
  hash-bytes-from :: Bytes -> Nat -> U64 -> Nat
  hash-bytes-from b i h =
    if i >= bytes-len b then u64-to-nat h
    else
      let c = wrapping-i64-to-u64 (nat-to-i64 (bytes-get b i)) in
      hash-bytes-from b (i + 1) (wrapping-mul-u64 (bit-xor-u64 h c) 1099511628211)

  -- The offset basis of FNV-1a (64-bit): 14695981039346656037.
  fnv-offset :: U64
  fnv-offset = 14695981039346656037

  -- A 64-bit word as the `Nat` of the same value with its top bit
  -- cleared. INVARIANT: the result is in `0 .. 2^63 - 1`, which is what
  -- `nat-from-i64` requires; `mask-i64` carries that refinement, and the
  -- mask is a constant, so the cost is the single boxed `Nat` every
  -- digest returns. Clearing one bit of a 64-bit digest changes nothing
  -- about the law.
  u64-to-nat :: U64 -> Nat
  u64-to-nat w = nat-from-i64 (mask-i64 (wrapping-u64-to-i64 w) 9223372036854775807)

  -- The buffer's digest (instances live with their type). `Data.String`
  -- hashes its UTF-8 backing through THIS instance, so a string and the
  -- bytes it converts to agree by construction rather than by two
  -- copies of one algorithm.
  implicit instance Hash_Bytes :: Hash Bytes where
    hash b = hash-bytes-from b 0 fnv-offset
