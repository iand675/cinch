-- Data.Char: Unicode scalar values.
--
-- `Char` is a core runtime type (primitive types specification
-- section 1): one scalar value. `u32-to-char` rejects values outside
-- the scalar range (surrogates and above 0x10FFFF) as `None`.
--
-- Module scheme (design/base-library.md): the type's home carries its
-- instance family (the parked-instance deviation of D159 is over).
module Data.Char where

  import Data.Option
  import Data.Hash

  export char-to-u32, u32-to-char, eq-char, ne-char, lt-char, le-char, gt-char, ge-char
  export char-code, char-from-code
  export is-ascii-digit, digit-value, hex-digit-value, is-ascii-hex-digit


  -- Primitive types specification, section 6: Char values are Unicode
  -- scalar values, in code point order. `u32-to-char` rejects surrogates
  -- and values above 0x10FFFF.
  foreign import ccall "cinch.prim.charToU32" char-to-u32 :: Char -> U32
  foreign import ccall "cinch.prim.u32ToChar" u32-to-char :: U32 -> Option Char
  foreign import ccall "cinch.prim.eqChar" eq-char :: Char -> Char -> Bool
  foreign import ccall "cinch.prim.neChar" ne-char :: Char -> Char -> Bool
  foreign import ccall "cinch.prim.ltChar" lt-char :: Char -> Char -> Bool
  foreign import ccall "cinch.prim.leChar" le-char :: Char -> Char -> Bool
  foreign import ccall "cinch.prim.gtChar" gt-char :: Char -> Char -> Bool
  foreign import ccall "cinch.prim.geChar" ge-char :: Char -> Char -> Bool

  -- The scalar value as a `Nat`: the conversion the text and data
  -- homes all spelled out by hand before this was its home.
  char-code :: Char -> Nat
  char-code c = nat-from-i64 (u32-to-i64 (char-to-u32 c))

  -- The inverse, partial exactly as `u32-to-char` is: a value outside
  -- the scalar range (a surrogate, or above 0x10FFFF) is `None`.
  char-from-code :: Nat -> Option Char
  char-from-code n = u32-to-char (wrapping-i64-to-u32 (nat-to-i64 n))

  -- The ASCII digit and hex-digit test/value pairs. Every text and
  -- data home that parses numeric text had written its own (under
  -- `is-digit-char`, `digit-of`, `is-hex`, `hex-of`, ...), and this is
  -- their one home. The names say ASCII because that is the whole
  -- class they accept: there is no Unicode digit or decimal-digit
  -- database here, and none is claimed.

  is-ascii-digit :: Char -> Bool
  is-ascii-digit c =
    let n = char-code c in
    (n >= 48) && (n <= 57)

  -- `Some 0..9` for the ASCII digits, `None` otherwise (the caller
  -- has already decided what a non-digit means).
  digit-value :: Char -> Option Nat
  digit-value c = case is-ascii-digit c of
    True -> Some (char-code c - 48)
    False -> None

  -- `Some 0..15` for `0`-`9`, `a`-`f` and `A`-`F`; `None` otherwise.
  hex-digit-value :: Char -> Option Nat
  hex-digit-value c =
    let n = char-code c in
    if (n >= 48) && (n <= 57) then Some (n - 48)
    else if (n >= 97) && (n <= 102) then Some (n - 87)
    else if (n >= 65) && (n <= 70) then Some (n - 55)
    else None

  is-ascii-hex-digit :: Char -> Bool
  is-ascii-hex-digit c = case hex-digit-value c of
    Some _ -> True
    None -> False

  implicit instance Eq_Char :: Eq Char where
    (==) x y = eq-char x y
    (/=) x y = ne-char x y

  implicit instance Ord_Char :: Ord Char where
    (<) x y = lt-char x y
    (<=) x y = le-char x y
    (>) x y = gt-char x y
    (>=) x y = ge-char x y

  -- The scalar value is the digest (instances live with their type).
  implicit instance Hash_Char :: Hash Char where
    hash c = nat-from-i64 (u32-to-i64 (char-to-u32 c))
