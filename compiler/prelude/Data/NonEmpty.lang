-- Data.NonEmpty: the non-empty list, head plus tail.
--
-- `NonEmpty a` is `a` paired with a `List a`: the free semigroup over
-- `a`. Every value has at least one element, so `null` is the constant
-- `False`, `length` is at least 1, and `<>` is total concatenation.
--
-- Instance homes: this is the correct home for every instance below
-- (instances live with their type). The class modules are
-- Category/Foldable.lang, Category/Traversable.lang and
-- Algebra/Semigroup.lang.
--
-- The traversal instance is written against the effect's Applicative
-- dictionary like every Traversable instance: `traverse` applies the
-- effectful function to the head first and then the tail through the
-- List instance, so for the left-biased effects (`Result`, `Option`)
-- the FIRST error in traversal order is the one returned (asserted in
-- compiler/tests/lib_foldable.rs).
--
-- Status: this module is replaced wholesale by a refinement in the
-- P28 phase (decision D151: `NonEmpty` is a decidable predicate over
-- `List`, witness `Prop`-erased), so it carries exactly the shape its
-- current tests need and nothing more.
module Data.NonEmpty where

  import Category.Foldable
  import Category.Traversable
  import Category.Applicative
  import Algebra.Semigroup

  infixr 6 <>

  data NonEmpty a where
    NonEmpty :: a -> List a -> NonEmpty a

  implicit instance Foldable_NonEmpty :: Foldable NonEmpty where
    foldr f z ne = case ne of
      NonEmpty h t -> f h (foldr f z t)
    foldl f z ne = case ne of
      NonEmpty h t -> foldl f (f z h) t
    to-list ne = case ne of
      NonEmpty h t -> Cons h (to-list t)
    null ne = False
    length ne = case ne of
      NonEmpty h t -> 1 + length t

  -- The free semigroup: concatenation preserves the leftmost head.
  -- Associative because list concatenation is; asserted over sample
  -- values in compiler/tests/lib_foldable.rs.
  implicit instance Semigroup_NonEmpty x :: Semigroup (NonEmpty x) where
    (<>) p q = case p of
      NonEmpty h1 t1 -> case q of
        NonEmpty h2 t2 -> NonEmpty h1 (t1 <> Cons h2 t2)

  implicit instance Traversable_NonEmpty :: Traversable NonEmpty where
    traverse f ne = case ne of
      NonEmpty h t -> lift-a2 (\b bs -> NonEmpty b bs) (f h) (traverse f t)
    sequence ne = traverse (\x -> x) ne
