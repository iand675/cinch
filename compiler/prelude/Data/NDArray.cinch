-- Immutable row-major arrays, with checked runtime shapes of any rank.
module Data.NDArray where
  import Data.Core
  import Data.Array

  export ndarray-reshape, ndarray-shape, ndarray-data, ndarray-get, ndarray-set
  foreign import ccall "cinch.runtime.ndarrayReshape" ndarray-reshape :: forall a. Array Nat -> Array a -> Option (NDArray a)
  foreign import ccall "cinch.runtime.ndarrayShape" ndarray-shape :: forall a. NDArray a -> Array Nat
  foreign import ccall "cinch.runtime.ndarrayData" ndarray-data :: forall a. NDArray a -> Array a
  foreign import ccall "cinch.runtime.ndarrayGet" ndarray-get :: forall a. NDArray a -> Array Nat -> Option a
  foreign import ccall "cinch.runtime.ndarraySet" ndarray-set :: forall a. NDArray a -> Array Nat -> a -> Option (NDArray a)
