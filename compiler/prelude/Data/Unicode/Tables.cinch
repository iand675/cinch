  -- | Read one immutable class-metadata entry; an out-of-range index returns zero.
  unicode-data-class-metadata :: U32 -> U64
  unicode-data-class-metadata index = if table-lt index 1021 then
    let page = table-shr index 6 in
    unicode-data-class-metadata-route page index
    else 0

  -- | Route a bounded class-metadata index without constructing a runtime table.
  unicode-data-class-metadata-route :: U32 -> U32 -> U64
  unicode-data-class-metadata-route page index =
    if table-lt page 8 then
      if table-lt page 4 then
        if table-lt page 2 then
          if table-lt page 1 then
            let local = table-sub index 0 in
            unicode-data-class-metadata-page-a local
          else
            let local = table-sub index 64 in
            unicode-data-class-metadata-page-b local
        else
          if table-lt page 3 then
            let local = table-sub index 128 in
            unicode-data-class-metadata-page-c local
          else
            let local = table-sub index 192 in
            unicode-data-class-metadata-page-d local
      else
        if table-lt page 6 then
          if table-lt page 5 then
            let local = table-sub index 256 in
            unicode-data-class-metadata-page-e local
          else
            let local = table-sub index 320 in
            unicode-data-class-metadata-page-f local
        else
          if table-lt page 7 then
            let local = table-sub index 384 in
            unicode-data-class-metadata-page-g local
          else
            let local = table-sub index 448 in
            unicode-data-class-metadata-page-h local
    else
      if table-lt page 12 then
        if table-lt page 10 then
          if table-lt page 9 then
            let local = table-sub index 512 in
            unicode-data-class-metadata-page-i local
          else
            let local = table-sub index 576 in
            unicode-data-class-metadata-page-j local
        else
          if table-lt page 11 then
            let local = table-sub index 640 in
            unicode-data-class-metadata-page-k local
          else
            let local = table-sub index 704 in
            unicode-data-class-metadata-page-l local
      else
        if table-lt page 14 then
          if table-lt page 13 then
            let local = table-sub index 768 in
            unicode-data-class-metadata-page-m local
          else
            let local = table-sub index 832 in
            unicode-data-class-metadata-page-n local
        else
          if table-lt page 15 then
            let local = table-sub index 896 in
            unicode-data-class-metadata-page-o local
          else
            let local = table-sub index 960 in
            unicode-data-class-metadata-page-p local

