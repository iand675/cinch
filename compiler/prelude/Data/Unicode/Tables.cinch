  -- | Read one immutable table-info entry; an out-of-range index returns zero.
  unicode-data-table-info :: U32 -> U64
  unicode-data-table-info index = if lt-u32 index 259 then
    let page = wrapping-shr-u32 index 6 in
    unicode-data-table-info-route page index
    else 0

  -- | Route a bounded table-info index without constructing a runtime table.
  unicode-data-table-info-route :: U32 -> U32 -> U64
  unicode-data-table-info-route page index =
    if lt-u32 page 2 then
      if lt-u32 page 1 then
        let local = wrapping-sub-u32 index 0 in
        unicode-data-table-info-page-a local
      else
        let local = wrapping-sub-u32 index 64 in
        unicode-data-table-info-page-b local
    else
      if lt-u32 page 3 then
        let local = wrapping-sub-u32 index 128 in
        unicode-data-table-info-page-c local
      else
        if lt-u32 page 4 then
          let local = wrapping-sub-u32 index 192 in
          unicode-data-table-info-page-d local
        else
          let local = wrapping-sub-u32 index 256 in
          unicode-data-table-info-page-e local

