  -- | Read one immutable case-deltas entry; an out-of-range index returns zero.
  unicode-data-case-deltas :: U32 -> U64
  unicode-data-case-deltas index = if lt-u32 index 336 then
    let page = wrapping-shr-u32 index 6 in
    unicode-data-case-deltas-route page index
    else 0

  -- | Route a bounded case-deltas index without constructing a runtime table.
  unicode-data-case-deltas-route :: U32 -> U32 -> U64
  unicode-data-case-deltas-route page index =
    if lt-u32 page 3 then
      if lt-u32 page 1 then
        let local = wrapping-sub-u32 index 0 in
        unicode-data-case-deltas-page-a local
      else
        if lt-u32 page 2 then
          let local = wrapping-sub-u32 index 64 in
          unicode-data-case-deltas-page-b local
        else
          let local = wrapping-sub-u32 index 128 in
          unicode-data-case-deltas-page-c local
    else
      if lt-u32 page 4 then
        let local = wrapping-sub-u32 index 192 in
        unicode-data-case-deltas-page-d local
      else
        if lt-u32 page 5 then
          let local = wrapping-sub-u32 index 256 in
          unicode-data-case-deltas-page-e local
        else
          let local = wrapping-sub-u32 index 320 in
          unicode-data-case-deltas-page-f local

