    else if eq-i64 order 0 then unicode-builtin-range-table 256
    else
      let order = string-compare name "Mn" in
      if lt-i64 order 0 then
        let order = string-compare name "M" in
        if lt-i64 order 0 then
          None
        else if eq-i64 order 0 then unicode-builtin-range-table 257
        else
          None
      else if eq-i64 order 0 then unicode-builtin-range-table 258
      else
