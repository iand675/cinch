  -- | Count the exact unicode-property catalog keys, including documented aliases.
  unicode-property-count :: Nat
  unicode-property-count = 39

  -- | Read one sorted immutable unicode-property key; invalid indices return None.
  unicode-property-name :: Nat -> Option String
  unicode-property-name index = if index < 39 then Some (unicode-property-key (wrapping-i64-to-u32 (nat-to-i64 index))) else None
  -- | Select a shared immutable unicode-property literal through bounded shallow pages.
  unicode-property-key :: U32 -> String
  unicode-property-key index =
    if lt-u32 index 64 then
      let local = wrapping-sub-u32 index 0 in unicode-property-keys-a local
    else ""

  -- | One complete shallow page of immutable unicode-property key literals.
  unicode-property-keys-a :: U32 -> String
  unicode-property-keys-a index = case index of
    0 -> "ASCII_Hex_Digit"
    1 -> "Bidi_Control"
    2 -> "Dash"
    3 -> "Deprecated"
    4 -> "Diacritic"
    5 -> "Extender"
    6 -> "Hex_Digit"
    7 -> "Hyphen"
    8 -> "IDS_Binary_Operator"
    9 -> "IDS_Trinary_Operator"
    10 -> "IDS_Unary_Operator"
    11 -> "ID_Compat_Math_Continue"
    12 -> "ID_Compat_Math_Start"
    13 -> "Ideographic"
    14 -> "Join_Control"
    15 -> "Logical_Order_Exception"
    16 -> "Modifier_Combining_Mark"
    17 -> "Noncharacter_Code_Point"
    18 -> "Other_Alphabetic"
    19 -> "Other_Default_Ignorable_Code_Point"
    20 -> "Other_Grapheme_Extend"
    21 -> "Other_ID_Continue"
    22 -> "Other_ID_Start"
    23 -> "Other_Lowercase"
    24 -> "Other_Math"
    25 -> "Other_Uppercase"
    26 -> "Pattern_Syntax"
    27 -> "Pattern_White_Space"
    28 -> "Prepended_Concatenation_Mark"
    29 -> "Quotation_Mark"
    30 -> "Radical"
    31 -> "Regional_Indicator"
    32 -> "STerm"
    33 -> "Sentence_Terminal"
    34 -> "Soft_Dotted"
    35 -> "Terminal_Punctuation"
    36 -> "Unified_Ideograph"
    37 -> "Variation_Selector"
    38 -> "White_Space"
    other -> ""

  -- | Collect the catalog keys in sorted order with bounded traversal stack.
  unicode-property-names-from :: Nat -> List String -> List String
  unicode-property-names-from count out = if count > 0 && count <= 39 then
    let index = count - 1 in let key = unicode-property-key (wrapping-i64-to-u32 (nat-to-i64 index)) in
    unicode-property-names-from index (Cons key out)
    else out

  -- | Observe every unicode-property key without exposing or copying range-table storage.
  unicode-property-names :: Unit -> List String
  unicode-property-names unit = unicode-property-names-from 39 Nil

  -- | Resolve one exact immutable unicode-fold-category name without normalizing punctuation or case.
  unicode-fold-category :: String -> Option UnicodeRangeTable
  unicode-fold-category name =
    let order = string-compare name "Lu" in
    if lt-i64 order 0 then
      let order = string-compare name "Ll" in
      if lt-i64 order 0 then
        let order = string-compare name "L" in
        if lt-i64 order 0 then
          None
        else if eq-i64 order 0 then unicode-builtin-range-table 253
        else
          None
      else if eq-i64 order 0 then unicode-builtin-range-table 254
      else
        let order = string-compare name "Lt" in
        if lt-i64 order 0 then
          None
        else if eq-i64 order 0 then unicode-builtin-range-table 255
        else
