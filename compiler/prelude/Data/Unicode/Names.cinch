  -- | Collect the catalog keys in sorted order with bounded traversal stack.
  unicode-script-names-from :: Nat -> List String -> List String
  unicode-script-names-from count out = if count > 0 && count <= 174 then
    let index = count - 1 in let key = unicode-script-key (wrapping-i64-to-u32 (nat-to-i64 index)) in
    unicode-script-names-from index (Cons key out)
    else out

  -- | Observe every unicode-script key without exposing or copying range-table storage.
  unicode-script-names :: Unit -> List String
  unicode-script-names unit = unicode-script-names-from 174 Nil

  -- | Resolve one exact immutable unicode-property name without normalizing punctuation or case.
  unicode-property :: String -> Option UnicodeRangeTable
  unicode-property name =
    let order = string-compare name "Other_Default_Ignorable_Code_Point" in
    if lt-i64 order 0 then
      let order = string-compare name "IDS_Trinary_Operator" in
      if lt-i64 order 0 then
        let order = string-compare name "Diacritic" in
        if lt-i64 order 0 then
          let order = string-compare name "Dash" in
          if lt-i64 order 0 then
            let order = string-compare name "Bidi_Control" in
            if lt-i64 order 0 then
              let order = string-compare name "ASCII_Hex_Digit" in
              if lt-i64 order 0 then
                None
              else if eq-i64 order 0 then unicode-builtin-range-table 0
              else
                None
            else if eq-i64 order 0 then unicode-builtin-range-table 14
            else
              None
          else if eq-i64 order 0 then unicode-builtin-range-table 39
          else
            let order = string-compare name "Deprecated" in
            if lt-i64 order 0 then
              None
            else if eq-i64 order 0 then unicode-builtin-range-table 40
            else
              None
        else if eq-i64 order 0 then unicode-builtin-range-table 43
        else
          let order = string-compare name "Hyphen" in
          if lt-i64 order 0 then
            let order = string-compare name "Hex_Digit" in
            if lt-i64 order 0 then
              let order = string-compare name "Extender" in
              if lt-i64 order 0 then
                None
              else if eq-i64 order 0 then unicode-builtin-range-table 51
              else
                None
            else if eq-i64 order 0 then unicode-builtin-range-table 68
            else
              None
          else if eq-i64 order 0 then unicode-builtin-range-table 70
          else
            let order = string-compare name "IDS_Binary_Operator" in
            if lt-i64 order 0 then
              None
            else if eq-i64 order 0 then unicode-builtin-range-table 71
            else
              None
      else if eq-i64 order 0 then unicode-builtin-range-table 72
      else
        let order = string-compare name "Join_Control" in
        if lt-i64 order 0 then
          let order = string-compare name "ID_Compat_Math_Start" in
          if lt-i64 order 0 then
            let order = string-compare name "ID_Compat_Math_Continue" in
            if lt-i64 order 0 then
              let order = string-compare name "IDS_Unary_Operator" in
