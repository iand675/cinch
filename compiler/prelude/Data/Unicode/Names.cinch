  -- | Count the exact unicode-table catalog keys, including documented aliases.
  unicode-table-count :: Nat
  unicode-table-count = 262

  -- | Read one sorted immutable unicode-table key; invalid indices return None.
  unicode-table-name :: Nat -> Option String
  unicode-table-name index = if index < 262 then Some (unicode-table-key (wrapping-i64-to-u32 (nat-to-i64 index))) else None
  -- | Select a shared immutable unicode-table literal through bounded shallow pages.
  unicode-table-key :: U32 -> String
  unicode-table-key index =
    if lt-u32 index 64 then
      let local = wrapping-sub-u32 index 0 in unicode-table-keys-a local
    else if lt-u32 index 128 then
      let local = wrapping-sub-u32 index 64 in unicode-table-keys-b local
    else if lt-u32 index 192 then
      let local = wrapping-sub-u32 index 128 in unicode-table-keys-c local
    else if lt-u32 index 256 then
      let local = wrapping-sub-u32 index 192 in unicode-table-keys-d local
    else if lt-u32 index 320 then
      let local = wrapping-sub-u32 index 256 in unicode-table-keys-e local
    else ""

