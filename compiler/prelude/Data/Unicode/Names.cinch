  -- | Collect the catalog keys in sorted order with bounded traversal stack.
  unicode-table-names-from :: Nat -> List String -> List String
  unicode-table-names-from count out = if count > 0 && count <= 262 then
    let index = count - 1 in let key = unicode-table-key (wrapping-i64-to-u32 (nat-to-i64 index)) in
    unicode-table-names-from index (Cons key out)
    else out

  -- | Observe every unicode-table key without exposing or copying range-table storage.
  unicode-table-names :: Unit -> List String
  unicode-table-names unit = unicode-table-names-from 262 Nil

  -- | Resolve an exact standard category alias to its canonical abbreviated name.
  unicode-category-canonical :: String -> Option String
  unicode-category-canonical name =
    if name == "Cased_Letter" then Some "LC"
    else if name == "Close_Punctuation" then Some "Pe"
    else if name == "Combining_Mark" then Some "M"
    else if name == "Connector_Punctuation" then Some "Pc"
    else if name == "Control" then Some "Cc"
    else if name == "Currency_Symbol" then Some "Sc"
    else if name == "Dash_Punctuation" then Some "Pd"
    else if name == "Decimal_Number" then Some "Nd"
    else if name == "Enclosing_Mark" then Some "Me"
    else if name == "Final_Punctuation" then Some "Pf"
    else if name == "Format" then Some "Cf"
    else if name == "Initial_Punctuation" then Some "Pi"
    else if name == "Letter" then Some "L"
    else if name == "Letter_Number" then Some "Nl"
    else if name == "Line_Separator" then Some "Zl"
    else if name == "Lowercase_Letter" then Some "Ll"
    else if name == "Mark" then Some "M"
    else if name == "Math_Symbol" then Some "Sm"
    else if name == "Modifier_Letter" then Some "Lm"
    else if name == "Modifier_Symbol" then Some "Sk"
    else if name == "Nonspacing_Mark" then Some "Mn"
    else if name == "Number" then Some "N"
    else if name == "Open_Punctuation" then Some "Ps"
    else if name == "Other" then Some "C"
    else if name == "Other_Letter" then Some "Lo"
    else if name == "Other_Number" then Some "No"
    else if name == "Other_Punctuation" then Some "Po"
    else if name == "Other_Symbol" then Some "So"
    else if name == "Paragraph_Separator" then Some "Zp"
    else if name == "Private_Use" then Some "Co"
    else if name == "Punctuation" then Some "P"
    else if name == "Separator" then Some "Z"
    else if name == "Space_Separator" then Some "Zs"
    else if name == "Spacing_Mark" then Some "Mc"
    else if name == "Surrogate" then Some "Cs"
    else if name == "Symbol" then Some "S"
    else if name == "Titlecase_Letter" then Some "Lt"
    else if name == "Unassigned" then Some "Cn"
    else if name == "Uppercase_Letter" then Some "Lu"
    else if name == "cntrl" then Some "Cc"
    else if name == "digit" then Some "Nd"
    else if name == "punct" then Some "P"
    else None

  -- | Number of immutable category-alias observations.
  unicode-category-alias-count :: Nat
  unicode-category-alias-count = 42

  -- | Observe one sorted alias and its canonical category name; invalid indices return None.
  unicode-category-alias-at :: Nat -> Option (String, String)
  unicode-category-alias-at index =
    if index == 0 then Some ("Cased_Letter", "LC")
    else if index == 1 then Some ("Close_Punctuation", "Pe")
    else if index == 2 then Some ("Combining_Mark", "M")
    else if index == 3 then Some ("Connector_Punctuation", "Pc")
    else if index == 4 then Some ("Control", "Cc")
    else if index == 5 then Some ("Currency_Symbol", "Sc")
    else if index == 6 then Some ("Dash_Punctuation", "Pd")
    else if index == 7 then Some ("Decimal_Number", "Nd")
    else if index == 8 then Some ("Enclosing_Mark", "Me")
    else if index == 9 then Some ("Final_Punctuation", "Pf")
    else if index == 10 then Some ("Format", "Cf")
    else if index == 11 then Some ("Initial_Punctuation", "Pi")
    else if index == 12 then Some ("Letter", "L")
    else if index == 13 then Some ("Letter_Number", "Nl")
    else if index == 14 then Some ("Line_Separator", "Zl")
    else if index == 15 then Some ("Lowercase_Letter", "Ll")
    else if index == 16 then Some ("Mark", "M")
    else if index == 17 then Some ("Math_Symbol", "Sm")
    else if index == 18 then Some ("Modifier_Letter", "Lm")
    else if index == 19 then Some ("Modifier_Symbol", "Sk")
    else if index == 20 then Some ("Nonspacing_Mark", "Mn")
    else if index == 21 then Some ("Number", "N")
    else if index == 22 then Some ("Open_Punctuation", "Ps")
    else if index == 23 then Some ("Other", "C")
    else if index == 24 then Some ("Other_Letter", "Lo")
    else if index == 25 then Some ("Other_Number", "No")
    else if index == 26 then Some ("Other_Punctuation", "Po")
    else if index == 27 then Some ("Other_Symbol", "So")
    else if index == 28 then Some ("Paragraph_Separator", "Zp")
    else if index == 29 then Some ("Private_Use", "Co")
    else if index == 30 then Some ("Punctuation", "P")
    else if index == 31 then Some ("Separator", "Z")
    else if index == 32 then Some ("Space_Separator", "Zs")
    else if index == 33 then Some ("Spacing_Mark", "Mc")
    else if index == 34 then Some ("Surrogate", "Cs")
    else if index == 35 then Some ("Symbol", "S")
    else if index == 36 then Some ("Titlecase_Letter", "Lt")
    else if index == 37 then Some ("Unassigned", "Cn")
    else if index == 38 then Some ("Uppercase_Letter", "Lu")
    else if index == 39 then Some ("cntrl", "Cc")
    else if index == 40 then Some ("digit", "Nd")
    else if index == 41 then Some ("punct", "P")
    else None

  -- | Observe the primary category of any numeric Unicode code point; invalid or unassigned scripts return None.
  unicode-category-of-code :: I32 -> Option String
  unicode-category-of-code cp = if ge-i32 cp 0 && le-i32 cp 1114111 then
    let raw = wrapping-i32-to-u32 cp in let word = unicode-data-class raw in
    let index = wrapping-u64-to-u32 (bit-and-u64 word 31) in
    if lt-u32 index 30 then Some (primary-category-key index) else None
    else None
  -- | Select a shared immutable primary-category literal through bounded shallow pages.
  primary-category-key :: U32 -> String
  primary-category-key index =
    if lt-u32 index 64 then
      let local = wrapping-sub-u32 index 0 in primary-category-keys-a local
    else ""

  -- | One complete shallow page of immutable primary-category key literals.
  primary-category-keys-a :: U32 -> String
  primary-category-keys-a index = case index of
    0 -> "Cc"
    1 -> "Cf"
    2 -> "Cn"
    3 -> "Co"
    4 -> "Cs"
    5 -> "Ll"
    6 -> "Lm"
    7 -> "Lo"
    8 -> "Lt"
    9 -> "Lu"
    10 -> "Mc"
    11 -> "Me"
    12 -> "Mn"
    13 -> "Nd"
    14 -> "Nl"
    15 -> "No"
    16 -> "Pc"
    17 -> "Pd"
    18 -> "Pe"
    19 -> "Pf"
    20 -> "Pi"
    21 -> "Po"
    22 -> "Ps"
    23 -> "Sc"
    24 -> "Sk"
    25 -> "Sm"
    26 -> "So"
    27 -> "Zl"
    28 -> "Zp"
    29 -> "Zs"
    other -> ""

  -- | Observe the primary script of any numeric Unicode code point; invalid or unassigned scripts return None.
  unicode-script-of-code :: I32 -> Option String
  unicode-script-of-code cp = if ge-i32 cp 0 && le-i32 cp 1114111 then
    let raw = wrapping-i32-to-u32 cp in let word = unicode-data-class raw in
    let index = wrapping-u64-to-u32 (bit-and-u64 (wrapping-shr-u64 word 5) 255) in
    if lt-u32 index 174 then Some (primary-script-key index) else None
    else None
  -- | Select a shared immutable primary-script literal through bounded shallow pages.
  primary-script-key :: U32 -> String
  primary-script-key index =
    if lt-u32 index 64 then
      let local = wrapping-sub-u32 index 0 in primary-script-keys-a local
    else if lt-u32 index 128 then
      let local = wrapping-sub-u32 index 64 in primary-script-keys-b local
    else if lt-u32 index 192 then
      let local = wrapping-sub-u32 index 128 in primary-script-keys-c local
    else ""

