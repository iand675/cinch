  -- | Count the exact unicode-category catalog keys, including documented aliases.
  unicode-category-count :: Nat
  unicode-category-count = 38

  -- | Read one sorted immutable unicode-category key; invalid indices return None.
  unicode-category-name :: Nat -> Option String
  unicode-category-name index = if index < 38 then Some (unicode-category-key (wrapping-i64-to-u32 (nat-to-i64 index))) else None
  -- | Select a shared immutable unicode-category literal through bounded shallow pages.
  unicode-category-key :: U32 -> String
  unicode-category-key index =
    if lt-u32 index 64 then
      let local = wrapping-sub-u32 index 0 in unicode-category-keys-a local
    else ""

  -- | One complete shallow page of immutable unicode-category key literals.
  unicode-category-keys-a :: U32 -> String
  unicode-category-keys-a index = case index of
    0 -> "C"
    1 -> "Cc"
    2 -> "Cf"
    3 -> "Cn"
    4 -> "Co"
    5 -> "Cs"
    6 -> "L"
    7 -> "LC"
    8 -> "Ll"
    9 -> "Lm"
    10 -> "Lo"
    11 -> "Lt"
    12 -> "Lu"
    13 -> "M"
    14 -> "Mc"
    15 -> "Me"
    16 -> "Mn"
    17 -> "N"
    18 -> "Nd"
    19 -> "Nl"
    20 -> "No"
    21 -> "P"
    22 -> "Pc"
    23 -> "Pd"
    24 -> "Pe"
    25 -> "Pf"
    26 -> "Pi"
    27 -> "Po"
    28 -> "Ps"
    29 -> "S"
    30 -> "Sc"
    31 -> "Sk"
    32 -> "Sm"
    33 -> "So"
    34 -> "Z"
    35 -> "Zl"
    36 -> "Zp"
    37 -> "Zs"
    other -> ""

  -- | Collect the catalog keys in sorted order with bounded traversal stack.
  unicode-category-names-from :: Nat -> List String -> List String
  unicode-category-names-from count out = if count > 0 && count <= 38 then
    let index = count - 1 in let key = unicode-category-key (wrapping-i64-to-u32 (nat-to-i64 index)) in
    unicode-category-names-from index (Cons key out)
    else out

  -- | Observe every unicode-category key without exposing or copying range-table storage.
  unicode-category-names :: Unit -> List String
  unicode-category-names unit = unicode-category-names-from 38 Nil

