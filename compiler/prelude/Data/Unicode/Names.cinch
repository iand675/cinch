  -- | Count the exact unicode-script catalog keys, including documented aliases.
  unicode-script-count :: Nat
  unicode-script-count = 174

  -- | Read one sorted immutable unicode-script key; invalid indices return None.
  unicode-script-name :: Nat -> Option String
  unicode-script-name index = if index < 174 then Some (unicode-script-key (wrapping-i64-to-u32 (nat-to-i64 index))) else None
  -- | Select a shared immutable unicode-script literal through bounded shallow pages.
  unicode-script-key :: U32 -> String
  unicode-script-key index =
    if lt-u32 index 64 then
      let local = wrapping-sub-u32 index 0 in unicode-script-keys-a local
    else if lt-u32 index 128 then
      let local = wrapping-sub-u32 index 64 in unicode-script-keys-b local
    else if lt-u32 index 192 then
      let local = wrapping-sub-u32 index 128 in unicode-script-keys-c local
    else ""

  -- | One complete shallow page of immutable unicode-script key literals.
  unicode-script-keys-a :: U32 -> String
  unicode-script-keys-a index = case index of
