  -- One little-endian byte of an `I64` at shift `k` bits (the A6
  -- INTEGER column format, modules specification section 11).
  i64-le-byte :: I64 -> U32 -> Nat
  i64-le-byte x k = nat-from-i64 (bit-and-i64 (wrapping-shr-i64 x k) 255)

  -- The P31 text conversions of `F64` (compiler/runtime/src/text.rs;
  -- the `cinch.runtime.textF64*` intrinsics, nm-verified there):
  -- one float's shortest round-trip decimal text (scientific form)
  -- and the float one decimal spelling stands for (correctly
  -- rounded). A spelling that is not a decimal number takes the
  -- defined `MalformedDecimal` fault (exit 71).
  foreign import ccall "cinch.runtime.textF64ToDecimal" f64-to-decimal :: F64 -> Bytes
  foreign import ccall "cinch.runtime.textF64FromDecimal" f64-from-decimal :: Bytes -> F64

  -- The A6 column codec for integers (decision D65's covered set):
  -- 8 bytes little-endian.
  implicit instance Codec_I64 :: Codec I64 where
    encode x =
      let out = bytes-new 8 in
      let u0 = bytes-set out 0 (i64-le-byte x 0) in
      let u1 = bytes-set out 1 (i64-le-byte x 8) in
      let u2 = bytes-set out 2 (i64-le-byte x 16) in
      let u3 = bytes-set out 3 (i64-le-byte x 24) in
      let u4 = bytes-set out 4 (i64-le-byte x 32) in
      let u5 = bytes-set out 5 (i64-le-byte x 40) in
      let u6 = bytes-set out 6 (i64-le-byte x 48) in
      let u7 = bytes-set out 7 (i64-le-byte x 56) in
      out
    decode b =
      if bytes-len b == 8 then
        let d0 = nat-to-i64 (bytes-get b 0) in
        let d1 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 1)) 8 in
        let d2 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 2)) 16 in
        let d3 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 3)) 24 in
        let d4 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 4)) 32 in
        let d5 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 5)) 40 in
        let d6 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 6)) 48 in
        let d7 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 7)) 56 in
        Some (bit-or-i64 d0 (bit-or-i64 d1 (bit-or-i64 d2 (bit-or-i64 d3
          (bit-or-i64 d4 (bit-or-i64 d5 (bit-or-i64 d6 d7)))))))
      else None

  -- The A6 JSON column codec for integers (decision D65's covered
  -- set): `JsonCodec`'s round-trip law (`decode-json (encode-json x)`
  -- is `Ok x`), with the named range error.
  implicit instance JsonCodec_I64 :: JsonCodec I64 where
    encode-json x = JNum (int-from-i64 x)
    decode-json j = case j of
      JNum n ->
        if lt-i64 (int-cmp n (int-from-i64 (min-bound-i64))) 0 then Err (OutOfRange "I64")
        else if lt-i64 0 (int-cmp n (int-from-i64 (max-bound-i64))) then Err (OutOfRange "I64")
        else Ok (int-to-i64 n)
      _ -> Err (TypeMismatch "integer")
