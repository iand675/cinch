  -- Primitive types specification, section 4: integer arithmetic for
  -- every machine integer type. Overflow behavior is never implicit:
  -- `checked` returns Option and never the wrapped value, `wrapping` is
  -- two's complement wrap, `saturating` clamps to the bounds. There is
  -- no Add/Sub/Mul/Neg instance for machine types: a class method has a
  -- single result type and cannot express which family is meant.

  -- I8 (8 bits).
  foreign import ccall "cinch.prim.minBoundI8" min-bound-i8 :: I8
  foreign import ccall "cinch.prim.maxBoundI8" max-bound-i8 :: I8
  foreign import ccall "cinch.prim.checkedAddI8" checked-add-i8 :: I8 -> I8 -> Option I8
  foreign import ccall "cinch.prim.checkedSubI8" checked-sub-i8 :: I8 -> I8 -> Option I8
  foreign import ccall "cinch.prim.checkedMulI8" checked-mul-i8 :: I8 -> I8 -> Option I8
  foreign import ccall "cinch.prim.wrappingAddI8" wrapping-add-i8 :: I8 -> I8 -> I8
  foreign import ccall "cinch.prim.wrappingSubI8" wrapping-sub-i8 :: I8 -> I8 -> I8
  foreign import ccall "cinch.prim.wrappingMulI8" wrapping-mul-i8 :: I8 -> I8 -> I8
  foreign import ccall "cinch.prim.saturatingAddI8" saturating-add-i8 :: I8 -> I8 -> I8
  foreign import ccall "cinch.prim.saturatingSubI8" saturating-sub-i8 :: I8 -> I8 -> I8
  foreign import ccall "cinch.prim.saturatingMulI8" saturating-mul-i8 :: I8 -> I8 -> I8
  foreign import ccall "cinch.prim.checkedNegI8" checked-neg-i8 :: I8 -> Option I8
  foreign import ccall "cinch.prim.wrappingNegI8" wrapping-neg-i8 :: I8 -> I8
  foreign import ccall "cinch.prim.saturatingNegI8" saturating-neg-i8 :: I8 -> I8
  foreign import ccall "cinch.prim.checkedDivI8" checked-div-i8 :: I8 -> I8 -> Option I8
  foreign import ccall "cinch.prim.checkedRemI8" checked-rem-i8 :: I8 -> I8 -> Option I8
  foreign import ccall "cinch.prim.checkedShlI8" checked-shl-i8 :: I8 -> U32 -> Option I8
  foreign import ccall "cinch.prim.wrappingShlI8" wrapping-shl-i8 :: I8 -> U32 -> I8
