  implicit instance Eq_I8 :: Eq I8 where
    (==) x y = eq-i8 x y
    (/=) x y = ne-i8 x y

  implicit instance Ord_I8 :: Ord I8 where
    (<) x y = lt-i8 x y
    (<=) x y = le-i8 x y
    (>) x y = gt-i8 x y
    (>=) x y = ge-i8 x y

