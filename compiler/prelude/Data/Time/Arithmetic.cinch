-- Data.Time.Arithmetic: spans applied to dates, times and instants.
--
-- Adding a `Span` to a civil value, taking the `Span` between two
-- values, and rounding a value to a unit. The semantics are TC39
-- Temporal's (PlainDate, PlainDateTime, PlainTime and Instant: `add`,
-- `subtract`, `until`, `since`, `round`) as rendered by Jiff; the
-- algorithms themselves live in Data.Time.Span (the engine, which the
-- anchored span operations share) and this module gives them their
-- everyday names, defaults and option values. Zoned arithmetic is
-- Data.Time.Zoned.Arithmetic (lane F).
--
-- Design law shape.
--   - Adding (`date-add-span`, `datetime-add-span`). Units are applied
--     largest first: years and months move the month exactly and
--     constrain the day to the target month's length
--     (2024-05-31 + 1 month = 2024-06-30; 2025-01-31 + 1 month =
--     2025-02-28), then weeks and days, then the clock units, a civil
--     day being 24 hours. A `Date` has no time of day: the clock units
--     of a span added to a date are balanced into whole days, truncated
--     toward zero, and the rest is dropped (PlainDate.prototype.add).
--     `-sub-span` adds the negated span. Adding a span and then
--     subtracting it does NOT always return the start
--     (2024-05-31 + 1 month - 1 month = 2024-05-30): the day was
--     constrained on the way out.
--   - `time-add-span-wrapping` wraps around midnight and IGNORES the
--     span's calendar units (PlainTime.prototype.add: a whole number of
--     days cannot move a time of day).
--   - `timestamp-add-span` accepts clock units only: an instant has no
--     calendar, so a span with a non-zero day or larger unit is
--     `Err SpanNeedsAnchor` (Instant.prototype.add). Convert through a
--     zone to add calendar units.
--   - Differences. `x-until a b` is the span from `a` to `b` (positive
--     when `b` is later) and `x-since a b` is the span since `b`,
--     measured to `a` (positive when `b` is earlier). The defaults are
--     Temporal's: the largest unit is `Day` for dates and date-times,
--     `Hour` for times of day and `Second` for timestamps; the smallest
--     is `Nanosecond` (`Day` for dates); the increment is 1 and the
--     mode `Trunc`. With the defaults `x-since a b` is
--     `span-negate (x-until a b)`, and `x-until a b` added to `a` is
--     `b`.
--     With a calendar largest unit the count is anchored at the FIRST
--     argument: the largest whole number of years, then months, that
--     added to `a` does not pass `b`, then the days left over. So
--     `until` and `add` are inverses from the start
--     (`a + (a until b) = b` whenever no rounding is asked for) but
--     not from the end: 2024-01-31 until 2024-03-01 with largest
--     `Month` is 1 month 1 day (January 31 plus one month is February
--     29, plus one day), while 2024-03-01 minus that span is
--     2024-01-31 only by luck of the month lengths, and
--     2024-03-31 until 2024-02-29 is -1 month although
--     2024-02-29 + 1 month is 2024-03-29.
--   - The `-with` forms take a `Difference` (T7): `with-largest`,
--     `with-smallest`, `with-increment`, `with-mode` over
--     `difference-default`. An unset largest unit is the larger of the
--     type's default and the smallest unit. Rounding to a calendar
--     smallest unit is relative to the first argument's calendar
--     (Temporal's RoundRelativeDuration). For `-since-with` the
--     rounding mode is negated before the difference is taken and the
--     result is negated after (so `Ceil` still means "toward positive
--     infinity" for the span returned), exactly as Temporal specifies.
--   - Rounding a value (`time-round`, `datetime-round`,
--     `timestamp-round`) takes a `Round`: smallest unit, increment,
--     mode, by default `Nanosecond`, 1, `HalfExpand`. The increment
--     must divide the next larger unit evenly and be smaller than it
--     (30 minutes, 6 hours; not 7 minutes, not 60 minutes); a
--     `DateTime` may be rounded to `Day` with increment 1, which can
--     carry into the date; a `TimeOfDay` rounded up at the end of the
--     day wraps to midnight; a `Timestamp`'s increment must divide a
--     24-hour day and it rounds on the number line whatever its sign
--     (`Trunc` is toward the past on both sides of the epoch).
--
-- No operation faults (T2). Additions answer `Option` (the one refusal
-- is leaving the range) except on timestamps, which have two; default
-- differences are total; everything with options answers
-- `Result SpanError`. This module has no error type of its own: its
-- refusals are the span's (`Data.Time.Span.SpanError`).
--
-- NAMED REFUSALS:
--   - the names `timestamp-until` / `timestamp-since`: taken by
--     Data.Time.Timestamp (lane A), where they answer a `Duration`.
--     The span forms are `timestamp-until-span` and
--     `timestamp-since-span`.
--   - `Unit`: the unit type is `TimeUnit` (see Data.Time.Unit).
--   - `Option` for value rounding: `time-round`, `datetime-round` and
--     `timestamp-round` answer `Result SpanError`, because besides the
--     range end there are two more refusals (a unit the value cannot be
--     rounded to, an invalid increment).
--   - one overloaded `until`: a difference's result class depends on
--     the operand type (`Span Calendar` for dates and date-times,
--     `Span Clock` for times and timestamps), so each type has its own
--     function.
module Data.Time.Arithmetic where

  import Data.Machine
  import Data.Wide
  import Data.Option
  import Data.Result
  import Data.Ordering
  import Algebra.Arithmetic
  import Relation.Eq
  import Relation.Ord
  import Data.Time.Unit
  import Data.Time.Duration
  import Data.Time.Timestamp
  import Data.Time.Span
  import Data.Time.Date (Date)
  import Data.Time.Date as D
  import Data.Time.TimeOfDay (TimeOfDay)
  import Data.Time.TimeOfDay as T
  import Data.Time.DateTime (DateTime)
  import Data.Time.DateTime as DT

  export date-add-span, date-sub-span
  export datetime-add-span, datetime-sub-span
  export time-add-span-wrapping, time-sub-span-wrapping
  export timestamp-add-span, timestamp-sub-span
  export Difference, difference-default, difference-largest
  export date-until, date-since, date-until-with, date-since-with
  export datetime-until, datetime-since, datetime-until-with, datetime-since-with
  export time-until, time-since, time-until-with, time-since-with
  export timestamp-until-span, timestamp-since-span
  export timestamp-until-span-with, timestamp-since-span-with
  export Round, round-default, round-to
  export time-round, datetime-round, timestamp-round


  -- -----------------------------------------------------------------
  -- Private plumbing.
  -- -----------------------------------------------------------------

  day-ns :: I128
  day-ns = 86400000000000

  -- Truncated remainder by the positive day length; the divisor
  -- excludes both `None` cases of the checked operation.
  rem-day :: I128 -> I128
  rem-day a = case checked-rem-i128 a day-ns of
    Some r -> r
    None -> 0

  -- -----------------------------------------------------------------
  -- Adding and subtracting spans.
  -- -----------------------------------------------------------------

  -- The date `s` after `x` (header: largest unit first, the day
  -- constrained, the clock units balanced into whole days). `None`
  -- when the result leaves -9999-01-01..=9999-12-31.
  date-add-span :: forall (c :: SpanClass). Span c -> Date -> Option Date
  date-add-span s x = span-add-to-date s x

  date-sub-span :: forall (c :: SpanClass). Span c -> Date -> Option Date
  date-sub-span s x = span-add-to-date (span-negate s) x

  -- The date-time `s` after `x`: 2024-02-01T17:30 plus 1 month 1 hour
  -- 30 minutes is 2024-03-01T19:00. `None` when the date leaves the
  -- range.
  datetime-add-span :: forall (c :: SpanClass). Span c -> DateTime -> Option DateTime
  datetime-add-span s x = span-add-to-datetime s x

  datetime-sub-span :: forall (c :: SpanClass). Span c -> DateTime -> Option DateTime
  datetime-sub-span s x = span-add-to-datetime (span-negate s) x

  -- The time of day `s` after `t`, wrapping around midnight. The
  -- span's calendar units (days and larger) are ignored, as Temporal
  -- specifies. Total.
  --
  -- The clock nanoseconds (below 1.3e21) are reduced modulo one day
  -- first, so the count handed to lane B's wrapping addition is within
  -- +-86399999999999 and the narrowing is exact.
  time-add-span-wrapping :: forall (c :: SpanClass). Span c -> TimeOfDay -> TimeOfDay
  time-add-span-wrapping s t = case T.add-nanos-wrapping (wrapping-i128-to-i64 (rem-day (span-time-nanos s))) t of
    (_, r) -> r

  time-sub-span-wrapping :: forall (c :: SpanClass). Span c -> TimeOfDay -> TimeOfDay
  time-sub-span-wrapping s t = time-add-span-wrapping (span-negate s) t

  -- The instant `s` after `t`. Only clock units are allowed
  -- (Instant.prototype.add).
  --   Err SpanNeedsAnchor  a day or larger unit of `s` is non-zero
  --   Err SpanOutOfRange   the result leaves the timestamp range
  timestamp-add-span :: forall (c :: SpanClass). Span c -> Timestamp -> Result SpanError Timestamp
  timestamp-add-span s t = case span-to-duration-checked s of
    None -> Err SpanNeedsAnchor
    Some d -> case timestamp-checked-add t d of
      None -> Err SpanOutOfRange
      Some r -> Ok r

  timestamp-sub-span :: forall (c :: SpanClass). Span c -> Timestamp -> Result SpanError Timestamp
  timestamp-sub-span s t = timestamp-add-span (span-negate s) t

  -- -----------------------------------------------------------------
  -- Difference options (T7).
  -- -----------------------------------------------------------------

  -- Largest unit (unset: the larger of the operand type's default and
  -- the smallest unit), smallest unit (unset: the operand type's
  -- default), increment, mode.
  data Difference where
    MkDifference :: Option TimeUnit -> Option TimeUnit -> I64 -> RoundMode -> Difference

  -- Both units unset, increment 1, `Trunc`.
  difference-default :: Difference
  difference-default = MkDifference None None 1 Trunc

  -- The common case: the default with a largest unit.
  difference-largest :: TimeUnit -> Difference
  difference-largest u = MkDifference (Some u) None 1 Trunc

  implicit instance LargestOption_Difference :: LargestOption Difference where
    with-largest u o = case o of
      MkDifference _ s i m -> MkDifference (Some u) s i m

  implicit instance RoundingOptions_Difference :: RoundingOptions Difference where
    with-smallest u o = case o of
      MkDifference l _ i m -> MkDifference l (Some u) i m
    with-increment n o = case o of
      MkDifference l s _ m -> MkDifference l s n m
    with-mode md o = case o of
      MkDifference l s i _ -> MkDifference l s i md

  -- The settings an operation works with after Temporal's
  -- GetDifferenceSettings.
  data Settings where
    MkSettings :: TimeUnit -> TimeUnit -> I64 -> RoundMode -> Settings

  in-group :: TimeUnit -> TimeUnit -> TimeUnit -> Bool
  in-group lo hi u = unit-rank u >= unit-rank lo && unit-rank u <= unit-rank hi

  -- GetDifferenceSettings. `lo..=hi` is the unit group the operand type
  -- allows, `fallback` its default smallest unit, `floor-largest` its
  -- default largest unit. `negate` is set for `since`.
  --   Err SpanBadUnits  a unit outside the group, or the largest unit
  --                     smaller than the smallest
  -- (The increment is validated by the engine, against the smallest
  -- unit.)
  settings :: Bool -> TimeUnit -> TimeUnit -> TimeUnit -> TimeUnit -> Difference -> Result SpanError Settings
  settings negate lo hi fallback floor-largest o = case o of
    MkDifference l s inc mode ->
      let smallest = case s of
                       Some u -> u
                       None -> fallback in
      let largest = case l of
                      Some u -> u
                      None -> unit-larger-of floor-largest smallest in
      if not (in-group lo hi smallest) || not (in-group lo hi largest) then Err SpanBadUnits
      else if unit-rank largest < unit-rank smallest then Err SpanBadUnits
      else Ok (MkSettings largest smallest inc (if negate then round-mode-negate mode else mode))

  negated :: forall (c :: SpanClass). Result SpanError (Span c) -> Result SpanError (Span c)
  negated r = case r of
    Err e -> Err e
    Ok s -> Ok (span-negate s)

  -- -----------------------------------------------------------------
  -- Dates.
  -- -----------------------------------------------------------------

  -- The days from `a` to `b`: 2024-02-01 until 2024-03-01 is 29 days.
  -- Total: the whole range is 7304483 days, inside the day limit, so
  -- the `None` arm is unreachable.
  date-until :: Date -> Date -> Span Calendar
  date-until a b = case span-with-days (D.diff-days a b) span-zero of
    Some s -> s
    None -> span-to-calendar span-zero

  -- The days since `b`, to `a`: the negation of `date-until a b`.
  date-since :: Date -> Date -> Span Calendar
  date-since a b = span-negate (date-until a b)

  date-difference :: Bool -> Difference -> Date -> Date -> Result SpanError (Span Calendar)
  date-difference negate o a b = case settings negate Day Year Day Day o of
    Err e -> Err e
    Ok st -> case st of
      MkSettings largest smallest inc mode ->
        span-difference-civil largest smallest inc mode (DT.from-date a) (DT.from-date b)

  -- The span from `a` to `b` under the options. Units are `Day` to
  -- `Year`; the default smallest unit is `Day`.
  -- 2024-05-31 until 2024-09-30 with largest `Month` is 3 months 30
  -- days.
  --   Err SpanBadUnits      a clock unit, or largest below smallest
  --   Err SpanBadIncrement  the increment is below 1 or above
  --                         1000000000
  --   Err SpanOutOfRange    a rounding candidate leaves the date range
  date-until-with :: Difference -> Date -> Date -> Result SpanError (Span Calendar)
  date-until-with o a b = date-difference False o a b

  date-since-with :: Difference -> Date -> Date -> Result SpanError (Span Calendar)
  date-since-with o a b = negated (date-difference True o a b)

  -- -----------------------------------------------------------------
  -- Date-times.
  -- -----------------------------------------------------------------

  -- The span from `a` to `b` in days and clock units, exact:
  -- 2024-05-15T14:30:54 until 2024-05-31T19:13:27.123456789 is 16 days
  -- 4 hours 42 minutes 33 seconds 123 ms 456 us 789 ns. Total: at most
  -- 7304483 days and less than a day of clock units, all inside their
  -- limits, and nothing is rounded, so the `Err` arm is unreachable.
  datetime-until :: DateTime -> DateTime -> Span Calendar
  datetime-until a b = case span-difference-civil Day Nanosecond 1 Trunc a b of
    Ok s -> s
    Err _ -> span-to-calendar span-zero

  datetime-since :: DateTime -> DateTime -> Span Calendar
  datetime-since a b = span-negate (datetime-until a b)

  datetime-difference :: Bool -> Difference -> DateTime -> DateTime -> Result SpanError (Span Calendar)
  datetime-difference negate o a b = case settings negate Nanosecond Year Nanosecond Day o of
    Err e -> Err e
    Ok st -> case st of
      MkSettings largest smallest inc mode -> span-difference-civil largest smallest inc mode a b

  -- The span from `a` to `b` under the options; every unit is allowed.
  --   Err SpanBadUnits      largest below smallest
  --   Err SpanBadIncrement  the increment is not valid for the
  --                         smallest unit
  --   Err SpanOutOfRange    a rounding candidate leaves the date range
  --   Err SpanUnitLimit     a unit of the result passes its limit
  datetime-until-with :: Difference -> DateTime -> DateTime -> Result SpanError (Span Calendar)
  datetime-until-with o a b = datetime-difference False o a b

  datetime-since-with :: Difference -> DateTime -> DateTime -> Result SpanError (Span Calendar)
  datetime-since-with o a b = negated (datetime-difference True o a b)

  -- -----------------------------------------------------------------
  -- Times of day.
  -- -----------------------------------------------------------------

  -- The span from `a` to `b` within one day, in hours and smaller;
  -- negative when `b` is the earlier time (no wrapping). Total: less
  -- than 24 hours, so the `Err` arm is unreachable.
  time-until :: TimeOfDay -> TimeOfDay -> Span Clock
  time-until a b = case span-difference-nanos Hour Nanosecond 1 Trunc (i64-to-i128 (T.diff-nanos a b)) of
    Ok s -> s
    Err _ -> span-zero

  time-since :: TimeOfDay -> TimeOfDay -> Span Clock
  time-since a b = span-negate (time-until a b)

  nanos-difference :: Bool -> TimeUnit -> Difference -> I128 -> Result SpanError (Span Clock)
  nanos-difference negate floor-largest o nanos = case settings negate Nanosecond Hour Nanosecond floor-largest o of
    Err e -> Err e
    Ok st -> case st of
      MkSettings largest smallest inc mode -> span-difference-nanos largest smallest inc mode nanos

  -- Units are `Nanosecond` to `Hour`; the default largest unit is
  -- `Hour`.
  --   Err SpanBadUnits      a calendar unit, or largest below smallest
  --   Err SpanBadIncrement  the increment is not valid for the
  --                         smallest unit
  time-until-with :: Difference -> TimeOfDay -> TimeOfDay -> Result SpanError (Span Clock)
  time-until-with o a b = nanos-difference False Hour o (i64-to-i128 (T.diff-nanos a b))

  time-since-with :: Difference -> TimeOfDay -> TimeOfDay -> Result SpanError (Span Clock)
  time-since-with o a b = negated (nanos-difference True Hour o (i64-to-i128 (T.diff-nanos a b)))

  -- -----------------------------------------------------------------
  -- Timestamps.
  -- -----------------------------------------------------------------

  -- The span from `a` to `b` in seconds and smaller (Temporal's default
  -- for instants). Total: the whole timestamp range is fewer than
  -- 631107417600 seconds, the second limit, so the `Err` arm is
  -- unreachable.
  timestamp-until-span :: Timestamp -> Timestamp -> Span Clock
  timestamp-until-span a b = case span-difference-nanos Second Nanosecond 1 Trunc (duration-total-nanos (timestamp-until a b)) of
    Ok s -> s
    Err _ -> span-zero

  timestamp-since-span :: Timestamp -> Timestamp -> Span Clock
  timestamp-since-span a b = span-negate (timestamp-until-span a b)

  -- Units are `Nanosecond` to `Hour`; the default largest unit is
  -- `Second`.
  --   Err SpanBadUnits      a calendar unit, or largest below smallest
  --   Err SpanBadIncrement  the increment is not valid for the
  --                         smallest unit
  --   Err SpanUnitLimit     a unit of the result passes its limit
  --                         (the whole range in nanoseconds does not
  --                         fit the nanosecond unit)
  timestamp-until-span-with :: Difference -> Timestamp -> Timestamp -> Result SpanError (Span Clock)
  timestamp-until-span-with o a b = nanos-difference False Second o (duration-total-nanos (timestamp-until a b))

  timestamp-since-span-with :: Difference -> Timestamp -> Timestamp -> Result SpanError (Span Clock)
  timestamp-since-span-with o a b = negated (nanos-difference True Second o (duration-total-nanos (timestamp-until a b)))

  -- -----------------------------------------------------------------
  -- Rounding values.
  -- -----------------------------------------------------------------

  -- Smallest unit, increment, mode.
  data Round where
    MkRound :: TimeUnit -> I64 -> RoundMode -> Round

  -- `Nanosecond`, 1, `HalfExpand`: rounds nothing until a unit is set.
  round-default :: Round
  round-default = MkRound Nanosecond 1 HalfExpand

  -- The common case: the default with a smallest unit.
  round-to :: TimeUnit -> Round
  round-to u = MkRound u 1 HalfExpand

  implicit instance RoundingOptions_Round :: RoundingOptions Round where
    with-smallest u o = case o of
      MkRound _ i m -> MkRound u i m
    with-increment n o = case o of
      MkRound s _ m -> MkRound s n m
    with-mode md o = case o of
      MkRound s i _ -> MkRound s i md

  -- The nanoseconds since midnight rounded to the options' quantum: a
  -- value in 0..=86400000000000 (RoundTime; the top value is "midnight
  -- of the next day"). `allow-day` admits `Day` with increment 1.
  --
  -- The quantum is at most one day and divides it, and the input is
  -- below one day, so the kernel cannot refuse; its `None` arm is
  -- mapped to a refusal anyway.
  round-of-day :: Bool -> Round -> TimeOfDay -> Result SpanError I128
  round-of-day allow-day o t = case o of
    MkRound unit inc mode ->
      if unit-is-calendar unit && not (allow-day && unit-eq unit Day) then Err SpanBadUnits
      else if not (unit-round-increment-ok unit inc) then Err SpanBadIncrement
      else
        let len = case unit-nanos unit of
                    Some n -> n
                    None -> day-ns in
        case round-i128 mode (wrapping-mul-i128 len (i64-to-i128 inc)) (i64-to-i128 (T.to-nanos-of-day t)) of
          None -> Err SpanUnitLimit
          Some r -> Ok r

  -- A rounded count of at most one day as a time of day: exactly one
  -- day wraps to midnight. The `None` arm is unreachable.
  wrapped-time :: I128 -> TimeOfDay
  wrapped-time r = case T.from-nanos-of-day (wrapping-i128-to-i64 (rem-day r)) of
    Some t -> t
    None -> T.midnight

  -- Round a time of day (PlainTime.prototype.round). Rounding up past
  -- the end of the day wraps to midnight: 23:59:40 to the minute is
  -- 00:00.
  --   Err SpanBadUnits      a calendar unit
  --   Err SpanBadIncrement  the increment does not divide the next
  --                         larger unit, or equals it
  time-round :: Round -> TimeOfDay -> Result SpanError TimeOfDay
  time-round o t = case round-of-day False o t of
    Err e -> Err e
    Ok r -> Ok (wrapped-time r)

  -- Round a date-time (PlainDateTime.prototype.round): the time of day
  -- is rounded and a carry moves the date, so
  -- 2024-11-02T17:46:20.123456789 to `Day` is 2024-11-03T00:00.
  --   Err SpanBadUnits      week or larger
  --   Err SpanBadIncrement  as for `time-round`; for `Day`, anything
  --                         but 1
  --   Err SpanOutOfRange    the carry leaves the date range
  datetime-round :: Round -> DateTime -> Result SpanError DateTime
  datetime-round o x = case round-of-day True o (DT.time-part x) of
    Err e -> Err e
    Ok r ->
      if lt-i128 r day-ns then Ok (DT.datetime (DT.date-part x) (wrapped-time r))
      else case D.tomorrow (DT.date-part x) of
        None -> Err SpanOutOfRange
        Some d -> Ok (DT.datetime d T.midnight)

  -- Round an instant (Instant.prototype.round). The increment, in its
  -- unit, must divide a 24-hour day evenly (it may equal it). The
  -- rounding is on the number line, the same on both sides of the
  -- epoch (RoundNumberToIncrementAsIfPositive).
  --   Err SpanBadUnits      a calendar unit
  --   Err SpanBadIncrement  the increment does not divide a day
  --   Err SpanOutOfRange    the rounded instant leaves the range
  --
  -- The quantum is at most 86400e9 and the count within +-3.8e20, so
  -- the kernel cannot refuse; its `None` arm is mapped to a refusal
  -- anyway.
  timestamp-round :: Round -> Timestamp -> Result SpanError Timestamp
  timestamp-round o t = case o of
    MkRound unit inc mode -> case unit-nanos unit of
      None -> Err SpanBadUnits
      Some len ->
        if not (unit-timestamp-increment-ok unit inc) then Err SpanBadIncrement
        else case round-i128-as-if-positive mode (wrapping-mul-i128 len (i64-to-i128 inc)) (timestamp-to-unix-nanos t) of
          None -> Err SpanUnitLimit
          Some r -> case timestamp-from-unix-nanos-i128 r of
            None -> Err SpanOutOfRange
            Some v -> Ok v
