-- Data.Time.Duration: an exact signed length of elapsed time
-- (design/datetime.md, layer L0 "machine time", lane A).
--
-- A `Duration` is a signed count of nanoseconds. It knows nothing of
-- calendars, zones or clocks: it is what `Monotonic - Monotonic` and
-- `Timestamp - Timestamp` are, and what a `Timestamp` moves by. The
-- representation constructor is not exported; the functions below are
-- the only way in, so the range invariant cannot be broken.
--
-- REPRESENTATION. One `I128` nanosecond count (`Data.Wide`) behind the
-- private constructor `MkDuration`. The scalar itself is unboxed (an
-- LLVM `i128` in locals, parameters and the constructor's payload),
-- so every operation is `i128` arithmetic and a compare is one `i128`
-- compare. The WRAPPER is not free today: a single-constructor `data`
-- is a 16-byte heap object (`cinch_alloc_ctor(16, 0)` in the emitted
-- IR), so each operation that returns a `Duration` allocates once.
-- See the named refusals.
--
-- RANGE. `-(2^127 - 1) ..= 2^127 - 1` nanoseconds (`min-duration`,
-- `max-duration`): the whole `I128` except its minimum. Dropping that
-- one value makes the range symmetric, which is what makes
-- `duration-neg`, `duration-abs` and both divisions total (the only
-- `I128` negation or division that overflows is the minimum's), at the
-- price of one refusal in `duration-from-i128-nanos`. About 5.39e21
-- years either way, so every unit constructor from an `I64` is total:
-- `|n| <= 2^63` and the largest unit is 3.6e12 < 2^42 nanoseconds, so
-- the product is below 2^105.
--
-- Design law shape. The nanosecond count is the value: two durations
-- are equal exactly when their counts are, and `duration-cmp` is the
-- integer order. `duration-zero` is the identity of `checked-add`;
-- `duration-neg` is an involution and `checked-add d (neg d)` is zero;
-- `checked-sub a b` is `checked-add a (neg b)`; `duration-abs` is
-- never negative. A `checked-` operation is `Some` of the exact
-- integer result when that lies in the range and `None` otherwise; the
-- `saturating-` twin is the exact result clamped to `min-duration` or
-- `max-duration`. Conversions to a coarser unit truncate toward zero
-- (`-1500 ms` is `-1 s`, as in Rust and Jiff), and
-- `whole-seconds * 10^9 + subsec-nanos` is the count again, so the
-- subsecond part carries the duration's sign. `duration-div` truncates
-- toward zero and `duration-div-floor` rounds toward negative
-- infinity. The checks are compiler/tests/lib_time_a.rs.
--
-- NAMED REFUSALS (boundaries this module deliberately does not
-- cross):
--   - operator instances for arithmetic (`+`, `-`, `*`): the name of
--     each operation states its overflow policy (T2), as for the
--     machine scalars; only `Eq` and `Ord` are instances.
--   - an allocation-free wrapper: `#[repr(transparent)]` over an
--     `I128` field is refused by code generation ("holds an `I128` or
--     `U128` value in a boundary-layout (`repr(C)`) field, which code
--     generation does not lower yet"), a transparent record is still a
--     heap object in native code, and a `record` exported by type name
--     can be built and projected by an importer, so it is not
--     abstract. The private `data` constructor is the nearest design:
--     abstract, one unboxed `i128` payload, one allocation per result.
--   - `I128`'s minimum: not a duration (see RANGE).
--   - calendar units (days and larger): a day is not a fixed number of
--     nanoseconds once a zone is involved; that is `Data.Time.Span`.
--   - floating-point seconds: no `F64` constructor or observer, since
--     neither is exact.
--   - `Int`/`Nat` (bignums): neither appears, in the representation or
--     the API.
--   - the millisecond `Effect.Clock.Duration`: the bridge lives in
--     `Effect.Time` (`to-clock-duration`, `from-clock-duration`) so
--     this module imports no effect vocabulary.
--
-- Naming. Every export is prefixed `duration-` (the bounds are
-- `min-duration`/`max-duration`, after `min-bound-i64`), because an
-- import clash is an error in Cinch and this module is imported beside
-- `Data.Time.Timestamp` and `Data.Time.Monotonic` unqualified.
--
-- Home (design/base-library.md): `Data.*` holds the concrete types, so
-- the `Eq`/`Ord` instances live with `Duration` here.
module Data.Time.Duration where

  import Algebra.Arithmetic
  import Data.Machine
  import Data.Wide
  import Data.Option
  import Data.Ordering
  import Relation.Eq
  import Relation.Ord

  export Duration
  export duration-zero, min-duration, max-duration
  export duration-from-nanos, duration-from-micros, duration-from-millis
  export duration-from-seconds, duration-from-minutes, duration-from-hours
  export duration-from-seconds-and-nanos
  export duration-from-i128-nanos, duration-saturating-from-i128-nanos
  export duration-total-nanos, duration-subsec-nanos
  export duration-to-nanos, duration-to-micros, duration-to-millis
  export duration-to-seconds, duration-to-minutes, duration-to-hours
  export duration-saturating-to-nanos, duration-saturating-to-micros
  export duration-saturating-to-millis, duration-saturating-to-seconds
  export duration-saturating-to-minutes, duration-saturating-to-hours
  export duration-is-zero, duration-is-negative, duration-is-positive
  export duration-neg, duration-abs
  export duration-checked-add, duration-checked-sub
  export duration-saturating-add, duration-saturating-sub
  export duration-checked-mul, duration-saturating-mul
  export duration-div, duration-div-floor
  export duration-cmp, duration-min-of, duration-max-of


  -- The nanosecond count. Not exported (the range invariant above).
  -- The constructor's name differs from the type's on purpose:
  -- `export Duration` exports the type AND a constructor of the same
  -- name, so a constructor called `Duration` would be public.
  data Duration where
    MkDuration :: I128 -> Duration

  -- -----------------------------------------------------------------
  -- Private helpers on the raw count.
  -- -----------------------------------------------------------------

  -- 2^127 - 1, `I128`'s maximum, and its negation (the range).
  hi :: I128
  hi = 170141183460469231731687303715884105727

  lo :: I128
  lo = -170141183460469231731687303715884105727

  -- An exact `I128` result as a duration: only `I128`'s minimum is
  -- outside the range.
  in-range :: I128 -> Option Duration
  in-range n = if lt-i128 n lo then None else Some (MkDuration n)

  -- A saturated `I128` result clamped into the range (the minimum
  -- becomes `min-duration`).
  clamp :: I128 -> Duration
  clamp n = if lt-i128 n lo then MkDuration lo else MkDuration n

  -- Truncating quotient by a divisor the caller knows is not zero. With
  -- a dividend in the range the quotient never overflows (the only
  -- overflowing `I128` division is minimum / -1), so `None` is
  -- unreachable; the arm exists because `Data.Wide` offers the checked
  -- division only.
  quot :: I128 -> I128 -> I128
  quot n d = case checked-div-i128 n d of
    Some q -> q
    None -> 0

  -- Truncating remainder, same argument as `quot`.
  remn :: I128 -> I128 -> I128
  remn n d = case checked-rem-i128 n d of
    Some r -> r
    None -> 0

  nanos-of :: Duration -> I128
  nanos-of d = case d of
    MkDuration n -> n

  -- `n` units of `unit` nanoseconds. Wrapping multiplication is exact
  -- here: `|n| <= 2^63` and `unit <= 3.6e12 < 2^42`, so the product's
  -- magnitude is below 2^105, inside the range.
  units :: I64 -> I128 -> Duration
  units n unit = MkDuration (wrapping-mul-i128 (i64-to-i128 n) unit)

  -- -----------------------------------------------------------------
  -- Bounds and construction.
  -- -----------------------------------------------------------------

  duration-zero :: Duration
  duration-zero = MkDuration 0

  -- -(2^127 - 1) nanoseconds.
  min-duration :: Duration
  min-duration = MkDuration lo

  -- 2^127 - 1 nanoseconds.
  max-duration :: Duration
  max-duration = MkDuration hi

  -- The unit constructors are total: every `I64` count of every unit
  -- is in the range (the header's RANGE argument).
  duration-from-nanos :: I64 -> Duration
  duration-from-nanos n = MkDuration (i64-to-i128 n)

  duration-from-micros :: I64 -> Duration
  duration-from-micros n = units n 1000

  duration-from-millis :: I64 -> Duration
  duration-from-millis n = units n 1000000

  duration-from-seconds :: I64 -> Duration
  duration-from-seconds n = units n 1000000000

  duration-from-minutes :: I64 -> Duration
  duration-from-minutes n = units n 60000000000

  duration-from-hours :: I64 -> Duration
  duration-from-hours n = units n 3600000000000

  -- `secs` seconds plus `nanos` nanoseconds, any signs (the two parts
  -- are added, so `(-1, 999999999)` is -1 ns). Total: the seconds term
  -- is below 2^93 and the nanosecond term below 2^63, so the wrapping
  -- sum is exact.
  duration-from-seconds-and-nanos :: I64 -> I64 -> Duration
  duration-from-seconds-and-nanos secs nanos =
    MkDuration (wrapping-add-i128 (wrapping-mul-i128 (i64-to-i128 secs) 1000000000) (i64-to-i128 nanos))

  -- A raw nanosecond count: `None` for `I128`'s minimum only.
  duration-from-i128-nanos :: I128 -> Option Duration
  duration-from-i128-nanos n = in-range n

  -- The same, with the minimum clamped to `min-duration`.
  duration-saturating-from-i128-nanos :: I128 -> Duration
  duration-saturating-from-i128-nanos n = clamp n

  -- -----------------------------------------------------------------
  -- Observation.
  -- -----------------------------------------------------------------

  -- The whole count, exactly.
  duration-total-nanos :: Duration -> I128
  duration-total-nanos d = nanos-of d

  -- The part below one second, with the duration's sign:
  -- `-999999999..=999999999`, and zero or the sign of the duration.
  -- The remainder of an `I128` by 10^9 is in that interval, so the
  -- wrapping narrowing is exact; the guard restates the bound for the
  -- checker (a wide scalar has no solver sort) and its `else` arm is
  -- unreachable.
  duration-subsec-nanos :: Duration -> InRange (-999999999) 999999999 I64
  duration-subsec-nanos d =
    let x = wrapping-i128-to-i64 (remn (nanos-of d) 1000000000) in
    if -999999999 <= x && x <= 999999999 then x else 0

  -- The count in a coarser unit, truncated toward zero, when it fits
  -- an `I64`.
  to-unit :: Duration -> I128 -> Option I64
  to-unit d unit = checked-i128-to-i64 (quot (nanos-of d) unit)

  -- The same, clamped to the `I64` bounds.
  saturating-to-unit :: Duration -> I128 -> I64
  saturating-to-unit d unit = saturating-i128-to-i64 (quot (nanos-of d) unit)

  -- `None` outside `I64` (about 292 years of nanoseconds).
  duration-to-nanos :: Duration -> Option I64
  duration-to-nanos d = checked-i128-to-i64 (nanos-of d)

  duration-to-micros :: Duration -> Option I64
  duration-to-micros d = to-unit d 1000

  duration-to-millis :: Duration -> Option I64
  duration-to-millis d = to-unit d 1000000

  -- The whole seconds (truncated toward zero; pair with
  -- `duration-subsec-nanos`).
  duration-to-seconds :: Duration -> Option I64
  duration-to-seconds d = to-unit d 1000000000

  duration-to-minutes :: Duration -> Option I64
  duration-to-minutes d = to-unit d 60000000000

  duration-to-hours :: Duration -> Option I64
  duration-to-hours d = to-unit d 3600000000000

  duration-saturating-to-nanos :: Duration -> I64
  duration-saturating-to-nanos d = saturating-i128-to-i64 (nanos-of d)

  duration-saturating-to-micros :: Duration -> I64
  duration-saturating-to-micros d = saturating-to-unit d 1000

  duration-saturating-to-millis :: Duration -> I64
  duration-saturating-to-millis d = saturating-to-unit d 1000000

  duration-saturating-to-seconds :: Duration -> I64
  duration-saturating-to-seconds d = saturating-to-unit d 1000000000

  duration-saturating-to-minutes :: Duration -> I64
  duration-saturating-to-minutes d = saturating-to-unit d 60000000000

  duration-saturating-to-hours :: Duration -> I64
  duration-saturating-to-hours d = saturating-to-unit d 3600000000000

  duration-is-zero :: Duration -> Bool
  duration-is-zero d = eq-i128 (nanos-of d) 0

  duration-is-negative :: Duration -> Bool
  duration-is-negative d = lt-i128 (nanos-of d) 0

  duration-is-positive :: Duration -> Bool
  duration-is-positive d = gt-i128 (nanos-of d) 0

  -- -----------------------------------------------------------------
  -- Arithmetic.
  -- -----------------------------------------------------------------

  -- Total: the range is symmetric, so the wrapping negation is exact
  -- and stays in the range.
  duration-neg :: Duration -> Duration
  duration-neg d = MkDuration (wrapping-neg-i128 (nanos-of d))

  -- Total, by the same argument.
  duration-abs :: Duration -> Duration
  duration-abs d = if lt-i128 (nanos-of d) 0 then duration-neg d else d

  duration-checked-add :: Duration -> Duration -> Option Duration
  duration-checked-add a b = case checked-add-i128 (nanos-of a) (nanos-of b) of
    Some n -> in-range n
    None -> None

  duration-checked-sub :: Duration -> Duration -> Option Duration
  duration-checked-sub a b = case checked-sub-i128 (nanos-of a) (nanos-of b) of
    Some n -> in-range n
    None -> None

  duration-saturating-add :: Duration -> Duration -> Duration
  duration-saturating-add a b = clamp (saturating-add-i128 (nanos-of a) (nanos-of b))

  duration-saturating-sub :: Duration -> Duration -> Duration
  duration-saturating-sub a b = clamp (saturating-sub-i128 (nanos-of a) (nanos-of b))

  -- The duration `k` times over.
  duration-checked-mul :: Duration -> I64 -> Option Duration
  duration-checked-mul d k = case checked-mul-i128 (nanos-of d) (i64-to-i128 k) of
    Some n -> in-range n
    None -> None

  duration-saturating-mul :: Duration -> I64 -> Duration
  duration-saturating-mul d k = clamp (saturating-mul-i128 (nanos-of d) (i64-to-i128 k))

  -- One `k`th of the duration, truncated toward zero. Total: the
  -- divisor is not zero by its type and the quotient's magnitude never
  -- exceeds the dividend's.
  duration-div :: Duration -> NonZero I64 -> Duration
  duration-div d k = MkDuration (quot (nanos-of d) (i64-to-i128 (unrefine k)))

  -- One `k`th of the duration, rounded toward negative infinity: the
  -- truncated quotient, less one when the division is inexact and the
  -- exact quotient is negative (remainder and divisor of opposite
  -- signs). The decrement cannot leave the range: an inexact division
  -- has `|k| >= 2`, so the quotient's magnitude is at most 2^126.
  duration-div-floor :: Duration -> NonZero I64 -> Duration
  duration-div-floor d k =
    let w = i64-to-i128 (unrefine k) in
    let q = quot (nanos-of d) w in
    let r = remn (nanos-of d) w in
    if eq-i128 r 0 then MkDuration q
    else if lt-i128 r 0 == lt-i128 w 0 then MkDuration q
    else MkDuration (wrapping-sub-i128 q 1)

  -- -----------------------------------------------------------------
  -- Order.
  -- -----------------------------------------------------------------

  duration-cmp :: Duration -> Duration -> Ordering
  duration-cmp a b =
    if lt-i128 (nanos-of a) (nanos-of b) then LT
    else if gt-i128 (nanos-of a) (nanos-of b) then GT
    else EQ

  -- The shorter (more negative) of two durations.
  duration-min-of :: Duration -> Duration -> Duration
  duration-min-of a b = if le-i128 (nanos-of a) (nanos-of b) then a else b

  -- The longer (more positive) of two durations.
  duration-max-of :: Duration -> Duration -> Duration
  duration-max-of a b = if ge-i128 (nanos-of a) (nanos-of b) then a else b

  -- Instances (the class spellings of the integer order; instances
  -- live with their type per design/base-library.md).
  implicit instance Eq_Duration :: Eq Duration where
    (==) a b = eq-i128 (nanos-of a) (nanos-of b)
    (/=) a b = ne-i128 (nanos-of a) (nanos-of b)

  implicit instance Ord_Duration :: Ord Duration where
    (<) a b = lt-i128 (nanos-of a) (nanos-of b)
    (<=) a b = le-i128 (nanos-of a) (nanos-of b)
    (>) a b = gt-i128 (nanos-of a) (nanos-of b)
    (>=) a b = ge-i128 (nanos-of a) (nanos-of b)
