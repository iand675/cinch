-- Data.Bool: the booleans and their strict operations.
--
-- `Bool` is a core runtime type; the `cinch.prim.*Bool` foreign
-- imports are the machine operations. `&&` and `||` are strict
-- functions in the bootstrap slice; the surface short-circuiting form
-- lands with the effects correction (primitive types specification
-- section 6).
--
-- Module scheme (design/base-library.md): the type's home carries its
-- instance family, including the `Text.Codec` instance (the A6
-- codec generator's BOOLEAN column is exactly one byte, 0 or 1).
module Data.Bool where

  import Text.Codec
  import Data.Hash

  infixr 2 &&
  infixr 1 ||

  export prim-eq-bool, prim-ne-bool, prim-not-bool, prim-and-bool, prim-or-bool, not, and, or, xor, bool, (&&), (||)


  foreign import ccall "cinch.prim.eqBool" prim-eq-bool :: Bool -> Bool -> Bool
  foreign import ccall "cinch.prim.neBool" prim-ne-bool :: Bool -> Bool -> Bool
  foreign import ccall "cinch.prim.notBool" prim-not-bool :: Bool -> Bool
  foreign import ccall "cinch.prim.andBool" prim-and-bool :: Bool -> Bool -> Bool
  foreign import ccall "cinch.prim.orBool" prim-or-bool :: Bool -> Bool -> Bool

  -- These are strict functions in the bootstrap slice; the surface `&&`
  -- and `||` short-circuit once that deviation is corrected (primitive
  -- types specification, section 6).
  (&&) :: Bool -> Bool -> Bool
  (&&) x y = prim-and-bool x y

  (||) :: Bool -> Bool -> Bool
  (||) x y = prim-or-bool x y

  not :: Bool -> Bool
  not b = prim-not-bool b

  -- The strict boolean algebra (primitive types specification, section 6).
  and :: Bool -> Bool -> Bool
  and x y = prim-and-bool x y

  or :: Bool -> Bool -> Bool
  or x y = prim-or-bool x y

  xor :: Bool -> Bool -> Bool
  xor x y = prim-and-bool (prim-or-bool x y) (prim-not-bool (prim-and-bool x y))

  -- The boolean fold: `bool f t b` is `t` when `b` is `True` and `f`
  -- otherwise (`Data.Bool.bool`), the elimination form matching the
  -- constructors' order.
  bool :: forall a. a -> a -> Bool -> a
  bool f t b = if b then t else f

  implicit instance Eq_Bool :: Eq Bool where
    (==) x y = prim-eq-bool x y
    (/=) x y = prim-ne-bool x y

  implicit instance Ord_Bool :: Ord Bool where
    (<) x y = prim-and-bool (prim-not-bool x) y
    (<=) x y = prim-not-bool (prim-and-bool (prim-not-bool y) x)
    (>) x y = prim-and-bool (prim-not-bool y) x
    (>=) x y = prim-not-bool (prim-and-bool (prim-not-bool x) y)

  -- The A6 column codec for booleans (modules specification section
  -- 11's `CodecGenerator.derive` vocabulary, decision D65's covered
  -- set): one byte, 0 for False and 1 for True.
  implicit instance Codec_Bool :: Codec Bool where
    encode b =
      let out = bytes-new 1 in
      let u = bytes-set out 0 (if b then 1 else 0) in
      out
    decode b =
      if bytes-len b == 1 then
        let x = bytes-get b 0 in
        if x == 0 then Some False
        else if x == 1 then Some True
        else None
      else None

  -- The A6 JSON column codec for booleans (decision D65's covered
  -- set): `JsonCodec`'s round-trip law (`decode-json (encode-json x)`
  -- is `Ok x`).
  implicit instance JsonCodec_Bool :: JsonCodec Bool where
    encode-json b = JBool b
    decode-json j = case j of
      JBool b -> Ok b
      _ -> Err (TypeMismatch "boolean")

  -- Two buckets (instances live with their type).
  implicit instance Hash_Bool :: Hash Bool where
    hash b = if b then 1 else 0
