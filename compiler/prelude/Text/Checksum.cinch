-- | Incremental Adler-32, CRC-32 and CRC-64 checksums over byte buffers.
-- Updates accept finished checksums: updating the checksum of a prefix with a
-- suffix equals checksumming their concatenation. Start Adler-32 at 1 and CRCs
-- at 0. Polynomial arguments use reflected representations. Adler-32 reduces
-- sixteen SIMD byte lanes at once; CRCs consume native eight-byte blocks.
-- CRC-32C uses an ISA instruction after CPU feature detection on x86. AArch64
-- profiles with ArmCrc32 accelerate both IEEE and Castagnoli. Other cases use portable
-- inline LLVM shift registers. These checksums do not authenticate messages.
module Text.Checksum where

  import Data.Bytes
  import Data.Bytes.Word
  import Data.Machine
  import Data.Nat

  export adler32-sum, adler32-update
  export crc32-sum, crc32-with, crc32-update
  export crc32-ieee, crc32-castagnoli, crc32-koopman
  export crc64-sum, crc64-update, crc64-iso, crc64-ecma
  export ArmCrc32

  -- | Target-profile evidence that AArch64 CRC instructions may execute.
  -- Only profiles that guarantee the CRC extension should name this capability.
  signature ArmCrc32 where
    -- | Marker carried by target evidence; checksum callers need no dictionary.
    arm-crc32-evidence :: Unit -> Unit

  -- | Compute Adler-32 over all input bytes, starting at the standard state 1. The empty checksum is 1.
  adler32-sum :: Bytes -> U32
  adler32-sum b = adler32-update 1 b

  -- | Continue a finished Adler-32 checksum with another chunk. Empty input preserves the supplied state.
  adler32-update :: U32 -> Bytes -> U32
  adler32-update previous b =
    let n = u32-to-nat previous in
    adler-from b 0 (nat-rem n 65536) (nat-div n 65536)

  -- | Advance the two reduced sums with sixteen-byte SIMD blocks, then scalar tail bytes. The weighted reduction includes the prior low sum sixteen times.
  adler-from :: Bytes -> Nat -> Nat -> Nat -> U32
  adler-from b i lo hi =
    if i + 16 <= bytes-len b then
      let sums = adler16 (bytes-read-le64 b i) (bytes-read-le64 b (i + 8)) in
      let total = u32-to-nat (wrapping-u64-to-u32 sums) in
      let weighted = u32-to-nat (wrapping-u64-to-u32 (wrapping-shr-u64 sums 32)) in
      adler-from b (i + 16) (nat-rem (lo + total) 65521) (nat-rem (hi + 16 * lo + weighted) 65521)
    else if i < bytes-len b then
      let next = nat-rem (lo + bytes-get b i) 65521 in
      adler-from b (i + 1) next (nat-rem (hi + next) 65521)
    else wrapping-i64-to-u32 (nat-to-i64 (nat-rem (hi * 65536 + lo) 4294967296))

  -- | The reflected IEEE CRC-32 polynomial, 0xEDB88320.
  crc32-ieee :: U32
  crc32-ieee = 0xEDB88320

  -- | The reflected Castagnoli CRC-32C polynomial, 0x82F63B78.
  crc32-castagnoli :: U32
  crc32-castagnoli = 0x82F63B78

  -- | The reflected Koopman CRC-32 polynomial, 0xEB31D82E.
  crc32-koopman :: U32
  crc32-koopman = 0xEB31D82E

  -- | Compute the IEEE CRC-32 checksum. The empty checksum is zero.
  crc32-sum :: Bytes -> U32
  crc32-sum b = crc32-with crc32-ieee b

  -- | Compute CRC-32 with the supplied reflected polynomial, starting from the finished state zero.
  crc32-with :: U32 -> Bytes -> U32
  crc32-with poly b = crc32-update poly 0 b

  -- | Continue a finished CRC-32 with another chunk. Arguments are reflected polynomial, previous checksum, and bytes; initial/final complementing is internal.
  crc32-update :: U32 -> U32 -> Bytes -> U32
  crc32-update poly previous b =
    if eq-u32 poly crc32-castagnoli && bytes-len b >= 8 && ne-u32 (crc32c-available 0) 0 then
      bit-not-u32 (crc32c-from b 0 (bit-not-u32 previous))
    else if eq-u32 poly crc32-ieee && bytes-len b >= 8 && ne-u32 (crc32-ieee-available 0) 0 then
      bit-not-u32 (crc32-ieee-from b 0 (bit-not-u32 previous))
    else bit-not-u32 (crc32-from poly b 0 (bit-not-u32 previous))

  -- | Consume complete eight-byte native shift-register blocks and then scalar bytes, without reading past the buffer.
  crc32-from :: U32 -> Bytes -> Nat -> U32 -> U32
  crc32-from poly b i acc =
    if i + 8 <= bytes-len b then crc32-from poly b (i + 8) (crc32-word acc (bytes-read-le64 b i) poly)
    else if i < bytes-len b then
      let v = wrapping-i64-to-u32 (nat-to-i64 (bytes-get b i)) in
      crc32-from poly b (i + 1) (crc32-bits poly (bit-xor-u32 acc v) 8)
    else acc

  -- | Advance one scalar byte through eight reflected polynomial steps.
  crc32-bits :: U32 -> U32 -> Nat -> U32
  crc32-bits poly acc n =
    if n == 0 then acc
    else if eq-u32 (bit-and-u32 acc 1) 1 then crc32-bits poly (bit-xor-u32 (wrapping-shr-u32 acc 1) poly) (n - 1)
    else crc32-bits poly (wrapping-shr-u32 acc 1) (n - 1)

  -- | The reflected ISO CRC-64 polynomial, 0xD800000000000000.
  crc64-iso :: U64
  crc64-iso = 0xD800000000000000

  -- | The reflected ECMA CRC-64 polynomial, 0xC96C5795D7870F42.
  crc64-ecma :: U64
  crc64-ecma = 0xC96C5795D7870F42

  -- | Compute CRC-64 with the supplied reflected polynomial. The empty checksum is zero.
  crc64-sum :: U64 -> Bytes -> U64
  crc64-sum poly b = crc64-update poly 0 b

  -- | Continue a finished CRC-64. Arguments are reflected polynomial, previous checksum, and bytes; an empty update preserves the checksum.
  crc64-update :: U64 -> U64 -> Bytes -> U64
  crc64-update poly previous b = bit-not-u64 (crc64-from poly b 0 (bit-not-u64 previous))

  -- | Consume complete eight-byte native shift-register blocks before handling the exact scalar tail.
  crc64-from :: U64 -> Bytes -> Nat -> U64 -> U64
  crc64-from poly b i acc =
    if i + 8 <= bytes-len b then crc64-from poly b (i + 8) (crc64-word acc (bytes-read-le64 b i) poly)
    else if i < bytes-len b then
      let v = wrapping-i64-to-u64 (nat-to-i64 (bytes-get b i)) in
      crc64-from poly b (i + 1) (crc64-bits poly (bit-xor-u64 acc v) 8)
    else acc

  -- | Advance one scalar byte through eight reflected 64-bit polynomial steps.
  crc64-bits :: U64 -> U64 -> Nat -> U64
  crc64-bits poly acc n =
    if n == 0 then acc
    else if eq-u64 (bit-and-u64 acc 1) 1 then crc64-bits poly (bit-xor-u64 (wrapping-shr-u64 acc 1) poly) (n - 1)
    else crc64-bits poly (wrapping-shr-u64 acc 1) (n - 1)

  -- | Reduce sixteen byte lanes to their sum and descending weighted sum; each fits in 32 bits.
  prim adler16 :: U64 -> U64 -> U64 where
    llvm {
      %in0 = or i64 %0, 0
      %in1 = or i64 %1, 0
      %a = bitcast i64 %in0 to <8 x i8>
      %b = bitcast i64 %in1 to <8 x i8>
      %bytes = shufflevector <8 x i8> %a, <8 x i8> %b, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
      %wide = zext <16 x i8> %bytes to <16 x i32>
      %weighted = mul <16 x i32> %wide, <i32 16, i32 15, i32 14, i32 13, i32 12, i32 11, i32 10, i32 9, i32 8, i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1>
      %sum = call i32 @llvm.vector.reduce.add.v16i32(<16 x i32> %wide)
      %weight = call i32 @llvm.vector.reduce.add.v16i32(<16 x i32> %weighted)
      %lo = zext i32 %sum to i64
      %hi = zext i32 %weight to i64
      %hs = shl i64 %hi, 32
      %result = or i64 %lo, %hs
      ret i64 %result
    } when endian little
    llvm {
      %in0 = call i64 @llvm.bswap.i64(i64 %0)
      %in1 = call i64 @llvm.bswap.i64(i64 %1)
      %a = bitcast i64 %in0 to <8 x i8>
      %b = bitcast i64 %in1 to <8 x i8>
      %bytes = shufflevector <8 x i8> %a, <8 x i8> %b, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
      %wide = zext <16 x i8> %bytes to <16 x i32>
      %weighted = mul <16 x i32> %wide, <i32 16, i32 15, i32 14, i32 13, i32 12, i32 11, i32 10, i32 9, i32 8, i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1>
      %sum = call i32 @llvm.vector.reduce.add.v16i32(<16 x i32> %wide)
      %weight = call i32 @llvm.vector.reduce.add.v16i32(<16 x i32> %weighted)
      %lo = zext i32 %sum to i64
      %hi = zext i32 %weight to i64
      %hs = shl i64 %hi, 32
      %result = or i64 %lo, %hs
      ret i64 %result
    } when endian big

  -- | Advance a reflected CRC through eight packed bytes using a native shift register.
  prim crc32-word :: U32 -> U64 -> U32 -> U32 where
    llvm {
      %seed = zext i32 %0 to i64
      %poly = zext i32 %2 to i64
      %start = xor i64 %seed, %1
      %bit0 = and i64 %start, 1
      %set0 = icmp ne i64 %bit0, 0
      %shift0 = lshr i64 %start, 1
      %mask0 = select i1 %set0, i64 %poly, i64 0
      %r0 = xor i64 %shift0, %mask0
      %bit1 = and i64 %r0, 1
      %set1 = icmp ne i64 %bit1, 0
      %shift1 = lshr i64 %r0, 1
      %mask1 = select i1 %set1, i64 %poly, i64 0
      %r1 = xor i64 %shift1, %mask1
      %bit2 = and i64 %r1, 1
      %set2 = icmp ne i64 %bit2, 0
      %shift2 = lshr i64 %r1, 1
      %mask2 = select i1 %set2, i64 %poly, i64 0
      %r2 = xor i64 %shift2, %mask2
      %bit3 = and i64 %r2, 1
      %set3 = icmp ne i64 %bit3, 0
      %shift3 = lshr i64 %r2, 1
      %mask3 = select i1 %set3, i64 %poly, i64 0
      %r3 = xor i64 %shift3, %mask3
      %bit4 = and i64 %r3, 1
      %set4 = icmp ne i64 %bit4, 0
      %shift4 = lshr i64 %r3, 1
      %mask4 = select i1 %set4, i64 %poly, i64 0
