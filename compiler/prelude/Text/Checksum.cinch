  -- | Detect the x86 CRC instruction before entering its block loop. Other
  -- architectures use the portable kernel unless their profile explicitly
  -- guarantees ArmCrc32. CPUID is feature discovery, not an unconditional ISA
  -- assumption; the result is independent of the bytes being checksummed.
  prim crc32c-available :: U32 -> U32 where
    unsafe llvm {
      %regs = call { i32, i32, i32, i32 } asm "cpuid", "={ax},={bx},={cx},={dx},{ax},{cx}"(i32 1, i32 0)
      %ecx = extractvalue { i32, i32, i32, i32 } %regs, 2
      %bit = and i32 %ecx, 1048576
      ret i32 %bit
    } when arch x86_64
    llvm {
      ret i32 1
    } when arch aarch64 when Available ArmCrc32
    llvm {
      ret i32 0
    }

  -- | Advance CRC-32C by eight bytes with an ISA instruction only after its
  -- availability check. The baseline body preserves semantics on other targets.
  prim crc32c-word :: U32 -> U64 -> U32 where
