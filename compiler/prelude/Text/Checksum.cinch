  -- | Consume hardware IEEE CRC blocks and finish with the exact scalar tail.
  crc32-ieee-from :: Bytes -> Nat -> U32 -> U32
  crc32-ieee-from b i acc =
    if i + 8 <= bytes-len b then crc32-ieee-from b (i + 8) (crc32-ieee-word acc (bytes-read-le64 b i))
    else crc32-from crc32-ieee b i acc
