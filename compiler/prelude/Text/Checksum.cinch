      %set10 = icmp ne i64 %bit10, 0
      %shift10 = lshr i64 %r9, 1
      %mask10 = select i1 %set10, i64 %poly, i64 0
      %r10 = xor i64 %shift10, %mask10
      %bit11 = and i64 %r10, 1
      %set11 = icmp ne i64 %bit11, 0
      %shift11 = lshr i64 %r10, 1
      %mask11 = select i1 %set11, i64 %poly, i64 0
      %r11 = xor i64 %shift11, %mask11
      %bit12 = and i64 %r11, 1
      %set12 = icmp ne i64 %bit12, 0
      %shift12 = lshr i64 %r11, 1
      %mask12 = select i1 %set12, i64 %poly, i64 0
      %r12 = xor i64 %shift12, %mask12
      %bit13 = and i64 %r12, 1
      %set13 = icmp ne i64 %bit13, 0
      %shift13 = lshr i64 %r12, 1
      %mask13 = select i1 %set13, i64 %poly, i64 0
      %r13 = xor i64 %shift13, %mask13
      %bit14 = and i64 %r13, 1
      %set14 = icmp ne i64 %bit14, 0
      %shift14 = lshr i64 %r13, 1
      %mask14 = select i1 %set14, i64 %poly, i64 0
      %r14 = xor i64 %shift14, %mask14
      %bit15 = and i64 %r14, 1
      %set15 = icmp ne i64 %bit15, 0
      %shift15 = lshr i64 %r14, 1
      %mask15 = select i1 %set15, i64 %poly, i64 0
      %r15 = xor i64 %shift15, %mask15
      %bit16 = and i64 %r15, 1
      %set16 = icmp ne i64 %bit16, 0
      %shift16 = lshr i64 %r15, 1
      %mask16 = select i1 %set16, i64 %poly, i64 0
      %r16 = xor i64 %shift16, %mask16
      %bit17 = and i64 %r16, 1
