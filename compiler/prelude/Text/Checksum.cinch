  -- | Consume hardware CRC-32C blocks, then use the same scalar tail as the
  -- portable path. The buffer remains owned by Cinch throughout every read.
  crc32c-from :: Bytes -> Nat -> U32 -> U32
  crc32c-from b i acc =
    if i + 8 <= bytes-len b then crc32c-from b (i + 8) (crc32c-word acc (bytes-read-le64 b i))
    else crc32-from crc32-castagnoli b i acc

  -- | Test whether the selected target guarantees the AArch64 IEEE CRC instruction.
  prim crc32-ieee-available :: U32 -> U32 where
    llvm {
      ret i32 1
    } when arch aarch64 when Available ArmCrc32
    llvm {
      ret i32 0
    }

  -- | Advance IEEE CRC-32 with the AArch64 CRC extension when guaranteed by
  -- the target profile. Other targets retain the same reflected polynomial.
  prim crc32-ieee-word :: U32 -> U64 -> U32 where
