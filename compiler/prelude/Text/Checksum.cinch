      %bit6 = and i64 %r5, 1
      %set6 = icmp ne i64 %bit6, 0
      %shift6 = lshr i64 %r5, 1
      %mask6 = select i1 %set6, i64 %poly, i64 0
      %r6 = xor i64 %shift6, %mask6
      %bit7 = and i64 %r6, 1
      %set7 = icmp ne i64 %bit7, 0
      %shift7 = lshr i64 %r6, 1
      %mask7 = select i1 %set7, i64 %poly, i64 0
      %r7 = xor i64 %shift7, %mask7
      %bit8 = and i64 %r7, 1
      %set8 = icmp ne i64 %bit8, 0
      %shift8 = lshr i64 %r7, 1
