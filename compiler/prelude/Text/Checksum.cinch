      %set32 = icmp ne i64 %bit32, 0
      %shift32 = lshr i64 %r31, 1
      %mask32 = select i1 %set32, i64 %poly, i64 0
      %r32 = xor i64 %shift32, %mask32
      %bit33 = and i64 %r32, 1
      %set33 = icmp ne i64 %bit33, 0
      %shift33 = lshr i64 %r32, 1
      %mask33 = select i1 %set33, i64 %poly, i64 0
