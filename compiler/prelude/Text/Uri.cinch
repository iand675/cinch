-- Text.Uri: URI references (RFC 3986) as components, parsed, printed,
-- normalized and resolved.
--
-- A port of Ruby's `URI` (design/stdlib-parity-ruby.md, the networking
-- family: "`Net::HTTP`, `Socket`, `URI`, `IPAddr`, `Resolv`/DNS").
-- Ruby's `URI` is a class hierarchy with per-scheme subclasses and a
-- `parse` that can raise; here one record-free data type carries every
-- reference and the parse returns a named error.
--
-- Module scheme (design/base-library.md): `Text.*` is conversion to and
-- from String/Bytes, and a URI's whole job is the text form, so its home
-- is `Text.Uri`. Host classification is what pulls in `Data.IpAddr`:
-- a bracketed host is checked as an IPv6 literal at parse time
-- (`ipv6-parse`), and `uri-host-ip` reports the address a host names
-- when it names one. Identifiers are kebab-case per D106; the component
-- accessors keep the surface readable and the constructor is exported so
-- a caller can build a reference it did not parse (D143's surface rule
-- leaves a constructor out only when it carries an invariant, and a URI
-- reference has none beyond the percent rule, which `uri-to-string`
-- does not depend on).
--
-- The law shape (exercised in compiler/tests/lib_uri_ipaddr.rs):
--   parse/print round trip: `uri-to-string (uri-parse s)` is `s` for
--     every reference `uri-parse` accepts, so printing never invents or
--     drops structure;
--   percent round trip: `uri-decode (uri-encode s)` is `Ok s` for every
--     `String s`, non-ASCII included, over the documented unreserved
--     set below;
--   resolution: `uri-resolve` implements RFC 3986 section 5.2 with the
--     dot-segment removal of section 5.2.4, so the section 5.4 normal
--     and abnormal examples reproduce exactly. Where the RFC offers a
--     choice, this is the strict-parser reading: `http:g` against the
--     base resolves to `http:g`, never the non-strict `http://a/b/c/g`.
--
-- Named refusals (unproductions this module deliberately does not
-- implement; each is a named boundary, never a silent gap):
--   `%`-encoding of the unreserved set only, and upper-case hex on
--     output: `uri-encode` is not a general "escape everything" (see
--     `unreserved` for the exact set);
--   scheme-specific normalization beyond section 6.2.2 (no path case
--     folding, no default-filename handling, no `http://x` -> `http://x/`):
--     that is the scheme registry's business, not this module's;
--   IRI support (RFC 3987): no conversion between an IRI and its URI
--     form lives here. Non-ASCII text in the host or path is kept as
--     written, the scheme is ASCII-only by `valid-scheme`, and
--     `uri-decode` validates its result as UTF-8;
--   `mailto:`-style opaque bodies and scheme-specific query grammars:
--     the generic syntax keeps them as path and query text, never
--     interpreted;
--   HTML/XML entity escaping and other serializations: printing is the
--     RFC 3986 text form, nothing else.
module Text.Uri where

  import Relation.Eq
  import Relation.Ord
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.List
  import Data.Bytes
  import Data.Bool
  import Data.Char
  import Data.String
  import Data.IpAddr

  import Algebra.Semigroup

  infixr 6 <>

  export Uri, MkUri
  export uri-parse, uri-to-string, uri-normalize, uri-resolve
  export uri-scheme, uri-userinfo, uri-host, uri-port, uri-path, uri-query, uri-fragment
  export uri-encode, uri-decode, uri-host-ip
  export UriError, BadPercentEscape, BadScheme, BadPort, BadIpv6Host, BadUtf8, render-uri-error


  -- -----------------------------------------------------------------
  -- The reference and its components.
  --
  -- The seven RFC 3986 components, each `None` when absent (an absent
  -- component and an empty one differ: `http://x` has no query, `http://x?`
  -- has an empty one, and the round trip needs the difference). `host`
  -- carries the authority's host text as written, brackets included, so
  -- `uri-to-string` reprints an IPv6 literal without re-deciding its
  -- brackets; a present-but-empty `host` is the empty authority of
  -- `file:///x`.
  -- -----------------------------------------------------------------

  data Uri where
    MkUri :: Option String -> Option String -> Option String -> Option Nat -> String -> Option String -> Option String -> Uri

  uri-scheme :: Uri -> Option String
  uri-scheme u = case u of
    MkUri scheme _ _ _ _ _ _ -> scheme

  uri-userinfo :: Uri -> Option String
  uri-userinfo u = case u of
    MkUri _ userinfo _ _ _ _ _ -> userinfo

  uri-host :: Uri -> Option String
  uri-host u = case u of
    MkUri _ _ host _ _ _ _ -> host

  uri-port :: Uri -> Option Nat
  uri-port u = case u of
    MkUri _ _ _ port _ _ _ -> port

  uri-path :: Uri -> String
  uri-path u = case u of
    MkUri _ _ _ _ path _ _ -> path

  uri-query :: Uri -> Option String
  uri-query u = case u of
    MkUri _ _ _ _ _ query _ -> query

  uri-fragment :: Uri -> Option String
  uri-fragment u = case u of
    MkUri _ _ _ _ _ _ fragment -> fragment


  -- -----------------------------------------------------------------
  -- Errors: every malformed reference names the rule it broke.
  -- -----------------------------------------------------------------

  data UriError where
    BadPercentEscape :: UriError
    BadScheme :: UriError
    BadPort :: UriError
    BadIpv6Host :: UriError
    BadUtf8 :: UriError

  render-uri-error :: UriError -> String
  render-uri-error e = case e of
    BadPercentEscape -> "malformed percent escape"
    BadScheme -> "malformed scheme"
    BadPort -> "malformed port"
    BadIpv6Host -> "malformed IPv6 host literal"
    BadUtf8 -> "decoded bytes are not valid UTF-8"


  -- -----------------------------------------------------------------
  -- Character plumbing. The list helpers (`reverse`, `<>`, `is-empty`,
  -- `drop`) come from Data.List and the scalar conversions (`char-code`,
  -- `char-from-code`) plus the ASCII digit and hex-digit tests and
  -- values (`is-ascii-digit`, `digit-value`, `is-ascii-hex-digit`,
  -- `hex-digit-value`) from Data.Char; only the module's own case folds
  -- and the `Nat`-to-`Char` hex printer live here.
  -- -----------------------------------------------------------------

  hex-up :: Nat -> Char
  hex-up d =
    if d <= 9 then (case char-from-code (48 + d) of Some x -> x; None -> '?')
    else (case char-from-code (55 + d) of Some x -> x; None -> '?')

  is-alpha :: Char -> Bool
  is-alpha c =
    let n = char-code c in ((n >= 65) && (n <= 90)) || ((n >= 97) && (n <= 122))

  ascii-lower :: Char -> Char
  ascii-lower c = let n = char-code c in if (n >= 65) && (n <= 90) then (case char-from-code (n + 32) of Some x -> x; None -> '?') else c

  ascii-upper :: Char -> Char
  ascii-upper c = let n = char-code c in if (n >= 97) && (n <= 122) then (case char-from-code (n - 32) of Some x -> x; None -> '?') else c

  map-chars :: (Char -> Char) -> List Char -> List Char
  map-chars f cs = case cs of
    Nil -> Nil
    Cons c rest -> Cons (f c) (map-chars f rest)

  map-opt :: forall a b. (a -> b) -> Option a -> Option b
  map-opt f o = case o of
    None -> None
    Some x -> Some (f x)

  opt-pack :: Option (List Char) -> Option String
  opt-pack o = case o of
    None -> None
    Some cs -> Some (pack cs)

  same-chars :: List Char -> List Char -> Bool
  same-chars a b = case a of
    Nil -> case b of
      Nil -> True
      Cons _ _ -> False
    Cons x xs -> case b of
      Nil -> False
      Cons y ys -> if eq-char x y then same-chars xs ys else False

  prefix-of :: List Char -> List Char -> Bool
  prefix-of pre cs = case pre of
    Nil -> True
    Cons p prest -> case cs of
      Nil -> False
      Cons c crest -> if eq-char p c then prefix-of prest crest else False

  -- The chars before the first `sep`.
  take-until :: Char -> List Char -> List Char
  take-until sep cs = take-until-acc sep cs Nil

  take-until-acc :: Char -> List Char -> List Char -> List Char
  take-until-acc sep cs acc = case cs of
    Nil -> reverse acc
    Cons c rest -> if eq-char c sep then reverse acc else take-until-acc sep rest (Cons c acc)

  -- The chars from the first `sep` onward (the separator included).
  drop-until :: Char -> List Char -> List Char
  drop-until sep cs = case cs of
    Nil -> Nil
    Cons c _ -> if eq-char c sep then cs else drop-until sep (drop 1 cs)


  -- -----------------------------------------------------------------
  -- Percent encoding (RFC 3986 section 2.1).
  -- -----------------------------------------------------------------

  -- The `unreserved` set, and the ONLY set `uri-encode` leaves alone:
  -- `A-Z` (65..90), `a-z` (97..122), `0-9` (48..57), `-` (45), `.`
  -- (46), `_` (95), `~` (126). Every other byte of the UTF-8 encoding
  -- becomes `%XX` with upper-case hex, which is what makes the decode
  -- round trip hold for non-ASCII text.
  unreserved :: Nat -> Bool
  unreserved b =
    ((b >= 65) && (b <= 90)) || ((b >= 97) && (b <= 122)) || ((b >= 48) && (b <= 57))
    || (b == 45) || (b == 46) || (b == 95) || (b == 126)

  -- The UTF-8 bytes of a scalar value (the encoder inverse of
  -- Data.String's `utf8-at`).
  utf8-bytes :: Nat -> List Nat
  utf8-bytes cp =
    if cp < 128 then Cons cp Nil
    else if cp < 2048 then Cons (192 + nat-div cp 64) (Cons (128 + nat-rem cp 64) Nil)
    else if cp < 65536 then
      Cons (224 + nat-div cp 4096)
        (Cons (128 + nat-rem (nat-div cp 64) 64) (Cons (128 + nat-rem cp 64) Nil))
    else
      Cons (240 + nat-div cp 262144)
        (Cons (128 + nat-rem (nat-div cp 4096) 64)
          (Cons (128 + nat-rem (nat-div cp 64) 64) (Cons (128 + nat-rem cp 64) Nil)))

  uri-encode :: String -> String
  uri-encode s = pack (enc-chars (unpack s) Nil)

  enc-chars :: List Char -> List Char -> List Char
  enc-chars cs acc = case cs of
    Nil -> reverse acc
    Cons c rest -> enc-chars rest (enc-bytes (utf8-bytes (char-code c)) acc)

  -- Prepend one byte's encoding to a reversed accumulator.
  enc-bytes :: List Nat -> List Char -> List Char
  enc-bytes bs acc = case bs of
    Nil -> acc
    Cons b rest ->
      if unreserved b then enc-bytes rest (Cons (case char-from-code b of Some x -> x; None -> '?') acc)
      else enc-bytes rest (Cons (hex-up (nat-rem b 16)) (Cons (hex-up (nat-div b 16)) (Cons '%' acc)))

  uri-decode :: String -> Result UriError String
  uri-decode s = case dec-bytes (unpack s) Nil of
    None -> Err BadPercentEscape
    Some rev-bytes -> case string-from-bytes (bytes-from-list (as-bytes (reverse rev-bytes))) of
      None -> Err BadUtf8
      Some out -> Ok out

  -- The decoded values as bytes. Each is a UTF-8 byte or a two-digit hex
  -- escape, so already below 256 and the `nat-rem` leaves it unchanged.
  as-bytes :: List Nat -> List (InRange 0 255 Nat)
  as-bytes bs = case bs of
    Nil -> Nil
    Cons b rest -> Cons (nat-rem b 256) (as-bytes rest)

  dec-bytes :: List Char -> List Nat -> Option (List Nat)
  dec-bytes cs acc = case cs of
    Nil -> Some acc
    Cons c rest ->
      if eq-char c '%' then
        case rest of
          Cons h1 (Cons h2 r) -> case hex-pair h1 h2 of
            None -> None
            Some b -> dec-bytes r (Cons b acc)
          _ -> None
      else dec-bytes rest (reverse (utf8-bytes (char-code c)) <> acc)

  hex-pair :: Char -> Char -> Option Nat
  hex-pair h1 h2 = case hex-digit-value h1 of
    None -> None
    Some n1 -> case hex-digit-value h2 of
      None -> None
      Some n2 -> Some (n1 * 16 + n2)


  -- -----------------------------------------------------------------
  -- Parsing (RFC 3986 appendix B's grammar, with the checks the
  -- grammar needs and the appendix's regex cannot carry).
  -- -----------------------------------------------------------------

  uri-parse :: String -> Result UriError Uri
  uri-parse s =
    if valid-pct (unpack s) then parse-ref (unpack s) else Err BadPercentEscape

  -- Every `%` must introduce two hex digits, anywhere in the reference.
  valid-pct :: List Char -> Bool
  valid-pct cs = case cs of
    Nil -> True
    Cons c rest ->
      if eq-char c '%' then
        case rest of
          Cons h1 (Cons h2 r) -> if is-ascii-hex-digit h1 && is-ascii-hex-digit h2 then valid-pct r else False
          _ -> False
      else valid-pct rest

  -- The part before the first `sep` and the part after it (the separator
  -- dropped; `None` when it is absent).
  break-first :: Char -> List Char -> (List Char, Option (List Char))
  break-first sep cs = break-first-acc sep cs Nil

  break-first-acc :: Char -> List Char -> List Char -> (List Char, Option (List Char))
  break-first-acc sep cs pre = case cs of
    Nil -> (reverse pre, None)
    Cons c rest ->
      if eq-char c sep then (reverse pre, Some rest)
      else break-first-acc sep rest (Cons c pre)

  -- The part before the LAST `sep` and the part after it (`None` before
  -- when it is absent), for userinfo's `@`.
  break-last :: Char -> List Char -> (Option (List Char), List Char)
  break-last sep cs = case break-first sep (reverse cs) of
    (trailing-rev, leading-rev) -> case leading-rev of
      None -> (None, cs)
      Some pre -> (Some (reverse pre), reverse trailing-rev)

  -- The authority text after an initial `//` (if present) and the path
  -- that follows it.
  strip-auth :: List Char -> (Option (List Char), List Char)
  strip-auth cs = case cs of
    Cons c1 (Cons c2 rest) ->
      if (eq-char c1 '/') && (eq-char c2 '/') then
        case break-first '/' rest of
          (auth, path) -> (Some auth, case path of
              None -> Nil
              Some p -> Cons '/' p)
      else (None, cs)
    _ -> (None, cs)

  -- The leading run of chars that are neither `:` nor `/`, and the rest.
  span-scheme :: List Char -> (List Char, List Char)
  span-scheme cs = span-scheme-acc cs Nil

  span-scheme-acc :: List Char -> List Char -> (List Char, List Char)
  span-scheme-acc cs pre = case cs of
    Nil -> (reverse pre, Nil)
    Cons c rest ->
      if (eq-char c ':') || (eq-char c '/') then (reverse pre, cs)
      else span-scheme-acc rest (Cons c pre)

  valid-scheme :: List Char -> Bool
  valid-scheme cs = case cs of
    Nil -> False
    Cons c rest -> if is-alpha c then all-scheme-chars rest else False

  all-scheme-chars :: List Char -> Bool
  all-scheme-chars cs = case cs of
    Nil -> True
    Cons c rest ->
      if is-alpha c || is-ascii-digit c || eq-char c '+' || eq-char c '-' || eq-char c '.' then all-scheme-chars rest
      else False

  -- `scheme "+" hier-part`: a scheme is recognised only when a `:`
  -- follows the leading run and that run is a valid scheme, so `1a:b`
  -- and `:x` are refused rather than read as paths.
  split-scheme :: List Char -> Result UriError (Option (List Char), List Char)
  split-scheme cs = case span-scheme cs of
    (seg, rest) -> case rest of
      Cons c r ->
        if eq-char c ':' then (if valid-scheme seg then Ok (Some seg, r) else Err BadScheme)
        else Ok (None, cs)
      Nil -> Ok (None, cs)

  all-digits :: List Char -> Bool
  all-digits cs = case cs of
    Nil -> True
    Cons c rest -> if is-ascii-digit c then all-digits rest else False

  digits-fold :: List Char -> Nat -> Nat
  digits-fold cs acc = case cs of
    Nil -> acc
    Cons c rest -> case digit-value c of
      Some d -> digits-fold rest (acc * 10 + d)
      None -> acc

  port-value :: List Char -> Option Nat
  port-value cs =
    if is-empty cs then None
    else if all-digits cs then Some (digits-fold cs 0)
    else None

  bracketed :: List Char -> List Char
  bracketed inner = Cons '[' (inner <> Cons ']' Nil)

  -- The host and its port: a bracketed IPv6 literal (`[...]`, validated
  -- through `Data.IpAddr`), or a registered name/IPv4 stopped at the
  -- first `:`.
  split-host-port :: List Char -> Result UriError (List Char, Option Nat)
  split-host-port cs = case cs of
    Nil -> Ok (Nil, None)
    Cons c rest ->
      if eq-char c '[' then
        case break-first ']' rest of
          (inner, after) -> case after of
            None -> Err BadIpv6Host
            Some a -> case ipv6-parse (pack inner) of
              None -> Err BadIpv6Host
              Some _ -> case a of
                Nil -> Ok (bracketed inner, None)
                Cons c2 more ->
                  if eq-char c2 ':' then
                    case port-value more of
                      None -> Err BadPort
                      Some p -> Ok (bracketed inner, Some p)
                  else Err BadIpv6Host
      else case break-first ':' cs of
        (host, port) -> case port of
          None -> Ok (host, None)
          Some p -> case port-value p of
            None -> Err BadPort
            Some n -> Ok (host, Some n)

  parse-authority :: List Char -> Result UriError (Option String, Option String, Option Nat)
  parse-authority auth = case break-last '@' auth of
    (ui, hostport) -> case split-host-port hostport of
      Err e -> Err e
      Ok hp -> case hp of
        (host, port) -> Ok (opt-pack ui, Some (pack host), port)

  -- Fragment, then query, then `scheme hier-part [authority]`.
  parse-ref :: List Char -> Result UriError Uri
  parse-ref cs = case break-first '#' cs of
    (main, frag) -> case break-first '?' main of
      (hier, query) -> case split-scheme hier of
        Err e -> Err e
        Ok sch -> case sch of
          (scheme, after) -> case strip-auth after of
            (auth, path) -> case auth of
              None -> Ok (MkUri (opt-pack scheme) None None None (pack path) (opt-pack query) (opt-pack frag))
              Some a -> case parse-authority a of
                Err e -> Err e
                Ok (ui, host, port) -> Ok (MkUri (opt-pack scheme) ui host port (pack path) (opt-pack query) (opt-pack frag))


  -- -----------------------------------------------------------------
  -- Printing: the exact inverse of parsing (the round-trip law).
  -- -----------------------------------------------------------------

  uri-to-string :: Uri -> String
  uri-to-string u =
    string-concat (scheme-part u)
      (string-concat (authority-part u)
        (string-concat (uri-path u)
          (string-concat (query-part u) (fragment-part u))))

  scheme-part :: Uri -> String
  scheme-part u = case uri-scheme u of
    None -> empty-string
    Some s -> string-concat s ":"

  authority-part :: Uri -> String
  authority-part u = case uri-host u of
    None -> empty-string
    Some h -> string-concat "//" (string-concat (userinfo-part u) (string-concat h (port-part u)))

  userinfo-part :: Uri -> String
  userinfo-part u = case uri-userinfo u of
    None -> empty-string
    Some x -> string-concat x "@"

  port-part :: Uri -> String
  port-part u = case uri-port u of
    None -> empty-string
    Some p -> string-concat ":" (nat-to-string p)

  query-part :: Uri -> String
  query-part u = case uri-query u of
    None -> empty-string
    Some q -> string-concat "?" q

  fragment-part :: Uri -> String
  fragment-part u = case uri-fragment u of
    None -> empty-string
    Some f -> string-concat "#" f


  -- -----------------------------------------------------------------
  -- Normalization (RFC 3986 section 6.2.2's syntax-based rules the
  -- task names: lower-case scheme and host, upper-case percent escapes,
  -- and the default-port removal of section 6.2.3).
  -- -----------------------------------------------------------------

  -- The scheme registry's well-known default ports (section 6.2.3's
  -- table, the entries with an unambiguous default).
  default-port :: String -> Option Nat
  default-port s =
    if s == "http" then Some 80
    else if s == "https" then Some 443
    else if s == "ws" then Some 80
    else if s == "wss" then Some 443
    else if s == "ftp" then Some 21
    else None

  drop-default-port :: Option String -> Option Nat -> Option Nat
  drop-default-port scheme port = case scheme of
    None -> port
    Some s -> case port of
      None -> None
      Some n -> case default-port s of
        None -> Some n
        Some d -> if n == d then None else Some n

  lower-str :: String -> String
  lower-str s = pack (map-chars ascii-lower (unpack s))

  -- Upper-case the two hex digits of every `%XX` (the escapes are known
  -- valid because `uri-parse` refuses malformed ones).
  upper-pct :: String -> String
  upper-pct s = pack (upper-pct-chars (unpack s))

  upper-pct-chars :: List Char -> List Char
  upper-pct-chars cs = case cs of
    Nil -> Nil
    Cons c rest ->
      if eq-char c '%' then
        case rest of
          Cons h1 (Cons h2 r) ->
            Cons '%' (Cons (ascii-upper h1) (Cons (ascii-upper h2) (upper-pct-chars r)))
          _ -> Cons c (upper-pct-chars rest)
      else Cons c (upper-pct-chars rest)

  lower-host :: String -> String
  lower-host h = upper-pct (lower-str h)

  normalized-scheme :: Uri -> Option String
  normalized-scheme u = case uri-scheme u of
    None -> None
    Some s -> Some (lower-str s)

  uri-normalize :: Uri -> Uri
  uri-normalize u =
    let scheme = normalized-scheme u in
    MkUri scheme
      (map-opt upper-pct (uri-userinfo u))
      (map-opt lower-host (uri-host u))
      (drop-default-port scheme (uri-port u))
      (upper-pct (uri-path u))
      (map-opt upper-pct (uri-query u))
      (map-opt upper-pct (uri-fragment u))


  -- -----------------------------------------------------------------
  -- Host classification (the one place an address type is needed).
  -- -----------------------------------------------------------------

  string-null :: String -> Bool
  string-null s = string-byte-length s == 0

  starts-with-bracket :: List Char -> Bool
  starts-with-bracket cs = case cs of
    Cons c _ -> eq-char c '['
    Nil -> False

  ends-with-bracket :: List Char -> Bool
  ends-with-bracket cs = case reverse cs of
    Cons c _ -> eq-char c ']'
    Nil -> False

  strip-brackets :: List Char -> List Char
  strip-brackets cs = case cs of
    Nil -> Nil
    Cons _ rest -> case reverse rest of
      Nil -> Nil
      Cons _ inner-rev -> reverse inner-rev

  -- The address a host names, when it names one: a bracketed literal is
  -- an IPv6 address, a bare host that parses as IPv4 is one, and any
  -- other host (a registered name, or an unbracketed IPv6) is `None`.
  uri-host-ip :: Uri -> Option IpAddr
  uri-host-ip u = case uri-host u of
    None -> None
    Some h ->
      let cs = unpack h in
      if starts-with-bracket cs && ends-with-bracket cs then
        case ipv6-parse (pack (strip-brackets cs)) of
          None -> None
          Some a -> Some (V6Addr a)
      else
        case ipv4-parse h of
          Some a -> Some (V4Addr a)
          None -> None


  -- -----------------------------------------------------------------
  -- Reference resolution (RFC 3986 section 5.2), with the dot-segment
  -- removal of section 5.2.4 below.
  -- -----------------------------------------------------------------

  has-authority :: Uri -> Bool
  has-authority u = case uri-host u of
    Some _ -> True
    None -> False

  starts-with-slash :: String -> Bool
  starts-with-slash s = case unpack s of
    Cons c _ -> eq-char c '/'
    Nil -> False

  -- `R.scheme` present: the reference's own scheme and authority win.
  from-ref-scheme :: Uri -> Uri
  from-ref-scheme ref =
    MkUri (uri-scheme ref) (uri-userinfo ref) (uri-host ref) (uri-port ref)
      (remove-dot-segments (uri-path ref)) (uri-query ref) (uri-fragment ref)

  -- No scheme, but `R.authority` present: the base's scheme wins.
  from-ref-authority :: Uri -> Uri -> Uri
  from-ref-authority base ref =
    MkUri (uri-scheme base) (uri-userinfo ref) (uri-host ref) (uri-port ref)
      (remove-dot-segments (uri-path ref)) (uri-query ref) (uri-fragment ref)

  -- The reference's query wins, else the base's (section 5.2.2's
  -- `R.query` defined test).
  ref-query :: Uri -> Uri -> Option String
  ref-query ref base = case uri-query ref of
    Some q -> Some q
    None -> uri-query base

  from-ref-path :: Uri -> Uri -> Uri
  from-ref-path base ref =
    let p = uri-path ref in
    if string-null p then
      MkUri (uri-scheme base) (uri-userinfo base) (uri-host base) (uri-port base)
        (uri-path base) (ref-query ref base) (uri-fragment ref)
    else
      MkUri (uri-scheme base) (uri-userinfo base) (uri-host base) (uri-port base)
        (resolve-path base p) (uri-query ref) (uri-fragment ref)

  resolve-path :: Uri -> String -> String
  resolve-path base p =
    if starts-with-slash p then remove-dot-segments p
    else remove-dot-segments (merge-paths base p)

  -- Section 5.2.3: an authoritative base with an empty path contributes
  -- `/`, otherwise the base's directory (through its last `/`).
  merge-paths :: Uri -> String -> String
  merge-paths base p =
    if has-authority base && string-null (uri-path base) then string-concat "/" p
    else string-concat (path-dir (uri-path base)) p

  uri-resolve :: Uri -> Uri -> Uri
  uri-resolve base ref = case uri-scheme ref of
    Some _ -> from-ref-scheme ref
    None -> case uri-host ref of
      Some _ -> from-ref-authority base ref
      None -> from-ref-path base ref


  -- -----------------------------------------------------------------
  -- Dot-segment removal (RFC 3986 section 5.2.4), the RFC's algorithm
  -- step for step, so the section 5.4 examples reproduce.
  -- -----------------------------------------------------------------

  -- The output buffer is held REVERSED (`rout`), so moving a segment
  -- costs that segment's length and removing the last one stays local;
  -- appending each segment to the end of a forward list would re-copy
  -- the whole output at every segment.
  remove-dot-segments :: String -> String
  remove-dot-segments s = pack (reverse (rem-dots (unpack s) Nil))

  rem-dots :: List Char -> List Char -> List Char
  rem-dots input rout =
    if is-empty input then rout
    else if prefix-of (unpack "../") input then rem-dots (drop 3 input) rout
    else if prefix-of (unpack "./") input then rem-dots (drop 2 input) rout
    else if prefix-of (unpack "/./") input then rem-dots (Cons '/' (drop 3 input)) rout
    else if same-chars input (unpack "/.") then rem-dots (Cons '/' Nil) rout
    else if prefix-of (unpack "/../") input then rem-dots (Cons '/' (drop 4 input)) (before-last-slash rout)
    else if same-chars input (unpack "/..") then rem-dots (Cons '/' Nil) (before-last-slash rout)
    else if same-chars input (unpack ".") then rout
    else if same-chars input (unpack "..") then rout
    else move-segment input rout

  -- Step E: move the first path segment (a leading `/` plus chars up to
  -- the next `/`, or the chars up to the next `/` when there is no
  -- leading `/`) from the input to the output.
  move-segment :: List Char -> List Char -> List Char
  move-segment input rout = case input of
    Nil -> rout
    Cons c rest ->
      if eq-char c '/' then
        let seg = Cons '/' (take-until '/' rest) in
        rem-dots (drop-until '/' rest) (reverse-onto seg rout)
      else
        let seg = take-until '/' input in
        rem-dots (drop-until '/' input) (reverse-onto seg rout)

  -- `xs` reversed in front of `acc`.
  reverse-onto :: List Char -> List Char -> List Char
  reverse-onto xs acc = case xs of
    Nil -> acc
    Cons x rest -> reverse-onto rest (Cons x acc)

  -- The path through its last `/` (the base's directory).
  path-dir :: String -> String
  path-dir s = pack (reverse (drop-until '/' (reverse (unpack s))))

  -- The reversed output with its last segment and that segment's `/`
  -- removed (section 5.2.4's "remove the last segment").
  before-last-slash :: List Char -> List Char
  before-last-slash rout = drop 1 (drop-until '/' rout)
