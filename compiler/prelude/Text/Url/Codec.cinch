-- | Byte-preserving percent escaping for URL components.
-- Query components map spaces to plus and decode plus as space. Other contexts
-- preserve plus. Percent decoding validates the complete input before returning
-- fresh bytes; arbitrary decoded bytes never pass through a text conversion.
-- Host and zone policies enforce their additional escape restrictions. SIMD
-- classifiers skip complete ordinary spans; private exact-load loops retain
-- backing owners. Checked bulk copies write percent triplets and ordinary runs.
module Text.Url.Codec where

  import Text.Url.Error
  import Data.Bytes
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String

  export UrlEncoding, UrlPath, UrlPathSegment, UrlHost, UrlZone, UrlUserPassword, UrlQueryComponent, UrlFragment
  export url-escape, url-unescape, url-escaped-length, url-unescape-path-hint, url-unescape-fragment-hint
  export url-path-escape, url-path-unescape, url-query-escape, url-query-unescape
  export url-path-escape-text, url-query-escape-text

  -- | The independent byte grammar of one URL component.
  data UrlEncoding where
    -- | A complete path, preserving path separators and path punctuation.
    UrlPath :: UrlEncoding
    -- | One path segment, escaping slashes, semicolons, commas and question marks.
    UrlPathSegment :: UrlEncoding
    -- | A complete host and optional port, preserving accepted host punctuation.
    UrlHost :: UrlEncoding
    -- | An IPv6 zone identifier, with restricted percent-decoded bytes.
    UrlZone :: UrlEncoding
    -- | One username or password, escaping structural authority delimiters.
    UrlUserPassword :: UrlEncoding
    -- | One query key or value, using plus for spaces and escaping reserved bytes.
    UrlQueryComponent :: UrlEncoding
    -- | A fragment, preserving its allowed reserved punctuation.
    UrlFragment :: UrlEncoding

  -- | Select the private machine policy identifier once at the public boundary.
  encoding-mode :: UrlEncoding -> U8
  encoding-mode encoding = case encoding of
    UrlPath -> 1
    UrlPathSegment -> 2
    UrlHost -> 3
    UrlZone -> 4
    UrlUserPassword -> 5
    UrlQueryComponent -> 6
    UrlFragment -> 7

  -- | Preserve valid pchar spellings in explicit raw path/fragment hints.
  hint-mode :: UrlEncoding -> U8
  hint-mode encoding = case encoding of UrlFragment -> 9; other -> 8

  -- | Copy one checked source interval without retaining a mutable caller alias.
  part :: Bytes -> Nat -> Nat -> Bytes
  part input start n = if start + n <= bytes-len input then
    let out = bytes-new n in let copied = bytes-copy-range out input 0 start n in out
    else bytes-new 0

  -- | Convert a complete unsigned machine word to an exact natural number.
  word-natural :: U64 -> Nat
  word-natural word = u32-to-nat (wrapping-u64-to-u32 word) + u32-to-nat (wrapping-u64-to-u32 (wrapping-shr-u64 word 32)) * 4294967296

  -- | Keep a backing buffer alive until a strict private traversal returns.
  hold-input :: forall a. Bytes -> a -> a
  hold-input input value = case bytes-len input of _ -> value

  -- | Load exactly eight complete bytes for order-independent classification.
  prim load-eight :: I64 -> U64 where
    unsafe llvm {
      %p = inttoptr i64 %0 to ptr
      %value = load i64, ptr %p, align 1
      ret i64 %value
    }

  -- | Load one exact scalar fringe byte after the caller proves remaining length.
  prim load-one :: I64 -> U8 where
    unsafe llvm {
      %p = inttoptr i64 %0 to ptr
      %value = load i8, ptr %p, align 1
      ret i8 %value
    }

  -- | Accumulate percent counts below bit 63 and query-space presence in bit 63.
  merge-counts :: U64 -> U64 -> U64
  merge-counts total chunk =
    let count = wrapping-add-u64 (bit-and-u64 total 9223372036854775807) (bit-and-u64 chunk 9223372036854775807) in
    bit-or-u64 count (bit-and-u64 (bit-or-u64 total chunk) 9223372036854775808)

  -- | Select a fixed byte grammar once before entering its machine-only counting loop.
  count-from :: I64 -> U64 -> U8 -> U64 -> U64
  count-from address remaining mode total =
    if eq-u8 mode 1 then count-path address remaining total
    else if eq-u8 mode 2 then count-segment address remaining total
    else if eq-u8 mode 3 || eq-u8 mode 4 then count-host address remaining total
    else if eq-u8 mode 5 then count-user address remaining total
    else if eq-u8 mode 6 then count-query address remaining total
    else count-fragment address remaining total

  -- | Count path replacements with a constant SIMD policy and exact machine-counter tails.
  count-path :: I64 -> U64 -> U64 -> U64
  count-path address remaining total =
    if ge-u64 remaining 8 then
      let word = load-eight address in let chunk = classify-eight word 1 in
      count-path (wrapping-add-i64 address 8) (wrapping-sub-u64 remaining 8) (merge-counts total chunk)
    else if ne-u64 remaining 0 then
      let byte = load-one address in let action = classify-one byte 1 in
      let chunk = if eq-u8 action 2 then (1 :: U64) else if eq-u8 action 1 then 9223372036854775808 else 0 in
      count-path (wrapping-add-i64 address 1) (wrapping-sub-u64 remaining 1) (merge-counts total chunk)
    else total

  -- | Count segment replacements with a constant SIMD policy and exact machine-counter tails.
  count-segment :: I64 -> U64 -> U64 -> U64
  count-segment address remaining total =
    if ge-u64 remaining 8 then
      let word = load-eight address in let chunk = classify-eight word 2 in
      count-segment (wrapping-add-i64 address 8) (wrapping-sub-u64 remaining 8) (merge-counts total chunk)
    else if ne-u64 remaining 0 then
      let byte = load-one address in let action = classify-one byte 2 in
      let chunk = if eq-u8 action 2 then (1 :: U64) else if eq-u8 action 1 then 9223372036854775808 else 0 in
      count-segment (wrapping-add-i64 address 1) (wrapping-sub-u64 remaining 1) (merge-counts total chunk)
    else total

  -- | Count host replacements with a constant SIMD policy and exact machine-counter tails.
  count-host :: I64 -> U64 -> U64 -> U64
  count-host address remaining total =
    if ge-u64 remaining 8 then
      let word = load-eight address in let chunk = classify-eight word 3 in
      count-host (wrapping-add-i64 address 8) (wrapping-sub-u64 remaining 8) (merge-counts total chunk)
    else if ne-u64 remaining 0 then
      let byte = load-one address in let action = classify-one byte 3 in
      let chunk = if eq-u8 action 2 then (1 :: U64) else if eq-u8 action 1 then 9223372036854775808 else 0 in
      count-host (wrapping-add-i64 address 1) (wrapping-sub-u64 remaining 1) (merge-counts total chunk)
    else total

  -- | Count user replacements with a constant SIMD policy and exact machine-counter tails.
  count-user :: I64 -> U64 -> U64 -> U64
  count-user address remaining total =
    if ge-u64 remaining 8 then
      let word = load-eight address in let chunk = classify-eight word 5 in
      count-user (wrapping-add-i64 address 8) (wrapping-sub-u64 remaining 8) (merge-counts total chunk)
    else if ne-u64 remaining 0 then
      let byte = load-one address in let action = classify-one byte 5 in
      let chunk = if eq-u8 action 2 then (1 :: U64) else if eq-u8 action 1 then 9223372036854775808 else 0 in
      count-user (wrapping-add-i64 address 1) (wrapping-sub-u64 remaining 1) (merge-counts total chunk)
    else total

  -- | Count query replacements with a constant SIMD policy and exact machine-counter tails.
  count-query :: I64 -> U64 -> U64 -> U64
  count-query address remaining total =
    if ge-u64 remaining 8 then
      let word = load-eight address in let chunk = classify-eight word 6 in
      count-query (wrapping-add-i64 address 8) (wrapping-sub-u64 remaining 8) (merge-counts total chunk)
    else if ne-u64 remaining 0 then
      let byte = load-one address in let action = classify-one byte 6 in
      let chunk = if eq-u8 action 2 then (1 :: U64) else if eq-u8 action 1 then 9223372036854775808 else 0 in
      count-query (wrapping-add-i64 address 1) (wrapping-sub-u64 remaining 1) (merge-counts total chunk)
    else total

  -- | Count fragment replacements with a constant SIMD policy and exact machine-counter tails.
  count-fragment :: I64 -> U64 -> U64 -> U64
  count-fragment address remaining total =
    if ge-u64 remaining 8 then
      let word = load-eight address in let chunk = classify-eight word 7 in
      count-fragment (wrapping-add-i64 address 8) (wrapping-sub-u64 remaining 8) (merge-counts total chunk)
    else if ne-u64 remaining 0 then
      let byte = load-one address in let action = classify-one byte 7 in
      let chunk = if eq-u8 action 2 then (1 :: U64) else if eq-u8 action 1 then 9223372036854775808 else 0 in
      count-fragment (wrapping-add-i64 address 1) (wrapping-sub-u64 remaining 1) (merge-counts total chunk)
    else total

  -- | Count one complete buffer while retaining its source throughout private exact loads.
  count-input :: Bytes -> U8 -> U64
  count-input input mode = hold-input input (count-from (bytes-data input) (wrapping-i64-to-u64 (nat-to-i64 (bytes-len input))) mode 0)

  -- | Exact percent-encoded byte count; query-space substitution does not change length.
  url-escaped-length :: UrlEncoding -> Bytes -> Nat
  url-escaped-length encoding input =
    let mode = encoding-mode encoding in let counts = count-input input mode in
    bytes-len input + 2 * word-natural (bit-and-u64 counts 9223372036854775807)

  -- | Recognize a single byte requiring encoder interpretation or percent/plus decoding.
  special-one :: U8 -> U8 -> Bool -> Bool
  special-one byte mode decoding =
    if decoding then eq-u8 byte 37 || (eq-u8 mode 6 && eq-u8 byte 43)
    else let action = classify-one byte mode in ne-u8 action 0

  -- | Find a special byte in an exact fringe of at most eight remaining bytes.
  find-fringe :: I64 -> U64 -> U8 -> Bool -> U64 -> U64
  find-fringe address remaining mode decoding count =
    if eq-u64 remaining 0 then count
    else let byte = load-one address in
      if special-one byte mode decoding then count
      else find-fringe (wrapping-add-i64 address 1) (wrapping-sub-u64 remaining 1) mode decoding (wrapping-add-u64 count 1)

  -- | Skip ordinary complete blocks with SIMD, retaining only machine address/count state.
  find-from :: I64 -> U64 -> U8 -> Bool -> U64 -> U64
  find-from address remaining mode decoding count =
    if ge-u64 remaining 8 then
      let word = load-eight address in
      let ordinary = if decoding then let flags = decode-flags-eight word mode in eq-u8 flags 0 else let flags = classify-eight word mode in eq-u64 flags 0 in
      if ordinary then find-from (wrapping-add-i64 address 8) (wrapping-sub-u64 remaining 8) mode decoding (wrapping-add-u64 count 8)
      else find-fringe address 8 mode decoding count
    else find-fringe address remaining mode decoding count

  -- | Avoid classifying a following block when the current byte already requires interpretation.
  find-entry :: I64 -> U64 -> U8 -> Bool -> U64
  find-entry address remaining mode decoding =
    if eq-u64 remaining 0 then 0
    else let byte = load-one address in
      if special-one byte mode decoding then 0 else find-from address remaining mode decoding 0

  -- | Locate the next interpreted byte under one source-owner hold.
  next-special :: Bytes -> Nat -> U8 -> Bool -> Nat
  next-special input start mode decoding = if start <= bytes-len input then
    let address = wrapping-add-i64 (bytes-data input) (nat-to-i64 start) in
    start + word-natural (hold-input input (find-entry address (wrapping-i64-to-u64 (nat-to-i64 (bytes-len input - start))) mode decoding))
    else bytes-len input

  -- | Copy ordinary spans and write plus substitutions or one checked percent-triplet copy.
  encode-from :: Bytes -> Nat -> Bytes -> Nat -> U8 -> Bytes -> Unit
  encode-from input start out oi mode table =
    let stop = next-special input start mode False in
    if start <= stop && stop <= bytes-len input && oi + stop - start <= bytes-len out then
      let copied = if start < stop then bytes-copy-range out input oi start (stop - start) else () in
      let next = oi + stop - start in
      if stop < bytes-len input then
        let byte = bytes-get input stop in let raw = wrapping-i64-to-u8 (nat-to-i64 byte) in
        let action = classify-one raw mode in
        if eq-u8 action 1 && next < bytes-len out then
          let written = bytes-set out next 43 in encode-from input (stop + 1) out (next + 1) mode table
        else let offset = byte * 3 in
          if offset + 3 <= bytes-len table && next + 3 <= bytes-len out then
            let written = bytes-copy-range out table next offset 3 in encode-from input (stop + 1) out (next + 3) mode table
          else ()
      else ()
    else ()

  -- | Encode one complete component into fresh bytes, preserving no caller aliases.
  url-escape :: UrlEncoding -> Bytes -> Bytes
  url-escape encoding input =
    let mode = encoding-mode encoding in let counts = count-input input mode in
    let percent = word-natural (bit-and-u64 counts 9223372036854775807) in
    let out = bytes-new (bytes-len input + percent * 2) in
    if eq-u64 counts 0 then let copied = bytes-copy-range out input 0 0 (bytes-len input) in out
    else let table = if percent == 0 then (bytes-new 0 :: Bytes) else percent-triplets () in
      let written = encode-from input 0 out 0 mode table in out

  -- | Decode a hexadecimal digit without accepting non-ASCII digits or unrelated letters.
  hex-value :: Nat -> Option Nat
  hex-value byte =
    if byte >= 48 && byte <= 57 then Some (byte - 48)
    else if byte >= 65 && byte <= 70 then Some (byte - 55)
    else if byte >= 97 && byte <= 102 then Some (byte - 87)
    else None

  -- | Preserve at most three original bytes in a malformed-escape diagnostic.
  bad-escape :: Bytes -> Nat -> UrlFailure
  bad-escape input at =
    let remaining = saturating-sub (bytes-len input) at in
    let n = if remaining < 3 then remaining else (3 :: Nat) in
    url-failure UrlInvalidEscape at (part input at n)

  -- | Validate one percent triplet and host/zone restrictions before any output is allocated.
  validate-percent :: Bytes -> Nat -> U8 -> Result UrlFailure Nat
  validate-percent input at mode = if at + 3 <= bytes-len input then
    case hex-value (bytes-get input (at + 1)) of
      None -> Err (bad-escape input at)
      Some high -> case hex-value (bytes-get input (at + 2)) of
        None -> Err (bad-escape input at)
        Some low ->
          let value = high * 16 + low in
          if eq-u8 mode 3 && value < 128 && value /= 37 then Err (bad-escape input at)
          else if eq-u8 mode 4 && value /= 37 && value /= 32 then
            if value <= 255 then
              let raw = wrapping-i64-to-u8 (nat-to-i64 value) in let action = classify-one raw 3 in
              if ne-u8 action 0 then Err (bad-escape input at) else Ok value
            else Err (bad-escape input at)
          else Ok value
    else Err (bad-escape input at)

  -- | Recognize a validation boundary, including raw ASCII forbidden in host and zone components.
  validation-special :: U8 -> U8 -> Bool
  validation-special byte mode =
    if eq-u8 byte 37 || (eq-u8 mode 6 && eq-u8 byte 43) then True
    else if (eq-u8 mode 3 || eq-u8 mode 4) && lt-u8 byte 128 then
      let action = classify-one byte mode in ne-u8 action 0
    else False

  -- | Inspect only an exact validation fringe with retained machine state.
  validation-fringe :: I64 -> U64 -> U8 -> U64 -> U64
  validation-fringe address remaining mode skipped = if eq-u64 remaining 0 then skipped else
    let byte = load-one address in if validation-special byte mode then skipped else
      validation-fringe (wrapping-add-i64 address 1) (wrapping-sub-u64 remaining 1) mode (wrapping-add-u64 skipped 1)

  -- | Skip all ordinary validation blocks without boxed counters or owner operations in the loop.
  validation-skip :: I64 -> U64 -> U8 -> U64 -> U64
  validation-skip address remaining mode skipped = if ge-u64 remaining 8 then
    let word = load-eight address in let flags = decode-flags-eight word mode in
    if eq-u8 flags 0 then validation-skip (wrapping-add-i64 address 8) (wrapping-sub-u64 remaining 8) mode (wrapping-add-u64 skipped 8)
    else validation-fringe address 8 mode skipped
    else validation-fringe address remaining mode skipped

  -- | Avoid a following SIMD block when the first byte already requires validation.
  validation-entry :: I64 -> U64 -> U8 -> U64
  validation-entry address remaining mode = if eq-u64 remaining 0 then 0 else
    let byte = load-one address in if validation-special byte mode then 0 else validation-skip address remaining mode 0

  -- | Validate all special bytes, counting escapes after machine-only ordinary-span scans.
  validate-from :: Bytes -> Nat -> U8 -> U64 -> Result UrlFailure U64
  validate-from input i mode counts = if i < bytes-len input then
    let base = bytes-data input in let offset = nat-to-i64 i in let address = wrapping-add-i64 base offset in
    let remaining = wrapping-i64-to-u64 (nat-to-i64 (bytes-len input - i)) in
    let skipped = hold-input input (validation-entry address remaining mode) in
    let stop = i + word-natural skipped in
    if stop < bytes-len input then validate-one input stop mode counts else Ok counts
    else Ok counts

  -- | Check one scalar percent, plus or host byte with precise original component offsets.
  validate-one :: Bytes -> Nat -> U8 -> U64 -> Result UrlFailure U64
  validate-one input i mode counts = if i < bytes-len input then
    let byte = bytes-get input i in
    if byte == 37 then case validate-percent input i mode of
      Err error -> Err error
      Ok value -> validate-from input (i + 3) mode (merge-counts counts 1)
    else if eq-u8 mode 6 && byte == 43 then validate-from input (i + 1) mode (bit-or-u64 counts 9223372036854775808)
    else if (eq-u8 mode 3 || eq-u8 mode 4) && byte < 128 then
      let raw = wrapping-i64-to-u8 (nat-to-i64 byte) in let action = classify-one raw mode in
      if ne-u8 action 0 then Err (url-failure UrlInvalidHost i (part input i 1))
      else validate-from input (i + 1) mode counts
    else validate-from input (i + 1) mode counts
    else Ok counts

  -- | Decode already validated input, copying complete ordinary spans exactly once.
  decode-from :: Bytes -> Nat -> Bytes -> Nat -> U8 -> Unit
  decode-from input start out oi mode =
    let stop = next-special input start mode True in
    if start <= stop && stop <= bytes-len input && oi + stop - start <= bytes-len out then
      let copied = if start < stop then bytes-copy-range out input oi start (stop - start) else () in
      let next = oi + stop - start in
      if stop < bytes-len input then
        if bytes-get input stop == 43 && eq-u8 mode 6 && next < bytes-len out then
          let written = bytes-set out next 32 in decode-from input (stop + 1) out (next + 1) mode
        else case validate-percent input stop mode of
          Err error -> ()
          Ok value -> if value <= 255 && next < bytes-len out then
            let written = bytes-set out next value in decode-from input (stop + 3) out (next + 1) mode
            else ()
      else ()
    else ()

  -- | Decode a complete component to fresh arbitrary bytes, or return a precise failure without partial output.
  url-unescape :: UrlEncoding -> Bytes -> Result UrlFailure Bytes
  url-unescape encoding input =
    let mode = encoding-mode encoding in case validate-from input 0 mode 0 of
      Err error -> Err error
      Ok counts ->
        let percent = word-natural (bit-and-u64 counts 9223372036854775807) in
        if percent * 2 <= bytes-len input then
          let out = bytes-new (bytes-len input - percent * 2) in
          if eq-u64 counts 0 && bytes-len input <= bytes-len out then let copied = bytes-copy-range out input 0 0 (bytes-len input) in Ok out
          else let written = decode-from input 0 out 0 mode in Ok out
        else Err (bad-escape input 0)

  -- | Verify the additional character policy of a raw path/fragment hint before percent decoding.
  hint-valid-from :: Bytes -> Nat -> U8 -> Option UrlFailure
  hint-valid-from input i mode =
    if i >= bytes-len input then None
    else if i + 8 <= bytes-len input then
      let address = wrapping-add-i64 (bytes-data input) (nat-to-i64 i) in
      let word = hold-input input (load-eight address) in let flags = classify-eight word mode in
      if eq-u64 flags 0 then hint-valid-from input (i + 8) mode else hint-valid-one input i mode
    else hint-valid-one input i mode

  -- | Identify the first raw hint byte that is neither pchar punctuation nor an allowed path/fragment byte.
  hint-valid-one :: Bytes -> Nat -> U8 -> Option UrlFailure
  hint-valid-one input i mode = if i < bytes-len input then
    let byte = bytes-get input i in let raw = wrapping-i64-to-u8 (nat-to-i64 byte) in
    let action = classify-one raw mode in
    if eq-u8 action 0 then hint-valid-from input (i + 1) mode
    else Some (url-failure UrlInvalidEscape i (part input i 1))
    else None

  -- | Decode a raw path/fragment hint only when all original characters and percent triplets are valid.
  unescape-hint :: UrlEncoding -> Bytes -> Result UrlFailure Bytes
  unescape-hint encoding input =
    let mode = hint-mode encoding in case hint-valid-from input 0 mode of
      Some error -> Err error
      None -> url-unescape encoding input

  -- | Decode a raw path hint only when its pchar spellings and percent triplets are valid.
  url-unescape-path-hint :: Bytes -> Result UrlFailure Bytes
  url-unescape-path-hint input = unescape-hint UrlPath input

  -- | Decode a raw fragment hint only when its pchar spellings and percent triplets are valid.
  url-unescape-fragment-hint :: Bytes -> Result UrlFailure Bytes
  url-unescape-fragment-hint input = unescape-hint UrlFragment input

  -- | Escape one arbitrary-byte path segment, including every slash inside the segment.
  url-path-escape :: Bytes -> Bytes
  url-path-escape input = url-escape UrlPathSegment input

  -- | Percent-decode a path component without treating plus as a space.
  url-path-unescape :: Bytes -> Result UrlFailure Bytes
  url-path-unescape input = url-unescape UrlPathSegment input

  -- | Escape one arbitrary-byte query key or value, using plus for space.
  url-query-escape :: Bytes -> Bytes
  url-query-escape input = url-escape UrlQueryComponent input

  -- | Decode a query key or value, mapping plus to space and retaining arbitrary decoded bytes.
  url-query-unescape :: Bytes -> Result UrlFailure Bytes
  url-query-unescape input = url-unescape UrlQueryComponent input

  -- | Escape UTF-8 text as an ASCII path segment; decoding remains byte based.
  url-path-escape-text :: String -> String
  url-path-escape-text text = case string-from-bytes (url-path-escape (string-to-bytes text)) of Some out -> out; None -> empty-string

  -- | Escape UTF-8 text as an ASCII query component; decoding remains byte based.
  url-query-escape-text :: String -> String
  url-query-escape-text text = case string-from-bytes (url-query-escape (string-to-bytes text)) of Some out -> out; None -> empty-string

  -- | Generated URL byte-policy kernels; regenerate with tooling/generate_url_kernels.py.
  -- Scalar actions are 0 for ordinary bytes, 1 for query spaces and 2 for percent escaping.
  prim classify-one :: U8 -> U8 -> U8 where
    llvm {
      %v0 = or i8 %0, 32
      %v1 = icmp uge i8 %v0, 97
      %v2 = icmp ule i8 %v0, 122
      %v3 = and i1 %v1, %v2
      %v4 = icmp uge i8 %0, 48
      %v5 = icmp ule i8 %0, 57
      %v6 = and i1 %v4, %v5
      %v7 = icmp eq i8 %0, 32
      %v8 = icmp eq i8 %0, 33
      %v9 = icmp eq i8 %0, 34
      %v10 = icmp eq i8 %0, 36
      %v11 = icmp eq i8 %0, 37
      %v12 = icmp eq i8 %0, 38
      %v13 = icmp eq i8 %0, 39
      %v14 = icmp eq i8 %0, 40
      %v15 = icmp eq i8 %0, 41
      %v16 = icmp eq i8 %0, 42
      %v17 = icmp eq i8 %0, 43
      %v18 = icmp eq i8 %0, 44
      %v19 = icmp eq i8 %0, 45
      %v20 = icmp eq i8 %0, 46
      %v21 = icmp eq i8 %0, 47
      %v22 = icmp eq i8 %0, 58
      %v23 = icmp eq i8 %0, 59
      %v24 = icmp eq i8 %0, 60
      %v25 = icmp eq i8 %0, 61
      %v26 = icmp eq i8 %0, 62
      %v27 = icmp eq i8 %0, 63
      %v28 = icmp eq i8 %0, 64
      %v29 = icmp eq i8 %0, 91
      %v30 = icmp eq i8 %0, 93
      %v31 = icmp eq i8 %0, 95
      %v32 = icmp eq i8 %0, 126
      %v33 = or i1 %v3, %v6
      %v34 = or i1 %v33, %v19
      %v35 = or i1 %v34, %v31
      %v36 = or i1 %v35, %v20
      %v37 = or i1 %v36, %v32
      %v38 = or i1 %v37, %v10
      %v39 = or i1 %v38, %v12
      %v40 = or i1 %v39, %v17
      %v41 = or i1 %v40, %v18
      %v42 = or i1 %v41, %v21
      %v43 = or i1 %v42, %v22
      %v44 = or i1 %v43, %v23
      %v45 = or i1 %v44, %v25
      %v46 = or i1 %v45, %v28
      %v47 = icmp eq i8 %1, 1
      %v48 = select i1 %v47, i1 %v46, i1 %v37
      %v49 = or i1 %v37, %v10
      %v50 = or i1 %v49, %v12
      %v51 = or i1 %v50, %v17
      %v52 = or i1 %v51, %v22
      %v53 = or i1 %v52, %v25
      %v54 = or i1 %v53, %v28
      %v55 = icmp eq i8 %1, 2
      %v56 = select i1 %v55, i1 %v54, i1 %v48
      %v57 = or i1 %v37, %v8
      %v58 = or i1 %v57, %v9
      %v59 = or i1 %v58, %v10
      %v60 = or i1 %v59, %v12
      %v61 = or i1 %v60, %v13
      %v62 = or i1 %v61, %v14
