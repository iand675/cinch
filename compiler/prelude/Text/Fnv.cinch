-- | Deterministic 32- and 64-bit FNV-1 and FNV-1a hashing over bytes.
-- Overflow wraps explicitly. Update functions accept a finished hash, so chunked
-- and concatenated input agree. Empty input yields the offset basis, and empty
-- updates leave the state unchanged. Inline LLVM unrolls eight ordered steps at
-- a time; the recurrence stays sequential. These non-cryptographic hashes are
-- separate from the collection hashing vocabulary in Data.Hash.
module Text.Fnv where

  import Data.Bool
  import Data.Bytes
  import Data.Bytes.Word
  import Data.Machine
  import Data.Nat

  export fnv32, fnv32a, fnv64, fnv64a
  export fnv32-update, fnv32a-update, fnv64-update, fnv64a-update

  -- | Compute 32-bit FNV-1, multiplying before xor, with offset basis 0x811C9DC5.
  fnv32 :: Bytes -> U32
  fnv32 b = fnv32-update 0x811C9DC5 b

  -- | Compute 32-bit FNV-1a, xor before multiplying, with offset basis 0x811C9DC5.
  fnv32a :: Bytes -> U32
  fnv32a b = fnv32a-update 0x811C9DC5 b

  -- | Compute 64-bit FNV-1, multiplying before xor, with offset basis 0xCBF29CE484222325.
  fnv64 :: Bytes -> U64
  fnv64 b = fnv64-update 0xCBF29CE484222325 b

  -- | Compute 64-bit FNV-1a, xor before multiplying, with offset basis 0xCBF29CE484222325.
  fnv64a :: Bytes -> U64
  fnv64a b = fnv64a-update 0xCBF29CE484222325 b

  -- | Continue a finished 32-bit FNV-1 hash with more bytes; an empty update preserves the hash.
  fnv32-update :: U32 -> Bytes -> U32
  fnv32-update previous b = fold32 False b 0 previous

  -- | Continue a finished 32-bit FNV-1a hash with more bytes; an empty update preserves the hash.
  fnv32a-update :: U32 -> Bytes -> U32
  fnv32a-update previous b = fold32 True b 0 previous

  -- | Continue a finished 64-bit FNV-1 hash with more bytes; an empty update preserves the hash.
  fnv64-update :: U64 -> Bytes -> U64
  fnv64-update previous b = fold64 False b 0 previous

  -- | Continue a finished 64-bit FNV-1a hash with more bytes; an empty update preserves the hash.
  fnv64a-update :: U64 -> Bytes -> U64
  fnv64a-update previous b = fold64 True b 0 previous

  -- | Hash native eight-byte blocks in order, then the exact byte tail; the flag selects xor-before-multiply.
  fold32 :: Bool -> Bytes -> Nat -> U32 -> U32
  fold32 alternate b i acc =
    if i + 8 <= bytes-len b then
      fold32 alternate b (i + 8) (fnv32-word acc (bytes-read-le64 b i) (if alternate then 1 else 0))
    else if i < bytes-len b then
      let v = wrapping-i64-to-u32 (nat-to-i64 (bytes-get b i)) in
      let next = if alternate then wrapping-mul-u32 (bit-xor-u32 acc v) 0x01000193 else bit-xor-u32 (wrapping-mul-u32 acc 0x01000193) v in
      fold32 alternate b (i + 1) next
    else acc

  -- | Hash native eight-byte blocks without reassociating the recurrence, followed by a scalar tail.
  fold64 :: Bool -> Bytes -> Nat -> U64 -> U64
  fold64 alternate b i acc =
    if i + 8 <= bytes-len b then
      fold64 alternate b (i + 8) (fnv64-word acc (bytes-read-le64 b i) (if alternate then 1 else 0))
    else if i < bytes-len b then
      let v = wrapping-i64-to-u64 (nat-to-i64 (bytes-get b i)) in
      let next = if alternate then wrapping-mul-u64 (bit-xor-u64 acc v) 0x00000100000001B3 else bit-xor-u64 (wrapping-mul-u64 acc 0x00000100000001B3) v in
      fold64 alternate b (i + 1) next
    else acc

  -- | Unroll eight ordered FNV steps; the recurrence is sequential, so lanes must not be reassociated.
  prim fnv32-word :: U32 -> U64 -> U8 -> U32 where
    llvm {
      %alternate = icmp ne i8 %2, 0
      %s0 = lshr i64 %1, 0
      %v0 = and i64 %s0, 255
      %b0 = trunc i64 %v0 to i32
      %x0 = xor i32 %0, %b0
      %a0 = mul i32 %x0, 16777619
      %m0 = mul i32 %0, 16777619
      %f0 = xor i32 %m0, %b0
      %r0 = select i1 %alternate, i32 %a0, i32 %f0
      %s1 = lshr i64 %1, 8
      %v1 = and i64 %s1, 255
      %b1 = trunc i64 %v1 to i32
      %x1 = xor i32 %r0, %b1
      %a1 = mul i32 %x1, 16777619
      %m1 = mul i32 %r0, 16777619
      %f1 = xor i32 %m1, %b1
      %r1 = select i1 %alternate, i32 %a1, i32 %f1
      %s2 = lshr i64 %1, 16
      %v2 = and i64 %s2, 255
      %b2 = trunc i64 %v2 to i32
      %x2 = xor i32 %r1, %b2
      %a2 = mul i32 %x2, 16777619
      %m2 = mul i32 %r1, 16777619
      %f2 = xor i32 %m2, %b2
      %r2 = select i1 %alternate, i32 %a2, i32 %f2
      %s3 = lshr i64 %1, 24
      %v3 = and i64 %s3, 255
      %b3 = trunc i64 %v3 to i32
      %x3 = xor i32 %r2, %b3
      %a3 = mul i32 %x3, 16777619
      %m3 = mul i32 %r2, 16777619
      %f3 = xor i32 %m3, %b3
      %r3 = select i1 %alternate, i32 %a3, i32 %f3
      %s4 = lshr i64 %1, 32
      %v4 = and i64 %s4, 255
      %b4 = trunc i64 %v4 to i32
      %x4 = xor i32 %r3, %b4
      %a4 = mul i32 %x4, 16777619
      %m4 = mul i32 %r3, 16777619
      %f4 = xor i32 %m4, %b4
      %r4 = select i1 %alternate, i32 %a4, i32 %f4
      %s5 = lshr i64 %1, 40
      %v5 = and i64 %s5, 255
      %b5 = trunc i64 %v5 to i32
      %x5 = xor i32 %r4, %b5
      %a5 = mul i32 %x5, 16777619
      %m5 = mul i32 %r4, 16777619
      %f5 = xor i32 %m5, %b5
      %r5 = select i1 %alternate, i32 %a5, i32 %f5
      %s6 = lshr i64 %1, 48
      %v6 = and i64 %s6, 255
      %b6 = trunc i64 %v6 to i32
      %x6 = xor i32 %r5, %b6
      %a6 = mul i32 %x6, 16777619
      %m6 = mul i32 %r5, 16777619
      %f6 = xor i32 %m6, %b6
      %r6 = select i1 %alternate, i32 %a6, i32 %f6
      %s7 = lshr i64 %1, 56
      %v7 = and i64 %s7, 255
      %b7 = trunc i64 %v7 to i32
      %x7 = xor i32 %r6, %b7
      %a7 = mul i32 %x7, 16777619
      %m7 = mul i32 %r6, 16777619
      %f7 = xor i32 %m7, %b7
      %r7 = select i1 %alternate, i32 %a7, i32 %f7
      ret i32 %r7
    }

  -- | Unroll eight ordered FNV steps; the recurrence is sequential, so lanes must not be reassociated.
  prim fnv64-word :: U64 -> U64 -> U8 -> U64 where
    llvm {
      %alternate = icmp ne i8 %2, 0
      %s0 = lshr i64 %1, 0
      %v0 = and i64 %s0, 255
      %x0 = xor i64 %0, %v0
      %a0 = mul i64 %x0, 1099511628211
      %m0 = mul i64 %0, 1099511628211
      %f0 = xor i64 %m0, %v0
      %r0 = select i1 %alternate, i64 %a0, i64 %f0
      %s1 = lshr i64 %1, 8
      %v1 = and i64 %s1, 255
      %x1 = xor i64 %r0, %v1
      %a1 = mul i64 %x1, 1099511628211
      %m1 = mul i64 %r0, 1099511628211
      %f1 = xor i64 %m1, %v1
      %r1 = select i1 %alternate, i64 %a1, i64 %f1
      %s2 = lshr i64 %1, 16
      %v2 = and i64 %s2, 255
      %x2 = xor i64 %r1, %v2
      %a2 = mul i64 %x2, 1099511628211
      %m2 = mul i64 %r1, 1099511628211
      %f2 = xor i64 %m2, %v2
      %r2 = select i1 %alternate, i64 %a2, i64 %f2
      %s3 = lshr i64 %1, 24
      %v3 = and i64 %s3, 255
      %x3 = xor i64 %r2, %v3
      %a3 = mul i64 %x3, 1099511628211
      %m3 = mul i64 %r2, 1099511628211
      %f3 = xor i64 %m3, %v3
      %r3 = select i1 %alternate, i64 %a3, i64 %f3
      %s4 = lshr i64 %1, 32
      %v4 = and i64 %s4, 255
      %x4 = xor i64 %r3, %v4
      %a4 = mul i64 %x4, 1099511628211
      %m4 = mul i64 %r3, 1099511628211
      %f4 = xor i64 %m4, %v4
      %r4 = select i1 %alternate, i64 %a4, i64 %f4
      %s5 = lshr i64 %1, 40
      %v5 = and i64 %s5, 255
      %x5 = xor i64 %r4, %v5
      %a5 = mul i64 %x5, 1099511628211
      %m5 = mul i64 %r4, 1099511628211
      %f5 = xor i64 %m5, %v5
      %r5 = select i1 %alternate, i64 %a5, i64 %f5
      %s6 = lshr i64 %1, 48
      %v6 = and i64 %s6, 255
      %x6 = xor i64 %r5, %v6
      %a6 = mul i64 %x6, 1099511628211
      %m6 = mul i64 %r5, 1099511628211
      %f6 = xor i64 %m6, %v6
      %r6 = select i1 %alternate, i64 %a6, i64 %f6
      %s7 = lshr i64 %1, 56
      %v7 = and i64 %s7, 255
      %x7 = xor i64 %r6, %v7
      %a7 = mul i64 %x7, 1099511628211
      %m7 = mul i64 %r6, 1099511628211
      %f7 = xor i64 %m7, %v7
      %r7 = select i1 %alternate, i64 %a7, i64 %f7
      ret i64 %r7
    }
