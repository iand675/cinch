-- Algebra.Monoid: semigroups with an identity element.
--
-- `Monoid` adds the identity to the associative `<>`
-- (Algebra.Semigroup). The import below is explicit because a class
-- constraint entails nothing (the standing no-superbundle rule):
-- `Monoid` does not extend `Semigroup`, and every function states the
-- constraints it uses. The `infixr 6 <>` redeclaration is decision
-- D2's per-module fixity style (a redundant declaration of the same
-- fixity is accepted); the imported declaration is the source of
-- truth.
--
-- `mempty` is the nullary class method `mempty :: a` (the higher-kinded
-- slice lifted the function-type requirement on class methods): the
-- dictionary carries the identity value directly, so call sites write
-- `mempty`.
--
-- Laws (asserted over sample values in compiler/tests/lib_algebra.rs):
--   left unit:  mempty <> x == x
--   right unit: x <> mempty == x
-- plus associativity of `<>` from Algebra.Semigroup.
--
-- Instance homes. The newtypes below exist only to carry instances, so
-- the base library scheme puts them with their class module (here).
-- Every instance lives with its type: the newtypes' Semigroup and
-- Monoid instances are both here because the newtypes are declared
-- here. The carriers that are existing prelude types (List, Option,
-- Ordering, String) get their cross instances parked in the class
-- module for now (their real homes are the types' Data.* modules after
-- the prelude split, an integration step after the P19 surface slice).
-- Structural instances over functions and tuples live with the class
-- module permanently; the Semigroup halves of those live in
-- Algebra.Semigroup.
module Algebra.Monoid where

  import Algebra.Semigroup

  infixr 6 <>

  signature Monoid a where
    mempty :: a

  -- ------------------------------------------------------------------
  -- The instance-carrying newtypes (design/base-library.md: "the
  -- newtypes that exist only to carry instances live with their class
  -- module"). Their instances live with their type, so both the
  -- Semigroup and Monoid instances of each are declared here.

  -- Nat under addition: `Sum x <> Sum y` adds. The bare `Nat` gets no
  -- Semigroup instance (two monoids live on Nat; the newtype chooses).
  data Sum where
    Sum :: Nat -> Sum

  implicit instance Semigroup_Sum :: Semigroup Sum where
    (<>) x y = case x of
      Sum a -> case y of
        Sum b -> Sum (a + b)

  implicit instance Monoid_Sum :: Monoid Sum where
    mempty = Sum 0

  -- Nat under multiplication.
  data Product where
    Product :: Nat -> Product

  implicit instance Semigroup_Product :: Semigroup Product where
    (<>) x y = case x of
      Product a -> case y of
        Product b -> Product (a * b)

  implicit instance Monoid_Product :: Monoid Product where
    mempty = Product 1

  -- Dual: composition in the opposite order. `Dual x <> Dual y`
  -- combines y before x, turning any monoid into its opposite.
  data Dual t where
    Dual :: t -> Dual t

  implicit instance Semigroup_Dual t :: using (sa :: Semigroup t) => Semigroup (Dual t) where
    (<>) x y = case x of
      Dual p -> case y of
        Dual q -> Dual ((<>) q p)

  implicit instance Monoid_Dual t :: using (ma :: Monoid t) => Monoid (Dual t) where
    mempty = Dual mempty

  -- First: the leftmost `Some`, in a wrapper that keeps this choice
  -- apart from Option's own first-some reading (they agree today; the
  -- wrapper makes the intent explicit and leaves Option free).
  data First t where
    First :: Option t -> First t

  implicit instance Semigroup_First t :: Semigroup (First t) where
    (<>) x y = case x of
      First o -> case o of
        None -> y
        Some _ -> x

  implicit instance Monoid_First t :: Monoid (First t) where
    mempty = First None

  -- Last: the rightmost `Some`.
  data Last t where
    Last :: Option t -> Last t

  implicit instance Semigroup_Last t :: Semigroup (Last t) where
    (<>) x y = case y of
      Last o -> case o of
        None -> x
        Some _ -> y

  implicit instance Monoid_Last t :: Monoid (Last t) where
    mempty = Last None

  -- Endo: endomorphisms under composition. `Endo f <> Endo g` is
  -- `f` after `g` (like `(.)`), and `mempty` is the identity, so
  -- folding `<>` over endomorphisms chains them left to right.
  data Endo t where
    Endo :: (t -> t) -> Endo t

  implicit instance Semigroup_Endo t :: Semigroup (Endo t) where
    (<>) x y = case x of
      Endo f -> case y of
        Endo g -> Endo (\z -> f (g z))

  implicit instance Monoid_Endo t :: Monoid (Endo t) where
    mempty = Endo (\x -> x)

  -- ------------------------------------------------------------------
  -- Cross instances of existing prelude types (parked here; see the
  -- header). Each pairs with its Semigroup instance in
  -- Algebra.Semigroup.

  -- Lists under append; the empty list is the identity.
  implicit instance Monoid_List t :: Monoid (List t) where
    mempty = Nil

  -- Option under first-some; `None` is the identity.
  implicit instance Monoid_Option t :: Monoid (Option t) where
    mempty = None

  -- Ordering under lexicographic composition; `EQ` is the identity.
  implicit instance Monoid_Ordering :: Monoid Ordering where
    mempty = EQ

  -- Strings under concatenation; the empty string is the identity.
  -- NOTE: `empty-string` is a prelude function name (decision D106's
  -- dash spelling). It is the prelude String's designated empty value
  -- (String (bytes-new 0) under the UTF-8 rules).
  implicit instance Monoid_String :: Monoid String where
    mempty = empty-string

  -- ------------------------------------------------------------------
  -- Structural instances (functions and tuples), with the class
  -- module.

  -- A function into a monoid is a monoid pointwise: the identity is the
  -- function returning the identity. Eta-expanded like the function
  -- Semigroup above: `mempty x` is the identity at x.
  implicit instance Monoid_Function t u :: using (mb :: Monoid u) => Monoid (t -> u) where
    mempty x = mempty

  -- Tuples of monoids are monoids componentwise.
  implicit instance Monoid_Pair t u :: using (ma :: Monoid t, mb :: Monoid u) => Monoid (t, u) where
    mempty = (mempty, mempty)
