  -- Sequencing providers for `do` notation (runtime capabilities,
  -- effects and sequencing specification, "Unqualified do through
  -- modules and typeclasses"; design section 5). The same `do` spelling
  -- types differently per provider: direct sequencing is the default and
  -- a `using` binder with a provider head selects another. `pure` and
  -- `bind` are the provider's class methods (decision D2).

  signature DirectSequencing where
    pure :: forall a. a -> a
    bind :: forall a b ef. a -> (a ->{ef} b) ->{ef} b

  implicit instance SeqDirect :: DirectSequencing where
    pure x = x
    bind v k = k v

  signature ResultSequencing e where
    pure :: forall a. a -> Result e a
    bind :: forall a b ef. Result e a -> (a ->{ef} Result e b) ->{ef} Result e b

  implicit instance SeqResult e :: ResultSequencing e where
    pure x = Ok x
    bind r k = case r of
      Err err -> Err err
      Ok x -> k x

  signature OptionSequencing where
    pure :: forall a. a -> Option a
    bind :: forall a b ef. Option a -> (a ->{ef} Option b) ->{ef} Option b

  implicit instance SeqOption :: OptionSequencing where
    pure x = Some x
    bind o k = case o of
      None -> None
      Some x -> k x

  -- ================================================================
  -- Target profiles and the scalar/SIMD pair (P10): target capability
  -- evidence, the scalar/SIMD pair of the platform chapter's section 5
  -- example, capability dispatch, and the step-form producer library
  -- that fusion composes (modules and compilation specification
  -- section 6).
  -- ================================================================

  -- Target profiles and vector shapes as marker types: the platform
  -- chapter's `Target` kind and the compile-time lane width are
  -- represented as types in the bootstrap (decision D58).
  data AVX2_256 where
    AVX2_256Tag :: AVX2_256

  data NEON64 where
    NEON64Tag :: NEON64

  data ScalableShape where
    ScalableShapeTag :: ScalableShape

  data EightLanes where
    EightLanesTag :: EightLanes

  -- The u32-sum capability: its construction establishes that the sum
  -- intrinsics may execute in the current environment (platform proofs
  -- and SIMD specification section 2). The method is the width evidence
  -- a generic proof consumes (section 6).
  signature VecU32Target t w where
    positive-width :: Unit -> Nat

  -- Operational evidence that a capability is valid in the current
  -- validity scope (platform section 2): the lexical region and thread
  -- supplying it. A rewrite's `require` clause names it.
  data CapAvailable t w where
    Available :: VecU32Target t w -> CapAvailable t w

  -- The vector step form (modules section 6): `Done`, `Skip(state)` and
  -- `Yield(value, state)`. Producer pipelines lower to state machines.
  data Step s a where
    Done :: Step s a
    Skip :: s -> Step s a
    Yield :: a -> s -> Step s a

  -- A producer: a state with its step function.
  data Producer s a where
    Producer :: (s -> Step s a) -> s -> Producer s a

  prod-map :: forall s a b. (a -> b) -> Producer s a -> Producer s b
  prod-map f p = case p of
    Producer step s0 ->
      Producer (\s -> case step s of
        Done -> Done
        Skip s1 -> Skip s1
        Yield x s1 -> Yield (f x) s1) s0

  data TakeSt s where
    TakeSt :: Nat -> s -> TakeSt s

  prod-take-step :: forall s a. (s -> Step s a) -> TakeSt s -> Step (TakeSt s) a
  prod-take-step step st = case st of
    TakeSt k s0 ->
      if k == 0 then Done
      else case step s0 of
        Done -> Done
        Skip s1 -> Skip (TakeSt k s1)
        Yield x s1 -> Yield x (TakeSt (k - 1) s1)

  prod-take :: forall s a. Nat -> Producer s a -> Producer (TakeSt s) a
  prod-take n p = case p of
    Producer step s0 -> Producer (prod-take-step step) (TakeSt n s0)

  prod-fold-go :: forall s a b. (s -> Step s a) -> (b -> a -> b) -> b -> s -> b
  prod-fold-go step k acc s = case step s of
    Done -> acc
    Skip s1 -> prod-fold-go step k acc s1
    Yield x s1 -> prod-fold-go step k (k acc x) s1

  prod-fold :: forall s a b. b -> (b -> a -> b) -> Producer s a -> b
  prod-fold z k p = case p of
    Producer step s0 -> prod-fold-go step k z s0

  -- The scalar model (platform section 5): the sum modulo 2^32 over the
  -- borrowed vector.
  zero-u32 :: U32
  zero-u32 = min-bound-u32

  -- A producer over a borrowed vector: the block walk of the step form
  -- is the `vecStreamStep` intrinsic.
  vec-stream :: forall n a region. Ref region (Vec n a) -> Producer (Ref region (Vec n a)) a
  vec-stream xs = Producer vecStreamStep xs

  scalar-sum-wrap32 :: forall n region. Ref region (Vec n U32) -> U32
  scalar-sum-wrap32 xs = prod-fold zero-u32 wrapping-add-u32 (vec-stream xs)

  -- The SIMD intrinsic (the scalar/SIMD pair): its bootstrap lowering is
  -- the scalar loop, and the artifact manifest records which lowering
  -- was checked (platform section 8).
  simd-sum-wrap32 :: forall t w n region. (vectors :: VecU32Target t w) -> Ref region (Vec n U32) -> U32
  simd-sum-wrap32 vectors xs = scalar-sum-wrap32 xs

  -- Capability dispatch (platform section 7): the bootstrap runtime
  -- performs no feature detection, so dispatch conservatively selects
  -- the scalar path. The boundary is replaceable: the optimizer never
  -- folds this call or the `case` around it.
  detect-vec-u32 :: Unit -> Option (VecU32Target AVX2_256 EightLanes)
  detect-vec-u32 u = None

  -- The instruction law (platform section 5): the scalar model and the
  -- SIMD intrinsic compute the same sum. Discharging it is a proof
  -- obligation of the target library; a rewrite citing it records the
  -- assumption in the artifact manifest (decision D55).
  signature SumProofs where
    scalar-to-simd :: forall t w n region. (vectors :: VecU32Target t w) -> (xs :: Ref region (Vec n U32)) -> Eq (scalar-sum-wrap32 xs) (simd-sum-wrap32 vectors xs)

  -- Structured concurrency (concurrency specification, section 2): the
  -- worked vocabulary of the spec's `loadPair` sketch. A `Request` names
  -- bytes to read from the runtime's input source; `fetch` performs the
  -- read under the `Io r` capability and reports a short read as a
  -- `LoadError`. `withScope`, `spawn`, `joinAllOrCancel` and the `Io r`
  -- operations (`ioWrite`, `ioRead`, `ioSleep`, `pollCancel`) are builtin
  -- values with compiler-known schemes (like `newIO`), never foreign
  -- imports.
  data Request where
    Request :: Nat -> Request

  data LoadError where
    LoadError :: Nat -> LoadError

  fetch :: forall r. using (io :: Io r) => Request ->{IO r, Diverge} Result LoadError Bytes
  fetch (Request n) = case ioRead n of
    None -> Err (LoadError 1)
    Some b -> Ok b

  -- The worked vocabulary of the sequencing chapter's `loadConfig`
  -- sketch (runtime capabilities, effects and sequencing specification,
  -- "Unqualified do through modules and typeclasses"), provided over the
  -- runtime's input source like `fetch` is above. A `Path` names bytes to
  -- read; `read-config-bytes` performs the read under the `Io r`
  -- capability and reports a short read as a `ConfigError`. `parse-config`
  -- is pure over the read bytes: the bootstrap's config document is the
  -- payload, and an empty document is not a config.
  data Path where
    Path :: Nat -> Path

  data ConfigError where
    BadConfig :: ConfigError

  data Config where
    Config :: Bytes -> Config

  read-config-bytes :: forall r. using (io :: Io r) => Path ->{IO r, Diverge} Result ConfigError Bytes
  read-config-bytes (Path n) = case ioRead n of
    None -> Err BadConfig
    Some b -> Ok b

  parse-config :: Bytes -> Result ConfigError Config
  parse-config b = case bytes-len b of
    0 -> Err BadConfig
    _ -> Ok (Config b)

  -- ---------------------------------------------------------------------------
  -- Bit manipulation (primitive types specification section 4).
  --
  -- The `Bits` class unifies the per-type primitive families so generic
  -- code can be written over machine integers. All methods are total,
  -- following the specification: the bitwise operations are total,
  -- shifts reduce the count modulo the width (the wrapping family), and
  -- rotates are total. The checked shift family stays as the per-type
  -- `checkedShlX`/`checkedShrX` primitives. `test-bit`/`set-bit`/
  -- `clear-bit`/`complement-bit` are expressed through the mask rule: bit
  -- position n means position n modulo the width, consistent with the
  -- shift rule.

  signature Bits a where
    bit-and :: a -> a -> a
    bit-or :: a -> a -> a
    bit-xor :: a -> a -> a
    bit-not :: a -> a
    shift-left :: a -> U32 -> a
    shift-right :: a -> U32 -> a
    rotate-left :: a -> U32 -> a
    rotate-right :: a -> U32 -> a
    test-bit :: a -> U32 -> Bool
    set-bit :: a -> U32 -> a
    clear-bit :: a -> U32 -> a
    complement-bit :: a -> U32 -> a
    count-ones :: a -> U32
    leading-zeros :: a -> U32
    trailing-zeros :: a -> U32

  implicit instance Bits_I8 :: Bits I8 where
    bit-and x y = bit-and-i8 x y
    bit-or x y = bit-or-i8 x y
    bit-xor x y = bit-xor-i8 x y
    bit-not x = bit-not-i8 x
    shift-left x n = wrapping-shl-i8 x n
    shift-right x n = wrapping-shr-i8 x n
    rotate-left x n = rotate-left-i8 x n
    rotate-right x n = rotate-right-i8 x n
    test-bit x n = ne-i8 (bit-and-i8 x (wrapping-shl-i8 1 n)) 0
    set-bit x n = bit-or-i8 x (wrapping-shl-i8 1 n)
    clear-bit x n = bit-and-i8 x (bit-not-i8 (wrapping-shl-i8 1 n))
    complement-bit x n = bit-xor-i8 x (wrapping-shl-i8 1 n)
