  signature Eq a where
    (==) :: a -> a -> Bool
    (/=) :: a -> a -> Bool

  signature Ord a where
    (<) :: a -> a -> Bool
    (<=) :: a -> a -> Bool
    (>) :: a -> a -> Bool
    (>=) :: a -> a -> Bool

  signature Add a where
    (+) :: a -> a -> a

  signature Sub a where
    (-) :: a -> a -> a

  signature Mul a where
    (*) :: a -> a -> a

  signature Neg a where
    negate :: a -> a

  infixl 6 +, -
  infixl 7 *
  infix 4 ==, /=
  infix 4 <, <=, >, >=
  infixr 3 &&
  infixr 2 ||

  -- These are strict functions in the bootstrap slice; the surface `&&`
  -- and `||` short-circuit once that deviation is corrected (primitive
  -- types specification, section 6).
  (&&) :: Bool -> Bool -> Bool
  (&&) x y = primAndBool x y

  (||) :: Bool -> Bool -> Bool
  (||) x y = primOrBool x y

  not :: Bool -> Bool
  not b = primNotBool b

  -- The strict boolean algebra (primitive types specification, section 6).
  and :: Bool -> Bool -> Bool
  and x y = primAndBool x y

  or :: Bool -> Bool -> Bool
  or x y = primOrBool x y

  xor :: Bool -> Bool -> Bool
  xor x y = primAndBool (primOrBool x y) (primNotBool (primAndBool x y))

  identity :: forall a. a -> a
  identity x = x

  const :: forall a b. a -> b -> a
  const x y = x

  map :: forall a b. (a -> b) -> List a -> List b
  map f xs = case xs of
    Nil -> Nil
    Cons y ys -> Cons (f y) (map f ys)

  foldr :: forall a b. (a -> b -> b) -> b -> List a -> b
  foldr f z xs = case xs of
    Nil -> z
    Cons y ys -> f y (foldr f z ys)

  length :: forall a. List a -> Int
  length xs = case xs of
    Nil -> 0
    Cons y ys -> 1 + length ys

  sumList :: forall a. using (add :: Add a) => a -> List a -> a
  sumList z xs = foldr (\x acc -> x + acc) z xs

  -- Primitive types specification, section 8: class instances. Eq and
  -- Ord cover Bool, Char, the mathematical Nat and Int, every machine
  -- integer type, Usize and Isize; the order is numeric on the integer
  -- types and code point order on Char. F32 and F64 have none of these
  -- instances.

  -- Mathematical `Int` and `Nat` instances (primitive types
  -- specification, section 1): comparison through the cmp prims'
  -- immediates, arithmetic through the runtime. `Sub` on `Nat` is the
  -- runtime's truncated subtraction: the inductive `Nat` subtraction is
  -- truncated, and `natSub` faults rather than producing a negative.

  implicit instance Eq_Int :: Eq Int where
    (==) x y = eqI64 (intCmp x y) 0
    (/=) x y = neI64 (intCmp x y) 0

  implicit instance Ord_Int :: Ord Int where
    (<) x y = ltI64 (intCmp x y) 0
    (<=) x y = leI64 (intCmp x y) 0
    (>) x y = gtI64 (intCmp x y) 0
    (>=) x y = geI64 (intCmp x y) 0

  implicit instance Add_Int :: Add Int where
    (+) x y = intAdd x y

  implicit instance Sub_Int :: Sub Int where
    (-) x y = intSub x y

  implicit instance Mul_Int :: Mul Int where
    (*) x y = intMul x y

  implicit instance Neg_Int :: Neg Int where
    negate x = intNeg x

  implicit instance Eq_Nat :: Eq Nat where
    (==) x y = eqI64 (natCmp x y) 0
    (/=) x y = neI64 (natCmp x y) 0

  implicit instance Ord_Nat :: Ord Nat where
    (<) x y = ltI64 (natCmp x y) 0
    (<=) x y = leI64 (natCmp x y) 0
    (>) x y = gtI64 (natCmp x y) 0
    (>=) x y = geI64 (natCmp x y) 0

  implicit instance Add_Nat :: Add Nat where
    (+) x y = natAdd x y

  implicit instance Sub_Nat :: Sub Nat where
    (-) x y = natSub x y

  implicit instance Mul_Nat :: Mul Nat where
    (*) x y = natMul x y

  implicit instance Eq_Bool :: Eq Bool where
    (==) x y = primEqBool x y
    (/=) x y = primNeBool x y

  implicit instance Ord_Bool :: Ord Bool where
    (<) x y = primAndBool (primNotBool x) y
    (<=) x y = primNotBool (primAndBool (primNotBool y) x)
    (>) x y = primAndBool (primNotBool y) x
    (>=) x y = primNotBool (primAndBool (primNotBool x) y)

