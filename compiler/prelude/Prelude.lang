-- Prelude for the bootstrap slice.
--
-- Operators are class methods, never compiler builtins. The only
-- compiler-known operations are the `safelang.prim.*` (machine scalars)
-- and `safelang.runtime.*` (mathematical `Nat`/`Int` and `Bytes`)
-- intrinsics below, which are representation-level and declared through
-- `foreign import`, plus the builtin capability values (`newIO`, the
-- structured-concurrency surface, and the `Io r` operations) whose
-- polymorphic schemes the compiler knows directly.
--
-- The machine scalar types and their operations follow the primitive
-- types specification. Names follow decision D6 (CONFORMANCE.md): an
-- operation is a prelude-level name of the form `<op><Type>`
-- (`wrappingAddU32`) and a conversion is `<src>To<dst>`
-- (`u8ToI32`). The `checked*`, `saturating*` and `wrapping*` conversion
-- families capitalize the source type (`checkedU8ToI64`); the total
-- family lowercases it (`u8ToI32`). The specification's dotted
-- `U32.wrappingAdd` spelling is a presentation form that lands with the
-- module slice.
module Prelude where

  -- Data declarations come first: the primitive signatures mention
  -- Option (checked results) and Ordering (totalOrder).

  data Option a where
    None :: Option a
    Some :: a -> Option a

  data Result e a where
    Err :: e -> Result e a
    Ok :: a -> Result e a

  data List a where
    Nil :: List a
    Cons :: a -> List a -> List a

  data Ordering where
    LT :: Ordering
    EQ :: Ordering
    GT :: Ordering

  -- The mathematical `Nat` and `Int` (primitive types specification,
  -- section 1): boxed bignums, distinct from every machine scalar.
  foreign import ccall "safelang.runtime.natAdd" natAdd :: Nat -> Nat -> Nat
  foreign import ccall "safelang.runtime.natSub" natSub :: Nat -> Nat -> Nat
  foreign import ccall "safelang.runtime.natMul" natMul :: Nat -> Nat -> Nat
  foreign import ccall "safelang.runtime.natDiv" natDiv :: Nat -> Nat -> Nat
  foreign import ccall "safelang.runtime.natRem" natRem :: Nat -> Nat -> Nat
  foreign import ccall "safelang.runtime.natCmp" natCmp :: Nat -> Nat -> I64
  foreign import ccall "safelang.runtime.natFromI64" natFromI64 :: I64 -> Nat
  foreign import ccall "safelang.runtime.natToI64" natToI64 :: Nat -> I64
  foreign import ccall "safelang.runtime.intAdd" intAdd :: Int -> Int -> Int
  foreign import ccall "safelang.runtime.intSub" intSub :: Int -> Int -> Int
  foreign import ccall "safelang.runtime.intMul" intMul :: Int -> Int -> Int
  foreign import ccall "safelang.runtime.intDiv" intDiv :: Int -> Int -> Int
  foreign import ccall "safelang.runtime.intRem" intRem :: Int -> Int -> Int
  foreign import ccall "safelang.runtime.intNeg" intNeg :: Int -> Int
  foreign import ccall "safelang.runtime.intCmp" intCmp :: Int -> Int -> I64
  foreign import ccall "safelang.runtime.intFromI64" intFromI64 :: I64 -> Int
  foreign import ccall "safelang.runtime.intToI64" intToI64 :: Int -> I64

  -- `natCmp`/`intCmp` return the raw -1/0/1 immediate at `I64`, so
  -- equality is `eqI64 (intCmp a b) 0`. Division and remainder by zero
  -- fault with the division fault code (exit 72); `natSub` below zero and
  -- every `Bytes` fault below (out-of-bounds index, byte value outside
  -- 0..=255, a length outside `i64` range) exit through the panic path
  -- (71).

  -- `Bytes`: boxed byte buffers. Indices, lengths and byte values are
  -- `Nat` and convert through `sl_nat_to_i64`/`sl_nat_from_i64`.
  foreign import ccall "safelang.runtime.bytesNew" bytesNew :: Nat -> Bytes
  foreign import ccall "safelang.runtime.bytesLen" bytesLen :: Bytes -> Nat
  foreign import ccall "safelang.runtime.bytesGet" bytesGet :: Bytes -> Nat -> Nat
  foreign import ccall "safelang.runtime.bytesSet" bytesSet :: Bytes -> Nat -> Nat -> Unit

