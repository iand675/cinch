  signature Eq a where
    (==) :: a -> a -> Bool
    (/=) :: a -> a -> Bool

  signature Ord a where
    (<) :: a -> a -> Bool
    (<=) :: a -> a -> Bool
    (>) :: a -> a -> Bool
    (>=) :: a -> a -> Bool

  signature Add a where
    (+) :: a -> a -> a

  signature Sub a where
    (-) :: a -> a -> a

  signature Mul a where
    (*) :: a -> a -> a

  signature Neg a where
    negate :: a -> a

  -- Operator precedence follows the Rust reference table (decision D90),
  -- laid onto the 0-9 scale; every new binary operator is left
  -- associative like Rust's. The relative order of the existing
  -- operators is unchanged, so no previously valid program re-parses.
  infixl 9 *, /, %
  infixl 8 +, -
  infixl 7 <<, >>
  infixl 6 &
  infixl 5 ^
  infixl 4 |
  infix 3 ==, /=
  infix 3 <, <=, >, >=
  infixr 2 &&
  infixr 1 ||

  -- These are strict functions in the bootstrap slice; the surface `&&`
  -- and `||` short-circuit once that deviation is corrected (primitive
  -- types specification, section 6).
  (&&) :: Bool -> Bool -> Bool
  (&&) x y = prim-and-bool x y

  (||) :: Bool -> Bool -> Bool
  (||) x y = prim-or-bool x y

  not :: Bool -> Bool
  not b = prim-not-bool b

  -- The strict boolean algebra (primitive types specification, section 6).
  and :: Bool -> Bool -> Bool
  and x y = prim-and-bool x y

  or :: Bool -> Bool -> Bool
  or x y = prim-or-bool x y

  xor :: Bool -> Bool -> Bool
  xor x y = prim-and-bool (prim-or-bool x y) (prim-not-bool (prim-and-bool x y))

  identity :: forall a. a -> a
  identity x = x

  const :: forall a b. a -> b -> a
  const x y = x

  map :: forall a b. (a -> b) -> List a -> List b
  map f xs = case xs of
    Nil -> Nil
    Cons y ys -> Cons (f y) (map f ys)

  foldr :: forall a b. (a -> b -> b) -> b -> List a -> b
  foldr f z xs = case xs of
    Nil -> z
    Cons y ys -> f y (foldr f z ys)

  length :: forall a. List a -> Int
  length xs = case xs of
    Nil -> 0
    Cons y ys -> 1 + length ys

  sum-list :: forall a. using (add :: Add a) => a -> List a -> a
  sum-list z xs = foldr (\x acc -> x + acc) z xs

  -- Collection literals (surface grammar local amendments, section 10):
  -- `[a, b, c]` desugars to `from-list` at the expected type's `FromList
  -- c e` instance and `{k => v}` to `from-map` over a `List (k, v)` of
  -- pairs at the expected type's `FromMap m k v` instance; unconstrained
  -- they default to `List` and `Map`. Instances opt in per container.
  signature FromList c e where
    from-list :: List e -> c

  signature FromMap m k v where
    from-map :: List (k, v) -> m

  -- The ordered map: an unbalanced binary search tree over `Ord k`
  -- (decision D105). `map-insert` keeps the left subtree strictly
  -- smaller and the right strictly greater, so a repeated key replaces
  -- the stored value in place.
  data Map k v where
    Tip :: Map k v
    Bin :: k -> v -> Map k v -> Map k v -> Map k v

  map-insert :: forall k v. using (ord :: Ord k) => k -> v -> Map k v -> Map k v
  map-insert k v m = case m of
    Tip -> Bin k v Tip Tip
    Bin k2 v2 l r ->
      if k < k2 then Bin k2 v2 (map-insert k v l) r
      else if k2 < k then Bin k2 v2 l (map-insert k v r)
      else Bin k v l r

  map-lookup :: forall k v. using (ord :: Ord k) => k -> Map k v -> Option v
  map-lookup k m = case m of
    Tip -> None
    Bin k2 v2 l r ->
      if k < k2 then map-lookup k l
      else if k2 < k then map-lookup k r
      else Some v2

  map-from-pairs :: forall k v. using (ord :: Ord k) => List (k, v) -> Map k v
  map-from-pairs kvs = case kvs of
    Nil -> Tip
    Cons p ps -> case p of
      (a, b) -> map-insert a b (map-from-pairs ps)

  -- `FromList Bytes Nat`: a buffer whose bytes are the list's `Nat`
  -- values in order. A value that does not fit a byte faults in
  -- `bytes-set`, like every out-of-range byte write.
  list-byte-count :: List Nat -> Nat
  list-byte-count xs = case xs of
    Nil -> 0
    Cons y ys -> 1 + list-byte-count ys

  bytes-from-list :: List Nat -> Bytes
  bytes-from-list xs = bytes-fill (bytes-new (list-byte-count xs)) 0 xs

  bytes-fill :: Bytes -> Nat -> List Nat -> Bytes
  bytes-fill b i xs = case xs of
    Nil -> b
    Cons y ys ->
      let u = bytes-set b i y in
      bytes-fill b (i + 1) ys

  implicit instance FromList_List e :: FromList (List e) e where
    from-list xs = xs

  implicit instance FromList_Bytes :: FromList Bytes Nat where
    from-list xs = bytes-from-list xs

  implicit instance FromMap_Map k v :: using (ord :: Ord k) => FromMap (Map k v) k v where
    from-map kvs = map-from-pairs kvs

  -- Primitive types specification, section 8: class instances. Eq and
  -- Ord cover Bool, Char, the mathematical Nat and Int, every machine
  -- integer type, Usize and Isize; the order is numeric on the integer
  -- types and code point order on Char. F32 and F64 have none of these
  -- instances.

  -- Mathematical `Int` and `Nat` instances (primitive types
  -- specification, section 1): comparison through the cmp prims'
  -- immediates, arithmetic through the runtime. `Sub` on `Nat` is the
  -- runtime's truncated subtraction: the inductive `Nat` subtraction is
  -- truncated, and `nat-sub` faults rather than producing a negative.

  implicit instance Eq_Int :: Eq Int where
    (==) x y = eq-i64 (int-cmp x y) 0
    (/=) x y = ne-i64 (int-cmp x y) 0

  implicit instance Ord_Int :: Ord Int where
    (<) x y = lt-i64 (int-cmp x y) 0
    (<=) x y = le-i64 (int-cmp x y) 0
    (>) x y = gt-i64 (int-cmp x y) 0
    (>=) x y = ge-i64 (int-cmp x y) 0

  implicit instance Add_Int :: Add Int where
    (+) x y = int-add x y

  implicit instance Sub_Int :: Sub Int where
    (-) x y = int-sub x y

  implicit instance Mul_Int :: Mul Int where
    (*) x y = int-mul x y

  implicit instance Neg_Int :: Neg Int where
    negate x = int-neg x

