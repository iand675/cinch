-- Prelude for the bootstrap slice.
--
-- Operators are class methods, never compiler builtins. The only
-- compiler-known operations are the `safelang.prim.*` (machine scalars)
-- and `safelang.runtime.*` (mathematical `Nat`/`Int` and `Bytes`)
-- intrinsics below, which are representation-level and declared through
-- `foreign import`, plus the builtin capability values (`newIO`, the
-- structured-concurrency surface, and the `Io r` operations) whose
-- polymorphic schemes the compiler knows directly.
--
-- The machine scalar types and their operations follow the primitive
-- types specification. Names follow decision D6 (CONFORMANCE.md): an
-- operation is a prelude-level name of the form `<op><Type>`
-- (`wrapping-add-u32`) and a conversion is `<src>To<dst>`
-- (`u8-to-i32`). The `checked*`, `saturating*` and `wrapping*` conversion
-- families capitalize the source type (`checked-u8-to-i64`); the total
-- family lowercases it (`u8-to-i32`). The specification's dotted
-- `U32.wrappingAdd` spelling is a presentation form that lands with the
-- module slice.
module Prelude where

  -- Data declarations come first: the primitive signatures mention
  -- Option (checked results) and Ordering (totalOrder).

  data Option a where
    None :: Option a
    Some :: a -> Option a

  data Result e a where
    Err :: e -> Result e a
    Ok :: a -> Result e a

  data List a where
    Nil :: List a
    Cons :: a -> List a -> List a

  data Ordering where
    LT :: Ordering
    EQ :: Ordering
    GT :: Ordering

  -- The mathematical `Nat` and `Int` (primitive types specification,
  -- section 1): boxed bignums, distinct from every machine scalar.
  foreign import ccall "safelang.runtime.natAdd" nat-add :: Nat -> Nat -> Nat
  foreign import ccall "safelang.runtime.natSub" nat-sub :: Nat -> Nat -> Nat
  foreign import ccall "safelang.runtime.natMul" nat-mul :: Nat -> Nat -> Nat
  foreign import ccall "safelang.runtime.natDiv" nat-div :: Nat -> Nat -> Nat
  foreign import ccall "safelang.runtime.natRem" nat-rem :: Nat -> Nat -> Nat
  foreign import ccall "safelang.runtime.natCmp" nat-cmp :: Nat -> Nat -> I64
  foreign import ccall "safelang.runtime.natFromI64" nat-from-i64 :: I64 -> Nat
  foreign import ccall "safelang.runtime.natToI64" nat-to-i64 :: Nat -> I64
  foreign import ccall "safelang.runtime.intAdd" int-add :: Int -> Int -> Int
  foreign import ccall "safelang.runtime.intSub" int-sub :: Int -> Int -> Int
  foreign import ccall "safelang.runtime.intMul" int-mul :: Int -> Int -> Int
  foreign import ccall "safelang.runtime.intDiv" int-div :: Int -> Int -> Int
  foreign import ccall "safelang.runtime.intRem" int-rem :: Int -> Int -> Int
  foreign import ccall "safelang.runtime.intNeg" int-neg :: Int -> Int
  foreign import ccall "safelang.runtime.intCmp" int-cmp :: Int -> Int -> I64
  foreign import ccall "safelang.runtime.intFromI64" int-from-i64 :: I64 -> Int
  foreign import ccall "safelang.runtime.intToI64" int-to-i64 :: Int -> I64

  -- `nat-cmp`/`int-cmp` return the raw -1/0/1 immediate at `I64`, so
  -- equality is `eq-i64 (int-cmp a b) 0`. Division and remainder by zero
  -- fault with the division fault code (exit 72); `nat-sub` below zero and
  -- every `Bytes` fault below (out-of-bounds index, byte value outside
  -- 0..=255, a length outside `i64` range) exit through the panic path
  -- (71).

  -- `Bytes`: boxed byte buffers. Indices, lengths and byte values are
  -- `Nat` and convert through `sl_nat_to_i64`/`sl_nat_from_i64`.
  foreign import ccall "safelang.runtime.bytesNew" bytes-new :: Nat -> Bytes
  foreign import ccall "safelang.runtime.bytesLen" bytes-len :: Bytes -> Nat
  foreign import ccall "safelang.runtime.bytesGet" bytes-get :: Bytes -> Nat -> Nat
  foreign import ccall "safelang.runtime.bytesSet" bytes-set :: Bytes -> Nat -> Nat -> Unit

