    clear-bit x n = bit-and-u32 x (bit-not-u32 (wrapping-shl-u32 1 n))
    complement-bit x n = bit-xor-u32 x (wrapping-shl-u32 1 n)
    count-ones x = count-ones-u32 x
    leading-zeros x = leading-zeros-u32 x
    trailing-zeros x = trailing-zeros-u32 x

  implicit instance Bits_U64 :: Bits U64 where
    bit-and x y = bit-and-u64 x y
    bit-or x y = bit-or-u64 x y
    bit-xor x y = bit-xor-u64 x y
    bit-not x = bit-not-u64 x
    shift-left x n = wrapping-shl-u64 x n
    shift-right x n = wrapping-shr-u64 x n
    rotate-left x n = rotate-left-u64 x n
    rotate-right x n = rotate-right-u64 x n
    test-bit x n = ne-u64 (bit-and-u64 x (wrapping-shl-u64 1 n)) 0
    set-bit x n = bit-or-u64 x (wrapping-shl-u64 1 n)
    clear-bit x n = bit-and-u64 x (bit-not-u64 (wrapping-shl-u64 1 n))
    complement-bit x n = bit-xor-u64 x (wrapping-shl-u64 1 n)
    count-ones x = count-ones-u64 x
    leading-zeros x = leading-zeros-u64 x
    trailing-zeros x = trailing-zeros-u64 x

  implicit instance Bits_Usize :: Bits Usize where
    bit-and x y = bit-and-usize x y
    bit-or x y = bit-or-usize x y
    bit-xor x y = bit-xor-usize x y
    bit-not x = bit-not-usize x
    shift-left x n = wrapping-shl-usize x n
    shift-right x n = wrapping-shr-usize x n
    rotate-left x n = rotate-left-usize x n
    rotate-right x n = rotate-right-usize x n
    test-bit x n = ne-usize (bit-and-usize x (wrapping-shl-usize 1 n)) 0
    set-bit x n = bit-or-usize x (wrapping-shl-usize 1 n)
    clear-bit x n = bit-and-usize x (bit-not-usize (wrapping-shl-usize 1 n))
    complement-bit x n = bit-xor-usize x (wrapping-shl-usize 1 n)
    count-ones x = count-ones-usize x
    leading-zeros x = leading-zeros-usize x
    trailing-zeros x = trailing-zeros-usize x

  implicit instance Bits_Isize :: Bits Isize where
    bit-and x y = bit-and-isize x y
    bit-or x y = bit-or-isize x y
    bit-xor x y = bit-xor-isize x y
    bit-not x = bit-not-isize x
    shift-left x n = wrapping-shl-isize x n
    shift-right x n = wrapping-shr-isize x n
    rotate-left x n = rotate-left-isize x n
    rotate-right x n = rotate-right-isize x n
    test-bit x n = ne-isize (bit-and-isize x (wrapping-shl-isize 1 n)) 0
    set-bit x n = bit-or-isize x (wrapping-shl-isize 1 n)
    clear-bit x n = bit-and-isize x (bit-not-isize (wrapping-shl-isize 1 n))
    complement-bit x n = bit-xor-isize x (wrapping-shl-isize 1 n)
    count-ones x = count-ones-isize x
    leading-zeros x = leading-zeros-isize x
    trailing-zeros x = trailing-zeros-isize x

  -- Traditional bitwise operator spellings over the `Bits` class
  -- (decision D90): wrappers like the weight wrappers, never new
  -- compiler mechanisms. Bitwise NOT has no operator spelling because
  -- both candidate symbols are reserved punctuation (`!` and `~`); use
  -- `bit-not`. Machine integers deliberately get no arithmetic operator
  -- instances (primitive types specification section 8): `%` and `/`
  -- below cover the mathematical `Nat` and `Int` only.
  (&) :: forall a. using (bits :: Bits a) => a -> a -> a
  (&) x y = bit-and x y

  (|) :: forall a. using (bits :: Bits a) => a -> a -> a
  (|) x y = bit-or x y

  (^) :: forall a. using (bits :: Bits a) => a -> a -> a
  (^) x y = bit-xor x y

  (<<) :: forall a. using (bits :: Bits a) => a -> U32 -> a
  (<<) x n = shift-left x n

  (>>) :: forall a. using (bits :: Bits a) => a -> U32 -> a
  (>>) x n = shift-right x n

  -- Modulo and division for the mathematical types (decision D91).
  -- Division or remainder by zero takes the defined fault path (exit
  -- 72). Machine integers keep the checked family only, per the
  -- primitive types specification.
  signature Rem a where
    (%) :: a -> a -> a

  signature Div a where
    (/) :: a -> a -> a

  implicit instance Rem_Nat :: Rem Nat where
    (%) x y = nat-rem x y

  implicit instance Div_Nat :: Div Nat where
    (/) x y = nat-div x y

  implicit instance Rem_Int :: Rem Int where
    (%) x y = int-rem x y

  implicit instance Div_Int :: Div Int where
    (/) x y = int-div x y

  -- ---------------------------------------------------------------------------
  -- Runtime strings: UTF-8 over Bytes.
  --
  -- `String` is the runtime text type (decision D88). It is distinct
  -- from the staging interpreter's compile-time string values, which are
  -- the same type observed at compile time (D43's deferral resolved).
  -- String literals remain a surface future item; strings are built
  -- from `Bytes`, `Char`, and the conversions below.
  --
  -- The functions here are the REFERENCE SEMANTICS for UTF-8. The
  -- runtime provides SIMD-accelerated implementations of the same rules
  -- (`sl_utf8_*` in `compiler/runtime/src/string.rs`), tested to agree
  -- with this code; the acceleration is a representation detail behind
  -- the primitive operations chapter's justified bodies (D89).

  data String where
    String :: Bytes -> String

  -- The `Json`-shaped value a file converter binds for a JSON file with
  -- no declared type (surface grammar local amendments section 11); with
  -- a declared record type the converter decodes into it instead. An
  -- array is a cons spine (`JArr item tail`, ended by `JArrEnd`) and an
  -- object entry is `JObj key value tail` (ended by `JObjEnd`): the
  -- positivity discipline allows only direct recursive occurrences, so
  -- the payloads stay inside the family.
  data Json where
    JNull :: Json
    JBool :: Bool -> Json
    JNum :: Int -> Json
    JFloat :: F64 -> Json
    JStr :: String -> Json
    JArr :: Json -> Json -> Json
    JObj :: String -> Json -> Json -> Json
    JArrEnd :: Json
    JObjEnd :: Json

  string-to-bytes :: String -> Bytes
  string-to-bytes s = case s of
    String b -> b

  -- UTF-8 decoding rules: a lead byte gives the width; continuation
  -- bytes are 10xxxxxx; overlong encodings, surrogates, and values above
  -- 0x10FFFF are malformed.
  utf8-width :: Nat -> Nat
  utf8-width x =
    if x < 128 then 1
    else if x < 192 then 0
    else if x < 224 then 2
    else if x < 240 then 3
    else if x < 248 then 4
    else 0

  utf8-min :: Nat -> Nat
  utf8-min w =
    if w == 2 then 128
    else if w == 3 then 2048
    else if w == 4 then 65536
    else 0

  utf8-cont :: Bytes -> Nat -> Nat -> Nat -> Option Nat
  utf8-cont b i k cp =
    if k == 0 then Some cp
    else
      let y = bytes-get b i in
      if y < 128 then None
      else if y >= 192 then None
      else utf8-cont b (i + 1) (k - 1) (cp * 64 + (y - 128))

  utf8-lead-payload :: Nat -> Nat -> Nat
  utf8-lead-payload x w =
    if w == 2 then x - 192
    else if w == 3 then x - 224
    else x - 240

  utf8-at :: Bytes -> Nat -> Option (Char, Nat)
  utf8-at b i =
    if i >= bytes-len b then None
    else
      let x = bytes-get b i in
      let w = utf8-width x in
      if w == 0 then None
      else if w == 1 then utf8-char x 1
      else if i + w > bytes-len b then None
      else case utf8-cont b (i + 1) (w - 1) (utf8-lead-payload x w) of
        None -> None
        Some cp -> if cp < utf8-min w then None else utf8-char cp w

  utf8-char :: Nat -> Nat -> Option (Char, Nat)
  utf8-char cp w =
    case u32-to-char (wrapping-i64-to-u32 (nat-to-i64 cp)) of
      None -> None
      Some c -> Some (c, w)

  utf8-valid-from :: Bytes -> Nat -> Bool
  utf8-valid-from b i =
    if i >= bytes-len b then True
    else case utf8-at b i of
      None -> False
      Some p -> case p of
        (c, w) -> utf8-valid-from b (i + w)

  string-from-bytes :: Bytes -> Option String
  string-from-bytes b =
    if utf8-valid-from b 0 then Some (String b) else None

  empty-string :: String
  empty-string = String (bytes-new 0)

  string-byte-length :: String -> Nat
  string-byte-length s = bytes-len (string-to-bytes s)

  -- Length in Unicode scalar values (O(n) scan).
  string-length-from :: Bytes -> Nat -> Nat -> Nat
  string-length-from b i n =
    if i >= bytes-len b then n
    else case utf8-at b i of
      None -> n
      Some p -> case p of
        (c, w) -> string-length-from b (i + w) (n + 1)

  string-length :: String -> Nat
  string-length s = string-length-from (string-to-bytes s) 0 0

  -- The scalar value at code point index `n`, by scan (O(n)).
  string-char-at-from :: Bytes -> Nat -> Nat -> Option Char
  string-char-at-from b i n =
    if i >= bytes-len b then None
    else case utf8-at b i of
      None -> None
      Some p -> case p of
        (c, w) -> if n == 0 then Some c else string-char-at-from b (i + w) (n - 1)

  string-char-at :: String -> Nat -> Option Char
  string-char-at s n = string-char-at-from (string-to-bytes s) 0 n

  -- Encode one scalar value (bytes are raw values; division is the
  -- `nat-div`/`nat-rem` function family).
  utf8-encode-into :: Bytes -> Nat -> Nat -> Nat
  utf8-encode-into b pos cp =
    if cp < 128 then
      let u = bytes-set b pos cp in 0
    else if cp < 2048 then
      let u = bytes-set b pos (192 + nat-div cp 64) in
      let v = bytes-set b (pos + 1) (128 + nat-rem cp 64) in 0
    else if cp < 65536 then
      let u = bytes-set b pos (224 + nat-div cp 4096) in
      let v = bytes-set b (pos + 1) (128 + nat-rem (nat-div cp 64) 64) in
      let w = bytes-set b (pos + 2) (128 + nat-rem cp 64) in 0
    else
      let u = bytes-set b pos (240 + nat-div cp 262144) in
      let v = bytes-set b (pos + 1) (128 + nat-rem (nat-div cp 4096) 64) in
      let w = bytes-set b (pos + 2) (128 + nat-rem (nat-div cp 64) 64) in
      let x = bytes-set b (pos + 3) (128 + nat-rem cp 64) in 0

  utf8-encode-width :: Nat -> Nat
  utf8-encode-width cp =
    if cp < 128 then 1
    else if cp < 2048 then 2
    else if cp < 65536 then 3
    else 4

  char-string :: Char -> String
  char-string c =
    let cp = nat-from-i64 (u32-to-i64 (char-to-u32 c)) in
    let b = bytes-new (utf8-encode-width cp) in
    let u = utf8-encode-into b 0 cp in
    String b

  -- Concatenation (O(n + m) copies).
  copy-bytes-into :: Bytes -> Bytes -> Nat -> Nat -> Nat -> Unit
  copy-bytes-into dst src di si n =
    if n == 0 then ()
    else
      let u = bytes-set dst di (bytes-get src si) in
      copy-bytes-into dst src (di + 1) (si + 1) (n - 1)

  string-concat :: String -> String -> String
  string-concat a b =
    let x = string-to-bytes a in
    let y = string-to-bytes b in
    let out = bytes-new (bytes-len x + bytes-len y) in
    let u = copy-bytes-into out x 0 0 (bytes-len x) in
    let v = copy-bytes-into out y (bytes-len x) 0 (bytes-len y) in
    String out

  -- Byte offsets of code point `n`; returns the byte length when `n`
  -- reaches past the end.
  string-byte-index-from :: Bytes -> Nat -> Nat -> Nat
  string-byte-index-from b i n =
    if i >= bytes-len b then i
    else if n == 0 then i
    else case utf8-at b i of
      None -> i
      Some p -> case p of
        (c, w) -> string-byte-index-from b (i + w) (n - 1)

  -- The code point range [start, end); indices past the end clamp and a
  -- reversed range yields the empty string (Nat subtraction faults below
  -- zero, so the span is guarded).
  string-slice :: String -> Nat -> Nat -> String
  string-slice s start end =
    let b = string-to-bytes s in
    let i0 = string-byte-index-from b 0 start in
    let span = if end > start then end - start else 0 in
    let i1 = string-byte-index-from b i0 span in
    let out = bytes-new (i1 - i0) in
    let u = copy-bytes-into out b 0 i0 (i1 - i0) in
    String out

  -- Byte-wise comparison; UTF-8 preserves scalar value order under
  -- byte-wise lexicographic order, so this is also code point order.
  compare-bytes-from :: Bytes -> Bytes -> Nat -> I64
  compare-bytes-from a b i =
    if i >= bytes-len a then
      (if i >= bytes-len b then 0 else -1)
    else if i >= bytes-len b then 1
    else case nat-cmp (bytes-get a i) (bytes-get b i) of
      0 -> compare-bytes-from a b (i + 1)
      c -> c

  string-compare :: String -> String -> I64
  string-compare a b = compare-bytes-from (string-to-bytes a) (string-to-bytes b) 0

  implicit instance Eq_String :: Eq String where
    (==) x y = eq-i64 (string-compare x y) 0
    (/=) x y = ne-i64 (string-compare x y) 0

  implicit instance Ord_String :: Ord String where
    (<) x y = lt-i64 (string-compare x y) 0
    (<=) x y = le-i64 (string-compare x y) 0
    (>) x y = gt-i64 (string-compare x y) 0
    (>=) x y = ge-i64 (string-compare x y) 0

  -- Decimal formatting: digits are raw ASCII bytes (48..=57), so no
  -- character literals are needed.
  nat-digits-into :: Bytes -> Nat -> Nat -> Nat -> Unit
  nat-digits-into b pos n k =
    if k == 0 then ()
    else
      let u = bytes-set b pos (48 + nat-rem (nat-div n (pow10 (k - 1))) 10) in
      nat-digits-into b (pos + 1) n (k - 1)

  pow10 :: Nat -> Nat
  pow10 k = if k == 0 then 1 else 10 * pow10 (k - 1)

  nat-digit-count :: Nat -> Nat
  nat-digit-count n = if n < 10 then 1 else 1 + nat-digit-count (nat-div n 10)

  nat-to-string :: Nat -> String
  nat-to-string n =
    let b = bytes-new (nat-digit-count n) in
    let u = nat-digits-into b 0 n (nat-digit-count n) in
    String b

  -- Signed decimal for `Int`, built from bignum division so values
  -- beyond i64 format correctly; the sign is a raw ASCII 45 byte and
  -- digits are raw ASCII bytes (48..=57).
  int-digit-count :: Int -> Nat
  int-digit-count n = if lt-i64 (int-cmp n 10) 0 then 1 else 1 + int-digit-count (int-div n 10)

  int-digits-into :: Bytes -> Nat -> Int -> Nat -> Unit
  int-digits-into b pos n k =
    if k == 0 then ()
    else
      let d = nat-from-i64 (int-to-i64 (int-rem n 10)) in
      let u = bytes-set b pos (48 + d) in
      int-digits-into b (pos + 1) (int-div n 10) (k - 1)

  int-to-string :: Int -> String
  int-to-string x =
    if eq-i64 (int-cmp x 0) 0 then nat-to-string 0
    else if lt-i64 (int-cmp x 0) 0 then
      let m = int-neg x in
      let k = int-digit-count m in
      let b = bytes-new (k + 1) in
      let u = bytes-set b 0 45 in
      let v = int-digits-into b 1 m k in
      String b
    else
      let k = int-digit-count x in
      let b = bytes-new k in
      let u = int-digits-into b 0 x k in
      String b
