  builtin-syntax-metadata :: String -> Option Json
  builtin-syntax-metadata name = find-builtin-syntax name builtin-declarations
  find-builtin-syntax :: String -> List Decl -> Option Json
  find-builtin-syntax name declarations = case declarations of
    Nil -> None
    Cons (DExternal sp symbol category syntax metadata) rest ->
      if string-compare name symbol == 0 && string-compare category "builtin-syntax" == 0 then Some metadata
      else find-builtin-syntax name rest
    Cons other rest -> find-builtin-syntax name rest
