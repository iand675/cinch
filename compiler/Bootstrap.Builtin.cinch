  array-extern :: Nat -> String
  array-extern operation =
    if operation == 0 then "cinch_array_from_list"
    else if operation == 1 then "cinch_array_replicate"
    else if operation == 2 then "cinch_array_len"
    else if operation == 3 then "cinch_array_get"
    else if operation == 4 then "cinch_array_set"
    else if operation == 5 then "cinch_array_slice"
    else if operation == 6 then "cinch_array_append"
    else if operation == 7 then "cinch_tensor_reshape"
    else if operation == 8 then "cinch_tensor_shape"
    else if operation == 9 then "cinch_tensor_data"
    else if operation == 10 then "cinch_tensor_get"
    else if operation == 11 then "cinch_tensor_set"
    else if operation == 12 then "cinch_columnar_column"
    else if operation == 13 then "cinch_columnar_zip"
    else if operation == 14 then "cinch_columnar_rows"
    else if operation == 15 then "cinch_columnar_columns"
    else if operation == 16 then "cinch_columnar_get"
    else if operation == 17 then "cinch_columnar_child"
    else if operation == 18 then "cinch_columnar_child"
    else if operation == 19 then "cinch_columnar_array"
    else if operation == 20 then "cinch_slots_new"
    else if operation == 25 then "cinch_slots_move"
    else if operation == 26 then "cinch_slots_clear"
    else if operation == 30 || operation == 31 || operation == 32 || operation == 33 then "cinch_array_tabulate_packed"
    else if operation == 34 then "cinch_array_zip_binop_f32"
    else if operation == 35 then "cinch_array_zip_binop_i32"
    else if operation == 36 then "cinch_array_reduce_f32"
    else if operation == 37 then "cinch_array_reduce_i32"
    else if operation == 38 then "cinch_array_dot_f32"
    else if operation == 39 then "cinch_array_dot_i32"
    else if operation == 40 then "cinch_array_row_reduce_f32"
    else if operation == 41 then "cinch_array_scan_i32"
    else if operation == 42 then "cinch_array_filter_i32_gt"
    else if operation == 43 then "cinch_array_histogram_u8"
    else if operation == 44 then "cinch_array_stencil2d_u8"
    else if operation == 45 then "cinch_array_spmv_csr_f32"
    else if operation == 46 then "cinch_array_set_exec_mode"
    else if operation == 47 then "cinch_array_histogram_batch_u8"
    else if operation == 48 then "cinch_array_map_unary_f32"
    else if operation == 49 then "cinch_array_fused_map_reduce_f32"
    else if operation == 50 then "cinch_array_tabulate_packed"
    else if operation >= 51 && operation <= 55 then "cinch_array_map_packed"
    else if operation == 56 || operation == 57 then "cinch_array_zip_with_packed"
    else if operation == 58 || operation == 59 then "cinch_array_foldl_packed"
    else if operation == 60 then "cinch_array_reduce_u32"
    else if operation == 61 then "cinch_array_reduce_i64"
    else if operation == 62 then "cinch_array_reduce_f64"
    else if operation == 63 then "cinch_array_dot_f64"
    else if operation == 64 then "cinch_array_strided_dot_f32"
    else if operation == 65 then "cinch_array_row_reduce_i32"
    else if operation == 66 then "cinch_array_scan_u32"
    else if operation == 67 then "cinch_array_filter_packed"
    else if operation == 68 then "cinch_array_gather_f32"
    else if operation == 69 then "cinch_array_gather_i32"
    else if operation == 70 then "cinch_array_scatter_unique_u32"
