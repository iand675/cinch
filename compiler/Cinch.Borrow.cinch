-- Fixed-point borrowed parameter inference for the self-hosted runtime IR.
-- Mirrors Perceus / Lean 4 borrow inference (`seed/src/rc.rs`):
-- a counted parameter starts borrowed (`True`) and becomes owned (`False`)
-- whenever the function body uses it in an owned position (return, store,
-- capture, indirect/foreign/consuming call, or non-borrowed callee argument),
-- or when a self-tail loop passes a non-borrowed expression to that parameter.
module Cinch.Borrow where

  import Data.List
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Cinch.Core
  import Cinch.Type
  import Cinch.Ownership (reuse-scrutinee-params)

  export compute-borrow-modes, same-borrow-modes, any-borrowed, borrow-eligible-definition

  same-text :: String -> String -> Bool
  same-text a b = string-compare a b == 0

  any-borrowed :: List Bool -> Bool
  any-borrowed mask = case mask of
    Nil -> False
    Cons b rest -> b || any-borrowed rest

  replicate-bool :: Nat -> Bool -> List Bool
  replicate-bool n val = if n == 0 then Nil else Cons val (replicate-bool (n - 1) val)

  mask-at :: List Bool -> Nat -> Bool
  mask-at mask idx = case mask of
    Nil -> False
    Cons b rest -> if idx == 0 then b else mask-at rest (idx - 1)

  clear-mask-at :: List Bool -> Nat -> List Bool
  clear-mask-at mask idx = case mask of
    Nil -> Nil
    Cons b rest -> if idx == 0 then Cons False rest else Cons b (clear-mask-at rest (idx - 1))

  clear-mask-indices :: List Bool -> List Nat -> List Bool
  clear-mask-indices mask indices = case indices of
    Nil -> mask
    Cons idx rest -> clear-mask-indices (clear-mask-at mask idx) rest

  same-bool-list :: List Bool -> List Bool -> Bool
  same-bool-list left right = case (left, right) of
    (Nil, Nil) -> True
    (Cons a arest, Cons b brest) -> (if a then b else not b) && same-bool-list arest brest
    other -> False

  same-borrow-modes :: List CoreDefinition -> HashMap String (List Bool) -> HashMap String (List Bool) -> Bool
  same-borrow-modes definitions left right = case definitions of
    Nil -> True
    Cons d rest ->
      let name = d.name in
      let ok = case (hash-map-lookup name left, hash-map-lookup name right) of
            (None, None) -> True
            (Some a, Some b) -> same-bool-list a b
            other -> False in
      ok && same-borrow-modes rest left right

  -- Runtime parameters (non-erased patterns) of a clause.
  borrow-runtime-params :: List CorePattern -> List CorePattern
  borrow-runtime-params pats = case pats of
    Nil -> Nil
    Cons p rest -> if erased-pattern p then borrow-runtime-params rest else Cons p (borrow-runtime-params rest)

  -- Ensure there are no proof patterns after runtime parameters (single proof stage).
  borrow-single-stage :: List CorePattern -> Bool -> Bool
  borrow-single-stage pats seen-runtime = case pats of
    Nil -> True
    Cons p rest ->
      if erased-pattern p then
        if seen-runtime then False else borrow-single-stage rest False
      else borrow-single-stage rest True

  -- Count how many definitions belong to each tail-group id.
  count-tail-groups :: List CoreDefinition -> HashMap String (Nat, Nat) -> HashMap String Nat -> HashMap String Nat
  count-tail-groups defs tail-groups counts = case defs of
    Nil -> counts
    Cons d rest ->
      let next = case hash-map-lookup (d.name) tail-groups of
            Some (gid, width) ->
              let key = nat-to-string gid in
              let cur = case hash-map-lookup key counts of Some n -> n; None -> 0 in
              hash-map-insert key (cur + 1) counts
            None -> counts in
      count-tail-groups rest tail-groups next

  in-multi-tail-group :: String -> HashMap String (Nat, Nat) -> HashMap String Nat -> Bool
  in-multi-tail-group name tail-groups counts = case hash-map-lookup name tail-groups of
    Some (gid, width) -> (case hash-map-lookup (nat-to-string gid) counts of
      Some n -> n > 1
      None -> False)
    None -> False

  borrow-eligible-definition :: CoreDefinition -> HashMap String (Nat, Nat) -> HashMap String Nat -> Option Nat
  borrow-eligible-definition d tail-groups group-counts =
    let name = d.name in
    if same-text name "main" || same-text name "Main.main" then None
    else if in-multi-tail-group name tail-groups group-counts then None
    else case (d.givens, d.openings, d.clauses) of
      (Nil, Nil, Cons (CoreClause sp patterns body) rest) ->
        if not (borrow-single-stage patterns False) then None
        else
          let arity = list-length (borrow-runtime-params patterns) in
          if arity == 0 then None else Some arity
      other -> None

  -- Initialize every eligible definition with all parameters borrowed.
  init-borrow-modes :: List CoreDefinition -> HashMap String (Nat, Nat) -> HashMap String Nat -> HashMap String (List Bool) -> (List (CoreDefinition, Nat), HashMap String (List Bool))
  init-borrow-modes defs tail-groups group-counts modes = case defs of
    Nil -> (Nil, modes)
    Cons d rest -> case init-borrow-modes rest tail-groups group-counts modes of
      (eligible, acc) -> case borrow-eligible-definition d tail-groups group-counts of
        Some arity ->
          let init-mask = clear-mask-indices (replicate-bool arity True) (reuse-scrutinee-params d) in
          (Cons (d, arity) eligible, hash-map-insert (d.name) init-mask acc)
        None -> (eligible, acc)

  -- Unwrap call spine: head and flat argument list.
  borrow-call-head :: CoreTerm -> CoreTerm
  borrow-call-head term = case term of
    CApply sp ty f x -> borrow-call-head f
    CApplyEff sp ty row f x -> borrow-call-head f
    CErasedApply sp ty row f x -> borrow-call-head f
    other -> term

  borrow-call-args :: CoreTerm -> List CoreTerm -> List CoreTerm
  borrow-call-args term acc = case term of
    CApply sp ty f x -> borrow-call-args f (Cons x acc)
    CApplyEff sp ty row f x -> borrow-call-args f (Cons x acc)
    CErasedApply sp ty row f x -> borrow-call-args f acc
    other -> acc

  -- Known non-consuming runtime builtins whose arguments are read-only.
  readonly-builtin :: String -> Bool
  readonly-builtin name =
    same-text name "cinch.runtime.bytesLen"
    || same-text name "cinch.runtime.bytesLenI64"
    || same-text name "cinch.runtime.bytesGet"
    || same-text name "cinch.runtime.bytesGetU8"
    || same-text name "cinch.runtime.bytesGetU8At"
    || same-text name "cinch.runtime.bytesLoadLe32"
    || same-text name "cinch.runtime.bytesLoadLe32At"
    || same-text name "cinch.runtime.bytesLoadLe64"
    || same-text name "cinch.runtime.bytesLoadLe64At"
    || same-text name "cinch.runtime.bytesCompare"
    || same-text name "cinch.runtime.bytesData"
    || same-text name "cinch.runtime.natAdd"
    || same-text name "cinch.runtime.natSub"
    || same-text name "cinch.runtime.natMul"
    || same-text name "cinch.runtime.natDiv"
    || same-text name "cinch.runtime.natRem"
    || same-text name "cinch.runtime.natCmp"
    || same-text name "cinch.runtime.natToI64"
    || same-text name "cinch.runtime.intAdd"
    || same-text name "cinch.runtime.intSub"
    || same-text name "cinch.runtime.intMul"
    || same-text name "cinch.runtime.intDiv"
    || same-text name "cinch.runtime.intRem"
    || same-text name "cinch.runtime.intNeg"
    || same-text name "cinch.runtime.intCmp"
    || same-text name "cinch.runtime.intToI64"
    || same-text name "cinch.runtime.arrayLen"
    || same-text name "cinch.runtime.arrayGet"
    || same-text name "cinch.runtime.arraySlice"
    || same-text name "cinch.runtime.mvarRead"
    || same-text name "cinch.runtime.mvarTryRead"
    || same-text name "cinch.runtime.mvarIsEmpty"
    || same-text name "cinch.runtime.rwlockRead"
    || same-text name "cinch.runtime.rwlockTryRead"
    || same-text name "cinch.runtime.atomicLoad"
    || same-text name "cinch.runtime.atomicStore"
    || same-text name "cinch.runtime.atomicSwap"
    || same-text name "cinch.runtime.atomicFetchAdd"
    || same-text name "cinch.runtime.atomicFetchSub"
    || same-text name "cinch.runtime.atomicFetchAnd"
    || same-text name "cinch.runtime.atomicFetchOr"
    || same-text name "cinch.runtime.atomicFetchXor"
    || same-text name "cinch.runtime.atomicCas"

  -- Lookup a local id in an association list of (local-id, param-index).
  lookup-id :: Nat -> List (Nat, Nat) -> Option Nat
  lookup-id needle pairs = case pairs of
    Nil -> None
    Cons (id, idx) rest -> if id == needle then Some idx else lookup-id needle rest

  has-nat :: Nat -> List Nat -> Bool
  has-nat needle xs = case xs of
    Nil -> False
    Cons x rest -> if x == needle then True else has-nat needle rest

  add-nat :: Nat -> List Nat -> List Nat
  add-nat x xs = if has-nat x xs then xs else Cons x xs

  -- Unwrap a simple variable reference (possibly wrapped in CForget).
  local-var-id :: CoreTerm -> Option Nat
  local-var-id term = case term of
    CLocal sp ty id name Nil -> Some id
    CForget sp ty inner -> local-var-id inner
    CCast sp ty inner -> local-var-id inner
    other -> None

  -- Collect all binder ids introduced by a pattern (for borrowed-field tracking).
  pattern-binder-ids :: CorePattern -> List Nat -> List Nat
  pattern-binder-ids pat acc = case pat of
    CPVar sp ty id name -> add-nat id acc
    CPAs sp ty id name inner -> pattern-binder-ids inner (add-nat id acc)
    CPConstructor sp ty name actuals sc fields -> pattern-binder-ids fields acc
    CPTuple sp ty fields -> pattern-binder-ids fields acc
    CPField sp first rest -> pattern-binder-ids rest (pattern-binder-ids first acc)
    other -> acc

  -- Bind clause runtime parameters into:
  -- 1) `param-ids`: (binder-id, param-index) for top-level CPVar / CPAs of borrowed params,
  -- 2) `borrowed-vars`: all binder ids (including pattern-matched sub-fields) derived from borrowed params.
  clause-param-bindings :: List CorePattern -> List Bool -> Nat -> (List (Nat, Nat), List Nat) -> (List (Nat, Nat), List Nat)
  clause-param-bindings pats mask index acc = case (pats, mask) of
    (Cons pat rest, Cons is-borrowed more) ->
      let next = (if not is-borrowed then acc else
            case acc of
              (pids, bvars) -> case pat of
                CPVar sp ty id name -> (Cons (id, index) pids, add-nat id bvars)
                CPAs sp ty id name inner -> (Cons (id, index) pids, pattern-binder-ids inner (add-nat id bvars))
                other -> (pids, pattern-binder-ids pat bvars)) in
      clause-param-bindings rest more (index + 1) next
    other -> acc

  -- Check if an argument expression in a self-tail call is guaranteed borrowed
  -- (never a freshly allocated temporary) so a self-loop can overwrite the
  -- slot without dropping the previous iteration's value.
  is-safe-loop-arg :: CoreTerm -> List Nat -> Bool
  is-safe-loop-arg term borrowed-vars = case term of
    CLocal sp ty id name Nil -> has-nat id borrowed-vars
    CForget sp ty inner -> is-safe-loop-arg inner borrowed-vars
    CCast sp ty inner -> is-safe-loop-arg inner borrowed-vars
    CUnit sp ty -> True
    CChar sp ty txt -> True
    CSymbol sp ty txt -> True
    CUse sp ty name role Nil -> same-text name "True" || same-text name "False"
    other -> False

  -- Check whether a direct call term is a saturated self-call.
  is-self-call :: String -> Nat -> CoreTerm -> Option (List CoreTerm)
  is-self-call self arity term = case borrow-call-head term of
    CUse sp ty name role actuals | not (same-text role "foreign") && not (same-text role "constructor") && same-text name self ->
      let args = borrow-call-args term Nil in
      if list-length args == arity then Some args else None
    other -> None

  -- Check all arguments of a self-tail call against the current mask.
  check-self-tail-args :: List CoreTerm -> List Bool -> List Nat -> Nat -> List Nat -> List Nat
  check-self-tail-args args mask borrowed-vars idx owned = case (args, mask) of
    (Cons arg rest, Cons is-borrowed more) ->
      let next = if is-borrowed && not (is-safe-loop-arg arg borrowed-vars) then add-nat idx owned else owned in
      check-self-tail-args rest more borrowed-vars (idx + 1) next
    other -> owned

  -- Traverse a term collecting parameter indices used in owned positions,
  -- and checking self-tail call arguments when `in-tail` is True.
  analyze-term :: String -> Nat -> List Bool -> HashMap String (List Bool) -> Bool -> List (Nat, Nat) -> List Nat -> CoreTerm -> List Nat -> List Nat
  analyze-term self arity self-mask modes in-tail pids bvars term owned = case term of
    CLocal sp ty id name actuals -> (case lookup-id id pids of
      Some idx -> add-nat idx owned
      None -> owned)
    CForget sp ty inner -> analyze-term self arity self-mask modes in-tail pids bvars inner owned
    CCast sp ty inner -> analyze-term self arity self-mask modes in-tail pids bvars inner owned
    CRequire sp ty body -> analyze-term self arity self-mask modes in-tail pids bvars body owned
    CProved sp ty ev body -> analyze-term self arity self-mask modes in-tail pids bvars body owned
    CRefine sp ty ev body -> analyze-term self arity self-mask modes in-tail pids bvars body owned
    CRefineProof sp ty witness body -> analyze-term self arity self-mask modes in-tail pids bvars body owned
    CDischarge sp ty ev _ body -> analyze-term self arity self-mask modes in-tail pids bvars body owned
    CGuard sp ty cond body ->
      let o1 = analyze-term self arity self-mask modes False pids bvars cond owned in
      analyze-term self arity self-mask modes in-tail pids bvars body o1
    CIf sp ty cond yes no ->
      let o1 = analyze-term self arity self-mask modes False pids bvars cond owned in
      let o2 = analyze-term self arity self-mask modes in-tail pids bvars yes o1 in
      analyze-term self arity self-mask modes in-tail pids bvars no o2
    CLet sp ty lid lname sc rhs body -> case local-var-id rhs of
      Some src-id ->
        let pids2 = (case lookup-id src-id pids of
              Some idx -> Cons (lid, idx) pids
              None -> pids) in
        let bvars2 = if has-nat src-id bvars then add-nat lid bvars else bvars in
        -- If src-id is neither a tracked param nor borrowed, rhs might still be another local (no owned-use).
        analyze-term self arity self-mask modes in-tail pids2 bvars2 body owned
      None ->
        let o1 = analyze-term self arity self-mask modes False pids bvars rhs owned in
        analyze-term self arity self-mask modes in-tail pids bvars body o1
    CCase sp ty scrut alts ->
      case local-var-id scrut of
        Some sid ->
          let scrut-param = lookup-id sid pids in
          let scrut-borrowed = has-nat sid bvars in
          analyze-alts self arity self-mask modes in-tail pids bvars scrut-param scrut-borrowed alts owned
        None ->
          let o1 = analyze-term self arity self-mask modes False pids bvars scrut owned in
          analyze-alts self arity self-mask modes in-tail pids bvars None False alts o1
    CApply sp ty f x -> analyze-application self arity self-mask modes in-tail pids bvars term owned
    CApplyEff sp ty row f x -> analyze-application self arity self-mask modes in-tail pids bvars term owned
    CErasedApply sp ty row f x -> analyze-application self arity self-mask modes in-tail pids bvars term owned
    other -> analyze-term-list self arity self-mask modes False pids bvars (runtime-term-children term) owned

  analyze-alts :: String -> Nat -> List Bool -> HashMap String (List Bool) -> Bool -> List (Nat, Nat) -> List Nat -> Option Nat -> Bool -> CoreTerm -> List Nat -> List Nat
  analyze-alts self arity self-mask modes in-tail pids bvars scrut-param scrut-borrowed alts owned = case alts of
    CAlternative sp pat body rest ->
      let pids2 = (case (pat, scrut-param) of
            (CPVar at pty id pname, Some idx) -> Cons (id, idx) pids
            (CPAs at pty id pname inner, Some idx) -> Cons (id, idx) pids
            other -> pids) in
      let bvars2 = if scrut-borrowed then pattern-binder-ids pat bvars else bvars in
      let o1 = analyze-term self arity self-mask modes in-tail pids2 bvars2 body owned in
      analyze-alts self arity self-mask modes in-tail pids bvars scrut-param scrut-borrowed rest o1
    other -> owned

  analyze-application :: String -> Nat -> List Bool -> HashMap String (List Bool) -> Bool -> List (Nat, Nat) -> List Nat -> CoreTerm -> List Nat -> List Nat
  analyze-application self arity self-mask modes in-tail pids bvars term owned =
    let h = borrow-call-head term in
    let args = borrow-call-args term Nil in
    let o0 = (if in-tail then
          (case is-self-call self arity term of
            Some self-args -> check-self-tail-args self-args self-mask bvars 0 owned
            None -> owned)
        else owned) in
    case h of
      CUse sp ty name role actuals | not (same-text role "foreign") && not (same-text role "constructor") ->
        if readonly-builtin name then
          analyze-readonly-args self arity self-mask modes pids bvars args o0
        else (case hash-map-lookup name modes of
          Some callee-mask | list-length callee-mask == list-length args ->
            analyze-call-args self arity self-mask modes pids bvars args callee-mask o0
          other -> analyze-term-list self arity self-mask modes False pids bvars args o0)
      CUse sp ty name role actuals ->
        -- Constructor or foreign call consumes its arguments.
        analyze-term-list self arity self-mask modes False pids bvars args o0
      other ->
        let o1 = analyze-term self arity self-mask modes False pids bvars h o0 in
        analyze-term-list self arity self-mask modes False pids bvars args o1

  analyze-readonly-args :: String -> Nat -> List Bool -> HashMap String (List Bool) -> List (Nat, Nat) -> List Nat -> List CoreTerm -> List Nat -> List Nat
  analyze-readonly-args self arity self-mask modes pids bvars args owned = case args of
    Nil -> owned
    Cons arg rest ->
      let o1 = (case local-var-id arg of
            Some id -> owned
            None -> analyze-term self arity self-mask modes False pids bvars arg owned) in
      analyze-readonly-args self arity self-mask modes pids bvars rest o1

  analyze-call-args :: String -> Nat -> List Bool -> HashMap String (List Bool) -> List (Nat, Nat) -> List Nat -> List CoreTerm -> List Bool -> List Nat -> List Nat
  analyze-call-args self arity self-mask modes pids bvars args callee-mask owned = case (args, callee-mask) of
    (Cons arg rest, Cons is-borrowed more) ->
      let o1 = (if is-borrowed then
            (case local-var-id arg of
              Some id -> owned
              None -> analyze-term self arity self-mask modes False pids bvars arg owned)
          else analyze-term self arity self-mask modes False pids bvars arg owned) in
      analyze-call-args self arity self-mask modes pids bvars rest more o1
    (Cons arg rest, Nil) ->
      let o1 = analyze-term self arity self-mask modes False pids bvars arg owned in
      analyze-call-args self arity self-mask modes pids bvars rest Nil o1
    other -> owned

  analyze-term-list :: String -> Nat -> List Bool -> HashMap String (List Bool) -> Bool -> List (Nat, Nat) -> List Nat -> List CoreTerm -> List Nat -> List Nat
  analyze-term-list self arity self-mask modes in-tail pids bvars terms owned = case terms of
    Nil -> owned
    Cons t rest ->
      let o1 = analyze-term self arity self-mask modes in-tail pids bvars t owned in
      analyze-term-list self arity self-mask modes in-tail pids bvars rest o1

  analyze-clauses :: String -> Nat -> List Bool -> HashMap String (List Bool) -> List CoreClause -> List Nat -> List Nat
  analyze-clauses self arity mask modes clauses owned = case clauses of
    Nil -> owned
    Cons (CoreClause sp patterns body) rest ->
      let rparams = borrow-runtime-params patterns in
      case clause-param-bindings rparams mask 0 (Nil, Nil) of
        (pids, bvars) ->
          let o1 = analyze-term self arity mask modes True pids bvars body owned in
          analyze-clauses self arity mask modes rest o1

  -- One deterministic sweep over all eligible definitions.
  borrow-sweep :: List (CoreDefinition, Nat) -> HashMap String (List Bool) -> Bool -> (HashMap String (List Bool), Bool)
  borrow-sweep eligible modes changed = case eligible of
    Nil -> (modes, changed)
    Cons (d, arity) rest ->
      let name = d.name in
      let cur-mask = case hash-map-lookup name modes of Some m -> m; None -> Nil in
      if not (any-borrowed cur-mask) then borrow-sweep rest modes changed
      else
        let owned = analyze-clauses name arity cur-mask modes (d.clauses) Nil in
        let next-mask = clear-mask-indices cur-mask owned in
        let diff = not (same-bool-list cur-mask next-mask) in
        let next-modes = if diff then hash-map-insert name next-mask modes else modes in
        borrow-sweep rest next-modes (changed || diff)

  borrow-fixpoint :: Nat -> List (CoreDefinition, Nat) -> HashMap String (List Bool) -> HashMap String (List Bool)
  borrow-fixpoint fuel eligible modes =
    if fuel == 0 then hash-map-empty
    else case borrow-sweep eligible modes False of
      (next-modes, True) -> borrow-fixpoint (fuel - 1) eligible next-modes
      (next-modes, False) -> next-modes

  -- Keep only definitions that have at least one borrowed parameter.
  prune-borrow-modes :: List (CoreDefinition, Nat) -> HashMap String (List Bool) -> HashMap String (List Bool) -> HashMap String (List Bool)
  prune-borrow-modes eligible modes out = case eligible of
    Nil -> out
    Cons (d, arity) rest ->
      let name = d.name in
      let next = case hash-map-lookup name modes of
            Some m | any-borrowed m -> hash-map-insert name m out
            other -> out in
      prune-borrow-modes rest modes next

  -- | Compute deterministic fixed-point borrowed-parameter masks for all eligible
  -- definitions in a checked program.
  compute-borrow-modes :: List CoreDefinition -> HashMap String (Nat, Nat) -> HashMap String (List Bool)
  compute-borrow-modes definitions tail-groups =
    let group-counts = count-tail-groups definitions tail-groups hash-map-empty in
    case init-borrow-modes definitions tail-groups group-counts hash-map-empty of
      (eligible, initial) ->
        let settled = borrow-fixpoint 4096 eligible initial in
        prune-borrow-modes eligible settled hash-map-empty
