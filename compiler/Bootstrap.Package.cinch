-- Typed interface packages. The mmap address is private to the decoder, and
-- the returned contracts retain only ordinary managed Cinch values.
module Bootstrap.Package where

  import Bootstrap.Total (check-total-graph)
  import Data.Array (array-from-list, array-get, array-length)
  import Data.Bytes (bytes-data, bytes-len, bytes-new)
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Data.Json
  import Data.List (sort)
  import Data.Machine (u32-to-nat, saturating-i64-to-i32)
  import Data.Nat (checked-nat-to-i64, checked-nat-from-i64, nat-to-int)
  import Prim.Sys (sys-open-read, sys-close, sys-lseek, sys-seek-end)
  import Text.Json (parse-json)
  import Text.Lex (bytes-slice)
  import Text.Parse (ParseOutcome, Parsed)

  export read-package-documents, packaged-abi

  foreign import ccall "mmap" map-file :: forall r. I64 -> I64 -> I32 -> I32 -> I32 -> I64 ->{IO r} I64
  foreign import ccall "munmap" unmap-file :: forall r. I64 -> I64 ->{IO r} I32
  foreign import ccall "memmove" copy-memory :: forall r. I64 -> I64 -> I64 ->{IO r} I64

  -- The caller has checked the word against its containing region. The
  -- invariant is local to this module and includes the lifetime of the mapping.
  prim load-word :: I64 -> I64 -> U32 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %ptr = getelementptr i8, ptr %base, i64 %1
      %word = load i32, ptr %ptr, align 1
      ret i32 %word
    } when endian little
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %ptr = getelementptr i8, ptr %base, i64 %1
      %word = load i32, ptr %ptr, align 1
      %value = call i32 @llvm.bswap.i32(i32 %word)
      ret i32 %value
    } when endian big

  data Region where
    Region :: Nat -> Nat -> Region
  data FlatBodies where
    FlatBodies :: Region -> Region -> Region -> Region -> FlatBodies
  data BodyFormat where
    Recipes :: Region -> Region -> BodyFormat
    Indexed :: FlatBodies -> BodyFormat
  data AbiSection where
    JsonAbi :: Region -> AbiSection
    StructuredAbi :: Region -> AbiSection
  data Package where
    Package :: Region -> Region -> BodyFormat -> Region -> AbiSection -> Package
  data Definitions where
    NoDefinitions :: Definitions
    RecipeDefinitions :: Array Json -> Definitions
    IndexedDefinitions :: FlatBodies -> Array Json -> Definitions

  region-size :: Region -> Nat
  region-size region = case region of Region start length -> length
  region-start :: Region -> Nat
  region-start region = case region of Region start length -> start

  word :: I64 -> Nat -> Nat
  word address at = u32-to-nat (load-word address (machine-offset at))

  -- Positions are bounded by the validated 32-bit package extents.
  machine-offset :: Nat -> I64
  machine-offset at = case checked-nat-to-i64 at of
    Some offset -> offset
    None -> 0

  subregion :: Region -> Nat -> Nat -> Result String Region
  subregion region offset size = case region of
    Region start length ->
      if offset + size <= length then Ok (Region (start + offset) size)
      else Err "package span outside its section"

  row-span :: I64 -> Region -> Nat -> Result String Region
  row-span address region at = subregion region (word address at) (word address (at + 4))

  sections :: I64 -> Nat -> Nat -> Nat -> Nat -> Option (List Region)
  sections address size end at previous =
    if at == end then (if previous == size then Some Nil else None) else
      let start = word address at in
      let length = word address (at + 4) in
      let limit = start + length in
      if start /= previous || limit > size then None else
        (case sections address size end (at + 8) limit of
          None -> None
          Some rest -> Some (Cons (Region start length) rest))

  package-header :: I64 -> Nat -> Result String Package
  package-header address size =
    if size < 80 || word address 0 /= 1129204035 || word address 8 /= size then Err "invalid interface package header" else
      let magic = word address 4 in
      let version = word address 12 in
      if magic == 843796552 && version == 2 then
        (case sections address size 80 16 80 of
          Some [strings, modules, values, bodies, edges, recipes, documents, abi] ->
            checked-sections strings modules values bodies edges (Recipes bodies recipes) documents (JsonAbi abi)
          other -> Err "invalid interface package section directory")
      else if ((magic == 860573768 && version == 3) || (magic == 877350984 && version == 4)) && size >= 88 then
        (case sections address size 88 16 88 of
          Some [strings, modules, values, bodies, edges, nodes, operands, documents, abi] ->
            if region-size nodes % 16 /= 0 || region-size operands % 4 /= 0 then Err "mis-sized packed body node or operand section"
            else checked-sections strings modules values bodies edges (Indexed (FlatBodies bodies edges nodes operands)) documents
              (if version == 4 then StructuredAbi abi else JsonAbi abi)
          other -> Err "invalid interface package section directory")
      else Err "invalid interface package header"

  checked-sections :: Region -> Region -> Region -> Region -> Region -> BodyFormat -> Region -> AbiSection -> Result String Package
  checked-sections strings modules values bodies edges format documents abi =
    if region-size modules % 36 /= 0 || region-size bodies % 32 /= 0 ||
       region-size values % 32 /= 0 || region-size edges % 4 /= 0 then Err "mis-sized interface package section"
    else Ok (Package strings modules format documents abi)

  -- The caller has authenticated these bytes as the object's metadata.
  -- Reuse the package directory check before exposing the ABI section.
  packaged-abi :: forall r. String -> Bytes ->{IO r} Result String (Option Json)
  packaged-abi path source =
    let size = bytes-len source in
    if size < 8 then Ok None else hold-package-source source (decode-packaged-abi path source (bytes-data source) size)

  -- Keep the owner live until the decoder has finished its raw reads.
  hold-package-source :: forall a. Bytes -> a -> a
  hold-package-source source result = case bytes-len source of _ -> result

  decode-packaged-abi :: forall r. String -> Bytes -> I64 -> Nat ->{IO r} Result String (Option Json)
  decode-packaged-abi path source address size =
    let magic = word address 4 in
    if word address 0 /= 1129204035 || (magic /= 843796552 && magic /= 860573768 && magic /= 877350984) then Ok None else
      (case package-header address size of
        Err message -> Err message
        Ok (Package strings modules format documents abi) -> (case abi of
          JsonAbi (Region start length) ->
            if length == 0 then Err "interface package has no object ABI"
            else if start + length <= bytes-len source then
              (case parse-json path (bytes-slice source start (start + length)) of
                Parsed artifact Nil -> Ok (Some artifact)
                other -> Err "runtime object manifest is not valid JSON")
            else Err "invalid interface package ABI span"
          StructuredAbi (Region start length) ->
            if length == 0 then Err "interface package has no object ABI"
            else if length < 4 then Err "truncated structured ABI header"
            else if region-size strings < 4 || word address start > word address (region-start strings) then
              Err "invalid structured ABI string boundary"
            else (case read-string-table address strings None of
              Err message -> Err message
              Ok (raw, texts) -> (case read-document address texts NoDefinitions (Region (start + 4) (length - 4)) of
                Err message -> Err message
                Ok artifact -> Ok (Some artifact)))))

  read-text :: forall r. I64 -> Region ->{IO r} Result String String
  read-text address region = case region of
    Region start size ->
      let bytes = bytes-new size in
      let destination = bytes-data bytes in
      let copied = (if size == 0 then destination
        else copy-memory destination (wrapping-add-i64 address (machine-offset start)) (machine-offset size)) in
      if copied /= bytes-data bytes then Err "cannot read interface package text" else
        (case string-from-bytes bytes of
          Some value -> Ok value
          None -> Err "invalid UTF-8 in interface package")

  text-at :: forall r. I64 -> Region -> Nat ->{IO r} Result String String
  text-at address strings at = case row-span address strings at of
    Err message -> Err message
    Ok region -> read-text address region

  read-document :: forall r. I64 -> Array String -> Definitions -> Region ->{IO r} Result String Json
  read-document address strings definitions region = case region of
    Region start size ->
      let limit = start + size in
      case read-value address strings definitions start limit 256 of
        Err message -> Err message
        Ok (value, end) -> if end == limit then Ok value else Err "trailing bytes in structured contract"

  read-value :: forall r. I64 -> Array String -> Definitions -> Nat -> Nat -> Nat ->{IO r} Result String (Json, Nat)
  read-value address strings definitions at limit depth =
    if depth == 0 || at + 4 > limit then Err "truncated or over-nested structured contract" else
      let cursor = at + 4 in
      case word address at of
        0 -> Ok (JNull, cursor)
        1 -> Ok (JBool False, cursor)
        2 -> Ok (JBool True, cursor)
        3 -> read-number address cursor limit False
        4 -> if cursor + 4 > limit then Err "truncated text index" else
          (case array-get strings (word address cursor) of
            None -> Err "text outside package string table"
            Some value -> Ok (JStr value, cursor + 4))
        5 -> if cursor + 4 > limit then Err "truncated array header" else
          read-array address strings definitions (word address cursor) (cursor + 4) limit (depth - 1) Nil
        6 -> if cursor + 4 > limit then Err "truncated object header" else
          read-object address strings definitions (word address cursor) (cursor + 4) limit (depth - 1) None Nil
        7 -> (case definitions of
          RecipeDefinitions rows | cursor + 4 <= limit -> read-definitions address rows (word address cursor) (cursor + 4) limit 0 Nil
          other -> Err "invalid shared definition table")
        8 -> read-number address cursor limit True
        9 -> (case definitions of
          IndexedDefinitions flat rows | cursor + 4 <= limit -> (case read-body-closure address strings flat rows (word address cursor) of
            Err message -> Err message
            Ok body -> Ok (body, cursor + 4))
          other -> Err "unexpected packed body root")
        other -> Err "unknown structured contract tag"

  read-number :: I64 -> Nat -> Nat -> Bool -> Result String (Json, Nat)
  read-number address at limit negative =
    if at + 8 > limit then Err "truncated structured contract integer" else
      let value = nat-to-int (word address at + word address (at + 4) * 4294967296) in
      Ok (JNum (if negative then 0 - value else value), at + 8)

  array-from-reverse :: List Json -> Json -> Json
  array-from-reverse items out = case items of
    Nil -> out
    Cons item rest -> array-from-reverse rest (JArr item out)

  object-from-reverse :: List (String, Json) -> Json -> Json
  object-from-reverse items out = case items of
    Nil -> out
    Cons (name, item) rest -> object-from-reverse rest (JObj name item out)

  read-array :: forall r. I64 -> Array String -> Definitions -> Nat -> Nat -> Nat -> Nat -> List Json ->{IO r} Result String (Json, Nat)
  read-array address strings definitions left at limit depth items =
    if left == 0 then Ok (array-from-reverse items JArrEnd, at) else
      (case read-value address strings definitions at limit depth of
        Err message -> Err message
        Ok (item, end) -> read-array address strings definitions (left - 1) end limit depth (Cons item items))

  out-of-order :: Option String -> String -> Bool
  out-of-order previous name = case previous of
    None -> False
    Some earlier -> string-compare earlier name >= 0

  read-object :: forall r. I64 -> Array String -> Definitions -> Nat -> Nat -> Nat -> Nat -> Option String -> List (String, Json) ->{IO r} Result String (Json, Nat)
  read-object address strings definitions left at limit depth previous items =
    if left == 0 then Ok (object-from-reverse items JObjEnd, at)
    else if at + 4 > limit then Err "truncated field key" else
      (case array-get strings (word address at) of
        None -> Err "field key outside package string table"
        Some name -> if out-of-order previous name then Err "unordered or duplicate structured contract field" else
          (case read-value address strings definitions (at + 4) limit depth of
            Err message -> Err message
            Ok (item, end) -> read-object address strings definitions (left - 1) end limit depth (Some name) (Cons (name, item) items)))

  read-definitions :: I64 -> Array Json -> Nat -> Nat -> Nat -> Nat -> List Json -> Result String (Json, Nat)
  read-definitions address definitions left at limit count items =
    if left == 0 then Ok (array-from-reverse items JArrEnd, at)
    else if at + 8 > limit then Err "truncated definition range" else
      let first = word address at in
      let amount = word address (at + 4) in
      if amount == 0 || first + amount > array-length definitions ||
         count + amount > array-length definitions then Err "invalid definition range" else
        (case append-definitions definitions first (first + amount) items of
          Err message -> Err message
          Ok more -> read-definitions address definitions (left - 1) (at + 8) limit (count + amount) more)

  append-definitions :: Array Json -> Nat -> Nat -> List Json -> Result String (List Json)
  append-definitions definitions at limit items =
    if at == limit then Ok items else
      (case array-get definitions at of
        Some item -> append-definitions definitions (at + 1) limit (Cons item items)
        None -> Err "invalid definition reference")

  read-recipes :: forall r. I64 -> Array String -> Region -> Nat -> Nat -> List Json ->{IO r} Result String (Array Json)
  read-recipes address strings recipes at limit items =
    if at == limit then Ok (array-from-list (reverse items)) else
      (case row-span address recipes (at + 16) of
        Err message -> Err message
        Ok region -> case read-document address strings NoDefinitions region of
          Err message -> Err message
          Ok item -> read-recipes address strings recipes (at + 32) limit (Cons item items))

  operand-region :: Region -> Nat -> Nat -> Result String Region
  operand-region region first count = subregion region (first * 4) (count * 4)

  reversed-words :: I64 -> Nat -> Nat -> List Nat -> List Nat
  reversed-words address at end tail =
    if at == end then tail else reversed-words address (at + 4) end (Cons (word address at) tail)

  read-parameters :: I64 -> Array String -> Nat -> Nat -> Json -> Result String Json
  read-parameters address strings start end tail =
    if start == end then Ok tail
    else if end < 4 then Err "truncated packed body parameter" else
      let previous = end - 4 in
      (case array-get strings (word address previous) of
        Some sort -> read-parameters address strings start previous (JArr (JStr sort) tail)
        None -> Err "packed body parameter outside package string table")

  -- The writer emits each definition contiguously in postorder. A reverse
  -- walk must consume its exact interval, once per node, before any
  -- node becomes part of a managed term or escapes the mapping.
  read-flat-term :: I64 -> Array String -> FlatBodies -> Nat -> Nat -> Nat -> Nat -> List Nat -> Result String (Json, Nat, List Nat)
  read-flat-term address strings flat first cursor id depth targets =
    case flat of
      FlatBodies bodies edges nodes operands ->
        if depth == 0 then Err "over-nested packed body"
        else if id >= region-size nodes / 16 then Err "packed body node outside its section"
        else if id < first || id + 1 /= cursor then Err "packed body child is not in postorder"
        else
          let at = region-start nodes + id * 16 in
          let a = word address (at + 4) in
          let b = word address (at + 8) in
          let c = word address (at + 12) in
          let left = depth - 1 in
          (case word address at of
            0 | b == 0 && c == 0 ->
              Ok (JObj "node" (JStr "local") (JObj "slot" (JNum (nat-to-int a)) JObjEnd), id, targets)
            1 | c == 0 -> (case (array-get strings a, array-get strings b) of
              (Some sort, Some decimal) ->
                Ok (JObj "decimal" (JStr decimal) (JObj "node" (JStr "number") (JObj "sort" (JStr sort) JObjEnd)), id, targets)
              other -> Err "packed body number outside package string table")
            2 | a <= 1 && b == 0 && c == 0 ->
              Ok (JObj "node" (JStr "bool") (JObj "value" (JBool (a == 1)) JObjEnd), id, targets)
            3 -> (case array-get strings a of
              Some operation -> read-flat-application address strings flat first id left "primitive" "operation" operation b c targets
              None -> Err "packed body primitive outside package string table")
            4 -> if a >= region-size bodies / 32 then Err "packed body definition outside its section" else
              (case array-get strings (word address (region-start bodies + a * 32)) of
                Some callee -> read-flat-application address strings flat first id left "call" "target" callee b c (Cons a targets)
                None -> Err "packed body target outside package string table")
            5 | c == 0 -> (case read-flat-children address strings flat first id left [b, a] JArrEnd targets of
              Ok (JArr value (JArr body JArrEnd), next, calls) ->
                Ok (JObj "body" body (JObj "node" (JStr "let") (JObj "value" value JObjEnd)), next, calls)
              Err message -> Err message
              other -> Err "invalid packed let")
            6 -> (case read-flat-children address strings flat first id left [c, b, a] JArrEnd targets of
              Ok (JArr condition (JArr yes (JArr no JArrEnd)), next, calls) ->
                Ok (JObj "condition" condition (JObj "no" no (JObj "node" (JStr "if") (JObj "yes" yes JObjEnd))), next, calls)
              Err message -> Err message
              other -> Err "invalid packed conditional")
            other -> Err "invalid packed body node")

  read-flat-children :: I64 -> Array String -> FlatBodies -> Nat -> Nat -> Nat -> List Nat -> Json -> List Nat -> Result String (Json, Nat, List Nat)
  read-flat-children address strings flat first cursor depth children tail targets = case children of
    Nil -> Ok (tail, cursor, targets)
    Cons id rest -> (case read-flat-term address strings flat first cursor id depth targets of
      Err message -> Err message
      Ok (node, next, calls) -> read-flat-children address strings flat first next depth rest (JArr node tail) calls)

  read-flat-application :: I64 -> Array String -> FlatBodies -> Nat -> Nat -> Nat -> String -> String -> String -> Nat -> Nat -> List Nat -> Result String (Json, Nat, List Nat)
  read-flat-application address strings flat first cursor depth kind key name start count targets =
    case flat of
      FlatBodies bodies edges nodes operands ->
        (case operand-region operands start count of
          Err message -> Err message
          Ok (Region at length) ->
            let children = reversed-words address at (at + length) Nil in
            case read-flat-children address strings flat first cursor depth children JArrEnd targets of
              Err message -> Err message
              Ok (arguments, next, calls) ->
                Ok (JObj "arguments" arguments (JObj "node" (JStr kind) (JObj key (JStr name) JObjEnd)), next, calls))

  skip-target :: Nat -> List Nat -> List Nat
  skip-target callee calls = case calls of
    Cons first rest | first == callee -> skip-target callee rest
    other -> calls

  edges-agree :: I64 -> Nat -> Nat -> List Nat -> Bool
  edges-agree address at end calls = case calls of
    Nil -> at == end
    Cons first rest -> at < end && word address at == first &&
      edges-agree address (at + 4) end (skip-target first rest)

  read-flat-rows :: I64 -> Array String -> FlatBodies -> Nat -> Nat -> Option String -> List Json -> Result String Definitions
  read-flat-rows address strings flat index first previous rows =
    case flat of
      FlatBodies bodies edges nodes operands ->
        if index == region-size bodies / 32 then
          (if first /= region-size nodes / 16 then Err "unreferenced packed body node" else
            case check-total-graph (body-document (array-from-reverse rows JArrEnd)) of
              Some graph -> Ok (IndexedDefinitions flat (array-from-list (reverse rows)))
              None -> Err "invalid packed total-body graph")
        else
          let at = region-start bodies + index * 32 in
          let root = word address (at + 16) in
          (case (array-get strings (word address at), array-get strings (word address (at + 4))) of
            (Some identity, Some result) ->
              if string-length identity == 0 || out-of-order previous identity || word address (at + 28) /= 0 then Err "invalid packed body definition row" else
                (case (operand-region operands (word address (at + 8)) (word address (at + 12)),
                       operand-region edges (word address (at + 20)) (word address (at + 24))) of
                  (Ok (Region parameter-start parameter-size), Ok (Region edge-start edge-size)) ->
                    (case read-parameters address strings parameter-start (parameter-start + parameter-size) JArrEnd of
                      Err message -> Err message
                      Ok parameters -> (case read-flat-term address strings flat first (root + 1) root 256 Nil of
                        Err message -> Err message
                        Ok (body, next, calls) ->
                          if next /= first then Err "unreferenced packed body node"
                          else if not (edges-agree address edge-start (edge-start + edge-size) (sort calls)) then Err "packed body dependencies disagree with its expression"
                          else
                            let row = JObj "body" body (JObj "identity" (JStr identity) (JObj "parameters" parameters (JObj "result" (JStr result) JObjEnd))) in
                            read-flat-rows address strings flat (index + 1) (root + 1) (Some identity) (Cons row rows)))
                  other -> Err "packed body span outside its section")
            other -> Err "packed body definition outside package string table")

  body-document :: Json -> Json
  body-document definitions = JObj "definitions" definitions (JObj "version" (JNum 1) JObjEnd)

  -- The indexed table has already been checked. Walk only the reachable
  -- body IDs, even when the package has many independent exports.
  reachable-bodies :: I64 -> Array String -> Region -> Region -> List Nat -> HashMap String () -> List Nat -> Result String (List Nat)
  reachable-bodies address strings bodies edges pending seen selected = case pending of
    Nil -> Ok selected
    Cons first rest ->
      if first >= region-size bodies / 32 then Err "packed body definition outside its section" else
        let at = region-start bodies + first * 32 in
        (case array-get strings (word address at) of
          None -> Err "packed body identity outside package string table"
          Some identity -> (case hash-map-lookup identity seen of
            Some known -> reachable-bodies address strings bodies edges rest seen selected
            None -> (case operand-region edges (word address (at + 20)) (word address (at + 24)) of
              Err message -> Err message
              Ok (Region start length) ->
                reachable-bodies address strings bodies edges (reversed-words address start (start + length) rest)
                  (hash-map-insert identity () seen) (Cons first selected))))

  body-rows :: Array Json -> List Nat -> Json -> Result String Json
  body-rows rows indices tail = case indices of
    Nil -> Ok (body-document tail)
    Cons first rest -> (case array-get rows first of
      Some row -> body-rows rows rest (JArr row tail)
      None -> Err "packed body definition outside its section")

  read-body-closure :: I64 -> Array String -> FlatBodies -> Array Json -> Nat -> Result String Json
  read-body-closure address strings flat rows root = case flat of
    FlatBodies bodies edges nodes operands ->
      if root >= region-size bodies / 32 then Err "packed body definition outside its section"
      else if word address (region-start bodies + root * 32 + 24) == 0 then body-rows rows [root] JArrEnd
      else (case reachable-bodies address strings bodies edges [root] hash-map-empty Nil of
          Err message -> Err message
          Ok selected -> body-rows rows (reverse (sort selected)) JArrEnd)

  read-package-definitions :: forall r. I64 -> Array String -> BodyFormat ->{IO r} Result String Definitions
  read-package-definitions address strings format = case format of
    Recipes (Region bodies size) recipes -> (case read-recipes address strings recipes bodies (bodies + size) Nil of
      Err message -> Err message
      Ok rows -> Ok (RecipeDefinitions rows))
    Indexed flat -> read-flat-rows address strings flat 0 0 None Nil

  read-strings :: forall r. I64 -> Region -> Nat -> Nat -> List String ->{IO r} Result String (Array String)
  read-strings address raw at limit items =
    if at == limit then Ok (array-from-list (reverse items)) else
      (case text-at address raw at of
        Err message -> Err message
        Ok value -> read-strings address raw (at + 8) limit (Cons value items))

  read-string-table :: forall r. I64 -> Region -> Option Nat ->{IO r} Result String (Region, Array String)
  read-string-table address (Region base length) count-limit =
    if length < 4 then Err "truncated package string table" else
      let count = word address base in
      let table-size = 4 + count * 8 in
      let needed = (case count-limit of Some limit -> limit; None -> count) in
      if table-size > length then Err "invalid package string table length" else
        if needed > count then Err "invalid structured ABI string boundary" else
          let raw = Region (base + table-size) (length - table-size) in
          (case read-strings address raw (base + 4) (base + 4 + needed * 8) Nil of
            Err message -> Err message
            Ok texts -> Ok (raw, texts))

  contract-string-count :: I64 -> AbiSection -> Option Nat
  contract-string-count address abi = case abi of
    StructuredAbi (Region start length) | length >= 4 -> Some (word address start)
    other -> None

  read-rows :: forall r. I64 -> Region -> Array String -> Region -> Definitions -> Nat -> Nat -> Nat -> List (String, String, Json) ->{IO r} Result String (List (String, String, Json))
  read-rows address raw strings documents definitions base count index items =
    if index == count then Ok (reverse items) else
      let id = word address (base + index * 36 + 32) in
      if id >= count then Err "invalid package manifest index" else
        let row = base + id * 36 in
        (case text-at address raw row of
          Err message -> Err message
          Ok name -> case text-at address raw (row + 8) of
            Err message -> Err message
            Ok digest -> case row-span address documents (row + 24) of
              Err message -> Err message
              Ok region -> case read-document address strings definitions region of
                Err message -> Err message
                Ok document -> read-rows address raw strings documents definitions base count (index + 1) (Cons (name, digest, document) items))

  decode-package :: forall r. I64 -> Nat ->{IO r} Result String (List (String, String, Json))
  decode-package address size = case package-header address size of
    Err message -> Err message
    Ok (Package strings (Region modules module-size) format documents abi) ->
      case read-string-table address strings (contract-string-count address abi) of
        Err message -> Err message
        Ok (raw, texts) -> case read-package-definitions address texts format of
          Err message -> Err message
          Ok definitions -> read-rows address raw texts documents definitions modules (module-size / 36) 0 Nil

  read-package-documents :: forall r. using (io :: Io r) => String ->{IO r} Result String (List (String, String, Json))
  read-package-documents path = case sys-open-read path of
    Err error -> Err "cannot open interface package"
    Ok fd ->
      let outcome = (case sys-lseek fd 0 sys-seek-end of
            Ok size | size > 0 && size <= 4294967295 -> Ok (size, map-file 0 size 1 2 (saturating-i64-to-i32 fd) 0)
            other -> Err "invalid interface package length") in
      case sys-close fd of
        _ -> case outcome of
          Err message -> Err message
          Ok (size, address) ->
            if address == -1 || address == 0 then Err "cannot map interface package" else
              let result = (case checked-nat-from-i64 size of
                Some count -> decode-package address count
                None -> Err "invalid interface package length") in
              case unmap-file address size of
                _ -> result
