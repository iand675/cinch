-- Typed interface packages. Packed body references keep the verified byte
-- snapshot alive and never expose its address.
module Bootstrap.Package where

  import Bootstrap.BodyScope (BodyScope, body-scope-from-list, push-body-slot, body-slot)
  import Bootstrap.Interface (sha256-hex, fnv-byte, fnv-json-value, fnv-json-string, u64-decimal)
  import Bootstrap.PackedBody (Region, PackedSignature, region-start, hold-package-source,
    CheckedBodyTable, PackedTerm, retain-checked-body-table, checked-body-id, checked-definition, checked-term)
  import Bootstrap.TotalRules (valid-sort, decimal-number, operation-type)
  import Data.Array (array-append, array-from-list, array-get, array-length)
  import Data.Bytes (bytes-data, bytes-len, bytes-new)
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Bootstrap.Document
  import Data.List (sort)
  import Data.Machine (u32-to-nat)
  import Data.Nat (checked-nat-to-i64, checked-nat-from-i64, nat-to-int, nat-to-i64)
  import Prim.Sys (sys-open-read, sys-close, sys-lseek, sys-seek-end, sys-seek-set, sys-read)
  import Text.Fnv (fnv64a-update)
  import Text.Lex (bytes-slice)
  import Text.Parse (ParseOutcome, Parsed)

  export PackageContract, package-contract, read-package-documents, packaged-abi
  export PackageSnapshot, read-package-snapshot, authenticated-snapshot-abi
  export PackedBodyTable, packed-definition-for

  foreign import ccall "memmove" copy-memory :: forall r. I64 -> I64 -> I64 ->{IO r} I64

  -- The caller has checked the word against its containing region. The
  -- validator and checked views keep the backing bytes live through the read.
  prim load-word :: I64 -> I64 -> U32 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %ptr = getelementptr i8, ptr %base, i64 %1
      %word = load i32, ptr %ptr, align 1
      ret i32 %word
    } when endian little
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %ptr = getelementptr i8, ptr %base, i64 %1
      %word = load i32, ptr %ptr, align 1
      %value = call i32 @llvm.bswap.i32(i32 %word)
      ret i32 %value
    } when endian big

  data PackedTable where
    PackedTable :: I64 -> Array String -> Region -> Region -> Array PackedSignature -> PackedTable
  data FlatBodies where
    FlatBodies :: Region -> Region -> Region -> Region -> FlatBodies
  data BodyFormat where
    Recipes :: Region -> Region -> BodyFormat
    Indexed :: FlatBodies -> BodyFormat
  data AbiSection where
    JsonAbi :: Region -> AbiSection
    StructuredAbi :: Region -> AbiSection
  data Package where
    Package :: Region -> Region -> BodyFormat -> Region -> AbiSection -> Package
  data StringTable where
    StringTable :: Nat -> Nat -> Region -> StringTable
  data PackageSnapshot where
    PackageSnapshot :: Bytes -> StringTable -> Array String -> AbiSection -> PackageSnapshot
  data PackedBodyTable where
    BodyTable :: CheckedBodyTable -> HashMap String Json -> PackedBodyTable

  data PackageContract where
    PackageContract :: String -> String -> Json -> String -> Option PackedBodyTable -> PackageContract

  package-contract :: PackageContract -> (String, String, (Json, String, Option PackedBodyTable))
  package-contract (PackageContract name declared doc computed bodies) = (name, declared, (doc, computed, bodies))

  -- Prepare these fixed canonical fragments once per package.
  record WireSyntax where
    localNode :: Bytes
    decimalField :: Bytes
    numberSort :: Bytes
    falseNode :: Bytes
    trueNode :: Bytes
    primitiveOperation :: Bytes
    callTarget :: Bytes
    letBody :: Bytes
    letValue :: Bytes
    ifCondition :: Bytes
    ifNo :: Bytes
    ifYes :: Bytes
    argumentsArray :: Bytes
    endGraph :: Bytes
    identityField :: Bytes
    parametersField :: Bytes
    resultField :: Bytes
    definitionsArray :: Bytes

  wire-syntax :: WireSyntax
  wire-syntax = WireSyntax
    { localNode = string-to-bytes "{\"node\":\"local\",\"slot\":"
    , decimalField = string-to-bytes "{\"decimal\":"
    , numberSort = string-to-bytes ",\"node\":\"number\",\"sort\":"
    , falseNode = string-to-bytes "{\"node\":\"bool\",\"value\":false}"
    , trueNode = string-to-bytes "{\"node\":\"bool\",\"value\":true}"
    , primitiveOperation = string-to-bytes ",\"node\":\"primitive\",\"operation\":"
    , callTarget = string-to-bytes ",\"node\":\"call\",\"target\":"
    , letBody = string-to-bytes "{\"body\":"
    , letValue = string-to-bytes ",\"node\":\"let\",\"value\":"
    , ifCondition = string-to-bytes "{\"condition\":"
    , ifNo = string-to-bytes ",\"no\":"
    , ifYes = string-to-bytes ",\"node\":\"if\",\"yes\":"
    , argumentsArray = string-to-bytes "{\"arguments\":["
    , endGraph = string-to-bytes "],\"version\":1}"
    , identityField = string-to-bytes ",\"identity\":"
    , parametersField = string-to-bytes ",\"parameters\":["
    , resultField = string-to-bytes ",\"result\":"
    , definitionsArray = string-to-bytes "{\"definitions\":["
    }

  data PackedClosure where
    PackedClosure :: List Nat -> Json -> PackedClosure
  data Definitions where
    NoDefinitions :: Definitions
    RecipeDefinitions :: Array Json -> Definitions
    IndexedDefinitions :: PackedTable -> CheckedBodyTable -> WireSyntax -> HashMap String Json -> HashMap String PackedClosure -> Definitions

  region-size :: Region -> Nat
  region-size region = case region of Region start length -> length
  word :: I64 -> Nat -> Nat
  word address at = u32-to-nat (load-word address (machine-offset at))

  -- Positions are bounded by the validated 32-bit package extents.
  machine-offset :: Nat -> I64
  machine-offset at = case checked-nat-to-i64 at of
    Some offset -> offset
    None -> 0

  subregion :: Region -> Nat -> Nat -> Result String Region
  subregion region offset size = case region of
    Region start length ->
      if offset + size <= length then Ok (Region (start + offset) size)
      else Err "package span outside its section"

  row-span :: I64 -> Region -> Nat -> Result String Region
  row-span address region at = subregion region (word address at) (word address (at + 4))

  sections :: I64 -> Nat -> Nat -> Nat -> Nat -> Option (List Region)
  sections address size end at previous =
    if at == end then (if previous == size then Some Nil else None) else
      let start = word address at in
      let length = word address (at + 4) in
      let limit = start + length in
      if start /= previous || limit > size then None else
        (case sections address size end (at + 8) limit of
          None -> None
          Some rest -> Some (Cons (Region start length) rest))

  package-header :: I64 -> Nat -> Result String Package
  package-header address size =
    if size < 80 || word address 0 /= 1129204035 || word address 8 /= size then Err "invalid interface package header" else
      let magic = word address 4 in
      let version = word address 12 in
      if magic == 843796552 && version == 2 then
        (case sections address size 80 16 80 of
          Some [strings, modules, values, bodies, edges, recipes, documents, abi] ->
            checked-sections strings modules values bodies edges (Recipes bodies recipes) documents (JsonAbi abi)
          other -> Err "invalid interface package section directory")
      else if ((magic == 860573768 && version == 3) || (magic == 877350984 && version == 4)) && size >= 88 then
        (case sections address size 88 16 88 of
          Some [strings, modules, values, bodies, edges, nodes, operands, documents, abi] ->
            if region-size nodes % 16 /= 0 || region-size operands % 4 /= 0 then Err "mis-sized packed body node or operand section"
            else checked-sections strings modules values bodies edges (Indexed (FlatBodies bodies edges nodes operands)) documents
              (if version == 4 then StructuredAbi abi else JsonAbi abi)
          other -> Err "invalid interface package section directory")
      else Err "invalid interface package header"

  checked-sections :: Region -> Region -> Region -> Region -> Region -> BodyFormat -> Region -> AbiSection -> Result String Package
  checked-sections strings modules values bodies edges format documents abi =
    if region-size modules % 36 /= 0 || region-size bodies % 32 /= 0 ||
       region-size values % 32 /= 0 || region-size edges % 4 /= 0 then Err "mis-sized interface package section"
    else Ok (Package strings modules format documents abi)

  -- The caller has authenticated these bytes as the object's metadata.
  -- Reuse the package directory check before exposing the ABI section.
  packaged-abi :: forall r. String -> Bytes ->{IO r} Result String (Option Json)
  packaged-abi path source =
    let size = bytes-len source in
    if size < 8 then Ok None else hold-package-source source (decode-packaged-abi path source (bytes-data source) size)

  decode-packaged-abi :: forall r. String -> Bytes -> I64 -> Nat ->{IO r} Result String (Option Json)
  decode-packaged-abi path source address size =
    let magic = word address 4 in
    if word address 0 /= 1129204035 || (magic /= 843796552 && magic /= 860573768 && magic /= 877350984) then Ok None else
      (case package-header address size of
        Err message -> Err message
        Ok (Package strings modules format documents abi) ->
          (case decode-package-abi path source address abi (string-table address strings) None of
            Err message -> Err message
            Ok artifact -> Ok (Some artifact)))

  decode-package-abi :: forall r. String -> Bytes -> I64 -> AbiSection -> Result String StringTable -> Option (Array String) ->{IO r} Result String Json
  decode-package-abi path source address abi table prefix = case abi of
    JsonAbi (Region start length) ->
      if length == 0 then Err "interface package has no object ABI"
      else if start + length <= bytes-len source then
        (case parse-json path (bytes-slice source start (start + length)) of
          Parsed artifact Nil -> Ok artifact
          other -> Err "runtime object manifest is not valid JSON")
      else Err "invalid interface package ABI span"
    StructuredAbi (Region start length) ->
      if length == 0 then Err "interface package has no object ABI"
      else if length < 4 then Err "truncated structured ABI header"
      else (case table of
        Err message -> Err message
        Ok (StringTable beginning count raw) -> if word address start > count then Err "invalid structured ABI string boundary"
          else (case abi-texts address (StringTable beginning count raw) prefix of
            Err message -> Err message
            Ok texts -> read-document address texts NoDefinitions (Region (start + 4) (length - 4))))

  authenticated-snapshot-abi :: forall r. String -> String -> PackageSnapshot ->{IO r} Result String Json
  authenticated-snapshot-abi path sha snapshot = case snapshot of
    PackageSnapshot source table texts abi ->
      if string-compare (sha256-hex source) sha /= 0 then Err "runtime object artifact digest mismatch"
      else hold-package-source source (decode-package-abi path source (bytes-data source) abi (Ok table) (Some texts))

  read-text :: forall r. I64 -> Region ->{IO r} Result String String
  read-text address region = case region of
    Region start size ->
      let bytes = bytes-new size in
      let destination = bytes-data bytes in
      let copied = (if size == 0 then destination
        else copy-memory destination (wrapping-add-i64 address (machine-offset start)) (machine-offset size)) in
      if copied /= bytes-data bytes then Err "cannot read interface package text" else
        (case string-from-bytes bytes of
          Some value -> Ok value
          None -> Err "invalid UTF-8 in interface package")

  text-at :: forall r. I64 -> Region -> Nat ->{IO r} Result String String
  text-at address strings at = case row-span address strings at of
    Err message -> Err message
    Ok region -> read-text address region

  -- A zero intermediate state falls back to the canonical writer. That
  -- also handles strings containing an escape, without copying plain text.
  fnv-plain-quoted-range :: U64 -> I64 -> Nat -> Nat -> U64
  fnv-plain-quoted-range hash address start size =
    let end = start + size in
    if start <= 4294967295 && end <= 4294967295 then
      hash-plain-utf8 address (nat-to-i64 start) (nat-to-i64 end) (fnv-byte hash 34)
    else 0

  hash-plain-utf8 :: I64 -> I64 -> I64 -> U64 -> U64
  hash-plain-utf8 address at end hash =
    if at == end then fnv-byte hash 34
    else if le-i64 (wrapping-add-i64 at 8) end then
      let next = fnv-plain-octet hash address at in
      if eq-u64 next 0 then 0 else hash-plain-utf8 address (wrapping-add-i64 at 8) end next
    else
      let next = fnv-plain-byte hash address at in
      if eq-u64 next 0 then 0 else hash-plain-utf8 address (wrapping-add-i64 at 1) end next

  -- Bounded by hash-plain-utf8. Vector lanes follow address order on
  -- either endianness, and the FNV steps remain sequential.
  prim fnv-plain-octet :: U64 -> I64 -> I64 -> U64 where
    unsafe llvm {
      %base = inttoptr i64 %1 to ptr
      %at = getelementptr i8, ptr %base, i64 %2
      %raw = load <8 x i8>, ptr %at, align 1
      %control = icmp ult <8 x i8> %raw, <i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32>
      %quote = icmp eq <8 x i8> %raw, <i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34>
      %backslash = icmp eq <8 x i8> %raw, <i8 92, i8 92, i8 92, i8 92, i8 92, i8 92, i8 92, i8 92>
      %escapes = or <8 x i1> %quote, %backslash
      %needs-escape = or <8 x i1> %control, %escapes
      %mask = bitcast <8 x i1> %needs-escape to i8
      %plain = icmp eq i8 %mask, 0
      %byte0 = extractelement <8 x i8> %raw, i32 0
      %word0 = zext i8 %byte0 to i64
      %mixed0 = xor i64 %0, %word0
      %hash0 = mul i64 %mixed0, 1099511628211
      %byte1 = extractelement <8 x i8> %raw, i32 1
      %word1 = zext i8 %byte1 to i64
      %mixed1 = xor i64 %hash0, %word1
      %hash1 = mul i64 %mixed1, 1099511628211
      %byte2 = extractelement <8 x i8> %raw, i32 2
      %word2 = zext i8 %byte2 to i64
      %mixed2 = xor i64 %hash1, %word2
      %hash2 = mul i64 %mixed2, 1099511628211
      %byte3 = extractelement <8 x i8> %raw, i32 3
      %word3 = zext i8 %byte3 to i64
      %mixed3 = xor i64 %hash2, %word3
      %hash3 = mul i64 %mixed3, 1099511628211
      %byte4 = extractelement <8 x i8> %raw, i32 4
      %word4 = zext i8 %byte4 to i64
      %mixed4 = xor i64 %hash3, %word4
      %hash4 = mul i64 %mixed4, 1099511628211
      %byte5 = extractelement <8 x i8> %raw, i32 5
      %word5 = zext i8 %byte5 to i64
      %mixed5 = xor i64 %hash4, %word5
      %hash5 = mul i64 %mixed5, 1099511628211
      %byte6 = extractelement <8 x i8> %raw, i32 6
      %word6 = zext i8 %byte6 to i64
      %mixed6 = xor i64 %hash5, %word6
      %hash6 = mul i64 %mixed6, 1099511628211
      %byte7 = extractelement <8 x i8> %raw, i32 7
      %word7 = zext i8 %byte7 to i64
      %mixed7 = xor i64 %hash6, %word7
      %hash7 = mul i64 %mixed7, 1099511628211
      %next = select i1 %plain, i64 %hash7, i64 0
      ret i64 %next
    }

  prim fnv-plain-byte :: U64 -> I64 -> I64 -> U64 where
    unsafe llvm {
      %base = inttoptr i64 %1 to ptr
      %at = getelementptr i8, ptr %base, i64 %2
      %byte = load i8, ptr %at, align 1
      %control = icmp ult i8 %byte, 32
      %quote = icmp eq i8 %byte, 34
      %backslash = icmp eq i8 %byte, 92
      %escapes = or i1 %quote, %backslash
      %needs-escape = or i1 %control, %escapes
      %word = zext i8 %byte to i64
      %mixed = xor i64 %0, %word
      %hash = mul i64 %mixed, 1099511628211
      %next = select i1 %needs-escape, i64 0, i64 %hash
      ret i64 %next
    }

  -- All referenced strings have already been bounds and UTF-8 checked by
  -- read-strings. Hash the same bytes in place while the mapping is live.
  digest-string :: I64 -> Option StringTable -> U64 -> Nat -> String -> U64
  digest-string address table hash id text = case table of
    None -> hash
    Some (StringTable base count (Region raw length)) ->
      let at = base + 8 * id in
      let start = word address at in
      let size = word address (at + 4) in
      if start + size > length then fnv-json-string hash text else
        let result = fnv-plain-quoted-range hash address (raw + start) size in
        if eq-u64 result 0 then fnv-json-string hash text else result

  digest-token :: Option StringTable -> U64 -> U64 -> U64
  digest-token table hash byte = case table of None -> hash; Some strings -> fnv-byte hash byte

  digest-value :: Option StringTable -> U64 -> Json -> U64
  digest-value table hash value = case table of None -> hash; Some strings -> fnv-json-value hash value

  read-document :: forall r. I64 -> Array String -> Definitions -> Region ->{IO r} Result String Json
  read-document address strings definitions region = case read-hashed-document address strings definitions region None of
    Err message -> Err message
    Ok (document, hash, decoded) -> Ok document

  read-hashed-document :: forall r. I64 -> Array String -> Definitions -> Region -> Option StringTable ->{IO r} Result String (Json, U64, Definitions)
  read-hashed-document address strings definitions (Region start size) table =
    let limit = start + size in
    case read-value address strings definitions start limit 256 table 0xCBF29CE484222325 of
      Err message -> Err message
      Ok (value, end, hash, decoded) -> if end == limit then Ok (value, hash, decoded) else Err "trailing bytes in structured contract"

  read-value :: forall r. I64 -> Array String -> Definitions -> Nat -> Nat -> Nat -> Option StringTable -> U64 ->{IO r} Result String (Json, Nat, U64, Definitions)
  read-value address strings definitions at limit depth table hash =
    if depth == 0 || at + 4 > limit then Err "truncated or over-nested structured contract" else
      let cursor = at + 4 in
      case word address at of
        0 -> Ok (JNull, cursor, digest-value table hash JNull, definitions)
        1 -> Ok (JBool False, cursor, digest-value table hash (JBool False), definitions)
        2 -> Ok (JBool True, cursor, digest-value table hash (JBool True), definitions)
        3 -> read-number address definitions cursor limit False table hash
        4 -> if cursor + 4 > limit then Err "truncated text index" else
          (let id = word address cursor in
            case array-get strings id of
              None -> Err "text outside package string table"
              Some value -> Ok (JStr value, cursor + 4, digest-string address table hash id value, definitions))
        5 -> if cursor + 4 > limit then Err "truncated array header" else
          read-array address strings definitions (word address cursor) (cursor + 4) limit (depth - 1) Nil table (digest-token table hash 91)
        6 -> if cursor + 4 > limit then Err "truncated object header" else
          read-object address strings definitions (word address cursor) (cursor + 4) limit (depth - 1) None Nil table (digest-token table hash 123)
        7 -> (case definitions of
          RecipeDefinitions rows | cursor + 4 <= limit -> (case read-definitions address rows (word address cursor) (cursor + 4) limit 0 Nil of
            Err message -> Err message
            Ok (body, end) -> Ok (body, end, digest-value table hash body, definitions))
          other -> Err "invalid shared definition table")
        8 -> read-number address definitions cursor limit True table hash
        9 -> (case definitions of
          IndexedDefinitions packed checked syntax rows cache | cursor + 4 <= limit -> (case read-body-closure syntax packed checked rows cache (word address cursor) table hash of
            Err message -> Err message
            Ok (body, digest, checked) -> Ok (body, cursor + 4, digest, checked))
          other -> Err "unexpected packed body root")
        other -> Err "unknown structured contract tag"

  read-number :: I64 -> Definitions -> Nat -> Nat -> Bool -> Option StringTable -> U64 -> Result String (Json, Nat, U64, Definitions)
  read-number address definitions at limit negative table hash =
    if at + 8 > limit then Err "truncated structured contract integer" else
      let value = nat-to-int (word address at + word address (at + 4) * 4294967296) in
      let number = JNum (if negative then 0 - value else value) in
      Ok (number, at + 8, digest-value table hash number, definitions)

  array-from-reverse :: List Json -> Json -> Json
  array-from-reverse items out = case items of
    Nil -> out
    Cons item rest -> array-from-reverse rest (JArr item out)

  object-from-reverse :: List (String, Json) -> Json -> Json
  object-from-reverse items out = case items of
    Nil -> out
    Cons (name, item) rest -> object-from-reverse rest (JObj name item out)

  read-array :: forall r. I64 -> Array String -> Definitions -> Nat -> Nat -> Nat -> Nat -> List Json -> Option StringTable -> U64 ->{IO r} Result String (Json, Nat, U64, Definitions)
  read-array address strings definitions left at limit depth items table hash =
    if left == 0 then Ok (array-from-reverse items JArrEnd, at, digest-token table hash 93, definitions) else
      (case read-value address strings definitions at limit depth table hash of
        Err message -> Err message
        Ok (item, end, digest, decoded) -> read-array address strings decoded (left - 1) end limit depth (Cons item items)
          table (if left == 1 then digest else digest-token table digest 44))

  out-of-order :: Option String -> String -> Bool
  out-of-order previous name = case previous of
    None -> False
    Some earlier -> string-compare earlier name >= 0

  contract-field-projection :: Nat -> String -> Option Json
  contract-field-projection depth name =
    if depth /= 255 then None
    else if string-compare name "compiler" == 0 || string-compare name "source_hash" == 0 then Some (JStr "")
    else if string-compare name "units" == 0 then Some JArrEnd
    else None

  read-object :: forall r. I64 -> Array String -> Definitions -> Nat -> Nat -> Nat -> Nat -> Option String -> List (String, Json) -> Option StringTable -> U64 ->{IO r} Result String (Json, Nat, U64, Definitions)
  read-object address strings definitions left at limit depth previous items table hash =
    if left == 0 then Ok (object-from-reverse items JObjEnd, at, digest-token table hash 125, definitions)
    else if at + 4 > limit then Err "truncated field key" else
      (let id = word address at in
        case array-get strings id of
          None -> Err "field key outside package string table"
          Some name -> if out-of-order previous name then Err "unordered or duplicate structured contract field" else
            (let prefix = digest-token table (digest-string address table hash id name) 58 in
              let projected = case table of None -> None; Some spans -> contract-field-projection depth name in
              let field-table = case projected of None -> table; Some placeholder -> None in
              case read-value address strings definitions (at + 4) limit depth field-table prefix of
                Err message -> Err message
                Ok (item, end, digest, decoded) ->
                  let next = case projected of None -> digest; Some placeholder -> digest-value table prefix placeholder in
                  read-object address strings decoded (left - 1) end limit depth (Some name) (Cons (name, item) items)
                    table (if left == 1 then next else digest-token table next 44)))

  read-definitions :: I64 -> Array Json -> Nat -> Nat -> Nat -> Nat -> List Json -> Result String (Json, Nat)
  read-definitions address definitions left at limit count items =
    if left == 0 then Ok (array-from-reverse items JArrEnd, at)
    else if at + 8 > limit then Err "truncated definition range" else
      let first = word address at in
      let amount = word address (at + 4) in
      if amount == 0 || first + amount > array-length definitions ||
         count + amount > array-length definitions then Err "invalid definition range" else
        (case append-definitions definitions first (first + amount) items of
          Err message -> Err message
          Ok more -> read-definitions address definitions (left - 1) (at + 8) limit (count + amount) more)

  append-definitions :: Array Json -> Nat -> Nat -> List Json -> Result String (List Json)
  append-definitions definitions at limit items =
    if at == limit then Ok items else
      (case array-get definitions at of
        Some item -> append-definitions definitions (at + 1) limit (Cons item items)
        None -> Err "invalid definition reference")

  read-recipes :: forall r. I64 -> Array String -> Region -> Nat -> Nat -> List Json ->{IO r} Result String (Array Json)
  read-recipes address strings recipes at limit items =
    if at == limit then Ok (array-from-list (reverse items)) else
      (case row-span address recipes (at + 16) of
        Err message -> Err message
        Ok region -> case read-document address strings NoDefinitions region of
          Err message -> Err message
          Ok item -> read-recipes address strings recipes (at + 32) limit (Cons item items))

  operand-region :: Region -> Nat -> Nat -> Result String Region
  operand-region region first count = subregion region (first * 4) (count * 4)

  reversed-words :: I64 -> Nat -> Nat -> List Nat -> List Nat
  reversed-words address at end tail =
    if at == end then tail else reversed-words address (at + 4) end (Cons (word address at) tail)

  read-parameters :: I64 -> Array String -> Nat -> Nat -> List String -> Result String (List String)
  read-parameters address strings start end tail =
    if start == end then Ok tail
    else if end < 4 then Err "truncated packed body parameter" else
      let previous = end - 4 in
      case array-get strings (word address previous) of
        Some sort -> if valid-sort sort then read-parameters address strings start previous (Cons sort tail)
          else Err "invalid packed body parameter sort"
        None -> Err "packed body parameter outside package string table"

  -- Read just the headers first so call sites can check forward references
  -- without decoding either the callee's expression or a temporary graph.
  read-flat-signatures :: I64 -> Array String -> FlatBodies -> Nat -> Option String -> List PackedSignature -> Result String (Array PackedSignature)
  read-flat-signatures address strings flat index previous rows = case flat of
    FlatBodies bodies edges nodes operands ->
      if index == region-size bodies / 32 then Ok (array-from-list (reverse rows)) else
        let at = region-start bodies + index * 32 in
        case (array-get strings (word address at), array-get strings (word address (at + 4))) of
          (Some identity, Some result) ->
            if string-length identity == 0 || out-of-order previous identity || word address (at + 28) /= 0 || not (valid-sort result) then
              Err "invalid packed body definition row"
            else
              (case (operand-region operands (word address (at + 8)) (word address (at + 12)),
                     operand-region edges (word address (at + 20)) (word address (at + 24))) of
                (Ok (Region parameter-start parameter-size), Ok calls) ->
                  (case read-parameters address strings parameter-start (parameter-start + parameter-size) Nil of
                    Err message -> Err message
                    Ok parameters ->
                      let row = PackedSignature identity parameters result (word address (at + 16)) calls in
                      read-flat-signatures address strings flat (index + 1) (Some identity) (Cons row rows))
                other -> Err "packed body span outside its section")
          other -> Err "packed body definition outside package string table"

  finish-flat-term :: String -> Nat -> Nat -> List Nat -> Result String (String, Nat, List Nat)
  finish-flat-term sort cursor id targets =
    if cursor == id then Ok (sort, id + 1, targets) else Err "unreferenced packed body node"

  -- Consume each definition's contiguous postorder interval once, in source
  -- evaluation order. A let's checked value sort is in scope only for its
  -- body. Validation does not allocate a compatibility expression tree.
  check-flat-term :: PackedTable -> BodyScope String -> Nat -> Nat -> Nat -> Nat -> List Nat -> Result String (String, Nat, List Nat)
  check-flat-term table scope cursor parent id depth targets = case table of
    PackedTable address strings nodes operands signatures ->
      if depth == 0 then Err "over-nested packed body"
      else if id >= region-size nodes / 16 then Err "packed body node outside its section"
      else if id < cursor || id >= parent then Err "packed body child is not in postorder"
      else
        let at = region-start nodes + id * 16 in
        let a = word address (at + 4) in
        let b = word address (at + 8) in
        let c = word address (at + 12) in
        let left = depth - 1 in
        (case word address at of
          0 | b == 0 && c == 0 -> (case body-slot a scope of
            Some sort -> finish-flat-term sort cursor id targets
            None -> Err "packed body local slot outside its scope")
          1 | c == 0 -> (case (array-get strings a, array-get strings b) of
            (Some sort, Some decimal) | decimal-number sort decimal ->
              finish-flat-term sort cursor id targets
            (Some sort, Some decimal) -> Err "invalid packed body number"
            other -> Err "packed body number outside package string table")
          2 | a <= 1 && b == 0 && c == 0 ->
            finish-flat-term "Bool" cursor id targets
          3 -> (case array-get strings a of
            Some operation -> (case operation-type operation of
              Some (parameters, result) ->
                check-flat-application table scope cursor id left parameters result b c targets
              None -> Err "unknown packed body primitive")
            None -> Err "packed body primitive outside package string table")
          4 -> (case array-get signatures a of
            Some (PackedSignature callee parameters result root edges) ->
              check-flat-application table scope cursor id left parameters result b c (Cons a targets)
            None -> Err "packed body definition outside its section")
          5 | c == 0 -> (case check-flat-term table scope cursor id a left targets of
            Err message -> Err message
            Ok (sort, next, calls) -> (case check-flat-term table (push-body-slot scope sort) next id b left calls of
              Err message -> Err message
              Ok (result, following, used) ->
                finish-flat-term result following id used))
          6 -> (case check-flat-term table scope cursor id a left targets of
            Err message -> Err message
            Ok (sort, next, calls) ->
              if string-compare sort "Bool" /= 0 then Err "packed body condition is not Bool" else
                (case check-flat-term table scope next id b left calls of
                  Err message -> Err message
                  Ok (yes-sort, following, used) -> (case check-flat-term table scope following id c left used of
                    Err message -> Err message
                    Ok (no-sort, final, all) ->
                      if string-compare yes-sort no-sort /= 0 then Err "packed body branch sorts disagree"
                      else finish-flat-term yes-sort final id all)))
          other -> Err "invalid packed body node")

  check-flat-arguments :: PackedTable -> BodyScope String -> Nat -> Nat -> Nat -> Nat -> Nat -> List String -> List Nat -> Result String (Nat, List Nat)
  check-flat-arguments table scope cursor parent depth at end parameters targets =
    case (at == end, parameters) of
      (True, Nil) -> Ok (cursor, targets)
      (False, Cons expected rest) -> (case table of
        PackedTable address strings nodes operands signatures ->
          (case check-flat-term table scope cursor parent (word address at) depth targets of
            Err message -> Err message
            Ok (sort, next, calls) ->
              if string-compare sort expected /= 0 then Err "packed body argument sort mismatch"
              else check-flat-arguments table scope next parent depth (at + 4) end rest calls))
      other -> Err "packed body argument arity mismatch"

  check-flat-application :: PackedTable -> BodyScope String -> Nat -> Nat -> Nat -> List String -> String -> Nat -> Nat -> List Nat -> Result String (String, Nat, List Nat)
  check-flat-application table scope cursor id depth parameters result start count targets =
    case table of
      PackedTable address strings nodes operands signatures ->
        (case operand-region operands start count of
          Err message -> Err message
          Ok (Region at length) ->
            case check-flat-arguments table scope cursor id depth at (at + length) parameters targets of
              Err message -> Err message
              Ok (next, calls) ->
                finish-flat-term result next id calls)

  skip-target :: Nat -> List Nat -> List Nat
  skip-target callee calls = case calls of
    Cons first rest | first == callee -> skip-target callee rest
    other -> calls

  edges-agree :: I64 -> Nat -> Nat -> List Nat -> Bool
  edges-agree address at end calls = case calls of
    Nil -> at == end
    Cons first rest -> at < end && word address at == first &&
      edges-agree address (at + 4) end (skip-target first rest)

  -- An explicit stack keeps a valid long chain of compact calls off the
  -- process stack. The edge spans and their agreement with call nodes have
  -- already been checked.
  data PackedVisit where
    EnterBody :: Nat -> PackedVisit
    LeaveBody :: Nat -> PackedVisit

  stack-body-edges :: I64 -> Nat -> Nat -> List PackedVisit -> List PackedVisit
  stack-body-edges address at end rest =
    if at == end then rest
    else stack-body-edges address (at + 4) end (Cons (EnterBody (word address at)) rest)

  check-body-cycles :: I64 -> Array PackedSignature -> Nat -> List PackedVisit -> HashMap Nat Nat -> Bool
  check-body-cycles address signatures next pending visited = case pending of
    Nil -> if next == array-length signatures then True
      else check-body-cycles address signatures (next + 1) [EnterBody next] visited
    Cons (EnterBody id) rest -> (case array-get signatures id of
      None -> False
      Some (PackedSignature identity parameters result root (Region start length)) ->
        if length == 0 then check-body-cycles address signatures next rest visited else
        (case hash-map-lookup id visited of
          Some done -> done == 1 && check-body-cycles address signatures next rest visited
          None -> check-body-cycles address signatures next
            (stack-body-edges address start (start + length) (Cons (LeaveBody id) rest))
            (hash-map-insert id 0 visited)))
    Cons (LeaveBody id) rest -> check-body-cycles address signatures next rest (hash-map-insert id 1 visited)

  parameter-document :: List String -> Json -> Json
  parameter-document backwards tail = case backwards of
    Nil -> tail
    Cons sort rest -> parameter-document rest (JArr (JStr sort) tail)

  check-flat-rows :: PackedTable -> Nat -> Nat -> Result String Unit
  check-flat-rows table index first = case table of
    PackedTable address strings nodes operands signatures ->
      if index == array-length signatures then
        (if first /= region-size nodes / 16 then Err "unreferenced packed body node"
         else if not (check-body-cycles address signatures 0 Nil hash-map-empty) then Err "cyclic packed total-body graph"
         else Ok ())
      else
        (case array-get signatures index of
          None -> Err "packed body definition outside its section"
          Some (PackedSignature identity parameters result root (Region edge-start edge-size)) ->
            (case check-flat-term table (body-scope-from-list parameters) first (region-size nodes / 16) root 256 Nil of
              Err message -> Err message
              Ok (actual, next, calls) ->
                if string-compare actual result /= 0 then Err "packed body result sort disagrees with its declaration"
                else if not (edges-agree address edge-start (edge-start + edge-size) (sort calls)) then Err "packed body dependencies disagree with its expression"
                else check-flat-rows table (index + 1) next))

  body-document :: Json -> Json
  body-document definitions = JObj "definitions" definitions (JObj "version" (JNum 1) JObjEnd)

  -- The verified signature table already carries the exact edge spans.
  -- Closure walks reuse those spans and never reread a definition header.
  reachable-bodies :: PackedTable -> List Nat -> HashMap Nat Nat -> List Nat -> Result String (List Nat)
  reachable-bodies packed pending seen selected = case (packed, pending) of
    (PackedTable address strings nodes operands signatures, Cons first rest) ->
      (case array-get signatures first of
        None -> Err "packed body definition outside its section"
        Some (PackedSignature identity parameters result root (Region start length)) ->
          (case hash-map-lookup first seen of
            Some known -> reachable-bodies packed rest seen selected
            None -> reachable-bodies packed (reversed-words address start (start + length) rest)
              (hash-map-insert first 0 seen) (Cons first selected)))
    (PackedTable address strings nodes operands signatures, Nil) -> Ok selected

  hash-node-text :: I64 -> StringTable -> Array String -> U64 -> Nat -> Result String U64
  hash-node-text address table strings hash id = case array-get strings id of
    None -> Err "packed body text outside package string table"
    Some text -> Ok (digest-string address (Some table) hash id text)

  hash-wire-term :: WireSyntax -> PackedTable -> StringTable -> U64 -> Nat -> Nat -> Result String U64
  hash-wire-term syntax packed table hash id depth = case packed of
    PackedTable address strings nodes operands signatures ->
      if depth == 0 || id >= region-size nodes / 16 then Err "packed body node outside its section" else
        let at = region-start nodes + id * 16 in
        let a = word address (at + 4) in
        let b = word address (at + 8) in
        let c = word address (at + 12) in
        let next = depth - 1 in
        case word address at of
          0 -> Ok (fnv-byte (fnv-json-value (fnv64a-update hash (syntax.localNode)) (JNum (nat-to-int a))) 125)
          1 -> (case hash-node-text address table strings (fnv64a-update hash (syntax.decimalField)) b of
            Err message -> Err message
            Ok literal -> (case hash-node-text address table strings (fnv64a-update literal (syntax.numberSort)) a of
              Err message -> Err message
              Ok result -> Ok (fnv-byte result 125)))
          2 -> Ok (fnv64a-update hash (if a == 0 then (syntax.falseNode) else (syntax.trueNode)))
          3 -> (case hash-wire-application syntax packed table hash b c next of
            Err message -> Err message
            Ok arguments -> (case hash-node-text address table strings
              (fnv64a-update arguments (syntax.primitiveOperation)) a of
                Err message -> Err message
                Ok operation -> Ok (fnv-byte operation 125)))
          4 -> (case array-get signatures a of
            None -> Err "packed body definition outside its section"
            Some (PackedSignature name parameters result root edges) ->
              (case hash-wire-application syntax packed table hash b c next of
                Err message -> Err message
                Ok arguments -> Ok (fnv-byte (fnv-json-string (fnv64a-update arguments (syntax.callTarget)) name) 125)))
          5 -> (case hash-wire-term syntax packed table (fnv64a-update hash (syntax.letBody)) b next of
            Err message -> Err message
            Ok body -> (case hash-wire-term syntax packed table (fnv64a-update body (syntax.letValue)) a next of
              Err message -> Err message
              Ok value -> Ok (fnv-byte value 125)))
          6 -> (case hash-wire-term syntax packed table (fnv64a-update hash (syntax.ifCondition)) a next of
            Err message -> Err message
            Ok condition -> (case hash-wire-term syntax packed table (fnv64a-update condition (syntax.ifNo)) c next of
              Err message -> Err message
              Ok no -> (case hash-wire-term syntax packed table (fnv64a-update no (syntax.ifYes)) b next of
                Err message -> Err message
                Ok yes -> Ok (fnv-byte yes 125))))
          other -> Err "invalid packed body node"

  hash-wire-application :: WireSyntax -> PackedTable -> StringTable -> U64 -> Nat -> Nat -> Nat -> Result String U64
  hash-wire-application syntax packed table hash start count depth = case packed of
    PackedTable address strings nodes operands signatures ->
      (case operand-region operands start count of
        Err message -> Err message
        Ok (Region at length) -> hash-wire-arguments syntax packed table at (at + length) depth (fnv64a-update hash (syntax.argumentsArray)))

  hash-wire-arguments :: WireSyntax -> PackedTable -> StringTable -> Nat -> Nat -> Nat -> U64 -> Result String U64
  hash-wire-arguments syntax packed table at end depth hash =
    if at == end then Ok (fnv-byte hash 93) else case packed of
      PackedTable address strings nodes operands signatures ->
        (case hash-wire-term syntax packed table hash (word address at) depth of
          Err message -> Err message
          Ok argument -> hash-wire-arguments syntax packed table (at + 4) end depth
            (if at + 4 == end then argument else fnv-byte argument 44))

  hash-parameter-list :: U64 -> List String -> U64
  hash-parameter-list hash parameters = case parameters of
    Nil -> fnv-byte hash 93
    Cons sort Nil -> fnv-byte (fnv-json-string hash sort) 93
    Cons sort rest -> hash-parameter-list (fnv-byte (fnv-json-string hash sort) 44) rest

  hash-wire-rows :: WireSyntax -> PackedTable -> StringTable -> List Nat -> U64 -> Result String U64
  hash-wire-rows syntax packed table indices hash = case (packed, indices) of
    (PackedTable address strings nodes operands signatures, Nil) -> Ok (fnv64a-update hash (syntax.endGraph))
    (PackedTable address strings nodes operands signatures, Cons first rest) ->
      (case array-get signatures first of
        None -> Err "packed body definition outside its section"
        Some (PackedSignature name parameters result root edges) ->
          (case hash-wire-term syntax packed table (fnv64a-update hash (syntax.letBody)) root 256 of
            Err message -> Err message
            Ok body ->
              let identity = fnv-json-string (fnv64a-update body (syntax.identityField)) name in
              let arguments = hash-parameter-list (fnv64a-update identity (syntax.parametersField)) parameters in
              let complete = fnv-byte (fnv-json-string (fnv64a-update arguments (syntax.resultField)) result) 125 in
              hash-wire-rows syntax packed table rest (case rest of Nil -> complete; other -> fnv-byte complete 44)))

  reference-body-rows :: CheckedBodyTable -> Array PackedSignature -> List Nat -> HashMap String Json -> Json -> Result String (Json, HashMap String Json)
  reference-body-rows checked signatures indices rows tail = case indices of
    Nil -> Ok (body-document tail, rows)
    Cons first rest -> (case array-get signatures first of
      None -> Err "packed body definition outside its section"
      Some (PackedSignature name parameters result root edges) ->
        (case hash-map-lookup name rows of
          Some row -> reference-body-rows checked signatures rest rows (JArr row tail)
          None ->
            let arguments = parameter-document (reverse parameters) JArrEnd in
            (case checked-term checked first of
              None -> Err "packed body definition outside its section"
              Some term ->
                let row = JObj "body" (JTerm term) (JObj "identity" (JStr name) (JObj "parameters" arguments (JObj "result" (JStr result) JObjEnd))) in
                reference-body-rows checked signatures rest (hash-map-insert name row rows) (JArr row tail))))

  hash-body-closure :: WireSyntax -> PackedTable -> CheckedBodyTable -> PackedClosure -> Option StringTable -> U64 -> HashMap String Json -> HashMap String PackedClosure -> Result String (Json, U64, Definitions)
  hash-body-closure syntax packed checked (PackedClosure selected document) table hash rows cache =
    let definitions = IndexedDefinitions packed checked syntax rows cache in
    case table of
      None -> Ok (document, hash, definitions)
      Some spans -> (case hash-wire-rows syntax packed spans selected (fnv64a-update hash (syntax.definitionsArray)) of
        Err message -> Err message
        Ok digest -> Ok (document, digest, definitions))

  read-body-closure :: WireSyntax -> PackedTable -> CheckedBodyTable -> HashMap String Json -> HashMap String PackedClosure -> Nat -> Option StringTable -> U64 -> Result String (Json, U64, Definitions)
  read-body-closure syntax packed checked rows cache root table hash = case packed of
    PackedTable address strings nodes operands signatures ->
      (case array-get signatures root of
        None -> Err "packed body definition outside its section"
        Some (PackedSignature name parameters result node (Region start length)) ->
          (case hash-map-lookup name cache of
            Some graph -> hash-body-closure syntax packed checked graph table hash rows cache
            None ->
              let closure = (if length == 0 then Ok [root] else reachable-bodies packed [root] hash-map-empty Nil) in
              (case closure of
                Err message -> Err message
                Ok reachable ->
                  let selected = sort reachable in
                  (case reference-body-rows checked signatures (reverse selected) rows JArrEnd of
                    Err message -> Err message
                    Ok (document, projected) ->
                      let graph = PackedClosure selected document in
                      hash-body-closure syntax packed checked graph table hash projected (hash-map-insert name graph cache)))))

  read-package-definitions :: forall r. Bytes -> Array String -> BodyFormat ->{IO r} Result String Definitions
  read-package-definitions source strings format =
    let address = bytes-data source in
    case format of
      Recipes (Region bodies size) recipes -> (case read-recipes address strings recipes bodies (bodies + size) Nil of
        Err message -> Err message
        Ok rows -> Ok (RecipeDefinitions rows))
      Indexed flat -> case flat of
        FlatBodies bodies edges nodes operands -> (case read-flat-signatures address strings flat 0 None Nil of
          Err message -> Err message
          Ok signatures ->
            let packed = PackedTable address strings nodes operands signatures in
            (case check-flat-rows packed 0 0 of
              Err message -> Err message
              Ok unit -> Ok (IndexedDefinitions packed (retain-checked-body-table source strings nodes operands signatures) wire-syntax hash-map-empty hash-map-empty)))

  read-strings :: forall r. I64 -> Region -> Nat -> Nat -> List String ->{IO r} Result String (Array String)
  read-strings address raw at limit items =
    if at == limit then Ok (array-from-list (reverse items)) else
      (case text-at address raw at of
        Err message -> Err message
        Ok value -> read-strings address raw (at + 8) limit (Cons value items))

  string-table :: I64 -> Region -> Result String StringTable
  string-table address (Region base length) =
    if length < 4 then Err "truncated package string table" else
      let count = word address base in
      let table-size = 4 + count * 8 in
      if table-size > length then Err "invalid package string table length" else
        Ok (StringTable (base + 4) count (Region (base + table-size) (length - table-size)))

  contract-texts :: forall r. I64 -> StringTable -> AbiSection ->{IO r} Result String (Array String)
  contract-texts address (StringTable start count raw) abi =
    let needed = (case contract-string-count address abi of Some limit -> limit; None -> count) in
    if needed > count then Err "invalid structured ABI string boundary" else
      read-strings address raw start (start + needed * 8) Nil

  abi-texts :: forall r. I64 -> StringTable -> Option (Array String) ->{IO r} Result String (Array String)
  abi-texts address (StringTable start count raw) prefix = case prefix of
    None -> read-strings address raw start (start + count * 8) Nil
    Some texts ->
      let used = array-length texts in
      if used == count then Ok texts else
        (case read-strings address raw (start + used * 8) (start + count * 8) Nil of
          Err message -> Err message
          Ok suffix -> Ok (array-append texts suffix))

  contract-string-count :: I64 -> AbiSection -> Option Nat
  contract-string-count address abi = case abi of
    StructuredAbi (Region start length) | length >= 4 -> Some (word address start)
    other -> None

  retain-body-table :: Definitions -> Option PackedBodyTable
  retain-body-table definitions = case definitions of
    IndexedDefinitions packed checked syntax rows cache -> case packed of
      PackedTable address strings nodes operands signatures | array-length signatures > 0 ->
        Some (BodyTable checked rows)
      other -> None
    other -> None

  -- A compatibility row may come from a legacy JSON value or a synthesized
  -- declaration. Match the complete definition before taking package authority.
  packed-definition-for :: PackedBodyTable -> String -> Json -> Option (List String, String, PackedTerm, List String)
  packed-definition-for (BodyTable table rows) name row = case hash-map-lookup name rows of
    Some original | json-eq original row -> (case checked-body-id table name of
      Some id -> (case checked-definition table id of
        Some (identity, parameters, result, term, calls) -> Some (parameters, result, term, calls)
        None -> None)
      None -> None)
    other -> None

  read-rows :: forall r. I64 -> Region -> StringTable -> Array String -> Region -> Definitions -> Nat -> Nat -> Nat -> List PackageContract ->{IO r} Result String (List PackageContract, Definitions)
  read-rows address raw table strings documents definitions base count index items =
    if index == count then Ok (reverse items, definitions) else
      let id = word address (base + index * 36 + 32) in
      if id >= count then Err "invalid package manifest index" else
        let row = base + id * 36 in
        (case text-at address raw row of
          Err message -> Err message
          Ok name -> case text-at address raw (row + 8) of
            Err message -> Err message
            Ok digest -> case row-span address documents (row + 24) of
              Err message -> Err message
              Ok region -> case read-hashed-document address strings definitions region (Some table) of
                Err message -> Err message
                Ok (document, computed, decoded) -> read-rows address raw table strings documents decoded base count (index + 1)
                  (Cons (PackageContract name digest document (u64-decimal computed) None) items))

  decode-package :: forall r. Bytes ->{IO r} Result String (List PackageContract, StringTable, Array String, AbiSection)
  decode-package source =
    let address = bytes-data source in
    case package-header address (bytes-len source) of
      Err message -> Err message
      Ok (Package strings (Region modules module-size) format documents abi) ->
        case string-table address strings of
          Err message -> Err message
          Ok (StringTable start count raw) ->
            let table = StringTable start count raw in
            case contract-texts address table abi of
              Err message -> Err message
              Ok texts -> case read-package-definitions source texts format of
                Err message -> Err message
                Ok definitions -> case read-rows address raw table texts documents definitions modules (module-size / 36) 0 Nil of
                  Err message -> Err message
                  Ok (rows, decoded) ->
                    let bodies = retain-body-table decoded in
                    Ok (map (attach-package-bodies bodies) rows, table, texts, abi)

  attach-package-bodies :: Option PackedBodyTable -> PackageContract -> PackageContract
  attach-package-bodies bodies (PackageContract name declared doc computed previous) =
    PackageContract name declared doc computed bodies

  -- Read one bounded snapshot when the contracts and object ABI have
  -- the same path. Both consumers then see the same bytes after a rename.
  read-package-snapshot :: forall r. using (io :: Io r) => String ->{IO r} Result String (List PackageContract, PackageSnapshot)
  read-package-snapshot path = case sys-open-read path of
    Err error -> Err "cannot open interface package"
    Ok fd -> case read-package-bytes fd of
      result -> case sys-close fd of
        _ -> case result of
          Err message -> Err message
          Ok source -> case hold-package-source source (decode-package source) of
            Err message -> Err message
            Ok (rows, table, texts, abi) -> Ok (rows, PackageSnapshot source table texts abi)

  read-package-bytes :: forall r. using (io :: Io r) => I64 ->{IO r} Result String Bytes
  read-package-bytes fd = case sys-lseek fd 0 sys-seek-end of
    Ok length | length > 0 && length <= 4294967295 ->
      (case (checked-nat-from-i64 length, sys-lseek fd 0 sys-seek-set) of
        (Some size, Ok start) -> fill-package-buffer fd (bytes-new size) length 0
        other -> Err "cannot read interface package")
    other -> Err "invalid interface package length"

  fill-package-buffer :: forall r. using (io :: Io r) => I64 -> Bytes -> I64 -> I64 ->{IO r} Result String Bytes
  fill-package-buffer fd bytes length used =
    if used == length then Ok bytes else
      (case sys-read fd bytes used (wrapping-sub-i64 length used) of
        Ok got | got > 0 -> fill-package-buffer fd bytes length (wrapping-add-i64 used got)
        other -> Err "cannot read interface package")

  read-package-documents :: forall r. using (io :: Io r) => String ->{IO r} Result String (List PackageContract)
  read-package-documents path = case read-package-snapshot path of
    Ok (rows, snapshot) -> Ok rows
    Err message -> Err message
