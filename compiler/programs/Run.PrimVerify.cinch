-- End-to-end test of formal LLVM `prim` verification in the self-hosted Cinch compiler.
--
-- Exercises both `Bootstrap.PrimVerify` directly (LRAT kernel verifier, SAT+LRAT
-- prover, counterexamples, SMT-LIB 2 emitter, policies, lax/off modes) and the
-- full self-hosted frontend + exporter (`Bootstrap.Parse` -> `Bootstrap.Target`
-- -> `Bootstrap.Resolve` -> `Bootstrap.Check` -> `Bootstrap.Export`), verifying:
--   1. `prim ... spec ... where llvm { ... } justify verify` compiles and emits
--      `tier: "verified"`, `checker_id: "cinch-kernel-lrat@1"`, `lrat/v1` receipts,
--      and `.cinchif` `prim_proofs` with empty `assumptions.primitives`.
--   2. Swapping `add i32 %0, %0` for `shl i32 %0, 1` preserves the exact `.cinchif`
--      `interface-hash`.
--   3. A broken LLVM body (`add i32 %0, 1`) is refused with a counterexample under
--      both `default` and `lax` modes.
--   4. `#[profile("jpl")]` rejects `justify verify-compiled-lrat` under `default`,
--      admits `justify verify` under `default`, and admits `verify-compiled-lrat`
--      under `lax`.
--   5. An unproved float prim under `lax` downgrades honestly to `tier: "assumed"`
--      with `cinch-lax-bypass@1` and keeps its body hash in `assumptions.primitives`
--      (never forging `.cinchif` `prim_proofs`).
--   6. `off` mode skips provers and records `cinch-verify-off@1` honestly as `assumed`.
module Main where

  import Cinch.Ast (Program)
  import Cinch.Check (CheckedProgram, check-and-retain-with-interfaces-tuned)
  import Cinch.Document (Json, canonical-bytes)
  import Cinch.Export (export-interfaces-aliased, interface-hash, checked-primitive-rows)
  import Cinch.Infer (elaboration-core)
  import Cinch.Parallel (default-tuning, tuning-with-prim-verify, tuning-with-jpl, tuning-with-proof-cache, tuning-with-replay-only, tuning-with-word-size)
  import Cinch.Parse (parse-program)
  import Cinch.PrimVerify (LratAdd, verify-lrat, verify-lrat-text, VerifyOutcome, OutcomeVerified, OutcomeAssumed, OutcomeDisproved, OutcomeRejected, OutcomeOpen, MkPrimParamSpec, verify-prim-body, verify-prim-body-cached, verify-alethe, audit-memory-atomic-contract, audit-memory-atomic-contract-for, validate-llvm-equiv, validate-llvm-memory-equiv, validate-fn-rc-safety, validate-module-rc-safety, receipt-goal-hash, receipt-checker-id, receipt-tier, validate-program-codegen-for-word-bits, render-tv-reports, tv-reports-disproved, tv-report-status, tv-report-details)
  import Cinch.Report (Diagnostic, render-diagnostics)
  import Cinch.Resolve (resolve-program)
  import Cinch.Target (TargetProfile, host-profile, profile-of-triple, profile-with-prim-verify, target-view-program)
  import Data.Bool
  import Data.List
  import Data.Option (Option, None, Some)
  import Data.Result (Result, Ok, Err)
  import Data.String (string-compare, string-concat-all, string-from-bytes, string-to-bytes)
  import Text.Parse (Parsed, Failed)
  import Text.Scan (string-contains)

  same :: String -> String -> Bool
  same a b = string-compare a b == 0

  json-text :: Json -> String
  json-text j = case string-from-bytes (canonical-bytes j) of
    Some s -> s
    None -> ""

  -- Run the full self-hosted frontend: parse -> target-view -> resolve -> check.
  self-check :: String -> String -> Result String (CheckedProgram, Bytes)
  self-check mode src-str =
    let src = string-to-bytes src-str in
    let profile = profile-with-prim-verify mode host-profile in
    let tuning = tuning-with-prim-verify mode default-tuning in
    case parse-program "test.cinch" src of
      Failed b -> Err "parse failed"
      Parsed prog (Cons e rest) -> Err "recoverable parse error"
      Parsed prog Nil -> case target-view-program profile prog of
        Err msg -> Err msg
        Ok view -> case resolve-program view of
          (resolved, Cons e rest) -> Err (render-diagnostics (Cons e rest))
          (resolved, Nil) -> case check-and-retain-with-interfaces-tuned tuning Nil resolved of
            Err errs -> Err (render-diagnostics errs)
            Ok checked -> Ok (checked, src)

  find-main-doc :: List (String, Json) -> Option Json
  find-main-doc rows = case rows of
    Nil -> None
    Cons (mname, doc) rest -> if same mname "Main" then Some doc else find-main-doc rest

  self-iface-and-prims :: String -> String -> Result String (String, String, String)
  self-iface-and-prims mode src-str =
    case self-check mode src-str of
      Err e -> Err e
      Ok (checked, src) ->
        let prims-json = json-text (checked-primitive-rows checked) in
        case export-interfaces-aliased checked Nil src of
          Err e -> Err e
          Ok rows -> case find-main-doc rows of
            Some doc -> Ok (interface-hash doc, json-text doc, prims-json)
            None -> Err "Main module interface not found"

  -- 1. Independent LRAT kernel unit check: valid proof passes, bogus hint fails.
  test-lrat-kernel :: Result String Unit
  test-lrat-kernel =
    let cnf = [(1, [1]), (2, [-1, 2]), (3, [-2])] in
    let good = [LratAdd 4 Nil [1, 2, 3]] in
    let bad = [LratAdd 4 Nil [1, 3]] in
    case (verify-lrat 3 cnf good, verify-lrat 3 cnf bad) of
      (Ok done, Err e) -> Ok ()
      other -> Err "LRAT kernel unit check failed"

  -- 2. Full self-hosted verified prim + body-swap iface_hash invariance.
  ops-prelude :: String
  ops-prelude = "module Ops where\n  export wrapping-add-u32\n  prim wrapping-add-u32 :: U32 -> U32 -> U32 where\n    llvm {\n      %r = add i32 %0, %1\n      ret i32 %r\n    }\n"

  src-twice-add :: String
  src-twice-add = string-concat-all [ops-prelude, "module Main where\n  import Ops\n  spec twice-spec :: U32 -> U32\n  twice-spec x = wrapping-add-u32 x x\n  prim twice :: U32 -> U32 spec twice-spec where\n    llvm {\n      %s = add i32 %0, %0\n      ret i32 %s\n    } justify verify\n  main :: Int\n  main = 0\n"]

  src-twice-shl :: String
  src-twice-shl = string-concat-all [ops-prelude, "module Main where\n  import Ops\n  spec twice-spec :: U32 -> U32\n  twice-spec x = wrapping-add-u32 x x\n  prim twice :: U32 -> U32 spec twice-spec where\n    llvm {\n      %s = shl i32 %0, 1\n      ret i32 %s\n    } justify verify\n  main :: Int\n  main = 0\n"]

  src-twice-broken :: String
  src-twice-broken = string-concat-all [ops-prelude, "module Main where\n  import Ops\n  spec twice-spec :: U32 -> U32\n  twice-spec x = wrapping-add-u32 x x\n  prim twice :: U32 -> U32 spec twice-spec where\n    llvm {\n      %s = add i32 %0, 1\n      ret i32 %s\n    } justify verify\n  main :: Int\n  main = 0\n"]

  src-jpl-compiled :: String
  src-jpl-compiled = "#[profile(\"jpl\")]\nmodule Main where\n  spec id-spec :: U32 -> U32\n  id-spec x = x\n  prim id-u32 :: U32 -> U32 spec id-spec where\n    llvm {\n      ret i32 %0\n    } justify verify-compiled-lrat\n  main :: Int\n  main = 0\n"

  src-jpl-kernel :: String
  src-jpl-kernel = "#[profile(\"jpl\")]\nmodule Main where\n  spec id-spec :: U32 -> U32\n  id-spec x = x\n  prim id-u32 :: U32 -> U32 spec id-spec where\n    llvm {\n      ret i32 %0\n    } justify verify\n  main :: Int\n  main = 0\n"

  src-float-prim :: String
  src-float-prim = "module Main where\n  prim add-f64-local :: F64 -> F64 -> F64 where\n    llvm {\n      %r = fadd double %0, %1\n      ret double %r\n    } justify verify\n  main :: Int\n  main = 0\n"

  test-verified-and-invariance :: Result String Unit
  test-verified-and-invariance =
    case self-iface-and-prims "default" src-twice-add of
      Err e -> Err (string-concat-all ["twice-add failed: ", e])
      Ok (h1, iface1, prims1) ->
        case self-iface-and-prims "default" src-twice-shl of
          Err e -> Err (string-concat-all ["twice-shl failed: ", e])
          Ok (h2, iface2, prims2) ->
            if not (same h1 h2) then Err (string-concat-all ["iface_hash mismatch: ", h1, " vs ", h2, "\n", iface1, "\n", iface2])
            else if not (string-contains "\"tier\":\"verified\"" prims1) then Err (string-concat-all ["missing tier verified: ", prims1])
            else if not (string-contains "\"checker_id\":\"cinch-kernel-lrat@1\"" prims1) then Err (string-concat-all ["missing kernel checker: ", prims1])
            else if not (string-contains "\"evidence_format\":\"lrat/v1\"" prims1) then Err (string-concat-all ["missing lrat/v1: ", prims1])
            else if not (string-contains "\"prim_proofs\":" iface1) then Err (string-concat-all ["missing prim_proofs: ", iface1])
            else if not (string-contains "\"tier\":\"kernel-cert\"" iface1) then Err (string-concat-all ["missing kernel-cert: ", iface1])
            else if not (string-contains "\"primitives\":[]" iface1) then Err (string-concat-all ["non-empty primitives assumptions: ", iface1])
            else Ok ()

  test-broken-refused-default-and-lax :: Result String Unit
  test-broken-refused-default-and-lax =
    case self-check "default" src-twice-broken of
      Ok ok -> Err "broken prim unexpectedly passed in default mode"
      Err msg1 ->
        if not (string-contains "failed formal verification" msg1) then Err (string-concat-all ["wrong default error: ", msg1])
        else case self-check "lax" src-twice-broken of
          Ok ok -> Err "broken prim unexpectedly passed in lax mode"
          Err msg2 ->
            if not (string-contains "failed formal verification" msg2) then Err (string-concat-all ["wrong lax error: ", msg2])
            else Ok ()

  test-jpl-policy :: Result String Unit
  test-jpl-policy =
    case self-check "default" src-jpl-compiled of
      Ok ok -> Err "jpl compiled-lrat unexpectedly passed in default mode"
      Err msg1 ->
        if not (string-contains "rejected by policy" msg1) then Err (string-concat-all ["wrong jpl policy error: ", msg1])
        else case self-check "default" src-jpl-kernel of
          Err msg2 -> Err (string-concat-all ["jpl kernel-lrat failed: ", msg2])
          Ok ok -> case self-iface-and-prims "lax" src-jpl-compiled of
            Err msg3 -> Err (string-concat-all ["jpl compiled-lrat lax failed: ", msg3])
            Ok (h, iface, prims) ->
              if string-contains "\"tier\":\"verified\"" prims && string-contains "\"tier\":\"compiled-cert\"" prims then Ok ()
              else Err (string-concat-all ["unexpected jpl lax prims: ", prims])

  test-lax-float-downgrade :: Result String Unit
  test-lax-float-downgrade =
    case self-check "default" src-float-prim of
      Ok ok -> Err "float prim unexpectedly passed in default mode"
      Err msg1 ->
        if not (string-contains "verification failed" msg1) then Err (string-concat-all ["wrong float default error: ", msg1])
        else case self-iface-and-prims "lax" src-float-prim of
          Err msg2 -> Err (string-concat-all ["float lax failed: ", msg2])
          Ok (h, iface, prims) ->
            if string-contains "\"tier\":\"assumed\"" prims
              && string-contains "cinch-lax-bypass@1" prims
              && not (string-contains "\"prim_proofs\":" iface)
              && string-contains "prim:Main.add-f64-local#" iface then Ok ()
            else Err (string-concat-all ["unexpected float lax output: ", prims, "\n", iface])

  test-off-mode :: Result String Unit
  test-off-mode =
    case self-iface-and-prims "off" src-twice-broken of
      Err msg -> Err (string-concat-all ["off mode failed: ", msg])
      Ok (h, iface, prims) ->
        if string-contains "\"tier\":\"assumed\"" prims
          && string-contains "cinch-verify-off@1" prims
          && not (string-contains "\"prim_proofs\":" iface) then Ok ()
        else Err (string-concat-all ["unexpected off mode output: ", prims, "\n", iface])

  src-u128-index :: String
  src-u128-index = string-concat-all [
    "module Main where\n",
    "  prim raw-div-u128 :: U128 -> refined (r /= 0) U128 -> U128 where\n",
    "    llvm {\n",
    "      %r = udiv i128 %0, %1\n",
    "      ret i128 %r\n",
    "    } justify verify\n",
    "  div-u128 :: using (b /= 0) => U128 -> (b :: U128) -> U128\n",
    "  div-u128 a b = raw-div-u128 a b\n",
    "  safe-div :: U128 -> U128 -> U128\n",
    "  safe-div a b = case decide (b /= 0) of\n",
    "    Yes _ -> div-u128 a b\n",
    "    No _ -> 0\n",
    "  main :: U128\n",
    "  main = safe-div 42 6\n"
  ]

  src-u128-index-bad :: String
  src-u128-index-bad = string-concat-all [
    "module Main where\n",
    "  prim raw-div-u128 :: U128 -> refined (r /= 0) U128 -> U128 where\n",
    "    llvm {\n",
    "      %r = udiv i128 %0, %1\n",
    "      ret i128 %r\n",
    "    } justify verify\n",
    "  div-u128 :: using (b /= 0) => U128 -> (b :: U128) -> U128\n",
    "  div-u128 a b = raw-div-u128 a b\n",
    "  bad :: U128 -> U128 -> U128\n",
    "  bad a b = div-u128 a b\n",
    "  main :: U128\n",
    "  main = bad 42 6\n"
  ]

  test-u128-numeric-index :: Result String Unit
  test-u128-numeric-index =
    case self-iface-and-prims "default" src-u128-index of
      Err msg -> Err (string-concat-all ["U128 numeric index + 128-bit prim verify failed: ", msg])
      Ok (h, iface, prims) ->
        if not (string-contains "\"tier\":\"kernel-cert\"" prims && string-contains "\"prim_proofs\":" iface) then
          Err (string-concat-all ["U128 prim missing kernel-cert receipt: ", prims])
        else case self-check "default" src-u128-index-bad of
          Ok ok -> Err "unguarded U128 divisor unexpectedly passed"
          Err msg2 -> Ok ()

  -- 8. Signed I128 division with I128::MIN dependent refinement.
  src-i128-sdiv :: String
  src-i128-sdiv = string-concat-all [
    "module Main where\n",
    "  prim raw-sdiv-i128 :: (a :: I128) -> refined (r /= 0 && Not (a == -170141183460469231731687303715884105728 && r == -1)) I128 -> I128 where\n",
    "    llvm {\n",
    "      %r = sdiv i128 %0, %1\n",
    "      ret i128 %r\n",
    "    } justify verify\n",
    "  main :: Int\n",
    "  main = 0\n"
  ]

  test-i128-sdiv :: Result String Unit
  test-i128-sdiv =
    case self-iface-and-prims "default" src-i128-sdiv of
      Err msg -> Err (string-concat-all ["I128 sdiv verify failed: ", msg])
      Ok (h, iface, prims) ->
        if string-contains "\"tier\":\"kernel-cert\"" prims && string-contains "\"prim_proofs\":" iface then Ok ()
        else Err (string-concat-all ["I128 sdiv missing kernel-cert: ", prims])

  -- 9. SIMD vector primitives (<16 x i8>, insertelement, shufflevector, bitcast, icmp, sext).
  src-simd :: String
  src-simd = string-concat-all [
    "module Main where\n",
    "  prim simd-splat :: U8 -> U128 where\n",
    "    llvm {\n",
    "      %v0 = insertelement <16 x i8> poison, i8 %0, i64 0\n",
    "      %v = shufflevector <16 x i8> %v0, <16 x i8> poison, <16 x i32> zeroinitializer\n",
    "      %r = bitcast <16 x i8> %v to i128\n",
    "      ret i128 %r\n",
    "    } justify verify\n",
    "  prim simd-movemask :: U128 -> U32 where\n",
    "    llvm {\n",
    "      %v = bitcast i128 %0 to <16 x i8>\n",
    "      %m = icmp slt <16 x i8> %v, zeroinitializer\n",
    "      %b16 = bitcast <16 x i1> %m to i16\n",
    "      %r = zext i16 %b16 to i32\n",
    "      ret i32 %r\n",
    "    } justify verify\n",
    "  main :: Int\n",
    "  main = 0\n"
  ]

  test-simd :: Result String Unit
  test-simd =
    case self-iface-and-prims "default" src-simd of
      Err msg -> Err (string-concat-all ["SIMD prim verify failed: ", msg])
      Ok (h, iface, prims) ->
        if string-contains "\"tier\":\"kernel-cert\"" prims then Ok ()
        else Err (string-concat-all ["SIMD prim missing kernel-cert: ", prims])

  -- 10. Acyclic multi-block CFG (br i1, br label, phi) + cycle rejection.
  src-cfg-good :: String
  src-cfg-good = string-concat-all [
    "module Main where\n",
    "  prim safe-div-cfg :: U32 -> U32 -> U32 where\n",
    "    llvm {\n",
    "    entry:\n",
    "      %z = icmp eq i32 %1, 0\n",
    "      br i1 %z, label %zero, label %nonzero\n",
    "    zero:\n",
    "      br label %done\n",
    "    nonzero:\n",
    "      %q = udiv i32 %0, %1\n",
    "      br label %done\n",
    "    done:\n",
    "      %r = phi i32 [ 0, %zero ], [ %q, %nonzero ]\n",
    "      ret i32 %r\n",
    "    } justify verify\n",
    "  main :: Int\n",
    "  main = 0\n"
  ]

  src-cfg-cycle :: String
  src-cfg-cycle = string-concat-all [
    "module Main where\n",
    "  prim bad-loop :: U32 -> U32 where\n",
    "    llvm {\n",
    "    loop:\n",
    "      br label %loop\n",
    "      ret i32 %0\n",
    "    } justify verify\n",
    "  main :: Int\n",
    "  main = 0\n"
  ]

  test-acyclic-cfg :: Result String Unit
  test-acyclic-cfg =
    case self-iface-and-prims "default" src-cfg-good of
      Err msg -> Err (string-concat-all ["acyclic CFG failed: ", msg])
      Ok (h, iface, prims) ->
        if not (string-contains "\"tier\":\"kernel-cert\"" prims) then Err "acyclic CFG missing kernel-cert"
        else case self-check "default" src-cfg-cycle of
          Ok ok -> Err "cyclic CFG unexpectedly passed"
          Err msg2 -> Ok ()

  -- 11. Cross-target equivalence across multi-body llvm prims.
  src-cross-good :: String
  src-cross-good = string-concat-all [
    "module Main where\n",
    "  prim dbl :: U32 -> U32 where\n",
    "    llvm {\n",
    "      %r = shl i32 %0, 1\n",
    "      ret i32 %r\n",
    "    } when arch x86_64 justify verify\n",
    "    llvm {\n",
    "      %r = add i32 %0, %0\n",
    "      ret i32 %r\n",
    "    } justify verify\n",
    "  main :: Int\n",
    "  main = 0\n"
  ]

  src-cross-bad :: String
  src-cross-bad = string-concat-all [
    "module Main where\n",
    "  prim dbl :: U32 -> U32 where\n",
    "    llvm {\n",
    "      %r = add i32 %0, 1\n",
    "      ret i32 %r\n",
    "    } when arch x86_64 justify verify\n",
    "    llvm {\n",
    "      %r = add i32 %0, %0\n",
    "      ret i32 %r\n",
    "    } justify verify\n",
    "  main :: Int\n",
    "  main = 0\n"
  ]

  test-cross-target :: Result String Unit
  test-cross-target =
    case self-check "default" src-cross-good of
      Err msg -> Err (string-concat-all ["cross-target good failed: ", msg])
      Ok ok -> case self-check "default" src-cross-bad of
        Ok ok2 -> Err "divergent cross-target prim unexpectedly passed"
        Err msg2 ->
          if string-contains "cross-target equivalence" msg2 then Ok ()
          else Err (string-concat-all ["wrong cross-target error: ", msg2])

  -- 12. Alethe proof checker seam + cached Alethe replay for FP arithmetic under strict/JPL replay-only mode.
  test-alethe :: Result String Unit
  test-alethe =
    let good = "(assume h1 p)\n(assume h2 (not p))\n(step t1 (cl) :rule resolution :premises (h1 h2))\n" in
    let bad-hole = "(assume h1 p)\n(step t1 (cl) :rule hole :premises (h1))\n" in
    let bad-trust = "(assume h1 p)\n(step t1 (cl) :rule trust :premises (h1))\n" in
    let bad-prem = "(step t1 (cl) :rule resolution :premises (missing))\n" in
    case (verify-alethe good, verify-alethe bad-hole, verify-alethe bad-trust, verify-alethe bad-prem) of
      (Ok ok-msg, Err e1, Err e2, Err e3) ->
        -- Replay cached Alethe certificate on `fadd double` in strict replay-only mode!
        let fp-p0 = MkPrimParamSpec "a" "F64" 64 False True False in
        let fp-p1 = MkPrimParamSpec "b" "F64" 64 False True False in
        let fp-frag = "%r = fadd double %0, %1\nret double %r\n" in
        case verify-prim-body "add-f64" False "lax" "verify" fp-frag [fp-p0, fp-p1] fp-p0 Nil None None Nil "well-defined" False of
          OutcomeAssumed (Cons r1 (Cons r2 Nil)) ->
            let good-entry = string-concat "ALETHE_V1\n" good in
            let bad-entry = string-concat "ALETHE_V1\n" bad-hole in
            let cache-ok = [(receipt-goal-hash r1, good-entry), (receipt-goal-hash r2, good-entry)] in
            let cache-bad = [(receipt-goal-hash r1, bad-entry), (receipt-goal-hash r2, good-entry)] in
            (case (verify-prim-body-cached "add-f64" True "strict" "verify" cache-ok True fp-frag [fp-p0, fp-p1] fp-p0 Nil Nil None None Nil "well-defined" False,
                   verify-prim-body-cached "add-f64" True "strict" "verify" cache-bad True fp-frag [fp-p0, fp-p1] fp-p0 Nil Nil None None Nil "well-defined" False) of
              (OutcomeVerified (Cons vr _), OutcomeOpen err-msg) ->
                if same (receipt-checker-id vr) "cinch-alethe-checker@1"
                  && same (receipt-tier vr) "kernel-cert"
                  && string-contains "REJECTED" err-msg then Ok ()
                else Err "cached Alethe replay receipt/rejection mismatch"
              other -> Err "cached Alethe replay on FP arithmetic failed")
          other -> Err "failed collecting FP goal hashes for Alethe cache test"
      other -> Err "Alethe checker test failed"

  -- 13. Verified `rewrite ... justify verify`.
  src-rewrite-good :: String
  src-rewrite-good = string-concat-all [
    ops-prelude,
    "module Main where\n",
    "  import Ops\n",
    "  prim bit-xor-u32 :: U32 -> U32 -> U32 where\n",
    "    llvm {\n",
    "      %r = xor i32 %0, %1\n",
    "      ret i32 %r\n",
    "    }\n",
    "  rewrite xor-cancel forall (x :: U32) (y :: U32). where\n",
    "    match (bit-xor-u32 (bit-xor-u32 x y) y)\n",
    "    replace x\n",
    "    justify verify\n",
    "  main :: Int\n",
    "  main = 0\n"
  ]

  src-rewrite-bad :: String
  src-rewrite-bad = string-concat-all [
    ops-prelude,
    "module Main where\n",
    "  import Ops\n",
    "  rewrite bogus forall (x :: U32). where\n",
    "    match (wrapping-add-u32 x x)\n",
    "    replace (wrapping-add-u32 x 1)\n",
    "    justify verify\n",
    "  main :: Int\n",
    "  main = 0\n"
  ]

  test-verified-rewrite :: Result String Unit
  test-verified-rewrite =
    case self-check "default" src-rewrite-good of
      Err msg -> Err (string-concat-all ["good verified rewrite failed: ", msg])
      Ok ok -> case self-check "default" src-rewrite-bad of
        Ok ok2 -> Err "bogus verified rewrite unexpectedly passed"
        Err msg2 ->
          if string-contains "failed formal verification" msg2 then Ok ()
          else Err (string-concat-all ["wrong bogus rewrite error: ", msg2])

  -- 14. Replay-only mode fails closed when cache is missing.
  test-replay-only :: Result String Unit
  test-replay-only =
    let src = string-to-bytes src-twice-add in
    let tuning = tuning-with-replay-only True default-tuning in
    case parse-program "test.cinch" src of
      Parsed prog Nil -> case target-view-program host-profile prog of
        Ok view -> case resolve-program view of
          (resolved, Nil) -> case check-and-retain-with-interfaces-tuned tuning Nil resolved of
            Ok ok -> Err "replay-only unexpectedly succeeded with empty cache"
            Err errs ->
              if string-contains "replay-only" (render-diagnostics errs) then Ok ()
              else Err (string-concat-all ["wrong replay-only error: ", render-diagnostics errs])
          other -> Err "resolve failed in replay-only test"
        Err e -> Err e
      other -> Err "parse failed in replay-only test"

  -- 15. Memory & Atomic Boundary Contract auditor.
  test-boundary-audit :: Result String Unit
  test-boundary-audit =
    let good-frag = "%p = inttoptr i64 %0 to ptr\n%v = load atomic i64, ptr %p acquire, align 8\nret i64 %v\n" in
    let bad-frag = "%p = inttoptr i64 %0 to ptr\n%v = load atomic i64, ptr %p release, align 4\nret i64 %v\n" in
    case (audit-memory-atomic-contract "good" False good-frag, audit-memory-atomic-contract "bad" False bad-frag) of
      (Nil, Cons v1 rest) -> Ok ()
      other -> Err "memory/atomic boundary audit test failed"

  -- 16. LLVM Translation Validation (`validate-llvm-equiv`).
  test-tv :: Result String Unit
  test-tv =
    let p0 = MkPrimParamSpec "x" "U32" 32 False False False in
    let r = MkPrimParamSpec "r" "U32" 32 False False False in
    let fa = "%r = add i32 %0, %0\nret i32 %r\n" in
    let fb = "%r = shl i32 %0, 1\nret i32 %r\n" in
    let fc = "%r = add i32 %0, 1\nret i32 %r\n" in
    case (validate-llvm-equiv "dbl" fa fb [p0] r, validate-llvm-equiv "bad" fa fc [p0] r) of
      (OutcomeVerified rs, OutcomeDisproved d) -> Ok ()
      other -> Err "LLVM translation validation test failed"

  -- 17. Target-arch pointer/word-size parameterization (32-bit wasm32 vs 64-bit host).
  self-check-profile :: TargetProfile -> String -> String -> Result String (CheckedProgram, Bytes)
  self-check-profile base-profile mode src-str =
    let src = string-to-bytes src-str in
    let profile = profile-with-prim-verify mode base-profile in
    let tuning = tuning-with-word-size (profile.word-size) (tuning-with-prim-verify mode default-tuning) in
    case parse-program "test.cinch" src of
      Failed b -> Err "parse failed"
      Parsed prog (Cons e rest) -> Err "recoverable parse error"
      Parsed prog Nil -> case target-view-program profile prog of
        Err msg -> Err msg
        Ok view -> case resolve-program view of
          (resolved, Cons e rest) -> Err (render-diagnostics (Cons e rest))
          (resolved, Nil) -> case check-and-retain-with-interfaces-tuned tuning Nil resolved of
            Err errs -> Err (render-diagnostics errs)
            Ok checked -> Ok (checked, src)

  src-wasm32-ptrs :: String
  src-wasm32-ptrs = string-concat-all [
    "module Main where\n",
    "  foreign import ccall \"c_touch\" c-touch :: forall r . RawPtr U8 -> Usize ->{IO r} Usize\n",
    "  prim bit-xor-usize :: Usize -> Usize -> Usize where\n",
    "    llvm {\n",
    "      %r = xor i32 %0, %1\n",
    "      ret i32 %r\n",
    "    } justify verify\n",
    "  rewrite usize-xor-cancel forall (x :: Usize) (y :: Usize). where\n",
    "    match (bit-xor-usize (bit-xor-usize x y) y)\n",
    "    replace x\n",
    "    justify verify\n",
    "  main :: Int\n",
    "  main = 0\n"
  ]

  src-host64-foreign :: String
  src-host64-foreign = string-concat-all [
    "module Main where\n",
    "  foreign import ccall \"c_touch\" c-touch :: forall r . RawPtr U8 -> Usize ->{IO r} Usize\n",
    "  main :: Int\n",
    "  main = 0\n"
  ]

  test-target-pointer-word-size :: Result String Unit
  test-target-pointer-word-size =
    let ptr-load-four = "%p = inttoptr i32 %0 to ptr\n%v = load atomic ptr, ptr %p acquire, align 4\nret i32 0\n" in
    case (audit-memory-atomic-contract-for 32 "ptr32" False ptr-load-four, audit-memory-atomic-contract-for 64 "ptr64" False ptr-load-four) of
      (Nil, Cons v64 rest) ->
        (case profile-of-triple "wasm32-unknown-unknown" of
          Err emsg -> Err (string-concat-all ["wasm32-unknown-unknown target profile missing: ", emsg])
          Ok wasm-prof ->
            case self-check-profile wasm-prof "default" src-wasm32-ptrs of
              Err msg -> Err (string-concat-all ["wasm32 pointer/Usize check failed: ", msg])
              Ok (checked32, src32) ->
                case export-interfaces-aliased checked32 Nil src32 of
                  Err msg -> Err msg
                  Ok rows32 -> case find-main-doc rows32 of
                    None -> Err "Main module interface not found (wasm32)"
                    Some doc32 ->
                      let txt32 = json-text doc32 in
                      if not (string-contains "\"align\":4" txt32 && string-contains "\"width\":4" txt32) then
                        Err (string-concat-all ["wasm32 foreign ABI did not record 4-byte ptr/Usize: ", txt32])
                      else if string-contains "\"width\":8" txt32 then
                        Err (string-concat-all ["wasm32 foreign ABI leaked 8-byte width: ", txt32])
                      else
                        -- Same 32-bit `i32` Usize prim MUST fail on 64-bit host!
                        (case self-check-profile host-profile "default" src-wasm32-ptrs of
                          Ok ok -> Err "32-bit i32 Usize prim unexpectedly passed on 64-bit host"
                          Err expected-err ->
                            (case self-check-profile host-profile "default" src-host64-foreign of
                              Err msg64 -> Err (string-concat-all ["64-bit foreign check failed: ", msg64])
                              Ok (checked64, src64) ->
                                case export-interfaces-aliased checked64 Nil src64 of
                                  Err msg -> Err msg
                                  Ok rows64 -> case find-main-doc rows64 of
                                    None -> Err "Main module interface not found (host64)"
                                    Some doc64 ->
                                      let txt64 = json-text doc64 in
                                      if string-contains "\"align\":8" txt64 && string-contains "\"width\":8" txt64 then Ok ()
                                      else Err (string-concat-all ["64-bit foreign ABI did not record 8-byte ptr/Usize: ", txt64]))))
      other -> Err "32-bit vs 64-bit ptr atomic alignment audit failed"

  -- 18. Self-hosted #[repr(C)], #[repr(packed)], #[repr(align(16))] struct layouts on 32-bit vs 64-bit targets.
  test-repr-c-layouts :: Result String Unit
  test-repr-c-layouts =
    let src-layouts = string-concat-all [
          "module Main where\n",
          "  #[repr(C)]\n",
          "  record Mixed where\n",
          "    tag :: U8\n",
          "    ptr-idx :: Usize\n",
          "    count :: U32\n",
          "    delta :: Isize\n",
          "  #[repr(packed)]\n",
          "  record Tight where\n",
          "    a :: U8\n",
          "    b :: Usize\n",
          "  #[repr(C, align(16))]\n",
          "  record Aligned where\n",
          "    x :: U32\n",
          "  main :: Int\n",
          "  main = 0\n"
        ] in
    case profile-of-triple "wasm32-unknown-unknown" of
      Err msg -> Err msg
      Ok wasm-prof ->
        case self-check-profile wasm-prof "default" src-layouts of
          Err msg32 -> Err (string-concat-all ["wasm32 repr(C) check failed: ", msg32])
          Ok (checked32, src32) ->
            case export-interfaces-aliased checked32 Nil src32 of
              Err msg -> Err msg
              Ok rows32 -> case find-main-doc rows32 of
                None -> Err "Main module interface not found (repr(C) wasm32)"
                Some doc32 ->
                  let txt32 = json-text doc32 in
                  -- On 32-bit wasm32: Mixed = {size:16, align:4, tag@0, ptr-idx@4, count@8, delta@12}; Tight = {size:5, align:1}; Aligned = {size:16, align:16}.
                  if not (string-contains "\"repr\":\"C\",\"size\":16" txt32 && string-contains "\"align\":4" txt32
                       && string-contains "\"name\":\"ptr-idx\",\"offset\":4,\"size\":4" txt32
                       && string-contains "\"repr\":\"packed\",\"size\":5" txt32
                       && string-contains "\"repr\":\"C, align(16)\",\"size\":16" txt32) then
                    Err (string-concat-all ["wasm32 repr(C) layout mismatch: ", txt32])
                  else
                    (case self-check-profile host-profile "default" src-layouts of
                      Err msg64 -> Err (string-concat-all ["host64 repr(C) check failed: ", msg64])
                      Ok (checked64, src64) ->
                        case export-interfaces-aliased checked64 Nil src64 of
                          Err msg -> Err msg
                          Ok rows64 -> case find-main-doc rows64 of
                            None -> Err "Main module interface not found (repr(C) host64)"
                            Some doc64 ->
                              let txt64 = json-text doc64 in
                              -- On 64-bit host: Mixed = {size:32, align:8, tag@0, ptr-idx@8, count@16, delta@24}; Tight = {size:9, align:1}; Aligned = {size:16, align:16}.
                              if string-contains "\"repr\":\"C\",\"size\":32" txt64 && string-contains "\"align\":8" txt64
                                && string-contains "\"name\":\"ptr-idx\",\"offset\":8,\"size\":8" txt64
                                && string-contains "\"repr\":\"packed\",\"size\":9" txt64
                                && string-contains "\"repr\":\"C, align(16)\",\"size\":16" txt64 then Ok ()
                              else Err (string-concat-all ["host64 repr(C) layout mismatch: ", txt64]))

  -- 19. Self-hosted Core -> LLVM translation validation (`verify-codegen` engine) + tamper detection.
  test-verify-codegen-tv :: Result String Unit
  test-verify-codegen-tv =
    let src-tv = string-concat-all [
          "module Main where\n",
          "  prim wrapping-add-u32 :: U32 -> U32 -> U32 where\n",
          "    llvm {\n",
          "      %r = add i32 %0, %1\n",
          "      ret i32 %r\n",
          "    } justify verify\n",
          "  prim bit-xor-u32 :: U32 -> U32 -> U32 where\n",
          "    llvm {\n",
          "      %r = xor i32 %0, %1\n",
          "      ret i32 %r\n",
          "    } justify verify\n",
          "  dbl :: U32 -> U32\n",
          "  dbl x = wrapping-add-u32 x x\n",
          "  mix :: U32 -> U32 -> U32\n",
          "  mix x y = bit-xor-u32 (bit-xor-u32 x y) y\n",
          "  main :: Int\n",
          "  main = 0\n"
        ] in
    let good-ir = string-concat-all [
          "define i64 @\"cinch.typed.m.Main.dbl\"(i64 %arg0) {\n",
          "entry:\n",
          "  %v1 = call i64 @\"\\4D\\61\\69\\6E\\2E\\77\\72\\61\\70\\70\\69\\6E\\67\\2D\\61\\64\\64\\2D\\75\\33\\32\"(i64 %arg0, i64 %arg0)\n",
          "  ret i64 %v1\n",
          "nexteq0:\n",
          "  unreachable\n",
          "}\n",
          "define i64 @\"cinch.typed.m.Main.mix\"(i64 %arg0, i64 %arg1) {\n",
          "entry:\n",
          "  %a = trunc i64 %arg0 to i32\n",
          "  %r = zext i32 %a to i64\n",
          "  ret i64 %r\n",
          "}\n"
        ] in
    let bad-ir = string-concat-all [
          "define i64 @\"cinch.typed.m.Main.dbl\"(i64 %arg0) {\n",
          "entry:\n",
          "  %a = trunc i64 %arg0 to i32\n",
          "  %b = add i32 %a, 1\n",
          "  %r = zext i32 %b to i64\n",
          "  ret i64 %r\n",
          "}\n"
        ] in
    case self-check-profile host-profile "default" src-tv of
      Err msg -> Err (string-concat-all ["verify-codegen TV check failed: ", msg])
      Ok (checked, raw) ->
        let defs = elaboration-core (checked.elaboration) in
        let rep-ok = validate-program-codegen-for-word-bits 64 "Main." defs good-ir in
        let txt-ok = render-tv-reports rep-ok in
        if not (string-contains "[VERIFIED] Main.dbl" txt-ok && string-contains "[VERIFIED] Main.mix" txt-ok && tv-reports-disproved rep-ok == 0) then
          Err (string-concat-all ["expected Main.dbl & Main.mix VERIFIED, got:\n", txt-ok])
        else
          let rep-bad = validate-program-codegen-for-word-bits 64 "Main." defs bad-ir in
          let txt-bad = render-tv-reports rep-bad in
          if string-contains "[DISPROVED] Main.dbl" txt-bad && tv-reports-disproved rep-bad > 0 then Ok ()
          else Err (string-concat-all ["expected tampered Main.dbl DISPROVED, got:\n", txt-bad])

  -- 20. Float refinements (NotNaN, Finite, float InRange), Finite => NotNaN, and LRAT-verified IEEE-754 prims.
  test-float-refinements-and-ieee754 :: Result String Unit
  test-float-refinements-and-ieee754 =
    let src-ok = string-concat-all [
          "module Main where\n",
          "  type InRange (lo :: Int) (hi :: Int) a = refine (x :: a) with lo <= x && x <= hi\n",
          "  prim abs-finite-f64 :: (x :: refined (Finite x) F64) -> refined (Finite r) F64 where\n",
          "    llvm {\n",
          "      %r = call double @llvm.fabs.f64(double %0)\n",
          "      ret double %r\n",
          "    } justify verify\n",
          "  prim neg-not-nan-f32 :: (x :: refined (NotNaN x) F32) -> refined (NotNaN r) F32 where\n",
          "    llvm {\n",
          "      %r = fneg float %0\n",
          "      ret float %r\n",
          "    } justify verify\n",
          "  prim abs-range-f64 :: (x :: refined (InRange (-10) 10 x) F64) -> refined (InRange 0 10 r) F64 where\n",
          "    llvm {\n",
          "      %r = call double @llvm.fabs.f64(double %0)\n",
          "      ret double %r\n",
          "    } justify verify\n",
          "  use-not-nan :: using (NotNaN x) => (x :: F64) -> F64\n",
          "  use-not-nan x = x\n",
          "  finite-to-not-nan :: using (Finite x) => (x :: F64) -> F64\n",
          "  finite-to-not-nan x = use-not-nan x\n",
          "  check-dec :: F64 -> Int\n",
          "  check-dec x = case decide (Finite x) of\n",
          "    Yes _ -> let _ = finite-to-not-nan x in 0\n",
          "    No _ -> case decide (NotNaN x) of Yes _ -> 1; No _ -> 2\n",
          "  main :: Int\n",
          "  main = 0\n"
        ] in
    let src-bad = string-concat-all [
          "module Main where\n",
          "  prim bogus-neg :: F32 -> refined (NotNaN r) F32 where\n",
          "    llvm {\n",
          "      %r = fneg float %0\n",
          "      ret float %r\n",
          "    } justify verify\n",
          "  main :: Int\n",
          "  main = 0\n"
        ] in
    case self-check-profile host-profile "default" src-ok of
      Err msg -> Err (string-concat-all ["float refinements + IEEE-754 LRAT check failed: ", msg])
      Ok (checked, raw) ->
        case self-check-profile host-profile "default" src-bad of
          Ok _ -> Err "bogus float NotNaN postcondition must be disproved"
          Err msg ->
            if string-contains "failed formal verification" msg then Ok ()
            else Err (string-concat-all ["expected formal verification counterexample for bogus float prim, got: ", msg])

  -- 21. AIG structural hashing + balanced adder-tree ctpop + 1-UIP CDCL bitvector identities.
  src-aig-cdcl :: String
  src-aig-cdcl = string-concat-all [
    "module Main where\n",
    "  spec cancel-spec :: U32 -> U32 -> U32\n",
    "  cancel-spec x y = x\n",
    "  prim add-sub-cancel-u32 :: U32 -> U32 -> U32 spec cancel-spec where\n",
    "    llvm {\n",
    "      %s = add i32 %0, %1\n",
    "      %r = sub i32 %s, %1\n",
    "      ret i32 %r\n",
    "    } justify verify\n",
    "  prim ctpop-bound-u32 :: U32 -> refined (r <= 32) U32 where\n",
    "    llvm {\n",
    "      %r = call i32 @llvm.ctpop.i32(i32 %0)\n",
    "      ret i32 %r\n",
    "    } justify verify\n",
    "  prim add-double-sub-u16 :: U16 -> U16 -> U16 spec cancel-u16-spec where\n",
    "    llvm {\n",
    "      %a = add i16 %0, %1\n",
    "      %b = add i16 %a, %1\n",
    "      %c = shl i16 %1, 1\n",
    "      %r = sub i16 %b, %c\n",
    "      ret i16 %r\n",
    "    } justify verify\n",
    "  spec cancel-u16-spec :: U16 -> U16 -> U16\n",
    "  cancel-u16-spec x y = x\n",
    "  main :: Int\n",
    "  main = 0\n"
  ]

  test-aig-cdcl-identities :: Result String Unit
  test-aig-cdcl-identities =
    case self-iface-and-prims "default" src-aig-cdcl of
      Err msg -> Err (string-concat-all ["AIG/1-UIP CDCL bitvector identities failed: ", msg])
      Ok (h, iface, prims) ->
        if string-contains "\"tier\":\"kernel-cert\"" prims && string-contains "\"prim_proofs\":" iface then Ok ()
        else Err (string-concat-all ["AIG/1-UIP CDCL identities missing kernel-cert/prim_proofs: ", prims, "\n", iface])
  -- 22. Extended verify-codegen: #[repr(C)] struct + FixedArray memory TV, OOB rejection, and Perceus RC safety.
  test-extended-tv-and-rc :: Result String Unit
  test-extended-tv-and-rc =
    let p0 = MkPrimParamSpec "a" "U64" 64 False False False in
    let p1 = MkPrimParamSpec "b" "U64" 64 False False False in
    let struct-ir = "%s = alloca { i64, i64 }, align 8\n%f0 = getelementptr inbounds { i64, i64 }, ptr %s, i64 0, i32 0\nstore i64 %0, ptr %f0, align 8\n%f1 = getelementptr inbounds { i64, i64 }, ptr %s, i64 0, i32 1\nstore i64 %1, ptr %f1, align 8\n%a = load i64, ptr %f0, align 8\n%b = load i64, ptr %f1, align 8\n%sum = add i64 %a, %b\nret i64 %sum\n" in
    let array-ir = "%arr = alloca [2 x i64], align 8\n%e0 = getelementptr inbounds [2 x i64], ptr %arr, i64 0, i64 0\nstore i64 %0, ptr %e0, align 8\n%e1 = getelementptr inbounds [2 x i64], ptr %arr, i64 0, i64 1\nstore i64 %1, ptr %e1, align 8\n%x = load i64, ptr %e1, align 8\n%y = load i64, ptr %e0, align 8\n%sum = add i64 %x, %y\nret i64 %sum\n" in
    let oob-ir = "%arr = alloca [2 x i64], align 8\n%bad = getelementptr inbounds [2 x i64], ptr %arr, i64 0, i64 2\nstore i64 %0, ptr %bad, align 8\nret i64 %0\n" in
    let rc-good = "define i64 @\"Main.good-rc\"(i64 %p0) {\nentry:\n  call void @cinch.rc.dup.obj(i64 %p0)\n  call void @cinch.rc.drop.obj(i64 %p0)\n  ret i64 %p0\n}\n" in
    let rc-df = "define i64 @\"Main.bad-df\"(i64 %p0) {\nentry:\n  call void @cinch.rc.drop.obj(i64 %p0)\n  call void @cinch.rc.drop.obj(i64 %p0)\n  ret i64 0\n}\n" in
    let rc-uaf = "define i64 @\"Main.bad-uaf\"(i64 %p0) {\nentry:\n  call void @cinch.rc.drop.obj(i64 %p0)\n  %x = call i64 @\"Main.use\"(i64 %p0)\n  ret i64 %x\n}\n" in
    let rc-leak = "define i64 @\"Main.bad-leak\"(i64 %p0) {\nentry:\n  call void @cinch.rc.dup.obj(i64 %p0)\n  call void @cinch.rc.drop.obj(i64 %p0)\n  ret i64 0\n}\n" in
    let src-loop = string-concat-all [
          "module Main where\n",
          "  prim wrapping-add-u64 :: U64 -> U64 -> U64 where\n",
          "    llvm {\n      %r = add i64 %0, %1\n      ret i64 %r\n    } justify verify\n",
          "  prim wrapping-sub-u64 :: U64 -> U64 -> U64 where\n",
          "    llvm {\n      %r = sub i64 %0, %1\n      ret i64 %r\n    } justify verify\n",
          "  helper :: U64 -> U64\n",
          "  helper x = wrapping-add-u64 x 1\n",
          "  caller :: U64 -> U64\n",
          "  caller x = wrapping-add-u64 (helper x) (helper x)\n",
          "  sumdown :: U64 -> U64 -> U64\n",
          "  sumdown n acc = if n == 0 then acc else sumdown (wrapping-sub-u64 n 1) (wrapping-add-u64 acc n)\n",
          "  main :: Int\n",
          "  main = 0\n"
        ] in
    let loop-ir-ok = string-concat-all [
          "define i64 @\"cinch.typed.m.Main.helper\"(i64 %p0) {\nentry:\n  %r = add i64 %p0, 1\n  ret i64 %r\n}\n",
          "define i64 @\"cinch.typed.m.Main.caller\"(i64 %p0) {\nentry:\n  %a = call i64 @\"cinch.typed.m.Main.helper\"(i64 %p0)\n  %b = call i64 @\"cinch.typed.m.Main.helper\"(i64 %p0)\n  %r = add i64 %a, %b\n  ret i64 %r\n}\n",
          "define i64 @\"cinch.typed.m.Main.sumdown\"(i64 %p0, i64 %p1) {\nentry:\n  %sn = alloca i64, align 8\n  store i64 %p0, ptr %sn, align 8\n  %sa = alloca i64, align 8\n  store i64 %p1, ptr %sa, align 8\n  br label %tail.h\ntail.h:\n  %n = load i64, ptr %sn, align 8\n  %a = load i64, ptr %sa, align 8\n  %z = icmp eq i64 %n, 0\n  br i1 %z, label %done, label %step\ndone:\n  ret i64 %a\nstep:\n  %n1 = sub i64 %n, 1\n  %a1 = add i64 %a, %n\n  store i64 %n1, ptr %sn, align 8\n  store i64 %a1, ptr %sa, align 8\n  br label %tail.h\n}\n"
        ] in
    let loop-ir-bad = string-concat-all [
          "define i64 @\"cinch.typed.m.Main.sumdown\"(i64 %p0, i64 %p1) {\nentry:\n  %sn = alloca i64, align 8\n  store i64 %p0, ptr %sn, align 8\n  %sa = alloca i64, align 8\n  store i64 %p1, ptr %sa, align 8\n  br label %tail.h\ntail.h:\n  %n = load i64, ptr %sn, align 8\n  %a = load i64, ptr %sa, align 8\n  %z = icmp eq i64 %n, 0\n  br i1 %z, label %done, label %step\ndone:\n  ret i64 %a\nstep:\n  %n1 = sub i64 %n, 2\n  %a1 = add i64 %a, %n\n  store i64 %n1, ptr %sn, align 8\n  store i64 %a1, ptr %sa, align 8\n  br label %tail.h\n}\n"
        ] in
    case (validate-llvm-memory-equiv "struct_vs_array" struct-ir array-ir [p0, p1] p0, validate-llvm-memory-equiv "oob" struct-ir oob-ir [p0, p1] p0) of
      (OutcomeVerified _, OutcomeDisproved oob-msg) ->
        if not (string-contains "out-of-bounds" oob-msg) then Err (string-concat "wrong OOB message: " oob-msg)
        else case (validate-fn-rc-safety "Main.good-rc" rc-good, validate-fn-rc-safety "Main.bad-df" rc-df, validate-fn-rc-safety "Main.bad-uaf" rc-uaf, validate-fn-rc-safety "Main.bad-leak" rc-leak) of
          (Some r-ok, Some r-df, Some r-uaf, Some r-lk) ->
            if not (same (tv-report-status r-ok) "verified"
              && same (tv-report-status r-df) "disproved"
              && same (tv-report-status r-uaf) "disproved"
              && same (tv-report-status r-lk) "disproved")
              then Err "RC safety statuses mismatched"
            else case self-check-profile host-profile "default" src-loop of
              Err e -> Err (string-concat "extended TV source failed: " e)
              Ok (checked, _) ->
                let defs = elaboration-core (checked.elaboration) in
                let reps-ok = validate-program-codegen-for-word-bits 64 "Main." defs loop-ir-ok in
                let txt-ok = render-tv-reports reps-ok in
                let reps-bad = validate-program-codegen-for-word-bits 64 "Main." defs loop-ir-bad in
                if tv-reports-disproved reps-ok > 0 then Err (string-concat "extended TV unexpectedly disproved: " txt-ok)
                else if not (string-contains "[VERIFIED] Main.caller" txt-ok) then Err (string-concat "interproc caller not verified: " txt-ok)
                else if not (string-contains "[VERIFIED] Main.sumdown" txt-ok) then Err (string-concat "tail-loop sumdown not verified: " txt-ok)
                else if tv-reports-disproved reps-bad == 0 then Err "tampered tail-loop was not disproved"
                else Ok ()
          other -> Err "RC safety returned None unexpectedly"
      other -> Err "aggregate/FixedArray memory TV check failed"

  run-all :: Result String Unit
  run-all =
    case test-lrat-kernel of
      Err e -> Err e
      Ok u1 -> case test-verified-and-invariance of
        Err e -> Err e
        Ok u2 -> case test-broken-refused-default-and-lax of
          Err e -> Err e
          Ok u3 -> case test-jpl-policy of
            Err e -> Err e
            Ok u4 -> case test-lax-float-downgrade of
              Err e -> Err e
              Ok u5 -> case test-off-mode of
                Err e -> Err e
                Ok u6 -> case test-u128-numeric-index of
                  Err e -> Err e
                  Ok u7 -> case test-i128-sdiv of
                    Err e -> Err e
                    Ok u8 -> case test-simd of
                      Err e -> Err e
                      Ok u9 -> case test-acyclic-cfg of
                        Err e -> Err e
                        Ok u10 -> case test-cross-target of
                          Err e -> Err e
                          Ok u11 -> case test-alethe of
                            Err e -> Err e
                            Ok u12 -> case test-verified-rewrite of
                              Err e -> Err e
                              Ok u13 -> case test-replay-only of
                                Err e -> Err e
                                Ok u14 -> case test-boundary-audit of
                                  Err e -> Err e
                                  Ok u15 -> case test-tv of
                                    Err e -> Err e
                                    Ok u16 -> case test-target-pointer-word-size of
                                      Err e -> Err e
                                      Ok u17 -> case test-repr-c-layouts of
                                        Err e -> Err e
                                        Ok u18 -> case test-verify-codegen-tv of
                                          Err e -> Err e
                                          Ok u19 -> case test-float-refinements-and-ieee754 of
                                            Err e -> Err e
                                            Ok u20 -> case test-aig-cdcl-identities of
                                              Err e -> Err e
                                              Ok u21 -> test-extended-tv-and-rc

  run-io :: forall r. using (io :: Io r) => Unit ->{IO r} Int
  run-io u = case run-all of
    Ok done -> case ioWrite (string-to-bytes "Run.PrimVerify: all 22 self-hosted verification tests PASSED\n") of _ -> 0
    Err msg -> case ioWrite (string-to-bytes (string-concat-all ["Run.PrimVerify FAILED: ", msg, "\n"])) of _ -> 1

  main :: Unit ->{IO r} Int
  main u = with (io = newIO ()) in run-io u
