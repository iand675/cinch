-- The Cinch compiler's command line. Without a mode flag it compiles,
-- links and runs, retaining the ladder's original four-path interface.
-- --compile-only links without executing the artifact. --check accepts a
-- source and diagnostics base path and stops after the frontend checks.
-- --check-types validates the same source and interface overlays as --check
-- and omits the interface and manifest files for diagnostic-only callers.
-- --emit-bodies accepts a source and output path, checks it, and writes the
-- dense typed Core body document (types in a side table) for every checked
-- definition; it writes no interfaces.
-- Either mode accepts --interfaces MANIFEST before the source paths.
-- --check-platform NAME TRIPLE OS ARCH LIBC WORD-SIZE ENDIAN supplies the
-- platform facts for --check and --check-types using those interfaces.
-- --target continues to select an installed compilation target.
-- --inline copies small units into their call sites (off by default).
-- With both compiled inputs selected, build and run take RUNTIME PREFIX
-- SOURCE, preceded by an optional --clang PATH. Run takes trailing program
-- argument words. --rc-debug emits the program's count operations as calls
-- to the runtime's checked out-of-line entries.
module Main where

  import Algebra.Semigroup
  import Cinch.Driver (read-argv)
  import Cinch.Report (render-diagnostic)
  import Cinch.Parallel (CompileStrategy, Latency, Throughput, Release, CompileTuning, parse-compile-strategy, parse-nat-word, apply-worker-budget)
  import Cinch.Pipeline (PipelineMode, TypesOnly, CheckOnly, BodiesOnly, IrOnly, EmitOnly, EmitWithInterfaces, InterfacesOnly, ObjectOnly, compile-source-library-object, CompileOnly, CompileAndRun, compile-source-profile-mode-tuned, compile-manifest-profile-mode-tuned, compile-source-with-object, compile-source-with-object-interfaces, four-words, pipeline-bad-args)
  import Cinch.Pipeline (ServeIr, ServeStream, link-source-with-object-tuned, compile-object-profile-mode-tuned, compile-source-library-object-at-tuned, compile-requested-library-object-tuned, report-target-refusal, test-source-with-object-tuned, test-source-standalone-tuned)
  import Cinch.TestRunner (parse-test-cli-args)
  import Cinch.Target (TargetProfile, configured-profile, configure-platform, host-profile, profile-with-prim-verify, profile-with-jpl, valid-prim-verify-mode)
  import Data.List (reverse)
  import Data.Path (path-from-string)
  import Text.Args (ArgSpec, FlagSpec, ValueSpec, OptVal, opt-name, opt-value, args-options, args-values, parse-args)
  import Text.Scan (string-starts-with, string-drop)

  data RequestedPlatform where
    CompilerTarget :: Option String -> RequestedPlatform
    CheckPlatform :: TargetProfile -> RequestedPlatform

  record CliOptions where
    roots :: Option String
    mode :: PipelineMode
    mode-selected :: Bool
    manifest :: Option String
    object-config :: Option String
    platform :: RequestedPlatform
    portable :: Bool
    required :: List String
    features :: Option (List String)
    strategy :: Option CompileStrategy
    workers :: Option Nat
    rc-debug :: Bool
    reclaim :: Bool
    inlining :: Bool
    prim-verify :: String
    jpl :: Bool

  default-cli-options :: CliOptions
  default-cli-options = CliOptions
    { roots = None
    , mode = CompileAndRun
    , mode-selected = False
    , manifest = None
    , object-config = None
    , platform = CompilerTarget None
    , portable = False
    , required = []
    , features = None
    , strategy = None
    , workers = None
    , rc-debug = False
    , reclaim = True
    , inlining = False
    , prim-verify = "default"
    , jpl = False
    }

  pipeline-specs :: List ArgSpec
  pipeline-specs =
    [ FlagSpec "check"
    , FlagSpec "check-types"
    , FlagSpec "emit-bodies"
    , FlagSpec "compile-only"
    , FlagSpec "emit-ir-only"
    , FlagSpec "serve-ir"
    , FlagSpec "serve-stream"
    , FlagSpec "emit-ir"
    , FlagSpec "emit-ir-with-interfaces"
    , FlagSpec "emit-object"
    , FlagSpec "emit-interfaces"
    , FlagSpec "rc-debug"
    , FlagSpec "no-reclaim"
    , FlagSpec "inline"
    , FlagSpec "latency"
    , FlagSpec "throughput"
    , FlagSpec "release"
    , FlagSpec "clear-features"
    , FlagSpec "portable-isa"
    , FlagSpec "lax-prim-verify"
    , FlagSpec "jpl"
    , ValueSpec "prim-verify"
    , ValueSpec "compile-profile"
    , ValueSpec "jobs"
    , ValueSpec "object-roots"
    , ValueSpec "interfaces"
    , ValueSpec "objects"
    , ValueSpec "target"
    , ValueSpec "require-capability"
    , ValueSpec "target-feature"
    ]

  -- A caller can check conditional source against an explicit platform and
  -- interface set even when this installation has no backend for the triple.
  resolve-platform :: CliOptions -> Result String TargetProfile
  resolve-platform opts = case opts.platform of
    CompilerTarget requested -> case configured-profile (requested, opts.portable, opts.required, opts.features) of
      Err message -> Err message
      Ok profile -> Ok (profile-with-jpl opts.jpl (profile-with-prim-verify opts.prim-verify profile))
    CheckPlatform platform -> case opts.mode of
      CheckOnly -> Ok (profile-with-jpl opts.jpl (profile-with-prim-verify opts.prim-verify (configure-platform platform opts.portable opts.required opts.features)))
      TypesOnly -> Ok (profile-with-jpl opts.jpl (profile-with-prim-verify opts.prim-verify (configure-platform platform opts.portable opts.required opts.features)))
      _ -> Err "--check-platform requires --check or --check-types"

  resolve-tuning :: CliOptions -> CompileTuning
  resolve-tuning opts =
    let strategy = case opts.strategy of
          Some s -> s
          None -> case opts.mode of
            ServeStream -> Latency
            _ -> Throughput in
    let workers = case opts.workers of
          Some n -> n
          None -> 0 in
    CompileTuning strategy workers opts.prim-verify opts.jpl

  -- Split leading options from the positional tail (or `run`/`build`
  -- subcommand), normalizing `-j` to `--jobs` and extracting any
  -- 7-argument `--check-platform` tuple before delegating all remaining
  -- flags to `Text.Args.parse-args`.
  data Subcommand where
    SubNone :: List String -> Subcommand
    SubLink :: Bool -> List String -> Subcommand
    SubTest :: List String -> Subcommand

  split-cli :: List String -> List String -> Option TargetProfile -> Option (List String, Option TargetProfile, Subcommand)
  split-cli ws acc check-plat = case ws of
    [] -> None
    w : rest -> case w of
      "-j" -> case rest of
        count : more -> split-cli more (count : "--jobs" : acc) check-plat
        [] -> None
      "--check-platform" -> case (check-plat, rest) of
        (None, name : triple : os : arch : libc : width : endian : more) ->
          if name == "" || triple == "" || os == "" || arch == "" || libc == ""
             || (width /= "32" && width /= "64")
             || (endian /= "little" && endian /= "big") then None
          else
            let bits = if width == "32" then (32 :: Nat) else (64 :: Nat) in
            let plat = TargetProfile name triple os arch libc bits endian False [] [] "default" False in
            split-cli more acc (Some plat)
        _ -> None
      "run" -> Some (reverse acc, check-plat, SubLink True rest)
      "build" -> Some (reverse acc, check-plat, SubLink False rest)
      "test" -> Some (reverse acc, check-plat, SubTest rest)
      "--prim-verify" -> take-value w rest acc check-plat
      "--compile-profile" -> take-value w rest acc check-plat
      "--jobs" -> take-value w rest acc check-plat
      "--object-roots" -> take-value w rest acc check-plat
      "--interfaces" -> take-value w rest acc check-plat
      "--objects" -> take-value w rest acc check-plat
      "--target" -> take-value w rest acc check-plat
      "--require-capability" -> take-value w rest acc check-plat
      "--target-feature" -> take-value w rest acc check-plat
      _ ->
        if string-starts-with "--prim-verify=" w then
          split-cli rest ((string-drop 14 w) : "--prim-verify" : acc) check-plat
        else if string-length w > 2 && string-slice w 0 2 == "--" then
          split-cli rest (w : acc) check-plat
        else
          Some (reverse acc, check-plat, SubNone ws)

  take-value :: String -> List String -> List String -> Option TargetProfile -> Option (List String, Option TargetProfile, Subcommand)
  take-value flag rest acc check-plat = case rest of
    v : more -> split-cli more (v : flag : acc) check-plat
    [] -> None

  set-mode :: PipelineMode -> CliOptions -> Option CliOptions
  set-mode m opts =
    if opts.mode-selected then None
    else Some (CliOptions
      { roots = opts.roots, mode = m, mode-selected = True, manifest = opts.manifest
      , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
      , required = opts.required, features = opts.features, strategy = opts.strategy
      , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
      , prim-verify = opts.prim-verify, jpl = opts.jpl })

  set-strategy :: CompileStrategy -> CliOptions -> Option CliOptions
  set-strategy s opts = case opts.strategy of
    None -> Some (CliOptions
      { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
      , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
      , required = opts.required, features = opts.features, strategy = Some s
      , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
      , prim-verify = opts.prim-verify, jpl = opts.jpl })
    Some _ -> None

  apply-option :: OptVal -> CliOptions -> Option CliOptions
  apply-option opt opts = case opt-name opt of
    "check" -> set-mode CheckOnly opts
    "check-types" -> set-mode TypesOnly opts
    "emit-bodies" -> set-mode BodiesOnly opts
    "compile-only" -> set-mode CompileOnly opts
    "emit-ir-only" -> set-mode IrOnly opts
    "serve-ir" -> set-mode ServeIr opts
    "serve-stream" -> set-mode ServeStream opts
    "emit-ir" -> set-mode EmitOnly opts
    "emit-ir-with-interfaces" -> set-mode EmitWithInterfaces opts
    "emit-object" -> set-mode ObjectOnly opts
    "emit-interfaces" -> set-mode InterfacesOnly opts
    "rc-debug" ->
      if opts.rc-debug then None
      else Some (CliOptions
        { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
        , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
        , required = opts.required, features = opts.features, strategy = opts.strategy
        , workers = opts.workers, rc-debug = True, reclaim = opts.reclaim, inlining = opts.inlining
        , prim-verify = opts.prim-verify, jpl = opts.jpl })
    "no-reclaim" ->
      if not opts.reclaim then None
      else Some (CliOptions
        { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
        , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
        , required = opts.required, features = opts.features, strategy = opts.strategy
        , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = False, inlining = opts.inlining
        , prim-verify = opts.prim-verify, jpl = opts.jpl })
    "inline" ->
      if opts.inlining then None
      else Some (CliOptions
        { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
        , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
        , required = opts.required, features = opts.features, strategy = opts.strategy
        , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = True
        , prim-verify = opts.prim-verify, jpl = opts.jpl })
    "latency" -> set-strategy Latency opts
    "throughput" -> set-strategy Throughput opts
    "release" -> set-strategy Release opts
    "compile-profile" -> case opt-value opt of
      Some word -> case parse-compile-strategy word of
        Some s -> set-strategy s opts
        None -> None
      None -> None
    "jobs" -> case (opts.workers, opt-value opt) of
      (None, Some word) -> case parse-nat-word word of
        Some count | count > 0 -> Some (CliOptions
          { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
          , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
          , required = opts.required, features = opts.features, strategy = opts.strategy
          , workers = Some count, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
          , prim-verify = opts.prim-verify, jpl = opts.jpl })
        _ -> None
      _ -> None
    "object-roots" -> case (opts.roots, opt-value opt) of
      (None, Some p) -> Some (CliOptions
        { roots = Some p, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
        , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
        , required = opts.required, features = opts.features, strategy = opts.strategy
        , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
      , prim-verify = opts.prim-verify, jpl = opts.jpl })
      _ -> None
    "interfaces" -> case (opts.manifest, opt-value opt) of
      (None, Some file) -> Some (CliOptions
        { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = Some file
        , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
        , required = opts.required, features = opts.features, strategy = opts.strategy
        , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
      , prim-verify = opts.prim-verify, jpl = opts.jpl })
      _ -> None
    "objects" -> case (opts.object-config, opt-value opt) of
      (None, Some file) -> Some (CliOptions
        { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
        , object-config = Some file, platform = opts.platform, portable = opts.portable
        , required = opts.required, features = opts.features, strategy = opts.strategy
        , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
      , prim-verify = opts.prim-verify, jpl = opts.jpl })
      _ -> None
    "target" -> case (opts.platform, opt-value opt) of
      (CompilerTarget None, Some triple) -> Some (CliOptions
        { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
        , object-config = opts.object-config, platform = CompilerTarget (Some triple), portable = opts.portable
        , required = opts.required, features = opts.features, strategy = opts.strategy
        , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
      , prim-verify = opts.prim-verify, jpl = opts.jpl })
      _ -> None
    "require-capability" -> case opt-value opt of
      Some cap | cap /= "" -> Some (CliOptions
        { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
        , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
        , required = cap : opts.required, features = opts.features, strategy = opts.strategy
        , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
      , prim-verify = opts.prim-verify, jpl = opts.jpl })
      _ -> None
    "clear-features" -> Some (CliOptions
      { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
      , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
      , required = opts.required, features = Some [], strategy = opts.strategy
      , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
      , prim-verify = opts.prim-verify, jpl = opts.jpl })
    "target-feature" -> case opt-value opt of
      Some feat | feat /= "" ->
        let chosen = case opts.features of None -> [feat]; Some prior -> feat : prior in
        Some (CliOptions
          { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
          , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
          , required = opts.required, features = Some chosen, strategy = opts.strategy
          , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
      , prim-verify = opts.prim-verify, jpl = opts.jpl })
      _ -> None
    "portable-isa" ->
      if opts.portable then None
      else Some (CliOptions
        { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
        , object-config = opts.object-config, platform = opts.platform, portable = True
        , required = opts.required, features = opts.features, strategy = opts.strategy
        , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
        , prim-verify = opts.prim-verify, jpl = opts.jpl })
    "lax-prim-verify" -> Some (CliOptions
      { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
      , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
      , required = opts.required, features = opts.features, strategy = opts.strategy
      , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
      , prim-verify = "lax", jpl = opts.jpl })
    "jpl" -> Some (CliOptions
      { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
      , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
      , required = opts.required, features = opts.features, strategy = opts.strategy
      , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
      , prim-verify = opts.prim-verify, jpl = True })
    "prim-verify" -> case opt-value opt of
      Some mode-word | valid-prim-verify-mode mode-word -> Some (CliOptions
        { roots = opts.roots, mode = opts.mode, mode-selected = opts.mode-selected, manifest = opts.manifest
        , object-config = opts.object-config, platform = opts.platform, portable = opts.portable
        , required = opts.required, features = opts.features, strategy = opts.strategy
        , workers = opts.workers, rc-debug = opts.rc-debug, reclaim = opts.reclaim, inlining = opts.inlining
        , prim-verify = mode-word, jpl = opts.jpl })
      _ -> None
    _ -> None

  apply-options :: List OptVal -> CliOptions -> Option CliOptions
  apply-options list opts = case list of
    [] -> Some opts
    o : rest -> case apply-option o opts of
      Some next -> apply-options rest next
      None -> None

  run-words :: forall r. using (io :: Io r) => List String ->{IO r, Diverge} Int
  run-words ws = case split-cli ws [] None of
    None -> pipeline-bad-args
    Some (flag-words, check-plat, sub) -> case parse-args pipeline-specs flag-words of
      Err _ -> pipeline-bad-args
      Ok parsed -> case args-values parsed of
        _ : _ -> pipeline-bad-args
        [] ->
          let init = case check-plat of
                None -> default-cli-options
                Some plat -> CliOptions
                  { roots = None, mode = CompileAndRun, mode-selected = False, manifest = None
                  , object-config = None, platform = CheckPlatform plat, portable = False
                  , required = [], features = None, strategy = None, workers = None
                  , rc-debug = False, reclaim = True, inlining = False
                  , prim-verify = "default", jpl = False } in
          case apply-options (args-options parsed) init of
            None -> pipeline-bad-args
            Some opts ->
              let tuning = resolve-tuning opts in
              let wanted = resolve-platform opts in
              do
                _ <- apply-worker-budget (tuning.workers)
                case sub of
                  SubLink is-run rest -> case (opts.roots, opts.mode-selected, opts.manifest, opts.object-config) of
                    (None, False, Some contracts, Some provider) ->
                      link-words tuning is-run opts.inlining opts.rc-debug opts.reclaim wanted contracts provider rest
                    _ -> pipeline-bad-args
                  SubTest rest -> case (opts.roots, opts.mode-selected) of
                    (None, False) ->
                      let test-tuning = case opts.strategy of
                            None -> CompileTuning Latency tuning.workers tuning.prim-verify tuning.jpl
                            Some _ -> tuning in
                      test-words test-tuning opts.inlining opts.rc-debug opts.reclaim wanted opts.manifest opts.object-config rest
                    _ -> pipeline-bad-args
                  SubNone words -> case (opts.roots, opts.mode, opts.rc-debug, opts.reclaim, opts.manifest, opts.object-config, words) of
                    (None, _, _, _, _, _, _) ->
                      run-selected tuning opts.mode opts.manifest opts.object-config wanted opts.rc-debug opts.reclaim opts.inlining words
                    (Some path, ObjectOnly, False, True, Some contracts, Some provider, [source, ir, object, abi]) ->
                      case wanted of
                        Err message -> report-target-refusal (path-from-string ir) message
                        Ok profile -> compile-requested-library-object-tuned tuning opts.inlining profile path contracts provider source (path-from-string ir) (path-from-string object) (path-from-string abi)
                    _ -> pipeline-bad-args

  test-help-text :: String
  test-help-text =
    "cinch test - built-in isolated parallel test runner (nextest style)\n\n"
    <> "Usage:\n"
    <> "  cinch [--interfaces MANIFEST --objects CONFIG] test [OPTIONS...] RUNTIME PREFIX SOURCE [FILTER...]\n\n"
    <> "Options:\n"
    <> "  -j, --test-threads N          Max concurrent isolated test processes (default: 4)\n"
    <> "  --serial                      Run all tests sequentially (equivalent to -j 1)\n"
    <> "  -E, --filter-expr EXPR        Filterset expression: test(), module(), tag(), ignored(),\n"
    <> "                                should_fail(), serial(), all(), none(), not/!, and/&, or/|, -\n"
    <> "  --exact                       Match positional filters exactly\n"
    <> "  --list                        List matching tests without compiling or running\n"
    <> "  --list-json                   List matching tests as JSON\n"
    <> "  --run-ignored default|all|only  Control #[ignore] tests (--ignored / --include-ignored)\n"
    <> "  --timeout MS                  Global per-test timeout in milliseconds\n"
    <> "  --slow-timeout MS             Slow test warning threshold in milliseconds (default: 10000)\n"
    <> "  --retries N                   Retry failed tests up to N times (reports FLAKY on pass)\n"
    <> "  --fail-fast / --no-fail-fast  Stop after first failure / run all tests\n"
    <> "  --max-fail N                  Stop scheduling new tests after N failures\n"
    <> "  --nocapture                   Print stdout/stderr immediately for all tests\n"
    <> "  --success-output POLICY       never | immediate | final | immediate-final\n"
    <> "  --failure-output POLICY       never | immediate | final | immediate-final\n"
    <> "  --status-level LEVEL          none | fail | retry | slow | pass | skip | all\n"
    <> "  --color auto|always|never     Enable or disable ANSI colors\n"
    <> "  --format human|json           Output format (default: human)\n"
    <> "  --junit PATH                  Write JUnit XML test report\n"
    <> "  --json-report PATH            Write structured JSON test report\n"
    <> "  --leak-check                  Build with --rc-debug and enforce CINCH_LEAK_CHECK=1 per test\n"
    <> "  --no-run                      Compile and link test binary without running\n"
    <> "  --partition count:i/n|hash:i/n  Deterministic CI sharding (1 <= i <= n)\n"
    <> "  --clang PATH                  Path to clang executable\n"

  has-help-flag :: List String -> Bool
  has-help-flag ws = case ws of
    [] -> False
    "--help" : _ -> True
    "-h" : _ -> True
    _ : rest -> has-help-flag rest

  test-words :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Bool -> Result String TargetProfile -> Option String -> Option String -> List String ->{IO r, Diverge} Int
  test-words tuning inlining debug reclaim wanted manifest object-config words =
    if has-help-flag words then
      do
        _ <- ioWrite (string-to-bytes test-help-text)
        0
    else case parse-test-cli-args tuning.workers words of
      Err msg -> do
        _ <- ioWrite (string-to-bytes ("cinch test: " <> msg <> "\n"))
        pipeline-bad-args
      Ok (cfg, runtime, prefix, source) -> case wanted of
        Err message -> report-target-refusal (path-from-string prefix) message
        Ok profile ->
          if profile.triple /= host-profile.triple then
            report-target-refusal (path-from-string prefix) "cinch test requires a host target"
          else case (manifest, object-config) of
            (Some contracts, Some provider) ->
              test-source-with-object-tuned tuning cfg inlining debug reclaim profile contracts provider runtime prefix source
            (manifest-opt, None) ->
              test-source-standalone-tuned tuning cfg inlining debug reclaim profile manifest-opt runtime prefix source
            (None, Some _) -> pipeline-bad-args

  link-words :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Bool -> Bool -> Result String TargetProfile -> String -> String -> List String ->{IO r, Diverge} Int
  link-words tuning run inlining debug reclaim profile contracts provider words = case words of
    "--clang" : clang : paths | clang /= "" ->
      link-paths tuning run inlining debug reclaim profile contracts provider clang paths
    "--clang" : _ -> pipeline-bad-args
    _ -> link-paths tuning run inlining debug reclaim profile contracts provider "clang" words

  link-paths :: forall r. using (io :: Io r) => CompileTuning -> Bool -> Bool -> Bool -> Bool -> Result String TargetProfile -> String -> String -> String -> List String ->{IO r, Diverge} Int
  link-paths tuning run inlining debug reclaim wanted contracts provider clang paths = case paths of
    runtime : prefix : source : words -> case (run, words) of
      (False, _ : _) -> pipeline-bad-args
      _ -> case wanted of
        Err message -> report-target-refusal (path-from-string prefix) message
        Ok profile ->
          if profile.triple == host-profile.triple then
            link-source-with-object-tuned tuning inlining debug reclaim profile contracts provider runtime prefix source clang (if run then Some (program-words words) else None)
          else
            report-target-refusal (path-from-string prefix) (if run then "a foreign target cannot run on this host" else "native build requires a host target")
    _ -> pipeline-bad-args

  program-words :: List String -> List String
  program-words words = case words of
    [] -> []
    "--" : rest -> rest
    word : rest -> word : program-words rest

  -- Debug counting changes only the typed runtime emission. Checking emits
  -- no count operations, so it ignores the flag; a mode that emits code
  -- without a runtime object refuses it.
  run-selected :: forall r. using (io :: Io r) => CompileTuning -> PipelineMode -> Option String -> Option String -> Result String TargetProfile -> Bool -> Bool -> Bool -> List String ->{IO r, Diverge} Int
  run-selected tuning mode manifest object-config wanted debug reclaim inlining ws = case mode of
    ObjectOnly -> case (debug, reclaim, manifest, object-config, ws) of
      (False, True, Some contracts, Some provider, [source, ir, object, abi]) ->
        case wanted of
          Err message -> report-target-refusal (path-from-string ir) message
          Ok profile -> compile-source-library-object-at-tuned tuning inlining profile contracts provider source (path-from-string ir) (path-from-string object) (path-from-string abi)
      _ -> pipeline-bad-args
    IrOnly -> case ws of
      [source, ir] -> run-source tuning mode manifest object-config wanted debug reclaim inlining source ir ir ir
      _ -> pipeline-bad-args
    ServeIr -> case ws of
      [source, ir] -> run-source tuning mode manifest object-config wanted debug reclaim inlining source ir ir ir
      _ -> pipeline-bad-args
    ServeStream -> case ws of
      [source, ir] -> run-source tuning mode manifest object-config wanted debug reclaim inlining source ir ir ir
      _ -> pipeline-bad-args
    EmitOnly -> case ws of
      [source, ir] -> run-source tuning mode manifest object-config wanted debug reclaim inlining source ir ir ir
      _ -> pipeline-bad-args
    EmitWithInterfaces -> case ws of
      [source, ir] -> run-source tuning mode manifest object-config wanted debug reclaim inlining source ir ir ir
      _ -> pipeline-bad-args
    InterfacesOnly -> case ws of
      [source, prefix] -> run-source tuning mode manifest object-config wanted debug reclaim inlining source prefix prefix prefix
      _ -> pipeline-bad-args
    TypesOnly -> case ws of
      [source, diagnostics] -> run-source tuning mode manifest object-config wanted debug reclaim inlining source diagnostics diagnostics diagnostics
      _ -> pipeline-bad-args
    CheckOnly -> case ws of
      [source, diagnostics] -> run-source tuning mode manifest object-config wanted debug reclaim inlining source diagnostics diagnostics diagnostics
      _ -> pipeline-bad-args
    BodiesOnly -> case (debug, ws) of
      (False, [source, out]) -> run-source tuning mode manifest object-config wanted debug reclaim inlining source out out out
      _ -> pipeline-bad-args
    _ -> case four-words ws of
      None -> pipeline-bad-args
      Some (source, ir, exe, report) -> run-source tuning mode manifest object-config wanted debug reclaim inlining source ir exe report

  run-source :: forall r. using (io :: Io r) => CompileTuning -> PipelineMode -> Option String -> Option String -> Result String TargetProfile -> Bool -> Bool -> Bool -> String -> String -> String -> String ->{IO r, Diverge} Int
  run-source tuning mode manifest object-config wanted debug reclaim inlining source ir exe report = case object-config of
    Some configuration -> case (mode, manifest) of
      (IrOnly, Some file) -> compile-object-profile-mode-tuned tuning inlining debug reclaim wanted mode file configuration source (path-from-string ir)
      (ServeIr, Some file) -> compile-object-profile-mode-tuned tuning inlining debug reclaim wanted mode file configuration source (path-from-string ir)
      (ServeStream, Some file) -> compile-object-profile-mode-tuned tuning inlining debug reclaim wanted mode file configuration source (path-from-string ir)
      (EmitOnly, Some file) -> compile-object-profile-mode-tuned tuning inlining debug reclaim wanted mode file configuration source (path-from-string ir)
      (EmitWithInterfaces, Some file) -> compile-object-profile-mode-tuned tuning inlining debug reclaim wanted mode file configuration source (path-from-string ir)
      _ -> pipeline-bad-args
    None -> case mode of
      ServeIr -> pipeline-bad-args
      ServeStream -> pipeline-bad-args
      _ -> if debug && emits-code mode then pipeline-bad-args else case manifest of
        None -> compile-source-profile-mode-tuned tuning inlining reclaim wanted mode source (path-from-string ir) (path-from-string exe) (path-from-string report)
        Some file -> compile-manifest-profile-mode-tuned tuning inlining reclaim wanted mode file source (path-from-string ir) (path-from-string exe) (path-from-string report)

  emits-code :: PipelineMode -> Bool
  emits-code mode = case mode of
    TypesOnly -> False
    CheckOnly -> False
    BodiesOnly -> False
    InterfacesOnly -> False
    _ -> True

  main :: Unit ->{IO r, Diverge} Int
  main u = with (io = newIO ()) in run-cli u

  run-cli :: forall r. using (io :: Io r) => Unit ->{IO r, Diverge} Int
  run-cli u = case read-argv u of
    Ok words -> run-words words
    Err d -> do
      _ <- ioWrite (string-to-bytes (render-diagnostic d))
      pipeline-bad-args
