module Main where
  import Bootstrap.Ast
  import Bootstrap.Parse (parse-program)
  import Bootstrap.Check (check-and-retain, checked-elaboration)
  import Bootstrap.Resolve (resolve-program)
  import Bootstrap.Infer
  import Bootstrap.Core
  import Bootstrap.Report (render-diagnostics)
  import Data.Path (path-from-string)
  import Effect.Fs (fs-read, fs-write)
  import Text.Parse (ParseOutcome, Parsed, Failed)

  run :: Bytes -> (Int, String)
  run source = case parse-program "refinement-source" source of
    Parsed program Nil -> case resolve-program program of
      (resolved, Nil) -> case check-and-retain resolved of
        Err errors -> (4, render-diagnostics errors)
        Ok checked -> if elaboration-core-contracts-closed (checked-elaboration checked) then (0, "")
          else (94, "refinement Core did not retain checked evidence")
      (resolved, errors) -> (4, render-diagnostics errors)
    other -> (2, "refinement source parse failed")
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in case fs-read (path-from-string "source.cinch") of
    Err error -> 90
    Ok source -> let (status, report) = run source in case fs-write (path-from-string "refinement-report.txt") (string-to-bytes report) of
      Err error -> 91
      Ok _ -> status
