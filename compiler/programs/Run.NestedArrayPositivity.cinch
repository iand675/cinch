-- | Recheck sealed finite-payload recursion and strict positivity authority.
module Main where
  import Cinch.Ast
  import Cinch.Parse (parse-program)
  import Cinch.Resolve (resolve-program)
  import Cinch.Infer
  import Cinch.Core (CoreData, core-data-name, core-data-params)
  import Cinch.Type (Quant, quant-kind, kind-text)
  import Cinch.Report (Diagnostic, diagnostic-message, render-diagnostics)
  import Text.Parse (ParseOutcome, Parsed, Failed)
  import Cinch.Document
  import Data.List
  import Data.Option
  import Data.String

  -- | Compare a diagnostic prefix without relying on a locale-specific string search.
  starts :: List Char -> List Char -> Bool
  starts needle haystack = case needle of
    Nil -> True
    Cons first rest -> case haystack of
      Nil -> False
      Cons actual more -> char-code first == char-code actual && starts rest more

  -- | Search a finite diagnostic for a required semantic refusal category.
  contains-chars :: List Char -> List Char -> Bool
  contains-chars needle haystack = if starts needle haystack then True else case haystack of
    Nil -> False
    Cons first rest -> contains-chars needle rest

  -- | Require a named refusal rather than treating an unrelated parse failure as a successful negative test.
  diagnosed :: String -> List Diagnostic -> Bool
  diagnosed expected errors = case errors of
    Nil -> False
    Cons first rest -> contains-chars (unpack expected) (unpack (diagnostic-message first)) || diagnosed expected rest

  -- | Find the exact definition-site nominal identity in checked Core data declarations.
  find-data :: String -> List CoreData -> Option CoreData
  find-data identity datas = case datas of
    Nil -> None
    Cons first rest -> if core-data-name first == identity then Some first else find-data identity rest

  -- | Observe a list without relying on a precompiled element-representation variant.
  empty-list :: forall a. List a -> Bool
  empty-list values = case values of Nil -> True; Cons first rest -> False

  -- | Inspect every actual checked parameter kind, including ordinary phantom Type parameters.
  parameter-kinds :: List Quant -> List String -> Bool
  parameter-kinds params expected = case params of
    Nil -> empty-list expected
    Cons first rest -> case expected of
      Nil -> False
      Cons wanted more -> kind-text (quant-kind first) == wanted && parameter-kinds rest more

  -- | Verify producer kinds rather than inferring success from consumer acceptance alone.
  checked-kinds :: List CoreData -> List (String, List String) -> Bool
  checked-kinds datas expected = case expected of
    Nil -> True
    Cons first rest -> case first of
      (identity, kinds) -> case find-data identity datas of
        None -> False
        Some declaration -> parameter-kinds (core-data-params declaration) kinds && checked-kinds datas rest

  -- | Distinguish a valid producer, a required type refusal and unrelated diagnostics.
  result-ok :: Bool -> String -> List (String, List String) -> Elaboration -> Bool
  result-ok accepted expected kinds result =
    let errors = elaboration-errors result in
    if accepted then empty-list errors && checked-kinds (elaboration-data result) kinds
    else diagnosed expected errors

  -- | Parse and resolve a real source program before checking its typing and nominal contracts.
  evaluate :: String -> Bool -> String -> List (String, List String) -> (Bool, String)
  evaluate source accepted expected kinds = case parse-program "nested-array-positivity" (string-to-bytes source) of
    Parsed program Nil -> if program-unmodeled-count program == 0 then
      case resolve-program program of
        (resolved, Nil) ->
          let result = elaborate-program "nested-array-positivity" resolved in
          let errors = elaboration-errors result in
          let ok = result-ok accepted expected kinds result in
          (ok, render-diagnostics errors)
        other -> (False, "name resolution failed")
      else (False, "unmodeled source")
    other -> (False, "source did not parse")

  -- | Retain the first source-case failure as a small deterministic process exit status.
  first-failure :: List Bool -> Nat -> Int
  first-failure values index = case values of
    Nil -> 0
    Cons first rest -> if first then first-failure rest (index + 1) else nat-to-int index

  -- | Observe one checked verdict independently of its optional diagnostic payload.
  verdict :: (Bool, String) -> Bool
  verdict result = case result of (ok, details) -> ok

  -- | Check the array-direct source and its exact strict-positivity obligations.
  check-case0 :: Unit -> Bool
  check-case0 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: Array Arena -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" True "" Nil)

  -- | Check the array-nested source and its exact strict-positivity obligations.
  check-case1 :: Unit -> Bool
  check-case1 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: Array (Array Arena) -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" True "" Nil)

  -- | Check the array-tuple source and its exact strict-positivity obligations.
  check-case2 :: Unit -> Bool
  check-case2 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: Array (Nat, Arena) -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" True "" Nil)

  -- | Check the array-function-result source and its exact strict-positivity obligations.
  check-case3 :: Unit -> Bool
  check-case3 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: Array (Unit -> Arena) -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" True "" Nil)

  -- | Check the array-mutual source and its exact strict-positivity obligations.
  check-case4 :: Unit -> Bool
  check-case4 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | The first member of a mutually recursive group.\n  data First where\n    -- | Carry the second member inside a finite array.\n    First :: Array Second -> First\n  -- | Complete the group with a direct positive field.\n  data Second where\n    -- | Retain the first member directly.\n    Second :: First -> Second\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" True "" Nil)

  -- | Check the array-ordinary-parameter source and its exact strict-positivity obligations.
  check-case5 :: Unit -> Bool
  check-case5 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | Keep a regular element parameter unchanged through recursion.\n  data Arena a where\n    -- | Terminate a finite construction.\n    End :: Arena a\n    -- | Retain recursive values under the same element parameter.\n    Pool :: a -> Array (Arena a) -> Arena a\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" True "" Nil)

  -- | Check the array-negative source and its exact strict-positivity obligations.
  check-case6 :: Unit -> Bool
  check-case6 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: Array (Arena -> Unit) -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" False "positiv" Nil)

  -- | Check the array-double-negative source and its exact strict-positivity obligations.
  check-case7 :: Unit -> Bool
  check-case7 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: Array ((Arena -> Unit) -> Unit) -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" False "positiv" Nil)

  -- | Check the direct-double-negative source and its exact strict-positivity obligations.
  check-case8 :: Unit -> Bool
  check-case8 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: ((Arena -> Unit) -> Unit) -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" False "positiv" Nil)

  -- | Check the direct-negative source and its exact strict-positivity obligations.
  check-case9 :: Unit -> Bool
  check-case9 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: (Arena -> Unit) -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" False "positiv" Nil)

  -- | Check the unknown-higher-kinded source and its exact strict-positivity obligations.
  check-case10 :: Unit -> Bool
  check-case10 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena (f :: Type -> Type) where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: Array (f (Arena f)) -> Arena f\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" False "positiv" Nil)

  -- | Check the higher-kinded-nested-in-tuple source and its exact strict-positivity obligations.
  check-case11 :: Unit -> Bool
  check-case11 unit = verdict (evaluate "-- | Keep unknown constructor variance refused even inside certified tuple storage.\nmodule Main where\n  -- | Bind an ordinary higher-kinded source parameter with no primitive certificate.\n  data Arena (f :: Type -> Type) where\n    -- | Tuple nesting cannot hide the recursive occurrence under an unknown head.\n    Pool :: Array (Nat, f (Arena f)) -> Arena f\n  -- | Keep the executable independent from the candidate type's inhabitance.\n  main :: Int\n  main = 0\n" False "positiv" Nil)

  -- | Check the ordinary-wrapper source and its exact strict-positivity obligations.
  check-case12 :: Unit -> Bool
  check-case12 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | An ordinary wrapper has no established payload certificate in this increment.\n  data Wrapper a where\n    -- | Keep the generic field private to the ordinary constructor.\n    Wrapper :: a -> Wrapper a\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: Array (Wrapper Arena) -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" False "positiv" Nil)

  -- | Check the nested-list-preserved source and its exact strict-positivity obligations.
  check-case13 :: Unit -> Bool
  check-case13 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | Declare the recursive container whose payload evidence remains unestablished.\n  data List a where\n    -- | End a finite sequence without a recursive field.\n    LocalNil :: List a\n    -- | Retain one element and a direct positive recursive tail.\n    LocalCons :: a -> List a -> List a\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: List Arena -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" False "positiv" Nil)

  -- | Check the array-nested-list-preserved source and its exact strict-positivity obligations.
  check-case14 :: Unit -> Bool
  check-case14 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | Declare the recursive container whose payload evidence remains unestablished.\n  data List a where\n    -- | End a finite sequence without a recursive field.\n    LocalNil :: List a\n    -- | Retain one element and a direct positive recursive tail.\n    LocalCons :: a -> List a -> List a\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: Array (List Arena) -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" False "positiv" Nil)

  -- | Check the tensor-unverified source and its exact strict-positivity obligations.
  check-case15 :: Unit -> Bool
  check-case15 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: Tensor Arena -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" False "positiv" Nil)

  -- | Check the array-self-argument source and its exact strict-positivity obligations.
  check-case16 :: Unit -> Bool
  check-case16 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | Recursive arguments remain subject to the existing regularity boundary.\n  data Arena a where\n    -- | Nesting the recursive owner inside its own argument remains refused.\n    Pool :: Array (Arena (Arena a)) -> Arena a\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" False "positiv" Nil)

  -- | Check the array-pointer-unverified source and its exact strict-positivity obligations.
  check-case17 :: Unit -> Bool
  check-case17 unit = verdict (evaluate "-- | Exercise one sealed finite-payload typing contract.\nmodule Main where\n  -- | A recursive fixture with the exact candidate payload position.\n  data Arena where\n    -- | Carry the candidate field without changing its recursive type.\n    Pool :: Array (RawPtr Arena) -> Arena\n  -- | Keep the fixture executable independent from its unused type declarations.\n  main :: Int\n  main = 0\n" False "positiv" Nil)

  -- | Check the nested-value-binder-preserved source and its exact strict-positivity obligations.
  check-case18 :: Unit -> Bool
  check-case18 unit = verdict (evaluate "-- | Preserve the existing restriction on nested value quantifiers.\nmodule Main where\n  -- | A candidate recursive carrier cannot hide an implicit negative domain.\n  data Arena where\n    -- | Nested value binders retain their original conversion refusal.\n    Pool :: (forall (x :: Arena). Unit) -> Arena\n  -- | Keep execution independent from rejected source.\n  main :: Int\n  main = 0\n" False "nested forall binder" Nil)

  -- | Check the array-nested-value-binder-preserved source and its exact strict-positivity obligations.
  check-case19 :: Unit -> Bool
  check-case19 unit = verdict (evaluate "-- | Preserve the existing restriction on nested value quantifiers.\nmodule Main where\n  -- | A candidate recursive carrier cannot hide an implicit negative domain.\n  data Arena where\n    -- | Nested value binders retain their original conversion refusal.\n    Pool :: Array (forall (x :: Arena). Unit) -> Arena\n  -- | Keep execution independent from rejected source.\n  main :: Int\n  main = 0\n" False "nested forall binder" Nil)

  -- | Run every source and authority check, preserving its original case number on failure.
  main :: Int
  main = first-failure (Cons (check-case0 ()) (Cons (check-case1 ()) (Cons (check-case2 ()) (Cons (check-case3 ()) (Cons (check-case4 ()) (Cons (check-case5 ()) (Cons (check-case6 ()) (Cons (check-case7 ()) (Cons (check-case8 ()) (Cons (check-case9 ()) (Cons (check-case10 ()) (Cons (check-case11 ()) (Cons (check-case12 ()) (Cons (check-case13 ()) (Cons (check-case14 ()) (Cons (check-case15 ()) (Cons (check-case16 ()) (Cons (check-case17 ()) (Cons (check-case18 ()) (Cons (check-case19 ()) Nil)))))))))))))))))))) 1
