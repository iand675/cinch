-- | Keep saved partial-call computations before later writes while fusing their final application.
module Main where
  import Data.Bytes
  import Data.Machine
  import Data.Nat

  -- | Increment the shared byte once and return its previous reading.
  advance :: Bytes -> Nat
  advance cell = if 0 < bytes-len cell then
    let before = bytes-get cell 0 in
    let written = bytes-set cell 0 (if before < 255 then before + 1 else before) in before
    else 0

  -- | Widen a checked byte reading at its original strict position.
  read-word :: Bytes -> U64
  read-word cell = if 0 < bytes-len cell then
    wrapping-i64-to-u64 (nat-to-i64 (bytes-get cell 0)) else 0

  -- | Preserve the saved natural and later word in separate byte positions.
  combine :: Nat -> U64 -> U64
  combine before after = if before <= 255 then
    wrapping-add-u64 (wrapping-shl-u64 after 8) (wrapping-i64-to-u64 (nat-to-i64 before)) else 0

  -- | Keep a saved computed prefix before an intervening write to its shared byte.
  saved-order :: Unit -> Bool
  saved-order unit =
    let cell = bytes-new 1 in
    if 0 < bytes-len cell then
      let initialized = bytes-set cell 0 3 in
      let partial = combine (advance cell) in
      let changed = advance cell in
      let result = partial (read-word cell) in
      eq-u64 result 1283 && bytes-get cell 0 == 5
    else False

  -- | Preserve two saved observations and a later word in three distinct byte positions.
  collect :: Nat -> U64 -> U64 -> U64
  collect first middle last = if first <= 255 then
    wrapping-add-u64 (wrapping-shl-u64 last 16)
      (wrapping-add-u64 (wrapping-shl-u64 middle 8) (wrapping-i64-to-u64 (nat-to-i64 first))) else 0

  -- | Preserve both saved computations in order, including their different representation classes.
  saved-pair-order :: Unit -> Bool
  saved-pair-order unit =
    let cell = bytes-new 1 in
    if 0 < bytes-len cell then
      let initialized = bytes-set cell 0 3 in
      let partial = collect (advance cell) (read-word cell) in
      let changed = advance cell in
      let result = partial (read-word cell) in
      eq-u64 result 328707 && bytes-get cell 0 == 5
    else False

  -- | Return separate failure bits for one and two saved computed arguments.
  main :: Int
  main = (if saved-order () then 0 else 1) + (if saved-pair-order () then 0 else 2)
