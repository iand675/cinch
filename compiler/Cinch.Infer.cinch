-- Rank-one elaboration. Definition-site class schemes and lexical
-- dictionaries are retained in Core. Instance selection, effects and
-- dependent obligations still require further elaboration.
module Cinch.Infer where

  import Cinch.Ast
  import Cinch.Kinds (symbolic-effect-spelling, KindDeclarations, kind-declarations, add-kind-declaration, kind-at)
  import Cinch.Type
  import Cinch.Promote
