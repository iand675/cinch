-- Temporal contracts (core specification section 10): `safety`, `liveness`,
-- `recurrence` and `stability` claims over a definition, each verified where
-- its claim is decidable and refused BY NAME where it is not, never silently
-- unchecked.
--
-- This module owns the claim's own vocabulary and the refusals that need
-- only the source: the kind and its operator, the one formula a contract
-- states, the assumption rows, and the shape of the parameters the formula
-- names. The decision procedures that read checked Core (the inductive
-- invariant over the per-step write log, the footprint a stability fact
-- survives, the structural bound a recurrence claim needs, the structured
-- scope a liveness claim names) live in `Cinch.Infer`, which is where
-- the elaboration's write log and definitions are.
--
-- The refusals here are the ones the seed states at the same points, with
-- the same text: a kind that is not one of the four, a clause that is not
-- one of the five, a formula stated twice, no formula at all, and an
-- operator that does not match the kind. Every one names the offending word
-- and the specification section it comes from.

module Cinch.Temporal where

  import Text.Lex (Span)
  import Text.Scan (string-starts-with)
  import Cinch.Ast (Decl, ContractClause, ContractFormula, ContractLeadsTo, ContractDeadlockFree, ContractAssume, ContractAssumed, ContractAssumeFair, contract-clause-span, expr-span, Expr
    , EVar, ECon, ERecord, ERecordField, EProject, ELitInt, ELitFloat, ELitStr, ELitChar, EUnit, ETuple, EList, EApp, EBin, ENeg
    , ELam, ELet, ELetScope, ELocalGroup, ELetRec, ELocalStrict, ELocalSignature, ELocalMemo, ELocalEnd, EIf, ECase, EGuarded, EAnn
    , EForall, EUsing, EBind, EDo, EHandle, EHandler, EHandlerClause, EHandlerEnd, EWith, EArg, EArgsEnd, EBinding, EBindingsEnd
    , EAlt, EAltsEnd, EQuote, ESplice, EMacroCall, EUnmodeled)
  import Algebra.Semigroup

  export ContractKind, Safety, Liveness, Recurrence, Stability
  export contract-kind, contract-kind-keyword, contract-kind-operator
  export check-contract-shape, contract-clause-names, contract-formula-clause
  export contract-assumption-rows, contract-formula-row, contract-renders-formula
  export contract-clause-operator, contract-clause-word

  -- The temporal kind a contract claims (core specification section 10:
  -- the language distinguishes safety, liveness, recurrence and
  -- stability).
  data ContractKind where
    Safety :: ContractKind
    Liveness :: ContractKind
    Recurrence :: ContractKind
    Stability :: ContractKind

  cat :: List String -> String
  cat parts = string-concat-all parts

  -- The kind a written keyword names, or none.
  contract-kind :: String -> Option ContractKind
  contract-kind word =
    case word of
    "safety" -> Some Safety
    "liveness" -> Some Liveness
    "recurrence" -> Some Recurrence
    "stability" -> Some Stability
    _ -> None

  contract-kind-keyword :: ContractKind -> String
  contract-kind-keyword k = case k of
    Safety -> "safety"
    Liveness -> "liveness"
    Recurrence -> "recurrence"
    Stability -> "stability"

  -- The formula operator the kind states (the notation of core
  -- specification section 10: `always (P)`, `eventually (Q)`, and the
  -- recurrence and stability spellings).
  contract-kind-operator :: ContractKind -> String
  contract-kind-operator k = case k of
    Safety -> "always"
    Liveness -> "eventually"
    Recurrence -> "recur"
    Stability -> "stable"

  -- The clause vocabulary, as written.
  contract-clause-word :: String -> Bool
  contract-clause-word word =
    word == "always" || word == "eventually" || word == "leads_to"
    || word == "deadlock_free" || word == "recur" || word == "stable"
    || word == "fair" || word == "strong_fair" || word == "fair_each" || word == "strong_fair_each" || word == "assume"

  -- The operator a formula clause states.
  contract-clause-operator :: ContractClause -> Option String
  contract-clause-operator clause = case clause of
    ContractFormula s op body -> Some op
    ContractLeadsTo s op lhs rhs -> Some op
    ContractDeadlockFree s op -> Some op
    ContractAssume s body -> None
    ContractAssumed s text -> None
    ContractAssumeFair s strong actions -> None

  -- Every clause word in written order (the parser keeps them as written,
  -- so the refusal can name the second formula or the mismatched operator).
  contract-clause-names :: List ContractClause -> List String
  contract-clause-names clauses = case clauses of
    [] -> []
    first : rest -> (case first of
      ContractFormula s op body -> [op]
      ContractLeadsTo s op lhs rhs -> [op]
      ContractDeadlockFree s op -> [op]
      ContractAssume s body -> ["assume"]
      ContractAssumed s text -> ["assume"]
      ContractAssumeFair s strong actions -> [if strong then "strong_fair" else "fair"]) <> contract-clause-names rest

  -- The formula clauses, in written order.
  contract-formula-clause :: List ContractClause -> Option (Span, String, Expr)
  contract-formula-clause clauses = case clauses of
    [] -> None
    first : rest -> case first of
      ContractFormula s op body -> Some (s, op, body)
      ContractLeadsTo s op lhs rhs -> Some (s, op, lhs)
      ContractDeadlockFree s op -> Some (s, op, EUnit s)
      other -> contract-formula-clause rest

  -- The stated assumptions as the manifest and interface rows spell them
  -- (`assume (P)` for a stated fact, `assume "text"` for a named one), in
  -- written order.
  contract-assumption-rows :: List ContractClause -> List String
  contract-assumption-rows clauses = case clauses of
    [] -> []
    first : rest -> case first of
      ContractFormula s op body -> contract-assumption-rows rest
      ContractLeadsTo s op lhs rhs -> contract-assumption-rows rest
      ContractDeadlockFree s op -> contract-assumption-rows rest
      ContractAssume s body -> (cat ["assume (", contract-renders-formula body, ")"]) : (contract-assumption-rows rest)
      ContractAssumed s text -> (cat ["assume \"", text, "\""]) : (contract-assumption-rows rest)
      ContractAssumeFair s strong actions ->
        fair-assumption-rows strong actions <> contract-assumption-rows rest

  fair-assumption-rows :: Bool -> List String -> List String
  fair-assumption-rows strong actions =
    fair-assumption-rows-loop strong actions actions []

  str-elem-t :: String -> List String -> Bool
  str-elem-t x xs = case xs of
    [] -> False
    first : rest -> if x == first then True else str-elem-t x rest

  count-str-t :: String -> List String -> Nat -> Nat
  count-str-t x xs acc = case xs of
    [] -> acc
    first : rest -> count-str-t x rest (if x == first then acc + 1 else acc)

  fair-assumption-rows-loop :: Bool -> List String -> List String -> List String -> List String
  fair-assumption-rows-loop strong all cur seen = case cur of
    [] -> []
    a : rest ->
      if str-elem-t a seen then fair-assumption-rows-loop strong all rest seen
      else
        let n = count-str-t a all 0 in
        let seen2 = a : seen in
        let plain-tag = if strong then "strong_fair " else "weak_fair " in
        let each-tag = if strong then "strong_fair_each " else "fair_each " in
        let disp = source-spelling a in
        let rows = (if n == 1 then [cat [plain-tag, disp]] else if n == 2 then [cat [each-tag, disp]] else [cat [plain-tag, disp], cat [each-tag, disp]]) in
        rows <> fair-assumption-rows-loop strong all rest seen2

  -- The formula as the report and manifest rows spell it:
  -- `<operator> (<rendered formula>)`.
  contract-formula-row :: ContractKind -> Expr -> String
  contract-formula-row k body = cat [contract-kind-operator k, " (", contract-renders-formula body, ")"]

  -- A formula term rendered back to source notation, so a row reads the way
  -- the contract was written. The rendering keeps the operands' own
  -- spelling: an application is prefix, an operator chain is infix, and
  -- anything else falls back to its head name, which is all a row needs.
  contract-renders-formula :: Expr -> String
  contract-renders-formula e = case e of
    EVar s name -> source-spelling name
    ECon s name args -> source-spelling name
    ELitInt s text -> text
    ELitStr s text -> cat ["\"", text, "\""]
    ELitChar s text -> text
    EUnit s -> "()"
    ENeg s inner -> cat ["-", contract-renders-formula inner]
    -- An operator application the resolver rewrote (`a < b` becomes the
    -- prelude method applied twice) reads back as the infix the contract
    -- was written with. A row is source notation, not a global spelling.
    EApp s (EApp at (EVar os op) left) right ->
      if operator-spelling op then
        cat [contract-renders-formula left, " ", source-spelling op, " ", contract-renders-formula right]
      else cat [contract-renders-formula (EApp at (EVar os op) left), " ", contract-renders-argument right]
    EApp s (EVar at op) arg -> cat [source-spelling op, " ", contract-renders-argument arg]
    EApp s f a -> cat [contract-renders-formula f, " ", contract-renders-argument a]
    EBin s op left right -> cat [contract-renders-formula left, " ", op, " ", contract-renders-formula right]
    EAnn s inner ty -> contract-renders-formula inner
    EProject s value label -> cat [contract-renders-formula value, ".", label]
    other -> "<formula>"

  -- Whether a resolved name is one of the operators a formula writes infix.
  operator-spelling :: String -> Bool
  operator-spelling name =
    string-starts-with "i.Relation$2eOrd$2eOrd$2e$3c" name
    || string-starts-with "i.Relation$2eEq$2eEq$2e$3d$3d" name
    || string-starts-with "i.Algebra$2eArithmetic$2eAdd$2e$2b" name
    || string-starts-with "i.Algebra$2eArithmetic$2eSub$2e$2d" name
    || string-starts-with "i.Algebra$2eArithmetic$2eMul$2e$2a" name

  -- The source spelling of a resolved name: the operator's own text for the
  -- encoded globals a formula's operators resolve to, and the name itself
  -- otherwise (a parameter or a call keeps the spelling the contract wrote).
  source-spelling :: String -> String
  source-spelling name =
    if string-starts-with "i.Relation$2eOrd$2eOrd$2e$3c$3d" name then "<="
    else if string-starts-with "i.Relation$2eOrd$2eOrd$2e$3c" name then "<"
    else if string-starts-with "i.Relation$2eOrd$2eOrd$2e$3e$3d" name then ">="
    else if string-starts-with "i.Relation$2eOrd$2eOrd$2e$3e" name then ">"
    else if string-starts-with "i.Relation$2eEq$2eEq$2e$3d$3d" name then "=="
    else if string-starts-with "i.Relation$2eEq$2eEq$2e$2f$3d" name then "/="
    else if string-starts-with "i.Algebra$2eArithmetic$2eAdd$2e$2b" name then "+"
    else if string-starts-with "i.Algebra$2eArithmetic$2eSub$2e$2d" name then "-"
    else if string-starts-with "i.Algebra$2eArithmetic$2eMul$2e$2a" name then "*"
    else if name == "b.copyOut" then "copyOut"
    else if name == "b.refSet" then "refSet"
    else if name == "b.borrow" then "borrow"
    else if name == "b.mutBorrow" then "mutBorrow"
    else if name == "b.unrefine" then "unrefine"
    else name

  contract-renders-argument :: Expr -> String
  contract-renders-argument e = case e of
    EVar s name -> name
    ECon s name args -> name
    ELitInt s text -> text
    ELitStr s text -> cat ["\"", text, "\""]
    ELitChar s text -> text
    EUnit s -> "()"
    ENeg s inner -> cat ["-", contract-renders-argument inner]
    EProject s value label -> cat [contract-renders-formula value, ".", label]
    other -> cat ["(", contract-renders-formula other, ")"]

  -- The contract's shape, decided from the source alone (core specification
  -- section 10). Each refusal is the seed's: it names the offending word
  -- and says what the contract must state instead. A contract that passes
  -- here still has to be verified against its definition.
  kind-accepts-operator :: ContractKind -> String -> Bool
  kind-accepts-operator kind op = case kind of
    Safety -> op == "always" || op == "deadlock_free"
    Liveness -> op == "eventually" || op == "leads_to"
    Recurrence -> op == "recur"
    Stability -> op == "stable"

  check-contract-shape :: Span -> String -> List ContractClause -> Result String (ContractKind, Expr)
  check-contract-shape span keyword clauses = case contract-kind keyword of
    None -> Err (cat ["`", keyword, "` is not a temporal contract kind; expected `safety`, `liveness`, `recurrence` or `stability` (core specification section 10)"])
    Some kind -> case contract-formula-clause clauses of
      None -> Err (cat ["a `", contract-kind-keyword kind, "` temporal contract states its formula: `", contract-kind-operator kind, " = (P)` (core specification section 10)"])
      Some (at, op, body) ->
        if op == "next" then
          Err "`next` is forbidden in public temporal contracts: public contracts must be stuttering-invariant (use `always`, `eventually`, `leads_to`, `recur` or `stable`; reserve `Later k` for internal guarded productivity)"
        else if not (contract-clause-word op) then
          Err (cat ["`", op, "` is not a contract clause; expected `always`, `eventually`, `leads_to`, `deadlock_free`, `recur`, `stable`, `fair`, `strong_fair`, `fair_each`, `strong_fair_each` or `assume` (core specification section 10)"])
        else if not (kind-accepts-operator kind op) then
          Err (cat ["a `", contract-kind-keyword kind, "` temporal contract states `", contract-kind-operator kind, " = (P)`, not `", op, " = (...)` (core specification section 10: the language distinguishes safety, liveness, recurrence and stability)"])
        else if contract-formula-count clauses > 1 then
          Err (cat ["duplicate `", op, "` formula: a temporal contract states exactly one formula (core specification section 10)"])
        else Ok (kind, body)

  contract-formula-count :: List ContractClause -> Nat
  contract-formula-count clauses = case clauses of
    [] -> 0
    first : rest -> (case first of
      ContractFormula s op body -> 1
      ContractLeadsTo s op lhs rhs -> 1
      ContractDeadlockFree s op -> 1
      other -> 0) + contract-formula-count rest

