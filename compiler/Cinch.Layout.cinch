-- Represented data layouts: unboxed/transparent wrappers and multi-field
-- `#[repr(C)]`, `#[repr(packed)]`, `#[repr(packed(N))]`, `#[repr(align(N))]`
-- C struct layouts parameterized by target `word-bits` (32 or 64).
module Cinch.Layout where
  import Cinch.Ast
  import Cinch.Core
  import Cinch.Index (IndexTerm, IInteger)
  import Cinch.Foreign (foreign-pointer)
  import Cinch.Type
  import Cinch.Nominal (interface-global)
  import Cinch.Usage (UsageShape, usage-single-field)
  import Cinch.Document
  import Algebra.Semigroup
  import Data.Char (char-code)
  import Data.List (reverse)
  import Data.Nat (nat-from-int, nat-div, nat-rem, checked-div, checked-rem, nat-to-int)
  import Data.String (string-length, unpack)
  import Text.Lex (Span)
  import Text.Scan (string-split-on, string-strip, string-starts-with, string-ends-with, string-index-of, string-take, string-drop)
  import Text.Show (nat-to-string)

  export check-layouts, check-layouts-for
  export is-value-repr, fixed-array-parts, pod-type-layout, value-layout-of

  record Request where
    field0 :: Span
    field1 :: String
    field2 :: String
    field3 :: List String
    field4 :: Option Json

  field :: String -> Json -> Json
  field name doc = case doc of
    JObj key value more -> if key == name then value else field name more
    other -> JNull
  named-row :: String -> Json -> Option Json
  named-row name rows = case rows of
    JArr row more -> (case field "name" row of
      JStr n | (n == name) -> Some row
      other -> named-row name more)
    other -> None

  has-item :: String -> List String -> Bool
  has-item needle items = case items of
    [] -> False
    first : rest -> string-strip first == needle || has-item needle rest

  is-value-repr :: String -> Bool
  is-value-repr repr = has-item "value" (string-split-on "," repr)

  is-c-repr-item :: String -> Bool
  is-c-repr-item raw =
    let s = string-strip raw in
    s == "C" || s == "packed" || string-starts-with "packed(" s || string-starts-with "align(" s

  is-c-repr-items :: List String -> Bool
  is-c-repr-items items = case items of
    [] -> False
    [only] -> is-c-repr-item only
    first : rest -> is-c-repr-item first && is-c-repr-items rest

  is-c-repr-str :: String -> Bool
  is-c-repr-str repr = is-c-repr-items (string-split-on "," repr)
  requests :: List Decl -> List Request
  requests ds = case ds of
    [] -> []
    (DWrapperLayout site name repr label) : rest -> (Request site name repr label None) : (requests rest)
    (DInterface site home hash doc) : rest ->
      abi-requests site home (field "types" (field "exports" doc)) (field "layouts" (field "abi" doc)) (requests rest)
    other : rest -> requests rest

  abi-requests :: Span -> String -> Json -> Json -> List Request -> List Request
  abi-requests site home types layouts tail = case layouts of
    JArr row more -> let rest = abi-requests site home types more tail in
      (case (field "repr" row, field "type" row) of
        (JStr repr, JStr name) | (repr == "unboxed") || repr == "transparent" || is-value-repr repr || is-c-repr-str repr -> (case named-row name types of
          Some ty -> (case field "identity" ty of
            JStr identity | (identity == home <> "." <> name) ->
              (Request site (interface-global identity) repr (field-labels (field "fields" ty)) (Some row)) : rest
            other -> rest)
          None -> rest)
        other -> rest)
    other -> tail

  field-labels :: Json -> List String
  field-labels rows = case rows of JArr (JStr label) rest -> label : (field-labels rest); other -> []

  -- Field names count erased parameters in source order. A private imported
  -- constructor can only disclose its slot through the checked ABI row.
  payload-label :: List String -> Nat -> UType -> String
  payload-label labels ordinal ty = case ty of
    UProofFun predicate effects result -> payload-label (case labels of first : rest -> rest; [] -> []) (ordinal + 1) result
    other -> (case labels of label : rest -> label; [] -> (case other of
      UPi id name domain effects result -> name
      other -> "$f" <> nat-to-string ordinal))
  layout-label :: List String -> Option Json -> CoreData -> String
  layout-label labels published d = case core-data-constructors d of
    [ctor] -> payload-label labels 0 (scheme-body (ctor.constructor-scheme))
    other -> (case published of
      Some row -> (case field "fields" row of JArr entry JArrEnd -> (case field "name" entry of JStr name -> name; other -> ""); other -> "")
      None -> "")

  requested :: String -> List Request -> Option Request
  requested name layouts = case layouts of
    [] -> None
    (Request site owner repr label published) : rest -> if name == owner then Some (Request site owner repr label published) else requested name rest
  data-for :: String -> List CoreData -> Option CoreData
  data-for name datas = case datas of
    [] -> None
    d : rest -> if name == core-data-name d then Some d else data-for name rest
  private-payload :: String -> List UsageShape -> Option UType
  private-payload owner shapes = case shapes of
    [] -> None
    shape : rest -> if owner == shape.name then usage-single-field shape else private-payload owner rest
  represented-field :: CoreData -> List UsageShape -> Option UType
  represented-field d shapes = case core-data-constructors d of
    [constructor] -> (case core-constructor-fields constructor of [payload] -> Some payload; other -> None)
    [] -> private-payload (core-data-name d) shapes
    other -> None
  member :: String -> List String -> Bool
  member name names = case names of [] -> False; first : rest -> name == first || member name rest
  unwrap-refined-carrier :: UType -> UType
  unwrap-refined-carrier ty = case ty of
    URefine id name base pred -> unwrap-refined-carrier base
    other -> ty
  head-name :: UType -> Option String
  head-name ty = case unwrap-refined-carrier ty of
    UCon name kind -> Some name
    UApp f a -> head-name f
    other -> None

  is-type-param :: UType -> Bool
  is-type-param ty = case unwrap-refined-carrier ty of
    UBound _ _ _ -> True
    URigid _ _ _ _ -> True
    UMeta _ _ -> True
    other -> False

  parse-nat-chars :: List Char -> Nat -> Option Nat
  parse-nat-chars cs acc = case cs of
    [] -> Some acc
    c : rest -> let code = char-code c in
      if code >= 48 && code <= 57 then parse-nat-chars rest (acc * 10 + (code - 48))
      else None

  parse-nat-str :: String -> Option Nat
  parse-nat-str text = let s = string-strip text in
    if string-length s == 0 then None else parse-nat-chars (unpack s) 0

  is-pow2 :: Nat -> Bool
  is-pow2 n = n == 1 || n == 2 || n == 4 || n == 8 || n == 16 || n == 32 || n == 64 || n == 128 || n == 256 || n == 512 || n == 1024 || n == 2048 || n == 4096

  mod-nat :: Nat -> Nat -> Nat
  mod-nat n a = if a <= 1 then 0 else if a <= n then mod-nat (n - a) a else n

  align-up :: Nat -> Nat -> Nat
  align-up n a = if a <= 1 then n else
    let r = mod-nat n a in
    if r == 0 then n else if r <= a then n + (a - r) else n

  max-nat :: Nat -> Nat -> Nat
  max-nat a b = if a >= b then a else b

  min-nat :: Nat -> Nat -> Nat
  min-nat a b = if a <= b then a else b

  fixed-array-parts :: UType -> Option (Nat, UType)
  fixed-array-parts ty = case refinement-view ty of
    URefine id name base pred -> fixed-array-parts base
    UApp (UApp (UCon name kind) n-term) elem | (name == "FixedArray") ->
      (case n-term of
        UIndex carrier (IInteger n) -> if n < 0 then None else Some (nat-from-int n, elem)
        other -> None)
    other -> None

  parse-modifier-arg :: String -> String -> Option Nat
  parse-modifier-arg prefix item =
    let s = string-strip item in
    let p = prefix <> "(" in
    let plen = string-length p in
    let slen = string-length s in
    if string-starts-with p s && string-ends-with ")" s && slen > plen + 1 then
      let inner-len = slen - plen - 1 in
      parse-nat-str (string-take inner-len (string-drop plen s))
    else None

  parse-value-repr-items :: List String -> Bool -> Option Nat -> Option Nat -> Result String (Bool, Option Nat, Option Nat)
  parse-value-repr-items items is-c align-opt packed-opt = case items of
    [] -> Ok (is-c, align-opt, packed-opt)
    raw : rest -> let item = string-strip raw in
      if item == "value" then parse-value-repr-items rest is-c align-opt packed-opt
      else if item == "C" then parse-value-repr-items rest True align-opt packed-opt
      else if item == "packed" then parse-value-repr-items rest is-c align-opt (Some 1)
      else case parse-modifier-arg "packed" item of
        Some p -> if is-pow2 p then parse-value-repr-items rest is-c align-opt (Some p) else Err "packed alignment must be a power of two"
        None -> case parse-modifier-arg "align" item of
          Some a -> if is-pow2 a then parse-value-repr-items rest is-c (Some a) packed-opt else Err "align must be a power of two"
          None -> Err ("unsupported repr(value) modifier: " <> item)

  pod-scalar-layout :: Nat -> String -> Option (Nat, Nat)
  pod-scalar-layout ptr-bytes name =
    if name == "Unit" then Some (0, 1)
    else if member name ["Bool", "I8", "U8"] then Some (1, 1)
    else if member name ["I16", "U16"] then Some (2, 2)
    else if member name ["I32", "U32", "F32", "Char"] then Some (4, 4)
    else if member name ["I64", "U64", "F64"] then Some (8, 8)
    else if member name ["I128", "U128"] then Some (16, 16)
    else if member name ["Usize", "Isize"] then Some (ptr-bytes, ptr-bytes)
    else None

  pod-field-layout :: Nat -> List Request -> List CoreData -> List String -> UType -> Result String (Nat, Nat)
  pod-field-layout ptr-bytes layouts datas seen raw-ty =
    let ty = case refinement-view raw-ty of URefine id name base pred -> base; other -> raw-ty in
    if foreign-pointer ty then Ok (ptr-bytes, ptr-bytes)
    else case fixed-array-parts ty of
      Some (n, elem) -> case pod-field-layout ptr-bytes layouts datas seen elem of
        Err msg -> Err msg
        Ok (esz, eal) -> let stride = align-up esz eal in Ok (n * stride, eal)
      None -> case ty of
        UCon name KType -> (case pod-scalar-layout ptr-bytes name of
          Some pair -> Ok pair
          None -> case data-for name datas of
            Some nested -> (case core-data-layout nested of
              ValueData repr sz al fs -> Ok (sz, al)
              other -> case requested name layouts of
                Some (Request at owner repr labels row) | is-value-repr repr ->
                  (case compute-value-data ptr-bytes layouts datas seen repr labels nested of
                    Err msg -> Err msg
                    Ok (ValueData r sz al fs) -> Ok (sz, al)
                    Ok other-l -> Err "repr(value) fields must be POD (non-refcounted)")
                other-r -> Err ("repr(value) / FixedArray requires POD (non-refcounted) fields, not " <> name))
            None -> Err ("repr(value) / FixedArray requires POD (non-refcounted) fields, not " <> name))
        other -> Err "repr(value) / FixedArray requires POD (non-refcounted) fields"

  pod-type-layout :: Nat -> List CoreData -> UType -> Option (Nat, Nat)
  pod-type-layout word-bits datas ty =
    let ptr-bytes = if word-bits == 32 then 4 else 8 in
    case pod-field-layout ptr-bytes [] datas [] ty of
      Ok pair -> Some pair
      Err msg -> None

  value-layout-of :: String -> List CoreData -> Option (String, Nat, Nat, List ValueField)
  value-layout-of name datas = case data-for name datas of
    Some d -> (case core-data-layout d of
      ValueData repr sz al fs -> Some (repr, sz, al, fs)
      other -> None)
    None -> None

  value-fields-loop :: Nat -> List Request -> List CoreData -> List String -> Option Nat -> List String -> List UType -> Nat -> Nat -> Nat -> List ValueField -> Result String (Nat, Nat, List ValueField)
  value-fields-loop ptr-bytes layouts datas seen packed-opt labels field-tys ordinal offset natural acc = case field-tys of
    [] -> Ok (offset, natural, reverse acc)
    ft : rest ->
      let (fname, rest-labels) = case labels of l : ls -> (l, ls); [] -> ("$f" <> nat-to-string ordinal, []) in
      case pod-field-layout ptr-bytes layouts datas seen ft of
        Err msg -> Err msg
        Ok (fsize, fnat) ->
          let eff-align = case packed-opt of Some cap -> min-nat fnat cap; None -> fnat in
          let aligned = align-up offset eff-align in
          let next-nat = max-nat natural eff-align in
          let vf = ValueField fname aligned fsize fnat ft in
          value-fields-loop ptr-bytes layouts datas seen packed-opt rest-labels rest (ordinal + 1) (aligned + fsize) next-nat (vf : acc)

  compute-value-data :: Nat -> List Request -> List CoreData -> List String -> String -> List String -> CoreData -> Result String DataLayout
  compute-value-data ptr-bytes layouts datas seen repr labels d =
    let owner = core-data-name d in
    if member owner seen then Err "repr(value) has a recursive layout"
    else case parse-value-repr-items (string-split-on "," repr) False None None of
      Err msg -> Err msg
      Ok (is-c, align-opt, packed-opt) -> case core-data-constructors d of
        [ctor] ->
          let fts = core-constructor-fields ctor in
          (case value-fields-loop ptr-bytes layouts datas (owner : seen) packed-opt labels fts 0 0 1 [] of
            Err msg -> Err msg
            Ok (raw-size, natural, vfields) ->
              let checked-align = case align-opt of
                    None -> Ok natural
                    Some raise -> if raise < natural then Err "repr(align) only raises natural alignment" else Ok raise in
              (case checked-align of
                Err msg -> Err msg
                Ok type-align ->
                  let total-size = align-up raw-size type-align in
                  Ok (ValueData repr total-size type-align vfields)))
        other -> Err "repr(value) requires a record declaration (single-constructor POD value struct)"

  scalar-layout :: Nat -> String -> Option (Nat, Nat, Nat)
  scalar-layout ptr-bytes name = if name == "Unit" then Some (0, 0, 1)
    else if member name ["Bool", "I8", "U8"] then Some (0, 1, 1)
    else if member name ["I16", "U16"] then Some (0, 2, 2)
    else if member name ["I32", "U32", "F32", "Char"] then Some (0, 4, 4)
    else if member name ["Usize", "Isize", "RawPtr", "Ptr", "Owned", "Borrowed", "MaybeNull", "Out"] then Some (0, ptr-bytes, ptr-bytes)
    else if member name ["I64", "U64", "F64", "Sym"] then Some (0, 8, 8)
    else if member name ["Int", "Nat"] then Some (2, 8, 8)
    else if name == "Bytes" then Some (1, 8, 8)
    else None

  physical-layout :: Nat -> List Request -> List CoreData -> List UsageShape -> List String -> CoreData -> Result String (Nat, Nat, Nat)
  physical-layout ptr-bytes layouts datas shapes seen d = let owner = core-data-name d in
    if member owner seen then Err "repr(unboxed) has a recursive layout" else case represented-field d shapes of
      None -> Err "repr(unboxed) requires one constructor with exactly one represented field"
      Some payload -> (case head-name payload of
        Some name -> (case scalar-layout ptr-bytes name of
          Some physical -> Ok physical
          None -> (case (requested name layouts, data-for name datas) of
            (Some (Request at wrapper repr labels row), Some nested) | (repr == "unboxed") -> physical-layout ptr-bytes layouts datas shapes (owner : seen) nested
            other -> Err "repr(unboxed) requires a fixed single-word payload"))
        None -> Err "repr(unboxed) requires a fixed single-word payload")

  -- Boundary wrappers keep their heap object. Their payload has the single
  -- field's physical width, including a zero-byte Unit field.
  transparent-layout :: Nat -> CoreData -> List UsageShape -> Result String (Nat, Nat, Nat)
  transparent-layout ptr-bytes d shapes = case represented-field d shapes of
    None -> Err "repr(transparent) needs exactly one represented field"
    Some payload -> (case head-name payload of
      Some name -> (case scalar-layout ptr-bytes name of
        Some physical -> Ok physical
        None -> if member name ["I128", "U128"] then Ok (3, 16, 16)
          else Err "repr(transparent) field needs a known boundary layout")
      None -> Err "repr(transparent) field needs a fixed layout")

  is-power-of-two :: Nat -> Bool
  is-power-of-two n =
    if n == 0 then False
    else if n == 1 then True
    else case checked-rem n 2 of
      Some 0 -> (case checked-div n 2 of Some q -> is-power-of-two q; None -> False)
      other -> False

  parse-digits-nat :: List Char -> Nat -> Option Nat
  parse-digits-nat cs acc = case cs of
    [] -> Some acc
    c : rest ->
      let code = char-code c in
      if code >= 48 && code <= 57 then parse-digits-nat rest (acc * 10 + (code - 48))
      else None

  parse-pos-nat :: String -> Option Nat
  parse-pos-nat s = case unpack (string-strip s) of
    [] -> None
    cs -> parse-digits-nat cs 0

  parse-paren-nat :: String -> String -> Option Nat
  parse-paren-nat prefix raw =
    let s = string-strip raw in
    let plen = string-length prefix in
    let slen = string-length s in
    if string-starts-with prefix s && string-ends-with ")" s && slen > plen + 1 then
      parse-pos-nat (string-take (slen - plen - 1) (string-drop plen s))
    else None

  parse-c-repr-items :: List String -> Bool -> Option Nat -> Option Nat -> Result String (Bool, Option Nat, Option Nat)
  parse-c-repr-items items has-c packed-opt align-opt = case items of
    [] ->
      case (packed-opt, align-opt) of
        (Some _, Some _) -> Err "`repr(packed)` removes padding and `repr(align(N))` raises alignment; they conflict"
        other -> Ok (has-c, packed-opt, align-opt)
    raw : rest ->
      let s = string-strip raw in
      if s == "C" then parse-c-repr-items rest True packed-opt align-opt
      else if s == "packed" then parse-c-repr-items rest has-c (Some 1) align-opt
      else if string-starts-with "packed(" s then
        (case parse-paren-nat "packed(" s of
          Some n | is-power-of-two n -> parse-c-repr-items rest has-c (Some n) align-opt
          other -> Err "`repr(packed(N))` takes a non-zero power of two")
      else if string-starts-with "align(" s then
        (case parse-paren-nat "align(" s of
          Some n | is-power-of-two n -> parse-c-repr-items rest has-c packed-opt (Some n)
          other -> Err "`repr(align(N))` takes a non-zero power of two")
      else Err ("unsupported representation modifier: " <> s)

  canonical-repr-spelling :: Bool -> Option Nat -> Option Nat -> String
  canonical-repr-spelling has-c packed-opt align-opt =
    let base = if has-c then ["C"] else [] in
    let with-p = case packed-opt of
          None -> base
          Some 1 -> base <> ["packed"]
          Some n -> base <> ["packed(" <> nat-to-string n <> ")"] in
    let parts = case align-opt of
          None -> with-p
          Some n -> with-p <> ["align(" <> nat-to-string n <> ")"] in
    join-comma-space parts

  join-comma-space :: List String -> String
  join-comma-space xs = case xs of
    [] -> ""
    [only] -> only
    first : rest -> first <> ", " <> join-comma-space rest

  data-layout-size-align :: DataLayout -> Option (Nat, Nat)
  data-layout-size-align layout = case layout of
    UnboxedData _ _ sz al -> Some (sz, al)
    TransparentData _ sz al -> Some (sz, al)
    ValueData _ sz al _ -> Some (sz, al)
    CStructData _ sz al _ -> Some (sz, al)
    other -> None

  field-size-align :: Nat -> List Request -> List CoreData -> List UsageShape -> List String -> UType -> Result String (Nat, Nat)
  field-size-align ptr-bytes layouts datas shapes seen ty =
    if is-type-param ty then
      Err "a representation attribute fixes every field's layout, but this field's type is not fixed"
    else case head-name ty of
      Some name ->
        if member name ["I128", "U128"] then Ok (16, 16)
        else case scalar-layout ptr-bytes name of
          Some (_, sz, al) -> Ok (sz, al)
          None -> case (requested name layouts, data-for name datas) of
            (Some (Request _ _ repr labels published), Some nested) ->
              (case compute-data-layout ptr-bytes layouts datas shapes seen nested repr labels published of
                Err msg -> Err msg
                Ok nested-layout -> case data-layout-size-align nested-layout of
                  Some pair -> Ok pair
                  None -> Ok (8, 8))
            other -> Ok (8, 8)
      None -> Ok (8, 8)

  c-struct-field-names :: List String -> Nat -> Nat -> List String
  c-struct-field-names labels ordinal count =
    if count == 0 then []
    else case labels of
      label : rest -> label : (c-struct-field-names rest (ordinal + 1) (count - 1))
      [] -> ("$f" <> nat-to-string ordinal) : (c-struct-field-names [] (ordinal + 1) (count - 1))

  c-struct-fields-loop :: Nat -> List Request -> List CoreData -> List UsageShape -> List String -> Option Nat -> List String -> List UType -> Nat -> Nat -> List (String, Nat, Nat, Nat) -> Result String (Nat, Nat, List (String, Nat, Nat, Nat))
  c-struct-fields-loop word-bits layouts datas shapes seen packed-opt names types offset natural acc = case (names, types) of
    ([], []) -> Ok (offset, natural, reverse acc)
    (fname : nrest, fty : trest) ->
      case field-size-align word-bits layouts datas shapes seen fty of
        Err msg -> Err msg
        Ok (fsize, nat) ->
          let al = case packed-opt of
                Some cap -> if cap < nat then cap else nat
                None -> nat in
          let aligned-off = align-up offset al in
          let next-nat = if al > natural then al else natural in
          c-struct-fields-loop word-bits layouts datas shapes seen packed-opt nrest trest (aligned-off + fsize) next-nat ((fname, aligned-off, fsize, nat) : acc)
    other -> Err "C struct field label count disagrees with constructor fields"

  c-struct-layout :: Nat -> List Request -> List CoreData -> List UsageShape -> List String -> CoreData -> List String -> String -> Result String DataLayout
  c-struct-layout word-bits layouts datas shapes seen d labels repr =
    let owner = core-data-name d in
    if member owner seen then Err "repr(C) has a recursive layout"
    else case parse-c-repr-items (string-split-on "," repr) False None None of
      Err msg -> Err msg
      Ok (has-c, packed-opt, align-opt) ->
        case core-data-constructors d of
          [ctor] ->
            let ftypes = core-constructor-fields ctor in
            let fnames = c-struct-field-names labels 0 (list-length ftypes) in
            (case c-struct-fields-loop word-bits layouts datas shapes (owner : seen) packed-opt fnames ftypes 0 1 [] of
              Err msg -> Err msg
              Ok (raw-end, natural, fields) ->
                let type-align-res = case align-opt of
                      None -> Ok natural
                      Some raise ->
                        if raise < natural then
                          Err ("`repr(align(" <> nat-to-string raise <> "))` only raises: natural alignment is " <> nat-to-string natural)
                        else Ok raise in
                (case type-align-res of
                  Err msg -> Err msg
                  Ok type-align ->
                    let total-size = align-up raw-end type-align in
                    let spelled = canonical-repr-spelling has-c packed-opt align-opt in
                    Ok (CStructData spelled total-size type-align fields)))
          other -> Err "a multi-constructor `data` has no field layout to compute: `repr(C)`, `align` and `packed` apply to one constructor's source-order fields"

  compute-data-layout :: Nat -> List Request -> List CoreData -> List UsageShape -> List String -> CoreData -> String -> List String -> Option Json -> Result String DataLayout
  compute-data-layout ptr-bytes layouts datas shapes seen d repr labels published =
    if is-value-repr repr then
      compute-value-data ptr-bytes layouts datas seen repr labels d
    else if repr == "transparent" then
      case transparent-layout ptr-bytes d shapes of
        Err msg -> Err msg
        Ok (_, bytes, align) -> Ok (TransparentData (layout-label labels published d) bytes align)
    else if repr == "unboxed" then
      case physical-layout ptr-bytes layouts datas shapes seen d of
        Err msg -> Err msg
        Ok (word, bytes, align) -> Ok (UnboxedData (layout-label labels published d) word bytes align)
    else c-struct-layout ptr-bytes layouts datas shapes seen d labels repr

  matches-published-fields :: Json -> List (String, Nat, Nat, Nat) -> Bool
  matches-published-fields rows fields = case (rows, fields) of
    (JArrEnd, []) -> True
    (JArr entry more, (fname, off, sz, al) : rest) ->
      (case (field "name" entry, field "offset" entry, field "size" entry, field "align" entry) of
        (JStr n, JNum o, JNum w, JNum a) ->
          n == fname && o == nat-to-int off && w == nat-to-int sz && a == nat-to-int al && matches-published-fields more rest
        other -> False)
    other -> False

  matches-published-layout :: Json -> DataLayout -> Bool
  matches-published-layout row layout = case layout of
    UnboxedData label _ size align -> matches-published-fields (field "fields" row) [(label, 0, size, align)]
      && (case (field "size" row, field "align" row) of (JNum s, JNum a) -> s == nat-to-int size && a == nat-to-int align; other -> False)
    TransparentData label size align -> matches-published-fields (field "fields" row) [(label, 0, size, align)]
      && (case (field "size" row, field "align" row) of (JNum s, JNum a) -> s == nat-to-int size && a == nat-to-int align; other -> False)
    CStructData _ size align fields -> matches-published-fields (field "fields" row) fields
      && (case (field "size" row, field "align" row) of (JNum s, JNum a) -> s == nat-to-int size && a == nat-to-int align; other -> False)
    other -> True

  check-layouts :: Nat -> List Decl -> List CoreData -> List UsageShape -> Store -> (List CoreData, Store)
  check-layouts word-bits ds datas shapes st = check-layouts-for word-bits ds datas shapes st

  check-layouts-for :: Nat -> List Decl -> List CoreData -> List UsageShape -> Store -> (List CoreData, Store)
  check-layouts-for word-bits ds datas shapes st =
    let ptr-bytes = if word-bits == 32 then 4 else 8 in
    case requests ds of
      [] -> (datas, st)
      layouts -> attach-layouts ptr-bytes layouts datas shapes datas st

  attach-layouts :: Nat -> List Request -> List CoreData -> List UsageShape -> List CoreData -> Store -> (List CoreData, Store)
  attach-layouts ptr-bytes layouts all shapes todo st = case todo of
    [] -> ([], st)
    d : rest -> case attach-layouts ptr-bytes layouts all shapes rest st of
      (more, checked) -> (case requested (core-data-name d) layouts of
        None -> (d : more, checked)
        Some (Request site owner repr labels published) ->
          if is-value-repr repr then
            (case compute-value-data ptr-bytes layouts all [] repr labels d of
              Err message -> (d : more, add-error site message checked)
              Ok vlayout -> ((with-data-layout vlayout d) : more, checked))
          else
            (case compute-data-layout ptr-bytes layouts all shapes [] d repr labels published of
              Err message -> (d : more, add-error site message checked)
              Ok computed -> (case published of
                Some row | not (matches-published-layout row computed) -> (d : more, add-error site (repr <> " ABI layout disagrees with its represented field") checked)
                other -> ((with-data-layout computed d) : more, checked))))
