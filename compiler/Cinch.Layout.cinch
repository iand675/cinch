-- A represented newtype keeps its checked nominal identity. The payload's
-- word class governs retention, independently of its published ABI size.
module Cinch.Layout where
  import Cinch.Ast
  import Cinch.Core
  import Cinch.Index
  import Cinch.Type
  import Cinch.Nominal (interface-global)
  import Cinch.Usage (UsageShape, usage-single-field)
  import Cinch.Document
  import Algebra.Semigroup
  import Text.Lex (Span)
  import Text.Show (nat-to-string)

  export check-layouts

  record Request where
    field0 :: Span
    field1 :: String
    field2 :: String
    field3 :: List String
    field4 :: Option Json

  field :: String -> Json -> Json
  field name doc = case doc of
    JObj key value more -> if key == name then value else field name more
    other -> JNull
  named-row :: String -> Json -> Option Json
  named-row name rows = case rows of
    JArr row more -> (case field "name" row of
      JStr n | (n == name) -> Some row
      other -> named-row name more)
    other -> None

  requests :: List Decl -> List Request
  requests ds = case ds of
    [] -> []
    (DWrapperLayout site name repr label) : rest -> (Request site name repr label None) : (requests rest)
    (DInterface site home hash doc) : rest ->
      abi-requests site home (field "types" (field "exports" doc)) (field "layouts" (field "abi" doc)) (requests rest)
    other : rest -> requests rest

  abi-requests :: Span -> String -> Json -> Json -> List Request -> List Request
  abi-requests site home types layouts tail = case layouts of
    JArr row more -> let rest = abi-requests site home types more tail in
      (case (field "repr" row, field "type" row) of
        (JStr repr, JStr name) | (repr == "unboxed") || repr == "transparent" || repr == "niche" || repr == "poly-niche" -> (case named-row name types of
          Some ty -> (case field "identity" ty of
            JStr identity | (identity == home <> "." <> name) ->
              (Request site (interface-global identity) repr (field-labels (field "fields" ty)) (Some row)) : rest
            other -> rest)
          None -> rest)
        other -> rest)
    other -> tail

  field-labels :: Json -> List String
  field-labels rows = case rows of JArr (JStr label) rest -> label : (field-labels rest); other -> []

  -- Field names count erased parameters in source order. A private imported
  -- constructor can only disclose its slot through the checked ABI row.
  payload-label :: List String -> Nat -> UType -> String
  payload-label labels ordinal ty = case ty of
    UProofFun predicate effects result -> payload-label (case labels of first : rest -> rest; [] -> []) (ordinal + 1) result
    other -> (case labels of label : rest -> label; [] -> (case other of
      UPi id name domain effects result -> name
      other -> "$f" <> nat-to-string ordinal))
  layout-label :: List String -> Option Json -> CoreData -> String
  layout-label labels published d = case core-data-constructors d of
    [ctor] -> payload-label labels 0 (scheme-body (ctor.constructor-scheme))
    other -> (case published of
      Some row -> (case field "fields" row of JArr entry JArrEnd -> (case field "name" entry of JStr name -> name; other -> ""); other -> "")
      None -> "")

  requested :: String -> List Request -> Option Request
  requested name layouts = case layouts of
    [] -> None
    (Request site owner repr label published) : rest -> if name == owner then Some (Request site owner repr label published) else requested name rest
  data-for :: String -> List CoreData -> Option CoreData
  data-for name datas = case datas of
    [] -> None
    d : rest -> if name == core-data-name d then Some d else data-for name rest
  private-payload :: String -> List UsageShape -> Option UType
  private-payload owner shapes = case shapes of
    [] -> None
    shape : rest -> if owner == shape.name then usage-single-field shape else private-payload owner rest
  represented-field :: CoreData -> List UsageShape -> Option UType
  represented-field d shapes = case core-data-constructors d of
    [constructor] -> (case core-constructor-fields constructor of [payload] -> Some payload; other -> None)
    [] -> private-payload (core-data-name d) shapes
    other -> None
  member :: String -> List String -> Bool
  member name names = case names of [] -> False; first : rest -> name == first || member name rest
  head-name :: UType -> Option String
  head-name ty = case ty of UCon name kind -> Some name; UApp f a -> head-name f; other -> None

  scalar-layout :: Nat -> String -> Option (Nat, Nat, Nat)
  scalar-layout word-bits name =
    let ptr-bytes = if word-bits == 32 then 4 else 8 in
    if name == "Unit" then Some (0, 0, 1)
    else if member name ["Bool", "I8", "U8"] then Some (0, 1, 1)
    else if member name ["I16", "U16"] then Some (0, 2, 2)
    else if member name ["I32", "U32", "F32", "Char"] then Some (0, 4, 4)
    else if member name ["Usize", "Isize"] then Some (0, ptr-bytes, ptr-bytes)
    else if member name ["I64", "U64", "F64", "Sym"] then Some (0, 8, 8)
    else if member name ["Int", "Nat"] then Some (2, 8, 8)
    else if name == "Bytes" then Some (1, 8, 8)
    else None

  physical-layout :: Nat -> List Request -> List String -> List CoreData -> List UsageShape -> List String -> CoreData -> Result String (Nat, Nat, Nat)
  physical-layout word-bits layouts autos datas shapes seen d = let owner = core-data-name d in
    if member owner seen then Err "repr(unboxed) has a recursive layout" else case represented-field d shapes of
      None -> Err "repr(unboxed) requires one constructor with exactly one represented field"
      Some payload -> (case head-name payload of
        Some name -> (case scalar-layout word-bits name of
          Some physical -> Ok physical
          None -> (case (requested name layouts, data-for name datas) of
            (Some (Request at wrapper repr labels row), Some nested) | (repr == "unboxed") -> physical-layout word-bits layouts autos datas shapes (owner : seen) nested
            (Some (Request at wrapper repr labels row), Some nested) | (repr == "niche") ->
              (case niche-layout word-bits layouts autos datas shapes (owner : seen) nested of
                Ok (word, ctors, dom) -> Ok (word, 8, 8)
                Err msg -> Err msg)
            (None, Some nested) | member name autos ->
              (case niche-layout word-bits layouts autos datas shapes (owner : seen) nested of
                Ok (word, ctors, dom) -> Ok (word, 8, 8)
                Err msg -> Err "repr(unboxed) requires a fixed single-word payload")
            other -> Err "repr(unboxed) requires a fixed single-word payload"))
        None -> Err "repr(unboxed) requires a fixed single-word payload")

  -- Boundary wrappers keep their heap object. Their payload has the single
  -- field's physical width, including a zero-byte Unit field.
  transparent-layout :: Nat -> CoreData -> List UsageShape -> Result String (Nat, Nat, Nat)
  transparent-layout word-bits d shapes = case represented-field d shapes of
    None -> Err "repr(transparent) needs exactly one represented field"
    Some payload -> (case head-name payload of
      Some name -> (case scalar-layout word-bits name of
        Some physical -> Ok physical
        None -> if member name ["I128", "U128"] then Ok (3, 16, 16)
          else Err "repr(transparent) field needs a known boundary layout")
      None -> Err "repr(transparent) field needs a fixed layout")

  matches-published :: Json -> String -> Nat -> Nat -> Bool
  matches-published row label size alignment = case (field "size" row, field "align" row, field "fields" row) of
    (JNum bytes, JNum align, JArr entry JArrEnd) -> bytes == nat-to-int size && align == nat-to-int alignment &&
      (case (field "name" entry, field "offset" entry, field "size" entry, field "align" entry) of
        (JStr name, JNum offset, JNum width, JNum natural) -> name == label && offset == 0 && width == bytes && natural == align
        other -> False)
    other -> False

  matches-niche-published :: Json -> Bool
  matches-niche-published row = case (field "size" row, field "align" row) of
    (JNum bytes, JNum align) -> bytes == 8 && align == 8
    other -> False

  data NicheDomain where
    NicheSigned :: Int -> Int -> List Int -> NicheDomain
    NicheUnsigned :: Int -> Int -> List Int -> NicheDomain
    NicheOddImm :: List Int -> NicheDomain
    NicheNonNullObj :: List Int -> NicheDomain
    NicheTaggedObj :: List Int -> Bool -> List Int -> Bool -> NicheDomain
    NicheNonZeroTObj :: List Int -> NicheDomain
    NicheF64Nan :: List Int -> NicheDomain

  int-member :: Int -> List Int -> Bool
  int-member x xs = case xs of
    [] -> False
    first : rest -> x == first || int-member x rest

  int-insert-sorted :: Int -> List Int -> List Int
  int-insert-sorted x xs = case xs of
    [] -> [x]
    first : rest -> if x == first then xs else if x < first then x : xs else first : (int-insert-sorted x rest)

  int-merge-sorted :: List Int -> List Int -> List Int
  int-merge-sorted xs acc = case xs of
    [] -> acc
    first : rest -> int-merge-sorted rest (int-insert-sorted first acc)

  int-filter-range :: Int -> Int -> List Int -> List Int
  int-filter-range lo hi xs = case xs of
    [] -> []
    first : rest -> if first >= lo && first <= hi then first : (int-filter-range lo hi rest) else int-filter-range lo hi rest

  niche-index-const :: IndexTerm -> Option Int
  niche-index-const term = case term of
    IInteger n -> Some n
    IAdd a b -> (case (niche-index-const a, niche-index-const b) of (Some x, Some y) -> Some (x + y); other -> None)
    ISubtract a b -> (case (niche-index-const a, niche-index-const b) of (Some x, Some y) -> Some (x - y); other -> None)
    IMultiply a b -> (case (niche-index-const a, niche-index-const b) of (Some x, Some y) -> Some (x * y); other -> None)
    other -> None

  niche-int-const :: UType -> Option Int
  niche-int-const t = case t of
    UIndex carrier term -> niche-index-const term
    UIndexForget inner -> niche-int-const inner
    UIndexPromote inner -> niche-int-const inner
    UIndexMath op left right -> (case (niche-int-const left, niche-int-const right) of
      (Some a, Some b) ->
        if op == "+" then Some (a + b)
        else if op == "-" then Some (a - b)
        else if op == "*" then Some (a * b)
        else None
      other -> None)
    other -> None

  niche-is-binder :: Nat -> UType -> Bool
  niche-is-binder id t = case t of
    UBound bid name kind -> bid == id
    UIndex carrier (IBound bid name) -> bid == id
    UIndexForget inner -> niche-is-binder id inner
    UIndexPromote inner -> niche-is-binder id inner
    other -> False

  niche-merge-lo :: Option Int -> Option Int -> Option Int
  niche-merge-lo a b = case (a, b) of
    (None, x) -> x
    (x, None) -> x
    (Some x, Some y) -> Some (if x > y then x else y)

  niche-merge-hi :: Option Int -> Option Int -> Option Int
  niche-merge-hi a b = case (a, b) of
    (None, x) -> x
    (x, None) -> x
    (Some x, Some y) -> Some (if x < y then x else y)

  niche-pred-bounds :: Nat -> UType -> (Option Int, Option Int)
  niche-pred-bounds id pred = case pred of
    UPropAnd a b -> case (niche-pred-bounds id a, niche-pred-bounds id b) of
      ((la, ha), (lb, hb)) -> (niche-merge-lo la lb, niche-merge-hi ha hb)
    UCompare op left right ->
      if niche-is-binder id left then
        (case niche-int-const right of
          Some k ->
            if op == "<" then (None, Some (k - 1))
            else if op == "<=" then (None, Some k)
            else if op == ">" then (Some (k + 1), None)
            else if op == ">=" then (Some k, None)
            else if op == "==" || op == "Eq" then (Some k, Some k)
            else (None, None)
          None -> (None, None))
      else if niche-is-binder id right then
        (case niche-int-const left of
          Some k ->
            if op == "<" then (Some (k + 1), None)
            else if op == "<=" then (Some k, None)
            else if op == ">" then (None, Some (k - 1))
            else if op == ">=" then (None, Some k)
            else if op == "==" || op == "Eq" then (Some k, Some k)
            else (None, None)
          None -> (None, None))
      else (None, None)
    other -> (None, None)

  niche-pred-exclusions :: Nat -> UType -> List Int
  niche-pred-exclusions id pred = case pred of
    UPropAnd a b -> int-merge-sorted (niche-pred-exclusions id a) (niche-pred-exclusions id b)
    UPropNonZero x -> if niche-is-binder id x then [0] else []
    UPropNonZeroPending x -> if niche-is-binder id x then [0] else []
    UCompare op left right | op == "/=" || op == "!=" || op == "Ne" ->
      if niche-is-binder id left then (case niche-int-const right of Some k -> [k]; None -> [])
      else if niche-is-binder id right then (case niche-int-const left of Some k -> [k]; None -> [])
      else []
    UPropNot (UCompare op left right) | op == "==" || op == "Eq" ->
      if niche-is-binder id left then (case niche-int-const right of Some k -> [k]; None -> [])
      else if niche-is-binder id right then (case niche-int-const left of Some k -> [k]; None -> [])
      else []
    other -> []

  niche-fits-immediate :: Nat -> UType -> Nat -> UType -> Bool
  niche-fits-immediate word-bits carrier id pred =
    let wasm32 = word-bits <= 32 in
    case head-name carrier of
      Some "Nat" ->
        let max-nat = if wasm32 then (2147483647 :: Int) else (4611686018427387903 :: Int) in
        (case niche-pred-bounds id pred of (lo, Some hi) -> hi <= max-nat; other -> False)
      Some "Int" ->
        let max-int = if wasm32 then (1073741823 :: Int) else (4611686018427387903 :: Int) in
        let min-int = 0 - max-int in
        (case niche-pred-bounds id pred of (Some lo, Some hi) -> lo >= min-int && hi <= max-int; other -> False)
      other -> False

  apply-niche-refinement :: Option Int -> Option Int -> List Int -> NicheDomain -> NicheDomain
  apply-niche-refinement plo phi pexcl dom = case dom of
    NicheSigned lo hi excl ->
      let lo1 = (case plo of Some l -> if l > lo then l else lo; None -> lo) in
      let hi1 = (case phi of Some h -> if h < hi then h else hi; None -> hi) in
      NicheSigned lo1 hi1 (int-filter-range lo1 hi1 (int-merge-sorted pexcl excl))
    NicheUnsigned lo hi excl ->
      let lo1 = (case plo of Some l -> if l > lo then l else lo; None -> lo) in
      let hi1 = (case phi of Some h -> if h < 0 then 0 else if h < hi then h else hi; None -> hi) in
      let lo2 = (case phi of Some h -> if h < 0 then 1 else lo1; None -> lo1) in
      NicheUnsigned lo2 hi1 (int-filter-range lo2 hi1 (int-merge-sorted pexcl excl))
    other -> other

  scalar-niche-domain :: Nat -> String -> Option NicheDomain
  scalar-niche-domain word-bits name =
    let isize-min = if word-bits <= 32 then (0 - 2147483648) else (0 - 9223372036854775808) in
    let isize-max = if word-bits <= 32 then (2147483647 :: Int) else (9223372036854775807 :: Int) in
    let usize-max = if word-bits <= 32 then (4294967295 :: Int) else (18446744073709551615 :: Int) in
    if name == "Unit" then Some (NicheUnsigned 0 0 [])
    else if name == "Bool" then Some (NicheUnsigned 0 1 [])
    else if name == "I8" then Some (NicheSigned (0 - 128) 127 [])
    else if name == "I16" then Some (NicheSigned (0 - 32768) 32767 [])
    else if name == "I32" then Some (NicheSigned (0 - 2147483648) 2147483647 [])
    else if name == "I64" then Some (NicheSigned (0 - 9223372036854775808) 9223372036854775807 [])
    else if name == "Isize" then Some (NicheSigned isize-min isize-max [])
    else if name == "U8" then Some (NicheUnsigned 0 255 [])
    else if name == "U16" then Some (NicheUnsigned 0 65535 [])
    else if name == "U32" then Some (NicheUnsigned 0 4294967295 [])
    else if name == "U64" then Some (NicheUnsigned 0 18446744073709551615 [])
    else if name == "Usize" then Some (NicheUnsigned 0 usize-max [])
    else if name == "Char" then Some (NicheUnsigned 0 1114111 [])
    else if name == "F32" then Some (NicheUnsigned 0 4294967295 [])
    else if name == "F64" then Some (NicheF64Nan [])
    else if name == "Nat" || name == "Int" then Some (NicheNonZeroTObj [])
    else if name == "Bytes" || name == "String" then Some (NicheNonNullObj [])
    else None

  extract-niche-domain :: Nat -> List Request -> List String -> List CoreData -> List UsageShape -> List String -> UType -> Result String NicheDomain
  extract-niche-domain word-bits layouts autos datas shapes seen ty =
    case borrow-type-parts ty of
      Some (is-mut, reg, inner) -> if is-mut then Ok (NicheNonNullObj []) else extract-niche-domain word-bits layouts autos datas shapes seen inner
      None -> case refinement-view ty of
        URefine id name carrier pred ->
          if niche-fits-immediate word-bits carrier id pred then Ok (NicheOddImm [])
          else (case extract-niche-domain word-bits layouts autos datas shapes seen carrier of
            Err msg -> Err msg
            Ok dom ->
              let (plo, phi) = niche-pred-bounds id pred in
              let pexcl = niche-pred-exclusions id pred in
              Ok (apply-niche-refinement plo phi pexcl dom))
        URequire req body -> extract-niche-domain word-bits layouts autos datas shapes seen body
        other -> case ty of
          UTuple _ -> Ok (NicheNonNullObj [])
          USigma _ _ _ _ -> Ok (NicheNonNullObj [])
          UFun _ _ -> Ok (NicheNonNullObj [])
          UFunEff _ _ _ -> Ok (NicheNonNullObj [])
          UUsageArrow _ _ -> Ok (NicheNonNullObj [])
          UPi _ _ _ _ _ -> Ok (NicheNonNullObj [])
          UBound _ _ _ -> Err "repr(niche) requires a concrete single-word payload type"
          URigid _ _ _ _ -> Err "repr(niche) requires a concrete single-word payload type"
          UMeta _ _ -> Err "repr(niche) requires a concrete single-word payload type"
          _ -> if foreign-pointer ty then Err "repr(niche) cannot derive a niche from an opaque type"
            else case head-name ty of
              Some name ->
                if member name ["I128", "U128", "Sym"] then
                  Err "repr(niche) payload must be a single-word integer, float, refinement, pointer, or boxed value"
                else (case scalar-niche-domain word-bits name of
                  Some dom -> Ok dom
                  None -> if member name seen then Err "repr(niche) has a recursive layout"
                    else (case (requested name layouts, data-for name datas) of
                      (Some (Request at wrapper repr labels row), Some nested) | repr == "niche" ->
                        (case niche-layout word-bits layouts autos datas shapes seen nested of
                          Ok (w, ctors, dom) -> Ok dom
                          Err msg -> Err msg)
                      (Some (Request at wrapper repr labels row), Some nested) | repr == "poly-niche" ->
                        Err "repr(niche) payload is a polymorphic niche sum"
                      (Some (Request at wrapper repr labels row), Some nested) | repr == "unboxed" ->
                        (case represented-field nested shapes of
                          Some inner -> extract-niche-domain word-bits layouts autos datas shapes seen inner
                          None -> Err "repr(unboxed) requires one constructor with exactly one represented field")
                      (None, Some nested) | member name autos ->
                        (case niche-layout word-bits layouts autos datas shapes seen nested of
                          Ok (w, ctors, dom) -> Ok dom
                          Err msg -> (case poly-niche-layout word-bits layouts autos datas shapes nested of
                            Some _ -> Err "repr(niche) payload is a polymorphic niche sum"
                            None -> Ok (NicheNonNullObj [])))
                      other -> Ok (NicheNonNullObj [])))
              None -> Err "repr(niche) requires a concrete single-word payload type"

  partition-niche-ctors :: List CoreConstructor -> Result String (List String, List (String, UType))
  partition-niche-ctors ctors = case ctors of
    [] -> Ok ([], [])
    c : rest -> case partition-niche-ctors rest of
      Err msg -> Err msg
      Ok (nulls, pays) -> case core-constructor-fields c of
        [] -> Ok ((c.constructor-name) : nulls, pays)
        [pty] -> Ok (nulls, ((c.constructor-name, pty) : pays))
        other -> Err "repr(niche) constructors may have at most one represented field"

  build-nullary-enum :: Int -> List String -> List NicheCtor
  build-nullary-enum idx names = case names of
    [] -> []
    cname : rest -> (NicheNullary cname idx) : (build-nullary-enum (idx + 1) rest)

  niche-list-len :: forall a. List a -> Nat
  niche-list-len xs = case xs of [] -> 0; _ : rest -> 1 + niche-list-len rest

  alloc-range-sentinels :: Nat -> Int -> Int -> Int -> Int -> List Int -> List Int -> Result String (List Int, Int, Int, List Int)
  alloc-range-sentinels need min-b max-b lo hi excl acc =
    if need == 0 then Ok (acc, lo, hi, excl)
    else case excl of
      ex : more -> alloc-range-sentinels (need - 1) min-b max-b lo hi more (acc <> [ex])
      [] ->
        if lo > min-b then alloc-range-sentinels (need - 1) min-b max-b (lo - 1) hi [] (acc <> [lo - 1])
        else if hi < max-b then alloc-range-sentinels (need - 1) min-b max-b lo (hi + 1) [] (acc <> [hi + 1])
        else Err "repr(niche) cannot find enough unused niche values for nullary constructors"

  alloc-even-sentinels :: Nat -> Int -> List Int -> List Int -> (List Int, List Int)
  alloc-even-sentinels need cand used acc =
    if need == 0 then (acc, used)
    else if int-member cand used then alloc-even-sentinels need (cand + 2) used acc
    else alloc-even-sentinels (need - 1) (cand + 2) (cand : used) (acc <> [cand])

  alloc-obj-sentinels :: Nat -> Int -> List Int -> List Int -> (List Int, List Int)
  alloc-obj-sentinels need next-odd used acc =
    if need == 0 then (acc, used)
    else if not (int-member 0 used) then alloc-obj-sentinels (need - 1) next-odd (0 : used) (acc <> [0])
    else if int-member next-odd used then alloc-obj-sentinels need (next-odd + 2) used acc
    else alloc-obj-sentinels (need - 1) (next-odd + 2) (next-odd : used) (acc <> [next-odd])

  any-nonzero :: List Int -> Bool
  any-nonzero xs = case xs of [] -> False; first : rest -> first /= 0 || any-nonzero rest

  pair-nullaries :: List String -> List Int -> List NicheCtor
  pair-nullaries names sentinels = case (names, sentinels) of
    (n : ns, s : ss) -> (NicheNullary n s) : (pair-nullaries ns ss)
    other -> []

  extract-multi-ranges :: Bool -> Nat -> List Request -> List String -> List CoreData -> List UsageShape -> List String -> List (String, UType) -> Result String (List (String, Int, Int, List Int))
  extract-multi-ranges want-unsigned word-bits layouts autos datas shapes seen pays = case pays of
    [] -> Ok []
    (cname, pty) : rest -> case extract-niche-domain word-bits layouts autos datas shapes seen pty of
      Err msg -> Err msg
      Ok (NicheSigned lo hi excl) | not want-unsigned ->
        (case extract-multi-ranges False word-bits layouts autos datas shapes seen rest of
          Err msg -> Err msg
          Ok more -> Ok ((cname, lo, hi, excl) : more))
      Ok (NicheUnsigned lo hi excl) | want-unsigned ->
        (case extract-multi-ranges True word-bits layouts autos datas shapes seen rest of
          Err msg -> Err msg
          Ok more -> Ok ((cname, lo, hi, excl) : more))
      other -> Err "repr(niche) with multiple payload constructors requires provably disjoint refined integer domains of the same signedness"

  ranges-disjoint-pair :: Int -> Int -> List Int -> Int -> Int -> List Int -> Bool
  ranges-disjoint-pair lo1 hi1 ex1 lo2 hi2 ex2 =
    hi1 < lo2 || hi2 < lo1 || (lo1 == hi1 && int-member lo1 ex2) || (lo2 == hi2 && int-member lo2 ex1)

  all-disjoint-against :: Int -> Int -> List Int -> List (String, Int, Int, List Int) -> Bool
  all-disjoint-against lo1 hi1 ex1 rest = case rest of
    [] -> True
    (cn, lo2, hi2, ex2) : more -> ranges-disjoint-pair lo1 hi1 ex1 lo2 hi2 ex2 && all-disjoint-against lo1 hi1 ex1 more

  check-all-disjoint :: List (String, Int, Int, List Int) -> Bool
  check-all-disjoint arms = case arms of
    [] -> True
    (cn, lo, hi, ex) : rest -> all-disjoint-against lo hi ex rest && check-all-disjoint rest

  insert-interval :: (Int, Int) -> List (Int, Int) -> List (Int, Int)
  insert-interval iv ivs = case ivs of
    [] -> [iv]
    (l2, h2) : rest -> case iv of
      (l1, h1) -> if l1 <= l2 then iv : ivs else (l2, h2) : (insert-interval iv rest)

  sort-intervals :: List (String, Int, Int, List Int) -> List (Int, Int)
  sort-intervals arms = case arms of
    [] -> []
    (cn, lo, hi, ex) : rest -> insert-interval (lo, hi) (sort-intervals rest)

  take-gap-values :: Nat -> Int -> Int -> List Int -> (Nat, List Int)
  take-gap-values need cur limit acc =
    if need == 0 || cur >= limit then (need, acc)
    else take-gap-values (need - 1) (cur + 1) limit (acc <> [cur])

  alloc-from-gaps :: Nat -> List (Int, Int) -> List Int -> (Nat, List Int)
  alloc-from-gaps need ivs acc = case ivs of
    (l1, h1) : (l2, h2) : rest ->
      if need == 0 then (0, acc)
      else case take-gap-values need (h1 + 1) l2 acc of
        (rem, next) -> alloc-from-gaps rem ((l2, h2) : rest) next
    other -> (need, acc)

  last-hi :: Int -> List (Int, Int) -> Int
  last-hi cur ivs = case ivs of [] -> cur; (l, h) : rest -> last-hi (if h > cur then h else cur) rest

  make-multi-payloads :: Bool -> List (String, Int, Int, List Int) -> List NicheCtor
  make-multi-payloads unsigned arms = case arms of
    [] -> []
    (cn, lo, hi, ex) : rest -> (NichePayload cn True unsigned lo hi ex) : (make-multi-payloads unsigned rest)

  pow2-int :: Nat -> Int
  pow2-int n = if n == 0 then 1 else 2 * pow2-int (n - 1)

  bits-for-span-go :: Int -> Nat -> Int -> Nat
  bits-for-span-go span k bound =
    if bound > span || k >= 60 then k
    else bits-for-span-go span (k + 1) (bound * 2)

  bits-for-span :: Int -> Nat
  bits-for-span span = if span <= 0 then 0 else bits-for-span-go span 0 1

  bits-for-count :: Nat -> Nat
  bits-for-count count = if count <= 1 then 0 else bits-for-span (nat-to-int (count - 1))

  niche-small-raw :: NicheDomain -> Option (Nat, Bool, Int)
  niche-small-raw dom = case dom of
    NicheUnsigned lo hi excl | lo <= hi ->
      let span = hi - lo in
      if span < pow2-int 60 then
        let bits = bits-for-span span in
        if lo == 0 then Some (bits, False, 0)
        else if lo <= 9223372036854775807 then Some (bits, False, lo)
        else None
      else None
    NicheSigned lo hi excl | lo <= hi ->
      let half = pow2-int 59 in
      if lo >= (0 - half) && hi < half then
        let need-pos = if hi > 0 then bits-for-span hi else 0 in
        let need-neg = if lo < 0 then bits-for-span ((0 - lo) - 1) else 0 in
        let bits = (if need-pos > need-neg then need-pos else need-neg) + 1 in
        if bits <= 60 then Some (bits, True, 0) else None
      else
        let span = hi - lo in
        if span < pow2-int 60 && lo >= (0 - 9223372036854775808) && lo <= 9223372036854775807 then
          Some (bits-for-span span, False, lo)
        else None
    other -> None

  alloc-tagged-sentinels :: Nat -> Bool -> Int -> List Int -> Bool -> List Int -> Result String (List Int, Bool, List Int)
  alloc-tagged-sentinels need used-null next-odd used-odd odd-full acc =
    if need == 0 then Ok (acc, used-null, used-odd)
    else if not used-null then alloc-tagged-sentinels (need - 1) True next-odd used-odd odd-full (acc <> [0])
    else if odd-full then Err "repr(niche) cannot find enough unused niche values for nullary constructors"
    else if int-member next-odd used-odd then alloc-tagged-sentinels need used-null (next-odd + 2) used-odd odd-full acc
    else alloc-tagged-sentinels (need - 1) used-null (next-odd + 2) (next-odd : used-odd) odd-full (acc <> [next-odd])

  alloc-nan-sentinels :: Nat -> Int -> List Int -> List Int -> (List Int, List Int)
  alloc-nan-sentinels need cand used acc =
    if need == 0 then (acc, used)
    else if int-member cand used then alloc-nan-sentinels need (cand + 1) used acc
    else alloc-nan-sentinels (need - 1) (cand + 1) (cand : used) (acc <> [cand])

  extract-all-domains :: Nat -> List Request -> List String -> List CoreData -> List UsageShape -> List String -> List (String, UType) -> Result String (List (String, UType, NicheDomain))
  extract-all-domains word-bits layouts autos datas shapes seen pays = case pays of
    [] -> Ok []
    (cname, pty) : rest -> case extract-niche-domain word-bits layouts autos datas shapes seen pty of
      Err msg -> Err msg
      Ok dom -> (case extract-all-domains word-bits layouts autos datas shapes seen rest of
        Err msg -> Err msg
        Ok more -> Ok ((cname, pty, dom) : more))

  all-signed-arms :: List (String, UType, NicheDomain) -> Option (List (String, Int, Int, List Int))
  all-signed-arms arms = case arms of
    [] -> Some []
    (cn, pty, NicheSigned lo hi ex) : rest -> (case all-signed-arms rest of
      Some more -> Some ((cn, lo, hi, ex) : more)
      None -> None)
    other -> None

  all-unsigned-arms :: List (String, UType, NicheDomain) -> Option (List (String, Int, Int, List Int))
  all-unsigned-arms arms = case arms of
    [] -> Some []
    (cn, pty, NicheUnsigned lo hi ex) : rest -> (case all-unsigned-arms rest of
      Some more -> Some ((cn, lo, hi, ex) : more)
      None -> None)
    other -> None

  partition-mixed-arms :: List (String, UType, NicheDomain) -> Option (List String, List (String, Nat, Bool, Int))
  partition-mixed-arms arms = case arms of
    [] -> Some ([], [])
    (cn, pty, dom) : rest -> (case partition-mixed-arms rest of
      None -> None
      Some (ptrs, smalls) -> (case dom of
        NicheNonNullObj [] -> Some (cn : ptrs, smalls)
        other -> (case niche-small-raw dom of
          Some (bits, signed, bias) -> Some (ptrs, (cn, bits, signed, bias) : smalls)
          None -> None)))

  ctor-short-name-chars :: List Char -> List Char -> List Char
  ctor-short-name-chars chars acc = case chars of
    [] -> acc
    ch : rest -> if char-code ch == 46 then ctor-short-name-chars rest [] else ctor-short-name-chars rest (acc <> [ch])

  is-hot-ctor-name :: String -> Bool
  is-hot-ctor-name name =
    let short = pack (ctor-short-name-chars (unpack name) []) in
    short == "Ok" || short == "Right" || short == "Some" || short == "Found" || short == "Good" || short == "Just"

  hoist-hot-ptr :: List String -> List String -> Option (String, List String)
  hoist-hot-ptr before rest = case rest of
    [] -> None
    cn : more -> if is-hot-ctor-name cn then Some (cn, before <> more) else hoist-hot-ptr (before <> [cn]) more

  order-ptr-arms :: List String -> List String
  order-ptr-arms ptrs = case ptrs of
    [] -> []
    first : rest -> if is-hot-ctor-name first then ptrs else (case hoist-hot-ptr [first] rest of
      Some (hot, others) -> hot : others
      None -> ptrs)

  make-ptr-ctors :: Bool -> Int -> List String -> (List NicheCtor, List Int)
  make-ptr-ctors used-null next-tag names = case names of
    [] -> ([], [])
    cn : rest -> case make-ptr-ctors used-null (next-tag + 2) rest of
      (ctors, tags) -> ((NichePtr cn next-tag (next-tag == 0 && used-null)) : ctors, next-tag : tags)

  all-fit-shift :: Nat -> List (String, Nat, Bool, Int) -> Bool
  all-fit-shift shift arms = case arms of
    [] -> True
    (cn, bits, signed, bias) : rest -> bits + shift <= 64 && all-fit-shift shift rest

  max-small-bits :: Nat -> List (String, Nat, Bool, Int) -> Nat
  max-small-bits cur arms = case arms of
    [] -> cur
    (cn, bits, signed, bias) : rest -> max-small-bits (if bits > cur then bits else cur) rest

  any-small-signed :: List (String, Nat, Bool, Int) -> Bool
  any-small-signed arms = case arms of
    [] -> False
    (cn, bits, signed, bias) : rest -> signed || any-small-signed rest

  make-odd-shifted-ctors :: Int -> Nat -> Int -> List (String, Nat, Bool, Int) -> List NicheCtor
  make-odd-shifted-ctors mask shift idx arms = case arms of
    [] -> []
    (cn, bits, signed, bias) : rest ->
      (NicheShifted cn mask (idx * 2 + 1) shift signed bias) : (make-odd-shifted-ctors mask shift (idx + 1) rest)

  make-odd-rem-nulls :: Int -> List String -> List NicheCtor
  make-odd-rem-nulls top-idx names = case names of
    [] -> []
    cn : rest -> (NicheNullary cn (top-idx * 2 + 1)) : (make-odd-rem-nulls (top-idx - 1) rest)

  make-raw-shifted-ctors :: Int -> Nat -> Int -> List (String, Nat, Bool, Int) -> List NicheCtor
  make-raw-shifted-ctors mask shift idx arms = case arms of
    [] -> []
    (cn, bits, signed, bias) : rest ->
      (NicheShifted cn mask idx shift signed bias) : (make-raw-shifted-ctors mask shift (idx + 1) rest)

  make-raw-nulls :: Int -> List String -> List NicheCtor
  make-raw-nulls idx names = case names of
    [] -> []
    cn : rest -> (NicheNullary cn idx) : (make-raw-nulls (idx + 1) rest)

  niche-layout :: Nat -> List Request -> List String -> List CoreData -> List UsageShape -> List String -> CoreData -> Result String (Nat, List NicheCtor, NicheDomain)
  niche-layout word-bits layouts autos datas shapes seen d =
    let owner = core-data-name d in
    if member owner seen then Err "repr(niche) has a recursive layout"
    else case core-data-constructors d of
      [] -> Err "repr(niche) requires at least one constructor"
      ctors -> case partition-niche-ctors ctors of
        Err msg -> Err msg
        Ok (nulls, pays) -> case pays of
          [] ->
            let n = niche-list-len nulls in
            let hi = if n == 0 then (0 :: Int) else nat-to-int (n - 1) in
            Ok (0, build-nullary-enum 0 nulls, NicheUnsigned 0 hi [])
          [(pname, pty)] ->
            (case extract-niche-domain word-bits layouts autos datas shapes (owner : seen) pty of
              Err msg -> Err msg
              Ok dom ->
                let n = niche-list-len nulls in
                case dom of
                  NicheSigned lo hi excl ->
                    (case alloc-range-sentinels n (0 - 9223372036854775808) 9223372036854775807 lo hi excl [] of
                      Err msg -> Err msg
                      Ok (sents, lo1, hi1, excl1) ->
                        Ok (0, pair-nullaries nulls sents <> [NichePayload pname False False 0 0 []], NicheSigned lo1 hi1 excl1))
                  NicheUnsigned lo hi excl ->
                    (case alloc-range-sentinels n 0 18446744073709551615 lo hi excl [] of
                      Err msg -> Err msg
                      Ok (sents, lo1, hi1, excl1) ->
                        Ok (0, pair-nullaries nulls sents <> [NichePayload pname False True 0 0 []], NicheUnsigned lo1 hi1 excl1))
                  NicheOddImm used ->
                    let (sents, used1) = alloc-even-sentinels n 0 used [] in
                    Ok (0, pair-nullaries nulls sents <> [NichePayload pname False False 0 0 []], NicheOddImm used1)
                  NicheNonNullObj used ->
                    let (sents, used1) = alloc-obj-sentinels n 1 used [] in
                    let carrier = if any-nonzero used1 then (2 :: Nat) else 1 in
                    Ok (carrier, pair-nullaries nulls sents <> [NichePayload pname False False 0 0 []], NicheNonNullObj used1)
                  NicheTaggedObj ptags used-null used-odd odd-full ->
                    (case alloc-tagged-sentinels n used-null 1 used-odd odd-full [] of
                      Err msg -> Err msg
                      Ok (sents, used-null1, used-odd1) ->
                        Ok (2, pair-nullaries nulls sents <> [NichePayload pname False False 0 0 []], NicheTaggedObj ptags used-null1 used-odd1 odd-full))
                  NicheNonZeroTObj used ->
                    if n == 0 then Ok (2, [NichePayload pname False False 0 0 []], NicheNonZeroTObj used)
                    else if n == 1 && not (int-member 0 used) then
                      Ok (2, pair-nullaries nulls [0] <> [NichePayload pname False False 0 0 []], NicheNonZeroTObj (0 : used))
                    else Err "repr(niche) cannot find enough unused niche values for nullary constructors"
                  NicheF64Nan used ->
                    let (sents, used1) = alloc-nan-sentinels n 9221120237041090561 used [] in
                    let pctor = (case used of [] -> NicheNanF64 pname; _ -> NichePayload pname False False 0 0 []) in
                    Ok (0, pair-nullaries nulls sents <> [pctor], NicheF64Nan used1))
          (p1name, p1ty) : more-pays ->
            (case extract-all-domains word-bits layouts autos datas shapes (owner : seen) pays of
              Err msg -> Err msg
              Ok arm-doms ->
                let try-disjoint = (\unsigned min-b max-b arms ->
                      if not (check-all-disjoint arms) then None
                      else
                        let ivs = sort-intervals arms in
                        let min-lo = (case ivs of (l, h) : _ -> l; [] -> 0) in
                        let max-hi = last-hi min-lo ivs in
                        let (rem, gap-sents) = alloc-from-gaps (niche-list-len nulls) ivs [] in
                        (case alloc-range-sentinels rem min-b max-b min-lo max-hi [] gap-sents of
                          Err _ -> None
                          Ok (sents, lo1, hi1, _) ->
                            let occ = if unsigned then NicheUnsigned lo1 hi1 [] else NicheSigned lo1 hi1 [] in
                            Some (0, pair-nullaries nulls sents <> make-multi-payloads unsigned arms, occ))) in
                let disjoint-res = (case all-signed-arms arm-doms of
                      Some sarms -> try-disjoint False (0 - 9223372036854775808) 9223372036854775807 sarms
                      None -> (case all-unsigned-arms arm-doms of
                        Some uarms -> try-disjoint True 0 18446744073709551615 uarms
                        None -> None)) in
                case disjoint-res of
                  Some ok-plan -> Ok ok-plan
                  None -> (case partition-mixed-arms arm-doms of
                    None -> Err "repr(niche) payload constructors must have provably disjoint value domains or fit in tagged single-word layout"
                    Some (ptrs, smalls) ->
                      let n-ptrs = niche-list-len ptrs in
                      if n-ptrs >= 1 && n-ptrs <= 3 then
                        let ordered-ptrs = order-ptr-arms ptrs in
                        (case smalls of
                          [] ->
                            let (sents, used1) = alloc-obj-sentinels (niche-list-len nulls) 1 [] [] in
                            let used-null = int-member 0 used1 in
                            let (ptr-ctors, ptags) = make-ptr-ctors used-null 0 ordered-ptrs in
                            Ok (2, pair-nullaries nulls sents <> ptr-ctors, NicheTaggedObj ptags used-null used1 False)
                          _ ->
                            let (used-null, null0-ctors, rem-nulls) = (case nulls of
                                  [] -> (False, [], [])
                                  n0 : more-n -> (True, [NicheNullary n0 0], more-n)) in
                            let n-odd = niche-list-len smalls + niche-list-len rem-nulls in
                            let subtag-bits = bits-for-count n-odd in
                            let shift = 1 + subtag-bits in
                            if all-fit-shift shift smalls then
                              let mask = pow2-int shift - 1 in
                              let small-ctors = make-odd-shifted-ctors mask shift 0 smalls in
                              let rem-null-ctors = (if n-odd == 0 then [] else make-odd-rem-nulls (nat-to-int (n-odd - 1)) rem-nulls) in
                              let (ptr-ctors, ptags) = make-ptr-ctors used-null 0 ordered-ptrs in
                              Ok (2, null0-ctors <> rem-null-ctors <> small-ctors <> ptr-ctors, NicheTaggedObj ptags used-null [] True)
                            else Err "repr(niche) payload constructors must have provably disjoint value domains or fit in tagged single-word layout")
                      else if n-ptrs == 0 && niche-list-len smalls >= 1 then
                        let total = niche-list-len smalls + niche-list-len nulls in
                        let tb0 = bits-for-count total in
                        let tag-bits = if tb0 == 0 then 1 else tb0 in
                        let max-b = max-small-bits 0 smalls in
                        if max-b + tag-bits <= 64 then
                          let mask = pow2-int tag-bits - 1 in
                          let small-ctors = make-raw-shifted-ctors mask tag-bits 0 smalls in
                          let null-ctors = make-raw-nulls (nat-to-int (niche-list-len smalls)) nulls in
                          let total-bits = max-b + tag-bits in
                          let occ = (if not (any-small-signed smalls) && total-bits < 64
                                then NicheUnsigned 0 (pow2-int total-bits - 1) []
                                else NicheSigned (0 - 9223372036854775808) 9223372036854775807 []) in
                          Ok (0, null-ctors <> small-ctors, occ)
                        else Err "repr(niche) payload constructors must have provably disjoint value domains or fit in tagged single-word layout"
                      else Err "repr(niche) payload constructors must have provably disjoint value domains or fit in tagged single-word layout"))

  is-builtin-data-name :: String -> Bool
  is-builtin-data-name name = case unpack name of
    c1 : c2 : rest -> char-code c1 == 98 && char-code c2 == 46
    other -> False

  surface-export-symbols :: Json -> List String -> List String
  surface-export-symbols rows acc = case rows of
    JArr row rest -> (case field "symbol" row of
      JStr sym -> surface-export-symbols rest (sym : acc)
      other -> surface-export-symbols rest acc)
    other -> acc

  source-exported-symbols :: List Decl -> List String -> List String
  source-exported-symbols ds acc = case ds of
    [] -> acc
    (DSource sp name doc) : rest ->
      source-exported-symbols rest (surface-export-symbols (field "exports" doc) acc)
    other : rest -> source-exported-symbols rest acc

  all-ctors-exported :: List CoreConstructor -> List String -> Bool
  all-ctors-exported ctors exported = case ctors of
    [] -> True
    c : rest -> member (c.constructor-name) exported && all-ctors-exported rest exported

  all-ktype-quants :: List Quant -> Bool
  all-ktype-quants qs = case qs of
    [] -> True
    q : rest -> (case q.kind of KType -> all-ktype-quants rest; other -> False)

  ctor-result-ty :: UType -> UType
  ctor-result-ty ty = case ty of
    UFun a b -> ctor-result-ty b
    UFunEff a r b -> ctor-result-ty b
    UPi id n a r b -> ctor-result-ty b
    UProofFun p r b -> ctor-result-ty b
    URequire p b -> ctor-result-ty b
    other -> ty

  result-args-are-ktype-vars :: String -> UType -> Nat -> Bool
  result-args-are-ktype-vars owner ty seen-args = case ty of
    UCon name kind -> name == owner && seen-args == 0
    UApp f a -> (case a of
      UBound id n KType -> if seen-args == 0 then False else result-args-are-ktype-vars owner f (seen-args - 1)
      other -> False)
    other -> False

  all-regular-ctors :: String -> Nat -> List CoreConstructor -> Bool
  all-regular-ctors owner arity ctors = case ctors of
    [] -> True
    c : rest ->
      let sc = c.constructor-scheme in
      let qs = scheme-params sc in
      niche-list-len qs <= arity
        && all-ktype-quants qs
        && result-args-are-ktype-vars owner (ctor-result-ty (scheme-body sc)) arity
        && all-regular-ctors owner arity rest

  auto-niche-candidates :: List Decl -> List Request -> List CoreData -> List String -> List String
  auto-niche-candidates ds layouts datas exported = case ds of
    [] -> []
    (DData sp name params ctors) : rest ->
      let more = auto-niche-candidates rest layouts datas exported in
      if is-builtin-data-name name then more
      else (case requested name layouts of
        Some _ -> more
        None -> (case data-for name datas of
          None -> more
          Some d -> (case core-data-layout d of
            UniformData ->
              let cs = core-data-constructors d in
              let ps = core-data-params d in
              let visible-ok = not (member name exported) || all-ctors-exported cs exported in
              if niche-list-len cs >= 2
                && visible-ok
                && all-ktype-quants ps
                && all-regular-ctors name (niche-list-len ps) cs
              then name : more
              else more
            other -> more)))
    other : rest -> auto-niche-candidates rest layouts datas exported

  check-layouts :: Nat -> List Decl -> List CoreData -> List UsageShape -> Store -> (List CoreData, Store)
  check-layouts word-bits ds datas shapes st =
    let layouts = requests ds in
    let exported = source-exported-symbols ds [] in
    let autos = auto-niche-candidates ds layouts datas exported in
    case (layouts, autos) of
      ([], []) -> (datas, st)
      other -> attach-layouts word-bits layouts autos datas shapes datas st

  nat-member :: Nat -> List Nat -> Bool
  nat-member x xs = case xs of [] -> False; first : rest -> x == first || nat-member x rest

  nat-insert-unique :: Nat -> List Nat -> List Nat
  nat-insert-unique x xs = if nat-member x xs then xs else x : xs

  result-bound-ids :: UType -> List Nat -> Option (List Nat)
  result-bound-ids ty acc = case ty of
    UCon name kind -> Some acc
    UApp f (UBound id n KType) -> result-bound-ids f (id : acc)
    other -> None

  bound-index-in :: Nat -> Nat -> List Nat -> Option Nat
  bound-index-in wanted idx ids = case ids of
    [] -> None
    first : rest -> if first == wanted then Some idx else bound-index-in wanted (idx + 1) rest

  is-core-option-or-result :: String -> Bool
  is-core-option-or-result name =
    name == "i.Data$2eCore$2eOption" || name == "i.Data$2eCore$2eResult"
      || name == "m.Data.Core.Option" || name == "m.Data.Core.Result"

  classify-poly-ctors :: Nat -> List Request -> List String -> List CoreData -> List UsageShape -> String -> List CoreConstructor -> Option (List String, List String, List Nat, Bool)
  classify-poly-ctors word-bits layouts autos datas shapes owner ctors = case ctors of
    [] -> Some ([], [], [], False)
    c : rest -> case classify-poly-ctors word-bits layouts autos datas shapes owner rest of
      None -> None
      Some (nulls, ptrs, req, has-param) ->
        let cname = c.constructor-name in
        case core-constructor-fields c of
          [] -> Some (cname : nulls, ptrs, req, has-param)
          [pty] -> (case pty of
            UBound id n KType -> (case result-bound-ids (ctor-result-ty (scheme-body (c.constructor-scheme))) [] of
              Some rids -> (case bound-index-in id 0 rids of
                Some idx -> Some (nulls, cname : ptrs, nat-insert-unique idx req, True)
                None -> None)
              None -> None)
            other -> (case extract-niche-domain word-bits layouts autos datas shapes [owner] pty of
              Ok (NicheNonNullObj []) -> Some (nulls, cname : ptrs, req, has-param)
              other -> None))
          other -> None

  poly-niche-layout :: Nat -> List Request -> List String -> List CoreData -> List UsageShape -> CoreData -> Option (List Nat, List NicheCtor)
  poly-niche-layout word-bits layouts autos datas shapes d =
    let owner = core-data-name d in
    let ps = core-data-params d in
    let cs = core-data-constructors d in
    if is-core-option-or-result owner || niche-list-len ps == 0 || niche-list-len cs < 2 then None
    else case classify-poly-ctors word-bits layouts autos datas shapes owner cs of
      None -> None
      Some (nulls, ptrs, req, has-param) ->
        let n-ptrs = niche-list-len ptrs in
        if not has-param || n-ptrs == 0 || n-ptrs > 3 then None
        else
          let ordered-ptrs = order-ptr-arms ptrs in
          let (sents, used1) = alloc-obj-sentinels (niche-list-len nulls) 1 [] [] in
          let used-null = int-member 0 used1 in
          let (ptr-ctors, ptags) = make-ptr-ctors used-null 0 ordered-ptrs in
          Some (req, pair-nullaries nulls sents <> ptr-ctors)

  attach-layouts :: Nat -> List Request -> List String -> List CoreData -> List UsageShape -> List CoreData -> Store -> (List CoreData, Store)
  attach-layouts word-bits layouts autos all shapes todo st = case todo of
    [] -> ([], st)
    d : rest -> case attach-layouts word-bits layouts autos all shapes rest st of
      (more, checked) -> (case requested (core-data-name d) layouts of
        None ->
          if member (core-data-name d) autos then
            (case niche-layout word-bits layouts autos all shapes [] d of
              Ok (word, ctors, dom) -> ((with-data-layout (NicheData word ctors) d) : more, checked)
              Err msg -> (case poly-niche-layout word-bits layouts autos all shapes d of
                Some (req, ctors) -> ((with-data-layout (PolyNicheData req ctors) d) : more, checked)
                None -> (d : more, checked)))
          else (d : more, checked)
        Some (Request site owner repr labels published) ->
          (if repr == "poly-niche" then
            (case poly-niche-layout word-bits layouts autos all shapes d of
              Some (req, ctors) -> ((with-data-layout (PolyNicheData req ctors) d) : more, checked)
              None -> (d : more, checked))
          else if repr == "niche" then
            (case niche-layout word-bits layouts autos all shapes [] d of
              Err message -> (d : more, add-error site message checked)
              Ok (word, ctors, dom) -> (case published of
                Some row | not (matches-niche-published row) -> (d : more, add-error site "niche ABI layout disagrees with its represented field" checked)
                other -> ((with-data-layout (NicheData word ctors) d) : more, checked)))
          else let label = layout-label labels published d in (case (if repr == "transparent" then transparent-layout word-bits d shapes else physical-layout word-bits layouts autos all shapes [] d) of
            Err message -> (d : more, add-error site message checked)
            Ok (word, bytes, align) -> (case published of
              Some row | not (matches-published row label bytes align) -> (d : more, add-error site (repr <> " ABI layout disagrees with its represented field") checked)
              other -> ((with-data-layout (if repr == "transparent" then TransparentData label bytes align else UnboxedData label word bytes align) d) : more, checked)))))
