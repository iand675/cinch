-- A represented newtype keeps its checked nominal identity. The payload's
-- word class governs retention, independently of its published ABI size.
module Cinch.Layout where
  import Cinch.Ast
  import Cinch.Core
  import Cinch.Index
  import Cinch.Type
  import Cinch.Nominal (interface-global)
  import Cinch.Usage (UsageShape, usage-single-field)
  import Cinch.Document
  import Algebra.Semigroup
  import Text.Lex (Span)
  import Text.Show (nat-to-string)

  export check-layouts

  record Request where
    field0 :: Span
    field1 :: String
    field2 :: String
    field3 :: List String
    field4 :: Option Json

  field :: String -> Json -> Json
  field name doc = case doc of
    JObj key value more -> if key == name then value else field name more
    other -> JNull
  named-row :: String -> Json -> Option Json
  named-row name rows = case rows of
    JArr row more -> (case field "name" row of
      JStr n | (n == name) -> Some row
      other -> named-row name more)
    other -> None

  requests :: List Decl -> List Request
  requests ds = case ds of
    [] -> []
    (DWrapperLayout site name repr label) : rest -> (Request site name repr label None) : (requests rest)
    (DInterface site home hash doc) : rest ->
      abi-requests site home (field "types" (field "exports" doc)) (field "layouts" (field "abi" doc)) (requests rest)
    other : rest -> requests rest

  abi-requests :: Span -> String -> Json -> Json -> List Request -> List Request
  abi-requests site home types layouts tail = case layouts of
    JArr row more -> let rest = abi-requests site home types more tail in
      (case (field "repr" row, field "type" row) of
        (JStr repr, JStr name) | (repr == "unboxed") || repr == "transparent" || repr == "niche" -> (case named-row name types of
          Some ty -> (case field "identity" ty of
            JStr identity | (identity == home <> "." <> name) ->
              (Request site (interface-global identity) repr (field-labels (field "fields" ty)) (Some row)) : rest
            other -> rest)
          None -> rest)
        other -> rest)
    other -> tail

  field-labels :: Json -> List String
  field-labels rows = case rows of JArr (JStr label) rest -> label : (field-labels rest); other -> []

  -- Field names count erased parameters in source order. A private imported
  -- constructor can only disclose its slot through the checked ABI row.
  payload-label :: List String -> Nat -> UType -> String
  payload-label labels ordinal ty = case ty of
    UProofFun predicate effects result -> payload-label (case labels of first : rest -> rest; [] -> []) (ordinal + 1) result
    other -> (case labels of label : rest -> label; [] -> (case other of
      UPi id name domain effects result -> name
      other -> "$f" <> nat-to-string ordinal))
  layout-label :: List String -> Option Json -> CoreData -> String
  layout-label labels published d = case core-data-constructors d of
    [ctor] -> payload-label labels 0 (scheme-body (ctor.constructor-scheme))
    other -> (case published of
      Some row -> (case field "fields" row of JArr entry JArrEnd -> (case field "name" entry of JStr name -> name; other -> ""); other -> "")
      None -> "")

  requested :: String -> List Request -> Option Request
  requested name layouts = case layouts of
    [] -> None
    (Request site owner repr label published) : rest -> if name == owner then Some (Request site owner repr label published) else requested name rest
  data-for :: String -> List CoreData -> Option CoreData
  data-for name datas = case datas of
    [] -> None
    d : rest -> if name == core-data-name d then Some d else data-for name rest
  private-payload :: String -> List UsageShape -> Option UType
  private-payload owner shapes = case shapes of
    [] -> None
    shape : rest -> if owner == shape.name then usage-single-field shape else private-payload owner rest
  represented-field :: CoreData -> List UsageShape -> Option UType
  represented-field d shapes = case core-data-constructors d of
    [constructor] -> (case core-constructor-fields constructor of [payload] -> Some payload; other -> None)
    [] -> private-payload (core-data-name d) shapes
    other -> None
  member :: String -> List String -> Bool
  member name names = case names of [] -> False; first : rest -> name == first || member name rest
  head-name :: UType -> Option String
  head-name ty = case ty of UCon name kind -> Some name; UApp f a -> head-name f; other -> None

  scalar-layout :: Nat -> String -> Option (Nat, Nat, Nat)
  scalar-layout word-bits name =
    let ptr-bytes = if word-bits == 32 then 4 else 8 in
    if name == "Unit" then Some (0, 0, 1)
    else if member name ["Bool", "I8", "U8"] then Some (0, 1, 1)
    else if member name ["I16", "U16"] then Some (0, 2, 2)
    else if member name ["I32", "U32", "F32", "Char"] then Some (0, 4, 4)
    else if member name ["Usize", "Isize"] then Some (0, ptr-bytes, ptr-bytes)
    else if member name ["I64", "U64", "F64", "Sym"] then Some (0, 8, 8)
    else if member name ["Int", "Nat"] then Some (2, 8, 8)
    else if name == "Bytes" then Some (1, 8, 8)
    else None

  physical-layout :: Nat -> List Request -> List CoreData -> List UsageShape -> List String -> CoreData -> Result String (Nat, Nat, Nat)
  physical-layout word-bits layouts datas shapes seen d = let owner = core-data-name d in
    if member owner seen then Err "repr(unboxed) has a recursive layout" else case represented-field d shapes of
      None -> Err "repr(unboxed) requires one constructor with exactly one represented field"
      Some payload -> (case head-name payload of
        Some name -> (case scalar-layout word-bits name of
          Some physical -> Ok physical
          None -> (case (requested name layouts, data-for name datas) of
            (Some (Request at wrapper repr labels row), Some nested) | (repr == "unboxed") -> physical-layout word-bits layouts datas shapes (owner : seen) nested
            (Some (Request at wrapper repr labels row), Some nested) | (repr == "niche") ->
              (case niche-layout word-bits layouts datas shapes (owner : seen) nested of
                Ok (word, ctors, dom) -> Ok (word, 8, 8)
                Err msg -> Err msg)
            other -> Err "repr(unboxed) requires a fixed single-word payload"))
        None -> Err "repr(unboxed) requires a fixed single-word payload")

  -- Boundary wrappers keep their heap object. Their payload has the single
  -- field's physical width, including a zero-byte Unit field.
  transparent-layout :: Nat -> CoreData -> List UsageShape -> Result String (Nat, Nat, Nat)
  transparent-layout word-bits d shapes = case represented-field d shapes of
    None -> Err "repr(transparent) needs exactly one represented field"
    Some payload -> (case head-name payload of
      Some name -> (case scalar-layout word-bits name of
        Some physical -> Ok physical
        None -> if member name ["I128", "U128"] then Ok (3, 16, 16)
          else Err "repr(transparent) field needs a known boundary layout")
      None -> Err "repr(transparent) field needs a fixed layout")

  matches-published :: Json -> String -> Nat -> Nat -> Bool
  matches-published row label size alignment = case (field "size" row, field "align" row, field "fields" row) of
    (JNum bytes, JNum align, JArr entry JArrEnd) -> bytes == nat-to-int size && align == nat-to-int alignment &&
      (case (field "name" entry, field "offset" entry, field "size" entry, field "align" entry) of
        (JStr name, JNum offset, JNum width, JNum natural) -> name == label && offset == 0 && width == bytes && natural == align
        other -> False)
    other -> False

  matches-niche-published :: Json -> Bool
  matches-niche-published row = case (field "size" row, field "align" row) of
    (JNum bytes, JNum align) -> bytes == 8 && align == 8
    other -> False

  data NicheDomain where
    NicheSigned :: Int -> Int -> List Int -> NicheDomain
    NicheUnsigned :: Int -> Int -> List Int -> NicheDomain
    NicheOddImm :: List Int -> NicheDomain
    NicheNonNullObj :: List Int -> NicheDomain
    NicheNonZeroTObj :: List Int -> NicheDomain

  int-member :: Int -> List Int -> Bool
  int-member x xs = case xs of
    [] -> False
    first : rest -> x == first || int-member x rest

  int-insert-sorted :: Int -> List Int -> List Int
  int-insert-sorted x xs = case xs of
    [] -> [x]
    first : rest -> if x == first then xs else if x < first then x : xs else first : (int-insert-sorted x rest)

  int-merge-sorted :: List Int -> List Int -> List Int
  int-merge-sorted xs acc = case xs of
    [] -> acc
    first : rest -> int-merge-sorted rest (int-insert-sorted first acc)

  int-filter-range :: Int -> Int -> List Int -> List Int
  int-filter-range lo hi xs = case xs of
    [] -> []
    first : rest -> if first >= lo && first <= hi then first : (int-filter-range lo hi rest) else int-filter-range lo hi rest

  niche-int-const :: UType -> Option Int
  niche-int-const t = case t of
    UIndex carrier (IInteger n) -> Some n
    UIndexForget inner -> niche-int-const inner
    other -> None

  niche-is-binder :: Nat -> UType -> Bool
  niche-is-binder id t = case t of
    UIndex carrier (IBound bid name) -> bid == id
    UIndexForget inner -> niche-is-binder id inner
    other -> False

  niche-merge-lo :: Option Int -> Option Int -> Option Int
  niche-merge-lo a b = case (a, b) of
    (None, x) -> x
    (x, None) -> x
    (Some x, Some y) -> Some (if x > y then x else y)

  niche-merge-hi :: Option Int -> Option Int -> Option Int
  niche-merge-hi a b = case (a, b) of
    (None, x) -> x
    (x, None) -> x
    (Some x, Some y) -> Some (if x < y then x else y)

  niche-pred-bounds :: Nat -> UType -> (Option Int, Option Int)
  niche-pred-bounds id pred = case pred of
    UPropAnd a b -> case (niche-pred-bounds id a, niche-pred-bounds id b) of
      ((la, ha), (lb, hb)) -> (niche-merge-lo la lb, niche-merge-hi ha hb)
    UCompare op left right ->
      if niche-is-binder id left then
        (case niche-int-const right of
          Some k ->
            if op == "<" then (None, Some (k - 1))
            else if op == "<=" then (None, Some k)
            else if op == ">" then (Some (k + 1), None)
            else if op == ">=" then (Some k, None)
            else if op == "==" || op == "Eq" then (Some k, Some k)
            else (None, None)
          None -> (None, None))
      else if niche-is-binder id right then
        (case niche-int-const left of
          Some k ->
            if op == "<" then (Some (k + 1), None)
            else if op == "<=" then (Some k, None)
            else if op == ">" then (None, Some (k - 1))
            else if op == ">=" then (None, Some k)
            else if op == "==" || op == "Eq" then (Some k, Some k)
            else (None, None)
          None -> (None, None))
      else (None, None)
    other -> (None, None)

  niche-pred-exclusions :: Nat -> UType -> List Int
  niche-pred-exclusions id pred = case pred of
    UPropAnd a b -> int-merge-sorted (niche-pred-exclusions id a) (niche-pred-exclusions id b)
    UPropNonZero x -> if niche-is-binder id x then [0] else []
    UPropNonZeroPending x -> if niche-is-binder id x then [0] else []
    UCompare op left right | op == "/=" || op == "!=" || op == "Ne" ->
      if niche-is-binder id left then (case niche-int-const right of Some k -> [k]; None -> [])
      else if niche-is-binder id right then (case niche-int-const left of Some k -> [k]; None -> [])
      else []
    UPropNot (UCompare op left right) | op == "==" || op == "Eq" ->
      if niche-is-binder id left then (case niche-int-const right of Some k -> [k]; None -> [])
      else if niche-is-binder id right then (case niche-int-const left of Some k -> [k]; None -> [])
      else []
    other -> []

  niche-fits-immediate :: Nat -> UType -> Nat -> UType -> Bool
  niche-fits-immediate word-bits carrier id pred =
    let wasm32 = word-bits <= 32 in
    case head-name carrier of
      Some "Nat" ->
        let max-nat = if wasm32 then (2147483647 :: Int) else (4611686018427387903 :: Int) in
        (case niche-pred-bounds id pred of (lo, Some hi) -> hi <= max-nat; other -> False)
      Some "Int" ->
        let max-int = if wasm32 then (1073741823 :: Int) else (4611686018427387903 :: Int) in
        let min-int = 0 - max-int in
        (case niche-pred-bounds id pred of (Some lo, Some hi) -> lo >= min-int && hi <= max-int; other -> False)
      other -> False

  apply-niche-refinement :: Option Int -> Option Int -> List Int -> NicheDomain -> NicheDomain
  apply-niche-refinement plo phi pexcl dom = case dom of
    NicheSigned lo hi excl ->
      let lo1 = (case plo of Some l -> if l > lo then l else lo; None -> lo) in
      let hi1 = (case phi of Some h -> if h < hi then h else hi; None -> hi) in
      NicheSigned lo1 hi1 (int-filter-range lo1 hi1 (int-merge-sorted pexcl excl))
    NicheUnsigned lo hi excl ->
      let lo1 = (case plo of Some l -> if l > lo then l else lo; None -> lo) in
      let hi1 = (case phi of Some h -> if h < 0 then 0 else if h < hi then h else hi; None -> hi) in
      let lo2 = (case phi of Some h -> if h < 0 then 1 else lo1; None -> lo1) in
      NicheUnsigned lo2 hi1 (int-filter-range lo2 hi1 (int-merge-sorted pexcl excl))
    other -> other

  scalar-niche-domain :: Nat -> String -> Option NicheDomain
  scalar-niche-domain word-bits name =
    let isize-min = if word-bits <= 32 then (0 - 2147483648) else (0 - 9223372036854775808) in
    let isize-max = if word-bits <= 32 then (2147483647 :: Int) else (9223372036854775807 :: Int) in
    let usize-max = if word-bits <= 32 then (4294967295 :: Int) else (18446744073709551615 :: Int) in
    if name == "Unit" then Some (NicheUnsigned 0 0 [])
    else if name == "Bool" then Some (NicheUnsigned 0 1 [])
    else if name == "I8" then Some (NicheSigned (0 - 128) 127 [])
    else if name == "I16" then Some (NicheSigned (0 - 32768) 32767 [])
    else if name == "I32" then Some (NicheSigned (0 - 2147483648) 2147483647 [])
    else if name == "I64" then Some (NicheSigned (0 - 9223372036854775808) 9223372036854775807 [])
    else if name == "Isize" then Some (NicheSigned isize-min isize-max [])
    else if name == "U8" then Some (NicheUnsigned 0 255 [])
    else if name == "U16" then Some (NicheUnsigned 0 65535 [])
    else if name == "U32" then Some (NicheUnsigned 0 4294967295 [])
    else if name == "U64" then Some (NicheUnsigned 0 18446744073709551615 [])
    else if name == "Usize" then Some (NicheUnsigned 0 usize-max [])
    else if name == "Char" then Some (NicheUnsigned 0 1114111 [])
    else if name == "Nat" || name == "Int" then Some (NicheNonZeroTObj [])
    else if name == "Bytes" || name == "String" then Some (NicheNonNullObj [])
    else None

  extract-niche-domain :: Nat -> List Request -> List CoreData -> List UsageShape -> List String -> UType -> Result String NicheDomain
  extract-niche-domain word-bits layouts datas shapes seen ty =
    case borrow-type-parts ty of
      Some (reg, inner) -> extract-niche-domain word-bits layouts datas shapes seen inner
      None -> case refinement-view ty of
        URefine id name carrier pred ->
          if niche-fits-immediate word-bits carrier id pred then Ok (NicheOddImm [])
          else (case extract-niche-domain word-bits layouts datas shapes seen carrier of
            Err msg -> Err msg
            Ok dom ->
              let (plo, phi) = niche-pred-bounds id pred in
              let pexcl = niche-pred-exclusions id pred in
              Ok (apply-niche-refinement plo phi pexcl dom))
        URequire req body -> extract-niche-domain word-bits layouts datas shapes seen body
        other -> case ty of
          UTuple _ -> Ok (NicheNonNullObj [])
          USigma _ _ _ _ -> Ok (NicheNonNullObj [])
          UFun _ _ -> Ok (NicheNonNullObj [])
          UFunEff _ _ _ -> Ok (NicheNonNullObj [])
          UPi _ _ _ _ _ -> Ok (NicheNonNullObj [])
          UBound _ _ _ -> Err "repr(niche) requires a concrete single-word payload type"
          URigid _ _ _ _ -> Err "repr(niche) requires a concrete single-word payload type"
          UMeta _ -> Err "repr(niche) requires a concrete single-word payload type"
          _ -> if foreign-pointer ty then Err "repr(niche) cannot derive a niche from an opaque type"
            else case head-name ty of
              Some name ->
                if member name ["I128", "U128", "F32", "F64", "Sym"] then
                  Err "repr(niche) payload must be a single-word integer, refinement, pointer, or boxed value"
                else (case scalar-niche-domain word-bits name of
                  Some dom -> Ok dom
                  None -> (case (requested name layouts, data-for name datas) of
                    (Some (Request at wrapper repr labels row), Some nested) | repr == "niche" ->
                      (case niche-layout word-bits layouts datas shapes seen nested of
                        Ok (w, ctors, dom) -> Ok dom
                        Err msg -> Err msg)
                    (Some (Request at wrapper repr labels row), Some nested) | repr == "unboxed" ->
                      (case represented-field nested shapes of
                        Some inner -> extract-niche-domain word-bits layouts datas shapes seen inner
                        None -> Err "repr(unboxed) requires one constructor with exactly one represented field")
                    other -> Ok (NicheNonNullObj [])))
              None -> Err "repr(niche) requires a concrete single-word payload type"

  partition-niche-ctors :: List CoreConstructor -> Result String (List String, List (String, UType))
  partition-niche-ctors ctors = case ctors of
    [] -> Ok ([], [])
    c : rest -> case partition-niche-ctors rest of
      Err msg -> Err msg
      Ok (nulls, pays) -> case core-constructor-fields c of
        [] -> Ok ((c.constructor-name) : nulls, pays)
        [pty] -> Ok (nulls, ((c.constructor-name, pty) : pays))
        other -> Err "repr(niche) constructors may have at most one represented field"

  build-nullary-enum :: Int -> List String -> List NicheCtor
  build-nullary-enum idx names = case names of
    [] -> []
    cname : rest -> (NicheNullary cname idx) : (build-nullary-enum (idx + 1) rest)

  niche-list-len :: forall a. List a -> Nat
  niche-list-len xs = case xs of [] -> 0; _ : rest -> 1 + niche-list-len rest

  alloc-range-sentinels :: Nat -> Int -> Int -> Int -> Int -> List Int -> List Int -> Result String (List Int, Int, Int, List Int)
  alloc-range-sentinels need min-b max-b lo hi excl acc =
    if need == 0 then Ok (acc, lo, hi, excl)
    else case excl of
      ex : more -> alloc-range-sentinels (need - 1) min-b max-b lo hi more (acc <> [ex])
      [] ->
        if lo > min-b then alloc-range-sentinels (need - 1) min-b max-b (lo - 1) hi [] (acc <> [lo - 1])
        else if hi < max-b then alloc-range-sentinels (need - 1) min-b max-b lo (hi + 1) [] (acc <> [hi + 1])
        else Err "repr(niche) cannot find enough unused niche values for nullary constructors"

  alloc-even-sentinels :: Nat -> Int -> List Int -> List Int -> (List Int, List Int)
  alloc-even-sentinels need cand used acc =
    if need == 0 then (acc, used)
    else if int-member cand used then alloc-even-sentinels need (cand + 2) used acc
    else alloc-even-sentinels (need - 1) (cand + 2) (cand : used) (acc <> [cand])

  alloc-obj-sentinels :: Nat -> Int -> List Int -> List Int -> (List Int, List Int)
  alloc-obj-sentinels need next-odd used acc =
    if need == 0 then (acc, used)
    else if not (int-member 0 used) then alloc-obj-sentinels (need - 1) next-odd (0 : used) (acc <> [0])
    else if int-member next-odd used then alloc-obj-sentinels need (next-odd + 2) used acc
    else alloc-obj-sentinels (need - 1) (next-odd + 2) (next-odd : used) (acc <> [next-odd])

  any-nonzero :: List Int -> Bool
  any-nonzero xs = case xs of [] -> False; first : rest -> first /= 0 || any-nonzero rest

  pair-nullaries :: List String -> List Int -> List NicheCtor
  pair-nullaries names sentinels = case (names, sentinels) of
    (n : ns, s : ss) -> (NicheNullary n s) : (pair-nullaries ns ss)
    other -> []

  extract-multi-ranges :: Bool -> Nat -> List Request -> List CoreData -> List UsageShape -> List String -> List (String, UType) -> Result String (List (String, Int, Int, List Int))
  extract-multi-ranges want-unsigned word-bits layouts datas shapes seen pays = case pays of
    [] -> Ok []
    (cname, pty) : rest -> case extract-niche-domain word-bits layouts datas shapes seen pty of
      Err msg -> Err msg
      Ok (NicheSigned lo hi excl) | not want-unsigned ->
        (case extract-multi-ranges False word-bits layouts datas shapes seen rest of
          Err msg -> Err msg
          Ok more -> Ok ((cname, lo, hi, excl) : more))
      Ok (NicheUnsigned lo hi excl) | want-unsigned ->
        (case extract-multi-ranges True word-bits layouts datas shapes seen rest of
          Err msg -> Err msg
          Ok more -> Ok ((cname, lo, hi, excl) : more))
      other -> Err "repr(niche) with multiple payload constructors requires provably disjoint refined integer domains of the same signedness"

  ranges-disjoint-pair :: Int -> Int -> List Int -> Int -> Int -> List Int -> Bool
  ranges-disjoint-pair lo1 hi1 ex1 lo2 hi2 ex2 =
    hi1 < lo2 || hi2 < lo1 || (lo1 == hi1 && int-member lo1 ex2) || (lo2 == hi2 && int-member lo2 ex1)

  all-disjoint-against :: Int -> Int -> List Int -> List (String, Int, Int, List Int) -> Bool
  all-disjoint-against lo1 hi1 ex1 rest = case rest of
    [] -> True
    (cn, lo2, hi2, ex2) : more -> ranges-disjoint-pair lo1 hi1 ex1 lo2 hi2 ex2 && all-disjoint-against lo1 hi1 ex1 more

  check-all-disjoint :: List (String, Int, Int, List Int) -> Bool
  check-all-disjoint arms = case arms of
    [] -> True
    (cn, lo, hi, ex) : rest -> all-disjoint-against lo hi ex rest && check-all-disjoint rest

  insert-interval :: (Int, Int) -> List (Int, Int) -> List (Int, Int)
  insert-interval iv ivs = case ivs of
    [] -> [iv]
    (l2, h2) : rest -> case iv of
      (l1, h1) -> if l1 <= l2 then iv : ivs else (l2, h2) : (insert-interval iv rest)

  sort-intervals :: List (String, Int, Int, List Int) -> List (Int, Int)
  sort-intervals arms = case arms of
    [] -> []
    (cn, lo, hi, ex) : rest -> insert-interval (lo, hi) (sort-intervals rest)

  take-gap-values :: Nat -> Int -> Int -> List Int -> (Nat, List Int)
  take-gap-values need cur limit acc =
    if need == 0 || cur >= limit then (need, acc)
    else take-gap-values (need - 1) (cur + 1) limit (acc <> [cur])

  alloc-from-gaps :: Nat -> List (Int, Int) -> List Int -> (Nat, List Int)
  alloc-from-gaps need ivs acc = case ivs of
    (l1, h1) : (l2, h2) : rest ->
      if need == 0 then (0, acc)
      else case take-gap-values need (h1 + 1) l2 acc of
        (rem, next) -> alloc-from-gaps rem ((l2, h2) : rest) next
    other -> (need, acc)

  last-hi :: Int -> List (Int, Int) -> Int
  last-hi cur ivs = case ivs of [] -> cur; (l, h) : rest -> last-hi (if h > cur then h else cur) rest

  make-multi-payloads :: Bool -> List (String, Int, Int, List Int) -> List NicheCtor
  make-multi-payloads unsigned arms = case arms of
    [] -> []
    (cn, lo, hi, ex) : rest -> (NichePayload cn True unsigned lo hi ex) : (make-multi-payloads unsigned rest)

  niche-layout :: Nat -> List Request -> List CoreData -> List UsageShape -> List String -> CoreData -> Result String (Nat, List NicheCtor, NicheDomain)
  niche-layout word-bits layouts datas shapes seen d =
    let owner = core-data-name d in
    if member owner seen then Err "repr(niche) has a recursive layout"
    else case core-data-constructors d of
      [] -> Err "repr(niche) requires at least one constructor"
      ctors -> case partition-niche-ctors ctors of
        Err msg -> Err msg
        Ok (nulls, pays) -> case pays of
          [] ->
            let n = niche-list-len nulls in
            let hi = if n == 0 then (0 :: Int) else nat-to-int (n - 1) in
            Ok (0, build-nullary-enum 0 nulls, NicheUnsigned 0 hi [])
          [(pname, pty)] ->
            (case extract-niche-domain word-bits layouts datas shapes (owner : seen) pty of
              Err msg -> Err msg
              Ok dom ->
                let n = niche-list-len nulls in
                case dom of
                  NicheSigned lo hi excl ->
                    (case alloc-range-sentinels n (0 - 9223372036854775808) 9223372036854775807 lo hi excl [] of
                      Err msg -> Err msg
                      Ok (sents, lo1, hi1, excl1) ->
                        Ok (0, pair-nullaries nulls sents <> [NichePayload pname False False 0 0 []], NicheSigned lo1 hi1 excl1))
                  NicheUnsigned lo hi excl ->
                    (case alloc-range-sentinels n 0 18446744073709551615 lo hi excl [] of
                      Err msg -> Err msg
                      Ok (sents, lo1, hi1, excl1) ->
                        Ok (0, pair-nullaries nulls sents <> [NichePayload pname False True 0 0 []], NicheUnsigned lo1 hi1 excl1))
                  NicheOddImm used ->
                    let (sents, used1) = alloc-even-sentinels n 0 used [] in
                    Ok (0, pair-nullaries nulls sents <> [NichePayload pname False False 0 0 []], NicheOddImm used1)
                  NicheNonNullObj used ->
                    let (sents, used1) = alloc-obj-sentinels n 1 used [] in
                    let carrier = if any-nonzero used1 then (2 :: Nat) else 1 in
                    Ok (carrier, pair-nullaries nulls sents <> [NichePayload pname False False 0 0 []], NicheNonNullObj used1)
                  NicheNonZeroTObj used ->
                    if n == 0 then Ok (2, [NichePayload pname False False 0 0 []], NicheNonZeroTObj used)
                    else if n == 1 && not (int-member 0 used) then
                      Ok (2, pair-nullaries nulls [0] <> [NichePayload pname False False 0 0 []], NicheNonZeroTObj (0 : used))
                    else Err "repr(niche) cannot find enough unused niche values for nullary constructors")
          (p1name, p1ty) : more-pays ->
            (case extract-niche-domain word-bits layouts datas shapes (owner : seen) p1ty of
              Err msg -> Err msg
              Ok first-dom ->
                let check-multi = (\unsigned min-b max-b ->
                      case extract-multi-ranges unsigned word-bits layouts datas shapes (owner : seen) pays of
                        Err msg -> Err msg
                        Ok arms ->
                          if not (check-all-disjoint arms) then
                            Err "repr(niche) payload constructors must have provably disjoint value domains"
                          else
                            let ivs = sort-intervals arms in
                            let min-lo = (case ivs of (l, h) : _ -> l; [] -> 0) in
                            let max-hi = last-hi min-lo ivs in
                            let (rem, gap-sents) = alloc-from-gaps (niche-list-len nulls) ivs [] in
                            (case alloc-range-sentinels rem min-b max-b min-lo max-hi [] gap-sents of
                              Err msg -> Err msg
                              Ok (sents, lo1, hi1, _) ->
                                let occ = if unsigned then NicheUnsigned lo1 hi1 [] else NicheSigned lo1 hi1 [] in
                                Ok (0, pair-nullaries nulls sents <> make-multi-payloads unsigned arms, occ))) in
                case first-dom of
                  NicheSigned _ _ _ -> check-multi False (0 - 9223372036854775808) 9223372036854775807
                  NicheUnsigned _ _ _ -> check-multi True 0 18446744073709551615
                  other -> Err "repr(niche) with multiple payload constructors requires provably disjoint refined integer domains of the same signedness")

  check-layouts :: Nat -> List Decl -> List CoreData -> List UsageShape -> Store -> (List CoreData, Store)
  check-layouts word-bits ds datas shapes st = case requests ds of
    [] -> (datas, st)
    layouts -> attach-layouts word-bits layouts datas shapes datas st

  attach-layouts :: Nat -> List Request -> List CoreData -> List UsageShape -> List CoreData -> Store -> (List CoreData, Store)
  attach-layouts word-bits layouts all shapes todo st = case todo of
    [] -> ([], st)
    d : rest -> case attach-layouts word-bits layouts all shapes rest st of
      (more, checked) -> (case requested (core-data-name d) layouts of
        None -> (d : more, checked)
        Some (Request site owner repr labels published) ->
          if repr == "niche" then
            (case niche-layout word-bits layouts all shapes [] d of
              Err message -> (d : more, add-error site message checked)
              Ok (word, ctors, dom) -> (case published of
                Some row | not (matches-niche-published row) -> (d : more, add-error site "niche ABI layout disagrees with its represented field" checked)
                other -> ((with-data-layout (NicheData word ctors) d) : more, checked)))
          else let label = layout-label labels published d in (case (if repr == "transparent" then transparent-layout word-bits d shapes else physical-layout word-bits layouts all shapes [] d) of
            Err message -> (d : more, add-error site message checked)
            Ok (word, bytes, align) -> (case published of
              Some row | not (matches-published row label bytes align) -> (d : more, add-error site (repr <> " ABI layout disagrees with its represented field") checked)
              other -> ((with-data-layout (if repr == "transparent" then TransparentData label bytes align else UnboxedData label word bytes align) d) : more, checked))))
