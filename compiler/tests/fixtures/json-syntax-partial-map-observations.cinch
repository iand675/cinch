-- | Independent partial-update observations retain complete application state, callbacks and structured refusals.
module Main where
  import Text.Json.Value
  import Text.Json.Codec
  import Text.Json.Dynamic
  import Data.Array
  import Data.Machine

  -- | Keep the selected source length opaque to front-end evaluation.
  prim runtime-width :: U32 -> U32 where
    llvm {
      %value = or i32 %0, 0
      ret i32 %value
    }

  -- | Snapshot source bytes through a runtime-sized owner.
  input-bytes :: String -> Bytes
  input-bytes text =
    let input = string-to-bytes text in
    let count = u32-to-nat (runtime-width (wrapping-i64-to-u32 (nat-to-i64 (bytes-len input)))) in
    let output = bytes-new count in
    if bytes-len input <= bytes-len output then let copied = bytes-copy-range output input 0 0 (bytes-len input) in output else bytes-new 0

  -- | Compare every byte without truncating at embedded zeroes.
  same :: Bytes -> String -> Bool
  same bytes text = eq-i64 (bytes-compare bytes (string-to-bytes text)) 0

  -- | Retain the exact independent structured error family and its owned metadata.
  data ExpectedError where
    -- | A completed operation without a diagnostic.
    NoError :: ExpectedError
    -- | Established syntax reporting retains its original cursor.
    LegacySyntax :: Nat -> ExpectedError
    -- | Precise syntax reporting retains both byte checkpoint and escaped pointer.
    NativeSyntax :: Nat -> String -> ExpectedError
    -- | A semantic conversion keeps kind, optional application identity and reported bytes independently.
    Semantic :: Nat -> String -> U8 -> Option String -> String -> ExpectedError

  -- | Compare optional application identity without conflating absence with empty text.
  identity-is :: Option String -> Option String -> Bool
  identity-is actual expected = case expected of
    None -> case actual of None -> True; Some name -> False
    Some name -> case actual of None -> False; Some value -> value == name

  -- | Recognize the independent no-error outcome without a nested ambiguous case expression.
  no-error :: ExpectedError -> Bool
  no-error expected = case expected of NoError -> True; other -> False

  -- | Observe the original public error family, common getters and dedicated metadata together.
  error-is :: JsonError -> ExpectedError -> Bool
  error-is actual expected = case expected of
    NoError -> False
    LegacySyntax offset -> case actual of JsonSyntaxError at message -> at == offset && json-error-offset actual == offset; other -> False
    NativeSyntax offset pointer -> case actual of
      JsonSyntacticError info cause -> json-syntactic-offset info == offset && json-syntactic-pointer info == pointer && json-error-offset actual == offset && json-error-path actual == pointer
      other -> False
    Semantic offset pointer kind label reported -> case actual of
      JsonSemanticError info cause -> json-semantic-offset info == offset && json-semantic-pointer info == pointer && eq-u8 (json-semantic-kind-byte info) kind && identity-is (json-semantic-type-option info) label && same (json-semantic-reported-bytes info) reported && json-error-offset actual == offset
      other -> False

  -- | Inspect both public decoded-result entry points without replacing the original diagnostic.
  outcome-is :: forall a. JsonDecoded a -> ExpectedError -> Bool
  outcome-is decoded expected =
    (case json-decoded-error decoded of None -> no-error expected; Some error -> error-is error expected)
      && (case json-decoded-result decoded of Ok value -> no-error expected; Err error -> error-is error expected)

  -- | One unchanged reference row contains its index, policy, source, full state, error and callback observations.
  data Observation where
    -- | Private global row index, legacy policy, exact input, complete state, error, call count and callback bytes.
    Observe :: Nat -> Bool -> String -> String -> ExpectedError -> Nat -> String -> Observation

  -- | Change only the requested reporting policy while retaining all other established defaults.
  options-for :: Bool -> JsonReadOptions
  options-for legacy = json-read-options False False (json-configure-policies json-default-policies [json-continue-after-type-errors legacy])

  -- | Give integer conversions their independently observed application identity.
  integer-type :: JsonType I64
  integer-type = json-type-with-read-identity "int" "" json-int64-type

  -- | Compare full serialized application state after conversion.
  state-is :: forall a. JsonType a -> a -> String -> Bool
  state-is descriptor value expected = case json-marshal descriptor value of Err error -> False; Ok bytes -> same bytes expected

  -- | Use the exact observed application descriptor.
  selected-type :: JsonType (JsonMap String I64)
  selected-type = json-type-with-read-identity "map[string]int" "" (json-map-type json-string-key integer-type)

  -- | Restore the independent prior value for every observation.
  prior-value :: JsonMap String I64
  prior-value = json-map-set "a" 9 (json-map-set "keep" 7 (json-map-empty json-string-key))

  -- | Compare every state byte while preserving separate callback observations.
  model-state :: JsonMap String I64 -> String -> Bool
  model-state value expected = state-is selected-type value expected

  -- | Preserve the first original global row and mismatching property.
  check-row :: Observation -> Nat
  check-row row = case row of
    Observe index legacy wire expected error calls argument ->
      let decoded = json-update-with selected-type (options-for legacy) (input-bytes wire) prior-value in
      let value = json-decoded-value decoded in
      if not (model-state value expected) then index * 16 + 1
      else if not (outcome-is decoded error) then index * 16 + 2
      else if not (calls == 0) then index * 16 + 3
      else 0

  -- | Traverse a bounded literal group without constructing a deep generated let chain.
  check-group :: List Observation -> Nat
  check-group rows = case rows of Nil -> 0; Cons first rest -> let result = check-row first in if result > 0 then result else check-group rest

  -- | Preserve sixteen or fewer unchanged independent rows in original order.
  rows-a000 :: List Observation
  rows-a000 = [Observe 472 True "" "{\"a\":9,\"keep\":7}" (LegacySyntax 0) 0 "",
    Observe 473 False "" "{\"a\":9,\"keep\":7}" (NativeSyntax 0 "") 0 "",
    Observe 474 True "{" "{\"a\":9,\"keep\":7}" (LegacySyntax 1) 0 "",
    Observe 475 False "{" "{\"a\":9,\"keep\":7}" (NativeSyntax 1 "") 0 "",
    Observe 476 True "{\"" "{\"a\":9,\"keep\":7}" (LegacySyntax 2) 0 "",
    Observe 477 False "{\"" "{\"a\":9,\"keep\":7}" (NativeSyntax 2 "") 0 "",
    Observe 478 True "{\"a" "{\"a\":9,\"keep\":7}" (LegacySyntax 3) 0 "",
    Observe 479 False "{\"a" "{\"a\":9,\"keep\":7}" (NativeSyntax 3 "") 0 "",
    Observe 480 True "{\"a\"" "{\"a\":9,\"keep\":7}" (LegacySyntax 4) 0 "",
    Observe 481 False "{\"a\"" "{\"a\":0,\"keep\":7}" (NativeSyntax 4 "/a") 0 "",
    Observe 482 True "{\"a\":" "{\"a\":9,\"keep\":7}" (LegacySyntax 5) 0 "",
    Observe 483 False "{\"a\":" "{\"a\":0,\"keep\":7}" (NativeSyntax 5 "/a") 0 "",
    Observe 484 True "{\"a\":1" "{\"a\":9,\"keep\":7}" (LegacySyntax 6) 0 "",
    Observe 485 False "{\"a\":1" "{\"a\":1,\"keep\":7}" (NativeSyntax 6 "") 0 "",
    Observe 486 True "{\"a\":1," "{\"a\":9,\"keep\":7}" (LegacySyntax 7) 0 "",
    Observe 487 False "{\"a\":1," "{\"a\":1,\"keep\":7}" (NativeSyntax 7 "") 0 ""]

  -- | Preserve sixteen or fewer unchanged independent rows in original order.
  rows-a001 :: List Observation
  rows-a001 = [Observe 488 True "{\"a\":1,\"" "{\"a\":9,\"keep\":7}" (LegacySyntax 8) 0 "",
    Observe 489 False "{\"a\":1,\"" "{\"a\":1,\"keep\":7}" (NativeSyntax 8 "") 0 "",
    Observe 490 True "{\"a\":1,\"b" "{\"a\":9,\"keep\":7}" (LegacySyntax 9) 0 "",
    Observe 491 False "{\"a\":1,\"b" "{\"a\":1,\"keep\":7}" (NativeSyntax 9 "") 0 "",
    Observe 492 True "{\"a\":1,\"b\"" "{\"a\":9,\"keep\":7}" (LegacySyntax 10) 0 "",
    Observe 493 False "{\"a\":1,\"b\"" "{\"a\":1,\"b\":0,\"keep\":7}" (NativeSyntax 10 "/b") 0 "",
    Observe 494 True "{\"a\":1,\"b\":" "{\"a\":9,\"keep\":7}" (LegacySyntax 11) 0 "",
    Observe 495 False "{\"a\":1,\"b\":" "{\"a\":1,\"b\":0,\"keep\":7}" (NativeSyntax 11 "/b") 0 "",
    Observe 496 True "{\"a\":1,\"b\":2" "{\"a\":9,\"keep\":7}" (LegacySyntax 12) 0 "",
    Observe 497 False "{\"a\":1,\"b\":2" "{\"a\":1,\"b\":2,\"keep\":7}" (NativeSyntax 12 "") 0 "",
    Observe 498 True "{\"a\":1,\"b\":2}" "{\"a\":1,\"b\":2,\"keep\":7}" NoError 0 "",
    Observe 499 False "{\"a\":1,\"b\":2}" "{\"a\":1,\"b\":2,\"keep\":7}" NoError 0 "",
    Observe 500 True "" "{\"a\":9,\"keep\":7}" (LegacySyntax 0) 0 "",
    Observe 501 False "" "{\"a\":9,\"keep\":7}" (NativeSyntax 0 "") 0 "",
    Observe 502 True " " "{\"a\":9,\"keep\":7}" (LegacySyntax 1) 0 "",
    Observe 503 False " " "{\"a\":9,\"keep\":7}" (NativeSyntax 1 "") 0 ""]

  -- | Preserve sixteen or fewer unchanged independent rows in original order.
  rows-a002 :: List Observation
  rows-a002 = [Observe 504 True "@" "{\"a\":9,\"keep\":7}" (LegacySyntax 1) 0 "",
    Observe 505 False "@" "{\"a\":9,\"keep\":7}" (NativeSyntax 0 "") 0 "",
    Observe 506 True "-" "{\"a\":9,\"keep\":7}" (LegacySyntax 0) 0 "",
    Observe 507 False "-" "{\"a\":9,\"keep\":7}" (NativeSyntax 0 "") 0 "",
    Observe 508 True "1e" "{\"a\":9,\"keep\":7}" (LegacySyntax 0) 0 "",
    Observe 509 False "1e" "{\"a\":9,\"keep\":7}" (NativeSyntax 0 "") 0 "",
    Observe 510 True "1e+" "{\"a\":9,\"keep\":7}" (LegacySyntax 0) 0 "",
    Observe 511 False "1e+" "{\"a\":9,\"keep\":7}" (NativeSyntax 0 "") 0 "",
    Observe 512 True "1x" "{\"a\":9,\"keep\":7}" (LegacySyntax 2) 0 "",
    Observe 513 False "1x" "{\"a\":9,\"keep\":7}" (Semantic 0 "" 48 (Some "map[string]int") "") 0 "",
    Observe 514 True "truex" "{\"a\":9,\"keep\":7}" (LegacySyntax 5) 0 "",
    Observe 515 False "truex" "{\"a\":9,\"keep\":7}" (Semantic 0 "" 116 (Some "map[string]int") "") 0 "",
    Observe 516 True "\"ok\"x" "{\"a\":9,\"keep\":7}" (LegacySyntax 5) 0 "",
    Observe 517 False "\"ok\"x" "{\"a\":9,\"keep\":7}" (Semantic 0 "" 34 (Some "map[string]int") "") 0 "",
    Observe 518 True "1 2" "{\"a\":9,\"keep\":7}" (LegacySyntax 3) 0 "",
    Observe 519 False "1 2" "{\"a\":9,\"keep\":7}" (Semantic 0 "" 48 (Some "map[string]int") "") 0 ""]

  -- | Preserve sixteen or fewer unchanged independent rows in original order.
  rows-a003 :: List Observation
  rows-a003 = [Observe 520 True "nullx" "{\"a\":9,\"keep\":7}" (LegacySyntax 5) 0 "",
    Observe 521 False "nullx" "null" (NativeSyntax 4 "") 0 "",
    Observe 522 True "[1]x" "{\"a\":9,\"keep\":7}" (LegacySyntax 4) 0 "",
    Observe 523 False "[1]x" "{\"a\":9,\"keep\":7}" (Semantic 0 "" 91 (Some "map[string]int") "") 0 "",
    Observe 524 True "[" "{\"a\":9,\"keep\":7}" (LegacySyntax 1) 0 "",
    Observe 525 False "[" "{\"a\":9,\"keep\":7}" (Semantic 0 "" 91 (Some "map[string]int") "") 0 "",
    Observe 526 True "[1," "{\"a\":9,\"keep\":7}" (LegacySyntax 3) 0 "",
    Observe 527 False "[1," "{\"a\":9,\"keep\":7}" (Semantic 0 "" 91 (Some "map[string]int") "") 0 "",
    Observe 528 True "[1,@]" "{\"a\":9,\"keep\":7}" (LegacySyntax 4) 0 "",
    Observe 529 False "[1,@]" "{\"a\":9,\"keep\":7}" (Semantic 0 "" 91 (Some "map[string]int") "") 0 "",
    Observe 530 True "[true,@]" "{\"a\":9,\"keep\":7}" (LegacySyntax 7) 0 "",
    Observe 531 False "[true,@]" "{\"a\":9,\"keep\":7}" (Semantic 0 "" 91 (Some "map[string]int") "") 0 "",
    Observe 532 True "[1,,2]" "{\"a\":9,\"keep\":7}" (LegacySyntax 4) 0 "",
    Observe 533 False "[1,,2]" "{\"a\":9,\"keep\":7}" (Semantic 0 "" 91 (Some "map[string]int") "") 0 "",
    Observe 534 True "{\"before\":1 \"value\":2}" "{\"a\":9,\"keep\":7}" (LegacySyntax 13) 0 "",
    Observe 535 False "{\"before\":1 \"value\":2}" "{\"a\":9,\"before\":1,\"keep\":7}" (NativeSyntax 12 "") 0 ""]

  -- | Preserve sixteen or fewer unchanged independent rows in original order.
  rows-a004 :: List Observation
  rows-a004 = [Observe 536 True "{\"before\":1,\"value\":@}" "{\"a\":9,\"keep\":7}" (LegacySyntax 21) 0 "",
    Observe 537 False "{\"before\":1,\"value\":@}" "{\"a\":9,\"before\":1,\"keep\":7,\"value\":0}" (NativeSyntax 20 "/value") 0 "",
    Observe 538 True "{\"before\":1,\"value\":" "{\"a\":9,\"keep\":7}" (LegacySyntax 20) 0 "",
    Observe 539 False "{\"before\":1,\"value\":" "{\"a\":9,\"before\":1,\"keep\":7,\"value\":0}" (NativeSyntax 20 "/value") 0 "",
    Observe 540 True "{\"before\":1,\"value\":\"x}" "{\"a\":9,\"keep\":7}" (LegacySyntax 23) 0 "",
    Observe 541 False "{\"before\":1,\"value\":\"x}" "{\"a\":9,\"before\":1,\"keep\":7,\"value\":0}" (NativeSyntax 23 "/value") 0 "",
    Observe 542 True "{\"before\":1,\"value\":2,\"after\":" "{\"a\":9,\"keep\":7}" (LegacySyntax 30) 0 "",
    Observe 543 False "{\"before\":1,\"value\":2,\"after\":" "{\"a\":9,\"after\":0,\"before\":1,\"keep\":7,\"value\":2}" (NativeSyntax 30 "/after") 0 "",
    Observe 544 True "{\"before\":1,\"value\":2,\"after\":3}x" "{\"a\":9,\"keep\":7}" (LegacySyntax 33) 0 "",
    Observe 545 False "{\"before\":1,\"value\":2,\"after\":3}x" "{\"a\":9,\"after\":3,\"before\":1,\"keep\":7,\"value\":2}" (NativeSyntax 32 "") 0 "",
    Observe 546 True "{\"a\":1,\"a\":2,}" "{\"a\":9,\"keep\":7}" (LegacySyntax 14) 0 "",
    Observe 547 False "{\"a\":1,\"a\":2,}" "{\"a\":2,\"keep\":7}" (NativeSyntax 12 "") 0 "",
    Observe 548 True "{\"a\":1,\"b\":\"x" "{\"a\":9,\"keep\":7}" (LegacySyntax 13) 0 "",
    Observe 549 False "{\"a\":1,\"b\":\"x" "{\"a\":1,\"b\":0,\"keep\":7}" (NativeSyntax 13 "/b") 0 "",
    Observe 550 True "{\"a\":[1,2" "{\"a\":9,\"keep\":7}" (LegacySyntax 9) 0 "",
    Observe 551 False "{\"a\":[1,2" "{\"a\":0,\"keep\":7}" (NativeSyntax 9 "/a") 0 ""]

  -- | Preserve sixteen or fewer unchanged independent rows in original order.
  rows-a005 :: List Observation
  rows-a005 = [Observe 552 True "{\"a\":1} {\"a\":2}" "{\"a\":9,\"keep\":7}" (LegacySyntax 9) 0 "",
    Observe 553 False "{\"a\":1} {\"a\":2}" "{\"a\":1,\"keep\":7}" (NativeSyntax 8 "") 0 "",
    Observe 554 True "{\"before\":1,\"unknown\":[2,@],\"after\":3}" "{\"a\":9,\"keep\":7}" (LegacySyntax 26) 0 "",
    Observe 555 False "{\"before\":1,\"unknown\":[2,@],\"after\":3}" "{\"a\":9,\"before\":1,\"keep\":7,\"unknown\":0}" (NativeSyntax 25 "/unknown/1") 0 "",
    Observe 556 True "\"\\u12\"" "{\"a\":9,\"keep\":7}" (LegacySyntax 6) 0 "",
    Observe 557 False "\"\\u12\"" "{\"a\":9,\"keep\":7}" (NativeSyntax 1 "") 0 "",
    Observe 558 True "\"\\x\"" "{\"a\":9,\"keep\":7}" (LegacySyntax 3) 0 "",
    Observe 559 False "\"\\x\"" "{\"a\":9,\"keep\":7}" (NativeSyntax 1 "") 0 ""]

  -- | Stop at the earliest complete original row/property disagreement.
  status :: Nat
  status =
    let result-a000 = check-group rows-a000 in
    if result-a000 > 0 then result-a000 else
    let result-a001 = check-group rows-a001 in
    if result-a001 > 0 then result-a001 else
    let result-a002 = check-group rows-a002 in
    if result-a002 > 0 then result-a002 else
    let result-a003 = check-group rows-a003 in
    if result-a003 > 0 then result-a003 else
    let result-a004 = check-group rows-a004 in
    if result-a004 > 0 then result-a004 else
    let result-a005 = check-group rows-a005 in
    if result-a005 > 0 then result-a005 else
    0

  -- | Emit a normalized failing exit while keeping the complete original row/property code.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in
    let failed = status in
    if failed == 0 then 0 else let printed = ioWrite (string-to-bytes (string-concat-all ["json-syntax-partial:", nat-to-string failed, "\n"])) in 1
