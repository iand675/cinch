    decode-case (bytes-from-list [110,117,108,108]) 1 False True json-any-null (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) [(EncodingSpec False (bytes-from-list [110,117,108,108]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) (bytes-from-list [123,125]) (ErrorSpec 0 0 "" "" "" (bytes-from-list []))), (EncodingSpec True (bytes-from-list [110,117,108,108]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) (bytes-from-list [123,125]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])))],
    decode-case (bytes-from-list [110,117,108,108]) 1 True True json-any-null (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) [(EncodingSpec False (bytes-from-list [110,117,108,108]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) (bytes-from-list [123,125]) (ErrorSpec 0 0 "" "" "" (bytes-from-list []))), (EncodingSpec True (bytes-from-list [110,117,108,108]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) (bytes-from-list [123,125]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])))],
    decode-case (bytes-from-list [110,117,108,108]) 2 False True json-any-null (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) [(EncodingSpec False (bytes-from-list [110,117,108,108]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) (bytes-from-list [123,125]) (ErrorSpec 0 0 "" "" "" (bytes-from-list []))), (EncodingSpec True (bytes-from-list [110,117,108,108]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) (bytes-from-list [123,125]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])))],
    decode-case (bytes-from-list [110,117,108,108]) 2 True True json-any-null (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) [(EncodingSpec False (bytes-from-list [110,117,108,108]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) (bytes-from-list [123,125]) (ErrorSpec 0 0 "" "" "" (bytes-from-list []))), (EncodingSpec True (bytes-from-list [110,117,108,108]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) (bytes-from-list [123,125]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])))],
    decode-case (bytes-from-list [110,117,108,108]) 3 False True json-any-null (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) [(EncodingSpec False (bytes-from-list [110,117,108,108]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) (bytes-from-list [123,125]) (ErrorSpec 0 0 "" "" "" (bytes-from-list []))), (EncodingSpec True (bytes-from-list [110,117,108,108]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])) (bytes-from-list [123,125]) (ErrorSpec 0 0 "" "" "" (bytes-from-list [])))],
