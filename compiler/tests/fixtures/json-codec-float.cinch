  check-batch2 :: Unit -> Nat
  check-batch2 unit = first-failure [
      (typed-case json-float64-type (string-to-bytes "5e-324") (i64-to-f64 7) (string-to-bytes "5e-324") "" 0 "" "" ""),
      (typed-case json-float64-type (string-to-bytes "1e-9999") (i64-to-f64 7) (string-to-bytes "0") "" 0 "" "" ""),
      (typed-case json-float64-type (string-to-bytes "-1e-9999") (i64-to-f64 7) (string-to-bytes "-0") "" 0 "" "" ""),
      (typed-case json-float64-type (string-to-bytes "1e9999") (i64-to-f64 7) (string-to-bytes "7") "type" 6 "number 1e9999" "F64" ""),
      (typed-case json-float64-type (string-to-bytes "\"1\"") (i64-to-f64 7) (string-to-bytes "7") "type" 3 "string" "F64" ""),
      (typed-case json-float64-type (string-to-bytes "true") (i64-to-f64 7) (string-to-bytes "7") "type" 4 "boolean" "F64" "")] 13

