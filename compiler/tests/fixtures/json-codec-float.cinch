  check-batch3 unit = first-failure [
      (typed-case json-float64-type (string-to-bytes "[]") (i64-to-f64 7) (string-to-bytes "7") "type" 1 "array" "F64" ""),
      (typed-case json-float64-type (string-to-bytes "{}") (i64-to-f64 7) (string-to-bytes "7") "type" 1 "object" "F64" ""),
      (float-encode-case (0 :: U64) (string-to-bytes "0") "" ""),
      (float-encode-case (9223372036854775808 :: U64) (string-to-bytes "-0") "" ""),
      (float-encode-case (1 :: U64) (string-to-bytes "5e-324") "" ""),
