-- | Exact bounded UTF-8 status, absolute offsets, malformed fringes and owner-alias observations.
module Main where
  import Data.Bytes.Utf8
  import Data.Bytes
  import Data.Bool
  import Data.Char
  import Data.Nat
  import Data.Option
  import Data.String hiding (utf8-encode-into)

  -- | Check presence and the exact replacement-inclusive scalar count.
  count :: Bytes -> Nat -> Nat -> Nat -> Bool
  count source start end expected = case utf8-count-between source start end of
    None -> False
    Some actual -> actual == expected

  -- | Check a valid bounded scalar without conflating its width with source byte offsets.
  scalar :: Bytes -> Nat -> Nat -> Nat -> Char -> Nat -> Bool
  scalar source start end at expected width = let step = utf8-decode-between source start end at in
    utf8-step-char step == expected && utf8-step-width step == width
      && (case utf8-step-status step of Utf8Valid -> True; other -> False)

  -- | Distinguish one-byte malformed progress from zero-width end and invalid metadata.
  status :: Bytes -> Nat -> Nat -> Nat -> Nat -> Nat -> Bool
  status source start end at expected width = let step = utf8-decode-between source start end at in
    utf8-step-char step == utf8-rune-error && utf8-step-width step == width
      && (case utf8-step-status step of Utf8End -> expected == 0; Utf8Valid -> False; Utf8Invalid -> expected == 2; Utf8OutOfBounds -> expected == 3)

  -- | Reject reversed, oversized and mathematical-Nat bounds before reading or narrowing them.
  refusals :: Unit -> Bool
  refusals unit = let source = bytes-from-list [65,66] in
    (case utf8-count-between source 2 1 of None -> True; Some value -> False)
      && (case utf8-count-between source 0 3 of None -> True; Some value -> False)
      && (case utf8-count-between source 0 18446744073709551616 of None -> True; Some value -> False)
      && (case utf8-count-between source 18446744073709551616 18446744073709551616 of None -> True; Some value -> False)
      && status source 2 1 1 3 0 && status source 0 3 0 3 0
      && status source 0 18446744073709551616 0 3 0
      && status source 0 2 18446744073709551616 3 0
      && status source 1 2 0 3 0 && status source 1 2 3 3 0
      && count source 0 0 0 && count source 1 1 0 && count source 2 2 0
      && status source 0 0 0 0 0 && status source 1 1 1 0 0 && status source 2 2 2 0 0

  -- | Treat both span endpoints as independent decoding boundaries.
  fringes :: Bytes -> Bool
  fringes source = count source 32 35 1 && scalar source 32 35 32 '\u{20AC}' 3
      && count source 32 34 2 && status source 32 34 32 2 1
      && count source 33 35 2 && status source 33 35 33 2 1
      && status source 32 35 31 3 0 && status source 32 35 35 0 0
      && scalar source 35 39 35 '\u{1F600}' 4
      && count source 35 38 3 && status source 35 38 35 2 1

  -- | Owner aliases observe later mutations, while unrelated bytes never affect bounded decoding.
  aliases :: Unit -> Bool
  aliases unit = let source = string-to-bytes "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\u{20AC}\u{1F600}z" in
    let alias = source in
    let initial = fringes source in
    let outside = if bytes-len alias > 39 then bytes-set alias 39 255 else () in
    let prefix = if bytes-len alias > 0 then bytes-set alias 0 255 else () in
    let unchanged = count source 32 35 1 && scalar source 32 35 32 '\u{20AC}' 3 in
    let end-fringe = if bytes-len alias > 34 then bytes-set alias 34 255 else () in
    let truncated = count source 32 34 2 && status source 32 34 32 2 1 in
    let inside = if bytes-len alias > 32 then bytes-set alias 32 65 else () in
    initial && unchanged && truncated && count source 32 35 3 && scalar source 32 35 32 'A' 1
      && status source 32 35 33 2 1

  -- | Exercise both bounded scalar queries without materializing a source slice.
  main :: Int
  main = if refusals () && aliases () then 0 else 1
