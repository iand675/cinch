    (compare-case 257 257 258 True),
    (compare-case 257 257 0 False),
    (compare-case 257 257 128 False),
    (compare-case 257 257 256 False),
    (compare-case 257 258 259 False),
    (copy-case 256 257 False False True 2268667311456260081),
    (copy-case 257 257 False False False 7179628890804357933),
    (copy-case 258 257 False False True 15333830990617327278),
    (copy-case 257 257 False True False 8916742896613052180),
    (copy-case 256 257 True False True 2268667311456260081),
    (copy-case 257 257 True False False 8916742896613052180),
    (copy-case 258 257 True False True 15333830990617327278),
    (copy-case 257 257 True True False 8916742896613052180),
    (xor-case 0 257 0 0 False 0 14695981039346656037),
    (xor-case 3 257 0 0 False 0 1682809251283843753)
    ]

  -- | Observe complete independent result group 59.
  group59 :: Unit -> Bool
  group59 unit = all [
    (xor-case 257 257 0 1 False 0 8916742896613052180),
    (xor-case 0 257 0 2 False 0 14695981039346656037),
    (xor-case 127 257 128 0 True 0 8193150785052117046),
    (xor-case 128 257 128 0 False 128 3760081923856424203),
    (xor-case 131 257 128 0 False 128 6044886678648748093),
    (xor-case 257 257 128 1 False 128 15297507786957602375),
    (xor-case 128 257 128 2 False 128 3760081923856424203),
    (xor-case 256 257 257 0 True 0 14699151753962475753),
    (xor-case 257 257 257 0 False 257 13507299227932077398),
    (xor-case 260 257 257 0 False 257 6226485832631981322),
    (xor-case 257 257 257 1 False 257 13507299227932077398),
    (xor-case 257 257 257 2 False 257 13507299227932077398),
    (xor-case 256 257 258 0 True 0 14699151753962475753),
    (xor-case 257 257 258 0 False 257 13507299227932077398),
    (xor-case 260 257 258 0 False 257 6226485832631981322),
    (xor-case 257 257 258 1 False 257 13507299227932077398)
    ]

  -- | Observe complete independent result group 60.
  group60 :: Unit -> Bool
  group60 unit = all [
    (xor-case 258 257 258 2 False 257 5912496381931255123)
    ]

  -- | Select one bounded complete observation group.
  selected :: String -> Bool
  selected index = if index == "0" then group0 () else if index == "1" then group1 () else if index == "2" then group2 () else if index == "3" then group3 () else if index == "4" then group4 () else if index == "5" then group5 () else if index == "6" then group6 () else if index == "7" then group7 () else if index == "8" then group8 () else if index == "9" then group9 () else if index == "10" then group10 () else if index == "11" then group11 () else if index == "12" then group12 () else if index == "13" then group13 () else if index == "14" then group14 () else if index == "15" then group15 () else if index == "16" then group16 () else if index == "17" then group17 () else if index == "18" then group18 () else if index == "19" then group19 () else if index == "20" then group20 () else if index == "21" then group21 () else if index == "22" then group22 () else if index == "23" then group23 () else if index == "24" then group24 () else if index == "25" then group25 () else if index == "26" then group26 () else if index == "27" then group27 () else if index == "28" then group28 () else if index == "29" then group29 () else if index == "30" then group30 () else if index == "31" then group31 () else if index == "32" then group32 () else if index == "33" then group33 () else if index == "34" then group34 () else if index == "35" then group35 () else if index == "36" then group36 () else if index == "37" then group37 () else if index == "38" then group38 () else if index == "39" then group39 () else if index == "40" then group40 () else if index == "41" then group41 () else if index == "42" then group42 () else if index == "43" then group43 () else if index == "44" then group44 () else if index == "45" then group45 () else if index == "46" then group46 () else if index == "47" then group47 () else if index == "48" then group48 () else if index == "49" then group49 () else if index == "50" then group50 () else if index == "51" then group51 () else if index == "52" then group52 () else if index == "53" then group53 () else if index == "54" then group54 () else if index == "55" then group55 () else if index == "56" then group56 () else if index == "57" then group57 () else if index == "58" then group58 () else if index == "59" then group59 () else if index == "60" then group60 () else False

  -- | Run each group in an independent bounded process.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in case process-args () of
    Ok (Cons index Nil) -> if selected index then 0 else 1
    other -> 2
