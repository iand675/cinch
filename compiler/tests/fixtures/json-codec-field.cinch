  -- | Print the original failing observation and return a nonzero status on failure.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in
    let failed = first-result [check-batch0 (),check-batch1 (),check-batch2 (),check-batch3 (),check-batch4 (),check-batch5 (),check-batch6 (),check-batch7 (),check-batch8 (),check-batch9 (),check-batch10 (),check-batch11 (),check-batch12 (),check-batch13 (),check-batch14 (),check-batch15 (),check-batch16 (),check-batch17 ()] in
    let printed = ioWrite (string-to-bytes (string-concat (nat-to-string failed) "\n")) in
    if failed == 0 then 0 else 1
