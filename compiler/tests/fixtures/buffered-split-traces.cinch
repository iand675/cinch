  -- | Print the full first mismatch and normalize every failing process exit.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in
    let result0 = run-group0 () in if not (result0 == 0) then report-failure result0
    else let result1 = run-group1 () in if not (result1 == 0) then report-failure result1
    else let result2 = run-group2 () in if not (result2 == 0) then report-failure result2
    else let result3 = run-group3 () in if not (result3 == 0) then report-failure result3
