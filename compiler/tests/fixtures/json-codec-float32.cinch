  check-batch2 :: Unit -> Nat
  check-batch2 unit = first-failure [
      (typed-case json-float32-type (string-to-bytes "1e-9999") (i64-to-f32 7) (string-to-bytes "0") "" 0 "" "" ""),
      (typed-case json-float32-type (string-to-bytes "-1e-9999") (i64-to-f32 7) (string-to-bytes "-0") "" 0 "" "" ""),
      (typed-case json-float32-type (string-to-bytes "1e9999") (i64-to-f32 7) (string-to-bytes "7") "type" 6 "number 1e9999" "F32" ""),
      (typed-case json-float32-type (string-to-bytes "-1e9999") (i64-to-f32 7) (string-to-bytes "7") "type" 7 "number -1e9999" "F32" ""),
      (typed-case json-float32-type (string-to-bytes "\"1\"") (i64-to-f32 7) (string-to-bytes "7") "type" 3 "string" "F32" ""),
      (typed-case json-float32-type (string-to-bytes "true") (i64-to-f32 7) (string-to-bytes "7") "type" 4 "boolean" "F32" "")] 13

