  -- | Check a shallow bounded batch of independent fixture groups.
  block-a :: Unit -> Bool
  block-a unit = all-checks [rows-a (), rows-b (), rows-c (), rows-d (), rows-e (), rows-f (), rows-g (), rows-h ()]

  -- | Check a shallow bounded batch of independent fixture groups.
  block-b :: Unit -> Bool
  block-b unit = all-checks [rows-i (), rows-j (), rows-k (), rows-l (), rows-m (), rows-n (), rows-o (), rows-p ()]

  -- | Check a shallow bounded batch of independent fixture groups.
  block-c :: Unit -> Bool
  block-c unit = all-checks [rows-q (), rows-r (), rows-s (), rows-t (), rows-u (), rows-v (), rows-w (), rows-x ()]

  -- | Check a shallow bounded batch of independent fixture groups.
  block-d :: Unit -> Bool
  block-d unit = all-checks [rows-y (), rows-z (), rows-aa (), rows-ab (), rows-ac (), rows-ad (), rows-ae (), rows-af ()]

  -- | Check a shallow bounded batch of independent fixture groups.
  block-e :: Unit -> Bool
  block-e unit = all-checks [rows-ag (), rows-ah (), rows-ai (), rows-aj (), rows-ak (), rows-al (), rows-am (), rows-an ()]

  -- | Check a shallow bounded batch of independent fixture groups.
  block-f :: Unit -> Bool
  block-f unit = all-checks [rows-ao (), rows-ap (), rows-aq (), rows-ar (), rows-as (), rows-at (), rows-au (), long-a ()]

  -- | Check a shallow bounded batch of independent fixture groups.
  block-g :: Unit -> Bool
  block-g unit = all-checks [long-b (), long-c (), long-d (), long-e (), long-f (), long-g (), long-h (), long-i ()]

  -- | Check a shallow bounded batch of independent fixture groups.
  block-h :: Unit -> Bool
  block-h unit = all-checks [long-j (), long-k (), long-l (), long-m (), long-n (), long-o (), long-p (), long-q ()]

  -- | Check a shallow bounded batch of independent fixture groups.
  block-i :: Unit -> Bool
  block-i unit = all-checks [long-r (), long-s (), long-t (), long-u (), long-v (), long-w (), long-x (), long-y ()]

  -- | Check a shallow bounded batch of independent fixture groups.
  block-j :: Unit -> Bool
  block-j unit = all-checks [long-z (), long-aa (), long-ab (), long-ac (), long-ad (), long-ae (), long-af (), long-ag ()]

  -- | Check a shallow bounded batch of independent fixture groups.
  block-k :: Unit -> Bool
  block-k unit = all-checks [long-ah (), long-ai (), long-aj (), long-ak (), long-al (), long-am (), long-an (), long-ao ()]

  -- | Check a shallow bounded batch of independent fixture groups.
  block-l :: Unit -> Bool
  block-l unit = all-checks [long-ap (), long-aq (), long-ar (), long-as (), long-at (), long-au (), long-av (), long-aw ()]

  -- | Check a shallow bounded batch of independent fixture groups.
  block-m :: Unit -> Bool
  block-m unit = all-checks [long-ax (), long-ay (), long-az ()]

  -- | Check all rows normally or one exact group with poisoned frees.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in case process-args () of
    Err error -> 2
    Ok args -> case args of
      Nil -> if all-checks [block-a (), block-b (), block-c (), block-d (), block-e (), block-f (), block-g (), block-h (), block-i (), block-j (), block-k (), block-l (), block-m ()] then 0 else 1
      Cons name Nil -> if selected name then 0 else 1
      other -> 2
