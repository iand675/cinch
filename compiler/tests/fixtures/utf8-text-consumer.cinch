-- | Independent immutable-text scalar observations, sealed validity and copy isolation.
module Main where
  import Text.Utf8
  import Data.Bytes
  import Data.Bool
  import Data.Char
  import Data.List
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String hiding (utf8-encode-into)
  import Effect.Process

  -- | Check one exact scalar, consumed width and empty-versus-valid status independently.
  step :: Utf8Step -> Nat -> Nat -> Bool
  step value scalar width = char-code (utf8-step-char value) == scalar
    && utf8-step-width value == width
    && (if width == 0 then (case utf8-step-status value of Utf8End -> True; other -> False)
        else (case utf8-step-status value of Utf8Valid -> True; other -> False))

  -- | Check the String helper's own tuple metadata independently of the safe step factory.
  helper-step :: Option (Char, Nat) -> Nat -> Nat -> Bool
  helper-step observed scalar width = case observed of
    None -> scalar == 65533 && width == 0
    Some pair -> case pair of (cp, actual) -> char-code cp == scalar && actual == width

  -- | Observe all five public text operations without converting the immutable backing to Bytes.
  observe :: String -> Nat -> Nat -> Nat -> Nat -> Nat -> Bool -> Bool -> Bool
  observe text first first-width last last-width count full valid =
    helper-step (string-utf8-first text) first first-width
      && helper-step (string-utf8-last text) last last-width
      && step (utf8-first-text text) first first-width
      && step (utf8-last-text text) last last-width
      && utf8-count-text text == count
      && (if full then utf8-full-rune-text text else not (utf8-full-rune-text text))
      && (if valid then utf8-valid-text text else not (utf8-valid-text text))

  -- | Mutate a caller-owned buffer, leaving empty buffers unchanged.
  change :: Bytes -> Unit
  change bytes = if bytes-len bytes > 0 then bytes-set bytes 0 255 else ()

  -- | Mutating both conversion copies preserves the sealed snapshot and every scalar observation.
  check :: String -> Nat -> Nat -> Nat -> Nat -> Nat -> Bool -> Bool -> Bool
  check input first first-width last last-width count full valid =
    let bytes = string-to-bytes input in case string-from-bytes bytes of
      None -> False
      Some text ->
        let initial = observe text first first-width last last-width count full valid in
        let copy = string-to-bytes text in let a = change bytes in let b = change copy in
        initial && observe text first first-width last last-width count full valid
          && string-compare input text == 0

  -- | Fold only shallow fixture batches, keeping the compiler host stack bounded.
  all-checks :: List Bool -> Bool
  all-checks values = case values of Nil -> True; Cons value rest -> value && all-checks rest


  -- | Check independent short-text rows and both conversion aliases.
  rows-a :: Unit -> Bool
  rows-a unit = all-checks [check "" 65533 0 65533 0 0 False True, check "\u{0}" 0 1 0 1 1 True True, check "\u{0}\u{74}\u{61}\u{69}\u{6C}" 0 1 108 1 5 True True, check "\u{1}" 1 1 1 1 1 True True, check "\u{1}\u{74}\u{61}\u{69}\u{6C}" 1 1 108 1 5 True True, check "\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 6 True True, check "\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 6 True True, check "\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 7 True True, check "\u{61}\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 7 True True, check "\u{61}\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 8 True True, check "\u{61}\u{61}\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 8 True True, check "\u{61}\u{61}\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 9 True True, check "\u{61}\u{61}\u{61}\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 9 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 10 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 10 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 11 True True]

  -- | Check independent short-text rows and both conversion aliases.
  rows-b :: Unit -> Bool
  rows-b unit = all-checks [check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 11 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 12 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 12 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 13 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 13 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 14 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 14 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 15 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 15 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 16 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 16 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 17 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 17 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 18 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{1}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 18 True True, check "\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{61}\u{0}\u{74}\u{61}\u{69}\u{6C}" 97 1 108 1 19 True True]

