      (typed-case json-int8-type (string-to-bytes "-129") (7 :: I8) (string-to-bytes "7") "type" 4 "number -129" "I8" ""),
      (typed-case json-int8-type (string-to-bytes "255") (7 :: I8) (string-to-bytes "7") "type" 3 "number 255" "I8" ""),
