  group0 :: Unit -> Bool
  group0 unit = observe0 () && observe1 () && observe2 () && observe3 () && observe4 () && observe5 () && observe6 () && observe7 () && observe8 () && observe9 () && observe10 () && observe11 () && observe12 () && observe13 () && observe14 () && observe15 ()

