  -- | Fail with the first independent group index or the explicit interface-boundary status.
  main :: Int
  main = if not (group0 ()) then 1 else if not (group1 ()) then 2 else if not (group2 ()) then 3 else if not (group3 ()) then 4 else if not (group4 ()) then 5 else if not (interface-boundary ()) then 6 else 0
