  -- Test-only private context access; appended solely to the explicit integration-test source override.
  export payload-context-tests

  -- | Remove primitive evidence while keeping identical nominal kind headers.
  context-without-payloads :: TypeContext -> TypeContext
  context-without-payloads context = case context of
    MkTypeContext kinds aliases active observers effects source-classes payloads ->
      MkTypeContext kinds aliases active observers effects source-classes Nil

  -- | Inspect private authority with forged imported identities and otherwise identical context headers.
  payload-context-tests :: Unit -> Bool
  payload-context-tests unit =
    let owner = "m.PayloadContext.Arena" in
    let recursive = UCon owner KType in
    let constructor-kind = KFun KType KType in
    let array = UCon "Array" constructor-kind in
    let candidate = UApp array recursive in
    let group = [owner] in
    let fake-identity = DExternal zero "LocalAlias" "type" None (JObj "identity" (JStr "Array") JObjEnd) in
    let fake-name = DExternal zero "Array" "type" None JObjEnd in
    let ordinary = DExternal zero "Ordinary" "type" None
          (JObj "identity" (JStr "Other.Array") (JObj "strict_positive_payload" (JBool True) JObjEnd)) in
    let value = DExternal zero "LocalValue" "value" None (JObj "identity" (JStr "Array") JObjEnd) in
    let quantified = UForall (QCons (MkQuant 1 "x" (KValue recursive) False) QEnd) (UCon "Unit" KType) in
    positive primitive-kinds group candidate
      && not (positive (context-without-payloads primitive-kinds) group candidate)
      && not (positive (context-add-kind "Array" constructor-kind primitive-kinds) group candidate)
      && not (positive (context-add-alias fake-identity primitive-kinds) group candidate)
      && not (positive (context-add-alias fake-name primitive-kinds) group candidate)
      && positive (context-add-alias ordinary primitive-kinds) group candidate
      && positive (context-add-alias value primitive-kinds) group candidate
      && not (positive primitive-kinds group (UApp (UCon "Other.Array" constructor-kind) recursive))
      && not (positive primitive-kinds group (UApp (UBound 2 "Array" constructor-kind) recursive))
      && not (positive primitive-kinds group (UApp (UCon "Array" (KFun KRegion KType)) recursive))
      && not (positive primitive-kinds group (UApp candidate (UCon "Unit" KType)))
      && not (positive primitive-kinds group quantified)
      && not (positive primitive-kinds group (UApp array quantified))
      && not (positive primitive-kinds group (UApp array (URefine 3 "x" recursive (UPropLit True))))
