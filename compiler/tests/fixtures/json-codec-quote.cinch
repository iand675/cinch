      (quote-case (runtime-bytes (bytes-from-list [244,144,128,128])) True (string-to-bytes "\"����\"") (string-to-bytes "����")),
      (quote-case (runtime-bytes (string-to-bytes "�")) False (string-to-bytes "\"�\"") (string-to-bytes "�")),
      (quote-case (runtime-bytes (string-to-bytes "�")) True (string-to-bytes "\"�\"") (string-to-bytes "�")),
      (quote-case (runtime-bytes (string-to-bytes "")) False (string-to-bytes "\"\"") (string-to-bytes "")),
