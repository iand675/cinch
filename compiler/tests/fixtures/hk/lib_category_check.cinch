-- The shipped category family end to end (it RUNS): the Identity and
-- Const universal visitors exercised through the real
-- Functor/Applicative/Monad classes, with the law groups over sample
-- values and the visitors' round trip.
--
-- Simplification (the D127 collapse): this fixture previously carried
-- inline copies of Data.Identity and Data.Const. Those are the shipped
-- modules now (compiler/prelude/Data/{Identity,Const}.cinch, carrying
-- their class instances), so the copies are gone and compiler/tests/hk.rs
-- assembles this file with the shipped modules. The law bodies below
-- call the real class methods (`map`, `pure`, `<*>`, `lift-a2`, `>>=`,
-- `join`); the law groups and their exit codes are the acceptance.
module Main where
  import Category.Functor
  import Category.Applicative
  import Category.Monad
  import Data.Identity
  import Data.Const

  functor-identity-law :: forall a. using (eq :: Eq a) => Identity a -> Bool
  functor-identity-law v =
    run-identity (map (\x -> x) v) == run-identity v

  functor-composition-law :: forall a b c. using (eq :: Eq c) => (b -> c) -> (a -> b) -> Identity a -> Bool
  functor-composition-law g f v =
    let left = run-identity (map g (map f v)) in
    let right = run-identity (map (\x -> g (f x)) v) in
    left == right

  applicative-homomorphism-law :: forall a b. using (eq :: Eq b) => (a -> b) -> a -> Bool
  applicative-homomorphism-law f x =
    run-identity (pure (f x)) == run-identity ((<*>) (pure f) (pure x))

  monad-left-identity-law :: forall a b. using (eq :: Eq b) => a -> (a -> Identity b) -> Bool
  monad-left-identity-law x k =
    run-identity ((>>=) (pure x) k) == run-identity (k x)

  monad-right-identity-law :: forall a. using (eq :: Eq a) => Identity a -> Bool
  monad-right-identity-law v =
    run-identity ((>>=) v pure) == run-identity v

  monad-associativity-law :: forall a b c. using (eq :: Eq c) => Identity a -> (a -> Identity b) -> (b -> Identity c) -> Bool
  monad-associativity-law v f g =
    let left = run-identity ((>>=) ((>>=) v f) g) in
    let right = run-identity ((>>=) v (\x -> (>>=) (f x) g)) in
    left == right

  monad-join-associativity-law :: forall a. using (eq :: Eq a) => Identity (Identity (Identity a)) -> Bool
  monad-join-associativity-law vvv =
    let left = run-identity (join (map join vvv)) in
    let right = run-identity (join (join vvv)) in
    left == right

  const-functor-identity-law :: forall m a. using (eq :: Eq m) => Const m a -> Bool
  const-functor-identity-law c =
    get-const (map (\x -> x) c) == get-const c

  const-functor-composition-law :: forall m a b r. using (eq :: Eq m) => (b -> r) -> (a -> b) -> Const m a -> Bool
  const-functor-composition-law g f c =
    let left = get-const (map g (map f c)) in
    let right = get-const (map (\x -> g (f x)) c) in
    left == right

  const-constant-law :: forall m a b. using (eq :: Eq m) => (a -> b) -> (a -> b) -> Const m a -> Bool
  const-constant-law f h c = get-const (map f c) == get-const (map h c)

  main :: Int
  main =
    let v = (Identity 7 :: Identity Int) in
    let w = Identity True in
    let c = (Const 11 :: Const Int Int) in
    let s = (Const 'q' :: Const Char Int) in
    if functor-identity-law v then
      if functor-identity-law w then
        if functor-composition-law (\x -> x * 2) (\x -> x + 1) v then
          if functor-composition-law (\p -> if p then False else True) (\p -> if p then False else True) w then
            if applicative-homomorphism-law (\x -> x + 1) (5 :: Int) then
              if monad-left-identity-law (4 :: Int) (\x -> Identity (x + 3)) then
                if monad-right-identity-law v then
                  if monad-associativity-law v (\x -> Identity (x + 4)) (\x -> Identity (x * 5)) then
                    if monad-join-associativity-law (Identity (Identity (Identity (6 :: Int)))) then
                      if const-functor-identity-law c then
                        if const-functor-composition-law (\x -> x * 2) (\x -> x + 1) c then
                          if const-constant-law (\x -> x + 1) (\x -> x * 3) c then
                            if const-functor-identity-law s then
                              if run-identity (lift-a2 (\x y -> x + y) (Identity (2 :: Int)) (Identity (3 :: Int))) == 5 then 0 else 14
                            else 13
                          else 12
                        else 11
                      else 10
                    else 9
                  else 8
                else 7
              else 6
            else 5
          else 4
        else 3
      else 2
    else 1
