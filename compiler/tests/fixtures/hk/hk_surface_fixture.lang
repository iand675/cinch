-- Acceptance fixture for the higher-kinded surface slice: the Category
-- family exactly as design/base-library.md and the category slice
-- specify it. Today the file fails at the first type-constructor
-- application (`f a` in map's type: "cannot apply non-type-constructor
-- f", check.rs `type_app`); after the slice (var-headed type application
-- with beta-reducing substitution, partially applied type constructors as
-- class and instance arguments, the `(->)` type former, kind binders for
-- signature parameters, dotted module-name resolution) this file MUST
-- check, and `lib_category.rs`'s law statements MUST instantiate at its
-- instances. Instance bodies use only constructors, case, and their own
-- method names (self-instance resolution), so no prelude function name is
-- referenced. Operators carry per-module fixity declarations (decision
-- D2): `<$>`/`<*>` infixl 4, `<|>` infixl 3 and `>>=` infixl 1 follow
-- Haskell's table; note `>>=` and `||` share precedence 1 with opposite
-- associativity and so cannot mix in one expression.
module Category.Functor where

  signature Functor (f :: Type -> Type) where
    map :: forall a b. (a -> b) -> f a -> f b
    (<$>) :: forall a b. (a -> b) -> f a -> f b

  infixl 4 <$>

  -- Structural instances over functions live with the class module (the
  -- module scheme's ownership rule).
  implicit instance Functor_Function r :: Functor ((->) r) where
    map f g x = f (g x)
    (<$>) f g x = f (g x)

module Category.Applicative where

  signature Applicative (f :: Type -> Type) where
    pure :: forall a. a -> f a
    (<*>) :: forall a b. f (a -> b) -> f a -> f b
    lift-a2 :: forall a b c. (a -> b -> c) -> f a -> f b -> f c

  infixl 4 <*>

  implicit instance Applicative_Function r :: Applicative ((->) r) where
    pure x _ = x
    (<*>) ff fx r = (ff r) (fx r)
    lift-a2 f fx fy r = f (fx r) (fy r)

module Category.Monad where

  signature Monad (f :: Type -> Type) where
    (>>=) :: forall a b. f a -> (a -> f b) -> f b
    join :: forall a. f (f a) -> f a

  infixl 1 >>=

  implicit instance Monad_Function r :: Monad ((->) r) where
    (>>=) fx k r = (k (fx r)) r
    join ffx r = (ffx r) r

module Category.Alternative where

  signature Alternative (f :: Type -> Type) where
    empty :: forall a. f a
    (<|>) :: forall a. f a -> f a -> f a

  infixl 3 <|>

module Data.Compose where

  data Compose f g a where
    Compose :: f (g a) -> Compose f g a

  get-compose :: forall f g a. Compose f g a -> f (g a)
  get-compose c = case c of
    Compose x -> x

-- The List/Option/Result instance families. The scheme places an
-- instance with its type; these types are declared in Prelude until the
-- prelude split moves them to Data.List/Data.Option/Data.Result, so the
-- shipped instances go where the type is declared at the time. The
-- shapes are the acceptance target.
module Category.TypeInstances where
  import Category.Functor
  import Category.Applicative
  import Category.Monad
  import Category.Alternative

  implicit instance Functor_List :: Functor List where
    map f xs = case xs of
      Nil -> Nil
      Cons y ys -> Cons (f y) (map f ys)
    (<$>) f xs = map f xs

  implicit instance Functor_Option :: Functor Option where
    map f o = case o of
      None -> None
      Some x -> Some (f x)
    (<$>) f o = map f o

  implicit instance Functor_Result e :: Functor (Result e) where
    map f r = case r of
      Err e -> Err e
      Ok x -> Ok (f x)
    (<$>) f r = map f r

  implicit instance Applicative_List :: Applicative List where
    pure x = Cons x Nil
    (<*>) fs xs = case fs of
      Nil -> Nil
      Cons g gs -> append-list (map-list g xs) ((<*>) gs xs)
    lift-a2 f xs ys = (<*>) (map f xs) ys

  implicit instance Applicative_Option :: Applicative Option where
    pure x = Some x
    (<*>) g ox = case g of
      None -> None
      Some f -> case ox of
        None -> None
        Some x -> Some (f x)
    lift-a2 f ox oy = (<*>) (map f ox) oy

  implicit instance Applicative_Result e :: Applicative (Result e) where
    pure x = Ok x
    (<*>) rf rx = case rf of
      Err e -> Err e
      Ok f -> case rx of
        Err e -> Err e
        Ok x -> Ok (f x)
    lift-a2 f rx ry = (<*>) (map f rx) ry

  implicit instance Monad_List :: Monad List where
    (>>=) xs k = case xs of
      Nil -> Nil
      Cons y ys -> append-list (k y) ((>>=) ys k)
    join xss = case xss of
      Nil -> Nil
      Cons ys yss -> append-list ys (join yss)

  implicit instance Monad_Option :: Monad Option where
    (>>=) o k = case o of
      None -> None
      Some x -> k x
    join oo = case oo of
      None -> None
      Some o -> o

  implicit instance Monad_Result e :: Monad (Result e) where
    (>>=) r k = case r of
      Err e -> Err e
      Ok x -> k x
    join rr = case rr of
      Err e -> Err e
      Ok r -> r

  implicit instance Alternative_Option :: Alternative Option where
    empty = None
    (<|>) o1 o2 = case o1 of
      None -> o2
      Some x -> Some x

  implicit instance Alternative_List :: Alternative List where
    empty = Nil
    (<|>) xs ys = append-list xs ys

  append-list :: forall a. List a -> List a -> List a
  append-list xs ys = case xs of
    Nil -> ys
    Cons z zs -> Cons z (append-list zs ys)

  map-list :: forall a b. (a -> b) -> List a -> List b
  map-list f xs = case xs of
    Nil -> Nil
    Cons y ys -> Cons (f y) (map-list f ys)

-- The polymorphic law statements: this is what the classes buy over the
-- do providers (D22). A do-provider is one fixed instance choice per
-- definition; these quantify over the container and run at every
-- instance. They typecheck once the slice lands; running them over
-- samples additionally needs the containers' `Eq` instances, which ship
-- with their types in the prelude split.
module Category.FamilyLaws where
  import Category.Functor
  import Category.Applicative
  import Category.Monad

  functor-identity :: forall f a. using (fun :: Functor f, eq :: Eq (f a)) => f a -> Bool
  functor-identity v = map (\x -> x) v == v

  functor-composition :: forall f a b c. using (fun :: Functor f, eq :: Eq (f c)) => (b -> c) -> (a -> b) -> f a -> Bool
  functor-composition g f v = map g (map f v) == map (\x -> g (f x)) v

  applicative-homomorphism :: forall f a b. using (app :: Applicative f, eq :: Eq (f b)) => (a -> b) -> a -> Bool
  applicative-homomorphism f x = pure (f x) == (<*>) (pure f) (pure x)

  monad-left-identity :: forall f a b. using (mon :: Monad f, app :: Applicative f, eq :: Eq (f b)) => a -> (a -> f b) -> Bool
  monad-left-identity x k = (>>=) (pure x) k == k x

  monad-right-identity :: forall f a. using (mon :: Monad f, app :: Applicative f, eq :: Eq (f a)) => f a -> Bool
  monad-right-identity v = (>>=) v pure == v

  monad-associativity :: forall f a b c. using (mon :: Monad f, eq :: Eq (f c)) => f a -> (a -> f b) -> (b -> f c) -> Bool
  monad-associativity v f g = (>>=) ((>>=) v f) g == (>>=) v (\x -> (>>=) (f x) g)
