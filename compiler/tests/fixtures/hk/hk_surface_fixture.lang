-- Acceptance fixture for the higher-kinded surface slice: the
-- polymorphic law statements of the Category family, exactly as
-- design/base-library.md and the category slice specify them.
--
-- Simplification (the D127 collapse): the fixture previously carried
-- inline copies of the class surface (Category.Functor,
-- Category.Applicative, Category.Monad, Category.Alternative,
-- Data.Compose) and the instance families (Category.TypeInstances).
-- Those ARE the shipped modules now (compiler/prelude/Category/*.lang,
-- compiler/prelude/Data/{Compose,Identity,Const}.lang), so the copies
-- are gone and compiler/tests/hk.rs assembles this file with the
-- shipped modules. What remains here is what only exists as an
-- acceptance artifact: the law statements quantified over the
-- container. They typecheck against the shipped surface, and
-- `lib_category.rs` runs the same groups over sample values at the
-- shipped instances.
--
-- The statements exercise the higher-kinded surface end to end:
-- var-headed type application (`f a`, `f (f a)`), class constraints at
-- higher kind (`Functor f`, `Eq (f a)`), and decision D152's law shape:
-- the monad laws state `pure` under an added `Applicative f`
-- constraint, and a bare `pure` reaches that constraint's method
-- (decision D153).
module Category.FamilyLaws where
  import Category.Functor
  import Category.Applicative
  import Category.Monad

  functor-identity :: forall f a. using (fun :: Functor f, eq :: Eq (f a)) => f a -> Bool
  functor-identity v = map (\x -> x) v == v

  functor-composition :: forall f a b c. using (fun :: Functor f, eq :: Eq (f c)) => (b -> c) -> (a -> b) -> f a -> Bool
  functor-composition g f v = map g (map f v) == map (\x -> g (f x)) v

  applicative-homomorphism :: forall f a b. using (app :: Applicative f, eq :: Eq (f b)) => (a -> b) -> a -> Bool
  applicative-homomorphism f x = pure (f x) == (<*>) (pure f) (pure x)

  monad-left-identity :: forall f a b. using (mon :: Monad f, app :: Applicative f, eq :: Eq (f b)) => a -> (a -> f b) -> Bool
  monad-left-identity x k = (>>=) (pure x) k == k x

  monad-right-identity :: forall f a. using (mon :: Monad f, app :: Applicative f, eq :: Eq (f a)) => f a -> Bool
  monad-right-identity v = (>>=) v pure == v

  monad-associativity :: forall f a b c. using (mon :: Monad f, eq :: Eq (f c)) => f a -> (a -> f b) -> (b -> f c) -> Bool
  monad-associativity v f g = (>>=) ((>>=) v f) g == (>>=) v (\x -> (>>=) (f x) g)
