-- | Signed events, retained transfer callbacks, authoritative continuations and managed-cell reclamation.
module Main where
  import Effect.Buffered.Core
  import Effect.Stream
  import Effect.Io
  import Data.Bytes
  import Data.Bool
  import Data.Int
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String

  -- | Compare complete arbitrary byte observations without a text conversion.
  same :: Bytes -> Bytes -> Bool
  same first second = let ordering = bytes-compare first second in eq-i64 ordering 0

  -- | Copy one checked raw-source interval into independently mutable event storage.
  part :: Bytes -> Nat -> Nat -> Bytes
  part source at count = if at + count <= bytes-len source then
    let out = bytes-new count in let copied = bytes-copy-range out source 0 at count in out
    else bytes-new 0

  -- | Produce raw events with explicit byte counts and an end status only after the final data event.
  memory-source :: forall r. using (io :: Io r) => Bytes -> Nat -> BufferSource r
  memory-source input at = let plain = buffer-source (\wanted -> memory-read input at wanted) in
    if at == 0 then buffer-source-with-transfer plain (\write -> (TransferEvent 0 None, plain)) else plain

  -- | Advance a source's immutable cursor; zero reads neither consume input nor report end-of-input.
  memory-read :: forall r. using (io :: Io r) => Bytes -> Nat -> Nat ->{IO r} (ReadEvent, BufferSource r)
  memory-read input at wanted = if at <= bytes-len input then
    let remaining = bytes-len input - at in let count = if wanted < remaining then wanted else remaining in
    let output = part input at count in let terminal = if wanted > 0 && count == 0 then Some BufferEnd else None in
    (ReadEvent (nat-to-int count) output terminal, memory-source input (at + count))
    else (ReadEvent 0 (bytes-new 0) (Some BufferEnd), memory-source input at)

  -- | Keep a sink's logical cursor in its continuation rather than an externally shared counter.
  memory-sink :: forall r. using (io :: Io r) => Bytes -> Nat -> BufferSink r
  memory-sink output at = let plain = buffer-sink (\input -> memory-write output at input) in
    if at == 0 then buffer-sink-with-transfer plain (\read -> (TransferEvent 0 None, plain)) else plain

  -- | Copy the accepted offer at the continuation's exact cursor and return its advanced sink.
  memory-write :: forall r. using (io :: Io r) => Bytes -> Nat -> Bytes ->{IO r} (WriteEvent, BufferSink r)
  memory-write output at input = let size = bytes-len input in
    if at + size <= bytes-len output then
      let copied = bytes-copy-range output input at 0 size in
      (WriteEvent (nat-to-int size) None, memory-sink output (at + size))
    else (WriteEvent 0 (Some (BufferCustomError "fixture capacity")), memory-sink output at)

  -- | Check accepted read bytes while keeping data-plus-error events distinguishable from failures without data.
  read-is :: ReadEvent -> String -> Bool
  read-is event expected = case event of
    ReadEvent count payload status -> count == nat-to-int (bytes-len payload) && same payload (string-to-bytes expected)

  -- | Check a valid sink count independently of its optional terminal status.
  write-is :: WriteEvent -> Int -> Bool
  write-is event expected = case event of WriteEvent count status -> count == expected

  -- | A negative source report retains all malformed-count metadata instead of reaching an index conversion.
  negative-read-count :: Bytes -> Bool
  negative-read-count payload = case buffer-read-accepted 8 (ReadEvent (-1) payload None) of
    Err (BufferInvalidReadCount wanted actual supplied) -> wanted == 8 && actual == (-1) && supplied == 3
    other -> False

  -- | Validate all signed count boundaries before any count becomes a byte index.
  counts :: Unit -> Bool
  counts unit = let payload = string-to-bytes "ABC" in
    let good-read = case buffer-read-accepted 8 (ReadEvent 2 payload (Some BufferEnd)) of Ok count -> count == 2; Err error -> False in
    let negative-read = negative-read-count payload in
    let excess-read = case buffer-read-accepted 2 (ReadEvent 3 payload None) of Err error -> True; Ok count -> False in
    let missing-read = case buffer-read-accepted 8 (ReadEvent 4 payload None) of Err error -> True; Ok count -> False in
    let huge-read = case buffer-read-accepted 8 (ReadEvent 999999999999999999999999 payload None) of Err error -> True; Ok count -> False in
    let good-write = case buffer-write-accepted 3 (WriteEvent 2 (Some BufferEnd)) of Ok count -> count == 2; Err error -> False in
    let negative-write = case buffer-write-accepted 3 (WriteEvent (-1) None) of Err error -> True; Ok count -> False in
    let excess-write = case buffer-write-accepted 3 (WriteEvent 4 None) of Err error -> True; Ok count -> False in
    good-read && negative-read && excess-read && missing-read && huge-read && good-write && negative-write && excess-write

  -- | Retain the transfer's write operation in an advanced source and invoke it after the transfer returned.
  retained-write-source :: forall r. using (io :: Io r) => (Bytes ->{IO r} WriteEvent) -> BufferSource r
  retained-write-source write = buffer-source (\wanted -> retained-write-step write wanted)

  -- | A retained callback must observe writes performed through the separately returned sink handle.
  retained-write-step :: forall r. using (io :: Io r) => (Bytes ->{IO r} WriteEvent) -> Nat ->{IO r} (ReadEvent, BufferSource r)
  retained-write-step write wanted = let event = write (string-to-bytes "C") in
    (ReadEvent 1 (string-to-bytes "R") None, memory-source (bytes-new 0) 0)

  -- | A source transfer writes its prefix and returns a source that still owns the supplied write callback.
  transferring-source :: forall r. using (io :: Io r) => BufferSource r
  transferring-source = let plain = memory-source (bytes-new 0) 1 in
    buffer-source-with-transfer plain (\write -> transfer-source-step write)

  -- | Preserve the transfer's exact count without exposing or capturing the private continuation cell.
  transfer-source-step :: forall r. using (io :: Io r) => (Bytes ->{IO r} WriteEvent) ->{IO r} (TransferEvent, BufferSource r)
  transfer-source-step write = let event = write (string-to-bytes "AB") in
    (TransferEvent 2 None, retained-write-source write)

  -- | Interleave returned-handle writes and a later retained callback; every byte must append once.
  source-transfer-control :: forall r. using (io :: Io r) => Unit ->{IO r} Bool
  source-transfer-control unit = let output = bytes-new 5 in
    let sink = memory-sink output 0 in let initial-capability = buffer-sink-has-transfer sink in
    case buffer-source-transfer transferring-source sink of
      (None, source, next) -> False
      (Some event, source, next) -> let correct-count = case event of TransferEvent count status -> eq-i64 count 2 in
        let current-capability = buffer-sink-has-transfer next in
        case buffer-sink-write next (string-to-bytes "D") of
          (written, after-first) -> case buffer-source-read source 1 of
            (read, after-source) -> case buffer-sink-write after-first (string-to-bytes "E") of
              (last, after-last) -> initial-capability && not current-capability && correct-count
                && write-is written 1 && read-is read "R" && write-is last 1
                && same output (string-to-bytes "ABDCE")

  -- | Retain a supplied read operation in an advanced sink and observe its next byte later.
  retained-read-sink :: forall r. using (io :: Io r) => (Nat ->{IO r} ReadEvent) -> Bytes -> BufferSink r
  retained-read-sink read output = buffer-sink (\input -> retained-read-step read output input)

  -- | The retained read must follow reads made through the separately returned source handle.
  retained-read-step :: forall r. using (io :: Io r) => (Nat ->{IO r} ReadEvent) -> Bytes -> Bytes ->{IO r} (WriteEvent, BufferSink r)
  retained-read-step read output input = case read 1 of
    ReadEvent count payload status ->
      if bytes-len payload == 1 && bytes-len output == 1 then
        let copied = bytes-copy-range output payload 0 0 1 in
        (WriteEvent (nat-to-int (bytes-len input)) None, memory-sink (bytes-new 0) 0)
      else (WriteEvent 0 (Some (BufferCustomError "missing retained byte")), memory-sink (bytes-new 0) 0)

  -- | A sink transfer reads a prefix and retains its reader in the returned advanced sink.
  transferring-sink :: forall r. using (io :: Io r) => Bytes -> BufferSink r
  transferring-sink output = let plain = memory-sink (bytes-new 0) 1 in
    buffer-sink-with-transfer plain (\read -> transfer-sink-step read output)

  -- | Keep direct-transfer count reporting independent from the later retained read operation.
  transfer-sink-step :: forall r. using (io :: Io r) => (Nat ->{IO r} ReadEvent) -> Bytes ->{IO r} (TransferEvent, BufferSink r)
  transfer-sink-step read output = let first = read 1 in
    (TransferEvent 1 None, retained-read-sink read output)

  -- | Interleave returned-source reads and a later retained callback, preserving capability changes and order.
  sink-transfer-control :: forall r. using (io :: Io r) => Unit ->{IO r} Bool
  sink-transfer-control unit = let observed = bytes-new 1 in
    let source = memory-source (string-to-bytes "ABCD") 0 in
    let initial-capability = buffer-source-has-transfer source in
    case buffer-sink-transfer (transferring-sink observed) source of
      (None, next-source, next-sink) -> False
      (Some event, next-source, next-sink) -> let correct-count = case event of TransferEvent count status -> eq-i64 count 1 in
        let current-capability = buffer-source-has-transfer next-source in
        case buffer-source-read next-source 1 of
          (read, after-first) -> case buffer-sink-write next-sink (string-to-bytes "X") of
            (written, after-sink) -> case buffer-source-read after-first 1 of
              (last, after-last) -> initial-capability && not current-capability && correct-count
                && read-is read "B" && write-is written 1 && read-is last "D"
                && same observed (string-to-bytes "C")

  -- | Unsupported transfer capabilities leave both continuations untouched and perform no transport I/O.
  absent-transfer-control :: forall r. using (io :: Io r) => Unit ->{IO r} Bool
  absent-transfer-control unit = let output = bytes-new 4 in
    let source = memory-source (string-to-bytes "AB") 1 in let sink = memory-sink output 1 in
    case buffer-source-transfer source sink of
      (Some event, next-source, next-sink) -> False
      (None, next-source, next-sink) -> case buffer-sink-transfer next-sink next-source of
        (Some event, final-source, final-sink) -> False
        (None, final-source, final-sink) -> case buffer-source-read final-source 1 of
          (event, after) -> read-is event "B" && same output (bytes-new 4)

  -- | Produce an existing stream failure followed by an independently usable next reader.
  failing-reader :: forall r. using (io :: Io r) => ByteReader r
  failing-reader = stream-reader (\wanted -> (Err (StreamClosed "reader-once"), reader-from-string "Q"))

  -- | Produce an existing stream failure followed by an independently usable next sink.
  failing-writer :: forall r. using (io :: Io r) => ByteWriter r
  failing-writer = stream-writer (\input -> (Err (StreamClosed "writer-once"), writer-discard))

  -- | Stream adapters preserve structured failures, zero-request semantics and authoritative next handles.
  stream-adapters :: forall r. using (io :: Io r) => Unit ->{IO r} Bool
  stream-adapters unit = let source = buffer-source-from-stream (reader-from-string "A") in
    case buffer-source-read source 0 of
      (zero, next) -> let nonterminal = case zero of ReadEvent count payload status -> count == 0 && (case status of None -> True; Some error -> False) in
        case buffer-source-read next 1 of
          (first, after) -> case buffer-source-read after 1 of
            (last, final) -> let ended = case last of ReadEvent count payload status -> count == 0 && (case status of Some BufferEnd -> True; other -> False) in
              nonterminal && read-is first "A" && ended && stream-failures ()

  -- | Original reader/writer failure tags survive adaptation without replaying an obsolete callback.
  stream-failures :: forall r. using (io :: Io r) => Unit ->{IO r} Bool
  stream-failures unit = case buffer-source-read (buffer-source-from-stream failing-reader) 1 of
    (event, next) -> let original-read = case event of ReadEvent count payload status -> case status of Some (BufferSourceError (StreamClosed name)) -> name == "reader-once"; other -> False in
      case buffer-source-read next 1 of
        (data-event, after) -> case buffer-sink-write (buffer-sink-from-stream failing-writer) (string-to-bytes "X") of
          (failed, next-sink) -> let original-write = case failed of WriteEvent count status -> count == 0 && (case status of Some (BufferSinkError (StreamClosed name)) -> name == "writer-once"; other -> False) in
            case buffer-sink-write next-sink (string-to-bytes "YZ") of
              (written, after-sink) -> original-read && original-write && read-is data-event "Q" && write-is written 2

  -- | Repeatedly release both proxy/cell directions; none installs its proxy into its own cell.
  reclaim :: forall r. using (io :: Io r) => Nat ->{IO r} Bool
  reclaim count = if count == 0 then True
    else if source-transfer-control () && sink-transfer-control () then reclaim (count - 1) else False

  -- | Check raw boundaries, advanced callbacks, absent capabilities, legacy adapters and reclamation.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in
    if not (counts ()) then 1
    else if not (source-transfer-control ()) then 2
    else if not (sink-transfer-control ()) then 3
    else if not (absent-transfer-control ()) then 4
    else if not (stream-adapters ()) then 5
    else if reclaim 64 then 0 else 6
