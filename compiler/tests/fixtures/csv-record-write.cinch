  check-batch2 :: Unit -> Nat
  check-batch2 unit = first-failure [
      (csv-render-record (config 59 0 CsvAnyFields False False) False (runtime-fields [" lead"," lead","tail "]) == "\" lead\";\" lead\";tail \n"),
      (csv-render-record (config 59 0 CsvAnyFields False False) False (runtime-fields ["aλb","c;d","emoji 😀"]) == "aλb;\"c;d\";emoji 😀\n"),
      (csv-render-record (config 59 0 CsvAnyFields False False) False (runtime-fields ["\u{0000}","﻿"]) == "\u{0000};﻿\n"),
      (csv-render-record (config 59 0 CsvAnyFields False False) True (runtime-fields []) == "\r\n"),
      (csv-render-record (config 59 0 CsvAnyFields False False) True (runtime-fields [""]) == "\r\n"),
      (csv-render-record (config 59 0 CsvAnyFields False False) True (runtime-fields ["a","b"]) == "a;b\r\n"),
      (csv-render-record (config 59 0 CsvAnyFields False False) True (runtime-fields ["a,b"," x","\"q\""]) == "a,b;\" x\";\"\"\"q\"\"\"\r\n"),
      (csv-render-record (config 59 0 CsvAnyFields False False) True (runtime-fields ["a\rb","a\nb","a\r\nb"]) == "\"ab\";\"a\r\nb\";\"a\r\nb\"\r\n"),
      (csv-render-record (config 59 0 CsvAnyFields False False) True (runtime-fields ["\\."]) == "\"\\.\"\r\n"),
      (csv-render-record (config 59 0 CsvAnyFields False False) True (runtime-fields [" lead"," lead","tail "]) == "\" lead\";\" lead\";tail \r\n"),
      (csv-render-record (config 59 0 CsvAnyFields False False) True (runtime-fields ["aλb","c;d","emoji 😀"]) == "aλb;\"c;d\";emoji 😀\r\n"),
      (csv-render-record (config 59 0 CsvAnyFields False False) True (runtime-fields ["\u{0000}","﻿"]) == "\u{0000};﻿\r\n")] 25

  -- | Evaluate a bounded group of independent write fixtures with original failing indices.
  check-batch3 :: Unit -> Nat
  check-batch3 unit = first-failure [
      (csv-render-record (config 955 0 CsvAnyFields False False) False (runtime-fields []) == "\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) False (runtime-fields [""]) == "\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) False (runtime-fields ["a","b"]) == "aλb\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) False (runtime-fields ["a,b"," x","\"q\""]) == "a,bλ\" x\"λ\"\"\"q\"\"\"\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) False (runtime-fields ["a\rb","a\nb","a\r\nb"]) == "\"a\rb\"λ\"a\nb\"λ\"a\r\nb\"\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) False (runtime-fields ["\\."]) == "\"\\.\"\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) False (runtime-fields [" lead"," lead","tail "]) == "\" lead\"λ\" lead\"λtail \n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) False (runtime-fields ["aλb","c;d","emoji 😀"]) == "\"aλb\"λc;dλemoji 😀\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) False (runtime-fields ["\u{0000}","﻿"]) == "\u{0000}λ﻿\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) True (runtime-fields []) == "\r\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) True (runtime-fields [""]) == "\r\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) True (runtime-fields ["a","b"]) == "aλb\r\n")] 37

  -- | Evaluate a bounded group of independent write fixtures with original failing indices.
  check-batch4 :: Unit -> Nat
  check-batch4 unit = first-failure [
      (csv-render-record (config 955 0 CsvAnyFields False False) True (runtime-fields ["a,b"," x","\"q\""]) == "a,bλ\" x\"λ\"\"\"q\"\"\"\r\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) True (runtime-fields ["a\rb","a\nb","a\r\nb"]) == "\"ab\"λ\"a\r\nb\"λ\"a\r\nb\"\r\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) True (runtime-fields ["\\."]) == "\"\\.\"\r\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) True (runtime-fields [" lead"," lead","tail "]) == "\" lead\"λ\" lead\"λtail \r\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) True (runtime-fields ["aλb","c;d","emoji 😀"]) == "\"aλb\"λc;dλemoji 😀\r\n"),
      (csv-render-record (config 955 0 CsvAnyFields False False) True (runtime-fields ["\u{0000}","﻿"]) == "\u{0000}λ﻿\r\n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) False (runtime-fields []) == "\n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) False (runtime-fields [""]) == "\n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) False (runtime-fields ["a","b"]) == "a漢b\n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) False (runtime-fields ["a,b"," x","\"q\""]) == "a,b漢\" x\"漢\"\"\"q\"\"\"\n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) False (runtime-fields ["a\rb","a\nb","a\r\nb"]) == "\"a\rb\"漢\"a\nb\"漢\"a\r\nb\"\n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) False (runtime-fields ["\\."]) == "\"\\.\"\n")] 49

  -- | Evaluate a bounded group of independent write fixtures with original failing indices.
  check-batch5 :: Unit -> Nat
  check-batch5 unit = first-failure [
      (csv-render-record (config 28450 0 CsvAnyFields False False) False (runtime-fields [" lead"," lead","tail "]) == "\" lead\"漢\" lead\"漢tail \n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) False (runtime-fields ["aλb","c;d","emoji 😀"]) == "aλb漢c;d漢emoji 😀\n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) False (runtime-fields ["\u{0000}","﻿"]) == "\u{0000}漢﻿\n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) True (runtime-fields []) == "\r\n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) True (runtime-fields [""]) == "\r\n"),
