      (csv-render-record (config 28450 0 CsvAnyFields False False) True (runtime-fields ["a,b"," x","\"q\""]) == "a,b漢\" x\"漢\"\"\"q\"\"\"\r\n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) True (runtime-fields ["a\rb","a\nb","a\r\nb"]) == "\"ab\"漢\"a\r\nb\"漢\"a\r\nb\"\r\n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) True (runtime-fields ["\\."]) == "\"\\.\"\r\n"),
