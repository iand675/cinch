      (csv-render-record (config 28450 0 CsvAnyFields False False) True (runtime-fields ["aλb","c;d","emoji 😀"]) == "aλb漢c;d漢emoji 😀\r\n"),
      (csv-render-record (config 28450 0 CsvAnyFields False False) True (runtime-fields ["\u{0000}","﻿"]) == "\u{0000}漢﻿\r\n")] 61

  -- | Evaluate a bounded group of independent write fixtures with original failing indices.
  check-batch6 :: Unit -> Nat
  check-batch6 unit = first-failure [
      (csv-render-record (config 128512 0 CsvAnyFields False False) False (runtime-fields []) == "\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) False (runtime-fields [""]) == "\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) False (runtime-fields ["a","b"]) == "a😀b\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) False (runtime-fields ["a,b"," x","\"q\""]) == "a,b😀\" x\"😀\"\"\"q\"\"\"\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) False (runtime-fields ["a\rb","a\nb","a\r\nb"]) == "\"a\rb\"😀\"a\nb\"😀\"a\r\nb\"\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) False (runtime-fields ["\\."]) == "\"\\.\"\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) False (runtime-fields [" lead"," lead","tail "]) == "\" lead\"😀\" lead\"😀tail \n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) False (runtime-fields ["aλb","c;d","emoji 😀"]) == "aλb😀c;d😀\"emoji 😀\"\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) False (runtime-fields ["\u{0000}","﻿"]) == "\u{0000}😀﻿\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) True (runtime-fields []) == "\r\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) True (runtime-fields [""]) == "\r\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) True (runtime-fields ["a","b"]) == "a😀b\r\n")] 73

  -- | Evaluate a bounded group of independent write fixtures with original failing indices.
  check-batch7 :: Unit -> Nat
  check-batch7 unit = first-failure [
      (csv-render-record (config 128512 0 CsvAnyFields False False) True (runtime-fields ["a,b"," x","\"q\""]) == "a,b😀\" x\"😀\"\"\"q\"\"\"\r\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) True (runtime-fields ["a\rb","a\nb","a\r\nb"]) == "\"ab\"😀\"a\r\nb\"😀\"a\r\nb\"\r\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) True (runtime-fields ["\\."]) == "\"\\.\"\r\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) True (runtime-fields [" lead"," lead","tail "]) == "\" lead\"😀\" lead\"😀tail \r\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) True (runtime-fields ["aλb","c;d","emoji 😀"]) == "aλb😀c;d😀\"emoji 😀\"\r\n"),
      (csv-render-record (config 128512 0 CsvAnyFields False False) True (runtime-fields ["\u{0000}","﻿"]) == "\u{0000}😀﻿\r\n")] 85

  -- | Print a failing fixture index and return a nonzero exit status for failed observations.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in
    let result = first-result [check-batch0 (),check-batch1 (),check-batch2 (),check-batch3 (),check-batch4 (),check-batch5 (),check-batch6 (),check-batch7 ()] in
    let printed = ioWrite (string-to-bytes (string-concat (nat-to-string result) "\n")) in
    if result == 0 then 0 else 1
