-- Lane G: Text.Time.Zoned, the effectful conveniences. Parse, look
-- the zone up in a `TzDb` and resolve: `zoned-from-string` (the task's
-- vectors end to end), its lenient form (a date with no time),
-- `zoned-from-string-with` (each conflict policy and strategy),
-- `zoned-text-lookup`, `zoned-strptime` (`%Q`, `%z`, both, neither),
-- and which stage refuses: the text, the lookup, the resolution.
module Main where
  import Data.Machine
  import Data.Option
  import Data.Result
  import Data.String
  import Relation.Eq
  import Relation.Ord
  import Data.Time.Timestamp
  import Data.Time.Offset
  import Data.Time.Zone
  import Data.Time.Zoned
  import Effect.Time.Zone
  import Text.Time.Strtime
  import Text.Time.Rfc9557
  import Text.Time.Zoned

  db :: TzDb
  db = tzdb-at "tests/fixtures/time/c/tzif"

  lands :: Result ZonedTextError Zoned -> I64 -> String -> Bool
  lands r secs shown = case r of
    Err _ -> False
    Ok x -> timestamp-to-unix-seconds (zoned-timestamp x) == secs && zoned-to-string x == shown

  -- 0 a value; 1 offset mismatch; 2 rejected gap; 3 rejected fold;
  -- 4 out of range; 5 no zone annotation; 6 a date with no time;
  -- 7 another RFC 9557 refusal; 10 missing offset; 11 another strtime
  -- refusal; 20 lookup: invalid name; 21 lookup: not found; 22 lookup:
  -- other; 30 missing zone.
  outcome :: Result ZonedTextError Zoned -> I64
  outcome r = case r of
    Ok _ -> 0
    Err e -> case e of
      ZonedTextRfc9557 why -> (case why of
        Rfc9557OffsetMismatch _ _ -> 1
        Rfc9557Ambiguous a -> (case a of
          RejectedGap _ _ -> 2
          RejectedFold _ _ -> 3
          AmbiguityOutOfRange -> 4)
        Rfc9557OutOfRange -> 4
        Rfc9557MissingZoneAnnotation _ -> 5
        Rfc9557MissingTime _ -> 6
        _ -> 7)
      ZonedTextStrtime why -> (case why of
        StrtimeMissingOffset -> 10
        _ -> 11)
      ZonedTextLookup why -> (case why of
        TzInvalidName -> 20
        TzNotFound -> 21
        _ -> 22)
      ZonedTextMissingZone -> 30

  -- 1: the vectors, end to end.
  check-vectors :: forall r. using (io :: Io r) => Unit ->{IO r} Int
  check-vectors u =
    if lands (zoned-from-string db "2026-10-31T05:30[Australia/Sydney]") 1793385000 "2026-10-31T05:30:00+11:00[Australia/Sydney]"
       && lands (zoned-from-string db "2026-04-05T02:30[Australia/Sydney]") 1775316600 "2026-04-05T02:30:00+11:00[Australia/Sydney]"
       && lands (zoned-from-string db "2026-04-05T02:30+11:00[Australia/Sydney]") 1775316600 "2026-04-05T02:30:00+11:00[Australia/Sydney]"
       && lands (zoned-from-string db "2026-04-05T02:30+10:00[Australia/Sydney]") 1775320200 "2026-04-05T02:30:00+10:00[Australia/Sydney]"
       && lands (zoned-from-string db "2024-09-10T23:37:20-04[America/New_York]") 1726025840 "2024-09-10T23:37:20-04:00[America/New_York]"
       && outcome (zoned-from-string db "2024-09-10T23:37:20-05:00[America/New_York]") == 1
       && lands (zoned-from-string db "2024-07-13T19:09:59Z[America/New_York]") 1720897799 "2024-07-13T15:09:59-04:00[America/New_York]"
       && lands (zoned-from-string db "2026-03-08T02:30[America/New_York]") 1772955000 "2026-03-08T03:30:00-04:00[America/New_York]"
       && lands (zoned-from-string db "2026-06-01T12:00:00+05:30[Asia/Kolkata]") 1780295400 "2026-06-01T12:00:00+05:30[Asia/Kolkata]"
       && lands (zoned-from-string db "2026-03-08T02:30[UTC]") 1772937000 "2026-03-08T02:30:00+00:00[UTC]"
       && lands (zoned-from-string db "2026-03-08T02:30[+05:30]") 1772917200 "2026-03-08T02:30:00+05:30[+05:30]"
       && lands (zoned-from-string db "2026-03-08T02:30+05:30[+05:30]") 1772917200 "2026-03-08T02:30:00+05:30[+05:30]"
       && lands (zoned-from-string db "2024-07-13T19:09:59Z[America/New_York][u-ca=iso8601]") 1720897799 "2024-07-13T15:09:59-04:00[America/New_York]"
       && lands (zoned-from-string db "2024-07-13T19:09:59Z[America/New_York][u-foo=bar]") 1720897799 "2024-07-13T15:09:59-04:00[America/New_York]"
       && lands (zoned-from-string db "2024-07-13T19:09:59Z[!America/New_York]") 1720897799 "2024-07-13T15:09:59-04:00[America/New_York]"
      then 0 else 1

  -- 2: which stage refuses.
  check-stages :: forall r. using (io :: Io r) => Unit ->{IO r} Int
  check-stages u =
    if outcome (zoned-from-string db "2024-07-13T19:09:59Z") == 5
       && outcome (zoned-from-string db "2024-07-13T19:09:59-04:00") == 5
       && outcome (zoned-from-string db "2024-07-13T19:09:59") == 5
       && outcome (zoned-from-string db "2026-11-12[America/New_York]") == 6
       && outcome (zoned-from-string db "2024-07-13T19:09:59Z[America/New_York") == 7
       && outcome (zoned-from-string db "2024-07-13T19:09:59Z[America/New_York][u-ca=hebrew]") == 7
       && outcome (zoned-from-string db "2024-07-13T19:09:59Z[America/New_York][!u-foo=bar]") == 7
       && outcome (zoned-from-string db "2024-07-13T19:09:59Z[../etc/passwd]") == 7
       && outcome (zoned-from-string db "2024-07-13T19:09:59Z[Mars/Olympus_Mons]") == 21
       && outcome (zoned-from-string db "2024-07-13T19:09:59Z[America]") /= 0
       && outcome (zoned-from-string db "2024-07-13T19:09:59Z[README]") == 22
       && outcome (zoned-from-string (tzdb-at "tests/fixtures/time/c/no-such-directory") "2024-07-13T19:09:59Z[UTC]") == 21
       && lands (zoned-from-string (tzdb-at "tests/fixtures/time/c/no-such-directory") "2024-07-13T19:09:59Z[+00:00]") 1720897799 "2024-07-13T19:09:59+00:00[UTC]"
       && outcome (zoned-from-string db "2026-03-08T02:30+05:00[+05:30]") == 1
       && outcome (zoned-from-string db "9999-12-31T23:59:59[UTC]") == 4
      then 0 else 2

  -- 4: the lenient form: a date with no time is the first instant of
  -- the day (01:00 in Santiago when midnight does not exist).
  check-lenient :: forall r. using (io :: Io r) => Unit ->{IO r} Int
  check-lenient u =
    if lands (zoned-from-string-lenient db "2026-11-12[America/New_York]") 1794459600 "2026-11-12T00:00:00-05:00[America/New_York]"
       && lands (zoned-from-string-lenient db "2026-09-06[America/Santiago]") 1788667200 "2026-09-06T01:00:00-03:00[America/Santiago]"
       && lands (zoned-from-string-lenient db "2011-12-30[Pacific/Apia]") 1325239200 "2011-12-31T00:00:00+14:00[Pacific/Apia]"
       && lands (zoned-from-string-lenient db "2026-03-08[+05:30]") 1772908200 "2026-03-08T00:00:00+05:30[+05:30]"
       && lands (zoned-from-string-lenient db "2026-10-31 05:30[Australia/Sydney]") 1793385000 "2026-10-31T05:30:00+11:00[Australia/Sydney]"
       && lands (zoned-from-string-lenient db "20261031t05:30+1100[Australia/Sydney]") 1793385000 "2026-10-31T05:30:00+11:00[Australia/Sydney]"
       && lands (zoned-from-string-lenient db "2026-03-08T02:30[+05:30:15]") 1772917185 "2026-03-08T02:30:00+05:30:15[+05:30:15]"
       && outcome (zoned-from-string-lenient db "2024-07-13T19:09:59z") == 5
       && outcome (zoned-from-string-lenient db "2024-09-10T23:37:20-05:00[America/New_York]") == 1
       && outcome (zoned-from-string-lenient db "2026-11-12[Mars/Olympus_Mons]") == 21
      then 0 else 4

  -- 8: the policy and the strategy chosen.
  check-with :: forall r. using (io :: Io r) => Unit ->{IO r} Int
  check-with u =
    let wrong = "2024-09-10T23:37:20-05:00[America/New_York]" in
    let fold = "2026-04-05T02:30[Australia/Sydney]" in
    if outcome (zoned-from-string-with OffsetReject Compatible db wrong) == 1
       && lands (zoned-from-string-with OffsetUse Compatible db wrong) 1726029440 "2024-09-11T00:37:20-04:00[America/New_York]"
       && lands (zoned-from-string-with OffsetIgnore Compatible db wrong) 1726025840 "2024-09-10T23:37:20-04:00[America/New_York]"
       && lands (zoned-from-string-with OffsetPrefer Compatible db wrong) 1726025840 "2024-09-10T23:37:20-04:00[America/New_York]"
       && lands (zoned-from-string-with OffsetReject Compatible db fold) 1775316600 "2026-04-05T02:30:00+11:00[Australia/Sydney]"
       && lands (zoned-from-string-with OffsetReject Earlier db fold) 1775316600 "2026-04-05T02:30:00+11:00[Australia/Sydney]"
       && lands (zoned-from-string-with OffsetReject Later db fold) 1775320200 "2026-04-05T02:30:00+10:00[Australia/Sydney]"
       && outcome (zoned-from-string-with OffsetReject Reject db fold) == 3
       && outcome (zoned-from-string-with OffsetReject Reject db "2026-03-08T02:30[America/New_York]") == 2
       && lands (zoned-from-string-with OffsetReject Earlier db "2026-03-08T02:30[America/New_York]") 1772951400 "2026-03-08T01:30:00-05:00[America/New_York]"
       && outcome (zoned-from-string-with OffsetUse Compatible db "2026-11-12[America/New_York]") == 6
      then 0 else 8

  looked-up :: forall r. using (io :: Io r) => String ->{IO r} String
  looked-up s = case parse-zoned-text s of
    Err _ -> "unparsed"
    Ok t -> case zoned-text-lookup db t of
      Err _ -> "not found"
      Ok z -> zone-name z

  -- 16: `zoned-text-lookup` alone.
  check-lookup :: forall r. using (io :: Io r) => Unit ->{IO r} Int
  check-lookup u =
    if looked-up "2026-01-01T00:00[Europe/London]" == "Europe/London"
       && looked-up "2026-01-01T00:00[Pacific/Apia]" == "Pacific/Apia"
       && looked-up "2026-01-01T00:00[UTC]" == "UTC"
       && looked-up "2026-01-01T00:00[+05:30]" == "+05:30"
       && looked-up "2026-01-01T00:00[-00:00]" == "UTC"
       && looked-up "2026-01-01T00:00[Europe/Atlantis]" == "not found"
      then 0 else 16

  -- 32: `zoned-strptime`: a zone name, an offset, both, neither.
  check-strptime :: forall r. using (io :: Io r) => Unit ->{IO r} Int
  check-strptime u =
    if lands (zoned-strptime db "%Y-%m-%d %H:%M %Q" "2026-04-05 02:30 Australia/Sydney") 1775316600 "2026-04-05T02:30:00+11:00[Australia/Sydney]"
       && lands (zoned-strptime db "%Y-%m-%d %H:%M %z %Q" "2026-04-05 02:30 +1000 Australia/Sydney") 1775320200 "2026-04-05T02:30:00+10:00[Australia/Sydney]"
       && lands (zoned-strptime db "%Y-%m-%dT%H:%M:%S%:z[%Q]" "2026-11-01T01:30:00-05:00[America/New_York]") 1793514600 "2026-11-01T01:30:00-05:00[America/New_York]"
       && outcome (zoned-strptime db "%Y-%m-%d %H:%M %z %Q" "2026-04-05 02:30 +0900 Australia/Sydney") == 1
       && lands (zoned-strptime db "%Y-%m-%d %H:%M %z" "2026-04-05 02:30 +1000") 1775320200 "2026-04-05T02:30:00+10:00[+10:00]"
       && lands (zoned-strptime db "%a, %d %b %Y %H:%M:%S %z" "Sat, 13 Jul 2024 15:09:59 -0400") 1720897799 "2024-07-13T15:09:59-04:00[-04:00]"
       && lands (zoned-strptime db "%Y-%m-%d %H:%M %Q" "2026-03-08 02:30 America/New_York") 1772955000 "2026-03-08T03:30:00-04:00[America/New_York]"
       && lands (zoned-strptime db "%s %Q" "1720897799 America/New_York") 1720897799 "2024-07-13T15:09:59-04:00[America/New_York]"
       && outcome (zoned-strptime db "%Y-%m-%d %H:%M" "2026-04-05 02:30") == 30
       && outcome (zoned-strptime db "%Y-%m-%d %H:%M %Q" "2026-04-05 02:30 Mars/Olympus_Mons") == 21
       && outcome (zoned-strptime db "%Y-%m-%d %H:%M %Q" "2026-04-05 02:30") == 11
       && outcome (zoned-strptime db "%Y-%m-%d %H:%M %Z" "2026-04-05 02:30 AEDT") == 11
       && outcome (zoned-strptime db "%H:%M %Q" "02:30 Australia/Sydney") == 11
       && outcome (zoned-strptime db "%Y-%m-%d %K" "2026-04-05 x") == 11
      then 0 else 32

  -- 64: print then parse through the effectful path, across zones.
  back :: forall r. using (io :: Io r) => String -> I64 ->{IO r} Bool
  back name secs = case tzdb-lookup db name of
    Err _ -> False
    Ok z -> case timestamp-from-unix-seconds secs of
      None -> False
      Some t ->
        let x = zoned-from-timestamp z t in
        (case zoned-from-string-with OffsetReject Reject db (zoned-to-string x) of
          Err _ -> False
          Ok y -> y == x)

  check-round-trip :: forall r. using (io :: Io r) => Unit ->{IO r} Int
  check-round-trip u =
    if back "America/New_York" 1793511000 && back "America/New_York" 1793514600
       && back "Australia/Sydney" 1775316600 && back "Australia/Sydney" 1775320200
       && back "Asia/Kolkata" 1780295400 && back "Europe/Amsterdam" (-2208945600)
       && back "Europe/London" 1782903600 && back "Pacific/Apia" 1325239200
       && back "America/Santiago" 1788667200 && back "UTC" 0
      then 0 else 64

  main :: Unit ->{IO r} Int
  main u = with (io = newIO ()) in
    check-vectors () + check-stages () + check-lenient () + check-with ()
      + check-lookup () + check-strptime () + check-round-trip ()
