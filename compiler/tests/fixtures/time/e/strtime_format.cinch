-- Lane E: Text.Time.Strtime, formatting. Every conversion at known
-- values: the task's vectors, numeric date and time fields, names, the
-- twelve-hour clock at midnight, noon and 23:59, day of year, both
-- weekday numberings, ISO week dates at year boundaries, the POSIX week
-- numbers, century and two-digit years, the composites and literals.
module Main where
  import Data.Machine
  import Data.Option
  import Data.Result
  import Data.String
  import Relation.Eq
  import Relation.Ord
  import Text.Time.Strtime
  import Data.Time.Weekday (Weekday, Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday)
  import Data.Time.Date (Date)
  import Data.Time.Date as D
  import Data.Time.TimeOfDay (TimeOfDay)
  import Data.Time.TimeOfDay as T
  import Data.Time.DateTime (DateTime)
  import Data.Time.DateTime as DT
  import Data.Time.Timestamp

  ymd :: I64 -> I64 -> I64 -> Date
  ymd y m d = case D.date y m d of
    None -> D.min-date
    Some x -> x

  hmsn :: I64 -> I64 -> I64 -> I64 -> TimeOfDay
  hmsn h m s ns = case T.time-of-day-checked h m s ns of
    None -> T.midnight
    Some t -> t

  at :: I64 -> I64 -> I64 -> I64 -> I64 -> I64 -> I64 -> DateTime
  at y mo d h mi s ns = DT.datetime (ymd y mo d) (hmsn h mi s ns)

  -- A refusal as a number: constructor * 1000000 + position * 1000 +
  -- conversion byte (0 where the constructor has none).
  code :: StrtimeError -> I64
  code e = case e of
    StrtimeUnknownConversion p c -> wrapping-add-i64 1000000 (wrapping-add-i64 (wrapping-mul-i64 p 1000) c)
    StrtimeDanglingPercent p -> wrapping-add-i64 2000000 (wrapping-mul-i64 p 1000)
    StrtimeWidthTooLarge p -> wrapping-add-i64 3000000 (wrapping-mul-i64 p 1000)
    StrtimeModifierNotAllowed p -> wrapping-add-i64 4000000 (wrapping-mul-i64 p 1000)
    StrtimeMissingField c -> wrapping-add-i64 5000000 c
    StrtimeUnexpectedEnd p -> wrapping-add-i64 6000000 (wrapping-mul-i64 p 1000)
    StrtimeExpectedDigit p -> wrapping-add-i64 7000000 (wrapping-mul-i64 p 1000)
    StrtimeExpectedName p -> wrapping-add-i64 8000000 (wrapping-mul-i64 p 1000)
    StrtimeExpectedOffset p -> wrapping-add-i64 9000000 (wrapping-mul-i64 p 1000)
    StrtimeLiteralMismatch p -> wrapping-add-i64 10000000 (wrapping-mul-i64 p 1000)
    StrtimeFieldOutOfRange p c -> wrapping-add-i64 11000000 (wrapping-add-i64 (wrapping-mul-i64 p 1000) c)
    StrtimeTrailingInput p -> wrapping-add-i64 12000000 (wrapping-mul-i64 p 1000)
    StrtimeZoneAbbreviationNotParsed p -> wrapping-add-i64 13000000 (wrapping-mul-i64 p 1000)
    StrtimeMissingYear -> 14000000
    StrtimeMissingMonth -> 15000000
    StrtimeMissingDay -> 16000000
    StrtimeMissingHour -> 17000000
    StrtimeMissingMeridiem -> 18000000
    StrtimeMissingOffset -> 19000000
    StrtimeInvalidDate -> 20000000
    StrtimeDateMismatch -> 21000000
    StrtimeWeekdayMismatch -> 22000000
    StrtimeDayOfYearMismatch -> 23000000
    StrtimeIsoWeekMismatch -> 24000000
    StrtimeWeekNumberMismatch -> 25000000
    StrtimeHourMismatch -> 26000000
    StrtimeTimestampOutOfRange -> 27000000

  -- `strftime f b` is `Ok expected`.
  fb :: String -> BrokenDown -> String -> Bool
  fb f b expected = case strftime f b of
    Err _ -> False
    Ok s -> s == expected

  fd :: String -> Date -> String -> Bool
  fd f d expected = fb f (broken-down-from-date d) expected

  ft :: String -> TimeOfDay -> String -> Bool
  ft f t expected = fb f (broken-down-from-time t) expected

  fx :: String -> DateTime -> String -> Bool
  fx f x expected = fb f (broken-down-from-datetime x) expected

  -- The refusal of `strftime f b`; -1 for `Ok`.
  fe :: String -> BrokenDown -> I64
  fe f b = case strftime f b of
    Ok _ -> -1
    Err e -> code e

  -- The refusal of `strptime f s`; -1 for `Ok`.
  pe :: String -> String -> I64
  pe f s = case strptime f s of
    Ok _ -> -1
    Err e -> code e

  is :: Option I64 -> I64 -> Bool
  is o v = case o of
    None -> False
    Some x -> x == v

  none :: Option I64 -> Bool
  none o = case o of
    None -> True
    Some _ -> False

  pd :: String -> String -> Date -> Bool
  pd f s d = case date-strptime f s of
    Err _ -> False
    Ok x -> x == d

  pt :: String -> String -> TimeOfDay -> Bool
  pt f s t = case time-strptime f s of
    Err _ -> False
    Ok x -> x == t

  px :: String -> String -> DateTime -> Bool
  px f s x = case datetime-strptime f s of
    Err _ -> False
    Ok y -> y == x

  check-vectors :: Int
  check-vectors =
    let x = at 2026 11 13 17 30 0 0 in
    if fx "%a, %b %d, %Y %H:%M" x "Fri, Nov 13, 2026 17:30"
       && fx "%Y-%m-%dT%H:%M:%S%.f" x "2026-11-13T17:30:00"
       && fx "%Y-%m-%dT%H:%M:%S%.f" (at 2026 11 13 17 30 5 250000000) "2026-11-13T17:30:05.25"
       && fx "%Y-%m-%dT%H:%M:%S%.f" (at 2026 11 13 17 30 5 123456789) "2026-11-13T17:30:05.123456789"
       && fx "%A, %B %e, %Y" x "Friday, November 13, 2026" && fd "%m/%d/%Y" (ymd 2026 11 13) "11/13/2026"
       && fx "" x "" && fx "plain text" x "plain text"
    then 0 else 1

  check-numeric :: Int
  check-numeric =
    let x = at 2024 2 9 4 5 6 0 in
    if fx "%Y|%m|%d|%e|%H|%M|%S" x "2024|02|09| 9|04|05|06"
       && fd "%Y" (ymd 44 3 15) "0044" && fd "%Y" (ymd 0 1 1) "0000" && fd "%Y" (ymd (-44) 3 15) "-0044"
       && fd "%Y" D.max-date "9999" && fd "%Y" D.min-date "-9999"
       && fd "%C %y" (ymd 2026 11 13) "20 26" && fd "%C %y" (ymd 1999 1 1) "19 99" && fd "%C %y" (ymd 5 1 1) "00 05"
       && fd "%C %y" (ymd (-44) 1 1) "-01 56"
       && ft "%H:%M:%S" T.midnight "00:00:00" && ft "%H:%M:%S" T.max-time "23:59:59"
    then 0 else 2

  check-names :: Int
  check-names =
    if fd "%a %A" (ymd 2026 11 9) "Mon Monday" && fd "%a %A" (ymd 2026 11 10) "Tue Tuesday"
       && fd "%a %A" (ymd 2026 11 11) "Wed Wednesday" && fd "%a %A" (ymd 2026 11 12) "Thu Thursday"
       && fd "%a %A" (ymd 2026 11 13) "Fri Friday" && fd "%a %A" (ymd 2026 11 14) "Sat Saturday"
       && fd "%a %A" (ymd 2026 11 15) "Sun Sunday"
       && fd "%b %B %h" (ymd 2026 1 1) "Jan January Jan" && fd "%b %B" (ymd 2026 2 1) "Feb February"
       && fd "%b %B" (ymd 2026 3 1) "Mar March" && fd "%b %B" (ymd 2026 4 1) "Apr April"
       && fd "%b %B" (ymd 2026 5 1) "May May" && fd "%b %B" (ymd 2026 6 1) "Jun June"
       && fd "%b %B" (ymd 2026 7 1) "Jul July" && fd "%b %B" (ymd 2026 8 1) "Aug August"
       && fd "%b %B" (ymd 2026 9 1) "Sep September" && fd "%b %B" (ymd 2026 10 1) "Oct October"
       && fd "%b %B" (ymd 2026 11 1) "Nov November" && fd "%b %B" (ymd 2026 12 1) "Dec December"
    then 0 else 4

  check-twelve-hour :: Int
  check-twelve-hour =
    if ft "%I:%M %p" T.midnight "12:00 AM" && ft "%I:%M %p" T.noon "12:00 PM"
       && ft "%I:%M %p" (hmsn 23 59 0 0) "11:59 PM" && ft "%I:%M %p" (hmsn 0 59 0 0) "12:59 AM"
       && ft "%I:%M %p" (hmsn 1 0 0 0) "01:00 AM" && ft "%I:%M %p" (hmsn 11 59 0 0) "11:59 AM"
       && ft "%I:%M %p" (hmsn 12 1 0 0) "12:01 PM" && ft "%I:%M %p" (hmsn 13 5 0 0) "01:05 PM"
       && ft "%I%P" (hmsn 9 0 0 0) "09am" && ft "%I%P" (hmsn 21 0 0 0) "09pm"
       && ft "%-I %p" (hmsn 9 0 0 0) "9 AM"
    then 0 else 8

  check-day-numbers :: Int
  check-day-numbers =
    if fd "%j" (ymd 2026 1 1) "001" && fd "%j" (ymd 2026 11 13) "317" && fd "%j" (ymd 2024 2 29) "060"
       && fd "%j" (ymd 2024 12 31) "366" && fd "%j" (ymd 2026 12 31) "365"
       && fd "%u/%w" (ymd 2026 11 13) "5/5" && fd "%u/%w" (ymd 2026 11 9) "1/1" && fd "%u/%w" (ymd 2026 11 15) "7/0"
       && fd "%u/%w" (ymd 2026 11 14) "6/6" && fd "%u/%w" (ymd 2021 1 3) "7/0"
    then 0 else 16

  check-iso-weeks :: Int
  check-iso-weeks =
    if fd "%G-W%V-%u" (ymd 2024 12 30) "2025-W01-1" && fd "%G-W%V-%u" (ymd 2021 1 3) "2020-W53-7"
       && fd "%G-W%V-%u" (ymd 2026 11 13) "2026-W46-5" && fd "%G-W%V-%u" (ymd 2023 1 1) "2022-W52-7"
       && fd "%G-W%V-%u" (ymd 2024 12 31) "2025-W01-2" && fd "%G-W%V-%u" (ymd 2020 12 31) "2020-W53-4"
       && fd "%G-W%V-%u" (ymd 2026 1 1) "2026-W01-4" && fd "%G-W%V-%u" (ymd 2018 12 31) "2019-W01-1"
       && fd "%g" (ymd 2024 12 30) "25" && fd "%g" (ymd 2021 1 3) "20" && fd "%g %y" (ymd 2023 1 1) "22 23"
    then 0 else 32

  check-posix-weeks :: Int
  check-posix-weeks =
    if fd "%U %W" (ymd 2026 11 13) "45 45" && fd "%U %W" (ymd 2024 12 30) "52 53" && fd "%U %W" (ymd 2021 1 3) "01 00"
       && fd "%U %W" (ymd 2026 1 1) "00 00" && fd "%U %W" (ymd 2023 1 1) "01 00" && fd "%U %W" (ymd 2024 2 29) "08 09"
       && fd "%U %W" (ymd 2024 12 31) "52 53" && fd "%U %W" (ymd 2026 1 4) "01 00" && fd "%U %W" (ymd 2020 12 31) "52 52"
    then 0 else 64

  check-composites :: Int
  check-composites =
    let x = at 2026 11 13 17 30 5 0 in
    if fx "%F" x "2026-11-13" && fx "%T" x "17:30:05" && fx "%R" x "17:30" && fx "%D" x "11/13/26"
       && fx "%FT%T" x "2026-11-13T17:30:05" && fx "%F %R" x "2026-11-13 17:30"
       && fx "100%%" x "100%" && fx "%%Y" x "%Y" && fx "a%nb%tc" x "a\nb\tc"
       && fx "%F" (at (-44) 3 15 0 0 0 0) "-0044-03-15" && fx "[%D]" (at 2005 1 2 0 0 0 0) "[01/02/05]"
    then 0 else 128

  main :: Int
  main = check-vectors + check-numeric + check-names + check-twelve-hour + check-day-numbers + check-iso-weeks + check-posix-weeks + check-composites
