-- Lane D: Data.Time.Unit. The unit order and its two classes, the
-- rounding kernel for all nine Temporal modes (a literal table at
-- increment 10 covering negatives and exact halves, and an exhaustive
-- comparison against an independent number-line reference for every
-- mode, increments 1..=8 and values -40..=40), the kernel's refusals,
-- the as-if-positive variant, the negation law and the three increment
-- validators.
module Main where
  import Data.Machine
  import Data.Wide
  import Data.Option
  import Data.Ordering
  import Relation.Eq
  import Relation.Ord
  import Data.Time.Unit

  -- The kernel on small values.
  k :: RoundMode -> I64 -> I64 -> I64 -> Bool
  k m inc x want = case round-i128 m (i64-to-i128 inc) (i64-to-i128 x) of
    None -> False
    Some v -> eq-i128 v (i64-to-i128 want)

  kp :: RoundMode -> I64 -> I64 -> I64 -> Bool
  kp m inc x want = case round-i128-as-if-positive m (i64-to-i128 inc) (i64-to-i128 x) of
    None -> False
    Some v -> eq-i128 v (i64-to-i128 want)

  refused :: Option I128 -> Bool
  refused o = case o of
    None -> True
    Some _ -> False

  rank-is :: TimeUnit -> I64 -> Bool
  rank-is u n = unit-rank u == n

  next-is :: Option TimeUnit -> TimeUnit -> Bool
  next-is o u = case o of
    None -> False
    Some v -> unit-eq v u

  no-unit :: Option TimeUnit -> Bool
  no-unit o = case o of
    None -> True
    Some _ -> False

  nanos-is :: TimeUnit -> I64 -> Bool
  nanos-is u n = case unit-nanos u of
    None -> False
    Some v -> eq-i128 v (i64-to-i128 n)

  no-nanos :: TimeUnit -> Bool
  no-nanos u = refused (unit-nanos u)

  is-lt :: Ordering -> Bool
  is-lt o = case o of
    LT -> True
    EQ -> False
    GT -> False

  is-eq :: Ordering -> Bool
  is-eq o = case o of
    EQ -> True
    LT -> False
    GT -> False

  -- 1: the unit order, the steps along it, the two classes and the
  -- fixed lengths.
  check-units :: Int
  check-units =
    if rank-is Nanosecond 0 && rank-is Microsecond 1 && rank-is Millisecond 2
       && rank-is Second 3 && rank-is Minute 4 && rank-is Hour 5 && rank-is Day 6
       && rank-is Week 7 && rank-is Month 8 && rank-is Year 9
       && is-lt (unit-cmp Nanosecond Year) && is-lt (unit-cmp Hour Day)
       && is-eq (unit-cmp Week Week) && is-lt (unit-cmp Week Month) == True
       && unit-eq (unit-larger-of Hour Minute) Hour && unit-eq (unit-larger-of Day Year) Year
       && unit-eq (unit-smaller-of Hour Minute) Minute && unit-eq (unit-smaller-of Day Day) Day
       && next-is (unit-next-larger Nanosecond) Microsecond && next-is (unit-next-larger Hour) Day
       && next-is (unit-next-larger Day) Week && next-is (unit-next-larger Month) Year
       && no-unit (unit-next-larger Year) && no-unit (unit-next-smaller Nanosecond)
       && next-is (unit-next-smaller Year) Month && next-is (unit-next-smaller Day) Hour
       && next-is (unit-next-smaller Second) Millisecond
       && unit-is-calendar Day && unit-is-calendar Week && unit-is-calendar Month && unit-is-calendar Year
       && unit-is-calendar Hour == False && unit-is-calendar Nanosecond == False
       && nanos-is Nanosecond 1 && nanos-is Microsecond 1000 && nanos-is Millisecond 1000000
       && nanos-is Second 1000000000 && nanos-is Minute 60000000000 && nanos-is Hour 3600000000000
       && no-nanos Day && no-nanos Week && no-nanos Month && no-nanos Year
       && eq-i128 nanos-per-civil-day (i64-to-i128 86400000000000)
    then 0 else 1

  -- 2: the literal kernel table at increment 10, first five modes.
  -- 15, 5, 25 and their negations are exact halves.
  check-table-a :: Int
  check-table-a =
    if k Ceil 10 (-25) (-20) && k Ceil 10 (-16) (-10) && k Ceil 10 (-15) (-10) && k Ceil 10 (-14) (-10)
       && k Ceil 10 (-6) (0) && k Ceil 10 (-5) (0) && k Ceil 10 (-4) (0) && k Ceil 10 (-1) (0)
       && k Ceil 10 0 0 && k Ceil 10 1 10 && k Ceil 10 4 10 && k Ceil 10 5 10
       && k Ceil 10 6 10 && k Ceil 10 14 20 && k Ceil 10 15 20 && k Ceil 10 16 20
       && k Ceil 10 25 30
       && k Floor 10 (-25) (-30) && k Floor 10 (-16) (-20) && k Floor 10 (-15) (-20) && k Floor 10 (-14) (-20)
       && k Floor 10 (-6) (-10) && k Floor 10 (-5) (-10) && k Floor 10 (-4) (-10) && k Floor 10 (-1) (-10)
       && k Floor 10 0 0 && k Floor 10 1 0 && k Floor 10 4 0 && k Floor 10 5 0
       && k Floor 10 6 0 && k Floor 10 14 10 && k Floor 10 15 10 && k Floor 10 16 10
       && k Floor 10 25 20
       && k Expand 10 (-25) (-30) && k Expand 10 (-16) (-20) && k Expand 10 (-15) (-20) && k Expand 10 (-14) (-20)
       && k Expand 10 (-6) (-10) && k Expand 10 (-5) (-10) && k Expand 10 (-4) (-10) && k Expand 10 (-1) (-10)
       && k Expand 10 0 0 && k Expand 10 1 10 && k Expand 10 4 10 && k Expand 10 5 10
       && k Expand 10 6 10 && k Expand 10 14 20 && k Expand 10 15 20 && k Expand 10 16 20
       && k Expand 10 25 30
       && k Trunc 10 (-25) (-20) && k Trunc 10 (-16) (-10) && k Trunc 10 (-15) (-10) && k Trunc 10 (-14) (-10)
       && k Trunc 10 (-6) (0) && k Trunc 10 (-5) (0) && k Trunc 10 (-4) (0) && k Trunc 10 (-1) (0)
       && k Trunc 10 0 0 && k Trunc 10 1 0 && k Trunc 10 4 0 && k Trunc 10 5 0
       && k Trunc 10 6 0 && k Trunc 10 14 10 && k Trunc 10 15 10 && k Trunc 10 16 10
       && k Trunc 10 25 20
       && k HalfCeil 10 (-25) (-20) && k HalfCeil 10 (-16) (-20) && k HalfCeil 10 (-15) (-10) && k HalfCeil 10 (-14) (-10)
       && k HalfCeil 10 (-6) (-10) && k HalfCeil 10 (-5) (0) && k HalfCeil 10 (-4) (0) && k HalfCeil 10 (-1) (0)
       && k HalfCeil 10 0 0 && k HalfCeil 10 1 0 && k HalfCeil 10 4 0 && k HalfCeil 10 5 10
       && k HalfCeil 10 6 10 && k HalfCeil 10 14 10 && k HalfCeil 10 15 20 && k HalfCeil 10 16 20
       && k HalfCeil 10 25 30
    then 0 else 2

  -- 4: the literal kernel table, the remaining four modes.
  check-table-b :: Int
  check-table-b =
    if k HalfFloor 10 (-25) (-30) && k HalfFloor 10 (-16) (-20) && k HalfFloor 10 (-15) (-20) && k HalfFloor 10 (-14) (-10)
       && k HalfFloor 10 (-6) (-10) && k HalfFloor 10 (-5) (-10) && k HalfFloor 10 (-4) (0) && k HalfFloor 10 (-1) (0)
       && k HalfFloor 10 0 0 && k HalfFloor 10 1 0 && k HalfFloor 10 4 0 && k HalfFloor 10 5 0
       && k HalfFloor 10 6 10 && k HalfFloor 10 14 10 && k HalfFloor 10 15 10 && k HalfFloor 10 16 20
       && k HalfFloor 10 25 20
       && k HalfExpand 10 (-25) (-30) && k HalfExpand 10 (-16) (-20) && k HalfExpand 10 (-15) (-20) && k HalfExpand 10 (-14) (-10)
       && k HalfExpand 10 (-6) (-10) && k HalfExpand 10 (-5) (-10) && k HalfExpand 10 (-4) (0) && k HalfExpand 10 (-1) (0)
       && k HalfExpand 10 0 0 && k HalfExpand 10 1 0 && k HalfExpand 10 4 0 && k HalfExpand 10 5 10
       && k HalfExpand 10 6 10 && k HalfExpand 10 14 10 && k HalfExpand 10 15 20 && k HalfExpand 10 16 20
       && k HalfExpand 10 25 30
       && k HalfTrunc 10 (-25) (-20) && k HalfTrunc 10 (-16) (-20) && k HalfTrunc 10 (-15) (-10) && k HalfTrunc 10 (-14) (-10)
       && k HalfTrunc 10 (-6) (-10) && k HalfTrunc 10 (-5) (0) && k HalfTrunc 10 (-4) (0) && k HalfTrunc 10 (-1) (0)
       && k HalfTrunc 10 0 0 && k HalfTrunc 10 1 0 && k HalfTrunc 10 4 0 && k HalfTrunc 10 5 0
       && k HalfTrunc 10 6 10 && k HalfTrunc 10 14 10 && k HalfTrunc 10 15 10 && k HalfTrunc 10 16 20
       && k HalfTrunc 10 25 20
       && k HalfEven 10 (-25) (-20) && k HalfEven 10 (-16) (-20) && k HalfEven 10 (-15) (-20) && k HalfEven 10 (-14) (-10)
       && k HalfEven 10 (-6) (-10) && k HalfEven 10 (-5) (0) && k HalfEven 10 (-4) (0) && k HalfEven 10 (-1) (0)
       && k HalfEven 10 0 0 && k HalfEven 10 1 0 && k HalfEven 10 4 0 && k HalfEven 10 5 0
       && k HalfEven 10 6 10 && k HalfEven 10 14 10 && k HalfEven 10 15 20 && k HalfEven 10 16 20
       && k HalfEven 10 25 20
    then 0 else 4

  -- An independent reference on the number line: the two multiples of
  -- `inc` around `x` by floored division, then the mode's choice.
  floor-mul :: I64 -> I64 -> I64
  floor-mul inc x = case checked-div-i64 x inc of
    None -> 0
    Some q ->
      let m = wrapping-mul-i64 q inc in
      if m > x then wrapping-sub-i64 m inc else m

  half-pick :: RoundMode -> I64 -> I64 -> I64 -> I64 -> I64
  half-pick m inc x f c = case m of
    HalfCeil -> c
    HalfFloor -> f
    HalfExpand -> if x < 0 then f else c
    HalfTrunc -> if x < 0 then c else f
    HalfEven -> if floor-mul (wrapping-mul-i64 inc 2) f == f then f else c
    Ceil -> c
    Floor -> f
    Expand -> if x < 0 then f else c
    Trunc -> if x < 0 then c else f

  is-half-mode :: RoundMode -> Bool
  is-half-mode m = case m of
    HalfCeil -> True
    HalfFloor -> True
    HalfExpand -> True
    HalfTrunc -> True
    HalfEven -> True
    Ceil -> False
    Floor -> False
    Expand -> False
    Trunc -> False

  reference :: RoundMode -> I64 -> I64 -> I64
  reference m inc x =
    let f = floor-mul inc x in
    if f == x then x
    else
      let c = wrapping-add-i64 f inc in
      let d1 = wrapping-sub-i64 x f in
      let d2 = wrapping-sub-i64 c x in
      if is-half-mode m && d1 < d2 then f
      else if is-half-mode m && d2 < d1 then c
      else half-pick m inc x f c

  mode-of :: I64 -> RoundMode
  mode-of n =
    if n == 0 then Ceil else if n == 1 then Floor else if n == 2 then Expand
    else if n == 3 then Trunc else if n == 4 then HalfCeil else if n == 5 then HalfFloor
    else if n == 6 then HalfExpand else if n == 7 then HalfTrunc else HalfEven

  sweep-x :: RoundMode -> I64 -> I64 -> Bool
  sweep-x m inc x =
    if x > 40 then True
    else if k m inc x (reference m inc x) then sweep-x m inc (wrapping-add-i64 x 1)
    else False

  sweep-inc :: RoundMode -> I64 -> Bool
  sweep-inc m inc =
    if inc > 8 then True
    else if sweep-x m inc (-40) then sweep-inc m (wrapping-add-i64 inc 1)
    else False

  sweep-mode :: I64 -> Bool
  sweep-mode n =
    if n > 8 then True
    else if sweep-inc (mode-of n) 1 then sweep-mode (wrapping-add-i64 n 1)
    else False

  -- 8: exhaustive agreement with the reference: nine modes, increments
  -- 1..=8, values -40..=40.
  check-exhaustive :: Int
  check-exhaustive = if sweep-mode 0 then 0 else 8

  big :: I128
  big = 170141183460469231731687303715884105727

  -- 16: refusals (increment below 1, the minimum, an overflowing
  -- result) and exactness at the wide end.
  check-refusals :: Int
  check-refusals =
    if refused (round-i128 Trunc 0 5) && refused (round-i128 Trunc (-3) 5)
       && refused (round-i128 Trunc 1 min-bound-i128)
       && refused (round-i128 Ceil 10 big) && refused (round-i128 Expand 10 big)
       && refused (round-i128 Floor 10 (wrapping-neg-i128 big))
       && refused (round-i128 Trunc 10 big) == False
       && refused (round-i128 Ceil 1 big) == False
       && refused (round-i128 HalfEven big big) == False
       && k Trunc 9223372036854775807 9223372036854775806 0
       && k Expand 9223372036854775807 1 9223372036854775807
       && k HalfExpand 3600000000000 9000000000000 10800000000000
       && k Trunc 3600000000000 9000000000000 7200000000000
    then 0 else 16

  -- 32: rounding as if positive reads the direction-free modes on the
  -- number line for either sign.
  check-as-if-positive :: Int
  check-as-if-positive =
    if kp Trunc 10 (-15) (-20) && kp Expand 10 (-15) (-10)
       && kp HalfExpand 10 (-15) (-10) && kp HalfTrunc 10 (-15) (-20)
       && kp HalfEven 10 (-15) (-20) && kp HalfEven 10 (-25) (-20)
       && kp Ceil 10 (-15) (-10) && kp Floor 10 (-15) (-20)
       && kp HalfCeil 10 (-15) (-10) && kp HalfFloor 10 (-15) (-20)
       && kp Trunc 10 15 10 && kp Expand 10 15 20 && kp HalfExpand 10 15 20
       && kp HalfTrunc 10 15 10 && kp HalfExpand 10 (-16) (-20) && kp HalfTrunc 10 (-14) (-10)
       && kp Trunc 10 (-20) (-20) && kp Expand 10 0 0
    then 0 else 32

  neg-x :: RoundMode -> I64 -> I64 -> Bool
  neg-x m inc x =
    if x > 30 then True
    else if k (round-mode-negate m) inc (wrapping-neg-i64 x) (wrapping-neg-i64 (reference m inc x))
      then neg-x m inc (wrapping-add-i64 x 1)
    else False

  neg-mode :: I64 -> Bool
  neg-mode n =
    if n > 8 then True
    else if neg-x (mode-of n) 4 (-30) && neg-x (mode-of n) 5 (-30) then neg-mode (wrapping-add-i64 n 1)
    else False

  -- 64: rounding the negation under the negated mode is the negation.
  check-negate :: Int
  check-negate = if neg-mode 0 then 0 else 64

  -- 128: the three increment validators.
  check-increments :: Int
  check-increments =
    if unit-span-increment-ok Hour 1 && unit-span-increment-ok Hour 12 && unit-span-increment-ok Hour 8
       && unit-span-increment-ok Hour 24 == False && unit-span-increment-ok Hour 5 == False
       && unit-span-increment-ok Hour 0 == False && unit-span-increment-ok Hour (-2) == False
       && unit-span-increment-ok Minute 30 && unit-span-increment-ok Minute 15
       && unit-span-increment-ok Minute 60 == False && unit-span-increment-ok Minute 7 == False
       && unit-span-increment-ok Second 20 && unit-span-increment-ok Second 45 == False
       && unit-span-increment-ok Millisecond 500 && unit-span-increment-ok Millisecond 1000 == False
       && unit-span-increment-ok Microsecond 250 && unit-span-increment-ok Nanosecond 3 == False
       && unit-span-increment-ok Day 7 && unit-span-increment-ok Year 1000000000
       && unit-span-increment-ok Month 1000000001 == False && unit-span-increment-ok Week 0 == False
       && unit-round-increment-ok Day 1 && unit-round-increment-ok Day 2 == False
       && unit-round-increment-ok Week 1 == False && unit-round-increment-ok Month 1 == False
       && unit-round-increment-ok Year 1 == False
       && unit-round-increment-ok Minute 30 && unit-round-increment-ok Hour 24 == False
       && unit-round-increment-ok Nanosecond 100 && unit-round-increment-ok Second 60 == False
       && unit-timestamp-increment-ok Hour 24 && unit-timestamp-increment-ok Hour 5 == False
       && unit-timestamp-increment-ok Minute 1440 && unit-timestamp-increment-ok Minute 90
       && unit-timestamp-increment-ok Minute 7 == False
       && unit-timestamp-increment-ok Second 86400 && unit-timestamp-increment-ok Millisecond 86400000
       && unit-timestamp-increment-ok Microsecond 100000000
       && unit-timestamp-increment-ok Microsecond 86400000000 == False
       && unit-timestamp-increment-ok Nanosecond 1000000000
       && unit-timestamp-increment-ok Nanosecond 7 == False
       && unit-timestamp-increment-ok Day 1 == False && unit-timestamp-increment-ok Hour 0 == False
    then 0 else 128

  main :: Int
  main =
    check-units + check-table-a + check-table-b + check-exhaustive
    + check-refusals + check-as-if-positive + check-negate + check-increments
