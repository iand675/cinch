-- Read-only views into a validated package's packed AST. Terms carry the
-- byte owner and a node ID, so consumers can traverse children in place.
module Cinch.PackedBody where

  import Data.Array (array-from-list, array-length, array-get)
  import Data.Bytes (bytes-data, bytes-len)
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Data.Json
  import Data.List (reverse)
  import Data.Machine (u32-to-nat)
  import Data.Nat (nat-to-int)

  export Region, PackedSignature, package-offset, hold-package-source
  export CheckedBodyTable, retain-checked-body-table, checked-body-id, checked-definition
  export checked-term, packed-term-json
  export PackedTerm, PackedArguments, same-packed-term, packed-node, packed-argument-node
  export PackedNode, PackedLocal, PackedNumber, PackedBool, PackedPrimitive, PackedCall, PackedLet, PackedIf, InvalidPackedTerm
  export PackedArgumentNode, NoPackedArguments, NextPackedArgument

  -- All callers have checked the position against the 32-bit package extents.
  foreign import ccall "cinch.runtime.packageOffset" package-offset :: Nat -> I64

  -- Read one word inside the caller's checked span.
  prim load-word :: I64 -> I64 -> U32 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %ptr = getelementptr i8, ptr %base, i64 %1
      %word = load i32, ptr %ptr, align 1
      ret i32 %word
    } when endian little
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %ptr = getelementptr i8, ptr %base, i64 %1
      %word = load i32, ptr %ptr, align 1
      %value = call i32 @llvm.bswap.i32(i32 %word)
      ret i32 %value
    } when endian big

  record Region where
    start :: Nat
    length :: Nat
  record PackedSignature where
    field0 :: String
    field1 :: List String
    field2 :: String
    field3 :: Nat
    field4 :: Region
  -- Immutable Share-safe packed body view: all node words, operand words, and
  -- signature callee lists are materialized into immutable arrays on load so
  -- `CheckedBodyTable` and `Cinch.Document.Json` carry no mutable `Bytes`.
  record CheckedBodyTable where
    identity :: I64
    size :: Nat
    strings :: Array String
    nodes :: Array Nat
    operands :: Array Nat
    signatures :: Array PackedSignature
    callees :: Array (Option (List String))
    indexed :: HashMap String Nat
  record PackedTerm where
    field0 :: CheckedBodyTable
    field1 :: Nat
  record PackedArguments where
    field0 :: CheckedBodyTable
    field1 :: Nat
    field2 :: Nat
  data PackedNode where
    PackedLocal :: Nat -> PackedNode
    PackedNumber :: String -> String -> PackedNode
    PackedBool :: Bool -> PackedNode
    PackedPrimitive :: String -> PackedArguments -> PackedNode
    PackedCall :: String -> PackedArguments -> PackedNode
    PackedLet :: PackedTerm -> PackedTerm -> PackedNode
    PackedIf :: PackedTerm -> PackedTerm -> PackedTerm -> PackedNode
    InvalidPackedTerm :: PackedNode
  data PackedArgumentNode where
    NoPackedArguments :: PackedArgumentNode
    NextPackedArgument :: PackedTerm -> PackedArguments -> PackedArgumentNode

  word :: I64 -> Nat -> Nat
  word address at = u32-to-nat (load-word address (package-offset at))

  -- Keep the owner live until the decoder has finished its raw reads.
  hold-package-source :: forall a. Bytes -> a -> a
  hold-package-source source result = case bytes-len source of _ -> result

  read-region-words :: I64 -> Nat -> Nat -> List Nat -> Array Nat
  read-region-words address at end backwards =
    if at + 4 > end then array-from-list (reverse backwards)
    else read-region-words address (at + 4) end (Cons (word address at) backwards)

  extract-region-words :: Bytes -> Region -> Array Nat
  extract-region-words source region = case region of
    Region start size ->
      if start + size <= bytes-len source && size % 4 == 0 then
        hold-package-source source (read-region-words (bytes-data source) start (start + size) Nil)
      else array-from-list Nil

  extract-signature-callees :: Bytes -> Array PackedSignature -> Nat -> List (Option (List String)) -> Array (Option (List String))
  extract-signature-callees source signatures at backwards = case array-get signatures at of
    None -> array-from-list (reverse backwards)
    Some (PackedSignature identity parameters result root (Region start length)) ->
      let calls =
            if start + length <= bytes-len source && length % 4 == 0 then
              hold-package-source source (packed-callees (bytes-data source) signatures start (start + length) Nil)
            else None in
      extract-signature-callees source signatures (at + 1) (Cons calls backwards)

  -- Package alone validates the sections before handing them to this view.
  retain-checked-body-table :: Bytes -> Array String -> Region -> Region -> Array PackedSignature -> CheckedBodyTable
  retain-checked-body-table source strings nodes operands signatures =
    let node-words = extract-region-words source nodes in
    let operand-words = extract-region-words source operands in
    let callees = extract-signature-callees source signatures 0 Nil in
    let identity = hold-package-source source (bytes-data source) in
    CheckedBodyTable identity (bytes-len source) strings node-words operand-words signatures callees (index-packed-signatures signatures 0 hash-map-empty)

  index-packed-signatures :: Array PackedSignature -> Nat -> HashMap String Nat -> HashMap String Nat
  index-packed-signatures signatures at indexed = case array-get signatures at of
    None -> indexed
    Some (PackedSignature name parameters result root edges) ->
      index-packed-signatures signatures (at + 1) (hash-map-insert name at indexed)

  checked-body-id :: CheckedBodyTable -> String -> Option Nat
  checked-body-id (CheckedBodyTable identity size strings nodes operands signatures callees indexed) name = hash-map-lookup name indexed

  checked-term :: CheckedBodyTable -> Nat -> Option PackedTerm
  checked-term table id = case table of
    CheckedBodyTable identity size strings nodes operands signatures callees indexed -> case array-get signatures id of
      Some (PackedSignature name parameters result root edges) -> Some (PackedTerm table root)
      None -> None

  checked-definition :: CheckedBodyTable -> Nat -> Option (String, List String, String, PackedTerm, List String)
  checked-definition table id = case table of
    CheckedBodyTable identity size strings nodes operands signatures callees indexed -> (case (array-get signatures id, array-get callees id) of
      (Some (PackedSignature name parameters result root edges), Some (Some calls)) ->
        Some (name, parameters, result, PackedTerm table root, calls)
      other -> None)

  packed-callees :: I64 -> Array PackedSignature -> Nat -> Nat -> List String -> Option (List String)
  packed-callees address signatures at end backwards =
    if at == end then Some (reverse backwards) else
      (case array-get signatures (word address at) of
        Some (PackedSignature name parameters result root edges) ->
          packed-callees address signatures (at + 4) end (Cons name backwards)
        None -> None)

  -- Node IDs identify a checked definition only within the same retained
  -- snapshot.
  same-packed-term :: PackedTerm -> PackedTerm -> Bool
  same-packed-term (PackedTerm first a) (PackedTerm second b) =
    a == b && (case (first, second) of
      (CheckedBodyTable id1 len1 s1 n1 o1 sig1 c1 idx1, CheckedBodyTable id2 len2 s2 n2 o2 sig2 c2 idx2) ->
        id1 == id2 && len1 == len2 && array-length n1 == array-length n2 && array-length o1 == array-length o2)

  packed-node :: PackedTerm -> PackedNode
  packed-node (PackedTerm table id) = case table of
    CheckedBodyTable identity size strings nodes operands signatures callees indexed ->
      let base = id * 4 in
      case (array-get nodes base, array-get nodes (base + 1), array-get nodes (base + 2), array-get nodes (base + 3)) of
        (Some tag, Some a, Some b, Some c) -> packed-node-words table strings signatures tag a b c
        other -> InvalidPackedTerm

  packed-node-words :: CheckedBodyTable -> Array String -> Array PackedSignature -> Nat -> Nat -> Nat -> Nat -> PackedNode
  packed-node-words table strings signatures tag a b c =
    case tag of
      0 -> PackedLocal a
      1 -> (case (array-get strings a, array-get strings b) of
        (Some sort, Some decimal) -> PackedNumber sort decimal
        other -> InvalidPackedTerm)
      2 -> PackedBool (a == 1)
      3 -> (case array-get strings a of
        Some operation -> PackedPrimitive operation (packed-arguments table b c)
        None -> InvalidPackedTerm)
      4 -> (case array-get signatures a of
        Some (PackedSignature name parameters result root edges) -> PackedCall name (packed-arguments table b c)
        None -> InvalidPackedTerm)
      5 -> PackedLet (PackedTerm table a) (PackedTerm table b)
      6 -> PackedIf (PackedTerm table a) (PackedTerm table b) (PackedTerm table c)
      other -> InvalidPackedTerm

  -- These offsets come only from checked nodes and operand ranges. The
  -- private cursors can advance through that range or follow a checked ID.
  packed-arguments :: CheckedBodyTable -> Nat -> Nat -> PackedArguments
  packed-arguments table first count = case table of
    CheckedBodyTable identity size strings nodes operands signatures callees indexed ->
      let end = first + count in
      if end <= array-length operands then PackedArguments table first end
      else PackedArguments table 0 0

  packed-argument-node :: PackedArguments -> PackedArgumentNode
  packed-argument-node (PackedArguments table at end) =
    if at >= end then NoPackedArguments else
      (case table of
        CheckedBodyTable identity size strings nodes operands signatures callees indexed ->
          case array-get operands at of
            Some id -> NextPackedArgument (PackedTerm table id) (PackedArguments table (at + 1) end)
            None -> NoPackedArguments)

  -- Legacy interfaces spell these same nodes as canonically ordered JSON.
  packed-term-json :: PackedTerm -> Json
  packed-term-json term = case packed-node term of
    PackedLocal slot -> JObj "node" (JStr "local") (JObj "slot" (JNum (nat-to-int slot)) JObjEnd)
    PackedNumber sort decimal -> JObj "decimal" (JStr decimal) (JObj "node" (JStr "number") (JObj "sort" (JStr sort) JObjEnd))
    PackedBool value -> JObj "node" (JStr "bool") (JObj "value" (JBool value) JObjEnd)
    PackedPrimitive operation args -> JObj "arguments" (packed-args-json args)
      (JObj "node" (JStr "primitive") (JObj "operation" (JStr operation) JObjEnd))
    PackedCall callee args -> JObj "arguments" (packed-args-json args)
      (JObj "node" (JStr "call") (JObj "target" (JStr callee) JObjEnd))
    PackedLet value body -> JObj "body" (packed-term-json body) (JObj "node" (JStr "let") (JObj "value" (packed-term-json value) JObjEnd))
    PackedIf condition yes no -> JObj "condition" (packed-term-json condition) (JObj "no" (packed-term-json no)
      (JObj "node" (JStr "if") (JObj "yes" (packed-term-json yes) JObjEnd)))
    InvalidPackedTerm -> JNull

  packed-args-json :: PackedArguments -> Json
  packed-args-json args = case packed-argument-node args of
    NoPackedArguments -> JArrEnd
    NextPackedArgument first rest -> JArr (packed-term-json first) (packed-args-json rest)
