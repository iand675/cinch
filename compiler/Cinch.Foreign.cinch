-- C boundary plans are built from checked types. A source name or a display
-- string never supplies a calling convention, ownership fact or total body.
module Cinch.Foreign where
  import Cinch.Type
  import Cinch.Target (condition-render, primitive-target, when-vocabulary, host-profile)
  import Cinch.Ast (PrimBody, PrimTarget, UnprojectedPrimitive, ApplicablePrimitive, InapplicablePrimitive, RewriteJustification, Expr)
  import Cinch.Core (contract-scheme-closed)
  import Cinch.ExportType (export-type, export-global, export-display-scheme)
  import Cinch.Interface (fnv-source-hash)
  import Cinch.Document
  import Data.Nat (nat-to-int)
  import Data.Char (is-ascii-alpha-numeric, is-ascii-digit)
  import Category.Foldable (all)
  import Text.Show (nat-to-string)
  import Text.Scan (string-contains, string-split-on, string-starts-with, string-ends-with, string-strip, string-words, string-unwords)
  import Algebra.Semigroup

  export ForeignPlan, ForeignParameter, foreign-plan, foreign-export-plan
  export foreign-blocking
  export foreign-pointer, foreign-document, foreign-display-scheme
  export InlinePrimitive, primitive-plan, foreign-inline, foreign-primitive-assumptions
  export primitive-object-callable, foreign-primitive-selection, foreign-primitive-total-op
  export PrimitiveFragment
  export PrimUseContract
  export foreign-llvm-type, primitive-layout

  record ForeignParameter where
    parameter-type :: UType
    class :: String
    role :: String
    width :: Nat
    align :: Nat
    signed :: Bool
    nullable :: Bool
  record PrimUseContract where
    use-symbol :: String
    use-params :: List ForeignParameter
    use-result :: ForeignParameter
  record PrimitiveFragment where
    text :: String
    symbols :: List String
    immediates :: List Nat
    contracts :: List PrimUseContract
  record FamilyCandidates where
    fallback :: Option PrimitiveFragment
    matched :: Option (String, PrimitiveFragment)
  record InlinePrimitive where
    owner :: String
    chosen :: String
    immediates :: List Nat
    llvm :: Option PrimitiveFragment
    assembly :: Option PrimitiveFragment
  record ForeignPlan where
    symbol :: String
    scheme :: Scheme
    parameters :: List ForeignParameter
    result :: ForeignParameter
    inline :: Option (InlinePrimitive, Option String, List String, Json)
  foreign-inline :: ForeignPlan -> Option InlinePrimitive
  foreign-inline plan = case plan of ForeignPlan symbol scheme params result inline -> (case inline of Some (body, identity, trust, selection) -> Some body; None -> None)
  -- A public worker receives ordinary arguments. Immediate-only operands
  -- must still be checked at a direct call with their actual literal values.
  primitive-object-callable :: ForeignPlan -> Bool
  primitive-object-callable plan = case foreign-inline plan of
    Some (InlinePrimitive owner family Nil llvm assembly) -> pure-primitive-arrows (scheme-body (plan.scheme))
    other -> False
  pure-primitive-arrows :: UType -> Bool
  pure-primitive-arrows ty = case refinement-view ty of
    UFun domain result -> pure-primitive-arrows result
    UPi id name domain (URow UEnd) result -> pure-primitive-arrows result
    URefine id name base pred -> pure-primitive-arrows base
    UCon name KType -> True
    other -> False
  foreign-primitive-assumptions :: ForeignPlan -> Option (Option String, List String)
  foreign-primitive-assumptions plan = case plan of
    ForeignPlan symbol scheme params result inline ->
      (case inline of Some (body, identity, trust, selection) -> Some (identity, trust); None -> None)
  foreign-primitive-selection :: ForeignPlan -> Option Json
  foreign-primitive-selection plan = case plan of
    ForeignPlan symbol scheme params result (Some (body, identity, trust, selection)) -> Some selection
    other -> None
  nonempty-ir-lines :: List String -> List (List String)
  nonempty-ir-lines lines = case lines of
    Nil -> Nil
    Cons line rest -> let words = ir-line-words line in
      case words of
        Nil -> nonempty-ir-lines rest
        Cons first more -> Cons words (nonempty-ir-lines rest)
  i64-cmp-total-name :: String -> Option String
  i64-cmp-total-name pred =
    if same pred "eq" then Some "I64Eq"
    else if same pred "ne" then Some "I64Ne"
    else if same pred "slt" then Some "I64Lt"
    else if same pred "sle" then Some "I64Le"
    else if same pred "sgt" then Some "I64Gt"
    else if same pred "sge" then Some "I64Ge"
    else None
  foreign-primitive-total-op :: ForeignPlan -> Option (String, List String, String)
  foreign-primitive-total-op plan = case foreign-inline plan of
    Some (InlinePrimitive owner family Nil (Some (PrimitiveFragment fragment symbols immarg uses)) assembly) ->
      (case nonempty-ir-lines (string-split-on "\n" fragment) of
        [[c, op1, pred, ty1, a0, a1], [r, op2, ty2, c2, kw, ty3], [op3, ty4, r2]] ->
          if same op1 "icmp" && same ty1 "i64" && same a0 "%0" && same a1 "%1"
              && same op2 "zext" && same ty2 "i1" && same c c2 && same kw "to" && same ty3 "i8"
              && same op3 "ret" && same ty4 "i8" && same r r2 then
            (case i64-cmp-total-name pred of
              Some total-op -> Some (total-op, ["I64", "I64"], "Bool")
              None -> None)
          else None
        other -> None)
    other -> None
  foreign-llvm-type :: ForeignParameter -> String
  foreign-llvm-type parameter =
    if same (parameter.class) "unit" then "void"
    else if same (parameter.class) "ptr" then "ptr"
    else case parameter.parameter-type of
      UCon name KType -> if same name "F32" then "float" else if same name "F64" then "double"
        else string-concat "i" (nat-to-string (parameter.width * 8))
      other -> string-concat "i" (nat-to-string (parameter.width * 8))
  same :: String -> String -> Bool
  same first second = string-compare first second == 0
  has :: String -> List String -> Bool
  has name names = case names of Nil -> False; Cons first rest -> same name first || has name rest
  -- Pointer and scalar sizes here are the compiler's existing 64-bit target
  -- ABI, not the generator host's sizeof. Other target word sizes refuse.
  scalar :: String -> Option (Nat, Bool)
  scalar name = if has name ["I8", "U8"] then Some (1, same name "I8")
    else if has name ["I16", "U16"] then Some (2, same name "I16")
    else if has name ["I32", "U32", "F32"] then Some (4, same name "I32")
    else if has name ["I64", "U64", "Isize", "Usize", "F64"] then Some (8, same name "I64" || same name "Isize")
    -- C's `__int128`: LLVM `i128` (design/wide-scalars.md section 7).
    else if has name ["I128", "U128"] then Some (16, same name "I128")
    else None
  head-name :: UType -> Option String
  head-name ty = case ty of UCon name kind -> Some name; UApp head argument -> head-name head; other -> None
  parameter :: List String -> UType -> Result String ForeignParameter
  parameter abstracts ty = if not (valid-type ty && kind-equal (type-kind ty) KType) then Err "foreign boundary needs a closed proper carrier" else case ty of
    UCon name KType -> if same name "Unit" then Ok (ForeignParameter ty "unit" "value" 0 1 False False)
      else (case scalar name of
        Some (width, signed) -> Ok (ForeignParameter ty "scalar" "value" width width signed False)
        None -> if not (has name ["Int", "Nat", "Bool", "Bytes", "String", "Char", "Sym"]) && has name abstracts then Ok (ForeignParameter ty "ptr" "opaque-handle" 8 8 False False) else Err (string-concat name " has no C representation at the foreign boundary"))
    UApp (UCon name kind) pointee -> if foreign-pointer ty then
        Ok (ForeignParameter ty "ptr" (if same name "RawPtr" then "raw" else if same name "Borrowed" then "borrowed" else "maybe-null") 8 8 False (same name "MaybeNull"))
      else if has name ["Owned", "Retained", "Out"] then Err "foreign ownership, retention and out-cell protocols require their checked resource plans"
      else (case head-name ty of Some owner -> if has owner abstracts then Ok (ForeignParameter ty "ptr" "opaque-handle" 8 8 False False) else Err "aggregate or higher-order type has no supported C representation"; None -> Err "foreign carrier is not a recorded C representation")
    other -> Err "refined, polymorphic, proof and function values cannot be assumed to have a C representation"
  region-quantifiers :: List Quant -> Bool
  region-quantifiers qs = case qs of Nil -> True; Cons q rest -> kind-equal (q.kind) KRegion && region-quantifiers rest
  closed-labels :: UType -> Bool
  closed-labels labels = case labels of UEnd -> True; UArg label rest -> kind-equal (type-kind label) KEffect && valid-type label && closed-labels rest; other -> False
  closed-row :: UType -> Bool
  closed-row row = case row of URow labels -> closed-labels labels; other -> False
  accounted-labels :: UType -> Bool
  accounted-labels labels = case labels of
    UArg label rest -> (case head-name label of Some name -> has name ["Foreign", "IO", "#kernel.ForeignIO", "Global", "Blocking", "Diverge", "Fail", "Reentrant", "ThreadAffine"]; None -> False) || accounted-labels rest
    other -> False
  -- Only the kernel Blocking label on a checked call arrow enters the scheduler.
  blocking-labels :: UType -> Bool
  blocking-labels labels = case labels of
    UArg (UCon name KEffect) rest -> same name "Blocking" || blocking-labels rest
    UArg other rest -> blocking-labels rest
    other -> False
  blocking-arrow :: UType -> Bool
  blocking-arrow ty = case ty of
    UFun domain result -> blocking-arrow result
    UFunEff domain (URow labels) result -> blocking-labels labels || blocking-arrow result
    UPi id name domain (URow labels) result -> blocking-labels labels || blocking-arrow result
    other -> False
  foreign-blocking :: ForeignPlan -> Bool
  foreign-blocking plan = blocking-arrow (scheme-body (plan.scheme))
  envelope-error :: Bool -> UType -> Option String
  envelope-error importing ty = case ty of
    UFun domain result -> arrow-envelope-error importing (URow UEnd) result
    UFunEff domain row result -> arrow-envelope-error importing row result
    UPi id name domain row result -> arrow-envelope-error importing row result
    other -> Some "foreign import needs a function type"
  arrow-envelope-error :: Bool -> UType -> UType -> Option String
  arrow-envelope-error importing row result = case row of
    URow labels -> case result of
      UFun domain more -> if closed-row row then envelope-error importing result else Some "foreign effect rows must be closed and explicit"
      UFunEff domain effects more -> if closed-row row then envelope-error importing result else Some "foreign effect rows must be closed and explicit"
      UPi id name domain effects more -> if closed-row row then envelope-error importing result else Some "foreign effect rows must be closed and explicit"
      other -> if importing && not (accounted-labels labels) then Some "foreign import needs a function type, closed explicit rows and accounted result effects: a foreign import must declare its effects because an external function is not pure"
        else if closed-row row then None else Some "foreign effect rows must be closed and explicit"
    other -> Some "foreign effect rows must be closed and explicit"
  parameters :: List String -> UType -> List ForeignParameter -> Result String (List ForeignParameter, ForeignParameter)
  parameters abstracts ty backwards = case ty of
    UFun domain result -> add-parameter abstracts domain result backwards
    UFunEff domain row result -> add-parameter abstracts domain result backwards
    UPi id name domain row result -> add-parameter abstracts domain result backwards
    other -> case parameter abstracts ty of Err error -> Err error; Ok result -> Ok (reverse backwards, result)
  add-parameter :: List String -> UType -> UType -> List ForeignParameter -> Result String (List ForeignParameter, ForeignParameter)
  add-parameter abstracts domain result backwards = case parameter abstracts domain of
    Err error -> Err error
    Ok argument -> parameters abstracts result (Cons argument backwards)
  -- The intrinsic namespaces are reserved: a symbol there without a checked
  -- runtime contract names a retired or unknown intrinsic, never C. Any
  -- other nonempty symbol is a C object name, quoted as an LLVM global.
  reserved-symbol :: String -> Bool
  reserved-symbol name = string-starts-with "cinch.prim." name || string-starts-with "cinch.runtime." name
  foreign-plan :: Nat -> List String -> String -> Scheme -> Result String ForeignPlan
  foreign-plan = checked-foreign-plan-for True
  foreign-export-plan :: Nat -> List String -> String -> Scheme -> Result String ForeignPlan
  foreign-export-plan = checked-foreign-plan-for False

  checked-foreign-plan-for :: Bool -> Nat -> List String -> String -> Scheme -> Result String ForeignPlan
  checked-foreign-plan-for importing word-bits abstracts symbol scheme = if word-bits /= 64 then Err "foreign boundary target ABI is not supported"
    else if reserved-symbol symbol then Err (string-concat-all ["foreign symbol ", symbol, " is not a cinch intrinsic; only cinch.prim.* and cinch.runtime.* intrinsics are supported in the bootstrap slice"])
    else if string-length symbol == 0 then Err "foreign symbol is empty"
    else if not importing && (string-starts-with "llvm." symbol || string-starts-with "cinch." symbol || string-starts-with "cinch_" symbol) then Err "reserved foreign export symbol"
    else case envelope-error importing (scheme-body scheme) of
      Some error -> Err error
      None -> if not (contract-scheme-closed scheme) then Err "foreign scheme has an unbound or unresolved contract"
        else if not (region-quantifiers (scheme-params scheme)) || list-length (scheme-requirements scheme) /= 0 then Err "foreign binding cannot be polymorphic or constrained"
        else case parameters abstracts (scheme-body scheme) Nil of
          Err error -> Err error
          Ok (arguments, result) -> Ok (ForeignPlan symbol scheme arguments result None)
  primitive-carrier :: UType -> Result String ForeignParameter
  primitive-carrier ty = case refinement-view ty of
    URefine id name base pred -> primitive-carrier base
    UCon name KType -> if same name "Bool" then Ok (ForeignParameter ty "scalar" "value" 1 1 False False)
      else if same name "Char" then Ok (ForeignParameter ty "scalar" "value" 4 4 False False)
      else (case scalar name of
        Some (width, signed) -> Ok (ForeignParameter ty "scalar" "value" width width signed False)
        None -> Err "a prim needs a first-order machine scalar carrier")
    other -> Err "a prim needs a first-order machine scalar carrier"
  primitive-use-result :: UType -> Result String ForeignParameter
  primitive-use-result ty = case ty of
    UCon name KType | same name "Unit" -> Ok (ForeignParameter ty "unit" "value" 0 1 False False)
    other -> primitive-carrier ty
  primitive-use-parameters :: UType -> List ForeignParameter -> Result String (List ForeignParameter, ForeignParameter)
  primitive-use-parameters ty backwards = case ty of
    UFun domain rest -> case primitive-carrier domain of
      Ok argument -> primitive-use-parameters rest (Cons argument backwards)
      Err error -> Err error
    UFunEff domain row rest -> if closed-row row then (case primitive-carrier domain of
        Ok argument -> primitive-use-parameters rest (Cons argument backwards)
        Err error -> Err error)
      else Err "a uses entry needs closed explicit effect rows"
    UPi id name domain row rest -> if closed-row row then (case primitive-carrier domain of
        Ok argument -> primitive-use-parameters rest (Cons argument backwards)
        Err error -> Err error)
      else Err "a uses entry needs closed explicit effect rows"
    other -> case primitive-use-result ty of
      Ok result -> Ok (reverse backwards, result)
      Err error -> Err error
  check-prim-use-contract :: (String, Scheme) -> Result String PrimUseContract
  check-prim-use-contract entry = case entry of
    (sym, scheme) ->
      if reserved-symbol sym then Err (string-concat-all ["the intrinsic namespaces are reserved: uses must not name ", sym])
      else if string-length sym == 0 then Err "a uses entry needs a non-empty symbol name"
      else if not (contract-scheme-closed scheme) || list-length (scheme-params scheme) /= 0 || list-length (scheme-requirements scheme) /= 0 then
        Err "a uses entry needs a monomorphic unconstrained machine ABI"
      else case primitive-use-parameters (scheme-body scheme) Nil of
        Err error -> Err error
        Ok (params, result) -> Ok (PrimUseContract sym params result)
  check-prim-uses :: List (String, Scheme) -> Result String (List PrimUseContract)
  check-prim-uses entries = case entries of
    Nil -> Ok Nil
    Cons entry rest -> case check-prim-use-contract entry of
      Err error -> Err error
      Ok entry-contract -> case check-prim-uses rest of
        Err error -> Err error
        Ok more -> Ok (Cons entry-contract more)
  prim-use-symbols :: List PrimUseContract -> List String
  prim-use-symbols contracts = case contracts of
    Nil -> Nil
    Cons c rest -> Cons (string-concat "@" (c.use-symbol)) (prim-use-symbols rest)
  primitive-parameters :: UType -> List ForeignParameter -> Result String (List ForeignParameter, ForeignParameter)
  primitive-parameters ty backwards = case ty of
    UFun domain rest -> primitive-domain domain rest backwards
    UFunEff domain row rest -> if closed-row row then primitive-domain domain rest backwards
      else Err "a prim needs closed explicit effect rows"
    UPi id name domain row rest -> if closed-row row then primitive-domain domain rest backwards
      else Err "a prim needs closed explicit effect rows"
    other -> (case (backwards, primitive-carrier ty) of
      (Nil, result) -> Err "a prim declaration needs a function type"
      (arguments, Ok result) -> Ok (reverse arguments, result)
      (arguments, Err message) -> Err message)
  primitive-domain :: UType -> UType -> List ForeignParameter -> Result String (List ForeignParameter, ForeignParameter)
  primitive-domain domain rest backwards = case primitive-carrier domain of
    Ok argument -> primitive-parameters rest (Cons argument backwards)
    Err error -> Err error
  immediate-indices-valid :: Nat -> List Nat -> List Nat -> Bool
  immediate-indices-valid arity indices seen = case indices of
    Nil -> True
    Cons first rest -> first < arity && not (has-index first seen) && immediate-indices-valid arity rest (Cons first seen)
  has-index :: Nat -> List Nat -> Bool
  has-index value values = case values of Nil -> False; Cons first rest -> value == first || has-index value rest
  allowed-intrinsic :: String -> Bool
  allowed-intrinsic symbol =
    string-starts-with "@llvm.bswap." symbol
      || string-starts-with "@llvm.ctpop." symbol
      || string-starts-with "@llvm.ctlz." symbol
      || string-starts-with "@llvm.cttz." symbol
      || string-starts-with "@llvm.bitreverse." symbol
      || string-starts-with "@llvm.fshl." symbol
      || string-starts-with "@llvm.fshr." symbol
      || string-starts-with "@llvm.smin." symbol
      || string-starts-with "@llvm.smax." symbol
      || string-starts-with "@llvm.umin." symbol
      || string-starts-with "@llvm.umax." symbol
      || string-starts-with "@llvm.fabs." symbol
      || string-starts-with "@llvm.sqrt." symbol
      || string-starts-with "@llvm.sin." symbol
      || string-starts-with "@llvm.cos." symbol
      || string-starts-with "@llvm.exp." symbol
      || string-starts-with "@llvm.log." symbol
      || string-starts-with "@llvm.floor." symbol
      || string-starts-with "@llvm.ceil." symbol
      || string-starts-with "@llvm.trunc." symbol
      || string-starts-with "@llvm.round." symbol
      || string-starts-with "@llvm.roundeven." symbol
      || string-starts-with "@llvm.copysign." symbol
      || string-starts-with "@llvm.sadd.sat." symbol
      || string-starts-with "@llvm.uadd.sat." symbol
      || string-starts-with "@llvm.ssub.sat." symbol
      || string-starts-with "@llvm.usub.sat." symbol
      || string-starts-with "@llvm.sadd.with.overflow." symbol
      || string-starts-with "@llvm.uadd.with.overflow." symbol
      || string-starts-with "@llvm.ssub.with.overflow." symbol
      || string-starts-with "@llvm.usub.with.overflow." symbol
      || string-starts-with "@llvm.smul.with.overflow." symbol
      || string-starts-with "@llvm.umul.with.overflow." symbol
      || same symbol "@llvm.vector.reduce.add.v16i32"
  ir-line-words :: String -> List String
  ir-line-words line = case string-split-on ";" line of
    Nil -> Nil
    Cons code rest -> string-words (pack (ir-token-chars (unpack code)))
  ir-token-chars :: List Char -> List Char
  ir-token-chars chars = case chars of
    Nil -> Nil
    Cons first rest -> let code = char-code first in
      Cons (if code == 40 || code == 41 || code == 44 || code == 61 then ' ' else first) (ir-token-chars rest)
  ir-symbols :: List String -> List String
  ir-symbols words = case words of
    Nil -> Nil
    Cons word rest -> if string-starts-with "@" word then Cons word (ir-symbols rest) else ir-symbols rest
  ir-no-unsafe-punctuation :: String -> Bool
  ir-no-unsafe-punctuation line =
    not (string-contains "\"" line || string-contains "!" line || string-contains "\\" line || string-contains ":" line
      || string-contains "#" line)
  ir-has-word :: List String -> List String -> Bool
  ir-has-word forbidden words = case words of
    Nil -> False
    Cons word rest -> has word forbidden || ir-has-word forbidden rest
  ir-instruction :: List String -> List String
  ir-instruction words = case words of
    Cons first rest -> if string-starts-with "%" first then rest else words
    Nil -> Nil
  -- The trusted subset of embedded assembly operates on registers. The
  -- instruction template, constraints and LLVM operands have separate grammars.
  -- LLVM verifies the operand counts and register types when assembling the IR.
  register-asm-call :: String -> Bool
  register-asm-call line = case string-split-on "\"" line of
    [prefix, template, comma, constraints, suffix] ->
      same (string-strip comma) "," && register-asm-prefix prefix && register-template template
        && all register-constraint (string-split-on "," constraints) && register-call-arguments (string-strip suffix)
    other -> False

  machine-integer :: String -> Bool
  machine-integer ty = has ty ["i8", "i16", "i32", "i64", "i128"]

  register-asm-prefix :: String -> Bool
  register-asm-prefix prefix = case string-words prefix of
    Cons binding (Cons equals (Cons op rest)) ->
      local-ir-name binding && same equals "=" && same op "call" && (case reverse rest of
        Cons keyword types -> same keyword "asm" && (case reverse types of
          [scalar] -> machine-integer scalar
          Cons brace fields -> same brace "{" && (case reverse fields of
            Cons close members -> same close "}" && list-length members /= 0 &&
              all machine-integer (string-words (pack (ir-token-chars (unpack (string-unwords members)))))
            Nil -> False)
          Nil -> False)
        Nil -> False)
    other -> False

  local-ir-name :: String -> Bool
  local-ir-name name = case unpack name of
    Cons sigil chars -> char-code sigil == 37 && list-length chars /= 0 &&
      all (\c -> is-ascii-alpha-numeric c || char-code c == 95 || char-code c == 46) chars
    Nil -> False

  decimal-digits :: String -> Bool
  decimal-digits value = string-length value /= 0 && all is-ascii-digit (unpack value)

  register-constraint :: String -> Bool
  register-constraint value = decimal-digits value ||
    has value ["r", "=r", "=&r", "{ax}", "{bx}", "{cx}", "{dx}", "={ax}", "={bx}", "={cx}", "={dx}", "~{cc}"]

  register-template :: String -> Bool
  register-template template = case string-split-on "\\0A" template of
    [instruction] -> register-instruction instruction
    [directive, instruction] -> same (string-strip directive) ".arch_extension crc" && register-instruction instruction
    other -> False

  register-instruction :: String -> Bool
  register-instruction instruction = case string-words instruction of
    [op] -> same op "cpuid"
    Cons op operands -> has op ["crc32b", "crc32w", "crc32l", "crc32q", "crc32x", "crc32cb", "crc32ch", "crc32cw", "crc32cx", "crc32h"] &&
      all register-placeholder (string-split-on "," (string-unwords operands))
    Nil -> False

  register-placeholder :: String -> Bool
  register-placeholder value = let operand = string-strip value in
    if string-starts-with "${" operand && string-ends-with ":w}" operand then
      (let end = string-length operand in if 3 <= end then decimal-digits (string-slice operand 2 (end - 3)) else False)
    else string-starts-with "$" operand && decimal-digits (string-slice operand 1 (string-length operand))

  register-call-arguments :: String -> Bool
  register-call-arguments suffix = string-starts-with "(" suffix && string-ends-with ")" suffix &&
    (let end = string-length suffix in if 1 <= end then
      all register-call-argument (string-split-on "," (string-slice suffix 1 (end - 1))) else False)

  register-call-argument :: String -> Bool
  register-call-argument argument = case string-words argument of
    [ty, operand] -> machine-integer ty && (local-ir-name operand || decimal-digits operand)
    other -> False

  first-ir-return :: String -> List String -> Bool
  first-ir-return result words = case words of
    Cons operation (Cons actual (Cons operand Nil)) -> same operation "ret" && same actual result
    other -> False
  -- | Validate one straight-line fragment. Explicitly trusted bodies may read
  -- raw memory, invoke inline assembly, or call checked `uses` contracts;
  -- effectful trusted bodies may also write memory or execute atomics.
  contained-ir :: String -> Bool -> Bool -> List String -> List String -> Bool -> List String -> Result String (List String)
  contained-ir result pure trusted use-symbols lines returned symbols = case lines of
    Nil -> if returned then Ok symbols else Err "containment (grammar): an LLVM fragment needs one final return"
    Cons line rest -> let words = ir-line-words line in
      (case ir-instruction words of
        Nil -> if list-length words == 0 then contained-ir result pure trusted use-symbols rest returned symbols
          else Err "containment (grammar): an LLVM result binding needs an instruction"
        Cons operation arguments ->
          if ir-has-word ["invoke", "callbr", "resume", "catchswitch", "catchpad", "cleanuppad", "cleanupret", "catchret", "landingpad"] words then
            Err "containment (no-unwind): the inline body may unwind"
          else if ir-has-word ["define", "declare"] words then Err "containment (signature discipline): a fragment declares extra parameters or results"
          else if (pure && ir-has-word ["store", "atomicrmw", "cmpxchg", "fence", "volatile"] words)
              || (not trusted && ir-has-word ["load", "store", "atomicrmw", "cmpxchg", "fence", "volatile"] words) then
            Err "containment (determinism of effects): this LLVM memory operation has no checked buffer contract"
          else if returned then Err "containment (grammar): an instruction follows the return"
          else if same operation "call" && has "asm" arguments then
            if not trusted then Err "containment: mark an embedded assembly call unsafe to trust its effects"
            else contained-ir result pure trusted use-symbols rest False symbols
          else if not (ir-no-unsafe-punctuation line) then Err "containment (no-escape): unsupported LLVM labels, metadata or quoted operands"
          else if ir-has-word ["br", "switch", "indirectbr", "alloca", "unreachable", "ptrtoint", "asm", "va_arg"] words || (not trusted && ir-has-word ["getelementptr", "ptr", "inttoptr"] words) then
            Err "containment (no-escape): jumps, allocation, pointers and embedded assembly are forbidden"
          else if same operation "ret" then
            if first-ir-return result words && list-length (ir-symbols arguments) == 0 then contained-ir result pure trusted use-symbols rest True symbols
            else Err "containment (signature discipline): LLVM return disagrees with the declared result"
          else if same operation "call" && not (has "call" arguments) then (case ir-symbols arguments of
            [symbol] -> if has symbol use-symbols then
                (if trusted then contained-ir result pure trusted use-symbols rest False symbols
                 else Err "containment: mark a call through uses unsafe to trust its declared effect row")
              else if allowed-intrinsic symbol then contained-ir result pure trusted use-symbols rest False (if has symbol symbols then symbols else Cons symbol symbols)
              else Err "containment (no-escape): the call has no checked intrinsic or uses contract"
            other -> Err "containment (no-escape): an indirect or ambiguous call is forbidden")
          else if has "call" arguments || list-length (ir-symbols arguments) /= 0 then
            Err "containment (no-escape): unchecked calls and symbols are forbidden"
          else if has operation ["add", "sub", "mul", "udiv", "sdiv", "urem", "srem", "shl", "lshr", "ashr", "and", "or", "xor",
              "fadd", "fsub", "fmul", "fdiv", "frem", "fneg", "icmp", "fcmp", "select", "extractvalue", "insertvalue",
              "trunc", "zext", "sext", "fptrunc", "fpext", "fptoui", "fptosi", "uitofp", "sitofp", "bitcast", "freeze",
              "extractelement", "insertelement", "shufflevector"]
              || (trusted && has operation ["inttoptr", "getelementptr", "load"])
              || (trusted && not pure && has operation ["store", "atomicrmw", "cmpxchg", "fence"]) then
            contained-ir result pure trusted use-symbols rest False symbols
          else Err (string-concat "containment (grammar): unsupported LLVM instruction " operation))
  -- Unprojected declarations can also enter through a host-side checked splice.
  checked-target :: PrimTarget -> String -> List Expr -> Result String PrimTarget
  checked-target selected family clauses = case selected of
    UnprojectedPrimitive -> primitive-target family clauses host-profile
    other -> Ok selected
  condition-text :: List Expr -> String
  condition-text clauses = case condition-render clauses of Ok rendered -> rendered; Err message -> ""
  immediate-text :: List Nat -> String
  immediate-text positions = case positions of
    Nil -> ""
    Cons position Nil -> nat-to-string position
    Cons position rest -> string-concat-all [nat-to-string position, ", ", immediate-text rest]
  immediate-list :: List Nat -> String
  immediate-list positions = string-concat-all ["[", immediate-text positions, "]"]
  primitive-identity :: String -> String -> String
  primitive-identity symbol text = string-concat-all ["prim:", symbol, "#", fnv-source-hash (string-to-bytes text)]
  -- This is the Native assumed-body encoding. The checked uses list is
  -- empty in this tier. Source order, whitespace and immarg order matter.
  primitive-body-text :: List PrimBody -> String
  primitive-body-text bodies = case bodies of
    Nil -> ""
    Cons (PrimBody sp family fragment unverified when selected justification uses immediates) rest ->
      string-concat-all [family, "\n", condition-text when, "\n", fragment, "[]", immediate-list immediates, primitive-body-text rest]
  primitive-trust :: String -> List PrimBody -> List String
  primitive-trust symbol bodies = case bodies of
    Nil -> Nil
    Cons (PrimBody sp family fragment unverified when selected justification uses immediates) rest ->
      let more = primitive-trust symbol rest in
      if unverified then Cons (primitive-identity symbol (string-concat-all
        [family, "\n", condition-text when, "\n", fragment, "\n[]\n", immediate-list immediates])) more else more
  contained-assembly :: String -> Bool
  contained-assembly fragment = let words = string-words (pack (ir-token-chars (unpack fragment))) in
    list-length words /= 0 && not (ir-has-word ["syscall", "svc", "int", "udf", "brk", "hlt", "ud2", "trap",
      "call", "callq", "bl", "blr", "ret", "jmp", "br"] words)
  record-candidate :: String -> List Expr -> Bool -> PrimitiveFragment -> FamilyCandidates -> Result String FamilyCandidates
  record-candidate family clauses holds fragment candidates = case candidates of
    FamilyCandidates fallback matched -> case clauses of
      Nil -> (case fallback of
        Some prior -> Err (string-concat-all ["two baseline `", family, "` bodies overlap"])
        None -> Ok (FamilyCandidates (Some fragment) matched))
      other -> if not holds then Ok candidates else (case matched of
        Some prior -> Err (string-concat-all ["overlapping `when` conditions in family `", family, "`"])
        None -> Ok (FamilyCandidates fallback (Some (condition-text clauses, fragment))))

  family-body :: FamilyCandidates -> Option PrimitiveFragment
  family-body candidates = case candidates of
    FamilyCandidates fallback (Some (condition, fragment)) -> Some fragment
    FamilyCandidates fallback None -> fallback

  -- Keep a worker for each applicable family. Calls prefer a guarded body
  -- from either family before falling back to an unconditional body.
  choose-primitive :: String -> FamilyCandidates -> FamilyCandidates -> List String -> Result String (InlinePrimitive, Option String)
  choose-primitive owner llvm assembly missing =
    let finish = \family condition fragment -> case fragment of
          PrimitiveFragment text symbols immediates contracts -> Ok (InlinePrimitive owner family immediates (family-body llvm) (family-body assembly), condition) in
    case (llvm, assembly) of
      (FamilyCandidates base (Some (clause, fragment)), other) -> finish "llvm" (Some clause) fragment
      (other, FamilyCandidates base (Some (clause, fragment))) -> finish "asm" (Some clause) fragment
      (FamilyCandidates (Some fragment) None, other) -> finish "llvm" None fragment
      (other, FamilyCandidates (Some fragment) None) -> finish "asm" None fragment
      other -> Err (string-concat-all ["no body applies to the current target profile: ", strings "; " (reverse missing), ". ", when-vocabulary])

  checked-prim-bodies :: String -> Bool -> List PrimBody -> List (List (String, Scheme)) -> Nat -> String -> Bool -> FamilyCandidates -> FamilyCandidates -> List String -> Result String (InlinePrimitive, Option String)
  checked-prim-bodies owner pure bodies body-uses arity result ptr-sized llvm assembly missing = case bodies of
    Nil -> choose-primitive owner llvm assembly missing
    Cons (PrimBody sp family fragment unverified when selected justification uses immediates) rest ->
      let (this-uses, rest-uses) = case body-uses of Nil -> (Nil, Nil); Cons u us -> (u, us) in
      if not (immediate-indices-valid arity immediates Nil) then Err "duplicate or out-of-range immarg parameter"
      else if has family ["clr", "jvm"] then Err (string-concat family " target-IR family is reserved")
      else if same family "asm" && not unverified then Err "an assembly fragment must mark it `unsafe`"
      else if same family "asm" && not (contained-assembly fragment) then Err "containment (no-escape): the assembly has an empty or escaping fragment"
      else (case check-prim-uses this-uses of
        Err message -> Err message
        Ok contracts -> (case checked-target selected family when of
          Err message -> Err message
          Ok matched ->
            let holds = case matched of ApplicablePrimitive -> True; other -> False in
            let reason = case matched of InapplicablePrimitive detail -> Cons detail missing; other -> missing in
            let body-result = if ptr-sized && string-contains "word-size 32" (condition-text when) then "i32" else result in
            if same family "llvm" then (case contained-ir body-result pure unverified (prim-use-symbols contracts) (string-split-on "\n" fragment) False Nil of
              Err message -> Err message
              Ok symbols -> (case record-candidate family when holds (PrimitiveFragment fragment symbols immediates contracts) llvm of
                Err message -> Err message
                Ok next -> checked-prim-bodies owner pure rest rest-uses arity result ptr-sized next assembly reason))
            else if same family "asm" then (case record-candidate family when holds (PrimitiveFragment fragment Nil immediates contracts) assembly of
              Err message -> Err message
              Ok next -> checked-prim-bodies owner pure rest rest-uses arity result ptr-sized llvm next reason)
            else Err (string-concat "unsupported inline primitive family " family)))
  primitive-layout :: Scheme -> Result String (List ForeignParameter, ForeignParameter)
  primitive-layout scheme =
    if not (contract-scheme-closed scheme) || list-length (scheme-params scheme) /= 0 || list-length (scheme-requirements scheme) /= 0 then
      Err "a prim declaration needs a monomorphic checked signature"
    else primitive-parameters (scheme-body scheme) Nil
  -- | Check a declared primitive body against its validated layout and containment rules.
  primitive-plan :: String -> Scheme -> List PrimBody -> List (List (String, Scheme)) -> (Nat -> RewriteJustification -> Result String String) -> Result String ForeignPlan
  primitive-plan name scheme bodies body-uses check-law =
    case (export-global name, primitive-layout scheme) of
      (Ok symbol, Ok (arguments, result)) -> let arity = list-length arguments in
        let pure = pure-primitive-arrows (scheme-body scheme) in
        let ptr-sized = case result.parameter-type of UCon rname KType -> has rname ["Usize", "Isize"]; other -> False in
        (case (checked-prim-bodies symbol pure bodies body-uses arity (foreign-llvm-type result) ptr-sized (FamilyCandidates None None) (FamilyCandidates None None) Nil,
               primitive-laws (check-law arity) bodies True Nil) of
          (Ok (body, condition), Ok (justified, laws)) ->
            let trust = primitive-trust symbol bodies in
            let family = case body of InlinePrimitive owner chosen immediates llvm assembly -> chosen in
            (case primitive-contract symbol scheme bodies justified laws of
              Err message -> Err message
              Ok identity -> let assumed = if justified then None else Some identity in
                let declared = if justified then laws <> trust else trust in
                Ok (ForeignPlan (string-concat-all [symbol, ".", family]) scheme arguments result
                  (Some (body, assumed, declared, selection-document body condition identity justified trust bodies))))
          (Err message, other) -> Err message
          (other, Err message) -> Err message)
      (Err message, other) -> Err message
      (other, Err message) -> Err message

  primitive-laws :: (RewriteJustification -> Result String String) -> List PrimBody -> Bool -> List String -> Result String (Bool, List String)
  primitive-laws check-law bodies justified laws = case bodies of
    Nil -> Ok (justified, reverse laws)
    Cons (PrimBody sp family fragment unverified clauses projected evidence uses immediates) rest -> case evidence of
      None -> primitive-laws check-law rest False laws
      Some citation -> (case check-law citation of
        Err message -> Err message
        Ok identity -> primitive-laws check-law rest justified (if has identity laws then laws else Cons identity laws))

  primitive-contract :: String -> Scheme -> List PrimBody -> Bool -> List String -> Result String String
  primitive-contract symbol scheme bodies justified laws = if justified then (case export-display-scheme scheme of
    Ok signature-text -> Ok (string-concat-all ["prim:", symbol, ":", signature-text, ":laws[", strings "," laws, "]"])
    Err message -> Err message) else Ok (primitive-identity symbol (primitive-body-text bodies))

  -- Keep target selection in the artifact manifest. Interface assumptions
  -- continue to use the target-independent identities of all checked bodies.
  selection-document :: InlinePrimitive -> Option String -> String -> Bool -> List String -> List PrimBody -> Json
  selection-document body condition identity justified trust bodies = case body of
    InlinePrimitive owner family immediates llvm assembly ->
      let why = case condition of
            None -> string-concat-all ["the baseline `", family, "` body (the fallback when no `when` condition matches)"]
            Some clause -> string-concat-all ["the `", family, "` body's `when ", clause, "` condition holds in the target profile"] in
      JObj "family" (JStr family) (JObj "condition" (case condition of None -> JNull; Some clause -> JStr clause)
        (JObj "identity" (JStr identity) (JObj "tier" (JStr (if justified then "justified" else "assumed")) (JObj "why" (JStr why)
          (JObj "trust" (trust-document bodies trust) (JObj "immarg" (immediate-document immediates)
            (JObj "uses" JArrEnd (JObj "validation" (validation-document bodies) JObjEnd))))))))
  trust-document :: List PrimBody -> List String -> Json
  trust-document bodies identities = case bodies of
    Nil -> JArrEnd
    Cons (PrimBody site family fragment unverified clauses projected justification uses immediates) rest ->
      if unverified then (case identities of
        Cons identity more -> JArr (JStr (string-concat-all [family, ": declared under `unsafe`, trusted not verified (", identity, ")"])) (trust-document rest more)
        Nil -> JArrEnd)
      else trust-document rest identities
  immediate-document :: List Nat -> Json
  immediate-document positions = case positions of Nil -> JArrEnd; Cons i rest -> JArr (JNum (nat-to-int i)) (immediate-document rest)
  validation-document :: List PrimBody -> Json
  validation-document bodies = case bodies of
    Nil -> JArrEnd
    Cons (PrimBody sp family fragment unverified when selected justification uses immediates) rest ->
      let detail = if same family "llvm" then "llvm: containment validated: checked return, permitted instructions and calls"
            else "asm: containment validated structurally for escaping instructions" in
      JArr (JStr detail) (validation-document rest)
  strings :: String -> List String -> String
  strings delimiter values = case values of Nil -> ""; Cons first Nil -> first; Cons first rest -> string-concat-all [first, delimiter, strings delimiter rest]
  visible-regions :: List Quant -> List (Nat, UType)
  visible-regions qs = case qs of Nil -> Nil; Cons q rest -> Cons (q.id, UCon (q.name) KRegion) (visible-regions rest)
  append :: Result String String -> String -> Result String String -> Result String String
  append first delimiter second = case (first, second) of
    (Ok a, Ok b) -> Ok (string-concat-all [a, delimiter, b])
    (Err error, other) -> Err error
    (other, Err error) -> Err error
  surround :: Result String String -> Result String String
  surround result = case result of Ok value -> Ok (string-concat-all ["(", value, ")"]); Err error -> Err error
  boundary-type-text :: UType -> Result String String
  boundary-type-text ty = case ty of
    UApp head arg -> if foreign-pointer ty then append (boundary-type-text head) " " (if foreign-pointer arg then surround (boundary-type-text arg) else boundary-type-text arg)
      else append (boundary-type-text head) " " (case arg of UApp f x -> surround (boundary-type-text arg); other -> boundary-type-text arg)
    UFun domain result -> surround (append (boundary-type-text domain) " -> " (boundary-type-text result))
    UFunEff domain row result -> case labels-text row of
      Err error -> Err error
      Ok labels -> let effects = case labels of Nil -> ""; other -> string-concat-all ["{", strings ", " labels, "}"] in
        surround (append (boundary-type-text domain) (string-concat-all [" ->", effects, " "]) (boundary-type-text result))
    other -> export-type ty
  display-body :: ForeignPlan -> Result String String
  display-body plan = let scheme = plan.scheme in boundary-type-text (substitute-bound (visible-regions (scheme-params scheme)) (scheme-body scheme))
  region-names :: List Quant -> List String
  region-names qs = case qs of Nil -> Nil; Cons q rest -> Cons (q.name) (region-names rest)
  foreign-display-scheme :: ForeignPlan -> Result String String
  foreign-display-scheme plan = case display-body plan of
    Err error -> Err error
    Ok body -> let qs = scheme-params (plan.scheme) in Ok (string-concat (case qs of Nil -> ""; other -> string-concat-all ["forall ", strings " " (region-names qs), " . "]) body)
  parameter-document :: ForeignParameter -> Result String Json
  parameter-document item = case item of
    ForeignParameter ty category role width align signed nullable -> case boundary-type-text ty of
      Err error -> Err error
      Ok spelling -> Ok (JObj "type" (JStr spelling) (JObj "class" (JStr category) (JObj "role" (JStr role)
        (JObj "allocator" (JStr "") (JObj "nullable" (JBool nullable) (JObj "width" (JNum (nat-to-int width))
          (JObj "align" (JNum (nat-to-int align)) (JObj "signed" (JBool signed) (JObj "offsets" JArrEnd JObjEnd)))))))))
  parameter-documents :: List ForeignParameter -> Result String Json
  parameter-documents params = case params of
    Nil -> Ok JArrEnd
    Cons first rest -> case (parameter-document first, parameter-documents rest) of
      (Ok row, Ok more) -> Ok (JArr row more)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
  label-text :: UType -> Result String String
  label-text ty = case ty of
    UApp (UCon name kind) arg -> case export-type arg of Ok value -> Ok (string-concat-all [name, " ", value]); Err error -> Err error
    UCon name KEffect -> Ok (if same name "#kernel.ForeignIO" then "IO" else name)
    other -> Err "invalid checked foreign effect label"
  effect-text :: UType -> Result String (List String)
  effect-text ty = case ty of
    UFun domain result -> effect-text result
    UFunEff domain row result -> case (labels-text row, effect-text result) of
      (Ok first, Ok rest) -> Ok (first <> rest)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
    UPi id name domain row result -> case (labels-text row, effect-text result) of
      (Ok first, Ok rest) -> Ok (first <> rest)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
    other -> Ok Nil
  labels-text :: UType -> Result String (List String)
  labels-text row = case row of
    URow labels -> labels-text labels
    UEnd -> Ok Nil
    UArg label rest -> case (label-text label, labels-text rest) of
      (Ok value, Ok more) -> Ok (Cons value more)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
    other -> Err "foreign effect row must be closed"
  foreign-document :: String -> ForeignPlan -> Result String Json
  foreign-document local plan = let scheme = plan.scheme in
    case (display-body plan, parameter-documents (plan.parameters), parameter-document (plan.result), effect-text (substitute-bound (visible-regions (scheme-params scheme)) (scheme-body scheme))) of
      (Ok spelling, Ok params, Ok result, Ok effects) -> Ok (JObj "symbol" (JStr local) (JObj "abi" (JStr "ccall")
        (JObj "external" (JStr (plan.symbol)) (JObj "type" (JStr spelling) (JObj "effects" (JStr (strings ", " effects))
          (JObj "notes" (JStr "foreign import") (JObj "kind" (JStr "import") (JObj "params" params (JObj "result" result (JObj "deallocator" (JStr "") JObjEnd))))))))))
      (Err error, other, more, end) -> Err error
      (other, Err error, more, end) -> Err error
      (other, more, Err error, end) -> Err error
      (other, more, end, Err error) -> Err error
