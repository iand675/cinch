-- C boundary plans are built from checked types. A source name or a display
-- string never supplies a calling convention, ownership fact or total body.
module Cinch.Foreign where
  import Cinch.Type
  import Cinch.Target (condition-render, primitive-target, when-vocabulary, host-profile)
  import Cinch.Ast (PrimBody, PrimTarget, UnprojectedPrimitive, ApplicablePrimitive, InapplicablePrimitive, RewriteJustification, RewriteTerm, Expr, EVar, source-identity-expr)
  import Cinch.PrimVerify (TrustReceipt, receipts-to-json, receipt-goal-hash, receipt-prover-id, receipt-evidence-payload, PrimProofFact, MkPrimProofFact, VerifyOutcome, OutcomeVerified, OutcomeAssumed, OutcomeDisproved, OutcomeRejected, OutcomeOpen, PrimParamSpec, MkPrimParamSpec, SpecDef, verify-prim-body-cached, verify-prim-cross-target, is-verify-justification-word, worst-trust-tier, receipts-tcb-union)
  import Cinch.Core (contract-scheme-closed)
  import Cinch.ExportType (export-type, export-global, export-display-scheme)
  import Cinch.Interface (fnv-source-hash)
  import Cinch.Document
  import Data.Nat (nat-to-int)
  import Data.Char (is-ascii-alpha-numeric, is-ascii-digit)
  import Category.Foldable (all)
  import Text.Show (nat-to-string)
  import Text.Scan (string-contains, string-split-on, string-starts-with, string-ends-with, string-strip, string-words, string-unwords)
  import Algebra.Semigroup

  export ForeignPlan, ForeignParameter, foreign-plan, foreign-export-plan, foreign-plan-with-values, foreign-export-plan-with-values
  export foreign-blocking
  export foreign-pointer, foreign-document, foreign-display-scheme
  export InlinePrimitive, primitive-plan, foreign-inline, foreign-primitive-assumptions
  export primitive-object-callable, foreign-primitive-selection, foreign-primitive-total-op, foreign-primitive-proof, foreign-primitive-cache-entries
  export PrimitiveFragment
  export PrimUseContract
  export foreign-llvm-type, primitive-layout

  record ForeignParameter where
    parameter-type :: UType
    class :: String
    role :: String
    width :: Nat
    align :: Nat
    signed :: Bool
    nullable :: Bool
  record PrimUseContract where
    use-symbol :: String
    use-params :: List ForeignParameter
    use-result :: ForeignParameter
  record PrimitiveFragment where
    text :: String
    symbols :: List String
    immediates :: List Nat
    contracts :: List PrimUseContract
  record FamilyCandidates where
    fallback :: Option PrimitiveFragment
    matched :: Option (String, PrimitiveFragment)
  record InlinePrimitive where
    owner :: String
    chosen :: String
    immediates :: List Nat
    llvm :: Option PrimitiveFragment
    assembly :: Option PrimitiveFragment
  record ForeignPlan where
    symbol :: String
    scheme :: Scheme
    parameters :: List ForeignParameter
    result :: ForeignParameter
    inline :: Option (InlinePrimitive, Option String, List String, Json, Option PrimProofFact, List TrustReceipt)
  foreign-inline :: ForeignPlan -> Option InlinePrimitive
  foreign-inline plan = case plan of ForeignPlan symbol scheme params result inline -> (case inline of Some (body, identity, trust, selection, proof-fact, receipts) -> Some body; None -> None)
  -- A public worker receives ordinary arguments. Immediate-only operands
  -- must still be checked at a direct call with their actual literal values.
  primitive-object-callable :: ForeignPlan -> Bool
  primitive-object-callable plan = case foreign-inline plan of
    Some (InlinePrimitive owner family [] llvm assembly) -> pure-primitive-arrows (scheme-body (plan.scheme))
    other -> False
  pure-primitive-arrows :: UType -> Bool
  pure-primitive-arrows ty = case refinement-view ty of
    UFun domain result -> pure-primitive-arrows result
    UPi id name domain (URow UEnd) result -> pure-primitive-arrows result
    URefine id name base pred -> pure-primitive-arrows base
    UCon name KType -> True
    other -> False
  foreign-primitive-assumptions :: ForeignPlan -> Option (Option String, List String)
  foreign-primitive-assumptions plan = case plan of
    ForeignPlan symbol scheme params result inline ->
      (case inline of Some (body, identity, trust, selection, proof-fact, receipts) -> Some (identity, trust); None -> None)
  foreign-primitive-selection :: ForeignPlan -> Option Json
  foreign-primitive-selection plan = case plan of
    ForeignPlan symbol scheme params result (Some (body, identity, trust, selection, proof-fact, receipts)) -> Some selection
    other -> None
  foreign-primitive-proof :: ForeignPlan -> Option PrimProofFact
  foreign-primitive-proof plan = case plan of
    ForeignPlan symbol scheme params result (Some (body, identity, trust, selection, proof-fact, receipts)) -> proof-fact
    other -> None
  extract-cache-entries :: List TrustReceipt -> List (String, String, String)
  extract-cache-entries rs = case rs of
    [] -> []
    r : rest ->
      let p = receipt-evidence-payload r in
      if string-length p > 0 then (receipt-goal-hash r, receipt-prover-id r, p) : (extract-cache-entries rest)
      else extract-cache-entries rest
  foreign-primitive-cache-entries :: ForeignPlan -> List (String, String, String)
  foreign-primitive-cache-entries plan = case plan of
    ForeignPlan symbol scheme params result (Some (body, identity, trust, selection, proof-fact, receipts)) -> extract-cache-entries receipts
    other -> []
  nonempty-ir-lines :: List String -> List (List String)
  nonempty-ir-lines lines = case lines of
    [] -> []
    line : rest -> let words = ir-line-words line in
      case words of
        [] -> nonempty-ir-lines rest
        first : more -> words : (nonempty-ir-lines rest)
  i64-cmp-total-name :: String -> Option String
  i64-cmp-total-name pred =
    case pred of
    "eq" -> Some "I64Eq"
    "ne" -> Some "I64Ne"
    "slt" -> Some "I64Lt"
    "sle" -> Some "I64Le"
    "sgt" -> Some "I64Gt"
    "sge" -> Some "I64Ge"
    _ -> None
  foreign-primitive-total-op :: ForeignPlan -> Option (String, List String, String)
  foreign-primitive-total-op plan = case foreign-inline plan of
    Some (InlinePrimitive owner family [] (Some (PrimitiveFragment fragment symbols immarg uses)) assembly) ->
      (case nonempty-ir-lines (string-split-on "\n" fragment) of
        [[c, op1, pred, ty1, a0, a1], [r, op2, ty2, c2, kw, ty3], [op3, ty4, r2]] ->
          if op1 == "icmp" && ty1 == "i64" && a0 == "%0" && a1 == "%1"
              && op2 == "zext" && ty2 == "i1" && c == c2 && kw == "to" && ty3 == "i8"
              && op3 == "ret" && ty4 == "i8" && r == r2 then
            (case i64-cmp-total-name pred of
              Some total-op -> Some (total-op, ["I64", "I64"], "Bool")
              None -> None)
          else None
        other -> None)
    other -> None
  foreign-llvm-type :: ForeignParameter -> String
  foreign-llvm-type parameter =
    if parameter.class == "unit" then "void"
    else if parameter.class == "ptr" then "ptr"
    else case parameter.parameter-type of
      UCon name KType -> if name == "F32" then "float" else if name == "F64" then "double"
        else string-concat "i" (nat-to-string (parameter.width * 8))
      other -> string-concat "i" (nat-to-string (parameter.width * 8))
  has :: String -> List String -> Bool
  has name names = case names of [] -> False; first : rest -> name == first || has name rest
  -- Pointer and scalar sizes follow the target profile's pointer/word width
  -- (32-bit -> 4 bytes on wasm32/32-bit targets; 64-bit -> 8 bytes on 64-bit targets).
  ptr-byte-width :: Nat -> Nat
  ptr-byte-width word-bits = if word-bits == 32 then 4 else 8
  scalar-for :: Nat -> String -> Option (Nat, Bool)
  scalar-for word-bits name = if has name ["I8", "U8"] then Some (1, name == "I8")
    else if has name ["I16", "U16"] then Some (2, name == "I16")
    else if has name ["I32", "U32", "F32"] then Some (4, name == "I32")
    else if has name ["Isize", "Usize"] then Some (ptr-byte-width word-bits, name == "Isize")
    else if has name ["I64", "U64", "F64"] then Some (8, name == "I64")
    -- C's `__int128`: LLVM `i128` (design/wide-scalars.md section 7).
    else if has name ["I128", "U128"] then Some (16, name == "I128")
    else None
  scalar :: String -> Option (Nat, Bool)
  scalar name = scalar-for 64 name
  head-name :: UType -> Option String
  head-name ty = case ty of UCon name kind -> Some name; UApp head argument -> head-name head; other -> None
  lookup-aggregate :: String -> List (String, Nat, Nat) -> Option (Nat, Nat)
  lookup-aggregate name entries = case entries of
    [] -> None
    (n, sz, al) : rest -> if n == name then Some (sz, al) else lookup-aggregate name rest
  parameter-for :: Nat -> List String -> List (String, Nat, Nat) -> UType -> Result String ForeignParameter
  parameter-for word-bits abstracts aggregates ty =
    let pb = ptr-byte-width word-bits in
    if not (valid-type ty && kind-equal (type-kind ty) KType) then Err "foreign boundary needs a closed proper carrier" else case ty of
      UCon name KType -> if name == "Unit" then Ok (ForeignParameter ty "unit" "value" 0 1 False False)
        else (case scalar-for word-bits name of
          Some (width, signed) -> Ok (ForeignParameter ty "scalar" "value" width width signed False)
          None -> (case lookup-aggregate name aggregates of
            Some (sz, al) -> Ok (ForeignParameter ty "aggregate" "value" sz al False False)
            None -> if not (has name ["Int", "Nat", "Bool", "Bytes", "String", "Char", "Sym"]) && has name abstracts then Ok (ForeignParameter ty "ptr" "opaque-handle" pb pb False False) else Err (string-concat name " has no C representation at the foreign boundary")))
      UApp (UCon name kind) pointee -> if foreign-pointer ty then
          Ok (ForeignParameter ty "ptr" (if name == "RawPtr" then "raw" else if name == "Borrowed" then "borrowed" else "maybe-null") pb pb False (name == "MaybeNull"))
        else if has name ["Owned", "Retained", "Out"] then Err "foreign ownership, retention and out-cell protocols require their checked resource plans"
        else (case head-name ty of Some owner -> if has owner abstracts then Ok (ForeignParameter ty "ptr" "opaque-handle" pb pb False False) else Err "aggregate or higher-order type has no supported C representation"; None -> Err "foreign carrier is not a recorded C representation")
      other -> Err "refined, polymorphic, proof and function values cannot be assumed to have a C representation"
  region-quantifiers :: List Quant -> Bool
  region-quantifiers qs = case qs of [] -> True; q : rest -> kind-equal (q.kind) KRegion && region-quantifiers rest
  closed-labels :: UType -> Bool
  closed-labels labels = case labels of UEnd -> True; UArg label rest -> kind-equal (type-kind label) KEffect && valid-type label && closed-labels rest; other -> False
  closed-row :: UType -> Bool
  closed-row row = case row of URow labels -> closed-labels labels; other -> False
  accounted-labels :: UType -> Bool
  accounted-labels labels = case labels of
    UArg label rest -> (case head-name label of Some name -> has name ["Foreign", "IO", "#kernel.ForeignIO", "Global", "Blocking", "Diverge", "Fail", "Reentrant", "ThreadAffine"]; None -> False) || accounted-labels rest
    other -> False
  -- Only the kernel Blocking label on a checked call arrow enters the scheduler.
  blocking-labels :: UType -> Bool
  blocking-labels labels = case labels of
    UArg (UCon name KEffect) rest -> name == "Blocking" || blocking-labels rest
    UArg other rest -> blocking-labels rest
    other -> False
  blocking-arrow :: UType -> Bool
  blocking-arrow ty = case ty of
    UFun domain result -> blocking-arrow result
    UFunEff domain (URow labels) result -> blocking-labels labels || blocking-arrow result
    UPi id name domain (URow labels) result -> blocking-labels labels || blocking-arrow result
    other -> False
  foreign-blocking :: ForeignPlan -> Bool
  foreign-blocking plan = blocking-arrow (scheme-body (plan.scheme))
  envelope-error :: Bool -> UType -> Option String
  envelope-error importing ty = case ty of
    UFun domain result -> arrow-envelope-error importing (URow UEnd) result
    UFunEff domain row result -> arrow-envelope-error importing row result
    UPi id name domain row result -> arrow-envelope-error importing row result
    other -> Some "foreign import needs a function type"
  arrow-envelope-error :: Bool -> UType -> UType -> Option String
  arrow-envelope-error importing row result = case row of
    URow labels -> case result of
      UFun domain more -> if closed-row row then envelope-error importing result else Some "foreign effect rows must be closed and explicit"
      UFunEff domain effects more -> if closed-row row then envelope-error importing result else Some "foreign effect rows must be closed and explicit"
      UPi id name domain effects more -> if closed-row row then envelope-error importing result else Some "foreign effect rows must be closed and explicit"
      other -> if importing && not (accounted-labels labels) then Some "foreign import needs a function type, closed explicit rows and accounted result effects: a foreign import must declare its effects because an external function is not pure"
        else if closed-row row then None else Some "foreign effect rows must be closed and explicit"
    other -> Some "foreign effect rows must be closed and explicit"
  parameters-for :: Nat -> List String -> List (String, Nat, Nat) -> UType -> List ForeignParameter -> Result String (List ForeignParameter, ForeignParameter)
  parameters-for word-bits abstracts aggregates ty backwards = case ty of
    UFun domain result -> add-parameter-for word-bits abstracts aggregates domain result backwards
    UFunEff domain row result -> add-parameter-for word-bits abstracts aggregates domain result backwards
    UPi id name domain row result -> add-parameter-for word-bits abstracts aggregates domain result backwards
    other -> case parameter-for word-bits abstracts aggregates ty of Err error -> Err error; Ok result -> Ok (reverse backwards, result)
  add-parameter-for :: Nat -> List String -> List (String, Nat, Nat) -> UType -> UType -> List ForeignParameter -> Result String (List ForeignParameter, ForeignParameter)
  add-parameter-for word-bits abstracts aggregates domain result backwards = case parameter-for word-bits abstracts aggregates domain of
    Err error -> Err error
    Ok argument -> parameters-for word-bits abstracts aggregates result (argument : backwards)
  -- The intrinsic namespaces are reserved: a symbol there without a checked
  -- runtime contract names a retired or unknown intrinsic, never C. Any
  -- other nonempty symbol is a C object name, quoted as an LLVM global.
  reserved-symbol :: String -> Bool
  reserved-symbol name = string-starts-with "cinch.prim." name || string-starts-with "cinch.runtime." name
  foreign-plan :: Nat -> List String -> String -> Scheme -> Result String ForeignPlan
  foreign-plan word-bits abstracts symbol scheme = checked-foreign-plan-for True word-bits abstracts [] False False symbol scheme
  foreign-export-plan :: Nat -> List String -> String -> Scheme -> Result String ForeignPlan
  foreign-export-plan word-bits abstracts symbol scheme = checked-foreign-plan-for False word-bits abstracts [] False False symbol scheme
  foreign-plan-with-values :: Nat -> List String -> List (String, Nat, Nat) -> Bool -> Bool -> String -> Scheme -> Result String ForeignPlan
  foreign-plan-with-values = checked-foreign-plan-for True
  foreign-export-plan-with-values :: Nat -> List String -> List (String, Nat, Nat) -> Bool -> Bool -> String -> Scheme -> Result String ForeignPlan
  foreign-export-plan-with-values = checked-foreign-plan-for False

  checked-foreign-plan-for :: Bool -> Nat -> List String -> List (String, Nat, Nat) -> Bool -> Bool -> String -> Scheme -> Result String ForeignPlan
  checked-foreign-plan-for importing word-bits abstracts aggregates has-byval has-sret symbol scheme = if word-bits /= 32 && word-bits /= 64 then Err "foreign boundary target ABI is not supported"
    else if reserved-symbol symbol then Err (string-concat-all ["foreign symbol ", symbol, " is not a cinch intrinsic; only cinch.prim.* and cinch.runtime.* intrinsics are supported in the bootstrap slice"])
    else if string-length symbol == 0 then Err "foreign symbol is empty"
    else if not importing && (string-starts-with "llvm." symbol || string-starts-with "cinch." symbol || string-starts-with "cinch_" symbol) then Err "reserved foreign export symbol"
    else case envelope-error importing (scheme-body scheme) of
      Some error -> Err error
      None -> if not (contract-scheme-closed scheme) then Err "foreign scheme has an unbound or unresolved contract"
        else if not (region-quantifiers (scheme-params scheme)) || list-length (scheme-requirements scheme) /= 0 then Err "foreign binding cannot be polymorphic or constrained"
        else case parameters-for word-bits abstracts aggregates (scheme-body scheme) [] of
          Err error -> Err error
          Ok (arguments, result) ->
            if result.class == "aggregate" && not has-sret then
              Err "a foreign result cannot be an aggregate without `#[sret]`"
            else Ok (ForeignPlan symbol scheme arguments result None)
  primitive-carrier-for :: Nat -> UType -> Result String ForeignParameter
  primitive-carrier-for word-bits ty =
    let pb = ptr-byte-width word-bits in
    case refinement-view ty of
      URefine id name base pred -> primitive-carrier-for word-bits base
      UApp (UCon name kind) pointee | foreign-pointer ty ->
        Ok (ForeignParameter ty "ptr" (if name == "RawPtr" then "raw" else if name == "Borrowed" then "borrowed" else "maybe-null") pb pb False (name == "MaybeNull"))
      UCon name KType -> if name == "Bool" then Ok (ForeignParameter ty "scalar" "value" 1 1 False False)
        else if name == "Char" then Ok (ForeignParameter ty "scalar" "value" 4 4 False False)
        else (case scalar-for word-bits name of
          Some (width, signed) -> Ok (ForeignParameter ty "scalar" "value" width width signed False)
          None -> Err "a prim needs a first-order machine scalar or pointer carrier")
      other -> Err "a prim needs a first-order machine scalar or pointer carrier"
  primitive-use-result-for :: Nat -> UType -> Result String ForeignParameter
  primitive-use-result-for word-bits ty = case refinement-view ty of
    URefine id name base pred -> primitive-use-result-for word-bits base
    UCon name KType | (name == "Unit") -> Ok (ForeignParameter ty "unit" "value" 0 1 False False)
    other -> primitive-carrier-for word-bits ty
  primitive-use-parameters-for :: Nat -> UType -> List ForeignParameter -> Result String (List ForeignParameter, ForeignParameter)
  primitive-use-parameters-for word-bits ty backwards = case ty of
    UFun domain rest -> case primitive-carrier-for word-bits domain of
      Ok argument -> primitive-use-parameters-for word-bits rest (argument : backwards)
      Err error -> Err error
    UFunEff domain row rest -> if closed-row row then (case primitive-carrier-for word-bits domain of
        Ok argument -> primitive-use-parameters-for word-bits rest (argument : backwards)
        Err error -> Err error)
      else Err "a uses entry needs closed explicit effect rows"
    UPi id name domain row rest -> if closed-row row then (case primitive-carrier-for word-bits domain of
        Ok argument -> primitive-use-parameters-for word-bits rest (argument : backwards)
        Err error -> Err error)
      else Err "a uses entry needs closed explicit effect rows"
    other -> case primitive-use-result-for word-bits ty of
      Ok result -> Ok (reverse backwards, result)
      Err error -> Err error
  check-prim-use-contract-for :: Nat -> (String, Scheme) -> Result String PrimUseContract
  check-prim-use-contract-for word-bits entry = case entry of
    (sym, scheme) ->
      if reserved-symbol sym then Err (string-concat-all ["the intrinsic namespaces are reserved: uses must not name ", sym])
      else if string-length sym == 0 then Err "a uses entry needs a non-empty symbol name"
      else if not (contract-scheme-closed scheme) || list-length (scheme-requirements scheme) /= 0 || not (prim-allowed-quants (scheme-params scheme)) then
        Err "a uses entry needs a monomorphic or pointer-polymorphic unconstrained machine ABI"
      else case primitive-use-parameters-for word-bits (scheme-body scheme) [] of
        Err error -> Err error
        Ok (params, result) -> Ok (PrimUseContract sym params result)
  check-prim-uses-for :: Nat -> List (String, Scheme) -> Result String (List PrimUseContract)
  check-prim-uses-for word-bits entries = case entries of
    [] -> Ok []
    entry : rest -> case check-prim-use-contract-for word-bits entry of
      Err error -> Err error
      Ok entry-contract -> case check-prim-uses-for word-bits rest of
        Err error -> Err error
        Ok more -> Ok (entry-contract : more)
  prim-use-symbols :: List PrimUseContract -> List String
  prim-use-symbols contracts = case contracts of
    [] -> []
    c : rest -> (string-concat "@" (c.use-symbol)) : (prim-use-symbols rest)
  primitive-parameters-for :: Nat -> UType -> List ForeignParameter -> Result String (List ForeignParameter, ForeignParameter)
  primitive-parameters-for word-bits ty backwards = case ty of
    UFun domain rest -> primitive-domain-for word-bits domain rest backwards
    UFunEff domain row rest -> if closed-row row then primitive-domain-for word-bits domain rest backwards
      else Err "a prim needs closed explicit effect rows"
    UPi id name domain row rest -> if closed-row row then primitive-domain-for word-bits domain rest backwards
      else Err "a prim needs closed explicit effect rows"
    other -> (case (backwards, primitive-use-result-for word-bits ty) of
      ([], result) -> Err "a prim declaration needs a function type"
      (arguments, Ok result) -> Ok (reverse arguments, result)
      (arguments, Err message) -> Err message)
  primitive-domain-for :: Nat -> UType -> UType -> List ForeignParameter -> Result String (List ForeignParameter, ForeignParameter)
  primitive-domain-for word-bits domain rest backwards = case primitive-carrier-for word-bits domain of
    Ok argument -> primitive-parameters-for word-bits rest (argument : backwards)
    Err error -> Err error
  prim-allowed-quants :: List Quant -> Bool
  prim-allowed-quants qs = case qs of
    [] -> True
    q : rest -> (kind-equal (q.kind) KType || kind-equal (q.kind) KRegion) && prim-allowed-quants rest
  immediate-indices-valid :: Nat -> List Nat -> List Nat -> Bool
  immediate-indices-valid arity indices seen = case indices of
    [] -> True
    first : rest -> first < arity && not (has-index first seen) && immediate-indices-valid arity rest (first : seen)
  has-index :: Nat -> List Nat -> Bool
  has-index value values = case values of [] -> False; first : rest -> value == first || has-index value rest
  allowed-intrinsic :: String -> Bool
  allowed-intrinsic symbol =
    string-starts-with "@llvm.bswap." symbol
      || string-starts-with "@llvm.ctpop." symbol
      || string-starts-with "@llvm.ctlz." symbol
      || string-starts-with "@llvm.cttz." symbol
      || string-starts-with "@llvm.bitreverse." symbol
      || string-starts-with "@llvm.fshl." symbol
      || string-starts-with "@llvm.fshr." symbol
      || string-starts-with "@llvm.smin." symbol
      || string-starts-with "@llvm.smax." symbol
      || string-starts-with "@llvm.umin." symbol
      || string-starts-with "@llvm.umax." symbol
      || string-starts-with "@llvm.fabs." symbol
      || string-starts-with "@llvm.sqrt." symbol
      || string-starts-with "@llvm.sin." symbol
      || string-starts-with "@llvm.cos." symbol
      || string-starts-with "@llvm.exp." symbol
      || string-starts-with "@llvm.log." symbol
      || string-starts-with "@llvm.floor." symbol
      || string-starts-with "@llvm.ceil." symbol
      || string-starts-with "@llvm.trunc." symbol
      || string-starts-with "@llvm.round." symbol
      || string-starts-with "@llvm.roundeven." symbol
      || string-starts-with "@llvm.copysign." symbol
      || string-starts-with "@llvm.sadd.sat." symbol
      || string-starts-with "@llvm.uadd.sat." symbol
      || string-starts-with "@llvm.ssub.sat." symbol
      || string-starts-with "@llvm.usub.sat." symbol
      || string-starts-with "@llvm.sadd.with.overflow." symbol
      || string-starts-with "@llvm.uadd.with.overflow." symbol
      || string-starts-with "@llvm.ssub.with.overflow." symbol
      || string-starts-with "@llvm.usub.with.overflow." symbol
      || string-starts-with "@llvm.smul.with.overflow." symbol
      || string-starts-with "@llvm.umul.with.overflow." symbol
      || symbol == "@llvm.vector.reduce.add.v16i32"
  ir-line-words :: String -> List String
  ir-line-words line = case string-split-on ";" line of
    [] -> []
    code : rest -> string-words (pack (ir-token-chars (unpack code)))
  ir-token-chars :: List Char -> List Char
  ir-token-chars chars = case chars of
    [] -> []
    first : rest -> let code = char-code first in
      (if code == 40 || code == 41 || code == 44 || code == 61 then ' ' else first) : (ir-token-chars rest)
  ir-symbols :: List String -> List String
  ir-symbols words = case words of
    [] -> []
    word : rest -> if string-starts-with "@" word then word : (ir-symbols rest) else ir-symbols rest
  ir-no-unsafe-punctuation :: String -> Bool
  ir-no-unsafe-punctuation line =
    not (string-contains "\"" line || string-contains "!" line || string-contains "\\" line || string-contains ":" line
      || string-contains "#" line)
  ir-has-word :: List String -> List String -> Bool
  ir-has-word forbidden words = case words of
    [] -> False
    word : rest -> has word forbidden || ir-has-word forbidden rest
  ir-instruction :: List String -> List String
  ir-instruction words = case words of
    first : rest -> if string-starts-with "%" first then rest else words
    [] -> []
  -- The trusted subset of embedded assembly operates on registers. The
  -- instruction template, constraints and LLVM operands have separate grammars.
  -- LLVM verifies the operand counts and register types when assembling the IR.
  register-asm-call :: String -> Bool
  register-asm-call line = case string-split-on "\"" line of
    [prefix, template, comma, constraints, suffix] ->
      string-strip comma == "," && register-asm-prefix prefix && register-template template
        && all register-constraint (string-split-on "," constraints) && register-call-arguments (string-strip suffix)
    other -> False

  machine-integer :: String -> Bool
  machine-integer ty = has ty ["i8", "i16", "i32", "i64", "i128"]

  register-asm-prefix :: String -> Bool
  register-asm-prefix prefix = case string-words prefix of
    binding : equals : op : rest ->
      local-ir-name binding && equals == "=" && op == "call" && (case reverse rest of
        keyword : types -> keyword == "asm" && (case reverse types of
          [scalar] -> machine-integer scalar
          brace : fields -> brace == "{" && (case reverse fields of
            close : members -> close == "}" && list-length members /= 0 &&
              all machine-integer (string-words (pack (ir-token-chars (unpack (string-unwords members)))))
            [] -> False)
          [] -> False)
        [] -> False)
    other -> False

  local-ir-name :: String -> Bool
  local-ir-name name = case unpack name of
    sigil : chars -> char-code sigil == 37 && list-length chars /= 0 &&
      all (\c -> is-ascii-alpha-numeric c || char-code c == 95 || char-code c == 46) chars
    [] -> False

  decimal-digits :: String -> Bool
  decimal-digits value = string-length value /= 0 && all is-ascii-digit (unpack value)

  register-constraint :: String -> Bool
  register-constraint value = decimal-digits value ||
    has value ["r", "=r", "=&r", "{ax}", "{bx}", "{cx}", "{dx}", "={ax}", "={bx}", "={cx}", "={dx}", "~{cc}"]

  register-template :: String -> Bool
  register-template template = case string-split-on "\\0A" template of
    [instruction] -> register-instruction instruction
    [directive, instruction] -> string-strip directive == ".arch_extension crc" && register-instruction instruction
    other -> False

  register-instruction :: String -> Bool
  register-instruction instruction = case string-words instruction of
    [op] -> op == "cpuid"
    op : operands -> has op ["crc32b", "crc32w", "crc32l", "crc32q", "crc32x", "crc32cb", "crc32ch", "crc32cw", "crc32cx", "crc32h"] &&
      all register-placeholder (string-split-on "," (string-unwords operands))
    [] -> False

  register-placeholder :: String -> Bool
  register-placeholder value = let operand = string-strip value in
    if string-starts-with "${" operand && string-ends-with ":w}" operand then
      (let end = string-length operand in if 3 <= end then decimal-digits (string-slice operand 2 (end - 3)) else False)
    else string-starts-with "$" operand && decimal-digits (string-slice operand 1 (string-length operand))

  register-call-arguments :: String -> Bool
  register-call-arguments suffix = string-starts-with "(" suffix && string-ends-with ")" suffix &&
    (let end = string-length suffix in if 1 <= end then
      all register-call-argument (string-split-on "," (string-slice suffix 1 (end - 1))) else False)

  register-call-argument :: String -> Bool
  register-call-argument argument = case string-words argument of
    [ty, operand] -> machine-integer ty && (local-ir-name operand || decimal-digits operand)
    other -> False

  first-ir-return :: String -> List String -> Bool
  first-ir-return result words =
    if result == "void" then (case words of operation : ([actual]) -> operation == "ret" && actual == "void"; other -> False)
    else (case words of
      operation : actual : ([operand]) -> operation == "ret" && actual == result
      other -> False)
  -- | Helper for acyclic forward-only local LLVM labels and branches.
  valid-label-chars :: List Char -> Bool
  valid-label-chars cs = case cs of
    [] -> True
    c : rest -> (is-ascii-alpha-numeric c || char-code c == 95 || char-code c == 46) && valid-label-chars rest

  ir-label-name :: String -> Option String
  ir-label-name raw =
    let code = case string-split-on ";" raw of [] -> ""; c : _ -> string-strip c in
    if string-length code > 1 && string-ends-with ":" code && not (string-contains " " code) then
      let name = string-slice code 0 (string-length code - 1) in
      if valid-label-chars (unpack name) then Some name
      else None
    else None

  ir-remaining-labels :: List String -> List String
  ir-remaining-labels ls = case ls of
    [] -> []
    l : rest -> case ir-label-name l of
      Some nm -> nm : (ir-remaining-labels rest)
      None -> ir-remaining-labels rest

  ir-valid-forward-br :: List String -> List String -> Bool
  ir-valid-forward-br words future-labels = case words of
    ["br", "label", dst] ->
      string-starts-with "%" dst && string-length dst > 1 && has (string-slice dst 1 (string-length dst)) future-labels
    ["br", "i1", cond, "label", t-dst, "label", f-dst] ->
      string-starts-with "%" t-dst && string-length t-dst > 1 && has (string-slice t-dst 1 (string-length t-dst)) future-labels
        && string-starts-with "%" f-dst && string-length f-dst > 1 && has (string-slice f-dst 1 (string-length f-dst)) future-labels
    other -> False

  -- | Validate one straight-line or acyclic forward-branching LLVM fragment.
  contained-ir :: String -> Bool -> Bool -> List String -> List String -> Bool -> List String -> Result String (List String)
  contained-ir result pure trusted use-symbols lines returned symbols = case lines of
    [] -> if returned then Ok symbols else Err "containment (grammar): an LLVM fragment needs one final return"
    line : rest ->
      case ir-label-name line of
        Some lbl -> contained-ir result pure trusted use-symbols rest False symbols
        None ->
          let words = ir-line-words line in
          (case ir-instruction words of
            [] -> if list-length words == 0 then contained-ir result pure trusted use-symbols rest returned symbols
              else Err "containment (grammar): an LLVM result binding needs an instruction"
            operation : arguments ->
              if ir-has-word ["invoke", "callbr", "resume", "catchswitch", "catchpad", "cleanuppad", "cleanupret", "catchret", "landingpad"] words then
                Err "containment (no-unwind): the inline body may unwind"
              else if ir-has-word ["define", "declare"] words then Err "containment (signature discipline): a fragment declares extra parameters or results"
              else if (pure && ir-has-word ["store", "atomicrmw", "cmpxchg", "fence", "volatile"] words)
                  || (not trusted && ir-has-word ["load", "store", "atomicrmw", "cmpxchg", "fence", "volatile"] words) then
                Err "containment (determinism of effects): this LLVM memory operation has no checked buffer contract"
              else if returned then Err "containment (grammar): an instruction follows the return"
              else if operation == "call" && has "asm" arguments then
                if not trusted then Err "containment: mark an embedded assembly call unsafe to trust its effects"
                else contained-ir result pure trusted use-symbols rest False symbols
              else if not (ir-no-unsafe-punctuation line) then Err "containment (no-escape): unsupported LLVM labels, metadata or quoted operands"
              else if operation == "br" then
                if ir-valid-forward-br words (ir-remaining-labels rest) then
                  contained-ir result pure trusted use-symbols rest False symbols
                else Err "containment (no-escape): jumps, allocation, pointers and embedded assembly are forbidden"
              else if ir-has-word ["br", "switch", "indirectbr", "alloca", "unreachable", "asm", "va_arg"] words || (not trusted && ir-has-word ["getelementptr", "ptr", "inttoptr", "ptrtoint"] words) then
                Err "containment (no-escape): jumps, allocation, pointers and embedded assembly are forbidden"
              else if operation == "ret" then
                if first-ir-return result words && list-length (ir-symbols arguments) == 0 then contained-ir result pure trusted use-symbols rest True symbols
                else Err "containment (signature discipline): LLVM return disagrees with the declared result"
              else if operation == "call" && not (has "call" arguments) then (case ir-symbols arguments of
                [symbol] -> if has symbol use-symbols then
                    (if trusted then contained-ir result pure trusted use-symbols rest False symbols
                     else Err "containment: mark a call through uses unsafe to trust its declared effect row")
                  else if allowed-intrinsic symbol then contained-ir result pure trusted use-symbols rest False (if has symbol symbols then symbols else symbol : symbols)
                  else Err "containment (no-escape): the call has no checked intrinsic or uses contract"
                other -> Err "containment (no-escape): an indirect or ambiguous call is forbidden")
              else if has "call" arguments || list-length (ir-symbols arguments) /= 0 then
                Err "containment (no-escape): unchecked calls and symbols are forbidden"
              else if has operation ["add", "sub", "mul", "udiv", "sdiv", "urem", "srem", "shl", "lshr", "ashr", "and", "or", "xor",
                  "fadd", "fsub", "fmul", "fdiv", "frem", "fneg", "icmp", "fcmp", "select", "phi", "extractvalue", "insertvalue",
                  "trunc", "zext", "sext", "fptrunc", "fpext", "fptoui", "fptosi", "uitofp", "sitofp", "bitcast", "freeze",
                  "extractelement", "insertelement", "shufflevector"]
                  || (trusted && has operation ["inttoptr", "ptrtoint", "getelementptr", "load"])
                  || (trusted && not pure && has operation ["store", "atomicrmw", "cmpxchg", "fence"]) then
                contained-ir result pure trusted use-symbols rest False symbols
              else Err (string-concat "containment (grammar): unsupported LLVM instruction " operation))
  -- Unprojected declarations can also enter through a host-side checked splice.
  checked-target :: PrimTarget -> String -> List Expr -> Result String PrimTarget
  checked-target selected family clauses = case selected of
    UnprojectedPrimitive -> primitive-target family clauses host-profile
    other -> Ok selected
  condition-text :: List Expr -> String
  condition-text clauses = case condition-render clauses of Ok rendered -> rendered; Err message -> ""
  immediate-text :: List Nat -> String
  immediate-text positions = case positions of
    [] -> ""
    [position] -> nat-to-string position
    position : rest -> string-concat-all [nat-to-string position, ", ", immediate-text rest]
  immediate-list :: List Nat -> String
  immediate-list positions = string-concat-all ["[", immediate-text positions, "]"]
  primitive-identity :: String -> String -> String
  primitive-identity symbol text = string-concat-all ["prim:", symbol, "#", fnv-source-hash (string-to-bytes text)]
  -- This is the Native assumed-body encoding. The checked uses list is
  -- empty in this tier. Source order, whitespace and immarg order matter.
  primitive-body-text :: List PrimBody -> String
  primitive-body-text bodies = case bodies of
    [] -> ""
    (PrimBody sp family fragment unverified when selected justification uses immediates) : rest ->
      string-concat-all [family, "\n", condition-text when, "\n", fragment, "[]", immediate-list immediates, primitive-body-text rest]
  primitive-trust :: String -> List PrimBody -> List String
  primitive-trust symbol bodies = case bodies of
    [] -> []
    (PrimBody sp family fragment unverified when selected justification uses immediates) : rest ->
      let more = primitive-trust symbol rest in
      if unverified then (primitive-identity symbol (string-concat-all
        [family, "\n", condition-text when, "\n", fragment, "\n[]\n", immediate-list immediates])) : more else more
  contained-assembly :: String -> Bool
  contained-assembly fragment = let words = string-words (pack (ir-token-chars (unpack fragment))) in
    list-length words /= 0 && not (ir-has-word ["syscall", "svc", "int", "udf", "brk", "hlt", "ud2", "trap",
      "call", "callq", "bl", "blr", "ret", "jmp", "br"] words)
  record-candidate :: String -> List Expr -> Bool -> PrimitiveFragment -> FamilyCandidates -> Result String FamilyCandidates
  record-candidate family clauses holds fragment candidates = case candidates of
    FamilyCandidates fallback matched -> case clauses of
      [] -> (case fallback of
        Some prior -> Err (string-concat-all ["two baseline `", family, "` bodies overlap"])
        None -> Ok (FamilyCandidates (Some fragment) matched))
      other -> if not holds then Ok candidates else (case matched of
        Some prior -> Err (string-concat-all ["overlapping `when` conditions in family `", family, "`"])
        None -> Ok (FamilyCandidates fallback (Some (condition-text clauses, fragment))))

  family-body :: FamilyCandidates -> Option PrimitiveFragment
  family-body candidates = case candidates of
    FamilyCandidates fallback (Some (condition, fragment)) -> Some fragment
    FamilyCandidates fallback None -> fallback

  -- Keep a worker for each applicable family. Calls prefer a guarded body
  -- from either family before falling back to an unconditional body.
  choose-primitive :: String -> FamilyCandidates -> FamilyCandidates -> List String -> Result String (InlinePrimitive, Option String)
  choose-primitive owner llvm assembly missing =
    let finish = \family condition fragment -> case fragment of
          PrimitiveFragment text symbols immediates contracts -> Ok (InlinePrimitive owner family immediates (family-body llvm) (family-body assembly), condition) in
    case (llvm, assembly) of
      (FamilyCandidates base (Some (clause, fragment)), other) -> finish "llvm" (Some clause) fragment
      (other, FamilyCandidates base (Some (clause, fragment))) -> finish "asm" (Some clause) fragment
      (FamilyCandidates (Some fragment) None, other) -> finish "llvm" None fragment
      (other, FamilyCandidates (Some fragment) None) -> finish "asm" None fragment
      other -> Err (string-concat-all ["no body applies to the current target profile: ", strings "; " (reverse missing), ". ", when-vocabulary])

  body-word-bits-for :: Nat -> List Expr -> Nat
  body-word-bits-for default-bits when =
    let cond = condition-text when in
    if string-contains "word-size 32" cond then 32
    else if string-contains "word-size 64" cond then 64
    else default-bits

  checked-prim-bodies :: Nat -> String -> Bool -> List PrimBody -> List (List (String, Scheme)) -> Nat -> String -> Bool -> FamilyCandidates -> FamilyCandidates -> List String -> Result String (InlinePrimitive, Option String)
  checked-prim-bodies word-bits owner pure bodies body-uses arity result ptr-sized llvm assembly missing = case bodies of
    [] -> choose-primitive owner llvm assembly missing
    (PrimBody sp family fragment unverified when selected justification uses immediates) : rest ->
      let (this-uses, rest-uses) = case body-uses of [] -> ([], []); u : us -> (u, us) in
      let bbits = body-word-bits-for word-bits when in
      if not (immediate-indices-valid arity immediates []) then Err "duplicate or out-of-range immarg parameter"
      else if has family ["clr", "jvm"] then Err (string-concat family " target-IR family is reserved")
      else if family == "asm" && not unverified then Err "an assembly fragment must mark it `unsafe`"
      else if family == "asm" && not (contained-assembly fragment) then Err "containment (no-escape): the assembly has an empty or escaping fragment"
      else (case check-prim-uses-for bbits this-uses of
        Err message -> Err message
        Ok contracts -> (case checked-target selected family when of
          Err message -> Err message
          Ok matched ->
            let holds = case matched of ApplicablePrimitive -> True; other -> False in
            let reason = case matched of InapplicablePrimitive detail -> detail : missing; other -> missing in
            let body-result = if ptr-sized then (if bbits == 32 then "i32" else "i64") else result in
            if family == "llvm" then (case contained-ir body-result pure unverified (prim-use-symbols contracts) (string-split-on "\n" fragment) False [] of
              Err message -> Err message
              Ok symbols -> (case record-candidate family when holds (PrimitiveFragment fragment symbols immediates contracts) llvm of
                Err message -> Err message
                Ok next -> checked-prim-bodies word-bits owner pure rest rest-uses arity result ptr-sized next assembly reason))
            else if family == "asm" then (case record-candidate family when holds (PrimitiveFragment fragment [] immediates contracts) assembly of
              Err message -> Err message
              Ok next -> checked-prim-bodies word-bits owner pure rest rest-uses arity result ptr-sized llvm next reason)
            else Err (string-concat "unsupported inline primitive family " family)))
  primitive-layout :: Scheme -> Result String (List ForeignParameter, ForeignParameter)
  primitive-layout scheme = primitive-layout-for 64 scheme
  primitive-layout-for :: Nat -> Scheme -> Result String (List ForeignParameter, ForeignParameter)
  primitive-layout-for word-bits scheme =
    if not (contract-scheme-closed scheme) || not (prim-allowed-quants (scheme-params scheme)) || list-length (scheme-requirements scheme) /= 0 then
      Err "a prim declaration needs a monomorphic or pointer-polymorphic checked signature"
    else primitive-parameters-for word-bits (scheme-body scheme) []
  verify-justification-word :: Option RewriteJustification -> Option String
  verify-justification-word ev = case ev of
    Some (RewriteTerm (EVar sp word)) | is-verify-justification-word word -> Some word
    other -> None

  bodies-use-verify :: List PrimBody -> Bool
  bodies-use-verify bodies = case bodies of
    [] -> False
    (PrimBody sp family fragment unverified when selected justification uses immediates) : rest ->
      (case verify-justification-word justification of Some w -> True; None -> False) || bodies-use-verify rest

  local-symbol-name :: String -> String
  local-symbol-name sym = local-symbol-loop (unpack sym) []

  local-symbol-loop :: List Char -> List Char -> String
  local-symbol-loop cs acc = case cs of
    [] -> pack (reverse acc)
    c : rest -> if char-code c == 46 then local-symbol-loop rest [] else local-symbol-loop rest (c : acc)

  carrier-base-name :: UType -> String
  carrier-base-name ty = case refinement-view ty of
    URefine id nm base pred -> carrier-base-name base
    UCon name KType -> name
    other -> "I64"

  param-to-verify-spec :: String -> ForeignParameter -> PrimParamSpec
  param-to-verify-spec pname p =
    let cname = carrier-base-name (p.parameter-type) in
    let is-fp = cname == "F32" || cname == "F64" in
    let is-bool = cname == "Bool" in
    MkPrimParamSpec pname cname (p.width * 8) (p.signed) is-fp is-bool

  extract-scheme-meta :: UType -> Nat -> (List String, List UType, List (Nat, UType), Option UType)
  extract-scheme-meta ty idx = case ty of
    URequire preds rest ->
      case extract-scheme-meta rest idx of
        (names, reqs, ppreds, post) -> (names, collect-require-preds preds <> reqs, ppreds, post)
    UFun domain rest ->
      let (dpreds, dname) = domain-refinements idx domain (string-concat "arg" (nat-to-string idx)) in
      case extract-scheme-meta rest (idx + 1) of
        (names, reqs, ppreds, post) -> (dname : names, reqs, dpreds <> ppreds, post)
    UFunEff domain row rest ->
      let (dpreds, dname) = domain-refinements idx domain (string-concat "arg" (nat-to-string idx)) in
      case extract-scheme-meta rest (idx + 1) of
        (names, reqs, ppreds, post) -> (dname : names, reqs, dpreds <> ppreds, post)
    UPi id name domain row rest ->
      let pname = if string-length name > 0 then name else string-concat "arg" (nat-to-string idx) in
      let (dpreds, dname) = domain-refinements idx domain pname in
      case extract-scheme-meta rest (idx + 1) of
        (names, reqs, ppreds, post) -> (dname : names, reqs, dpreds <> ppreds, post)
    other ->
      case refinement-view ty of
        URefine id name base pred -> ([], [], [], Some pred)
        other2 -> ([], [], [], None)

  collect-require-preds :: UType -> List UType
  collect-require-preds u = case u of
    UArg p rest -> p : (collect-require-preds rest)
    UEnd -> []
    other -> [u]

  domain-refinements :: Nat -> UType -> String -> (List (Nat, UType), String)
  domain-refinements idx ty fallback = case refinement-view ty of
    URefine id name base pred ->
      let nm = if string-length name > 0 then name else fallback in
      ([(idx, pred)], nm)
    other -> ([], fallback)

  build-param-specs :: List String -> List ForeignParameter -> List PrimParamSpec
  build-param-specs names params = case (names, params) of
    (nm : nr, p : pr) -> (param-to-verify-spec nm p) : (build-param-specs nr pr)
    ([], p : pr) -> (param-to-verify-spec "arg" p) : (build-param-specs [] pr)
    other -> []

  adjust-spec-word-size :: Nat -> PrimParamSpec -> PrimParamSpec
  adjust-spec-word-size bits p = case p of
    MkPrimParamSpec nm cname w sg fp bl ->
      if cname == "Usize" || cname == "Isize" then
        MkPrimParamSpec nm cname bits sg fp bl
      else p

  adjust-specs-word-size :: Nat -> List PrimParamSpec -> List PrimParamSpec
  adjust-specs-word-size bits ps = case ps of
    [] -> []
    p : rest -> (adjust-spec-word-size bits p) : (adjust-specs-word-size bits rest)

  spec-identity-string :: Option Expr -> Option String
  spec-identity-string spec-opt = case spec-opt of
    None -> None
    Some (EVar sp fn-name) ->
      let display = case export-global fn-name of Ok g -> g; Err e -> fn-name in
      let h = fnv-source-hash (canonical-bytes (source-identity-expr (EVar sp fn-name))) in
      Some (string-concat-all [display, "#", h])
    Some expr ->
      let h = fnv-source-hash (canonical-bytes (source-identity-expr expr)) in
      Some (string-concat "inline-spec#" h)

  bodies-have-explicit-word-bits :: Nat -> List PrimBody -> Bool
  bodies-have-explicit-word-bits want bodies = case bodies of
    [] -> False
    (PrimBody sp family fragment unverified when selected justification uses immediates) : rest ->
      let other-default = if want == 32 then 64 else 32 in
      (family == "llvm" && body-word-bits-for other-default when == want) || bodies-have-explicit-word-bits want rest

  effective-fallback-word-bits :: Nat -> List PrimBody -> Nat
  effective-fallback-word-bits default-bits bodies =
    let has32 = bodies-have-explicit-word-bits 32 bodies in
    let has64 = bodies-have-explicit-word-bits 64 bodies in
    if has32 && not has64 then 64
    else if has64 && not has32 then 32
    else default-bits

  verify-prim-bodies-loop :: Nat -> String -> Bool -> String -> List (String, String) -> Bool -> List PrimParamSpec -> PrimParamSpec -> List UType -> List (Nat, UType) -> Option UType -> Option Expr -> List SpecDef -> String -> List PrimBody -> List TrustReceipt -> Bool -> Result String (Bool, List TrustReceipt)
  verify-prim-bodies-loop word-bits symbol is-jpl verify-mode proof-cache replay-only pspecs rspec req-preds param-preds postcond spec-opt spec-defs spec-display bodies acc all-verified = case bodies of
    [] -> Ok (all-verified, acc)
    (PrimBody sp family fragment unverified when selected justification uses immediates) : rest ->
      case verify-justification-word justification of
        None -> verify-prim-bodies-loop word-bits symbol is-jpl verify-mode proof-cache replay-only pspecs rspec req-preds param-preds postcond spec-opt spec-defs spec-display rest acc False
        Some jword ->
          if family /= "llvm" then
            Err (string-concat-all ["prim `", symbol, "`: `justify ", jword, "` is supported only for `llvm` bodies"])
          else
            let bbits = body-word-bits-for word-bits when in
            let body-pspecs = adjust-specs-word-size bbits pspecs in
            let body-rspec = adjust-spec-word-size bbits rspec in
            case verify-prim-body-cached symbol is-jpl verify-mode jword proof-cache replay-only fragment body-pspecs body-rspec req-preds param-preds postcond spec-opt spec-defs spec-display unverified of
              OutcomeDisproved detail ->
                Err (string-concat-all ["prim `", symbol, "` failed formal verification: ", detail])
              OutcomeRejected detail ->
                Err (string-concat-all ["prim `", symbol, "` verification rejected by policy: ", detail])
              OutcomeOpen detail ->
                Err (string-concat-all ["prim `", symbol, "` verification failed (unproved): ", detail])
              OutcomeVerified receipts ->
                verify-prim-bodies-loop word-bits symbol is-jpl verify-mode proof-cache replay-only pspecs rspec req-preds param-preds postcond spec-opt spec-defs spec-display rest (acc <> receipts) all-verified
              OutcomeAssumed receipts ->
                verify-prim-bodies-loop word-bits symbol is-jpl verify-mode proof-cache replay-only pspecs rspec req-preds param-preds postcond spec-opt spec-defs spec-display rest (acc <> receipts) False

  collect-same-width-llvm-bodies :: Nat -> Nat -> List PrimBody -> List (String, String)
  collect-same-width-llvm-bodies default-bits want-bits bodies = case bodies of
    [] -> []
    (PrimBody sp family fragment unverified when selected justification uses immediates) : rest ->
      let bbits = body-word-bits-for default-bits when in
      if family == "llvm" && not unverified && bbits == want-bits then
        case verify-justification-word justification of
          Some jword -> (fragment, jword) : (collect-same-width-llvm-bodies default-bits want-bits rest)
          None -> collect-same-width-llvm-bodies default-bits want-bits rest
      else collect-same-width-llvm-bodies default-bits want-bits rest

  verify-cross-target-pairs :: String -> Bool -> String -> List (String, String) -> Bool -> List PrimParamSpec -> PrimParamSpec -> List UType -> List (Nat, UType) -> String -> List (String, String) -> List TrustReceipt -> Bool -> Result String (Bool, List TrustReceipt)
  verify-cross-target-pairs symbol is-jpl verify-mode proof-cache replay-only pspecs rspec req-preds param-preds ref-frag others acc all-verified = case others of
    [] -> Ok (all-verified, acc)
    (other-frag, jword) : rest ->
      case verify-prim-cross-target symbol is-jpl verify-mode jword proof-cache replay-only ref-frag other-frag pspecs rspec req-preds param-preds of
        OutcomeDisproved detail ->
          Err (string-concat-all ["prim `", symbol, "` failed cross-target equivalence: ", detail])
        OutcomeRejected detail ->
          Err (string-concat-all ["prim `", symbol, "` cross-target verification rejected by policy: ", detail])
        OutcomeOpen detail ->
          Err (string-concat-all ["prim `", symbol, "` cross-target verification failed (unproved): ", detail])
        OutcomeVerified receipts ->
          verify-cross-target-pairs symbol is-jpl verify-mode proof-cache replay-only pspecs rspec req-preds param-preds ref-frag rest (acc <> receipts) all-verified
        OutcomeAssumed receipts ->
          verify-cross-target-pairs symbol is-jpl verify-mode proof-cache replay-only pspecs rspec req-preds param-preds ref-frag rest (acc <> receipts) False

  -- | Check a declared primitive body against its validated layout and containment rules.
  primitive-plan :: Nat -> String -> Scheme -> Option Expr -> List PrimBody -> List (List (String, Scheme)) -> (Nat -> RewriteJustification -> Result String String) -> Bool -> String -> List SpecDef -> List (String, String) -> Bool -> Result String ForeignPlan
  primitive-plan word-bits name scheme spec-opt bodies body-uses check-law is-jpl verify-mode spec-defs proof-cache replay-only =
    case (export-global name, primitive-layout-for word-bits scheme) of
      (Ok symbol, Ok (arguments, result)) -> let arity = list-length arguments in
        let pure = pure-primitive-arrows (scheme-body scheme) in
        let ptr-sized = case result.parameter-type of UCon rname KType -> has rname ["Usize", "Isize"]; other -> False in
        let fb-bits = effective-fallback-word-bits word-bits bodies in
        (case checked-prim-bodies fb-bits symbol pure bodies body-uses arity (foreign-llvm-type result) ptr-sized (FamilyCandidates None None) (FamilyCandidates None None) [] of
          Err message -> Err message
          Ok (body, condition) ->
            let trust = primitive-trust symbol bodies in
            let family = case body of InlinePrimitive owner chosen immediates llvm assembly -> chosen in
            if bodies-use-verify bodies then
              let (pnames, req-preds, param-preds, postcond) = extract-scheme-meta (scheme-body scheme) 0 in
              let pspecs = build-param-specs pnames arguments in
              let rspec = param-to-verify-spec "result" result in
              let spec-id-opt = spec-identity-string spec-opt in
              let spec-display = case spec-id-opt of Some s -> s; None -> "well-defined" in
              (case verify-prim-bodies-loop fb-bits symbol is-jpl verify-mode proof-cache replay-only pspecs rspec req-preds param-preds postcond spec-opt spec-defs spec-display bodies [] True of
                Err message -> Err message
                Ok (all-verified1, receipts1) ->
                  let cross64 = case collect-same-width-llvm-bodies fb-bits 64 bodies of
                        (ref-f, ref-j) : (more1 : more-rest) ->
                          verify-cross-target-pairs symbol is-jpl verify-mode proof-cache replay-only (adjust-specs-word-size 64 pspecs) (adjust-spec-word-size 64 rspec) req-preds param-preds ref-f (more1 : more-rest) receipts1 all-verified1
                        other -> Ok (all-verified1, receipts1) in
                  let cross-result = case cross64 of
                        Err message -> Err message
                        Ok (all-verified2, receipts2) ->
                          (case collect-same-width-llvm-bodies fb-bits 32 bodies of
                            (ref-f, ref-j) : (more1 : more-rest) ->
                              verify-cross-target-pairs symbol is-jpl verify-mode proof-cache replay-only (adjust-specs-word-size 32 pspecs) (adjust-spec-word-size 32 rspec) req-preds param-preds ref-f (more1 : more-rest) receipts2 all-verified2
                            other -> Ok (all-verified2, receipts2)) in
                  (case cross-result of
                    Err message -> Err message
                    Ok (all-verified, receipts) ->
                      if all-verified then
                        (case export-display-scheme scheme of
                          Err message -> Err message
                          Ok signature-text ->
                            let identity = string-concat-all ["prim:", symbol, ":", signature-text, ":spec[", spec-display, "]"] in
                            let proof-fact = MkPrimProofFact (local-symbol-name symbol) spec-display "llvm-sem@21.1" (worst-trust-tier receipts) (receipts-tcb-union receipts) in
                            Ok (ForeignPlan (string-concat-all [symbol, ".", family]) scheme arguments result
                              (Some (body, None, trust, selection-document-verified body condition identity "verified" spec-id-opt receipts trust bodies, Some proof-fact, receipts))))
                      else
                        let identity = primitive-identity symbol (primitive-body-text bodies) in
                        Ok (ForeignPlan (string-concat-all [symbol, ".", family]) scheme arguments result
                          (Some (body, Some identity, trust, selection-document-verified body condition identity "assumed" spec-id-opt receipts trust bodies, None, receipts)))))
            else
              (case primitive-laws (check-law arity) bodies True [] of
                Err message -> Err message
                Ok (justified, laws) ->
                  (case primitive-contract symbol scheme bodies justified laws of
                    Err message -> Err message
                    Ok identity -> let assumed = if justified then None else Some identity in
                      let declared = if justified then laws <> trust else trust in
                      Ok (ForeignPlan (string-concat-all [symbol, ".", family]) scheme arguments result
                        (Some (body, assumed, declared, selection-document body condition identity justified trust bodies, None, []))))))
      (Err message, other) -> Err message
      (other, Err message) -> Err message

  selection-document-verified :: InlinePrimitive -> Option String -> String -> String -> Option String -> List TrustReceipt -> List String -> List PrimBody -> Json
  selection-document-verified body condition identity tier-name spec-id-opt receipts trust bodies = case body of
    InlinePrimitive owner family immediates llvm assembly ->
      let why = case condition of
            None -> string-concat-all ["the baseline `", family, "` body (the fallback when no `when` condition matches)"]
            Some clause -> string-concat-all ["the `", family, "` body's `when ", clause, "` condition holds in the target profile"] in
      let tail-fields =
            JObj "trust" (trust-document bodies trust)
              (JObj "immarg" (immediate-document immediates)
                (JObj "uses" JArrEnd
                  (JObj "validation" (validation-document bodies)
                    (JObj "receipts" (receipts-to-json receipts) JObjEnd)))) in
      let with-spec = case spec-id-opt of
            None -> tail-fields
            Some sp -> JObj "spec" (JStr sp) tail-fields in
      JObj "family" (JStr family)
        (JObj "condition" (case condition of None -> JNull; Some clause -> JStr clause)
          (JObj "identity" (JStr identity)
            (JObj "tier" (JStr tier-name)
              (JObj "why" (JStr why) with-spec))))

  primitive-laws :: (RewriteJustification -> Result String String) -> List PrimBody -> Bool -> List String -> Result String (Bool, List String)
  primitive-laws check-law bodies justified laws = case bodies of
    [] -> Ok (justified, reverse laws)
    (PrimBody sp family fragment unverified clauses projected evidence uses immediates) : rest -> case evidence of
      None -> primitive-laws check-law rest False laws
      Some citation -> (case check-law citation of
        Err message -> Err message
        Ok identity -> primitive-laws check-law rest justified (if has identity laws then laws else identity : laws))

  primitive-contract :: String -> Scheme -> List PrimBody -> Bool -> List String -> Result String String
  primitive-contract symbol scheme bodies justified laws = if justified then (case export-display-scheme scheme of
    Ok signature-text -> Ok (string-concat-all ["prim:", symbol, ":", signature-text, ":laws[", strings "," laws, "]"])
    Err message -> Err message) else Ok (primitive-identity symbol (primitive-body-text bodies))

  -- Keep target selection in the artifact manifest. Interface assumptions
  -- continue to use the target-independent identities of all checked bodies.
  selection-document :: InlinePrimitive -> Option String -> String -> Bool -> List String -> List PrimBody -> Json
  selection-document body condition identity justified trust bodies = case body of
    InlinePrimitive owner family immediates llvm assembly ->
      let why = case condition of
            None -> string-concat-all ["the baseline `", family, "` body (the fallback when no `when` condition matches)"]
            Some clause -> string-concat-all ["the `", family, "` body's `when ", clause, "` condition holds in the target profile"] in
      JObj "family" (JStr family) (JObj "condition" (case condition of None -> JNull; Some clause -> JStr clause)
        (JObj "identity" (JStr identity) (JObj "tier" (JStr (if justified then "justified" else "assumed")) (JObj "why" (JStr why)
          (JObj "trust" (trust-document bodies trust) (JObj "immarg" (immediate-document immediates)
            (JObj "uses" JArrEnd (JObj "validation" (validation-document bodies) JObjEnd))))))))
  trust-document :: List PrimBody -> List String -> Json
  trust-document bodies identities = case bodies of
    [] -> JArrEnd
    (PrimBody site family fragment unverified clauses projected justification uses immediates) : rest ->
      if unverified then (case identities of
        identity : more -> JArr (JStr (string-concat-all [family, ": declared under `unsafe`, trusted not verified (", identity, ")"])) (trust-document rest more)
        [] -> JArrEnd)
      else trust-document rest identities
  immediate-document :: List Nat -> Json
  immediate-document positions = case positions of [] -> JArrEnd; i : rest -> JArr (JNum (nat-to-int i)) (immediate-document rest)
  validation-document :: List PrimBody -> Json
  validation-document bodies = case bodies of
    [] -> JArrEnd
    (PrimBody sp family fragment unverified when selected justification uses immediates) : rest ->
      let detail = if family == "llvm" then "llvm: containment validated: checked return, permitted instructions and calls"
            else "asm: containment validated structurally for escaping instructions" in
      JArr (JStr detail) (validation-document rest)
  strings :: String -> List String -> String
  strings delimiter values = case values of [] -> ""; [first] -> first; first : rest -> string-concat-all [first, delimiter, strings delimiter rest]
  visible-regions :: List Quant -> List (Nat, UType)
  visible-regions qs = case qs of [] -> []; q : rest -> (q.id, UCon (q.name) KRegion) : (visible-regions rest)
  append :: Result String String -> String -> Result String String -> Result String String
  append first delimiter second = case (first, second) of
    (Ok a, Ok b) -> Ok (string-concat-all [a, delimiter, b])
    (Err error, other) -> Err error
    (other, Err error) -> Err error
  surround :: Result String String -> Result String String
  surround result = case result of Ok value -> Ok (string-concat-all ["(", value, ")"]); Err error -> Err error
  boundary-type-text :: UType -> Result String String
  boundary-type-text ty = case ty of
    UApp head arg -> if foreign-pointer ty then append (boundary-type-text head) " " (if foreign-pointer arg then surround (boundary-type-text arg) else boundary-type-text arg)
      else append (boundary-type-text head) " " (case arg of UApp f x -> surround (boundary-type-text arg); other -> boundary-type-text arg)
    UFun domain result -> surround (append (boundary-type-text domain) " -> " (boundary-type-text result))
    UFunEff domain row result -> case labels-text row of
      Err error -> Err error
      Ok labels -> let effects = case labels of [] -> ""; other -> string-concat-all ["{", strings ", " labels, "}"] in
        surround (append (boundary-type-text domain) (string-concat-all [" ->", effects, " "]) (boundary-type-text result))
    other -> export-type ty
  display-body :: ForeignPlan -> Result String String
  display-body plan = let scheme = plan.scheme in boundary-type-text (substitute-bound (visible-regions (scheme-params scheme)) (scheme-body scheme))
  region-names :: List Quant -> List String
  region-names qs = case qs of [] -> []; q : rest -> (q.name) : (region-names rest)
  foreign-display-scheme :: ForeignPlan -> Result String String
  foreign-display-scheme plan = case display-body plan of
    Err error -> Err error
    Ok body -> let qs = scheme-params (plan.scheme) in Ok (string-concat (case qs of [] -> ""; other -> string-concat-all ["forall ", strings " " (region-names qs), " . "]) body)
  parameter-document :: ForeignParameter -> Result String Json
  parameter-document item = case item of
    ForeignParameter ty category role width align signed nullable -> case boundary-type-text ty of
      Err error -> Err error
      Ok spelling -> Ok (JObj "type" (JStr spelling) (JObj "class" (JStr category) (JObj "role" (JStr role)
        (JObj "allocator" (JStr "") (JObj "nullable" (JBool nullable) (JObj "width" (JNum (nat-to-int width))
          (JObj "align" (JNum (nat-to-int align)) (JObj "signed" (JBool signed) (JObj "offsets" JArrEnd JObjEnd)))))))))
  parameter-documents :: List ForeignParameter -> Result String Json
  parameter-documents params = case params of
    [] -> Ok JArrEnd
    first : rest -> case (parameter-document first, parameter-documents rest) of
      (Ok row, Ok more) -> Ok (JArr row more)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
  label-text :: UType -> Result String String
  label-text ty = case ty of
    UApp (UCon name kind) arg -> case export-type arg of Ok value -> Ok (string-concat-all [name, " ", value]); Err error -> Err error
    UCon name KEffect -> Ok (if name == "#kernel.ForeignIO" then "IO" else name)
    other -> Err "invalid checked foreign effect label"
  effect-text :: UType -> Result String (List String)
  effect-text ty = case ty of
    UFun domain result -> effect-text result
    UFunEff domain row result -> case (labels-text row, effect-text result) of
      (Ok first, Ok rest) -> Ok (first <> rest)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
    UPi id name domain row result -> case (labels-text row, effect-text result) of
      (Ok first, Ok rest) -> Ok (first <> rest)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
    other -> Ok []
  labels-text :: UType -> Result String (List String)
  labels-text row = case row of
    URow labels -> labels-text labels
    UEnd -> Ok []
    UArg label rest -> case (label-text label, labels-text rest) of
      (Ok value, Ok more) -> Ok (value : more)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
    other -> Err "foreign effect row must be closed"
  foreign-document :: String -> ForeignPlan -> Result String Json
  foreign-document local plan = let scheme = plan.scheme in
    case (display-body plan, parameter-documents (plan.parameters), parameter-document (plan.result), effect-text (substitute-bound (visible-regions (scheme-params scheme)) (scheme-body scheme))) of
      (Ok spelling, Ok params, Ok result, Ok effects) -> Ok (JObj "symbol" (JStr local) (JObj "abi" (JStr "ccall")
        (JObj "external" (JStr (plan.symbol)) (JObj "type" (JStr spelling) (JObj "effects" (JStr (strings ", " effects))
          (JObj "notes" (JStr "foreign import") (JObj "kind" (JStr "import") (JObj "params" params (JObj "result" result (JObj "deallocator" (JStr "") JObjEnd))))))))))
      (Err error, other, more, end) -> Err error
      (other, Err error, more, end) -> Err error
      (other, more, Err error, end) -> Err error
      (other, more, end, Err error) -> Err error
