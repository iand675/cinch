-- Executable, closed total-body contracts. A pure scheme or class slot is
-- not a body. Only this module can construct the checked graph/function
-- handles; the complete graph is typed and checked for dependency cycles.
-- These standalone version-1 artifacts are not yet admitted by cinchif.
module Bootstrap.Total where
  import Bootstrap.BodyScope (BodyScope, body-scope-from-list, empty-body-scope, push-body-slot, body-slot)
  import Data.Json
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Data.Nat (nat-from-int, nat-to-int)
  import Algebra.Semigroup
  import Text.Json (canonical-bytes, json-eq)

  export TotalGraph, TotalFunction, check-total-graph, check-total-function, total-function, total-graph-for-roots, total-graph-body
  export parse-decimal-value, total-decimal-value, total-function-closure, total-graph-symbols
  export total-identity, total-parameters, total-result, total-body, total-document, total-bounds, total-function-document, total-function-graph, total-function-equal, total-functions-compatible
  export projection-result-sort, source-field-projection, source-total-projection, total-source-projection, read-total-function
  export read-keyed-ordering, keyed-ordering-slots
  export TotalCompatibility, empty-total-compatibility, extend-total-compatibility

  data TotalRows where
    SingleRow :: String -> Json -> TotalRows
    IndexedRows :: HashMap String Json -> TotalRows
  data TotalGraph where
    MkTotalGraph :: Json -> TotalRows -> TotalGraph
  data TotalFunction where
    MkTotalFunction :: TotalGraph -> String -> TotalFunction
    MkSourceProjection :: String -> String -> String -> Json -> TotalFunction
    MkKeyedOrdering :: String -> Nat -> Nat -> TotalFunction

  same :: String -> String -> Bool
  same a b = string-compare a b == 0
  has :: String -> List String -> Bool
  has key keys = case keys of Nil -> False; Cons first rest -> same key first || has key rest
  without :: String -> List String -> List String
  without key keys = case keys of Nil -> Nil; Cons first rest -> if same key first then rest else Cons first (without key rest)
  field :: String -> Json -> Json
  field name doc = case doc of JObj key value rest -> if same name key then value else field name rest; other -> JNull
  text :: Json -> String
  text doc = case doc of JStr value -> value; other -> ""
  fields :: List String -> Json -> Bool
  fields keys doc = case doc of
    JObj key value rest -> has key keys && fields (without key keys) rest
    JObjEnd -> (case keys of Nil -> True; other -> False)
    other -> False
  valid-sort :: String -> Bool
  valid-sort name = has name ["Nat", "Int", "Bool", "Bytes", "I64"]
  sorts :: Json -> Option (List String)
  sorts rows = case rows of
    JArr (JStr sort) rest -> if valid-sort sort then (case sorts rest of Some more -> Some (Cons sort more); None -> None) else None
    JArrEnd -> Some Nil
    other -> None
  find-row :: String -> TotalRows -> Option Json
  find-row name rows = case rows of
    SingleRow identity row -> if same name identity then Some row else None
    IndexedRows table -> hash-map-lookup name table

  decimal-digits :: List Char -> Bool
  decimal-digits chars = case chars of Nil -> True; Cons char rest -> char-code char >= 48 && char-code char <= 57 && decimal-digits rest
  trim-zeros :: List Char -> List Char
  trim-zeros chars = case chars of Cons char (Cons next rest) -> if char-code char == 48 then trim-zeros (Cons next rest) else chars; other -> chars
  i64-digits :: Bool -> List Char -> Bool
  i64-digits negative digits = let value = pack (trim-zeros digits) in
    string-length value < 19 || (string-length value == 19 && string-compare value (if negative then "9223372036854775808" else "9223372036854775807") <= 0)
  decimal-number :: String -> String -> Bool
  decimal-number sort value = case unpack value of
    Nil -> False
    Cons char rest -> if char-code char == 45 then
      not (same sort "Nat") && (same sort "Int" || same sort "I64") && (case rest of Nil -> False; other -> decimal-digits rest && (not (same sort "I64") || i64-digits True rest))
      else (same sort "Nat" || same sort "Int" || same sort "I64") && decimal-digits (Cons char rest) && (not (same sort "I64") || i64-digits False (Cons char rest))

  operation-type :: String -> Option (List String, String)
  operation-type name =
    if has name ["NatAdd", "NatMul"] then Some (["Nat", "Nat"], "Nat")
    else if same name "NatCmp" then Some (["Nat", "Nat"], "I64")
    else if has name ["IntAdd", "IntSub", "IntMul"] then Some (["Int", "Int"], "Int")
    else if same name "IntNeg" then Some (["Int"], "Int")
    else if same name "IntCmp" then Some (["Int", "Int"], "I64")
    else if same name "IntFromNat" then Some (["Nat"], "Int")
    else if same name "IntFromI64" then Some (["I64"], "Int")
    else if has name ["I64Eq", "I64Ne", "I64Lt", "I64Le", "I64Gt", "I64Ge"] then Some (["I64", "I64"], "Bool")
    else if has name ["BoolEq", "BoolNe", "BoolAnd", "BoolOr"] then Some (["Bool", "Bool"], "Bool")
    else if same name "BoolNot" then Some (["Bool"], "Bool")
    else if same name "BytesLen" then Some (["Bytes"], "Nat")
    else None
  arguments-fit :: TotalRows -> BodyScope String -> Json -> List String -> Bool
  arguments-fit definitions scope arguments parameters = case (arguments, parameters) of
    (JArr argument rest, Cons expected more) -> (case infer definitions scope argument of Some actual -> same expected actual; None -> False) && arguments-fit definitions scope rest more
    (JArrEnd, Nil) -> True
    other -> False
  call-type :: TotalRows -> BodyScope String -> Json -> Json -> Option String
  call-type definitions scope arguments declaration = case sorts (field "parameters" declaration) of
    Some parameters -> if valid-sort (text (field "result" declaration)) && arguments-fit definitions scope arguments parameters then Some (text (field "result" declaration)) else None
    None -> None
  infer :: TotalRows -> BodyScope String -> Json -> Option String
  infer definitions scope term = let node = text (field "node" term) in
    if same node "local" then
      (if fields ["node", "slot"] term then (case field "slot" term of JNum index -> if index >= 0 then body-slot (nat-from-int index) scope else None; other -> None) else None)
    else if same node "number" then
      (if fields ["node", "sort", "decimal"] term && decimal-number (text (field "sort" term)) (text (field "decimal" term)) then Some (text (field "sort" term)) else None)
    else if same node "bool" then
      (if fields ["node", "value"] term then (case field "value" term of JBool value -> Some "Bool"; other -> None) else None)
    else if same node "primitive" then
      (if fields ["node", "operation", "arguments"] term then (case operation-type (text (field "operation" term)) of
        Some (parameters, result) -> if arguments-fit definitions scope (field "arguments" term) parameters then Some result else None
        None -> None) else None)
    else if same node "call" then
      (if fields ["node", "target", "arguments"] term then (case find-row (text (field "target" term)) definitions of
        Some declaration -> call-type definitions scope (field "arguments" term) declaration
        None -> None) else None)
    else if same node "let" then
      (if fields ["node", "value", "body"] term then (case infer definitions scope (field "value" term) of
        Some sort -> infer definitions (push-body-slot scope sort) (field "body" term)
        None -> None) else None)
    else if same node "if" then
      (if fields ["node", "condition", "yes", "no"] term then (case (infer definitions scope (field "condition" term), infer definitions scope (field "yes" term), infer definitions scope (field "no" term)) of
        (Some condition, Some yes, Some no) -> if same condition "Bool" && same yes no then Some yes else None
        other -> None) else None)
    else None

  calls-arguments :: Json -> List String -> List String
  calls-arguments rows tail = case rows of
    JArr first rest -> calls-into first (calls-arguments rest tail)
    other -> tail
  calls-into :: Json -> List String -> List String
  calls-into term tail = let node = text (field "node" term) in
    if same node "call" then Cons (text (field "target" term)) (calls-arguments (field "arguments" term) tail)
    else if same node "primitive" then calls-arguments (field "arguments" term) tail
    else if same node "let" then calls-into (field "value" term) (calls-into (field "body" term) tail)
    else if same node "if" then calls-into (field "condition" term) (calls-into (field "yes" term) (calls-into (field "no" term) tail))
    else tail
  -- Completed rows double as the index of the reachable subgraph.
  acyclic-calls :: TotalRows -> HashMap String () -> HashMap String Json -> List String -> Option (HashMap String Json)
  acyclic-calls definitions path done targets = case targets of
    Nil -> Some done
    Cons name rest -> case hash-map-lookup name done of
      Some prior -> acyclic-calls definitions path done rest
      None -> case (hash-map-lookup name path, find-row name definitions) of
        (None, Some declaration) -> (case acyclic-calls definitions (hash-map-insert name () path) done (calls-into (field "body" declaration) Nil) of
          Some checked -> acyclic-calls definitions path (hash-map-insert name declaration checked) rest
          None -> None)
        other -> None
  definition-name :: Json -> Option String
  definition-name declaration = let name = text (field "identity" declaration) in
    if string-length name > 0 && fields ["identity", "parameters", "result", "body"] declaration then Some name else None
  index-definitions :: Json -> HashMap String Json -> Option (HashMap String Json)
  index-definitions rows table = case rows of
    JArr declaration rest -> case definition-name declaration of
      Some name -> (case hash-map-lookup name table of
        None -> index-definitions rest (hash-map-insert name declaration table)
        Some duplicate -> None)
      None -> None
    JArrEnd -> Some table
    other -> None
  valid-definition :: TotalRows -> Json -> Bool
  valid-definition all declaration = case sorts (field "parameters" declaration) of
    Some parameters -> (case infer all (body-scope-from-list parameters) (field "body" declaration) of
      Some result -> valid-sort (text (field "result" declaration)) && same result (text (field "result" declaration))
      None -> False)
    None -> False
  valid-definitions :: TotalRows -> Json -> Bool
  valid-definitions all rows = case rows of
    JArr declaration rest -> valid-definition all declaration && valid-definitions all rest
    JArrEnd -> True
    other -> False
  check-total-graph :: Json -> Option TotalGraph
  check-total-graph doc = check-graph doc None

  -- Interface declarations require one root and its exact closure. Walking
  -- from that root proves acyclicity and membership in the same traversal.
  check-total-function :: Json -> String -> Option TotalFunction
  check-total-function doc name = case check-graph doc (Some name) of
    Some graph -> Some (MkTotalFunction graph name)
    None -> None

  check-graph :: Json -> Option String -> Option TotalGraph
  check-graph doc root = if fields ["version", "definitions"] doc && (case field "version" doc of JNum value -> value == 1; other -> False) then
    let definitions = field "definitions" doc in
    case definitions of
      -- The only possible internal call would recurse back to this row.
      JArr row JArrEnd -> (case definition-name row of
        Some name ->
          if (case root of Some required -> same name required; None -> True) && valid-definition (IndexedRows hash-map-empty) row
          then Some (MkTotalGraph doc (SingleRow name row)) else None
        None -> None)
      other -> case index-definitions definitions hash-map-empty of
        Some table -> let rows = IndexedRows table in
          if valid-definitions rows definitions && check-graph-roots rows definitions root then Some (MkTotalGraph doc rows)
          else None
        None -> None
    else None

  check-graph-roots :: TotalRows -> Json -> Option String -> Bool
  check-graph-roots rows definitions root = case root of
    None -> case acyclic-calls rows hash-map-empty hash-map-empty (total-row-symbols definitions) of
      Some checked -> True
      None -> False
    Some name -> exact-roots rows definitions [name]

  total-function :: TotalGraph -> String -> Option TotalFunction
  total-function graph name = case graph of MkTotalGraph doc rows -> (case find-row name rows of Some row -> Some (MkTotalFunction graph name); None -> None)
  total-graph-body :: TotalGraph -> String -> Option Json
  total-graph-body graph name = case graph of
    MkTotalGraph doc rows -> (case find-row name rows of
      Some row -> Some (field "body" row)
      None -> None)
  total-document :: TotalGraph -> Json
  total-document graph = case graph of MkTotalGraph doc rows -> doc
  -- Projections are reconstructed against the checked source constructors.
  -- Their carrier-tree representation carries no imported body authority.
  source-total-projection :: String -> String -> List (String, Nat) -> Option TotalFunction
  source-total-projection name domain steps = source-field-projection name domain "Bytes" steps
  projection-result-sort :: String -> Bool
  projection-result-sort result = has result ["Bytes", "Nat", "Int"]
  projection-document :: String -> String -> Json -> Json
  projection-document domain result steps = JObj "domain" (JStr domain) (JObj "fields" steps
    (if same result "Bytes" then JObjEnd else JObj "result" (JStr result) JObjEnd))
  source-field-projection :: String -> String -> String -> List (String, Nat) -> Option TotalFunction
  source-field-projection name domain result steps = read-source-projection name (projection-document domain result (projection-steps steps))
  projection-steps :: List (String, Nat) -> Json
  projection-steps steps = case steps of
    Nil -> JArrEnd
    Cons (constructor, index) rest -> JArr (JArr (JStr constructor) (JArr (JNum (nat-to-int index)) JArrEnd)) (projection-steps rest)
  valid-projection-steps :: Json -> Bool
  valid-projection-steps steps = case steps of
    JArr (JArr (JStr constructor) (JArr (JNum index) JArrEnd)) rest ->
      string-length constructor > 0 && index >= 0 && valid-projection-steps rest
    JArrEnd -> True
    other -> False
  read-source-projection :: String -> Json -> Option TotalFunction
  read-source-projection name doc = let result = if fields ["domain", "fields"] doc then "Bytes" else if fields ["domain", "fields", "result"] doc then text (field "result" doc) else "" in
    if not (projection-result-sort result && string-length name > 0) then None else case (field "domain" doc, field "fields" doc) of
      (JStr domain, JArr first rest) -> if string-length domain > 0 && not (valid-sort domain) && valid-projection-steps (JArr first rest) then Some (MkSourceProjection name domain result (JArr first rest)) else None
      other -> None
  read-total-function :: Json -> String -> Option TotalFunction
  read-total-function doc name = if fields ["source_projection"] doc then read-source-projection name (field "source_projection" doc) else
    case check-total-graph doc of Some graph -> total-function graph name; None -> None
  -- A keyed body only describes control flow over its caller's dictionary.
  -- It cannot enter the first-order evaluator or a symbolic value index.
  read-keyed-ordering :: String -> Json -> Option TotalFunction
  read-keyed-ordering name doc = if string-length name == 0 || not (fields ["less_slot", "greater_slot"] doc) then None else
    case (field "less_slot" doc, field "greater_slot" doc) of
      (JNum less, JNum greater) -> if less >= 0 && greater >= 0 && less /= greater then Some (MkKeyedOrdering name (nat-from-int less) (nat-from-int greater)) else None
      other -> None
  keyed-ordering-slots :: TotalFunction -> Option (Nat, Nat)
  keyed-ordering-slots function = case function of MkKeyedOrdering name less greater -> Some (less, greater); other -> None
  total-source-projection :: TotalFunction -> Bool
  total-source-projection function = case function of MkSourceProjection name domain result steps -> True; other -> False
  total-identity :: TotalFunction -> String
  total-identity function = case function of MkTotalFunction graph name -> name; MkSourceProjection name domain result steps -> name; MkKeyedOrdering name less greater -> name
  function-row :: TotalFunction -> Json
  function-row function = case function of
    MkTotalFunction (MkTotalGraph doc rows) name -> (case find-row name rows of Some row -> row; None -> JNull)
    other -> JNull
  total-parameters :: TotalFunction -> List String
  total-parameters function = case function of
    MkSourceProjection name domain result steps -> [domain]
    other -> (case sorts (field "parameters" (function-row function)) of Some parameters -> parameters; None -> Nil)
  total-result :: TotalFunction -> String
  total-result function = case function of MkSourceProjection name domain result steps -> result; other -> text (field "result" (function-row function))
  -- Only an admitted closed function carries an executable graph.
  total-function-graph :: TotalFunction -> Option TotalGraph
  total-function-graph function = case function of
    MkTotalFunction graph name -> Some graph
    other -> None

  total-function-document :: TotalFunction -> Json
  total-function-document function = case function of
    MkTotalFunction graph name -> total-document graph
    MkSourceProjection name domain result steps -> JObj "source_projection" (projection-document domain result steps) JObjEnd
    MkKeyedOrdering name less greater -> JObj "keyed_ordering" (JObj "less_slot" (JNum (nat-to-int less)) (JObj "greater_slot" (JNum (nat-to-int greater)) JObjEnd)) JObjEnd
  closure-rows :: HashMap String Json -> Json -> Json
  closure-rows names rows = case rows of
    JArr row rest -> case hash-map-lookup (text (field "identity" row)) names of
      Some reachable -> JArr row (closure-rows names rest)
      None -> closure-rows names rest
    other -> JArrEnd
  total-graph-symbols :: TotalGraph -> List String
  total-graph-symbols graph = case graph of MkTotalGraph doc rows -> total-row-symbols (field "definitions" doc)
  total-row-symbols :: Json -> List String
  total-row-symbols rows = case rows of
    JArr row rest -> Cons (text (field "identity" row)) (total-row-symbols rest)
    other -> Nil
  total-function-closure :: TotalGraph -> String -> Option TotalFunction
  total-function-closure graph name = case graph of MkTotalGraph doc rows -> (case acyclic-calls rows hash-map-empty hash-map-empty [name] of
    -- The walk keeps all the dependencies of these already checked rows.
    Some reachable ->
      let definitions = closure-rows reachable (field "definitions" doc) in
      let closed = JObj "version" (JNum 1) (JObj "definitions" definitions JObjEnd) in
      Some (MkTotalFunction (MkTotalGraph closed (IndexedRows reachable)) name)
    None -> None)
  -- Checked total documents contain no floating-point JSON values.
  -- Matching structure can skip serialization. Canonical bytes still
  -- compare documents that encode the same fields in different orders.
  total-documents-equal :: Json -> Json -> Bool
  total-documents-equal first second = json-eq first second || bytes-compare (canonical-bytes first) (canonical-bytes second) == 0
  total-function-equal :: TotalFunction -> TotalFunction -> Bool
  total-function-equal first second = same (total-identity first) (total-identity second)
    && total-documents-equal (total-function-document first) (total-function-document second)
  total-body :: TotalFunction -> Json
  total-body function = field "body" (function-row function)

  -- A universal finite return envelope, derived from actual literal leaves.
  -- Unknown arithmetic/parameters remain unknown. Conditions may narrow the
  -- result further, but taking both checked branches is always conservative.
  decimal-fold :: List Char -> Int -> Option Int
  decimal-fold chars value = case chars of
    Nil -> Some value
    Cons char rest -> let code = char-code char in
      if code >= 48 && code <= 57 then decimal-fold rest (value * 10 + (nat-to-int code - 48)) else None
  decimal-value :: String -> Option Int
  decimal-value value = if string-length value > 4096 then None else parse-decimal-value value
  parse-decimal-value :: String -> Option Int
  parse-decimal-value value = case unpack value of
    Nil -> None
    Cons char rest -> if char-code char == 45 then (case rest of Nil -> None; other -> (case decimal-fold rest 0 of Some n -> Some (0 - n); None -> None)) else decimal-fold (Cons char rest) 0
  unknown-domains :: List String -> BodyScope (Option (List Int)) -> BodyScope (Option (List Int))
  unknown-domains parameters scope = case parameters of
    Nil -> scope
    Cons parameter rest -> unknown-domains rest (push-body-slot scope None)
  argument-domains :: TotalRows -> BodyScope (Option (List Int)) -> Json -> Nat -> BodyScope (Option (List Int)) -> (BodyScope (Option (List Int)), Nat)
  argument-domains definitions scope arguments fuel values = if fuel == 0 then (values, 0) else case arguments of
    JArr argument rest -> (case literal-results definitions scope argument fuel of
      (value, left) -> argument-domains definitions scope rest left (push-body-slot values value))
    other -> (values, fuel)
  literal-results :: TotalRows -> BodyScope (Option (List Int)) -> Json -> Nat -> (Option (List Int), Nat)
  literal-results definitions scope term fuel = if fuel == 0 then (None, 0) else
    let remaining = fuel - 1 in let node = text (field "node" term) in
    if same node "number" then (case decimal-value (text (field "decimal" term)) of Some value -> (Some [value], remaining); None -> (None, remaining))
    else if same node "local" then (case field "slot" term of
      JNum slot | slot >= 0 -> (case body-slot (nat-from-int slot) scope of
        Some domain -> (domain, remaining)
        None -> (None, remaining))
      other -> (None, remaining))
    else if same node "if" then (case literal-results definitions scope (field "yes" term) remaining of
      (Some yes, left) -> (case literal-results definitions scope (field "no" term) left of
        (Some no, final) -> if list-length yes + list-length no <= 256 then (Some (yes <> no), final) else (None, final)
        other -> other)
      other -> other)
    else if same node "let" then (case literal-results definitions scope (field "value" term) remaining of
      (value, left) -> literal-results definitions (push-body-slot scope value) (field "body" term) left)
    else if same node "call" then (case find-row (text (field "target" term)) definitions of
      Some declaration -> (case argument-domains definitions scope (field "arguments" term) remaining empty-body-scope of
        (values, left) -> literal-results definitions values (field "body" declaration) left)
      None -> (None, remaining))
    else (None, remaining)
  result-envelope :: List Int -> Int -> Int -> (Int, Int)
  result-envelope values low high = case values of Nil -> (low, high); Cons value rest -> result-envelope rest (if value < low then value else low) (if value > high then value else high)
  total-bounds :: TotalFunction -> Option (Int, Int)
  total-bounds function = if not (has (total-result function) ["Nat", "Int", "I64"]) then None else case function of
    MkTotalFunction (MkTotalGraph doc rows) name -> (case literal-results rows (unknown-domains (total-parameters function) empty-body-scope) (total-body function) 4096 of
      (Some (Cons value rest), remaining) -> Some (result-envelope rest value value)
      other -> None)
    other -> None

  total-owned-rows :: Json -> HashMap String Json -> Bool
  total-owned-rows rows reachable = case rows of
    JArr row rest -> case hash-map-lookup (text (field "identity" row)) reachable of
      Some checked -> total-owned-rows rest reachable
      None -> False
    JArrEnd -> True
    other -> False

  exact-roots :: TotalRows -> Json -> List String -> Bool
  exact-roots rows definitions roots = case acyclic-calls rows hash-map-empty hash-map-empty roots of
    Some reachable -> total-owned-rows definitions reachable
    None -> False

  total-graph-for-roots :: TotalGraph -> List String -> Bool
  total-graph-for-roots graph roots = case graph of MkTotalGraph doc rows -> exact-roots rows (field "definitions" doc) roots

  -- Every row of `first` must be byte-identical to the row of `second` that
  -- carries the same identity, and a row `second` does not have is compatible.
  compatible-rows :: Json -> TotalRows -> Bool
  compatible-rows first table = case first of
    JArr row rest -> (case find-row (text (field "identity" row)) table of
      Some prior -> total-documents-equal row prior
      None -> True) && compatible-rows rest table
    JArrEnd -> True
    other -> False
  total-functions-compatible :: TotalFunction -> TotalFunction -> Bool
  total-functions-compatible first second = case (first, second) of
    (MkKeyedOrdering name less greater, MkKeyedOrdering other small large) -> not (same name other) || (less == small && greater == large)
    (MkKeyedOrdering name less greater, other) -> projection-compatible first second
    (other, MkKeyedOrdering name less greater) -> projection-compatible second first
    other -> graph-views-compatible first second
  graph-views-compatible :: TotalFunction -> TotalFunction -> Bool
  graph-views-compatible first second = case (total-source-projection first, total-source-projection second) of
    (False, False) -> case second of
      MkTotalFunction (MkTotalGraph doc rows) name -> compatible-rows (field "definitions" (total-function-document first)) rows
      other -> True
    (True, True) -> not (same (total-identity first) (total-identity second)) || total-function-equal first second
    (True, False) -> projection-compatible first second
    (False, True) -> projection-compatible second first
  projection-compatible :: TotalFunction -> TotalFunction -> Bool
  projection-compatible projection graph = case graph of
    MkTotalFunction (MkTotalGraph doc rows) name ->
      (case find-row (total-identity projection) rows of None -> True; Some row -> False)
    other -> True

  -- Checked graph rows sharing an identity must agree byte for byte. A
  -- projection or keyed ordering excludes a graph row with its identity.
  -- Projection and ordering descriptors only compare within their own kind.
  data TotalCompatibility where
    CheckedTotalCompatibility :: HashMap String Json -> HashMap String TotalFunction -> HashMap String TotalFunction -> TotalCompatibility
  empty-total-compatibility :: TotalCompatibility
  empty-total-compatibility = CheckedTotalCompatibility hash-map-empty hash-map-empty hash-map-empty
  remember-descriptor :: TotalFunction -> HashMap String TotalFunction -> Option (HashMap String TotalFunction)
  remember-descriptor function descriptors = let name = total-identity function in
    case hash-map-lookup name descriptors of
      None -> Some (hash-map-insert name function descriptors)
      Some old -> if total-function-equal old function then Some descriptors else None
  remember-graph-rows :: Json -> HashMap String Json -> HashMap String TotalFunction -> HashMap String TotalFunction -> Option (HashMap String Json)
  remember-graph-rows rows known projections orderings = case rows of
    JArr row rest ->
      let name = text (field "identity" row) in
      case (hash-map-lookup name projections, hash-map-lookup name orderings) of
        (None, None) ->
          case hash-map-lookup name known of
            None -> remember-graph-rows rest (hash-map-insert name row known) projections orderings
            Some prior -> if total-documents-equal row prior then remember-graph-rows rest known projections orderings else None
        other -> None
    JArrEnd -> Some known
    other -> None
  extend-total-compatibility :: TotalFunction -> TotalCompatibility -> Option TotalCompatibility
  extend-total-compatibility function context = case context of
    CheckedTotalCompatibility rows projections orderings -> case function of
      MkTotalFunction (MkTotalGraph doc table) name -> (case remember-graph-rows (field "definitions" doc) rows projections orderings of
        Some known -> Some (CheckedTotalCompatibility known projections orderings)
        None -> None)
      MkSourceProjection name domain result steps -> (case hash-map-lookup name rows of
        Some row -> None
        None -> (case remember-descriptor function projections of
          Some known -> Some (CheckedTotalCompatibility rows known orderings)
          None -> None))
      MkKeyedOrdering name less greater -> (case hash-map-lookup name rows of
        Some row -> None
        None -> (case remember-descriptor function orderings of
          Some known -> Some (CheckedTotalCompatibility rows projections known)
          None -> None))

  total-decimal-value :: String -> Option Int
  total-decimal-value text = decimal-value text
