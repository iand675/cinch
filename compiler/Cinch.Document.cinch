-- Compiler contract documents can hold a checked AST by reference. The
-- legacy parser and printers remain the boundary for standalone JSON.
module Cinch.Document where

  import Cinch.PackedBody (PackedTerm, packed-term-json, same-packed-term)
  import Data.Json as Plain
  import Data.Machine (feq-f64)
  import Relation.Eq (Eq)
  import Text.Json as Legacy
  import Text.Parse (ParseOutcome, Parsed, Failed)

  export Json, JNull, JBool, JNum, JFloat, JStr, JArr, JObj, JArrEnd, JObjEnd, JTerm, Eq_Json
  export parse-json, ordered-json-bytes, canonical-json, canonical-bytes, json-eq, term-document

  data Json where
    JNull :: Json
    JBool :: Bool -> Json
    JNum :: Int -> Json
    JFloat :: F64 -> Json
    JStr :: String -> Json
    JArr :: Json -> Json -> Json
    JObj :: String -> Json -> Json -> Json
    JArrEnd :: Json
    JObjEnd :: Json
    JTerm :: PackedTerm -> Json

  from-json :: Plain.Json -> Json
  from-json value = case value of
    Plain.JNull -> JNull
    Plain.JBool yes -> JBool yes
    Plain.JNum number -> JNum number
    Plain.JFloat number -> JFloat number
    Plain.JStr text -> JStr text
    Plain.JArr first rest -> JArr (from-json first) (from-json rest)
    Plain.JObj key item rest -> JObj key (from-json item) (from-json rest)
    Plain.JArrEnd -> JArrEnd
    Plain.JObjEnd -> JObjEnd

  to-json :: Json -> Plain.Json
  to-json value = case value of
    JNull -> Plain.JNull
    JBool yes -> Plain.JBool yes
    JNum number -> Plain.JNum number
    JFloat number -> Plain.JFloat number
    JStr text -> Plain.JStr text
    JArr first rest -> Plain.JArr (to-json first) (to-json rest)
    JObj key item rest -> Plain.JObj key (to-json item) (to-json rest)
    JArrEnd -> Plain.JArrEnd
    JObjEnd -> Plain.JObjEnd
    JTerm term -> packed-term-json term

  term-document :: PackedTerm -> Json
  term-document term = from-json (packed-term-json term)

  parse-json :: String -> Bytes -> ParseOutcome Json
  parse-json path bytes = case Legacy.parse-json path bytes of
    Parsed value diagnostics -> Parsed (from-json value) diagnostics
    Failed error -> Failed error

  ordered-json-bytes :: Json -> Bytes
  ordered-json-bytes value = Legacy.ordered-json-bytes (to-json value)

  canonical-json :: Json -> String
  canonical-json value = Legacy.canonical-json (to-json value)

  canonical-bytes :: Json -> Bytes
  canonical-bytes value = Legacy.canonical-bytes (to-json value)

  json-eq :: Json -> Json -> Bool
  json-eq first second = case (first, second) of
    (JNull, JNull) -> True
    (JBool left, JBool right) -> left == right
    (JNum left, JNum right) -> left == right
    (JFloat left, JFloat right) -> feq-f64 left right
    (JStr left, JStr right) -> left == right
    (JArr left more, JArr right rest) -> json-eq left right && json-eq more rest
    (JObj key left more, JObj field right rest) -> key == field && json-eq left right && json-eq more rest
    (JArrEnd, JArrEnd) -> True
    (JObjEnd, JObjEnd) -> True
    (JTerm left, JTerm right) -> same-packed-term left right || Legacy.json-eq (packed-term-json left) (packed-term-json right)
    (JTerm term, other) -> Legacy.json-eq (packed-term-json term) (to-json other)
    (other, JTerm term) -> Legacy.json-eq (to-json other) (packed-term-json term)
    other -> False

  implicit instance Eq_Json :: Eq Json where
    (==) a b = json-eq a b
    (/=) a b = not (json-eq a b)
