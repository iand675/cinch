-- Checked schema 10 interface production. Every public spelling is matched
-- against a retained checked binding or defining data declaration.
module Bootstrap.Export where
  import Bootstrap.Builtin (array-plan, mvar-plan, total-primitive, scalar-intrinsic)
  import Algebra.Semigroup
  import Bootstrap.Check (CheckedProgram, checked-elaboration, checked-surface)
  import Bootstrap.Ast (Program, Module, Decl, TypeExpr, module-decls, program-modules, DClass, DInstance, DForeign, DExternal, DRefine, DRecord, DCodata, DEffect, DLaw, decls-of, source-clauses-document, source-law-document, portable-law-syntax, qualify-default-clauses, TName, TApp, TArg, TArgsEnd)
  import Bootstrap.Infer (guarded-members, source-method-symbol, source-conditional-head, Elaboration, elaboration-bindings, elaboration-core, elaboration-data, elaboration-effects, elaboration-contexts, elaboration-classes, elaboration-instances, elaboration-declarations, elaboration-law-observations, elaboration-rewrite-assumptions, CheckedBinding, checked-name, checked-scheme, checked-role, checked-method-matches, checked-body-binding, checked-foreign-plan, checked-c-export, checked-intrinsic-symbol, scalar-promise-matches, source-class-default-symbol, source-class-default-clauses, portable-default-export-global)
  import Bootstrap.Unpack (unpacked-abi)
  import Bootstrap.Core (CoreEffect, core-effect-name, CoreData, DataLayout, UniformData, UnboxedData, TransparentData, UnpackedRecord, core-data-layout, CoreConstructor, CoreDefinition, core-data-name, core-data-params, core-data-constructors, core-constructor-name, core-constructor-scheme, core-name, core-scheme, core-method-total-function, core-definition-closed)
  import Bootstrap.Typing (task-source-forwarder, task-forwarder-type)
  import Bootstrap.Core (CoreTerm, CLocal, CUse, CApply, CApplyEff, CRequire, CDischarge, CorePattern, CPVar, CPWild, MkCoreClause, core-clauses)
  import Bootstrap.Guarded (check-guarded-binding)
  import Bootstrap.Instance
  import Bootstrap.Type
  import Bootstrap.Total (TotalFunction, total-identity, total-function-document, total-function-equal, total-parameters, total-result, total-source-projection)
  import Bootstrap.BodyContract (BodyBinding, binding-function, binding-scheme)
  import Bootstrap.ExportType
  import Bootstrap.Foreign (ForeignPlan, foreign-symbol, foreign-document, foreign-display-scheme, foreign-primitive-assumptions, primitive-object-callable, foreign-primitive-selection, foreign-primitive-total-op)
  import Bootstrap.ExportNominal
  import Bootstrap.Load (contract-intrinsic, LoadedInterface, loaded-module, loaded-hash, loaded-entry, loaded-contract, nominal-owner)
  import Bootstrap.Interface (fnv-source-hash, iface-schema-version)
  import Bootstrap.RuntimeAbi (runtime-abi-int)
  import Bootstrap.Document
  import Data.Nat (nat-from-int, nat-to-int)
  import Text.Lex (bytes-slice, Span)
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)

  export export-interfaces, export-interfaces-aliased, export-object-interfaces, interface-hash, build-manifest, build-profile-manifest, build-generated-manifest, checked-primitive-rows
  same :: String -> String -> Bool
  same a b = string-compare a b == 0
  field :: String -> Json -> Json
  field name doc = case doc of JObj key value rest -> if same name key then value else field name rest; other -> JNull
  text :: Json -> String
  text doc = case doc of JStr value -> value; other -> ""
  strings :: List String -> Json
  strings values = case values of Nil -> JArrEnd; Cons first rest -> JArr (JStr first) (strings rest)
  bools :: List Bool -> Json
  bools values = case values of Nil -> JArrEnd; Cons first rest -> JArr (JBool first) (bools rest)
  set-field :: String -> Json -> Json -> Json
  set-field key value doc = case doc of
    JObj name old rest -> if same key name then JObj name value rest else JObj name old (set-field key value rest)
    other -> JObj key value JObjEnd
  find-binding :: String -> List CheckedBinding -> Option CheckedBinding
  find-binding name rows = case rows of Nil -> None; Cons row rest -> if same name (checked-name row) then Some row else find-binding name rest
  find-data :: String -> List CoreData -> Option CoreData
  find-data name rows = case rows of Nil -> None; Cons row rest -> if same name (core-data-name row) then Some row else find-data name rest
  public-name :: String -> Json -> Option String
  public-name symbol rows = case rows of
    JArr row rest -> if same symbol (text (field "symbol" row)) then Some (text (field "name" row)) else public-name symbol rest
    other -> None
  insert-row :: String -> Json -> Json -> Json
  insert-row key row rows = case rows of
    JArr first rest -> if string-compare (text (field key row)) (text (field key first)) < 0 then JArr row rows else JArr first (insert-row key row rest)
    other -> JArr row JArrEnd
  sort-rows :: String -> Json -> Json
  sort-rows key rows = case rows of JArr row rest -> insert-row key row (sort-rows key rest); other -> JArrEnd
  append :: Json -> Json -> Json
  append first second = case first of JArr row rest -> JArr row (append rest second); other -> second
  resolved-basic-scheme :: Elaboration -> List LoadedInterface -> Scheme -> Result String Json
  resolved-basic-scheme typed interfaces scheme = case (export-scheme scheme, scheme-nominals scheme (elaboration-declarations typed) (elaboration-data typed) (elaboration-classes typed) interfaces) of
    (Ok spelling, Ok nominals) -> Ok (JObj "scheme" (JStr spelling) (JObj "nominals" nominals (JObj "measures" JArrEnd JObjEnd)))
    (Err error, other) -> Err error
    (other, Err error) -> Err error
  -- Traverse the checked type, including kinds and dictionary requirements.
  -- Only actual UIndexCall graphs create measure dependencies; names carry no
  -- authority. Match the graph against the retained defining body association.
  type-measures :: UType -> List TotalFunction
  type-measures ty = case ty of
    UIndexConstructor name arrow input -> type-measures arrow <> type-measures input
    UIndexList element fields -> type-measures element <> type-measures fields
    UIndexCall function args -> Cons function (type-measures args)
    UCon name kind -> kind-measures kind
    UBound id name kind -> kind-measures kind
    URigid id name level kind -> kind-measures kind
    UMeta id kind -> kind-measures kind
    UIndex carrier term -> type-measures carrier
    UIndexForget input -> type-measures input
    UIndexPromote input -> type-measures input
    UIndexByteLength input -> type-measures input
    UIndexMeasure measure input -> type-measures input
    UIndexStringLength input -> type-measures input
    UIndexBorrowRead input -> type-measures input
    UIndexMath operation a b -> type-measures a <> type-measures b
    UCompare relation a b -> type-measures a <> type-measures b
    UPropAnd a b -> type-measures a <> type-measures b
    UPropOr a b -> type-measures a <> type-measures b
    UPropNot input -> type-measures input
    UPropNonZero input -> type-measures input
    UPropNotNull input -> type-measures input
    UPropAscii input -> type-measures input
    UPropOrdered input -> type-measures input
    UPropNonZeroPending input -> type-measures input
    URequire predicates body -> type-measures predicates <> type-measures body
    URefine id name carrier predicate -> type-measures carrier <> type-measures predicate
    URefineFormer name ids body -> type-measures body
    UPi id name domain row result -> type-measures domain <> type-measures row <> type-measures result
    UApp a b -> type-measures a <> type-measures b
    UFun a b -> type-measures a <> type-measures b
    UFunEff a row b -> type-measures a <> type-measures row <> type-measures b
    UUsageArrow usage arrow -> type-measures arrow
    UProofFun a row b -> type-measures a <> type-measures row <> type-measures b
    URow labels -> type-measures labels
    URowJoin a b -> type-measures a <> type-measures b
    UTuple fields -> type-measures fields
    UArg a b -> type-measures a <> type-measures b
    other -> Nil
  kind-measures :: Kind -> List TotalFunction
  kind-measures kind = case kind of
    KValue carrier -> type-measures carrier
    KFun a b -> kind-measures a <> kind-measures b
    other -> Nil
  parameter-measures :: List Quant -> List TotalFunction
  parameter-measures parameters = case parameters of Nil -> Nil; Cons parameter rest -> kind-measures (quant-kind parameter) <> parameter-measures rest
  requirement-measures :: List Requirement -> List TotalFunction
  requirement-measures requirements = case requirements of Nil -> Nil; Cons requirement rest -> type-measures (requirement-type requirement) <> requirement-measures rest
  scheme-measures :: Scheme -> List TotalFunction
  scheme-measures scheme = parameter-measures (scheme-params scheme) <> requirement-measures (scheme-requirements scheme) <> type-measures (scheme-body scheme)
  measure-binding :: TotalFunction -> List CheckedBinding -> Option BodyBinding
  measure-binding function bindings = case bindings of
    Nil -> None
    Cons first rest -> case checked-body-binding first of
      Some body -> if total-function-equal function (binding-function body) then Some body else measure-binding function rest
      None -> measure-binding function rest
  measure-rows :: Elaboration -> List LoadedInterface -> List String -> List TotalFunction -> Result String Json
  measure-rows typed interfaces seen functions = case functions of
    Nil -> Ok JArrEnd
    Cons function rest -> let identity = total-identity function in
      if measure-seen identity seen then measure-rows typed interfaces seen rest else
        case measure-binding function (elaboration-bindings typed) of
          None -> Err ("measure has no checked defining body: " <> identity)
          Some binding -> case (resolved-basic-scheme typed interfaces (binding-scheme binding), measure-rows typed interfaces (Cons identity seen) rest) of
            (Ok resolved, Ok more) -> (case scheme-measures (binding-scheme binding) of
              Nil -> Ok (insert-row "identity" (JObj "identity" (JStr identity) (JObj "resolved" resolved (JObj "total_body" (total-function-document function) JObjEnd))) more)
              other -> Err "a measure signature cannot depend on another observation")
            (Err error, other) -> Err error
            (other, Err error) -> Err error
  measure-seen :: String -> List String -> Bool
  measure-seen identity seen = case seen of Nil -> False; Cons first rest -> same identity first || measure-seen identity rest
  resolved-scheme :: Elaboration -> List LoadedInterface -> Scheme -> Result String Json
  resolved-scheme typed interfaces scheme = case (resolved-basic-scheme typed interfaces scheme, measure-rows typed interfaces Nil (scheme-measures scheme)) of
    (Ok resolved, Ok measures) -> Ok (set-field "measures" measures resolved)
    (Err error, other) -> Err error
    (other, Err error) -> Err error
  value-total-body :: CheckedBinding -> Json
  value-total-body binding = case checked-body-binding binding of
    Some body -> if total-source-projection (binding-function body) then JNull else total-function-document (binding-function body)
    None -> case checked-intrinsic-symbol binding of
      Some symbol -> case export-global (checked-name binding) of
        Ok identity -> total-op-body identity (total-primitive symbol) (checked-scheme binding)
        Err error -> JNull
      None -> case checked-foreign-plan binding of
        Some plan -> case export-global (checked-name binding) of
          Ok identity -> total-op-body identity (foreign-primitive-total-op plan) (checked-scheme binding)
          Err error -> JNull
        None -> JNull
  -- A plain first-order carrier sort: the only sorts a total body has.
  total-carrier :: UType -> Option String
  total-carrier ty = case ty of
    UCon name KType -> if same name "Nat" || same name "Int" || same name "I64" || same name "Bool" || same name "Bytes" then Some name else None
    other -> None
  -- The arrow chain a closed total body can stand for: pure arrows over
  -- plain carrier sorts. A refinement, an effect row or a binder has none.
  total-arrow :: UType -> Option (List String, String)
  total-arrow ty = case ty of
    UFun domain result -> (case (total-carrier domain, total-arrow result) of
      (Some first, Some (rest, final)) -> Some (Cons first rest, final)
      other -> None)
    other -> (case total-carrier ty of Some sort -> Some (Nil, sort); None -> None)
  same-sorts :: List String -> List String -> Bool
  same-sorts actual expected = case (actual, expected) of
    (Nil, Nil) -> True
    (Cons first rest, Cons other more) -> same first other && same-sorts rest more
    other -> False
  sort-list :: List String -> Json
  sort-list sorts = case sorts of
    Nil -> JArrEnd
    Cons first rest -> JArr (JStr first) (sort-list rest)
  local-slots :: Nat -> Nat -> Json
  local-slots index count = if index >= count then JArrEnd else JArr (JObj "node" (JStr "local") (JObj "slot" (JNum (nat-to-int index)) JObjEnd)) (local-slots (index + 1) count)
  primitive-total-document :: String -> String -> List String -> String -> Json
  primitive-total-document identity operation parameters result = JObj "version" (JNum 1)
    (JObj "definitions" (JArr (JObj "identity" (JStr identity)
      (JObj "parameters" (sort-list parameters) (JObj "result" (JStr result)
        (JObj "body" (JObj "node" (JStr "primitive") (JObj "operation" (JStr operation)
          (JObj "arguments" (local-slots 0 (list-length parameters)) JObjEnd))) JObjEnd)))) JArrEnd) JObjEnd)
  -- An arithmetic intrinsic or inline comparison prim has an executable total
  -- body of its own: the operation applied to its own parameters. It is granted
  -- only when the checked scheme is exactly that operation's plain first-order
  -- signature, so no refinement, effect or binder disappears through a
  -- base-sort projection.
  total-op-body :: String -> Option (String, List String, String) -> Scheme -> Json
  total-op-body identity candidate scheme = case candidate of
    None -> JNull
    Some (operation, parameters, result) ->
      if not (case scheme-params scheme of Nil -> True; other -> False)
        || not (case scheme-requirements scheme of Nil -> True; other -> False) then JNull
      else case total-arrow (scheme-body scheme) of
        Some (actual, final) -> if same-sorts actual parameters && same final result then primitive-total-document identity operation parameters result else JNull
        None -> JNull
  resolved-source-scheme :: Elaboration -> List LoadedInterface -> DeclarationReferences -> String -> Scheme -> Result String Json
  resolved-source-scheme typed interfaces references symbol scheme = case (resolved-scheme typed interfaces scheme, binding-refinements (elaboration-declarations typed) references symbol) of
    (Ok resolved, Ok refinements) -> (case merge-nominals refinements (field "nominals" resolved) of
      Ok rows -> Ok (set-field "nominals" rows resolved)
      Err error -> Err error)
    (Err error, other) -> Err error
    (other, Err error) -> Err error
  refinement-alias :: List Decl -> String -> Bool
  refinement-alias declarations name = case declarations of
    Nil -> False
    Cons (DRefine s n params binder predicate) rest -> if same n name then True else refinement-alias rest name
    Cons other rest -> refinement-alias rest name
  spellings-text :: List String -> String
  spellings-text words = case words of
    Nil -> ""
    Cons first Nil -> first
    Cons first rest -> string-concat-all [first, " ", spellings-text rest]
  spelling-args :: TypeExpr -> Option (List String)
  spelling-args ty = case ty of
    TArgsEnd s -> Some Nil
    TArg at first rest -> (case (source-spelling-type first, spelling-args rest) of
      (Some first-text, Some more) -> Some (Cons first-text more)
      other -> None)
    other -> None
  source-spelling-type :: TypeExpr -> Option String
  source-spelling-type ty = case ty of
    TName s name -> Some name
    TApp s (TName at name) args -> (case spelling-args args of
      Some words -> Some (applicative-text name words)
      None -> None)
    other -> None
  applicative-text :: String -> List String -> String
  applicative-text name words = case words of
    Nil -> name
    other -> string-concat-all ["(", name, " ", (spellings-text words), ")"]
  alias-source-spelling :: Elaboration -> List LoadedInterface -> DeclarationReferences -> String -> Scheme -> Option String
  alias-source-spelling typed interfaces references symbol scheme =
    if list-length (scheme-params scheme) == 0 && list-length (scheme-requirements scheme) == 0 then
      (case binding-source-type references symbol of
        Some (TName s name) -> public-alias-name typed interfaces name
        Some applied -> (case applied of
          TApp at (TName hspan head-name) args -> (case (public-alias-name typed interfaces head-name, spelling-args args) of
            (Some identity, Some words) -> Some (applicative-text identity words)
            other -> None)
          other -> None)
        None -> None)
    else None
  public-alias-name :: Elaboration -> List LoadedInterface -> String -> Option String
  public-alias-name typed interfaces name =
    if refinement-alias (elaboration-declarations typed) name then (case export-global name of
      Ok public -> Some public
      Err error -> interface-alias-identity interfaces name)
    else interface-alias-identity interfaces name
  interface-alias-identity :: List LoadedInterface -> String -> Option String
  interface-alias-identity interfaces name = case interfaces of
    Nil -> None
    Cons first rest -> (case refinement-type-row (field "types" (field "exports" (loaded-contract first))) name of
      Some identity -> Some identity
      None -> interface-alias-identity rest name)
  refinement-type-row :: Json -> String -> Option String
  refinement-type-row rows name = case rows of
    JArr row rest -> (case (field "name" row, field "identity" row, field "kind" row) of
      (JStr actual, JStr identity, JStr kind) -> if same kind "refinement" && (same actual name || same actual (last-name (unpack name) Nil)) then Some identity else refinement-type-row rest name
      other -> refinement-type-row rest name)
    JArrEnd -> None
    other -> None
  resolved-value-scheme :: Elaboration -> List LoadedInterface -> DeclarationReferences -> String -> Scheme -> Result String Json
  resolved-value-scheme typed interfaces references symbol scheme = case alias-source-spelling typed interfaces references symbol scheme of
    Some spelled -> case resolved-source-scheme typed interfaces references symbol scheme of
      Ok resolved -> Ok (set-field "scheme" (JStr spelled) resolved)
      Err error -> if same error source-effect-contract then Ok JNull else Err error
    None -> case export-resolved-value-scheme scheme of
      Ok None -> Ok JNull
      Ok (Some spelling) -> case resolved-source-scheme typed interfaces references symbol scheme of
        Ok resolved -> Ok (set-field "scheme" (JStr spelling) resolved)
        Err error -> if same error source-effect-contract then Ok JNull else Err error
      Err error -> Err error
  imported-refinement-type :: List LoadedInterface -> String -> Option Json
  imported-refinement-type interfaces symbol = case export-global symbol of
    Err error -> None
    Ok identity -> defining-refinement-type interfaces identity
  defining-refinement-type :: List LoadedInterface -> String -> Option Json
  defining-refinement-type interfaces identity = case interfaces of
    Nil -> None
    Cons first rest -> case loaded-entry first "type" identity of
      Some row -> if same (text (field "kind" row)) "refinement" || same (text (field "kind" row)) "opaque" then Some row else defining-refinement-type rest identity
      None -> defining-refinement-type rest identity
  abstract-type-row :: String -> Json -> Json
  abstract-type-row name nominal = JObj "name" (JStr name)
    (JObj "identity" (field "identity" nominal) (JObj "kind" (field "kind" nominal)
      (JObj "params" (field "params" nominal) (JObj "parameters" (field "parameters" nominal)
        (JObj "ctors" JArrEnd (JObj "fields" JArrEnd (JObj "refinement" (field "refinement" nominal) JObjEnd)))))))
  -- Interface value arity counts source arrows, dictionaries and hidden
  -- value parameters. Proof arrows remain in this contract even though
  -- executable Core erases their runtime slots.
  quantified-value-arity :: List Quant -> Nat
  quantified-value-arity parameters = case parameters of
    Nil -> 0
    Cons first rest -> (case value-carrier (quant-kind first) of Some carrier -> 1; None -> 0) + quantified-value-arity rest
  interface-value-arity :: Scheme -> Nat
  interface-value-arity scheme = scheme-arity scheme + list-length (scheme-requirements scheme) + quantified-value-arity (scheme-params scheme)
  value-row :: Bool -> Bool -> Elaboration -> List LoadedInterface -> DeclarationReferences -> String -> String -> CheckedBinding -> Result String Json
  value-row require-worker alias-display typed interfaces references name symbol binding =
    if imported-symbol symbol then imported-value-row interfaces name symbol
    else if same (checked-role binding) "foreign" then foreign-value-row require-worker name symbol binding
    else if same (checked-role binding) "operation" then opaque-value-row name symbol binding
    else if same (checked-role binding) "function" || same (checked-role binding) "value" || same (checked-role binding) "intrinsic" || same (checked-role binding) "instance" || same (checked-role binding) "implicit-instance" then
      let scheme = checked-scheme binding in
      let arity = interface-value-arity scheme in
      if row-quantified (scheme-params scheme) then opaque-value-row name symbol binding else
      case (export-global symbol, resolved-value-scheme typed interfaces references symbol scheme, export-display-scheme scheme) of
        (Ok identity, Ok JNull, Ok spelling) -> opaque-value-row name symbol binding
        (Ok identity, Ok resolved, Ok spelling) -> Ok (JObj "name" (JStr name)
          (JObj "symbol" (JStr identity) (JObj "scheme" (JStr (value-display-spelling alias-display typed interfaces references symbol scheme spelling))
            (JObj "resolved" resolved (JObj "arity" (JNum (nat-to-int arity))
              (JObj "total_body" (value-total-body binding) JObjEnd))))))
        (Err error, other, more) -> Err error
        (other, Err error, more) -> Err error
        (other, more, Err error) -> Err error
    else Err (string-concat "unsupported checked value export category: " (checked-role binding))
  value-display-spelling :: Bool -> Elaboration -> List LoadedInterface -> DeclarationReferences -> String -> Scheme -> String -> String
  value-display-spelling alias-display typed interfaces references symbol scheme rendered = if not alias-display then rendered else case alias-source-spelling typed interfaces references symbol scheme of
    Some spelled -> spelled
    None -> rendered
  imported-symbol :: String -> Bool
  imported-symbol symbol = case unpack symbol of
    Cons prefix (Cons dot rest) -> char-code prefix == 105 && char-code dot == 46
    other -> False
  foreign-value-row :: Bool -> String -> String -> CheckedBinding -> Result String Json
  foreign-value-row require-worker name symbol binding = case checked-foreign-plan binding of
    None -> Err "foreign binding has no checked ABI plan"
    Some plan | (case foreign-primitive-assumptions plan of Some checked -> True; None -> False) ->
      if not require-worker || primitive-object-callable plan then opaque-value-row name symbol binding
      else Err "public inline primitive needs a checked uniform-word object entry"
    Some plan -> case (export-global symbol, foreign-display-scheme plan) of
      (Ok identity, Ok spelling) -> Ok (JObj "name" (JStr name) (JObj "symbol" (JStr identity)
        (JObj "scheme" (JStr spelling) (JObj "resolved" JNull (JObj "arity" (JNum (nat-to-int (interface-value-arity (checked-scheme binding)))) (JObj "total_body" JNull JObjEnd))))))
      (Err error, other) -> Err error
      (other, Err error) -> Err error
  imported-value :: String -> List LoadedInterface -> Option Json
  imported-value identity interfaces = case interfaces of
    Nil -> None
    Cons first rest -> case loaded-entry first "value" identity of Some row -> Some row; None -> imported-value identity rest
  -- An admitted imported value already has its defining scheme, arity and
  -- optional executable/measure contracts. Rename its public spelling only;
  -- reprinting a display scheme would discard those defining facts.
  imported-value-row :: List LoadedInterface -> String -> String -> Result String Json
  imported-value-row interfaces name symbol = case export-global symbol of
    Err error -> Err error
    Ok identity -> case imported-value identity interfaces of
      Some row -> Ok (set-field "name" (JStr name) row)
      None -> Err (string-concat "imported value has no admitted defining export: " identity)
  -- An open row cannot supply the closed portable effect contract. Keep the
  -- checked display scheme, as for an operation whose defining handler table
  -- is unavailable, and grant no resolved contract or executable body.
  row-kind :: Kind -> Bool
  row-kind kind = case kind of KRow -> True; KFun first rest -> row-kind first || row-kind rest; other -> False
  row-quantified :: List Quant -> Bool
  row-quantified parameters = case parameters of Nil -> False; Cons first rest -> row-kind (quant-kind first) || row-quantified rest
  opaque-value-row :: String -> String -> CheckedBinding -> Result String Json
  opaque-value-row name symbol binding = let scheme = checked-scheme binding in
    let arity = interface-value-arity scheme in
    case (export-global symbol, export-display-scheme scheme) of
      (Ok identity, Ok spelling) -> Ok (JObj "name" (JStr name)
        (JObj "symbol" (JStr identity) (JObj "scheme" (JStr spelling)
          (JObj "resolved" JNull (JObj "arity" (JNum (nat-to-int arity))
            (JObj "total_body" JNull JObjEnd))))))
      (Err error, other) -> Err error
      (other, Err error) -> Err error
  constructor-result :: UType -> UType
  constructor-result ty = case ty of UFun domain result -> constructor-result result; UFunEff domain effects result -> constructor-result result; UPi id name domain effects result -> constructor-result result; UProofFun predicate effects result -> constructor-result result; URequire predicates result -> constructor-result result; other -> ty
  constructor-id-member :: Nat -> List Nat -> Bool
  constructor-id-member id ids = case ids of Nil -> False; Cons first rest -> id == first || constructor-id-member id rest
  constructor-hidden-parameters :: List Quant -> List Nat -> Bool
  constructor-hidden-parameters parameters visible = case parameters of
    Nil -> False
    Cons first rest -> not (constructor-id-member (quant-id first) visible) || constructor-hidden-parameters rest visible
  constructor-row :: Elaboration -> List LoadedInterface -> DeclarationReferences -> String -> Nat -> String -> Scheme -> Result String Json
  constructor-row typed interfaces references name tag symbol scheme =
    let hidden = constructor-hidden-parameters (scheme-params scheme) (type-free-bound (constructor-result (scheme-body scheme))) in
    let resolved = if hidden then Ok JNull else resolved-value-scheme typed interfaces references symbol scheme in
    let (fields, spelling) = export-constructor-display hidden scheme in
    case (export-global symbol, fields, resolved, spelling) of
      (Ok identity, Ok fields, Ok resolved, Ok spelling) -> Ok (JObj "name" (JStr name)
        (JObj "symbol" (JStr identity) (JObj "tag" (JNum (nat-to-int tag))
          (JObj "scheme" (JStr spelling) (JObj "resolved" resolved
            (JObj "fields" (strings fields) (JObj "erased" (bools (constructor-field-erasure (scheme-body scheme))) JObjEnd)))))))
      (Err error, other, more, spelling) -> Err error
      (other, Err error, more, spelling) -> Err error
      (other, more, Err error, spelling) -> Err error
      (other, more, resolved, Err error) -> Err error
  constructor-rows :: Elaboration -> List LoadedInterface -> DeclarationReferences -> Json -> Nat -> List CoreConstructor -> Result String Json
  constructor-rows typed interfaces references surface tag constructors = case constructors of
    Nil -> Ok JArrEnd
    Cons first rest -> case public-name (core-constructor-name first) surface of
      None -> constructor-rows typed interfaces references surface (tag + 1) rest
      Some name -> case (constructor-row typed interfaces references name tag (core-constructor-name first) (core-constructor-scheme first), constructor-rows typed interfaces references surface (tag + 1) rest) of
        (Ok row, Ok more) -> Ok (JArr row more)
        (Err error, other) -> Err error
        (other, Err error) -> Err error
  record-label-rows :: List (String, TypeExpr) -> Json
  record-label-rows fields = case fields of
    Nil -> JArrEnd
    Cons (name, ty) rest -> JArr (JStr name) (record-label-rows rest)
  record-label-contract :: String -> List Decl -> Option Json
  record-label-contract symbol declarations = case declarations of
    Nil -> None
    Cons (DRecord sp owner params fields) rest ->
      if same symbol owner then Some (record-label-rows fields) else record-label-contract symbol rest
    Cons (DExternal sp owner category syntax metadata) rest ->
      if same symbol owner && same category "type" && same (text (field "kind" metadata)) "record" then
        Some (field "fields" metadata) else record-label-contract symbol rest
    Cons first rest -> record-label-contract symbol rest
  codata-label-contract :: String -> List Decl -> Option Json
  codata-label-contract owner declarations = case declarations of
    Nil -> None
    Cons (DCodata sp symbol params fields) rest ->
      if same owner symbol then Some (record-label-rows fields) else codata-label-contract owner rest
    Cons first rest -> codata-label-contract owner rest
  -- Only the checked observation result crosses the interface. The local
  -- storage thunk is reconstructed when the importing compiler elaborates it.
  observation-scheme-body :: Json -> UType -> Result String UType
  observation-scheme-body labels ty = case (labels, ty) of
    (JArr label rest, UFun (UFun (UCon unit KType) observation) result) ->
      if same unit "Unit" then
        (case observation-scheme-body rest result of
          Ok more -> Ok (UFun observation more)
          Err error -> Err error)
      else Err "codata observation storage does not take Unit"
    (JArrEnd, other) -> Ok other
    other -> Err "codata labels disagree with the checked observation scheme"
  codata-rows :: Elaboration -> List LoadedInterface -> DeclarationReferences -> String -> String -> Json -> List CoreConstructor -> Result String Json
  codata-rows typed interfaces references name owner labels constructors = case constructors of
    Cons constructor Nil ->
      let storage = core-constructor-scheme constructor in
      case observation-scheme-body labels (scheme-body storage) of
        Err error -> Err error
        Ok body -> case constructor-row typed interfaces references name 0 owner (qualified (scheme-params storage) (scheme-requirements storage) body) of
          Ok row -> Ok (JArr row JArrEnd)
          Err error -> Err error
    other -> Err "codata must have one checked observation layout"
  imported-codata-row :: List LoadedInterface -> String -> Option Json
  imported-codata-row interfaces identity = case interfaces of
    Nil -> None
    Cons first rest -> case loaded-entry first "type" identity of
      Some row -> if same (text (field "kind" row)) "codata" then Some row else imported-codata-row rest identity
      None -> imported-codata-row rest identity
  type-row :: Elaboration -> List LoadedInterface -> DeclarationReferences -> Json -> String -> CoreData -> Result String Json
  type-row typed interfaces references surface name declaration =
    let owner = core-data-name declaration in
    let declarations = elaboration-declarations typed in
    let constructors = core-data-constructors declaration in
    case export-global owner of
      Err error -> Err error
      Ok identity -> case imported-codata-row interfaces identity of
        Some row -> Ok (set-field "name" (JStr name) row)
        None -> case codata-label-contract owner declarations of
          Some labels -> build-type-row name "codata" labels (data-nominal declarations declaration) (codata-rows typed interfaces references name owner labels constructors)
          None -> case record-label-contract owner declarations of
            Some labels -> build-type-row name "record" labels (data-nominal declarations declaration) (constructor-rows typed interfaces references surface 0 constructors)
            None -> build-type-row name "data" JArrEnd (data-nominal declarations declaration) (constructor-rows typed interfaces references surface 0 constructors)
  build-type-row :: String -> String -> Json -> Result String Json -> Result String Json -> Result String Json
  build-type-row name kind labels nominal constructors = case (nominal, constructors) of
      (Ok nominal, Ok constructors) ->
        Ok (JObj "name" (JStr name)
        (JObj "identity" (field "identity" nominal) (JObj "kind" (JStr kind)
          (JObj "params" (field "params" nominal) (JObj "parameters" (field "parameters" nominal)
            (JObj "ctors" constructors (JObj "fields" labels (JObj "refinement" JNull
              (case field "usage" nominal of JArr first rest -> JObj "ownership" nominal JObjEnd; other -> JObjEnd)))))))))
      (Err error, other) -> Err error
      (other, Err error) -> Err error
  constructor-present :: String -> List CoreData -> Bool
  constructor-present symbol declarations = case declarations of
    Nil -> False
    Cons declaration rest -> constructors-have symbol (core-data-constructors declaration) || constructor-present symbol rest
  constructors-have :: String -> List CoreConstructor -> Bool
  constructors-have symbol constructors = case constructors of Nil -> False; Cons constructor rest -> same symbol (core-constructor-name constructor) || constructors-have symbol rest
  equation-method-present :: String -> List CoreClass -> Bool
  equation-method-present symbol classes = case classes of
    Nil -> False
    Cons description rest -> equation-methods-have symbol (class-methods description) || equation-method-present symbol rest
  equation-methods-have :: String -> List CoreClassMethod -> Bool
  equation-methods-have symbol methods = case methods of
    Nil -> False
    Cons member rest -> case class-method-equation member of
      Some (defining, equation) -> same symbol defining || equation-methods-have symbol rest
      None -> equation-methods-have symbol rest
  public-names :: String -> Json -> Json
  public-names symbol rows = case rows of
    JArr row rest -> if same symbol (text (field "symbol" row)) then insert-string (text (field "name" row)) (public-names symbol rest) else public-names symbol rest
    other -> JArrEnd
  method-names :: ExportIndex -> CoreClass -> CoreClassMethod -> Json -> Json
  method-names index description member surface = case class-method-equation member of
    Some (symbol, equation) -> public-names symbol surface
    None -> runtime-method-names index description member surface
  runtime-method-names :: ExportIndex -> CoreClass -> CoreClassMethod -> Json -> Json
  runtime-method-names index description member surface = case surface of
    JArr row rest -> let symbol = text (field "symbol" row) in
      (case indexed-binding symbol index of
        Some binding -> if checked-method-matches binding symbol (class-name description) (class-method-slot member) then
          insert-string (text (field "name" row)) (runtime-method-names index description member rest)
          else runtime-method-names index description member rest
        None -> runtime-method-names index description member rest)
    other -> JArrEnd
  defining-method-symbol :: List CheckedBinding -> String -> Nat -> Option String
  defining-method-symbol bindings owner slot = case bindings of
    Nil -> None
    Cons first rest -> if checked-method-matches first (checked-name first) owner slot then Some (checked-name first) else defining-method-symbol rest owner slot
  resolved-method-scheme :: Elaboration -> List LoadedInterface -> DeclarationReferences -> CoreClass -> CoreClassMethod -> Result String Json
  resolved-method-scheme typed interfaces references description member = case defining-method-symbol (elaboration-bindings typed) (class-name description) (class-method-slot member) of
    Some symbol -> resolved-value-scheme typed interfaces references symbol (class-method-scheme member)
    None -> case (resolved-scheme typed interfaces (class-method-scheme member), export-value-scheme (class-method-scheme member)) of
      (Ok resolved, Ok spelling) -> Ok (set-field "scheme" (JStr spelling) resolved)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
  admitted-method :: CoreClass -> CoreClassMethod -> List LoadedInterface -> Option Json
  admitted-method description member interfaces = case export-global (class-name description) of
    Err error -> None
    Ok owner -> case defining-signature owner interfaces of
      None -> None
      Some original -> defining-method (class-method-name member) (field "methods" original)
  method-rows :: Elaboration -> List LoadedInterface -> ExportIndex -> CoreClass -> Json -> List CoreClassMethod -> Result String Json
  method-rows typed interfaces index description surface methods = case methods of
    Nil -> Ok JArrEnd
    Cons member rest -> let slot = class-method-slot member in
      case method-rows typed interfaces index description surface rest of
        Err error -> Err error
        Ok more -> case admitted-method description member interfaces of
          Some original -> if (case field "slot" original of JNum actual -> actual == nat-to-int slot; other -> False) then
            Ok (JArr (set-field "exports" (method-names index description member surface) original) more)
            else Err "admitted class method disagrees with its checked slot"
          None -> case class-method-equation member of
            Some (symbol, equation) -> case export-equation-display (class-method-scheme member) equation of
              Ok display -> Ok (JArr (method-row index description member surface display JNull) more)
              Err error -> Err error
            None -> case resolved-method-scheme typed interfaces (indexed-references index) description member of
              Err error -> Err error
              Ok resolved -> case method-default typed description member interfaces
                  (method-row index description member surface (text (field "scheme" resolved)) resolved) of
                Err error -> Err error
                Ok row -> Ok (JArr row more)
  method-row :: ExportIndex -> CoreClass -> CoreClassMethod -> Json -> String -> Json -> Json
  method-row index description member surface display resolved =
    JObj "name" (JStr (class-method-name member))
      (JObj "slot" (JNum (nat-to-int (class-method-slot member)))
        (JObj "exports" (method-names index description member surface)
          (JObj "scheme" (JStr display) (JObj "resolved" resolved JObjEnd))))
  methods-public :: Json -> Bool
  methods-public rows = case rows of
    JArr row rest -> (case field "exports" row of JArr name more -> True; other -> False) || methods-public rest
    other -> False
  last-name :: List Char -> List Char -> String
  last-name chars reversed = case chars of Nil -> pack (reverse reversed); Cons c rest -> last-name rest (if char-code c == 46 then Nil else Cons c reversed)
  defining-signature :: String -> List LoadedInterface -> Option Json
  defining-signature identity interfaces = case interfaces of Nil -> None; Cons first rest -> case loaded-entry first "signature" identity of Some row -> Some row; None -> defining-signature identity rest
  defining-method :: String -> Json -> Option Json
  defining-method name methods = case methods of JArr row rest -> if same name (text (field "name" row)) then Some row else defining-method name rest; other -> None
  default-definition :: String -> List CoreDefinition -> Option CoreDefinition
  default-definition name definitions = case definitions of
    Nil -> None
    Cons first rest -> if same name (core-name first) then Some first else default-definition name rest
  method-default :: Elaboration -> CoreClass -> CoreClassMethod -> List LoadedInterface -> Json -> Result String Json
  method-default typed description member interfaces row = case source-class-default-clauses description member (elaboration-declarations typed) of
    Some clauses -> (case default-definition (source-class-default-symbol description member) (elaboration-core typed) of
      Some definition -> if core-definition-closed definition && scheme-equivalent (core-scheme definition) (class-method-scheme member) then
        let globals = portable-default-export-global (elaboration-bindings typed) (elaboration-classes typed) in
        Ok (set-field "default" (qualify-default-clauses globals (source-clauses-document clauses)) row)
        else Err "source class default lacks its closed defining method contract"
      None -> Err "source class default has no checked definition")
    None -> (case export-global (class-name description) of
      Err error -> Err error
      Ok identity -> case defining-signature identity interfaces of
        None -> Ok row
        Some source -> case defining-method (class-method-name member) (field "methods" source) of
          None -> Ok row
          Some original -> case field "default" original of
            JArr first rest -> Ok (set-field "default" (JArr first rest) row)
            other -> Ok row)
  -- Record referenced signatures once for each published contract.
  nominal-signatures :: Json -> HashMap String () -> HashMap String ()
  nominal-signatures doc found = case doc of
    JObj key value rest ->
      let nested = nominal-signatures value found in
      let is-signature = (same key "identity" || same key "kind") && same "signature" (text (field "kind" doc)) in
      let more = if is-signature then hash-map-insert (text (field "identity" doc)) () nested else nested in
      nominal-signatures rest more
    JArr row rest -> nominal-signatures rest (nominal-signatures row found)
    other -> found
  has-signature-identity :: String -> HashMap String () -> Bool
  has-signature-identity identity rows = case hash-map-lookup identity rows of Some present -> True; None -> False
  has-public-method :: ExportIndex -> CoreClass -> Json -> List CoreClassMethod -> Bool
  has-public-method index description surface methods = case methods of
    Nil -> False
    Cons member rest -> (case method-names index description member surface of JArr name more -> True; other -> False) || has-public-method index description surface rest
  signature-needed :: ExportIndex -> CoreClass -> String -> Json -> HashMap String () -> Bool
  signature-needed index description identity surface needed =
    has-signature-identity identity needed
    || (case public-names (class-name description) surface of JArr name more -> True; other -> False)
    || has-public-method index description surface (class-methods description)
  source-class-laws :: (String -> Option String) -> String -> List Decl -> Json
  source-class-laws globals owner declarations = case declarations of
    Nil -> JArrEnd
    Cons (DClass sp name parameters members) rest -> if same owner name then
      source-law-rows globals (decls-of members) else source-class-laws globals owner rest
    Cons other rest -> source-class-laws globals owner rest

  source-law-rows :: (String -> Option String) -> List Decl -> Json
  source-law-rows globals members = case members of
    Nil -> JArrEnd
    Cons (DLaw sp name syntax) rest ->
      let wire = qualify-default-clauses globals (source-law-document syntax) in
      let syntax = case portable-law-syntax sp (\name -> Some name) wire of Some checked -> wire; None -> JNull in
      JArr (JObj "name" (JStr name) (JObj "syntax" syntax JObjEnd)) (source-law-rows globals rest)
    Cons other rest -> source-law-rows globals rest

  admitted-signature-header :: String -> Json -> List LoadedInterface -> Json -> Json
  admitted-signature-header identity names interfaces row = case defining-signature identity interfaces of
    None -> row
    Some original -> set-field "exports" names (set-field "methods" (field "methods" row) original)
  data SignatureRows where
    MkSignatureRows :: Json -> HashMap String () -> HashMap String () -> SignatureRows
  signature-rows :: Elaboration -> List LoadedInterface -> ExportIndex -> Json -> Json -> Json -> List CoreClass -> Result String Json
  signature-rows typed interfaces index surface values types classes =
    let needed = nominal-signatures values (nominal-signatures types hash-map-empty) in
    signature-closure typed interfaces index surface classes classes (MkSignatureRows JArrEnd needed hash-map-empty)
  -- A retained private class can itself require another private class in a
  -- method contract. Keep the pass order that selects the first diagnostic.
  signature-closure :: Elaboration -> List LoadedInterface -> ExportIndex -> Json -> List CoreClass -> List CoreClass -> SignatureRows -> Result String Json
  signature-closure typed interfaces index surface fuel classes rows = case fuel of
    Nil -> case rows of MkSignatureRows contracts needed retained -> Ok contracts
    Cons first rest -> case signature-pass typed interfaces index surface classes rows of
      Err error -> Err error
      Ok (more, grew) -> if grew then signature-closure typed interfaces index surface rest classes more
        else (case more of MkSignatureRows contracts needed retained -> Ok contracts)
  -- Native's canonical signature order compares the display name first,
  -- then the defining identity. Dependency closure is keyed by identity,
  -- independently of this serialization order.
  insert-signature :: Json -> Json -> Json
  insert-signature row rows = case rows of
    JArr first rest -> let order = string-compare (text (field "name" row)) (text (field "name" first)) in
      if order < 0 || (order == 0 && string-compare (text (field "identity" row)) (text (field "identity" first)) < 0) then JArr row rows
      else JArr first (insert-signature row rest)
    other -> JArr row JArrEnd
  signature-pass :: Elaboration -> List LoadedInterface -> ExportIndex -> Json -> List CoreClass -> SignatureRows -> Result String (SignatureRows, Bool)
  signature-pass typed interfaces index surface classes rows = case classes of
    Nil -> Ok (rows, False)
    Cons description rest -> case rows of
      MkSignatureRows contracts needed retained -> case export-global (class-name description) of
          Err error -> Err error
          Ok identity -> if has-signature-identity identity retained || not (signature-needed index description identity surface needed) then
              signature-pass typed interfaces index surface rest rows
            else case (method-rows typed interfaces index description surface (class-methods description), export-parameters (class-params description)) of
              (Err error, other) -> Err error
              (other, Err error) -> Err error
              (Ok methods, Ok parameters) -> let names = public-names (class-name description) surface in
                let globals = portable-default-export-global (elaboration-bindings typed) (elaboration-classes typed) in
                let laws = source-class-laws globals (class-name description) (elaboration-declarations typed) in
                let row = admitted-signature-header identity names interfaces (JObj "name" (JStr (last-name (unpack identity) Nil))
                  (JObj "identity" (JStr identity) (JObj "exports" names (JObj "params" (parameter-names parameters)
                    (JObj "parameters" (parameter-json parameters) (JObj "methods" methods (JObj "laws" laws JObjEnd))))))) in
                let more-rows = MkSignatureRows (insert-signature row contracts) (nominal-signatures row needed) (hash-map-insert identity () retained) in
                case signature-pass typed interfaces index surface rest more-rows of
                  Err error -> Err error
                  Ok (more, grew) -> Ok (more, True)

  class-head :: UType -> Option String
  class-head ty = case ty of UCon name kind -> Some name; UApp f x -> class-head f; other -> None
  plain-method :: UType -> Bool
  plain-method ty = case ty of
    UFun a b -> plain-method b
    UFunEff a row b -> plain-method b
    UUsageArrow usage arrow -> plain-method arrow
    UPi id name domain row result -> plain-method result
    URequire predicates body -> False
    UProofFun predicate row result -> False
    other -> True
  instance-method-names :: String -> List CoreClassMethod -> List CoreDictionaryField -> Result String Json
  instance-method-names identity methods fields = case (methods, fields) of
    (Nil, Nil) -> Ok JArrEnd
    (Cons member rest, Cons implementation more) ->
      if class-method-slot member /= dictionary-field-slot implementation then Err "checked instance method slot differs from defining signature"
      else if not (plain-method (scheme-body (core-scheme (dictionary-field-definition implementation)))) then Err "preconditioned instance method export requires its checked callable contract"
      else (case instance-method-names identity rest more of
        Err error -> Err error
        Ok names -> Ok (JArr (JStr (string-concat-all [identity, ".", class-method-name member])) names))
    other -> Err "checked instance has an incomplete defining method table"
  retained-body-bindings :: List CheckedBinding -> List BodyBinding
  retained-body-bindings bindings = case bindings of
    Nil -> Nil
    Cons first rest -> case checked-body-binding first of Some body -> Cons body (retained-body-bindings rest); None -> retained-body-bindings rest
  plain-total-sort :: UType -> Bool
  plain-total-sort ty = case ty of UCon name KType -> same name "Nat" || same name "Int" || same name "Bool" || same name "Bytes" || same name "I64"; other -> False
  plain-total-method-type :: UType -> Bool
  plain-total-method-type ty = case ty of
    UFun domain result -> plain-total-sort domain && plain-total-method-type result
    UFunEff domain (URow UEnd) result -> plain-total-sort domain && plain-total-method-type result
    other -> plain-total-sort ty
  total-method-declaration :: List String -> String -> String
  total-method-declaration parameters result = case parameters of Nil -> result; Cons first rest -> string-concat-all ["(", first, " -> ", total-method-declaration rest result, ")"]
  actual-method-selector :: String -> Nat -> String -> List CheckedBinding -> String
  actual-method-selector owner slot fallback bindings = case bindings of
    Nil -> fallback
    Cons first rest -> if checked-method-matches first (checked-name first) owner slot then
      (case export-global (checked-name first) of Ok actual -> actual; Err error -> fallback)
      else actual-method-selector owner slot fallback rest
  instance-method-table :: Elaboration -> String -> String -> String -> List CoreClassMethod -> List CoreDictionaryField -> List (Nat, String, String, CoreDefinition)
  instance-method-table typed owner identity declaring methods fields = case (methods, fields) of
    (Cons member rest, Cons implementation more) -> if class-method-slot member /= dictionary-field-slot implementation then Nil else
      Cons (class-method-slot member,
        actual-method-selector owner (class-method-slot member) (string-concat-all [declaring, ".", class-method-name member]) (elaboration-bindings typed),
        string-concat-all [identity, ".", class-method-name member], dictionary-field-definition implementation)
        (instance-method-table typed owner identity declaring rest more)
    other -> Nil
  instance-method-bodies :: Elaboration -> CoreInstance -> String -> List (Nat, String, String, CoreDefinition) -> List (Nat, String, String, CoreDefinition) -> Json
  instance-method-bodies typed declaration owner all remaining = case remaining of
    Cons (slot, selector, native, definition) rest ->
      let more = instance-method-bodies typed declaration owner all rest in
      if not (plain-total-method-type (scheme-body (core-scheme definition))) then more else
        (case core-method-total-function (retained-body-bindings (elaboration-bindings typed)) (elaboration-core typed)
          (instance-name declaration) owner (instance-scheme declaration) all slot of
          Some function -> JArr (JObj "slot" (JNum (nat-to-int slot))
            (JObj "implementation" (JStr native)
              (JObj "resolved" (JObj "scheme" (JStr (total-method-declaration (total-parameters function) (total-result function)))
                (JObj "nominals" JArrEnd (JObj "measures" JArrEnd JObjEnd)))
                (JObj "total_body" (total-function-document function) JObjEnd)))) more
          None -> more)
    other -> JArrEnd
  with-instance-method-bodies :: Json -> Json -> Json
  with-instance-method-bodies bodies row = case bodies of JArrEnd -> row; other -> set-field "method_bodies" bodies row
  instance-row :: Elaboration -> List LoadedInterface -> DeclarationReferences -> CoreInstance -> Result String Json
  instance-row typed interfaces references declaration = let scheme = instance-scheme declaration in
    case class-head (scheme-body scheme) of
      None -> Err "checked instance has no defining signature head"
      Some owner -> case find-class owner (elaboration-classes typed) of
        None -> Err "checked instance has no defining signature contract"
        Some description -> case (export-global (instance-name declaration), export-global owner, resolved-source-scheme typed interfaces references (instance-name declaration) scheme, export-instance-scheme scheme) of
          (Ok identity, Ok declaring, Ok resolved, Ok (head, context, spelling)) -> case instance-method-names identity (class-methods description) (instance-fields declaration) of
            Err error -> Err error
            Ok methods -> let table = instance-method-table typed owner identity declaring (class-methods description) (instance-fields declaration) in
              let bodies = case context of Nil -> instance-method-bodies typed declaration owner table table; other -> JArrEnd in
              Ok (with-instance-method-bodies bodies
              (JObj "id" (JStr identity) (JObj "class" (JStr declaring)
                (JObj "target" (JStr head) (JObj "resolved" (set-field "scheme" (JStr spelling) resolved) (JObj "ctx" (strings context)
                  (JObj "methods" methods (JObj "method_contracts" JArrEnd (JObj "implicit" (JBool (instance-implicit declaration)) JObjEnd)))))))))
          (Err error, other, more, forms) -> Err error
          (other, Err error, more, forms) -> Err error
          (other, more, Err error, forms) -> Err error
          (other, more, resolved, Err error) -> Err error
  guarded-argument :: Nat -> Nat -> List CorePattern -> Option Json
  guarded-argument id slot patterns = case patterns of
    Cons (CPVar sp ty binder name) rest -> if id == binder then
      Some (JObj "node" (JStr "argument") (JObj "slot" (JNum (nat-to-int slot)) JObjEnd))
      else guarded-argument id (slot + 1) rest
    Cons (CPWild sp ty) rest -> guarded-argument id (slot + 1) rest
    other -> None
  -- Resolve the checked callee's defining foreign record, including its
  -- module. A source function with the same spelling supplies no equation.
  imported-nat-subtract :: String -> List LoadedInterface -> Bool
  imported-nat-subtract identity interfaces = case interfaces of
    Nil -> False
    Cons iface rest -> (case contract-intrinsic identity (loaded-module iface) (loaded-contract iface) of
      Some symbol -> same symbol "cinch.runtime.natSub"
      None -> imported-nat-subtract identity rest)
  guarded-expression :: List LoadedInterface -> List CorePattern -> Nat -> CoreTerm -> Option Json
  guarded-expression interfaces patterns depth term = if depth > 64 then None else case term of
    CLocal sp ty id name Nil -> guarded-argument id 0 patterns
    CRequire sp ty body -> guarded-expression interfaces patterns depth body
    CDischarge sp ty evidence _ body -> guarded-expression interfaces patterns depth body
    CApply sp ty inner second -> guarded-application interfaces patterns depth inner second
    CApplyEff sp ty row inner second -> guarded-application interfaces patterns depth inner second
    other -> None
  guarded-application :: List LoadedInterface -> List CorePattern -> Nat -> CoreTerm -> CoreTerm -> Option Json
  guarded-application interfaces patterns depth inner second = case inner of
    CApply sp ty callee first -> guarded-subtraction interfaces patterns depth callee first second
    CApplyEff sp ty row callee first -> guarded-subtraction interfaces patterns depth callee first second
    other -> None
  guarded-subtraction :: List LoadedInterface -> List CorePattern -> Nat -> CoreTerm -> CoreTerm -> CoreTerm -> Option Json
  guarded-subtraction interfaces patterns depth callee first second = case callee of
    CUse sp ty name role Nil -> if (same role "intrinsic" && same name "cinch.runtime.natSub") ||
      (same role "external" && (case export-global name of Ok identity -> imported-nat-subtract identity interfaces; Err error -> False)) then
        (case (guarded-expression interfaces patterns (depth + 1) first, guarded-expression interfaces patterns (depth + 1) second) of
          (Some left, Some right) -> Some (JObj "node" (JStr "nat-subtract") (JObj "left" left (JObj "right" right JObjEnd)))
          other -> None)
      else None
    other -> None
  guarded-parameters :: List CorePattern -> Option Nat
  guarded-parameters patterns = case patterns of
    Nil -> Some 0
    Cons pattern rest -> (case pattern of
      CPVar sp ty id name -> guarded-remaining ty rest
      CPWild sp ty -> guarded-remaining ty rest
      other -> None)
  guarded-remaining :: UType -> List CorePattern -> Option Nat
  guarded-remaining ty rest = case ty of
    UCon name KType | same name "Nat" -> (case guarded-parameters rest of Some n -> Some (n + 1); None -> None)
    other -> None
  with-guarded-body :: List LoadedInterface -> String -> CoreDefinition -> Json -> Json
  with-guarded-body interfaces identity definition implementation = case core-clauses definition of
    Cons (MkCoreClause sp patterns body) Nil -> (case (guarded-parameters patterns, guarded-expression interfaces patterns 0 body) of
      (Some count, Some root) -> let doc = JObj "schema" (JNum 1) (JObj "parameters" (JNum (nat-to-int count)) (JObj "root" root JObjEnd)) in
        (case check-guarded-binding (core-name definition) identity (core-scheme definition) doc of
          Some verified -> set-field "body" doc implementation
          None -> implementation)
      other -> implementation)
    other -> implementation
  source-method-contracts :: Elaboration -> List LoadedInterface -> DeclarationReferences -> Json -> String -> List CoreClassMethod -> Result String (Json, Json)
  source-method-contracts typed interfaces references head identity methods = case methods of
    Nil -> Ok (JArrEnd, JArrEnd)
    Cons member rest -> let name = class-method-name member in let symbol = source-method-symbol identity name in
      let native = string-concat-all [identity, ".", name] in
      (case (default-definition symbol (elaboration-core typed), source-method-contracts typed interfaces references head identity rest) of
        (Some definition, Ok (names, contracts)) -> let actual = core-scheme definition in
          if plain-method (scheme-body actual) then Ok (JArr (JStr native) names, contracts)
          else (case (resolved-value-scheme typed interfaces references symbol actual, export-display-scheme actual) of
            (Ok resolved, Ok spelling) -> let implementation = with-guarded-body interfaces native definition (JObj "identity" (JStr native) (JObj "resolved" resolved JObjEnd)) in
              let checked = JObj "schema" (JNum 1) (JObj "head" (JObj "resolved" head JObjEnd) (JObj "implementation" implementation JObjEnd)) in
              Ok (JArr (JStr native) names, JArr (JObj "name" (JStr name) (JObj "slot" (JNum (nat-to-int (class-method-slot member)))
                (JObj "scheme" (JStr spelling) (JObj "checked" checked JObjEnd)))) contracts)
            (Err error, other) -> Err error
            (other, Err error) -> Err error)
        (None, other) -> Err "conditional implementation has no checked definition"
        (other, Err error) -> Err error)
  conditional-instance-row :: Elaboration -> List LoadedInterface -> DeclarationReferences -> String -> String -> Bool -> UType -> Result String Json
  conditional-instance-row typed interfaces references symbol identity flag head = case class-head head of
    None -> Err "conditional instance has no defining class"
    Some owner -> (case (find-class owner (elaboration-classes typed), export-global owner, resolved-source-scheme typed interfaces references symbol (mono head), export-instance-scheme (mono head)) of
      (Some description, Ok declaring, Ok resolved, Ok (display, context, spelling)) ->
        (case source-method-contracts typed interfaces references (set-field "scheme" (JStr spelling) resolved) identity (class-methods description) of
          Ok (names, contracts) -> Ok (JObj "id" (JStr identity) (JObj "class" (JStr declaring) (JObj "target" (JStr display) (JObj "resolved" JNull
            (JObj "ctx" JArrEnd (JObj "methods" names (JObj "method_contracts" contracts (JObj "implicit" (JBool flag) JObjEnd))))))))
          Err error -> Err error)
      other -> Err "conditional instance has no checked export head")
  source-conditional-rows :: Elaboration -> List LoadedInterface -> DeclarationReferences -> Json -> List Decl -> Json -> Result String Json
  source-conditional-rows typed interfaces references context ds rows = case ds of
    Nil -> Ok rows
    Cons (DInstance sp flag symbol params head members) rest | has-symbol symbol (field "declarations" context) ->
      (case export-global symbol of
        Ok identity -> (case source-conditional-head identity (elaboration-bindings typed) of
          Some actual -> (case conditional-instance-row typed interfaces references symbol identity flag actual of
            Ok row -> source-conditional-rows typed interfaces references context rest (insert-row "id" row rows)
            Err error -> Err error)
          None -> Err "conditional instance has no checked methods")
        Err error -> Err error)
    Cons other rest -> source-conditional-rows typed interfaces references context rest rows
  instance-rows :: Elaboration -> List LoadedInterface -> DeclarationReferences -> Json -> List Decl -> List CoreInstance -> Result String Json
  instance-rows typed interfaces references context guarded declarations = case declarations of
    Nil -> source-conditional-rows typed interfaces references context guarded JArrEnd
    Cons declaration rest -> if has-symbol (instance-name declaration) (field "declarations" context) then
      (case (instance-row typed interfaces references declaration, instance-rows typed interfaces references context guarded rest) of
        (Ok row, Ok more) -> Ok (insert-row "id" row more)
        (Err error, other) -> Err error
        (other, Err error) -> Err error)
      else instance-rows typed interfaces references context guarded rest
  -- The checked bindings and data declarations by name, built once for all
  -- modules: every public row looks its symbol up in both. Each map keeps
  -- the first entry of a name, as find-binding and find-data do.
  data ExportIndex where
    ExportIndex :: Bool -> Bool -> HashMap String CheckedBinding -> HashMap String CoreData -> DeclarationReferences -> HashMap String DataLayout -> List Decl -> ExportIndex
  export-index :: Bool -> Bool -> Elaboration -> ExportIndex
  export-index require-worker alias-display typed = ExportIndex require-worker alias-display (binding-index (elaboration-bindings typed)) (data-index (elaboration-data typed))
    (declaration-reference-index (elaboration-declarations typed)) (unboxed-layouts (elaboration-data typed)) (guarded-instances (elaboration-declarations typed))
  guarded-instances :: List Decl -> List Decl
  guarded-instances ds = case ds of
    Nil -> Nil
    Cons d rest -> case d of
      DInstance sp flag symbol params head members | guarded-members (decls-of members) -> Cons d (guarded-instances rest)
      other -> guarded-instances rest
  indexed-requires-worker :: ExportIndex -> Bool
  indexed-requires-worker index = case index of ExportIndex require-worker alias-display bindings datas references physical guarded -> require-worker
  indexed-alias-display :: ExportIndex -> Bool
  indexed-alias-display index = case index of ExportIndex require-worker alias-display bindings datas references physical guarded -> alias-display
  indexed-guarded :: ExportIndex -> List Decl
  indexed-guarded index = case index of ExportIndex require-worker alias-display bindings datas references physical guarded -> guarded
  guarded-instance-name :: String -> List Decl -> Bool
  guarded-instance-name name ds = case ds of
    Cons (DInstance sp flag symbol params head members) rest -> same symbol name || guarded-instance-name name rest
    other -> False
  binding-index :: List CheckedBinding -> HashMap String CheckedBinding
  binding-index rows = case rows of Nil -> hash-map-empty; Cons row rest -> hash-map-insert (checked-name row) row (binding-index rest)
  data-index :: List CoreData -> HashMap String CoreData
  data-index rows = case rows of Nil -> hash-map-empty; Cons row rest -> hash-map-insert (core-data-name row) row (data-index rest)
  indexed-layouts :: ExportIndex -> HashMap String DataLayout
  indexed-layouts index = case index of ExportIndex require-worker alias-display bindings datas references physical guarded -> physical
  indexed-binding :: String -> ExportIndex -> Option CheckedBinding
  indexed-binding name index = case index of ExportIndex require-worker alias-display bindings datas references physical guarded -> hash-map-lookup name bindings
  indexed-data :: String -> ExportIndex -> Option CoreData
  indexed-data name index = case index of ExportIndex require-worker alias-display bindings datas references physical guarded -> hash-map-lookup name datas
  indexed-references :: ExportIndex -> DeclarationReferences
  indexed-references index = case index of ExportIndex require-worker alias-display bindings datas references physical guarded -> references
  -- Source effect labels belong to the handler table. The public interface
  -- exposes their operations as values with display-only schemes.
  declared-effect :: String -> List CoreEffect -> Bool
  declared-effect symbol effects = case effects of
    Nil -> False
    Cons declaration rest -> same symbol (core-effect-name declaration) || declared-effect symbol rest
  -- Constructors and erased equation methods have their own checked
  -- tables. Neither needs an ordinary value row.
  exports :: Elaboration -> ExportIndex -> List LoadedInterface -> Json -> Json -> Result String (Json, Json)
  exports typed index interfaces surface rows = let references = indexed-references index in case rows of
    JArr row rest -> let name = text (field "name" row) in let symbol = text (field "symbol" row) in
      case exports typed index interfaces surface rest of
        Err error -> Err error
        Ok (values, types) -> case indexed-data symbol index of
          Some declaration -> case type-row typed interfaces references surface name declaration of
            Err error -> Err error
            Ok actual -> Ok (values, insert-row "name" actual types)
          None -> case find-class symbol (elaboration-classes typed) of
            Some description -> case class-nominal description of
              Ok nominal -> Ok (values, insert-row "name" (abstract-type-row name nominal) types)
              Err error -> Err error
            None -> case indexed-abstract-type (elaboration-declarations typed) references symbol of
              Some (Ok nominal) -> Ok (values, insert-row "name" (abstract-type-row name nominal) types)
              Some (Err error) -> Err error
              None -> case imported-refinement-type interfaces symbol of
                Some row -> Ok (values, insert-row "name" (set-field "name" (JStr name) row) types)
                None -> if constructor-present symbol (elaboration-data typed) then Ok (values, types)
                  else case indexed-binding symbol index of
                    None -> if equation-method-present symbol (elaboration-classes typed) || declared-effect symbol (elaboration-effects typed) || guarded-instance-name symbol (indexed-guarded index) then Ok (values, types)
                      else Err (string-concat "export has no retained checked declaration: " name)
                    -- Methods and instance factories have their own contract tables.
                    Some binding -> let role = checked-role binding in
                      if same role "method" || same role "instance" || same role "implicit-instance" then Ok (values, types)
                      else case value-row (indexed-requires-worker index) (indexed-alias-display index) typed interfaces references name symbol binding of
                        Err error -> Err error
                        Ok actual -> Ok (insert-row "name" actual values, types)
    JArrEnd -> Ok (JArrEnd, JArrEnd)
    other -> Err "module has no retained public export table"
  symbols :: Json -> Json
  symbols values = case values of
    JArr row rest -> JArr (JStr (string-concat-all [text (field "name" row), "=", text (field "symbol" row)])) (symbols rest)
    other -> JArrEnd
  insert-string :: String -> Json -> Json
  insert-string name rows = case rows of
    JArr (JStr first) rest -> let order = string-compare name first in
      if order == 0 then rows else if order < 0 then JArr (JStr name) rows else JArr (JStr first) (insert-string name rest)
    other -> JArr (JStr name) JArrEnd
  sorted-strings :: Json -> Json
  sorted-strings rows = case rows of JArr (JStr name) rest -> insert-string name (sorted-strings rest); other -> JArrEnd
  unboxed-layouts :: List CoreData -> HashMap String DataLayout
  unboxed-layouts datas = case datas of
    Nil -> hash-map-empty
    Cons d rest -> let more = unboxed-layouts rest in case core-data-layout d of
      UniformData -> more
      layout -> (case export-global (core-data-name d) of Ok identity -> hash-map-insert identity layout more; Err message -> more)

  wrapper-abi :: String -> String -> Nat -> Nat -> Json
  wrapper-abi repr label size align = let offset = JObj "offset" (JNum 0) (JObj "size" (JNum (nat-to-int size)) (JObj "align" (JNum (nat-to-int align)) JObjEnd)) in
    JObj "size" (JNum (nat-to-int size)) (JObj "align" (JNum (nat-to-int align)) (JObj "fields" (JArr (JObj "name" (JStr label) offset) JArrEnd) (JObj "repr" (JStr repr) JObjEnd)))
  layouts :: HashMap String DataLayout -> Json -> Json
  layouts index types = case types of
    JArr row rest -> let layout = (case hash-map-lookup (text (field "identity" row)) index of
          Some (UnpackedRecord slots) -> unpacked-abi slots
          Some (UnboxedData label word size align) -> wrapper-abi "unboxed" label size align
          Some (TransparentData label size align) -> wrapper-abi "transparent" label size align
          other -> JObj "size" (JNum 8) (JObj "align" (JNum 8) (JObj "fields" JArrEnd (JObj "repr" (JStr "uniform-word") JObjEnd)))) in
      JArr (JObj "type" (field "name" row) layout) (layouts index rest)
    other -> JArrEnd
  public-spelling :: String -> Json -> Bool
  public-spelling name surface = case surface of
    JArr row rest -> same name (text (field "name" row)) || public-spelling name rest
    other -> False
  public-fixities :: Json -> Json -> Json
  public-fixities surface rows = case rows of
    JArr row rest -> if public-spelling (text (field "op" row)) surface then JArr row (public-fixities surface rest) else public-fixities surface rest
    other -> JArrEnd
  lookup-hash :: String -> List (String, String) -> List LoadedInterface -> Result String String
  lookup-hash name produced interfaces = case produced of
    Cons (owner, hash) rest -> if same name owner then Ok hash else lookup-hash name rest interfaces
    Nil -> case interfaces of
      Nil -> Err (string-concat "no checked dependency interface identity: " name)
      Cons first rest -> if same name (loaded-module first) then Ok (loaded-hash first) else lookup-hash name Nil rest
  imports :: Json -> List (String, String) -> List LoadedInterface -> Result String Json
  imports names produced interfaces = case names of
    JArr (JStr name) rest -> case (lookup-hash name produced interfaces, imports rest produced interfaces) of
      (Ok hash, Ok more) -> Ok (insert-row "module" (JObj "module" (JStr name) (JObj "iface_hash" (JStr hash) JObjEnd)) more)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
    JArrEnd -> Ok JArrEnd
    other -> Err "module has no retained dependency list"
  has-symbol :: String -> Json -> Bool
  has-symbol name rows = case rows of JArr (JStr first) rest -> same name first || has-symbol name rest; other -> False
  nominal-owners :: Json -> List String
  nominal-owners rows = case rows of
    JArr row rest -> Cons (nominal-owner (text (field "identity" row))) (nominal-owners rest)
    other -> Nil
  resolved-owners :: Json -> List String
  resolved-owners rows = case rows of
    JArr row rest -> nominal-owners (field "nominals" (field "resolved" row)) <> resolved-owners rest
    other -> Nil
  constructor-owners :: Json -> List String
  constructor-owners types = case types of
    JArr row rest -> resolved-owners (field "ctors" row) <> constructor-owners rest
    other -> Nil
  signature-owners :: Json -> List String
  signature-owners signatures = case signatures of
    JArr row rest -> Cons (nominal-owner (text (field "identity" row)))
      (resolved-owners (field "methods" row) <> signature-owners rest)
    other -> Nil
  add-import-owners :: String -> List String -> Json -> Json
  add-import-owners home owners names = case owners of
    Nil -> names
    Cons owner rest -> if same home owner || has-symbol owner names then add-import-owners home rest names
      else add-import-owners home rest (JArr (JStr owner) names)
  -- The interface itself may retain a defining nominal reached through an
  -- imported signature. Record the direct checked dependency even when the
  -- original source only imported that signature's home.
  checked-imports :: String -> Json -> Json -> Json -> Json -> Json -> Json
  checked-imports home names values types signatures instances = add-import-owners home
    (resolved-owners values <> constructor-owners types <> signature-owners signatures <> resolved-owners instances) names
  source-primitives :: Json -> List Json -> Json
  source-primitives context rows = case rows of
    Nil -> JArrEnd
    Cons row rest -> if same (text (field "category" row)) "intrinsic" && has-symbol (text (field "binding" row)) (field "declarations" context) then
      insert-string (text (field "identity" row)) (source-primitives context rest)
      else source-primitives context rest
  foreign-drop-prefix :: List Char -> List Char -> Option (List Char)
  foreign-drop-prefix prefix full = case prefix of
    Nil -> Some full
    Cons first rest -> (case full of Cons actual more -> if char-code first == char-code actual then foreign-drop-prefix rest more else None; Nil -> None)
  intrinsic-empty-result :: Json
  intrinsic-empty-result = JObj "type" (JStr "") (JObj "class" (JStr "unit") (JObj "role" (JStr "value")
    (JObj "allocator" (JStr "") (JObj "nullable" (JBool False) (JObj "width" (JNum 0)
      (JObj "align" (JNum 1) (JObj "signed" (JBool False) (JObj "offsets" JArrEnd JObjEnd))))))))
  -- | Serialize a checked canonical intrinsic descriptor without accepting an executable body.
  intrinsic-foreign-row :: String -> Json -> Json
  intrinsic-foreign-row local row = JObj "symbol" (JStr local) (JObj "abi" (JStr "ccall") (JObj "external" (field "identity" row) (JObj "type" (field "scheme" row) (JObj "effects" (JStr "") (JObj "notes" (JStr "") (JObj "kind" (JStr "intrinsic") (JObj "params" (JArrEnd) (JObj "result" (intrinsic-empty-result) (JObj "deallocator" (JStr "") (JObjEnd))))))))))
  source-intrinsic-foreign :: Json -> List Json -> Json
  source-intrinsic-foreign context rows = case rows of
    Nil -> JArrEnd
    Cons row rest -> let more = source-intrinsic-foreign context rest in
      if not (same (text (field "category" row)) "intrinsic" && has-symbol (text (field "binding" row)) (field "declarations" context)
        && ((case array-plan (text (field "identity" row)) of Some plan -> True; None -> False)
          || (case mvar-plan (text (field "identity" row)) of Some plan -> True; None -> False))) then more else
      (case export-global (text (field "binding" row)) of
        Ok identity -> (case foreign-drop-prefix (unpack (string-concat (text (field "module" context)) ".")) (unpack identity) of
          Some local -> insert-row "symbol" (intrinsic-foreign-row (pack local) row) more
          None -> more)
        Err error -> more)
  -- | Export a scalar declaration only from its exact checked scheme and canonical intrinsic binding.
  source-scalar-foreign :: String -> CheckedBinding -> Result String (Option Json)
  source-scalar-foreign owner binding = case checked-intrinsic-symbol binding of
    None -> Ok None
    Some symbol -> case scalar-intrinsic symbol of
      None -> Ok None
      Some operation -> case export-global (checked-name binding) of
        Err error -> Err error
        Ok identity -> case foreign-drop-prefix (unpack (string-concat owner ".")) (unpack identity) of
          None -> Ok None
          Some local -> if not (scalar-promise-matches (Span 0 0 1 1) operation (checked-scheme binding)) then
            Err "scalar intrinsic export disagrees with its checked canonical nominal scheme"
            else (case export-scheme (checked-scheme binding) of
              Err error -> Err error
              Ok scheme -> Ok (Some (intrinsic-foreign-row (pack local)
                (JObj "identity" (JStr symbol) (JObj "scheme" (JStr scheme) JObjEnd)))))
  -- | Retain checked C and scalar intrinsic descriptors under their actual defining module.
  source-foreign-rows :: String -> List CheckedBinding -> Json -> Result String Json
  source-foreign-rows owner bindings rows = case bindings of
    Nil -> Ok rows
    Cons binding rest -> case checked-c-export binding of
      Some (name, plan) -> source-foreign-row owner rest rows name plan True
      None -> (case checked-foreign-plan binding of
        None -> (case source-scalar-foreign owner binding of
          Err error -> Err error
          Ok None -> source-foreign-rows owner rest rows
          Ok (Some row) -> source-foreign-rows owner rest (insert-row "symbol" row rows))
        Some plan | (case foreign-primitive-assumptions plan of Some checked -> True; None -> False) ->
          source-foreign-rows owner rest rows
        Some plan -> source-foreign-row owner rest rows (checked-name binding) plan False)
  source-foreign-row :: String -> List CheckedBinding -> Json -> String -> ForeignPlan -> Bool -> Result String Json
  source-foreign-row owner rest rows name plan exporting = case export-global name of
    Err error -> Err error
    Ok identity -> case foreign-drop-prefix (unpack (string-concat owner ".")) (unpack identity) of
      None -> source-foreign-rows owner rest rows
      Some local -> (case foreign-document (pack local) plan of
        Err error -> Err error
        Ok row -> let entry = if exporting then set-field "kind" (JStr "export") (set-field "notes" (JStr "foreign export") row) else row in
          source-foreign-rows owner rest (insert-row "symbol" entry rows))
  foreign-assumptions :: Json -> Json
  foreign-assumptions rows = case rows of
    JArr row rest -> if same (text (field "kind" row)) "import" then insert-string (text (field "external" row)) (foreign-assumptions rest) else foreign-assumptions rest
    other -> JArrEnd
  rewrite-assumptions :: Json -> List (String, String) -> Json
  rewrite-assumptions context rows = case rows of
    Nil -> JArrEnd
    Cons (name, identity) rest ->
      let more = rewrite-assumptions context rest in
      if has-symbol name (field "declarations" context) then insert-string identity more else more
  primitive-trust-rows :: List String -> Json -> Json
  primitive-trust-rows trust rows = case trust of
    Nil -> rows
    Cons identity rest -> primitive-trust-rows rest (insert-string identity rows)
  source-primitive-assumptions :: Json -> List CheckedBinding -> Json -> Json -> (Json, Json)
  source-primitive-assumptions context bindings primitives trust = case bindings of
    Nil -> (primitives, trust)
    Cons binding rest -> case checked-foreign-plan binding of
      Some plan -> (case foreign-primitive-assumptions plan of
        Some (identity, body-trust) | has-symbol (checked-name binding) (field "declarations" context) ->
          source-primitive-assumptions context rest (case identity of Some assumed -> insert-string assumed primitives; None -> primitives) (primitive-trust-rows body-trust trust)
        other -> source-primitive-assumptions context rest primitives trust)
      None -> source-primitive-assumptions context rest primitives trust
  assumptions :: Json -> Json -> Json -> Json
  assumptions primitives rows trust = JObj "primitives" primitives (JObj "foreign" (foreign-assumptions rows) (JObj "declared" trust JObjEnd))
  interface-assumptions :: Json -> Elaboration -> Json -> Json
  interface-assumptions context typed rows = case source-primitive-assumptions context (elaboration-bindings typed)
    (source-primitives context (elaboration-contexts typed))
    (rewrite-assumptions context (elaboration-rewrite-assumptions typed)) of
      (primitives, trust) -> assumptions primitives rows trust
  law-order :: Json -> String
  law-order row = string-concat-all [text (field "instance" row), "\n", text (field "class" row), "\n", text (field "law" row)]
  insert-law :: Json -> Json -> Json
  insert-law row rows = case rows of
    JArr first rest -> if string-compare (law-order row) (law-order first) < 0 then JArr row rows else JArr first (insert-law row rest)
    other -> JArr row JArrEnd
  law-observations :: Json -> List (String, String, String, String) -> Result String Json
  law-observations context observations = case observations of
    Nil -> Ok JArrEnd
    Cons (subject, owner, law-name, status) rest -> case law-observations context rest of
      Err error -> Err error
      Ok rows -> if has-symbol subject (field "declarations" context) then
        (case (export-global subject, export-global owner) of
          (Ok identity, Ok class) -> Ok (insert-law (JObj "instance" (JStr identity) (JObj "class" (JStr class)
            (JObj "law" (JStr law-name) (JObj "status" (JStr status) JObjEnd)))) rows)
          (Err error, other) -> Err error
          (other, Err error) -> Err error)
        else Ok rows
  document :: HashMap String DataLayout -> Json -> String -> Json -> Json -> Json -> Json -> Json -> Json -> Json -> Json -> Json
  document layout-index context source-hash dependencies values types signatures instances checked-assumptions foreign-rows laws =
    JObj "schema" (JNum (nat-to-int iface-schema-version)) (JObj "runtime_abi" (JNum runtime-abi-int)
      (JObj "language" (JStr "draft-0.2+amendments") (JObj "compiler" (JStr "cinch-self-hosted")
        (JObj "module" (field "module" context) (JObj "source_hash" (JStr source-hash)
          (JObj "imports" dependencies (JObj "params" JArrEnd
            (JObj "exports" (JObj "values" values (JObj "types" types (JObj "signatures" signatures
              (JObj "instances" instances (JObj "foreign" foreign-rows (JObj "fixities" (sort-rows "op" (public-fixities (field "exports" context) (field "fixities" context))) JObjEnd))))))
              (JObj "abi" (JObj "convention" (JStr "uniform-word, curried apply stub")
                (JObj "symbols" (sorted-strings (symbols values)) (JObj "layouts" (layouts layout-index types) JObjEnd)))
                (JObj "assumptions" checked-assumptions (JObj "assertions" JArrEnd
                  (JObj "contracts" JArrEnd (JObj "must_use" JArrEnd (JObj "laws" laws
                    (JObj "upgrades" JArrEnd (JObj "units" JArrEnd JObjEnd))))))))))))))))
  source-hash :: Bytes -> Json -> Result String String
  source-hash source context = case (field "source_start" context, field "source_end" context) of
    (JNum begin, JNum end) -> if begin >= 0 && end >= begin then
      (let lo = nat-from-int begin in let hi = nat-from-int end in
        if hi <= bytes-len source then Ok (fnv-source-hash (bytes-slice source lo hi)) else Err "module source span leaves input bytes")
      else Err "invalid module source span"
    other -> Err "module source span is missing"
  interface-hash :: Json -> String
  interface-hash doc = fnv-source-hash (canonical-bytes (set-field "units" JArrEnd
    (set-field "compiler" (JStr "") (set-field "source_hash" (JStr "") doc))))

  build-manifest :: String -> Json -> List LoadedInterface -> List (String, Json) -> Json
  build-manifest entry provider interfaces rows =
    let target-facts = JObj "triple" (field "target" provider)
          (JObj "word_size" (field "word_size" provider) (JObj "endian" (field "endian" provider) JObjEnd)) in
    build-profile-manifest entry target-facts interfaces rows

  build-profile-manifest :: String -> Json -> List LoadedInterface -> List (String, Json) -> Json
  build-profile-manifest entry target-facts interfaces rows = build-generated-manifest Nil JArrEnd entry target-facts interfaces rows
  checked-primitive-rows :: CheckedProgram -> Json
  checked-primitive-rows checked = primitive-rows (elaboration-bindings (checked-elaboration checked)) JArrEnd
  primitive-rows :: List CheckedBinding -> Json -> Json
  primitive-rows bindings rows = case bindings of
    Nil -> rows
    Cons binding rest -> case checked-foreign-plan binding of
      Some plan -> (case foreign-primitive-selection plan of
        Some selection -> (case export-global (checked-name binding) of
          Ok symbol -> let owner = nominal-owner symbol in
            (case foreign-drop-prefix (unpack (string-concat owner ".")) (unpack symbol) of
              Some local -> primitive-rows rest (insert-row "identity" (JObj "module" (JStr owner) (JObj "name" (JStr (pack local)) selection)) rows)
              None -> primitive-rows rest rows)
          Err message -> primitive-rows rest rows)
        None -> primitive-rows rest rows)
      None -> primitive-rows rest rows
  generated-modules :: List (String, List String) -> Json
  generated-modules reports = case reports of
    Nil -> JObjEnd
    Cons (owner, names) rest -> JObj owner (sort-list (sorted names Nil)) (generated-modules rest)
  build-generated-manifest :: List (String, List String) -> Json -> String -> Json -> List LoadedInterface -> List (String, Json) -> Json
  build-generated-manifest generated primitives entry target-facts interfaces rows =
    let contracts = source-build-contracts rows <> admitted-build-contracts interfaces in
    let trust = JObj "primitives" (build-assumptions "primitives" contracts)
          (JObj "foreign" (build-assumptions "foreign" contracts)
            (JObj "declared" (build-assumptions "declared" contracts) JObjEnd)) in
    JObj "entry" (JStr entry) (JObj "runtime_abi" (JNum runtime-abi-int)
      (JObj "prims" primitives (JObj "generated" (generated-modules generated) (JObj "modules" (sort-rows "module" (build-module-rows contracts))
        (JObj "assumptions" trust (JObj "laws" (build-law-rows contracts) (JObj "target" target-facts JObjEnd)))))))

  source-build-contracts :: List (String, Json) -> List (String, String, Json)
  source-build-contracts rows = case rows of
    Nil -> Nil
    Cons (name, doc) rest -> Cons (name, interface-hash doc, doc) (source-build-contracts rest)
  admitted-build-contracts :: List LoadedInterface -> List (String, String, Json)
  admitted-build-contracts interfaces = case interfaces of
    Nil -> Nil
    Cons first rest -> Cons (loaded-module first, loaded-hash first, loaded-contract first) (admitted-build-contracts rest)
  build-module-rows :: List (String, String, Json) -> Json
  build-module-rows contracts = case contracts of
    Nil -> JArrEnd
    Cons (name, hash, doc) rest -> JArr (JObj "module" (JStr name) (JObj "iface_hash" (JStr hash) JObjEnd)) (build-module-rows rest)
  build-assumptions :: String -> List (String, String, Json) -> Json
  build-assumptions key contracts = sorted-strings (build-assumption-rows key contracts)
  build-assumption-rows :: String -> List (String, String, Json) -> Json
  build-assumption-rows key contracts = case contracts of
    Nil -> JArrEnd
    Cons (name, hash, doc) rest -> append (field key (field "assumptions" doc)) (build-assumption-rows key rest)
  build-law-rows :: List (String, String, Json) -> Json
  build-law-rows contracts = case contracts of
    Nil -> JArrEnd
    Cons (name, hash, doc) rest -> append (field "laws" doc) (build-law-rows rest)

  export-loop :: Elaboration -> ExportIndex -> List LoadedInterface -> Bytes -> List (String, String) -> List Json -> Result String (List (String, Json))
  export-loop typed index interfaces source produced contexts = case contexts of
    Nil -> Ok Nil
    Cons context rest -> case field "module" context of
      JStr name -> case (exports typed index interfaces (field "exports" context) (field "exports" context), source-hash source context) of
          (Ok (values, types), Ok hash) ->
            (case instance-rows typed interfaces (indexed-references index) context (indexed-guarded index) (elaboration-instances typed) of
              Err error -> Err error
              Ok instances -> case signature-rows typed interfaces index (field "exports" context) (JArr values (JArr instances JArrEnd)) types (elaboration-classes typed) of
                Err error -> Err error
                Ok signatures -> case (imports (checked-imports name (field "imports" context) values types signatures instances) produced interfaces,
                  source-foreign-rows name (elaboration-bindings typed) (source-intrinsic-foreign context (elaboration-contexts typed)),
                  law-observations context (elaboration-law-observations typed)) of
                  (Err error, other, more) -> Err (string-concat-all [name, ": ", error])
                  (other, Err error, more) -> Err error
                  (other, more, Err error) -> Err error
                  (Ok dependencies, Ok foreign-rows, Ok laws) -> let doc = document (indexed-layouts index) context hash dependencies values types signatures instances (interface-assumptions context typed foreign-rows) foreign-rows laws in
                    (case export-loop typed index interfaces source (Cons (name, interface-hash doc) produced) rest of
                      Err error -> Err error
                      Ok more -> Ok (Cons (name, doc) more))
            )
          (Err error, other) -> Err (string-concat-all [name, ": ", error])
          (other, Err error) -> Err (string-concat-all [name, ": ", error])
      other -> export-loop typed index interfaces source produced rest
  -- A direct task forwarder is callable from source. Its transfer
  -- obligations cannot travel through this interface schema.
  source-only-task-forwarders :: List CoreDefinition -> List String
  source-only-task-forwarders definitions = case definitions of
    Nil -> Nil
    Cons definition rest ->
      if task-forwarder-type (scheme-body (core-scheme definition)) && task-source-forwarder definition then
        Cons (core-name definition) (source-only-task-forwarders rest)
      else source-only-task-forwarders rest
  source-only-symbol :: String -> List String -> Bool
  source-only-symbol symbol names = case names of
    Nil -> False
    Cons name rest -> same symbol name || source-only-symbol symbol rest
  interface-export-surface :: List String -> Json -> Json
  interface-export-surface source-only rows = case rows of
    JArr row rest -> if source-only-symbol (text (field "symbol" row)) source-only then interface-export-surface source-only rest
      else JArr row (interface-export-surface source-only rest)
    other -> rows
  interface-contexts :: List String -> List Json -> List Json
  interface-contexts source-only contexts = case source-only of
    Nil -> contexts
    other -> (case contexts of
      Nil -> Nil
      Cons context rest ->
        Cons (set-field "exports" (interface-export-surface source-only (field "exports" context)) context) (interface-contexts source-only rest))
  export-interfaces :: CheckedProgram -> List LoadedInterface -> Bytes -> Result String (List (String, Json))
  export-interfaces = export-interfaces-for False False
  export-interfaces-aliased :: CheckedProgram -> List LoadedInterface -> Bytes -> Result String (List (String, Json))
  export-interfaces-aliased = export-interfaces-for False True

  -- Source contracts carry the primitive's checked type and its assumptions.
  -- A library object must additionally supply a callable public worker.
  export-object-interfaces :: CheckedProgram -> List LoadedInterface -> Bytes -> Result String (List (String, Json))
  export-object-interfaces = export-interfaces-for True False

  export-interfaces-for :: Bool -> Bool -> CheckedProgram -> List LoadedInterface -> Bytes -> Result String (List (String, Json))
  export-interfaces-for require-worker alias-display checked interfaces source = let typed = checked-elaboration checked in
    case unsupported-modules (program-modules (checked-surface checked)) (elaboration-contexts typed) (elaboration-bindings typed) of
      Some message -> Err message
      None -> export-loop typed (export-index require-worker alias-display typed) interfaces source Nil (interface-contexts (source-only-task-forwarders (elaboration-core typed)) (elaboration-contexts typed))
  retained-intrinsic :: String -> String -> List Json -> Bool
  retained-intrinsic name identity rows = case rows of
    Nil -> False
    Cons row rest -> (same (text (field "category" row)) "intrinsic" && same (text (field "binding" row)) name && same (text (field "identity" row)) identity)
      || retained-intrinsic name identity rest
  unsupported-modules :: List Module -> List Json -> List CheckedBinding -> Option String
  unsupported-modules modules contexts bindings = case modules of
    Nil -> None
    Cons first rest -> case unsupported-declarations (module-decls first) contexts bindings of Some message -> Some message; None -> unsupported-modules rest contexts bindings
  retained-c-export :: String -> String -> List CheckedBinding -> Bool
  retained-c-export name symbol bindings = case bindings of
    Nil -> False
    Cons binding rest -> (case checked-c-export binding of
      Some (function, plan) | same name function && same symbol (foreign-symbol plan) -> True
      other -> retained-c-export name symbol rest)
  unsupported-declarations :: List Decl -> List Json -> List CheckedBinding -> Option String
  unsupported-declarations declarations contexts bindings = case declarations of
    Nil -> None
    Cons declaration rest -> case declaration of
      DForeign sp direction abi symbol name syntax -> if (same direction "export" && retained-c-export name symbol bindings) || retained-intrinsic name symbol contexts || (case find-binding name bindings of Some binding -> (case checked-foreign-plan binding of Some plan -> True; None -> False); None -> False) then unsupported-declarations rest contexts bindings else Some "foreign assumption interface production is incomplete"
      -- A private effect grants no public type/operation names. If a public
      -- scheme mentions it, nominal export still refuses the absent contract.
      other -> unsupported-declarations rest contexts bindings
