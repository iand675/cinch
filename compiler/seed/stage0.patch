+/// Map a verified file extent as an owned read-only `Bytes` word.
+/// A negative error signals an unavailable mapping. The descriptor remains
+/// open at its original position so the compiler can read through it.
+///
+/// # Safety
+///
+/// A successful mapping requires an open, stable file with at least
+/// `length` bytes. Publishers replace the file with a new inode.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn cinch_map_package_bytes(fd: i64, length: i64) -> i64 {
+    #[cfg(not(target_os = "unknown"))]
+    {
+        if length <= 0 || length > i64::from(u32::MAX) || i32::try_from(fd).is_err() {
+            return -crate::sys::EINVAL;
+        }
+        let Ok(size) = usize::try_from(length) else {
+            return -crate::sys::EINVAL;
+        };
+        let (address, error) = crate::sys::mmap_file_readonly(fd, size);
+        if error != 0 {
+            return -error;
+        }
+        let bytes = unsafe { crate::bytes::Bytes::from_mapping(address, length) };
+        boxed(crate::block::KIND_BYTES_MAPPED, crate::block::RC_FRESH, bytes)
+    }
+    #[cfg(target_os = "unknown")]
+    {
+        let _ = (fd, length);
+        -crate::sys::EINVAL
+    }
+}
