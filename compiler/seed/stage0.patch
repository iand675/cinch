+        if length <= 0 || length > i64::from(u32::MAX) || i32::try_from(fd).is_err() {
+            return -crate::sys::EINVAL;
+        }
+        let Ok(size) = usize::try_from(length) else {
+            return -crate::sys::EINVAL;
+        };
