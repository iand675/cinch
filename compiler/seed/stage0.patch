+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn cinch_arena_enter_phase(bytes: i64) -> i64 {
+    if bytes < 0 {
+        crate::abi::panic_exit(b"compiler bug: cinch_arena_enter_phase called with a negative size");
+    }
+    if !phase_enabled() {
+        return 0;
+    }
+    unsafe { new(bytes as usize) as usize as i64 }
+}
