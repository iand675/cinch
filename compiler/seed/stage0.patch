+    };
+    // Data.String.StrBuf is the sole constructor, with a counted Bytes field.
+    let string = unsafe { crate::block::allocate_ctor(8, crate::block::shape_field(0, 1), false) };
+    unsafe { string.cast::<i64>().write(bytes) };
