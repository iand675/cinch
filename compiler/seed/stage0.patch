diff --git a/seed/src/sync_codegen.rs b/seed/src/sync_codegen.rs
new file mode 100644
index 0000000..3aea585
--- /dev/null
+++ b/seed/src/sync_codegen.rs
@@ -0,0 +1,102 @@
+//! Native codegen wrappers for `AtomicCell` and `RwLockCell a`.
+use super::*;
+use crate::sync_prim::{AtomicOp, RwLockOp};
+
+pub(super) fn emit_atomic(b: &mut Builder, op: AtomicOp) {
+    let arity = op.sig().0.len();
+    let args: Vec<String> = (0..arity).map(|i| format!("i64 %p{i}")).collect();
+    let out = rt_call(b, op.extern_name(), &args);
+    if matches!(op, AtomicOp::Store | AtomicOp::Fence) {
+        ret(b, "0");
+    } else {
+        ret(b, &out);
+    }
+}
+
+pub(super) fn emit_rwlock(
+    b: &mut Builder,
+    reg: &Registry,
+    name: &str,
+    prim: PrimOp,
+    op: RwLockOp,
+    classes: [Class; 2],
+) {
+    use RwLockOp::*;
+    let wide = classes[0] == Class::Wide;
+    if op == New {
+        let value = if wide {
+            wide_box(b, reg, "%p0")
+        } else {
+            "%p0".into()
+        };
+        let out = rt_call(
+            b,
+            "cinch_rwlock_new",
+            &[
+                format!("i64 {value}"),
+                format!("i64 {}", scan_code(frame_class(classes[0]))),
+            ],
+        );
+        ret(b, &out);
+        return;
+    }
+    // ABI op codes matching seed/runtime/src/rwlock.rs.
+    let operation = match op {
+        Read => 0,
+        Write => 1,
+        Swap => 2,
+        TryRead => 3,
+        TryWrite => 4,
+        New => unreachable!(),
+    };
+    let value = if op.consumes(1) && wide {
+        wide_box(b, reg, "%p1")
+    } else if op.consumes(1) {
+        "%p1".into()
+    } else {
+        "0".into()
+    };
+    let slot = b.reg();
+    b.line(&format!("{slot} = alloca i64, align 8"));
+    let status = rt_call(
+        b,
+        "cinch_rwlock_access",
+        &[
+            "i64 %p0".into(),
+            format!("i64 {value}"),
+            format!("i64 {operation}"),
+            format!("ptr {slot}"),
+        ],
+    );
+    if op.returns_option() {
+        let none = b.reg();
+        b.line(&format!("{none} = icmp eq i64 {status}, 0"));
+        let load = |b: &mut Builder| {
+            let out = b.reg();
+            b.line(&format!("{out} = load i64, ptr {slot}, align 8"));
+            if wide {
+                wide_unbox(b, reg, &out)
+            } else {
+                out
+            }
+        };
+        if wide {
+            ret_option_wide_with(b, reg, name, &none, load);
+        } else {
+            ret_option(b, reg, prim, name, &none, load);
+        }
+    } else if op == TryWrite {
+        ret(b, &status);
+    } else if op == Write {
+        ret(b, "0");
+    } else {
+        let out = b.reg();
+        b.line(&format!("{out} = load i64, ptr {slot}, align 8"));
+        if wide {
+            let value = wide_unbox(b, reg, &out);
+            b.line(&format!("ret i128 {value}"));
+        } else {
+            ret(b, &out);
+        }
+    }
+}
diff --git a/seed/src/sync_prim.rs b/seed/src/sync_prim.rs
new file mode 100644
index 0000000..99554f8
--- /dev/null
+++ b/seed/src/sync_prim.rs
@@ -0,0 +1,157 @@
+//! Typed native concurrency primitives:
+//! - `AtomicCell`: lock-free 64-bit hardware atomic word (`Effect.Concurrent.Atomic`).
+//! - `RwLockCell a`: reader-writer lock box (`Effect.Concurrent.RwLock`).
+
+use crate::types::Ty;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum AtomicOp {
+    New,
+    Load,
+    Store,
+    Swap,
+    FetchAdd,
+    FetchSub,
+    FetchAnd,
+    FetchOr,
+    FetchXor,
+    Cas,
+    Fence,
+}
+
+impl AtomicOp {
+    pub const ALL: [Self; 11] = [
+        Self::New,
+        Self::Load,
+        Self::Store,
+        Self::Swap,
+        Self::FetchAdd,
+        Self::FetchSub,
+        Self::FetchAnd,
+        Self::FetchOr,
+        Self::FetchXor,
+        Self::Cas,
+        Self::Fence,
+    ];
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::New => "atomicNew",
+            Self::Load => "atomicLoad",
+            Self::Store => "atomicStore",
+            Self::Swap => "atomicSwap",
+            Self::FetchAdd => "atomicFetchAdd",
+            Self::FetchSub => "atomicFetchSub",
+            Self::FetchAnd => "atomicFetchAnd",
+            Self::FetchOr => "atomicFetchOr",
+            Self::FetchXor => "atomicFetchXor",
+            Self::Cas => "atomicCas",
+            Self::Fence => "atomicFence",
+        }
+    }
+
+    pub fn extern_name(self) -> &'static str {
+        match self {
+            Self::New => "cinch_atomic_new",
+            Self::Load => "cinch_atomic_load",
+            Self::Store => "cinch_atomic_store",
+            Self::Swap => "cinch_atomic_swap",
+            Self::FetchAdd => "cinch_atomic_fetch_add",
+            Self::FetchSub => "cinch_atomic_fetch_sub",
+            Self::FetchAnd => "cinch_atomic_fetch_and",
+            Self::FetchOr => "cinch_atomic_fetch_or",
+            Self::FetchXor => "cinch_atomic_fetch_xor",
+            Self::Cas => "cinch_atomic_cas",
+            Self::Fence => "cinch_atomic_fence",
+        }
+    }
+
+    pub fn sig(self) -> (Vec<Ty>, Ty) {
+        use AtomicOp::*;
+        let i64t = Ty::Prim(crate::types::Scalar::I64);
+        let cell = Ty::Adt("AtomicCell".into(), vec![]);
+        match self {
+            New => (vec![i64t], cell),
+            Load => (vec![cell, i64t.clone()], i64t),
+            Store => (vec![cell, i64t.clone(), i64t], Ty::Unit),
+            Swap | FetchAdd | FetchSub | FetchAnd | FetchOr | FetchXor => {
+                (vec![cell, i64t.clone(), i64t.clone()], i64t)
+            }
+            Cas => (
+                vec![cell, i64t.clone(), i64t.clone(), i64t.clone(), i64t],
+                Ty::Bool,
+            ),
+            Fence => (vec![i64t], Ty::Unit),
+        }
+    }
+
+    pub fn consumes(self, _i: usize) -> bool {
+        false
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub enum RwLockOp {
+    New,
+    Read,
+    Write,
+    Swap,
+    TryRead,
+    TryWrite,
+}
+
+impl RwLockOp {
+    pub const ALL: [Self; 6] = [
+        Self::New,
+        Self::Read,
+        Self::Write,
+        Self::Swap,
+        Self::TryRead,
+        Self::TryWrite,
+    ];
+
+    pub fn name(self) -> &'static str {
+        match self {
+            Self::New => "rwlockNew",
+            Self::Read => "rwlockRead",
+            Self::Write => "rwlockWrite",
+            Self::Swap => "rwlockSwap",
+            Self::TryRead => "rwlockTryRead",
+            Self::TryWrite => "rwlockTryWrite",
+        }
+    }
+
+    pub fn params(self) -> Vec<String> {
+        vec!["a".into()]
+    }
+
+    pub fn returns_option(self) -> bool {
+        self == Self::TryRead
+    }
+
+    pub fn blocking(self) -> bool {
+        matches!(self, Self::Read | Self::Write | Self::Swap)
+    }
+
+    pub fn sig(self) -> (Vec<Ty>, Ty) {
+        use RwLockOp::*;
+        let a = Ty::Param("a".into());
+        let cell = Ty::Adt("RwLockCell".into(), vec![a.clone()]);
+        let option = Ty::Adt(crate::known::OPTION.into(), vec![a.clone()]);
+        match self {
+            New => (vec![a], cell),
+            Read => (vec![cell], a),
+            Write => (vec![cell, a], Ty::Unit),
+            Swap => (vec![cell, a.clone()], a),
+            TryRead => (vec![cell], option),
+            TryWrite => (vec![cell, a], Ty::Bool),
+        }
+    }
+
+    /// New/Write/Swap/TryWrite take ownership of the supplied value word on
+    /// every outcome (the runtime drops it if TryWrite fails).
+    pub fn consumes(self, i: usize) -> bool {
+        (self == Self::New && i == 0)
+            || (i == 1 && matches!(self, Self::Write | Self::Swap | Self::TryWrite))
+    }
+}
