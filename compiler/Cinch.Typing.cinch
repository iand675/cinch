-- Core typing is checked after elaboration, using declarations and lexical
-- scopes rather than the producer's cached application/branch annotations.
-- Numeric reflection authority, totality and usage still need their own checks.
module Cinch.Typing where
  import Cinch.Type
  import Cinch.Promote (PromotedFn)
  import Cinch.Usage (UsageShape, usage-fields-for, usage-shape-closed, UsageConstructor, usage-constructor-claims, usage-constructor-key, usage-constructor-agrees)
  import Cinch.Index
  import Cinch.Core
  import Cinch.Global
  import Cinch.Instance (scheme-equivalent)
  import Cinch.BodyContract
  import Cinch.Guarded
  import Cinch.Kinds
  import Cinch.Proof (Proposition, PNegate)
  import Cinch.Nominal (interface-global, global-data-string-string, global-data-core-list)
  import Cinch.Builtin (array-type-name, cell-type-name)
  import Text.Lex (Span)
  import Text.Scan (string-starts-with)
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Algebra.Semigroup

  export close-typing-context-with-effects, close-typing-context-with-data, task-definition-safe, task-definition-error
  export par-definition-error, checked-definition-error
  export TypingContext, close-typing-context, typing-definition-closed, context-bodies, context-guarded-bodies
  export context-body-context, close-typing-context-with-definitions, closure-refusal
  export task-source-forwarder, task-forwarder-type
  export task-free, task-pattern-ids
  export close-typing-context-with-usage, close-typing-context-with-indexes, with-typing-type-families, with-typing-promoted
  -- | Retain checked declarations and separate usage-only fields for later Core and provenance checks.
  record TypingContext where
    kinds :: KindIndex
    globals :: CoreGlobals
    effects :: List CoreEffect
    datas :: List CoreData
    forwarders :: List String
    usage :: HashMap String UsageShape
    copies :: List UType
    type-families :: List TypeFamilyRuleSet
    promoted :: List PromotedFn
  with-typing-type-families :: List TypeFamilyRuleSet -> TypingContext -> TypingContext
  with-typing-type-families families context = case context of
    TypingContext kinds globals effects datas forwarders usage copies old promoted ->
      TypingContext kinds globals effects datas forwarders usage copies families promoted
  with-typing-promoted :: List PromotedFn -> TypingContext -> TypingContext
  with-typing-promoted promoted context = case context of
    TypingContext kinds globals effects datas forwarders usage copies families old ->
      TypingContext kinds globals effects datas forwarders usage copies families promoted
  context-declarations :: TypingContext -> List CoreGlobal
  context-declarations context = case context of TypingContext kinds globals effects datas forwarders usage copies families promoted -> globals.declarations
  context-bodies :: TypingContext -> List BodyBinding
  context-bodies context = case context of TypingContext kinds globals effects datas forwarders usage copies families promoted -> globals-bodies globals
  context-body-context :: TypingContext -> BodyBindings
  context-body-context context = case context of TypingContext kinds globals effects datas forwarders usage copies families promoted -> globals.body-context
  context-guarded-bodies :: TypingContext -> List GuardedBinding
  context-guarded-bodies context = case context of TypingContext kinds globals effects datas forwarders usage copies families promoted -> globals.guarded-bodies
  context-task-forwarder :: TypingContext -> String -> Bool
  context-task-forwarder context name = case context of TypingContext kinds globals effects datas forwarders usage copies families promoted -> has name forwarders
  -- Only checked nominal Copy dictionaries introduce an assumption. Keep it
  -- lexical so another definition or the supplier of a with cannot use it.
  with-copy-givens :: TypingContext -> List CoreGiven -> TypingContext
  with-copy-givens context givens = case givens of
    [] -> context
    given : rest -> case given.ty of
      UApp (UCon name (KFun KType KType)) carrier | (name == "Copy") || name == "Kernel" ->
        (case context of
          TypingContext kinds globals effects datas forwarders usage copies families promoted -> with-copy-givens (TypingContext kinds globals effects datas forwarders usage (carrier : copies) families promoted) rest)
      other -> with-copy-givens context rest
  scoped-copy :: TypingContext -> UType -> Bool
  scoped-copy context carrier = case context of
    TypingContext kinds globals effects datas forwarders usage copies families promoted -> task-seen-type carrier copies
  poly-rigid-pairs :: List Quant -> List Nat -> List (Nat, UType)
  poly-rigid-pairs qs ids = case (qs, ids) of
    (q : rest, id : more) -> (q.id, URigid id (q.name) 0 (q.kind)) : (poly-rigid-pairs rest more)
    other -> []
  poly-rigid-scope :: List Quant -> List Nat -> TypeScope -> Option TypeScope
  poly-rigid-scope qs ids scope = case (qs, ids) of
    (q : rest, id : more) -> (case add-rigid-kind id (q.kind) scope of
      Some bound -> poly-rigid-scope rest more bound
      None -> None)
    other -> Some scope
  poly-argument-pairs :: List Quant -> List UType -> List (Nat, UType)
  poly-argument-pairs qs args = case (qs, args) of
    (q : rest, arg : more) -> (q.id, arg) : (poly-argument-pairs rest more)
    other -> []
  poly-arguments-wf :: TypingContext -> TypeScope -> List UType -> Bool
  poly-arguments-wf context scope args = case args of
    [] -> True
    arg : rest -> not (has-forall arg) && wf context scope arg && poly-arguments-wf context scope rest
  equal-type :: UType -> UType -> Bool
  equal-type a b = valid-type a && valid-type b && store-error-count (unify (Span 0 0 1 1) (without-index-levels a) (without-index-levels b) (empty-store "Core typing")) == 0
  equal-type-in :: TypingContext -> UType -> UType -> Bool
  equal-type-in context a b = valid-type a && valid-type b && store-error-count (unify (Span 0 0 1 1) (without-index-levels a) (without-index-levels b) (with-families-and-promoted (context.type-families) (context.promoted) (empty-store "Core typing"))) == 0
  reduce-in :: TypingContext -> UType -> UType
  reduce-in context ty = reduce-types (context.type-families) (context.promoted) ty
  typing-type-head :: UType -> UType
  typing-type-head ty = case ty of UApp f _ -> typing-type-head f; other -> ty
  same-data-head :: UType -> UType -> Bool
  same-data-head a b = case (typing-type-head a, typing-type-head b) of
    (UCon na _, UCon nb _) -> na == nb
    other -> False
  add-missing-rigid :: Nat -> Kind -> TypeScope -> TypeScope
  add-missing-rigid id kind scope = case add-rigid-kind id kind scope of
    Some next -> next
    None -> scope
  add-type-rigids :: UType -> TypeScope -> TypeScope
  add-type-rigids ty scope = case ty of
    URigid id name level kind -> add-missing-rigid id kind scope
    UIndex carrier idx -> add-index-rigids carrier idx (add-type-rigids carrier scope)
    UApp f x -> add-type-rigids x (add-type-rigids f scope)
    UFun a b -> add-type-rigids b (add-type-rigids a scope)
    UFunEff a row b -> add-type-rigids b (add-type-rigids row (add-type-rigids a scope))
    UPi id name a row b -> add-type-rigids b (add-type-rigids row (add-type-rigids a scope))
    USigma id name a b -> add-type-rigids b (add-type-rigids a scope)
    UTuple fields -> add-type-rigids fields scope
    UArg first rest -> add-type-rigids rest (add-type-rigids first scope)
    URow fields -> add-type-rigids fields scope
    URowJoin first rest -> add-type-rigids rest (add-type-rigids first scope)
    URefine id name carrier pred -> add-type-rigids pred (add-type-rigids carrier scope)
    URequire preds body -> add-type-rigids body (add-type-rigids preds scope)
    UProofFun pred row result -> add-type-rigids result (add-type-rigids row (add-type-rigids pred scope))
    UUsageArrow u arrow -> add-type-rigids arrow scope
    UForall qs body -> add-type-rigids body scope
    UQual qs body -> add-uquals-rigids qs (add-type-rigids body scope)
    UIndexMath op left right -> add-type-rigids right (add-type-rigids left scope)
    other -> scope
  add-uquals-rigids :: UQuals -> TypeScope -> TypeScope
  add-uquals-rigids qs scope = case qs of
    UQEnd -> scope
    UQCons name ty rest -> add-uquals-rigids rest (add-type-rigids ty scope)
  add-index-rigids :: UType -> IndexTerm -> TypeScope -> TypeScope
  add-index-rigids carrier idx scope = case idx of
    IRigid id name level -> add-missing-rigid id (value-kind carrier) scope
    IAdd l r -> add-index-rigids carrier r (add-index-rigids carrier l scope)
    ISubtract l r -> add-index-rigids carrier r (add-index-rigids carrier l scope)
    IMultiply l r -> add-index-rigids carrier r (add-index-rigids carrier l scope)
    IApply f x -> add-index-rigids carrier x (add-index-rigids carrier f scope)
    other -> scope
  add-types-rigids :: List UType -> TypeScope -> TypeScope
  add-types-rigids types scope = case types of
    [] -> scope
    first : rest -> add-types-rigids rest (add-type-rigids first scope)
  has :: String -> List String -> Bool
  has name names = case names of [] -> False; key : rest -> name == key || has name rest
  empty-row :: UType
  empty-row = URow UEnd
  effects-fit :: UType -> UType -> Bool
  effects-fit actual allowed = case store-errors (include-effects (Span 0 0 1 1) actual allowed (empty-store "Core effects")) of [] -> True; other -> False
  type-is :: String -> UType -> Bool
  type-is name ty = equal-type (UCon name KType) ty
  string-type :: UType -> Bool
  string-type ty = type-is "String" ty || type-is (global-data-string-string) ty
  constructor-pure :: UType -> Bool
  constructor-pure ty = case ty of
    UFun a b -> constructor-pure b
    UFunEff a row b -> effects-fit row empty-row && constructor-pure b
    UProofFun predicate row result -> effects-fit row empty-row && constructor-pure result
    UPi id name a row b -> effects-fit row empty-row && constructor-pure b
    other -> True
  global-schemes-well-formed :: KindIndex -> List Scheme -> Bool
  global-schemes-well-formed kinds schemes = case schemes of [] -> True; sc : rest -> scheme-well-formed-in kinds empty-type-scope sc && global-schemes-well-formed kinds rest
  global-types :: KindIndex -> List CoreGlobal -> Bool
  global-types kinds declarations = case declarations of
    [] -> True
    declaration : rest -> global-schemes-well-formed kinds (global-schemes declaration)
      && (case declaration of GlobalValue name role sc -> role /= "constructor" || constructor-pure (scheme-body sc); other -> True)
      && global-types kinds rest
  kernel-effect-kinds :: List (String, Kind)
  kernel-effect-kinds = [("#kernel.MVar", KEffect), ("#kernel.STM", KEffect), ("#kernel.Handler", handler-kind), ("#kernel.ForeignIO", KEffect), ("Foreign", KFun KRegion KEffect), ("Diverge", KEffect), ("Blocking", KEffect), ("Global", KEffect), ("Fail", KEffect), ("Reentrant", KEffect), ("ThreadAffine", KEffect), ("IO", KFun KRegion KEffect), ("Async", KFun KRegion KEffect), ("Cancel", KFun KRegion KEffect), ("Eval", KFun KRegion KEffect)]
  close-typing-context :: List (String, Kind) -> List CoreGlobal -> Option TypingContext
  close-typing-context kinds declarations = close-typing-context-with-effects kinds declarations []
  effect-kind-declared :: String -> Kind -> KindIndex -> Bool
  effect-kind-declared name kind kinds = case kind-at name kinds of Some actual -> kind-equal kind actual; None -> False
  operation-registered :: CoreOperation -> List CoreGlobal -> Bool
  operation-registered operation declarations = case declarations of
    [] -> False
    (GlobalValue name role sc) : rest -> if name == operation.operation-name then role == "operation" && scheme-equivalent sc (operation.operation-scheme) else operation-registered operation rest
    other : rest -> operation-registered operation rest
  indexed-operation-registered :: GlobalDeclarations -> CoreOperation -> Bool
  indexed-operation-registered declarations operation = case indexed-global-declaration (operation.operation-name) declarations of
    Some (GlobalValue name role sc) -> role == "operation" && scheme-equivalent sc (operation.operation-scheme)
    other -> False
  operations-registered :: (CoreOperation -> Bool) -> List CoreOperation -> Bool
  operations-registered registered operations = case operations of
    [] -> True
    first : rest -> registered first && operations-registered registered rest
  effects-registered :: KindIndex -> (CoreOperation -> Bool) -> HashMap String () -> List CoreEffect -> Bool
  effects-registered kinds registered seen declarations = case declarations of
    [] -> True
    declaration : rest -> let name = declaration.effect-name in
      (case hash-map-lookup name seen of
        Some already -> False
        None -> core-effect-closed declaration
          && effect-kind-declared name (declaration.effect-kind) kinds
          && operations-registered registered (declaration.effect-operations)
          && effects-registered kinds registered (hash-map-insert name () seen) rest)
  close-typing-context-with-effects :: List (String, Kind) -> List CoreGlobal -> List CoreEffect -> Option TypingContext
  close-typing-context-with-effects kinds declarations effects = close-typing-context-with-data kinds declarations effects []
  close-typing-context-with-data :: List (String, Kind) -> List CoreGlobal -> List CoreEffect -> List CoreData -> Option TypingContext
  close-typing-context-with-data kinds declarations effects datas = close-typing-context-with-definitions kinds declarations effects datas []
  close-typing-context-with-definitions :: List (String, Kind) -> List CoreGlobal -> List CoreEffect -> List CoreData -> List CoreDefinition -> Option TypingContext
  close-typing-context-with-definitions kinds declarations effects datas definitions = close-typing-context-with-usage kinds declarations effects datas definitions []
  -- | Preserve validated usage-only fields through the final independent Core, task and provenance checks.
  constructor-index-kinds :: List CoreData -> List (String, Kind)
  constructor-index-kinds datas = case datas of
    [] -> []
    d : rest -> let more = constructor-index-kinds rest in
      (case (core-data-kind d, core-data-params d, core-data-constructors d) of
        (KType, [], [constructor]) -> let sc = constructor.constructor-scheme in
          (case (scheme-params sc, scheme-requirements sc, scheme-body sc) of
            ([], [], UFun domain (UCon owner KType)) -> if owner == core-data-name d
              then (constructor-index-key (constructor.constructor-name), KValue (scheme-body sc)) : more else more
            other -> nullary-index-kinds (core-data-name d) [constructor] more)
        (KType, [], constructors) -> nullary-index-kinds (core-data-name d) constructors more
        other -> more)
  nullary-index-kinds :: String -> List CoreConstructor -> List (String, Kind) -> List (String, Kind)
  nullary-index-kinds owner constructors kinds = case constructors of
    [] -> kinds
    ctor : rest -> let more = nullary-index-kinds owner rest kinds in
      let sc = ctor.constructor-scheme in
      (case (scheme-params sc, scheme-requirements sc, scheme-body sc) of
        ([], [], UCon result KType) | (owner == result) -> (constructor-index-key (ctor.constructor-name), KValue (scheme-body sc)) : more
        other -> more)
  close-typing-context-with-usage :: List (String, Kind) -> List CoreGlobal -> List CoreEffect -> List CoreData -> List CoreDefinition -> List UsageShape -> Option TypingContext
  close-typing-context-with-usage kinds declarations effects datas definitions usage =
    close-typing-context-using (kind-declarations (kernel-effect-kinds <> kinds)) declarations effects datas definitions usage
      (\operation -> operation-registered operation declarations) (\unit -> close-globals-with-source-data declarations definitions datas)
  close-typing-context-with-indexes :: KindDeclarations -> GlobalDeclarations -> List CoreEffect -> List CoreData -> List CoreDefinition -> List UsageShape -> Option TypingContext
  close-typing-context-with-indexes kinds declarations effects datas definitions usage =
    close-typing-context-using (prefix-kind-declarations kernel-effect-kinds kinds) (declarations.global-declarations) effects datas definitions usage
      (indexed-operation-registered declarations) (\unit -> close-indexed-globals declarations definitions datas)
  close-typing-context-using :: KindDeclarations -> List CoreGlobal -> List CoreEffect -> List CoreData -> List CoreDefinition -> List UsageShape -> (CoreOperation -> Bool) -> (Unit -> Option CoreGlobals) -> Option TypingContext
  close-typing-context-using kinds declarations effects datas definitions usage registered close =
    let defined = kinds.kind-index in
    let all = extend-kind-index defined (constructor-index-kinds datas) in
    if nominal-index-closed defined (kinds.kinds) && global-types all declarations && effects-registered all registered hash-map-empty effects && task-data-closed all datas then
      (case index-checked-usage all usage hash-map-empty of
        Some owners | usage-schemes-closed usage declarations datas -> (case close () of
          Some globals -> Some (TypingContext all globals effects datas (task-forwarder-names definitions) owners [] [] [])
          None -> None)
        other -> None)
    else None
  -- | Require unique owners and recheck every field's scope without adding runtime data or constructors.
  index-checked-usage :: KindIndex -> List UsageShape -> HashMap String UsageShape -> Option (HashMap String UsageShape)
  index-checked-usage kinds rows indexed = case rows of
    [] -> Some indexed
    first : rest -> let name = first.name in case hash-map-lookup name indexed of
      None | usage-shape-closed kinds first -> index-checked-usage kinds rest (hash-map-insert name first indexed)
      other -> None

  usage-schemes-closed :: List UsageShape -> List CoreGlobal -> List CoreData -> Bool
  usage-schemes-closed rows declarations datas = case rows of
    [] -> True
    other -> let claims = index-usage-constructors rows hash-map-empty in
      usage-globals-closed claims declarations && usage-data-closed claims datas

  index-usage-constructors :: List UsageShape -> HashMap String (List UsageConstructor) -> HashMap String (List UsageConstructor)
  index-usage-constructors rows indexed = case rows of
    [] -> indexed
    first : rest -> index-usage-constructors rest (index-usage-claims (usage-constructor-claims first) indexed)

  index-usage-claims :: List (String, UsageConstructor) -> HashMap String (List UsageConstructor) -> HashMap String (List UsageConstructor)
  index-usage-claims claims indexed = case claims of
    [] -> indexed
    (name, claim) : rest -> let prior = (case hash-map-lookup name indexed of Some found -> found; None -> []) in
      index-usage-claims rest (hash-map-insert name (claim : prior) indexed)

  -- | Check actual constructor schemes independently whenever a Core context receives optional private facts.
  usage-scheme-agrees :: HashMap String (List UsageConstructor) -> String -> Scheme -> Bool
  usage-scheme-agrees indexed name scheme = case usage-constructor-key name of
    None -> True
    Some key -> (case hash-map-lookup key indexed of
      None -> True
      Some claims -> usage-claims-agree claims scheme)

  usage-claims-agree :: List UsageConstructor -> Scheme -> Bool
  usage-claims-agree rows scheme = case rows of
    [] -> True
    first : rest -> usage-constructor-agrees first scheme && usage-claims-agree rest scheme
  -- | Keep selected global constructors authoritative even when their family remains abstract at runtime.
  usage-global-agrees :: HashMap String (List UsageConstructor) -> CoreGlobal -> Bool
  usage-global-agrees rows declaration = case declaration of
    GlobalValue name role scheme -> role /= "constructor" || usage-scheme-agrees rows name scheme
    GlobalBody actual body -> usage-global-agrees rows actual
    GlobalGuardedBody actual body -> usage-global-agrees rows actual
    other -> True
  -- | Recheck constructor agreement on every later context closure without inspecting executable bodies.
  usage-globals-closed :: HashMap String (List UsageConstructor) -> List CoreGlobal -> Bool
  usage-globals-closed rows declarations = case declarations of
    [] -> True
    first : rest -> usage-global-agrees rows first && usage-globals-closed rows rest
  -- | Compare available real data constructors too, including public constructors not selected as globals.
  usage-data-closed :: HashMap String (List UsageConstructor) -> List CoreData -> Bool
  usage-data-closed rows declarations = case declarations of
    [] -> True
    first : rest -> usage-constructors-closed rows (core-data-constructors first) && usage-data-closed rows rest
  -- | No proof may contradict actual constructor fields supplied by a source or complete public data table.
  usage-constructors-closed :: HashMap String (List UsageConstructor) -> List CoreConstructor -> Bool
  usage-constructors-closed rows constructors = case constructors of
    [] -> True
    first : rest -> usage-scheme-agrees rows (first.constructor-name) (first.constructor-scheme) && usage-constructors-closed rows rest
  -- | Instantiate a validated defining proof, failing closed when either the owner or roles are unavailable.
  task-usage-fields :: TypingContext -> String -> List UType -> Option (List UType)
  task-usage-fields context owner actuals = case hash-map-lookup owner (context.usage) of
    None -> None
    Some shape -> usage-fields-for shape actuals
  -- | Run the existing structural property walk over imported fields under the actual type arguments.
  task-usage-walk :: TypingContext -> String -> List UType -> Bool -> List UType -> Nat -> Option (List UType)
  task-usage-walk context owner actuals sharing seen fuel = case task-usage-fields context owner actuals of
    Some fields -> task-types-walk context sharing seen fuel fields
    None -> None
  -- | Retain the same transfer walk for hidden fields; mutable cells still require a shareable payload.
  task-usage-transfer :: TypingContext -> String -> List UType -> List UType -> Nat -> Bool
  task-usage-transfer context owner actuals seen fuel = case task-usage-fields context owner actuals of
    Some fields -> task-transfer-types context seen fuel [] fields
    None -> False

  -- The closure above folds four unrelated clauses into one `None`, so the
  -- refusal names nothing. This reports the first clause that refused, in the
  -- order the chain applies, because the failing declaration is the whole
  -- diagnosis: a proposition-valued scheme and an impure constructor are both
  -- `False` and need different fixes. The checking form stays the one every
  -- caller uses; this one only shapes a message.
  closure-refusal :: List (String, Kind) -> List CoreGlobal -> List CoreEffect -> List CoreData -> List CoreDefinition -> String
  closure-refusal kinds declarations effects datas definitions = let declared = kernel-effect-kinds <> kinds in
    let defined = index-kinds declared in
    let all = extend-kind-index defined (constructor-index-kinds datas) in
    if not (nominal-index-closed defined declared) then "the nominal kind table is not closed"
    else if not (global-types all declarations) then (string-concat "a global scheme is ill-formed: " (ill-formed-scheme all declarations))
    else if not (effects-registered all (\operation -> operation-registered operation declarations) hash-map-empty effects) then "an effect declaration is not registered"
    else if not (task-data-closed all datas) then "task data is not closed"
    else case globals-refusal declarations of
      Some reason -> string-concat "the global reference closure refused: " reason
      None -> "the source body closure refused: a body binding does not match its definition"
  -- Which declaration `global-types` rejects, named. A proposition-valued body
  -- is a legal scheme (`scheme-well-formed-in` admits `declared-type`), so naming
  -- it distinguishes that from an impure constructor, which is not legal.
  ill-formed-scheme :: KindIndex -> List CoreGlobal -> String
  ill-formed-scheme kinds declarations = case declarations of
    [] -> "no declaration names itself"
    declaration : rest ->
      if global-schemes-well-formed kinds (global-schemes declaration) then
        (case declaration of
          GlobalValue name role sc -> if role == "constructor" && not (constructor-pure (scheme-body sc)) then string-concat name " (impure constructor)" else ill-formed-scheme kinds rest
          other -> ill-formed-scheme kinds rest)
      else global-name declaration
  wf :: TypingContext -> TypeScope -> UType -> Bool
  wf context scope ty = body-type-authorized (context-bodies context) ty && type-well-formed-in (context.kinds) scope ty
  actual-types :: TypingContext -> TypeScope -> List UType -> Bool
  actual-types context scope types = case types of [] -> True; ty : rest -> body-type-authorized (context-bodies context) ty && argument-well-formed-in (context.kinds) scope ty && actual-types context scope rest
  evidence-types :: TypingContext -> TypeScope -> CoreEvidence -> Bool
  evidence-types context scope evidence = case evidence of
    CECopy sp carrier -> wf context scope (evidence-type evidence) && copy-marker-carrier carrier
    CEKernel sp carrier -> wf context scope (evidence-type evidence) && kernel-marker-carrier carrier
    CEGiven sp ty symbol -> wf context scope ty
    CEInstance sp ty symbol actuals args -> wf context scope ty && actual-types context scope actuals && evidence-types context scope args
    CEArgument sp first rest -> evidence-types context scope first && evidence-types context scope rest
    CEArgumentsEnd sp -> True
    other -> False
  evidences-types :: TypingContext -> TypeScope -> List CoreEvidence -> Bool
  evidences-types context scope evidence = case evidence of [] -> True; first : rest -> evidence-types context scope first && evidences-types context scope rest
  pattern-type :: CorePattern -> UType
  pattern-type pattern = case pattern of
    CPWild sp ty -> ty
    CPVar sp ty id name -> ty
    CPProof sp ty id name -> ty
    CPErasedValue sp ty id name -> ty
    CPAs sp ty id name inner -> ty
    CPConstructor sp ty name actuals constructor fields -> ty
    CPInt sp ty text -> ty
    CPString sp ty text -> ty
    CPChar sp ty text -> ty
    CPSymbol sp ty text -> ty
    CPTuple sp ty fields -> ty
    other -> UError
  char-value :: String -> Bool
  char-value text = case unpack text of [first] -> True; other -> False
  tuple-fields :: UType -> Option UType
  tuple-fields ty = case ty of UTuple fields -> Some fields; UCon name KType -> if name == "Unit" then Some UEnd else None; other -> None
  pattern-scope :: TypingContext -> TypeScope -> UType -> CorePattern -> Option TypeScope
  pattern-scope context scope expected pattern = if not (wf context scope expected && equal-type-in context expected (pattern-type pattern)) then None else if kind-equal (type-kind expected) KProp then (case pattern of CPProof sp predicate id name -> add-local-scheme id (mono predicate) scope; other -> None) else if not (proper-type expected) then None else case pattern of
    CPWild sp ty -> Some scope
    CPVar sp ty id name -> add-local-scheme id (mono ty) scope
    CPAs sp ty id name inner -> case add-local-scheme id (mono ty) scope of Some bound -> pattern-scope context bound expected inner; None -> None
    CPConstructor sp ty name actuals constructor fields ->
      let gscope = add-type-rigids constructor (add-types-rigids actuals scope) in
      if wf context gscope constructor && actual-types context gscope actuals then constructor-fields context gscope expected (pattern-constructor-type expected constructor) fields else None
    CPTuple sp ty fields -> case reduce-in context ty of
      USigma id name domain body -> (case fields of
        CPField sp1 first (CPField sp2 second (CPDone end)) ->
          (case pattern-scope context scope domain first of
            Some bound -> (case pattern-result (UPi id name domain (URow UEnd) body) first of
              Some opened -> pattern-scope context bound opened second
              None -> None)
            None -> None)
        other -> None)
      other -> case tuple-fields other of Some types -> tuple-patterns context scope types fields; None -> None
    CPInt sp ty text -> if integer-carrier ty || wide-carrier ty then Some scope else None
    CPString sp ty text -> if string-type ty then Some scope else None
    CPChar sp ty text -> if type-is "Char" ty && char-value text then Some scope else None
    CPSymbol sp ty text -> if type-is "Sym" ty then Some scope else None
    other -> None
  arrow-pattern-scope :: TypingContext -> TypeScope -> UType -> UType -> CorePattern -> Option TypeScope
  arrow-pattern-scope context scope function domain pattern = case pattern of
    CPErasedValue sp carrier id name -> if erased-value-arrow function && wf context scope domain && proper-type domain && equal-type-in context domain carrier then
      add-local-scheme id (mono carrier) scope else None
    other -> pattern-scope context scope domain pattern
  tuple-patterns :: TypingContext -> TypeScope -> UType -> CorePattern -> Option TypeScope
  tuple-patterns context scope types patterns = case (types, patterns) of
    (UEnd, CPDone sp) -> Some scope
    (UArg ty rest, CPField sp first more) -> case pattern-scope context scope ty first of Some bound -> tuple-patterns context bound rest more; None -> None
    other -> None
  arrow-domain :: UType -> Option (UType, UType)
  arrow-domain ty = case ty of
    UFun a b -> Some (a, empty-row)
    UFunEff a row b -> Some (a, row)
    UProofFun predicate row result -> Some (predicate, row)
    UUsageArrow usage arrow -> if valid-type ty then arrow-domain arrow else None
    UPi id name a row b -> Some (a, row)
    other -> None
  constructor-fields :: TypingContext -> TypeScope -> UType -> UType -> CorePattern -> Option TypeScope
  constructor-fields context scope expected ty fields = case fields of
    CPDone sp -> if equal-type-in context expected ty || same-data-head (reduce-in context expected) (reduce-in context ty) then Some scope else None
    CPField sp first rest -> case arrow-domain ty of
      Some (domain, row) -> if not (effects-fit row empty-row) then None else
        (case pattern-scope context scope domain first of Some bound -> (case pattern-result ty first of Some result -> constructor-fields context bound expected result rest; None -> None); None -> None)
      None -> None
    other -> None
  lookup-local :: Nat -> List (Nat, Scheme) -> Option Scheme
  lookup-local id locals = case locals of [] -> None; (key, sc) : rest -> if key == id then Some sc else lookup-local id rest
  application-result :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> CoreTerm -> Option (UType, UType)
  application-result context scope gamma facts function argument = case arrow-result gamma facts function argument of
    Some result -> Some result
    None -> (case (arrow-shape function, argument) of
      (UPi id name domain row result, CLocal sp ty key display actuals) -> if not (equal-type-in context domain ty) then None else
        (case lookup-local key (scope.locals) of
          Some sc -> (case scheme-params sc of
            q : rest -> let value = UIndex ty (IRigid key display 0) in
              if wf context scope value then Some (substitute-bound [(id, value)] result, substitute-bound [(id, value)] row) else None
            [] -> None)
          None -> None)
      other -> None)
  checked-application :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> UType -> CoreTerm -> CoreTerm -> Bool
  checked-application context scope gamma facts ty row f x =
    let invalidate = not (writes-move-nothing gamma facts) in
    let before-argument = if invalidate then core-mutable-writes f else [] in
    let before-call = if invalidate then before-argument <> core-mutable-writes x else [] in
    not (erased-value-arrow (core-type f))
      && (case core-type f of UUsageArrow UsageMany arrow -> task-shareable context [] 64 (core-type x); other -> True)
      && checked-term context scope gamma facts f
      && checked-term context scope (proof-after-writes gamma before-argument) (facts-after-writes gamma facts before-argument) x
      && (case application-result context scope (proof-after-writes gamma before-call) (facts-after-writes gamma facts before-call) (reduce-in context (core-type f)) x of
        Some (result, effects) -> equal-type-in context result ty && equal-type-in context effects row
        None -> False)
  tuple-terms :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> CoreTerm -> Bool
  tuple-terms context scope gamma facts types terms = case (types, terms) of
    (UEnd, CArgumentsEnd sp) -> True
    (UArg ty rest, CArgument sp first more) -> equal-type-in context ty (core-type first)
      && checked-term context scope gamma facts first
      && (let (next, live) = term-scope gamma facts first in tuple-terms context scope next live rest more)
    other -> False
  mathematical :: UType -> Bool
  mathematical ty = type-is "Int" ty || type-is "Nat" ty
  comparable :: UType -> Bool
  comparable ty = integer-carrier ty || wide-carrier ty || type-is "Bool" ty || type-is "Unit" ty || type-is "Char" ty || string-type ty
  primitive-types :: UType -> String -> CoreTerm -> Bool
  primitive-types ty name arguments = case arguments of
    CArgumentsEnd sp -> type-is "Bool" ty && has name ["decision-true", "decision-false"]
    CArgument sp first (CArgumentsEnd end) ->
      if name == "thunk-delay" then (case thunk-function-parts (core-type first) of
        Some (row, result) -> (case later-parts ty of
          Some carrier -> equal-type carrier result && equal-type row (URow UEnd)
          None -> equal-type ty (thunk-type row result))
        None -> False)
      else if name == "thunk-force" then (case deferral-parts (core-type first) of
        Some (row, result) -> equal-type ty result
        None -> False)
      -- `parWorkers n` sets the participant budget and answers `Unit`; the
      -- count is a `Nat` in source and crosses as a length at lowering.
      else if name == "#kernel.ordered" then type-is "Bool" ty && ordered-carrier (core-type first)
      else if name == "#kernel.ascii" then type-is "Bool" ty && ascii-carrier (core-type first)
      else if name == "#kernel.length" then type-is "Nat" ty && length-carrier (core-type first)
      else if name == "par-workers" then type-is "Unit" ty && type-is "Nat" (core-type first)
      else name == "negate" && type-is "Int" ty && equal-type ty (core-type first)
    CArgument sp first (CArgument at second (CArgumentsEnd end)) ->
      case name of
      "par-both" -> par-both-type ty first second
      "par-tabulate" -> par-tabulate-type ty first second
      "par-map" -> par-map-type ty first second
      _ -> let carrier = core-type first in
        equal-type carrier (core-type second) && (if has name ["+", "-", "*", "/"] then mathematical carrier && equal-type ty carrier
          else if has name ["<", "<=", ">", ">="] then integer-carrier carrier && type-is "Bool" ty
          else if has name ["==", "/="] then comparable carrier && type-is "Bool" ty
          else False)
    other -> False
  -- `parBoth f g` = `(f (), g ())`, so the result is the pair of the two
  -- callbacks' results and each callback is a one-shot thunk over Unit.
  par-both-type :: UType -> CoreTerm -> CoreTerm -> Bool
  par-both-type ty f g = case (thunk-function-parts (core-type f), thunk-function-parts (core-type g)) of
    (Some (row-f, a), Some (row-g, b)) -> equal-type ty (UTuple (UArg a (UArg b UEnd)))
    other -> False
  -- `parTabulate n f` = `array-tabulate n f`: one index, one call.
  par-tabulate-type :: UType -> CoreTerm -> CoreTerm -> Bool
  par-tabulate-type ty count callback = case task-type-spine ty [] of
    (UCon name kind, args) -> if name == "Array" && kind-equal kind (KFun KType KType) then (case args of
      [element] -> (case arrow-shape (core-type callback) of
        UFunEff domain row result -> type-is "Nat" (core-type count) && type-is "Nat" domain && equal-type result element
        UFun domain result -> type-is "Nat" (core-type count) && type-is "Nat" domain && equal-type result element
        other -> False)
      other -> False) else False
    other -> False
  -- `parMap f xs` = `map f xs`, lowered as
  -- `array-to-list (parMapArray f (array-from-list xs))`: the primitive's
  -- result is the mapped `Array`, and its callback's domain is that array's
  -- element type (section 4.2).
  par-map-type :: UType -> CoreTerm -> CoreTerm -> Bool
  par-map-type ty callback array = case task-type-spine ty [] of
    (UCon name kind, args) -> if name == "Array" && kind-equal kind (KFun KType KType) then (case args of
      [element] -> (case (arrow-shape (core-type callback), element-of (core-type array)) of
        (UFunEff domain row result, Some source) -> equal-type domain source && equal-type result element
        (UFun domain result, Some source) -> equal-type domain source && equal-type result element
        other -> False)
      other -> False) else False
    other -> False
  element-of :: UType -> Option UType
  element-of ty = case task-type-spine ty [] of
    (UCon name kind, args) -> (case args of [element] -> Some element; other -> None)
    other -> None
  argument-terms :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> CoreTerm -> Bool
  argument-terms context scope gamma facts terms = case terms of
    CArgumentsEnd sp -> True
    CArgument sp first rest -> checked-term context scope gamma facts first
      && (let (next, live) = term-scope gamma facts first in argument-terms context scope next live rest)
    other -> False
  alternatives-typed :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> CoreTerm -> UType -> CoreTerm -> Bool
  alternatives-typed context scope gamma facts scrutinee expected alternatives = case alternatives of
    CAlternativesEnd sp -> True
    CAlternative sp pattern body rest -> (case pattern-scope context scope (core-type scrutinee) pattern of
      Some bound -> let row-scope = proof-pattern pattern gamma in
        let introduced = facts-after-writes row-scope (scoped-core-case-facts row-scope facts scrutinee pattern True) (core-mutable-writes scrutinee) in
        equal-type-in context expected (core-type body) && checked-term context bound row-scope (introduced <> facts) body
      None -> False) && (let writes = guard-fallthrough-writes body in
        let introduced = scoped-core-case-rest-facts gamma facts scrutinee pattern body <> facts in
        alternatives-typed context scope (proof-after-writes gamma writes) (facts-after-writes gamma introduced writes) scrutinee expected rest)
    other -> False
  -- A term's carrier is a value type or a proposition. `proper-type` alone is
  -- right for a runtime value and wrong for a proof former's body: `same v =
  -- refl` has a `Prop` carrier, and demanding `KType` here refused every proof
  -- former after the definition closure had already accepted it.
  checked-term-carrier :: UType -> Bool
  checked-term-carrier ty = proper-type ty || (valid-type ty && kind-equal (type-kind ty) KProp)
  checked-term :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> CoreTerm -> Bool
  checked-term context scope gamma facts term = checked-term-carrier (core-type term) && wf context scope (core-type term) && (case term of
    CUse sp ty name role actuals -> actual-types context scope actuals
    CLocal sp ty id name actuals -> actual-types context scope actuals
    CQualifiedUse sp ty name role actuals evidence -> actual-types context scope actuals && evidences-types context scope evidence
    CMethod sp ty name owner slot actuals evidence -> actual-types context scope actuals && evidences-types context scope evidence
    CInt sp ty value -> number-literal-carrier ty
    CString sp ty value -> string-type ty
    CChar sp ty value -> type-is "Char" ty && char-value value
    CSymbol sp ty value -> type-is "Sym" ty
    CUnit sp ty -> type-is "Unit" ty
    CApply sp ty f x -> checked-application context scope gamma facts ty empty-row f x
    CApplyEff sp ty row f x -> wf context scope row && checked-application context scope gamma facts ty row f x
    CHandler sp ty returned operations -> checked-handler context scope gamma facts ty returned operations
    CHandle sp ty label residual body handled-by -> checked-handle context scope gamma facts ty label residual body handled-by
    CDecision sp ty predicate condition -> wf context scope predicate && checked-term context scope gamma facts condition && scoped-decision-valid gamma facts ty predicate condition
    CErasedApply sp ty row f witness -> wf context scope row && checked-term context scope gamma facts f
      && (case reduce-in context (core-type f) of
        UProofFun predicate effects result -> let writes = core-mutable-writes f in
          equal-type-in context result ty && equal-type-in context effects row && wf context scope predicate
          && scoped-erased-witness (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) predicate witness
        UUsageArrow UsageZero arrow -> let writes = core-mutable-writes f in
          let next = proof-after-writes gamma writes in
          let live = facts-after-writes gamma facts writes in
          erasable-value-argument witness && checked-term context scope next live witness
            && (case arrow-result next live arrow witness of
              Some (result, effects) -> equal-type-in context result ty && equal-type-in context effects row
              None -> False)
        other -> False)
    CLambda sp ty pattern body -> (case (arrow-domain (reduce-in context ty), pattern-result (reduce-in context ty) pattern) of
      (Some (domain, row), Some result) -> (case arrow-pattern-scope context scope ty domain pattern of
        Some bound -> let writes = [(sp, (None :: Option UType))] in equal-type-in context result (core-type body)
          && checked-term context bound (proof-pattern pattern (proof-after-writes gamma writes)) (facts-after-writes gamma facts writes) body
          && effects-fit (core-effects body) row && pattern-usage-allowed context ty pattern body
        None -> False)
      other -> False)
    CScope sp ty region evidence callback -> checked-scope context scope gamma facts ty region evidence callback
    CMemoScope sp ty region body -> checked-memo-scope context scope gamma facts ty region body
    CSpawn sp ty token body -> checked-spawn ty token body && checked-term context scope gamma facts token && checked-term context scope gamma facts body
    CJoin sp ty token handles -> (case task-join-result token handles of Some result -> equal-type-in context ty result; None -> False) && checked-term context scope gamma facts token && argument-terms context scope gamma facts handles
    CWith sp ty given value body -> wf context scope (given.ty) && equal-type-in context (given.ty) (core-type value)
      && equal-type-in context ty (core-type body) && checked-term context scope gamma facts value
      && checked-term (with-copy-givens context [given]) scope (proof-after-writes gamma (core-mutable-writes value)) (facts-after-writes gamma facts (core-mutable-writes value)) body
    CLet sp ty id name sc rhs body -> checked-let context scope gamma facts ty id sc rhs body
    CRecursiveFunctions sp ty members body -> equal-type-in context ty (core-type body)
      && (case recursive-type-scope context scope members of
        Some bound -> let proofs = recursive-proof-scope gamma members in
          checked-recursive-functions context bound proofs facts members && checked-term context bound proofs facts body
        None -> False)
    CRecursiveValues sp ty region members body -> equal-type-in context ty (core-type body)
      && scope-region-closed region ty && scope-region-closed region (core-effects term)
      && (case recursive-type-scope context scope members of
        Some bound ->
          let writes = recursive-value-writes members in
          let proofs = proof-after-writes (recursive-proof-scope gamma members) writes in
          let live = facts-after-writes gamma facts writes in
          checked-recursive-values context bound proofs live members && checked-term context bound proofs live body
        None -> False)
    CIf sp ty condition yes no -> type-is "Bool" (core-type condition) && equal-type-in context ty (core-type yes) && equal-type-in context ty (core-type no)
      && checked-term context scope gamma facts condition
      && checked-term context scope (proof-after-writes gamma (scoped-branch-writes condition True)) (scoped-branch-facts gamma facts condition True) yes
      && checked-term context scope (proof-after-writes gamma (scoped-branch-writes condition False)) (scoped-branch-facts gamma facts condition False) no
    CCase sp ty value alternatives -> let writes = core-mutable-writes value in
      checked-term context scope gamma facts value
        && alternatives-typed context scope (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) value ty alternatives
    CTuple sp ty fields -> (case reduce-in context ty of
      USigma id name domain body -> (case fields of
        CArgument sp1 first (CArgument sp2 second (CArgumentsEnd end)) ->
          equal-type-in context domain (core-type first)
            && checked-term context scope gamma facts first
            && (let (next, live) = term-scope gamma facts first in
              case application-result context scope next live (UPi id name domain (URow UEnd) body) first of
                Some (opened, row) -> equal-type-in context opened (core-type second) && checked-term context scope next live second
                None -> False)
        other -> False)
      other -> case tuple-fields other of Some types -> tuple-terms context scope gamma facts types fields; None -> False)
    -- design/rank-n-polymorphism.md section 8: a generalisation's body has
    -- the polytype's body opened at its rigid ids and performs nothing; an
    -- instantiation opens its value's polytype at forall-free arguments.
    CPolyIntro sp ty ids body -> (case ty of
      UForall qs inner -> list-length ids == quants-length qs && wf context scope ty
        && equal-type-in context (substitute-bound (poly-rigid-pairs (quants-list qs) ids) inner) (core-type body)
        && effects-fit (core-effects body) (URow UEnd)
        -- The skolems are in scope, as rigid variables, for the body only.
        && (case poly-rigid-scope (quants-list qs) ids scope of
          Some opened -> checked-term context opened gamma facts body
          None -> False)
      other -> False)
    CPolyElim sp ty value args -> (case core-type value of
      UForall qs inner -> list-length args == quants-length qs && poly-arguments-wf context scope args
        && equal-type-in context ty (substitute-bound (poly-argument-pairs (quants-list qs) args) inner)
        && checked-term context scope gamma facts value
      other -> False)
    CQualIntro sp ty givens body -> (case ty of
      UQual qs inner -> list-length givens == uquals-length qs && wf context scope ty
        && qual-givens-match context (uquals-list qs) givens
        && equal-type-in context inner (core-type body)
        && effects-fit (core-effects body) (URow UEnd)
        && checked-term (with-copy-givens context givens) scope gamma facts body
      other -> False)
    CQualElim sp ty value evs -> (case core-type value of
      UQual qs inner -> list-length evs == uquals-length qs
        && qual-evidences-match context (uquals-list qs) evs
        && equal-type-in context ty inner
        && checked-term context scope gamma facts value
      other -> False)
    CPrimitive sp ty name args -> (if name == "copy-out" then copy-out-checked context ty args
      else if has name ["borrow", "mut-borrow"] then borrow-checked scope (name == "mut-borrow") ty args
      else if name == "ref-set" then ref-set-checked ty args
      else if has name ["memo-alloc", "memo-init", "memo-demand"] then checked-memo-primitive context scope ty name args
      else primitive-types ty name args)
      && argument-terms context scope gamma facts args
    CProved sp ty certificate body -> equal-type-in context ty (core-type body) && checked-term context scope gamma facts body
    CRefine sp ty certificate body -> (case refinement-view ty of URefine id name carrier predicate -> equal-type-in context carrier (core-type body) && checked-term context scope gamma facts body; other -> False)
    CRefineProof sp ty witness body -> wf context scope (core-type witness) && checked-term context scope gamma facts body && scoped-refinement-proof gamma facts ty witness body
    CForget sp ty body -> (case (refinement-view (core-type body), ty) of
      (URefine id name carrier predicate, requested) -> equal-type-in context carrier requested
      (UTuple fields, UTuple requested) -> forgotten-tuple-fields fields requested
      other -> False) && checked-term context scope gamma facts body
    CCast sp ty body -> checked-term context scope gamma facts body
    CRequire sp ty body -> (case ty of URequire predicates result -> equal-type-in context result (core-type body) && (case scoped-core-predicates gamma predicates of Some introduced -> checked-term context scope gamma (introduced <> facts) body; None -> False); other -> False)
    CDischarge sp ty certificates _ body -> equal-type-in context ty (required-body (core-type body)) && checked-term context scope gamma facts body
    CGuard sp ty condition body -> type-is "Bool" (core-type condition) && equal-type-in context ty (core-type body) && checked-term context scope gamma facts condition && checked-term context scope (proof-after-writes gamma (scoped-branch-writes condition True)) (scoped-branch-facts gamma facts condition True) body
    -- Reflexive evidence is the one proof term an ordinary body may be, and
    -- its carrier is the goal it discharges. `reflexive-equality` is the whole
    -- check: the goal's two sides must be definitionally equal.
    CProofRefl sp predicate -> reflexive-equality predicate
    other -> False)
  task-data-closed :: KindIndex -> List CoreData -> Bool
  task-data-closed kinds datas = case datas of
    [] -> True
    d : rest -> core-data-closed d && effect-kind-declared (core-data-name d) (core-data-kind d) kinds && task-data-closed kinds rest
  task-data :: String -> List CoreData -> Option CoreData
  task-data name datas = case datas of [] -> None; d : rest -> if name == core-data-name d then Some d else task-data name rest
  task-base :: UType -> UType
  task-base ty = case refinement-view ty of URefine id name carrier predicate -> task-base carrier; URequire predicates body -> task-base body; other -> ty
  task-type-spine :: UType -> List UType -> (UType, List UType)
  task-type-spine ty args = case task-base ty of UApp f x -> task-type-spine f (x : args); other -> (other, args)
  task-actuals :: List Quant -> List UType -> List (Nat, UType)
  task-actuals qs args = case (qs, args) of (q : rest, a : more) -> (q.id, a) : (task-actuals rest more); other -> []
  task-seen-type :: UType -> List UType -> Bool
  task-seen-type ty seen = case seen of
    [] -> False
    old : rest ->
      (if same-shape ty old then valid-type ty
       else (case (typing-type-head ty, typing-type-head old) of
         (UCon na _, UCon nb _) -> na == nb && equal-type ty old
         other -> equal-type ty old)) || task-seen-type ty rest
  -- A partial imported constructor table or an opaque resource supplies no
  -- structural Copy evidence.
  copyable-type :: TypingContext -> List UType -> Nat -> UType -> Bool
  copyable-type context seen fuel ty = if fuel == 0 then False else let remaining = fuel - 1 in case task-base ty of
    UTuple fields -> copyable-tuple context seen remaining fields
    USigma id name domain body -> copyable-type context seen remaining domain && copyable-type context seen remaining body
    UApp (UCon name (KFun KType KType)) element -> if cell-type-name name then True else if array-type-name name then copyable-type context seen remaining element
      else copyable-data context seen remaining ty
    UApp (UApp (UCon name kind) region) carrier -> if name == "Ref" then
      (case borrowed-carrier (task-base ty) of Some payload -> True; None -> False)
      else copyable-data context seen remaining ty
    UCon name KType -> has name ["Int", "Nat", "Bool", "Unit", "Char", "AtomicCell", "I8", "I16", "I32", "I64", "Isize", "U8", "U16", "U32", "U64", "Usize", "I128", "U128", "F32", "F64"]
      || copyable-data context seen remaining ty
    other -> copyable-data context seen remaining ty
  copyable-tuple :: TypingContext -> List UType -> Nat -> UType -> Bool
  copyable-tuple context seen fuel fields = case fields of
    UEnd -> True
    UArg first rest -> copyable-type context seen fuel first && copyable-tuple context seen fuel rest
    other -> False
  copyable-data :: TypingContext -> List UType -> Nat -> UType -> Bool
  copyable-data context seen fuel ty = if task-seen-type ty seen then True else case task-type-spine ty [] of
    (UCon name kind, args) -> (case task-data name (context.datas) of
      Some d -> (case core-data-constructors d of
        [] -> copyable-usage context name args (ty : seen) fuel
        constructors -> list-length args == list-length (core-data-params d)
          && copyable-constructors context (ty : seen) fuel (task-actuals (core-data-params d) args) constructors)
      None -> copyable-usage context name args (ty : seen) fuel)
    other -> False
  -- | Apply the ordinary Copy walk to hidden fields without making their constructors callable.
  copyable-usage :: TypingContext -> String -> List UType -> List UType -> Nat -> Bool
  copyable-usage context owner args seen fuel = case task-usage-fields context owner args of
    Some fields -> copyable-fields context seen fuel [] fields
    None -> False
  copyable-constructors :: TypingContext -> List UType -> Nat -> List (Nat, UType) -> List CoreConstructor -> Bool
  copyable-constructors context seen fuel pairs constructors = case constructors of
    [] -> True
    constructor : rest -> copyable-fields context seen fuel pairs (core-constructor-fields constructor)
      && copyable-constructors context seen fuel pairs rest
  copyable-fields :: TypingContext -> List UType -> Nat -> List (Nat, UType) -> List UType -> Bool
  copyable-fields context seen fuel pairs fields = case fields of
    [] -> True
    first : rest -> copyable-type context seen fuel (substitute-bound pairs first) && copyable-fields context seen fuel pairs rest
  copy-out-checked :: TypingContext -> UType -> CoreTerm -> Bool
  copy-out-checked context result args = case args of
    CArgument sp value (CArgumentsEnd end) -> equal-type result (copy-out-type (core-type value)) && (scoped-copy context result || copyable-type context [] 64 result)
    other -> False
  borrow-checked :: TypeScope -> Bool -> UType -> CoreTerm -> Bool
  borrow-checked scope mutable result args = case (borrow-type-parts result, args) of
    (Some (actual, region, carrier), CArgument sp value (CArgumentsEnd end)) ->
      actual == mutable && equal-type carrier (core-type value) && not (borrow-scope-conflict scope result)
    other -> False
  ref-set-checked :: UType -> CoreTerm -> Bool
  ref-set-checked result args = type-is "Unit" result && (case args of
    CArgument sp (CLocal at ty id name actuals) (CArgument bt value (CArgumentsEnd end)) ->
      (case mutable-borrow ty of Some (region, carrier) -> equal-type carrier (core-type value); None -> False)
    other -> False)
  checked-memo-scope :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> UType -> CoreTerm -> Bool
  checked-memo-scope context scope gamma facts result region body = case region of
    URigid id name level KRegion -> equal-type result (core-type body) && scope-region-closed region result
      && scope-region-closed region (memo-residual region (core-effects body))
      && (case open-memo-region id scope of
        Some opened -> checked-term context opened gamma facts body
        None -> False)
    other -> False
  checked-memo-primitive :: TypingContext -> TypeScope -> UType -> String -> CoreTerm -> Bool
  checked-memo-primitive context scope result op args = case args of
    CArgumentsEnd sp -> op == "memo-alloc" && (case lazy-parts result of
      Some (row, region, carrier) -> in-memo-region region scope && scope-region-closed region row
        && scope-region-closed region carrier && copyable-type context [] 64 carrier
      None -> False)
    CArgument sp cell (CArgumentsEnd end) -> op == "memo-demand" && equal-type result (memo-demand-type (core-type cell))
    CArgument sp (CLocal at cell id name []) (CArgument bt callback (CArgumentsEnd end)) ->
      op == "memo-init" && type-is "Unit" result && (case (lazy-parts cell, thunk-function-parts (core-type callback)) of
        (Some (row, region, carrier), Some (latent, returned)) -> in-memo-region region scope
          && equal-type row latent && equal-type carrier returned && scope-region-closed region row
        other -> False)
    other -> False
  task-signature-decl :: String -> CoreGlobal -> Bool
  task-signature-decl owner decl = case decl of
    GlobalMethod name class slot sc -> owner == class
    GlobalBody d body -> task-signature-decl owner d
    GlobalGuardedBody d body -> task-signature-decl owner d
    other -> False
  task-signature :: String -> List CoreGlobal -> Bool
  task-signature owner declarations = case declarations of
    [] -> False
    first : rest -> if task-signature-decl owner first then True else task-signature owner rest
  -- Structural Copy/Share uses checked complete data declarations. Unknown
  -- carriers and mutable buffers do not acquire sharing from a printed name.
  -- `Sym` is an immortal, immutable interned cell, and `Data.String.String`
  -- wraps a module-private immutable `Bytes` buffer (`StrBuf :: Bytes -> String`)
  -- that no operation mutates, so both are `Share` (design/parallel-evaluation.md
  -- section 2.4). Other private `Bytes` wrappers remain transfer-only.
  -- Pure immutable stdlib containers whose internal spines or constructors
  -- are private in imported interfaces (`base.cpk`): their shareability is
  -- structural over their type arguments, matching the seed when compiled
  -- from source.
  shareable-stdlib-unary :: String -> Bool
  shareable-stdlib-unary name = name == interface-global "Data.Set.Set"
  shareable-stdlib-binary :: String -> Bool
  shareable-stdlib-binary name =
    name == interface-global "Data.HashMap.HashMap"
    || name == interface-global "Data.Map.Map"
  task-shareable :: TypingContext -> List UType -> Nat -> UType -> Bool
  task-shareable context seen fuel ty = case task-shareable-walk context seen fuel ty of
    Some _ -> True
    None -> False
  task-shareable-walk :: TypingContext -> List UType -> Nat -> UType -> Option (List UType)
  task-shareable-walk context seen fuel ty = if fuel == 0 then None else case task-base ty of
    UCon name KType -> if has name ["Int", "Nat", "Bool", "Unit", "Char", "Sym", "String", "AtomicCell", "I8", "I16", "I32", "I64", "Isize", "U8", "U16", "U32", "U64", "Usize", "I128", "U128", "F32", "F64"] || name == global-data-string-string || name == interface-global "Data.Path.Path" then Some seen else task-data-walk context True seen fuel ty
    UTuple fields -> task-fields-walk context True seen fuel fields
    USigma id name domain body -> case task-property-walk context True seen fuel domain of
      None -> None
      Some seen1 -> task-property-walk context True seen1 fuel body
    -- `Array`, `Tensor` and `Columnar` are builtin type formers, not
    -- declarations, so no `CoreData` describes them and the structural walk
    -- below would have no field to read. Their element type decides sharing,
    -- exactly as it does in the seed's `structural_usage` and in
    -- `copyable-type` (design/parallel-evaluation.md section 2.3: an
    -- immutable `Array` is `Share` iff every element is).
    UApp (UCon name kind) element -> if name == "b.Io" then Some seen
      else if (array-type-name name || cell-type-name name || shareable-stdlib-unary name) && kind-equal kind (KFun KType KType) then task-shareable-walk context seen (fuel - 1) element
      else task-data-walk context True seen fuel ty
    UApp (UApp (UCon name kind) owner) region -> if name == "b.Scope" then Some seen
      else if shareable-stdlib-binary name then
        (case task-shareable-walk context seen (fuel - 1) owner of
          None -> None
          Some seen1 -> task-shareable-walk context seen1 (fuel - 1) region)
      else (case borrow-type-parts (task-base ty) of
        Some (False, lifetime, carrier) -> task-shareable-walk context seen (fuel - 1) carrier
        other -> task-data-walk context True seen fuel ty)
    URigid id name level KRegion -> Some seen
    UBound id name KRegion -> Some seen
    other -> task-data-walk context True seen fuel ty
  -- A closed scalar/data value cannot hide a scoped closure. This allows
  -- ordinary saturated calls to return such values without inventing loans.
  task-region-free-type :: TypingContext -> List UType -> Nat -> UType -> Bool
  task-region-free-type context seen fuel ty = case task-region-free-walk context seen fuel ty of
    Some _ -> True
    None -> False
  task-region-free-walk :: TypingContext -> List UType -> Nat -> UType -> Option (List UType)
  task-region-free-walk context seen fuel ty = if fuel == 0 then None else case task-base ty of
    UCon name KType -> if has name ["Int", "Nat", "Bool", "Unit", "Char", "String", "Bytes", "Sym", "AtomicCell", "I8", "I16", "I32", "I64", "Isize", "U8", "U16", "U32", "U64", "Usize", "I128", "U128", "F32", "F64"] || name == global-data-string-string || name == interface-global "Data.Path.Path" then Some seen else task-data-walk context False seen fuel ty
    UTuple fields -> task-fields-walk context False seen fuel fields
    USigma id name domain body -> case task-property-walk context False seen fuel domain of
      None -> None
      Some seen1 -> task-property-walk context False seen1 fuel body
    UApp (UCon name kind) element | (cell-type-name name || shareable-stdlib-unary name) && kind-equal kind (KFun KType KType) -> task-region-free-walk context seen (fuel - 1) element
    UApp (UApp (UCon name kind) first) second | shareable-stdlib-binary name ->
      (case task-region-free-walk context seen (fuel - 1) first of
        None -> None
        Some seen1 -> task-region-free-walk context seen1 (fuel - 1) second)
    other -> task-data-walk context False seen fuel ty
  task-property-walk :: TypingContext -> Bool -> List UType -> Nat -> UType -> Option (List UType)
  task-property-walk context sharing seen fuel ty = if sharing then task-shareable-walk context seen fuel ty else task-region-free-walk context seen fuel ty
  task-fields-walk :: TypingContext -> Bool -> List UType -> Nat -> UType -> Option (List UType)
  task-fields-walk context sharing seen fuel fields = case fields of
    UEnd -> Some seen
    UArg ty more -> case task-property-walk context sharing seen fuel ty of
      None -> None
      Some seen1 -> task-fields-walk context sharing seen1 fuel more
    other -> None
  task-types-property :: TypingContext -> Bool -> List UType -> Nat -> List UType -> Bool
  task-types-property context sharing seen fuel types = case task-types-walk context sharing seen fuel types of
    Some _ -> True
    None -> False
  task-types-walk :: TypingContext -> Bool -> List UType -> Nat -> List UType -> Option (List UType)
  task-types-walk context sharing seen fuel types = case types of
    [] -> Some seen
    ty : rest -> case task-property-walk context sharing seen fuel ty of
      None -> None
      Some seen1 -> task-types-walk context sharing seen1 fuel rest
  task-data-walk :: TypingContext -> Bool -> List UType -> Nat -> UType -> Option (List UType)
  task-data-walk context sharing seen fuel ty = if fuel == 0 then None else if task-seen-type ty seen then Some seen else case task-type-spine ty [] of
    (UCon name kind, args) -> if sharing && task-signature name (context-declarations context) then task-types-walk context True (ty : seen) (fuel - 1) args else
      (case task-data name (context.datas) of
        None -> task-usage-walk context name args sharing (ty : seen) (fuel - 1)
        Some d -> if list-length args == list-length (core-data-params d) then (case core-data-constructors d of
          [] -> task-usage-walk context name args sharing (ty : seen) (fuel - 1)
          constructors -> task-constructors-walk context sharing (ty : seen) (fuel - 1) (task-actuals (core-data-params d) args) constructors) else None)
    other -> None
  task-constructors-walk :: TypingContext -> Bool -> List UType -> Nat -> List (Nat, UType) -> List CoreConstructor -> Option (List UType)
  task-constructors-walk context sharing seen fuel pairs ctors = case ctors of
    [] -> Some seen
    ctor : rest -> case task-types-walk context sharing seen fuel (map-task-types pairs (core-constructor-fields ctor)) of
      None -> None
      Some seen1 -> task-constructors-walk context sharing seen1 fuel pairs rest
  map-task-types :: List (Nat, UType) -> List UType -> List UType
  map-task-types pairs types = case types of [] -> []; ty : rest -> (substitute-bound pairs ty) : (map-task-types pairs rest)
  data TaskLocal where
    TaskLocal :: Nat -> UType -> List UType -> Bool -> Bool -> TaskLocal
    TaskKnotLocal :: Nat -> UType -> UType -> List UType -> TaskLocal
  record TaskTrace where
    trace-error :: Option (Span, String)
    trace-regions :: List UType
    trace-shared :: Bool
  first-task-error :: Option (Span, String) -> Option (Span, String) -> Option (Span, String)
  first-task-error first second = case first of None -> second; Some error -> first
  require-task :: Bool -> Span -> String -> Option (Span, String)
  require-task valid sp message = if valid then None else Some (sp, message)
  task-use-error :: Span -> Option (Span, String)
  task-use-error sp = Some (sp, "task handle must be consumed exactly once")
  task-drop-error :: Span -> Option (Span, String)
  task-drop-error sp = Some (sp, "task handle must be joined exactly once")
  task-local :: Nat -> List TaskLocal -> Option TaskLocal
  task-local id env = case env of
    [] -> None
    entry : rest -> case entry of
      TaskLocal key ty regions shared owned -> if id == key then Some entry else task-local id rest
      TaskKnotLocal key ty region regions -> if id == key then Some entry else task-local id rest
  task-pattern-ids :: CorePattern -> List Nat
  task-pattern-ids p = case p of CPVar sp ty id name -> [id]; CPProof sp ty id name -> [id]; CPErasedValue sp ty id name -> [id]; CPAs sp ty id name inner -> id : (task-pattern-ids inner); CPConstructor sp ty name actuals constructor fields -> task-pattern-ids fields; CPTuple sp ty fields -> task-pattern-ids fields; CPField sp first rest -> task-pattern-ids first <> task-pattern-ids rest; other -> []
  task-id-present :: Nat -> List Nat -> Bool
  task-id-present id ids = case ids of [] -> False; key : rest -> id == key || task-id-present id rest
  task-pattern-env :: CorePattern -> List UType -> Bool -> Bool -> List TaskLocal -> List TaskLocal
  task-pattern-env p regions shared owned env = case p of
    CPVar sp ty id name -> (TaskLocal id ty regions shared owned) : env
    CPProof sp ty id name -> env
    CPErasedValue sp ty id name -> env
    CPAs sp ty id name inner -> (TaskLocal id ty regions shared (owned && (case inner of CPWild at carrier -> True; other -> False))) : (task-pattern-env inner regions shared False env)
    CPConstructor sp ty name actuals constructor fields -> task-pattern-env fields regions shared False env
    CPTuple sp ty fields -> task-pattern-env fields regions shared False env
    CPField sp first rest -> task-pattern-env rest regions shared False (task-pattern-env first regions shared False env)
    other -> env
  transfer-parameter :: UType -> Bool
  transfer-parameter function = case function of UUsageArrow UsageOne arrow -> True; UUsageArrow UsageAffine arrow -> True; other -> False
  transferable-local :: List TaskLocal -> Nat -> Bool
  transferable-local env id = case task-local id env of
    Some (TaskLocal key ty regions shared owned) -> owned || affine-thunk ty
    other -> False
  transferred-alias :: List TaskLocal -> CoreTerm -> Bool
  transferred-alias env term = case term of
    CLocal sp ty id name [] -> transferable-local env id
    other -> False
  task-regions :: UType -> List UType
  task-regions ty = case task-base ty of
    URigid id name level KRegion -> [ty]
    UBound id name KRegion -> [ty]
    UApp f x -> task-regions f <> task-regions x
    UFun a b -> task-regions a <> task-regions b
    UFunEff a row b -> task-regions a <> task-regions row <> task-regions b
    UPi id name a row b -> task-regions a <> task-regions row <> task-regions b
    USigma id name domain body -> task-regions domain <> task-regions body
    UTuple fields -> task-regions fields
    UForall qs body -> task-regions body
    UQual qs body -> uquals-task-regions qs <> task-regions body
    UArg first rest -> task-regions first <> task-regions rest
    URow labels -> task-regions labels
    URowJoin a b -> task-regions a <> task-regions b
    other -> []
  uquals-task-regions :: UQuals -> List UType
  uquals-task-regions qs = case qs of
    UQEnd -> []
    UQCons name ty rest -> task-regions ty <> uquals-task-regions rest
  qual-givens-match :: TypingContext -> List Requirement -> List CoreGiven -> Bool
  qual-givens-match context reqs givens = case (reqs, givens) of
    ([], []) -> True
    (r : rs, g : gs) -> equal-type-in context (r.ty) (g.ty) && qual-givens-match context rs gs
    other -> False
  qual-evidences-match :: TypingContext -> List Requirement -> List CoreEvidence -> Bool
  qual-evidences-match context reqs evs = case (reqs, evs) of
    ([], []) -> True
    (r : rs, e : es) -> equal-type-in context (r.ty) (evidence-type e) && qual-evidences-match context rs es
    other -> False
  task-region-present :: UType -> List UType -> Bool
  task-region-present region regions = case regions of [] -> False; first : rest -> equal-type region first || task-region-present region rest
  task-outlives :: List UType -> UType -> UType -> UType -> Bool
  task-outlives scopes owner destination captured = if equal-type owner captured || equal-type destination captured then True
    else if not (task-region-present captured scopes) then task-region-present destination scopes
    else task-enclosing scopes destination captured
  task-enclosing :: List UType -> UType -> UType -> Bool
  task-enclosing scopes destination captured = case scopes of [] -> False; first : rest -> if equal-type destination first then task-region-present captured rest else task-enclosing rest destination captured
  task-capture-regions :: List UType -> UType -> UType -> List UType -> Bool
  task-capture-regions scopes owner destination regions = case regions of [] -> True; region : rest -> task-outlives scopes owner destination region && task-capture-regions scopes owner destination rest
  task-evidence-regions :: CoreEvidence -> List UType
  task-evidence-regions evidence = case evidence of
    CEGiven sp ty name -> task-regions ty
    CEInstance sp ty symbol actuals args -> task-regions ty <> task-evidence-regions args
    CEArgument sp first rest -> task-evidence-regions first <> task-evidence-regions rest
    other -> []
  task-evidences-regions :: List CoreEvidence -> List UType
  task-evidences-regions evidence = case evidence of [] -> []; first : rest -> task-evidence-regions first <> task-evidences-regions rest
  task-scoped-type :: UType -> Bool
  task-scoped-type ty = case (scope-parameters (task-base ty), task-parts (task-base ty)) of (None, None) -> False; other -> True
  task-handle-type :: UType -> Bool
  task-handle-type ty = case task-parts (task-base ty) of Some parts -> True; None -> False
  task-free :: List Nat -> CoreTerm -> List (Nat, UType)
  task-free bound term = case term of
    CLocal sp ty id name actuals -> if task-id-present id bound then [] else [(id, ty)]
    CLambda sp ty p body -> task-free (task-pattern-ids p <> bound) body
    CLet sp ty id name sc rhs body -> task-free bound rhs <> task-free (id : bound) body
    CRecursiveFunctions sp ty members body ->
      task-free-children (recursive-function-ids members <> bound) (body : (recursive-functions members))
    CRecursiveValues sp ty region members body ->
      task-free-children (recursive-function-ids members <> bound) (recursive-functions members <> [body])
    CAlternative sp p body rest -> task-free (task-pattern-ids p <> bound) body <> task-free bound rest
    other -> task-free-children bound (runtime-term-children term)
  task-free-children :: List Nat -> List CoreTerm -> List (Nat, UType)
  task-free-children bound terms = case terms of [] -> []; first : rest -> task-free bound first <> task-free-children bound rest
  task-free-regions :: List TaskLocal -> List (Nat, UType) -> List UType
  task-free-regions env free = case free of
    [] -> []
    (id, ty) : rest -> task-regions ty <> (case task-local id env of
      Some (TaskLocal key declared regions shared owned) -> regions
      Some (TaskKnotLocal key declared region regions) -> region : regions
      None -> []) <> task-free-regions env rest
  task-free-sharing :: TypingContext -> List (Nat, UType) -> Bool
  task-free-sharing context free = case free of [] -> True; (id, ty) : rest -> (task-handle-type ty || task-shareable context [] 64 ty) && task-free-sharing context rest
  task-free-scopes :: List TaskLocal -> List (Nat, UType) -> Bool
  task-free-scopes env free = case free of
    [] -> True
    (id, ty) : rest -> not (task-scoped-type ty) && (case task-local id env of
      Some (TaskLocal key declared regions shared owned) -> no-ordinary-scope regions
      Some (TaskKnotLocal key declared region regions) -> no-ordinary-scope regions
      None -> True) && task-free-scopes env rest
  no-ordinary-scope :: List UType -> Bool
  no-ordinary-scope regions = case regions of
    [] -> True
    region : rest -> (case knot-region-name region of Some name -> no-ordinary-scope rest; None -> False)
  -- The bounds describe the least and most uses on the reachable paths.
  -- None marks a use captured by a closure with unknown invocation count.
  use-count-sequence :: Option (Nat, Nat) -> Option (Nat, Nat) -> Option (Nat, Nat)
  use-count-sequence a b = case (a, b) of (Some (low, high), Some (more-low, more-high)) -> Some (low + more-low, high + more-high); other -> None
  use-count-choice :: Option (Nat, Nat) -> Option (Nat, Nat) -> Option (Nat, Nat)
  use-count-choice a b = case (a, b) of
    (Some (left-low, left-high), Some (right-low, right-high)) ->
      Some (if left-low < right-low then left-low else right-low, if left-high > right-high then left-high else right-high)
    other -> None
  -- An effect operation may drop its continuation. Kernel spawn instead
  -- transfers its closure and returns a task handle before it continues.
  data UseInterruptions where
    Uninterrupted :: UseInterruptions
    MayInterrupt :: UseInterruptions
    CountingPlace :: List Nat -> UseInterruptions -> UseInterruptions
    ResumingContext :: TypingContext -> UType -> UseInterruptions
  interrupts-usage :: UseInterruptions -> UType -> Bool
  interrupts-usage policy performed = case policy of
    CountingPlace path inner -> interrupts-usage inner performed
    Uninterrupted -> False
    MayInterrupt -> not (effects-fit performed empty-row)
    ResumingContext context allowed -> not (effects-fit performed allowed)
  -- Only a checked inline handler that resumes on every path can make
  -- its label non-interrupting. Its clause effects still escape.
  resuming-context :: Span -> UseInterruptions -> UType -> CoreTerm -> UseInterruptions
  resuming-context sp policy label handled-by = case (policy, handled-by) of
    (CountingPlace path inner, installed) -> CountingPlace path (resuming-context sp inner label installed)
    (ResumingContext context allowed, CHandler at ty returned operations) -> (case handler-parts ty of
      Some (actual, input, output, latent) -> if equal-type actual label && effects-fit latent allowed then
        (case handler-usage-error context sp True handled-by of
          None -> ResumingContext context (union-effects allowed (URow (UArg label UEnd)))
          Some error -> policy)
        else policy
      None -> policy)
    other -> policy
  use-count-after :: UseInterruptions -> CoreTerm -> Option (Nat, Nat) -> Option (Nat, Nat) -> Option (Nat, Nat)
  use-count-after interrupted first uses next =
    let before = (case first of
      CSpawn sp ty token callback -> union-effects (core-effects token) (core-effects callback)
      other -> core-effects first) in
    use-count-sequence uses (if interrupts-usage interrupted before then use-count-choice (Some (0, 0)) next else next)
  use-count-list :: UseInterruptions -> Nat -> List CoreTerm -> Option (Nat, Nat)
  use-count-list interrupted id terms = case terms of
    [] -> Some (0, 0)
    first : rest -> use-count-after interrupted first (use-count interrupted id first) (use-count-list interrupted id rest)
  use-count-once :: UseInterruptions -> Nat -> CoreTerm -> Option (Nat, Nat)
  use-count-once interrupted id callback = case callback of
    CLambda sp ty p body -> if task-id-present id (task-pattern-ids p) then Some (0, 0) else use-count interrupted id body
    other -> use-count interrupted id callback
  use-count :: UseInterruptions -> Nat -> CoreTerm -> Option (Nat, Nat)
  use-count interrupted id term = case interrupted of
    CountingPlace path inner -> (case record-place id term of
      Some actual -> if place-prefix actual path then Some (1, 1) else Some (0, 0)
      None -> use-count-term interrupted id term)
    other -> use-count-term interrupted id term
  use-count-term :: UseInterruptions -> Nat -> CoreTerm -> Option (Nat, Nat)
  use-count-term interrupted id term = case term of
    CLocal sp ty key name actuals -> if id == key then Some (1, 1) else Some (0, 0)
    CLambda sp ty p body -> if task-id-present id (task-pattern-ids p) then Some (0, 0) else (case use-count interrupted id body of Some (0, 0) -> Some (0, 0); other -> None)
    CLet sp ty key name sc rhs body -> use-count-after interrupted rhs (use-count interrupted id rhs) (if id == key then Some (0, 0) else use-count interrupted id body)
    CIf sp ty condition yes no -> use-count-after interrupted condition (use-count interrupted id condition) (use-count-choice (use-count interrupted id yes) (use-count interrupted id no))
    CCase sp ty value alts -> use-count-after interrupted value (use-count interrupted id value) (use-count-alternatives interrupted id alts)
    CScope sp ty region evidence callback -> use-count-once interrupted id callback
    CPrimitive sp ty op (CArgument at cell (CArgument bt callback (CArgumentsEnd end))) | (op == "memo-init") ->
      use-count-sequence (use-count interrupted id cell) (use-count-choice (Some (0, 0)) (use-count-once interrupted id callback))
    CPrimitive sp ty op (CArgument at callback (CArgumentsEnd end)) | op == "thunk-delay" ->
      use-count-choice (Some (0, 0)) (use-count-once interrupted id callback)
    CSpawn sp ty token callback ->
      use-count-after interrupted token (use-count interrupted id token) (use-count-once interrupted id callback)
    -- A parallel callback runs inside its call and is dropped before the
    -- call returns, so its body is a one-shot frame: a `%1` capture used
    -- once there moves into it, and a second branch using the same value is
    -- the ordinary `used 2 time(s)` (design/parallel-evaluation.md 2.3).
    CPrimitive sp ty op (CArgument at f (CArgument bt g (CArgumentsEnd end))) | (op == "par-both") ->
      use-count-sequence (use-count-once interrupted id f) (use-count-once interrupted id g)
    -- `parMap` and `parTabulate` run their callback once per index, so a
    -- use inside it is unbounded, not one-shot: the parallel capture rule
    -- reports the move (`par-definition-error`), which is the specific
    -- refusal section 2.3 states.
    CPrimitive sp ty op (CArgument at first (CArgument bt second (CArgumentsEnd end))) | (op == "par-tabulate") ->
      use-count-sequence (use-count interrupted id first) (use-count-unbounded id second)
    CPrimitive sp ty op (CArgument at callback (CArgument bt input (CArgumentsEnd end))) | (op == "par-map") ->
      use-count-sequence (use-count-unbounded id callback) (use-count interrupted id input)
    CHandle sp ty label residual body handled-by -> use-count-after interrupted handled-by (use-count interrupted id handled-by)
      (use-count (resuming-context sp interrupted label handled-by) id body)
    other -> use-count-list interrupted id (runtime-term-children term)
  -- A many-shot frame: any use inside the callback is unbounded.
  use-count-unbounded :: Nat -> CoreTerm -> Option (Nat, Nat)
  use-count-unbounded id callback = case callback of
    CLambda sp ty p body -> if task-id-present id (task-pattern-ids p) then Some (0, 0) else (if task-id-present id (task-free-ids body) then None else Some (0, 0))
    other -> use-count Uninterrupted id callback
  task-free-ids :: CoreTerm -> List Nat
  task-free-ids body = case task-free [] body of
    [] -> []
    free -> par-free-ids free
  par-free-ids :: List (Nat, UType) -> List Nat
  par-free-ids free = case free of [] -> []; (id, ty) : rest -> id : (par-free-ids rest)
  use-pattern-total :: CorePattern -> Bool
  use-pattern-total p = case p of CPWild sp ty -> True; CPVar sp ty id name -> True; CPAs sp ty id name inner -> use-pattern-total inner; other -> False
  use-count-row :: UseInterruptions -> Nat -> CoreTerm -> CoreTerm -> Option (Nat, Nat)
  use-count-row interrupted id body rest = case body of
    CGuard sp ty guard value ->
      let branch = use-count interrupted id value in
      let next = if core-alternative-covers body then branch else use-count-choice branch (use-count-alternatives interrupted id rest) in
      use-count-after interrupted guard (use-count interrupted id guard) next
    CLet sp ty key name sc rhs value -> use-count-after interrupted rhs (use-count interrupted id rhs) (use-count-row interrupted id value rest)
    CMemoScope sp ty region value -> use-count-row interrupted id value rest
    CRequire sp ty value -> use-count-row interrupted id value rest
    CDischarge sp ty evidence _ value -> use-count-row interrupted id value rest
    CProved sp ty evidence value -> use-count-row interrupted id value rest
    CRefine sp ty evidence value -> use-count-row interrupted id value rest
    CRefineProof sp ty witness value -> use-count-row interrupted id value rest
    CForget sp ty value -> use-count-row interrupted id value rest
    CCast sp ty value -> use-count-row interrupted id value rest
    other -> use-count interrupted id body
  use-count-alternatives :: UseInterruptions -> Nat -> CoreTerm -> Option (Nat, Nat)
  use-count-alternatives interrupted id alts = case alts of
    CAlternative sp p body (CAlternativesEnd end) -> use-count interrupted id body
    CAlternative sp p body rest -> if task-id-present id (task-pattern-ids p) then use-count-alternatives interrupted id rest
      else if use-pattern-total p then use-count-row interrupted id body rest
      else use-count-choice (use-count-row interrupted id body rest) (use-count-alternatives interrupted id rest)
    other -> None
  -- Pattern matching consumes the outer value of a destructuring pattern.
  -- A variable, or an alias for a wildcard, instead exposes that value to
  -- the body. Other alias forms need joint accounting for the alias and
  -- the inner pattern before they can check a restricted argument.
  -- A generated record projection selects exactly one field by binder
  -- identity. Field positions, including each enclosing projection, decide
  -- whether two places overlap. Display labels alone are insufficient.
  projected-slot :: Nat -> Nat -> CorePattern -> Option Nat
  projected-slot binder index fields = case fields of
    CPField sp (CPVar at ty id name) rest | id == binder && string-starts-with "#record-field:" name ->
      if remaining-wild-fields rest then Some index else None
    CPField sp (CPWild at ty) rest -> projected-slot binder (index + 1) rest
    other -> None
  remaining-wild-fields :: CorePattern -> Bool
  remaining-wild-fields fields = case fields of
    CPDone end -> True
    CPField sp (CPWild at ty) rest -> remaining-wild-fields rest
    other -> False
  record-place :: Nat -> CoreTerm -> Option (List Nat)
  record-place root term = case term of
    CLocal sp ty id name [] -> if id == root then Some [] else None
    CCase sp ty source (CAlternative at (CPConstructor site carrier ctor actuals scheme fields)
      (CLocal field-site field-type binder name []) (CAlternativesEnd end)) | string-starts-with "#record-field:" name ->
      (case (projected-slot binder 0 fields, record-place root source) of
        (Some index, Some path) -> Some (path <> [index])
        other -> None)
    other -> None
  place-prefix :: List Nat -> List Nat -> Bool
  place-prefix first second = case (first, second) of
    ([], rest) -> True
    (a : more, b : tail) -> a == b && place-prefix more tail
    other -> False
  projected-places :: Nat -> List CoreTerm -> List (List Nat)
  projected-places root terms = case terms of
    [] -> []
    first : rest -> (case record-place root first of
      Some [] -> projected-places root rest
      Some path -> path : (projected-places root rest)
      None -> projected-places root (runtime-term-children first) <> projected-places root rest)
  max-place-uses :: UseInterruptions -> Nat -> CoreTerm -> List (List Nat) -> Nat -> Nat -> Option (Nat, Nat)
  max-place-uses policy id body paths min-uses max-uses = case paths of
    [] -> Some (min-uses, max-uses)
    path : rest -> case use-count (CountingPlace path policy) id body of
      Some (low, high) -> max-place-uses policy id body rest (if low > min-uses then low else min-uses) (if high > max-uses then high else max-uses)
      None -> None
  -- Any use consumes the root at least once. On each path the most-used
  -- field counts repeated transfers, while disjoint fields share one split.
  local-use-count :: TypingContext -> Nat -> CoreTerm -> Option (Nat, Nat)
  local-use-count context id body = let policy = ResumingContext context empty-row in
    let direct = use-count policy id body in case direct of
      Some (low, high) | high > 1 -> (case projected-places id [body] of
        [] -> direct
        paths -> (case max-place-uses policy id body paths (if low == 0 then 0 else 1) 0 of
          Some bounds -> Some bounds
          None -> None))
      other -> direct
  pattern-use-count :: TypingContext -> CorePattern -> CoreTerm -> Option (Nat, Nat)
  pattern-use-count context pattern body = case pattern of
    CPVar sp ty id name -> local-use-count context id body
    CPErasedValue sp ty id name -> local-use-count context id body
    CPWild sp ty -> Some (0, 0)
    CPAs sp ty id name (CPWild at inner) -> local-use-count context id body
    CPAs sp ty id name inner -> None
    CPConstructor sp ty name actuals ctor fields -> Some (1, 1)
    CPTuple sp ty fields -> Some (1, 1)
    CPInt sp ty text -> Some (1, 1)
    CPString sp ty text -> Some (1, 1)
    CPChar sp ty text -> Some (1, 1)
    CPSymbol sp ty text -> Some (1, 1)
    other -> None
  use-count-fits :: ArrowUsage -> Option (Nat, Nat) -> Bool
  use-count-fits usage count = case (usage, count) of
    (UsageZero, Some (0, 0)) -> True
    (UsageOne, Some (1, 1)) -> True
    (UsageAffine, Some (low, high)) -> high <= 1
    other -> False
  -- A record projection elaborates to one constructor match returning its
  -- generated field binder. Follow only that binder back to the actual place.
  copies-place :: Nat -> CoreTerm -> Bool
  copies-place id value = case value of
    CLocal sp ty key name actuals -> id == key
    CCase sp ty source (CAlternative at pattern (CLocal field-sp field-ty key name []) (CAlternativesEnd end)) ->
      string-starts-with "#record-field:" name && task-id-present key (task-pattern-ids pattern) && copies-place id source
    other -> False
  -- A strict alias moves the value and inherits the original use obligation.
  alias-usage-error :: TypingContext -> ArrowUsage -> Nat -> CoreTerm -> Option (Span, String)
  alias-usage-error context usage id term = case term of
    CLet sp ty key name sc (CLocal at carrier original display []) body | id == original ->
      let count = local-use-count context key body in
      if not (use-count-fits usage count) then Some (sp, usage-message usage <> usage-detail count)
      else (case alias-usage-error context usage key body of
        Some error -> Some error
        None -> alias-usage-error context usage id body)
    CPrimitive sp ty name (CArgument at value (CArgumentsEnd end)) | (name == "copy-out") ->
      case borrow-type-parts (task-base (core-type value)) of
        None -> if copies-place id value then Some (sp, "multiplicity " <> arrow-usage-text usage <> ": copyOut would duplicate a restricted value")
          else alias-usage-error context usage id value
        Some borrowed -> alias-usage-error context usage id value
    other -> alias-children-error context usage id (runtime-term-children term)
  alias-children-error :: TypingContext -> ArrowUsage -> Nat -> List CoreTerm -> Option (Span, String)
  alias-children-error context usage id children = case children of
    [] -> None
    first : rest -> case alias-usage-error context usage id first of
      Some error -> Some error
      None -> alias-children-error context usage id rest
  pattern-usage-allowed :: TypingContext -> UType -> CorePattern -> CoreTerm -> Bool
  pattern-usage-allowed context function pattern body = case pattern-usage-error context (Span 0 0 1 1) function pattern body of
    None -> True
    Some error -> False
  annotated-arrow :: UType -> Bool
  annotated-arrow ty = case ty of UUsageArrow usage arrow -> True; other -> False
  -- The observed use count, named the way a reader counts uses: never,
  -- on some paths only, or a number.
  usage-detail :: Option (Nat, Nat) -> String
  usage-detail count = case count of
    Some (0, 0) -> " (never used)"
    Some (0, high) -> " (unused on some path)"
    Some (low, high) -> if low == high then string-concat-all [" (used ", nat-to-string high, " time(s))"]
      else string-concat-all [" (used ", nat-to-string low, " to ", nat-to-string high, " time(s))"]
    None -> " (captured by a closure that can use it unboundedly)"
  usage-message :: ArrowUsage -> String
  usage-message usage = case usage of
    UsageZero -> "multiplicity %0: an erased argument must never be used at runtime"
    UsageOne -> "multiplicity %1: the argument must be used exactly once on every path"
    UsageAffine -> "multiplicity %aff: the argument must be used at most once on every path"
    UsageMany -> "multiplicity %many: the argument needs structural Share evidence"
  pattern-usage-error :: TypingContext -> Span -> UType -> CorePattern -> CoreTerm -> Option (Span, String)
  pattern-usage-error context sp function pattern body = case function of
    UUsageArrow usage arrow ->
      let site = case pattern of CPVar at ty id name -> at; CPErasedValue at ty id name -> at; CPWild at ty -> at; CPAs at ty id name inner -> at; other -> sp in
      if (case usage of UsageMany -> True; other -> False) then (if task-shareable context [] 64 (pattern-type pattern) then None
        else Some (site, usage-message usage <> usage-detail (pattern-use-count context pattern body))) else
      let count = pattern-use-count context pattern body in
      if not (use-count-fits usage count) then Some (site, usage-message usage <> usage-detail count)
      else (case pattern of
        CPVar at ty id name -> alias-usage-error context usage id body
        CPErasedValue at ty id name -> alias-usage-error context usage id body
        CPAs at ty id name (CPWild inner carrier) -> alias-usage-error context usage id body
        other -> None)
    other -> None
  -- Before a guard commits to this equation, a later equation can still
  -- receive the same argument. An owned argument cannot move on that path.
  guard-falls-through :: CoreTerm -> Bool
  guard-falls-through body = case body of
    CGuard sp ty guard value -> not (core-alternative-covers body)
    CLet sp ty id name sc rhs value -> guard-falls-through value
    CRequire sp ty value -> guard-falls-through value
    CDischarge sp ty evidence _ value -> guard-falls-through value
    CProved sp ty evidence value -> guard-falls-through value
    CRefine sp ty evidence value -> guard-falls-through value
    CRefineProof sp ty witness value -> guard-falls-through value
    CForget sp ty value -> guard-falls-through value
    CCast sp ty value -> guard-falls-through value
    other -> False
  guard-uses :: Nat -> CoreTerm -> Option (Nat, Nat)
  guard-uses id body = case body of
    CGuard sp ty guard value -> use-count MayInterrupt id guard
    CLet sp ty key name sc rhs value -> use-count-after MayInterrupt rhs (use-count MayInterrupt id rhs) (guard-uses id value)
    CRequire sp ty value -> guard-uses id value
    CDischarge sp ty evidence _ value -> guard-uses id value
    CProved sp ty evidence value -> guard-uses id value
    CRefine sp ty evidence value -> guard-uses id value
    CRefineProof sp ty witness value -> guard-uses id value
    CForget sp ty value -> guard-uses id value
    CCast sp ty value -> guard-uses id value
    other -> Some (0, 0)
  guard-uses-none :: List Nat -> CoreTerm -> Bool
  guard-uses-none binders body = case binders of
    [] -> True
    id : rest -> case guard-uses id body of Some (0, 0) -> guard-uses-none rest body; other -> False
  guarded-argument-error :: Span -> UType -> CorePattern -> CoreTerm -> Option (Span, String)
  guarded-argument-error sp function pattern body = case function of
    UUsageArrow UsageMany arrow -> None
    UUsageArrow usage arrow -> require-task (not (guard-falls-through body) || guard-uses-none (task-pattern-ids pattern) body) sp
      (string-concat-all ["multiplicity ", arrow-usage-text usage, ": the argument can be consumed before a guard falls through"])
    other -> None
  usage-parameter-error :: TypingContext -> Span -> Bool -> UType -> List CorePattern -> CoreTerm -> Option (Span, String)
  usage-parameter-error context sp fallthrough function patterns body = case patterns of
    [] -> None
    pattern : rest -> case pattern-usage-error context sp function pattern body of
      Some error -> Some error
      None -> case (if fallthrough then guarded-argument-error sp function pattern body else None) of
        Some error -> Some error
        None -> (case pattern-result function pattern of
          Some result -> usage-parameter-error context sp fallthrough result rest body
          None -> None)
  has-annotated-parameter :: UType -> Bool
  has-annotated-parameter ty = case ty of
    UUsageArrow usage arrow -> True
    UFun domain result -> has-annotated-parameter result
    UFunEff domain row result -> has-annotated-parameter result
    UPi id name domain row result -> has-annotated-parameter result
    UProofFun predicate row result -> has-annotated-parameter result
    other -> False
  usage-equations-error :: TypingContext -> UType -> List CoreClause -> Option (Span, String)
  usage-equations-error context function clauses = case clauses of
    [] -> None
    (CoreClause sp patterns body) : rest ->
      let fallthrough = case rest of [] -> False; other -> True in
      case usage-parameter-error context sp fallthrough function patterns body of
        Some error -> Some error
        None -> usage-equations-error context function rest
  affine-thunk :: UType -> Bool
  affine-thunk ty = case clocked-later-parts (task-base ty) of
    Some _ -> False
    None -> case deferral-parts (task-base ty) of Some parts -> True; None -> False
  thunk-use-error :: Span -> String -> Option (Span, String)
  thunk-use-error sp detail = Some (sp, string-concat "multiplicity %aff: a thunk must be used at most once" detail)
  task-bound-error :: Span -> Nat -> UType -> CoreTerm -> Option (Span, String)
  task-bound-error sp id ty body =
    if task-handle-type ty then (case use-count Uninterrupted id body of
      Some (1, 1) -> None
      Some (0, 0) -> task-drop-error sp
      other -> task-use-error sp)
    else if affine-thunk ty then (case use-count MayInterrupt id body of
      Some (low, high) -> if high <= 1 then None else thunk-use-error sp (usage-detail (Some (low, high)))
      None -> thunk-use-error sp (usage-detail None))
    else None
  task-pattern-use-error :: CorePattern -> CoreTerm -> Option (Span, String)
  task-pattern-use-error p body = case p of
    CPVar sp ty id name -> task-bound-error sp id ty body
    CPWild sp ty -> if task-handle-type ty then task-drop-error sp else None
    CPAs sp ty id name inner -> if affine-thunk ty && (case inner of CPWild at carrier -> False; other -> True) then thunk-use-error sp ""
      else first-task-error (task-bound-error sp id ty body) (task-pattern-use-error inner body)
    CPConstructor sp ty name actuals constructor fields -> task-pattern-use-error fields body
    CPTuple sp ty fields -> task-pattern-use-error fields body
    CPField sp first rest -> first-task-error (task-pattern-use-error first body) (task-pattern-use-error rest body)
    other -> None
  task-traces-merge :: TaskTrace -> TaskTrace -> TaskTrace
  task-traces-merge a b = TaskTrace (first-task-error (a.trace-error) (b.trace-error)) (a.trace-regions <> b.trace-regions) (a.trace-shared && b.trace-shared)
  task-trace-list :: TypingContext -> List TaskLocal -> List UType -> Bool -> List CoreTerm -> TaskTrace
  task-trace-list context env scopes consuming terms = case terms of [] -> TaskTrace None [] True; first : rest -> task-traces-merge (task-trace context env scopes consuming first) (task-trace-list context env scopes consuming rest)
  task-result-trace :: TypingContext -> UType -> TaskTrace -> TaskTrace
  task-result-trace context ty trace = TaskTrace (trace.trace-error) (if task-region-free-type context [] 64 ty then [] else task-hidden-regions ty (trace.trace-regions)) (trace.trace-shared)
  task-hidden-regions :: UType -> List UType -> List UType
  task-hidden-regions ty regions = case regions of [] -> []; region : rest -> if task-region-present region (task-regions ty) then task-hidden-regions ty rest else region : (task-hidden-regions ty rest)
  task-free-evidence :: List String -> CoreTerm -> List UType
  task-free-evidence bound term = case term of
    CQualifiedUse sp ty name role actuals evidence -> task-free-evidences bound evidence
    CMethod sp ty name owner slot actuals evidence -> task-free-evidences bound evidence
    CScope sp ty region evidence callback -> task-evidence-types bound evidence <> task-free-evidence bound callback
    CWith sp ty given value body -> task-free-evidence bound value <> task-free-evidence ((given.symbol) : bound) body
    CQualIntro sp ty givens body -> task-free-evidence (given-symbols givens <> bound) body
    CQualElim sp ty val evs -> task-free-evidence bound val <> task-free-evidences bound evs
    other -> task-free-evidence-list bound (runtime-term-children term)
  given-symbols :: List CoreGiven -> List String
  given-symbols gs = case gs of [] -> []; g : rest -> (g.symbol) : (given-symbols rest)
  task-evidence-types :: List String -> CoreEvidence -> List UType
  task-evidence-types bound evidence = case evidence of
    CEGiven sp ty name -> if has name bound then [] else [ty]
    CEInstance sp ty name actuals args -> task-evidence-types bound args
    CEArgument sp first rest -> task-evidence-types bound first <> task-evidence-types bound rest
    other -> []
  task-free-evidences :: List String -> List CoreEvidence -> List UType
  task-free-evidences bound evidence = case evidence of [] -> []; first : rest -> task-evidence-types bound first <> task-free-evidences bound rest
  task-free-evidence-list :: List String -> List CoreTerm -> List UType
  task-free-evidence-list bound terms = case terms of [] -> []; first : rest -> task-free-evidence bound first <> task-free-evidence-list bound rest
  task-capture-types :: List UType -> List UType
  task-capture-types types = case types of [] -> []; ty : rest -> task-regions ty <> task-capture-types rest
  task-active-regions :: List UType -> List UType -> List UType
  task-active-regions scopes regions = case regions of [] -> []; region : rest -> if task-region-present region scopes then region : (task-active-regions scopes rest) else task-active-regions scopes rest
  -- A checked source forwarder delegates its capture and lifetime checks to
  -- a saturated call in the same compilation. It cannot escape as a value.
  task-arrow-output :: UType -> UType
  task-arrow-output ty = case ty of UFun domain output -> output; UFunEff domain row output -> output; UPi id name domain row output -> output; other -> UError
  task-forwarder-type :: UType -> Bool
  task-forwarder-type ty = task-handle-type (task-arrow-output (task-arrow-output ty))
  task-source-forwarder :: CoreDefinition -> Bool
  task-source-forwarder definition =
    case (opening-value-types (definition.openings), definition.givens, definition.clauses) of
      ([], [], [CoreClause sp [CPVar token-at token-ty token-id token-name, CPVar body-at body-ty body-id body-name] (CSpawn spawn-at result (CLocal token-use scope key scope-name []) (CLocal body-use callback body-key callback-name []))]) ->
        token-id == key && body-id == body-key && token-id /= body-id
          && task-forwarder-type (scheme-body (definition.scheme)) && checked-spawn result (CLocal token-use scope key scope-name []) (CLocal body-use callback body-key callback-name [])
      other -> False
  task-forwarder-names :: List CoreDefinition -> List String
  task-forwarder-names definitions = case definitions of
    [] -> []
    definition : rest -> if task-source-forwarder definition then (definition.name) : (task-forwarder-names rest) else task-forwarder-names rest
  task-reference-forwarder :: TypingContext -> CoreTerm -> Bool
  task-reference-forwarder context term = case term of
    CUse sp ty name role actuals -> context-task-forwarder context name
    CQualifiedUse sp ty name role actuals [] -> context-task-forwarder context name
    other -> False
  task-forwarded-scope :: TypingContext -> CoreTerm -> Option CoreTerm
  task-forwarded-scope context partial = case partial of
    CApply sp ty callee token -> if task-reference-forwarder context callee then Some token else None
    CApplyEff sp ty row callee token -> if task-reference-forwarder context callee then Some token else None
    other -> None
  arena-data-lookup :: String -> List CoreData -> Option CoreData
  arena-data-lookup name datas = case datas of
    [] -> None
    d : rest -> if core-data-name d == name then Some d else arena-data-lookup name rest
  arena-ctors-nullary :: List CoreConstructor -> Bool
  arena-ctors-nullary ctors = case ctors of
    [] -> True
    c : rest -> list-length (core-constructor-fields c) == 0 && arena-ctors-nullary rest
  arena-escape-safe :: List CoreData -> UType -> Bool
  arena-escape-safe datas ty = case ty of
    URefine id name base pred -> arena-escape-safe datas base
    UMeta id k -> True
    UCon name k ->
      if name == "Int" || name == "Nat" || name == "Bool" || name == "Unit" || name == "Char"
        || name == "I8" || name == "I16" || name == "I32" || name == "I64" || name == "I128" || name == "Isize"
        || name == "U8" || name == "U16" || name == "U32" || name == "U64" || name == "U128" || name == "Usize"
        || name == "F32" || name == "F64" then True
      else case arena-data-lookup name datas of
        Some d -> let ctors = core-data-constructors d in list-length ctors > 0 && arena-ctors-nullary ctors
        None -> False
    other -> False
  arena-escape-primitive :: String -> Bool
  arena-escape-primitive name =
    name == "Effect.Arena.with-arena" || name == interface-global "Effect.Arena.with-arena"
      || name == "Effect.Arena.with-arena-budget" || name == interface-global "Effect.Arena.with-arena-budget"
  arena-escape-error-for :: TypingContext -> Span -> String -> List UType -> Option (Span, String)
  arena-escape-error-for context sp name actuals =
    if name == "Effect.Arena.with-arena" || name == interface-global "Effect.Arena.with-arena" then (case actuals of
      [e, a] ->
        if not (arena-escape-safe (context.datas) e) then Some (sp, "arena escape error type must be scalar/Copy (arena-allocated values cannot escape `with-arena`)")
        else if not (arena-escape-safe (context.datas) a) then Some (sp, "arena escape return type must be scalar/Copy (arena-allocated values cannot escape `with-arena`)")
        else None
      other -> None)
    else if name == "Effect.Arena.with-arena-budget" || name == interface-global "Effect.Arena.with-arena-budget" then (case actuals of
      [a] ->
        if not (arena-escape-safe (context.datas) a) then Some (sp, "arena escape return type must be scalar/Copy (arena-allocated values cannot escape `with-arena`)")
        else None
      other -> None)
    else None
  arena-escape-error :: TypingContext -> Span -> CoreTerm -> Option (Span, String)
  arena-escape-error context sp term = case term of
    CUse at ty name role actuals -> arena-escape-error-for context sp name actuals
    CQualifiedUse at ty name role actuals evidence -> arena-escape-error-for context sp name actuals
    other -> None
  task-global-trace :: TypingContext -> List TaskLocal -> List UType -> Span -> UType -> CoreTerm -> List CoreEvidence -> TaskTrace
  task-global-trace context env scopes sp ty term evidence =
    let required = first-task-error (arena-escape-error context sp term)
          (require-task (not (task-reference-forwarder context term)) sp "a task forwarding helper must be fully applied in its source compilation") in
    task-result-trace context ty (task-traces-merge (TaskTrace required (task-evidences-regions evidence) True) (task-trace-list context env scopes False (term-children term)))
  task-type-holds-mut :: UType -> Bool
  task-type-holds-mut ty = let base = task-base ty in case mutable-borrow base of
    Some borrow -> True
    None -> (case base of
      UApp f x -> task-type-holds-mut f || task-type-holds-mut x
      UFun a b -> task-type-holds-mut a || task-type-holds-mut b
      UFunEff a row b -> task-type-holds-mut a || task-type-holds-mut b
      UUsageArrow usage arrow -> task-type-holds-mut arrow
      UPi id name a row b -> task-type-holds-mut a || task-type-holds-mut b
      UTuple fields -> task-type-holds-mut fields
      USigma id name domain body -> task-type-holds-mut domain || task-type-holds-mut body
      UForall qs body -> task-type-holds-mut body
      UQual qs body -> uquals-hold-mut qs || task-type-holds-mut body
      UArg first rest -> task-type-holds-mut first || task-type-holds-mut rest
      other -> False)
  uquals-hold-mut :: UQuals -> Bool
  uquals-hold-mut qs = case qs of UQEnd -> False; UQCons name ty rest -> task-type-holds-mut ty || uquals-hold-mut rest
  uquals-hold-memo :: UQuals -> Bool
  uquals-hold-memo qs = case qs of UQEnd -> False; UQCons name ty rest -> task-type-holds-memo ty || uquals-hold-memo rest
  task-types-hold-mut :: List UType -> Bool
  task-types-hold-mut types = case types of [] -> False; ty : rest -> task-type-holds-mut ty || task-types-hold-mut rest
  task-free-holds-mut :: List (Nat, UType) -> Bool
  task-free-holds-mut free = case free of [] -> False; (id, ty) : rest -> task-type-holds-mut ty || task-free-holds-mut rest
  task-type-holds-memo :: UType -> Bool
  task-type-holds-memo ty = let base = task-base ty in case lazy-parts base of
    Some cell -> True
    None -> (case base of
      UApp f x -> task-type-holds-memo f || task-type-holds-memo x
      UFun a b -> task-type-holds-memo a || task-type-holds-memo b
      UFunEff a row b -> task-type-holds-memo a || task-type-holds-memo b
      UUsageArrow usage arrow -> task-type-holds-memo arrow
      UPi id name a row b -> task-type-holds-memo a || task-type-holds-memo b
      UTuple fields -> task-type-holds-memo fields
      USigma id name domain body -> task-type-holds-memo domain || task-type-holds-memo body
      UForall qs body -> task-type-holds-memo body
      UQual qs body -> uquals-hold-memo qs || task-type-holds-memo body
      UArg first rest -> task-type-holds-memo first || task-type-holds-memo rest
      other -> False)
  task-free-holds-memo :: List (Nat, UType) -> Bool
  task-free-holds-memo free = case free of
    [] -> False
    (id, ty) : rest -> task-type-holds-memo ty || task-free-holds-memo rest
  task-evidence-holds-memo :: List UType -> Bool
  task-evidence-holds-memo types = case types of
    [] -> False
    ty : rest -> task-type-holds-memo ty || task-evidence-holds-memo rest
  -- | Check the instantiated fields before moving a constructor into a task.
  -- Borrowed fields can refer outside the task. An opaque imported datatype
  -- without field evidence cannot establish transfer safety from its handle alone.
  task-transfer-safe :: TypingContext -> List UType -> Nat -> UType -> Bool
  task-transfer-safe context seen fuel ty = if fuel == 0 then False else
    let base = task-base ty in
    let remaining = fuel - 1 in
    case borrow-type-parts base of
      Some (mutable, region, carrier) -> not mutable && task-shareable context [] remaining carrier
      None -> (case lazy-parts base of
        Some cell -> False
        None -> (case base of
          UTuple fields -> task-transfer-safe context seen remaining fields
          USigma id name domain body -> task-transfer-safe context seen remaining domain && task-transfer-safe context seen remaining body
          UArg first rest -> task-transfer-safe context seen remaining first && task-transfer-safe context seen fuel rest
          other -> if task-seen-type base seen then True else
            (case task-type-spine base [] of
              (UCon name kind, args) -> if cell-type-name name then task-types-property context True [] remaining args else if array-type-name name then task-transfer-types context seen remaining [] args else
                (case task-data name (context.datas) of
                  Some d -> list-length args == list-length (core-data-params d) && (case core-data-constructors d of
                    [] -> task-usage-transfer context name args (base : seen) remaining
                    fields -> task-transfer-constructors context (base : seen) remaining (task-actuals (core-data-params d) args) fields)
                  None -> (case task-usage-fields context name args of
                    Some fields -> task-transfer-types context (base : seen) remaining [] fields
                    None -> (case borrow-regions base of [] -> True; other -> False)))
              other -> (case borrow-regions base of [] -> True; other -> False))))
  task-transfer-types :: TypingContext -> List UType -> Nat -> List (Nat, UType) -> List UType -> Bool
  task-transfer-types context seen fuel pairs types = case types of
    [] -> True
    ty : rest -> task-transfer-safe context seen fuel (substitute-bound pairs ty) && task-transfer-types context seen fuel pairs rest
  task-transfer-constructors :: TypingContext -> List UType -> Nat -> List (Nat, UType) -> List CoreConstructor -> Bool
  task-transfer-constructors context seen fuel pairs constructors = case constructors of
    [] -> True
    ctor : rest -> task-transfer-types context seen fuel pairs (core-constructor-fields ctor)
      && task-transfer-constructors context seen fuel pairs rest
  -- A non-shareable value can move into the direct, one-shot task body
  -- only when its source binder has its own checked usage obligation.
  task-free-transfer :: TypingContext -> List TaskLocal -> CoreTerm -> List (Nat, UType) -> Bool
  task-free-transfer context env body free = case free of
    [] -> True
    (id, ty) : rest ->
      (task-handle-type ty || task-shareable context [] 64 ty || (transferable-local env id &&
        task-transfer-safe context [] 64 ty &&
        (case use-count Uninterrupted id body of Some (low, high) -> high == 1; None -> False)))
      && task-free-transfer context env body rest
  task-callable :: TypingContext -> List TaskLocal -> List UType -> Bool -> Span -> CoreTerm -> TaskTrace
  task-callable context env scopes spawning site callback = case callback of
    CLambda sp ty p body -> let free = task-free (task-pattern-ids p) body in
      let inside = task-trace context (task-pattern-env p [] False (transfer-parameter ty) env) scopes True body in
      let captured-evidence = task-free-evidence [] body in
      let capture-error = (if not spawning then None else
        if task-free-holds-memo free || task-evidence-holds-memo captured-evidence then
          Some (sp, "a thread-shared memo cell cannot cross a task boundary")
        else if task-free-holds-mut free || task-types-hold-mut captured-evidence then Some (sp, "an exclusive `Mut` borrow cannot cross a task boundary")
        else require-task (task-free-transfer context env body free && task-types-property context True [] 64 captured-evidence)
          sp "a task capture crosses the task boundary without shareable evidence") in
      let task-failure = first-task-error (task-pattern-use-error p body) (first-task-error (inside.trace-error) capture-error) in
      let failure = first-task-error (pattern-usage-error context sp ty p body) task-failure in
      TaskTrace failure (inside.trace-regions) (inside.trace-shared)
    other -> let checked = task-trace context env scopes False callback in
      let capture-error = require-task (not spawning || checked.trace-shared) site "a task callback crosses the task boundary without shareable evidence" in
      let failure = first-task-error (checked.trace-error) capture-error in
      task-result-trace context (case scope-callback-parts (core-type callback) of Some (owner, region, row, result) -> result; None -> case task-body-parts (core-type callback) of Some (error, value, row) -> task-result-type error value; None -> UError)
        (TaskTrace failure (checked.trace-regions <> task-regions (core-type callback)) (checked.trace-shared))
  knot-region-name :: UType -> Option String
  knot-region-name region = case region of
    URigid id name level KRegion ->
      if string-starts-with "#core" name then None
      else (case unpack name of
        first : rest -> if char-code first == 35 then Some (pack rest) else None
        [] -> None)
    other -> None
  first-knot-name :: List UType -> Option String
  first-knot-name regions = case regions of
    [] -> None
    region : rest -> case knot-region-name region of Some name -> Some name; None -> first-knot-name rest
  knot-escape :: Span -> List UType -> Option (Span, String)
  knot-escape sp regions = case first-knot-name regions of
    Some name -> Some (sp, "region escape: a value retains recursive binding `" <> name <> "`")
    None -> None
  remove-knot-regions :: List UType -> List UType
  remove-knot-regions regions = case regions of
    [] -> []
    region : rest -> case knot-region-name region of
      Some name -> remove-knot-regions rest
      None -> region : (remove-knot-regions rest)
  knot-local-regions :: TypingContext -> UType -> List UType -> List UType
  knot-local-regions context ty regions = case first-knot-name regions of
    Some name -> if task-region-free-type context [] 64 ty then remove-knot-regions regions else regions
    None -> regions

  -- Local region provenance separates reading a recursive value from
  -- capturing its slot. A closure still retains the slot when the
  -- stored value itself is an independent scalar.
  knot-taint-pass :: CoreTerm -> List Nat -> List Nat
  knot-taint-pass members tainted = case members of
    CRecursiveBinding id name value rest ->
      let next = if not (task-id-present id tainted) && recursive-captures tainted value then id : tainted else tainted in
      knot-taint-pass rest next
    other -> tainted
  knot-taints :: CoreTerm -> List Nat -> List Nat
  knot-taints members tainted =
    let next = knot-taint-pass members tainted in
    if list-length next == list-length tainted then next else knot-taints members next
  task-knot-locals :: CoreTerm -> UType -> List Nat -> List Nat -> List UType -> List TaskLocal -> List TaskLocal
  task-knot-locals members region slots tainted outer env = case members of
    CRecursiveBindingsEnd -> env
    CRecursiveBinding id name value rest ->
      let ty = core-type value in
      let boxed = task-id-present id slots in
      -- A boxed member's storage is the knot slot itself, so it carries the
      -- knot region and not the free regions of its initializer: the
      -- initializer runs in the knot scope and the box outlives it.
      let regions = if boxed then [] else if recursive-captures tainted value then region : outer else outer in
      let entry = if boxed then TaskKnotLocal id ty region regions else TaskLocal id ty regions False False in
      let bound = if name == "" then env else entry : env in
      task-knot-locals rest region slots tainted outer bound
    other -> env

  knot-binding-usage :: Span -> CoreTerm -> CoreTerm -> Option (Span, String)
  knot-binding-usage sp members term = case members of
    CRecursiveBindingsEnd -> None
    CRecursiveBinding id name value rest -> first-task-error (task-bound-error sp id (core-type value) term) (knot-binding-usage sp rest term)
    other -> Some (sp, "malformed recursive value bindings")

  task-trace :: TypingContext -> List TaskLocal -> List UType -> Bool -> CoreTerm -> TaskTrace
  task-trace context env scopes consuming term =
    if task-handle-type (core-type term) && not consuming then
      TaskTrace (task-use-error (case term of CLocal sp ty id name actuals -> sp; CSpawn sp ty token body -> sp; other -> Span 0 0 1 1)) [] False
    else case term of
      CLocal sp ty id name actuals -> (case task-local id env of
        Some (TaskLocal key declared regions shared owned) -> TaskTrace None (knot-local-regions context ty regions) shared
        Some (TaskKnotLocal key declared region regions) -> TaskTrace None (knot-local-regions context ty (region : regions)) False
        None -> TaskTrace None [] False)
      CScope sp ty region evidence callback -> let inside = task-callable context env (region : scopes) False sp callback in
        let escape = require-task (not (task-region-present region (inside.trace-regions))) sp "region escape: a scoped capture leaves its `withScope`" in
        let failure = first-task-error (inside.trace-error) escape in
        TaskTrace failure (inside.trace-regions) (inside.trace-shared)
      CMemoScope sp ty region body -> let inside = task-trace context env scopes consuming body in
        let escape = require-task (not (task-region-present region (inside.trace-regions))) sp "region escape: a value captures a local memo cell" in
        TaskTrace (first-task-error (inside.trace-error) escape) (inside.trace-regions) (inside.trace-shared)
      CSpawn sp ty token callback -> task-spawn-trace context env scopes sp token callback
      CJoin sp ty token handles -> let scope-value = task-trace context env scopes False token in
        let consumed = task-trace-list context env scopes True (case handles of CArgument sp first rest -> task-argument-values handles; other -> []) in
        task-result-trace context ty (task-traces-merge scope-value consumed)
      CPrimitive sp ty op args -> let checked = task-trace context env scopes False args in
        if op == "copy-out" && not (copy-out-checked context ty args) then
          TaskTrace (Some (sp, string-concat "copyOut requires structural Copy evidence for " (type-text ty))) [] False
        else if op == "memo-alloc" && (case lazy-parts ty of
          Some (row, region, carrier) -> not (copyable-type context [] 64 carrier)
          None -> True) then TaskTrace (Some (sp, "a memo cell cache has no Copy evidence: its value is not structurally copyable")) [] False
        else if has op ["ref-set", "memo-init"] then
          (case args of
            CArgument at place (CArgument bt value (CArgumentsEnd end)) ->
              let supplied = task-trace context env scopes False value in
              let failure = first-task-error (checked.trace-error) (knot-escape bt (supplied.trace-regions)) in
              TaskTrace failure [] (checked.trace-shared)
            other -> task-result-trace context ty checked)
        else task-result-trace context ty checked
      CLambda sp ty p body -> let free = task-free (task-pattern-ids p) body in
        let inside = task-trace context (task-pattern-env p [] False (transfer-parameter ty) env) scopes True body in
        let escape = require-task (task-free-scopes env free) sp "region escape: a closure captures a value from a structured scope" in
        let task-failure = first-task-error (task-pattern-use-error p body) (first-task-error escape (inside.trace-error)) in
        let failure = first-task-error (pattern-usage-error context sp ty p body) task-failure in
        TaskTrace failure (task-free-regions env free <> task-active-regions scopes (task-capture-types (task-free-evidence [] body))) (task-free-sharing context free && task-types-property context True [] 64 (task-free-evidence [] body))
      CLet sp ty id name sc rhs body -> let value = task-trace context env scopes True rhs in
        let result = task-trace context ((TaskLocal id (scheme-body sc) (value.trace-regions) (value.trace-shared) (transferred-alias env rhs)) : env) scopes consuming body in
        let failure = first-task-error (task-bound-error sp id (scheme-body sc) body) (first-task-error (value.trace-error) (result.trace-error)) in
        TaskTrace failure (result.trace-regions) (result.trace-shared)
      CRecursiveFunctions sp ty members body ->
        let functions = recursive-functions members in
        let free = task-free-children (recursive-function-ids members) functions in
        let evidence = task-free-evidence-list [] functions in
        let regions = task-free-regions env free <> task-active-regions scopes (task-capture-types evidence) in
        let shareable = task-free-sharing context free && task-types-property context True [] 64 evidence in
        let bound = task-recursive-locals members regions shareable env in
        let values = task-trace-list context bound scopes False functions in
        let result = task-trace context bound scopes consuming body in
        TaskTrace (first-task-error (values.trace-error) (result.trace-error)) (result.trace-regions) (result.trace-shared)
      CRecursiveValues sp ty region members body ->
        let ids = recursive-function-ids members in
        let values = recursive-functions members in
        let free = task-free-children ids values in
        let outer = task-free-regions env free <> task-active-regions scopes (task-capture-types (task-free-evidence-list [] values)) in
        let slots = recursive-box-slots members in
        let bound = task-knot-locals members region slots (knot-taints members slots) outer env in
        let active = region : scopes in
        let initialized = task-trace-list context bound active True values in
        let result = task-trace context bound active consuming body in
        let escaped = if task-region-present region (result.trace-regions) then knot-escape sp [region] else None in
        let usage = knot-binding-usage sp members term in
        let failure = first-task-error usage (first-task-error (initialized.trace-error)
          (first-task-error (result.trace-error) escaped)) in
        TaskTrace failure (result.trace-regions) (result.trace-shared)
      CApply sp ty f x -> task-call-trace context env scopes sp ty f x
      CApplyEff sp ty row f x -> task-call-trace context env scopes sp ty f x
      CErasedApply sp ty row f witness -> task-result-trace context ty (task-trace context env scopes False f)
      CIf sp ty condition yes no -> let test = task-trace context env scopes False condition in
        let result = task-traces-merge (task-trace context env scopes consuming yes) (task-trace context env scopes consuming no) in
        TaskTrace (first-task-error (test.trace-error) (result.trace-error)) (result.trace-regions) (result.trace-shared)
      CCase sp ty value alts -> let input = task-trace context env scopes False value in
        let result = task-alternatives-trace context env scopes consuming input alts in
        TaskTrace (first-task-error (input.trace-error) (result.trace-error)) (result.trace-regions) (result.trace-shared)
      CUse sp ty name role actuals -> task-global-trace context env scopes sp ty term []
      CQualifiedUse sp ty name role actuals evidence -> task-global-trace context env scopes sp ty term evidence
      CMethod sp ty name owner slot actuals evidence -> task-result-trace context ty (task-traces-merge (TaskTrace None (task-evidences-regions evidence) True) (task-trace-list context env scopes False (term-children term)))
      CWith sp ty given value body -> let supplied = task-trace context env scopes False value in
        let result = task-trace (with-copy-givens context [given]) env scopes consuming body in
        let failure = first-task-error (supplied.trace-error) (first-task-error (knot-escape sp (supplied.trace-regions)) (result.trace-error)) in
        TaskTrace failure (result.trace-regions) (result.trace-shared)
      other -> task-result-trace context (core-type term) (task-trace-list context env scopes False (term-children term))
  task-recursive-locals :: CoreTerm -> List UType -> Bool -> List TaskLocal -> List TaskLocal
  task-recursive-locals members regions shareable env = case members of
    CRecursiveBindingsEnd -> env
    CRecursiveBinding id name value rest ->
      task-recursive-locals rest regions shareable ((TaskLocal id (core-type value) regions shareable False) : env)
    other -> env
  task-spawn-trace :: TypingContext -> List TaskLocal -> List UType -> Span -> CoreTerm -> CoreTerm -> TaskTrace
  task-spawn-trace context env scopes sp token callback = let scope-value = task-trace context env scopes False token in
    let inside = task-callable context env scopes True sp callback in
    let regions = (case callback of CLambda at ft p body -> task-free-regions env (task-free (task-pattern-ids p) body) <> task-capture-types (task-free-evidence [] body); other -> (task-trace context env scopes False callback).trace-regions) in
    let lifetime = case scope-parameters (core-type token) of Some (owner, destination) -> task-capture-regions scopes owner destination regions; None -> False in
    let escape = require-task lifetime sp "region escape: a task capture does not outlive the destination scope" in
    let crossing = first-task-error (knot-escape sp regions) escape in
    let failure = first-task-error (scope-value.trace-error) (first-task-error crossing (inside.trace-error)) in
    TaskTrace failure (inside.trace-regions) True
  task-call-trace :: TypingContext -> List TaskLocal -> List UType -> Span -> UType -> CoreTerm -> CoreTerm -> TaskTrace
  task-call-trace context env scopes sp result f x = case task-forwarded-scope context f of
    Some token -> task-spawn-trace context env scopes sp token x
    None -> let function = task-trace context env scopes False f in
      let input = task-trace context env scopes False x in
      let escapes = if task-constructor-call f then None else knot-escape sp (input.trace-regions) in
      let failure = first-task-error (function.trace-error) (first-task-error (input.trace-error) escapes) in
      task-result-trace context result (TaskTrace failure
        (function.trace-regions <> input.trace-regions <> task-regions (core-type x))
        (function.trace-shared && input.trace-shared && task-shareable context [] 64 (core-type x)))
  task-constructor-call :: CoreTerm -> Bool
  task-constructor-call term = case term of
    CUse sp ty name role actuals -> role == "constructor"
    CQualifiedUse sp ty name role actuals evidence -> role == "constructor"
    CApply sp ty f x -> task-constructor-call f
    CApplyEff sp ty row f x -> task-constructor-call f
    CErasedApply sp ty row f x -> task-constructor-call f
    other -> False
  task-argument-values :: CoreTerm -> List CoreTerm
  task-argument-values terms = case terms of CArgumentsEnd sp -> []; CArgument sp first rest -> first : (task-argument-values rest); other -> []
  task-alternatives-trace :: TypingContext -> List TaskLocal -> List UType -> Bool -> TaskTrace -> CoreTerm -> TaskTrace
  task-alternatives-trace context env scopes consuming input alts = case alts of
    CAlternativesEnd sp -> TaskTrace None [] True
    CAlternative sp p body rest ->
      let inside = task-trace context (task-pattern-env p (input.trace-regions) (input.trace-shared) False env) scopes consuming body in
      let failure = first-task-error (task-pattern-use-error p body) (inside.trace-error) in
      task-traces-merge (TaskTrace failure (inside.trace-regions) (inside.trace-shared)) (task-alternatives-trace context env scopes consuming input rest)
    other -> TaskTrace (Some (Span 0 0 1 1, "malformed task case alternatives")) [] False
  task-code-present :: TypingContext -> CoreTerm -> Bool
  task-code-present context term = annotated-arrow (core-type term) || task-scoped-type (core-type term) || affine-thunk (core-type term) || (case term of
    CScope sp ty region evidence callback -> True
    CMemoScope sp ty region body -> True
    CRecursiveValues sp ty region members body -> True
    CSpawn sp ty token callback -> True
    CJoin sp ty token handles -> True
    CPrimitive sp ty op args -> has op ["copy-out", "thunk-force", "thunk-delay"] || task-code-present context args
    CUse sp ty name role actuals -> arena-escape-primitive name || task-reference-forwarder context term || task-code-list context (term-children term)
    CQualifiedUse sp ty name role actuals evidence -> arena-escape-primitive name || task-reference-forwarder context term || task-code-list context (term-children term)
    other -> task-code-list context (term-children term))
  task-code-list :: TypingContext -> List CoreTerm -> Bool
  task-code-list context terms = case terms of [] -> False; first : rest -> task-code-present context first || task-code-list context rest
  task-transfer-patterns :: UType -> List CorePattern -> List Nat
  task-transfer-patterns function patterns = case patterns of
    [] -> []
    p : rest ->
      let owned = if transfer-parameter function then (case p of
        CPVar sp ty id name -> [id]
        CPAs sp ty id name (CPWild at carrier) -> [id]
        other -> []) else [] in
      owned <> (case pattern-result function p of Some next -> task-transfer-patterns next rest; None -> [])
  task-pattern-transfers :: List Nat -> CorePattern -> Bool
  task-pattern-transfers owned p = case p of
    CPVar sp ty id name -> task-id-present id owned
    CPAs sp ty id name (CPWild at carrier) -> task-id-present id owned
    other -> False
  task-pattern-error :: TypingContext -> List TaskLocal -> List Nat -> List CorePattern -> CoreTerm -> Option (Span, String)
  task-pattern-error context env owned patterns body = case patterns of
    [] -> (task-trace context env [] True body).trace-error
    p : rest -> first-task-error (task-pattern-use-error p body)
      (task-pattern-error context (task-pattern-env p [] False (task-pattern-transfers owned p) env) owned rest body)
  task-definition-safe :: TypingContext -> CoreDefinition -> Bool
  task-definition-safe context d = case task-definition-error context d of None -> True; Some error -> False
  task-definition-error :: TypingContext -> CoreDefinition -> Option (Span, String)
  task-definition-error context d =
    let declared = scheme-body (d.scheme) in
    let annotated = has-annotated-parameter declared in
    let opened = if annotated then substitute-bound (d.openings) declared else UError in
    let clauses = d.clauses in
    case (if annotated then usage-equations-error context opened clauses else None) of
      Some error -> Some error
      None -> if context-task-forwarder context (d.name) && task-source-forwarder d then None
        else task-clauses-error (with-copy-givens context (d.givens)) (opening-value-patterns (Span 0 0 1 1) (d.openings)) opened clauses
  -- The capture rule for parallel callbacks (design/parallel-evaluation.md
  -- section 2.3), applied at the definition's end where the checked data
  -- declarations that decide Share are in scope. The seed's
  -- `check_parallel_captures` is the reference: a memo cell and a `Mut`
  -- borrow are refused outright; a `%1`/`%aff` capture may move into one
  -- `parBoth` branch; every other capture, and every capture of the
  -- many-shot callbacks, must be Share. The rows were already restricted to
  -- the parallel-safe row at the call site (`Cinch.Infer`'s
  -- `parallel-safe-row`), so only the captures remain here.
  par-definition-error :: TypingContext -> CoreDefinition -> Option (Span, String)
  par-definition-error context d =
    let declared = scheme-body (d.scheme) in
    let additive = has-annotated-parameter declared in
    par-clauses-error (with-copy-givens context (d.givens)) additive (opening-value-patterns (Span 0 0 1 1) (d.openings)) declared (d.clauses)
  par-clauses-error :: TypingContext -> Bool -> List CorePattern -> UType -> List CoreClause -> Option (Span, String)
  par-clauses-error context additive prefix declared clauses = case clauses of
    [] -> None
    (CoreClause sp patterns body) : rest ->
      let bound = par-bindings prefix patterns [] in
      let owned = if additive then capture-usage declared patterns (CaptureUsage [] []) else CaptureUsage [] [] in
      let abort-err = (case owned.ids2 of
        [] -> None
        ids -> if linear-across-abort (context.effects) ids False body then
            Some (sp, "multiplicity %1: linear binder must be used exactly once on every path, and cannot stay live across an aborting effect")
          else None) in
      case first-task-error abort-err (par-term-error context owned bound body) of
        Some error -> Some error
        None -> par-clauses-error context additive prefix declared rest
  -- The `%1`/`%aff` parameters of this clause, by the binder's position: a
  -- parallel callback may move such a value into one `parBoth` branch
  -- (section 2.3). The seed reads the same fact from the binder's effective
  -- multiplicity (`check_parallel_captures`).
  record CaptureUsage where
    ids :: List Nat
    ids2 :: List Nat
  capture-usage :: UType -> List CorePattern -> CaptureUsage -> CaptureUsage
  capture-usage declared patterns prior = case patterns of
    [] -> prior
    p : rest -> let next = (case (declared, prior) of
          (UUsageArrow usage arrow, CaptureUsage moves linear) -> case usage of
            UsageOne -> let ids = task-pattern-ids p in CaptureUsage (ids <> moves) (ids <> linear)
            UsageAffine -> CaptureUsage (task-pattern-ids p <> moves) linear
            other -> prior
          other -> prior) in
      (case arrow-shape declared of
        UFun domain result -> capture-usage result rest next
        UFunEff domain row result -> capture-usage result rest next
        UPi id name domain row result -> capture-usage result rest next
        UProofFun prop row result -> capture-usage result rest next
        other -> next)
  par-bindings :: List CorePattern -> List CorePattern -> List (Nat, String, UType) -> List (Nat, String, UType)
  par-bindings prefix patterns acc = case (prefix, patterns) of
    (p : rest, q : more) -> par-bindings rest more (par-binding q (par-binding p acc))
    ([], q : more) -> par-bindings [] more (par-binding q acc)
    other -> acc
  par-binding :: CorePattern -> List (Nat, String, UType) -> List (Nat, String, UType)
  par-binding p acc = case p of
    CPVar sp ty id name -> (id, name, ty) : acc
    CPErasedValue sp ty id name -> (id, name, ty) : acc
    CPAs sp ty id name inner -> (id, name, ty) : acc
    other -> acc
  par-term-error :: TypingContext -> CaptureUsage -> List (Nat, String, UType) -> CoreTerm -> Option (Span, String)
  par-term-error context owned bound term = case term of
    CPrimitive sp ty op (CArgument at f (CArgument bt g (CArgumentsEnd end))) | (op == "par-both") ->
      first-task-error (par-callback-error context (owned.ids) bound sp "parBoth" False f)
        (first-task-error (par-callback-error context (owned.ids) bound sp "parBoth" False g)
          (first-task-error (par-term-error context owned bound f) (par-term-error context owned bound g)))
    -- `parTabulate` takes (count, callback); `parMap` takes
    -- (callback, array), so the callback is the first argument there.
    CPrimitive sp ty op (CArgument at first (CArgument bt second (CArgumentsEnd end))) | (op == "par-tabulate") ->
      first-task-error (par-callback-error context (owned.ids) bound sp "parTabulate" True second)
        (first-task-error (par-term-error context owned bound first) (par-term-error context owned bound second))
    -- `parMap`'s input becomes one array every participant reads, so its
    -- element type must be `Share` (section 2.3). The elaboration lowered
    -- the list through `array-from-list`, so the checked input's type is
    -- already `Array elem` and `element-of` reads the element directly.
    -- Results have no constraint: each is built by one participant and
    -- moves to the caller at the join, like a task result.
    CPrimitive sp ty op (CArgument at callback (CArgument bt input (CArgumentsEnd end))) | (op == "par-map") ->
      first-task-error (par-element-error context sp (core-type input))
        (first-task-error (par-callback-error context (owned.ids) bound sp "parMap" True callback)
          (first-task-error (par-term-error context owned bound callback) (par-term-error context owned bound input)))
    CPrimitive sp ty op args -> par-children-error context owned bound (term-children term)
    CHandler sp ty returned operations -> first-task-error (handler-usage-error context sp False term)
      (par-children-error context owned bound [returned, operations])
    CHandle sp ty label row body handled-by -> let ids = owned.ids2 in
      let needs-exact = case ids of [] -> False; other -> linear-continuation label ids False body in
      first-task-error (if needs-exact then handler-usage-error context sp True handled-by else None)
        (par-children-error context owned bound [body, handled-by])
    CLambda sp ty p body ->
      let next-owned = capture-usage ty [p] owned in
      let abort-err = (case next-owned.ids2 of
        [] -> None
        ids -> if linear-across-abort (context.effects) ids False body then
            Some (sp, "multiplicity %1: linear binder must be used exactly once on every path, and cannot stay live across an aborting effect")
          else None) in
      first-task-error abort-err (par-term-error context next-owned (par-binding p bound) body)
    CLet sp ty id name sc rhs body -> first-task-error (par-term-error context owned bound rhs) (par-term-error context owned ((id, name, scheme-body sc) : bound) body)
    CWith sp ty given value body -> first-task-error (par-term-error context owned bound value) (par-term-error (with-copy-givens context [given]) owned bound body)
    CQualIntro sp ty givens body -> par-term-error (with-copy-givens context givens) owned bound body
    other -> par-children-error context owned bound (runtime-term-children term)
  par-children-error :: TypingContext -> CaptureUsage -> List (Nat, String, UType) -> List CoreTerm -> Option (Span, String)
  par-children-error context owned bound terms = case terms of
    [] -> None
    first : rest -> first-task-error (par-term-error context owned bound first) (par-children-error context owned bound rest)
  -- `parMap`'s element type (section 2.3): the input array is read by every
  -- participant, so a non-`Share` element is refused. The checked input is
  -- the `Array elem` the elaboration produced, so `element-of` reads the
  -- element. An element the check cannot name is not silently accepted: the
  -- seed refuses an undetermined element the same way.
  par-element-error :: TypingContext -> Span -> UType -> Option (Span, String)
  par-element-error context sp input = case element-of input of
    None -> None
    Some element -> if task-shareable context [] 64 element then None else
      Some (sp, string-concat-all ["parMap's element type must be Share: ", display-type-text element,
        " is stored in the shared input array, which every participant reads (design/parallel-evaluation.md section 2.3)",
        par-blocker-clause context element])
  -- One callback's captures, classified. A callback that is not a literal
  -- has no readable captures and was refused at the call site already.
  -- A linear value consumed before an operation is outside its
  -- continuation. Follow evaluation order and keep alternatives separate.
  linear-reference :: List Nat -> CoreTerm -> Bool
  linear-reference ids term = intersects-linear ids (task-free [] term)
  intersects-linear :: List Nat -> List (Nat, UType) -> Bool
  intersects-linear ids free = case free of
    [] -> False
    (id, ty) : rest -> task-id-present id ids || intersects-linear ids rest
  linear-continuation :: UType -> List Nat -> Bool -> CoreTerm -> Bool
  linear-continuation label ids after term = case term of
    CApplyEff sp ty row f x -> (after && handler-performs label row) || linear-sequence label ids after [f, x]
    CErasedApply sp ty row f witness -> (after && handler-performs label row) || linear-continuation label ids after f
    CIf sp ty condition yes no -> linear-continuation label ids (after || linear-reference ids yes || linear-reference ids no) condition
      || linear-continuation label ids after yes || linear-continuation label ids after no
    CAlternative sp pat body rest -> linear-arm label ids after body rest || linear-continuation label ids after rest
    CHandle sp ty inner residual body handled-by -> if equal-type label inner then after && handler-performs label (core-effects term)
      else linear-continuation label ids after body
    CLambda sp ty pat body -> False
    CHandler sp ty returned operations -> False
    CPolyIntro sp ty openings body -> False
    CQualIntro sp ty givens body -> False
    CPrimitive sp ty op args | (op == "thunk-delay") -> False
    other -> linear-sequence label ids after (runtime-term-children term)
  linear-sequence :: UType -> List Nat -> Bool -> List CoreTerm -> Bool
  linear-sequence label ids after terms = case terms of
    [] -> False
    first : rest -> linear-continuation label ids (after || linear-suffix ids rest) first || linear-sequence label ids after rest
  linear-suffix :: List Nat -> List CoreTerm -> Bool
  linear-suffix ids terms = case terms of [] -> False; first : rest -> linear-reference ids first || linear-suffix ids rest
  linear-arm :: UType -> List Nat -> Bool -> CoreTerm -> CoreTerm -> Bool
  linear-arm label ids after arm rest = case arm of
    CGuard sp ty guard body -> linear-continuation label ids (after || linear-reference ids body || linear-reference ids rest) guard
      || linear-continuation label ids after body
    other -> linear-continuation label ids after arm
  linear-across-abort :: List CoreEffect -> List Nat -> Bool -> CoreTerm -> Bool
  linear-across-abort effects ids after term = case term of
    CApplyEff sp ty row f x -> (after && row-has-uninhabited-effect effects row) || linear-abort-sequence effects ids after [f, x]
    CErasedApply sp ty row f witness -> (after && row-has-uninhabited-effect effects row) || linear-across-abort effects ids after f
    CIf sp ty condition yes no -> linear-across-abort effects ids (after || linear-reference ids yes || linear-reference ids no) condition
      || linear-across-abort effects ids after yes || linear-across-abort effects ids after no
    CAlternative sp pat body rest -> linear-abort-arm effects ids after body rest || linear-across-abort effects ids after rest
    CHandle sp ty inner residual body handled-by ->
      (after && row-has-uninhabited-effect effects (core-effects term))
      || linear-across-abort effects ids after body
      || linear-across-abort effects ids after handled-by
    CLambda sp ty pat body -> False
    CHandler sp ty returned operations -> False
    CPolyIntro sp ty openings body -> False
    CQualIntro sp ty givens body -> False
    CPrimitive sp ty op args | (op == "thunk-delay") -> False
    other -> linear-abort-sequence effects ids after (runtime-term-children term)
  linear-abort-sequence :: List CoreEffect -> List Nat -> Bool -> List CoreTerm -> Bool
  linear-abort-sequence effects ids after terms = case terms of
    [] -> False
    first : rest -> linear-across-abort effects ids (after || linear-suffix ids rest) first || linear-abort-sequence effects ids after rest
  linear-abort-arm :: List CoreEffect -> List Nat -> Bool -> CoreTerm -> CoreTerm -> Bool
  linear-abort-arm effects ids after arm rest = case arm of
    CGuard sp ty guard body -> linear-across-abort effects ids (after || linear-reference ids body || linear-reference ids rest) guard
      || linear-across-abort effects ids after body
    other -> linear-across-abort effects ids after arm
  handler-usage-error :: TypingContext -> Span -> Bool -> CoreTerm -> Option (Span, String)
  handler-usage-error context site exact term = case term of
    CHandler sp ty returned clauses -> (case handler-parts ty of
      Some (label, input, output, row) -> (case effect-for-label label (context.effects) of
        Some declaration -> handler-clause-usage exact declaration label (declaration.effect-operations) clauses
        None -> None)
      None -> None)
    other -> if exact then Some (site, "a handler with a linear continuation must be written inline and its resumption must be used exactly once") else None
  handler-clause-usage :: Bool -> CoreEffect -> UType -> List CoreOperation -> CoreTerm -> Option (Span, String)
  handler-clause-usage exact decl label ops clauses = case (ops, clauses) of
    (operation : rest, CHandlerOperation sp slot openings row closure more) -> (case handler-operation-scheme decl label operation of
      Some sc -> if handler-resumption-count exact (substitute-bound openings (scheme-body sc)) closure then handler-clause-usage exact decl label rest more
        else Some (sp, if exact then "a handler resumption that captures a linear value must be used exactly once" else "a one-shot handler resumption must be used at most once and within its handler clause")
      None -> None)
    other -> None

  par-callback-error :: TypingContext -> List Nat -> List (Nat, String, UType) -> Span -> String -> Bool -> CoreTerm -> Option (Span, String)
  par-callback-error context owned bound sp op many-shot callback = case callback of
    CLambda at ty p body -> par-captures-error context owned ((par-pattern-id p, par-pattern-name p, pattern-type p) : bound) sp op many-shot (task-free (task-pattern-ids p) body)
    other -> par-captures-error context owned bound sp op many-shot (task-free [] callback)
  par-pattern-id :: CorePattern -> Nat
  par-pattern-id p = case p of CPVar sp ty id name -> id; other -> 0
  par-pattern-name :: CorePattern -> String
  par-pattern-name p = case p of CPVar sp ty id name -> name; other -> ""
  par-captures-error :: TypingContext -> List Nat -> List (Nat, String, UType) -> Span -> String -> Bool -> List (Nat, UType) -> Option (Span, String)
  par-captures-error context owned bound sp op many-shot captures = case captures of
    [] -> None
    (id, ty) : rest -> case par-capture-error context owned bound sp op many-shot id ty of
      Some error -> Some error
      None -> par-captures-error context owned bound sp op many-shot rest
  par-capture-error :: TypingContext -> List Nat -> List (Nat, String, UType) -> Span -> String -> Bool -> Nat -> UType -> Option (Span, String)
  par-capture-error context owned bound sp op many-shot id ty =
    let actual = if task-id-present id (par-ids bound) then par-lookup bound id else ty in
    let display = par-name bound id ty in
    if task-type-holds-memo actual then
      Some (sp, string-concat-all ["a parallel capture cannot be a memo cell: ", display,
        " holds a `Lazy` cell, which is single-threaded by construction (design/parallel-evaluation.md section 2.3)"])
    else if task-type-holds-mut actual then
      Some (sp, string-concat-all ["an exclusive `Mut` borrow cannot enter a parallel callback: ", display,
        " holds one (design/parallel-evaluation.md section 2.3)"])
    else if task-shareable context [] 64 actual || scoped-copy context actual then None
    -- A `%1`/`%aff` capture may move into one `parBoth` branch: the branch
    -- runs exactly once and consumes it, which the usage check already
    -- counted (`use-count-once`). The many-shot callbacks run once per
    -- index, so a move there would consume the value many times.
    else if not many-shot && task-id-present id owned then None
    else if many-shot then
      Some (sp, string-concat-all ["a ", op, " callback runs once per index, so ", display,
        " cannot move into it: a parallel capture must be Share (design/parallel-evaluation.md section 2.3)",
        par-blocker-clause context actual])
    else
      Some (sp, string-concat-all ["a parallel capture must be Share, or move into one parBoth branch: ", display,
        " is shared with a ", op, " callback without shareable evidence (design/parallel-evaluation.md section 2.3)",
        par-blocker-clause context actual])
  -- The reason a type is not Share, named. The generic refusal above says
  -- the rule; this says which type in the walk failed and why, so a reader
  -- can act on it. A type that never became a `CoreData` is the case that
  -- used to be silent: an imported declaration contributes a nominal row,
  -- not a constructor table, so the structural walk has no fields to read
  -- and answers False without naming anything. Empty when the walk failed
  -- for a reason this does not explain, so the message never guesses.
  par-blocker-clause :: TypingContext -> UType -> String
  par-blocker-clause context ty = case task-blocker context [] 64 ty of
    None -> ""
    Some message -> string-concat "; " message
  task-blocker :: TypingContext -> List UType -> Nat -> UType -> Option String
  task-blocker context seen fuel ty = if fuel == 0 then None else if task-seen-type ty seen || task-shareable context seen fuel ty then None else
    case task-type-spine ty [] of
      (UCon name kind, args) -> case task-data name (context.datas) of
        None -> Some (string-concat-all ["the type ", display-type-text ty,
          " has no checked declaration in this module, so its constructor fields cannot be read: ",
          "an imported type contributes a nominal row only, and a parallel capture needs the ",
          "field types of every constructor (design/parallel-evaluation.md section 2.3)"])
        Some d -> task-blocker-constructors context (ty : seen) (fuel - 1)
          (task-actuals (core-data-params d) args) (core-data-constructors d)
      other -> None
  -- The innermost field type the walk could not read. A capture is refused
  -- because of a type the module never declared, so naming the outer type
  -- alone ("Store") would still leave a reader guessing which field is at
  -- fault; this reports the field's own type.
  task-blocker-constructors :: TypingContext -> List UType -> Nat -> List (Nat, UType) -> List CoreConstructor -> Option String
  task-blocker-constructors context seen fuel pairs constructors = case constructors of
    [] -> None
    constructor : rest -> case task-blocker-fields context seen fuel pairs (core-constructor-fields constructor) of
      Some message -> Some message
      None -> task-blocker-constructors context seen fuel pairs rest
  task-blocker-fields :: TypingContext -> List UType -> Nat -> List (Nat, UType) -> List UType -> Option String
  task-blocker-fields context seen fuel pairs fields = case fields of
    [] -> None
    first : rest -> case task-blocker context seen fuel (substitute-bound pairs first) of
      Some message -> Some message
      None -> task-blocker-fields context seen fuel pairs rest
  par-ids :: List (Nat, String, UType) -> List Nat
  par-ids bound = case bound of [] -> []; (id, name, ty) : rest -> id : (par-ids rest)
  par-lookup :: List (Nat, String, UType) -> Nat -> UType
  par-lookup bound id = case bound of
    [] -> UError
    (key, name, ty) : rest -> if key == id then ty else par-lookup rest id
  -- The captured binding's own name where the binder is visible, else its
  -- type, matching the seed's `c.name` in the same three messages.
  par-name :: List (Nat, String, UType) -> Nat -> UType -> String
  par-name bound id ty = case bound of
    [] -> type-text ty
    (key, name, carrier) : rest -> if key == id then (if string-length name == 0 then type-text ty else name) else par-name rest id ty

  task-clauses-error :: TypingContext -> List CorePattern -> UType -> List CoreClause -> Option (Span, String)
  task-clauses-error context prefix declared clauses = case clauses of
    [] -> None
    (CoreClause sp patterns body) : rest -> let bound = prefix <> patterns in
      let failure = (if task-code-present context body || task-patterns-present bound then
        task-pattern-error context [] (task-transfer-patterns declared patterns) bound body else None) in
      case failure of Some error -> failure; None -> task-clauses-error context prefix declared rest
  task-patterns-present :: List CorePattern -> Bool
  task-patterns-present patterns = case patterns of [] -> False; p : rest -> task-scoped-type (pattern-type p) || affine-thunk (pattern-type p) || task-patterns-present rest
  checked-spawn :: UType -> CoreTerm -> CoreTerm -> Bool
  checked-spawn expected token body = case (scope-parameters (core-type token), task-body-parts (core-type body)) of
    (Some (owner, region), Some (error, value, row)) -> equal-type expected (task-type region error value)
    other -> False
  checked-scope :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> UType -> CoreEvidence -> CoreTerm -> Bool
  checked-scope context scope gamma facts expected region evidence callback = case (region, scope-callback-parts (core-type callback)) of
    (URigid id name level KRegion, Some (owner, bound, row, result)) -> equal-type region bound && equal-type expected result
      && scope-region-closed region expected && scope-region-closed region row
      && evidence-types context scope evidence && equal-type (evidence-type evidence) (UApp (UCon "b.Io" (KFun KRegion KType)) owner)
      && (case add-rigid-kind id KRegion scope of Some opened -> checked-term context opened gamma facts callback; None -> False)
    other -> False
  effect-for-label :: UType -> List CoreEffect -> Option CoreEffect
  effect-for-label label declarations = case declarations of
    [] -> None
    declaration : rest -> case handler-label-name label of
      Some name -> if name == declaration.effect-name then Some declaration else effect-for-label label rest
      None -> None
  handler-label-name :: UType -> Option String
  handler-label-name label = case label of UCon name kind -> Some name; UApp f x -> handler-label-name f; other -> None
  handler-openings-match :: List Quant -> List (Nat, UType) -> List (Nat, UType) -> Bool
  handler-openings-match qs entries prior = case (qs, entries) of
    ([], []) -> True
    (q : rest, (key, URigid id name level kind) : more) -> key == q.id
      && kind-equal kind (map-kind-types (substitute-bound prior) (q.kind))
      && handler-openings-match rest more ((key, URigid id name level kind) : prior)
    other -> False
  handler-return-row :: UType -> Option UType
  handler-return-row ty = case ty of UFun a b -> Some empty-row; UFunEff a row b -> Some row; other -> None
  handler-operation-rows :: CoreTerm -> UType
  handler-operation-rows operations = case operations of
    CHandlerEnd sp -> empty-row
    CHandlerOperation sp slot openings row closure rest -> union-effects row (handler-operation-rows rest)
    other -> UError
  handler-operations-typed :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> CoreEffect -> UType -> UType -> List CoreOperation -> CoreTerm -> Bool
  handler-operations-typed context scope gamma facts declaration label output expected operations = case (expected, operations) of
    ([], CHandlerEnd sp) -> True
    (operation : more, CHandlerOperation sp slot openings row closure rest) -> slot == operation.operation-slot
      && (case handler-operation-scheme declaration label operation of
        Some sc -> handler-openings-match (scheme-params sc) openings []
          && (case openings-scope context scope openings of
            Some opened -> let actual = substitute-bound openings (scheme-body sc) in
              wf context opened row && equal-type (handler-clause-type actual output row) (core-type closure)
                && checked-term context opened gamma facts closure && handler-resumption-safe actual closure
            None -> False)
        None -> False)
      && handler-operations-typed context scope gamma facts declaration label output more rest
    other -> False
  checked-handler :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> CoreTerm -> CoreTerm -> Bool
  checked-handler context scope gamma facts ty returned operations = case (handler-parts ty, handler-return-row (core-type returned)) of
    (Some (label, input, output, row), Some returned-row) ->
      wf context scope label && wf context scope input && wf context scope output && wf context scope row
      && equal-type (UFunEff input returned-row output) (core-type returned)
      && checked-term context scope gamma facts returned
      && equal-type row (union-effects returned-row (handler-operation-rows operations))
      && (case effect-for-label label (context.effects) of
        Some declaration -> handler-operations-typed context scope gamma facts declaration label output (declaration.effect-operations) operations
        None -> False)
    other -> False
  handler-operation-names :: List CoreOperation -> List String
  handler-operation-names operations = case operations of [] -> []; first : rest -> (first.operation-name) : (handler-operation-names rest)
  checked-handle :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> UType -> UType -> CoreTerm -> CoreTerm -> Bool
  checked-handle context scope gamma facts ty label residual body handled-by = wf context scope label && wf context scope residual
    && checked-term context scope gamma facts body && checked-term context scope gamma facts handled-by
    && (case effect-for-label label (context.effects) of Some declaration -> handler-body-allowed label (handler-operation-names (declaration.effect-operations)) handled-by body; None -> False)
    && (case handler-parts (core-type handled-by) of
      Some (declared, input, output, row) -> equal-type label declared && equal-type input (core-type body) && equal-type output ty
        && (case handler-residual label (core-effects body) of Some actual -> equal-type actual residual; None -> False)
      None -> False)
  checked-let :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> Nat -> Scheme -> CoreTerm -> CoreTerm -> Bool
  checked-let context scope gamma facts ty id sc rhs body =
    let lscope = case sing-type-parts (scheme-body sc) of Some _ -> add-type-rigids (scheme-body sc) scope; None -> scope in
    body-scheme-authorized (context-bodies context) sc && scheme-well-formed-in (context.kinds) lscope sc
    && not (volatile-borrow-index (scheme-body sc)) && (case scheme-requirements sc of [] -> True; other -> False)
    && equal-type-in context (scheme-body sc) (core-type rhs) && equal-type-in context ty (core-type body)
    && (case scheme-type-scope-in (context.kinds) lscope (scheme-params sc) of Some universal -> checked-term context universal gamma facts rhs; None -> False)
    && (case add-local-scheme id sc lscope of
      Some bound -> let writes = core-mutable-writes rhs in
        let next = proof-after-writes (scope-let gamma facts id sc rhs) writes in
        let base = case scoped-core-let-fact gamma facts id sc rhs of Some p -> p : facts; None -> facts in
        let more = (case rhs of
          CIf _ _ cond yes no ->
            let y-ab = term-aborts-uninhabited (context.effects) yes in
            let n-ab = term-aborts-uninhabited (context.effects) no in
            if y-ab /= n-ab then
              (case scoped-core-branch gamma base cond n-ab of
                Some p -> p : base
                None -> base)
            else base
          other -> base) in
        checked-term context bound next (facts-after-writes gamma more writes) body
      None -> False)
  recursive-type-scope :: TypingContext -> TypeScope -> CoreTerm -> Option TypeScope
  recursive-type-scope context scope members = case members of
    CRecursiveBindingsEnd -> Some scope
    CRecursiveBinding id name value rest -> let scheme = mono (core-type value) in
      if scheme-well-formed-in (context.kinds) scope scheme && body-scheme-authorized (context-bodies context) scheme
      then (case add-local-scheme id scheme scope of Some bound -> recursive-type-scope context bound rest; None -> None)
      else None
    other -> None
  checked-recursive-functions :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> CoreTerm -> Bool
  checked-recursive-functions context scope gamma facts members = case members of
    CRecursiveBindingsEnd -> True
    CRecursiveBinding id name (CLambda sp ty pattern body) rest ->
      checked-term context scope gamma facts (CLambda sp ty pattern body) && checked-recursive-functions context scope gamma facts rest
    other -> False
  checked-recursive-values :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> CoreTerm -> Bool
  checked-recursive-values context scope gamma facts members = case members of
    CRecursiveBindingsEnd -> True
    CRecursiveBinding id name value rest ->
      checked-term context scope gamma facts value && checked-recursive-values context scope gamma facts rest
    other -> False
  openings-scope :: TypingContext -> TypeScope -> List (Nat, UType) -> Option TypeScope
  openings-scope context scope openings = case openings of
    [] -> Some scope
    (key, URigid id name level kind) : rest -> if body-kind-authorized (context-bodies context) kind && kind-well-formed-in (context.kinds) scope kind then
      (case add-rigid-kind id kind scope of Some bound -> openings-scope context bound rest; None -> None) else None
    (key, UIndex carrier (IRigid id name level)) : rest -> if body-type-authorized (context-bodies context) carrier && wf context scope carrier then
      (case add-rigid-kind id (value-kind carrier) scope of Some bound -> openings-scope context bound rest; None -> None) else None
    other -> None
  private-scope :: TypeScope -> List (Nat, Kind) -> Option TypeScope
  private-scope scope entries = case entries of [] -> Some scope; (id, kind) : rest -> case add-rigid-kind id kind scope of Some bound -> private-scope bound rest; None -> None
  private-kinds :: TypingContext -> TypeScope -> List (Nat, Kind) -> Bool
  private-kinds context scope entries = case entries of [] -> True; (id, kind) : rest -> body-kind-authorized (context-bodies context) kind && kind-well-formed-in (context.kinds) scope kind && private-kinds context scope rest
  givens-typed :: TypingContext -> TypeScope -> List CoreGiven -> Bool
  givens-typed context scope givens = case givens of [] -> True; given : rest -> wf context scope (given.ty) && givens-typed context scope rest
  clause-typed :: TypingContext -> TypeScope -> ProofScope -> UType -> UType -> List CorePattern -> CoreTerm -> Bool
  clause-typed context scope gamma expected allowed patterns body = case patterns of
    [] -> equal-type-in context expected (core-type body) && checked-term context scope gamma [] body && effects-fit (core-effects body) allowed
    pattern : rest -> effects-fit allowed empty-row && (case (arrow-domain (reduce-in context expected), pattern-result (reduce-in context expected) pattern) of
      (Some (domain, row), Some result) -> pattern-usage-allowed context expected pattern body
        && (case arrow-pattern-scope context scope expected domain pattern of Some bound -> clause-typed context bound (proof-pattern pattern gamma) result row rest body; None -> False)
      other -> False)
  value-parameters-scope :: TypeScope -> List (Nat, UType) -> Option TypeScope
  value-parameters-scope scope values = case values of
    [] -> Some scope
    (id, carrier) : rest -> (case add-value-parameter id carrier scope of Some next -> value-parameters-scope next rest; None -> None)
  clauses-typed :: TypingContext -> TypeScope -> UType -> List CoreClause -> Bool
  clauses-typed context scope expected clauses = clauses-typed-with context scope [] expected clauses
  clauses-typed-with :: TypingContext -> TypeScope -> List (Nat, UType) -> UType -> List CoreClause -> Bool
  clauses-typed-with context scope values expected clauses = case clauses of
    [] -> True
    (CoreClause sp patterns body) : rest -> clause-typed context scope (with-guarded-bindings (context-guarded-bodies context) (with-checked-body-bindings (context-body-context context) (make-proof-scope values []))) expected empty-row patterns body && clauses-typed-with context scope values expected rest
  typing-definition-closed :: TypingContext -> CoreDefinition -> Bool
  typing-definition-closed context definition =
    core-definition-checked-contracts-closed-with (context.type-families) (context.promoted) (context-body-context context) (context-guarded-bodies context) definition
    && task-definition-safe context definition && (case par-definition-error context definition of None -> True; Some error -> False) && definition-structure-closed context definition

  -- On the compiler path the same checks also provide diagnostics. Keep
  -- their order so the most specific refusal reaches the source location.
  checked-definition-error :: TypingContext -> CoreDefinition -> Option (Span, String)
  checked-definition-error context definition =
    let fams = context.type-families in
    let proms = context.promoted in
    let bodies = context-body-context context in
    let guarded = context-guarded-bodies context in
    let at = Span 0 0 1 1 in
    if not (core-definition-checked-contracts-closed-with fams proms bodies guarded definition) then
      let reason = case core-definition-refusal-with fams proms bodies guarded definition of Some message -> message; None -> "the conjunction refused without a named clause" in
      Some (at, "typed core contains an unresolved scheme or error term: " <> definition.name <> ": " <> reason)
      else case par-definition-error context definition of
        Some error -> Some error
        None -> case task-definition-error context definition of
          Some error -> Some error
          None -> if definition-structure-closed context definition then None
            else Some (at, "independent Core typing disagrees with the declaration or term: " <> definition.name)
  definition-structure-closed :: TypingContext -> CoreDefinition -> Bool
  definition-structure-closed context definition = (case context of TypingContext kinds globals effects datas forwarders usage copies families promoted -> global-definition-closed-in families promoted globals definition)
    && (case openings-scope context empty-type-scope (definition.openings) of
      Some opened -> (case private-scope opened (definition.private-types) of
        Some scope -> private-kinds context scope (definition.private-types) && givens-typed context scope (definition.givens)
          && (case value-parameters-scope scope (opening-value-types (definition.openings)) of
            Some values -> clauses-typed-with (with-copy-givens context (definition.givens)) values (opening-value-types (definition.openings)) (substitute-bound (definition.openings) (scheme-body (definition.scheme))) (definition.clauses)
            None -> False)
        None -> False)
      None -> False)

