-- Pluggable formal verification engine for inline LLVM IR `prim` declarations.
--
-- Mirrors `seed/src/prim_verify/` in pure self-hosted Cinch:
--   1. Shared hash-consed semantic DAG (`SemGraph`) with three-valued
--      Alive2-faithful denotations (value + poison + immediate UB).
--   2. Versioned LLVM IR semantics (`llvm-sem@21.1`) lowering straight-line
--      Cinch-LLVM fragments into `SemGraph`.
--   3. Cinch source `spec` and refinement predicate lowering into the same
--      `SemGraph`, producing canonical `Obligation`s (no-ub, no-poison,
--      refinement/spec equivalence).
--   4. Pluggable prover and checker seams:
--      - Deterministic Tseitin bit-blaster + built-in SAT solver emitting
--        `lrat/v1` RUP proofs and concrete counterexamples.
--      - Independent `verify-lrat` kernel checker (`cinch-kernel-lrat@1`,
--        tier `kernel-cert`) and compiled checker (`cinch-compiled-lrat@1`,
--        tier `compiled-cert`, rejected under `#[profile("jpl")]` / `strict`).
--      - SMT-LIB 2 emitter (`obligation-to-smtlib2`) over `QF_BV` / `QF_FPBV`
--        for plugging external SMT solvers (`smt-verified`).
--   5. Explicit `TrustReceipt`s, `PrimProofFact`s for `.cinchif`, and honest
--      `default` / `strict` / `lax` / `off` compilation modes (`cinch-lax-bypass@1`
--      and `cinch-verify-off@1` downgrade to `assumed`, never forging `verified`,
--      while `lax` still rejects actively disproved counterexamples).

module Cinch.PrimVerify where

  import Algebra.Semigroup
  import Cinch.Ast (Expr, EVar, ECon, ELitInt, EApp, EBin, ENeg, EIf, ELet, ELetScope, ELam, EAnn, EBinding, EBindingsEnd, EArg, EArgsEnd, EUnit, Pat, PVar, exprs-of)
  import Cinch.Core (CoreDefinition, CoreClause, CorePattern, CPVar, CPWild, CoreTerm, CUse, CLocal, CInt, CUnit, CApply, CApplyEff, CLet, CIf, CPrimitive, CArgument, CArgumentsEnd, CMethod, CProved, CRefine, CForget, CCast, CRequire, CDischarge, CPolyElim, core-type)
  import Cinch.Document
  import Cinch.Interface (fnv-source-hash, sha256-hex, u64-decimal)
  import Cinch.Index (IndexTerm, IInteger, IBound, IRigid, IAdd, ISubtract, IMultiply)
  import Cinch.Nominal (decode-identity)
  import Cinch.Type (UType, KType, UCon, UApp, UFun, UFunEff, UPi, UBound, URigid, URefine, URequire, UCompare, UPropAnd, UPropOr, UPropNot, UPropNonZero, UPropNotNaN, UPropFinite, UIndex, UIndexMath, UIndexForget, UIndexPromote, refinement-view, float-literal-bits, float-string-bits)
  import Data.Bool
  import Data.Char (is-ascii-digit, char-code, char-from-code)
  import Data.Int
  import Data.List (reverse)
  import Data.Machine
  import Data.Nat (nat-from-int, nat-to-int, saturating-sub)
  import Data.Option (Option, None, Some)
  import Data.Result (Result, Ok, Err)
  import Data.String (string-compare, string-concat, string-concat-all, string-length, string-slice, string-to-bytes, unpack, pack)
  import Text.Scan (string-contains, string-split-on, string-starts-with, string-ends-with, string-strip, string-words)
  import Text.Show (nat-to-string, int-to-string)

  export TrustReceipt, MkTrustReceipt, receipt-to-json, receipts-to-json
  export receipt-tier, receipt-checker-id, receipt-goal-hash, receipt-evidence-hash
  export receipt-semantics-id, receipt-prover-id, receipt-tcb, receipt-evidence-payload
  export PrimProofFact, MkPrimProofFact, prim-proof-fact-to-json
  export VerifyOutcome, OutcomeVerified, OutcomeAssumed, OutcomeDisproved, OutcomeRejected, OutcomeOpen
  export PrimParamSpec, MkPrimParamSpec, param-spec-name, param-spec-width, param-spec-signed, param-spec-fp, param-spec-bool
  export SpecDef, MkSpecDef
  export LratStep, LratAdd, verify-lrat, parse-lrat-steps, verify-lrat-text, serialize-lrat-steps
  export SemGraph, SemType, SBool, SBv, SFp, SVec, obligation-to-smtlib2
  export verify-prim-body, verify-prim-body-cached, verify-prim-cross-target
  export verify-alethe, verify-rewrite-rule, verify-rewrite-rule-for, audit-memory-atomic-contract, audit-memory-atomic-contract-for, validate-llvm-equiv, validate-llvm-memory-equiv, validate-fn-rc-safety, validate-module-rc-safety
  export TvReport, MkTvReport, tv-report-fn, tv-report-stage, tv-report-status, tv-report-details, validate-program-codegen-for-word-bits, render-tv-reports, tv-reports-disproved
  export is-verify-justification-word, worst-trust-tier, receipts-tcb-union

  -- ==========================================================================
  -- 1. Persistent NatMap (binary trie over Nat keys, Share/positivity-safe)
  -- ==========================================================================

  data NatMap a where
    NMEmpty :: NatMap a
    NMNode :: Option a -> NatMap a -> NatMap a -> NatMap a

  nm-empty :: forall a. NatMap a
  nm-empty = NMEmpty

  nat-half :: Nat -> Nat
  nat-half n = case checked-div n 2 of Some q -> q; None -> 0

  nat-odd :: Nat -> Bool
  nat-odd n = case checked-rem n 2 of Some r -> r /= 0; None -> False

  nm-lookup :: forall a. Nat -> NatMap a -> Option a
  nm-lookup k m = case m of
    NMEmpty -> None
    NMNode val left right ->
      if k == 0 then val
      else if nat-odd k then nm-lookup (nat-half k) right
      else nm-lookup (nat-half k) left

  nm-insert :: forall a. Nat -> a -> NatMap a -> NatMap a
  nm-insert k v m = case m of
    NMEmpty ->
      if k == 0 then NMNode (Some v) NMEmpty NMEmpty
      else if nat-odd k then NMNode None NMEmpty (nm-insert (nat-half k) v NMEmpty)
      else NMNode None (nm-insert (nat-half k) v NMEmpty) NMEmpty
    NMNode val left right ->
      if k == 0 then NMNode (Some v) left right
      else if nat-odd k then NMNode val left (nm-insert (nat-half k) v right)
      else NMNode val (nm-insert (nat-half k) v left) right

  nm-delete :: forall a. Nat -> NatMap a -> NatMap a
  nm-delete k m = case m of
    NMEmpty -> NMEmpty
    NMNode val left right ->
      if k == 0 then NMNode None left right
      else if nat-odd k then NMNode val left (nm-delete (nat-half k) right)
      else NMNode val (nm-delete (nat-half k) left) right

  nm2-lookup :: forall a. Nat -> Nat -> NatMap (NatMap a) -> Option a
  nm2-lookup k1 k2 m = case nm-lookup k1 m of
    None -> None
    Some inner -> nm-lookup k2 inner

  nm2-insert :: forall a. Nat -> Nat -> a -> NatMap (NatMap a) -> NatMap (NatMap a)
  nm2-insert k1 k2 v m =
    let inner = case nm-lookup k1 m of Some sub -> sub; None -> nm-empty in
    nm-insert k1 (nm-insert k2 v inner) m

  nm3-lookup :: forall a. Nat -> Nat -> Nat -> NatMap (NatMap (NatMap a)) -> Option a
  nm3-lookup k1 k2 k3 m = case nm-lookup k1 m of
    None -> None
    Some inner -> nm2-lookup k2 k3 inner

  nm3-insert :: forall a. Nat -> Nat -> Nat -> a -> NatMap (NatMap (NatMap a)) -> NatMap (NatMap (NatMap a))
  nm3-insert k1 k2 k3 v m =
    let inner = case nm-lookup k1 m of Some sub -> sub; None -> nm-empty in
    nm-insert k1 (nm2-insert k2 k3 v inner) m

  -- ==========================================================================
  -- 2. String helpers, TrustReceipt, Policy, VerifyOutcome
  -- ==========================================================================

  same :: String -> String -> Bool
  same a b = string-compare a b == 0

  has-str :: String -> List String -> Bool
  has-str x xs = case xs of
    Nil -> False
    Cons h t -> same x h || has-str x t

  insert-unique-sorted :: String -> List String -> List String
  insert-unique-sorted x xs = case xs of
    Nil -> Cons x Nil
    Cons h t ->
      let c = string-compare x h in
      if c == 0 then xs
      else if c < 0 then Cons x xs
      else Cons h (insert-unique-sorted x t)

  union-sorted :: List String -> List String -> List String
  union-sorted xs ys = case xs of
    Nil -> ys
    Cons h t -> union-sorted t (insert-unique-sorted h ys)

  join-str :: String -> List String -> String
  join-str sep xs = case xs of
    Nil -> ""
    Cons h Nil -> h
    Cons h t -> string-concat-all [h, sep, join-str sep t]

  str-list-json :: List String -> Json
  str-list-json xs = case xs of
    Nil -> JArrEnd
    Cons h t -> JArr (JStr h) (str-list-json t)

  is-verify-justification-word :: String -> Bool
  is-verify-justification-word w =
    same w "verify" || same w "verify-lrat" || same w "verify-compiled-lrat"

  data TrustReceipt where
    MkTrustReceipt :: String -> String -> String -> String -> String -> String -> String -> String -> List String -> String -> TrustReceipt

  receipt-goal-hash :: TrustReceipt -> String
  receipt-goal-hash r = case r of MkTrustReceipt gh sem prv chk tier fmt eh verd tcb pay -> gh

  receipt-semantics-id :: TrustReceipt -> String
  receipt-semantics-id r = case r of MkTrustReceipt gh sem prv chk tier fmt eh verd tcb pay -> sem

  receipt-prover-id :: TrustReceipt -> String
  receipt-prover-id r = case r of MkTrustReceipt gh sem prv chk tier fmt eh verd tcb pay -> prv

  receipt-checker-id :: TrustReceipt -> String
  receipt-checker-id r = case r of MkTrustReceipt gh sem prv chk tier fmt eh verd tcb pay -> chk

  receipt-tier :: TrustReceipt -> String
  receipt-tier r = case r of MkTrustReceipt gh sem prv chk tier fmt eh verd tcb pay -> tier

  receipt-evidence-hash :: TrustReceipt -> String
  receipt-evidence-hash r = case r of MkTrustReceipt gh sem prv chk tier fmt eh verd tcb pay -> eh

  receipt-tcb :: TrustReceipt -> List String
  receipt-tcb r = case r of MkTrustReceipt gh sem prv chk tier fmt eh verd tcb pay -> tcb

  receipt-evidence-payload :: TrustReceipt -> String
  receipt-evidence-payload r = case r of MkTrustReceipt gh sem prv chk tier fmt eh verd tcb pay -> pay

  receipt-to-json :: TrustReceipt -> Json
  receipt-to-json r = case r of
    MkTrustReceipt gh sem prv chk tier fmt eh verd tcb pay ->
      JObj "goal_hash" (JStr gh)
        (JObj "semantics_id" (JStr sem)
          (JObj "prover_id" (JStr prv)
            (JObj "checker_id" (JStr chk)
              (JObj "tier" (JStr tier)
                (JObj "evidence_format" (JStr fmt)
                  (JObj "evidence_hash" (JStr eh)
                    (JObj "verdict" (JStr verd)
                      (JObj "tcb" (str-list-json tcb) JObjEnd))))))))

  receipts-to-json :: List TrustReceipt -> Json
  receipts-to-json rs = case rs of
    Nil -> JArrEnd
    Cons r rest -> JArr (receipt-to-json r) (receipts-to-json rest)

  tier-rank :: String -> Nat
  tier-rank t =
    if same t "kernel-cert" then 0
    else if same t "compiled-cert" then 1
    else if same t "smt-verified" then 2
    else 3

  worst-trust-tier :: List TrustReceipt -> String
  worst-trust-tier rs = worst-tier-loop rs "kernel-cert"

  worst-tier-loop :: List TrustReceipt -> String -> String
  worst-tier-loop rs cur = case rs of
    Nil -> cur
    Cons r rest ->
      let t = receipt-tier r in
      let next = if tier-rank t > tier-rank cur then t else cur in
      worst-tier-loop rest next

  receipts-tcb-union :: List TrustReceipt -> List String
  receipts-tcb-union rs = case rs of
    Nil -> Nil
    Cons r rest -> union-sorted (receipt-tcb r) (receipts-tcb-union rest)

  data PrimProofFact where
    MkPrimProofFact :: String -> String -> String -> String -> List String -> PrimProofFact

  prim-proof-fact-to-json :: PrimProofFact -> Json
  prim-proof-fact-to-json f = case f of
    MkPrimProofFact name spec-text sem tier tcb ->
      JObj "name" (JStr name)
        (JObj "spec" (JStr spec-text)
          (JObj "semantics_id" (JStr sem)
            (JObj "tier" (JStr tier)
              (JObj "tcb" (str-list-json tcb) JObjEnd))))

  data VerifyOutcome where
    OutcomeVerified :: List TrustReceipt -> VerifyOutcome
    OutcomeAssumed :: List TrustReceipt -> VerifyOutcome
    OutcomeDisproved :: String -> VerifyOutcome
    OutcomeRejected :: String -> VerifyOutcome
    OutcomeOpen :: String -> VerifyOutcome

  data PrimParamSpec where
    MkPrimParamSpec :: String -> String -> Nat -> Bool -> Bool -> Bool -> PrimParamSpec

  param-spec-name :: PrimParamSpec -> String
  param-spec-name p = case p of MkPrimParamSpec nm ty w sg fp bl -> nm

  param-spec-width :: PrimParamSpec -> Nat
  param-spec-width p = case p of MkPrimParamSpec nm ty w sg fp bl -> w

  param-spec-signed :: PrimParamSpec -> Bool
  param-spec-signed p = case p of MkPrimParamSpec nm ty w sg fp bl -> sg

  param-spec-fp :: PrimParamSpec -> Bool
  param-spec-fp p = case p of MkPrimParamSpec nm ty w sg fp bl -> fp

  param-spec-bool :: PrimParamSpec -> Bool
  param-spec-bool p = case p of MkPrimParamSpec nm ty w sg fp bl -> bl

  data SpecDef where
    MkSpecDef :: String -> List String -> Expr -> SpecDef

  spec-def-name :: SpecDef -> String
  spec-def-name d = case d of MkSpecDef nm ps body -> nm

  lookup-spec-def :: String -> List SpecDef -> Option SpecDef
  lookup-spec-def wanted defs = case defs of
    Nil -> None
    Cons d rest ->
      if same (spec-def-name d) wanted || string-ends-with (string-concat "." wanted) (spec-def-name d) then Some d
      else lookup-spec-def wanted rest

  -- ==========================================================================
  -- 3. Shared Semantic DAG (`SemGraph`)
  -- ==========================================================================

  data SemType where
    SBool :: SemType
    SBv :: Nat -> SemType
    SFp :: Nat -> SemType
    SVec :: Nat -> Nat -> SemType

  sem-type-key :: SemType -> String
  sem-type-key t = case t of
    SBool -> "bool"
    SBv w -> string-concat "bv" (nat-to-string w)
    SFp w -> string-concat "fp" (nat-to-string w)
    SVec n w -> string-concat-all ["vec", nat-to-string n, "x", nat-to-string w]

  sem-type-width :: SemType -> Nat
  sem-type-width t = case t of
    SBool -> 1
    SBv w -> w
    SFp w -> w
    SVec n w -> n * w

  data SemNode where
    NBoolConst :: Bool -> SemNode
    NBvConst :: Nat -> U64 -> U64 -> SemNode
    NVar :: Nat -> SemType -> String -> SemNode
    NNot :: Nat -> SemNode
    NAnd :: Nat -> Nat -> SemNode
    NOr :: Nat -> Nat -> SemNode
    NXor :: Nat -> Nat -> SemNode
    NImplies :: Nat -> Nat -> SemNode
    NEqBool :: Nat -> Nat -> SemNode
    NIte :: Nat -> Nat -> Nat -> SemNode
    NBvUn :: String -> Nat -> Nat -> SemNode
    NBvBin :: String -> Nat -> Nat -> Nat -> SemNode
    NBvCmp :: String -> Nat -> Nat -> Nat -> SemNode
    NBvCast :: String -> Nat -> Nat -> Nat -> SemNode
    NBvExtract :: Nat -> Nat -> Nat -> SemNode
    NBvConcat :: Nat -> Nat -> SemNode
    NBvTri :: String -> Nat -> Nat -> Nat -> Nat -> SemNode
    NFpUn :: String -> Nat -> Nat -> SemNode
    NFpBin :: String -> Nat -> Nat -> Nat -> SemNode
    NFpCmp :: String -> Nat -> Nat -> Nat -> SemNode
    NFpCast :: String -> Nat -> Nat -> Nat -> SemNode
    NFpPred :: String -> Nat -> Nat -> SemNode

  node-key :: SemNode -> String
  node-key n = case n of
    NBoolConst b -> if b then "B1" else "B0"
    NBvConst w lo hi -> string-concat-all ["C", nat-to-string w, ":", u64-decimal hi, ":", u64-decimal lo]
    NVar i ty nm -> string-concat-all ["V", nat-to-string i, ":", sem-type-key ty]
    NNot a -> string-concat "!(" (string-concat (nat-to-string a) ")")
    NAnd a b -> string-concat-all ["&(", nat-to-string a, ",", nat-to-string b, ")"]
    NOr a b -> string-concat-all ["|(", nat-to-string a, ",", nat-to-string b, ")"]
    NXor a b -> string-concat-all ["^(", nat-to-string a, ",", nat-to-string b, ")"]
    NImplies a b -> string-concat-all ["->(", nat-to-string a, ",", nat-to-string b, ")"]
    NEqBool a b -> string-concat-all ["==b(", nat-to-string a, ",", nat-to-string b, ")"]
    NIte c t e -> string-concat-all ["ite(", nat-to-string c, ",", nat-to-string t, ",", nat-to-string e, ")"]
    NBvUn op w a -> string-concat-all [op, "_", nat-to-string w, "(", nat-to-string a, ")"]
    NBvBin op w a b -> string-concat-all [op, "_", nat-to-string w, "(", nat-to-string a, ",", nat-to-string b, ")"]
    NBvCmp op w a b -> string-concat-all ["cmp_", op, "_", nat-to-string w, "(", nat-to-string a, ",", nat-to-string b, ")"]
    NBvCast op fw tw a -> string-concat-all [op, "_", nat-to-string fw, "_", nat-to-string tw, "(", nat-to-string a, ")"]
    NBvExtract hi lo a -> string-concat-all ["ext_", nat-to-string hi, "_", nat-to-string lo, "(", nat-to-string a, ")"]
    NBvConcat hi lo -> string-concat-all ["cat(", nat-to-string hi, ",", nat-to-string lo, ")"]
    NBvTri op w a b c -> string-concat-all [op, "_", nat-to-string w, "(", nat-to-string a, ",", nat-to-string b, ",", nat-to-string c, ")"]
    NFpUn op w a -> string-concat-all ["fp_", op, "_", nat-to-string w, "(", nat-to-string a, ")"]
    NFpBin op w a b -> string-concat-all ["fp_", op, "_", nat-to-string w, "(", nat-to-string a, ",", nat-to-string b, ")"]
    NFpCmp op w a b -> string-concat-all ["fpcmp_", op, "_", nat-to-string w, "(", nat-to-string a, ",", nat-to-string b, ")"]
    NFpCast op fw tw a -> string-concat-all ["fpcast_", op, "_", nat-to-string fw, "_", nat-to-string tw, "(", nat-to-string a, ")"]
    NFpPred op w a -> string-concat-all ["fppred_", op, "_", nat-to-string w, "(", nat-to-string a, ")"]

  data SemGraph where
    MkSemGraph :: Nat -> NatMap SemNode -> List (String, Nat) -> Bool -> Bool -> SemGraph

  empty-sem-graph :: SemGraph
  empty-sem-graph = MkSemGraph 0 nm-empty Nil False False

  graph-has-fp :: SemGraph -> Bool
  graph-has-fp g = case g of MkSemGraph cnt nodes cache fp fpa -> fp

  graph-has-fp-arith :: SemGraph -> Bool
  graph-has-fp-arith g = case g of MkSemGraph cnt nodes cache fp fpa -> fpa

  graph-node :: Nat -> SemGraph -> Option SemNode
  graph-node id g = case g of MkSemGraph cnt nodes cache fp fpa -> nm-lookup id nodes

  lookup-str-nat :: String -> List (String, Nat) -> Option Nat
  lookup-str-nat k xs = case xs of
    Nil -> None
    Cons (k1, v1) rest -> if same k k1 then Some v1 else lookup-str-nat k rest

  node-is-fp :: SemNode -> Bool
  node-is-fp n = case n of
    NFpUn op w a -> True
    NFpBin op w a b -> True
    NFpCmp op w a b -> True
    NFpCast op fw tw a -> True
    NFpPred op w a -> True
    NVar i (SFp w) nm -> True
    other -> False

  node-is-fp-arith :: SemNode -> Bool
  node-is-fp-arith n = case n of
    NFpUn op w a -> not (same op "fneg" || string-starts-with "@llvm.fabs." op)
    NFpBin op w a b -> not (string-starts-with "@llvm.copysign." op)
    NFpCast op fw tw a -> not (same op "bitcast")
    other -> False

  nat-u64 :: Nat -> U64
  nat-u64 n = if n <= 9223372036854775807 then wrapping-i64-to-u64 (nat-to-i64 n) else 0

  nat-u32 :: Nat -> U32
  nat-u32 n = if n <= 9223372036854775807 then wrapping-i64-to-u32 (nat-to-i64 n) else 0

  u64-mask :: Nat -> U64
  u64-mask w =
    if w >= 64 then 18446744073709551615
    else if w == 0 then 0
    else wrapping-sub-u64 (wrapping-shl-u64 1 (nat-u32 w)) 1

  u128-mask :: Nat -> (U64, U64)
  u128-mask w =
    if w == 0 then (0, 0)
    else if w <= 64 then (u64-mask w, 0)
    else if w >= 128 then (18446744073709551615, 18446744073709551615)
    else (18446744073709551615, u64-mask (saturating-sub w 64))

  u128-sign-bit :: Nat -> (U64, U64)
  u128-sign-bit w =
    if w == 0 then (0, 0)
    else if w <= 64 then (u64-sign-bit w, 0)
    else (0, u64-sign-bit (saturating-sub w 64))

  u128-add :: (U64, U64) -> (U64, U64) -> (U64, U64)
  u128-add a b = case (a, b) of
    ((lo1, hi1), (lo2, hi2)) ->
      let lo = wrapping-add-u64 lo1 lo2 in
      let carry = if lt-u64 lo lo1 then (1 :: U64) else (0 :: U64) in
      let hi = wrapping-add-u64 (wrapping-add-u64 hi1 hi2) carry in
      (lo, hi)

  u128-neg :: (U64, U64) -> (U64, U64)
  u128-neg a = case a of
    (lo, hi) ->
      let nlo = bit-xor-u64 lo 18446744073709551615 in
      let nhi = bit-xor-u64 hi 18446744073709551615 in
      u128-add (nlo, nhi) (1, 0)

  u128-mul10 :: (U64, U64) -> (U64, U64)
  u128-mul10 x =
    let x2 = u128-add x x in
    let x4 = u128-add x2 x2 in
    let x8 = u128-add x4 x4 in
    u128-add x8 x2

  parse-u128-digits :: List Char -> (U64, U64) -> Option (U64, U64)
  parse-u128-digits cs acc = case cs of
    Nil -> Some acc
    Cons c rest ->
      if is-ascii-digit c then
        let d = nat-u64 (saturating-sub (char-code c) 48) in
        parse-u128-digits rest (u128-add (u128-mul10 acc) (d, 0))
      else None

  parse-ir-u128 :: String -> Option (U64, U64)
  parse-ir-u128 tok =
    if string-starts-with "-" tok then
      case unpack (string-slice tok 1 (string-length tok)) of
        Nil -> None
        digits -> case parse-u128-digits digits (0, 0) of
          Some mag -> Some (u128-neg mag)
          None -> None
    else case unpack tok of
      Nil -> None
      digits -> parse-u128-digits digits (0, 0)

  g-intern :: SemNode -> SemGraph -> (Nat, SemGraph)
  g-intern node g = case g of
    MkSemGraph cnt nodes cache fp fpa ->
      let key = node-key node in
      case lookup-str-nat key cache of
        Some existing -> (existing, g)
        None ->
          let id = cnt in
          let next-fp = fp || node-is-fp node in
          let next-fpa = fpa || node-is-fp-arith node in
          (id, MkSemGraph (cnt + 1) (nm-insert id node nodes) (Cons (key, id) cache) next-fp next-fpa)

  g-bool :: Bool -> SemGraph -> (Nat, SemGraph)
  g-bool b g = g-intern (NBoolConst b) g

  g-bv-pair :: Nat -> U64 -> U64 -> SemGraph -> (Nat, SemGraph)
  g-bv-pair w lo hi g = case u128-mask w of
    (mlo, mhi) -> g-intern (NBvConst w (bit-and-u64 lo mlo) (bit-and-u64 hi mhi)) g

  g-bv :: Nat -> U64 -> SemGraph -> (Nat, SemGraph)
  g-bv w v g = g-bv-pair w v 0 g

  g-bv-smin :: Nat -> SemGraph -> (Nat, SemGraph)
  g-bv-smin w g = case u128-sign-bit w of (lo, hi) -> g-bv-pair w lo hi g

  g-bv-mask :: Nat -> SemGraph -> (Nat, SemGraph)
  g-bv-mask w g = case u128-mask w of (lo, hi) -> g-bv-pair w lo hi g

  g-bv-extract :: Nat -> Nat -> Nat -> SemGraph -> (Nat, SemGraph)
  g-bv-extract hi lo a g = g-intern (NBvExtract hi lo a) g

  g-bv-concat :: Nat -> Nat -> SemGraph -> (Nat, SemGraph)
  g-bv-concat hi lo g = g-intern (NBvConcat hi lo) g

  g-var :: Nat -> SemType -> String -> SemGraph -> (Nat, SemGraph)
  g-var idx ty nm g = g-intern (NVar idx ty nm) g

  g-not :: Nat -> SemGraph -> (Nat, SemGraph)
  g-not a g = case graph-node a g of
    Some (NBoolConst b) -> g-bool (not b) g
    Some (NNot x) -> (x, g)
    other -> g-intern (NNot a) g

  g-and :: Nat -> Nat -> SemGraph -> (Nat, SemGraph)
  g-and a b g =
    if a == b then (a, g)
    else case (graph-node a g, graph-node b g) of
      (Some (NBoolConst False), other) -> (a, g)
      (other, Some (NBoolConst False)) -> (b, g)
      (Some (NBoolConst True), other) -> (b, g)
      (other, Some (NBoolConst True)) -> (a, g)
      other -> g-intern (NAnd a b) g

  g-or :: Nat -> Nat -> SemGraph -> (Nat, SemGraph)
  g-or a b g =
    if a == b then (a, g)
    else case (graph-node a g, graph-node b g) of
      (Some (NBoolConst True), other) -> (a, g)
      (other, Some (NBoolConst True)) -> (b, g)
      (Some (NBoolConst False), other) -> (b, g)
      (other, Some (NBoolConst False)) -> (a, g)
      other -> g-intern (NOr a b) g

  g-implies :: Nat -> Nat -> SemGraph -> (Nat, SemGraph)
  g-implies a b g = case (graph-node a g, graph-node b g) of
    (Some (NBoolConst False), other) -> g-bool True g
    (Some (NBoolConst True), other) -> (b, g)
    (other, Some (NBoolConst True)) -> g-bool True g
    other -> g-intern (NImplies a b) g

  g-ite :: Nat -> Nat -> Nat -> SemGraph -> (Nat, SemGraph)
  g-ite c t e g =
    if t == e then (t, g)
    else case graph-node c g of
      Some (NBoolConst True) -> (t, g)
      Some (NBoolConst False) -> (e, g)
      other -> g-intern (NIte c t e) g

  g-bv-bin :: String -> Nat -> Nat -> Nat -> SemGraph -> (Nat, SemGraph)
  g-bv-bin op w a b g = g-intern (NBvBin op w a b) g

  g-bv-cmp :: String -> Nat -> Nat -> Nat -> SemGraph -> (Nat, SemGraph)
  g-bv-cmp pred w a b g =
    if a == b && (same pred "eq" || same pred "ule" || same pred "uge" || same pred "sle" || same pred "sge") then g-bool True g
    else if a == b && (same pred "ne" || same pred "ult" || same pred "ugt" || same pred "slt" || same pred "sgt") then g-bool False g
    else g-intern (NBvCmp pred w a b) g

  g-bv-cast :: String -> Nat -> Nat -> Nat -> SemGraph -> (Nat, SemGraph)
  g-bv-cast op fw tw a g =
    if fw == tw then (a, g)
    else g-intern (NBvCast op fw tw a) g

  -- Canonical serialization of a goal node for content-addressed goal_hash.
  serialize-sem :: Nat -> SemGraph -> String
  serialize-sem id g = case graph-node id g of
    None -> "?"
    Some n -> case n of
      NBoolConst b -> if b then "true" else "false"
      NBvConst w lo hi -> string-concat-all ["bv", nat-to-string w, ":", u64-decimal hi, ":", u64-decimal lo]
      NVar i ty nm -> string-concat-all ["v", nat-to-string i, ":", sem-type-key ty]
      NNot a -> string-concat-all ["(not ", serialize-sem a g, ")"]
      NAnd a b -> string-concat-all ["(and ", serialize-sem a g, " ", serialize-sem b g, ")"]
      NOr a b -> string-concat-all ["(or ", serialize-sem a g, " ", serialize-sem b g, ")"]
      NXor a b -> string-concat-all ["(xor ", serialize-sem a g, " ", serialize-sem b g, ")"]
      NImplies a b -> string-concat-all ["(=> ", serialize-sem a g, " ", serialize-sem b g, ")"]
      NEqBool a b -> string-concat-all ["(= ", serialize-sem a g, " ", serialize-sem b g, ")"]
      NIte c t e -> string-concat-all ["(ite ", serialize-sem c g, " ", serialize-sem t g, " ", serialize-sem e g, ")"]
      NBvUn op w a -> string-concat-all ["(", op, ".", nat-to-string w, " ", serialize-sem a g, ")"]
      NBvBin op w a b -> string-concat-all ["(", op, ".", nat-to-string w, " ", serialize-sem a g, " ", serialize-sem b g, ")"]
      NBvCmp op w a b -> string-concat-all ["(", op, ".", nat-to-string w, " ", serialize-sem a g, " ", serialize-sem b g, ")"]
      NBvCast op fw tw a -> string-concat-all ["(", op, ".", nat-to-string fw, ".", nat-to-string tw, " ", serialize-sem a g, ")"]
      NBvExtract hi lo a -> string-concat-all ["(extract.", nat-to-string hi, ".", nat-to-string lo, " ", serialize-sem a g, ")"]
      NBvConcat hi lo -> string-concat-all ["(concat ", serialize-sem hi g, " ", serialize-sem lo g, ")"]
      NBvTri op w a b c -> string-concat-all ["(", op, ".", nat-to-string w, " ", serialize-sem a g, " ", serialize-sem b g, " ", serialize-sem c g, ")"]
      NFpUn op w a -> string-concat-all ["(fp.", op, ".", nat-to-string w, " ", serialize-sem a g, ")"]
      NFpBin op w a b -> string-concat-all ["(fp.", op, ".", nat-to-string w, " ", serialize-sem a g, " ", serialize-sem b g, ")"]
      NFpCmp op w a b -> string-concat-all ["(fpcmp.", op, ".", nat-to-string w, " ", serialize-sem a g, " ", serialize-sem b g, ")"]
      NFpCast op fw tw a -> string-concat-all ["(fpcast.", op, ".", nat-to-string fw, ".", nat-to-string tw, " ", serialize-sem a g, ")"]
      NFpPred op w a -> string-concat-all ["(fppred.", op, ".", nat-to-string w, " ", serialize-sem a g, ")"]

  -- ==========================================================================
  -- 4. Versioned LLVM IR Semantics (`llvm-sem@21.1`)
  -- ==========================================================================

  semantics-id-llvm :: String
  semantics-id-llvm = "llvm-sem@21.1"

  data SemVal where
    MkSemVal :: Nat -> Nat -> SemType -> SemVal
    MkSemPair :: SemVal -> SemVal -> SemVal
    MkSemVec :: List (Nat, Nat) -> Nat -> SemVal

  sv-val :: SemVal -> Nat
  sv-val v = case v of
    MkSemVal val p ty -> val
    MkSemPair a b -> sv-val a
    MkSemVec lanes ew -> case lanes of Cons (lv, lp) rest -> lv; Nil -> 0

  sv-poison :: SemVal -> Nat
  sv-poison v = case v of
    MkSemVal val p ty -> p
    MkSemPair a b -> sv-poison a
    MkSemVec lanes ew -> case lanes of Cons (lv, lp) rest -> lp; Nil -> 0

  sv-type :: SemVal -> SemType
  sv-type v = case v of
    MkSemVal val p ty -> ty
    MkSemPair a b -> sv-type a
    MkSemVec lanes ew -> SVec (list-len-lanes lanes) ew

  list-len-lanes :: List (Nat, Nat) -> Nat
  list-len-lanes xs = case xs of
    Nil -> 0
    Cons h t -> 1 + list-len-lanes t

  data LlvmEnv where
    MkLlvmEnv :: List (String, SemVal) -> Nat -> SemGraph -> Option SemVal -> LlvmEnv

  env-lookup :: String -> List (String, SemVal) -> Option SemVal
  env-lookup nm binds = case binds of
    Nil -> None
    Cons (k, v) rest -> if same nm k then Some v else env-lookup nm rest

  strip-ir-comment :: String -> String
  strip-ir-comment line = case string-split-on ";" line of
    Nil -> ""
    Cons code rest -> string-strip code

  -- Compact `<16 x i8>` -> `<16_x_i8>` and `<i32 0, i32 1>` -> `<i32_0,_i32_1>`
  -- so vector types and constant masks tokenize cleanly as single words.
  compact-angle-chars :: Bool -> List Char -> List Char
  compact-angle-chars inside cs = case cs of
    Nil -> Nil
    Cons c rest ->
      let code = char-code c in
      if code == 60 then Cons c (compact-angle-chars True rest)
      else if code == 62 then Cons c (compact-angle-chars False rest)
      else if inside && (code == 32 || code == 9) then Cons '_' (compact-angle-chars True rest)
      else if inside && code == 44 then Cons '~' (compact-angle-chars True rest)
      else Cons c (compact-angle-chars inside rest)

  tokenize-ir-chars :: List Char -> List Char
  tokenize-ir-chars cs = case cs of
    Nil -> Nil
    Cons c rest ->
      let code = char-code c in
      if code == 44 || code == 40 || code == 41 || code == 123 || code == 125 || code == 91 || code == 93 then
        Cons ' ' (tokenize-ir-chars rest)
      else if code == 61 then
        Cons ' ' (Cons '=' (Cons ' ' (tokenize-ir-chars rest)))
      else Cons c (tokenize-ir-chars rest)

  ir-words :: String -> List String
  ir-words line = string-words (pack (tokenize-ir-chars (compact-angle-chars False (unpack (strip-ir-comment line)))))

  parse-u64-digits :: List Char -> U64 -> Option U64
  parse-u64-digits cs acc = case cs of
    Nil -> Some acc
    Cons c rest ->
      if is-ascii-digit c then
        let d = nat-u64 (saturating-sub (char-code c) 48) in
        parse-u64-digits rest (wrapping-add-u64 (wrapping-mul-u64 acc 10) d)
      else None

  parse-ir-u64 :: String -> Option U64
  parse-ir-u64 tok =
    if string-starts-with "-" tok then
      case unpack (string-slice tok 1 (string-length tok)) of
        Nil -> None
        digits -> case parse-u64-digits digits 0 of
          Some mag -> Some (wrapping-sub-u64 0 mag)
          None -> None
    else case unpack tok of
      Nil -> None
      digits -> parse-u64-digits digits 0

  parse-llvm-type :: String -> Option SemType
  parse-llvm-type s =
    if same s "i1" then Some SBool
    else if same s "float" then Some (SFp 32)
    else if same s "double" then Some (SFp 64)
    else if string-starts-with "<" s && string-ends-with ">" s && string-length s > 4 then
      let inner = string-slice s 1 (saturating-sub (string-length s) 1) in
      case string-split-on "_x_" inner of
        Cons cnt-str (Cons elem-str Nil) ->
          (case (parse-nat-str cnt-str, parse-llvm-type elem-str) of
            (Some n, Some SBool) | n >= 1 && n <= 64 -> Some (SVec n 1)
            (Some n, Some (SBv ew)) | n >= 1 && n <= 64 -> Some (SVec n ew)
            other -> None)
        other -> None
    else if string-starts-with "i" s && string-length s > 1 then
      case parse-nat-str (string-slice s 1 (string-length s)) of
        Some w | w >= 1 && w <= 128 -> Some (SBv w)
        other -> None
    else None

  parse-nat-str :: String -> Option Nat
  parse-nat-str s = case unpack s of
    Nil -> None
    cs -> parse-nat-digits cs 0

  parse-nat-digits :: List Char -> Nat -> Option Nat
  parse-nat-digits cs acc = case cs of
    Nil -> Some acc
    Cons c rest ->
      if is-ascii-digit c then parse-nat-digits rest (acc * 10 + saturating-sub (char-code c) 48)
      else None

  repeat-lane :: Nat -> (Nat, Nat) -> List (Nat, Nat)
  repeat-lane n lp = if n == 0 then Nil else Cons lp (repeat-lane (saturating-sub n 1) lp)

  resolve-operand :: String -> SemType -> LlvmEnv -> Result String (SemVal, SemGraph)
  resolve-operand tok ty env = case env of
    MkLlvmEnv binds ub g ret ->
      if same tok "true" then
        let (v, g1) = g-bool True g in
        let (p, g2) = g-bool False g1 in
        Ok (MkSemVal v p SBool, g2)
      else if same tok "false" then
        let (v, g1) = g-bool False g in
        let (p, g2) = g-bool False g1 in
        Ok (MkSemVal v p SBool, g2)
      else if same tok "poison" || same tok "undef" then
        let (p, g1) = g-bool True g in
        (case ty of
          SBool -> let (v, g2) = g-bool False g1 in Ok (MkSemVal v p SBool, g2)
          SBv w -> let (v, g2) = g-bv w 0 g1 in Ok (MkSemVal v p (SBv w), g2)
          SFp w -> let (v, g2) = g-bv w 0 g1 in Ok (MkSemVal v p (SFp w), g2)
          SVec n ew ->
            let (zv, g2) = if ew == 1 then g-bool False g1 else g-bv ew 0 g1 in
            Ok (MkSemVec (repeat-lane n (zv, p)) ew, g2))
      else if same tok "zeroinitializer" then
        let (p, g1) = g-bool False g in
        (case ty of
          SBool -> let (v, g2) = g-bool False g1 in Ok (MkSemVal v p SBool, g2)
          SBv w -> let (v, g2) = g-bv w 0 g1 in Ok (MkSemVal v p (SBv w), g2)
          SFp w -> let (v, g2) = g-bv w 0 g1 in Ok (MkSemVal v p (SFp w), g2)
          SVec n ew ->
            let (zv, g2) = if ew == 1 then g-bool False g1 else g-bv ew 0 g1 in
            Ok (MkSemVec (repeat-lane n (zv, p)) ew, g2))
      else if string-starts-with "%" tok then
        case env-lookup tok binds of
          Some sv -> Ok (sv, g)
          None -> Err (string-concat "unresolved LLVM operand " tok)
      else case (ty, parse-ir-u128 tok) of
        (SFp w, _) ->
          case parse-llvm-fp-const w tok of
            Some (lo, hi) ->
              let (p, g1) = g-bool False g in
              let (v, g2) = g-bv-pair w lo hi g1 in
              Ok (MkSemVal v p (SFp w), g2)
            None -> Err (string-concat "unsupported LLVM float operand " tok)
        (_, Some (lo, hi)) ->
          let (p, g1) = g-bool False g in
          (case ty of
            SBool -> let (v, g2) = g-bool (not (eq-u64 lo 0 && eq-u64 hi 0)) g1 in Ok (MkSemVal v p SBool, g2)
            SBv w -> let (v, g2) = g-bv-pair w lo hi g1 in Ok (MkSemVal v p (SBv w), g2)
            SFp w -> let (v, g2) = g-bv-pair w lo hi g1 in Ok (MkSemVal v p (SFp w), g2)
            SVec n ew -> Err (string-concat "scalar constant used as vector operand " tok))
        (_, None) -> Err (string-concat "unsupported LLVM operand " tok)

  hex-nibble-u64 :: Char -> Option U64
  hex-nibble-u64 c =
    let code = char-code c in
    if code >= 48 && code <= 57 then Some (nat-u64 (saturating-sub code 48))
    else if code >= 65 && code <= 70 then Some (nat-u64 (saturating-sub code 55))
    else if code >= 97 && code <= 102 then Some (nat-u64 (saturating-sub code 87))
    else None

  parse-hex-u64-chars :: List Char -> U64 -> Option U64
  parse-hex-u64-chars cs acc = case cs of
    Nil -> Some acc
    Cons c rest -> case hex-nibble-u64 c of
      Some d -> parse-hex-u64-chars rest (wrapping-add-u64 (wrapping-shl-u64 acc 4) d)
      None -> None

  parse-llvm-fp-const :: Nat -> String -> Option (U64, U64)
  parse-llvm-fp-const w tok =
    if string-starts-with "0x" tok && string-length tok > 2 then
      case parse-hex-u64-chars (unpack (string-slice tok 2 (string-length tok))) 0 of
        Some bits64 -> Some (bits64, 0)
        None -> None
    else
      let carrier = UCon (if w == 32 then "F32" else "F64") KType in
      case float-string-bits carrier tok of
        Some bits -> parse-ir-u128 (int-to-string bits)
        None -> None

  strip-ir-flags :: List String -> (Bool, Bool, Bool, List String)
  strip-ir-flags ws = strip-ir-flags-acc False False False ws

  strip-ir-flags-acc :: Bool -> Bool -> Bool -> List String -> (Bool, Bool, Bool, List String)
  strip-ir-flags-acc nsw nuw exact ws = case ws of
    Cons w rest ->
      if same w "nsw" then strip-ir-flags-acc True nuw exact rest
      else if same w "nuw" then strip-ir-flags-acc nsw True exact rest
      else if same w "exact" then strip-ir-flags-acc nsw nuw True rest
      else if has-str w ["disjoint", "nneg", "samesign", "nnan", "ninf", "nsz", "arcp", "contract", "afn", "reassoc", "fast", "tail", "musttail", "notail"] then
        strip-ir-flags-acc nsw nuw exact rest
      else (nsw, nuw, exact, ws)
    Nil -> (nsw, nuw, exact, Nil)

  u64-sign-bit :: Nat -> U64
  u64-sign-bit w =
    if w == 0 then 0
    else wrapping-shl-u64 1 (nat-u32 (saturating-sub w 1))

  -- Overflow condition for add/sub/mul with nsw/nuw flags.
  arith-overflow-poison :: String -> Nat -> Bool -> Bool -> Nat -> Nat -> Nat -> SemGraph -> (Nat, SemGraph)
  arith-overflow-poison op w nsw nuw a b res g =
    let (p0, g0) = g-bool False g in
    let (p1, g1) =
          if nuw then
            (if same op "add" then
              let (ov, ga) = g-bv-cmp "ult" w res a g0 in g-or p0 ov ga
            else if same op "sub" then
              let (ov, ga) = g-bv-cmp "ult" w a b g0 in g-or p0 ov ga
            else if same op "mul" && w <= 64 then
              let w2 = w * 2 in
              let (za, g2) = g-bv-cast "zext" w w2 a g0 in
              let (zb, g3) = g-bv-cast "zext" w w2 b g2 in
              let (prod, g4) = g-bv-bin "mul" w2 za zb g3 in
              let (zres, g5) = g-bv-cast "zext" w w2 res g4 in
              let (ov, g6) = g-bv-cmp "ne" w2 prod zres g5 in g-or p0 ov g6
            else (p0, g0))
          else (p0, g0) in
    if nsw then
      if same op "add" then
        let (zero, g2) = g-bv w 0 g1 in
        let (a-neg, g3) = g-bv-cmp "slt" w a zero g2 in
        let (b-neg, g4) = g-bv-cmp "slt" w b zero g3 in
        let (r-neg, g5) = g-bv-cmp "slt" w res zero g4 in
        let (same-in, g6) = g-intern (NEqBool a-neg b-neg) g5 in
        let (diff-out, g7) = g-intern (NXor a-neg r-neg) g6 in
        let (ov, g8) = g-and same-in diff-out g7 in
        g-or p1 ov g8
      else if same op "sub" then
        let (zero, g2) = g-bv w 0 g1 in
        let (a-neg, g3) = g-bv-cmp "slt" w a zero g2 in
        let (b-neg, g4) = g-bv-cmp "slt" w b zero g3 in
        let (r-neg, g5) = g-bv-cmp "slt" w res zero g4 in
        let (diff-in, g6) = g-intern (NXor a-neg b-neg) g5 in
        let (diff-out, g7) = g-intern (NXor a-neg r-neg) g6 in
        let (ov, g8) = g-and diff-in diff-out g7 in
        g-or p1 ov g8
      else if same op "mul" && w <= 64 then
        let w2 = w * 2 in
        let (sa, g2) = g-bv-cast "sext" w w2 a g1 in
        let (sb, g3) = g-bv-cast "sext" w w2 b g2 in
        let (prod, g4) = g-bv-bin "mul" w2 sa sb g3 in
        let (sres, g5) = g-bv-cast "sext" w w2 res g4 in
        let (ov, g6) = g-bv-cmp "ne" w2 prod sres g5 in
        g-or p1 ov g6
      else (p1, g1)
    else (p1, g1)

  lower-binop :: String -> String -> List String -> LlvmEnv -> Result String LlvmEnv
  lower-binop lhs op args env =
    let (nsw, nuw, exact, rest) = strip-ir-flags args in
    case rest of
      Cons ty-tok (Cons a-tok (Cons b-tok Nil)) ->
        case parse-llvm-type ty-tok of
          None -> Err (string-concat "unsupported LLVM type " ty-tok)
          Some ty ->
            case resolve-operand a-tok ty env of
              Err e -> Err e
              Ok (va, g1) ->
                case env of
                  MkLlvmEnv binds ub g0 ret ->
                    case resolve-operand b-tok ty (MkLlvmEnv binds ub g1 ret) of
                      Err e -> Err e
                      Ok (vb, g2) ->
                        let (base-p, g3) = g-or (sv-poison va) (sv-poison vb) g2 in
                        (case ty of
                          SBv w ->
                            if has-str op ["add", "sub", "mul"] then
                              let (res, g4) = g-bv-bin op w (sv-val va) (sv-val vb) g3 in
                              let (ov-p, g5) = arith-overflow-poison op w nsw nuw (sv-val va) (sv-val vb) res g4 in
                              let (p, g6) = g-or base-p ov-p g5 in
                              Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p ty) binds) ub g6 ret)
                            else if has-str op ["and", "or", "xor"] then
                              let (res, g4) = g-bv-bin op w (sv-val va) (sv-val vb) g3 in
                              Ok (MkLlvmEnv (Cons (lhs, MkSemVal res base-p ty) binds) ub g4 ret)
                            else if has-str op ["shl", "lshr", "ashr"] then
                              let (res, g4) = g-bv-bin op w (sv-val va) (sv-val vb) g3 in
                              let (w-const, g5) = g-bv w (nat-u64 w) g4 in
                              let (oob, g6) = g-bv-cmp "uge" w (sv-val vb) w-const g5 in
                              let (p, g7) = g-or base-p oob g6 in
                              Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p ty) binds) ub g7 ret)
                            else if has-str op ["udiv", "urem"] then
                              let (zero, g4) = g-bv w 0 g3 in
                              let (div0, g5) = g-bv-cmp "eq" w (sv-val vb) zero g4 in
                              let (ub1, g6) = g-or ub div0 g5 in
                              let (ub2, g7) = g-or ub1 (sv-poison vb) g6 in
                              let (res, g8) = g-bv-bin op w (sv-val va) (sv-val vb) g7 in
                              Ok (MkLlvmEnv (Cons (lhs, MkSemVal res base-p ty) binds) ub2 g8 ret)
                            else if has-str op ["sdiv", "srem"] then
                              let (zero, g4) = g-bv w 0 g3 in
                              let (div0, g5) = g-bv-cmp "eq" w (sv-val vb) zero g4 in
                              let (smin, g6) = g-bv-smin w g5 in
                              let (neg1, g7) = g-bv-mask w g6 in
                              let (is-min, g8) = g-bv-cmp "eq" w (sv-val va) smin g7 in
                              let (is-m1, g9) = g-bv-cmp "eq" w (sv-val vb) neg1 g8 in
                              let (ov-ub, g10) = g-and is-min is-m1 g9 in
                              let (ub1, g11) = g-or ub div0 g10 in
                              let (ub2, g12) = g-or ub1 ov-ub g11 in
                              let (ub3, g13) = g-or ub2 (sv-poison vb) g12 in
                              let (res, g14) = g-bv-bin op w (sv-val va) (sv-val vb) g13 in
                              Ok (MkLlvmEnv (Cons (lhs, MkSemVal res base-p ty) binds) ub3 g14 ret)
                            else Err (string-concat "unsupported LLVM binop " op)
                          SVec count ew ->
                            case (va, vb) of
                              (MkSemVec la ewa, MkSemVec lb ewb) ->
                                (case lower-vec-binop-lanes op ew nsw nuw la lb g2 of
                                  Err e -> Err e
                                  Ok (out-lanes, g3) ->
                                    Ok (MkLlvmEnv (Cons (lhs, MkSemVec out-lanes ew) binds) ub g3 ret))
                              other -> Err (string-concat "non-vector operand to vector binop " op)
                          SBool ->
                            if same op "and" then
                              let (res, g4) = g-and (sv-val va) (sv-val vb) g3 in
                              Ok (MkLlvmEnv (Cons (lhs, MkSemVal res base-p SBool) binds) ub g4 ret)
                            else if same op "or" then
                              let (res, g4) = g-or (sv-val va) (sv-val vb) g3 in
                              Ok (MkLlvmEnv (Cons (lhs, MkSemVal res base-p SBool) binds) ub g4 ret)
                            else if same op "xor" then
                              let (res, g4) = g-intern (NXor (sv-val va) (sv-val vb)) g3 in
                              Ok (MkLlvmEnv (Cons (lhs, MkSemVal res base-p SBool) binds) ub g4 ret)
                            else Err (string-concat "unsupported i1 binop " op)
                          SFp w ->
                            let (res, g4) = g-intern (NFpBin op w (sv-val va) (sv-val vb)) g3 in
                            Ok (MkLlvmEnv (Cons (lhs, MkSemVal res base-p ty) binds) ub g4 ret))
      other -> Err (string-concat "malformed LLVM binop " op)

  lower-vec-binop-lanes :: String -> Nat -> Bool -> Bool -> List (Nat, Nat) -> List (Nat, Nat) -> SemGraph -> Result String (List (Nat, Nat), SemGraph)
  lower-vec-binop-lanes op ew nsw nuw la lb g = case (la, lb) of
    (Nil, Nil) -> Ok (Nil, g)
    (Cons (va, pa) ra, Cons (vb, pb) rb) ->
      let (base-p, g1) = g-or pa pb g in
      if has-str op ["add", "sub", "mul"] then
        let (res, g2) = g-bv-bin op ew va vb g1 in
        let (ov-p, g3) = arith-overflow-poison op ew nsw nuw va vb res g2 in
        let (p, g4) = g-or base-p ov-p g3 in
        (case lower-vec-binop-lanes op ew nsw nuw ra rb g4 of
          Err e -> Err e
          Ok (rest, g5) -> Ok (Cons (res, p) rest, g5))
      else if has-str op ["and", "or", "xor"] then
        let (res, g2) = g-bv-bin op ew va vb g1 in
        (case lower-vec-binop-lanes op ew nsw nuw ra rb g2 of
          Err e -> Err e
          Ok (rest, g3) -> Ok (Cons (res, base-p) rest, g3))
      else if has-str op ["shl", "lshr", "ashr"] then
        let (res, g2) = g-bv-bin op ew va vb g1 in
        let (w-const, g3) = g-bv ew (nat-u64 ew) g2 in
        let (oob, g4) = g-bv-cmp "uge" ew vb w-const g3 in
        let (p, g5) = g-or base-p oob g4 in
        (case lower-vec-binop-lanes op ew nsw nuw ra rb g5 of
          Err e -> Err e
          Ok (rest, g6) -> Ok (Cons (res, p) rest, g6))
      else Err (string-concat "unsupported vector binop " op)
    other -> Err "mismatched vector lane counts in binop"

  slice-bv-to-lanes :: Nat -> Nat -> Nat -> Nat -> Nat -> SemGraph -> (List (Nat, Nat), SemGraph)
  slice-bv-to-lanes v p count ew idx g =
    if idx >= count then (Nil, g)
    else
      let lo = idx * ew in
      let hi = saturating-sub (lo + ew) 1 in
      let (lane-raw, g1) = g-bv-extract hi lo v g in
      let (lane-val, g2) =
            if ew == 1 then
              let (z, ga) = g-bv 1 0 g1 in g-bv-cmp "ne" 1 lane-raw z ga
            else (lane-raw, g1) in
      case slice-bv-to-lanes v p count ew (idx + 1) g2 of
        (rest, g3) -> (Cons (lane-val, p) rest, g3)

  pack-lanes-to-bv :: List (Nat, Nat) -> Nat -> SemGraph -> Result String (Nat, Nat, SemGraph)
  pack-lanes-to-bv lanes ew g = case lanes of
    Nil -> Err "empty vector in bitcast"
    Cons (lv, lp) Nil ->
      if ew == 1 then
        let (one, g1) = g-bv 1 1 g in
        let (zero, g2) = g-bv 1 0 g1 in
        let (b, g3) = g-ite lv one zero g2 in
        Ok (b, lp, g3)
      else Ok (lv, lp, g)
    Cons (lv, lp) rest ->
      case pack-lanes-to-bv rest ew g of
        Err e -> Err e
        Ok (hi-v, hi-p, g1) ->
          let (lo-v, g2) =
                if ew == 1 then
                  let (one, ga) = g-bv 1 1 g1 in
                  let (zero, gb) = g-bv 1 0 ga in
                  g-ite lv one zero gb
                else (lv, g1) in
          let (cat-v, g3) = g-bv-concat hi-v lo-v g2 in
          let (cat-p, g4) = g-or lp hi-p g3 in
          Ok (cat-v, cat-p, g4)

  cast-vec-lanes :: String -> Nat -> Nat -> List (Nat, Nat) -> SemGraph -> (List (Nat, Nat), SemGraph)
  cast-vec-lanes op fw tw lanes g = case lanes of
    Nil -> (Nil, g)
    Cons (lv, lp) rest ->
      let (cv, g1) =
            if fw == 1 && tw > 1 then
              let (one, ga) = if same op "sext" then g-bv-mask tw g else g-bv tw 1 g in
              let (zero, gb) = g-bv tw 0 ga in
              g-ite lv one zero gb
            else if fw > 1 && tw == 1 then
              let (one, ga) = g-bv fw 1 g in
              let (m, gb) = g-bv-bin "and" fw lv one ga in
              g-bv-cmp "eq" fw m one gb
            else g-bv-cast op fw tw lv g in
      case cast-vec-lanes op fw tw rest g1 of
        (more, g2) -> (Cons (cv, lp) more, g2)

  icmp-vec-lanes :: String -> Nat -> List (Nat, Nat) -> List (Nat, Nat) -> SemGraph -> Result String (List (Nat, Nat), SemGraph)
  icmp-vec-lanes pred ew la lb g = case (la, lb) of
    (Nil, Nil) -> Ok (Nil, g)
    (Cons (va, pa) ra, Cons (vb, pb) rb) ->
      let (p, g1) = g-or pa pb g in
      let (c, g2) =
            if ew == 1 then
              if same pred "eq" then g-intern (NEqBool va vb) g1 else g-intern (NXor va vb) g1
            else g-bv-cmp pred ew va vb g1 in
      (case icmp-vec-lanes pred ew ra rb g2 of
        Err e -> Err e
        Ok (rest, g3) -> Ok (Cons (c, p) rest, g3))
    other -> Err "mismatched vector lane counts in icmp"

  set-lane-at :: Nat -> (Nat, Nat) -> List (Nat, Nat) -> Result String (List (Nat, Nat))
  set-lane-at idx new-lane lanes = case lanes of
    Nil -> Err "insertelement lane index out of range"
    Cons h t ->
      if idx == 0 then Ok (Cons new-lane t)
      else case set-lane-at (saturating-sub idx 1) new-lane t of
        Err e -> Err e
        Ok rest -> Ok (Cons h rest)

  get-lane-at :: Nat -> List (Nat, Nat) -> Option (Nat, Nat)
  get-lane-at idx lanes = case lanes of
    Nil -> None
    Cons h t -> if idx == 0 then Some h else get-lane-at (saturating-sub idx 1) t

  parse-shuffle-mask :: String -> Nat -> Option (List Nat)
  parse-shuffle-mask tok count =
    if same tok "zeroinitializer" then Some (repeat-nat count 0)
    else if string-starts-with "<" tok && string-ends-with ">" tok && string-length tok > 2 then
      let inner = string-slice tok 1 (saturating-sub (string-length tok) 1) in
      parse-shuffle-items (string-split-on "~" inner)
    else None

  repeat-nat :: Nat -> Nat -> List Nat
  repeat-nat n x = if n == 0 then Nil else Cons x (repeat-nat (saturating-sub n 1) x)

  parse-shuffle-items :: List String -> Option (List Nat)
  parse-shuffle-items items = case items of
    Nil -> Some Nil
    Cons raw rest ->
      let parts = string-split-on "_" raw in
      case last-nonempty parts of
        Some num-str ->
          (case parse-nat-str num-str of
            Some idx -> (case parse-shuffle-items rest of Some more -> Some (Cons idx more); None -> None)
            None -> None)
        None -> None

  last-nonempty :: List String -> Option String
  last-nonempty xs = case xs of
    Nil -> None
    Cons h t -> case last-nonempty t of
      Some found -> Some found
      None -> if string-length h > 0 then Some h else None

  gather-shuffle-lanes :: List Nat -> List (Nat, Nat) -> Result String (List (Nat, Nat))
  gather-shuffle-lanes idxs pool = case idxs of
    Nil -> Ok Nil
    Cons i rest -> case get-lane-at i pool of
      None -> Err "shufflevector index out of bounds"
      Some lp -> case gather-shuffle-lanes rest pool of
        Err e -> Err e
        Ok more -> Ok (Cons lp more)

  lower-cast :: String -> String -> List String -> LlvmEnv -> Result String LlvmEnv
  lower-cast lhs op args env =
    let (nsw, nuw, exact, rest) = strip-ir-flags args in
    case rest of
      Cons src-ty-tok (Cons val-tok (Cons to-kw (Cons dst-ty-tok Nil))) | same to-kw "to" ->
        case (parse-llvm-type src-ty-tok, parse-llvm-type dst-ty-tok) of
          (Some src-ty, Some dst-ty) ->
            case resolve-operand val-tok src-ty env of
              Err e -> Err e
              Ok (v, g1) ->
                case env of
                  MkLlvmEnv binds ub g0 ret ->
                    let p = sv-poison v in
                    (case (src-ty, dst-ty) of
                      (SBool, SBv tw) ->
                        let (one, g2) = if same op "sext" then g-bv-mask tw g1 else g-bv tw 1 g1 in
                        let (zero, g3) = g-bv tw 0 g2 in
                        let (res, g4) = g-ite (sv-val v) one zero g3 in
                        Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p dst-ty) binds) ub g4 ret)
                      (SBv fw, SBool) ->
                        let (one, g2) = g-bv fw 1 g1 in
                        let (masked, g3) = g-bv-bin "and" fw (sv-val v) one g2 in
                        let (res, g4) = g-bv-cmp "eq" fw masked one g3 in
                        Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p SBool) binds) ub g4 ret)
                      (SBv fw, SBv tw) ->
                        let (res, g2) = g-bv-cast op fw tw (sv-val v) g1 in
                        Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p dst-ty) binds) ub g2 ret)
                      (SBv fw, SVec count ew) | same op "bitcast" && count * ew == fw ->
                        let (lanes, g2) = slice-bv-to-lanes (sv-val v) p count ew 0 g1 in
                        Ok (MkLlvmEnv (Cons (lhs, MkSemVec lanes ew) binds) ub g2 ret)
                      (SVec count ew, SBv tw) | same op "bitcast" && count * ew == tw ->
                        (case v of
                          MkSemVec lanes vew ->
                            (case pack-lanes-to-bv lanes ew g1 of
                              Err e -> Err e
                              Ok (bv-v, bv-p, g2) ->
                                Ok (MkLlvmEnv (Cons (lhs, MkSemVal bv-v bv-p (SBv tw)) binds) ub g2 ret))
                          other -> Err "bitcast expects vector operand")
                      (SVec c1 ew1, SVec c2 ew2) | c1 == c2 ->
                        (case v of
                          MkSemVec lanes vew ->
                            let (out-lanes, g2) = cast-vec-lanes op ew1 ew2 lanes g1 in
                            Ok (MkLlvmEnv (Cons (lhs, MkSemVec out-lanes ew2) binds) ub g2 ret)
                          other -> Err "vector cast expects vector operand")
                      (other1, other2) ->
                        let (res, g2) = g-intern (NFpCast op (sem-type-width src-ty) (sem-type-width dst-ty) (sv-val v)) g1 in
                        Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p dst-ty) binds) ub g2 ret))
          other -> Err (string-concat "unsupported cast types in " op)
      other -> Err (string-concat "malformed LLVM cast " op)

  lower-icmp :: String -> List String -> LlvmEnv -> Result String LlvmEnv
  lower-icmp lhs args env =
    let (nsw, nuw, exact, rest) = strip-ir-flags args in
    case rest of
      Cons pred (Cons ty-tok (Cons a-tok (Cons b-tok Nil))) ->
        case parse-llvm-type ty-tok of
          None -> Err (string-concat "unsupported icmp type " ty-tok)
          Some ty ->
            case resolve-operand a-tok ty env of
              Err e -> Err e
              Ok (va, g1) ->
                case env of
                  MkLlvmEnv binds ub g0 ret ->
                    case resolve-operand b-tok ty (MkLlvmEnv binds ub g1 ret) of
                      Err e -> Err e
                      Ok (vb, g2) ->
                        let (p, g3) = g-or (sv-poison va) (sv-poison vb) g2 in
                        (case ty of
                          SBv w ->
                            let (res, g4) = g-bv-cmp pred w (sv-val va) (sv-val vb) g3 in
                            Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p SBool) binds) ub g4 ret)
                          SBool ->
                            let (res, g4) = if same pred "eq" then g-intern (NEqBool (sv-val va) (sv-val vb)) g3
                                  else g-intern (NXor (sv-val va) (sv-val vb)) g3 in
                            Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p SBool) binds) ub g4 ret)
                          SVec count ew ->
                            (case (va, vb) of
                              (MkSemVec la ewa, MkSemVec lb ewb) ->
                                (case icmp-vec-lanes pred ew la lb g2 of
                                  Err e -> Err e
                                  Ok (out-lanes, g4) ->
                                    Ok (MkLlvmEnv (Cons (lhs, MkSemVec out-lanes 1) binds) ub g4 ret))
                              other -> Err "non-vector operand to vector icmp")
                          SFp w -> Err "icmp on float")
      other -> Err "malformed LLVM icmp"

  lower-select :: String -> List String -> LlvmEnv -> Result String LlvmEnv
  lower-select lhs args env = case args of
    Cons cty (Cons ctok (Cons tty (Cons ttok (Cons fty (Cons ftok Nil))))) ->
      case parse-llvm-type tty of
        None -> Err (string-concat "unsupported select type " tty)
        Some ty ->
          case resolve-operand ctok SBool env of
            Err e -> Err e
            Ok (vc, g1) ->
              case env of
                MkLlvmEnv binds ub g0 ret ->
                  case resolve-operand ttok ty (MkLlvmEnv binds ub g1 ret) of
                    Err e -> Err e
                    Ok (vt, g2) ->
                      case resolve-operand ftok ty (MkLlvmEnv binds ub g2 ret) of
                        Err e -> Err e
                        Ok (vf, g3) ->
                          let (res, g4) = g-ite (sv-val vc) (sv-val vt) (sv-val vf) g3 in
                          let (branch-p, g5) = g-ite (sv-val vc) (sv-poison vt) (sv-poison vf) g4 in
                          let (p, g6) = g-or (sv-poison vc) branch-p g5 in
                          Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p ty) binds) ub g6 ret)
    other -> Err "malformed LLVM select"

  bin-vec-intrinsic-lanes :: String -> Nat -> List (Nat, Nat) -> List (Nat, Nat) -> SemGraph -> Result String (List (Nat, Nat), SemGraph)
  bin-vec-intrinsic-lanes op ew la lb g = case (la, lb) of
    (Nil, Nil) -> Ok (Nil, g)
    (Cons (va, pa) ra, Cons (vb, pb) rb) ->
      let (p, g1) = g-or pa pb g in
      let (res, g2) = g-bv-bin op ew va vb g1 in
      (case bin-vec-intrinsic-lanes op ew ra rb g2 of
        Err e -> Err e
        Ok (rest, g3) -> Ok (Cons (res, p) rest, g3))
    other -> Err "mismatched vector lane counts in binary intrinsic"

  tri-vec-intrinsic-lanes :: String -> Nat -> List (Nat, Nat) -> List (Nat, Nat) -> List (Nat, Nat) -> SemGraph -> Result String (List (Nat, Nat), SemGraph)
  tri-vec-intrinsic-lanes op ew la lb lc g = case (la, lb, lc) of
    (Nil, Nil, Nil) -> Ok (Nil, g)
    (Cons (va, pa) ra, Cons (vb, pb) rb, Cons (vc, pc) rc) ->
      let (p1, g1) = g-or pa pb g in
      let (p2, g2) = g-or p1 pc g1 in
      let (res, g3) = g-intern (NBvTri op ew va vb vc) g2 in
      (case tri-vec-intrinsic-lanes op ew ra rb rc g3 of
        Err e -> Err e
        Ok (rest, g4) -> Ok (Cons (res, p2) rest, g4))
    other -> Err "mismatched vector lane counts in ternary intrinsic"

  lower-intrinsic-call :: String -> List String -> LlvmEnv -> Result String LlvmEnv
  lower-intrinsic-call lhs args env =
    let (nsw, nuw, exact, rest) = strip-ir-flags args in
    case rest of
      -- Unary intrinsic: call iN @llvm.<op>.iN(iN %a)
      Cons rty-tok (Cons fn-tok (Cons aty-tok (Cons a-tok Nil))) | string-starts-with "@llvm." fn-tok ->
        case parse-llvm-type rty-tok of
          Some (SBv w) ->
            case resolve-operand a-tok (SBv w) env of
              Err e -> Err e
              Ok (va, g1) ->
                case env of
                  MkLlvmEnv binds ub g0 ret ->
                    let op =
                          if string-starts-with "@llvm.bswap." fn-tok then Some "bswap"
                          else if string-starts-with "@llvm.bitreverse." fn-tok then Some "bitreverse"
                          else if string-starts-with "@llvm.ctpop." fn-tok then Some "ctpop"
                          else None in
                    (case op of
                      Some name ->
                        let (res, g2) = g-intern (NBvUn name w (sv-val va)) g1 in
                        Ok (MkLlvmEnv (Cons (lhs, MkSemVal res (sv-poison va) (SBv w)) binds) ub g2 ret)
                      None -> Err (string-concat "unsupported unary intrinsic " fn-tok))
          Some (SFp w) ->
            case resolve-operand a-tok (SFp w) env of
              Err e -> Err e
              Ok (va, g1) ->
                case env of
                  MkLlvmEnv binds ub g0 ret ->
                    let (res, g2) = g-intern (NFpUn fn-tok w (sv-val va)) g1 in
                    Ok (MkLlvmEnv (Cons (lhs, MkSemVal res (sv-poison va) (SFp w)) binds) ub g2 ret)
          other -> Err (string-concat "unsupported intrinsic return type " rty-tok)
      -- Binary intrinsic: call iN @llvm.<op>.iN(iN %a, iN %b) or ctlz/cttz(iN %a, i1 %z)
      Cons rty-tok (Cons fn-tok (Cons aty-tok (Cons a-tok (Cons bty-tok (Cons b-tok Nil))))) | string-starts-with "@llvm." fn-tok ->
        case parse-llvm-type rty-tok of
          Some (SBv w) ->
            if string-starts-with "@llvm.ctlz." fn-tok || string-starts-with "@llvm.cttz." fn-tok then
              case resolve-operand a-tok (SBv w) env of
                Err e -> Err e
                Ok (va, g1) ->
                  case env of
                    MkLlvmEnv binds ub g0 ret ->
                      case resolve-operand b-tok SBool (MkLlvmEnv binds ub g1 ret) of
                        Err e -> Err e
                        Ok (vz, g2) ->
                          let op-name = if string-starts-with "@llvm.ctlz." fn-tok then "ctlz" else "cttz" in
                          let (res, g3) = g-intern (NBvUn op-name w (sv-val va)) g2 in
                          let (zero, g4) = g-bv w 0 g3 in
                          let (is-z, g5) = g-bv-cmp "eq" w (sv-val va) zero g4 in
                          let (z-poison, g6) = g-and (sv-val vz) is-z g5 in
                          let (p, g7) = g-or (sv-poison va) z-poison g6 in
                          Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p (SBv w)) binds) ub g7 ret)
            else
              case resolve-operand a-tok (SBv w) env of
                Err e -> Err e
                Ok (va, g1) ->
                  case env of
                    MkLlvmEnv binds ub g0 ret ->
                      case resolve-operand b-tok (SBv w) (MkLlvmEnv binds ub g1 ret) of
                        Err e -> Err e
                        Ok (vb, g2) ->
                          let (p, g3) = g-or (sv-poison va) (sv-poison vb) g2 in
                          let op =
                                if string-starts-with "@llvm.smin." fn-tok then Some "smin"
                                else if string-starts-with "@llvm.smax." fn-tok then Some "smax"
                                else if string-starts-with "@llvm.umin." fn-tok then Some "umin"
                                else if string-starts-with "@llvm.umax." fn-tok then Some "umax"
                                else if string-starts-with "@llvm.sadd.sat." fn-tok then Some "sadd_sat"
                                else if string-starts-with "@llvm.uadd.sat." fn-tok then Some "uadd_sat"
                                else if string-starts-with "@llvm.ssub.sat." fn-tok then Some "ssub_sat"
                                else if string-starts-with "@llvm.usub.sat." fn-tok then Some "usub_sat"
                                else None in
                          (case op of
                            Some name ->
                              let (res, g4) = g-bv-bin name w (sv-val va) (sv-val vb) g3 in
                              Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p (SBv w)) binds) ub g4 ret)
                            None -> Err (string-concat "unsupported binary intrinsic " fn-tok))
          Some (SVec n ew) ->
            case resolve-operand a-tok (SVec n ew) env of
              Err e -> Err e
              Ok (va, g1) ->
                case env of
                  MkLlvmEnv binds ub g0 ret ->
                    case resolve-operand b-tok (SVec n ew) (MkLlvmEnv binds ub g1 ret) of
                      Err e -> Err e
                      Ok (vb, g2) ->
                        let op =
                              if string-starts-with "@llvm.smin." fn-tok then Some "smin"
                              else if string-starts-with "@llvm.smax." fn-tok then Some "smax"
                              else if string-starts-with "@llvm.umin." fn-tok then Some "umin"
                              else if string-starts-with "@llvm.umax." fn-tok then Some "umax"
                              else if string-starts-with "@llvm.sadd.sat." fn-tok then Some "sadd_sat"
                              else if string-starts-with "@llvm.uadd.sat." fn-tok then Some "uadd_sat"
                              else if string-starts-with "@llvm.ssub.sat." fn-tok then Some "ssub_sat"
                              else if string-starts-with "@llvm.usub.sat." fn-tok then Some "usub_sat"
                              else None in
                        (case (op, va, vb) of
                          (Some name, MkSemVec la _, MkSemVec lb _) ->
                            (case bin-vec-intrinsic-lanes name ew la lb g2 of
                              Err e -> Err e
                              Ok (lanes, g3) -> Ok (MkLlvmEnv (Cons (lhs, MkSemVec lanes ew) binds) ub g3 ret))
                          other -> Err (string-concat "unsupported vector binary intrinsic " fn-tok))
          Some (SFp w) ->
            case resolve-operand a-tok (SFp w) env of
              Err e -> Err e
              Ok (va, g1) ->
                case env of
                  MkLlvmEnv binds ub g0 ret ->
                    case resolve-operand b-tok (SFp w) (MkLlvmEnv binds ub g1 ret) of
                      Err e -> Err e
                      Ok (vb, g2) ->
                        let (p, g3) = g-or (sv-poison va) (sv-poison vb) g2 in
                        let (res, g4) = g-intern (NFpBin fn-tok w (sv-val va) (sv-val vb)) g3 in
                        Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p (SFp w)) binds) ub g4 ret)
          other -> Err (string-concat "unsupported intrinsic " fn-tok)
      -- Overflow intrinsic: call { iN, i1 } @llvm.<op>.with.overflow.iN(iN %a, iN %b)
      Cons ty1 (Cons ty2 (Cons fn-tok (Cons aty-tok (Cons a-tok (Cons bty-tok (Cons b-tok Nil)))))) | same ty2 "i1" && string-starts-with "@llvm." fn-tok ->
        case parse-llvm-type ty1 of
          Some (SBv w) ->
            case resolve-operand a-tok (SBv w) env of
              Err e -> Err e
              Ok (va, g1) ->
                case env of
                  MkLlvmEnv binds ub g0 ret ->
                    case resolve-operand b-tok (SBv w) (MkLlvmEnv binds ub g1 ret) of
                      Err e -> Err e
                      Ok (vb, g2) ->
                        let (p, g3) = g-or (sv-poison va) (sv-poison vb) g2 in
                        let (op-name, is-signed) =
                              if string-starts-with "@llvm.sadd.with.overflow." fn-tok then ("add", True)
                              else if string-starts-with "@llvm.uadd.with.overflow." fn-tok then ("add", False)
                              else if string-starts-with "@llvm.ssub.with.overflow." fn-tok then ("sub", True)
                              else if string-starts-with "@llvm.usub.with.overflow." fn-tok then ("sub", False)
                              else if string-starts-with "@llvm.smul.with.overflow." fn-tok then ("mul", True)
                              else ("mul", False) in
                        let (res, g4) = g-bv-bin op-name w (sv-val va) (sv-val vb) g3 in
                        let (ov, g5) = arith-overflow-poison op-name w is-signed (not is-signed) (sv-val va) (sv-val vb) res g4 in
                        let pair = MkSemPair (MkSemVal res p (SBv w)) (MkSemVal ov p SBool) in
                        Ok (MkLlvmEnv (Cons (lhs, pair) binds) ub g5 ret)
          other -> Err (string-concat "unsupported overflow intrinsic " fn-tok)
      -- Ternary intrinsic: call iN @llvm.fshl/fshr.iN(iN %a, iN %b, iN %c)
      Cons rty-tok (Cons fn-tok (Cons aty (Cons a-tok (Cons bty (Cons b-tok (Cons cty (Cons c-tok Nil))))))) | string-starts-with "@llvm.fsh" fn-tok ->
        case parse-llvm-type rty-tok of
          Some (SBv w) ->
            case resolve-operand a-tok (SBv w) env of
              Err e -> Err e
              Ok (va, g1) ->
                case env of
                  MkLlvmEnv binds ub g0 ret ->
                    case resolve-operand b-tok (SBv w) (MkLlvmEnv binds ub g1 ret) of
                      Err e -> Err e
                      Ok (vb, g2) ->
                        case resolve-operand c-tok (SBv w) (MkLlvmEnv binds ub g2 ret) of
                          Err e -> Err e
                          Ok (vc, g3) ->
                            let (p1, g4) = g-or (sv-poison va) (sv-poison vb) g3 in
                            let (p2, g5) = g-or p1 (sv-poison vc) g4 in
                            let op-name = if string-starts-with "@llvm.fshl." fn-tok then "fshl" else "fshr" in
                            let (res, g6) = g-intern (NBvTri op-name w (sv-val va) (sv-val vb) (sv-val vc)) g5 in
                            Ok (MkLlvmEnv (Cons (lhs, MkSemVal res p2 (SBv w)) binds) ub g6 ret)
          Some (SVec n ew) ->
            case resolve-operand a-tok (SVec n ew) env of
              Err e -> Err e
              Ok (va, g1) ->
                case env of
                  MkLlvmEnv binds ub g0 ret ->
                    case resolve-operand b-tok (SVec n ew) (MkLlvmEnv binds ub g1 ret) of
                      Err e -> Err e
                      Ok (vb, g2) ->
                        case resolve-operand c-tok (SVec n ew) (MkLlvmEnv binds ub g2 ret) of
                          Err e -> Err e
                          Ok (vc, g3) ->
                            let op-name = if string-starts-with "@llvm.fshl." fn-tok then "fshl" else "fshr" in
                            (case (va, vb, vc) of
                              (MkSemVec la _, MkSemVec lb _, MkSemVec lc _) ->
                                (case tri-vec-intrinsic-lanes op-name ew la lb lc g3 of
                                  Err e -> Err e
                                  Ok (lanes, g4) -> Ok (MkLlvmEnv (Cons (lhs, MkSemVec lanes ew) binds) ub g4 ret))
                              other -> Err (string-concat "unsupported vector funnel shift " fn-tok))
          other -> Err (string-concat "unsupported funnel shift " fn-tok)
      other -> Err "unsupported LLVM call"

  lower-ir-line :: List String -> LlvmEnv -> Result String LlvmEnv
  lower-ir-line ws env = case ws of
    Nil -> Ok env
    Cons head (Cons second rest) ->
      if same head "ret" then
        (case rest of
          Cons val-tok Nil ->
            case parse-llvm-type second of
              None -> Err (string-concat "unsupported ret type " second)
              Some ty ->
                case resolve-operand val-tok ty env of
                  Err e -> Err e
                  Ok (v, g1) -> case env of
                    MkLlvmEnv binds ub g0 ret -> Ok (MkLlvmEnv binds ub g1 (Some v))
          other -> Err "malformed LLVM ret")
      else if same second "=" then
        (case rest of
          Cons op op-args ->
            if has-str op ["add", "sub", "mul", "udiv", "sdiv", "urem", "srem", "shl", "lshr", "ashr", "and", "or", "xor", "fadd", "fsub", "fmul", "fdiv", "frem"] then
              lower-binop head op op-args env
            else if has-str op ["zext", "sext", "trunc", "bitcast", "fptrunc", "fpext", "fptoui", "fptosi", "uitofp", "sitofp"] then
              lower-cast head op op-args env
            else if same op "icmp" then
              lower-icmp head op-args env
            else if same op "select" then
              lower-select head op-args env
            else if same op "freeze" then
              (case op-args of
                Cons ty-tok (Cons val-tok Nil) ->
                  (case parse-llvm-type ty-tok of
                    Some ty -> (case resolve-operand val-tok ty env of
                      Err e -> Err e
                      Ok (v, g1) -> case env of
                        MkLlvmEnv binds ub g0 ret ->
                          let (clean-p, g2) = g-bool False g1 in
                          Ok (MkLlvmEnv (Cons (head, MkSemVal (sv-val v) clean-p ty) binds) ub g2 ret))
                    None -> Err (string-concat "unsupported freeze type " ty-tok))
                other -> Err "malformed LLVM freeze")
            else if same op "fneg" then
              (case strip-ir-flags op-args of
                (nsw, nuw, exact, Cons ty-tok (Cons val-tok Nil)) ->
                  (case parse-llvm-type ty-tok of
                    Some (SFp w) -> (case resolve-operand val-tok (SFp w) env of
                      Err e -> Err e
                      Ok (v, g1) -> case env of
                        MkLlvmEnv binds ub g0 ret ->
                          let (res, g2) = g-intern (NFpUn "fneg" w (sv-val v)) g1 in
                          Ok (MkLlvmEnv (Cons (head, MkSemVal res (sv-poison v) (SFp w)) binds) ub g2 ret))
                    other -> Err "unsupported fneg type")
                other -> Err "malformed LLVM fneg")
            else if same op "fcmp" then
              (case strip-ir-flags op-args of
                (nsw, nuw, exact, Cons pred (Cons ty-tok (Cons a-tok (Cons b-tok Nil)))) ->
                  (case parse-llvm-type ty-tok of
                    Some (SFp w) -> (case resolve-operand a-tok (SFp w) env of
                      Err e -> Err e
                      Ok (va, g1) -> case env of
                        MkLlvmEnv binds ub g0 ret ->
                          (case resolve-operand b-tok (SFp w) (MkLlvmEnv binds ub g1 ret) of
                            Err e -> Err e
                            Ok (vb, g2) ->
                              let (p, g3) = g-or (sv-poison va) (sv-poison vb) g2 in
                              let (res, g4) = g-intern (NFpCmp pred w (sv-val va) (sv-val vb)) g3 in
                              Ok (MkLlvmEnv (Cons (head, MkSemVal res p SBool) binds) ub g4 ret)))
                    other -> Err "unsupported fcmp type")
                other -> Err "malformed LLVM fcmp")
            else if same op "extractvalue" then
              (case op-args of
                Cons ty1 (Cons ty2 (Cons agg-tok (Cons idx-tok Nil))) ->
                  case env of
                    MkLlvmEnv binds ub g0 ret ->
                      (case env-lookup agg-tok binds of
                        Some (MkSemPair first second) ->
                          let chosen = if same idx-tok "0" then first else second in
                          Ok (MkLlvmEnv (Cons (head, chosen) binds) ub g0 ret)
                        other -> Err (string-concat "unresolved aggregate in extractvalue " agg-tok))
                other -> Err "malformed LLVM extractvalue")
            else if same op "insertelement" then
              (case op-args of
                Cons vty-tok (Cons v-tok (Cons ety-tok (Cons e-tok (Cons ity-tok (Cons idx-tok Nil))))) ->
                  (case (parse-llvm-type vty-tok, parse-llvm-type ety-tok, parse-nat-str idx-tok) of
                    (Some (SVec count ew), Some ety, Some idx) ->
                      (case resolve-operand v-tok (SVec count ew) env of
                        Err e -> Err e
                        Ok (MkSemVec lanes vew, g1) ->
                          (case env of
                            MkLlvmEnv binds ub g0 ret ->
                              (case resolve-operand e-tok ety (MkLlvmEnv binds ub g1 ret) of
                                Err e -> Err e
                                Ok (ev, g2) ->
                                  (case set-lane-at idx (sv-val ev, sv-poison ev) lanes of
                                    Err e -> Err e
                                    Ok next-lanes -> Ok (MkLlvmEnv (Cons (head, MkSemVec next-lanes ew) binds) ub g2 ret))))
                        Ok other -> Err "insertelement expects vector operand")
                    other -> Err "malformed LLVM insertelement types")
                other -> Err "malformed LLVM insertelement")
            else if same op "extractelement" then
              (case op-args of
                Cons vty-tok (Cons v-tok (Cons ity-tok (Cons idx-tok Nil))) ->
                  (case (parse-llvm-type vty-tok, parse-nat-str idx-tok) of
                    (Some (SVec count ew), Some idx) ->
                      (case resolve-operand v-tok (SVec count ew) env of
                        Err e -> Err e
                        Ok (MkSemVec lanes vew, g1) ->
                          (case env of
                            MkLlvmEnv binds ub g0 ret ->
                              (case get-lane-at idx lanes of
                                None -> Err "extractelement lane index out of range"
                                Some (lv, lp) ->
                                  let ety = if ew == 1 then SBool else SBv ew in
                                  Ok (MkLlvmEnv (Cons (head, MkSemVal lv lp ety) binds) ub g1 ret)))
                        Ok other -> Err "extractelement expects vector operand")
                    other -> Err "malformed LLVM extractelement types")
                other -> Err "malformed LLVM extractelement")
            else if same op "shufflevector" then
              (case op-args of
                Cons vty1 (Cons v1-tok (Cons vty2 (Cons v2-tok (Cons mty-tok (Cons mask-tok Nil))))) ->
                  (case (parse-llvm-type vty1, parse-llvm-type mty-tok) of
                    (Some (SVec n ew), Some (SVec m mw)) ->
                      (case resolve-operand v1-tok (SVec n ew) env of
                        Err e -> Err e
                        Ok (MkSemVec l1 ew1, g1) ->
                          (case env of
                            MkLlvmEnv binds ub g0 ret ->
                              (case resolve-operand v2-tok (SVec n ew) (MkLlvmEnv binds ub g1 ret) of
                                Err e -> Err e
                                Ok (MkSemVec l2 ew2, g2) ->
                                  (case parse-shuffle-mask mask-tok m of
                                    None -> Err (string-concat "unsupported shufflevector mask " mask-tok)
                                    Some idxs ->
                                      (case gather-shuffle-lanes idxs (l1 <> l2) of
                                        Err e -> Err e
                                        Ok out-lanes -> Ok (MkLlvmEnv (Cons (head, MkSemVec out-lanes ew) binds) ub g2 ret)))
                                Ok other -> Err "shufflevector expects vector rhs"))
                        Ok other -> Err "shufflevector expects vector lhs")
                    other -> Err "malformed LLVM shufflevector types")
                other -> Err "malformed LLVM shufflevector")
            else if same op "call" then
              lower-intrinsic-call head op-args env
            else Err (string-concat "unsupported LLVM instruction in verifier: " op)
          other -> Err "malformed LLVM assignment")
      else Err "unsupported LLVM line in verifier"
    other -> Err "unsupported LLVM line in verifier"

  lower-ir-lines :: List String -> LlvmEnv -> Result String LlvmEnv
  lower-ir-lines lines env = case lines of
    Nil -> Ok env
    Cons line rest ->
      case lower-ir-line (ir-words line) env of
        Err e -> Err e
        Ok next -> lower-ir-lines rest next

  -- --------------------------------------------------------------------------
  -- 4b. Acyclic Multi-Block CFG Lowering (`label:`, `br i1`, `br label`, `phi`)
  -- --------------------------------------------------------------------------

  is-cfg-line :: String -> Bool
  is-cfg-line line =
    let t = strip-ir-comment line in
    if string-length t == 0 then False
    else if string-ends-with ":" t then True
    else case ir-words t of
      Cons w rest -> same w "br" || has-str "phi" rest
      Nil -> False

  has-cfg-lines :: List String -> Bool
  has-cfg-lines lines = case lines of
    Nil -> False
    Cons l rest -> is-cfg-line l || has-cfg-lines rest

  is-label-line :: String -> Option String
  is-label-line line =
    let t = strip-ir-comment line in
    if string-length t > 1 && string-ends-with ":" t && not (string-contains " " t) then
      Some (string-slice t 0 (saturating-sub (string-length t) 1))
    else None

  split-ir-blocks :: List String -> String -> List String -> Bool -> List (String, List String)
  split-ir-blocks lines cur-lbl cur-acc started = case lines of
    Nil ->
      if started || (case cur-acc of Nil -> False; other -> True) then
        Cons (cur-lbl, reverse cur-acc) Nil
      else Nil
    Cons raw rest ->
      let t = strip-ir-comment raw in
      if string-length t == 0 then split-ir-blocks rest cur-lbl cur-acc started
      else case is-label-line t of
        Some next-lbl ->
          if started || (case cur-acc of Nil -> False; other -> True) then
            Cons (cur-lbl, reverse cur-acc) (split-ir-blocks rest next-lbl Nil True)
          else split-ir-blocks rest next-lbl Nil True
        None -> split-ir-blocks rest cur-lbl (Cons t cur-acc) True

  lookup-block-idx :: String -> List (String, List String) -> Nat -> Option Nat
  lookup-block-idx lbl blocks idx = case blocks of
    Nil -> None
    Cons (blbl, blines) rest ->
      if same lbl blbl then Some idx
      else lookup-block-idx lbl rest (idx + 1)

  strip-percent :: String -> String
  strip-percent s =
    if string-starts-with "%" s && string-length s > 1 then string-slice s 1 (string-length s)
    else s

  lookup-nat-str :: String -> List (String, Nat) -> Option Nat
  lookup-nat-str k xs = case xs of
    Nil -> None
    Cons (k1, v1) rest -> if same k k1 then Some v1 else lookup-nat-str k rest

  upsert-reach :: String -> Nat -> List (String, Nat) -> SemGraph -> (List (String, Nat), SemGraph)
  upsert-reach lbl cond xs g = case xs of
    Nil -> (Cons (lbl, cond) Nil, g)
    Cons (k, old) rest ->
      if same k lbl then
        let (merged, g1) = g-or old cond g in
        (Cons (k, merged) rest, g1)
      else case upsert-reach lbl cond rest g of
        (more, g1) -> (Cons (k, old) more, g1)

  add-edge-cond :: String -> String -> Nat -> List (String, List (String, Nat)) -> List (String, List (String, Nat))
  add-edge-cond dst src cond xs = case xs of
    Nil -> Cons (dst, Cons (src, cond) Nil) Nil
    Cons (k, es) rest ->
      if same k dst then Cons (k, Cons (src, cond) es) rest
      else Cons (k, es) (add-edge-cond dst src cond rest)

  lookup-edges :: String -> List (String, List (String, Nat)) -> List (String, Nat)
  lookup-edges dst xs = case xs of
    Nil -> Nil
    Cons (k, es) rest -> if same k dst then es else lookup-edges dst rest

  lookup-block-binds :: String -> List (String, List (String, SemVal)) -> Option (List (String, SemVal))
  lookup-block-binds lbl xs = case xs of
    Nil -> None
    Cons (k, bs) rest -> if same k lbl then Some bs else lookup-block-binds lbl rest

  merge-sem-val :: Nat -> SemVal -> SemVal -> SemGraph -> Result String (SemVal, SemGraph)
  merge-sem-val cond vt vf g = case (vt, vf) of
    (MkSemVal v1 p1 ty1, MkSemVal v2 p2 ty2) ->
      let (mv, g1) = g-ite cond v1 v2 g in
      let (mp, g2) = g-ite cond p1 p2 g1 in
      Ok (MkSemVal mv mp ty1, g2)
    other -> Err "cannot merge aggregate/vector values across CFG branches"

  parse-phi-pairs :: List String -> Result String (List (String, String))
  parse-phi-pairs ws = case ws of
    Nil -> Ok Nil
    Cons val-tok (Cons lbl-tok rest) ->
      case parse-phi-pairs rest of
        Err e -> Err e
        Ok more -> Ok (Cons (val-tok, strip-percent lbl-tok) more)
    other -> Err "malformed LLVM phi incoming list"

  eval-phi-pairs :: List (String, String) -> SemType -> List (String, Nat) -> List (String, List (String, SemVal)) -> List (String, SemVal) -> Nat -> SemGraph -> Option SemVal -> Result String (SemVal, SemGraph)
  eval-phi-pairs pairs ty edges bbinds cur-binds ub g acc = case pairs of
    Nil -> case acc of
      Some sv -> Ok (sv, g)
      None -> Err "phi node has no reachable incoming edge"
    Cons (val-tok, pred-lbl) rest ->
      case lookup-nat-str pred-lbl edges of
        None -> eval-phi-pairs rest ty edges bbinds cur-binds ub g acc
        Some econd ->
          let pbinds = case lookup-block-binds pred-lbl bbinds of Some bs -> bs; None -> cur-binds in
          case resolve-operand val-tok ty (MkLlvmEnv pbinds ub g None) of
            Err e -> Err e
            Ok (sv, g1) ->
              (case acc of
                None -> eval-phi-pairs rest ty edges bbinds cur-binds ub g1 (Some sv)
                Some prev ->
                  (case merge-sem-val econd sv prev g1 of
                    Err e -> Err e
                    Ok (merged, g2) -> eval-phi-pairs rest ty edges bbinds cur-binds ub g2 (Some merged)))

  lower-cfg-block-lines :: String -> Nat -> List (String, List String) -> List String -> Nat -> List (String, SemVal) -> List (String, Nat) -> List (String, List (String, Nat)) -> List (String, List (String, SemVal)) -> Nat -> Option SemVal -> SemGraph -> Result String (List (String, SemVal), List (String, Nat), List (String, List (String, Nat)), Nat, Option SemVal, SemGraph)
  lower-cfg-block-lines blbl bidx all-blocks lines reach binds reach-map edge-map bbinds ub ret-acc g = case lines of
    Nil -> Ok (binds, reach-map, edge-map, ub, ret-acc, g)
    Cons line rest ->
      let ws = ir-words line in
      case ws of
        Nil -> lower-cfg-block-lines blbl bidx all-blocks rest reach binds reach-map edge-map bbinds ub ret-acc g
        -- Unconditional branch: br label %dest
        Cons "br" (Cons "label" (Cons dst-tok Nil)) ->
          let dst = strip-percent dst-tok in
          case lookup-block-idx dst all-blocks 0 of
            None -> Err (string-concat "containment (no-escape): undefined branch target %" dst)
            Some tidx ->
              if tidx <= bidx then Err (string-concat "containment (no-escape): cyclic/backward branch to %" dst)
              else
                let (rm1, g1) = upsert-reach dst reach reach-map g in
                let em1 = add-edge-cond dst blbl reach edge-map in
                Ok (binds, rm1, em1, ub, ret-acc, g1)
        -- Conditional branch: br i1 %cond, label %t, label %f
        Cons "br" (Cons "i1" (Cons cond-tok (Cons "label" (Cons t-tok (Cons "label" (Cons f-tok Nil)))))) ->
          let t-lbl = strip-percent t-tok in
          let f-lbl = strip-percent f-tok in
          case (lookup-block-idx t-lbl all-blocks 0, lookup-block-idx f-lbl all-blocks 0) of
            (Some tidx, Some fidx) | tidx > bidx && fidx > bidx ->
              (case resolve-operand cond-tok SBool (MkLlvmEnv binds ub g None) of
                Err e -> Err e
                Ok (cv, g1) ->
                  -- Branching on poison is immediate UB when this block is reachable!
                  let (p-ub, g2) = g-and reach (sv-poison cv) g1 in
                  let (ub1, g3) = g-or ub p-ub g2 in
                  let (t-cond, g4) = g-and reach (sv-val cv) g3 in
                  let (not-c, g5) = g-not (sv-val cv) g4 in
                  let (f-cond, g6) = g-and reach not-c g5 in
                  let (rm1, g7) = upsert-reach t-lbl t-cond reach-map g6 in
                  let (rm2, g8) = upsert-reach f-lbl f-cond rm1 g7 in
                  let em1 = add-edge-cond t-lbl blbl t-cond edge-map in
                  let em2 = add-edge-cond f-lbl blbl f-cond em1 in
                  Ok (binds, rm2, em2, ub1, ret-acc, g8))
            other -> Err "containment (no-escape): cyclic/backward or undefined conditional branch target"
        -- Return inside a CFG block: merge into `ret-acc` guarded by `reach`
        Cons "ret" (Cons ty-tok (Cons val-tok Nil)) ->
          (case parse-llvm-type ty-tok of
            None -> Err (string-concat "unsupported ret type " ty-tok)
            Some ty ->
              (case resolve-operand val-tok ty (MkLlvmEnv binds ub g None) of
                Err e -> Err e
                Ok (rv, g1) ->
                  (case ret-acc of
                    None -> Ok (binds, reach-map, edge-map, ub, Some rv, g1)
                    Some prev ->
                      (case merge-sem-val reach rv prev g1 of
                        Err e -> Err e
                        Ok (merged, g2) -> Ok (binds, reach-map, edge-map, ub, Some merged, g2)))))
        -- Phi node: %lhs = phi <ty> [ v1, %p1 ], [ v2, %p2 ], ...
        Cons lhs (Cons "=" (Cons "phi" (Cons ty-tok phi-rest))) ->
          (case parse-llvm-type ty-tok of
            None -> Err (string-concat "unsupported phi type " ty-tok)
            Some ty ->
              (case parse-phi-pairs phi-rest of
                Err e -> Err e
                Ok pairs ->
                  let edges = lookup-edges blbl edge-map in
                  (case eval-phi-pairs pairs ty edges bbinds binds ub g None of
                    Err e -> Err e
                    Ok (pv, g1) ->
                      lower-cfg-block-lines blbl bidx all-blocks rest reach (Cons (lhs, pv) binds) reach-map edge-map bbinds ub ret-acc g1)))
        -- Regular instruction: run with fresh local-ub = False, then guard `ub |= reach && local-ub`
        other ->
          let (local-ub0, g1) = g-bool False g in
          case lower-ir-line ws (MkLlvmEnv binds local-ub0 g1 None) of
            Err e -> Err e
            Ok (MkLlvmEnv binds2 local-ub2 g2 r2) ->
              let (guarded-ub, g3) = g-and reach local-ub2 g2 in
              let (ub1, g4) = g-or ub guarded-ub g3 in
              lower-cfg-block-lines blbl bidx all-blocks rest reach binds2 reach-map edge-map bbinds ub1 ret-acc g4

  lower-cfg-blocks-loop :: List (String, List String) -> List (String, List String) -> Nat -> List (String, SemVal) -> List (String, Nat) -> List (String, List (String, Nat)) -> List (String, List (String, SemVal)) -> Nat -> Option SemVal -> SemGraph -> Result String LlvmEnv
  lower-cfg-blocks-loop all-blocks pending bidx base-binds reach-map edge-map bbinds ub ret-acc g = case pending of
    Nil -> Ok (MkLlvmEnv base-binds ub g ret-acc)
    Cons (blbl, blines) rest ->
      let (reach, g1) = case lookup-nat-str blbl reach-map of
            Some r -> (r, g)
            None -> g-bool False g in
      case lower-cfg-block-lines blbl bidx all-blocks blines reach base-binds reach-map edge-map bbinds ub ret-acc g1 of
        Err e -> Err e
        Ok (exit-binds, rm1, em1, ub1, ret1, g2) ->
          lower-cfg-blocks-loop all-blocks rest (bidx + 1) exit-binds rm1 em1 (Cons (blbl, exit-binds) bbinds) ub1 ret1 g2

  lower-ir-fragment :: String -> List (String, SemVal) -> Nat -> SemGraph -> Result String LlvmEnv
  lower-ir-fragment fragment binds ub0 g0 =
    let lines = string-split-on "\n" fragment in
    if not (has-cfg-lines lines) then
      lower-ir-lines lines (MkLlvmEnv binds ub0 g0 None)
    else
      let blocks = split-ir-blocks lines "entry" Nil False in
      case blocks of
        Nil -> Err "empty LLVM fragment"
        Cons (entry-lbl, entry-lines) rest ->
          let (t-id, g1) = g-bool True g0 in
          lower-cfg-blocks-loop blocks blocks 0 binds (Cons (entry-lbl, t-id) Nil) Nil Nil ub0 None g1

  init-llvm-params :: List PrimParamSpec -> Nat -> List (String, SemVal) -> SemGraph -> (List (String, SemVal), List (Nat, SemType, String), SemGraph)
  init-llvm-params ps idx binds g = case ps of
    Nil -> (binds, Nil, g)
    Cons p rest ->
      let sem-ty =
            if param-spec-fp p then SFp (param-spec-width p)
            else SBv (param-spec-width p) in
      let (v, g1) = g-var idx sem-ty (param-spec-name p) g in
      let (clean-p, g2) = g-bool False g1 in
      let reg = string-concat "%" (nat-to-string idx) in
      let sv = MkSemVal v clean-p sem-ty in
      case init-llvm-params rest (idx + 1) (Cons (reg, sv) binds) g2 of
        (all-binds, vars, g3) -> (all-binds, Cons (idx, sem-ty, param-spec-name p) vars, g3)

  -- ==========================================================================
  -- 5. Cinch `spec` and Refinement Lowering into `SemGraph`
  -- ==========================================================================

  strip-module-prefix :: String -> String
  strip-module-prefix s =
    let raw = strip-dot-loop (unpack s) Nil in
    let decoded = case decode-identity (unpack raw) of
          Some (d, Nil) -> d
          other -> raw in
    strip-dot-loop (unpack decoded) Nil

  strip-dot-loop :: List Char -> List Char -> String
  strip-dot-loop cs acc = case cs of
    Nil -> pack (reverse acc)
    Cons c rest ->
      if char-code c == 46 then strip-dot-loop rest Nil
      else strip-dot-loop rest (Cons c acc)

  unroll-app :: Expr -> List Expr -> (Expr, List Expr)
  unroll-app e acc = case e of
    EApp sp f x -> unroll-app f (Cons x acc)
    other -> (e, acc)

  lookup-spec-var :: String -> List (String, Nat, SemType) -> Option (Nat, SemType)
  lookup-spec-var nm binds = case binds of
    Nil -> None
    Cons (k, id, ty) rest -> if same nm k then Some (id, ty) else lookup-spec-var nm rest

  -- Lower a Cinch `spec` expression into `SemGraph`.
  lower-spec-expr :: List (String, Nat, SemType) -> SemType -> Expr -> SemGraph -> Result String (Nat, SemType, SemGraph)
  lower-spec-expr binds expected e g = case e of
    EAnn sp inner ty -> lower-spec-expr binds expected inner g
    ELetScope sp inner -> lower-spec-expr binds expected inner g
    EVar sp name ->
      case lookup-spec-var name binds of
        Some (id, ty) -> Ok (id, ty, g)
        None ->
          let short = strip-module-prefix name in
          case lookup-spec-var short binds of
            Some (id, ty) -> Ok (id, ty, g)
            None -> Err (string-concat "unbound variable in prim spec: " name)
    ECon sp name args ->
      let short = strip-module-prefix name in
      if same short "True" then
        let (v, g1) = g-bool True g in Ok (v, SBool, g1)
      else if same short "False" then
        let (v, g1) = g-bool False g in Ok (v, SBool, g1)
      else Err (string-concat "unsupported constructor in prim spec: " name)
    ELitInt sp digits ->
      case parse-ir-u128 digits of
        Some (lo, hi) ->
          let w = case expected of SBv n -> n; other -> 64 in
          let (v, g1) = g-bv-pair w lo hi g in Ok (v, SBv w, g1)
        None -> Err (string-concat "invalid integer literal in prim spec: " digits)
    ENeg sp inner ->
      case lower-spec-expr binds expected inner g of
        Err err -> Err err
        Ok (v, ty, g1) -> case ty of
          SBv w ->
            let (z, g2) = g-bv w 0 g1 in
            let (res, g3) = g-bv-bin "sub" w z v g2 in
            Ok (res, SBv w, g3)
          other -> Err "negation on non-bitvector in prim spec"
    EIf sp cond th el ->
      case lower-spec-expr binds SBool cond g of
        Err err -> Err err
        Ok (cv, cty, g1) ->
          case lower-spec-expr binds expected th g1 of
            Err err -> Err err
            Ok (tv, tty, g2) ->
              case lower-spec-expr binds tty el g2 of
                Err err -> Err err
                Ok (ev, ety, g3) ->
                  let (res, g4) = g-ite cv tv ev g3 in
                  Ok (res, tty, g4)
    ELet sp bs body -> lower-spec-let binds expected bs body g
    EBin sp op a b -> lower-spec-binop binds expected op a b g
    EApp sp f x ->
      case unroll-app e Nil of
        (EVar head-sp fn-name, args) -> lower-spec-call binds expected (strip-module-prefix fn-name) args g
        other -> Err "unsupported higher-order application in prim spec"
    other -> Err "unsupported expression form in prim spec"

  lower-spec-let :: List (String, Nat, SemType) -> SemType -> Expr -> Expr -> SemGraph -> Result String (Nat, SemType, SemGraph)
  lower-spec-let binds expected bs body g = case bs of
    EBindingsEnd sp -> lower-spec-expr binds expected body g
    EBinding sp name rhs rest ->
      case lower-spec-expr binds expected rhs g of
        Err err -> Err err
        Ok (v, ty, g1) -> lower-spec-let (Cons (name, v, ty) binds) expected rest body g1
    other -> lower-spec-expr binds expected body g

  lower-spec-binop :: List (String, Nat, SemType) -> SemType -> String -> Expr -> Expr -> SemGraph -> Result String (Nat, SemType, SemGraph)
  lower-spec-binop binds expected op a b g =
    if same op "&&" || same op "||" then
      case lower-spec-expr binds SBool a g of
        Err err -> Err err
        Ok (va, ta, g1) -> case lower-spec-expr binds SBool b g1 of
          Err err -> Err err
          Ok (vb, tb, g2) ->
            let (res, g3) = if same op "&&" then g-and va vb g2 else g-or va vb g2 in
            Ok (res, SBool, g3)
    else
      case lower-spec-expr binds expected a g of
        Err err -> Err err
        Ok (va, ta, g1) -> case lower-spec-expr binds ta b g1 of
          Err err -> Err err
          Ok (vb, tb, g2) -> case ta of
            SBv w ->
              if same op "+" then let (r, g3) = g-bv-bin "add" w va vb g2 in Ok (r, SBv w, g3)
              else if same op "-" then let (r, g3) = g-bv-bin "sub" w va vb g2 in Ok (r, SBv w, g3)
              else if same op "*" then let (r, g3) = g-bv-bin "mul" w va vb g2 in Ok (r, SBv w, g3)
              else if same op "==" then let (r, g3) = g-bv-cmp "eq" w va vb g2 in Ok (r, SBool, g3)
              else if same op "/=" then let (r, g3) = g-bv-cmp "ne" w va vb g2 in Ok (r, SBool, g3)
              else if same op "<" then let (r, g3) = g-bv-cmp "ult" w va vb g2 in Ok (r, SBool, g3)
              else if same op "<=" then let (r, g3) = g-bv-cmp "ule" w va vb g2 in Ok (r, SBool, g3)
              else if same op ">" then let (r, g3) = g-bv-cmp "ugt" w va vb g2 in Ok (r, SBool, g3)
              else if same op ">=" then let (r, g3) = g-bv-cmp "uge" w va vb g2 in Ok (r, SBool, g3)
              else Err (string-concat "unsupported binary operator in prim spec: " op)
            SBool ->
              if same op "==" then let (r, g3) = g-intern (NEqBool va vb) g2 in Ok (r, SBool, g3)
              else if same op "/=" then let (r, g3) = g-intern (NXor va vb) g2 in Ok (r, SBool, g3)
              else Err (string-concat "unsupported bool operator in prim spec: " op)
            other -> Err "unsupported operand type in prim spec"

  infer-op-signed :: String -> Bool
  infer-op-signed fn =
    string-ends-with "-i8" fn || string-ends-with "-i16" fn || string-ends-with "-i32" fn
      || string-ends-with "-i64" fn || string-ends-with "-i128" fn || string-ends-with "-isize" fn

  lower-spec-call :: List (String, Nat, SemType) -> SemType -> String -> List Expr -> SemGraph -> Result String (Nat, SemType, SemGraph)
  lower-spec-call binds expected fn args g = case args of
    Cons a Nil ->
      if same fn "not" then
        case lower-spec-expr binds SBool a g of
          Err err -> Err err
          Ok (va, ta, g1) -> let (r, g2) = g-not va g1 in Ok (r, SBool, g2)
      else
        case lower-spec-expr binds expected a g of
          Err err -> Err err
          Ok (va, SBv w, g1) ->
            if string-starts-with "bit-not-" fn then
              let (ones, g2) = g-bv-mask w g1 in
              let (r, g3) = g-bv-bin "xor" w va ones g2 in Ok (r, SBv w, g3)
            else if string-starts-with "wrapping-neg-" fn then
              let (zero, g2) = g-bv w 0 g1 in
              let (r, g3) = g-bv-bin "sub" w zero va g2 in Ok (r, SBv w, g3)
            else if string-starts-with "swap-bytes-" fn then
              let (r, g2) = g-intern (NBvUn "bswap" w va) g1 in Ok (r, SBv w, g2)
            else if string-starts-with "reverse-bits-" fn then
              let (r, g2) = g-intern (NBvUn "bitreverse" w va) g1 in Ok (r, SBv w, g2)
            else if string-starts-with "count-ones-" fn then
              let (r, g2) = g-intern (NBvUn "ctpop" w va) g1 in Ok (r, SBv w, g2)
            else if string-starts-with "leading-zeros-" fn then
              let (r, g2) = g-intern (NBvUn "ctlz" w va) g1 in Ok (r, SBv w, g2)
            else if string-starts-with "trailing-zeros-" fn then
              let (r, g2) = g-intern (NBvUn "cttz" w va) g1 in Ok (r, SBv w, g2)
            else Err (string-concat "unsupported unary function in prim spec: " fn)
          Ok (va, other, g1) -> Err (string-concat "non-bitvector unary spec call: " fn)
    Cons a (Cons b Nil) ->
      case lower-spec-expr binds expected a g of
        Err err -> Err err
        Ok (va, SBv w, g1) ->
          case lower-spec-expr binds (SBv w) b g1 of
            Err err -> Err err
            Ok (vb, tb, g2) ->
              let sg = infer-op-signed fn in
              let (vb-cast, g3) = case tb of
                    SBv wb | wb /= w -> g-bv-cast (if wb < w then "zext" else "trunc") wb w vb g2
                    other -> (vb, g2) in
              if string-starts-with "wrapping-add-" fn then let (r, g4) = g-bv-bin "add" w va vb-cast g3 in Ok (r, SBv w, g4)
              else if string-starts-with "wrapping-sub-" fn then let (r, g4) = g-bv-bin "sub" w va vb-cast g3 in Ok (r, SBv w, g4)
              else if string-starts-with "wrapping-mul-" fn then let (r, g4) = g-bv-bin "mul" w va vb-cast g3 in Ok (r, SBv w, g4)
              else if string-starts-with "saturating-add-" fn then let (r, g4) = g-bv-bin (if sg then "sadd_sat" else "uadd_sat") w va vb-cast g3 in Ok (r, SBv w, g4)
              else if string-starts-with "saturating-sub-" fn then let (r, g4) = g-bv-bin (if sg then "ssub_sat" else "usub_sat") w va vb-cast g3 in Ok (r, SBv w, g4)
              else if string-starts-with "bit-and-" fn then let (r, g4) = g-bv-bin "and" w va vb-cast g3 in Ok (r, SBv w, g4)
              else if string-starts-with "bit-or-" fn then let (r, g4) = g-bv-bin "or" w va vb-cast g3 in Ok (r, SBv w, g4)
              else if string-starts-with "bit-xor-" fn then let (r, g4) = g-bv-bin "xor" w va vb-cast g3 in Ok (r, SBv w, g4)
              else if string-starts-with "wrapping-shl-" fn || string-starts-with "shl-" fn then
                let (mconst, g3a) = g-bv w (nat-u64 (saturating-sub w 1)) g3 in
                let (masked, g3b) = g-bv-bin "and" w vb-cast mconst g3a in
                let (r, g4) = g-bv-bin "shl" w va masked g3b in Ok (r, SBv w, g4)
              else if string-starts-with "wrapping-shr-" fn || string-starts-with "shr-" fn then
                let (mconst, g3a) = g-bv w (nat-u64 (saturating-sub w 1)) g3 in
                let (masked, g3b) = g-bv-bin "and" w vb-cast mconst g3a in
                let (r, g4) = g-bv-bin (if sg then "ashr" else "lshr") w va masked g3b in Ok (r, SBv w, g4)
              else if string-starts-with "rotate-left-" fn then
                let (r, g4) = g-intern (NBvTri "fshl" w va va vb-cast) g3 in Ok (r, SBv w, g4)
              else if string-starts-with "rotate-right-" fn then
                let (r, g4) = g-intern (NBvTri "fshr" w va va vb-cast) g3 in Ok (r, SBv w, g4)
              else if string-starts-with "eq-" fn then let (r, g4) = g-bv-cmp "eq" w va vb-cast g3 in Ok (r, SBool, g4)
              else if string-starts-with "ne-" fn then let (r, g4) = g-bv-cmp "ne" w va vb-cast g3 in Ok (r, SBool, g4)
              else if string-starts-with "lt-" fn then let (r, g4) = g-bv-cmp (if sg then "slt" else "ult") w va vb-cast g3 in Ok (r, SBool, g4)
              else if string-starts-with "le-" fn then let (r, g4) = g-bv-cmp (if sg then "sle" else "ule") w va vb-cast g3 in Ok (r, SBool, g4)
              else if string-starts-with "gt-" fn then let (r, g4) = g-bv-cmp (if sg then "sgt" else "ugt") w va vb-cast g3 in Ok (r, SBool, g4)
              else if string-starts-with "ge-" fn then let (r, g4) = g-bv-cmp (if sg then "sge" else "uge") w va vb-cast g3 in Ok (r, SBool, g4)
              else Err (string-concat "unsupported binary function in prim spec: " fn)
        Ok (va, other, g1) -> Err (string-concat "non-bitvector binary spec call: " fn)
    other -> Err (string-concat "unsupported spec call arity for " fn)

  pair-spec-params :: List String -> List (Nat, SemType, String) -> List (String, Nat, SemType)
  pair-spec-params pnames vars = case (pnames, vars) of
    (Cons nm nr, Cons (idx, ty, orig) vr) -> Cons (nm, idx, ty) (pair-spec-params nr vr)
    other -> Nil

  extract-lam-params :: List Pat -> List String
  extract-lam-params ps = case ps of
    Nil -> Nil
    Cons (PVar sp nm) rest -> Cons nm (extract-lam-params rest)
    Cons other rest -> Cons "_" (extract-lam-params rest)

  -- Resolve a `spec <expr>` clause (either a named `spec` function or a lambda).
  lower-prim-spec :: Expr -> List SpecDef -> List (Nat, SemType, String) -> SemType -> SemGraph -> Result String (Nat, SemType, SemGraph)
  lower-prim-spec spec-expr spec-defs vars res-ty g = case spec-expr of
    EVar sp fn-name ->
      case lookup-spec-def fn-name spec-defs of
        Some (MkSpecDef nm pnames body) ->
          let var-binds = init-spec-var-nodes pnames vars g in
          lower-spec-expr (fst-triple-list var-binds) res-ty body (snd-triple-list var-binds)
        None -> Err (string-concat "prim spec references unknown spec function: " fn-name)
    ELam sp pats body ->
      let pnames = extract-lam-params pats in
      let var-binds = init-spec-var-nodes pnames vars g in
      lower-spec-expr (fst-triple-list var-binds) res-ty body (snd-triple-list var-binds)
    other -> Err "prim spec must name a `spec` function or lambda"

  fst-triple-list :: (List (String, Nat, SemType), SemGraph) -> List (String, Nat, SemType)
  fst-triple-list p = case p of (a, b) -> a

  snd-triple-list :: (List (String, Nat, SemType), SemGraph) -> SemGraph
  snd-triple-list p = case p of (a, b) -> b

  init-spec-var-nodes :: List String -> List (Nat, SemType, String) -> SemGraph -> (List (String, Nat, SemType), SemGraph)
  init-spec-var-nodes pnames vars g = case (pnames, vars) of
    (Cons nm nr, Cons (idx, ty, orig) vr) ->
      let (nid, g1) = g-var idx ty orig g in
      case init-spec-var-nodes nr vr g1 of
        (rest, g2) -> (Cons (nm, nid, ty) rest, g2)
    other -> (Nil, g)

  -- Lower simple refinement predicates (e.g. `b /= 0`, `a <= b`) into assumptions.
  lower-refinement-pred :: List (String, Nat, SemType, Bool) -> UType -> SemGraph -> Option (Nat, SemGraph)
  lower-refinement-pred env pred g = case refinement-view pred of
    UPropAnd a b ->
      case lower-refinement-pred env a g of
        Some (na, g1) -> (case lower-refinement-pred env b g1 of
          Some (nb, g2) -> Some (g-and na nb g2)
          None -> None)
        None -> None
    UPropOr a b ->
      case lower-refinement-pred env a g of
        Some (na, g1) -> (case lower-refinement-pred env b g1 of
          Some (nb, g2) -> Some (g-or na nb g2)
          None -> None)
        None -> None
    UPropNot a ->
      case lower-refinement-pred env a g of
        Some (na, g1) -> Some (g-not na g1)
        None -> None
    UPropNonZero a ->
      case lower-index-utype env a g of
        Some (na, w1, sg1, g1) ->
          let w = if w1 > 0 then w1 else 64 in
          let (zero, g2) = g-bv w 0 g1 in
          Some (g-bv-cmp "ne" w na zero g2)
        None -> None
    UPropNotNaN a ->
      case lower-fp-ref-var env a of
        Some (na, w) ->
          let (is-nan, g1) = g-intern (NFpPred "isNaN" w na) g in
          Some (g-not is-nan g1)
        None -> None
    UPropFinite a ->
      case lower-fp-ref-var env a of
        Some (na, w) -> Some (g-intern (NFpPred "isFinite" w na) g)
        None -> None
    UCompare rel a b ->
      case (lower-index-utype env a g, lower-index-utype env b g) of
        (Some _, Some _) ->
          (case lower-index-utype env a g of
            Some (na, w1, sg1, g1) ->
              (case lower-index-utype env b g1 of
                Some (nb, w2, sg2, g2) ->
                  let w = if w1 > 0 then w1 else if w2 > 0 then w2 else 64 in
                  let sg = if w1 > 0 then sg1 else if w2 > 0 then sg2 else (sg1 || sg2) in
                  let (na2, g3) = if w1 == 0 then (case extract-const-u128 na g2 of (lo, hi) -> g-bv-pair w lo hi g2) else (na, g2) in
                  let (nb2, g4) = if w2 == 0 then (case extract-const-u128 nb g3 of (lo, hi) -> g-bv-pair w lo hi g3) else (nb, g3) in
                  let cmp-op =
                        if same rel "==" then "eq"
                        else if same rel "/=" then "ne"
                        else if same rel "<" then (if sg then "slt" else "ult")
                        else if same rel "<=" then (if sg then "sle" else "ule")
                        else if same rel ">" then (if sg then "sgt" else "ugt")
                        else (if sg then "sge" else "uge") in
                  Some (g-bv-cmp cmp-op w na2 nb2 g4)
                None -> None)
            None -> None)
        other -> lower-fp-compare env rel a b g
    other -> None

  lookup-fp-var :: String -> List (String, Nat, SemType, Bool) -> Option (Nat, Nat)
  lookup-fp-var nm env = case env of
    Nil -> None
    Cons (k, nid, SFp w, sg) rest -> if same nm k then Some (nid, w) else lookup-fp-var nm rest
    Cons other rest -> lookup-fp-var nm rest

  lower-fp-ref-var :: List (String, Nat, SemType, Bool) -> UType -> Option (Nat, Nat)
  lower-fp-ref-var env u = case refinement-view u of
    UBound id nm kind -> lookup-fp-var nm env
    URigid id nm lvl kind -> lookup-fp-var nm env
    UIndex carrier (IBound id nm) -> lookup-fp-var nm env
    UIndex carrier (IRigid id nm lvl) -> lookup-fp-var nm env
    UIndexForget inner -> lower-fp-ref-var env inner
    UIndexPromote inner -> lower-fp-ref-var env inner
    other -> None

  extract-int-const-utype :: UType -> Option Int
  extract-int-const-utype u = case refinement-view u of
    UIndex carrier (IInteger n) -> Some n
    UIndexForget inner -> extract-int-const-utype inner
    UIndexPromote inner -> extract-int-const-utype inner
    UIndexMath op a b ->
      case (extract-int-const-utype a, extract-int-const-utype b) of
        (Some x, Some y) ->
          if same op "+" then Some (x + y)
          else if same op "-" then Some (x - y)
          else if same op "*" then Some (x * y)
          else None
        other -> None
    other -> None

  lower-fp-operand :: List (String, Nat, SemType, Bool) -> Nat -> UType -> SemGraph -> Option (Nat, SemGraph)
  lower-fp-operand env w u g = case lower-fp-ref-var env u of
    Some (nid, w2) -> if w == w2 then Some (nid, g) else None
    None -> case extract-int-const-utype u of
      Some n ->
        let carrier = UCon (if w == 32 then "F32" else "F64") KType in
        (case float-literal-bits carrier n False of
          Some bits -> (case parse-ir-u128 (int-to-string bits) of
            Some (lo, hi) -> Some (g-bv-pair w lo hi g)
            None -> None)
          None -> None)
      None -> None

  lower-fp-compare :: List (String, Nat, SemType, Bool) -> String -> UType -> UType -> SemGraph -> Option (Nat, SemGraph)
  lower-fp-compare env rel a b g =
    let w-opt = case lower-fp-ref-var env a of
          Some (_, w) -> Some w
          None -> case lower-fp-ref-var env b of
            Some (_, w) -> Some w
            None -> None in
    case w-opt of
      None -> None
      Some w -> case lower-fp-operand env w a g of
        None -> None
        Some (na, g1) -> case lower-fp-operand env w b g1 of
          None -> None
          Some (nb, g2) ->
            let fpred =
                  if same rel "==" then "oeq"
                  else if same rel "/=" then "one"
                  else if same rel "<" then "olt"
                  else if same rel "<=" then "ole"
                  else if same rel ">" then "ogt"
                  else "oge" in
            Some (g-intern (NFpCmp fpred w na nb) g2)

  extract-const-u128 :: Nat -> SemGraph -> (U64, U64)
  extract-const-u128 id g = case graph-node id g of
    Some (NBvConst w lo hi) -> (lo, hi)
    other -> (0, 0)

  lookup-ref-var :: String -> List (String, Nat, SemType, Bool) -> Option (Nat, Nat, Bool)
  lookup-ref-var nm env = case env of
    Nil -> None
    Cons (k, nid, SBv w, sg) rest -> if same nm k then Some (nid, w, sg) else lookup-ref-var nm rest
    Cons other rest -> lookup-ref-var nm rest

  lower-index-utype :: List (String, Nat, SemType, Bool) -> UType -> SemGraph -> Option (Nat, Nat, Bool, SemGraph)
  lower-index-utype env u g = case refinement-view u of
    UBound id nm kind ->
      (case lookup-ref-var nm env of
        Some (nid, w, sg) -> Some (nid, w, sg, g)
        None -> None)
    URigid id nm lvl kind ->
      (case lookup-ref-var nm env of
        Some (nid, w, sg) -> Some (nid, w, sg, g)
        None -> None)
    UIndex carrier term -> lower-index-term env term g
    UIndexForget inner -> lower-index-utype env inner g
    UIndexPromote inner -> lower-index-utype env inner g
    other -> None

  lower-index-term :: List (String, Nat, SemType, Bool) -> IndexTerm -> SemGraph -> Option (Nat, Nat, Bool, SemGraph)
  lower-index-term env term g = case term of
    IInteger n ->
      let (lo, hi) = case parse-ir-u128 (int-to-string n) of Some p -> p; None -> (0, 0) in
      let (id, g1) = g-bv-pair 128 lo hi g in
      Some (id, 0, n < 0, g1)
    IBound id nm ->
      case lookup-ref-var nm env of
        Some (nid, w, sg) -> Some (nid, w, sg, g)
        None -> None
    IRigid id nm lvl ->
      case lookup-ref-var nm env of
        Some (nid, w, sg) -> Some (nid, w, sg, g)
        None -> None
    other -> None

  -- ==========================================================================
  -- 6. SMT-LIB 2 Emitter (`QF_BV` / `QF_FPBV`) from the same `SemGraph`
  -- ==========================================================================

  smt-sort :: SemType -> String
  smt-sort t = case t of
    SBool -> "Bool"
    SBv w -> string-concat-all ["(_ BitVec ", nat-to-string w, ")"]
    SFp 32 -> "Float32"
    SFp w -> "Float64"
    SVec n w -> string-concat-all ["(_ BitVec ", nat-to-string (n * w), ")"]

  smt-decls :: List (Nat, SemType, String) -> List String
  smt-decls vars = case vars of
    Nil -> Nil
    Cons (idx, ty, nm) rest ->
      Cons (string-concat-all ["(declare-const v", nat-to-string idx, " ", smt-sort ty, ")"]) (smt-decls rest)

  smt-expr :: Nat -> SemGraph -> String
  smt-expr id g = case graph-node id g of
    None -> "false"
    Some n -> case n of
      NBoolConst b -> if b then "true" else "false"
      NBvConst w lo hi ->
        if w <= 64 then string-concat-all ["(_ bv", u64-decimal lo, " ", nat-to-string w, ")"]
        else string-concat-all ["(concat (_ bv", u64-decimal hi, " ", nat-to-string (saturating-sub w 64), ") (_ bv", u64-decimal lo, " 64))"]
      NVar i ty nm -> string-concat "v" (nat-to-string i)
      NNot a -> string-concat-all ["(not ", smt-expr a g, ")"]
      NAnd a b -> string-concat-all ["(and ", smt-expr a g, " ", smt-expr b g, ")"]
      NOr a b -> string-concat-all ["(or ", smt-expr a g, " ", smt-expr b g, ")"]
      NXor a b -> string-concat-all ["(xor ", smt-expr a g, " ", smt-expr b g, ")"]
      NImplies a b -> string-concat-all ["(=> ", smt-expr a g, " ", smt-expr b g, ")"]
      NEqBool a b -> string-concat-all ["(= ", smt-expr a g, " ", smt-expr b g, ")"]
      NIte c t e -> string-concat-all ["(ite ", smt-expr c g, " ", smt-expr t g, " ", smt-expr e g, ")"]
      NBvBin op w a b ->
        let smt-op =
              if same op "add" then "bvadd"
              else if same op "sub" then "bvsub"
              else if same op "mul" then "bvmul"
              else if same op "udiv" then "bvudiv"
              else if same op "sdiv" then "bvsdiv"
              else if same op "urem" then "bvurem"
              else if same op "srem" then "bvsrem"
              else if same op "shl" then "bvshl"
              else if same op "lshr" then "bvlshr"
              else if same op "ashr" then "bvashr"
              else if same op "and" then "bvand"
              else if same op "or" then "bvor"
              else if same op "xor" then "bvxor"
              else op in
        string-concat-all ["(", smt-op, " ", smt-expr a g, " ", smt-expr b g, ")"]
      NBvCmp op w a b ->
        if same op "eq" then string-concat-all ["(= ", smt-expr a g, " ", smt-expr b g, ")"]
        else if same op "ne" then string-concat-all ["(not (= ", smt-expr a g, " ", smt-expr b g, "))"]
        else string-concat-all ["(bv", op, " ", smt-expr a g, " ", smt-expr b g, ")"]
      NBvCast op fw tw a ->
        if same op "zext" && tw > fw then
          string-concat-all ["((_ zero_extend ", nat-to-string (saturating-sub tw fw), ") ", smt-expr a g, ")"]
        else if same op "sext" && tw > fw then
          string-concat-all ["((_ sign_extend ", nat-to-string (saturating-sub tw fw), ") ", smt-expr a g, ")"]
        else if same op "trunc" && tw < fw then
          string-concat-all ["((_ extract ", nat-to-string (saturating-sub tw 1), " 0) ", smt-expr a g, ")"]
        else smt-expr a g
      NBvExtract hi lo a ->
        string-concat-all ["((_ extract ", nat-to-string hi, " ", nat-to-string lo, ") ", smt-expr a g, ")"]
      NBvConcat hi lo ->
        string-concat-all ["(concat ", smt-expr hi g, " ", smt-expr lo g, ")"]
      NFpBin op w a b ->
        let fop =
              if same op "fadd" then "fp.add RNE"
              else if same op "fsub" then "fp.sub RNE"
              else if same op "fmul" then "fp.mul RNE"
              else if same op "fdiv" then "fp.div RNE"
              else "fp.rem" in
        string-concat-all ["(", fop, " ", smt-expr a g, " ", smt-expr b g, ")"]
      NFpUn op w a ->
        if string-starts-with "@llvm.fabs." op then string-concat-all ["(fp.abs ", smt-expr a g, ")"]
        else string-concat-all ["(fp.neg ", smt-expr a g, ")"]
      NFpPred op w a ->
        if same op "isNaN" then string-concat-all ["(fp.isNaN ", smt-expr a g, ")"]
        else string-concat-all ["(and (not (fp.isNaN ", smt-expr a g, ")) (not (fp.isInfinite ", smt-expr a g, ")))"]
      other -> serialize-sem id g

  obligation-to-smtlib2 :: SemGraph -> Nat -> List (Nat, SemType, String) -> String
  obligation-to-smtlib2 g goal vars =
    let logic = if graph-has-fp g then "QF_FPBV" else "QF_BV" in
    let header = Cons (string-concat-all ["(set-logic ", logic, ")"]) (smt-decls vars) in
    let body = Cons (string-concat-all ["(assert (not ", smt-expr goal g, "))"]) (Cons "(check-sat)" Nil) in
    join-str "\n" (header <> body)

  -- ==========================================================================
  -- 7. Deterministic Tseitin Bit-Blaster (SemGraph -> CNF + Var Map)
  -- ==========================================================================

  -- Literal representation: nonzero Int (+v = positive var v, -v = negated var v).
  -- Var 1 is fixed True by clause #1: [1]. So `lit-true = 1`, `lit-false = -1`.

  lit-true :: Int
  lit-true = 1

  lit-false :: Int
  lit-false = -1

  lit-neg :: Int -> Int
  lit-neg l = 0 - l

  lit-var :: Int -> Nat
  lit-var l = if l >= 0 then nat-from-int l else nat-from-int (0 - l)

  lit-pos :: Int -> Bool
  lit-pos l = l > 0

  lit-code :: Int -> Nat
  lit-code l = if l >= 0 then nat-from-int l * 2 else nat-from-int (0 - l) * 2 + 1

  -- Tseitin bit-blaster state with AIG-style structural hash caches
  -- (Böving et al., Lean 4 `bv_decide` 2024; Mishchenko et al., DAC 2006;
  -- Brummayer & Biere, Boolector 2009). Every gate variable `z` is strictly
  -- greater than its inputs' variables, preserving reverse-topological cone filtering.
  data BlastState where
    MkBlastState :: Nat -> Nat -> List (Nat, List Int) -> NatMap (List Int) -> List (Nat, String, List Int) -> NatMap (NatMap Int) -> NatMap (NatMap Int) -> NatMap (NatMap (NatMap Int)) -> BlastState
    -- next-var, next-cid, clauses (reversed), node-id -> bit-lits (LSB first),
    -- var-bits (param-idx, name, lits), and-cache, xor-cache, ite-cache

  init-blast-state :: BlastState
  init-blast-state = MkBlastState 2 2 (Cons (1, Cons lit-true Nil) Nil) nm-empty Nil nm-empty nm-empty nm-empty

  bb-fresh-var :: BlastState -> (Int, BlastState)
  bb-fresh-var st = case st of
    MkBlastState nv nc cs memo vbits ac xc ic ->
      (nat-to-int nv, MkBlastState (nv + 1) nc cs memo vbits ac xc ic)

  bb-add-clause :: List Int -> BlastState -> BlastState
  bb-add-clause lits st = case st of
    MkBlastState nv nc cs memo vbits ac xc ic ->
      MkBlastState nv (nc + 1) (Cons (nc, lits) cs) memo vbits ac xc ic

  bb-and :: Int -> Int -> BlastState -> (Int, BlastState)
  bb-and a b st =
    if a == lit-false || b == lit-false then (lit-false, st)
    else if a == lit-true then (b, st)
    else if b == lit-true then (a, st)
    else if a == b then (a, st)
    else if a == lit-neg b then (lit-false, st)
    else
      let ca = lit-code a in
      let cb = lit-code b in
      let (k1, k2, la, lb) = if ca <= cb then (ca, cb, a, b) else (cb, ca, b, a) in
      case st of
        MkBlastState nv nc cs memo vbits ac xc ic ->
          case nm2-lookup k1 k2 ac of
            Some cached -> (cached, st)
            None ->
              let (z, st1) = bb-fresh-var st in
              let st2 = bb-add-clause [lit-neg z, la] st1 in
              let st3 = bb-add-clause [lit-neg z, lb] st2 in
              let st4 = bb-add-clause [z, lit-neg la, lit-neg lb] st3 in
              case st4 of
                MkBlastState nv4 nc4 cs4 memo4 vbits4 ac4 xc4 ic4 ->
                  (z, MkBlastState nv4 nc4 cs4 memo4 vbits4 (nm2-insert k1 k2 z ac4) xc4 ic4)

  -- De Morgan lowering (`a | b == !(!a & !b)`) shares subcircuits in `and-cache`.
  bb-or :: Int -> Int -> BlastState -> (Int, BlastState)
  bb-or a b st =
    let (neg, st1) = bb-and (lit-neg a) (lit-neg b) st in
    (lit-neg neg, st1)

  bb-xor :: Int -> Int -> BlastState -> (Int, BlastState)
  bb-xor a b st =
    if a == lit-false then (b, st)
    else if b == lit-false then (a, st)
    else if a == lit-true then (lit-neg b, st)
    else if b == lit-true then (lit-neg a, st)
    else if a == b then (lit-false, st)
    else if a == lit-neg b then (lit-true, st)
    else
      let flip = (a < 0) /= (b < 0) in
      let va = lit-var a in
      let vb = lit-var b in
      let (k1, k2) = if va <= vb then (va, vb) else (vb, va) in
      let pa = nat-to-int k1 in
      let pb = nat-to-int k2 in
      case st of
        MkBlastState nv nc cs memo vbits ac xc ic ->
          case nm2-lookup k1 k2 xc of
            Some cached -> (if flip then lit-neg cached else cached, st)
            None ->
              let (z, st1) = bb-fresh-var st in
              let st2 = bb-add-clause [lit-neg z, pa, pb] st1 in
              let st3 = bb-add-clause [lit-neg z, lit-neg pa, lit-neg pb] st2 in
              let st4 = bb-add-clause [z, lit-neg pa, pb] st3 in
              let st5 = bb-add-clause [z, pa, lit-neg pb] st4 in
              case st5 of
                MkBlastState nv5 nc5 cs5 memo5 vbits5 ac5 xc5 ic5 ->
                  let out = if flip then lit-neg z else z in
                  (out, MkBlastState nv5 nc5 cs5 memo5 vbits5 ac5 (nm2-insert k1 k2 z xc5) ic5)

  bb-eq :: Int -> Int -> BlastState -> (Int, BlastState)
  bb-eq a b st =
    let (x, st1) = bb-xor a b st in (lit-neg x, st1)

  bb-ite :: Int -> Int -> Int -> BlastState -> (Int, BlastState)
  bb-ite c t e st =
    if c == lit-true then (t, st)
    else if c == lit-false then (e, st)
    else if t == e then (t, st)
    else if t == lit-true || c == t then bb-or c e st
    else if t == lit-false || c == lit-neg t then bb-and (lit-neg c) e st
    else if e == lit-true || c == lit-neg e then bb-or (lit-neg c) t st
    else if e == lit-false || c == e then bb-and c t st
    else if t == lit-neg e then bb-eq c t st
    else
      let (cc, tt, ee) = if c < 0 then (lit-neg c, e, t) else (c, t, e) in
      let (flip, nt, ne) = if tt < 0 then (True, lit-neg tt, lit-neg ee) else (False, tt, ee) in
      let k1 = lit-var cc in
      let k2 = lit-code nt in
      let k3 = lit-code ne in
      case st of
        MkBlastState nv nc cs memo vbits ac xc ic ->
          case nm3-lookup k1 k2 k3 ic of
            Some cached -> (if flip then lit-neg cached else cached, st)
            None ->
              let (z, st1) = bb-fresh-var st in
              let st2 = bb-add-clause [lit-neg cc, lit-neg z, nt] st1 in
              let st3 = bb-add-clause [lit-neg cc, z, lit-neg nt] st2 in
              let st4 = bb-add-clause [cc, lit-neg z, ne] st3 in
              let st5 = bb-add-clause [cc, z, lit-neg ne] st4 in
              case st5 of
                MkBlastState nv5 nc5 cs5 memo5 vbits5 ac5 xc5 ic5 ->
                  let out = if flip then lit-neg z else z in
                  (out, MkBlastState nv5 nc5 cs5 memo5 vbits5 ac5 xc5 (nm3-insert k1 k2 k3 z ic5))

  bb-const-bits-pair :: Nat -> U64 -> U64 -> List Int
  bb-const-bits-pair w lo hi = bb-const-bits-pair-loop w 0 lo hi

  bb-const-bits-pair-loop :: Nat -> Nat -> U64 -> U64 -> List Int
  bb-const-bits-pair-loop w i lo hi =
    if i >= w then Nil
    else
      let bit =
            if i < 64 then not (eq-u64 (bit-and-u64 (wrapping-shr-u64 lo (nat-u32 i)) 1) 0)
            else if i < 128 then not (eq-u64 (bit-and-u64 (wrapping-shr-u64 hi (nat-u32 (saturating-sub i 64))) 1) 0)
            else False in
      Cons (if bit then lit-true else lit-false) (bb-const-bits-pair-loop w (i + 1) lo hi)

  bb-const-bits :: Nat -> U64 -> List Int
  bb-const-bits w v = bb-const-bits-pair w v 0

  bb-fresh-bits :: Nat -> BlastState -> (List Int, BlastState)
  bb-fresh-bits w st =
    if w == 0 then (Nil, st)
    else
      let (v, st1) = bb-fresh-var st in
      let (rest, st2) = bb-fresh-bits (saturating-sub w 1) st1 in
      (Cons v rest, st2)

  bb-zip-map :: (Int -> Int -> BlastState -> (Int, BlastState)) -> List Int -> List Int -> BlastState -> (List Int, BlastState)
  bb-zip-map f xs ys st = case (xs, ys) of
    (Cons x xr, Cons y yr) ->
      let (z, st1) = f x y st in
      let (zs, st2) = bb-zip-map f xr yr st1 in
      (Cons z zs, st2)
    other -> (Nil, st)

  bb-ite-vec :: Int -> List Int -> List Int -> BlastState -> (List Int, BlastState)
  bb-ite-vec c ts es st = case (ts, es) of
    (Cons t tr, Cons e er) ->
      let (z, st1) = bb-ite c t e st in
      let (zs, st2) = bb-ite-vec c tr er st1 in
      (Cons z zs, st2)
    other -> (Nil, st)

  bb-add-ripple :: List Int -> List Int -> Int -> BlastState -> (List Int, Int, BlastState)
  bb-add-ripple xs ys cin st = case (xs, ys) of
    (Cons x xr, Cons y yr) ->
      let (ab, st1) = bb-xor x y st in
      let (s, st2) = bb-xor ab cin st1 in
      let (c1, st3) = bb-and x y st2 in
      let (c2, st4) = bb-and ab cin st3 in
      let (cout, st5) = bb-or c1 c2 st4 in
      case bb-add-ripple xr yr cout st5 of
        (ss, final-c, st6) -> (Cons s ss, final-c, st6)
    other -> (Nil, cin, st)

  bb-neg-bits :: List Int -> List Int
  bb-neg-bits xs = case xs of
    Nil -> Nil
    Cons x rest -> Cons (lit-neg x) (bb-neg-bits rest)

  bb-vec-eq :: List Int -> List Int -> BlastState -> (Int, BlastState)
  bb-vec-eq xs ys st = case (xs, ys) of
    (Nil, Nil) -> (lit-true, st)
    (Cons x xr, Cons y yr) ->
      let (e, st1) = bb-eq x y st in
      let (er, st2) = bb-vec-eq xr yr st1 in
      bb-and e er st2
    other -> (lit-false, st)

  bb-vec-ult :: List Int -> List Int -> BlastState -> (Int, BlastState)
  bb-vec-ult xs ys st =
    -- a < b unsigned <=> carry-out of (a + ~b + 1) is 0
    case bb-add-ripple xs (bb-neg-bits ys) lit-true st of
      (diff, cout, st1) -> (lit-neg cout, st1)

  last-bit :: List Int -> Int
  last-bit xs = case xs of
    Nil -> lit-false
    Cons x Nil -> x
    Cons x rest -> last-bit rest

  flip-msb :: List Int -> List Int
  flip-msb xs = case xs of
    Nil -> Nil
    Cons x Nil -> Cons (lit-neg x) Nil
    Cons x rest -> Cons x (flip-msb rest)

  bb-vec-slt :: List Int -> List Int -> BlastState -> (Int, BlastState)
  bb-vec-slt xs ys st = bb-vec-ult (flip-msb xs) (flip-msb ys) st

  take-bits :: Nat -> List Int -> List Int
  take-bits n xs =
    if n == 0 then Nil
    else case xs of
      Nil -> Nil
      Cons x rest -> Cons x (take-bits (saturating-sub n 1) rest)

  drop-bits :: Nat -> List Int -> List Int
  drop-bits n xs =
    if n == 0 then xs
    else case xs of
      Nil -> Nil
      Cons x rest -> drop-bits (saturating-sub n 1) rest

  repeat-bit :: Nat -> Int -> List Int
  repeat-bit n b = if n == 0 then Nil else Cons b (repeat-bit (saturating-sub n 1) b)

  shift-left-const :: Nat -> Nat -> List Int -> List Int
  shift-left-const w amt xs =
    if amt >= w then repeat-bit w lit-false
    else take-bits w (repeat-bit amt lit-false <> xs)

  shift-right-const :: Bool -> Nat -> Nat -> List Int -> List Int
  shift-right-const arith w amt xs =
    let fill = if arith then last-bit xs else lit-false in
    if amt >= w then repeat-bit w fill
    else take-bits w (drop-bits amt xs <> repeat-bit amt fill)

  -- Barrel shifter for dynamic shift amount (uses log2(w) stages).
  bb-barrel-shift :: String -> Nat -> List Int -> List Int -> Nat -> Nat -> BlastState -> (List Int, BlastState)
  bb-barrel-shift kind w cur amt-bits step bit-idx st =
    if step >= w then (cur, st)
    else case amt-bits of
      Nil -> (cur, st)
      Cons sb rest ->
        let shifted =
              if same kind "shl" then shift-left-const w step cur
              else if same kind "ashr" then shift-right-const True w step cur
              else shift-right-const False w step cur in
        let (next, st1) = bb-ite-vec sb shifted cur st in
        bb-barrel-shift kind w next rest (step * 2) (bit-idx + 1) st1

  -- Check if any bit above log2(w) in shift amount is nonzero; if so, full shift.
  bb-any-bit :: List Int -> BlastState -> (Int, BlastState)
  bb-any-bit xs st = case xs of
    Nil -> (lit-false, st)
    Cons x rest ->
      let (r, st1) = bb-any-bit rest st in bb-or x r st1

  bb-shift :: String -> Nat -> List Int -> List Int -> BlastState -> (List Int, BlastState)
  bb-shift kind w xs ys st =
    let (res1, st1) = bb-barrel-shift kind w xs ys 1 0 st in
    let (w-bits, st2) = (bb-const-bits w (nat-u64 w), st1) in
    let (ge-w, st3) = bb-vec-ult ys w-bits st2 in
    let fill = if same kind "ashr" then last-bit xs else lit-false in
    bb-ite-vec ge-w res1 (repeat-bit w fill) st3

  -- Schoolbook shift-and-add multiplier skipping constant-zero multiplier bits.
  bb-mul-loop :: Nat -> Nat -> List Int -> List Int -> List Int -> BlastState -> (List Int, BlastState)
  bb-mul-loop w i xs ys acc st = case ys of
    Nil -> (acc, st)
    Cons yb yrest ->
      if yb == lit-false then bb-mul-loop w (i + 1) xs yrest acc st
      else
        let partial = shift-left-const w i xs in
        let (gated, st1) = bb-ite-vec yb partial (repeat-bit w lit-false) st in
        case bb-add-ripple acc gated lit-false st1 of
          (next-acc, cout, st2) -> bb-mul-loop w (i + 1) xs yrest next-acc st2

  bb-bswap :: Nat -> List Int -> List Int
  bb-bswap w xs =
    if w <= 8 then xs
    else bb-bswap (saturating-sub w 8) (drop-bits 8 xs) <> take-bits 8 xs

  -- Add two bitvectors (padding shorter with false) and append the carry-out bit.
  bb-add-wide :: List Int -> List Int -> Int -> BlastState -> (List Int, BlastState)
  bb-add-wide xs ys cin st = case (xs, ys) of
    (Nil, Nil) -> ([cin], st)
    (Cons x xr, Nil) ->
      let (s, st1) = bb-xor x cin st in
      let (c, st2) = bb-and x cin st1 in
      let (rest, st3) = bb-add-wide xr Nil c st2 in
      (Cons s rest, st3)
    (Nil, Cons y yr) ->
      let (s, st1) = bb-xor y cin st in
      let (c, st2) = bb-and y cin st1 in
      let (rest, st3) = bb-add-wide Nil yr c st2 in
      (Cons s rest, st3)
    (Cons x xr, Cons y yr) ->
      let (ab, st1) = bb-xor x y st in
      let (s, st2) = bb-xor ab cin st1 in
      let (c1, st3) = bb-and x y st2 in
      let (c2, st4) = bb-and ab cin st3 in
      let (cout, st5) = bb-or c1 c2 st4 in
      let (rest, st6) = bb-add-wide xr yr cout st5 in
      (Cons s rest, st6)

  bb-ctpop-init :: List Int -> List (List Int)
  bb-ctpop-init xs = case xs of
    Nil -> Nil
    Cons b rest -> Cons [b] (bb-ctpop-init rest)

  bb-ctpop-pair :: List (List Int) -> BlastState -> (List (List Int), BlastState)
  bb-ctpop-pair layer st = case layer of
    Nil -> (Nil, st)
    Cons single Nil -> (Cons single Nil, st)
    Cons a (Cons b rest) ->
      let (sum, st1) = bb-add-wide a b lit-false st in
      let (more, st2) = bb-ctpop-pair rest st1 in
      (Cons sum more, st2)

  bb-ctpop-reduce :: List (List Int) -> BlastState -> (List Int, BlastState)
  bb-ctpop-reduce layer st = case layer of
    Nil -> (Nil, st)
    Cons only Nil -> (only, st)
    other ->
      let (next, st1) = bb-ctpop-pair layer st in
      bb-ctpop-reduce next st1

  pad-bits-to :: Nat -> List Int -> List Int
  pad-bits-to w xs =
    if w == 0 then Nil
    else case xs of
      Nil -> repeat-bit w lit-false
      Cons b rest -> Cons b (pad-bits-to (saturating-sub w 1) rest)

  -- Balanced binary adder-tree population count (O(w) 1-bit adders total).
  bb-ctpop :: Nat -> List Int -> BlastState -> (List Int, BlastState)
  bb-ctpop w xs st =
    if w == 0 then (Nil, st)
    else
      let (sum, st1) = bb-ctpop-reduce (bb-ctpop-init xs) st in
      (pad-bits-to w sum, st1)

  bb-cttz-from :: Nat -> Nat -> List Int -> BlastState -> (List Int, BlastState)
  bb-cttz-from w idx xs st = case xs of
    Nil -> (bb-const-bits w (nat-u64 w), st)
    Cons b rest ->
      let (more, st1) = bb-cttz-from w (idx + 1) rest st in
      bb-ite-vec b (bb-const-bits w (nat-u64 idx)) more st1

  bb-node :: Nat -> SemGraph -> BlastState -> Result String (List Int, BlastState)
  bb-node id g st = case st of
    MkBlastState nv nc cs memo vbits ac xc ic ->
      case nm-lookup id memo of
        Some cached -> Ok (cached, st)
        None -> case graph-node id g of
          None -> Err "missing semantic node during bit-blasting"
          Some node -> case bb-node-uncached node g st of
            Err e -> Err e
            Ok (bits, st1) -> case st1 of
              MkBlastState nv1 nc1 cs1 memo1 vbits1 ac1 xc1 ic1 ->
                Ok (bits, MkBlastState nv1 nc1 cs1 (nm-insert id bits memo1) vbits1 ac1 xc1 ic1)

  bb-node-uncached :: SemNode -> SemGraph -> BlastState -> Result String (List Int, BlastState)
  bb-node-uncached node g st = case node of
    NBoolConst b -> Ok ([if b then lit-true else lit-false], st)
    NBvConst w lo hi -> Ok (bb-const-bits-pair w lo hi, st)
    NVar idx ty nm ->
      let w = sem-type-width ty in
      let (bits, st1) = bb-fresh-bits w st in
      case st1 of
        MkBlastState nv nc cs memo vbits ac xc ic ->
          Ok (bits, MkBlastState nv nc cs memo (Cons (idx, nm, bits) vbits) ac xc ic)
    NNot a -> case bb-node a g st of
      Err e -> Err e
      Ok (Cons la Nil, st1) -> Ok ([lit-neg la], st1)
      other -> Err "NNot expects 1-bit operand"
    NAnd a b -> case bb-node a g st of
      Err e -> Err e
      Ok (Cons la Nil, st1) -> case bb-node b g st1 of
        Err e -> Err e
        Ok (Cons lb Nil, st2) -> let (r, st3) = bb-and la lb st2 in Ok ([r], st3)
        other -> Err "NAnd expects 1-bit rhs"
      other -> Err "NAnd expects 1-bit lhs"
    NOr a b -> case bb-node a g st of
      Err e -> Err e
      Ok (Cons la Nil, st1) -> case bb-node b g st1 of
        Err e -> Err e
        Ok (Cons lb Nil, st2) -> let (r, st3) = bb-or la lb st2 in Ok ([r], st3)
        other -> Err "NOr expects 1-bit rhs"
      other -> Err "NOr expects 1-bit lhs"
    NXor a b -> case bb-node a g st of
      Err e -> Err e
      Ok (Cons la Nil, st1) -> case bb-node b g st1 of
        Err e -> Err e
        Ok (Cons lb Nil, st2) -> let (r, st3) = bb-xor la lb st2 in Ok ([r], st3)
        other -> Err "NXor expects 1-bit rhs"
      other -> Err "NXor expects 1-bit lhs"
    NImplies a b -> case bb-node a g st of
      Err e -> Err e
      Ok (Cons la Nil, st1) -> case bb-node b g st1 of
        Err e -> Err e
        Ok (Cons lb Nil, st2) -> let (r, st3) = bb-or (lit-neg la) lb st2 in Ok ([r], st3)
        other -> Err "NImplies expects 1-bit rhs"
      other -> Err "NImplies expects 1-bit lhs"
    NEqBool a b -> case bb-node a g st of
      Err e -> Err e
      Ok (Cons la Nil, st1) -> case bb-node b g st1 of
        Err e -> Err e
        Ok (Cons lb Nil, st2) -> let (r, st3) = bb-eq la lb st2 in Ok ([r], st3)
        other -> Err "NEqBool expects 1-bit rhs"
      other -> Err "NEqBool expects 1-bit lhs"
    NIte c t e -> case bb-node c g st of
      Err err -> Err err
      Ok (Cons lc Nil, st1) -> case bb-node t g st1 of
        Err err -> Err err
        Ok (lt, st2) -> case bb-node e g st2 of
          Err err -> Err err
          Ok (le, st3) -> Ok (bb-ite-vec lc lt le st3)
      other -> Err "NIte expects 1-bit condition"
    NBvUn op w a -> case bb-node a g st of
      Err e -> Err e
      Ok (la, st1) ->
        if same op "bswap" then Ok (bb-bswap w la, st1)
        else if same op "bitreverse" then Ok (reverse la, st1)
        else if same op "ctpop" then Ok (bb-ctpop w la st1)
        else if same op "cttz" then Ok (bb-cttz-from w 0 la st1)
        else if same op "ctlz" then Ok (bb-cttz-from w 0 (reverse la) st1)
        else Err (string-concat "unsupported unary bv op in bit-blaster: " op)
    NBvBin op w a b -> case bb-node a g st of
      Err e -> Err e
      Ok (la, st1) -> case bb-node b g st1 of
        Err e -> Err e
        Ok (lb, st2) ->
          if same op "add" then
            case bb-add-ripple la lb lit-false st2 of (s, c, st3) -> Ok (s, st3)
          else if same op "sub" then
            case bb-add-ripple la (bb-neg-bits lb) lit-true st2 of (s, c, st3) -> Ok (s, st3)
          else if same op "and" then Ok (bb-zip-map bb-and la lb st2)
          else if same op "or" then Ok (bb-zip-map bb-or la lb st2)
          else if same op "xor" then Ok (bb-zip-map bb-xor la lb st2)
          else if same op "shl" || same op "lshr" || same op "ashr" then Ok (bb-shift op w la lb st2)
          else if same op "mul" && w <= 64 then Ok (bb-mul-loop w 0 la lb (repeat-bit w lit-false) st2)
          else if same op "umin" then
            let (lt, st3) = bb-vec-ult la lb st2 in Ok (bb-ite-vec lt la lb st3)
          else if same op "umax" then
            let (lt, st3) = bb-vec-ult la lb st2 in Ok (bb-ite-vec lt lb la st3)
          else if same op "smin" then
            let (lt, st3) = bb-vec-slt la lb st2 in Ok (bb-ite-vec lt la lb st3)
          else if same op "smax" then
            let (lt, st3) = bb-vec-slt la lb st2 in Ok (bb-ite-vec lt lb la st3)
          else if same op "uadd_sat" then
            case bb-add-ripple la lb lit-false st2 of
              (sum, cout, st3) -> Ok (bb-ite-vec cout (repeat-bit w lit-true) sum st3)
          else if same op "usub_sat" then
            case bb-add-ripple la (bb-neg-bits lb) lit-true st2 of
              (diff, cout, st3) -> Ok (bb-ite-vec cout diff (repeat-bit w lit-false) st3)
          else if same op "sadd_sat" then
            case bb-add-ripple la lb lit-false st2 of
              (sum, cout, st3) ->
                let sa = last-bit la in
                let sb = last-bit lb in
                let sr = last-bit sum in
                let (same-in, st4) = bb-eq sa sb st3 in
                let (diff-out, st5) = bb-xor sa sr st4 in
                let (ov, st6) = bb-and same-in diff-out st5 in
                let smin-bits = bb-const-bits w (u64-sign-bit w) in
                let smax-bits = bb-const-bits w (wrapping-sub-u64 (u64-sign-bit w) 1) in
                let (clamped, st7) = bb-ite-vec sa smin-bits smax-bits st6 in
                Ok (bb-ite-vec ov clamped sum st7)
          else if same op "ssub_sat" then
            case bb-add-ripple la (bb-neg-bits lb) lit-true st2 of
              (diff, cout, st3) ->
                let sa = last-bit la in
                let sb = last-bit lb in
                let sr = last-bit diff in
                let (diff-in, st4) = bb-xor sa sb st3 in
                let (diff-out, st5) = bb-xor sa sr st4 in
                let (ov, st6) = bb-and diff-in diff-out st5 in
                let smin-bits = bb-const-bits w (u64-sign-bit w) in
                let smax-bits = bb-const-bits w (wrapping-sub-u64 (u64-sign-bit w) 1) in
                let (clamped, st7) = bb-ite-vec sa smin-bits smax-bits st6 in
                Ok (bb-ite-vec ov clamped diff st7)
          else Err (string-concat "requires external SMT solver for bv op: " op)
    NBvCmp pred w a b -> case bb-node a g st of
      Err e -> Err e
      Ok (la, st1) -> case bb-node b g st1 of
        Err e -> Err e
        Ok (lb, st2) ->
          if same pred "eq" then let (r, st3) = bb-vec-eq la lb st2 in Ok ([r], st3)
          else if same pred "ne" then let (r, st3) = bb-vec-eq la lb st2 in Ok ([lit-neg r], st3)
          else if same pred "ult" then let (r, st3) = bb-vec-ult la lb st2 in Ok ([r], st3)
          else if same pred "ugt" then let (r, st3) = bb-vec-ult lb la st2 in Ok ([r], st3)
          else if same pred "ule" then let (r, st3) = bb-vec-ult lb la st2 in Ok ([lit-neg r], st3)
          else if same pred "uge" then let (r, st3) = bb-vec-ult la lb st2 in Ok ([lit-neg r], st3)
          else if same pred "slt" then let (r, st3) = bb-vec-slt la lb st2 in Ok ([r], st3)
          else if same pred "sgt" then let (r, st3) = bb-vec-slt lb la st2 in Ok ([r], st3)
          else if same pred "sle" then let (r, st3) = bb-vec-slt lb la st2 in Ok ([lit-neg r], st3)
          else if same pred "sge" then let (r, st3) = bb-vec-slt la lb st2 in Ok ([lit-neg r], st3)
          else Err (string-concat "unsupported icmp predicate " pred)
    NBvCast op fw tw a -> case bb-node a g st of
      Err e -> Err e
      Ok (la, st1) ->
        if same op "trunc" || tw < fw then Ok (take-bits tw la, st1)
        else if same op "zext" then Ok (la <> repeat-bit (saturating-sub tw fw) lit-false, st1)
        else if same op "sext" then Ok (la <> repeat-bit (saturating-sub tw fw) (last-bit la), st1)
        else Ok (la, st1)
    NBvExtract hi lo a -> case bb-node a g st of
      Err e -> Err e
      Ok (la, st1) -> Ok (take-bits (saturating-sub (hi + 1) lo) (drop-bits lo la), st1)
    NBvConcat hi lo -> case bb-node lo g st of
      Err e -> Err e
      Ok (lb, st1) -> case bb-node hi g st1 of
        Err e -> Err e
        Ok (la, st2) -> Ok (lb <> la, st2)
    NBvTri op w a b c -> Err (string-concat "requires external SMT solver for ternary op: " op)
    NFpCast op fw tw a ->
      if same op "bitcast" && fw == tw then bb-node a g st
      else Err (string-concat "floating-point cast requires an external SMT solver: " op)
    NFpUn op w a -> case bb-node a g st of
      Err e -> Err e
      Ok (la, st1) ->
        if same op "fneg" then Ok (bb-set-last-bit (lit-neg (last-bit la)) la, st1)
        else if string-starts-with "@llvm.fabs." op then Ok (bb-set-last-bit lit-false la, st1)
        else Err (string-concat "floating-point unary op requires an external SMT solver: " op)
    NFpBin op w a b ->
      if string-starts-with "@llvm.copysign." op then
        case bb-node a g st of
          Err e -> Err e
          Ok (la, st1) -> case bb-node b g st1 of
            Err e -> Err e
            Ok (lb, st2) -> Ok (bb-set-last-bit (last-bit lb) la, st2)
      else Err (string-concat "floating-point binary op requires an external SMT solver: " op)
    NFpPred op w a -> case bb-node a g st of
      Err e -> Err e
      Ok (la, st1) ->
        if same op "isNaN" then let (r, st2) = bb-fp-is-nan w la st1 in Ok ([r], st2)
        else if same op "isFinite" then let (r, st2) = bb-fp-is-finite w la st1 in Ok ([r], st2)
        else Err (string-concat "unsupported fp predicate: " op)
    NFpCmp pred w a b -> case bb-node a g st of
      Err e -> Err e
      Ok (la, st1) -> case bb-node b g st1 of
        Err e -> Err e
        Ok (lb, st2) -> let (r, st3) = bb-fp-cmp pred w la lb st2 in Ok ([r], st3)

  bb-set-last-bit :: Int -> List Int -> List Int
  bb-set-last-bit bit xs = case xs of
    Nil -> Nil
    Cons _ Nil -> Cons bit Nil
    Cons h t -> Cons h (bb-set-last-bit bit t)

  bb-all-bits :: List Int -> BlastState -> (Int, BlastState)
  bb-all-bits xs st = case xs of
    Nil -> (lit-true, st)
    Cons x rest ->
      let (r, st1) = bb-all-bits rest st in bb-and x r st1

  bb-fp-exp-all1 :: Nat -> List Int -> BlastState -> (Int, BlastState)
  bb-fp-exp-all1 w bits st =
    let (sig-w, exp-w) = if w == 32 then (23, 8) else (52, 11) in
    bb-all-bits (take-bits exp-w (drop-bits sig-w bits)) st

  bb-fp-is-nan :: Nat -> List Int -> BlastState -> (Int, BlastState)
  bb-fp-is-nan w bits st =
    let sig-w = if w == 32 then 23 else 52 in
    let (exp1, st1) = bb-fp-exp-all1 w bits st in
    let (sig-nz, st2) = bb-any-bit (take-bits sig-w bits) st1 in
    bb-and exp1 sig-nz st2

  bb-fp-is-finite :: Nat -> List Int -> BlastState -> (Int, BlastState)
  bb-fp-is-finite w bits st =
    let (exp1, st1) = bb-fp-exp-all1 w bits st in
    (lit-neg exp1, st1)

  bb-fp-cmp :: String -> Nat -> List Int -> List Int -> BlastState -> (Int, BlastState)
  bb-fp-cmp pred w la lb st =
    if same pred "false" then (lit-false, st)
    else if same pred "true" then (lit-true, st)
    else
      let (na, st1) = bb-fp-is-nan w la st in
      let (nb, st2) = bb-fp-is-nan w lb st1 in
      let (uno, st3) = bb-or na nb st2 in
      let ord = lit-neg uno in
      if same pred "ord" then (ord, st3)
      else if same pred "uno" then (uno, st3)
      else
        let mag-w = saturating-sub w 1 in
        let mag-a = take-bits mag-w la in
        let mag-b = take-bits mag-w lb in
        let sa = last-bit la in
        let sb = last-bit lb in
        let (nza, st4) = bb-any-bit mag-a st3 in
        let (nzb, st5) = bb-any-bit mag-b st4 in
        let (both-z, st6) = bb-and (lit-neg nza) (lit-neg nzb) st5 in
        let (bits-eq, st7) = bb-vec-eq la lb st6 in
        let (val-eq, st8) = bb-or both-z bits-eq st7 in
        let (mag-lt, st9) = bb-vec-ult mag-a mag-b st8 in
        let (mag-gt, st10) = bb-vec-ult mag-b mag-a st9 in
        let (an-bp, st11) = bb-and sa (lit-neg sb) st10 in
        let (np-lt, st12) = bb-and an-bp (lit-neg both-z) st11 in
        let (both-pos, st13) = bb-and (lit-neg sa) (lit-neg sb) st12 in
        let (bp-lt, st14) = bb-and both-pos mag-lt st13 in
        let (both-neg, st15) = bb-and sa sb st14 in
        let (bn-lt, st16) = bb-and both-neg mag-gt st15 in
        let (t1, st17) = bb-or np-lt bp-lt st16 in
        let (val-lt, st18) = bb-or t1 bn-lt st17 in
        let (val-le, st19) = bb-or val-lt val-eq st18 in
        let val-gt = lit-neg val-le in
        let val-ge = lit-neg val-lt in
        let val-ne = lit-neg val-eq in
        if same pred "oeq" then bb-and ord val-eq st19
        else if same pred "ogt" then bb-and ord val-gt st19
        else if same pred "oge" then bb-and ord val-ge st19
        else if same pred "olt" then bb-and ord val-lt st19
        else if same pred "ole" then bb-and ord val-le st19
        else if same pred "one" then bb-and ord val-ne st19
        else if same pred "ueq" then bb-or uno val-eq st19
        else if same pred "ugt" then bb-or uno val-gt st19
        else if same pred "uge" then bb-or uno val-ge st19
        else if same pred "ult" then bb-or uno val-lt st19
        else if same pred "ule" then bb-or uno val-le st19
        else bb-or uno val-ne st19

  -- ==========================================================================
  -- 8. Built-in SAT Solver emitting `lrat/v1` + Independent `verify-lrat` Kernel
  -- ==========================================================================

  data LratStep where
    LratAdd :: Nat -> List Int -> List Nat -> LratStep

  -- Independent LRAT RUP Proof Checker (`cinch-kernel-lrat@1`).
  -- This function has ZERO dependency on the SAT prover; it replays each
  -- proof step from the original CNF clauses and checks that every hint
  -- unit-propagates cleanly to a conflict, ending with the empty clause.
  verify-lrat :: Nat -> List (Nat, List Int) -> List LratStep -> Result String Unit
  verify-lrat max-var orig-clauses steps =
    let db = build-clause-db orig-clauses nm-empty in
    verify-lrat-steps db steps False

  build-clause-db :: List (Nat, List Int) -> NatMap (List Int) -> NatMap (List Int)
  build-clause-db cs db = case cs of
    Nil -> db
    Cons (cid, lits) rest -> build-clause-db rest (nm-insert cid lits db)

  -- Assign literal `l` to True (+1 for pos, -1 for neg) in assignment map.
  assign-lit-val :: Int -> NatMap Int -> NatMap Int
  assign-lit-val l m = nm-insert (lit-var l) (if lit-pos l then 1 else -1) m

  eval-lit :: Int -> NatMap Int -> Int
  eval-lit l m = case nm-lookup (lit-var l) m of
    None -> 0
    Some v -> if lit-pos l then v else (0 - v)

  assume-negated-clause :: List Int -> NatMap Int -> NatMap Int
  assume-negated-clause lits m = case lits of
    Nil -> m
    Cons l rest -> assume-negated-clause rest (assign-lit-val (lit-neg l) m)

  data ClauseEval where
    CETrue :: ClauseEval
    CEConflict :: ClauseEval
    CEUnit :: Int -> ClauseEval
    CEUnresolved :: ClauseEval

  eval-clause :: List Int -> NatMap Int -> Option Int -> ClauseEval
  eval-clause lits assign unassigned = case lits of
    Nil -> case unassigned of
      None -> CEConflict
      Some u -> CEUnit u
    Cons l rest ->
      let v = eval-lit l assign in
      if v == 1 then CETrue
      else if v == -1 then eval-clause rest assign unassigned
      else case unassigned of
        None -> eval-clause rest assign (Some l)
        Some prev -> CEUnresolved

  check-rup-hints :: NatMap (List Int) -> List Nat -> NatMap Int -> Result String Unit
  check-rup-hints db hints assign = case hints of
    Nil -> Err "LRAT RUP hint list ended without reaching a conflict"
    Cons hid rest -> case nm-lookup hid db of
      None -> Err (string-concat "LRAT references unknown clause id " (nat-to-string hid))
      Some clause -> case eval-clause clause assign None of
        CEConflict -> Ok ()
        CEUnit u -> check-rup-hints db rest (assign-lit-val u assign)
        CETrue -> Err (string-concat "LRAT hint clause already satisfied: " (nat-to-string hid))
        CEUnresolved -> Err (string-concat "LRAT hint clause is not unit: " (nat-to-string hid))

  verify-lrat-steps :: NatMap (List Int) -> List LratStep -> Bool -> Result String Unit
  verify-lrat-steps db steps derived-empty = case steps of
    Nil -> if derived-empty then Ok () else Err "LRAT proof did not derive the empty clause"
    Cons (LratAdd cid lits hints) rest ->
      let init-assign = assume-negated-clause lits nm-empty in
      case check-rup-hints db hints init-assign of
        Err e -> Err e
        Ok done ->
          let is-empty = case lits of Nil -> True; other -> False in
          verify-lrat-steps (nm-insert cid lits db) rest (derived-empty || is-empty)

  serialize-lrat-steps :: List LratStep -> String
  serialize-lrat-steps steps = case steps of
    Nil -> ""
    Cons (LratAdd cid lits hints) rest ->
      string-concat-all [nat-to-string cid, " ", join-int lits, " 0 ", join-nat hints, " 0\n", serialize-lrat-steps rest]

  parse-signed-int :: String -> Option Int
  parse-signed-int tok =
    if string-starts-with "-" tok && string-length tok > 1 then
      case parse-nat-str (string-slice tok 1 (string-length tok)) of
        Some n -> Some (0 - nat-to-int n)
        None -> None
    else case parse-nat-str tok of
      Some n -> Some (nat-to-int n)
      None -> None

  parse-lrat-lits :: List String -> Result String (List Int, List String)
  parse-lrat-lits ws = case ws of
    Nil -> Err "LRAT line missing 0 terminator after literals"
    Cons "0" rest -> Ok (Nil, rest)
    Cons w rest ->
      case parse-signed-int w of
        None -> Err (string-concat "invalid LRAT literal " w)
        Some l -> case parse-lrat-lits rest of
          Err e -> Err e
          Ok (more, tail) -> Ok (Cons l more, tail)

  parse-lrat-hints :: List String -> Result String (List Nat)
  parse-lrat-hints ws = case ws of
    Nil -> Err "LRAT line missing 0 terminator after hints"
    Cons "0" rest -> Ok Nil
    Cons w rest ->
      case parse-nat-str w of
        None -> Err (string-concat "invalid LRAT hint id " w)
        Some hid -> case parse-lrat-hints rest of
          Err e -> Err e
          Ok more -> Ok (Cons hid more)

  parse-lrat-lines :: List String -> Result String (List LratStep)
  parse-lrat-lines lines = case lines of
    Nil -> Ok Nil
    Cons raw rest ->
      let ws = string-words (string-strip raw) in
      case ws of
        Nil -> parse-lrat-lines rest
        Cons cid-str tail ->
          (case parse-nat-str cid-str of
            None -> Err (string-concat "invalid LRAT clause id " cid-str)
            Some cid ->
              (case tail of
                Cons "d" del-rest -> parse-lrat-lines rest
                other ->
                  (case parse-lrat-lits tail of
                    Err e -> Err e
                    Ok (lits, after-lits) ->
                      (case parse-lrat-hints after-lits of
                        Err e -> Err e
                        Ok hints ->
                          (case parse-lrat-lines rest of
                            Err e -> Err e
                            Ok more -> Ok (Cons (LratAdd cid lits hints) more))))))

  parse-lrat-steps :: String -> Result String (List LratStep)
  parse-lrat-steps txt = parse-lrat-lines (string-split-on "\n" txt)

  verify-lrat-text :: Nat -> List (Nat, List Int) -> String -> Result String Unit
  verify-lrat-text max-var orig-clauses lrat-txt =
    case parse-lrat-steps lrat-txt of
      Err e -> Err e
      Ok steps -> verify-lrat max-var orig-clauses steps

  join-int :: List Int -> String
  join-int xs = case xs of
    Nil -> ""
    Cons h Nil -> int-to-string h
    Cons h t -> string-concat-all [int-to-string h, " ", join-int t]

  join-nat :: List Nat -> String
  join-nat xs = case xs of
    Nil -> ""
    Cons h Nil -> nat-to-string h
    Cons h t -> string-concat-all [nat-to-string h, " ", join-nat t]

  -- Built-in 1-UIP CDCL SAT Prover with non-chronological backjumping,
  -- phase saving (Pipatsrisawat & Darwiche 2007), Luby restarts (Luby et al. 1993),
  -- and exact trail-ordered LRAT RUP proof emission.
  data TrailEntry where
    MkTrail :: Int -> Nat -> Option Nat -> Nat -> TrailEntry
    -- lit, decision-level, reason clause id (None for decision), trail-pos

  data SatResult where
    SatUnsat :: List LratStep -> SatResult
    SatModel :: NatMap Int -> SatResult
    SatUnknown :: String -> SatResult

  data BcpResult where
    BcpOk :: NatMap Int -> NatMap Nat -> NatMap (Option Nat) -> NatMap Nat -> List TrailEntry -> Nat -> BcpResult
    BcpConflict :: Nat -> NatMap Int -> NatMap Nat -> NatMap (Option Nat) -> NatMap Nat -> List TrailEntry -> Nat -> BcpResult

  sat-enqueue :: Int -> Nat -> Option Nat -> NatMap Int -> NatMap Nat -> NatMap (Option Nat) -> NatMap Nat -> List TrailEntry -> Nat -> (NatMap Int, NatMap Nat, NatMap (Option Nat), NatMap Nat, List TrailEntry, Nat)
  sat-enqueue lit lvl reason assign lmap rmap pmap trail tpos =
    let v = lit-var lit in
    ( assign-lit-val lit assign
    , nm-insert v lvl lmap
    , nm-insert v reason rmap
    , nm-insert v tpos pmap
    , Cons (MkTrail lit lvl reason tpos) trail
    , tpos + 1
    )

  bcp-pass :: List (Nat, List Int) -> Nat -> NatMap Int -> NatMap Nat -> NatMap (Option Nat) -> NatMap Nat -> List TrailEntry -> Nat -> Bool -> (Option Nat, NatMap Int, NatMap Nat, NatMap (Option Nat), NatMap Nat, List TrailEntry, Nat, Bool)
  bcp-pass cs level assign lmap rmap pmap trail tpos changed = case cs of
    Nil -> (None, assign, lmap, rmap, pmap, trail, tpos, changed)
    Cons (cid, lits) rest -> case eval-clause lits assign None of
      CEConflict -> (Some cid, assign, lmap, rmap, pmap, trail, tpos, True)
      CEUnit u ->
        let (a1, l1, r1, p1, tr1, tp1) = sat-enqueue u level (Some cid) assign lmap rmap pmap trail tpos in
        bcp-pass rest level a1 l1 r1 p1 tr1 tp1 True
      other -> bcp-pass rest level assign lmap rmap pmap trail tpos changed

  run-bcp :: List (Nat, List Int) -> Nat -> NatMap Int -> NatMap Nat -> NatMap (Option Nat) -> NatMap Nat -> List TrailEntry -> Nat -> BcpResult
  run-bcp cs level assign lmap rmap pmap trail tpos =
    case bcp-pass cs level assign lmap rmap pmap trail tpos False of
      (Some conf-cid, a1, l1, r1, p1, tr1, tp1, changed) -> BcpConflict conf-cid a1 l1 r1 p1 tr1 tp1
      (None, a1, l1, r1, p1, tr1, tp1, True) -> run-bcp cs level a1 l1 r1 p1 tr1 tp1
      (None, a1, l1, r1, p1, tr1, tp1, False) -> BcpOk a1 l1 r1 p1 tr1 tp1

  var-level :: Nat -> NatMap Nat -> Nat
  var-level v lmap = case nm-lookup v lmap of Some lv -> lv; None -> 0

  var-pos :: Nat -> NatMap Nat -> Nat
  var-pos v pmap = case nm-lookup v pmap of Some p -> p; None -> 0

  nm-has-bool :: Nat -> NatMap Bool -> Bool
  nm-has-bool k m = case nm-lookup k m of Some True -> True; other -> False

  insert-pos-cid :: (Nat, Nat) -> List (Nat, Nat) -> List (Nat, Nat)
  insert-pos-cid item xs = case item of
    (p, cid) -> case xs of
      Nil -> Cons (p, cid) Nil
      Cons (p2, cid2) rest ->
        if p <= p2 then Cons (p, cid) xs
        else Cons (p2, cid2) (insert-pos-cid item rest)

  -- Collect level-0 antecedent reason clause IDs needed for `seeds`,
  -- sorted in ascending trail-position order for single-pass RUP replay.
  collect-lvl0-dfs :: List Nat -> NatMap (List Int) -> NatMap Nat -> NatMap (Option Nat) -> NatMap Nat -> NatMap Bool -> List (Nat, Nat) -> List (Nat, Nat)
  collect-lvl0-dfs stack cdb lmap rmap pmap visited acc = case stack of
    Nil -> acc
    Cons v rest ->
      if nm-has-bool v visited then collect-lvl0-dfs rest cdb lmap rmap pmap visited acc
      else
        let vis1 = nm-insert v True visited in
        case nm-lookup v rmap of
          Some (Some rid) ->
            let acc1 = insert-pos-cid (var-pos v pmap, rid) acc in
            let extra = case nm-lookup rid cdb of
                  Some cl -> collect-lvl0-clause-vars cl v lmap rest
                  None -> rest in
            collect-lvl0-dfs extra cdb lmap rmap pmap vis1 acc1
          other -> collect-lvl0-dfs rest cdb lmap rmap pmap vis1 acc

  collect-lvl0-clause-vars :: List Int -> Nat -> NatMap Nat -> List Nat -> List Nat
  collect-lvl0-clause-vars lits skip lmap acc = case lits of
    Nil -> acc
    Cons l rest ->
      let u = lit-var l in
      let next = if u /= skip && var-level u lmap == 0 then Cons u acc else acc in
      collect-lvl0-clause-vars rest skip lmap next

  dedup-cids :: List Nat -> NatMap Bool -> List Nat -> List Nat
  dedup-cids xs seen acc = case xs of
    Nil -> reverse acc
    Cons cid rest ->
      if nm-has-bool cid seen then dedup-cids rest seen acc
      else dedup-cids rest (nm-insert cid True seen) (Cons cid acc)

  strip-pos :: List (Nat, Nat) -> List Nat
  strip-pos xs = case xs of
    Nil -> Nil
    Cons (p, cid) rest -> Cons cid (strip-pos rest)

  clause-vars :: List Int -> List Nat
  clause-vars lits = case lits of
    Nil -> Nil
    Cons l rest -> Cons (lit-var l) (clause-vars rest)

  level0-conflict-hints :: Nat -> NatMap (List Int) -> NatMap Nat -> NatMap (Option Nat) -> NatMap Nat -> List Nat
  level0-conflict-hints conf-cid cdb lmap rmap pmap =
    let seeds = case nm-lookup conf-cid cdb of Some cl -> clause-vars cl; None -> Nil in
    let ordered = collect-lvl0-dfs seeds cdb lmap rmap pmap nm-empty Nil in
    dedup-cids (strip-pos ordered <> [conf-cid]) nm-empty Nil

  -- Scan one clause during 1-UIP conflict analysis, classifying literals by level.
  uip-scan-clause :: List Int -> Nat -> Nat -> NatMap Nat -> NatMap Bool -> Nat -> List Int -> List Nat -> (NatMap Bool, Nat, List Int, List Nat)
  uip-scan-clause lits skip-var cur-lvl lmap seen counter learned-tail lvl0-vars = case lits of
    Nil -> (seen, counter, learned-tail, lvl0-vars)
    Cons l rest ->
      let v = lit-var l in
      if v == skip-var || nm-has-bool v seen then
        uip-scan-clause rest skip-var cur-lvl lmap seen counter learned-tail lvl0-vars
      else
        let seen1 = nm-insert v True seen in
        let lv = var-level v lmap in
        if lv == cur-lvl then
          uip-scan-clause rest skip-var cur-lvl lmap seen1 (counter + 1) learned-tail lvl0-vars
        else if lv > 0 then
          uip-scan-clause rest skip-var cur-lvl lmap seen1 counter (Cons l learned-tail) lvl0-vars
        else
          uip-scan-clause rest skip-var cur-lvl lmap seen1 counter learned-tail (Cons v lvl0-vars)

  -- Walk backward on the trail (stored newest-first) to the next seen variable.
  uip-next-on-trail :: List TrailEntry -> NatMap Bool -> Option (TrailEntry, List TrailEntry)
  uip-next-on-trail trail seen = case trail of
    Nil -> None
    Cons entry rest -> case entry of
      MkTrail p plvl preason ptpos ->
        if nm-has-bool (lit-var p) seen then Some (entry, rest)
        else uip-next-on-trail rest seen

  max-clause-level :: List Int -> NatMap Nat -> Nat -> Nat
  max-clause-level lits lmap best = case lits of
    Nil -> best
    Cons l rest ->
      let lv = var-level (lit-var l) lmap in
      max-clause-level rest lmap (if lv > best then lv else best)

  -- 1-UIP conflict resolution loop: resolves backward from `cur-cid` until a single
  -- current-level literal remains, yielding `(learned, bt-level, exact-rup-hints)`.
  analyze-uip-loop :: Nat -> Nat -> Nat -> List TrailEntry -> NatMap (List Int) -> NatMap Nat -> NatMap (Option Nat) -> NatMap Nat -> NatMap Bool -> Nat -> List Int -> List Nat -> List Nat -> (List Int, Nat, List Nat)
  analyze-uip-loop cur-cid skip-var cur-lvl trail cdb lmap rmap pmap seen counter learned-tail lvl0-vars resolved-fwd =
    let resolved1 = Cons cur-cid resolved-fwd in
    let cl = case nm-lookup cur-cid cdb of Some lits -> lits; None -> Nil in
    let (seen1, counter1, learned1, lvl01) = uip-scan-clause cl skip-var cur-lvl lmap seen counter learned-tail lvl0-vars in
    case uip-next-on-trail trail seen1 of
      None ->
        let bt = max-clause-level learned1 lmap 0 in
        let l0 = strip-pos (collect-lvl0-dfs lvl01 cdb lmap rmap pmap nm-empty Nil) in
        (learned1, bt, dedup-cids (l0 <> resolved1) nm-empty Nil)
      Some (MkTrail p plvl preason ptpos, trail-rest) ->
        let counter2 = saturating-sub counter1 1 in
        if counter2 == 0 then
          let asserting = lit-neg p in
          let learned-full = Cons asserting learned1 in
          let bt = max-clause-level learned1 lmap 0 in
          let l0 = strip-pos (collect-lvl0-dfs lvl01 cdb lmap rmap pmap nm-empty Nil) in
          (learned-full, bt, dedup-cids (l0 <> resolved1) nm-empty Nil)
        else
          case preason of
            Some next-cid ->
              analyze-uip-loop next-cid (lit-var p) cur-lvl trail-rest cdb lmap rmap pmap seen1 counter2 learned1 lvl01 resolved1
            None ->
              let asserting = lit-neg p in
              let learned-full = Cons asserting learned1 in
              let bt = max-clause-level learned1 lmap 0 in
              let l0 = strip-pos (collect-lvl0-dfs lvl01 cdb lmap rmap pmap nm-empty Nil) in
              (learned-full, bt, dedup-cids (l0 <> resolved1) nm-empty Nil)

  -- Non-chronological backjump to `target-lvl`, saving each popped variable's polarity.
  backtrack-cdcl :: Nat -> List TrailEntry -> Nat -> NatMap Int -> NatMap Nat -> NatMap (Option Nat) -> NatMap Nat -> NatMap Int -> (List TrailEntry, Nat, NatMap Int, NatMap Nat, NatMap (Option Nat), NatMap Nat, NatMap Int)
  backtrack-cdcl target-lvl trail tpos assign lmap rmap pmap saved = case trail of
    Nil -> (Nil, 0, assign, lmap, rmap, pmap, saved)
    Cons (MkTrail lit lvl reason pos) rest ->
      if lvl > target-lvl then
        let v = lit-var lit in
        let pol = if lit-pos lit then 1 else -1 in
        backtrack-cdcl target-lvl rest (saturating-sub tpos 1)
          (nm-delete v assign)
          (nm-delete v lmap)
          (nm-delete v rmap)
          (nm-delete v pmap)
          (nm-insert v pol saved)
      else (trail, tpos, assign, lmap, rmap, pmap, saved)

  -- Luby restart sequence (1-indexed): 1, 1, 2, 1, 1, 2, 4, 1, ...
  nat-pow2 :: Nat -> Nat
  nat-pow2 k = if k == 0 then 1 else 2 * nat-pow2 (saturating-sub k 1)

  luby-seq :: Nat -> Nat -> Nat
  luby-seq i k =
    let size = saturating-sub (nat-pow2 k) 1 in
    if i == size then nat-pow2 (saturating-sub k 1)
    else if i < size then luby-seq (saturating-sub i (saturating-sub (nat-pow2 (saturating-sub k 1)) 1)) 1
    else luby-seq i (k + 1)

  -- Count unassigned literals in a clause; returns (satisfied?, count, first-unassigned-lit).
  inspect-clause :: List Int -> NatMap Int -> Nat -> Option Int -> (Bool, Nat, Option Int)
  inspect-clause lits assign cnt first-u = case lits of
    Nil -> (False, cnt, first-u)
    Cons l rest ->
      let v = eval-lit l assign in
      if v == 1 then (True, 0, None)
      else if v == -1 then inspect-clause rest assign cnt first-u
      else
        let next-u = case first-u of Some u -> Some u; None -> Some l in
        inspect-clause rest assign (cnt + 1) next-u

  -- Pick a literal from the shortest unsatisfied clause (MOM/clause-directed branching)
  -- and apply saved phase when available.
  pick-from-clauses :: List (Nat, List Int) -> NatMap Int -> Nat -> Option Int -> Option Int
  pick-from-clauses cs assign best-len best-lit = case cs of
    Nil -> best-lit
    Cons (cid, lits) rest ->
      case inspect-clause lits assign 0 None of
        (True, cnt, u) -> pick-from-clauses rest assign best-len best-lit
        (False, cnt, Some u) ->
          if cnt <= 2 then Some u
          else if cnt < best-len then pick-from-clauses rest assign cnt (Some u)
          else pick-from-clauses rest assign best-len best-lit
        other -> pick-from-clauses rest assign best-len best-lit

  apply-saved-phase :: Int -> NatMap Int -> Int
  apply-saved-phase lit saved =
    let v = lit-var lit in
    case nm-lookup v saved of
      Some p -> if p > 0 then nat-to-int v else (0 - nat-to-int v)
      None -> lit

  pick-unassigned :: Nat -> Nat -> NatMap Int -> Option Nat
  pick-unassigned cur max-var assign =
    if cur >= max-var then None
    else case nm-lookup cur assign of
      None -> Some cur
      Some v -> pick-unassigned (cur + 1) max-var assign

  sat-loop :: Nat -> Nat -> Nat -> List (Nat, List Int) -> NatMap (List Int) -> Nat -> NatMap Int -> NatMap Nat -> NatMap (Option Nat) -> NatMap Nat -> NatMap Int -> List TrailEntry -> Nat -> List LratStep -> Nat -> Nat -> Nat -> SatResult
  sat-loop max-var next-cid level cs cdb budget assign lmap rmap pmap saved trail tpos lrat-acc conflicts since-rst rst-idx =
    if conflicts >= budget then SatUnknown "SAT conflict budget exhausted; plug an external solver"
    else case run-bcp cs level assign lmap rmap pmap trail tpos of
      BcpConflict conf-cid a1 l1 r1 p1 tr1 tp1 ->
        if level == 0 then
          let l0-hints = level0-conflict-hints conf-cid cdb l1 r1 p1 in
          SatUnsat (reverse (Cons (LratAdd next-cid Nil l0-hints) lrat-acc))
        else
          let (learned, bt-level, hints) = analyze-uip-loop conf-cid 0 level tr1 cdb l1 r1 p1 nm-empty 0 Nil Nil Nil in
          let step = LratAdd next-cid learned hints in
          let next-cs = Cons (next-cid, learned) cs in
          let next-cdb = nm-insert next-cid learned cdb in
          let (bt-tr, bt-tp, bt-a, bt-l, bt-r, bt-p, saved1) = backtrack-cdcl bt-level tr1 tp1 a1 l1 r1 p1 saved in
          case learned of
            Nil -> SatUnsat (reverse (Cons step lrat-acc))
            Cons asserting rest-lits ->
              let (a2, l2, r2, p2, tr2, tp2) = sat-enqueue asserting bt-level (Some next-cid) bt-a bt-l bt-r bt-p bt-tr bt-tp in
              sat-loop max-var (next-cid + 1) bt-level next-cs next-cdb budget a2 l2 r2 p2 saved1 tr2 tp2 (Cons step lrat-acc) (conflicts + 1) (since-rst + 1) rst-idx
      BcpOk a1 l1 r1 p1 tr1 tp1 ->
        let rst-limit = luby-seq rst-idx 1 * 32 in
        if level > 0 && since-rst >= rst-limit then
          let (bt-tr, bt-tp, bt-a, bt-l, bt-r, bt-p, saved1) = backtrack-cdcl 0 tr1 tp1 a1 l1 r1 p1 saved in
          sat-loop max-var next-cid 0 cs cdb budget bt-a bt-l bt-r bt-p saved1 bt-tr bt-tp lrat-acc conflicts 0 (rst-idx + 1)
        else
          let next-lit = case pick-from-clauses cs a1 999999 None of
                Some l -> Some (apply-saved-phase l saved)
                None -> case pick-unassigned 1 max-var a1 of
                  Some v -> Some (apply-saved-phase (0 - nat-to-int v) saved)
                  None -> None in
          case next-lit of
            None -> SatModel a1
            Some dec-lit ->
              let next-lvl = level + 1 in
              let (a2, l2, r2, p2, tr2, tp2) = sat-enqueue dec-lit next-lvl None a1 l1 r1 p1 tr1 tp1 in
              sat-loop max-var next-cid next-lvl cs cdb budget a2 l2 r2 p2 saved tr2 tp2 lrat-acc conflicts since-rst rst-idx

  prove-cnf-lrat :: Nat -> Nat -> List (Nat, List Int) -> SatResult
  prove-cnf-lrat max-var next-cid cs =
    let cdb = build-clause-db cs nm-empty in
    sat-loop max-var next-cid 0 cs cdb 4096 nm-empty nm-empty nm-empty nm-empty nm-empty Nil 0 Nil 0 0 1

  eval-model-bits :: List Int -> Nat -> NatMap Int -> U64
  eval-model-bits bits i model = case bits of
    Nil -> 0
    Cons l rest ->
      let rest-val = eval-model-bits rest (i + 1) model in
      if eval-lit l model == 1 then
        bit-or-u64 rest-val (wrapping-shl-u64 1 (nat-u32 i))
      else rest-val

  format-counterexample :: List (Nat, String, List Int) -> NatMap Int -> String
  format-counterexample vbits model = case vbits of
    Nil -> ""
    Cons (idx, nm, bits) Nil -> string-concat-all [nm, " = ", u64-decimal (eval-model-bits bits 0 model)]
    Cons (idx, nm, bits) rest -> string-concat-all [nm, " = ", u64-decimal (eval-model-bits bits 0 model), ", ", format-counterexample rest model]

  -- ==========================================================================
  -- 9. Top-Level Pluggable Obligation & Policy Orchestrator
  -- ==========================================================================

  policy-allows-tier :: Bool -> String -> String -> Bool
  policy-allows-tier is-jpl verify-mode tier =
    if same verify-mode "lax" then True
    else if same verify-mode "strict" || is-jpl then same tier "kernel-cert"
    else has-str tier ["kernel-cert", "compiled-cert", "smt-verified"]

  policy-name-for :: Bool -> String -> String
  policy-name-for is-jpl verify-mode =
    if same verify-mode "lax" then "lax"
    else if same verify-mode "strict" then "strict"
    else if is-jpl then "jpl"
    else "dev"

  make-assumed-receipt :: String -> String -> String -> TrustReceipt
  make-assumed-receipt goal-hash checker-id reason =
    MkTrustReceipt goal-hash semantics-id-llvm "none" checker-id "assumed" "none" "none" reason [checker-id, semantics-id-llvm] ""

  lookup-cached-proof :: String -> List (String, String) -> Option String
  lookup-cached-proof key entries = case entries of
    Nil -> None
    Cons (k, v) rest -> if same key k then Some v else lookup-cached-proof key rest

  clause-max-var :: List Int -> Nat -> Nat
  clause-max-var lits acc = case lits of
    Nil -> acc
    Cons l rest ->
      let v = lit-var l in
      clause-max-var rest (if v > acc then v else acc)

  mark-lits-active :: List Int -> NatMap Bool -> NatMap Bool
  mark-lits-active lits active = case lits of
    Nil -> active
    Cons l rest -> mark-lits-active rest (nm-insert (lit-var l) True active)

  -- Single reverse-topological pass over `rev-clauses` keeping only Tseitin
  -- clauses in the exact cone of influence of `active`.
  cone-filter-clauses :: List (Nat, List Int) -> NatMap Bool -> List (Nat, List Int) -> List (Nat, List Int)
  cone-filter-clauses cs active acc = case cs of
    Nil -> reverse acc
    Cons (cid, lits) rest ->
      let mv = clause-max-var lits 0 in
      case nm-lookup mv active of
        Some True -> cone-filter-clauses rest (mark-lits-active lits active) (Cons (cid, lits) acc)
        other -> cone-filter-clauses rest active acc

  prove-bitwise-loop :: Option Int -> List Int -> List Int -> BlastState -> List String -> Result VerifyOutcome (List String)
  prove-bitwise-loop assume-opt la lb base-st proof-acc = case (la, lb) of
    (Nil, Nil) -> Ok (reverse proof-acc)
    (Cons ai ar, Cons bi br) ->
      let (diff, st1) = bb-xor ai bi base-st in
      if diff == lit-false then
        prove-bitwise-loop assume-opt ar br base-st (Cons "trivial" proof-acc)
      else
        let st2 = bb-add-clause [diff] st1 in
        let st3 = case assume-opt of
              Some la-lit -> bb-add-clause [la-lit] st2
              None -> st2 in
        case st3 of
          MkBlastState max-var next-cid rev-cs memo vbits ac xc ic ->
            let act0 = nm-insert 1 True (nm-insert (lit-var diff) True nm-empty) in
            let act1 = case assume-opt of
                  Some la-lit -> nm-insert (lit-var la-lit) True act0
                  None -> act0 in
            let cone-cs = cone-filter-clauses rev-cs act1 Nil in
            case prove-cnf-lrat max-var next-cid cone-cs of
              SatModel model ->
                Err (OutcomeDisproved (string-concat "counterexample: " (format-counterexample (reverse vbits) model)))
              SatUnknown reason ->
                Err (OutcomeOpen reason)
              SatUnsat lrat-steps ->
                case verify-lrat max-var rev-cs lrat-steps of
                  Err bad -> Err (OutcomeOpen (string-concat "LRAT kernel rejected bitwise proof: " bad))
                  Ok verified -> prove-bitwise-loop assume-opt ar br base-st (Cons (serialize-lrat-steps lrat-steps) proof-acc)
    other -> Err (OutcomeOpen "mismatched bitvector widths in equality check")

  try-decompose-bv-eq :: Nat -> SemGraph -> Option (Option Nat, Nat, Nat, Nat)
  try-decompose-bv-eq goal-id g = case graph-node goal-id g of
    Some (NBvCmp "eq" w a b) | w > 1 -> Some (None, w, a, b)
    Some (NImplies assume body) ->
      (case graph-node body g of
        Some (NBvCmp "eq" w a b) | w > 1 -> Some (Some assume, w, a, b)
        other -> None)
    other -> None

  verify-bitwise-cached-loop :: Option Int -> List Int -> List Int -> BlastState -> List String -> Result String Unit
  verify-bitwise-cached-loop assume-opt la lb base-st proofs = case (la, lb, proofs) of
    (Nil, Nil, Nil) -> Ok ()
    (Cons ai ar, Cons bi br, Cons pstr prest) ->
      let (diff, st1) = bb-xor ai bi base-st in
      if same pstr "trivial" then
        if diff == lit-false then verify-bitwise-cached-loop assume-opt ar br base-st prest
        else Err "cached bitwise LRAT proof claimed trivial for non-trivial bit"
      else
        let st2 = bb-add-clause [diff] st1 in
        let st3 = case assume-opt of
              Some la-lit -> bb-add-clause [la-lit] st2
              None -> st2 in
        case st3 of
          MkBlastState max-var next-cid rev-cs memo vbits ac xc ic ->
            case verify-lrat-text max-var rev-cs pstr of
              Err bad -> Err bad
              Ok verified -> verify-bitwise-cached-loop assume-opt ar br base-st prest
    other -> Err "cached bitwise LRAT proof bit count mismatch"

  check-one-obligation-cached :: String -> Bool -> String -> String -> List (String, String) -> Bool -> SemGraph -> Nat -> Result VerifyOutcome TrustReceipt
  check-one-obligation-cached ob-name is-jpl verify-mode just-word proof-cache replay-only g goal-id =
    let fp-tag = if graph-has-fp-arith g then ":fp_arith" else "" in
    let goal-hash = sha256-hex (string-to-bytes (string-concat-all [ob-name, ":", serialize-sem goal-id g, fp-tag])) in
    let use-compiled = same just-word "verify-compiled-lrat" in
    let checker-id = if use-compiled then "cinch-compiled-lrat@1" else "cinch-kernel-lrat@1" in
    let tier = if use-compiled then "compiled-cert" else "kernel-cert" in
    if same verify-mode "off" then
      Ok (make-assumed-receipt goal-hash "cinch-verify-off@1" "assumed (prim-verify=off)")
    else if graph-has-fp-arith g then
      case lookup-cached-proof goal-hash proof-cache of
        Some cached-alethe | string-starts-with "ALETHE_V1\n" cached-alethe ->
          let proof-body = string-slice cached-alethe 10 (string-length cached-alethe) in
          (case verify-alethe proof-body of
            Err bad-alethe ->
              Err (OutcomeOpen (string-concat-all [ob-name, ": cached Alethe proof REJECTED by kernel verification (tampered): ", bad-alethe]))
            Ok ok-msg ->
              if not (policy-allows-tier is-jpl verify-mode "kernel-cert") then
                Err (OutcomeRejected (string-concat-all
                  [ob-name, ": trust tier `kernel-cert` from `cinch-alethe-checker@1` rejected by policy `", policy-name-for is-jpl verify-mode, "`"]))
              else
                let ev-hash = sha256-hex (string-to-bytes cached-alethe) in
                let tcb = insert-unique-sorted "cinch-alethe-checker@1" (insert-unique-sorted "cinch-smtlib2@1" (insert-unique-sorted semantics-id-llvm Nil)) in
                Ok (MkTrustReceipt goal-hash semantics-id-llvm "cached-alethe-replay@1" "cinch-alethe-checker@1" "kernel-cert" "alethe/v1" ev-hash ok-msg tcb cached-alethe))
        other ->
          if same verify-mode "lax" then
            Ok (make-assumed-receipt goal-hash "cinch-lax-bypass@1" "assumed (lax downgrade: floating-point obligation requires external SMT solver)")
          else Err (OutcomeOpen (string-concat ob-name ": floating-point obligation requires an external SMT solver (use --prim-verify=lax to downgrade to assumed)"))
    else
      -- Replay cached bitwise-decomposed LRAT proofs when present, or prove via bit-cone decomposition on cold builds.
      case (lookup-cached-proof goal-hash proof-cache, replay-only, try-decompose-bv-eq goal-id g) of
        (Some cached-lrat, _, Some (assume-opt, w, lhs-id, rhs-id)) | string-starts-with "BITWISE_LRAT_V1\n" cached-lrat ->
          let blast-res = case assume-opt of
                None ->
                  (case bb-node lhs-id g init-blast-state of
                    Err e -> Err e
                    Ok (la, st1) -> case bb-node rhs-id g st1 of
                      Err e -> Err e
                      Ok (lb, st2) -> Ok (None, la, lb, st2))
                Some aid ->
                  (case bb-node aid g init-blast-state of
                    Err e -> Err e
                    Ok (Cons alit Nil, st0) ->
                      (case bb-node lhs-id g st0 of
                        Err e -> Err e
                        Ok (la, st1) -> case bb-node rhs-id g st1 of
                          Err e -> Err e
                          Ok (lb, st2) -> Ok (Some alit, la, lb, st2))
                    Ok other -> Err "assumption did not bit-blast to 1 bit") in
          (case blast-res of
            Err reason -> Err (OutcomeOpen (string-concat-all [ob-name, ": ", reason]))
            Ok (alit-opt, la, lb, st2) ->
              let body-text = string-slice cached-lrat 16 (string-length cached-lrat) in
              let bit-proofs = string-split-on "\n---BIT---\n" body-text in
              case verify-bitwise-cached-loop alit-opt la lb st2 bit-proofs of
                Err bad-proof ->
                  Err (OutcomeOpen (string-concat-all [ob-name, ": cached LRAT proof REJECTED by kernel verification (tampered): ", bad-proof]))
                Ok verified ->
                  if not (policy-allows-tier is-jpl verify-mode tier) then
                    Err (OutcomeRejected (string-concat-all
                      [ob-name, ": trust tier `", tier, "` from `", checker-id, "` rejected by policy `", policy-name-for is-jpl verify-mode, "`"]))
                  else
                    let ev-hash = sha256-hex (string-to-bytes cached-lrat) in
                    let tcb = insert-unique-sorted checker-id (insert-unique-sorted semantics-id-llvm Nil) in
                    Ok (MkTrustReceipt goal-hash semantics-id-llvm "cached-lrat-replay@1" checker-id tier "lrat/v1" ev-hash "verified" tcb cached-lrat))
        (None, False, Some (assume-opt, w, lhs-id, rhs-id)) ->
          let blast-res = case assume-opt of
                None ->
                  (case bb-node lhs-id g init-blast-state of
                    Err e -> Err e
                    Ok (la, st1) -> case bb-node rhs-id g st1 of
                      Err e -> Err e
                      Ok (lb, st2) -> Ok (None, la, lb, st2))
                Some aid ->
                  (case bb-node aid g init-blast-state of
                    Err e -> Err e
                    Ok (Cons alit Nil, st0) ->
                      (case bb-node lhs-id g st0 of
                        Err e -> Err e
                        Ok (la, st1) -> case bb-node rhs-id g st1 of
                          Err e -> Err e
                          Ok (lb, st2) -> Ok (Some alit, la, lb, st2))
                    Ok other -> Err "assumption did not bit-blast to 1 bit") in
          (case blast-res of
            Err reason ->
              if same verify-mode "lax" then
                Ok (make-assumed-receipt goal-hash "cinch-lax-bypass@1" (string-concat-all ["assumed (lax downgrade: ", reason, ")"]))
              else Err (OutcomeOpen (string-concat-all [ob-name, ": ", reason]))
            Ok (alit-opt, la, lb, st2) ->
              (case prove-bitwise-loop alit-opt la lb st2 Nil of
                Err (OutcomeDisproved detail) ->
                  Err (OutcomeDisproved (string-concat-all [ob-name, " ", detail]))
                Err (OutcomeOpen reason) ->
                  if same verify-mode "lax" then
                    Ok (make-assumed-receipt goal-hash "cinch-lax-bypass@1" (string-concat-all ["assumed (lax downgrade: ", reason, ")"]))
                  else Err (OutcomeOpen (string-concat-all [ob-name, ": ", reason]))
                Err other-err -> Err other-err
                Ok bit-proofs ->
                  if not (policy-allows-tier is-jpl verify-mode tier) then
                    Err (OutcomeRejected (string-concat-all
                      [ob-name, ": trust tier `", tier, "` from `", checker-id, "` rejected by policy `", policy-name-for is-jpl verify-mode, "`"]))
                  else
                    let payload = string-concat "BITWISE_LRAT_V1\n" (join-str "\n---BIT---\n" bit-proofs) in
                    let ev-hash = sha256-hex (string-to-bytes payload) in
                    let tcb = insert-unique-sorted checker-id (insert-unique-sorted semantics-id-llvm Nil) in
                    Ok (MkTrustReceipt goal-hash semantics-id-llvm "cinch-cdcl-lrat@1" checker-id tier "lrat/v1" ev-hash "verified" tcb payload)))
        other ->
          case bb-node goal-id g init-blast-state of
            Err reason ->
              if same verify-mode "lax" then
                Ok (make-assumed-receipt goal-hash "cinch-lax-bypass@1" (string-concat-all ["assumed (lax downgrade: ", reason, ")"]))
              else Err (OutcomeOpen (string-concat-all [ob-name, ": ", reason]))
            Ok (Cons goal-lit Nil, st1) ->
              -- Assert negation of goal: UNSAT => goal is valid!
              let st2 = bb-add-clause [lit-neg goal-lit] st1 in
              case st2 of
                MkBlastState max-var next-cid rev-clauses memo vbits ac xc ic ->
                  let clauses = rev-clauses in
                  -- Check persistent proof cache first; ALWAYS re-verify through independent LRAT kernel!
                  case lookup-cached-proof goal-hash proof-cache of
                    Some cached-lrat ->
                      (case verify-lrat-text max-var clauses cached-lrat of
                        Err bad-proof ->
                          Err (OutcomeOpen (string-concat-all [ob-name, ": cached LRAT proof REJECTED by kernel verification (tampered): ", bad-proof]))
                        Ok verified ->
                          if not (policy-allows-tier is-jpl verify-mode tier) then
                            Err (OutcomeRejected (string-concat-all
                              [ob-name, ": trust tier `", tier, "` from `", checker-id, "` rejected by policy `", policy-name-for is-jpl verify-mode, "`"]))
                          else
                            let ev-hash = sha256-hex (string-to-bytes cached-lrat) in
                            let tcb = insert-unique-sorted checker-id (insert-unique-sorted semantics-id-llvm Nil) in
                            Ok (MkTrustReceipt goal-hash semantics-id-llvm "cached-lrat-replay@1" checker-id tier "lrat/v1" ev-hash "verified" tcb cached-lrat))
                    None ->
                      if replay-only then
                        Err (OutcomeOpen (string-concat-all [ob-name, ": replay-only mode has no cached LRAT proof for ", goal-hash]))
                      else
                        let act = nm-insert 1 True (nm-insert (lit-var goal-lit) True nm-empty) in
                        let cone-cs = cone-filter-clauses clauses act Nil in
                        (case prove-cnf-lrat max-var next-cid cone-cs of
                          SatModel model ->
                            Err (OutcomeDisproved (string-concat-all [ob-name, " counterexample: ", format-counterexample (reverse vbits) model]))
                          SatUnknown reason ->
                            if same verify-mode "lax" then
                              Ok (make-assumed-receipt goal-hash "cinch-lax-bypass@1" (string-concat-all ["assumed (lax downgrade: ", reason, ")"]))
                            else Err (OutcomeOpen (string-concat-all [ob-name, ": ", reason]))
                          SatUnsat lrat-steps ->
                            -- Independently verify the LRAT certificate before issuing any receipt!
                            case verify-lrat max-var clauses lrat-steps of
                              Err bad-proof ->
                                Err (OutcomeOpen (string-concat-all [ob-name, ": LRAT kernel rejected proof: ", bad-proof]))
                              Ok verified ->
                                if not (policy-allows-tier is-jpl verify-mode tier) then
                                  Err (OutcomeRejected (string-concat-all
                                    [ob-name, ": trust tier `", tier, "` from `", checker-id, "` rejected by policy `", policy-name-for is-jpl verify-mode, "`"]))
                                else
                                  let payload = serialize-lrat-steps lrat-steps in
                                  let ev-hash = sha256-hex (string-to-bytes payload) in
                                  let tcb = insert-unique-sorted checker-id (insert-unique-sorted semantics-id-llvm Nil) in
                                  Ok (MkTrustReceipt goal-hash semantics-id-llvm "cinch-cdcl-lrat@1" checker-id tier "lrat/v1" ev-hash "verified" tcb payload))
            Ok other -> Err (OutcomeOpen (string-concat ob-name ": goal did not bit-blast to a single boolean literal"))

  check-one-obligation :: String -> Bool -> String -> String -> SemGraph -> Nat -> Result VerifyOutcome TrustReceipt
  check-one-obligation ob-name is-jpl verify-mode just-word g goal-id =
    check-one-obligation-cached ob-name is-jpl verify-mode just-word Nil False g goal-id

  run-obligations-cached :: Bool -> String -> String -> List (String, String) -> Bool -> SemGraph -> List (String, Nat) -> List TrustReceipt -> VerifyOutcome
  run-obligations-cached is-jpl verify-mode just-word proof-cache replay-only g obs acc = case obs of
    Nil ->
      let receipts = reverse acc in
      if same (worst-trust-tier receipts) "assumed" then OutcomeAssumed receipts
      else OutcomeVerified receipts
    Cons (ob-name, goal-id) rest ->
      case check-one-obligation-cached ob-name is-jpl verify-mode just-word proof-cache replay-only g goal-id of
        Err failure -> failure
        Ok receipt -> run-obligations-cached is-jpl verify-mode just-word proof-cache replay-only g rest (Cons receipt acc)

  conjoin-assumptions :: List (String, Nat, SemType, Bool) -> List UType -> Nat -> SemGraph -> (Nat, SemGraph)
  conjoin-assumptions ref-env preds acc g = case preds of
    Nil -> (acc, g)
    Cons p rest ->
      case lower-refinement-pred ref-env p g of
        Some (np, g1) ->
          let (next-acc, g2) = g-and acc np g1 in
          conjoin-assumptions ref-env rest next-acc g2
        None -> conjoin-assumptions ref-env rest acc g

  lookup-param-ref-entry :: Nat -> List (String, Nat, SemType, Bool) -> Option (Nat, SemType, Bool)
  lookup-param-ref-entry idx ref-env = case ref-env of
    Nil -> None
    Cons (nm, nid, ty, sg) rest ->
      if idx == 0 then Some (nid, ty, sg)
      else lookup-param-ref-entry (saturating-sub idx 1) rest

  conjoin-indexed-assumptions :: List (String, Nat, SemType, Bool) -> List (Nat, UType) -> Nat -> SemGraph -> (Nat, SemGraph)
  conjoin-indexed-assumptions ref-env ipreds acc g = case ipreds of
    Nil -> (acc, g)
    Cons (pidx, pred) rest ->
      let local-env = case lookup-param-ref-entry pidx ref-env of
            Some (nid, ty, sg) ->
              Cons ("cinch-result", nid, ty, sg)
                (Cons ("#result", nid, ty, sg)
                  (Cons ("r", nid, ty, sg) ref-env))
            None -> ref-env in
      case lower-refinement-pred local-env pred g of
        Some (np, g1) ->
          let (next-acc, g2) = g-and acc np g1 in
          conjoin-indexed-assumptions ref-env rest next-acc g2
        None -> conjoin-indexed-assumptions ref-env rest acc g

  build-ref-env :: List PrimParamSpec -> List (Nat, SemType, String) -> SemGraph -> (List (String, Nat, SemType, Bool), SemGraph)
  build-ref-env ps vars g = case (ps, vars) of
    (Cons p pr, Cons (idx, ty, nm) vr) ->
      let (nid, g1) = g-var idx ty nm g in
      case build-ref-env pr vr g1 of
        (rest, g2) -> (Cons (nm, nid, ty, param-spec-signed p) rest, g2)
    other -> (Nil, g)

  conjoin-char-invariants :: List PrimParamSpec -> List (String, Nat, SemType, Bool) -> Nat -> SemGraph -> (Nat, SemGraph)
  conjoin-char-invariants ps ref-env acc g = case (ps, ref-env) of
    (Cons (MkPrimParamSpec _ ty _ _ _ _) pr, Cons (_, nid, SBv w, _) rr) ->
      if same ty "Char" && w == 32 then
        let (hi, g1) = g-bv 32 1114111 g in
        let (ok-c, g2) = g-bv-cmp "ule" 32 nid hi g1 in
        let (next-acc, g3) = g-and acc ok-c g2 in
        conjoin-char-invariants pr rr next-acc g3
      else conjoin-char-invariants pr rr acc g
    other -> (acc, g)

  -- Main entry point with proof-cache + replay-only + indexed parameter refinements.
  verify-prim-body-cached :: String -> Bool -> String -> String -> List (String, String) -> Bool -> String -> List PrimParamSpec -> PrimParamSpec -> List UType -> List (Nat, UType) -> Option UType -> Option Expr -> List SpecDef -> String -> Bool -> VerifyOutcome
  verify-prim-body-cached prim-name is-jpl verify-mode just-word proof-cache replay-only fragment params result req-preds param-preds postcond spec-opt spec-defs spec-display is-unsafe =
    let (ub0, g0) = g-bool False empty-sem-graph in
    case init-llvm-params params 0 Nil g0 of
      (binds, vars, g1) ->
        if same verify-mode "off" then
          let gh = sha256-hex (string-to-bytes (string-concat-all [prim-name, ":", fragment])) in
          OutcomeAssumed [make-assumed-receipt gh "cinch-verify-off@1" "assumed (prim-verify=off)"]
        else
          case lower-ir-fragment fragment binds ub0 g1 of
            Err err-msg ->
              if same verify-mode "lax" then
                let gh = sha256-hex (string-to-bytes (string-concat-all [prim-name, ":", fragment])) in
                OutcomeAssumed [make-assumed-receipt gh "cinch-lax-bypass@1" (string-concat-all ["assumed (lax downgrade: ", err-msg, ")"])]
              else OutcomeOpen (string-concat-all [prim-name, ": ", err-msg])
            Ok (MkLlvmEnv final-binds ub-cond g2 None) ->
              OutcomeOpen (string-concat prim-name ": LLVM fragment has no ret instruction")
            Ok (MkLlvmEnv final-binds ub-cond g2 (Some ret-sv)) ->
              let (true-id, g3) = g-bool True g2 in
              case build-ref-env params vars g3 of
                (ref-env, g4) ->
                  let (assume0, g4a) = conjoin-char-invariants params ref-env true-id g4 in
                  let (assume1, g4b) = conjoin-assumptions ref-env req-preds assume0 g4a in
                  let (assume-id, g5) = conjoin-indexed-assumptions ref-env param-preds assume1 g4b in
                  let (not-ub, g6) = g-not ub-cond g5 in
                  let (ob-no-ub, g7) = g-implies assume-id not-ub g6 in
                  let (not-poison, g8) = g-not (sv-poison ret-sv) g7 in
                  let (ob-no-poison, g9) = g-implies assume-id not-poison g8 in
                  let base-obs = [("no-ub", ob-no-ub), ("no-poison", ob-no-poison)] in
                  let res-ty =
                        if param-spec-bool result then SBool
                        else if param-spec-fp result then SFp (param-spec-width result)
                        else SBv (param-spec-width result) in
                  let (ret-val-id, ret-val-ty, g10) =
                        case (param-spec-bool result, sv-type ret-sv) of
                          (True, SBv w) ->
                            let (zero, ga) = g-bv w 0 g9 in
                            let (nz, gb) = g-bv-cmp "ne" w (sv-val ret-sv) zero ga in
                            (nz, SBool, gb)
                          other -> (sv-val ret-sv, sv-type ret-sv, g9) in
                  case spec-opt of
                    None ->
                      (case postcond of
                        None -> run-obligations-cached is-jpl verify-mode just-word proof-cache replay-only g10 base-obs Nil
                        Some post-pred ->
                          let post-env =
                                Cons (param-spec-name result, ret-val-id, ret-val-ty, param-spec-signed result)
                                  (Cons ("cinch-result", ret-val-id, ret-val-ty, param-spec-signed result)
                                    (Cons ("#result", ret-val-id, ret-val-ty, param-spec-signed result)
                                      (Cons ("r", ret-val-id, ret-val-ty, param-spec-signed result) ref-env))) in
                          (case lower-refinement-pred post-env post-pred g10 of
                            Some (post-id, g11) ->
                              let (ob-post, g12) = g-implies assume-id post-id g11 in
                              run-obligations-cached is-jpl verify-mode just-word proof-cache replay-only g12 (base-obs <> [("return-refinement", ob-post)]) Nil
                            None -> run-obligations-cached is-jpl verify-mode just-word proof-cache replay-only g10 base-obs Nil))
                    Some spec-expr ->
                      case lower-prim-spec spec-expr spec-defs vars res-ty g10 of
                        Err spec-err ->
                          if same verify-mode "lax" then
                            let gh = sha256-hex (string-to-bytes (string-concat-all [prim-name, ":spec:", spec-display])) in
                            OutcomeAssumed [make-assumed-receipt gh "cinch-lax-bypass@1" (string-concat-all ["assumed (lax downgrade: ", spec-err, ")"])]
                          else OutcomeOpen (string-concat-all [prim-name, ": ", spec-err])
                        Ok (spec-val, spec-ty, g11) ->
                          let (eq-id, g12) = case (ret-val-ty, spec-ty) of
                                (SBool, SBool) -> g-intern (NEqBool ret-val-id spec-val) g11
                                (SBv w1, SBv w2) ->
                                  if w1 == w2 then g-bv-cmp "eq" w1 ret-val-id spec-val g11
                                  else
                                    let (cast-spec, ga) = g-bv-cast (if w2 < w1 then "zext" else "trunc") w2 w1 spec-val g11 in
                                    g-bv-cmp "eq" w1 ret-val-id cast-spec ga
                                other -> g-bool False g11 in
                          let (ob-spec, g13) = g-implies assume-id eq-id g12 in
                          run-obligations-cached is-jpl verify-mode just-word proof-cache replay-only g13 (base-obs <> [("spec-equiv", ob-spec)]) Nil

  verify-prim-body :: String -> Bool -> String -> String -> String -> List PrimParamSpec -> PrimParamSpec -> List UType -> Option UType -> Option Expr -> List SpecDef -> String -> Bool -> VerifyOutcome
  verify-prim-body prim-name is-jpl verify-mode just-word fragment params result preconds postcond spec-opt spec-defs spec-display is-unsafe =
    verify-prim-body-cached prim-name is-jpl verify-mode just-word Nil False fragment params result preconds Nil postcond spec-opt spec-defs spec-display is-unsafe

  -- ==========================================================================
  -- 10. Cross-Target Equivalence (`CrossTargetEquiv`)
  -- ==========================================================================

  verify-prim-cross-target :: String -> Bool -> String -> String -> List (String, String) -> Bool -> String -> String -> List PrimParamSpec -> PrimParamSpec -> List UType -> List (Nat, UType) -> VerifyOutcome
  verify-prim-cross-target prim-name is-jpl verify-mode just-word proof-cache replay-only frag-a frag-b params result req-preds param-preds =
    if same verify-mode "off" then
      let gh = sha256-hex (string-to-bytes (string-concat-all [prim-name, ":cross:", frag-a, "|", frag-b])) in
      OutcomeAssumed [make-assumed-receipt gh "cinch-verify-off@1" "assumed (prim-verify=off)"]
    else
      let (ub0, g0) = g-bool False empty-sem-graph in
      case init-llvm-params params 0 Nil g0 of
        (binds, vars, g1) ->
          case lower-ir-fragment frag-a binds ub0 g1 of
            Err err-a ->
              if same verify-mode "lax" then
                let gh = sha256-hex (string-to-bytes (string-concat-all [prim-name, ":cross-a"])) in
                OutcomeAssumed [make-assumed-receipt gh "cinch-lax-bypass@1" (string-concat-all ["assumed (lax downgrade: ", err-a, ")"])]
              else OutcomeOpen (string-concat-all [prim-name, " cross-target lhs: ", err-a])
            Ok (MkLlvmEnv b1 ub-a g2 None) -> OutcomeOpen (string-concat prim-name " cross-target lhs has no ret")
            Ok (MkLlvmEnv b1 ub-a g2 (Some ret-a)) ->
              let (ub0-b, g2b) = g-bool False g2 in
              case lower-ir-fragment frag-b binds ub0-b g2b of
                Err err-b ->
                  if same verify-mode "lax" then
                    let gh = sha256-hex (string-to-bytes (string-concat-all [prim-name, ":cross-b"])) in
                    OutcomeAssumed [make-assumed-receipt gh "cinch-lax-bypass@1" (string-concat-all ["assumed (lax downgrade: ", err-b, ")"])]
                  else OutcomeOpen (string-concat-all [prim-name, " cross-target rhs: ", err-b])
                Ok (MkLlvmEnv b2 ub-b g3 None) -> OutcomeOpen (string-concat prim-name " cross-target rhs has no ret")
                Ok (MkLlvmEnv b2 ub-b g3 (Some ret-b)) ->
                  let (true-id, g4) = g-bool True g3 in
                  case build-ref-env params vars g4 of
                    (ref-env, g5) ->
                      let (assume1, g5b) = conjoin-assumptions ref-env req-preds true-id g5 in
                      let (assume-id, g6) = conjoin-indexed-assumptions ref-env param-preds assume1 g5b in
                      let (eq-ub, g7) = g-intern (NEqBool ub-a ub-b) g6 in
                      let (eq-p, g8) = g-intern (NEqBool (sv-poison ret-a) (sv-poison ret-b)) g7 in
                      let (eq-v, g9) = case (sv-type ret-a, sv-type ret-b) of
                            (SBool, SBool) -> g-intern (NEqBool (sv-val ret-a) (sv-val ret-b)) g8
                            (SBv w1, SBv w2) | w1 == w2 -> g-bv-cmp "eq" w1 (sv-val ret-a) (sv-val ret-b) g8
                            other -> g-bool False g8 in
                      let (not-p, g10) = g-not (sv-poison ret-a) g9 in
                      let (v-guarded, g11) = g-implies not-p eq-v g10 in
                      let (p-and-v, g12) = g-and eq-p v-guarded g11 in
                      let (not-ub, g13) = g-not ub-a g12 in
                      let (ub-guarded, g14) = g-implies not-ub p-and-v g13 in
                      let (full-eq, g15) = g-and eq-ub ub-guarded g14 in
                      let (goal, g16) = g-implies assume-id full-eq g15 in
                      run-obligations-cached is-jpl verify-mode just-word proof-cache replay-only g16 [("cross-target-equiv", goal)] Nil

  -- ==========================================================================
  -- 11. Alethe Proof-Checker Seam (`cinch-alethe-checker@1`, `alethe/v1`)
  -- ==========================================================================

  alethe-known-rule :: String -> Bool
  alethe-known-rule r =
    has-str r
      [ "resolution", "th_resolution", "rup", "and", "or", "not_not"
      , "equiv_pos1", "equiv_pos2", "equiv_neg1", "equiv_neg2"
      , "trans", "cong", "refl", "symm", "la_generic", "bv_bitblast", "bitblast"
      , "false", "true", "not_or", "not_and", "or_pos", "and_pos", "and_neg"
      , "implies", "ite1", "ite2", "eq_reflexive", "eq_symmetric", "eq_transitive"
      , "eq_congruent", "contraction", "reordering"
      ]

  strip-parens :: String -> String
  strip-parens s = pack (strip-paren-chars (unpack s))

  strip-paren-chars :: List Char -> List Char
  strip-paren-chars cs = case cs of
    Nil -> Nil
    Cons c rest ->
      let code = char-code c in
      if code == 40 || code == 41 then Cons ' ' (strip-paren-chars rest)
      else Cons c (strip-paren-chars rest)

  extract-after-keyword :: String -> List String -> Option String
  extract-after-keyword kw ws = case ws of
    Nil -> None
    Cons w (Cons val rest) -> if same w kw then Some val else extract-after-keyword kw (Cons val rest)
    Cons w Nil -> None

  extract-premises-block :: String -> List String
  extract-premises-block line = case string-split-on ":premises" line of
    Cons before (Cons after rest) ->
      case string-split-on "(" after of
        Cons pre (Cons inside more) ->
          (case string-split-on ")" inside of
            Cons pids tail -> string-words pids
            Nil -> Nil)
        other -> Nil
    other -> Nil

  all-premises-declared :: List String -> List String -> Option String
  all-premises-declared pids known = case pids of
    Nil -> None
    Cons p rest ->
      if has-str p known then all-premises-declared rest known
      else Some p

  verify-alethe-lines :: List String -> List String -> Nat -> Bool -> Result String String
  verify-alethe-lines lines known steps derived-empty = case lines of
    Nil ->
      if derived-empty && steps > 0 then
        Ok (string-concat-all ["alethe-verified ", nat-to-string steps, " step(s)"])
      else Err "Alethe proof did not derive empty clause (cl)"
    Cons raw rest ->
      let t = string-strip raw in
      if string-length t == 0 || string-starts-with ";" t then
        verify-alethe-lines rest known steps derived-empty
      else if string-starts-with "(assume " t then
        let ws = string-words (strip-parens t) in
        (case ws of
          Cons "assume" (Cons aid more) ->
            verify-alethe-lines rest (Cons aid known) steps derived-empty
          other -> Err "malformed Alethe assume command")
      else if string-starts-with "(step " t then
        let ws = string-words (strip-parens t) in
        (case ws of
          Cons "step" (Cons sid more) ->
            (case extract-after-keyword ":rule" ws of
              None -> Err (string-concat "Alethe step missing :rule: " sid)
              Some rule ->
                if same rule "hole" || same rule "trust" then
                  Err (string-concat "Alethe proof uses unverified rule: " rule)
                else if not (alethe-known-rule rule) then
                  Err (string-concat "Alethe proof uses unknown rule: " rule)
                else
                  let pids = extract-premises-block t in
                  (case all-premises-declared pids known of
                    Some missing -> Err (string-concat-all ["Alethe step ", sid, " references undeclared premise ", missing])
                    None ->
                      let is-empty = string-contains " (cl) " t || string-contains " (cl):" t in
                      verify-alethe-lines rest (Cons sid known) (steps + 1) (derived-empty || is-empty)))
          other -> Err "malformed Alethe step command")
      else if string-starts-with "(anchor " t || same t ")" then
        verify-alethe-lines rest known steps derived-empty
      else Err (string-concat "unsupported Alethe command: " t)

  verify-alethe :: String -> Result String String
  verify-alethe text = verify-alethe-lines (string-split-on "\n" text) Nil 0 False

  -- ==========================================================================
  -- 12. Verified `rewrite ... justify verify` Rules
  -- ==========================================================================

  utype-to-sem-type :: Nat -> UType -> Option SemType
  utype-to-sem-type word-bits ty = case refinement-view ty of
    URefine id nm base pred -> utype-to-sem-type word-bits base
    UCon name k ->
      let short = strip-module-prefix name in
      if same short "Bool" then Some SBool
      else if same short "I8" || same short "U8" then Some (SBv 8)
      else if same short "I16" || same short "U16" then Some (SBv 16)
      else if same short "I32" || same short "U32" || same short "Char" then Some (SBv 32)
      else if same short "Usize" || same short "Isize" then Some (SBv word-bits)
      else if same short "I64" || same short "U64" then Some (SBv 64)
      else if same short "I128" || same short "U128" then Some (SBv 128)
      else None
    other -> None

  init-rewrite-binds :: Nat -> List (String, UType) -> Nat -> SemGraph -> Result String (List (String, Nat, SemType), SemGraph)
  init-rewrite-binds word-bits locals idx g = case locals of
    Nil -> Ok (Nil, g)
    Cons (nm, ty) rest ->
      case utype-to-sem-type word-bits ty of
        None -> Err (string-concat "rewrite formal has non-bitvector type: " nm)
        Some st ->
          let (nid, g1) = g-var idx st nm g in
          case init-rewrite-binds word-bits rest (idx + 1) g1 of
            Err e -> Err e
            Ok (more, g2) -> Ok (Cons (nm, nid, st) more, g2)

  verify-rewrite-rule :: String -> Bool -> String -> String -> List (String, String) -> Bool -> List (String, UType) -> UType -> Expr -> Expr -> VerifyOutcome
  verify-rewrite-rule rule-name is-jpl verify-mode just-word proof-cache replay-only locals res-utype lhs-expr rhs-expr =
    verify-rewrite-rule-for 64 rule-name is-jpl verify-mode just-word proof-cache replay-only locals res-utype lhs-expr rhs-expr

  verify-rewrite-rule-for :: Nat -> String -> Bool -> String -> String -> List (String, String) -> Bool -> List (String, UType) -> UType -> Expr -> Expr -> VerifyOutcome
  verify-rewrite-rule-for word-bits rule-name is-jpl verify-mode just-word proof-cache replay-only locals res-utype lhs-expr rhs-expr =
    if same verify-mode "off" then
      let gh = sha256-hex (string-to-bytes (string-concat "rewrite:" rule-name)) in
      OutcomeAssumed [make-assumed-receipt gh "cinch-verify-off@1" "assumed (prim-verify=off)"]
    else
      case utype-to-sem-type word-bits res-utype of
        None -> OutcomeOpen (string-concat rule-name ": rewrite result type is not a modeled bitvector/Bool type")
        Some res-st ->
          case init-rewrite-binds word-bits locals 0 empty-sem-graph of
            Err err-b -> OutcomeOpen (string-concat-all [rule-name, ": ", err-b])
            Ok (binds, g1) ->
              case lower-spec-expr binds res-st lhs-expr g1 of
                Err err-l -> OutcomeOpen (string-concat-all [rule-name, " lhs: ", err-l])
                Ok (lv, lty, g2) ->
                  case lower-spec-expr binds lty rhs-expr g2 of
                    Err err-r -> OutcomeOpen (string-concat-all [rule-name, " rhs: ", err-r])
                    Ok (rv, rty, g3) ->
                      let (eq-id, g4) = case (lty, rty) of
                            (SBool, SBool) -> g-intern (NEqBool lv rv) g3
                            (SBv w1, SBv w2) | w1 == w2 -> g-bv-cmp "eq" w1 lv rv g3
                            other -> g-bool False g3 in
                      run-obligations-cached is-jpl verify-mode just-word proof-cache replay-only g4 [(string-concat "rewrite:" rule-name, eq-id)] Nil

  -- ==========================================================================
  -- 13. Memory & Atomic Boundary Contract Auditor + LLVM Translation Validation
  -- ==========================================================================

  atomic-ord-rank :: String -> Option Nat
  atomic-ord-rank ord =
    if same ord "unordered" then Some 0
    else if same ord "monotonic" then Some 1
    else if same ord "acquire" then Some 2
    else if same ord "release" then Some 2
    else if same ord "acq_rel" then Some 3
    else if same ord "seq_cst" then Some 4
    else None

  is-power-of-two-nat :: Nat -> Bool
  is-power-of-two-nat n =
    if n == 0 then False
    else if n == 1 then True
    else if nat-odd n then False
    else is-power-of-two-nat (nat-half n)

  find-align-nat :: List String -> Option Nat
  find-align-nat ws = case ws of
    Nil -> None
    Cons "align" (Cons nstr rest) -> parse-nat-str nstr
    Cons w rest -> find-align-nat rest

  find-orderings :: List String -> List String
  find-orderings ws = case ws of
    Nil -> Nil
    Cons w rest ->
      case atomic-ord-rank w of
        Some r -> Cons w (find-orderings rest)
        None -> find-orderings rest

  llvm-byte-width :: Nat -> String -> Option Nat
  llvm-byte-width word-bits ty =
    let ptr-bytes = if word-bits == 32 then 4 else 8 in
    if same ty "ptr" then Some ptr-bytes
    else if same ty "double" then Some 8
    else if same ty "float" then Some 4
    else if string-starts-with "i" ty && string-length ty > 1 then
      case parse-nat-str (string-slice ty 1 (string-length ty)) of
        Some bits -> Some (nat-half (nat-half (nat-half (bits + 7))))
        None -> None
    else None

  first-atomic-ty :: List String -> Option String
  first-atomic-ty ws = case ws of
    Nil -> None
    Cons "atomic" (Cons "volatile" (Cons ty rest)) -> Some ty
    Cons "atomic" (Cons ty rest) -> Some ty
    Cons w rest -> first-atomic-ty rest

  audit-boundary-line :: Nat -> String -> Bool -> String -> List String
  audit-boundary-line word-bits prim-name is-pure raw =
    let clean = strip-ir-comment raw in
    let ws = ir-words clean in
    let ptr-bytes = if word-bits == 32 then 4 else 8 in
    let pure-v =
          if is-pure && (has-str "store" ws || has-str "atomicrmw" ws || has-str "cmpxchg" ws || has-str "fence" ws || has-str "volatile" ws) then
            [string-concat prim-name ": pure prim body performs memory write/atomic/volatile effect"]
          else Nil in
    let ords = find-orderings ws in
    let align-opt = find-align-nat ws in
    let atomic-ty = first-atomic-ty ws in
    let atomic-v =
          if has-str "load" ws && has-str "atomic" ws then
            let ord-errs = case ords of
                  Cons o rest | same o "release" || same o "acq_rel" ->
                    [string-concat-all [prim-name, ": `load atomic` forbids ordering `", o, "`"]]
                  Nil -> [string-concat prim-name ": `load atomic` missing memory ordering"]
                  other -> Nil in
            let align-errs = case align-opt of
                  None -> [string-concat prim-name ": `load atomic` requires explicit alignment"]
                  Some al ->
                    if not (is-power-of-two-nat al) then [string-concat prim-name ": `load atomic` alignment must be a power of two"]
                    else case atomic-ty of
                      Some ty ->
                        (case llvm-byte-width word-bits ty of
                          Some sz | al < sz -> [string-concat-all [prim-name, ": `load atomic ", ty, "` requires align >= ", nat-to-string sz]]
                          other -> Nil)
                      None ->
                        if has-str "i64" ws && al < 8 then [string-concat prim-name ": `load atomic i64` requires align >= 8"]
                        else if has-str "i32" ws && al < 4 then [string-concat prim-name ": `load atomic i32` requires align >= 4"]
                        else if has-str "ptr" ws && al < ptr-bytes then [string-concat-all [prim-name, ": `load atomic ptr` requires align >= ", nat-to-string ptr-bytes]]
                        else Nil in
            ord-errs <> align-errs
          else if has-str "store" ws && has-str "atomic" ws then
            let ord-errs = case ords of
                  Cons o rest | same o "acquire" || same o "acq_rel" ->
                    [string-concat-all [prim-name, ": `store atomic` forbids ordering `", o, "`"]]
                  Nil -> [string-concat prim-name ": `store atomic` missing memory ordering"]
                  other -> Nil in
            let align-errs = case align-opt of
                  None -> [string-concat prim-name ": `store atomic` requires explicit alignment"]
                  Some al ->
                    if not (is-power-of-two-nat al) then [string-concat prim-name ": `store atomic` alignment must be a power of two"]
                    else case atomic-ty of
                      Some ty ->
                        (case llvm-byte-width word-bits ty of
                          Some sz | al < sz -> [string-concat-all [prim-name, ": `store atomic ", ty, "` requires align >= ", nat-to-string sz]]
                          other -> Nil)
                      None ->
                        if has-str "i64" ws && al < 8 then [string-concat prim-name ": `store atomic i64` requires align >= 8"]
                        else if has-str "i32" ws && al < 4 then [string-concat prim-name ": `store atomic i32` requires align >= 4"]
                        else if has-str "ptr" ws && al < ptr-bytes then [string-concat-all [prim-name, ": `store atomic ptr` requires align >= ", nat-to-string ptr-bytes]]
                        else Nil in
            ord-errs <> align-errs
          else if has-str "fence" ws then
            (case ords of
              Cons o rest | same o "unordered" || same o "monotonic" ->
                [string-concat-all [prim-name, ": `fence` forbids ordering `", o, "`"]]
              Nil -> [string-concat prim-name ": `fence` missing ordering"]
              other -> Nil)
          else if has-str "atomicrmw" ws then
            (case ords of
              Cons o rest | same o "unordered" -> [string-concat prim-name ": `atomicrmw` forbids `unordered`"]
              Nil -> [string-concat prim-name ": `atomicrmw` missing ordering"]
              other -> Nil)
          else if has-str "cmpxchg" ws then
            (case ords of
              Cons s-ord (Cons f-ord rest) ->
                let e1 = if same s-ord "unordered" || same f-ord "unordered" then
                           [string-concat prim-name ": `cmpxchg` forbids `unordered`"]
                         else Nil in
                let e2 = if same f-ord "release" || same f-ord "acq_rel" then
                           [string-concat-all [prim-name, ": `cmpxchg` failure ordering forbids `", f-ord, "`"]]
                         else Nil in
                let e3 = case (atomic-ord-rank s-ord, atomic-ord-rank f-ord) of
                           (Some sr, Some fr) | fr > sr ->
                             [string-concat-all [prim-name, ": `cmpxchg` failure ordering `", f-ord, "` stronger than success ordering `", s-ord, "`"]]
                           other -> Nil in
                e1 <> e2 <> e3
              other -> [string-concat prim-name ": `cmpxchg` requires success and failure orderings"])
          else Nil in
    let asm-v =
          if string-contains "asm " clean && string-contains "syscall" clean then
            if not (string-contains "~{rcx}" clean && string-contains "~{r11}" clean) then
              [string-concat prim-name ": x86_64 `syscall` inline asm must clobber `~{rcx}` and `~{r11}`"]
            else Nil
          else Nil in
    pure-v <> atomic-v <> asm-v

  audit-boundary-lines :: Nat -> String -> Bool -> List String -> List String
  audit-boundary-lines word-bits prim-name is-pure lines = case lines of
    Nil -> Nil
    Cons l rest -> audit-boundary-line word-bits prim-name is-pure l <> audit-boundary-lines word-bits prim-name is-pure rest

  audit-memory-atomic-contract :: String -> Bool -> String -> List String
  audit-memory-atomic-contract prim-name is-pure fragment =
    audit-memory-atomic-contract-for 64 prim-name is-pure fragment

  audit-memory-atomic-contract-for :: Nat -> String -> Bool -> String -> List String
  audit-memory-atomic-contract-for word-bits prim-name is-pure fragment =
    audit-boundary-lines word-bits prim-name is-pure (string-split-on "\n" fragment)

  -- Translation Validation: prove `frag-after` is UB-free, poison-free, and
  -- bit-for-bit identical to `frag-before` with a kernel-checked LRAT proof.
  validate-llvm-equiv :: String -> String -> String -> List PrimParamSpec -> PrimParamSpec -> VerifyOutcome
  validate-llvm-equiv fn-name frag-before frag-after params result =
    let (ub0, g0) = g-bool False empty-sem-graph in
    case init-llvm-params params 0 Nil g0 of
      (binds, vars, g1) ->
        case lower-ir-fragment frag-before binds ub0 g1 of
          Err err-a -> OutcomeOpen (string-concat-all [fn-name, " TV lhs: ", err-a])
          Ok (MkLlvmEnv b1 ub-a g2 None) -> OutcomeOpen (string-concat fn-name " TV lhs has no ret")
          Ok (MkLlvmEnv b1 ub-a g2 (Some ret-a)) ->
            let (ub0-b, g2b) = g-bool False g2 in
            case lower-ir-fragment frag-after binds ub0-b g2b of
              Err err-b -> OutcomeOpen (string-concat-all [fn-name, " TV rhs: ", err-b])
              Ok (MkLlvmEnv b2 ub-b g3 None) -> OutcomeOpen (string-concat fn-name " TV rhs has no ret")
              Ok (MkLlvmEnv b2 ub-b g3 (Some ret-b)) ->
                let (not-ub, g4) = g-not ub-b g3 in
                let (not-p, g5) = g-not (sv-poison ret-b) g4 in
                let (wd, g6) = g-and not-ub not-p g5 in
                let (eq-v, g7) = case (sv-type ret-a, sv-type ret-b) of
                      (SBool, SBool) -> g-intern (NEqBool (sv-val ret-a) (sv-val ret-b)) g6
                      (SBv w1, SBv w2) | w1 == w2 -> g-bv-cmp "eq" w1 (sv-val ret-a) (sv-val ret-b) g6
                      other -> g-bool False g6 in
                let (goal, g8) = g-and wd eq-v g7 in
                run-obligations-cached True "strict" "verify" Nil False g8 [(string-concat "tv:" fn-name, goal)] Nil

  -- ==========================================================================
  -- 14. Core -> LLVM Translation Validation (`cinch verify-codegen`)
  --
  -- Covers:
  --   * Pure scalar & branching functions (`core->llvm`)
  --   * Interprocedural same-module scalar callee inlining & Ackermann UF congruence
  --   * Tail-recursive / bounded loops via inductive loop-step bisimulation (`core->llvm(loop-step)`)
  --   * Aggregate / #[repr(C)] / #[repr(value)] struct & FixedArray stack GEP/load/store forwarding
  --   * Perceus RC / drop-insertion safety validation (`rc-safety`)
  --
  -- TODO(verify-opt): Add Alive2-style LLVM IR-to-IR translation validation across
  -- `opt -O2` / clang optimization passes (`validate-llvm-opt-pass`), comparing
  -- pre-optimization and post-optimization LLVM IR modules for UB/poison refinement.
  -- ==========================================================================

  data TvReport where
    MkTvReport :: String -> String -> String -> String -> TvReport

  tv-report-fn :: TvReport -> String
  tv-report-fn r = case r of MkTvReport f s st d -> f

  tv-report-stage :: TvReport -> String
  tv-report-stage r = case r of MkTvReport f s st d -> s

  tv-report-status :: TvReport -> String
  tv-report-status r = case r of MkTvReport f s st d -> st

  tv-report-details :: TvReport -> String
  tv-report-details r = case r of MkTvReport f s st d -> d

  tv-reports-disproved :: List TvReport -> Nat
  tv-reports-disproved rs = case rs of
    Nil -> 0
    Cons r rest ->
      let n = tv-reports-disproved rest in
      if same (tv-report-status r) "disproved" then n + 1 else n

  tv-reports-verified :: List TvReport -> Nat
  tv-reports-verified rs = case rs of
    Nil -> 0
    Cons r rest ->
      let n = tv-reports-verified rest in
      if same (tv-report-status r) "verified" then n + 1 else n

  tv-reports-count :: List TvReport -> Nat
  tv-reports-count rs = case rs of
    Nil -> 0
    Cons r rest -> 1 + tv-reports-count rest

  tv-upper-status :: String -> String
  tv-upper-status s =
    if same s "verified" then "VERIFIED"
    else if same s "disproved" then "DISPROVED"
    else if same s "rejected" then "REJECTED"
    else if same s "open" then "OPEN"
    else "SKIPPED"

  render-tv-lines :: List TvReport -> String
  render-tv-lines rs = case rs of
    Nil -> ""
    Cons r rest ->
      string-concat-all
        [ "  [", tv-upper-status (tv-report-status r), "] ", tv-report-fn r
        , " (", tv-report-stage r, ") — ", tv-report-details r, "\n"
        , render-tv-lines rest
        ]

  render-tv-reports :: List TvReport -> String
  render-tv-reports rs =
    string-concat-all
      [ render-tv-lines rs
      , "\nverify-codegen summary: functions=", nat-to-string (tv-reports-count rs)
      , " verified=", nat-to-string (tv-reports-verified rs)
      , " disproved=", nat-to-string (tv-reports-disproved rs), "\n"
      ]

  tv-hex-nibble :: Char -> Option Nat
  tv-hex-nibble c =
    let k = char-code c in
    if k >= 48 && k <= 57 then Some (saturating-sub k 48)
    else if k >= 65 && k <= 70 then Some (saturating-sub k 55)
    else if k >= 97 && k <= 102 then Some (saturating-sub k 87)
    else None

  tv-unescape-chars :: List Char -> List Char
  tv-unescape-chars cs = case cs of
    Nil -> Nil
    Cons c (Cons h1 (Cons h2 rest)) | char-code c == 92 ->
      case (tv-hex-nibble h1, tv-hex-nibble h2) of
        (Some n1, Some n2) ->
          (case char-from-code (n1 * 16 + n2) of
            Some ch -> Cons ch (tv-unescape-chars rest)
            None -> Cons c (tv-unescape-chars (Cons h1 (Cons h2 rest))))
        other -> Cons c (tv-unescape-chars (Cons h1 (Cons h2 rest)))
    Cons c rest -> Cons c (tv-unescape-chars rest)

  tv-unescape-llvm-name :: String -> String
  tv-unescape-llvm-name s = pack (tv-unescape-chars (unpack s))

  tv-word-ty-for :: Nat -> UType -> Option (SemType, Bool)
  tv-word-ty-for word-bits ty = case refinement-view ty of
    URefine id nm base pred -> tv-word-ty-for word-bits base
    UCon name k ->
      let short = strip-module-prefix name in
      if same short "Bool" then Some (SBv 64, False)
      else if same short "I8" || same short "I16" || same short "I32" || same short "I64" || same short "Isize" then Some (SBv 64, True)
      else if same short "U8" || same short "U16" || same short "U32" || same short "U64" || same short "Usize" then Some (SBv 64, False)
      else if same short "I128" then Some (SBv 128, True)
      else if same short "U128" then Some (SBv 128, False)
      else None
    other -> None

  tv-coerce-bv :: Nat -> SemType -> SemType -> SemGraph -> Result String (Nat, SemGraph)
  tv-coerce-bv v cur want g = case (cur, want) of
    (SBool, SBool) -> Ok (v, g)
    (SBv w1, SBv w2) | w1 == w2 -> Ok (v, g)
    (SBool, SBv w) ->
      let (one, g1) = g-bv w 1 g in
      let (zero, g2) = g-bv w 0 g1 in
      let (r, g3) = g-ite v one zero g2 in
      Ok (r, g3)
    (SBv w, SBool) ->
      let (zero, g1) = g-bv w 0 g in
      let (eq0, g2) = g-bv-cmp "eq" w v zero g1 in
      let (r, g3) = g-not eq0 g2 in
      Ok (r, g3)
    (SBv fw, SBv tw) | fw < tw ->
      let (r, g1) = g-bv-cast "zext" fw tw v g in Ok (r, g1)
    (SBv fw, SBv tw) | fw > tw ->
      let (r, g1) = g-bv-cast "trunc" fw tw v g in Ok (r, g1)
    other -> Err "cannot coerce semantic value in Core TV"

  tv-lookup-local :: Nat -> List (Nat, Nat, SemType) -> Option (Nat, SemType)
  tv-lookup-local lid env = case env of
    Nil -> None
    Cons (k, v, ty) rest -> if k == lid then Some (v, ty) else tv-lookup-local lid rest

  tv-unroll-core-app :: CoreTerm -> List CoreTerm -> (CoreTerm, List CoreTerm)
  tv-unroll-core-app tm acc = case tm of
    CApply sp ty f a -> tv-unroll-core-app f (Cons a acc)
    CApplyEff sp ty eff f a -> tv-unroll-core-app f (Cons a acc)
    CProved sp ty pf inner -> tv-unroll-core-app inner acc
    CRefine sp ty pf inner -> tv-unroll-core-app inner acc
    CForget sp ty inner -> tv-unroll-core-app inner acc
    CCast sp ty inner -> tv-unroll-core-app inner acc
    CRequire sp ty inner -> tv-unroll-core-app inner acc
    CDischarge sp ty pfs flag inner -> tv-unroll-core-app inner acc
    CPolyElim sp ty inner tys -> tv-unroll-core-app inner acc
    other -> (tm, acc)

  tv-scalar-suffix :: Nat -> String -> Option (Nat, Bool)
  tv-scalar-suffix word-bits suf =
    if same suf "i8" then Some (8, True)
    else if same suf "i16" then Some (16, True)
    else if same suf "i32" then Some (32, True)
    else if same suf "i64" then Some (64, True)
    else if same suf "i128" then Some (128, True)
    else if same suf "u8" then Some (8, False)
    else if same suf "u16" then Some (16, False)
    else if same suf "u32" then Some (32, False)
    else if same suf "u64" then Some (64, False)
    else if same suf "u128" then Some (128, False)
    else if same suf "usize" then Some (word-bits, False)
    else if same suf "isize" then Some (word-bits, True)
    else None

  tv-strip-prefix :: String -> String -> Option String
  tv-strip-prefix pfx s =
    if string-starts-with pfx s then Some (string-slice s (string-length pfx) (string-length s))
    else None

  tv-op-info :: Nat -> String -> Option (String, Nat, Bool)
  tv-op-info word-bits base =
    case tv-strip-prefix "wrapping-add-" base of
      Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("add", w, sg); None -> None)
      None -> case tv-strip-prefix "wrapping-sub-" base of
        Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("sub", w, sg); None -> None)
        None -> case tv-strip-prefix "wrapping-mul-" base of
          Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("mul", w, sg); None -> None)
          None -> case tv-strip-prefix "bit-and-" base of
            Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("and", w, sg); None -> None)
            None -> case tv-strip-prefix "bit-or-" base of
              Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("or", w, sg); None -> None)
              None -> case tv-strip-prefix "bit-xor-" base of
                Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("xor", w, sg); None -> None)
                None -> case tv-strip-prefix "wrapping-shl-" base of
                  Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("shl", w, sg); None -> None)
                  None -> case tv-strip-prefix "wrapping-shr-" base of
                    Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("shr", w, sg); None -> None)
                    None -> case tv-strip-prefix "rotate-left-" base of
                      Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("rotl", w, sg); None -> None)
                      None -> case tv-strip-prefix "rotate-right-" base of
                        Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("rotr", w, sg); None -> None)
                        None -> case tv-strip-prefix "eq-" base of
                          Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("eq", w, sg); None -> None)
                          None -> case tv-strip-prefix "ne-" base of
                            Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("ne", w, sg); None -> None)
                            None -> case tv-strip-prefix "lt-" base of
                              Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("lt", w, sg); None -> None)
                              None -> case tv-strip-prefix "le-" base of
                                Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("le", w, sg); None -> None)
                                None -> case tv-strip-prefix "gt-" base of
                                  Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("gt", w, sg); None -> None)
                                  None -> case tv-strip-prefix "ge-" base of
                                    Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("ge", w, sg); None -> None)
                                    None -> case tv-strip-prefix "bit-not-" base of
                                      Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("not", w, sg); None -> None)
                                      None -> case tv-strip-prefix "wrapping-neg-" base of
                                        Some suf -> (case tv-scalar-suffix word-bits suf of Some (w, sg) -> Some ("neg", w, sg); None -> None)
                                        None -> None

  tv-lower-scalar-call :: Nat -> String -> List (Nat, SemType) -> SemGraph -> Result String (Nat, SemType, SemGraph)
  tv-lower-scalar-call word-bits base args g =
    case (tv-op-info word-bits base, args) of
      (Some ("not", w, sg), Cons (va, ta) Nil) ->
        case tv-coerce-bv va ta (SBv w) g of
          Err e -> Err e
          Ok (a, g1) ->
            let (ones, g2) = g-bv-mask w g1 in
            let (r, g3) = g-bv-bin "xor" w a ones g2 in
            let out-ty = if w == 128 then SBv 128 else SBv 64 in
            (case tv-coerce-bv r (SBv w) out-ty g3 of Err e -> Err e; Ok (rv, g4) -> Ok (rv, out-ty, g4))
      (Some ("neg", w, sg), Cons (va, ta) Nil) ->
        case tv-coerce-bv va ta (SBv w) g of
          Err e -> Err e
          Ok (a, g1) ->
            let (z, g2) = g-bv w 0 g1 in
            let (r, g3) = g-bv-bin "sub" w z a g2 in
            let out-ty = if w == 128 then SBv 128 else SBv 64 in
            (case tv-coerce-bv r (SBv w) out-ty g3 of Err e -> Err e; Ok (rv, g4) -> Ok (rv, out-ty, g4))
      (Some (kind, w, sg), Cons (va, ta) (Cons (vb, tb) Nil)) ->
        case tv-coerce-bv va ta (SBv w) g of
          Err e -> Err e
          Ok (a, g1) ->
            case tv-coerce-bv vb tb (SBv w) g1 of
              Err e -> Err e
              Ok (b, g2) ->
                if same kind "add" || same kind "sub" || same kind "mul" || same kind "and" || same kind "or" || same kind "xor" then
                  let (r, g3) = g-bv-bin kind w a b g2 in
                  let out-ty = if w == 128 then SBv 128 else SBv 64 in
                  (case tv-coerce-bv r (SBv w) out-ty g3 of Err e -> Err e; Ok (rv, g4) -> Ok (rv, out-ty, g4))
                else if same kind "shl" || same kind "shr" then
                  let (mconst, g3) = g-bv w (nat-u64 (saturating-sub w 1)) g2 in
                  let (masked, g4) = g-bv-bin "and" w b mconst g3 in
                  let sop = if same kind "shl" then "shl" else if sg then "ashr" else "lshr" in
                  let (r, g5) = g-bv-bin sop w a masked g4 in
                  let out-ty = if w == 128 then SBv 128 else SBv 64 in
                  (case tv-coerce-bv r (SBv w) out-ty g5 of Err e -> Err e; Ok (rv, g6) -> Ok (rv, out-ty, g6))
                else if same kind "rotl" || same kind "rotr" then
                  let rop = if same kind "rotl" then "fshl" else "fshr" in
                  let (r, g3) = g-intern (NBvTri rop w a a b) g2 in
                  let out-ty = if w == 128 then SBv 128 else SBv 64 in
                  (case tv-coerce-bv r (SBv w) out-ty g3 of Err e -> Err e; Ok (rv, g4) -> Ok (rv, out-ty, g4))
                else
                  let cmp-op =
                        if same kind "eq" then "eq"
                        else if same kind "ne" then "ne"
                        else if same kind "lt" then (if sg then "slt" else "ult")
                        else if same kind "le" then (if sg then "sle" else "ule")
                        else if same kind "gt" then (if sg then "sgt" else "ugt")
                        else if sg then "sge" else "uge" in
                  let (c, g3) = g-bv-cmp cmp-op w a b g2 in
                  (case tv-coerce-bv c SBool (SBv 64) g3 of Err e -> Err e; Ok (rv, g4) -> Ok (rv, SBv 64, g4))
      other -> Err (string-concat "callee is not a modeled pure scalar op in Core TV: " base)

  tv-lower-core-args :: Nat -> List (Nat, Nat, SemType) -> List CoreTerm -> SemGraph -> Result String (List (Nat, SemType), SemGraph)
  tv-lower-core-args word-bits env args g = case args of
    Nil -> Ok (Nil, g)
    Cons a rest ->
      case tv-lower-core-term word-bits env a g of
        Err e -> Err e
        Ok (av, aty, g1) ->
          case tv-lower-core-args word-bits env rest g1 of
            Err e -> Err e
            Ok (more, g2) -> Ok (Cons (av, aty) more, g2)

  tv-prim-args-list :: CoreTerm -> List CoreTerm
  tv-prim-args-list tm = case tm of
    CArgument _ a rest -> Cons a (tv-prim-args-list rest)
    CArgumentsEnd _ -> Nil
    other -> Nil

  tv-lower-core-binop :: Nat -> UType -> String -> (Nat, SemType) -> (Nat, SemType) -> SemGraph -> Result String (Nat, SemType, SemGraph)
  tv-lower-core-binop word-bits arg-ty op pa pb g =
    let (w, sg) = case tv-word-ty-for word-bits arg-ty of
          Some (SBv bw, s) -> (bw, s)
          other -> (64, False) in
    case (pa, pb) of
      ((va, ta), (vb, tb)) ->
        case tv-coerce-bv va ta (SBv w) g of
          Err e -> Err e
          Ok (a, g1) ->
            case tv-coerce-bv vb tb (SBv w) g1 of
              Err e -> Err e
              Ok (b, g2) ->
                let out-ty = if w == 128 then SBv 128 else SBv 64 in
                if same op "+" then let (r, g3) = g-bv-bin "add" w a b g2 in Ok (r, out-ty, g3)
                else if same op "-" then let (r, g3) = g-bv-bin "sub" w a b g2 in Ok (r, out-ty, g3)
                else if same op "*" then let (r, g3) = g-bv-bin "mul" w a b g2 in Ok (r, out-ty, g3)
                else if same op "==" || same op "/=" || same op "<" || same op "<=" || same op ">" || same op ">=" then
                  let cmp-op =
                        if same op "==" then "eq"
                        else if same op "/=" then "ne"
                        else if same op "<" then (if sg then "slt" else "ult")
                        else if same op "<=" then (if sg then "sle" else "ule")
                        else if same op ">" then (if sg then "sgt" else "ugt")
                        else if sg then "sge" else "uge" in
                  let (c, g3) = g-bv-cmp cmp-op w a b g2 in
                  (case tv-coerce-bv c SBool (SBv 64) g3 of Err e -> Err e; Ok (rv, g4) -> Ok (rv, SBv 64, g4))
                else Err (string-concat "unsupported core primitive op in scalar TV: " op)

  tv-lower-core-term :: Nat -> List (Nat, Nat, SemType) -> CoreTerm -> SemGraph -> Result String (Nat, SemType, SemGraph)
  tv-lower-core-term word-bits env tm g = case tm of
    CProved sp ty pf inner -> tv-lower-core-term word-bits env inner g
    CRefine sp ty pf inner -> tv-lower-core-term word-bits env inner g
    CForget sp ty inner -> tv-lower-core-term word-bits env inner g
    CCast sp ty inner -> tv-lower-core-term word-bits env inner g
    CRequire sp ty inner -> tv-lower-core-term word-bits env inner g
    CDischarge sp ty pfs flag inner -> tv-lower-core-term word-bits env inner g
    CPolyElim sp ty inner tys -> tv-lower-core-term word-bits env inner g
    CPrimitive sp ty op arg-spine ->
      case tv-prim-args-list arg-spine of
        Cons a (Cons b Nil) ->
          case tv-lower-core-term word-bits env a g of
            Err e -> Err e
            Ok (va, ta, g1) ->
              case tv-lower-core-term word-bits env b g1 of
                Err e -> Err e
                Ok (vb, tb, g2) -> tv-lower-core-binop word-bits (core-type a) op (va, ta) (vb, tb) g2
        other -> Err (string-concat "unsupported CPrimitive arity in scalar TV: " op)
    CUnit sp ty ->
      let (v, g1) = g-bv 64 0 g in Ok (v, SBv 64, g1)
    CInt sp ty digits ->
      let out-w = case tv-word-ty-for word-bits ty of Some (SBv 128, _) -> (128 :: Nat); other -> (64 :: Nat) in
      case parse-ir-u128 digits of
        Some (lo, hi) -> let (v, g1) = g-bv-pair out-w lo hi g in Ok (v, SBv out-w, g1)
        None -> Err (string-concat "invalid integer literal in Core TV: " digits)
    CLocal sp ty lid nm actuals ->
      case tv-lookup-local lid env of
        Some (v, vty) -> Ok (v, vty, g)
        None -> Err (string-concat "unbound local in Core TV: " nm)
    CUse sp ty nm role actuals ->
      let short = strip-module-prefix nm in
      if same short "True" then let (v, g1) = g-bv 64 1 g in Ok (v, SBv 64, g1)
      else if same short "False" then let (v, g1) = g-bv 64 0 g in Ok (v, SBv 64, g1)
      else Err (string-concat "unsupported bare global in Core TV: " nm)
    CLet sp ty lid nm sch rhs body ->
      case tv-lower-core-term word-bits env rhs g of
        Err e -> Err e
        Ok (rv, rty, g1) -> tv-lower-core-term word-bits (Cons (lid, rv, rty) env) body g1
    CIf sp ty cond th el ->
      case tv-lower-core-term word-bits env cond g of
        Err e -> Err e
        Ok (cv, cty, g1) ->
          case tv-coerce-bv cv cty SBool g1 of
            Err e -> Err e
            Ok (cb, g2) ->
              case tv-lower-core-term word-bits env th g2 of
                Err e -> Err e
                Ok (tv, tty, g3) ->
                  case tv-lower-core-term word-bits env el g3 of
                    Err e -> Err e
                    Ok (ev, ety, g4) ->
                      case tv-coerce-bv ev ety tty g4 of
                        Err e -> Err e
                        Ok (evc, g5) ->
                          let (res, g6) = g-ite cb tv evc g5 in Ok (res, tty, g6)
    CApply sp ty f a ->
      case tv-unroll-core-app tm Nil of
        (CMethod msp mty cls meth slot tys evs, Cons a1 (Cons a2 Nil)) ->
          case tv-lower-core-term word-bits env a1 g of
            Err e -> Err e
            Ok (va, ta, g1) ->
              case tv-lower-core-term word-bits env a2 g1 of
                Err e -> Err e
                Ok (vb, tb, g2) -> tv-lower-core-binop word-bits (core-type a1) meth (va, ta) (vb, tb) g2
        (CUse hsp hty fn-name role actuals, args) ->
          case tv-lower-core-args word-bits env args g of
            Err e -> Err e
            Ok (arg-vals, g1) -> tv-lower-scalar-call word-bits (strip-module-prefix fn-name) arg-vals g1
        other -> Err "unsupported non-direct application in Core TV"
    CApplyEff sp ty eff f a ->
      case tv-unroll-core-app tm Nil of
        (CUse hsp hty fn-name role actuals, args) ->
          case tv-lower-core-args word-bits env args g of
            Err e -> Err e
            Ok (arg-vals, g1) -> tv-lower-scalar-call word-bits (strip-module-prefix fn-name) arg-vals g1
        other -> Err "unsupported effectful application in Core TV"
    other -> Err "unsupported Core term form in scalar TV"

  tv-init-core-params :: Nat -> List CorePattern -> Nat -> SemGraph -> Result String (List (Nat, Nat, SemType), List (String, SemVal), SemGraph)
  tv-init-core-params word-bits pats idx g = case pats of
    Nil -> Ok (Nil, Nil, g)
    Cons pat rest -> case pat of
      CPVar sp ty lid nm ->
        case tv-word-ty-for word-bits ty of
          None -> Err (string-concat "non-scalar parameter in Core TV: " nm)
          Some (sty, sg) ->
            let (pnode, g1) = g-var idx sty nm g in
            let (pfalse, g2) = g-bool False g1 in
            let reg = string-concat "%" (nat-to-string idx) in
            (case tv-init-core-params word-bits rest (idx + 1) g2 of
              Err e -> Err e
              Ok (cenv, lbinds, g3) ->
                Ok (Cons (lid, pnode, sty) cenv, Cons (reg, MkSemVal pnode pfalse sty) lbinds, g3))
      CPWild sp ty ->
        case tv-word-ty-for word-bits ty of
          None -> Err "non-scalar wildcard parameter in Core TV"
          Some (sty, sg) ->
            let (pnode, g1) = g-var idx sty "_" g in
            let (pfalse, g2) = g-bool False g1 in
            let reg = string-concat "%" (nat-to-string idx) in
            (case tv-init-core-params word-bits rest (idx + 1) g2 of
              Err e -> Err e
              Ok (cenv, lbinds, g3) ->
                Ok (cenv, Cons (reg, MkSemVal pnode pfalse sty) lbinds, g3))
      other -> Err "non-variable parameter pattern in Core TV"

  tv-is-reg-char :: Char -> Bool
  tv-is-reg-char c =
    let k = char-code c in
    (k >= 97 && k <= 122) || (k >= 65 && k <= 90) || (k >= 48 && k <= 57) || k == 95 || k == 46

  tv-replace-reg :: String -> String -> String -> String
  tv-replace-reg line old-reg new-reg =
    let flen = string-length old-reg in
    let llen = string-length line in
    if flen == 0 || flen > llen then line
    else tv-replace-reg-at line old-reg new-reg flen llen 0

  tv-replace-reg-at :: String -> String -> String -> Nat -> Nat -> Nat -> String
  tv-replace-reg-at line old-reg new-reg flen llen pos =
    if pos + flen > llen then string-slice line pos llen
    else if same (string-slice line pos (pos + flen)) old-reg then
      let after = pos + flen in
      let boundary =
            if after >= llen then True
            else case unpack (string-slice line after (after + 1)) of
              Cons ch rest -> not (tv-is-reg-char ch)
              Nil -> True in
      if boundary then
        string-concat new-reg (tv-replace-reg-at line old-reg new-reg flen llen after)
      else
        string-concat (string-slice line pos (pos + 1)) (tv-replace-reg-at line old-reg new-reg flen llen (pos + 1))
    else
      string-concat (string-slice line pos (pos + 1)) (tv-replace-reg-at line old-reg new-reg flen llen (pos + 1))

  tv-apply-renames :: List (String, String) -> String -> String
  tv-apply-renames renames line = case renames of
    Nil -> line
    Cons (old-reg, new-reg) rest -> tv-apply-renames rest (tv-replace-reg line old-reg new-reg)

  tv-parse-header-renames :: List String -> Nat -> List (String, String)
  tv-parse-header-renames items idx = case items of
    Nil -> Nil
    Cons item rest ->
      let ws = string-words (string-strip item) in
      case last-nonempty ws of
        Some pname | string-starts-with "%" pname ->
          let canon = string-concat "%" (nat-to-string idx) in
          let more = tv-parse-header-renames rest (idx + 1) in
          if same pname canon then more else Cons (pname, canon) more
        other -> tv-parse-header-renames rest (idx + 1)

  tv-find-define-body :: List String -> String -> Option (List (String, String), List String)
  tv-find-define-body lines needle = case lines of
    Nil -> None
    Cons raw rest ->
      let t = string-strip raw in
      if string-starts-with "define " t && string-contains needle t then
        case string-split-on "(" t of
          Cons pre (Cons after more) ->
            (case string-split-on ")" after of
              Cons pstr tail ->
                let items = if string-length (string-strip pstr) == 0 then Nil else string-split-on "," pstr in
                let renames = tv-parse-header-renames items 0 in
                Some (renames, tv-collect-body-lines rest Nil)
              Nil -> None)
          other -> None
      else tv-find-define-body rest needle

  tv-collect-body-lines :: List String -> List String -> List String
  tv-collect-body-lines lines acc = case lines of
    Nil -> reverse acc
    Cons raw rest ->
      let t = string-strip raw in
      if same t "}" then reverse acc
      else if string-length t == 0 || string-starts-with ";" t then tv-collect-body-lines rest acc
      else if string-starts-with "nexteq" t && string-ends-with ":" t then
        -- Stage 3 emits a dead `nexteqN:\n  unreachable` block after `ret`.
        tv-skip-unreachable-block rest acc
      else tv-collect-body-lines rest (Cons t acc)

  tv-skip-unreachable-block :: List String -> List String -> List String
  tv-skip-unreachable-block lines acc = case lines of
    Nil -> reverse acc
    Cons raw rest ->
      let t = string-strip raw in
      if same t "}" then reverse acc
      else if same t "unreachable" then tv-collect-body-lines rest acc
      else tv-collect-body-lines (Cons raw rest) acc

  tv-parse-call-args :: String -> List String
  tv-parse-call-args arg-str =
    if string-length (string-strip arg-str) == 0 then Nil
    else tv-extract-call-arg-vals (string-split-on "," arg-str)

  tv-extract-call-arg-vals :: List String -> List String
  tv-extract-call-arg-vals items = case items of
    Nil -> Nil
    Cons item rest ->
      case last-nonempty (string-words (string-strip item)) of
        Some v -> Cons v (tv-extract-call-arg-vals rest)
        None -> tv-extract-call-arg-vals rest

  tv-parse-quoted-call :: String -> Option (String, String, String, List String)
  tv-parse-quoted-call line =
    case string-split-on "=" line of
      Cons lhs-raw (Cons rhs-raw more) ->
        let dst = string-strip lhs-raw in
        let rhs = string-strip rhs-raw in
        if string-starts-with "%" dst && string-contains "call " rhs && string-contains "@\"" rhs then
          case string-split-on "@\"" rhs of
            Cons pre (Cons after-q tail) ->
              (case string-split-on "\"" after-q of
                Cons raw-callee (Cons after-name tail2) ->
                  (case string-split-on "(" after-name of
                    Cons p1 (Cons inside tail3) ->
                      (case string-split-on ")" inside of
                        Cons arg-str tail4 ->
                          let ret-ty = case last-nonempty (string-words (string-strip pre)) of Some rt -> rt; None -> "i64" in
                          Some (dst, ret-ty, raw-callee, tv-parse-call-args arg-str)
                        Nil -> None)
                    other -> None)
                other -> None)
            other -> None
        else None
      other -> None

  tv-expand-known-call :: Nat -> Nat -> String -> String -> String -> List String -> Option (List String)
  tv-expand-known-call word-bits idx dst ret-ty base args =
    let pfx = string-concat-all ["%tv", nat-to-string idx, "_"] in
    case (tv-op-info word-bits base, args) of
      (Some ("not", w, sg), Cons a Nil) ->
        let wty = string-concat "i" (nat-to-string w) in
        let in-w = if w == 128 then (128 :: Nat) else (64 :: Nat) in
        let in-ty = string-concat "i" (nat-to-string in-w) in
        if w == in-w then Some [string-concat-all [dst, " = xor ", wty, " ", a, ", -1"]]
        else Some
          [ string-concat-all [pfx, "a = trunc ", in-ty, " ", a, " to ", wty]
          , string-concat-all [pfx, "r = xor ", wty, " ", pfx, "a, -1"]
          , string-concat-all [dst, " = zext ", wty, " ", pfx, "r to ", ret-ty]
          ]
      (Some ("neg", w, sg), Cons a Nil) ->
        let wty = string-concat "i" (nat-to-string w) in
        let in-w = if w == 128 then (128 :: Nat) else (64 :: Nat) in
        let in-ty = string-concat "i" (nat-to-string in-w) in
        if w == in-w then Some [string-concat-all [dst, " = sub ", wty, " 0, ", a]]
        else Some
          [ string-concat-all [pfx, "a = trunc ", in-ty, " ", a, " to ", wty]
          , string-concat-all [pfx, "r = sub ", wty, " 0, ", pfx, "a"]
          , string-concat-all [dst, " = zext ", wty, " ", pfx, "r to ", ret-ty]
          ]
      (Some (kind, w, sg), Cons a (Cons b Nil)) ->
        let wty = string-concat "i" (nat-to-string w) in
        let in-w = if w == 128 then (128 :: Nat) else (64 :: Nat) in
        let in-ty = string-concat "i" (nat-to-string in-w) in
        let ra = if w == in-w then a else string-concat pfx "a" in
        let rb = if w == in-w then b else string-concat pfx "b" in
        let prep =
              if w == in-w then Nil
              else
                [ string-concat-all [ra, " = trunc ", in-ty, " ", a, " to ", wty]
                , string-concat-all [rb, " = trunc ", in-ty, " ", b, " to ", wty]
                ] in
        if same kind "add" || same kind "sub" || same kind "mul" || same kind "and" || same kind "or" || same kind "xor" then
          let rr = if same wty ret-ty then dst else string-concat pfx "r" in
          let op-line = string-concat-all [rr, " = ", kind, " ", wty, " ", ra, ", ", rb] in
          let fin = if same wty ret-ty then Nil else [string-concat-all [dst, " = zext ", wty, " ", rr, " to ", ret-ty]] in
          Some (prep <> Cons op-line fin)
        else if same kind "shl" || same kind "shr" then
          let sop = if same kind "shl" then "shl" else if sg then "ashr" else "lshr" in
          let mask-str = nat-to-string (saturating-sub w 1) in
          let rm = string-concat pfx "m" in
          let rr = if same wty ret-ty then dst else string-concat pfx "r" in
          let lines =
                [ string-concat-all [rm, " = and ", wty, " ", rb, ", ", mask-str]
                , string-concat-all [rr, " = ", sop, " ", wty, " ", ra, ", ", rm]
                ] in
          let fin = if same wty ret-ty then Nil else [string-concat-all [dst, " = zext ", wty, " ", rr, " to ", ret-ty]] in
          Some (prep <> lines <> fin)
        else if same kind "rotl" || same kind "rotr" then
          let rop = if same kind "rotl" then "@llvm.fshl." else "@llvm.fshr." in
          let rr = if same wty ret-ty then dst else string-concat pfx "r" in
          let call-line = string-concat-all [rr, " = call ", wty, " ", rop, wty, "(", wty, " ", ra, ", ", wty, " ", ra, ", ", wty, " ", rb, ")"] in
          let fin = if same wty ret-ty then Nil else [string-concat-all [dst, " = zext ", wty, " ", rr, " to ", ret-ty]] in
          Some (prep <> Cons call-line fin)
        else
          let cmp-op =
                if same kind "eq" then "eq"
                else if same kind "ne" then "ne"
                else if same kind "lt" then (if sg then "slt" else "ult")
                else if same kind "le" then (if sg then "sle" else "ule")
                else if same kind "gt" then (if sg then "sgt" else "ugt")
                else if sg then "sge" else "uge" in
          let rc = string-concat pfx "c" in
          Some (prep <>
            [ string-concat-all [rc, " = icmp ", cmp-op, " ", wty, " ", ra, ", ", rb]
            , string-concat-all [dst, " = zext i1 ", rc, " to ", ret-ty]
            ])
      other -> None

  tv-flatten-linear-lines :: List String -> List String
  tv-flatten-linear-lines ls = case ls of
    Nil -> Nil
    Cons l rest ->
      let t = string-strip l in
      if string-starts-with "br label %" t then
        let tgt = string-concat (string-strip (string-slice t 10 (string-length t))) ":" in
        case rest of
          Cons nxt more | same (string-strip nxt) tgt -> tv-flatten-linear-lines more
          other -> Cons l (tv-flatten-linear-lines rest)
      else if string-ends-with ":" t then tv-flatten-linear-lines rest
      else Cons l (tv-flatten-linear-lines rest)

  tv-has-cfg-branch :: List String -> Bool
  tv-has-cfg-branch ls = case ls of
    Nil -> False
    Cons l rest ->
      let t = string-strip l in
      if string-starts-with "br " t || string-starts-with "switch " t || string-contains "= phi " t then True
      else tv-has-cfg-branch rest

  tv-split-callee-ret :: List String -> List String -> Option (List String, String)
  tv-split-callee-ret ls acc = case ls of
    Nil -> None
    Cons l rest ->
      let t = string-strip l in
      if string-starts-with "ret " t then
        case string-words t of
          Cons "ret" (Cons _ (Cons rv _)) -> Some (reverse acc, rv)
          other -> None
      else tv-split-callee-ret rest (Cons t acc)

  tv-prefix-callee-defs :: String -> List String -> List (String, String)
  tv-prefix-callee-defs pfx ls = case ls of
    Nil -> Nil
    Cons l rest ->
      let more = tv-prefix-callee-defs pfx rest in
      case string-split-on "=" l of
        Cons lhs (Cons _ _) | string-starts-with "%" (string-strip lhs) ->
          let reg = string-strip lhs in
          let bare = string-slice reg 1 (string-length reg) in
          Cons (reg, string-concat pfx bare) more
        other -> more

  tv-bind-arg-renames :: List String -> Nat -> List (String, String)
  tv-bind-arg-renames args idx = case args of
    Nil -> Nil
    Cons a rest -> Cons (string-concat "%" (nat-to-string idx), a) (tv-bind-arg-renames rest (idx + 1))

  tv-try-inline-same-module :: Nat -> List String -> Nat -> String -> String -> List String -> Option (List String, String)
  tv-try-inline-same-module word-bits all-lines idx dst raw-callee args =
    let needle = string-concat-all ["@\"", raw-callee, "\"("] in
    case tv-find-define-body all-lines needle of
      None -> None
      Some (renames, raw-body) ->
        let renamed = tv-map-str (tv-apply-renames renames) raw-body in
        let ssa-lines = case tv-mem2reg-step renamed Nil Nil Nil Nil Nil of Ok ok -> ok; Err _ -> renamed in
        let flat = tv-flatten-linear-lines ssa-lines in
        if tv-has-cfg-branch flat then None
        else case tv-split-callee-ret flat Nil of
          None -> None
          Some (insts, rv) ->
            let pfx = string-concat-all ["%in", nat-to-string idx, "_"] in
            let def-ren = tv-prefix-callee-defs pfx insts in
            let arg-ren = tv-bind-arg-renames args 0 in
            let all-ren = def-ren <> arg-ren in
            let rewritten = tv-map-str (tv-apply-renames all-ren) insts in
            let mapped-rv = tv-apply-renames all-ren rv in
            Some (rewritten, mapped-rv)

  tv-expand-lines-aliased :: Nat -> List String -> List String -> Nat -> List (String, String) -> List String
  tv-expand-lines-aliased word-bits all-lines body idx aliases = case body of
    Nil -> Nil
    Cons raw-line rest ->
      let line = tv-apply-renames aliases raw-line in
      case tv-parse-quoted-call line of
        Some (dst, ret-ty, raw-callee, args) ->
          let decoded = tv-unescape-llvm-name raw-callee in
          let base = strip-module-prefix decoded in
          (case tv-expand-known-call word-bits idx dst ret-ty base args of
            Some expanded -> expanded <> tv-expand-lines-aliased word-bits all-lines rest (idx + 1) aliases
            None ->
              (case tv-try-inline-same-module word-bits all-lines idx dst raw-callee args of
                Some (inlined-insts, mapped-rv) ->
                  let next-insts = tv-expand-lines-aliased word-bits all-lines inlined-insts (idx + 100) Nil in
                  next-insts <> tv-expand-lines-aliased word-bits all-lines rest (idx + 1) (Cons (dst, mapped-rv) aliases)
                None -> Cons line (tv-expand-lines-aliased word-bits all-lines rest (idx + 1) aliases)))
        None -> Cons line (tv-expand-lines-aliased word-bits all-lines rest idx aliases)

  tv-expand-lines :: Nat -> List String -> List String -> Nat -> List String
  tv-expand-lines word-bits all-lines body idx =
    tv-expand-lines-aliased word-bits all-lines body idx Nil

  tv-join-lines :: List String -> String
  tv-join-lines ls = case ls of
    Nil -> ""
    Cons l Nil -> l
    Cons l rest -> string-concat-all [l, "\n", tv-join-lines rest]

  tv-extract-llvm-fragment :: Nat -> String -> String -> Option String
  tv-extract-llvm-fragment word-bits ir-text fn-name =
    let all-lines = string-split-on "\n" ir-text in
    let needle-s3 = string-concat-all ["@\"cinch.typed.m.", fn-name, "\"("] in
    let needle-seed = string-concat-all ["@\"", fn-name, "\"("] in
    let found = case tv-find-define-body all-lines needle-s3 of
          Some res -> Some res
          None -> tv-find-define-body all-lines needle-seed in
    case found of
      None -> None
      Some (renames, raw-body) ->
        let renamed = tv-map-str (tv-apply-renames renames) raw-body in
        let expanded = tv-expand-lines word-bits all-lines renamed 0 in
        Some (tv-join-lines expanded)

  tv-map-str :: (String -> String) -> List String -> List String
  tv-map-str f xs = case xs of
    Nil -> Nil
    Cons h t -> Cons (f h) (tv-map-str f t)

  tv-display-name :: String -> String
  tv-display-name raw =
    if string-starts-with "m." raw then string-slice raw 2 (string-length raw)
    else raw

  -- --------------------------------------------------------------------------
  -- 14a. Symbolic Stack Aggregate & FixedArray Memory Forwarding (`mem2reg`)
  -- --------------------------------------------------------------------------

  tv-scalar-bytes :: String -> Option Nat
  tv-scalar-bytes ty =
    let t = string-strip ty in
    if same t "i1" || same t "i8" then Some 1
    else if same t "i16" then Some 2
    else if same t "i32" || same t "float" then Some 4
    else if same t "i64" || same t "double" || same t "ptr" then Some 8
    else if same t "i128" then Some 16
    else None

  data TvSlotLayout where
    MkTvSlotLayout :: Nat -> Option (Nat, Nat) -> List (Nat, String) -> TvSlotLayout

  tv-slot-size :: TvSlotLayout -> Nat
  tv-slot-size s = case s of MkTvSlotLayout sz arr fs -> sz

  tv-slot-array :: TvSlotLayout -> Option (Nat, Nat)
  tv-slot-array s = case s of MkTvSlotLayout sz arr fs -> arr

  tv-slot-fields :: TvSlotLayout -> List (Nat, String)
  tv-slot-fields s = case s of MkTvSlotLayout sz arr fs -> fs

  tv-align-up :: Nat -> Nat -> Nat
  tv-align-up off al =
    if al <= 1 then off
    else
      let rem = off % al in
      if rem == 0 then off else off + (saturating-sub al rem)

  tv-parse-struct-fields :: List String -> Nat -> List (Nat, String) -> Option (Nat, List (Nat, String))
  tv-parse-struct-fields parts off acc = case parts of
    Nil -> Some (if off == 0 then 1 else off, reverse acc)
    Cons raw rest ->
      let fty = string-strip raw in
      if string-length fty == 0 then tv-parse-struct-fields rest off acc
      else case tv-scalar-bytes fty of
        None -> None
        Some sz ->
          let al = if sz > 16 then 16 else sz in
          let aligned = tv-align-up off al in
          tv-parse-struct-fields rest (aligned + sz) (Cons (aligned, fty) acc)

  tv-parse-alloca-layout :: String -> Option TvSlotLayout
  tv-parse-alloca-layout rest =
    let t = string-strip rest in
    if string-starts-with "{" t then
      case string-split-on "}" (string-slice t 1 (string-length t)) of
        Cons inner more ->
          (case tv-parse-struct-fields (string-split-on "," inner) 0 Nil of
            Some (sz, fields) -> Some (MkTvSlotLayout sz None fields)
            None -> None)
        Nil -> None
    else if string-starts-with "[" t then
      case string-split-on "]" (string-slice t 1 (string-length t)) of
        Cons inner more ->
          (case string-split-on " x " inner of
            Cons cnt-s (Cons ety-s tail) ->
              (case (parse-nat-str (string-strip cnt-s), tv-scalar-bytes (string-strip ety-s)) of
                (Some cnt, Some esz) | cnt <= 1024 ->
                  let total = if cnt * esz == 0 then 1 else cnt * esz in
                  Some (MkTvSlotLayout total (Some (esz, cnt)) Nil)
                other -> None)
            other -> None)
        Nil -> None
    else
      let ty-tok = case string-split-on "," t of Cons h _ -> string-strip h; Nil -> t in
      case tv-scalar-bytes ty-tok of
        Some sz -> Some (MkTvSlotLayout sz None [(0, ty-tok)])
        None -> None

  tv-lookup-layout :: String -> List (String, TvSlotLayout) -> Option TvSlotLayout
  tv-lookup-layout k xs = case xs of
    Nil -> None
    Cons (nm, lay) rest -> if same k nm then Some lay else tv-lookup-layout k rest

  tv-lookup-ptr :: String -> List (String, String, Nat) -> Option (String, Nat)
  tv-lookup-ptr k xs = case xs of
    Nil -> None
    Cons (reg, base, off) rest -> if same k reg then Some (base, off) else tv-lookup-ptr k rest

  tv-lookup-cell :: String -> Nat -> List (String, Nat, String) -> Option String
  tv-lookup-cell base off xs = case xs of
    Nil -> None
    Cons (b, o, val) rest -> if same base b && off == o then Some val else tv-lookup-cell base off rest

  tv-nth-field :: Nat -> List (Nat, String) -> Option (Nat, String)
  tv-nth-field idx xs = case xs of
    Nil -> None
    Cons h rest -> if idx == 0 then Some h else tv-nth-field (saturating-sub idx 1) rest

  tv-split-commas-top :: List Char -> Nat -> List Char -> List String -> List String
  tv-split-commas-top cs depth cur acc = case cs of
    Nil ->
      let s = string-strip (pack (reverse cur)) in
      reverse (if string-length s == 0 then acc else Cons s acc)
    Cons c rest ->
      let k = char-code c in
      if k == 123 || k == 91 || k == 40 || k == 60 then
        tv-split-commas-top rest (depth + 1) (Cons c cur) acc
      else if k == 125 || k == 93 || k == 41 || k == 62 then
        tv-split-commas-top rest (saturating-sub depth 1) (Cons c cur) acc
      else if k == 44 && depth == 0 then
        let s = string-strip (pack (reverse cur)) in
        tv-split-commas-top rest 0 Nil (if string-length s == 0 then acc else Cons s acc)
      else tv-split-commas-top rest depth (Cons c cur) acc

  tv-parse-gep-idx :: String -> Option Nat
  tv-parse-gep-idx item =
    case last-nonempty (string-words (string-strip item)) of
      Some tok -> parse-nat-str tok
      None -> None

  tv-resolve-gep :: String -> List (String, TvSlotLayout) -> List (String, String, Nat) -> Result String (Option (String, Nat))
  tv-resolve-gep rhs layouts ptrs =
    let rest0 = if string-starts-with "getelementptr " rhs then string-strip (string-slice rhs 14 (string-length rhs)) else "" in
    let rest1 = if string-starts-with "inbounds " rest0 then string-strip (string-slice rest0 9 (string-length rest0)) else rest0 in
    let parts = tv-split-commas-top (unpack rest1) 0 Nil Nil in
    case parts of
      Cons gty (Cons ptr-part (Cons idx0-part more-idxs)) ->
        if string-starts-with "ptr " ptr-part then
          let base-reg = string-strip (string-slice ptr-part 4 (string-length ptr-part)) in
          case (tv-lookup-ptr base-reg ptrs, tv-parse-gep-idx idx0-part) of
            (Some (base-slot, base-off), Some i0) ->
              (case tv-lookup-layout base-slot layouts of
                None -> Ok None
                Some lay ->
                  let delta-res =
                        if string-starts-with "{" gty then
                          (case tv-parse-alloca-layout gty of
                            None -> Err "unsupported struct GEP type"
                            Some glay ->
                              let outer = i0 * tv-slot-size glay in
                              case more-idxs of
                                Cons idx1-part _ ->
                                  (case tv-parse-gep-idx idx1-part of
                                    Some fidx ->
                                      (case tv-nth-field fidx (tv-slot-fields glay) of
                                        Some (foff, _) -> Ok (outer + foff)
                                        None -> Err (string-concat "out-of-bounds struct GEP field index on " base-slot))
                                    None -> Err "non-constant struct GEP index")
                                Nil -> Ok outer)
                        else if string-starts-with "[" gty then
                          (case tv-parse-alloca-layout gty of
                            None -> Err "unsupported FixedArray GEP type"
                            Some glay ->
                              let outer = i0 * tv-slot-size glay in
                              case (more-idxs, tv-slot-array glay) of
                                (Cons idx1-part _, Some (esz, cnt)) ->
                                  (case tv-parse-gep-idx idx1-part of
                                    Some eidx ->
                                      if eidx >= cnt then Err (string-concat "out-of-bounds FixedArray GEP index on " base-slot)
                                      else Ok (outer + eidx * esz)
                                    None -> Err "non-constant FixedArray GEP index")
                                other -> Ok outer)
                        else
                          (case tv-scalar-bytes gty of
                            Some esz -> Ok (i0 * esz)
                            None -> Err "unsupported scalar GEP type") in
                  case delta-res of
                    Err e -> Err e
                    Ok delta ->
                      let new-off = base-off + delta in
                      if new-off >= tv-slot-size lay then
                        Err (string-concat "out-of-bounds stack GEP offset on " base-slot)
                      else Ok (Some (base-slot, new-off)))
            other -> Ok None
        else Ok None
      other -> Ok None

  tv-parse-load-op :: String -> Option (String, String, Option Nat)
  tv-parse-load-op rhs =
    if string-starts-with "load " rhs then
      let rest = string-slice rhs 5 (string-length rhs) in
      let parts = tv-split-commas-top (unpack rest) 0 Nil Nil in
      case parts of
        Cons ty-s (Cons ptr-s more) | string-starts-with "ptr " ptr-s ->
          let preg = string-strip (string-slice ptr-s 4 (string-length ptr-s)) in
          let al = find-align-nat (ir-words rhs) in
          Some (string-strip ty-s, preg, al)
        other -> None
    else None

  tv-parse-store-op :: String -> Option (String, String, String, Option Nat)
  tv-parse-store-op line =
    if string-starts-with "store " line then
      let rest = string-slice line 6 (string-length line) in
      let parts = tv-split-commas-top (unpack rest) 0 Nil Nil in
      case parts of
        Cons val-s (Cons ptr-s more) | string-starts-with "ptr " ptr-s ->
          let preg = string-strip (string-slice ptr-s 4 (string-length ptr-s)) in
          let vws = string-words val-s in
          (case vws of
            Cons ty-tok (Cons v-tok _) -> Some (ty-tok, v-tok, preg, find-align-nat (ir-words line))
            other -> None)
        other -> None
    else None

  tv-mem2reg-step :: List String -> List (String, TvSlotLayout) -> List (String, String, Nat) -> List (String, Nat, String) -> List (String, String) -> List String -> Result String (List String)
  tv-mem2reg-step lines layouts ptrs cells aliases acc = case lines of
    Nil -> Ok (reverse acc)
    Cons raw rest ->
      let line = tv-apply-renames aliases (string-strip raw) in
      if string-length line == 0 || string-starts-with ";" line then
        tv-mem2reg-step rest layouts ptrs cells aliases acc
      else case tv-parse-store-op line of
        Some (sty, sval, preg, al-opt) ->
          (case tv-lookup-ptr preg ptrs of
            Some (base-slot, off) ->
              (case tv-lookup-layout base-slot layouts of
                Some lay ->
                  let sz = case tv-scalar-bytes sty of Some n -> n; None -> 8 in
                  if off + sz > tv-slot-size lay then
                    Err (string-concat "out-of-bounds stack store on " base-slot)
                  else case al-opt of
                    Some al | al == 0 || not (is-power-of-two-nat al) || (off % al /= 0) ->
                      Err (string-concat "misaligned stack store on " base-slot)
                    other ->
                      tv-mem2reg-step rest layouts ptrs (Cons (base-slot, off, sval) cells) aliases acc
                None -> tv-mem2reg-step rest layouts ptrs cells aliases (Cons line acc))
            None -> tv-mem2reg-step rest layouts ptrs cells aliases (Cons line acc))
        None ->
          case string-split-on "=" line of
            Cons lhs-raw (Cons rhs-raw more) | string-starts-with "%" (string-strip lhs-raw) ->
              let reg = string-strip lhs-raw in
              let rhs = string-strip rhs-raw in
              if string-starts-with "alloca " rhs then
                (case tv-parse-alloca-layout (string-slice rhs 7 (string-length rhs)) of
                  Some lay ->
                    tv-mem2reg-step rest (Cons (reg, lay) layouts) (Cons (reg, reg, 0) ptrs) cells aliases acc
                  None -> tv-mem2reg-step rest layouts ptrs cells aliases (Cons line acc))
              else if string-starts-with "getelementptr " rhs then
                (case tv-resolve-gep rhs layouts ptrs of
                  Err e -> Err e
                  Ok (Some (base-slot, off)) ->
                    tv-mem2reg-step rest layouts (Cons (reg, base-slot, off) ptrs) cells aliases acc
                  Ok None -> tv-mem2reg-step rest layouts ptrs cells aliases (Cons line acc))
              else case tv-parse-load-op rhs of
                Some (lty, preg, al-opt) ->
                  (case tv-lookup-ptr preg ptrs of
                    Some (base-slot, off) ->
                      (case tv-lookup-layout base-slot layouts of
                        Some lay ->
                          let sz = case tv-scalar-bytes lty of Some n -> n; None -> 8 in
                          if off + sz > tv-slot-size lay then
                            Err (string-concat "out-of-bounds stack load on " base-slot)
                          else case al-opt of
                            Some al | al == 0 || not (is-power-of-two-nat al) || (off % al /= 0) ->
                              Err (string-concat "misaligned stack load on " base-slot)
                            other ->
                              (case tv-lookup-cell base-slot off cells of
                                Some val ->
                                  tv-mem2reg-step rest layouts ptrs cells (Cons (reg, val) aliases) acc
                                None -> tv-mem2reg-step rest layouts ptrs cells aliases (Cons line acc))
                        None -> tv-mem2reg-step rest layouts ptrs cells aliases (Cons line acc))
                    None -> tv-mem2reg-step rest layouts ptrs cells aliases (Cons line acc))
                None -> tv-mem2reg-step rest layouts ptrs cells aliases (Cons line acc)
            other -> tv-mem2reg-step rest layouts ptrs cells aliases (Cons line acc)

  tv-symbolic-mem2reg :: String -> Result String String
  tv-symbolic-mem2reg frag =
    case tv-mem2reg-step (string-split-on "\n" frag) Nil Nil Nil Nil Nil of
      Err e -> Err e
      Ok out -> Ok (tv-join-lines out)

  -- Prove two LLVM fragments with local #[repr(C)] / #[repr(value)] struct or
  -- FixedArray stack alloca/getelementptr/load/store ops are bounds-safe,
  -- alignment-safe, UB/poison-free, and bit-for-bit identical via LRAT.
  validate-llvm-memory-equiv :: String -> String -> String -> List PrimParamSpec -> PrimParamSpec -> VerifyOutcome
  validate-llvm-memory-equiv fn-name frag-before frag-after params result =
    case tv-symbolic-mem2reg frag-before of
      Err e -> OutcomeDisproved (string-concat-all [fn-name, " memory safety violation (lhs): ", e])
      Ok ssa-before ->
        case tv-symbolic-mem2reg frag-after of
          Err e -> OutcomeDisproved (string-concat-all [fn-name, " memory safety violation (rhs): ", e])
          Ok ssa-after -> validate-llvm-equiv fn-name ssa-before ssa-after params result

  -- --------------------------------------------------------------------------
  -- 14b. Perceus RC / Drop-Insertion Safety Validator (`stage: "rc-safety"`)
  -- --------------------------------------------------------------------------

  tv-classify-rc-call :: String -> Option (String, String)
  tv-classify-rc-call line =
    let t = string-strip line in
    if not (string-contains "call " t) then None
    else
      let kind =
            if string-contains "@cinch.rc.dup.obj(" t || string-contains "@\"cinch.rc.dup.obj\"(" t
              || string-contains "@cinch.rc.dup.tobj(" t || string-contains "@\"cinch.rc.dup.tobj\"(" t
              || string-contains "@cinch_dup(" t || string-contains "@cinch_dup_mt(" t then Some "dup"
            else if string-contains "@cinch.rc.drop.obj(" t || string-contains "@\"cinch.rc.drop.obj\"(" t
              || string-contains "@cinch.rc.drop.tobj(" t || string-contains "@\"cinch.rc.drop.tobj\"(" t
              || string-contains "@cinch_drop(" t || string-contains "@cinch_drop_slow(" t
              || string-contains "@cinch_drop_mt(" t || string-contains "@cinch_free(" t
              || string-contains "@cinch_frame_release(" t then Some "drop"
            else None in
      case kind of
        None -> None
        Some k ->
          (case string-split-on "(" t of
            Cons pre (Cons inside _) ->
              (case string-split-on ")" inside of
                Cons arg-str _ ->
                  let first-arg = case string-split-on "," arg-str of Cons h _ -> h; Nil -> arg-str in
                  (case last-nonempty (string-words (string-strip first-arg)) of
                    Some reg -> Some (k, reg)
                    None -> None)
                Nil -> None)
            other -> None)

  tv-lookup-str :: String -> List (String, String) -> Option String
  tv-lookup-str k xs = case xs of
    Nil -> None
    Cons (a, b) rest -> if same k a then Some b else tv-lookup-str k rest

  tv-lookup-rc :: String -> List (String, (Int, Int)) -> Option (Int, Int)
  tv-lookup-rc k xs = case xs of
    Nil -> None
    Cons (a, b) rest -> if same k a then Some b else tv-lookup-rc k rest

  tv-set-rc :: String -> (Int, Int) -> List (String, (Int, Int)) -> List (String, (Int, Int))
  tv-set-rc k v xs = case xs of
    Nil -> [(k, v)]
    Cons (a, b) rest -> if same k a then Cons (a, v) rest else Cons (a, b) (tv-set-rc k v rest)

  tv-dec-lo :: Int -> Int
  tv-dec-lo lo = if lo > 0 then lo - 1 else 0

  tv-rc-check-leaks :: List String -> List (String, (Int, Int)) -> List String
  tv-rc-check-leaks touched rc-map = case touched of
    Nil -> Nil
    Cons h rest ->
      let lo = case tv-lookup-rc h rc-map of Some (l, _) -> l; None -> 0 in
      let more = tv-rc-check-leaks rest rc-map in
      if lo > 0 then Cons (string-concat-all ["RC leak on ", h, " at ret (remaining rc>=", int-to-string lo, ")"]) more
      else more

  tv-rc-check-call-args :: List String -> List (String, String) -> List String -> List (String, (Int, Int)) -> (List (String, (Int, Int)), List String)
  tv-rc-check-call-args args reg-h touched rc-map = case args of
    Nil -> (rc-map, Nil)
    Cons a rest ->
      let (rc1, errs1) = case tv-lookup-str a reg-h of
            Some h | has-str h touched ->
              let (lo, hi) = case tv-lookup-rc h rc-map of Some p -> p; None -> (1, 1) in
              if hi <= 0 then (rc-map, [string-concat-all ["use-after-free passing dropped handle ", h, " to call"]])
              else (tv-set-rc h (tv-dec-lo lo, hi) rc-map, Nil)
            other -> (rc-map, Nil) in
      let (rc2, more) = tv-rc-check-call-args rest reg-h touched rc1 in
      (rc2, errs1 <> more)

  tv-rc-walk-lines :: List String -> List (String, String) -> List (String, String) -> List String -> List (String, (Int, Int)) -> List String -> Nat -> Nat -> List String -> (Nat, Nat, List String)
  tv-rc-walk-lines lines reg-h slot-h local-allocas rc-map touched dups drops errs = case lines of
    Nil -> (dups, drops, reverse errs)
    Cons raw rest ->
      let line = string-strip raw in
      if string-length line == 0 || string-starts-with ";" line || string-ends-with ":" line then
        tv-rc-walk-lines rest reg-h slot-h local-allocas rc-map touched dups drops errs
      else case tv-classify-rc-call line of
        Some (kind, arg-reg) ->
          let hdl = case tv-lookup-str arg-reg reg-h of Some h -> h; None -> arg-reg in
          let touched1 = if has-str hdl touched then touched else Cons hdl touched in
          let (lo, hi) = case tv-lookup-rc hdl rc-map of
                Some p -> p
                None -> if same kind "dup" then (0, 1) else (1, 1) in
          if same kind "dup" then
            if hi <= 0 then
              tv-rc-walk-lines rest reg-h slot-h local-allocas rc-map touched1 (dups + 1) drops
                (Cons (string-concat-all ["use-after-free on dup of ", hdl]) errs)
            else
              tv-rc-walk-lines rest reg-h slot-h local-allocas (tv-set-rc hdl (lo + 1, hi + 1) rc-map) touched1 (dups + 1) drops errs
          else
            if hi <= 0 then
              tv-rc-walk-lines rest reg-h slot-h local-allocas rc-map touched1 dups (drops + 1)
                (Cons (string-concat-all ["double-free / over-release on drop of ", hdl]) errs)
            else
              tv-rc-walk-lines rest reg-h slot-h local-allocas (tv-set-rc hdl (tv-dec-lo lo, hi - 1) rc-map) touched1 dups (drops + 1) errs
        None ->
          case tv-parse-store-op line of
            Some (sty, sval, slot, _) ->
              (case tv-lookup-str sval reg-h of
                Some h ->
                  let (lo, hi) = case tv-lookup-rc h rc-map of Some p -> p; None -> (1, 1) in
                  let errs1 =
                        if has-str h touched && hi <= 0 then
                          Cons (string-concat-all ["use-after-free storing dropped handle ", h]) errs
                        else errs in
                  if has-str slot local-allocas then
                    tv-rc-walk-lines rest reg-h (Cons (slot, h) slot-h) local-allocas rc-map touched dups drops errs1
                  else
                    -- Store into heap field transfers ownership.
                    let rc1 = if has-str h touched then tv-set-rc h (tv-dec-lo lo, hi) rc-map else rc-map in
                    tv-rc-walk-lines rest reg-h slot-h local-allocas rc1 touched dups drops errs1
                None -> tv-rc-walk-lines rest reg-h slot-h local-allocas rc-map touched dups drops errs)
            None ->
              if string-starts-with "ret " line then
                let ws = string-words line in
                let (rc1, errs1) = case ws of
                      Cons "ret" (Cons rty (Cons rreg _)) ->
                        (case tv-lookup-str rreg reg-h of
                          Some h | has-str h touched ->
                            let (lo, hi) = case tv-lookup-rc h rc-map of Some p -> p; None -> (1, 1) in
                            if hi <= 0 then (rc-map, Cons (string-concat-all ["use-after-free returning dropped handle ", h]) errs)
                            else (tv-set-rc h (tv-dec-lo lo, hi - 1) rc-map, errs)
                          other -> (rc-map, errs))
                      other -> (rc-map, errs) in
                let leak-errs = tv-rc-check-leaks touched rc1 in
                tv-rc-walk-lines rest reg-h slot-h local-allocas rc1 touched dups drops (leak-errs <> errs1)
              else if string-starts-with "call " line || string-starts-with "tail call " line then
                let call-args = case string-split-on "(" line of
                      Cons _ (Cons inside _) ->
                        (case string-split-on ")" inside of Cons astr _ -> tv-parse-call-args astr; Nil -> Nil)
                      other -> Nil in
                let (rc1, arg-errs) = tv-rc-check-call-args call-args reg-h touched rc-map in
                tv-rc-walk-lines rest reg-h slot-h local-allocas rc1 touched dups drops (arg-errs <> errs)
              else case string-split-on "=" line of
                Cons lhs-raw (Cons rhs-raw _) | string-starts-with "%" (string-strip lhs-raw) ->
                  let dst = string-strip lhs-raw in
                  let rhs = string-strip rhs-raw in
                  if string-starts-with "alloca " rhs then
                    tv-rc-walk-lines rest reg-h slot-h (Cons dst local-allocas) rc-map touched dups drops errs
                  else (case tv-parse-load-op rhs of
                    Some (lty, slot, _) ->
                      (case tv-lookup-str slot slot-h of
                        Some h -> tv-rc-walk-lines rest (Cons (dst, h) reg-h) slot-h local-allocas rc-map touched dups drops errs
                        None -> tv-rc-walk-lines rest reg-h slot-h local-allocas rc-map touched dups drops errs)
                    None ->
                      if string-starts-with "inttoptr " rhs || string-starts-with "bitcast " rhs then
                        let ws = string-words rhs in
                        (case ws of
                          Cons _ (Cons _ (Cons src _)) ->
                            (case tv-lookup-str src reg-h of
                              Some h ->
                                let (lo, hi) = case tv-lookup-rc h rc-map of Some p -> p; None -> (1, 1) in
                                let errs1 =
                                      if has-str h touched && hi <= 0 then
                                        Cons (string-concat-all ["use-after-free dereferencing dropped handle ", h]) errs
                                      else errs in
                                tv-rc-walk-lines rest (Cons (dst, h) reg-h) slot-h local-allocas rc-map touched dups drops errs1
                              None -> tv-rc-walk-lines rest reg-h slot-h local-allocas rc-map touched dups drops errs)
                          other -> tv-rc-walk-lines rest reg-h slot-h local-allocas rc-map touched dups drops errs)
                      else if string-contains "call " rhs then
                        let call-args = case string-split-on "(" rhs of
                              Cons _ (Cons inside _) ->
                                (case string-split-on ")" inside of Cons astr _ -> tv-parse-call-args astr; Nil -> Nil)
                              other -> Nil in
                        let (rc1, arg-errs) = tv-rc-check-call-args call-args reg-h touched rc-map in
                        tv-rc-walk-lines rest (Cons (dst, dst) reg-h) slot-h local-allocas (tv-set-rc dst (1, 1) rc1) touched dups drops (arg-errs <> errs)
                      else tv-rc-walk-lines rest reg-h slot-h local-allocas rc-map touched dups drops errs)
                other -> tv-rc-walk-lines rest reg-h slot-h local-allocas rc-map touched dups drops errs

  tv-init-rc-params :: List String -> (List (String, String), List (String, (Int, Int)))
  tv-init-rc-params ps = case ps of
    Nil -> (Nil, Nil)
    Cons p rest ->
      case tv-init-rc-params rest of
        (rh, rm) -> (Cons (p, p) rh, Cons (p, (1, 1)) rm)

  tv-extract-header-params :: List String -> List String
  tv-extract-header-params items = case items of
    Nil -> Nil
    Cons item rest ->
      case last-nonempty (string-words (string-strip item)) of
        Some p | string-starts-with "%" p -> Cons p (tv-extract-header-params rest)
        other -> tv-extract-header-params rest

  tv-find-define-with-params :: List String -> String -> Option (List String, List String)
  tv-find-define-with-params lines needle = case lines of
    Nil -> None
    Cons raw rest ->
      let t = string-strip raw in
      if string-starts-with "define " t && string-contains needle t then
        case string-split-on "(" t of
          Cons pre (Cons after _) ->
            (case string-split-on ")" after of
              Cons pstr _ ->
                let items = if string-length (string-strip pstr) == 0 then Nil else string-split-on "," pstr in
                Some (tv-extract-header-params items, tv-collect-body-lines rest Nil)
              Nil -> None)
          other -> None
      else tv-find-define-with-params rest needle

  -- Audit one emitted LLVM function for Perceus RC / drop-insertion safety.
  validate-fn-rc-safety :: String -> String -> Option TvReport
  validate-fn-rc-safety fn-name ir-text =
    let all-lines = string-split-on "\n" ir-text in
    let needle-s3 = string-concat-all ["@\"cinch.typed.m.", fn-name, "\"("] in
    let needle-seed = string-concat-all ["@\"", fn-name, "\"("] in
    let found = case tv-find-define-with-params all-lines needle-s3 of
          Some res -> Some res
          None -> tv-find-define-with-params all-lines needle-seed in
    case found of
      None -> None
      Some (pnames, body-lines) ->
        let (rh0, rm0) = tv-init-rc-params pnames in
        case tv-rc-walk-lines body-lines rh0 Nil Nil rm0 Nil 0 0 Nil of
          (dups, drops, errs) ->
            if dups == 0 && drops == 0 then None
            else case errs of
              Nil -> Some (MkTvReport fn-name "rc-safety" "verified"
                (string-concat-all ["balanced Perceus RC (", nat-to-string dups, " dup, ", nat-to-string drops, " drop)"]))
              Cons _ _ -> Some (MkTvReport fn-name "rc-safety" "disproved" (join-str "; " errs))

  tv-collect-define-names :: List String -> String -> List String
  tv-collect-define-names lines prefix = case lines of
    Nil -> Nil
    Cons raw rest ->
      let t = string-strip raw in
      let more = tv-collect-define-names rest prefix in
      if string-starts-with "define " t && string-contains "@\"" t then
        case string-split-on "@\"" t of
          Cons _ (Cons after _) ->
            (case string-split-on "\"" after of
              Cons fname _ ->
                let disp = if string-starts-with "cinch.typed.m." fname then string-slice fname 14 (string-length fname) else fname in
                if string-starts-with prefix disp
                  && not (string-ends-with ".app" disp)
                  && not (string-ends-with ".exit" disp)
                  && not (string-ends-with ".wrap" disp) then Cons disp more else more
              Nil -> more)
          other -> more
      else more

  tv-audit-rc-names :: List String -> String -> List TvReport
  tv-audit-rc-names names ir-text = case names of
    Nil -> Nil
    Cons nm rest ->
      case validate-fn-rc-safety nm ir-text of
        Some rep -> Cons rep (tv-audit-rc-names rest ir-text)
        None -> tv-audit-rc-names rest ir-text

  validate-module-rc-safety :: String -> String -> List TvReport
  validate-module-rc-safety ir-text prefix =
    tv-audit-rc-names (tv-collect-define-names (string-split-on "\n" ir-text) prefix) ir-text

  -- --------------------------------------------------------------------------
  -- 14c. Interprocedural Inlining & Tail-Loop Bisimulation in Core -> LLVM TV
  -- --------------------------------------------------------------------------

  tv-find-core-def :: String -> List CoreDefinition -> Option CoreDefinition
  tv-find-core-def tgt-nm defs = case defs of
    Nil -> None
    Cons d rest ->
      if same (tv-display-name d.name) tgt-nm || same (strip-module-prefix (tv-display-name d.name)) tgt-nm then Some d
      else tv-find-core-def tgt-nm rest

  tv-has-self-tail-call :: String -> CoreTerm -> Bool
  tv-has-self-tail-call self-disp tm = case tm of
    CProved sp ty pf inner -> tv-has-self-tail-call self-disp inner
    CRefine sp ty pf inner -> tv-has-self-tail-call self-disp inner
    CForget sp ty inner -> tv-has-self-tail-call self-disp inner
    CCast sp ty inner -> tv-has-self-tail-call self-disp inner
    CRequire sp ty inner -> tv-has-self-tail-call self-disp inner
    CDischarge sp ty pfs flag inner -> tv-has-self-tail-call self-disp inner
    CPolyElim sp ty inner tys -> tv-has-self-tail-call self-disp inner
    CLet sp ty lid nm sch rhs body -> tv-has-self-tail-call self-disp body
    CIf sp ty cond th el -> tv-has-self-tail-call self-disp th || tv-has-self-tail-call self-disp el
    CApply sp ty f a ->
      case tv-unroll-core-app tm Nil of
        (CUse hsp hty fn-name role actuals, args) ->
          same (tv-display-name fn-name) self-disp || same (strip-module-prefix (tv-display-name fn-name)) (strip-module-prefix self-disp)
        other -> False
    other -> False

  tv-bind-inline-params :: Nat -> List CorePattern -> List (Nat, SemType) -> SemGraph -> Result String (List (Nat, Nat, SemType), SemGraph)
  tv-bind-inline-params word-bits pats args g = case (pats, args) of
    (Nil, Nil) -> Ok (Nil, g)
    (Cons (CPVar sp ty lid nm) pr, Cons (av, aty) ar) ->
      (case tv-word-ty-for word-bits ty of
        None -> Err "non-scalar inlined callee parameter"
        Some (pty, _) ->
          (case tv-coerce-bv av aty pty g of
            Err e -> Err e
            Ok (ac, g1) ->
              (case tv-bind-inline-params word-bits pr ar g1 of
                Err e -> Err e
                Ok (more, g2) -> Ok (Cons (lid, ac, pty) more, g2))))
    other -> Err "inlined callee arity mismatch"

  tv-lower-core-args-defs :: Nat -> Nat -> List CoreDefinition -> List (Nat, Nat, SemType) -> List CoreTerm -> SemGraph -> Result String (List (Nat, SemType), SemGraph)
  tv-lower-core-args-defs word-bits depth all-defs env args g = case args of
    Nil -> Ok (Nil, g)
    Cons a rest ->
      case tv-lower-core-term-defs word-bits depth all-defs env a g of
        Err e -> Err e
        Ok (av, aty, g1) ->
          case tv-lower-core-args-defs word-bits depth all-defs env rest g1 of
            Err e -> Err e
            Ok (more, g2) -> Ok (Cons (av, aty) more, g2)

  tv-lower-core-term-defs :: Nat -> Nat -> List CoreDefinition -> List (Nat, Nat, SemType) -> CoreTerm -> SemGraph -> Result String (Nat, SemType, SemGraph)
  tv-lower-core-term-defs word-bits depth all-defs env tm g = case tm of
    CProved sp ty pf inner -> tv-lower-core-term-defs word-bits depth all-defs env inner g
    CRefine sp ty pf inner -> tv-lower-core-term-defs word-bits depth all-defs env inner g
    CForget sp ty inner -> tv-lower-core-term-defs word-bits depth all-defs env inner g
    CCast sp ty inner -> tv-lower-core-term-defs word-bits depth all-defs env inner g
    CRequire sp ty inner -> tv-lower-core-term-defs word-bits depth all-defs env inner g
    CDischarge sp ty pfs flag inner -> tv-lower-core-term-defs word-bits depth all-defs env inner g
    CPolyElim sp ty inner tys -> tv-lower-core-term-defs word-bits depth all-defs env inner g
    CLet sp ty lid nm sch rhs body ->
      case tv-lower-core-term-defs word-bits depth all-defs env rhs g of
        Err e -> Err e
        Ok (rv, rty, g1) -> tv-lower-core-term-defs word-bits depth all-defs (Cons (lid, rv, rty) env) body g1
    CIf sp ty cond th el ->
      case tv-lower-core-term-defs word-bits depth all-defs env cond g of
        Err e -> Err e
        Ok (cv, cty, g1) ->
          case tv-coerce-bv cv cty SBool g1 of
            Err e -> Err e
            Ok (cb, g2) ->
              case tv-lower-core-term-defs word-bits depth all-defs env th g2 of
                Err e -> Err e
                Ok (tv, tty, g3) ->
                  case tv-lower-core-term-defs word-bits depth all-defs env el g3 of
                    Err e -> Err e
                    Ok (ev, ety, g4) ->
                      case tv-coerce-bv ev ety tty g4 of
                        Err e -> Err e
                        Ok (evc, g5) ->
                          let (res, g6) = g-ite cb tv evc g5 in Ok (res, tty, g6)
    CPrimitive sp ty op arg-spine ->
      case tv-prim-args-list arg-spine of
        Cons a (Cons b Nil) ->
          case tv-lower-core-term-defs word-bits depth all-defs env a g of
            Err e -> Err e
            Ok (va, ta, g1) ->
              case tv-lower-core-term-defs word-bits depth all-defs env b g1 of
                Err e -> Err e
                Ok (vb, tb, g2) -> tv-lower-core-binop word-bits (core-type a) op (va, ta) (vb, tb) g2
        other -> Err (string-concat "unsupported CPrimitive arity in scalar TV: " op)
    CApply sp ty f a ->
      case tv-unroll-core-app tm Nil of
        (CMethod msp mty cls meth slot tys evs, Cons a1 (Cons a2 Nil)) ->
          case tv-lower-core-term-defs word-bits depth all-defs env a1 g of
            Err e -> Err e
            Ok (va, ta, g1) ->
              case tv-lower-core-term-defs word-bits depth all-defs env a2 g1 of
                Err e -> Err e
                Ok (vb, tb, g2) -> tv-lower-core-binop word-bits (core-type a1) meth (va, ta) (vb, tb) g2
        (CUse hsp hty fn-name role actuals, args) ->
          case tv-lower-core-args-defs word-bits depth all-defs env args g of
            Err e -> Err e
            Ok (arg-vals, g1) ->
              let base = strip-module-prefix fn-name in
              (case tv-lower-scalar-call word-bits base arg-vals g1 of
                Ok res -> Ok res
                Err scalar-err ->
                  if depth < 4 then
                    let tgt-nm = tv-display-name fn-name in
                    (case tv-find-core-def tgt-nm all-defs of
                      Some cdef ->
                        (case cdef.clauses of
                          Cons (CoreClause csp cpats cbody) Nil ->
                            (case tv-bind-inline-params word-bits cpats arg-vals g1 of
                              Err e -> Err scalar-err
                              Ok (sub-env, g2) ->
                                tv-lower-core-term-defs word-bits (depth + 1) all-defs sub-env cbody g2)
                          other -> Err scalar-err)
                      None -> Err scalar-err)
                  else Err scalar-err)
        other -> Err "unsupported non-direct application in Core TV"
    other -> tv-lower-core-term word-bits env tm g

  -- Inductive 1-step Core lowering for tail-recursive functions:
  -- returns `(done, ret-val, next-params)` where `done=True` on base-case return
  -- and `done=False` on self tail-call with updated loop arguments.
  tv-coerce-list :: List (Nat, SemType) -> List SemType -> SemGraph -> Result String (List Nat, SemGraph)
  tv-coerce-list vals tys g = case (vals, tys) of
    (Nil, Nil) -> Ok (Nil, g)
    (Cons (v, vt) vr, Cons want tr) ->
      case tv-coerce-bv v vt want g of
        Err e -> Err e
        Ok (vc, g1) ->
          case tv-coerce-list vr tr g1 of
            Err e -> Err e
            Ok (more, g2) -> Ok (Cons vc more, g2)
    other -> Err "tail-call arity mismatch"

  tv-ite-list :: Nat -> List Nat -> List Nat -> SemGraph -> (List Nat, SemGraph)
  tv-ite-list cond xs ys g = case (xs, ys) of
    (Cons x xr, Cons y yr) ->
      let (z, g1) = g-ite cond x y g in
      let (more, g2) = tv-ite-list cond xr yr g1 in
      (Cons z more, g2)
    other -> (Nil, g)

  tv-zero-for-ty :: SemType -> SemGraph -> (Nat, SemGraph)
  tv-zero-for-ty ty g = case ty of
    SBool -> g-bool False g
    SBv w -> g-bv w 0 g
    other -> g-bv 64 0 g

  tv-lower-core-tail-step :: Nat -> String -> List CoreDefinition -> List (Nat, SemType) -> SemType -> List (Nat, Nat, SemType) -> CoreTerm -> SemGraph -> Result String (Nat, Nat, List Nat, SemGraph)
  tv-lower-core-tail-step word-bits self-disp all-defs param-nodes ret-sty env tm g = case tm of
    CProved sp ty pf inner -> tv-lower-core-tail-step word-bits self-disp all-defs param-nodes ret-sty env inner g
    CRefine sp ty pf inner -> tv-lower-core-tail-step word-bits self-disp all-defs param-nodes ret-sty env inner g
    CForget sp ty inner -> tv-lower-core-tail-step word-bits self-disp all-defs param-nodes ret-sty env inner g
    CCast sp ty inner -> tv-lower-core-tail-step word-bits self-disp all-defs param-nodes ret-sty env inner g
    CRequire sp ty inner -> tv-lower-core-tail-step word-bits self-disp all-defs param-nodes ret-sty env inner g
    CDischarge sp ty pfs flag inner -> tv-lower-core-tail-step word-bits self-disp all-defs param-nodes ret-sty env inner g
    CPolyElim sp ty inner tys -> tv-lower-core-tail-step word-bits self-disp all-defs param-nodes ret-sty env inner g
    CLet sp ty lid nm sch rhs body ->
      case tv-lower-core-term-defs word-bits 0 all-defs env rhs g of
        Err e -> Err e
        Ok (rv, rty, g1) -> tv-lower-core-tail-step word-bits self-disp all-defs param-nodes ret-sty (Cons (lid, rv, rty) env) body g1
    CIf sp ty cond th el ->
      case tv-lower-core-term-defs word-bits 0 all-defs env cond g of
        Err e -> Err e
        Ok (cv, cty, g1) ->
          case tv-coerce-bv cv cty SBool g1 of
            Err e -> Err e
            Ok (cb, g2) ->
              case tv-lower-core-tail-step word-bits self-disp all-defs param-nodes ret-sty env th g2 of
                Err e -> Err e
                Ok (td, tr, tnext, g3) ->
                  case tv-lower-core-tail-step word-bits self-disp all-defs param-nodes ret-sty env el g3 of
                    Err e -> Err e
                    Ok (ed, er, enext, g4) ->
                      let (d, g5) = g-ite cb td ed g4 in
                      let (r, g6) = g-ite cb tr er g5 in
                      let (nx, g7) = tv-ite-list cb tnext enext g6 in
                      Ok (d, r, nx, g7)
    CApply sp ty f a ->
      case tv-unroll-core-app tm Nil of
        (CUse hsp hty fn-name role actuals, args) | same (tv-display-name fn-name) self-disp || same (strip-module-prefix (tv-display-name fn-name)) (strip-module-prefix self-disp) ->
          case tv-lower-core-args-defs word-bits 0 all-defs env args g of
            Err e -> Err e
            Ok (arg-vals, g1) ->
              let ptys = map-snd param-nodes in
              case tv-coerce-list arg-vals ptys g1 of
                Err e -> Err e
                Ok (next-ids, g2) ->
                  let (done-f, g3) = g-bool False g2 in
                  let (zret, g4) = tv-zero-for-ty ret-sty g3 in
                  Ok (done-f, zret, next-ids, g4)
        other ->
          case tv-lower-core-term-defs word-bits 0 all-defs env tm g of
            Err e -> Err e
            Ok (rv, rty, g1) ->
              case tv-coerce-bv rv rty ret-sty g1 of
                Err e -> Err e
                Ok (rc, g2) ->
                  let (done-t, g3) = g-bool True g2 in
                  Ok (done-t, rc, map-fst param-nodes, g3)
    other ->
      case tv-lower-core-term-defs word-bits 0 all-defs env tm g of
        Err e -> Err e
        Ok (rv, rty, g1) ->
          case tv-coerce-bv rv rty ret-sty g1 of
            Err e -> Err e
            Ok (rc, g2) ->
              let (done-t, g3) = g-bool True g2 in
              Ok (done-t, rc, map-fst param-nodes, g3)

  map-fst :: forall a b. List (a, b) -> List a
  map-fst xs = case xs of Nil -> Nil; Cons (a, _) r -> Cons a (map-fst r)

  map-snd :: forall a b. List (a, b) -> List b
  map-snd xs = case xs of Nil -> Nil; Cons (_, b) r -> Cons b (map-snd r)

  tv-sem-ty-ir-str :: SemType -> String
  tv-sem-ty-ir-str ty = case ty of
    SBool -> "i1"
    SBv w -> string-concat "i" (nat-to-string w)
    other -> "i64"

  -- Find the backedge header label (a label L that appears before a `br label %L`).
  tv-find-backedge-header :: List String -> List String -> Option String
  tv-find-backedge-header ls seen-labels = case ls of
    Nil -> None
    Cons raw rest ->
      let t = string-strip raw in
      if string-ends-with ":" t then
        let lbl = string-slice t 0 (saturating-sub (string-length t) 1) in
        tv-find-backedge-header rest (Cons lbl seen-labels)
      else if string-starts-with "br label %" t then
        let tgt = string-strip (string-slice t 10 (string-length t)) in
        if has-str tgt seen-labels then Some tgt
        else tv-find-backedge-header rest seen-labels
      else tv-find-backedge-header rest seen-labels

  -- Collect initial `store <ty> %i, ptr %slot` mappings before the loop header.
  tv-collect-init-param-slots :: List String -> String -> List (String, String) -> List (String, String)
  tv-collect-init-param-slots ls hdr acc = case ls of
    Nil -> acc
    Cons raw rest ->
      let t = string-strip raw in
      if same t (string-concat hdr ":") then acc
      else case tv-parse-store-op t of
        Some (_, sval, slot, _) | string-starts-with "%" sval ->
          tv-collect-init-param-slots rest hdr (Cons (sval, slot) acc)
        other -> tv-collect-init-param-slots rest hdr acc

  -- Rewrite a tail-loop LLVM function into a single-output acyclic fragment for:
  --   mode == "done" -> returns i1 (1 on ret, 0 on backedge)
  --   mode == "ret"  -> returns ret-ty (%v on ret, 0 on backedge)
  --   mode == "next" -> returns param-ty (%p_i on ret, load %slot_i on backedge)
  -- Only rewrites `br label %hdr` AFTER seeing `hdr:` (the backedge, not the entry jump).
  tv-rewrite-loop-output :: List String -> String -> Bool -> String -> String -> String -> String -> Nat -> List String -> List String
  tv-rewrite-loop-output ls hdr seen-hdr mode out-ty param-reg slot-reg ctr acc = case ls of
    Nil -> reverse acc
    Cons raw rest ->
      let t = string-strip raw in
      let seen1 = seen-hdr || same t (string-concat hdr ":") in
      if seen-hdr && same t (string-concat "br label %" hdr) then
        if same mode "done" then
          tv-rewrite-loop-output rest hdr seen1 mode out-ty param-reg slot-reg ctr (Cons "  ret i1 0" acc)
        else if same mode "ret" then
          tv-rewrite-loop-output rest hdr seen1 mode out-ty param-reg slot-reg ctr (Cons (string-concat-all ["  ret ", out-ty, " 0"]) acc)
        else
          let tmp = string-concat "%tv_next_" (nat-to-string ctr) in
          let ld = string-concat-all ["  ", tmp, " = load ", out-ty, ", ptr ", slot-reg, ", align 8"] in
          let rt = string-concat-all ["  ret ", out-ty, " ", tmp] in
          tv-rewrite-loop-output rest hdr seen1 mode out-ty param-reg slot-reg (ctr + 1) (Cons rt (Cons ld acc))
      else if string-starts-with "ret " t then
        if same mode "done" then
          tv-rewrite-loop-output rest hdr seen1 mode out-ty param-reg slot-reg ctr (Cons "  ret i1 1" acc)
        else if same mode "ret" then
          tv-rewrite-loop-output rest hdr seen1 mode out-ty param-reg slot-reg ctr (Cons raw acc)
        else
          tv-rewrite-loop-output rest hdr seen1 mode out-ty param-reg slot-reg ctr (Cons (string-concat-all ["  ret ", out-ty, " ", param-reg]) acc)
      else tv-rewrite-loop-output rest hdr seen1 mode out-ty param-reg slot-reg ctr (Cons raw acc)

  tv-lower-loop-nexts :: List String -> String -> List (String, String) -> List SemType -> Nat -> List (String, SemVal) -> Nat -> SemGraph -> Result String (List Nat, Nat, Nat, SemGraph)
  tv-lower-loop-nexts raw-lines hdr slot-map ptys idx lbinds ub-acc g = case ptys of
    Nil ->
      let (f0, g1) = g-bool False g in Ok (Nil, ub-acc, f0, g1)
    Cons pty rest ->
      let preg = string-concat "%" (nat-to-string idx) in
      case tv-lookup-str preg slot-map of
        None -> Err (string-concat "missing loop param slot for " preg)
        Some sreg ->
          let frag-raw = join-str "\n" (tv-rewrite-loop-output raw-lines hdr False "next" (tv-sem-ty-ir-str pty) preg sreg 0 Nil) in
          let frag = case tv-symbolic-mem2reg frag-raw of Ok ssa -> ssa; Err _ -> frag-raw in
          case lower-ir-fragment frag lbinds ub-acc g of
            Err e -> Err e
            Ok (MkLlvmEnv _ _ _ None) -> Err "loop-next fragment has no ret"
            Ok (MkLlvmEnv _ ub1 g1 (Some rv)) ->
              case tv-coerce-bv (sv-val rv) (sv-type rv) pty g1 of
                Err e -> Err e
                Ok (vc, g2) ->
                  case tv-lower-loop-nexts raw-lines hdr slot-map rest (idx + 1) lbinds ub1 g2 of
                    Err e -> Err e
                    Ok (more, ub2, p2, g3) ->
                      let (p-all, g4) = g-or (sv-poison rv) p2 g3 in
                      Ok (Cons vc more, ub2, p-all, g4)

  tv-next-obligations :: String -> Nat -> List Nat -> List Nat -> List SemType -> Nat -> SemGraph -> (List (String, Nat), SemGraph)
  tv-next-obligations disp not-done xs ys tys idx g = case (xs, ys, tys) of
    (Cons x xr, Cons y yr, Cons ty tr) ->
      let (eq1, g1) = case ty of
            SBv w -> g-bv-cmp "eq" w x y g
            SBool -> g-intern (NEqBool x y) g
            other -> g-bool False g in
      let (ob1, g2) = g-implies not-done eq1 g1 in
      let (more, g3) = tv-next-obligations disp not-done xr yr tr (idx + 1) g2 in
      (Cons (string-concat-all ["tv-loop-next", nat-to-string idx, ":", disp], ob1) more, g3)
    other -> (Nil, g)

  tv-extract-param-nodes :: List (Nat, Nat, SemType) -> List (Nat, SemType)
  tv-extract-param-nodes cenv = case cenv of
    Nil -> Nil
    Cons (_, nid, ty) rest -> tv-extract-param-nodes rest <> [(nid, ty)]

  tv-validate-tail-loop :: Nat -> String -> List CoreDefinition -> String -> List CorePattern -> CoreTerm -> SemType -> TvReport
  tv-validate-tail-loop word-bits ir-text all-defs disp pats body ret-sty =
    case tv-init-core-params word-bits pats 0 empty-sem-graph of
      Err reason -> MkTvReport disp "core->llvm(loop-step)" "skipped" reason
      Ok (cenv, lbinds, g1) ->
        let pnodes = tv-extract-param-nodes cenv in
        let ptys = map-snd pnodes in
        case tv-lower-core-tail-step word-bits disp all-defs pnodes ret-sty cenv body g1 of
          Err reason -> MkTvReport disp "core->llvm(loop-step)" "skipped" reason
          Ok (c-done, c-ret, c-nexts, g2) ->
            case tv-extract-llvm-fragment word-bits ir-text disp of
              None -> MkTvReport disp "core->llvm(loop-step)" "skipped" "no matching emitted LLVM define"
              Some raw-frag ->
                let raw-lines = string-split-on "\n" raw-frag in
                case tv-find-backedge-header raw-lines Nil of
                  None -> MkTvReport disp "core->llvm(loop-step)" "skipped" "no tail-loop backedge header found"
                  Some hdr ->
                    let slot-map = tv-collect-init-param-slots raw-lines hdr Nil in
                    let done-raw = join-str "\n" (tv-rewrite-loop-output raw-lines hdr False "done" "i1" "%0" "" 0 Nil) in
                    let ret-raw = join-str "\n" (tv-rewrite-loop-output raw-lines hdr False "ret" (tv-sem-ty-ir-str ret-sty) "%0" "" 0 Nil) in
                    let done-frag = case tv-symbolic-mem2reg done-raw of Ok ssa -> ssa; Err _ -> done-raw in
                    let ret-frag = case tv-symbolic-mem2reg ret-raw of Ok ssa -> ssa; Err _ -> ret-raw in
                    let (ub0, g3) = g-bool False g2 in
                    case lower-ir-fragment done-frag lbinds ub0 g3 of
                      Err reason -> MkTvReport disp "core->llvm(loop-step)" "skipped" (string-concat "loop-done lowering: " reason)
                      Ok (MkLlvmEnv _ _ _ None) -> MkTvReport disp "core->llvm(loop-step)" "skipped" "loop-done has no ret"
                      Ok (MkLlvmEnv _ ub1 g4 (Some l-done-sv)) ->
                        case tv-coerce-bv (sv-val l-done-sv) (sv-type l-done-sv) SBool g4 of
                          Err reason -> MkTvReport disp "core->llvm(loop-step)" "skipped" reason
                          Ok (l-done, g5) ->
                            case lower-ir-fragment ret-frag lbinds ub1 g5 of
                              Err reason -> MkTvReport disp "core->llvm(loop-step)" "skipped" (string-concat "loop-ret lowering: " reason)
                              Ok (MkLlvmEnv _ _ _ None) -> MkTvReport disp "core->llvm(loop-step)" "skipped" "loop-ret has no ret"
                              Ok (MkLlvmEnv _ ub2 g6 (Some l-ret-sv)) ->
                                case tv-coerce-bv (sv-val l-ret-sv) (sv-type l-ret-sv) ret-sty g6 of
                                  Err reason -> MkTvReport disp "core->llvm(loop-step)" "skipped" reason
                                  Ok (l-ret, g7) ->
                                    case tv-lower-loop-nexts raw-lines hdr slot-map ptys 0 lbinds ub2 g7 of
                                      Err reason -> MkTvReport disp "core->llvm(loop-step)" "skipped" reason
                                      Ok (l-nexts, ub3, p-nexts, g8) ->
                                        let (p1, g9) = g-or (sv-poison l-done-sv) (sv-poison l-ret-sv) g8 in
                                        let (p-all, g10) = g-or p1 p-nexts g9 in
                                        let (not-ub, g11) = g-not ub3 g10 in
                                        let (not-p, g12) = g-not p-all g11 in
                                        let (done-eq, g13) = g-intern (NEqBool c-done l-done) g12 in
                                        let (ret-eq, g14) = case ret-sty of
                                              SBv w -> g-bv-cmp "eq" w c-ret l-ret g13
                                              SBool -> g-intern (NEqBool c-ret l-ret) g13
                                              other -> g-bool False g13 in
                                        let (ret-match, g15) = g-implies c-done ret-eq g14 in
                                        let (not-done, g16) = g-not c-done g15 in
                                        let (next-obs, g17) = tv-next-obligations disp not-done c-nexts l-nexts ptys 0 g16 in
                                        let obs = [ (string-concat "tv-loop-no-ub:" disp, not-ub)
                                                  , (string-concat "tv-loop-no-poison:" disp, not-p)
                                                  , (string-concat "tv-loop-done:" disp, done-eq)
                                                  , (string-concat "tv-loop-ret:" disp, ret-match)
                                                  ] <> next-obs in
                                        (case run-obligations-cached True "strict" "verify" Nil False g17 obs Nil of
                                          OutcomeVerified (Cons rcpt _) ->
                                            MkTvReport disp "core->llvm(loop-step)" "verified" (string-concat-all [receipt-checker-id rcpt, ": ", receipt-tier rcpt])
                                          OutcomeVerified Nil ->
                                            MkTvReport disp "core->llvm(loop-step)" "verified" "cinch-kernel-lrat@1: kernel-cert"
                                          OutcomeAssumed _ -> MkTvReport disp "core->llvm(loop-step)" "open" "assumed"
                                          OutcomeDisproved detail -> MkTvReport disp "core->llvm(loop-step)" "disproved" detail
                                          OutcomeRejected detail -> MkTvReport disp "core->llvm(loop-step)" "rejected" detail
                                          OutcomeOpen detail -> MkTvReport disp "core->llvm(loop-step)" "open" detail)

  tv-validate-one-def-with-defs :: Nat -> String -> List CoreDefinition -> CoreDefinition -> TvReport
  tv-validate-one-def-with-defs word-bits ir-text all-defs def =
    let disp = tv-display-name def.name in
    case def.clauses of
      Cons (CoreClause csp pats body) Nil ->
        case tv-word-ty-for word-bits (core-type body) of
          None -> MkTvReport disp "core->llvm" "skipped" "non-scalar result type"
          Some (ret-sty, ret-sg) ->
            if tv-has-self-tail-call disp body then
              tv-validate-tail-loop word-bits ir-text all-defs disp pats body ret-sty
            else
            case tv-init-core-params word-bits pats 0 empty-sem-graph of
              Err reason -> MkTvReport disp "core->llvm" "skipped" reason
              Ok (cenv, lbinds, g1) ->
                case tv-lower-core-term-defs word-bits 0 all-defs cenv body g1 of
                  Err reason -> MkTvReport disp "core->llvm" "skipped" reason
                  Ok (cv, cty, g2) ->
                    case tv-coerce-bv cv cty ret-sty g2 of
                      Err reason -> MkTvReport disp "core->llvm" "skipped" reason
                      Ok (cv-coerced, g3) ->
                        (case tv-extract-llvm-fragment word-bits ir-text disp of
                          None -> MkTvReport disp "core->llvm" "skipped" "no matching emitted LLVM define"
                          Some raw-frag ->
                            let frag = case tv-symbolic-mem2reg raw-frag of Ok ssa -> ssa; Err _ -> raw-frag in
                            let (ub0, g4) = g-bool False g3 in
                            (case lower-ir-fragment frag lbinds ub0 g4 of
                              Err reason -> MkTvReport disp "core->llvm" "skipped" (string-concat "LLVM lowering: " reason)
                              Ok (MkLlvmEnv b1 ub-l g5 None) -> MkTvReport disp "core->llvm" "skipped" "emitted LLVM has no ret"
                              Ok (MkLlvmEnv b1 ub-l g5 (Some ret-l)) ->
                                (case tv-coerce-bv (sv-val ret-l) (sv-type ret-l) ret-sty g5 of
                                  Err reason -> MkTvReport disp "core->llvm" "skipped" reason
                                  Ok (lv-coerced, g6) ->
                                    let (not-ub, g7) = g-not ub-l g6 in
                                    let (not-p, g8) = g-not (sv-poison ret-l) g7 in
                                    let (eq-v, g9) = case ret-sty of
                                          SBv w -> g-bv-cmp "eq" w cv-coerced lv-coerced g8
                                          SBool -> g-intern (NEqBool cv-coerced lv-coerced) g8
                                          other -> g-bool False g8 in
                                    let obs = [ (string-concat "tv-no-ub:" disp, not-ub)
                                              , (string-concat "tv-no-poison:" disp, not-p)
                                              , (string-concat "tv:" disp, eq-v)
                                              ] in
                                    (case run-obligations-cached True "strict" "verify" Nil False g9 obs Nil of
                                      OutcomeVerified (Cons rcpt rest) ->
                                        MkTvReport disp "core->llvm" "verified" (string-concat-all [receipt-checker-id rcpt, ": ", receipt-tier rcpt])
                                      OutcomeVerified Nil ->
                                        MkTvReport disp "core->llvm" "verified" "cinch-kernel-lrat@1: kernel-cert"
                                      OutcomeAssumed rs ->
                                        MkTvReport disp "core->llvm" "open" "assumed"
                                      OutcomeDisproved detail ->
                                        MkTvReport disp "core->llvm" "disproved" detail
                                      OutcomeRejected detail ->
                                        MkTvReport disp "core->llvm" "rejected" detail
                                      OutcomeOpen detail ->
                                        MkTvReport disp "core->llvm" "open" detail))))
      other -> MkTvReport disp "core->llvm" "skipped" "multi-clause function"

  tv-validate-defs-loop :: Nat -> String -> List CoreDefinition -> String -> List CoreDefinition -> List TvReport
  tv-validate-defs-loop word-bits prefix all-defs ir-text defs = case defs of
    Nil -> Nil
    Cons def rest ->
      let disp = tv-display-name def.name in
      if string-starts-with prefix disp then
        Cons (tv-validate-one-def-with-defs word-bits ir-text all-defs def) (tv-validate-defs-loop word-bits prefix all-defs ir-text rest)
      else tv-validate-defs-loop word-bits prefix all-defs ir-text rest

  validate-program-codegen-for-word-bits :: Nat -> String -> List CoreDefinition -> String -> List TvReport
  validate-program-codegen-for-word-bits word-bits prefix defs ir-text =
    tv-validate-defs-loop word-bits prefix defs ir-text defs <> validate-module-rc-safety ir-text prefix
