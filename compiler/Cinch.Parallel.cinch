-- Compilation parallelism and throughput-vs-latency tuning.
--
-- Pure compiler phases (parsing, per-definition body inference, Core
-- re-checking, wave-ordered interface export, frontier-wave RuntimeIr
-- emission) stay pure and deterministic by construction: every parallel
-- phase runs over Cinch's work-stealing primitives (`parMap`/`parTabulate`/
-- `parBoth`) and merges results in deterministic input/frontier order.
--
-- `CompileStrategy` separates the two primary workloads:
--   - `Latency`: hot-reload / incremental / streaming sessions. Uses fine-
--     grained task splitting (chunk size 1), keeps cross-unit inlining off
--     unless explicitly requested so body-only edits cut off cleanly, and
--     uses fast `-O0` native linking.
--   - `Throughput`: full batch builds. Batches independent items into larger
--     chunks to amortize work-stealing and reference-count marking overhead
--     across N cores, and uses full `-O2` native linking.
--
-- Output IR, interfaces and diagnostics are deterministic and byte-identical
-- for every worker count N (`-j 1`, `-j 2`, `-j 4`, ...).

module Cinch.Parallel where

  import Data.Char (digit-value)
  import Data.List (reverse)
  import Data.Nat
  import Data.Option
  import Data.String (unpack)
  import Effect.Sequencing (OptionSequencing)
  import Relation.Eq (Eq)
  import Text.Show (Show, show)

  export CompileStrategy, Latency, Throughput, Release, Eq_CompileStrategy, Show_CompileStrategy
  export CompileTuning
  export default-tuning, latency-tuning, throughput-tuning, release-tuning
  export tuning-with-strategy, tuning-with-workers, tuning-with-prim-verify, tuning-with-jpl, tuning-with-proof-cache, tuning-with-replay-only
  export tuning-is-latency, tuning-is-throughput, tuning-is-release
  export strategy-name, parse-compile-strategy, parse-nat-word
  export tuning-chunk-size, chunk-list, flatten-lists, apply-worker-budget

  data CompileStrategy where
    Latency :: CompileStrategy
    Throughput :: CompileStrategy
    Release :: CompileStrategy

  implicit instance Eq_CompileStrategy :: Eq CompileStrategy where
    (==) a b = case (a, b) of
      (Latency, Latency) -> True
      (Throughput, Throughput) -> True
      (Release, Release) -> True
      _ -> False
    (/=) a b = not (a == b)

  implicit instance Show_CompileStrategy :: Show CompileStrategy where
    show s = case s of
      Latency -> "latency"
      Throughput -> "throughput"
      Release -> "release"

  record CompileTuning where
    strategy :: CompileStrategy
    workers :: Nat
    prim-verify :: String
    jpl :: Bool
    proof-cache :: List (String, String)
    replay-only :: Bool

  default-tuning :: CompileTuning
  default-tuning = CompileTuning Throughput 0 "default" False [] False

  latency-tuning :: Nat -> CompileTuning
  latency-tuning workers = CompileTuning Latency workers "default" False [] False

  throughput-tuning :: Nat -> CompileTuning
  throughput-tuning workers = CompileTuning Throughput workers "default" False [] False

  release-tuning :: Nat -> CompileTuning
  release-tuning workers = CompileTuning Release workers "default" False [] False

  tuning-with-strategy :: CompileStrategy -> CompileTuning -> CompileTuning
  tuning-with-strategy strategy tuning = CompileTuning strategy tuning.workers tuning.prim-verify tuning.jpl tuning.proof-cache tuning.replay-only

  tuning-with-workers :: Nat -> CompileTuning -> CompileTuning
  tuning-with-workers workers tuning = CompileTuning tuning.strategy workers tuning.prim-verify tuning.jpl tuning.proof-cache tuning.replay-only

  tuning-with-prim-verify :: String -> CompileTuning -> CompileTuning
  tuning-with-prim-verify pv tuning = CompileTuning tuning.strategy tuning.workers pv tuning.jpl tuning.proof-cache tuning.replay-only

  tuning-with-jpl :: Bool -> CompileTuning -> CompileTuning
  tuning-with-jpl jpl tuning = CompileTuning tuning.strategy tuning.workers tuning.prim-verify jpl tuning.proof-cache tuning.replay-only

  tuning-with-proof-cache :: List (String, String) -> CompileTuning -> CompileTuning
  tuning-with-proof-cache pc tuning = CompileTuning tuning.strategy tuning.workers tuning.prim-verify tuning.jpl pc tuning.replay-only

  tuning-with-replay-only :: Bool -> CompileTuning -> CompileTuning
  tuning-with-replay-only ro tuning = CompileTuning tuning.strategy tuning.workers tuning.prim-verify tuning.jpl tuning.proof-cache ro

  tuning-is-latency :: CompileTuning -> Bool
  tuning-is-latency tuning = tuning.strategy == Latency

  tuning-is-throughput :: CompileTuning -> Bool
  tuning-is-throughput tuning = tuning.strategy == Throughput

  tuning-is-release :: CompileTuning -> Bool
  tuning-is-release tuning = tuning.strategy == Release

  strategy-name :: CompileStrategy -> String
  strategy-name strategy = show strategy

  parse-compile-strategy :: String -> Option CompileStrategy
  parse-compile-strategy word = case word of
    "latency" -> Some Latency
    "hot-reload" -> Some Latency
    "throughput" -> Some Throughput
    "batch" -> Some Throughput
    "release" -> Some Release
    "prod" -> Some Release
    "production" -> Some Release
    _ -> None

  parse-nat-digits :: using (seq :: OptionSequencing) => List Char -> Nat -> Option Nat
  parse-nat-digits cs acc = case cs of
    [] -> Some acc
    c : rest -> do
      d <- digit-value c
      parse-nat-digits rest (acc * 10 + d)

  parse-nat-word :: String -> Option Nat
  parse-nat-word word = case unpack word of
    [] -> None
    c : rest -> parse-nat-digits (c : rest) 0

  -- Choose a deterministic chunk size for a parallel batch of `total` items.
  -- `Latency` splits at unit granularity (1) so small hot-reload edits fan
  -- out immediately with minimum tail latency. `Throughput` and `Release`
  -- batch large lists into chunks of up to 16 items (aiming for ~4 chunks
  -- per worker) to amortize closure/marking overhead while preserving load
  -- balance.
  tuning-chunk-size :: CompileTuning -> Nat -> Nat
  tuning-chunk-size tuning total = case tuning.strategy of
    Latency -> 1
    _ ->
      if total <= 16 then 1
      else
        let workers = tuning.workers in
        let effective = if workers == 0 then (8 :: Nat) else workers in
        let buckets = effective * 4 in
        let raw = case checked-div total buckets of Some q -> q; None -> 1 in
        if raw <= 1 then 1
        else if raw >= 16 then 16
        else raw

  take-chunk :: forall a. Nat -> List a -> List a -> (List a, List a)
  take-chunk remaining items acc =
    if remaining == 0 then (reverse acc, items)
    else case items of
      [] -> (reverse acc, [])
      first : rest -> take-chunk (saturating-sub remaining 1) rest (first : acc)

  chunk-loop :: forall a. Nat -> List a -> List (List a) -> List (List a)
  chunk-loop width items acc = case items of
    [] -> reverse acc
    first : rest -> case take-chunk width items [] of
      (group, more) -> chunk-loop width more (group : acc)

  -- Partition `items` into contiguous chunks of size `width` (>= 1),
  -- preserving exact input order.
  chunk-list :: forall a. Nat -> List a -> List (List a)
  chunk-list width items =
    let step = if width == 0 then (1 :: Nat) else width in
    chunk-loop step items []

  prepend-reversed :: forall a. List a -> List a -> List a
  prepend-reversed items acc = case items of
    [] -> acc
    first : rest -> prepend-reversed rest (first : acc)

  flatten-loop :: forall a. List (List a) -> List a -> List a
  flatten-loop groups acc = case groups of
    [] -> reverse acc
    group : rest -> flatten-loop rest (prepend-reversed group acc)

  -- Flatten chunked results back into a single list in O(n) time,
  -- preserving exact input order.
  flatten-lists :: forall a. List (List a) -> List a
  flatten-lists groups = flatten-loop groups []

  -- Configure the runtime's work-stealing participant count when an
  -- explicit worker count (> 0) was requested. Zero leaves the runtime
  -- default (`CINCH_THREADS` or host CPU parallelism) intact.
  apply-worker-budget :: Nat -> Unit
  apply-worker-budget count =
    if count == 0 then ()
    else parWorkers count
