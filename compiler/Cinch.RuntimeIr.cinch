-- Typed Core to LLVM using the shared runtime ABI. Each generated value
-- owns one reference; local reads duplicate, scope exits drop, and direct
-- calls transfer arguments to the callee. Mathematical numbers remain
-- runtime words throughout. Unsupported Core produces errors, never IR.
module Cinch.RuntimeIr where
  import Cinch.Ast (Module, module-decls, Decl, DInlineHint, DUnrollHint, DTestAttr, TestSpec, declaration-test-attrs, test-spec-is-test, test-spec-is-test-only, test-spec-ignored, test-spec-ignore-reason, test-spec-should-fail, test-spec-fail-expected, test-spec-timeout-ms, test-spec-retries, test-spec-serial, test-spec-tags)
  import Cinch.Check (CheckedProgram)
  import Cinch.Infer (elaboration-core, elaboration-data, elaboration-effects, elaboration-classes, elaboration-instances, elaboration-bindings, elaboration-type-families, elaboration-promoted-fns, CheckedBinding, checked-name, checked-scheme, checked-role, checked-method-matches, checked-conditional-target, checked-foreign-plan, checked-c-exports, checked-intrinsic-symbol, scalar-intrinsic-scheme, checked-body-binding)
  import Cinch.Promote (PromotedFn, is-promoted-fn-name)
  import Cinch.BodyContract (binding-name, binding-native, binding-function)
  import Cinch.Total (TotalFunction, TotalTerm, TotalArguments, total-term, total-parameters, total-result, term-node, argument-node, LocalTerm, NumberTerm, PrimitiveTerm, NextArgument, NoArguments)
  import Cinch.Object (RuntimeObject, RuntimeUnit, object-unit, object-variant, object-dictionary, object-family, object-conditional-unit, object-closed-method-unit, object-string-layout, llvm-object-symbol, llvm-data-bytes)
  import Cinch.UnpackMatch (lower-unpacked-patterns, needs-unpacked-patterns)
  import Cinch.Ad (lower-ad-program)
  import Cinch.Core
  import Cinch.Foreign
  import Cinch.Layout (fixed-array-parts, pod-type-layout, value-layout-of)
  import Data.Nat (nat-rem)
  import Cinch.Builtin (array-plan, array-type-name, mvar-plan, cell-type-name, mvar-arity, mvar-consumes, mvar-optional, nat-arithmetic-extern, u32-wrapping-operation, fast-bytes-intrinsic, platform-intrinsic, ScalarShape, ScalarOperation, scalar-intrinsic)
  import Cinch.Index
  import Cinch.ExportType (export-global)
  import Cinch.Nominal (interface-global, global-data-core-cons, global-data-core-err, global-data-core-list, global-data-core-nil, global-data-core-none, global-data-core-ok, global-data-core-option, global-data-core-result, global-data-core-some, global-data-string-length)
  import Cinch.Instance
  import Cinch.Type
  import Cinch.Global (constructor-pattern-supported)
  import Cinch.Report
  import Algebra.Semigroup
  import Text.Builder
  import Text.Show (nat-to-string, int-to-string)
  import Text.Scan (string-split-on, string-starts-with, string-contains)
  import Data.String (string-compare, string-byte-length, string-utf8-first, string-to-bytes)
  import Data.Bytes (bytes-len, bytes-get)
  import Prim.Machine (ge-i64, lt-i64)
  import Text.Lex (Span)
  import Data.Array
  import Cinch.Parallel (CompileTuning, default-tuning, tuning-chunk-size, chunk-list, flatten-lists)
  import Cinch.Borrow (compute-borrow-modes, same-borrow-modes, any-borrowed)
  import Cinch.Ownership (term-uses-id, terms-use-id, term-use-count, arm-has-reuse-alloc, compute-consumed-params, same-bool-maps, frame-let-mode, compute-arena-phases, same-arena-phases, program-uses-concurrency, is-immortal-enum-data)
  import Cinch.Document
  import Cinch.Target (TargetProfile, host-profile, selection-arch, target-ir-header)
  import Data.List (split-at)
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup, hash-map-to-list)

  export emit-runtime-program, emit-runtime-program-with-object, emit-runtime-program-counting, check-runtime-entry
  export emit-runtime-program-mode, emit-runtime-program-with-object-mode, emit-runtime-program-counting-mode
  export emit-runtime-program-for-target, emit-runtime-library-artifact-for-target
  export emit-runtime-program-for-profile, emit-runtime-library-artifact-for-profile
  export emit-runtime-program-for-profile-tuned, emit-runtime-library-artifact-for-profile-tuned
  export EmittedUnit, UnitIrCache, empty-unit-ir-cache, emit-runtime-program-for-profile-cached
  export emit-runtime-library-with-object, emit-runtime-library-artifact-with-object
  export emit-runtime-library-with-object-mode
  export emit-runtime-library-object-with-object-mode, emit-runtime-library-artifact-with-object-mode
  export runtime-library-default-roots, runtime-library-unit-roots, emit-runtime-library-object-with-object
  export TestReturnKind, TRInt, TRBool, TRUnit, TRResult, TRCheck, TRCheckList
  export DiscoveredTest, test-index, test-core-name, test-module-name, test-display-name, test-call-mode, test-needs-io, test-return-kind, test-spec
  export check-test-boundary, discover-tests, emit-runtime-test-harness-for-profile-tuned

  -- The descriptions of each named family's constructors, by tag, keyed by
  -- the family's specialized name. A description is content, not identity
  -- (design/self-describing-blocks.md), so this is only a cache: it spares
  -- each construction site re-deriving its family and refuses an
  -- unrepresentable constructor once.
  record LayoutPlan where
    field0 :: List (String, List Nat)
  data Local where
    Local :: Nat -> UType -> String -> Local
    Discard :: UType -> String -> Local
    Borrowed :: Nat -> UType -> String -> Local
    KnotLocal :: Nat -> UType -> UType -> String -> Local
    GivenLocal :: String -> UType -> String -> Local
    SelfValue :: String -> Nat -> UType -> String -> Local
    KnownSelf :: String -> String -> List Nat -> List CoreGiven -> Local

    -- A binder whose value is a constructor application that has not been
    -- built. A non-case use builds it; a case on it folds without building.
    DeferredConstructor :: Nat -> UType -> String -> List UType -> List CoreTerm -> Local
    -- Marker indicating codegen is inside a self-tail loop body so stack
    -- frame allocas are skipped and stack space stays O(1).
    LoopMarker :: Local
    -- Native pointer to a stack-allocated scalar cell created by withLocal.
    StackCell :: Nat -> UType -> String -> Local

  record RecursiveWorker where
    id :: Nat
    ty :: UType
    name :: String
    patterns :: List CorePattern
    body :: CoreTerm

  data TailContext where
    LocalTail :: List RecursiveWorker -> List Local -> Nat -> TailContext
    GlobalTail :: Nat -> Nat -> Option (String, String) -> List Bool -> TailContext

  data Demand where
    Demand :: String -> List Nat -> Demand
    ConstructorDemand :: String -> List Nat -> Demand
    LambdaDemand :: String -> List (Nat, Nat) -> List (Nat, Nat) -> List Local -> CorePattern -> CoreTerm -> Demand
    RecursiveDemand :: RecursiveWorker -> List RecursiveWorker -> List (Nat, Nat) -> List (Nat, Nat) -> List Local -> Demand
    StubDemand :: String -> List Nat -> Nat -> Demand
    DictionaryDemand :: String -> List Nat -> Demand
    ArrayDemand :: String -> List Nat -> Demand
    -- | Request a checked MVar wrapper with its concrete payload representation.
    MVarDemand :: String -> List Nat -> Demand
    BuiltinDemand :: String -> Demand
    SymbolEquality :: Demand
    MemoWorker :: Demand
    ExternalDemand :: RuntimeUnit -> Demand
    ForeignDemand :: ForeignPlan -> Demand
    ForeignNullFault :: Demand
    PrimitiveIntrinsicDemand :: String -> Demand
    PrimitiveUseDemand :: String -> String -> Demand
    CprDemand :: String -> List Nat -> Demand
    BorrowDemand :: String -> List Nat -> Demand
    BuiltinBorrowDemand :: String -> Demand
    MemcpyDemand :: Demand
    MemsetDemand :: Demand
  -- Bound scheme ids and opened rigid ids are separate namespaces.
  -- A worker is shared by all actual types with the same class vector.
  record MethodVersion where
    field0 :: String
    field1 :: Nat
    field2 :: List Nat
  record MethodSlot where
    field0 :: Nat
    field1 :: Nat
    field2 :: List Nat
  record FunctionHints where
    inline :: String
    cold :: Bool
    loop :: Option String
  -- Keep the first binding for each identity and the original order inside
  -- each candidate list. None of these maps determines emission order.
  record CallableBindings where
    methods :: HashMap String (List CheckedBinding)
    externals :: HashMap String CheckedBinding
    instances :: HashMap String CheckedBinding
    bodies :: HashMap String TotalFunction
    natives :: HashMap String TotalFunction
  record ForeignBindings where
    field0 :: HashMap String (Option ForeignPlan)
    field1 :: HashMap String (List ForeignPlan)
    field2 :: List UType
  -- Static ownership plan computed once per program:
  --   borrows, consumed-params (for RC_FRAME escape analysis),
  --   bounded region-arena phases, and whether concurrency primitives are used.
  record OwnershipPlan where
    borrows :: HashMap String (List Bool)
    consumed :: HashMap String (List Bool)
    arenas :: HashMap String Bool
    concurrent :: Bool
  empty-ownership-plan :: OwnershipPlan
  empty-ownership-plan = OwnershipPlan hash-map-empty hash-map-empty hash-map-empty True
  record BindingIndex where
    field0 :: CallableBindings
    field1 :: ForeignBindings
    field2 :: Option (HashMap String FunctionHints)
    field3 :: HashMap String CoreDefinition
    field4 :: OwnershipPlan
  -- Keep declaration order for emitted layouts. The indexes are lookup-only,
  -- so their iteration order cannot affect the output.
  record DataIndex where
    datas :: List CoreData
    types :: HashMap String CoreData
    constructors :: HashMap String (String, Nat, CoreConstructor)
    unpacked :: Bool
  index-data :: List CoreData -> DataIndex
  index-data datas = case index-data-rows datas of (types, constructors) -> DataIndex datas types constructors (includes-unpacked datas)
  includes-unpacked :: List CoreData -> Bool
  includes-unpacked datas = case datas of
    [] -> False
    d : rest -> (case core-data-layout d of UnpackedRecord fields -> True; other -> includes-unpacked rest)

  index-data-rows :: List CoreData -> (HashMap String CoreData, HashMap String (String, Nat, CoreConstructor))
  index-data-rows rows = case rows of
    [] -> (hash-map-empty, hash-map-empty)
    d : rest -> case index-data-rows rest of
      (types, constructors) -> let owner = core-data-name d in
        (hash-map-insert owner d types, index-constructors owner 0 (core-data-constructors d) constructors)
  index-constructors :: String -> Nat -> List CoreConstructor -> HashMap String (String, Nat, CoreConstructor) -> HashMap String (String, Nat, CoreConstructor)
  index-constructors owner tag constructors index = case constructors of
    [] -> index
    c : rest -> hash-map-insert (c.constructor-name) (owner, tag, c) (index-constructors owner (tag + 1) rest index)

  record TargetCaps where
    caps-arch :: String
    caps-arm-aes :: Bool
  has-string-member :: String -> List String -> Bool
  has-string-member needle items = case items of
    [] -> False
    head : rest -> if head == needle then True else has-string-member needle rest
  target-caps-of-profile :: TargetProfile -> TargetCaps
  target-caps-of-profile profile =
    let arch = selection-arch profile in
    let arm-aes = arch /= "portable" && (has-string-member "ArmAes" (profile.features) || has-string-member "ArmAes" (profile.required)) in
    TargetCaps arch arm-aes
  target-caps-of-wasm :: Bool -> TargetCaps
  target-caps-of-wasm wasm32 = if wasm32 then TargetCaps "wasm32" False else target-caps-of-profile host-profile

  record ProgramInfo where
    index-of :: DataIndex
    classes :: List CoreClass
    instances :: List CoreInstance
    bindings :: BindingIndex
    versions :: List MethodVersion
    object :: Option RuntimeObject
    exposed :: Option (List String)
    effects :: List CoreEffect
    tail-groups :: HashMap String (Nat, Nat)
    reclaim :: Bool
    caps :: TargetCaps
    type-families :: List TypeFamilyRuleSet
    promoted-fns :: List PromotedFn
  -- The units a sweep may copy at their call sites, whether copying is on
  -- at all, and the unfolding stack. The names are fixed before emission, so
  -- the decision at a site depends on nothing but the unit's name; the stack
  -- is what makes the recursion terminate, because a unit already being
  -- unfolded is never unfolded again.
  data InlinePlan where
    InlinePlan :: Bool -> HashMap String () -> List String -> InlinePlan
    NoInline :: InlinePlan
  -- What the unfoldable class recorded about one body: whether it calls a
  -- unit at the head of an application (a link the recursive rule may
  -- expand) and how many decisions it carries (at most one).
  record UnfoldShape where
    field0 :: Bool
    field1 :: Nat
  -- Keep emission order in the work list. The index covers both pending
  -- and emitted workers, so finishing a closure releases its Core body.
  -- The last two fields name things. `scope` is the unit being emitted,
  -- spelled so it can sit inside a quoted LLVM name, and empty between
  -- units; `serial` numbers what belongs to the module and to no unit.
  record WorkerQueue where
    field0 :: List Demand
    field1 :: HashMap String Unit
    field2 :: Bool
    field3 :: String
    field4 :: Nat
    field5 :: Bool
  empty-queue :: WorkerQueue
  empty-queue = WorkerQueue [] hash-map-empty False "" 9 False

  record RuntimeContext where
    info :: ProgramInfo
    bounds :: List (Nat, Nat)
    rigids :: List (Nat, Nat)
    queue :: WorkerQueue
    inlining :: InlinePlan
  -- An even key records the layout descriptor. The following odd key
  -- records the nullary block with that same description. Shared globals
  -- (`@cinch.desc.*` and `@empty-ctor*`) are recorded in `shared` so
  -- parallel frontier units can emit independently and deduplicate
  -- deterministically at merge time.
  record GlobalOutput where
    output :: Builder
    defined :: HashMap Nat Nat
    shared :: List (Nat, String)
  record Writer where
    next :: Nat
    globals :: GlobalOutput
    code :: Builder
    errors :: List Diagnostic
    layouts :: LayoutPlan
    context :: RuntimeContext

  cat :: List String -> String
  cat xs = string-concat-all xs
  line :: Writer -> String -> Writer
  line w text = case w of Writer next globals code errors layouts datas -> Writer next globals (builder-add-line text code) errors layouts datas
  emit-lines :: Writer -> List String -> Writer
  emit-lines w texts = case texts of [] -> w; first : rest -> emit-lines (line w first) rest
  global :: Writer -> String -> Writer
  global w text = case w of
    Writer next (GlobalOutput output defined shared) code errors layouts context ->
      Writer next (GlobalOutput (builder-add-line text output) defined shared) code errors layouts context
  shared-global :: Writer -> Nat -> String -> Writer
  shared-global w key text = case w of
    Writer next (GlobalOutput output defined shared) code errors layouts context ->
      case hash-map-lookup key defined of
        Some written -> w
        None -> Writer next (GlobalOutput output (hash-map-insert key 1 defined) ((key, text) : shared)) code errors layouts context
  add-shared-lines :: List (Nat, String) -> Builder -> Builder
  add-shared-lines rows acc = case rows of
    [] -> acc
    (key, text) : rest -> add-shared-lines rest (builder-add-line text acc)
  render-globals :: GlobalOutput -> String
  render-globals globals = case globals of
    GlobalOutput output defined shared ->
      let shared-text = builder-run (add-shared-lines (reverse shared) builder-new) in
      let own-text = builder-run output in
      if string-length shared-text == 0 then own-text
      else if string-length own-text == 0 then shared-text
      else shared-text <> own-text
  -- Names come from three places, by what a name has to be unique in.
  --
  -- A local or a label is unique in its function. `fresh` numbers those
  -- from the writer's counter, which `workers` restarts at each unit, so a
  -- function's text depends on the function and not on how many names the
  -- units before it used.
  --
  -- A constant, a static closure or dictionary, a lambda or a recursive
  -- worker is unique in the module, and across the modules of a program
  -- compiled one module at a time. `fresh-scoped` names those by the unit
  -- that asked and the unit's own counter. A unit's name is already unique
  -- program wide, so these are too, and an edit to one unit renames nothing
  -- in another: that is what lets the module's code be cut into pieces
  -- that are recompiled only when their own text changes, and what lets a
  -- lifted worker be shared across objects without a second one colliding.
  --
  -- Metadata is numbered and module wide by LLVM's rule, and anything asked
  -- for between units has no unit to be named by. `fresh-serial` numbers
  -- both from a counter that never restarts in sequential mode, or emits
  -- unit-local metadata placeholders (`!__cmN__`) in parallel frontier mode
  -- that are deterministically renumbered at wave merge.
  fresh :: Writer -> String -> (Writer, String)
  fresh w prefix = case w of Writer next globals code errors layouts datas -> (Writer (next + 1) globals code errors layouts datas, cat [prefix, nat-to-string next])
  fresh-serial :: Writer -> String -> (Writer, String)
  fresh-serial w prefix = case w of
    Writer next globals code errors layouts (RuntimeContext datas bounds rigids (WorkerQueue pending keys dictionaries scope serial unit-mode) inlining) ->
      let emitted = if unit-mode && prefix == "!" then cat ["!__cm", nat-to-string serial, "__"] else cat [prefix, nat-to-string serial] in
      (Writer next globals code errors layouts (RuntimeContext datas bounds rigids (WorkerQueue pending keys dictionaries scope (serial + 1) unit-mode) inlining), emitted)
  -- `kind` is `.kind` for a worker, whose name `symbol` wraps later, and a
  -- bare word for a global, whose name is quoted here because a unit's name
  -- holds characters a bare LLVM name may not.
  fresh-scoped :: Writer -> String -> (Writer, String)
  fresh-scoped w prefix = case w of
    Writer next globals code errors layouts (RuntimeContext datas bounds rigids (WorkerQueue pending keys dictionaries scope serial unit-mode) inlining) ->
      let worker = ge-i64 (string-compare prefix ".") 0 && lt-i64 (string-compare prefix "/") 0 in
      if scope == "" then fresh-serial w (if worker then prefix else cat ["@", prefix])
      else (Writer (next + 1) globals code errors layouts (RuntimeContext datas bounds rigids (WorkerQueue pending keys dictionaries scope serial unit-mode) inlining),
        if worker then cat [scope, prefix, nat-to-string next] else cat ["@\"", scope, ".", prefix, nat-to-string next, "\""])
  refuse :: Writer -> Span -> String -> Writer
  refuse w sp text = case w of Writer next globals code errors layouts datas -> Writer next globals code ((Diagnostic "bootstrap.runtime-ir" sp text) : errors) layouts datas
  unsupported :: Writer -> Span -> String -> (Writer, String)
  unsupported w sp text = (refuse w sp text, "0")
  symbol :: String -> String
  symbol name = cat ["@\"cinch.typed.", name, "\""]
  base :: UType -> UType
  base ty = case refinement-view ty of URefine id name carrier predicate -> base carrier; URequire predicates body -> base body; other -> ty
  named :: UType -> String -> Bool
  named ty name = case base ty of UCon actual KType -> actual == name; other -> False
  number :: UType -> Bool
  number ty = named ty "Int" || named ty "Nat"
  raw-integer :: UType -> Bool
  raw-integer ty = named ty "I8" || named ty "I16" || named ty "I32" || named ty "I64" || named ty "Isize" || named ty "U8" || named ty "U16" || named ty "U32" || named ty "U64" || named ty "Usize"
  scalar :: UType -> Bool
  scalar ty = number ty || named ty "Bool" || named ty "Unit" || raw-integer ty || named ty "Char"
  writer-program :: Writer -> ProgramInfo
  writer-program w = case w.context of RuntimeContext info bounds rigids queue inlining -> info
  program-data :: ProgramInfo -> List CoreData
  program-data info = case info.index-of of DataIndex datas types constructors unpacked -> datas
  is-type-family-name :: String -> List TypeFamilyRuleSet -> Bool
  is-type-family-name name families = case families of
    [] -> False
    fs : rest -> name == fs.identity || is-type-family-name name rest
  program-callable-bindings :: ProgramInfo -> CallableBindings
  program-callable-bindings info = case info of
    ProgramInfo datas descriptions instances (BindingIndex callable foreigns hints definitions borrows) versions provider exposed effects tail-groups reclaim wasm32 families promoted -> callable
  -- The first binding of this name still controls foreign lookup, even if
  -- a later binding of the same name carries a foreign plan.
  program-foreign-binding :: String -> ProgramInfo -> Option ForeignPlan
  program-foreign-binding name info = case info of
    ProgramInfo datas descriptions instances (BindingIndex callable (ForeignBindings names symbols pointers) hints definitions borrows) versions provider exposed effects tail-groups reclaim wasm32 families promoted -> case hash-map-lookup name names of
      Some plan -> plan
      None -> None
  foreign-symbol-plans :: String -> ProgramInfo -> List ForeignPlan
  foreign-symbol-plans symbol info = case info of
    ProgramInfo datas descriptions instances (BindingIndex callable (ForeignBindings names symbols pointers) hints definitions borrows) versions provider exposed effects tail-groups reclaim wasm32 families promoted -> case hash-map-lookup symbol symbols of
      Some plans -> plans
      None -> []
  foreign-pointer-types :: ProgramInfo -> List UType
  foreign-pointer-types info = case info of
    ProgramInfo datas descriptions instances (BindingIndex callable (ForeignBindings names symbols pointers) hints definitions borrows) versions provider exposed effects tail-groups reclaim wasm32 families promoted -> pointers
  index-bindings :: CheckedProgram -> List CoreDefinition -> BindingIndex
  index-bindings checked definitions =
    let bindings = reverse (elaboration-bindings (checked.elaboration)) in
    let callable = index-callable bindings (CallableBindings hash-map-empty hash-map-empty hash-map-empty hash-map-empty hash-map-empty) in
    let foreigns = index-foreign bindings (ForeignBindings hash-map-empty hash-map-empty []) in
    BindingIndex callable foreigns (collect-function-hints (checked.surface.modules) None) (index-definitions (reverse definitions) hash-map-empty) empty-ownership-plan
  program-ownership :: ProgramInfo -> OwnershipPlan
  program-ownership info = case info of
    ProgramInfo datas descriptions instances (BindingIndex callable foreigns hints definitions plan) versions provider exposed effects tail-groups reclaim wasm32 families promoted -> plan
  with-ownership-plan :: OwnershipPlan -> ProgramInfo -> ProgramInfo
  with-ownership-plan plan info = case info of
    ProgramInfo datas descriptions instances (BindingIndex callable foreigns hints definitions old) versions provider exposed effects tail-groups reclaim wasm32 families promoted ->
      ProgramInfo datas descriptions instances (BindingIndex callable foreigns hints definitions plan) versions provider exposed effects tail-groups reclaim wasm32 families promoted
  program-borrow-modes :: ProgramInfo -> HashMap String (List Bool)
  program-borrow-modes info = case program-ownership info of
    OwnershipPlan borrows consumed arenas concurrent -> borrows
  program-consumed-params :: ProgramInfo -> HashMap String (List Bool)
  program-consumed-params info = case program-ownership info of
    OwnershipPlan borrows consumed arenas concurrent -> consumed
  program-arena-phases :: ProgramInfo -> HashMap String Bool
  program-arena-phases info = case program-ownership info of
    OwnershipPlan borrows consumed arenas concurrent -> arenas
  program-concurrent :: ProgramInfo -> Bool
  program-concurrent info = case program-ownership info of
    OwnershipPlan borrows consumed arenas concurrent -> concurrent
  same-ownership-plan :: List CoreDefinition -> OwnershipPlan -> OwnershipPlan -> Bool
  same-ownership-plan definitions left right = case left of
    OwnershipPlan b1 c1 a1 m1 -> case right of
      OwnershipPlan b2 c2 a2 m2 ->
        (if m1 then m2 else not m2)
        && same-borrow-modes definitions b1 b2
        && same-bool-maps definitions c1 c2
        && same-arena-phases definitions a1 a2
  prepend-binding :: forall a. String -> a -> HashMap String (List a) -> HashMap String (List a)
  prepend-binding key value entries = case hash-map-lookup key entries of
    Some found -> hash-map-insert key (value : found) entries
    None -> hash-map-insert key [value] entries
  index-callable :: List CheckedBinding -> CallableBindings -> CallableBindings
  index-callable bindings index = case bindings of
    [] -> index
    binding : rest -> case index of
      CallableBindings methods externals instances bodies natives ->
        let role = checked-role binding in
        let name = checked-name binding in
        let next-methods = if role == "method" then prepend-binding name binding methods else methods in
        let next-externals = if role == "external" then hash-map-insert name binding externals else externals in
        let next-instances = if role == "instance" || role == "implicit-instance" then hash-map-insert name binding instances else instances in
        case checked-body-binding binding of
          Some body -> let function = binding-function body in
            index-callable rest (CallableBindings next-methods next-externals next-instances (hash-map-insert name function bodies) (hash-map-insert (binding-native body) function natives))
          None -> index-callable rest (CallableBindings next-methods next-externals next-instances bodies natives)
  collect-function-hints :: List Module -> Option (HashMap String FunctionHints) -> Option (HashMap String FunctionHints)
  collect-function-hints modules hints = case modules of
    [] -> hints
    m : rest -> collect-function-hints rest (index-function-hints (module-decls m) hints)
  lookup-hints :: String -> HashMap String FunctionHints -> FunctionHints
  lookup-hints name hints = case hash-map-lookup name hints of Some attributes -> attributes; None -> FunctionHints "" False None
  index-function-hints :: List Decl -> Option (HashMap String FunctionHints) -> Option (HashMap String FunctionHints)
  index-function-hints ds hints = case ds of
    [] -> hints
    (DInlineHint sp name (Ok hint)) : rest ->
      if hint == "no-alloc" || hint == "no-raw-ptr" || hint == "byval" || hint == "sret" then index-function-hints rest hints
      else let table = (case hints of Some entries -> entries; None -> hash-map-empty) in (case lookup-hints name table of
        FunctionHints inline cold loop -> let updated = if hint == "cold" then FunctionHints inline True loop else FunctionHints hint cold loop in
          index-function-hints rest (Some (hash-map-insert name updated table)))
    (DUnrollHint sp name (Ok count)) : rest -> let table = (case hints of Some entries -> entries; None -> hash-map-empty) in (case lookup-hints name table of
      FunctionHints inline cold loop -> index-function-hints rest (Some (hash-map-insert name (FunctionHints inline cold (Some count)) table)))
    other : rest -> index-function-hints rest hints
  function-hints :: ProgramInfo -> String -> FunctionHints
  function-hints info name = case info of
    ProgramInfo datas descriptions instances (BindingIndex callable foreigns (Some hints) definitions borrows) versions provider exposed effects tail-groups reclaim wasm32 families promoted -> lookup-hints name hints
    other -> FunctionHints "" False None
  function-hint :: ProgramInfo -> String -> String
  function-hint info name = case function-hints info name of FunctionHints inline cold loop -> inline
  llvm-hint :: Writer -> String -> String
  llvm-hint w name = case function-hints (writer-program w) name of
    FunctionHints inline cold loop -> (if inline == "" then "" else " " <> inline) <> (if cold then " cold" else "")
  index-foreign :: List CheckedBinding -> ForeignBindings -> ForeignBindings
  index-foreign bindings index = case bindings of
    [] -> index
    binding : rest -> case index of
      ForeignBindings names symbols pointers ->
        let plan = checked-foreign-plan binding in
        let next = hash-map-insert (checked-name binding) plan names in
        case plan of
          None -> index-foreign rest (ForeignBindings next symbols pointers)
          Some abi -> index-foreign rest (ForeignBindings next (prepend-binding (abi.symbol) abi symbols) (add-pointer-types (abi.parameters) (add-pointer-type (abi.result) pointers)))
  add-pointer-type :: ForeignParameter -> List UType -> List UType
  add-pointer-type parameter tail = if parameter.class == "ptr" then (parameter.parameter-type) : tail else tail
  add-pointer-types :: List ForeignParameter -> List UType -> List UType
  add-pointer-types params tail = case params of
    [] -> tail
    first : rest -> add-pointer-type first (add-pointer-types rest tail)
  with-versions :: List MethodVersion -> ProgramInfo -> ProgramInfo
  with-versions versions info = case info of ProgramInfo datas descriptions instances bindings old provider exposed effects tail-groups reclaim wasm32 families promoted -> ProgramInfo datas descriptions instances bindings versions provider exposed effects tail-groups reclaim wasm32 families promoted
  -- Whether this emission counts references (`--no-reclaim` and
  -- `CINCH_RECLAIM=0` select the other arm): the one switch every
  -- ownership operation reads, so a leak-baseline build emits none of
  -- them and every block it allocates stays live until exit.
  with-tail-groups :: HashMap String (Nat, Nat) -> ProgramInfo -> ProgramInfo
  with-tail-groups groups info = case info of
    ProgramInfo datas descriptions instances bindings versions provider exposed effects old reclaim wasm32 families promoted ->
      ProgramInfo datas descriptions instances bindings versions provider exposed effects groups reclaim wasm32 families promoted
  exposed-worker :: String -> List String -> Bool
  exposed-worker name names = case names of [] -> False; first : rest -> name == first || exposed-worker name rest
  worker-linkage :: Writer -> String -> String
  worker-linkage w name = case writer-program w of
    ProgramInfo datas descriptions instances bindings versions provider exposed effects tail-groups reclaim wasm32 families promoted -> case exposed of
      None -> ""
      Some names -> if exposed-worker name names then "" else "internal "
  same-classes :: List Nat -> List Nat -> Bool
  same-classes first second = case first of
    [] -> case second of [] -> True; other -> False
    a : rest -> case second of b : more -> a == b && same-classes rest more; [] -> False
  version-present :: String -> Nat -> List Nat -> List MethodVersion -> Bool
  version-present owner slot classes versions = case versions of
    [] -> False
    (MethodVersion name index actual) : rest -> (owner == name && slot == index && same-classes classes actual) || version-present owner slot classes rest
  note-version :: String -> Nat -> List Nat -> Writer -> Writer
  note-version owner slot classes w = case w of
    Writer next globals code errors layouts (RuntimeContext info bounds rigids queue inlining) ->
      if list-length classes == 0 || version-present owner slot classes (info.versions) then w else
        Writer next globals code errors layouts (RuntimeContext (with-versions (info.versions <> [MethodVersion owner slot classes]) info) bounds rigids queue inlining)
  method-class-ids :: CoreClassMethod -> List Nat
  method-class-ids member = case scheme-requirements (class-method-scheme member) of self : rest -> type-free-bound (self.ty); [] -> []
  id-present :: Nat -> List Nat -> Bool
  id-present id ids = case ids of [] -> False; first : rest -> id == first || id-present id rest
  own-quants :: List Nat -> List Quant -> List Quant
  own-quants inherited qs = case qs of [] -> []; q : rest -> if id-present (q.id) inherited then own-quants inherited rest else q : (own-quants inherited rest)
  own-actuals :: List Nat -> List Quant -> List UType -> List UType
  own-actuals inherited qs actuals = case qs of
    [] -> []
    q : rest -> case actuals of
      actual : more -> if id-present (q.id) inherited then own-actuals inherited rest more else actual : (own-actuals inherited rest more)
      [] -> []
  method-own-quants :: CoreClassMethod -> List Quant
  method-own-quants member = own-quants (method-class-ids member) (scheme-params (class-method-scheme member))
  method-own-classes :: Writer -> CoreClassMethod -> List UType -> Option (List Nat)
  method-own-classes w member actuals = if list-length actuals /= list-length (scheme-params (class-method-scheme member)) then None else
    scheme-classes (w.context) (method-own-quants member) (own-actuals (method-class-ids member) (scheme-params (class-method-scheme member)) actuals)
  default-own :: List Quant -> List Nat
  default-own qs = case qs of [] -> []; q : rest -> if kind-equal (q.kind) KType then 1 : (default-own rest) else default-own rest
  selected-versions :: String -> Nat -> List MethodVersion -> List (List Nat)
  selected-versions owner slot versions = case versions of
    [] -> []
    (MethodVersion name index classes) : rest -> if owner == name && slot == index then classes : (selected-versions owner slot rest) else selected-versions owner slot rest
  classes-before :: List Nat -> List Nat -> Bool
  classes-before first second = case first of
    [] -> case second of b : more -> True; [] -> False
    a : rest -> case second of b : more -> a < b || (a == b && classes-before rest more); [] -> False
  insert-version :: List Nat -> List (List Nat) -> List (List Nat)
  insert-version classes versions = case versions of
    [] -> [classes]
    first : rest -> if classes-before classes first then classes : versions else first : (insert-version classes rest)
  sort-versions :: List (List Nat) -> List (List Nat)
  sort-versions versions = case versions of [] -> []; first : rest -> insert-version first (sort-versions rest)
  member-versions :: Writer -> String -> CoreClassMethod -> List (List Nat)
  member-versions w owner member = case selected-versions owner (class-method-slot member) ((writer-program w).versions) of
    [] -> [default-own (method-own-quants member)]
    found -> sort-versions found
  primary-method-slots :: Writer -> String -> List CoreClassMethod -> List MethodSlot
  primary-method-slots w owner members = case members of
    [] -> []
    member : rest -> let classes = case member-versions w owner member of first : more -> first; [] -> [] in
      (MethodSlot (class-method-slot member) (class-method-slot member) classes) : (primary-method-slots w owner rest)
  extra-method-versions :: Nat -> Nat -> List (List Nat) -> (Nat, List MethodSlot)
  extra-method-versions slot next versions = case versions of
    [] -> (next, [])
    first : rest -> case extra-method-versions slot (next + 1) rest of
      (finish, more) -> (finish, (MethodSlot slot next first) : more)
  extra-method-slots :: Writer -> String -> Nat -> List CoreClassMethod -> List MethodSlot
  extra-method-slots w owner next members = case members of
    [] -> []
    member : rest -> let versions = case member-versions w owner member of first : more -> more; [] -> [] in
      case extra-method-versions (class-method-slot member) next versions of
        (finish, own-codes) -> own-codes <> extra-method-slots w owner finish rest
  class-method-slots :: Writer -> CoreClass -> List MethodSlot
  class-method-slots w description = case (writer-program w).object of
    Some provider -> (case object-family (description.name) provider of
      Some (declared, slots) -> if declared == list-length (description.methods) then imported-method-slots slots else []
      None -> source-method-slots w description)
    None -> source-method-slots w description
  imported-method-slots :: List (Nat, Nat, List Nat) -> List MethodSlot
  imported-method-slots slots = case slots of [] -> []; (logical, physical, codes) : rest -> (MethodSlot logical physical codes) : (imported-method-slots rest)
  source-method-slots :: Writer -> CoreClass -> List MethodSlot
  source-method-slots w description = primary-method-slots w (description.name) (description.methods)
    <> extra-method-slots w (description.name) (list-length (description.methods)) (description.methods)
  method-physical-slot :: Nat -> List Nat -> List MethodSlot -> Option Nat
  method-physical-slot slot own-codes plans = case plans of
    [] -> None
    (MethodSlot logical physical classes) : rest -> if slot == logical && same-classes own-codes classes then Some physical else method-physical-slot slot own-codes rest
  take-classes :: Nat -> List Nat -> List Nat
  take-classes count classes = if count == 0 then [] else case classes of [] -> []; first : rest -> first : (take-classes (count - 1) rest)
  type-param-count :: List Quant -> Nat
  type-param-count qs = case qs of [] -> 0; q : rest -> (if kind-equal (q.kind) KType then 1 else 0) + type-param-count rest
  method-reference :: String -> String -> Nat -> ProgramInfo -> Bool
  method-reference name owner slot info = case program-callable-bindings info of
    CallableBindings methods externals instances bodies natives -> case hash-map-lookup name methods of
      Some bindings -> matches-method name owner slot bindings
      None -> False
  matches-method :: String -> String -> Nat -> List CheckedBinding -> Bool
  matches-method name owner slot bindings = case bindings of
    [] -> False
    binding : rest -> checked-method-matches binding name owner slot || matches-method name owner slot rest
  data-declaration :: String -> ProgramInfo -> Option CoreData
  data-declaration name info = case info.index-of of DataIndex datas types constructors unpacked -> hash-map-lookup name types
  type-head :: UType -> UType
  type-head ty = case base ty of UApp f x -> type-head f; other -> other
  representation :: Nat -> List (Nat, Nat) -> Option Nat
  representation id entries = case entries of [] -> None; (key, code) : rest -> if key == id then Some code else representation id rest
  -- Kernel Dec stores a tag only. Its checked proposition is erased;
  -- source datatypes cannot supply this builtin identity or its layout.
  decision-word-type :: UType -> Bool
  decision-word-type ty = case base ty of
    UApp (UCon name kind) predicate -> name == "b.Dec" && kind-equal kind (KFun KProp KType) && kind-equal (type-kind predicate) KProp && valid-type predicate
    other -> False
  foreign-type-equal :: UType -> UType -> Bool
  foreign-type-equal first second = valid-type first && valid-type second && (case store-errors (unify (Span 0 0 1 1) first second (empty-store "foreign ABI type")) of [] -> True; other -> False)
  opaque-foreign-word :: UType -> List UType -> Bool
  opaque-foreign-word ty pointers = case pointers of
    [] -> False
    first : rest -> foreign-type-equal ty first || opaque-foreign-word ty rest
  checked-string-word :: String -> ProgramInfo -> Bool
  checked-string-word name info = case info.object of
    Some provider -> case object-string-layout name provider of Some descriptor -> True; None -> False
    None -> False
  program-word-bits :: ProgramInfo -> Nat
  program-word-bits info = if program-wasm32 info then 32 else 64
  program-ptr-bytes :: ProgramInfo -> Nat
  program-ptr-bytes info = if program-wasm32 info then 4 else 8
  encode-val-class :: Nat -> Nat -> Nat
  encode-val-class sz al = 4 + sz * 65536 + al
  is-val-class :: Nat -> Bool
  is-val-class code = code >= 4
  val-class-size :: Nat -> Nat
  val-class-size code = if 4 <= code then (code - 4) / 65536 else 0
  val-class-align :: Nat -> Nat
  val-class-align code = if 4 <= code then (code - 4) % 65536 else 1
  val-size-words :: Nat -> Nat
  val-size-words sz = if sz == 0 then 1 else (sz + 7) / 8
  val-class-words :: Nat -> Nat
  val-class-words code = val-size-words (val-class-size code)
  val-needs-sret-apply :: Nat -> Nat -> Bool
  val-needs-sret-apply sz al = sz > 8 || al > 16
  val-code-needs-sret-apply :: Nat -> Bool
  val-code-needs-sret-apply code = is-val-class code && val-needs-sret-apply (val-class-size code) (val-class-align code)
  val-code :: List Nat -> Bool
  val-code classes = case classes of [] -> False; code : rest -> is-val-class code || val-code rest
  val-refusal :: String
  val-refusal = "unboxed value type cannot occupy a uniform-word runtime container (wrap in Box)"
  type-value-size-align :: RuntimeContext -> UType -> Option (Nat, Nat)
  type-value-size-align context raw-ty =
    let ty = base (reduce-types (context.info.type-families) (context.info.promoted-fns) raw-ty) in
    case fixed-array-parts ty of
      Some pair -> pod-type-layout (program-word-bits (context.info)) (context.info.index-of.datas) ty
      None -> case ty of
        UBound id name KType -> (case context of
          RuntimeContext datas bounds rigids queue inlining ->
            case representation id bounds of
              Some code | is-val-class code -> Some (val-class-size code, val-class-align code)
              other -> None)
        URigid id name level KType -> (case context of
          RuntimeContext datas bounds rigids queue inlining ->
            case representation id rigids of
              Some code | is-val-class code -> Some (val-class-size code, val-class-align code)
              other -> None)
        other -> case type-head ty of
          UCon name KType -> (case value-layout-of name (context.info.index-of.datas) of
            Some (repr, sz, al, fs) -> Some (sz, al)
            None -> None)
          other -> None
  is-value-type :: RuntimeContext -> UType -> Bool
  is-value-type context ty = case type-value-size-align context ty of Some pair -> True; None -> False
  is-indirect-value :: RuntimeContext -> UType -> Bool
  is-indirect-value context ty = case type-value-size-align context ty of
    Some (sz, al) -> sz > 16 || al > 16
    None -> False
  word-class :: RuntimeContext -> UType -> Option Nat
  word-class context ty =
    let b = base ty in
    case borrow-type-parts b of
      Some (is-mut, region, carrier) ->
        if is-value-type context carrier then Some 0
        else if is-mut then Some 1
        else word-class context carrier
      None -> case deferral-parts b of
        Some _ -> Some 1
        None -> case lazy-parts b of
          Some _ -> Some 1
          None -> value-word-class context ty
  handler-word-type :: UType -> Bool
  handler-word-type ty = case handler-parts (base ty) of Some parts -> True; None -> False
  -- Sym is an immortal runtime handle, classified Raw by the object ABI.
  value-word-class :: RuntimeContext -> UType -> Option Nat
  value-word-class context raw-ty =
    let ty = reduce-types (context.info.type-families) (context.info.promoted-fns) raw-ty in
    case sing-type-parts (base ty) of
      Some (carrier, val) -> value-word-class context carrier
      None -> case same-type-parts (base ty) of
        Some _ -> Some 0
        None -> case type-value-size-align context ty of
          Some (sz, al) -> Some (encode-val-class sz al)
          None -> if foreign-pointer ty || opaque-foreign-word ty (foreign-pointer-types (context.info)) then Some 0 else if decision-word-type ty || handler-word-type ty then Some 1 else if number ty then Some 2 else if wide-scalar ty then Some 3 else if named ty "Bool" || named ty "Unit" || raw-integer ty || named ty "Char" || named ty "Sym" || named ty "F32" || named ty "F64" then Some 0 else case context of
            RuntimeContext datas bounds rigids queue inlining -> case base ty of
              -- Structural Copy/Kernel/Boxed witnesses travel as Unit, even in a polymorphic closure.
              UApp (UCon name (KFun KType KType)) carrier | (name == "Copy") -> Some 0
              UApp (UCon name (KFun KType KType)) carrier | (name == "Kernel") -> Some 0
              UApp (UCon name (KFun KType KType)) carrier | (name == "Boxed") -> Some 0
              UBound id name KType -> representation id bounds
              URigid id name level KType -> (case representation id rigids of
                Some code -> Some code
                None -> if (ge-i64 (string-compare name "$gadt_") 0 && lt-i64 (string-compare name "$gadt`") 0)
                  || (ge-i64 (string-compare name "$sing_") 0 && lt-i64 (string-compare name "$sing`") 0) then Some 1 else None)
              UIndex carrier idx -> Some 0
              UIndexMath op left right -> Some 0
              UFun domain result -> Some 1
              UFunEff domain row result -> Some 1
              UUsageArrow usage arrow -> Some 1
              UProofFun predicate row result -> Some 1
              UPi id name domain row result -> Some 1
              -- A polymorphic value is its class-indexed bundle: one block.
              UForall qs body -> Some 1
              UTuple fields -> if field-types context fields 0 then Some 1 else None
              USigma id name domain body -> if field-types context (UArg domain (UArg body UEnd)) 0 then Some 1 else None
              other -> case type-head ty of
                UCon name kind -> if (name == "b.Io" && kind-equal kind (KFun KRegion KType)) || (name == "b.Scope" && kind-equal kind scope-kind) || (name == "b.Task" && kind-equal kind task-kind) then Some 0
                  else if promoted-ctor-name name || promoted-str-name name || is-promoted-fn-name name then Some 0
                  else if is-type-family-name name (datas.type-families) then Some 1
                  else if (array-type-name name || cell-type-name name) && kind-equal kind (KFun KType KType) then Some 1
                  else if (name == "Bytes" || name == "String" || name == "AtomicCell") && kind-equal kind KType then Some 1 else
                  (case data-declaration name datas of
                    Some d -> Some (data-word-class d)
                    None -> if kind-equal kind KType && checked-string-word name datas then Some 1
                      else case find-class name (datas.classes) of Some description -> Some 1; None -> None)
                UBound id name kind -> applied-former-class ty kind (representation id bounds)
                URigid id name level kind -> applied-former-class ty kind (representation id rigids)
                other -> None
  data-word-class :: CoreData -> Nat
  data-word-class d = case core-data-layout d of
    UnboxedData label word bytes align -> word
    ValueData repr sz al fs -> encode-val-class sz al
    other -> 1
  uniform-owner :: String -> Writer -> Bool
  uniform-owner name w = case data-declaration name (writer-program w) of
    Some d -> (case core-data-layout d of UniformData -> True; other -> False)
    None -> False
  unboxed-owner :: String -> Writer -> Bool
  unboxed-owner owner w = case data-declaration owner (writer-program w) of
    Some d -> (case core-data-layout d of UnboxedData label word bytes align -> True; other -> False)
    None -> False

  applied-former-class :: UType -> Kind -> Option Nat -> Option Nat
  applied-former-class ty kind code = if former-kind kind && kind-equal (type-kind ty) KType then code else None
  word-type :: RuntimeContext -> UType -> Bool
  word-type context ty = case word-class context ty of Some code -> True; None -> False
  -- A wide scalar (design/wide-scalars.md) is class 3, Wide: one LLVM
  -- `i128` held in registers, two raw words in an object payload, never
  -- counted. It is not a word, so every word position (a closure slot, an
  -- `__apply` argument, a dictionary or bundle field, a shaped object, a
  -- cell) refuses it by name rather than encode code 3, which the runtime's
  -- pointer map reserves as invalid.
  wide-scalar :: UType -> Bool
  wide-scalar ty = named ty "I128" || named ty "U128"
  wide-type :: RuntimeContext -> UType -> Bool
  wide-type context ty = case word-class context ty of Some 3 -> True; other -> False
  -- The LLVM type a value of this type travels as.
  value-llvm :: RuntimeContext -> UType -> String
  value-llvm context ty =
    let b = base (reduce-types (context.info.type-families) (context.info.promoted-fns) ty) in
    if foreign-pointer b then "ptr"
    else case borrow-type-parts b of
      Some (is-mut, region, carrier) | is-value-type context carrier -> "ptr"
      other -> case type-value-size-align context b of
        Some (sz, al) -> if sz > 16 || al > 16 then "ptr" else if sz <= 8 then "i64" else "{ i64, i64 }"
        None -> if wide-type context ty then "i128" else "i64"
  value-param-llvm :: RuntimeContext -> UType -> String
  value-param-llvm context ty = case type-value-size-align context ty of
    Some (sz, al) | sz > 16 || al > 16 ->
      cat ["ptr readonly align ", nat-to-string al, " dereferenceable(", nat-to-string sz, ")"]
    other -> value-llvm context ty
  value-param-llvms :: RuntimeContext -> List UType -> List String
  value-param-llvms context types = case types of [] -> []; ty : rest -> (value-param-llvm context ty) : (value-param-llvms context rest)
  value-sret-info :: RuntimeContext -> UType -> Option (String, Nat, Nat)
  value-sret-info context ty = case type-value-size-align context ty of
    Some (sz, al) | sz > 16 || al > 16 ->
      Some (cat ["ptr sret([", nat-to-string sz, " x i8]) noalias align ", nat-to-string al, " dereferenceable(", nat-to-string sz, ")"], sz, al)
    other -> None
  all-i64-types :: RuntimeContext -> List UType -> Bool
  all-i64-types context types = case types of
    [] -> True
    ty : rest -> value-llvm context ty == "i64" && all-i64-types context rest
  definition-has-non-word :: RuntimeContext -> CoreDefinition -> List UType -> Bool
  definition-has-non-word context d types =
    not (all-i64-types context types)
    || definition-result-llvm context d /= "i64"
    || (case definition-sret-result context d of Some info -> True; None -> False)
    || clauses-have-val-ops (d.clauses)
  clauses-have-val-ops :: List CoreClause -> Bool
  clauses-have-val-ops clauses = case clauses of
    [] -> False
    (CoreClause sp ps body) : rest -> term-has-val-ops body || clauses-have-val-ops rest
  term-has-val-ops :: CoreTerm -> Bool
  term-has-val-ops term = case term of
    CPrimitive sp ty op args -> string-starts-with "val-" op || term-has-val-ops args
    other -> terms-have-val-ops (term-children other)
  terms-have-val-ops :: List CoreTerm -> Bool
  terms-have-val-ops terms = case terms of
    [] -> False
    first : rest -> term-has-val-ops first || terms-have-val-ops rest
  definition-sret-result :: RuntimeContext -> CoreDefinition -> Option (String, Nat, Nat)
  definition-sret-result context d = case d.clauses of
    (CoreClause sp patterns body) : rest -> (case proof-stage-arities patterns 0 of
      [count] -> value-sret-info context (core-type body)
      other -> None)
    [] -> None
  value-llvms :: RuntimeContext -> List UType -> List String
  value-llvms context types = case types of [] -> []; ty : rest -> (value-llvm context ty) : (value-llvms context rest)
  wide-code :: List Nat -> Bool
  wide-code classes = case classes of [] -> False; code : rest -> code == 3 || wide-code rest

  -- Payload words a field list occupies: a wide field takes two, a Val field takes ceil(size/8).max(1).
  payload-words :: RuntimeContext -> List UType -> Nat
  payload-words context fields = case fields of
    [] -> 0
    first : rest -> (case word-class context first of
      Some 3 -> 2
      Some code | is-val-class code -> val-class-words code
      other -> 1) + payload-words context rest
  wide-refusal :: String
  wide-refusal = "a wide scalar (I128 or U128) cannot occupy a word position; its class is Wide"
  field-types :: RuntimeContext -> UType -> Nat -> Bool
  field-types context fields count = case fields of
    UEnd -> True
    UArg first rest -> count < 16 && word-type context first && field-types context rest (count + 1)
    other -> False
  class-vector :: RuntimeContext -> List UType -> Option (List Nat)
  class-vector context actuals = case actuals of
    [] -> Some []
    ty : rest -> case word-class context ty of
      Some code -> case class-vector context rest of Some more -> Some (code : more); None -> None
      None -> None
  class-part :: Nat -> String
  class-part code = if is-val-class code then cat ["V", nat-to-string (val-class-size code), "a", nat-to-string (val-class-align code)] else nat-to-string code
  class-text :: List Nat -> String
  class-text classes = case classes of
    [] -> ""
    [code] -> class-part code
    code : rest -> if is-val-class code then cat [class-part code, "_", class-text rest] else cat [class-part code, class-text rest]
  native-classes :: List Nat -> String
  native-classes classes = case classes of
    [] -> ""
    code : rest -> cat [if code == 0 then "R" else if code == 1 then "O" else if code == 2 then "T" else if code == 3 then "W" else cat ["V", nat-to-string (val-class-size code), "a", nat-to-string (val-class-align code), "_"], native-classes rest]
  specialized-name :: String -> List Nat -> String
  specialized-name name classes = case classes of [] -> name; other -> cat [name, ".r", class-text classes]
  erased-kind :: Kind -> Bool
  erased-kind kind = case kind of KRegion -> True; KEffect -> True; KRow -> True; KProp -> True; other -> False
  -- Native represents a type former and an abstract application of it
  -- as Obj. Keep its position in the specialization vector.
  former-kind :: Kind -> Bool
  former-kind kind = case kind of
    KFun input result -> kind-equal result KType || former-kind result
    other -> False
  quant-word-class :: RuntimeContext -> Kind -> UType -> Option Nat
  quant-word-class context kind ty = if kind-equal kind KType then word-class context ty
    else if former-kind kind && kind-equal kind (type-kind ty) then Some 1 else None
  scheme-classes :: RuntimeContext -> List Quant -> List UType -> Option (List Nat)
  scheme-classes context qs actuals = case qs of
    [] -> case actuals of [] -> Some []; other -> None
    q : rest -> case actuals of
      actual : more -> if erased-kind (q.kind) then scheme-classes context rest more else
        (case quant-word-class context (q.kind) actual of
          Some code -> case scheme-classes context rest more of Some tail -> Some (code : tail); None -> None
          None -> None)
      [] -> None
  source-scheme-classes :: RuntimeContext -> List Quant -> List UType -> Option (List Nat)
  source-scheme-classes context qs actuals = case qs of
    [] -> case actuals of [] -> Some []; other -> None
    q : rest -> case actuals of
      actual : more -> (case value-carrier (q.kind) of
        Some carrier -> if typed-index-admissible actual || valid-app-arg-kind (q.kind) actual then source-scheme-classes context rest more else None
        None -> if erased-kind (q.kind) then source-scheme-classes context rest more else
          (case quant-word-class context (q.kind) actual of
            Some code -> case source-scheme-classes context rest more of Some tail -> Some (code : tail); None -> None
            None -> None))
      [] -> None
  class-bindings :: List Quant -> List Nat -> Option (List (Nat, Nat))
  class-bindings qs classes = case qs of
    [] -> case classes of [] -> Some []; other -> None
    q : rest -> if erased-kind (q.kind) || (case value-carrier (q.kind) of Some carrier -> True; None -> False) then class-bindings rest classes else
      (case classes of
        code : more -> let kind = q.kind in
          if kind-equal kind KType || (former-kind kind && code == 1) then
          (case class-bindings rest more of Some tail -> Some ((q.id, code) : tail); None -> None) else None
        [] -> None)
  rigid-bindings :: List (Nat, UType) -> List (Nat, Nat) -> Option (List (Nat, Nat))
  rigid-bindings openings bounds = case openings of
    [] -> Some []
    (key, URigid id name level kind) : rest -> if erased-kind kind || (case value-carrier kind of Some carrier -> True; None -> False) then rigid-bindings rest bounds else
      (case representation key bounds of
        Some code -> case rigid-bindings rest bounds of Some more -> Some ((id, code) : more); None -> None
        None -> None)
    (key, UIndex carrier (IRigid id name level)) : rest -> rigid-bindings rest bounds
    other -> None
  -- Unconstrained body-local Type variables are sealed by Core typing.
  -- Choose Unit's word class for their internal specializations.
  private-word-classes :: List (Nat, Kind) -> List (Nat, Nat)
  private-word-classes entries = case entries of
    [] -> []
    (id, KType) : rest -> (id, 0) : (private-word-classes rest)
    other : rest -> private-word-classes rest
  definition-rigids :: CoreDefinition -> List (Nat, Nat) -> Option (List (Nat, Nat))
  definition-rigids d bounds = case rigid-bindings (d.openings) bounds of
    None -> None
    Some opened -> Some (opened <> private-word-classes (d.private-types))
  with-representations :: List (Nat, Nat) -> List (Nat, Nat) -> Writer -> Writer
  with-representations bounds rigids w = case w of
    Writer next globals code errors layouts (RuntimeContext datas old-bound old-rigid queue inlining) ->
      Writer next globals code errors layouts (RuntimeContext datas bounds rigids queue inlining)
  demand-key :: Demand -> String
  demand-key demand = case demand of
    Demand name classes -> specialized-name name classes
    ConstructorDemand name classes -> specialized-name name classes
    LambdaDemand name bounds rigids saved parameter body -> name
    RecursiveDemand (RecursiveWorker id ty name parameters body) group bounds rigids saved -> name
    StubDemand name classes ret-class -> cat [name, ".app"]
    DictionaryDemand name classes -> dictionary-name name classes
    ArrayDemand name classes -> array-symbol name classes
    MVarDemand name classes -> specialized-name name classes
    BuiltinDemand name -> name
    SymbolEquality -> "runtime:symEq"
    MemoWorker -> "runtime:memo"
    ExternalDemand unit -> cat ["external:", unit.symbol]
    ForeignDemand plan -> cat ["foreign:", plan.symbol]
    ForeignNullFault -> "foreign pointer fault"
    PrimitiveIntrinsicDemand symbol -> cat ["inline intrinsic:", symbol]
    PrimitiveUseDemand symbol decl -> cat ["prim use:", symbol]
    CprDemand name classes -> cat [specialized-name name classes, "#cpr"]
    BorrowDemand name classes -> cat [specialized-name name classes, "#b"]
    BuiltinBorrowDemand name -> cat [name, "#borrow"]
    MemcpyDemand -> "intrinsic:llvm.memcpy"
    MemsetDemand -> "intrinsic:llvm.memset"
  request-demand :: Demand -> Writer -> Writer
  request-demand demand w = case w of
    Writer next globals code errors layouts (RuntimeContext datas bounds rigids (WorkerQueue pending keys dictionaries scope serial unit-mode) inlining) ->
      let key = demand-key demand in case hash-map-lookup key keys of
        Some found -> w
        None -> let queue = WorkerQueue (demand : pending) (hash-map-insert key () keys) dictionaries scope serial unit-mode in
          Writer next globals code errors layouts (RuntimeContext datas bounds rigids queue inlining)
  demand-worker :: String -> List Nat -> Writer -> Writer
  demand-worker name classes w = request-demand (Demand name classes) w
  runtime-number :: UType -> String
  runtime-number ty = if named ty "Nat" then "nat" else "int"
  -- Count operations call the module's alwaysinline helpers (count-helpers),
  -- the inline fast paths of design/reclamation.md sections 3, 4 and 8.
  -- A constant operand is 0, a raw word or an immediate, never a block.
  count-call :: Bool -> String -> String
  count-call duplicate value = cat ["  call void @cinch.typed.rc.", if duplicate then "dup" else "drop", "(i64 ", value, ")"]
  count-call-local :: Bool -> String -> String
  count-call-local duplicate value = cat ["  call void @cinch.typed.rc.", if duplicate then "dup" else "drop", ".local(i64 ", value, ")"]
  constant-word :: String -> Bool
  constant-word value = case string-char-at value 0 of
    Some c -> let code = char-code c in (code >= 48 && code <= 57) || code == 45
    None -> False
  is-immortal-enum-type :: RuntimeContext -> UType -> Bool
  is-immortal-enum-type context ty = case type-head (base ty) of
    UCon name kind -> (case data-declaration name (context.info) of
      Some d -> is-immortal-enum-data d
      None -> False)
    other -> False
  -- One count operation as a line, or nothing under an emission that does
  -- not reclaim. Every direct call site goes through here, so the switch
  -- reaches the array, platform, builtin, stub and memo paths as well as
  -- `count-op`.
  count-line :: Bool -> String -> Writer -> Writer
  count-line duplicate value w = if (writer-program w).reclaim then line w (count-call duplicate value) else w
  count-line-local :: Bool -> String -> Writer -> Writer
  count-line-local duplicate value w = if (writer-program w).reclaim then line w (count-call-local duplicate value) else w
  count-op :: Bool -> UType -> String -> Writer -> Writer
  count-op duplicate ty value w = case word-class (w.context) ty of
    Some 0 -> w
    Some 3 -> w
    Some code | is-val-class code -> w
    Some code -> if constant-word value || is-immortal-enum-type (w.context) ty then w else count-line duplicate value w
    None -> refuse w (Span 0 0 1 1) "reference operation needs a checked runtime representation"
  count-op-local :: Bool -> UType -> String -> Writer -> Writer
  count-op-local duplicate ty value w = case word-class (w.context) ty of
    Some 0 -> w
    Some 3 -> w
    Some code | is-val-class code -> w
    Some code -> if constant-word value || is-immortal-enum-type (w.context) ty then w else count-line-local duplicate value w
    None -> refuse w (Span 0 0 1 1) "reference operation needs a checked runtime representation"
  drop-locals :: List Local -> Writer -> Writer
  drop-locals locals w = case locals of
    [] -> w
    (Local id ty value) : rest -> count-op False ty value (drop-locals rest w)
    (Discard ty value) : rest -> count-op False ty value (drop-locals rest w)
    (Borrowed id ty value) : rest -> drop-locals rest w
    (KnotLocal id region ty value) : rest -> drop-locals rest w
    (GivenLocal name ty value) : rest -> drop-locals rest w
    (KnownSelf symbol name classes context) : rest -> drop-locals rest w
    (DeferredConstructor id ty name actuals args) : rest -> drop-locals rest w
    (SelfValue owner slot ty word) : rest -> drop-locals rest w
    LoopMarker : rest -> drop-locals rest w
    (StackCell id ty ptr-reg) : rest -> drop-locals rest w
  in-loop-locals :: List Local -> Bool
  in-loop-locals locals = case locals of
    [] -> False
    LoopMarker : rest -> True
    other : rest -> in-loop-locals rest
  local :: Nat -> List Local -> Option (UType, String)
  local id locals = case locals of
    [] -> None
    (Local key ty value) : rest -> if key == id then Some (ty, value) else local id rest
    (Discard ty value) : rest -> local id rest
    (Borrowed key ty value) : rest -> if key == id then Some (ty, value) else local id rest
    (KnotLocal key region ty value) : rest -> local id rest
    (GivenLocal name ty value) : rest -> local id rest
    (KnownSelf symbol name classes context) : rest -> local id rest
    (SelfValue owner slot ty word) : rest -> local id rest
    (DeferredConstructor key ty name actuals args) : rest -> local id rest
    LoopMarker : rest -> local id rest
    (StackCell key ty ptr-reg) : rest -> local id rest

  -- A shaped block describes itself (design/self-describing-blocks.md).
  -- Its description is the header's layout field, tag | counted-mask << 8,
  -- when its tag is below 255, its counted fields are among the first 16
  -- and (a constructor or dictionary) its payload fits the small-object
  -- heap. Otherwise it is escaped: the layout field is 255 and the word
  -- before the header holds the address of a static descriptor [tag,
  -- words, mask words...] whose mask covers payload words, the kind's
  -- prefix included. An escaped description is the number
  -- 16777216 + tag + 16777216 * (words + 65536 * mask): it names its
  -- descriptor by content, so two sites share one definition.
  shape-prefix :: Nat -> Nat
  shape-prefix kind = if kind == 2 then 3 else if kind == 3 then 1 else 0
  counted-mask :: List Nat -> Nat -> Nat -> Nat
  counted-mask codes bit mask = case codes of
    [] -> mask
    code : rest -> counted-mask rest (bit * 2) (if code == 0 then mask else mask + bit)
  counted-extent :: List Nat -> Nat -> Nat -> Nat
  counted-extent codes index extent = case codes of
    [] -> extent
    code : rest -> counted-extent rest (index + 1) (if code == 0 then extent else index + 1)
  shape-description :: Nat -> Nat -> List Nat -> Nat
  shape-description kind tag codes =
    let prefix = shape-prefix kind in
    let words = prefix + list-length codes in
    let mask = counted-mask codes 1 0 in
    if tag < 255 && counted-extent codes 0 0 <= 16 && (kind == 2 || words <= 31) then tag + 256 * mask
    else 16777216 + tag + 16777216 * (words + 65536 * mask * (if prefix == 3 then 8 else if prefix == 1 then 2 else 1))
  description-escaped :: Nat -> Bool
  description-escaped description = description >= 16777216
  -- The header's layout field.
  description-field :: Nat -> Nat
  description-field description = if description-escaped description then 255 else description
  descriptor-symbol :: Nat -> String
  descriptor-symbol description = if 16777216 <= description then cat ["@cinch.desc.", nat-to-string (description - 16777216)] else "@cinch.desc.inline"
  descriptor-mask-words :: Nat -> Nat -> String
  descriptor-mask-words mask count = if count == 0 then "" else
    cat [", i64 ", nat-to-string (mask % 18446744073709551616), descriptor-mask-words (mask / 18446744073709551616) (count - 1)]
  -- Emit an escaped description's static descriptor at its first use.
  with-descriptor :: Writer -> Nat -> Writer
  with-descriptor w description = if description < 16777216 then w else
    let key = 2 * description in
    let content = description - 16777216 in
    let rest = content / 16777216 in
    let words = rest % 65536 in
    let mask-count = (words + 63) / 64 in
    let declaration = cat [descriptor-symbol description, " = private unnamed_addr constant [", nat-to-string (2 + mask-count), " x i64] [i64 ",
      nat-to-string (content % 16777216), ", i64 ", nat-to-string words, descriptor-mask-words (rest / 65536) mask-count, "], align 8"] in
    shared-global w key declaration
  -- A description as one word, for a runtime entry that takes either form
  -- (the columnar zip's pair): field << 1 | 1, or the descriptor's address.
  description-word :: Writer -> Nat -> (Writer, String)
  description-word w description = if description-escaped description
    then (with-descriptor w description, cat ["ptrtoint (ptr ", descriptor-symbol description, " to i64)"])
    else (w, nat-to-string (description * 2 + 1))
  -- The allocation of a shaped block of `bytes` payload bytes into
  -- `pointer`: the inline entry with its layout field, or the escaped one
  -- with its descriptor.
  shaped-allocation :: Writer -> String -> String -> Nat -> Nat -> Writer
  shaped-allocation w pointer bytes kind description =
    let entry = if kind == 1 then "@cinch_alloc_ctor" else "@cinch_alloc_shaped" in
    let kind-word = if kind == 1 then "" else cat [", i64 ", nat-to-string kind] in
    if description-escaped description then
      line (with-descriptor w description) (cat ["  ", pointer, " = call ptr ", entry, "_desc(i64 ", bytes, kind-word, ", ptr ", descriptor-symbol description, ")"])
    else line w (cat ["  ", pointer, " = call ptr ", entry, "(i64 ", bytes, kind-word, ", i64 ", nat-to-string description, ")"])
  data StaticWord where
    StaticBits :: Nat -> StaticWord
    StaticAddress :: String -> StaticWord
  -- A heap word is eight bytes on every target. Wasm relocates an address
  -- in the low four bytes, with zero in the high four (little endian).
  static-word-type :: StaticWord -> String
  static-word-type word = case word of StaticAddress address -> "[2 x i32]"; StaticBits bits -> "i64"
  static-word-value :: Bool -> StaticWord -> String
  static-word-value wasm32 word = case word of
    StaticBits bits -> cat ["i64 ", nat-to-string bits]
    StaticAddress address -> if wasm32 then cat ["[2 x i32] [i32 ptrtoint (ptr ", address, " to i32), i32 0]"] else cat ["i64 ptrtoint (ptr ", address, " to i64)"]
  static-block-line :: Bool -> String -> Nat -> Nat -> List StaticWord -> String
  static-block-line wasm32 storage descriptor kind payload =
    let header = StaticBits (static-header kind (description-field descriptor)) in
    let body = header : payload in
    let words = if description-escaped descriptor then (StaticAddress (descriptor-symbol descriptor)) : body else body in
    let values = join (map (static-word-value wasm32) words) in
    let initializer = if wasm32 then cat ["<{ ", join (map static-word-type words), " }> <{ ", values, " }>"] else cat ["[", nat-to-string (list-length words), " x i64] [", values, "]"] in
    cat [storage, " = private unnamed_addr constant ", initializer, ", align 8"]
  static-block :: Writer -> String -> Nat -> Nat -> List StaticWord -> Writer
  static-block w storage descriptor kind payload =
    let wasm32 = program-wasm32 (writer-program w) in
    global (with-descriptor w descriptor) (static-block-line wasm32 storage descriptor kind payload)
  static-prefix-words :: Nat -> Nat
  static-prefix-words description = if description-escaped description then 1 else 0
  -- A payload's per-word codes from its per-field classes: a wide field
  -- is two raw words, so it adds two uncounted codes. Only an object
  -- payload expands; a word position refuses code 3 instead (wide-refusal).
  repeat-zero :: Nat -> List Nat -> List Nat
  repeat-zero n acc = if n == 0 then acc else 0 : (repeat-zero (n - 1) acc)
  word-codes :: List Nat -> List Nat
  word-codes codes = case codes of
    [] -> []
    code : rest -> if code == 3 then 0 : 0 : (word-codes rest)
      else if is-val-class code then repeat-zero (val-class-words code) (word-codes rest)
      else code : (word-codes rest)
  term-types :: List CoreTerm -> List UType
  term-types terms = case terms of [] -> []; term : rest -> (core-type term) : (term-types rest)
  named-layout :: String -> List (String, List Nat) -> Option (List Nat)
  named-layout name groups = case groups of [] -> None; (owner, descriptions) : rest -> if owner == name then Some descriptions else named-layout name rest
  -- A tuple is tag 0 of its anonymous constructor family.
  request-layout :: Span -> List CoreTerm -> Writer -> (Writer, Nat)
  request-layout sp fields w = case class-vector (w.context) (term-types fields) of
    None -> (refuse w sp "tuple fields need checked runtime representations", 0)
    Some classes -> request-tuple-shape sp classes w
  request-tuple-shape :: Span -> List Nat -> Writer -> (Writer, Nat)
  request-tuple-shape sp classes w = let words = word-codes classes in
    if not (val-code classes) && list-length words > 16 then (refuse w sp "tuple layout needs an extended runtime descriptor", 0)
    else (w, shape-description 1 0 words)
  -- `b.Dec` is Yes (tag 0) or No (tag 1), with no fields.
  decision-constructor :: Span -> Bool -> Writer -> (Writer, String)
  decision-constructor sp positive w = allocate w (if positive then 0 else 1) []
  decision-expression :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> (Writer, String)
  decision-expression definitions locals w sp test = case expression definitions locals w test of
    (tested, condition) ->
      let (one, predicate) = fresh tested "%v" in
      let (two, yes) = fresh one "decision-yes" in
      let (three, no) = fresh two "decision-no" in
      let (four, joined) = fresh three "decision-join" in
      let split = line (line four (cat ["  ", predicate, " = icmp ne i64 ", condition, ", 0"])) (cat ["  br i1 ", predicate, ", label %", yes, ", label %", no]) in
      let (left, yes-value) = decision-constructor sp True (line split (cat [yes, ":"])) in
      let middle = line (line left (cat ["  br label %", joined])) (cat [no, ":"]) in
      let (right, no-value) = decision-constructor sp False middle in
      let (ready, result) = fresh (line (line right (cat ["  br label %", joined])) (cat [joined, ":"])) "%v" in
      (line ready (cat ["  ", result, " = phi i64 [ ", yes-value, ", %", yes, " ], [ ", no-value, ", %", no, " ]"]), result)
  erased-decision-fields :: CorePattern -> Bool
  erased-decision-fields fields = case fields of
    CPField sp (CPProof at predicate id name) (CPDone end) -> True
    other -> False
  -- | Match constructor parameters while erasing runtime identities and preserving
  -- the representation-bearing type and machine-width arguments.
  regular-parameters :: List Quant -> List Quant -> Bool
  regular-parameters expected actual = case expected of
    [] -> case actual of [] -> True; other -> False
    q : rest -> case actual of
      p : more -> if q.id == p.id then
        kind-equal (q.kind) (p.kind) && (kind-equal (q.kind) KType || former-kind (q.kind) || kind-equal (q.kind) KRegion || (case value-carrier (q.kind) of Some carrier -> True; None -> False)) && regular-parameters rest more
        else (case value-carrier (q.kind) of Some carrier -> regular-parameters rest actual; None -> False)
      [] -> (case value-carrier (q.kind) of Some carrier -> regular-parameters rest []; None -> False)
  without-natural-indices :: List Quant -> List Quant
  without-natural-indices parameters = case parameters of
    [] -> []
    q : rest -> let tail = without-natural-indices rest in
      if kind-equal (q.kind) (value-kind (UCon "Nat" KType)) then tail else q : tail

  data-result :: CoreData -> UType
  data-result d = data-result-args (UCon (core-data-name d) (core-data-kind d)) (core-data-params d)
  data-result-args :: UType -> List Quant -> UType
  data-result-args result qs = case qs of [] -> result; q : rest -> data-result-args (UApp result (UBound (q.id) (q.name) (q.kind))) rest
  constructor-shape :: RuntimeContext -> UType -> UType -> Bool
  constructor-shape context result ty = case ty of
    UFun domain more -> word-type context domain && constructor-shape context result more
    UPi id name domain (URow UEnd) more -> word-type context domain && constructor-shape context result more
    UProofFun predicate (URow UEnd) more -> valid-type predicate && kind-equal (type-kind predicate) KProp
      && constructor-shape context result more
    other -> same-data-result ty result
  same-data-result :: UType -> UType -> Bool
  same-data-result first second = case first of
    UCon a ka -> case second of UCon b kb -> a == b && kind-equal ka kb; other -> False
    UBound a an ka -> case second of
      UBound b bn kb -> a == b && kind-equal ka kb
      -- Normalization represents a bound value index as UIndex/IBound.
      -- Compare the same binder and its checked carrier, never an arbitrary
      -- computed or constructor-local index with a family parameter.
      UIndex carrier (IBound b bn) -> a == b && (case value-carrier ka of Some expected -> runtime-type-equal expected carrier; None -> False)
      other -> False
    UIndex carrier (IBound a an) -> case second of
      UBound b bn kb -> a == b && (case value-carrier kb of Some expected -> runtime-type-equal carrier expected; None -> False)
      UIndex input (IBound b bn) -> a == b && runtime-type-equal carrier input
      other -> False
    UApp f x -> case second of UApp g y -> same-data-result f g && (same-data-result x y || erased-layout-index x y); other -> False
    other -> False
  -- A checked value index does not choose a runtime representation.
  -- Ordinary type parameters still retain their exact declared identity;
  -- family/constructor quantifier identity and every field representation
  -- are checked separately below. This permits Signal 1/Signal 2 to share
  -- one tagged family layout without reifying their phantom Nat index.
  erased-layout-index :: UType -> UType -> Bool
  erased-layout-index actual parameter = case value-carrier (type-kind actual) of
    Some carrier -> case value-carrier (type-kind parameter) of
      Some expected -> typed-index-admissible actual && runtime-type-equal carrier expected
      None -> False
    None -> False
  same-data-head :: UType -> String -> Bool
  same-data-head ty owner = case type-head ty of
    UCon name kind -> name == owner
    other -> False
  gadt-constructor-shape :: RuntimeContext -> String -> UType -> Bool
  gadt-constructor-shape context owner ty = case ty of
    UFun domain more -> word-type context domain && gadt-constructor-shape context owner more
    UPi id name domain (URow UEnd) more -> word-type context domain && gadt-constructor-shape context owner more
    UProofFun predicate (URow UEnd) more -> valid-type predicate && kind-equal (type-kind predicate) KProp
      && gadt-constructor-shape context owner more
    other -> same-data-head ty owner
  regular-constructor :: CoreData -> CoreConstructor -> Bool
  regular-constructor d c = let sc = c.constructor-scheme in
    (regular-parameters (core-data-params d) (scheme-params sc) ||
      (constructor-pattern-supported sc && regular-parameters (core-data-params d)
        (without-natural-indices (scheme-params sc))))
    && same-data-result (final-result (scheme-body sc)) (data-result d)
  add-missing-bounds :: List Quant -> List (Nat, Nat) -> List (Nat, Nat)
  add-missing-bounds qs bounds = case qs of
    [] -> bounds
    q : rest -> case representation (q.id) bounds of
      Some _ -> add-missing-bounds rest bounds
      None -> if kind-equal (q.kind) KType || former-kind (q.kind)
        then add-missing-bounds rest ((q.id, 1) : bounds)
        else add-missing-bounds rest bounds
  gadt-fallback-context :: RuntimeContext -> CoreConstructor -> RuntimeContext
  gadt-fallback-context context c = case context of
    RuntimeContext datas bounds rigids queue inlining ->
      RuntimeContext datas (add-missing-bounds (scheme-params (c.constructor-scheme)) bounds) rigids queue inlining
  -- Escaped descriptors carry as many mask words as the payload needs.
  -- Their packed identity reserves sixteen bits for the physical word count.
  constructor-supported :: RuntimeContext -> CoreData -> CoreConstructor -> Bool
  constructor-supported context d c = let sc = c.constructor-scheme in
    if regular-constructor d c then
      (case scheme-requirements sc of [] -> True; other -> False)
      && constructor-shape context (data-result d) (scheme-body sc) && payload-words context (storage-fields d c) < 65536
    else
      let gctx = gadt-fallback-context context c in
      (case scheme-requirements sc of [] -> True; other -> False)
      && gadt-constructor-shape gctx (core-data-name d) (scheme-body sc) && payload-words gctx (storage-fields d c) < 65536
  storage-fields :: CoreData -> CoreConstructor -> List UType
  storage-fields d c = case core-data-layout d of UnpackedRecord slots -> physical-fields slots; other -> core-constructor-fields c
  -- Each constructor's description, by tag. A constructor the lowering
  -- cannot represent is refused once, when its family is first described.
  constructor-descriptions :: RuntimeContext -> CoreData -> Nat -> List CoreConstructor -> Writer -> (Writer, List Nat)
  constructor-descriptions context d tag constructors w = case constructors of
    [] -> (w, [])
    c : rest ->
      let fctx = if regular-constructor d c then context else gadt-fallback-context context c in
      let (checked, description) = (if not (constructor-supported context d c) then
          (refuse w (Span 0 0 1 1) (cat ["constructor ", c.constructor-name, " needs dependent, existential or extended runtime lowering"]), 0)
        else case class-vector fctx (storage-fields d c) of
          None -> (refuse w (Span 0 0 1 1) "constructor field representation is unknown", 0)
          Some codes -> (w, shape-description 1 tag (word-codes codes))) in
      case constructor-descriptions context d (tag + 1) rest checked of
        (done, more) -> (done, description : more)
  request-data :: Span -> CoreData -> List Nat -> Writer -> (Writer, List Nat)
  request-data sp d classes w = case class-bindings (core-data-params d) classes of
    None -> (refuse w sp "data parameters need first-order runtime representation classes", [])
    Some bounds -> case w of
      Writer next globals code errors (LayoutPlan names) (RuntimeContext datas old-bound rigids queue inlining) ->
        let key = specialized-name (core-data-name d) classes in
        case named-layout key names of
          Some descriptions -> (w, descriptions)
          None -> if list-length (core-data-constructors d) >= 16777216 then
            (refuse w sp "data family exceeds the runtime descriptor tag capacity", [])
            else case constructor-descriptions (RuntimeContext datas bounds [] queue inlining) d 0 (core-data-constructors d) w of
              (described, descriptions) -> (remember-layout key descriptions described, descriptions)
  remember-layout :: String -> List Nat -> Writer -> Writer
  remember-layout key descriptions w = case w of
    Writer next globals code errors (LayoutPlan names) context -> Writer next globals code errors (LayoutPlan ((key, descriptions) : names)) context
  -- The description of a family's constructor `tag`.
  data-descriptor :: List Nat -> Nat -> Nat
  data-descriptor descriptions tag = case descriptions of
    [] -> 0
    first : rest -> if tag == 0 then first else data-descriptor rest (tag - 1)
  constructor :: String -> ProgramInfo -> Option (String, Nat, CoreConstructor)
  constructor name info = case info.index-of of DataIndex datas types constructors unpacked -> hash-map-lookup name constructors
  -- Preserve first-definition lookup order for both source workers and
  -- dictionary fields. The index never determines emitted worker order.
  index-definitions :: List CoreDefinition -> HashMap String CoreDefinition -> HashMap String CoreDefinition
  index-definitions reversed table = case reversed of
    [] -> table
    d : rest -> index-definitions rest (hash-map-insert (d.name) d table)
  worker-definition :: String -> Writer -> Option CoreDefinition
  worker-definition name w = case writer-program w of
    ProgramInfo datas descriptions instances (BindingIndex callable foreigns hints definitions borrows) versions provider exposed effects groups reclaim wasm32 families promoted -> hash-map-lookup name definitions
  borrowed-local-word :: List Local -> CoreTerm -> Option String
  borrowed-local-word locals term = case term of
    CForget sp ty inner -> borrowed-local-word locals inner
    CCast sp ty inner -> borrowed-local-word locals inner
    CLocal sp ty id name [] -> (case local id locals of Some (decl, word) -> Some word; None -> None)
    other -> None
  join :: List String -> String
  join words = case words of [] -> ""; [word] -> word; word : rest -> cat [word, ", ", join rest]
  argument-words :: List String -> List String
  argument-words values = case values of [] -> []; value : rest -> (cat ["i64 ", value]) : (argument-words rest)
  call :: Writer -> String -> List String -> (Writer, String)
  call w name args = let (next, result) = fresh w "%v" in
    (line next (cat ["  ", result, " = call i64 ", name, "(", join (argument-words args), ")"]), result)
  -- A literal in the runtime ABI's immediate range is its own word,
  -- v * 2 + 1 for a Nat in 0..2^63-1 or an Int in -2^62..2^62-1 (the word
  -- cinch_*_from_decimal returns for the same value, seed/runtime/src/abi.rs).
  -- Other literals parse their decimal text through the runtime.
  decimal :: Writer -> UType -> String -> (Writer, String)
  decimal w ty text = case immediate-literal (named ty "Nat") text of
    Some word -> (w, word)
    None ->
      let (next, name) = fresh-scoped w "number" in
      let len = nat-to-string (string-length text) in
      let declared = global next (cat [name, " = private unnamed_addr constant [", len, " x i8] c\"", text, "\""]) in
      let (ready, result) = fresh declared "%v" in
      (line ready (cat ["  ", result, " = call i64 @cinch_", runtime-number ty, "_from_decimal(ptr ", name, ", i64 ", len, ")"]), result)
  decimal-bytes :: Bytes -> Nat -> Nat -> Option Nat
  decimal-bytes bs idx value =
    if idx < bytes-len bs then
      let code = bytes-get bs idx in
      if code >= 48 && code <= 57 then decimal-bytes bs (idx + 1) (value * 10 + (code - 48)) else None
    else Some value
  -- The immediate word of a decimal literal, printed as an unsigned (Nat)
  -- or signed (Int) i64 constant.
  immediate-literal :: Bool -> String -> Option String
  immediate-literal natural text =
    let bs = string-to-bytes text in
    if 0 < bytes-len bs then
      if bytes-get bs 0 == 45 then
        (if natural || bytes-len bs <= 1 then None else case decimal-bytes bs 1 0 of
          Some magnitude -> if magnitude == 0 then Some "1" else if magnitude <= 4611686018427387904 then Some (cat ["-", nat-to-string (2 * magnitude - 1)]) else None
          None -> None)
      else case decimal-bytes bs 0 0 of
        Some value -> if value <= (if natural then 9223372036854775807 else 4611686018427387903) then Some (nat-to-string (2 * value + 1)) else None
        None -> None
    else None
  char-word :: String -> Option String
  char-word text = case string-utf8-first text of
    Some (c, n) -> if n == string-byte-length text then Some (nat-to-string (char-code c)) else None
    None -> None
  -- An immortal header word: rc 0, then kind at bit 35 and layout at bit 40.
  static-header :: Nat -> Nat -> Nat
  static-header kind layout = layout * 1099511627776 + kind * 34359738368
  struct-field :: String -> String -> Nat -> String
  struct-field shape storage index = cat ["getelementptr inbounds (", shape, ", ptr ", storage, ", i64 0, i32 ", nat-to-string index, ")"]
  -- A string literal is one shared read-only data-section object, as in
  -- seed/src/codegen.rs (Core::ConstString): the String constructor
  -- block { bytes } and the Bytes block { len; data } it wraps, each after
  -- an immortal header, then the data. The Bytes kind is
  -- KIND_BYTES_STATIC, so a write faults instead of touching constant data.
  -- The provider's String wrapper is inline (tag 0, its one field counted).
  string-literal :: Writer -> Span -> UType -> String -> (Writer, String)
  string-literal w sp ty text = case base ty of
    UCon name KType -> case (writer-program w).object of
      Some provider -> (case object-string-layout name provider of
        Some descriptor ->
          let (one, storage) = fresh-scoped w "text" in
          let size = nat-to-string (bytes-len (string-to-bytes text)) in
          let contents = if size == "0" then "[0 x i8] zeroinitializer" else cat ["[", size, " x i8] c\"", llvm-data-bytes text, "\""] in
          let shape = cat ["{ i64, ptr, i64, i64, ptr, [", size, " x i8] }"] in
          let declared = global one (cat [storage, " = private unnamed_addr constant ", shape, " { ",
            "i64 ", nat-to-string (static-header 1 descriptor), ", ptr ", struct-field shape storage 3,
            ", i64 ", nat-to-string (static-header 9 2), ", i64 ", size, ", ptr ", struct-field shape storage 5,
            ", ", contents, " }, align 8"]) in
          let (done, result) = fresh declared "%v" in
          (line done (cat ["  ", result, " = ptrtoint ptr ", struct-field shape storage 1, " to i64"]), result)
        None -> unsupported w sp "String literal has no checked defining wrapper layout")
      None -> unsupported w sp "String literal needs its checked library object layout"
    other -> unsupported w sp "String literal needs its checked library object layout"
  -- Intern the static UTF-8 name through the same process table as Data.Sym.
  symbol-literal :: Writer -> Span -> UType -> String -> (Writer, String)
  symbol-literal w sp ty text = if not (named ty "Sym") then unsupported w sp "symbol literal requires Sym" else
    let (named-word, storage) = fresh-scoped w "symbol" in
    let size = nat-to-string (bytes-len (string-to-bytes text)) in
    let declared = global named-word (cat [storage, " = private unnamed_addr constant [", size, " x i8] c\"", llvm-data-bytes text, "\"", ", align 1"]) in
    call declared "@cinch_sym_intern" [cat ["ptrtoint (ptr ", storage, " to i64)"], size]
  string-bytes :: Writer -> String -> (Writer, String)
  string-bytes w word = let (one, pointer) = fresh w "%ptr" in
    let (two, bytes) = fresh one "%v" in
    (line (line two (cat ["  ", pointer, " = inttoptr i64 ", word, " to ptr"])) (cat ["  ", bytes, " = load i64, ptr ", pointer]), bytes)
  string-pattern :: Writer -> Span -> UType -> String -> String -> String -> (Writer, List Local)
  string-pattern w sp ty value text failed = case string-literal w sp ty text of
    (literal, word) -> case string-bytes literal value of
      (one, actual) -> case string-bytes one word of
        (two, expected) -> case call two "@cinch_bytes_compare" [actual, expected] of
          (compared, order) -> case compare-word (count-op False ty word compared) "eq" order "0" of
            (ready, condition) -> (continue-if ready condition failed, [])
  head :: CoreTerm -> CoreTerm
  head term = case term of CApply sp ty f x -> head f; CApplyEff sp ty row f x -> head f; other -> term
  arguments :: CoreTerm -> List CoreTerm -> List CoreTerm
  arguments term more = case term of CApply sp ty f x -> arguments f (x : more); CApplyEff sp ty row f x -> arguments f (x : more); other -> more
  function-type :: RuntimeContext -> UType -> Bool
  function-type datas ty =
    let function = base ty in
    let erased-domain = erased-value-arrow function in
    case arrow-shape function of
      UFun domain result -> (erased-domain || word-type datas domain) && function-type datas result
      UFunEff domain row result -> (erased-domain || word-type datas domain) && function-type datas result
      UProofFun predicate row result -> kind-equal (type-kind predicate) KProp && valid-type predicate && function-type datas result
      UPi id name domain row result -> (erased-domain || word-type datas domain) && function-type datas result
      other -> word-type datas ty
  arity :: UType -> Nat
  arity ty = case arrow-shape ty of UFun domain result -> 1 + arity result; other -> 0
  -- Word-level workers share code by representation class. Concrete numeric
  -- semantics stay on checked Core; a TObj parameter is never assumed Int.
  scheme-supported :: RuntimeContext -> Scheme -> Bool
  scheme-supported context sc = function-type context (scheme-body sc)
  -- Generalized function values are instantiated at each checked local use,
  -- as in the Native frontend. Only values are copied: a strict computation
  -- must keep its original once-evaluated let and cannot enter this path.
  local-function-value :: CoreTerm -> Bool
  local-function-value value = case value of
    CRecursiveFunctions sp ty members (CLocal at member key name actuals) -> local-in-recursive-functions key members
    CLambda sp ty pattern body -> True
    CLocal sp ty id name actuals -> True
    CUse sp ty name role actuals -> True
    CQualifiedUse sp ty name role actuals evidence -> True
    CMethod sp ty name owner slot actuals evidence -> True
    other -> False

  -- A generalized strict value still has one binding. Build the same checked
  -- representation bundle as an explicit forall and project it at each use.
  -- Generalization retains each metavariable's fresh id, so opening it here
  -- cannot capture a rigid variable in an enclosing function.
  bundled-let :: Span -> Nat -> Scheme -> CoreTerm -> CoreTerm -> Option CoreTerm
  bundled-let sp id sc rhs body = case (scheme-params sc, scheme-requirements sc, core-effects rhs) of
    (first : rest, [], URow UEnd) -> let params = first : rest in
      if type-param-count params /= list-length params then None else
        let ty = scheme-body sc in let poly = UForall (quants-of params) ty in
        let actuals = map (\q -> let p = (q :: Quant) in UBound p.id p.name KType) params in
        let rigids = map (\q -> let p = (q :: Quant) in URigid p.id p.name 0 KType) params in
        let opened = map-term-types (substitute-bound (actual-pairs params rigids)) rhs in
        let bundle = CPolyIntro sp poly (quant-id-list params) opened in
        let projection = CPolyElim sp ty (CLocal sp poly id "#let-bundle" []) actuals in
        Some (CLet sp (core-type body) id "#let-bundle" (mono poly) bundle (specialize-local id sc projection body))
    other -> None

  -- | Region-polymorphic values keep one representation and are evaluated once.
  -- Runtime identities remain checked statically and never become payload words.
  erased-region-parameters :: List Quant -> Bool
  erased-region-parameters parameters = case parameters of
    [] -> True
    parameter : rest -> kind-equal (parameter.kind) KRegion && erased-region-parameters rest

  -- | Instantiating only region identities does not change a local value's representation.
  erased-region-arguments :: List UType -> Bool
  erased-region-arguments arguments = case arguments of
    [] -> True
    argument : rest -> kind-equal (type-kind argument) KRegion && erased-region-arguments rest

  -- | Recognize only the strict function aliases introduced while opening argument witness lets.
  -- Ordinary source aliases, evidence applications and dependent function types keep their existing lowering.
  scoped-partial-name :: CoreTerm -> Option String
  scoped-partial-name term = case term of
    CLet sp ty id name sc rhs body -> if name == "#argument-function" && list-length (scheme-params sc) == 0 then
      (case head rhs of
        CUse at function symbol role [] -> if role == "constructor" || not (ordinary-call-type function) then None else Some symbol
        other -> None)
      else None
    other -> None

  -- | Exclude dependent and erased arrows from the strict partial-call fusion.
  ordinary-call-type :: UType -> Bool
  ordinary-call-type ty = case base ty of
    UFun domain result -> ordinary-call-type result
    UFunEff domain row result -> ordinary-call-type result
    UPi id name domain row result -> False
    UProofFun predicate row result -> False
    UUsageArrow usage arrow -> False
    other -> True

  -- | Require one saturated use after argument lets, with no escaped or repeated function value.
  scoped-call-saturated :: Nat -> Nat -> CoreTerm -> Bool
  scoped-call-saturated id remaining term = case term of
    CLet sp ty key name sc rhs body -> not (term-uses id rhs) && key /= id && scoped-call-saturated id remaining body
    CRequire sp ty body -> scoped-call-saturated id remaining body
    CProved sp ty evidence body -> scoped-call-saturated id remaining body
    CRefine sp ty evidence body -> scoped-call-saturated id remaining body
    CRefineProof sp ty witness body -> not (term-uses id witness) && scoped-call-saturated id remaining body
    CDischarge sp ty evidence _ body -> scoped-call-saturated id remaining body
    CForget sp ty body -> scoped-call-saturated id remaining body
    CCast sp ty body -> scoped-call-saturated id remaining body
    other -> case head term of
      CLocal sp ty key name [] -> key == id && list-length (arguments term []) == remaining && not (scoped-argument-uses id (arguments term []))
      other -> False

  -- | Reject a function alias that is also passed as one of its own positional arguments.
  scoped-argument-uses :: Nat -> List CoreTerm -> Bool
  scoped-argument-uses id args = case args of [] -> False; first : rest -> term-uses id first || scoped-argument-uses id rest

  -- | Choose fresh runtime-local keys above every occurrence and binder in the rewritten subtree.
  scoped-next-local :: CoreTerm -> Nat
  scoped-next-local term =
    let here = case term of
          CLocal sp ty id name actuals -> id + 1
          CProofRef sp ty id name -> id + 1
          CLet sp ty id name sc rhs body -> id + 1
          CLambda sp ty pattern body -> scoped-pattern-next pattern
          CAlternative sp pattern body rest -> scoped-pattern-next pattern
          CRecursiveFunctions sp ty members body -> scoped-ids-next (recursive-function-ids members)
          CRecursiveValues sp ty region members body -> scoped-ids-next (recursive-function-ids members)
          other -> 0 in
    scoped-children-next (term-children term) here

  -- | Include unused lexical binders when reserving capture-safe local keys.
  scoped-pattern-next :: CorePattern -> Nat
  scoped-pattern-next pattern = case pattern of
    CPVar sp ty id name -> id + 1
    CPProof sp ty id name -> id + 1
    CPErasedValue sp ty id name -> id + 1
    CPAs sp ty id name inner -> let more = scoped-pattern-next inner in if id + 1 > more then id + 1 else more
    CPConstructor sp ty name actuals sc fields -> scoped-pattern-next fields
    CPTuple sp ty fields -> scoped-pattern-next fields
    CPField sp first rest -> let a = scoped-pattern-next first in let b = scoped-pattern-next rest in if a > b then a else b
    other -> 0

  -- | Include recursive-group identities even when their functions have no local occurrences.
  scoped-ids-next :: List Nat -> Nat
  scoped-ids-next ids = case ids of [] -> 0; id : rest -> let more = scoped-ids-next rest in if id + 1 > more then id + 1 else more

  -- | Fold child local-key bounds without confusing runtime keys with LLVM temporary numbering.
  scoped-children-next :: List CoreTerm -> Nat -> Nat
  scoped-children-next terms next = case terms of
    [] -> next
    first : rest -> let after = scoped-next-local first in scoped-children-next rest (if after > next then after else next)

  -- | Capture the proper partial call's positional computations strictly, once, in source order.
  -- The known unit is still unsaturated here, so delaying its closure allocation cannot run its body.
  scoped-prefix-values :: CoreTerm -> Nat -> (CoreTerm, List (Nat, CoreTerm), Nat)
  scoped-prefix-values term next = case term of
    CApply sp ty f x -> case scoped-prefix-values f next of
      (callee, saved, fresh) -> (CApply sp ty callee (CLocal sp (core-type x) fresh "#argument-prefix" []), saved <> [(fresh, x)], fresh + 1)
    CApplyEff sp ty row f x -> case scoped-prefix-values f next of
      (callee, saved, fresh) -> (CApplyEff sp ty row callee (CLocal sp (core-type x) fresh "#argument-prefix" []), saved <> [(fresh, x)], fresh + 1)
    other -> (term, [], next)

  -- | Retain strict captured computations before entering any of the final argument's witness scopes.
  scoped-prefix-lets :: Span -> List (Nat, CoreTerm) -> CoreTerm -> CoreTerm
  scoped-prefix-lets sp saved body = case saved of
    [] -> body
    (id, value) : rest -> CLet sp (core-type body) id "#argument-prefix" (mono (core-type value)) value (scoped-prefix-lets sp rest body)

  -- | Fuse one compiler-generated, single-use proper partial call while preserving evaluation order.
  -- Returned functions and overapplications are excluded by the checked source arity.
  fuse-scoped-arity :: Nat -> CoreTerm -> Option CoreTerm
  fuse-scoped-arity arity term = case term of
    CLet sp ty id name sc rhs body ->
      let supplied = list-length (arguments rhs []) in
      if supplied < arity && scoped-call-saturated id (arity - supplied) body then
        (case scoped-prefix-values rhs (scoped-next-local term) of
          (callee, saved, fresh) -> Some (scoped-prefix-lets sp saved (specialize-local id sc callee body)))
      else None
    other -> None

  -- | Elide a pure bare foreign function alias only for one complete checked positional call.
  -- Argument witness lets remain in place; partial, escaping, branching and shadowed uses keep their existing lowering.
  fuse-scoped-foreign-plan :: String -> ForeignPlan -> CoreTerm -> Option CoreTerm
  fuse-scoped-foreign-plan binding plan term = case term of
    CLet sp ty id name sc rhs body -> case rhs of
      CUse at function symbol role [] ->
        if name == "#argument-function" && role == "foreign" && symbol == binding
          && list-length (scheme-params sc) == 0 && list-length (scheme-requirements sc) == 0
          && ordinary-call-type function && scheme-equivalent sc (mono function)
          && scheme-equivalent sc (plan.scheme)
          && (case core-effects rhs of URow UEnd -> True; other -> False) then
          (let count = list-length (plan.parameters) in
           if count > 0 && scoped-call-saturated id count body then Some (specialize-local id sc rhs body) else None)
        else None
      other -> None
    other -> None

  -- | Obtain foreign authority from the checked binding index, never the alias's display spelling.
  fuse-scoped-foreign :: Writer -> CoreTerm -> Option CoreTerm
  fuse-scoped-foreign w term = case term of
    CLet sp ty id name sc (CUse at function symbol role []) body ->
      (case program-foreign-binding symbol (writer-program w) of
        Some plan -> fuse-scoped-foreign-plan symbol plan term
        None -> None)
    other -> None

  -- | Select a guarded static foreign alias or the existing proper source-call fusion.
  fuse-scoped-call :: List CoreDefinition -> Writer -> CoreTerm -> Option CoreTerm
  fuse-scoped-call definitions w term = case fuse-scoped-foreign w term of
    Some fused -> Some fused
    None -> fuse-scoped-source-call definitions w term

  -- | Consult actual source parameter counts and reject hidden dictionary captures before eliding a source closure.
  fuse-scoped-source-call :: List CoreDefinition -> Writer -> CoreTerm -> Option CoreTerm
  fuse-scoped-source-call definitions w term = case scoped-partial-name term of
    Some name -> case worker-definition name w of
      Some d -> case field-owner name ((writer-program w).instances) of
        Some owner -> None
        None -> if list-length (d.givens) == 0 && list-length (d.openings) == 0
          && list-length (definition-parameters d) == list-length (definition-all-parameters d) then
          fuse-scoped-arity (list-length (definition-parameters d)) term
          else None
      None -> None
    None -> None

  specialize-local :: Nat -> Scheme -> CoreTerm -> CoreTerm -> CoreTerm
  specialize-local id scheme value term = case term of
    CLocal sp ty key name actuals -> if id == key then map-term-types (substitute-bound (actual-pairs (scheme-params scheme) actuals)) value else term
    CApply sp ty f x -> CApply sp ty (specialize-local id scheme value f) (specialize-local id scheme value x)
    CApplyEff sp ty row f x -> CApplyEff sp ty row (specialize-local id scheme value f) (specialize-local id scheme value x)
    CErasedApply sp ty row f x -> CErasedApply sp ty row (specialize-local id scheme value f) (specialize-local id scheme value x)
    CDecision sp ty predicate condition -> CDecision sp ty predicate (specialize-local id scheme value condition)
    CScope sp ty region evidence callback -> CScope sp ty region evidence (specialize-local id scheme value callback)
    CMemoScope sp ty region body -> CMemoScope sp ty region (specialize-local id scheme value body)
    CSpawn sp ty token body -> CSpawn sp ty (specialize-local id scheme value token) (specialize-local id scheme value body)
    CJoin sp ty token body -> CJoin sp ty (specialize-local id scheme value token) (specialize-local id scheme value body)
    CWith sp ty given rhs body -> CWith sp ty given (specialize-local id scheme value rhs) (specialize-local id scheme value body)
    CHandler sp ty returned operations -> CHandler sp ty (specialize-local id scheme value returned) (specialize-local id scheme value operations)
    CHandle sp ty label residual body handled-by -> CHandle sp ty label residual (specialize-local id scheme value body) (specialize-local id scheme value handled-by)
    CHandlerOperation sp slot openings row closure rest -> CHandlerOperation sp slot openings row (specialize-local id scheme value closure) (specialize-local id scheme value rest)
    CLambda sp ty pattern body -> if pattern-binds id pattern then term else CLambda sp ty pattern (specialize-local id scheme value body)
    CLet sp ty key name sc rhs body -> CLet sp ty key name sc (specialize-local id scheme value rhs) (if id == key then body else specialize-local id scheme value body)
    CRecursiveFunctions sp ty members body -> if local-in-recursive-functions id members then term else
      CRecursiveFunctions sp ty (map-recursive-functions (specialize-local id scheme value) members) (specialize-local id scheme value body)
    CRecursiveValues sp ty region members body -> if local-in-recursive-functions id members then term else
      CRecursiveValues sp ty region (map-recursive-functions (specialize-local id scheme value) members) (specialize-local id scheme value body)
    CIf sp ty condition yes no -> CIf sp ty (specialize-local id scheme value condition) (specialize-local id scheme value yes) (specialize-local id scheme value no)
    CCase sp ty input alternatives -> CCase sp ty (specialize-local id scheme value input) (specialize-local id scheme value alternatives)
    CTuple sp ty fields -> CTuple sp ty (specialize-local id scheme value fields)
    CPolyIntro sp ty ids body -> CPolyIntro sp ty ids (specialize-local id scheme value body)
    CPolyElim sp ty input args -> CPolyElim sp ty (specialize-local id scheme value input) args
    CPrimitive sp ty name args -> CPrimitive sp ty name (specialize-local id scheme value args)
    CProved sp ty certificate body -> CProved sp ty certificate (specialize-local id scheme value body)
    CRefine sp ty certificate body -> CRefine sp ty certificate (specialize-local id scheme value body)
    CRefineProof sp ty witness body -> CRefineProof sp ty (specialize-local id scheme value witness) (specialize-local id scheme value body)
    CForget sp ty body -> CForget sp ty (specialize-local id scheme value body)
    CCast sp ty body -> CCast sp ty (specialize-local id scheme value body)
    CRequire sp ty body -> CRequire sp ty (specialize-local id scheme value body)
    CDischarge sp ty evidence _ body -> CDischarge sp ty evidence False (specialize-local id scheme value body)
    CGuard sp ty condition body -> CGuard sp ty (specialize-local id scheme value condition) (specialize-local id scheme value body)
    CArgument sp first rest -> CArgument sp (specialize-local id scheme value first) (specialize-local id scheme value rest)
    CAlternative sp pattern body rest -> CAlternative sp pattern (if pattern-binds id pattern then body else specialize-local id scheme value body) (specialize-local id scheme value rest)
    other -> term
  -- The checked effect declaration numbers operation slots from one.
  -- The handler stores its return closure in slot zero.
  handler-fields :: CoreTerm -> Nat -> Option CoreTerm
  handler-fields fields index = case fields of
    CHandlerEnd sp -> Some (CArgumentsEnd sp)
    CHandlerOperation sp slot openings row closure rest -> if slot /= index then None else
      (case handler-fields rest (index + 1) of Some more -> Some (CArgument sp closure more); None -> None)
    other -> None
  handler-operations :: UType -> List CoreEffect -> Option (List CoreOperation)
  handler-operations label effects = case effects of
    [] -> None
    declaration : rest -> case type-head label of
      UCon name kind ->
        if name == declaration.effect-name && kind-equal kind (declaration.effect-kind) then Some (declaration.effect-operations)
        else handler-operations label rest
      other -> None
  handler-operation-slot :: String -> List CoreOperation -> Option Nat
  handler-operation-slot name operations = case operations of
    [] -> None
    first : rest -> if name == first.operation-name then Some (first.operation-slot) else handler-operation-slot name rest
  handler-field :: Span -> UType -> CoreTerm -> Nat -> CoreTerm
  handler-field sp ty value slot =
    CPrimitive sp ty "#handler-field" (CArgument sp value (CArgument sp (CInt sp (UCon "I64" KType) (nat-to-string slot)) (CArgumentsEnd sp)))
  handler-largest :: Nat -> Nat -> Nat
  handler-largest first second = if first > second then first else second
  handler-pattern-id :: CorePattern -> Nat
  handler-pattern-id pattern = case pattern of
    CPVar sp ty id name -> id
    CPProof sp ty id name -> id
    CPErasedValue sp ty id name -> id
    CPAs sp ty id name nested -> handler-largest id (handler-pattern-id nested)
    CPConstructor sp ty name args scheme fields -> handler-pattern-id fields
    CPTuple sp ty fields -> handler-pattern-id fields
    CPField sp field rest -> handler-largest (handler-pattern-id field) (handler-pattern-id rest)
    other -> 0
  handler-term-id :: CoreTerm -> Nat
  handler-term-id term = let inside = handler-terms-id (term-children term) in case term of
    CLocal sp ty id name actuals -> id
    CLet sp ty id name scheme rhs body -> handler-largest id inside
    CLambda sp ty pattern body -> handler-largest (handler-pattern-id pattern) inside
    CAlternative sp pattern body rest -> handler-largest (handler-pattern-id pattern) inside
    other -> inside
  handler-terms-id :: List CoreTerm -> Nat
  handler-terms-id terms = case terms of
    [] -> 0
    first : rest -> handler-largest (handler-term-id first) (handler-terms-id rest)
  handler-local-id :: List Local -> Nat
  handler-local-id locals = case locals of
    [] -> 0
    (Local id ty value) : rest -> handler-largest id (handler-local-id rest)
    (Borrowed id ty value) : rest -> handler-largest id (handler-local-id rest)
    other : rest -> handler-local-id rest
  record HandlerLowering where
    label :: UType
    output :: UType
    row :: UType
    frame :: CoreTerm
    operations :: List CoreOperation
  -- Fresh synthetic bindings are above every local in the handled tree.
  -- The record is evaluated once, outside the extent it handles.
  lower-handler :: List CoreEffect -> List Local -> Span -> UType -> UType -> CoreTerm -> CoreTerm -> Result String CoreTerm
  lower-handler effects locals sp output label body handled-by = case (handler-parts (core-type handled-by), handler-operations label effects) of
    (Some (actual, input, result, row), Some operations) ->
      let id = 1 + handler-largest (handler-local-id locals) (handler-terms-id [body, handled-by]) in
      let frame = CLocal sp (core-type handled-by) id "#handler" [] in
      let prompt value cursor = Ok (CApply sp output (handler-field sp (UFunEff input row output) frame 0) value, cursor) in
      (case handler-cps (HandlerLowering label output row frame operations) sp body prompt (id + 1) of
        Ok (lowered, cursor) -> Ok (CLet sp output id "#handler" (mono (core-type handled-by)) handled-by lowered)
        Err message -> Err message)
    other -> Err "handle needs its checked effect declaration and clause record"
  handler-bind :: Span -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-bind sp value next cursor =
    let ty = core-type value in
    case next (CLocal sp ty cursor "#handled-value" []) (cursor + 1) of
      Ok (body, fresh) -> Ok (CLet sp (core-type body) cursor "#handled-value" (mono ty) value body, fresh)
      Err message -> Err message
  handler-arguments :: Span -> List CoreTerm -> CoreTerm
  handler-arguments sp values = case values of
    [] -> CArgumentsEnd sp
    first : rest -> CArgument sp first (handler-arguments sp rest)
  handler-values :: HandlerLowering -> Span -> List CoreTerm -> (List CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-values context sp values next cursor = case values of
    [] -> next [] cursor
    first : rest -> handler-cps context sp first (\value fresh -> handler-values context sp rest (\tail after -> next (value : tail) after) fresh) cursor
  handler-apply :: Span -> CoreTerm -> List CoreTerm -> Option CoreTerm
  handler-apply sp fun values = case values of
    [] -> Some fun
    first : rest -> case arrow-shape (core-type fun) of
      UFun input result -> handler-apply sp (CApply sp result fun first) rest
      UFunEff input row result -> handler-apply sp (CApplyEff sp result row fun first) rest
      UPi id name input row result -> handler-apply sp (CApplyEff sp result row fun first) rest
      other -> None
  handler-dispatch :: HandlerLowering -> Span -> UType -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-dispatch context sp response term next cursor = case (context, head term) of
    (HandlerLowering label output row frame operations, CUse at operation name role actuals) ->
      if role /= "operation" then Err "handled effect escaped its lexical operation call" else
      (case handler-operation-slot name operations of
        None -> Err "handled operation has no checked dispatch slot"
        Some slot -> handler-values context sp (arguments term []) (\values fresh ->
          let resumed = CLocal sp response fresh "#resume-argument" [] in
          case next resumed (fresh + 1) of
            Err message -> Err message
            Ok (body, after) ->
              let continuation = CLambda sp (UFun response output) (CPVar sp response fresh "#resume-argument") body in
              let clause = handler-field sp (handler-clause-type operation output row) frame slot in
              (case handler-apply sp clause (values <> [continuation]) of
                Some called -> Ok (called, after)
                None -> Err "handled operation arguments do not fit the checked clause")) cursor)
    other -> Err "handled effect needs a direct checked operation call"
  -- The continuation is ordinary Core and therefore uses the existing
  -- closure and reference-counting path. Only the operation clause can
  -- enter it, so aborting drops the captured continuation without running it.
  handler-cps :: HandlerLowering -> Span -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-cps context at term next cursor = case context of
    HandlerLowering label output row frame operations ->
      if not (handler-performs label (core-effects term)) then handler-bind at term next cursor else case term of
        CApplyEff sp ty performed f x -> if handler-performs label performed then handler-dispatch context sp ty term next cursor
          else handler-cps-apply context sp ty f x next cursor
        CApply sp ty f x -> handler-cps-apply context sp ty f x next cursor
        CLet sp ty id name sc rhs body -> if not (handler-performs label (core-effects rhs)) then
          (case handler-cps context sp body next cursor of
            Ok (lowered, fresh) -> Ok (CLet sp output id name sc rhs lowered, fresh)
            Err message -> Err message)
          else handler-cps context sp rhs (\value fresh -> case handler-cps context sp body next fresh of
            Ok (lowered, after) -> Ok (CLet sp output id name sc value lowered, after)
            Err message -> Err message) cursor
        CRecursiveFunctions sp ty members body -> case handler-cps context sp body next cursor of
          Ok (lowered, fresh) -> Ok (CRecursiveFunctions sp output members lowered, fresh)
          Err message -> Err message
        CIf sp ty condition yes no -> handler-cps context sp condition (\test fresh -> case handler-cps context sp yes next fresh of
          Err message -> Err message
          Ok (left, after) -> case handler-cps context sp no next after of
            Ok (right, done) -> Ok (CIf sp output test left right, done)
            Err message -> Err message) cursor
        CCase sp ty value alternatives -> handler-cps context sp value (\scrutinee fresh -> handler-cps-case context sp output scrutinee alternatives next fresh) cursor
        CWith sp ty given value body -> handler-cps context sp value (\word fresh -> case handler-cps context sp body next fresh of
          Ok (lowered, after) -> Ok (CWith sp output given word lowered, after)
          Err message -> Err message) cursor
        CTuple sp ty fields -> handler-cps-fields context sp fields (\values fresh -> handler-bind sp (CTuple sp ty values) next fresh) cursor
        CPolyIntro sp ty ids body -> Err "a polymorphic value inside a handled computation is not supported yet"
        CPolyElim sp ty value args -> Err "a polymorphic value inside a handled computation is not supported yet"
        CPrimitive sp ty operation fields -> if operation == "thunk-force" && (case fields of
          CArgument at thunk (CArgumentsEnd end) -> (case deferral-parts (core-type thunk) of Some (latent, result) -> handler-performs label latent; None -> True)
          other -> True) then Err "handled effect needs a direct checked operation call"
          else handler-cps-fields context sp fields (\values fresh -> handler-bind sp (CPrimitive sp ty operation values) next fresh) cursor
        CDecision sp ty predicate test -> handler-cps context sp test (\value fresh -> handler-bind sp (CDecision sp ty predicate value) next fresh) cursor
        CProved sp ty evidence body -> handler-cps context sp body (\value fresh -> next (CProved sp ty evidence value) fresh) cursor
        CRefine sp ty evidence body -> handler-cps context sp body (\value fresh -> next (CRefine sp ty evidence value) fresh) cursor
        CRefineProof sp ty evidence body -> handler-cps context sp body (\value fresh -> next (CRefineProof sp ty evidence value) fresh) cursor
        CForget sp ty body -> handler-cps context sp body (\value fresh -> next (CForget sp ty value) fresh) cursor
        CCast sp ty body -> handler-cps context sp body (\value fresh -> next (CCast sp ty value) fresh) cursor
        CRequire sp ty body -> handler-cps context sp body (\value fresh -> next (CRequire sp ty value) fresh) cursor
        CDischarge sp ty evidence _ body -> handler-cps context sp body (\value fresh -> next (CDischarge sp ty evidence False value) fresh) cursor
        other -> Err "handled operation occurs in a Core form without continuation lowering"
  handler-cps-apply :: HandlerLowering -> Span -> UType -> CoreTerm -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-cps-apply context sp ty fun arg next cursor =
    handler-cps context sp fun (\function fresh -> handler-cps context sp arg (\value after -> handler-bind sp (CApply sp ty function value) next after) fresh) cursor
  handler-cps-fields :: HandlerLowering -> Span -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-cps-fields context sp fields next cursor = case term-fields fields of
    Some values -> handler-values context sp values (\lowered fresh -> next (handler-arguments sp lowered) fresh) cursor
    None -> Err "handled computation has a malformed argument spine"
  handler-cps-case :: HandlerLowering -> Span -> UType -> CoreTerm -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-cps-case context sp output value alternatives next cursor = case alternatives of
    CAlternativesEnd at -> Ok (CCase sp output value alternatives, cursor)
    CAlternative at pattern body rest -> case handler-cps-case context sp output value rest next cursor of
      Err message -> Err message
      Ok (fallback, fresh) -> case handler-cps-row context output body fallback next fresh of
        Err message -> Err message
        Ok (success, after) -> let other = CAlternative at (CPWild at (core-type value)) fallback (CAlternativesEnd at) in
          Ok (CCase sp output value (CAlternative at pattern success other), after)
    other -> Err "handled computation has a malformed case alternative spine"
  handler-cps-row :: HandlerLowering -> UType -> CoreTerm -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-cps-row context output body fallback next cursor = case body of
    CGuard sp ty condition value -> handler-cps context sp condition (\test fresh -> case handler-cps-row context output value fallback next fresh of
      Err message -> Err message
      Ok (success, after) -> Ok (CIf sp output test success fallback, after)) cursor
    other -> handler-cps context (Span 0 0 1 1) body next cursor

  all-i64-llvms :: List String -> Bool
  all-i64-llvms llvms = case llvms of
    [] -> True
    ty : rest -> ty == "i64" && all-i64-llvms rest

  drop-typed-fields-rev :: List UType -> List String -> Writer -> Writer
  drop-typed-fields-rev tys vals w = case tys of
    [] -> w
    ty : ts -> case vals of val : vs -> count-op False ty val (drop-typed-fields-rev ts vs w); [] -> w

  frame-rhs-shape :: Writer -> CoreTerm -> Option (Writer, Nat, List CoreTerm)
  frame-rhs-shape w rhs = case rhs of
    CTuple tsp tty fields -> (case term-fields fields of
      Some actual ->
        let n = list-length actual in
        if n == 0 || n > 8 || not (field-words (w.context) actual) then None
        else if not (all-i64-llvms (value-llvms (w.context) (term-types actual))) then None
        else
          let (planned, desc) = request-layout tsp actual w in
          if description-escaped desc then None else Some (planned, desc, actual)
      None -> None)
    other -> case head rhs of
      CUse at cty name role actuals | (role == "constructor") ->
        let args = arguments rhs [] in
        let n = list-length args in
        if n == 0 || n > 8 then None
        else (case constructor name (writer-program w) of
          Some (owner, tag, c) | list-length (core-constructor-fields c) == n ->
            (case data-declaration owner (writer-program w) of
              Some d -> (case core-data-layout d of
                UniformData -> (case source-scheme-classes (w.context) (scheme-params (c.constructor-scheme)) actuals of
                  Some classes -> (case constructor-context d classes w of
                    Some ctx ->
                      if not (all-i64-llvms (value-llvms (w.context) (term-types args))) then None
                      else (case request-data at d classes w of
                        (planned, descriptors) ->
                          let desc = data-descriptor descriptors tag in
                          if description-escaped desc then None else Some (planned, desc, args))
                    None -> None)
                  None -> None)
                other -> None)
              None -> None)
          other -> None)
      other -> None

  -- | Idea 3: Stack-allocate (`RC_FRAME`) a non-escaping constructor/tuple `let`
  -- binding outside loops. Mode 1 (borrowed-only uses) emits zero-FFI inline
  -- reverse-order field release; mode 2 (single callee-consumed use) calls
  -- `@cinch_frame_release` on exit.
  try-frame-let :: List CoreDefinition -> List Local -> Writer -> Span -> Nat -> UType -> CoreTerm -> CoreTerm -> Option (Writer, String)
  try-frame-let definitions locals w sp id ty rhs body =
    if not ((writer-program w).reclaim) || in-loop-locals locals then None
    else case word-class (w.context) ty of
      Some 1 ->
        let info = writer-program w in
        let mode = frame-let-mode id body (program-borrow-modes info) (program-consumed-params info) False in
        if mode == 0 then None
        else (case frame-rhs-shape w rhs of
          None -> None
          Some (planned, desc, args) ->
            let n = list-length args in
            let field-tys = term-types args in
            case expressions definitions locals planned args of
              (ready, vals) ->
                let (w1, fslot) = fresh ready "%fslot" in
                let (w2, fptr) = fresh w1 "%fptr" in
                let (w3, fword) = fresh w2 "%fword" in
                let hdr-live = static-header 1 (description-field desc) + 17179869183 in
                let hdr-dead = static-header 1 (description-field desc) + 17179869182 in
                let arr-ty = cat ["[", nat-to-string (n + 1), " x i64]"] in
                let allocated = emit-lines w3 [
                  cat ["  ", fslot, " = alloca ", arr-ty, ", align 8"],
                  cat ["  store i64 ", nat-to-string hdr-live, ", ptr ", fslot, ", align 8"],
                  cat ["  ", fptr, " = getelementptr inbounds i64, ptr ", fslot, ", i64 1"]] in
                let filled = store-typed allocated fptr 0 (typed-words vals) in
                let boxed = line filled (cat ["  ", fword, " = ptrtoint ptr ", fptr, " to i64"]) in
                let binding = if mode == 1 then Borrowed id ty fword else Local id ty fword in
                case expression definitions (binding : locals) boxed body of
                  (done, result) ->
                    let released = (if mode == 1 then
                          let marked = line done (cat ["  store i64 ", nat-to-string hdr-dead, ", ptr ", fslot, ", align 8"]) in
                          drop-typed-fields-rev field-tys vals marked
                        else line done (cat ["  call void @cinch_frame_release(i64 ", fword, ")"])) in
                    Some (released, result))
      other -> None

  unwrap-let-var :: CoreTerm -> Option Nat
  unwrap-let-var term = case term of
    CLocal sp ty id name [] -> Some id
    CForget sp ty inner -> unwrap-let-var inner
    CCast sp ty inner -> unwrap-let-var inner
    other -> None

  -- Check if `needle` appears directly as `CLocal needle` in exactly one slot
  -- of `args`, and is NOT referenced anywhere in any other slot.
  single-direct-move-slot :: Nat -> List CoreTerm -> Nat -> Option Nat
  single-direct-move-slot needle args idx = case args of
    [] -> None
    a : rest -> case unwrap-let-var a of
      Some lid | lid == needle -> if terms-use-id needle rest then None else Some idx
      other -> if term-uses-id needle a then None else single-direct-move-slot needle rest (idx + 1)

  eval-args-moving :: List CoreDefinition -> List Local -> Writer -> Nat -> String -> Nat -> List CoreTerm -> (Writer, List String)
  eval-args-moving definitions locals w target-idx moved-word idx args = case args of
    [] -> (w, [])
    a : rest ->
      if idx == target-idx then
        (case eval-args-moving definitions locals w target-idx moved-word (idx + 1) rest of
          (done, more) -> (done, moved-word : more))
      else
        (case expression definitions locals w a of
          (ready, val) -> case eval-args-moving definitions locals ready target-idx moved-word (idx + 1) rest of
            (done, more) -> (done, val : more))

  try-move-into-alloc :: List CoreDefinition -> List Local -> Writer -> Nat -> UType -> String -> CoreTerm -> Option (Writer, String)
  try-move-into-alloc definitions locals w id ty value body =
    if not (value-llvm (w.context) ty == "i64") then None
    else case body of
      CTuple sp tty fields -> (case term-fields fields of
        Some actual ->
          if list-length actual > 16 || not (field-words (w.context) actual) then None
          else (case single-direct-move-slot id actual 0 of
            Some slot ->
              (case eval-args-moving definitions locals w slot value 0 actual of
                (evaluated, values) ->
                  let (planned, descriptor) = request-layout sp actual evaluated in
                  Some (allocate-typed planned descriptor (typed-values (value-llvms (planned.context) (term-types actual)) values)))
            None -> None)
        None -> None)
      other -> case head body of
        CUse at cty cname role actuals | (role == "constructor") ->
          let args = arguments body [] in
          (case single-direct-move-slot id args 0 of
            None -> None
            Some slot -> (case constructor cname (writer-program w) of
              Some (owner, tag, c) | list-length args == list-length (core-constructor-fields c) ->
                (case data-declaration owner (writer-program w) of
                  Some d -> (case core-data-layout d of
                    UniformData -> (case source-scheme-classes (w.context) (scheme-params (c.constructor-scheme)) actuals of
                      Some classes -> (case constructor-context d classes w of
                        Some ctx ->
                          if not (all-i64-llvms (value-llvms ctx (core-constructor-fields c))) then None
                          else (case request-data at d classes w of
                            (planned, descriptor) -> case eval-args-moving definitions locals planned slot value 0 args of
                              (ready, values) -> Some (allocate-typed ready (data-descriptor descriptor tag) (typed-values (value-llvms (ready.context) (term-types args)) values)))
                        None -> None)
                      None -> None)
                    other -> None)
                  None -> None)
              other -> None))
        other -> None

  simple-word-let :: List CoreDefinition -> Writer -> CoreTerm -> Option (Span, Nat, UType, CoreTerm, CoreTerm)
  simple-word-let definitions w term = case term of
    CLet sp ty id name sc rhs body ->
      (case fuse-scoped-call definitions w term of
        Some f -> None
        None ->
          let has-params = (case scheme-params sc of [] -> False; other -> True) in
          let no-reqs = (case scheme-requirements sc of [] -> True; other -> False) in
          if (has-params && local-function-value rhs && no-reqs) || deferred-let w id sc rhs body then None
          else if erased-region-parameters (scheme-params sc) && scheme-supported (w.context) sc && word-type (w.context) (scheme-body sc) then
            Some (sp, id, scheme-body sc, rhs, body)
          else None)
    other -> None

  -- | Idea 1: Evaluate `body` with owned binding `(id, ty, value)`, applying:
  --   1) Direct last-use return move (0 dup, 0 drop)
  --   2) Nested-let early drop / linear chain move (drop `id` immediately after
  --      `rhs2` when `id` is dead in `body2`)
  --   3) Owned `CCase` scrutinee transfer (0 dup, enables Perceus reset/reuse)
  --   4) Single-use direct move into a constructor or tuple field (0 dup, 0 drop)
  eval-let-body :: List CoreDefinition -> List Local -> Writer -> Nat -> UType -> String -> CoreTerm -> (Writer, String)
  eval-let-body definitions locals w id ty value body =
    if not (term-uses-id id body) then
      expression definitions locals (count-op False ty value w) body
    else case unwrap-let-var body of
      Some lid | lid == id -> (w, value)
      other -> case simple-word-let definitions w body of
        Some (sp2, id2, ty2, rhs2, body2) | id2 /= id && not (term-uses-id id body2) ->
          (case eval-let-body definitions locals w id ty value rhs2 of
            (ready, val2) -> eval-let-body definitions locals ready id2 ty2 val2 body2)
        other -> case body of
          CCase sp2 cty scrut alts | (case unwrap-let-var scrut of Some sid -> sid == id; None -> False) && not (term-uses-id id alts) ->
            case-value definitions locals w ty value alts
          other -> case try-move-into-alloc definitions locals w id ty value body of
            Some moved -> moved
            None -> case expression definitions ((Local id ty value) : locals) w body of
              (done, result) -> (count-op False ty value done, result)

  emit-let :: List CoreDefinition -> List Local -> Writer -> Span -> Nat -> UType -> CoreTerm -> CoreTerm -> (Writer, String)
  emit-let definitions locals w sp id ty rhs body =
    if not (term-uses-id id body) then
      (case expression definitions locals w rhs of
        (bound, value) -> expression definitions locals (count-op False ty value bound) body)
    else case try-frame-let definitions locals w sp id ty rhs body of
      Some framed -> framed
      None -> case expression definitions locals w rhs of
        (bound, value) -> eval-let-body definitions locals bound id ty value body

  stack-cell-local :: Nat -> List Local -> Option (UType, String)
  stack-cell-local id locals = case locals of
    [] -> None
    (StackCell key ty ptr-reg) : rest -> if id == key then Some (ty, ptr-reg) else stack-cell-local id rest
    other : rest -> stack-cell-local id rest

  expression :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> (Writer, String)
  expression definitions locals w term = case term of
    CInt sp ty text -> if number ty then decimal w ty text else if raw-integer ty then (w, text)
      else if wide-scalar ty then (w, wide-literal ty text)

      else (case core-float-literal-word ty text of
        Some bits -> (w, int-to-string bits)
        None -> unsupported w sp "integer carrier needs runtime lowering")
    CChar sp ty text -> if named ty "Char" then (case char-word text of Some word -> (w, word); None -> unsupported w sp "invalid typed character literal") else unsupported w sp "character literal has no checked Char carrier"
    CSymbol sp ty text -> symbol-literal w sp ty text
    CString sp ty text -> string-literal w sp ty text
    CUnit sp ty -> (w, "0")
    CLocal sp ty id name actuals -> if not (erased-region-arguments actuals) then unsupported w sp "local type arguments need representation specialization" else case deferred-constructor id locals of
      Some (ctor, actuals, args) -> direct-call definitions locals w sp ctor actuals args
      None -> case stack-cell-local id locals of
        Some (declared, ptr-reg) ->
          if value-llvm (w.context) declared == "ptr" then (w, ptr-reg)
          else let (next, word) = fresh w "%v" in (line next (cat ["  ", word, " = ptrtoint ptr ", ptr-reg, " to i64"]), word)
        None -> case knot-local id locals of
          Some (declared, slot) -> knot-read w declared slot
          None -> case local id locals of
            Some (declared, value) -> (count-op True declared value w, value)
            None -> unsupported w sp "runtime local is absent from its lexical scope"
    CUse sp ty name role actuals ->
      if role == "dictionary" then evidence-value definitions locals w (CEGiven sp ty name)
      else if role == "operation" then expression definitions locals w (operation-closure sp ty)
      else if named ty "Bool" && name == "True" then (w, "1")
      else if named ty "Bool" && name == "False" then (w, "0")
      else if role == "constructor" && name == "Refl" then (w, "0")
      else direct-call definitions locals w sp name actuals []
    CQualifiedUse sp ty name role actuals evidence -> case evidences definitions locals w evidence of
      (ready, values) -> call-name definitions locals ready sp name actuals values []
    CMethod sp ty name owner slot actuals evidence -> method-value definitions locals w sp ty name owner slot actuals evidence
    CScope sp ty region evidence callback -> scope-expression definitions locals w sp evidence callback
    CMemoScope sp ty region body -> memo-scope definitions locals (request-demand MemoWorker w) body
    CSpawn sp ty token body -> if task-result-abi w then (case expressions definitions locals w [token, body] of (ready, [scope, closure]) -> call ready "@cinch_task_spawn" [scope, closure]; other -> unsupported w sp "malformed task spawn") else unsupported w sp "tasks require the canonical checked Result error/success ABI"
    CJoin sp ty token body -> if task-result-abi w then join-expression definitions locals w sp ty token body else unsupported w sp "tasks require the canonical checked Result error/success ABI"
    CWith sp ty given value body -> case expression definitions locals w value of
      (ready, word) -> case expression definitions ((GivenLocal (given.symbol) (given.ty) word) : locals) ready body of
        (done, result) -> (count-op False (given.ty) word done, result)
    CHandler sp ty returned operations -> case handler-fields operations 1 of
      Some fields -> tuple definitions locals w sp (CArgument sp returned fields)
      None -> unsupported w sp "handler fields need their checked declaration order and runtime representations"
    CHandle sp ty label residual body handled-by -> case lower-handler ((writer-program w).effects) locals sp ty label body handled-by of
      Ok lowered -> expression definitions locals w lowered
      Err message -> unsupported w sp message
    CApplyEff sp ty row f x -> application definitions locals w sp term f x
    CApply sp ty f x -> application definitions locals w sp term f x
    CLambda sp ty pattern body -> lambda definitions locals w sp pattern body
    CRecursiveFunctions sp ty members body -> recursive-expression definitions locals w sp members body
    CRecursiveValues sp ty region members body -> knot-expression definitions locals w sp region members body
    CLet sp ty id name sc rhs body -> case fuse-scoped-call definitions w term of
      Some fused -> expression definitions locals w fused
      None -> if (case scheme-params sc of [] -> False; other -> True) && local-function-value rhs && (case scheme-requirements sc of [] -> True; other -> False) then
        expression definitions locals w (specialize-local id sc rhs body)
        else if deferred-let w id sc rhs body then (case deferred-value (writer-program w) rhs of
          Some (ctor, actuals, args) -> expression definitions ((DeferredConstructor id (scheme-body sc) ctor actuals args) : locals) w body
          None -> unsupported w sp "deferred constructor let failed its checked representation")
        else if erased-region-parameters (scheme-params sc) && scheme-supported (w.context) sc && word-type (w.context) (scheme-body sc) then
          emit-let definitions locals w sp id (scheme-body sc) rhs body
        else (case bundled-let sp id sc rhs body of
          Some bundled -> expression definitions locals w bundled
          None -> unsupported w sp "polymorphic or aggregate let needs runtime lowering")
    CIf sp ty test yes no -> branch definitions locals w sp test yes no
    CTuple sp ty fields -> tuple definitions locals w sp fields
    CPolyIntro sp ty ids body -> poly-bundle definitions locals w sp ty ids body
    CPolyElim sp ty value args -> poly-project definitions locals w sp ty value args
    CCase sp ty value alternatives -> case fold-known-case definitions locals w value alternatives of
      Some folded -> folded
      None -> case fuse-array-case definitions locals w sp value alternatives of
        Some fused -> fused
        None -> case borrowed-local-word locals value of
          Some word -> case-value-mode definitions locals w (core-type value) word False alternatives
          None -> case expression definitions locals w value of
            (ready, word) -> case-value definitions locals ready (core-type value) word alternatives
    CPrimitive sp ty op args -> primitive definitions locals w sp ty op args
    CProved sp ty evidence body -> expression definitions locals w body
    CRefine sp ty evidence body -> expression definitions locals w body
    CRefineProof sp ty witness body -> expression definitions locals w body
    CForget sp ty body -> expression definitions locals w body
    CCast sp ty body -> expression definitions locals w body
    CRequire sp ty body -> expression definitions locals w body
    CDischarge sp ty evidence _ body -> expression definitions locals w body
    CDecision sp ty predicate condition -> if decision-word-type ty then decision-expression definitions locals w sp condition else unsupported w sp "decision has no checked kernel result type"
    CErasedApply sp ty row f witness -> case f of
      CUse at function name role actuals ->
        if role == "constructor" && decision-word-type ty && (name == "b.Yes" || name == "b.No") then
          decision-constructor sp (name == "b.Yes") w
        else erased-constructor-or-function definitions locals w sp f
      other -> erased-constructor-or-function definitions locals w sp f
    other -> unsupported w (Span 0 0 1 1) "Core form needs typed runtime lowering"
  -- Handled direct calls have already been rewritten by handler-cps.
  -- Constructing an operation value is pure. Applying its final argument
  -- outside that lexical dispatch takes the language's unhandled fault.
  operation-closure :: Span -> UType -> CoreTerm
  operation-closure sp ty = case arrow-shape ty of
    UFun domain result -> operation-lambda sp ty domain result
    UFunEff domain row result -> operation-lambda sp ty domain result
    UPi id name domain row result -> operation-lambda sp ty domain result
    UProofFun predicate row result -> CLambda sp ty (CPProof sp predicate 0 "#operation-proof") (operation-closure sp result)
    other -> CPrimitive sp ty "#unhandled-operation" (CArgumentsEnd sp)
  operation-lambda :: Span -> UType -> UType -> UType -> CoreTerm
  operation-lambda sp ty domain result = CLambda sp ty
    (if erased-value-arrow ty then CPErasedValue sp domain 0 "#operation-argument" else CPWild sp domain)
    (operation-closure sp result)

  application :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> CoreTerm -> CoreTerm -> (Writer, String)
  application definitions locals w sp term f x = case head term of
      CUse at function name role actuals -> if role == "operation" then
        (case expression definitions locals w f of (ready, closure-word) -> apply-terms definitions locals ready closure-word [x])
        else direct-call definitions locals w sp name actuals (arguments term [])
      -- Checked evidence is a prefix of the same known call, not an unknown
      -- closure application. Keep the complete argument spine for saturation.
      CQualifiedUse at function name role actuals evidence -> case evidences definitions locals w evidence of
        (ready, values) -> call-name definitions locals ready sp name actuals values (arguments term [])
      CMethod at function name owner slot actuals evidence ->
        (case static-instance-method w name owner slot actuals evidence of
          Some (codes, own-codes, d) -> function-call definitions locals (note-version owner slot own-codes w) sp d [] codes [] (arguments term [])
          None -> case evidence of
            [CEInstance location receiver factory [] (CEArgumentsEnd end)] ->
              (case closed-method-unit w name owner slot actuals factory of
                Some unit -> if list-length (arguments term []) == list-length (unit.params) then
                  (let noted = note-version owner slot [] w in
                   case inline-total definitions locals noted (imported-native-body (unit.symbol) (writer-program w)) unit (mono function) [] (arguments term []) of
                     Some lowered -> lowered
                     None -> external-call-unit definitions locals noted sp unit (mono function) [] (arguments term []))
                  else indirect-spine definitions locals w sp (head term) (arguments term []) (core-type term)
                None -> indirect-spine definitions locals w sp (head term) (arguments term []) (core-type term))
            other -> indirect-spine definitions locals w sp (head term) (arguments term []) (core-type term))
      other -> (case erased-constructor-call term [] of
        Some (name, actuals, args) -> direct-call definitions locals w sp name actuals args
        None -> indirect-spine definitions locals w sp (head term) (arguments term []) (core-type term))
  -- A checked proposition argument occupies no runtime field. Continue
  -- gathering positional values through proof applications of constructors.
  erased-constructor-call :: CoreTerm -> List CoreTerm -> Option (String, List UType, List CoreTerm)
  erased-constructor-call term args = case term of
    CUse sp ty name role actuals -> if role == "constructor" then Some (name, actuals, args) else None
    CApply sp ty f x -> erased-constructor-call f (x : args)
    CApplyEff sp ty row f x -> erased-constructor-call f (x : args)
    CErasedApply sp ty row f witness -> erased-constructor-call f args
    other -> None
  erased-constructor-or-function :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> (Writer, String)
  erased-constructor-or-function definitions locals w sp function = case erased-constructor-call function [] of
    Some (name, actuals, args) -> direct-call definitions locals w sp name actuals args
    None -> erased-application definitions locals w function
  indirect-application :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> CoreTerm -> (Writer, String)
  indirect-application definitions locals w f x = if wide-type (w.context) (core-type x) || wide-type (w.context) (final-result (core-type f)) then unsupported w (Span 0 0 1 1) wide-refusal else
    case expression definitions locals w f of
    (callee, function) -> apply-terms-class definitions locals callee function [x] 0
  indirect-spine :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> List CoreTerm -> UType -> (Writer, String)
  indirect-spine definitions locals w sp callee-term args result-ty =
    if wide-type (w.context) result-ty then unsupported w sp wide-refusal else
    let ret-class = (case word-class (w.context) result-ty of Some c -> c; None -> 0) in
    case expression definitions locals w callee-term of
      (callee, function) -> apply-terms-class definitions locals callee function args ret-class
  closed-method-unit :: Writer -> String -> String -> Nat -> List UType -> String -> Option RuntimeUnit
  closed-method-unit w name owner slot actuals factory = case ((writer-program w).object, find-class owner ((writer-program w).classes), instance-binding factory (writer-program w)) of
    (Some provider, Some description, Some binding) -> if not (method-reference name owner slot (writer-program w)) then None else
      (case (scheme-params (checked-scheme binding), scheme-requirements (checked-scheme binding), class-owner (scheme-body (checked-scheme binding)), method-at slot (description.methods)) of
        ([], [], Some actual-owner, Some member) -> if owner /= actual-owner then None else
          (case method-own-classes w member actuals of
            Some [] -> object-closed-method-unit owner factory slot provider
            other -> None)
        other -> None)
    other -> None
  task-result-abi :: Writer -> Bool
  task-result-abi w = case data-declaration (global-data-core-result) (writer-program w) of
    Some d -> (case (core-data-params d, core-data-constructors d) of
      ([error, value], [first, second]) -> first.constructor-name == global-data-core-err && second.constructor-name == global-data-core-ok
        && (case (core-constructor-fields first, core-constructor-fields second) of
          ([UBound left name KType], [UBound right other KType]) -> left == error.id && right == value.id
          other -> False)
      other -> False)
    None -> False
  scope-expression :: List CoreDefinition -> List Local -> Writer -> Span -> CoreEvidence -> CoreTerm -> (Writer, String)
  scope-expression definitions locals w sp evidence callback = case evidences definitions locals w [evidence] of
    (supplied, [capability]) -> (case expression definitions locals supplied callback of
      (ready, closure) -> case call ready "@cinch_scope_open" [] of
        (opened, scope) -> case apply-one opened closure scope of
          (called, result) -> case call called "@cinch_scope_close" [scope] of
            (closed, ignored) -> (count-op False (evidence-type evidence) capability closed, result))
    other -> unsupported w sp "scope requires one checked Io capability"
  task-stack-array :: Writer -> List String -> (Writer, String, String)
  task-stack-array w values = let (one, pointer) = fresh w "%ptr" in
    let (two, word) = fresh one "%v" in
    let allocated = line two (cat ["  ", pointer, " = alloca i64, i64 ", nat-to-string (list-length values)]) in
    let filled = store-fields allocated pointer 0 values in
    (line filled (cat ["  ", word, " = ptrtoint ptr ", pointer, " to i64"]), pointer, word)
  task-zero-words :: Nat -> List String
  task-zero-words count = if count == 0 then [] else "0" : (task-zero-words (count - 1))
  task-load-words :: Writer -> String -> Nat -> Nat -> (Writer, List String)
  task-load-words w pointer index count = if count == 0 then (w, []) else case load-word w pointer (nat-to-string index) of
    (loaded, value) -> case task-load-words loaded pointer (index + 1) (count - 1) of (done, rest) -> (done, value : rest)
  task-result-types :: UType -> Option (UType, UType)
  task-result-types ty = case ty of UApp (UApp (UCon name kind) error) value -> if name == global-data-core-result then Some (error, value) else None; other -> None
  task-tuple-types :: UType -> Option (List UType)
  task-tuple-types ty = case ty of UTuple fields -> task-tuple-fields fields; other -> None
  task-tuple-fields :: UType -> Option (List UType)
  task-tuple-fields fields = case fields of UEnd -> Some []; UArg ty more -> (case task-tuple-fields more of Some rest -> Some (ty : rest); None -> None); other -> None
  task-join-success :: Writer -> Span -> UType -> List String -> (Writer, String)
  task-join-success w sp ty values = case task-result-types ty of
    Some (error, payload) -> (case (task-tuple-types payload, data-declaration (global-data-core-result) (writer-program w)) of
      (Some types, Some d) -> (case class-vector (w.context) types of
        Some classes -> (case request-tuple-shape sp classes w of
          (planned, descriptor) -> case allocate planned descriptor values of
            (made, tuple) -> case scheme-classes (made.context) (core-data-params d) [error, payload] of
              Some result-classes -> (case request-data sp d result-classes made of (ready, base-id) -> allocate ready (data-descriptor base-id 1) [tuple])
              None -> unsupported made sp "joined Result needs checked runtime representations")
        None -> unsupported w sp "joined tuple needs checked runtime representations")
      other -> unsupported w sp "joined task result must use its checked tuple and Result declarations")
    None -> unsupported w sp "join has no checked Result carrier"
  join-expression :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> CoreTerm -> (Writer, String)
  join-expression definitions locals w sp ty token handles = case term-fields handles of
    None -> unsupported w sp "malformed join handle spine"
    Some terms -> if list-length terms == 0 then unsupported w sp "join needs at least one handle" else
      (case expression definitions locals w token of
        (scoped, scope) -> case expressions definitions locals scoped terms of
          (evaluated, values) -> case task-stack-array evaluated values of
            (array, input-pointer, input-word) -> case task-stack-array array (task-zero-words (list-length values)) of
              (output, output-pointer, output-word) -> case call output "@cinch_task_join_all_or_cancel" [scope, input-word, nat-to-string (list-length values), output-word] of
                (joined, status) -> if list-length values == 1 then load-word joined output-pointer "0" else task-join-branches joined sp ty output-pointer status (list-length values))
  task-join-branches :: Writer -> Span -> UType -> String -> String -> Nat -> (Writer, String)
  task-join-branches w sp ty output status count =
    let (one, failed) = fresh w "%v" in let (two, slot) = fresh one "%ptr" in
    let (three, failure) = fresh two "taskfail" in let (four, success) = fresh three "taskok" in let (five, end) = fresh four "taskdone" in
    let split = line (line (line five (cat ["  ", slot, " = alloca i64"])) (cat ["  ", failed, " = icmp slt i64 ", status, ", 0"])) (cat ["  br i1 ", failed, ", label %", failure, ", label %", success]) in
    case load-word (line split (cat [failure, ":"])) output "0" of
      (bad, error) -> let next = line (line (line bad (cat ["  store i64 ", error, ", ptr ", slot])) (cat ["  br label %", end])) (cat [success, ":"]) in
        case task-load-words next output 0 count of
          (loaded, values) -> case task-join-success loaded sp ty values of
            (good, result) -> let merged = line (line (line good (cat ["  store i64 ", result, ", ptr ", slot])) (cat ["  br label %", end])) (cat [end, ":"]) in
              case fresh merged "%v" of (done, word) -> (line done (cat ["  ", word, " = load i64, ptr ", slot]), word)
  expressions :: List CoreDefinition -> List Local -> Writer -> List CoreTerm -> (Writer, List String)
  expressions definitions locals w terms = case terms of
    [] -> (w, [])
    term : rest -> case expression definitions locals w term of
      (first, value) -> case expressions definitions locals first rest of (done, values) -> (done, value : values)
  -- A closure's description covers every parameter word; its saved
  -- fields follow the three raw prefix words (code, arity, filled count).
  closure-word-classes :: List Nat -> Nat -> List Nat
  closure-word-classes params ret-class =
    word-codes params <> (if val-code-needs-sret-apply ret-class then [0] else [])
  request-shape-for :: Span -> List Nat -> Nat -> Writer -> (Writer, Nat)
  request-shape-for sp classes ret-class w =
    let wclasses = closure-word-classes classes ret-class in
    let has-val = val-code classes || val-code-needs-sret-apply ret-class in
    if wide-code classes then (refuse w sp wide-refusal, 0)
    else if not has-val && list-length wclasses > 13 then (refuse w sp "closure shape needs an extended runtime descriptor", 0)
    else (w, shape-description 2 0 wclasses)
  request-shape :: Span -> List Nat -> Writer -> (Writer, Nat)
  request-shape sp classes w = request-shape-for sp classes 0 w
  closure-with :: Span -> String -> List Nat -> Nat -> List UType -> List String -> Writer -> (Writer, String)
  closure-with sp name classes ret-class saved-tys values w = case values of
    [] -> case static-closure-with sp name classes ret-class w of
      (planned, payload) -> let (done, word) = fresh planned "%v" in
        (line done (cat ["  ", word, " = ptrtoint ptr ", payload, " to i64"]), word)
    other -> case request-shape-for sp classes ret-class (request-demand (StubDemand name classes ret-class) w) of
      (planned, descriptor) ->
        let arity-words = list-length (closure-word-classes classes ret-class) in
        let saved-words = payload-words (planned.context) saved-tys in
        let (one, pointer) = fresh planned "%ptr" in
        let allocated = shaped-allocation one pointer (nat-to-string (8 * (3 + saved-words))) 2 descriptor in
        let prefix = [cat ["ptrtoint (ptr ", symbol (cat [name, ".app"]), " to i64)"], nat-to-string arity-words, nat-to-string saved-words] in
        let filled = store-typed-slots (store-fields allocated pointer 0 prefix) pointer 3 saved-tys values in
        let (done, word) = fresh filled "%v" in
        (line done (cat ["  ", word, " = ptrtoint ptr ", pointer, " to i64"]), word)
  closure :: Span -> String -> List Nat -> List String -> Writer -> (Writer, String)
  closure sp name classes values w = closure-with sp name classes 0 (map (\_ -> UCon "Unit" KType) values) values w
  -- A closure that saves nothing is one immortal data-section block
  -- { app; arity; 0 } (seed/src/codegen.rs, clo_def). The result is the
  -- constant payload address.
  static-closure-with :: Span -> String -> List Nat -> Nat -> Writer -> (Writer, String)
  static-closure-with sp name classes ret-class w = case request-shape-for sp classes ret-class (request-demand (StubDemand name classes ret-class) w) of
    (planned, descriptor) ->
      let arity-words = list-length (closure-word-classes classes ret-class) in
      let (declared, storage) = fresh-scoped planned "closure" in
      let skip = static-prefix-words descriptor in
      let block = cat ["[", nat-to-string (4 + skip), " x i64]"] in
      let stored = static-block declared storage descriptor 2 [StaticAddress (symbol (cat [name, ".app"])), StaticBits arity-words, StaticBits 0] in
      (stored, cat ["getelementptr inbounds (", block, ", ptr ", storage, ", i64 0, i64 ", nat-to-string (1 + skip), ")"])
  static-closure :: Span -> String -> List Nat -> Writer -> (Writer, String)
  static-closure sp name classes w = static-closure-with sp name classes 0 w
  apply-one :: Writer -> String -> String -> (Writer, String)
  apply-one w function value =
    let (one, argv) = fresh w "%ptr" in
    let (two, result) = fresh one "%v" in
    let stored = line (line two (cat ["  ", argv, " = alloca i64"])) (cat ["  store i64 ", value, ", ptr ", argv]) in
    (line stored (cat ["  ", result, " = call i64 @__apply(i64 ", function, ", i64 1, ptr ", argv, ")"]), result)
  -- A proof lambda is a delayed zero-argument closure. Its body starts only
  -- at the checked erased application, never when the closure is created.
  erased-application :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> (Writer, String)
  erased-application definitions locals w f = case expression definitions locals w f of
    (callee, function) -> let (one, argv) = fresh callee "%ptr" in
      let (two, result) = fresh one "%v" in
      (line (line two (cat ["  ", argv, " = alloca i64"])) (cat ["  ", result, " = call i64 @__apply(i64 ", function, ", i64 0, ptr ", argv, ")"]), result)
  any-wide-term :: RuntimeContext -> List CoreTerm -> Bool
  any-wide-term context terms = case terms of
    [] -> False
    first : rest -> wide-type context (core-type first) || any-wide-term context rest
  any-val-term :: RuntimeContext -> List CoreTerm -> Bool
  any-val-term context terms = case terms of
    [] -> False
    first : rest -> is-value-type context (core-type first) || any-val-term context rest
  peel-arrows :: Nat -> UType -> UType
  peel-arrows n ty = if n == 0 then ty else case arrow-shape (base ty) of
    UFun domain result -> peel-arrows (n - 1) result
    UFunEff domain row result -> peel-arrows (n - 1) result
    UPi id name domain row result -> peel-arrows (n - 1) result
    UProofFun predicate row result -> peel-arrows n result
    other -> ty
  apply-terms-class :: List CoreDefinition -> List Local -> Writer -> String -> List CoreTerm -> Nat -> (Writer, String)
  apply-terms-class definitions locals w function terms ret-class = case terms of
    [] -> (w, function)
    other ->
      if any-wide-term (w.context) terms then unsupported w (Span 0 0 1 1) wide-refusal
      else if not (any-val-term (w.context) terms) && not (val-code-needs-sret-apply ret-class) then
        apply-terms definitions locals w function terms
      else
        case expressions definitions locals w terms of
          (evaluated, values) ->
            let arg-tys = term-types terms in
            let arg-words = payload-words (evaluated.context) arg-tys in
            let needs-sret = val-code-needs-sret-apply ret-class in
            let total-words = arg-words + (if needs-sret then 1 else 0) in
            let (w1, argv) = fresh evaluated "%argv" in
            let w2 = line w1 (cat ["  ", argv, " = alloca [", nat-to-string total-words, " x i64], align 8"]) in
            let w3 = store-typed-slots w2 argv 0 arg-tys values in
            if needs-sret then
              let sz = val-class-size ret-class in
              let al = val-class-align ret-class in
              let (w4, retbuf) = fresh w3 "%retbuf" in
              let (w5, outw) = fresh w4 "%outw" in
              let (w6, outslot) = fresh w5 "%ptr" in
              let (w7, ignored) = fresh w6 "%v" in
              let packed = emit-lines w7 [
                cat ["  ", retbuf, " = alloca [", nat-to-string sz, " x i8], align ", nat-to-string al],
                cat ["  ", outw, " = ptrtoint ptr ", retbuf, " to i64"],
                cat ["  ", outslot, " = getelementptr i64, ptr ", argv, ", i64 ", nat-to-string arg-words],
                cat ["  store i64 ", outw, ", ptr ", outslot],
                cat ["  ", ignored, " = call i64 @__apply(i64 ", function, ", i64 ", nat-to-string total-words, ", ptr ", argv, ")"]] in
              if sz > 16 || al > 16 then (packed, retbuf)
              else
                let (w8, pair) = fresh packed "%v" in
                (line w8 (cat ["  ", pair, " = load { i64, i64 }, ptr ", retbuf, ", align 8"]), pair)
            else
              let (w4, result) = fresh w3 "%v" in
              (line w4 (cat ["  ", result, " = call i64 @__apply(i64 ", function, ", i64 ", nat-to-string total-words, ", ptr ", argv, ")"]), result)
  apply-terms :: List CoreDefinition -> List Local -> Writer -> String -> List CoreTerm -> (Writer, String)
  apply-terms definitions locals w function terms = case terms of
    [] -> (w, function)
    first : rest -> if wide-type (w.context) (core-type first) then unsupported w (Span 0 0 1 1) wide-refusal else
      case expression definitions locals w first of
      (ready, value) -> case apply-one ready function value of
        (applied, result) -> apply-terms definitions locals applied result rest
  take-terms :: Nat -> List CoreTerm -> List CoreTerm
  take-terms count terms = if count == 0 then [] else case terms of [] -> []; first : rest -> first : (take-terms (count - 1) rest)
  drop-terms :: Nat -> List CoreTerm -> List CoreTerm
  drop-terms count terms = if count == 0 then terms else case terms of [] -> []; first : rest -> drop-terms (count - 1) rest
  definition-parameters :: CoreDefinition -> List CorePattern
  definition-parameters d = runtime-prefix (definition-all-parameters d)
  definition-all-parameters :: CoreDefinition -> List CorePattern
  definition-all-parameters d = case d.clauses of [] -> []; (CoreClause sp parameters body) : rest -> parameters
  runtime-prefix :: List CorePattern -> List CorePattern
  runtime-prefix parameters = case parameters of
    [] -> []
    first : rest -> if erased-pattern first then [] else first : (runtime-prefix rest)
  runtime-parameters :: List CorePattern -> List CorePattern
  runtime-parameters parameters = case parameters of
    [] -> []
    first : rest -> if erased-pattern first then runtime-parameters rest else first : (runtime-parameters rest)
  -- An erased application advances one stage with zero runtime words.
  -- Preserve all equations until the last stage, so later computational
  -- patterns still dispatch together.
  proof-stage-arities :: List CorePattern -> Nat -> List Nat
  proof-stage-arities parameters count = case parameters of
    [] -> [count]
    first : rest -> if erased-pattern first then count : (proof-stage-arities rest count) else proof-stage-arities rest (count + 1)
  proof-stage-name :: String -> Nat -> String
  proof-stage-name name rung = if rung == 0 then name else cat [name, ".$proof.", nat-to-string rung]
  take-types :: Nat -> List UType -> List UType
  take-types count types = if count == 0 then [] else case types of
    [] -> []
    first : rest -> first : (take-types (count - 1) rest)
  pattern-types :: List CorePattern -> List UType
  pattern-types patterns = case patterns of [] -> []; first : rest -> (pattern-type first) : (pattern-types rest)
  definition-context :: CoreDefinition -> List Nat -> Writer -> Option RuntimeContext
  definition-context d classes w = case class-bindings (scheme-params (d.scheme)) classes of
    None -> None
    Some bounds -> case definition-rigids d bounds of
      None -> None
      Some rigids -> Some (RuntimeContext (writer-program w) bounds rigids empty-queue NoInline)
  constructor-context :: CoreData -> List Nat -> Writer -> Option RuntimeContext
  constructor-context d classes w = case class-bindings (core-data-params d) classes of
    None -> None
    Some bounds -> Some (RuntimeContext (writer-program w) bounds [] empty-queue NoInline)
  constructor-scheme-context :: CoreConstructor -> List Nat -> Writer -> Option RuntimeContext
  constructor-scheme-context c classes w = case class-bindings (scheme-params (c.constructor-scheme)) classes of
    None -> None
    Some bounds -> Some (RuntimeContext (writer-program w) bounds [] empty-queue NoInline)
  constructor-call-context :: CoreData -> CoreConstructor -> List Nat -> Writer -> Option RuntimeContext
  constructor-call-context d c classes w = if regular-constructor d c then constructor-context d classes w else constructor-scheme-context c classes w
  -- Array workers specialize on checked element classes; packed constructors
  -- carry their fixed format in their canonical operation identity.
  array-binder-field :: CoreData -> UType -> Bool
  array-binder-field d field = case (core-data-params d, field) of
    ([parameter], UBound id name KType) -> parameter.id == id && kind-equal (parameter.kind) KType
    other -> False
  array-list-abi :: Writer -> Bool
  array-list-abi w = case (data-declaration (global-data-core-list) (writer-program w), constructor (global-data-core-nil) (writer-program w), constructor (global-data-core-cons) (writer-program w)) of
    (Some d, Some (nil-owner, 0, nil-constructor), Some (cons-owner, 1, cons-constructor)) ->
      nil-owner == core-data-name d && cons-owner == nil-owner && list-length (core-data-constructors d) == 2 && list-length (core-constructor-fields nil-constructor) == 0 &&
      (case core-constructor-fields cons-constructor of
        [element, UApp (UCon owner (KFun KType KType)) tail] -> owner == nil-owner && array-binder-field d element && array-binder-field d tail
        other -> False)
    other -> False
  array-head-class :: List Nat -> Nat
  array-head-class classes = case classes of first : rest -> first; [] -> 0
  array-argument-classes :: Nat -> List Nat -> List Nat
  array-argument-classes operation classes = let element = array-head-class classes in
    if operation == 0 then [1] else if operation == 1 then [2, element]
    else if operation == 3 || operation == 16 then [1, 2]
    else if operation == 4 then [1, 2, element]
    else if operation == 5 then [1, 2, 2]
    else if operation == 6 || operation == 7 || operation == 10 || operation == 13 then [1, 1]
    else if operation == 11 then [1, 1, element]
    else if operation == 20 then [0]
    else if operation == 22 || operation == 24 || operation == 27 then [1, 0]
    else if operation == 23 then [1, 0, 0]
    else if operation == 25 then [1, 0, 1, 0, 0]
    else if operation == 26 then [1, 0, 0]
    else if operation >= 30 && operation <= 33 then [2, 1]
    else if operation == 34 || operation == 35 || operation == 38 then [1, 1, 0]
    else if operation == 36 || operation == 37 || operation == 42 then [1, 0]
    else if operation == 39 then [1, 1]
    else if operation == 40 then [1, 2, 2, 0]
    else if operation == 41 || operation == 48 then [1, 0, 0]
    else if operation == 43 then [1, 2]
    else if operation == 44 then [1, 2, 2, 2, 1, 0, 0, 2]
    else if operation == 45 then [1, 1, 1, 1, 0]
    else if operation == 46 then [0]
    else if operation == 47 then [1, 2, 2, 2, 2]
    else if operation == 49 then [1, 0, 0, 0]
    else if operation == 50 then [2, 1]
    else if (operation >= 51 && operation <= 55) || operation == 67 then [1, 1]
    else if operation == 56 || operation == 57 || operation == 70 then [1, 1, 1]
    else if operation == 58 || operation == 59 then [1, 0, 1]
    else if operation >= 60 && operation <= 62 then [1, 0]
    else if operation == 63 || operation == 68 || operation == 69 || operation == 74 || operation == 98 then [1, 1, 0]
    else if operation == 64 then [1, 2, 2, 1, 2, 2, 2, 0]
    else if operation == 65 then [1, 2, 2, 0]
    else if operation == 66 then [1, 0, 0]
    else if operation == 71 then [1, 1, 1, 0]
    else if operation == 72 then [1, 2]
    else if operation == 73 || operation == 102 then [1, 2, 2, 2, 1, 0, 2]
    else if operation == 75 then [1, 2, 2, 2]
    else if operation == 76 then [1, 2, 2, 2, 2, 2]
    else if (operation >= 77 && operation <= 80) || operation == 86 || operation == 87 || operation == 95 then [0]
    else if operation == 81 then [0, 1]
    else if operation >= 82 && operation <= 85 then [0, 0]
    else if operation == 88 then [0, 0, 0, 2, 0]
    else if operation == 89 || operation == 90 then [0, 0, 2, 0]
    else if operation == 91 then [0, 0, 2, 2]
    else if operation == 92 then [0, 0, 2, 2, 2, 1, 0, 0, 2, 2]
    else if operation == 93 then [0, 0, 2, 2, 2, 1, 0, 2]
    else if operation == 94 then [0, 0, 0, 0, 0, 2, 2, 0]
    else if operation == 96 || operation == 97 then [2, 0]
    else if operation == 99 then [1, 0]
    else if operation == 100 then [1, 2, 2]
    else if operation == 101 then [2, 1, 1, 0] else [1]
  array-symbol :: String -> List Nat -> String
  array-symbol name classes = specialized-name name classes
  array-call :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List UType -> List String -> List CoreTerm -> (Writer, String)
  array-call definitions locals w sp name actuals givens args = case array-plan name of
    Some (operation, format, scheme) -> case class-vector (w.context) actuals of
      -- An array element is one scanned word.
      Some classes -> if wide-code classes then
        unsupported w sp (if operation == 13 then "`columnarZip` requires a wide tuple layout bridge for an I128/U128 tuple field" else wide-refusal)
        else if val-code classes then unsupported w sp val-refusal
        else if list-length givens /= 0 || list-length classes /= (if format /= 0 then 0 else if operation == 13 || operation == 17 || operation == 18 then 2 else 1) then
        unsupported w sp "array intrinsic needs its exact checked representation parameters" else
        let parameters = array-argument-classes operation classes in
        let count = list-length parameters in
        let worker = array-symbol name classes in
        case expressions definitions locals (request-demand (ArrayDemand name classes) w) (take-terms count args) of
          (ready, values) -> if list-length values < count then closure sp worker parameters values ready else
            case call ready (symbol worker) values of (done, result) -> apply-terms definitions locals done result (drop-terms count args)
      None -> unsupported w sp "array element needs a checked runtime representation"
    None -> unsupported w sp "array operation is unavailable in the selected ABI"
  array-drop-arguments :: List Nat -> Nat -> Writer -> Writer
  array-drop-arguments classes index w = case classes of
    [] -> w
    first : rest -> array-drop-arguments rest (index + 1) (if first == 0 then w else count-line False (cat ["%arg", nat-to-string index]) w)
  array-option :: Writer -> Span -> Nat -> String -> String -> List String -> (Writer, String)
  array-option w sp payload-class invalid runtime arguments =
    case (constructor (global-data-core-some) (writer-program w), constructor (global-data-core-none) (writer-program w)) of
      (Some (owner, some-tag, some-constructor), Some (none-owner, none-tag, none-constructor)) ->
        if not (owner == global-data-core-option && owner == none-owner) || some-tag /= 1 || none-tag /= 0 || list-length (core-constructor-fields some-constructor) /= 1 || list-length (core-constructor-fields none-constructor) /= 0 then unsupported w sp "array result needs its checked Option declaration" else
        (case data-declaration owner (writer-program w) of
          Some d -> if list-length (core-data-constructors d) /= 2 || not (case core-constructor-fields some-constructor of [field] -> array-binder-field d field; other -> False) then unsupported w sp "array Option payload disagrees with its checked parameter" else (case request-data sp d [payload-class] w of
            (planned, descriptor) ->
              let (one, failure) = fresh planned "arraynone" in let (two, success) = fresh one "arraysome" in
              let (three, end) = fresh two "arraydone" in let (four, slot) = fresh three "%ptr" in
              let (five, predicate) = fresh four "%v" in
              let split = line (line (line five (cat ["  ", slot, " = alloca i64"])) (cat ["  ", predicate, " = icmp ne i64 ", invalid, ", 0"])) (cat ["  br i1 ", predicate, ", label %", failure, ", label %", success]) in
              case allocate (line split (cat [failure, ":"])) (data-descriptor descriptor none-tag) [] of
                (absent, none) -> let next = line (line (line absent (cat ["  store i64 ", none, ", ptr ", slot])) (cat ["  br label %", end])) (cat [success, ":"]) in
                  case (if runtime == "" then (next, case arguments of value : rest -> value; [] -> "0") else call next runtime arguments) of
                    (read, payload) -> case allocate read (data-descriptor descriptor some-tag) [payload] of
                      (present, some) -> let joined = line (line (line present (cat ["  store i64 ", some, ", ptr ", slot])) (cat ["  br label %", end])) (cat [end, ":"]) in
                        let (ready, value) = fresh joined "%v" in (line ready (cat ["  ", value, " = load i64, ptr ", slot]), value))
          None -> unsupported w sp "array result has no defining Option family")
      other -> unsupported w sp "array result has no checked Option constructors"
  array-null-option :: Writer -> Span -> String -> String -> List String -> (Writer, String)
  array-null-option w sp runtime result arguments = case call w runtime arguments of
    (made, value) -> case compare-word made "eq" value "0" of
      (checked, invalid) -> array-option checked sp 1 invalid "" [value]
  array-nonneg-option :: Writer -> Span -> Nat -> String -> List String -> (Writer, String)
  array-nonneg-option w sp payload-class runtime arguments = case call w runtime arguments of
    (made, value) -> case compare-word made "slt" value "0" of
      (checked, invalid) -> array-option checked sp payload-class invalid "" [value]
  array-lower :: Writer -> Nat -> Nat -> List Nat -> (Writer, String)
  array-lower w operation format classes =
    let sp = Span 0 0 1 1 in let element = array-head-class classes in
    let storage = nat-to-string (if format == 0 then element else format) in
    if operation == 0 then (if array-list-abi w then call w "@cinch_array_from_list" ["%arg0", storage] else unsupported w sp "array input disagrees with the checked List ABI")
    else if operation == 1 then (case call w "@cinch_nat_to_len" ["%arg0"] of (ready, count) -> call ready "@cinch_array_replicate" [count, "%arg1", storage])
    else if operation == 2 || operation == 14 || operation == 15 then
      (case call w (if operation == 2 then "@cinch_array_len" else if operation == 14 then "@cinch_columnar_rows" else "@cinch_columnar_columns") ["%arg0"] of
        (measured, count) -> call measured "@cinch_nat_from_i64" [count])
    else if operation == 3 || operation == 16 then
      (case call w "@cinch_nat_to_len" ["%arg1"] of
        (indexed, index) -> case (if operation == 3 then
          (case call indexed "@cinch_array_has" ["%arg0", index] of (ready, valid) -> compare-word ready "eq" valid "0")
          else case call indexed "@cinch_columnar_rows" ["%arg0"] of (ready, count) -> compare-word ready "uge" index count) of
          (checked, invalid) -> array-option checked sp element invalid (if operation == 3 then "@cinch_array_get" else "@cinch_columnar_get") ["%arg0", index])
    else if operation == 4 then (case call w "@cinch_nat_to_len" ["%arg1"] of
      (ready, index) -> array-null-option ready sp "@cinch_array_set" "" ["%arg0", index, "%arg2"])
    else if operation == 5 then (case call w "@cinch_nat_to_len" ["%arg1"] of
      (indexed, index) -> case call indexed "@cinch_nat_to_len" ["%arg2"] of
        (ready, count) -> array-null-option ready sp "@cinch_array_slice" "" ["%arg0", index, count])
    else if operation == 6 then call w "@cinch_array_append" ["%arg0", "%arg1"]
    else if operation == 7 then array-null-option w sp "@cinch_tensor_reshape" "" ["%arg0", "%arg1"]
    else if operation == 8 || operation == 9 then call w (if operation == 8 then "@cinch_tensor_shape" else "@cinch_tensor_data") ["%arg0"]
    else if operation == 10 || operation == 11 then
      (case call w "@cinch_tensor_index" ["%arg0", "%arg1"] of
        (indexed, index) -> case compare-word indexed "slt" index "0" of
          (checked, invalid) -> array-option checked sp (if operation == 10 then element else 1) invalid
            (if operation == 10 then "@cinch_tensor_get" else "@cinch_tensor_set") (if operation == 10 then ["%arg0", index] else ["%arg0", index, "%arg2"]))
    else if operation == 12 then call w "@cinch_columnar_column" ["%arg0"]
    else if operation == 13 then (case request-tuple-shape sp classes w of
      (ready, descriptor) -> case description-word ready descriptor of
        (described, word) -> array-null-option described sp "@cinch_columnar_zip" "" ["%arg0", "%arg1", word])
    else if operation == 17 || operation == 18 then array-null-option w sp "@cinch_columnar_child" "" ["%arg0", if operation == 18 then "1" else "0"]
    else if operation == 19 then array-null-option w sp "@cinch_columnar_array" "" ["%arg0"]
    else if operation >= 30 then array-compute-lower w sp operation storage
    else if operation >= 20 then slot-lower w operation element
    else unsupported w sp "unknown checked array operation"
  array-compute-lower :: Writer -> Span -> Nat -> String -> (Writer, String)
  array-compute-lower w sp operation storage =
    if operation >= 30 && operation <= 33 then (case call w "@cinch_nat_to_len" ["%arg0"] of (ready, count) -> call ready "@cinch_array_tabulate_packed" [count, "%arg1", storage])
    else if operation == 34 then array-null-option w sp "@cinch_array_zip_binop_f32" "" ["%arg0", "%arg1", "%arg2"]
    else if operation == 35 then array-null-option w sp "@cinch_array_zip_binop_i32" "" ["%arg0", "%arg1", "%arg2"]
    else if operation == 36 then call w "@cinch_array_reduce_f32" ["%arg0", "%arg1"]
    else if operation == 37 then call w "@cinch_array_reduce_i32" ["%arg0", "%arg1"]
    else if operation == 38 then call w "@cinch_array_dot_f32" ["%arg0", "%arg1", "%arg2"]
    else if operation == 39 then call w "@cinch_array_dot_i32" ["%arg0", "%arg1"]
    else if operation == 40 then (case call w "@cinch_nat_to_len" ["%arg1"] of (r1, m) -> case call r1 "@cinch_nat_to_len" ["%arg2"] of (r2, n) -> array-null-option r2 sp "@cinch_array_row_reduce_f32" "" ["%arg0", m, n, "%arg3"])
    else if operation == 41 then call w "@cinch_array_scan_i32" ["%arg0", "%arg1", "%arg2"]
    else if operation == 42 then call w "@cinch_array_filter_i32_gt" ["%arg0", "%arg1"]
    else if operation == 43 then (case call w "@cinch_nat_to_len" ["%arg1"] of (r1, bins) -> call r1 "@cinch_array_histogram_u8" ["%arg0", bins])
    else if operation == 44 then (case call w "@cinch_nat_to_len" ["%arg1"] of (r1, f) -> case call r1 "@cinch_nat_to_len" ["%arg2"] of (r2, h) -> case call r2 "@cinch_nat_to_len" ["%arg3"] of (r3, wd) -> case call r3 "@cinch_nat_to_len" ["%arg7"] of (r4, steps) -> array-null-option r4 sp "@cinch_array_stencil2d_u8" "" ["%arg0", f, h, wd, "%arg4", "%arg5", "%arg6", steps])
    else if operation == 45 then call w "@cinch_array_spmv_csr_f32" ["%arg0", "%arg1", "%arg2", "%arg3", "%arg4"]
    else if operation == 46 then call w "@cinch_array_set_exec_mode" ["%arg0"]
    else if operation == 47 then (case call w "@cinch_nat_to_len" ["%arg1"] of (r1, f) -> case call r1 "@cinch_nat_to_len" ["%arg2"] of (r2, h) -> case call r2 "@cinch_nat_to_len" ["%arg3"] of (r3, wd) -> case call r3 "@cinch_nat_to_len" ["%arg4"] of (r4, bins) -> array-null-option r4 sp "@cinch_array_histogram_batch_u8" "" ["%arg0", f, h, wd, bins])
    else if operation == 48 then call w "@cinch_array_map_unary_f32" ["%arg0", "%arg1", "%arg2"]
    else if operation == 49 then call w "@cinch_array_fused_map_reduce_f32" ["%arg0", "%arg1", "%arg2", "%arg3"]
    else if operation == 50 then (case call w "@cinch_nat_to_len" ["%arg0"] of (ready, count) -> call ready "@cinch_array_tabulate_packed" [count, "%arg1", storage])
    else if operation >= 51 && operation <= 55 then call w "@cinch_array_map_packed" ["%arg0", "%arg1", storage]
    else if operation == 56 || operation == 57 then array-null-option w sp "@cinch_array_zip_with_packed" "" ["%arg0", "%arg1", "%arg2", storage]
    else if operation == 58 || operation == 59 then call w "@cinch_array_foldl_packed" ["%arg0", "%arg1", "%arg2"]
    else if operation == 60 then call w "@cinch_array_reduce_u32" ["%arg0", "%arg1"]
    else if operation == 61 then call w "@cinch_array_reduce_i64" ["%arg0", "%arg1"]
    else if operation == 62 then call w "@cinch_array_reduce_f64" ["%arg0", "%arg1"]
    else if operation == 63 then call w "@cinch_array_dot_f64" ["%arg0", "%arg1", "%arg2"]
    else if operation == 64 then (case call w "@cinch_nat_to_len" ["%arg1"] of (r1, oa) -> case call r1 "@cinch_nat_to_len" ["%arg2"] of (r2, sa) -> case call r2 "@cinch_nat_to_len" ["%arg4"] of (r3, ob) -> case call r3 "@cinch_nat_to_len" ["%arg5"] of (r4, sb) -> case call r4 "@cinch_nat_to_len" ["%arg6"] of (r5, n) -> call r5 "@cinch_array_strided_dot_f32" ["%arg0", oa, sa, "%arg3", ob, sb, n, "%arg7"])
    else if operation == 65 then (case call w "@cinch_nat_to_len" ["%arg1"] of (r1, m) -> case call r1 "@cinch_nat_to_len" ["%arg2"] of (r2, n) -> array-null-option r2 sp "@cinch_array_row_reduce_i32" "" ["%arg0", m, n, "%arg3"])
    else if operation == 66 then call w "@cinch_array_scan_u32" ["%arg0", "%arg1", "%arg2"]
    else if operation == 67 then call w "@cinch_array_filter_packed" ["%arg0", "%arg1"]
    else if operation == 68 then call w "@cinch_array_gather_f32" ["%arg0", "%arg1", "%arg2"]
    else if operation == 69 then call w "@cinch_array_gather_i32" ["%arg0", "%arg1", "%arg2"]
    else if operation == 70 then call w "@cinch_array_scatter_unique_u32" ["%arg0", "%arg1", "%arg2"]
    else if operation == 71 then call w "@cinch_array_scatter_combine_i32" ["%arg0", "%arg1", "%arg2", "%arg3"]
    else if operation == 72 then (case call w "@cinch_nat_to_len" ["%arg1"] of (r1, bins) -> call r1 "@cinch_array_histogram_u32" ["%arg0", bins])
    else if operation == 73 then (case call w "@cinch_nat_to_len" ["%arg1"] of (r1, f) -> case call r1 "@cinch_nat_to_len" ["%arg2"] of (r2, h) -> case call r2 "@cinch_nat_to_len" ["%arg3"] of (r3, wd) -> case call r3 "@cinch_nat_to_len" ["%arg6"] of (r4, steps) -> array-null-option r4 sp "@cinch_array_stencil2d_f32" "" ["%arg0", f, h, wd, "%arg4", "%arg5", steps])
    else if operation == 74 then call w "@cinch_array_segmented_reduce_f32" ["%arg0", "%arg1", "%arg2"]
    else if operation == 75 then (case call w "@cinch_nat_to_len" ["%arg1"] of (r1, off) -> case call r1 "@cinch_nat_to_len" ["%arg2"] of (r2, len) -> case call r2 "@cinch_nat_to_len" ["%arg3"] of (r3, st) -> array-null-option r3 sp "@cinch_array_pack_strided_1d" "" ["%arg0", off, len, st])
    else if operation == 76 then (case call w "@cinch_nat_to_len" ["%arg1"] of (r1, off) -> case call r1 "@cinch_nat_to_len" ["%arg2"] of (r2, r) -> case call r2 "@cinch_nat_to_len" ["%arg3"] of (r3, c) -> case call r3 "@cinch_nat_to_len" ["%arg4"] of (r4, sr) -> case call r4 "@cinch_nat_to_len" ["%arg5"] of (r5, sc) -> array-null-option r5 sp "@cinch_array_pack_strided_2d" "" ["%arg0", off, r, c, sr, sc])
    else if operation == 77 then call w "@cinch_array_last_report_bytes" []
    else if operation == 78 then call w "@cinch_device_open" ["%arg0"]
    else if operation == 79 then call w "@cinch_device_close" ["%arg0"]
    else if operation == 80 then call w "@cinch_device_reset_telemetry" ["%arg0"]
    else if operation == 81 then call w "@cinch_device_upload_array" ["%arg0", "%arg1"]
    else if operation >= 82 && operation <= 85 then array-null-option w sp "@cinch_device_download_array" "" ["%arg0", "%arg1", storage]
    else if operation == 86 then call w "@cinch_device_buffer_free" ["%arg0"]
    else if operation == 87 then call w "@cinch_device_buffer_bytes" ["%arg0"]
    else if operation == 88 then (case call w "@cinch_nat_to_len" ["%arg3"] of (r1, n) -> array-nonneg-option r1 sp 0 "@cinch_device_dot_f32_bits" ["%arg0", "%arg1", "%arg2", n, "%arg4"])
    else if operation == 89 then (case call w "@cinch_nat_to_len" ["%arg2"] of (r1, n) -> call r1 "@cinch_device_scan_i32" ["%arg0", "%arg1", n, "%arg3"])
    else if operation == 90 then (case call w "@cinch_nat_to_len" ["%arg2"] of (r1, n) -> call r1 "@cinch_device_filter_i32_gt_handle" ["%arg0", "%arg1", n, "%arg3"])
    else if operation == 91 then (case call w "@cinch_nat_to_len" ["%arg2"] of (r1, r) -> case call r1 "@cinch_nat_to_len" ["%arg3"] of (r2, c) -> call r2 "@cinch_device_row_reduce_f32" ["%arg0", "%arg1", r, c])
    else if operation == 92 then (case call w "@cinch_nat_to_len" ["%arg2"] of (r1, f) -> case call r1 "@cinch_nat_to_len" ["%arg3"] of (r2, h) -> case call r2 "@cinch_nat_to_len" ["%arg4"] of (r3, wd) -> case call r3 "@cinch_nat_to_len" ["%arg8"] of (r4, steps) -> case call r4 "@cinch_nat_to_len" ["%arg9"] of (r5, bins) -> call r5 "@cinch_device_stencil_histogram_u8_arr" ["%arg0", "%arg1", f, h, wd, "%arg5", "%arg6", "%arg7", steps, bins])
    else if operation == 93 then (case call w "@cinch_nat_to_len" ["%arg2"] of (r1, f) -> case call r1 "@cinch_nat_to_len" ["%arg3"] of (r2, h) -> case call r2 "@cinch_nat_to_len" ["%arg4"] of (r3, wd) -> case call r3 "@cinch_nat_to_len" ["%arg7"] of (r4, steps) -> call r4 "@cinch_device_stencil2d_f32_arr" ["%arg0", "%arg1", f, h, wd, "%arg5", "%arg6", steps])
    else if operation == 94 then (case call w "@cinch_nat_to_len" ["%arg5"] of (r1, rows) -> case call r1 "@cinch_nat_to_len" ["%arg6"] of (r2, nnz) -> call r2 "@cinch_device_spmv_csr_f32" ["%arg0", "%arg1", "%arg2", "%arg3", "%arg4", rows, nnz, "%arg7"])
    else if operation == 95 then call w "@cinch_device_report_bytes" ["%arg0"]
    else if operation == 96 then (case call w "@cinch_nat_to_len" ["%arg0"] of (r1, n) -> call r1 "@cinch_array_fill_f32" [n, "%arg1"])
    else if operation == 97 then (case call w "@cinch_nat_to_len" ["%arg0"] of (r1, n) -> call r1 "@cinch_array_fill_f64" [n, "%arg1"])
    else if operation == 98 then array-null-option w sp "@cinch_array_zip_binop_f64" "" ["%arg0", "%arg1", "%arg2"]
    else if operation == 99 then call w "@cinch_array_scale_f64" ["%arg0", "%arg1"]
    else if operation == 100 then (case call w "@cinch_nat_to_len" ["%arg1"] of (r1, r) -> case call r1 "@cinch_nat_to_len" ["%arg2"] of (r2, c) -> call r2 "@cinch_array_row_broadcast_f32" ["%arg0", r, c])
    else if operation == 101 then (case call w "@cinch_nat_to_len" ["%arg0"] of (r1, n) -> call r1 "@cinch_array_scatter_add_f32" [n, "%arg1", "%arg2", "%arg3"])
    else if operation == 102 then (case call w "@cinch_nat_to_len" ["%arg1"] of (r1, f) -> case call r1 "@cinch_nat_to_len" ["%arg2"] of (r2, h) -> case call r2 "@cinch_nat_to_len" ["%arg3"] of (r3, wd) -> case call r3 "@cinch_nat_to_len" ["%arg6"] of (r4, steps) -> array-null-option r4 sp "@cinch_array_stencil2d_adjoint_f32" "" ["%arg0", f, h, wd, "%arg4", "%arg5", steps])
    else unsupported w sp "unknown checked array compute operation"
  -- Producer-consumer fusion for packed array operations, resolving thin
  -- single-clause wrappers and imported helper functions before lowering.
  resolve-param-term :: List CorePattern -> List CoreTerm -> CoreTerm -> Option CoreTerm
  resolve-param-term patterns args term = case term of
    CLocal sp ty id name actuals -> lookup-param-term patterns args id
    CInt sp ty digits -> Some term
    other -> None
  lookup-param-term :: List CorePattern -> List CoreTerm -> Nat -> Option CoreTerm
  lookup-param-term patterns args wanted = case (patterns, args) of
    ((CPVar sp ty id name) : rest, val : more) -> if id == wanted then Some val else lookup-param-term rest more wanted
    other -> None
  resolve-param-terms :: List CorePattern -> List CoreTerm -> List CoreTerm -> Option (List CoreTerm)
  resolve-param-terms patterns args items = case items of
    [] -> Some []
    first : rest -> case resolve-param-term patterns args first of
      None -> None
      Some mapped -> case resolve-param-terms patterns args rest of
        None -> None
        Some tail -> Some (mapped : tail)
  resolve-array-op :: Writer -> Nat -> CoreTerm -> Option (String, List CoreTerm)
  resolve-array-op w depth term = case call-spine term [] of
    None -> None
    Some (name, actuals, args) ->
      if name == "cinch.runtime.arrayZipBinopF32" || name == "cinch.runtime.arrayZipBinopI32" || name == "cinch.runtime.arrayReduceF32" || name == "cinch.runtime.arrayReduceI32" then Some (name, args)
      else if depth == 0 then None
      else case worker-definition name w of
        None -> None
        Some d -> case inline-body-shape d of
          None -> None
          Some (patterns, body) -> if list-length args /= list-length patterns then None else case resolve-array-op w (depth - 1) body of
            None -> None
            Some (inner-name, inner-args) -> case resolve-param-terms patterns args inner-args of
              None -> None
              Some mapped -> Some (inner-name, mapped)
  option-alt-some :: CorePattern -> Option Nat
  option-alt-some pat = case pat of
    CPConstructor sp ty name actuals owner (CPField fsp (CPVar vsp vty id vname) (CPDone dsp)) ->
      if name == global-data-core-some then Some id else None
    other -> None
  option-alt-none :: CorePattern -> Bool
  option-alt-none pat = case pat of
    CPConstructor sp ty name actuals owner (CPDone dsp) -> name == global-data-core-none
    other -> False
  extract-option-alts :: CoreTerm -> Option (Nat, CoreTerm, CoreTerm)
  extract-option-alts alts = case alts of
    CAlternative sp1 p1 b1 (CAlternative sp2 p2 b2 (CAlternativesEnd sp3)) ->
      (case option-alt-some p1 of
        Some id -> if option-alt-none p2 then Some (id, b1, b2) else None
        None -> case option-alt-some p2 of
          Some id -> if option-alt-none p1 then Some (id, b2, b1) else None
          None -> None)
    other -> None
  is-int-const :: CoreTerm -> String -> Bool
  is-int-const term expected = case term of
    CInt sp ty digits -> digits == expected
    other -> False
  is-local-id :: CoreTerm -> Nat -> Bool
  is-local-id term wanted = case term of
    CLocal sp ty id name actuals -> id == wanted
    other -> False
  fuse-array-case :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> CoreTerm -> Option (Writer, String)
  fuse-array-case definitions locals w sp scrutinee alts = case extract-option-alts alts of
    None -> None
    Some (some-id, some-body, none-body) -> case resolve-array-op w 4 scrutinee of
      None -> None
      Some (prod-name, prod-args) -> case resolve-array-op w 4 some-body of
        None -> None
        Some (cons-name, cons-args) ->
          if prod-name == "cinch.runtime.arrayZipBinopF32" && cons-name == "cinch.runtime.arrayReduceF32" then
            (case (prod-args, cons-args) of
              ([arg-a, arg-b, op-term], [arg-p, mode-term]) ->
                if is-int-const op-term "2" && is-local-id arg-p some-id && not (term-uses some-id mode-term) then
                  Some (emit-fused-dot-f32 definitions locals w arg-a arg-b mode-term none-body)
                else None
              other -> None)
          else if prod-name == "cinch.runtime.arrayZipBinopI32" && cons-name == "cinch.runtime.arrayReduceI32" then
            (case (prod-args, cons-args) of
              ([arg-a, arg-b, op-term], [arg-p, red-term]) ->
                if is-int-const op-term "2" && is-int-const red-term "0" && is-local-id arg-p some-id then
                  Some (emit-fused-dot-i32 definitions locals w arg-a arg-b none-body)
                else None
              other -> None)
          else None
  emit-fused-dot-f32 :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> CoreTerm -> CoreTerm -> CoreTerm -> (Writer, String)
  emit-fused-dot-f32 definitions locals w arg-a arg-b mode-term none-body =
    let noted = line w "  ; cinch-array-fusion: fused arrayZipBinopF32(MUL) -> arrayReduceF32 into @cinch_array_dot_f32 (eliminated product Array F32)" in
    case expression definitions locals noted arg-a of
      (wa, va) -> case expression definitions locals wa arg-b of
        (wb, vb) -> case expression definitions locals wb mode-term of
          (wm, vm) -> case call wm "@cinch_array_len" [va] of
            (wl1, la) -> case call wl1 "@cinch_array_len" [vb] of
              (wl2, lb) ->
                let (w1, slot) = fresh wl2 "%ptr" in
                let (w2, eq) = fresh w1 "%v" in
                let (w3, ok-lbl) = fresh w2 "fuseok" in
                let (w4, bad-lbl) = fresh w3 "fusebad" in
                let (w5, end-lbl) = fresh w4 "fusedone" in
                let split = line (line (line w5 (cat ["  ", slot, " = alloca i64"])) (cat ["  ", eq, " = icmp eq i64 ", la, ", ", lb])) (cat ["  br i1 ", eq, ", label %", ok-lbl, ", label %", bad-lbl]) in
                case call (line split (cat [ok-lbl, ":"])) "@cinch_array_dot_f32" [va, vb, vm] of
                  (wdot, vdot) ->
                    let wdot-clean = count-line False vb (count-line False va wdot) in
                    let wbad-start = line (line (line wdot-clean (cat ["  store i64 ", vdot, ", ptr ", slot])) (cat ["  br label %", end-lbl])) (cat [bad-lbl, ":"]) in
                    let wbad-clean = count-line False vb (count-line False va wbad-start) in
                    case expression definitions locals wbad-clean none-body of
                      (wnone, vnone) ->
                        let wjoin = line (line (line wnone (cat ["  store i64 ", vnone, ", ptr ", slot])) (cat ["  br label %", end-lbl])) (cat [end-lbl, ":"]) in
                        let (wfin, vres) = fresh wjoin "%v" in
                        (line wfin (cat ["  ", vres, " = load i64, ptr ", slot]), vres)
  emit-fused-dot-i32 :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> CoreTerm -> CoreTerm -> (Writer, String)
  emit-fused-dot-i32 definitions locals w arg-a arg-b none-body =
    let noted = line w "  ; cinch-array-fusion: fused arrayZipBinopI32(MUL) -> arrayReduceI32(ADD_WRAP) into @cinch_array_dot_i32 (eliminated product Array I32)" in
    case expression definitions locals noted arg-a of
      (wa, va) -> case expression definitions locals wa arg-b of
        (wb, vb) -> case call wb "@cinch_array_len" [va] of
          (wl1, la) -> case call wl1 "@cinch_array_len" [vb] of
            (wl2, lb) ->
              let (w1, slot) = fresh wl2 "%ptr" in
              let (w2, eq) = fresh w1 "%v" in
              let (w3, ok-lbl) = fresh w2 "fuseok" in
              let (w4, bad-lbl) = fresh w3 "fusebad" in
              let (w5, end-lbl) = fresh w4 "fusedone" in
              let split = line (line (line w5 (cat ["  ", slot, " = alloca i64"])) (cat ["  ", eq, " = icmp eq i64 ", la, ", ", lb])) (cat ["  br i1 ", eq, ", label %", ok-lbl, ", label %", bad-lbl]) in
              case call (line split (cat [ok-lbl, ":"])) "@cinch_array_dot_i32" [va, vb] of
                (wdot, vdot) ->
                  let wdot-clean = count-line False vb (count-line False va wdot) in
                  let wbad-start = line (line (line wdot-clean (cat ["  store i64 ", vdot, ", ptr ", slot])) (cat ["  br label %", end-lbl])) (cat [bad-lbl, ":"]) in
                  let wbad-clean = count-line False vb (count-line False va wbad-start) in
                  case expression definitions locals wbad-clean none-body of
                    (wnone, vnone) ->
                      let wjoin = line (line (line wnone (cat ["  store i64 ", vnone, ", ptr ", slot])) (cat ["  br label %", end-lbl])) (cat [end-lbl, ":"]) in
                      let (wfin, vres) = fresh wjoin "%v" in
                      (line wfin (cat ["  ", vres, " = load i64, ptr ", slot]), vres)
  -- The mutable slot family (seed/src/slots.rs and slots_codegen.rs,
  -- the same IR): a slot array is an Array block with a word format, the
  -- length at payload word 1 and the elements from word 2. The worker owns
  -- its arguments and drops the counted ones at its end, which is why a
  -- write's value is listed as uncounted (array-argument-classes): the
  -- slot takes that reference over.
  slot-lower :: Writer -> Nat -> Nat -> (Writer, String)
  slot-lower w operation element =
    if operation == 20 then call w "@cinch_slots_new" ["%arg0", nat-to-string element]
    else if operation == 21 then slot-length w
    else if operation == 25 then call w "@cinch_slots_move" ["%arg0", "%arg1", "%arg2", "%arg3", "%arg4"]
    else if operation == 26 then call w "@cinch_slots_clear" ["%arg0", "%arg1", "%arg2"]
    else if operation == 27 then slot-prefetch w
    else case slot-address w of
      (ready, address) ->
        if operation == 22 then (case slot-load ready address element of
          (loaded, value) -> (if element == 0 then loaded else line loaded (count-call True value), value))
        else if operation == 24 then (case slot-load ready address element of
          (loaded, value) -> (if element == 0 then loaded else line loaded (cat ["  store i64 0, ptr ", address, ", align 8"]), value))
        else
          let (one, old) = fresh ready "%v" in
          let stored = line (line one (cat ["  ", old, " = load i64, ptr ", address, ", align 8"])) (cat ["  store i64 %arg2, ptr ", address, ", align 8"]) in
          (if element == 0 then stored else line stored (count-call False old), "0")
  slot-length :: Writer -> (Writer, String)
  slot-length w =
    let (one, base) = fresh w "%v" in let (two, at) = fresh one "%v" in let (three, count) = fresh two "%v" in
    (line (line (line three (cat ["  ", base, " = inttoptr i64 %arg0 to ptr"])) (cat ["  ", at, " = getelementptr inbounds i64, ptr ", base, ", i64 1"])) (cat ["  ", count, " = load i64, ptr ", at, ", align 8"]), count)
  -- The address of slot %arg1, after checking it against the length: an
  -- index at or past it is a container bug and traps (code 1).
  slot-address :: Writer -> (Writer, String)
  slot-address w = case slot-length w of
    (measured, count) ->
      let (one, ok) = fresh measured "%v" in let (two, good) = fresh one "slotok" in let (three, bad) = fresh two "slotbad" in
      let (four, base) = fresh three "%v" in let (five, at) = fresh four "%v" in let (six, address) = fresh five "%v" in
      let checked = line (line six (cat ["  ", ok, " = icmp ult i64 %arg1, ", count])) (cat ["  br i1 ", ok, ", label %", good, ", label %", bad]) in
      let trapped = line (line (line checked (cat [bad, ":"])) "  call i64 @cinch_slots_fault(i64 1)") "  unreachable" in
      let resumed = line trapped (cat [good, ":"]) in
      let based = line (line resumed (cat ["  ", base, " = inttoptr i64 %arg0 to ptr"])) (cat ["  ", at, " = add i64 %arg1, 2"]) in
      (line based (cat ["  ", address, " = getelementptr inbounds i64, ptr ", base, ", i64 ", at]), address)
  -- A slot's word; a counted hole is a container bug and traps (code 2).
  slot-load :: Writer -> String -> Nat -> (Writer, String)
  slot-load w address element =
    let (one, value) = fresh w "%v" in
    let loaded = line one (cat ["  ", value, " = load i64, ptr ", address, ", align 8"]) in
    if element == 0 then (loaded, value) else
      let (two, hole) = fresh loaded "%v" in let (three, good) = fresh two "slotfull" in let (four, bad) = fresh three "slothole" in
      let checked = line (line four (cat ["  ", hole, " = icmp eq i64 ", value, ", 0"])) (cat ["  br i1 ", hole, ", label %", bad, ", label %", good]) in
      (line (line (line (line checked (cat [bad, ":"])) "  call i64 @cinch_slots_fault(i64 2)") "  unreachable") (cat [good, ":"]), value)
  -- A read hint for slot %arg1, issued only in range; it changes nothing.
  slot-prefetch :: Writer -> (Writer, String)
  slot-prefetch w = case slot-length w of
    (measured, count) ->
      let (one, ok) = fresh measured "%v" in let (two, go) = fresh one "slotgo" in let (three, done) = fresh two "slotdone" in
      let (four, base) = fresh three "%v" in let (five, at) = fresh four "%v" in let (six, address) = fresh five "%v" in
      let checked = line (line six (cat ["  ", ok, " = icmp ult i64 %arg1, ", count])) (cat ["  br i1 ", ok, ", label %", go, ", label %", done]) in
      let issued = line (line (line (line (line checked (cat [go, ":"])) (cat ["  ", base, " = inttoptr i64 %arg0 to ptr"])) (cat ["  ", at, " = add i64 %arg1, 2"])) (cat ["  ", address, " = getelementptr inbounds i64, ptr ", base, ", i64 ", at])) (cat ["  call void @llvm.prefetch.p0(ptr ", address, ", i32 0, i32 3, i32 1)"]) in
      (line (line issued (cat ["  br label %", done])) (cat [done, ":"]), "0")
  array-worker :: String -> List Nat -> Writer -> Writer
  array-worker name classes w = case array-plan name of
    None -> refuse w (Span 0 0 1 1) "array worker unavailable in selected ABI"
    Some (operation, format, scheme) ->
      let parameters = array-argument-classes operation classes in
      let started = line (line w (cat ["define ", worker-linkage w (array-symbol name classes), "i64 ", symbol (array-symbol name classes), "(", join (argument-words (value-parameters (list-length parameters) 0)), ")", worker-open w])) "entry:" in
      case array-lower started operation format classes of
        (made, result) -> let done = array-drop-arguments parameters 0 made in line (line done (cat ["  ret i64 ", result])) "}"

  -- | Keep actual payload classes in partial closures; consumption is a separate worker rule.
  mvar-argument-classes :: Nat -> Nat -> List Nat
  mvar-argument-classes operation element =
    if operation == 20 || operation == 30 then [0]
    else if operation == 21 then [1, 0]
    else if operation >= 22 && operation <= 28 then [1, 0, 0]
    else if operation == 29 then [1, 0, 0, 0, 0]
    else if operation == 0 || operation == 14 then [element]
    else if operation == 1 then [0]
    else if mvar-arity operation == 2 then [1, element]
    else [1]

  -- | Evaluate a checked MVar/RwLock/Atomic call in ordinary argument order and refuse unsupported wide storage.
  mvar-call :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List UType -> List String -> List CoreTerm -> (Writer, String)
  mvar-call definitions locals w sp name actuals givens args = case mvar-plan name of
    Some (operation, scheme) ->
      if operation >= 20 then
        if list-length actuals /= 0 || list-length givens /= 0 then unsupported w sp "Atomic intrinsic takes no representation parameters"
        else let parameters = mvar-argument-classes operation 0 in
          let count = mvar-arity operation in let worker = specialized-name name [0] in
          (case expressions definitions locals (request-demand (MVarDemand name [0]) w) (take-terms count args) of
            (ready, values) -> if list-length values < count then closure sp worker parameters values ready else
              (case call ready (symbol worker) values of
                (done, result) -> apply-terms definitions locals done result (drop-terms count args)))
      else case class-vector (w.context) actuals of
        Some [element] -> if element == 3 then unsupported w sp "MVar I128/U128 payload requires a checked boxed-wide bridge; it is not lowered yet"
          else if is-val-class element then unsupported w sp val-refusal
          else if element > 2 || list-length givens /= 0 then unsupported w sp "MVar intrinsic needs its exact checked representation parameter"
          else let parameters = mvar-argument-classes operation element in
            let count = mvar-arity operation in let worker = specialized-name name [element] in
            (case expressions definitions locals (request-demand (MVarDemand name [element]) w) (take-terms count args) of
              (ready, values) -> if list-length values < count then closure sp worker parameters values ready else
                (case call ready (symbol worker) values of
                  (done, result) -> apply-terms definitions locals done result (drop-terms count args)))
        other -> unsupported w sp "MVar payload needs one checked runtime representation"
    None -> unsupported w sp "MVar operation is unavailable in the selected ABI"

  -- | Drop borrowed counted arguments after access while skipping values consumed on every outcome.
  mvar-drop-arguments :: Nat -> List Nat -> Nat -> Writer -> Writer
  mvar-drop-arguments operation classes index w = case classes of
    [] -> w
    first : rest -> mvar-drop-arguments operation rest (index + 1)
      (if first == 0 || mvar-consumes operation index then w else count-line False (cat ["%arg", nat-to-string index]) w)

  -- | Construct Option only from the canonical source family, loading output solely on success.
  mvar-option :: Writer -> Nat -> String -> String -> (Writer, String)
  mvar-option w element status output = let sp = Span 0 0 1 1 in
    case (constructor (global-data-core-some) (writer-program w), constructor (global-data-core-none) (writer-program w)) of
      (Some (owner, some-tag, some-constructor), Some (none-owner, none-tag, none-constructor)) ->
        if not (owner == global-data-core-option && owner == none-owner) || some-tag /= 1 || none-tag /= 0 || list-length (core-constructor-fields some-constructor) /= 1 || list-length (core-constructor-fields none-constructor) /= 0 then unsupported w sp "MVar result needs its checked Option declaration" else
        (case data-declaration owner (writer-program w) of
          Some d -> if list-length (core-data-constructors d) /= 2 || not (case core-constructor-fields some-constructor of [field] -> array-binder-field d field; other -> False) then unsupported w sp "MVar Option payload disagrees with its checked parameter" else
            (case request-data sp d [element] w of
              (planned, descriptor) ->
                let (one, failure) = fresh planned "mvarnone" in let (two, success) = fresh one "mvarsome" in
                let (three, end) = fresh two "mvardone" in let (four, slot) = fresh three "%ptr" in
                let (five, predicate) = fresh four "%v" in
                let split = line (line (line five (cat ["  ", slot, " = alloca i64"])) (cat ["  ", predicate, " = icmp eq i64 ", status, ", 0"])) (cat ["  br i1 ", predicate, ", label %", failure, ", label %", success]) in
                (case allocate (line split (cat [failure, ":"])) (data-descriptor descriptor none-tag) [] of
                  (absent, none) ->
                    let next = line (line (line absent (cat ["  store i64 ", none, ", ptr ", slot])) (cat ["  br label %", end])) (cat [success, ":"]) in
                    let (loaded, payload) = fresh next "%v" in
                    let read = line loaded (cat ["  ", payload, " = load i64, ptr ", output, ", align 8"]) in
                    (case allocate read (data-descriptor descriptor some-tag) [payload] of
                      (present, some) ->
                        let joined = line (line (line present (cat ["  store i64 ", some, ", ptr ", slot])) (cat ["  br label %", end])) (cat [end, ":"]) in
                        let (ready, value) = fresh joined "%v" in (line ready (cat ["  ", value, " = load i64, ptr ", slot]), value))))
          None -> unsupported w sp "MVar result has no defining Option family")
      other -> unsupported w sp "MVar result has no checked Option constructors"

  -- | Select the exact runtime access opcode without treating zero as an absent payload.
  mvar-runtime-operation :: Nat -> Nat
  mvar-runtime-operation operation = if operation == 2 || operation == 6 || operation == 10 then 0
    else if operation == 3 || operation == 7 || operation == 11 then 1
    else if operation == 4 || operation == 8 || operation == 12 then 2
    else if operation == 5 || operation == 13 then 3 else 4

  -- | Keep blocking, nonblocking and cooperative-cancellation modes distinct.
  mvar-runtime-mode :: Nat -> Nat
  mvar-runtime-mode operation = if operation >= 10 then 2
    else if operation == 6 || operation == 7 || operation == 8 || operation == 9 then 1 else 0

  atomic-runtime-extern :: Nat -> String
  atomic-runtime-extern operation =
    if operation == 20 then "@cinch_atomic_new"
    else if operation == 21 then "@cinch_atomic_load"
    else if operation == 22 then "@cinch_atomic_store"
    else if operation == 23 then "@cinch_atomic_swap"
    else if operation == 24 then "@cinch_atomic_fetch_add"
    else if operation == 25 then "@cinch_atomic_fetch_sub"
    else if operation == 26 then "@cinch_atomic_fetch_and"
    else if operation == 27 then "@cinch_atomic_fetch_or"
    else if operation == 28 then "@cinch_atomic_fetch_xor"
    else if operation == 29 then "@cinch_atomic_cas"
    else "@cinch_atomic_fence"

  -- | Lower word payloads with status separate from output and ownership retained on all paths.
  mvar-lower :: Writer -> Nat -> Nat -> (Writer, String)
  mvar-lower w operation element =
    if operation >= 20 then
      let args = value-parameters (mvar-arity operation) 0 in
      (case call w (atomic-runtime-extern operation) args of
        (done, result) -> if operation == 22 || operation == 30 then (done, "0") else (done, result))
    else if operation == 14 then call w "@cinch_rwlock_new" ["%arg0", nat-to-string element]
    else if operation >= 15 && operation <= 19 then
      let (one, output) = fresh w "%ptr" in let (two, status) = fresh one "%v" in
      let value = if mvar-arity operation == 2 then "%arg1" else "0" in
      let rw-op = operation - 15 in
      let access-line = cat ["  ", status, " = call i64 @cinch_rwlock_access(i64 %arg0, i64 ", value, ", i64 ", nat-to-string rw-op, ", ptr ", output, ")"] in
      let accessed = line (line two (cat ["  ", output, " = alloca i64, align 8"])) access-line in
      if operation == 18 then mvar-option accessed element status output
      else if operation == 19 then (accessed, status)
      else if operation == 16 then (accessed, "0") else
        let (ready, result) = fresh accessed "%v" in (line ready (cat ["  ", result, " = load i64, ptr ", output, ", align 8"]), result)
    else if operation == 0 || operation == 1 then call w "@cinch_mvar_new" [if operation == 0 then "%arg0" else "0", nat-to-string element, if operation == 0 then "1" else "0"]
    else
      let (one, output) = fresh w "%ptr" in let (two, status) = fresh one "%v" in
      let value = if mvar-arity operation == 2 then "%arg1" else "0" in
      let access-line = cat ["  ", status, " = call i64 @cinch_mvar_access(i64 %arg0, i64 ", value, ", i64 ", nat-to-string (mvar-runtime-operation operation), ", i64 ", nat-to-string (mvar-runtime-mode operation), ", ptr ", output, ")"] in
      let accessed = line (line two (cat ["  ", output, " = alloca i64, align 8"])) access-line in
      if mvar-optional operation then mvar-option accessed element status output
      else if operation == 7 || operation == 9 || operation == 11 then (accessed, status)
      else if operation == 3 then (accessed, "0") else
        let (ready, result) = fresh accessed "%v" in (line ready (cat ["  ", result, " = load i64, ptr ", output, ", align 8"]), result)

  -- | Emit a concrete MVar/RwLock/Atomic worker, with runtime-consumed inputs excluded from the final drops.
  mvar-worker :: String -> List Nat -> Writer -> Writer
  mvar-worker name classes w = case (mvar-plan name, classes) of
    (Some (operation, scheme), [element]) -> if element > 2 then refuse w (Span 0 0 1 1) "MVar I128/U128 payload requires a checked boxed-wide bridge; it is not lowered yet" else
      let parameters = mvar-argument-classes operation element in
      let worker = specialized-name name classes in
      let started = line (line w (cat ["define ", worker-linkage w worker, "i64 ", symbol worker, "(", join (argument-words (value-parameters (mvar-arity operation) 0)), ")", worker-open w])) "entry:" in
      (case mvar-lower started operation element of
        (made, result) -> let done = mvar-drop-arguments operation parameters 0 made in line (line done (cat ["  ret i64 ", result])) "}")
    other -> refuse w (Span 0 0 1 1) "MVar worker needs an available canonical operation and one checked payload class"

  builtin-known :: String -> Bool
  builtin-known name = machine-integer-builtin name || fast-bytes-builtin name || nat-arithmetic-builtin name || name == "b.newIO" || name == "b.ioWrite" || name == "b.ioRead" || name == "b.ioSleep" || name == "b.pollCancel" || name == "cinch.runtime.bytesNew" || name == "cinch.runtime.bytesLen" || name == "cinch.runtime.bytesGet" || name == "cinch.runtime.utf8Validate" || name == "cinch.runtime.utf8CountChars" || name == "cinch.runtime.textF64FromDecimal" || name == "cinch.runtime.textF64ToDecimal" || name == "cinch.runtime.slotsFoldNat" || (case platform-intrinsic name of Some plan -> True; None -> False)
  -- | Recognize only the closed scalar registry.
  machine-integer-builtin :: String -> Bool
  machine-integer-builtin name = (case scalar-intrinsic name of Some operation -> True; None -> False)
    || name == "cinch.prim.eqI64" || name == "cinch.prim.neI64" || (case wrapping-worker-plan name of Some plan -> True; None -> False)
  fast-bytes-builtin :: String -> Bool
  fast-bytes-builtin name = case fast-bytes-intrinsic name of Some found -> True; None -> False
  builtin-inline-attr :: String -> String
  builtin-inline-attr name =
    if machine-integer-builtin name || fast-bytes-builtin name
      || name == "cinch.runtime.bytesLen" || name == "cinch.runtime.bytesGet" then " alwaysinline"
    else ""
  builtin-result-llvm :: String -> String
  builtin-result-llvm name = case fast-bytes-intrinsic name of
    Some (scheme, operation) -> if operation == "loadU128" || operation == "loadU128At" then "i128" else "i64"
    None -> "i64"
  builtin-arguments-by-class :: List Nat -> List String -> List (String, String)
  builtin-arguments-by-class classes values = case (classes, values) of
    (c : cs, v : vs) -> (if c == 3 then "i128" else "i64", v) : (builtin-arguments-by-class cs vs)
    other -> []
  builtin-arguments :: String -> List String -> List (String, String)
  builtin-arguments name values = builtin-arguments-by-class (builtin-classes name) values
  wrapping-worker-plan :: String -> Option (String, Bool)
  wrapping-worker-plan name = case u32-wrapping-operation name of
    Some operation -> Some (operation, True)
    None -> if name == "cinch.prim.wrappingAddI64" then Some ("add", False)
      else if name == "cinch.prim.wrappingSubI64" then Some ("sub", False)
      else None
  wrapping-word-worker :: Writer -> String -> Bool -> (Writer, String)
  wrapping-word-worker w operation unsigned-narrow =
    let (ready, value) = fresh w "%v" in
    let computed = line ready (cat ["  ", value, " = ", operation, " i64 %arg0, %arg1"]) in
    if unsigned-narrow then
      (let (narrowed, result) = fresh computed "%v" in
       (line narrowed (cat ["  ", result, " = and i64 ", value, ", 4294967295"]), result))
    else (computed, value)
  nat-arithmetic-builtin :: String -> Bool
  nat-arithmetic-builtin name = case nat-arithmetic-extern name of Some external -> True; None -> False
  -- | Preserve the exact scalar arity and every established non-scalar ownership class.
  builtin-classes :: String -> List Nat
  builtin-classes name = case scalar-intrinsic name of
    Some operation -> scalar-argument-classes (operation.operation-arguments)
    None -> other-builtin-classes name
  -- | Retain one raw word per scalar argument, including unary and partially applied operations.
  scalar-argument-classes :: List ScalarShape -> List Nat
  scalar-argument-classes arguments = case arguments of [] -> []; first : rest -> 0 : (scalar-argument-classes rest)
  fast-bytes-classes :: String -> List Nat
  fast-bytes-classes operation =
    if operation == "lenI64" then [1]
    else if operation == "set" then [1, 2, 2]
    else if operation == "getU8" || operation == "loadLe32" || operation == "loadLe64" || operation == "loadU128" then [1, 2]
    else if operation == "getU8At" || operation == "loadLe32At" || operation == "loadLe64At" || operation == "loadU128At" then [1, 0]
    else if operation == "setU8" || operation == "storeLe32" || operation == "storeLe64" then [1, 2, 0]
    else if operation == "setU8At" || operation == "storeLe32At" || operation == "storeLe64At" then [1, 0, 0]
    else if operation == "storeU128" then [1, 2, 3]
    else [1, 0, 3]
  -- | Preserve the existing non-scalar ownership and argument conventions.
  other-builtin-classes :: String -> List Nat
  other-builtin-classes name = case fast-bytes-intrinsic name of
    Some (scheme, operation) -> fast-bytes-classes operation
    None -> if name == "cinch.runtime.slotsFoldNat" then [2]
            else if machine-integer-builtin name then [0, 0]
            else if nat-arithmetic-builtin name then [2, 2]
            else if name == "b.newIO" then [0]
            else if name == "b.ioWrite" then [0, 1]
            else if name == "b.ioRead" || name == "b.ioSleep" then [0, 2]
            else if name == "b.pollCancel" then [0, 0]
            else if name == "cinch.runtime.bytesGet" then [1, 2]
            else if name == "cinch.runtime.bytesNew" then [2]
            else if name == "cinch.runtime.textF64ToDecimal" then [0]
            else case platform-intrinsic name of
              Some (scheme, external, arguments, result) -> platform-classes arguments
              None -> [1]
  -- A Unit argument the extern does not take is still the worker's raw word.
  platform-classes :: List Nat -> List Nat
  platform-classes codes = case codes of [] -> []; code : rest -> (if code == 3 then 0 else if code == 4 then 2 else code) : (platform-classes rest)
  platform-arguments :: Writer -> List Nat -> Nat -> (Writer, List String)
  platform-arguments w codes index = case codes of
    [] -> (w, [])
    code : rest -> let argument = cat ["%arg", nat-to-string index] in
      (case (if code == 2 then call w "@cinch_nat_to_len" [argument] else (w, argument)) of
        (converted, value) -> case platform-arguments converted rest (index + 1) of
          (done, values) -> (done, if code == 3 then values else value : values))
  -- The externs borrow their Bytes and Nat arguments; the worker owns them.
  platform-drops :: Writer -> List Nat -> Nat -> Writer
  platform-drops w codes index = case codes of
    [] -> w
    code : rest -> platform-drops (if code == 1 || code == 2 || code == 4 then count-line False (cat ["%arg", nat-to-string index]) w else w) rest (index + 1)
  platform-worker :: Writer -> String -> List Nat -> Nat -> (Writer, String)
  platform-worker w external codes result = platform-worker-ex w external codes result True
  platform-worker-ex :: Writer -> String -> List Nat -> Nat -> Bool -> (Writer, String)
  platform-worker-ex w external codes result drop-args = case platform-arguments w codes 0 of
    (converted, values) -> case call converted (cat ["@", external]) values of
      (called, raw) -> let dropped = if drop-args then platform-drops called codes 0 else called in
        if result == 0 then (dropped, raw)
        else if result == 1 then call dropped "@cinch_nat_from_i64" [raw]
        else platform-result dropped raw result
  result-binder-fields :: CoreData -> CoreConstructor -> CoreConstructor -> Bool
  result-binder-fields d failure success = case (core-data-params d, core-constructor-fields failure, core-constructor-fields success) of
    ([first, second], [UBound failure-id failure-name KType], [UBound success-id success-name KType]) ->
      first.id == failure-id && second.id == success-id && kind-equal (first.kind) KType && kind-equal (second.kind) KType
    other -> False
  -- The prelude `Result I64 a` a boundary word stands for: a negative word
  -- is `Err` over its positive code, any other word is `Ok` over the payload
  -- its result code names (platform-intrinsic).
  platform-result :: Writer -> String -> Nat -> (Writer, String)
  platform-result w raw result = let sp = Span 0 0 1 1 in
    case (constructor (global-data-core-err) (writer-program w), constructor (global-data-core-ok) (writer-program w)) of
      (Some (owner, err-tag, err-constructor), Some (ok-owner, ok-tag, ok-constructor)) ->
        if not (owner == global-data-core-result && owner == ok-owner) || err-tag /= 0 || ok-tag /= 1 then unsupported w sp "runtime result needs its checked Result declaration" else
        (case data-declaration owner (writer-program w) of
          Some d -> if list-length (core-data-constructors d) /= 2 || not (result-binder-fields d err-constructor ok-constructor) then unsupported w sp "runtime Result fields disagree with their checked parameters" else
            (case request-data sp d [0, if result == 3 then 2 else if result == 4 then 1 else 0] w of
              (planned, descriptor) ->
                let (one, failure) = fresh planned "resulterr" in let (two, success) = fresh one "resultok" in
                let (three, end) = fresh two "resultdone" in let (four, slot) = fresh three "%ptr" in
                let (five, negative) = fresh four "%v" in let (six, code) = fresh five "%v" in
                let split = emit-lines six [cat ["  ", slot, " = alloca i64"], cat ["  ", negative, " = icmp slt i64 ", raw, ", 0"],
                  cat ["  br i1 ", negative, ", label %", failure, ", label %", success], cat [failure, ":"], cat ["  ", code, " = sub i64 0, ", raw]] in
                case allocate split (data-descriptor descriptor err-tag) [code] of
                  (failed, err-word) -> let next = emit-lines failed [cat ["  store i64 ", err-word, ", ptr ", slot], cat ["  br label %", end], cat [success, ":"]] in
                    case (if result == 3 then call next "@cinch_nat_from_i64" [raw] else (next, if result == 5 then "0" else raw)) of
                      (ready, payload) -> case allocate ready (data-descriptor descriptor ok-tag) [payload] of
                        (succeeded, value) -> let joined = emit-lines succeeded [cat ["  store i64 ", value, ", ptr ", slot], cat ["  br label %", end], cat [end, ":"]] in
                          let (done, loaded) = fresh joined "%v" in (line done (cat ["  ", loaded, " = load i64, ptr ", slot]), loaded))
          None -> unsupported w sp "runtime result has no defining Result family")
      other -> unsupported w sp "runtime result has no checked Result constructors"
  bytes-borrowable-builtin :: String -> Bool
  bytes-borrowable-builtin name = fast-bytes-builtin name || name == "cinch.runtime.bytesLen" || name == "cinch.runtime.bytesGet"
  false-flags :: Nat -> List Bool
  false-flags n = if n == 0 then [] else False : (false-flags (n - 1))
  builtin-borrow-mask :: String -> Nat -> Option (List Bool)
  builtin-borrow-mask name count =
    if bytes-borrowable-builtin name && count >= 1 then Some (True : (false-flags (count - 1)))
    else if name == "cinch.runtime.bytesCompare" && count == 2 then Some [True, True]
    else if (name == "cinch.runtime.utf8Validate" || name == "cinch.runtime.utf8CountChars") && count == 1 then Some [True]
    else if name == "cinch.runtime.natToI64" && count == 1 then Some [True]
    else case nat-arithmetic-extern name of
      Some ext | count == 2 -> Some [True, True]
      other -> None
  any-borrowed-local :: List Local -> List CoreTerm -> List Bool -> Bool
  any-borrowed-local locals args mask = case (args, mask) of
    (arg : rest, True : more) -> (case borrowed-local-word locals arg of Some w -> True; None -> any-borrowed-local locals rest more)
    (arg : rest, False : more) -> any-borrowed-local locals rest more
    other -> False
  builtin-call :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List UType -> List String -> List CoreTerm -> (Writer, String)
  builtin-call definitions locals w sp name actuals givens args =
    let classes = builtin-classes name in
    let count = list-length classes in
    let supplied = list-length givens in
    if supplied > count then unsupported w sp "builtin context exceeds its checked ABI arity"
    else if supplied == 0 && count >= 1 && list-length args >= count then
      (case builtin-borrow-mask name count of
        Some mask | any-borrowed-local locals (take-terms count args) mask ->
          let prepared = request-demand (BuiltinBorrowDemand name) w in
          (case eval-borrow-args definitions locals prepared (take-terms count args) mask of
            (ready, values, post-drops) -> case typed-call ready (builtin-result-llvm name) (symbol (cat [name, "#borrow"])) (builtin-arguments name values) of
              (called, result) -> apply-terms definitions locals (drop-locals post-drops called) result (drop-terms count args))
        other -> builtin-call-owned definitions locals w sp name classes count supplied givens args)
    else builtin-call-owned definitions locals w sp name classes count supplied givens args
  builtin-call-owned :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List Nat -> Nat -> Nat -> List String -> List CoreTerm -> (Writer, String)
  builtin-call-owned definitions locals w sp name classes count supplied givens args =
    if supplied > count then unsupported w sp "builtin context exceeds its checked ABI arity" else
    let prepared = request-demand (BuiltinDemand name) w in
    let missing = count - supplied in
    (case expressions definitions locals prepared (take-terms missing args) of
      (ready, values) -> let all = givens <> values in
        if list-length all < list-length classes then closure sp name classes all ready else
          (case typed-call ready (builtin-result-llvm name) (symbol name) (builtin-arguments name all) of
            (done, result) -> apply-terms definitions locals done result (drop-terms missing args)))
  -- | Inline fast path for decoding a tagged immediate Nat to i64 (odd word >> 1), falling back to cinch_nat_to_len.
  nat-to-i64-fast :: Writer -> String -> (Writer, String)
  nat-to-i64-fast w word =
    let (w1, tag) = fresh w "%v" in let (w2, is-imm) = fresh w1 "%v" in
    let (w3, fast-l) = fresh w2 "nfast" in let (w4, slow-l) = fresh w3 "nslow" in let (w5, done-l) = fresh w4 "ndone" in
    let (w6, fast-v) = fresh w5 "%v" in let (w7, slow-v) = fresh w6 "%v" in let (w8, res) = fresh w7 "%v" in
    (emit-lines w8 [
      cat ["  ", tag, " = and i64 ", word, ", 1"],
      cat ["  ", is-imm, " = icmp ne i64 ", tag, ", 0"],
      cat ["  br i1 ", is-imm, ", label %", fast-l, ", label %", slow-l, ", !prof !6"],
      cat [fast-l, ":"],
      cat ["  ", fast-v, " = lshr i64 ", word, ", 1"],
      cat ["  br label %", done-l],
      cat [slow-l, ":"],
      cat ["  ", slow-v, " = call i64 @cinch_nat_to_len(i64 ", word, ") cold"],
      cat ["  br label %", done-l],
      cat [done-l, ":"],
      cat ["  ", res, " = phi i64 [ ", fast-v, ", %", fast-l, " ], [ ", slow-v, ", %", slow-l, " ]"]], res)
  -- | Inline fast path for encoding a nonnegative i64 count as a tagged immediate Nat.
  nat-from-i64-fast :: Writer -> String -> Bool -> (Writer, String)
  nat-from-i64-fast w value small-only =
    if small-only then
      let (w1, sh) = fresh w "%v" in let (w2, res) = fresh w1 "%v" in
      (emit-lines w2 [cat ["  ", sh, " = shl i64 ", value, ", 1"], cat ["  ", res, " = or i64 ", sh, ", 1"]], res)
    else
      let (w1, fits) = fresh w "%v" in let (w2, fast-l) = fresh w1 "nffast" in
      let (w3, slow-l) = fresh w2 "nfslow" in let (w4, done-l) = fresh w3 "nfdone" in
      let (w5, sh) = fresh w4 "%v" in let (w6, fast-v) = fresh w5 "%v" in
      let (w7, slow-v) = fresh w6 "%v" in let (w8, res) = fresh w7 "%v" in
      (emit-lines w8 [
        cat ["  ", fits, " = icmp ule i64 ", value, ", 4611686018427387903"],
        cat ["  br i1 ", fits, ", label %", fast-l, ", label %", slow-l, ", !prof !6"],
        cat [fast-l, ":"],
        cat ["  ", sh, " = shl i64 ", value, ", 1"],
        cat ["  ", fast-v, " = or i64 ", sh, ", 1"],
        cat ["  br label %", done-l],
        cat [slow-l, ":"],
        cat ["  ", slow-v, " = call i64 @cinch_nat_from_i64(i64 ", value, ") cold"],
        cat ["  br label %", done-l],
        cat [done-l, ":"],
        cat ["  ", res, " = phi i64 [ ", fast-v, ", %", fast-l, " ], [ ", slow-v, ", %", slow-l, " ]"]], res)
  -- | Inline fast Bytes access with !invariant.load, !tbaa, !prof, cold slow-path + unreachable, and optional arg0 RC drop.
  bytes-access-worker :: Writer -> String -> (Writer, String)
  bytes-access-worker w op = bytes-access-worker-ex w op True
  bytes-access-worker-ex :: Writer -> String -> Bool -> (Writer, String)
  bytes-access-worker-ex w op drop-buf =
    let is-len = op == "len" || op == "lenI64" in
    let is-write = (op == "set" || op == "setU8" || op == "setU8At"
      || op == "storeLe32" || op == "storeLe32At"
      || op == "storeLe64" || op == "storeLe64At"
      || op == "storeU128" || op == "storeU128At") in
    let nat-idx = (op == "get" || op == "set" || op == "getU8" || op == "setU8"
      || op == "loadLe32" || op == "storeLe32"
      || op == "loadLe64" || op == "storeLe64"
      || op == "loadU128" || op == "storeU128") in
    let width = (if is-len then (0 :: Nat)
      else if op == "loadLe32" || op == "loadLe32At" || op == "storeLe32" || op == "storeLe32At" then 4
      else if op == "loadLe64" || op == "loadLe64At" || op == "storeLe64" || op == "storeLe64At" then 8
      else if op == "loadU128" || op == "loadU128At" || op == "storeU128" || op == "storeU128At" then 16
      else 1) in
    let check-kind = is-write || op == "len" || op == "get" in
    let (w0, idx-word) = if is-len then (w, "") else if nat-idx then nat-to-i64-fast w "%arg1" else (w, "%arg1") in
    let (w1, val-word) = if op == "set" then nat-to-i64-fast w0 "%arg2" else (w0, "%arg2") in
    let (w2, payload-l) = fresh w1 "bpay" in let (w3, slow-l) = fresh w2 "bslow" in
    let (w4, is-null) = fresh w3 "%v" in
    let (w5, payload) = (if check-kind then
      let (a0, hdr-l) = fresh w4 "bhdr" in let (a1, p) = fresh a0 "%ptr" in
      let (a2, hp) = fresh a1 "%ptr" in let (a3, hdr) = fresh a2 "%v" in
      let (a4, sh) = fresh a3 "%v" in let (a5, kind) = fresh a4 "%v" in
      let base = emit-lines a5 [
        cat ["  ", is-null, " = icmp eq i64 %arg0, 0"],
        cat ["  br i1 ", is-null, ", label %", slow-l, ", label %", hdr-l, ", !prof !7"],
        cat [hdr-l, ":"],
        cat ["  ", p, " = inttoptr i64 %arg0 to ptr"],
        cat ["  ", hp, " = getelementptr i8, ptr ", p, ", i64 -8"],
        cat ["  ", hdr, if program-concurrent (writer-program w4) then " = load atomic i64, ptr " else " = load i64, ptr ", hp, if program-concurrent (writer-program w4) then " monotonic, align 8" else ", align 8"],
        cat ["  ", sh, " = lshr i64 ", hdr, ", 35"],
        cat ["  ", kind, " = and i64 ", sh, ", 31"]] in
      if is-write then
        let (b0, ok) = fresh base "%v" in
        (emit-lines b0 [
          cat ["  ", ok, " = icmp eq i64 ", kind, ", 8"],
          cat ["  br i1 ", ok, ", label %", payload-l, ", label %", slow-l, ", !prof !6"],
          cat [payload-l, ":"]], p)
      else
        let (b0, d1) = fresh base "%v" in let (b1, ok1) = fresh b0 "%v" in
        let (b2, d2) = fresh b1 "%v" in let (b3, ok2) = fresh b2 "%v" in let (b4, ok) = fresh b3 "%v" in
        (emit-lines b4 [
          cat ["  ", d1, " = sub i64 ", kind, ", 8"],
          cat ["  ", ok1, " = icmp ule i64 ", d1, ", 1"],
          cat ["  ", d2, " = sub i64 ", kind, ", 19"],
          cat ["  ", ok2, " = icmp ule i64 ", d2, ", 1"],
          cat ["  ", ok, " = or i1 ", ok1, ", ", ok2],
          cat ["  br i1 ", ok, ", label %", payload-l, ", label %", slow-l, ", !prof !6"],
          cat [payload-l, ":"]], p)
    else
      let (a0, p) = fresh w4 "%ptr" in
      (emit-lines a0 [
        cat ["  ", is-null, " = icmp eq i64 %arg0, 0"],
        cat ["  br i1 ", is-null, ", label %", slow-l, ", label %", payload-l, ", !prof !7"],
        cat [payload-l, ":"],
        cat ["  ", p, " = inttoptr i64 %arg0 to ptr"]], p)) in
    let (w6, blen) = fresh w5 "%v" in
    let w7 = line w6 (cat ["  ", blen, " = load i64, ptr ", payload, ", align 8, !tbaa !3, !range !8"]) in
    let w8 = (if is-len then w7 else
      let (c0, access-l) = fresh w7 "bacc" in
      let (c1, in-range) = (if width == 1 then
        let (d0, cmp) = fresh c0 "%v" in
        (line d0 (cat ["  ", cmp, " = icmp ult i64 ", idx-word, ", ", blen]), cmp)
      else
        let (d0, fits) = fresh c0 "%v" in let (d1, lim) = fresh d0 "%v" in
        let (d2, le) = fresh d1 "%v" in let (d3, both) = fresh d2 "%v" in
        (emit-lines d3 [
          cat ["  ", fits, " = icmp sge i64 ", blen, ", ", nat-to-string width],
          cat ["  ", lim, " = sub i64 ", blen, ", ", nat-to-string width],
          cat ["  ", le, " = icmp ule i64 ", idx-word, ", ", lim],
          cat ["  ", both, " = and i1 ", fits, ", ", le]], both)) in
      let (c2, valid) = (if op == "set" then
        let (d0, bv) = fresh c1 "%v" in let (d1, both) = fresh d0 "%v" in
        (emit-lines d1 [cat ["  ", bv, " = icmp ule i64 ", val-word, ", 255"], cat ["  ", both, " = and i1 ", in-range, ", ", bv]], both)
      else (c1, in-range)) in
      emit-lines c2 [cat ["  br i1 ", valid, ", label %", access-l, ", label %", slow-l, ", !prof !6"], cat [access-l, ":"]]) in
    let (w9, result) = (if is-len then (w8, blen) else
      let (e0, data-at) = fresh w8 "%ptr" in let (e1, dptr) = fresh e0 "%ptr" in let (e2, at) = fresh e1 "%ptr" in
      let ptr-align = if program-wasm32 (writer-program e2) then "4" else "8" in
      let loaded-ptr = emit-lines e2 [
        cat ["  ", data-at, " = getelementptr i8, ptr ", payload, ", i64 8"],
        cat ["  ", dptr, " = load ptr, ptr ", data-at, ", align ", ptr-align, ", !tbaa !3"],
        cat ["  ", at, " = getelementptr i8, ptr ", dptr, ", i64 ", idx-word]] in
      if is-write then
        if width == 1 then
          let (f0, b8) = fresh loaded-ptr "%v" in
          (emit-lines f0 [cat ["  ", b8, " = trunc i64 ", val-word, " to i8"], cat ["  store i8 ", b8, ", ptr ", at, ", align 1, !tbaa !5"]], "0")
        else if width == 4 then
          let (f0, b32) = fresh loaded-ptr "%v" in
          (emit-lines f0 [cat ["  ", b32, " = trunc i64 ", val-word, " to i32"], cat ["  store i32 ", b32, ", ptr ", at, ", align 1, !tbaa !5"]], "0")
        else if width == 8 then
          (line loaded-ptr (cat ["  store i64 ", val-word, ", ptr ", at, ", align 1, !tbaa !5"]), "0")
        else
          (line loaded-ptr (cat ["  store i128 ", val-word, ", ptr ", at, ", align 1, !tbaa !5"]), "0")
      else
        if width == 1 then
          let (f0, b8) = fresh loaded-ptr "%v" in let (f1, fr) = fresh f0 "%v" in let (f2, ext) = fresh f1 "%v" in
          (emit-lines f2 [cat ["  ", b8, " = load i8, ptr ", at, ", align 1, !tbaa !5"], cat ["  ", fr, " = freeze i8 ", b8], cat ["  ", ext, " = zext i8 ", fr, " to i64"]], ext)
        else if width == 4 then
          let (f0, b32) = fresh loaded-ptr "%v" in let (f1, fr) = fresh f0 "%v" in let (f2, ext) = fresh f1 "%v" in
          (emit-lines f2 [cat ["  ", b32, " = load i32, ptr ", at, ", align 1, !tbaa !5"], cat ["  ", fr, " = freeze i32 ", b32], cat ["  ", ext, " = zext i32 ", fr, " to i64"]], ext)
        else if width == 8 then
          let (f0, b64) = fresh loaded-ptr "%v" in let (f1, fr) = fresh f0 "%v" in
          (emit-lines f1 [cat ["  ", b64, " = load i64, ptr ", at, ", align 1, !tbaa !5"], cat ["  ", fr, " = freeze i64 ", b64]], fr)
        else
          let (f0, b128) = fresh loaded-ptr "%v" in let (f1, fr) = fresh f0 "%v" in
          (emit-lines f1 [cat ["  ", b128, " = load i128, ptr ", at, ", align 1, !tbaa !5"], cat ["  ", fr, " = freeze i128 ", b128]], fr)) in
    let (w10, done-l) = fresh w9 "bdone" in
    let (w11, slow-r) = fresh w10 "%v" in
    let slow-call = (if is-len then cat ["  ", slow-r, " = call i64 @cinch_bytes_len(i64 %arg0) cold"]
      else if is-write then
        let si = if width > 1 then "-1" else idx-word in
        let sv = if width > 1 then "0" else val-word in
        cat ["  ", slow-r, " = call i64 @cinch_bytes_set(i64 %arg0, i64 ", si, ", i64 ", sv, ") cold"]
      else
        let si = if width > 1 then "-1" else idx-word in
        cat ["  ", slow-r, " = call i64 @cinch_bytes_get(i64 %arg0, i64 ", si, ") cold"]) in
    let with-slow = emit-lines w11 [cat ["  br label %", done-l], cat [slow-l, ":"], slow-call, "  unreachable", cat [done-l, ":"]] in
    let dropped0 = if drop-buf then count-line False "%arg0" with-slow else with-slow in
    let dropped1 = if nat-idx then count-line False "%arg1" dropped0 else dropped0 in
    let dropped2 = if op == "set" then count-line False "%arg2" dropped1 else dropped1 in
    if op == "len" then nat-from-i64-fast dropped2 result False
    else if op == "get" then nat-from-i64-fast dropped2 result True
    else (dropped2, result)
  -- | Emit a private alwaysinline borrowed builtin worker without RC traffic on borrowed args.
  utf8-validate-worker-ex :: Writer -> Bool -> (Writer, String)
  utf8-validate-worker-ex w drop-arg =
    case call w "@cinch_bytes_data" ["%arg0"] of
      (w1, ptr) -> case call w1 "@cinch_bytes_len" ["%arg0"] of
        (w2, len) -> case call w2 "@cinch_utf8_validate" [ptr, len] of
          (w3, res) -> (if drop-arg then count-line False "%arg0" w3 else w3, res)
  utf8-count-chars-worker-ex :: Writer -> Bool -> (Writer, String)
  utf8-count-chars-worker-ex w drop-arg =
    case call w "@cinch_bytes_data" ["%arg0"] of
      (w1, ptr) -> case call w1 "@cinch_bytes_len" ["%arg0"] of
        (w2, len) -> case call w2 "@cinch_utf8_count_chars" [ptr, len] of
          (w3, count) ->
            let w4 = if drop-arg then count-line False "%arg0" w3 else w3 in
            let (w5, bad) = fresh w4 "%v" in
            let (w6, ok-l) = fresh w5 "u8ok" in
            let (w7, err-l) = fresh w6 "u8err" in
            let branched = emit-lines w7 [
              cat ["  ", bad, " = icmp slt i64 ", count, ", 0"],
              cat ["  br i1 ", bad, ", label %", err-l, ", label %", ok-l, ", !prof !7"],
              cat [err-l, ":"],
              "  call void @cinch_blackhole()",
              "  unreachable",
              cat [ok-l, ":"]] in
            call branched "@cinch_nat_from_i64" [count]
  builtin-result-attr :: String -> String
  builtin-result-attr name =
    if name == "cinch.runtime.bytesLenI64" then "range(i64 0, 9223372036854775807) "
    else if name == "cinch.runtime.bytesGetU8" || name == "cinch.runtime.bytesGetU8At" then "range(i64 0, 256) "
    else if name == "cinch.runtime.bytesLoadLe32" || name == "cinch.runtime.bytesLoadLe32At" then "range(i64 0, 4294967296) "
    else ""
  builtin-borrow-worker :: String -> Writer -> Writer
  builtin-borrow-worker name w =
    let classes = builtin-classes name in
    let bname = cat [name, "#borrow"] in
    let started = line (line w (cat ["define private ", builtin-result-attr name, builtin-result-llvm name, " ", symbol bname, "(", join (typed-arguments (builtin-arguments name (value-parameters (list-length classes) 0))), ") alwaysinline", worker-open w])) "entry:" in
    let lowered = (if fast-bytes-builtin name then (case fast-bytes-intrinsic name of
        Some (scheme, operation) -> bytes-access-worker-ex started operation False
        None -> unsupported started (Span 0 0 1 1) "checked borrowed Bytes worker has no operation")
      else if name == "cinch.runtime.bytesLen" then bytes-access-worker-ex started "len" False
      else if name == "cinch.runtime.bytesGet" then bytes-access-worker-ex started "get" False
      else if name == "cinch.runtime.utf8Validate" then utf8-validate-worker-ex started False
      else if name == "cinch.runtime.utf8CountChars" then utf8-count-chars-worker-ex started False
      else case platform-intrinsic name of
        Some (scheme, external, arguments, result) -> platform-worker-ex started external arguments result False
        None -> case nat-arithmetic-extern name of
          Some external -> call started (cat ["@", external]) ["%arg0", "%arg1"]
          None -> unsupported started (Span 0 0 1 1) "checked borrowed worker is not a supported read-only builtin") in
    case lowered of (done, value) -> line (line done (cat ["  ret ", builtin-result-llvm name, " ", value])) "}"
  -- | Emit a checked intrinsic worker without importing executable text from interface metadata.
  builtin-worker :: String -> Writer -> Writer
  builtin-worker name w =
    let classes = builtin-classes name in
    let started = line (line w (cat ["define ", worker-linkage w name, builtin-result-attr name, builtin-result-llvm name, " ", symbol name, "(", join (typed-arguments (builtin-arguments name (value-parameters (list-length classes) 0))), ")", builtin-inline-attr name, worker-open w])) "entry:" in
    let lowered = (if name == "b.newIO" then (started, "0")
      else if fast-bytes-builtin name then (case fast-bytes-intrinsic name of
        Some (scheme, operation) -> bytes-access-worker started operation
        None -> unsupported started (Span 0 0 1 1) "checked Bytes worker has no operation")
      else if (case scalar-intrinsic name of Some operation -> True; None -> False) then
        (case scalar-intrinsic name of
          Some operation -> scalar-intrinsic-worker started operation
          None -> unsupported started (Span 0 0 1 1) "checked scalar worker has no operation")
      else if name == "cinch.prim.eqI64" then compare-word started "eq" "%arg0" "%arg1"
      else if name == "cinch.prim.neI64" then compare-word started "ne" "%arg0" "%arg1"
      else if machine-integer-builtin name then
        (case wrapping-worker-plan name of
          Some (operation, unsigned-narrow) -> wrapping-word-worker started operation unsigned-narrow
          None -> unsupported started (Span 0 0 1 1) "checked machine worker has no wrapping operation")
      else if name == "b.ioWrite" then (case call started "@cinch_io_write" ["%arg1"] of (done, result) -> (count-line False "%arg1" done, "0"))
      else if name == "b.ioRead" then (case call started "@cinch_nat_to_len" ["%arg1"] of
        (converted, length) -> case call converted "@cinch_io_read" [length] of
          (read, bytes) -> case compare-word (count-line False "%arg1" read) "eq" bytes "0" of
            (checked, absent) -> array-option checked (Span 0 0 1 1) 1 absent "" [bytes])
      else if name == "b.ioSleep" then (case call started "@cinch_nat_to_len" ["%arg1"] of
        (converted, length) -> case call converted "@cinch_io_sleep" [length] of (done, result) -> (count-line False "%arg1" done, "0"))
      else if name == "b.pollCancel" then call started "@cinch_task_poll_cancel" []
      else if name == "cinch.runtime.bytesNew" then (case call started "@cinch_nat_to_len" ["%arg0"] of
        (converted, length) -> case call converted "@cinch_bytes_new" [length] of (done, result) -> (count-line False "%arg0" done, result))
      else if name == "cinch.runtime.bytesLen" then bytes-access-worker started "len"
      else if name == "cinch.runtime.bytesGet" then bytes-access-worker started "get"
      else if name == "cinch.runtime.utf8Validate" then utf8-validate-worker-ex started True
      else if name == "cinch.runtime.utf8CountChars" then utf8-count-chars-worker-ex started True
      else if name == "cinch.runtime.textF64ToDecimal" then
        (let (one, value) = fresh started "%float" in
         let converted = line one (cat ["  ", value, " = bitcast i64 %arg0 to double"]) in
         let (two, result) = fresh converted "%v" in
         (line two (cat ["  ", result, " = call i64 @cinch_text_f64_to_decimal(double ", value, ")"]), result))
      else if name == "cinch.runtime.slotsFoldNat" then (case call started "@cinch_nat_low_word" ["%arg0"] of
        (done, result) -> (line done (count-call False "%arg0"), result))
      else if name == "cinch.runtime.textF64FromDecimal" then
        (let (one, value) = fresh started "%float" in
         let decoded = line one (cat ["  ", value, " = call double @cinch_text_f64_from_decimal(i64 %arg0)"]) in
         let (two, result) = fresh (count-line False "%arg0" decoded) "%v" in
         (line two (cat ["  ", result, " = bitcast double ", value, " to i64"]), result))
      else case platform-intrinsic name of
        Some (scheme, external, arguments, result) -> platform-worker started external arguments result
        None -> case nat-arithmetic-extern name of
          Some external -> case call started (cat ["@", external]) ["%arg0", "%arg1"] of
            (done, result) ->
              let nat = UCon "Nat" KType in
              (count-op False nat "%arg1" (count-op False nat "%arg0" done), result)
          None -> bytes-access-worker started "len") in
    case lowered of (done, result) -> line (line done (cat ["  ret ", builtin-result-llvm name, " ", result])) "}"
  box-constructor :: List CoreDefinition -> List Local -> Writer -> Span -> CoreData -> List Nat -> Nat -> List CoreTerm -> (Writer, String)
  box-constructor definitions locals w sp d classes tag args = case request-data sp d classes w of
    (planned, descriptor) -> case expressions definitions locals planned args of
      (ready, values) -> allocate-constructor-fields d ready (data-descriptor descriptor tag) (term-types args) values
  box-gadt-constructor :: List CoreDefinition -> List Local -> Writer -> Span -> CoreData -> RuntimeContext -> CoreConstructor -> Nat -> List CoreTerm -> (Writer, String)
  box-gadt-constructor definitions locals w sp d cctx c tag args = case class-vector cctx (storage-fields d c) of
    None -> unsupported w sp "constructor field representation is unknown"
    Some codes ->
      let desc = shape-description 1 tag (word-codes codes) in
      case expressions definitions locals w args of
        (ready, values) -> allocate-constructor-fields d ready desc (term-types args) values

  allocate-constructor-fields :: CoreData -> Writer -> Nat -> List UType -> List String -> (Writer, String)
  allocate-constructor-fields d w descriptor tys values = case core-data-layout d of
    UnpackedRecord slots -> allocate-constructor d w descriptor (typed-values (value-llvms (w.context) tys) values)
    TransparentData label bytes align | bytes < 8 -> allocate-constructor d w descriptor (typed-values (value-llvms (w.context) tys) values)
    other -> allocate-typed-fields w descriptor tys values
  allocate-constructor :: CoreData -> Writer -> Nat -> List (String, String) -> (Writer, String)
  allocate-constructor d w descriptor values = case core-data-layout d of
    UnpackedRecord slots -> (case flatten-values slots values w of (ready, physical) -> allocate-typed ready descriptor physical)
    TransparentData label bytes align | bytes < 8 -> (case values of
      [(_, value)] -> let (one, ptr) = fresh w "%ptr" in
        let allocated = shaped-allocation one ptr (nat-to-string bytes) 1 descriptor in
        let filled = (if bytes == 0 then allocated else
          let ty = "i" <> nat-to-string (8 * bytes) in
          let (two, bits) = fresh allocated "%v" in
          line (line two (cat ["  ", bits, " = trunc i64 ", value, " to ", ty])) (cat ["  store ", ty, " ", bits, ", ptr ", ptr, ", align ", nat-to-string align])) in
        let (done, result) = fresh filled "%v" in
        (line done (cat ["  ", result, " = ptrtoint ptr ", ptr, " to i64"]), result)
      other -> unsupported w (Span 0 0 1 1) "transparent constructor lacks its checked field")
    other -> allocate-typed w descriptor values
  -- The source constructor consumes every argument. A flattened product
  -- transfers one owned reference per slot before releasing its old block.
  flatten-values :: List RecordSlot -> List (String, String) -> Writer -> (Writer, List (String, String))
  flatten-values slots values w = case (slots, values) of
    ([], []) -> (w, [])
    ((OrdinarySlot label ty) : more, value : rest) -> (case flatten-values more rest w of
      (ready, tail) -> (ready, value : tail))
    ((ProductSlot label ty ctor args fields) : more, (llvm, word) : rest) ->
      let (one, ptr) = fresh w "%ptr" in
      (case owned-payload fields ptr 0 (line one (cat ["  ", ptr, " = inttoptr i64 ", word, " to ptr"])) of
        (loaded, physical) -> case flatten-values more rest (count-op False ty word loaded) of
          (ready, tail) -> (ready, physical <> tail))
    other -> (refuse w (Span 0 0 1 1) "logical constructor arity disagrees with unpack layout", [])
  owned-payload :: List UType -> String -> Nat -> Writer -> (Writer, List (String, String))
  owned-payload fields pointer index w = case fields of
    [] -> (w, [])
    ty : rest -> case read-slot ty pointer index w of
      (loaded, llvm, value, next) -> case owned-payload rest pointer next (count-op True ty value loaded) of
        (ready, more) -> (ready, (llvm, value) : more)

  direct-call :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List UType -> List CoreTerm -> (Writer, String)
  direct-call definitions locals w sp name actuals args = call-name definitions locals w sp name actuals [] args
  call-name :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List UType -> List String -> List CoreTerm -> (Writer, String)
  call-name definitions locals w sp name actuals givens args = if (case program-foreign-binding name (writer-program w) of Some plan -> True; None -> False) then foreign-call definitions locals w sp name givens args else if (case mvar-plan name of Some plan -> True; None -> False) then mvar-call definitions locals w sp name actuals givens args else if (case array-plan name of Some plan -> True; None -> False) then array-call definitions locals w sp name actuals givens args else if builtin-known name then builtin-call definitions locals w sp name actuals givens args else
    case instance-named name ((writer-program w).instances) of
      Some factory -> case scheme-classes (w.context) (scheme-params (factory.scheme)) actuals of
        Some classes -> if (case args of [] -> True; other -> False) && list-length givens == list-length (scheme-requirements (factory.scheme)) then
          call (request-demand (DictionaryDemand name classes) w) (symbol-for-dictionary name classes) givens else unsupported w sp "factory constructor arguments disagree with its checked context"
        None -> unsupported w sp "factory needs runtime representation specialization"
      None -> case constructor name (writer-program w) of
        Some (owner, tag, c) -> case data-declaration owner (writer-program w) of
          Some d -> case source-scheme-classes (w.context) (scheme-params (c.constructor-scheme)) actuals of
            None -> unsupported w sp "constructor parameters need runtime representation classes"
            Some classes -> case constructor-call-context d c classes w of
              None -> unsupported w sp "constructor parameters need first-order representation classes"
              Some context -> if list-length args == list-length (core-constructor-fields c) then
                (case (core-data-layout d, args) of
                  (UnboxedData label word bytes align, [payload]) -> expression definitions locals w payload
                  (ValueData repr sz al vfields, actuals-args) -> construct-value-data definitions locals w sz al vfields actuals-args
                  other -> if regular-constructor d c
                    then box-constructor definitions locals w sp d classes tag args
                    else box-gadt-constructor definitions locals w sp d context c tag args)
                else if list-length args < list-length (core-constructor-fields c) then
                  (case class-vector context (core-constructor-fields c) of
                    Some parameters -> case expressions definitions locals (request-demand (ConstructorDemand name classes) w) args of
                      (ready, values) -> closure-with sp (specialized-name name classes) parameters 0 (term-types args) values ready
                    None -> unsupported w sp "constructor fields need known closure parameter representations")
                else unsupported w sp "constructor application exceeds its checked arity"
          None -> unsupported w sp "constructor has no defining runtime declaration"
        None -> case worker-definition name w of
          Some d -> case source-scheme-classes (w.context) (scheme-params (d.scheme)) actuals of
            Some classes -> case inline-call definitions locals w sp d classes givens args of
              Some copied -> copied
              None -> function-call definitions locals w sp d actuals classes givens args
            None -> unsupported w sp "function parameters need first-order or erased representation classes"
          None -> external-call definitions locals w sp name actuals givens args
  foreign-parameter-types :: List ForeignParameter -> List String
  foreign-parameter-types params = case params of
    [] -> []
    first : rest -> if first.class == "unit" then foreign-parameter-types rest else (foreign-llvm-type first) : (foreign-parameter-types rest)
  -- A narrow integer crosses the C boundary widened as the platform ABI
  -- says: SysV x86-64 and AArch64 have the caller extend an 8- or 16-bit
  -- argument, and the callee such a result, to 32 bits, and optimised C
  -- relies on it. `signext`/`zeroext` tells LLVM which side widens and
  -- how (seed/src/codegen.rs, ext_attr); without it a constant
  -- `i16 -1234` reached C as 64302.
  foreign-c-type :: ForeignParameter -> String
  foreign-c-type parameter = foreign-c-type-for "x86_64" parameter
  foreign-c-type-for :: String -> ForeignParameter -> String
  foreign-c-type-for arch parameter =
    if parameter.class == "aggregate" then
      if parameter.width <= 8 then "i64"
      else if parameter.width <= 16 then "{ i64, i64 }"
      else if arch == "aarch64" then "ptr"
      else cat ["ptr byval([", nat-to-string (parameter.width), " x i8]) align ", nat-to-string (parameter.align)]
    else let ty = foreign-llvm-type parameter in
      if ty == "i8" || ty == "i16" then cat [ty, if parameter.signed then " signext" else " zeroext"]
      else if parameter.role == "borrowed" then "ptr nocapture" else ty
  foreign-c-result :: ForeignParameter -> String
  foreign-c-result parameter =
    if parameter.class == "aggregate" then
      if parameter.width <= 8 then "i64"
      else if parameter.width <= 16 then "{ i64, i64 }"
      else "void"
    else let ty = foreign-llvm-type parameter in
      if ty == "i8" || ty == "i16" then cat [if parameter.signed then "signext " else "zeroext ", ty] else ty
  foreign-c-parameter-types :: List ForeignParameter -> List String
  foreign-c-parameter-types params = foreign-c-parameter-types-for "x86_64" params
  foreign-c-parameter-types-for :: String -> List ForeignParameter -> List String
  foreign-c-parameter-types-for arch params = case params of
    [] -> []
    first : rest -> if first.class == "unit" then foreign-c-parameter-types-for arch rest else (foreign-c-type-for arch first) : (foreign-c-parameter-types-for arch rest)
  foreign-worker :: ForeignPlan -> Writer -> Writer
  foreign-worker plan w = let result = foreign-llvm-type (plan.result) in
    let arguments = foreign-parameter-types (plan.parameters) in
    let symbol = plan.symbol in
    let arch = program-arch (writer-program w) in
    case foreign-inline plan of
      None ->
        let res = plan.result in
        let res-sret = res.class == "aggregate" && res.width > 16 in
        let sret-prefix = if res-sret then [cat ["ptr sret([", nat-to-string (res.width), " x i8]) align ", nat-to-string (res.align)]] else [] in
        let c-params = sret-prefix <> foreign-c-parameter-types-for arch (plan.parameters) in
        global w (cat ["declare ", foreign-c-result res, " ", llvm-object-symbol symbol, "(", join c-params, ")"])
      Some (InlinePrimitive owner family selected llvm assembly) ->
        let defined = case llvm of
              None -> w
              Some (PrimitiveFragment fragment symbols indices contracts) ->
                primitive-worker (cat [owner, ".llvm"]) result arguments fragment indices (primitive-uses contracts (primitive-intrinsics symbols w)) in
        case assembly of
          None -> defined
          Some (PrimitiveFragment template symbols indices contracts) ->
            let constraints = string-concat-all ["=", primitive-register result, primitive-registers arguments] in
            let body = cat ["  call void @llvm.sideeffect()\n  %asmresult = call ", result, " asm sideeffect \"",
              llvm-data-bytes template, "\", \"", constraints, "\"(", join (primitive-arguments arguments 0), ")\n  ret ", result, " %asmresult"] in
            primitive-worker (cat [owner, ".asm"]) result arguments body indices (primitive-uses contracts (request-demand (PrimitiveIntrinsicDemand "@llvm.sideeffect") defined))
  primitive-register :: String -> String
  primitive-register ty = if ty == "float" || ty == "double" then "f" else "r"
  primitive-registers :: List String -> String
  primitive-registers arguments = case arguments of
    [] -> ""
    ty : rest -> cat [",", primitive-register ty, primitive-registers rest]
  primitive-arguments :: List String -> Nat -> List String
  primitive-arguments arguments index = case arguments of
    [] -> []
    ty : rest -> (cat [ty, " %", nat-to-string index]) : (primitive-arguments rest (index + 1))
  primitive-worker :: String -> String -> List String -> String -> List Nat -> Writer -> Writer
  primitive-worker name result arguments body immediates w =
    let (ready, attachment) = primitive-immediate-metadata immediates w in
    global ready (cat ["define internal ", result, " ", llvm-object-symbol name, "(", join (primitive-arguments arguments 0),
      ") alwaysinline", attachment, " {\n", body, "\n}"])
  primitive-immediate-metadata :: List Nat -> Writer -> (Writer, String)
  primitive-immediate-metadata indices w = case indices of
    [] -> (w, "")
    other -> let (next, name) = fresh-serial w "!" in
      (global next (cat [name, " = !{", join (map (\index -> cat ["i32 ", nat-to-string index]) indices), "}"]), cat [" !immarg ", name])
  primitive-intrinsics :: List String -> Writer -> Writer
  primitive-intrinsics symbols w = case symbols of
    [] -> w
    symbol : rest -> primitive-intrinsics rest (request-demand (PrimitiveIntrinsicDemand symbol) w)
  prelude-declared-use :: String -> Bool
  prelude-declared-use sym =
    sym == "memcpy"
      || sym == "cinch_dup" || sym == "cinch_dup_mt" || sym == "cinch_drop_mt" || sym == "cinch_drop_slow"
      || sym == "cinch_stm_state" || sym == "cinch_stm_publish" || sym == "cinch_stm_wait_begin"
      || sym == "cinch_stm_wait_park" || sym == "cinch_stm_wait_cancel" || sym == "cinch_stm_wake" || sym == "cinch_stm_yield"
      || sym == "cinch_alloc" || sym == "cinch_blackhole"
  primitive-uses :: List PrimUseContract -> Writer -> Writer
  primitive-uses contracts w = case contracts of
    [] -> w
    c : rest ->
      let sym = c.use-symbol in
      let next = if prelude-declared-use sym then w
            else let decl = cat ["declare ", foreign-llvm-type (c.use-result), " ", llvm-object-symbol sym, "(", join (foreign-parameter-types (c.use-params)), ")"] in
              request-demand (PrimitiveUseDemand sym decl) w in
      primitive-uses rest next
  starts-with-dot-range :: String -> String -> String -> Bool
  starts-with-dot-range lo hi s = ge-i64 (string-compare s lo) 0 && lt-i64 (string-compare s hi) 0
  prelude-declared-intrinsic :: String -> Bool
  prelude-declared-intrinsic symbol =
    starts-with-dot-range "@llvm." "@llvm/" symbol && (
      starts-with-dot-range "@llvm.fshl." "@llvm.fshl/" symbol
      || starts-with-dot-range "@llvm.fshr." "@llvm.fshr/" symbol
      || starts-with-dot-range "@llvm.ctpop." "@llvm.ctpop/" symbol
      || starts-with-dot-range "@llvm.ctlz." "@llvm.ctlz/" symbol
      || starts-with-dot-range "@llvm.cttz." "@llvm.cttz/" symbol
      || starts-with-dot-range "@llvm.bitreverse." "@llvm.bitreverse/" symbol
      || starts-with-dot-range "@llvm.bswap." "@llvm.bswap/" symbol
      || starts-with-dot-range "@llvm.copysign." "@llvm.copysign/" symbol
      || starts-with-dot-range "@llvm.fabs." "@llvm.fabs/" symbol
      || starts-with-dot-range "@llvm.sqrt." "@llvm.sqrt/" symbol
      || starts-with-dot-range "@llvm.sin." "@llvm.sin/" symbol
      || starts-with-dot-range "@llvm.cos." "@llvm.cos/" symbol
      || starts-with-dot-range "@llvm.exp." "@llvm.exp/" symbol
      || starts-with-dot-range "@llvm.log." "@llvm.log/" symbol
      || starts-with-dot-range "@llvm.floor." "@llvm.floor/" symbol
      || starts-with-dot-range "@llvm.ceil." "@llvm.ceil/" symbol
      || starts-with-dot-range "@llvm.trunc." "@llvm.trunc/" symbol
      || starts-with-dot-range "@llvm.round." "@llvm.round/" symbol
      || starts-with-dot-range "@llvm.roundeven." "@llvm.roundeven/" symbol
      || starts-with-dot-range "@llvm.smin." "@llvm.smin/" symbol
      || starts-with-dot-range "@llvm.smax." "@llvm.smax/" symbol)
  primitive-intrinsic-worker :: String -> Writer -> Writer
  primitive-intrinsic-worker symbol w =
    if prelude-declared-intrinsic symbol then w
    else if symbol == "@llvm.sideeffect" then global w "declare void @llvm.sideeffect()"
    else if symbol == "@llvm.vector.reduce.add.v16i32" then global w "declare i32 @llvm.vector.reduce.add.v16i32(<16 x i32>)"
    else (case reverse (string-split-on "." symbol) of
      ty : rest ->
        if starts-with-dot-range "@llvm.sadd.sat." "@llvm.sadd.sat/" symbol || starts-with-dot-range "@llvm.uadd.sat." "@llvm.uadd.sat/" symbol
            || starts-with-dot-range "@llvm.ssub.sat." "@llvm.ssub.sat/" symbol || starts-with-dot-range "@llvm.usub.sat." "@llvm.usub.sat/" symbol then
          global w (cat ["declare ", ty, " ", symbol, "(", ty, ", ", ty, ")"])
        else global w (cat ["declare { ", ty, ", i1 } ", symbol, "(", ty, ", ", ty, ")"])
      [] -> refuse w (Span 0 0 1 1) "inline intrinsic is missing its checked result width")
  foreign-abi-compatible :: ForeignPlan -> ForeignPlan -> Bool
  foreign-abi-compatible first second = foreign-c-result (first.result) == foreign-c-result (second.result)
    && join (foreign-c-parameter-types (first.parameters)) == join (foreign-c-parameter-types (second.parameters))
  foreign-abi-coherent :: ForeignPlan -> List ForeignPlan -> Bool
  foreign-abi-coherent plan plans = case plans of
    [] -> True
    other : rest -> foreign-abi-compatible plan other && foreign-abi-coherent plan rest
  foreign-export-declarations :: List ForeignParameter -> Nat -> List String
  foreign-export-declarations parameters index = case parameters of
    [] -> []
    first : rest -> let tail = foreign-export-declarations rest (index + 1) in
      if first.class == "unit" then tail else (cat [foreign-c-type first, " %c", nat-to-string index]) : tail

  -- C supplies the incoming bits. Freeze them before a pointer check or
  -- conversion can use them in the checked worker. Unit has only a Cinch slot.
  foreign-export-arguments :: Writer -> List ForeignParameter -> Nat -> (Writer, List (String, String))
  foreign-export-arguments w parameters index = case parameters of
    [] -> (w, [])
    first : rest -> let ty = foreign-llvm-type first in
      let (converted, value) = if ty == "void" then (w, "0") else
            (let (ready, safe) = fresh w "%foreign" in
              foreign-result-word (line ready (cat ["  ", safe, " = freeze ", ty, " %c", nat-to-string index])) first safe) in
      (case foreign-export-arguments converted rest (index + 1) of
        (done, tail) -> (done, (if ty == "i128" then "i128" else if ty == "ptr" && foreign-pointer (base (first.parameter-type)) then "ptr" else "i64", value) : tail))

  foreign-export-roots :: List (String, ForeignPlan) -> List (String, List Nat)
  foreign-export-roots exports = map (\pair -> case pair of (name, plan) -> (name, [])) exports

  foreign-word-arguments :: List (String, String) -> Bool
  foreign-word-arguments args = case args of
    [] -> True
    (ty, value) : rest -> ty == "i64" && foreign-word-arguments rest

  -- A curried source definition may return a closure before the C
  -- argument list is exhausted. Only word-sized values can cross __apply.
  call-export-worker :: Writer -> String -> ForeignParameter -> List (String, String) -> (Writer, String)
  call-export-worker w name result args = case worker-definition name w of
    None -> unsupported w (Span 0 0 1 1) "foreign export has no checked worker"
    Some d -> let arity = list-length (definition-parameters d) in
      case split-at arity args of
        (prefix, []) -> if list-length prefix /= arity then unsupported w (Span 0 0 1 1) "foreign export has too few arguments for its worker"
          else typed-call w (definition-result-llvm (w.context) d) (symbol name) prefix
        (prefix, rest) -> if foreign-llvm-type result == "i128" || not (foreign-word-arguments rest) then
          unsupported w (Span 0 0 1 1) wide-refusal
          else (case typed-call w "i64" (symbol name) prefix of
            (called, closure) -> apply-words called closure (map (\arg -> case arg of (ty, value) -> value) rest))

  foreign-export-bridges :: List (String, ForeignPlan) -> Writer -> Writer
  foreign-export-bridges exports w = case exports of
    [] -> w
    (name, plan) : rest -> let result = plan.result in let params = plan.parameters in
      let started = emit-lines w [cat ["define ", foreign-c-result result, " ", llvm-object-symbol (plan.symbol), "(", join (foreign-export-declarations params 0), ") nounwind {"], "entry:"] in
      let (ready, args) = foreign-export-arguments started params 0 in
      let (called, word) = call-export-worker ready name result args in
      let ty = foreign-llvm-type result in
      let returned = if ty == "void" then line called "  ret void" else
            (let (converted, value) = foreign-marshal-one called result word in
              line (if ty == "ptr" then foreign-pointer-check converted result value else converted) (cat ["  ret ", ty, " ", value])) in
      foreign-export-bridges rest (line returned "}")

  foreign-pointer-head :: UType -> Option String
  foreign-pointer-head ty = case base ty of
    UApp (UCon name kind) pointee | foreign-pointer ty -> Some name
    other -> None
  foreign-argument-types :: List ForeignParameter -> List CoreTerm -> Bool
  foreign-argument-types params args = case (params, args) of
    ([], []) -> True
    (first : rest, value : more) ->
      let pt = base (first.parameter-type) in
      let vt = base (core-type value) in
      let matches = foreign-type-equal pt vt || (case (foreign-pointer-head pt, foreign-pointer-head vt) of
            (Some a, Some b) -> a == b
            other -> False) in
      matches && foreign-argument-types rest more
    other -> False
  -- `boundary` is a call of a C symbol, whose narrow arguments carry the
  -- platform's extension; an inline primitive's worker is this module's
  -- own, so its arguments do not.
  foreign-marshal :: Bool -> Writer -> List ForeignParameter -> List String -> (Writer, List String)
  foreign-marshal boundary w params values = case (params, values) of
    ([], []) -> (w, [])
    (first : rest, value : more) -> if first.class == "unit" then foreign-marshal boundary w rest more else
      let arch = program-arch (writer-program w) in
      (case foreign-marshal-one w first value of
        (converted, argument) -> case foreign-marshal boundary converted rest more of
          (done, tail) -> (done, (cat [if boundary then foreign-c-type-for arch first else foreign-llvm-type first, " ", argument]) : tail))
    other -> (refuse w (Span 0 0 1 1) "foreign ABI argument vector differs from its checked plan", [])
  foreign-marshal-one :: Writer -> ForeignParameter -> String -> (Writer, String)
  foreign-marshal-one w parameter value =
    if parameter.class == "aggregate" then (w, value)
    else let ty = foreign-llvm-type parameter in
    -- A wide scalar already travels as the C `__int128` it is; native pointers travel as `ptr`.
    if ty == "i64" || ty == "i128" then (w, value)
    else if ty == "ptr" then
      if foreign-pointer (base (parameter.parameter-type)) then (w, value)
      else let (next, result) = fresh w "%foreign" in (line next (cat ["  ", result, " = inttoptr i64 ", value, " to ptr"]), result)
    else if ty == "double" then let (next, result) = fresh w "%foreign" in (line next (cat ["  ", result, " = bitcast i64 ", value, " to double"]), result)
    else if ty == "float" then
      let (next, bits) = fresh w "%foreign" in let narrow = line next (cat ["  ", bits, " = trunc i64 ", value, " to i32"]) in
      let (ready, result) = fresh narrow "%foreign" in (line ready (cat ["  ", result, " = bitcast i32 ", bits, " to float"]), result)
    else let (next, result) = fresh w "%foreign" in (line next (cat ["  ", result, " = trunc i64 ", value, " to ", ty]), result)
  foreign-null-message :: String
  foreign-null-message = "a foreign boundary contract was violated: null pointer where the binding requires non-null"
  foreign-null-declarations :: Writer -> Writer
  foreign-null-declarations w =
    let bytes = nat-to-string (string-length foreign-null-message) in
    global (global w "declare void @cinch_panic(ptr, i64) noreturn")
      (cat ["@cinch.typed.foreign_null_message = private unnamed_addr constant [", bytes, " x i8] c\"", foreign-null-message, "\""])

  foreign-pointer-check :: Writer -> ForeignParameter -> String -> Writer
  foreign-pointer-check w parameter value = if parameter.nullable then w else
    let (next, condition) = fresh w "%foreign" in let tested = line next (cat ["  ", condition, " = icmp ne ptr ", value, ", null"]) in
    let (a, yes) = fresh tested "foreign_nonnull" in let (b, no) = fresh a "foreign_null" in
    emit-lines (request-demand ForeignNullFault b) [cat ["  br i1 ", condition, ", label %", yes, ", label %", no], cat [no, ":"], cat ["  call void @cinch_panic(ptr @cinch.typed.foreign_null_message, i64 ", nat-to-string (string-length foreign-null-message), ")"], "  unreachable", cat [yes, ":"]]
  foreign-result-word :: Writer -> ForeignParameter -> String -> (Writer, String)
  foreign-result-word w parameter value =
    if parameter.class == "aggregate" then (w, value)
    else let ty = foreign-llvm-type parameter in
    if ty == "i64" || ty == "i128" then (w, value)
    else if ty == "ptr" then
      let guarded = foreign-pointer-check w parameter value in
      if foreign-pointer (base (parameter.parameter-type)) then (guarded, value)
      else let (next, result) = fresh guarded "%foreign" in (line next (cat ["  ", result, " = ptrtoint ptr ", value, " to i64"]), result)
    else if ty == "double" then let (next, result) = fresh w "%foreign" in (line next (cat ["  ", result, " = bitcast double ", value, " to i64"]), result)
    else if ty == "float" then
      let (next, bits) = fresh w "%foreign" in let narrow = line next (cat ["  ", bits, " = bitcast float ", value, " to i32"]) in
      let (ready, result) = fresh narrow "%foreign" in (line ready (cat ["  ", result, " = zext i32 ", bits, " to i64"]), result)
    else let (next, result) = fresh w "%foreign" in
      (line next (cat ["  ", result, " = ", if parameter.signed then "sext " else "zext ", ty, " ", value, " to i64"]), result)
  -- | Lower a checked pure scalar using the existing integer operand and result ABI bridges.
  scalar-intrinsic-worker :: Writer -> ScalarOperation -> (Writer, String)
  scalar-intrinsic-worker w operation = case primitive-layout (scalar-intrinsic-scheme operation) of
    Err error -> unsupported w (Span 0 0 1 1) (string-concat "checked scalar ABI is not representable: " error)
    Ok (arguments, result) -> case scalar-worker-operands w arguments 0 of
      (ready, values) -> scalar-worker-operation ready operation arguments result values
  -- | Normalize each already evaluated machine word exactly once at its declared integer width.
  scalar-worker-operands :: Writer -> List ForeignParameter -> Nat -> (Writer, List String)
  scalar-worker-operands w parameters index = case parameters of
    [] -> (w, [])
    first : rest -> case foreign-marshal-one w first (cat ["%arg", nat-to-string index]) of
      (ready, value) -> case scalar-worker-operands ready rest (index + 1) of
        (done, values) -> (done, value : values)
  -- | Dispatch only compiler-selected scalar operations with their exact checked argument counts.
  scalar-worker-operation :: Writer -> ScalarOperation -> List ForeignParameter -> ForeignParameter -> List String -> (Writer, String)
  scalar-worker-operation w operation arguments result values =
    let code = operation.operation-code in
    case (arguments, values) of
      ([source], [value]) -> let ty = foreign-llvm-type source in
        if code == "convert" || code == "widen" then scalar-worker-convert w source result value
        else if code == "not" then
          (let (ready, computed) = fresh w "%scalar" in
           foreign-result-word (line ready (cat ["  ", computed, " = xor ", ty, " ", value, ", -1"])) result computed)
        else if code == "neg" then
          (let (ready, computed) = fresh w "%scalar" in
           foreign-result-word (line ready (cat ["  ", computed, " = sub ", ty, " 0, ", value])) result computed)
        else if code == "bswap" then
          if source.width == 1 then foreign-result-word w result value
          else (let (ready, computed) = fresh w "%scalar" in
            foreign-result-word (line ready (cat ["  ", computed, " = call ", ty, " @llvm.bswap.", ty, "(", ty, " ", value, ")"])) result computed)
        else if code == "bitrev" then
          (let (ready, computed) = fresh w "%scalar" in
           foreign-result-word (line ready (cat ["  ", computed, " = call ", ty, " @llvm.bitreverse.", ty, "(", ty, " ", value, ")"])) result computed)
        else if code == "ctpop" then
          (let (ready, computed) = fresh w "%scalar" in
           let called = line ready (cat ["  ", computed, " = call ", ty, " @llvm.ctpop.", ty, "(", ty, " ", value, ")"]) in
           scalar-worker-to-u32 called source computed)
        else if code == "ctlz" || code == "cttz" then
          (let (ready, computed) = fresh w "%scalar" in
           let called = line ready (cat ["  ", computed, " = call ", ty, " @llvm.", code, ".", ty, "(", ty, " ", value, ", i1 false)"]) in
           scalar-worker-to-u32 called source computed)
        else unsupported w (Span 0 0 1 1) "unary scalar operation is outside its checked subset"
      ([first, second], [left, right]) ->
        if operation.operation-result.shape-name == "Bool" then
          compare-typed w (foreign-llvm-type first) (scalar-comparison-predicate code (first.signed)) left right
        else if code == "shl" || code == "shr" then scalar-worker-shift w code first second result left right
        else if code == "rotl" || code == "rotr" then scalar-worker-rotate w code first second result left right
        else if code == "udiv" || code == "urem" then
          (let ty = foreign-llvm-type first in
           let (w1, z) = fresh w "%scalar" in let (w2, safe) = fresh w1 "%scalar" in
           let (w3, q) = fresh w2 "%scalar" in let (w4, out) = fresh w3 "%scalar" in
           let body = emit-lines w4 [
             cat ["  ", z, " = icmp eq ", ty, " ", right, ", 0"],
             cat ["  ", safe, " = select i1 ", z, ", ", ty, " 1, ", ty, " ", right],
             cat ["  ", q, " = ", code, " ", ty, " ", left, ", ", safe],
             cat ["  ", out, " = select i1 ", z, ", ", ty, " 0, ", ty, " ", q]] in
           foreign-result-word body result out)
        else if code == "add" || code == "sub" || code == "mul" || code == "and" || code == "or" || code == "xor" then
          (let (ready, computed) = fresh w "%scalar" in
           foreign-result-word (line ready (cat ["  ", computed, " = ", code, " ", foreign-llvm-type first, " ", left, ", ", right])) result computed)
        else unsupported w (Span 0 0 1 1) "binary scalar operation is outside its checked subset"
      other -> unsupported w (Span 0 0 1 1) "scalar argument vector differs from its checked operation"
  -- | Zero-extend or truncate a bit-count result into a canonical U32 word.
  scalar-worker-to-u32 :: Writer -> ForeignParameter -> String -> (Writer, String)
  scalar-worker-to-u32 w source value =
    if source.width == 8 then (w, value)
    else let (ready, out) = fresh w "%scalar" in
      (line ready (cat ["  ", out, " = zext ", foreign-llvm-type source, " ", value, " to i64"]), out)
  -- | Lower a fixed-width scalar rotate via @llvm.fshl/@llvm.fshr.
  scalar-worker-rotate :: Writer -> String -> ForeignParameter -> ForeignParameter -> ForeignParameter -> String -> String -> (Writer, String)
  scalar-worker-rotate w code source count result value amount =
    let ty = foreign-llvm-type source in
    let intr = if code == "rotl" then "fshl" else "fshr" in
    case foreign-result-word w count amount of
      (ready, word) -> case foreign-marshal-one ready source word of
        (narrowed, sh) -> let (done, computed) = fresh narrowed "%scalar" in
          foreign-result-word (line done (cat ["  ", computed, " = call ", ty, " @llvm.", intr, ".", ty, "(", ty, " ", value, ", ", ty, " ", value, ", ", ty, " ", sh, ")"])) result computed
  -- | Keep equality neutral and choose the declared signed ordering for relational comparisons.
  scalar-comparison-predicate :: String -> Bool -> String
  scalar-comparison-predicate code signed = if code == "eq" || code == "ne" then code
    else string-concat (if signed then "s" else "u") code
  -- | Preserve canonical wrapping conversion bits before applying the destination's word extension.
  scalar-worker-convert :: Writer -> ForeignParameter -> ForeignParameter -> String -> (Writer, String)
  scalar-worker-convert w source destination value =
    if source.width == destination.width then foreign-result-word w destination value
    else let operation = (if destination.width < source.width then "trunc" else if source.signed then "sext" else "zext") in
      let (ready, converted) = fresh w "%scalar" in
      foreign-result-word (line ready (cat ["  ", converted, " = ", operation, " ", foreign-llvm-type source,
        " ", value, " to ", foreign-llvm-type destination])) destination converted
  -- | Mask the canonical U32 shift count before any LLVM shift can observe an oversized operand.
  scalar-worker-shift :: Writer -> String -> ForeignParameter -> ForeignParameter -> ForeignParameter -> String -> String -> (Writer, String)
  scalar-worker-shift w code source count result value amount =
    let width = source.width * 8 in
    if 1 <= width && (width == 8 || width == 16 || width == 32 || width == 64) then
      (case foreign-result-word w count amount of
        (ready, word) -> let (masked, bounded) = fresh ready "%scalar" in
          let limited = line masked (cat ["  ", bounded, " = and i64 ", word, ", ", nat-to-string (width - 1)]) in
          case foreign-marshal-one limited source bounded of
            (narrowed, shift) -> let operation = if code == "shl" then "shl" else if source.signed then "ashr" else "lshr" in
              let (done, computed) = fresh narrowed "%scalar" in
              foreign-result-word (line done (cat ["  ", computed, " = ", operation, " ", foreign-llvm-type source,
                " ", value, ", ", shift])) result computed)
    else unsupported w (Span 0 0 1 1) "scalar shift has no supported positive integer width"
  foreign-call :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List String -> List CoreTerm -> (Writer, String)
  foreign-call definitions locals w sp name givens args = case program-foreign-binding name (writer-program w) of
    None -> unsupported w sp "foreign call has no checked ABI plan"
    Some plan -> if list-length givens /= 0 || not (foreign-argument-types (plan.parameters) args) then unsupported w sp "foreign call must supply every checked ABI argument"
      else if not (foreign-abi-coherent plan (foreign-symbol-plans (plan.symbol) (writer-program w))) then unsupported w sp "foreign symbol has conflicting ABI contracts"
      else if not (primitive-immediate-arguments (foreign-inline plan) args) then unsupported w sp "an immarg primitive operand must be an immediate literal"
      else case expressions definitions locals (request-demand (ForeignDemand plan) w) args of
        (evaluated, values) -> let boundary = (case foreign-inline plan of None -> True; Some body -> False) in
          case foreign-marshal boundary evaluated (plan.parameters) values of
          (ready, arguments) -> let result = plan.result in let ty = foreign-llvm-type result in
            let blocking = boundary && not (program-wasm32 (writer-program ready)) && foreign-blocking plan in
            let entered = if blocking then line ready "  call i64 @cinch_sched_blocking_enter()" else ready in
            let (called, value) =
                  if boundary && result.class == "aggregate" && result.width > 16 then
                    let (w1, sret) = fresh entered "%sret" in
                    let w2 = line w1 (cat ["  ", sret, " = alloca [", nat-to-string (result.width), " x i8], align ", nat-to-string (result.align)]) in
                    let sret-arg = cat ["ptr sret([", nat-to-string (result.width), " x i8]) align ", nat-to-string (result.align), " ", sret] in
                    (line w2 (cat ["  call void ", llvm-object-symbol (plan.symbol), "(", join (sret-arg : arguments), ")"]), sret)
                  else if ty == "void" then (line entered (cat ["  call void ", llvm-object-symbol (plan.symbol), "(", join arguments, ")"]), "0")
                  else (case fresh entered "%foreign" of
                    (next, name) -> (line next (cat ["  ", name, " = call ", if boundary then foreign-c-result result else ty, " ", llvm-object-symbol (plan.symbol), "(", join arguments, ")"]), name)) in
            let exited = if blocking then line called "  call i64 @cinch_sched_blocking_exit()" else called in
            if ty == "void" || result.class == "aggregate" then (exited, value) else foreign-result-word exited result value
  primitive-immediate-arguments :: Option InlinePrimitive -> List CoreTerm -> Bool
  primitive-immediate-arguments plan args = case plan of
    None -> True
    Some (InlinePrimitive owner family indices llvm assembly) -> immediate-operands indices args
  immediate-operands :: List Nat -> List CoreTerm -> Bool
  immediate-operands indices args = case indices of
    [] -> True
    index : rest -> immediate-operand index args && immediate-operands rest args
  immediate-operand :: Nat -> List CoreTerm -> Bool
  immediate-operand index args = case args of
    [] -> False
    first : rest -> if index == 0 then (case first of CInt sp ty text -> True; other -> False)
      else immediate-operand (index - 1) rest
  external-binding :: String -> ProgramInfo -> Option CheckedBinding
  external-binding name info = case program-callable-bindings info of
    CallableBindings methods externals instances bodies natives -> hash-map-lookup name externals
  external-shape :: Nat -> UType -> List UType -> Option (List UType, UType)
  external-shape count ty backwards = if count == 0 then Some (reverse backwards, ty) else case arrow-shape (base ty) of
    UFun domain result -> external-shape (count - 1) result (domain : backwards)
    UFunEff domain row result -> external-shape (count - 1) result (domain : backwards)
    UPi id name domain row result -> external-shape (count - 1) result (domain : backwards)
    other -> None
  external-param-types :: List Nat -> List String
  external-param-types params = case params of [] -> []; first : rest -> (class-llvm first) : (external-param-types rest)
  class-llvm :: Nat -> String
  class-llvm code = if code == 3 then "i128" else "i64"
  external-worker :: RuntimeUnit -> Writer -> Writer
  external-worker unit w = global (global w (cat ["declare ", (case unit.result of Some code -> class-llvm code; None -> "i64"), " ", llvm-object-symbol (unit.symbol), "(", join (external-param-types (unit.params)), ")"]))

    (cat ["declare i64 ", llvm-object-symbol (unit.closure), "()"])
  requirement-types :: List Requirement -> List UType
  requirement-types requirements = case requirements of [] -> []; first : rest -> (first.ty) : (requirement-types rest)
  apply-words :: Writer -> String -> List String -> (Writer, String)
  apply-words w function values = case values of
    [] -> (w, function)
    first : rest -> case apply-one w function first of (next, result) -> apply-words next result rest
  actual-pairs :: List Quant -> List UType -> List (Nat, UType)
  actual-pairs qs actuals = case qs of
    [] -> []
    q : rest -> case actuals of actual : more -> (q.id, actual) : (actual-pairs rest more); [] -> []
  concrete-scheme :: Scheme -> List UType -> Scheme
  concrete-scheme sc actuals = let pairs = actual-pairs (scheme-params sc) actuals in
    qualified [] (map-requirements (substitute-bound pairs) (scheme-requirements sc)) (substitute-bound pairs (scheme-body sc))
  external-call :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List UType -> List String -> List CoreTerm -> (Writer, String)
  external-call definitions locals w sp name actuals givens args = case (writer-program w).object of
    None -> unsupported w sp (cat ["external runtime implementation is unavailable: ", name])
    Some provider -> (case external-binding name (writer-program w) of
      Some binding -> (case scheme-classes (w.context) (scheme-params (checked-scheme binding)) actuals of
        Some codes -> (let variant = (case checked-conditional-target binding of
          Some (owner, dictionary, slot) -> object-conditional-unit owner dictionary slot name codes provider
          None -> object-variant name codes provider) in
          case variant of
          Some unit -> (case inline-external definitions locals w name unit (concrete-scheme (checked-scheme binding) actuals) givens args of
            Some lowered -> lowered
            None -> external-call-unit definitions locals w sp unit (concrete-scheme (checked-scheme binding) actuals) givens args)
          None -> unsupported w sp (cat ["checked external variant is absent from the runtime object: ", name, " [", native-classes codes, "]"]))
        None -> unsupported w sp "external function needs checked representation specialization")
      None -> unsupported w sp (cat ["external runtime implementation is unavailable: ", name]))
  -- A saturated call to an imported unit whose interface publishes its
  -- total body as a tree of primitives is that tree, emitted here.
  --
  -- `x == y` at `I64`, `n < m` at `Nat`, `not b` and `n + 1` are library
  -- functions: an instance method or a one-line wrapper over a runtime
  -- primitive. A client called each one in the library object, which no
  -- optimiser can see into, so a loop over bytes made a dozen opaque calls
  -- per byte. The interface already states what each computes
  -- (`total_body`: `I64Eq(NatCmp(l0, l1), 0)` for `Eq_Nat.==`), and that
  -- statement is a checked contract, so emitting it is emitting the callee.
  --
  -- Only a body made of the operations below, over its own parameters and
  -- `I64` literals, each parameter used exactly once, is taken. One use
  -- matters: a unit owns its arguments, and so does each operation here,
  -- so a parameter used once is consumed once and the counts are the
  -- call's. Anything else is called as before.
  --
  -- `Nat` and `Int` operations test for the immediate encoding the runtime
  -- ABI fixes (an odd word is `value * 2 + 1`, seed/runtime/src/abi.rs)
  -- and decide those in place; a heap operand, or a sum that leaves the
  -- immediate range, goes to the runtime entry that the library's own body
  -- reaches.
  inline-external :: List CoreDefinition -> List Local -> Writer -> String -> RuntimeUnit -> Scheme -> List String -> List CoreTerm -> Option (Writer, String)
  inline-external definitions locals w name unit sc givens args =
    inline-total definitions locals w (imported-total-body name (writer-program w)) unit sc givens args
  -- The same for a unit whose body was found: a value's by its checked
  -- name, a closed instance method's by the unit it resolved to.
  --
  -- The unit is still the authority on what the call is. A body is taken
  -- only where the call would have been admitted: the provider's word ABI
  -- for the unit agrees with the checked scheme. Where it does not, the
  -- call path refuses the program, as it did before any body was inlined.
  inline-total :: List CoreDefinition -> List Local -> Writer -> Option TotalFunction -> RuntimeUnit -> Scheme -> List String -> List CoreTerm -> Option (Writer, String)
  inline-total definitions locals w found unit sc givens args = case givens of
    [] -> if list-length args /= list-length (unit.params) || not (inline-abi-agrees w unit sc) then None else
      (case found of
        None -> None
        Some function ->
          let parameters = total-parameters function in
          let count = list-length parameters in
          if count /= list-length args || not (inline-sort (total-result function)) || not (inline-sorts parameters) then None
          else (case total-term function of
            Some body -> (case plan-imported-operations body [] of
              Some (plan, slots) | inline-linear slots count -> (case expressions definitions locals w args of
                (ready, values) -> Some (inline-term ready (array-from-list values) plan))
              other -> None)
            None -> None))
    other -> None
  inline-abi-agrees :: Writer -> RuntimeUnit -> Scheme -> Bool
  inline-abi-agrees w unit sc = case scheme-requirements sc of
    [] -> (case external-shape (list-length (unit.params)) (scheme-body sc) [] of
      Some (params, result-type) -> case unit.result of
        Some actual-result -> case class-vector (w.context) params of
          Some expected -> case word-class (w.context) result-type of
            Some result -> same-classes expected (unit.params) && result == actual-result
            None -> False
          None -> False
        None -> False
      None -> False)
    other -> False
  imported-total-body :: String -> ProgramInfo -> Option TotalFunction
  imported-total-body name info = case program-callable-bindings info of
    CallableBindings methods externals instances bodies natives -> hash-map-lookup name bodies
  imported-native-body :: String -> ProgramInfo -> Option TotalFunction
  imported-native-body native info = case program-callable-bindings info of
    CallableBindings methods externals instances bodies natives -> hash-map-lookup native natives
  inline-sort :: String -> Bool
  inline-sort sort = sort == "I64" || sort == "Nat" || sort == "Int" || sort == "Bool"
  inline-sorts :: List String -> Bool
  inline-sorts sorts = case sorts of [] -> True; first : rest -> inline-sort first && inline-sorts rest
  -- The operations emitted in place, with the number of operands each takes.
  inline-operation :: String -> Option Nat
  inline-operation operation =
    if operation == "I64Eq" || operation == "I64Ne" || operation == "I64Lt" || operation == "I64Le"
      || operation == "I64Gt" || operation == "I64Ge" || operation == "BoolEq"
      || operation == "NatCmp" || operation == "IntCmp" || operation == "NatAdd" || operation == "IntAdd" || operation == "IntSub" then Some 2
    else if operation == "BoolNot" then Some 1
    else None
  -- Decode each supported checked node once. This plan keeps the same
  -- evaluation order and ownership test for both backing representations.
  data ImportedOperations where
    ImportedLocal :: Nat -> ImportedOperations
    ImportedConstant :: String -> ImportedOperations
    ImportedNot :: ImportedOperations -> ImportedOperations
    ImportedBinary :: String -> ImportedOperations -> ImportedOperations -> ImportedOperations

  plan-imported-operations :: TotalTerm -> List Nat -> Option (ImportedOperations, List Nat)
  plan-imported-operations term slots = case term-node term of
    LocalTerm slot -> Some (ImportedLocal slot, slot : slots)
    NumberTerm sort decimal | (sort == "I64") && constant-word decimal -> Some (ImportedConstant decimal, slots)
    PrimitiveTerm operation arguments -> (case inline-operation operation of
      Some arity -> plan-imported-primitive arity operation arguments slots
      None -> None)
    other -> None

  plan-imported-primitive :: Nat -> String -> TotalArguments -> List Nat -> Option (ImportedOperations, List Nat)
  plan-imported-primitive arity operation arguments slots = case argument-node arguments of
    NextArgument first rest -> (case plan-imported-operations first slots of
      Some (left, next) -> (case argument-node rest of
        NoArguments -> if arity == 1 then Some (ImportedNot left, next) else None
        NextArgument second end -> if arity == 2 then (case argument-node end of
          NoArguments -> (case plan-imported-operations second next of
            Some (right, final) -> Some (ImportedBinary operation left right, final)
            None -> None)
          other -> None) else None
        other -> None)
      None -> None)
    other -> None

  -- Every parameter exactly once. Small calls avoid allocating an index.
  inline-linear :: List Nat -> Nat -> Bool
  inline-linear slots count = list-length slots == count &&
    (if count <= 8 then inline-distinct slots count else inline-distinct-indexed slots count hash-map-empty)
  inline-distinct :: List Nat -> Nat -> Bool
  inline-distinct slots count = case slots of
    [] -> True
    first : rest -> first < count && not (inline-slot-member first rest) && inline-distinct rest count
  inline-slot-member :: Nat -> List Nat -> Bool
  inline-slot-member slot slots = case slots of [] -> False; first : rest -> first == slot || inline-slot-member slot rest
  inline-distinct-indexed :: List Nat -> Nat -> HashMap Nat Nat -> Bool
  inline-distinct-indexed slots count seen = case slots of
    [] -> True
    first : rest -> first < count && (case hash-map-lookup first seen of
      Some _ -> False
      None -> inline-distinct-indexed rest count (hash-map-insert first 0 seen))

  inline-term :: Writer -> Array String -> ImportedOperations -> (Writer, String)
  inline-term w values plan = case plan of
    ImportedLocal slot -> (case array-get values slot of Some value -> (w, value); None -> (w, "0"))
    ImportedConstant decimal -> (w, decimal)
    ImportedNot body -> (case inline-term w values body of
      (one, operand) -> let (two, result) = fresh one "%v" in (line two (cat ["  ", result, " = xor i64 ", operand, ", 1"]), result))
    ImportedBinary operation first second -> (case inline-term w values first of
      (one, left) -> case inline-term one values second of
        (two, right) -> inline-binary two operation left right)
  inline-binary :: Writer -> String -> String -> String -> (Writer, String)
  inline-binary w operation left right =
    if operation == "I64Eq" || operation == "BoolEq" then compare-word w "eq" left right
    else if operation == "I64Ne" then compare-word w "ne" left right
    else if operation == "I64Lt" then compare-word w "slt" left right
    else if operation == "I64Le" then compare-word w "sle" left right
    else if operation == "I64Gt" then compare-word w "sgt" left right
    else if operation == "I64Ge" then compare-word w "sge" left right
    else if operation == "NatCmp" then inline-ordering w (UCon "Nat" KType) "u" "@cinch_nat_cmp" left right
    else if operation == "IntCmp" then inline-ordering w (UCon "Int" KType) "s" "@cinch_int_cmp" left right
    else if operation == "NatAdd" then inline-arithmetic w (UCon "Nat" KType) operation "@cinch_nat_add" left right
    else if operation == "IntAdd" then inline-arithmetic w (UCon "Int" KType) operation "@cinch_int_add" left right
    else inline-arithmetic w (UCon "Int" KType) operation "@cinch_int_sub" left right
  -- Both words odd means both are immediates. `fast` is where control goes
  -- when they are and `slow` where it goes otherwise.
  inline-immediates :: Writer -> String -> String -> String -> String -> Writer
  inline-immediates w left right fast slow =
    let (one, both) = fresh w "%v" in
    let (two, tag) = fresh one "%v" in
    let (three, immediate) = fresh two "%v" in
    emit-lines three [cat ["  ", both, " = and i64 ", left, ", ", right], cat ["  ", tag, " = and i64 ", both, ", 1"],
      cat ["  ", immediate, " = icmp ne i64 ", tag, ", 0"], cat ["  br i1 ", immediate, ", label %", fast, ", label %", slow]]
  -- The runtime entry on the operands as they are, which it borrows, then
  -- the two counts the operation owes.
  inline-runtime :: Writer -> UType -> String -> String -> String -> String -> (Writer, String)
  inline-runtime w ty entry left right join-label = case call w entry [left, right] of
    (called, result) -> (line (count-op False ty right (count-op False ty left called)) (cat ["  br label %", join-label]), result)
  -- An immediate's word orders as its value does: unsigned for a `Nat`,
  -- whose payload is the word's upper 63 bits, and signed for an `Int`.
  -- The result is the ordering word the runtime answers with: -1, 0 or 1.
  inline-ordering :: Writer -> UType -> String -> String -> String -> String -> (Writer, String)
  inline-ordering w ty sign entry left right =
    let (one, fast) = fresh w "immediate" in
    let (two, slow) = fresh one "boxed" in
    let (three, joined) = fresh two "ordered" in
    let (four, greater) = fresh (line (inline-immediates three left right fast slow) (cat [fast, ":"])) "%v" in
    let (five, less) = fresh four "%v" in
    let (six, above) = fresh five "%v" in
    let (seven, below) = fresh six "%v" in
    let (eight, quick) = fresh seven "%v" in
    let decided = emit-lines eight [cat ["  ", greater, " = icmp ", sign, "gt i64 ", left, ", ", right], cat ["  ", less, " = icmp ", sign, "lt i64 ", left, ", ", right],
      cat ["  ", above, " = zext i1 ", greater, " to i64"], cat ["  ", below, " = zext i1 ", less, " to i64"],
      cat ["  ", quick, " = sub i64 ", above, ", ", below], cat ["  br label %", joined], cat [slow, ":"]] in
    case inline-runtime decided ty entry left right joined of
      (called, general) -> let (done, result) = fresh (line called (cat [joined, ":"])) "%v" in
        (line done (cat ["  ", result, " = phi i64 [ ", quick, ", %", fast, " ], [ ", general, ", %", slow, " ]"]), result)
  -- Two immediates add or subtract in place when the result is one too.
  -- With `a = 2x + 1` and `b = 2y + 1`: `(a - 1) + b` is `2(x + y) + 1`, and
  -- `(a - b) | 1` is `2(x - y) + 1`. The 64-bit operation overflows exactly
  -- when the result leaves the immediate range (unsigned for a `Nat`,
  -- signed for an `Int`), and then the runtime entry builds the answer.
  inline-arithmetic :: Writer -> UType -> String -> String -> String -> String -> (Writer, String)
  inline-arithmetic w ty operation entry left right =
    let (one, fast) = fresh w "immediate" in
    let (two, slow) = fresh one "boxed" in
    let (three, kept) = fresh two "small" in
    let (four, joined) = fresh three "summed" in
    let started = line (inline-immediates four left right fast slow) (cat [fast, ":"]) in
    let (five, lowered) = fresh started "%v" in
    let (six, total) = fresh five "%v" in
    let (seven, overflow) = fresh six "%v" in
    let subtraction = operation == "IntSub" in
    let computed = (if subtraction then
        emit-lines seven [cat ["  ", lowered, " = sub i64 ", left, ", ", right], cat ["  ", total, " = or i64 ", lowered, ", 1"]]
      else emit-lines seven [cat ["  ", lowered, " = sub i64 ", left, ", 1"], cat ["  ", total, " = add i64 ", lowered, ", ", right]]) in
    let (tested, quick) = (if operation == "NatAdd" then
        (line computed (cat ["  ", overflow, " = icmp ult i64 ", total, ", ", right]), total)
      else
        -- Signed overflow: the operands' signs agree with each other (or,
        -- for a difference, disagree) and not with the result's.
        (let (eight, first) = fresh computed "%v" in
         let (nine, second) = fresh eight "%v" in
         let (ten, mixed) = fresh nine "%v" in
         let checked = (if subtraction then
             emit-lines ten [cat ["  ", first, " = xor i64 ", left, ", ", right], cat ["  ", second, " = xor i64 ", left, ", ", lowered]]
           else emit-lines ten [cat ["  ", first, " = xor i64 ", lowered, ", ", total], cat ["  ", second, " = xor i64 ", right, ", ", total]]) in
         (emit-lines checked [cat ["  ", mixed, " = and i64 ", first, ", ", second], cat ["  ", overflow, " = icmp slt i64 ", mixed, ", 0"]], total))) in
    let branched = emit-lines tested [cat ["  br i1 ", overflow, ", label %", slow, ", label %", kept], cat [kept, ":"], cat ["  br label %", joined], cat [slow, ":"]] in
    case inline-runtime branched ty entry left right joined of
      (called, general) -> let (done, result) = fresh (line called (cat [joined, ":"])) "%v" in
        (line done (cat ["  ", result, " = phi i64 [ ", quick, ", %", kept, " ], [ ", general, ", %", slow, " ]"]), result)
  external-call-unit :: List CoreDefinition -> List Local -> Writer -> Span -> RuntimeUnit -> Scheme -> List String -> List CoreTerm -> (Writer, String)
  external-call-unit definitions locals w sp unit sc givens args =
        let evidence-count = list-length (scheme-requirements sc) in
        let native-count = list-length (unit.params) in
        if list-length givens /= evidence-count then unsupported w sp "external function context disagrees with its checked scheme" else
        if evidence-count <= native-count then
        (case external-shape (native-count - evidence-count) (scheme-body sc) [] of
          Some (params, result-type) -> case unit.result of
            Some actual-result -> case class-vector (w.context) (requirement-types (scheme-requirements sc) <> params) of
              Some expected -> case word-class (w.context) result-type of
                Some result -> if not (same-classes expected (unit.params)) || result /= actual-result then unsupported w sp "external function word ABI disagrees with its checked scheme" else
                  let ready = request-demand (ExternalDemand unit) w in
                  let typed = value-llvms (w.context) (requirement-types (scheme-requirements sc) <> params) in
                  if list-length args == list-length params then
                    (case expressions definitions locals ready args of (next, values) -> typed-call next (value-llvm (w.context) result-type) (llvm-object-symbol (unit.symbol)) (typed-values typed (givens <> values)))
                  else if wide-code (result : expected) then unsupported w sp wide-refusal
                  else if list-length args < list-length params then
                    (if native-count > 13 then unsupported w sp "closure shape needs an extended runtime descriptor" else
                    case call ready (llvm-object-symbol (unit.closure)) [] of
                      (next, closure-value) -> case apply-words next closure-value givens of (applied, value) -> apply-terms definitions locals applied value args)
                  else (case expressions definitions locals ready (take-terms (list-length params) args) of
                    (next, values) -> case typed-call next (value-llvm (w.context) result-type) (llvm-object-symbol (unit.symbol)) (typed-values typed (givens <> values)) of

                      (called, value) -> apply-terms definitions locals called value (drop-terms (list-length params) args))
                None -> unsupported w sp (cat ["external function lacks concrete checked word representations: ", unit.symbol, " with checked type ", type-text (scheme-body sc)])
              None -> unsupported w sp (cat ["external function lacks concrete checked word representations: ", unit.symbol, " with checked type ", type-text (scheme-body sc)])
            None -> unsupported w sp (cat ["external function lacks concrete checked word representations: ", unit.symbol, " with checked type ", type-text (scheme-body sc)])
          None -> unsupported w sp "external unit arity exceeds its checked function telescope")
        else unsupported w sp "external function context disagrees with its checked scheme"
  runtime-type-equal :: UType -> UType -> Bool
  runtime-type-equal first second = valid-type first && valid-type second && (case store-errors (unify (Span 0 0 1 1) (without-index-levels first) (without-index-levels second) (empty-store "runtime index carrier")) of [] -> True; other -> False)
  index-expression :: List Local -> Writer -> Span -> UType -> (Writer, String)
  index-expression locals w sp value = if not (typed-index-admissible value) then unsupported w sp "implicit value argument has no solved checked index witness" else case value of
    UIndexConstructor name (UCon owner KType) UEnd -> (case constructor name (writer-program w) of
      Some (declared, tag, ctor) | (owner == declared) && (case core-constructor-fields ctor of [] -> True; other -> False)
        && runtime-type-equal (scheme-body (ctor.constructor-scheme)) (UCon owner KType) ->
          direct-call [] locals w sp name [] []
      other -> unsupported w sp "nullary index constructor needs its checked defining family")
    UIndexMeasure BufferLength input -> (case typed-index-carrier input of
      Some carrier -> (case index-expression locals w sp input of (ready, word) -> length-word ready sp carrier word)
      None -> unsupported w sp "length needs its checked operand carrier")
    UIndexMeasure WordToNat input -> (case index-expression locals w sp input of
      (ready, word) -> call ready "@cinch_nat_from_i64" [word])
    UIndexByteLength input -> (case index-expression locals w sp input of
      (ready, bytes) -> case call ready "@cinch_bytes_len" [bytes] of
        (measured, length) -> case call measured "@cinch_nat_from_i64" [length] of
          (done, result) -> (case value-carrier (type-kind input) of Some carrier -> (count-op False carrier bytes done, result); None -> unsupported done sp "byte index input has no actual carrier"))
    UIndexStringLength (UIndex carrier (IRigid id name level)) -> (case external-binding global-data-string-length (writer-program w) of
      Some binding | string-length-function (UCon "Nat" KType) (scheme-body (checked-scheme binding)) (checked-name binding) (checked-role binding) ->
        external-call [] locals w sp global-data-string-length [] [] [CLocal sp carrier id name []]
      other -> unsupported w sp "string length needs its defining String -> Nat provider")
    UIndexForget input -> index-expression locals w sp input
    UIndexPromote input -> (case value-carrier (type-kind input) of
      Some carrier -> if named carrier "Nat" then (case index-expression locals w sp input of
        (ready, natural) -> case call ready "@cinch_int_from_nat" [natural] of (done, result) -> (count-op False carrier natural done, result))
        else if named carrier "Int" then index-expression locals w sp input else unsupported w sp "index promotion needs its checked mathematical carrier"
      None -> unsupported w sp "index promotion has no actual input carrier")
    UIndexMath op first second -> (case value-carrier (type-kind first) of
      Some carrier -> index-math-expression locals w sp carrier op first second
      None -> unsupported w sp "index arithmetic has no checked carrier")
    other -> (case value-carrier (type-kind value) of
      Some carrier -> case index-of-type value of
        Some (IRigid id name level) -> read-index-local locals w sp id carrier
        Some (ICharacter c) -> if named carrier "Char" then (w, nat-to-string (char-code c)) else unsupported w sp "character index needs its Char carrier"
        Some (IInteger n) -> if number carrier then decimal w carrier (int-to-string n) else if raw-integer carrier then (w, int-to-string n) else if wide-scalar carrier then (w, wide-literal carrier (int-to-string n)) else unsupported w sp "index literal needs a runtime integer carrier"
        Some (IAdd first second) -> index-math-expression locals w sp carrier "+" (UIndex carrier first) (UIndex carrier second)
        Some (ISubtract first second) -> index-math-expression locals w sp carrier "-" (UIndex carrier first) (UIndex carrier second)
        Some (IMultiply first second) -> index-math-expression locals w sp carrier "*" (UIndex carrier first) (UIndex carrier second)
        other -> unsupported w sp "index witness needs checked runtime reification"
      None -> unsupported w sp "index witness needs checked runtime reification")
  index-math-expression :: List Local -> Writer -> Span -> UType -> String -> UType -> UType -> (Writer, String)
  index-math-expression locals w sp carrier operation first second = if not (number carrier) then unsupported w sp "index arithmetic requires a mathematical runtime carrier" else
    let suffix = if operation == "+" then "add" else if operation == "*" then "mul" else "sub" in
    case index-expression locals w sp first of
      (one, a) -> case index-expression locals one sp second of
        (two, b) -> case call two (cat ["@cinch_", runtime-number carrier, "_", suffix]) [a, b] of
          (done, result) -> (count-op False carrier b (count-op False carrier a done), result)
  implicit-value-words :: List Local -> Writer -> Span -> List Quant -> List UType -> (Writer, List String)
  implicit-value-words locals w sp params actuals = case params of
    [] -> case actuals of [] -> (w, []); other -> (refuse w sp "implicit value argument arity disagrees with the checked scheme", [])
    q : rest -> case actuals of
      actual : more -> (case value-carrier (q.kind) of
        Some carrier -> (case index-expression locals w sp actual of
          (ready, word) -> case implicit-value-words locals ready sp rest more of (done, values) -> (done, word : values))
        None -> implicit-value-words locals w sp rest more)
      [] -> (refuse w sp "implicit value argument arity disagrees with the checked scheme", [])
  value-types :: List (Nat, UType) -> List UType
  value-types values = case values of [] -> []; (id, ty) : rest -> ty : (value-types rest)
  runtime-index-locals :: List (Nat, UType) -> Nat -> List Local
  runtime-index-locals values index = case values of [] -> []; (id, ty) : rest -> (Local id ty (cat ["%arg", nat-to-string index])) : (runtime-index-locals rest (index + 1))
  function-call :: List CoreDefinition -> List Local -> Writer -> Span -> CoreDefinition -> List UType -> List Nat -> List String -> List CoreTerm -> (Writer, String)
  function-call definitions locals w sp d actuals classes givens args = case definition-context d classes w of
    Some context -> let parameters = definition-parameters d in
      let required = runtime-givens w d in
      let dependencies = definition-value-dependencies w d in
      let indices = opening-value-types (d.openings) in
      let all-types = value-field-types dependencies <> given-types required <> value-types indices <> pattern-types parameters in
      let count = list-length parameters in
      if list-length givens > list-length required then unsupported w sp "function context exceeds its checked ABI" else
        if list-length givens < list-length required && (list-length args > 0 || list-length indices > 0) then unsupported w sp "implicit values require the complete checked dictionary context" else
        if list-length indices > 0 && (case field-owner (d.name) ((writer-program w).instances) of Some owner -> True; None -> False) then unsupported w sp "dictionary method value parameters need their checked runtime ABI" else
        case definition-self-values d locals w of
          (prepared, saved) -> case (if list-length indices == 0 then (prepared, []) else implicit-value-words locals prepared sp (scheme-params (d.scheme)) actuals) of
            (indexed, witnesses) ->
              let def-ret-class = (case d.clauses of
                (CoreClause _ pats body) : _ -> (case proof-stage-arities pats 0 of
                  [_] -> (case word-class context (core-type body) of Some c -> c; None -> 0)
                  other -> 0)
                [] -> 0) in
              if list-length givens < list-length required || list-length args < count then
              (if wide-type context (final-result (scheme-body (d.scheme))) then unsupported indexed sp wide-refusal else
              case class-vector context all-types of
                Some parameter-classes -> case expressions definitions locals (demand-worker (d.name) classes indexed) args of
                  (ready, values) ->
                    let saved-vals = saved <> givens <> witnesses <> values in
                    let saved-tys = take-types (list-length saved-vals) all-types in
                    closure-with sp (specialized-name (d.name) classes) parameter-classes def-ret-class saved-tys saved-vals ready
                None -> unsupported indexed sp "function parameters need known closure representations")
              else let non-word = definition-has-non-word context d all-types in
                let rem-args = drop-terms count args in
                let over-ret-class = (case rem-args of
                  [] -> 0
                  more -> case d.clauses of
                    (CoreClause _ _ body) : _ -> (case word-class context (peel-arrows (list-length rem-args) (core-type body)) of Some c -> c; None -> 0)
                    [] -> 0) in
                case (if non-word then None else case saved of
                    [] -> (case givens of
                      [] -> (case witnesses of
                        [] -> hash-map-lookup (d.name) (program-borrow-modes (writer-program indexed))
                        other -> None)
                      other -> None)
                    other -> None) of
                  Some mask | list-length mask == count && any-borrowed mask ->
                    let planned = request-demand (BorrowDemand (d.name) classes) indexed in
                    (case eval-borrow-args definitions locals planned (take-terms count args) mask of
                      (ready, values, post-drops) ->
                        case typed-call ready (definition-result-llvm context d) (symbol (cat [specialized-name (d.name) classes, "#b"])) (typed-values (value-llvms context all-types) values) of
                          (called, result) -> apply-terms-class definitions locals (drop-locals post-drops called) result rem-args over-ret-class)
                  other -> case expressions definitions locals (demand-worker (d.name) classes indexed) (take-terms count args) of
                    (ready, values) ->
                      let call-args = typed-values (value-param-llvms context all-types) (saved <> givens <> witnesses <> values) in
                      case definition-sret-result context d of
                        Some (sret-attr, sz, al) ->
                          let (w1, retbuf) = fresh ready "%sret" in
                          let w2 = line w1 (cat ["  ", retbuf, " = alloca [", nat-to-string sz, " x i8], align ", nat-to-string al]) in
                          let sret-arg = cat ["ptr sret([", nat-to-string sz, " x i8]) align ", nat-to-string al, " ", retbuf] in
                          let called = line w2 (cat ["  call void ", symbol (specialized-name (d.name) classes), "(", join (sret-arg : (typed-arguments call-args)), ")"]) in
                          apply-terms-class definitions locals called retbuf rem-args over-ret-class
                        None -> case typed-call ready (definition-result-llvm context d) (symbol (specialized-name (d.name) classes)) call-args of
                          (called, result) -> apply-terms-class definitions locals called result rem-args over-ret-class
    None -> unsupported w sp "function parameters need first-order or erased representation classes"
  -- Evaluate arguments for a borrowed-parameter worker call:
  -- local variables at borrowed positions pass directly without dup/drop;
  -- computed expressions at borrowed positions are dropped right after the call.
  eval-borrow-args :: List CoreDefinition -> List Local -> Writer -> List CoreTerm -> List Bool -> (Writer, List String, List Local)
  eval-borrow-args definitions locals w args mask = case args of
    [] -> (w, [], [])
    arg : rest -> case mask of
      True : more -> case borrowed-local-word locals arg of
        Some word -> case eval-borrow-args definitions locals w rest more of
          (done, vals, drops) -> (done, word : vals, drops)
        None -> case expression definitions locals w arg of
          (ready, val) -> case eval-borrow-args definitions locals ready rest more of
            (done, vals, drops) -> (done, val : vals, (Discard (core-type arg) val) : drops)
      False : more -> case expression definitions locals w arg of
        (ready, val) -> case eval-borrow-args definitions locals ready rest more of
          (done, vals, drops) -> (done, val : vals, drops)
      [] -> case expression definitions locals w arg of
        (ready, val) -> case eval-borrow-args definitions locals ready rest [] of
          (done, vals, drops) -> (done, val : vals, drops)
  -- A call whose arguments and result travel at their own LLVM types.
  typed-call :: Writer -> String -> String -> List (String, String) -> (Writer, String)
  typed-call w result name args = let (next, value) = fresh w "%v" in
    (line next (cat ["  ", value, " = call ", result, " ", name, "(", join (typed-arguments args), ")"]), value)
  typed-arguments :: List (String, String) -> List String
  typed-arguments args = case args of [] -> []; (ty, value) : rest -> (cat [ty, " ", value]) : (typed-arguments rest)
  -- The type left once every arrow of a telescope is applied.
  final-result :: UType -> UType
  final-result ty = case arrow-shape (base ty) of
    UFun domain result -> final-result result
    UFunEff domain row result -> final-result result
    UPi id name domain row result -> final-result result
    UProofFun predicate row result -> final-result result
    other -> ty
  -- The LLVM result of a definition's first worker. Only a worker without
  -- a proof continuation returns its body's value; a staged one returns the
  -- continuation closure.
  definition-result-llvm :: RuntimeContext -> CoreDefinition -> String
  definition-result-llvm context d = case d.clauses of
    (CoreClause sp patterns body) : rest -> (case proof-stage-arities patterns 0 of
      [count] -> value-llvm context (core-type body)
      other -> "i64")
    [] -> "i64"
  definition-wide-result :: Writer -> CoreDefinition -> List Nat -> Bool
  definition-wide-result w d classes = case definition-context d classes w of
    Some context -> wide-type context (final-result (scheme-body (d.scheme)))
    None -> False
  instance-definitions :: List CoreInstance -> List CoreDefinition
  instance-definitions instances = case instances of [] -> []; first : rest -> field-definitions (first.fields) <> instance-definitions rest
  field-definitions :: List CoreDictionaryField -> List CoreDefinition
  field-definitions fields = case fields of [] -> []; first : rest -> (first.field-definition) : (field-definitions rest)
  instance-named :: String -> List CoreInstance -> Option CoreInstance
  instance-named name instances = case instances of [] -> None; first : rest -> if name == first.name then Some first else instance-named name rest
  field-named :: String -> List CoreDictionaryField -> Option CoreDictionaryField
  field-named name fields = case fields of [] -> None; first : rest -> if name == first.field-definition.name then Some first else field-named name rest
  field-owner :: String -> List CoreInstance -> Option CoreInstance
  field-owner name instances = case instances of [] -> None; first : rest -> case field-named name (first.fields) of Some field -> Some first; None -> field-owner name rest
  take-givens :: Nat -> List CoreGiven -> List CoreGiven
  take-givens count givens = if count == 0 then [] else case givens of [] -> []; first : rest -> first : (take-givens (count - 1) rest)
  drop-givens :: Nat -> List CoreGiven -> List CoreGiven
  drop-givens count givens = if count == 0 then givens else case givens of [] -> []; first : rest -> drop-givens (count - 1) rest
  remove-given :: Nat -> List CoreGiven -> List CoreGiven
  remove-given index givens = case givens of [] -> []; first : rest -> if index == 0 then rest else first : (remove-given (index - 1) rest)
  runtime-givens :: Writer -> CoreDefinition -> List CoreGiven
  runtime-givens w d = case field-owner (d.name) ((writer-program w).instances) of
    Some owner -> remove-given (list-length (scheme-requirements (owner.scheme))) (d.givens)
    None -> d.givens
  given-types :: List CoreGiven -> List UType
  given-types givens = case givens of [] -> []; first : rest -> (first.ty) : (given-types rest)
  given-bindings :: List CoreGiven -> Nat -> List Local
  given-bindings givens index = case givens of [] -> []; first : rest -> (GivenLocal (first.symbol) (first.ty) (cat ["%arg", nat-to-string index])) : (given-bindings rest (index + 1))
  given-roots :: List CoreGiven -> Nat -> List Local
  given-roots givens index = case givens of [] -> []; first : rest -> (Discard (first.ty) (cat ["%arg", nat-to-string index])) : (given-roots rest (index + 1))
  given-word :: String -> List Local -> Option (UType, String)
  given-word symbol locals = case locals of
    [] -> None
    (GivenLocal name ty word) : rest -> if name == symbol then Some (ty, word) else given-word symbol rest
    other : rest -> given-word symbol rest
  known-self :: String -> List Local -> Option Local
  known-self symbol locals = case locals of
    [] -> None
    (KnownSelf name owner classes context) : rest -> if symbol == name then Some (KnownSelf name owner classes context) else known-self symbol rest
    other : rest -> known-self symbol rest
  self-binding :: Writer -> CoreDefinition -> List Nat -> List Local
  self-binding w d classes = case field-owner (d.name) ((writer-program w).instances) of
    Some owner -> let count = list-length (scheme-requirements (owner.scheme)) in
      (case drop-givens count (d.givens) of
        self : rest -> [KnownSelf (self.symbol) (owner.name) (take-classes (type-param-count (scheme-params (owner.scheme))) classes) (take-givens count (d.givens))]
        [] -> [])
    None -> []
  field-present :: Nat -> List CoreDictionaryField -> Bool
  field-present slot fields = case fields of [] -> False; first : rest -> first.field-slot == slot || field-present slot rest
  merge-value-fields :: List CoreDictionaryField -> List CoreDictionaryField -> List CoreDictionaryField
  merge-value-fields first second = case first of
    [] -> second
    field : rest -> if field-present (field.field-slot) second then merge-value-fields rest second else field : (merge-value-fields rest second)
  method-seen :: String -> List String -> Bool
  method-seen name names = case names of [] -> False; first : rest -> name == first || method-seen name rest
  value-dependencies :: Writer -> CoreInstance -> CoreDefinition -> List String -> List CoreDictionaryField
  value-dependencies w owner d seen = if method-seen (d.name) seen then [] else
    case drop-givens (list-length (scheme-requirements (owner.scheme))) (d.givens) of
      self : rest -> clause-value-dependencies w owner (self.symbol) ((d.name) : seen) (d.clauses)
      [] -> []
  clause-value-dependencies :: Writer -> CoreInstance -> String -> List String -> List CoreClause -> List CoreDictionaryField
  clause-value-dependencies w owner key seen clauses = case clauses of
    [] -> []
    (CoreClause sp patterns body) : rest -> merge-value-fields (term-value-dependencies w owner key seen body) (clause-value-dependencies w owner key seen rest)
  term-value-dependencies :: Writer -> CoreInstance -> String -> List String -> CoreTerm -> List CoreDictionaryField
  term-value-dependencies w owner key seen term = case term of
    CMethod sp ty name description slot actuals ((CEGiven at given-ty symbol) : extra) ->
      if key == symbol then (case field-at slot (owner.fields) of
        Some field -> if strict-value-field w owner field then [field] else value-dependencies w owner (field.field-definition) seen
        None -> []) else []
    CApply sp ty first second -> merge-value-fields (term-value-dependencies w owner key seen first) (term-value-dependencies w owner key seen second)
    CApplyEff sp ty row first second -> merge-value-fields (term-value-dependencies w owner key seen first) (term-value-dependencies w owner key seen second)
    CErasedApply sp ty row f witness -> term-value-dependencies w owner key seen f
    CLambda sp ty pattern body -> term-value-dependencies w owner key seen body
    CLet sp ty id name sc value body -> merge-value-fields (term-value-dependencies w owner key seen value) (term-value-dependencies w owner key seen body)
    CRecursiveFunctions sp ty members body ->
      recursive-value-dependencies w owner key seen (body : (recursive-functions members))
    CRecursiveValues sp ty region members body ->
      recursive-value-dependencies w owner key seen (recursive-functions members <> [body])
    CScope sp ty region evidence callback -> term-value-dependencies w owner key seen callback
    CMemoScope sp ty region body -> term-value-dependencies w owner key seen body
    CSpawn sp ty token body -> merge-value-fields (term-value-dependencies w owner key seen token) (term-value-dependencies w owner key seen body)
    CJoin sp ty token body -> merge-value-fields (term-value-dependencies w owner key seen token) (term-value-dependencies w owner key seen body)
    CWith sp ty given value body -> merge-value-fields (term-value-dependencies w owner key seen value) (term-value-dependencies w owner key seen body)
    CIf sp ty condition yes no -> merge-value-fields (term-value-dependencies w owner key seen condition) (merge-value-fields (term-value-dependencies w owner key seen yes) (term-value-dependencies w owner key seen no))
    CCase sp ty value alternatives -> merge-value-fields (term-value-dependencies w owner key seen value) (term-value-dependencies w owner key seen alternatives)
    CTuple sp ty fields -> term-value-dependencies w owner key seen fields
    CPolyIntro sp ty poly-ids fields -> term-value-dependencies w owner key seen fields
    CPolyElim sp ty fields poly-args -> term-value-dependencies w owner key seen fields
    CPrimitive sp ty op args -> term-value-dependencies w owner key seen args
    CProved sp ty evidence body -> term-value-dependencies w owner key seen body
    CRefine sp ty evidence body -> term-value-dependencies w owner key seen body
    CForget sp ty body -> term-value-dependencies w owner key seen body
    CCast sp ty body -> term-value-dependencies w owner key seen body
    CRequire sp ty body -> term-value-dependencies w owner key seen body
    CDischarge sp ty evidence _ body -> term-value-dependencies w owner key seen body
    CGuard sp ty guard body -> merge-value-fields (term-value-dependencies w owner key seen guard) (term-value-dependencies w owner key seen body)
    CArgument sp first rest -> merge-value-fields (term-value-dependencies w owner key seen first) (term-value-dependencies w owner key seen rest)
    CAlternative sp pattern body rest -> merge-value-fields (term-value-dependencies w owner key seen body) (term-value-dependencies w owner key seen rest)
    other -> []
  recursive-value-dependencies :: Writer -> CoreInstance -> String -> List String -> List CoreTerm -> List CoreDictionaryField
  recursive-value-dependencies w owner key seen terms = case terms of
    [] -> []
    first : rest -> merge-value-fields (term-value-dependencies w owner key seen first)
      (recursive-value-dependencies w owner key seen rest)
  definition-value-dependencies :: Writer -> CoreDefinition -> List CoreDictionaryField
  definition-value-dependencies w d = case field-owner (d.name) ((writer-program w).instances) of
    Some owner -> value-dependencies w owner d []
    None -> []
  value-field-types :: List CoreDictionaryField -> List UType
  value-field-types fields = case fields of [] -> []; first : rest -> (scheme-body (first.field-definition.scheme)) : (value-field-types rest)
  self-value-word :: String -> Nat -> List Local -> Option (UType, String)
  self-value-word owner slot locals = case locals of
    [] -> None
    (SelfValue name index ty word) : rest -> if owner == name && slot == index then Some (ty, word) else self-value-word owner slot rest
    other : rest -> self-value-word owner slot rest
  copy-self-values :: String -> List CoreDictionaryField -> List Local -> Writer -> (Writer, List String)
  copy-self-values owner fields locals w = case fields of
    [] -> (w, [])
    field : rest -> case self-value-word owner (field.field-slot) locals of
      Some (ty, word) -> case copy-self-values owner rest locals (count-op True ty word w) of (done, values) -> (done, word : values)
      None -> (refuse w (Span 0 0 1 1) "self value dependency is absent from its initialized environment", [])
  definition-self-values :: CoreDefinition -> List Local -> Writer -> (Writer, List String)
  definition-self-values d locals w = case field-owner (d.name) ((writer-program w).instances) of
    Some owner -> copy-self-values (owner.name) (definition-value-dependencies w d) locals w
    None -> (w, [])
  self-value-bindings :: String -> List CoreDictionaryField -> Nat -> List Local
  self-value-bindings owner fields index = case fields of
    [] -> []
    first : rest -> (SelfValue owner (first.field-slot) (scheme-body (first.field-definition.scheme)) (cat ["%arg", nat-to-string index])) : (self-value-bindings owner rest (index + 1))
  worker-self-values :: Writer -> CoreDefinition -> List CoreDictionaryField -> List Local
  worker-self-values w d fields = case field-owner (d.name) ((writer-program w).instances) of Some owner -> self-value-bindings (owner.name) fields 0; None -> []
  self-values-used :: String -> CoreTerm -> List Local -> Bool
  self-values-used owner body locals = case locals of
    [] -> False
    (KnownSelf key name classes context) : rest -> (owner == name && given-uses key body) || self-values-used owner body rest
    other : rest -> self-values-used owner body rest
  strict-fields :: Writer -> CoreInstance -> List CoreDictionaryField -> List CoreDictionaryField
  strict-fields w owner fields = case fields of [] -> []; first : rest -> if strict-value-field w owner first then first : (strict-fields w owner rest) else strict-fields w owner rest
  values-ready :: String -> List CoreDictionaryField -> List Local -> Bool
  values-ready owner fields locals = case fields of [] -> True; first : rest -> (case self-value-word owner (first.field-slot) locals of Some value -> True; None -> False) && values-ready owner rest locals
  ready-value :: Writer -> CoreInstance -> List Local -> List CoreDictionaryField -> List CoreDictionaryField -> Option (CoreDictionaryField, List CoreDictionaryField)
  ready-value w owner locals before fields = case fields of
    [] -> None
    first : rest -> if values-ready (owner.name) (value-dependencies w owner (first.field-definition) []) locals then Some (first, before <> rest) else ready-value w owner locals (before <> [first]) rest
  initialize-values :: List CoreDefinition -> CoreInstance -> List Nat -> List CoreGiven -> List Local -> String -> List CoreDictionaryField -> Writer -> (Writer, List Local)
  initialize-values definitions owner classes context locals pointer fields w = case fields of
    [] -> (w, locals)
    first : rest -> case ready-value w owner locals [] fields of
      None -> (refuse w (Span 0 0 1 1) "cyclic strict dictionary values need recursive environment lowering", locals)
      Some (selected, pending) -> let d = selected.field-definition in
        case copy-givens context locals w of
          (copied, values) -> case function-call definitions locals copied (Span 0 0 1 1) d [] classes values [] of
            (ready, word) -> initialize-values definitions owner classes context ((SelfValue (owner.name) (selected.field-slot) (scheme-body (d.scheme)) word) : locals) pointer pending (store-one ready pointer (1 + selected.field-slot) word)
  dictionary-name :: String -> List Nat -> String
  dictionary-name name classes = cat [specialized-name name classes, ".dictionary"]
  copy-givens :: List CoreGiven -> List Local -> Writer -> (Writer, List String)
  copy-givens givens locals w = case givens of
    [] -> (w, [])
    first : rest -> case given-word (first.symbol) locals of
      Some (ty, value) -> case copy-givens rest locals (count-op True ty value w) of (done, values) -> (done, value : values)
      None -> (refuse w (Span 0 0 1 1) "factory context is absent from its actual lexical scope", [])
  evidence-values :: List CoreDefinition -> List Local -> Writer -> CoreEvidence -> (Writer, List String)
  evidence-values definitions locals w args = case args of
    CEArgumentsEnd sp -> (w, [])
    CEArgument sp first rest -> case evidence-value definitions locals w first of
      (ready, value) -> case evidence-values definitions locals ready rest of (done, values) -> (done, value : values)
    other -> (refuse w (Span 0 0 1 1) "malformed dictionary evidence argument spine", [])
  evidences :: List CoreDefinition -> List Local -> Writer -> List CoreEvidence -> (Writer, List String)
  evidences definitions locals w args = case args of
    [] -> (w, [])
    first : rest -> case evidence-value definitions locals w first of
      (ready, value) -> case evidences definitions locals ready rest of (done, values) -> (done, value : values)
  strict-value-field :: Writer -> CoreInstance -> CoreDictionaryField -> Bool
  strict-value-field w owner field = let d = field.field-definition in
    list-length (definition-parameters d) == 0 && list-length (runtime-givens w d) == list-length (scheme-requirements (owner.scheme))
  has-strict-values :: Writer -> CoreInstance -> List CoreDictionaryField -> Bool
  has-strict-values w owner fields = case fields of [] -> False; first : rest -> strict-value-field w owner first || has-strict-values w owner rest
  evidence-value :: List CoreDefinition -> List Local -> Writer -> CoreEvidence -> (Writer, String)
  evidence-value definitions locals w evidence = case evidence of
    CECopy sp carrier -> if copy-marker-carrier carrier then (w, "0") else unsupported w sp "invalid structural Copy marker"
    CEKernel sp carrier -> if kernel-marker-carrier carrier then (w, "0") else unsupported w sp "invalid structural Kernel marker"
    CEBoxed sp carrier -> if boxed-marker-carrier carrier && not (is-value-type (w.context) carrier) then (w, "0") else unsupported w sp "invalid structural Boxed marker"
    CEGiven sp ty symbol -> (case known-self symbol locals of
      Some (KnownSelf name owner classes context) -> case instance-named owner ((writer-program w).instances) of
        Some factory -> if has-strict-values w factory (factory.fields) then unsupported w sp "materializing self evidence with strict value fields needs initialization dependencies" else
          (case copy-givens context locals w of (ready, values) -> call (request-demand (DictionaryDemand owner classes) ready) (symbol-for-dictionary owner classes) values)
        None -> unsupported w sp "self evidence has no checked factory factory"
      other -> case given-word symbol locals of
        Some (actual, word) -> (count-op True actual word w, word)
        None -> unsupported w sp "dictionary evidence is absent from its lexical scope")
    CEInstance sp ty name actuals args -> case instance-named name ((writer-program w).instances) of
      Some factory -> case scheme-classes (w.context) (scheme-params (factory.scheme)) actuals of
        Some classes -> case evidence-values definitions locals w args of
          (ready, values) -> if list-length values == list-length (scheme-requirements (factory.scheme)) then
            call (request-demand (DictionaryDemand name classes) ready) (symbol-for-dictionary name classes) values
            else unsupported ready sp "factory factory context arity disagrees with checked evidence"
        None -> unsupported w sp "factory factory needs runtime representation specialization"
      None -> external-evidence definitions locals w sp ty name actuals args
    other -> unsupported w (Span 0 0 1 1) "unresolved dictionary evidence cannot be lowered"
  instance-binding :: String -> ProgramInfo -> Option CheckedBinding
  instance-binding name info = case program-callable-bindings info of
    CallableBindings methods externals instances bodies natives -> hash-map-lookup name instances
  extend-context :: List (Nat, Nat) -> RuntimeContext -> RuntimeContext
  extend-context bindings context = case context of RuntimeContext info bounds rigids queue inlining -> RuntimeContext info (bindings <> bounds) rigids queue inlining
  external-field-map :: Writer -> CoreClass -> Scheme -> List Nat -> List (Nat, Nat, List Nat) -> Option (List Nat)
  external-field-map w description factory factory-codes slots = case slots of
    [] -> Some []
    (logical, physical, codes) : rest -> (case method-at logical (description.methods) of
      Some member -> (case specialize-method description factory member of
        Some sc -> (case class-bindings (scheme-params sc) (factory-codes <> codes) of
          Some bindings -> (case word-class (extend-context bindings (w.context)) (scheme-body sc) of
            Some code -> case external-field-map w description factory factory-codes rest of
              Some more -> Some ((if list-length (scheme-requirements sc) == 0 then code else 1) : more)
              None -> None
            None -> None)
          None -> None)
        None -> None)
      None -> None)
  external-evidence :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> String -> List UType -> CoreEvidence -> (Writer, String)
  external-evidence definitions locals w sp ty name actuals args = case (writer-program w).object of
    Some provider -> case instance-binding name (writer-program w) of
      Some binding -> (case scheme-classes (w.context) (scheme-params (checked-scheme binding)) actuals of
        Some codes -> (case object-dictionary name codes provider of
          Some (unit, owner, context-count, fields) ->
            let factory = checked-scheme binding in
            let sc = concrete-scheme factory actuals in
            (case class-owner (scheme-body sc) of
              Some actual-owner -> case find-class owner ((writer-program w).classes) of
                Some description -> case object-family owner provider of
                  Some (declared, slots) -> if owner /= actual-owner || declared /= list-length (description.methods) || context-count /= list-length (scheme-requirements sc) then unsupported w sp "external factory disagrees with its checked class or context" else
                    -- Specialize the closed declaration. The instantiated use can
                    -- contain caller-local rigid variables, including phantom types.
                    (case unit.result of
                      Some 1 -> case external-field-map w description factory codes slots of
                        Some expected-fields -> case class-vector (w.context) (requirement-types (scheme-requirements sc)) of
                          Some expected-params -> if not (same-classes expected-fields fields && same-classes expected-params (unit.params)) then unsupported w sp "external factory word ABI disagrees with its checked class fields" else
                            (case evidence-values definitions locals w args of
                              (ready, values) -> if list-length values /= context-count then unsupported ready sp "external factory context arity disagrees with checked evidence" else
                                call (request-demand (ExternalDemand unit) ready) (llvm-object-symbol (unit.symbol)) values)
                          None -> unsupported w sp "external factory lacks checked runtime field representations"
                        None -> unsupported w sp "external factory lacks checked runtime field representations"
                      other -> unsupported w sp "external factory lacks checked runtime field representations")
                  None -> unsupported w sp "external factory has no matching checked method family"
                None -> unsupported w sp "external factory has no matching checked method family"
              None -> unsupported w sp "external factory has no matching checked method family")
          None -> unsupported w sp (cat ["checked factory variant is absent from the runtime object: ", name, " [", native-classes codes, "]"]))
        None -> unsupported w sp "external factory needs checked representation specialization")
      None -> unsupported w sp (cat ["checked factory has no executable source factory: ", name])
    None -> unsupported w sp (cat ["checked factory has no executable source factory: ", name])
  symbol-for-dictionary :: String -> List Nat -> String
  symbol-for-dictionary name classes = symbol (dictionary-name name classes)
  method-at :: Nat -> List CoreClassMethod -> Option CoreClassMethod
  method-at slot methods = case methods of [] -> None; first : rest -> if class-method-slot first == slot then Some first else method-at slot rest
  class-owner :: UType -> Option String
  class-owner ty = case type-head ty of UCon name kind -> Some name; other -> None
  -- A static instance names its method's defining unit, so a projection
  -- out of the instance dictionary followed by an indirect apply is a
  -- direct call to that unit at the method's own representation. The
  -- result is the representation codes to specialize the unit with and the
  -- unit itself; a factory with a context, a strict value field or a
  -- method the unit cannot be reached from keeps the projection.
  static-instance-method :: Writer -> String -> String -> Nat -> List UType -> List CoreEvidence -> Option (List Nat, List Nat, CoreDefinition)
  static-instance-method w name owner slot actuals evidence = case evidence of
    [first] -> case first of
      CEInstance sp ty factory factory-actuals (CEArgumentsEnd end) -> static-instance-method-at w name owner slot actuals factory factory-actuals
      other -> None
    other -> None
  static-instance-method-at :: Writer -> String -> String -> Nat -> List UType -> String -> List UType -> Option (List Nat, List Nat, CoreDefinition)
  static-instance-method-at w name owner slot actuals factory factory-actuals =
      if not (method-reference name owner slot (writer-program w)) then None else
      (case instance-named factory ((writer-program w).instances) of
        Some candidate -> if (case scheme-requirements (candidate.scheme) of [] -> True; other -> False) then
          (case class-owner (scheme-body (candidate.scheme)) of
            Some actual -> if owner /= actual then None else
              (case field-at slot (candidate.fields) of
                Some field -> if strict-value-field w candidate field then None else
                  (case find-class owner ((writer-program w).classes) of
                    Some description -> case method-at slot (class-methods-of owner w) of
                      Some member -> case method-own-classes w member actuals of
                        Some own-codes -> case scheme-classes (w.context) (scheme-params (candidate.scheme)) factory-actuals of
                          Some classes -> let codes = classes <> own-codes in let d = field.field-definition in
                            if (case runtime-givens w d of [] -> True; other -> False)
                              && (case definition-value-dependencies w d of [] -> True; other -> False)
                              && (case d.openings of [] -> True; other -> False)
                              && (case d.clauses of [] -> False; other -> True)
                              && (case definition-context d codes w of Some context -> True; None -> False)
                              then Some (codes, own-codes, d) else None
                          None -> None
                        None -> None
                      None -> None
                    None -> None)
                None -> None)
            None -> None)
          else None
        None -> None)
  -- The declared methods of a class, in slot order, without demanding the
  -- class again at each caller.
  class-methods-of :: String -> Writer -> List CoreClassMethod
  class-methods-of owner w = case find-class owner ((writer-program w).classes) of
    Some description -> description.methods
    None -> []
  method-value :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> String -> String -> Nat -> List UType -> List CoreEvidence -> (Writer, String)
  method-value definitions locals w sp ty name owner slot actuals evidence =
    case static-instance-method w name owner slot actuals evidence of
      Some (codes, own-codes, d) -> function-call definitions locals (note-version owner slot own-codes w) sp d [] codes [] []
      None -> projected-method-value definitions locals w sp ty name owner slot actuals evidence
  projected-method-value :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> String -> String -> Nat -> List UType -> List CoreEvidence -> (Writer, String)
  projected-method-value definitions locals w sp ty name owner slot actuals evidence = case find-class owner ((writer-program w).classes) of
    Some description -> case method-at slot (description.methods) of
      Some member -> if not (method-reference name owner slot (writer-program w)) then unsupported w sp (cat ["dictionary field does not belong to the checked global method: ", name]) else
        (case method-own-classes w member actuals of
          None -> unsupported w sp "method type arguments need runtime representation classes"
          Some own-codes -> let prepared = note-version owner slot own-codes w in
            (case evidence of
              self : rest -> case self of
                CEGiven at given-ty given-name -> (case known-self given-name locals of
                  Some (KnownSelf key instance-name classes context) ->
                    self-method definitions locals prepared sp ty name owner slot classes own-codes instance-name context rest
                  other -> project-method definitions locals prepared sp ty description slot own-codes self rest)
                other -> project-method definitions locals prepared sp ty description slot own-codes self rest
              [] -> unsupported w sp "method has no checked receiver evidence"))
      None -> unsupported w sp "method slot is absent from its declaring class"
    None -> unsupported w sp (cat ["method has no checked declaring class: ", owner, ".", name])
  self-method :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> String -> String -> Nat -> List Nat -> List Nat -> String -> List CoreGiven -> List CoreEvidence -> (Writer, String)
  self-method definitions locals w sp ty name owner slot classes own-codes factory context extra = case instance-named factory ((writer-program w).instances) of
    Some factory -> if (case class-owner (scheme-body (factory.scheme)) of Some actual -> owner == actual; None -> False) then
      (case field-at slot (factory.fields) of
        Some field -> if strict-value-field w factory field then
          if list-length own-codes > 0 then unsupported w sp "polymorphic strict self values need representation-indexed initialization" else
          (case self-value-word (factory.name) slot locals of
            Some (actual, word) -> if list-length extra == 0 then (count-op True actual word w, word) else unsupported w sp "a strict value field cannot consume extra method evidence"
            None -> unsupported w sp "self value was used before its dictionary slot was initialized")
          else case copy-givens context locals w of
            (copied, prefix) -> case evidences definitions locals copied extra of
              (ready, more) -> function-call definitions locals ready sp (field.field-definition) [] (classes <> own-codes) (prefix <> more) []
        None -> unsupported w sp "self method is absent from its actual factory")
      else unsupported w sp "self evidence disagrees with the selected declaring class"
    None -> unsupported w sp "self method has no actual checked factory"
  project-method :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreClass -> Nat -> List Nat -> CoreEvidence -> List CoreEvidence -> (Writer, String)
  project-method definitions locals w sp ty description slot own-codes receiver extra = case method-physical-slot slot own-codes (class-method-slots w description) of
    Some physical -> dynamic-method definitions locals w sp ty physical receiver extra
    None -> unsupported w sp (cat ["method representation has no planned declaring-class slot: ", description.name, ":", nat-to-string slot, " [", native-classes own-codes, "]"])
  dynamic-method :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> Nat -> CoreEvidence -> List CoreEvidence -> (Writer, String)
  dynamic-method definitions locals w sp ty slot receiver extra = case evidence-value definitions locals w receiver of
    (ready, dictionary) -> let (one, pointer) = fresh ready "%ptr" in
      case load-word (line one (cat ["  ", pointer, " = inttoptr i64 ", dictionary, " to ptr"])) pointer (nat-to-string (1 + slot)) of
        (loaded, field) ->
          let field-ty = case extra of [] -> ty; other -> UFun (UCon "Unit" KType) ty in
          let retained = count-op True field-ty field loaded in
          let released = count-op False (evidence-type receiver) dictionary retained in
          case evidences definitions locals released extra of
            (given, values) -> apply-values given field values
  apply-values :: Writer -> String -> List String -> (Writer, String)
  apply-values w function values = case values of [] -> (w, function); first : rest -> case apply-one w function first of (done, result) -> apply-values done result rest
  -- A dictionary's description covers its slots, which follow its raw
  -- method-count word.
  request-dictionary-shape :: Span -> List Nat -> Writer -> (Writer, Nat)
  request-dictionary-shape sp classes w = if wide-code classes then (refuse w sp wide-refusal, 0) else if val-code classes then (refuse w sp val-refusal, 0) else if list-length classes > 15 then (refuse w sp "dictionary needs an extended runtime descriptor", 0)
    else (w, shape-description 3 0 classes)
  dictionary-map :: CoreInstance -> List MethodSlot -> Writer -> Option (List Nat)
  dictionary-map owner fields w = case fields of
    [] -> Some []
    (MethodSlot logical physical own-codes) : rest -> case field-at logical (owner.fields) of
      Some field -> let d = field.field-definition in
        (case dictionary-map owner rest w of
          Some more -> if strict-value-field w owner field then
            if list-length own-codes > 0 then None else (case word-class (w.context) (scheme-body (d.scheme)) of Some code -> Some (code : more); None -> None)
            else Some (1 : more)
          None -> None)
      None -> None
  factory-bindings :: List Requirement -> Nat -> List CoreGiven
  factory-bindings requirements index = case requirements of [] -> []; first : rest -> (CoreGiven (Span 0 0 1 1) (cat ["#factory-", nat-to-string index]) (first.ty)) : (factory-bindings rest (index + 1))
  dictionary-fields :: List CoreDefinition -> CoreInstance -> List Nat -> List CoreGiven -> List Local -> String -> List MethodSlot -> Writer -> Writer
  dictionary-fields definitions owner classes context locals pointer fields w = case fields of
    [] -> w
    (MethodSlot logical physical own-codes) : rest -> case field-at logical (owner.fields) of
      Some field -> if strict-value-field w owner field then dictionary-fields definitions owner classes context locals pointer rest w else
        let d = field.field-definition in
        if definition-wide-result w d (classes <> own-codes) then refuse w (Span 0 0 1 1) wide-refusal else
        (case copy-givens context locals w of
          (copied, values) -> case function-call definitions locals copied (Span 0 0 1 1) d [] (classes <> own-codes) values [] of
            (ready, value) -> let stored = store-one ready pointer (1 + physical) value in
              dictionary-fields definitions owner classes context locals pointer rest stored)
      None -> refuse w (Span 0 0 1 1) "planned dictionary slot has no actual instance method"
  store-one :: Writer -> String -> Nat -> String -> Writer
  store-one w pointer index value = let (ready, slot) = fresh w "%ptr" in
    line (line ready (cat ["  ", slot, " = getelementptr i64, ptr ", pointer, ", i64 ", nat-to-string index])) (cat ["  store i64 ", value, ", ptr ", slot])
  zeros :: Nat -> List String
  zeros count = if count == 0 then [] else "0" : (zeros (count - 1))
  dictionary-worker :: List CoreDefinition -> String -> List Nat -> Writer -> Writer
  dictionary-worker definitions name classes w = case instance-named name ((writer-program w).instances) of
    Some factory -> case class-owner (scheme-body (factory.scheme)) of
      Some owner -> (case find-class owner ((writer-program w).classes) of
        Some description -> dictionary-worker-planned definitions factory classes (class-method-slots w description) w
        None -> refuse w (Span 0 0 1 1) "dictionary has no checked declaring class")
      None -> refuse w (Span 0 0 1 1) "dictionary target has no declaring class identity"
    None -> refuse w (Span 0 0 1 1) "factory has no checked source implementation"
  dictionary-worker-planned :: List CoreDefinition -> CoreInstance -> List Nat -> List MethodSlot -> Writer -> Writer
  dictionary-worker-planned definitions factory classes plans w = case class-bindings (scheme-params (factory.scheme)) classes of
      Some bounds ->
        let scoped = with-representations bounds [] w in
        let context = factory-bindings (scheme-requirements (factory.scheme)) 0 in
        case dictionary-map factory plans scoped of
          Some fields -> case request-dictionary-shape (Span 0 0 1 1) fields scoped of
            (planned, descriptor) ->
              let started = line (line planned (cat ["define ", worker-linkage planned (dictionary-name (factory.name) classes), "i64 ", symbol-for-dictionary (factory.name) classes, "(", join (argument-words (value-parameters (list-length context) 0)), ")", worker-open w])) "entry:" in
              let count = list-length fields in
              let fixed = if list-length context == 0 && not (has-strict-values started factory (factory.fields)) then static-dictionary-fields factory classes count plans started else None in
              case fixed of
                Some (ready, words) ->
                  let (declared, storage) = fresh-scoped ready "dictionary" in
                  let skip = static-prefix-words descriptor in
                  let block = cat ["[", nat-to-string (count + 2 + skip), " x i64]"] in
                  let stored = static-block declared storage descriptor 3 ((StaticBits count) : (physical-words 0 count words)) in
                  let (done, result) = fresh stored "%v" in
                  line (line (line done (cat ["  ", result, " = ptrtoint ptr getelementptr inbounds (", block, ", ptr ", storage, ", i64 0, i64 ", nat-to-string (1 + skip), ") to i64"])) (cat ["  ret i64 ", result])) "}"
                None ->
                  let (one, pointer) = fresh started "%ptr" in
                  let allocated = shaped-allocation one pointer (nat-to-string (8 * (1 + count))) 3 descriptor in
                  let initialized = store-fields allocated pointer 0 ((nat-to-string count) : (zeros count)) in
                  case initialize-values definitions factory classes context (given-bindings context 0) pointer (strict-fields initialized factory (factory.fields)) initialized of
                    (values, locals) -> let filled = dictionary-fields definitions factory classes context locals pointer plans values in
                      let (done, result) = fresh (drop-locals (given-roots context 0) filled) "%v" in
                      line (line (line done (cat ["  ", result, " = ptrtoint ptr ", pointer, " to i64"])) (cat ["  ret i64 ", result])) "}"
          None -> refuse scoped (Span 0 0 1 1) "dictionary field has no runtime representation"
      None -> refuse w (Span 0 0 1 1) "factory factory needs first-order or erased parameters"
  -- A factory without context whose every method lowers to a closure that
  -- saves nothing returns one immortal data-section dictionary
  -- { nmeth; methods... } whose methods are static closures.
  static-dictionary-fields :: CoreInstance -> List Nat -> Nat -> List MethodSlot -> Writer -> Option (Writer, List (Nat, String))
  static-dictionary-fields owner classes count plans w = case plans of
    [] -> Some (w, [])
    (MethodSlot logical physical own-codes) : rest -> if physical >= count then None else case field-at logical (owner.fields) of
      Some field -> let d = field.field-definition in
        let actual = classes <> own-codes in
        (case static-method w d actual of
          Some (parameter-classes, ret-class) -> (case static-closure-with (Span 0 0 1 1) (specialized-name (d.name) actual) parameter-classes ret-class (demand-worker (d.name) actual w) of
            (planned, payload) -> case static-dictionary-fields owner classes count rest planned of
              Some (done, words) -> Some (done, (physical, payload) : words)
              None -> None)
          None -> None)
      None -> None
  -- The parameter classes of a method that function-call lowers, with no
  -- context and no arguments, to a closure saving nothing: no self value
  -- dependencies, no implicit index values, and some given or parameter
  -- still to come.
  static-method :: Writer -> CoreDefinition -> List Nat -> Option (List Nat, Nat)
  static-method w d classes = case definition-context d classes w of
    Some context ->
      let parameters = definition-parameters d in
      let required = runtime-givens w d in
      let quiet = list-length (definition-value-dependencies w d) == 0 && list-length (opening-value-types (d.openings)) == 0 in
      if quiet && (list-length required > 0 || list-length parameters > 0) && not (wide-type context (final-result (scheme-body (d.scheme)))) then
        let ret-class = (case d.clauses of
          (CoreClause _ pats body) : _ -> (case proof-stage-arities pats 0 of
            [_] -> (case word-class context (core-type body) of Some c -> c; None -> 0)
            other -> 0)
          [] -> 0) in
        (case class-vector context (given-types required <> pattern-types parameters) of
          Some pcs -> Some (pcs, ret-class)
          None -> None)
      else None
    None -> None
  physical-words :: Nat -> Nat -> List (Nat, String) -> List StaticWord
  physical-words index count words = if index >= count then [] else (physical-word index words) : (physical-words (index + 1) count words)
  physical-word :: Nat -> List (Nat, String) -> StaticWord
  physical-word index words = case words of [] -> StaticBits 0; (slot, address) : rest -> if slot == index then StaticAddress address else physical-word index rest
  pattern-binds :: Nat -> CorePattern -> Bool
  pattern-binds id pattern = case pattern of
    CPVar sp ty key name -> id == key
    CPProof sp ty key name -> id == key
    CPErasedValue sp ty key name -> id == key
    CPAs sp ty key name inner -> id == key || pattern-binds id inner
    CPTuple sp ty fields -> pattern-binds id fields
    CPConstructor sp ty name actuals sc fields -> pattern-binds id fields
    CPField sp first rest -> pattern-binds id first || pattern-binds id rest
    other -> False
  term-uses :: Nat -> CoreTerm -> Bool
  term-uses id term = case term of
    CLocal sp ty key name actuals -> id == key
    CApply sp ty first second -> term-uses id first || term-uses id second
    CApplyEff sp ty row first second -> term-uses id first || term-uses id second
    CScope sp ty region evidence callback -> term-uses id callback
    CMemoScope sp ty region body -> term-uses id body
    CSpawn sp ty token body -> term-uses id token || term-uses id body
    CJoin sp ty token body -> term-uses id token || term-uses id body
    CWith sp ty given value body -> term-uses id value || term-uses id body
    CLambda sp ty pattern body -> not (pattern-binds id pattern) && term-uses id body
    CLet sp ty key name sc rhs body -> term-uses id rhs || (id /= key && term-uses id body)
    CRecursiveFunctions sp ty members body -> not (local-in-recursive-functions id members)
      && index-term-uses id (body : (recursive-functions members))
    CRecursiveValues sp ty region members body -> not (local-in-recursive-functions id members)
      && index-term-uses id (body : (recursive-functions members))
    CIf sp ty test yes no -> term-uses id test || term-uses id yes || term-uses id no
    CCase sp ty value alternatives -> term-uses id value || term-uses id alternatives
    CTuple sp ty fields -> term-uses id fields
    CPolyIntro sp ty poly-ids fields -> term-uses id fields
    CPolyElim sp ty fields poly-args -> term-uses id fields
    CPrimitive sp ty op args -> term-uses id args
    CProved sp ty evidence body -> term-uses id body
    CRefine sp ty evidence body -> term-uses id body
    CForget sp ty body -> term-uses id body
    CCast sp ty body -> term-uses id body
    CRequire sp ty body -> term-uses id body
    CDischarge sp ty evidence _ body -> term-uses id body
    CGuard sp ty guard body -> term-uses id guard || term-uses id body
    CArgument sp first rest -> term-uses id first || term-uses id rest
    CAlternative sp pattern body rest -> (not (pattern-binds id pattern) && term-uses id body) || term-uses id rest
    other -> index-term-uses id (runtime-term-children term)
  local-in-recursive-functions :: Nat -> CoreTerm -> Bool
  local-in-recursive-functions id members = case members of
    CRecursiveBindingsEnd -> False
    CRecursiveBinding key name value rest -> id == key || local-in-recursive-functions id rest
    other -> False
  index-term-uses :: Nat -> List CoreTerm -> Bool
  index-term-uses id terms = case terms of [] -> False; first : rest -> term-uses id first || index-term-uses id rest
  evidence-uses :: String -> CoreEvidence -> Bool
  evidence-uses name evidence = case evidence of
    CEGiven sp ty symbol -> name == symbol
    CEInstance sp ty symbol actuals args -> evidence-uses name args
    CEArgument sp first rest -> evidence-uses name first || evidence-uses name rest
    other -> False
  evidences-use :: String -> List CoreEvidence -> Bool
  evidences-use name evidence = case evidence of [] -> False; first : rest -> evidence-uses name first || evidences-use name rest
  given-uses :: String -> CoreTerm -> Bool
  given-uses name term = case term of
    CUse sp ty symbol role actuals -> role == "dictionary" && name == symbol
    CQualifiedUse sp ty symbol role actuals evidence -> evidences-use name evidence
    CMethod sp ty symbol owner slot actuals evidence -> evidences-use name evidence
    CApply sp ty first second -> given-uses name first || given-uses name second
    CApplyEff sp ty row first second -> given-uses name first || given-uses name second
    CErasedApply sp ty row f witness -> given-uses name f
    CLambda sp ty pattern body -> given-uses name body
    CLet sp ty key symbol sc rhs body -> given-uses name rhs || given-uses name body
    CRecursiveFunctions sp ty members body -> recursive-given-uses name (body : (recursive-functions members))
    CRecursiveValues sp ty region members body -> recursive-given-uses name (body : (recursive-functions members))
    CScope sp ty region evidence callback -> evidence-uses name evidence || given-uses name callback
    CMemoScope sp ty region body -> given-uses name body
    CSpawn sp ty token body -> given-uses name token || given-uses name body
    CJoin sp ty token body -> given-uses name token || given-uses name body
    CWith sp ty given value body -> given-uses name value || (name /= given.symbol && given-uses name body)
    CHandler sp ty returned operations -> given-uses name returned || given-uses name operations
    CHandlerOperation sp slot openings row closure rest -> given-uses name closure || given-uses name rest
    CHandle sp ty label residual body frame -> given-uses name frame || given-uses name body
    CIf sp ty test yes no -> given-uses name test || given-uses name yes || given-uses name no
    CCase sp ty value alternatives -> given-uses name value || given-uses name alternatives
    CTuple sp ty fields -> given-uses name fields
    CPolyIntro sp ty poly-ids fields -> given-uses name fields
    CPolyElim sp ty fields poly-args -> given-uses name fields
    CPrimitive sp ty op args -> given-uses name args
    CProved sp ty evidence body -> given-uses name body
    CRefine sp ty evidence body -> given-uses name body
    CForget sp ty body -> given-uses name body
    CCast sp ty body -> given-uses name body
    CRequire sp ty body -> given-uses name body
    CDischarge sp ty evidence _ body -> given-uses name body
    CGuard sp ty guard body -> given-uses name guard || given-uses name body
    CArgument sp first rest -> given-uses name first || given-uses name rest
    CAlternative sp pattern body rest -> given-uses name body || given-uses name rest
    other -> False
  recursive-given-uses :: String -> List CoreTerm -> Bool
  recursive-given-uses name terms = case terms of
    [] -> False
    first : rest -> given-uses name first || recursive-given-uses name rest
  given-in :: String -> List CoreGiven -> Bool
  given-in name givens = case givens of [] -> False; first : rest -> name == first.symbol || given-in name rest
  self-context-uses :: String -> CoreTerm -> List Local -> Bool
  self-context-uses name body locals = case locals of
    [] -> False
    (KnownSelf key owner classes context) : rest -> (given-uses key body && given-in name context) || self-context-uses name body rest
    other : rest -> self-context-uses name body rest
  captures-from :: CorePattern -> CoreTerm -> List Local -> List Local -> List Local
  captures-from parameter body all locals = case locals of
    [] -> []
    (Local id ty value) : rest -> if not (pattern-binds id parameter) && term-uses id body then (Local id ty value) : (captures-from parameter body all rest) else captures-from parameter body all rest
    (Borrowed id ty value) : rest -> if not (pattern-binds id parameter) && term-uses id body then (Local id ty value) : (captures-from parameter body all rest) else captures-from parameter body all rest
    (KnotLocal id region ty slot) : rest -> if not (pattern-binds id parameter) && recursive-member-use id body then
      (KnotLocal id region ty slot) : (captures-from parameter body all rest)
      else captures-from parameter body all rest
    (GivenLocal name ty value) : rest -> if given-uses name body || self-context-uses name body all then (GivenLocal name ty value) : (captures-from parameter body all rest) else captures-from parameter body all rest
    (KnownSelf key owner classes context) : rest -> if given-uses key body then (KnownSelf key owner classes context) : (captures-from parameter body all rest) else captures-from parameter body all rest
    (SelfValue owner slot ty value) : rest -> if self-values-used owner body all then (SelfValue owner slot ty value) : (captures-from parameter body all rest) else captures-from parameter body all rest
    (Discard ty value) : rest -> captures-from parameter body all rest
    (DeferredConstructor id ty name actuals args) : rest -> captures-from parameter body all rest
    LoopMarker : rest -> captures-from parameter body all rest
    (StackCell id ty ptr-reg) : rest -> captures-from parameter body all rest
  capture-types :: List Local -> List UType
  capture-types locals = case locals of
    [] -> []
    (Local id ty value) : rest -> ty : (capture-types rest)
    (KnotLocal id region ty slot) : rest -> (knot-slot-type region ty) : (capture-types rest)
    (GivenLocal name ty value) : rest -> ty : (capture-types rest)
    (SelfValue owner slot ty value) : rest -> ty : (capture-types rest)
    other : rest -> capture-types rest
  capture-values :: List Local -> Writer -> (Writer, List String)
  capture-values locals w = case locals of
    [] -> (w, [])
    (Local id ty value) : rest -> case capture-values rest (count-op True ty value w) of
      (done, values) -> (done, value : values)
    (Borrowed id ty value) : rest -> case capture-values rest (count-op True ty value w) of
      (done, values) -> (done, value : values)
    (KnotLocal id region ty slot) : rest -> case capture-values rest (count-op True (knot-slot-type region ty) slot w) of
      (done, values) -> (done, slot : values)
    (GivenLocal name ty value) : rest -> case capture-values rest (count-op True ty value w) of
      (done, values) -> (done, value : values)
    (SelfValue owner slot ty value) : rest -> case capture-values rest (count-op True ty value w) of
      (done, values) -> (done, value : values)
    (KnownSelf key owner classes context) : rest -> capture-values rest w
    other -> (refuse w (Span 0 0 1 1) "malformed closure capture list", [])
  captured-bindings :: List Local -> Nat -> List Local
  captured-bindings saved index = case saved of
    [] -> []
    (Local id ty value) : rest -> (Borrowed id ty (cat ["%arg", nat-to-string index])) : (captured-bindings rest (index + 1))
    (KnotLocal id region ty slot) : rest -> (KnotLocal id region ty (cat ["%arg", nat-to-string index])) : (captured-bindings rest (index + 1))
    (GivenLocal name ty value) : rest -> (GivenLocal name ty (cat ["%arg", nat-to-string index])) : (captured-bindings rest (index + 1))
    (SelfValue owner slot ty value) : rest -> (SelfValue owner slot ty (cat ["%arg", nat-to-string index])) : (captured-bindings rest (index + 1))
    (KnownSelf key owner classes context) : rest -> (KnownSelf key owner classes context) : (captured-bindings rest index)
    other : rest -> captured-bindings rest index
  capture-roots :: List UType -> Nat -> List Local
  capture-roots types index = case types of [] -> []; ty : rest -> (Discard ty (cat ["%arg", nat-to-string index])) : (capture-roots rest (index + 1))
  lambda :: List CoreDefinition -> List Local -> Writer -> Span -> CorePattern -> CoreTerm -> (Writer, String)
  lambda definitions locals w sp parameter body =
    let saved = captures-from parameter body locals locals in
    let parameters = if erased-pattern parameter then [] else [pattern-type parameter] in
    if wide-type (w.context) (final-result (core-type body)) then unsupported w sp wide-refusal else
    let ret-class = (case word-class (w.context) (core-type body) of Some c -> c; None -> 0) in
    case class-vector (w.context) (capture-types saved <> parameters) of
      None -> unsupported w sp "lambda parameters need known runtime representations"
      Some classes -> let (named, name) = fresh-scoped w ".lambda" in
        (case named.context of
          RuntimeContext datas bounds rigids queue inlining ->
            let planned = request-demand (LambdaDemand name bounds rigids saved parameter body) named in
            case capture-values saved planned of
              (ready, values) -> closure-with sp name classes ret-class (capture-types saved) values ready)
  recursive-parameters :: List CorePattern -> CoreTerm -> (List CorePattern, CoreTerm)
  recursive-parameters parameters term = case term of
    CLambda sp ty pattern body -> if erased-pattern pattern then
      (case parameters of [] -> ([pattern], body); other -> (reverse parameters, term))
      else recursive-parameters (pattern : parameters) body
    other -> (reverse parameters, term)
  plan-recursive-workers :: CoreTerm -> Writer -> (Writer, List RecursiveWorker)
  plan-recursive-workers members w = case members of
    CRecursiveBindingsEnd -> (w, [])
    CRecursiveBinding id display value rest -> let (named, name) = fresh-scoped w ".rec" in
      let (parameters, body) = recursive-parameters [] value in
      case plan-recursive-workers rest named of
        (done, more) -> (done, (RecursiveWorker id (core-type value) name parameters body) : more)
    other -> (refuse w (Span 0 0 1 1) "malformed recursive function group", [])
  request-recursive-workers :: List RecursiveWorker -> List RecursiveWorker -> List Local -> Writer -> Writer
  request-recursive-workers group pending saved w = case pending of
    [] -> w
    member : rest -> case w.context of
      RuntimeContext datas bounds rigids queue inlining ->
        request-recursive-workers group rest saved (request-demand (RecursiveDemand member group bounds rigids saved) w)
  -- The sibling closures save only the group's outer environment. Rebuild
  -- a closure when its worker needs that value without an owning cycle.
  recursive-locals :: Span -> List UType -> List Local -> List RecursiveWorker -> CoreTerm -> Writer -> (Writer, List Local)
  recursive-locals sp captures saved group used w = case group of
    [] -> (w, [])
    (RecursiveWorker id ty name patterns body) : rest -> if not (term-uses id used) then
      recursive-locals sp captures saved rest used w
      else if wide-type (w.context) (final-result ty) then (refuse w sp wide-refusal, [])
      else let ret-class = (case word-class (w.context) (core-type body) of Some c -> c; None -> 0) in
        (case class-vector (w.context) (captures <> pattern-types (runtime-parameters patterns)) of
        None -> (refuse w sp "recursive closure needs checked runtime representations", [])
        Some classes -> case capture-values saved w of
          (captured, values) -> case closure-with sp name classes ret-class captures values captured of
            (ready, word) -> case recursive-locals sp captures saved rest used ready of
              (done, more) -> (done, (Local id ty word) : more))
  recursive-expression :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> CoreTerm -> (Writer, String)
  recursive-expression definitions locals w sp members body =
    let unit = UCon "Unit" KType in
    let scope = CRecursiveFunctions sp unit members (CUnit sp unit) in
    let saved = captures-from (CPWild sp unit) scope locals locals in
    case plan-recursive-workers members w of
      (named, group) -> let planned = request-recursive-workers group group saved named in
        (case recursive-locals sp (capture-types saved) saved group body planned of
          (ready, bound) -> case expression definitions (bound <> locals) ready body of
            (done, result) -> (drop-locals bound done, result))
  -- App stubs consume the closure and argv. A closure's code word points at
  -- the `app` stub, which merges the filled words and the incoming words
  -- into a frame of exactly `arity` words: a static alloca, never a dynamic
  -- one, because LLVM's AArch64 stack probe mishandles a dynamic alloca once
  -- a caller inlines the stub. Saved fields are duplicated before the
  -- original closure is dropped; argv fields transfer directly.
  load-word :: Writer -> String -> String -> (Writer, String)
  load-word w pointer index =
    let (one, slot) = fresh w "%ptr" in
    let (two, value) = fresh one "%v" in
    (line (line two (cat ["  ", slot, " = getelementptr i64, ptr ", pointer, ", i64 ", index])) (cat ["  ", value, " = load i64, ptr ", slot]), value)
  saved-dups :: List Nat -> Nat -> String -> String -> Writer -> Writer
  saved-dups classes index filled merged w = case classes of
    [] -> w
    first : rest -> if first == 0 then saved-dups rest (index + 1) filled merged w else
      let (one, condition) = fresh w "%v" in
      let (two, duplicate) = fresh one "saveddup" in
      let (three, next) = fresh two "savednext" in
      let started = line (line (line three (cat ["  ", condition, " = icmp ult i64 ", nat-to-string index, ", ", filled])) (cat ["  br i1 ", condition, ", label %", duplicate, ", label %", next])) (cat [duplicate, ":"]) in
      case load-word started merged (nat-to-string index) of
        (loaded, word) -> saved-dups rest (index + 1) filled merged (line (line (count-line True word loaded) (cat ["  br label %", next])) (cat [next, ":"]))
  load-arguments :: Nat -> Nat -> String -> Writer -> (Writer, List String)
  load-arguments count index merged w = if count == 0 then (w, []) else case load-word w merged (nat-to-string index) of
    (loaded, word) -> case load-arguments (count - 1) (index + 1) merged loaded of (done, words) -> (done, word : words)
  -- One merged frame slot: the closure's saved word while the slot is below
  -- the filled count, the matching argv word otherwise. The argv address is
  -- a non-inbounds byte GEP: a slot that selects a saved word still computes
  -- the pointer it does not load.
  merge-words :: Writer -> String -> Nat -> Nat -> String -> String -> Writer
  merge-words w frame index count filled saved-bytes = if index == count then w else
    let (one, saved) = fresh w "%ptr" in
    let saved-line = line one (cat ["  ", saved, " = getelementptr i8, ptr %self, i64 ", nat-to-string (24 + index * 8)]) in
    let (two, offset) = fresh saved-line "%v" in
    let offset-line = line two (cat ["  ", offset, " = sub i64 ", nat-to-string (index * 8), ", ", saved-bytes]) in
    let (three, argument) = fresh offset-line "%ptr" in
    let argument-line = line three (cat ["  ", argument, " = getelementptr i8, ptr %argv, i64 ", offset]) in
    let (four, has) = fresh argument-line "%v" in
    let has-line = line four (cat ["  ", has, " = icmp ult i64 ", nat-to-string index, ", ", filled]) in
    let (five, source) = fresh has-line "%ptr" in
    let source-line = line five (cat ["  ", source, " = select i1 ", has, ", ptr ", saved, ", ptr ", argument]) in
    let (six, word) = fresh source-line "%v" in
    let word-line = line six (cat ["  ", word, " = load i64, ptr ", source]) in
    let (seven, slot) = fresh word-line "%ptr" in
    let slot-line = line seven (cat ["  ", slot, " = getelementptr i8, ptr ", frame, ", i64 ", nat-to-string (index * 8)]) in
    merge-words (line slot-line (cat ["  store i64 ", word, ", ptr ", slot])) frame (index + 1) count filled saved-bytes
  copy-closure-bytes :: Writer -> String -> String -> String -> Writer
  copy-closure-bytes w destination source bytes = if program-wasm32 (writer-program w) then
    (let (next, size) = fresh w "%size" in
      line (line next (cat ["  ", size, " = trunc i64 ", bytes, " to i32"])) (cat ["  call ptr @memcpy(ptr ", destination, ", ptr ", source, ", i32 ", size, ")"]))
    else line w (cat ["  call ptr @memcpy(ptr ", destination, ", ptr ", source, ", i64 ", bytes, ")"])
  -- The grow half: fewer words than the arity, so build a closure whose
  -- payload is the `filled` saved words followed by the `%argc` incoming
  -- ones and whose code word is this same stub, so the next application
  -- enters it again. No frame is involved: these two copies are the only
  -- dynamic lengths in the stub, and neither reads past the words its
  -- source holds.
  app-partial :: String -> List Nat -> Nat -> String -> String -> Writer -> Writer
  app-partial name classes descriptor total filled w =
    let arity = list-length classes in
    let (one, words) = fresh w "%v" in
    let (two, bytes) = fresh one "%v" in
    let (three, pointer) = fresh two "%ptr" in
    let allocated = shaped-allocation (line (line three (cat ["  ", words, " = add i64 ", total, ", 3"])) (cat ["  ", bytes, " = mul i64 ", words, ", 8"])) pointer bytes 2 descriptor in
    let prefix = [cat ["ptrtoint (ptr ", symbol (cat [name, ".app"]), " to i64)"], nat-to-string arity, total] in
    let stored = store-fields allocated pointer 0 prefix in
    let (four, destination) = fresh stored "%ptr" in
    let (five, saved-bytes) = fresh four "%v" in
    let (six, saved) = fresh five "%ptr" in
    let (seven, incoming-bytes) = fresh six "%v" in
    let (eight, incoming) = fresh seven "%ptr" in
    let copied = line (line eight (cat ["  ", destination, " = getelementptr i64, ptr ", pointer, ", i64 3"])) (cat ["  ", saved-bytes, " = mul i64 ", filled, ", 8"]) in
    let saved-copy = copy-closure-bytes (line copied (cat ["  ", saved, " = getelementptr i64, ptr %self, i64 3"])) destination saved saved-bytes in
    let argv-copy = line (line saved-copy (cat ["  ", incoming-bytes, " = mul i64 %argc, 8"])) (cat ["  ", incoming, " = getelementptr i8, ptr ", destination, ", i64 ", saved-bytes]) in
    let (nine, self-word) = fresh (saved-dups classes 0 filled destination (copy-closure-bytes argv-copy incoming "%argv" incoming-bytes)) "%v" in
    let released = count-line False self-word (line nine (cat ["  ", self-word, " = ptrtoint ptr %self to i64"])) in
    let (ten, closure-word) = fresh released "%v" in
    line (line ten (cat ["  ", closure-word, " = ptrtoint ptr ", pointer, " to i64"])) (cat ["  ret i64 ", closure-word])
  unpack-app-arguments :: List Nat -> Nat -> String -> Writer -> (Writer, List (String, String), Nat)
  unpack-app-arguments classes index frame w = case classes of
    [] -> (w, [], index)
    code : rest ->
      if is-val-class code then
        let sz = val-class-size code in
        let al = val-class-align code in
        let words = val-size-words sz in
        if sz > 16 || al > 16 then
          let (w1, slot) = fresh w "%ptr" in
          let w2 = line w1 (cat ["  ", slot, " = getelementptr i64, ptr ", frame, ", i64 ", nat-to-string index]) in
          let pty = cat ["ptr readonly align ", nat-to-string al, " dereferenceable(", nat-to-string sz, ")"] in
          if al <= 8 then
            case unpack-app-arguments rest (index + words) frame w2 of
              (done, more, next-idx) -> (done, (pty, slot) : more, next-idx)
          else
            let (w3, tmp) = fresh (request-demand MemcpyDemand w2) "%valtmp" in
            let w4 = emit-lines w3 [
              cat ["  ", tmp, " = alloca [", nat-to-string sz, " x i8], align ", nat-to-string al],
              cat ["  call void @llvm.memcpy.p0.p0.i64(ptr align ", nat-to-string al, " ", tmp, ", ptr align 1 ", slot, ", i64 ", nat-to-string sz, ", i1 false)"]] in
            case unpack-app-arguments rest (index + words) frame w4 of
              (done, more, next-idx) -> (done, (pty, tmp) : more, next-idx)
        else if sz > 8 then
          let (w1, slot) = fresh w "%ptr" in
          let (w2, pair) = fresh w1 "%v" in
          let w3 = emit-lines w2 [
            cat ["  ", slot, " = getelementptr i64, ptr ", frame, ", i64 ", nat-to-string index],
            cat ["  ", pair, " = load { i64, i64 }, ptr ", slot, ", align 8"]] in
          case unpack-app-arguments rest (index + 2) frame w3 of
            (done, more, next-idx) -> (done, ("{ i64, i64 }", pair) : more, next-idx)
        else
          case load-word w frame (nat-to-string index) of
            (loaded, word) -> case unpack-app-arguments rest (index + 1) frame loaded of
              (done, more, next-idx) -> (done, ("i64", word) : more, next-idx)
      else
        case load-word w frame (nat-to-string index) of
          (loaded, word) -> case unpack-app-arguments rest (index + 1) frame loaded of
            (done, more, next-idx) -> (done, ("i64", word) : more, next-idx)
  -- The saturated call: `frame` holds the merged words and `total` is the
  -- filled count plus the incoming one, so the excess continues at
  -- `argv + (arity - filled)` words, inside argv whenever there is one.
  app-saturate :: String -> List Nat -> Nat -> Nat -> String -> String -> String -> String -> Writer -> Writer
  app-saturate name param-classes ret-class arity frame filled saved-bytes total w =
    if val-code param-classes || val-code-needs-sret-apply ret-class then
      case unpack-app-arguments param-classes 0 frame w of
        (ready, args, out-index) ->
          if val-code-needs-sret-apply ret-class then
            let sz = val-class-size ret-class in
            let al = val-class-align ret-class in
            case load-word ready frame (nat-to-string out-index) of
              (loaded, outw) ->
                let (w1, outp) = fresh loaded "%outp" in
                let w2 = line w1 (cat ["  ", outp, " = inttoptr i64 ", outw, " to ptr"]) in
                if sz > 16 || al > 16 then
                  let sret-arg = cat ["ptr sret([", nat-to-string sz, " x i8]) align ", nat-to-string al, " ", outp] in
                  line (line (line w2 (cat ["  call void ", symbol name, "(", join (sret-arg : (typed-arguments args)), ")"])) "  ret i64 0") "}"
                else
                  case typed-call w2 "{ i64, i64 }" (symbol name) args of
                    (called, pair) ->
                      line (line (line called (cat ["  store { i64, i64 } ", pair, ", ptr ", outp, ", align 8"])) "  ret i64 0") "}"
          else
            case typed-call ready "i64" (symbol name) args of
              (called, result) ->
                let (one, excess) = fresh called "%v" in
                let (two, more) = fresh one "%v" in
                let (three, over-label) = fresh two "overapplied" in
                let (four, return-label) = fresh three "appreturn" in
                let saturated = line (line (line (line (line four (cat ["  ", excess, " = sub i64 ", total, ", ", nat-to-string arity])) (cat ["  ", more, " = icmp ne i64 ", excess, ", 0"])) (cat ["  br i1 ", more, ", label %", over-label, ", label %", return-label])) (cat [return-label, ":"])) (cat ["  ret i64 ", result]) in
                let (five, tail-offset) = fresh (line saturated (cat [over-label, ":"])) "%v" in
                let (six, tail) = fresh five "%ptr" in
                let (seven, out) = fresh six "%v" in
                line (line (line (line (line seven (cat ["  ", tail-offset, " = sub i64 ", nat-to-string (arity * 8), ", ", saved-bytes])) (cat ["  ", tail, " = getelementptr i8, ptr %argv, i64 ", tail-offset])) (cat ["  ", out, " = call i64 @__apply(i64 ", result, ", i64 ", excess, ", ptr ", tail, ")"])) (cat ["  ret i64 ", out])) "}"
    else
    case load-arguments arity 0 frame w of
    (ready, args) -> case call ready (symbol name) args of
      (called, result) ->
        let (one, excess) = fresh called "%v" in
        let (two, more) = fresh one "%v" in
        let (three, over-label) = fresh two "overapplied" in
        let (four, return-label) = fresh three "appreturn" in
        let saturated = line (line (line (line (line four (cat ["  ", excess, " = sub i64 ", total, ", ", nat-to-string arity])) (cat ["  ", more, " = icmp ne i64 ", excess, ", 0"])) (cat ["  br i1 ", more, ", label %", over-label, ", label %", return-label])) (cat [return-label, ":"])) (cat ["  ret i64 ", result]) in
        let (five, tail-offset) = fresh (line saturated (cat [over-label, ":"])) "%v" in
        let (six, tail) = fresh five "%ptr" in
        let (seven, out) = fresh six "%v" in
        line (line (line (line (line seven (cat ["  ", tail-offset, " = sub i64 ", nat-to-string (arity * 8), ", ", saved-bytes])) (cat ["  ", tail, " = getelementptr i8, ptr %argv, i64 ", tail-offset])) (cat ["  ", out, " = call i64 @__apply(i64 ", result, ", i64 ", excess, ", ptr ", tail, ")"])) (cat ["  ret i64 ", out])) "}"
  -- The apply stub: one entry per function, whatever argument count it is
  -- handed. It reads the merged total, then branches once: at or above the
  -- arity it merges the filled words and the incoming ones into a frame of
  -- exactly `arity` words and saturates, below it it grows a closure. The
  -- merge is inside the saturated path because only there does every frame
  -- slot have a word behind it; the grow path copies the two sources
  -- directly. The frame is a static alloca, never a dynamic one, because
  -- LLVM's AArch64 stack probe mishandles a dynamic alloca once a caller
  -- inlines the stub. Saved fields are duplicated before the original
  -- closure is dropped; argv fields transfer directly.
  app-stub :: String -> List Nat -> Nat -> Writer -> Writer
  app-stub name param-classes ret-class w = case request-shape-for (Span 0 0 1 1) param-classes ret-class w of
    (planned, descriptor) ->
      let wclasses = closure-word-classes param-classes ret-class in
      let arity = list-length wclasses in
      let header = line (line planned (cat ["define ", worker-linkage planned (cat [name, ".app"]), "i64 ", symbol (cat [name, ".app"]), "(ptr %self, i64 %argc, ptr %argv)", worker-open w])) "entry:" in
      let (loaded, filled) = load-word header "%self" "2" in
      let (one, total) = fresh loaded "%v" in
      let total-line = line one (cat ["  ", total, " = add i64 ", filled, ", %argc"]) in
      if arity == 0 then saturated-stub name param-classes ret-class wclasses filled total total-line else
        let (two, full) = fresh total-line "%v" in
        let (three, partial-label) = fresh two "partial" in
        let (four, full-label) = fresh three "saturated" in
        let split = line (line (line four (cat ["  ", full, " = icmp uge i64 ", total, ", ", nat-to-string arity])) (cat ["  br i1 ", full, ", label %", full-label, ", label %", partial-label])) (cat [partial-label, ":"]) in
        let partial = app-partial name wclasses descriptor total filled split in
        saturated-stub name param-classes ret-class wclasses filled total (line partial (cat [full-label, ":"]))
  -- The static frame the saturated path merges into: exactly `arity`
  -- words, allocated in the entry block.
  merged-frame :: Writer -> Nat -> String -> String -> (Writer, String)
  merged-frame w arity filled saved-bytes =
    let (one, frame) = fresh w "%ptr" in
    let frame-line = line one (cat ["  ", frame, " = alloca [", nat-to-string arity, " x i64]"]) in
    (merge-words frame-line frame 0 arity filled saved-bytes, frame)
  -- The saturated half of the stub: merge the frame, take the saved words
  -- it copied, drop the closure, then call the function. A nullary unit
  -- needs no frame: every slot count is zero, so `%self` stands in and no
  -- alloca is emitted.
  saturated-stub :: String -> List Nat -> Nat -> List Nat -> String -> String -> Writer -> Writer
  saturated-stub name param-classes ret-class wclasses filled total started =
    let arity = list-length wclasses in
    let (one, saved-bytes) = fresh started "%v" in
    let saved-line = line one (cat ["  ", saved-bytes, " = mul i64 ", filled, ", 8"]) in
    let (merged, frame) = if arity == 0 then (saved-line, "%self") else merged-frame saved-line arity filled saved-bytes in
    let (two, self-word) = fresh (saved-dups wclasses 0 filled frame merged) "%v" in
    let released = count-line False self-word (line two (cat ["  ", self-word, " = ptrtoint ptr %self to i64"])) in
    app-saturate name param-classes ret-class arity frame filled saved-bytes total released
  term-fields :: CoreTerm -> Option (List CoreTerm)
  term-fields fields = case fields of
    CArgumentsEnd sp -> Some []
    CArgument sp first rest -> case term-fields rest of Some more -> Some (first : more); None -> None
    other -> None
  field-words :: RuntimeContext -> List CoreTerm -> Bool
  field-words datas fields = case fields of [] -> True; first : rest -> word-type datas (core-type first) && field-words datas rest
  -- design/rank-n-polymorphism.md section 8. A polymorphic value is a
  -- class-indexed bundle: one block whose component i is the body lowered
  -- with its type binders at the i-th class vector, in lexicographic order
  -- of the Raw/Obj/TObj codes. A lambda body becomes one specialised
  -- closure per vector; any other body is evaluated once per vector, which
  -- its checked purity makes unobservable. Row and region binders carry no
  -- class. An instantiation loads the component its arguments' classes
  -- select. The Rust compiler instead keeps a demand-driven family slot
  -- table; the two never meet, because no library export has a polytype.
  poly-bundle :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> List Nat -> CoreTerm -> (Writer, String)
  poly-bundle definitions locals w sp ty ids body = case ty of
    UForall qs inner -> let binders = poly-class-binders (quants-list qs) ids in
      if list-length binders > 2 then unsupported w sp "a polymorphic value with more than two type binders needs an extended runtime descriptor (its 3^k bundle exceeds 16 words)" else
      case poly-components definitions locals w sp binders body (class-vectors (list-length binders)) of
        (built, values, classes) -> if list-length (built.errors) > list-length (w.errors) then (built, "0") else
          (case request-class-layout sp classes built of
            (planned, descriptor) -> allocate planned descriptor values)
    other -> unsupported w sp "a generalisation needs a polymorphic type"
  poly-class-binders :: List Quant -> List Nat -> List Nat
  poly-class-binders qs ids = case qs of
    [] -> []
    q : rest -> case ids of
      id : more -> if poly-class-kind (q.kind) then id : (poly-class-binders rest more) else poly-class-binders rest more
      [] -> []
  poly-class-positions :: List Quant -> Nat -> List Nat
  poly-class-positions qs index = case qs of
    [] -> []
    q : rest -> if poly-class-kind (q.kind) then index : (poly-class-positions rest (index + 1)) else poly-class-positions rest (index + 1)
  poly-class-kind :: Kind -> Bool
  poly-class-kind kind = case kind of KType -> True; KFun a b -> True; other -> False
  class-vectors :: Nat -> List (List Nat)
  class-vectors k = if k == 0 then [[]] else prefix-classes [0, 1, 2] (class-vectors (k - 1))
  prefix-classes :: List Nat -> List (List Nat) -> List (List Nat)
  prefix-classes codes tails = case codes of [] -> []; code : rest -> prefix-each code tails <> prefix-classes rest tails
  prefix-each :: Nat -> List (List Nat) -> List (List Nat)
  prefix-each code tails = case tails of [] -> []; tail : more -> (code : tail) : (prefix-each code more)
  vector-index :: List Nat -> Nat
  vector-index v = vector-index-from v 0
  vector-index-from :: List Nat -> Nat -> Nat
  vector-index-from v acc = case v of [] -> acc; code : rest -> vector-index-from rest (acc * 3 + code)
  select-positions :: List Nat -> List UType -> List UType
  select-positions positions args = select-from positions args 0
  select-from :: List Nat -> List UType -> Nat -> List UType
  select-from positions args index = case args of
    [] -> []
    arg : rest -> if has-nat index positions then arg : (select-from positions rest (index + 1)) else select-from positions rest (index + 1)
  has-nat :: Nat -> List Nat -> Bool
  has-nat n xs = case xs of [] -> False; x : rest -> x == n || has-nat n rest
  -- Lower the body once per class vector, with the type binders' rigid ids
  -- mapped to that vector for the body alone.
  poly-components :: List CoreDefinition -> List Local -> Writer -> Span -> List Nat -> CoreTerm -> List (List Nat) -> (Writer, List String, List Nat)
  poly-components definitions locals w sp binders body vectors = case vectors of
    [] -> (w, [], [])
    v : rest ->
      let original = writer-rigids w in
      let opened = with-writer-rigids (zip-classes binders v <> original) w in
      case expression definitions locals opened body of
        (lowered, value) -> let code = case word-class (lowered.context) (core-type body) of Some c -> c; None -> 1 in
          let restored = with-writer-rigids original lowered in
          case poly-components definitions locals restored sp binders body rest of
            (done, values, classes) -> (done, value : values, code : classes)
  zip-classes :: List Nat -> List Nat -> List (Nat, Nat)
  zip-classes ids codes = case ids of
    [] -> []
    id : rest -> case codes of code : more -> (id, code) : (zip-classes rest more); [] -> []
  writer-rigids :: Writer -> List (Nat, Nat)
  writer-rigids w = case w.context of RuntimeContext info bounds rigids queue inlining -> rigids
  with-writer-rigids :: List (Nat, Nat) -> Writer -> Writer
  with-writer-rigids rigids w = case w of
    Writer next globals code errors layouts (RuntimeContext info bounds old queue inlining) ->
      Writer next globals code errors layouts (RuntimeContext info bounds rigids queue inlining)
  poly-project :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> List UType -> (Writer, String)
  poly-project definitions locals w sp ty value args = case core-type value of
    UForall qs inner -> (case class-vector (w.context) (select-positions (poly-class-positions (quants-list qs) 0) args) of
      None -> unsupported w sp "an instantiation needs known runtime representations"
      -- A bundle holds one component per Raw/Obj/TObj vector; a Wide
      -- vector has none, and its base-3 index would name another's.
      Some v -> if wide-code v then unsupported w sp wide-refusal else if val-code v then unsupported w sp val-refusal else case expression definitions locals w value of
        (evaluated, bundle) -> let (named, pointer) = fresh evaluated "%poly" in
          let addressed = line named (cat ["  ", pointer, " = inttoptr i64 ", bundle, " to ptr"]) in
          case load-word addressed pointer (nat-to-string (vector-index v)) of
            -- The component outlives the bundle it came from.
            (loaded, selected) -> (count-op False (core-type value) bundle (count-op True ty selected loaded), selected))
    other -> unsupported w sp "an instantiation needs a polymorphic value"
  -- A tuple layout from the components' classes directly: the bundle's
  -- components have different classes per vector, so no single context
  -- types them all.
  request-class-layout :: Span -> List Nat -> Writer -> (Writer, Nat)
  request-class-layout sp classes w = if wide-code classes then (refuse w sp wide-refusal, 0) else if list-length classes > 16 then (refuse w sp "polymorphic bundle layout needs an extended runtime descriptor", 0)
    else (w, shape-description 1 0 classes)
  tuple :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> (Writer, String)
  tuple definitions locals w sp fields = case term-fields fields of
    Some actual -> if list-length actual > 16 || not (field-words (w.context) actual) then unsupported w sp "tuple fields need an extended or polymorphic runtime layout" else
      (case expressions definitions locals w actual of
        (evaluated, values) ->
          let (planned, descriptor) = request-layout sp actual evaluated in
          allocate-typed-fields planned descriptor (term-types actual) values)
    None -> unsupported w sp "malformed tuple argument spine"
  -- A fieldless value is a static Obj. The header uses rc=0 and kind=1,
  -- with the layout field in bits 40..63. An escaped block puts its
  -- descriptor's address before the header, so the payload address still
  -- has the header at -8.
  --
  -- A nullary block's bytes are a pure function of its description.
  -- Emit one definition on its first use and let every site share it.
  with-nullary-block :: Writer -> String -> Nat -> Writer
  with-nullary-block w storage descriptor =
    let key = 2 * descriptor + 1 in
    let wasm32 = program-wasm32 (writer-program w) in
    let declared = with-descriptor w descriptor in
    shared-global declared key (static-block-line wasm32 storage descriptor 1 [StaticBits 0])
  static-constructor :: Writer -> Nat -> (Writer, String)
  static-constructor w descriptor =
    let skip = static-prefix-words descriptor in
    let storage = cat ["@empty-ctor", nat-to-string descriptor] in
    let block = cat ["[", nat-to-string (2 + skip), " x i64]"] in
    let declared = with-nullary-block w storage descriptor in
    let (ready, result) = fresh declared "%v" in
    (line ready (cat ["  ", result, " = ptrtoint ptr getelementptr inbounds (", block,
      ", ptr ", storage, ", i64 0, i64 ", nat-to-string (1 + skip), ") to i64"]), result)
  allocate :: Writer -> Nat -> List String -> (Writer, String)
  allocate w descriptor values = allocate-typed w descriptor (typed-words values)
  typed-words :: List String -> List (String, String)
  typed-words values = case values of [] -> []; value : rest -> ("i64", value) : (typed-words rest)
  -- Pair each value with the LLVM type it travels as.
  typed-values :: List String -> List String -> List (String, String)
  typed-values types values = case types of
    [] -> typed-words values
    ty : more -> case values of value : rest -> (ty, value) : (typed-values more rest); [] -> []
  typed-payload :: List (String, String) -> Nat
  typed-payload values = case values of [] -> 0; (ty, value) : rest -> (if ty == "i128" then 2 else 1) + typed-payload rest
  -- Fields are stored at their payload word offsets. A wide field's two
  -- words are 8-aligned, as every payload word is, so its access names
  -- that alignment rather than i128's natural 16.
  allocate-typed-fields :: Writer -> Nat -> List UType -> List String -> (Writer, String)
  allocate-typed-fields w descriptor tys values = case values of
    [] -> static-constructor w descriptor
    first : rest ->
      let words = payload-words (w.context) tys in
      let (allocated, pointer) = fresh w "%ptr" in
      let ready = shaped-allocation allocated pointer (nat-to-string (8 * words)) 1 descriptor in
      let filled = store-typed-slots ready pointer 0 tys values in
      let (done, result) = fresh filled "%v" in
      (line done (cat ["  ", result, " = ptrtoint ptr ", pointer, " to i64"]), result)
  store-typed-slots :: Writer -> String -> Nat -> List UType -> List String -> Writer
  store-typed-slots w pointer index tys values = case (tys, values) of
    (ty : ts, value : vs) ->
      let (ready, slot) = fresh w "%ptr" in
      let pointed = line ready (cat ["  ", slot, " = getelementptr i64, ptr ", pointer, ", i64 ", nat-to-string index]) in
      (case type-value-size-align (pointed.context) ty of
        Some (sz, al) ->
          let words = val-size-words sz in
          if sz > 16 || al > 16 then
            let zeroed = (if sz < words * 8 then
              (let (z1, tail-slot) = fresh pointed "%ptr" in
               emit-lines z1 [
                 cat ["  ", tail-slot, " = getelementptr i64, ptr ", slot, ", i64 ", nat-to-string (if words > 0 then words - 1 else 0)],
                 cat ["  store i64 0, ptr ", tail-slot]])
              else pointed) in
            let copied = line (request-demand MemcpyDemand zeroed) (cat ["  call void @llvm.memcpy.p0.p0.i64(ptr align 1 ", slot, ", ptr align ", nat-to-string al, " ", value, ", i64 ", nat-to-string sz, ", i1 false)"]) in
            store-typed-slots copied pointer (index + words) ts vs
          else if sz > 8 then
            store-typed-slots (line pointed (cat ["  store { i64, i64 } ", value, ", ptr ", slot, ", align 8"])) pointer (index + 2) ts vs
          else
            store-typed-slots (line pointed (cat ["  store i64 ", value, ", ptr ", slot])) pointer (index + 1) ts vs
        None ->
          let wide = wide-type (pointed.context) ty in
          store-typed-slots (line pointed (cat ["  store ", if wide then "i128 " else "i64 ", value, ", ptr ", slot, if wide then ", align 8" else ""])) pointer (index + (if wide then 2 else 1)) ts vs)
    other -> w
  allocate-typed :: Writer -> Nat -> List (String, String) -> (Writer, String)
  allocate-typed w descriptor values = case values of
    [] -> static-constructor w descriptor
    first : rest ->
      let (allocated, pointer) = fresh w "%ptr" in
      let ready = shaped-allocation allocated pointer (nat-to-string (8 * typed-payload values)) 1 descriptor in
      let filled = store-typed ready pointer 0 values in
      let (done, result) = fresh filled "%v" in
      (line done (cat ["  ", result, " = ptrtoint ptr ", pointer, " to i64"]), result)
  store-typed :: Writer -> String -> Nat -> List (String, String) -> Writer
  store-typed w pointer index values = case values of
    [] -> w
    (ty, value) : rest -> let (ready, slot) = fresh w "%ptr" in
      let pointed = line ready (cat ["  ", slot, " = getelementptr i64, ptr ", pointer, ", i64 ", nat-to-string index]) in
      let wide = ty == "i128" in
      store-typed (line pointed (cat ["  store ", ty, " ", value, ", ptr ", slot, if wide then ", align 8" else ""])) pointer (index + (if wide then 2 else 1)) rest
  store-fields :: Writer -> String -> Nat -> List String -> Writer
  store-fields w pointer index values = case values of
    [] -> w
    value : rest -> let (ready, slot) = fresh w "%ptr" in
      let pointed = line ready (cat ["  ", slot, " = getelementptr i64, ptr ", pointer, ", i64 ", nat-to-string index]) in
      store-fields (line pointed (cat ["  store i64 ", value, ", ptr ", slot])) pointer (index + 1) rest
  pattern-type :: CorePattern -> UType
  pattern-type pattern = case pattern of
    CPVar sp ty id name -> ty
    CPWild sp ty -> ty
    CPAs sp ty id name inner -> ty
    CPTuple sp ty fields -> ty
    CPConstructor sp ty name actuals constructor fields -> ty
    CPInt sp ty text -> ty
    CPChar sp ty text -> ty
    CPSymbol sp ty text -> ty
    CPString sp ty text -> ty
    other -> UError
  continue-if :: Writer -> String -> String -> Writer
  continue-if w condition failed =
    let (one, flag) = fresh w "%v" in
    let (two, succeeded) = fresh one "matched" in
    line (line (line two (cat ["  ", flag, " = icmp ne i64 ", condition, ", 0"])) (cat ["  br i1 ", flag, ", label %", succeeded, ", label %", failed])) (cat [succeeded, ":"])
  -- A constructor's tag is its header's low layout byte; 255 is the escape,
  -- whose tag is word 0 of the descriptor addressed by the word before the
  -- header. The test is always made: any block, another artifact's
  -- included, may be escaped.
  constructor-tag :: Writer -> String -> (Writer, String)
  constructor-tag w value =
    let (one, pointer) = fresh w "%ptr" in
    let (two, slot) = fresh one "%ptr" in
    let (three, header) = fresh two "%v" in
    let (four, layout) = fresh three "%v" in
    let (five, escaped) = fresh four "%v" in
    let (six, extended-label) = fresh five "escaped-tag" in
    let (seven, regular-label) = fresh six "regular-tag" in
    let (eight, joined-label) = fresh seven "tag-join" in
    let (nine, extended-slot) = fresh eight "%ptr" in
    let (ten, descriptor) = fresh nine "%v" in
    let (eleven, descriptor-pointer) = fresh ten "%ptr" in
    let (twelve, extended-tag) = fresh eleven "%v" in
    let (thirteen, regular-tag) = fresh twelve "%v" in
    let (fourteen, tag) = fresh thirteen "%v" in
    let address = line (line fourteen (cat ["  ", pointer, " = inttoptr i64 ", value, " to ptr"])) (cat ["  ", slot, " = getelementptr i64, ptr ", pointer, ", i64 -1"]) in
    let load-op = if program-concurrent (writer-program address) then " = load atomic i64, ptr " else " = load i64, ptr " in
    let load-ord = if program-concurrent (writer-program address) then " monotonic, align 8" else ", align 8" in
    let loaded = line address (cat ["  ", header, load-op, slot, load-ord]) in
    (emit-lines loaded [
      cat ["  ", layout, " = lshr i64 ", header, ", 40"],
      cat ["  ", regular-tag, " = and i64 ", layout, ", 255"],
      cat ["  ", escaped, " = icmp eq i64 ", regular-tag, ", 255"],
      cat ["  br i1 ", escaped, ", label %", extended-label, ", label %", regular-label],
      cat [extended-label, ":"],
      cat ["  ", extended-slot, " = getelementptr i64, ptr ", pointer, ", i64 -2"],
      cat ["  ", descriptor, " = load i64, ptr ", extended-slot],
      cat ["  ", descriptor-pointer, " = inttoptr i64 ", descriptor, " to ptr"],
      cat ["  ", extended-tag, " = load i64, ptr ", descriptor-pointer],
      cat ["  br label %", joined-label],
      cat [regular-label, ":"],
      cat ["  br label %", joined-label],
      cat [joined-label, ":"],
      cat ["  ", tag, " = phi i64 [ ", extended-tag, ", %", extended-label, " ], [ ", regular-tag, ", %", regular-label, " ]"]], tag)
  match-pattern :: CorePattern -> String -> String -> Writer -> (Writer, List Local)
  match-pattern pattern value failed w = if not (word-type (w.context) (pattern-type pattern)) then
    (refuse w (Span 0 0 1 1) "pattern needs typed runtime match lowering", [])
    else case pattern of
      CPVar sp ty id name -> (w, [Borrowed id ty value])
      CPWild sp ty -> (w, [])
      CPAs sp ty id name inner -> case match-pattern inner value failed w of
        (done, bindings) -> (done, (Borrowed id ty value) : bindings)
      CPTuple sp ty fields -> case fields of
        CPDone end -> (w, [])
        other -> let (ready, pointer) = fresh w "%ptr" in
          match-fields fields pointer 0 failed (line ready (cat ["  ", pointer, " = inttoptr i64 ", value, " to ptr"]))
      CPConstructor sp ty name actuals sc fields ->
        if decision-word-type (shared-pattern-carrier ty) && (name == "b.Yes" || name == "b.No") && erased-decision-fields fields then
          (case constructor-tag w value of
            (loaded, actual) -> case compare-word loaded "eq" actual (if name == "b.Yes" then "0" else "1") of
              (compared, condition) -> (continue-if compared condition failed, []))
        else if named (shared-pattern-carrier ty) "Bool" && (name == "True" || name == "False") then
          (case compare-word w "eq" value (if name == "True" then "1" else "0") of
            (ready, condition) -> (continue-if ready condition failed, []))
        else if name == "Refl" then (w, [])
        else case constructor name (writer-program w) of
          Some (owner, tag, c) -> (case data-declaration owner (writer-program w) of
            Some d -> case core-data-layout d of
              UnboxedData label word bytes align -> match-unboxed fields value failed w
              ValueData repr sz al vfields -> match-value-data ty sz al vfields fields value failed w
              layout -> if tag < 16777216 then
                (case constructor-tag w value of
                  (loaded, actual) -> case compare-word loaded "eq" actual (nat-to-string tag) of
                    (compared, condition) -> let (ready, pointer) = fresh (continue-if compared condition failed) "%ptr" in
                      let pointed = line ready (cat ["  ", pointer, " = inttoptr i64 ", value, " to ptr"]) in
                      (case layout of
                        TransparentData field bytes align | bytes < 8 -> match-transparent fields pointer bytes align failed pointed
                        other -> match-fields fields pointer 0 failed pointed))
                else (refuse w sp "constructor pattern needs a specialized runtime representation", [])
            None -> (refuse w sp "constructor pattern has no defining runtime declaration", []))
          None -> (refuse w sp "constructor pattern has no defining runtime declaration", [])
      CPInt sp ty text -> if number ty then
        (case decimal w ty text of
          (literal, word) -> case call literal (cat ["@cinch_", runtime-number ty, "_cmp"]) [value, word] of
            (compared, order) -> case compare-word (count-op False ty word compared) "eq" order "0" of
              (ready, condition) -> (continue-if ready condition failed, []))
        else if raw-integer ty then (case compare-word w "eq" value text of (ready, condition) -> (continue-if ready condition failed, []))
        else if wide-scalar ty then (case compare-typed w "i128" "eq" value (wide-literal ty text) of (ready, condition) -> (continue-if ready condition failed, []))
        else (refuse w sp "literal pattern needs mathematical runtime comparison", [])
      CPSymbol sp ty text -> (case symbol-literal w sp ty text of
        (interned, cell) -> case call (request-demand SymbolEquality interned) "@\"cinch.runtime.symEq\"" [value, cell] of
          (ready, condition) -> (continue-if ready condition failed, []))
      CPChar sp ty text -> if named ty "Char" then (case char-word text of
        Some word -> (case compare-word w "eq" value word of (ready, condition) -> (continue-if ready condition failed, []))
        None -> (refuse w sp "invalid typed character pattern", [])) else (refuse w sp "character pattern has no checked Char carrier", [])
      CPString sp ty text -> string-pattern w sp ty value text failed
      other -> (refuse w (Span 0 0 1 1) "pattern form needs typed runtime match lowering", [])
  match-transparent :: CorePattern -> String -> Nat -> Nat -> String -> Writer -> (Writer, List Local)
  match-transparent fields pointer bytes align failed w = case fields of
    CPField sp (CPProof at predicate id name) rest -> match-transparent rest pointer bytes align failed w
    CPField sp first rest -> if bytes == 0 then match-pattern first "0" failed w else
      let ty = "i" <> nat-to-string (8 * bytes) in
      let (one, bits) = fresh w "%v" in
      let loaded = line one (cat ["  ", bits, " = load ", ty, ", ptr ", pointer, ", align ", nat-to-string align]) in
      let (two, value) = fresh loaded "%v" in
      let field = pattern-type first in
      let extend = (if named field "I8" || named field "I16" || named field "I32" then "sext" else "zext") in
      match-pattern first value failed (line two (cat ["  ", value, " = ", extend, " ", ty, " ", bits, " to i64"]))
    other -> (refuse w (Span 0 0 1 1) "transparent pattern lacks its checked field", [])
  match-unboxed :: CorePattern -> String -> String -> Writer -> (Writer, List Local)
  match-unboxed fields value failed w = case fields of
    CPField sp (CPProof at predicate id name) rest -> match-unboxed rest value failed w
    CPField sp first rest -> match-pattern first value failed w
    other -> (refuse w (Span 0 0 1 1) "unboxed pattern lacks its checked payload", [])

  match-fields :: CorePattern -> String -> Nat -> String -> Writer -> (Writer, List Local)
  match-fields fields pointer index failed w = case fields of
    CPDone end -> (w, [])
    CPField sp (CPProof at predicate id name) rest -> match-fields rest pointer index failed w
    CPField sp first rest ->
      case read-slot (pattern-type first) pointer index w of
        (loaded, llvm, value, next) -> case match-pattern first value failed loaded of
          (bound, bindings) -> case match-fields rest pointer next failed bound of
            (done, more) -> (done, bindings <> more)
    other -> (refuse w (Span 0 0 1 1) "malformed tuple pattern spine", [])
  read-slot :: UType -> String -> Nat -> Writer -> (Writer, String, String, Nat)
  read-slot ty pointer index w =
    let (one, slot) = fresh w "%ptr" in
    let pointed = line one (cat ["  ", slot, " = getelementptr i64, ptr ", pointer, ", i64 ", nat-to-string index]) in
    case type-value-size-align (pointed.context) ty of
      Some (sz, al) ->
        let words = val-size-words sz in
        if sz > 16 || al > 16 then
          let (two, buf) = fresh (request-demand MemcpyDemand pointed) "%valslot" in
          let copied = emit-lines two [
            cat ["  ", buf, " = alloca [", nat-to-string sz, " x i8], align ", nat-to-string al],
            cat ["  call void @llvm.memcpy.p0.p0.i64(ptr align ", nat-to-string al, " ", buf, ", ptr align 1 ", slot, ", i64 ", nat-to-string sz, ", i1 false)"]] in
          (copied, "ptr", buf, index + words)
        else if sz > 8 then
          let (two, value) = fresh pointed "%v" in
          (line two (cat ["  ", value, " = load { i64, i64 }, ptr ", slot, ", align 8"]), "{ i64, i64 }", value, index + 2)
        else
          let (two, value) = fresh pointed "%v" in
          (line two (cat ["  ", value, " = load i64, ptr ", slot]), "i64", value, index + 1)
      None ->
        let wide = wide-type (pointed.context) ty in
        let access = if wide then "i128" else "i64" in
        let alignment = if wide then ", align 8" else "" in
        let (two, value) = fresh pointed "%v" in
        (line two (cat ["  ", value, " = load ", access, ", ptr ", slot, alignment]), access, value, index + (if wide then 2 else 1))
  guarded-expression :: List CoreDefinition -> List Local -> Writer -> String -> CoreTerm -> (Writer, String)
  guarded-expression definitions locals w failed term = case term of
    CRequire sp ty body -> guarded-expression definitions locals w failed body
    CGuard sp ty condition body -> if core-alternative-covers term then guarded-expression definitions locals w failed body
      else (case expression definitions locals w condition of
        (ready, value) -> guarded-expression definitions locals (continue-if ready value failed) failed body)
    CLet sp ty id name sc rhs body -> if row-guarded body then guarded-let definitions locals w failed sp id sc rhs body
      else expression definitions locals w term
    other -> expression definitions locals w term
  row-guarded :: CoreTerm -> Bool
  row-guarded term = case term of
    CLet sp ty id name sc rhs body -> row-guarded body
    CRequire sp ty body -> row-guarded body
    CGuard sp ty condition body -> True
    other -> False
  guarded-let :: List CoreDefinition -> List Local -> Writer -> String -> Span -> Nat -> Scheme -> CoreTerm -> CoreTerm -> (Writer, String)
  guarded-let definitions locals w failed sp id sc rhs body = case scheme-params sc of
    [] -> if scheme-supported (w.context) sc && word-type (w.context) (scheme-body sc) then
      (case expression definitions locals w rhs of
        (bound, value) ->
          let bound-locals = (Local id (scheme-body sc) value) : locals in
          let release = count-op False (scheme-body sc) value in
          if core-alternative-covers body then (case guarded-expression definitions bound-locals bound failed body of
            (done, result) -> (release done, result))
          else let (one, cleanup) = fresh bound "guardcleanup" in
            let (two, next) = fresh one "guardpassed" in
            let (done, result) = guarded-expression definitions bound-locals two cleanup body in
            let missed = line (line (release done) (cat ["  br label %", next])) (cat [cleanup, ":"]) in
            (line (line (release missed) (cat ["  br label %", failed])) (cat [next, ":"]), result))
      else unsupported w sp "guarded where binding needs a runtime word"
    other -> if local-function-value rhs && (case scheme-requirements sc of [] -> True; other -> False) then
      guarded-expression definitions locals w failed (specialize-local id sc rhs body)
      else (case bundled-let sp id sc rhs body of
        Some bundled -> guarded-expression definitions locals w failed bundled
        None -> unsupported w sp "guarded where binding needs runtime specialization")
  -- A case whose scrutinee is a saturated constructor application already
  -- knows its alternative. Evaluating the scrutinee allocates a cell the
  -- case takes apart at once, so the alternative is lowered with the
  -- applied arguments in place of its binders, and those arguments are
  -- released where the allocation would have owned them. An alternative
  -- that reads the scrutinee as a whole cannot be expressed this way, and
  -- an alternative guarded by a row keeps the allocating path because a
  -- failed guard must reach the alternatives after it.
  data CaseFold where
    FoldCase :: CorePattern -> CoreTerm -> CaseFold
    FoldAbsent :: CaseFold
    FoldBlocked :: CaseFold
  fold-known-case :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> CoreTerm -> Option (Writer, String)
  fold-known-case definitions locals w value alternatives = case erased-constructor-call value [] of
    Some (name, actuals, args) -> fold-known-application definitions locals w (core-type value) name args alternatives
    None -> case value of
      CLocal lsp lty id lname [] -> case deferred-constructor id locals of
        Some (ctor, actuals, args) -> fold-known-application definitions locals w (core-type value) ctor args alternatives
        None -> case inline-scrutinee definitions w value of
          Some (name, args) -> fold-known-application definitions locals w (core-type value) name args alternatives
          None -> None
      other -> case inline-scrutinee definitions w value of
        Some (name, args) -> fold-known-application definitions locals w (core-type value) name args alternatives
        None -> fold-cpr-case definitions locals w value alternatives
  deferred-constructor :: Nat -> List Local -> Option (String, List UType, List CoreTerm)
  deferred-constructor id locals = case locals of
    [] -> None
    (DeferredConstructor key ty name actuals args) : rest -> if key == id then Some (name, actuals, args) else deferred-constructor id rest
    other : rest -> deferred-constructor id rest
  -- A let-bound constructor application is deferred only when its single
  -- use is a case scrutinee and every argument is already a value: then
  -- nothing between the binder and that case can observe when the
  -- arguments were read or that the cell was never built.
  deferred-let :: Writer -> Nat -> Scheme -> CoreTerm -> CoreTerm -> Bool
  deferred-let w id sc rhs body =
    (case scheme-params sc of [] -> True; other -> False) && (case scheme-requirements sc of [] -> True; other -> False)
      && scheme-supported (w.context) sc && word-type (w.context) (scheme-body sc)
      && case-scrutinee-only id body && (case deferred-value (writer-program w) rhs of Some plan -> True; None -> False)
  deferred-value :: ProgramInfo -> CoreTerm -> Option (String, List UType, List CoreTerm)
  deferred-value datas rhs = case erased-constructor-call rhs [] of
    Some (name, actuals, args) -> if trivial-arguments args && (case constructor name datas of Some found -> True; None -> False) then Some (name, actuals, args) else None
    None -> None
  trivial-arguments :: List CoreTerm -> Bool
  trivial-arguments args = case args of
    [] -> True
    first : rest -> trivial-term first && trivial-arguments rest
  trivial-term :: CoreTerm -> Bool
  trivial-term term = case term of
    CLocal sp ty id name [] -> True
    CInt sp ty text -> True
    CString sp ty text -> True
    CSymbol sp ty text -> True
    CChar sp ty text -> True
    CUnit sp ty -> True
    CProofRef sp ty id name -> True
    CProofRefl sp ty -> True
    CUse sp ty name role actuals -> role == "constructor"
    other -> False
  -- Exactly one use of the binder, and that use is a case scrutinee.
  case-scrutinee-only :: Nat -> CoreTerm -> Bool
  case-scrutinee-only id body = not (other-local-use id body) && case-scrutinee-count id body == 1
  other-local-use :: Nat -> CoreTerm -> Bool
  other-local-use id term = case term of
    CLocal sp ty key name actuals -> key == id
    CCase sp ty value alternatives -> case-local-use id value || other-local-use id alternatives
    -- A closure rebuilds its environment from captures, and a deferred
    -- constructor carries no word to capture. A use inside one is therefore
    -- never the scrutinee deferral is admitted for, even when it is that
    -- closure's case scrutinee.
    CLambda sp ty pattern body -> term-uses id term
    CRecursiveFunctions sp ty members body -> term-uses id term
    CRecursiveValues sp ty region members body -> term-uses id term
    other -> other-local-use-any id (runtime-term-children term)
  case-local-use :: Nat -> CoreTerm -> Bool
  case-local-use id value = case value of
    CLocal sp ty key name [] -> False
    other -> other-local-use id other
  other-local-use-any :: Nat -> List CoreTerm -> Bool
  other-local-use-any id terms = case terms of
    [] -> False
    first : rest -> other-local-use id first || other-local-use-any id rest
  case-scrutinee-count :: Nat -> CoreTerm -> Nat
  case-scrutinee-count id term = case term of
    CCase sp ty value alternatives -> case-scrutinee-value id value + case-scrutinee-count-any id (runtime-term-children term)
    other -> case-scrutinee-count-any id (runtime-term-children term)
  case-scrutinee-count-any :: Nat -> List CoreTerm -> Nat
  case-scrutinee-count-any id terms = case terms of
    [] -> 0
    first : rest -> case-scrutinee-count id first + case-scrutinee-count-any id rest
  case-scrutinee-value :: Nat -> CoreTerm -> Nat
  case-scrutinee-value id value = case value of
    CLocal sp ty key name [] -> if key == id then 1 else 0
    other -> 0
  fold-known-application :: List CoreDefinition -> List Local -> Writer -> UType -> String -> List CoreTerm -> CoreTerm -> Option (Writer, String)
  fold-known-application definitions locals w ty name args alternatives = case known-constructor-fields w ty name of
    Some count -> if count == list-length args then (case fold-alternatives alternatives name count of
        FoldCase fields body -> if row-guarded body then None else Some (fold-case-body definitions locals w args fields body)
        other -> None)
      else None
    None -> None
  -- The runtime field count of a constructor whose declared representation
  -- the allocating path supports, so folding never admits a case the
  -- ordinary path refuses.
  known-constructor-fields :: Writer -> UType -> String -> Option Nat
  known-constructor-fields w ty name =
    if named ty "Bool" && (name == "True" || name == "False") then Some 0
    else if name == "Refl" then Some 0
    else if decision-word-type ty && (name == "b.Yes" || name == "b.No") then Some 0
    else case constructor name (writer-program w) of
      Some (owner, tag, c) -> if tag < 16777216 then Some (list-length (core-constructor-fields c)) else None
      None -> None
  fold-alternatives :: CoreTerm -> String -> Nat -> CaseFold
  fold-alternatives alternatives name count = case alternatives of
    CAlternative sp pattern body rest -> case fold-alternative pattern name count body of
      FoldAbsent -> fold-alternatives rest name count
      other -> other
    other -> FoldBlocked
  fold-alternative :: CorePattern -> String -> Nat -> CoreTerm -> CaseFold
  fold-alternative pattern name count body = case pattern of
    CPWild sp ty -> FoldCase (CPDone sp) body
    CPVar sp ty id binder -> if term-local-use id body then FoldBlocked else FoldCase (CPDone sp) body
    CPAs sp ty id binder inner -> if term-local-use id body then FoldBlocked else fold-alternative inner name count body
    CPConstructor sp ty cname actuals sc fields ->
      if cname == name then
        if runtime-field-count fields 0 == count && fold-field-check fields body then FoldCase fields body else FoldBlocked
      else FoldAbsent
    other -> FoldAbsent
  -- A field pattern this transform can bind is a variable, a wildcard, or
  -- an as-pattern over one: every binder is then a whole argument word. A
  -- nested constructor or tuple pattern stays refused, and a field binder
  -- the body reads as a whole value keeps the allocating path.
  runtime-field-count :: CorePattern -> Nat -> Nat
  runtime-field-count fields count = case fields of
    CPDone sp -> count
    CPField sp (CPProof at predicate id binder) rest -> runtime-field-count rest count
    CPField sp first rest -> runtime-field-count rest (count + 1)
    other -> count
  -- A field pattern binds whole argument words, so any binder may be used:
  -- only a nested constructor, tuple or literal pattern has no word to bind
  -- and keeps the allocating path.
  fold-field-check :: CorePattern -> CoreTerm -> Bool
  fold-field-check fields body = case fields of
    CPDone sp -> True
    CPField sp (CPProof at predicate id binder) rest -> fold-field-check rest body
    CPField sp first rest -> fold-leaf-check first && fold-field-check rest body
    other -> False
  fold-leaf-check :: CorePattern -> Bool
  fold-leaf-check pattern = case pattern of
    CPWild sp ty -> True
    CPVar sp ty id binder -> True
    CPAs sp ty id binder inner -> fold-leaf-check inner
    other -> False
  term-local-use :: Nat -> CoreTerm -> Bool
  term-local-use id term = case term of
    CLocal sp ty key name actuals -> key == id
    other -> term-local-use-any id (runtime-term-children term)
  term-local-use-any :: Nat -> List CoreTerm -> Bool
  term-local-use-any id terms = case terms of
    [] -> False
    first : rest -> term-local-use id first || term-local-use-any id rest
  fold-case-body :: List CoreDefinition -> List Local -> Writer -> List CoreTerm -> CorePattern -> CoreTerm -> (Writer, String)
  fold-case-body definitions locals w args fields body =
    case expressions definitions locals w args of
      (evaluated, words) -> case expression definitions (fold-field-locals fields words <> locals) evaluated body of
        (done, result) -> (release-terms (term-types args) words done, result)
  -- The binders of a folded alternative, in argument order, as borrowed
  -- reads of the evaluated arguments. Only reached after the field check
  -- admitted the spine, so the walk consumes every word that is there.
  fold-field-locals :: CorePattern -> List String -> List Local
  fold-field-locals fields words = case fields of
    CPDone sp -> []
    CPField sp (CPProof at predicate id binder) rest -> fold-field-locals rest words
    CPField sp first rest -> case words of
      [] -> []
      word : more -> case first of
        CPWild wspan wty -> fold-field-locals rest more
        CPVar vspan vty id binder -> (Borrowed id vty word) : (fold-field-locals rest more)
        CPAs aspan atyp id binder (CPWild ispan ity) -> (Borrowed id atyp word) : (fold-field-locals rest more)
        CPAs aspan atyp id binder (CPVar ispan ity iid ibinder) -> (Borrowed id atyp word) : (Borrowed iid ity word) : (fold-field-locals rest more)
        other -> []
    other -> []
  release-terms :: List UType -> List String -> Writer -> Writer
  release-terms types words w = case types of
    [] -> w
    first : rest -> case words of word : more -> release-terms rest more (count-op False first word w); [] -> w
  -- A unit small enough to copy is copied at each of its call sites. The
  -- copy binds its arguments where the call would pass them and releases
  -- them where the callee's worker releases its parameters, so the copy
  -- counts references exactly as the call did. Copying is bounded by a node
  -- budget of two percent of the program, and no admitted unit may name
  -- another admitted unit: that fixed point is the loop-breaker rule, and
  -- it is what keeps a recursive group out.
  inline-body-shape :: CoreDefinition -> Option (List CorePattern, CoreTerm)
  inline-body-shape d = case d.givens of
    [] -> case d.openings of
      [] -> case d.clauses of
        [CoreClause sp patterns body] -> if variable-patterns patterns && not (row-guarded body) then Some (patterns, body) else None
        other -> None
      other -> None
    other -> None
  variable-patterns :: List CorePattern -> Bool
  variable-patterns patterns = case patterns of
    [] -> True
    first : rest -> (case first of CPVar sp ty id name -> True; other -> False) && variable-patterns rest
  term-nodes :: CoreTerm -> Nat
  term-nodes term = 1 + term-nodes-any (runtime-term-children term)
  term-nodes-any :: List CoreTerm -> Nat
  term-nodes-any terms = case terms of [] -> 0; first : rest -> term-nodes first + term-nodes-any rest
  definition-nodes :: CoreDefinition -> Nat
  definition-nodes d = clause-nodes (d.clauses)
  clause-nodes :: List CoreClause -> Nat
  clause-nodes clauses = case clauses of
    [] -> 0
    (CoreClause sp patterns body) : rest -> term-nodes body + clause-nodes rest
  program-nodes :: List CoreDefinition -> Nat
  program-nodes definitions = case definitions of
    [] -> 0
    first : rest -> definition-nodes first + program-nodes rest
  -- The copy limit is the seed's: two percent of the program, never less
  -- than a thousand nodes, so a small program still admits its wrappers.
  inline-limit :: List CoreDefinition -> Nat
  inline-limit definitions = let total = program-nodes definitions in if total / 50 < 1000 then 1000 else total / 50
  inline-candidates :: List CoreDefinition -> List (String, CoreTerm) -> List (String, CoreTerm)
  inline-candidates definitions entries = case definitions of
    [] -> entries
    d : rest -> case inline-body-shape d of
      Some (patterns, body) -> if term-nodes body <= 40 then inline-candidates rest ((d.name, body) : entries) else inline-candidates rest entries
      None -> inline-candidates rest entries
  inline-admitted-names :: List CoreDefinition -> List String
  inline-admitted-names definitions = inline-class-names definitions (inline-spend definitions (inline-candidates definitions []) (inline-limit definitions) [])
  -- Admit entries while the budget lasts, then drop every entry whose body
  -- names an admitted entry, until nothing changes. The result names units
  -- no admitted unit reaches, so a copy can only reference units that are
  -- not copied, and no cycle of copies can exist.
  inline-spend :: List CoreDefinition -> List (String, CoreTerm) -> Nat -> List String -> List String
  inline-spend definitions entries budget names = case entries of
    [] -> inline-settle definitions (inline-remove-referenced definitions names names []) names
    (name, body) : rest -> let cost = term-nodes body in
      if budget < cost then inline-spend definitions rest budget names else inline-spend definitions rest (budget - cost) (name : names)
  inline-settle :: List CoreDefinition -> List String -> List String -> List String
  inline-settle definitions names previous = if list-length names == list-length previous then names else
    inline-settle definitions (inline-remove-referenced definitions names names []) names
  inline-remove-referenced :: List CoreDefinition -> List String -> List String -> List String -> List String
  inline-remove-referenced definitions names admitted kept = case names of
    [] -> kept
    name : rest -> if inline-unit-references admitted definitions name then inline-remove-referenced definitions rest admitted kept else inline-remove-referenced definitions rest admitted (name : kept)
  name-listed :: String -> List String -> Bool
  name-listed name names = case names of [] -> False; first : rest -> name == first || name-listed name rest
  term-refers :: List String -> CoreTerm -> Bool
  term-refers names term = case term of
    CUse sp ty name role actuals -> name-listed name names || term-refers-any names (runtime-term-children term)
    CQualifiedUse sp ty name role actuals evidence -> name-listed name names || term-refers-any names (runtime-term-children term)
    other -> term-refers-any names (runtime-term-children term)
  term-refers-any :: List String -> List CoreTerm -> Bool
  term-refers-any names terms = case terms of
    [] -> False
    first : rest -> term-refers names first || term-refers-any names rest
  clauses-refer :: List String -> List CoreClause -> Bool
  clauses-refer names clauses = case clauses of
    [] -> False
    (CoreClause sp patterns body) : rest -> term-refers names body || clauses-refer names rest
  inline-unit-references :: List String -> List CoreDefinition -> String -> Bool
  inline-unit-references names definitions name = case definitions of
    [] -> False
    d : rest -> if name == d.name then clauses-refer names (d.clauses) else inline-unit-references names rest name
  -- The unfoldable class: a body whose every node is work the code
  -- generator performs at the site of the node. A unit in the class is
  -- copied to every call site, whatever the site count, because a copy
  -- replaces a call and its frame with the instruction itself. The class
  -- excludes every node whose copy creates a scope or an allocation site:
  -- a lambda, a recursive group, a scope, a handler, a join, a `let` (whose
  -- binder is a slot of the defining unit), a construction, and a decision
  -- whose scrutinee is unknown here. A decision over a known constructor is
  -- admitted because it folds, which is the shallow case rule.
  --
  -- Admission is the class plus a size cap: 12 nodes for a body of
  -- projections and primitives, 40 when it calls another unit (a link the
  -- recursive rule expands, so a chain can close), and 24 with a decision.
  -- A directly recursive body is refused; an indirect cycle is broken at
  -- emission by the plan's unfolding stack.
  unfold-shape :: CoreTerm -> Option UnfoldShape
  unfold-shape term = case term of
    CInt sp ty text -> Some (UnfoldShape False 0)
    CString sp ty text -> Some (UnfoldShape False 0)
    CSymbol sp ty text -> Some (UnfoldShape False 0)
    CChar sp ty text -> Some (UnfoldShape False 0)
    CUnit sp ty -> Some (UnfoldShape False 0)
    -- A constructor use is a block build: one allocation per copy.
    CUse sp ty name role actuals -> if role == "constructor" then None else Some (UnfoldShape False 0)
    CQualifiedUse sp ty name role actuals evidence -> if role == "constructor" then None else Some (UnfoldShape False 0)
    CLocal sp ty key name actuals -> Some (UnfoldShape False 0)
    CProofRef sp ty index name -> Some (UnfoldShape False 0)
    CProofRefl sp ty -> Some (UnfoldShape False 0)
    CProofSearch sp ty decide warrant -> Some (UnfoldShape False 0)
    CApply sp ty f x -> case unfold-merge (unfold-shape f) (unfold-shape x) of
      Some (UnfoldShape chain cases) -> Some (UnfoldShape (chain || is-unit-spine f) cases)
      None -> None
    CErasedApply sp ty row f witness -> unfold-merge (unfold-shape f) (unfold-shape witness)
    CDecision sp ty predicate condition -> unfold-shape condition
    CPrimitive sp ty name arg -> unfold-shape arg
    CProved sp ty warrant body -> unfold-shape body
    CRefine sp ty warrant body -> unfold-shape body
    CRefineProof sp ty warrant body -> unfold-merge (unfold-shape warrant) (unfold-shape body)
    CDischarge sp ty warrants _ body -> unfold-shape body
    CForget sp ty body -> unfold-shape body
    CCast sp ty body -> unfold-shape body
    CIf sp ty test yes no -> unfold-merge (unfold-merge (unfold-shape test) (unfold-shape yes)) (unfold-shape no)
    CArgument sp first rest -> unfold-merge (unfold-shape first) (unfold-shape rest)
    CArgumentsEnd sp -> Some (UnfoldShape False 0)
    other -> None
  unfold-merge :: Option UnfoldShape -> Option UnfoldShape -> Option UnfoldShape
  unfold-merge a b = case a of
    Some (UnfoldShape chain-a cases-a) -> case b of
      Some (UnfoldShape chain-b cases-b) -> Some (UnfoldShape (chain-a || chain-b) (cases-a + cases-b))
      None -> None
    None -> None
  -- An application spine whose head names a unit: the link a copy may
  -- expand. It only widens the cap, so a false positive costs nothing.
  is-unit-spine :: CoreTerm -> Bool
  is-unit-spine term = case term of
    CUse sp ty name role actuals -> True
    CQualifiedUse sp ty name role actuals evidence -> True
    CApply sp ty f x -> is-unit-spine f
    CApplyEff sp ty row f x -> is-unit-spine f
    CErasedApply sp ty row f witness -> is-unit-spine f
    other -> False
  -- Twelve nodes is the whole class cap on this side. The measurement is
  -- what set it: admitting a body with a unit call up to forty nodes copied
  -- a twenty-node body with calls in both branches four hundred times, and
  -- the self-hosted IR grew by 3.6 % with two thousand more allocation
  -- sites. A wrapper that delegates to another unit is two to seven nodes,
  -- so the wider cap bought nothing the target class needs.
  inline-class-candidate :: CoreDefinition -> Option UnfoldShape
  inline-class-candidate d = case inline-body-shape d of
    Some (patterns, body) ->
      if term-refers ([d.name]) body then None else
        (case unfold-shape body of
          Some shape -> if term-nodes body <= 12 then Some shape else None
          None -> None)
    None -> None
  inline-class-names :: List CoreDefinition -> List String -> List String
  inline-class-names definitions known = case definitions of
    [] -> known
    d : rest -> case inline-class-candidate d of
      Some shape -> inline-class-names rest ((d.name) : known)
      None -> inline-class-names rest known
  inline-name-map :: List String -> HashMap String () -> HashMap String ()
  inline-name-map names acc = case names of
    [] -> acc
    first : rest -> inline-name-map rest (hash-map-insert first () acc)
  inline-plan :: Bool -> List CoreDefinition -> ProgramInfo -> InlinePlan
  inline-plan enabled definitions info = if enabled then InlinePlan True (inline-name-map (inline-admitted-names definitions) hash-map-empty) [] else NoInline
  with-inline :: InlinePlan -> Writer -> Writer
  with-inline plan w = case w of Writer next globals code errors layouts context -> Writer next globals code errors layouts (context-inline plan context)
  context-inline :: InlinePlan -> RuntimeContext -> RuntimeContext
  context-inline plan context = case context of RuntimeContext info bounds rigids queue current -> RuntimeContext info bounds rigids queue plan
  inline-admitted :: RuntimeContext -> String -> Bool
  inline-admitted context name = case context of
    RuntimeContext info bounds rigids queue plan -> case plan of
      InlinePlan enabled names stack -> enabled && (case hash-map-lookup name names of Some _ -> True; None -> False) && function-hint info name /= "noinline" && not (name-listed name stack)
      NoInline -> False
  -- The unfolding stack and its one bound: a unit already on the stack is
  -- refused, so a cycle of admitted units cannot recurse without end, and
  -- the depth cap bounds a long acyclic chain.
  inline-stack :: RuntimeContext -> List String
  inline-stack context = case context of
    RuntimeContext info bounds rigids queue plan -> case plan of
      InlinePlan enabled names stack -> stack
      NoInline -> []
  inline-depth :: RuntimeContext -> Nat
  inline-depth context = list-length (inline-stack context)
  context-push-inline :: String -> RuntimeContext -> RuntimeContext
  context-push-inline name context = case context of
    RuntimeContext info bounds rigids queue plan -> case plan of
      InlinePlan enabled names stack -> RuntimeContext info bounds rigids queue (InlinePlan enabled names (name : stack))
      NoInline -> context
  push-inline :: String -> Writer -> Writer
  push-inline name w = case w of Writer next globals code errors layouts context -> Writer next globals code errors layouts (context-push-inline name context)
  -- The push is only in scope while the copy is being emitted. Popping the
  -- head restores the plan the site was reached with, because every nested
  -- push inside the copy has already popped itself.
  context-pop-inline :: RuntimeContext -> RuntimeContext
  context-pop-inline context = case context of
    RuntimeContext info bounds rigids queue plan -> case plan of
      InlinePlan enabled names (first : stack) -> RuntimeContext info bounds rigids queue (InlinePlan enabled names stack)
      other -> context
  pop-inline :: Writer -> Writer
  pop-inline w = case w of Writer next globals code errors layouts context -> Writer next globals code errors layouts (context-pop-inline context)
  inline-call :: List CoreDefinition -> List Local -> Writer -> Span -> CoreDefinition -> List Nat -> List String -> List CoreTerm -> Option (Writer, String)
  inline-call definitions locals w sp d classes givens args =
    if not (inline-admitted (w.context) (d.name)) then None
    else if inline-depth (w.context) >= 6 then None
    else if (case givens of [] -> True; other -> False) then
      (case inline-body-shape d of
        Some (patterns, body) -> if list-length args == list-length patterns then
          (case definition-context d classes w of
            Some (RuntimeContext info bounds rigids queue inlining) ->
              (case inline-copy definitions locals (push-inline (d.name) (with-representations bounds rigids w)) args patterns body of
                (done, result) -> Some (pop-inline done, result))
            None -> None)
          else None
        None -> None)
    else None
  inline-copy :: List CoreDefinition -> List Local -> Writer -> List CoreTerm -> List CorePattern -> CoreTerm -> (Writer, String)
  inline-copy definitions locals w args patterns body =
    case expressions definitions locals w args of
      (evaluated, words) -> case expression definitions (parameter-locals patterns words <> locals) evaluated body of
        (done, result) -> (release-terms (term-types args) words done, result)
  parameter-locals :: List CorePattern -> List String -> List Local
  parameter-locals patterns words = case patterns of
    (CPVar sp ty id name) : rest -> case words of word : more -> (Borrowed id ty word) : (parameter-locals rest more); [] -> []
    other -> []
  -- The scrutinee of a case can be a call whose unit answers with a
  -- constructor application of its own parameters in order: the applied
  -- arguments are then the fields, and the case folds without the block
  -- the call would have allocated.
  call-spine :: CoreTerm -> List CoreTerm -> Option (String, List UType, List CoreTerm)
  call-spine term args = case term of
    CUse sp ty name role actuals -> if role == "constructor" then None else Some (name, actuals, args)
    CApply sp ty f x -> call-spine f (x : args)
    CApplyEff sp ty row f x -> call-spine f (x : args)
    CErasedApply sp ty row f witness -> call-spine f args
    other -> None
  identity-arguments :: List CorePattern -> List CoreTerm -> Bool
  identity-arguments patterns args = case args of
    [] -> True
    (CLocal at aty key kname []) : more -> case patterns of
      (CPVar sp ty id name) : rest -> id == key && identity-arguments rest more
      other -> False
    other -> False
  inline-scrutinee :: List CoreDefinition -> Writer -> CoreTerm -> Option (String, List CoreTerm)
  inline-scrutinee definitions w value = case call-spine value [] of
    Some (name, actuals, args) -> if not (inline-admitted (w.context) name) then None else case worker-definition name w of
      Some d -> case inline-body-shape d of
        Some (patterns, body) -> if list-length args /= list-length patterns then None else case erased-constructor-call body [] of
          Some (ctor, ctor-actuals, ctor-args) -> if identity-arguments patterns ctor-args then Some (ctor, args) else None
          None -> None
        None -> None
      None -> None
    None -> None
  -- A case dispatches once when every alternative is a plain constructor
  -- test: the tag is read once and one switch selects the arm, so an arm
  -- costs the same wherever it sits. Guards, refutable nested fields,
  -- repeated tags and mixed shapes keep the chain, whose source order then
  -- decides which arm runs.
  data CaseClass where
    UnsetClass :: CaseClass
    HeaderClass :: CaseClass
    ImmediateClass :: CaseClass
    MixedClass :: CaseClass
  data CaseDispatch where
    -- The switch tests the header tag. Its payload is the switch's case
    -- list, whose labels derive from the base name and the arm's position.
    HeaderDispatch :: String -> CaseDispatch
    -- The switch tests the value itself: the Bool and decision kernels
    -- already hold their tag as the word.
    ImmediateDispatch :: String -> CaseDispatch
    -- The alternatives are tested in source order, one at a time.
    ChainDispatch :: CaseDispatch
  data ArmPlan where
    -- The switch selects this tag, and the arm binds its fields from the
    -- cell the tag selected.
    TagArm :: String -> ArmPlan
    -- The switch tests this constant against the value, and the arm binds
    -- nothing: no field of such a pattern survives erasure.
    WordArm :: String -> ArmPlan
    NoArm :: ArmPlan
  -- One case's join: where the arms deliver their words, where an unmatched
  -- tag goes, the switch's label base, the scrutinee's type, and the word
  -- every arm releases once it holds its own result.
  record SwitchJoin where
    joined :: String
    missed :: String
    base :: String
    ty :: UType
    value :: String
    owned :: Bool
  -- A pattern that cannot fail once the switch has selected its arm, so the
  -- arm needs no test of its own.
  irrefutable-pattern :: CorePattern -> Bool
  irrefutable-pattern pattern = case pattern of
    CPVar sp ty id name -> True
    CPWild sp ty -> True
    CPAs sp ty id name inner -> irrefutable-pattern inner
    CPTuple sp ty fields -> irrefutable-fields fields
    other -> False
  irrefutable-fields :: CorePattern -> Bool
  irrefutable-fields fields = case fields of
    CPDone sp -> True
    CPField sp (CPProof at ty id name) rest -> irrefutable-fields rest
    CPField sp first rest -> irrefutable-pattern first && irrefutable-fields rest
    other -> False
  -- The tag a pattern names, when a switch can test it. The constant is the
  -- one this alternative's own pattern tests, never a neighbouring one's.
  arm-plan :: Writer -> CorePattern -> ArmPlan
  arm-plan w pattern = if not (word-type (w.context) (pattern-type pattern)) then NoArm
    else case pattern of
      -- A decision value is a produced constructor, not a tag: its word is
      -- not the 0/1 the chain's kernel test compares, so the switch keeps
      -- the chain for it rather than naming cases no value can have.
      CPConstructor sp ty name actuals sc fields ->
        if decision-word-type (shared-pattern-carrier ty) then NoArm
        else if named (shared-pattern-carrier ty) "Bool" && (name == "True" || name == "False") then
          WordArm (if name == "True" then "1" else "0")
        else if name == "Refl" then WordArm "0"
        else case constructor name (writer-program w) of
          Some (owner, tag, c) -> if uniform-owner owner w && tag < 16777216 && irrefutable-fields fields then TagArm (nat-to-string tag) else NoArm
          None -> NoArm
      other -> NoArm
  -- The dispatch a case can use. The switch's case list is fixed before any
  -- arm is emitted, so the switch can name labels the arms have not yet
  -- produced.
  case-dispatch :: Writer -> CoreTerm -> String -> CaseDispatch
  case-dispatch w alternatives base = case dispatch-spine w alternatives UnsetClass [] "" base 0 of
    (HeaderClass, entries) -> HeaderDispatch entries
    (ImmediateClass, entries) -> ImmediateDispatch entries
    other -> ChainDispatch
  dispatch-spine :: Writer -> CoreTerm -> CaseClass -> List String -> String -> String -> Nat -> (CaseClass, String)
  dispatch-spine w alternatives so-far tags entries base index = case alternatives of
    CAlternativesEnd sp -> (so-far, entries)
    CAlternative sp pattern body rest -> case pattern of
      CPVar at ty id name -> dispatch-default w body rest so-far entries
      CPWild at ty -> dispatch-default w body rest so-far entries
      other -> if row-guarded body then (MixedClass, entries) else case arm-plan w pattern of
        TagArm tag -> dispatch-arm w rest HeaderClass tag so-far tags entries base index
        WordArm tag -> dispatch-arm w rest ImmediateClass tag so-far tags entries base index
        NoArm -> (MixedClass, entries)
    other -> (MixedClass, entries)
  dispatch-default :: Writer -> CoreTerm -> CoreTerm -> CaseClass -> String -> (CaseClass, String)
  dispatch-default w body rest so-far entries = case rest of
    -- A default alternative captures every remaining tag, so only the last
    -- one can be the switch's default label.
    CAlternativesEnd sp -> (if row-guarded body then MixedClass else so-far, entries)
    other -> (MixedClass, entries)
  dispatch-arm :: Writer -> CoreTerm -> CaseClass -> String -> CaseClass -> List String -> String -> String -> Nat -> (CaseClass, String)
  dispatch-arm w rest class tag so-far tags entries base index =
    if tag-listed tag tags || not (compatible-class so-far class) then (MixedClass, entries)
      else dispatch-spine w rest class (tag : tags)
        (cat [entries, "\n  i64 ", tag, ", label %", base, ".", nat-to-string index]) base (index + 1)
  -- A repeated tag would make the switch ill formed, and the chain's first
  -- test is the one that runs.
  tag-listed :: String -> List String -> Bool
  tag-listed tag tags = case tags of [] -> False; first : rest -> tag == first || tag-listed tag rest
  compatible-class :: CaseClass -> CaseClass -> Bool
  compatible-class so-far next = case so-far of
    UnsetClass -> True
    HeaderClass -> case next of HeaderClass -> True; other -> False
    ImmediateClass -> case next of ImmediateClass -> True; other -> False
    other -> False
  case-value :: List CoreDefinition -> List Local -> Writer -> UType -> String -> CoreTerm -> (Writer, String)
  case-value definitions locals w ty value alternatives =
    case-value-mode definitions locals w ty value True alternatives
  case-value-mode :: List CoreDefinition -> List Local -> Writer -> UType -> String -> Bool -> CoreTerm -> (Writer, String)
  case-value-mode definitions locals w ty value owned alternatives =
    let (one, base) = fresh w "alt" in
    -- A switch names i64 cases and joins at an i64 phi; a wide scrutinee or
    -- result takes the chain, whose tests and slot are typed.
    if wide-type (w.context) ty || is-value-type (w.context) ty || alternatives-llvm w alternatives /= "i64" then case-chain definitions locals one ty value owned alternatives else
    case case-dispatch one alternatives base of
      HeaderDispatch entries -> switch-value definitions locals one ty value owned True base entries alternatives
      ImmediateDispatch entries -> switch-value definitions locals one ty value owned False base entries alternatives
      ChainDispatch -> case-chain definitions locals one ty value owned alternatives
  -- The chain tests one alternative at a time and stores the taken arm's
  -- word in the join's slot. Any shape reaches a slot, guarded or not, so
  -- this is the fallback for everything a single dispatch cannot take.
  case-chain :: List CoreDefinition -> List Local -> Writer -> UType -> String -> Bool -> CoreTerm -> (Writer, String)
  case-chain definitions locals w ty value owned alternatives =
    let result-ty = alternatives-llvm w alternatives in
    let (one, slot) = fresh w "%slot" in
    let (two, joined) = fresh one "casejoin" in
    let finished = case-rows definitions locals (line two (cat ["  ", slot, " = alloca ", result-ty])) ty value owned slot joined alternatives in
    let (ready, result) = fresh (line finished (cat [joined, ":"])) "%v" in
    (line ready (cat ["  ", result, " = load ", result-ty, ", ptr ", slot]), result)
  -- The LLVM type of the value a case's alternatives produce.
  alternatives-llvm :: Writer -> CoreTerm -> String
  alternatives-llvm w alternatives = case alternatives of
    CAlternative sp pattern body rest -> value-llvm (w.context) (core-type body)
    other -> "i64"
  case-rows :: List CoreDefinition -> List Local -> Writer -> UType -> String -> Bool -> String -> String -> CoreTerm -> Writer
  case-rows definitions locals w ty value owned slot joined alternatives = case alternatives of
    CAlternativesEnd end -> line w "  unreachable"
    CAlternative sp pattern body rest ->
      let (one, failed) = fresh w "nextalt" in
      case match-alternative pattern body locals value failed one of
        (matched, bindings, rebuilt) -> case guarded-expression definitions (bindings <> locals) matched failed rebuilt of
          (done, result) -> let cleaned = if owned then count-op False ty value done else done in
            let stored = line cleaned (cat ["  store ", value-llvm (done.context) (core-type body), " ", result, ", ptr ", slot]) in
            let next = line (line stored (cat ["  br label %", joined])) (cat [failed, ":"]) in
            case-rows definitions locals next ty value owned slot joined rest
    other -> line (refuse w (Span 0 0 1 1) "malformed case alternative spine") "  unreachable"
  -- One switch for the whole case, then one block per arm. Each arm leaves
  -- through a block of its own, so the join names every predecessor and
  -- becomes a phi rather than a slot.
  switch-value :: List CoreDefinition -> List Local -> Writer -> UType -> String -> Bool -> Bool -> String -> String -> CoreTerm -> (Writer, String)
  switch-value definitions locals w ty value owned header base entries alternatives =
    let (one, missed) = fresh w "switchmiss" in
    let (two, joined) = fresh one "casejoin" in
    let join = SwitchJoin joined missed base ty value owned in
    if header then (case constructor-tag w value of
      (loaded, tag) -> switch-arms definitions locals (line loaded (cat ["  switch i64 ", tag, ", label %", missed, " [", entries, "\n]"])) join alternatives 0 "" False)
    else switch-arms definitions locals (line w (cat ["  switch i64 ", value, ", label %", missed, " [", entries, "\n]"])) join alternatives 0 "" False
  switch-arms :: List CoreDefinition -> List Local -> Writer -> SwitchJoin -> CoreTerm -> Nat -> String -> Bool -> (Writer, String)
  switch-arms definitions locals w join alternatives index incoming defaulted = case join of
    SwitchJoin joined missed base ty value owned -> case alternatives of
      CAlternativesEnd sp -> if defaulted then switch-join w join incoming
        else switch-join (line (line w (cat [missed, ":"])) "  unreachable") join incoming
      CAlternative sp pattern body rest -> case pattern of
        CPVar at pty id name -> switch-default-arm definitions ((Borrowed id pty value) : locals) w join body rest index incoming
        CPWild at pty -> switch-default-arm definitions locals w join body rest index incoming
        other -> case arm-plan w pattern of
          TagArm tag -> switch-tag-arm definitions locals w join pattern body rest index incoming defaulted
          WordArm tag -> switch-word-arm definitions locals w join body rest index incoming defaulted
          NoArm -> (line (refuse w sp "case alternative disagrees with the dispatch it was chosen for") "  unreachable", incoming)
      other -> (line (refuse w (Span 0 0 1 1) "malformed case alternative spine") "  unreachable", incoming)
  switch-join :: Writer -> SwitchJoin -> String -> (Writer, String)
  switch-join w join incoming = case join of
    SwitchJoin joined missed base ty value owned -> let (ready, result) = fresh (line w (cat [joined, ":"])) "%v" in
      (line ready (cat ["  ", result, " = phi i64 ", incoming]), result)
  -- A default arm captures the scrutinee whole, so it needs no cell.
  switch-default-arm :: List CoreDefinition -> List Local -> Writer -> SwitchJoin -> CoreTerm -> CoreTerm -> Nat -> String -> (Writer, String)
  switch-default-arm definitions locals w join body rest index incoming = case join of
    SwitchJoin joined missed base ty value owned ->
      let (one, out) = fresh w "armout" in
      let entry = line one (cat [missed, ":"]) in
      case guarded-expression definitions locals entry missed body of
        (done, result) -> switch-leave definitions locals done join out result rest index incoming True
  -- A field passed unchanged, or consumed by one saturated word worker.
  -- Both forms evaluate once and give the next owner the existing reference.
  record FieldMove where
    id :: Nat
    ty :: UType
    word :: String
    worker :: Option String
  move-field :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> Option FieldMove
  move-field definitions locals w term = case term of
    CLocal sp ty id name [] -> local-field id locals None
    CApply sp ty (CUse at scheme name role []) (CLocal arg carrier id label []) ->
      (case worker-definition name w of
        Some d -> if (case scheme-params (d.scheme) of
              [] -> case scheme-requirements (d.scheme) of
                [] -> case definition-parameters d of
                  [parameter] -> not (wide-type (w.context) ty || wide-type (w.context) carrier)
                  other -> False
                other -> False
              other -> False) && (case definition-value-dependencies w d of [] -> True; other -> False)
            && (case d.givens of [] -> (case d.openings of [] -> True; other -> False); other -> False)
            then local-field id locals (Some name) else None
        None -> None)
    other -> None
  local-field :: Nat -> List Local -> Option String -> Option FieldMove
  local-field id locals worker = case local id locals of
    Some (ty, word) -> Some (FieldMove id ty word worker)
    None -> None
  evaluate-move :: FieldMove -> Writer -> (Writer, String)
  evaluate-move input w = case input of
    FieldMove id ty word None -> (w, word)
    FieldMove id ty word (Some name) -> call (demand-worker name [] w) (symbol (specialized-name name [])) [word]
  -- Every old field must have exactly one destination in the same physical
  -- slot. Aliased cells take the ordinary allocation path and keep all of
  -- their fields. A unique cell transfers its fields before calling workers.
  rebuilding-fields :: List CoreDefinition -> List Local -> Writer -> CorePattern -> List CoreTerm -> Option (List FieldMove)
  rebuilding-fields definitions locals w fields args = case fields of
    CPDone sp -> case args of [] -> Some []; other -> None
    CPField sp (CPVar at ty id name) rest -> case args of
      arg : more ->
        (case move-field definitions locals w arg of
          Some (FieldMove actual carrier word worker) | actual == id ->
            (case rebuilding-fields definitions locals w rest more of
              Some moves -> Some ((FieldMove actual carrier word worker) : moves)
              None -> None)
          other -> None)
      [] -> None
    other -> None
  retain-fields :: List FieldMove -> Writer -> Writer
  retain-fields fields w = case fields of
    [] -> w
    (FieldMove id ty word worker) : rest -> retain-fields rest (count-op True ty word w)
  evaluate-fields :: List FieldMove -> Writer -> (Writer, List String)
  evaluate-fields fields w = case fields of
    [] -> (w, [])
    input : rest -> case evaluate-move input w of
      (ready, result) -> case evaluate-fields rest ready of (done, values) -> (done, result : values)
  rebuild-case-cell :: List CoreDefinition -> List Local -> Writer -> UType -> String -> String -> CorePattern -> CoreTerm -> Option (Writer, String)
  rebuild-case-cell definitions locals w ty value pointer pattern body = if not ((writer-program w).reclaim) then None else case pattern of
    CPConstructor sp subject name actuals sc fields -> case head body of
      CUse at output ctor role params | (name == ctor) && role == "constructor" && scheme-equivalent (mono ty) (mono (core-type body)) ->
        let args = arguments body [] in
        (case args of
          first : rest -> case constructor name (writer-program w) of
            Some (owner, tag, c) -> (case data-declaration owner (writer-program w) of
              Some d -> (case core-data-layout d of
                UniformData -> case source-scheme-classes (w.context) (scheme-params (c.constructor-scheme)) params of
                  Some classes | not (val-code classes) && all-i64-llvms (value-llvms (w.context) (term-types args)) -> (case rebuilding-fields definitions locals w fields args of
                    Some moves -> (case request-data sp d classes w of
                      (planned, descriptor) -> Some (emit-rebuilt-cell planned ty value pointer (data-descriptor descriptor tag) (value-llvms (w.context) (term-types args)) moves))
                    None -> None)
                  other -> None
                other -> None)
              None -> None)
            None -> None
          [] -> None)
      other -> None
    other -> None
  emit-rebuilt-cell :: Writer -> UType -> String -> String -> Nat -> List String -> List FieldMove -> (Writer, String)
  emit-rebuilt-cell w ty value pointer descriptor types moves =
    let (one, unique) = fresh w "%unique" in
    let (two, shared) = fresh one "shared" in
    let (three, evaluate) = fresh two "fields" in
    let tested = line three (cat ["  ", unique, " = call i1 @cinch.typed.rc.unique(ptr ", pointer, ")"]) in
    let checked = line tested (cat ["  br i1 ", unique, ", label %", evaluate, ", label %", shared]) in
    let retained = retain-fields moves (line checked (cat [shared, ":"])) in
    let released = line (count-op False ty value retained) (cat ["  br label %", evaluate]) in
    case evaluate-fields moves (line released (cat [evaluate, ":"])) of
      (ready, values) -> let words = typed-values types values in
        let (four, reuse) = fresh ready "reuse" in
        let (five, create) = fresh four "allocate" in
        let (six, join) = fresh five "rebuilt" in
        let branched = line six (cat ["  br i1 ", unique, ", label %", reuse, ", label %", create]) in
        let filled = store-typed (line branched (cat [reuse, ":"])) pointer 0 words in
        let left = line filled (cat ["  br label %", join]) in
        (case allocate-typed (line left (cat [create, ":"])) descriptor words of
          (allocated, result) -> let both = line (line allocated (cat ["  br label %", join])) (cat [join, ":"]) in
            let (done, selected) = fresh both "%v" in
            (line done (cat ["  ", selected, " = phi i64 [ ", value, ", %", reuse, " ], [ ", result, ", %", create, " ]"]), selected))

  -- | Idea 2: Full Perceus reset/reuse across `let`, `if`, proof wrappers, and
  -- cross-constructor same-size cells (non-escaped uniform `i64` layouts).
  flat-pattern-fields :: CorePattern -> Nat -> Option (List (Option Nat, UType, Nat))
  flat-pattern-fields fields idx = case fields of
    CPDone sp -> Some []
    CPField sp (CPVar at fty id name) rest -> (case flat-pattern-fields rest (idx + 1) of
      Some more -> Some ((Some id, fty, idx) : more)
      None -> None)
    CPField sp (CPWild at fty) rest -> (case flat-pattern-fields rest (idx + 1) of
      Some more -> Some ((None, fty, idx) : more)
      None -> None)
    other -> None

  load-reset-fields :: Writer -> String -> List (Option Nat, UType, Nat) -> (Writer, List (Option Nat, UType, String))
  load-reset-fields w pointer fields = case fields of
    [] -> (w, [])
    (mid, fty, idx) : rest ->
      case load-word w pointer (nat-to-string idx) of
        (loaded, val) -> case load-reset-fields loaded pointer rest of
          (done, more) -> (done, (mid, fty, val) : more)

  reset-partition-fields :: CoreTerm -> List (Option Nat, UType, String) -> (List Local, List (UType, String))
  reset-partition-fields body fields = case fields of
    [] -> ([], [])
    (Some id, fty, val) : rest -> case reset-partition-fields body rest of
      (used, unused) ->
        if term-uses-id id body then ((Local id fty val) : used, unused)
        else (used, (fty, val) : unused)
    (None, fty, val) : rest -> case reset-partition-fields body rest of
      (used, unused) -> (used, (fty, val) : unused)

  drop-unused-reset-fields :: List (UType, String) -> Writer -> Writer
  drop-unused-reset-fields fields w = case fields of
    [] -> w
    (fty, val) : rest -> count-op False fty val (drop-unused-reset-fields rest w)

  dup-used-reset-fields :: List Local -> Writer -> Writer
  dup-used-reset-fields fields w = case fields of
    [] -> w
    (Local id fty val) : rest -> count-op True fty val (dup-used-reset-fields rest w)
    other : rest -> dup-used-reset-fields rest w

  free-reuse-token :: String -> Writer -> Writer
  free-reuse-token tok w = line w (cat ["  call void @cinch_free(i64 ", tok, ")"])

  matching-reuse-ctor :: Writer -> Nat -> CoreTerm -> Option (Writer, Nat, List CoreTerm)
  matching-reuse-ctor w arity term = case head term of
    CUse at cty name role actuals | (role == "constructor") ->
      let args = arguments term [] in
      if list-length args /= arity then None
      else (case constructor name (writer-program w) of
        Some (owner, tag, c) | list-length (core-constructor-fields c) == arity ->
          (case data-declaration owner (writer-program w) of
            Some d -> (case core-data-layout d of
              UniformData -> (case source-scheme-classes (w.context) (scheme-params (c.constructor-scheme)) actuals of
                Some classes -> (case constructor-context d classes w of
                  Some ctx ->
                    if not (all-i64-llvms (value-llvms (w.context) (term-types args))) then None
                    else (case request-data at d classes w of
                      (planned, descriptors) ->
                        let desc = data-descriptor descriptors tag in
                        if description-escaped desc then None else Some (planned, desc, args))
                  None -> None)
                None -> None)
              other -> None)
            None -> None)
        other -> None)
    other -> None

  expression-with-reuse :: List CoreDefinition -> List Local -> Writer -> Nat -> String -> CoreTerm -> (Writer, String)
  expression-with-reuse definitions locals w arity tok term = case term of
    CProved sp ty ev body -> expression-with-reuse definitions locals w arity tok body
    CRefine sp ty ev body -> expression-with-reuse definitions locals w arity tok body
    CRefineProof sp ty witness body -> expression-with-reuse definitions locals w arity tok body
    CForget sp ty body -> expression-with-reuse definitions locals w arity tok body
    CCast sp ty body -> expression-with-reuse definitions locals w arity tok body
    CRequire sp ty body -> expression-with-reuse definitions locals w arity tok body
    CDischarge sp ty ev _ body -> expression-with-reuse definitions locals w arity tok body
    CIf sp ty test yes no ->
      let result-ty = value-llvm (w.context) ty in
      case expression definitions locals w test of
        (tested, cond) ->
          let (w1, zero) = fresh tested "%v" in
          let (w2, yes-l) = fresh w1 "ryes" in
          let (w3, no-l) = fresh w2 "rno" in
          let (w4, end-l) = fresh w3 "rend" in
          let (w5, yes-out) = fresh w4 "ryesout" in
          let (w6, no-out) = fresh w5 "rnoout" in
          let branched = emit-lines w6 [
            cat ["  ", zero, " = icmp ne i64 ", cond, ", 0"],
            cat ["  br i1 ", zero, ", label %", yes-l, ", label %", no-l],
            cat [yes-l, ":"]] in
          case expression-with-reuse definitions locals branched arity tok yes of
            (left, yval) ->
              let after-yes = emit-lines left [cat ["  br label %", yes-out], cat [yes-out, ":"], cat ["  br label %", end-l], cat [no-l, ":"]] in
              case expression-with-reuse definitions locals after-yes arity tok no of
                (right, nval) ->
                  let joined = emit-lines right [cat ["  br label %", no-out], cat [no-out, ":"], cat ["  br label %", end-l], cat [end-l, ":"]] in
                  let (done, phi-v) = fresh joined "%v" in
                  (line done (cat ["  ", phi-v, " = phi ", result-ty, " [ ", yval, ", %", yes-out, " ], [ ", nval, ", %", no-out, " ]"]), phi-v)
    other -> case simple-word-let definitions w term of
      Some (sp, id, lty, rhs, body) ->
        if arm-has-reuse-alloc arity rhs then
          (case expression-with-reuse definitions locals w arity tok rhs of
            (bound, val) -> eval-let-body definitions locals bound id lty val body)
        else if arm-has-reuse-alloc arity body then
          (case expression definitions locals w rhs of
            (bound, val) ->
              if not (term-uses-id id body) then
                expression-with-reuse definitions locals (count-op False lty val bound) arity tok body
              else case expression-with-reuse definitions ((Local id lty val) : locals) bound arity tok body of
                (done, res) -> (count-op False lty val done, res))
        else expression definitions locals (free-reuse-token tok w) term
      None -> case matching-reuse-ctor w arity term of
        Some (planned, new-desc, args) ->
          case expressions definitions locals planned args of
            (ready, vals) ->
              let (w1, can-r) = fresh ready "%canreuse" in
              let (w2, hit-l) = fresh w1 "reusehit" in
              let (w3, miss-l) = fresh w2 "reusemiss" in
              let (w4, done-l) = fresh w3 "reusedone" in
              let (w5, rptr) = fresh w4 "%rptr" in
              let (w6, rhdr) = fresh w5 "%rhdr" in
              let new-hdr = static-header 1 (description-field new-desc) + 1 in
              let split = emit-lines w6 [
                cat ["  ", can-r, " = icmp ne i64 ", tok, ", 0"],
                cat ["  br i1 ", can-r, ", label %", hit-l, ", label %", miss-l],
                cat [hit-l, ":"],
                cat ["  ", rptr, " = inttoptr i64 ", tok, " to ptr"],
                cat ["  ", rhdr, " = getelementptr inbounds i8, ptr ", rptr, ", i64 -8"],
                cat ["  store i64 ", nat-to-string new-hdr, ", ptr ", rhdr, ", align 8"]] in
              let filled = line (store-typed split rptr 0 (typed-words vals)) (cat ["  br label %", done-l]) in
              let miss-start = line filled (cat [miss-l, ":"]) in
              case allocate-typed miss-start new-desc (typed-words vals) of
                (allocated, fresh-val) ->
                  let merged = emit-lines allocated [cat ["  br label %", done-l], cat [done-l, ":"]] in
                  let (done, out-v) = fresh merged "%v" in
                  (line done (cat ["  ", out-v, " = phi i64 [ ", tok, ", %", hit-l, " ], [ ", fresh-val, ", %", miss-l, " ]"]), out-v)
        None -> expression definitions locals (free-reuse-token tok w) term

  has-top-guard :: CoreTerm -> Bool
  has-top-guard term = case term of
    CGuard sp ty c b -> True
    other -> False

  value-live-in-body :: List Local -> String -> CoreTerm -> Bool
  value-live-in-body locals word body = case locals of
    [] -> False
    (Local id ty v) : rest -> (v == word && term-uses-id id body) || value-live-in-body rest word body
    (Borrowed id ty v) : rest -> (v == word && term-uses-id id body) || value-live-in-body rest word body
    other : rest -> value-live-in-body rest word body

  fvals-as-borrowed :: List (Option Nat, UType, String) -> List Local
  fvals-as-borrowed fields = case fields of
    [] -> []
    (Some id, fty, val) : rest -> (Borrowed id fty val) : fvals-as-borrowed rest
    (None, _, _) : rest -> fvals-as-borrowed rest

  can-sink-reset-reuse :: List Local -> String -> Nat -> CoreTerm -> Bool
  can-sink-reset-reuse locals value arity term = case term of
    CIf sp ty test yes no ->
      not (value-live-in-body locals value test)
        && ((not (value-live-in-body locals value yes) && arm-has-reuse-alloc arity yes)
            || (not (value-live-in-body locals value no) && arm-has-reuse-alloc arity no)
            || can-sink-reset-reuse locals value arity yes
            || can-sink-reset-reuse locals value arity no)
    other -> False

  is-bare-value-local :: List Local -> String -> CoreTerm -> Bool
  is-bare-value-local locals value term = case term of
    CLocal sp ty id name [] -> (case local id locals of
      Some (_, w) -> w == value
      None -> False)
    other -> False

  emit-reset-reuse :: List CoreDefinition -> List Local -> Writer -> UType -> String -> String -> List (Option Nat, UType, String) -> Nat -> CoreTerm -> (Writer, String)
  emit-reset-reuse definitions locals w ty value pointer fvals arity body =
    case reset-partition-fields body fvals of
      (used-locals, unused-fields) ->
        let (w1, uniq) = fresh w "%runiq" in
        let (w2, uniq-l) = fresh w1 "resetuniq" in
        let (w3, shared-l) = fresh w2 "resetshared" in
        let (w4, join-l) = fresh w3 "resetjoin" in
        let (w5, tok) = fresh w4 "%rtok" in
        let checked = emit-lines w5 [
          cat ["  ", uniq, " = call i1 @cinch.typed.rc.unique(ptr ", pointer, ")"],
          cat ["  br i1 ", uniq, ", label %", uniq-l, ", label %", shared-l],
          cat [uniq-l, ":"]] in
        let after-uniq = line (drop-unused-reset-fields unused-fields checked) (cat ["  br label %", join-l]) in
        let shared-start = line after-uniq (cat [shared-l, ":"]) in
        let after-shared = line (count-op False ty value (dup-used-reset-fields used-locals shared-start)) (cat ["  br label %", join-l]) in
        let joined = emit-lines after-shared [
          cat [join-l, ":"],
          cat ["  ", tok, " = phi i64 [ ", value, ", %", uniq-l, " ], [ 0, %", shared-l, " ]"]] in
        case expression-with-reuse definitions (used-locals <> locals) joined arity tok body of
          (done, result) -> (drop-locals used-locals done, result)

  sink-reset-reuse-branch :: List CoreDefinition -> List Local -> List Local -> Writer -> UType -> String -> String -> List (Option Nat, UType, String) -> Nat -> CoreTerm -> (Writer, String)
  sink-reset-reuse-branch definitions locals borrowed-fvals w ty value pointer fvals arity branch =
    if not (value-live-in-body locals value branch) && arm-has-reuse-alloc arity branch then
      emit-reset-reuse definitions locals w ty value pointer fvals arity branch
    else if can-sink-reset-reuse locals value arity branch then
      sink-reset-reuse-arm definitions locals borrowed-fvals w ty value pointer fvals arity branch
    else if is-bare-value-local locals value branch then
      (w, value)
    else case expression definitions (borrowed-fvals <> locals) w branch of
      (done, res) -> (count-op False ty value done, res)

  sink-reset-reuse-arm :: List CoreDefinition -> List Local -> List Local -> Writer -> UType -> String -> String -> List (Option Nat, UType, String) -> Nat -> CoreTerm -> (Writer, String)
  sink-reset-reuse-arm definitions locals borrowed-fvals w ty value pointer fvals arity term = case term of
    CIf sp rty test yes no ->
      let result-ty = value-llvm (w.context) rty in
      case expression definitions (borrowed-fvals <> locals) w test of
        (tested, cond) ->
          let (w1, zero) = fresh tested "%v" in
          let (w2, yes-l) = fresh w1 "sryes" in
          let (w3, no-l) = fresh w2 "srno" in
          let (w4, end-l) = fresh w3 "srend" in
          let (w5, yes-out) = fresh w4 "sryesout" in
          let (w6, no-out) = fresh w5 "srnoout" in
          let branched = emit-lines w6 [
            cat ["  ", zero, " = icmp ne i64 ", cond, ", 0"],
            cat ["  br i1 ", zero, ", label %", yes-l, ", label %", no-l],
            cat [yes-l, ":"]] in
          case sink-reset-reuse-branch definitions locals borrowed-fvals branched ty value pointer fvals arity yes of
            (left, yval) ->
              let after-yes = emit-lines left [cat ["  br label %", yes-out], cat [yes-out, ":"], cat ["  br label %", end-l], cat [no-l, ":"]] in
              case sink-reset-reuse-branch definitions locals borrowed-fvals after-yes ty value pointer fvals arity no of
                (right, nval) ->
                  let joined = emit-lines right [cat ["  br label %", no-out], cat [no-out, ":"], cat ["  br label %", end-l], cat [end-l, ":"]] in
                  let (done, phi-v) = fresh joined "%v" in
                  (line done (cat ["  ", phi-v, " = phi ", result-ty, " [ ", yval, ", %", yes-out, " ], [ ", nval, ", %", no-out, " ]"]), phi-v)
    other ->
      case expression definitions (borrowed-fvals <> locals) w term of
        (done, res) -> (count-op False ty value done, res)

  reset-reuse-arm :: List CoreDefinition -> List Local -> Writer -> UType -> String -> String -> CorePattern -> CoreTerm -> Option (Writer, String)
  reset-reuse-arm definitions locals w ty value pointer pattern body =
    if not ((writer-program w).reclaim) || has-top-guard body then None
    else case pattern of
      CPConstructor sp aty name actuals sc fields ->
        (case flat-pattern-fields fields 0 of
          None -> None
          Some flat ->
            let arity = list-length flat in
            let live-val = value-live-in-body locals value body in
            let eligible = if arity == 0 then False else if not live-val then arm-has-reuse-alloc arity body else can-sink-reset-reuse locals value arity body in
            if not eligible then None
            else (case constructor name (writer-program w) of
              Some (owner, tag, c) | list-length (core-constructor-fields c) == arity ->
                (case data-declaration owner (writer-program w) of
                  Some d -> (case core-data-layout d of
                    UniformData -> (case source-scheme-classes (w.context) (scheme-params (c.constructor-scheme)) actuals of
                      Some classes -> (case constructor-context d classes w of
                        Some ctx ->
                          if not (all-i64-llvms (value-llvms ctx (core-constructor-fields c))) then None
                          else (case request-data sp d classes w of
                            (planned, descriptors) ->
                              let old-desc = data-descriptor descriptors tag in
                              if description-escaped old-desc then None
                              else
                                case load-reset-fields planned pointer flat of
                                  (loaded, fvals) ->
                                    if not live-val then
                                      Some (emit-reset-reuse definitions locals loaded ty value pointer fvals arity body)
                                    else
                                      Some (sink-reset-reuse-arm definitions locals (fvals-as-borrowed fvals) loaded ty value pointer fvals arity body))
                        None -> None)
                      None -> None)
                    other -> None)
                  None -> None)
              other -> None))
      other -> None

  -- A constructor arm reached by the switch: its fields are read from the
  -- cell the tag selected. Every field pattern is irrefutable, so no field
  -- can reach the miss block.
  switch-tag-arm :: List CoreDefinition -> List Local -> Writer -> SwitchJoin -> CorePattern -> CoreTerm -> CoreTerm -> Nat -> String -> Bool -> (Writer, String)
  switch-tag-arm definitions locals w join pattern body rest index incoming defaulted = case join of
    SwitchJoin joined missed base ty value owned -> case pattern of
      CPConstructor sp aty name actuals sc fields ->
        let (one, out) = fresh w "armout" in
        let entry = line one (cat [base, ".", nat-to-string index, ":"]) in
        let (pointed, pointer) = fresh entry "%ptr" in
        let cell = line pointed (cat ["  ", pointer, " = inttoptr i64 ", value, " to ptr"]) in
        case (if owned then reset-reuse-arm definitions locals cell ty value pointer pattern body else None) of
          Some (done, result) -> switch-finish definitions locals done join out result rest index incoming defaulted
          None -> case match-fields fields pointer 0 missed cell of
            (bound, bindings) -> case (if owned then rebuild-case-cell definitions bindings bound ty value pointer pattern body else None) of
              Some (done, result) -> switch-finish definitions locals done join out result rest index incoming defaulted
              None -> (case guarded-expression definitions (bindings <> locals) bound missed body of
                (done, result) -> switch-leave definitions locals done join out result rest index incoming defaulted)
      other -> (line (refuse w (Span 0 0 1 1) "dispatched arm is not a constructor pattern") "  unreachable", incoming)
  switch-word-arm :: List CoreDefinition -> List Local -> Writer -> SwitchJoin -> CoreTerm -> CoreTerm -> Nat -> String -> Bool -> (Writer, String)
  switch-word-arm definitions locals w join body rest index incoming defaulted = case join of
    SwitchJoin joined missed base ty value owned ->
      let (one, out) = fresh w "armout" in
      let entry = line one (cat [base, ".", nat-to-string index, ":"]) in
      case guarded-expression definitions locals entry missed body of
        (done, result) -> switch-leave definitions locals done join out result rest index incoming defaulted
  -- Deliver one arm's word to the join. The arm's own block names the join's
  -- predecessor, so the join reaches it without a slot.
  switch-leave :: List CoreDefinition -> List Local -> Writer -> SwitchJoin -> String -> String -> CoreTerm -> Nat -> String -> Bool -> (Writer, String)
  switch-leave definitions locals w join out result rest index incoming defaulted = case join of
    SwitchJoin joined missed base ty value owned ->
      let cleaned = if owned then count-op False ty value w else w in
      switch-finish definitions locals cleaned join out result rest index incoming defaulted
  switch-finish :: List CoreDefinition -> List Local -> Writer -> SwitchJoin -> String -> String -> CoreTerm -> Nat -> String -> Bool -> (Writer, String)
  switch-finish definitions locals w join out result rest index incoming defaulted = case join of
    SwitchJoin joined missed base ty value owned ->
      let left = line (line w (cat ["  br label %", out])) (cat [out, ":"]) in
      switch-arms definitions locals (line left (cat ["  br label %", joined])) join rest (index + 1)
        (cat [incoming, if index == 0 then "" else ", ", "[ ", result, ", %", out, " ]"]) defaulted
  -- A word an arm contributes without emitting code and without a reference
  -- operation. Only then may a select choose between the arms: an operation
  -- emitted for both would run for the arm not taken.
  static-word :: List Local -> Writer -> CoreTerm -> Option String
  static-word locals w term = case term of
    CUnit sp ty -> if static-carrier (w.context) ty "0" then Some "0" else None
    CChar sp ty text -> if named ty "Char" then (case char-word text of
      Some word -> if static-carrier (w.context) ty word then Some word else None
      None -> None) else None
    CInt sp ty text -> if number ty then (case immediate-literal (named ty "Nat") text of
      Some word -> if static-carrier (w.context) ty word then Some word else None
      None -> None) else if raw-integer ty then (if static-carrier (w.context) ty text then Some text else None) else None
    CUse sp ty name role actuals -> if named ty "Bool" && name == "True" then (if static-carrier (w.context) ty "1" then Some "1" else None)
      else if named ty "Bool" && name == "False" then (if static-carrier (w.context) ty "0" then Some "0" else None)
      else if name == "Refl" then (if static-carrier (w.context) ty "0" then Some "0" else None) else None
    CLocal sp ty id name [] -> case local id locals of
      Some (declared, word) -> if static-carrier (w.context) declared word then Some word else None
      None -> None
    other -> None
  -- A word needs no reference operation when its carrier is an immediate (`i64` or `i128`), or
  -- when the word is a constant, which is never a block.
  static-carrier :: RuntimeContext -> UType -> String -> Bool
  static-carrier context ty word = case word-class context ty of
    Some 0 -> True
    Some 3 -> True
    Some code -> constant-word word
    None -> False
  -- | Whether a branch arm is a pure non-allocating scalar/wide/prim expression safe to evaluate speculatively for `select`.
  trivial-pure-arm :: ProgramInfo -> RuntimeContext -> CoreTerm -> Nat -> Bool
  trivial-pure-arm info context term fuel =
    if fuel < 1 then False else
    let immediate = case word-class context (core-type term) of Some 0 -> True; Some 3 -> True; other -> False in
    if not immediate then False else
    case term of
      CUnit sp ty -> True
      CChar sp ty text -> True
      CInt sp ty text -> True
      CUse sp ty name role actuals -> name == "True" || name == "False" || name == "Refl"
      CLocal sp ty id name [] -> True
      CApply sp ty f x -> trivial-pure-call info context term (fuel - 1)
      other -> False
  speculative-prim-plan :: ForeignPlan -> Bool
  speculative-prim-plan plan =
    primitive-object-callable plan
      && (case foreign-primitive-assumptions plan of
            Some (identity, []) ->
              (case foreign-inline plan of
                Some (InlinePrimitive owner family immediates (Some (PrimitiveFragment code lines imm uses)) assembly) ->
                  not (string-contains "udiv " code)
                    && not (string-contains "sdiv " code)
                    && not (string-contains "urem " code)
                    && not (string-contains "srem " code)
                other -> False)
            other -> False)
  trivial-pure-call :: ProgramInfo -> RuntimeContext -> CoreTerm -> Nat -> Bool
  trivial-pure-call info context term fuel = case collect-apply-args term [] of
    (CUse sp ty name role actuals, args) ->
      (case program-foreign-binding name info of
        Some plan -> speculative-prim-plan plan
          && list-length args == list-length (plan.parameters)
          && trivial-pure-arms info context args fuel
        None ->
          machine-integer-builtin name
            && list-length args == list-length (builtin-classes name)
            && trivial-pure-arms info context args fuel)
    other -> False
  collect-apply-args :: CoreTerm -> List CoreTerm -> (CoreTerm, List CoreTerm)
  collect-apply-args term acc = case term of
    CApply sp ty f x -> collect-apply-args f (x : acc)
    other -> (term, acc)
  trivial-pure-arms :: ProgramInfo -> RuntimeContext -> List CoreTerm -> Nat -> Bool
  trivial-pure-arms info context terms fuel = case terms of
    [] -> True
    first : rest -> trivial-pure-arm info context first fuel && trivial-pure-arms info context rest fuel
  branch :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> CoreTerm -> CoreTerm -> (Writer, String)
  branch definitions locals w sp test yes no =
    let (tested, condition) = expression definitions locals w test in
    case static-word locals tested yes of
      Some left -> case static-word locals tested no of
        Some right -> branch-select tested (value-llvm (tested.context) (core-type yes)) condition left right
        None -> if trivial-pure-arm (writer-program tested) (tested.context) no 4 then
          let (w1, right) = expression definitions locals tested no in
          branch-select w1 (value-llvm (w1.context) (core-type yes)) condition left right
          else branch-diamond definitions locals tested condition yes no
      None -> if trivial-pure-arm (writer-program tested) (tested.context) yes 4 && trivial-pure-arm (writer-program tested) (tested.context) no 4 then
        let (w1, left) = expression definitions locals tested yes in
        let (w2, right) = expression definitions locals w1 no in
        branch-select w2 (value-llvm (w2.context) (core-type yes)) condition left right
        else branch-diamond definitions locals tested condition yes no
  -- Both arms are already words, so one select chooses between them and the
  -- branch disappears.
  branch-select :: Writer -> String -> String -> String -> String -> (Writer, String)
  branch-select w ty condition left right =
    let (one, predicate) = fresh w "%v" in
    let (two, result) = fresh one "%v" in
    (line (line two (cat ["  ", predicate, " = icmp ne i64 ", condition, ", 0"])) (cat ["  ", result, " = select i1 ", predicate, ", ", ty, " ", left, ", ", ty, " ", right]), result)
  -- An arm that needs code of its own gets a block, and each arm leaves
  -- through a block of its own so the join is a phi.
  branch-diamond :: List CoreDefinition -> List Local -> Writer -> String -> CoreTerm -> CoreTerm -> (Writer, String)
  branch-diamond definitions locals w condition yes no =
    let (one, predicate) = fresh w "%v" in
    let (two, left) = fresh one "yes" in
    let (three, right) = fresh two "no" in
    let (four, left-out) = fresh three "yesout" in
    let (five, right-out) = fresh four "noout" in
    let (six, end) = fresh five "join" in
    let split = line (line six (cat ["  ", predicate, " = icmp ne i64 ", condition, ", 0"])) (cat ["  br i1 ", predicate, ", label %", left, ", label %", right]) in
    let (first, a) = expression definitions locals (line split (cat [left, ":"])) yes in
    let middle = line (line (line (line first (cat ["  br label %", left-out])) (cat [left-out, ":"])) (cat ["  br label %", end])) (cat [right, ":"]) in
    let (second, b) = expression definitions locals middle no in
    let joined = line (line (line (line second (cat ["  br label %", right-out])) (cat [right-out, ":"])) (cat ["  br label %", end])) (cat [end, ":"]) in
    let (ready, result) = fresh joined "%v" in
    (line ready (cat ["  ", result, " = phi ", value-llvm (ready.context) (core-type yes), " [ ", a, ", %", left-out, " ], [ ", b, ", %", right-out, " ]"]), result)
  -- A knot slot is an owned block, irrespective of its stored value's
  -- representation. Closures retain the slot and read it on invocation.
  knot-slot-type :: UType -> UType -> UType
  knot-slot-type region ty = UApp (UApp (UCon "Mut" (KFun KRegion (KFun KType KType))) region) ty

  knot-local :: Nat -> List Local -> Option (UType, String)
  knot-local id locals = case locals of
    [] -> None
    (KnotLocal key region ty slot) : rest -> if id == key then Some (ty, slot) else knot-local id rest
    other : rest -> knot-local id rest

  knot-pointer :: Writer -> String -> (Writer, String)
  knot-pointer w slot =
    let (ready, pointer) = fresh w "%ptr" in
    (line ready (cat ["  ", pointer, " = inttoptr i64 ", slot, " to ptr"]), pointer)

  read-index-local :: List Local -> Writer -> Span -> Nat -> UType -> (Writer, String)
  read-index-local locals w sp id carrier = case knot-local id locals of
    Some (declared, slot) -> if runtime-type-equal carrier declared then knot-read w declared slot
      else unsupported w sp "recursive local disagrees with its checked carrier"
    None -> case local id locals of
      Some (declared, value) -> if runtime-type-equal carrier declared then (count-op True declared value w, value)
        else unsupported w sp "runtime index local disagrees with its checked carrier"
      None -> unsupported w sp "runtime index local is absent from its lexical scope"

  knot-read :: Writer -> UType -> String -> (Writer, String)
  knot-read w ty slot = case knot-pointer w slot of
    (pointed, pointer) -> case load-word pointed pointer "0" of
      (loaded, state) ->
        let (one, fault) = fresh loaded "knotfault" in
        let (two, ready) = fresh one "knotready" in
        let (three, predicate) = fresh two "%v" in
        let checked = line three (cat ["  ", predicate, " = icmp eq i64 ", state, ", 1"]) in
        let branched = line checked (cat ["  br i1 ", predicate, ", label %", ready, ", label %", fault]) in
        let refused = line (line (line branched (cat [fault, ":"])) "  call void @cinch_blackhole()") "  unreachable" in
        (case load-word (line refused (cat [ready, ":"])) pointer "1" of
          (done, value) -> (count-op True ty value done, value))

  allocate-knots :: UType -> List Nat -> CoreTerm -> Writer -> (Writer, List Local)
  allocate-knots region slots members w = case members of
    CRecursiveBindingsEnd -> (w, [])
    CRecursiveBinding id name value rest -> if not (id-present id slots) then allocate-knots region slots rest w else
      (case call w "@cinch_alloc" ["16", "5"] of
        (allocated, slot) -> case knot-pointer allocated slot of
          (pointed, pointer) -> case allocate-knots region slots rest (store-fields pointed pointer 0 ["0", "0"]) of
            (done, more) -> (done, (KnotLocal id region (core-type value) slot) : more))
    other -> (refuse w (Span 0 0 1 1) "malformed recursive value bindings", [])

  evaluate-knot-members :: List CoreDefinition -> List Local -> CoreTerm -> CoreTerm -> Writer -> (Writer, String)
  evaluate-knot-members definitions locals members body w = case members of
    CRecursiveBindingsEnd -> expression definitions locals w body
    CRecursiveBinding id name value rest -> case expression definitions locals w value of
      (evaluated, word) -> case knot-local id locals of
        Some (ty, slot) -> case knot-pointer evaluated slot of
          (pointed, pointer) ->
            let filled = store-fields pointed pointer 1 [word] in
            evaluate-knot-members definitions locals rest body (store-fields filled pointer 0 ["1"])
        None ->
          let ty = core-type value in
          if name == "" then evaluate-knot-members definitions locals rest body (count-op False ty word evaluated)
          else (case evaluate-knot-members definitions ((Local id ty word) : locals) rest body evaluated of
            (done, result) -> (count-op False ty word done, result))
    other -> unsupported w (Span 0 0 1 1) "malformed recursive value bindings"

  -- Invalidate the slot before dropping its stored value. That value
  -- can own closures which themselves hold references to this slot.
  clear-knots :: List Local -> Writer -> Writer
  clear-knots knots w = case knots of
    [] -> w
    (KnotLocal id region ty slot) : rest -> case knot-pointer w slot of
      (pointed, pointer) -> case load-word pointed pointer "1" of
        (loaded, value) ->
          let cleared = store-fields loaded pointer 0 ["0", "0"] in
          let released = count-op False ty value cleared in
          clear-knots rest (count-op False (knot-slot-type region ty) slot released)
    other -> refuse w (Span 0 0 1 1) "malformed recursive slot cleanup"

  knot-expression :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> CoreTerm -> (Writer, String)
  knot-expression definitions locals w sp region members body = if wide-knot (w.context) members then unsupported w sp wide-refusal else case allocate-knots region (recursive-box-slots members) members w of
    (allocated, knots) -> case evaluate-knot-members definitions (knots <> locals) members body allocated of
      (done, result) -> (clear-knots (reverse knots) done, result)

  -- A knot slot holds one word.
  wide-knot :: RuntimeContext -> CoreTerm -> Bool
  wide-knot context members = case members of
    CRecursiveBinding id name value rest -> wide-type context (core-type value) || wide-knot context rest
    other -> False
  -- Hold the root throughout the walk. Each next pointer is a borrow
  -- from that root; only the root is released when the walk finishes.
  length-word :: Writer -> Span -> UType -> String -> (Writer, String)
  length-word w sp carrier root = if named carrier "Bytes" then (case call w "@cinch_bytes_len" [root] of
    (measured, length) -> call (count-op False carrier root measured) "@cinch_nat_from_i64" [length])
    else case core-list-element carrier of
      Some element | array-list-abi w ->
        let (a, entry) = fresh w "length-entry" in let (b, loop) = fresh a "length-loop" in
        let (c, step) = fresh b "length-step" in let (d, end) = fresh c "length-end" in
        let (e, cell) = fresh d "%v" in let (f, next) = fresh e "%v" in
        let (g, count) = fresh f "%v" in let (h, more) = fresh g "%v" in
        let start = emit-lines h [cat ["  br label %", entry], cat [entry, ":"], cat ["  br label %", loop], cat [loop, ":"],
          cat ["  ", cell, " = phi i64 [ ", root, ", %", entry, " ], [ ", next, ", %", step, " ]"],
          cat ["  ", count, " = phi i64 [ 0, %", entry, " ], [ ", more, ", %", step, " ]"]] in
        (case constructor-tag start cell of
          (tagged, tag) -> let (i, empty) = fresh tagged "%v" in let (j, ptr) = fresh i "%ptr" in let (k, slot) = fresh j "%ptr" in
            let walked = emit-lines k [cat ["  ", empty, " = icmp eq i64 ", tag, ", 0"], cat ["  br i1 ", empty, ", label %", end, ", label %", step],
              cat [step, ":"], cat ["  ", ptr, " = inttoptr i64 ", cell, " to ptr"],
              cat ["  ", slot, " = getelementptr i64, ptr ", ptr, ", i64 ", if wide-type (w.context) element then "2" else "1"],
              cat ["  ", next, " = load i64, ptr ", slot], cat ["  ", more, " = add i64 ", count, ", 1"],
              cat ["  br label %", loop], cat [end, ":"]] in
            call (count-op False carrier root walked) "@cinch_nat_from_i64" [count])
      other -> unsupported w sp "length needs its checked list layout"
  -- Hold the input across the scan. Char code points and UTF-8 bytes are
  -- ASCII exactly when each unsigned word is below 128.
  ascii-word :: Writer -> Span -> UType -> String -> (Writer, String)
  ascii-word w sp carrier root = case carrier of
    UCon name KType | checked-string-word name (writer-program w) -> (case string-bytes w root of
      (ready, bytes) -> case call ready "@cinch_bytes_len" [bytes] of
        (measured, count) -> ascii-loop measured carrier root (Some (bytes, count)))
    other -> if ascii-carrier carrier && array-list-abi w && (case core-list-element carrier of Some element -> True; None -> False)
      then ascii-loop w carrier root None else unsupported w sp "Ascii needs its checked string or char-list layout"
  ascii-loop :: Writer -> UType -> String -> Option (String, String) -> (Writer, String)
  ascii-loop w carrier root buffer =
    let (a, entry) = fresh w "ascii-entry" in let (b, loop) = fresh a "ascii-loop" in
    let (c, read) = fresh b "ascii-read" in let (d, step) = fresh c "ascii-step" in
    let (e, yes) = fresh d "ascii-yes" in let (f, no) = fresh e "ascii-no" in
    let (g, end) = fresh f "ascii-end" in let (h, cursor) = fresh g "%v" in
    let (i, next) = fresh h "%v" in let (j, done) = fresh i "%v" in
    let (k, valid) = fresh j "%v" in let (m, result) = fresh k "%v" in
    let initial = case buffer of Some pair -> "0"; None -> root in
    let start = emit-lines m [cat ["  br label %", entry], cat [entry, ":"], cat ["  br label %", loop], cat [loop, ":"],
      cat ["  ", cursor, " = phi i64 [ ", initial, ", %", entry, " ], [ ", next, ", %", step, " ]"]] in
    let (checked, test, limit) = case buffer of Some (bytes, size) -> (start, cursor, size); None -> case constructor-tag start cursor of (tagged, tag) -> (tagged, tag, "0") in
    let body = emit-lines checked [cat ["  ", done, " = icmp eq i64 ", test, ", ", limit],
      cat ["  br i1 ", done, ", label %", yes, ", label %", read], cat [read, ":"]] in
    let (loaded, unit, advance) = case buffer of
          Some (bytes, size) -> (case call body "@cinch_bytes_get" [bytes, cursor] of
            (got, value) -> (got, value, [cat ["  ", next, " = add i64 ", cursor, ", 1"]]))
          None -> let (p, ptr) = fresh body "%ptr" in let (q, head) = fresh p "%v" in let (r, tail) = fresh q "%ptr" in
            (emit-lines r [cat ["  ", ptr, " = inttoptr i64 ", cursor, " to ptr"], cat ["  ", head, " = load i64, ptr ", ptr]], head,
             [cat ["  ", tail, " = getelementptr i64, ptr ", ptr, ", i64 1"], cat ["  ", next, " = load i64, ptr ", tail]]) in
    let scanned = emit-lines loaded ([cat ["  ", valid, " = icmp ult i64 ", unit, ", 128"],
      cat ["  br i1 ", valid, ", label %", step, ", label %", no], cat [step, ":"]] <> advance <>
      [cat ["  br label %", loop], cat [yes, ":"], cat ["  br label %", end], cat [no, ":"], cat ["  br label %", end],
       cat [end, ":"], cat ["  ", result, " = phi i64 [ 1, %", yes, " ], [ 0, %", no, " ]"]]) in
    (count-op False carrier root scanned, result)

  -- Compare adjacent borrowed heads while the root keeps the whole spine
  -- alive. Mathematical integers use their arbitrary-precision comparison.
  ordered-word :: Writer -> Span -> UType -> String -> (Writer, String)
  ordered-word w sp carrier root = case core-list-element carrier of
    Some element | ordered-carrier carrier && array-list-abi w ->
      let (a, entry) = fresh w "ordered-entry" in let (b, loop) = fresh a "ordered-loop" in
      let (c, read) = fresh b "ordered-read" in let (d, step) = fresh c "ordered-step" in
      let (e, yes) = fresh d "ordered-yes" in let (f, no) = fresh e "ordered-no" in
      let (g, end) = fresh f "ordered-end" in let (h, cell) = fresh g "%v" in
      let (i, next) = fresh h "%v" in let (j, empty) = fresh i "%v" in let (k, last) = fresh j "%v" in
      let (m, ptr) = fresh k "%ptr" in let (n, slot) = fresh m "%ptr" in
      let (tagged, tag) = constructor-tag n root in
      let start = emit-lines tagged [cat ["  ", empty, " = icmp eq i64 ", tag, ", 0"], cat ["  br i1 ", empty, ", label %", yes, ", label %", entry],
        cat [entry, ":"], cat ["  br label %", loop], cat [loop, ":"], cat ["  ", cell, " = phi i64 [ ", root, ", %", entry, " ], [ ", next, ", %", step, " ]"],
        cat ["  ", ptr, " = inttoptr i64 ", cell, " to ptr"], cat ["  ", slot, " = getelementptr i64, ptr ", ptr, ", i64 1"], cat ["  ", next, " = load i64, ptr ", slot]] in
      let (found, next-tag) = constructor-tag start next in
      let (o, next-ptr) = fresh found "%ptr" in let (p, left) = fresh o "%v" in let (q, right) = fresh p "%v" in
      let pair = emit-lines q [cat ["  ", last, " = icmp eq i64 ", next-tag, ", 0"], cat ["  br i1 ", last, ", label %", yes, ", label %", read],
        cat [read, ":"], cat ["  ", next-ptr, " = inttoptr i64 ", next, " to ptr"], cat ["  ", left, " = load i64, ptr ", ptr], cat ["  ", right, " = load i64, ptr ", next-ptr]] in
      let (compared, order) = call pair "@cinch_nat_cmp" [left, right] in
      let (r, ok) = fresh compared "%v" in let (t, result) = fresh r "%v" in
      let finished = emit-lines t [cat ["  ", ok, " = icmp sle i64 ", order, ", 0"], cat ["  br i1 ", ok, ", label %", step, ", label %", no],
        cat [step, ":"], cat ["  br label %", loop], cat [yes, ":"], cat ["  br label %", end], cat [no, ":"], cat ["  br label %", end], cat [end, ":"],
        cat ["  ", result, " = phi i64 [ 1, %", yes, " ], [ 0, %", no, " ]"]] in (count-op False carrier root finished, result)
    other -> unsupported w sp "Ordered needs its checked numeric-list layout"

  float-pred-word :: Writer -> Span -> UType -> Bool -> String -> (Writer, String)
  float-pred-word w sp ty require-finite value =
    let is-f32 = named (base ty) "F32" in
    let abs-mask = if is-f32 then "2147483647" else "9223372036854775807" in
    let exp-mask = if is-f32 then "2139095040" else "9218868437227405312" in
    let cmp-op = if require-finite then "ult" else "ule" in
    let (w1, mag) = fresh w "%v" in
    let (w2, ok) = fresh w1 "%v" in
    let (w3, res) = fresh w2 "%v" in
    let emitted = emit-lines w3 [
      cat ["  ", mag, " = and i64 ", value, ", ", abs-mask],
      cat ["  ", ok, " = icmp ", cmp-op, " i64 ", mag, ", ", exp-mask],
      cat ["  ", res, " = zext i1 ", ok, " to i64"]] in
    (emitted, res)

  primitive :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> String -> CoreTerm -> (Writer, String)

  primitive definitions locals w sp ty op args =
    if string-starts-with "val-" op then value-primitive definitions locals w sp ty op args
    else case args of
    CArgumentsEnd at | (op == "#unhandled-operation") -> let (ready, dead) = fresh w "afterfault" in
      (line (line (line ready "  call void @cinch_blackhole()") "  unreachable") (dead <> ":"), "poison")
    CArgument at input (CArgumentsEnd end) | (op == "#kernel.ordered") -> (case expression definitions locals w input of
      (ready, value) -> ordered-word ready sp (core-type input) value)
    CArgument at input (CArgumentsEnd end) | (op == "#kernel.ascii") -> (case expression definitions locals w input of
      (ready, value) -> ascii-word ready sp (core-type input) value)
    CArgument at input (CArgumentsEnd end) | (op == "#kernel.not-nan") -> (case expression definitions locals w input of
      (ready, value) -> float-pred-word ready sp (core-type input) False value)
    CArgument at input (CArgumentsEnd end) | (op == "#kernel.finite") -> (case expression definitions locals w input of
      (ready, value) -> float-pred-word ready sp (core-type input) True value)
    CArgument at input (CArgumentsEnd end) | (op == "#kernel.length") -> (case expression definitions locals w input of
      (ready, value) -> length-word ready sp (core-type input) value)
    CArgument at input (CArgumentsEnd end) -> if op == "copy-out" then copy-out-word definitions locals w ty input
      else if op == "memo-demand" then memo-demand definitions locals w sp ty input
      else if op == "borrow" || op == "thunk-delay" then expression definitions locals w input
      else if op == "thunk-force" then (case expression definitions locals w input of
        (ready, closure-word) -> apply-one ready closure-word "0")
      else if wide-type (w.context) (core-type input) && (op == "mut-borrow" || op == "thunk-force") then unsupported w sp wide-refusal
      else if wide-type (w.context) ty && (op == "thunk-force" || op == "memo-demand") then unsupported w sp wide-refusal
      else if is-value-type (w.context) (core-type input) && (op == "mut-borrow" || op == "thunk-force") then unsupported w sp val-refusal
      else if is-value-type (w.context) ty && (op == "thunk-force" || op == "memo-demand") then unsupported w sp val-refusal
      else if op == "mut-borrow" then (case expression definitions locals w input of
        (ready, value) -> let (planned, descriptor) = request-layout sp [input] ready in allocate planned descriptor [value])
      else if op == "negate" && named (core-type input) "Int" then
      (case expression definitions locals w input of
        (ready, value) -> case call ready "@cinch_int_neg" [value] of (done, result) -> (count-op False (core-type input) value done, result))
      else if op == "par-workers" then par-workers definitions locals w sp input
      else unsupported w sp "unary primitive needs runtime lowering"
    CArgument at first (CArgument bt second (CArgumentsEnd end)) ->
      if op == "par-both" then (case pair-classes (w.context) ty of
        Some classes | wide-code classes -> unsupported w sp wide-parallel-refusal
        Some classes | val-code classes -> unsupported w sp val-refusal
        other -> par-both definitions locals w sp ty first second)
      else if op == "par-tabulate" then
        (if wide-array-element (w.context) ty then unsupported w sp wide-parallel-refusal
         else if val-array-element (w.context) ty then unsupported w sp val-refusal
         else par-tabulate definitions locals w sp ty first second)
      else if op == "par-map" then
        (if wide-array-element (w.context) (core-type second) || wide-array-element (w.context) ty then unsupported w sp wide-parallel-refusal
         else if val-array-element (w.context) (core-type second) || val-array-element (w.context) ty then unsupported w sp val-refusal
         else par-map definitions locals w sp ty first second)
      else if op == "#handler-field" && wide-type (w.context) ty then unsupported w sp wide-refusal
      else if op == "#handler-field" then
        (case second of
          CInt offset offset-type slot -> case expression definitions locals w first of
            (ready, frame) -> let (one, pointer) = fresh ready "%ptr" in
              (case load-word (line one (cat ["  ", pointer, " = inttoptr i64 ", frame, " to ptr"])) pointer slot of
                (loaded, field) -> (count-op False (core-type first) frame (count-op True ty field loaded), field))
          other -> unsupported w sp "handler field has no checked slot")
      else if op == "memo-init" then memo-init definitions locals w sp first second
      else if op == "ref-set" then write-borrow-word definitions locals w sp first second
      else if number (core-type first) then binary definitions locals w sp op first second
      else if (op == "<" || op == "<=" || op == ">" || op == ">=") && (raw-integer (core-type first) || wide-scalar (core-type first)) then
        (case expressions definitions locals w [first, second] of
          (ready, [a, b]) -> compare-typed ready (if wide-scalar (core-type first) then "i128" else "i64") (machine-ordering (core-type first) op) a b
          other -> unsupported w sp "malformed machine ordering arguments")
      else if (op == "==" || op == "/=") && scalar (core-type first) then
        (case expressions definitions locals w [first, second] of
          (ready, [a, b]) -> compare-word ready (if op == "==" then "eq" else "ne") a b
          other -> unsupported w sp "malformed scalar equality arguments")
      -- Kernel equality on a wide scalar is one `i128` comparison.
      else if (op == "==" || op == "/=") && wide-scalar (core-type first) then
        (case expressions definitions locals w [first, second] of
          (ready, [a, b]) -> compare-typed ready "i128" (if op == "==" then "eq" else "ne") a b
          other -> unsupported w sp "malformed wide equality arguments")
      else unsupported w sp "primitive carrier needs runtime lowering"
    CArgumentsEnd end -> if op == "decision-true" then (w, "1") else if op == "decision-false" then (w, "0") else unsupported w sp "nullary primitive needs runtime lowering"
    other -> unsupported w sp "primitive arity needs runtime lowering"
  -- Deterministic pure parallelism (design/parallel-evaluation.md sections
  -- 2 and 4.3): the units wrap the runtime's work-stealing entries of
  -- `seed/runtime/src/par.rs`, or their sequential readings on the
  -- cooperative backend (`cinch_coop_par_*`). The callback closures are
  -- borrowed (the caller drops them after the call) and the runtime
  -- duplicates one reference per invocation, marking at publication.
  -- Every class here is an immediate baked into the body, so the emission
  -- depends only on the checked program, never on a schedule.
  par-prefix :: ProgramInfo -> String
  par-prefix info = if program-wasm32 info then "@cinch_coop_" else "@cinch_"
  program-wasm32 :: ProgramInfo -> Bool
  program-wasm32 info = info.caps.caps-arch == "wasm32"
  program-arch :: ProgramInfo -> String
  program-arch info = info.caps.caps-arch
  program-arm-aes :: ProgramInfo -> Bool
  program-arm-aes info = info.caps.caps-arm-aes
  par-entry :: Writer -> String -> String
  par-entry w base = cat [par-prefix (writer-program w), base]
  -- The two result words are owned by the caller, and the pair takes the
  -- two component classes' exact pointer map, so no mask and no shaped-join
  -- limit apply (section 4.3).
  par-both :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> CoreTerm -> (Writer, String)
  par-both definitions locals w sp ty f g = case expressions definitions locals w [f, g] of
    (ready, f-word : ([g-word])) -> case pair-classes (w.context) ty of
      None -> unsupported ready sp "parBoth result needs its checked pair representation"
      Some classes ->
        let (one, out) = fresh ready "%out" in
        let (two, out-word) = fresh one "%v" in
        let pointed = line two (cat ["  ", out, " = alloca [2 x i64]"])
        in let addressed = line pointed (cat ["  ", out-word, " = ptrtoint ptr ", out, " to i64"])
        in case call addressed (par-entry w "par_both") [f-word, g-word, out-word] of
          (called, _) ->
            -- The callbacks are borrowed: the caller keeps them alive across
            -- the call and drops them afterwards (section 3.3).
            let released = count-op False (core-type f) f-word (count-op False (core-type g) g-word called) in
            case load-word released out "0" of
              (first-loaded, first) -> case load-word first-loaded out "1" of
                (second-loaded, second) -> case request-tuple-shape sp classes second-loaded of
                  (planned, descriptor) -> allocate planned descriptor [first, second]
    (ready, other) -> unsupported ready sp "parBoth takes exactly two callbacks"
  pair-classes :: RuntimeContext -> UType -> Option (List Nat)
  pair-classes context ty = case ty of
    UTuple fields -> (case spine-types fields of
      first : ([second]) -> class-vector context [first, second]
      other -> None)
    USigma id name domain body -> class-vector context [domain, body]
    other -> None
  spine-types :: UType -> List UType
  spine-types fields = case fields of UEnd -> []; UArg first rest -> first : (spine-types rest); other -> []
  -- `n` crosses as a length (`cinch_nat_to_len`), and the element class as
  -- the scan code the array constructors take.
  par-tabulate :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> CoreTerm -> (Writer, String)
  par-tabulate definitions locals w sp ty count callback = case expression definitions locals w count of
    (counted, count-word) -> case expression definitions locals counted callback of
      (ready, closure) -> case array-element-class (w.context) ty of
        None -> unsupported ready sp "parTabulate result needs its checked element representation"
        Some class ->
          case call ready "@cinch_nat_to_len" [count-word] of
            (converted, length) -> case call converted (par-entry w "par_tabulate") [length, closure, nat-to-string class] of
              -- The callback is borrowed and dropped after the call.
              (called, built) -> (count-op False (core-type count) count-word (count-op False (core-type callback) closure called), built)
  -- `parMap`'s array primitive: the elaboration has already put
  -- `array-from-list` in front and `array-to-list` behind it, so the
  -- runtime never builds list cells.
  par-map :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> CoreTerm -> (Writer, String)
  par-map definitions locals w sp ty callback array = case expressions definitions locals w [callback, array] of
    (ready, closure : ([input])) -> case array-element-class (w.context) ty of
      None -> unsupported ready sp "parMap result needs its checked element representation"
      Some class -> case call ready (par-entry w "par_map_array") [closure, input, nat-to-string class] of
        -- Both the callback and the input array are borrowed; the caller
        -- drops them after the call, and owns the result.
        (called, mapped) -> (count-op False (core-type callback) closure (count-op False (core-type array) input called), mapped)
    (ready, other) -> unsupported ready sp "parMap takes a callback and one array"
  -- The participant budget: `cinch_par_set_workers(n)` and nothing else. The
  -- method answers `Unit`, so the call's result is discarded and the value is
  -- the one every `Unit` primitive produces. `n` crosses as a length.
  par-workers :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> (Writer, String)
  par-workers definitions locals w sp count = case expression definitions locals w count of
    (counted, count-word) -> case call counted "@cinch_nat_to_len" [count-word] of
      (converted, workers) -> case call converted (par-entry w "par_set_workers") [workers] of
        (called, ignored) -> (count-op False (core-type count) count-word called, "0")
  -- The element class of an `Array a` result, as the scan code the array
  -- constructors take.
  wide-parallel-refusal :: String
  wide-parallel-refusal = "a parallel task's payload holds I128 or U128, which code generation does not lower yet"
  wide-array-element :: RuntimeContext -> UType -> Bool
  wide-array-element context ty = case ty of
    UApp (UCon name kind) element -> name == "Array" && kind-equal kind (KFun KType KType) && wide-type context element
    other -> False
  val-array-element :: RuntimeContext -> UType -> Bool
  val-array-element context ty = case ty of
    UApp (UCon name kind) element -> name == "Array" && kind-equal kind (KFun KType KType) && is-value-type context element
    other -> False

  array-element-class :: RuntimeContext -> UType -> Option Nat
  array-element-class context ty = case ty of
    UApp (UCon name kind) element -> if name == "Array" && kind-equal kind (KFun KType KType) && not (wide-type context element) && not (is-value-type context element) then word-class context element else None
    other -> None
  -- The leading lets hold the group's cells until the continuation exits.
  -- Clear their scanned slot in reverse allocation order, breaking cycles
  -- between unforced closures before dropping the owning cell references.
  memo-scope :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> (Writer, String)
  memo-scope definitions locals w term = case term of
    CLet sp ty id name sc (CPrimitive at cell op (CArgumentsEnd end)) body ->
      if op == "memo-alloc" then
        (case call w "@cinch_alloc" ["24", "4"] of
          (allocated, word) -> case memo-scope definitions ((Local id cell word) : locals) allocated body of
            (done, result) -> let (one, pointer) = fresh done "%ptr" in
              let pointed = line one (cat ["  ", pointer, " = inttoptr i64 ", word, " to ptr"]) in
              (case load-word pointed pointer "1" of
                (loaded, owned) -> let cleared = store-fields loaded pointer 1 ["0"] in
                  let released = count-line False owned cleared in
                  (count-op False cell word released, result)))
      else expression definitions locals w term
    other -> expression definitions locals w term
  memo-init :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> CoreTerm -> (Writer, String)
  memo-init definitions locals w sp cell callback = case expressions definitions locals w [cell, callback] of
    (ready, [word, closure]) -> let (one, pointer) = fresh ready "%ptr" in
      let pointed = line one (cat ["  ", pointer, " = inttoptr i64 ", word, " to ptr"]) in
      (count-op False (core-type cell) word (store-fields pointed pointer 1 [closure]), "0")
    other -> unsupported w sp "memo initialization needs a cell and a closure"
  memo-demand :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> (Writer, String)
  memo-demand definitions locals w sp result cell = case word-class (w.context) result of
    None -> unsupported w sp "memo demand needs a checked result representation"
    Some 3 -> unsupported w sp wide-refusal
    Some code | is-val-class code -> unsupported w sp val-refusal
    Some code -> case expression definitions locals (request-demand MemoWorker w) cell of
      (ready, word) -> case call ready "@cinch.typed.memo.demand" [word, if code == 0 then "0" else "1"] of
        (loaded, value) -> (count-op False (core-type cell) word (count-op True result value loaded), value)
  memo-worker :: Writer -> Writer
  memo-worker w = global w (cat [
    "define internal i64 @cinch.typed.memo.demand(i64 %cell, i64 %counted)", worker-open w, "\nentry:\n",
    "  %p = inttoptr i64 %cell to ptr\n  %owned = getelementptr i64, ptr %p, i64 1\n  %cache = getelementptr i64, ptr %p, i64 2\n",
    "  %state = load i64, ptr %p\n  switch i64 %state, label %bad [ i64 0, label %eval i64 2, label %done ]\n",
    "eval:\n  %thunk = load i64, ptr %owned\n  %empty = icmp eq i64 %thunk, 0\n  br i1 %empty, label %bad, label %force\n",
    "force:\n  store i64 1, ptr %p\n  store i64 0, ptr %owned\n  %argv = alloca i64\n  store i64 0, ptr %argv\n",
    "  %value = call i64 @__apply(i64 %thunk, i64 1, ptr %argv)\n",
    "  %tag = and i64 %value, 1\n  %even = icmp eq i64 %tag, 0\n  %heap = icmp ne i64 %counted, 0\n",
    "  %keep = and i1 %heap, %even\n  %child = select i1 %keep, i64 %value, i64 0\n  store i64 %child, ptr %owned\n",
    "  store i64 %value, ptr %cache\n  store i64 2, ptr %p\n  ret i64 %value\n",
    "done:\n  %cached = load i64, ptr %cache\n  ret i64 %cached\n",
    "bad:\n  call void @cinch_blackhole()\n  unreachable\n}\n"])
  value-mod-nat :: Nat -> Nat -> Nat
  value-mod-nat n a = if a <= 1 then 0 else if a <= n then value-mod-nat (n - a) a else n

  value-align-up :: Nat -> Nat -> Nat
  value-align-up n a = if a <= 1 then n else let r = value-mod-nat n a in if r == 0 then n else if r <= a then n + (a - r) else n

  emit-gep-offset :: Writer -> String -> Nat -> (Writer, String)
  emit-gep-offset w base-ptr off =
    if off == 0 then (w, base-ptr)
    else let (w1, slot) = fresh w "%gep" in
      (line w1 (cat ["  ", slot, " = getelementptr inbounds i8, ptr ", base-ptr, ", i64 ", nat-to-string off]), slot)

  emit-store-at :: Writer -> String -> Nat -> UType -> String -> Writer
  emit-store-at w base-ptr off raw-ty val =
    let ty = base (reduce-types (w.context.info.type-families) (w.context.info.promoted-fns) raw-ty) in
    let ptr-bytes = program-ptr-bytes (writer-program w) in
    case emit-gep-offset w base-ptr off of
      (w1, slot) ->
        if named ty "Unit" then w1
        else if foreign-pointer ty then
          line w1 (cat ["  store ptr ", val, ", ptr ", slot, ", align 1"])
        else case type-value-size-align (w1.context) ty of
          Some (sz, al) ->
            if sz == 0 then w1
            else if sz <= 8 && al <= 16 then
              if sz == 8 then line w1 (cat ["  store i64 ", val, ", ptr ", slot, ", align 1"])
              else let it = "i" <> nat-to-string (sz * 8) in
                let (w2, tr) = fresh w1 "%tr" in
                line (line w2 (cat ["  ", tr, " = trunc i64 ", val, " to ", it])) (cat ["  store ", it, " ", tr, ", ptr ", slot, ", align 1"])
            else if sz <= 16 && al <= 16 then
              let (w2, lo) = fresh w1 "%lo" in
              let (w3, hi) = fresh w2 "%hi" in
              let w4 = emit-lines w3 [
                cat ["  ", lo, " = extractvalue { i64, i64 } ", val, ", 0"],
                cat ["  store i64 ", lo, ", ptr ", slot, ", align 1"],
                cat ["  ", hi, " = extractvalue { i64, i64 } ", val, ", 1"]] in
              case emit-gep-offset w4 slot 8 of
                (w5, hi-slot) ->
                  let rem = if 8 <= sz then sz - 8 else 0 in
                  if rem == 8 then line w5 (cat ["  store i64 ", hi, ", ptr ", hi-slot, ", align 1"])
                  else let it = "i" <> nat-to-string (rem * 8) in
                    let (w6, tr) = fresh w5 "%tr" in
                    line (line w6 (cat ["  ", tr, " = trunc i64 ", hi, " to ", it])) (cat ["  store ", it, " ", tr, ", ptr ", hi-slot, ", align 1"])
            else
              let w2 = request-demand MemcpyDemand w1 in
              line w2 (cat ["  call void @llvm.memcpy.p0.p0.i64(ptr align 1 ", slot, ", ptr align 1 ", val, ", i64 ", nat-to-string sz, ", i1 false)"])
          None ->
            if wide-scalar ty then line w1 (cat ["  store i128 ", val, ", ptr ", slot, ", align 1"])
            else if named ty "Bool" || named ty "I8" || named ty "U8" then
              let (w2, tr) = fresh w1 "%tr" in
              line (line w2 (cat ["  ", tr, " = trunc i64 ", val, " to i8"])) (cat ["  store i8 ", tr, ", ptr ", slot, ", align 1"])
            else if named ty "I16" || named ty "U16" then
              let (w2, tr) = fresh w1 "%tr" in
              line (line w2 (cat ["  ", tr, " = trunc i64 ", val, " to i16"])) (cat ["  store i16 ", tr, ", ptr ", slot, ", align 1"])
            else if named ty "I32" || named ty "U32" || named ty "Char" || named ty "F32" || ((named ty "Usize" || named ty "Isize") && ptr-bytes == 4) then
              let (w2, tr) = fresh w1 "%tr" in
              line (line w2 (cat ["  ", tr, " = trunc i64 ", val, " to i32"])) (cat ["  store i32 ", tr, ", ptr ", slot, ", align 1"])
            else line w1 (cat ["  store i64 ", val, ", ptr ", slot, ", align 1"])

  emit-load-at :: Writer -> String -> Nat -> UType -> (Writer, String)
  emit-load-at w base-ptr off raw-ty =
    let ty = base (reduce-types (w.context.info.type-families) (w.context.info.promoted-fns) raw-ty) in
    let ptr-bytes = program-ptr-bytes (writer-program w) in
    case emit-gep-offset w base-ptr off of
      (w1, slot) ->
        if named ty "Unit" then (w1, "0")
        else if foreign-pointer ty then
          let (w2, r) = fresh w1 "%ld" in
          (line w2 (cat ["  ", r, " = load ptr, ptr ", slot, ", align 1"]), r)
        else case type-value-size-align (w1.context) ty of
          Some (sz, al) ->
            if sz == 0 then (w1, "0")
            else if sz <= 8 && al <= 16 then
              if sz == 8 then
                let (w2, r) = fresh w1 "%ld" in
                (line w2 (cat ["  ", r, " = load i64, ptr ", slot, ", align 1"]), r)
              else let it = "i" <> nat-to-string (sz * 8) in
                let (w2, raw) = fresh w1 "%ld" in
                let (w3, ext) = fresh w2 "%ext" in
                (emit-lines w3 [
                  cat ["  ", raw, " = load ", it, ", ptr ", slot, ", align 1"],
                  cat ["  ", ext, " = zext ", it, " ", raw, " to i64"]], ext)
            else if sz <= 16 && al <= 16 then
              let (w2, lo) = fresh w1 "%lo" in
              let w3 = line w2 (cat ["  ", lo, " = load i64, ptr ", slot, ", align 1"]) in
              case emit-gep-offset w3 slot 8 of
                (w4, hi-slot) ->
                  let rem = if 8 <= sz then sz - 8 else 0 in
                  let (w5, hi) = (if rem == 8 then
                        (let (wa, h) = fresh w4 "%hi" in
                        (line wa (cat ["  ", h, " = load i64, ptr ", hi-slot, ", align 1"]), h))
                      else (let it = "i" <> nat-to-string (rem * 8) in
                        let (wa, raw) = fresh w4 "%hi" in
                        let (wb, ext) = fresh wa "%ext" in
                        (emit-lines wb [
                          cat ["  ", raw, " = load ", it, ", ptr ", hi-slot, ", align 1"],
                          cat ["  ", ext, " = zext ", it, " ", raw, " to i64"]], ext))) in
                  let (w6, p0) = fresh w5 "%agg" in
                  let (w7, p1) = fresh w6 "%agg" in
                  (emit-lines w7 [
                    cat ["  ", p0, " = insertvalue { i64, i64 } undef, i64 ", lo, ", 0"],
                    cat ["  ", p1, " = insertvalue { i64, i64 } ", p0, ", i64 ", hi, ", 1"]], p1)
            else
              let w2 = request-demand MemcpyDemand w1 in
              let (w3, buf) = fresh w2 "%val" in
              (emit-lines w3 [
                cat ["  ", buf, " = alloca [", nat-to-string sz, " x i8], align ", nat-to-string al],
                cat ["  call void @llvm.memcpy.p0.p0.i64(ptr align ", nat-to-string al, " ", buf, ", ptr align 1 ", slot, ", i64 ", nat-to-string sz, ", i1 false)"]], buf)
          None ->
            if wide-scalar ty then
              let (w2, r) = fresh w1 "%ld" in
              (line w2 (cat ["  ", r, " = load i128, ptr ", slot, ", align 1"]), r)
            else if named ty "Bool" || named ty "I8" || named ty "U8" then
              let (w2, raw) = fresh w1 "%ld" in
              let (w3, ext) = fresh w2 "%ext" in
              let op = if named ty "I8" then "sext" else "zext" in
              (emit-lines w3 [
                cat ["  ", raw, " = load i8, ptr ", slot, ", align 1"],
                cat ["  ", ext, " = ", op, " i8 ", raw, " to i64"]], ext)
            else if named ty "I16" || named ty "U16" then
              let (w2, raw) = fresh w1 "%ld" in
              let (w3, ext) = fresh w2 "%ext" in
              let op = if named ty "I16" then "sext" else "zext" in
              (emit-lines w3 [
                cat ["  ", raw, " = load i16, ptr ", slot, ", align 1"],
                cat ["  ", ext, " = ", op, " i16 ", raw, " to i64"]], ext)
            else if named ty "I32" || named ty "U32" || named ty "Char" || named ty "F32" || ((named ty "Usize" || named ty "Isize") && ptr-bytes == 4) then
              let (w2, raw) = fresh w1 "%ld" in
              let (w3, ext) = fresh w2 "%ext" in
              let op = if named ty "I32" || named ty "Isize" then "sext" else "zext" in
              (emit-lines w3 [
                cat ["  ", raw, " = load i32, ptr ", slot, ", align 1"],
                cat ["  ", ext, " = ", op, " i32 ", raw, " to i64"]], ext)
            else
              let (w2, r) = fresh w1 "%ld" in
              (line w2 (cat ["  ", r, " = load i64, ptr ", slot, ", align 1"]), r)

  materialize-value-ptr :: Writer -> UType -> String -> (Writer, String)
  materialize-value-ptr w ty val = case type-value-size-align (w.context) ty of
    Some (sz, al) ->
      if sz > 16 || al > 16 then (w, val)
      else let alloc-sz = if sz == 0 then 1 else sz in
        let (w1, buf) = fresh w "%vbuf" in
        let w2 = line w1 (cat ["  ", buf, " = alloca [", nat-to-string alloc-sz, " x i8], align ", nat-to-string al]) in
        (emit-store-at w2 buf 0 ty val, buf)
    None -> (w, val)

  store-value-fields :: Writer -> String -> List ValueField -> List String -> Writer
  store-value-fields w buf fields vals = case (fields, vals) of
    (vf : rest, v : more) -> store-value-fields (emit-store-at w buf (vf.vf-offset) (vf.vf-type) v) buf rest more
    other -> w

  construct-value-data :: List CoreDefinition -> List Local -> Writer -> Nat -> Nat -> List ValueField -> List CoreTerm -> (Writer, String)
  construct-value-data definitions locals w sz al vfields args =
    case expressions definitions locals w args of
      (w1, vals) ->
        let alloc-sz = if sz == 0 then 1 else sz in
        let w2 = if sz > 0 then request-demand MemsetDemand w1 else w1 in
        let (w3, buf) = fresh w2 "%vobj" in
        let w4 = line w3 (cat ["  ", buf, " = alloca [", nat-to-string alloc-sz, " x i8], align ", nat-to-string al]) in
        let w5 = if sz > 0 then line w4 (cat ["  call void @llvm.memset.p0.i64(ptr align ", nat-to-string al, " ", buf, ", i8 0, i64 ", nat-to-string sz, ", i1 false)"]) else w4 in
        let w6 = store-value-fields w5 buf vfields vals in
        if sz > 16 || al > 16 then (w6, buf)
        else if sz == 0 then (w6, "0")
        else if sz <= 8 then
          if sz == 8 then
            let (w7, r) = fresh w6 "%vval" in
            (line w7 (cat ["  ", r, " = load i64, ptr ", buf, ", align ", nat-to-string al]), r)
          else let it = "i" <> nat-to-string (sz * 8) in
            let (w7, raw) = fresh w6 "%vval" in
            let (w8, ext) = fresh w7 "%vext" in
            (emit-lines w8 [
              cat ["  ", raw, " = load ", it, ", ptr ", buf, ", align 1"],
              cat ["  ", ext, " = zext ", it, " ", raw, " to i64"]], ext)
        else
          let (w7, lo) = fresh w6 "%lo" in
          let w8 = line w7 (cat ["  ", lo, " = load i64, ptr ", buf, ", align 1"]) in
          case emit-gep-offset w8 buf 8 of
            (w9, hi-slot) ->
              let rem = if 8 <= sz then sz - 8 else 0 in
              let (w10, hi) = (if rem == 8 then
                    (let (wa, h) = fresh w9 "%hi" in
                    (line wa (cat ["  ", h, " = load i64, ptr ", hi-slot, ", align 1"]), h))
                  else (let it = "i" <> nat-to-string (rem * 8) in
                    let (wa, raw) = fresh w9 "%hi" in
                    let (wb, ext) = fresh wa "%ext" in
                    (emit-lines wb [
                      cat ["  ", raw, " = load ", it, ", ptr ", hi-slot, ", align 1"],
                      cat ["  ", ext, " = zext ", it, " ", raw, " to i64"]], ext))) in
              let (w11, p0) = fresh w10 "%agg" in
              let (w12, p1) = fresh w11 "%agg" in
              (emit-lines w12 [
                cat ["  ", p0, " = insertvalue { i64, i64 } undef, i64 ", lo, ", 0"],
                cat ["  ", p1, " = insertvalue { i64, i64 } ", p0, ", i64 ", hi, ", 1"]], p1)

  match-value-fields :: CorePattern -> String -> List ValueField -> String -> Writer -> (Writer, List Local)
  match-value-fields pat-fields buf vfields failed w = case (pat-fields, vfields) of
    (CPDone end, other) -> (w, [])
    (CPField sp (CPProof at pred id name) rest, fs) -> match-value-fields rest buf fs failed w
    (CPField sp first rest, vf : more) ->
      case emit-load-at w buf (vf.vf-offset) (vf.vf-type) of
        (w1, fval) -> case match-pattern first fval failed w1 of
          (w2, bindings) -> case match-value-fields rest buf more failed w2 of
            (w3, rest-bindings) -> (w3, bindings <> rest-bindings)
    other -> (refuse w (Span 0 0 1 1) "value struct pattern arity mismatch", [])

  match-value-data :: UType -> Nat -> Nat -> List ValueField -> CorePattern -> String -> String -> Writer -> (Writer, List Local)
  match-value-data ty sz al vfields pat-fields value failed w =
    case materialize-value-ptr w ty value of
      (w1, buf) -> match-value-fields pat-fields buf vfields failed w1

  find-runtime-value-field :: String -> List ValueField -> Option ValueField
  find-runtime-value-field wanted fields = case fields of
    [] -> None
    vf : rest -> if vf.vf-name == wanted then Some vf else find-runtime-value-field wanted rest

  resolve-runtime-value-path :: List CoreData -> UType -> List String -> Nat -> Option (Nat, UType)
  resolve-runtime-value-path datas carrier labels acc = case labels of
    [] -> None
    label : rest -> case type-head (base carrier) of
      UCon owner KType -> (case value-layout-of owner datas of
        Some (repr, sz, al, vfields) -> (case find-runtime-value-field label vfields of
          Some vf -> let off = acc + vf.vf-offset in
            case rest of
              [] -> Some (off, vf.vf-type)
              more -> resolve-runtime-value-path datas (vf.vf-type) more off
          None -> None)
        None -> None)
      other -> None

  eval-place-ptr :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> (Writer, String)
  eval-place-ptr definitions locals w place = case place of
    CLocal sp ty id name [] -> (case stack-cell-local id locals of
      Some (declared, ptr-reg) -> (w, ptr-reg)
      None -> case expression definitions locals w place of
        (w1, val) -> if value-llvm (w1.context) (core-type place) == "ptr" then (w1, val)
          else let (w2, p) = fresh w1 "%ptr" in (line w2 (cat ["  ", p, " = inttoptr i64 ", val, " to ptr"]), p))
    other -> case expression definitions locals w place of
      (w1, val) -> if value-llvm (w1.context) (core-type place) == "ptr" then (w1, val)
        else let (w2, p) = fresh w1 "%ptr" in (line w2 (cat ["  ", p, " = inttoptr i64 ", val, " to ptr"]), p)

  emit-fixed-fill :: Writer -> String -> Nat -> Nat -> Nat -> UType -> String -> Writer
  emit-fixed-fill w buf idx count stride elem val =
    if idx >= count then w
    else emit-fixed-fill (emit-store-at w buf (idx * stride) elem val) buf (idx + 1) count stride elem val

  value-primitive :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> String -> CoreTerm -> (Writer, String)
  value-primitive definitions locals w sp ty op args =
    let datas = (writer-program w).index-of.datas in
    let word-bits = program-word-bits (writer-program w) in
    if op == "val-local-scope" then
      (case args of
        CArgument at (CLet lt lty lid lname lsc (CPrimitive sat smty "val-stack-alloc" (CArgument iat init (CArgumentsEnd iend))) body) (CArgumentsEnd end) ->
          (case mutable-borrow (scheme-body lsc) of
            Some (region, carrier) -> case expression definitions locals w init of
              (w1, init-val) -> case type-value-size-align (w1.context) carrier of
                Some (sz, al) ->
                  let alloc-sz = if sz == 0 then 1 else sz in
                  let (w2, buf) = fresh w1 "%local" in
                  let w3 = line w2 (cat ["  ", buf, " = alloca [", nat-to-string alloc-sz, " x i8], align ", nat-to-string al]) in
                  let w4 = emit-store-at w3 buf 0 carrier init-val in
                  expression definitions ((Local lid (scheme-body lsc) buf) : locals) w4 body
                None ->
                  let (w2, buf) = fresh w1 "%local" in
                  let (w3, cell) = fresh w2 "%cell" in
                  let init-ty = value-llvm (w3.context) carrier in
                  let w4 = emit-lines w3 [
                    cat ["  ", buf, " = alloca [2 x i64], align 8"],
                    cat ["  store i64 0, ptr ", buf, ", align 8"],
                    cat ["  ", cell, " = getelementptr inbounds i8, ptr ", buf, ", i64 8"],
                    cat ["  store ", init-ty, " ", init-val, ", ptr ", cell, ", align 8"]] in
                  expression definitions ((StackCell lid (scheme-body lsc) cell) : locals) w4 body
            None -> unsupported w sp "val-local-scope requires a Mut carrier")
        other -> unsupported w sp "malformed val-local-scope")
    else if op == "val-ref-as-ptr" || op == "val-mut-as-ptr" then
      (case args of
        CArgument at place (CArgumentsEnd end) -> eval-place-ptr definitions locals w place
        other -> unsupported w sp "refAsPtr/mutAsPtr takes one place argument")
    else if op == "val-place-load" then
      (case args of
        CArgument at place (CArgument bt (CString st sty path) (CArgumentsEnd end)) ->
          (case borrow-type-parts (base (core-type place)) of
            Some (is-mut, region, carrier) -> (case resolve-runtime-value-path datas carrier (string-split-on "." path) 0 of
              Some (off, fty) -> case eval-place-ptr definitions locals w place of
                (w1, base-ptr) -> emit-load-at w1 base-ptr off fty
              None -> unsupported w sp ("unknown value field path: " <> path))
            None -> unsupported w sp "val-place-load requires a borrowed place")
        other -> unsupported w sp "malformed val-place-load")
    else if op == "val-place-store" then
      (case args of
        CArgument at place (CArgument bt (CString st sty path) (CArgument ct val-term (CArgumentsEnd end))) ->
          (case mutable-borrow (base (core-type place)) of
            Some (region, carrier) -> (case resolve-runtime-value-path datas carrier (string-split-on "." path) 0 of
              Some (off, fty) -> case eval-place-ptr definitions locals w place of
                (w1, base-ptr) -> case expression definitions locals w1 val-term of
                  (w2, val-reg) -> (emit-store-at w2 base-ptr off fty val-reg, "0")
              None -> unsupported w sp ("unknown value field path: " <> path))
            None -> unsupported w sp "val-place-store requires a Mut place")
        other -> unsupported w sp "malformed val-place-store")
    else if op == "val-place-subborrow" then
      (case args of
        CArgument at place (CArgument bt (CString st sty path) (CArgumentsEnd end)) ->
          (case borrow-type-parts (base (core-type place)) of
            Some (is-mut, region, carrier) -> (case resolve-runtime-value-path datas carrier (string-split-on "." path) 0 of
              Some (off, fty) -> case eval-place-ptr definitions locals w place of
                (w1, base-ptr) -> case emit-gep-offset w1 base-ptr off of
                  (w2, sub-ptr) ->
                    if value-llvm (w2.context) ty == "ptr" then (w2, sub-ptr)
                    else let (w3, wval) = fresh w2 "%v" in (line w3 (cat ["  ", wval, " = ptrtoint ptr ", sub-ptr, " to i64"]), wval)
              None -> unsupported w sp ("unknown value field path: " <> path))
            None -> unsupported w sp "val-place-subborrow requires a borrowed place")
        other -> unsupported w sp "malformed val-place-subborrow")
    else if op == "val-fixed-repeat" then
      (case (fixed-array-parts (base ty), args) of
        (Some (count, elem), CArgument at init-term (CArgumentsEnd end)) ->
          (case pod-type-layout word-bits datas elem of
            Some (esz, eal) ->
              let stride = value-align-up esz eal in
              let total = count * stride in
              let alloc-sz = if total == 0 then 1 else total in
              case expression definitions locals w init-term of
                (w1, init-val) ->
                  let (w2, buf) = fresh w1 "%farr" in
                  let w3 = line w2 (cat ["  ", buf, " = alloca [", nat-to-string alloc-sz, " x i8], align ", nat-to-string eal]) in
                  let w4 = emit-fixed-fill w3 buf 0 count stride elem init-val in
                  if total > 16 || eal > 16 then (w4, buf)
                  else emit-load-at w4 buf 0 ty
            None -> unsupported w sp "FixedArray element must be POD")
        other -> unsupported w sp "malformed val-fixed-repeat")
    else if op == "val-fixed-get" then
      (case args of
        CArgument at arr-term (CArgument bt idx-term (CArgumentsEnd end)) ->
          let raw-ty = base (core-type arr-term) in
          let (is-borrowed, arr-ty) = case borrowed-carrier raw-ty of Some c -> (True, c); None -> (False, raw-ty) in
          (case fixed-array-parts arr-ty of
            Some (count, elem) -> (case pod-type-layout word-bits datas elem of
              Some (esz, eal) ->
                let stride = value-align-up esz eal in
                let (w1, base-ptr) = if is-borrowed then eval-place-ptr definitions locals w arr-term
                      else (case expression definitions locals w arr-term of
                        (wa, val) -> materialize-value-ptr wa arr-ty val) in
                case expression definitions locals w1 idx-term of
                  (w2, idx-val) ->
                    let (w3, byte-off) = fresh w2 "%off" in
                    let (w4, ep) = fresh w3 "%ep" in
                    let w5 = emit-lines w4 [
                      cat ["  ", byte-off, " = mul i64 ", idx-val, ", ", nat-to-string stride],
                      cat ["  ", ep, " = getelementptr inbounds i8, ptr ", base-ptr, ", i64 ", byte-off]] in
                    emit-load-at w5 ep 0 elem
              None -> unsupported w sp "FixedArray element must be POD")
            None -> unsupported w sp "val-fixed-get requires a FixedArray")
        other -> unsupported w sp "malformed val-fixed-get")
    else if op == "val-fixed-set" then
      (case args of
        CArgument at place (CArgument bt idx-term (CArgument ct val-term (CArgumentsEnd end))) ->
          (case mutable-borrow (base (core-type place)) of
            Some (region, arr-ty) -> (case fixed-array-parts arr-ty of
              Some (count, elem) -> (case pod-type-layout word-bits datas elem of
                Some (esz, eal) ->
                  let stride = value-align-up esz eal in
                  case eval-place-ptr definitions locals w place of
                    (w1, base-ptr) -> case expression definitions locals w1 idx-term of
                      (w2, idx-val) -> case expression definitions locals w2 val-term of
                        (w3, val-reg) ->
                          let (w4, byte-off) = fresh w3 "%off" in
                          let (w5, ep) = fresh w4 "%ep" in
                          let w6 = emit-lines w5 [
                            cat ["  ", byte-off, " = mul i64 ", idx-val, ", ", nat-to-string stride],
                            cat ["  ", ep, " = getelementptr inbounds i8, ptr ", base-ptr, ", i64 ", byte-off]] in
                          (emit-store-at w6 ep 0 elem val-reg, "0")
                None -> unsupported w sp "FixedArray element must be POD")
              None -> unsupported w sp "val-fixed-set requires a Mut FixedArray")
            None -> unsupported w sp "val-fixed-set requires a Mut FixedArray")
        other -> unsupported w sp "malformed val-fixed-set")
    else if op == "val-fixed-ref" || op == "val-fixed-mut" then
      (case args of
        CArgument at place (CArgument bt idx-term (CArgumentsEnd end)) ->
          (case borrow-type-parts (base (core-type place)) of
            Some (is-mut, region, arr-ty) -> (case fixed-array-parts arr-ty of
              Some (count, elem) -> (case pod-type-layout word-bits datas elem of
                Some (esz, eal) ->
                  let stride = value-align-up esz eal in
                  case eval-place-ptr definitions locals w place of
                    (w1, base-ptr) -> case expression definitions locals w1 idx-term of
                      (w2, idx-val) ->
                        let (w3, byte-off) = fresh w2 "%off" in
                        let (w4, ep) = fresh w3 "%ep" in
                        let w5 = emit-lines w4 [
                          cat ["  ", byte-off, " = mul i64 ", idx-val, ", ", nat-to-string stride],
                          cat ["  ", ep, " = getelementptr inbounds i8, ptr ", base-ptr, ", i64 ", byte-off]] in
                        if value-llvm (w5.context) ty == "ptr" then (w5, ep)
                        else let (w6, wval) = fresh w5 "%v" in (line w6 (cat ["  ", wval, " = ptrtoint ptr ", ep, " to i64"]), wval)
                None -> unsupported w sp "FixedArray element must be POD")
              None -> unsupported w sp "val-fixed-ref/mut requires a FixedArray borrow")
            None -> unsupported w sp "val-fixed-ref/mut requires a borrow")
        other -> unsupported w sp "malformed val-fixed-ref/mut")
    else unsupported w sp ("unsupported value primitive: " <> op)

  copy-out-word :: List CoreDefinition -> List Local -> Writer -> UType -> CoreTerm -> (Writer, String)
  copy-out-word definitions locals w ty input = case input of
    CLocal sp lty id name [] -> (case stack-cell-local id locals of
      Some (declared, ptr-reg) ->
        let (w1, val) = fresh w "%v" in
        (line w1 (cat ["  ", val, " = load ", value-llvm (w1.context) ty, ", ptr ", ptr-reg, ", align 8"]), val)
      None -> copy-out-word-general definitions locals w ty input)
    other -> copy-out-word-general definitions locals w ty input
  copy-out-word-general :: List CoreDefinition -> List Local -> Writer -> UType -> CoreTerm -> (Writer, String)
  copy-out-word-general definitions locals w ty input = case borrow-type-parts (base (core-type input)) of
    Some (is-mut, region, carrier) | is-value-type (w.context) carrier ->
      (case eval-place-ptr definitions locals w input of
        (w1, ptr-reg) -> emit-load-at w1 ptr-reg 0 carrier)
    other -> case mutable-borrow (core-type input) of
      None -> expression definitions locals w input
      Some place -> if wide-type (w.context) ty then unsupported w (Span 0 0 1 1) wide-refusal else case expression definitions locals w input of
        (ready, cell) -> let (one, pointer) = fresh ready "%ptr" in
          (case load-word (line one (cat ["  ", pointer, " = inttoptr i64 ", cell, " to ptr"])) pointer "0" of
            (loaded, value) -> (count-op False (core-type input) cell (count-op True ty value loaded), value))
  write-borrow-word :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> CoreTerm -> (Writer, String)
  write-borrow-word definitions locals w sp cell-term input = case cell-term of
    CLocal lsp lty id name [] -> (case stack-cell-local id locals of
      Some (declared, ptr-reg) -> (case mutable-borrow (base declared) of
        Some (region, carrier) -> case expression definitions locals w input of
          (ready, value) -> (line ready (cat ["  store ", value-llvm (ready.context) carrier, " ", value, ", ptr ", ptr-reg, ", align 8"]), "0")
        None -> write-borrow-word-general definitions locals w sp cell-term input)
      None -> write-borrow-word-general definitions locals w sp cell-term input)
    other -> write-borrow-word-general definitions locals w sp cell-term input
  write-borrow-word-general :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> CoreTerm -> (Writer, String)
  write-borrow-word-general definitions locals w sp cell-term input = case mutable-borrow (core-type cell-term) of
    None -> unsupported w sp "mutable write needs a checked cell carrier"
    Some (region, carrier) ->
      if is-value-type (w.context) carrier then
        (case eval-place-ptr definitions locals w cell-term of
          (w1, ptr-reg) -> case expression definitions locals w1 input of
            (w2, value) -> (emit-store-at w2 ptr-reg 0 carrier value, "0"))
      else if wide-type (w.context) carrier then unsupported w sp wide-refusal else case expression definitions locals w cell-term of
        (held, cell) -> case expression definitions locals held input of
          (ready, value) -> let (one, pointer) = fresh ready "%ptr" in
            (case load-word (line one (cat ["  ", pointer, " = inttoptr i64 ", cell, " to ptr"])) pointer "0" of
              (loaded, old) -> let replaced = store-fields loaded pointer 0 [value] in
                (count-op False (core-type cell-term) cell (count-op False carrier old replaced), "0"))
  compare-word :: Writer -> String -> String -> String -> (Writer, String)
  compare-word w predicate a b = compare-typed w "i64" predicate a b
  -- | Lower checked machine ordering without treating unsigned high bits as signs.
  -- Narrow scalar words already carry their ABI sign or zero extension; wide
  -- scalars retain their i128 carrier instead of being truncated to one word.
  machine-ordering :: UType -> String -> String
  machine-ordering ty op =
    let signed = named ty "I8" || named ty "I16" || named ty "I32" || named ty "I64" || named ty "Isize" || named ty "I128" in
    cat [if signed then "s" else "u", if op == "<" then "lt" else if op == "<=" then "le" else if op == ">" then "gt" else "ge"]
  -- The Bool word of an integer comparison at an LLVM width.
  compare-typed :: Writer -> String -> String -> String -> String -> (Writer, String)
  compare-typed w ty predicate a b = let (one, flag) = fresh w "%v" in let (two, result) = fresh one "%v" in
    (line (line two (cat ["  ", flag, " = icmp ", predicate, " ", ty, " ", a, ", ", b])) (cat ["  ", result, " = zext i1 ", flag, " to i64"]), result)
  -- A wide literal's LLVM `i128` operand. LLVM reads a decimal constant as
  -- signed, so a U128 at or above 2^127 is written as its two's complement.
  wide-literal :: UType -> String -> String
  wide-literal ty text = if named ty "U128" then (case decimal-bytes (string-to-bytes text) 0 0 of
      Some value -> if value >= 170141183460469231731687303715884105728 && value <= 340282366920938463463374607431768211456 then cat ["-", nat-to-string (340282366920938463463374607431768211456 - value)] else text
      None -> text)
    else text
  comparison :: String -> Option String
  comparison op = if op == "==" then Some "eq" else if op == "/=" then Some "ne" else if op == "<" then Some "slt" else if op == "<=" then Some "sle" else if op == ">" then Some "sgt" else if op == ">=" then Some "sge" else None
  binary :: List CoreDefinition -> List Local -> Writer -> Span -> String -> CoreTerm -> CoreTerm -> (Writer, String)
  binary definitions locals w sp op first second = case expressions definitions locals w [first, second] of
    (ready, [a, b]) ->
      let ty = core-type first in
      let prefix = cat ["@cinch_", runtime-number ty, "_"] in
      let operation = if op == "+" then Some "add" else if op == "-" then Some "sub" else if op == "*" then Some "mul" else if op == "/" then Some "div" else None in
      let lowered = (case operation of
            Some suffix -> call ready (cat [prefix, suffix]) [a, b]
            None -> case comparison op of
              Some predicate -> case call ready (cat [prefix, "cmp"]) [a, b] of (compared, order) -> compare-word compared predicate order "0"
              None -> unsupported ready sp "numeric primitive needs runtime lowering") in
      case lowered of (done, result) -> (count-op False ty b (count-op False ty a done), result)
    other -> unsupported w sp "malformed numeric arguments"
  parameter-words :: List CorePattern -> Nat -> List String
  parameter-words patterns index = case patterns of
    [] -> []
    first : rest -> (cat ["i64 %arg", nat-to-string index]) : (parameter-words rest (index + 1))
  parameter-roots :: List CorePattern -> Nat -> List Local
  parameter-roots patterns index = case patterns of
    [] -> []
    first : rest -> (Discard (pattern-type first) (cat ["%arg", nat-to-string index])) : (parameter-roots rest (index + 1))
  unpacked-slots :: Writer -> String -> Option (List RecordSlot)
  unpacked-slots w name = case constructor name (writer-program w) of
    Some (owner, tag, c) -> (case data-declaration owner (writer-program w) of
      Some d -> (case core-data-layout d of UnpackedRecord slots -> Some slots; other -> None)
      None -> None)
    None -> None
  largest-pattern-id :: List CorePattern -> Nat
  largest-pattern-id patterns = case patterns of [] -> 0; p : rest -> handler-largest (handler-pattern-id p) (largest-pattern-id rest)
  prepare-match :: List CorePattern -> CoreTerm -> List Local -> Writer -> (List CorePattern, CoreTerm, Writer)
  prepare-match patterns body locals w = case (writer-program w).index-of of
    DataIndex datas types ctors unpacked -> if not unpacked || not (needs-unpacked-patterns (unpacked-slots w) patterns) then (patterns, body, w) else
      let next = 1 + handler-largest (handler-term-id body) (handler-largest (handler-local-id locals) (largest-pattern-id patterns)) in
      (case lower-unpacked-patterns term-uses (unpacked-slots w) patterns body next of
        Some (physical, rebuilt) -> (physical, rebuilt, w)
        None -> (patterns, body, refuse w (Span 0 0 1 1) "record pattern disagrees with checked unpack layout"))
  match-clause :: List CorePattern -> CoreTerm -> List Local -> Nat -> String -> Writer -> (Writer, List Local, CoreTerm)
  match-clause patterns body locals offset failed w = case prepare-match patterns body locals w of
    (physical, rebuilt, ready) -> (case match-parameters physical offset failed ready of (done, bindings) -> (done, bindings, rebuilt))
  match-alternative :: CorePattern -> CoreTerm -> List Local -> String -> String -> Writer -> (Writer, List Local, CoreTerm)
  match-alternative pat body locals value failed w = case prepare-match [pat] body locals w of
    ([physical], rebuilt, ready) -> (case match-pattern physical value failed ready of (done, bindings) -> (done, bindings, rebuilt))
    other -> (refuse w (Span 0 0 1 1) "missing checked alternative pattern", [], body)
  match-parameters :: List CorePattern -> Nat -> String -> Writer -> (Writer, List Local)
  match-parameters patterns index failed w = case patterns of
    [] -> (w, [])
    first : rest -> if erased-pattern first then match-parameters rest index failed w else case match-pattern first (cat ["%arg", nat-to-string index]) failed w of
      (matched, bindings) -> case match-parameters rest (index + 1) failed matched of
        (done, more) -> (done, bindings <> more)
  take-parameter-root :: String -> List Local -> Option (List Local)
  take-parameter-root returned roots = case roots of
    [] -> None
    root : rest -> case root of
      Discard ty word | (returned == word) -> Some rest
      other -> case take-parameter-root returned rest of
        Some remaining -> Some (root : remaining)
        None -> None
  parameter-value :: List Local -> List Local -> CoreTerm -> Option (String, List Local)
  parameter-value locals roots term = case term of
    CForget at ty input -> parameter-value locals roots input
    CCast at ty input -> parameter-value locals roots input
    CLocal sp ty id name [] -> (case local id locals of
      Some (declared, word) -> (case take-parameter-root word roots of
        Some remaining -> Some (word, remaining)
        None -> None)
      None -> None)
    other -> None

  -- A returned parameter and a case in return position each consume one
  -- owner. The case holds it until the selected arm has evaluated.
  worker-result :: List CoreDefinition -> List Local -> List Local -> Writer -> String -> CoreTerm -> (Writer, String)
  worker-result definitions locals roots w failed body = case body of
    CCase sp ty scrutinee alternatives -> (case parameter-value locals roots scrutinee of
      Some (word, remaining) -> (case case-value definitions locals w (core-type scrutinee) word alternatives of
        (done, result) -> (drop-locals remaining done, result))
      None -> ordinary-worker-result definitions locals roots w failed body)
    other -> case parameter-value locals roots body of
      Some (word, remaining) -> (drop-locals remaining w, word)
      None -> ordinary-worker-result definitions locals roots w failed body
  ordinary-worker-result :: List CoreDefinition -> List Local -> List Local -> Writer -> String -> CoreTerm -> (Writer, String)
  ordinary-worker-result definitions locals roots w failed body = case guarded-expression definitions locals w failed body of
    (done, word) -> (drop-locals roots done, word)
  worker-clauses :: List CoreDefinition -> List Local -> List Local -> Nat -> List CoreClause -> Writer -> Writer
  worker-clauses definitions prefix roots offset clauses w =
    worker-clauses-arena definitions prefix roots offset None clauses w
  worker-clauses-arena :: List CoreDefinition -> List Local -> List Local -> Nat -> Option String -> List CoreClause -> Writer -> Writer
  worker-clauses-arena definitions prefix roots offset arena-handle clauses w = case clauses of
    [] -> line w "  unreachable"
    (CoreClause sp patterns body) : rest ->
      let (one, failed) = fresh w "nexteq" in
      case match-clause patterns body prefix offset failed one of
        (matched, bindings, rebuilt) -> case worker-result definitions (bindings <> prefix) roots matched failed rebuilt of
          (done, result) ->
            let exited = (case arena-handle of
                  Some h -> line done (cat ["  call i64 @cinch_arena_exit_phase(i64 ", h, ")"])
                  None -> done) in
            let returned = line exited (cat ["  ret ", value-llvm (exited.context) (core-type body), " ", result]) in
            worker-clauses-arena definitions prefix roots offset arena-handle rest (line returned (cat [failed, ":"]))
  worker-uses-arena :: String -> Writer -> Bool
  worker-uses-arena name w =
    let info = writer-program w in
    info.reclaim && not (program-wasm32 info) && (case hash-map-lookup name (program-arena-phases info) of Some True -> True; other -> False)
  worker :: List CoreDefinition -> List Nat -> Writer -> CoreDefinition -> Writer
  worker definitions classes w d = case d of
    CoreDefinition sp name sc openings givens private clauses -> case class-bindings (scheme-params sc) classes of
      None -> refuse w sp "definition needs first-order runtime representation specialization"
      Some bounds -> case definition-rigids d bounds of
        None -> refuse w sp "definition runtime representation openings are invalid"
        Some rigids -> let scoped = with-representations bounds rigids w in
          if not (scheme-supported (scoped.context) sc) then refuse scoped sp (cat ["definition needs dictionary or unsupported runtime lowering: ", name])
          else case clauses of
            (CoreClause at patterns body) : rest ->
              let context = runtime-givens scoped d in
              let dependencies = definition-value-dependencies scoped d in
              let hidden = list-length dependencies in
              let index-offset = hidden + list-length context in
              let indices = opening-value-types openings in
              let offset = index-offset + list-length indices in
              let prefix = worker-self-values scoped d dependencies <> given-bindings context hidden <> runtime-index-locals indices index-offset <> self-binding scoped d classes in
              let parameters = runtime-parameters patterns in
              let roots = capture-roots (value-field-types dependencies) 0 <> given-roots context hidden <> runtime-index-locals indices index-offset <> parameter-roots parameters offset in
              let types = value-field-types dependencies <> given-types context <> value-types indices <> pattern-types parameters in
              -- Tail workers pass every argument in a word slot, so a Wide
              -- specialization of a group member uses the typed self-loop
              -- worker when self-tail-recursive, or an ordinary worker otherwise.
              let non-word = definition-has-non-word (scoped.context) d types in
              case (if wide-code classes || val-code classes || non-word then None else hash-map-lookup name ((writer-program scoped).tail-groups)) of
                Some (group, width) -> global-tail-worker definitions d classes prefix roots scoped group width (list-length parameters)
                None -> if not non-word && offset == 0 && list-length (proof-stage-arities patterns offset) == 1 && self-tail-present name classes (list-length parameters) (d.clauses) then
                    self-loop-worker definitions classes d prefix roots types (list-length parameters) scoped
                  else proof-worker-stages definitions classes d prefix roots offset types (proof-stage-arities patterns offset) 0 scoped
            [] -> refuse scoped sp "runtime definition has no checked equations"
  -- | Check whether any clause contains a direct saturated self-tail call with the same class vector.
  self-tail-present :: String -> List Nat -> Nat -> List CoreClause -> Bool
  self-tail-present self classes arity clauses = case clauses of
    [] -> False
    (CoreClause sp patterns body) : rest -> term-has-self-tail self arity body || self-tail-present self classes arity rest
  term-has-self-tail :: String -> Nat -> CoreTerm -> Bool
  term-has-self-tail self arity term = case term of
    CIf sp ty test yes no -> term-has-self-tail self arity yes || term-has-self-tail self arity no
    CCase sp ty value alts -> alts-have-self-tail self arity alts
    CGuard sp ty cond body -> term-has-self-tail self arity body
    CLet sp ty id name sc rhs body -> term-has-self-tail self arity body
    CWith sp ty given value body -> term-has-self-tail self arity body
    CRequire sp ty body -> term-has-self-tail self arity body
    CProved sp ty ev body -> term-has-self-tail self arity body
    CRefine sp ty ev body -> term-has-self-tail self arity body
    CRefineProof sp ty witness body -> term-has-self-tail self arity body
    CDischarge sp ty ev _ body -> term-has-self-tail self arity body
    CForget sp ty body -> term-has-self-tail self arity body
    CCast sp ty body -> term-has-self-tail self arity body
    other -> case head term of
      CUse sp ty name role actuals | role /= "foreign" && role /= "constructor" ->
        name == self && list-length (arguments term []) == arity
      other -> False
  alts-have-self-tail :: String -> Nat -> CoreTerm -> Bool
  alts-have-self-tail self arity alts = case alts of
    CAlternative sp pat body rest -> term-has-self-tail self arity body || alts-have-self-tail self arity rest
    other -> False
  -- | Typed alloca/load/store helpers supporting both i64 and i128 self-tail loop parameters.
  allocate-typed-loop-args :: List (String, String) -> Writer -> Writer
  allocate-typed-loop-args typed w = case typed of
    [] -> w
    (ty, arg) : rest -> allocate-typed-loop-args rest (line (line w (cat ["  ", arg, ".slot = alloca ", ty])) (cat ["  store ", ty, " ", arg, ".initial, ptr ", arg, ".slot"]))
  load-typed-loop-args :: List (String, String) -> Writer -> Writer
  load-typed-loop-args typed w = case typed of
    [] -> w
    (ty, arg) : rest -> load-typed-loop-args rest (line w (cat ["  ", arg, " = load ", ty, ", ptr ", arg, ".slot"]))
  store-typed-loop-args :: List String -> List String -> Nat -> Writer -> Writer
  store-typed-loop-args llvms vals index w = case llvms of
    [] -> w
    ty : ts -> case vals of val : vs -> store-typed-loop-args ts vs (index + 1) (line w (cat ["  store ", ty, " ", val, ", ptr %arg", nat-to-string index, ".slot"])); [] -> w
  -- | Emit a typed wrapper + private SSA self-tail loop worker for functions with i64 or i128 parameters.
  self-loop-worker :: List CoreDefinition -> List Nat -> CoreDefinition -> List Local -> List Local -> List UType -> Nat -> Writer -> Writer
  self-loop-worker definitions classes d prefix roots types arity w =
    let name = specialized-name (d.name) classes in
    let loop-name = cat [name, "#loop"] in
    let result = definition-result-llvm (w.context) d in
    let param-llvms = value-llvms (w.context) (take-types arity types) in
    let params = value-parameters arity 0 in
    let typed = typed-values param-llvms params in
    let init-typed = typed-values param-llvms (map (\word -> word <> ".initial") params) in
    let wrapper-head = line (line w (cat ["define ", worker-linkage w name, result, " ", symbol name, "(", join (typed-arguments typed), ")", llvm-hint w (d.name), worker-open w])) "entry:" in
    case typed-call wrapper-head result (symbol loop-name) typed of
      (called, res) ->
        let wrapped = line (line called (cat ["  ret ", result, " ", res])) "}" in
        let started = line (line wrapped (cat ["define private ", result, " ", symbol loop-name, "(", join (typed-arguments init-typed), ")", llvm-hint w (d.name), worker-open w])) "entry:" in
        let looped = load-typed-loop-args typed (line (line (allocate-typed-loop-args typed started) "  br label %self.loop") "self.loop:") in
        line (self-loop-clauses definitions (d.name) classes param-llvms result (LoopMarker : prefix) roots (d.clauses) looped) "}"
  self-loop-clauses :: List CoreDefinition -> String -> List Nat -> List String -> String -> List Local -> List Local -> List CoreClause -> Writer -> Writer
  self-loop-clauses definitions self classes param-llvms result prefix roots clauses w = case clauses of
    [] -> line w "  unreachable"
    (CoreClause sp patterns body) : rest ->
      let (one, failed) = fresh w "nexttaileq" in
      case match-clause patterns body prefix 0 failed one of
        (matched, bindings, rebuilt) ->
          let done = self-loop-result definitions self classes param-llvms result (bindings <> prefix) roots matched failed rebuilt in
          self-loop-clauses definitions self classes param-llvms result prefix roots rest (line done (cat [failed, ":"]))
  self-loop-call-args :: String -> List Nat -> Nat -> Writer -> CoreTerm -> Option (List CoreTerm)
  self-loop-call-args self classes arity w term = case head term of
    CUse sp ty name role actuals | role /= "foreign" && role /= "constructor" && name == self ->
      let args = arguments term [] in
      if list-length args == arity then
        (case worker-definition name w of
          Some d -> (case source-scheme-classes (w.context) (scheme-params (d.scheme)) actuals of
            Some call-classes | same-nat-list call-classes classes -> Some args
            other -> None)
          None -> None)
      else None
    other -> None
  same-nat-list :: List Nat -> List Nat -> Bool
  same-nat-list a b = case a of
    [] -> case b of [] -> True; other -> False
    x : xs -> case b of y : ys -> x == y && same-nat-list xs ys; [] -> False
  self-loop-result :: List CoreDefinition -> String -> List Nat -> List String -> String -> List Local -> List Local -> Writer -> String -> CoreTerm -> Writer
  self-loop-result definitions self classes param-llvms result locals roots w failed term = case term of
    CIf sp ty test yes no -> case expression definitions locals w test of
      (tested, condition) ->
        let (one, otherwise) = fresh tested "tailno" in
        let selected = continue-if one condition otherwise in
        let first = self-loop-result definitions self classes param-llvms result locals roots selected failed yes in
        self-loop-result definitions self classes param-llvms result locals roots (line first (cat [otherwise, ":"])) failed no
    CGuard sp ty condition body -> if core-alternative-covers term then
      self-loop-result definitions self classes param-llvms result locals roots w failed body
      else (case expression definitions locals w condition of
        (ready, value) -> self-loop-result definitions self classes param-llvms result locals roots (continue-if ready value failed) failed body)
    CLet sp ty id name sc rhs body -> case scheme-params sc of
      [] -> if scheme-supported (w.context) sc && word-type (w.context) (scheme-body sc) then
        (case expression definitions locals w rhs of
          (ready, value) ->
            let bound = Local id (scheme-body sc) value in
            let scoped = bound : locals in
            let owned = (Discard (scheme-body sc) value) : roots in
            let (one, cleanup) = fresh ready "tailcleanup" in
            let emitted = self-loop-result definitions self classes param-llvms result scoped owned one cleanup body in
            let released = count-op False (scheme-body sc) value (line emitted (cat [cleanup, ":"])) in
            line released (cat ["  br label %", failed]))
        else self-loop-return definitions result locals roots w failed term
      other -> self-loop-return definitions result locals roots w failed term
    CRequire sp ty body -> self-loop-result definitions self classes param-llvms result locals roots w failed body
    CProved sp ty ev body -> self-loop-result definitions self classes param-llvms result locals roots w failed body
    CRefine sp ty ev body -> self-loop-result definitions self classes param-llvms result locals roots w failed body
    CRefineProof sp ty witness body -> self-loop-result definitions self classes param-llvms result locals roots w failed body
    CDischarge sp ty ev _ body -> self-loop-result definitions self classes param-llvms result locals roots w failed body
    CForget sp ty body -> self-loop-result definitions self classes param-llvms result locals roots w failed body
    CCast sp ty body -> self-loop-result definitions self classes param-llvms result locals roots w failed body
    other -> case self-loop-call-args self classes (list-length param-llvms) w term of
      Some args -> case tail-operands definitions locals roots [] w args of
        (evaluated, values, remaining) ->
          let ready = drop-locals remaining evaluated in
          line (store-typed-loop-args param-llvms values 0 ready) "  br label %self.loop"
      None -> self-loop-return definitions result locals roots w failed term
  self-loop-return :: List CoreDefinition -> String -> List Local -> List Local -> Writer -> String -> CoreTerm -> Writer
  self-loop-return definitions result locals roots w failed body = case worker-result definitions locals roots w failed body of
    (done, word) -> line done (cat ["  ret ", result, " ", word])
  -- | Companion CPR unboxed product analysis and lowering ({ i64, i64 }, { i128, i128 }, etc.).
  cpr-words :: List Nat -> Nat
  cpr-words codes = case codes of
    [] -> 0
    c : rest -> (if c == 3 then 2 else 1) + cpr-words rest
  cpr-agg-type :: List String -> String
  cpr-agg-type llvms = cat ["{ ", join llvms, " }"]
  cpr-term-ctor :: CoreTerm -> Option (String, List CoreTerm)
  cpr-term-ctor term = case term of
    CIf sp ty test yes no -> cpr-merge-ctor (cpr-term-ctor yes) (cpr-term-ctor no)
    CCase sp ty value alts -> cpr-alts-ctor alts
    CGuard sp ty cond body -> cpr-term-ctor body
    CLet sp ty id name sc rhs body -> cpr-term-ctor body
    CRequire sp ty body -> cpr-term-ctor body
    CProved sp ty ev body -> cpr-term-ctor body
    CRefine sp ty ev body -> cpr-term-ctor body
    CRefineProof sp ty witness body -> cpr-term-ctor body
    CDischarge sp ty ev _ body -> cpr-term-ctor body
    CForget sp ty body -> cpr-term-ctor body
    CCast sp ty body -> cpr-term-ctor body
    other -> case erased-constructor-call term [] of
      Some (name, actuals, args) -> Some (name, args)
      None -> None
  cpr-merge-ctor :: Option (String, List CoreTerm) -> Option (String, List CoreTerm) -> Option (String, List CoreTerm)
  cpr-merge-ctor a b = case a of
    Some (na, aa) -> case b of
      Some (nb, ab) -> if na == nb && list-length aa == list-length ab then Some (na, aa) else None
      None -> None
    None -> None
  cpr-alts-ctor :: CoreTerm -> Option (String, List CoreTerm)
  cpr-alts-ctor alts = case alts of
    CAlternative sp pat body (CAlternativesEnd end) -> cpr-term-ctor body
    CAlternative sp pat body rest -> cpr-merge-ctor (cpr-term-ctor body) (cpr-alts-ctor rest)
    other -> None
  cpr-clauses-ctor :: List CoreClause -> Option (String, List CoreTerm)
  cpr-clauses-ctor clauses = case clauses of
    [CoreClause sp pats body] -> cpr-term-ctor body
    (CoreClause sp pats body) : rest -> cpr-merge-ctor (cpr-term-ctor body) (cpr-clauses-ctor rest)
    [] -> None
  cpr-plan :: Writer -> CoreDefinition -> List Nat -> Option (String, List Nat, List String)
  cpr-plan w d classes = case definition-context d classes w of
    None -> None
    Some ctx ->
      let scoped = (case ctx of RuntimeContext datas bounds rigids queue inlining -> with-representations bounds rigids w) in
      if not (scheme-supported (scoped.context) (d.scheme)) then None
      else if list-length (runtime-givens scoped d) /= 0 || list-length (definition-value-dependencies scoped d) /= 0 || list-length (d.openings) /= 0 then None
      else case d.clauses of
        (CoreClause at patterns body) : rest ->
          if list-length (proof-stage-arities patterns 0) /= 1 || list-length (runtime-parameters patterns) == 0 then None
          else (case cpr-clauses-ctor (d.clauses) of
            None -> None
            Some (ctor, sample-args) -> case constructor ctor (writer-program scoped) of
              Some (owner, tag, c) -> case data-declaration owner (writer-program scoped) of
                Some dd ->
                  let uniform = (case core-data-layout dd of UniformData -> True; other -> False) in
                  let n = list-length sample-args in
                  if uniform && list-length (core-data-constructors dd) == 1 && n == list-length (core-constructor-fields c) && n >= 1 && n <= 3 then
                    (case class-vector (scoped.context) (term-types sample-args) of
                      Some fclasses ->
                        if val-code classes || val-code fclasses then None else
                        let maxw = if wide-code fclasses then (4 :: Nat) else 3 in
                        if cpr-words fclasses <= maxw then
                          Some (ctor, fclasses, value-llvms (scoped.context) (term-types sample-args))
                        else None
                      None -> None)
                  else None
                None -> None
              None -> None)
        [] -> None
  cpr-emit-extract :: Writer -> String -> String -> List String -> Nat -> (Writer, List String)
  cpr-emit-extract w agg-ty agg llvms index = case llvms of
    [] -> (w, [])
    ty : rest ->
      let (w1, v) = fresh w "%cpr" in
      let w2 = line w1 (cat ["  ", v, " = extractvalue ", agg-ty, " ", agg, ", ", nat-to-string index]) in
      case cpr-emit-extract w2 agg-ty agg rest (index + 1) of
        (w3, more) -> (w3, v : more)
  cpr-emit-insert :: Writer -> String -> String -> List (String, String) -> Nat -> (Writer, String)
  cpr-emit-insert w agg-ty acc typed index = case typed of
    [] -> (w, acc)
    (ty, val) : rest ->
      let (w1, next) = fresh w "%cpr" in
      let w2 = line w1 (cat ["  ", next, " = insertvalue ", agg-ty, " ", acc, ", ", ty, " ", val, ", ", nat-to-string index]) in
      cpr-emit-insert w2 agg-ty next rest (index + 1)
  cpr-release-fields :: List Nat -> List String -> Writer -> Writer
  cpr-release-fields classes words w = case classes of
    [] -> w
    c : cs -> case words of word : ws -> cpr-release-fields cs ws (if c == 1 || c == 2 then count-line False word w else w); [] -> w
  fold-cpr-case :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> CoreTerm -> Option (Writer, String)
  fold-cpr-case definitions locals w value alternatives = case call-spine value [] of
    Some (name, actuals, args) -> case worker-definition name w of
      Some d -> if list-length args /= list-length (definition-parameters d) then None else
        (case source-scheme-classes (w.context) (scheme-params (d.scheme)) actuals of
          Some classes -> case cpr-plan w d classes of
            Some (ctor, fclasses, fllvms) -> case fold-alternatives alternatives ctor (list-length fclasses) of
              FoldCase fields body -> if row-guarded body then None else
                let agg-ty = cpr-agg-type fllvms in
                let cpr-sym = symbol (cat [specialized-name name classes, "#cpr"]) in
                let arg-llvms = value-llvms (w.context) (term-types args) in
                (case expressions definitions locals (request-demand (CprDemand name classes) w) args of
                  (evaluated, arg-words) -> case typed-call evaluated agg-ty cpr-sym (typed-values arg-llvms arg-words) of
                    (called, agg) -> case cpr-emit-extract called agg-ty agg fllvms 0 of
                      (extracted, fwords) -> case expression definitions (fold-field-locals fields fwords <> locals) extracted body of
                        (done, result) -> Some (cpr-release-fields fclasses fwords done, result))
              other -> None
            None -> None
          None -> None)
      None -> None
    None -> None
  cpr-worker :: List CoreDefinition -> String -> List Nat -> Writer -> Writer
  cpr-worker definitions name classes w = case worker-definition name w of
    None -> refuse w (Span 0 0 1 1) "CPR worker definition is absent"
    Some d -> case class-bindings (scheme-params (d.scheme)) classes of
      None -> refuse w (Span 0 0 1 1) "CPR worker needs representation classes"
      Some bounds -> case definition-rigids d bounds of
        None -> refuse w (Span 0 0 1 1) "CPR worker openings are invalid"
        Some rigids -> let scoped = with-representations bounds rigids w in
          case cpr-plan scoped d classes of
            None -> refuse scoped (Span 0 0 1 1) "CPR worker lost its checked product plan"
            Some (ctor, fclasses, fllvms) -> case d.clauses of
              (CoreClause at patterns body) : rest ->
                let parameters = runtime-parameters patterns in
                let types = pattern-types parameters in
                let roots = parameter-roots parameters 0 in
                let prefix = self-binding scoped d classes in
                let agg-ty = cpr-agg-type fllvms in
                let cpr-name = cat [specialized-name name classes, "#cpr"] in
                let params = typed-arguments (typed-values (value-llvms (scoped.context) types) (value-parameters (list-length parameters) 0)) in
                let started = line (line scoped (cat ["define private ", agg-ty, " ", symbol cpr-name, "(", join params, ")", llvm-hint scoped name, worker-open scoped])) "entry:" in
                line (cpr-clauses definitions ctor fllvms agg-ty prefix roots (d.clauses) started) "}"
              [] -> refuse scoped (Span 0 0 1 1) "CPR worker has no clauses"
  cpr-clauses :: List CoreDefinition -> String -> List String -> String -> List Local -> List Local -> List CoreClause -> Writer -> Writer
  cpr-clauses definitions ctor fllvms agg-ty prefix roots clauses w = case clauses of
    [] -> line w "  unreachable"
    (CoreClause sp patterns body) : rest ->
      let (one, failed) = fresh w "nextcpreq" in
      case match-clause patterns body prefix 0 failed one of
        (matched, bindings, rebuilt) ->
          let done = cpr-result definitions ctor fllvms agg-ty (bindings <> prefix) roots matched failed rebuilt in
          cpr-clauses definitions ctor fllvms agg-ty prefix roots rest (line done (cat [failed, ":"]))
  cpr-result :: List CoreDefinition -> String -> List String -> String -> List Local -> List Local -> Writer -> String -> CoreTerm -> Writer
  cpr-result definitions ctor fllvms agg-ty locals roots w failed term = case term of
    CIf sp ty test yes no -> case expression definitions locals w test of
      (tested, condition) ->
        let (one, otherwise) = fresh tested "cprno" in
        let selected = continue-if one condition otherwise in
        let first = cpr-result definitions ctor fllvms agg-ty locals roots selected failed yes in
        cpr-result definitions ctor fllvms agg-ty locals roots (line first (cat [otherwise, ":"])) failed no
    CCase sp ty value alts -> case parameter-value locals roots value of
      Some (word, remaining) -> cpr-case-chain definitions ctor fllvms agg-ty locals remaining w (core-type value) word True alts
      None -> case borrowed-local-word locals value of
        Some word -> cpr-case-chain definitions ctor fllvms agg-ty locals roots w (core-type value) word False alts
        None -> case expression definitions locals w value of
          (ready, word) -> cpr-case-chain definitions ctor fllvms agg-ty locals roots ready (core-type value) word True alts
    CGuard sp ty condition body -> if core-alternative-covers term then
      cpr-result definitions ctor fllvms agg-ty locals roots w failed body
      else (case expression definitions locals w condition of
        (ready, value) -> cpr-result definitions ctor fllvms agg-ty locals roots (continue-if ready value failed) failed body)
    CLet sp ty id name sc rhs body -> case scheme-params sc of
      [] -> if scheme-supported (w.context) sc && word-type (w.context) (scheme-body sc) then
        (case expression definitions locals w rhs of
          (ready, value) ->
            let bound = Local id (scheme-body sc) value in
            let scoped = bound : locals in
            let owned = (Discard (scheme-body sc) value) : roots in
            let (one, cleanup) = fresh ready "cprcleanup" in
            let emitted = cpr-result definitions ctor fllvms agg-ty scoped owned one cleanup body in
            let released = count-op False (scheme-body sc) value (line emitted (cat [cleanup, ":"])) in
            line released (cat ["  br label %", failed]))
        else line (refuse w sp "CPR worker let needs monomorphic representation") "  unreachable"
      other -> line (refuse w sp "CPR worker let cannot be polymorphic") "  unreachable"
    CRequire sp ty body -> cpr-result definitions ctor fllvms agg-ty locals roots w failed body
    CProved sp ty ev body -> cpr-result definitions ctor fllvms agg-ty locals roots w failed body
    CRefine sp ty ev body -> cpr-result definitions ctor fllvms agg-ty locals roots w failed body
    CRefineProof sp ty witness body -> cpr-result definitions ctor fllvms agg-ty locals roots w failed body
    CDischarge sp ty ev _ body -> cpr-result definitions ctor fllvms agg-ty locals roots w failed body
    CForget sp ty body -> cpr-result definitions ctor fllvms agg-ty locals roots w failed body
    CCast sp ty body -> cpr-result definitions ctor fllvms agg-ty locals roots w failed body
    other -> case erased-constructor-call term [] of
      Some (cname, actuals, args) | (cname == ctor) ->
        case expressions definitions locals w args of
          (evaluated, vals) ->
            let dropped = drop-locals roots evaluated in
            case cpr-emit-insert dropped agg-ty "poison" (typed-values fllvms vals) 0 of
              (built, agg) -> line built (cat ["  ret ", agg-ty, " ", agg])
      other -> line (refuse w (Span 0 0 1 1) "CPR worker leaf disagrees with product constructor") "  unreachable"
  cpr-case-chain :: List CoreDefinition -> String -> List String -> String -> List Local -> List Local -> Writer -> UType -> String -> Bool -> CoreTerm -> Writer
  cpr-case-chain definitions ctor fllvms agg-ty locals roots w ty value drop-scrut alts = case alts of
    CAlternativesEnd end -> line w "  unreachable"
    CAlternative sp pattern body rest ->
      let (one, failed) = fresh w "nextcpralt" in
      case match-alternative pattern body locals value failed one of
        (matched, bindings, rebuilt) ->
          let owned = if drop-scrut then (Discard ty value) : roots else roots in
          let done = cpr-result definitions ctor fllvms agg-ty (bindings <> locals) owned matched failed rebuilt in
          cpr-case-chain definitions ctor fllvms agg-ty locals roots (line done (cat [failed, ":"])) ty value drop-scrut rest
    other -> line (refuse w (Span 0 0 1 1) "malformed case alternative spine in CPR worker") "  unreachable"
  worker-clauses-sret :: List CoreDefinition -> List Local -> List Local -> Nat -> Nat -> Nat -> List CoreClause -> Writer -> Writer
  worker-clauses-sret definitions prefix roots offset sz al clauses w = case clauses of
    [] -> line w "  unreachable"
    (CoreClause sp patterns body) : rest ->
      let (one, failed) = fresh w "nexteq" in
      case match-clause patterns body prefix offset failed one of
        (matched, bindings, rebuilt) -> case worker-result definitions (bindings <> prefix) roots matched failed rebuilt of
          (done, result) ->
            let w1 = request-demand MemcpyDemand done in
            let copied = line w1 (cat ["  call void @llvm.memcpy.p0.p0.i64(ptr align ", nat-to-string al, " %sret, ptr align ", nat-to-string al, " ", result, ", i64 ", nat-to-string sz, ", i1 false)"]) in
            let returned = line copied "  ret void" in
            worker-clauses-sret definitions prefix roots offset sz al rest (line returned (cat [failed, ":"]))

  proof-worker-stages :: List CoreDefinition -> List Nat -> CoreDefinition -> List Local -> List Local -> Nat -> List UType -> List Nat -> Nat -> Writer -> Writer
  proof-worker-stages definitions classes d prefix roots offset types arities rung w = case arities of
    [] -> refuse w (Span 0 0 1 1) "runtime function has no checked proof stage"
    count : rest ->
      let name = proof-stage-name (specialized-name (d.name) classes) rung in
      let sret-opt = (case rest of [] -> definition-sret-result (w.context) d; other -> None) in
      let result = (case (rest, sret-opt) of ([], Some info) -> "void"; ([], None) -> definition-result-llvm (w.context) d; other -> "i64") in
      let base-params = typed-arguments (typed-values (value-param-llvms (w.context) (take-types count types)) (value-parameters count 0)) in
      let parameters = (case sret-opt of Some (sret-attr, sz, al) -> (cat [sret-attr, " %sret"]) : base-params; None -> base-params) in
      let started = line (line w (cat ["define ", worker-linkage w name, result, " ", symbol name, "(", join parameters, ")", llvm-hint w (d.name), worker-open w])) "entry:" in
      (case (rest, sret-opt) of
        ([], Some (sret-attr, sz, al)) ->
          line (worker-clauses-sret definitions prefix roots offset sz al (d.clauses) started) "}"
        ([], None) ->
          if rung == 0 && worker-uses-arena (d.name) started then
            let entered = line started "  %arena.phase = call i64 @cinch_arena_enter_phase(i64 4096)" in
            line (worker-clauses-arena definitions prefix roots offset (Some "%arena.phase") (d.clauses) entered) "}"
          else line (worker-clauses definitions prefix roots offset (d.clauses) started) "}"
        (next-count : more, other) -> if wide-type (started.context) (final-result (scheme-body (d.scheme))) then refuse started (Span 0 0 1 1) wide-refusal else
          case class-vector (started.context) (take-types next-count types) of

          None -> refuse started (Span 0 0 1 1) "proof continuation needs checked runtime parameter representations"
          Some next-classes ->
            let ret-class = (case word-class (started.context) (final-result (scheme-body (d.scheme))) of Some c -> c; None -> 0) in
            case closure-with (Span 0 0 1 1) (proof-stage-name (specialized-name (d.name) classes) (rung + 1)) next-classes ret-class (take-types count types) (value-parameters count 0) started of
            (ready, result) -> let returned = line (line ready (cat ["  ret i64 ", result])) "}" in
              proof-worker-stages definitions classes d prefix roots offset types rest (rung + 1) returned)
  value-parameters :: Nat -> Nat -> List String
  value-parameters count index = if count == 0 then [] else (cat ["%arg", nat-to-string index]) : (value-parameters (count - 1) (index + 1))
  constructor-worker :: String -> List Nat -> Writer -> Writer
  constructor-worker name classes w = case constructor name (writer-program w) of
    Some (owner, tag, c) -> case data-declaration owner (writer-program w) of
      Some d | unboxed-owner owner w -> let worker = specialized-name name classes in
        emit-lines w [cat ["define ", worker-linkage w worker, "i64 ", symbol worker, "(i64 %arg0)", worker-open w], "entry:", "  ret i64 %arg0", "}"]
      Some d -> case constructor-call-context d c classes w of
        Some context -> case context of
          RuntimeContext datas bounds rigids queue inlining ->
            let scoped = with-representations bounds rigids w in
            let fields = core-constructor-fields c in
            let count = list-length fields in
            let values = value-parameters count 0 in
            let typed = typed-values (value-param-llvms context fields) values in
            if regular-constructor d c then
              case request-data (Span 0 0 1 1) d classes scoped of
                (planned, descriptor) ->
                  let started = line (line planned (cat ["define ", worker-linkage planned (specialized-name name classes), "i64 ", symbol (specialized-name name classes), "(", join (typed-arguments typed), ")", worker-open w])) "entry:" in
                  case allocate-constructor-fields d started (data-descriptor descriptor tag) fields values of
                    (allocated, result) -> line (line allocated (cat ["  ret i64 ", result])) "}"
            else
              case class-vector context (storage-fields d c) of
                None -> refuse scoped (Span 0 0 1 1) "constructor field representation is unknown"
                Some codes ->
                  let desc = shape-description 1 tag (word-codes codes) in
                  let started = line (line scoped (cat ["define ", worker-linkage scoped (specialized-name name classes), "i64 ", symbol (specialized-name name classes), "(", join (typed-arguments typed), ")", worker-open w])) "entry:" in
                  case allocate-constructor-fields d started desc fields values of
                    (allocated, result) -> line (line allocated (cat ["  ret i64 ", result])) "}"
        None -> refuse w (Span 0 0 1 1) "constructor worker needs representation specialization"
      None -> refuse w (Span 0 0 1 1) "constructor worker has no defining data"
    None -> refuse w (Span 0 0 1 1) "constructor worker has no checked constructor"
  lambda-worker :: List CoreDefinition -> String -> List (Nat, Nat) -> List (Nat, Nat) -> List Local -> CorePattern -> CoreTerm -> Writer -> Writer
  lambda-worker definitions name bounds rigids saved parameter body w =
    let scoped = with-representations bounds rigids w in
    if not (word-type (scoped.context) (core-type body)) then refuse scoped (Span 0 0 1 1) "lambda result needs a checked runtime representation" else
      let types = capture-types saved in
      let offset = list-length types in
      let param-types = if erased-pattern parameter then types else types <> [pattern-type parameter] in
      let base-params = typed-arguments (typed-values (value-param-llvms (scoped.context) param-types) (value-parameters (list-length param-types) 0)) in
      let sret-opt = value-sret-info (scoped.context) (core-type body) in
      let ret-llvm = (case sret-opt of Some info -> "void"; None -> value-llvm (scoped.context) (core-type body)) in
      let full-params = (case sret-opt of Some (sret-attr, sz, al) -> (cat [sret-attr, " %sret"]) : base-params; None -> base-params) in
      let started = line (line scoped (cat ["define ", worker-linkage w name, ret-llvm, " ", symbol name, "(", join full-params, ")", worker-open w])) "entry:" in
      if erased-pattern parameter then
        (case expression definitions (captured-bindings saved 0) started body of
          (done, result) ->
            let cleaned = drop-locals (capture-roots types 0) done in
            case sret-opt of
              Some (sret-attr, sz, al) ->
                let w1 = request-demand MemcpyDemand cleaned in
                let copied = line w1 (cat ["  call void @llvm.memcpy.p0.p0.i64(ptr align ", nat-to-string al, " %sret, ptr align ", nat-to-string al, " ", result, ", i64 ", nat-to-string sz, ", i1 false)"]) in
                line (line copied "  ret void") "}"
              None -> line (line cleaned (cat ["  ret ", value-llvm (cleaned.context) (core-type body), " ", result])) "}")
      else
        let roots = capture-roots types 0 <> parameter-roots [parameter] offset in
        case sret-opt of
          Some (sret-attr, sz, al) ->
            line (worker-clauses-sret definitions (captured-bindings saved 0) roots offset sz al [CoreClause (Span 0 0 1 1) [parameter] body] started) "}"
          None ->
            line (worker-clauses definitions (captured-bindings saved 0) roots offset [CoreClause (Span 0 0 1 1) [parameter] body] started) "}"
  recursive-width :: List RecursiveWorker -> Nat
  recursive-width group = case group of
    [] -> 0
    (RecursiveWorker id ty name patterns body) : rest ->
      let arity = list-length (runtime-parameters patterns) in
      let remaining = recursive-width rest in
      if arity > remaining then arity else remaining

  tail-worker-name :: String -> String
  tail-worker-name name = cat [name, "#tail"]

  padding-words :: Nat -> List String
  padding-words count = if count == 0 then [] else "0" : (padding-words (count - 1))

  recursive-target :: List RecursiveWorker -> Nat -> Nat -> Option String
  recursive-target group id arity = case group of
    [] -> None
    (RecursiveWorker member ty name patterns body) : rest -> if member == id then
      (if arity == list-length (runtime-parameters patterns) then Some (tail-worker-name name) else None)
      else recursive-target rest id arity

  recursive-call :: List RecursiveWorker -> CoreTerm -> Option (String, List CoreTerm)
  recursive-call group term = case term of
    CErasedApply sp ty row (CLocal at function id name []) witness -> case recursive-target group id 0 of
      Some callee -> Some (callee, [])
      None -> None
    other -> case head term of
      CLocal at function id name [] -> case arguments term [] of
        [] -> None
        args -> case recursive-target group id (list-length args) of
          Some callee -> Some (callee, args)
          None -> None
      other -> None

  -- A direct call transfers its new arguments and captures before it
  -- releases this frame's roots. LLVM requires the following ret.
  transfer-tail-call :: List CoreDefinition -> List Local -> List Local -> List Local -> Nat -> Writer -> String -> List CoreTerm -> Writer
  transfer-tail-call definitions locals roots saved width w callee args = transfer-tail-prefix definitions locals roots saved width w callee [] args None []

  -- | Transfer checked evidence before positional arguments, retaining all values
  -- until this frame's roots have been released. Captures remain the local worker prefix.
  -- Once preceding arguments have been evaluated, the last call operand
  -- can consume a frame owner directly. Saved captures are read afterwards.
  word-aliases-unused :: String -> List Local -> List CoreTerm -> Bool
  word-aliases-unused word locals terms = case locals of
    [] -> True
    (Local id ty w) : rest -> (w /= word || not (term-local-use-any id terms)) && word-aliases-unused word rest terms
    (Borrowed id ty w) : rest -> (w /= word || not (term-local-use-any id terms)) && word-aliases-unused word rest terms
    other : rest -> word-aliases-unused word rest terms
  tail-operands :: List CoreDefinition -> List Local -> List Local -> List Local -> Writer -> List CoreTerm -> (Writer, List String, List Local)
  tail-operands definitions locals roots saved w args = case args of
    [] -> (w, [], roots)
    arg : rest -> case saved of
      [] -> case rest of
        [] -> (case move-field definitions locals w arg of
          Some input -> (case take-parameter-root (input.word) roots of
            Some remaining -> (case evaluate-move input w of (done, value) -> (done, [value], remaining))
            None -> (case expression definitions locals w arg of (done, value) -> (done, [value], roots)))
          None -> (case expression definitions locals w arg of (done, value) -> (done, [value], roots)))
        more -> (case arg of
          CLocal sp ty id name [] -> case local id locals of
            Some (decl, word) -> if word-aliases-unused word locals more then
              (case take-parameter-root word roots of
                Some remaining -> case tail-operands definitions locals remaining [] w more of
                  (done, values, final-roots) -> (done, word : values, final-roots)
                None -> case expression definitions locals w arg of
                  (ready, value) -> case tail-operands definitions locals roots [] ready more of
                    (done, values, remaining) -> (done, value : values, remaining))
              else (case expression definitions locals w arg of
                (ready, value) -> case tail-operands definitions locals roots [] ready more of
                  (done, values, remaining) -> (done, value : values, remaining))
            None -> case expression definitions locals w arg of
              (ready, value) -> case tail-operands definitions locals roots [] ready more of
                (done, values, remaining) -> (done, value : values, remaining)
          other -> case expression definitions locals w arg of
            (ready, value) -> case tail-operands definitions locals roots [] ready more of
              (done, values, remaining) -> (done, value : values, remaining))
      other -> case expression definitions locals w arg of
        (ready, value) -> case tail-operands definitions locals roots saved ready rest of
          (done, values, remaining) -> (done, value : values, remaining)
  tail-borrow-operands :: List CoreDefinition -> List Local -> List Local -> Writer -> List CoreTerm -> List Bool -> (Writer, List String, List Local)
  tail-borrow-operands definitions locals roots w args mask = case args of
    [] -> (w, [], roots)
    arg : rest -> case mask of
      True : more -> case borrowed-local-word locals arg of
        Some word -> case tail-borrow-operands definitions locals roots w rest more of
          (done, values, remaining) -> (done, word : values, remaining)
        None -> case expression definitions locals w arg of
          (ready, value) -> case tail-borrow-operands definitions locals roots ready rest more of
            (done, values, remaining) -> (done, value : values, remaining)
      False : more -> case arg of
        CLocal sp ty id name [] -> case local id locals of
          Some (decl, word) -> if word-aliases-unused word locals rest then
            (case take-parameter-root word roots of
              Some remaining -> case tail-borrow-operands definitions locals remaining w rest more of
                (done, values, final-roots) -> (done, word : values, final-roots)
              None -> case expression definitions locals w arg of
                (ready, value) -> case tail-borrow-operands definitions locals roots ready rest more of
                  (done, values, remaining) -> (done, value : values, remaining))
            else (case expression definitions locals w arg of
              (ready, value) -> case tail-borrow-operands definitions locals roots ready rest more of
                (done, values, remaining) -> (done, value : values, remaining))
          None -> case expression definitions locals w arg of
            (ready, value) -> case tail-borrow-operands definitions locals roots ready rest more of
              (done, values, remaining) -> (done, value : values, remaining)
        other -> case expression definitions locals w arg of
          (ready, value) -> case tail-borrow-operands definitions locals roots ready rest more of
            (done, values, remaining) -> (done, value : values, remaining)
      [] -> case expression definitions locals w arg of
        (ready, value) -> case tail-borrow-operands definitions locals roots ready rest [] of
          (done, values, remaining) -> (done, value : values, remaining)

  transfer-tail-prefix :: List CoreDefinition -> List Local -> List Local -> List Local -> Nat -> Writer -> String -> List String -> List CoreTerm -> Option (String, String) -> List Bool -> Writer
  transfer-tail-prefix definitions locals roots saved width w callee prefix args loop mask =
    let evaled = if any-borrowed mask then tail-borrow-operands definitions locals roots w args mask
          else tail-operands definitions locals roots saved w args in
    case evaled of
      (evaluated, values, remaining) -> case capture-values saved evaluated of
        (copied, captures) ->
          let count = list-length prefix + list-length values in
          if count <= width then
            let passed = captures <> prefix <> values <> padding-words (width - count) in
            let ready = drop-locals remaining copied in
            (case loop of
              Some (self, metadata) | (self == callee) ->
                let back = if metadata == "" then "  br label %self.loop" else "  br label %self.loop, !llvm.loop " <> metadata in
                line (store-loop-arguments passed 0 ready) back
              other -> let (next, result) = fresh ready "%v" in
                line (line next (cat ["  ", result, " = musttail call i64 ", symbol callee, "(", join (argument-words passed), ")"])) (cat ["  ret i64 ", result]))
          else refuse copied (Span 0 0 1 1) "tail call exceeds its checked worker width"

  -- Only source workers in the same direct tail cycle share a prototype.
  -- A call that crosses an object boundary keeps the checked public ABI.
  global-tail-call :: List CoreDefinition -> Nat -> Writer -> CoreTerm -> Option (String, List Nat, List CoreEvidence, List CoreTerm)
  global-tail-call definitions group w term = case head term of
    CUse sp ty name role actuals | role /= "foreign" -> global-tail-target definitions group w name actuals [] (arguments term [])
    CQualifiedUse sp ty name role actuals evidence -> global-tail-target definitions group w name actuals evidence (arguments term [])
    other -> None

  -- | Admit a source tail edge only when both its evidence and ordinary arguments
  -- saturate the same checked worker. Wide specializations retain their ordinary ABI.
  global-tail-target :: List CoreDefinition -> Nat -> Writer -> String -> List UType -> List CoreEvidence -> List CoreTerm -> Option (String, List Nat, List CoreEvidence, List CoreTerm)
  global-tail-target definitions group w name actuals evidence args = case hash-map-lookup name ((writer-program w).tail-groups) of
    Some (callee, width) -> if callee == group then
      (case worker-definition name w of
        Some d -> if list-length args == list-length (definition-parameters d) && list-length evidence == list-length (runtime-givens w d) then
          (case source-scheme-classes (w.context) (scheme-params (d.scheme)) actuals of
            Some classes -> if wide-code classes then None else Some (name, classes, evidence, args)
            None -> None)
          else None
        None -> None)
      else None
    None -> None

  tail-result :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> String -> CoreTerm -> Writer
  tail-result definitions locals roots context w failed term = case term of
    CIf sp ty test yes no -> case expression definitions locals w test of
      (tested, condition) ->
        let (one, otherwise) = fresh tested "tailno" in
        let selected = continue-if one condition otherwise in
        let first = tail-result definitions locals roots context selected failed yes in
        tail-result definitions locals roots context (line first (cat [otherwise, ":"])) failed no
    CCase sp ty value alternatives -> case parameter-value locals roots value of
      Some (word, remaining) -> tail-rows definitions locals remaining context w (core-type value) word True alternatives
      None -> case borrowed-local-word locals value of
        Some word -> tail-rows definitions locals roots context w (core-type value) word False alternatives
        None -> case expression definitions locals w value of
          (ready, word) -> tail-rows definitions locals roots context ready (core-type value) word True alternatives
    CGuard sp ty condition body -> if core-alternative-covers term then
      tail-result definitions locals roots context w failed body
      else (case expression definitions locals w condition of
        (ready, value) -> tail-result definitions locals roots context (continue-if ready value failed) failed body)
    CLet sp ty id name sc rhs body -> case fuse-scoped-call definitions w term of
      Some fused -> tail-result definitions locals roots context w failed fused
      None -> case scheme-params sc of
        [] -> if scheme-supported (w.context) sc && word-type (w.context) (scheme-body sc) then
          (case expression definitions locals w rhs of
            (ready, value) ->
              let bound = Local id (scheme-body sc) value in
              tail-binding definitions locals roots context ready failed bound (scheme-body sc) value body)
          else tail-return definitions locals roots w failed term
        other -> if local-function-value rhs && (case scheme-requirements sc of [] -> True; other -> False) then
          tail-result definitions locals roots context w failed (specialize-local id sc rhs body)
          else (case bundled-let sp id sc rhs body of
            Some bundled -> tail-result definitions locals roots context w failed bundled
            None -> tail-return definitions locals roots w failed term)
    CWith sp ty given value body -> case expression definitions locals w value of
      (ready, word) ->
        let bound = GivenLocal (given.symbol) (given.ty) word in
        tail-binding definitions locals roots context ready failed bound (given.ty) word body
    CRequire sp ty body -> tail-result definitions locals roots context w failed body
    CProved sp ty evidence body -> tail-result definitions locals roots context w failed body
    CRefine sp ty evidence body -> tail-result definitions locals roots context w failed body
    CRefineProof sp ty witness body -> tail-result definitions locals roots context w failed body
    CDischarge sp ty evidence _ body -> tail-result definitions locals roots context w failed body
    CForget sp ty body -> case parameter-value locals roots term of
      Some (word, remaining) -> line (drop-locals remaining w) (cat ["  ret i64 ", word])
      None -> tail-result definitions locals roots context w failed body
    CCast sp ty body -> case parameter-value locals roots term of
      Some (word, remaining) -> line (drop-locals remaining w) (cat ["  ret i64 ", word])
      None -> tail-result definitions locals roots context w failed body
    other -> case context of
      LocalTail group saved width -> case recursive-call group term of
        Some (callee, args) -> transfer-tail-call definitions locals roots saved width w callee args
        None -> tail-return definitions locals roots w failed term
      GlobalTail group width loop mask -> case global-tail-call definitions group w term of
        Some (name, classes, evidence, args) ->
          if any-borrowed mask then
            let bcallee = cat [specialized-name name classes, "#b"] in
            (case evidence of
              [] -> case loop of
                Some (self-name, meta) | (self-name == bcallee) ->
                  transfer-tail-prefix definitions locals roots [] width w bcallee [] args loop mask
                other -> tail-return definitions locals roots w failed term
              other -> tail-return definitions locals roots w failed term)
          else
            (case evidences definitions locals (demand-worker name classes w) evidence of
              (ready, prefix) -> transfer-tail-prefix definitions locals roots [] width ready (tail-worker-name (specialized-name name classes)) prefix args loop [])
        None -> tail-return definitions locals roots w failed term

  tail-return :: List CoreDefinition -> List Local -> List Local -> Writer -> String -> CoreTerm -> Writer
  tail-return definitions locals roots w failed body = case worker-result definitions locals roots w failed body of
    (done, word) -> line done (cat ["  ret i64 ", word])

  tail-binding :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> String -> Local -> UType -> String -> CoreTerm -> Writer
  tail-binding definitions locals roots context w failed bound ty word body =
    let scoped = bound : locals in
    let owned = (Discard ty word) : roots in
    let (one, cleanup) = fresh w "tailcleanup" in
    let emitted = tail-result definitions scoped owned context one cleanup body in
    let released = count-op False ty word (line emitted (cat [cleanup, ":"])) in
    line released (cat ["  br label %", failed])

  tail-rows :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> Bool -> CoreTerm -> Writer
  tail-rows definitions locals roots context w ty value drop-scrut alternatives =
    let (one, base) = fresh w "alt" in
    case case-dispatch one alternatives base of
      HeaderDispatch entries -> tail-switch definitions locals roots context one ty value drop-scrut True base entries alternatives
      ImmediateDispatch entries -> tail-switch definitions locals roots context one ty value drop-scrut False base entries alternatives
      ChainDispatch -> tail-chain definitions locals roots context one ty value drop-scrut alternatives
  -- The tail case dispatches once too: an arm returns from its own block, so
  -- an unmatched tag reaches the default arm, or no continuation at all.
  tail-switch :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> Bool -> Bool -> String -> String -> CoreTerm -> Writer
  tail-switch definitions locals roots context w ty value drop-scrut header base entries alternatives =
    let (one, missed) = fresh w "tailmiss" in
    if header then (case constructor-tag w value of
      (loaded, tag) -> tail-switch-arms definitions locals roots context (line loaded (cat ["  switch i64 ", tag, ", label %", missed, " [", entries, "\n]"])) ty value drop-scrut base missed alternatives 0 False)
    else tail-switch-arms definitions locals roots context (line w (cat ["  switch i64 ", value, ", label %", missed, " [", entries, "\n]"])) ty value drop-scrut base missed alternatives 0 False
  tail-switch-arms :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> Bool -> String -> String -> CoreTerm -> Nat -> Bool -> Writer
  tail-switch-arms definitions locals roots context w ty value drop-scrut base missed alternatives index defaulted = case alternatives of
    CAlternativesEnd sp -> if defaulted then w
      else line (line w (cat [missed, ":"])) "  unreachable"
    CAlternative sp pattern body rest -> case pattern of
      CPVar at pty id name -> tail-switch-default definitions ((Borrowed id pty value) : locals) roots context w ty value drop-scrut base missed body rest
      CPWild at pty -> tail-switch-default definitions locals roots context w ty value drop-scrut base missed body rest
      other -> case arm-plan w pattern of
        TagArm tag -> tail-switch-tag definitions locals roots context w ty value drop-scrut base missed pattern body rest index
        WordArm tag -> tail-switch-word definitions locals roots context w ty value drop-scrut base missed body rest index
        NoArm -> line (refuse w sp "case alternative disagrees with the dispatch it was chosen for") "  unreachable"
    other -> line (refuse w (Span 0 0 1 1) "malformed case alternative spine") "  unreachable"
  tail-switch-default :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> Bool -> String -> String -> CoreTerm -> CoreTerm -> Writer
  tail-switch-default definitions locals roots context w ty value drop-scrut base missed body rest =
    let owned = if drop-scrut then (Discard ty value) : roots else roots in
    tail-switch-arms definitions locals roots context
      (tail-result definitions locals owned context (line w (cat [missed, ":"])) missed body) ty value drop-scrut base missed rest 0 True
  tail-switch-tag :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> Bool -> String -> String -> CorePattern -> CoreTerm -> CoreTerm -> Nat -> Writer
  tail-switch-tag definitions locals roots context w ty value drop-scrut base missed pattern body rest index = case pattern of
    CPConstructor sp aty name actuals sc fields ->
      let entry = line w (cat [base, ".", nat-to-string index, ":"]) in
      let (pointed, pointer) = fresh entry "%ptr" in
      let cell = line pointed (cat ["  ", pointer, " = inttoptr i64 ", value, " to ptr"]) in
      case match-fields fields pointer 0 missed cell of
        (bound, bindings) -> let owned = if drop-scrut then (Discard ty value) : roots else roots in
          tail-switch-arms definitions locals roots context (tail-result definitions (bindings <> locals) owned context bound missed body) ty value drop-scrut base missed rest (index + 1) False
    other -> line (refuse w (Span 0 0 1 1) "dispatched arm is not a constructor pattern") "  unreachable"
  tail-switch-word :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> Bool -> String -> String -> CoreTerm -> CoreTerm -> Nat -> Writer
  tail-switch-word definitions locals roots context w ty value drop-scrut base missed body rest index =
    let owned = if drop-scrut then (Discard ty value) : roots else roots in
    tail-switch-arms definitions locals roots context
      (tail-result definitions locals owned context (line w (cat [base, ".", nat-to-string index, ":"])) missed body) ty value drop-scrut base missed rest (index + 1) False
  tail-chain :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> Bool -> CoreTerm -> Writer
  tail-chain definitions locals roots context w ty value drop-scrut alternatives = case alternatives of
    CAlternativesEnd end -> line w "  unreachable"
    CAlternative sp pattern body rest ->
      let (one, failed) = fresh w "nexttailalt" in
      case match-alternative pattern body locals value failed one of
        (matched, bindings, rebuilt) ->
          let owned = if drop-scrut then (Discard ty value) : roots else roots in
          let done = tail-result definitions (bindings <> locals) owned context matched failed rebuilt in
          tail-chain definitions locals roots context (line done (cat [failed, ":"])) ty value drop-scrut rest
    other -> line (refuse w (Span 0 0 1 1) "malformed case alternative spine") "  unreachable"

  -- The back edge stores all evaluated arguments after releasing the old
  -- frame's roots. Entry allocas are promotable to SSA loop phis by LLVM.
  allocate-loop-arguments :: List String -> Writer -> Writer
  allocate-loop-arguments words w = case words of
    [] -> w
    arg : rest -> allocate-loop-arguments rest (line (line w ("  " <> arg <> ".slot = alloca i64")) ("  store i64 " <> arg <> ".initial, ptr " <> arg <> ".slot"))
  load-loop-arguments :: List String -> Writer -> Writer
  load-loop-arguments words w = case words of
    [] -> w
    arg : rest -> load-loop-arguments rest (line w ("  " <> arg <> " = load i64, ptr " <> arg <> ".slot"))
  store-loop-arguments :: List String -> Nat -> Writer -> Writer
  store-loop-arguments words index w = case words of
    [] -> w
    arg : rest -> store-loop-arguments rest (index + 1) (line w (cat ["  store i64 ", arg, ", ptr %arg", nat-to-string index, ".slot"]))
  loop-metadata :: String -> Writer -> (Writer, String)
  loop-metadata count w = let (one, node) = fresh-serial w "!" in let (two, property) = fresh-serial one "!" in
    let value = if count == "0" then "llvm.loop.unroll.disable\"}" else "llvm.loop.unroll.count\", i32 " <> count <> "}" in
    (global (global two (cat [node, " = distinct !{", node, ", ", property, "}"])) (cat [property, " = !{!\"", value]), node)
  start-tail-worker :: String -> String -> Nat -> Nat -> Bool -> Writer -> Writer
  start-tail-worker hint name arity width loop w =
    if arity <= width then
      let entry = value-parameters arity 0 in
      let callee = tail-worker-name name in
      let widened = value-parameters width 0 in
      let wrapper = line (line w (cat ["define ", worker-linkage w name, "i64 ", symbol name, "(", join (argument-words entry), ")", hint, worker-open w])) "entry:" in
      case call wrapper (symbol callee) (entry <> padding-words (width - arity)) of
        (called, result) ->
          let wrapped = line (line called (cat ["  ret i64 ", result])) "}" in
          let parameters = if loop then map (\word -> word <> ".initial") widened else widened in
          let started = line (line wrapped (cat ["define private i64 ", symbol callee, "(", join (argument-words parameters), ")", hint, worker-open w])) "entry:" in
          if loop then load-loop-arguments widened (line (line (allocate-loop-arguments widened started) "  br label %self.loop") "self.loop:") else started
    else refuse w (Span 0 0 1 1) "tail wrapper exceeds its checked worker width"

  global-tail-clauses :: List CoreDefinition -> List Local -> List Local -> Nat -> TailContext -> List CoreClause -> Writer -> Writer
  global-tail-clauses definitions prefix roots offset context clauses w = case clauses of
    [] -> line w "  unreachable"
    (CoreClause sp patterns body) : rest ->
      let (one, failed) = fresh w "nexttaileq" in
      case match-clause patterns body prefix offset failed one of
        (matched, bindings, rebuilt) ->
          let returned = tail-result definitions (bindings <> prefix) roots context matched failed rebuilt in
          global-tail-clauses definitions prefix roots offset context rest (line returned (cat [failed, ":"]))

  global-tail-worker :: List CoreDefinition -> CoreDefinition -> List Nat -> List Local -> List Local -> Writer -> Nat -> Nat -> Nat -> Writer
  global-tail-worker definitions d classes prefix roots w group width arity =
    let offset = list-length (runtime-givens w d) in
    let name = specialized-name (d.name) classes in
    let self = d.name in
    let arities = hash-map-insert self (offset + arity) hash-map-empty in
    let self-loop = exposed-worker self (source-tail-clauses arities (d.clauses)) in
    let (prepared, loop) = (if not self-loop then (w, None) else
      case function-hints (writer-program w) (d.name) of
        FunctionHints inline cold (Some count) ->
          (case loop-metadata count w of (next, metadata) -> (next, Some (tail-worker-name name, metadata)))
        other -> (w, Some (tail-worker-name name, ""))) in
    let started = start-tail-worker (llvm-hint w (d.name)) name (offset + arity) width (case loop of Some value -> True; None -> False) prepared in
    line (global-tail-clauses definitions (LoopMarker : prefix) roots offset (GlobalTail group width loop []) (d.clauses) started) "}"

  -- | Build parameter roots omitting Discard entries for borrowed parameters (`True`).
  borrowed-parameter-roots :: List CorePattern -> Nat -> List Bool -> List Local
  borrowed-parameter-roots patterns index mask = case patterns of
    [] -> []
    first : rest -> case mask of
      True : more -> borrowed-parameter-roots rest (index + 1) more
      False : more -> (Discard (pattern-type first) (cat ["%arg", nat-to-string index])) : (borrowed-parameter-roots rest (index + 1) more)
      [] -> (Discard (pattern-type first) (cat ["%arg", nat-to-string index])) : (borrowed-parameter-roots rest (index + 1) [])

  -- | Emit a private borrowed-parameter self-loop worker (i64/i128 parameters).
  self-loop-worker-borrowed :: List CoreDefinition -> List Nat -> CoreDefinition -> List Local -> List Local -> List UType -> Nat -> List Bool -> Writer -> Writer
  self-loop-worker-borrowed definitions classes d prefix roots types arity mask w =
    let bname = cat [specialized-name (d.name) classes, "#b"] in
    let result = definition-result-llvm (w.context) d in
    let param-llvms = value-llvms (w.context) (take-types arity types) in
    let params = value-parameters arity 0 in
    let typed = typed-values param-llvms params in
    let init-typed = typed-values param-llvms (map (\word -> word <> ".initial") params) in
    let started = line (line w (cat ["define private ", result, " ", symbol bname, "(", join (typed-arguments init-typed), ")", llvm-hint w (d.name), worker-open w])) "entry:" in
    let looped = load-typed-loop-args typed (line (line (allocate-typed-loop-args typed started) "  br label %self.loop") "self.loop:") in
    line (self-loop-clauses-borrowed definitions (d.name) classes param-llvms result (LoopMarker : prefix) roots mask (d.clauses) looped) "}"

  self-loop-clauses-borrowed :: List CoreDefinition -> String -> List Nat -> List String -> String -> List Local -> List Local -> List Bool -> List CoreClause -> Writer -> Writer
  self-loop-clauses-borrowed definitions self classes param-llvms result prefix roots mask clauses w = case clauses of
    [] -> line w "  unreachable"
    (CoreClause sp patterns body) : rest ->
      let (one, failed) = fresh w "nexttaileq" in
      case match-clause patterns body prefix 0 failed one of
        (matched, bindings, rebuilt) ->
          let done = self-loop-result-borrowed definitions self classes param-llvms result (bindings <> prefix) roots mask matched failed rebuilt in
          self-loop-clauses-borrowed definitions self classes param-llvms result prefix roots mask rest (line done (cat [failed, ":"]))

  self-loop-result-borrowed :: List CoreDefinition -> String -> List Nat -> List String -> String -> List Local -> List Local -> List Bool -> Writer -> String -> CoreTerm -> Writer
  self-loop-result-borrowed definitions self classes param-llvms result locals roots mask w failed term = case term of
    CIf sp ty test yes no -> case expression definitions locals w test of
      (tested, condition) ->
        let (one, otherwise) = fresh tested "tailno" in
        let selected = continue-if one condition otherwise in
        let first = self-loop-result-borrowed definitions self classes param-llvms result locals roots mask selected failed yes in
        self-loop-result-borrowed definitions self classes param-llvms result locals roots mask (line first (cat [otherwise, ":"])) failed no
    CGuard sp ty condition body -> if core-alternative-covers term then
      self-loop-result-borrowed definitions self classes param-llvms result locals roots mask w failed body
      else (case expression definitions locals w condition of
        (ready, value) -> self-loop-result-borrowed definitions self classes param-llvms result locals roots mask (continue-if ready value failed) failed body)
    CLet sp ty id name sc rhs body -> case scheme-params sc of
      [] -> if scheme-supported (w.context) sc && word-type (w.context) (scheme-body sc) then
        (case expression definitions locals w rhs of
          (ready, value) ->
            let bound = Local id (scheme-body sc) value in
            let scoped = bound : locals in
            let owned = (Discard (scheme-body sc) value) : roots in
            let (one, cleanup) = fresh ready "tailcleanup" in
            let emitted = self-loop-result-borrowed definitions self classes param-llvms result scoped owned mask one cleanup body in
            let released = count-op False (scheme-body sc) value (line emitted (cat [cleanup, ":"])) in
            line released (cat ["  br label %", failed]))
        else self-loop-return definitions result locals roots w failed term
      other -> self-loop-return definitions result locals roots w failed term
    CRequire sp ty body -> self-loop-result-borrowed definitions self classes param-llvms result locals roots mask w failed body
    CProved sp ty ev body -> self-loop-result-borrowed definitions self classes param-llvms result locals roots mask w failed body
    CRefine sp ty ev body -> self-loop-result-borrowed definitions self classes param-llvms result locals roots mask w failed body
    CRefineProof sp ty witness body -> self-loop-result-borrowed definitions self classes param-llvms result locals roots mask w failed body
    CDischarge sp ty ev _ body -> self-loop-result-borrowed definitions self classes param-llvms result locals roots mask w failed body
    CForget sp ty body -> self-loop-result-borrowed definitions self classes param-llvms result locals roots mask w failed body
    other -> case self-loop-call-args self classes (list-length param-llvms) w term of
      Some args -> case tail-borrow-operands definitions locals roots w args mask of
        (evaluated, values, remaining) ->
          let ready = drop-locals remaining evaluated in
          line (store-typed-loop-args param-llvms values 0 ready) "  br label %self.loop"
      None -> self-loop-return definitions result locals roots w failed term

  -- | Emit a private borrowed-parameter single-function self-tail loop worker.
  global-tail-worker-borrowed :: List CoreDefinition -> CoreDefinition -> List Nat -> List Local -> List Local -> Writer -> Nat -> Nat -> Nat -> List Bool -> Writer
  global-tail-worker-borrowed definitions d classes prefix roots w group width arity mask =
    let bname = cat [specialized-name (d.name) classes, "#b"] in
    let (prepared, loop) = (case function-hints (writer-program w) (d.name) of
        FunctionHints inline cold (Some count) ->
          (case loop-metadata count w of (next, metadata) -> (next, Some (bname, metadata)))
        other -> (w, Some (bname, ""))) in
    let widened = value-parameters arity 0 in
    let init-params = map (\word -> word <> ".initial") widened in
    let started = line (line prepared (cat ["define private i64 ", symbol bname, "(", join (argument-words init-params), ")", llvm-hint prepared (d.name), worker-open prepared])) "entry:" in
    let looped = load-loop-arguments widened (line (line (allocate-loop-arguments widened started) "  br label %self.loop") "self.loop:") in
    line (global-tail-clauses definitions (LoopMarker : prefix) roots 0 (GlobalTail group arity loop mask) (d.clauses) looped) "}"

  -- | Emit a private borrowed-parameter companion worker (`@"<spec>#b"`).
  borrow-worker :: List CoreDefinition -> String -> List Nat -> Writer -> Writer
  borrow-worker definitions name classes w = case worker-definition name w of
    Some d -> case hash-map-lookup name (program-borrow-modes (writer-program w)) of
      Some mask -> case class-bindings (scheme-params (d.scheme)) classes of
        None -> refuse w (Span 0 0 1 1) "borrow worker needs representation classes"
        Some bounds -> case definition-rigids d bounds of
          None -> refuse w (Span 0 0 1 1) "borrow worker openings are invalid"
          Some rigids -> let scoped = with-representations bounds rigids w in
            if not (scheme-supported (scoped.context) (d.scheme)) then refuse scoped (Span 0 0 1 1) "borrow worker scheme unsupported"
            else case d.clauses of
              (CoreClause at patterns body) : rest ->
                let parameters = runtime-parameters patterns in
                let arity = list-length parameters in
                let types = pattern-types parameters in
                let prefix = self-binding scoped d classes in
                let roots = borrowed-parameter-roots parameters 0 mask in
                case (if wide-code classes then None else hash-map-lookup name ((writer-program scoped).tail-groups)) of
                  Some (group, width) -> global-tail-worker-borrowed definitions d classes prefix roots scoped group width arity mask
                  None -> if self-tail-present name classes arity (d.clauses) then
                      self-loop-worker-borrowed definitions classes d prefix roots types arity mask scoped
                    else
                      let bname = cat [specialized-name name classes, "#b"] in
                      let result = definition-result-llvm (scoped.context) d in
                      let params = typed-arguments (typed-values (value-llvms (scoped.context) types) (value-parameters arity 0)) in
                      let started = line (line scoped (cat ["define private ", result, " ", symbol bname, "(", join params, ")", llvm-hint scoped name, worker-open scoped])) "entry:" in
                      if worker-uses-arena name started then
                        let entered = line started "  %arena.phase = call i64 @cinch_arena_enter_phase(i64 4096)" in
                        line (worker-clauses-arena definitions prefix roots 0 (Some "%arena.phase") (d.clauses) entered) "}"
                      else line (worker-clauses definitions prefix roots 0 (d.clauses) started) "}"
              [] -> refuse scoped (Span 0 0 1 1) "borrow worker has no clauses"
      None -> refuse w (Span 0 0 1 1) "borrow worker definition or mask is absent"
    None -> refuse w (Span 0 0 1 1) "borrow worker definition or mask is absent"

  recursive-worker :: List CoreDefinition -> RecursiveWorker -> List RecursiveWorker -> List (Nat, Nat) -> List (Nat, Nat) -> List Local -> Writer -> Writer
  recursive-worker definitions member group bounds rigids saved w = case member of
    RecursiveWorker id ty name patterns body ->
      let sp = Span 0 0 1 1 in
      let scoped = with-representations bounds rigids w in
      let captures = capture-types saved in
      let offset = list-length captures in
      let parameters = runtime-parameters patterns in
      let arity = list-length parameters in
      let width = recursive-width group in
      let prefix = captured-bindings saved 0 in
      if not (word-type (scoped.context) (core-type body)) then refuse scoped sp "recursive worker result needs a runtime representation" else
        let all-param-tys = captures <> pattern-types parameters in
        if not (all-i64-types (scoped.context) all-param-tys) || value-llvm (scoped.context) (core-type body) /= "i64" then
          let sret-opt = value-sret-info (scoped.context) (core-type body) in
          let ret-llvm = (case sret-opt of Some info -> "void"; None -> value-llvm (scoped.context) (core-type body)) in
          let base-params = typed-arguments (typed-values (value-param-llvms (scoped.context) all-param-tys) (value-parameters (offset + arity) 0)) in
          let full-params = (case sret-opt of Some (sret-attr, sz, al) -> (cat [sret-attr, " %sret"]) : base-params; None -> base-params) in
          let started = line (line scoped (cat ["define ", worker-linkage scoped name, ret-llvm, " ", symbol name, "(", join full-params, ")", worker-open scoped])) "entry:" in
          (case recursive-locals sp captures prefix group body started of
            (ready, siblings) ->
              let roots = capture-roots captures 0 <> parameter-roots parameters offset <> siblings in
              case sret-opt of
                Some (sret-attr, sz, al) -> line (worker-clauses-sret definitions (siblings <> prefix) roots offset sz al [CoreClause sp patterns body] ready) "}"
                None -> line (worker-clauses definitions (siblings <> prefix) roots offset [CoreClause sp patterns body] ready) "}")
        else
        let (started, failed) = fresh (start-tail-worker "" name (offset + arity) (offset + width) False scoped) "tailmiss" in
        (case match-clause patterns body prefix offset failed started of
          (matched, bindings, rebuilt) -> case recursive-locals sp captures prefix group rebuilt matched of
            (ready, siblings) ->
              let roots = capture-roots captures 0 <> parameter-roots parameters offset <> siblings in
              let done = tail-result definitions (bindings <> siblings <> prefix) roots (LocalTail group prefix width) ready failed rebuilt in
              line (line (line done (cat [failed, ":"])) "  unreachable") "}")
  dispatch-demand :: List CoreDefinition -> Demand -> Writer -> Writer
  dispatch-demand definitions demand claimed = case demand of
    Demand name classes -> case worker-definition name claimed of
      Some d -> worker definitions classes claimed d
      None -> refuse claimed (Span 0 0 1 1) "demanded runtime definition is absent"
    ConstructorDemand name classes -> constructor-worker name classes claimed
    LambdaDemand name saved-bound saved-rigid saved parameter body -> lambda-worker definitions name saved-bound saved-rigid saved parameter body claimed
    RecursiveDemand member group saved-bound saved-rigid saved -> recursive-worker definitions member group saved-bound saved-rigid saved claimed
    StubDemand name classes ret-class -> app-stub name classes ret-class claimed
    DictionaryDemand name classes -> dictionary-worker definitions name classes claimed
    ArrayDemand name classes -> array-worker name classes claimed
    MVarDemand name classes -> mvar-worker name classes claimed
    BuiltinDemand name -> builtin-worker name claimed
    SymbolEquality -> global claimed "define internal i64 @\"cinch.runtime.symEq\"(i64 %a, i64 %b) alwaysinline {\n  %same = icmp eq i64 %a, %b\n  %result = zext i1 %same to i64\n  ret i64 %result\n}"
    MemoWorker -> memo-worker claimed
    ExternalDemand unit -> external-worker unit claimed
    ForeignDemand plan -> foreign-worker plan claimed
    ForeignNullFault -> foreign-null-declarations claimed
    PrimitiveIntrinsicDemand symbol -> primitive-intrinsic-worker symbol claimed
    PrimitiveUseDemand symbol decl -> global claimed decl
    CprDemand name classes -> cpr-worker definitions name classes claimed
    BorrowDemand name classes -> borrow-worker definitions name classes claimed
    BuiltinBorrowDemand name -> builtin-borrow-worker name claimed
    MemcpyDemand -> global claimed "declare void @llvm.memcpy.p0.p0.i64(ptr noalias writeonly, ptr noalias readonly, i64, i1 immarg)"
    MemsetDemand -> global claimed "declare void @llvm.memset.p0.i64(ptr writeonly, i8, i64, i1 immarg)"

  workers :: List CoreDefinition -> Writer -> Writer
  workers definitions w = case w of
    Writer next globals code errors layouts (RuntimeContext datas bounds rigids (WorkerQueue pending keys dictionaries scope serial unit-mode) inlining) -> case pending of
      -- Between units nothing is in scope, so a later name is the module's.
      [] -> Writer next globals code errors layouts (RuntimeContext datas bounds rigids (WorkerQueue [] keys dictionaries "" serial unit-mode) inlining)
      demand : rest ->
        let emitted-dictionary = dictionaries || (case demand of DictionaryDemand name classes -> True; other -> False) in
        -- A unit starts its own numbering and names what it lifts by its
        -- demand key, which is what makes the unit unique in the queue.
        let claimed = Writer 0 globals code errors layouts (RuntimeContext datas [] [] (WorkerQueue rest keys emitted-dictionary (llvm-data-bytes (demand-key demand)) serial unit-mode) inlining) in
        workers definitions (dispatch-demand definitions demand claimed)

  -- Self-contained per-unit IR output produced by one frontier worker.
  -- Pure `Share` data: unit-private globals and code, shared dedupable globals
  -- (`@cinch.desc.*` / `@empty-ctor*`), local metadata count, diagnostics,
  -- layouts, newly discovered demands, newly discovered method versions, and
  -- whether a dictionary unit was emitted.
  record EmittedUnit where
    key :: String
    g :: String
    s :: List (Nat, String)
    c :: String
    m :: Nat
    e :: List Diagnostic
    l :: List (String, List Nat)
    p :: List Demand
    v :: List MethodVersion
    d :: Bool

  -- Blaze LINK-style per-unit IR cache across incremental edits:
  -- stores emitted units by demand key alongside the tail-group map,
  -- static ownership plan, and settled method versions they were emitted under.
  record UnitIrCache where
    units :: HashMap String EmittedUnit
    tails :: HashMap String (Nat, Nat)
    ownership :: OwnershipPlan
    versions :: List MethodVersion
    cache-size :: Nat

  empty-unit-ir-cache :: UnitIrCache
  empty-unit-ir-cache = UnitIrCache hash-map-empty hash-map-empty empty-ownership-plan [] 0

  drop-prefix-versions :: Nat -> List MethodVersion -> List MethodVersion
  drop-prefix-versions n versions =
    if n == 0 then versions
    else case versions of
      [] -> []
      first : rest -> drop-prefix-versions (n - 1) rest

  emit-one-demand :: List CoreDefinition -> ProgramInfo -> InlinePlan -> Demand -> EmittedUnit
  emit-one-demand definitions info plan demand =
    let key = demand-key demand in
    let base-version-count = list-length (info.versions) in
    let emitted-dict = case demand of DictionaryDemand name classes -> True; other -> False in
    let unit-writer = Writer 0 (GlobalOutput builder-new hash-map-empty []) builder-new [] (LayoutPlan [])
          (RuntimeContext info [] [] (WorkerQueue [] hash-map-empty emitted-dict (llvm-data-bytes key) 0 True) plan) in
    case dispatch-demand definitions demand unit-writer of
      Writer next (GlobalOutput own-globals defined shared) code errors (LayoutPlan layouts) (RuntimeContext after-info bounds rigids (WorkerQueue pending keys dict scope serial unit-mode) after-plan) ->
        let new-versions = drop-prefix-versions base-version-count (after-info.versions) in
        EmittedUnit key (builder-run own-globals) (reverse shared) (builder-run code) serial (reverse errors) (reverse layouts) (reverse pending) new-versions dict

  emit-demand-batch :: List CoreDefinition -> ProgramInfo -> InlinePlan -> List Demand -> List EmittedUnit -> List EmittedUnit
  emit-demand-batch definitions info plan demands backwards = case demands of
    [] -> reverse backwards
    d : rest -> emit-demand-batch definitions info plan rest ((emit-one-demand definitions info plan d) : backwards)

  join-replaced :: String -> List String -> String
  join-replaced replacement parts = case parts of
    [] -> ""
    [only] -> only
    first : rest -> cat [first, replacement, join-replaced replacement rest]

  replace-placeholder :: String -> String -> String -> String
  replace-placeholder needle replacement text =
    if not (string-contains needle text) then text
    else join-replaced replacement (string-split-on needle text)

  renumber-meta-loop :: Nat -> Nat -> Nat -> String -> String
  renumber-meta-loop index count base text =
    if index >= count then text
    else
      let needle = cat ["!__cm", nat-to-string index, "__"] in
      let replacement = cat ["!", nat-to-string (base + index)] in
      renumber-meta-loop (index + 1) count base (replace-placeholder needle replacement text)

  renumber-meta :: Nat -> Nat -> String -> String
  renumber-meta count base text =
    if count == 0 || string-length text == 0 then text
    else renumber-meta-loop 0 count base text

  append-builder-text :: String -> Builder -> Builder
  append-builder-text text acc = if string-length text == 0 then acc else builder-add-string text acc

  merge-shared-globals :: List (Nat, String) -> GlobalOutput -> GlobalOutput
  merge-shared-globals rows acc = case rows of
    [] -> acc
    (key, line-text) : rest -> case acc of
      GlobalOutput output defined shared -> case hash-map-lookup key defined of
        Some written -> merge-shared-globals rest acc
        None -> merge-shared-globals rest (GlobalOutput output (hash-map-insert key 1 defined) ((key, line-text) : shared))

  merge-unit-layouts :: List (String, List Nat) -> List (String, List Nat) -> List (String, List Nat)
  merge-unit-layouts incoming acc = case incoming of
    [] -> acc
    (key, descriptions) : rest ->
      merge-unit-layouts rest (case layout-plan-lookup key acc of
        Some existing -> acc
        None -> (key, descriptions) : acc)

  layout-plan-lookup :: String -> List (String, List Nat) -> Option (List Nat)
  layout-plan-lookup key rows = case rows of
    [] -> None
    (name, descriptions) : rest -> if key == name then Some descriptions else layout-plan-lookup key rest

  merge-unit-versions :: List MethodVersion -> List MethodVersion -> List MethodVersion
  merge-unit-versions incoming acc = case incoming of
    [] -> acc
    (MethodVersion owner slot classes) : rest ->
      let next = if version-present owner slot classes acc then acc else acc <> [MethodVersion owner slot classes] in
      merge-unit-versions rest next

  enqueue-frontier-demands :: Bool -> List Demand -> HashMap String Unit -> HashMap String Nat -> List Demand -> (HashMap String Unit, HashMap String Nat, List Demand)
  enqueue-frontier-demands from-miss demands seen dirty-keys next-backwards = case demands of
    [] -> (seen, dirty-keys, next-backwards)
    d : rest ->
      let key = demand-key d in
      let next-dirty = (if not from-miss then dirty-keys else case d of
            LambdaDemand name a b c p body -> hash-map-insert key 1 dirty-keys
            RecursiveDemand member group a b c -> hash-map-insert key 1 dirty-keys
            other -> dirty-keys) in
      case hash-map-lookup key seen of
        Some already -> enqueue-frontier-demands from-miss rest seen next-dirty next-backwards
        None -> enqueue-frontier-demands from-miss rest (hash-map-insert key () seen) next-dirty (d : next-backwards)

  demand-cacheable :: HashMap String Nat -> HashMap String Nat -> Demand -> Bool
  demand-cacheable dirty-names dirty-keys demand =
    let key = demand-key demand in
    case hash-map-lookup key dirty-keys of
      Some marked -> False
      None -> case demand of
        Demand name classes -> (case hash-map-lookup name dirty-names of Some d -> False; None -> True)
        CprDemand name classes -> (case hash-map-lookup name dirty-names of Some d -> False; None -> True)
        BorrowDemand name classes -> (case hash-map-lookup name dirty-names of Some d -> False; None -> True)
        DictionaryDemand name classes -> False
        other -> True

  partition-frontier-cache :: HashMap String EmittedUnit -> HashMap String Nat -> HashMap String Nat -> List Demand -> List Demand -> List Demand -> (List Demand, List Demand)
  partition-frontier-cache cache dirty-names dirty-keys frontier hits-rev misses-rev = case frontier of
    [] -> (reverse hits-rev, reverse misses-rev)
    d : rest ->
      let hit = if not (demand-cacheable dirty-names dirty-keys d) then False else (case hash-map-lookup (demand-key d) cache of Some found -> True; None -> False) in
      if hit then partition-frontier-cache cache dirty-names dirty-keys rest (d : hits-rev) misses-rev
      else partition-frontier-cache cache dirty-names dirty-keys rest hits-rev (d : misses-rev)

  index-emitted-units :: List EmittedUnit -> HashMap String EmittedUnit -> HashMap String EmittedUnit
  index-emitted-units units acc = case units of
    [] -> acc
    unit : rest -> case unit of
      EmittedUnit key g s c m e l p v d -> index-emitted-units rest (hash-map-insert key unit acc)

  record FrontierState where
    globals :: GlobalOutput
    code :: Builder
    errors :: List Diagnostic
    layouts :: List (String, List Nat)
    seen :: HashMap String Unit
    dict :: Bool
    serial :: Nat
    info :: ProgramInfo
    collected :: HashMap String EmittedUnit
    dirty-keys :: HashMap String Nat
    emitted-n :: Nat
    reused-n :: Nat

  merge-frontier-ordered :: List Demand -> HashMap String EmittedUnit -> HashMap String EmittedUnit -> FrontierState -> List Demand -> (FrontierState, List Demand)
  merge-frontier-ordered frontier cache fresh-map state next-backwards = case frontier of
    [] -> (state, reverse next-backwards)
    demand : rest ->
      let key = demand-key demand in
      let (unit, from-miss) = case hash-map-lookup key fresh-map of
            Some fresh-unit -> (fresh-unit, True)
            None -> case hash-map-lookup key cache of
              Some cached-unit -> (cached-unit, False)
              None -> (EmittedUnit key "" [] "" 0 [] [] [] [] False, True) in
      case state of
        FrontierState globals code errors layouts seen dict serial info collected dirty-keys emitted-n reused-n -> case unit of
          EmittedUnit ukey ug ushared ucode umeta uerrors ulayouts upending uversions udict ->
            let fixed-globals = renumber-meta umeta serial ug in
            let fixed-code = renumber-meta umeta serial ucode in
            let merged-globals = case merge-shared-globals ushared globals of
                  GlobalOutput out def sh -> GlobalOutput (append-builder-text fixed-globals out) def sh in
            let merged-code = append-builder-text fixed-code code in
            let merged-errors = errors <> uerrors in
            let merged-layouts = merge-unit-layouts ulayouts layouts in
            let merged-versions = merge-unit-versions uversions (info.versions) in
            let merged-info = with-versions merged-versions info in
            let merged-collected = hash-map-insert ukey unit collected in
            let (next-seen, next-dirty, more-next) = enqueue-frontier-demands from-miss upending seen dirty-keys next-backwards in
            let next-state = FrontierState merged-globals merged-code merged-errors merged-layouts next-seen (dict || udict) (serial + umeta) merged-info merged-collected next-dirty (if from-miss then emitted-n + 1 else emitted-n) (if from-miss then reused-n else reused-n + 1) in
            merge-frontier-ordered rest cache fresh-map next-state more-next

  workers-frontier-loop :: CompileTuning -> List CoreDefinition -> InlinePlan -> HashMap String EmittedUnit -> HashMap String Nat -> List Demand -> FrontierState -> FrontierState
  workers-frontier-loop tuning definitions plan cache dirty-names frontier state = case frontier of
    [] -> state
    first : rest -> case state of
      FrontierState globals code errors layouts seen dict serial info collected dirty-keys emitted-n reused-n ->
        let (hits, misses) = partition-frontier-cache cache dirty-names dirty-keys frontier [] [] in
        let miss-count = list-length misses in
        let fresh-units =
              if miss-count == 0 then []
              else if miss-count == 1 then emit-demand-batch definitions info plan misses []
              else
                let chunks = chunk-list (tuning-chunk-size tuning miss-count) misses in
                let batches = parMap (\batch -> emit-demand-batch definitions info plan batch []) chunks in
                flatten-lists batches in
        let fresh-map = index-emitted-units fresh-units hash-map-empty in
        case merge-frontier-ordered frontier cache fresh-map state [] of
          (next-state, next-frontier) ->
            workers-frontier-loop tuning definitions plan cache dirty-names next-frontier next-state

  workers-frontier-tuned :: CompileTuning -> List CoreDefinition -> HashMap String EmittedUnit -> HashMap String Nat -> Writer -> (Writer, HashMap String EmittedUnit, Nat, Nat)
  workers-frontier-tuned tuning definitions cache dirty-names w = case w of
    Writer next globals code errors (LayoutPlan layouts) (RuntimeContext info bounds rigids (WorkerQueue pending keys dict scope serial unit-mode) plan) ->
      let initial-frontier = reverse pending in
      let start = FrontierState globals code errors layouts keys dict serial info hash-map-empty hash-map-empty 0 0 in
      case workers-frontier-loop tuning definitions plan cache dirty-names initial-frontier start of
        FrontierState fg fc fe fl fs fd fserial finfo collected fdirty emitted-n reused-n ->
          (Writer 0 fg fc fe (LayoutPlan fl) (RuntimeContext finfo [] [] (WorkerQueue [] fs fd "" fserial False) plan), collected, emitted-n, reused-n)
  declarations :: String
  declarations = declarations-counting False False True
  -- The four pooled parallel entries (runtime ABI 8). They are declared
  -- only when the program contains a parallel primitive, so a program that
  -- uses none emits the same IR bytes as before the builtins existed
  -- (design/parallel-evaluation.md section 4.2).
  par-declarations :: String -> String
  par-declarations prefix = cat
    ["declare i64 ", prefix, "par_both(i64, i64, i64)\n",
     "declare i64 ", prefix, "par_tabulate(i64, i64, i64)\n",
     "declare i64 ", prefix, "par_map_array(i64, i64, i64)\n",
     "declare i64 ", prefix, "par_set_workers(i64)\n"]
  par-used :: List CoreDefinition -> Bool
  par-used definitions = case definitions of
    [] -> False
    d : rest -> definition-par-used d || par-used rest
  definition-par-used :: CoreDefinition -> Bool
  definition-par-used d = case d.clauses of
    [] -> False
    (CoreClause sp patterns body) : rest -> term-par-used body || definition-par-used (CoreDefinition sp (d.name) (d.scheme) (d.openings) (d.givens) [] rest)
  term-par-used :: CoreTerm -> Bool
  term-par-used term = case term of
    CPrimitive sp ty op args -> par-operation op || children-par-used (term-children term)
    CLambda sp ty p body -> term-par-used body
    other -> children-par-used (runtime-term-children term)
  children-par-used :: List CoreTerm -> Bool
  children-par-used terms = case terms of [] -> False; first : rest -> term-par-used first || children-par-used rest
  par-operation :: String -> Bool
  par-operation op = op == "par-both" || op == "par-tabulate" || op == "par-map" || op == "par-workers"
  par-preamble :: ProgramInfo -> List CoreDefinition -> String
  par-preamble info definitions = if par-used definitions then par-declarations (par-prefix info) else ""
  -- The module prelude. Debug counting swaps only the two count helpers,
  -- so every other declaration and every call site is the same bytes. An
  -- emission that does not reclaim emits neither helper, because no body
  -- of it calls one.
  function-open :: Bool -> String
  function-open wasm32 = if wasm32 then " \"target-features\"=\"+tail-call\" {" else " {"
  worker-open :: Writer -> String
  worker-open w = function-open (program-wasm32 (writer-program w))
  declarations-counting :: Bool -> Bool -> Bool -> String
  declarations-counting wasm32 debug reclaim = declarations-counting-mt wasm32 debug reclaim True
  declarations-counting-mt :: Bool -> Bool -> Bool -> Bool -> String
  declarations-counting-mt wasm32 debug reclaim concurrent = cat [
    "declare i64 @cinch_alloc(i64, i64)\ndeclare void @cinch_blackhole() noreturn\n",
    "declare ptr @cinch_alloc_ctor(i64, i64)\ndeclare ptr @cinch_alloc_shaped(i64, i64, i64)\ndeclare ptr @cinch_alloc_ctor_desc(i64, ptr)\ndeclare ptr @cinch_alloc_shaped_desc(i64, i64, ptr)\n",
    if wasm32 then "" else "declare i64 @cinch_sched_blocking_enter()\ndeclare i64 @cinch_sched_blocking_exit()\n",
    if wasm32 then "declare ptr @memcpy(ptr, ptr, i32)\n" else "declare ptr @memcpy(ptr, ptr, i64)\n",
    "declare void @cinch_dup(i64)\ndeclare void @cinch_dup_mt(i64)\ndeclare void @cinch_drop_mt(i64)\ndeclare void @cinch_drop_slow(i64)\ndeclare void @cinch_free(i64)\ndeclare void @cinch_frame_release(i64)\ndeclare void @cinch_reclaim_enable()\ndeclare i64 @cinch_exit_check(i64)\n",
    if not reclaim then "" else if debug then debug-count-helpers wasm32 else count-helpers-mt wasm32 concurrent,
    "declare noundef range(i64 0, -9223372036854775808) i64 @cinch_nat_to_len(i64)\ndeclare i64 @cinch_nat_from_i64(i64)\ndeclare i64 @cinch_int_from_nat(i64)\ndeclare i64 @cinch_bytes_new(i64)\ndeclare noundef range(i64 0, 9223372036854775807) i64 @cinch_bytes_len(i64)\ndeclare i64 @cinch_bytes_data(i64)\ndeclare noundef range(i64 0, 256) i64 @cinch_bytes_get(i64, i64)\ndeclare i64 @cinch_bytes_set(i64, i64, i64)\ndeclare i64 @cinch_bytes_from_data(ptr, i64)\ndeclare i64 @cinch_sym_intern(i64, i64)\ndeclare i64 @cinch_bytes_compare(i64, i64)\ndeclare i64 @cinch_utf8_validate(i64, i64)\ndeclare i64 @cinch_utf8_count_chars(i64, i64)\ndeclare i64 @cinch_io_write(i64)\ndeclare i64 @cinch_io_sleep(i64)\ndeclare i64 @cinch_task_poll_cancel()\ndeclare i64 @cinch_scope_open()\ndeclare i64 @cinch_scope_close(i64)\ndeclare i64 @cinch_task_spawn(i64, i64)\ndeclare i64 @cinch_task_join_all_or_cancel(i64, i64, i64, i64)\n",
    "declare i64 @cinch_array_from_list(i64, i64)\ndeclare i64 @cinch_array_replicate(i64, i64, i64)\ndeclare noundef range(i64 0, 9223372036854775807) i64 @cinch_array_len(i64)\ndeclare i64 @cinch_array_has(i64, i64)\ndeclare i64 @cinch_array_get(i64, i64)\ndeclare i64 @cinch_array_set(i64, i64, i64)\ndeclare i64 @cinch_array_slice(i64, i64, i64)\ndeclare i64 @cinch_array_append(i64, i64)\ndeclare i64 @cinch_array_tabulate_packed(i64, i64, i64)\ndeclare i64 @cinch_array_map_packed(i64, i64, i64)\ndeclare i64 @cinch_array_zip_with_packed(i64, i64, i64, i64)\ndeclare i64 @cinch_array_foldl_packed(i64, i64, i64)\ndeclare i64 @cinch_array_zip_binop_f32(i64, i64, i64)\ndeclare i64 @cinch_array_zip_binop_f64(i64, i64, i64)\ndeclare i64 @cinch_array_zip_binop_i32(i64, i64, i64)\ndeclare i64 @cinch_array_map_unary_f32(i64, i64, i64)\ndeclare i64 @cinch_array_reduce_f32(i64, i64)\ndeclare i64 @cinch_array_reduce_f64(i64, i64)\ndeclare i64 @cinch_array_reduce_i32(i64, i64)\ndeclare i64 @cinch_array_reduce_u32(i64, i64)\ndeclare i64 @cinch_array_reduce_i64(i64, i64)\ndeclare i64 @cinch_array_dot_f32(i64, i64, i64)\ndeclare i64 @cinch_array_dot_f64(i64, i64, i64)\ndeclare i64 @cinch_array_dot_i32(i64, i64)\ndeclare i64 @cinch_array_strided_dot_f32(i64, i64, i64, i64, i64, i64, i64, i64)\ndeclare i64 @cinch_array_fused_map_reduce_f32(i64, i64, i64, i64)\ndeclare i64 @cinch_array_row_reduce_f32(i64, i64, i64, i64)\ndeclare i64 @cinch_array_row_reduce_i32(i64, i64, i64, i64)\ndeclare i64 @cinch_array_scan_i32(i64, i64, i64)\ndeclare i64 @cinch_array_scan_u32(i64, i64, i64)\ndeclare i64 @cinch_array_filter_i32_gt(i64, i64)\ndeclare i64 @cinch_array_filter_packed(i64, i64)\ndeclare i64 @cinch_array_gather_f32(i64, i64, i64)\ndeclare i64 @cinch_array_gather_i32(i64, i64, i64)\ndeclare i64 @cinch_array_scatter_unique_u32(i64, i64, i64)\ndeclare i64 @cinch_array_scatter_combine_i32(i64, i64, i64, i64)\ndeclare i64 @cinch_array_histogram_u8(i64, i64)\ndeclare i64 @cinch_array_histogram_u32(i64, i64)\ndeclare i64 @cinch_array_histogram_batch_u8(i64, i64, i64, i64, i64)\ndeclare i64 @cinch_array_stencil2d_u8(i64, i64, i64, i64, i64, i64, i64, i64)\ndeclare i64 @cinch_array_stencil2d_f32(i64, i64, i64, i64, i64, i64, i64)\ndeclare i64 @cinch_array_segmented_reduce_f32(i64, i64, i64)\ndeclare i64 @cinch_array_spmv_csr_f32(i64, i64, i64, i64, i64)\ndeclare i64 @cinch_array_pack_strided_1d(i64, i64, i64, i64)\ndeclare i64 @cinch_array_pack_strided_2d(i64, i64, i64, i64, i64, i64)\ndeclare i64 @cinch_array_set_exec_mode(i64)\ndeclare i64 @cinch_array_last_report_bytes()\ndeclare i64 @cinch_array_fill_f32(i64, i64)\ndeclare i64 @cinch_array_fill_f64(i64, i64)\ndeclare i64 @cinch_array_scale_f64(i64, i64)\ndeclare i64 @cinch_array_row_broadcast_f32(i64, i64, i64)\ndeclare i64 @cinch_array_scatter_add_f32(i64, i64, i64, i64)\ndeclare i64 @cinch_array_stencil2d_adjoint_f32(i64, i64, i64, i64, i64, i64, i64)\ndeclare i64 @cinch_device_open(i64)\ndeclare i64 @cinch_device_close(i64)\ndeclare i64 @cinch_device_reset_telemetry(i64)\ndeclare i64 @cinch_device_upload_array(i64, i64)\ndeclare i64 @cinch_device_download_array(i64, i64, i64)\ndeclare i64 @cinch_device_buffer_free(i64)\ndeclare i64 @cinch_device_buffer_bytes(i64)\ndeclare i64 @cinch_device_dot_f32_bits(i64, i64, i64, i64, i64)\ndeclare i64 @cinch_device_scan_i32(i64, i64, i64, i64)\ndeclare i64 @cinch_device_filter_i32_gt_handle(i64, i64, i64, i64)\ndeclare i64 @cinch_device_row_reduce_f32(i64, i64, i64, i64)\ndeclare i64 @cinch_device_stencil_histogram_u8_arr(i64, i64, i64, i64, i64, i64, i64, i64, i64, i64)\ndeclare i64 @cinch_device_stencil2d_f32_arr(i64, i64, i64, i64, i64, i64, i64, i64)\ndeclare i64 @cinch_device_spmv_csr_f32(i64, i64, i64, i64, i64, i64, i64, i64)\ndeclare i64 @cinch_device_report_bytes(i64)\ndeclare i64 @cinch_tensor_reshape(i64, i64)\ndeclare i64 @cinch_tensor_shape(i64)\ndeclare i64 @cinch_tensor_data(i64)\ndeclare i64 @cinch_tensor_index(i64, i64)\ndeclare i64 @cinch_tenso