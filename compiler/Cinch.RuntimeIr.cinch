    "declare i64 @cinch_text_f64_to_decimal(double)\ndeclare double @cinch_text_f64_from_decimal(i64)\n",
    "declare i64 @cinch_stm_state(i64)\ndeclare i64 @cinch_stm_publish(i64, i64)\ndeclare i64 @cinch_stm_wait_begin(i64)\ndeclare i64 @cinch_stm_wait_park(i64)\ndeclare i64 @cinch_stm_wait_cancel(i64)\ndeclare i64 @cinch_stm_wake(i64)\ndeclare i64 @cinch_stm_yield(i64)\n",
    "declare i64 @cinch_mvar_new(i64, i64, i64)\ndeclare i64 @cinch_mvar_access(i64, i64, i64, i64, ptr)\ndeclare i64 @cinch_atomic_new(i64)\ndeclare i64 @cinch_atomic_load(i64, i64)\ndeclare i64 @cinch_atomic_store(i64, i64, i64)\ndeclare i64 @cinch_atomic_swap(i64, i64, i64)\ndeclare i64 @cinch_atomic_fetch_add(i64, i64, i64)\ndeclare i64 @cinch_atomic_fetch_sub(i64, i64, i64)\ndeclare i64 @cinch_atomic_fetch_and(i64, i64, i64)\ndeclare i64 @cinch_atomic_fetch_or(i64, i64, i64)\ndeclare i64 @cinch_atomic_fetch_xor(i64, i64, i64)\ndeclare i64 @cinch_atomic_cas(i64, i64, i64, i64, i64)\ndeclare i64 @cinch_atomic_fence(i64)\ndeclare i64 @cinch_rwlock_new(i64, i64)\ndeclare i64 @cinch_rwlock_access(i64, i64, i64, ptr)\n",
    "declare i64 @cinch_slots_new(i64, i64)\ndeclare i64 @cinch_slots_move(i64, i64, i64, i64, i64)\ndeclare i64 @cinch_slots_clear(i64, i64, i64)\ndeclare i64 @cinch_slots_fault(i64)\ndeclare i64 @cinch_nat_low_word(i64)\ndeclare void @llvm.prefetch.p0(ptr, i32, i32, i32)\n",
    "declare i64 @cinch_io_read(i64)\ndeclare i64 @cinch_text_sha256(i64)\ndeclare i64 @cinch_text_sha512(i64)\ndeclare i64 @cinch_text_sha1(i64)\ndeclare i64 @cinch_text_md5(i64)\ndeclare i64 @cinch_text_hmac_sha256(i64, i64)\n",
