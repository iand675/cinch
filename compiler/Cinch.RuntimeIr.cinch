    "declare i64 @cinch_pty_open()\ndeclare i64 @cinch_pty_spawn(i64, i64, i64, i64, i64)\ndeclare i64 @cinch_pty_read(i64, i64)\ndeclare i64 @cinch_pty_write(i64, i64)\ndeclare i64 @cinch_pty_wait(i64)\ndeclare i64 @cinch_pty_close(i64)\ndeclare i64 @cinch_pty_resize(i64, i64, i64)\n",
    "declare i64 @cinch_argv_init(i64, ptr)\ndeclare i64 @cinch_run_main(ptr)\n",
    "declare i64 @cinch_int_from_decimal(ptr, i64)\ndeclare i64 @cinch_nat_from_decimal(ptr, i64)\ndeclare i64 @cinch_int_to_i64(i64)\n",
    "declare i64 @cinch_int_add(i64, i64)\ndeclare i64 @cinch_int_sub(i64, i64)\ndeclare i64 @cinch_int_mul(i64, i64)\ndeclare i64 @cinch_int_div(i64, i64)\ndeclare i64 @cinch_int_neg(i64)\ndeclare i64 @cinch_int_cmp(i64, i64)\n",
    "declare i64 @cinch_nat_add(i64, i64)\ndeclare i64 @cinch_nat_sub(i64, i64)\ndeclare i64 @cinch_nat_mul(i64, i64)\ndeclare i64 @cinch_nat_div(i64, i64)\ndeclare i64 @cinch_nat_cmp(i64, i64)\n",
    "declare i8 @llvm.fshl.i8(i8, i8, i8)\ndeclare i8 @llvm.fshr.i8(i8, i8, i8)\ndeclare i8 @llvm.ctpop.i8(i8)\ndeclare i8 @llvm.ctlz.i8(i8, i1)\ndeclare i8 @llvm.cttz.i8(i8, i1)\ndeclare i8 @llvm.bitreverse.i8(i8)\n",
    "declare i16 @llvm.fshl.i16(i16, i16, i16)\ndeclare i16 @llvm.fshr.i16(i16, i16, i16)\ndeclare i16 @llvm.ctpop.i16(i16)\ndeclare i16 @llvm.ctlz.i16(i16, i1)\ndeclare i16 @llvm.cttz.i16(i16, i1)\ndeclare i16 @llvm.bitreverse.i16(i16)\ndeclare i16 @llvm.bswap.i16(i16)\n",
    "declare i32 @llvm.fshl.i32(i32, i32, i32)\ndeclare i32 @llvm.fshr.i32(i32, i32, i32)\ndeclare i32 @llvm.ctpop.i32(i32)\ndeclare i32 @llvm.ctlz.i32(i32, i1)\ndeclare i32 @llvm.cttz.i32(i32, i1)\ndeclare i32 @llvm.bitreverse.i32(i32)\ndeclare i32 @llvm.bswap.i32(i32)\n",
    "declare i64 @llvm.fshl.i64(i64, i64, i64)\ndeclare i64 @llvm.fshr.i64(i64, i64, i64)\ndeclare i64 @llvm.ctpop.i64(i64)\ndeclare i64 @llvm.ctlz.i64(i64, i1)\ndeclare i64 @llvm.cttz.i64(i64, i1)\ndeclare i64 @llvm.bitreverse.i64(i64)\ndeclare i64 @llvm.bswap.i64(i64)\n",
    "declare i128 @llvm.fshl.i128(i128, i128, i128)\ndeclare i128 @llvm.fshr.i128(i128, i128, i128)\ndeclare i128 @llvm.ctpop.i128(i128)\ndeclare i128 @llvm.ctlz.i128(i128, i1)\ndeclare i128 @llvm.cttz.i128(i128, i1)\ndeclare i128 @llvm.bitreverse.i128(i128)\ndeclare i128 @llvm.bswap.i128(i128)\n",
    "declare float @llvm.copysign.f32(float, float)\ndeclare double @llvm.copysign.f64(double, double)\ndeclare float @llvm.fabs.f32(float)\ndeclare double @llvm.fabs.f64(double)\ndeclare float @llvm.sqrt.f32(float)\ndeclare double @llvm.sqrt.f64(double)\ndeclare float @llvm.sin.f32(float)\ndeclare double @llvm.sin.f64(double)\ndeclare float @llvm.cos.f32(float)\ndeclare double @llvm.cos.f64(double)\ndeclare float @llvm.exp.f32(float)\ndeclare double @llvm.exp.f64(double)\ndeclare float @llvm.log.f32(float)\ndeclare double @llvm.log.f64(double)\ndeclare float @llvm.floor.f32(float)\ndeclare double @llvm.floor.f64(double)\ndeclare float @llvm.ceil.f32(float)\ndeclare double @llvm.ceil.f64(double)\ndeclare float @llvm.trunc.f32(float)\ndeclare double @llvm.trunc.f64(double)\ndeclare float @llvm.round.f32(float)\ndeclare double @llvm.round.f64(double)\ndeclare float @llvm.roundeven.f32(float)\ndeclare double @llvm.roundeven.f64(double)\n",
    "declare <8 x i16> @llvm.smin.v8i16(<8 x i16>, <8 x i16>)\ndeclare <8 x i16> @llvm.smax.v8i16(<8 x i16>, <8 x i16>)\ndeclare <4 x i32> @llvm.smin.v4i32(<4 x i32>, <4 x i32>)\ndeclare <4 x i32> @llvm.smax.v4i32(<4 x i32>, <4 x i32>)\ndeclare <4 x i32> @llvm.fshl.v4i32(<4 x i32>, <4 x i32>, <4 x i32>)\ndeclare <4 x i32> @llvm.fshr.v4i32(<4 x i32>, <4 x i32>, <4 x i32>)\ndeclare <2 x i64> @llvm.fshl.v2i64(<2 x i64>, <2 x i64>, <2 x i64>)\ndeclare <2 x i64> @llvm.fshr.v2i64(<2 x i64>, <2 x i64>, <2 x i64>)\n",
    "!0 = !{}\n!1 = !{!\"cinch.tbaa\"}\n!2 = !{!\"cinch.hdr\", !1, i64 0}\n!3 = !{!2, !2, i64 0}\n!4 = !{!\"cinch.bytes\", !1, i64 0}\n!5 = !{!4, !4, i64 0}\n!6 = !{!\"branch_weights\", i32 9999, i32 1}\n!7 = !{!\"branch_weights\", i32 1, i32 9999}\n!8 = !{i64 0, i64 9223372036854775807}\n"]
  -- Inline count helpers with RC_FRAME/RC_FRAME_RELEASED support (Idea 3) and
  -- static thread-locality specialization (Idea 5): when `concurrent` is False,
  -- all header loads are plain non-atomic loads with no MT branch; `.local`
  -- helpers expose the same non-atomic path inside concurrent programs.
  count-helpers :: Bool -> String
  count-helpers wasm32 = count-helpers-mt wasm32 True
  count-helpers-mt :: Bool -> Bool -> String
  count-helpers-mt wasm32 concurrent =
    let hdr-load = if concurrent then "  %h = load atomic i64, ptr %hp monotonic, align 8\n" else "  %h = load i64, ptr %hp, align 8\n" in
    cat [
      "define internal i1 @cinch.typed.rc.unique(ptr %p) alwaysinline", function-open wasm32, "\nentry:\n",
      "  %hp = getelementptr inbounds i8, ptr %p, i64 -8\n", hdr-load,
      "  %top = shl i64 %h, 29\n  %single = icmp eq i64 %top, 536870912\n  ret i1 %single\n}\n",
      "define internal void @cinch.typed.rc.dup(i64 %w) alwaysinline", function-open wasm32, "\nentry:\n",
      "  %lo = and i64 %w, 1\n  %null = icmp eq i64 %w, 0\n  %imm = icmp ne i64 %lo, 0\n  %skip = or i1 %null, %imm\n  br i1 %skip, label %done, label %block\nblock:\n",
      "  %p = inttoptr i64 %w to ptr\n  %hp = getelementptr inbounds i8, ptr %p, i64 -8\n", hdr-load,
      "  %top = shl i64 %h, 29\n  %nf = icmp slt i64 %top, 9223372035781033984\n  %pos = icmp sgt i64 %top, 0\n  %plain = and i1 %pos, %nf\n",
      "  br i1 %plain, label %inc, label %other\ninc:\n  %h1 = add i64 %h, 1\n  store i64 %h1, ptr %hp\n  br label %done\n",
      if concurrent then
        "other:\n  %nz = icmp ne i64 %top, 0\n  %shared = and i1 %nz, %nf\n  br i1 %shared, label %mt, label %done\nmt:\n  call void @cinch_dup_mt(i64 %w)\n  br label %done\ndone:\n  ret void\n}\n"
      else
        "other:\n  br label %done\ndone:\n  ret void\n}\n",
      "define internal void @cinch.typed.rc.drop(i64 %w) alwaysinline", function-open wasm32, "\nentry:\n",
      "  %lo = and i64 %w, 1\n  %null = icmp eq i64 %w, 0\n  %imm = icmp ne i64 %lo, 0\n  %skip = or i1 %null, %imm\n  br i1 %skip, label %done, label %block\nblock:\n",
      "  %p = inttoptr i64 %w to ptr\n  %hp = getelementptr inbounds i8, ptr %p, i64 -8\n", hdr-load,
      "  %top = shl i64 %h, 29\n  %nf = icmp slt i64 %top, 9223372035781033984\n  %gt1 = icmp sgt i64 %top, 536870912\n  %plain = and i1 %gt1, %nf\n",
      "  br i1 %plain, label %dec, label %other\ndec:\n  %h1 = sub i64 %h, 1\n  store i64 %h1, ptr %hp\n  br label %done\n",
      "other:\n  switch i64 %top, label %", if concurrent then "mt" else "done", " [\n    i64 0, label %done\n    i64 536870912, label %slow\n    i64 9223372036317904896, label %frame\n    i64 9223372035781033984, label %done\n  ]\n",
      "slow:\n  call void @cinch_drop_slow(i64 %w)\n  br label %done\nframe:\n  call void @cinch_frame_release(i64 %w)\n  br label %done\n",
      if concurrent then "mt:\n  call void @cinch_drop_mt(i64 %w)\n  br label %done\n" else "",
      "done:\n  ret void\n}\n",
      "define internal void @cinch.typed.rc.dup.local(i64 %w) alwaysinline", function-open wasm32, "\nentry:\n",
      "  %lo = and i64 %w, 1\n  %null = icmp eq i64 %w, 0\n  %imm = icmp ne i64 %lo, 0\n  %skip = or i1 %null, %imm\n  br i1 %skip, label %done, label %block\nblock:\n",
      "  %p = inttoptr i64 %w to ptr\n  %hp = getelementptr inbounds i8, ptr %p, i64 -8\n  %h = load i64, ptr %hp, align 8\n",
      "  %top = shl i64 %h, 29\n  %nf = icmp slt i64 %top, 9223372035781033984\n  %pos = icmp sgt i64 %top, 0\n  %plain = and i1 %pos, %nf\n",
      "  br i1 %plain, label %inc, label %done\ninc:\n  %h1 = add i64 %h, 1\n  store i64 %h1, ptr %hp\n  br label %done\ndone:\n  ret void\n}\n",
      "define internal void @cinch.typed.rc.drop.local(i64 %w) alwaysinline", function-open wasm32, "\nentry:\n",
      "  %lo = and i64 %w, 1\n  %null = icmp eq i64 %w, 0\n  %imm = icmp ne i64 %lo, 0\n  %skip = or i1 %null, %imm\n  br i1 %skip, label %done, label %block\nblock:\n",
      "  %p = inttoptr i64 %w to ptr\n  %hp = getelementptr inbounds i8, ptr %p, i64 -8\n  %h = load i64, ptr %hp, align 8\n",
      "  %top = shl i64 %h, 29\n  %nf = icmp slt i64 %top, 9223372035781033984\n  %gt1 = icmp sgt i64 %top, 536870912\n  %plain = and i1 %gt1, %nf\n",
      "  br i1 %plain, label %dec, label %other\ndec:\n  %h1 = sub i64 %h, 1\n  store i64 %h1, ptr %hp\n  br label %done\n",
      "other:\n  switch i64 %top, label %done [\n    i64 536870912, label %slow\n    i64 9223372036317904896, label %frame\n  ]\n",
      "slow:\n  call void @cinch_drop_slow(i64 %w)\n  br label %done\nframe:\n  call void @cinch_frame_release(i64 %w)\n  br label %done\ndone:\n  ret void\n}\n"]
  -- The reference count debugging build (TargetProfile::rc_debug in
  -- seed/src/core.rs): all helpers call the runtime's out-of-line
  -- cinch_dup and cinch_drop, so CINCH_RC_DEBUG=1 checks every count
  -- operation this module performs against a live header.
  debug-count-helpers :: Bool -> String
  debug-count-helpers wasm32 = cat [
    "define internal i1 @cinch.typed.rc.unique(ptr %p) alwaysinline", function-open wasm32, "\nentry:\n  ret i1 false\n}\n",
    "declare void @cinch_drop(i64)\n",
    "define internal void @cinch.typed.rc.dup(i64 %w)", function-open wasm32, "\nentry:\n  call void @cinch_dup(i64 %w)\n  ret void\n}\n",
    "define internal void @cinch.typed.rc.drop(i64 %w)", function-open wasm32, "\nentry:\n  call void @cinch_drop(i64 %w)\n  ret void\n}\n",
    "define internal void @cinch.typed.rc.dup.local(i64 %w)", function-open wasm32, "\nentry:\n  call void @cinch_dup(i64 %w)\n  ret void\n}\n",
    "define internal void @cinch.typed.rc.drop.local(i64 %w)", function-open wasm32, "\nentry:\n  call void @cinch_drop(i64 %w)\n  ret void\n}\n"]
  apply-entry :: String
  apply-entry = apply-entry-with-linkage False ""
  apply-entry-with-linkage :: Bool -> String -> String
  apply-entry-with-linkage wasm32 linkage = cat ["define ", linkage, "i64 @__apply(i64 %closure, i64 %argc, ptr %argv)", function-open wasm32, "\nentry:\n",
    "  %self = inttoptr i64 %closure to ptr\n  %code = load i64, ptr %self\n  %function = inttoptr i64 %code to ptr\n",
    "  %result = call i64 %function(ptr %self, i64 %argc, ptr %argv)\n  ret i64 %result\n}\n"]
  entry :: Bool -> String -> Nat -> Bool -> String
  entry wasm32 name mode reclaim =
    let invocation = (if mode == 0 then cat ["  %result = call i64 ", symbol name, "()\n"]
      else if mode == 1 then cat ["  %result = call i64 ", symbol name, "(i64 0)\n"]
      else if mode == 3 then cat ["  %function = call i64 ", symbol name, "()\n  %result = call i64 @__apply(i64 %function, i64 0, ptr null)\n"]
      else cat ["  %function = call i64 ", symbol name, "()\n  %argv = alloca i64\n  store i64 0, ptr %argv\n  %result = call i64 @__apply(i64 %function, i64 1, ptr %argv)\n"]) in
    cat ["define i64 @cinch.typed.exit()", function-open wasm32, "\nentry:\n", invocation,
    "  %exit = call i64 @cinch_int_to_i64(i64 %result)\n", if reclaim then "  call void @cinch.typed.rc.drop(i64 %result)\n" else "", "  ret i64 %exit\n}\n",
    if wasm32 then "define i32 @main()" else "define i32 @main(i32 %argc, ptr %argv)", function-open wasm32, "\nentry:\n",
    if reclaim then "  call void @cinch_reclaim_enable()\n" else "",
    if wasm32 then "" else "  %count = sext i32 %argc to i64\n  call i64 @cinch_argv_init(i64 %count, ptr %argv)\n",
    if wasm32 then "  %exit = call i64 @cinch.typed.exit()\n" else "  %exit = call i64 @cinch_run_main(ptr @cinch.typed.exit)\n", "  %checked = call i64 @cinch_exit_check(i64 %exit)\n  %code = trunc i64 %checked to i32\n  ret i32 %code\n}\n"]
  entry-parameters :: List Quant -> Bool
  entry-parameters qs = case qs of [] -> True; q : rest -> erased-kind (q.kind) && entry-parameters rest
  entry-mode :: CoreDefinition -> Option Nat
  entry-mode d = if not (entry-parameters (scheme-params (d.scheme))) || list-length (d.givens) > 0 then None else
    if named (scheme-body (d.scheme)) "Int" && list-length (definition-parameters d) == 0 then Some 0 else
      let function = base (scheme-body (d.scheme)) in
      let ty = arrow-shape function in
      let valid = (case ty of
        UFun domain result -> named domain "Unit" && named result "Int"
        UFunEff domain row result -> named domain "Unit" && named result "Int"
        UPi id name domain row result -> named domain "Unit" && named result "Int"
        other -> False) in
      if not valid then None else if erased-value-arrow function then Some 3
      else if list-length (definition-parameters d) == 1 then Some 1 else if list-length (definition-parameters d) == 0 then Some 2 else None
  -- Resolved source names encode the owner and member separately. In particular,
  -- a dot inside either component cannot be mistaken for the member separator.
  -- Imported externals and instance methods are outside this definition list.
  runtime-entry :: List CoreDefinition -> Option CoreDefinition -> Result (List Diagnostic) (Option CoreDefinition)
  runtime-entry definitions found = case definitions of
    [] -> Ok found
    d : rest -> let name = d.name in
      if not (name == "main" || qualified-entry-name name) then runtime-entry rest found
      else case found of
        None -> runtime-entry rest (Some d)
        Some prior -> case d of
          CoreDefinition sp n scheme openings givens private clauses ->
            Err [Diagnostic "bootstrap.check" sp "several modules of the entry file define `main`; the entry file's `main` is unique"]
  qualified-entry-name :: String -> Bool
  qualified-entry-name name = let bytes = string-to-bytes name in let n = bytes-len bytes in
    n > 7 && bytes-get bytes 0 == 109 && bytes-get bytes 1 == 46 &&
      bytes-get bytes (n - 5) == 46 && bytes-get bytes (n - 4) == 109 && bytes-get bytes (n - 3) == 97 &&
      bytes-get bytes (n - 2) == 105 && bytes-get bytes (n - 1) == 110
  export-symbol-conflict :: String -> List CheckedBinding -> Bool
  export-symbol-conflict symbol bindings = case bindings of
    [] -> False
    binding : rest -> (case checked-foreign-plan binding of
      Some plan | (symbol == plan.symbol) -> True
      other -> export-symbol-conflict symbol rest)

  check-c-export-symbols :: List (String, ForeignPlan) -> List String -> List CheckedBinding -> List Diagnostic
  check-c-export-symbols exports claimed bindings = case exports of
    [] -> []
    (name, plan) : rest -> let tag = plan.symbol in
      if name-listed tag claimed || export-symbol-conflict tag bindings then
        [Diagnostic "bootstrap.check" (Span 0 0 1 1) (cat ["conflicting C symbol for foreign export: ", tag])]
      else check-c-export-symbols rest (tag : claimed) bindings

  check-runtime-entry :: CheckedProgram -> Result (List Diagnostic) CheckedProgram
  check-runtime-entry checked = let typed = checked.elaboration in
    let bindings = elaboration-bindings typed in
    case runtime-entry (elaboration-core typed) None of
      Err errors -> Err errors
      Ok chosen -> (case check-c-export-symbols (checked-c-exports bindings) (case chosen of Some entry -> ["main"]; None -> []) bindings of
        error : rest -> Err (error : rest)
        [] -> (case check-test-boundary checked of
          error : rest -> Err (error : rest)
          [] -> (case chosen of
            None -> Ok checked
            Some d -> (case entry-mode d of
              Some mode -> Ok checked
              None -> (case d of
                CoreDefinition sp name scheme openings givens private clauses -> Err [Diagnostic "bootstrap.check" sp "main must have type Int or Unit ->{e} Int, without external evidence"])))))
  empty-writer :: ProgramInfo -> Writer
  empty-writer info = empty-writer-with-plan info NoInline
  empty-writer-with-plan :: ProgramInfo -> InlinePlan -> Writer
  empty-writer-with-plan info plan =
    Writer 0 (GlobalOutput builder-new hash-map-empty []) builder-new [] (LayoutPlan []) (RuntimeContext info [] [] empty-queue plan)
  -- Reached method vectors grow monotonically in a finite Raw/Obj/TObj
  -- space. Plan to a fixed point before emitting dictionary layouts, so
  -- every instance and every indirect projection uses one class slot table.
  -- The emission of `roots`: tail groups, then worker passes until the
  -- method versions settle. A pass that adds no version ran with exactly
  -- the versions a further pass would start from, so its writer is the
  -- emission itself.
  tail-groups-subset :: List (String, (Nat, Nat)) -> HashMap String (Nat, Nat) -> Bool
  tail-groups-subset pairs target-map = case pairs of
    [] -> True
    (name, (a, b)) : rest -> case hash-map-lookup name target-map of
      Some (x, y) -> a == x && b == y && tail-groups-subset rest target-map
      None -> False

  same-tail-groups :: HashMap String (Nat, Nat) -> HashMap String (Nat, Nat) -> Bool
  same-tail-groups left right =
    let left-rows = hash-map-to-list left in
    let right-rows = hash-map-to-list right in
    list-length left-rows == list-length right-rows && tail-groups-subset left-rows right

  same-method-versions :: List MethodVersion -> List MethodVersion -> Bool
  same-method-versions left right = case left of
    [] -> case right of [] -> True; other -> False
    (MethodVersion a b c) : rest1 -> case right of
      (MethodVersion x y z) : rest2 -> a == x && b == y && same-classes c z && same-method-versions rest1 rest2
      [] -> False

  settled-workers :: List CoreDefinition -> List (String, List Nat) -> ProgramInfo -> Writer
  settled-workers definitions roots info = settled-workers-with-plan NoInline definitions roots info
  settled-workers-with-plan :: InlinePlan -> List CoreDefinition -> List (String, List Nat) -> ProgramInfo -> Writer
  settled-workers-with-plan plan definitions roots info =
    case settled-workers-with-plan-cached default-tuning plan definitions roots info empty-unit-ir-cache hash-map-empty of
      (emitted, cache, emitted-n, reused-n) -> emitted
  settled-workers-with-plan-tuned :: CompileTuning -> InlinePlan -> List CoreDefinition -> List (String, List Nat) -> ProgramInfo -> Writer
  settled-workers-with-plan-tuned tuning plan definitions roots info =
    case settled-workers-with-plan-cached tuning plan definitions roots info empty-unit-ir-cache hash-map-empty of
      (emitted, cache, emitted-n, reused-n) -> emitted
  settled-workers-with-plan-cached :: CompileTuning -> InlinePlan -> List CoreDefinition -> List (String, List Nat) -> ProgramInfo -> UnitIrCache -> HashMap String Nat -> (Writer, UnitIrCache, Nat, Nat)
  settled-workers-with-plan-cached tuning plan definitions roots info cache dirty-names =
    let planned-tails = plan-tail-groups definitions info in
    let new-tails = planned-tails.tail-groups in
    let new-borrows = compute-borrow-modes definitions new-tails in
    let new-consumed = compute-consumed-params definitions new-borrows in
    let new-arenas = compute-arena-phases definitions new-tails in
    let new-concurrent = program-uses-concurrency definitions in
    let new-ownership = OwnershipPlan new-borrows new-consumed new-arenas new-concurrent in
    let planned = with-ownership-plan new-ownership planned-tails in
    let usable = case (plan, cache) of
          (NoInline, UnitIrCache old-units old-tails old-ownership old-versions old-count) ->
            if old-count > 0 && same-tail-groups old-tails new-tails && same-ownership-plan definitions old-ownership new-ownership then
              (old-units, with-versions old-versions planned)
            else (hash-map-empty, planned)
          other -> (hash-map-empty, planned) in
    case usable of
      (seed-units, seeded-info) ->
        settle-method-versions-cached tuning plan definitions roots seeded-info seed-units dirty-names
  settle-method-versions-cached :: CompileTuning -> InlinePlan -> List CoreDefinition -> List (String, List Nat) -> ProgramInfo -> HashMap String EmittedUnit -> HashMap String Nat -> (Writer, UnitIrCache, Nat, Nat)
  settle-method-versions-cached tuning plan definitions roots info seed-units dirty-names =
    case workers-frontier-tuned tuning definitions seed-units dirty-names (demand-roots roots (empty-writer-with-plan info plan)) of
      (emitted, collected, emitted-n, reused-n) ->
        let after-info = writer-program emitted in
        if list-length (after-info.versions) == list-length (info.versions) then
          (emitted, UnitIrCache collected (after-info.tail-groups) (program-ownership after-info) (after-info.versions) (emitted-n + reused-n), emitted-n, reused-n)
        else
          -- Method versions grew: re-settle cleanly without stale cached units.
          settle-method-versions-cached tuning plan definitions roots after-info hash-map-empty dirty-names
  root-symbols :: List (String, List Nat) -> List String
  root-symbols roots = case roots of [] -> []; (name, classes) : rest -> (specialized-name name classes) : (root-symbols rest)
  demand-roots :: List (String, List Nat) -> Writer -> Writer
  demand-roots roots w = case roots of
    [] -> w
    (name, classes) : rest -> demand-roots rest (case constructor name (writer-program w) of
      Some found -> request-demand (ConstructorDemand name classes) w
      None -> demand-worker name classes w)
  -- Group only direct, saturated source calls in return position. An
  -- edge through an erased stage, projected dictionary method, or external
  -- ABI has no shared internal worker. Checked source evidence is a word prefix.
  source-tail-arities :: List CoreDefinition -> Writer -> HashMap String Nat
  source-tail-arities definitions w = case definitions of
    [] -> hash-map-empty
    d : rest ->
      let name = d.name in
      let arity = list-length (definition-parameters d) in
      let arities = source-tail-arities rest w in
      if arity == 0 || arity /= list-length (definition-all-parameters d) || builtin-known name || wide-definition d then arities else
        (case opening-value-types (d.openings) of
          [] -> case field-owner name ((writer-program w).instances) of
            None -> let context = runtime-givens w d in
              if wide-givens context then arities else hash-map-insert name (list-length context + arity) arities
            Some _ -> arities
          other -> arities)

  -- A definition whose own parameters or result are wide scalars: its
  -- arguments do not fit the group's word slots.
  wide-definition :: CoreDefinition -> Bool
  wide-definition d = case d.clauses of
    (CoreClause sp patterns body) : rest -> wide-scalar (core-type body) || wide-patterns patterns
    [] -> False
  wide-patterns :: List CorePattern -> Bool
  wide-patterns patterns = case patterns of [] -> False; first : rest -> wide-scalar (pattern-type first) || wide-patterns rest

  -- | A concrete wide evidence value cannot cross the group's one-word argument slots.
  wide-givens :: List CoreGiven -> Bool
  wide-givens givens = case givens of [] -> False; first : rest -> wide-scalar (first.ty) || wide-givens rest

  source-tail-edges :: HashMap String Nat -> CoreTerm -> List String -> List String
  source-tail-edges arities term next = case term of
    CIf sp ty test yes no -> source-tail-edges arities yes (source-tail-edges arities no next)
    CCase sp ty input alternatives -> source-tail-alternatives arities alternatives next
    CGuard sp ty test body -> source-tail-edges arities body next
    CLet sp ty id name sc value body -> case scoped-partial-name term of
      Some callee -> (case hash-map-lookup callee arities of
        Some arity -> (case fuse-scoped-arity arity term of
          Some fused -> source-tail-edges arities fused next
          None -> source-tail-edges arities body next)
        None -> source-tail-edges arities body next)
      None -> source-tail-edges arities body next
    CWith sp ty given value body -> source-tail-edges arities body next
    CRequire sp ty body -> source-tail-edges arities body next
    CProved sp ty evidence body -> source-tail-edges arities body next
    CRefine sp ty evidence body -> source-tail-edges arities body next
    CRefineProof sp ty evidence body -> source-tail-edges arities body next
    CForget sp ty body -> source-tail-edges arities body next
    CCast sp ty body -> source-tail-edges arities body next
    CDischarge sp ty evidence _ body -> source-tail-edges arities body next
    other -> case head term of
      CUse sp ty name role actuals | role /= "foreign" -> source-tail-edge arities name 0 (arguments term []) next
      CQualifiedUse sp ty name role actuals evidence -> source-tail-edge arities name (list-length evidence) (arguments term []) next
      other -> next

  -- | Count the evidence prefix in a direct source call's uniform tail prototype.
  source-tail-edge :: HashMap String Nat -> String -> Nat -> List CoreTerm -> List String -> List String
  source-tail-edge arities name context args next = case hash-map-lookup name arities of
    Some arity -> if arity == context + list-length args && not (exposed-worker name next) then name : next else next
    None -> next

  source-tail-alternatives :: HashMap String Nat -> CoreTerm -> List String -> List String
  source-tail-alternatives arities alternatives next = case alternatives of
    CAlternative sp pattern body rest -> source-tail-edges arities body (source-tail-alternatives arities rest next)
    other -> next

  source-tail-clauses :: HashMap String Nat -> List CoreClause -> List String
  source-tail-clauses arities clauses = case clauses of
    [] -> []
    (CoreClause sp patterns body) : rest -> source-tail-edges arities body (source-tail-clauses arities rest)

  source-tail-graphs :: List CoreDefinition -> HashMap String Nat -> HashMap String (List String) -> HashMap String (List String) -> List String -> (HashMap String (List String), HashMap String (List String), List String)
  source-tail-graphs definitions arities graph reversed vertices = case definitions of
    [] -> (graph, reversed, vertices)
    d : rest ->
      let name = d.name in
      case hash-map-lookup name arities of
        Some arity ->
          let edges = source-tail-clauses arities (d.clauses) in
          source-tail-graphs rest arities (hash-map-insert name edges graph) (reverse-graph-edges name edges reversed) (name : vertices)
        None -> source-tail-graphs rest arities graph reversed vertices

  tail-group-width :: HashMap String Nat -> List String -> Nat
  tail-group-width arities members = case members of
    [] -> 0
    name : rest ->
      let width = tail-group-width arities rest in
      case hash-map-lookup name arities of Some count -> if count > width then count else width; None -> width

  record-tail-group :: List String -> Nat -> Nat -> HashMap String (Nat, Nat) -> HashMap String (Nat, Nat)
  record-tail-group members group width groups = case members of
    [] -> groups
    name : rest -> record-tail-group rest group width (hash-map-insert name (group, width) groups)

  source-tail-groups :: HashMap String Nat -> HashMap String (List String) -> HashMap String (List String) -> List String -> HashMap String (List String) -> Nat -> HashMap String (Nat, Nat) -> HashMap String (Nat, Nat)
  source-tail-groups arities graph reversed order seen group groups = case order of
    [] -> groups
    name : rest -> case hash-map-lookup name seen of
      Some ignored -> source-tail-groups arities graph reversed rest seen group groups
      None -> case graph-finish-order reversed [name] seen [] of
        (visited, members) ->
          let cyclic = case members of [member] -> exposed-worker member (graph-neighbors graph member); other -> True in
          let planned = if cyclic then record-tail-group members group (tail-group-width arities members) groups else groups in
          source-tail-groups arities graph reversed rest visited (group + 1) planned

  plan-tail-groups :: List CoreDefinition -> ProgramInfo -> ProgramInfo
  plan-tail-groups definitions info =
    let arities = source-tail-arities definitions (empty-writer info) in
    case source-tail-graphs definitions arities hash-map-empty hash-map-empty [] of
      (graph, reversed, vertices) -> case graph-finish-order graph vertices hash-map-empty [] of
        (seen, order) -> with-tail-groups (source-tail-groups arities graph reversed order hash-map-empty 0 hash-map-empty) info

  -- The caller selects checked definitions and explicit Raw/Obj/TObj
  -- specializations. Every root and reached helper uses the same checked
  -- worker/layout planner as an executable, without an entry requirement.
  -- Only selected roots have external linkage. Generated helpers and the
  -- closure dispatcher stay local. Blocks describe themselves, so nothing
  -- about layouts is shared with the provider. Physical ABI metadata is
  -- separate.
  -- The inliner is opt-in, as it is for a program: the plain entries emit
  -- every worker the roots reach, and a `-mode` entry takes the flag.
  emit-runtime-library-with-object :: CheckedProgram -> Option RuntimeObject -> List (String, List Nat) -> Result (List Diagnostic) String
  emit-runtime-library-with-object checked provider roots = emit-runtime-library-with-object-mode False checked provider roots
  emit-runtime-library-with-object-mode :: Bool -> CheckedProgram -> Option RuntimeObject -> List (String, List Nat) -> Result (List Diagnostic) String
  emit-runtime-library-with-object-mode inlining checked provider roots =
    let typed = checked.elaboration in
    let definitions = elaboration-core typed <> instance-definitions (elaboration-instances typed) in
    let info = ProgramInfo (index-data (elaboration-data typed)) (elaboration-classes typed) (elaboration-instances typed) (index-bindings checked definitions) [] provider (Some (root-symbols roots)) (elaboration-effects typed) hash-map-empty True (target-caps-of-wasm False) (elaboration-type-families typed) (elaboration-promoted-fns typed) in
    let plan = inline-plan inlining definitions info in
    let exports = checked-c-exports (elaboration-bindings typed) in
    case workers definitions (foreign-export-bridges exports (settled-workers-with-plan plan definitions (roots <> foreign-export-roots exports) info)) of
      Writer next globals code [] layouts datas -> Ok (cat [declarations, par-preamble info definitions, render-globals globals, apply-entry-with-linkage False "internal ", builder-run code])
      Writer next globals code errors layouts datas -> Err errors
  -- Public ABI bridges and their metadata share this checked physical plan.
  -- The parameter prefix includes eager method values, dictionaries and
  -- quantified value indices; a proof stage returns an owned continuation.
  library-root-shape :: Writer -> CoreDefinition -> List Nat -> Option (List Nat, Nat)
  library-root-shape w d classes = case definition-context d classes w of
    None -> None
    Some context -> case d.clauses of
      [] -> None
      (CoreClause sp patterns body) : rest ->
        let types = value-field-types (definition-value-dependencies w d) <> given-types (runtime-givens w d) <> value-types (opening-value-types (d.openings)) <> pattern-types (definition-parameters d) in
        let result = (case proof-stage-arities patterns 0 of first : second : more -> Some 1; other -> word-class context (core-type body)) in
        case class-vector context types of
          Some params -> case result of
            -- A library bridge and its object closure are word entries.
            Some returned -> if wide-code (returned : params) then None else Some (params, returned)
            None -> None
          None -> None
  library-class :: Nat -> Json
  library-class code = JStr (if code == 0 then "R" else if code == 1 then "O" else if code == 2 then "T" else "W")
  library-classes :: List Nat -> Json
  library-classes codes = case codes of [] -> JArrEnd; first : rest -> JArr (library-class first) (library-classes rest)
  library-unit :: String -> List Nat -> Nat -> Json
  library-unit name params result = JObj "symbol" (JStr name)
    (JObj "closure_entry" (JStr (cat [name, ".object-closure"]))
      (JObj "arity" (JNum (nat-to-int (list-length params)))
        (JObj "params" (library-classes params) (JObj "result" (library-class result) JObjEnd))))
  library-symbol-conflict :: String -> String -> Bool
  library-symbol-conflict a b = a == b || a == cat [b, ".object-closure"] || cat [a, ".object-closure"] == b
  library-root-seen :: String -> List Nat -> String -> List (String, List Nat, String) -> Option Bool
  library-root-seen name classes public seen = case seen of
    [] -> None
    (other, codes, alias) : rest -> if library-symbol-conflict public alias then
      Some (public == alias && name == other && same-classes classes codes)
      else library-root-seen name classes public rest
  library-public-symbol :: String -> Bool
  library-public-symbol name = let bytes = string-to-bytes name in
    bytes-len bytes > 0 && not (library-typed-prefix bytes 0)
  library-typed-prefix :: Bytes -> Nat -> Bool
  library-typed-prefix name index = let prefix = string-to-bytes "cinch.typed." in
    if index >= bytes-len prefix then index == bytes-len prefix else
      index < bytes-len name && bytes-get name index == bytes-get prefix index && library-typed-prefix name (index + 1)
  library-selected-roots :: List (String, List Nat, String) -> List (String, List Nat)
  library-selected-roots roots = case roots of [] -> []; (name, classes, public) : rest -> (name, classes) : (library-selected-roots rest)
  library-bridge :: String -> String -> List Nat -> Writer -> Writer
  library-bridge public worker params w =
    let arguments = value-parameters (list-length params) 0 in
    let started = line (line w (cat ["define i64 ", llvm-object-symbol public, "(", join (argument-words arguments), ")", worker-open w])) "entry:" in
    case call started (symbol worker) arguments of
      (called, value) ->
        let returned = line (line called (cat ["  ret i64 ", value])) "}" in
        let accessor = line (line returned (cat ["define i64 ", llvm-object-symbol (cat [public, ".object-closure"]), "()", worker-open w])) "entry:" in
        -- A closure's description covers at most thirteen parameter classes
        -- (`request-shape`). A root with more is still a root: it can be
        -- called, and a client that would take it as a value is refused
        -- when it is compiled (`external-call-unit`), as the same use is in
        -- a whole program. Its accessor exists because every unit names
        -- one, and nothing reaches it.
        if list-length params > 13 then line (line accessor "  unreachable") "}" else
        case closure (Span 0 0 1 1) worker params [] accessor of
          (ready, closure-value) -> line (line ready (cat ["  ret i64 ", closure-value])) "}"
  library-checked-shape :: List CoreDefinition -> Writer -> String -> List Nat -> Option (List Nat, Nat)
  library-checked-shape definitions w name classes = case worker-definition name w of
    Some d -> library-root-shape w d classes
    None -> case constructor name (writer-program w) of
      Some (owner, tag, c) -> (case data-declaration owner (writer-program w) of
        Some d -> (case constructor-call-context d c classes w of
          Some context -> if not (constructor-supported context d c) then None else
            (case class-vector context (core-constructor-fields c) of Some fields -> Some (fields, data-word-class d); None -> None)
          None -> None)
        None -> None)
      None -> None
  library-bridges :: List CoreDefinition -> List (String, List Nat, String) -> List (String, List Nat, String) -> Writer -> (Writer, Json)
  library-bridges definitions roots seen w = case roots of
    [] -> (w, JArrEnd)
    (name, classes, public) : rest -> case library-root-seen name classes public seen of
      Some True -> library-bridges definitions rest seen w
      Some False -> (refuse w (Span 0 0 1 1) "library ABI export symbols collide", JArrEnd)
      None -> if not (library-public-symbol public) then (refuse w (Span 0 0 1 1) "library ABI export symbol is empty or collides with typed workers", JArrEnd) else
        if (case (worker-definition name w, constructor name (writer-program w)) of (None, None) -> True; other -> False) then
          (refuse w (Span 0 0 1 1) "library ABI root has no checked definition", JArrEnd) else
          case library-checked-shape definitions w name classes of
            None -> (refuse w (Span 0 0 1 1) "library ABI root has no checked physical parameter/result shape", JArrEnd)
            Some (params, result) ->
              let bridged = library-bridge public (specialized-name name classes) params w in
              case library-bridges definitions rest ((name, classes, public) : seen) bridged of
                (done, units) -> (done, JArr (library-unit public params result) units)
  -- Like the Native object collector, every non-generic checked definition
  -- is a physical root. This inventory grants no source visibility: exports
  -- remain in the independently checked interfaces. Do not synthesize a
  -- Cartesian set of variants for generic definitions.
  library-default-definitions :: List CoreDefinition -> Result String (List (String, List Nat, String))
  library-default-definitions definitions = case definitions of
    [] -> Ok []
    d : rest -> case library-default-definitions rest of
      Err message -> Err message
      Ok more -> if type-param-count (scheme-params (d.scheme)) > 0 then Ok more else
        (case export-global (d.name) of
          Err message -> Err message
          Ok public -> if public == "Main.main" then Err "library objects cannot contain the process entry" else Ok ((d.name, [], public) : more))
  -- The exported worker takes ordinary Cinch words. Its body calls the
  -- checked intrinsic or primitive through its own declared machine ABI.
  library-intrinsic-definitions :: List CheckedBinding -> List CoreDefinition
  library-intrinsic-definitions bindings = case bindings of
    [] -> []
    binding : rest -> let more = library-intrinsic-definitions rest in
      let name = checked-name binding in let sc = checked-scheme binding in
      if not (library-source-name name) then more else case (scheme-params sc, scheme-requirements sc) of
        ([], []) -> let sp = Span 0 0 1 1 in let ty = scheme-body sc in
          (case library-primitive-use binding sp ty of
            Some function -> (CoreDefinition sp name sc [] [] [] [library-intrinsic-clause sp 0 ty function []]) : more
            None -> more)
        other -> more
  library-primitive-use :: CheckedBinding -> Span -> UType -> Option CoreTerm
  library-primitive-use binding sp ty = case checked-intrinsic-symbol binding of
    Some symbol | builtin-known symbol -> Some (CUse sp ty symbol "intrinsic" [])
    other -> (case checked-foreign-plan binding of
      Some plan | primitive-object-callable plan -> Some (CUse sp ty (checked-name binding) "foreign" [])
      other -> None)
  library-intrinsic-clause :: Span -> Nat -> UType -> CoreTerm -> List CorePattern -> CoreClause
  library-intrinsic-clause sp id ty function patterns = case ty of
    UFun domain result -> let name = "$arg" <> nat-to-string id in
      library-intrinsic-clause sp (id + 1) result (CApply sp result function (CLocal sp domain id name [])) ((CPVar sp domain id name) : patterns)
    UPi pid pname domain row result -> let name = "$arg" <> nat-to-string id in
      library-intrinsic-clause sp (id + 1) result (CApply sp result function (CLocal sp domain id name [])) ((CPVar sp domain id name) : patterns)
    other -> CoreClause sp (reverse patterns) function
  runtime-library-default-roots :: CheckedProgram -> Result String (List (String, List Nat, String))
  runtime-library-default-roots checked = runtime-library-unit-roots checked []
  runtime-library-unit-roots :: CheckedProgram -> List (String, List Nat) -> Result String (List (String, List Nat, String))
  runtime-library-unit-roots checked demands =
    let typed = checked.elaboration in
    let definitions = elaboration-core typed <> library-intrinsic-definitions (elaboration-bindings typed) in
    let info = ProgramInfo (index-data (elaboration-data typed)) (elaboration-classes typed) (elaboration-instances typed) (index-bindings checked []) [] None (Some []) (elaboration-effects typed) hash-map-empty True (target-caps-of-wasm False) (elaboration-type-families typed) (elaboration-promoted-fns typed) in
    case (library-default-definitions definitions, library-default-constructors (elaboration-data typed) (empty-writer info)) of
      (Ok ordinary, Ok constructors) -> case library-requested-units demands definitions (elaboration-data typed) of
        Ok requested -> Ok (ordinary <> constructors <> requested)
        Err message -> Err message
      (Err message, other) -> Err message
      (other, Err message) -> Err message
  library-requested-units :: List (String, List Nat) -> List CoreDefinition -> List CoreData -> Result String (List (String, List Nat, String))
  library-requested-units demands definitions datas = case demands of
    [] -> Ok []
    (public, codes) : rest -> case library-requested-definition public definitions datas of
      None -> Err ("unknown object unit root " <> public)
      Some (name, count) -> if count /= list-length codes then Err ("wrong class vector length for object unit root " <> public) else
        (case (library-public-name name codes, library-requested-units rest definitions datas) of
          (Ok variant, Ok more) -> Ok ((name, codes, variant) : more)
          (Err message, other) -> Err message
          (other, Err message) -> Err message)
  library-export-matches :: String -> String -> Bool
  library-export-matches public name = library-source-name name && (case export-global name of Ok spelled -> spelled == public; Err message -> False)
  library-requested-definition :: String -> List CoreDefinition -> List CoreData -> Option (String, Nat)
  library-requested-definition public ds datas = case ds of
    d : rest -> if library-export-matches public (d.name) then Some (d.name, type-param-count (scheme-params (d.scheme))) else library-requested-definition public rest datas
    [] -> library-requested-constructor public datas
  library-requested-constructor :: String -> List CoreData -> Option (String, Nat)
  library-requested-constructor public datas = case datas of
    [] -> None
    d : rest -> case library-match-constructor public (core-data-constructors d) of
      Some name -> Some (name, type-param-count (core-data-params d))
      None -> library-requested-constructor public rest
  library-match-constructor :: String -> List CoreConstructor -> Option String
  library-match-constructor public cs = case cs of
    [] -> None
    c : rest -> if library-export-matches public (c.constructor-name) then Some (c.constructor-name) else library-match-constructor public rest
  library-source-name :: String -> Bool
  library-source-name name = let bytes = string-to-bytes name in
    bytes-len bytes > 2 && bytes-get bytes 0 == 109 && bytes-get bytes 1 == 46
  library-default-constructors :: List CoreData -> Writer -> Result String (List (String, List Nat, String))
  library-default-constructors datas w = case datas of
    [] -> Ok []
    d : rest -> case library-default-constructors rest w of
      Err message -> Err message
      Ok more -> if not (library-source-name (core-data-name d)) then Ok more else library-default-data-constructors d (core-data-constructors d) w more
  library-default-data-constructors :: CoreData -> List CoreConstructor -> Writer -> List (String, List Nat, String) -> Result String (List (String, List Nat, String))
  library-default-data-constructors d constructors w more = case constructors of
    [] -> Ok more
    c : rest -> case library-default-data-constructors d rest w more of
      Err message -> Err message
      Ok tail -> case class-vector (w.context) (core-constructor-fields c) of
        None -> Ok tail
        Some fields -> case export-global (c.constructor-name) of
          Err message -> Err message
          Ok public -> Ok ((c.constructor-name, default-own (core-data-params d), public) : tail)

  -- The named layout cache is the authority for emitted nominal descriptors.
  -- Decode only the planner's own representation suffix, never source text.
  library-key-prefix :: Bytes -> Bytes -> Nat -> Bool
  library-key-prefix prefix key index = if index >= bytes-len prefix then True else
    index < bytes-len key && bytes-get prefix index == bytes-get key index && library-key-prefix prefix key (index + 1)
  library-key-codes :: Bytes -> Nat -> Option (List Nat)
  library-key-codes key index = if index < bytes-len key then
    (let byte = bytes-get key index in if byte < 48 || byte > 51 then None else case library-key-codes key (index + 1) of
      None -> None
      Some rest -> Some ((byte - 48) : rest))
    else if index == bytes-len key then Some [] else None
  library-key-classes :: String -> String -> Option (List Nat)
  library-key-classes name key = if name == key then Some [] else
    let prefix = string-to-bytes (cat [name, ".r"]) in let bytes = string-to-bytes key in
    if bytes-len bytes <= bytes-len prefix || not (library-key-prefix prefix bytes 0) then None else library-key-codes bytes (bytes-len prefix)
  library-layout-data :: String -> List CoreData -> Option (CoreData, List Nat)
  library-layout-data key datas = case datas of
    [] -> None
    d : rest -> case library-key-classes (core-data-name d) key of
      Some codes -> Some (d, codes)
      None -> library-layout-data key rest
  library-public-name :: String -> List Nat -> Result String String
  library-public-name name codes = case export-global name of
    Err message -> Err message
    Ok public -> Ok (cat [public, if list-length codes == 0 then "" else cat ["@", native-classes codes]])
  -- A constructor's facts, as the seed's object ABI states them: its tag,
  -- arity, header layout field and whether the block is escaped.
  library-constructor-facts :: CoreData -> List Nat -> List Nat -> Nat -> List CoreConstructor -> Json -> Json
  library-constructor-facts d codes descriptions tag constructors rest = case constructors of
    [] -> rest
    c : more -> case library-public-name (c.constructor-name) codes of
      Err message -> library-constructor-facts d codes descriptions (tag + 1) more rest
      Ok public -> let description = data-descriptor descriptions tag in
        let physical = (case core-data-layout d of UnpackedRecord slots -> public <> "$unpacked"; other -> public) in
        JObj physical (JObj "tag" (JNum (nat-to-int tag))
        (JObj "arity" (JNum (nat-to-int (list-length (storage-fields d c))))
          (JObj "descriptor" (JNum (nat-to-int (description-field description)))
            (JObj "escaped" (JBool (description-escaped description)) JObjEnd))))
        (library-constructor-facts d codes descriptions (tag + 1) more rest)
  library-constructor-layout-facts :: List (String, List Nat) -> List CoreData -> Json
  library-constructor-layout-facts names datas = case names of
    [] -> JObjEnd
    (key, descriptor) : rest -> case library-layout-data key datas of
      None -> library-constructor-layout-facts rest datas
      Some (d, codes) -> library-constructor-facts d codes descriptor 0 (core-data-constructors d) (library-constructor-layout-facts rest datas)
  library-method-slot-facts :: List MethodSlot -> Json
  library-method-slot-facts plans = case plans of
    [] -> JArrEnd
    (MethodSlot logical physical own-codes) : rest -> JArr (JObj "logical" (JNum (nat-to-int logical))
      (JObj "physical" (JNum (nat-to-int physical)) (JObj "own" (JStr (native-classes own-codes)) JObjEnd))) (library-method-slot-facts rest)
  library-method-family-facts :: Writer -> List CoreClass -> Json
  library-method-family-facts w descriptions = case descriptions of
    [] -> JArrEnd
    description : rest -> case export-global (description.name) of
      Err message -> library-method-family-facts w rest
      Ok public -> JArr (JObj "class" (JStr public)
        (JObj "declared_methods" (JNum (nat-to-int (list-length (description.methods))))
          (JObj "slots" (library-method-slot-facts (class-method-slots w description)) JObjEnd))) (library-method-family-facts w rest)
  library-object-facts :: Writer -> Json
  library-object-facts w = case w of
    Writer next globals code errors (LayoutPlan names) context ->
      let datas = program-data (writer-program w) in
      let dictionary-demand = (case context of RuntimeContext info bounds rigids (WorkerQueue pending keys emitted scope serial unit-mode) inlining -> emitted) in
      JObj "method_families" (library-method-family-facts w ((writer-program w).classes)) (JObj "unpublished_dictionaries" (JBool dictionary-demand)
        (JObj "constructors" (library-constructor-layout-facts names datas) JObjEnd))

  -- The alias in each root is a physical symbol chosen by the caller from
  -- checked export identities. The pipeline owns that source-name authority.
  -- These are physical unit/layout facts, not a completed object manifest.
  emit-runtime-library-artifact-with-object :: CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, Json)
  emit-runtime-library-artifact-with-object checked provider roots = case emit-runtime-library-artifact True False checked provider roots of
    Err errors -> Err errors
    Ok (ir, units, facts) -> Ok (ir, units)
  -- An object's facts are what a consumer's manifest records for it.
  emit-runtime-library-object-with-object :: CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, Json, Json)
  emit-runtime-library-object-with-object checked provider roots = emit-runtime-library-artifact False False checked provider roots
  -- The inlining switch is the plan's first field: a measured run takes the
  -- same library with the copies turned off.
  emit-runtime-library-object-with-object-mode :: Bool -> CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, Json, Json)
  emit-runtime-library-object-with-object-mode inlining checked provider roots = emit-runtime-library-artifact False inlining checked provider roots
  emit-runtime-library-artifact-with-object-mode :: Bool -> CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, Json)
  emit-runtime-library-artifact-with-object-mode inlining checked provider roots = case emit-runtime-library-artifact True inlining checked provider roots of
    Err errors -> Err errors
    Ok (ir, units, facts) -> Ok (ir, units)
  -- `artifact` is a bare artifact (IR and units); otherwise the result also
  -- carries the object's facts.
  emit-runtime-library-artifact :: Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, Json, Json)
  emit-runtime-library-artifact artifact inlining checked provider roots =
    emit-runtime-library-artifact-for-target "" False artifact inlining checked provider roots
  emit-runtime-library-artifact-for-profile :: TargetProfile -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, Json, Json)
  emit-runtime-library-artifact-for-profile profile artifact inlining checked provider roots =
    emit-runtime-library-artifact-for-profile-tuned default-tuning profile artifact inlining checked provider roots
  emit-runtime-library-artifact-for-profile-tuned :: CompileTuning -> TargetProfile -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, Json, Json)
  emit-runtime-library-artifact-for-profile-tuned tuning profile artifact inlining checked provider roots =
    emit-runtime-library-artifact-for-caps tuning (target-ir-header profile) (target-caps-of-profile profile) artifact inlining checked provider roots
  emit-runtime-library-artifact-for-target :: String -> Bool -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, Json, Json)
  emit-runtime-library-artifact-for-target header wasm32 artifact inlining checked provider roots =
    emit-runtime-library-artifact-for-caps default-tuning header (target-caps-of-wasm wasm32) artifact inlining checked provider roots
  emit-runtime-library-artifact-for-caps :: CompileTuning -> String -> TargetCaps -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, Json, Json)
  emit-runtime-library-artifact-for-caps tuning header caps artifact inlining checked provider roots =
    let wasm32 = caps.caps-arch == "wasm32" in
    let typed = checked.elaboration in
    let definitions = elaboration-core typed <> library-intrinsic-definitions (elaboration-bindings typed) <> instance-definitions (elaboration-instances typed) in
    let selected = library-selected-roots roots in
    let info = ProgramInfo (index-data (elaboration-data typed)) (elaboration-classes typed) (elaboration-instances typed) (index-bindings checked definitions) [] provider (Some []) (elaboration-effects typed) hash-map-empty True caps (elaboration-type-families typed) (elaboration-promoted-fns typed) in
    let plan = inline-plan inlining definitions info in
    let exports = checked-c-exports (elaboration-bindings typed) in
    case library-bridges definitions roots [] (foreign-export-bridges exports (settled-workers-with-plan-tuned tuning plan definitions (selected <> foreign-export-roots exports) info)) of
      (bridged, units) -> case workers definitions bridged of
        Writer next globals code [] layouts context ->
          let ir = cat [header, declarations-counting wasm32 False True, par-preamble info definitions, render-globals globals, apply-entry-with-linkage wasm32 "internal ", builder-run code] in
          Ok (ir, units, if artifact then JObjEnd else library-object-facts (Writer next globals code [] layouts context))
        Writer next globals code errors layouts context -> Err errors
  emit-runtime-program :: CheckedProgram -> Result (List Diagnostic) String
  emit-runtime-program checked = emit-runtime-program-with-object checked None
  emit-runtime-program-mode :: Bool -> Bool -> CheckedProgram -> Result (List Diagnostic) String
  emit-runtime-program-mode inlining reclaim checked = emit-runtime-program-with-object-mode inlining reclaim checked None
  emit-runtime-program-with-object :: CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-runtime-program-with-object checked provider = emit-runtime-program-counting False True checked provider
  emit-runtime-program-with-object-mode :: Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-runtime-program-with-object-mode inlining reclaim checked provider = emit-runtime-program-counting-mode inlining False reclaim checked provider
  -- A debug-counting program routes its own count operations through the
  -- runtime's checked entries; a linked provider object keeps the counts
  -- it was compiled with. The inliner is opt-in, so the plain entry emits
  -- every worker a root reaches and a `-mode` entry takes the flag.
  emit-runtime-program-counting :: Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-runtime-program-counting debug reclaim checked provider = emit-runtime-program-counting-mode False debug reclaim checked provider
  emit-runtime-program-counting-mode :: Bool -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-runtime-program-counting-mode inlining debug reclaim checked provider =
    emit-runtime-program-for-target "" False inlining debug reclaim checked provider
  emit-runtime-program-for-profile :: TargetProfile -> Bool -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-runtime-program-for-profile profile inlining debug reclaim checked provider =
    emit-runtime-program-for-profile-tuned default-tuning profile inlining debug reclaim checked provider
  emit-runtime-program-for-profile-tuned :: CompileTuning -> TargetProfile -> Bool -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-runtime-program-for-profile-tuned tuning profile inlining debug reclaim checked provider =
    case emit-runtime-program-for-profile-cached tuning profile inlining debug reclaim checked provider empty-unit-ir-cache hash-map-empty of
      Err errors -> Err errors
      Ok (ir, cache, emitted-n, reused-n) -> Ok ir
  emit-runtime-program-for-profile-cached :: CompileTuning -> TargetProfile -> Bool -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> UnitIrCache -> HashMap String Nat -> Result (List Diagnostic) (String, UnitIrCache, Nat, Nat)
  emit-runtime-program-for-profile-cached tuning profile inlining debug reclaim checked provider cache dirty-names =
    emit-runtime-program-for-caps-cached tuning (target-ir-header profile) (target-caps-of-profile profile) inlining debug reclaim checked provider cache dirty-names
  emit-runtime-program-for-target :: String -> Bool -> Bool -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-runtime-program-for-target header wasm32 inlining debug reclaim checked provider =
    case emit-runtime-program-for-caps-cached default-tuning header (target-caps-of-wasm wasm32) inlining debug reclaim checked provider empty-unit-ir-cache hash-map-empty of
      Err errors -> Err errors
      Ok (ir, cache, emitted-n, reused-n) -> Ok ir
  emit-runtime-program-for-caps-cached :: CompileTuning -> String -> TargetCaps -> Bool -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> UnitIrCache -> HashMap String Nat -> Result (List Diagnostic) (String, UnitIrCache, Nat, Nat)
  emit-runtime-program-for-caps-cached tuning header caps inlining debug reclaim checked provider cache dirty-names =
    let wasm32 = caps.caps-arch == "wasm32" in
    let typed = checked.elaboration in
    let raw-definitions = elaboration-core typed <> instance-definitions (elaboration-instances typed) in
    let datas = elaboration-data typed in
    let binding-names = map checked-name (elaboration-bindings typed) in
    let definitions = lower-ad-program datas (elaboration-type-families typed) (elaboration-promoted-fns typed) binding-names raw-definitions in
    let info = ProgramInfo (index-data datas) (elaboration-classes typed) (elaboration-instances typed) (index-bindings checked definitions) [] provider None (elaboration-effects typed) hash-map-empty reclaim caps (elaboration-type-families typed) (elaboration-promoted-fns typed) in
    let exports = checked-c-exports (elaboration-bindings typed) in
    let roots = foreign-export-roots exports in
    let plan = inline-plan inlining definitions info in
    let concurrent = program-uses-concurrency definitions in
    let finish = \writer next-cache emitted-n reused-n suffix -> case workers definitions (foreign-export-bridges exports writer) of
          Writer next globals code [] layouts context -> Ok (cat [header, declarations-counting-mt wasm32 debug reclaim concurrent, par-preamble info definitions, render-globals globals, apply-entry-with-linkage wasm32 "", builder-run code, suffix], next-cache, emitted-n, reused-n)
          Writer next globals code errors layouts context -> Err errors in
    case runtime-entry (elaboration-core typed) None of
      Err errors -> Err errors
      Ok None -> (case exports of
        [] -> Err [Diagnostic "bootstrap.runtime-ir" (Span 0 0 1 1) "runtime entry has no main definition"]
        other -> case settled-workers-with-plan-cached tuning plan definitions roots info cache dirty-names of
          (settled, next-cache, emitted-n, reused-n) -> finish settled next-cache emitted-n reused-n "")
      Ok (Some d) -> case entry-mode d of
        None -> Err [Diagnostic "bootstrap.runtime-ir" (Span 0 0 1 1) "runtime entry must be main :: Int or Unit -> Int, optionally effectful, without external evidence"]
        Some mode -> let name = d.name in
          case settled-workers-with-plan-cached tuning plan definitions ((name, []) : roots) info cache dirty-names of
            (settled, next-cache, emitted-n, reused-n) ->
              let ready = case constructor name info of Some found -> workers definitions (demand-worker name [] settled); None -> settled in
              finish ready next-cache emitted-n reused-n (entry wasm32 name mode reclaim)

  -- ------------------------------------------------------------------
  -- Test pragmas: boundary enforcement, discovery, and single-binary
  -- nextest-style test harness code generation.
  -- ------------------------------------------------------------------

  data TestReturnKind where
    TRInt :: TestReturnKind
    TRBool :: TestReturnKind
    TRUnit :: TestReturnKind
    TRResult :: Bool -> TestReturnKind
    TRCheck :: TestReturnKind
    TRCheckList :: TestReturnKind

  data DiscoveredTest where
    MkDiscoveredTest :: Nat -> String -> String -> String -> Nat -> Bool -> TestReturnKind -> TestSpec -> DiscoveredTest

  test-index :: DiscoveredTest -> Nat
  test-index t = case t of MkDiscoveredTest i cn md dn m io rk sp -> i
  test-core-name :: DiscoveredTest -> String
  test-core-name t = case t of MkDiscoveredTest i cn md dn m io rk sp -> cn
  test-module-name :: DiscoveredTest -> String
  test-module-name t = case t of MkDiscoveredTest i cn md dn m io rk sp -> md
  test-display-name :: DiscoveredTest -> String
  test-display-name t = case t of MkDiscoveredTest i cn md dn m io rk sp -> dn
  test-call-mode :: DiscoveredTest -> Nat
  test-call-mode t = case t of MkDiscoveredTest i cn md dn m io rk sp -> m
  test-needs-io :: DiscoveredTest -> Bool
  test-needs-io t = case t of MkDiscoveredTest i cn md dn m io rk sp -> io
  test-return-kind :: DiscoveredTest -> TestReturnKind
  test-return-kind t = case t of MkDiscoveredTest i cn md dn m io rk sp -> rk
  test-spec :: DiscoveredTest -> TestSpec
  test-spec t = case t of MkDiscoveredTest i cn md dn m io rk sp -> sp

  collect-program-test-attrs :: List Module -> List (Span, String, TestSpec)
  collect-program-test-attrs ms = case ms of
    [] -> []
    m : rest -> declaration-test-attrs (module-decls m) <> collect-program-test-attrs rest

  index-test-names :: List (Span, String, TestSpec) -> HashMap String Bool -> HashMap String Bool
  index-test-names attrs acc = case attrs of
    [] -> acc
    (sp, name, tspec) : rest -> index-test-names rest (hash-map-insert name True acc)

  display-global-name :: String -> String
  display-global-name name = case export-global name of
    Ok pub -> pub
    Err _ -> name

  split-last-dot-loop :: List Char -> List Char -> Option (List Char, List Char) -> Option (String, String)
  split-last-dot-loop cs before best = case cs of
    [] -> case best of
      None -> None
      Some (lhs, rhs) -> Some (pack (reverse lhs), pack rhs)
    ch : rest ->
      let next-best = if char-code ch == 46 then Some (before, rest) else best in
      split-last-dot-loop rest (ch : before) next-best

  split-module-member :: String -> (String, String)
  split-module-member full = case split-last-dot-loop (unpack full) [] None of
    Some (m, fn) -> (m, full)
    None -> ("Main", full)

  term-test-boundary-errors :: String -> HashMap String Bool -> CoreTerm -> List Diagnostic
  term-test-boundary-errors caller test-set term = case term of
    CUse sp ty name role actuals -> case hash-map-lookup name test-set of
      Some _ -> [Diagnostic "bootstrap.check" sp (cat ["production definition `", display-global-name caller, "` cannot reference test-only definition `", display-global-name name, "`"])]
      None -> []
    CQualifiedUse sp ty name role actuals evs -> case hash-map-lookup name test-set of
      Some _ -> [Diagnostic "bootstrap.check" sp (cat ["production definition `", display-global-name caller, "` cannot reference test-only definition `", display-global-name name, "`"])]
      None -> []
    CApply sp ty f x -> term-test-boundary-errors caller test-set f <> term-test-boundary-errors caller test-set x
    CApplyEff sp ty row f x -> term-test-boundary-errors caller test-set f <> term-test-boundary-errors caller test-set x
    CErasedApply sp ty row f x -> term-test-boundary-errors caller test-set f <> term-test-boundary-errors caller test-set x
    CDecision sp ty prop inner -> term-test-boundary-errors caller test-set inner
    CScope sp ty r ev body -> term-test-boundary-errors caller test-set body
    CMemoScope sp ty r body -> term-test-boundary-errors caller test-set body
    CSpawn sp ty scope body -> term-test-boundary-errors caller test-set scope <> term-test-boundary-errors caller test-set body
    CJoin sp ty scope hs -> term-test-boundary-errors caller test-set scope <> term-test-boundary-errors caller test-set hs
    CWith sp ty g val body -> term-test-boundary-errors caller test-set val <> term-test-boundary-errors caller test-set body
    CHandler sp ty ret ops -> term-test-boundary-errors caller test-set ret <> term-test-boundary-errors caller test-set ops
    CHandle sp ty r eff h body -> term-test-boundary-errors caller test-set h <> term-test-boundary-errors caller test-set body
    CHandlerOperation sp slot ps rt body rest -> term-test-boundary-errors caller test-set body <> term-test-boundary-errors caller test-set rest
    CLambda sp ty pat body -> term-test-boundary-errors caller test-set body
    CLet sp ty id n sc rhs body -> term-test-boundary-errors caller test-set rhs <> term-test-boundary-errors caller test-set body
    CRecursiveFunctions sp ty binds body -> term-test-boundary-errors caller test-set binds <> term-test-boundary-errors caller test-set body
    CRecursiveValues sp ty r binds body -> term-test-boundary-errors caller test-set binds <> term-test-boundary-errors caller test-set body
    CRecursiveBinding id n val rest -> term-test-boundary-errors caller test-set val <> term-test-boundary-errors caller test-set rest
    CIf sp ty cond yes no -> term-test-boundary-errors caller test-set cond <> term-test-boundary-errors caller test-set yes <> term-test-boundary-errors caller test-set no
    CCase sp ty scrut alts -> term-test-boundary-errors caller test-set scrut <> term-test-boundary-errors caller test-set alts
    CTuple sp ty items -> term-test-boundary-errors caller test-set items
    CPolyIntro sp ty rs body -> term-test-boundary-errors caller test-set body
    CPolyElim sp ty inner args -> term-test-boundary-errors caller test-set inner
    CPrimitive sp ty op args -> term-test-boundary-errors caller test-set args
    CProved sp ty pf inner -> term-test-boundary-errors caller test-set inner
    CRefine sp ty pf inner -> term-test-boundary-errors caller test-set inner
    CRefineProof sp ty pf inner -> term-test-boundary-errors caller test-set inner
    CForget sp ty inner -> term-test-boundary-errors caller test-set inner
    CCast sp ty inner -> term-test-boundary-errors caller test-set inner
    CRequire sp ty inner -> term-test-boundary-errors caller test-set inner
    CDischarge sp ty pfs flag inner -> term-test-boundary-errors caller test-set inner
    CGuard sp ty g body -> term-test-boundary-errors caller test-set g <> term-test-boundary-errors caller test-set body
    CArgument sp a rest -> term-test-boundary-errors caller test-set a <> term-test-boundary-errors caller test-set rest
    CAlternative sp pat body rest -> term-test-boundary-errors caller test-set body <> term-test-boundary-errors caller test-set rest
    other -> []

  clauses-test-boundary-errors :: String -> HashMap String Bool -> List CoreClause -> List Diagnostic
  clauses-test-boundary-errors caller test-set clauses = case clauses of
    [] -> []
    (CoreClause _ _ body) : rest -> term-test-boundary-errors caller test-set body <> clauses-test-boundary-errors caller test-set rest

  defs-test-boundary-errors :: HashMap String Bool -> List CoreDefinition -> List Diagnostic
  defs-test-boundary-errors test-set defs = case defs of
    [] -> []
    d : rest ->
      let name = d.name in
      let self-errs = case hash-map-lookup name test-set of
            Some _ -> []
            None -> clauses-test-boundary-errors name test-set d.clauses in
      self-errs <> defs-test-boundary-errors test-set rest

  check-test-boundary :: CheckedProgram -> List Diagnostic
  check-test-boundary checked =
    let attrs = collect-program-test-attrs checked.surface.modules in
    case attrs of
      [] -> []
      _ : _ ->
        let test-set = index-test-names attrs hash-map-empty in
        defs-test-boundary-errors test-set (elaboration-core checked.elaboration)

  -- Classify supported #[test] return types:
  -- Int, Bool, Unit, Result e a, Effect.Test.Check, List Effect.Test.Check.
  is-string-type :: UType -> Bool
  is-string-type ty =
    let b = base ty in
    named b "String" || (case b of
      UCon n _ -> display-global-name n == "Data.String.String" || n == "String"
      other -> False)

  is-check-type :: UType -> Bool
  is-check-type ty = case base ty of
    UCon n _ -> display-global-name n == "Effect.Test.Check"
    other -> False

  classify-test-return :: UType -> Option TestReturnKind
  classify-test-return ty =
    let b = base ty in
    if named b "Int" then Some TRInt
    else if named b "Bool" then Some TRBool
    else if named b "Unit" then Some TRUnit
    else if is-check-type b then Some TRCheck
    else case b of
      UApp (UApp (UCon head _) err-ty) ok-ty ->
        if head == global-data-core-result || display-global-name head == "Data.Core.Result" || display-global-name head == "Data.Result.Result"
          then Some (TRResult (is-string-type err-ty))
          else None
      UApp (UCon head _) elem-ty ->
        if (head == global-data-core-list || display-global-name head == "Data.Core.List") && is-check-type elem-ty
          then Some TRCheckList
          else None
      other -> None

  is-io-given :: CoreGiven -> Bool
  is-io-given g = case base g.ty of
    UApp (UCon name kind) region -> name == "b.Io" && kind-equal (type-kind region) KRegion
    other -> False

  test-givens-io :: List CoreGiven -> Option Bool
  test-givens-io gs = case gs of
    [] -> Some False
    [g] -> if is-io-given g then Some True else None
    other -> None

  test-entry-shape :: CoreDefinition -> Option (Nat, Bool, TestReturnKind)
  test-entry-shape d =
    if not (entry-parameters (scheme-params d.scheme)) then None
    else case test-givens-io d.givens of
      None -> None
      Some needs-io ->
        let body-ty = scheme-body d.scheme in
        case classify-test-return body-ty of
          Some rk | list-length (definition-parameters d) == 0 -> Some (0, needs-io, rk)
          other ->
            let function = base body-ty in
            let ty = arrow-shape function in
            let maybe-ret = (case ty of
              UFun domain result -> if named domain "Unit" then classify-test-return result else None
              UFunEff domain row result -> if named domain "Unit" then classify-test-return result else None
              UPi id name domain row result -> if named domain "Unit" then classify-test-return result else None
              other -> None) in
            case maybe-ret of
              None -> None
              Some rk ->
                if erased-value-arrow function then Some (3, needs-io, rk)
                else if list-length (definition-parameters d) == 1 then Some (1, needs-io, rk)
                else if list-length (definition-parameters d) == 0 then Some (2, needs-io, rk)
                else None

  index-core-defs :: List CoreDefinition -> HashMap String CoreDefinition -> HashMap String CoreDefinition
  index-core-defs defs acc = case defs of
    [] -> acc
    d : rest -> index-core-defs rest (hash-map-insert d.name d acc)

  discover-tests-loop :: List (Span, String, TestSpec) -> HashMap String CoreDefinition -> Nat -> List DiscoveredTest -> List Diagnostic -> Result (List Diagnostic) (List DiscoveredTest)
  discover-tests-loop attrs def-map next-idx found errors = case attrs of
    [] -> case errors of
      [] -> Ok (reverse found)
      _ : _ -> Err (reverse errors)
    (sp, name, tspec) : rest ->
      if not (test-spec-is-test tspec) then discover-tests-loop rest def-map next-idx found errors
      else case hash-map-lookup name def-map of
        None -> discover-tests-loop rest def-map next-idx found
          ((Diagnostic "bootstrap.test" sp (cat ["#[test] target `", display-global-name name, "` has no definition"])) : errors)
        Some d -> case test-entry-shape d of
          None -> discover-tests-loop rest def-map next-idx found
            ((Diagnostic "bootstrap.test" sp (cat ["#[test] function `", display-global-name name, "` must have type Unit -> Int|Bool|Unit|Result e a|Check|List Check (optionally with `using (io :: Io r) =>`)"])) : errors)
          Some (mode, needs-io, rk) ->
            let full = display-global-name name in
            let (mod-name, disp-name) = split-module-member full in
            let item = MkDiscoveredTest next-idx name mod-name disp-name mode needs-io rk tspec in
            discover-tests-loop rest def-map (next-idx + 1) (item : found) errors

  discover-tests :: CheckedProgram -> Result (List Diagnostic) (List DiscoveredTest)
  discover-tests checked =
    let attrs = collect-program-test-attrs checked.surface.modules in
    let def-map = index-core-defs (elaboration-core checked.elaboration) hash-map-empty in
    discover-tests-loop attrs def-map 0 [] []

  test-harness-parse-ir :: Bool -> String
  test-harness-parse-ir wasm32 = cat [
    "@cinch.test.selected = internal global i64 -1\n",
    "@cinch.test.str.nl = private unnamed_addr constant [1 x i8] c\"\\0A\"\n",
    "@cinch.test.str.fail_prefix = private unnamed_addr constant [6 x i8] c\"FAIL [\"\n",
    "@cinch.test.str.fail_mid = private unnamed_addr constant [3 x i8] c\"]: \"\n",
    if wasm32 then "" else "declare i32 @setitimer(i32, ptr, ptr)\n",
    "define internal i64 @cinch.test.parse_i64(ptr %s)", function-open wasm32, "\nentry:\n",
    "  %first = load i8, ptr %s\n",
    "  %empty = icmp eq i8 %first, 0\n",
    "  br i1 %empty, label %bad, label %loop\n",
    "loop:\n",
    "  %p = phi ptr [ %s, %entry ], [ %next, %step ]\n",
    "  %acc = phi i64 [ 0, %entry ], [ %acc2, %step ]\n",
    "  %ch = load i8, ptr %p\n",
    "  %done = icmp eq i8 %ch, 0\n",
    "  br i1 %done, label %ok, label %check\n",
    "check:\n",
    "  %ge0 = icmp uge i8 %ch, 48\n",
    "  %le9 = icmp ule i8 %ch, 57\n",
    "  %dig = and i1 %ge0, %le9\n",
    "  br i1 %dig, label %step, label %bad\n",
    "step:\n",
    "  %d8 = sub i8 %ch, 48\n",
    "  %d64 = zext i8 %d8 to i64\n",
    "  %mul = mul i64 %acc, 10\n",
    "  %acc2 = add i64 %mul, %d64\n",
    "  %next = getelementptr i8, ptr %p, i64 1\n",
    "  br label %loop\n",
    "ok:\n",
    "  ret i64 %acc\n",
    "bad:\n",
    "  ret i64 -1\n}\n"
  ]

  test-harness-timeout-ir :: Bool -> String
  test-harness-timeout-ir wasm32 =
    let head = cat ["define internal void @cinch.test.arm_timeout(i64 %ms)", function-open wasm32, "\nentry:\n"] in
    if wasm32 then head <> "  ret void\n}\n" else head <> cat [
      "  %armed = icmp sgt i64 %ms, 0\n",
      "  br i1 %armed, label %set, label %done\n",
      "set:\n",
      "  %itv = alloca [4 x i64], align 8\n",
      "  store [4 x i64] zeroinitializer, ptr %itv, align 8\n",
      "  %sec = udiv i64 %ms, 1000\n",
      "  %rem = urem i64 %ms, 1000\n",
      "  %usec64 = mul i64 %rem, 1000\n",
      "  %usec32 = trunc i64 %usec64 to i32\n",
      "  %psec = getelementptr i8, ptr %itv, i64 16\n",
      "  store i64 %sec, ptr %psec, align 8\n",
      "  %pusec = getelementptr i8, ptr %itv, i64 24\n",
      "  store i32 %usec32, ptr %pusec, align 4\n",
      "  call i32 @setitimer(i32 0, ptr %itv, ptr null)\n",
      "  br label %done\n",
      "done:\n",
      "  ret void\n}\n"
    ]

  test-harness-io-ir :: Bool -> Bool -> String
  test-harness-io-ir wasm32 reclaim =
    let drop-line = \v -> if reclaim then cat ["  call void @cinch.typed.rc.drop(i64 ", v, ")\n"] else "" in
    cat [
      "define internal void @cinch.test.write_cstr(ptr %p, i64 %n)", function-open wasm32, "\nentry:\n",
      "  %b = call i64 @cinch_bytes_from_data(ptr %p, i64 %n)\n",
      "  call i64 @cinch_io_write(i64 %b)\n",
      drop-line "%b",
      "  ret void\n}\n",
      "define internal void @cinch.test.write_str(i64 %s)", function-open wasm32, "\nentry:\n",
      "  %sp = inttoptr i64 %s to ptr\n",
      "  %bytes = load i64, ptr %sp, align 8\n",
      "  call i64 @cinch_io_write(i64 %bytes)\n",
      "  ret void\n}\n",
      "define internal i64 @cinch.test.read_tag(i64 %w)", function-open wasm32, "\nentry:\n",
      "  %p = inttoptr i64 %w to ptr\n",
      "  %hp = getelementptr i64, ptr %p, i64 -1\n",
      "  %h = load i64, ptr %hp, align 8\n",
      "  %s = lshr i64 %h, 40\n",
      "  %t = and i64 %s, 255\n",
      "  ret i64 %t\n}\n"
    ]

  test-harness-result-ir :: Bool -> Bool -> String
  test-harness-result-ir wasm32 reclaim =
    let drop-line = \v -> if reclaim then cat ["  call void @cinch.typed.rc.drop(i64 ", v, ")\n"] else "" in
    cat [
      "define internal i64 @cinch.test.check_result(i64 %res, i1 %print_err)", function-open wasm32, "\nentry:\n",
      "  %tag = call i64 @cinch.test.read_tag(i64 %res)\n",
      "  %is_ok = icmp eq i64 %tag, 1\n",
      "  br i1 %is_ok, label %ok, label %err\n",
      "err:\n",
      "  br i1 %print_err, label %show, label %done_err\n",
      "show:\n",
      "  %rp = inttoptr i64 %res to ptr\n",
      "  %msg = load i64, ptr %rp, align 8\n",
      "  call void @cinch.test.write_str(i64 %msg)\n",
      "  call void @cinch.test.write_cstr(ptr @cinch.test.str.nl, i64 1)\n",
      "  br label %done_err\n",
      "done_err:\n",
      drop-line "%res",
      "  ret i64 1\n",
      "ok:\n",
      drop-line "%res",
      "  ret i64 0\n}\n"
    ]

  test-harness-checks-ir :: Bool -> Bool -> String
  test-harness-checks-ir wasm32 reclaim =
    let drop-line = \v -> if reclaim then cat ["  call void @cinch.typed.rc.drop(i64 ", v, ")\n"] else "" in
    cat [
      "define internal i64 @cinch.test.check_one_nodrop(i64 %chk)", function-open wasm32, "\nentry:\n",
      "  %tag = call i64 @cinch.test.read_tag(i64 %chk)\n",
      "  %is_pass = icmp eq i64 %tag, 0\n",
      "  br i1 %is_pass, label %pass, label %fail\n",
      "fail:\n",
      "  %cp = inttoptr i64 %chk to ptr\n",
      "  %lbl = load i64, ptr %cp, align 8\n",
      "  %mp = getelementptr i64, ptr %cp, i64 1\n",
      "  %msg = load i64, ptr %mp, align 8\n",
      "  call void @cinch.test.write_cstr(ptr @cinch.test.str.fail_prefix, i64 6)\n",
      "  call void @cinch.test.write_str(i64 %lbl)\n",
      "  call void @cinch.test.write_cstr(ptr @cinch.test.str.fail_mid, i64 3)\n",
      "  call void @cinch.test.write_str(i64 %msg)\n",
      "  call void @cinch.test.write_cstr(ptr @cinch.test.str.nl, i64 1)\n",
      "  ret i64 1\n",
      "pass:\n",
      "  ret i64 0\n}\n",
      "define internal i64 @cinch.test.check_one(i64 %chk)", function-open wasm32, "\nentry:\n",
      "  %code = call i64 @cinch.test.check_one_nodrop(i64 %chk)\n",
      drop-line "%chk",
      "  ret i64 %code\n}\n"
    ] <> cat [
      "define internal i64 @cinch.test.check_list(i64 %list)", function-open wasm32, "\nentry:\n",
      "  br label %loop\n",
      "loop:\n",
      "  %cur = phi i64 [ %list, %entry ], [ %tail, %next ]\n",
      "  %tag = call i64 @cinch.test.read_tag(i64 %cur)\n",
      "  %is_nil = icmp eq i64 %tag, 0\n",
      "  br i1 %is_nil, label %pass, label %cons\n",
      "cons:\n",
      "  %lp = inttoptr i64 %cur to ptr\n",
      "  %hd = load i64, ptr %lp, align 8\n",
      "  %code = call i64 @cinch.test.check_one_nodrop(i64 %hd)\n",
      "  %failed = icmp ne i64 %code, 0\n",
      "  br i1 %failed, label %fail, label %next\n",
      "next:\n",
      "  %tp = getelementptr i64, ptr %lp, i64 1\n",
      "  %tail = load i64, ptr %tp, align 8\n",
      "  br label %loop\n",
      "fail:\n",
      drop-line "%list",
      "  ret i64 1\n",
      "pass:\n",
      drop-line "%list",
      "  ret i64 0\n}\n"
    ]

  test-harness-helpers :: Bool -> Bool -> String
  test-harness-helpers wasm32 reclaim =
    cat [
      test-harness-parse-ir wasm32,
      test-harness-timeout-ir wasm32,
      test-harness-io-ir wasm32 reclaim,
      test-harness-result-ir wasm32 reclaim,
      test-harness-checks-ir wasm32 reclaim
    ]

  test-switch-arms :: List DiscoveredTest -> String
  test-switch-arms ts = case ts of
    [] -> ""
    t : rest -> cat ["    i64 ", nat-to-string (test-index t), ", label %t", nat-to-string (test-index t), "\n", test-switch-arms rest]

  test-call-block :: DiscoveredTest -> Bool -> String
  test-call-block t reclaim =
    let idx = nat-to-string (test-index t) in
    let sym = symbol (test-core-name t) in
    let mode = test-call-mode t in
    let io = test-needs-io t in
    let fn-call = if io then cat ["  %fn_", idx, " = call i64 ", sym, "(i64 0)\n"] else cat ["  %fn_", idx, " = call i64 ", sym, "()\n"] in
    let call-ir = (if mode == 0 then
        (if io then cat ["  %res_", idx, " = call i64 ", sym, "(i64 0)\n"]
         else cat ["  %res_", idx, " = call i64 ", sym, "()\n"])
      else if mode == 1 then
        (if io then cat ["  %res_", idx, " = call i64 ", sym, "(i64 0, i64 0)\n"]
         else cat ["  %res_", idx, " = call i64 ", sym, "(i64 0)\n"])
      else if mode == 3 then
        cat [fn-call, "  %res_", idx, " = call i64 @__apply(i64 %fn_", idx, ", i64 0, ptr null)\n"]
      else
        cat [fn-call, "  %argv_", idx, " = alloca i64\n  store i64 0, ptr %argv_", idx, "\n  %res_", idx, " = call i64 @__apply(i64 %fn_", idx, ", i64 1, ptr %argv_", idx, ")\n"]) in
    let finish-ir = (case test-return-kind t of
      TRInt -> cat [
        "  %exit_", idx, " = call i64 @cinch_int_to_i64(i64 %res_", idx, ")\n",
        if reclaim then cat ["  call void @cinch.typed.rc.drop(i64 %res_", idx, ")\n"] else "",
        "  ret i64 %exit_", idx, "\n"]
      TRBool -> cat [
        "  %ok_", idx, " = icmp eq i64 %res_", idx, ", 1\n",
        "  %exit_", idx, " = select i1 %ok_", idx, ", i64 0, i64 1\n",
        "  ret i64 %exit_", idx, "\n"]
      TRUnit -> "  ret i64 0\n"
      TRResult is-str -> cat [
        "  %exit_", idx, " = call i64 @cinch.test.check_result(i64 %res_", idx, ", i1 ", if is-str then "true" else "false", ")\n",
        "  ret i64 %exit_", idx, "\n"]
      TRCheck -> cat [
        "  %exit_", idx, " = call i64 @cinch.test.check_one(i64 %res_", idx, ")\n",
        "  ret i64 %exit_", idx, "\n"]
      TRCheckList -> cat [
        "  %exit_", idx, " = call i64 @cinch.test.check_list(i64 %res_", idx, ")\n",
        "  ret i64 %exit_", idx, "\n"]) in
    cat ["t", idx, ":\n", call-ir, finish-ir]

  test-call-blocks :: List DiscoveredTest -> Bool -> String
  test-call-blocks ts reclaim = case ts of
    [] -> ""
    t : rest -> test-call-block t reclaim <> test-call-blocks rest reclaim

  test-harness-entry :: Bool -> List DiscoveredTest -> Bool -> String
  test-harness-entry wasm32 tests reclaim = cat [
    test-harness-helpers wasm32 reclaim,
    "define i64 @cinch.test.dispatch()", function-open wasm32, "\nentry:\n",
    "  %idx = load i64, ptr @cinch.test.selected, align 8\n",
    "  switch i64 %idx, label %bad [\n",
    test-switch-arms tests,
    "  ]\n",
    test-call-blocks tests reclaim,
    "bad:\n  ret i64 2\n}\n",
    if wasm32 then "define i32 @main()" else "define i32 @main(i32 %argc, ptr %argv)", function-open wasm32, "\nentry:\n",
    if reclaim then "  call void @cinch_reclaim_enable()\n" else "",
    if wasm32 then "" else cat [
      "  %count = sext i32 %argc to i64\n",
      "  call i64 @cinch_argv_init(i64 %count, ptr %argv)\n",
      "  %has_idx = icmp sge i32 %argc, 2\n",
      "  br i1 %has_idx, label %parse_idx, label %bad_args\n",
      "parse_idx:\n",
      "  %p1 = getelementptr ptr, ptr %argv, i64 1\n",
      "  %s1 = load ptr, ptr %p1, align 8\n",
      "  %idx = call i64 @cinch.test.parse_i64(ptr %s1)\n",
      "  %idx_ok = icmp sge i64 %idx, 0\n",
      "  br i1 %idx_ok, label %check_to, label %bad_args\n",
      "check_to:\n",
      "  store i64 %idx, ptr @cinch.test.selected, align 8\n",
      "  %has_to = icmp sge i32 %argc, 3\n",
      "  br i1 %has_to, label %parse_to, label %run_test\n",
      "parse_to:\n",
      "  %p2 = getelementptr ptr, ptr %argv, i64 2\n",
      "  %s2 = load ptr, ptr %p2, align 8\n",
      "  %to_ms = call i64 @cinch.test.parse_i64(ptr %s2)\n",
      "  call void @cinch.test.arm_timeout(i64 %to_ms)\n",
      "  br label %run_test\n",
      "run_test:\n",
      "  %exit = call i64 @cinch_run_main(ptr @cinch.test.dispatch)\n",
      "  %checked = call i64 @cinch_exit_check(i64 %exit)\n",
      "  %code = trunc i64 %checked to i32\n",
      "  ret i32 %code\n",
      "bad_args:\n",
      "  ret i32 2\n}\n"],
    if wasm32 then "  %exit = call i64 @cinch.test.dispatch()\n  %checked = call i64 @cinch_exit_check(i64 %exit)\n  %code = trunc i64 %checked to i32\n  ret i32 %code\n}\n" else ""
  ]

  test-worker-roots :: List DiscoveredTest -> List (String, List Nat)
  test-worker-roots ts = case ts of
    [] -> []
    t : rest -> (test-core-name t, []) : (test-worker-roots rest)

  emit-runtime-test-harness-for-profile-tuned :: CompileTuning -> TargetProfile -> Bool -> Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) (String, List DiscoveredTest)
  emit-runtime-test-harness-for-profile-tuned tuning profile inlining debug reclaim checked provider =
    case discover-tests checked of
      Err errors -> Err errors
      Ok tests ->
        let header = target-ir-header profile in
        let caps = target-caps-of-profile profile in
        let wasm32 = caps.caps-arch == "wasm32" in
        let typed = checked.elaboration in
        let raw-definitions = elaboration-core typed <> instance-definitions (elaboration-instances typed) in
        let datas = elaboration-data typed in
        let binding-names = map checked-name (elaboration-bindings typed) in
        let definitions = lower-ad-program datas (elaboration-type-families typed) (elaboration-promoted-fns typed) binding-names raw-definitions in
        let info = ProgramInfo (index-data datas) (elaboration-classes typed) (elaboration-instances typed) (index-bindings checked definitions) [] provider None (elaboration-effects typed) hash-map-empty reclaim caps (elaboration-type-families typed) (elaboration-promoted-fns typed) in
        let roots = test-worker-roots tests in
        let plan = inline-plan inlining definitions info in
        let concurrent = program-uses-concurrency definitions in
        case settled-workers-with-plan-cached tuning plan definitions roots info empty-unit-ir-cache hash-map-empty of
          (settled, _, _, _) ->
            case settled of
              Writer next globals code [] layouts context ->
                Ok (cat [header, declarations-counting-mt wasm32 debug reclaim concurrent, par-preamble info definitions, render-globals globals, apply-entry-with-linkage wasm32 "", builder-run code, test-harness-entry wasm32 tests reclaim], tests)
              Writer next globals code errors layouts context -> Err errors
