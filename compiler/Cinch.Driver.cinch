-- Rung 5: drive clang. The rung that lets the ladder build anything: a
-- Cinch program that reads its arguments, reads an LLVM IR module from a
-- file, hands that module to a spawned `clang` on the child's stdin, waits
-- for the link, runs the executable clang produced, and writes a report
-- naming both exit codes.
--
-- See compiler/README.md for the ladder and the discipline every rung
-- follows. The diagnostic vocabulary is Cinch.Report's, the artifact
-- boundary is Effect.Fs (`fs-read`/`fs-write`) and Effect.Process
-- (`process-spawn` and the `child-*` operations), and argument parsing
-- delegates to `Text.Args`.

module Cinch.Driver where

  import Algebra.Semigroup
  import Cinch.Report
  import Data.Bytes
  import Data.List
  import Data.Nat
  import Data.Option
  import Data.Path
  import Data.Result
  import Data.String
  import Effect.Fs
  import Effect.Process
  import Effect.Sequencing (ResultSequencing)
  import Text.Args (ArgSpec, ValueSpec, Required, OptVal, Args, opt-name, opt-value, args-options, args-values, parse-args, render-args-error)
  import Text.Lex (Span)
  import Text.Show (nat-to-string)

  -- The three paths the driver is handed: the IR module to link, the
  -- executable to produce, and the report file to write.
  record DriverArgs where
    input :: Path
    output :: Path
    report :: Path

  -- ---------------------------------------------------------------- exits

  exit-ok :: Int
  exit-ok = 0

  exit-bad-args :: Int
  exit-bad-args = 1

  exit-read-failed :: Int
  exit-read-failed = 2

  exit-spawn-failed :: Int
  exit-spawn-failed = 3

  exit-clang-failed :: Int
  exit-clang-failed = 4

  exit-artifact-failed :: Int
  exit-artifact-failed = 5

  exit-report-failed :: Int
  exit-report-failed = 6

  -- ---------------------------------------------------------- diagnostics

  -- A zero-width span at the start of the synthetic argv input: the
  -- driver's diagnostics are about the argument words, which have no
  -- source file of their own.
  zero-span :: Span
  zero-span = Span 0 0 0 0

  diagnostic :: String -> Diagnostic
  diagnostic msg = MkDiagnostic "bootstrap.driver" zero-span msg

  -- --------------------------------------------------------- argument scan

  driver-specs :: List ArgSpec
  driver-specs =
    [ Required (ValueSpec "input")
    , Required (ValueSpec "output")
    , Required (ValueSpec "report")
    ]

  last-option :: String -> List OptVal -> Option String
  last-option key opts = last-option-acc key opts None

  last-option-acc :: String -> List OptVal -> Option String -> Option String
  last-option-acc key opts acc = case opts of
    [] -> acc
    o : rest ->
      let next = if opt-name o == key then opt-value o else acc in
      last-option-acc key rest next

  -- The argument words, parsed via `Text.Args` into the three paths,
  -- or the named refusal.
  driver-args :: List String -> Result Diagnostic DriverArgs
  driver-args argv = case parse-args driver-specs argv of
    Err e -> Err (diagnostic (render-args-error e))
    Ok parsed -> case args-values parsed of
      extra : _ -> Err (diagnostic ("unknown argument: " <> extra))
      [] ->
        let opts = args-options parsed in
        case (last-option "input" opts, last-option "output" opts, last-option "report" opts) of
          (Some is, Some os, Some rs) ->
            Ok (DriverArgs { input = path-from-string is, output = path-from-string os, report = path-from-string rs })
          (None, _, _) -> Err (diagnostic "missing --input")
          (_, None, _) -> Err (diagnostic "missing --output")
          (_, _, None) -> Err (diagnostic "missing --report")

  -- ------------------------------------------------------- the argv reader

  read-argv :: forall r. using (io :: Io r) => Unit ->{IO r} Result Diagnostic (List String)
  read-argv u = case process-args u of
    Ok words -> Ok words
    Err _ -> Err (diagnostic "could not read process arguments")

  -- ------------------------------------------------------------- the drive

  -- Drain one of a child's output pipes to its end, counting the bytes
  -- (the child must not block on a full pipe the caller never reads).
  drain :: forall r. using (io :: Io r, seq :: ResultSequencing ProcessError) => Child -> Stream -> Nat ->{IO r} Result ProcessError Nat
  drain c s acc = do
    b <- child-read c s 4096
    if bytes-len b == 0 then Ok acc else drain c s (acc + bytes-len b)

  -- Spawn clang, write the IR module to its stdin, drain its pipes, wait
  -- for the link and report the exit code. `clang -x ir - -o OUT` reads
  -- the module from stdin (the `-` input), which is why the module is read
  -- by this program first rather than left for clang to open.
  spawn-clang :: forall r. using (io :: Io r, seq :: ResultSequencing ProcessError) => Bytes -> Path ->{IO r} Result ProcessError Nat
  spawn-clang ir output = do
    let args = ["-x", "ir", "-", "-o", path-to-string output]
    let cmd = command (path-from-string "clang") args
    c <- process-spawn None cmd
    _ <- child-write-stdin c ir
    _ <- child-close-stdin c
    _ <- drain c Stdout 0
    _ <- drain c Stderr 0
    code <- child-wait c
    _ <- child-close c
    Ok code

  -- Run the executable clang produced and report its exit code (the
  -- artifact's behaviour, from the artifact's own mouth).
  run-artifact :: forall r. using (io :: Io r, seq :: ResultSequencing ProcessError) => Path ->{IO r} Result ProcessError Nat
  run-artifact exe = do
    c <- process-spawn None (command exe [])
    _ <- child-close-stdin c
    _ <- drain c Stdout 0
    _ <- drain c Stderr 0
    code <- child-wait c
    _ <- child-close c
    Ok code

  -- The report file's text: the child's exit code and the artifact's, one
  -- per line.
  render-report :: Nat -> Nat -> String
  render-report clang-code artifact-code =
    string-concat-all
      [ "clang-exit: ", nat-to-string clang-code, "\n"
      , "artifact-exit: ", nat-to-string artifact-code, "\n"
      ]

  write-report :: forall r. using (io :: Io r) => Path -> Nat -> Nat ->{IO r} Result FsError Unit
  write-report report clang-code artifact-code =
    fs-write report (string-to-bytes (render-report clang-code artifact-code))

  -- Link without running. The report contains only the actual linker exit.
  link-only-and-report :: forall r. using (io :: Io r) => Path -> Path -> Path ->{IO r} Int
  link-only-and-report input output report = case fs-read input of
    Err _ -> exit-read-failed
    Ok ir -> case spawn-clang ir output of
      Err _ -> exit-spawn-failed
      Ok code -> case fs-write report (string-to-bytes ("clang-exit: " <> nat-to-string code <> "\n")) of
        Err _ -> exit-report-failed
        Ok _ -> if code == 0 then exit-ok else exit-clang-failed

  -- Read, link, run and report both exit codes for the original ladder.
  link-and-report :: forall r. using (io :: Io r) => Path -> Path -> Path ->{IO r, Diverge} Int
  link-and-report input output report = case fs-read input of
    Err _ -> exit-read-failed
    Ok ir -> case spawn-clang ir output of
      Err _ -> exit-spawn-failed
      Ok code -> if code /= 0 then exit-clang-failed else
        case run-artifact output of
          Err _ -> exit-artifact-failed
          Ok artifact-code -> case write-report report code artifact-code of
            Err _ -> exit-report-failed
            Ok _ -> exit-ok

  -- The rung's whole behaviour: parse the words, then drive the link.
  driver-run :: forall r. using (io :: Io r) => List String ->{IO r, Diverge} Int
  driver-run argv = case driver-args argv of
    Err d -> do
      _ <- ioWrite (string-to-bytes (render-diagnostic d))
      exit-bad-args
    Ok a -> link-and-report a.input a.output a.report
