-- Integer arithmetic evidence. Search is untrusted; check-proof rereads
-- every citation from the actual hypotheses and actual goal. No cached
-- inequality or claimed goal in a certificate can replace that context.
-- The elaborator must reify well-typed mathematical integer expressions
-- and supply only facts justified in the current lexical scope.
-- Calls in indices must already have checked purity/totality contracts.
-- Wrapping machine arithmetic stays opaque without checked no-wrap evidence.
-- Source Nat subtraction also needs its nonnegative-result obligation
-- checked in the actual preceding context before reification. Integer
-- subtraction here does not establish that a source Nat operation is total.
-- This is the compiled certificate-check tier, not a reflected soundness
-- theorem. Source obligations are not discharged by this module alone.
module Cinch.Proof where

  import Algebra.Semigroup
  import Data.Int (int-div, int-rem)
  import Relation.Eq (Eq)
  import Text.Show (Show)

  export Arithmetic, AInteger, AVariable, APlus, AMinus, ATimes, Eq_Arithmetic
  export ACall, AArgument, AArgumentsEnd
  export Comparison, Less, AtMost, Equal, Unequal, AtLeast, Greater, Eq_Comparison, Show_Comparison
  export Proposition, PTruth, PFalsehood, PCompare, PBoth, PEither, PNegate, Eq_Proposition
  export Citation, Hypothesis, NegatedGoal, Alternative
  export Certificate, Farkas, Split
  export Proof, Refutation, Conjunction, Trivial
  export prove, check-proof, arithmetic-equal, comparison-equal, proposition-equal, disproved

  data Arithmetic where
    AInteger :: Int -> Arithmetic
    AVariable :: String -> Arithmetic
    APlus :: Arithmetic -> Arithmetic -> Arithmetic
    AMinus :: Arithmetic -> Arithmetic -> Arithmetic
    ATimes :: Arithmetic -> Arithmetic -> Arithmetic
    ACall :: String -> Arithmetic -> Arithmetic
    AArgument :: Arithmetic -> Arithmetic -> Arithmetic
    AArgumentsEnd :: Arithmetic

  data Comparison where
    Less :: Comparison
    AtMost :: Comparison
    Equal :: Comparison
    Unequal :: Comparison
    AtLeast :: Comparison
    Greater :: Comparison

  data Proposition where
    PTruth :: Proposition
    PFalsehood :: Proposition
    PCompare :: Comparison -> Arithmetic -> Arithmetic -> Proposition
    PBoth :: Proposition -> Proposition -> Proposition
    PEither :: Proposition -> Proposition -> Proposition
    PNegate :: Proposition -> Proposition

  data Citation where
    Hypothesis :: Nat -> Nat -> Citation
    NegatedGoal :: Nat -> Citation
    -- Depth zero names the nearest split alternative, never an ambient
    -- assumption invented by the certificate. The second index selects
    -- a conjunct of that alternative.
    Alternative :: Nat -> Nat -> Citation

  data Certificate where
    Farkas :: List (Int, Citation) -> Certificate
    Split :: Citation -> Certificate -> Certificate -> Certificate

  data Proof where
    Refutation :: Certificate -> Proof
    Conjunction :: Proof -> Proof -> Proof
    Trivial :: Proof

  arithmetic-equal :: Arithmetic -> Arithmetic -> Bool
  arithmetic-equal a b = case (a, b) of
    (AInteger x, AInteger y) -> x == y
    (AVariable x, AVariable y) -> x == y
    (APlus x y, APlus u v) -> arithmetic-equal x u && arithmetic-equal y v
    (AMinus x y, AMinus u v) -> arithmetic-equal x u && arithmetic-equal y v
    (ATimes x y, ATimes u v) -> arithmetic-equal x u && arithmetic-equal y v
    (ACall f xs, ACall g ys) -> f == g && arithmetic-equal xs ys
    (AArgument x xs, AArgument y ys) -> arithmetic-equal x y && arithmetic-equal xs ys
    (AArgumentsEnd, AArgumentsEnd) -> True
    other -> False
  comparison-equal :: Comparison -> Comparison -> Bool
  comparison-equal a b = case (a, b) of
    (Less, Less) -> True
    (AtMost, AtMost) -> True
    (Equal, Equal) -> True
    (Unequal, Unequal) -> True
    (AtLeast, AtLeast) -> True
    (Greater, Greater) -> True
    other -> False
  proposition-equal :: Proposition -> Proposition -> Bool
  proposition-equal a b = case (a, b) of
    (PTruth, PTruth) -> True
    (PFalsehood, PFalsehood) -> True
    (PCompare op x y, PCompare rel u v) -> comparison-equal op rel && arithmetic-equal x u && arithmetic-equal y v
    (PBoth x y, PBoth u v) -> proposition-equal x u && proposition-equal y v
    (PEither x y, PEither u v) -> proposition-equal x u && proposition-equal y v
    (PNegate x, PNegate y) -> proposition-equal x y
    other -> False
  implicit instance Eq_Arithmetic :: Eq Arithmetic where
    (==) a b = arithmetic-equal a b
    (/=) a b = not (arithmetic-equal a b)

  implicit instance Eq_Comparison :: Eq Comparison where
    (==) a b = comparison-equal a b
    (/=) a b = not (comparison-equal a b)

  implicit instance Show_Comparison :: Show Comparison where
    show c = case c of
      Less -> "<"
      AtMost -> "<="
      Equal -> "=="
      Unequal -> "/="
      AtLeast -> ">="
      Greater -> ">"

  implicit instance Eq_Proposition :: Eq Proposition where
    (==) a b = proposition-equal a b
    (/=) a b = not (proposition-equal a b)

  valid-arithmetic :: Arithmetic -> Bool
  valid-arithmetic a = case a of
    AInteger n -> True
    AVariable name -> string-length name > 0
    APlus x y -> valid-arithmetic x && valid-arithmetic y
    AMinus x y -> valid-arithmetic x && valid-arithmetic y
    ATimes x y -> valid-arithmetic x && valid-arithmetic y
    ACall name args -> string-length name > 0 && valid-arguments args
    other -> False
  valid-arguments :: Arithmetic -> Bool
  valid-arguments args = case args of
    AArgumentsEnd -> True
    AArgument x rest -> valid-arithmetic x && valid-arguments rest
    other -> False
  valid-proposition :: Proposition -> Bool
  valid-proposition p = case p of
    PCompare op a b -> valid-arithmetic a && valid-arithmetic b
    PBoth a b -> valid-proposition a && valid-proposition b
    PEither a b -> valid-proposition a && valid-proposition b
    PNegate a -> valid-proposition a
    other -> True
  valid-hypotheses :: List Proposition -> Bool
  valid-hypotheses hs = case hs of [] -> True; h : rest -> valid-proposition h && valid-hypotheses rest

  -- Negation normal form. Strictness is interpreted over mathematical
  -- integers by atom-row, not rounded as if these were real inequalities.
  normal :: Bool -> Proposition -> Proposition
  normal positive p = case p of
    PTruth -> if positive then PTruth else PFalsehood
    PFalsehood -> if positive then PFalsehood else PTruth
    PNegate a -> normal (not positive) a
    PBoth a b -> if positive then PBoth (normal True a) (normal True b) else PEither (normal False a) (normal False b)
    PEither a b -> if positive then PEither (normal True a) (normal True b) else PBoth (normal False a) (normal False b)
    PCompare op a b -> normal-comparison positive op a b
  normal-comparison :: Bool -> Comparison -> Arithmetic -> Arithmetic -> Proposition
  normal-comparison positive op a b = case op of
    AtMost -> if positive then PCompare AtMost a b else PCompare Less b a
    Less -> if positive then PCompare Less a b else PCompare AtMost b a
    AtLeast -> normal-comparison positive AtMost b a
    Greater -> normal-comparison positive Less b a
    Equal -> if positive then PBoth (PCompare AtMost a b) (PCompare AtMost b a)
      else PEither (PCompare Less a b) (PCompare Less b a)
    Unequal -> normal-comparison (not positive) Equal a b
  conjuncts :: Proposition -> List Proposition
  conjuncts p = case p of PBoth a b -> conjuncts a <> conjuncts b; other -> [p]
  at :: forall a. Nat -> List a -> Option a
  at index xs = case xs of [] -> None; x : rest -> if index == 0 then Some x else at (index - 1) rest
  citation-equal :: Citation -> Citation -> Bool
  citation-equal a b = case (a, b) of
    (Hypothesis h c, Hypothesis k d) -> h == k && c == d
    (NegatedGoal c, NegatedGoal d) -> c == d
    (Alternative depth c, Alternative other d) -> depth == other && c == d
    other -> False
  cited :: List Proposition -> Proposition -> List Proposition -> Citation -> Option Proposition
  cited hypotheses goal alternatives reference = case reference of
    Hypothesis index conjunct -> case at index hypotheses of
      Some h -> at conjunct (conjuncts (normal True h))
      None -> None
    NegatedGoal conjunct -> at conjunct (conjuncts (normal False goal))
    Alternative depth conjunct -> case at depth alternatives of
      Some p -> at conjunct (conjuncts (normal True p))
      None -> None

  -- Affine expressions and rows are private. Certificate data contains
  -- citations and positive multipliers only; the checker reconstructs rows.
  record Affine where
    terms :: List (Arithmetic, Int)
    constant :: Int
  record Row where
    terms :: List (Arithmetic, Int)
    constant :: Int
  record SearchRow where
    field0 :: Row
    field1 :: List (Int, Citation)
  add-term :: Arithmetic -> Int -> List (Arithmetic, Int) -> List (Arithmetic, Int)
  add-term key amount terms = if amount == 0 then terms else case terms of
    [] -> [(key, amount)]
    (other, coefficient) : rest -> if arithmetic-equal key other then
      (if coefficient + amount == 0 then rest else (other, coefficient + amount) : rest)
      else (other, coefficient) : (add-term key amount rest)
  add-terms :: List (Arithmetic, Int) -> List (Arithmetic, Int) -> List (Arithmetic, Int)
  add-terms first second = case first of [] -> second; (key, amount) : rest -> add-terms rest (add-term key amount second)
  scale-terms :: Int -> List (Arithmetic, Int) -> List (Arithmetic, Int)
  scale-terms by terms = if by == 0 then [] else case terms of [] -> []; (key, coefficient) : rest -> (key, by * coefficient) : (scale-terms by rest)
  plus-affine :: Affine -> Affine -> Affine
  plus-affine a b = case (a, b) of (Affine xs x, Affine ys y) -> Affine (add-terms xs ys) (x + y)
  scale-affine :: Int -> Affine -> Affine
  scale-affine by a = case a of Affine terms constant -> Affine (scale-terms by terms) (by * constant)
  affine :: Arithmetic -> Affine
  affine expr = case expr of
    AInteger n -> Affine [] n
    APlus a b -> plus-affine (affine a) (affine b)
    AMinus a b -> plus-affine (affine a) (scale-affine (-1) (affine b))
    ATimes a b -> case (affine a, affine b) of
      (Affine [] x, rhs) -> scale-affine x rhs
      (lhs, Affine [] y) -> scale-affine y lhs
      other -> Affine [(expr, 1)] 0
    other -> Affine [(expr, 1)] 0
  atom-row :: Proposition -> Option Row
  atom-row p = case p of
    PFalsehood -> Some (Row [] (-1))
    PTruth -> Some (Row [] 0)
    PCompare op a b -> case plus-affine (affine a) (scale-affine (-1) (affine b)) of
      Affine terms constant -> case op of
        AtMost -> Some (Row terms (0 - constant))
        Less -> Some (Row terms (0 - constant - 1))
        other -> None
    other -> None
  row-plus :: Row -> Row -> Row
  row-plus a b = case (a, b) of (Row xs x, Row ys y) -> Row (add-terms xs ys) (x + y)
  row-scale :: Int -> Row -> Row
  row-scale by row = case row of Row terms constant -> Row (scale-terms by terms) (by * constant)
  contradiction :: Row -> Bool
  contradiction row = case row of Row [] constant -> constant < 0; other -> False

  -- Trusted certificate check. In particular, no search-produced row,
  -- branch premise or stored result is accepted as a source assumption.
  sum-citations :: List Proposition -> Proposition -> List Proposition -> List (Int, Citation) -> Option Row
  sum-citations hypotheses goal alternatives weights = case weights of
    [] -> Some (Row [] 0)
    (by, reference) : rest -> if by <= 0 then None else case cited hypotheses goal alternatives reference of
      Some p -> case atom-row p of
        Some row -> case sum-citations hypotheses goal alternatives rest of
          Some total -> Some (row-plus (row-scale by row) total)
          None -> None
        None -> None
      None -> None
  check-refutation :: List Proposition -> Proposition -> List Proposition -> Certificate -> Bool
  check-refutation hypotheses goal alternatives certificate = case certificate of
    Farkas [] -> False
    Farkas weights -> case sum-citations hypotheses goal alternatives weights of Some total -> contradiction total; None -> False
    Split reference left right -> case cited hypotheses goal alternatives reference of
      Some (PEither a b) -> check-refutation hypotheses goal (a : alternatives) left && check-refutation hypotheses goal (b : alternatives) right
      other -> False
  check-normal-proof :: List Proposition -> Proposition -> Proof -> Bool
  check-normal-proof hypotheses goal evidence = case evidence of
    Trivial -> case normal True goal of PTruth -> True; other -> False
    Conjunction left right -> case normal True goal of
      PBoth a b -> check-normal-proof hypotheses a left && check-normal-proof hypotheses b right
      other -> False
    Refutation certificate -> check-refutation hypotheses goal [] certificate
  check-proof :: List Proposition -> Proposition -> Proof -> Bool
  check-proof hypotheses goal evidence = valid-hypotheses hypotheses && valid-proposition goal && check-normal-proof hypotheses goal evidence

  -- Untrusted search. Each Fourier-Motzkin row retains positive original
  -- citations; elimination never becomes evidence until check-proof passes.
  record PrunedRow where
    pruned-dir :: List (Arithmetic, Int)
    pruned-neg :: Bool
    pruned-gcd :: Int
    pruned-row :: SearchRow
  data InsertResult where
    InsertFound :: Certificate -> InsertResult
    InsertOverflow :: InsertResult
    InsertDone :: Nat -> List PrunedRow -> InsertResult
  int-abs :: Int -> Int
  int-abs x = if x < 0 then 0 - x else x
  int-gcd-pos :: Int -> Int -> Int
  int-gcd-pos a b = if b == 0 then a else int-gcd-pos b (int-rem a b)
  int-gcd :: Int -> Int -> Int
  int-gcd a b = int-gcd-pos (int-abs a) (int-abs b)
  terms-gcd-acc :: Int -> List (Arithmetic, Int) -> Int
  terms-gcd-acc g terms = if g == 1 then 1 else case terms of
    [] -> g
    (key, amount) : rest -> terms-gcd-acc (int-gcd g amount) rest
  terms-gcd :: List (Arithmetic, Int) -> Int
  terms-gcd terms = terms-gcd-acc 0 terms
  weights-gcd-acc :: Int -> List (Int, Citation) -> Int
  weights-gcd-acc g weights = if g == 1 then 1 else case weights of
    [] -> g
    (coefficient, reference) : rest -> weights-gcd-acc (int-gcd g coefficient) rest
  div-terms :: Int -> List (Arithmetic, Int) -> List (Arithmetic, Int)
  div-terms g terms = if g <= 1 then terms else case terms of
    [] -> []
    (key, amount) : rest -> (key, int-div amount g) : (div-terms g rest)
  div-weights :: Int -> List (Int, Citation) -> List (Int, Citation)
  div-weights g weights = if g <= 1 then weights else case weights of
    [] -> []
    (coefficient, reference) : rest -> (int-div coefficient g, reference) : (div-weights g rest)
  normalize-weights :: List (Int, Citation) -> List (Int, Citation)
  normalize-weights weights = let g = weights-gcd-acc 0 weights in
    if g <= 1 then weights else div-weights g weights
  normalize-search-row :: SearchRow -> SearchRow
  normalize-search-row row = case row of
    SearchRow (Row terms constant) weights ->
      let g = weights-gcd-acc (terms-gcd-acc (int-abs constant) terms) weights in
      if g <= 1 then row
      else SearchRow (Row (div-terms g terms) (int-div constant g)) (div-weights g weights)
  arithmetic-tag :: Arithmetic -> Int
  arithmetic-tag a = case a of
    AInteger _ -> 0
    AVariable _ -> 1
    APlus _ _ -> 2
    AMinus _ _ -> 3
    ATimes _ _ -> 4
    ACall _ _ -> 5
    AArgument _ _ -> 6
    AArgumentsEnd -> 7
  cmp-int :: Int -> Int -> Int
  cmp-int a b = if a < b then -1 else if a > b then 1 else 0
  cmp-string :: String -> String -> Int
  cmp-string a b = let o = string-compare a b in if o < 0 then -1 else if o > 0 then 1 else 0
  arithmetic-compare :: Arithmetic -> Arithmetic -> Int
  arithmetic-compare a b = case (a, b) of
    (AInteger x, AInteger y) -> cmp-int x y
    (AVariable x, AVariable y) -> cmp-string x y
    (APlus x y, APlus u v) -> let c = arithmetic-compare x u in if c == 0 then arithmetic-compare y v else c
    (AMinus x y, AMinus u v) -> let c = arithmetic-compare x u in if c == 0 then arithmetic-compare y v else c
    (ATimes x y, ATimes u v) -> let c = arithmetic-compare x u in if c == 0 then arithmetic-compare y v else c
    (ACall f xs, ACall g ys) -> let c = cmp-string f g in if c == 0 then arithmetic-compare xs ys else c
    (AArgument x xs, AArgument y ys) -> let c = arithmetic-compare x y in if c == 0 then arithmetic-compare xs ys else c
    (AArgumentsEnd, AArgumentsEnd) -> 0
    other -> cmp-int (arithmetic-tag a) (arithmetic-tag b)
  insert-sorted-term :: Arithmetic -> Int -> List (Arithmetic, Int) -> List (Arithmetic, Int)
  insert-sorted-term key amount terms = if amount == 0 then terms else case terms of
    [] -> [(key, amount)]
    (other, coefficient) : rest ->
      let ord = arithmetic-compare key other in
      if ord < 0 then (key, amount) : ((other, coefficient) : rest)
      else if ord == 0 then
        (if coefficient + amount == 0 then rest else (other, coefficient + amount) : rest)
      else (other, coefficient) : (insert-sorted-term key amount rest)
  canonicalize-terms :: List (Arithmetic, Int) -> List (Arithmetic, Int)
  canonicalize-terms terms = case terms of
    [] -> []
    (key, amount) : rest -> insert-sorted-term key amount (canonicalize-terms rest)
  canonicalize-search-row :: SearchRow -> SearchRow
  canonicalize-search-row row = case row of
    SearchRow (Row terms constant) weights -> SearchRow (Row (canonicalize-terms terms) constant) weights
  merge-scaled-terms :: Int -> List (Arithmetic, Int) -> Int -> List (Arithmetic, Int) -> List (Arithmetic, Int)
  merge-scaled-terms x first y second = case (first, second) of
    ([], []) -> []
    ([], (k, b) : rest) -> let v = y * b in if v == 0 then merge-scaled-terms x [] y rest else (k, v) : (merge-scaled-terms x [] y rest)
    ((k, a) : rest, []) -> let v = x * a in if v == 0 then merge-scaled-terms x rest y [] else (k, v) : (merge-scaled-terms x rest y [])
    ((k1, a) : r1, (k2, b) : r2) ->
      let ord = arithmetic-compare k1 k2 in
      if ord < 0 then
        let v = x * a in if v == 0 then merge-scaled-terms x r1 y second else (k1, v) : (merge-scaled-terms x r1 y second)
      else if ord > 0 then
        let v = y * b in if v == 0 then merge-scaled-terms x first y r2 else (k2, v) : (merge-scaled-terms x first y r2)
      else
        let v = x * a + y * b in if v == 0 then merge-scaled-terms x r1 y r2 else (k1, v) : (merge-scaled-terms x r1 y r2)
  scale-dir :: Int -> Bool -> List (Arithmetic, Int) -> List (Arithmetic, Int)
  scale-dir g neg terms = if g <= 0 then terms else case terms of
    [] -> []
    (k, a) : rest -> let q = int-div a g in (k, if neg then 0 - q else q) : (scale-dir g neg rest)
  terms-equal :: List (Arithmetic, Int) -> List (Arithmetic, Int) -> Bool
  terms-equal first second = case (first, second) of
    ([], []) -> True
    ((k1, a1) : r1, (k2, a2) : r2) -> a1 == a2 && arithmetic-equal k1 k2 && terms-equal r1 r2
    other -> False
  weighted-add :: Int -> Citation -> List (Int, Citation) -> List (Int, Citation)
  weighted-add by reference weights = case weights of
    [] -> [(by, reference)]
    (coefficient, old) : rest -> if citation-equal reference old then (coefficient + by, old) : rest
      else (coefficient, old) : (weighted-add by reference rest)
  weighted-plus :: List (Int, Citation) -> List (Int, Citation) -> List (Int, Citation)
  weighted-plus first second = case first of [] -> second; (by, reference) : rest -> weighted-plus rest (weighted-add by reference second)
  weighted-scale :: Int -> List (Int, Citation) -> List (Int, Citation)
  weighted-scale by weights = case weights of [] -> []; (coefficient, reference) : rest -> (by * coefficient, reference) : (weighted-scale by rest)
  coefficient :: Arithmetic -> List (Arithmetic, Int) -> Int
  coefficient key terms = case terms of [] -> 0; (other, amount) : rest -> if arithmetic-equal key other then amount else coefficient key rest
  row-coefficient :: Arithmetic -> SearchRow -> Int
  row-coefficient key row = case row of SearchRow (Row terms constant) weights -> coefficient key terms
  combine :: Int -> SearchRow -> Int -> SearchRow -> SearchRow
  combine x a y b = case (a, b) of
    (SearchRow (Row xs cx) refs, SearchRow (Row ys cy) others) ->
      normalize-search-row (SearchRow (Row (merge-scaled-terms x xs y ys) (x * cx + y * cy)) (weighted-plus (weighted-scale x refs) (weighted-scale y others)))
  combine-pair :: Arithmetic -> SearchRow -> SearchRow -> SearchRow
  combine-pair key positive negative =
    let ap = row-coefficient key positive in
    let an = 0 - row-coefficient key negative in
    let g = int-gcd ap an in
    if g <= 1 then combine an positive ap negative
    else combine (int-div an g) positive (int-div ap g) negative
  opposite-certificate :: Int -> Int -> List (Int, Citation) -> Int -> Int -> List (Int, Citation) -> Option Certificate
  opposite-certificate g1 c1 w1 g2 c2 w2 =
    if c1 * g2 + c2 * g1 < 0 then
      let d = int-gcd g1 g2 in
      let combined = (if d <= 1 then weighted-plus (weighted-scale g2 w1) (weighted-scale g1 w2)
        else weighted-plus (weighted-scale (int-div g2 d) w1) (weighted-scale (int-div g1 d) w2)) in
      Some (Farkas (normalize-weights combined))
    else None
  check-opposite-tail :: List (Arithmetic, Int) -> Bool -> Int -> Int -> List (Int, Citation) -> List PrunedRow -> Option Certificate
  check-opposite-tail dir neg g c weights entries = case entries of
    [] -> None
    (PrunedRow dir2 neg2 g2 (SearchRow (Row _ c2) w2)) : rest ->
      if neg /= neg2 && terms-equal dir dir2 then
        (case opposite-certificate g c weights g2 c2 w2 of
          Some cert -> Some cert
          None -> check-opposite-tail dir neg g c weights rest)
      else check-opposite-tail dir neg g c weights rest
  insert-pruned-scan :: Nat -> Nat -> PrunedRow -> List (Arithmetic, Int) -> Bool -> Int -> Int -> List (Int, Citation) -> List PrunedRow -> List PrunedRow -> List PrunedRow -> InsertResult
  insert-pruned-scan limit count cand dir neg g c weights orig prefix remaining = case remaining of
    [] -> if count >= limit then InsertOverflow else InsertDone (count + 1) (cand : orig)
    entry : rest -> case entry of
      PrunedRow dir2 neg2 g2 (SearchRow (Row _ c2) w2) ->
        if terms-equal dir dir2 then
          if neg /= neg2 then
            (case opposite-certificate g c weights g2 c2 w2 of
              Some cert -> InsertFound cert
              None -> insert-pruned-scan limit count cand dir neg g c weights orig (entry : prefix) rest)
          else
            let lhs = c * g2 in
            let rhs = c2 * g in
            if lhs < rhs || (lhs == rhs && g < g2) then
              (case check-opposite-tail dir neg g c weights rest of
                Some cert -> InsertFound cert
                None -> InsertDone count (reverse prefix <> (cand : rest)))
            else InsertDone count orig
        else insert-pruned-scan limit count cand dir neg g c weights orig (entry : prefix) rest
  insert-pruned :: Nat -> Nat -> List PrunedRow -> SearchRow -> InsertResult
  insert-pruned limit count acc row = case row of
    SearchRow (Row terms constant) weights -> case terms of
      [] -> if constant < 0 then InsertFound (Farkas (normalize-weights weights)) else InsertDone count acc
      (first-key, first-amount) : _ ->
        let g = terms-gcd terms in
        let neg = first-amount < 0 in
        let dir = scale-dir g neg terms in
        let cand = PrunedRow dir neg g row in
        insert-pruned-scan limit count cand dir neg g constant weights acc [] acc
  prune-rows-acc :: Nat -> Nat -> List PrunedRow -> List SearchRow -> InsertResult
  prune-rows-acc limit count acc rows = case rows of
    [] -> InsertDone count acc
    row : rest -> case insert-pruned limit count acc (canonicalize-search-row row) of
      InsertFound cert -> InsertFound cert
      InsertOverflow -> InsertOverflow
      InsertDone next-count next-acc -> prune-rows-acc limit next-count next-acc rest
  partition-pruned :: Arithmetic -> List PrunedRow -> (List SearchRow, List SearchRow, List PrunedRow, Nat)
  partition-pruned key entries = case entries of
    [] -> ([], [], [], 0)
    entry : rest -> case partition-pruned key rest of
      (positive, negative, zero, zero-count) -> case entry of
        PrunedRow _ _ _ row -> let amount = row-coefficient key row in
          if amount > 0 then (row : positive, negative, zero, zero-count)
          else if amount < 0 then (positive, row : negative, zero, zero-count)
          else (positive, negative, entry : zero, zero-count + 1)
  eliminate-one-pruned :: Arithmetic -> Nat -> SearchRow -> List SearchRow -> Nat -> List PrunedRow -> InsertResult
  eliminate-one-pruned key limit positive negative count acc = case negative of
    [] -> InsertDone count acc
    row : rest -> case insert-pruned limit count acc (combine-pair key positive row) of
      InsertFound cert -> InsertFound cert
      InsertOverflow -> InsertOverflow
      InsertDone next-count next-acc -> eliminate-one-pruned key limit positive rest next-count next-acc
  eliminate-pairs-pruned :: Arithmetic -> Nat -> List SearchRow -> List SearchRow -> Nat -> List PrunedRow -> InsertResult
  eliminate-pairs-pruned key limit positive negative count acc = case positive of
    [] -> InsertDone count acc
    row : rest -> case eliminate-one-pruned key limit row negative count acc of
      InsertFound cert -> InsertFound cert
      InsertOverflow -> InsertOverflow
      InsertDone next-count next-acc -> eliminate-pairs-pruned key limit rest negative next-count next-acc
  -- Variable order is an untrusted search choice. Pure variables drop
  -- upfront for free; then eliminate the column producing the fewest rows,
  -- so aliases and repeated range bounds do not exhaust the fixed budget.
  -- Every resulting certificate still cites the original full context.
  search-has-variable :: Arithmetic -> List Arithmetic -> Bool
  search-has-variable key variables = case variables of [] -> False; other : rest -> arithmetic-equal key other || search-has-variable key rest
  remember-variables :: List (Arithmetic, Int) -> List Arithmetic -> List Arithmetic
  remember-variables terms seen = case terms of
    [] -> seen
    (key, amount) : rest -> remember-variables rest (if search-has-variable key seen then seen else key : seen)
  search-variables :: List SearchRow -> List Arithmetic -> List Arithmetic
  search-variables rows seen = case rows of
    [] -> reverse seen
    (SearchRow (Row terms constant) weights) : rest -> search-variables rest (remember-variables terms seen)
  unprune-rows :: List PrunedRow -> List SearchRow
  unprune-rows entries = case entries of
    [] -> []
    (PrunedRow _ _ _ row) : rest -> row : (unprune-rows rest)
  variable-signs :: Arithmetic -> List SearchRow -> Bool -> Bool -> (Bool, Bool)
  variable-signs key rows has-pos has-neg = if has-pos && has-neg then (True, True) else case rows of
    [] -> (has-pos, has-neg)
    row : rest -> let amount = row-coefficient key row in
      if amount > 0 then variable-signs key rest True has-neg
      else if amount < 0 then variable-signs key rest has-pos True
      else variable-signs key rest has-pos has-neg
  pure-variables :: List Arithmetic -> List SearchRow -> List Arithmetic
  pure-variables variables rows = case variables of
    [] -> []
    key : rest -> case variable-signs key rows False False of
      (True, False) -> key : (pure-variables rest rows)
      (False, True) -> key : (pure-variables rest rows)
      other -> pure-variables rest rows
  row-mentions-any :: List (Arithmetic, Int) -> List Arithmetic -> Bool
  row-mentions-any terms targets = case terms of
    [] -> False
    (key, _) : rest -> search-has-variable key targets || row-mentions-any rest targets
  drop-pure-rows :: List Arithmetic -> List SearchRow -> List SearchRow
  drop-pure-rows pures rows = case rows of
    [] -> []
    row : rest -> case row of
      SearchRow (Row terms _) _ -> if row-mentions-any terms pures then drop-pure-rows pures rest else row : (drop-pure-rows pures rest)
  eliminate-pure-rows :: Nat -> List SearchRow -> List SearchRow
  eliminate-pure-rows rounds rows = if rounds == 0 then rows else
    let pures = pure-variables (search-variables rows []) rows in
    case pures of
      [] -> rows
      _ : _ -> eliminate-pure-rows (rounds - 1) (drop-pure-rows pures rows)
  drop-pure-pruned :: List Arithmetic -> List PrunedRow -> (Nat, List PrunedRow)
  drop-pure-pruned pures entries = case entries of
    [] -> (0, [])
    entry : rest -> case drop-pure-pruned pures rest of
      (n, kept) -> case entry of
        PrunedRow _ _ _ (SearchRow (Row terms _) _) ->
          if row-mentions-any terms pures then (n, kept) else (n + 1, entry : kept)
  eliminate-pure-pruned :: Nat -> Nat -> List PrunedRow -> (Nat, List PrunedRow)
  eliminate-pure-pruned rounds count entries = if rounds == 0 then (count, entries) else
    let rows = unprune-rows entries in
    let pures = pure-variables (search-variables rows []) rows in
    case pures of
      [] -> (count, entries)
      _ : _ -> case drop-pure-pruned pures entries of
        (next-count, next-entries) -> eliminate-pure-pruned (rounds - 1) next-count next-entries
  elimination-cost :: Arithmetic -> List SearchRow -> Nat -> Nat -> Nat -> Nat
  elimination-cost key rows positive negative zero = case rows of
    [] -> positive * negative + zero
    row : rest -> let amount = row-coefficient key row in
      if amount > 0 then elimination-cost key rest (positive + 1) negative zero
      else if amount < 0 then elimination-cost key rest positive (negative + 1) zero
      else elimination-cost key rest positive negative (zero + 1)
  cheapest-variable :: List Arithmetic -> List SearchRow -> Arithmetic -> Nat -> Arithmetic
  cheapest-variable variables rows best cost = case variables of
    [] -> best
    key : rest -> let next = elimination-cost key rows 0 0 0 in
      if next < cost then cheapest-variable rest rows key next else cheapest-variable rest rows best cost
  first-variable :: List SearchRow -> Option Arithmetic
  first-variable rows = case search-variables rows [] of
    [] -> None
    first : rest -> Some (cheapest-variable rest rows first (elimination-cost first rows 0 0 0))
  find-contradiction :: List SearchRow -> Option Certificate
  find-contradiction rows = case rows of
    [] -> None
    (SearchRow row weights) : rest -> if contradiction row then Some (Farkas (normalize-weights weights)) else find-contradiction rest
  fourier-loop :: Nat -> Nat -> Nat -> List PrunedRow -> Option Certificate
  fourier-loop fuel limit count entries = case entries of
    [] -> None
    _ : _ -> if fuel == 0 then None else
      case first-variable (unprune-rows entries) of
        None -> None
        Some key -> case partition-pruned key entries of
          (positive, negative, zero, zero-count) ->
            case eliminate-pairs-pruned key limit positive negative zero-count zero of
              InsertFound certificate -> Some certificate
              InsertOverflow -> None
              InsertDone next-count next-entries ->
                case eliminate-pure-pruned fuel next-count next-entries of
                  (cleaned-count, cleaned-entries) -> fourier-loop (fuel - 1) limit cleaned-count cleaned-entries
  fourier :: Nat -> Nat -> List SearchRow -> Option Certificate
  fourier fuel limit rows = case find-contradiction rows of
    Some certificate -> Some certificate
    None ->
      let trimmed = eliminate-pure-rows fuel rows in
      case prune-rows-acc limit 0 [] trimmed of
        InsertFound certificate -> Some certificate
        InsertOverflow -> None
        InsertDone count entries -> fourier-loop fuel limit count entries

  -- References are rebuilt for each split context. Alternative indices
  -- cannot accidentally retain the depths from a sibling branch.
  reference-conjuncts :: Citation -> List Proposition -> List (Citation, Proposition)
  reference-conjuncts reference ps = case ps of
    [] -> []
    p : rest -> (reference, p) : (reference-conjuncts (next-citation reference) rest)
  next-citation :: Citation -> Citation
  next-citation reference = case reference of
    Hypothesis h c -> Hypothesis h (c + 1)
    NegatedGoal c -> NegatedGoal (c + 1)
    Alternative depth c -> Alternative depth (c + 1)
  hypothesis-references :: Nat -> List Proposition -> List (Citation, Proposition)
  hypothesis-references index hs = case hs of
    [] -> []
    h : rest -> reference-conjuncts (Hypothesis index 0) (conjuncts (normal True h)) <> hypothesis-references (index + 1) rest
  alternative-references :: Nat -> List Proposition -> List (Citation, Proposition)
  alternative-references depth ps = case ps of
    [] -> []
    p : rest -> reference-conjuncts (Alternative depth 0) (conjuncts (normal True p)) <> alternative-references (depth + 1) rest
  all-references :: List Proposition -> Proposition -> List Proposition -> List (Citation, Proposition)
  all-references hypotheses goal alternatives = hypothesis-references 0 hypotheses
    <> reference-conjuncts (NegatedGoal 0) (conjuncts (normal False goal))
    <> alternative-references 0 alternatives
  rows-from :: List (Citation, Proposition) -> List SearchRow
  rows-from references = case references of
    [] -> []
    (reference, p) : rest -> case atom-row p of
      Some row -> (SearchRow row [(1, reference)]) : (rows-from rest)
      None -> rows-from rest
  -- Use a matching lexical fact before unrelated rows consume the bounded
  -- elimination budget. The small refutation retains the original citation;
  -- check-proof still reconstructs it against the complete actual context.
  assumed-refutation :: List (Citation, Proposition) -> Proposition -> Option Certificate
  assumed-refutation references goal = assumed-normal-refutation references (normal True goal) goal
  assumed-normal-refutation :: List (Citation, Proposition) -> Proposition -> Proposition -> Option Certificate
  assumed-normal-refutation references wanted goal = case references of
    [] -> None
    (reference, fact) : rest -> if proposition-equal fact wanted then
      (case fourier 64 256 (rows-from ((reference, fact) : (reference-conjuncts (NegatedGoal 0) (conjuncts (normal False goal))))) of
        Some certificate -> Some certificate
        None -> assumed-normal-refutation rest wanted goal)
      else assumed-normal-refutation rest wanted goal

  already-split :: Proposition -> List Proposition -> Bool
  already-split p seen = case seen of [] -> False; q : rest -> proposition-equal p q || already-split p rest
  find-split :: List (Citation, Proposition) -> List Proposition -> Option (Citation, Proposition, Proposition)
  find-split references seen = case references of
    [] -> None
    (reference, PEither a b) : rest -> if already-split (PEither a b) seen then find-split rest seen else Some (reference, a, b)
    pair : rest -> find-split rest seen
  refute :: Nat -> List Proposition -> Proposition -> List Proposition -> List Proposition -> Option Certificate
  refute fuel hypotheses goal alternatives seen = let references = all-references hypotheses goal alternatives in
    case fourier 64 256 (rows-from references) of
      Some certificate -> Some certificate
      None -> if fuel == 0 then None else case find-split references seen of
        None -> None
        Some (reference, a, b) -> let selected = (PEither a b) : seen in
          case refute (fuel - 1) hypotheses goal (a : alternatives) selected of
            Some left -> case refute (fuel - 1) hypotheses goal (b : alternatives) selected of
              Some right -> Some (Split reference left right)
              None -> None
            None -> None
  search :: List Proposition -> Proposition -> Option Proof
  search hypotheses goal = case normal True goal of
    PTruth -> Some Trivial
    PBoth a b -> case search hypotheses a of
      Some left -> case search hypotheses b of Some right -> Some (Conjunction left right); None -> None
      None -> None
    other -> case assumed-refutation (hypothesis-references 0 hypotheses) goal of
      Some certificate -> Some (Refutation certificate)
      None -> case refute 8 hypotheses goal [] [] of Some certificate -> Some (Refutation certificate); None -> None
  prove :: List Proposition -> Proposition -> Option Proof
  prove hypotheses goal = if not (valid-hypotheses hypotheses && valid-proposition goal) then None else case search hypotheses goal of
    Some evidence -> if check-proof hypotheses goal evidence then Some evidence else None
    None -> None
  -- A closed proposition (numerals only, no variable or call) whose
  -- negation has a checked proof from no hypotheses is false outright.
  closed-arithmetic :: Arithmetic -> Bool
  closed-arithmetic a = case a of
    AInteger n -> True
    APlus x y -> closed-arithmetic x && closed-arithmetic y
    AMinus x y -> closed-arithmetic x && closed-arithmetic y
    ATimes x y -> closed-arithmetic x && closed-arithmetic y
    other -> False
  closed-proposition :: Proposition -> Bool
  closed-proposition p = case p of
    PCompare op a b -> closed-arithmetic a && closed-arithmetic b
    PBoth a b -> closed-proposition a && closed-proposition b
    PEither a b -> closed-proposition a && closed-proposition b
    PNegate a -> closed-proposition a
    other -> True
  disproved :: Proposition -> Bool
  disproved p = closed-proposition p && (case prove [] (PNegate p) of Some evidence -> True; None -> False)
