module Runtime.Error where
  import Runtime.Mem
  import Runtime.Sys

  export exitBlackhole, exitPanic, exitExhausted, exitLeak
  export put4, put8, writeStderrRaw, writeStderrU64, panicExitBytes
  export exhaustedHeap, exhaustedStack, exhaustedThreads
  export exhaustedHeapInSignal, exhaustedStackInSignal, isExhausting
  export cinchBlackhole, cinchPanic

  exitBlackhole :: I32
  exitBlackhole = 70

  exitPanic :: I32
  exitPanic = 71

  exitExhausted :: I32
  exitExhausted = 73

  exitLeak :: I32
  exitLeak = 74

  #[static_mut]
  static exhaustingFlag :: U64

  isExhausting :: Unit ->{Global} Bool
  isExhausting _ = atomicLoadU64Relaxed (exhaustingFlag ()) 0 /= 0

  waitForever :: Unit ->{Global} Unit
  waitForever _ =
    let _ = cPause () in
    waitForever ()

  claimExhausted :: Unit ->{Global} Unit
  claimExhausted _ =
    let prev = atomicSwapU64SeqCst (exhaustingFlag ()) 0 1 in
    if prev /= 0 then waitForever () else ()

  put4 :: RawPtr U8 -> Isize -> U8 -> U8 -> U8 -> U8 ->{Global} Unit
  put4 p off a b c d =
    let q = ptrAdd p off in
    let _ = storeU8 q 0 a in
    let _ = storeU8 q 1 b in
    let _ = storeU8 q 2 c in
    storeU8 q 3 d

  put8 :: RawPtr U8 -> Isize -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 ->{Global} Unit
  put8 p off a b c d e f g h =
    let _ = put4 p off a b c d in
    put4 p (i64ToIsize (i64Add (isizeToI64 off) 4)) e f g h

  writeAllLoop :: I32 -> RawPtr U8 -> Usize ->{Global} Unit
  writeAllLoop fd ptr rem =
    if rem == 0 then ()
    else
      let n = cWrite fd ptr rem in
      let ni = isizeToI64 n in
      if i64Le ni 0 then ()
      else
        let nu = u64ToUsize (i64ToU64 ni) in
        writeAllLoop fd (ptrAdd ptr n) (usizeSub rem nu)

  writeStderrRaw :: RawPtr U8 -> Usize ->{Global} Unit
  writeStderrRaw ptr len = writeAllLoop 2 ptr len

  writeU64Digits :: RawPtr U8 -> U64 -> Isize ->{Global} Isize
  writeU64Digits buf v pos =
    let q = u64Div v 10 in
    let r = u64Rem v 10 in
    let nextPos = i64ToIsize (i64Sub (isizeToI64 pos) 1) in
    let _ = storeU8 buf nextPos (u64ToU8 (u64Add 48 r)) in
    if q == 0 then nextPos else writeU64Digits buf q nextPos

  writeStderrU64 :: U64 ->{Global} Unit
  writeStderrU64 v =
    withLocal (fixedArrayRepeat 24 (0 :: U8)) (\arr ->
      let buf = mutAsPtr arr in
      let start = writeU64Digits buf v 24 in
      let len = u64ToUsize (i64ToU64 (i64Sub 24 (isizeToI64 start))) in
      writeStderrRaw (ptrAdd buf start) len
    )

  writeCinchRuntimePrefix :: Unit ->{Global} Unit
  writeCinchRuntimePrefix _ =
    withLocal (fixedArrayRepeat 16 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "cinchruntime: " (14 bytes)
      let _ = put8 p 0 99 105 110 99 104 114 117 110 in
      let _ = put4 p 8 116 105 109 101 in
      let _ = storeU8 p 12 58 in
      let _ = storeU8 p 13 32 in
      writeStderrRaw p 14
    )

  writeNewline :: Unit ->{Global} Unit
  writeNewline _ =
    withLocal (0 :: U8) (\ch ->
      let p = mutAsPtr ch in
      let _ = storeU8 p 0 10 in
      writeStderrRaw p 1
    )

  writeCorruptPanicMsg :: Unit ->{Global} Unit
  writeCorruptPanicMsg _ =
    withLocal (fixedArrayRepeat 64 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "compiler bug: panic with corrupt message pointer" (48 bytes)
      let _ = put8 p 0 99 111 109 112 105 108 101 114 in
      let _ = put8 p 8 32 98 117 103 58 32 112 97 in
      let _ = put8 p 16 110 105 99 32 119 105 116 104 in
      let _ = put8 p 24 32 99 111 114 114 117 112 116 in
      let _ = put8 p 32 32 109 101 115 115 97 103 101 in
      let _ = put8 p 40 32 112 111 105 110 116 101 114 in
      writeStderrRaw p 48
    )

  writeExhaustedPrefix :: Unit ->{Global} Unit
  writeExhaustedPrefix _ =
    withLocal (fixedArrayRepeat 24 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "cinch: exhausted: " (18 bytes)
      let _ = put8 p 0 99 105 110 99 104 58 32 101 in
      let _ = put8 p 8 120 104 97 117 115 116 101 100 in
      let _ = storeU8 p 16 58 in
      let _ = storeU8 p 17 32 in
      writeStderrRaw p 18
    )

  writeHeapSuffix :: U64 ->{Global} Unit
  writeHeapSuffix bytes =
    let _ = withLocal (fixedArrayRepeat 8 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      let _ = put4 p 0 104 101 97 112 in
      let _ = storeU8 p 4 32 in
      let _ = storeU8 p 5 40 in
      writeStderrRaw p 6
    ) in
    let _ = writeStderrU64 bytes in
    withLocal (fixedArrayRepeat 8 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      let _ = put8 p 0 32 98 121 116 101 115 41 10 in
      writeStderrRaw p 8
    )

  writeStackSuffix :: Unit ->{Global} Unit
  writeStackSuffix _ =
    withLocal (fixedArrayRepeat 8 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      let _ = put4 p 0 115 116 97 99 in
      let _ = storeU8 p 4 107 in
      let _ = storeU8 p 5 10 in
      writeStderrRaw p 6
    )

  writeThreadsSuffix :: Unit ->{Global} Unit
  writeThreadsSuffix _ =
    withLocal (fixedArrayRepeat 8 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      let _ = put8 p 0 116 104 114 101 97 100 115 10 in
      writeStderrRaw p 8
    )

  exhaustedHeap :: U64 ->{Global} Unit
  exhaustedHeap bytes =
    let _ = claimExhausted () in
    let _ = writeExhaustedPrefix () in
    let _ = writeHeapSuffix bytes in
    cExit exitExhausted

  exhaustedHeapInSignal :: U64 ->{Global} Unit
  exhaustedHeapInSignal bytes =
    let _ = claimExhausted () in
    let _ = writeExhaustedPrefix () in
    let _ = writeHeapSuffix bytes in
    cRawExit exitExhausted

  exhaustedStack :: Unit ->{Global} Unit
  exhaustedStack _ =
    let _ = claimExhausted () in
    let _ = writeExhaustedPrefix () in
    let _ = writeStackSuffix () in
    cExit exitExhausted

  exhaustedStackInSignal :: Unit ->{Global} Unit
  exhaustedStackInSignal _ =
    let _ = claimExhausted () in
    let _ = writeExhaustedPrefix () in
    let _ = writeStackSuffix () in
    cRawExit exitExhausted

  exhaustedThreads :: Unit ->{Global} Unit
  exhaustedThreads _ =
    let _ = claimExhausted () in
    let _ = writeExhaustedPrefix () in
    let _ = writeThreadsSuffix () in
    cExit exitExhausted

  panicExitBytes :: RawPtr U8 -> Usize ->{Global} Unit
  panicExitBytes ptr len =
    let _ = writeCinchRuntimePrefix () in
    let _ = writeStderrRaw ptr len in
    let _ = writeNewline () in
    cExit exitPanic

  cinchBlackhole :: Unit ->{Global} Unit
  cinchBlackhole _ = cExit exitBlackhole

  cinchPanic :: MaybeNull U8 -> Usize ->{Global} Unit
  cinchPanic msg len =
    if len == 0 then
      let _ = writeCinchRuntimePrefix () in
      let _ = writeNewline () in
      cExit exitPanic
    else if ptrIsNull msg then
      let _ = writeCinchRuntimePrefix () in
      let _ = writeCorruptPanicMsg () in
      let _ = writeNewline () in
      cExit exitPanic
    else
      panicExitBytes (maybeToRaw msg) len

  foreign export ccall "cinch_blackhole" cinchBlackhole :: Unit ->{Global} Unit
  foreign export ccall "cinch_panic" cinchPanic :: MaybeNull U8 -> Usize ->{Global} Unit
