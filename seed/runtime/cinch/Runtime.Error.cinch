module Runtime.Error where
  import Runtime.Mem
  import Runtime.Sys

  export exitBlackhole, exitPanic, exitExhausted, exitLeak
  export put4, put8, writeStderrRaw, writeStderrU64, panicExitBytes
  export exhaustedHeap, exhaustedStack, exhaustedThreads
  export exhaustedHeapInSignal, exhaustedStackInSignal, isExhausting
  export cinchBlackhole, cinchPanic
  export panicNegativeInput, panicNegativeResult, panicDivByZero, panicOutOfRange
  export panicMalformedDecimal, panicBufferTooSmall, panicMalformedName
  export panicOutOfBounds, panicReadOnly, panicCorruptValue, panicUnmapFailed, panicOutputFailed

  exitBlackhole :: I32
  exitBlackhole = 70

  exitPanic :: I32
  exitPanic = 71

  exitExhausted :: I32
  exitExhausted = 73

  exitLeak :: I32
  exitLeak = 74

  #[static_mut]
  static exhaustingFlag :: U64

  isExhausting :: Unit ->{Global} Bool
  isExhausting _ = atomicLoadU64Relaxed (exhaustingFlag ()) 0 /= 0

  waitForever :: Unit ->{Global} Unit
  waitForever _ =
    let _ = cPause () in
    waitForever ()

  claimExhausted :: Unit ->{Global} Unit
  claimExhausted _ =
    let prev = atomicSwapU64SeqCst (exhaustingFlag ()) 0 1 in
    if prev /= 0 then waitForever () else ()

  put4 :: RawPtr U8 -> Isize -> U8 -> U8 -> U8 -> U8 ->{Global} Unit
  put4 p off a b c d =
    let q = ptrAdd p off in
    let _ = storeU8 q 0 a in
    let _ = storeU8 q 1 b in
    let _ = storeU8 q 2 c in
    storeU8 q 3 d

  put8 :: RawPtr U8 -> Isize -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 ->{Global} Unit
  put8 p off a b c d e f g h =
    let _ = put4 p off a b c d in
    put4 p (i64ToIsize (i64Add (isizeToI64 off) 4)) e f g h

  writeAllLoop :: I32 -> RawPtr U8 -> Usize ->{Global} Unit
  writeAllLoop fd ptr rem =
    if rem == 0 then ()
    else
      let n = cWrite fd ptr rem in
      let ni = isizeToI64 n in
      if i64Le ni 0 then ()
      else
        let nu = u64ToUsize (i64ToU64 ni) in
        writeAllLoop fd (ptrAdd ptr n) (usizeSub rem nu)

  writeStderrRaw :: RawPtr U8 -> Usize ->{Global} Unit
  writeStderrRaw ptr len = writeAllLoop 2 ptr len

  writeU64Digits :: RawPtr U8 -> U64 -> Isize ->{Global} Isize
  writeU64Digits buf v pos =
    let q = u64Div v 10 in
    let r = u64Rem v 10 in
    let nextPos = i64ToIsize (i64Sub (isizeToI64 pos) 1) in
    let _ = storeU8 buf nextPos (u64ToU8 (u64Add 48 r)) in
    if q == 0 then nextPos else writeU64Digits buf q nextPos

  writeStderrU64 :: U64 ->{Global} Unit
  writeStderrU64 v =
    withLocal (fixedArrayRepeat 24 (0 :: U8)) (\arr ->
      let buf = mutAsPtr arr in
      let start = writeU64Digits buf v 24 in
      let len = u64ToUsize (i64ToU64 (i64Sub 24 (isizeToI64 start))) in
      writeStderrRaw (ptrAdd buf start) len
    )

  writeCinchRuntimePrefix :: Unit ->{Global} Unit
  writeCinchRuntimePrefix _ =
    withLocal (fixedArrayRepeat 16 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "cinchruntime: " (14 bytes)
      let _ = put8 p 0 99 105 110 99 104 114 117 110 in
      let _ = put4 p 8 116 105 109 101 in
      let _ = storeU8 p 12 58 in
      let _ = storeU8 p 13 32 in
      writeStderrRaw p 14
    )

  writeNewline :: Unit ->{Global} Unit
  writeNewline _ =
    withLocal (0 :: U8) (\ch ->
      let p = mutAsPtr ch in
      let _ = storeU8 p 0 10 in
      writeStderrRaw p 1
    )

  writeCorruptPanicMsg :: Unit ->{Global} Unit
  writeCorruptPanicMsg _ =
    withLocal (fixedArrayRepeat 64 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "compiler bug: panic with corrupt message pointer" (48 bytes)
      let _ = put8 p 0 99 111 109 112 105 108 101 114 in
      let _ = put8 p 8 32 98 117 103 58 32 112 97 in
      let _ = put8 p 16 110 105 99 32 119 105 116 104 in
      let _ = put8 p 24 32 99 111 114 114 117 112 116 in
      let _ = put8 p 32 32 109 101 115 115 97 103 101 in
      let _ = put8 p 40 32 112 111 105 110 116 101 114 in
      writeStderrRaw p 48
    )

  writeExhaustedPrefix :: Unit ->{Global} Unit
  writeExhaustedPrefix _ =
    withLocal (fixedArrayRepeat 24 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "cinch: exhausted: " (18 bytes)
      let _ = put8 p 0 99 105 110 99 104 58 32 101 in
      let _ = put8 p 8 120 104 97 117 115 116 101 100 in
      let _ = storeU8 p 16 58 in
      let _ = storeU8 p 17 32 in
      writeStderrRaw p 18
    )

  writeHeapSuffix :: U64 ->{Global} Unit
  writeHeapSuffix bytes =
    let _ = withLocal (fixedArrayRepeat 8 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      let _ = put4 p 0 104 101 97 112 in
      let _ = storeU8 p 4 32 in
      let _ = storeU8 p 5 40 in
      writeStderrRaw p 6
    ) in
    let _ = writeStderrU64 bytes in
    withLocal (fixedArrayRepeat 8 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      let _ = put8 p 0 32 98 121 116 101 115 41 10 in
      writeStderrRaw p 8
    )

  writeStackSuffix :: Unit ->{Global} Unit
  writeStackSuffix _ =
    withLocal (fixedArrayRepeat 8 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      let _ = put4 p 0 115 116 97 99 in
      let _ = storeU8 p 4 107 in
      let _ = storeU8 p 5 10 in
      writeStderrRaw p 6
    )

  writeThreadsSuffix :: Unit ->{Global} Unit
  writeThreadsSuffix _ =
    withLocal (fixedArrayRepeat 8 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      let _ = put8 p 0 116 104 114 101 97 100 115 10 in
      writeStderrRaw p 8
    )

  exhaustedHeap :: U64 ->{Global} Unit
  exhaustedHeap bytes =
    let _ = claimExhausted () in
    let _ = writeExhaustedPrefix () in
    let _ = writeHeapSuffix bytes in
    cExit exitExhausted

  exhaustedHeapInSignal :: U64 ->{Global} Unit
  exhaustedHeapInSignal bytes =
    let _ = claimExhausted () in
    let _ = writeExhaustedPrefix () in
    let _ = writeHeapSuffix bytes in
    cRawExit exitExhausted

  exhaustedStack :: Unit ->{Global} Unit
  exhaustedStack _ =
    let _ = claimExhausted () in
    let _ = writeExhaustedPrefix () in
    let _ = writeStackSuffix () in
    cExit exitExhausted

  exhaustedStackInSignal :: Unit ->{Global} Unit
  exhaustedStackInSignal _ =
    let _ = claimExhausted () in
    let _ = writeExhaustedPrefix () in
    let _ = writeStackSuffix () in
    cRawExit exitExhausted

  exhaustedThreads :: Unit ->{Global} Unit
  exhaustedThreads _ =
    let _ = claimExhausted () in
    let _ = writeExhaustedPrefix () in
    let _ = writeThreadsSuffix () in
    cExit exitExhausted

  -- Backtrace on fault when CINCH_BACKTRACE is truthy
  asciiLower :: U8 -> U8
  asciiLower b =
    if u8Ge b 65 && u8Le b 90 then u8Add b 32 else b

  isSpaceByte :: U8 -> Bool
  isSpaceByte b = b == 32 || b == 9 || b == 10 || b == 13

  skipSpacesFwd :: RawPtr U8 -> U64 -> U64 ->{Global} U64
  skipSpacesFwd p i len =
    if u64Ge i len then i
    else if isSpaceByte (loadU8 p (u64ToIsize i)) then skipSpacesFwd p (u64Add i 1) len
    else i

  skipSpacesBwd :: RawPtr U8 -> U64 -> U64 ->{Global} U64
  skipSpacesBwd p lo hi =
    if u64Le hi lo then lo
    else
      let prev = u64Sub hi 1 in
      if isSpaceByte (loadU8 p (u64ToIsize prev)) then skipSpacesBwd p lo prev
      else hi

  traceEnabled :: Unit ->{Global} Bool
  traceEnabled _ =
    withLocal (fixedArrayRepeat 16 (0 :: U8)) (\arr ->
      let k = mutAsPtr arr in
      -- "CINCH_BACKTRACE\0" (16 bytes)
      let _ = put8 k 0 67 73 78 67 72 95 66 65 in
      let _ = put8 k 8 67 75 84 82 65 67 69 0 in
      let raw = cGetenv k in
      if ptrIsNull raw then False
      else
        let p = maybeToRaw raw in
        let total = usizeToU64 (cStrlen p) in
        let lo = skipSpacesFwd p 0 total in
        let hi = skipSpacesBwd p lo total in
        let n = u64Sub hi lo in
        if n == 0 then False
        else if n == 1 && loadU8 p (u64ToIsize lo) == 48 then False
        else if n == 2
          && asciiLower (loadU8 p (u64ToIsize lo)) == 110
          && asciiLower (loadU8 p (u64ToIsize (u64Add lo 1))) == 111 then False
        else if n == 5
          && asciiLower (loadU8 p (u64ToIsize lo)) == 102
          && asciiLower (loadU8 p (u64ToIsize (u64Add lo 1))) == 97
          && asciiLower (loadU8 p (u64ToIsize (u64Add lo 2))) == 108
          && asciiLower (loadU8 p (u64ToIsize (u64Add lo 3))) == 115
          && asciiLower (loadU8 p (u64ToIsize (u64Add lo 4))) == 101 then False
        else True
    )

  hexNibble :: U64 -> U8
  hexNibble d =
    if u64Lt d 10 then u64ToU8 (u64Add 48 d)
    else u64ToU8 (u64Add 87 d)

  writeHex16 :: RawPtr U8 -> Isize -> U64 -> U64 ->{Global} Unit
  writeHex16 buf off v i =
    if u64Ge i 16 then ()
    else
      let shift = u64Mul (u64Sub 15 i) 4 in
      let nib = bitAndU64 (lshrU64 v shift) 15 in
      let _ = storeU8 buf (i64ToIsize (i64Add (isizeToI64 off) (u64ToI64 i))) (hexNibble nib) in
      writeHex16 buf off v (u64Add i 1)

  writeHexVarLoop :: RawPtr U8 -> U64 -> Isize ->{Global} Isize
  writeHexVarLoop buf v pos =
    let nib = bitAndU64 v 15 in
    let q = lshrU64 v 4 in
    let nextPos = i64ToIsize (i64Sub (isizeToI64 pos) 1) in
    let _ = storeU8 buf nextPos (hexNibble nib) in
    if q == 0 then nextPos else writeHexVarLoop buf q nextPos

  writeStderrHexVar :: U64 ->{Global} Unit
  writeStderrHexVar v =
    withLocal (fixedArrayRepeat 24 (0 :: U8)) (\arr ->
      let buf = mutAsPtr arr in
      let start = writeHexVarLoop buf v 24 in
      let len = u64ToUsize (i64ToU64 (i64Sub 24 (isizeToI64 start))) in
      writeStderrRaw (ptrAdd buf start) len
    )

  traceWalkLoop :: RawPtr U64 -> U64 -> U64 -> U64 ->{Global} U64
  traceWalkLoop pcs fp stackLow count =
    if u64Ge count 64 then count
    else if fp == 0 || bitAndU64 fp 7 /= 0 || u64Lt fp stackLow then count
    else
      let fpPtr = maybeToRaw (ptrFromU64 fp) in
      let nextFp = loadU64 fpPtr 0 in
      let retAddr = loadU64 fpPtr 8 in
      if retAddr == 0 then count
      else
        let _ = storeU64 pcs (u64ToIsize (u64Mul count 8)) retAddr in
        let nextCount = u64Add count 1 in
        if u64Le nextFp fp || u64Gt (u64Sub nextFp fp) 16777216 then nextCount
        else traceWalkLoop pcs nextFp stackLow nextCount

  tracePrintFrames :: RawPtr U64 -> U64 -> U64 -> U64 ->{Global} Unit
  tracePrintFrames pcs idx count slide =
    if u64Ge idx count then ()
    else
      let pc = loadU64 pcs (u64ToIsize (u64Mul idx 8)) in
      let rel = if u64Ge pc slide then u64Sub pc slide else pc in
      let _ = withLocal (fixedArrayRepeat 32 (0 :: U8)) (\arr ->
        let p = mutAsPtr arr in
        -- "  #"
        let _ = storeU8 p 0 32 in
        let _ = storeU8 p 1 32 in
        let _ = storeU8 p 2 35 in
        let pos =
              (if u64Lt idx 10 then
                let _ = storeU8 p 3 (u64ToU8 (u64Add 48 idx)) in
                let _ = storeU8 p 4 32 in
                (5 :: Isize)
              else
                let _ = storeU8 p 3 (u64ToU8 (u64Add 48 (u64Div idx 10))) in
                let _ = storeU8 p 4 (u64ToU8 (u64Add 48 (u64Rem idx 10))) in
                (5 :: Isize)) in
        -- " 0x"
        let _ = storeU8 p pos 32 in
        let _ = storeU8 p (i64ToIsize (i64Add (isizeToI64 pos) 1)) 48 in
        let _ = storeU8 p (i64ToIsize (i64Add (isizeToI64 pos) 2)) 120 in
        let _ = writeHex16 p (i64ToIsize (i64Add (isizeToI64 pos) 3)) pc 0 in
        -- " +0x"
        let p2 = i64ToIsize (i64Add (isizeToI64 pos) 19) in
        let _ = put4 p p2 32 43 48 120 in
        writeStderrRaw p (u64ToUsize (i64ToU64 (i64Add (isizeToI64 pos) 23)))
      ) in
      let _ = writeStderrHexVar rel in
      let _ = writeNewline () in
      tracePrintFrames pcs (u64Add idx 1) count slide

  traceRender :: Unit ->{Global} Unit
  traceRender _ =
    withLocal (fixedArrayRepeat 64 (0 :: U64)) (\pcsArr ->
      let pcs = ptrCast (mutAsPtr pcsArr) in
      let fp = sysFramePointer () in
      let stackLow = u64SatSub fp 134217728 in
      let count = traceWalkLoop pcs fp stackLow 0 in
      if count == 0 then ()
      else
        let _ = withLocal (fixedArrayRepeat 24 (0 :: U8)) (\hdr ->
          let p = mutAsPtr hdr in
          -- "cinch-backtrace: " (17 bytes)
          let _ = put8 p 0 99 105 110 99 104 45 98 97 in
          let _ = put8 p 8 99 107 116 114 97 99 101 58 in
          let _ = storeU8 p 16 32 in
          writeStderrRaw p 17
        ) in
        let _ = writeStderrU64 count in
        let _ = withLocal (fixedArrayRepeat 16 (0 :: U8)) (\sfx ->
          let p = mutAsPtr sfx in
          -- " frame(s)\n" (10 bytes)
          let _ = put8 p 0 32 102 114 97 109 101 40 115 in
          let _ = storeU8 p 8 41 in
          let _ = storeU8 p 9 10 in
          writeStderrRaw p 10
        ) in
        let slide = sysMainImageSlide () in
        tracePrintFrames pcs 0 count slide
    )

  panicExitBytes :: RawPtr U8 -> Usize ->{Global} Unit
  panicExitBytes ptr len =
    let _ = writeCinchRuntimePrefix () in
    let _ = writeStderrRaw ptr len in
    let _ = writeNewline () in
    let _ = if traceEnabled () then traceRender () else () in
    cExit exitPanic

  cinchBlackhole :: Unit ->{Global} Unit
  cinchBlackhole _ = cExit exitBlackhole

  cinchPanic :: MaybeNull U8 -> Usize ->{Global} Unit
  cinchPanic msg len =
    if len == 0 then
      let _ = writeCinchRuntimePrefix () in
      let _ = writeNewline () in
      cExit exitPanic
    else if ptrIsNull msg then
      let _ = writeCinchRuntimePrefix () in
      let _ = writeCorruptPanicMsg () in
      let _ = writeNewline () in
      cExit exitPanic
    else
      panicExitBytes (maybeToRaw msg) len

  foreign export ccall "cinch_blackhole" cinchBlackhole :: Unit ->{Global} Unit
  foreign export ccall "cinch_panic" cinchPanic :: MaybeNull U8 -> Usize ->{Global} Unit

  -- Standardized runtime error traps (matching seed/runtime/src/error.rs Display messages)
  panicNegativeInput :: Unit ->{Global} Unit
  panicNegativeInput _ =
    withLocal (fixedArrayRepeat 128 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "compiler bug: natural number constructed from negative input (`nat-from-i64` carries evidence that its argument is non-negative)" (128 bytes)
      let _ = put8 p 0 99 111 109 112 105 108 101 114 in
      let _ = put8 p 8 32 98 117 103 58 32 110 97 in
      let _ = put8 p 16 116 117 114 97 108 32 110 117 in
      let _ = put8 p 24 109 98 101 114 32 99 111 110 in
      let _ = put8 p 32 115 116 114 117 99 116 101 100 in
      let _ = put8 p 40 32 102 114 111 109 32 110 101 in
      let _ = put8 p 48 103 97 116 105 118 101 32 105 in
      let _ = put8 p 56 110 112 117 116 32 40 96 110 in
      let _ = put8 p 64 97 116 45 102 114 111 109 45 in
      let _ = put8 p 72 105 54 52 96 32 99 97 114 in
      let _ = put8 p 80 114 105 101 115 32 101 118 105 in
      let _ = put8 p 88 100 101 110 99 101 32 116 104 in
      let _ = put8 p 96 97 116 32 105 116 115 32 97 in
      let _ = put8 p 104 114 103 117 109 101 110 116 32 in
      let _ = put8 p 112 105 115 32 110 111 110 45 110 in
      let _ = put8 p 120 101 103 97 116 105 118 101 41 in
      panicExitBytes p 128
    )

  panicNegativeResult :: Unit ->{Global} Unit
  panicNegativeResult _ =
    withLocal (fixedArrayRepeat 104 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "compiler bug: natural subtraction below zero (every `a - b` at `Nat` carries evidence that `b <= a`)" (100 bytes)
      let _ = put8 p 0 99 111 109 112 105 108 101 114 in
      let _ = put8 p 8 32 98 117 103 58 32 110 97 in
      let _ = put8 p 16 116 117 114 97 108 32 115 117 in
      let _ = put8 p 24 98 116 114 97 99 116 105 111 in
      let _ = put8 p 32 110 32 98 101 108 111 119 32 in
      let _ = put8 p 40 122 101 114 111 32 40 101 118 in
      let _ = put8 p 48 101 114 121 32 96 97 32 45 in
      let _ = put8 p 56 32 98 96 32 97 116 32 96 in
      let _ = put8 p 64 78 97 116 96 32 99 97 114 in
      let _ = put8 p 72 114 105 101 115 32 101 118 105 in
      let _ = put8 p 80 100 101 110 99 101 32 116 104 in
      let _ = put8 p 88 97 116 32 96 98 32 60 61 in
      let _ = put4 p 96 32 97 96 41 in
      panicExitBytes p 100
    )

  panicDivByZero :: Unit ->{Global} Unit
  panicDivByZero _ =
    withLocal (fixedArrayRepeat 96 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "compiler bug: division or remainder by zero (every divisor is a `NonZero` by its type)" (86 bytes)
      let _ = put8 p 0 99 111 109 112 105 108 101 114 in
      let _ = put8 p 8 32 98 117 103 58 32 100 105 in
      let _ = put8 p 16 118 105 115 105 111 110 32 111 in
      let _ = put8 p 24 114 32 114 101 109 97 105 110 in
      let _ = put8 p 32 100 101 114 32 98 121 32 122 in
      let _ = put8 p 40 101 114 111 32 40 101 118 101 in
      let _ = put8 p 48 114 121 32 100 105 118 105 115 in
      let _ = put8 p 56 111 114 32 105 115 32 97 32 in
      let _ = put8 p 64 96 78 111 110 90 101 114 111 in
      let _ = put8 p 72 96 32 98 121 32 105 116 115 in
      let _ = put4 p 80 32 116 121 112 in
      let _ = storeU8 p 84 101 in
      let _ = storeU8 p 85 41 in
      panicExitBytes p 86
    )

  panicOutOfRange :: Unit ->{Global} Unit
  panicOutOfRange _ =
    withLocal (fixedArrayRepeat 120 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "compiler bug: value does not fit in i64 (every conversion to `I64` carries evidence that its value is in range)" (111 bytes)
      let _ = put8 p 0 99 111 109 112 105 108 101 114 in
      let _ = put8 p 8 32 98 117 103 58 32 118 97 in
      let _ = put8 p 16 108 117 101 32 100 111 101 115 in
      let _ = put8 p 24 32 110 111 116 32 102 105 116 in
      let _ = put8 p 32 32 105 110 32 105 54 52 32 in
      let _ = put8 p 40 40 101 118 101 114 121 32 99 in
      let _ = put8 p 48 111 110 118 101 114 115 105 111 in
      let _ = put8 p 56 110 32 116 111 32 96 73 54 in
      let _ = put8 p 64 52 96 32 99 97 114 114 105 in
      let _ = put8 p 72 101 115 32 101 118 105 100 101 in
      let _ = put8 p 80 110 99 101 32 116 104 97 116 in
      let _ = put8 p 88 32 105 116 115 32 118 97 108 in
      let _ = put8 p 96 117 101 32 105 115 32 105 110 in
      let _ = put4 p 104 32 114 97 110 in
      let _ = storeU8 p 108 103 in
      let _ = storeU8 p 109 101 in
      let _ = storeU8 p 110 41 in
      panicExitBytes p 111
    )

  panicMalformedDecimal :: Unit ->{Global} Unit
  panicMalformedDecimal _ =
    withLocal (fixedArrayRepeat 32 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "malformed decimal numeral" (25 bytes)
      let _ = put8 p 0 109 97 108 102 111 114 109 101 in
      let _ = put8 p 8 100 32 100 101 99 105 109 97 in
      let _ = put8 p 16 108 32 110 117 109 101 114 97 in
      let _ = storeU8 p 24 108 in
      panicExitBytes p 25
    )

  panicBufferTooSmall :: Unit ->{Global} Unit
  panicBufferTooSmall _ =
    withLocal (fixedArrayRepeat 32 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "decimal buffer too small" (24 bytes)
      let _ = put8 p 0 100 101 99 105 109 97 108 32 in
      let _ = put8 p 8 98 117 102 102 101 114 32 116 in
      let _ = put8 p 16 111 111 32 115 109 97 108 108 in
      panicExitBytes p 24
    )

  panicMalformedName :: Unit ->{Global} Unit
  panicMalformedName _ =
    withLocal (fixedArrayRepeat 32 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "symbol name is not valid UTF-8" (30 bytes)
      let _ = put8 p 0 115 121 109 98 111 108 32 110 in
      let _ = put8 p 8 97 109 101 32 105 115 32 110 in
      let _ = put8 p 16 111 116 32 118 97 108 105 100 in
      let _ = put4 p 24 32 85 84 70 in
      let _ = storeU8 p 28 45 in
      let _ = storeU8 p 29 56 in
      panicExitBytes p 30
    )

  panicOutOfBounds :: Unit ->{Global} Unit
  panicOutOfBounds _ =
    withLocal (fixedArrayRepeat 64 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "compiler bug: byte-buffer index, range or byte value out of range" (65 -> 65 bytes)
      let _ = put8 p 0 99 111 109 112 105 108 101 114 in
      let _ = put8 p 8 32 98 117 103 58 32 98 121 in
      let _ = put8 p 16 116 101 45 98 117 102 102 101 in
      let _ = put8 p 24 114 32 105 110 100 101 120 44 in
      let _ = put8 p 32 32 114 97 110 103 101 32 111 in
      let _ = put8 p 40 114 32 98 121 116 101 32 118 in
      let _ = put8 p 48 97 108 117 101 32 111 117 116 in
      let _ = put8 p 56 32 111 102 32 114 97 110 103 in
      panicExitBytes p 64
    )

  panicReadOnly :: Unit ->{Global} Unit
  panicReadOnly _ =
    withLocal (fixedArrayRepeat 56 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "compiler bug: a write reached a read-only buffer" (48 bytes)
      let _ = put8 p 0 99 111 109 112 105 108 101 114 in
      let _ = put8 p 8 32 98 117 103 58 32 97 32 in
      let _ = put8 p 16 119 114 105 116 101 32 114 101 in
      let _ = put8 p 24 97 99 104 101 100 32 97 32 in
      let _ = put8 p 32 114 101 97 100 45 111 110 108 in
      let _ = put8 p 40 121 32 98 117 102 102 101 114 in
      panicExitBytes p 48
    )

  panicCorruptValue :: Unit ->{Global} Unit
  panicCorruptValue _ =
    withLocal (fixedArrayRepeat 64 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "compiler bug: null or wrong-kind word or corrupt generated data" (63 bytes)
      let _ = put8 p 0 99 111 109 112 105 108 101 114 in
      let _ = put8 p 8 32 98 117 103 58 32 110 117 in
      let _ = put8 p 16 108 108 32 111 114 32 119 114 in
      let _ = put8 p 24 111 110 103 45 107 105 110 100 in
      let _ = put8 p 32 32 119 111 114 100 32 111 114 in
      let _ = put8 p 40 32 99 111 114 114 117 112 116 in
      let _ = put8 p 48 32 103 101 110 101 114 97 116 in
      let _ = put4 p 56 101 100 32 100 in
      let _ = storeU8 p 60 97 in
      let _ = storeU8 p 61 116 in
      let _ = storeU8 p 62 97 in
      panicExitBytes p 63
    )

  panicUnmapFailed :: Unit ->{Global} Unit
  panicUnmapFailed _ =
    withLocal (fixedArrayRepeat 48 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "compiler bug: cannot release mapped bytes" (41 bytes)
      let _ = put8 p 0 99 111 109 112 105 108 101 114 in
      let _ = put8 p 8 32 98 117 103 58 32 99 97 in
      let _ = put8 p 16 110 110 111 116 32 114 101 108 in
      let _ = put8 p 24 101 97 115 101 32 109 97 112 in
      let _ = put8 p 32 112 101 100 32 98 121 116 101 in
      let _ = storeU8 p 40 115 in
      panicExitBytes p 41
    )

  panicOutputFailed :: Unit ->{Global} Unit
  panicOutputFailed _ =
    withLocal (fixedArrayRepeat 40 (0 :: U8)) (\arr ->
      let p = mutAsPtr arr in
      -- "writing to standard output failed" (33 bytes)
      let _ = put8 p 0 119 114 105 116 105 110 103 32 in
      let _ = put8 p 8 116 111 32 115 116 97 110 100 in
      let _ = put8 p 16 97 114 100 32 111 117 116 112 in
      let _ = put8 p 24 117 116 32 102 97 105 108 101 in
      let _ = storeU8 p 32 100 in
      panicExitBytes p 33
    )
