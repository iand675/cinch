  -- Temporary bridge to Rust eval::TLS until Milestone 8 migrates eval.rs to Cinch
  foreign import ccall "cinch_rt_eval_swap_state" rtEvalSwapState :: RawPtr U8 ->{Global} Unit

  -- Non-inlined C boundary for context switch (prevents red-zone use and TLS hoisting)
  foreign import ccall "cinch_rt_fiber_switch" callFiberSwitch :: U64 -> U64 ->{Global} Unit

  -- =========================================================================
  -- Constants & Struct Layouts
  -- =========================================================================

  taskOkTag :: I64
  taskOkTag = 1

  taskErrTag :: I64
  taskErrTag = 0

  joinFailedCode :: I64
  joinFailedCode = i64Sub 0 1

  joinMaskBits :: U64
  joinMaskBits = 62

  taskStackBytes :: U64
  taskStackBytes = 8388608 -- 8 MiB

  workerStackBytes :: U64
  workerStackBytes = u64Mul 2 stackMinBytes -- 512 KiB

  stackCacheCap :: U64
  stackCacheCap = 64

  -- Context kinds
  ctxThread :: U64
  ctxThread = 0
  ctxHelper :: U64
  ctxHelper = 1
  ctxFiber :: U64
  ctxFiber = 2

  -- Fiber states
  fRunnable :: U64
  fRunnable = 0
  fRunning :: U64
  fRunning = 1
  fParking :: U64
  fParking = 2
  fParked :: U64
  fParked = 3
  fDone :: U64
  fDone = 4

  -- Common Context header offsets
  offCtxRc :: Isize
  offCtxRc = 0
  offCtxKind :: Isize
  offCtxKind = 8
  offCtxToken :: Isize
  offCtxToken = 16
  offCtxBlocking :: Isize
  offCtxBlocking = 24

  -- Thread context (160 bytes)
  offThreadMutex :: Isize
  offThreadMutex = 32
  offThreadCond :: Isize
  offThreadCond = 96
  threadCtxBytes :: Usize
  threadCtxBytes = 160

  -- Helper context (128 bytes)
  offHelperCond :: Isize
  offHelperCond = 32
  offHelperPrev :: Isize
  offHelperPrev = 96
  offHelperNext :: Isize
  offHelperNext = 104
  offHelperAsleep :: Isize
  offHelperAsleep = 112
  helperCtxBytes :: Usize
  helperCtxBytes = 128

  -- Fiber context (176 bytes)
  offFiberState :: Isize
  offFiberState = 32
  offFiberSp :: Isize
  offFiberSp = 40
  offFiberStack :: Isize
  offFiberStack = 48
  offFiberZoneLo :: Isize
  offFiberZoneLo = 56
  offFiberZoneHi :: Isize
  offFiberZoneHi = 64
  offFiberScope :: Isize
  offFiberScope = 72
  offFiberTask :: Isize
  offFiberTask = 80
  offFiberClosure :: Isize
  offFiberClosure = 88
  offFiberLocalTask :: Isize
  offFiberLocalTask = 96
  offFiberLocalArena :: Isize
  offFiberLocalArena = 104
  offFiberEvalLo :: Isize
  offFiberEvalLo = 112
  offFiberEvalHi :: Isize
  offFiberEvalHi = 120
  offFiberRunNext :: Isize
  offFiberRunNext = 128
  offFiberTimerPrev :: Isize
  offFiberTimerPrev = 136
  offFiberTimerNext :: Isize
  offFiberTimerNext = 144
  offFiberTimerDeadline :: Isize
  offFiberTimerDeadline = 152
  offFiberInTimer :: Isize
  offFiberInTimer = 160
  fiberCtxBytes :: Usize
  fiberCtxBytes = 176

  -- Per-thread Run struct (64 bytes, stored in pthread_key_t)
  offRunSchedSp :: Isize
  offRunSchedSp = 0
  offRunFiber :: Isize
  offRunFiber = 8
  offRunHelper :: Isize
  offRunHelper = 16
  offRunDeadline :: Isize
  offRunDeadline = 24
  offRunSpare :: Isize
  offRunSpare = 32
  offRunTask :: Isize
  offRunTask = 40
  offRunThreadCtx :: Isize
  offRunThreadCtx = 48
  runStructBytes :: Usize
  runStructBytes = 64

  -- TaskState (32 bytes, leaked by design like Rust Arc::into_raw)
  offTaskCancel :: Isize
  offTaskCancel = 0
  offTaskDone :: Isize
  offTaskDone = 8
  offTaskResult :: Isize
  offTaskResult = 16
  offTaskParker :: Isize
  offTaskParker = 24
  taskStateBytes :: Usize
  taskStateBytes = 32

  -- Scope (128 bytes)
  offScopeRc :: Isize
  offScopeRc = 0
  offScopeMutex :: Isize
  offScopeMutex = 8
  offScopeChildrenData :: Isize
  offScopeChildrenData = 72
  offScopeChildrenLen :: Isize
  offScopeChildrenLen = 80
  offScopeChildrenCap :: Isize
  offScopeChildrenCap = 88
  offScopeFailed :: Isize
  offScopeFailed = 96
  offScopeWaitersData :: Isize
  offScopeWaitersData = 104
  offScopeWaitersLen :: Isize
  offScopeWaitersLen = 112
  offScopeWaitersCap :: Isize
  offScopeWaitersCap = 120
