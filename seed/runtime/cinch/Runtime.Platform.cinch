  cinchProcessWriteStdin :: I64 -> I64 ->{Global} I64
  cinchProcessWriteStdin h dataWord =
    let bs = bytesReadSlice dataWord in
    let _ = pipedLock () in
    let ep = pipedLookupLocked h in
    let neg1 = i64ToI32 (i64Sub 0 1) in
    let fd =
          (if ptrIsNull ep then neg1
          else
            let e = maybeToRaw ep in
            let f = loadI32 e 12 in
            let _ = if i64Ge (i32ToI64 f) 0 then storeI32 e 12 neg1 else () in
            f) in
    let _ = pipedUnlock () in
    if i64Lt (i32ToI64 fd) 0 then negErr errInvalidArg
    else
      let rc = writeAllFd fd bs.bsPtr (i64ToU64 bs.bsLen) in
      let _ = pipedLock () in
      let ep2 = pipedLookupLocked h in
      let _ = (if not (ptrIsNull ep2) then storeI32 (maybeToRaw ep2) 12 fd
        else (let _ = cClose fd in ())) in
      let _ = pipedUnlock () in
      if i64Lt rc 0 then rc else bs.bsLen

  cinchProcessCloseStdin :: I64 ->{Global} I64
  cinchProcessCloseStdin h =
    let _ = pipedLock () in
    let ep = pipedLookupLocked h in
    if ptrIsNull ep then
