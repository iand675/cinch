      let _ = storeI32 e 12 (i64ToI32 (i64Sub 0 1)) in
      let _ = pipedUnlock () in
      let _ = if i64Ge (i32ToI64 fd) 0 then (let _ = cClose fd in ()) else () in
      0

  cinchProcessRead :: I64 -> I64 -> I64 ->{Global, ThreadAffine} I64
  cinchProcessRead h which maxLen =
    if i64Le maxLen 0 || (which /= 0 && which /= 1) then negErr errInvalidArg
    else
      let _ = pipedLock () in
      let ep = pipedLookupLocked h in
      let neg1 = i64ToI32 (i64Sub 0 1) in
      let dupFd =
            (if ptrIsNull ep then neg1
            else
              let e = maybeToRaw ep in
              let rawFd = if which == 0 then loadI32 e 16 else loadI32 e 20 in
              if i64Lt (i32ToI64 rawFd) 0 then neg1 else cDup rawFd) in
      let _ = pipedUnlock () in
      if i64Lt (i32ToI64 dupFd) 0 then negErr errInvalidArg
      else
        let cap = i64ToU64 maxLen in
        let buf = heapGlobalAlloc (u64ToUsize cap) 1 0 in
        let n = readOnceFd dupFd buf cap in
        let _ = cClose dupFd in
        if i64Lt n 0 then
          let _ = heapGlobalDealloc buf (u64ToUsize cap) 1 in
          n
        else
          let word = bytesBoxCopy buf (i64ToU64 n) in
          let _ = heapGlobalDealloc buf (u64ToUsize cap) 1 in
          word

  cinchProcessWait :: I64 ->{Global} I64
  cinchProcessWait h =
    let _ = pipedLock () in
    let ep = pipedLookupLocked h in
    if ptrIsNull ep then
      let _ = pipedUnlock () in
      negErr errInvalidArg
    else
      let e = maybeToRaw ep in
      if loadU64 e 24 /= 0 then
        let st = loadI64 e 32 in
        let _ = pipedUnlock () in
        st
      else
        let pid = loadI32 e 8 in
        let res = withLocal (0 :: I32) (\st -> waitpidLoop pid (mutAsPtr st)) in
        let _ = (if i64Ge res 0 then
            let _ = storeU64 e 24 1 in
            storeI64 e 32 res
          else ()) in
        let _ = pipedUnlock () in
        res

  cinchProcessClose :: I64 ->{Global, ThreadAffine} I64
  cinchProcessClose h =
    let _ = pipedLock () in
    let ep = pipedRemoveLocked h in
    let _ = pipedUnlock () in
    if ptrIsNull ep then negErr errInvalidArg
    else
      let e = maybeToRaw ep in
      let inFd = loadI32 e 12 in
      let outFd = loadI32 e 16 in
      let errFd = loadI32 e 20 in
      let _ = if i64Ge (i32ToI64 inFd) 0 then (let _ = cClose inFd in ()) else () in
      let _ = if i64Ge (i32ToI64 outFd) 0 then (let _ = cClose outFd in ()) else () in
      let _ = if i64Ge (i32ToI64 errFd) 0 then (let _ = cClose errFd in ()) else () in
      let _ = (if loadU64 e 24 == 0 then
          let pid = loadI32 e 8 in
          let _ = if i64Gt (i32ToI64 pid) 0 then (let _ = cKill pid 9 in let _ = withLocal (0 :: I32) (\st -> waitpidLoop pid (mutAsPtr st)) in ()) else () in
          ()
        else ()) in
      let _ = heapGlobalDealloc e pipedEntryBytes 8 in
      0

