  prim sysIsLinuxPrim :: I64 -> Bool where
    unsafe llvm { ret i8 1 } when os linux
    unsafe llvm { ret i8 0 }

  sysIsLinux :: Bool
  sysIsLinux = sysIsLinuxPrim 0

  prim sysMainImageSlidePrim :: I64 ->{Global} U64 where
    unsafe llvm {
      %s = call i64 @_dyld_get_image_vmaddr_slide(i32 0)
      ret i64 %s
    } uses (_dyld_get_image_vmaddr_slide :: U32 -> I64) when os darwin
    unsafe llvm {
      ret i64 0
    }

  sysMainImageSlide :: Unit ->{Global} U64
  sysMainImageSlide _ = sysMainImageSlidePrim 0

  prim sysFramePointerPrim :: I64 ->{Global} U64 where
    unsafe llvm {
      %fp = call i64 asm "mov $0, x29", "=r"()
      ret i64 %fp
    } when arch aarch64
    unsafe llvm {
      %fp = call i64 asm "movq %rbp, $0", "=r"()
      ret i64 %fp
    } when arch x86_64
    unsafe llvm {
      ret i64 0
    }

  sysFramePointer :: Unit ->{Global} U64
  sysFramePointer _ = sysFramePointerPrim 0

  prim sysDarwinStackAddr :: U64 ->{Global} U64 where
    unsafe llvm {
      %p = call ptr @pthread_get_stackaddr_np(i64 %0)
      %v = ptrtoint ptr %p to i64
      ret i64 %v
    } uses (pthread_get_stackaddr_np :: U64 -> RawPtr U8) when os darwin
    unsafe llvm { ret i64 0 }

  prim sysDarwinStackSize :: U64 ->{Global} U64 where
    unsafe llvm {
      %s = call i64 @pthread_get_stacksize_np(i64 %0)
      ret i64 %s
    } uses (pthread_get_stacksize_np :: U64 -> U64) when os darwin
    unsafe llvm { ret i64 0 }

  prim sysLinuxGetAttr :: U64 -> RawPtr U8 ->{Global} I32 where
    unsafe llvm {
      %r = call i32 @pthread_getattr_np(i64 %0, ptr %1)
      ret i32 %r
    } uses (pthread_getattr_np :: U64 -> RawPtr U8 -> I32) when os linux
    unsafe llvm { ret i32 -1 }

  prim sysLinuxAttrGetStack :: RawPtr U8 -> RawPtr U64 -> RawPtr U64 ->{Global} I32 where
    unsafe llvm {
      %r = call i32 @pthread_attr_getstack(ptr %0, ptr %1, ptr %2)
      ret i32 %r
    } uses (pthread_attr_getstack :: RawPtr U8 -> RawPtr U64 -> RawPtr U64 -> I32) when os linux
    unsafe llvm { ret i32 -1 }

  sysThisThreadStack :: RawPtr U64 -> RawPtr U64 ->{Global} Bool
  sysThisThreadStack outLow outSize =
    let self = cPthreadSelf () in
    if sysIsLinux then
      withLocal (fixedArrayRepeat 128 (0 :: U8)) (\attrBuf ->
        let ap = mutAsPtr attrBuf in
        if sysLinuxGetAttr self ap /= 0 then False
        else
          let rc = sysLinuxAttrGetStack ap outLow outSize in
          let _ = cPthreadAttrDestroy ap in
          rc == 0
      )
    else
      let top = sysDarwinStackAddr self in
      let sz = sysDarwinStackSize self in
      if u64Lt top sz || sz == 0 then False
      else
        let _ = storeU64 outLow 0 (u64Sub top sz) in
        let _ = storeU64 outSize 0 sz in
        True

  sysAvailableParallelism :: Unit ->{Global} U64
  sysAvailableParallelism _ =
    let sc = if sysIsLinux then (84 :: I32) else (58 :: I32) in
    let n = cSysconf sc in
    if i64Gt n 0 then i64ToU64 n else 1

  sysMonotonicNs :: Unit ->{Global} U64
  sysMonotonicNs _ =
    withLocal (fixedArrayRepeat 2 (0 :: U64)) (\ts ->
      let p = ptrCast (mutAsPtr ts) in
      let clk = if sysIsLinux then (1 :: I32) else (6 :: I32) in
      let _ = cClockGettime clk p in
      let sec = loadU64 p 0 in
      let nsec = loadU64 p 8 in
      u64Add (u64Mul sec 1000000000) nsec
    )

  sysRealtimeNs :: Unit ->{Global} U64
  sysRealtimeNs _ =
    withLocal (fixedArrayRepeat 2 (0 :: U64)) (\ts ->
      let p = ptrCast (mutAsPtr ts) in
      let _ = cClockGettime 0 p in
      let sec = loadU64 p 0 in
      let nsec = loadU64 p 8 in
      u64Add (u64Mul sec 1000000000) nsec
    )

  sysCondTimedWaitNs :: RawPtr U8 -> RawPtr U8 -> U64 ->{Global} I32
  sysCondTimedWaitNs cond mtx timeoutNs =
    withLocal (fixedArrayRepeat 2 (0 :: U64)) (\ts ->
      let p = ptrCast (mutAsPtr ts) in
      let _ = cClockGettime 0 p in
      let sec = loadU64 p 0 in
      let nsec = loadU64 p 8 in
      let addSec = u64Div timeoutNs 1000000000 in
      let addNsec = u64Rem timeoutNs 1000000000 in
      let rawNsec = u64Add nsec addNsec in
      let carry = if u64Ge rawNsec 1000000000 then 1 else 0 in
      let finalNsec = if carry /= 0 then u64Sub rawNsec 1000000000 else rawNsec in
      let finalSec = u64Add (u64Add sec addSec) carry in
      let _ = storeU64 p 0 finalSec in
      let _ = storeU64 p 8 finalNsec in
      cPthreadCondTimedwait cond mtx p
    )

  prim sysCallFn0 :: U64 ->{Global} I64 where
    unsafe llvm {
      %r = call i64 asm sideeffect "blr $1", "={x0},{x9},~{x1},~{x2},~{x3},~{x4},~{x5},~{x6},~{x7},~{x8},~{x10},~{x11},~{x12},~{x13},~{x14},~{x15},~{x16},~{x17},~{x30},~{v0},~{v1},~{v2},~{v3},~{v4},~{v5},~{v6},~{v7},~{v16},~{v17},~{v18},~{v19},~{v20},~{v21},~{v22},~{v23},~{v24},~{v25},~{v26},~{v27},~{v28},~{v29},~{v30},~{v31},~{cc},~{memory}"(i64 %0)
      ret i64 %r
    } when arch aarch64
    unsafe llvm {
      %r = call i64 asm sideeffect "callq *$1", "={rax},{r11},~{rcx},~{rdx},~{rsi},~{rdi},~{r8},~{r9},~{r10},~{xmm0},~{xmm1},~{xmm2},~{xmm3},~{xmm4},~{xmm5},~{xmm6},~{xmm7},~{xmm8},~{xmm9},~{xmm10},~{xmm11},~{xmm12},~{xmm13},~{xmm14},~{xmm15},~{cc},~{memory}"(i64 %0)
      ret i64 %r
    } when arch x86_64
    unsafe llvm { ret i64 0 }

  prim sysCallFn1 :: U64 -> MaybeNull U8 ->{Global} I64 where
    unsafe llvm {
      %a = ptrtoint ptr %1 to i64
      %r = call i64 asm sideeffect "blr $2", "={x0},0,{x9},~{x1},~{x2},~{x3},~{x4},~{x5},~{x6},~{x7},~{x8},~{x10},~{x11},~{x12},~{x13},~{x14},~{x15},~{x16},~{x17},~{x30},~{v0},~{v1},~{v2},~{v3},~{v4},~{v5},~{v6},~{v7},~{v16},~{v17},~{v18},~{v19},~{v20},~{v21},~{v22},~{v23},~{v24},~{v25},~{v26},~{v27},~{v28},~{v29},~{v30},~{v31},~{cc},~{memory}"(i64 %a, i64 %0)
      ret i64 %r
    } when arch aarch64
    unsafe llvm {
      %a = ptrtoint ptr %1 to i64
      %r = call i64 asm sideeffect "callq *$2", "={rax},{rdi},{r11},~{rcx},~{rdx},~{rsi},~{r8},~{r9},~{r10},~{xmm0},~{xmm1},~{xmm2},~{xmm3},~{xmm4},~{xmm5},~{xmm6},~{xmm7},~{xmm8},~{xmm9},~{xmm10},~{xmm11},~{xmm12},~{xmm13},~{xmm14},~{xmm15},~{cc},~{memory}"(i64 %a, i64 %0)
      ret i64 %r
    } when arch x86_64
    unsafe llvm { ret i64 0 }

  prim sysCallParExec :: U64 -> RawPtr U8 -> RawPtr U8 ->{Global} Unit where
    unsafe llvm {
      %a = ptrtoint ptr %1 to i64
      %b = ptrtoint ptr %2 to i64
      %ign = call i64 asm sideeffect "blr $3", "={x0},0,{x1},{x9},~{x2},~{x3},~{x4},~{x5},~{x6},~{x7},~{x8},~{x10},~{x11},~{x12},~{x13},~{x14},~{x15},~{x16},~{x17},~{x30},~{v0},~{v1},~{v2},~{v3},~{v4},~{v5},~{v6},~{v7},~{v16},~{v17},~{v18},~{v19},~{v20},~{v21},~{v22},~{v23},~{v24},~{v25},~{v26},~{v27},~{v28},~{v29},~{v30},~{v31},~{cc},~{memory}"(i64 %a, i64 %b, i64 %0)
      ret void
    } when arch aarch64
    unsafe llvm {
      %a = ptrtoint ptr %1 to i64
      %b = ptrtoint ptr %2 to i64
      %ign = call i64 asm sideeffect "callq *$3", "={rax},{rdi},{rsi},{r11},~{rcx},~{rdx},~{r8},~{r9},~{r10},~{xmm0},~{xmm1},~{xmm2},~{xmm3},~{xmm4},~{xmm5},~{xmm6},~{xmm7},~{xmm8},~{xmm9},~{xmm10},~{xmm11},~{xmm12},~{xmm13},~{xmm14},~{xmm15},~{cc},~{memory}"(i64 %a, i64 %b, i64 %0)
      ret void
    } when arch x86_64
    unsafe llvm { ret void }

  prim sysApplyClosure1 :: I64 -> I64 ->{Global} I64 where
    unsafe llvm {
      %p = inttoptr i64 %0 to ptr
      %code = load i64, ptr %p, align 8
      %argv = alloca i64, align 8
      store i64 %1, ptr %argv, align 8
      %argvI = ptrtoint ptr %argv to i64
      %r = call i64 asm sideeffect "blr $4", "={x0},0,{x1},{x2},{x9},~{x3},~{x4},~{x5},~{x6},~{x7},~{x8},~{x10},~{x11},~{x12},~{x13},~{x14},~{x15},~{x16},~{x17},~{x30},~{v0},~{v1},~{v2},~{v3},~{v4},~{v5},~{v6},~{v7},~{v16},~{v17},~{v18},~{v19},~{v20},~{v21},~{v22},~{v23},~{v24},~{v25},~{v26},~{v27},~{v28},~{v29},~{v30},~{v31},~{cc},~{memory}"(i64 %0, i64 1, i64 %argvI, i64 %code)
      ret i64 %r
    } when arch aarch64
    unsafe llvm {
      %p = inttoptr i64 %0 to ptr
      %code = load i64, ptr %p, align 8
      %argv = alloca i64, align 8
      store i64 %1, ptr %argv, align 8
      %argvI = ptrtoint ptr %argv to i64
      %r = call i64 asm sideeffect "callq *$4", "={rax},{rdi},{rsi},{rdx},{r11},~{rcx},~{r8},~{r9},~{r10},~{xmm0},~{xmm1},~{xmm2},~{xmm3},~{xmm4},~{xmm5},~{xmm6},~{xmm7},~{xmm8},~{xmm9},~{xmm10},~{xmm11},~{xmm12},~{xmm13},~{xmm14},~{xmm15},~{cc},~{memory}"(i64 %0, i64 1, i64 %argvI, i64 %code)
      ret i64 %r
    } when arch x86_64
    unsafe llvm { ret i64 0 }

  sysEinval :: I64
  sysEinval = 22

  prim sysErrnoPtrPrim :: I64 ->{Global} RawPtr I32 where
    unsafe llvm {
      %p = call ptr @__error()
      ret ptr %p
    } uses (__error :: I64 -> RawPtr I32) when os darwin
    unsafe llvm {
      %p = call ptr @__errno_location()
      ret ptr %p
    } uses (__errno_location :: I64 -> RawPtr I32) when os linux
    unsafe llvm {
      ret ptr null
    }

  sysErrno :: Unit ->{Global} I64
  sysErrno _ =
    let p = sysErrnoPtrPrim 0 in
    if rawToU64 p == 0 then 0 else i32ToI64 (loadI32 p 0)

  #[repr(value)]
  record MmapRes where
    mrAddr :: I64
    mrErr :: I64

  sysMmapFileReadonly :: I32 -> Usize ->{Global} MmapRes
  sysMmapFileReadonly fd size =
    let p = cMmap (ptrNull ()) size sysProtRead sysMapPrivate fd 0 in
    let maxU = i64ToU64 (i64Sub 0 1) in
    let u = ptrToU64 p in
    if u == maxU then MmapRes (i64Sub 0 1) (sysErrno ())
    else MmapRes (u64ToI64 u) 0

  sysProtNone :: I32
  sysProtNone = 0

  sysProtRead :: I32
  sysProtRead = 1

  sysProtWrite :: I32
  sysProtWrite = 2

  sysMapPrivate :: I32
  sysMapPrivate = 2

  prim sysMapAnonPrim :: I64 -> I32 where
    unsafe llvm { ret i32 4096 } when os darwin
    unsafe llvm { ret i32 32 } when os linux
    unsafe llvm { ret i32 0 }

  sysMapAnon :: I32
  sysMapAnon = sysMapAnonPrim 0

  sysMmapReserve :: Usize ->{Global} MaybeNull U8
  sysMmapReserve size =
    let flags = i64ToI32 (bitOrI64 (i32ToI64 sysMapPrivate) (i32ToI64 sysMapAnon)) in
    let p = cMmap (ptrNull ()) size sysProtNone flags (i64ToI32 (i64Sub 0 1)) 0 in
    let maxU = i64ToU64 (i64Sub 0 1) in
    if ptrToU64 p == maxU then ptrNull () else p

  sysMmapAnon :: Usize ->{Global} MaybeNull U8
  sysMmapAnon size =
    let prot = i64ToI32 (bitOrI64 (i32ToI64 sysProtRead) (i32ToI64 sysProtWrite)) in
    let flags = i64ToI32 (bitOrI64 (i32ToI64 sysMapPrivate) (i32ToI64 sysMapAnon)) in
    let p = cMmap (ptrNull ()) size prot flags (i64ToI32 (i64Sub 0 1)) 0 in
    let maxU = i64ToU64 (i64Sub 0 1) in
    if ptrToU64 p == maxU then ptrNull () else p

  sysMprotect :: RawPtr U8 -> Usize -> I32 ->{Global} I32
  sysMprotect addr size prot = cMprotect addr size prot

  sysMunmap :: RawPtr U8 -> Usize ->{Global} I32
  sysMunmap addr size = cMunmap addr size

  sysNoThreadWord :: U64
  sysNoThreadWord = 1

  prim sysThreadWordPrim :: I64 -> U64 where
    unsafe llvm {
      %w = call i64 asm "mrs $0, tpidrro_el0", "=r"()
      %m = and i64 %w, -8
      ret i64 %m
    } when arch aarch64 when os darwin
    unsafe llvm {
      %w = call i64 asm "mrs $0, tpidr_el0", "=r"()
      ret i64 %w
    } when arch aarch64 when os linux
    unsafe llvm {
      %w = call i64 asm "movq %fs:0, $0", "=r"()
      ret i64 %w
    } when arch x86_64 when os linux
    unsafe llvm {
      ret i64 1
    }

  sysThreadWord :: Unit -> U64
  sysThreadWord _ = sysThreadWordPrim 0

  prim sysSpinLoopPrim :: I64 ->{Global} Unit where
    unsafe llvm {
      call void asm sideeffect "yield", ""()
      ret void
    } when arch aarch64
    unsafe llvm {
      call void asm sideeffect "pause", ""()
      ret void
    } when arch x86_64
    unsafe llvm {
      ret void
    }

  sysSpinLoop :: Unit ->{Global} Unit
  sysSpinLoop _ = sysSpinLoopPrim 0

  sysAlignedAlloc :: Usize -> Usize -> Bool ->{Global} MaybeNull U8
  sysAlignedAlloc size align zeroed =
    let reqSize = if size == 0 then 1 else size in
    if usizeLe align 16 then
      if zeroed then cCalloc 1 reqSize else cMalloc reqSize
    else
      let effAlign = if usizeLt align 8 then 8 else align in
      withLocal (ptrNull () :: MaybeNull U8) (\slot ->
        let rc = cPosixMemalign (mutAsPtr slot) effAlign reqSize in
        if rc /= 0 then ptrNull ()
        else
          let p = loadPtr (mutAsPtr slot) 0 in
          if ptrIsNull p then ptrNull ()
          else
            let _ = if zeroed then memZero (maybeToRaw p) reqSize else () in
            p
      )

  sysSystemFree :: RawPtr U8 ->{Global} Unit
  sysSystemFree p = cFree (rawToMaybe p)

  sysSystemRealloc :: RawPtr U8 -> Usize -> Usize -> Usize ->{Global} MaybeNull U8
  sysSystemRealloc p oldSize align newSize =
    let reqSize = if newSize == 0 then 1 else newSize in
    if usizeLe align 16 then
      cRealloc (rawToMaybe p) reqSize
    else
      let next = sysAlignedAlloc reqSize align False in
      if ptrIsNull next then ptrNull ()
      else
        let copyLen = u64ToUsize (u64Min (usizeToU64 oldSize) (usizeToU64 reqSize)) in
        let _ = if copyLen /= 0 then memCopy (maybeToRaw next) p copyLen else () in
        let _ = cFree (rawToMaybe p) in
        next
