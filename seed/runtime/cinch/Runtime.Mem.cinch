  prim clzU64 :: U64 -> U64 where
    unsafe llvm { %r = call i64 @llvm.ctlz.i64(i64 %0, i1 false)
      ret i64 %r }

  prim ctzU64 :: U64 -> U64 where
    unsafe llvm { %r = call i64 @llvm.cttz.i64(i64 %0, i1 false)
      ret i64 %r }

  prim bswapU64 :: U64 -> U64 where
    unsafe llvm { %r = call i64 @llvm.bswap.i64(i64 %0)
      ret i64 %r }

  prim bswapU32 :: U32 -> U32 where
    unsafe llvm {
      %s = call i32 @llvm.bswap.i32(i32 %0)
      ret i32 %s
    }

  prim f64ToBits :: F64 -> U64 where
    unsafe llvm {
      %b = bitcast double %0 to i64
      ret i64 %b
    }

  prim bitsToF64 :: U64 -> F64 where
    unsafe llvm {
      %v = bitcast i64 %0 to double
      ret double %v
    }
