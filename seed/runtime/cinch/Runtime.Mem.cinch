  -- Pointer utilities
  prim ptrNullPrim :: forall a. I64 -> MaybeNull a where
    unsafe llvm {
      ret ptr null
    }

  ptrNull :: forall a. Unit -> MaybeNull a
  ptrNull _ = ptrNullPrim 0

  prim ptrIsNull :: forall a. MaybeNull a -> Bool where
    unsafe llvm {
      %c = icmp eq ptr %0, null
      %r = zext i1 %c to i8
      ret i8 %r
    }

  prim ptrFromU64 :: forall a. U64 -> MaybeNull a where
    unsafe llvm {
      %p = inttoptr i64 %0 to ptr
      ret ptr %p
    }

  prim ptrToU64 :: forall a. MaybeNull a -> U64 where
    unsafe llvm {
      %v = ptrtoint ptr %0 to i64
      ret i64 %v
    }

  prim rawToU64 :: forall a. RawPtr a -> U64 where
    unsafe llvm {
      %v = ptrtoint ptr %0 to i64
      ret i64 %v
    }

  prim rawToMaybe :: forall a. RawPtr a -> MaybeNull a where
    unsafe llvm {
      ret ptr %0
    }

  prim maybeToRaw :: forall a. MaybeNull a -> RawPtr a where
    unsafe llvm {
      ret ptr %0
    }

  prim ptrCast :: forall a b. RawPtr a -> RawPtr b where
    unsafe llvm {
      ret ptr %0
    }

  prim maybeCast :: forall a b. MaybeNull a -> MaybeNull b where
    unsafe llvm {
      ret ptr %0
    }

  prim ptrAdd :: forall a. RawPtr a -> Isize -> RawPtr a where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      ret ptr %p
    }

  prim ptrAddU64 :: forall a. RawPtr a -> U64 -> RawPtr a where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      ret ptr %p
    }

  prim ptrSubU64 :: forall a. RawPtr a -> U64 -> RawPtr a where
    unsafe llvm {
      %neg = sub i64 0, %1
      %p = getelementptr i8, ptr %0, i64 %neg
      ret ptr %p
    }

  -- Non-atomic typed loads and stores at byte offset
  prim loadU8 :: forall a. RawPtr a -> Isize ->{Global} U8 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = load i8, ptr %p, align 1
      ret i8 %v
    }

  prim storeU8 :: forall a. RawPtr a -> Isize -> U8 ->{Global} Unit where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      store i8 %2, ptr %p, align 1
      ret void
    }

  prim loadU16 :: forall a. RawPtr a -> Isize ->{Global} U16 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = load i16, ptr %p, align 2
      ret i16 %v
    }

  prim storeU16 :: forall a. RawPtr a -> Isize -> U16 ->{Global} Unit where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      store i16 %2, ptr %p, align 2
      ret void
    }

  prim loadU32 :: forall a. RawPtr a -> Isize ->{Global} U32 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = load i32, ptr %p, align 4
      ret i32 %v
    }

  prim storeU32 :: forall a. RawPtr a -> Isize -> U32 ->{Global} Unit where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
