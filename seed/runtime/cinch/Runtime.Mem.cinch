  -- Full-ordering I64 atomics (0=Relaxed, 1=Acquire, 2=Release, 3=AcqRel, 4=SeqCst)
  prim atomicSwapI64Relaxed :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw xchg ptr %p, i64 %2 monotonic, align 8
      ret i64 %v }
  prim atomicSwapI64Acquire :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw xchg ptr %p, i64 %2 acquire, align 8
      ret i64 %v }
  prim atomicSwapI64Release :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw xchg ptr %p, i64 %2 release, align 8
      ret i64 %v }
  prim atomicSwapI64AcqRel :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw xchg ptr %p, i64 %2 acq_rel, align 8
      ret i64 %v }

  atomicSwapI64Ord :: forall a. RawPtr a -> Isize -> I64 -> I64 ->{Global} I64
  atomicSwapI64Ord p off v ord =
    if ord == 0 then atomicSwapI64Relaxed p off v
    else if ord == 1 then atomicSwapI64Acquire p off v
    else if ord == 2 then atomicSwapI64Release p off v
    else if ord == 3 then atomicSwapI64AcqRel p off v
    else atomicSwapI64SeqCst p off v

  prim atomicAddI64Relaxed :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw add ptr %p, i64 %2 monotonic, align 8
      ret i64 %v }
  prim atomicAddI64Acquire :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw add ptr %p, i64 %2 acquire, align 8
      ret i64 %v }
  prim atomicAddI64Release :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw add ptr %p, i64 %2 release, align 8
      ret i64 %v }
  prim atomicAddI64SeqCst :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw add ptr %p, i64 %2 seq_cst, align 8
      ret i64 %v }

  atomicAddI64Ord :: forall a. RawPtr a -> Isize -> I64 -> I64 ->{Global} I64
  atomicAddI64Ord p off v ord =
    if ord == 0 then atomicAddI64Relaxed p off v
    else if ord == 1 then atomicAddI64Acquire p off v
    else if ord == 2 then atomicAddI64Release p off v
    else if ord == 3 then atomicAddI64AcqRel p off v
    else atomicAddI64SeqCst p off v

