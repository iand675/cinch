  atomicXorI64Ord :: forall a. RawPtr a -> Isize -> I64 -> I64 ->{Global} I64
  atomicXorI64Ord p off v ord =
    if ord == 0 then atomicXorI64Relaxed p off v
    else if ord == 1 then atomicXorI64Acquire p off v
    else if ord == 2 then atomicXorI64Release p off v
    else if ord == 3 then atomicXorI64AcqRel p off v
    else atomicXorI64SeqCst p off v

  prim atomicCasI64Monotonic :: forall a. RawPtr a -> Isize -> I64 -> I64 ->{Global} Bool where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %res = cmpxchg ptr %p, i64 %2, i64 %3 monotonic monotonic, align 8
      %ok = extractvalue { i64, i1 } %res, 1
      %r = zext i1 %ok to i8
      ret i8 %r }
  prim atomicCasI64Acquire :: forall a. RawPtr a -> Isize -> I64 -> I64 ->{Global} Bool where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %res = cmpxchg ptr %p, i64 %2, i64 %3 acquire acquire, align 8
      %ok = extractvalue { i64, i1 } %res, 1
      %r = zext i1 %ok to i8
      ret i8 %r }
  prim atomicCasI64Release :: forall a. RawPtr a -> Isize -> I64 -> I64 ->{Global} Bool where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %res = cmpxchg ptr %p, i64 %2, i64 %3 release monotonic, align 8
      %ok = extractvalue { i64, i1 } %res, 1
      %r = zext i1 %ok to i8
      ret i8 %r }
  prim atomicCasI64SeqCst :: forall a. RawPtr a -> Isize -> I64 -> I64 ->{Global} Bool where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %res = cmpxchg ptr %p, i64 %2, i64 %3 seq_cst seq_cst, align 8
      %ok = extractvalue { i64, i1 } %res, 1
      %r = zext i1 %ok to i8
      ret i8 %r }

  atomicCasI64Ord :: forall a. RawPtr a -> Isize -> I64 -> I64 -> I64 -> I64 ->{Global} Bool
  atomicCasI64Ord p off expected desired succOrd failOrd =
    if succOrd == 4 || failOrd == 4 then atomicCasI64SeqCst p off expected desired
    else if succOrd == 3 then atomicCasI64Bool p off expected desired
    else if succOrd == 2 then
      if failOrd == 0 then atomicCasI64Release p off expected desired
      else atomicCasI64Bool p off expected desired
    else if succOrd == 1 || failOrd == 1 then atomicCasI64Acquire p off expected desired
    else atomicCasI64Monotonic p off expected desired
