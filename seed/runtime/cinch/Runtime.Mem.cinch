      %v = atomicrmw or ptr %p, i64 %2 release, align 8
      ret i64 %v }
  prim atomicOrI64AcqRel :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw or ptr %p, i64 %2 acq_rel, align 8
      ret i64 %v }
  prim atomicOrI64SeqCst :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw or ptr %p, i64 %2 seq_cst, align 8
      ret i64 %v }

  atomicOrI64Ord :: forall a. RawPtr a -> Isize -> I64 -> I64 ->{Global} I64
  atomicOrI64Ord p off v ord =
    if ord == 0 then atomicOrI64Relaxed p off v
    else if ord == 1 then atomicOrI64Acquire p off v
    else if ord == 2 then atomicOrI64Release p off v
    else if ord == 3 then atomicOrI64AcqRel p off v
    else atomicOrI64SeqCst p off v

