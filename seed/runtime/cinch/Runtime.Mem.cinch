  prim atomicAndI64Relaxed :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw and ptr %p, i64 %2 monotonic, align 8
      ret i64 %v }
  prim atomicAndI64Acquire :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw and ptr %p, i64 %2 acquire, align 8
      ret i64 %v }
  prim atomicAndI64Release :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw and ptr %p, i64 %2 release, align 8
      ret i64 %v }
  prim atomicAndI64AcqRel :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw and ptr %p, i64 %2 acq_rel, align 8
      ret i64 %v }
  prim atomicAndI64SeqCst :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw and ptr %p, i64 %2 seq_cst, align 8
      ret i64 %v }

  atomicAndI64Ord :: forall a. RawPtr a -> Isize -> I64 -> I64 ->{Global} I64
  atomicAndI64Ord p off v ord =
    if ord == 0 then atomicAndI64Relaxed p off v
    else if ord == 1 then atomicAndI64Acquire p off v
    else if ord == 2 then atomicAndI64Release p off v
    else if ord == 3 then atomicAndI64AcqRel p off v
    else atomicAndI64SeqCst p off v

  prim atomicOrI64Relaxed :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw or ptr %p, i64 %2 monotonic, align 8
      ret i64 %v }
  prim atomicOrI64Acquire :: forall a. RawPtr a -> Isize -> I64 ->{Global} I64 where
    unsafe llvm { %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw or ptr %p, i64 %2 acquire, align 8
