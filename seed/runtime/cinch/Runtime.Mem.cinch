    }

  prim loadU64 :: forall a. RawPtr a -> Isize ->{Global} U64 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = load i64, ptr %p, align 8
      ret i64 %v
    }

  prim storeU64 :: forall a. RawPtr a -> Isize -> U64 ->{Global} Unit where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      store i64 %2, ptr %p, align 8
      ret void
    }

  prim loadI64 :: forall a. RawPtr a -> Isize ->{Global} I64 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = load i64, ptr %p, align 8
      ret i64 %v
    }

  prim storeI64 :: forall a. RawPtr a -> Isize -> I64 ->{Global} Unit where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      store i64 %2, ptr %p, align 8
      ret void
    }

  prim loadF64 :: forall a. RawPtr a -> Isize ->{Global} F64 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = load double, ptr %p, align 8
      ret double %v
    }

  prim storeF64 :: forall a. RawPtr a -> Isize -> F64 ->{Global} Unit where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
