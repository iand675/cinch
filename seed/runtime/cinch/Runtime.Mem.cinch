  atomicSubI64Ord :: forall a. RawPtr a -> Isize -> I64 -> I64 ->{Global} I64
  atomicSubI64Ord p off v ord =
    if ord == 0 then atomicSubI64Relaxed p off v
    else if ord == 1 then atomicSubI64Acquire p off v
    else if ord == 2 then atomicSubI64Release p off v
    else if ord == 3 then atomicSubI64AcqRel p off v
