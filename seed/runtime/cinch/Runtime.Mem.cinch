  prim atomicSwapU64AcqRel :: forall a. RawPtr a -> Isize -> U64 ->{Global} U64 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw xchg ptr %p, i64 %2 acq_rel, align 8
      ret i64 %v
    }

  prim atomicSwapU64SeqCst :: forall a. RawPtr a -> Isize -> U64 ->{Global} U64 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw xchg ptr %p, i64 %2 seq_cst, align 8
      ret i64 %v
    }

  prim atomicCasU64Bool :: forall a. RawPtr a -> Isize -> U64 -> U64 ->{Global} Bool where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %res = cmpxchg ptr %p, i64 %2, i64 %3 acq_rel acquire, align 8
      %ok = extractvalue { i64, i1 } %res, 1
      %z = zext i1 %ok to i8
      ret i8 %z
    }

  prim atomicCasU64Val :: forall a. RawPtr a -> Isize -> U64 -> U64 ->{Global} U64 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %res = cmpxchg ptr %p, i64 %2, i64 %3 seq_cst seq_cst, align 8
      %old = extractvalue { i64, i1 } %res, 0
      ret i64 %old
    }

