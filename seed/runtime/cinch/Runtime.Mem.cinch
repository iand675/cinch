    }

  prim loadPtr :: forall a b. RawPtr a -> Isize ->{Global} MaybeNull b where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = load ptr, ptr %p, align 8
      ret ptr %v
    }

  prim storePtr :: forall a b. RawPtr a -> Isize -> MaybeNull b ->{Global} Unit where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      store ptr %2, ptr %p, align 8
      ret void
    }

