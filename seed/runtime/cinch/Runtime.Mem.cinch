module Runtime.Mem where
  export ptrNull, ptrIsNull, ptrFromU64, ptrToU64, rawToU64, rawToMaybe, maybeToRaw
  export ptrCast, maybeCast, ptrAdd, ptrAddU64, ptrSubU64
  export loadU8, storeU8, loadU16, storeU16, loadU32, storeU32, loadI32, storeI32
  export loadU64, storeU64, loadI64, storeI64, loadF64, storeF64, loadPtr, storePtr
  export atomicLoadU64Relaxed, atomicLoadU64Acquire, atomicLoadU64SeqCst
  export atomicStoreU64Relaxed, atomicStoreU64Release, atomicStoreU64SeqCst
  export atomicAddU64Relaxed, atomicAddU64AcqRel, atomicAddU64SeqCst
  export atomicSubU64Relaxed, atomicSubU64AcqRel, atomicSubU64SeqCst
  export atomicAddU64Release, atomicMaxU64Relaxed
  export atomicAndU64AcqRel, atomicOrU64AcqRel, atomicXorU64AcqRel
  export atomicSwapU64AcqRel, atomicSwapU64SeqCst
