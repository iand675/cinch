      %p = getelementptr i8, ptr %0, i64 %1
      %res = cmpxchg ptr %p, ptr %2, ptr %3 release monotonic, align 8
      %ok = extractvalue { ptr, i1 } %res, 1
      %z = zext i1 %ok to i8
      ret i8 %z
