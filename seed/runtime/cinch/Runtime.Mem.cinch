  prim atomicSubU64SeqCst :: forall a. RawPtr a -> Isize -> U64 ->{Global} U64 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw sub ptr %p, i64 %2 seq_cst, align 8
