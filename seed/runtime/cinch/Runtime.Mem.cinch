  -- Atomic Ptr operations
  prim atomicLoadPtrRelaxed :: forall a b. RawPtr a -> Isize ->{Global} MaybeNull b where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = load atomic ptr, ptr %p monotonic, align 8
      ret ptr %v
    }

  prim atomicLoadPtrAcquire :: forall a b. RawPtr a -> Isize ->{Global} MaybeNull b where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = load atomic ptr, ptr %p acquire, align 8
      ret ptr %v
    }

  prim atomicStorePtrRelaxed :: forall a b. RawPtr a -> Isize -> MaybeNull b ->{Global} Unit where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      store atomic ptr %2, ptr %p monotonic, align 8
      ret void
    }

  prim atomicStorePtrRelease :: forall a b. RawPtr a -> Isize -> MaybeNull b ->{Global} Unit where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      store atomic ptr %2, ptr %p release, align 8
      ret void
    }

  prim atomicSwapPtrAcquire :: forall a b. RawPtr a -> Isize -> MaybeNull b ->{Global} MaybeNull b where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw xchg ptr %p, ptr %2 acquire, align 8
      ret ptr %v
    }

  prim atomicSwapPtrAcqRel :: forall a b. RawPtr a -> Isize -> MaybeNull b ->{Global} MaybeNull b where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw xchg ptr %p, ptr %2 acq_rel, align 8
      ret ptr %v
    }

  prim atomicCasPtrBool :: forall a b. RawPtr a -> Isize -> MaybeNull b -> MaybeNull b ->{Global} Bool where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %res = cmpxchg ptr %p, ptr %2, ptr %3 acq_rel acquire, align 8
      %ok = extractvalue { ptr, i1 } %res, 1
      %z = zext i1 %ok to i8
      ret i8 %z
    }

  prim atomicCasPtrRelease :: forall a b. RawPtr a -> Isize -> MaybeNull b -> MaybeNull b ->{Global} Bool where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %res = cmpxchg ptr %p, ptr %2, ptr %3 release monotonic, align 8
      %ok = extractvalue { ptr, i1 } %res, 1
      %z = zext i1 %ok to i8
      ret i8 %z
    }

  u64BitNot :: U64 -> U64
  u64BitNot x = bitXorU64 x (i64ToU64 (i64Sub 0 1))

  u64Min :: U64 -> U64 -> U64
  u64Min a b = if u64Lt a b then a else b

  u64Max :: U64 -> U64 -> U64
  u64Max a b = if u64Gt a b then a else b

  u64SatSub :: U64 -> U64 -> U64
  u64SatSub a b = if u64Lt a b then 0 else u64Sub a b

  u64SatAdd :: U64 -> U64 -> U64
  u64SatAdd a b =
    let s = u64Add a b in
    if u64Lt s a then i64ToU64 (i64Sub 0 1) else s

  u64SatMul :: U64 -> U64 -> U64
  u64SatMul a b =
    if a == 0 then 0
    else
      let maxU = i64ToU64 (i64Sub 0 1) in
      if u64Gt b (u64Div maxU a) then maxU else u64Mul a b

  -- Fences
  prim fenceAcquirePrim :: I64 ->{Global} Unit where
    unsafe llvm {
      fence acquire
      ret void
    }

  fenceAcquire :: Unit ->{Global} Unit
  fenceAcquire _ = fenceAcquirePrim 0

  prim fenceReleasePrim :: I64 ->{Global} Unit where
    unsafe llvm {
      fence release
      ret void
    }

  fenceRelease :: Unit ->{Global} Unit
  fenceRelease _ = fenceReleasePrim 0

  prim fenceAcqRelPrim :: I64 ->{Global} Unit where
    unsafe llvm {
      fence acq_rel
      ret void
    }

  fenceAcqRel :: Unit ->{Global} Unit
  fenceAcqRel _ = fenceAcqRelPrim 0

  prim fenceSeqCstPrim :: I64 ->{Global} Unit where
    unsafe llvm {
      fence seq_cst
      ret void
    }

  fenceSeqCst :: Unit ->{Global} Unit
  fenceSeqCst _ = fenceSeqCstPrim 0

  -- Bulk memory intrinsics
  prim memCopy :: RawPtr U8 -> RawPtr U8 -> Usize ->{Global} Unit where
    unsafe llvm {
      call void @llvm.memcpy.p0.p0.i64(ptr %0, ptr %1, i64 %2, i1 false)
      ret void
    }

  foreign import ccall "memmove" cMemmovePrim :: RawPtr U8 -> RawPtr U8 -> Usize ->{Global} RawPtr U8

  memMove :: RawPtr U8 -> RawPtr U8 -> Usize ->{Global} Unit
  memMove dst src len =
    let _ = cMemmovePrim dst src len in ()

  prim memSet :: RawPtr U8 -> U8 -> Usize ->{Global} Unit where
    unsafe llvm {
      call void @llvm.memset.p0.i64(ptr %0, i8 %1, i64 %2, i1 false)
      ret void
    }

  memZero :: RawPtr U8 -> Usize ->{Global} Unit
  memZero p n = memSet p 0 n

  -- Unboxed integer/float conversions and machine arithmetic
  prim u64ToI64 :: U64 -> I64 where
    unsafe llvm { ret i64 %0 }

  prim i64ToU64 :: I64 -> U64 where
    unsafe llvm { ret i64 %0 }

  prim u64ToUsize :: U64 -> Usize where
    unsafe llvm { ret i64 %0 }

