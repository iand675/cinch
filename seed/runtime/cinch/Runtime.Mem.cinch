  export atomicSwapPtrAcquire, atomicSwapPtrAcqRel, atomicCasPtrBool, atomicCasPtrRelease
  export u64BitNot, u64Min, u64Max, u64SatSub, u64SatAdd, u64SatMul
  export fenceAcquire, fenceRelease, fenceAcqRel, fenceSeqCst
