  prim atomicAddU64Relaxed :: forall a. RawPtr a -> Isize -> U64 ->{Global} U64 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw add ptr %p, i64 %2 monotonic, align 8
      ret i64 %v
    }

  prim atomicAddU64AcqRel :: forall a. RawPtr a -> Isize -> U64 ->{Global} U64 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw add ptr %p, i64 %2 acq_rel, align 8
      ret i64 %v
    }

  prim atomicAddU64SeqCst :: forall a. RawPtr a -> Isize -> U64 ->{Global} U64 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw add ptr %p, i64 %2 seq_cst, align 8
      ret i64 %v
    }

  prim atomicSubU64Relaxed :: forall a. RawPtr a -> Isize -> U64 ->{Global} U64 where
    unsafe llvm {
      %p = getelementptr i8, ptr %0, i64 %1
      %v = atomicrmw sub ptr %p, i64 %2 monotonic, align 8
