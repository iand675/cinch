  foreign export ccall "cinch_array_get" cinchArrayGet :: I64 -> I64 ->{Global} I64
  foreign export ccall "cinch_array_slice" cinchArraySlice :: I64 -> I64 -> I64 ->{Global, ThreadAffine} I64
