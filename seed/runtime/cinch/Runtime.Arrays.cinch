  foreign export ccall "cinch_columnar_column" cinchColumnarColumn :: I64 ->{Global, ThreadAffine} I64
  foreign export ccall "cinch_columnar_rows" cinchColumnarRows :: I64 ->{Global} I64
  foreign export ccall "cinch_columnar_columns" cinchColumnarColumns :: I64 ->{Global} I64
