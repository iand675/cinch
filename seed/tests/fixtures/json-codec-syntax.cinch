  check-batch3 :: Unit -> Nat
  check-batch3 unit = first-failure [
      (valid-case (runtime-bytes (string-to-bytes " true \r\n")) (string-to-bytes "true")),
      (compact-case (runtime-bytes (string-to-bytes " true \r\n")) (string-to-bytes "true") True 0 ""),
      (same-bytes (json-html-escape (runtime-bytes (string-to-bytes " true \r\n"))) (string-to-bytes " true \r\n")),
      (indent-case (runtime-bytes (string-to-bytes " true \r\n")) "" "  " (string-to-bytes "true \r\n") True 0 ""),
      (indent-case (runtime-bytes (string-to-bytes " true \r\n")) "P:" "\t" (string-to-bytes "true \r\n") True 0 ""),
      (indent-case (runtime-bytes (string-to-bytes " true \r\n")) "" "" (string-to-bytes "true \r\n") True 0 "")] 19

