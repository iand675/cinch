      (indent-case (runtime-bytes (string-to-bytes "{\"a\":1,\"a\":2}")) "" "" (string-to-bytes "{\n\"a\": 1,\n\"a\": 2\n}") True 0 "")] 79

  -- | Evaluate bounded independent syntax checks with global failure indexes.
  check-batch14 :: Unit -> Nat
  check-batch14 unit = first-failure [
      (valid-case (runtime-bytes (string-to-bytes "{\"x\":[true,null,{\"é\":\"漢😀\"}]}")) (string-to-bytes "{\"x\":[true,null,{\"é\":\"漢😀\"}]}")),
      (compact-case (runtime-bytes (string-to-bytes "{\"x\":[true,null,{\"é\":\"漢😀\"}]}")) (string-to-bytes "{\"x\":[true,null,{\"é\":\"漢😀\"}]}") True 0 ""),
      (same-bytes (json-html-escape (runtime-bytes (string-to-bytes "{\"x\":[true,null,{\"é\":\"漢😀\"}]}"))) (string-to-bytes "{\"x\":[true,null,{\"é\":\"漢😀\"}]}")),
      (indent-case (runtime-bytes (string-to-bytes "{\"x\":[true,null,{\"é\":\"漢😀\"}]}")) "" "  " (string-to-bytes "{\n  \"x\": [\n    true,\n    null,\n    {\n      \"é\": \"漢😀\"\n    }\n  ]\n}") True 0 ""),
      (indent-case (runtime-bytes (string-to-bytes "{\"x\":[true,null,{\"é\":\"漢😀\"}]}")) "P:" "\t" (string-to-bytes "{\nP:\t\"x\": [\nP:\t\ttrue,\nP:\t\tnull,\nP:\t\t{\nP:\t\t\t\"é\": \"漢😀\"\nP:\t\t}\nP:\t]\nP:}") True 0 ""),
      (indent-case (runtime-bytes (string-to-bytes "{\"x\":[true,null,{\"é\":\"漢😀\"}]}")) "" "" (string-to-bytes "{\n\"x\": [\ntrue,\nnull,\n{\n\"é\": \"漢😀\"\n}\n]\n}") True 0 "")] 85

