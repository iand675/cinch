  -- | Select complete normal coverage or one bounded poisoned-memory fixture group.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in case process-args () of
    Err error -> 2
    Ok args -> case args of
      Nil -> if all-groups 0 then 0 else 1
      Cons name Nil -> let index = decimal (unpack name) 0 in
        if index < 189 then let raw = wrapping-i64-to-u32 (nat-to-i64 index) in if run-group raw then 0 else 1 else 2
      other -> 2
