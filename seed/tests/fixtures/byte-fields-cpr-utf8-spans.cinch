  -- | Parse only decimal group metadata through existing ASCII digit observations.
  decimal :: List Char -> Nat -> Nat
  decimal input value = case input of Nil -> value; Cons cp rest -> case digit-value cp of None -> 0; Some digit -> decimal rest (value * 10 + digit)

