  -- | Read one immutable span-offsets entry; an out-of-range index returns zero.
  unicode-data-span-offsets :: U32 -> U32
  unicode-data-span-offsets index = if lt-u32 index 189 then
    let page = wrapping-shr-u32 index 6 in
    unicode-data-span-offsets-route page index
    else 0

  -- | Route a bounded span-offsets index without constructing a runtime table.
  unicode-data-span-offsets-route :: U32 -> U32 -> U32
  unicode-data-span-offsets-route page index =
    if lt-u32 page 1 then
      let local = wrapping-sub-u32 index 0 in
      unicode-data-span-offsets-page-a local
    else
      if lt-u32 page 2 then
        let local = wrapping-sub-u32 index 64 in
        unicode-data-span-offsets-page-b local
      else
        let local = wrapping-sub-u32 index 128 in
        unicode-data-span-offsets-page-c local

