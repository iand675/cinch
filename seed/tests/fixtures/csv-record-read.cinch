  -- | Print a failing fixture index and return a nonzero exit status for failed observations.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in
    let result = first-result [check-batch0 (),check-batch1 (),check-batch2 (),check-batch3 (),check-batch4 (),check-batch5 (),check-batch6 (),check-batch7 (),check-batch8 (),check-batch9 (),check-batch10 (),check-batch11 (),check-batch12 (),check-batch13 (),check-batch14 (),check-batch15 (),check-batch16 (),check-batch17 (),check-batch18 (),check-batch19 (),check-batch20 ()] in
    let printed = ioWrite (string-to-bytes (string-concat (nat-to-string result) "\n")) in
    if result == 0 then 0 else 1
