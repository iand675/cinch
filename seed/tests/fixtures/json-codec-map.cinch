-- | Independent JSON value and formatting consumer with runtime inputs and complete byte comparisons.
module Main where
  import Text.Json.Value
  import Text.Json.Codec
  import Data.Array
  import Data.Unicode.Kernel
  import Data.Machine
  -- | Keep input preparation live through front-end evaluation.
  prim runtime-size :: U32 -> U32 where
    llvm {
      %value = or i32 %0, 0
      ret i32 %value
    }
  -- | Observe a finite float's complete IEEE bit pattern without decimal rendering.
  prim float-bits :: F64 -> U64 where
    llvm {
      %value = bitcast double %0 to i64
      ret i64 %value
    }
  -- | Snapshot fixture bytes through a runtime-sized destination.
  runtime-bytes :: Bytes -> Bytes
  runtime-bytes input =
    let size = u32-to-nat (runtime-size (wrapping-i64-to-u32 (nat-to-i64 (bytes-len input)))) in
    let out = bytes-new size in
    if bytes-len input <= bytes-len out then let copied = bytes-copy-range out input 0 0 (bytes-len input) in out else bytes-new 0
  -- | Compare complete bytes, including embedded NUL and malformed UTF-8.
  same-bytes :: Bytes -> Bytes -> Bool
  same-bytes left right = eq-i64 (bytes-compare left right) 0
  -- | Compare syntax failures using original offsets and neutral JSON diagnostic text.
  syntax-error :: JsonError -> Nat -> String -> Bool
  syntax-error actual offset message = case actual of JsonSyntaxError at text -> at == offset && text == message; other -> False
  -- | Check validation and exact retained raw source for a complete valid document.
  valid-case :: Bytes -> Bytes -> Bool
  valid-case input raw = json-valid input && (case json-document input of Err error -> False; Ok document -> same-bytes (json-value-source (json-document-value document)) raw && same-bytes (json-document-input document) input)
  -- | Check named syntax failure before a document or output can escape.
  invalid-case :: Bytes -> Nat -> String -> Bool
  invalid-case input offset message = not (json-valid input) && (case json-document input of Err error -> syntax-error error offset message; Ok document -> False)
  -- | Compare the entire compact output or its exact original syntax refusal.
  compact-case :: Bytes -> Bytes -> Bool -> Nat -> String -> Bool
  compact-case input expected valid offset message = case json-compact input of
    Ok out -> valid && same-bytes out expected
    Err error -> not valid && syntax-error error offset message
  -- | Compare indentation, including arbitrary line prefixes and preserved trailing whitespace.
  indent-case :: Bytes -> String -> String -> Bytes -> Bool -> Nat -> String -> Bool
  indent-case input prefix step expected valid offset message = case json-indent input prefix step of
    Ok out -> valid && same-bytes out expected
    Err error -> not valid && syntax-error error offset message
  -- | Compare raw-byte indentation fragments independently of scalar text validity.
  indent-byte-case :: Bytes -> Bytes -> Bytes -> Bytes -> Bool -> Nat -> String -> Bool
  indent-byte-case input prefix step expected valid offset message = case json-indent-bytes input prefix step of
    Ok out -> valid && same-bytes out expected
    Err error -> not valid && syntax-error error offset message
  -- | Compare quoted arbitrary bytes and their decoded replacement-scalar text.
  quote-case :: Bytes -> Bool -> Bytes -> Bytes -> Bool
  quote-case input html expected decoded =
    let out = json-quote-bytes input html in same-bytes out expected && (case json-document out of
      Err error -> False
      Ok document -> case json-value-string (json-document-value document) of None -> False; Some text -> same-bytes (string-to-bytes text) decoded)
  -- | Compare valid number spellings and integer/float conversions without a rounding-based oracle.
  number-case :: String -> Bool -> I64 -> Bool -> U64 -> Bool
  number-case text integer-ok integer float-ok bits = case json-number text of
    Err error -> False
    Ok number -> json-number-text number == text
      && (case json-number-int64 number of Ok actual -> integer-ok && eq-i64 actual integer; Err error -> not integer-ok)
      && (case json-number-float64 number of Ok actual -> float-ok && eq-u64 (float-bits actual) bits; Err error -> not float-ok)
  -- | Reject malformed number spellings at construction rather than admitting an invalid number value.
  number-invalid :: String -> Bool
  number-invalid text = case json-number text of Err error -> True; Ok value -> False
  -- | Preserve a failing fixture index within a bounded group.
  first-failure :: List Bool -> Nat -> Nat
  first-failure checks index = case checks of Nil -> 0; Cons first rest -> if first then first-failure rest (index + 1) else index
  -- | Preserve the first failing group without constructing one enormous evaluation body.
  first-result :: List Nat -> Nat
  first-result groups = case groups of Nil -> 0; Cons first rest -> if first > 0 then first else first-result rest

  -- | Application record used by independent field update/omission observations.
  data ApplicationRecord where
    -- | Identifier, display text, enabled flag, quoted integer and omitted-zero integer.
    App :: I64 -> String -> Bool -> I64 -> I64 -> ApplicationRecord
  -- | Read the application's identifier field.
  app-id :: ApplicationRecord -> I64
  app-id value = case value of App ident name enabled quoted zero -> ident
  -- | Functionally install an identifier while preserving unrelated fields.
  app-id-set :: I64 -> ApplicationRecord -> ApplicationRecord
  app-id-set next value = case value of App ident name enabled quoted zero -> App next name enabled quoted zero
  -- | Read the application's display name.
  app-name :: ApplicationRecord -> String
  app-name value = case value of App ident name enabled quoted zero -> name
  -- | Functionally install display text while preserving unrelated fields.
  app-name-set :: String -> ApplicationRecord -> ApplicationRecord
  app-name-set next value = case value of App ident name enabled quoted zero -> App ident next enabled quoted zero
  -- | Read the application's enabled flag.
  app-enabled :: ApplicationRecord -> Bool
  app-enabled value = case value of App ident name enabled quoted zero -> enabled
  -- | Functionally install the enabled flag while preserving unrelated fields.
  app-enabled-set :: Bool -> ApplicationRecord -> ApplicationRecord
  app-enabled-set next value = case value of App ident name enabled quoted zero -> App ident name next quoted zero
  -- | Read the quoted integer field.
  app-quoted :: ApplicationRecord -> I64
  app-quoted value = case value of App ident name enabled quoted zero -> quoted
  -- | Functionally install the quoted integer while preserving unrelated fields.
  app-quoted-set :: I64 -> ApplicationRecord -> ApplicationRecord
  app-quoted-set next value = case value of App ident name enabled quoted zero -> App ident name enabled next zero
  -- | Read the omitted-zero integer field.
  app-zero :: ApplicationRecord -> I64
  app-zero value = case value of App ident name enabled quoted zero -> zero
  -- | Functionally install the omitted-zero field while preserving unrelated fields.
  app-zero-set :: I64 -> ApplicationRecord -> ApplicationRecord
  app-zero-set next value = case value of App ident name enabled quoted zero -> App ident name enabled quoted next
  -- | Construct an independent application zero value.
  app-default :: Unit -> ApplicationRecord
  app-default unit = App 0 "" False 0 0
  -- | Classify the application's actual complete zero value.
  app-is-zero :: ApplicationRecord -> Bool
  app-is-zero value = case value of App ident name enabled quoted zero -> eq-i64 ident 0 && name == "" && not enabled && eq-i64 quoted 0 && eq-i64 zero 0
  -- | Describe explicit application fields with omission, naming and quoted-number metadata.
  app-type :: Unit -> JsonType ApplicationRecord
  app-type unit = json-record-type "ApplicationRecord" app-default app-is-zero [
    json-field-with "id" (json-field-options False False False 0 True JsonFieldDefaultMatch) json-int64-type app-id app-id-set,
    json-field-with "name" (json-field-options False False False 0 True JsonFieldDefaultMatch) json-string-type app-name app-name-set,
    json-field-with "enabled" (json-field-options True False False 0 True JsonFieldDefaultMatch) json-bool-type app-enabled app-enabled-set,
    json-field-with "quoted" (json-field-options False False True 0 True JsonFieldDefaultMatch) json-int64-type app-quoted app-quoted-set,
    json-field-with "zero" (json-field-options False True False 0 True JsonFieldDefaultMatch) json-int64-type app-zero app-zero-set]
  -- | Construct a known valid initial exact number through the public checked constructor.
  initial-number :: Unit -> JsonNumber
  initial-number unit = case json-number "7" of Ok value -> value; Err error -> json-empty-number
  -- | Inspect the semantic error family without conflating path context with an underlying cause.
  error-family :: JsonError -> String
  error-family error = case error of
    JsonSyntaxError at text -> "syntax"
    JsonTypeError expected actual at path -> "type"
    JsonTypeCause expected actual at path cause -> "type"
    JsonPathError path cause -> error-family cause
    JsonCustomError label cause -> "custom"
    JsonValueError label text -> "value"
    other -> "other"
  -- | Compare the complete remarshal of a partially updated value.
  typed-value-ok :: forall a. JsonType a -> a -> Bytes -> Bool
  typed-value-ok descriptor value expected = case json-marshal descriptor value of
    Ok output -> same-bytes output expected
    Err error -> False
  -- | Treat absent optional diagnostic metadata as the empty reference field.
  optional-text :: Option String -> String
  optional-text value = case value of None -> ""; Some text -> text
  -- | Compare the original structured error independently of conversion success.
  typed-error-ok :: Option JsonError -> String -> Nat -> String -> String -> String -> Bool
  typed-error-ok error family offset actual expected-type path = case error of
    None -> family == ""
    Some value -> error-family value == family && json-error-offset value == offset && optional-text (json-error-value value) == actual && optional-text (json-error-type value) == expected-type && json-error-path value == path
  -- | Compare complete partial-update state and original error metadata against an independent observation.
  typed-case :: forall a. JsonType a -> Bytes -> a -> Bytes -> String -> Nat -> String -> String -> String -> Bool
  typed-case descriptor input prior expected family offset actual expected-type path =
    let decoded = json-update descriptor (runtime-bytes input) prior in
    typed-value-ok descriptor (json-decoded-value decoded) expected && typed-error-ok (json-decoded-error decoded) family offset actual expected-type path

  -- | Inspect new map encoding failures while retaining ordinary typed error classifications.
  map-error-family :: JsonError -> String
  map-error-family error = case error of
    JsonInvalidValueError text -> "value"
    JsonUnsupportedType label -> "unsupported-type"
    JsonPathError path cause -> map-error-family cause
    other -> error-family error
  -- | Match complete output bytes or the original structured encoding refusal.
  map-output-ok :: forall a. JsonType a -> a -> Bytes -> String -> String -> Bool -> Bool
  map-output-ok descriptor value expected family label invalid = case json-marshal descriptor value of
    Ok output -> family == "" && same-bytes output expected
    Err error -> map-error-family error == family && optional-text (json-error-type error) == label && json-error-invalid-value error == invalid && (if invalid then (case json-error-type error of None -> True; Some label -> False) else True)
  -- | Compare independently observed map partial values, key errors and encoding outcomes.
  map-case :: forall a. JsonType a -> Bytes -> a -> Bytes -> String -> Nat -> String -> String -> String -> String -> String -> Bool -> Bool
  map-case descriptor input prior expected family offset actual label path encode-family encode-label invalid =
    let decoded = json-update descriptor (runtime-bytes input) prior in
    typed-error-ok (json-decoded-error decoded) family offset actual label path && map-output-ok descriptor (json-decoded-value decoded) expected encode-family encode-label invalid
  -- | Exercise a non-string JSON-valued key family without runtime reflection.
  bool-key :: JsonKey Bool
  bool-key = json-json-key json-bool-type (\left right -> if left == right then 0 else if left then 1 else -1)
  -- | Format one custom application's key using checked full-domain simple uppercase mappings.
  text-key-encode :: JsonWriteOptions -> String -> Result JsonError String
  text-key-encode options value = if value == "reject" then Err (JsonValueError "TextKey" "key rejected") else Ok (pack (map unicode-to-upper (unpack value)))
  -- | Decode custom text from the exact source-backed quoted key token.
  text-key-decode :: JsonReadOptions -> JsonMember -> Result JsonError String
  text-key-decode options member = case json-member-key member of
    None -> Err (JsonValueError "TextKey" "missing key token")
    Some source -> case json-value-string source of
      None -> Err (JsonValueError "TextKey" "key token is not a string")
      Some value -> let key = pack (map unicode-to-lower (unpack value)) in if key == "reject" then Err (JsonValueError "TextKey" "key rejected") else Ok key
  -- | Pair custom key conversion capabilities with exact application ordering.
  text-key :: JsonKey String
  text-key = json-key "TextKey" string-compare text-key-encode text-key-decode

  -- | Evaluate bounded independent map checks with global failure indexes.
  check-batch0 :: Unit -> Nat
  check-batch0 unit = first-failure [
      (map-case (json-map-type json-string-key json-int64-type) (string-to-bytes "null") (json-map-from-list json-string-key [("a",7),("old",8)]) (string-to-bytes "null") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-string-key json-int64-type) (string-to-bytes "{}") (json-map-from-list json-string-key [("a",7),("old",8)]) (string-to-bytes "{\"a\":7,\"old\":8}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-string-key json-int64-type) (string-to-bytes "{\"a\":1}") (json-map-from-list json-string-key [("a",7),("old",8)]) (string-to-bytes "{\"a\":1,\"old\":8}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-string-key json-int64-type) (string-to-bytes "{\"a\":1,\"a\":2}") (json-map-from-list json-string-key [("a",7),("old",8)]) (string-to-bytes "{\"a\":2,\"old\":8}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-string-key json-int64-type) (string-to-bytes "{\"a\":\"x\",\"b\":3}") (json-map-from-list json-string-key [("a",7),("old",8)]) (string-to-bytes "{\"a\":0,\"b\":3,\"old\":8}") "type" 8 "string" "I64" "a" "" "" False),
      (map-case (json-map-type json-string-key json-int64-type) (string-to-bytes "{\"a\":null}") (json-map-from-list json-string-key [("a",7),("old",8)]) (string-to-bytes "{\"a\":0,\"old\":8}") "" 0 "" "" "" "" "" False)] 1

  -- | Evaluate bounded independent map checks with global failure indexes.
  check-batch1 :: Unit -> Nat
  check-batch1 unit = first-failure [
      (map-case (json-map-type json-string-key json-int64-type) (string-to-bytes "[]") (json-map-from-list json-string-key [("a",7),("old",8)]) (string-to-bytes "{\"a\":7,\"old\":8}") "type" 1 "array" "JsonMap String I64" "" "" "" False),
      (map-case (json-map-type json-string-key json-int64-type) (string-to-bytes "true") (json-map-from-list json-string-key [("a",7),("old",8)]) (string-to-bytes "{\"a\":7,\"old\":8}") "type" 4 "boolean" "JsonMap String I64" "" "" "" False),
      (map-case (json-map-type json-string-key json-int64-type) (string-to-bytes "42") (json-map-from-list json-string-key [("a",7),("old",8)]) (string-to-bytes "{\"a\":7,\"old\":8}") "type" 2 "number" "JsonMap String I64" "" "" "" False),
      (map-case (json-map-type json-string-key json-int64-type) (string-to-bytes "\"x\"") (json-map-from-list json-string-key [("a",7),("old",8)]) (string-to-bytes "{\"a\":7,\"old\":8}") "type" 3 "string" "JsonMap String I64" "" "" "" False),
      (map-case (json-map-type json-string-key json-int64-type) (string-to-bytes "{\"é\":2,\"漢\":3,\"A\":4}") (json-map-from-list json-string-key [("a",7),("old",8)]) (string-to-bytes "{\"A\":4,\"a\":7,\"old\":8,\"é\":2,\"漢\":3}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-string-key json-int64-type) (string-to-bytes "{\"\\u0061\":2,\"a\":3}") (json-map-from-list json-string-key [("a",7),("old",8)]) (string-to-bytes "{\"a\":3,\"old\":8}") "" 0 "" "" "" "" "" False)] 7

  -- | Evaluate bounded independent map checks with global failure indexes.
  check-batch2 :: Unit -> Nat
  check-batch2 unit = first-failure [
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "null") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "null") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "null") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "null") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"7\":\"old\"}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"7\":\"old\"}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"1\":\"one\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"one\",\"7\":\"old\"}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"1\":\"one\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"one\",\"7\":\"old\"}") "" 0 "" "" "" "" "" False)] 13

  -- | Evaluate bounded independent map checks with global failure indexes.
  check-batch3 :: Unit -> Nat
  check-batch3 unit = first-failure [
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"01\":\"first\",\"+1\":\"second\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"second\",\"7\":\"old\"}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"01\":\"first\",\"+1\":\"second\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"first\",\"7\":\"old\"}") "type" 18 "number +1" "U64" "+1" "" "" False),
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"-0\":\"zero\",\"0\":\"later\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"0\":\"later\",\"1\":\"before\",\"7\":\"old\"}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"-0\":\"zero\",\"0\":\"later\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"0\":\"later\",\"1\":\"before\",\"7\":\"old\"}") "type" 5 "number -0" "U64" "-0" "" "" False),
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"9223372036854775807\":\"max\",\"-9223372036854775808\":\"min\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"-9223372036854775808\":\"min\",\"1\":\"before\",\"7\":\"old\",\"9223372036854775807\":\"max\"}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"9223372036854775807\":\"max\",\"-9223372036854775808\":\"min\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"7\":\"old\",\"9223372036854775807\":\"max\"}") "type" 51 "number -9223372036854775808" "U64" "-9223372036854775808" "" "" False)] 19

  -- | Evaluate bounded independent map checks with global failure indexes.
  check-batch4 :: Unit -> Nat
  check-batch4 unit = first-failure [
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"9223372036854775808\":\"bad\",\"2\":\"after\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "type" 22 "number 9223372036854775808" "I64" "9223372036854775808" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"9223372036854775808\":\"bad\",\"2\":\"after\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\",\"9223372036854775808\":\"bad\"}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"18446744073709551615\":\"max\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"7\":\"old\"}") "type" 23 "number 18446744073709551615" "I64" "18446744073709551615" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"18446744073709551615\":\"max\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"18446744073709551615\":\"max\",\"7\":\"old\"}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"18446744073709551616\":\"bad\",\"2\":\"after\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "type" 23 "number 18446744073709551616" "I64" "18446744073709551616" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"18446744073709551616\":\"bad\",\"2\":\"after\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "type" 23 "number 18446744073709551616" "U64" "18446744073709551616" "" "" False)] 25

  -- | Evaluate bounded independent map checks with global failure indexes.
  check-batch5 :: Unit -> Nat
  check-batch5 unit = first-failure [
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"-1\":\"negative\",\"2\":\"after\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"-1\":\"negative\",\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"-1\":\"negative\",\"2\":\"after\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "type" 5 "number -1" "U64" "-1" "" "" False),
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"bad\":\"bad\",\"2\":\"after\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "type" 6 "number bad" "I64" "bad" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"bad\":\"bad\",\"2\":\"after\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "type" 6 "number bad" "U64" "bad" "" "" False),
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\" 1\":\"bad\",\"2\":\"after\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "type" 5 "number  1" "I64" " 1" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\" 1\":\"bad\",\"2\":\"after\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "type" 5 "number  1" "U64" " 1" "" "" False)] 31

  -- | Evaluate bounded independent map checks with global failure indexes.
  check-batch6 :: Unit -> Nat
  check-batch6 unit = first-failure [
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"1_0\":\"bad\",\"2\":\"after\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "type" 6 "number 1_0" "I64" "1_0" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"1_0\":\"bad\",\"2\":\"after\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "type" 6 "number 1_0" "U64" "1_0" "" "" False),
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"1.0\":\"bad\",\"2\":\"after\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "type" 6 "number 1.0" "I64" "1.0" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"1.0\":\"bad\",\"2\":\"after\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"after\",\"7\":\"old\"}") "type" 6 "number 1.0" "U64" "1.0" "" "" False),
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"2\":null}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"\",\"7\":\"old\"}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"2\":null}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"\",\"7\":\"old\"}") "" 0 "" "" "" "" "" False)] 37

  -- | Evaluate bounded independent map checks with global failure indexes.
  check-batch7 :: Unit -> Nat
  check-batch7 unit = first-failure [
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "{\"2\":1,\"3\":\"after\"}") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"\",\"3\":\"after\",\"7\":\"old\"}") "type" 6 "number" "String" "2" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "{\"2\":1,\"3\":\"after\"}") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"2\":\"\",\"3\":\"after\",\"7\":\"old\"}") "type" 6 "number" "String" "2" "" "" False),
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "[]") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"7\":\"old\"}") "type" 1 "array" "JsonMap I64 String" "" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "[]") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"7\":\"old\"}") "type" 1 "array" "JsonMap U64 String" "" "" "" False),
      (map-case (json-map-type json-int64-key json-string-type) (string-to-bytes "true") (json-map-from-list json-int64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"7\":\"old\"}") "type" 4 "boolean" "JsonMap I64 String" "" "" "" False),
      (map-case (json-map-type json-uint64-key json-string-type) (string-to-bytes "true") (json-map-from-list json-uint64-key [(1,"before"),(7,"old")]) (string-to-bytes "{\"1\":\"before\",\"7\":\"old\"}") "type" 4 "boolean" "JsonMap U64 String" "" "" "" False)] 43

  -- | Evaluate bounded independent map checks with global failure indexes.
  check-batch8 :: Unit -> Nat
  check-batch8 unit = first-failure [
      (map-case (json-map-type bool-key json-int64-type) (string-to-bytes "null") (json-map-from-list bool-key [(True,7)]) (string-to-bytes "null") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type bool-key json-int64-type) (string-to-bytes "{}") (json-map-from-list bool-key [(True,7)]) (string-to-bytes "") "" 0 "" "" "" "value" "" True),
      (map-case (json-map-type bool-key json-int64-type) (string-to-bytes "{\"true\":1}") (json-map-from-list bool-key [(True,7)]) (string-to-bytes "") "type" 7 "string" "Bool" "true" "value" "" True),
      (map-case (json-map-type bool-key json-int64-type) (string-to-bytes "[]") (json-map-from-list bool-key [(True,7)]) (string-to-bytes "") "type" 1 "array" "JsonMap Bool I64" "" "value" "" True),
      (map-case (json-map-type bool-key json-int64-type) (string-to-bytes "true") (json-map-from-list bool-key [(True,7)]) (string-to-bytes "") "type" 4 "boolean" "JsonMap Bool I64" "" "value" "" True),
      (map-case (json-map-type text-key json-int64-type) (string-to-bytes "null") (json-map-from-list text-key [("before",7),("old",8)]) (string-to-bytes "null") "" 0 "" "" "" "" "" False)] 49

  -- | Evaluate bounded independent map checks with global failure indexes.
  check-batch9 :: Unit -> Nat
  check-batch9 unit = first-failure [
      (map-case (json-map-type text-key json-int64-type) (string-to-bytes "{}") (json-map-from-list text-key [("before",7),("old",8)]) (string-to-bytes "{\"BEFORE\":7,\"OLD\":8}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type text-key json-int64-type) (string-to-bytes "{\"WORD\":1}") (json-map-from-list text-key [("before",7),("old",8)]) (string-to-bytes "{\"BEFORE\":7,\"OLD\":8,\"WORD\":1}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type text-key json-int64-type) (string-to-bytes "{\"Word\":1,\"word\":2}") (json-map-from-list text-key [("before",7),("old",8)]) (string-to-bytes "{\"BEFORE\":7,\"OLD\":8,\"WORD\":2}") "" 0 "" "" "" "" "" False),
      (map-case (json-map-type text-key json-int64-type) (string-to-bytes "{\"word\":\"bad\",\"next\":3}") (json-map-from-list text-key [("before",7),("old",8)]) (string-to-bytes "{\"BEFORE\":7,\"NEXT\":3,\"OLD\":8,\"WORD\":0}") "type" 13 "string" "I64" "word" "" "" False),
      (map-case (json-map-type text-key json-int64-type) (string-to-bytes "{\"reject\":1,\"next\":3}") (json-map-from-list text-key [("before",7),("old",8)]) (string-to-bytes "{\"BEFORE\":7,\"NEXT\":3,\"OLD\":8}") "value" 0 "key rejected" "TextKey" "" "" "" False),
      (map-case (json-map-type text-key json-int64-type) (string-to-bytes "{\"\\u0057ORD\":4}") (json-map-from-list text-key [("before",7),("old",8)]) (string-to-bytes "{\"BEFORE\":7,\"OLD\":8,\"WORD\":4}") "" 0 "" "" "" "" "" False)] 55

  -- | Evaluate bounded independent map checks with global failure indexes.
  check-batch10 :: Unit -> Nat
  check-batch10 unit = first-failure [
      (map-case (json-map-type text-key json-int64-type) (string-to-bytes "[]") (json-map-from-list text-key [("before",7),("old",8)]) (string-to-bytes "{\"BEFORE\":7,\"OLD\":8}") "type" 1 "array" "JsonMap TextKey I64" "" "" "" False)] 61

  -- | Print the original failing observation and return a nonzero status on failure.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in
    let failed = first-result [check-batch0 (),check-batch1 (),check-batch2 (),check-batch3 (),check-batch4 (),check-batch5 (),check-batch6 (),check-batch7 (),check-batch8 (),check-batch9 (),check-batch10 ()] in
    let printed = ioWrite (string-to-bytes (string-concat (nat-to-string failed) "\n")) in
    if failed == 0 then 0 else 1
