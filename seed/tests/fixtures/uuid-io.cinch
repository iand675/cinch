-- | Exercise real entropy, real wall time and explicit serialized generator ownership.
module Main where
  import Data.Core
  import Data.Nat
  import Data.Bytes
  import Data.Uuid
  import Data.Ordering
  import Effect.Uuid
  import Effect.Clock

  -- | Observe only fixed RFC bits, without predicting the random payload.
  valid-bits :: Nat -> Uuid -> Bool
  valid-bits version value =
    let bytes = uuid-to-bytes value in
    if bytes-len bytes == 16 then nat-div (bytes-get bytes 6) 16 == version && nat-div (bytes-get bytes 8) 64 == 2 else False

  -- | Decode only the48-bit network-order millisecond field of a generated value.
  timestamp-from :: Bytes -> Nat -> Nat -> Nat
  timestamp-from bytes index total =
    if index < 6 && index < bytes-len bytes then timestamp-from bytes (index + 1) (total * 256 + bytes-get bytes index) else total

  -- | Preserve one real IO capability through entropy and locked clock transitions.
  exercise :: forall (r :: Region). using (io :: Io r) => Unit ->{IO r, MVar, Diverge} Int
  exercise unit = case uuid-new () of
    Err error -> 1
    Ok chosen -> case uuid-new-v4 () of
      Err error -> 2
      Ok random ->
        let generator = uuid-v7-generator () in
        let before = clock-wall-ns () in
        case uuid-new-v7 generator () of
          Err error -> 3
          Ok first -> case uuid-new-v7 generator () of
            Err error -> 4
            Ok second ->
              let after = clock-wall-ns () in
              let first-ms = timestamp-from (uuid-to-bytes first) 0 0 in
              let within-clock = first-ms >= nat-div before 1000000 && first-ms <= nat-div after 1000000 in
              let ordered = if nat-div after 1000000000 < nat-div before 1000000000 then True else case uuid-compare first second of LT -> True; other -> False in
              if valid-bits 4 chosen && valid-bits 4 random && valid-bits 7 first && valid-bits 7 second && within-clock && ordered then 0 else 5

  -- | Establish the actual IO capability; no generator, entropy or time operation is replaced by a test stub.
  main :: forall (r :: Region). Unit ->{IO r, MVar, Diverge} Int
  main unit = with (io = newIO ()) in exercise unit
