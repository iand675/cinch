  -- | Evaluate a bounded group of independent bytes fixtures with original failing indices.
  check-batch4 :: forall r. using (io :: Io r) => Unit ->{IO r} Nat
  check-batch4 unit = first-failure [
      (raw-read-equal (csv-byte-reader (config 44 0 CsvAnyFields False False) (runtime-bytes (bytes-from-list [97,44,34,98,128,34,120,10,110,44,114,10]))) [(ExpectBytes [(bytes-from-list [97])] [(1,1)] 8 "quote" 1 1 6 0 0),(ExpectBytes [(bytes-from-list [110]),(bytes-from-list [114])] [(2,1),(2,3)] 12 "" 0 0 0 0 0)]),
