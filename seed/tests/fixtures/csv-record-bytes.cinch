-- | Configurable CSV fixture consumer with runtime input and precise expected metadata.
module Main where
  import Text.Csv.Record
  import Effect.Csv
  import Effect.Stream
  import Data.Char
  import Data.Machine
  -- | Keep immutable fixture input in runtime execution rather than constant evaluation.
  prim runtime-size :: U32 -> U32 where
    llvm {
      %value = or i32 %0, 0
      ret i32 %value
    }
  -- | Rebuild fixture text through a runtime-sized copied byte interval.
  runtime-text :: String -> String
  runtime-text text =
    let input = string-to-bytes text in
    let n = u32-to-nat (runtime-size (wrapping-i64-to-u32 (nat-to-i64 (bytes-len input)))) in
    let out = bytes-new n in
    if bytes-len input <= bytes-len out then
      let copied = bytes-copy-range out input 0 0 (bytes-len input) in
      case string-from-bytes out of Some result -> result; None -> ""
    else ""
  -- | Obtain a validated scalar from compact fixture data.
  scalar :: Nat -> Char
  scalar code = case char-from-code code of Some value -> value; None -> ','
  -- | Build a checked fixture dialect without embedding representation constructors.
  config :: Nat -> Nat -> CsvFieldPolicy -> Bool -> Bool -> CsvOptions
  config delimiter comment policy lazy trim =
    case csv-options (scalar delimiter) (if comment == 0 then None else Some (scalar comment)) policy lazy trim of
      Ok selected -> selected
      Err error -> csv-default-options
  -- | Compare immutable field lists without requiring an orphan list equality instance.
  fields-equal :: List String -> List String -> Bool
  fields-equal left right = case left of
    Nil -> case right of Nil -> True; Cons first rest -> False
    Cons a more -> case right of Nil -> False; Cons b rest -> a == b && fields-equal more rest
  -- | Compare every expected field position through the safe public indexing API.
  positions-equal :: CsvRecord -> List (Nat, Nat) -> Nat -> Bool
  positions-equal row positions index = case positions of
    Nil -> case csv-record-field-position row index of None -> True; Some value -> False
    Cons first rest -> case first of
      (line, column) -> case csv-record-field-position row index of
        None -> False
        Some actual -> case actual of (actual-line, actual-column) -> actual-line == line && actual-column == column && positions-equal row rest (index + 1)
  -- | Complete expected read progress and structured error details.
  data Expected where
    -- | Fields, positions, input offset, error kind/location and expected/actual counts.
    Expect :: List String -> List (Nat, Nat) -> Nat -> String -> Nat -> Nat -> Nat -> Nat -> Nat -> Expected
  -- | Compare precise error locations while treating both quote failures as one external category.
  error-equal :: Option CsvRecordError -> String -> Nat -> Nat -> Nat -> Nat -> Nat -> Bool
  error-equal actual kind start line column expected count = case actual of
    None -> kind == ""
    Some failure -> csv-record-error-start-line failure == start && csv-record-error-line failure == line && csv-record-error-column failure == column
      && (case failure of
        CsvBareQuote a b c -> kind == "bare"
        CsvQuote a b c -> kind == "quote"
        CsvUnclosedQuote a b c -> kind == "quote"
        CsvFieldCount a b c required received -> kind == "fields" && required == expected && received == count
        CsvFieldEncoding a b c index -> False)
  -- | Compare every advanced read, including continuing after malformed physical records.
  read-equal :: CsvReader -> List Expected -> Bool
  read-equal reader expected = case expected of
    Nil -> case csv-reader-read reader of (CsvEnd, next) -> True; other -> False
    Cons first rest -> case first of
      Expect fields positions offset kind start line column required count -> case csv-reader-read reader of
        (CsvReadRecord row error, next) -> fields-equal (csv-record-fields row) fields
          && positions-equal row positions 0 && csv-reader-input-offset next == offset
          && error-equal error kind start line column required count && read-equal next rest
        other -> False
  -- | Give all writer fixtures runtime text as well as their static expected output.
  runtime-fields :: List String -> List String
  runtime-fields fields = case fields of Nil -> Nil; Cons first rest -> Cons (runtime-text first) (runtime-fields rest)
  -- | Identify the first failed fixture without obscuring later source positions.
  first-failure :: List Bool -> Nat -> Nat
  first-failure checks index = case checks of
    Nil -> 0
    Cons first rest -> if first then first-failure rest (index + 1) else index
  -- | Preserve a bounded group's original failing index without expanding all fixtures in one body.
  first-result :: List Nat -> Nat
  first-result groups = case groups of Nil -> 0; Cons first rest -> if first > 0 then first else first-result rest

  -- | Limit every successful source read while preserving its actual advanced continuation.
  chunked :: forall r. using (io :: Io r) => Nat -> ByteReader r -> ByteReader r
  chunked maximum source = stream-reader (\n -> case stream-read source (if maximum < n then maximum else n) of
    (result, next) -> (result, chunked maximum next))
  -- | Compare every streamed record, source offset and parse error against independent results.
  stream-read-equal :: forall r. using (io :: Io r) => CsvStreamReader r -> List Expected ->{IO r} Bool
  stream-read-equal reader expected = case expected of
    Nil -> case csv-stream-read reader of (Ok CsvEnd, next) -> True; other -> False
    Cons first rest -> case first of
      Expect fields positions offset kind start line column required count -> case csv-stream-read reader of
        (Ok (CsvReadRecord row error), next) -> fields-equal (csv-record-fields row) fields
          && positions-equal row positions 0 && csv-stream-input-offset next == offset
          && error-equal error kind start line column required count && stream-read-equal next rest
        other -> False
  -- | Observe the exact bytes emitted by synchronous record writing and completion.
  stream-write-equal :: forall r. using (io :: Io r) => CsvOptions -> Bool -> List String -> String ->{IO r} Bool
  stream-write-equal selected crlf fields expected = case csv-stream-write (csv-stream-writer selected crlf writer-buffer) fields of
    (Ok unit, next) -> case csv-stream-flush next of
      (Ok unit, final) -> case writer-bytes (csv-stream-writer-sink final) of
        None -> False
        Some bytes -> case string-from-bytes bytes of None -> False; Some actual -> actual == expected
      other -> False
    other -> False

  -- | Rebuild arbitrary fixture bytes through a runtime-sized independently owned interval.
  runtime-bytes :: Bytes -> Bytes
  runtime-bytes input =
    let n = u32-to-nat (runtime-size (wrapping-i64-to-u32 (nat-to-i64 (bytes-len input)))) in
    let out = bytes-new n in
    if bytes-len input <= bytes-len out then let copied = bytes-copy-range out input 0 0 (bytes-len input) in out else bytes-new 0
  -- | Compare byte fields without decoding invalid UTF-8 or treating NUL as a terminator.
  raw-fields-equal :: List Bytes -> List Bytes -> Bool
  raw-fields-equal left right = case left of
    Nil -> case right of Nil -> True; Cons first rest -> False
    Cons first rest -> case right of Nil -> False; Cons actual more -> eq-i64 (bytes-compare first actual) 0 && raw-fields-equal rest more
  -- | Keep arbitrary byte writer inputs in runtime execution as well as their reader counterparts.
  runtime-raw-fields :: List Bytes -> List Bytes
  runtime-raw-fields fields = case fields of Nil -> Nil; Cons first rest -> Cons (runtime-bytes first) (runtime-raw-fields rest)
  -- | Compare all safe raw field position observations, including the out-of-range boundary.
  raw-positions-equal :: CsvByteRecord -> List (Nat, Nat) -> Nat -> Bool
  raw-positions-equal row positions index = case positions of
    Nil -> case csv-byte-record-field-position row index of None -> True; Some value -> False
    Cons first rest -> case first of
      (line, column) -> case csv-byte-record-field-position row index of
        None -> False
        Some actual -> case actual of (actual-line, actual-column) -> actual-line == line && actual-column == column && raw-positions-equal row rest (index + 1)
  -- | Expected arbitrary-byte fields and structured source/error metadata.
  data RawExpected where
    -- | Field bytes, positions, offset, error kind/location and field-count mismatch details.
    ExpectBytes :: List Bytes -> List (Nat, Nat) -> Nat -> String -> Nat -> Nat -> Nat -> Nat -> Nat -> RawExpected
  -- | Compare each pure byte-reader step without converting its fields to text.
  raw-read-equal :: CsvByteReader -> List RawExpected -> Bool
  raw-read-equal reader expected = case expected of
    Nil -> case csv-byte-reader-read reader of (CsvByteEnd, next) -> True; other -> False
    Cons first rest -> case first of
      ExpectBytes fields positions offset kind start line column required count -> case csv-byte-reader-read reader of
        (CsvReadByteRecord row error, next) -> raw-fields-equal (csv-byte-record-fields row) fields
          && raw-positions-equal row positions 0 && csv-byte-reader-input-offset next == offset
          && error-equal error kind start line column required count && raw-read-equal next rest
        other -> False
  -- | Compare streamed arbitrary-byte fields and positions across source chunk boundaries.
  raw-stream-equal :: forall r. using (io :: Io r) => CsvByteStreamReader r -> List RawExpected ->{IO r} Bool
  raw-stream-equal reader expected = case expected of
    Nil -> case csv-byte-stream-read reader of (Ok CsvByteEnd, next) -> True; other -> False
    Cons first rest -> case first of
      ExpectBytes fields positions offset kind start line column required count -> case csv-byte-stream-read reader of
        (Ok (CsvReadByteRecord row error), next) -> raw-fields-equal (csv-byte-record-fields row) fields
          && raw-positions-equal row positions 0 && csv-byte-stream-input-offset next == offset
          && error-equal error kind start line column required count && raw-stream-equal next rest
        other -> False
  -- | Observe lossless byte writing through the same inspectable sink and completion protocol.
  raw-write-equal :: forall r. using (io :: Io r) => CsvOptions -> Bool -> List Bytes -> Bytes ->{IO r} Bool
  raw-write-equal selected crlf fields expected = case csv-byte-stream-write (csv-stream-writer selected crlf writer-buffer) fields of
    (Ok unit, next) -> case writer-bytes (csv-stream-writer-sink next) of
      None -> False
      Some actual -> eq-i64 (bytes-compare actual expected) 0
    other -> False

  -- | Evaluate a bounded group of independent bytes fixtures with original failing indices.
  check-batch0 :: forall r. using (io :: Io r) => Unit ->{IO r} Nat
  check-batch0 unit = first-failure [
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list []))) []),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list []))))) []),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 7 (reader-from-bytes (runtime-bytes (bytes-from-list []))))) []),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 4096 (reader-from-bytes (runtime-bytes (bytes-from-list []))))) []),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [255]))) [(ExpectBytes [(bytes-from-list [255])] [(1,1)] 1 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [255]))))) [(ExpectBytes [(bytes-from-list [255])] [(1,1)] 1 "" 0 0 0 0 0)]),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [97,44,255,10]))) [(ExpectBytes [(bytes-from-list [97]),(bytes-from-list [255])] [(1,1),(1,3)] 4 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [97,44,255,10]))))) [(ExpectBytes [(bytes-from-list [97]),(bytes-from-list [255])] [(1,1),(1,3)] 4 "" 0 0 0 0 0)]),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [255,44,34,120,34,10]))) [(ExpectBytes [(bytes-from-list [255]),(bytes-from-list [120])] [(1,1),(1,3)] 6 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [255,44,34,120,34,10]))))) [(ExpectBytes [(bytes-from-list [255]),(bytes-from-list [120])] [(1,1),(1,3)] 6 "" 0 0 0 0 0)]),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [34,255,254,13,10,120,34,44,121,10]))) [(ExpectBytes [(bytes-from-list [255,254,10,120]),(bytes-from-list [121])] [(1,1),(2,4)] 10 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [34,255,254,13,10,120,34,44,121,10]))))) [(ExpectBytes [(bytes-from-list [255,254,10,120]),(bytes-from-list [121])] [(1,1),(2,4)] 10 "" 0 0 0 0 0)])] 1

  -- | Evaluate a bounded group of independent bytes fixtures with original failing indices.
  check-batch1 :: forall r. using (io :: Io r) => Unit ->{IO r} Nat
  check-batch1 unit = first-failure [
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [97,44,34,98,128,34,120,10,110,44,114,10]))) [(ExpectBytes [(bytes-from-list [97])] [(1,1)] 8 "quote" 1 1 6 0 0),(ExpectBytes [(bytes-from-list [110]),(bytes-from-list [114])] [(2,1),(2,3)] 12 "fields" 2 2 1 1 2)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [97,44,34,98,128,34,120,10,110,44,114,10]))))) [(ExpectBytes [(bytes-from-list [97])] [(1,1)] 8 "quote" 1 1 6 0 0),(ExpectBytes [(bytes-from-list [110]),(bytes-from-list [114])] [(2,1),(2,3)] 12 "fields" 2 2 1 1 2)]),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [227,128,128,97,44,128,10]))) [(ExpectBytes [(bytes-from-list [227,128,128,97]),(bytes-from-list [128])] [(1,1),(1,6)] 7 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [227,128,128,97,44,128,10]))))) [(ExpectBytes [(bytes-from-list [227,128,128,97]),(bytes-from-list [128])] [(1,1),(1,6)] 7 "" 0 0 0 0 0)]),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [206,255,44,97,10]))) [(ExpectBytes [(bytes-from-list [206,255]),(bytes-from-list [97])] [(1,1),(1,4)] 5 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [206,255,44,97,10]))))) [(ExpectBytes [(bytes-from-list [206,255]),(bytes-from-list [97])] [(1,1),(1,4)] 5 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 7 (reader-from-bytes (runtime-bytes (bytes-from-list [206,255,44,97,10]))))) [(ExpectBytes [(bytes-from-list [206,255]),(bytes-from-list [97])] [(1,1),(1,4)] 5 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 4096 (reader-from-bytes (runtime-bytes (bytes-from-list [206,255,44,97,10]))))) [(ExpectBytes [(bytes-from-list [206,255]),(bytes-from-list [97])] [(1,1),(1,4)] 5 "" 0 0 0 0 0)]),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [255,206,187,120,10]))) [(ExpectBytes [(bytes-from-list [255,206,187,120])] [(1,1)] 5 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [255,206,187,120,10]))))) [(ExpectBytes [(bytes-from-list [255,206,187,120])] [(1,1)] 5 "" 0 0 0 0 0)]),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [35,255,10,97,44,98,10]))) [(ExpectBytes [(bytes-from-list [35,255])] [(1,1)] 3 "" 0 0 0 0 0),(ExpectBytes [(bytes-from-list [97]),(bytes-from-list [98])] [(2,1),(2,3)] 7 "fields" 2 2 1 1 2)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [35,255,10,97,44,98,10]))))) [(ExpectBytes [(bytes-from-list [35,255])] [(1,1)] 3 "" 0 0 0 0 0),(ExpectBytes [(bytes-from-list [97]),(bytes-from-list [98])] [(2,1),(2,3)] 7 "fields" 2 2 1 1 2)])] 13

  -- | Evaluate a bounded group of independent bytes fixtures with original failing indices.
  check-batch2 :: forall r. using (io :: Io r) => Unit ->{IO r} Nat
  check-batch2 unit = first-failure [
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [97,44,0,10]))) [(ExpectBytes [(bytes-from-list [97]),(bytes-from-list [0])] [(1,1),(1,3)] 4 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [97,44,0,10]))))) [(ExpectBytes [(bytes-from-list [97]),(bytes-from-list [0])] [(1,1),(1,3)] 4 "" 0 0 0 0 0)]),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [34,227,128,255,34,10]))) [(ExpectBytes [(bytes-from-list [227,128,255])] [(1,1)] 6 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [34,227,128,255,34,10]))))) [(ExpectBytes [(bytes-from-list [227,128,255])] [(1,1)] 6 "" 0 0 0 0 0)]),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [97,230,188,162,255,230,188,162,122,10]))) [(ExpectBytes [(bytes-from-list [97,230,188,162,255,230,188,162,122])] [(1,1)] 10 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [97,230,188,162,255,230,188,162,122,10]))))) [(ExpectBytes [(bytes-from-list [97,230,188,162,255,230,188,162,122])] [(1,1)] 10 "" 0 0 0 0 0)]),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [97,240,159,152,128,255,240,159,152,128,122,10]))) [(ExpectBytes [(bytes-from-list [97,240,159,152,128,255,240,159,152,128,122])] [(1,1)] 12 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [97,240,159,152,128,255,240,159,152,128,122,10]))))) [(ExpectBytes [(bytes-from-list [97,240,159,152,128,255,240,159,152,128,122])] [(1,1)] 12 "" 0 0 0 0 0)]),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [230,255,44,97,10]))) [(ExpectBytes [(bytes-from-list [230,255]),(bytes-from-list [97])] [(1,1),(1,4)] 5 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [230,255,44,97,10]))))) [(ExpectBytes [(bytes-from-list [230,255]),(bytes-from-list [97])] [(1,1),(1,4)] 5 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 7 (reader-from-bytes (runtime-bytes (bytes-from-list [230,255,44,97,10]))))) [(ExpectBytes [(bytes-from-list [230,255]),(bytes-from-list [97])] [(1,1),(1,4)] 5 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 4096 (reader-from-bytes (runtime-bytes (bytes-from-list [230,255,44,97,10]))))) [(ExpectBytes [(bytes-from-list [230,255]),(bytes-from-list [97])] [(1,1),(1,4)] 5 "" 0 0 0 0 0)])] 25

  -- | Evaluate a bounded group of independent bytes fixtures with original failing indices.
  check-batch3 :: forall r. using (io :: Io r) => Unit ->{IO r} Nat
  check-batch3 unit = first-failure [
      (raw-read-equal (csv-byte-reader (config 44 0 CsvInferFields False False) (runtime-bytes (bytes-from-list [240,128,255,44,97,10]))) [(ExpectBytes [(bytes-from-list [240,128,255]),(bytes-from-list [97])] [(1,1),(1,5)] 6 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvInferFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [240,128,255,44,97,10]))))) [(ExpectBytes [(bytes-from-list [240,128,255]),(bytes-from-list [97])] [(1,1),(1,5)] 6 "" 0 0 0 0 0)]),
