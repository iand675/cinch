      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvAnyFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [255]))))) [(ExpectBytes [(bytes-from-list [255])] [(1,1)] 1 "" 0 0 0 0 0)]),
      (raw-read-equal (csv-byte-reader (config 44 0 CsvAnyFields False False) (runtime-bytes (bytes-from-list [97,44,255,10]))) [(ExpectBytes [(bytes-from-list [97]),(bytes-from-list [255])] [(1,1),(1,3)] 4 "" 0 0 0 0 0)]),
      (raw-stream-equal (csv-byte-stream-reader (config 44 0 CsvAnyFields False False) (chunked 1 (reader-from-bytes (runtime-bytes (bytes-from-list [97,44,255,10]))))) [(ExpectBytes [(bytes-from-list [97]),(bytes-from-list [255])] [(1,1),(1,3)] 4 "" 0 0 0 0 0)]),
