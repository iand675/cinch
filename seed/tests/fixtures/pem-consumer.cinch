  -- | Read one immutable pem-decode-offsets entry; an out-of-range index returns zero.
  unicode-data-pem-decode-offsets :: U32 -> U32
  unicode-data-pem-decode-offsets index = if lt-u32 index 215 then
    let page = wrapping-shr-u32 index 6 in
    unicode-data-pem-decode-offsets-route page index
    else 0

  -- | Route a bounded pem-decode-offsets index without constructing a runtime table.
  unicode-data-pem-decode-offsets-route :: U32 -> U32 -> U32
  unicode-data-pem-decode-offsets-route page index =
    if lt-u32 page 2 then
      if lt-u32 page 1 then
        let local = wrapping-sub-u32 index 0 in
        unicode-data-pem-decode-offsets-page-a local
      else
        let local = wrapping-sub-u32 index 64 in
        unicode-data-pem-decode-offsets-page-b local
    else
      if lt-u32 page 3 then
        let local = wrapping-sub-u32 index 128 in
        unicode-data-pem-decode-offsets-page-c local
      else
        let local = wrapping-sub-u32 index 192 in
        unicode-data-pem-decode-offsets-page-d local

