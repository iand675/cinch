32\u{0}6b393332\u{0}6b393333\u{0}6b393333\u{0}6b393334\u{0}6b393334\u{0}6b393335\u{0}6b393335\u{0}6b393336\u{0}6b393336\u{0}6b393337\u{0}6b393337\u{0}6b393338\u{0}6b393338\u{0}6b393339\u{0}6b393339\u{0}6b3934\u{0}6b3934\u{0}6b393430\u{0}6b393430\u{0}6b393431\u{0}6b393431\u{0}6b393432\u{0}6b393432\u{0}6b393433\u{0}6b393433\u{0}6b393434\u{0}6b393434\u{0}6b393435\u{0}6b393435\u{0}6b393436\u{0}6b393436\u{0}6b393437\u{0}6b393437\u{0}6b393438\u{0}6b393438\u{0}6b393439\u{0}6b393439\u{0}6b3935\u{0}6b3935\u{0}6b393530\u{0}6b393530\u{0}6b393531\u{0}6b393531\u{0}6b393532\u{0}6b393532\u{0}6b393533\u{0}6b393533\u{0}6b393534\u{0}6b393534\u{0}6b393535\u{0}6b393535\u{0}6b393536\u{0}6b393536\u{0}6b393537\u{0}6b393537\u{0}6b393538\u{0}6b393538\u{0}6b393539\u{0}6b393539\u{0}6b3936\u{0}6b3936\u{0}6b393630\u{0}6b393630\u{0}6b393631\u{0}6b393631\u{0}6b393632\u{0}6b393632\u{0}6b393633\u{0}6b393633\u{0}6b393634\u{0}6b393634\u{0}6b393635\u{0}6b393635\u{0}6b393636\u{0}6b393636\u{0}6b393637\u{0}6b393637\u{0}6b393638\u{0}6b393638\u{0}6b393639\u{0}6b393639\u{0}6b3937\u{0}6b3937\u{0}6b393730\u{0}6b393730\u{0}6b393731\u{0}6b393731\u{0}6b393732\u{0}6b393732\u{0}6b393733\u{0}6b393733\u{0}6b393734\u{0}6b393734\u{0}6b393735\u{0}6b393735\u{0}6b393736\u{0}6b393736\u{0}6b393737\u{0}6b393737\u{0}6b393738\u{0}6b393738\u{0}6b393739\u{0}6b393739\u{0}6b3938\u{0}6b3938\u{0}6b393830\u{0}6b393830\u{0}6b393831\u{0}6b393831\u{0}6b393832\u{0}6b393832\u{0}6b393833\u{0}6b393833\u{0}6b393834\u{0}6b393834\u{0}6b393835\u{0}6b393835\u{0}6b393836\u{0}6b393836\u{0}6b393837\u{0}6b393837\u{0}6b393838\u{0}6b393838\u{0}6b393839\u{0}6b393839\u{0}6b3939\u{0}6b3939\u{0}6b393930\u{0}6b393930\u{0}6b393931\u{0}6b393931\u{0}6b393932\u{0}6b393932\u{0}6b393933\u{0}6b393933\u{0}6b393934\u{0}6b393934\u{0}6b393935\u{0}6b393935\u{0}6b393936\u{0}6b393936\u{0}6b393937\u{0}6b393937\u{0}6b393938\u{0}6b393938\u{0}6b393939\u{0}6b393939\u{0}\u{0}\u{0}\u{0}01\u{0}54455354\u{0}01000000\u{0}4b\u{0}76393939\u{0}\u{0}\u{0}" in let offset = u32-to-nat (unicode-data-pem-decode-offsets index) in
      let first = u32-to-nat (wrapping-mul-u32 index 8) in
      if first < 1716 then let remaining = 1716 - first in rows source offset (if remaining < 8 then remaining else 8) False else False
    else False

  -- | Traverse the complete ordinary-memory fixture set without retaining prior mutable fields.
  all-groups :: U32 -> U32 -> Bool
  all-groups mode index = let count = if eq-u32 mode 0 then (60 :: U32) else 215 in
    if lt-u32 index count then run-group mode index && all-groups mode (wrapping-add-u32 index 1) else True

  -- | Parse only ASCII decimal group metadata, independent of Unicode header trimming.
  decimal :: List Char -> Nat -> Nat
  decimal input value = case input of Nil -> value; Cons cp rest -> case digit-value cp of None -> 0; Some digit -> decimal rest (value * 10 + digit)

  -- | Read one immutable pem-encode-offsets entry; an out-of-range index returns zero.
  unicode-data-pem-encode-offsets :: U32 -> U32
  unicode-data-pem-encode-offsets index = if lt-u32 index 60 then
    let page = wrapping-shr-u32 index 6 in
    unicode-data-pem-encode-offsets-route page index
    else 0

  -- | Route a bounded pem-encode-offsets index without constructing a runtime table.
  unicode-data-pem-encode-offsets-route :: U32 -> U32 -> U32
  unicode-data-pem-encode-offsets-route page index =
    let local = wrapping-sub-u32 index 0 in
    unicode-data-pem-encode-offsets-page-a local

  -- | Immutable pem-encode-offsets page 0; scalar cases permit constant-data lowering without vector spills.
  unicode-data-pem-encode-offsets-page-a :: U32 -> U32
