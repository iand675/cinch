  check-batch2 unit = first-failure [
      (typed-case json-byte-slice-type (string-to-bytes "[null,2]") (Some (bytes-from-list [7,8])) (string-to-bytes "\"BwI=\"") "" 0 "" "" ""),
      (typed-case (json-fixed-bytes-type 3) (string-to-bytes "[null,2]") (bytes-from-list [7,8,9]) (string-to-bytes "[7,2,0]") "" 0 "" "" ""),
      (typed-case json-byte-slice-type (string-to-bytes "[1,2,3,4,\"bad\"]") (Some (bytes-from-list [7,8])) (string-to-bytes "\"AQIDBAA=\"") "type" 14 "string" "U8" "[4]"),
      (typed-case (json-fixed-bytes-type 3) (string-to-bytes "[1,2,3,4,\"bad\"]") (bytes-from-list [7,8,9]) (string-to-bytes "[1,2,3]") "" 0 "" "" ""),
      (typed-case json-byte-slice-type (string-to-bytes "true") (Some (bytes-from-list [7,8])) (string-to-bytes "\"Bwg=\"") "type" 4 "boolean" "Bytes" ""),
      (typed-case (json-fixed-bytes-type 3) (string-to-bytes "true") (bytes-from-list [7,8,9]) (string-to-bytes "[7,8,9]") "type" 4 "boolean" "Array" "")] 13

