  -- | Apply InvMixColumns to a round key, forming the equivalent inverse cipher's keys.
  prim aes-inverse-mix :: U128 -> U128 where
    llvm {
      %v1 = bitcast i128 %0 to <16 x i8>
      %p2 = shufflevector <16 x i8> %v1, <16 x i8> zeroinitializer, <16 x i32> <i32 2, i32 3, i32 0, i32 1, i32 6, i32 7, i32 4, i32 5, i32 10, i32 11, i32 8, i32 9, i32 14, i32 15, i32 12, i32 13>
      %x3 = xor <16 x i8> %v1, %p2
      %h4 = lshr <16 x i8> %x3, <i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7>
      %m5 = sub <16 x i8> zeroinitializer, %h4
      %r6 = and <16 x i8> %m5, <i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27>
      %s7 = shl <16 x i8> %x3, <i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1>
      %x8 = xor <16 x i8> %s7, %r6
      %h9 = lshr <16 x i8> %x8, <i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7>
      %m10 = sub <16 x i8> zeroinitializer, %h9
      %r11 = and <16 x i8> %m10, <i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27>
      %s12 = shl <16 x i8> %x8, <i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1>
      %x13 = xor <16 x i8> %s12, %r11
      %x14 = xor <16 x i8> %v1, %x13
      %p15 = shufflevector <16 x i8> %x14, <16 x i8> zeroinitializer, <16 x i32> <i32 1, i32 2, i32 3, i32 0, i32 5, i32 6, i32 7, i32 4, i32 9, i32 10, i32 11, i32 8, i32 13, i32 14, i32 15, i32 12>
      %p16 = shufflevector <16 x i8> %x14, <16 x i8> zeroinitializer, <16 x i32> <i32 2, i32 3, i32 0, i32 1, i32 6, i32 7, i32 4, i32 5, i32 10, i32 11, i32 8, i32 9, i32 14, i32 15, i32 12, i32 13>
      %p17 = shufflevector <16 x i8> %x14, <16 x i8> zeroinitializer, <16 x i32> <i32 3, i32 0, i32 1, i32 2, i32 7, i32 4, i32 5, i32 6, i32 11, i32 8, i32 9, i32 10, i32 15, i32 12, i32 13, i32 14>
      %x18 = xor <16 x i8> %x14, %p15
      %h19 = lshr <16 x i8> %x18, <i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7, i8 7>
      %m20 = sub <16 x i8> zeroinitializer, %h19
      %r21 = and <16 x i8> %m20, <i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27, i8 27>
      %s22 = shl <16 x i8> %x18, <i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1, i8 1>
      %x23 = xor <16 x i8> %s22, %r21
      %x24 = xor <16 x i8> %x23, %p15
      %x25 = xor <16 x i8> %p16, %p17
      %x26 = xor <16 x i8> %x24, %x25
