      ret i128 %0
    }

  -- | Report whether hardware AES may execute: CPUID's AES-NI bit on x86-64, ArmAes target evidence on AArch64, and zero elsewhere. Detection is feature discovery and never depends on key or message bytes.
  prim hardware-aes-available :: U32 -> U32 where
    unsafe llvm {
      %regs = call { i32, i32, i32, i32 } asm "cpuid", "={ax},={bx},={cx},={dx},{ax},{cx}"(i32 1, i32 0)
      %ecx = extractvalue { i32, i32, i32, i32 } %regs, 2
      %bit = and i32 %ecx, 33554432
      ret i32 %bit
    } when arch x86_64
    llvm {
      ret i32 1
    } when arch aarch64 when Available ArmAes
    llvm {
      ret i32 0
    }
