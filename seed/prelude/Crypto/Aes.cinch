      ret i128 %w27
    } when endian little
    llvm {
      %v1 = bitcast i128 %0 to <16 x i8>
      %v2 = shufflevector <16 x i8> %v1, <16 x i8> zeroinitializer, <16 x i32> <i32 15, i32 14, i32 13, i32 12, i32 11, i32 10, i32 9, i32 8, i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
