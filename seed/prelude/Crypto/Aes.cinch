  -- | Decrypt one block with 14 rounds of hardware AES over 15 equivalent-inverse round keys in application order. Callers select this primitive only after hardware detection succeeds; other targets keep the identity body, which is never selected.
  prim hardware-decrypt14 :: U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 where
    unsafe llvm {
      %k0 = bitcast i128 %1 to <2 x i64>
      %k1 = bitcast i128 %2 to <2 x i64>
      %k2 = bitcast i128 %3 to <2 x i64>
      %k3 = bitcast i128 %4 to <2 x i64>
      %k4 = bitcast i128 %5 to <2 x i64>
      %k5 = bitcast i128 %6 to <2 x i64>
      %k6 = bitcast i128 %7 to <2 x i64>
      %k7 = bitcast i128 %8 to <2 x i64>
      %k8 = bitcast i128 %9 to <2 x i64>
      %k9 = bitcast i128 %10 to <2 x i64>
      %k10 = bitcast i128 %11 to <2 x i64>
      %k11 = bitcast i128 %12 to <2 x i64>
      %k12 = bitcast i128 %13 to <2 x i64>
      %k13 = bitcast i128 %14 to <2 x i64>
      %k14 = bitcast i128 %15 to <2 x i64>
      %s0 = bitcast i128 %0 to <2 x i64>
      %a0 = xor <2 x i64> %s0, %k0
      %a1 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a0, <2 x i64> %k1)
      %a2 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a1, <2 x i64> %k2)
      %a3 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a2, <2 x i64> %k3)
      %a4 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a3, <2 x i64> %k4)
      %a5 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a4, <2 x i64> %k5)
      %a6 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a5, <2 x i64> %k6)
      %a7 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a6, <2 x i64> %k7)
      %a8 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a7, <2 x i64> %k8)
      %a9 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a8, <2 x i64> %k9)
      %a10 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a9, <2 x i64> %k10)
      %a11 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a10, <2 x i64> %k11)
      %a12 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a11, <2 x i64> %k12)
      %a13 = call <2 x i64> asm "aesdec $2, $0", "=x,0,x"(<2 x i64> %a12, <2 x i64> %k13)
      %a14 = call <2 x i64> asm "aesdeclast $2, $0", "=x,0,x"(<2 x i64> %a13, <2 x i64> %k14)
      %value = bitcast <2 x i64> %a14 to i128
      ret i128 %value
    } when arch x86_64
    unsafe llvm {
      %k0 = bitcast i128 %1 to <16 x i8>
      %k1 = bitcast i128 %2 to <16 x i8>
      %k2 = bitcast i128 %3 to <16 x i8>
      %k3 = bitcast i128 %4 to <16 x i8>
      %k4 = bitcast i128 %5 to <16 x i8>
      %k5 = bitcast i128 %6 to <16 x i8>
      %k6 = bitcast i128 %7 to <16 x i8>
      %k7 = bitcast i128 %8 to <16 x i8>
      %k8 = bitcast i128 %9 to <16 x i8>
      %k9 = bitcast i128 %10 to <16 x i8>
      %k10 = bitcast i128 %11 to <16 x i8>
      %k11 = bitcast i128 %12 to <16 x i8>
      %k12 = bitcast i128 %13 to <16 x i8>
      %k13 = bitcast i128 %14 to <16 x i8>
      %k14 = bitcast i128 %15 to <16 x i8>
      %a0 = bitcast i128 %0 to <16 x i8>
      %a1 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a0, <16 x i8> %k0)
      %a2 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a1, <16 x i8> %k1)
      %a3 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a2, <16 x i8> %k2)
      %a4 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a3, <16 x i8> %k3)
      %a5 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a4, <16 x i8> %k4)
      %a6 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a5, <16 x i8> %k5)
      %a7 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a6, <16 x i8> %k6)
      %a8 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a7, <16 x i8> %k7)
      %a9 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a8, <16 x i8> %k8)
      %a10 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a9, <16 x i8> %k9)
      %a11 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a10, <16 x i8> %k10)
      %a12 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a11, <16 x i8> %k11)
      %a13 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b\0Aaesimc $0.16b, $0.16b", "=w,0,w"(<16 x i8> %a12, <16 x i8> %k12)
      %a14 = call <16 x i8> asm ".arch_extension aes\0Aaesd $0.16b, $2.16b", "=w,0,w"(<16 x i8> %a13, <16 x i8> %k13)
      %last = xor <16 x i8> %a14, %k14
      %value = bitcast <16 x i8> %last to i128
      ret i128 %value
    } when arch aarch64 when Available ArmAes
