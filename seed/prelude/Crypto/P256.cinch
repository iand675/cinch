      %t36 = zext i64 %t34 to i128
      %t37 = zext i64 %t35 to i128
      %t38 = shl i128 %t37, 64
      %t39 = or i128 %t36, %t38
      ret i128 %t39
    }

  -- | One when a value is below the group order n, else zero.
