  -- | The hi half of (a - b) modulo the group order n.
  prim n-sub-hi :: U128 -> U128 -> U128 -> U128 -> U128 where
    llvm {
      %t1 = trunc i128 %0 to i64
      %t2 = lshr i128 %0, 64
