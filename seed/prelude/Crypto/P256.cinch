-- | The NIST P-256 curve (secp256r1): constant-time field, scalar and point arithmetic, keys and ECDH.
-- Field elements and scalars are fixed 256-bit values in Montgomery form, held as
-- two U128 halves and operated on by generated straight-line limb kernels, so
-- no arithmetic branches on secret data. Points use projective coordinates and
-- the complete addition and doubling formulas for a = -3 (Renes, Costello and
-- Batina), which have no exceptional cases; scalar multiplication is a fixed
-- 4-bit window whose table entry is chosen by scanning every entry. Public keys
-- are SEC 1 points (uncompressed, or compressed on input), checked to lie on
-- the curve; private keys are scalars in [1, n - 1]. ECDH yields the shared
-- point's x-coordinate. Crypto.Ecdsa signs and verifies over this module.
module Crypto.P256 where

  import Data.Bytes
  import Data.Bytes.Word
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Result
  import Data.String

  export P256Error, P256InvalidPrivateKey, P256InvalidPublicKey, P256InvalidScalar, p256-error-message
  export P256PrivateKey, P256PublicKey, p256-private-key, p256-private-key-bytes, p256-public-key-of
  export p256-public-key, p256-public-key-bytes, p256-public-key-compressed, p256-public-key-coordinates, p256-ecdh
  export P256Scalar, p256-scalar, p256-scalar-reduce, p256-scalar-bytes, p256-scalar-is-zero, p256-scalar-mul, p256-scalar-add, p256-scalar-inverse
  export p256-private-scalar, P256Point, p256-public-point, p256-base-mult, p256-point-mult, p256-point-add, p256-point-is-identity, p256-point-x-scalar

  -- ---------------------------------------------------------------------
  -- Errors and keys.
  -- ---------------------------------------------------------------------

  -- | A rejected key or scalar.
  data P256Error where
    -- | A private key must be 32 bytes encoding a value in [1, n - 1].
    P256InvalidPrivateKey :: P256Error
    -- | A public key must be a SEC 1 encoding of a point on the curve.
    P256InvalidPublicKey :: P256Error
    -- | A scalar must be 32 bytes encoding a value below n.
    P256InvalidScalar :: P256Error

  -- | Render an error.
  p256-error-message :: P256Error -> String
  p256-error-message e = case e of
    P256InvalidPrivateKey -> "p256: invalid private key"
    P256InvalidPublicKey -> "p256: invalid public key"
    P256InvalidScalar -> "p256: invalid scalar"

  -- | A private key: its scalar and 32-byte encoding.
  data P256PrivateKey where
    -- | Scalar, then bytes.
    P256PrivateKey :: Sc -> Bytes -> P256PrivateKey

  -- | A public key: an affine point (x and y in Montgomery form).
  data P256PublicKey where
    -- | x, then y.
    P256PublicKey :: Fe -> Fe -> P256PublicKey

  -- | Parse a 32-byte big-endian private key in [1, n - 1].
  p256-private-key :: Bytes -> Result P256Error P256PrivateKey
  p256-private-key b =
    if not (bytes-len b == 32) then Err P256InvalidPrivateKey
    else case raw-pair b 0 of
      (lo, hi) -> if n-below lo hi == 1 && not (is-zero lo hi) then Ok (P256PrivateKey (sc-to-mont (Sc lo hi)) (copy b)) else Err P256InvalidPrivateKey

  -- | The private key's 32 bytes.
  p256-private-key-bytes :: P256PrivateKey -> Bytes
  p256-private-key-bytes k = case k of P256PrivateKey s b -> copy b

  -- | The private key's scalar.
  p256-private-scalar :: P256PrivateKey -> P256Scalar
  p256-private-scalar k = case k of P256PrivateKey s b -> P256Scalar s

  -- | The public key d * G.
  p256-public-key-of :: P256PrivateKey -> P256PublicKey
  p256-public-key-of k = case k of
    P256PrivateKey s b -> case affine (base-mult (sc-to-bytes s)) of
      Some (x, y) -> P256PublicKey x y
      None -> P256PublicKey fe-zero fe-zero

  -- | Parse a SEC 1 public key: 0x04 || x || y (65 bytes) or 0x02/0x03 || x (33 bytes); the point must be on the curve.
  p256-public-key :: Bytes -> Result P256Error P256PublicKey
  p256-public-key b =
    if bytes-len b == 65 && at b 0 == 4 then
      (case (field-element b 1, field-element b 33) of
        (Some x, Some y) -> if on-curve x y then Ok (P256PublicKey x y) else Err P256InvalidPublicKey
        other -> Err P256InvalidPublicKey)
    else if bytes-len b == 33 && (at b 0 == 2 || at b 0 == 3) then
      (case field-element b 1 of
        None -> Err P256InvalidPublicKey
        Some x -> case decompress x (at b 0 == 3) of Some y -> Ok (P256PublicKey x y); None -> Err P256InvalidPublicKey)
    else Err P256InvalidPublicKey

  -- | The uncompressed encoding (65 bytes).
  p256-public-key-bytes :: P256PublicKey -> Bytes
  p256-public-key-bytes k = case k of P256PublicKey x y -> concat3 (one 4) (fe-to-bytes x) (fe-to-bytes y)

  -- | The compressed encoding (33 bytes).
  p256-public-key-compressed :: P256PublicKey -> Bytes
  p256-public-key-compressed k = case k of
    P256PublicKey x y -> let yb = fe-to-bytes y in concat3 (one (if nat-rem (at yb 31) 2 == 1 then (3 :: Nat) else 2)) (fe-to-bytes x) (bytes-new 0)

  -- | The affine coordinates as 32-byte big-endian values.
  p256-public-key-coordinates :: P256PublicKey -> (Bytes, Bytes)
  p256-public-key-coordinates k = case k of P256PublicKey x y -> (fe-to-bytes x, fe-to-bytes y)

  -- | ECDH: the x-coordinate (32 bytes) of the private scalar times the peer's point.
  p256-ecdh :: P256PrivateKey -> P256PublicKey -> Result P256Error Bytes
  p256-ecdh k peer = case k of
    P256PrivateKey s b -> case peer of
      P256PublicKey x y -> case affine (point-mult (sc-to-bytes s) (Point x y fe-one)) of
        Some (sx, sy) -> Ok (fe-to-bytes sx)
        None -> Err P256InvalidPublicKey

  -- | Whether (x, y) satisfies y^2 = x^3 - 3x + b.
  on-curve :: Fe -> Fe -> Bool
  on-curve x y = fe-eq (fe-sq y) (curve-rhs x)

  -- | x^3 - 3x + b.
  curve-rhs :: Fe -> Fe
  curve-rhs x = let x3 = fe-mul (fe-sq x) x in fe-add (fe-sub x3 (fe-add x (fe-add x x))) fe-b

  -- | The y with the given parity for x, when x is on the curve.
  decompress :: Fe -> Bool -> Option Fe
  decompress x odd =
    let rhs = curve-rhs x in
    let y = fe-pow rhs p-sqrt-exponent in
    if not (fe-eq (fe-sq y) rhs) then None
    else
      let parity = nat-rem (at (fe-to-bytes y) 31) 2 == 1 in
      Some (if parity == odd then y else fe-sub fe-zero y)

  -- ---------------------------------------------------------------------
  -- Scalars (public interface for signatures).
  -- ---------------------------------------------------------------------

  -- | A scalar modulo n.
  data P256Scalar where
    -- | The Montgomery-form value.
    P256Scalar :: Sc -> P256Scalar

  -- | Parse a 32-byte big-endian scalar below n.
  p256-scalar :: Bytes -> Result P256Error P256Scalar
  p256-scalar b = if not (bytes-len b == 32) then Err P256InvalidScalar else case raw-pair b 0 of
    (lo, hi) -> if n-below lo hi == 1 then Ok (P256Scalar (sc-to-mont (Sc lo hi))) else Err P256InvalidScalar

  -- | Interpret up to the first 32 bytes as a big-endian integer and reduce it modulo n (shorter inputs are left-padded).
  p256-scalar-reduce :: Bytes -> P256Scalar
  p256-scalar-reduce b =
    let padded = left-pad (if bytes-len b > 32 then slice b 0 32 else b) 32 in
    case raw-pair padded 0 of (lo, hi) -> P256Scalar (sc-to-mont (Sc (n-reduce-lo lo hi) (n-reduce-hi lo hi)))

  -- | The scalar's 32-byte big-endian encoding.
  p256-scalar-bytes :: P256Scalar -> Bytes
  p256-scalar-bytes s = case s of P256Scalar v -> sc-to-bytes v

  -- | Whether the scalar is zero.
  p256-scalar-is-zero :: P256Scalar -> Bool
  p256-scalar-is-zero s = case s of P256Scalar v -> case v of Sc lo hi -> is-zero lo hi

  -- | Product modulo n.
  p256-scalar-mul :: P256Scalar -> P256Scalar -> P256Scalar
  p256-scalar-mul a b = case a of P256Scalar x -> case b of P256Scalar y -> P256Scalar (sc-mul x y)

  -- | Sum modulo n.
  p256-scalar-add :: P256Scalar -> P256Scalar -> P256Scalar
  p256-scalar-add a b = case a of P256Scalar x -> case b of P256Scalar y -> P256Scalar (sc-add x y)

  -- | Inverse modulo n (zero maps to zero).
  p256-scalar-inverse :: P256Scalar -> P256Scalar
  p256-scalar-inverse a = case a of P256Scalar x -> P256Scalar (sc-pow x n-minus-two)

  -- | A curve point (projective).
  data P256Point where
    -- | The point.
    P256Point :: Point -> P256Point

  -- | A public key's point.
  p256-public-point :: P256PublicKey -> P256Point
  p256-public-point k = case k of P256PublicKey x y -> P256Point (Point x y fe-one)

  -- | s * G.
  p256-base-mult :: P256Scalar -> P256Point
  p256-base-mult s = case s of P256Scalar v -> P256Point (base-mult (sc-to-bytes v))

  -- | s * P.
  p256-point-mult :: P256Scalar -> P256Point -> P256Point
  p256-point-mult s p = case s of P256Scalar v -> case p of P256Point q -> P256Point (point-mult (sc-to-bytes v) q)

  -- | P + Q.
  p256-point-add :: P256Point -> P256Point -> P256Point
  p256-point-add a b = case a of P256Point p -> case b of P256Point q -> P256Point (point-add p q)

  -- | Whether a point is the identity.
  p256-point-is-identity :: P256Point -> Bool
  p256-point-is-identity p = case p of P256Point q -> case q of Point x y z -> fe-is-zero z

  -- | The affine x-coordinate reduced modulo n (None for the identity).
  p256-point-x-scalar :: P256Point -> Option P256Scalar
  p256-point-x-scalar p = case p of
    P256Point q -> case affine q of
      Some (x, y) -> (case fe-from-mont x of Fe lo hi -> Some (P256Scalar (sc-to-mont (Sc (n-reduce-lo lo hi) (n-reduce-hi lo hi)))))
      None -> None

  -- ---------------------------------------------------------------------
  -- Field elements modulo p.
  -- ---------------------------------------------------------------------

  -- | A field element in Montgomery form: low and high halves.
  data Fe where
    -- | Low half, then high half.
    Fe :: U128 -> U128 -> Fe

  -- | Zero.
  fe-zero :: Fe
  fe-zero = Fe (words 0 0) (words 0 0)

  -- | Product.
  fe-mul :: Fe -> Fe -> Fe
  fe-mul a b = case a of Fe a0 a1 -> case b of Fe b0 b1 -> Fe (p-mul-lo a0 a1 b0 b1) (p-mul-hi a0 a1 b0 b1)

  -- | Square.
  fe-sq :: Fe -> Fe
  fe-sq a = fe-mul a a

  -- | Sum.
  fe-add :: Fe -> Fe -> Fe
  fe-add a b = case a of Fe a0 a1 -> case b of Fe b0 b1 -> Fe (p-add-lo a0 a1 b0 b1) (p-add-hi a0 a1 b0 b1)

  -- | Difference.
  fe-sub :: Fe -> Fe -> Fe
  fe-sub a b = case a of Fe a0 a1 -> case b of Fe b0 b1 -> Fe (p-sub-lo a0 a1 b0 b1) (p-sub-hi a0 a1 b0 b1)

  -- | Whether an element is zero.
  fe-is-zero :: Fe -> Bool
  fe-is-zero a = case a of Fe lo hi -> is-zero lo hi

  -- | Equality.
  fe-eq :: Fe -> Fe -> Bool
  fe-eq a b = fe-is-zero (fe-sub a b)

  -- | a^e for a public exponent (square and multiply over its 256 bits, most significant first).
  fe-pow :: Fe -> Fe -> Fe
  fe-pow a e = case e of Fe lo hi -> fe-pow-from a lo hi 255 fe-one

  -- | Exponentiation from bit i down.
  fe-pow-from :: Fe -> U128 -> U128 -> Nat -> Fe -> Fe
  fe-pow-from a lo hi i acc =
    let squared = fe-sq acc in
    let next = if bit-at lo hi i == 1 then fe-mul squared a else squared in
    if i == 0 then next else fe-pow-from a lo hi (i - 1) next

  -- | Leave Montgomery form.
  fe-from-mont :: Fe -> Fe
  fe-from-mont a = fe-mul a fe-raw-one

  -- | The canonical 32-byte big-endian encoding.
  fe-to-bytes :: Fe -> Bytes
  fe-to-bytes a = case fe-from-mont a of Fe lo hi -> pair-bytes lo hi

  -- | Parse 32 big-endian bytes at an offset as a field element below p.
  field-element :: Bytes -> Nat -> Option Fe
  field-element b off = case raw-pair b off of
    (lo, hi) -> if p-below lo hi == 1 then Some (fe-mul (Fe lo hi) fe-r2) else None

  -- | Choose a when the flag is one, else b, without branching.
  fe-select :: I64 -> Fe -> Fe -> Fe
  fe-select flag a b = case a of Fe a0 a1 -> case b of Fe b0 b1 -> Fe (choose flag a0 b0) (choose flag a1 b1)

  -- ---------------------------------------------------------------------
  -- Scalars modulo n.
  -- ---------------------------------------------------------------------

  -- | A scalar in Montgomery form modulo n.
  data Sc where
    -- | Low half, then high half.
    Sc :: U128 -> U128 -> Sc

  -- | Product.
  sc-mul :: Sc -> Sc -> Sc
  sc-mul a b = case a of Sc a0 a1 -> case b of Sc b0 b1 -> Sc (n-mul-lo a0 a1 b0 b1) (n-mul-hi a0 a1 b0 b1)

  -- | Sum.
  sc-add :: Sc -> Sc -> Sc
  sc-add a b = case a of Sc a0 a1 -> case b of Sc b0 b1 -> Sc (n-add-lo a0 a1 b0 b1) (n-add-hi a0 a1 b0 b1)

  -- | Enter Montgomery form.
  sc-to-mont :: Sc -> Sc
  sc-to-mont a = sc-mul a sc-r2

  -- | The canonical 32-byte encoding.
  sc-to-bytes :: Sc -> Bytes
  sc-to-bytes a = case sc-mul a sc-raw-one of Sc lo hi -> pair-bytes lo hi

  -- | a^e for a public exponent.
  sc-pow :: Sc -> Sc -> Sc
  sc-pow a e = case e of Sc lo hi -> sc-pow-from a lo hi 255 sc-one

  -- | Exponentiation from bit i down.
  sc-pow-from :: Sc -> U128 -> U128 -> Nat -> Sc -> Sc
  sc-pow-from a lo hi i acc =
    let squared = sc-mul acc acc in
    let next = if bit-at lo hi i == 1 then sc-mul squared a else squared in
    if i == 0 then next else sc-pow-from a lo hi (i - 1) next

  -- ---------------------------------------------------------------------
  -- Points.
  -- ---------------------------------------------------------------------

  -- | A projective point (X : Y : Z); the identity is (0 : 1 : 0).
  data Point where
    -- | X, Y, Z in Montgomery form.
    Point :: Fe -> Fe -> Fe -> Point

  -- | The identity.
  identity :: Point
  identity = Point fe-zero fe-one fe-zero

  -- | The base point.
  generator :: Point
  generator = Point fe-gx fe-gy fe-one

  -- | Complete addition for a = -3 (Renes, Costello and Batina, Algorithm 4).
  point-add :: Point -> Point -> Point
  point-add p q = case p of
    Point x1 y1 z1 -> case q of
      Point x2 y2 z2 ->
        let t0 = fe-mul x1 x2 in let t1 = fe-mul y1 y2 in let t2 = fe-mul z1 z2 in
        let t3 = fe-mul (fe-add x1 y1) (fe-add x2 y2) in
        let t3b = fe-sub t3 (fe-add t0 t1) in
        let t4 = fe-mul (fe-add y1 z1) (fe-add y2 z2) in
        let t4b = fe-sub t4 (fe-add t1 t2) in
        let xa = fe-mul (fe-add x1 z1) (fe-add x2 z2) in
        let ya = fe-sub xa (fe-add t0 t2) in
        let za = fe-mul fe-b t2 in
        let xb = fe-sub ya za in
        let xc = fe-add xb (fe-add xb xb) in
        let zb = fe-sub t1 xc in
        let xd = fe-add t1 xc in
        let yb = fe-mul fe-b ya in
        let t2b = fe-add t2 (fe-add t2 t2) in
        let yc = fe-sub (fe-sub yb t2b) t0 in
        let yd = fe-add yc (fe-add yc yc) in
        let t0b = fe-sub (fe-add t0 (fe-add t0 t0)) t2b in
        let t1b = fe-mul t4b yd in
        let t2c = fe-mul t0b yd in
        let ye = fe-add (fe-mul xd zb) t2c in
        let xe = fe-sub (fe-mul t3b xd) t1b in
        let ze = fe-add (fe-mul t4b zb) (fe-mul t3b t0b) in
        Point xe ye ze

  -- | Doubling for a = -3 (Renes, Costello and Batina, Algorithm 6).
  point-double :: Point -> Point
  point-double p = case p of
    Point x y z ->
      let t0 = fe-sq x in let t1 = fe-sq y in let t2 = fe-sq z in
      let t3 = let m = fe-mul x y in fe-add m m in
      let z3 = let m = fe-mul x z in fe-add m m in
      let y3 = fe-sub (fe-mul fe-b t2) z3 in
      let x3 = fe-add y3 (fe-add y3 y3) in
      let xa = fe-sub t1 x3 in
      let ya = fe-mul (fe-add t1 x3) xa in
      let xb = fe-mul xa t3 in
      let t2b = fe-add t2 (fe-add t2 t2) in
      let zb = fe-sub (fe-sub (fe-mul fe-b z3) t2b) t0 in
      let zc = fe-add zb (fe-add zb zb) in
      let t0b = fe-sub (fe-add t0 (fe-add t0 t0)) t2b in
      let yb = fe-add ya (fe-mul t0b zc) in
      let t0c = let m = fe-mul y z in fe-add m m in
      let xc = fe-sub xb (fe-mul t0c zc) in
      let zd = let m = fe-mul t0c t1 in let d = fe-add m m in fe-add d d in
      Point xc yb zd

  -- | The affine coordinates, None for the identity.
  affine :: Point -> Option (Fe, Fe)
  affine p = case p of
    Point x y z -> if fe-is-zero z then None else let zi = fe-pow z p-minus-two in Some (fe-mul x zi, fe-mul y zi)

  -- | k * G for a 32-byte big-endian scalar.
  base-mult :: Bytes -> Point
  base-mult k = point-mult k generator

  -- | k * P: a fixed 4-bit window from the most significant nibble; each step doubles four times and adds the table
  -- entry chosen by scanning all sixteen.
  point-mult :: Bytes -> Point -> Point
  point-mult k p =
    let table = multiples p 1 (Cons identity Nil) in
    windows k table 0 identity

  -- | The multiples 0P .. 15P, in order.
  multiples :: Point -> Nat -> List Point -> List Point
  multiples p i acc = case acc of
    Cons last rest -> if i >= 16 then reverse acc else multiples p (i + 1) (Cons (point-add last p) acc)
    Nil -> Nil

  -- | Process nibbles from index i (0 is the most significant).
  windows :: Bytes -> List Point -> Nat -> Point -> Point
  windows k table i acc =
    if i >= 64 then acc
    else
      let byte = at k (nat-div i 2) in
      let nibble = if nat-rem i 2 == 0 then nat-div byte 16 else nat-rem byte 16 in
      let shifted = point-double (point-double (point-double (point-double acc))) in
      windows k table (i + 1) (point-add shifted (lookup-point table nibble 0 identity))

  -- | The table entry at an index, reading every entry.
  lookup-point :: List Point -> Nat -> Nat -> Point -> Point
  lookup-point table index i acc = case table of
    Nil -> acc
    Cons q rest -> lookup-point rest index (i + 1) (point-select (if i == index then 1 else 0) q acc)

  -- | Choose a point by a flag without branching on coordinates.
  point-select :: I64 -> Point -> Point -> Point
  point-select flag a b = case a of
    Point ax ay az -> case b of
      Point bx by bz -> Point (fe-select flag ax bx) (fe-select flag ay by) (fe-select flag az bz)

  -- ---------------------------------------------------------------------
  -- Bytes and words.
  -- ---------------------------------------------------------------------

  -- | A byte or zero past the end.
  at :: Bytes -> Nat -> Nat
  at b i = if i < bytes-len b then bytes-get b i else 0

  -- | One byte.
  one :: Nat -> Bytes
  one v = let out = bytes-new 1 in let w = if v < 256 then bytes-set out 0 v else () in out

  -- | A fresh copy of b[x, y).
  slice :: Bytes -> Nat -> Nat -> Bytes
  slice b x y =
    let n = if x <= y then y - x else 0 in
    let out = bytes-new n in
    if x + n <= bytes-len b then let c = bytes-copy-range out b 0 x n in out else out

  -- | A fresh copy.
  copy :: Bytes -> Bytes
  copy b = slice b 0 (bytes-len b)

  -- | Three buffers joined.
  concat3 :: Bytes -> Bytes -> Bytes -> Bytes
  concat3 a b c =
    let out = bytes-new (bytes-len a + bytes-len b + bytes-len c) in
    let w1 = if bytes-len a <= bytes-len out then bytes-copy-range out a 0 0 (bytes-len a) else () in
    let w2 = if bytes-len a + bytes-len b <= bytes-len out then bytes-copy-range out b (bytes-len a) 0 (bytes-len b) else () in
    let w3 = if bytes-len a + bytes-len b + bytes-len c <= bytes-len out then bytes-copy-range out c (bytes-len a + bytes-len b) 0 (bytes-len c) else () in
    out

  -- | Left-pad with zeros to n bytes.
  left-pad :: Bytes -> Nat -> Bytes
  left-pad b n = if bytes-len b >= n then b else concat3 (bytes-new (n - bytes-len b)) b (bytes-new 0)

  -- | A big-endian 64-bit word.
  be64 :: Bytes -> Nat -> U64
  be64 b o = if o + 8 <= bytes-len b then swap-bytes-u64 (bytes-read-le64 b o) else 0

  -- | 32 big-endian bytes at an offset as low and high halves.
  raw-pair :: Bytes -> Nat -> (U128, U128)
  raw-pair b o = (join64 (be64 b (o + 24)) (be64 b (o + 16)), join64 (be64 b (o + 8)) (be64 b o))

  -- | Low and high halves as 32 big-endian bytes.
  pair-bytes :: U128 -> U128 -> Bytes
  pair-bytes lo hi =
    let out = bytes-new 32 in
    let a = bytes-write-le64 out 0 (swap-bytes-u64 (high64 hi)) in
    let b = bytes-write-le64 out 8 (swap-bytes-u64 (low64 hi)) in
    let c = bytes-write-le64 out 16 (swap-bytes-u64 (high64 lo)) in
    let d = bytes-write-le64 out 24 (swap-bytes-u64 (low64 lo)) in
    out

  -- | Whether both halves are zero.
  is-zero :: U128 -> U128 -> Bool
  is-zero lo hi = zero-pair lo hi == 1

  -- | Bit i (0 is least significant) of a 256-bit value.
  bit-at :: U128 -> U128 -> Nat -> I64
  bit-at lo hi i = if i < 128 then bit128 lo (nat-to-i64 i) else if i < 256 then bit128 hi (nat-to-i64 (i - 128)) else 0

  -- | A U128 from signed 64-bit halves (low first).
  prim words :: I64 -> I64 -> U128 where
    llvm {
      %lo = zext i64 %0 to i128
      %hi = zext i64 %1 to i128
      %s = shl i128 %hi, 64
      %r = or i128 %lo, %s
      ret i128 %r
    }

  -- | A U128 from unsigned halves (low first).
  prim join64 :: U64 -> U64 -> U128 where
    llvm {
      %lo = zext i64 %0 to i128
      %hi = zext i64 %1 to i128
      %s = shl i128 %hi, 64
      %r = or i128 %lo, %s
      ret i128 %r
    }

  -- | The low half of a U128.
  prim low64 :: U128 -> U64 where
    llvm {
      %r = trunc i128 %0 to i64
      ret i64 %r
    }

  -- | The high half of a U128.
  prim high64 :: U128 -> U64 where
    llvm {
      %s = lshr i128 %0, 64
      %r = trunc i128 %s to i64
      ret i64 %r
    }

  -- | One when both values are zero, else zero.
  prim zero-pair :: U128 -> U128 -> I64 where
    llvm {
      %o = or i128 %0, %1
      %z = icmp eq i128 %o, 0
      %r = zext i1 %z to i64
      ret i64 %r
    }

  -- | Bit i of a U128.
  prim bit128 :: U128 -> I64 -> I64 where
    llvm {
      %i = zext i64 %1 to i128
      %s = lshr i128 %0, %i
      %t = trunc i128 %s to i64
      %r = and i64 %t, 1
      ret i64 %r
    }

  -- | a when the flag is one, else b, by masking.
  prim choose :: I64 -> U128 -> U128 -> U128 where
    llvm {
      %f = trunc i64 %0 to i1
      %m = sext i1 %f to i128
      %x = xor i128 %1, %2
      %y = and i128 %x, %m
      %r = xor i128 %y, %2
      ret i128 %r
    }

  -- | One in Montgomery form (R mod p).
  fe-one :: Fe
  fe-one = Fe (words (1) (-4294967296)) (words (-1) (4294967294))

  -- | R^2 mod p, which moves a value into Montgomery form.
  fe-r2 :: Fe
  fe-r2 = Fe (words (3) (-17179869185)) (words (-2) (21474836477))

  -- | The plain value one, which moves a value out of Montgomery form.
  fe-raw-one :: Fe
