      %r0j1w = lshr i32 %r0j1rot, 26
      %r0j1k8 = extractelement <8 x i8> %kv0, i64 1
      %r0j1k = zext i8 %r0j1k8 to i32
      %r0j1x = xor i32 %r0j1w, %r0j1k
