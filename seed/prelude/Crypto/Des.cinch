      %r0j1p = getelementptr i8, ptr %sp, i64 %r0j1off
      %r0j1e = load i32, ptr %r0j1p, align 1
      %r0j2rot = call i32 @llvm.fshl.i32(i32 %r0, i32 %r0, i32 7)
      %r0j2w = lshr i32 %r0j2rot, 26
      %r0j2k8 = extractelement <8 x i8> %kv0, i64 2
