-- | DES and Triple DES (FIPS 46-3, SP 800-67) block ciphers with ECB, CBC and CTR over 64-bit blocks.
-- These ciphers exist for interoperation with legacy formats and protocols: DES
-- keys are far too short, and Triple DES has a 64-bit block, so neither should
-- protect new data. A whole block is one straight-line kernel: permutation
-- networks for the initial and final permutations, rotation windows for the
-- expansion, and combined S-box and P-permutation tables addressed through the
-- key schedule. Table lookups depend on data, so timing is not constant. Triple
-- DES is encrypt-decrypt-encrypt with three independent keys (a 24-byte key).
-- Every returned buffer is fresh; inputs are never retained or mutated.
module Crypto.Des where

  import Data.Bytes
  import Data.Bytes.Word
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Result
  import Data.String
  import Text.Hex
  import Text.Show (nat-to-string)

  export DesCipher, des-cipher, triple-des-cipher, des-block-size
  export DesError, DesInvalidKeySize, DesInvalidInputSize, DesInvalidIvSize, des-error-message
  export des-encrypt-block, des-decrypt-block, des-encrypt-ecb, des-decrypt-ecb
  export des-cbc-encrypt, des-cbc-decrypt, des-ctr-xor

  -- | A rejected key, input or initialization vector.
  data DesError where
    -- | DES keys are 8 bytes and Triple DES keys 24; the length given.
    DesInvalidKeySize :: Nat -> DesError
    -- | Block modes need a whole number of 8-byte blocks (a single-block call exactly one); the length given.
    DesInvalidInputSize :: Nat -> DesError
    -- | Initialization vectors and counters are 8 bytes; the length given.
    DesInvalidIvSize :: Nat -> DesError

  -- | Render an error.
  des-error-message :: DesError -> String
  des-error-message error = case error of
    DesInvalidKeySize n -> string-concat "des: invalid key size " (nat-to-string n)
    DesInvalidInputSize n -> string-concat "des: input is not a whole number of blocks: " (nat-to-string n)
    DesInvalidIvSize n -> string-concat "des: invalid IV size " (nat-to-string n)

  -- | A keyed cipher: one schedule for DES, three for Triple DES (applied encrypt, decrypt, encrypt).
  -- A schedule holds the SP tables (2048 bytes), the encryption round keys and the decryption round keys (128 bytes each).
  data DesCipher where
    -- | Single DES.
    SingleDes :: Bytes -> DesCipher
    -- | Triple DES with its three schedules in key order.
    TripleDes :: Bytes -> Bytes -> Bytes -> DesCipher

  -- | The block size in bytes.
  des-block-size :: Nat
  des-block-size = 8

  -- | Key DES with an 8-byte key (parity bits are ignored).
  des-cipher :: Bytes -> Result DesError DesCipher
  des-cipher key = if bytes-len key == 8 then Ok (SingleDes (schedule key 0)) else Err (DesInvalidKeySize (bytes-len key))

  -- | Key Triple DES with a 24-byte key: three DES keys in order.
  triple-des-cipher :: Bytes -> Result DesError DesCipher
  triple-des-cipher key =
    if bytes-len key == 24 then Ok (TripleDes (schedule key 0) (schedule key 8) (schedule key 16))
    else Err (DesInvalidKeySize (bytes-len key))

  -- | Build a schedule from the 8 key bytes at an offset: SP tables, then round keys forward and reversed.
  schedule :: Bytes -> Nat -> Bytes
  schedule key at =
    let out = bytes-new 2304 in
    let tables = case hex-decode sp-tables-hex of Ok t -> t; Err e -> bytes-new 2048 in
    let copied = if bytes-len tables == 2048 then bytes-copy-range out tables 0 0 2048 else () in
    let word = if at + 8 <= bytes-len key then bytes-read-le64 key at else 0 in
    let keys = round-keys out word 0 0 in
    out

  -- | Store each round key at its encryption slot and its mirrored decryption slot.
  round-keys :: Bytes -> U64 -> Nat -> Nat -> Unit
  round-keys out word r shift =
    if r >= 16 then ()
    else
      let total = shift + rotation r in
      let k = des-round-key word (small total) in
      let a = store out (2048 + 8 * r) k in
      let b = store out (2048 + 128 + 8 * (15 - r)) k in
      round-keys out word (r + 1) total

  -- | The left rotation applied to the key halves before round r: one bit in rounds 1, 2, 9 and 16, two otherwise.
  rotation :: Nat -> Nat
  rotation r = if r == 0 || r == 1 || r == 8 || r == 15 then 1 else 2

  -- | A count below 2^32 as a word.
  small :: Nat -> U64
  small n = if n < 4294967296 then wrapping-i64-to-u64 (nat-to-i64 n) else 0

  -- | Write a word when it fits.
  store :: Bytes -> Nat -> U64 -> Unit
  store out at w = if at + 8 <= bytes-len out then bytes-write-le64 out at w else ()

  -- | Read a word, zero when it does not fit.
  load :: Bytes -> Nat -> U64
  load b at = if at + 8 <= bytes-len b then bytes-read-le64 b at else 0

  -- | Run the round kernel over a schedule; forward encrypts, otherwise decrypts.
  rounds :: Bytes -> Bool -> U64 -> U64
  rounds s forward block = hold s (des-rounds (bytes-data s) (wrapping-add-i64 (bytes-data s) (if forward then 2048 else 2176)) block)

  -- | Keep a buffer alive until a raw load has completed.
  hold :: forall a. Bytes -> a -> a
  hold b value = case bytes-len b of
    _ -> value

  -- | Encrypt one block word.
  forward :: DesCipher -> U64 -> U64
  forward c block = case c of
    SingleDes s -> rounds s True block
    TripleDes a b z -> rounds z True (rounds b False (rounds a True block))

  -- | Decrypt one block word.
  backward :: DesCipher -> U64 -> U64
  backward c block = case c of
    SingleDes s -> rounds s False block
    TripleDes a b z -> rounds a False (rounds b True (rounds z False block))

  -- | Encrypt exactly one 8-byte block.
  des-encrypt-block :: DesCipher -> Bytes -> Result DesError Bytes
  des-encrypt-block c input = if bytes-len input == 8 then Ok (word-bytes (forward c (load input 0))) else Err (DesInvalidInputSize (bytes-len input))

  -- | Decrypt exactly one 8-byte block.
  des-decrypt-block :: DesCipher -> Bytes -> Result DesError Bytes
  des-decrypt-block c input = if bytes-len input == 8 then Ok (word-bytes (backward c (load input 0))) else Err (DesInvalidInputSize (bytes-len input))

  -- | A word as 8 fresh bytes.
  word-bytes :: U64 -> Bytes
  word-bytes w = let out = bytes-new 8 in let s = store out 0 w in out

  -- | Encrypt each block independently.
  des-encrypt-ecb :: DesCipher -> Bytes -> Result DesError Bytes
  des-encrypt-ecb c input = whole input (let out = bytes-new (bytes-len input) in let done = ecb c True input out 0 in out)

  -- | Decrypt each block independently.
  des-decrypt-ecb :: DesCipher -> Bytes -> Result DesError Bytes
  des-decrypt-ecb c input = whole input (let out = bytes-new (bytes-len input) in let done = ecb c False input out 0 in out)

  -- | The result when the input is a whole number of blocks.
  whole :: Bytes -> Bytes -> Result DesError Bytes
  whole input out = if nat-rem (bytes-len input) 8 == 0 then Ok out else Err (DesInvalidInputSize (bytes-len input))

  -- | Transform blocks independently from an offset.
  ecb :: DesCipher -> Bool -> Bytes -> Bytes -> Nat -> Unit
  ecb c enc input out at =
    if at + 8 > bytes-len input then ()
    else
      let w = load input at in
      let s = store out at (if enc then forward c w else backward c w) in
      ecb c enc input out (at + 8)

  -- | CBC encryption: each plaintext block is XORed with the previous ciphertext block (the IV first).
  des-cbc-encrypt :: DesCipher -> Bytes -> Bytes -> Result DesError Bytes
  des-cbc-encrypt c iv input =
    if not (bytes-len iv == 8) then Err (DesInvalidIvSize (bytes-len iv))
    else whole input (let out = bytes-new (bytes-len input) in let done = cbc-enc c input out 0 (load iv 0) in out)

  -- | CBC encryption from an offset with the chaining word.
  cbc-enc :: DesCipher -> Bytes -> Bytes -> Nat -> U64 -> Unit
  cbc-enc c input out at chain =
    if at + 8 > bytes-len input then ()
    else
      let e = forward c (bit-xor-u64 (load input at) chain) in
      let s = store out at e in
      cbc-enc c input out (at + 8) e

  -- | CBC decryption.
  des-cbc-decrypt :: DesCipher -> Bytes -> Bytes -> Result DesError Bytes
  des-cbc-decrypt c iv input =
    if not (bytes-len iv == 8) then Err (DesInvalidIvSize (bytes-len iv))
    else whole input (let out = bytes-new (bytes-len input) in let done = cbc-dec c input out 0 (load iv 0) in out)

  -- | CBC decryption from an offset with the chaining word.
  cbc-dec :: DesCipher -> Bytes -> Bytes -> Nat -> U64 -> Unit
  cbc-dec c input out at chain =
    if at + 8 > bytes-len input then ()
    else
      let w = load input at in
      let s = store out at (bit-xor-u64 (backward c w) chain) in
      cbc-dec c input out (at + 8) w

  -- | CTR mode: XOR the input (any length) with encryptions of the counter block, which increments as a
  -- big-endian 64-bit integer. Encryption and decryption are the same operation.
  des-ctr-xor :: DesCipher -> Bytes -> Bytes -> Result DesError Bytes
  des-ctr-xor c iv input =
    if not (bytes-len iv == 8) then Err (DesInvalidIvSize (bytes-len iv))
    else
      let out = bytes-new (bytes-len input) in
      let done = ctr c input out 0 (swap-bytes-u64 (load iv 0)) in
      Ok out

  -- | CTR from an offset; the counter is held as its big-endian value.
  ctr :: DesCipher -> Bytes -> Bytes -> Nat -> U64 -> Unit
  ctr c input out at counter =
    if at >= bytes-len input then ()
    else
      let pad = forward c (swap-bytes-u64 counter) in
      let next = wrapping-add-u64 counter 1 in
      if at + 8 <= bytes-len input then
        let s = store out at (bit-xor-u64 (load input at) pad) in
        ctr c input out (at + 8) next
      else tail-xor input out at (word-bytes pad) 0

  -- | XOR the final partial block with the leading pad bytes.
  tail-xor :: Bytes -> Bytes -> Nat -> Bytes -> Nat -> Unit
  tail-xor input out at pad i =
    if at + i >= bytes-len input || i >= bytes-len pad || at + i >= bytes-len out then ()
    else
      let v = u8-to-nat (wrapping-u64-to-u8 (bit-xor-u64 (u8-to-u64 (wrapping-i64-to-u8 (nat-to-i64 (bytes-get input (at + i))))) (u8-to-u64 (wrapping-i64-to-u8 (nat-to-i64 (bytes-get pad i)))))) in
      let w = if v < 256 then bytes-set out (at + i) v else () in
      tail-xor input out at pad (i + 1)

  -- Generated DES kernels: permutation networks, rounds and key-schedule bodies.

  -- | The combined S-box and P-permutation tables: eight tables of 64 little-endian words.
  sp-tables-hex :: String
  sp-tables-hex = ""

  -- | Encrypt one block (as a little-endian word of its bytes) with the round keys at an address, in their order;
  -- the SP tables are at the other address. Reversed round keys decrypt.
  prim des-rounds :: I64 -> I64 -> U64 -> U64 where
    unsafe llvm {
      %b = call i64 @llvm.bswap.i64(i64 %2)
      %ipm0 = and i64 %b, 144115188075855872
      %ips0 = lshr i64 %ipm0, 57
      %ipm1 = and i64 %b, 576460752303423488
      %ips1 = lshr i64 %ipm1, 51
      %ipo1 = or i64 %ips0, %ips1
      %ipm2 = and i64 %b, 562949953421312
      %ips2 = lshr i64 %ipm2, 48
      %ipo2 = or i64 %ipo1, %ips2
      %ipm3 = and i64 %b, 2305843009213693952
      %ips3 = lshr i64 %ipm3, 45
      %ipo3 = or i64 %ipo2, %ips3
      %ipm4 = and i64 %b, 2251799813685248
      %ips4 = lshr i64 %ipm4, 42
      %ipo4 = or i64 %ipo3, %ips4
      %ipm5 = and i64 %b, -9223369837831520256
      %ips5 = lshr i64 %ipm5, 39
      %ipo5 = or i64 %ipo4, %ips5
      %ipm6 = and i64 %b, 9007199254740992
      %ips6 = lshr i64 %ipm6, 36
      %ipo6 = or i64 %ipo5, %ips6
      %ipm7 = and i64 %b, 8796093022208
      %ips7 = lshr i64 %ipm7, 33
      %ipo7 = or i64 %ipo6, %ips7
      %ipm8 = and i64 %b, 36028805608898560
      %ips8 = lshr i64 %ipm8, 30
      %ipo8 = or i64 %ipo7, %ips8
      %ipm9 = and i64 %b, 35184372088832
      %ips9 = lshr i64 %ipm9, 27
      %ipo9 = or i64 %ipo8, %ips9
      %ipm10 = and i64 %b, 72057628397666304
      %ips10 = lshr i64 %ipm10, 24
      %ipo10 = or i64 %ipo9, %ips10
      %ipm11 = and i64 %b, 140737521909760
      %ips11 = lshr i64 %ipm11, 21
      %ipo11 = or i64 %ipo10, %ips11
      %ipm12 = and i64 %b, 288230513590665216
      %ips12 = lshr i64 %ipm12, 18
      %ipo12 = or i64 %ipo11, %ips12
      %ipm13 = and i64 %b, 281475110928384
      %ips13 = lshr i64 %ipm13, 15
      %ipo13 = or i64 %ipo12, %ips13
      %ipm14 = and i64 %b, 1152922054362791936
      %ips14 = lshr i64 %ipm14, 12
      %ipo14 = or i64 %ipo13, %ips14
      %ipm15 = and i64 %b, 1125900443713536
      %ips15 = lshr i64 %ipm15, 9
      %ipo15 = or i64 %ipo14, %ips15
      %ipm16 = and i64 %b, 4611687117939539968
      %ips16 = lshr i64 %ipm16, 6
      %ipo16 = or i64 %ipo15, %ips16
      %ipm17 = and i64 %b, 4503601774854656
      %ips17 = lshr i64 %ipm17, 3
      %ipo17 = or i64 %ipo16, %ips17
      %ipm18 = and i64 %b, 4398048608256
      %ipo18 = or i64 %ipo17, %ipm18
      %ipm19 = and i64 %b, 18014402804451328
      %ips19 = shl i64 %ipm19, 3
      %ipo19 = or i64 %ipo18, %ips19
      %ipm20 = and i64 %b, 17592194433026
      %ips20 = shl i64 %ipm20, 6
      %ipo20 = or i64 %ipo19, %ips20
      %ipm21 = and i64 %b, 17179877376
      %ips21 = shl i64 %ipm21, 9
      %ipo21 = or i64 %ipo20, %ips21
      %ipm22 = and i64 %b, 70368760954888
      %ips22 = shl i64 %ipm22, 12
      %ipo22 = or i64 %ipo21, %ips22
      %ipm23 = and i64 %b, 68719509504
      %ips23 = shl i64 %ipm23, 15
      %ipo23 = or i64 %ipo22, %ips23
      %ipm24 = and i64 %b, 67108896
      %ips24 = shl i64 %ipm24, 18
      %ipo24 = or i64 %ipo23, %ips24
      %ipm25 = and i64 %b, 274877972480
      %ips25 = shl i64 %ipm25, 21
      %ipo25 = or i64 %ipo24, %ips25
      %ipm26 = and i64 %b, 268435584
      %ips26 = shl i64 %ipm26, 24
      %ipo26 = or i64 %ipo25, %ips26
      %ipm27 = and i64 %b, 262144
      %ips27 = shl i64 %ipm27, 27
      %ipo27 = or i64 %ipo26, %ips27
      %ipm28 = and i64 %b, 1073742080
      %ips28 = shl i64 %ipm28, 30
      %ipo28 = or i64 %ipo27, %ips28
      %ipm29 = and i64 %b, 1048576
      %ips29 = shl i64 %ipm29, 33
      %ipo29 = or i64 %ipo28, %ips29
      %ipm30 = and i64 %b, 1024
      %ips30 = shl i64 %ipm30, 36
      %ipo30 = or i64 %ipo29, %ips30
      %ipm31 = and i64 %b, 4194305
      %ips31 = shl i64 %ipm31, 39
      %ipo31 = or i64 %ipo30, %ips31
      %ipm32 = and i64 %b, 4096
      %ips32 = shl i64 %ipm32, 42
      %ipo32 = or i64 %ipo31, %ips32
      %ipm33 = and i64 %b, 4
      %ips33 = shl i64 %ipm33, 45
      %ipo33 = or i64 %ipo32, %ips33
      %ipm34 = and i64 %b, 16384
      %ips34 = shl i64 %ipm34, 48
