      %r0j2p = getelementptr i8, ptr %sp, i64 %r0j2off
      %r0j2e = load i32, ptr %r0j2p, align 1
      %r0j3rot = call i32 @llvm.fshl.i32(i32 %r0, i32 %r0, i32 11)
      %r0j3w = lshr i32 %r0j3rot, 26
      %r0j3k8 = extractelement <8 x i8> %kv0, i64 3
      %r0j3k = zext i8 %r0j3k8 to i32
      %r0j3x = xor i32 %r0j3w, %r0j3k
      %r0j3x64 = zext i32 %r0j3x to i64
      %r0j3o = shl i64 %r0j3x64, 2
