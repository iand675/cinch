      %r0j7k = zext i8 %r0j7k8 to i32
      %r0j7x = xor i32 %r0j7w, %r0j7k
      %r0j7x64 = zext i32 %r0j7x to i64
      %r0j7o = shl i64 %r0j7x64, 2
