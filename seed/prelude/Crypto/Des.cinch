      %ipm35 = and i64 %b, 16
      %ips35 = shl i64 %ipm35, 51
      %ipo35 = or i64 %ipo34, %ips35
      %ipm36 = and i64 %b, 64
      %ips36 = shl i64 %ipm36, 57
      %ipo36 = or i64 %ipo35, %ips36
      %lh = lshr i64 %ipo36, 32
      %l0 = trunc i64 %lh to i32
      %r0 = trunc i64 %ipo36 to i32
      %sp = inttoptr i64 %0 to ptr
      %kb = inttoptr i64 %1 to ptr
      %ka0 = getelementptr i8, ptr %kb, i64 0
      %kv0 = load <8 x i8>, ptr %ka0, align 1
      %r0j0rot = call i32 @llvm.fshl.i32(i32 %r0, i32 %r0, i32 31)
      %r0j0w = lshr i32 %r0j0rot, 26
      %r0j0k8 = extractelement <8 x i8> %kv0, i64 0
      %r0j0k = zext i8 %r0j0k8 to i32
      %r0j0x = xor i32 %r0j0w, %r0j0k
