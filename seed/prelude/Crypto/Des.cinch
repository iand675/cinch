      %r0j7p = getelementptr i8, ptr %sp, i64 %r0j7off
      %r0j7e = load i32, ptr %r0j7p, align 1
      %r0f1 = xor i32 %r0j0e, %r0j1e
      %r0f2 = xor i32 %r0f1, %r0j2e
      %r0f3 = xor i32 %r0f2, %r0j3e
      %r0f4 = xor i32 %r0f3, %r0j4e
      %r0f5 = xor i32 %r0f4, %r0j5e
      %r0f6 = xor i32 %r0f5, %r0j6e
      %r0f7 = xor i32 %r0f6, %r0j7e
      %r0n = xor i32 %l0, %r0f7
      %ka1 = getelementptr i8, ptr %kb, i64 8
      %kv1 = load <8 x i8>, ptr %ka1, align 1
      %r1j0rot = call i32 @llvm.fshl.i32(i32 %r0n, i32 %r0n, i32 31)
      %r1j0w = lshr i32 %r1j0rot, 26
      %r1j0k8 = extractelement <8 x i8> %kv1, i64 0
      %r1j0k = zext i8 %r1j0k8 to i32
      %r1j0x = xor i32 %r1j0w, %r1j0k
      %r1j0x64 = zext i32 %r1j0x to i64
