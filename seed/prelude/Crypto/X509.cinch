  export Certificate, cert-version, cert-serial-number, cert-signature-algorithm, cert-issuer, cert-subject, cert-not-before, cert-not-after, cert-public-key, cert-raw-tbs-certificate, cert-signature, cert-basic-constraints-valid, cert-is-ca, cert-max-path-len, cert-key-usage, cert-ext-key-usage, cert-dns-names, cert-email-addresses, cert-ip-addresses, cert-uris, cert-subject-key-id, cert-authority-key-id, cert-permitted-dns-domains, cert-excluded-dns-domains, cert-permitted-ip-ranges, cert-excluded-ip-ranges, cert-extensions, cert-raw
