  export key-usage-none, key-usage-digital-signature, key-usage-content-commitment, key-usage-key-encipherment, key-usage-data-encipherment, key-usage-key-agreement, key-usage-cert-sign, key-usage-crl-sign, key-usage-encipher-only, key-usage-decipher-only, key-usage-has, key-usage-union
