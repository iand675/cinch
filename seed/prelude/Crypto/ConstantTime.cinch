-- | Branch-free scalar selection and byte operations with public-length traversal.
-- Byte equality returns early only for unequal lengths. Conditional copies visit
-- every destination byte for either selection value. Buffers must not be mutated
-- concurrently. Whole Bytes handles may alias exactly; partial raw-pointer aliases
-- are outside this interface. Data-independent instruction timing is a separate
-- processor/runtime capability and is not enabled by these operations.
module Crypto.ConstantTime where
  import Data.Bool
  import Data.Bytes
  import Data.Machine
  import Data.Nat
  import Data.Wide

  export ConstantTimeError, ConstantTimeLengthMismatch, ConstantTimeShortDestination
  export constant-byte-equal, constant-i32-equal, constant-less-or-equal, constant-select
  export constant-bytes-equal, constant-copy, xor-bytes

  -- | Public buffer dimensions cannot satisfy a complete operation.
  data ConstantTimeError where
    -- | Conditional copying requires equal destination and source lengths.
    ConstantTimeLengthMismatch :: Nat -> Nat -> ConstantTimeError
    -- | XOR must fit the complete shorter input before writing anything.
    ConstantTimeShortDestination :: Nat -> Nat -> ConstantTimeError

  -- | Compare two bytes without branching on their contents.
  constant-byte-equal :: U8 -> U8 -> Bool
  constant-byte-equal left right = eq-u8 left right

  -- | Compare signed 32-bit words without a content-dependent branch.
  constant-i32-equal :: I32 -> I32 -> Bool
  constant-i32-equal left right = eq-i32 left right

  -- | Compare nonnegative 31-bit values; invalid mathematical inputs are excluded by their types.
  constant-less-or-equal :: InRange 0 2147483647 I64 -> InRange 0 2147483647 I64 -> Bool
  constant-less-or-equal left right = le-i64 left right

  -- | Expand a Boolean selection flag into an all-ones or all-zeros signed 64-bit mask.
  bool-mask-i64 :: Bool -> I64
  bool-mask-i64 selected = if selected then (-1 :: I64) else (0 :: I64)

  -- | Expand a Boolean selection flag into an all-ones or all-zeros 128-bit mask.
  bool-mask-u128 :: Bool -> U128
  bool-mask-u128 selected = if selected then max-bound-u128 else (0 :: U128)

  -- | Expand a Boolean selection flag into an all-ones or all-zeros 64-bit mask.
  bool-mask-u64 :: Bool -> U64
  bool-mask-u64 selected = if selected then max-bound-u64 else (0 :: U64)

  -- | Expand a Boolean selection flag into an all-ones or all-zeros byte mask.
  bool-mask-u8 :: Bool -> U8
  bool-mask-u8 selected = if selected then max-bound-u8 else (0 :: U8)

  -- | Select the first word for True and the second for False without branching on the flag.
  constant-select :: Bool -> I64 -> I64 -> I64
  constant-select selected left right =
    let mask = bool-mask-i64 selected in
    bit-or-i64 (bit-and-i64 left mask) (bit-and-i64 right (bit-not-i64 mask))

  -- | Compare equal-length buffers using complete 16-byte blocks and an exact scalar tail.
  -- Every byte is read even when an earlier byte differs; lengths are public.
  constant-bytes-equal :: Bytes -> Bytes -> Bool
  constant-bytes-equal left right =
    let size = bytes-len left in
    if size /= bytes-len right then False
    else eq-u128 (compare-blocks left right size 0 (0 :: U128)) (0 :: U128)

  -- | Conditionally copy a complete source, preserving the destination for False.
  -- A length mismatch is returned before any byte is written.
  constant-copy :: Bool -> Bytes -> Bytes -> Result ConstantTimeError Unit
  constant-copy selected destination source =
    let size = bytes-len destination in
    if size /= bytes-len source then
      Err (ConstantTimeLengthMismatch size (bytes-len source))
    else
      let mask128 = bool-mask-u128 selected in
      let mask64 = bool-mask-u64 selected in
      let mask8 = bool-mask-u8 selected in
      let copied = copy-blocks mask128 mask64 mask8 destination source size 0 in
      Ok copied

  -- | XOR the shorter input into the destination, returning the complete written length.
  -- A short destination is returned before any write; untouched trailing bytes remain unchanged.
  xor-bytes :: Bytes -> Bytes -> Bytes -> Result ConstantTimeError Nat
  xor-bytes destination left right =
    if bytes-len left <= bytes-len right then
      let count = bytes-len left in
      if bytes-len destination < count then Err (ConstantTimeShortDestination count (bytes-len destination))
      else let written = xor-blocks destination left right count 0 in Ok count
    else
      let count = bytes-len right in
      if bytes-len destination < count then Err (ConstantTimeShortDestination count (bytes-len destination))
      else let written = xor-blocks destination left right count 0 in Ok count

  -- | Select a full packed word with a bitmask, independent of the selected contents.
  select-word :: U64 -> U64 -> U64 -> U64
  select-word mask left right =
    bit-or-u64 (bit-and-u64 left mask) (bit-and-u64 right (bit-not-u64 mask))

  -- | Select one final byte with a bitmask, independent of the selected contents.
  select-byte :: U8 -> U8 -> U8 -> U8
  select-byte mask left right =
    bit-or-u8 (bit-and-u8 left mask) (bit-and-u8 right (bit-not-u8 mask))

  -- | Accumulate XOR differences across all complete 16-byte blocks without inspecting contents.
  compare-blocks :: using (size <= bytes-len left, size <= bytes-len right) => (left :: Bytes) -> (right :: Bytes) -> (size :: Nat) -> Nat -> U128 -> U128
  compare-blocks left right size position acc =
    let next = position + 16 in
    if next <= size then
      let a = bytes-load-u128 left position in
      let b = bytes-load-u128 right position in
      compare-blocks left right size next (bit-or-u128 acc (bit-xor-u128 a b))
    else if position <= size then compare-tail left right (nat-to-i64 position) acc else acc

  -- | Accumulate XOR differences across each remaining byte after the final complete 16-byte block.
  compare-tail :: Bytes -> Bytes -> I64 -> U128 -> U128
  compare-tail left right position acc =
    if 0 <= position && position < bytes-len-i64 left && position < bytes-len-i64 right then
      let a = bytes-get-u8-at left position in
      let b = bytes-get-u8-at right position in
      compare-tail left right (wrapping-add-i64 position 1) (bit-or-u128 acc (u8-to-u128 (bit-xor-u8 a b)))
    else acc

  -- | Conditionally copy complete 16-byte blocks with a precomputed wide selection mask.
  copy-blocks :: using (size <= bytes-len destination, size <= bytes-len source) => U128 -> U64 -> U8 -> (destination :: Bytes) -> (source :: Bytes) -> (size :: Nat) -> Nat -> Unit
  copy-blocks mask128 mask64 mask8 destination source size position =
    let next = position + 16 in
    if next <= size then
      let old = bytes-load-u128 destination position in
      let incoming = bytes-load-u128 source position in
      let written = bytes-store-u128 destination position (simd-bitselect mask128 incoming old) in
      copy-blocks mask128 mask64 mask8 destination source size next
    else copy-words mask64 mask8 destination source size position

  -- | Conditionally copy one trailing 8-byte word when present, then finish the byte tail.
  copy-words :: using (size <= bytes-len destination, size <= bytes-len source) => U64 -> U8 -> (destination :: Bytes) -> (source :: Bytes) -> (size :: Nat) -> Nat -> Unit
  copy-words mask64 mask8 destination source size position =
    let next = position + 8 in
    if next <= size then
      let old = bytes-load-le64 destination position in
      let incoming = bytes-load-le64 source position in
      let written = bytes-store-le64 destination position (select-word mask64 incoming old) in
      copy-tail mask8 destination source (nat-to-i64 next)
    else if position <= size then copy-tail mask8 destination source (nat-to-i64 position) else ()

  -- | Conditionally copy each remaining tail byte with a precomputed byte selection mask.
  copy-tail :: U8 -> Bytes -> Bytes -> I64 -> Unit
  copy-tail mask8 destination source position =
    if 0 <= position && position < bytes-len-i64 destination && position < bytes-len-i64 source then
      let old = bytes-get-u8-at destination position in
      let incoming = bytes-get-u8-at source position in
      let written = bytes-set-u8-at destination position (select-byte mask8 incoming old) in
      copy-tail mask8 destination source (wrapping-add-i64 position 1)
    else ()

  -- | Read both 16-byte source blocks before writing, preserving exact in-place aliases.
  xor-blocks :: using (count <= bytes-len destination, count <= bytes-len left, count <= bytes-len right) => (destination :: Bytes) -> (left :: Bytes) -> (right :: Bytes) -> (count :: Nat) -> Nat -> Unit
  xor-blocks destination left right count position =
    let next = position + 16 in
    if next <= count then
      let a = bytes-load-u128 left position in
      let b = bytes-load-u128 right position in
      let written = bytes-store-u128 destination position (bit-xor-u128 a b) in
      xor-blocks destination left right count next
    else xor-words destination left right count position

  -- | Read one trailing 8-byte word from both sources before writing, then finish the byte tail.
  xor-words :: using (count <= bytes-len destination, count <= bytes-len left, count <= bytes-len right) => (destination :: Bytes) -> (left :: Bytes) -> (right :: Bytes) -> (count :: Nat) -> Nat -> Unit
  xor-words destination left right count position =
    let next = position + 8 in
    if next <= count then
      let a = bytes-load-le64 left position in
      let b = bytes-load-le64 right position in
      let written = bytes-store-le64 destination position (bit-xor-u64 a b) in
      xor-tail destination left right (nat-to-i64 count) (nat-to-i64 next)
    else if position <= count then xor-tail destination left right (nat-to-i64 count) (nat-to-i64 position) else ()

  -- | Read each remaining tail byte from both sources before writing into the destination.
  xor-tail :: using (limit <= bytes-len-i64 destination, limit <= bytes-len-i64 left, limit <= bytes-len-i64 right) => (destination :: Bytes) -> (left :: Bytes) -> (right :: Bytes) -> (limit :: I64) -> I64 -> Unit
  xor-tail destination left right limit position =
    if 0 <= position && position < limit then
      let a = bytes-get-u8-at left position in
      let b = bytes-get-u8-at right position in
      let written = bytes-set-u8-at destination position (bit-xor-u8 a b) in
      xor-tail destination left right limit (wrapping-add-i64 position 1)
    else ()
