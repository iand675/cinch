      %v24 = sub <8 x i32> %v22, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v25 = select <8 x i1> %v23, <8 x i32> %v24, <8 x i32> %v22
      %v26 = add <8 x i32> %v21, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v27 = sub <8 x i32> %v26, %v20
      %v28 = icmp uge <8 x i32> %v27, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v29 = sub <8 x i32> %v27, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v30 = select <8 x i1> %v28, <8 x i32> %v29, <8 x i32> %v27
      %v31 = mul <8 x i32> %v30, %v19
      %v32 = urem <8 x i32> %v31, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v33 = shufflevector <8 x i32> %v25, <8 x i32> %v32, <8 x i32> <i32 0, i32 1, i32 10, i32 11, i32 4, i32 5, i32 14, i32 15>
      %v34 = trunc <8 x i32> %v33 to <8 x i16>
      %v35 = shufflevector <8 x i16> %v34, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v36 = bitcast <8 x i16> %v35 to i128
      ret i128 %v36
    } when endian big

  -- | acc + a * b for four degree-one products modulo X^2 - gamma (FIPS 203 Algorithm 12).
  prim basemul-add :: U128 -> U128 -> U128 -> I64 -> I64 -> I64 -> I64 -> U128 where
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = zext <8 x i16> %v1 to <8 x i32>
      %v3 = bitcast i128 %1 to <8 x i16>
      %v4 = zext <8 x i16> %v3 to <8 x i32>
      %v5 = bitcast i128 %2 to <8 x i16>
      %v6 = zext <8 x i16> %v5 to <8 x i32>
      %v7 = mul <8 x i32> %v4, %v6
      %v8 = shufflevector <8 x i32> %v6, <8 x i32> %v6, <8 x i32> <i32 1, i32 0, i32 3, i32 2, i32 5, i32 4, i32 7, i32 6>
      %v9 = mul <8 x i32> %v4, %v8
      %v10 = shufflevector <8 x i32> %v7, <8 x i32> %v7, <8 x i32> <i32 1, i32 1, i32 3, i32 3, i32 5, i32 5, i32 7, i32 7>
      %v11 = urem <8 x i32> %v10, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v12 = trunc i64 %3 to i32
      %v13 = insertelement <8 x i32> poison, i32 %v12, i64 0
      %v14 = trunc i64 %3 to i32
      %v15 = insertelement <8 x i32> %v13, i32 %v14, i64 1
      %v16 = trunc i64 %4 to i32
      %v17 = insertelement <8 x i32> %v15, i32 %v16, i64 2
      %v18 = trunc i64 %4 to i32
      %v19 = insertelement <8 x i32> %v17, i32 %v18, i64 3
      %v20 = trunc i64 %5 to i32
      %v21 = insertelement <8 x i32> %v19, i32 %v20, i64 4
      %v22 = trunc i64 %5 to i32
      %v23 = insertelement <8 x i32> %v21, i32 %v22, i64 5
      %v24 = trunc i64 %6 to i32
      %v25 = insertelement <8 x i32> %v23, i32 %v24, i64 6
      %v26 = trunc i64 %6 to i32
      %v27 = insertelement <8 x i32> %v25, i32 %v26, i64 7
      %v28 = mul <8 x i32> %v11, %v27
      %v29 = add <8 x i32> %v7, %v28
      %v30 = shufflevector <8 x i32> %v9, <8 x i32> %v9, <8 x i32> <i32 1, i32 0, i32 3, i32 2, i32 5, i32 4, i32 7, i32 6>
      %v31 = add <8 x i32> %v9, %v30
      %v32 = select <8 x i1> <i1 true, i1 false, i1 true, i1 false, i1 true, i1 false, i1 true, i1 false>, <8 x i32> %v29, <8 x i32> %v31
      %v33 = urem <8 x i32> %v32, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v34 = add <8 x i32> %v2, %v33
      %v35 = icmp uge <8 x i32> %v34, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v36 = sub <8 x i32> %v34, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v37 = select <8 x i1> %v35, <8 x i32> %v36, <8 x i32> %v34
      %v38 = trunc <8 x i32> %v37 to <8 x i16>
      %v39 = bitcast <8 x i16> %v38 to i128
      ret i128 %v39
    } when endian little
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = shufflevector <8 x i16> %v1, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = zext <8 x i16> %v2 to <8 x i32>
      %v4 = bitcast i128 %1 to <8 x i16>
      %v5 = shufflevector <8 x i16> %v4, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v6 = zext <8 x i16> %v5 to <8 x i32>
      %v7 = bitcast i128 %2 to <8 x i16>
      %v8 = shufflevector <8 x i16> %v7, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v9 = zext <8 x i16> %v8 to <8 x i32>
      %v10 = mul <8 x i32> %v6, %v9
      %v11 = shufflevector <8 x i32> %v9, <8 x i32> %v9, <8 x i32> <i32 1, i32 0, i32 3, i32 2, i32 5, i32 4, i32 7, i32 6>
      %v12 = mul <8 x i32> %v6, %v11
      %v13 = shufflevector <8 x i32> %v10, <8 x i32> %v10, <8 x i32> <i32 1, i32 1, i32 3, i32 3, i32 5, i32 5, i32 7, i32 7>
      %v14 = urem <8 x i32> %v13, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v15 = trunc i64 %3 to i32
      %v16 = insertelement <8 x i32> poison, i32 %v15, i64 0
      %v17 = trunc i64 %3 to i32
      %v18 = insertelement <8 x i32> %v16, i32 %v17, i64 1
      %v19 = trunc i64 %4 to i32
      %v20 = insertelement <8 x i32> %v18, i32 %v19, i64 2
      %v21 = trunc i64 %4 to i32
      %v22 = insertelement <8 x i32> %v20, i32 %v21, i64 3
      %v23 = trunc i64 %5 to i32
      %v24 = insertelement <8 x i32> %v22, i32 %v23, i64 4
      %v25 = trunc i64 %5 to i32
      %v26 = insertelement <8 x i32> %v24, i32 %v25, i64 5
      %v27 = trunc i64 %6 to i32
      %v28 = insertelement <8 x i32> %v26, i32 %v27, i64 6
      %v29 = trunc i64 %6 to i32
      %v30 = insertelement <8 x i32> %v28, i32 %v29, i64 7
      %v31 = mul <8 x i32> %v14, %v30
      %v32 = add <8 x i32> %v10, %v31
      %v33 = shufflevector <8 x i32> %v12, <8 x i32> %v12, <8 x i32> <i32 1, i32 0, i32 3, i32 2, i32 5, i32 4, i32 7, i32 6>
      %v34 = add <8 x i32> %v12, %v33
      %v35 = select <8 x i1> <i1 true, i1 false, i1 true, i1 false, i1 true, i1 false, i1 true, i1 false>, <8 x i32> %v32, <8 x i32> %v34
      %v36 = urem <8 x i32> %v35, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v37 = add <8 x i32> %v3, %v36
      %v38 = icmp uge <8 x i32> %v37, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v39 = sub <8 x i32> %v37, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v40 = select <8 x i1> %v38, <8 x i32> %v39, <8 x i32> %v37
      %v41 = trunc <8 x i32> %v40 to <8 x i16>
      %v42 = shufflevector <8 x i16> %v41, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v43 = bitcast <8 x i16> %v42 to i128
      ret i128 %v43
    } when endian big

  -- | One when every lane is below q, else zero.
  prim below-q :: U128 -> I64 where
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = zext <8 x i16> %v1 to <8 x i32>
      %v3 = icmp ult <8 x i32> %v2, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v4 = call i1 @llvm.vector.reduce.and.v8i1(<8 x i1> %v3)
      %v5 = zext i1 %v4 to i64
      ret i64 %v5
    } when endian little
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = shufflevector <8 x i16> %v1, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = zext <8 x i16> %v2 to <8 x i32>
      %v4 = icmp ult <8 x i32> %v3, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v5 = call i1 @llvm.vector.reduce.and.v8i1(<8 x i1> %v4)
      %v6 = zext i1 %v5 to i64
      ret i64 %v6
    } when endian big

  -- | Reduce lanes below 2q into [0, q).
  prim reduce-q :: U128 -> U128 where
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = zext <8 x i16> %v1 to <8 x i32>
      %v3 = icmp uge <8 x i32> %v2, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v4 = sub <8 x i32> %v2, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v5 = select <8 x i1> %v3, <8 x i32> %v4, <8 x i32> %v2
      %v6 = trunc <8 x i32> %v5 to <8 x i16>
      %v7 = bitcast <8 x i16> %v6 to i128
      ret i128 %v7
    } when endian little
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = shufflevector <8 x i16> %v1, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = zext <8 x i16> %v2 to <8 x i32>
      %v4 = icmp uge <8 x i32> %v3, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v5 = sub <8 x i32> %v3, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v6 = select <8 x i1> %v4, <8 x i32> %v5, <8 x i32> %v3
      %v7 = trunc <8 x i32> %v6 to <8 x i16>
      %v8 = shufflevector <8 x i16> %v7, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v9 = bitcast <8 x i16> %v8 to i128
      ret i128 %v9
    } when endian big

  -- | Pack eight 12-bit lanes into 96 bits (ByteEncode_12 of one lane).
  prim pack12 :: U128 -> U128 where
    llvm {
      %v1 = and i128 %0, 4095
      %v2 = lshr i128 %0, 16
      %v3 = and i128 %v2, 4095
      %v4 = lshr i128 %0, 32
      %v5 = and i128 %v4, 4095
      %v6 = lshr i128 %0, 48
      %v7 = and i128 %v6, 4095
      %v8 = lshr i128 %0, 64
      %v9 = and i128 %v8, 4095
      %v10 = lshr i128 %0, 80
      %v11 = and i128 %v10, 4095
      %v12 = lshr i128 %0, 96
      %v13 = and i128 %v12, 4095
      %v14 = lshr i128 %0, 112
      %v15 = and i128 %v14, 4095
      %v16 = shl i128 %v3, 12
      %v17 = or i128 %v1, %v16
      %v18 = shl i128 %v5, 24
      %v19 = or i128 %v17, %v18
      %v20 = shl i128 %v7, 36
      %v21 = or i128 %v19, %v20
      %v22 = shl i128 %v9, 48
      %v23 = or i128 %v21, %v22
      %v24 = shl i128 %v11, 60
      %v25 = or i128 %v23, %v24
      %v26 = shl i128 %v13, 72
      %v27 = or i128 %v25, %v26
      %v28 = shl i128 %v15, 84
      %v29 = or i128 %v27, %v28
      ret i128 %v29
    }

  -- | Unpack 96 bits into eight 12-bit lanes (ByteDecode_12 before reduction).
  prim unpack12 :: U128 -> U128 where
    llvm {
      %v1 = and i128 %0, 4095
      %v2 = lshr i128 %0, 12
      %v3 = and i128 %v2, 4095
      %v4 = lshr i128 %0, 24
      %v5 = and i128 %v4, 4095
      %v6 = lshr i128 %0, 36
      %v7 = and i128 %v6, 4095
      %v8 = lshr i128 %0, 48
      %v9 = and i128 %v8, 4095
      %v10 = lshr i128 %0, 60
      %v11 = and i128 %v10, 4095
      %v12 = lshr i128 %0, 72
      %v13 = and i128 %v12, 4095
      %v14 = lshr i128 %0, 84
      %v15 = and i128 %v14, 4095
      %v16 = shl i128 %v3, 16
      %v17 = or i128 %v1, %v16
      %v18 = shl i128 %v5, 32
      %v19 = or i128 %v17, %v18
      %v20 = shl i128 %v7, 48
      %v21 = or i128 %v19, %v20
      %v22 = shl i128 %v9, 64
      %v23 = or i128 %v21, %v22
      %v24 = shl i128 %v11, 80
      %v25 = or i128 %v23, %v24
      %v26 = shl i128 %v13, 96
      %v27 = or i128 %v25, %v26
      %v28 = shl i128 %v15, 112
      %v29 = or i128 %v27, %v28
      ret i128 %v29
    }

  -- | Decompress_1 of eight message bits: each bit becomes 0 or 1665.
  prim message-lane :: I64 -> U128 where
    llvm {
      %v1 = zext i64 %0 to i128
      %v2 = and i128 %v1, 1
      %v3 = mul i128 %v2, 1665
      %v4 = lshr i128 %v1, 1
      %v5 = and i128 %v4, 1
      %v6 = mul i128 %v5, 1665
      %v7 = lshr i128 %v1, 2
      %v8 = and i128 %v7, 1
      %v9 = mul i128 %v8, 1665
      %v10 = lshr i128 %v1, 3
      %v11 = and i128 %v10, 1
      %v12 = mul i128 %v11, 1665
      %v13 = lshr i128 %v1, 4
      %v14 = and i128 %v13, 1
      %v15 = mul i128 %v14, 1665
      %v16 = lshr i128 %v1, 5
      %v17 = and i128 %v16, 1
      %v18 = mul i128 %v17, 1665
      %v19 = lshr i128 %v1, 6
      %v20 = and i128 %v19, 1
      %v21 = mul i128 %v20, 1665
      %v22 = lshr i128 %v1, 7
      %v23 = and i128 %v22, 1
      %v24 = mul i128 %v23, 1665
      %v25 = shl i128 %v6, 16
      %v26 = or i128 %v3, %v25
      %v27 = shl i128 %v9, 32
      %v28 = or i128 %v26, %v27
      %v29 = shl i128 %v12, 48
      %v30 = or i128 %v28, %v29
      %v31 = shl i128 %v15, 64
      %v32 = or i128 %v30, %v31
      %v33 = shl i128 %v18, 80
      %v34 = or i128 %v32, %v33
      %v35 = shl i128 %v21, 96
      %v36 = or i128 %v34, %v35
      %v37 = shl i128 %v24, 112
      %v38 = or i128 %v36, %v37
      ret i128 %v38
    }

  -- | Eight centered binomial coefficients (eta = 2) from 32 bits, modulo q.
  prim cbd2 :: I64 -> U128 where
    llvm {
      %v1 = zext i64 %0 to i128
      %v2 = and i128 %v1, 1431655765
      %v3 = lshr i128 %v1, 1
      %v4 = and i128 %v3, 1431655765
      %v5 = add i128 %v2, %v4
      %v6 = and i128 %v5, 3
      %v7 = lshr i128 %v5, 2
      %v8 = and i128 %v7, 3
      %v9 = add i128 %v6, 3329
      %v10 = sub i128 %v9, %v8
      %v11 = icmp uge i128 %v10, 3329
      %v12 = sub i128 %v10, 3329
      %v13 = select i1 %v11, i128 %v12, i128 %v10
      %v14 = lshr i128 %v5, 4
      %v15 = and i128 %v14, 3
      %v16 = lshr i128 %v5, 6
      %v17 = and i128 %v16, 3
      %v18 = add i128 %v15, 3329
      %v19 = sub i128 %v18, %v17
      %v20 = icmp uge i128 %v19, 3329
      %v21 = sub i128 %v19, 3329
      %v22 = select i1 %v20, i128 %v21, i128 %v19
      %v23 = lshr i128 %v5, 8
      %v24 = and i128 %v23, 3
      %v25 = lshr i128 %v5, 10
      %v26 = and i128 %v25, 3
      %v27 = add i128 %v24, 3329
      %v28 = sub i128 %v27, %v26
      %v29 = icmp uge i128 %v28, 3329
      %v30 = sub i128 %v28, 3329
      %v31 = select i1 %v29, i128 %v30, i128 %v28
      %v32 = lshr i128 %v5, 12
      %v33 = and i128 %v32, 3
      %v34 = lshr i128 %v5, 14
      %v35 = and i128 %v34, 3
      %v36 = add i128 %v33, 3329
      %v37 = sub i128 %v36, %v35
      %v38 = icmp uge i128 %v37, 3329
      %v39 = sub i128 %v37, 3329
      %v40 = select i1 %v38, i128 %v39, i128 %v37
      %v41 = lshr i128 %v5, 16
      %v42 = and i128 %v41, 3
      %v43 = lshr i128 %v5, 18
      %v44 = and i128 %v43, 3
      %v45 = add i128 %v42, 3329
      %v46 = sub i128 %v45, %v44
      %v47 = icmp uge i128 %v46, 3329
      %v48 = sub i128 %v46, 3329
      %v49 = select i1 %v47, i128 %v48, i128 %v46
      %v50 = lshr i128 %v5, 20
      %v51 = and i128 %v50, 3
      %v52 = lshr i128 %v5, 22
      %v53 = and i128 %v52, 3
      %v54 = add i128 %v51, 3329
      %v55 = sub i128 %v54, %v53
      %v56 = icmp uge i128 %v55, 3329
      %v57 = sub i128 %v55, 3329
      %v58 = select i1 %v56, i128 %v57, i128 %v55
      %v59 = lshr i128 %v5, 24
      %v60 = and i128 %v59, 3
      %v61 = lshr i128 %v5, 26
      %v62 = and i128 %v61, 3
      %v63 = add i128 %v60, 3329
      %v64 = sub i128 %v63, %v62
      %v65 = icmp uge i128 %v64, 3329
      %v66 = sub i128 %v64, 3329
      %v67 = select i1 %v65, i128 %v66, i128 %v64
      %v68 = lshr i128 %v5, 28
      %v69 = and i128 %v68, 3
      %v70 = lshr i128 %v5, 30
      %v71 = and i128 %v70, 3
      %v72 = add i128 %v69, 3329
      %v73 = sub i128 %v72, %v71
      %v74 = icmp uge i128 %v73, 3329
      %v75 = sub i128 %v73, 3329
      %v76 = select i1 %v74, i128 %v75, i128 %v73
      %v77 = shl i128 %v22, 16
      %v78 = or i128 %v13, %v77
      %v79 = shl i128 %v31, 32
      %v80 = or i128 %v78, %v79
      %v81 = shl i128 %v40, 48
      %v82 = or i128 %v80, %v81
      %v83 = shl i128 %v49, 64
      %v84 = or i128 %v82, %v83
      %v85 = shl i128 %v58, 80
      %v86 = or i128 %v84, %v85
      %v87 = shl i128 %v67, 96
      %v88 = or i128 %v86, %v87
      %v89 = shl i128 %v76, 112
      %v90 = or i128 %v88, %v89
      ret i128 %v90
    }

  -- | A U128 from its low and high halves.
  prim join64 :: U64 -> U64 -> U128 where
    llvm {
      %v1 = zext i64 %0 to i128
      %v2 = zext i64 %1 to i128
      %v3 = shl i128 %v2, 64
      %v4 = or i128 %v1, %v3
      ret i128 %v4
    }

  -- | The low half of a U128.
  prim low64 :: U128 -> U64 where
    llvm {
      %v1 = trunc i128 %0 to i64
      ret i64 %v1
    }

  -- | The high half of a U128.
  prim high64 :: U128 -> U64 where
    llvm {
      %v1 = lshr i128 %0, 64
      %v2 = trunc i128 %v1 to i64
      ret i64 %v2
    }

