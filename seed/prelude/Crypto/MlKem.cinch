-- | ML-KEM (FIPS 203), the module-lattice key-encapsulation mechanism, with the ML-KEM-768 and ML-KEM-1024 parameter sets.
-- A decapsulation key is derived from a 64-byte seed and kept as that seed (its
-- byte form here); the encapsulation key is its public half. Encapsulation
-- turns 32 bytes of fresh randomness into a 32-byte shared key and a
-- ciphertext; decapsulation recovers the key, and a ciphertext that does not
-- re-encrypt to itself yields a pseudorandom rejection key instead, selected
-- in constant time. Encapsulation keys from outside are checked for
-- coefficients outside the field. Polynomials are immutable values of
-- thirty-two 128-bit lanes of eight coefficients; transforms, products,
-- compression and sampling run as generated branch-free lane kernels with
-- exact arithmetic modulo q = 3329. Effect.Crypto draws seeds and randomness
-- from the operating system.
module Crypto.MlKem where

  import Crypto.ConstantTime
  import Data.Bytes
  import Data.Bytes.Build
  import Data.Bytes.Word
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Result
  import Data.String
  import Text.Sha3
  import Text.Show (nat-to-string)

  export MlKemParameters, MlKem768, MlKem1024, mlkem-shared-key-size, mlkem-seed-size, mlkem-encapsulation-key-size, mlkem-ciphertext-size
  export MlKemError, MlKemInvalidSeedSize, MlKemInvalidEncapsulationKey, MlKemInvalidCiphertextSize, MlKemInvalidRandomnessSize, mlkem-error-message
  export MlKemDecapsulationKey, mlkem-decapsulation-key, mlkem-decapsulation-key-bytes, mlkem-decapsulation-key-parameters, mlkem-encapsulation-key-of
  export MlKemEncapsulationKey, mlkem-encapsulation-key, mlkem-encapsulation-key-bytes, mlkem-encapsulation-key-parameters
  export mlkem-encapsulate-with, mlkem-decapsulate

  -- ---------------------------------------------------------------------
  -- Parameters and errors.
  -- ---------------------------------------------------------------------

  -- | An ML-KEM parameter set.
  data MlKemParameters where
    -- | k = 3, du = 10, dv = 4 (security category 3).
    MlKem768 :: MlKemParameters
    -- | k = 4, du = 11, dv = 5 (security category 5).
    MlKem1024 :: MlKemParameters

  -- | The module rank k.
  rank :: MlKemParameters -> Nat
  rank p = case p of MlKem768 -> 3; MlKem1024 -> 4

  -- | Bits per compressed coefficient of u.
  du :: MlKemParameters -> Nat
  du p = case p of MlKem768 -> 10; MlKem1024 -> 11

  -- | Bits per compressed coefficient of v.
  dv :: MlKemParameters -> Nat
  dv p = case p of MlKem768 -> 4; MlKem1024 -> 5

  -- | Shared keys are 32 bytes.
  mlkem-shared-key-size :: Nat
  mlkem-shared-key-size = 32

  -- | Decapsulation-key seeds are 64 bytes (d then z).
  mlkem-seed-size :: Nat
  mlkem-seed-size = 64

  -- | Encapsulation-key bytes: 1184 for ML-KEM-768 and 1568 for ML-KEM-1024.
  mlkem-encapsulation-key-size :: MlKemParameters -> Nat
  mlkem-encapsulation-key-size p = 384 * rank p + 32

  -- | Ciphertext bytes: 1088 for ML-KEM-768 and 1568 for ML-KEM-1024.
  mlkem-ciphertext-size :: MlKemParameters -> Nat
  mlkem-ciphertext-size p = 32 * (du p * rank p + dv p)

  -- | A rejected input.
  data MlKemError where
    -- | Seeds are 64 bytes; the length given.
    MlKemInvalidSeedSize :: Nat -> MlKemError
    -- | An encapsulation key of the wrong length or with a coefficient of at least q.
    MlKemInvalidEncapsulationKey :: MlKemError
    -- | A ciphertext of the wrong length; the length given.
    MlKemInvalidCiphertextSize :: Nat -> MlKemError
    -- | Encapsulation randomness is 32 bytes; the length given.
    MlKemInvalidRandomnessSize :: Nat -> MlKemError

  -- | Render an error.
  mlkem-error-message :: MlKemError -> String
  mlkem-error-message error = case error of
    MlKemInvalidSeedSize n -> string-concat "mlkem: invalid seed length " (nat-to-string n)
    MlKemInvalidEncapsulationKey -> "mlkem: invalid encapsulation key"
    MlKemInvalidCiphertextSize n -> string-concat "mlkem: invalid ciphertext length " (nat-to-string n)
    MlKemInvalidRandomnessSize n -> string-concat "mlkem: invalid randomness length " (nat-to-string n)

  -- ---------------------------------------------------------------------
  -- Keys.
  -- ---------------------------------------------------------------------

  -- | An encapsulation key: parameters, its bytes, t-hat, the matrix A-hat (rows of k), and H of the bytes.
  data MlKemEncapsulationKey where
    -- | Fields in the order listed above.
    MlKemEncapsulationKey :: MlKemParameters -> Bytes -> List Poly -> List (List Poly) -> Bytes -> MlKemEncapsulationKey

  -- | A decapsulation key: its seed, s-hat, its encapsulation key and the rejection secret z.
  data MlKemDecapsulationKey where
    -- | Fields in the order listed above.
    MlKemDecapsulationKey :: Bytes -> List Poly -> MlKemEncapsulationKey -> Bytes -> MlKemDecapsulationKey

  -- | The encapsulation key's parameter set.
  mlkem-encapsulation-key-parameters :: MlKemEncapsulationKey -> MlKemParameters
  mlkem-encapsulation-key-parameters ek = case ek of MlKemEncapsulationKey p b t a h -> p

  -- | The encapsulation key's bytes.
  mlkem-encapsulation-key-bytes :: MlKemEncapsulationKey -> Bytes
  mlkem-encapsulation-key-bytes ek = case ek of MlKemEncapsulationKey p b t a h -> copy b

  -- | The decapsulation key's 64-byte seed, from which it can be rebuilt.
  mlkem-decapsulation-key-bytes :: MlKemDecapsulationKey -> Bytes
  mlkem-decapsulation-key-bytes dk = case dk of MlKemDecapsulationKey seed s ek z -> copy seed

  -- | The decapsulation key's parameter set.
  mlkem-decapsulation-key-parameters :: MlKemDecapsulationKey -> MlKemParameters
  mlkem-decapsulation-key-parameters dk = case dk of MlKemDecapsulationKey seed s ek z -> mlkem-encapsulation-key-parameters ek

  -- | The public encapsulation key of a decapsulation key.
  mlkem-encapsulation-key-of :: MlKemDecapsulationKey -> MlKemEncapsulationKey
  mlkem-encapsulation-key-of dk = case dk of MlKemDecapsulationKey seed s ek z -> ek

  -- | Derive a decapsulation key from a 64-byte seed d || z (FIPS 203 Algorithms 13 and 16).
  mlkem-decapsulation-key :: MlKemParameters -> Bytes -> Result MlKemError MlKemDecapsulationKey
  mlkem-decapsulation-key p seed =
    if not (bytes-len seed == 64) then Err (MlKemInvalidSeedSize (bytes-len seed))
    else
      let k = rank p in
      let expanded = sha3-sum512 (bytes-concat [slice seed 0 32, one k]) in
      let rho = slice expanded 0 32 in
      let sigma = slice expanded 32 64 in
      let a = matrix rho k in
      let s = map poly-ntt (noise sigma 0 k) in
      let e = map poly-ntt (noise sigma k k) in
      let t = map2 (row-product s) a e in
      let ek-bytes = bytes-concat [bytes-concat (map encode12 t), rho] in
      Ok (MlKemDecapsulationKey (copy seed) s (MlKemEncapsulationKey p ek-bytes t a (sha3-sum256 ek-bytes)) (slice seed 32 64))

  -- | Parse and check an encapsulation key: the right length, and every coefficient below q (FIPS 203 section 7.2).
  mlkem-encapsulation-key :: MlKemParameters -> Bytes -> Result MlKemError MlKemEncapsulationKey
  mlkem-encapsulation-key p b =
    if not (bytes-len b == mlkem-encapsulation-key-size p) then Err MlKemInvalidEncapsulationKey
    else
      let k = rank p in
      case decode12-all b 0 k Nil of
        None -> Err MlKemInvalidEncapsulationKey
        Some t ->
          let rho = slice b (384 * k) (bytes-len b) in
          Ok (MlKemEncapsulationKey p (copy b) t (matrix rho k) (sha3-sum256 b))

  -- | t-hat polynomials from the key bytes, or None when a coefficient is at least q.
  decode12-all :: Bytes -> Nat -> Nat -> List Poly -> Option (List Poly)
  decode12-all b i k acc =
    if i >= k then Some (reverse acc)
    else case decode12 b (384 * i) of
      None -> None
      Some poly -> decode12-all b (i + 1) k (Cons poly acc)

  -- | Row i of A-hat times s, plus e (all in the NTT domain).
  row-product :: List Poly -> List Poly -> Poly -> Poly
  row-product s row e = dot row s e

  -- | Accumulate the NTT-domain inner product of two vectors onto acc.
  dot :: List Poly -> List Poly -> Poly -> Poly
  dot xs ys acc = case xs of
    Nil -> acc
    Cons x rest -> case ys of Nil -> acc; Cons y others -> dot rest others (poly-basemul-add acc x y)

  -- | Pairwise application over two lists.
  map2 :: (List Poly -> Poly -> Poly) -> List (List Poly) -> List Poly -> List Poly
  map2 f rows es = case rows of
    Nil -> Nil
    Cons r rest -> case es of Nil -> Nil; Cons e more -> Cons (f r e) (map2 f rest more)

  -- | The matrix A-hat: entry (i, j) sampled from SHAKE128(rho || j || i).
  matrix :: Bytes -> Nat -> List (List Poly)
  matrix rho k = matrix-rows rho k 0

  -- | Rows from i.
  matrix-rows :: Bytes -> Nat -> Nat -> List (List Poly)
  matrix-rows rho k i = if i >= k then Nil else Cons (matrix-row rho k i 0) (matrix-rows rho k (i + 1))

  -- | Entries of row i from column j.
  matrix-row :: Bytes -> Nat -> Nat -> Nat -> List Poly
  matrix-row rho k i j = if j >= k then Nil else Cons (sample-ntt (bytes-concat [rho, one j, one i])) (matrix-row rho k i (j + 1))

  -- | The column vector A-hat-transpose row i: entries (j, i) for every j.
  column :: List (List Poly) -> Nat -> List Poly
  column a i = map (nth-poly i) a

  -- | The i-th polynomial of a row.
  nth-poly :: Nat -> List Poly -> Poly
  nth-poly i row = case row of Nil -> zero-poly; Cons x rest -> if i == 0 then x else nth-poly (i - 1) rest

  -- | Noise polynomials CBD_2(PRF(seed, n)) for n from start, count of them.
  noise :: Bytes -> Nat -> Nat -> List Poly
  noise seed start count = if count == 0 then Nil else Cons (cbd seed start) (noise seed (start + 1) (count - 1))

  -- | One noise polynomial: SHAKE256(seed || n) gives 128 bytes, four per lane.
  cbd :: Bytes -> Nat -> Poly
  cbd seed n =
    let stream = shake256-sum (bytes-concat [seed, one n]) 128 in
    poly-of-lanes (cbd-lanes stream 0)

  -- | Lanes from 32-bit words of the stream.
  cbd-lanes :: Bytes -> Nat -> List U128
  cbd-lanes stream v = if v >= 32 then Nil else Cons (cbd2 (word32 stream (4 * v))) (cbd-lanes stream (v + 1))

  -- ---------------------------------------------------------------------
  -- Encapsulation and decapsulation.
  -- ---------------------------------------------------------------------

  -- | Encapsulate with explicit 32-byte randomness m (FIPS 203 Algorithm 17): the shared key and the ciphertext.
  -- The randomness must be fresh and secret for each call; Effect.Crypto supplies it from the operating system.
  mlkem-encapsulate-with :: MlKemEncapsulationKey -> Bytes -> Result MlKemError (Bytes, Bytes)
  mlkem-encapsulate-with ek m =
    if not (bytes-len m == 32) then Err (MlKemInvalidRandomnessSize (bytes-len m))
    else case ek of
      MlKemEncapsulationKey p b t a h ->
        let g = sha3-sum512 (bytes-concat [m, h]) in
        Ok (slice g 0 32, encrypt ek m (slice g 32 64))

  -- | K-PKE encryption (FIPS 203 Algorithm 14).
  encrypt :: MlKemEncapsulationKey -> Bytes -> Bytes -> Bytes
  encrypt ek m r = case ek of
    MlKemEncapsulationKey p b t a h ->
      let k = rank p in
      let y = map poly-ntt (noise r 0 k) in
      let e1 = noise r k k in
      let e2 = cbd r (2 * k) in
      let u = encrypt-u a y e1 0 k in
      let mu = poly-of-lanes (message-lanes m 0) in
      let v = poly-add (poly-add (poly-inv-ntt (dot t y zero-poly)) e2) mu in
      bytes-concat [bytes-concat (map (compress-poly (du p)) u), compress-poly (dv p) v]

  -- | u_i = NTT^-1(sum over j of A-hat(j, i) * y-hat_j) + e1_i.
  encrypt-u :: List (List Poly) -> List Poly -> List Poly -> Nat -> Nat -> List Poly
  encrypt-u a y e1 i k = case e1 of
    Nil -> Nil
    Cons e rest -> Cons (poly-add (poly-inv-ntt (dot (column a i) y zero-poly)) e) (encrypt-u a y rest (i + 1) k)

  -- | Decapsulate (FIPS 203 Algorithm 18): the shared key, or the rejection key J(z || c) when the ciphertext
  -- does not re-encrypt to itself. The choice is made in constant time.
  mlkem-decapsulate :: MlKemDecapsulationKey -> Bytes -> Result MlKemError Bytes
  mlkem-decapsulate dk c = case dk of
    MlKemDecapsulationKey seed s ek z -> case ek of
      MlKemEncapsulationKey p b t a h ->
        if not (bytes-len c == mlkem-ciphertext-size p) then Err (MlKemInvalidCiphertextSize (bytes-len c))
        else
          let k = rank p in
          let u = decompress-all c (du p) 0 k in
          let v = decompress-poly (dv p) c (32 * du p * k) in
          let w = poly-sub v (poly-inv-ntt (dot s (map poly-ntt u) zero-poly)) in
          let m = compress-poly 1 w in
          let g = sha3-sum512 (bytes-concat [m, h]) in
          let key = slice g 0 32 in
          let rejected = shake256-sum (bytes-concat [z, c]) 32 in
          let same = constant-bytes-equal (encrypt ek m (slice g 32 64)) c in
          let chosen = copy rejected in
          case constant-copy same chosen key of Ok done -> Ok chosen; Err e -> Ok chosen

  -- | The k compressed polynomials of u.
  decompress-all :: Bytes -> Nat -> Nat -> Nat -> List Poly
  decompress-all c d i k = if i >= k then Nil else Cons (decompress-poly d c (32 * d * i)) (decompress-all c d (i + 1) k)

  -- ---------------------------------------------------------------------
  -- Sampling and encoding.
  -- ---------------------------------------------------------------------

  -- | Rejection-sample a polynomial in the NTT domain from SHAKE128(seed) (FIPS 203 Algorithm 7): 12-bit
  -- candidates below q are kept in order.
  sample-ntt :: Bytes -> Poly
  sample-ntt seed = case shake-read (sha3-state-update shake128-state seed) 504 of
    (stream, reader) ->
      let out = bytes-new 512 in
      let filled = sample-from stream reader out 0 0 in
      poly-of-lanes (buffer-lanes out 0)

  -- | Take candidates from the stream at offset i into out (count kept so far), reading more when needed.
  sample-from :: Bytes -> ShakeReader -> Bytes -> Nat -> Nat -> Unit
  sample-from stream reader out i count =
    if count >= 256 then ()
    else if i + 3 > bytes-len stream then
      (case shake-reader-read reader 168 of (more, next) -> sample-from (bytes-concat [slice stream i (bytes-len stream), more]) next out 0 count)
    else
      let b0 = at stream i in
      let b1 = at stream (i + 1) in
      let b2 = at stream (i + 2) in
      let d1 = b0 + 256 * nat-rem b1 16 in
      let d2 = nat-div b1 16 + 16 * b2 in
      let kept = if d1 < 3329 then let w = put16 out count d1 in count + 1 else count in
      let both = if d2 < 3329 && kept < 256 then let w = put16 out kept d2 in kept + 1 else kept in
      sample-from stream reader out (i + 3) both

  -- | Store a 16-bit little-endian coefficient.
  put16 :: Bytes -> Nat -> Nat -> Unit
  put16 out i v = let a = put out (2 * i) (nat-rem v 256) in put out (2 * i + 1) (nat-div v 256)

  -- | Lanes of a 512-byte coefficient buffer.
  buffer-lanes :: Bytes -> Nat -> List U128
  buffer-lanes b v = if v >= 32 then Nil else Cons (join64 (word64 b (16 * v)) (word64 b (16 * v + 8))) (buffer-lanes b (v + 1))

  -- | ByteEncode_12 of a polynomial: 384 bytes.
  encode12 :: Poly -> Bytes
  encode12 p = bytes-concat (pack-lanes (poly-lanes p))

  -- | Packed, encoded lanes.
  pack-lanes :: List U128 -> List Bytes
  pack-lanes lanes = case lanes of Nil -> Nil; Cons x rest -> Cons (field-bytes 12 (pack12 x)) (pack-lanes rest)

  -- | ByteDecode_12 of 384 bytes at an offset, or None when a coefficient is at least q.
  decode12 :: Bytes -> Nat -> Option Poly
  decode12 b off =
    let lanes = unpack-lanes (read-fields b off 12 0) in
    if all-below lanes then Some (poly-of-lanes lanes) else None

  -- | Unpacked lanes.
  unpack-lanes :: List U128 -> List U128
  unpack-lanes lanes = case lanes of Nil -> Nil; Cons x rest -> Cons (unpack12 x) (unpack-lanes rest)

  -- | Whether every lane is below q.
  all-below :: List U128 -> Bool
  all-below lanes = case lanes of Nil -> True; Cons x rest -> below-q x == 1 && all-below rest

  -- | Compress_d then ByteEncode_d of a polynomial: 32d bytes.
  compress-poly :: Nat -> Poly -> Bytes
  compress-poly d p = bytes-concat (compress-lanes d (poly-lanes p))

  -- | Compressed, encoded lanes.
  compress-lanes :: Nat -> List U128 -> List Bytes
  compress-lanes d lanes = case lanes of Nil -> Nil; Cons x rest -> Cons (field-bytes d (compress-lane d x)) (compress-lanes d rest)

  -- | The compression kernel for d bits applied to one lane.
  compress-lane :: Nat -> U128 -> U128
  compress-lane d x = if d == 1 then compress1 x else if d == 4 then compress4 x else if d == 5 then compress5 x else if d == 10 then compress10 x else compress11 x

  -- | ByteDecode_d then Decompress_d of 32d bytes at an offset.
  decompress-poly :: Nat -> Bytes -> Nat -> Poly
  decompress-poly d b off = poly-of-lanes (decompress-lanes d (read-fields b off d 0))

  -- | Decompressed lanes.
  decompress-lanes :: Nat -> List U128 -> List U128
  decompress-lanes d lanes = case lanes of Nil -> Nil; Cons x rest -> Cons (decompress-lane d x) (decompress-lanes d rest)

  -- | The decompression kernel for d bits applied to one lane.
  decompress-lane :: Nat -> U128 -> U128
  decompress-lane d x = if d == 1 then decompress1 x else if d == 4 then decompress4 x else if d == 5 then decompress5 x else if d == 10 then decompress10 x else decompress11 x

  -- | Decompress_1 lanes of a 32-byte message, one byte per lane.
  message-lanes :: Bytes -> Nat -> List U128
  message-lanes m v = if v >= 32 then Nil else Cons (message-lane (small (at m v))) (message-lanes m (v + 1))

  -- | The low n bytes of a packed field, as bytes.
  field-bytes :: Nat -> U128 -> Bytes
  field-bytes n x =
    let out = bytes-new n in
    let lo = store-bytes out 0 (low64 x) (if n < 8 then n else 8) in
    let hi = if n > 8 then store-bytes out 8 (high64 x) (n - 8) else () in
    out

  -- | Store the low n bytes of a word from an offset.
  store-bytes :: Bytes -> Nat -> U64 -> Nat -> Unit
  store-bytes out i w n =
    if n == 0 then ()
    else let s = put out i (u8-to-nat (wrapping-u64-to-u8 w)) in store-bytes out (i + 1) (wrapping-shr-u64 w 8) (n - 1)

  -- | Thirty-two packed fields of n bytes each from an offset.
  read-fields :: Bytes -> Nat -> Nat -> Nat -> List U128
  read-fields b off n v =
    if v >= 32 then Nil
    else
      let base = off + n * v in
      let lo = load-bytes b base (if n < 8 then n else 8) 0 0 in
      let hi = if n > 8 then load-bytes b (base + 8) (n - 8) 0 0 else 0 in
      Cons (join64 lo hi) (read-fields b off n (v + 1))

  -- | Load n bytes from an offset as a little-endian word.
  load-bytes :: Bytes -> Nat -> Nat -> Nat -> U64 -> U64
  load-bytes b i n k acc =
    if k >= n then acc
    else load-bytes b i n (k + 1) (bit-or-u64 acc (wrapping-shl-u64 (u8-to-u64 (byte (at b (i + k)))) (shift (8 * k))))

  -- ---------------------------------------------------------------------
  -- Bytes and words.
  -- ---------------------------------------------------------------------

  -- | A byte or zero past the end.
  at :: Bytes -> Nat -> Nat
  at b i = if i < bytes-len b then bytes-get b i else 0

  -- | Store a byte when it fits.
  put :: Bytes -> Nat -> Nat -> Unit
  put b i v = if i < bytes-len b && v < 256 then bytes-set b i v else ()

  -- | One byte.
  one :: Nat -> Bytes
  one v = let out = bytes-new 1 in let w = put out 0 v in out

  -- | A copy of b[x, y).
  slice :: Bytes -> Nat -> Nat -> Bytes
  slice b x y =
    let n = if x <= y then y - x else 0 in
    let out = bytes-new n in
    if x + n <= bytes-len b then let c = bytes-copy-range out b 0 x n in out else out

  -- | A fresh copy.
  copy :: Bytes -> Bytes
  copy b = slice b 0 (bytes-len b)

  -- | A little-endian 32-bit word as a machine integer, zero when it does not fit.
  word32 :: Bytes -> Nat -> I64
  word32 b i = if i + 4 <= bytes-len b then u32-to-i64 (bytes-read-le32 b i) else 0

  -- | A little-endian 64-bit word, zero when it does not fit.
  word64 :: Bytes -> Nat -> U64
  word64 b i = if i + 8 <= bytes-len b then bytes-read-le64 b i else 0

  -- | A byte value as a machine byte.
  byte :: Nat -> U8
  byte n = wrapping-i64-to-u8 (nat-to-i64 (nat-rem n 256))

  -- | A shift amount below 64.
  shift :: Nat -> U32
  shift n = if n < 64 then wrapping-i64-to-u32 (nat-to-i64 n) else 0

  -- | A small value as a machine integer.
  small :: Nat -> I64
  small n = if n < 4294967296 then nat-to-i64 n else 0

  -- Generated ML-KEM kernels: lane arithmetic, transforms and packing.

  -- | A polynomial: 256 coefficients modulo q as thirty-two lanes of eight.
  data Poly where
    -- | Lanes in coefficient order.
    Poly :: U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> Poly

  -- | The lanes of a polynomial in order.
  poly-lanes :: Poly -> List U128
  poly-lanes p = case p of Poly x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 x16 x17 x18 x19 x20 x21 x22 x23 x24 x25 x26 x27 x28 x29 x30 x31 -> [x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, x30, x31]

  -- | A polynomial from its first thirty-two lanes (zero when fewer are given).
  poly-of-lanes :: List U128 -> Poly
  poly-of-lanes l =
    case l of
      Nil -> zero-poly
      Cons x0 r0 ->
        case r0 of
          Nil -> zero-poly
          Cons x1 r1 ->
            case r1 of
              Nil -> zero-poly
              Cons x2 r2 ->
                case r2 of
                  Nil -> zero-poly
                  Cons x3 r3 ->
                    case r3 of
                      Nil -> zero-poly
                      Cons x4 r4 ->
                        case r4 of
                          Nil -> zero-poly
                          Cons x5 r5 ->
                            case r5 of
                              Nil -> zero-poly
                              Cons x6 r6 ->
                                case r6 of
                                  Nil -> zero-poly
                                  Cons x7 r7 ->
                                    case r7 of
                                      Nil -> zero-poly
                                      Cons x8 r8 ->
                                        case r8 of
                                          Nil -> zero-poly
                                          Cons x9 r9 ->
                                            case r9 of
                                              Nil -> zero-poly
                                              Cons x10 r10 ->
                                                case r10 of
                                                  Nil -> zero-poly
                                                  Cons x11 r11 ->
                                                    case r11 of
                                                      Nil -> zero-poly
                                                      Cons x12 r12 ->
                                                        case r12 of
                                                          Nil -> zero-poly
                                                          Cons x13 r13 ->
                                                            case r13 of
                                                              Nil -> zero-poly
                                                              Cons x14 r14 ->
                                                                case r14 of
                                                                  Nil -> zero-poly
                                                                  Cons x15 r15 ->
                                                                    case r15 of
                                                                      Nil -> zero-poly
                                                                      Cons x16 r16 ->
                                                                        case r16 of
                                                                          Nil -> zero-poly
                                                                          Cons x17 r17 ->
                                                                            case r17 of
                                                                              Nil -> zero-poly
                                                                              Cons x18 r18 ->
                                                                                case r18 of
                                                                                  Nil -> zero-poly
                                                                                  Cons x19 r19 ->
                                                                                    case r19 of
                                                                                      Nil -> zero-poly
                                                                                      Cons x20 r20 ->
                                                                                        case r20 of
                                                                                          Nil -> zero-poly
                                                                                          Cons x21 r21 ->
                                                                                            case r21 of
                                                                                              Nil -> zero-poly
                                                                                              Cons x22 r22 ->
                                                                                                case r22 of
                                                                                                  Nil -> zero-poly
                                                                                                  Cons x23 r23 ->
                                                                                                    case r23 of
                                                                                                      Nil -> zero-poly
                                                                                                      Cons x24 r24 ->
                                                                                                        case r24 of
                                                                                                          Nil -> zero-poly
                                                                                                          Cons x25 r25 ->
