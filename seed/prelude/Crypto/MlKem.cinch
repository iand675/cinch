            Poly (sub-q a0 b0) (sub-q a1 b1) (sub-q a2 b2) (sub-q a3 b3) (sub-q a4 b4) (sub-q a5 b5) (sub-q a6 b6) (sub-q a7 b7) (sub-q a8 b8) (sub-q a9 b9) (sub-q a10 b10) (sub-q a11 b11) (sub-q a12 b12) (sub-q a13 b13) (sub-q a14 b14) (sub-q a15 b15) (sub-q a16 b16) (sub-q a17 b17) (sub-q a18 b18) (sub-q a19 b19) (sub-q a20 b20) (sub-q a21 b21) (sub-q a22 b22) (sub-q a23 b23) (sub-q a24 b24) (sub-q a25 b25) (sub-q a26 b26) (sub-q a27 b27) (sub-q a28 b28) (sub-q a29 b29) (sub-q a30 b30) (sub-q a31 b31)

  -- | Accumulate the NTT-domain product of two polynomials (FIPS 203 Algorithm 11) into acc.
  poly-basemul-add :: Poly -> Poly -> Poly -> Poly
  poly-basemul-add acc p r =
    case acc of
      Poly c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 c22 c23 c24 c25 c26 c27 c28 c29 c30 c31 ->
        case p of
          Poly a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24 a25 a26 a27 a28 a29 a30 a31 ->
            case r of
              Poly b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16 b17 b18 b19 b20 b21 b22 b23 b24 b25 b26 b27 b28 b29 b30 b31 ->
                Poly (basemul-add c0 a0 b0 17 3312 2761 568) (basemul-add c1 a1 b1 583 2746 2649 680) (basemul-add c2 a2 b2 1637 1692 723 2606) (basemul-add c3 a3 b3 2288 1041 1100 2229) (basemul-add c4 a4 b4 1409 1920 2662 667) (basemul-add c5 a5 b5 3281 48 233 3096) (basemul-add c6 a6 b6 756 2573 2156 1173) (basemul-add c7 a7 b7 3015 314 3050 279) (basemul-add c8 a8 b8 1703 1626 1651 1678) (basemul-add c9 a9 b9 2789 540 1789 1540) (basemul-add c10 a10 b10 1847 1482 952 2377) (basemul-add c11 a11 b11 1461 1868 2687 642) (basemul-add c12 a12 b12 939 2390 2308 1021) (basemul-add c13 a13 b13 2437 892 2388 941) (basemul-add c14 a14 b14 733 2596 2337 992) (basemul-add c15 a15 b15 268 3061 641 2688) (basemul-add c16 a16 b16 1584 1745 2298 1031) (basemul-add c17 a17 b17 2037 1292 3220 109) (basemul-add c18 a18 b18 375 2954 2549 780) (basemul-add c19 a19 b19 2090 1239 1645 1684) (basemul-add c20 a20 b20 1063 2266 319 3010) (basemul-add c21 a21 b21 2773 556 757 2572) (basemul-add c22 a22 b22 2099 1230 561 2768) (basemul-add c23 a23 b23 2466 863 2594 735) (basemul-add c24 a24 b24 2804 525 1092 2237) (basemul-add c25 a25 b25 403 2926 1026 2303) (basemul-add c26 a26 b26 1143 2186 2150 1179) (basemul-add c27 a27 b27 2775 554 886 2443) (basemul-add c28 a28 b28 1722 1607 1212 2117) (basemul-add c29 a29 b29 1874 1455 1029 2300) (basemul-add c30 a30 b30 2110 1219 2935 394) (basemul-add c31 a31 b31 885 2444 2154 1175)

  -- | Forward butterfly sum: a + zeta * b modulo q in every lane.
  prim bf-sum :: U128 -> U128 -> I64 -> U128 where
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = zext <8 x i16> %v1 to <8 x i32>
      %v3 = bitcast i128 %1 to <8 x i16>
      %v4 = zext <8 x i16> %v3 to <8 x i32>
      %v5 = trunc i64 %2 to i32
      %v6 = insertelement <8 x i32> poison, i32 %v5, i64 0
      %v7 = shufflevector <8 x i32> %v6, <8 x i32> poison, <8 x i32> zeroinitializer
      %v8 = mul <8 x i32> %v4, %v7
      %v9 = urem <8 x i32> %v8, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v10 = add <8 x i32> %v2, %v9
      %v11 = icmp uge <8 x i32> %v10, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v12 = sub <8 x i32> %v10, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v13 = select <8 x i1> %v11, <8 x i32> %v12, <8 x i32> %v10
      %v14 = trunc <8 x i32> %v13 to <8 x i16>
      %v15 = bitcast <8 x i16> %v14 to i128
      ret i128 %v15
    } when endian little
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = shufflevector <8 x i16> %v1, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = zext <8 x i16> %v2 to <8 x i32>
      %v4 = bitcast i128 %1 to <8 x i16>
      %v5 = shufflevector <8 x i16> %v4, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v6 = zext <8 x i16> %v5 to <8 x i32>
      %v7 = trunc i64 %2 to i32
      %v8 = insertelement <8 x i32> poison, i32 %v7, i64 0
      %v9 = shufflevector <8 x i32> %v8, <8 x i32> poison, <8 x i32> zeroinitializer
      %v10 = mul <8 x i32> %v6, %v9
      %v11 = urem <8 x i32> %v10, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v12 = add <8 x i32> %v3, %v11
      %v13 = icmp uge <8 x i32> %v12, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v14 = sub <8 x i32> %v12, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v15 = select <8 x i1> %v13, <8 x i32> %v14, <8 x i32> %v12
      %v16 = trunc <8 x i32> %v15 to <8 x i16>
      %v17 = shufflevector <8 x i16> %v16, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v18 = bitcast <8 x i16> %v17 to i128
      ret i128 %v18
    } when endian big

  -- | Forward butterfly difference: a - zeta * b modulo q in every lane.
  prim bf-diff :: U128 -> U128 -> I64 -> U128 where
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = zext <8 x i16> %v1 to <8 x i32>
      %v3 = bitcast i128 %1 to <8 x i16>
      %v4 = zext <8 x i16> %v3 to <8 x i32>
      %v5 = trunc i64 %2 to i32
      %v6 = insertelement <8 x i32> poison, i32 %v5, i64 0
      %v7 = shufflevector <8 x i32> %v6, <8 x i32> poison, <8 x i32> zeroinitializer
      %v8 = mul <8 x i32> %v4, %v7
      %v9 = urem <8 x i32> %v8, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v10 = add <8 x i32> %v2, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v11 = sub <8 x i32> %v10, %v9
      %v12 = icmp uge <8 x i32> %v11, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v13 = sub <8 x i32> %v11, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v14 = select <8 x i1> %v12, <8 x i32> %v13, <8 x i32> %v11
      %v15 = trunc <8 x i32> %v14 to <8 x i16>
      %v16 = bitcast <8 x i16> %v15 to i128
      ret i128 %v16
    } when endian little
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = shufflevector <8 x i16> %v1, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = zext <8 x i16> %v2 to <8 x i32>
      %v4 = bitcast i128 %1 to <8 x i16>
      %v5 = shufflevector <8 x i16> %v4, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v6 = zext <8 x i16> %v5 to <8 x i32>
      %v7 = trunc i64 %2 to i32
      %v8 = insertelement <8 x i32> poison, i32 %v7, i64 0
      %v9 = shufflevector <8 x i32> %v8, <8 x i32> poison, <8 x i32> zeroinitializer
      %v10 = mul <8 x i32> %v6, %v9
      %v11 = urem <8 x i32> %v10, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v12 = add <8 x i32> %v3, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v13 = sub <8 x i32> %v12, %v11
      %v14 = icmp uge <8 x i32> %v13, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v15 = sub <8 x i32> %v13, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v16 = select <8 x i1> %v14, <8 x i32> %v15, <8 x i32> %v13
      %v17 = trunc <8 x i32> %v16 to <8 x i16>
      %v18 = shufflevector <8 x i16> %v17, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v19 = bitcast <8 x i16> %v18 to i128
      ret i128 %v19
    } when endian big

  -- | Lane-wise a + b modulo q (also the inverse butterfly sum).
  prim ib-sum :: U128 -> U128 -> U128 where
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = zext <8 x i16> %v1 to <8 x i32>
      %v3 = bitcast i128 %1 to <8 x i16>
      %v4 = zext <8 x i16> %v3 to <8 x i32>
      %v5 = add <8 x i32> %v2, %v4
      %v6 = icmp uge <8 x i32> %v5, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v7 = sub <8 x i32> %v5, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v8 = select <8 x i1> %v6, <8 x i32> %v7, <8 x i32> %v5
      %v9 = trunc <8 x i32> %v8 to <8 x i16>
      %v10 = bitcast <8 x i16> %v9 to i128
      ret i128 %v10
    } when endian little
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = shufflevector <8 x i16> %v1, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = zext <8 x i16> %v2 to <8 x i32>
      %v4 = bitcast i128 %1 to <8 x i16>
      %v5 = shufflevector <8 x i16> %v4, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v6 = zext <8 x i16> %v5 to <8 x i32>
      %v7 = add <8 x i32> %v3, %v6
      %v8 = icmp uge <8 x i32> %v7, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v9 = sub <8 x i32> %v7, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v10 = select <8 x i1> %v8, <8 x i32> %v9, <8 x i32> %v7
      %v11 = trunc <8 x i32> %v10 to <8 x i16>
      %v12 = shufflevector <8 x i16> %v11, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v13 = bitcast <8 x i16> %v12 to i128
      ret i128 %v13
    } when endian big

  -- | Inverse butterfly difference: zeta * (b - a) modulo q in every lane.
  prim ib-diff :: U128 -> U128 -> I64 -> U128 where
    llvm {
      %v1 = bitcast i128 %1 to <8 x i16>
      %v2 = zext <8 x i16> %v1 to <8 x i32>
      %v3 = bitcast i128 %0 to <8 x i16>
      %v4 = zext <8 x i16> %v3 to <8 x i32>
      %v5 = add <8 x i32> %v2, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v6 = sub <8 x i32> %v5, %v4
      %v7 = icmp uge <8 x i32> %v6, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v8 = sub <8 x i32> %v6, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v9 = select <8 x i1> %v7, <8 x i32> %v8, <8 x i32> %v6
      %v10 = trunc i64 %2 to i32
      %v11 = insertelement <8 x i32> poison, i32 %v10, i64 0
      %v12 = shufflevector <8 x i32> %v11, <8 x i32> poison, <8 x i32> zeroinitializer
      %v13 = mul <8 x i32> %v9, %v12
      %v14 = urem <8 x i32> %v13, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v15 = trunc <8 x i32> %v14 to <8 x i16>
      %v16 = bitcast <8 x i16> %v15 to i128
      ret i128 %v16
    } when endian little
    llvm {
      %v1 = bitcast i128 %1 to <8 x i16>
      %v2 = shufflevector <8 x i16> %v1, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = zext <8 x i16> %v2 to <8 x i32>
      %v4 = bitcast i128 %0 to <8 x i16>
      %v5 = shufflevector <8 x i16> %v4, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v6 = zext <8 x i16> %v5 to <8 x i32>
      %v7 = add <8 x i32> %v3, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v8 = sub <8 x i32> %v7, %v6
      %v9 = icmp uge <8 x i32> %v8, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v10 = sub <8 x i32> %v8, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v11 = select <8 x i1> %v9, <8 x i32> %v10, <8 x i32> %v8
      %v12 = trunc i64 %2 to i32
      %v13 = insertelement <8 x i32> poison, i32 %v12, i64 0
      %v14 = shufflevector <8 x i32> %v13, <8 x i32> poison, <8 x i32> zeroinitializer
      %v15 = mul <8 x i32> %v11, %v14
      %v16 = urem <8 x i32> %v15, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v17 = trunc <8 x i32> %v16 to <8 x i16>
      %v18 = shufflevector <8 x i16> %v17, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v19 = bitcast <8 x i16> %v18 to i128
      ret i128 %v19
    } when endian big

  -- | Lane-wise a - b modulo q.
  prim sub-q :: U128 -> U128 -> U128 where
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = zext <8 x i16> %v1 to <8 x i32>
      %v3 = bitcast i128 %1 to <8 x i16>
      %v4 = zext <8 x i16> %v3 to <8 x i32>
      %v5 = add <8 x i32> %v2, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v6 = sub <8 x i32> %v5, %v4
      %v7 = icmp uge <8 x i32> %v6, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v8 = sub <8 x i32> %v6, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v9 = select <8 x i1> %v7, <8 x i32> %v8, <8 x i32> %v6
      %v10 = trunc <8 x i32> %v9 to <8 x i16>
      %v11 = bitcast <8 x i16> %v10 to i128
      ret i128 %v11
    } when endian little
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = shufflevector <8 x i16> %v1, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = zext <8 x i16> %v2 to <8 x i32>
      %v4 = bitcast i128 %1 to <8 x i16>
      %v5 = shufflevector <8 x i16> %v4, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v6 = zext <8 x i16> %v5 to <8 x i32>
      %v7 = add <8 x i32> %v3, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v8 = sub <8 x i32> %v7, %v6
      %v9 = icmp uge <8 x i32> %v8, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v10 = sub <8 x i32> %v8, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v11 = select <8 x i1> %v9, <8 x i32> %v10, <8 x i32> %v8
      %v12 = trunc <8 x i32> %v11 to <8 x i16>
      %v13 = shufflevector <8 x i16> %v12, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v14 = bitcast <8 x i16> %v13 to i128
      ret i128 %v14
    } when endian big

  -- | Lane-wise multiplication by a constant modulo q.
  prim scale :: U128 -> I64 -> U128 where
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = zext <8 x i16> %v1 to <8 x i32>
      %v3 = trunc i64 %1 to i32
      %v4 = insertelement <8 x i32> poison, i32 %v3, i64 0
      %v5 = shufflevector <8 x i32> %v4, <8 x i32> poison, <8 x i32> zeroinitializer
      %v6 = mul <8 x i32> %v2, %v5
      %v7 = urem <8 x i32> %v6, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v8 = trunc <8 x i32> %v7 to <8 x i16>
      %v9 = bitcast <8 x i16> %v8 to i128
      ret i128 %v9
    } when endian little
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = shufflevector <8 x i16> %v1, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = zext <8 x i16> %v2 to <8 x i32>
      %v4 = trunc i64 %1 to i32
      %v5 = insertelement <8 x i32> poison, i32 %v4, i64 0
      %v6 = shufflevector <8 x i32> %v5, <8 x i32> poison, <8 x i32> zeroinitializer
      %v7 = mul <8 x i32> %v3, %v6
      %v8 = urem <8 x i32> %v7, <i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329, i32 3329>
      %v9 = trunc <8 x i32> %v8 to <8 x i16>
      %v10 = shufflevector <8 x i16> %v9, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v11 = bitcast <8 x i16> %v10 to i128
      ret i128 %v11
    } when endian big

  -- | The forward layer of length four inside a lane: coefficients 0-3 against 4-7.
  prim ntt4 :: U128 -> I64 -> U128 where
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = zext <8 x i16> %v1 to <8 x i32>
      %v3 = trunc i64 %1 to i32
      %v4 = insertelement <8 x i32> poison, i32 %v3, i64 0
      %v5 = shufflevector <8 x i32> %v4, <8 x i32> poison, <8 x i32> zeroinitializer
