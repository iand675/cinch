  -- | The low 128 bits of (h + m + hibit * 2^128) * r reduced once modulo 2^130 - 5, for h given as its low 128 bits and the rest, the clamped r, the block m and hibit.
  prim poly-lo :: U128 -> U64 -> U128 -> U128 -> U64 -> U128 where
    llvm {
      %hl = zext i128 %0 to i256
      %hh0 = zext i64 %1 to i256
      %hh = shl i256 %hh0, 128
      %h = or i256 %hl, %hh
      %m = zext i128 %3 to i256
      %hb0 = zext i64 %4 to i256
      %hb = shl i256 %hb0, 128
      %s0 = add i256 %h, %m
      %s = add i256 %s0, %hb
      %r = zext i128 %2 to i256
      %p = mul i256 %s, %r
      %lo130 = and i256 %p, 1361129467683753853853498429727072845823
      %top = lshr i256 %p, 130
      %five = mul i256 %top, 5
      %f = add i256 %lo130, %five
      %t = trunc i256 %f to i128
      ret i128 %t
    }

  -- | The bits above 128 of the same once-reduced product (below 8).
  prim poly-hi :: U128 -> U64 -> U128 -> U128 -> U64 -> U64 where
    llvm {
      %hl = zext i128 %0 to i256
      %hh0 = zext i64 %1 to i256
      %hh = shl i256 %hh0, 128
      %h = or i256 %hl, %hh
      %m = zext i128 %3 to i256
      %hb0 = zext i64 %4 to i256
      %hb = shl i256 %hb0, 128
      %s0 = add i256 %h, %m
      %s = add i256 %s0, %hb
      %r = zext i128 %2 to i256
      %p = mul i256 %s, %r
      %lo130 = and i256 %p, 1361129467683753853853498429727072845823
      %top = lshr i256 %p, 130
      %five = mul i256 %top, 5
      %f = add i256 %lo130, %five
      %u = lshr i256 %f, 128
      %t = trunc i256 %u to i64
      ret i64 %t
    }

  -- | The tag: h reduced fully modulo 2^130 - 5, plus the second key half, modulo 2^128.
  prim poly-tag :: U128 -> U64 -> U128 -> U128 where
    llvm {
      %hl = zext i128 %0 to i256
      %hh0 = zext i64 %1 to i256
      %hh = shl i256 %hh0, 128
      %h0 = or i256 %hl, %hh
      %lo130 = and i256 %h0, 1361129467683753853853498429727072845823
      %top = lshr i256 %h0, 130
      %five = mul i256 %top, 5
      %h = add i256 %lo130, %five
      %g = add i256 %h, 5
      %ge = lshr i256 %g, 130
      %big = icmp ne i256 %ge, 0
      %gm = and i256 %g, 1361129467683753853853498429727072845823
      %red = select i1 %big, i256 %gm, i256 %h
      %t0 = trunc i256 %red to i128
      %t = add i128 %t0, %2
      ret i128 %t
    }
