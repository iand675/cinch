-- | ChaCha20 and XChaCha20 stream encryption, the Poly1305 one-time authenticator, and the
-- ChaCha20-Poly1305 and XChaCha20-Poly1305 authenticated ciphers (RFC 8439 and the extended-nonce
-- construction through HChaCha20).
--
-- A ChaCha20 keystream block is the state after twenty rounds plus the initial state, computed as four
-- <4 x i32> rows: column rounds are vector quarter rounds and diagonal rounds rotate rows one, two and three
-- lanes around them. Each kernel returns one sixteen-byte row, so a 64-byte block takes four calls that each
-- run the rounds. Poly1305 keeps its accumulator below 2^131 and multiplies with exact 256-bit products,
-- reducing modulo 2^130 - 5 once per block and fully at the end, with no data-dependent branches. Tags are
-- compared in constant time and nothing is decrypted before the tag verifies. Every returned buffer is fresh.
module Crypto.ChaCha20Poly1305 where

  import Data.Bytes
  import Data.Bytes.Word
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Result
  import Data.String
  import Data.Wide (wrapping-u128-to-u64, wrapping-shr-u128, u64-to-u128, wrapping-shl-u128, bit-or-u128, bit-and-u128, bit-xor-u128, bit-not-u128)
  import Crypto.ConstantTime (constant-bytes-equal)

  export ChaChaError, ChaChaKeySize, ChaChaNonceSize, ChaChaTooLarge, ChaChaAuthentication, chacha-error-message
  export chacha20-xor, xchacha20-xor, hchacha20, poly1305-mac, poly1305-verify
  export chacha20poly1305-seal, chacha20poly1305-open, xchacha20poly1305-seal, xchacha20poly1305-open
  export chacha-key-size, chacha-nonce-size, xchacha-nonce-size, poly1305-tag-size

  -- | Why a ChaCha20 or Poly1305 operation was refused.
  data ChaChaError where
    -- | The key is not 32 bytes (its length is given).
    ChaChaKeySize :: Nat -> ChaChaError
    -- | The nonce has the wrong length (its length is given).
    ChaChaNonceSize :: Nat -> ChaChaError
    -- | The message would run the 32-bit block counter past its end.
    ChaChaTooLarge :: ChaChaError
    -- | The tag does not authenticate the ciphertext and additional data.
    ChaChaAuthentication :: ChaChaError

  -- | A readable description of an error.
  chacha-error-message :: ChaChaError -> String
  chacha-error-message e = case e of
    ChaChaKeySize n -> "chacha20: key must be 32 bytes"
    ChaChaNonceSize n -> "chacha20: wrong nonce size"
    ChaChaTooLarge -> "chacha20: message too large for the block counter"
    ChaChaAuthentication -> "chacha20poly1305: message authentication failed"

  -- | Key bytes.
  chacha-key-size :: Nat
  chacha-key-size = 32

  -- | ChaCha20 and ChaCha20-Poly1305 nonce bytes.
  chacha-nonce-size :: Nat
  chacha-nonce-size = 12

  -- | XChaCha20 and XChaCha20-Poly1305 nonce bytes.
  xchacha-nonce-size :: Nat
  xchacha-nonce-size = 24

  -- | Poly1305 tag bytes.
  poly1305-tag-size :: Nat
  poly1305-tag-size = 16

  -- ---------------------------------------------------------------------
  -- Helpers.
  -- ---------------------------------------------------------------------

  -- | Sixteen bytes as a little-endian U128 (missing bytes read as zero).
  get128 :: Bytes -> Nat -> U128
  get128 b o =
    if o + 16 <= bytes-len b then bit-or-u128 (u64-to-u128 (bytes-read-le64 b o)) (wrapping-shl-u128 (u64-to-u128 (bytes-read-le64 b (o + 8))) 64)
    else tail128 b o 0 (u64-to-u128 0)

  -- | The bytes from o + i onwards (below the buffer end and o + 16) placed into an accumulator.
  tail128 :: Bytes -> Nat -> Nat -> U128 -> U128
  tail128 b o i acc =
    if i >= 16 || o + i >= bytes-len b then acc
    else tail128 b o (i + 1) (bit-or-u128 acc (wrapping-shl-u128 (u64-to-u128 (u64-of (at b (o + i)))) (word (8 * i))))

  -- | The byte at an offset, zero outside the buffer.
  at :: Bytes -> Nat -> Nat
  at b i = if i < bytes-len b then bytes-get b i else 0

  -- | A value below 2^32 as a 32-bit word.
  word :: Nat -> U32
  word n = if n < 4294967296 then wrapping-i64-to-u32 (nat-to-i64 n) else 0

  -- | Store the first n (at most 16) bytes of a U128 at an offset, as far as they fit.
  put128 :: Bytes -> Nat -> U128 -> Nat -> Unit
  put128 b o v n =
    if n >= 16 && o + 16 <= bytes-len b then
      let lo = bytes-write-le64 b o (wrapping-u128-to-u64 v) in
      bytes-write-le64 b (o + 8) (wrapping-u128-to-u64 (wrapping-shr-u128 v 64))
    else put-bytes b o v 0 n

  -- | Store bytes i onwards (below n) of a U128 one at a time.
  put-bytes :: Bytes -> Nat -> U128 -> Nat -> Nat -> Unit
  put-bytes b o v i n = if i >= n || i >= 16 then ()
    else
      let s = if o + i < bytes-len b then bytes-set b (o + i) (u8-to-nat (wrapping-u64-to-u8 (wrapping-u128-to-u64 (wrapping-shr-u128 v (word (8 * i)))))) else () in
      put-bytes b o v (i + 1) n

  -- | A U128 as sixteen fresh bytes.
  bytes-of128 :: U128 -> Bytes
  bytes-of128 v = let out = bytes-new 16 in let s = put128 out 0 v 16 in out

  -- | Copy a range into a fresh buffer.
  slice :: Bytes -> Nat -> Nat -> Bytes
  slice b o n = let out = bytes-new n in let c = (if o + n <= bytes-len b then bytes-copy-range out b 0 o n else ()) in out

  -- | Saturating subtraction.
  minus :: Nat -> Nat -> Nat
  minus a b = if b <= a then a - b else 0

  -- | The counter-and-nonce row: the counter in word 0 and the twelve nonce bytes after it.
  counter-row :: Nat -> Bytes -> Nat -> U128
  counter-row counter nonce o = bit-or-u128 (u64-to-u128 (wrapping-u32-to-u64 (word counter))) (wrapping-shl-u128 (get96 nonce o) 32)

  -- | Twelve bytes at an offset as the low 96 bits of a U128.
  get96 :: Bytes -> Nat -> U128
  get96 b o = tail-n b o 0 12 (u64-to-u128 0)

  -- | Bytes from o + i (below n) placed into an accumulator.
  tail-n :: Bytes -> Nat -> Nat -> Nat -> U128 -> U128
  tail-n b o i n acc = if i >= n then acc else tail-n b o (i + 1) n (bit-or-u128 acc (wrapping-shl-u128 (u64-to-u128 (u64-of (at b (o + i)))) (word (8 * i))))

  -- ---------------------------------------------------------------------
  -- ChaCha20.
  -- ---------------------------------------------------------------------

  -- | XOR a message with the ChaCha20 keystream for a 32-byte key and 12-byte nonce, starting at a block counter.
  chacha20-xor :: Bytes -> Bytes -> Nat -> Bytes -> Result ChaChaError Bytes
  chacha20-xor key nonce counter input =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if not (bytes-len nonce == 12) then Err (ChaChaNonceSize (bytes-len nonce))
    else if counter + nat-div (bytes-len input + 63) 64 > 4294967296 then Err ChaChaTooLarge
    else Ok (keystream-xor (get128 key 0) (get128 key 16) nonce 0 counter input)

  -- | XOR with the keystream of the key halves and the nonce at an offset, from a block counter.
  keystream-xor :: U128 -> U128 -> Bytes -> Nat -> Nat -> Bytes -> Bytes
  keystream-xor k0 k1 nonce no counter input =
    let out = bytes-new (bytes-len input) in
    let done = xor-blocks k0 k1 (counter-row counter nonce no) input out 0 in
    out

  -- | Blocks from offset o onwards; row holds the counter (incremented per block) and nonce.
  xor-blocks :: U128 -> U128 -> U128 -> Bytes -> Bytes -> Nat -> Unit
  xor-blocks k0 k1 row input out o =
    if o >= bytes-len input then ()
    else
      let a = xor-row input out o (chacha-row0 k0 k1 row) in
      let b = xor-row input out (o + 16) (chacha-row1 k0 k1 row) in
      let c = xor-row input out (o + 32) (chacha-row2 k0 k1 row) in
      let d = xor-row input out (o + 48) (chacha-row3 k0 k1 row) in
      xor-blocks k0 k1 (bump row) input out (o + 64)

  -- | XOR sixteen keystream bytes (fewer at the end) into the output.
  xor-row :: Bytes -> Bytes -> Nat -> U128 -> Unit
  xor-row input out o ks = if o >= bytes-len input then () else put128 out o (bit-xor-u128 (get128 input o) ks) (minus (bytes-len input) o)

  -- | The next block counter (word 0, wrapping within 32 bits).
  bump :: U128 -> U128
  bump row =
    let low = wrapping-u128-to-u64 row in
    let counter = wrapping-add-u32 (wrapping-u64-to-u32 low) 1 in
    bit-or-u128 (bit-and-u128 row (bit-not-u128 (u64-to-u128 4294967295))) (u64-to-u128 (wrapping-u32-to-u64 counter))

  -- | HChaCha20 of a 32-byte key and the first 16 bytes of a nonce: rows 0 and 3 of the state after twenty
  -- rounds without the final addition, as a 32-byte subkey.
  hchacha20 :: Bytes -> Bytes -> Result ChaChaError Bytes
  hchacha20 key nonce =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if bytes-len nonce < 16 then Err (ChaChaNonceSize (bytes-len nonce))
    else Ok (subkey key nonce)

  -- | The HChaCha20 subkey for a valid key and nonce.
  subkey :: Bytes -> Bytes -> Bytes
  subkey key nonce =
    let row = get128 nonce 0 in
    let out = bytes-new 32 in
    let a = put128 out 0 (hchacha-row0 (get128 key 0) (get128 key 16) row) 16 in
    let b = put128 out 16 (hchacha-row3 (get128 key 0) (get128 key 16) row) 16 in
    out

  -- | XOR with the XChaCha20 keystream of a 32-byte key and 24-byte nonce: ChaCha20 under the HChaCha20 subkey of
  -- the first sixteen nonce bytes, with four zero bytes and the last eight nonce bytes as its nonce.
  xchacha20-xor :: Bytes -> Bytes -> Nat -> Bytes -> Result ChaChaError Bytes
  xchacha20-xor key nonce counter input =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if not (bytes-len nonce == 24) then Err (ChaChaNonceSize (bytes-len nonce))
    else chacha20-xor (subkey key nonce) (short-nonce nonce) counter input

  -- | Four zero bytes then the last eight bytes of an extended nonce.
  short-nonce :: Bytes -> Bytes
  short-nonce nonce = let out = bytes-new 12 in let c = (if bytes-len nonce == 24 then bytes-copy-range out nonce 4 16 8 else ()) in out

  -- ---------------------------------------------------------------------
  -- Poly1305.
  -- ---------------------------------------------------------------------

  -- | The Poly1305 tag of a message under a 32-byte one-time key.
  poly1305-mac :: Bytes -> Bytes -> Result ChaChaError Bytes
  poly1305-mac key message =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else Ok (bytes-of128 (mac key message))

  -- | Whether a tag authenticates a message under a one-time key, compared in constant time.
  poly1305-verify :: Bytes -> Bytes -> Bytes -> Bool
  poly1305-verify key message tag = bytes-len key == 32 && bytes-len tag == 16 && constant-bytes-equal (bytes-of128 (mac key message)) tag

  -- | The clamped r half of a one-time key.
  clamp :: Bytes -> U128
  clamp key = bit-and-u128 (get128 key 0) (bit-or-u128 (u64-to-u128 1152921487695413247) (wrapping-shl-u128 (u64-to-u128 1152921487695413244) 64))

  -- | The tag of a message: full sixteen-byte blocks with the 2^128 bit, the final partial block with a 0x01 after it.
  mac :: Bytes -> Bytes -> U128
  mac key message = case absorb (clamp key) message 0 (u64-to-u128 0) 0 of
    (lo, hi) -> poly-tag lo hi (get128 key 16)

  -- | Absorb the message from offset o into the accumulator (lo, hi).
  absorb :: U128 -> Bytes -> Nat -> U128 -> U64 -> (U128, U64)
  absorb r message o lo hi =
    if o >= bytes-len message then (lo, hi)
    else if o + 16 <= bytes-len message then
      let m = get128 message o in
      absorb r message (o + 16) (poly-lo lo hi r m 1) (poly-hi lo hi r m 1)
    else
      let n = minus (bytes-len message) o in
      let m = bit-or-u128 (get128 message o) (wrapping-shl-u128 (u64-to-u128 1) (word (8 * n))) in
      (poly-lo lo hi r m 0, poly-hi lo hi r m 0)

  -- | Absorb bytes from offset o as zero-padded sixteen-byte blocks, all with the 2^128 bit.
  absorb-padded :: U128 -> Bytes -> Nat -> U128 -> U64 -> (U128, U64)
  absorb-padded r msg o lo hi =
    if o >= bytes-len msg then (lo, hi)
    else
      let m = get128 msg o in
      absorb-padded r msg (o + 16) (poly-lo lo hi r m 1) (poly-hi lo hi r m 1)

  -- ---------------------------------------------------------------------
  -- ChaCha20-Poly1305.
  -- ---------------------------------------------------------------------

  -- | The AEAD tag: Poly1305 under the first 32 bytes of keystream block 0 over the padded additional data, the
  -- padded ciphertext and their 64-bit little-endian lengths.
  aead-tag :: U128 -> U128 -> Bytes -> Nat -> Bytes -> Bytes -> U128
  aead-tag k0 k1 nonce no aad ct =
    let row = counter-row 0 nonce no in
    let r = bit-and-u128 (chacha-row0 k0 k1 row) (bit-or-u128 (u64-to-u128 1152921487695413247) (wrapping-shl-u128 (u64-to-u128 1152921487695413244) 64)) in
    let s = chacha-row1 k0 k1 row in
    case absorb-padded r aad 0 (u64-to-u128 0) 0 of
      (l1, h1) -> case absorb-padded r ct 0 l1 h1 of
        (l2, h2) ->
          let lengths = bit-or-u128 (u64-to-u128 (u64-of (bytes-len aad))) (wrapping-shl-u128 (u64-to-u128 (u64-of (bytes-len ct))) 64) in
          poly-tag (poly-lo l2 h2 r lengths 1) (poly-hi l2 h2 r lengths 1) s

  -- | A number below 2^63 as a 64-bit word (zero otherwise; larger lengths are refused before this is reached).
  u64-of :: Nat -> U64
  u64-of n = if n < 9223372036854775808 then wrapping-i64-to-u64 (nat-to-i64 n) else 0

  -- | Encrypt and authenticate: the ciphertext followed by the sixteen-byte tag.
  chacha20poly1305-seal :: Bytes -> Bytes -> Bytes -> Bytes -> Result ChaChaError Bytes
  chacha20poly1305-seal key nonce plaintext aad =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if not (bytes-len nonce == 12) then Err (ChaChaNonceSize (bytes-len nonce))
    else if bytes-len plaintext > 274877906880 then Err ChaChaTooLarge
    else Ok (seal-with (get128 key 0) (get128 key 16) nonce 0 plaintext aad)

  -- | Seal under key halves and the nonce at an offset.
  seal-with :: U128 -> U128 -> Bytes -> Nat -> Bytes -> Bytes -> Bytes
  seal-with k0 k1 nonce no plaintext aad =
    let ct = keystream-xor k0 k1 nonce no 1 plaintext in
    let out = bytes-new (bytes-len ct + 16) in
    let c = if bytes-len ct <= bytes-len out then bytes-copy-range out ct 0 0 (bytes-len ct) else () in
    let t = put128 out (bytes-len ct) (aead-tag k0 k1 nonce no aad ct) 16 in
    out

  -- | Verify and decrypt a sealed message; nothing is decrypted unless the tag verifies.
  chacha20poly1305-open :: Bytes -> Bytes -> Bytes -> Bytes -> Result ChaChaError Bytes
  chacha20poly1305-open key nonce sealed aad =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if not (bytes-len nonce == 12) then Err (ChaChaNonceSize (bytes-len nonce))
    else if bytes-len sealed < 16 then Err ChaChaAuthentication
    else open-with (get128 key 0) (get128 key 16) nonce 0 sealed aad

  -- | Open under key halves and the nonce at an offset.
  open-with :: U128 -> U128 -> Bytes -> Nat -> Bytes -> Bytes -> Result ChaChaError Bytes
  open-with k0 k1 nonce no sealed aad =
    let n = minus (bytes-len sealed) 16 in
    let ct = slice sealed 0 n in
    if constant-bytes-equal (bytes-of128 (aead-tag k0 k1 nonce no aad ct)) (slice sealed n 16) then Ok (keystream-xor k0 k1 nonce no 1 ct)
    else Err ChaChaAuthentication

  -- | XChaCha20-Poly1305 sealing with a 24-byte nonce.
  xchacha20poly1305-seal :: Bytes -> Bytes -> Bytes -> Bytes -> Result ChaChaError Bytes
  xchacha20poly1305-seal key nonce plaintext aad =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if not (bytes-len nonce == 24) then Err (ChaChaNonceSize (bytes-len nonce))
    else chacha20poly1305-seal (subkey key nonce) (short-nonce nonce) plaintext aad

  -- | XChaCha20-Poly1305 opening with a 24-byte nonce.
  xchacha20poly1305-open :: Bytes -> Bytes -> Bytes -> Bytes -> Result ChaChaError Bytes
  xchacha20poly1305-open key nonce sealed aad =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if not (bytes-len nonce == 24) then Err (ChaChaNonceSize (bytes-len nonce))
    else chacha20poly1305-open (subkey key nonce) (short-nonce nonce) sealed aad

  -- Generated ChaCha20 and Poly1305 kernels.

  -- | Row 0 of the ChaCha20 keystream block for the key halves and the counter-and-nonce row: the state after twenty rounds plus the initial state, word i in bits 32i up.
  prim chacha-row0 :: U128 -> U128 -> U128 -> U128 where
    llvm {
      %v1 = bitcast i128 %0 to <4 x i32>
      %v2 = bitcast i128 %1 to <4 x i32>
      %v3 = bitcast i128 %2 to <4 x i32>
      %v4 = add <4 x i32> <i32 1634760805, i32 857760878, i32 2036477234, i32 1797285236>, %v1
      %v5 = xor <4 x i32> %v3, %v4
      %v6 = shl <4 x i32> %v5, <i32 16, i32 16, i32 16, i32 16>
      %v7 = lshr <4 x i32> %v5, <i32 16, i32 16, i32 16, i32 16>
      %v8 = or <4 x i32> %v6, %v7
      %v9 = add <4 x i32> %v2, %v8
      %v10 = xor <4 x i32> %v1, %v9
      %v11 = shl <4 x i32> %v10, <i32 12, i32 12, i32 12, i32 12>
      %v12 = lshr <4 x i32> %v10, <i32 20, i32 20, i32 20, i32 20>
      %v13 = or <4 x i32> %v11, %v12
      %v14 = add <4 x i32> %v4, %v13
      %v15 = xor <4 x i32> %v8, %v14
      %v16 = shl <4 x i32> %v15, <i32 8, i32 8, i32 8, i32 8>
      %v17 = lshr <4 x i32> %v15, <i32 24, i32 24, i32 24, i32 24>
      %v18 = or <4 x i32> %v16, %v17
      %v19 = add <4 x i32> %v9, %v18
      %v20 = xor <4 x i32> %v13, %v19
      %v21 = shl <4 x i32> %v20, <i32 7, i32 7, i32 7, i32 7>
      %v22 = lshr <4 x i32> %v20, <i32 25, i32 25, i32 25, i32 25>
      %v23 = or <4 x i32> %v21, %v22
      %v24 = shufflevector <4 x i32> %v23, <4 x i32> poison, <4 x i32> <i32 1, i32 2, i32 3, i32 0>
      %v25 = shufflevector <4 x i32> %v19, <4 x i32> poison, <4 x i32> <i32 2, i32 3, i32 0, i32 1>
      %v26 = shufflevector <4 x i32> %v18, <4 x i32> poison, <4 x i32> <i32 3, i32 0, i32 1, i32 2>
      %v27 = add <4 x i32> %v14, %v24
      %v28 = xor <4 x i32> %v26, %v27
      %v29 = shl <4 x i32> %v28, <i32 16, i32 16, i32 16, i32 16>
      %v30 = lshr <4 x i32> %v28, <i32 16, i32 16, i32 16, i32 16>
      %v31 = or <4 x i32> %v29, %v30
      %v32 = add <4 x i32> %v25, %v31
      %v33 = xor <4 x i32> %v24, %v32
      %v34 = shl <4 x i32> %v33, <i32 12, i32 12, i32 12, i32 12>
      %v35 = lshr <4 x i32> %v33, <i32 20, i32 20, i32 20, i32 20>
      %v36 = or <4 x i32> %v34, %v35
      %v37 = add <4 x i32> %v27, %v36
      %v38 = xor <4 x i32> %v31, %v37
      %v39 = shl <4 x i32> %v38, <i32 8, i32 8, i32 8, i32 8>
      %v40 = lshr <4 x i32> %v38, <i32 24, i32 24, i32 24, i32 24>
      %v41 = or <4 x i32> %v39, %v40
      %v42 = add <4 x i32> %v32, %v41
      %v43 = xor <4 x i32> %v36, %v42
      %v44 = shl <4 x i32> %v43, <i32 7, i32 7, i32 7, i32 7>
      %v45 = lshr <4 x i32> %v43, <i32 25, i32 25, i32 25, i32 25>
      %v46 = or <4 x i32> %v44, %v45
      %v47 = shufflevector <4 x i32> %v46, <4 x i32> poison, <4 x i32> <i32 3, i32 0, i32 1, i32 2>
      %v48 = shufflevector <4 x i32> %v42, <4 x i32> poison, <4 x i32> <i32 2, i32 3, i32 0, i32 1>
      %v49 = shufflevector <4 x i32> %v41, <4 x i32> poison, <4 x i32> <i32 1, i32 2, i32 3, i32 0>
      %v50 = add <4 x i32> %v37, %v47
      %v51 = xor <4 x i32> %v49, %v50
      %v52 = shl <4 x i32> %v51, <i32 16, i32 16, i32 16, i32 16>
      %v53 = lshr <4 x i32> %v51, <i32 16, i32 16, i32 16, i32 16>
      %v54 = or <4 x i32> %v52, %v53
      %v55 = add <4 x i32> %v48, %v54
      %v56 = xor <4 x i32> %v47, %v55
      %v57 = shl <4 x i32> %v56, <i32 12, i32 12, i32 12, i32 12>
      %v58 = lshr <4 x i32> %v56, <i32 20, i32 20, i32 20, i32 20>
      %v59 = or <4 x i32> %v57, %v58
      %v60 = add <4 x i32> %v50, %v59
      %v61 = xor <4 x i32> %v54, %v60
      %v62 = shl <4 x i32> %v61, <i32 8, i32 8, i32 8, i32 8>
      %v63 = lshr <4 x i32> %v61, <i32 24, i32 24, i32 24, i32 24>
      %v64 = or <4 x i32> %v62, %v63
      %v65 = add <4 x i32> %v55, %v64
      %v66 = xor <4 x i32> %v59, %v65
      %v67 = shl <4 x i32> %v66, <i32 7, i32 7, i32 7, i32 7>
      %v68 = lshr <4 x i32> %v66, <i32 25, i32 25, i32 25, i32 25>
      %v69 = or <4 x i32> %v67, %v68
      %v70 = shufflevector <4 x i32> %v69, <4 x i32> poison, <4 x i32> <i32 1, i32 2, i32 3, i32 0>
      %v71 = shufflevector <4 x i32> %v65, <4 x i32> poison, <4 x i32> <i32 2, i32 3, i32 0, i32 1>
      %v72 = shufflevector <4 x i32> %v64, <4 x i32> poison, <4 x i32> <i32 3, i32 0, i32 1, i32 2>
      %v73 = add <4 x i32> %v60, %v70
      %v74 = xor <4 x i32> %v72, %v73
      %v75 = shl <4 x i32> %v74, <i32 16, i32 16, i32 16, i32 16>
      %v76 = lshr <4 x i32> %v74, <i32 16, i32 16, i32 16, i32 16>
      %v77 = or <4 x i32> %v75, %v76
      %v78 = add <4 x i32> %v71, %v77
      %v79 = xor <4 x i32> %v70, %v78
      %v80 = shl <4 x i32> %v79, <i32 12, i32 12, i32 12, i32 12>
