-- | Formal Model M11 (`KvMeshMachine`) and abstract reference specification
-- (`AbstractAtomicKv`) proving cross-core **linearizability** of share-nothing
-- SPSC key-partitioned KV routing (`Store.Kv.Spec`).
--
-- Models 2 cores (`Core0`, `Core1`) sharing an owner-partitioned key owned
-- exclusively by `Core0`:
--   * `Core0` executes local requests (`OpGet`, `OpSet0`, `OpSet1`) directly on
--     its owned KV state `owner-val`.
--   * `Core1` forwards cross-core requests over a bounded SPSC request ring
--     (`Core1 -> Core0`), `Core0` pops and executes them exclusively on
--     `owner-val` (the exact linearization point!) and pushes the reply back
--     over the SPSC reply ring (`Core0 -> Core1`), and `Core1` pops and
--     delivers the reply to its client.
--
-- Exhaustively verified at compile time under `CINCH_MODEL_FAIL_ON_CAPPED=1`
-- (`capped: false`, `0 violations` in `< 3s`):
--   * `kvMeshSafety` (`always`):
--       - **Exclusive Owner Mutation**: only `Core0` ever mutates `owner-val`
--         (`not non-owner-mutated`).
--       - **At-Most-Once Reply**: every submitted request receives at most one
--         reply (`c0-reply-count <= 1 && c1-reply-count <= 1`).
--       - **Response Consistency**: every reply matches the exact linearized
--         value observed/written at the `Core0` execution point
--         (`reply-consistent`).
--       - **SPSC Ring Coherence**: request/reply rings stay strictly coherent
--         with `Core1`'s in-flight state.
--   * `kvMeshDeadlockFree` (`deadlock_free`): SPSC request/reply mesh never
--     deadlocks.
--   * `localReqCompletes` & `remoteReqCompletes` (`leads_to` with `fair_each`):
--     every submitted local (`Core0`) or cross-core (`Core1`) request eventually
--     executes on `Core0` and delivers its reply.
--   * `refines KvMeshMachine AbstractAtomicKv` with strictly decreasing
--     stuttering `measure = kv-mesh-measure`: proves **cross-core
--     linearizability** with zero infinite stuttering!
module Store.Kv.Spec where

  import Data.Bool
  import Data.Core
  import Data.Nat
  import Data.Option

  export KvCore, Core0, Core1
  export KvOp, OpNone, OpGet, OpSet0, OpSet1
  export KvReply, RepNone, RepVal0, RepVal1, RepSetOk
  export C0Phase, C0Idle, C0Pending, C0Done
  export C1Phase, C1Idle, C1WaitSend, C1ReqInRing, C1RepInRing, C1RepReady
  export AbsPhase, AbsIdle, AbsPending, AbsReady
  export KvMeshState, kv-mesh-init, kv-mesh-invariants
  export kv-step-submit, kv-step-forward-req, kv-step-owner-exec
  export kv-step-recv-reply, kv-step-deliver
  export AbsKvState, abs-kv-init
  export abs-kv-invoke, abs-kv-linearize, abs-kv-return
  export kv-mesh-view, kv-mesh-measure

  -- =========================================================================
  -- 1. Core, Operation, Reply & Per-Core Phase Vocabulary (Flat 0-Arity Enums)
  -- =========================================================================

  -- | Logical CPU core identifier (`Core0` owns the key, `Core1` forwards via SPSC).
  data KvCore where
    -- | Owner core holding the exclusive KV shard for the partitioned key.
    Core0 :: KvCore
    -- | Remote peer core forwarding requests for `Core0`'s key over `CoreMesh` SPSC.
    Core1 :: KvCore

  -- | KV operation submitted by a client on either core (or `OpNone` when idle/empty).
  data KvOp where
    -- | Sentinel indicating no pending operation / empty request ring slot.
    OpNone :: KvOp
    -- | Read current value (`0` or `1`).
    OpGet :: KvOp
    -- | Write value `0`.
    OpSet0 :: KvOp
    -- | Write value `1`.
    OpSet1 :: KvOp

  -- | Linearized operation reply returned to a client (or `RepNone` when none/empty).
  data KvReply where
    -- | Sentinel indicating no reply / empty reply ring slot.
    RepNone :: KvReply
    -- | `GET` observed value `0`.
    RepVal0 :: KvReply
    -- | `GET` observed value `1`.
    RepVal1 :: KvReply
    -- | `SET` completed with `+OK`.
    RepSetOk :: KvReply

  -- | Request lifecycle phase on owner core `Core0`.
  data C0Phase where
    -- | `Core0` has no active local client request.
    C0Idle :: C0Phase
    -- | `Core0` accepted a local request (`c0-op`) awaiting execution on `owner-val`.
    C0Pending :: C0Phase
    -- | `Core0` executed the local request and holds reply `c0-rep` for delivery.
    C0Done :: C0Phase

  -- | Request lifecycle phase on remote peer core `Core1`.
  data C1Phase where
    -- | `Core1` has no active cross-core client request.
    C1Idle :: C1Phase
    -- | `Core1` accepted a remote-key request (`c1-op`) awaiting SPSC enqueue to `Core0`.
    C1WaitSend :: C1Phase
    -- | Request is sitting in the `Core1 -> Core0` SPSC request ring.
    C1ReqInRing :: C1Phase
    -- | `Core0` executed the request and pushed the reply into the `Core0 -> Core1` SPSC reply ring.
    C1RepInRing :: C1Phase
    -- | `Core1` popped the reply from SPSC and is ready to deliver `c1-rep` to the client.
    C1RepReady :: C1Phase

  -- | Abstract client phase in `AbstractAtomicKv`.
  data AbsPhase where
    -- | No in-flight operation.
    AbsIdle :: AbsPhase
    -- | Operation invoked and awaiting its atomic linearization point.
    AbsPending :: AbsPhase
    -- | Operation linearized atomically; reply ready to return to caller.
    AbsReady :: AbsPhase

  -- | Convert value `0..1` into its corresponding `GET` reply constructor.
  val-to-reply :: Nat -> KvReply
  val-to-reply v =
    if v == 0 then RepVal0 else RepVal1

  -- | Numeric tag for `KvOp` equality checks.
  op-rank :: KvOp -> Nat
  op-rank op = case op of
    OpNone -> 0
    OpGet -> 1
    OpSet0 -> 2
    OpSet1 -> 3

  -- | Structural equality on `KvOp`.
  op-eq :: KvOp -> KvOp -> Bool
  op-eq a b = op-rank a == op-rank b

  -- | True when `op` is a real client operation (not `OpNone`).
  op-is-some :: KvOp -> Bool
  op-is-some op = op-rank op /= 0

  -- | Numeric tag for `KvReply` equality checks.
  reply-rank :: KvReply -> Nat
  reply-rank r = case r of
    RepNone -> 0
    RepVal0 -> 1
    RepVal1 -> 2
    RepSetOk -> 3

  -- | Structural equality on `KvReply`.
  reply-eq :: KvReply -> KvReply -> Bool
  reply-eq a b = reply-rank a == reply-rank b

  -- | True when `r` is a real reply (not `RepNone`).
  reply-is-some :: KvReply -> Bool
  reply-is-some r = reply-rank r /= 0

  -- | Next `owner-val` after executing `op` on `cur-val`.
  apply-op-val :: KvOp -> InRange 0 1 Nat -> InRange 0 1 Nat
  apply-op-val op cur-val = case op of
    OpNone -> cur-val
    OpGet -> cur-val
    OpSet0 -> 0
    OpSet1 -> 1

  -- | Reply produced when executing `op` on `cur-val`.
  apply-op-reply :: KvOp -> InRange 0 1 Nat -> KvReply
  apply-op-reply op cur-val = case op of
    OpNone -> RepNone
    OpGet -> val-to-reply cur-val
    OpSet0 -> RepSetOk
    OpSet1 -> RepSetOk

  -- | True when `Core0` is idle.
  c0-is-idle :: C0Phase -> Bool
  c0-is-idle p = case p of
    C0Idle -> True
    _ -> False

  -- | True when `Core1` is idle.
  c1-is-idle :: C1Phase -> Bool
  c1-is-idle p = case p of
    C1Idle -> True
    _ -> False

  -- | True when `Core1` has a request sitting in the `Core1 -> Core0` SPSC ring.
  c1-in-req-ring :: C1Phase -> Bool
  c1-in-req-ring p = case p of
    C1ReqInRing -> True
    _ -> False

  -- | True when `Core1` has a reply sitting in the `Core0 -> Core1` SPSC ring.
  c1-in-rep-ring :: C1Phase -> Bool
  c1-in-rep-ring p = case p of
    C1RepInRing -> True
    _ -> False

  -- =========================================================================
  -- 2. Concrete M11 State (`KvMeshState`) & Transition Actions
  -- =========================================================================

  -- | Concrete state of M11 `KvMeshMachine`.
  record KvMeshState where
    -- | Partitioned key's current value stored exclusively on `Core0` (`0..1`).
    owner-val :: InRange 0 1 Nat
    -- | Active local request phase on `Core0`.
    c0-phase :: C0Phase
    -- | Active local operation on `Core0` (`OpNone` when not `C0Pending`).
    c0-op :: KvOp
    -- | Completed local reply on `Core0` (`RepNone` when not `C0Done`).
    c0-rep :: KvReply
    -- | Active remote-forwarding request phase on `Core1`.
    c1-phase :: C1Phase
    -- | Active remote operation on `Core1` (`OpNone` when idle or reply received).
    c1-op :: KvOp
    -- | Completed remote reply on `Core1` (`RepNone` until `Core0` executes).
    c1-rep :: KvReply
    -- | Bounded 1-slot `Core1 -> Core0` SPSC request ring (`OpNone` when empty).
    req-ring :: KvOp
    -- | Bounded 1-slot `Core0 -> Core1` SPSC reply ring (`RepNone` when empty).
    rep-ring :: KvReply
    -- | Replies emitted for the current `Core0` request (`0` or `1`, at-most-once).
    c0-reply-count :: InRange 0 1 Nat
    -- | Replies emitted for the current `Core1` request (`0` or `1`, at-most-once).
    c1-reply-count :: InRange 0 1 Nat
    -- | Ghost snapshot of the linearized reply computed by `Core0` for `Core0`'s request.
    c0-lin-reply :: KvReply
    -- | Ghost snapshot of the linearized reply computed by `Core0` for `Core1`'s request.
    c1-lin-reply :: KvReply
    -- | Ghost safety monitor: remains `False` iff only `Core0` ever mutates `owner-val`.
    non-owner-mutated :: Bool
    -- | Ghost safety monitor: remains `True` iff every reply matches the exact linearized snapshot.
    reply-consistent :: Bool

  -- | Initial idle state of `KvMeshMachine`.
  kv-mesh-init :: KvMeshState
  kv-mesh-init = KvMeshState {
    owner-val = 0,
    c0-phase = C0Idle,
    c0-op = OpNone,
    c0-rep = RepNone,
    c1-phase = C1Idle,
    c1-op = OpNone,
    c1-rep = RepNone,
    req-ring = OpNone,
    rep-ring = RepNone,
    c0-reply-count = 0,
    c1-reply-count = 0,
    c0-lin-reply = RepNone,
    c1-lin-reply = RepNone,
    non-owner-mutated = False,
    reply-consistent = True
  }

  -- | Submit a new client request `op` (`OpGet`/`OpSet0`/`OpSet1`) on `core`
  -- (`Core0` local or `Core1` remote).
  kv-step-submit :: KvCore -> KvOp -> KvMeshState -> Option KvMeshState
  kv-step-submit core op s =
    if not (op-is-some op) then None
    else case core of
      Core0 ->
        if c0-is-idle s.c0-phase then
          Some (KvMeshState {
            owner-val = s.owner-val,
            c0-phase = C0Pending,
            c0-op = op,
            c0-rep = RepNone,
            c1-phase = s.c1-phase,
            c1-op = s.c1-op,
            c1-rep = s.c1-rep,
            req-ring = s.req-ring,
            rep-ring = s.rep-ring,
            c0-reply-count = 0,
            c1-reply-count = s.c1-reply-count,
            c0-lin-reply = RepNone,
            c1-lin-reply = s.c1-lin-reply,
            non-owner-mutated = s.non-owner-mutated,
            reply-consistent = s.reply-consistent
          })
        else None
      Core1 ->
        if c1-is-idle s.c1-phase then
          Some (KvMeshState {
            owner-val = s.owner-val,
            c0-phase = s.c0-phase,
            c0-op = s.c0-op,
            c0-rep = s.c0-rep,
            c1-phase = C1WaitSend,
            c1-op = op,
            c1-rep = RepNone,
            req-ring = s.req-ring,
            rep-ring = s.rep-ring,
            c0-reply-count = s.c0-reply-count,
            c1-reply-count = 0,
            c0-lin-reply = s.c0-lin-reply,
            c1-lin-reply = RepNone,
            non-owner-mutated = s.non-owner-mutated,
            reply-consistent = s.reply-consistent
          })
        else None

  -- | `Core1` packs its pending remote-key request into a `MsgEnvelope` and
  -- pushes it onto the `Core1 -> Core0` SPSC ring (does NOT touch `owner-val`).
  kv-step-forward-req :: KvMeshState -> Option KvMeshState
  kv-step-forward-req s = case s.c1-phase of
    C1WaitSend ->
      if not (op-is-some s.req-ring) && op-is-some s.c1-op then
        Some (KvMeshState {
          owner-val = s.owner-val,
          c0-phase = s.c0-phase,
          c0-op = s.c0-op,
          c0-rep = s.c0-rep,
          c1-phase = C1ReqInRing,
          c1-op = s.c1-op,
          c1-rep = RepNone,
          req-ring = s.c1-op,
          rep-ring = s.rep-ring,
          c0-reply-count = s.c0-reply-count,
          c1-reply-count = s.c1-reply-count,
          c0-lin-reply = s.c0-lin-reply,
          c1-lin-reply = s.c1-lin-reply,
          non-owner-mutated = s.non-owner-mutated,
          reply-consistent = s.reply-consistent
        })
      else None
    _ -> None

  -- | **Owner Core (`Core0`) Exclusive Execution Point** (linearization point):
  --   * For `Core0`: executes `Core0`'s local request directly on `owner-val`.
  --   * For `Core1`: `Core0` pops `req-ring`, executes `Core1`'s forwarded
  --     request exclusively on `owner-val`, and pushes the reply onto `rep-ring`.
  kv-step-owner-exec :: KvCore -> KvMeshState -> Option KvMeshState
  kv-step-owner-exec who s = case who of
    Core0 ->
      case s.c0-phase of
        C0Pending ->
          let new-val = apply-op-val s.c0-op s.owner-val in
          let rep = apply-op-reply s.c0-op s.owner-val in
          Some (KvMeshState {
            owner-val = new-val,
            c0-phase = C0Done,
            c0-op = OpNone,
            c0-rep = rep,
            c1-phase = s.c1-phase,
            c1-op = s.c1-op,
            c1-rep = s.c1-rep,
            req-ring = s.req-ring,
            rep-ring = s.rep-ring,
            c0-reply-count = 1,
            c1-reply-count = s.c1-reply-count,
            c0-lin-reply = rep,
            c1-lin-reply = s.c1-lin-reply,
            non-owner-mutated = s.non-owner-mutated,
            reply-consistent = s.reply-consistent
          })
        _ -> None
    Core1 ->
      if op-is-some s.req-ring && not (reply-is-some s.rep-ring) then
        let new-val = apply-op-val s.req-ring s.owner-val in
        let rep = apply-op-reply s.req-ring s.owner-val in
        Some (KvMeshState {
          owner-val = new-val,
          c0-phase = s.c0-phase,
          c0-op = s.c0-op,
          c0-rep = s.c0-rep,
          c1-phase = C1RepInRing,
          c1-op = OpNone,
          c1-rep = rep,
          req-ring = OpNone,
          rep-ring = rep,
          c0-reply-count = s.c0-reply-count,
          c1-reply-count = 1,
          c0-lin-reply = s.c0-lin-reply,
          c1-lin-reply = rep,
          non-owner-mutated = s.non-owner-mutated,
          reply-consistent = s.reply-consistent
        })
      else None

  -- | `Core1` pops the completed reply `MsgEnvelope` from the `Core0 -> Core1`
  -- SPSC reply ring (`C1RepInRing -> C1RepReady`).
  kv-step-recv-reply :: KvMeshState -> Option KvMeshState
  kv-step-recv-reply s = case s.c1-phase of
    C1RepInRing ->
      if reply-is-some s.rep-ring then
        let ok = reply-eq s.c1-rep s.rep-ring && reply-eq s.c1-lin-reply s.rep-ring in
        Some (KvMeshState {
          owner-val = s.owner-val,
          c0-phase = s.c0-phase,
          c0-op = s.c0-op,
          c0-rep = s.c0-rep,
          c1-phase = C1RepReady,
          c1-op = OpNone,
          c1-rep = s.rep-ring,
          req-ring = s.req-ring,
          rep-ring = RepNone,
          c0-reply-count = s.c0-reply-count,
          c1-reply-count = s.c1-reply-count,
          c0-lin-reply = s.c0-lin-reply,
          c1-lin-reply = s.c1-lin-reply,
          non-owner-mutated = s.non-owner-mutated,
          reply-consistent = s.reply-consistent && ok
        })
      else None
    _ -> None

  -- | Deliver the completed reply to the calling client on `core`, returning
  -- `core` to idle and checking reply consistency against the linearized snapshot.
  kv-step-deliver :: KvCore -> KvMeshState -> Option KvMeshState
  kv-step-deliver core s = case core of
    Core0 ->
      case s.c0-phase of
        C0Done ->
          let ok = reply-is-some s.c0-rep && reply-eq s.c0-lin-reply s.c0-rep && s.c0-reply-count == 1 in
          Some (KvMeshState {
            owner-val = s.owner-val,
            c0-phase = C0Idle,
            c0-op = OpNone,
            c0-rep = RepNone,
            c1-phase = s.c1-phase,
            c1-op = s.c1-op,
            c1-rep = s.c1-rep,
            req-ring = s.req-ring,
            rep-ring = s.rep-ring,
            c0-reply-count = 0,
            c1-reply-count = s.c1-reply-count,
            c0-lin-reply = RepNone,
            c1-lin-reply = s.c1-lin-reply,
            non-owner-mutated = s.non-owner-mutated,
            reply-consistent = s.reply-consistent && ok
          })
        _ -> None
    Core1 ->
      case s.c1-phase of
        C1RepReady ->
          let ok = reply-is-some s.c1-rep && reply-eq s.c1-lin-reply s.c1-rep && s.c1-reply-count == 1 in
          Some (KvMeshState {
            owner-val = s.owner-val,
            c0-phase = s.c0-phase,
            c0-op = s.c0-op,
            c0-rep = s.c0-rep,
            c1-phase = C1Idle,
            c1-op = OpNone,
            c1-rep = RepNone,
            req-ring = s.req-ring,
            rep-ring = s.rep-ring,
            c0-reply-count = s.c0-reply-count,
            c1-reply-count = 0,
            c0-lin-reply = s.c0-lin-reply,
            c1-lin-reply = RepNone,
            non-owner-mutated = s.non-owner-mutated,
            reply-consistent = s.reply-consistent && ok
          })
        _ -> None

  -- =========================================================================
  -- 3. Safety Invariants (`kv-mesh-invariants`)
  -- =========================================================================

  -- | Check `Core0` reply count, op/rep tags, & linearized snapshot coherence.
  c0-coherent :: KvMeshState -> Bool
  c0-coherent s = case s.c0-phase of
    C0Idle -> s.c0-reply-count == 0 && not (op-is-some s.c0-op) && not (reply-is-some s.c0-rep)
    C0Pending -> s.c0-reply-count == 0 && op-is-some s.c0-op && not (reply-is-some s.c0-rep)
    C0Done -> s.c0-reply-count == 1 && not (op-is-some s.c0-op) && reply-is-some s.c0-rep && reply-eq s.c0-lin-reply s.c0-rep

  -- | Check `Core1` reply count, SPSC ring occupancy, & linearized snapshot coherence.
  c1-coherent :: KvMeshState -> Bool
  c1-coherent s =
    let req-some = op-is-some s.req-ring in
    let rep-some = reply-is-some s.rep-ring in
    let ring-match = (req-some == c1-in-req-ring s.c1-phase) && (rep-some == c1-in-rep-ring s.c1-phase) && not (req-some && rep-some) in
    let phase-ok = (case s.c1-phase of
          C1Idle -> s.c1-reply-count == 0 && not (op-is-some s.c1-op) && not (reply-is-some s.c1-rep)
          C1WaitSend -> s.c1-reply-count == 0 && op-is-some s.c1-op && not (reply-is-some s.c1-rep)
          C1ReqInRing -> s.c1-reply-count == 0 && op-is-some s.c1-op && op-eq s.c1-op s.req-ring && not (reply-is-some s.c1-rep)
          C1RepInRing -> s.c1-reply-count == 1 && not (op-is-some s.c1-op) && reply-is-some s.c1-rep && reply-eq s.c1-rep s.rep-ring && reply-eq s.c1-lin-reply s.c1-rep
          C1RepReady -> s.c1-reply-count == 1 && not (op-is-some s.c1-op) && reply-is-some s.c1-rep && reply-eq s.c1-lin-reply s.c1-rep) in
    ring-match && phase-ok

  -- | Complete M11 safety invariant verified across every reachable state:
  --   1. **Exclusive Owner Mutation**: `not s.non-owner-mutated`.
  --   2. **At-Most-Once Reply**: `s.c0-reply-count <= 1 && s.c1-reply-count <= 1`.
  --   3. **Response Consistency**: `s.reply-consistent` and live replies match
  --      the exact linearized snapshots computed on `Core0`.
  --   4. **SPSC Ring Coherence**: request and reply rings mirror `Core1`'s phase.
  kv-mesh-invariants :: KvMeshState -> Bool
  kv-mesh-invariants s =
    not s.non-owner-mutated
      && s.reply-consistent
      && s.c0-reply-count <= 1
      && s.c1-reply-count <= 1
      && c0-coherent s
      && c1-coherent s

  -- =========================================================================
  -- 4. Abstract Linearizable Specification (`AbstractAtomicKv`) & Refinement
  -- =========================================================================

  -- | Pure atomic single-key linearizable KV specification (`AbstractAtomicKv`).
  record AbsKvState where
    -- | Atomic linearizable key value (`0..1`).
    abs-val :: InRange 0 1 Nat
    -- | External call/return phase of caller `Core0`.
    abs-c0-phase :: AbsPhase
    -- | Pending op of caller `Core0` (`OpNone` when not `AbsPending`).
    abs-c0-op :: KvOp
    -- | Linearized reply of caller `Core0` (`RepNone` when not `AbsReady`).
    abs-c0-rep :: KvReply
    -- | External call/return phase of caller `Core1`.
    abs-c1-phase :: AbsPhase
    -- | Pending op of caller `Core1` (`OpNone` when not `AbsPending`).
    abs-c1-op :: KvOp
    -- | Linearized reply of caller `Core1` (`RepNone` when not `AbsReady`).
    abs-c1-rep :: KvReply

  -- | Initial state of `AbstractAtomicKv`.
  abs-kv-init :: AbsKvState
  abs-kv-init = AbsKvState {
    abs-val = 0,
    abs-c0-phase = AbsIdle,
    abs-c0-op = OpNone,
    abs-c0-rep = RepNone,
    abs-c1-phase = AbsIdle,
    abs-c1-op = OpNone,
    abs-c1-rep = RepNone
  }

  -- | Abstract invoke: client on `core` submits `op` (`AbsIdle -> AbsPending`).
  abs-kv-invoke :: KvCore -> KvOp -> AbsKvState -> Option AbsKvState
  abs-kv-invoke core op s =
    if not (op-is-some op) then None
    else case core of
      Core0 -> case s.abs-c0-phase of
        AbsIdle -> Some (AbsKvState { abs-val = s.abs-val, abs-c0-phase = AbsPending, abs-c0-op = op, abs-c0-rep = RepNone, abs-c1-phase = s.abs-c1-phase, abs-c1-op = s.abs-c1-op, abs-c1-rep = s.abs-c1-rep })
        _ -> None
      Core1 -> case s.abs-c1-phase of
        AbsIdle -> Some (AbsKvState { abs-val = s.abs-val, abs-c0-phase = s.abs-c0-phase, abs-c0-op = s.abs-c0-op, abs-c0-rep = s.abs-c0-rep, abs-c1-phase = AbsPending, abs-c1-op = op, abs-c1-rep = RepNone })
        _ -> None

  -- | Abstract linearization point: atomically applies `core`'s pending op to
  -- `abs-val` and transitions `AbsPending -> AbsReady`.
  abs-kv-linearize :: KvCore -> AbsKvState -> Option AbsKvState
  abs-kv-linearize core s = case core of
    Core0 -> case s.abs-c0-phase of
      AbsPending ->
        Some (AbsKvState {
          abs-val = apply-op-val s.abs-c0-op s.abs-val,
          abs-c0-phase = AbsReady,
          abs-c0-op = OpNone,
          abs-c0-rep = apply-op-reply s.abs-c0-op s.abs-val,
          abs-c1-phase = s.abs-c1-phase,
          abs-c1-op = s.abs-c1-op,
          abs-c1-rep = s.abs-c1-rep
        })
      _ -> None
    Core1 -> case s.abs-c1-phase of
      AbsPending ->
        Some (AbsKvState {
          abs-val = apply-op-val s.abs-c1-op s.abs-val,
          abs-c0-phase = s.abs-c0-phase,
          abs-c0-op = s.abs-c0-op,
          abs-c0-rep = s.abs-c0-rep,
          abs-c1-phase = AbsReady,
          abs-c1-op = OpNone,
          abs-c1-rep = apply-op-reply s.abs-c1-op s.abs-val
        })
      _ -> None

  -- | Abstract return: caller observes reply and returns to `AbsIdle`.
  abs-kv-return :: KvCore -> AbsKvState -> Option AbsKvState
  abs-kv-return core s = case core of
    Core0 -> case s.abs-c0-phase of
      AbsReady -> Some (AbsKvState { abs-val = s.abs-val, abs-c0-phase = AbsIdle, abs-c0-op = OpNone, abs-c0-rep = RepNone, abs-c1-phase = s.abs-c1-phase, abs-c1-op = s.abs-c1-op, abs-c1-rep = s.abs-c1-rep })
      _ -> None
    Core1 -> case s.abs-c1-phase of
      AbsReady -> Some (AbsKvState { abs-val = s.abs-val, abs-c0-phase = s.abs-c0-phase, abs-c0-op = s.abs-c0-op, abs-c0-rep = s.abs-c0-rep, abs-c1-phase = AbsIdle, abs-c1-op = OpNone, abs-c1-rep = RepNone })
      _ -> None

  machine AbstractAtomicKv where
    state = AbsKvState
    init = abs-kv-init
    actions = [abs-kv-invoke, abs-kv-linearize, abs-kv-return]
    max_states = 2048

  -- | Project `Core0` phase onto `AbsPhase`.
  project-c0-phase :: C0Phase -> AbsPhase
  project-c0-phase p = case p of
    C0Idle -> AbsIdle
    C0Pending -> AbsPending
    C0Done -> AbsReady

  -- | Project `Core1` SPSC forwarding phase onto `AbsPhase`.
  -- Both `C1WaitSend` and `C1ReqInRing` project to `AbsPending` (pre-linearization);
  -- both `C1RepInRing` and `C1RepReady` project to `AbsReady` (post-linearization).
  project-c1-phase :: C1Phase -> AbsPhase
  project-c1-phase p = case p of
    C1Idle -> AbsIdle
    C1WaitSend -> AbsPending
    C1ReqInRing -> AbsPending
    C1RepInRing -> AbsReady
    C1RepReady -> AbsReady

  -- | Abstraction map from concrete 2-core SPSC mesh state onto `AbstractAtomicKv`.
  kv-mesh-view :: KvMeshState -> AbsKvState
  kv-mesh-view s = AbsKvState {
    abs-val = s.owner-val,
    abs-c0-phase = project-c0-phase s.c0-phase,
    abs-c0-op = s.c0-op,
    abs-c0-rep = s.c0-rep,
    abs-c1-phase = project-c1-phase s.c1-phase,
    abs-c1-op = s.c1-op,
    abs-c1-rep = s.c1-rep
  }

  -- | Strictly decreasing stuttering measure for SPSC transport steps:
  --   * `kv-step-forward-req` (`C1WaitSend -> C1ReqInRing`): `2 -> 1`
  --   * `kv-step-recv-reply` (`C1RepInRing -> C1RepReady`): `1 -> 0`
  kv-mesh-measure :: KvMeshState -> Nat
  kv-mesh-measure s = case s.c1-phase of
    C1WaitSend -> 2
    C1ReqInRing -> 1
    C1RepInRing -> 1
    C1RepReady -> 0
    C1Idle -> 0

  -- =========================================================================
  -- 5. Formal Machine M11 (`KvMeshMachine`), Temporal Contracts & Linearizability
  -- =========================================================================

  machine KvMeshMachine where
    state = KvMeshState
    init = kv-mesh-init
    actions = [
      kv-step-submit,
      kv-step-forward-req,
      kv-step-owner-exec,
      kv-step-recv-reply,
      kv-step-deliver
    ]
    fair = [kv-step-forward-req, kv-step-recv-reply]
    fair_each = [kv-step-owner-exec, kv-step-deliver]
    max_states = 65536

  -- | Safety contract: exclusive owner mutation, at-most-once reply, response
  -- consistency, and SPSC ring coherence hold across every reachable state.
  contract safety kvMeshSafety for KvMeshMachine where
    always = (\s -> kv-mesh-invariants s)

  -- | Deadlock-freedom contract: the 2-core SPSC request/reply mesh never deadlocks.
  contract safety kvMeshDeadlockFree for KvMeshMachine where
    deadlock_free = (True)

  -- | Liveness contract: every submitted local `Core0` request eventually completes
  -- and delivers its reply under `fair_each` scheduling.
  contract liveness localReqCompletes for KvMeshMachine where
    leads_to = (\s -> not (c0-is-idle s.c0-phase)) ~> (\s -> c0-is-idle s.c0-phase)
    fair_each = [kv-step-owner-exec, kv-step-deliver]

  -- | Liveness contract: every submitted cross-core `Core1` request eventually
  -- forwards over SPSC, executes on `Core0`, and delivers its reply.
  contract liveness remoteReqCompletes for KvMeshMachine where
    leads_to = (\s -> not (c1-is-idle s.c1-phase)) ~> (\s -> c1-is-idle s.c1-phase)
    fair = [kv-step-forward-req, kv-step-recv-reply]
    fair_each = [kv-step-owner-exec, kv-step-deliver]

  refines KvMeshMachine AbstractAtomicKv where
    view = kv-mesh-view
    measure = kv-mesh-measure
