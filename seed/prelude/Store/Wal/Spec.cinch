-- | Compile-time formal TLA+-style model M10 (`WalMachine`) and abstract
-- specification (`AbstractDurableLog`) for the 4 KiB-aligned group-commit WAL
-- (`Store.Wal.Engine`).
--
-- Models a bounded WAL (`0..3` LSNs, 2 segments `0..1`) with explicit volatile
-- RAM batch staging (`appended-lsn`), un-fsynced volatile disk write cache
-- (`written-lsn`), `fsync`-persisted durable prefix (`durable-lsn`), client
-- acknowledgement watermark (`acked-lsn`), segment rotation (`segment-id`),
-- clean power-loss crashes (`wal-step-crash-clean`), mid-write torn-sector
-- crashes (`wal-step-crash-torn-sector`), and crash recovery (`wal-step-recover`).
--
-- Exhaustively model-checked at compile time (`max_states = 65536`,
-- `capped: false`, `0 violations` under `CINCH_MODEL_FAIL_ON_CAPPED=1`):
--   * `walDurabilityAndSafety` (`always`):
--       - **Durability**: every acknowledged LSN survives any `crash_clean` or
--         `crash_torn_sector` + `recover` (`acked-lsn <= durable-lsn`).
--       - **Contiguous Prefix**: `durable-lsn <= written-lsn <= appended-lsn`
--         and zero gaps after recovery (`not gap-detected`).
--       - **Torn-Tail Safety**: a torn un-fsynced sector is discarded cleanly on
--         recovery without ever corrupting any earlier acknowledged LSN
--         (`not torn-corrupted-acked`, `not torn-tail` while `WalRunning`).
--   * `walDeadlockFree` (`deadlock_free`): every reachable state has at least
--     one enabled transition.
--   * `stagedEventuallyResolves` & `crashedEventuallyRecovers` (`leads_to`):
--     under weak fairness, staged appends eventually commit durably or cleanly
--     recover after crash, and any crashed node always recovers cleanly.
--   * `refines WalMachine AbstractDurableLog` (with strictly decreasing
--     `measure = wal-stutter-measure`): checked stuttering simulation proving
--     volatile cache staging, client ack lag, and segment rotation refine a
--     pure abstract durable log without infinite stuttering.
module Store.Wal.Spec where

  import Data.Bool
  import Data.Core
  import Data.Nat
  import Data.Option

  export WalPhase, WalRunning, WalCrashed
  export wal-is-running, wal-is-crashed
  export WalModelState, wal-model-init, wal-model-invariants
  export wal-step-append, wal-step-write-cache, wal-step-fsync, wal-step-ack
  export wal-step-rotate, wal-step-crash-clean, wal-step-crash-torn-sector, wal-step-recover
  export AbsWalState, abs-wal-init
  export abs-wal-append, abs-wal-commit, abs-wal-crash, abs-wal-recover
  export wal-view, wal-stutter-measure

  -- =========================================================================
  -- 1. Concrete M10 WAL State & Phase Predicates
  -- =========================================================================

  -- | Operational phase of the WAL node (`WalRunning` or `WalCrashed`).
  data WalPhase where
    -- | Normal operation accepting appends, group commits, rotations, or crashes.
    WalRunning :: WalPhase
    -- | Power lost; volatile RAM & write cache wiped, awaiting `wal-step-recover`.
    WalCrashed :: WalPhase

  -- | True when the WAL node is in `WalRunning`.
  wal-is-running :: WalPhase -> Bool
  wal-is-running ph = case ph of
    WalRunning -> True
    WalCrashed -> False

  -- | True when the WAL node is in `WalCrashed`.
  wal-is-crashed :: WalPhase -> Bool
  wal-is-crashed ph = case ph of
    WalRunning -> False
    WalCrashed -> True

  -- | Finite concrete state of M10 `WalMachine` (`MAX_LSN = 3`, segments `0..1`).
  record WalModelState where
    -- | Running vs. crashed recovery phase.
    phase :: WalPhase
    -- | Highest LSN acknowledged to clients (only advances `<= durable-lsn`).
    acked-lsn :: InRange 0 3 Nat
    -- | Highest contiguous valid LSN persisted via `fsync` on disk.
    durable-lsn :: InRange 0 3 Nat
    -- | Highest LSN written to disk volatile cache via 4 KiB `pwrite` (un-fsynced).
    written-lsn :: InRange 0 3 Nat
    -- | Highest LSN staged in RAM batch buffer.
    appended-lsn :: InRange 0 3 Nat
    -- | Active WAL segment (`0` initial, `1` after rotation).
    segment-id :: InRange 0 1 Nat
    -- | True iff disk currently holds a torn un-fsynced tail sector past `durable-lsn`.
    torn-tail :: Bool
    -- | Ghost monitor: True if recovery ever observed an LSN gap or lost an acked LSN.
    gap-detected :: Bool
    -- | Ghost monitor: True if a torn tail sector ever corrupted an earlier acked LSN.
    torn-corrupted-acked :: Bool

  -- | Initial empty WAL state: running on segment `0`, all LSNs `0`, no torn tail.
  wal-model-init :: WalModelState
  wal-model-init = WalModelState {
    phase = WalRunning,
    acked-lsn = 0,
    durable-lsn = 0,
    written-lsn = 0,
    appended-lsn = 0,
    segment-id = 0,
    torn-tail = False,
    gap-detected = False,
    torn-corrupted-acked = False
  }

  -- =========================================================================
  -- 2. Concrete M10 Transition Actions
  -- =========================================================================

  -- | Stage a new WAL record in the 4 KiB-aligned RAM group-commit batch buffer
  -- (`appended-lsn + 1`). Does not yet touch disk or advance `durable-lsn`.
  wal-step-append :: WalModelState -> Option WalModelState
  wal-step-append s =
    let a = s.appended-lsn in
    if wal-is-running s.phase && a < 3 then
      Some (WalModelState {
        phase = WalRunning,
        acked-lsn = s.acked-lsn,
        durable-lsn = s.durable-lsn,
        written-lsn = s.written-lsn,
        appended-lsn = a + 1,
        segment-id = s.segment-id,
        torn-tail = s.torn-tail,
        gap-detected = s.gap-detected,
        torn-corrupted-acked = s.torn-corrupted-acked
      })
    else None

  -- | Issue ONE 4 KiB-aligned `pwrite` of the staged batch into disk's volatile
  -- write cache (`written-lsn := appended-lsn`). Still un-fsynced!
  wal-step-write-cache :: WalModelState -> Option WalModelState
  wal-step-write-cache s =
    if wal-is-running s.phase && s.written-lsn < s.appended-lsn then
      Some (WalModelState {
        phase = WalRunning,
        acked-lsn = s.acked-lsn,
        durable-lsn = s.durable-lsn,
        written-lsn = s.appended-lsn,
        appended-lsn = s.appended-lsn,
        segment-id = s.segment-id,
        torn-tail = False,
        gap-detected = s.gap-detected,
        torn-corrupted-acked = s.torn-corrupted-acked
      })
    else None

  -- | Issue `fsync`/`fdatasync`, atomically promoting all written blocks in
  -- volatile disk cache to durable storage (`durable-lsn := written-lsn`).
  wal-step-fsync :: WalModelState -> Option WalModelState
  wal-step-fsync s =
    if wal-is-running s.phase && s.durable-lsn < s.written-lsn then
      Some (WalModelState {
        phase = WalRunning,
        acked-lsn = s.acked-lsn,
        durable-lsn = s.written-lsn,
        written-lsn = s.written-lsn,
        appended-lsn = s.appended-lsn,
        segment-id = s.segment-id,
        torn-tail = False,
        gap-detected = s.gap-detected,
        torn-corrupted-acked = s.torn-corrupted-acked
      })
    else None

  -- | Acknowledge committed LSNs to clients (`acked-lsn := durable-lsn`).
  -- Strictly gated on `acked-lsn < durable-lsn` so clients NEVER receive an ACK
  -- prior to `fsync` completion.
  wal-step-ack :: WalModelState -> Option WalModelState
  wal-step-ack s =
    if wal-is-running s.phase && s.acked-lsn < s.durable-lsn then
      Some (WalModelState {
        phase = WalRunning,
        acked-lsn = s.durable-lsn,
        durable-lsn = s.durable-lsn,
        written-lsn = s.written-lsn,
        appended-lsn = s.appended-lsn,
        segment-id = s.segment-id,
        torn-tail = s.torn-tail,
        gap-detected = s.gap-detected,
        torn-corrupted-acked = s.torn-corrupted-acked
      })
    else None

  -- | Rotate WAL from segment `0` to segment `1` once `durable-lsn >= 2` and no
  -- uncommitted writes are pending, chaining `(durable-lsn + 1, durable-crc)`.
  wal-step-rotate :: WalModelState -> Option WalModelState
  wal-step-rotate s =
    if wal-is-running s.phase && s.segment-id == 0 && s.durable-lsn >= 2 && s.appended-lsn == s.durable-lsn && s.written-lsn == s.durable-lsn then
      Some (WalModelState {
        phase = WalRunning,
        acked-lsn = s.acked-lsn,
        durable-lsn = s.durable-lsn,
        written-lsn = s.written-lsn,
        appended-lsn = s.appended-lsn,
        segment-id = 1,
        torn-tail = s.torn-tail,
        gap-detected = s.gap-detected,
        torn-corrupted-acked = s.torn-corrupted-acked
      })
    else None

  -- | Clean power-loss crash (`crash_clean`): wipes volatile RAM batch buffer
  -- and un-fsynced disk write cache (`appended-lsn := durable-lsn`,
  -- `written-lsn := durable-lsn`), preserving `durable-lsn` and `acked-lsn`.
  wal-step-crash-clean :: WalModelState -> Option WalModelState
  wal-step-crash-clean s =
    if wal-is-running s.phase then
      Some (WalModelState {
        phase = WalCrashed,
        acked-lsn = s.acked-lsn,
        durable-lsn = s.durable-lsn,
        written-lsn = s.durable-lsn,
        appended-lsn = s.durable-lsn,
        segment-id = s.segment-id,
        torn-tail = False,
        gap-detected = s.gap-detected,
        torn-corrupted-acked = s.torn-corrupted-acked
      })
    else None

  -- | Adversarial torn-sector power-loss crash (`crash_torn_sector`): when an
  -- un-fsynced write is in disk volatile cache (`written-lsn > durable-lsn`),
  -- power fails mid-sector, leaving a torn 512B/4 KiB tail block past
  -- `durable-lsn` (`torn-tail = True`) while all earlier immutable `fsync`ed
  -- blocks (`<= durable-lsn`) remain untouched.
  wal-step-crash-torn-sector :: WalModelState -> Option WalModelState
  wal-step-crash-torn-sector s =
    if wal-is-running s.phase && s.written-lsn > s.durable-lsn then
      Some (WalModelState {
        phase = WalCrashed,
        acked-lsn = s.acked-lsn,
        durable-lsn = s.durable-lsn,
        written-lsn = s.durable-lsn,
        appended-lsn = s.durable-lsn,
        segment-id = s.segment-id,
        torn-tail = True,
        gap-detected = s.gap-detected,
        torn-corrupted-acked = s.torn-corrupted-acked || (s.acked-lsn > s.durable-lsn)
      })
    else None

  -- | Crash recovery (`recover`): sequentially validates segment headers and
  -- hash-chained CRC32C 4 KiB blocks, cleanly discards any `torn-tail` sector
  -- (`torn-tail := False`), verifies zero LSN gaps and full preservation of all
  -- acknowledged LSNs, and returns to `WalRunning`.
  wal-step-recover :: WalModelState -> Option WalModelState
  wal-step-recover s =
    if wal-is-crashed s.phase then
      let lost-ack = s.acked-lsn > s.durable-lsn in
      let has-gap = s.written-lsn /= s.durable-lsn || s.appended-lsn /= s.durable-lsn in
      Some (WalModelState {
        phase = WalRunning,
        acked-lsn = s.acked-lsn,
        durable-lsn = s.durable-lsn,
        written-lsn = s.durable-lsn,
        appended-lsn = s.durable-lsn,
        segment-id = s.segment-id,
        torn-tail = False,
        gap-detected = s.gap-detected || lost-ack || has-gap,
        torn-corrupted-acked = s.torn-corrupted-acked || (s.torn-tail && lost-ack)
      })
    else None

  -- =========================================================================
  -- 3. Safety Invariants (`wal-model-invariants`)
  -- =========================================================================

  -- | Complete M10 durability, contiguous-prefix, and torn-tail safety invariant:
  --   1. **Durability**: `acked-lsn <= durable-lsn` in EVERY reachable state
  --      (including during and after clean crashes and torn-sector crashes).
  --   2. **Contiguous Prefix**: `durable-lsn <= written-lsn <= appended-lsn <= 3`,
  --      and `not gap-detected`.
  --   3. **Torn-Tail Safety**: `not torn-corrupted-acked`, and whenever
  --      `WalRunning`, no torn tail remains active (`not torn-tail`).
  --   4. **Crash Wipe Consistency**: in `WalCrashed`, volatile RAM and write
  --      cache match `durable-lsn` (`written-lsn == durable-lsn` and
  --      `appended-lsn == durable-lsn`).
  wal-model-invariants :: WalModelState -> Bool
  wal-model-invariants s =
    let durability-ok = s.acked-lsn <= s.durable-lsn in
    let prefix-ok = s.durable-lsn <= s.written-lsn && s.written-lsn <= s.appended-lsn && s.appended-lsn <= 3 in
    let torn-ok = not s.torn-corrupted-acked && (if wal-is-running s.phase then not s.torn-tail else True) in
    let crash-ok = if wal-is-crashed s.phase then s.written-lsn == s.durable-lsn && s.appended-lsn == s.durable-lsn else True in
    durability-ok && prefix-ok && torn-ok && crash-ok && not s.gap-detected

  -- =========================================================================
  -- 4. Abstract Specification (`AbstractDurableLog`) & Stuttering Refinement
  -- =========================================================================

  -- | Pure abstract durable log state without volatile disk cache, ack lag,
  -- torn-tail sectors, or segment rotation details.
  record AbsWalState where
    -- | Durably committed log length (`0..3`).
    abs-durable :: InRange 0 3 Nat
    -- | Highest staged log length (`abs-durable..3`).
    abs-staged :: InRange 0 3 Nat
    -- | Whether the log service is currently online (`True`) or recovering (`False`).
    abs-online :: Bool

  -- | Initial empty online `AbstractDurableLog`.
  abs-wal-init :: AbsWalState
  abs-wal-init = AbsWalState {
    abs-durable = 0,
    abs-staged = 0,
    abs-online = True
  }

  -- | Abstract append: stage one record (`abs-staged + 1`).
  abs-wal-append :: AbsWalState -> Option AbsWalState
  abs-wal-append s =
    let st = s.abs-staged in
    if s.abs-online && st < 3 then
      Some (AbsWalState { abs-durable = s.abs-durable, abs-staged = st + 1, abs-online = True })
    else None

  -- | Abstract group commit: durably commit any contiguous prefix `k` in
  -- `(abs-durable .. abs-staged]`.
  abs-wal-commit :: InRange 1 3 Nat -> AbsWalState -> Option AbsWalState
  abs-wal-commit k s =
    if s.abs-online && s.abs-durable < k && k <= s.abs-staged then
      Some (AbsWalState { abs-durable = k, abs-staged = s.abs-staged, abs-online = True })
    else None

  -- | Abstract crash: take the log offline and drop all uncommitted staged
  -- records while preserving `abs-durable`.
  abs-wal-crash :: AbsWalState -> Option AbsWalState
  abs-wal-crash s =
    if s.abs-online then
      Some (AbsWalState { abs-durable = s.abs-durable, abs-staged = s.abs-durable, abs-online = False })
    else None

  -- | Abstract recovery: restore online operation at the exact durable prefix.
  abs-wal-recover :: AbsWalState -> Option AbsWalState
  abs-wal-recover s =
    if not s.abs-online then
      Some (AbsWalState { abs-durable = s.abs-durable, abs-staged = s.abs-durable, abs-online = True })
    else None

  machine AbstractDurableLog where
    state = AbsWalState
    init = abs-wal-init
    actions = [abs-wal-append, abs-wal-commit, abs-wal-crash, abs-wal-recover]
    max_states = 512

  -- | Abstraction projection mapping concrete `WalModelState` onto `AbsWalState`.
  wal-view :: WalModelState -> AbsWalState
  wal-view s = AbsWalState {
    abs-durable = s.durable-lsn,
    abs-staged = s.appended-lsn,
    abs-online = wal-is-running s.phase
  }

  -- | Strictly decreasing stuttering measure for concrete internal steps that
  -- leave `wal-view` unchanged:
  --   * `wal-step-write-cache`: strictly decreases `appended-lsn - written-lsn`
  --   * `wal-step-ack`: strictly decreases `durable-lsn - acked-lsn`
  --   * `wal-step-rotate`: strictly decreases `1 - segment-id`
  wal-stutter-measure :: WalModelState -> Nat
  wal-stutter-measure s =
    let a = s.appended-lsn in
    let w = s.written-lsn in
    let d = s.durable-lsn in
    let k = s.acked-lsn in
    let sid = s.segment-id in
    let unwritten = if w <= a then a - w else 0 in
    let unacked = if k <= d then d - k else 0 in
    let unrotated = if sid <= 1 then 1 - sid else 0 in
    unwritten + unacked + unrotated

  -- =========================================================================
  -- 5. Formal Machine M10 (`WalMachine`) & Temporal Contracts
  -- =========================================================================

  machine WalMachine where
    state = WalModelState
    init = wal-model-init
    actions = [wal-step-append, wal-step-write-cache, wal-step-fsync, wal-step-ack, wal-step-rotate, wal-step-crash-clean, wal-step-crash-torn-sector, wal-step-recover]
    fair = [wal-step-write-cache, wal-step-fsync, wal-step-ack, wal-step-recover]
    max_states = 65536

  contract safety walDurabilityAndSafety for WalMachine where
    always = (\s -> wal-model-invariants s)

  contract safety walDeadlockFree for WalMachine where
    deadlock_free = (True)

  contract liveness stagedEventuallyResolves for WalMachine where
    leads_to = (\s -> s.appended-lsn > s.durable-lsn) ~> (\s -> s.appended-lsn == s.durable-lsn && wal-is-running s.phase)

  contract liveness crashedEventuallyRecovers for WalMachine where
    leads_to = (\s -> wal-is-crashed s.phase) ~> (\s -> wal-is-running s.phase && not s.torn-tail)

  refines WalMachine AbstractDurableLog where
    view = wal-view
    measure = wal-stutter-measure
