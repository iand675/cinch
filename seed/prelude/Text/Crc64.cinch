  -- | Advance one exact tail byte using a masked index in the retained 16384-byte table.
  prim slice-one :: I64 -> U64 -> U8 -> U64 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %byte = zext i8 %2 to i64
      %mixed = xor i64 %1, %byte
      %index = and i64 %mixed, 255
      %offset = shl i64 %index, 3
      %at = getelementptr i8, ptr %base, i64 %offset
      %host = load i64, ptr %at, align 1
      %word = or i64 %host, 0
      %shifted = lshr i64 %1, 8
      %value = xor i64 %word, %shifted
      ret i64 %value
    } when endian little
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %byte = zext i8 %2 to i64
      %mixed = xor i64 %1, %byte
      %index = and i64 %mixed, 255
      %offset = shl i64 %index, 3
      %at = getelementptr i8, ptr %base, i64 %offset
      %host = load i64, ptr %at, align 1
      %word = call i64 @llvm.bswap.i64(i64 %host)
      %shifted = lshr i64 %1, 8
      %value = xor i64 %word, %shifted
      ret i64 %value
    } when endian big
