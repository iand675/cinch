-- | CRC-64 polynomial tables, hardware CLMUL folding, persistent accumulators and binary checkpoints.
-- Standard ISO and ECMA polynomials use 4-way hardware carry-less multiplication
-- (PCLMULQDQ / PMULL) when supported by the target processor with zero table allocation.
-- Arbitrary reflected polynomials build slicing-by-eight storage using linear `%1` ownership
-- and SIMD lane generation. Digest and checkpoint words use network order.
-- Retaining a state branches the computation. This checksum does not authenticate data.
module Text.Crc64 where

  import Data.Bytes
  import Data.Bytes.Word
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String
  import Data.Wide (ArmAes, u64-to-u128, wrapping-u128-to-u64, wrapping-shr-u128, bit-and-u128, bit-xor-u128, simd-u64x2-splat, simd-u64x2-pack, simd-u64x2-sub, simd-u64x2-shr)
  import Text.Binary

  export crc64-iso, crc64-ecma, crc64-size, crc64-sum, crc64-update
  export Crc64Table, crc64-table, crc64-table-entry, crc64-table-entries
  export crc64-table-sum, crc64-table-update
  export Crc64State, crc64-state, crc64-state-update, crc64-state-reset
  export crc64-state-size, crc64-state-block-size, crc64-state-word
  export crc64-state-sum, crc64-state-append, crc64-state-save, crc64-state-append-save, crc64-state-load
  export Crc64StateError, InvalidCrc64StateIdentifier, InvalidCrc64StateSize, Crc64StateTableMismatch, crc64-state-error-message

  -- | Digest size in bytes, always eight.
  crc64-size :: Nat
  crc64-size = 8

  -- | Report non-zero when hardware 64x64 carry-less multiplication may execute on this target.
  prim crc64-has-clmul :: U32 -> U32 where
    unsafe llvm {
      %regs = call { i32, i32, i32, i32 } asm "cpuid", "={ax},={bx},={cx},={dx},{ax},{cx}"(i32 1, i32 0)
      %ecx = extractvalue { i32, i32, i32, i32 } %regs, 2
      %bit = and i32 %ecx, 2
      ret i32 %bit
    } when arch x86_64
    llvm {
      ret i32 1
    } when arch aarch64 when os darwin
    llvm {
      ret i32 1
    } when arch aarch64 when Available ArmAes
    llvm {
      ret i32 0
    }

  -- | Hardware 64x64-bit carry-less multiplication into U128; callers guard with crc64-has-clmul.
  prim crc64-clmul :: U64 -> U64 -> U128 where
    unsafe llvm {
      %va = insertelement <2 x i64> zeroinitializer, i64 %0, i64 0
      %vb = insertelement <2 x i64> zeroinitializer, i64 %1, i64 0
      %vr = call <2 x i64> asm "pclmulqdq $$0, $2, $0", "=x,0,x"(<2 x i64> %va, <2 x i64> %vb)
      %r = bitcast <2 x i64> %vr to i128
      ret i128 %r
    } when arch x86_64
    unsafe llvm {
      %va = insertelement <1 x i64> poison, i64 %0, i64 0
      %vb = insertelement <1 x i64> poison, i64 %1, i64 0
      %vr = call <16 x i8> asm ".arch_extension aes\0Apmull $0.1q, $1.1d, $2.1d", "=w,w,w"(<1 x i64> %va, <1 x i64> %vb)
      %r = bitcast <16 x i8> %vr to i128
      ret i128 %r
    } when arch aarch64 when os darwin
    unsafe llvm {
      %va = insertelement <1 x i64> poison, i64 %0, i64 0
      %vb = insertelement <1 x i64> poison, i64 %1, i64 0
      %vr = call <16 x i8> asm ".arch_extension aes\0Apmull $0.1q, $1.1d, $2.1d", "=w,w,w"(<1 x i64> %va, <1 x i64> %vb)
      %r = bitcast <16 x i8> %vr to i128
      ret i128 %r
    } when arch aarch64 when Available ArmAes
    llvm {
      ret i128 0
    }

  -- | Private raw 64-bit store returning its storage buffer.
  store-le64-raw :: Bytes -> I64 -> U64 -> Bytes
  store-le64-raw b pos v =
    let n = bytes-len-i64 b in
    if 8 <= n && 0 <= pos then
      let nn = nat-from-i64 n in
      if 8 <= nn && nat-from-i64 pos <= nn - 8 then
        let w = bytes-store-le64-at b pos v in b
      else b
    else b

  -- | Linearly store one 64-bit little-endian word into owned table storage.
  store-le64-lin :: Bytes %1 -> I64 -> U64 -> Bytes
  store-le64-lin b pos v = store-le64-raw b pos v

  -- | Private raw pair of 64-bit stores returning the storage buffer.
  store-pair64-raw :: Bytes -> I64 -> U64 -> U64 -> Bytes
  store-pair64-raw b pos lo hi =
    let n = bytes-len-i64 b in
    if 16 <= n && 0 <= pos then
      let nn = nat-from-i64 n in
      if 16 <= nn && nat-from-i64 pos <= nn - 16 then
        let w0 = bytes-store-le64-at b pos lo in
        let p8 = wrapping-add-i64 pos 8 in
        if 0 <= p8 && nat-from-i64 p8 <= nn - 8 then
          let w1 = bytes-store-le64-at b p8 hi in b
        else b
      else b
    else b

  -- | Linearly store two adjacent 64-bit words into owned table storage.
  store-pair64-lin :: Bytes %1 -> I64 -> U64 -> U64 -> Bytes
  store-pair64-lin b pos lo hi = store-pair64-raw b pos lo hi

  -- | Private raw slice step reading the prior row and base row and writing the derived entry.
  slice-step-raw :: Bytes -> I64 -> Bytes
  slice-step-raw b pos =
    let n = bytes-len-i64 b in
    if 8 <= n && 2048 <= pos then
      let nn = nat-from-i64 n in
      let prev-pos = wrapping-sub-i64 pos 2048 in
      if 8 <= nn && 0 <= prev-pos && nat-from-i64 pos <= nn - 8 && nat-from-i64 prev-pos <= nn - 8 then
        let prev = bytes-load-le64-at b prev-pos in
        let idx = wrapping-shl-i64 (u8-to-i64 (wrapping-u64-to-u8 prev)) 3 in
        let base-word = if 0 <= idx && nat-from-i64 idx <= nn - 8 then bytes-load-le64-at b idx else 0 in
        let val = bit-xor-u64 base-word (wrapping-shr-u64 prev 8) in
        let w = bytes-store-le64-at b pos val in b
      else b
    else b

  -- | Linearly derive and store one slice-table entry in owned storage.
  slice-step-lin :: Bytes %1 -> I64 -> Bytes
  slice-step-lin b pos = slice-step-raw b pos

  -- | Private raw copy range returning the destination buffer.
  copy-range-raw :: Bytes -> Bytes -> Nat -> Nat -> Nat -> Bytes
  copy-range-raw dst src di si n =
    if di + n <= bytes-len dst && si + n <= bytes-len src then
      let c = bytes-copy-range dst src di si n in dst
    else dst

  -- | Linearly copy `n` bytes from `src` into a uniquely owned destination buffer.
  copy-range-lin :: Bytes %1 -> Bytes -> Nat -> Nat -> Nat -> Bytes
  copy-range-lin dst src di si n = copy-range-raw dst src di si n

  -- | An immutable polynomial table with eight derived slices, checkpoint fingerprint, and polynomial.
  -- Retain and reuse a prepared table across updates to amortize its construction.
  data Crc64Table where
    -- | Private 16384-byte little-endian table storage, network-order base fingerprint, and reflected polynomial.
    CrcTable :: Bytes -> U64 -> U64 -> Crc64Table

  -- | Prepare all 256 polynomial entries and seven derived slices in fresh linearly owned storage.
  -- The argument is a reflected polynomial; every U64 value is supported.
  crc64-table :: U64 -> Crc64Table
  crc64-table poly =
    let storage0 = bytes-new 16384 in
    let storage1 = fill-base storage0 poly 0 0 in
    let storage2 = fill-slices storage1 2048 in
    CrcTable storage2 (bit-not-u64 (fingerprint storage2 0 (bit-not-u64 0))) poly

  -- | Linearly write pairs of independent base entries into the owned table interval.
  fill-base :: Bytes %1 -> U64 -> I64 -> U64 -> Bytes
  fill-base storage poly pos index =
    if lt-i64 pos 2048 then
      let pair = table-pair poly index in
      let next-storage = store-pair64-lin storage pos (pair-low pair) (pair-high pair) in
      fill-base next-storage poly (wrapping-add-i64 pos 16) (wrapping-add-u64 index 2)
    else storage

  -- | Read one private table word only after checking its complete byte interval.
  table-word :: Bytes -> Nat -> U64
  table-word storage pos = if pos + 8 <= bytes-len storage then bytes-load-le64 storage pos else 0

  -- | Linearly derive successive byte-shift slices from the previous row and the base row.
  fill-slices :: Bytes %1 -> I64 -> Bytes
  fill-slices storage pos =
    if lt-i64 pos 16384 then
      let next-storage = slice-step-lin storage pos in
      fill-slices next-storage (wrapping-add-i64 pos 8)
    else storage

  -- | Checksum the base entries as 2048 network-order bytes using the fixed ISO polynomial.
  fingerprint :: Bytes -> Nat -> U64 -> U64
  fingerprint storage pos acc =
    if pos + 8 <= 2048 && pos + 8 <= bytes-len storage then
      fingerprint storage (pos + 8) (crc64-word acc (network-word (bytes-load-le64 storage pos)) crc64-iso)
    else acc

  -- | Put a numeric network-order entry into the packed little-endian input word.
  network-word :: U64 -> U64
  network-word word = swap-bytes-u64 word

  -- | Observe a base entry at an index in 0..255; other indices return None.
  crc64-table-entry :: Crc64Table -> Nat -> Option U64
  crc64-table-entry table index =
    if index < 256 then case table of
      CrcTable storage sum poly -> Some (table-word storage (index * 8))
    else None

  -- | Return all 256 base entries in index order without exposing the owned backing bytes.
  crc64-table-entries :: Crc64Table -> List U64
  crc64-table-entries table = entries table 0

  -- | Collect the bounded base-table view; scalar values cannot alias mutable storage.
  entries :: Crc64Table -> Nat -> List U64
  entries table index =
    if index < 256 then case crc64-table-entry table index of
      Some word -> Cons word (entries table (index + 1))
      None -> Nil
    else Nil

  -- | Checksum all bytes from the initial zero state with a reusable prepared table.
  crc64-table-sum :: Crc64Table -> Bytes -> U64
  crc64-table-sum table input = crc64-table-update table 0 input

  -- | Continue any finished checksum using a prepared polynomial table.
  -- Standard ISO and ECMA tables dispatch to 4-way hardware CLMUL when available.
  -- Empty input preserves every supplied bit; inputs and table storage are never modified.
  crc64-table-update :: Crc64Table -> U64 -> Bytes -> U64
  crc64-table-update table previous input = case table of
    CrcTable storage sum poly ->
      if ne-u32 (crc64-has-clmul 0) 0 && 16 <= bytes-len-i64 input then
        if eq-u64 poly crc64-ecma then crc64-clmul-ecma previous input
        else if eq-u64 poly crc64-iso then crc64-clmul-iso previous input
        else if 16384 <= bytes-len-i64 storage then
          bit-not-u64 (word-from-blocks storage input 0 (bit-not-u64 previous))
        else previous
      else if 16384 <= bytes-len-i64 storage then
        bit-not-u64 (word-from-blocks storage input 0 (bit-not-u64 previous))
      else previous

  -- | Traverse complete 8-byte blocks using slicing-by-eight with unboxed I64 indices.
  word-from-blocks :: Bytes -> Bytes -> I64 -> U64 -> U64
  word-from-blocks storage input pos acc =
    if 16384 <= bytes-len-i64 storage then
      let n = bytes-len-i64 input in
      if 8 <= n then
        let nn = nat-from-i64 n in
        let lim = nn - 8 in
        if 0 <= pos && pos <= wrapping-sub-i64 n 8 && nat-from-i64 pos <= lim then
          let w = bytes-load-le64-at input pos in
          word-from-blocks storage input (wrapping-add-i64 pos 8) (slice-eight storage (bit-xor-u64 acc w))
        else word-from-tail storage input pos acc
      else word-from-tail storage input pos acc
    else acc

  -- | Finish remaining tail bytes after the final complete 8-byte block.
  word-from-tail :: Bytes -> Bytes -> I64 -> U64 -> U64
  word-from-tail storage input pos acc =
    if 16384 <= bytes-len-i64 storage && 0 <= pos && pos < bytes-len-i64 input then
      let b = bytes-get-u8-at input pos in
      word-from-tail storage input (wrapping-add-i64 pos 1) (slice-one storage acc b)
    else acc

  -- | An immutable checksum accumulator retaining its immutable prepared table.
  data Crc64State where
    -- | Private table and complete finished checksum word.
    CrcState :: Crc64Table -> U64 -> Crc64State

  -- | Start an accumulator at zero with the supplied prepared table.
  crc64-state :: Crc64Table -> Crc64State
  crc64-state table = CrcState table 0

  -- | Consume a chunk without changing any earlier state, input buffer or table.
  crc64-state-update :: Crc64State -> Bytes -> Crc64State
  crc64-state-update state input = case state of CrcState table word -> CrcState table (crc64-table-update table word input)

  -- | Return a zero accumulator retaining the same prepared polynomial table.
  crc64-state-reset :: Crc64State -> Crc64State
  crc64-state-reset state = case state of CrcState table word -> CrcState table 0

  -- | Digest size in bytes, always eight.
  crc64-state-size :: Crc64State -> Nat
  crc64-state-size state = crc64-size

  -- | Input block size in bytes, always one; updates accept any chunk length.
  crc64-state-block-size :: Crc64State -> Nat
  crc64-state-block-size state = 1

  -- | Observe the complete numeric checksum without advancing or resetting.
  crc64-state-word :: Crc64State -> U64
  crc64-state-word state = case state of CrcState table word -> word

  -- | Return eight fresh digest bytes in network order without changing the state.
  crc64-state-sum :: Crc64State -> Bytes
  crc64-state-sum state = binary-u64 BigEndian (crc64-state-word state)

  -- | Join two byte intervals in fresh linearly owned storage without retaining mutable aliases.
  join :: Bytes -> Bytes -> Bytes
  join first last =
    let n = bytes-len first in
    let out0 = bytes-new (n + bytes-len last) in
    let out1 = copy-range-lin out0 first 0 0 n in
    copy-range-lin out1 last n 0 (bytes-len last)

  -- | Append the network-order digest to a copied prefix without changing either argument.
  crc64-state-append :: Bytes -> Crc64State -> Bytes
  crc64-state-append prefix state = join prefix (crc64-state-sum state)

  -- | Return a twenty-byte checkpoint: ASCII crc, version 2, table fingerprint and checksum.
  -- Both words use network order. The fingerprint identifies the complete base table.
  crc64-state-save :: Crc64State -> Bytes
  crc64-state-save state = case state of
    CrcState table word -> case table of
      CrcTable storage sum poly -> join (bytes-from-u8s [99, 114, 99, 2]) (join (binary-u64 BigEndian sum) (binary-u64 BigEndian word))

  -- | Append a complete checkpoint to a copied prefix, preserving the state.
  crc64-state-append-save :: Bytes -> Crc64State -> Bytes
  crc64-state-append-save prefix state = join prefix (crc64-state-save state)

  -- | A checkpoint's identifier, exact byte size or prepared table does not match.
  data Crc64StateError where
    -- | The four-byte crc/version identifier is absent or does not match.
    InvalidCrc64StateIdentifier :: Crc64StateError
    -- | Expected complete checkpoint size and actual input length.
    InvalidCrc64StateSize :: Nat -> Nat -> Crc64StateError
    -- | Expected table fingerprint and actual checkpoint fingerprint, in that order.
    Crc64StateTableMismatch :: U64 -> U64 -> Crc64StateError

  -- | Render a checkpoint diagnostic, including complete expected and actual byte lengths.
  crc64-state-error-message :: Crc64StateError -> String
  crc64-state-error-message error = case error of
    InvalidCrc64StateIdentifier -> "CRC-64 state identifier is invalid"
    InvalidCrc64StateSize expected actual -> string-concat "CRC-64 state requires " (string-concat (nat-to-string expected) (string-concat " bytes; received " (nat-to-string actual)))
    Crc64StateTableMismatch expected actual -> "CRC-64 state table does not match"

  -- | Restore a checkpoint against the supplied immutable table without retaining input bytes.
  -- Identifier checks precede exact-size checks, which precede table matching. Every checksum word is accepted.
  crc64-state-load :: Crc64Table -> Bytes -> Result Crc64StateError Crc64State
  crc64-state-load table input =
    if 4 <= bytes-len input then
      if bytes-get input 0 == 99 && bytes-get input 1 == 114 && bytes-get input 2 == 99 && bytes-get input 3 == 2 then
        if bytes-len input == 20 then case binary-read-u64 BigEndian input 4 of
          Ok actual -> case table of
            CrcTable storage expected poly ->
              if eq-u64 actual expected then case binary-read-u64 BigEndian input 12 of
                Ok word -> Ok (CrcState table word)
                Err error -> Err (InvalidCrc64StateSize 20 (bytes-len input))
              else Err (Crc64StateTableMismatch expected actual)
          Err error -> Err (InvalidCrc64StateSize 20 (bytes-len input))
        else Err (InvalidCrc64StateSize 20 (bytes-len input))
      else Err InvalidCrc64StateIdentifier
    else Err InvalidCrc64StateIdentifier

  -- | The reflected ISO CRC-64 polynomial, 0xD800000000000000.
  crc64-iso :: U64
  crc64-iso = 0xD800000000000000

  -- | The reflected ECMA CRC-64 polynomial, 0xC96C5795D7870F42.
  crc64-ecma :: U64
  crc64-ecma = 0xC96C5795D7870F42

  -- | Compute CRC-64 with the supplied reflected polynomial. The empty checksum is zero.
  crc64-sum :: U64 -> Bytes -> U64
  crc64-sum poly b = crc64-update poly 0 b

  -- | Continue a finished CRC-64 with a reflected polynomial, preserving empty updates.
  -- Standard ISO and ECMA inputs of at least 16 bytes use 4-way hardware CLMUL with zero
  -- table allocation; other polynomials use slicing tables for large inputs or shift registers.
  crc64-update :: U64 -> U64 -> Bytes -> U64
  crc64-update poly previous b =
    if ne-u32 (crc64-has-clmul 0) 0 && 16 <= bytes-len-i64 b then
      if eq-u64 poly crc64-ecma then crc64-clmul-ecma previous b
      else if eq-u64 poly crc64-iso then crc64-clmul-iso previous b
      else if 16384 <= bytes-len b then crc64-table-update (crc64-table poly) previous b
      else bit-not-u64 (crc64-blocks poly b 0 (bit-not-u64 previous))
    else if 16384 <= bytes-len b then crc64-table-update (crc64-table poly) previous b
    else bit-not-u64 (crc64-blocks poly b 0 (bit-not-u64 previous))

  -- -----------------------------------------------------------------
  -- 4-way hardware CLMUL folding for reflected CRC-64 (ISO and ECMA).
  -- -----------------------------------------------------------------

  -- | Fold a 128-bit accumulator (lo, hi) forward using reflected GF(2) constants (klo, khi).
  clmul-fold-pair :: U64 -> U64 -> U64 -> U64 -> U128
  clmul-fold-pair lo hi klo khi =
    bit-xor-u128 (crc64-clmul lo klo) (crc64-clmul hi khi)

  -- | Barrett-reduce a 128-bit reflected polynomial (lo, hi) modulo P to a 64-bit CRC register.
  clmul-reduce128 :: U64 -> U64 -> U64 -> U64 -> U64 -> U64
  clmul-reduce128 lo hi k64 mu-lo poly =
    let t = bit-xor-u128 (crc64-clmul lo k64) (u64-to-u128 hi) in
    let t-lo = wrapping-u128-to-u64 t in
    let t-hi = wrapping-u128-to-u64 (wrapping-shr-u128 t 64) in
    let q = bit-xor-u64 t-lo (wrapping-shl-u64 (wrapping-u128-to-u64 (crc64-clmul t-lo mu-lo)) 1) in
    let p = wrapping-u128-to-u64 (wrapping-shr-u128 (crc64-clmul q poly) 63) in
    bit-xor-u64 t-hi p

  -- | Load one 64-bit little-endian word from a checked input buffer.
  load-le64-safe :: Bytes -> I64 -> U64
  load-le64-safe b pos =
    let n = bytes-len-i64 b in
    if 8 <= n && 0 <= pos then
      let nn = nat-from-i64 n in
      if 8 <= nn && nat-from-i64 pos <= nn - 8 then bytes-load-le64-at b pos else 0
    else 0

  -- | Load one 128-bit word from a checked input buffer.
  load-u128-safe :: Bytes -> I64 -> U128
  load-u128-safe b pos =
    let n = bytes-len-i64 b in
    if 16 <= n && 0 <= pos then
      let nn = nat-from-i64 n in
      if 16 <= nn && nat-from-i64 pos <= nn - 16 then bytes-load-u128-at b pos else 0
    else 0

  -- | Four-way 64-byte hardware CLMUL loop with unboxed accumulators and hoisted bound.
  clmul-loop64 :: Bytes -> I64 -> I64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64
  clmul-loop64 b n pos x0l x0h x1l x1h x2l x2h x3l x3h k512l k512h k128l k128h mu-lo poly =
    if 0 <= pos && wrapping-add-i64 pos 64 <= n then
      let p0 = clmul-fold-pair x0l x0h k512l k512h in
      let p1 = clmul-fold-pair x1l x1h k512l k512h in
      let p2 = clmul-fold-pair x2l x2h k512l k512h in
      let p3 = clmul-fold-pair x3l x3h k512l k512h in
      let d0 = bit-xor-u128 p0 (load-u128-safe b pos) in
      let d1 = bit-xor-u128 p1 (load-u128-safe b (wrapping-add-i64 pos 16)) in
      let d2 = bit-xor-u128 p2 (load-u128-safe b (wrapping-add-i64 pos 32)) in
      let d3 = bit-xor-u128 p3 (load-u128-safe b (wrapping-add-i64 pos 48)) in
      let nx0l = wrapping-u128-to-u64 d0 in
      let nx0h = wrapping-u128-to-u64 (wrapping-shr-u128 d0 64) in
      let nx1l = wrapping-u128-to-u64 d1 in
      let nx1h = wrapping-u128-to-u64 (wrapping-shr-u128 d1 64) in
      let nx2l = wrapping-u128-to-u64 d2 in
      let nx2h = wrapping-u128-to-u64 (wrapping-shr-u128 d2 64) in
      let nx3l = wrapping-u128-to-u64 d3 in
      let nx3h = wrapping-u128-to-u64 (wrapping-shr-u128 d3 64) in
      clmul-loop64 b n (wrapping-add-i64 pos 64) nx0l nx0h nx1l nx1h nx2l nx2h nx3l nx3h k512l k512h k128l k128h mu-lo poly
    else clmul-finish4 b n pos x0l x0h x1l x1h x2l x2h x3l x3h k128l k128h mu-lo poly

  -- | Collapse four 128-bit lanes down to one and fold any remaining 16-byte blocks.
  clmul-finish4 :: Bytes -> I64 -> I64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64
  clmul-finish4 b n pos x0l x0h x1l x1h x2l x2h x3l x3h k128l k128h mu-lo poly =
    let f0 = clmul-fold-pair x0l x0h k128l k128h in
    let y1l = bit-xor-u64 x1l (wrapping-u128-to-u64 f0) in
    let y1h = bit-xor-u64 x1h (wrapping-u128-to-u64 (wrapping-shr-u128 f0 64)) in
    let f1 = clmul-fold-pair y1l y1h k128l k128h in
    let y2l = bit-xor-u64 x2l (wrapping-u128-to-u64 f1) in
    let y2h = bit-xor-u64 x2h (wrapping-u128-to-u64 (wrapping-shr-u128 f1 64)) in
    let f2 = clmul-fold-pair y2l y2h k128l k128h in
    let y3l = bit-xor-u64 x3l (wrapping-u128-to-u64 f2) in
    let y3h = bit-xor-u64 x3h (wrapping-u128-to-u64 (wrapping-shr-u128 f2 64)) in
    clmul-loop16 b n pos y3l y3h k128l k128h mu-lo poly

  -- | Single-lane 16-byte CLMUL fold loop followed by Barrett reduction and byte tail.
  clmul-loop16 :: Bytes -> I64 -> I64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64
  clmul-loop16 b n pos xl xh k128l k128h mu-lo poly =
    if 0 <= pos && wrapping-add-i64 pos 16 <= n then
      let f = clmul-fold-pair xl xh k128l k128h in
      let nxl = bit-xor-u64 (wrapping-u128-to-u64 f) (load-le64-safe b pos) in
      let nxh = bit-xor-u64 (wrapping-u128-to-u64 (wrapping-shr-u128 f 64)) (load-le64-safe b (wrapping-add-i64 pos 8)) in
      clmul-loop16 b n (wrapping-add-i64 pos 16) nxl nxh k128l k128h mu-lo poly
    else
      let reduced = clmul-reduce128 xl xh k128h mu-lo poly in
      bit-not-u64 (crc64-tail poly b pos reduced)

  -- | Run 4-way CLMUL folding with caller-supplied GF(2) constants for an input of at least 16 bytes.
  crc64-clmul-run :: U64 -> Bytes -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64
  crc64-clmul-run previous b k512l k512h k128l k128h mu-lo poly =
    let n = bytes-len-i64 b in
    let acc = bit-not-u64 previous in
    if ge-i64 n 64 then
      let x0l = bit-xor-u64 (load-le64-safe b 0) acc in
      let x0h = load-le64-safe b 8 in
      let x1l = load-le64-safe b 16 in
      let x1h = load-le64-safe b 24 in
      let x2l = load-le64-safe b 32 in
      let x2h = load-le64-safe b 40 in
      let x3l = load-le64-safe b 48 in
      let x3h = load-le64-safe b 56 in
      clmul-loop64 b n 64 x0l x0h x1l x1h x2l x2h x3l x3h k512l k512h k128l k128h mu-lo poly
    else
      let xl = bit-xor-u64 (load-le64-safe b 0) acc in
      let xh = load-le64-safe b 8 in
      clmul-loop16 b n 16 xl xh k128l k128h mu-lo poly

  -- | Hardware CLMUL CRC-64 for the reflected ECMA polynomial (0xC96C5795D7870F42).
  crc64-clmul-ecma :: U64 -> Bytes -> U64
  crc64-clmul-ecma previous b =
    crc64-clmul-run previous b 0x6AE3EFBB9DD441F3 0x081F6054A7842DF4 0xE05DD497CA393AE4 0xDABE95AFC7875F40 0x4E1F23360B94B1EA crc64-ecma

  -- | Hardware CLMUL CRC-64 for the reflected ISO polynomial (0xD800000000000000).
  crc64-clmul-iso :: U64 -> Bytes -> U64
  crc64-clmul-iso previous b =
    crc64-clmul-run previous b 0x01B001B1B0000001 0xB100010100000001 0x6B70000000000001 0xF500000000000001 0xD800000000000000 crc64-iso

  -- -----------------------------------------------------------------
  -- Portable shift-register and slice-by-eight fallback kernels.
  -- -----------------------------------------------------------------

  -- | Consume complete eight-byte shift-register blocks without per-iteration Nat boxing.
  crc64-blocks :: U64 -> Bytes -> I64 -> U64 -> U64
  crc64-blocks poly b pos acc =
    let n = bytes-len-i64 b in
    if 8 <= n then
      let nn = nat-from-i64 n in
      let lim = nn - 8 in
      if 0 <= pos && pos <= wrapping-sub-i64 n 8 && nat-from-i64 pos <= lim then
        let w = bytes-load-le64-at b pos in
        crc64-blocks poly b (wrapping-add-i64 pos 8) (crc64-word acc w poly)
      else crc64-tail poly b pos acc
    else crc64-tail poly b pos acc

  -- | Consume remaining tail bytes after the final complete eight-byte block.
  crc64-tail :: U64 -> Bytes -> I64 -> U64 -> U64
  crc64-tail poly b pos acc =
    if 0 <= pos && pos < bytes-len-i64 b then
      let v = u8-to-u64 (bytes-get-u8-at b pos) in
      crc64-tail poly b (wrapping-add-i64 pos 1) (crc64-byte (bit-xor-u64 acc v) poly)
    else acc

  -- | Advance one reflected CRC-64 step across two independent 64-bit SIMD lanes.
  table-step :: U128 -> U128 -> U128
  table-step poly v =
    let low = bit-and-u128 v (simd-u64x2-splat 1) in
    let mask = simd-u64x2-sub 0 low in
    bit-xor-u128 (simd-u64x2-shr v 1) (bit-and-u128 poly mask)

  -- | Generate two independent polynomial table entries in SIMD lanes, packed low word first.
  table-pair :: U64 -> U64 -> U128
  table-pair poly index =
    let p = simd-u64x2-splat poly in
    let s0 = table-step p (simd-u64x2-pack index (wrapping-add-u64 index 1)) in
    let s1 = table-step p s0 in
    let s2 = table-step p s1 in
    let s3 = table-step p s2 in
    let s4 = table-step p s3 in
    let s5 = table-step p s4 in
    let s6 = table-step p s5 in
    table-step p s6

  -- | Extract the first SIMD table entry without a wide-scalar ABI in public APIs.
  pair-low :: U128 -> U64
  pair-low pair = wrapping-u128-to-u64 pair

  -- | Extract the second SIMD table entry without truncating its high bit.
  pair-high :: U128 -> U64
  pair-high pair = wrapping-u128-to-u64 (wrapping-shr-u128 pair 64)

  -- | Load one 64-bit slicing-table word at slice base plus byte * 8 with zero bounds checks at -O2.
  load-slice :: using (16384 <= bytes-len storage) => (storage :: Bytes) -> I64 -> U8 -> U64
  load-slice storage base byte =
    let idx = u8-to-i64 byte in
    let pos = wrapping-add-i64 base (wrapping-shl-i64 idx 3) in
    if 0 <= pos && pos <= 16376 && nat-from-i64 pos <= 16376 then
      bytes-load-le64-at storage pos
    else 0

  -- | Combine eight masked table indices with balanced XORs over the owned 16384-byte table.
  slice-eight :: using (16384 <= bytes-len storage) => (storage :: Bytes) -> U64 -> U64
  slice-eight storage word =
    let w0 = load-slice storage 14336 (wrapping-u64-to-u8 word) in
    let w1 = load-slice storage 12288 (wrapping-u64-to-u8 (wrapping-shr-u64 word 8)) in
    let w2 = load-slice storage 10240 (wrapping-u64-to-u8 (wrapping-shr-u64 word 16)) in
    let w3 = load-slice storage 8192 (wrapping-u64-to-u8 (wrapping-shr-u64 word 24)) in
    let w4 = load-slice storage 6144 (wrapping-u64-to-u8 (wrapping-shr-u64 word 32)) in
    let w5 = load-slice storage 4096 (wrapping-u64-to-u8 (wrapping-shr-u64 word 40)) in
    let w6 = load-slice storage 2048 (wrapping-u64-to-u8 (wrapping-shr-u64 word 48)) in
    let w7 = load-slice storage 0 (wrapping-u64-to-u8 (wrapping-shr-u64 word 56)) in
    let a0 = bit-xor-u64 w0 w1 in
    let a1 = bit-xor-u64 w2 w3 in
    let a2 = bit-xor-u64 w4 w5 in
    let a3 = bit-xor-u64 w6 w7 in
    bit-xor-u64 (bit-xor-u64 a0 a1) (bit-xor-u64 a2 a3)

  -- | Advance a reflected CRC-64 register by one bit using branchless masking.
  crc64-bit :: U64 -> U64 -> U64
  crc64-bit acc poly =
    let mask = wrapping-sub-u64 0 (bit-and-u64 acc 1) in
    bit-xor-u64 (wrapping-shr-u64 acc 1) (bit-and-u64 poly mask)

  -- | Advance a reflected CRC-64 register by eight bits.
  crc64-byte :: U64 -> U64 -> U64
  crc64-byte acc poly =
    let a1 = crc64-bit acc poly in let a2 = crc64-bit a1 poly in
    let a3 = crc64-bit a2 poly in let a4 = crc64-bit a3 poly in
    let a5 = crc64-bit a4 poly in let a6 = crc64-bit a5 poly in
    let a7 = crc64-bit a6 poly in crc64-bit a7 poly

  -- | Advance a reflected CRC through eight packed bytes using an unrolled shift register.
  crc64-word :: U64 -> U64 -> U64 -> U64
  crc64-word acc word poly =
    let a1 = crc64-byte (bit-xor-u64 acc word) poly in
    let a2 = crc64-byte a1 poly in let a3 = crc64-byte a2 poly in
    let a4 = crc64-byte a3 poly in let a5 = crc64-byte a4 poly in
    let a6 = crc64-byte a5 poly in let a7 = crc64-byte a6 poly in
    crc64-byte a7 poly

  -- | Advance one exact tail byte using a masked index in the retained 16384-byte table.
  slice-one :: using (16384 <= bytes-len storage) => (storage :: Bytes) -> U64 -> U8 -> U64
  slice-one storage acc byte =
    let idx = bit-xor-u8 (wrapping-u64-to-u8 acc) byte in
    bit-xor-u64 (load-slice storage 0 idx) (wrapping-shr-u64 acc 8)
