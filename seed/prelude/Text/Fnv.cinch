-- | Deterministic 32-, 64- and 128-bit FNV-1 and FNV-1a hashing over bytes.
-- Overflow wraps explicitly. Update functions accept a finished hash, so chunked
-- and concatenated input agree. Empty input yields the offset basis, and empty
-- updates leave the state unchanged. Each loop scans unboxed byte indices in
-- input order; the recurrence stays sequential. These non-cryptographic hashes
-- are separate from the collection hashing vocabulary in Data.Hash.
module Text.Fnv where

  import Data.Bool
  import Data.Bytes
  import Data.Machine
  import Data.Wide

  export fnv32, fnv32a, fnv64, fnv64a, fnv128, fnv128a
  export fnv32-update, fnv32a-update, fnv64-update, fnv64a-update, fnv128-update, fnv128a-update

  -- | Compute 32-bit FNV-1, multiplying before xor, with offset basis 0x811C9DC5.
  fnv32 :: Bytes -> U32
  fnv32 b = fnv32-update 0x811C9DC5 b

  -- | Compute 32-bit FNV-1a, xor before multiplying, with offset basis 0x811C9DC5.
  fnv32a :: Bytes -> U32
  fnv32a b = fnv32a-update 0x811C9DC5 b

  -- | Compute 64-bit FNV-1, multiplying before xor, with offset basis 0xCBF29CE484222325.
  fnv64 :: Bytes -> U64
  fnv64 b = fnv64-update 0xCBF29CE484222325 b

  -- | Compute 64-bit FNV-1a, xor before multiplying, with offset basis 0xCBF29CE484222325.
  fnv64a :: Bytes -> U64
  fnv64a b = fnv64a-update 0xCBF29CE484222325 b

  -- | Continue a finished 32-bit FNV-1 hash with more bytes; an empty update preserves the hash.
  fnv32-update :: U32 -> Bytes -> U32
  fnv32-update previous b = fnv32-loop b 0 previous

  -- | Continue a finished 32-bit FNV-1a hash with more bytes; an empty update preserves the hash.
  fnv32a-update :: U32 -> Bytes -> U32
  fnv32a-update previous b = fnv32a-loop b 0 previous

  -- | Continue a finished 64-bit FNV-1 hash with more bytes; an empty update preserves the hash.
  fnv64-update :: U64 -> Bytes -> U64
  fnv64-update previous b = fnv64-loop b 0 previous

  -- | Continue a finished 64-bit FNV-1a hash with more bytes; an empty update preserves the hash.
  fnv64a-update :: U64 -> Bytes -> U64
  fnv64a-update previous b = fnv64a-loop b 0 previous

  -- | Fold each byte in input order using 32-bit FNV-1 multiply-then-xor arithmetic.
  fnv32-loop :: Bytes -> I64 -> U32 -> U32
  fnv32-loop b i acc =
    if 0 <= i && i < bytes-len-i64 b then
      let v = u8-to-u32 (bytes-get-u8-at b i) in
      fnv32-loop b (wrapping-add-i64 i 1) (bit-xor-u32 (wrapping-mul-u32 acc 0x01000193) v)
    else acc

  -- | Fold each byte in input order using 32-bit FNV-1a xor-then-multiply arithmetic.
  fnv32a-loop :: Bytes -> I64 -> U32 -> U32
  fnv32a-loop b i acc =
    if 0 <= i && i < bytes-len-i64 b then
      let v = u8-to-u32 (bytes-get-u8-at b i) in
      fnv32a-loop b (wrapping-add-i64 i 1) (wrapping-mul-u32 (bit-xor-u32 acc v) 0x01000193)
    else acc

  -- | Fold each byte in input order using 64-bit FNV-1 multiply-then-xor arithmetic.
  fnv64-loop :: Bytes -> I64 -> U64 -> U64
  fnv64-loop b i acc =
    if 0 <= i && i < bytes-len-i64 b then
      let v = u8-to-u64 (bytes-get-u8-at b i) in
      fnv64-loop b (wrapping-add-i64 i 1) (bit-xor-u64 (wrapping-mul-u64 acc 0x00000100000001B3) v)
    else acc

  -- | Fold each byte in input order using 64-bit FNV-1a xor-then-multiply arithmetic.
  fnv64a-loop :: Bytes -> I64 -> U64 -> U64
  fnv64a-loop b i acc =
    if 0 <= i && i < bytes-len-i64 b then
      let v = u8-to-u64 (bytes-get-u8-at b i) in
      fnv64a-loop b (wrapping-add-i64 i 1) (wrapping-mul-u64 (bit-xor-u64 acc v) 0x00000100000001B3)
    else acc

  -- | The 128-bit FNV prime 2^88 + 2^8 + 0x3b.
  fnv128-prime :: U128
  fnv128-prime = bit-or-u128 (wrapping-shl-u128 (u64-to-u128 0x0000000001000000) 64) (u64-to-u128 0x000000000000013B)

  -- | Combine high and low 64-bit words into a single wide accumulator.
  pack-u128 :: U64 -> U64 -> U128
  pack-u128 high low = bit-or-u128 (wrapping-shl-u128 (u64-to-u128 high) 64) (u64-to-u128 low)

  -- | Split a wide accumulator into its high word followed by its low word.
  unpack-u128 :: U128 -> (U64, U64)
  unpack-u128 value = (wrapping-u128-to-u64 (wrapping-shr-u128 value 64), wrapping-u128-to-u64 value)

  -- | Compute 128-bit FNV-1 with the standard offset basis, returning high word then low word.
  -- Two U64 words preserve the full hash on every target without a wide-scalar ABI dependency.
  fnv128 :: Bytes -> (U64, U64)
  fnv128 b = fnv128-update (0x6c62272e07bb0142, 0x62b821756295c58d) b

  -- | Compute 128-bit FNV-1a, returning high word then low word.
  -- This deterministic hash is non-cryptographic; serialization byte order is chosen separately.
  fnv128a :: Bytes -> (U64, U64)
  fnv128a b = fnv128a-update (0x6c62272e07bb0142, 0x62b821756295c58d) b

  -- | Continue a 128-bit FNV-1 state given as high and low words. Empty input preserves both words.
  fnv128-update :: (U64, U64) -> Bytes -> (U64, U64)
  fnv128-update previous b = case previous of (high, low) -> unpack-u128 (fnv128-loop b 0 (pack-u128 high low))

  -- | Continue a high/low 128-bit FNV-1a state; arbitrary input chunking preserves the final result.
  fnv128a-update :: (U64, U64) -> Bytes -> (U64, U64)
  fnv128a-update previous b = case previous of (high, low) -> unpack-u128 (fnv128a-loop b 0 (pack-u128 high low))

  -- | Fold each byte in input order using 128-bit FNV-1 multiply-then-xor arithmetic.
  fnv128-loop :: Bytes -> I64 -> U128 -> U128
  fnv128-loop b i acc =
    if 0 <= i && i < bytes-len-i64 b then
      let v = u8-to-u128 (bytes-get-u8-at b i) in
      fnv128-loop b (wrapping-add-i64 i 1) (bit-xor-u128 (wrapping-mul-u128 acc fnv128-prime) v)
    else acc

  -- | Fold each byte in input order using 128-bit FNV-1a xor-then-multiply arithmetic.
  fnv128a-loop :: Bytes -> I64 -> U128 -> U128
  fnv128a-loop b i acc =
    if 0 <= i && i < bytes-len-i64 b then
      let v = u8-to-u128 (bytes-get-u8-at b i) in
      fnv128a-loop b (wrapping-add-i64 i 1) (wrapping-mul-u128 (bit-xor-u128 acc v) fnv128-prime)
    else acc
