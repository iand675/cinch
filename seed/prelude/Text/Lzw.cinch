-- | Lempel-Ziv-Welch compression with variable-width codes, as used by GIF, TIFF and PDF.
-- Codes start one bit wider than the literal width (2 to 8 bits) and grow to twelve bits.
-- Compression uses a `%1`-linearly-threaded open-addressed hash table with Knuth multiplicative
-- hashing and a 64-bit word-flushing growable output buffer. Decompression expands each code
-- directly backwards into a `%1`-linearly-threaded growable output buffer with zero per-code
-- allocations, preserving exact bit-for-bit parity on both LSB and MSB bit orders.
module Text.Lzw where

  import Data.Bytes
  import Data.Bytes.Build
  import Data.Bytes.Word
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String
  import Data.Wide (u128-to-u128)
  import Text.Show (nat-to-string)

  export LzwOrder, LzwLsb, LzwMsb, LzwError, InvalidLiteralWidth, LiteralTooLarge, InvalidLzwCode, UnexpectedLzwEnd
  export lzw-error-message, lzw-compress, lzw-decompress
  export LzwEnd, LzwEnded, LzwExhausted, LzwOverflow, lzw-decompress-bounded

  -- | Bit order used to pack codes into bytes.
  data LzwOrder where
    -- | Least-significant bit first, as in GIF.
    LzwLsb :: LzwOrder
    -- | Most-significant bit first, as in TIFF and PDF.
    LzwMsb :: LzwOrder

  -- | A rejected parameter or malformed compressed stream.
  data LzwError where
    -- | The literal width must be between 2 and 8 bits.
    InvalidLiteralWidth :: Nat -> LzwError
    -- | An input byte at this offset does not fit in the literal width.
    LiteralTooLarge :: Nat -> LzwError
    -- | A code that names no dictionary entry, with the number of codes read before it.
    InvalidLzwCode :: Nat -> Nat -> LzwError
    -- | The data ended before the end-of-data code.
    UnexpectedLzwEnd :: LzwError

  -- | Render an LZW error.
  lzw-error-message :: LzwError -> String
  lzw-error-message error = case error of
    InvalidLiteralWidth width -> string-concat "LZW literal width must be 2 to 8 bits; received " (nat-to-string width)
    LiteralTooLarge offset -> string-concat "LZW input byte is too large for the literal width at offset " (nat-to-string offset)
    InvalidLzwCode code index -> string-concat "invalid LZW code " (string-concat (nat-to-string code) (string-concat " at code index " (nat-to-string index)))
    UnexpectedLzwEnd -> "LZW data ended before the end-of-data code"

  -- | How a bounded decompression stopped.
  data LzwEnd where
    -- | The end-of-data code was read; the output may be shorter than the limit.
    LzwEnded :: LzwEnd
    -- | The input ran out without an end-of-data code after the limit was reached.
    LzwExhausted :: LzwEnd
    -- | More output follows the limit: the bytes returned extend past it, or another data code was read.
    LzwOverflow :: LzwEnd

  -- ---------------------------------------------------------------------
  -- Private `%1`-linear buffer primitives.
  -- ---------------------------------------------------------------------

  -- | Private raw single-byte store returning its buffer.
  put-u8-raw :: Bytes -> I64 -> U8 -> Bytes
  put-u8-raw b pos v =
    if 0 <= pos && pos < bytes-len-i64 b then
      let w = bytes-set-u8-at b pos v in b
    else b

  -- | Linearly store one byte at an I64 offset.
  put-u8-lin :: Bytes %1 -> I64 -> U8 -> Bytes
  put-u8-lin b pos v = put-u8-raw b pos v

  -- | Private raw 16-bit little-endian store returning its buffer.
  put-le16-raw :: Bytes -> I64 -> I64 -> Bytes
  put-le16-raw b idx v =
    let off = wrapping-shl-i64 idx 1 in
    let n = bytes-len-i64 b in
    if 0 <= off && off < n then
      let off1 = wrapping-add-i64 off 1 in
      let w0 = bytes-set-u8-at b off (wrapping-i64-to-u8 v) in
      let w1 = if 0 <= off1 && off1 < n then bytes-set-u8-at b off1 (wrapping-i64-to-u8 (wrapping-shr-i64 v 8)) else () in b
    else b

  -- | Linearly store one 16-bit entry at slot `idx`.
  put-le16-lin :: Bytes %1 -> I64 -> I64 -> Bytes
  put-le16-lin b idx v = put-le16-raw b idx v

  -- | Private raw 32-bit little-endian store returning its buffer.
  put-le32-raw :: Bytes -> I64 -> U32 -> Bytes
  put-le32-raw b pos v =
    let n = bytes-len-i64 b in
    if 4 <= n && 0 <= pos then
      let nn = nat-from-i64 n in
      if 4 <= nn && nat-from-i64 pos <= nn - 4 then
        let w = bytes-store-le32-at b pos v in b
      else b
    else b

  -- | Linearly store one 32-bit little-endian word at a byte offset.
  put-le32-lin :: Bytes %1 -> I64 -> U32 -> Bytes
  put-le32-lin b pos v = put-le32-raw b pos v

  -- | Checked 32-bit little-endian load at an I64 byte offset.
  load-le32-safe :: Bytes -> I64 -> U32
  load-le32-safe b off =
    let n = bytes-len-i64 b in
    if 4 <= n && 0 <= off then
      let nn = nat-from-i64 n in
      if 4 <= nn && nat-from-i64 off <= nn - 4 then bytes-load-le32-at b off else 0
    else 0

  -- | Private raw 16-byte zero store returning its buffer.
  put-u128-raw :: Bytes -> I64 -> U128 -> Bytes
  put-u128-raw b pos v =
    let n = bytes-len-i64 b in
    if 16 <= n && 0 <= pos then
      let nn = nat-from-i64 n in
      if 16 <= nn && nat-from-i64 pos <= nn - 16 then
        let w = bytes-store-u128-at b pos v in b
      else b
    else b

  -- | Private raw 64-byte zero store returning its buffer.
  zero64-raw :: Bytes -> I64 -> Bytes
  zero64-raw b pos =
    let z = u128-to-u128 0 in
    let b1 = put-u128-raw b pos z in
    let b2 = put-u128-raw b1 (wrapping-add-i64 pos 16) z in
    let b3 = put-u128-raw b2 (wrapping-add-i64 pos 32) z in
    put-u128-raw b3 (wrapping-add-i64 pos 48) z

  -- | Linearly zero 64 bytes of a hash table using 128-bit stores.
  zero64-lin :: Bytes %1 -> I64 -> Bytes
  zero64-lin b pos = zero64-raw b pos

  -- | Convert a non-negative I64 to Nat, clamping negatives to 0.
  i64-to-nat :: I64 -> Nat
  i64-to-nat x = if 0 <= x then nat-from-i64 x else 0

  -- | Convert a Nat to I64, clamping overflow to `max-bound-i64`.
  nat-to-i64-cap :: Nat -> I64
  nat-to-i64-cap n = if n <= 9223372036854775807 then nat-to-i64 n else max-bound-i64

  -- | Private raw linear buffer growth preserving the first `len` bytes.
  grow-raw :: Bytes -> I64 -> I64 -> (Bytes, I64)
  grow-raw out len need =
    let cur = bytes-len-i64 out in
    let new-cap = wrapping-add-i64 (wrapping-add-i64 (wrapping-shl-i64 cur 1) need) 1024 in
    let nc-nat = i64-to-nat new-cap in
    let bigger = bytes-new nc-nat in
    let ln = i64-to-nat len in
    let copied = if ln <= bytes-len out && ln <= bytes-len bigger then bytes-copy-range bigger out 0 0 ln else () in
    (bigger, bytes-len-i64 bigger)

  -- | Linearly grow a uniquely owned output buffer to hold at least `need` bytes.
  grow-lin :: Bytes %1 -> I64 -> I64 -> (Bytes, I64)
  grow-lin out len need = grow-raw out len need

  -- | Private raw trim returning the first `len` bytes as an exact buffer.
  trim-raw :: Bytes -> I64 -> Bytes
  trim-raw out len =
    if 0 <= len then
      if eq-i64 len (bytes-len-i64 out) then out
      else
        let ln = nat-from-i64 len in
        let exact = bytes-new ln in
        if ln <= bytes-len out && ln <= bytes-len exact then
          let copied = bytes-copy-range exact out 0 0 ln in exact
        else exact
    else bytes-new 0

  -- | Linearly trim a uniquely owned output buffer to its exact written length.
  trim-lin :: Bytes %1 -> I64 -> Bytes
  trim-lin out len = trim-raw out len

  -- | Private raw hash-table probe-or-find returning `(found-code-or-neg1, free-slot, table)`.
  probe-raw :: Bytes -> U32 -> I64 -> (I64, I64, Bytes)
  probe-raw table key h = probe-loop table key h

  -- | Inner linear-probing loop over the 16384-slot U32 table (zero `nat-div`/`nat-rem`).
  probe-loop :: Bytes -> U32 -> I64 -> (I64, I64, Bytes)
  probe-loop table key h =
    let off = wrapping-shl-i64 h 2 in
    let entry = load-le32-safe table off in
    if eq-u32 entry 0 then (-1, h, table)
    else
      let e1 = wrapping-sub-u32 entry 1 in
      if eq-u32 (wrapping-shr-u32 e1 12) key then (u32-to-i64 (bit-and-u32 e1 4095), h, table)
      else probe-loop table key (bit-and-i64 (wrapping-add-i64 h 1) 16383)

  -- | Linearly probe the 16384-slot encoder hash table, returning `(found-code-or-neg1, slot, table)`.
  probe-lin :: Bytes %1 -> U32 -> I64 -> (I64, I64, Bytes)
  probe-lin table key h = probe-raw table key h

  -- | Private raw read of a 16-bit little-endian table entry while retaining ownership.
  get-le16-keep-raw :: Bytes -> I64 -> (I64, Bytes)
  get-le16-keep-raw tbl idx =
    let off = wrapping-shl-i64 idx 1 in
    let n = bytes-len-i64 tbl in
    let off1 = wrapping-add-i64 off 1 in
    let v = if 0 <= off && off < n && 0 <= off1 && off1 < n then
              wrapping-add-i64 (u8-to-i64 (bytes-get-u8-at tbl off))
                               (wrapping-shl-i64 (u8-to-i64 (bytes-get-u8-at tbl off1)) 8)
            else 0 in
    (v, tbl)

  -- | Linearly read a 16-bit entry from a uniquely owned dictionary table.
  get-le16-lin :: Bytes %1 -> I64 -> (I64, Bytes)
  get-le16-lin tbl idx = get-le16-keep-raw tbl idx

  -- | Private raw read of one suffix byte while retaining ownership.
  get-u8-keep-raw :: Bytes -> I64 -> (U8, Bytes)
  get-u8-keep-raw tbl idx =
    let b = if 0 <= idx && idx < bytes-len-i64 tbl then bytes-get-u8-at tbl idx else 0 in
    (b, tbl)

  -- | Linearly read a suffix byte from a uniquely owned dictionary table.
  get-u8-lin :: Bytes %1 -> I64 -> (U8, Bytes)
  get-u8-lin tbl idx = get-u8-keep-raw tbl idx

  -- | Private raw discard for linear buffers.
  drop-bytes-raw :: Bytes -> Unit
  drop-bytes-raw b = ()

  -- | Linearly consume and release a uniquely owned buffer.
  drop-bytes-lin :: Bytes %1 -> Unit
  drop-bytes-lin b = drop-bytes-raw b

  -- ---------------------------------------------------------------------
  -- Encoder: Knuth hash table + 64-bit word-flushing growable output (`%1`).
  -- ---------------------------------------------------------------------

  -- | Knuth multiplicative hash mapping a 20-bit `(prefix << 8) | byte` key into `0..16383`.
  hash-key :: U32 -> I64
  hash-key key =
    bit-and-i64 (wrapping-u64-to-i64 (wrapping-shr-u64 (wrapping-mul-u64 (u32-to-u64 key) 2654435769) 18)) 16383

  -- | Linearly clear all 65536 bytes of the 16384-slot hash table with 64-byte unrolled u128 stores.
  clear-table-lin :: Bytes %1 -> I64 -> Bytes
  clear-table-lin table pos =
    if lt-i64 pos 65536 then
      let table1 = zero64-lin table pos in
      clear-table-lin table1 (wrapping-add-i64 pos 64)
    else table

  -- | Linearly append a 32-bit little-endian word to the growable output buffer.
  emit-le32-lin :: Bytes %1 -> I64 -> I64 -> U32 -> (Bytes, I64, I64)
  emit-le32-lin out cap len word =
    let need = wrapping-add-i64 len 4 in
    if le-i64 need cap then
      (put-le32-lin out len word, cap, need)
    else case grow-lin out len need of
      (out1, cap1) -> (put-le32-lin out1 len word, cap1, need)

  -- | Linearly append a single byte to the growable output buffer.
  emit-u8-lin :: Bytes %1 -> I64 -> I64 -> U8 -> (Bytes, I64, I64)
  emit-u8-lin out cap len b =
    let need = wrapping-add-i64 len 1 in
    if le-i64 need cap then
      (put-u8-lin out len b, cap, need)
    else case grow-lin out len need of
      (out1, cap1) -> (put-u8-lin out1 len b, cap1, need)

  -- | Push one code into the 64-bit bit-writer accumulator and flush 4 bytes whenever `bcnt >= 32`.
  write-code-lin :: Bool -> U64 -> I64 -> Bytes %1 -> I64 -> I64 -> I64 -> I64 -> (U64, I64, Bytes, I64, I64)
  write-code-lin is-lsb acc bcnt out cap len code width =
    let code64 = wrapping-i64-to-u64 code in
    if is-lsb then
      let acc1 = bit-or-u64 acc (wrapping-shl-u64 code64 (wrapping-i64-to-u32 bcnt)) in
      let bcnt1 = wrapping-add-i64 bcnt width in
      if ge-i64 bcnt1 32 then
        case emit-le32-lin out cap len (wrapping-u64-to-u32 acc1) of
          (out1, cap1, len1) -> (wrapping-shr-u64 acc1 32, wrapping-sub-i64 bcnt1 32, out1, cap1, len1)
      else (acc1, bcnt1, out, cap, len)
    else
      let sh = wrapping-i64-to-u32 (wrapping-sub-i64 64 (wrapping-add-i64 bcnt width)) in
      let acc1 = bit-or-u64 acc (wrapping-shl-u64 code64 sh) in
      let bcnt1 = wrapping-add-i64 bcnt width in
      if ge-i64 bcnt1 32 then
        let word = swap-bytes-u32 (wrapping-u64-to-u32 (wrapping-shr-u64 acc1 32)) in
        case emit-le32-lin out cap len word of
          (out1, cap1, len1) -> (wrapping-shl-u64 acc1 32, wrapping-sub-i64 bcnt1 32, out1, cap1, len1)
      else (acc1, bcnt1, out, cap, len)

  -- | Drain all remaining whole and partial bytes from the 64-bit bit-writer and trim linearly.
  finish-writer-lin :: Bool -> U64 -> I64 -> Bytes %1 -> I64 -> I64 -> Bytes
  finish-writer-lin is-lsb acc bcnt out cap len =
    if ge-i64 bcnt 8 then
      if is-lsb then
        case emit-u8-lin out cap len (wrapping-u64-to-u8 acc) of
          (out1, cap1, len1) -> finish-writer-lin True (wrapping-shr-u64 acc 8) (wrapping-sub-i64 bcnt 8) out1 cap1 len1
      else
        case emit-u8-lin out cap len (wrapping-u64-to-u8 (wrapping-shr-u64 acc 56)) of
          (out1, cap1, len1) -> finish-writer-lin False (wrapping-shl-u64 acc 8) (wrapping-sub-i64 bcnt 8) out1 cap1 len1
    else if gt-i64 bcnt 0 then
      let b = if is-lsb then wrapping-u64-to-u8 acc else wrapping-u64-to-u8 (wrapping-shr-u64 acc 56) in
      case emit-u8-lin out cap len b of
        (out1, cap1, len1) -> trim-lin out1 len1
    else trim-lin out len

  -- | Check whether any input byte equals or exceeds `2^width` (skipped when `width == 8`).
  first-too-large :: Bytes -> I64 -> I64 -> U8 -> Option Nat
  first-too-large input n i limit-u8 =
    if lt-i64 i n then
      let b = if 0 <= i && i < bytes-len-i64 input then bytes-get-u8-at input i else 0 in
      if ge-u8 b limit-u8 then Some (i64-to-nat i)
      else first-too-large input n (wrapping-add-i64 i 1) limit-u8
    else None

  -- | Compress a complete input. Every byte must be below `2^width`.
  lzw-compress :: LzwOrder -> Nat -> Bytes -> Result LzwError Bytes
  lzw-compress order width input =
    if width < 2 || width > 8 then Err (InvalidLiteralWidth width)
    else
      let in-len = bytes-len-i64 input in
      let lit = nat-to-i64 width in
      let clear = wrapping-shl-i64 1 (wrapping-i64-to-u32 lit) in
      let check = if lt-i64 lit 8 then first-too-large input in-len 0 (wrapping-i64-to-u8 clear) else None in
      case check of
        Some offset -> Err (LiteralTooLarge offset)
        None ->
          let is-lsb = case order of LzwLsb -> True; LzwMsb -> False in
          let init-cap-nat = bytes-len input + 64 in
          let out0 = bytes-new init-cap-nat in
          let cap0 = bytes-len-i64 out0 in
          let start-w = wrapping-add-i64 lit 1 in
          case write-code-lin is-lsb 0 0 out0 cap0 0 clear start-w of
            (acc1, bcnt1, out1, cap1, len1) ->
              if eq-i64 in-len 0 then
                case write-code-lin is-lsb acc1 bcnt1 out1 cap1 len1 (wrapping-add-i64 clear 1) start-w of
                  (acc2, bcnt2, out2, cap2, len2) -> Ok (finish-writer-lin is-lsb acc2 bcnt2 out2 cap2 len2)
              else
                let table0 = bytes-new 65536 in
                let first-code = if 0 < bytes-len-i64 input then u8-to-i64 (bytes-get-u8-at input 0) else 0 in
                Ok (encode-loop is-lsb input in-len 1 first-code lit clear start-w (wrapping-add-i64 clear 1) (wrapping-shl-i64 clear 1) acc1 bcnt1 table0 out1 cap1 len1)

  -- | Hot tail-recursive encoder loop with unboxed state and `%1`-linear `table` and `out`.
  encode-loop :: Bool -> Bytes -> I64 -> I64 -> I64 -> I64 -> I64 -> I64 -> I64 -> I64 -> U64 -> I64 -> Bytes %1 -> Bytes %1 -> I64 -> I64 -> Bytes
  encode-loop is-lsb input in-len i code lit clear width next-code overflow acc bcnt table out cap len =
    if lt-i64 i in-len then
      let byte = if 0 <= i && i < bytes-len-i64 input then u8-to-i64 (bytes-get-u8-at input i) else 0 in
      let key = wrapping-i64-to-u32 (wrapping-add-i64 (wrapping-shl-i64 code 8) byte) in
      let h = hash-key key in
      case probe-lin table key h of
        (found, slot, table1) ->
          if ge-i64 found 0 then
            encode-loop is-lsb input in-len (wrapping-add-i64 i 1) found lit clear width next-code overflow acc bcnt table1 out cap len
          else
            let hi = wrapping-add-i64 next-code 1 in
            let at-ov = eq-i64 hi overflow in
            let widened = if at-ov then wrapping-add-i64 width 1 else width in
            let threshold = if at-ov then wrapping-shl-i64 overflow 1 else overflow in
            case write-code-lin is-lsb acc bcnt out cap len code width of
              (acc1, bcnt1, out1, cap1, len1) ->
                if eq-i64 hi 4095 then
                  let table2 = clear-table-lin table1 0 in
                  case write-code-lin is-lsb acc1 bcnt1 out1 cap1 len1 clear widened of
                    (acc2, bcnt2, out2, cap2, len2) ->
                      encode-loop is-lsb input in-len (wrapping-add-i64 i 1) byte lit clear (wrapping-add-i64 lit 1) (wrapping-add-i64 clear 1) (wrapping-shl-i64 clear 1) acc2 bcnt2 table2 out2 cap2 len2
                else
                  let packed = wrapping-add-u32 (bit-or-u32 (wrapping-shl-u32 key 12) (wrapping-i64-to-u32 hi)) 1 in
                  let table2 = put-le32-lin table1 (wrapping-shl-i64 slot 2) packed in
                  encode-loop is-lsb input in-len (wrapping-add-i64 i 1) byte lit clear widened hi threshold acc1 bcnt1 table2 out1 cap1 len1
    else
      let gt = drop-bytes-lin table in
      let hi = wrapping-add-i64 next-code 1 in
      let widened = if eq-i64 hi overflow then wrapping-add-i64 width 1 else width in
      case write-code-lin is-lsb acc bcnt out cap len code width of
        (acc1, bcnt1, out1, cap1, len1) ->
          if eq-i64 hi 4095 then
            case write-code-lin is-lsb acc1 bcnt1 out1 cap1 len1 clear widened of
              (acc2, bcnt2, out2, cap2, len2) ->
                case write-code-lin is-lsb acc2 bcnt2 out2 cap2 len2 (wrapping-add-i64 clear 1) (wrapping-add-i64 lit 1) of
                  (acc3, bcnt3, out3, cap3, len3) -> finish-writer-lin is-lsb acc3 bcnt3 out3 cap3 len3
          else
            case write-code-lin is-lsb acc1 bcnt1 out1 cap1 len1 (wrapping-add-i64 clear 1) widened of
              (acc2, bcnt2, out2, cap2, len2) -> finish-writer-lin is-lsb acc2 bcnt2 out2 cap2 len2

  -- ---------------------------------------------------------------------
  -- Decoder: 64-bit bit-reader + direct backward expansion into `%1` `out`.
  -- ---------------------------------------------------------------------

  -- | Decompress a complete stream through its end-of-data code.
  lzw-decompress :: LzwOrder -> Nat -> Bytes -> Result LzwError Bytes
  lzw-decompress order width input =
    if width < 2 || width > 8 then Err (InvalidLiteralWidth width)
    else case decode-fresh order width input False 0 of
      Err error -> Err error
      Ok (out, end) -> Ok out

  -- | Decompress until the end-of-data code or until `limit` bytes have been produced, whichever comes first.
  lzw-decompress-bounded :: LzwOrder -> Nat -> Bytes -> Nat -> Result LzwError (Bytes, LzwEnd)
  lzw-decompress-bounded order width input limit =
    if width < 2 || width > 8 then Err (InvalidLiteralWidth width)
    else
      let lim-i64 = nat-to-i64-cap limit in
      decode-fresh order width input True lim-i64

  -- | Allocate linear dictionary tables and growable output buffer, then decode codes.
  decode-fresh :: LzwOrder -> Nat -> Bytes -> Bool -> I64 -> Result LzwError (Bytes, LzwEnd)
  decode-fresh order width input has-limit limit =
    let lit = nat-to-i64-cap width in
    let clear = wrapping-shl-i64 1 (wrapping-i64-to-u32 lit) in
    let prefixes0 = bytes-new 8192 in
    let suffixes0 = bytes-new 4096 in
    let lengths0 = literal-lengths-lin (bytes-new 8192) 0 clear in
    let in-len = bytes-len-i64 input in
    let init-cap-nat = if has-limit && lt-i64 limit (wrapping-add-i64 (wrapping-shl-i64 in-len 2) 64) then
                         i64-to-nat (wrapping-add-i64 limit 64)
                       else bytes-len input * 4 + 64 in
    let out0 = bytes-new init-cap-nat in
    let cap0 = bytes-len-i64 out0 in
    let is-lsb = case order of LzwLsb -> True; LzwMsb -> False in
    decode-loop is-lsb input in-len prefixes0 suffixes0 lengths0 lit clear (wrapping-add-i64 lit 1) (wrapping-add-i64 clear 2) 4096 0 0 0 out0 cap0 0 0 has-limit limit

  -- | Linearly initialize literal code expansion lengths to 1.
  literal-lengths-lin :: Bytes %1 -> I64 -> I64 -> Bytes
  literal-lengths-lin lengths i count =
    if lt-i64 i count then
      let lengths1 = put-le16-lin lengths i 1 in
      literal-lengths-lin lengths1 (wrapping-add-i64 i 1) count
    else lengths

  -- | Read one `width`-bit code from the unboxed 64-bit bit-reader; returns `-1` when input ends first.
  read-code :: Bool -> Bytes -> I64 -> U64 -> I64 -> I64 -> I64 -> (I64, U64, I64, I64)
  read-code is-lsb input in-len acc bcnt at width =
    if ge-i64 bcnt width then
      if is-lsb then
        let mask = wrapping-sub-u64 (wrapping-shl-u64 1 (wrapping-i64-to-u32 width)) 1 in
        let code = wrapping-u64-to-i64 (bit-and-u64 acc mask) in
        (code, wrapping-shr-u64 acc (wrapping-i64-to-u32 width), wrapping-sub-i64 bcnt width, at)
      else
        let sh = wrapping-i64-to-u32 (wrapping-sub-i64 64 width) in
        let code = wrapping-u64-to-i64 (wrapping-shr-u64 acc sh) in
        (code, wrapping-shl-u64 acc (wrapping-i64-to-u32 width), wrapping-sub-i64 bcnt width, at)
    else if le-i64 bcnt 32 && le-i64 (wrapping-add-i64 at 4) in-len && 0 <= at then
      let w32 = load-le32-safe input at in
      if is-lsb then
        let acc1 = bit-or-u64 acc (wrapping-shl-u64 (u32-to-u64 w32) (wrapping-i64-to-u32 bcnt)) in
        read-code True input in-len acc1 (wrapping-add-i64 bcnt 32) (wrapping-add-i64 at 4) width
      else
        let be32 = u32-to-u64 (swap-bytes-u32 w32) in
        let acc1 = bit-or-u64 acc (wrapping-shl-u64 be32 (wrapping-i64-to-u32 (wrapping-sub-i64 32 bcnt))) in
        read-code False input in-len acc1 (wrapping-add-i64 bcnt 32) (wrapping-add-i64 at 4) width
    else if lt-i64 at in-len && 0 <= at && at < bytes-len-i64 input then
      let byte = u8-to-u64 (bytes-get-u8-at input at) in
      if is-lsb then
        let acc1 = bit-or-u64 acc (wrapping-shl-u64 byte (wrapping-i64-to-u32 bcnt)) in
        read-code True input in-len acc1 (wrapping-add-i64 bcnt 8) (wrapping-add-i64 at 1) width
      else
        let acc1 = bit-or-u64 acc (wrapping-shl-u64 byte (wrapping-i64-to-u32 (wrapping-sub-i64 56 bcnt))) in
        read-code False input in-len acc1 (wrapping-add-i64 bcnt 8) (wrapping-add-i64 at 1) width
    else (-1, acc, bcnt, at)

  -- | Linearly expand `code` backwards into `out[start .. end)`, returning `(first-byte, prefixes, suffixes, out)`.
  expand-back-lin :: Bytes %1 -> Bytes %1 -> Bytes %1 -> I64 -> I64 -> I64 -> I64 -> (U8, Bytes, Bytes, Bytes)
  expand-back-lin prefixes suffixes out code clear start end =
    if le-i64 end start then (0, prefixes, suffixes, out)
    else
      let pos = wrapping-sub-i64 end 1 in
      if lt-i64 code clear then
        let b = wrapping-i64-to-u8 code in
        let out1 = put-u8-lin out pos b in
        (b, prefixes, suffixes, out1)
      else
        case get-u8-lin suffixes code of
          (b, suffixes1) ->
            let out1 = put-u8-lin out pos b in
            case get-le16-lin prefixes code of
              (prev-code, prefixes1) ->
                expand-back-lin prefixes1 suffixes1 out1 prev-code clear start pos

  -- | Linearly ensure `out` has capacity for at least `need` bytes.
  ensure-cap-lin :: Bytes %1 -> I64 -> I64 -> I64 -> (Bytes, I64)
  ensure-cap-lin out cap len need =
    if le-i64 need cap then (out, cap)
    else grow-lin out len need

  -- | Hot tail-recursive decoder loop expanding every code directly into `%1`-linear `out`.
  decode-loop :: Bool -> Bytes -> I64 -> Bytes %1 -> Bytes %1 -> Bytes %1 -> I64 -> I64 -> I64 -> I64 -> I64 -> U64 -> I64 -> I64 -> Bytes %1 -> I64 -> I64 -> I64 -> Bool -> I64 -> Result LzwError (Bytes, LzwEnd)
  decode-loop is-lsb input in-len prefixes suffixes lengths lit clear width hi last acc bcnt at out cap out-len index has-limit limit =
    case read-code is-lsb input in-len acc bcnt at width of
      (code, acc1, bcnt1, at1) ->
        if lt-i64 code 0 then
          let g1 = drop-bytes-lin prefixes in let g2 = drop-bytes-lin suffixes in let g3 = drop-bytes-lin lengths in
          if has-limit && ge-i64 out-len limit then Ok (trim-lin out out-len, LzwExhausted)
          else let g4 = drop-bytes-lin out in Err UnexpectedLzwEnd
        else if eq-i64 code clear then
          decode-loop is-lsb input in-len prefixes suffixes lengths lit clear (wrapping-add-i64 lit 1) (wrapping-add-i64 clear 2) 4096 acc1 bcnt1 at1 out cap out-len (wrapping-add-i64 index 1) has-limit limit
        else if eq-i64 code (wrapping-add-i64 clear 1) then
          let g1 = drop-bytes-lin prefixes in let g2 = drop-bytes-lin suffixes in let g3 = drop-bytes-lin lengths in
          Ok (trim-lin out out-len, LzwEnded)
        else if gt-i64 code hi || (eq-i64 code hi && eq-i64 last 4096) || (gt-i64 code clear && lt-i64 code (wrapping-add-i64 clear 2)) then
          let g1 = drop-bytes-lin prefixes in let g2 = drop-bytes-lin suffixes in let g3 = drop-bytes-lin lengths in let g4 = drop-bytes-lin out in
          Err (InvalidLzwCode (i64-to-nat code) (i64-to-nat index))
        else if has-limit && ge-i64 out-len limit then
          let g1 = drop-bytes-lin prefixes in let g2 = drop-bytes-lin suffixes in let g3 = drop-bytes-lin lengths in
          Ok (trim-lin out out-len, LzwOverflow)
        else
          let previous = if lt-i64 last 4096 then last else 0 in
          let is-repeat = eq-i64 code hi in
          let len-lookup = if is-repeat then previous else code in
          case get-le16-lin lengths len-lookup of
            (base-len, lengths1) ->
              let exp-len = if is-repeat then wrapping-add-i64 base-len 1 else base-len in
              let total = wrapping-add-i64 out-len exp-len in
              case ensure-cap-lin out cap out-len total of
                (out1, cap1) ->
                  let expand-end = if is-repeat then wrapping-add-i64 out-len base-len else total in
                  case expand-back-lin prefixes suffixes out1 len-lookup clear out-len expand-end of
                    (first-byte, prefixes1, suffixes1, out2) ->
                      let out3 = if is-repeat then put-u8-lin out2 expand-end first-byte else out2 in
                      if lt-i64 last 4096 && le-i64 hi 4095 && gt-i64 exp-len 0 then
                        case get-le16-lin lengths1 previous of
                          (prev-len, lengths2) ->
                            let prefixes2 = put-le16-lin prefixes1 hi previous in
                            let suffixes2 = put-u8-lin suffixes1 hi first-byte in
                            let lengths3 = put-le16-lin lengths2 hi (wrapping-add-i64 prev-len 1) in
                            let grown = wrapping-add-i64 hi 1 in
                            let threshold = wrapping-shl-i64 1 (wrapping-i64-to-u32 width) in
                            let wider = if ge-i64 grown threshold && lt-i64 width 12 then wrapping-add-i64 width 1 else width in
                            if has-limit && gt-i64 total limit then
                              let g1 = drop-bytes-lin prefixes2 in let g2 = drop-bytes-lin suffixes2 in let g3 = drop-bytes-lin lengths3 in
                              Ok (trim-lin out3 total, LzwOverflow)
                            else
                              decode-loop is-lsb input in-len prefixes2 suffixes2 lengths3 lit clear wider grown code acc1 bcnt1 at1 out3 cap1 total (wrapping-add-i64 index 1) has-limit limit
                      else
                        let grown = if lt-i64 last 4096 && le-i64 hi 4095 then wrapping-add-i64 hi 1 else hi in
                        let threshold = wrapping-shl-i64 1 (wrapping-i64-to-u32 width) in
                        let wider = if ge-i64 grown threshold && lt-i64 width 12 then wrapping-add-i64 width 1 else width in
                        if has-limit && gt-i64 total limit then
                          let g1 = drop-bytes-lin prefixes1 in let g2 = drop-bytes-lin suffixes1 in let g3 = drop-bytes-lin lengths1 in
                          Ok (trim-lin out3 total, LzwOverflow)
                        else
                          decode-loop is-lsb input in-len prefixes1 suffixes1 lengths1 lit clear wider grown code acc1 bcnt1 at1 out3 cap1 total (wrapping-add-i64 index 1) has-limit limit
