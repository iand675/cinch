      let e7 = wrapping-add-u32 a3 first7 in
      let first8 = sha256-t1 e7 e6 e5 e4 m8 2554220882 in
      let second8 = sha256-t2 a7 a6 a5 in
      let a8 = wrapping-add-u32 first8 second8 in
      let e8 = wrapping-add-u32 a4 first8 in
      let first9 = sha256-t1 e8 e7 e6 e5 m9 2821834349 in
      let second9 = sha256-t2 a8 a7 a6 in
      let a9 = wrapping-add-u32 first9 second9 in
      let e9 = wrapping-add-u32 a5 first9 in
      let first10 = sha256-t1 e9 e8 e7 e6 m10 2952996808 in
      let second10 = sha256-t2 a9 a8 a7 in
      let a10 = wrapping-add-u32 first10 second10 in
      let e10 = wrapping-add-u32 a6 first10 in
      let first11 = sha256-t1 e10 e9 e8 e7 m11 3210313671 in
      let second11 = sha256-t2 a10 a9 a8 in
      let a11 = wrapping-add-u32 first11 second11 in
      let e11 = wrapping-add-u32 a7 first11 in
      let first12 = sha256-t1 e11 e10 e9 e8 m12 3336571891 in
      let second12 = sha256-t2 a11 a10 a9 in
      let a12 = wrapping-add-u32 first12 second12 in
      let e12 = wrapping-add-u32 a8 first12 in
      let first13 = sha256-t1 e12 e11 e10 e9 m13 3584528711 in
      let second13 = sha256-t2 a12 a11 a10 in
