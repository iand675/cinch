  -- | Initial chaining words derived from the exact FIPS prime-root definitions.
  sha256-initial-words :: Bool -> Sha256Words
  sha256-initial-words short =
    if short then ShaWords 3926247204440088280 17802264479202860311 7518782744944446257 13761399178871279527
    else ShaWords 13503953895726638695 11912009169889063794 11170449402626986623 6620516960021240235

  -- | Extract one complete U32 lane from a stored pair of chaining words.
  prim sha256-word-low :: U64 -> U32 where
    llvm {
      %value = trunc i64 %0 to i32
      ret i32 %value
    }

  -- | Extract one complete U32 lane from a stored pair of chaining words.
  prim sha256-word-high :: U64 -> U32 where
    llvm {
      %shift = lshr i64 %0, 32
      %value = trunc i64 %shift to i32
      ret i32 %value
    }

  -- | Select schedule lane 0 without narrowing any other lane's stored bits.
  prim sha256-lane0 :: U128 -> U32 where
    llvm {
      %value = trunc i128 %0 to i32
      ret i32 %value
    }

  -- | Select schedule lane 1 without narrowing any other lane's stored bits.
  prim sha256-lane1 :: U128 -> U32 where
    llvm {
      %shift = lshr i128 %0, 32
      %value = trunc i128 %shift to i32
      ret i32 %value
    }

  -- | Select schedule lane 2 without narrowing any other lane's stored bits.
  prim sha256-lane2 :: U128 -> U32 where
    llvm {
      %shift = lshr i128 %0, 64
      %value = trunc i128 %shift to i32
      ret i32 %value
    }

  -- | Select schedule lane 3 without narrowing any other lane's stored bits.
  prim sha256-lane3 :: U128 -> U32 where
    llvm {
      %shift = lshr i128 %0, 96
      %value = trunc i128 %shift to i32
      ret i32 %value
    }

  -- | Pack two chaining words with the first word in the low 32 bits.
  prim sha256-pair :: U32 -> U32 -> U64 where
    llvm {
      %low = zext i32 %0 to i64
      %high = zext i32 %1 to i64
      %upper = shl i64 %high, 32
      %value = or i64 %low, %upper
      ret i64 %value
    }

  -- | Decode four network-order words from two packed little-endian input byte words.
  prim sha256-input-group :: U64 -> U64 -> U128 where
    llvm {
      %swap0 = call i64 @llvm.bswap.i64(i64 %0)
      %left0 = shl i64 %swap0, 32
      %right0 = lshr i64 %swap0, 32
      %half0 = or i64 %left0, %right0
      %wide0 = zext i64 %half0 to i128
      %swap1 = call i64 @llvm.bswap.i64(i64 %1)
      %left1 = shl i64 %swap1, 32
      %right1 = lshr i64 %swap1, 32
      %half1 = or i64 %left1, %right1
      %wide1 = zext i64 %half1 to i128
      %upper = shl i128 %wide1, 64
      %value = or i128 %wide0, %upper
      ret i128 %value
    }

  -- | Feed forward two chaining words with independent U32 wrapping rather than a cross-lane carry.
  prim sha256-feed-pair :: U64 -> U64 -> U64 where
    llvm {
      %a0 = trunc i64 %0 to i32
      %as = lshr i64 %0, 32
      %a1 = trunc i64 %as to i32
      %b0 = trunc i64 %1 to i32
      %bs = lshr i64 %1, 32
      %b1 = trunc i64 %bs to i32
      %lo = add i32 %a0, %b0
      %hi = add i32 %a1, %b1
      %low = zext i32 %lo to i64
      %high = zext i32 %hi to i64
      %upper = shl i64 %high, 32
      %value = or i64 %low, %upper
      ret i64 %value
    }

  -- | Compute the choice, upper sigma and message contribution to one ordered round.
  prim sha256-t1 :: U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 where
    llvm {
      %s1ar = lshr i32 %0, 6
      %s1al = shl i32 %0, 26
      %s1a = or i32 %s1ar, %s1al
      %s1br = lshr i32 %0, 11
      %s1bl = shl i32 %0, 21
      %s1b = or i32 %s1br, %s1bl
      %s1cr = lshr i32 %0, 25
      %s1cl = shl i32 %0, 7
      %s1c = or i32 %s1cr, %s1cl
      %s1ab = xor i32 %s1a, %s1b
      %s1 = xor i32 %s1ab, %s1c
      %ef = and i32 %0, %1
      %not = xor i32 %0, -1
      %ng = and i32 %not, %2
      %ch = xor i32 %ef, %ng
      %t1a = add i32 %3, %s1
      %t1b = add i32 %t1a, %ch
      %t1c = add i32 %t1b, %4
      %value = add i32 %t1c, %5
      ret i32 %value
    }

  -- | Compute the majority and lower sigma contribution to one ordered round.
  prim sha256-t2 :: U32 -> U32 -> U32 -> U32 where
    llvm {
      %s0ar = lshr i32 %0, 2
      %s0al = shl i32 %0, 30
      %s0a = or i32 %s0ar, %s0al
      %s0br = lshr i32 %0, 13
      %s0bl = shl i32 %0, 19
      %s0b = or i32 %s0br, %s0bl
      %s0cr = lshr i32 %0, 22
      %s0cl = shl i32 %0, 10
      %s0c = or i32 %s0cr, %s0cl
      %s0ab = xor i32 %s0a, %s0b
      %s0 = xor i32 %s0ab, %s0c
      %ab = and i32 %0, %1
      %ac = and i32 %0, %2
      %bc = and i32 %1, %2
      %pair = xor i32 %ab, %ac
      %maj = xor i32 %pair, %bc
      %value = add i32 %s0, %maj
      ret i32 %value
    }

  -- | Expand four schedule lanes in SIMD, completing dependent lanes after the first two are available.
  prim sha256-schedule :: U128 -> U128 -> U128 -> U128 -> U128 where
    llvm {
      %v0 = bitcast i128 %0 to <4 x i32>
      %v1 = bitcast i128 %1 to <4 x i32>
      %v2 = bitcast i128 %2 to <4 x i32>
      %v3 = bitcast i128 %3 to <4 x i32>
      %a = shufflevector <4 x i32> %v0, <4 x i32> %v1, <4 x i32> <i32 1, i32 2, i32 3, i32 4>
      %b = shufflevector <4 x i32> %v2, <4 x i32> %v3, <4 x i32> <i32 1, i32 2, i32 3, i32 4>
      %c = shufflevector <4 x i32> %v3, <4 x i32> zeroinitializer, <4 x i32> <i32 2, i32 3, i32 4, i32 4>
      %s0ar = lshr <4 x i32> %a, <i32 7, i32 7, i32 7, i32 7>
      %s0al = shl <4 x i32> %a, <i32 25, i32 25, i32 25, i32 25>
      %s0a = or <4 x i32> %s0ar, %s0al
      %s0br = lshr <4 x i32> %a, <i32 18, i32 18, i32 18, i32 18>
      %s0bl = shl <4 x i32> %a, <i32 14, i32 14, i32 14, i32 14>
      %s0b = or <4 x i32> %s0br, %s0bl
      %s0c = lshr <4 x i32> %a, <i32 3, i32 3, i32 3, i32 3>
      %s0ab = xor <4 x i32> %s0a, %s0b
      %s0 = xor <4 x i32> %s0ab, %s0c
      %s1ar = lshr <4 x i32> %c, <i32 17, i32 17, i32 17, i32 17>
      %s1al = shl <4 x i32> %c, <i32 15, i32 15, i32 15, i32 15>
      %s1a = or <4 x i32> %s1ar, %s1al
      %s1br = lshr <4 x i32> %c, <i32 19, i32 19, i32 19, i32 19>
      %s1bl = shl <4 x i32> %c, <i32 13, i32 13, i32 13, i32 13>
      %s1b = or <4 x i32> %s1br, %s1bl
      %s1c = lshr <4 x i32> %c, <i32 10, i32 10, i32 10, i32 10>
      %s1ab = xor <4 x i32> %s1a, %s1b
      %s1 = xor <4 x i32> %s1ab, %s1c
      %base0 = add <4 x i32> %v0, %b
      %base1 = add <4 x i32> %base0, %s0
      %first = add <4 x i32> %base1, %s1
      %next = shufflevector <4 x i32> %first, <4 x i32> zeroinitializer, <4 x i32> <i32 4, i32 4, i32 0, i32 1>
      %s2ar = lshr <4 x i32> %next, <i32 17, i32 17, i32 17, i32 17>
      %s2al = shl <4 x i32> %next, <i32 15, i32 15, i32 15, i32 15>
      %s2a = or <4 x i32> %s2ar, %s2al
      %s2br = lshr <4 x i32> %next, <i32 19, i32 19, i32 19, i32 19>
      %s2bl = shl <4 x i32> %next, <i32 13, i32 13, i32 13, i32 13>
      %s2b = or <4 x i32> %s2br, %s2bl
      %s2c = lshr <4 x i32> %next, <i32 10, i32 10, i32 10, i32 10>
      %s2ab = xor <4 x i32> %s2a, %s2b
      %s2 = xor <4 x i32> %s2ab, %s2c
      %complete = add <4 x i32> %first, %s2
      %value = bitcast <4 x i32> %complete to i128
      ret i128 %value
    } when endian little
    llvm {
      %v0 = bitcast i128 %0 to <4 x i32>
      %g0 = shufflevector <4 x i32> %v0, <4 x i32> zeroinitializer, <4 x i32> <i32 3, i32 2, i32 1, i32 0>
      %v1 = bitcast i128 %1 to <4 x i32>
      %g1 = shufflevector <4 x i32> %v1, <4 x i32> zeroinitializer, <4 x i32> <i32 3, i32 2, i32 1, i32 0>
      %v2 = bitcast i128 %2 to <4 x i32>
      %g2 = shufflevector <4 x i32> %v2, <4 x i32> zeroinitializer, <4 x i32> <i32 3, i32 2, i32 1, i32 0>
      %v3 = bitcast i128 %3 to <4 x i32>
      %g3 = shufflevector <4 x i32> %v3, <4 x i32> zeroinitializer, <4 x i32> <i32 3, i32 2, i32 1, i32 0>
      %a = shufflevector <4 x i32> %g0, <4 x i32> %g1, <4 x i32> <i32 1, i32 2, i32 3, i32 4>
      %b = shufflevector <4 x i32> %g2, <4 x i32> %g3, <4 x i32> <i32 1, i32 2, i32 3, i32 4>
      %c = shufflevector <4 x i32> %g3, <4 x i32> zeroinitializer, <4 x i32> <i32 2, i32 3, i32 4, i32 4>
      %s0ar = lshr <4 x i32> %a, <i32 7, i32 7, i32 7, i32 7>
      %s0al = shl <4 x i32> %a, <i32 25, i32 25, i32 25, i32 25>
      %s0a = or <4 x i32> %s0ar, %s0al
      %s0br = lshr <4 x i32> %a, <i32 18, i32 18, i32 18, i32 18>
      %s0bl = shl <4 x i32> %a, <i32 14, i32 14, i32 14, i32 14>
      %s0b = or <4 x i32> %s0br, %s0bl
      %s0c = lshr <4 x i32> %a, <i32 3, i32 3, i32 3, i32 3>
      %s0ab = xor <4 x i32> %s0a, %s0b
      %s0 = xor <4 x i32> %s0ab, %s0c
      %s1ar = lshr <4 x i32> %c, <i32 17, i32 17, i32 17, i32 17>
      %s1al = shl <4 x i32> %c, <i32 15, i32 15, i32 15, i32 15>
      %s1a = or <4 x i32> %s1ar, %s1al
      %s1br = lshr <4 x i32> %c, <i32 19, i32 19, i32 19, i32 19>
      %s1bl = shl <4 x i32> %c, <i32 13, i32 13, i32 13, i32 13>
      %s1b = or <4 x i32> %s1br, %s1bl
      %s1c = lshr <4 x i32> %c, <i32 10, i32 10, i32 10, i32 10>
      %s1ab = xor <4 x i32> %s1a, %s1b
      %s1 = xor <4 x i32> %s1ab, %s1c
      %base0 = add <4 x i32> %g0, %b
      %base1 = add <4 x i32> %base0, %s0
      %first = add <4 x i32> %base1, %s1
      %next = shufflevector <4 x i32> %first, <4 x i32> zeroinitializer, <4 x i32> <i32 4, i32 4, i32 0, i32 1>
      %s2ar = lshr <4 x i32> %next, <i32 17, i32 17, i32 17, i32 17>
      %s2al = shl <4 x i32> %next, <i32 15, i32 15, i32 15, i32 15>
      %s2a = or <4 x i32> %s2ar, %s2al
      %s2br = lshr <4 x i32> %next, <i32 19, i32 19, i32 19, i32 19>
      %s2bl = shl <4 x i32> %next, <i32 13, i32 13, i32 13, i32 13>
      %s2b = or <4 x i32> %s2br, %s2bl
      %s2c = lshr <4 x i32> %next, <i32 10, i32 10, i32 10, i32 10>
      %s2ab = xor <4 x i32> %s2a, %s2b
      %s2 = xor <4 x i32> %s2ab, %s2c
      %complete = add <4 x i32> %first, %s2
      %host = shufflevector <4 x i32> %complete, <4 x i32> zeroinitializer, <4 x i32> <i32 3, i32 2, i32 1, i32 0>
      %value = bitcast <4 x i32> %host to i128
      ret i128 %value
    } when endian big
