  -- | Leading plain text bytes among the sixteen at base + offset (16 when all are). Stops at
  -- controls other than tab and line feed, non-ASCII bytes, '<', '&', carriage return, ']' and one
  -- extra byte (an attribute's quote, or 0 for none).
  prim text-span :: I64 -> I64 -> I64 -> I64 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %at = getelementptr i8, ptr %base, i64 %1
      %v = load <16 x i8>, ptr %at, align 1
      %e8 = trunc i64 %2 to i8
      %e1 = insertelement <16 x i8> poison, i8 %e8, i64 0
      %extra = shufflevector <16 x i8> %e1, <16 x i8> poison, <16 x i32> zeroinitializer
      %s0 = icmp eq <16 x i8> %v, %extra
      %low = icmp ult <16 x i8> %v, <i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32>
      %a0 = icmp ne <16 x i8> %v, <i8 9, i8 9, i8 9, i8 9, i8 9, i8 9, i8 9, i8 9, i8 9, i8 9, i8 9, i8 9, i8 9, i8 9, i8 9, i8 9>
      %k0 = and <16 x i1> %low, %a0
      %a1 = icmp ne <16 x i8> %v, <i8 10, i8 10, i8 10, i8 10, i8 10, i8 10, i8 10, i8 10, i8 10, i8 10, i8 10, i8 10, i8 10, i8 10, i8 10, i8 10>
      %k1 = and <16 x i1> %k0, %a1
      %s1 = or <16 x i1> %s0, %k1
      %hi = icmp uge <16 x i8> %v, <i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128>
      %s2 = or <16 x i1> %s1, %hi
      %t0 = icmp eq <16 x i8> %v, <i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60>
      %u0 = or <16 x i1> %s2, %t0
      %t1 = icmp eq <16 x i8> %v, <i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38>
      %u1 = or <16 x i1> %u0, %t1
      %t2 = icmp eq <16 x i8> %v, <i8 93, i8 93, i8 93, i8 93, i8 93, i8 93, i8 93, i8 93, i8 93, i8 93, i8 93, i8 93, i8 93, i8 93, i8 93, i8 93>
      %u2 = or <16 x i1> %u1, %t2
      %pick = select <16 x i1> %u2, <16 x i8> <i8 0, i8 1, i8 2, i8 3, i8 4, i8 5, i8 6, i8 7, i8 8, i8 9, i8 10, i8 11, i8 12, i8 13, i8 14, i8 15>, <16 x i8> <i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16>
      %first = call i8 @llvm.vector.reduce.umin.v16i8(<16 x i8> %pick)
      %r = zext i8 %first to i64
      ret i64 %r
    }

  -- | Leading bytes that escaping leaves unchanged among the sixteen at base + offset (16 when all
  -- are). Stops at every control, non-ASCII bytes, the quotes, '&', '<', '>' and one extra byte.
  prim escape-span :: I64 -> I64 -> I64 -> I64 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %at = getelementptr i8, ptr %base, i64 %1
      %v = load <16 x i8>, ptr %at, align 1
      %e8 = trunc i64 %2 to i8
      %e1 = insertelement <16 x i8> poison, i8 %e8, i64 0
      %extra = shufflevector <16 x i8> %e1, <16 x i8> poison, <16 x i32> zeroinitializer
      %s0 = icmp eq <16 x i8> %v, %extra
      %low = icmp ult <16 x i8> %v, <i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32, i8 32>
      %s1 = or <16 x i1> %s0, %low
      %hi = icmp uge <16 x i8> %v, <i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128, i8 128>
      %s2 = or <16 x i1> %s1, %hi
      %t0 = icmp eq <16 x i8> %v, <i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34>
      %u0 = or <16 x i1> %s2, %t0
      %t1 = icmp eq <16 x i8> %v, <i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39>
      %u1 = or <16 x i1> %u0, %t1
      %t2 = icmp eq <16 x i8> %v, <i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38>
      %u2 = or <16 x i1> %u1, %t2
      %t3 = icmp eq <16 x i8> %v, <i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60>
      %u3 = or <16 x i1> %u2, %t3
      %t4 = icmp eq <16 x i8> %v, <i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62>
      %u4 = or <16 x i1> %u3, %t4
      %pick = select <16 x i1> %u4, <16 x i8> <i8 0, i8 1, i8 2, i8 3, i8 4, i8 5, i8 6, i8 7, i8 8, i8 9, i8 10, i8 11, i8 12, i8 13, i8 14, i8 15>, <16 x i8> <i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16>
      %first = call i8 @llvm.vector.reduce.umin.v16i8(<16 x i8> %pick)
      %r = zext i8 %first to i64
      ret i64 %r
    }
