-- | Contextual HTML templates: data-driven HTML documents with automatic,
-- context-aware escaping to prevent cross-site scripting and injection attacks.
-- Templates share the syntax and control flow of `Text.Template` (fields,
-- variables, pipelines, `if`/`else if`, `range` with `break` and `continue`,
-- `with`/`else with`, `define`, `block`, `template`, trim markers, comments,
-- custom delimiters, missing-key modes, builtins, and custom functions) while
-- tracking the exact HTML, attribute, URL, srcset, JavaScript, CSS, RCDATA, and
-- comment parsing state at every action and static text span.
--
-- Values are represented by `HtmlValue`, which wraps `TemplateValue` along with
-- typed safe wrappers (`HvSafeHtml`, `HvSafeHtmlAttr`, `HvSafeCss`, `HvSafeJs`,
-- `HvSafeJsStr`, `HvSafeUrl`, `HvSafeSrcset`) and nested `HvList`/`HvMap`
-- containers so trusted content bypasses only the escaping layer that matches
-- its declared type. All lexing, parsing, contextual analysis, escaping, and
-- evaluation are implemented in pure portable code with zero inline LLVM.
module Text.HtmlTemplate where

  import Data.Bytes
  import Data.Bytes.Build
  import Data.Int
  import Data.Json
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String
  import Data.Unicode.Kernel
  import Text.Html (html-unescape-bytes)
  import Text.Show (nat-to-string, int-to-string)
  import Text.Template (TemplateValue, TvNil, TvBool, TvInt, TvFloat, TvString, TvList, TvListEnd, TvMap, TvMapEnd, template-from-json, template-is-true, MissingKey, MissingKeyDefault, MissingKeyZero, MissingKeyError, template-html-escape, template-js-escape, template-url-query-escape, template-sprintf)

  export HtmlValue, HvTemplate, HvSafeHtml, HvSafeHtmlAttr, HvSafeCss, HvSafeJs, HvSafeJsStr, HvSafeUrl, HvSafeSrcset, HvList, HvListEnd, HvMap, HvMapEnd
  export html-from-template, html-to-template, html-list, html-map, html-is-true, html-value-from-json
  export safe-html, safe-html-attr, safe-css, safe-js, safe-js-str, safe-url, safe-srcset
  export HtmlTemplateError, HtmlTemplateParseError, HtmlTemplateEscapeError, HtmlTemplateExecError, html-template-error-message
  export HtmlTemplateFunction, HtmlTemplate
  export html-template-new, html-template-delims, html-template-missing-key, html-template-funcs
  export html-template-parse, html-template-execute, html-template-execute-named, html-template-names, html-template-name
  export html-escape-string, js-escape-string, url-query-escape-string

  -- ---------------------------------------------------------------------
  -- Values and safe content wrappers.
  -- ---------------------------------------------------------------------

  -- | A dynamic value for HTML templates: plain `TemplateValue` payloads,
  -- typed safe strings, and lists or sorted string-keyed maps of `HtmlValue`.
  data HtmlValue where
    -- | Any untrusted dynamic value from `Text.Template`.
    HvTemplate :: TemplateValue -> HtmlValue
    -- | A known-safe HTML document fragment.
    HvSafeHtml :: String -> HtmlValue
    -- | A known-safe HTML attribute (for example `dir="ltr"`).
    HvSafeHtmlAttr :: String -> HtmlValue
    -- | Known-safe CSS content (value, declaration, rule, or stylesheet).
    HvSafeCss :: String -> HtmlValue
    -- | A known-safe JavaScript expression.
    HvSafeJs :: String -> HtmlValue
    -- | Known-safe characters for inclusion inside a JavaScript string literal.
    HvSafeJsStr :: String -> HtmlValue
    -- | A known-safe URL or URL substring.
    HvSafeUrl :: String -> HtmlValue
    -- | A known-safe HTML `srcset` attribute value.
    HvSafeSrcset :: String -> HtmlValue
    -- | A list element followed by the rest of the list.
    HvList :: HtmlValue -> HtmlValue -> HtmlValue
    -- | The end of a list (alone, the empty list).
    HvListEnd :: HtmlValue
    -- | A map entry (key and value) followed by entries with greater keys.
    HvMap :: String -> HtmlValue -> HtmlValue -> HtmlValue
    -- | The end of a map (alone, the empty map).
    HvMapEnd :: HtmlValue

  -- | Wrap a `TemplateValue` as an untrusted `HtmlValue`.
  html-from-template :: TemplateValue -> HtmlValue
  html-from-template v = HvTemplate v

  -- | Strip safe content wrappers and convert an `HtmlValue` down to a plain `TemplateValue`.
  html-to-template :: HtmlValue -> TemplateValue
  html-to-template v = case v of
    HvTemplate tv -> tv
    HvSafeHtml s -> TvString s
    HvSafeHtmlAttr s -> TvString s
    HvSafeCss s -> TvString s
    HvSafeJs s -> TvString s
    HvSafeJsStr s -> TvString s
    HvSafeUrl s -> TvString s
    HvSafeSrcset s -> TvString s
    HvList x rest -> TvList (html-to-template x) (html-to-template rest)
    HvListEnd -> TvListEnd
    HvMap k x rest -> TvMap k (html-to-template x) (html-to-template rest)
    HvMapEnd -> TvMapEnd

  -- | Construct a known-safe HTML fragment value.
  safe-html :: String -> HtmlValue
  safe-html s = HvSafeHtml s

  -- | Construct a known-safe HTML attribute value.
  safe-html-attr :: String -> HtmlValue
  safe-html-attr s = HvSafeHtmlAttr s

  -- | Construct a known-safe CSS value.
  safe-css :: String -> HtmlValue
  safe-css s = HvSafeCss s

  -- | Construct a known-safe JavaScript expression value.
  safe-js :: String -> HtmlValue
  safe-js s = HvSafeJs s

  -- | Construct a known-safe JavaScript string payload value.
  safe-js-str :: String -> HtmlValue
  safe-js-str s = HvSafeJsStr s

  -- | Construct a known-safe URL value.
  safe-url :: String -> HtmlValue
  safe-url s = HvSafeUrl s

  -- | Construct a known-safe `srcset` attribute value.
  safe-srcset :: String -> HtmlValue
  safe-srcset s = HvSafeSrcset s

  -- | Build an `HtmlValue` list spine from elements in order.
  html-list :: List HtmlValue -> HtmlValue
  html-list items = case items of
    Nil -> HvListEnd
    Cons x rest -> HvList x (html-list rest)

  -- | Build an `HtmlValue` map spine with keys kept in ascending byte order; repeated keys keep their last value.
  html-map :: List (String, HtmlValue) -> HtmlValue
  html-map entries = build-hmap entries HvMapEnd

  -- | Insert map entries into an accumulator spine.
  build-hmap :: List (String, HtmlValue) -> HtmlValue -> HtmlValue
  build-hmap entries acc = case entries of
    Nil -> acc
    Cons e rest -> case e of (k, v) -> build-hmap rest (hmap-insert acc k v)

  -- | Insert or replace one key in a sorted `HtmlValue` map spine.
  hmap-insert :: HtmlValue -> String -> HtmlValue -> HtmlValue
  hmap-insert m k v = case m of
    HvMap key value rest ->
      if eq-i64 (string-compare k key) 0 then HvMap k v rest
      else if lt-i64 (string-compare k key) 0 then HvMap k v m
      else HvMap key value (hmap-insert rest k v)
    other -> HvMap k v HvMapEnd

  -- | Convert a `Json` value into an untrusted `HtmlValue`.
  html-value-from-json :: Json -> HtmlValue
  html-value-from-json j = HvTemplate (template-from-json j)

  -- | Truthiness: false for nil, false, zero, empty strings, and empty lists or maps.
  html-is-true :: HtmlValue -> Bool
  html-is-true v = case v of
    HvTemplate tv -> template-is-true tv
    HvSafeHtml s -> string-byte-length s > 0
    HvSafeHtmlAttr s -> string-byte-length s > 0
    HvSafeCss s -> string-byte-length s > 0
    HvSafeJs s -> string-byte-length s > 0
    HvSafeJsStr s -> string-byte-length s > 0
    HvSafeUrl s -> string-byte-length s > 0
    HvSafeSrcset s -> string-byte-length s > 0
    HvList x rest -> True
    HvListEnd -> False
    HvMap k x rest -> True
    HvMapEnd -> False

  -- ---------------------------------------------------------------------
  -- Errors, standalone escapers, and template sets.
  -- ---------------------------------------------------------------------

  -- | A template failure: syntax parsing, contextual escaping analysis, or runtime execution.
  data HtmlTemplateError where
    -- | The template source failed syntax lexing or parsing.
    HtmlTemplateParseError :: String -> HtmlTemplateError
    -- | Contextual auto-escaping rejected an unsafe, ambiguous, or malformed HTML/JS/CSS construct.
    HtmlTemplateEscapeError :: String -> HtmlTemplateError
    -- | Template execution failed at runtime.
    HtmlTemplateExecError :: String -> HtmlTemplateError

  -- | Extract the diagnostic message from an `HtmlTemplateError`.
  html-template-error-message :: HtmlTemplateError -> String
  html-template-error-message e = case e of
    HtmlTemplateParseError m -> m
    HtmlTemplateEscapeError m -> m
    HtmlTemplateExecError m -> m

  -- | A user-supplied template function mapping evaluated arguments to a result value or error message.
  data HtmlTemplateFunction where
    -- | Function implementation over `HtmlValue` arguments.
    HtmlTemplateFunction :: (List HtmlValue -> Result String HtmlValue) -> HtmlTemplateFunction

  -- | An immutable HTML template set: name, left/right delimiters, missing-key mode, custom functions, and parsed bodies.
  data HtmlTemplate where
    -- | Fields in the order listed above.
    HtmlTemplate :: String -> Bytes -> Bytes -> MissingKey -> List (String, HtmlTemplateFunction) -> List (String, Node) -> HtmlTemplate

  -- | Create an empty HTML template set with default `{{` and `}}` delimiters.
  html-template-new :: String -> HtmlTemplate
  html-template-new name = HtmlTemplate name (string-to-bytes "{{") (string-to-bytes "}}") MissingKeyDefault Nil Nil

  -- | Configure action delimiters for subsequent parses; empty strings restore `{{` and `}}`.
  html-template-delims :: HtmlTemplate -> String -> String -> HtmlTemplate
  html-template-delims t left right = case t of
    HtmlTemplate name l r mk fs ts ->
      HtmlTemplate name (if left == "" then string-to-bytes "{{" else string-to-bytes left) (if right == "" then string-to-bytes "}}" else string-to-bytes right) mk fs ts

  -- | Set the missing-key mode for map field lookups.
  html-template-missing-key :: HtmlTemplate -> MissingKey -> HtmlTemplate
  html-template-missing-key t mode = case t of
    HtmlTemplate name l r mk fs ts -> HtmlTemplate name l r mode fs ts

  -- | Register custom functions (later entries shadow earlier ones of the same name).
  html-template-funcs :: HtmlTemplate -> List (String, HtmlTemplateFunction) -> HtmlTemplate
  html-template-funcs t more = case t of
    HtmlTemplate name l r mk fs ts -> HtmlTemplate name l r mk (append-pairs more fs) ts

  -- | Prepend pairs onto an association list so newer entries shadow older ones.
  append-pairs :: forall a. List (String, a) -> List (String, a) -> List (String, a)
  append-pairs xs ys = case xs of Nil -> ys; Cons x rest -> Cons x (append-pairs rest ys)

  -- | The main template name of the set.
  html-template-name :: HtmlTemplate -> String
  html-template-name t = case t of HtmlTemplate name l r mk fs ts -> name

  -- | The names of all templates currently defined in the set.
  html-template-names :: HtmlTemplate -> List String
  html-template-names t = case t of HtmlTemplate name l r mk fs ts -> map fst-node ts

  -- | Extract the template name from a name-body pair.
  fst-node :: (String, Node) -> String
  fst-node p = case p of (n, x) -> n

  -- | Escape plain text for HTML text nodes (`"`, `'`, `&`, `<`, `>`, and NUL to U+FFFD).
  html-escape-string :: String -> String
  html-escape-string s = text-of (template-html-escape (string-to-bytes s))

  -- | Escape plain text for JavaScript string literals.
  js-escape-string :: String -> String
  js-escape-string s = text-of (template-js-escape (string-to-bytes s))

  -- | Escape plain text for URL query components.
  url-query-escape-string :: String -> String
  url-query-escape-string s = text-of (template-url-query-escape (string-to-bytes s))

  -- | Parse template source into the set's main template and any `define`/`block` templates it declares.
  html-template-parse :: HtmlTemplate -> String -> Result HtmlTemplateError HtmlTemplate
  html-template-parse t text = case t of
    HtmlTemplate name l r mk fs ts -> case lex-template (string-to-bytes text) l r of
      Err message -> Err (HtmlTemplateParseError (string-concat-all ["template: ", name, ":", message]))
      Ok tokens -> case parse-top name (func-names fs) tokens of
        Err message -> Err (HtmlTemplateParseError (string-concat-all ["template: ", name, ":", message]))
        Ok (root, defs) -> Ok (HtmlTemplate name l r mk fs (associate (Cons (name, root) defs) ts))

  -- | Merge newly parsed templates into a set, preserving a non-empty body over a whitespace-only body.
  associate :: List (String, Node) -> List (String, Node) -> List (String, Node)
  associate fresh ts = case fresh of
    Nil -> ts
    Cons d rest -> case d of
      (n, root) -> case lookup-node ts n of
        Some old -> if is-empty-tree root && not (is-empty-tree old) then associate rest ts else associate rest (Cons d (drop-node ts n))
        None -> associate rest (Cons d ts)

  -- | Look up a parsed template body by name.
  lookup-node :: List (String, Node) -> String -> Option Node
  lookup-node ts n = case ts of
    Nil -> None
    Cons d rest -> case d of (m, root) -> if m == n then Some root else lookup-node rest n

  -- | Remove a template entry by name.
  drop-node :: List (String, Node) -> String -> List (String, Node)
  drop-node ts n = case ts of
    Nil -> Nil
    Cons d rest -> case d of (m, root) -> if m == n then drop-node rest n else Cons d (drop-node rest n)

  -- | Report whether a template body consists solely of whitespace text nodes.
  is-empty-tree :: Node -> Bool
  is-empty-tree node = case node of
    NdEnd -> True
    NdText b next -> all-space b 0 && is-empty-tree next
    other -> False

  -- | Report whether every byte in a buffer is ASCII template whitespace.
  all-space :: Bytes -> Nat -> Bool
  all-space b i = if i >= bytes-len b then True else if is-space (at b i) then all-space b (i + 1) else False

  -- | Collect all function names visible during parsing.
  func-names :: List (String, HtmlTemplateFunction) -> List String
  func-names fs = case fs of Nil -> builtin-names; Cons f rest -> case f of (n, g) -> Cons n (func-names rest)

  -- | The standard builtin function names available in template actions.
  builtin-names :: List String
  builtin-names = ["and", "or", "not", "len", "index", "slice", "print", "printf", "println", "eq", "ne", "lt", "le", "gt", "ge", "html", "js", "urlquery", "call"]

  -- | Contextually escape and execute the main template with `data-value`.
  html-template-execute :: HtmlTemplate -> HtmlValue -> Result HtmlTemplateError Bytes
  html-template-execute t data-value = html-template-execute-named t (html-template-name t) data-value

  -- | Contextually escape and execute a named template from the set with `data-value`.
  html-template-execute-named :: HtmlTemplate -> String -> HtmlValue -> Result HtmlTemplateError Bytes
  html-template-execute-named t name data-value = case t of
    HtmlTemplate main l r mk fs ts -> case lookup-node ts name of
      None -> Err (HtmlTemplateExecError (string-concat-all ["html/template: \"", name, "\" is undefined"]))
      Some root -> case escape-template-root ts name root of
        Err esc-msg -> Err (HtmlTemplateEscapeError (string-concat-all ["html/template:", name, ": ", esc-msg]))
        Ok (escaped-root, derived-ts) ->
          let all-ts = append-pairs (Cons (name, escaped-root) derived-ts) ts in
          case exec-nodes (ExecCtx all-ts fs mk name 0) escaped-root data-value Nil (Cons ("$", data-value) Nil) of
            Err message -> Err (HtmlTemplateExecError (string-concat-all ["template: ", name, ": ", message]))
            Ok run -> case run of Run out vars flow -> Ok (bytes-concat (reverse out))

  -- ---------------------------------------------------------------------
  -- Lexing (pure portable scanning).
  -- ---------------------------------------------------------------------

  -- | A lexical token from a template source.
  data Tok where
    -- | Literal text between actions (trim markers already applied).
    TokText :: Bytes -> Tok
    -- | Opening action delimiter.
    TokLeft :: Tok
    -- | Closing action delimiter.
    TokRight :: Tok
    -- | Whitespace run inside an action.
    TokSpace :: Tok
    -- | Identifier or keyword.
    TokIdent :: String -> Tok
    -- | Field name following a dot.
    TokField :: String -> Tok
    -- | Standalone cursor `.`.
    TokDot :: Tok
    -- | Variable name starting with `$`.
    TokVar :: String -> Tok
    -- | Numeric literal spelling.
    TokNumber :: String -> Tok
    -- | Character constant code point.
    TokChar :: Nat -> Tok
    -- | Decoded quoted or raw string literal.
    TokString :: String -> Tok
    -- | Pipeline separator `|`.
    TokPipe :: Tok
    -- | Left parenthesis `(`.
    TokOpen :: Tok
    -- | Right parenthesis `)`.
    TokClose :: Tok
    -- | Variable declaration `:=`.
    TokDeclare :: Tok
    -- | Variable assignment `=`.
    TokAssign :: Tok
    -- | Comma `,`.
    TokComma :: Tok

  -- | A token paired with its 1-based source line number.
  data Lexeme where
    -- | Token and starting line number.
    Lexeme :: Tok -> Nat -> Lexeme

  -- | Lex template bytes using the given opening and closing delimiters.
  lex-template :: Bytes -> Bytes -> Bytes -> Result String (List Lexeme)
  lex-template s left right = lex-text s left right 0 1 Nil

  -- | Scan literal text up to the next opening delimiter.
  lex-text :: Bytes -> Bytes -> Bytes -> Nat -> Nat -> List Lexeme -> Result String (List Lexeme)
  lex-text s left right i line acc =
    let k = find-delim s left i in
    if k >= bytes-len s then Ok (reverse (push-text s i (bytes-len s) line acc))
    else
      let after = k + bytes-len left in
      let trim = after + 1 < bytes-len s && at s after == 45 && is-space (at s (after + 1)) in
      let end = if trim then trim-right s i k else k in
      let texted = push-text s i end line acc in
      let start = if trim then after + 2 else after in
      let here = line + newlines s i k 0 in
      if start + 1 < bytes-len s && at s start == 47 && at s (start + 1) == 42 then lex-comment s left right (start + 2) here texted
      else lex-action s left right start here 0 (Cons (Lexeme TokLeft here) texted)

  -- | Push a non-empty text token onto the reversed accumulator.
  push-text :: Bytes -> Nat -> Nat -> Nat -> List Lexeme -> List Lexeme
  push-text s i end line acc = if end > i then Cons (Lexeme (TokText (slice s i end)) line) acc else acc

  -- | Trim trailing ASCII template whitespace without crossing `start`.
  trim-right :: Bytes -> Nat -> Nat -> Nat
  trim-right s start end = if end > start && is-space (at s (end - 1)) then trim-right s start (end - 1) else end

  -- | Skip leading ASCII template whitespace.
  trim-left :: Bytes -> Nat -> Nat
  trim-left s i = if i < bytes-len s && is-space (at s i) then trim-left s (i + 1) else i

  -- | Count LF bytes in `s[i, k)`.
  newlines :: Bytes -> Nat -> Nat -> Nat -> Nat
  newlines s i k n = if i >= k then n else newlines s (i + 1) k (if at s i == 10 then n + 1 else n)

  -- | Scan a template comment after `/*` through `*/` and the closing delimiter.
  lex-comment :: Bytes -> Bytes -> Bytes -> Nat -> Nat -> List Lexeme -> Result String (List Lexeme)
  lex-comment s left right i line acc = case find-bytes s (string-to-bytes "*/") i of
    None -> Err (string-concat (nat-to-string line) ": unclosed comment")
    Some k ->
      let after = k + 2 in
      let here = line + newlines s i k 0 in
      if has-trimmed-right s after right then lex-text s left right (trim-left s (after + 2 + bytes-len right)) here acc
      else if starts-with s after right then lex-text s left right (after + bytes-len right) here acc
      else Err (string-concat (nat-to-string here) ": comment ends before closing delimiter")

  -- | Report whether a trim-marked closing delimiter starts at `i`.
  has-trimmed-right :: Bytes -> Nat -> Bytes -> Bool
  has-trimmed-right s i right = i < bytes-len s && is-space (at s i) && at s (i + 1) == 45 && starts-with s (i + 2) right

  -- | Lex tokens inside an action until the closing delimiter.
  lex-action :: Bytes -> Bytes -> Bytes -> Nat -> Nat -> Nat -> List Lexeme -> Result String (List Lexeme)
  lex-action s left right i line depth acc =
    if has-trimmed-right s i right then close-action s left right (trim-left s (i + 2 + bytes-len right)) line depth acc
    else if starts-with s i right then close-action s left right (i + bytes-len right) line depth acc
    else if i >= bytes-len s then Err (string-concat (nat-to-string line) ": unclosed action")
    else
      let c = at s i in
      if is-space c then lex-space s left right i line depth acc
      else if c == 61 then lex-action s left right (i + 1) line depth (Cons (Lexeme TokAssign line) acc)
      else if c == 58 then (if at s (i + 1) == 61 then lex-action s left right (i + 2) line depth (Cons (Lexeme TokDeclare line) acc) else Err (string-concat (nat-to-string line) ": expected :="))
      else if c == 124 then lex-action s left right (i + 1) line depth (Cons (Lexeme TokPipe line) acc)
      else if c == 44 then lex-action s left right (i + 1) line depth (Cons (Lexeme TokComma line) acc)
      else if c == 40 then lex-action s left right (i + 1) line (depth + 1) (Cons (Lexeme TokOpen line) acc)
      else if c == 41 then (if depth == 0 then Err (string-concat (nat-to-string line) ": unexpected right paren") else lex-action s left right (i + 1) line (depth - 1) (Cons (Lexeme TokClose line) acc))
      else if c == 34 then lex-quote s left right (i + 1) line depth acc
      else if c == 96 then lex-raw s left right (i + 1) line depth acc
      else if c == 39 then lex-char s left right (i + 1) line depth acc
      else if c == 36 then lex-word s left right i line depth acc
      else if c == 46 && not (i + 1 < bytes-len s && is-digit (at s (i + 1))) then lex-word s left right i line depth acc
      else if c == 46 || c == 43 || c == 45 || is-digit c then lex-number s left right i line depth acc
      else if is-alpha c then lex-word s left right i line depth acc
      else Err (string-concat (nat-to-string line) ": unrecognized character in action")

  -- | Close an action after checking balanced parentheses and resume literal text scanning.
  close-action :: Bytes -> Bytes -> Bytes -> Nat -> Nat -> Nat -> List Lexeme -> Result String (List Lexeme)
  close-action s left right next line depth acc =
    if depth > 0 then Err (string-concat (nat-to-string line) ": unclosed left paren")
    else lex-text s left right next line (Cons (Lexeme TokRight line) acc)

  -- | Lex whitespace inside an action without consuming a trim-marked closing delimiter.
  lex-space :: Bytes -> Bytes -> Bytes -> Nat -> Nat -> Nat -> List Lexeme -> Result String (List Lexeme)
  lex-space s left right i line depth acc =
    let j = space-run s right i in
    let lines = newlines s i j 0 in
    if j == i then lex-action s left right i line depth acc
    else lex-action s left right j (line + lines) depth (Cons (Lexeme TokSpace line) acc)

  -- | Find the end of an interior space run inside an action.
  space-run :: Bytes -> Bytes -> Nat -> Nat
  space-run s right i = if i < bytes-len s && is-space (at s i) && not (has-trimmed-right s i right) then space-run s right (i + 1) else i

  -- | Lex a variable, field, dot, or identifier word.
  lex-word :: Bytes -> Bytes -> Bytes -> Nat -> Nat -> Nat -> List Lexeme -> Result String (List Lexeme)
  lex-word s left right start line depth acc =
    let kind = at s start in
    let j = alnum-run s (start + 1) in
    if not (at-terminator s j right) then Err (string-concat (nat-to-string line) ": bad character in action")
    else
      let word = text-of (slice s start j) in
      let token = if kind == 36 then TokVar word else if kind == 46 then (if j == start + 1 then TokDot else TokField (text-of (slice s (start + 1) j))) else TokIdent word in
      lex-action s left right j line depth (Cons (Lexeme token line) acc)

  -- | Advance past ASCII alphanumeric, underscore, or non-ASCII bytes.
  alnum-run :: Bytes -> Nat -> Nat
  alnum-run s i = if i < bytes-len s && (is-alpha (at s i) || is-digit (at s i)) then alnum-run s (i + 1) else i

  -- | Report whether `i` sits at a valid word terminator inside an action.
  at-terminator :: Bytes -> Nat -> Bytes -> Bool
  at-terminator s i right =
    if i >= bytes-len s then True
    else
      let c = at s i in
      is-space c || c == 46 || c == 44 || c == 124 || c == 58 || c == 41 || c == 40 || starts-with s i right

  -- | Lex a numeric literal spelling.
  lex-number :: Bytes -> Bytes -> Bytes -> Nat -> Nat -> Nat -> List Lexeme -> Result String (List Lexeme)
  lex-number s left right i line depth acc =
    let j = number-run s (if at s i == 43 || at s i == 45 then i + 1 else i) in
    if j < bytes-len s && is-alpha (at s j) then Err (string-concat (nat-to-string line) ": bad number syntax")
    else if j == i + 1 && (at s i == 43 || at s i == 45) then Err (string-concat (nat-to-string line) ": bad number syntax")
    else lex-action s left right j line depth (Cons (Lexeme (TokNumber (text-of (slice s i j))) line) acc)

  -- | Advance across numeric literal characters.
  number-run :: Bytes -> Nat -> Nat
  number-run s i =
    if i >= bytes-len s then i
    else
      let c = at s i in
      if is-digit c || c == 46 || c == 95 || (lower c >= 97 && lower c <= 102) || lower c == 120 || lower c == 111 || lower c == 112 then number-run s (i + 1)
      else if (c == 43 || c == 45) && i > 0 && (lower (at s (i - 1)) == 101 || lower (at s (i - 1)) == 112) then number-run s (i + 1)
      else i

  -- | Lex a double-quoted string literal inside an action.
  lex-quote :: Bytes -> Bytes -> Bytes -> Nat -> Nat -> Nat -> List Lexeme -> Result String (List Lexeme)
  lex-quote s left right i line depth acc = case unquote s i 34 Nil of
    Err message -> Err (string-concat-all [nat-to-string line, ": ", message])
    Ok (value, next) -> lex-action s left right next line depth (Cons (Lexeme (TokString (text-of value)) line) acc)

  -- | Lex a backquote raw string literal inside an action.
  lex-raw :: Bytes -> Bytes -> Bytes -> Nat -> Nat -> Nat -> List Lexeme -> Result String (List Lexeme)
  lex-raw s left right i line depth acc = case find-byte s 96 i of
    None -> Err (string-concat (nat-to-string line) ": unterminated raw quoted string")
    Some k -> lex-action s left right (k + 1) (line + newlines s i k 0) depth (Cons (Lexeme (TokString (text-of (drop-cr (slice s i k)))) line) acc)

  -- | Lex a single-quoted character literal inside an action.
  lex-char :: Bytes -> Bytes -> Bytes -> Nat -> Nat -> Nat -> List Lexeme -> Result String (List Lexeme)
  lex-char s left right i line depth acc = case unquote s i 39 Nil of
    Err message -> Err (string-concat (nat-to-string line) ": unterminated character constant")
    Ok (value, next) ->
      let n = rune-size value 0 in
      if n == 0 || not (n == bytes-len value) then Err (string-concat (nat-to-string line) ": malformed character constant")
      else lex-action s left right next line depth (Cons (Lexeme (TokChar (rune-value value 0 n)) line) acc)

  -- | Decode an escaped string or character literal up to delimiter `q`.
  unquote :: Bytes -> Nat -> Nat -> List Bytes -> Result String (Bytes, Nat)
  unquote s i q pieces =
    if i >= bytes-len s || at s i == 10 then Err "unterminated quoted string"
    else
      let c = at s i in
      if c == q then Ok (bytes-concat (reverse pieces), i + 1)
      else if c == 92 then escape-seq s (i + 1) q pieces
      else unquote s (i + 1) q (Cons (slice s i (i + 1)) pieces)

  -- | Decode one backslash escape sequence inside a string or character literal.
  escape-seq :: Bytes -> Nat -> Nat -> List Bytes -> Result String (Bytes, Nat)
  escape-seq s i q pieces =
    let c = at s i in
    let simple = if c == 97 then (7 :: Nat) else if c == 98 then (8 :: Nat) else if c == 102 then (12 :: Nat) else if c == 110 then (10 :: Nat) else if c == 13 then (13 :: Nat) else if c == 114 then (13 :: Nat) else if c == 116 then (9 :: Nat) else if c == 118 then (11 :: Nat) else if c == 92 then (92 :: Nat) else if c == 39 && q == 39 then (39 :: Nat) else if c == 34 && q == 34 then (34 :: Nat) else 256 in
    if i >= bytes-len s then Err "unterminated quoted string"
    else if simple < 256 && not (c == 13) then unquote s (i + 1) q (Cons (from-list [simple]) pieces)
    else if c == 120 then hex-escape s (i + 1) 2 q pieces False
    else if c == 117 then hex-escape s (i + 1) 4 q pieces True
    else if c == 85 then hex-escape s (i + 1) 8 q pieces True
    else if c >= 48 && c <= 55 then octal-escape s i q pieces
    else Err "invalid syntax"

  -- | Decode a hexadecimal byte or Unicode scalar escape.
  hex-escape :: Bytes -> Nat -> Nat -> Nat -> List Bytes -> Bool -> Result String (Bytes, Nat)
  hex-escape s i n q pieces rune =
    let value = hex-value s i (i + n) 0 in
    if i + n > bytes-len s || not (all-hex s i (i + n)) then Err "invalid syntax"
    else if rune then (if value > 1114111 || (value >= 55296 && value <= 57343) then Err "invalid syntax" else unquote s (i + n) q (Cons (encode-rune value) pieces))
    else unquote s (i + n) q (Cons (from-list [value]) pieces)

  -- | Decode a three-digit octal byte escape.
  octal-escape :: Bytes -> Nat -> Nat -> List Bytes -> Result String (Bytes, Nat)
  octal-escape s i q pieces =
    let d0 = at s i in let d1 = at s (i + 1) in let d2 = at s (i + 2) in
    if not (is-octal d0 && is-octal d1 && is-octal d2) then Err "invalid syntax"
    else
      let value = (minus d0 48 * 8 + minus d1 48) * 8 + minus d2 48 in
      if value > 255 then Err "invalid syntax" else unquote s (i + 3) q (Cons (from-list [value]) pieces)

  -- | Report whether every byte in `s[i, j)` is a hexadecimal digit.
  all-hex :: Bytes -> Nat -> Nat -> Bool
  all-hex s i j = if i >= j then True else if is-hex (at s i) then all-hex s (i + 1) j else False

  -- | Accumulate hexadecimal digits in `s[i, j)`.
  hex-value :: Bytes -> Nat -> Nat -> Nat -> Nat
  hex-value s i j acc = if i >= j then acc else hex-value s (i + 1) j (acc * 16 + hex-digit (at s i))

  -- | Remove carriage return bytes from a raw string literal.
  drop-cr :: Bytes -> Bytes
  drop-cr b = from-list (drop-cr-from b 0 Nil)

  -- | Collect non-CR bytes in order.
  drop-cr-from :: Bytes -> Nat -> List Nat -> List Nat
  drop-cr-from b i acc = if i >= bytes-len b then reverse acc else drop-cr-from b (i + 1) (if at b i == 13 then acc else Cons (at b i) acc)

  -- | Find the next opening delimiter at or after `i`, or `bytes-len s` if none exists.
  find-delim :: Bytes -> Bytes -> Nat -> Nat
  find-delim s left i =
    if bytes-len left == 0 || i + bytes-len left > bytes-len s then bytes-len s
    else
      let k = scalar-find s (at left 0) i in
      if k + bytes-len left > bytes-len s then bytes-len s
      else if starts-with s k left then k
      else find-delim s left (k + 1)

  -- | Find the first occurrence of byte `b` at or after `i`, or `bytes-len s`.
  scalar-find :: Bytes -> Nat -> Nat -> Nat
  scalar-find s b i = if i >= bytes-len s then bytes-len s else if at s i == b then i else scalar-find s b (i + 1)

  -- ---------------------------------------------------------------------
  -- Parse trees and parser.
  -- ---------------------------------------------------------------------

  -- | Template expressions: operands, commands, and pipelines.
  data Expr where
    -- | The current cursor `.`.
    ExDot :: Expr
    -- | The `nil` literal.
    ExNil :: Expr
    -- | A constant literal value.
    ExConst :: HtmlValue -> Expr
    -- | Field lookup chain on the cursor (`.a.b`).
    ExField :: List String -> Expr
    -- | Variable and optional field lookup chain (`$x.a`).
    ExVar :: String -> List String -> Expr
    -- | Function or internal escaper identifier.
    ExFunc :: String -> Expr
    -- | Field lookup chain on a parenthesized pipeline.
    ExChain :: Expr -> List String -> Expr
    -- | A pipeline: variable declarations, assignment flag, and command spine.
    ExPipe :: List String -> Bool -> Expr -> Expr
    -- | One command (operand spine) followed by remaining pipeline commands.
    ExCmd :: Expr -> Expr -> Expr
    -- | End of a command spine.
    ExCmdEnd :: Expr
    -- | One operand followed by remaining command operands.
    ExArg :: Expr -> Expr -> Expr
    -- | End of an operand spine.
    ExArgEnd :: Expr

  -- | A parsed template body represented as a spine of nodes.
  data Node where
    -- | Literal text node.
    NdText :: Bytes -> Node -> Node
    -- | Action pipeline node (interpolated unless it declares or assigns variables).
    NdAction :: Expr -> Node -> Node
    -- | Conditional branch: pipeline, then-branch, else-branch, and next sibling.
    NdIf :: Expr -> Node -> Node -> Node -> Node
    -- | Iteration branch: pipeline, loop body, else-branch, and next sibling.
    NdRange :: Expr -> Node -> Node -> Node -> Node
    -- | Scoped-cursor branch: pipeline, body, else-branch, and next sibling.
    NdWith :: Expr -> Node -> Node -> Node -> Node
    -- | Named template invocation: target name, argument pipeline, and next sibling.
    NdTemplate :: String -> Expr -> Node -> Node
    -- | Loop break statement.
    NdBreak :: Node -> Node
    -- | Loop continue statement.
    NdContinue :: Node -> Node
    -- | End of a node spine.
    NdEnd :: Node

  -- | Build a node spine from reversed nodes.
  node-spine :: List Node -> Node -> Node
  node-spine reversed tail = case reversed of Nil -> tail; Cons n rest -> node-spine rest (relink n tail)

  -- | Replace the trailing sibling pointer of one node.
  relink :: Node -> Node -> Node
  relink n tail = case n of
    NdText b x -> NdText b tail
    NdAction p x -> NdAction p tail
    NdIf p a b x -> NdIf p a b tail
    NdRange p a b x -> NdRange p a b tail
    NdWith p a b x -> NdWith p a b tail
    NdTemplate name p x -> NdTemplate name p tail
    NdBreak x -> NdBreak tail
    NdContinue x -> NdContinue tail
    NdEnd -> tail

  -- | Build an operand spine from reversed operands.
  arg-spine :: List Expr -> Expr
  arg-spine reversed = arg-link reversed ExArgEnd

  -- | Link reversed operands onto `tail`.
  arg-link :: List Expr -> Expr -> Expr
  arg-link reversed tail = case reversed of Nil -> tail; Cons e rest -> arg-link rest (ExArg e tail)

  -- | Link reversed commands onto `tail`.
  cmd-link :: List Expr -> Expr -> Expr
  cmd-link reversed tail = case reversed of Nil -> tail; Cons e rest -> cmd-link rest (ExCmd e tail)

  -- | Parser state: remaining tokens, variables in scope, collected definitions, and range depth.
  data Ps where
    -- | Fields in the order listed above.
    Ps :: List Lexeme -> List String -> List (String, Node) -> Nat -> Ps

  -- | How a parsed block ended.
  data Ending where
    -- | Reached end of input.
    EndEof :: Ending
    -- | Reached `{{end}}`.
    EndEnd :: Ending
    -- | Reached `{{else}}`.
    EndElse :: Ending
    -- | Reached `{{else if ...}}`.
    EndElseIf :: Ending
    -- | Reached `{{else with ...}}`.
    EndElseWith :: Ending

  -- | Parse a complete template token stream into its main body and associated definitions.
  parse-top :: String -> List String -> List Lexeme -> Result String (Node, List (String, Node))
  parse-top name funcs tokens = case parse-list funcs True (Ps tokens (Cons "$" Nil) Nil 0) Nil of
    Err e -> Err e
    Ok (body, ending, ps) -> case ending of
      EndEof -> (case ps of Ps ts vars defs depth -> Ok (body, reverse defs))
      other -> Err (string-concat (nat-to-string (line-at ps)) ": unexpected {{end}} or {{else}}")

  -- | Source line number of the next token.
  line-at :: Ps -> Nat
  line-at ps = case ps of Ps ts vars defs depth -> case ts of Cons l rest -> (case l of Lexeme t line -> line); Nil -> 0

  -- | Produce a line-numbered parse error.
  fail-parse :: forall a. Ps -> String -> Result String a
  fail-parse ps message = Err (string-concat-all [nat-to-string (line-at ps), ": ", message])

  -- | Skip whitespace tokens inside an action.
  skip-ws :: Ps -> Ps
  skip-ws ps = case ps of
    Ps ts vars defs depth -> case ts of
      Cons l rest -> (case l of Lexeme t line -> case t of TokSpace -> skip-ws (Ps rest vars defs depth); other -> ps)
      Nil -> ps

  -- | Inspect the next token, if any.
  peek-tok :: Ps -> Option Tok
  peek-tok ps = case ps of Ps ts vars defs depth -> case ts of Cons l rest -> (case l of Lexeme t line -> Some t); Nil -> None

  -- | Consume one token from the parser state.
  advance-tok :: Ps -> Ps
  advance-tok ps = case ps of Ps ts vars defs depth -> case ts of Cons l rest -> Ps rest vars defs depth; Nil -> ps

  -- | Expect a closing delimiter after optional whitespace.
  expect-right :: Ps -> String -> Result String Ps
  expect-right ps context = let p = skip-ws ps in case peek-tok p of
    Some TokRight -> Ok (advance-tok p)
    other -> fail-parse p (string-concat "unexpected item in " context)

  -- | Parse nodes until `{{end}}`, `{{else}}`, or EOF.
  parse-list :: List String -> Bool -> Ps -> List Node -> Result String (Node, Ending, Ps)
  parse-list funcs top ps acc = case peek-tok ps of
    None -> Ok (node-spine acc NdEnd, EndEof, ps)
    Some t -> case t of
      TokText b -> parse-list funcs top (advance-tok ps) (Cons (NdText b NdEnd) acc)
      TokLeft -> parse-action funcs top (skip-ws (advance-tok ps)) acc
      other -> fail-parse ps "unexpected item"

  -- | Parse an action after its opening delimiter.
  parse-action :: List String -> Bool -> Ps -> List Node -> Result String (Node, Ending, Ps)
  parse-action funcs top ps acc = case peek-tok ps of
    Some (TokIdent word) ->
      if word == "end" then (case expect-right (advance-tok ps) "end" of Err e -> Err e; Ok p -> Ok (node-spine acc NdEnd, EndEnd, p))
      else if word == "else" then else-clause (skip-ws (advance-tok ps)) acc
      else if word == "if" || word == "range" || word == "with" then (case control funcs word (advance-tok ps) of
        Err e -> Err e
        Ok (n, p) -> parse-list funcs top p (Cons n acc))
      else if word == "template" then (case template-clause funcs (skip-ws (advance-tok ps)) of
        Err e -> Err e
        Ok (n, p) -> parse-list funcs top p (Cons n acc))
      else if word == "block" then (case block-clause funcs (skip-ws (advance-tok ps)) of
        Err e -> Err e
        Ok (n, p) -> parse-list funcs top p (Cons n acc))
      else if word == "define" then (if top then (case definition funcs (skip-ws (advance-tok ps)) of Err e -> Err e; Ok p -> parse-list funcs top p acc) else fail-parse ps "unexpected <define> in command")
      else if word == "break" || word == "continue" then loop-control funcs top word ps acc
      else plain-action funcs top ps acc
    other -> plain-action funcs top ps acc

  -- | Parse a plain pipeline action.
  plain-action :: List String -> Bool -> Ps -> List Node -> Result String (Node, Ending, Ps)
  plain-action funcs top ps acc = case pipeline funcs "command" ps False of
    Err e -> Err e
    Ok (p, next) -> parse-list funcs top next (Cons (NdAction p NdEnd) acc)

  -- | Parse `{{break}}` or `{{continue}}` inside a `range` loop.
  loop-control :: List String -> Bool -> String -> Ps -> List Node -> Result String (Node, Ending, Ps)
  loop-control funcs top word ps acc = case ps of
    Ps ts vars defs depth ->
      if depth == 0 then fail-parse ps (string-concat-all ["{{", word, "}} outside {{range}}"])
      else case expect-right (advance-tok ps) word of
        Err e -> Err e
        Ok p -> parse-list funcs top p (Cons (if word == "break" then NdBreak NdEnd else NdContinue NdEnd) acc)

  -- | Parse an `else`, `else if`, or `else with` clause.
  else-clause :: Ps -> List Node -> Result String (Node, Ending, Ps)
  else-clause ps acc = case peek-tok ps of
    Some TokRight -> Ok (node-spine acc NdEnd, EndElse, advance-tok ps)
    Some (TokIdent word) ->
      if word == "if" then Ok (node-spine acc NdEnd, EndElseIf, advance-tok ps)
      else if word == "with" then Ok (node-spine acc NdEnd, EndElseWith, advance-tok ps)
      else fail-parse ps "unexpected item in else"
    other -> fail-parse ps "unexpected item in else"

  -- | Parse an `if`, `range`, or `with` block with its optional `else` branch.
  control :: List String -> String -> Ps -> Result String (Node, Ps)
  control funcs kind ps = case ps of
    Ps ts saved defs depth -> case pipeline funcs kind ps (kind == "range") of
      Err e -> Err e
      Ok (p, after) -> case parse-list funcs False (with-depth after (if kind == "range" then depth + 1 else depth)) Nil of
        Err e -> Err e
        Ok (body, ending, rest) -> case else-part funcs kind (with-depth rest depth) ending of
          Err e -> Err e
          Ok (alt, done) -> Ok (control-node kind p body alt, with-vars done saved)

  -- | Parse the trailing `else` branch for a control block.
  else-part :: List String -> String -> Ps -> Ending -> Result String (Node, Ps)
  else-part funcs kind ps ending = case ending of
    EndEnd -> Ok (NdEnd, ps)
    EndElse -> (case parse-list funcs False ps Nil of
      Err e -> Err e
      Ok (alt, ending2, rest) -> case ending2 of EndEnd -> Ok (alt, rest); other -> fail-parse rest (string-concat "expected end; found else in " kind))
    EndElseIf -> if kind == "if" then (case control funcs "if" ps of Err e -> Err e; Ok (n, rest) -> Ok (relink n NdEnd, rest)) else fail-parse ps (string-concat "unexpected else if in " kind)
    EndElseWith -> if kind == "with" then (case control funcs "with" ps of Err e -> Err e; Ok (n, rest) -> Ok (relink n NdEnd, rest)) else fail-parse ps (string-concat "unexpected else with in " kind)
    EndEof -> fail-parse ps "unexpected EOF"

  -- | Construct the AST node for `if`, `range`, or `with`.
  control-node :: String -> Expr -> Node -> Node -> Node
  control-node kind p body alt = if kind == "if" then NdIf p body alt NdEnd else if kind == "range" then NdRange p body alt NdEnd else NdWith p body alt NdEnd

  -- | Update the range nesting depth in parser state.
  with-depth :: Ps -> Nat -> Ps
  with-depth ps depth = case ps of Ps ts vars defs d -> Ps ts vars defs depth

  -- | Restore variable scope in parser state.
  with-vars :: Ps -> List String -> Ps
  with-vars ps vars = case ps of Ps ts v defs depth -> Ps ts vars defs depth

  -- | Parse a `{{template "name" pipeline?}}` invocation.
  template-clause :: List String -> Ps -> Result String (Node, Ps)
  template-clause funcs ps = case peek-tok ps of
    Some (TokString name) ->
      let p = skip-ws (advance-tok ps) in
      (case peek-tok p of
        Some TokRight -> Ok (NdTemplate name ExCmdEnd NdEnd, advance-tok p)
        other -> case pipeline funcs "template clause" p False of Err e -> Err e; Ok (pipe, rest) -> Ok (NdTemplate name pipe NdEnd, rest))
    other -> fail-parse ps "unexpected item in template clause"

  -- | Parse a `{{block "name" pipeline}}...{{end}}` definition and call.
  block-clause :: List String -> Ps -> Result String (Node, Ps)
  block-clause funcs ps = case peek-tok ps of
    Some (TokString name) -> (case pipeline funcs "block clause" (skip-ws (advance-tok ps)) False of
      Err e -> Err e
      Ok (pipe, after) -> case parse-list funcs False (with-vars (with-depth after 0) (Cons "$" Nil)) Nil of
        Err e -> Err e
        Ok (body, ending, rest) -> case ending of
          EndEnd -> Ok (NdTemplate name pipe NdEnd, with-depth (with-vars (add-def rest name body) (vars-of after)) (depth-of after))
          other -> fail-parse rest "unexpected item in block clause")
    other -> fail-parse ps "unexpected item in block clause"

  -- | Parse a top-level `{{define "name"}}...{{end}}` template definition.
  definition :: List String -> Ps -> Result String Ps
  definition funcs ps = case peek-tok ps of
    Some (TokString name) -> (case expect-right (advance-tok ps) "define clause" of
      Err e -> Err e
      Ok after -> case parse-list funcs False (with-vars after (Cons "$" Nil)) Nil of
        Err e -> Err e
        Ok (body, ending, rest) -> case ending of
          EndEnd -> Ok (with-vars (add-def rest name body) (vars-of after))
          other -> fail-parse rest "unexpected item in define clause")
    other -> fail-parse ps "unexpected item in define clause"

  -- | Read the in-scope variable names from parser state.
  vars-of :: Ps -> List String
  vars-of ps = case ps of Ps ts vars defs depth -> vars

  -- | Read the range nesting depth from parser state.
  depth-of :: Ps -> Nat
  depth-of ps = case ps of Ps ts vars defs depth -> depth

  -- | Record a named template definition in parser state.
  add-def :: Ps -> String -> Node -> Ps
  add-def ps name body = case ps of Ps ts vars defs depth -> Ps ts vars (Cons (name, body) defs) depth

  -- | Parse a pipeline up to the closing delimiter.
  pipeline :: List String -> String -> Ps -> Bool -> Result String (Expr, Ps)
  pipeline funcs context ps ranging = case declarations (skip-ws ps) context ranging Nil False of
    Err e -> Err e
    Ok (decls, assign, after) -> commands funcs context after TokRight decls assign Nil

  -- | Parse leading variable declarations or assignments.
  declarations :: Ps -> String -> Bool -> List String -> Bool -> Result String (List String, Bool, Ps)
  declarations ps context ranging decls assign = case peek-tok ps of
    Some (TokVar v) ->
      let after = skip-ws (advance-tok ps) in
      (case peek-tok after of
        Some TokDeclare -> Ok (reverse (Cons v decls), False, declare-var (advance-tok after) v)
        Some TokAssign -> Ok (reverse (Cons v decls), True, declare-var (advance-tok after) v)
        Some TokComma ->
          if ranging && list-length decls == 0 then declarations (declare-var (skip-ws (advance-tok after)) v) context ranging (Cons v decls) assign
          else fail-parse after (string-concat "too many declarations in " context)
        other -> if list-length decls > 0 then fail-parse after "range can only initialize variables" else Ok (Nil, False, ps))
    other -> if list-length decls > 0 then fail-parse ps "range can only initialize variables" else Ok (Nil, False, ps)

  -- | Add a variable name to parser scope.
  declare-var :: Ps -> String -> Ps
  declare-var ps v = case ps of Ps ts vars defs depth -> Ps ts (Cons v vars) defs depth

  -- | Parse pipeline commands separated by `|` until `closer`.
  commands :: List String -> String -> Ps -> Tok -> List String -> Bool -> List Expr -> Result String (Expr, Ps)
  commands funcs context ps closer decls assign acc =
    let p = skip-ws ps in
    case peek-tok p of
      None -> fail-parse p "unclosed action"
      Some t ->
        if same-tok t closer then
          (if list-length acc == 0 then fail-parse p (string-concat "missing value for " context)
          else if has-constant-stage (reverse acc) 0 then fail-parse p "non executable command in pipeline stage"
          else Ok (ExPipe decls assign (cmd-link acc ExCmdEnd), advance-tok p))
        else if starts-operand t then (case command funcs p Nil of
          Err e -> Err e
          Ok (cmd, next) -> commands funcs context next closer decls assign (Cons cmd acc))
        else fail-parse p (string-concat "unexpected item in " context)

  -- | Report whether any pipeline stage after the first starts with a non-executable constant.
  has-constant-stage :: List Expr -> Nat -> Bool
  has-constant-stage cmds i = case cmds of
    Nil -> False
    Cons c rest -> (i > 0 && constant-head c) || has-constant-stage rest (i + 1)

  -- | Report whether a command starts with a constant, cursor, or nil.
  constant-head :: Expr -> Bool
  constant-head c = case c of ExArg first rest -> (case first of ExConst v -> True; ExDot -> True; ExNil -> True; other -> False); other -> False

  -- | Compare closer token kinds (`}}` vs `)`).
  same-tok :: Tok -> Tok -> Bool
  same-tok a b = case a of TokRight -> (case b of TokRight -> True; other -> False); TokClose -> (case b of TokClose -> True; other -> False); other -> False

  -- | Report whether a token can begin an operand.
  starts-operand :: Tok -> Bool
  starts-operand t = case t of
    TokIdent w -> not (is-keyword w)
    TokDot -> True
    TokField f -> True
    TokVar v -> True
    TokNumber n -> True
    TokChar c -> True
    TokString s -> True
    TokOpen -> True
    other -> False

  -- | Report whether an identifier is a reserved template keyword.
  is-keyword :: String -> Bool
  is-keyword w = w == "if" || w == "else" || w == "end" || w == "range" || w == "with" || w == "define" || w == "template" || w == "block" || w == "break" || w == "continue"

  -- | Parse one command's operands up to `|` or a closer.
  command :: List String -> Ps -> List Expr -> Result String (Expr, Ps)
  command funcs ps acc = case operand funcs (skip-ws ps) of
    Err e -> Err e
    Ok (found, after) ->
      let args = case found of Some e -> Cons e acc; None -> acc in
      case peek-tok after of
        Some TokSpace -> command funcs after args
        Some TokPipe -> finish-command after args (advance-tok after)
        Some TokRight -> finish-command after args after
        Some TokClose -> finish-command after args after
        other -> fail-parse after "unexpected item in operand"

  -- | Finalize a non-empty command operand spine.
  finish-command :: Ps -> List Expr -> Ps -> Result String (Expr, Ps)
  finish-command at-ps args next = if list-length args == 0 then fail-parse at-ps "empty command" else Ok (arg-spine args, next)

  -- | Parse a term followed by any chained `.field` lookups.
  operand :: List String -> Ps -> Result String (Option Expr, Ps)
  operand funcs ps = case term funcs ps of
    Err e -> Err e
    Ok (found, after) -> case found of
      None -> Ok (None, after)
      Some t -> case chain after Nil of
        (fields, rest) ->
          if list-length fields == 0 then Ok (Some t, rest)
          else case t of
            ExField fs -> Ok (Some (ExField (append-strings fs fields)), rest)
            ExVar v fs -> Ok (Some (ExVar v (append-strings fs fields)), rest)
            ExConst c -> fail-parse after "unexpected . after term"
            ExNil -> fail-parse after "unexpected . after term"
            ExDot -> fail-parse after "unexpected . after term"
            other -> Ok (Some (ExChain t fields), rest)

  -- | Parse zero or more adjacent `.field` tokens.
  chain :: Ps -> List String -> (List String, Ps)
  chain ps acc = case peek-tok ps of
    Some (TokField f) -> chain (advance-tok ps) (Cons f acc)
    other -> (reverse acc, ps)

  -- | Concatenate two lists of strings.
  append-strings :: List String -> List String -> List String
  append-strings xs ys = case xs of Nil -> ys; Cons x rest -> Cons x (append-strings rest ys)

  -- | Parse a primary operand term.
  term :: List String -> Ps -> Result String (Option Expr, Ps)
  term funcs ps = case peek-tok ps of
    Some t -> (case t of
      TokIdent w ->
        if w == "true" then Ok (Some (ExConst (HvTemplate (TvBool True))), advance-tok ps)
        else if w == "false" then Ok (Some (ExConst (HvTemplate (TvBool False))), advance-tok ps)
        else if w == "nil" then Ok (Some ExNil, advance-tok ps)
        else if is-keyword w then Ok (None, ps)
        else if has-string funcs w then Ok (Some (ExFunc w), advance-tok ps)
        else fail-parse ps (string-concat-all ["function \"", w, "\" not defined"])
      TokDot -> Ok (Some ExDot, advance-tok ps)
      TokField f -> Ok (Some (ExField (Cons f Nil)), advance-tok ps)
      TokVar v -> if in-scope ps v then Ok (Some (ExVar v Nil), advance-tok ps) else fail-parse ps (string-concat-all ["undefined variable \"", v, "\""])
      TokNumber n -> (case number-value n of Some value -> Ok (Some (ExConst (HvTemplate value)), advance-tok ps); None -> fail-parse ps (string-concat-all ["illegal number syntax: \"", n, "\""]))
      TokChar c -> Ok (Some (ExConst (HvTemplate (TvInt (nat-to-int c)))), advance-tok ps)
      TokString s -> Ok (Some (ExConst (HvTemplate (TvString s))), advance-tok ps)
      TokOpen -> (case declarations (skip-ws (advance-tok ps)) "parenthesized pipeline" False Nil False of
        Err e -> Err e
        Ok (decls, assign, after) -> case commands funcs "parenthesized pipeline" after TokClose decls assign Nil of
          Err e -> Err e
          Ok (p, rest) -> Ok (Some p, rest))
      other -> Ok (None, ps))
    None -> Ok (None, ps)

  -- | Report whether a variable name is currently in scope.
  in-scope :: Ps -> String -> Bool
  in-scope ps v = case ps of Ps ts vars defs depth -> has-string vars v

  -- | Report whether a string appears in a list.
  has-string :: List String -> String -> Bool
  has-string xs s = case xs of Nil -> False; Cons x rest -> x == s || has-string rest s

  -- | Parse an integer or floating-point literal spelling into a `TemplateValue`.
  number-value :: String -> Option TemplateValue
  number-value text =
    let raw = strip-underscores (string-to-bytes text) in
    let negative = at raw 0 == 45 in
    let body = if at raw 0 == 45 || at raw 0 == 43 then slice raw 1 (bytes-len raw) else raw in
    if bytes-len body == 0 then None
    else if at body 0 == 48 && bytes-len body > 2 && (lower (at body 1) == 120 || lower (at body 1) == 111 || lower (at body 1) == 98) then
      based (slice body 2 (bytes-len body)) (if lower (at body 1) == 120 then (16 :: Nat) else if lower (at body 1) == 111 then (8 :: Nat) else 2) negative
    else if has-float-mark body 0 then (if decimal-float body then Some (TvFloat (f64-from-decimal raw)) else None)
    else if at body 0 == 48 && bytes-len body > 1 then based (slice body 1 (bytes-len body)) 8 negative
    else based body 10 negative

  -- | Convert base-`base` digits into a signed integer value.
  based :: Bytes -> Nat -> Bool -> Option TemplateValue
  based digits base negative =
    if bytes-len digits == 0 || not (all-digits digits 0 base) then None
    else let n = nat-to-int (digits-in digits 0 base 0) in Some (TvInt (if negative then int-neg n else n))

  -- | Report whether every byte in `b` is a valid digit in `base`.
  all-digits :: Bytes -> Nat -> Nat -> Bool
  all-digits b i base = if i >= bytes-len b then True else if is-hex (at b i) && hex-digit (at b i) < base then all-digits b (i + 1) base else False

  -- | Accumulate digits in `base`.
  digits-in :: Bytes -> Nat -> Nat -> Nat -> Nat
  digits-in b i base acc = if i >= bytes-len b then acc else digits-in b (i + 1) base (acc * base + hex-digit (at b i))

  -- | Report whether a numeric literal contains a decimal point or exponent marker.
  has-float-mark :: Bytes -> Nat -> Bool
  has-float-mark b i = if i >= bytes-len b then False else if at b i == 46 || lower (at b i) == 101 then True else has-float-mark b (i + 1)

  -- | Validate decimal floating-point literal syntax.
  decimal-float :: Bytes -> Bool
  decimal-float b =
    let i = digit-run b 0 in
    let j = if at b i == 46 then digit-run b (i + 1) else i in
    let mantissa = j > (if at b i == 46 then (1 :: Nat) else 0) in
    if j >= bytes-len b then mantissa
    else if lower (at b j) == 101 then
      (let k = if at b (j + 1) == 43 || at b (j + 1) == 45 then j + 2 else j + 1 in let e = digit-run b k in mantissa && e > k && e == bytes-len b)
    else False

  -- | Advance past ASCII decimal digits.
  digit-run :: Bytes -> Nat -> Nat
  digit-run b i = if i < bytes-len b && is-digit (at b i) then digit-run b (i + 1) else i

  -- | Remove digit-separator underscores from a numeric literal.
  strip-underscores :: Bytes -> Bytes
  strip-underscores b = from-list (keep-not b 95 0 Nil)

  -- | Keep all bytes not equal to `v`.
  keep-not :: Bytes -> Nat -> Nat -> List Nat -> List Nat
  keep-not b v i acc = if i >= bytes-len b then reverse acc else keep-not b v (i + 1) (if at b i == v then acc else Cons (at b i) acc)

  -- ---------------------------------------------------------------------
  -- Contextual auto-escaping state machine.
  -- ---------------------------------------------------------------------

  -- | High-level HTML/JS/CSS/URL parser state tracked across static text and actions.
  data EscState where
    -- | Parsed character data outside tags, comments, and special elements.
    StText :: EscState
    -- | Inside an HTML tag before an attribute name or `>`.
    StTag :: EscState
    -- | Inside an HTML attribute name.
    StAttrName :: EscState
    -- | After an attribute name and before `=` or the next attribute.
    StAfterName :: EscState
    -- | After `=` and before the attribute value delimiter or text.
    StBeforeValue :: EscState
    -- | Inside an HTML `<!-- ... -->` comment.
    StHtmlCmt :: EscState
    -- | Inside an RCDATA element (`<textarea>` or `<title>`).
    StRcdata :: EscState
    -- | Inside a plain HTML attribute value.
    StAttr :: EscState
    -- | Inside a URL-typed HTML attribute value.
    StUrl :: EscState
    -- | Inside a `srcset` HTML attribute value.
    StSrcset :: EscState
    -- | Inside JavaScript code (`<script>` or event handler attribute).
    StJs :: EscState
    -- | Inside a double-quoted JavaScript string literal.
    StJsDqStr :: EscState
    -- | Inside a single-quoted JavaScript string literal.
    StJsSqStr :: EscState
    -- | Inside a backtick JavaScript template literal.
    StJsTmplLit :: EscState
    -- | Inside a JavaScript regular expression literal.
    StJsRegexp :: EscState
    -- | Inside a JavaScript `/* ... */` block comment.
    StJsBlockCmt :: EscState
    -- | Inside a JavaScript `// ...` or `#! ...` line comment.
    StJsLineCmt :: EscState
    -- | Inside a JavaScript `<!--` HTML-like comment.
    StJsHtmlOpenCmt :: EscState
    -- | Inside a JavaScript `-->` HTML-like comment.
    StJsHtmlCloseCmt :: EscState
    -- | Inside CSS code (`<style>` or `style` attribute).
    StCss :: EscState
    -- | Inside a double-quoted CSS string literal.
    StCssDqStr :: EscState
    -- | Inside a single-quoted CSS string literal.
    StCssSqStr :: EscState
    -- | Inside a double-quoted CSS `url("...")`.
    StCssDqUrl :: EscState
    -- | Inside a single-quoted CSS `url('...')`.
    StCssSqUrl :: EscState
    -- | Inside an unquoted CSS `url(...)`.
    StCssUrl :: EscState
    -- | Inside a CSS `/* ... */` block comment.
    StCssBlockCmt :: EscState
    -- | Inside a CSS `// ...` line comment.
    StCssLineCmt :: EscState
    -- | Sticky error state for rejected template structures.
    StError :: EscState
    -- | Unreachable state following `{{break}}` or `{{continue}}`.
    StDead :: EscState

  -- | Delimiter closing the current HTML attribute, if any.
  data EscDelim where
    -- | Outside any HTML attribute value.
    DlNone :: EscDelim
    -- | Attribute closed by `"`.
    DlDoubleQuote :: EscDelim
    -- | Attribute closed by `'`.
    DlSingleQuote :: EscDelim
    -- | Unquoted attribute closed by ASCII HTML whitespace or `>`.
    DlSpaceOrTagEnd :: EscDelim

  -- | Position inside a hierarchical URL for scheme filtering vs query escaping.
  data UrlPart where
    -- | Not in a URL, or at the very start before any scheme/path byte.
    UpNone :: UrlPart
    -- | Inside the scheme, authority, or path before `?` or `#`.
    UpPreQuery :: UrlPart
    -- | Inside the query or fragment portion after `?` or `#`.
    UpQueryOrFrag :: UrlPart
    -- | Ambiguous position resulting from joining branches before and after `?`/`#`.
    UpUnknown :: UrlPart

  -- | Whether a `/` in JavaScript begins a regular expression or a division operator.
  data JsCtx where
    -- | `/` starts a regular expression literal.
    JsRegexp :: JsCtx
    -- | `/` starts a division operator.
    JsDivOp :: JsCtx
    -- | Ambiguous `/` context resulting from joining divergent branches.
    JsUnknown :: JsCtx

  -- | Special HTML element tracked across its start tag and raw/RCDATA body.
  data EscElement where
    -- | Ordinary HTML element.
    ElNone :: EscElement
    -- | `<script>` with JavaScript or JSON MIME type (or no `type` attribute).
    ElScript :: EscElement
    -- | `<style>` element.
    ElStyle :: EscElement
    -- | `<textarea>` RCDATA element.
    ElTextarea :: EscElement
    -- | `<title>` RCDATA element.
    ElTitle :: EscElement

  -- | Special HTML attribute kind tracked from attribute name through value.
  data EscAttr where
    -- | Ordinary text attribute or no active attribute.
    AtNone :: EscAttr
    -- | Event handler (`on*`) JavaScript attribute.
    AtScript :: EscAttr
    -- | The `type` attribute on a `<script>` start tag.
    AtScriptType :: EscAttr
    -- | The inline `style` CSS attribute.
    AtStyle :: EscAttr
    -- | A URL-valued attribute (`href`, `src`, `action`, etc.).
    AtUrl :: EscAttr
    -- | A `srcset` attribute.
    AtSrcset :: EscAttr

  -- | Classified content kind for values and HTML attributes.
  data ContentType where
    -- | Untrusted plain text.
    CtPlain :: ContentType
    -- | Trusted CSS content.
    CtCss :: ContentType
    -- | Trusted HTML fragment.
    CtHtml :: ContentType
    -- | Trusted HTML attribute.
    CtHtmlAttr :: ContentType
    -- | Trusted JavaScript expression.
    CtJs :: ContentType
    -- | Trusted JavaScript string characters.
    CtJsStr :: ContentType
    -- | Trusted URL or URL substring.
    CtUrl :: ContentType
    -- | Trusted `srcset` value.
    CtSrcset :: ContentType
    -- | Unsafe attribute whose name cannot be interpolated dynamically.
    CtUnsafe :: ContentType

  -- | Complete contextual escaping state at a point in a template.
  data EscCtx where
    -- | State, attribute delimiter, URL part, JS slash context, JS template literal brace stack, attribute kind, element kind, and optional error message.
    EscCtx :: EscState -> EscDelim -> UrlPart -> JsCtx -> List Int -> EscAttr -> EscElement -> Option String -> EscCtx

  -- | Initial root escaping context (HTML text state).
  init-ctx :: Unit -> EscCtx
  init-ctx unit = EscCtx StText DlNone UpNone JsRegexp Nil AtNone ElNone None

  -- | Construct an error context with a diagnostic message.
  err-ctx :: String -> EscCtx
  err-ctx msg = EscCtx StError DlNone UpNone JsRegexp Nil AtNone ElNone (Some msg)

  -- | Construct a dead (unreachable) context after `break` or `continue`.
  dead-ctx :: Unit -> EscCtx
  dead-ctx unit = EscCtx StDead DlNone UpNone JsRegexp Nil AtNone ElNone None

  -- | Numeric tag for an `EscState` used in equality checks and mangling.
  state-id :: EscState -> Nat
  state-id st = case st of
    StText -> 0
    StTag -> 1
    StAttrName -> 2
    StAfterName -> 3
    StBeforeValue -> 4
    StHtmlCmt -> 5
    StRcdata -> 6
    StAttr -> 7
    StUrl -> 8
    StSrcset -> 9
    StJs -> 10
    StJsDqStr -> 11
    StJsSqStr -> 12
    StJsTmplLit -> 13
    StJsRegexp -> 14
    StJsBlockCmt -> 15
    StJsLineCmt -> 16
    StJsHtmlOpenCmt -> 17
    StJsHtmlCloseCmt -> 18
    StCss -> 19
    StCssDqStr -> 20
    StCssSqStr -> 21
    StCssDqUrl -> 22
    StCssSqUrl -> 23
    StCssUrl -> 24
    StCssBlockCmt -> 25
    StCssLineCmt -> 26
    StError -> 27
    StDead -> 28

  -- | Numeric tag for an `EscDelim`.
  delim-id :: EscDelim -> Nat
  delim-id d = case d of DlNone -> 0; DlDoubleQuote -> 1; DlSingleQuote -> 2; DlSpaceOrTagEnd -> 3

  -- | Numeric tag for a `UrlPart`.
  urlpart-id :: UrlPart -> Nat
  urlpart-id u = case u of UpNone -> 0; UpPreQuery -> 1; UpQueryOrFrag -> 2; UpUnknown -> 3

  -- | Numeric tag for a `JsCtx`.
  jsctx-id :: JsCtx -> Nat
  jsctx-id j = case j of JsRegexp -> 0; JsDivOp -> 1; JsUnknown -> 2

  -- | Numeric tag for an `EscAttr`.
  attr-id :: EscAttr -> Nat
  attr-id a = case a of AtNone -> 0; AtScript -> 1; AtScriptType -> 2; AtStyle -> 3; AtUrl -> 4; AtSrcset -> 5

  -- | Numeric tag for an `EscElement`.
  elem-id :: EscElement -> Nat
  elem-id e = case e of ElNone -> 0; ElScript -> 1; ElStyle -> 2; ElTextarea -> 3; ElTitle -> 4

  -- | Compare two escaping contexts for structural equality.
  ctx-eq :: EscCtx -> EscCtx -> Bool
  ctx-eq a b = case a of
    EscCtx s1 d1 u1 j1 br1 a1 e1 err1 -> case b of
      EscCtx s2 d2 u2 j2 br2 a2 e2 err2 ->
        state-id s1 == state-id s2
          && delim-id d1 == delim-id d2
          && urlpart-id u1 == urlpart-id u2
          && jsctx-id j1 == jsctx-id j2
          && attr-id a1 == attr-id a2
          && elem-id e1 == elem-id e2
          && opt-str-eq err1 err2

  -- | Compare two optional error strings.
  opt-str-eq :: Option String -> Option String -> Bool
  opt-str-eq a b = case a of
    None -> (case b of None -> True; Some y -> False)
    Some x -> (case b of None -> False; Some y -> x == y)

  -- | Mangle a template name with its entry escaping context to distinguish specialized clones.
  mangle-name :: EscCtx -> String -> String
  mangle-name c name = case c of
    EscCtx st dl up jc br ak el err ->
      if state-id st == 0 then name
      else string-concat-all [
        name, "$htmltemplate_", nat-to-string (state-id st),
        if delim-id dl == 0 then "" else string-concat "_d" (nat-to-string (delim-id dl)),
        if urlpart-id up == 0 then "" else string-concat "_u" (nat-to-string (urlpart-id up)),
        if jsctx-id jc == 0 then "" else string-concat "_j" (nat-to-string (jsctx-id jc)),
        if attr-id ak == 0 then "" else string-concat "_a" (nat-to-string (attr-id ak)),
        if elem-id el == 0 then "" else string-concat "_e" (nat-to-string (elem-id el))
      ]

  -- | Report whether a state is any HTML, JavaScript, or CSS comment state.
  is-comment-state :: EscState -> Bool
  is-comment-state st = case st of
    StHtmlCmt -> True
    StJsBlockCmt -> True
    StJsLineCmt -> True
    StJsHtmlOpenCmt -> True
    StJsHtmlCloseCmt -> True
    StCssBlockCmt -> True
    StCssLineCmt -> True
    other -> False

  -- | Report whether a state occurs solely inside an HTML start/end tag.
  is-in-tag :: EscState -> Bool
  is-in-tag st = case st of
    StTag -> True
    StAttrName -> True
    StAfterName -> True
    StBeforeValue -> True
    StAttr -> True
    other -> False

  -- | Report whether a state is a JavaScript string or regexp literal where `<script`/`</script`/`<!--` must be escaped.
  is-in-script-literal :: EscState -> Bool
  is-in-script-literal st = case st of
    StJsDqStr -> True
    StJsSqStr -> True
    StJsTmplLit -> True
    StJsRegexp -> True
    other -> False

  -- | Map an `EscElement` to the content state entered after its start tag `>`.
  element-content-state :: EscElement -> EscState
  element-content-state e = case e of
    ElNone -> StText
    ElScript -> StJs
    ElStyle -> StCss
    ElTextarea -> StRcdata
    ElTitle -> StRcdata

  -- | Map an `EscAttr` to the value state entered after `=`.
  attr-start-state :: EscAttr -> EscState
  attr-start-state a = case a of
    AtNone -> StAttr
    AtScript -> StJs
    AtScriptType -> StAttr
    AtStyle -> StCss
    AtUrl -> StUrl
    AtSrcset -> StSrcset

  -- | Follow empty-string transitions before an action inside a tag.
  nudge :: EscCtx -> EscCtx
  nudge c = case c of
    EscCtx st dl up jc br ak el err -> case st of
      StTag -> EscCtx StAttrName dl up jc br ak el err
      StBeforeValue -> EscCtx (attr-start-state ak) DlSpaceOrTagEnd up jc br AtNone el err
      StAfterName -> EscCtx StAttrName dl up jc br AtNone el err
      other -> c

  -- | Join two branch contexts, producing an error context when they cannot safely merge.
  join-ctx :: EscCtx -> EscCtx -> String -> EscCtx
  join-ctx a b node-name = case a of
    EscCtx sa da ua ja bra ata ela erra -> case b of
      EscCtx sb db ub jb brb atb elb errb ->
        if state-id sa == 27 then a
        else if state-id sb == 27 then b
        else if state-id sa == 28 then b
        else if state-id sb == 28 then a
        else if ctx-eq a b then a
        else if ctx-eq (EscCtx sa da ub ja bra ata ela erra) b then EscCtx sa da UpUnknown ja bra ata ela erra
        else if ctx-eq (EscCtx sa da ua jb bra ata ela erra) b then EscCtx sa da ua JsUnknown bra ata ela erra
        else
          let na = nudge a in
          let nb = nudge b in
          if not (ctx-eq na a && ctx-eq nb b) then
            let joined = join-ctx na nb node-name in
            if not (state-id (ctx-state joined) == 27) then joined
            else err-ctx (string-concat-all ["{{", node-name, "}} branches end in different contexts"])
          else err-ctx (string-concat-all ["{{", node-name, "}} branches end in different contexts"])

  -- | Read the `EscState` field of an `EscCtx`.
  ctx-state :: EscCtx -> EscState
  ctx-state c = case c of EscCtx st dl up jc br ak el err -> st

  -- | Read the error message of an `EscCtx`, if any.
  ctx-err :: EscCtx -> Option String
  ctx-err c = case c of EscCtx st dl up jc br ak el err -> err

  -- | Classify a lower-case HTML attribute name into its conservative `ContentType`.
  attr-type :: String -> ContentType
  attr-type raw =
    let name = strip-attr-prefix raw in
    if name == "xmlns" || has-prefix-bytes (string-to-bytes raw) (string-to-bytes "xmlns:") then CtUrl
    else case lookup-attr-map name of
      Some ct -> ct
      None ->
        if has-prefix-bytes (string-to-bytes name) (string-to-bytes "on") then CtJs
        else if contains-bytes (string-to-bytes name) (string-to-bytes "src")
          || contains-bytes (string-to-bytes name) (string-to-bytes "uri")
          || contains-bytes (string-to-bytes name) (string-to-bytes "url") then CtUrl
        else CtPlain

  -- | Strip leading `data-` or namespace prefix (`prefix:`) from a lower-case attribute name.
  strip-attr-prefix :: String -> String
  strip-attr-prefix name =
    let b = string-to-bytes name in
    if has-prefix-bytes b (string-to-bytes "data-") then text-of (slice b 5 (bytes-len b))
    else case find-byte b 58 0 of
      Some k -> if slice b 0 k == string-to-bytes "xmlns" then "xmlns" else text-of (slice b (k + 1) (bytes-len b))
      None -> name

  -- | Static table of standard HTML attribute content types.
  lookup-attr-map :: String -> Option ContentType
  lookup-attr-map name =
    if name == "action" || name == "archive" || name == "background" || name == "cite"
      || name == "classid" || name == "codebase" || name == "data" || name == "formaction"
      || name == "href" || name == "icon" || name == "longdesc" || name == "manifest"
      || name == "poster" || name == "profile" || name == "src" || name == "usemap"
      || name == "xmlns" then Some CtUrl
    else if name == "srcset" then Some CtSrcset
    else if name == "style" then Some CtCss
    else if name == "srcdoc" then Some CtHtml
    else if name == "accept-charset" || name == "async" || name == "challenge" || name == "charset"
      || name == "content" || name == "crossorigin" || name == "defer" || name == "enctype"
      || name == "form" || name == "formenctype" || name == "formmethod" || name == "formnovalidate"
      || name == "http-equiv" || name == "keytype" || name == "language" || name == "method"
      || name == "novalidate" || name == "pattern" || name == "rel" || name == "sandbox"
      || name == "type" || name == "value" then Some CtUnsafe
    else if name == "accept" || name == "alt" || name == "autocomplete" || name == "autofocus"
      || name == "autoplay" || name == "border" || name == "checked" || name == "class"
      || name == "cols" || name == "colspan" || name == "contenteditable" || name == "contextmenu"
      || name == "controls" || name == "coords" || name == "datetime" || name == "default"
      || name == "dir" || name == "dirname" || name == "disabled" || name == "draggable"
      || name == "dropzone" || name == "for" || name == "formtarget" || name == "headers"
      || name == "height" || name == "hidden" || name == "high" || name == "hreflang"
      || name == "id" || name == "ismap" || name == "kind" || name == "label"
      || name == "lang" || name == "list" || name == "loop" || name == "low"
      || name == "max" || name == "maxlength" || name == "media" || name == "mediagroup"
      || name == "min" || name == "multiple" || name == "name" || name == "open"
      || name == "optimum" || name == "placeholder" || name == "preload" || name == "pubdate"
      || name == "radiogroup" || name == "readonly" || name == "required" || name == "reversed"
      || name == "rows" || name == "rowspan" || name == "spellcheck" || name == "scope"
      || name == "scoped" || name == "seamless" || name == "selected" || name == "shape"
      || name == "size" || name == "sizes" || name == "span" || name == "srclang"
      || name == "start" || name == "step" || name == "tabindex" || name == "target"
      || name == "title" || name == "width" || name == "wrap" then Some CtPlain
    else None

  -- | Report whether a `<script type="...">` MIME type should be parsed as JavaScript or JSON.
  is-js-type :: Bytes -> Bool
  is-js-type raw =
    let semi = case find-byte raw 59 0 of Some k -> slice raw 0 k; None -> raw in
    let norm = text-of (lower-bytes (trim-ascii-ws semi)) in
    norm == "application/ecmascript"
      || norm == "application/javascript"
      || norm == "application/json"
      || norm == "application/ld+json"
      || norm == "application/x-ecmascript"
      || norm == "application/x-javascript"
      || norm == "module"
      || norm == "text/ecmascript"
      || norm == "text/javascript"
      || norm == "text/javascript1.0"
      || norm == "text/javascript1.1"
      || norm == "text/javascript1.2"
      || norm == "text/javascript1.3"
      || norm == "text/javascript1.4"
      || norm == "text/javascript1.5"
      || norm == "text/jscript"
      || norm == "text/livescript"
      || norm == "text/x-ecmascript"
      || norm == "text/x-javascript"

  -- | Trim leading and trailing ASCII whitespace (` `, `\t`, `\n`, `\r`, `\f`, `\v`).
  trim-ascii-ws :: Bytes -> Bytes
  trim-ascii-ws b =
    let start = trim-ws-left b 0 in
    let end = trim-ws-right b start (bytes-len b) in
    slice b start end

  -- | Advance past leading ASCII whitespace.
  trim-ws-left :: Bytes -> Nat -> Nat
  trim-ws-left b i = if i < bytes-len b && is-ascii-ws (at b i) then trim-ws-left b (i + 1) else i

  -- | Retreat past trailing ASCII whitespace.
  trim-ws-right :: Bytes -> Nat -> Nat -> Nat
  trim-ws-right b start end = if end > start && is-ascii-ws (at b (end - 1)) then trim-ws-right b start (end - 1) else end

  -- | Report whether a byte is ASCII whitespace (`\t`, `\n`, `\v`, `\f`, `\r`, `' '`).
  is-ascii-ws :: Nat -> Bool
  is-ascii-ws c = c == 32 || c == 9 || c == 10 || c == 11 || c == 12 || c == 13

  -- | Report whether a byte is HTML whitespace (`\t`, `\n`, `\f`, `\r`, `' '`).
  is-html-ws :: Nat -> Bool
  is-html-ws c = c == 32 || c == 9 || c == 10 || c == 12 || c == 13

  -- | Advance past HTML whitespace starting at `i`.
  eat-ws :: Bytes -> Nat -> Nat
  eat-ws s i = if i < bytes-len s && is-html-ws (at s i) then eat-ws s (i + 1) else i

  -- | Dispatch the context transition function for state `st`.
  transition-state :: EscState -> EscCtx -> Bytes -> (EscCtx, Nat)
  transition-state st c s = case st of
    StText -> t-text c s
    StTag -> t-tag c s
    StAttrName -> t-attr-name c s
    StAfterName -> t-after-name c s
    StBeforeValue -> t-before-value c s
    StHtmlCmt -> t-html-cmt c s
    StRcdata -> t-special-tag-end c s
    StAttr -> (c, bytes-len s)
    StUrl -> t-url c s
    StSrcset -> t-url c s
    StJs -> t-js c s
    StJsDqStr -> t-js-delimited c s
    StJsSqStr -> t-js-delimited c s
    StJsRegexp -> t-js-delimited c s
    StJsTmplLit -> t-js-tmpl c s
    StJsBlockCmt -> t-block-cmt c s
    StJsLineCmt -> t-line-cmt c s
    StJsHtmlOpenCmt -> t-line-cmt c s
    StJsHtmlCloseCmt -> t-line-cmt c s
    StCss -> t-css c s
    StCssDqStr -> t-css-str c s
    StCssSqStr -> t-css-str c s
    StCssDqUrl -> t-css-str c s
    StCssSqUrl -> t-css-str c s
    StCssUrl -> t-css-str c s
    StCssBlockCmt -> t-block-cmt c s
    StCssLineCmt -> t-line-cmt c s
    StError -> (c, bytes-len s)
    StDead -> (c, bytes-len s)

  -- | Transition from `StText` across literal HTML text, comments, and tag openings.
  t-text :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-text c s = t-text-loop c s 0

  -- | Loop searching for `<` tag or comment openings in `StText`.
  t-text-loop :: EscCtx -> Bytes -> Nat -> (EscCtx, Nat)
  t-text-loop c s k =
    let i = scalar-find s 60 k in
    if i >= bytes-len s || i + 1 >= bytes-len s then (c, bytes-len s)
    else if i + 4 <= bytes-len s && starts-with s i (string-to-bytes "<!--") then
      (EscCtx StHtmlCmt DlNone UpNone JsRegexp Nil AtNone ElNone None, i + 4)
    else
      let p = i + 1 in
      let is-end = at s p == 47 in
      if is-end && p + 1 >= bytes-len s then (c, bytes-len s)
      else
        let start = if is-end then p + 1 else p in
        case eat-tag-name s start of
          (j, el) ->
            if not (j == start) then
              (EscCtx StTag DlNone UpNone JsRegexp Nil AtNone (if is-end then ElNone else el) None, j)
            else t-text-loop c s j

  -- | Consume an HTML tag name at `i` and classify special elements.
  eat-tag-name :: Bytes -> Nat -> (Nat, EscElement)
  eat-tag-name s i =
    if i >= bytes-len s || not (is-ascii-alpha (at s i)) then (i, ElNone)
    else
      let j = tag-name-end s (i + 1) in
      let name = text-of (lower-bytes (slice s i j)) in
      let el = if name == "script" then ElScript else if name == "style" then ElStyle else if name == "textarea" then ElTextarea else if name == "title" then ElTitle else ElNone in
      (j, el)

  -- | Scan the remainder of an HTML tag name (allowing single `-` or `:` followed by alnum).
  tag-name-end :: Bytes -> Nat -> Nat
  tag-name-end s j =
    if j >= bytes-len s then j
    else
      let x = at s j in
      if is-ascii-alnum x then tag-name-end s (j + 1)
      else if (x == 58 || x == 45) && j + 1 < bytes-len s && is-ascii-alnum (at s (j + 1)) then tag-name-end s (j + 2)
      else j

  -- | Transition from `StTag`: skip whitespace, close tag on `>`, or read an attribute name.
  t-tag :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-tag c s = case c of
    EscCtx st dl up jc br ak el err ->
      let i = eat-ws s 0 in
      if i >= bytes-len s then (c, bytes-len s)
      else if at s i == 62 then (EscCtx (element-content-state el) DlNone UpNone JsRegexp Nil AtNone el None, i + 1)
      else case eat-attr-name s i of
        Err msg -> (err-ctx msg, bytes-len s)
        Ok j ->
          if j == i then (err-ctx "expected space, attr name, or end of tag", bytes-len s)
          else
            let attr-name = text-of (lower-bytes (slice s i j)) in
            let next-attr = (
              if elem-id el == 1 && attr-name == "type" then AtScriptType
              else case attr-type attr-name of
                CtUrl -> AtUrl
                CtCss -> AtStyle
                CtJs -> AtScript
                CtSrcset -> AtSrcset
                other -> AtNone) in
            let next-state = if j >= bytes-len s then StAttrName else StAfterName in
            (EscCtx next-state DlNone UpNone JsRegexp Nil next-attr el None, j)

  -- | Scan an HTML attribute name from `i`, rejecting quotes and `<`.
  eat-attr-name :: Bytes -> Nat -> Result String Nat
  eat-attr-name s j =
    if j >= bytes-len s then Ok j
    else
      let x = at s j in
      if is-html-ws x || x == 61 || x == 62 then Ok j
      else if x == 39 || x == 34 || x == 60 then Err "bad character in attribute name"
      else eat-attr-name s (j + 1)

  -- | Transition from `StAttrName`.
  t-attr-name :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-attr-name c s = case c of
    EscCtx st dl up jc br ak el err -> case eat-attr-name s 0 of
      Err msg -> (err-ctx msg, bytes-len s)
      Ok i -> (if i < bytes-len s then EscCtx StAfterName dl up jc br ak el err else c, i)

  -- | Transition from `StAfterName`: consume `=` or return to `StTag`.
  t-after-name :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-after-name c s = case c of
    EscCtx st dl up jc br ak el err ->
      let i = eat-ws s 0 in
      if i >= bytes-len s then (c, bytes-len s)
      else if not (at s i == 61) then (EscCtx StTag dl up jc br ak el err, i)
      else (EscCtx StBeforeValue dl up jc br ak el err, i + 1)

  -- | Transition from `StBeforeValue`: detect quote delimiter or unquoted attribute value.
  t-before-value :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-before-value c s = case c of
    EscCtx st dl up jc br ak el err ->
      let i = eat-ws s 0 in
      if i >= bytes-len s then (c, bytes-len s)
      else
        let x = at s i in
        if x == 39 then (EscCtx (attr-start-state ak) DlSingleQuote up jc br ak el err, i + 1)
        else if x == 34 then (EscCtx (attr-start-state ak) DlDoubleQuote up jc br ak el err, i + 1)
        else (EscCtx (attr-start-state ak) DlSpaceOrTagEnd up jc br ak el err, i)

  -- | Transition from `StHtmlCmt` up to `-->`.
  t-html-cmt :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-html-cmt c s = case find-bytes s (string-to-bytes "-->") 0 of
    Some i -> (init-ctx (), i + 3)
    None -> (c, bytes-len s)

  -- | Check for a special raw/RCDATA closing tag (`</script`, `</style`, `</textarea`, `</title`).
  t-special-tag-end :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-special-tag-end c s = case c of
    EscCtx st dl up jc br ak el err ->
      if elem-id el == 0 then (c, bytes-len s)
      else if elem-id el == 1 && (is-in-script-literal st || is-comment-state st) then (c, bytes-len s)
      else
        let marker = (case el of
          ElScript -> string-to-bytes "script"
          ElStyle -> string-to-bytes "style"
          ElTextarea -> string-to-bytes "textarea"
          ElTitle -> string-to-bytes "title"
          ElNone -> no-bytes ()) in
        case index-tag-end s marker 0 of
          Some i -> (init-ctx (), i)
          None -> (c, bytes-len s)

  -- | Find the first case-insensitive `</tag` followed by a valid HTML tag-end separator.
  index-tag-end :: Bytes -> Bytes -> Nat -> Option Nat
  index-tag-end s tag i = case find-bytes s (string-to-bytes "</") i of
    None -> None
    Some k ->
      let after-prefix = k + 2 in
      let after-tag = after-prefix + bytes-len tag in
      if after-tag < bytes-len s && equal-fold-at s after-prefix tag 0 && is-tag-end-sep (at s after-tag) then Some k
      else index-tag-end s tag (after-prefix + (if after-tag <= bytes-len s && equal-fold-at s after-prefix tag 0 then bytes-len tag else 0))

  -- | Report whether a byte can follow a closing tag name (`>`, space, tab, LF, FF, `/`).
  is-tag-end-sep :: Nat -> Bool
  is-tag-end-sep x = x == 62 || x == 32 || x == 9 || x == 10 || x == 12 || x == 47

  -- | Transition for URL and srcset states: track pre-query vs query/fragment position.
  t-url :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-url c s = case c of
    EscCtx st dl up jc br ak el err ->
      let next-up = (
        if has-any-byte s (string-to-bytes "#?") 0 then UpQueryOrFrag
        else if not (eat-ws s 0 == bytes-len s) && urlpart-id up == 0 then UpPreQuery
        else up) in
      (EscCtx st dl next-up jc br ak el err, bytes-len s)

  -- | Transition from `StJs` across strings, template literals, regexps, comments, and template braces.
  t-js :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-js c s = case c of
    EscCtx st dl up jc br ak el err ->
      let specials = string-to-bytes "\"`'/{}<-#" in
      case find-any-byte s specials 0 of
        None -> (EscCtx st dl up (next-js-ctx s jc) br ak el err, bytes-len s)
        Some i ->
          let jc2 = next-js-ctx (slice s 0 i) jc in
          let ch = at s i in
          if ch == 34 then (EscCtx StJsDqStr dl up JsRegexp br ak el err, i + 1)
          else if ch == 39 then (EscCtx StJsSqStr dl up JsRegexp br ak el err, i + 1)
          else if ch == 96 then (EscCtx StJsTmplLit dl up JsRegexp br ak el err, i + 1)
          else if ch == 47 then
            (if i + 1 < bytes-len s && at s (i + 1) == 47 then (EscCtx StJsLineCmt dl up jc2 br ak el err, i + 2)
            else if i + 1 < bytes-len s && at s (i + 1) == 42 then (EscCtx StJsBlockCmt dl up jc2 br ak el err, i + 2)
            else if jsctx-id jc2 == 0 then (EscCtx StJsRegexp dl up jc2 br ak el err, i + 1)
            else if jsctx-id jc2 == 1 then (EscCtx st dl up JsRegexp br ak el err, i + 1)
            else (err-ctx "'/' could start a division or regexp", bytes-len s))
          else if ch == 60 then
            (if i + 3 < bytes-len s && starts-with s i (string-to-bytes "<!--") then (EscCtx StJsHtmlOpenCmt dl up jc2 br ak el err, i + 4)
            else (EscCtx st dl up jc2 br ak el err, i + 1))
          else if ch == 45 then
            (if i + 2 < bytes-len s && starts-with s i (string-to-bytes "-->") then (EscCtx StJsHtmlCloseCmt dl up jc2 br ak el err, i + 3)
            else (EscCtx st dl up jc2 br ak el err, i + 1))
          else if ch == 35 then
            (if i + 1 < bytes-len s && at s (i + 1) == 33 then (EscCtx StJsLineCmt dl up jc2 br ak el err, i + 2)
            else (EscCtx st dl up jc2 br ak el err, i + 1))
          else if ch == 123 then
            (case br of
              Nil -> (EscCtx st dl up jc2 br ak el err, i + 1)
              Cons top rest -> (EscCtx st dl up jc2 (Cons (int-add top 1) rest) ak el err, i + 1))
          else
            (case br of
              Nil -> (EscCtx st dl up jc2 br ak el err, i + 1)
              Cons top rest ->
                let d = int-sub top 1 in
                if d >= 0 then (EscCtx st dl up jc2 (Cons d rest) ak el err, i + 1)
                else (EscCtx StJsTmplLit dl up jc2 rest ak el err, i + 1))

  -- | Determine whether `/` after `s` starts a regexp literal or a division operator.
  next-js-ctx :: Bytes -> JsCtx -> JsCtx
  next-js-ctx s preceding =
    let trimmed = trim-right-js-ws s in
    let n = bytes-len trimmed in
    if n == 0 then preceding
    else
      let c = at trimmed (n - 1) in
      if c == 43 || c == 45 then
        let start = count-same-back trimmed (n - 1) c in
        if nat-rem (minus n start) 2 == 1 then JsRegexp else JsDivOp
      else if c == 46 then
        if n > 1 && is-digit (at trimmed (n - 2)) then JsDivOp else JsRegexp
      else if c == 44 || c == 60 || c == 62 || c == 61 || c == 42 || c == 37 || c == 38 || c == 124 || c == 94 || c == 63
        || c == 33 || c == 126 || c == 40 || c == 91 || c == 58 || c == 59 || c == 123 || c == 125 then JsRegexp
      else
        let j = ident-back trimmed n in
        if is-js-regexp-keyword (text-of (slice trimmed j n)) then JsRegexp else JsDivOp

  -- | Trim trailing JavaScript whitespace (ASCII and Unicode space/line separators).
  trim-right-js-ws :: Bytes -> Bytes
  trim-right-js-ws s = slice s 0 (trim-right-js-len s (bytes-len s))

  -- | Length of `s` without trailing JS whitespace code points.
  trim-right-js-len :: Bytes -> Nat -> Nat
  trim-right-js-len s n =
    if n == 0 then 0
    else
      let b = at s (n - 1) in
      if b == 32 || b == 9 || b == 10 || b == 11 || b == 12 || b == 13 then trim-right-js-len s (n - 1)
      else if n >= 2 && at s (n - 2) == 194 && b == 160 then trim-right-js-len s (n - 2)
      else if n >= 3 && at s (n - 3) == 225 && at s (n - 2) == 154 && b == 128 then trim-right-js-len s (n - 3)
      else if n >= 3 && at s (n - 3) == 226 && at s (n - 2) == 128 && ((b >= 128 && b <= 138) || b == 168 || b == 169 || b == 175) then trim-right-js-len s (n - 3)
      else if n >= 3 && at s (n - 3) == 226 && at s (n - 2) == 129 && b == 159 then trim-right-js-len s (n - 3)
      else if n >= 3 && at s (n - 3) == 227 && at s (n - 2) == 128 && b == 128 then trim-right-js-len s (n - 3)
      else if n >= 3 && at s (n - 3) == 239 && at s (n - 2) == 187 && b == 191 then trim-right-js-len s (n - 3)
      else n

  -- | Walk backwards across consecutive bytes equal to `ch`.
  count-same-back :: Bytes -> Nat -> Nat -> Nat
  count-same-back s start ch = if start > 0 && at s (start - 1) == ch then count-same-back s (start - 1) ch else start

  -- | Walk backwards across trailing JS identifier part bytes.
  ident-back :: Bytes -> Nat -> Nat
  ident-back s j = if j > 0 && is-js-ident-part (at s (j - 1)) then ident-back s (j - 1) else j

  -- | Report whether a code point is an ASCII JS identifier part (`$`, `_`, `0-9`, `A-Z`, `a-z`).
  is-js-ident-part :: Nat -> Bool
  is-js-ident-part c = c == 36 || c == 95 || (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122)

  -- | Report whether a JS keyword can precede a regular expression literal.
  is-js-regexp-keyword :: String -> Bool
  is-js-regexp-keyword w =
    w == "break" || w == "case" || w == "continue" || w == "delete" || w == "do"
      || w == "else" || w == "finally" || w == "in" || w == "instanceof" || w == "return"
      || w == "throw" || w == "try" || w == "typeof" || w == "void"

  -- | Transition inside a JS backtick template literal (`StJsTmplLit`).
  t-js-tmpl :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-js-tmpl c s = t-js-tmpl-loop c s 0

  -- | Loop scanning a JS template literal for `\`, `${`, or closing `` ` ``.
  t-js-tmpl-loop :: EscCtx -> Bytes -> Nat -> (EscCtx, Nat)
  t-js-tmpl-loop c s k = case c of
    EscCtx st dl up jc br ak el err ->
      case find-any-byte s (string-to-bytes "`\\$") k of
        None -> (c, bytes-len s)
        Some i ->
          let ch = at s i in
          if ch == 92 then
            (if i + 1 >= bytes-len s then (err-ctx "unfinished escape sequence in JS string", bytes-len s)
            else t-js-tmpl-loop c s (i + 2))
          else if ch == 36 then
            (if i + 1 < bytes-len s && at s (i + 1) == 123 then
              (EscCtx StJs dl up jc (Cons 0 br) ak el err, i + 2)
            else t-js-tmpl-loop c s (i + 1))
          else (EscCtx StJs dl up jc br ak el err, i + 1)

  -- | Transition inside double-quoted JS strings, single-quoted JS strings, and JS regexps.
  t-js-delimited :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-js-delimited c s = case c of
    EscCtx st dl up jc br ak el err ->
      let specials = (case st of
        StJsSqStr -> string-to-bytes "\\'"
        StJsRegexp -> string-to-bytes "\\/[]"
        other -> string-to-bytes "\\\"") in
      t-js-delimited-loop c s specials 0 False

  -- | Loop scanning a JS string or regexp literal for escapes, charsets, or closing delimiter.
  t-js-delimited-loop :: EscCtx -> Bytes -> Bytes -> Nat -> Bool -> (EscCtx, Nat)
  t-js-delimited-loop c s specials k in-charset = case c of
    EscCtx st dl up jc br ak el err ->
      case find-any-byte s specials k of
        None ->
          if in-charset then (err-ctx "unfinished JS regexp charset", bytes-len s)
          else (c, bytes-len s)
        Some i ->
          let ch = at s i in
          if ch == 92 then
            (if i + 1 >= bytes-len s then (err-ctx "unfinished escape sequence in JS string", bytes-len s)
            else t-js-delimited-loop c s specials (i + 2) in-charset)
          else if ch == 91 then t-js-delimited-loop c s specials (i + 1) True
          else if ch == 93 then t-js-delimited-loop c s specials (i + 1) False
          else if ch == 47 then
            (if i > 0 && i + 7 <= bytes-len s && equal-fold-at s (i - 1) (string-to-bytes "</script") 0 then
              t-js-delimited-loop c s specials (i + 2) in-charset
            else if not in-charset then (EscCtx StJs dl up JsDivOp br ak el err, i + 1)
            else t-js-delimited-loop c s specials (i + 1) in-charset)
          else
            (if not in-charset then (EscCtx StJs dl up JsDivOp br ak el err, i + 1)
            else t-js-delimited-loop c s specials (i + 1) in-charset)

  -- | Transition inside JS or CSS `/* ... */` block comments.
  t-block-cmt :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-block-cmt c s = case c of
    EscCtx st dl up jc br ak el err -> case find-bytes s (string-to-bytes "*/") 0 of
      None -> (c, bytes-len s)
      Some i ->
        let next-st = case st of StJsBlockCmt -> StJs; other -> StCss in
        (EscCtx next-st dl up jc br ak el err, i + 2)

  -- | Transition inside JS or CSS single-line comments up to (but not consuming) the line terminator.
  t-line-cmt :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-line-cmt c s = case c of
    EscCtx st dl up jc br ak el err ->
      let is-css = case st of StCssLineCmt -> True; other -> False in
      case find-line-term s is-css 0 of
        None -> (c, bytes-len s)
        Some i -> (EscCtx (if is-css then StCss else StJs) dl up jc br ak el err, i)

  -- | Find the first line terminator byte offset (`\n`, `\r`, `\f` for CSS; `\n`, `\r`, U+2028, U+2029 for JS).
  find-line-term :: Bytes -> Bool -> Nat -> Option Nat
  find-line-term s is-css i =
    if i >= bytes-len s then None
    else
      let x = at s i in
      if x == 10 || x == 13 || (is-css && x == 12) then Some i
      else if not is-css && x == 226 && i + 2 < bytes-len s && at s (i + 1) == 128 && (at s (i + 2) == 168 || at s (i + 2) == 169) then Some i
      else find-line-term s is-css (i + 1)

  -- | Report whether a byte slice contains any JS line terminator (`\n`, `\r`, U+2028, U+2029).
  has-js-line-term :: Bytes -> Bool
  has-js-line-term s = case find-line-term s False 0 of Some k -> True; None -> False

  -- | Transition inside CSS code (`StCss`).
  t-css :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-css c s = t-css-loop c s 0

  -- | Loop scanning CSS code for `url(`, comments, or string quotes.
  t-css-loop :: EscCtx -> Bytes -> Nat -> (EscCtx, Nat)
  t-css-loop c s k = case c of
    EscCtx st dl up jc br ak el err ->
      case find-any-byte s (string-to-bytes "(\"'/") k of
        None -> (c, bytes-len s)
        Some i ->
          let ch = at s i in
          if ch == 40 then
            let before = trim-css-right (slice s 0 i) in
            if ends-with-css-keyword before (string-to-bytes "url") then
              let j = eat-css-ws s (i + 1) in
              if j < bytes-len s && at s j == 34 then (EscCtx StCssDqUrl dl UpNone jc br ak el err, j + 1)
              else if j < bytes-len s && at s j == 39 then (EscCtx StCssSqUrl dl UpNone jc br ak el err, j + 1)
              else (EscCtx StCssUrl dl UpNone jc br ak el err, j)
            else t-css-loop c s (i + 1)
          else if ch == 47 then
            (if i + 1 < bytes-len s && at s (i + 1) == 47 then (EscCtx StCssLineCmt dl up jc br ak el err, i + 2)
            else if i + 1 < bytes-len s && at s (i + 1) == 42 then (EscCtx StCssBlockCmt dl up jc br ak el err, i + 2)
            else t-css-loop c s (i + 1))
          else if ch == 34 then (EscCtx StCssDqStr dl UpNone jc br ak el err, i + 1)
          else (EscCtx StCssSqStr dl UpNone jc br ak el err, i + 1)

  -- | Trim trailing CSS whitespace (`\t`, `\n`, `\f`, `\r`, `' '`).
  trim-css-right :: Bytes -> Bytes
  trim-css-right b = slice b 0 (trim-css-right-idx b (bytes-len b))

  -- | Length of `b` without trailing CSS whitespace.
  trim-css-right-idx :: Bytes -> Nat -> Nat
  trim-css-right-idx b n = if n > 0 && is-html-ws (at b (n - 1)) then trim-css-right-idx b (n - 1) else n

  -- | Skip leading CSS whitespace from `i`.
  eat-css-ws :: Bytes -> Nat -> Nat
  eat-css-ws s i = eat-ws s i

  -- | Report whether `b` ends with CSS identifier `kw` (lower-case) not preceded by a CSS nmchar.
  ends-with-css-keyword :: Bytes -> Bytes -> Bool
  ends-with-css-keyword b kw =
    if bytes-len b < bytes-len kw then False
    else
      let i = minus (bytes-len b) (bytes-len kw) in
      let boundary-ok = if i == 0 then True else not (is-css-nmchar (last-rune-before b i)) in
      boundary-ok && equal-fold-at b i kw 0

  -- | Decode the last UTF-8 scalar ending at byte offset `end`.
  last-rune-before :: Bytes -> Nat -> Nat
  last-rune-before b end =
    if end == 0 then 0
    else
      let start = utf8-prev-start b (end - 1) in
      let n = rune-size b start in
      if n == 0 then at b (end - 1) else rune-value b start n

  -- | Find the start offset of the UTF-8 sequence containing index `i`.
  utf8-prev-start :: Bytes -> Nat -> Nat
  utf8-prev-start b i = if i > 0 && cont (at b i) then utf8-prev-start b (i - 1) else i

  -- | Report whether a Unicode scalar is a CSS3 identifier `nmchar`.
  is-css-nmchar :: Nat -> Bool
  is-css-nmchar r =
    (r >= 97 && r <= 122) || (r >= 65 && r <= 90) || (r >= 48 && r <= 57)
      || r == 45 || r == 95
      || (r >= 128 && r <= 55295)
      || (r >= 57344 && r <= 65533)
      || (r >= 65536 && r <= 1114111)

  -- | Transition inside CSS string and `url(...)` states.
  t-css-str :: EscCtx -> Bytes -> (EscCtx, Nat)
  t-css-str c s = case c of
    EscCtx st dl up jc br ak el err ->
      let end-esc = (case st of
        StCssDqStr -> string-to-bytes "\\\""
        StCssDqUrl -> string-to-bytes "\\\""
        StCssSqStr -> string-to-bytes "\\'"
        StCssSqUrl -> string-to-bytes "\\'"
        other -> from-list [92, 9, 10, 12, 13, 32, 41]) in
      t-css-str-loop c s end-esc 0

  -- | Loop scanning a CSS string or URL for backslash escapes or closing delimiter.
  t-css-str-loop :: EscCtx -> Bytes -> Bytes -> Nat -> (EscCtx, Nat)
  t-css-str-loop c s end-esc k = case c of
    EscCtx st dl up jc br ak el err ->
      case find-any-byte s end-esc k of
        None -> case t-url c (decode-css (slice s k (bytes-len s))) of (c2, nread) -> (c2, bytes-len s)
        Some i ->
          if at s i == 92 then
            if i + 1 >= bytes-len s then (err-ctx "unfinished escape sequence in CSS string", bytes-len s)
            else case t-url c (decode-css (slice s 0 (i + 2))) of (c2, nread) -> t-css-str-loop c2 s end-esc (i + 2)
          else (EscCtx StCss dl UpNone jc br ak el err, i + 1)

  -- | Decode CSS3 backslash escapes in a byte buffer.
  decode-css :: Bytes -> Bytes
  decode-css s = case find-byte s 92 0 of
    None -> s
    Some k -> bytes-concat (reverse (decode-css-from s 0 Nil))

  -- | Decode CSS3 escapes from offset `i`, collecting pieces in reverse.
  decode-css-from :: Bytes -> Nat -> List Bytes -> List Bytes
  decode-css-from s i acc =
    if i >= bytes-len s then acc
    else case find-byte s 92 i of
      None -> Cons (slice s i (bytes-len s)) acc
      Some k ->
        let acc1 = if k > i then Cons (slice s i k) acc else acc in
        if k + 1 >= bytes-len s then acc1
        else
          let next = at s (k + 1) in
          if is-hex next then
            let j = css-hex-end s (k + 2) (k + 7) in
            let r0 = hex-value s (k + 1) j 0 in
            let r = if r0 > 1114111 then nat-div r0 16 else r0 in
            let j2 = if r0 > 1114111 then minus j 1 else j in
            let after = skip-css-space s j2 in
            decode-css-from s after (Cons (encode-rune r) acc1)
          else
            let rlen = rune-size s (k + 1) in
            let step = if rlen == 0 then (1 :: Nat) else rlen in
            decode-css-from s (k + 1 + step) (Cons (slice s (k + 1) (k + 1 + step)) acc1)

  -- | Scan up to 6 CSS hex escape digits.
  css-hex-end :: Bytes -> Nat -> Nat -> Nat
  css-hex-end s j limit = if j < bytes-len s && j < limit && is-hex (at s j) then css-hex-end s (j + 1) limit else j

  -- | Skip a single optional CSS whitespace terminator (including CRLF) after a hex escape.
  skip-css-space :: Bytes -> Nat -> Nat
  skip-css-space s i =
    if i >= bytes-len s then i
    else
      let x = at s i in
      if x == 9 || x == 10 || x == 12 || x == 32 then i + 1
      else if x == 13 then (if i + 1 < bytes-len s && at s (i + 1) == 10 then i + 2 else i + 1)
      else i

  -- | Delimiter bytes that close an HTML attribute value.
  delim-end-bytes :: EscDelim -> Bytes
  delim-end-bytes d = case d of
    DlDoubleQuote -> string-to-bytes "\""
    DlSingleQuote -> string-to-bytes "'"
    DlSpaceOrTagEnd -> from-list [32, 9, 10, 12, 13, 62]
    DlNone -> no-bytes ()

  -- | Advance `c` across a prefix of text `s`, handling attribute delimiters and entity decoding.
  context-after-text :: EscCtx -> Bytes -> (EscCtx, Nat)
  context-after-text c s = case c of
    EscCtx st dl up jc br ak el err -> case dl of
      DlNone ->
        case t-special-tag-end c s of
          (c1, i) -> if i == 0 then (c1, 0) else transition-state st c (slice s 0 i)
      other ->
        let end-pos = case find-any-byte s (delim-end-bytes dl) 0 of Some k -> k; None -> bytes-len s in
        let bad-unquoted = (case dl of
          DlSpaceOrTagEnd -> has-any-byte (slice s 0 end-pos) (string-to-bytes "\"'<=`") 0
          other2 -> False) in
        if bad-unquoted then (err-ctx "bad character in unquoted attr", bytes-len s)
        else if end-pos == bytes-len s then
          let unescaped = html-unescape-bytes s in
          (run-attr-transitions c unescaped 0, bytes-len s)
        else
          let el2 = if state-id st == 7 && elem-id el == 1 && attr-id ak == 2 && not (is-js-type (slice s 0 end-pos)) then ElNone else el in
          let consumed = case dl of DlSpaceOrTagEnd -> end-pos; other2 -> end-pos + 1 in
          (EscCtx StTag DlNone UpNone JsRegexp Nil AtNone el2 None, consumed)

  -- | Repeatedly apply state transitions across HTML-unescaped attribute value bytes.
  run-attr-transitions :: EscCtx -> Bytes -> Nat -> EscCtx
  run-attr-transitions c u i =
    if i >= bytes-len u then c
    else case c of
      EscCtx st dl up jc br ak el err ->
        if state-id st == 27 then c
        else case transition-state st c (slice u i (bytes-len u)) of
          (c1, nread) ->
            if nread == 0 && state-id (ctx-state c1) == state-id st then c1
            else run-attr-transitions c1 u (i + nread)

  -- | Escape a static text node, stripping comments, escaping stray `<`, and neutralizing script tags inside JS literals.
  escape-text :: EscCtx -> Bytes -> (EscCtx, Bytes)
  escape-text c s = escape-text-loop c s 0 0 Nil

  -- | Main loop for `escape-text`, accumulating modified chunks in reverse.
  escape-text-loop :: EscCtx -> Bytes -> Nat -> Nat -> List Bytes -> (EscCtx, Bytes)
  escape-text-loop c s i written acc =
    if i >= bytes-len s then
      if written == 0 || state-id (ctx-state c) == 27 then (c, s)
      else
        let final-acc = if not (is-comment-state (ctx-state c)) || not (delim-id (ctx-delim c) == 0) then Cons (slice s written (bytes-len s)) acc else acc in
        (c, bytes-concat (reverse final-acc))
    else
      case context-after-text c (slice s i (bytes-len s)) of
        (c1, nread) ->
          let i1 = i + nread in
          let st = ctx-state c in
          let st1 = ctx-state c1 in
          let dl = ctx-delim c in
          let dl1 = ctx-delim c1 in
          let step1 = (
            if state-id st == 0 || state-id st == 6 then
              let end = if not (state-id st1 == state-id st) then find-tag-open-back s i i1 else i1 in
              escape-stray-lt s i end written acc
            else if is-comment-state st && delim-id dl == 0 then
              let cmt-acc = (case st of
                StJsBlockCmt -> Cons (string-to-bytes (if has-js-line-term (slice s written i1) then "\n" else " ")) acc
                StCssBlockCmt -> Cons (string-to-bytes " ") acc
                other -> acc) in
              (i1, cmt-acc)
            else (written, acc)) in
          let w1 = fst-nat-bytes step1 in
          let a1 = snd-nat-bytes step1 in
          let step2 = (
            if not (state-id st == state-id st1) && is-comment-state st1 && delim-id dl1 == 0 then
              let open-len = (case st1 of
                StHtmlCmt -> (4 :: Nat)
                StJsHtmlOpenCmt -> (4 :: Nat)
                StJsHtmlCloseCmt -> (3 :: Nat)
                other -> (2 :: Nat)) in
              let cs = minus i1 open-len in
              (i1, Cons (slice s w1 cs) a1)
            else (w1, a1)) in
          let w2 = fst-nat-bytes step2 in
          let a2 = snd-nat-bytes step2 in
          let step3 = (
            if is-in-script-literal st && contains-special-script-tag (slice s i i1) 0 then
              (i1, Cons (escape-special-script-tags (slice s i i1)) (Cons (slice s w2 i) a2))
            else (w2, a2)) in
          let w3 = fst-nat-bytes step3 in
          let a3 = snd-nat-bytes step3 in
          if nread == 0 && state-id st == state-id st1 then (c1, s)
          else escape-text-loop c1 s i1 w3 a3

  -- | Extract the `EscDelim` field of an `EscCtx`.
  ctx-delim :: EscCtx -> EscDelim
  ctx-delim c = case c of EscCtx st dl up jc br ak el err -> dl

  -- | Extract the first component of a `(Nat, List Bytes)` pair.
  fst-nat-bytes :: (Nat, List Bytes) -> Nat
  fst-nat-bytes p = case p of (w, a) -> w

  -- | Extract the second component of a `(Nat, List Bytes)` pair.
  snd-nat-bytes :: (Nat, List Bytes) -> List Bytes
  snd-nat-bytes p = case p of (w, a) -> a

  -- | Walk backward from `end` down to `start` to locate the `<` that began a tag or comment.
  find-tag-open-back :: Bytes -> Nat -> Nat -> Nat
  find-tag-open-back s start end =
    if end <= start then start
    else if at s (end - 1) == 60 then end - 1
    else find-tag-open-back s start (end - 1)

  -- | Replace stray `<` in `s[j, end)` (except `<!DOCTYPE`) with `&lt;`.
  escape-stray-lt :: Bytes -> Nat -> Nat -> Nat -> List Bytes -> (Nat, List Bytes)
  escape-stray-lt s j end written acc =
    if j >= end then (written, acc)
    else if at s j == 60 && not (equal-fold-at s j (string-to-bytes "<!doctype") 0) then
      escape-stray-lt s (j + 1) end (j + 1) (Cons (string-to-bytes "&lt;") (Cons (slice s written j) acc))
    else escape-stray-lt s (j + 1) end written acc

  -- | Report whether `s` contains case-insensitive `<script`, `</script`, or `<!--`.
  contains-special-script-tag :: Bytes -> Nat -> Bool
  contains-special-script-tag s i =
    let k = scalar-find s 60 i in
    if k >= bytes-len s then False
    else if is-special-script-at s k then True
    else contains-special-script-tag s (k + 1)

  -- | Report whether `<script`, `</script`, or `<!--` starts at offset `k`.
  is-special-script-at :: Bytes -> Nat -> Bool
  is-special-script-at s k =
    equal-fold-at s k (string-to-bytes "<script") 0
      || equal-fold-at s k (string-to-bytes "</script") 0
      || starts-with s k (string-to-bytes "<!--")

  -- | Replace `<` in `<script`, `</script`, and `<!--` inside JS literals with `\x3C`.
  escape-special-script-tags :: Bytes -> Bytes
  escape-special-script-tags s = bytes-concat (reverse (escape-special-script-from s 0 0 Nil))

  -- | Scan and replace special script tags from `i`.
  escape-special-script-from :: Bytes -> Nat -> Nat -> List Bytes -> List Bytes
  escape-special-script-from s i written acc =
    let k = scalar-find s 60 i in
    if k >= bytes-len s then Cons (slice s written (bytes-len s)) acc
    else if is-special-script-at s k then
      escape-special-script-from s (k + 1) (k + 1) (Cons (string-to-bytes "\\x3C") (Cons (slice s written k) acc))
    else escape-special-script-from s (k + 1) written acc

  -- | Escape an action pipeline according to the current context `c`.
  escape-action :: EscCtx -> Expr -> (EscCtx, Expr)
  escape-action c p =
    if declares p then (c, p)
    else
      let c1 = nudge c in
      case check-predefined-escapers c1 p of
        Some msg -> (err-ctx msg, p)
        None -> case c1 of
          EscCtx st dl up jc br ak el err ->
            if state-id st == 27 then (c1, p)
            else case state-escapers st up of
              Err msg -> (err-ctx msg, p)
              Ok (escs, c-after-st) ->
                let full-escs = (case dl of
                  DlNone -> escs
                  DlSpaceOrTagEnd -> append-strings escs (Cons "_html_template_nospaceescaper" Nil)
                  other -> append-strings escs (Cons "_html_template_attrescaper" Nil)) in
                let c-out = (case c-after-st of
                  None -> c1
                  Some st-new -> case st-new of
                    (st2, jc2) -> EscCtx st2 dl up jc2 br ak el err) in
                (c-out, ensure-pipeline p full-escs)

  -- | Reject disallowed uses of predefined `html` or `urlquery` escapers in a pipeline.
  check-predefined-escapers :: EscCtx -> Expr -> Option String
  check-predefined-escapers c p = case p of
    ExPipe decls assign cmds -> check-predef-cmds c cmds
    other -> None

  -- | Check each command stage in a pipeline for disallowed predefined escapers.
  check-predef-cmds :: EscCtx -> Expr -> Option String
  check-predef-cmds c cmds = case cmds of
    ExCmd cmd rest ->
      let is-last = case rest of ExCmdEnd -> True; other -> False in
      case cmd-head-ident cmd of
        Some ident ->
          if is-predefined-escaper ident then
            let bad-unquoted = state-id (ctx-state c) == 7 && delim-id (ctx-delim c) == 3 && ident == "html" in
            if not is-last || bad-unquoted then
              Some (string-concat-all ["predefined escaper \"", ident, "\" disallowed in template"])
            else check-predef-cmds c rest
          else check-predef-cmds c rest
        None -> check-predef-cmds c rest
    other -> None

  -- | Extract the leading identifier name of a command, if it is a function call.
  cmd-head-ident :: Expr -> Option String
  cmd-head-ident cmd = case cmd of
    ExArg first rest -> (case first of ExFunc name -> Some name; other -> None)
    other -> None

  -- | Report whether an identifier is one of the predefined escapers (`html` or `urlquery`).
  is-predefined-escaper :: String -> Bool
  is-predefined-escaper name = name == "html" || name == "urlquery"

  -- | Normalize equivalent escaper names to detect deduplication.
  normalize-esc-fn :: String -> String
  normalize-esc-fn name =
    if name == "_html_template_attrescaper" || name == "_html_template_htmlescaper" || name == "_html_template_rcdataescaper" then "html"
    else if name == "_html_template_urlescaper" || name == "_html_template_urlnormalizer" then "urlquery"
    else name

  -- | Report whether appending `next` immediately after `last` is redundant.
  is-redundant-esc :: String -> String -> Bool
  is-redundant-esc last next =
    if last == "_html_template_commentescaper" then next == "_html_template_attrescaper" || next == "_html_template_htmlescaper"
    else if last == "_html_template_cssescaper" || last == "_html_template_jsregexpescaper" || last == "_html_template_jsstrescaper" || last == "_html_template_jstmpllitescaper" then next == "_html_template_attrescaper"
    else if last == "_html_template_urlescaper" then next == "_html_template_urlnormalizer"
    else False

  -- | Select the primary context escaper chain and optional state/jsCtx update for `st` and `up`.
  state-escapers :: EscState -> UrlPart -> Result String (List String, Option (EscState, JsCtx))
  state-escapers st up = case st of
    StUrl -> url-state-escapers False up
    StCssDqStr -> url-state-escapers True up
    StCssSqStr -> url-state-escapers True up
    StCssDqUrl -> url-state-escapers False up
    StCssSqUrl -> url-state-escapers False up
    StCssUrl -> url-state-escapers False up
    StJs -> Ok (Cons "_html_template_jsvalescaper" Nil, Some (StJs, JsDivOp))
    StJsDqStr -> Ok (Cons "_html_template_jsstrescaper" Nil, None)
    StJsSqStr -> Ok (Cons "_html_template_jsstrescaper" Nil, None)
    StJsTmplLit -> Ok (Cons "_html_template_jstmpllitescaper" Nil, None)
    StJsRegexp -> Ok (Cons "_html_template_jsregexpescaper" Nil, None)
    StCss -> Ok (Cons "_html_template_cssvaluefilter" Nil, None)
    StText -> Ok (Cons "_html_template_htmlescaper" Nil, None)
    StRcdata -> Ok (Cons "_html_template_rcdataescaper" Nil, None)
    StAttr -> Ok (Nil, None)
    StAttrName -> Ok (Cons "_html_template_htmlnamefilter" Nil, Some (StAttrName, JsRegexp))
    StTag -> Ok (Cons "_html_template_htmlnamefilter" Nil, Some (StAttrName, JsRegexp))
    StSrcset -> Ok (Cons "_html_template_srcsetescaper" Nil, None)
    other ->
      if is-comment-state st then Ok (Cons "_html_template_commentescaper" Nil, None)
      else Err "unexpected escaping state"

  -- | Select URL/CSS-string escapers according to `UrlPart`.
  url-state-escapers :: Bool -> UrlPart -> Result String (List String, Option (EscState, JsCtx))
  url-state-escapers is-css-str up = case up of
    UpNone -> Ok (Cons "_html_template_urlfilter" (Cons (if is-css-str then "_html_template_cssescaper" else "_html_template_urlnormalizer") Nil), None)
    UpPreQuery -> Ok (Cons (if is-css-str then "_html_template_cssescaper" else "_html_template_urlnormalizer") Nil, None)
    UpQueryOrFrag -> Ok (Cons "_html_template_urlescaper" Nil, None)
    UpUnknown -> Err "action appears in an ambiguous context within a URL"

  -- | Append required escaper commands to a pipeline while merging equivalent predefined escapers.
  ensure-pipeline :: Expr -> List String -> Expr
  ensure-pipeline p escs = case escs of
    Nil -> p
    Cons e0 er -> case p of
      ExPipe decls assign cmds ->
        let cmd-list = cmd-spine-to-list cmds in
        let rewritten = merge-predefined cmd-list escs in
        case rewritten of
          (base-cmds, final-escs) ->
            let inserted = collect-norm-idents base-cmds in
            let all-cmds = append-esc-cmds base-cmds inserted final-escs in
            ExPipe decls assign (cmd-list-to-spine all-cmds)
      other -> p

  -- | Convert a command spine to a list.
  cmd-spine-to-list :: Expr -> List Expr
  cmd-spine-to-list cmds = case cmds of ExCmd c rest -> Cons c (cmd-spine-to-list rest); other -> Nil

  -- | Convert a list of commands back to a command spine.
  cmd-list-to-spine :: List Expr -> Expr
  cmd-list-to-spine cs = case cs of Nil -> ExCmdEnd; Cons c rest -> ExCmd c (cmd-list-to-spine rest)

  -- | Merge a trailing predefined escaper (`html` or `urlquery`) with contextual escapers.
  merge-predefined :: List Expr -> List String -> (List Expr, List String)
  merge-predefined cmds escs = case split-last cmds Nil of
    None -> (cmds, escs)
    Some (prefix, last-cmd) -> case cmd-head-ident last-cmd of
      None -> (cmds, escs)
      Some ident ->
        if not (is-predefined-escaper ident) then (cmds, escs)
        else
          let expanded = (
            if list-length prefix == 0 && has-extra-args last-cmd then
              (Cons (replace-cmd-head last-cmd "_eval_args_") Nil, ident)
            else (prefix, ident)) in
          let base = case expanded of (b, id2) -> b in
          let predef = case expanded of (b, id2) -> id2 in
          case replace-equiv-escs escs predef False Nil of
            (new-escs, dup) ->
              if dup then (base, new-escs)
              else (append-exprs base (Cons (ExArg (ExFunc predef) ExArgEnd) Nil), new-escs)

  -- | Split a non-empty list into its prefix and last element.
  split-last :: forall a. List a -> List a -> Option (List a, a)
  split-last xs acc = case xs of
    Nil -> None
    Cons x rest -> case rest of
      Nil -> Some (reverse acc, x)
      Cons y more -> split-last rest (Cons x acc)

  -- | Report whether a command has at least one operand after its function name.
  has-extra-args :: Expr -> Bool
  has-extra-args cmd = case cmd of
    ExArg first rest -> (case rest of ExArg second more -> True; other -> False)
    other -> False

  -- | Replace the leading function identifier of a command.
  replace-cmd-head :: Expr -> String -> Expr
  replace-cmd-head cmd new-name = case cmd of
    ExArg first rest -> ExArg (ExFunc new-name) rest
    other -> cmd

  -- | Replace any escaper in `escs` equivalent to `predef` with `predef`, noting whether a match occurred.
  replace-equiv-escs :: List String -> String -> Bool -> List String -> (List String, Bool)
  replace-equiv-escs escs predef dup acc = case escs of
    Nil -> (reverse acc, dup)
    Cons e rest ->
      if normalize-esc-fn e == normalize-esc-fn predef then replace-equiv-escs rest predef True (Cons predef acc)
      else replace-equiv-escs rest predef dup (Cons e acc)

  -- | Concatenate two lists of expressions.
  append-exprs :: List Expr -> List Expr -> List Expr
  append-exprs xs ys = case xs of Nil -> ys; Cons x rest -> Cons x (append-exprs rest ys)

  -- | Collect normalized leading identifier names from existing pipeline commands.
  collect-norm-idents :: List Expr -> List String
  collect-norm-idents cmds = case cmds of
    Nil -> Nil
    Cons c rest -> case cmd-head-ident c of
      Some ident -> Cons (normalize-esc-fn ident) (collect-norm-idents rest)
      None -> collect-norm-idents rest

  -- | Append escaper commands to `cmds`, skipping duplicates and redundant pairs.
  append-esc-cmds :: List Expr -> List String -> List String -> List Expr
  append-esc-cmds cmds inserted escs = case escs of
    Nil -> cmds
    Cons name rest ->
      let norm = normalize-esc-fn name in
      if has-string inserted norm then append-esc-cmds cmds inserted rest
      else
        let redundant = (case last-ident cmds None of
          Some prev -> is-redundant-esc prev name
          None -> False) in
        if redundant then append-esc-cmds cmds inserted rest
        else append-esc-cmds (append-exprs cmds (Cons (ExArg (ExFunc name) ExArgEnd) Nil)) (Cons norm inserted) rest

  -- | Return the leading identifier of the last command in `cmds`, if any.
  last-ident :: List Expr -> Option String -> Option String
  last-ident cmds acc = case cmds of
    Nil -> acc
    Cons c rest -> last-ident rest (cmd-head-ident c)

  -- | Escaping environment threaded through AST rewriting: raw templates, computed output contexts,
  -- derived context-specialized templates, called mangled names, and active loop break/continue stacks.
  data EscEnv where
    -- | Raw templates, output context map, derived escaped templates, called names, break contexts, and continue contexts.
    EscEnv :: List (String, Node) -> List (String, EscCtx) -> List (String, Node) -> List String -> List EscCtx -> List EscCtx -> EscEnv

  -- | Look up a recorded output context for a mangled template name.
  lookup-out-ctx :: List (String, EscCtx) -> String -> Option EscCtx
  lookup-out-ctx xs k = case xs of
    Nil -> None
    Cons p rest -> case p of (n, c) -> if n == k then Some c else lookup-out-ctx rest k

  -- | Insert or update a recorded output context in `EscEnv`.
  set-out-ctx :: EscEnv -> String -> EscCtx -> EscEnv
  set-out-ctx env name c = case env of
    EscEnv raw out derived called brks conts ->
      EscEnv raw (Cons (name, c) out) derived called brks conts

  -- | Record a derived escaped template body in `EscEnv`.
  add-derived :: EscEnv -> String -> Node -> EscEnv
  add-derived env name body = case env of
    EscEnv raw out derived called brks conts ->
      EscEnv raw out (Cons (name, body) (drop-node derived name)) called brks conts

  -- | Record that a mangled template name was invoked.
  mark-called :: EscEnv -> String -> EscEnv
  mark-called env name = case env of
    EscEnv raw out derived called brks conts ->
      EscEnv raw out derived (Cons name called) brks conts

  -- | Escape a root template starting from `StText`, ensuring it terminates in `StText`.
  escape-template-root :: List (String, Node) -> String -> Node -> Result String (Node, List (String, Node))
  escape-template-root raw name root =
    let env0 = EscEnv raw (Cons (name, init-ctx ()) Nil) Nil Nil Nil Nil in
    case escape-node-spine env0 (init-ctx ()) root of
      (env1, c-end, root1) -> case ctx-err c-end of
        Some msg -> Err msg
        None ->
          if not (state-id (ctx-state c-end) == 0) then Err "ends in a non-text context"
          else case env1 of EscEnv r o derived ca br co -> Ok (root1, derived)

  -- | Escape a spine of template nodes, returning updated environment, end context, and rewritten spine.
  escape-node-spine :: EscEnv -> EscCtx -> Node -> (EscEnv, EscCtx, Node)
  escape-node-spine env c node =
    if state-id (ctx-state c) == 28 then (env, c, node)
    else case node of
      NdEnd -> (env, c, NdEnd)
      NdText b next ->
        case escape-text c b of
          (c1, b1) -> case escape-node-spine env c1 next of
            (env2, c2, next2) -> (env2, c2, NdText b1 next2)
      NdAction p next ->
        case escape-action c p of
          (c1, p1) -> case escape-node-spine env c1 next of
            (env2, c2, next2) -> (env2, c2, NdAction p1 next2)
      NdBreak next ->
        case env of
          EscEnv raw out derived called brks conts ->
            (EscEnv raw out derived called (Cons c brks) conts, dead-ctx (), NdBreak next)
      NdContinue next ->
        case env of
          EscEnv raw out derived called brks conts ->
            (EscEnv raw out derived called brks (Cons c conts), dead-ctx (), NdContinue next)
      NdIf p body alt next ->
        case escape-if-or-with env c body alt "if" of
          (env1, c1, body1, alt1) -> case escape-node-spine env1 c1 next of
            (env2, c2, next2) -> (env2, c2, NdIf p body1 alt1 next2)
      NdWith p body alt next ->
        case escape-if-or-with env c body alt "with" of
          (env1, c1, body1, alt1) -> case escape-node-spine env1 c1 next of
            (env2, c2, next2) -> (env2, c2, NdWith p body1 alt1 next2)
      NdRange p body alt next ->
        case escape-range env c body alt of
          (env1, c1, body1, alt1) -> case escape-node-spine env1 c1 next of
            (env2, c2, next2) -> (env2, c2, NdRange p body1 alt1 next2)
      NdTemplate name p next ->
        case escape-template-call env c name of
          (env1, c1, dname) -> case escape-node-spine env1 c1 next of
            (env2, c2, next2) -> (env2, c2, NdTemplate dname p next2)

  -- | Escape both branches of an `if` or `with` node and join their output contexts.
  escape-if-or-with :: EscEnv -> EscCtx -> Node -> Node -> String -> (EscEnv, EscCtx, Node, Node)
  escape-if-or-with env c body alt kind =
    case escape-node-spine env c body of
      (env1, c0, body1) -> case escape-node-spine env1 c alt of
        (env2, c1, alt1) -> (env2, join-ctx c0 c1 kind, body1, alt1)

  -- | Escape a `range` node, verifying break/continue contexts and loop re-entry consistency.
  escape-range :: EscEnv -> EscCtx -> Node -> Node -> (EscEnv, EscCtx, Node, Node)
  escape-range env c body alt = case env of
    EscEnv raw out derived called outer-brks outer-conts ->
      let inner0 = EscEnv raw out derived called Nil Nil in
      case escape-node-spine inner0 c body of
        (inner1, c0-raw, body1) -> case inner1 of
          EscEnv r1 o1 d1 ca1 brks1 conts1 ->
            let c0-j = if state-id (ctx-state c0-raw) == 27 then c0-raw else join-range-ctxs c0-raw brks1 conts1 in
            if state-id (ctx-state c0-j) == 27 then (EscEnv r1 o1 d1 ca1 outer-brks outer-conts, c0-j, body1, alt)
            else
              let probe0 = EscEnv r1 o1 d1 ca1 Nil Nil in
              case escape-node-spine probe0 c0-j body of
                (probe1, c1-re, ignored-body) ->
                  let c0-re = join-ctx c0-j c1-re "range" in
                  if state-id (ctx-state c0-re) == 27 then (EscEnv r1 o1 d1 ca1 outer-brks outer-conts, c0-re, body1, alt)
                  else case probe1 of
                    EscEnv rp op dp cap brks2 conts2 ->
                      let c0-final = join-range-ctxs c0-re brks2 conts2 in
                      let env-restored = EscEnv r1 o1 d1 ca1 outer-brks outer-conts in
                      if state-id (ctx-state c0-final) == 27 then (env-restored, c0-final, body1, alt)
                      else case escape-node-spine env-restored c alt of
                        (env2, c-else, alt1) -> (env2, join-ctx c0-final c-else "range", body1, alt1)

  -- | Join all `break` and `continue` contexts collected inside a `range` body into `c0`.
  join-range-ctxs :: EscCtx -> List EscCtx -> List EscCtx -> EscCtx
  join-range-ctxs c0 brks conts = join-ctx-list (join-ctx-list c0 brks) conts

  -- | Fold `join-ctx` over a list of contexts.
  join-ctx-list :: EscCtx -> List EscCtx -> EscCtx
  join-ctx-list acc xs = case xs of
    Nil -> acc
    Cons x rest ->
      let next = join-ctx acc x "range" in
      if state-id (ctx-state next) == 27 then next else join-ctx-list next rest

  -- | Escape a `{{template "name" ...}}` call, creating a context-mangled derived template when needed.
  escape-template-call :: EscEnv -> EscCtx -> String -> (EscEnv, EscCtx, String)
  escape-template-call env c name =
    let dname = mangle-name c name in
    let env1 = mark-called env dname in
    case env1 of
      EscEnv raw out derived called brks conts -> case lookup-out-ctx out dname of
        Some out-c -> (env1, out-c, dname)
        None -> case lookup-node raw name of
          None -> (env1, err-ctx (string-concat-all ["no such template \"", name, "\""]), dname)
          Some body ->
            case escape-template-body env1 c c dname body of
              (env2, c1, ok1) ->
                if ok1 then (env2, c1, dname)
                else if state-id (ctx-state c1) == 27 then (env1, c1, dname)
                else case escape-template-body env1 c1 c1 dname body of
                  (env3, c2, ok2) ->
                    if ok2 then (env3, c2, dname)
                    else if state-id (ctx-state c2) == 27 then (env1, c2, dname)
                    else (env1, err-ctx (string-concat "cannot compute output context for template " dname), dname)

  -- | Attempt escaping a template body under an assumed output context `assumed`.
  escape-template-body :: EscEnv -> EscCtx -> EscCtx -> String -> Node -> (EscEnv, EscCtx, Bool)
  escape-template-body env start-c assumed dname body = case env of
    EscEnv raw out derived called brks conts ->
      let trial0 = EscEnv raw (Cons (dname, assumed) out) derived Nil Nil Nil in
      case escape-node-spine trial0 start-c body of
        (trial1, c1, body1) -> case trial1 of
          EscEnv r1 o1 d1 ca1 b1 co1 ->
            if state-id (ctx-state c1) == 27 then (env, c1, False)
            else
              let recursive = has-string ca1 dname in
              let ok = not recursive || ctx-eq assumed c1 in
              if ok then
                let merged = EscEnv raw (Cons (dname, c1) o1) (Cons (dname, body1) (drop-node d1 dname)) (append-strings ca1 called) brks conts in
                (merged, c1, True)
              else (env, c1, False)

  -- ---------------------------------------------------------------------
  -- Context-specific escapers and filters.
  -- ---------------------------------------------------------------------

  -- | Failsafe token emitted in place of unsafe values by filters.
  filter-failsafe :: String
  filter-failsafe = "ZgotmplZ"

  -- | Convert escaper arguments to text and their declared `ContentType`, skipping untyped nil.
  stringify-args :: List HtmlValue -> (String, ContentType)
  stringify-args args = case args of
    Cons x rest -> (case rest of
      Nil -> case x of
        HvTemplate (TvString s) -> (s, CtPlain)
        HvTemplate TvNil -> ("", CtPlain)
        HvSafeHtml s -> (s, CtHtml)
        HvSafeHtmlAttr s -> (s, CtHtmlAttr)
        HvSafeCss s -> (s, CtCss)
        HvSafeJs s -> (s, CtJs)
        HvSafeJsStr s -> (s, CtJsStr)
        HvSafeUrl s -> (s, CtUrl)
        HvSafeSrcset s -> (s, CtSrcset)
        other -> (text-of (sprint-html (Cons x Nil)), CtPlain)
      Cons y more -> (text-of (sprint-html (drop-nils args)), CtPlain))
    Nil -> ("", CtPlain)

  -- | Drop untyped nil values from an argument list for contextual stringification.
  drop-nils :: List HtmlValue -> List HtmlValue
  drop-nils xs = case xs of
    Nil -> Nil
    Cons x rest -> case x of
      HvTemplate TvNil -> drop-nils rest
      other -> Cons x (drop-nils rest)

  -- | Report whether a `ContentType` matches a specific tag.
  ct-id :: ContentType -> Nat
  ct-id t = case t of
    CtPlain -> 0
    CtCss -> 1
    CtHtml -> 2
    CtHtmlAttr -> 3
    CtJs -> 4
    CtJsStr -> 5
    CtUrl -> 6
    CtSrcset -> 7
    CtUnsafe -> 8

  -- | Escape for HTML text nodes (`_html_template_htmlescaper`).
  esc-html :: List HtmlValue -> String
  esc-html args = case stringify-args args of
    (s, ct) -> if ct-id ct == 2 then s else html-replacer s False False True

  -- | Escape for RCDATA element bodies (`_html_template_rcdataescaper`).
  esc-rcdata :: List HtmlValue -> String
  esc-rcdata args = case stringify-args args of
    (s, ct) -> html-replacer s (ct-id ct == 2) False True

  -- | Escape for quoted HTML attribute values (`_html_template_attrescaper`).
  esc-attr :: List HtmlValue -> String
  esc-attr args = case stringify-args args of
    (s, ct) ->
      if ct-id ct == 2 then html-replacer (strip-tags s) True False True
      else html-replacer s False False True

  -- | Escape for unquoted HTML attribute values (`_html_template_nospaceescaper`).
  esc-nospace :: List HtmlValue -> String
  esc-nospace args = case stringify-args args of
    (s, ct) ->
      if s == "" then filter-failsafe
      else if ct-id ct == 2 then html-replacer (strip-tags s) True True False
      else html-replacer s False True False

  -- | Replace HTML specials according to norm (skip `&`), nospace (escape whitespace/`=`/`` ` ``), and allow-bad-runes flags.
  html-replacer :: String -> Bool -> Bool -> Bool -> String
  html-replacer s norm nospace allow-bad =
    let b = string-to-bytes s in
    text-of (bytes-concat (reverse (html-replace-from b 0 norm nospace allow-bad Nil)))

  -- | Scan UTF-8 scalars in `b` and emit HTML replacements.
  html-replace-from :: Bytes -> Nat -> Bool -> Bool -> Bool -> List Bytes -> List Bytes
  html-replace-from b i norm nospace allow-bad acc =
    if i >= bytes-len b then acc
    else
      let rlen = rune-size b i in
      let step = if rlen == 0 then (1 :: Nat) else rlen in
      let r = if rlen == 0 then (65533 :: Nat) else rune-value b i rlen in
      let repl = html-rune-repl r norm nospace allow-bad in
      case repl of
        Some out -> html-replace-from b (i + step) norm nospace allow-bad (Cons out acc)
        None -> html-replace-from b (i + step) norm nospace allow-bad (Cons (slice b i (i + step)) acc)

  -- | Replacement bytes for a single Unicode scalar under HTML escaping rules.
  html-rune-repl :: Nat -> Bool -> Bool -> Bool -> Option Bytes
  html-rune-repl r norm nospace allow-bad =
    if r == 0 then Some (if nospace then string-to-bytes "&#xfffd;" else encode-rune 65533)
    else if r == 34 then Some (string-to-bytes "&#34;")
    else if r == 38 && not norm then Some (string-to-bytes "&amp;")
    else if r == 39 then Some (string-to-bytes "&#39;")
    else if r == 43 then Some (string-to-bytes "&#43;")
    else if r == 60 then Some (string-to-bytes "&lt;")
    else if r == 62 then Some (string-to-bytes "&gt;")
    else if nospace && r == 9 then Some (string-to-bytes "&#9;")
    else if nospace && r == 10 then Some (string-to-bytes "&#10;")
    else if nospace && r == 11 then Some (string-to-bytes "&#11;")
    else if nospace && r == 12 then Some (string-to-bytes "&#12;")
    else if nospace && r == 13 then Some (string-to-bytes "&#13;")
    else if nospace && r == 32 then Some (string-to-bytes "&#32;")
    else if nospace && r == 61 then Some (string-to-bytes "&#61;")
    else if nospace && r == 96 then Some (string-to-bytes "&#96;")
    else if not allow-bad && ((r >= 64976 && r <= 65007) || (r >= 65520 && r <= 65535)) then
      Some (bytes-concat [string-to-bytes "&#x", digits-of r 16 False, string-to-bytes ";"])
    else None

  -- | Strip HTML tags, comments, and raw `<script>`/`<style>` bodies from an HTML snippet, preserving text and RCDATA.
  strip-tags :: String -> String
  strip-tags html =
    let s = string-to-bytes html in
    strip-tags-loop html s (init-ctx ()) 0 True Nil

  -- | Loop for `strip-tags` driven by the HTML context transition machine.
  strip-tags-loop :: String -> Bytes -> EscCtx -> Nat -> Bool -> List Bytes -> String
  strip-tags-loop orig s c i all-text acc =
    if i >= bytes-len s then
      if all-text then orig
      else text-of (bytes-concat (reverse acc))
    else case c of
      EscCtx st dl up jc br ak el err -> case dl of
        DlNone ->
          let eff-st = if not (elem-id el == 0) && not (is-in-tag st) then StRcdata else st in
          case transition-state eff-st c (slice s i (bytes-len s)) of
            (d, nread) ->
              let i1 = i + nread in
              let is-text = state-id st == 0 || state-id st == 6 in
              let next-acc = (
                if is-text then
                  let j = if not (state-id (ctx-state d) == state-id st) then find-tag-open-back s i i1 else i1 in
                  if j > i then Cons (slice s i j) acc else acc
                else acc) in
              let next-all = all-text && is-text in
              if nread == 0 && state-id (ctx-state d) == state-id st then text-of (bytes-concat (reverse next-acc))
              else strip-tags-loop orig s d i1 next-all next-acc
        other ->
          case find-any-byte s (delim-end-bytes dl) i of
            None -> if all-text then orig else text-of (bytes-concat (reverse acc))
            Some end-pos ->
              let next-i = case dl of DlSpaceOrTagEnd -> end-pos; other2 -> end-pos + 1 in
              strip-tags-loop orig s (EscCtx StTag DlNone UpNone JsRegexp Nil AtNone el None) next-i False acc

  -- | Filter HTML attribute names (`_html_template_htmlnamefilter`).
  esc-html-name :: List HtmlValue -> String
  esc-html-name args = case stringify-args args of
    (s, ct) ->
      if ct-id ct == 3 then s
      else if s == "" then filter-failsafe
      else
        let low = text-of (lower-bytes (string-to-bytes s)) in
        if not (ct-id (attr-type low) == 0) then filter-failsafe
        else if all-lower-alnum (string-to-bytes low) 0 then low
        else filter-failsafe

  -- | Report whether every byte is ASCII `0-9` or `a-z`.
  all-lower-alnum :: Bytes -> Nat -> Bool
  all-lower-alnum b i =
    if i >= bytes-len b then True
    else
      let x = at b i in
      if (x >= 48 && x <= 57) || (x >= 97 && x <= 122) then all-lower-alnum b (i + 1)
      else False

  -- | Drop interpolated content inside comments (`_html_template_commentescaper`).
  esc-comment :: List HtmlValue -> String
  esc-comment args = ""

  -- | Filter URL schemes (`_html_template_urlfilter`), allowing `http:`, `https:`, `mailto:`, and relative URLs.
  esc-url-filter :: List HtmlValue -> String
  esc-url-filter args = case stringify-args args of
    (s, ct) ->
      if ct-id ct == 6 then s
      else if is-safe-url (string-to-bytes s) then s
      else string-concat "#" filter-failsafe

  -- | Report whether a URL has no scheme or has an allowed scheme (`http`, `https`, `mailto`).
  is-safe-url :: Bytes -> Bool
  is-safe-url b = case find-byte b 58 0 of
    None -> True
    Some k ->
      let proto = slice b 0 k in
      if has-byte proto 47 0 then True
      else
        let low = text-of (lower-bytes proto) in
        low == "http" || low == "https" || low == "mailto"

  -- | Normalize a URL substring (`_html_template_urlnormalizer`).
  esc-url-normalizer :: List HtmlValue -> String
  esc-url-normalizer args = url-processor True args

  -- | Escape a URL query or fragment value (`_html_template_urlescaper`).
  esc-url-escaper :: List HtmlValue -> String
  esc-url-escaper args = url-processor False args

  -- | Normalize or percent-encode URL bytes, switching to normalization for trusted `HvSafeUrl`.
  url-processor :: Bool -> List HtmlValue -> String
  url-processor norm args = case stringify-args args of
    (s, ct) -> text-of (process-url-bytes (string-to-bytes s) (norm || ct-id ct == 6))

  -- | Percent-encode URL bytes with lowercase `%xx`.
  process-url-bytes :: Bytes -> Bool -> Bytes
  process-url-bytes b norm = bytes-concat (reverse (process-url-from b 0 norm Nil))

  -- | Scan URL bytes from `i`, preserving unreserved (and reserved when `norm` is true) characters.
  process-url-from :: Bytes -> Nat -> Bool -> List Bytes -> List Bytes
  process-url-from b i norm acc =
    if i >= bytes-len b then acc
    else
      let c = at b i in
      let keep = (
        (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57)
          || c == 45 || c == 46 || c == 95 || c == 126
          || (norm && is-url-norm-char c)
          || (norm && c == 37 && i + 2 < bytes-len b && is-hex (at b (i + 1)) && is-hex (at b (i + 2)))) in
      if keep then process-url-from b (i + 1) norm (Cons (slice b i (i + 1)) acc)
      else process-url-from b (i + 1) norm (Cons (bytes-concat [string-to-bytes "%", pad-left-zeros (digits-of c 16 False) 2]) acc)

  -- | Report whether a byte is a reserved URL character preserved during URL normalization.
  is-url-norm-char :: Nat -> Bool
  is-url-norm-char c =
    c == 33 || c == 35 || c == 36 || c == 38 || c == 42 || c == 43 || c == 44 || c == 47
      || c == 58 || c == 59 || c == 61 || c == 63 || c == 64 || c == 91 || c == 93

  -- | Filter and escape a `srcset` attribute value (`_html_template_srcsetescaper`).
  esc-srcset :: List HtmlValue -> String
  esc-srcset args = case stringify-args args of
    (s, ct) ->
      if ct-id ct == 7 then s
      else if ct-id ct == 6 then text-of (replace-byte (process-url-bytes (string-to-bytes s) True) 44 (string-to-bytes "%2c"))
      else text-of (bytes-concat (reverse (filter-srcset-from (string-to-bytes s) 0 Nil)))

  -- | Split `srcset` bytes on `,` and filter each candidate entry.
  filter-srcset-from :: Bytes -> Nat -> List Bytes -> List Bytes
  filter-srcset-from b left acc = case find-byte b 44 left of
    None -> Cons (filter-srcset-element b left (bytes-len b)) acc
    Some k -> filter-srcset-from b (k + 1) (Cons (string-to-bytes ",") (Cons (filter-srcset-element b left k) acc))

  -- | Filter a single comma-delimited `srcset` candidate (URL plus optional descriptor).
  filter-srcset-element :: Bytes -> Nat -> Nat -> Bytes
  filter-srcset-element b left right =
    let start = skip-html-ws-bounded b left right in
    let end = find-html-ws-bounded b start right in
    let url = slice b start end in
    if is-safe-url url && all-html-ws-or-alnum b end right then
      bytes-concat [slice b left start, process-url-bytes url True, slice b end right]
    else string-to-bytes (string-concat "#" filter-failsafe)

  -- | Advance past HTML whitespace within `[i, right)`.
  skip-html-ws-bounded :: Bytes -> Nat -> Nat -> Nat
  skip-html-ws-bounded b i right = if i < right && is-html-ws (at b i) then skip-html-ws-bounded b (i + 1) right else i

  -- | Find the first HTML whitespace byte within `[i, right)`.
  find-html-ws-bounded :: Bytes -> Nat -> Nat -> Nat
  find-html-ws-bounded b i right = if i < right && not (is-html-ws (at b i)) then find-html-ws-bounded b (i + 1) right else i

  -- | Report whether every byte in `[i, right)` is HTML whitespace or ASCII alphanumeric.
  all-html-ws-or-alnum :: Bytes -> Nat -> Nat -> Bool
  all-html-ws-or-alnum b i right =
    if i >= right then True
    else if is-html-ws (at b i) || is-ascii-alnum (at b i) then all-html-ws-or-alnum b (i + 1) right
    else False

  -- | Replace every occurrence of byte `needle` with `repl`.
  replace-byte :: Bytes -> Nat -> Bytes -> Bytes
  replace-byte b needle repl = bytes-concat (reverse (replace-byte-from b 0 needle repl Nil))

  -- | Loop replacing `needle` bytes from offset `i`.
  replace-byte-from :: Bytes -> Nat -> Nat -> Bytes -> List Bytes -> List Bytes
  replace-byte-from b i needle repl acc = case find-byte b needle i of
    None -> Cons (slice b i (bytes-len b)) acc
    Some k -> replace-byte-from b (k + 1) needle repl (Cons repl (Cons (slice b i k) acc))

  -- | Escape a value as a safe JavaScript expression (`_html_template_jsvalescaper`).
  esc-js-val :: List HtmlValue -> String
  esc-js-val args = case args of
    Cons x rest -> (case rest of
      Nil -> case x of
        HvSafeJs s -> s
        HvSafeJsStr s -> string-concat-all ["\"", s, "\""]
        other -> encode-js-json x
      Cons y more -> encode-js-json (HvTemplate (TvString (text-of (sprint-html args)))))
    Nil -> " \"\" "

  -- | Marshal an `HtmlValue` to JS-safe JSON, adding space padding when first or last byte is a JS identifier part.
  encode-js-json :: HtmlValue -> String
  encode-js-json v = case json-encode-value v of
    Err msg -> string-concat-all [" /* ", sanitize-js-comment-err msg, " */null "]
    Ok raw ->
      if bytes-len raw == 0 then " null "
      else
        let pad = is-js-ident-part (at raw 0) || is-js-ident-part (at raw (minus (bytes-len raw) 1)) in
        if pad then text-of (bytes-concat [string-to-bytes " ", raw, string-to-bytes " "])
        else text-of raw

  -- | Neutralize `*/`, `<!--`, `<script`, and `</script` inside a JSON error comment.
  sanitize-js-comment-err :: String -> String
  sanitize-js-comment-err s =
    text-of (replace-bytes-seq (escape-special-script-tags (string-to-bytes s)) (string-to-bytes "*/") (string-to-bytes "* /"))

  -- | Replace all occurrences of `needle` with `repl`.
  replace-bytes-seq :: Bytes -> Bytes -> Bytes -> Bytes
  replace-bytes-seq s needle repl = bytes-concat (reverse (replace-seq-from s 0 needle repl Nil))

  -- | Loop replacing `needle` from offset `i`.
  replace-seq-from :: Bytes -> Nat -> Bytes -> Bytes -> List Bytes -> List Bytes
  replace-seq-from s i needle repl acc = case find-bytes s needle i of
    None -> Cons (slice s i (bytes-len s)) acc
    Some k -> replace-seq-from s (k + bytes-len needle) needle repl (Cons repl (Cons (slice s i k) acc))

  -- | Encode an `HtmlValue` as HTML-safe JSON bytes (`<`, `>`, `&`, U+2028, U+2029 escaped).
  json-encode-value :: HtmlValue -> Result String Bytes
  json-encode-value v = case v of
    HvTemplate tv -> json-encode-tv tv
    HvSafeHtml s -> Ok (json-encode-str (string-to-bytes s))
    HvSafeHtmlAttr s -> Ok (json-encode-str (string-to-bytes s))
    HvSafeCss s -> Ok (json-encode-str (string-to-bytes s))
    HvSafeJs s -> Ok (json-encode-str (string-to-bytes s))
    HvSafeJsStr s -> Ok (json-encode-str (string-to-bytes s))
    HvSafeUrl s -> Ok (json-encode-str (string-to-bytes s))
    HvSafeSrcset s -> Ok (json-encode-str (string-to-bytes s))
    HvList x rest -> json-encode-hlist v Nil
    HvListEnd -> Ok (string-to-bytes "[]")
    HvMap k x rest -> json-encode-hmap v Nil
    HvMapEnd -> Ok (string-to-bytes "{}")

  -- | Encode a `TemplateValue` as HTML-safe JSON bytes.
  json-encode-tv :: TemplateValue -> Result String Bytes
  json-encode-tv tv = case tv of
    TvNil -> Ok (string-to-bytes "null")
    TvBool b -> Ok (string-to-bytes (if b then "true" else "false"))
    TvInt n -> Ok (string-to-bytes (int-to-string n))
    TvFloat f ->
      let txt = template-sprintf "%v" [TvFloat f] in
      let s = text-of txt in
      if s == "NaN" || s == "+Inf" || s == "-Inf" then Err (string-concat "json: unsupported value: " s)
      else Ok txt
    TvString s -> Ok (json-encode-str (string-to-bytes s))
    TvList x rest -> json-encode-tvlist tv Nil
    TvListEnd -> Ok (string-to-bytes "[]")
    TvMap k x rest -> json-encode-tvmap tv Nil
    TvMapEnd -> Ok (string-to-bytes "{}")

  -- | Encode an `HvList` spine as a JSON array.
  json-encode-hlist :: HtmlValue -> List Bytes -> Result String Bytes
  json-encode-hlist v acc = case v of
    HvList x rest -> case json-encode-value x of
      Err e -> Err e
      Ok item -> json-encode-hlist rest (Cons item acc)
    other -> Ok (bytes-concat [string-to-bytes "[", bytes-join (reverse acc) (string-to-bytes ","), string-to-bytes "]"])

  -- | Encode a `TvList` spine as a JSON array.
  json-encode-tvlist :: TemplateValue -> List Bytes -> Result String Bytes
  json-encode-tvlist v acc = case v of
    TvList x rest -> case json-encode-tv x of
      Err e -> Err e
      Ok item -> json-encode-tvlist rest (Cons item acc)
    other -> Ok (bytes-concat [string-to-bytes "[", bytes-join (reverse acc) (string-to-bytes ","), string-to-bytes "]"])

  -- | Encode a sorted `HvMap` spine as a JSON object.
  json-encode-hmap :: HtmlValue -> List Bytes -> Result String Bytes
  json-encode-hmap v acc = case v of
    HvMap k x rest -> case json-encode-value x of
      Err e -> Err e
      Ok val -> json-encode-hmap rest (Cons (bytes-concat [json-encode-str (string-to-bytes k), string-to-bytes ":", val]) acc)
    other -> Ok (bytes-concat [string-to-bytes "{", bytes-join (reverse acc) (string-to-bytes ","), string-to-bytes "}"])

  -- | Encode a sorted `TvMap` spine as a JSON object.
  json-encode-tvmap :: TemplateValue -> List Bytes -> Result String Bytes
  json-encode-tvmap v acc = case v of
    TvMap k x rest -> case json-encode-tv x of
      Err e -> Err e
      Ok val -> json-encode-tvmap rest (Cons (bytes-concat [json-encode-str (string-to-bytes k), string-to-bytes ":", val]) acc)
    other -> Ok (bytes-concat [string-to-bytes "{", bytes-join (reverse acc) (string-to-bytes ","), string-to-bytes "}"])

  -- | Encode UTF-8 bytes as a double-quoted JSON string with `<`, `>`, `&`, U+2028, and U+2029 escaped.
  json-encode-str :: Bytes -> Bytes
  json-encode-str b = bytes-concat [string-to-bytes "\"", bytes-concat (reverse (json-str-from b 0 Nil)), string-to-bytes "\""]

  -- | Scan UTF-8 scalars for JSON string encoding.
  json-str-from :: Bytes -> Nat -> List Bytes -> List Bytes
  json-str-from b i acc =
    if i >= bytes-len b then acc
    else
      let rlen = rune-size b i in
      if rlen == 0 then json-str-from b (i + 1) (Cons (string-to-bytes "\\ufffd") acc)
      else
        let r = rune-value b i rlen in
        let piece = (
          if r == 34 then string-to-bytes "\\\""
          else if r == 92 then string-to-bytes "\\\\"
          else if r == 10 then string-to-bytes "\\n"
          else if r == 13 then string-to-bytes "\\r"
          else if r == 9 then string-to-bytes "\\t"
          else if r == 60 then string-to-bytes "\\u003c"
          else if r == 62 then string-to-bytes "\\u003e"
          else if r == 38 then string-to-bytes "\\u0026"
          else if r == 8232 then string-to-bytes "\\u2028"
          else if r == 8233 then string-to-bytes "\\u2029"
          else if r < 32 then bytes-concat [string-to-bytes "\\u00", pad-left-zeros (digits-of r 16 False) 2]
          else slice b i (i + rlen)) in
        json-str-from b (i + rlen) (Cons piece acc)

  -- | Escape for JavaScript quoted string literals (`_html_template_jsstrescaper`).
  esc-js-str :: List HtmlValue -> String
  esc-js-str args = case stringify-args args of
    (s, ct) -> js-replace-str s (if ct-id ct == 5 then (1 :: Nat) else 0)

  -- | Escape for JavaScript template literals (`_html_template_jstmpllitescaper`).
  esc-js-tmpl :: List HtmlValue -> String
  esc-js-tmpl args = case stringify-args args of
    (s, ct) -> js-replace-str s 2

  -- | Escape for JavaScript regular expression literals (`_html_template_jsregexpescaper`).
  esc-js-regexp :: List HtmlValue -> String
  esc-js-regexp args = case stringify-args args of
    (s, ct) ->
      let out = js-replace-str s 3 in
      if out == "" then "(?:)" else out

  -- | Apply JavaScript string/template/regexp replacement table (mode: 0=str, 1=normStr, 2=tmplLit, 3=regexp).
  js-replace-str :: String -> Nat -> String
  js-replace-str s mode = text-of (bytes-concat (reverse (js-replace-from (string-to-bytes s) 0 mode Nil)))

  -- | Scan UTF-8 scalars in `b` and emit JS string/regexp escapes.
  js-replace-from :: Bytes -> Nat -> Nat -> List Bytes -> List Bytes
  js-replace-from b i mode acc =
    if i >= bytes-len b then acc
    else
      let rlen = rune-size b i in
      let step = if rlen == 0 then (1 :: Nat) else rlen in
      let r = if rlen == 0 then (65533 :: Nat) else rune-value b i rlen in
      case js-rune-repl r mode of
        Some out -> js-replace-from b (i + step) mode (Cons out acc)
        None -> js-replace-from b (i + step) mode (Cons (slice b i (i + step)) acc)

  -- | Replacement bytes for a scalar in JS string/template/regexp mode.
  js-rune-repl :: Nat -> Nat -> Option Bytes
  js-rune-repl r mode =
    if r < 32 then Some (js-low-unicode r)
    else if r == 8232 then Some (string-to-bytes "\\u2028")
    else if r == 8233 then Some (string-to-bytes "\\u2029")
    else if r == 34 then Some (string-to-bytes "\\u0022")
    else if r == 38 then Some (string-to-bytes "\\u0026")
    else if r == 39 then Some (string-to-bytes "\\u0027")
    else if r == 43 then Some (string-to-bytes "\\u002b")
    else if r == 47 then Some (string-to-bytes "\\/")
    else if r == 60 then Some (string-to-bytes "\\u003c")
    else if r == 62 then Some (string-to-bytes "\\u003e")
    else if r == 92 && not (mode == 1) then Some (string-to-bytes "\\\\")
    else if r == 96 && not (mode == 3) then Some (string-to-bytes "\\u0060")
    else if mode == 2 && r == 36 then Some (string-to-bytes "\\u0024")
    else if mode == 2 && r == 123 then Some (string-to-bytes "\\u007b")
    else if mode == 2 && r == 125 then Some (string-to-bytes "\\u007d")
    else if mode == 3 && (r == 36 || r == 40 || r == 41 || r == 42 || r == 45 || r == 46 || r == 63 || r == 91 || r == 93 || r == 94 || r == 123 || r == 124 || r == 125) then
      Some (from-list [92, r])
    else None

  -- | Escape an ASCII control code (`0x00..0x1f`) for JS literals.
  js-low-unicode :: Nat -> Bytes
  js-low-unicode r =
    if r == 9 then string-to-bytes "\\t"
    else if r == 10 then string-to-bytes "\\n"
    else if r == 12 then string-to-bytes "\\f"
    else if r == 13 then string-to-bytes "\\r"
    else bytes-concat [string-to-bytes "\\u00", pad-left-zeros (digits-of r 16 False) 2]

  -- | Escape HTML and CSS special characters using `\hex` escapes (`_html_template_cssescaper`).
  esc-css-str :: List HtmlValue -> String
  esc-css-str args = case stringify-args args of
    (s, ct) -> text-of (bytes-concat (reverse (css-esc-from (string-to-bytes s) 0 Nil)))

  -- | Scan UTF-8 scalars for CSS string escaping, appending a space after hex escapes when required.
  css-esc-from :: Bytes -> Nat -> List Bytes -> List Bytes
  css-esc-from b i acc =
    if i >= bytes-len b then acc
    else
      let rlen = rune-size b i in
      let step = if rlen == 0 then (1 :: Nat) else rlen in
      let r = if rlen == 0 then (65533 :: Nat) else rune-value b i rlen in
      case css-rune-repl r of
        None -> css-esc-from b (i + step) (Cons (slice b i (i + step)) acc)
        Some repl ->
          let next-i = i + step in
          let need-space = not (r == 92) && (next-i >= bytes-len b || is-hex (at b next-i) || is-html-ws (at b next-i)) in
          let piece = if need-space then bytes-concat [repl, string-to-bytes " "] else repl in
          css-esc-from b next-i (Cons piece acc)

  -- | CSS hex escape sequence for special characters.
  css-rune-repl :: Nat -> Option Bytes
  css-rune-repl r =
    if r == 0 then Some (string-to-bytes "\\0")
    else if r == 9 then Some (string-to-bytes "\\9")
    else if r == 10 then Some (string-to-bytes "\\a")
    else if r == 12 then Some (string-to-bytes "\\c")
    else if r == 13 then Some (string-to-bytes "\\d")
    else if r == 34 then Some (string-to-bytes "\\22")
    else if r == 38 then Some (string-to-bytes "\\26")
    else if r == 39 then Some (string-to-bytes "\\27")
    else if r == 40 then Some (string-to-bytes "\\28")
    else if r == 41 then Some (string-to-bytes "\\29")
    else if r == 43 then Some (string-to-bytes "\\2b")
    else if r == 47 then Some (string-to-bytes "\\2f")
    else if r == 58 then Some (string-to-bytes "\\3a")
    else if r == 59 then Some (string-to-bytes "\\3b")
    else if r == 60 then Some (string-to-bytes "\\3c")
    else if r == 62 then Some (string-to-bytes "\\3e")
    else if r == 92 then Some (string-to-bytes "\\\\")
    else if r == 123 then Some (string-to-bytes "\\7b")
    else if r == 125 then Some (string-to-bytes "\\7d")
    else None

  -- | Filter CSS property values (`_html_template_cssvaluefilter`), allowing safe values and rejecting injection vectors.
  esc-css-value :: List HtmlValue -> String
  esc-css-value args = case stringify-args args of
    (s, ct) ->
      if ct-id ct == 1 then s
      else
        let decoded = decode-css (string-to-bytes s) in
        case check-css-value decoded 0 Nil of
          None -> filter-failsafe
          Some id-bytes ->
            let low-id = lower-bytes (from-list id-bytes) in
            if contains-bytes low-id (string-to-bytes "expression") || contains-bytes low-id (string-to-bytes "mozbinding") then
              filter-failsafe
            else text-of decoded

  -- | Validate decoded CSS value bytes and collect ASCII identifier characters for blocklist scanning.
  check-css-value :: Bytes -> Nat -> List Nat -> Option (List Nat)
  check-css-value b i id-acc =
    if i >= bytes-len b then Some (reverse id-acc)
    else
      let c = at b i in
      if c == 0 || c == 34 || c == 39 || c == 40 || c == 41 || c == 47 || c == 59 || c == 64
        || c == 91 || c == 92 || c == 93 || c == 96 || c == 123 || c == 125 || c == 60 || c == 62 then None
      else if c == 45 && i > 0 && at b (i - 1) == 45 then None
      else if c < 128 && is-css-nmchar c then check-css-value b (i + 1) (Cons c id-acc)
      else check-css-value b (i + 1) id-acc

  -- | Format arguments for rewritten predefined escaper calls (`_eval_args_`).
  esc-eval-args :: List HtmlValue -> String
  esc-eval-args args = case args of
    Cons (HvTemplate (TvString s)) Nil -> s
    other -> text-of (sprint-html args)

  -- ---------------------------------------------------------------------
  -- Runtime execution.
  -- ---------------------------------------------------------------------

  -- | Runtime execution context: escaped templates, custom functions, missing-key mode, current name, and recursion depth.
  data ExecCtx where
    -- | Fields in the order listed above.
    ExecCtx :: List (String, Node) -> List (String, HtmlTemplateFunction) -> MissingKey -> String -> Nat -> ExecCtx

  -- | Control flow outcome after executing a node list.
  data Flow where
    -- | Normal completion.
    FlowNext :: Flow
    -- | `{{break}}` exited the innermost `range`.
    FlowBreak :: Flow
    -- | `{{continue}}` ended the current `range` iteration.
    FlowContinue :: Flow

  -- | Execution result: reversed output chunks, active variable bindings, and control flow.
  data Run where
    -- | Output chunks (reversed), variable bindings (innermost first), and flow state.
    Run :: List Bytes -> List (String, HtmlValue) -> Flow -> Run

  -- | Report whether control flow continues sequentially.
  is-flow-next :: Flow -> Bool
  is-flow-next f = case f of FlowNext -> True; other -> False

  -- | Execute an escaped node spine with cursor `dot`, output accumulator, and variable stack.
  exec-nodes :: ExecCtx -> Node -> HtmlValue -> List Bytes -> List (String, HtmlValue) -> Result String Run
  exec-nodes ctx node dot out vars = case node of
    NdEnd -> Ok (Run out vars FlowNext)
    NdText b next -> exec-nodes ctx next dot (Cons b out) vars
    NdAction p next -> (case eval-pipe ctx p dot vars of
      Err e -> Err e
      Ok (v, vars2) -> exec-nodes ctx next dot (if declares p then out else Cons (print-html-value v) out) vars2)
    NdIf p body alt next -> (case eval-pipe ctx p dot vars of
      Err e -> Err e
      Ok (v, vars2) -> scoped ctx next dot vars (exec-nodes ctx (if html-is-true v then body else alt) dot out vars2))
    NdWith p body alt next -> (case eval-pipe ctx p dot vars of
      Err e -> Err e
      Ok (v, vars2) -> scoped ctx next dot vars (if html-is-true v then exec-nodes ctx body v out vars2 else exec-nodes ctx alt dot out vars2))
    NdRange p body alt next -> (case eval-pipe-value ctx p dot vars of
      Err e -> Err e
      Ok v -> scoped ctx next dot vars (range-over ctx p body alt dot v out vars))
    NdTemplate name p next -> (case call-template ctx name p dot vars of
      Err e -> Err e
      Ok pieces -> exec-nodes ctx next dot (append-bytes pieces out) vars)
    NdBreak next -> Ok (Run out vars FlowBreak)
    NdContinue next -> Ok (Run out vars FlowContinue)

  -- | Restore variable scope after a nested block while preserving outer assignments and loop flow.
  scoped :: ExecCtx -> Node -> HtmlValue -> List (String, HtmlValue) -> Result String Run -> Result String Run
  scoped ctx next dot vars result = case result of
    Err e -> Err e
    Ok run -> case run of
      Run out2 vars2 flow ->
        let kept = pop-to vars2 (list-length vars) in
        if is-flow-next flow then exec-nodes ctx next dot out2 kept else Ok (Run out2 kept flow)

  -- | Pop inner variable bindings down to `n` entries.
  pop-to :: List (String, HtmlValue) -> Nat -> List (String, HtmlValue)
  pop-to vars n = if list-length vars <= n then vars else case vars of Nil -> Nil; Cons v rest -> pop-to rest n

  -- | Append reversed inner output chunks onto the outer reversed accumulator.
  append-bytes :: List Bytes -> List Bytes -> List Bytes
  append-bytes inner out = append-bytes-in (reverse inner) out

  -- | Push chunks in order onto a reversed output accumulator.
  append-bytes-in :: List Bytes -> List Bytes -> List Bytes
  append-bytes-in pieces out = case pieces of Nil -> out; Cons b rest -> append-bytes-in rest (Cons b out)

  -- | Report whether a pipeline declares or assigns variables.
  declares :: Expr -> Bool
  declares p = case p of ExPipe decls assign cmds -> list-length decls > 0; other -> False

  -- | Execute an associated (possibly context-mangled) template.
  call-template :: ExecCtx -> String -> Expr -> HtmlValue -> List (String, HtmlValue) -> Result String (List Bytes)
  call-template ctx name p dot vars = case ctx of
    ExecCtx ts fs mk current depth -> case lookup-node ts name of
      None -> Err (string-concat-all ["no such template \"", name, "\""])
      Some root ->
        if depth >= 10000 then Err "exceeded maximum template depth (10000)"
        else
          let value = case p of ExCmdEnd -> Ok (HvTemplate TvNil); other -> eval-pipe-value ctx p dot vars in
          case value of
            Err e -> Err e
            Ok v -> case exec-nodes (ExecCtx ts fs mk name (depth + 1)) root v Nil (Cons ("$", v) Nil) of
              Err e -> Err e
              Ok run -> case run of Run inner vars2 flow -> Ok inner

  -- | Iterate over lists, maps (in sorted key order), or positive integers in `range`.
  range-over :: ExecCtx -> Expr -> Node -> Node -> HtmlValue -> HtmlValue -> List Bytes -> List (String, HtmlValue) -> Result String Run
  range-over ctx p body alt dot v out vars = case v of
    HvList x rest -> iterate-range ctx p body (h-items v 0 Nil) out vars
    HvMap k x rest -> iterate-range ctx p body (h-items v 0 Nil) out vars
    HvListEnd -> exec-nodes ctx alt dot out vars
    HvMapEnd -> exec-nodes ctx alt dot out vars
    HvTemplate tv -> case tv of
      TvList x rest -> iterate-range ctx p body (tv-items tv 0 Nil) out vars
      TvMap k x rest -> iterate-range ctx p body (tv-items tv 0 Nil) out vars
      TvInt n ->
        if n <= 0 then exec-nodes ctx alt dot out vars
        else if list-length (decl-names p) > 1 then Err (string-concat-all ["can't use ", int-to-string n, " to iterate over more than one variable"])
        else iterate-range ctx p body (counting 0 n Nil) out vars
      TvListEnd -> exec-nodes ctx alt dot out vars
      TvMapEnd -> exec-nodes ctx alt dot out vars
      TvNil -> exec-nodes ctx alt dot out vars
      other -> Err (string-concat "range can't iterate over " (sprint-one-html v))
    other -> Err (string-concat "range can't iterate over " (sprint-one-html v))

  -- | Extract `(index/key, element)` pairs from an `HvList` or `HvMap`.
  h-items :: HtmlValue -> Nat -> List (HtmlValue, HtmlValue) -> List (HtmlValue, HtmlValue)
  h-items v i acc = case v of
    HvList x rest -> h-items rest (i + 1) (Cons (HvTemplate (TvInt (nat-to-int i)), x) acc)
    HvMap k x rest -> h-items rest (i + 1) (Cons (HvTemplate (TvString k), x) acc)
    other -> reverse acc

  -- | Extract `(index/key, element)` pairs from a `TvList` or `TvMap`.
  tv-items :: TemplateValue -> Nat -> List (HtmlValue, HtmlValue) -> List (HtmlValue, HtmlValue)
  tv-items v i acc = case v of
    TvList x rest -> tv-items rest (i + 1) (Cons (HvTemplate (TvInt (nat-to-int i)), HvTemplate x) acc)
    TvMap k x rest -> tv-items rest (i + 1) (Cons (HvTemplate (TvString k), HvTemplate x) acc)
    other -> reverse acc

  -- | Build `(i, i)` integer pairs for `0 <= i < n`.
  counting :: Int -> Int -> List (HtmlValue, HtmlValue) -> List (HtmlValue, HtmlValue)
  counting i n acc = if i >= n then reverse acc else counting (int-add i 1) n (Cons (HvTemplate (TvInt i), HvTemplate (TvInt i)) acc)

  -- | Extract declared variable names from a pipeline.
  decl-names :: Expr -> List String
  decl-names p = case p of ExPipe decls assign cmds -> decls; other -> Nil

  -- | Report whether a pipeline assigns rather than declares variables.
  is-assign :: Expr -> Bool
  is-assign p = case p of ExPipe decls assign cmds -> assign; other -> False

  -- | Execute a `range` loop body across `(index, element)` pairs.
  iterate-range :: ExecCtx -> Expr -> Node -> List (HtmlValue, HtmlValue) -> List Bytes -> List (String, HtmlValue) -> Result String Run
  iterate-range ctx p body pairs out vars = case pairs of
    Nil -> Ok (Run out vars FlowNext)
    Cons pair rest -> case pair of
      (index, elem) -> case bind-range p index elem vars of
        Err e -> Err e
        Ok bound -> case exec-nodes ctx body elem out bound of
          Err e -> Err e
          Ok run -> case run of
            Run out2 vars2 flow ->
              let kept = pop-to vars2 (list-length vars) in
              case flow of
                FlowBreak -> Ok (Run out2 kept FlowNext)
                other -> iterate-range ctx p body rest out2 kept

  -- | Bind one or two `range` iteration variables.
  bind-range :: Expr -> HtmlValue -> HtmlValue -> List (String, HtmlValue) -> Result String (List (String, HtmlValue))
  bind-range p index elem vars = case decl-names p of
    Nil -> Ok vars
    Cons first rest -> case rest of
      Nil -> if is-assign p then set-var vars first elem else Ok (Cons (first, elem) vars)
      Cons second more -> if is-assign p then (case set-var vars first index of Err e -> Err e; Ok v2 -> set-var v2 second elem) else Ok (Cons (second, elem) (Cons (first, index) vars))

  -- | Update an existing variable binding in scope.
  set-var :: List (String, HtmlValue) -> String -> HtmlValue -> Result String (List (String, HtmlValue))
  set-var vars name value = case vars of
    Nil -> Err (string-concat "undefined variable: " name)
    Cons v rest -> case v of
      (n, old) -> if n == name then Ok (Cons (n, value) rest) else (case set-var rest name value of Err e -> Err e; Ok r -> Ok (Cons v r))

  -- | Look up a variable binding in scope.
  get-var :: List (String, HtmlValue) -> String -> Result String HtmlValue
  get-var vars name = case vars of
    Nil -> Err (string-concat "undefined variable: " name)
    Cons v rest -> case v of (n, value) -> if n == name then Ok value else get-var rest name

  -- | Evaluate a pipeline and apply its variable declarations or assignments.
  eval-pipe :: ExecCtx -> Expr -> HtmlValue -> List (String, HtmlValue) -> Result String (HtmlValue, List (String, HtmlValue))
  eval-pipe ctx p dot vars = case eval-pipe-value ctx p dot vars of
    Err e -> Err e
    Ok v -> case p of
      ExPipe decls assign cmds -> (case bind-all decls assign v vars of Err e -> Err e; Ok vars2 -> Ok (v, vars2))
      other -> Ok (v, vars)

  -- | Bind each variable in `decls` to `v`.
  bind-all :: List String -> Bool -> HtmlValue -> List (String, HtmlValue) -> Result String (List (String, HtmlValue))
  bind-all decls assign v vars = case decls of
    Nil -> Ok vars
    Cons d rest -> if assign then (case set-var vars d v of Err e -> Err e; Ok vars2 -> bind-all rest assign v vars2) else bind-all rest assign v (Cons (d, v) vars)

  -- | Evaluate a pipeline's commands left-to-right, threading each output as the next stage's last argument.
  eval-pipe-value :: ExecCtx -> Expr -> HtmlValue -> List (String, HtmlValue) -> Result String HtmlValue
  eval-pipe-value ctx p dot vars = case p of
    ExPipe decls assign cmds -> eval-cmds ctx cmds dot vars None
    other -> eval-arg ctx p dot vars

  -- | Fold command evaluation across a command spine.
  eval-cmds :: ExecCtx -> Expr -> HtmlValue -> List (String, HtmlValue) -> Option HtmlValue -> Result String HtmlValue
  eval-cmds ctx cmds dot vars final = case cmds of
    ExCmd cmd rest -> (case eval-command ctx cmd dot vars final of Err e -> Err e; Ok v -> eval-cmds ctx rest dot vars (Some v))
    other -> case final of Some v -> Ok v; None -> Ok (HvTemplate TvNil)

  -- | Convert an operand spine to a list.
  operands :: Expr -> List Expr
  operands e = case e of ExArg x rest -> Cons x (operands rest); other -> Nil

  -- | Evaluate one pipeline command.
  eval-command :: ExecCtx -> Expr -> HtmlValue -> List (String, HtmlValue) -> Option HtmlValue -> Result String HtmlValue
  eval-command ctx cmd dot vars final = case operands cmd of
    Nil -> Err "empty command"
    Cons head args -> case head of
      ExFunc name -> call-func ctx name args final dot vars
      ExNil -> Err "nil is not a command"
      other ->
        if list-length args > 0 || is-some-hv final then Err (string-concat "can't give argument to non-function " (describe-expr head))
        else eval-arg ctx head dot vars

  -- | Report whether an `Option HtmlValue` holds a value.
  is-some-hv :: Option HtmlValue -> Bool
  is-some-hv o = case o of Some v -> True; None -> False

  -- | Render an operand description for error messages.
  describe-expr :: Expr -> String
  describe-expr e = case e of
    ExDot -> "."
    ExField fs -> string-concat "." (join-names fs)
    ExVar v fs -> if list-length fs == 0 then v else string-concat-all [v, ".", join-names fs]
    ExConst v -> sprint-one-html v
    other -> "value"

  -- | Join field names with `.`.
  join-names :: List String -> String
  join-names fs = case fs of Nil -> ""; Cons f rest -> case rest of Nil -> f; Cons g more -> string-concat-all [f, ".", join-names rest]

  -- | Evaluate a single operand expression.
  eval-arg :: ExecCtx -> Expr -> HtmlValue -> List (String, HtmlValue) -> Result String HtmlValue
  eval-arg ctx e dot vars = case e of
    ExDot -> Ok dot
    ExNil -> Ok (HvTemplate TvNil)
    ExConst v -> Ok v
    ExField fs -> eval-fields ctx dot fs
    ExVar v fs -> (case get-var vars v of Err err -> Err err; Ok value -> eval-fields ctx value fs)
    ExFunc name -> call-func ctx name Nil None dot vars
    ExChain p fs -> (case eval-arg ctx p dot vars of Err err -> Err err; Ok value -> eval-fields ctx value fs)
    ExPipe decls assign cmds -> eval-cmds ctx cmds dot vars None
    other -> Err "unexpected operand"

  -- | Follow a chain of `.field` lookups.
  eval-fields :: ExecCtx -> HtmlValue -> List String -> Result String HtmlValue
  eval-fields ctx v fs = case fs of
    Nil -> Ok v
    Cons f rest -> case eval-field ctx v f of Err e -> Err e; Ok next -> eval-fields ctx next rest

  -- | Look up a single map field according to the active `MissingKey` mode.
  eval-field :: ExecCtx -> HtmlValue -> String -> Result String HtmlValue
  eval-field ctx v name = case ctx of
    ExecCtx ts fs mk current depth -> case v of
      HvMap k x rest -> (case hmap-get v name of
        Some found -> Ok found
        None -> missing-key-result mk name False)
      HvMapEnd -> missing-key-result mk name False
      HvTemplate tv -> case tv of
        TvMap k x rest -> (case tvmap-get tv name of
          Some found -> Ok (HvTemplate found)
          None -> missing-key-result mk name False)
        TvMapEnd -> missing-key-result mk name False
        TvNil -> missing-key-result mk name True
        other -> Err (string-concat-all ["can't evaluate field ", name, " in type ", html-type-name v])
      other -> Err (string-concat-all ["can't evaluate field ", name, " in type ", html-type-name v])

  -- | Handle a missing map entry or nil data lookup according to `MissingKey`.
  missing-key-result :: MissingKey -> String -> Bool -> Result String HtmlValue
  missing-key-result mk name is-nil = case mk of
    MissingKeyError -> Err (string-concat-all [if is-nil then "nil data; no entry for key \"" else "map has no entry for key \"", name, "\""])
    other -> Ok (HvTemplate TvNil)

  -- | Look up a key in an `HvMap` spine.
  hmap-get :: HtmlValue -> String -> Option HtmlValue
  hmap-get m k = case m of HvMap key value rest -> if key == k then Some value else hmap-get rest k; other -> None

  -- | Look up a key in a `TvMap` spine.
  tvmap-get :: TemplateValue -> String -> Option TemplateValue
  tvmap-get m k = case m of TvMap key value rest -> if key == k then Some value else tvmap-get rest k; other -> None

  -- | Human-readable dynamic type name of an `HtmlValue`.
  html-type-name :: HtmlValue -> String
  html-type-name v = case v of
    HvSafeHtml s -> "template.HTML"
    HvSafeHtmlAttr s -> "template.HTMLAttr"
    HvSafeCss s -> "template.CSS"
    HvSafeJs s -> "template.JS"
    HvSafeJsStr s -> "template.JSStr"
    HvSafeUrl s -> "template.URL"
    HvSafeSrcset s -> "template.Srcset"
    HvList x rest -> "[]interface {}"
    HvListEnd -> "[]interface {}"
    HvMap k x rest -> "map[string]interface {}"
    HvMapEnd -> "map[string]interface {}"
    HvTemplate tv -> case tv of
      TvNil -> "<nil>"
      TvBool b -> "bool"
      TvInt n -> "int"
      TvFloat f -> "float64"
      TvString s -> "string"
      TvList x rest -> "[]interface {}"
      TvListEnd -> "[]interface {}"
      TvMap k x rest -> "map[string]interface {}"
      TvMapEnd -> "map[string]interface {}"

  -- | Dispatch a function call: internal contextual escapers, user functions, lazy `and`/`or`, or builtins.
  call-func :: ExecCtx -> String -> List Expr -> Option HtmlValue -> HtmlValue -> List (String, HtmlValue) -> Result String HtmlValue
  call-func ctx name args final dot vars = case ctx of
    ExecCtx ts fs mk current depth ->
      if is-internal-escaper name then
        case eval-args ctx args dot vars Nil of
          Err e -> Err e
          Ok values -> Ok (HvTemplate (TvString (run-internal-escaper name (with-final values final))))
      else case lookup-func fs name of
        Some f -> (case eval-args ctx args dot vars Nil of
          Err e -> Err e
          Ok values -> case f of
            HtmlTemplateFunction g -> case g (with-final values final) of
              Ok v -> Ok v
              Err message -> Err (string-concat-all ["error calling ", name, ": ", message]))
        None ->
          if name == "and" || name == "or" then eval-lazy ctx (name == "and") args final dot vars (HvTemplate TvNil) False
          else case eval-args ctx args dot vars Nil of
            Err e -> Err e
            Ok values -> case eval-builtin name (with-final values final) of
              Ok v -> Ok v
              Err message -> Err (string-concat-all ["error calling ", name, ": ", message])

  -- | Report whether `name` is an internal contextual escaper injected by the auto-escaper.
  is-internal-escaper :: String -> Bool
  is-internal-escaper name =
    name == "_html_template_htmlescaper"
      || name == "_html_template_attrescaper"
      || name == "_html_template_nospaceescaper"
      || name == "_html_template_rcdataescaper"
      || name == "_html_template_htmlnamefilter"
      || name == "_html_template_commentescaper"
      || name == "_html_template_urlfilter"
      || name == "_html_template_urlnormalizer"
      || name == "_html_template_urlescaper"
      || name == "_html_template_srcsetescaper"
      || name == "_html_template_jsvalescaper"
      || name == "_html_template_jsstrescaper"
      || name == "_html_template_jstmpllitescaper"
      || name == "_html_template_jsregexpescaper"
      || name == "_html_template_cssescaper"
      || name == "_html_template_cssvaluefilter"
      || name == "_eval_args_"

  -- | Execute an internal contextual escaper function on evaluated arguments.
  run-internal-escaper :: String -> List HtmlValue -> String
  run-internal-escaper name args =
    if name == "_html_template_htmlescaper" then esc-html args
    else if name == "_html_template_attrescaper" then esc-attr args
    else if name == "_html_template_nospaceescaper" then esc-nospace args
    else if name == "_html_template_rcdataescaper" then esc-rcdata args
    else if name == "_html_template_htmlnamefilter" then esc-html-name args
    else if name == "_html_template_commentescaper" then esc-comment args
    else if name == "_html_template_urlfilter" then esc-url-filter args
    else if name == "_html_template_urlnormalizer" then esc-url-normalizer args
    else if name == "_html_template_urlescaper" then esc-url-escaper args
    else if name == "_html_template_srcsetescaper" then esc-srcset args
    else if name == "_html_template_jsvalescaper" then esc-js-val args
    else if name == "_html_template_jsstrescaper" then esc-js-str args
    else if name == "_html_template_jstmpllitescaper" then esc-js-tmpl args
    else if name == "_html_template_jsregexpescaper" then esc-js-regexp args
    else if name == "_html_template_cssescaper" then esc-css-str args
    else if name == "_html_template_cssvaluefilter" then esc-css-value args
    else esc-eval-args args

  -- | Look up a user-registered function by name.
  lookup-func :: List (String, HtmlTemplateFunction) -> String -> Option HtmlTemplateFunction
  lookup-func fs name = case fs of Nil -> None; Cons f rest -> case f of (n, g) -> if n == name then Some g else lookup-func rest name

  -- | Append an optional piped value as the final argument.
  with-final :: List HtmlValue -> Option HtmlValue -> List HtmlValue
  with-final values final = case final of Some v -> append-hvals values (Cons v Nil); None -> values

  -- | Concatenate two lists of `HtmlValue`.
  append-hvals :: List HtmlValue -> List HtmlValue -> List HtmlValue
  append-hvals xs ys = case xs of Nil -> ys; Cons x rest -> Cons x (append-hvals rest ys)

  -- | Evaluate argument operands left-to-right.
  eval-args :: ExecCtx -> List Expr -> HtmlValue -> List (String, HtmlValue) -> List HtmlValue -> Result String (List HtmlValue)
  eval-args ctx args dot vars acc = case args of
    Nil -> Ok (reverse acc)
    Cons a rest -> case eval-arg ctx a dot vars of Err e -> Err e; Ok v -> eval-args ctx rest dot vars (Cons v acc)

  -- | Short-circuit evaluation for `and` and `or`.
  eval-lazy :: ExecCtx -> Bool -> List Expr -> Option HtmlValue -> HtmlValue -> List (String, HtmlValue) -> HtmlValue -> Bool -> Result String HtmlValue
  eval-lazy ctx conj args final dot vars last seen = case args of
    Cons a rest -> (case eval-arg ctx a dot vars of
      Err e -> Err e
      Ok v -> if html-is-true v == not conj then Ok v else eval-lazy ctx conj rest final dot vars v True)
    Nil -> case final of
      Some v -> Ok v
      None -> if seen then Ok last else Err (string-concat-all ["wrong number of args for ", if conj then "and" else "or", ": want at least 1 got 0"])

  -- ---------------------------------------------------------------------
  -- Builtin functions.
  -- ---------------------------------------------------------------------

  -- | Evaluate a standard builtin function over `HtmlValue` arguments.
  eval-builtin :: String -> List HtmlValue -> Result String HtmlValue
  eval-builtin name args =
    if name == "not" then (case args of Cons x Nil -> Ok (HvTemplate (TvBool (not (html-is-true x)))); other -> arity-err name 1 args)
    else if name == "len" then (case args of Cons x Nil -> length-of x; other -> arity-err name 1 args)
    else if name == "index" then (case args of Cons x rest -> index-all x rest; Nil -> Err "wrong number of args for index: want at least 1 got 0")
    else if name == "slice" then (case args of Cons x rest -> slice-hval x rest; Nil -> Err "wrong number of args for slice: want at least 1 got 0")
    else if name == "print" then Ok (HvTemplate (TvString (text-of (sprint-html args))))
    else if name == "println" then Ok (HvTemplate (TvString (text-of (sprintln-html args))))
    else if name == "printf" then (case args of
      Cons f rest -> case unwrap-string f of
        Some format -> Ok (HvTemplate (TvString (text-of (template-sprintf format (map html-to-template rest)))))
        None -> Err (string-concat "wrong type for value; expected string; got " (html-type-name f))
      Nil -> Err "wrong number of args for printf: want at least 1 got 0")
    else if name == "eq" then (case args of Cons x rest -> (case equal-any x rest of Err e -> Err e; Ok b -> Ok (HvTemplate (TvBool b))); Nil -> Err "missing argument for comparison")
    else if name == "ne" || name == "lt" || name == "le" || name == "gt" || name == "ge" then binary-cmp name args
    else if name == "html" then Ok (HvTemplate (TvString (text-of (template-html-escape (string-to-bytes (escape-builtin-args args))))))
    else if name == "js" then Ok (HvTemplate (TvString (text-of (template-js-escape (string-to-bytes (escape-builtin-args args))))))
    else if name == "urlquery" then Ok (HvTemplate (TvString (text-of (template-url-query-escape (string-to-bytes (escape-builtin-args args))))))
    else if name == "call" then Err "call of nil"
    else Err (string-concat-all ["\"", name, "\" is not a defined function"])

  -- | Extract the string payload of a string or safe-string `HtmlValue`.
  unwrap-string :: HtmlValue -> Option String
  unwrap-string v = case v of
    HvTemplate (TvString s) -> Some s
    HvSafeHtml s -> Some s
    HvSafeHtmlAttr s -> Some s
    HvSafeCss s -> Some s
    HvSafeJs s -> Some s
    HvSafeJsStr s -> Some s
    HvSafeUrl s -> Some s
    HvSafeSrcset s -> Some s
    other -> None

  -- | Format an arity mismatch error message.
  arity-err :: String -> Nat -> List HtmlValue -> Result String HtmlValue
  arity-err name want args = Err (string-concat-all ["wrong number of args for ", name, ": want ", nat-to-string want, " got ", nat-to-string (list-length args)])

  -- | Evaluate a two-argument relational builtin (`ne`, `lt`, `le`, `gt`, `ge`).
  binary-cmp :: String -> List HtmlValue -> Result String HtmlValue
  binary-cmp name args = case args of
    Cons x (Cons y Nil) -> case relation-cmp name x y of Err e -> Err e; Ok b -> Ok (HvTemplate (TvBool b))
    other -> arity-err name 2 args

  -- | Evaluate a relational comparison on two values.
  relation-cmp :: String -> HtmlValue -> HtmlValue -> Result String Bool
  relation-cmp name x y =
    if name == "ne" then (case equal-hv x y of Err e -> Err e; Ok b -> Ok (not b))
    else case less-hv x y of
      Err e -> Err e
      Ok b ->
        if name == "lt" then Ok b
        else if name == "ge" then Ok (not b)
        else case equal-hv x y of
          Err e -> Err e
          Ok q -> if name == "le" then Ok (b || q) else Ok (not (b || q))

  -- | Prepare input text for the `html`, `js`, and `urlquery` builtins.
  escape-builtin-args :: List HtmlValue -> String
  escape-builtin-args args = case args of
    Cons x Nil -> (case unwrap-string x of Some s -> s; None -> text-of (sprint-html args))
    other -> text-of (sprint-html args)

  -- | Compute `len` of a string (in bytes), list, or map.
  length-of :: HtmlValue -> Result String HtmlValue
  length-of v = case unwrap-string v of
    Some s -> Ok (HvTemplate (TvInt (nat-to-int (string-byte-length s))))
    None -> case v of
      HvList x rest -> Ok (HvTemplate (TvInt (nat-to-int (count-hv v 0))))
      HvListEnd -> Ok (HvTemplate (TvInt 0))
      HvMap k x rest -> Ok (HvTemplate (TvInt (nat-to-int (count-hv v 0))))
      HvMapEnd -> Ok (HvTemplate (TvInt 0))
      HvTemplate tv -> case tv of
        TvList x rest -> Ok (HvTemplate (TvInt (nat-to-int (count-tv tv 0))))
        TvListEnd -> Ok (HvTemplate (TvInt 0))
        TvMap k x rest -> Ok (HvTemplate (TvInt (nat-to-int (count-tv tv 0))))
        TvMapEnd -> Ok (HvTemplate (TvInt 0))
        other -> Err (string-concat "len of type " (html-type-name v))
      other -> Err (string-concat "len of type " (html-type-name v))

  -- | Count elements in an `HvList` or `HvMap`.
  count-hv :: HtmlValue -> Nat -> Nat
  count-hv v n = case v of HvList x rest -> count-hv rest (n + 1); HvMap k x rest -> count-hv rest (n + 1); other -> n

  -- | Count elements in a `TvList` or `TvMap`.
  count-tv :: TemplateValue -> Nat -> Nat
  count-tv v n = case v of TvList x rest -> count-tv rest (n + 1); TvMap k x rest -> count-tv rest (n + 1); other -> n

  -- | Apply successive `index` lookups.
  index-all :: HtmlValue -> List HtmlValue -> Result String HtmlValue
  index-all x idx = case idx of
    Nil -> Ok x
    Cons i rest -> case index-one x i of Err e -> Err e; Ok v -> index-all v rest

  -- | Perform one `index` lookup on a map or list.
  index-one :: HtmlValue -> HtmlValue -> Result String HtmlValue
  index-one x i = case x of
    HvMap k v rest -> case unwrap-string i of
      Some key -> (case hmap-get x key of Some found -> Ok found; None -> Ok (HvTemplate TvNil))
      None -> Err (string-concat-all ["value has type ", html-type-name i, "; should be string"])
    HvMapEnd -> case unwrap-string i of
      Some key -> Ok (HvTemplate TvNil)
      None -> Err (string-concat-all ["value has type ", html-type-name i, "; should be string"])
    HvList v rest -> hlist-index x i
    HvListEnd -> hlist-index x i
    HvTemplate tv -> case tv of
      TvNil -> Err "index of untyped nil"
      TvMap k v rest -> case unwrap-string i of
        Some key -> (case tvmap-get tv key of Some found -> Ok (HvTemplate found); None -> Ok (HvTemplate TvNil))
        None -> Err (string-concat-all ["value has type ", html-type-name i, "; should be string"])
      TvMapEnd -> case unwrap-string i of
        Some key -> Ok (HvTemplate TvNil)
        None -> Err (string-concat-all ["value has type ", html-type-name i, "; should be string"])
      TvList v rest -> tvlist-index tv i
      TvListEnd -> tvlist-index tv i
      other -> Err (string-concat "can't index item of type " (html-type-name x))
    other -> Err (string-concat "can't index item of type " (html-type-name x))

  -- | Bounds-checked list indexing on `HvList`.
  hlist-index :: HtmlValue -> HtmlValue -> Result String HtmlValue
  hlist-index x i = case i of
    HvTemplate (TvInt n) -> if n < 0 || n >= nat-to-int (count-hv x 0) then Err (string-concat "index out of range: " (int-to-string n)) else Ok (nth-hv x (int-nat n))
    other -> Err (string-concat "cannot index slice/array with type " (html-type-name i))

  -- | Bounds-checked list indexing on `TvList`.
  tvlist-index :: TemplateValue -> HtmlValue -> Result String HtmlValue
  tvlist-index x i = case i of
    HvTemplate (TvInt n) -> if n < 0 || n >= nat-to-int (count-tv x 0) then Err (string-concat "index out of range: " (int-to-string n)) else Ok (HvTemplate (nth-tv x (int-nat n)))
    other -> Err (string-concat "cannot index slice/array with type " (html-type-name i))

  -- | Retrieve the `n`-th element of an `HvList`.
  nth-hv :: HtmlValue -> Nat -> HtmlValue
  nth-hv x n = case x of HvList v rest -> if n == 0 then v else nth-hv rest (n - 1); other -> HvTemplate TvNil

  -- | Retrieve the `n`-th element of a `TvList`.
  nth-tv :: TemplateValue -> Nat -> TemplateValue
  nth-tv x n = case x of TvList v rest -> if n == 0 then v else nth-tv rest (n - 1); other -> TvNil

  -- | Slice a string (by byte index) or list.
  slice-hval :: HtmlValue -> List HtmlValue -> Result String HtmlValue
  slice-hval x idx =
    let size = (case unwrap-string x of
      Some s -> string-byte-length s
      None -> case x of
        HvList v rest -> count-hv x 0
        HvListEnd -> 0
        HvTemplate tv -> count-tv tv 0
        other -> 0) in
    case slice-indices idx size Nil of
      Err e -> Err e
      Ok bounds -> case unwrap-string x of
        Some s ->
          if list-length bounds > 2 then Err "cannot 3-index slice a string"
          else Ok (HvTemplate (TvString (text-of (slice (string-to-bytes s) (nth-nat bounds 0 0) (nth-nat bounds 1 size)))))
        None -> case x of
          HvList v rest -> Ok (html-list (take-range (hlist-values x) (nth-nat bounds 0 0) (nth-nat bounds 1 size)))
          HvListEnd -> Ok HvListEnd
          HvTemplate tv -> case tv of
            TvList v rest -> Ok (html-list (take-range (tvlist-values tv) (nth-nat bounds 0 0) (nth-nat bounds 1 size)))
            TvListEnd -> Ok HvListEnd
            TvNil -> Err "slice of untyped nil"
            other -> Err (string-concat "can't slice item of type " (html-type-name x))
          other -> Err (string-concat "can't slice item of type " (html-type-name x))

  -- | Validate non-decreasing slice bounds in `[0, size]`.
  slice-indices :: List HtmlValue -> Nat -> List Nat -> Result String (List Nat)
  slice-indices idx size acc = case idx of
    Nil -> if ordered-nats (reverse acc) then Ok (reverse acc) else Err "invalid slice index"
    Cons i rest -> case i of
      HvTemplate (TvInt n) -> if n < 0 || n > nat-to-int size then Err (string-concat "index out of range: " (int-to-string n)) else slice-indices rest size (Cons (int-nat n) acc)
      other -> Err (string-concat "cannot index slice/array with type " (html-type-name i))

  -- | Report whether a list of natural numbers is non-decreasing.
  ordered-nats :: List Nat -> Bool
  ordered-nats xs = case xs of Nil -> True; Cons x rest -> case rest of Nil -> True; Cons y more -> x <= y && ordered-nats rest

  -- | Retrieve the `n`-th natural number or default `d`.
  nth-nat :: List Nat -> Nat -> Nat -> Nat
  nth-nat xs n d = case xs of Nil -> d; Cons x rest -> if n == 0 then x else nth-nat rest (n - 1) d

  -- | Convert an `HvList` spine to a `List HtmlValue`.
  hlist-values :: HtmlValue -> List HtmlValue
  hlist-values v = case v of HvList x rest -> Cons x (hlist-values rest); other -> Nil

  -- | Convert a `TvList` spine to a `List HtmlValue`.
  tvlist-values :: TemplateValue -> List HtmlValue
  tvlist-values v = case v of TvList x rest -> Cons (HvTemplate x) (tvlist-values rest); other -> Nil

  -- | Extract list elements in index range `[i, j)`.
  take-range :: List HtmlValue -> Nat -> Nat -> List HtmlValue
  take-range xs i j = case xs of Nil -> Nil; Cons x rest -> if i > 0 then take-range rest (i - 1) (minus j 1) else if j == 0 then Nil else Cons x (take-range rest 0 (j - 1))

  -- | Check whether `x` equals any value in `ys`.
  equal-any :: HtmlValue -> List HtmlValue -> Result String Bool
  equal-any x ys = case ys of
    Nil -> Ok False
    Cons y rest -> case equal-hv x y of Err e -> Err e; Ok b -> if b then Ok True else equal-any x rest

  -- | Equality comparison for basic `HtmlValue` operands.
  equal-hv :: HtmlValue -> HtmlValue -> Result String Bool
  equal-hv x y = case html-to-template x of
    TvNil -> (case html-to-template y of TvNil -> Ok True; other -> Ok False)
    TvBool a -> (case html-to-template y of TvBool b -> Ok (a == b); TvNil -> Ok False; other -> Err "incompatible types for comparison")
    TvInt a -> (case html-to-template y of TvInt b -> Ok (a == b); TvNil -> Ok False; other -> Err "incompatible types for comparison")
    TvFloat a -> (case html-to-template y of TvFloat b -> Ok (feq-f64 a b); TvNil -> Ok False; other -> Err "incompatible types for comparison")
    TvString a -> (case html-to-template y of TvString b -> Ok (a == b); TvNil -> Ok False; other -> Err "incompatible types for comparison")
    other -> (case html-to-template y of TvNil -> Ok False; other2 -> Err (string-concat "non-comparable type " (html-type-name x)))

  -- | Strict ordering comparison (`<`) for integers, floats, or strings.
  less-hv :: HtmlValue -> HtmlValue -> Result String Bool
  less-hv x y = case html-to-template x of
    TvInt a -> (case html-to-template y of TvInt b -> Ok (a < b); other -> bad-compare (html-to-template y))
    TvFloat a -> (case html-to-template y of TvFloat b -> Ok (flt-f64 a b); other -> bad-compare (html-to-template y))
    TvString a -> (case html-to-template y of TvString b -> Ok (lt-i64 (string-compare a b) 0); other -> bad-compare (html-to-template y))
    other -> Err "invalid type for comparison"

  -- | Produce a comparison type error.
  bad-compare :: TemplateValue -> Result String Bool
  bad-compare y = case y of TvBool b -> Err "invalid type for comparison"; other -> Err "incompatible types for comparison"

  -- ---------------------------------------------------------------------
  -- Printing helpers (reusing Text.Template.template-sprintf).
  -- ---------------------------------------------------------------------

  -- | Render a final action result (`TvNil` prints `<no value>`, though escaped actions normally return `TvString`).
  print-html-value :: HtmlValue -> Bytes
  print-html-value v = case v of
    HvTemplate TvNil -> string-to-bytes "<no value>"
    other -> string-to-bytes (sprint-one-html v)

  -- | Default textual representation of a single `HtmlValue`.
  sprint-one-html :: HtmlValue -> String
  sprint-one-html v = case unwrap-string v of
    Some s -> s
    None -> text-of (template-sprintf "%v" [html-to-template v])

  -- | Print values with a space inserted between adjacent non-string operands.
  sprint-html :: List HtmlValue -> Bytes
  sprint-html args = bytes-concat (sprint-html-from args False True Nil)

  -- | Accumulate printed pieces for `sprint-html`.
  sprint-html-from :: List HtmlValue -> Bool -> Bool -> List Bytes -> List Bytes
  sprint-html-from args previous first acc = case args of
    Nil -> reverse acc
    Cons x rest ->
      let current = is-string-hv x in
      let spaced = if not first && not current && not previous then Cons (string-to-bytes " ") acc else acc in
      sprint-html-from rest current False (Cons (string-to-bytes (sprint-one-html x)) spaced)

  -- | Report whether an `HtmlValue` is a plain or safe string.
  is-string-hv :: HtmlValue -> Bool
  is-string-hv v = case unwrap-string v of Some s -> True; None -> False

  -- | Print values separated by spaces followed by a newline.
  sprintln-html :: List HtmlValue -> Bytes
  sprintln-html args = bytes-concat [bytes-join (map default-html-bytes args) (string-to-bytes " "), string-to-bytes "\n"]

  -- | Default formatted bytes of an `HtmlValue`.
  default-html-bytes :: HtmlValue -> Bytes
  default-html-bytes v = string-to-bytes (sprint-one-html v)

  -- ---------------------------------------------------------------------
  -- Pure portable byte, UTF-8, and character helpers (zero inline LLVM).
  -- ---------------------------------------------------------------------

  -- | Convert a non-negative `Int` to a `Nat` (clamping negatives to 0).
  int-nat :: Int -> Nat
  int-nat n = case checked-int-to-i64 n of Some k -> if 0 <= k then nat-from-i64 k else 0; None -> 0

  -- | Allocate an empty `Bytes` buffer.
  no-bytes :: Unit -> Bytes
  no-bytes unit = bytes-new 0

  -- | Checked byte read returning 0 when out of bounds.
  at :: Bytes -> Nat -> Nat
  at s i = if i < bytes-len s then bytes-get s i else 0

  -- | Saturating natural subtraction.
  minus :: Nat -> Nat -> Nat
  minus a b = if b <= a then a - b else 0

  -- | Copy slice `s[a, b)` into a fresh buffer.
  slice :: Bytes -> Nat -> Nat -> Bytes
  slice s a b =
    let n = minus b a in
    let out = bytes-new n in
    if a + n <= bytes-len s then let copied = bytes-copy-range out s 0 a n in out else out

  -- | Construct a `Bytes` buffer from a list of byte values.
  from-list :: List Nat -> Bytes
  from-list values = let out = bytes-new (list-length values) in let filled = fill-bytes out 0 values in out

  -- | Populate a `Bytes` buffer from offset `i`.
  fill-bytes :: Bytes -> Nat -> List Nat -> Unit
  fill-bytes out i values = case values of
    Nil -> ()
    Cons v rest -> let w = if i < bytes-len out && v < 256 then bytes-set out i v else () in fill-bytes out (i + 1) rest

  -- | Decode bytes to UTF-8 `String`, replacing invalid byte sequences with U+FFFD.
  text-of :: Bytes -> String
  text-of b = case string-from-bytes b of Some t -> t; None -> text-of (repair-utf8 b 0 Nil)

  -- | Replace invalid UTF-8 sequences with U+FFFD.
  repair-utf8 :: Bytes -> Nat -> List Bytes -> Bytes
  repair-utf8 b i acc =
    if i >= bytes-len b then bytes-concat (reverse acc)
    else let n = rune-size b i in if n == 0 then repair-utf8 b (i + 1) (Cons (encode-rune 65533) acc) else repair-utf8 b (i + n) (Cons (slice b i (i + n)) acc)

  -- | Report whether a byte is ASCII template whitespace (` `, `\t`, `\r`, `\n`).
  is-space :: Nat -> Bool
  is-space c = c == 32 || c == 9 || c == 13 || c == 10

  -- | Report whether a byte is an ASCII decimal digit.
  is-digit :: Nat -> Bool
  is-digit c = c >= 48 && c <= 57

  -- | Report whether a byte is an ASCII letter.
  is-ascii-alpha :: Nat -> Bool
  is-ascii-alpha c = (c >= 65 && c <= 90) || (c >= 97 && c <= 122)

  -- | Report whether a byte is an ASCII letter or digit.
  is-ascii-alnum :: Nat -> Bool
  is-ascii-alnum c = is-ascii-alpha c || is-digit c

  -- | Report whether a byte is a template identifier letter, underscore, or non-ASCII byte.
  is-alpha :: Nat -> Bool
  is-alpha c = is-ascii-alpha c || c == 95 || c >= 128

  -- | Report whether a byte is an ASCII hexadecimal digit.
  is-hex :: Nat -> Bool
  is-hex c = is-digit c || (lower c >= 97 && lower c <= 102)

  -- | Report whether a byte is an ASCII octal digit.
  is-octal :: Nat -> Bool
  is-octal c = c >= 48 && c <= 55

  -- | Numeric value of a hexadecimal digit byte.
  hex-digit :: Nat -> Nat
  hex-digit c = if c >= 48 && c <= 57 then c - 48 else if lower c >= 97 && lower c <= 102 then minus (lower c) 87 else (99 :: Nat)

  -- | Convert an ASCII uppercase byte to lowercase.
  lower :: Nat -> Nat
  lower c = if c >= 65 && c <= 90 then c + 32 else c

  -- | Convert all ASCII uppercase letters in `b` to lowercase in a fresh buffer.
  lower-bytes :: Bytes -> Bytes
  lower-bytes b = from-list (lower-bytes-from b 0 Nil)

  -- | Lowercase bytes from offset `i`.
  lower-bytes-from :: Bytes -> Nat -> List Nat -> List Nat
  lower-bytes-from b i acc = if i >= bytes-len b then reverse acc else lower-bytes-from b (i + 1) (Cons (lower (at b i)) acc)

  -- | Report whether `p` occurs at offset `i` in `s`.
  starts-with :: Bytes -> Nat -> Bytes -> Bool
  starts-with s i p = if i + bytes-len p > bytes-len s then False else matches-at s p i 0

  -- | Report whether `s` starts with prefix `p`.
  has-prefix-bytes :: Bytes -> Bytes -> Bool
  has-prefix-bytes s p = starts-with s 0 p

  -- | Byte-by-byte match of `needle` at `s[i..]`.
  matches-at :: Bytes -> Bytes -> Nat -> Nat -> Bool
  matches-at s needle i k = if k >= bytes-len needle then True else if at s (i + k) == at needle k then matches-at s needle i (k + 1) else False

  -- | ASCII case-insensitive match of `needle` (lower-case) at `s[i..]`.
  equal-fold-at :: Bytes -> Nat -> Bytes -> Nat -> Bool
  equal-fold-at s i needle k =
    if i + bytes-len needle > bytes-len s then False
    else if k >= bytes-len needle then True
    else if lower (at s (i + k)) == lower (at needle k) then equal-fold-at s i needle (k + 1)
    else False

  -- | Find the first occurrence of byte sequence `needle` at or after `i`.
  find-bytes :: Bytes -> Bytes -> Nat -> Option Nat
  find-bytes s needle i = if i + bytes-len needle > bytes-len s then None else if matches-at s needle i 0 then Some i else find-bytes s needle (i + 1)

  -- | Report whether `needle` occurs anywhere in `s`.
  contains-bytes :: Bytes -> Bytes -> Bool
  contains-bytes s needle = case find-bytes s needle 0 of Some k -> True; None -> False

  -- | Find the first occurrence of byte `b` at or after `i`.
  find-byte :: Bytes -> Nat -> Nat -> Option Nat
  find-byte s b i = let k = scalar-find s b i in if k < bytes-len s then Some k else None

  -- | Report whether byte `b` occurs in `s` at or after `i`.
  has-byte :: Bytes -> Nat -> Nat -> Bool
  has-byte s b i = scalar-find s b i < bytes-len s

  -- | Find the first offset at or after `i` whose byte appears in `set`.
  find-any-byte :: Bytes -> Bytes -> Nat -> Option Nat
  find-any-byte s set i =
    if i >= bytes-len s then None
    else if has-byte set (at s i) 0 then Some i
    else find-any-byte s set (i + 1)

  -- | Report whether any byte of `set` occurs in `s` at or after `i`.
  has-any-byte :: Bytes -> Bytes -> Nat -> Bool
  has-any-byte s set i = case find-any-byte s set i of Some k -> True; None -> False

  -- | Format a natural number in `base` (2, 8, 10, or 16).
  digits-of :: Nat -> Nat -> Bool -> Bytes
  digits-of n base upper = if n == 0 then string-to-bytes "0" else from-list (digit-list n base upper Nil)

  -- | Accumulate digits most-significant-first.
  digit-list :: Nat -> Nat -> Bool -> List Nat -> List Nat
  digit-list n base upper acc =
    if n == 0 || base < 2 then acc
    else
      let d = nat-rem n (if base == 2 then (2 :: Nat) else if base == 8 then (8 :: Nat) else if base == 16 then (16 :: Nat) else 10) in
      let q = nat-div n (if base == 2 then (2 :: Nat) else if base == 8 then (8 :: Nat) else if base == 16 then (16 :: Nat) else 10) in
      digit-list q base upper (Cons (if d < 10 then 48 + d else (if upper then (55 :: Nat) else 87) + d) acc)

  -- | Left-pad byte buffer `b` with ASCII `'0'` to width `n`.
  pad-left-zeros :: Bytes -> Nat -> Bytes
  pad-left-zeros b n = if bytes-len b >= n then b else bytes-concat [bytes-repeat (minus n (bytes-len b)) (string-to-bytes "0"), b]

  -- | Length in bytes of the valid UTF-8 sequence starting at `i` (1 to 4), or 0 if invalid.
  rune-size :: Bytes -> Nat -> Nat
  rune-size s i =
    let b = at s i in
    if i >= bytes-len s then 0
    else if b < 128 then 1
    else if b >= 194 && b <= 223 then (if i + 1 < bytes-len s && cont (at s (i + 1)) then (2 :: Nat) else 0)
    else if b >= 224 && b <= 239 then
      (let c = at s (i + 1) in if i + 2 < bytes-len s && c >= (if b == 224 then (160 :: Nat) else 128) && c <= (if b == 237 then (159 :: Nat) else 191) && cont (at s (i + 2)) then (3 :: Nat) else 0)
    else if b >= 240 && b <= 244 then
      (let c = at s (i + 1) in if i + 3 < bytes-len s && c >= (if b == 240 then (144 :: Nat) else 128) && c <= (if b == 244 then (143 :: Nat) else 191) && cont (at s (i + 2)) && cont (at s (i + 3)) then (4 :: Nat) else 0)
    else 0

  -- | Report whether `b` is a UTF-8 continuation byte (`0x80..0xBF`).
  cont :: Nat -> Bool
  cont b = b >= 128 && b <= 191

  -- | Decode the Unicode scalar value of a validated `n`-byte UTF-8 sequence at `i`.
  rune-value :: Bytes -> Nat -> Nat -> Nat
  rune-value s i n =
    if n == 1 then at s i
    else if n == 2 then minus (at s i) 192 * 64 + low6 s (i + 1)
    else if n == 3 then (minus (at s i) 224 * 64 + low6 s (i + 1)) * 64 + low6 s (i + 2)
    else ((minus (at s i) 240 * 64 + low6 s (i + 1)) * 64 + low6 s (i + 2)) * 64 + low6 s (i + 3)

  -- | Extract the 6-bit payload of a UTF-8 continuation byte.
  low6 :: Bytes -> Nat -> Nat
  low6 s i = minus (at s i) 128

  -- | Encode a Unicode scalar value as UTF-8 bytes.
  encode-rune :: Nat -> Bytes
  encode-rune c =
    if c < 128 then from-list [c]
    else if c < 2048 then from-list [192 + nat-div c 64, 128 + nat-rem c 64]
    else if c < 65536 then from-list [224 + nat-div c 4096, 128 + nat-rem (nat-div c 64) 64, 128 + nat-rem c 64]
    else from-list [240 + nat-div c 262144, 128 + nat-rem (nat-div c 4096) 64, 128 + nat-rem (nat-div c 64) 64, 128 + nat-rem c 64]
