-- | Hexadecimal conversion between byte buffers and text.
-- Encoding emits two lowercase ASCII characters per byte. Decoding accepts either
-- case, without whitespace or prefixes. Invalid-byte offsets count UTF-8 bytes;
-- an invalid final byte takes precedence over an odd-length error. Whole-text
-- decoding rejects the input on error; prefix and append APIs retain completed
-- bytes alongside the error. Complete blocks use portable 128-bit SIMD nibble lanes;
-- short tails and precise error reporting use the scalar path.
module Text.Hex where

  import Data.Bytes
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String
  import Data.Wide

  export HexError, OddHexLength, InvalidHexByte, HexShortDestination
  export hex-encode, hex-decode, hex-encoded-length, hex-decoded-length
  export hex-encode-bytes, hex-decode-prefix, hex-encode-append, hex-decode-append
  export hex-encode-into, hex-decode-into
  export hex-dump, hex-dump-bytes, hex-error-message

  -- | A hexadecimal input or destination is invalid. Prefix APIs return completed output alongside this error.
  data HexError where
    -- | The final valid hexadecimal digit has no matching low digit.
    OddHexLength :: HexError
    -- | An invalid UTF-8 byte, represented by its zero-based byte offset followed by its value.
    InvalidHexByte :: Nat -> Nat -> HexError
    -- | Required output bytes and available destination bytes. No destination bytes were changed.
    HexShortDestination :: Nat -> Nat -> HexError

  -- | Render a diagnostic with original byte positions or the required output capacity.
  hex-error-message :: HexError -> String
  hex-error-message error = case error of
    OddHexLength -> "unpaired final hexadecimal digit"
    InvalidHexByte offset byte -> string-concat "invalid hexadecimal byte " (string-concat (nat-to-string byte) (string-concat " at byte " (nat-to-string offset)))
    HexShortDestination required available -> string-concat "hexadecimal output requires " (string-concat (nat-to-string required) (string-concat " bytes; available " (nat-to-string available)))

  -- | The exact encoded character and byte count for a buffer of the given length: twice its length.
  hex-encoded-length :: Nat -> Nat
  hex-encoded-length n = n * 2

  -- | The maximum complete decoded byte count for an encoded length: floor(length / 2). This does not validate the input.
  hex-decoded-length :: Nat -> Nat
  hex-decoded-length n = nat-div n 2

  -- | Render a nibble as its lowercase ASCII machine byte.
  hex-digit-u8 :: U8 -> U8
  hex-digit-u8 n =
    if lt-u8 n 10 then wrapping-add-u8 n 48
    else wrapping-add-u8 n 87

  -- | Encode all bytes as lowercase hexadecimal ASCII. Empty input produces empty text; complete blocks use SIMD and the tail is exact.
  hex-encode :: Bytes -> String
  hex-encode b =
    let out = bytes-new (hex-encoded-length (bytes-len b)) in
    let filled = encode-buffer-from b 0 out 0 in
    case string-from-bytes out of
      Some s -> s
      None -> empty-string

  -- | Encode directly to a fresh lowercase ASCII buffer, without a text conversion.
  hex-encode-bytes :: Bytes -> Bytes
  hex-encode-bytes input =
    let out = bytes-new (hex-encoded-length (bytes-len input)) in
    let filled = encode-buffer-from input 0 out 0 in out

  -- | Append encoded bytes to a copied prefix. Neither input buffer is mutated or retained by alias.
  hex-encode-append :: Bytes -> Bytes -> Bytes
  hex-encode-append prefix input =
    let start = bytes-len prefix in
    let out = bytes-new (start + hex-encoded-length (bytes-len input)) in
    let copied = bytes-copy-range out prefix 0 0 start in
    let filled = encode-buffer-from input 0 out start in out

  -- | Encode into a destination starting at an offset and return the written byte count.
  -- The entire destination range is checked before writing. Source/destination overlap is safe.
  hex-encode-into :: Bytes -> Nat -> Bytes -> Result HexError Nat
  hex-encode-into destination start input =
    let required = hex-encoded-length (bytes-len input) in
    if start <= bytes-len destination && required <= bytes-len destination - start then
      let source = copy-prefix input (bytes-len input) in
      let filled = encode-buffer-from source 0 destination start in Ok required
    else Err (HexShortDestination required (saturating-sub (bytes-len destination) start))

  -- | Recognize an ASCII hexadecimal machine byte of either case, returning 255 for invalid bytes.
  hex-nibble-u8 :: U8 -> U8
  hex-nibble-u8 byte =
    let digit = wrapping-sub-u8 byte 48 in
    if lt-u8 digit 10 then digit
    else
      let alpha = wrapping-sub-u8 (bit-or-u8 byte 32) 97 in
      if lt-u8 alpha 6 then wrapping-add-u8 alpha 10
      else 255

  -- | Decode text atomically: malformed input returns only an error, without a partial buffer.
  hex-decode :: String -> Result HexError Bytes
  hex-decode text = case hex-decode-prefix (string-to-bytes text) of
    (out, None) -> Ok out
    (out, Some error) -> Err error

  -- | Decode all complete valid pairs from arbitrary encoded bytes, preserving a prefix on error.
  -- Invalid byte offsets refer to the original input, including invalid non-UTF-8 bytes.
  hex-decode-prefix :: Bytes -> (Bytes, Option HexError)
  hex-decode-prefix input = hex-decode-append (bytes-new 0) input

  -- | Append decoded bytes to a copied prefix, retaining completed pairs even if later input is invalid.
  -- Error offsets refer to the encoded input, independently of the prefix length.
  hex-decode-append :: Bytes -> Bytes -> (Bytes, Option HexError)
  hex-decode-append prefix input =
    let start = bytes-len prefix in
    let out = bytes-new (start + hex-decoded-length (bytes-len input)) in
    if start <= bytes-len out then
      let copied = bytes-copy-range out prefix 0 0 start in
      case decode-buffer-from input 0 out start of
        (end, error) -> (if end == bytes-len out then out else copy-prefix out end, error)
    else (copy-prefix prefix start, Some (HexShortDestination start (bytes-len out)))

  -- | Decode into a destination and return completed bytes plus any decoding error.
  -- A short range returns zero and HexShortDestination before mutation; malformed input
  -- retains its valid decoded prefix. The source is snapshotted so overlap is safe.
  hex-decode-into :: Bytes -> Nat -> Bytes -> (Nat, Option HexError)
  hex-decode-into destination start input =
    let required = hex-decoded-length (bytes-len input) in
    if start <= bytes-len destination && required <= bytes-len destination - start then
      let source = copy-prefix input (bytes-len input) in
      case decode-buffer-from source 0 destination start of
        (end, error) -> (saturating-sub end start, error)
    else (0, Some (HexShortDestination required (saturating-sub (bytes-len destination) start)))

  -- | Snapshot an initialized prefix, including the empty prefix, without retaining an alias.
  copy-prefix :: Bytes -> Nat -> Bytes
  copy-prefix input n = if n <= bytes-len input then
    let out = bytes-new n in
    let copied = bytes-copy-range out input 0 0 n in out
    else bytes-new 0

  -- | Spread four little-endian bytes into eight ordered four-bit nibbles.
  spread-nibbles4 :: U32 -> U64
  spread-nibbles4 x =
    let t0 = u32-to-u64 x in
    let t1 = bit-or-u64 (bit-and-u64 t0 65535) (wrapping-shl-u64 (bit-and-u64 t0 4294901760) 16) in
    let t2 = bit-or-u64 (bit-and-u64 t1 1095216660735) (wrapping-shl-u64 (bit-and-u64 t1 280375465148160) 8) in
    let hi = bit-and-u64 (wrapping-shr-u64 t2 4) 4222189076152335 in
    let lo = wrapping-shl-u64 (bit-and-u64 t2 4222189076152335) 8 in
    bit-or-u64 hi lo

  -- | Encode four packed bytes as eight lowercase ASCII hex bytes with branchless SWAR.
  encode4 :: U32 -> U64
  encode4 x =
    let n = spread-nibbles4 x in
    let letter = wrapping-shr-u64 (bit-and-u64 (wrapping-add-u64 n 434041037028460038) 1157442765409226768) 4 in
    wrapping-add-u64 (wrapping-add-u64 n 3472328296227680304) (wrapping-mul-u64 letter 39)

  -- | Encode eight packed bytes as sixteen lowercase ASCII hex bytes using 128-bit SIMD lanes.
  encode8 :: U64 -> U128
  encode8 word =
    let lo = spread-nibbles4 (wrapping-u64-to-u32 word) in
    let hi = spread-nibbles4 (wrapping-u64-to-u32 (wrapping-shr-u64 word 32)) in
    let nibs = simd-u64x2-pack lo hi in
    let letter = simd-u8x16-cmpgt nibs (simd-u8x16-splat 9) in
    let base = simd-bitselect letter (simd-u8x16-splat 87) (simd-u8x16-splat 48) in
    simd-u8x16-add nibs base

  -- | Compact four low bytes spaced across 16-bit lanes in a 64-bit word into a 32-bit word.
  compact-four :: U64 -> U32
  compact-four word =
    let c1 = bit-and-u64 (bit-or-u64 word (wrapping-shr-u64 word 8)) 281470681808895 in
    wrapping-u64-to-u32 (bit-or-u64 c1 (wrapping-shr-u64 c1 16))

  -- | Combine sixteen validated four-bit nibbles into eight little-endian decoded bytes.
  pack-nibbles16 :: U128 -> U64
  pack-nibbles16 nibs =
    let hi-part = simd-u16x8-shl nibs 4 in
    let lo-part = simd-u16x8-shr nibs 8 in
    let bytes16 = bit-and-u128 (bit-or-u128 hi-part lo-part) (simd-u16x8-splat 255) in
    let lo32 = compact-four (wrapping-u128-to-u64 bytes16) in
    let hi32 = compact-four (wrapping-u128-to-u64 (wrapping-shr-u128 bytes16 64)) in
    bit-or-u64 (u32-to-u64 lo32) (wrapping-shl-u64 (u32-to-u64 hi32) 32)

  -- | Fill complete 128-bit SIMD blocks, a four-byte SWAR block, and the exact scalar tail.
  encode-buffer-from :: Bytes -> Nat -> Bytes -> Nat -> Unit
  encode-buffer-from b i out oi =
    if i <= bytes-len b && oi <= bytes-len out then
      encode-loop8 b (nat-to-i64 i) out (nat-to-i64 oi)
    else ()

  -- | Tail-recursive 128-bit SIMD encoding loop: eight input bytes to sixteen hex bytes.
  encode-loop8 :: Bytes -> I64 -> Bytes -> I64 -> Unit
  encode-loop8 b i out oi =
    let nb = bytes-len-i64 b in
    let no = bytes-len-i64 out in
    if 8 <= nb && 16 <= no && 0 <= i && 0 <= oi then
      let nnb = nat-from-i64 nb in
      let nno = nat-from-i64 no in
      if 8 <= nnb && 16 <= nno then
        let ni = nat-from-i64 i in
        let noi = nat-from-i64 oi in
        if ni <= nnb - 8 && noi <= nno - 16 then
          let stored = bytes-store-u128-at out oi (encode8 (bytes-load-le64-at b i)) in
          encode-loop8 b (wrapping-add-i64 i 8) out (wrapping-add-i64 oi 16)
        else encode-loop4 b i out oi
      else encode-loop4 b i out oi
    else encode-loop4 b i out oi

  -- | Encode an optional four-byte SWAR block before the exact scalar tail.
  encode-loop4 :: Bytes -> I64 -> Bytes -> I64 -> Unit
  encode-loop4 b i out oi =
    let nb = bytes-len-i64 b in
    let no = bytes-len-i64 out in
    if 4 <= nb && 8 <= no && 0 <= i && 0 <= oi then
      let nnb = nat-from-i64 nb in
      let nno = nat-from-i64 no in
      if 4 <= nnb && 8 <= nno then
        let ni = nat-from-i64 i in
        let noi = nat-from-i64 oi in
        if ni <= nnb - 4 && noi <= nno - 8 then
          let stored = bytes-store-le64-at out oi (encode4 (bytes-load-le32-at b i)) in
          encode-loop-tail b (wrapping-add-i64 i 4) out (wrapping-add-i64 oi 8)
        else encode-loop-tail b i out oi
      else encode-loop-tail b i out oi
    else encode-loop-tail b i out oi

  -- | Encode the remaining zero to three bytes with exact scalar stores.
  encode-loop-tail :: Bytes -> I64 -> Bytes -> I64 -> Unit
  encode-loop-tail b i out oi =
    if 0 <= i && i < bytes-len-i64 b && 0 <= oi && oi < bytes-len-i64 out then
      let oi1 = wrapping-add-i64 oi 1 in
      if 0 <= oi1 && oi1 < bytes-len-i64 out then
        let v = bytes-get-u8-at b i in
        let hi = bytes-set-u8-at out oi (hex-digit-u8 (wrapping-shr-u8 v 4)) in
        let lo = bytes-set-u8-at out oi1 (hex-digit-u8 (bit-and-u8 v 15)) in
        encode-loop-tail b (wrapping-add-i64 i 1) out (wrapping-add-i64 oi 2)
      else ()
    else ()

  -- | Decode SIMD blocks directly into the output, then identify a scalar error or exact tail.
  -- Each decoded block is stored once; no per-byte list nodes are allocated.
  decode-buffer-from :: Bytes -> Nat -> Bytes -> Nat -> (Nat, Option HexError)
  decode-buffer-from input i out oi =
    if i <= bytes-len input && oi <= bytes-len out then
      decode-loop input (nat-to-i64 i) out (nat-to-i64 oi)
    else (oi, None)

  -- | Tail-recursive 128-bit SIMD decoding loop; falls back to scalar for tails or errors.
  decode-loop :: Bytes -> I64 -> Bytes -> I64 -> (Nat, Option HexError)
  decode-loop input i out oi =
    let ni-len = bytes-len-i64 input in
    let no-len = bytes-len-i64 out in
    if 16 <= ni-len && 8 <= no-len && 0 <= i && 0 <= oi then
      let nnb = nat-from-i64 ni-len in
      let nno = nat-from-i64 no-len in
      if 16 <= nnb && 8 <= nno then
        let ni = nat-from-i64 i in
        let noi = nat-from-i64 oi in
        if ni <= nnb - 16 && noi <= nno - 8 then
          let v = bytes-load-u128-at input i in
          let folded = bit-or-u128 v (simd-u8x16-splat 32) in
          let d = simd-u8x16-sub v (simd-u8x16-splat 48) in
          let is-digit = simd-u8x16-cmplt d (simd-u8x16-splat 10) in
          let a = simd-u8x16-sub folded (simd-u8x16-splat 97) in
          let is-alpha = simd-u8x16-cmplt a (simd-u8x16-splat 6) in
          let valid = bit-or-u128 is-digit is-alpha in
          if eq-u32 (simd-u8x16-movemask valid) 65535 then
            let a-val = simd-u8x16-add a (simd-u8x16-splat 10) in
            let nibs = simd-bitselect is-digit d a-val in
            let stored = bytes-store-le64-at out oi (pack-nibbles16 nibs) in
            decode-loop input (wrapping-add-i64 i 16) out (wrapping-add-i64 oi 8)
          else decode-scalar input i out oi
        else decode-scalar input i out oi
      else decode-scalar input i out oi
    else decode-scalar input i out oi

  -- | Store valid pairs or stop at the first invalid byte, preferring an invalid tail to odd length.
  decode-scalar :: Bytes -> I64 -> Bytes -> I64 -> (Nat, Option HexError)
  decode-scalar input i out oi =
    if 0 <= i && i < bytes-len-i64 input && 0 <= oi then
      let first = bytes-get-u8-at input i in
      let high = hex-nibble-u8 first in
      if ge-u8 high 16 then (nat-from-i64 oi, Some (InvalidHexByte (nat-from-i64 i) (u8-to-nat first)))
      else
        let i1 = wrapping-add-i64 i 1 in
        if 0 <= i1 && i1 < bytes-len-i64 input then
          let second = bytes-get-u8-at input i1 in
          let low = hex-nibble-u8 second in
          if ge-u8 low 16 then (nat-from-i64 oi, Some (InvalidHexByte (nat-from-i64 i1) (u8-to-nat second)))
          else if oi < bytes-len-i64 out then
            let stored = bytes-set-u8-at out oi (bit-or-u8 (wrapping-shl-u8 high 4) low) in
            decode-scalar input (wrapping-add-i64 i 2) out (wrapping-add-i64 oi 1)
          else (nat-from-i64 oi, Some (HexShortDestination 1 0))
        else (nat-from-i64 oi, Some OddHexLength)
    else if 0 <= oi then (nat-from-i64 oi, None)
    else (0, None)

  -- | Render sixteen-byte rows with eight-digit offsets, grouped lowercase hex and printable ASCII.
  -- Non-printable bytes become dots. Empty input is empty text; no final offset-only row is emitted.
  hex-dump :: Bytes -> String
  hex-dump input = if bytes-len input == 0 then empty-string else
    case string-from-bytes (hex-dump-bytes 0 input) of
      Some text -> text
      None -> empty-string

  -- | Render a dump as ASCII bytes starting at an explicit 32-bit line offset.
  -- Offsets wrap modulo 2^32. A short last row is padded only before its ASCII column.
  hex-dump-bytes :: U32 -> Bytes -> Bytes
  hex-dump-bytes offset input =
    if bytes-len input == 0 then bytes-new 0 else
      let count = bytes-len input in
      let full = nat-div count 16 in
      let tail = nat-rem count 16 in
      let out = bytes-new (full * 79 + (if tail == 0 then 0 else 63 + tail)) in
      let digits = hex-encode-bytes input in
      let template = string-to-bytes "                                                            |" in
      let filled = dump-lines input digits template 0 out 0 offset in out

  -- | Render checked complete or short rows without recopying their already formatted prefix.
  dump-lines :: Bytes -> Bytes -> Bytes -> Nat -> Bytes -> Nat -> U32 -> Unit
  dump-lines input digits template i out oi offset =
    if i < bytes-len input then
      let left = bytes-len input - i in
      let n = if left < 16 then left else 16 in
      if n <= 16 then
        let filled = dump-line input digits template i n out oi offset in
        dump-lines input digits template (i + n) out (oi + 63 + n) (wrapping-add-u32 offset (wrapping-i64-to-u32 (nat-to-i64 n)))
      else ()
    else ()

  -- | Copy one fixed column template, then fill its offset, digit pairs, ASCII bytes and terminator.
  dump-line :: Bytes -> Bytes -> Bytes -> Nat -> Nat -> Bytes -> Nat -> U32 -> Unit
  dump-line input digits template start n out oi offset =
    if start + n <= bytes-len input && n <= 16 && oi + 63 + n <= bytes-len out && oi + 61 <= bytes-len out && 61 <= bytes-len template then
      let copied = bytes-copy-range out template oi 0 61 in
      let address = if oi + 8 <= bytes-len out then bytes-store-le64 out oi (encode4 (swap-bytes-u32 offset)) else () in
      let pairs = dump-digits digits (start * 2) n out oi 0 in
      let right = dump-ascii input start n out (oi + 61) 0 in
      let close = oi + 61 + n in
      if close + 2 <= bytes-len out then
        let bar = bytes-set out close 124 in bytes-set out (close + 1) 10
      else ()
    else ()

  -- | Scatter the encoded digit pairs into grouped three-character columns.
  dump-digits :: Bytes -> Nat -> Nat -> Bytes -> Nat -> Nat -> Unit
  dump-digits digits start n out oi j =
    if j + 4 <= n then
      let from = start + j * 2 in
      let position = oi + 10 + j * 3 + (if j < 8 then 0 else 1) in
      if from + 8 <= bytes-len digits && position + 12 <= bytes-len out then
        let packed = bytes-load-le64 digits from in
        let first = bytes-store-le64 out position (dump-columns-low packed) in
        let last = bytes-store-le32 out (position + 8) (dump-columns-high packed) in
        dump-digits digits start n out oi (j + 4)
      else ()
    else if j < n then
      let from = start + j * 2 in
      let position = oi + 10 + j * 3 + (if j < 8 then 0 else 1) in
      if from + 2 <= bytes-len digits && position + 2 <= bytes-len out then
        let high = bytes-set out position (bytes-get digits from) in
        let low = bytes-set out (position + 1) (bytes-get digits (from + 1)) in
        dump-digits digits start n out oi (j + 1)
      else ()
    else ()

  -- | Classify sixteen printable bytes in parallel, then handle an exact short tail.
  dump-ascii :: Bytes -> Nat -> Nat -> Bytes -> Nat -> Nat -> Unit
  dump-ascii input start n out at j =
    if j + 16 <= n && start + j + 16 <= bytes-len input && at + j + 16 <= bytes-len out then
      let stored = bytes-store-u128 out (at + j) (dump-ascii16 (bytes-load-u128 input (start + j))) in
      dump-ascii input start n out at (j + 16)
    else if j < n && start + j < bytes-len input && at + j < bytes-len out then
      let byte = bytes-get-u8 input (start + j) in
      let stored = bytes-set-u8 out (at + j) (if ge-u8 byte 32 && le-u8 byte 126 then byte else 46) in
      dump-ascii input start n out at (j + 1)
    else ()

  -- | Preserve printable ASCII in sixteen independent SIMD lanes and replace all other bytes with dots.
  dump-ascii16 :: U128 -> U128
  dump-ascii16 v =
    let shifted = simd-u8x16-sub v (simd-u8x16-splat 32) in
    let printable = simd-u8x16-cmplt shifted (simd-u8x16-splat 95) in
    simd-bitselect printable v (simd-u8x16-splat 46)

  -- | Interleave spaces into the first eight bytes of four encoded pairs using SWAR masks.
  -- Input and output words represent little-endian byte sequences independently of target order.
  dump-columns-low :: U64 -> U64
  dump-columns-low packed =
    let pair0 = bit-and-u64 packed 65535 in
    let pair1 = bit-and-u64 packed 4294901760 in
    let middle = wrapping-shl-u64 pair1 8 in
    let pair2 = bit-and-u64 packed 281470681743360 in
    let last = wrapping-shl-u64 pair2 16 in
    bit-or-u64 (bit-or-u64 (bit-or-u64 pair0 middle) last) 35184374185984

  -- | Complete the four-pair column block with a space, the final pair and a trailing space.
  dump-columns-high :: U64 -> U32
  dump-columns-high packed =
    let pair = wrapping-u64-to-u32 (wrapping-shr-u64 packed 48) in
    bit-or-u32 (wrapping-shl-u32 pair 8) 536870944
