      %s26 = ashr i32 %c25, 31
      %m26 = and i32 %s26, 79764919
      %h26 = shl i32 %c25, 1
      %c26 = xor i32 %h26, %m26
      %s27 = ashr i32 %c26, 31
      %m27 = and i32 %s27, 79764919
      %h27 = shl i32 %c26, 1
      %c27 = xor i32 %h27, %m27
      %s28 = ashr i32 %c27, 31
      %m28 = and i32 %s28, 79764919
      %h28 = shl i32 %c27, 1
      %c28 = xor i32 %h28, %m28
      %s29 = ashr i32 %c28, 31
      %m29 = and i32 %s29, 79764919
      %h29 = shl i32 %c28, 1
      %c29 = xor i32 %h29, %m29
