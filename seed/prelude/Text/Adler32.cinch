-- | Adler-32 checksums, persistent accumulators and versioned binary checkpoints.
-- Updates consume sixteen bytes with packed parallel weighted reductions and normalize
-- the two sums after segments of at most 5552 bytes. Accumulators use explicit
-- 32-bit wrapping; normal states satisfy the segment's no-overflow bound.
-- Digest bytes use network order. Retaining a state branches the computation,
-- and all returned byte buffers are fresh. This checksum does not authenticate data.
module Text.Adler32 where

  import Data.Bytes
  import Data.Bytes.Word
  import Data.Machine
  import Data.Nat
  import Data.Result
  import Data.String
  import Data.Wide (wrapping-u128-to-u64, wrapping-shr-u128)
  import Text.Binary

  export adler32-sum, adler32-update
  export Adler32State, adler32-state, adler32-state-update, adler32-state-reset
  export adler32-state-size, adler32-state-block-size, adler32-state-word
  export adler32-state-sum, adler32-state-append, adler32-state-save, adler32-state-append-save, adler32-state-load
  export Adler32StateError, InvalidAdler32StateIdentifier, InvalidAdler32StateSize, adler32-state-error-message

  -- | Checksum all input bytes from the standard initial state 1. Empty input yields 1.
  adler32-sum :: Bytes -> U32
  adler32-sum input = adler32-update 1 input

  -- | Continue a finished checksum with more bytes. Empty input preserves every supplied bit.
  -- Full segments use explicit machine-word wrapping before modular reduction.
  adler32-update :: U32 -> Bytes -> U32
  adler32-update previous input = segments input 0 previous

  -- | Normalize after at most 5552 bytes, bounding ordinary accumulator growth.
  segments :: Bytes -> I64 -> U32 -> U32
  segments input start previous =
    let n = bytes-len-i64 input in
    if 0 <= start && start < n then
      let end = if 5552 <= wrapping-sub-i64 n start then wrapping-add-i64 start 5552 else wrapping-add-i64 n 0 in
      let low0 = bit-and-u32 previous 65535 in
      let high0 = wrapping-shr-u32 previous 16 in
      case accumulate input start end low0 high0 of
        (low, high) -> segments input end (reduce-sums low high)
    else previous

  -- | Advance complete 16-byte blocks and exact tail bytes within one bounded segment.
  -- The weighted sum includes sixteen copies of the preceding low accumulator.
  accumulate :: Bytes -> I64 -> I64 -> U32 -> U32 -> (U32, U32)
  accumulate input i end low high =
    let n = bytes-len-i64 input in
    if 16 <= n then
      let stop = if end <= n then end else wrapping-add-i64 n 0 in
      if 16 <= stop then
        let stop-lim = wrapping-sub-i64 stop 16 in
        let nn = nat-from-i64 n in
        let lim = nn - 16 in
        if 0 <= i && i <= stop-lim && i <= wrapping-sub-i64 n 16 && nat-from-i64 i <= lim then
          let chunk = bytes-load-u128-at input i in
          let w0 = wrapping-u128-to-u64 chunk in
          let w1 = wrapping-u128-to-u64 (wrapping-shr-u128 chunk 64) in
          let sums = adler16 w0 w1 in
          let total = wrapping-u64-to-u32 sums in
          let weighted = wrapping-u64-to-u32 (wrapping-shr-u64 sums 32) in
          accumulate input (wrapping-add-i64 i 16) end
            (wrapping-add-u32 low total)
            (wrapping-add-u32 high (wrapping-add-u32 (wrapping-shl-u32 low 4) weighted))
        else accumulate-tail input i stop low high
      else accumulate-tail input i stop low high
    else accumulate-tail input i end low high

  -- | Finish remaining bytes after the final complete 16-byte block within one segment.
  accumulate-tail :: Bytes -> I64 -> I64 -> U32 -> U32 -> (U32, U32)
  accumulate-tail input i end low high =
    if 0 <= i && i < end && i < bytes-len-i64 input then
      let next = wrapping-add-u32 low (u8-to-u32 (bytes-get-u8-at input i)) in
      accumulate-tail input (wrapping-add-i64 i 1) end next (wrapping-add-u32 high next)
    else (low, high)

  -- | Reduce both unsigned accumulators by the fixed positive modulus and pack the finished checksum.
  reduce-sums :: U32 -> U32 -> U32
  reduce-sums low high =
    bit-or-u32 (wrapping-shl-u32 (rem-u32 high 65521) 16) (rem-u32 low 65521)

  -- | An immutable scalar checksum accumulator; input buffers are never retained.
  data Adler32State where
    -- | Private complete checksum word, including both sixteen-bit accumulator halves.
    AdlerState :: U32 -> Adler32State

  -- | Initial accumulator: low sum 1 and high sum 0.
  adler32-state :: Adler32State
  adler32-state = AdlerState 1

  -- | Consume a complete chunk without changing any earlier retained state or input bytes.
  adler32-state-update :: Adler32State -> Bytes -> Adler32State
  adler32-state-update state input = case state of AdlerState word -> AdlerState (adler32-update word input)

  -- | Return the initial accumulator, leaving the supplied state unchanged.
  adler32-state-reset :: Adler32State -> Adler32State
  adler32-state-reset state = adler32-state

  -- | Digest size in bytes, always four.
  adler32-state-size :: Adler32State -> Nat
  adler32-state-size state = 4

  -- | Preferred input granularity in bytes, always four; updates accept any chunk length.
  adler32-state-block-size :: Adler32State -> Nat
  adler32-state-block-size state = 4

  -- | Observe the complete numeric checksum without advancing the state.
  adler32-state-word :: Adler32State -> U32
  adler32-state-word state = case state of AdlerState word -> word

  -- | Return four fresh checksum bytes in network order without advancing or resetting.
  adler32-state-sum :: Adler32State -> Bytes
  adler32-state-sum state = binary-u32 BigEndian (adler32-state-word state)

  -- | Join two byte intervals in fresh storage without retaining mutable aliases.
  join :: Bytes -> Bytes -> Bytes
  join first last =
    let n = bytes-len first in let out = bytes-new (n + bytes-len last) in
    let a = bytes-copy-range out first 0 0 n in
    let b = bytes-copy-range out last n 0 (bytes-len last) in out

  -- | Append the network-order digest to a copied prefix without changing either argument.
  adler32-state-append :: Bytes -> Adler32State -> Bytes
  adler32-state-append prefix state = join prefix (adler32-state-sum state)

  -- | Return an eight-byte checkpoint: ASCII adl, version byte 1, and the network-order checksum.
  adler32-state-save :: Adler32State -> Bytes
  adler32-state-save state = adler32-state-append (bytes-from-u8s [97, 100, 108, 1]) state

  -- | Append a complete binary checkpoint to a copied prefix, preserving the state.
  adler32-state-append-save :: Bytes -> Adler32State -> Bytes
  adler32-state-append-save prefix state = join prefix (adler32-state-save state)

  -- | A checkpoint identifier or complete byte length is invalid.
  data Adler32StateError where
    -- | The four-byte adl/version identifier is absent or does not match.
    InvalidAdler32StateIdentifier :: Adler32StateError
    -- | Expected complete checkpoint length and actual input length.
    InvalidAdler32StateSize :: Nat -> Nat -> Adler32StateError

  -- | Render a checkpoint diagnostic with the complete required and actual lengths.
  adler32-state-error-message :: Adler32StateError -> String
  adler32-state-error-message error = case error of
    InvalidAdler32StateIdentifier -> "Adler-32 state identifier is invalid"
    InvalidAdler32StateSize expected actual -> string-concat "Adler-32 state requires " (string-concat (nat-to-string expected) (string-concat " bytes; received " (nat-to-string actual)))

  -- | Restore a complete checkpoint without retaining its mutable input buffer.
  -- Identifier checks precede exact-size checks. Every stored word is accepted;
  -- ordinary checksum states should be produced by initialization and updates.
  adler32-state-load :: Bytes -> Result Adler32StateError Adler32State
  adler32-state-load input =
    if 4 <= bytes-len input then
      if bytes-get input 0 == 97 && bytes-get input 1 == 100 && bytes-get input 2 == 108 && bytes-get input 3 == 1 then
        if bytes-len input == 8 then case binary-read-u32 BigEndian input 4 of
          Ok word -> Ok (AdlerState word)
          Err error -> Err (InvalidAdler32StateSize 8 (bytes-len input))
        else Err (InvalidAdler32StateSize 8 (bytes-len input))
      else Err InvalidAdler32StateIdentifier
    else Err InvalidAdler32StateIdentifier

  -- | Reduce sixteen little-endian packed bytes to their sum (low 32 bits) and descending weighted sum (high 32 bits).
  -- Each intermediate 16-bit SWAR lane stays well below 65536, so multiplying by packed weights is exact.
  adler16 :: U64 -> U64 -> U64
  adler16 w0 w1 =
    let even0 = bit-and-u64 w0 0x00FF00FF00FF00FF in
    let odd0 = bit-and-u64 (wrapping-shr-u64 w0 8) 0x00FF00FF00FF00FF in
    let even1 = bit-and-u64 w1 0x00FF00FF00FF00FF in
    let odd1 = bit-and-u64 (wrapping-shr-u64 w1 8) 0x00FF00FF00FF00FF in
    let s0 = wrapping-shr-u64 (wrapping-mul-u64 (wrapping-add-u64 even0 odd0) 0x0001000100010001) 48 in
    let s1 = wrapping-shr-u64 (wrapping-mul-u64 (wrapping-add-u64 even1 odd1) 0x0001000100010001) 48 in
    let total = wrapping-add-u64 s0 s1 in
    let even = wrapping-add-u64 even0 even1 in
    let odd = wrapping-add-u64 odd0 odd1 in
    let w-even = wrapping-shr-u64 (wrapping-mul-u64 even 0x0008000600040002) 48 in
    let w-odd = wrapping-shr-u64 (wrapping-mul-u64 odd 0x0007000500030001) 48 in
    let weighted = wrapping-add-u64 (wrapping-shl-u64 s0 3) (wrapping-add-u64 w-even w-odd) in
    bit-or-u64 total (wrapping-shl-u64 weighted 32)

