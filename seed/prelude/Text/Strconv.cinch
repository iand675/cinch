  -- | Compute the exact 128-bit normalized Eisel-Lemire power-of-5 significand as an unboxed U128 for q in -342..308.
  pow5-wide :: I64 -> U128
  pow5-wide q =
    let idx = wrapping-i64-to-u32 (wrapping-add-i64 q 352) in
    let k-idx = wrapping-shr-u32 idx 4 in
    let r = bit-and-u32 idx 15 in
    let c-hi = pow5-coarse-hi k-idx in
    let c-mid = pow5-coarse-mid k-idx in
    if eq-u32 r 0 then
      let w0 = bit-or-u128 (wrapping-shl-u128 (u64-to-u128 c-hi) 64) (u64-to-u128 c-mid) in
      if lt-i64 q 0 then wrapping-add-u128 w0 1 else w0
    else
      let c-lo = pow5-coarse-lo k-idx in
      let p5r = u64-to-u128 (pow5-small r) in
      let lo-prod = wrapping-mul-u128 (u64-to-u128 c-lo) p5r in
      let mid-prod = wrapping-add-u128 (wrapping-mul-u128 (u64-to-u128 c-mid) p5r) (wrapping-shr-u128 lo-prod 64) in
      let hi-prod = wrapping-add-u128 (wrapping-mul-u128 (u64-to-u128 c-hi) p5r) (wrapping-shr-u128 mid-prod 64) in
      let lz = leading-zeros-u128 hi-prod in
      let sh = wrapping-sub-u32 64 lz in
      let mid-u64 = wrapping-u128-to-u64 mid-prod in
      let w0 = bit-or-u128 (wrapping-shl-u128 hi-prod lz) (u64-to-u128 (wrapping-shr-u64 mid-u64 sh)) in
      if lt-i64 q 0 then wrapping-add-u128 w0 1 else w0

  -- | Check whether mant * 10^q is a provably exact binary halfway tie (for -15 <= q <= 27).
  is-exact-halfway-tie :: U64 -> I64 -> U64 -> Bool
  is-exact-halfway-tie mant q lower =
    if ge-i64 q 0 && le-i64 q 27 then eq-u64 lower 0
    else if ge-i64 q (wrapping-neg-i64 15) && lt-i64 q 0 then
      let d5 = pow5-small (wrapping-i64-to-u32 (wrapping-neg-i64 q)) in
      case checked-rem-u64 mant d5 of
        Some rem -> eq-u64 rem 0
        None -> False
    else False

  -- | Unboxed Eisel-Lemire 128-bit core returning unsigned IEEE-754 bits, or max-bound-u64 when ambiguous.
  eisel-lemire-bits :: U64 -> I64 -> I64 -> I64 -> I64 -> U64 -> U64
  eisel-lemire-bits mant q mant-bits bias max-biased inf-bits =
    let lz32 = leading-zeros-u64 mant in
    let m = wrapping-shl-u64 mant lz32 in
    let w = pow5-wide q in
    let p-hi = wrapping-u128-to-u64 (wrapping-shr-u128 w 64) in
    let p-lo = wrapping-u128-to-u64 w in
    let prod1 = wrapping-mul-u128 (u64-to-u128 m) (u64-to-u128 p-hi) in
    let upper0 = wrapping-u128-to-u64 (wrapping-shr-u128 prod1 64) in
    let lower0 = wrapping-u128-to-u64 prod1 in
    let prod2 = wrapping-mul-u128 (u64-to-u128 m) (u64-to-u128 p-lo) in
    let lo2 = wrapping-u128-to-u64 (wrapping-shr-u128 prod2 64) in
    let lower = wrapping-add-u64 lower0 lo2 in
    let upper = if lt-u64 lower lower0 then wrapping-add-u64 upper0 1 else upper0 in
    let upperbit = wrapping-shr-u64 upper 63 in
    let ub-i64 = wrapping-u64-to-i64 upperbit in
    let base-shift = wrapping-add-i64 ub-i64 (wrapping-sub-i64 61 mant-bits) in
    let exp2 = wrapping-sub-i64 (wrapping-add-i64 (wrapping-add-i64 (wrapping-shr-i64 (wrapping-mul-i64 217706 q) 16) 63) bias) (u32-to-i64 lz32) in
    let biased-exp = wrapping-add-i64 exp2 ub-i64 in
    let mb-u32 = wrapping-i64-to-u32 mant-bits in
    if le-i64 biased-exp 0 then
      let extra = wrapping-sub-i64 1 biased-exp in
      let total-shift = wrapping-add-i64 base-shift extra in
      if gt-i64 total-shift 64 then 0
      else if ge-i64 total-shift 63 then max-bound-u64
      else
        let sh32 = wrapping-i64-to-u32 total-shift in
        let rem-mask = wrapping-sub-u64 (wrapping-shl-u64 1 sh32) 1 in
        let rem = bit-and-u64 upper rem-mask in
        let sig0 = wrapping-shr-u64 upper sh32 in
        if eq-u64 rem rem-mask && ge-u64 lower 18446744073709551614 then max-bound-u64
        else if eq-u64 rem 0 && le-u64 lower 1 && eq-u64 (bit-and-u64 sig0 1) 1 then
          if is-exact-halfway-tie mant q lower then
            let sig = wrapping-shr-u64 (wrapping-add-u64 sig0 (bit-and-u64 (wrapping-shr-u64 sig0 1) 1)) 1 in
            sig
          else max-bound-u64
        else
          let sig = wrapping-shr-u64 (wrapping-add-u64 sig0 1) 1 in
          sig
    else
      let sh32 = wrapping-i64-to-u32 base-shift in
      let rem-mask = wrapping-sub-u64 (wrapping-shl-u64 1 sh32) 1 in
      let rem = bit-and-u64 upper rem-mask in
      let sig0 = wrapping-shr-u64 upper sh32 in
      if eq-u64 rem rem-mask && ge-u64 lower 18446744073709551614 then max-bound-u64
      else if eq-u64 rem 0 && le-u64 lower 1 && eq-u64 (bit-and-u64 sig0 1) 1 then
        if is-exact-halfway-tie mant q lower then
          let sig1 = wrapping-shr-u64 (wrapping-add-u64 sig0 (bit-and-u64 (wrapping-shr-u64 sig0 1) 1)) 1 in
          let top-carry = wrapping-shl-u64 1 (wrapping-add-u32 mb-u32 1) in
          let sig = if eq-u64 sig1 top-carry then wrapping-shr-u64 sig1 1 else sig1 in
          let be = if eq-u64 sig1 top-carry then wrapping-add-i64 biased-exp 1 else biased-exp in
          if ge-i64 be max-biased then inf-bits
          else
            let frac-mask = wrapping-sub-u64 (wrapping-shl-u64 1 mb-u32) 1 in
            bit-or-u64 (wrapping-shl-u64 (wrapping-i64-to-u64 be) mb-u32) (bit-and-u64 sig frac-mask)
        else max-bound-u64
      else
        let sig1 = wrapping-shr-u64 (wrapping-add-u64 sig0 1) 1 in
        let top-carry = wrapping-shl-u64 1 (wrapping-add-u32 mb-u32 1) in
        let sig = if eq-u64 sig1 top-carry then wrapping-shr-u64 sig1 1 else sig1 in
        let be = if eq-u64 sig1 top-carry then wrapping-add-i64 biased-exp 1 else biased-exp in
        if ge-i64 be max-biased then inf-bits
        else
          let frac-mask = wrapping-sub-u64 (wrapping-shl-u64 1 mb-u32) 1 in
          bit-or-u64 (wrapping-shl-u64 (wrapping-i64-to-u64 be) mb-u32) (bit-and-u64 sig frac-mask)

  -- | Fast exact binary64 decimal conversion via Clinger exact path and unboxed Eisel-Lemire.
  -- Returns unsigned IEEE-754 bits (with sign applied), or max-bound-u64 on rare fallback.
  eisel-lemire-f64-bits :: Bool -> U64 -> I64 -> U64
  eisel-lemire-f64-bits neg mant q =
    let sign-bit = if neg then (9223372036854775808 :: U64) else 0 in
    if eq-u64 mant 0 || lt-i64 q (wrapping-neg-i64 342) then sign-bit
    else if gt-i64 q 308 then bit-or-u64 sign-bit 9218868437227405312
    else if le-u64 mant 9007199254740992 && ge-i64 q (wrapping-neg-i64 22) && le-i64 q 22 then
      let f = u64-to-f64 mant in
      let mag = if ge-i64 q 0 then mul-f64 f (pow10-f64-exact q) else div-f64 f (pow10-f64-exact (wrapping-neg-i64 q)) in
      bit-or-u64 sign-bit (f64-bits mag)
    else
      let raw = eisel-lemire-bits mant q 52 1023 2047 9218868437227405312 in
      if eq-u64 raw max-bound-u64 then max-bound-u64
      else bit-or-u64 sign-bit raw

  -- | Fast exact binary32 decimal conversion via Clinger exact path and unboxed single-rounded Eisel-Lemire.
  -- Returns unsigned IEEE-754 bits (with sign applied in low 32 bits), or max-bound-u64 on rare fallback.
  eisel-lemire-f32-bits :: Bool -> U64 -> I64 -> U64
  eisel-lemire-f32-bits neg mant q =
    let sign-bit = if neg then (2147483648 :: U64) else 0 in
    if eq-u64 mant 0 || lt-i64 q (wrapping-neg-i64 65) then sign-bit
    else if gt-i64 q 38 then bit-or-u64 sign-bit 2139095040
    else if le-u64 mant 16777216 && ge-i64 q (wrapping-neg-i64 10) && le-i64 q 10 then
      let f = u64-to-f32 mant in
      let mag = if ge-i64 q 0 then mul-f32 f (pow10-f32-exact q) else div-f32 f (pow10-f32-exact (wrapping-neg-i64 q)) in
      bit-or-u64 sign-bit (u32-to-u64 (f32-bits mag))
    else
      let raw = eisel-lemire-bits mant q 23 127 255 2139095040 in
      if eq-u64 raw max-bound-u64 then max-bound-u64
      else bit-or-u64 sign-bit raw

  -- | Parse a binary64 float prefix from buf[start..end), returning value, next index, and overflow flag.
  parse-float64-prefix :: Bytes -> Nat -> Nat -> Option (F64, Nat, Bool)
  parse-float64-prefix buf start end =
    case scan-float-token buf start end of
      None -> None
      Some tok -> case tok of
        TokSpecial v next -> Some (v, next, False)
        TokHex neg mant exp trunc next ->
          case hex-to-ieee-bits neg mant exp trunc 52 11 (wrapping-neg-i64 1023) of
            (bits, ovf) -> Some (f64-from-bits bits, next, ovf)
        TokDec s0 e0 neg has-us mant q trunc ->
          if not trunc then
            let bits = eisel-lemire-f64-bits neg mant q in
            if ne-u64 bits max-bound-u64 then
              let ovf = eq-u64 (bit-and-u64 bits 9223372036854775807) 9218868437227405312 in
              Some (f64-from-bits bits, e0, ovf)
            else
              let clean = if has-us then strip-dec-bytes buf s0 e0 False else bytes-slice buf s0 e0 in
              let v = f64-from-decimal clean in
              Some (v, e0, is-inf-f64 v 0)
          else
            let clean = if has-us then strip-dec-bytes buf s0 e0 False else bytes-slice buf s0 e0 in
            let v = f64-from-decimal clean in
            Some (v, e0, is-inf-f64 v 0)

  -- | Parse a binary32 float prefix from buf[start..end), returning value, next index, and overflow flag.
  parse-float32-prefix :: Bytes -> Nat -> Nat -> Option (F32, Nat, Bool)
  parse-float32-prefix buf start end =
    case scan-float-token buf start end of
      None -> None
      Some tok -> case tok of
        TokSpecial v next -> Some (f64-to-f32 v, next, False)
        TokHex neg mant exp trunc next ->
          case hex-to-ieee-bits neg mant exp trunc 23 8 (wrapping-neg-i64 127) of
            (bits, ovf) -> Some (f32-from-bits (wrapping-u64-to-u32 bits), next, ovf)
        TokDec s0 e0 neg _ mant q trunc ->
          if not trunc then
            let bits = eisel-lemire-f32-bits neg mant q in
            if ne-u64 bits max-bound-u64 then
              let b32 = wrapping-u64-to-u32 bits in
              let ovf = eq-u32 (bit-and-u32 b32 2147483647) 2139095040 in
              Some (f32-from-bits b32, e0, ovf)
            else parse-float32-slow buf s0 e0 neg
          else parse-float32-slow buf s0 e0 neg

  -- | Exact multiprecision fallback for ambiguous or truncated binary32 decimal inputs.
  parse-float32-slow :: Bytes -> Nat -> Nat -> Bool -> Option (F32, Nat, Bool)
  parse-float32-slow buf s0 e0 neg =
    let clean = strip-dec-bytes buf s0 e0 True in
    let exact = parse-exact-dec-unsigned clean in
    let sign-bit = if neg then (2147483648 :: U32) else 0 in
    case exact of
      ExactDec digs dp ->
        if bytes-len digs == 0 then
          Some (f32-from-bits sign-bit, e0, False)
        else if dp > 40 then
          Some (f32-from-bits (bit-or-u32 sign-bit 2139095040), e0, True)
        else if dp < -47 then
          Some (f32-from-bits sign-bit, e0, False)
        else
          let approx = bit-and-u32 (f32-bits (f64-to-f32 (f64-from-decimal clean))) 2147483647 in
          case correct-f32-bits exact approx of
            (mag-bits, ovf) -> Some (f32-from-bits (bit-or-u32 sign-bit mag-bits), e0, ovf)

  -- | Parse a binary64 float, returning ±Inf alongside StrconvRange on overflow.
  parse-float64-with-clamp :: String -> (F64, Option StrconvError)
  parse-float64-with-clamp s =
    let buf = string-to-bytes s in
    let len = bytes-len buf in
    case parse-float64-prefix buf 0 len of
      None -> (0, Some StrconvSyntax)
      Some (v, next, ovf) ->
        if next /= len then (0, Some StrconvSyntax)
        else if ovf then (v, Some StrconvRange)
        else (v, None)

  -- | Parse a binary64 floating-point number (decimal, hexadecimal, NaN, or ±Inf/Infinity).
  parse-float64 :: String -> Result StrconvError F64
  parse-float64 s = case parse-float64-with-clamp s of
    (v, None) -> Ok v
    (_, Some e) -> Err e

  -- | Parse a binary32 float, returning ±Inf alongside StrconvRange on overflow.
  parse-float32-with-clamp :: String -> (F32, Option StrconvError)
  parse-float32-with-clamp s =
    let buf = string-to-bytes s in
    let len = bytes-len buf in
    case parse-float32-prefix buf 0 len of
      None -> (0, Some StrconvSyntax)
      Some (v, next, ovf) ->
        if next /= len then (0, Some StrconvSyntax)
        else if ovf then (v, Some StrconvRange)
        else (v, None)

  -- | Parse a binary32 floating-point number with exact single-rounding IEEE-754 semantics.
  parse-float32 :: String -> Result StrconvError F32
  parse-float32 s = case parse-float32-with-clamp s of
    (v, None) -> Ok v
    (_, Some e) -> Err e

  -- ---------------------------------------------------------------------
  -- Complex number parsing and formatting.
  -- ---------------------------------------------------------------------

  -- | Parse a 128-bit complex number (pair of F64), returning clamped components alongside StrconvRange on overflow.
  parse-complex128-with-clamp :: String -> ((F64, F64), Option StrconvError)
  parse-complex128-with-clamp s =
    let buf = string-to-bytes s in
    let len = bytes-len buf in
    let parens = len >= 2 && bytes-get buf 0 == 40 && bytes-get buf (len - 1) == 41 in
    let start = if parens then (1 :: Nat) else 0 in
    let end = if parens && len >= 1 then len - 1 else len in
    case parse-float64-prefix buf start end of
      None -> ((0, 0), Some StrconvSyntax)
      Some (re, pos, ovf1) ->
        if pos == end then ((re, 0), if ovf1 then Some StrconvRange else None)
        else if pos >= bytes-len buf then ((0, 0), Some StrconvSyntax)
        else
          let sep = bytes-get buf pos in
          if sep == 105 then
            if pos + 1 == end then ((0, re), if ovf1 then Some StrconvRange else None)
            else ((0, 0), Some StrconvSyntax)
          else if sep == 43 || sep == 45 then
            let im-start = (if sep == 43 && pos + 1 < end && pos + 1 < bytes-len buf && bytes-get buf (pos + 1) /= 43 then pos + 1 else pos) in
            case parse-float64-prefix buf im-start end of
              None -> ((0, 0), Some StrconvSyntax)
              Some (im, pos2, ovf2) ->
                if pos2 + 1 == end && pos2 < bytes-len buf && bytes-get buf pos2 == 105 then
                  ((re, im), if ovf1 || ovf2 then Some StrconvRange else None)
                else ((0, 0), Some StrconvSyntax)
          else ((0, 0), Some StrconvSyntax)

  -- | Parse a 128-bit complex number of the form N, Ni, or N±Ni (optionally parenthesized).
  parse-complex128 :: String -> Result StrconvError (F64, F64)
  parse-complex128 s = case parse-complex128-with-clamp s of
    (v, None) -> Ok v
    (_, Some e) -> Err e

  -- | Parse a 64-bit complex number (pair of F32), returning clamped components alongside StrconvRange on overflow.
  parse-complex64-with-clamp :: String -> ((F32, F32), Option StrconvError)
  parse-complex64-with-clamp s =
    let buf = string-to-bytes s in
    let len = bytes-len buf in
    let parens = len >= 2 && bytes-get buf 0 == 40 && bytes-get buf (len - 1) == 41 in
    let start = if parens then (1 :: Nat) else 0 in
    let end = if parens && len >= 1 then len - 1 else len in
    case parse-float32-prefix buf start end of
      None -> ((0, 0), Some StrconvSyntax)
      Some (re, pos, ovf1) ->
        if pos == end then ((re, 0), if ovf1 then Some StrconvRange else None)
        else if pos >= bytes-len buf then ((0, 0), Some StrconvSyntax)
        else
          let sep = bytes-get buf pos in
          if sep == 105 then
            if pos + 1 == end then ((0, re), if ovf1 then Some StrconvRange else None)
            else ((0, 0), Some StrconvSyntax)
          else if sep == 43 || sep == 45 then
            let im-start = (if sep == 43 && pos + 1 < end && pos + 1 < bytes-len buf && bytes-get buf (pos + 1) /= 43 then pos + 1 else pos) in
            case parse-float32-prefix buf im-start end of
              None -> ((0, 0), Some StrconvSyntax)
              Some (im, pos2, ovf2) ->
                if pos2 + 1 == end && pos2 < bytes-len buf && bytes-get buf pos2 == 105 then
                  ((re, im), if ovf1 || ovf2 then Some StrconvRange else None)
                else ((0, 0), Some StrconvSyntax)
          else ((0, 0), Some StrconvSyntax)

  -- | Parse a 64-bit complex number of the form N, Ni, or N±Ni (optionally parenthesized).
  parse-complex64 :: String -> Result StrconvError (F32, F32)
  parse-complex64 s = case parse-complex64-with-clamp s of
    (v, None) -> Ok v
    (_, Some e) -> Err e

  -- | Wrap formatted real and imaginary strings into "(a+bi)".
  wrap-complex-strings :: String -> String -> String
  wrap-complex-strings re-str im-str =
    let im-bytes = string-to-bytes im-str in
    let needs-plus = bytes-len im-bytes == 0 || (bytes-get im-bytes 0 /= 43 && bytes-get im-bytes 0 /= 45) in
    let b0 = builder-add-byte 40 builder-new in
    let b1 = builder-add-string re-str b0 in
    let b2 = if needs-plus then builder-add-byte 43 b1 else b1 in
    let b3 = builder-add-string im-str b2 in
    let b4 = builder-add-two 105 41 b3 in
    builder-run b4

  -- | Format a 128-bit complex number (real, imag) as "(a+bi)".
  format-complex128 :: (F64, F64) -> Char -> I64 -> Result StrconvError String
  format-complex128 pair fmt prec = case pair of
    (re, im) -> case format-float64 re fmt prec of
      Err e -> Err e
      Ok rs -> case format-float64 im fmt prec of
        Err e -> Err e
        Ok is -> Ok (wrap-complex-strings rs is)

  -- | Format a 64-bit complex number (real, imag) as "(a+bi)".
  format-complex64 :: (F32, F32) -> Char -> I64 -> Result StrconvError String
  format-complex64 pair fmt prec = case pair of
    (re, im) -> case format-float32 re fmt prec of
      Err e -> Err e
      Ok rs -> case format-float32 im fmt prec of
        Err e -> Err e
        Ok is -> Ok (wrap-complex-strings rs is)

  -- ---------------------------------------------------------------------
  -- Rune classification and quoting / unquoting.
  -- ---------------------------------------------------------------------

  -- | Report whether a Unicode scalar is printable (letters, marks, numbers, punctuation, symbols, and ASCII space).
  is-print :: Char -> Bool
  is-print c = unicode-is-print c

  -- | Report whether a Unicode scalar is a Unicode graphic character (categories L, M, N, P, S, and Zs).
  is-graphic :: Char -> Bool
  is-graphic c = unicode-is-graphic c

  -- | Printable predicate on a scalar code point as Nat.
  is-print-nat :: Nat -> Bool
  is-print-nat cp =
    if cp <= 1114111 then unicode-is-print-code (wrapping-i64-to-i32 (nat-to-i64 cp))
    else False

  -- | Graphic predicate on a scalar code point as Nat.
  is-graphic-nat :: Nat -> Bool
  is-graphic-nat cp =
    if cp <= 1114111 then unicode-is-graphic-code (wrapping-i64-to-i32 (nat-to-i64 cp))
    else False

  -- | Append `\xNN` escape for a single byte.
  builder-add-hex2 :: Nat -> Builder -> Builder
  builder-add-hex2 b acc =
    let buf = bytes-new 4 in
    let u0 = bytes-set buf 0 92 in
    let u1 = bytes-set buf 1 120 in
    let u2 = bytes-set buf 2 (hex-nibble-byte (nat-rem (nat-div b 16) 16) False) in
    let u3 = bytes-set buf 3 (hex-nibble-byte (nat-rem b 16) False) in
    builder-add-bytes buf acc

  -- | Append `\uNNNN` escape for a BMP code point.
  builder-add-hex4 :: Nat -> Builder -> Builder
  builder-add-hex4 cp acc =
    let buf = bytes-new 6 in
    let u0 = bytes-set buf 0 92 in
    let u1 = bytes-set buf 1 117 in
    let u2 = bytes-set buf 2 (hex-nibble-byte (nat-rem (nat-div cp 4096) 16) False) in
    let u3 = bytes-set buf 3 (hex-nibble-byte (nat-rem (nat-div cp 256) 16) False) in
    let u4 = bytes-set buf 4 (hex-nibble-byte (nat-rem (nat-div cp 16) 16) False) in
    let u5 = bytes-set buf 5 (hex-nibble-byte (nat-rem cp 16) False) in
    builder-add-bytes buf acc

  -- | Append `\UNNNNNNNN` escape for a supplementary code point.
  builder-add-hex8 :: Nat -> Builder -> Builder
  builder-add-hex8 cp acc =
    let buf = bytes-new 10 in
    let u0 = bytes-set buf 0 92 in
    let u1 = bytes-set buf 1 85 in
    let u2 = bytes-set buf 2 (hex-nibble-byte (nat-rem (nat-div cp 268435456) 16) False) in
    let u3 = bytes-set buf 3 (hex-nibble-byte (nat-rem (nat-div cp 16777216) 16) False) in
    let u4 = bytes-set buf 4 (hex-nibble-byte (nat-rem (nat-div cp 1048576) 16) False) in
    let u5 = bytes-set buf 5 (hex-nibble-byte (nat-rem (nat-div cp 65536) 16) False) in
    let u6 = bytes-set buf 6 (hex-nibble-byte (nat-rem (nat-div cp 4096) 16) False) in
    let u7 = bytes-set buf 7 (hex-nibble-byte (nat-rem (nat-div cp 256) 16) False) in
    let u8 = bytes-set buf 8 (hex-nibble-byte (nat-rem (nat-div cp 16) 16) False) in
    let u9 = bytes-set buf 9 (hex-nibble-byte (nat-rem cp 16) False) in
    builder-add-bytes buf acc

  -- | Append one escaped scalar value to a Builder according to delimiter, ASCII-only, and graphic-only flags.
  append-escaped-cp :: Nat -> InRange 0 255 Nat -> Bool -> Bool -> Builder -> Builder
  append-escaped-cp cp delim ascii-only graphic-only acc =
    if cp == delim || cp == 92 then
      builder-add-two 92 (if cp < 256 then cp else 92) acc
    else if ascii-only && cp < 128 && is-print-nat cp then
      builder-add-byte cp acc
    else if not ascii-only && (is-print-nat cp || (graphic-only && is-graphic-nat cp)) then
      builder-add-utf8-cp cp acc
    else if cp == 7 then builder-add-two 92 97 acc
    else if cp == 8 then builder-add-two 92 98 acc
    else if cp == 12 then builder-add-two 92 102 acc
    else if cp == 10 then builder-add-two 92 110 acc
    else if cp == 13 then builder-add-two 92 114 acc
    else if cp == 9 then builder-add-two 92 116 acc
    else if cp == 11 then builder-add-two 92 118 acc
    else if cp < 32 || cp == 127 then builder-add-hex2 cp acc
    else if cp < 65536 then builder-add-hex4 cp acc
    else builder-add-hex8 cp acc

  -- | Tail-recursive quoting loop over raw bytes, escaping invalid UTF-8 bytes as `\xNN`.
  quote-bytes-loop :: Bytes -> Nat -> InRange 0 255 Nat -> Bool -> Bool -> Builder -> Builder
  quote-bytes-loop buf i delim ascii-only graphic-only acc =
    if i >= bytes-len buf then acc
    else
      let b0 = bytes-get buf i in
      if b0 < 128 then
        quote-bytes-loop buf (i + 1) delim ascii-only graphic-only (append-escaped-cp b0 delim ascii-only graphic-only acc)
      else case utf8-at buf i of
        Some (ch, width) ->
          let cp = char-code ch in
          quote-bytes-loop buf (i + width) delim ascii-only graphic-only (append-escaped-cp cp delim ascii-only graphic-only acc)
        None ->
          quote-bytes-loop buf (i + 1) delim ascii-only graphic-only (builder-add-hex2 b0 acc)

  -- | Quote raw bytes into a double-quoted literal string.
  quote-bytes-with :: Bytes -> Bool -> Bool -> String
  quote-bytes-with buf ascii-only graphic-only =
    let b0 = builder-add-byte 34 builder-new in
    let b1 = quote-bytes-loop buf 0 34 ascii-only graphic-only b0 in
    builder-run (builder-add-byte 34 b1)

  -- | Return a double-quoted literal representing raw bytes, escaping control, non-printable, and invalid UTF-8 bytes.
  quote-bytes :: Bytes -> String
  quote-bytes buf = quote-bytes-with buf False False

  -- | Return an ASCII-only double-quoted literal representing raw bytes.
  quote-bytes-to-ascii :: Bytes -> String
  quote-bytes-to-ascii buf = quote-bytes-with buf True False

  -- | Return a double-quoted literal preserving Unicode graphic characters and escaping non-graphic or invalid bytes.
  quote-bytes-to-graphic :: Bytes -> String
  quote-bytes-to-graphic buf = quote-bytes-with buf False True

  -- | Return a double-quoted string literal escaping control and non-printable characters.
  quote :: String -> String
  quote s = quote-bytes-with (string-to-bytes s) False False

  -- | Return a double-quoted ASCII-only string literal escaping non-ASCII and non-printable characters.
  quote-to-ascii :: String -> String
  quote-to-ascii s = quote-bytes-with (string-to-bytes s) True False

  -- | Return a double-quoted string literal preserving Unicode graphic characters and escaping non-graphic characters.
  quote-to-graphic :: String -> String
  quote-to-graphic s = quote-bytes-with (string-to-bytes s) False True

  -- | Append the double-quoted literal of a string to a byte buffer.
  append-quote :: Bytes -> String -> Bytes
  append-quote dst s = append-raw-string dst (quote s)

  -- | Append the ASCII-only double-quoted literal of a string to a byte buffer.
  append-quote-to-ascii :: Bytes -> String -> Bytes
  append-quote-to-ascii dst s = append-raw-string dst (quote-to-ascii s)

  -- | Append the graphic-preserving double-quoted literal of a string to a byte buffer.
  append-quote-to-graphic :: Bytes -> String -> Bytes
  append-quote-to-graphic dst s = append-raw-string dst (quote-to-graphic s)

  -- | Quote a single Unicode scalar into a single-quoted character literal.
  quote-rune-with :: Char -> Bool -> Bool -> String
  quote-rune-with c ascii-only graphic-only =
    let b0 = builder-add-byte 39 builder-new in
    let b1 = append-escaped-cp (char-code c) 39 ascii-only graphic-only b0 in
    builder-run (builder-add-byte 39 b1)

  -- | Return a single-quoted character literal representing a Unicode scalar.
  quote-rune :: Char -> String
  quote-rune c = quote-rune-with c False False

  -- | Return an ASCII-only single-quoted character literal representing a Unicode scalar.
  quote-rune-to-ascii :: Char -> String
  quote-rune-to-ascii c = quote-rune-with c True False

  -- | Return a single-quoted character literal preserving Unicode graphic scalars.
  quote-rune-to-graphic :: Char -> String
  quote-rune-to-graphic c = quote-rune-with c False True

  -- | Append the single-quoted literal of a character to a byte buffer.
  append-quote-rune :: Bytes -> Char -> Bytes
  append-quote-rune dst c = append-raw-string dst (quote-rune c)

  -- | Append the ASCII-only single-quoted literal of a character to a byte buffer.
  append-quote-rune-to-ascii :: Bytes -> Char -> Bytes
  append-quote-rune-to-ascii dst c = append-raw-string dst (quote-rune-to-ascii c)

  -- | Append the graphic-preserving single-quoted literal of a character to a byte buffer.
  append-quote-rune-to-graphic :: Bytes -> Char -> Bytes
  append-quote-rune-to-graphic dst c = append-raw-string dst (quote-rune-to-graphic c)

  -- | Report whether a string can be represented unchanged as a single-line backquoted literal without control characters other than tab.
  can-backquote :: String -> Bool
  can-backquote s =
    let buf = string-to-bytes s in
    can-backquote-loop buf 0

  -- | Tail-recursive UTF-8 scan checking backquote eligibility.
  can-backquote-loop :: Bytes -> Nat -> Bool
  can-backquote-loop buf i =
    if i >= bytes-len buf then True
    else
      let b0 = bytes-get buf i in
      if b0 < 128 then
        if (b0 < 32 && b0 /= 9) || b0 == 96 || b0 == 127 then False
        else can-backquote-loop buf (i + 1)
      else case utf8-at buf i of
        None -> False
        Some (ch, width) ->
          if char-code ch == 65279 then False
          else can-backquote-loop buf (i + width)

  -- | Parse exactly `count` hexadecimal digits starting at `i` in `buf`.
  parse-fixed-hex :: Bytes -> Nat -> Nat -> Nat -> Option Nat
  parse-fixed-hex buf i count acc =
    if count == 0 then Some acc
    else if i >= bytes-len buf then None
    else case hex-byte-val (bytes-get buf i) of
      None -> None
      Some d -> parse-fixed-hex buf (i + 1) (count - 1) (acc * 16 + d)

  -- | Decode one escaped or raw character from `buf` starting at `i`, returning (codepoint, multibyte, next-index).
  unquote-char-at :: Bytes -> Nat -> Nat -> Result StrconvError (Nat, Bool, Nat)
  unquote-char-at buf i q =
    if i >= bytes-len buf then Err StrconvSyntax
    else
      let b0 = bytes-get buf i in
      if b0 == q && (q == 39 || q == 34) then Err StrconvSyntax
      else if b0 >= 128 then
        case utf8-at buf i of
          Some (ch, w) -> Ok (char-code ch, True, i + w)
          None -> Ok (65533, True, i + 1)
      else if b0 /= 92 then
        Ok (b0, False, i + 1)
      else if i + 1 >= bytes-len buf then Err StrconvSyntax
      else
        let c = bytes-get buf (i + 1) in
        let after = i + 2 in
        if c == 97 then Ok (7, False, after)
        else if c == 98 then Ok (8, False, after)
        else if c == 102 then Ok (12, False, after)
        else if c == 110 then Ok (10, False, after)
        else if c == 114 then Ok (13, False, after)
        else if c == 116 then Ok (9, False, after)
        else if c == 118 then Ok (11, False, after)
        else if c == 92 then Ok (92, False, after)
        else if c == 39 || c == 34 then
          if c == q then Ok (c, False, after)
          else Err StrconvSyntax
        else if c == 120 then
          case parse-fixed-hex buf after 2 0 of
            Some v -> Ok (v, False, after + 2)
            None -> Err StrconvSyntax
        else if c == 117 then
          case parse-fixed-hex buf after 4 0 of
            Some v ->
              case char-from-code v of
                Some _ -> Ok (v, True, after + 4)
                None -> Err StrconvSyntax
            None -> Err StrconvSyntax
        else if c == 85 then
          case parse-fixed-hex buf after 8 0 of
            Some v ->
              case char-from-code v of
                Some _ -> Ok (v, True, after + 8)
                None -> Err StrconvSyntax
            None -> Err StrconvSyntax
        else if c >= 48 && c <= 55 then
          if after + 2 > bytes-len buf then Err StrconvSyntax
          else
            let c1 = bytes-get buf after in
            let c2 = bytes-get buf (after + 1) in
            if c1 < 48 || c1 > 55 || c2 < 48 || c2 > 55 then Err StrconvSyntax
            else
              let v = (c - 48) * 64 + (c1 - 48) * 8 + (c2 - 48) in
              if v > 255 then Err StrconvSyntax
              else Ok (v, False, after + 2)
        else Err StrconvSyntax

  -- | Decode the first character or byte escape in a quoted literal body.
  -- Returns the decoded character, whether it requires multibyte UTF-8 encoding, and the remaining tail string.
  unquote-char :: String -> Char -> Result StrconvError (Char, Bool, String)
  unquote-char s quote-ch =
    let buf = string-to-bytes s in
    let q = char-code quote-ch in
    case unquote-char-at buf 0 q of
      Err e -> Err e
      Ok (cp, mb, next) ->
        case char-from-code cp of
          None -> Err StrconvSyntax
          Some ch ->
            let tail-bytes = bytes-slice buf next (bytes-len buf) in
            case string-from-bytes tail-bytes of
              Some tail -> Ok (ch, mb, tail)
              None -> Err StrconvSyntax

  -- | Find the first occurrence of byte `needle` in `buf` at or after `i`.
  find-byte-from :: Bytes -> Nat -> Nat -> Option Nat
  find-byte-from buf i needle =
    if i >= bytes-len buf then None
    else if bytes-get buf i == needle then Some i
    else find-byte-from buf (i + 1) needle

  -- | Copy bytes in [start, end) while stripping carriage returns ('\r').
  strip-cr-loop :: Bytes -> Nat -> Nat -> Builder -> Bytes
  strip-cr-loop buf i end acc =
    if i >= end || i >= bytes-len buf then builder-bytes acc
    else
      let c = bytes-get buf i in
      if c == 13 then strip-cr-loop buf (i + 1) end acc
      else strip-cr-loop buf (i + 1) end (builder-add-byte c acc)

  -- | Parse a single-quoted, double-quoted, or backquoted prefix of `buf`, returning (unescaped-or-raw bytes, end-index).
  unquote-prefix-core :: Bytes -> Bool -> Result StrconvError (Bytes, Nat)
  unquote-prefix-core buf unescape =
    let len = bytes-len buf in
    if len < 2 then Err StrconvSyntax
    else
      let q = bytes-get buf 0 in
      if q == 96 then
        case find-byte-from buf 1 96 of
          None -> Err StrconvSyntax
          Some close-idx ->
            let end = close-idx + 1 in
            if not unescape then Ok (bytes-slice buf 0 end, end)
            else Ok (strip-cr-loop buf 1 close-idx builder-new, end)
      else if q == 34 || q == 39 then
        unquote-quoted-loop buf 1 q unescape builder-new
      else Err StrconvSyntax

  -- | Tail-recursive loop scanning and optionally unescaping characters inside a single- or double-quoted literal.
  unquote-quoted-loop :: Bytes -> Nat -> Nat -> Bool -> Builder -> Result StrconvError (Bytes, Nat)
  unquote-quoted-loop buf i q unescape acc =
    if i >= bytes-len buf then Err StrconvSyntax
    else
      let c = bytes-get buf i in
      if c == q then
        let end = i + 1 in
        if unescape then Ok (builder-bytes acc, end)
        else Ok (bytes-slice buf 0 end, end)
      else if c == 10 then Err StrconvSyntax
      else case unquote-char-at buf i q of
        Err e -> Err e
        Ok (cp, mb, next) ->
          let next-acc = (if not unescape then acc else if cp < 128 || not mb then builder-add-byte (if cp < 256 then cp else 0) acc else builder-add-utf8-cp cp acc) in
          if q == 39 then
            if next < bytes-len buf && bytes-get buf next == 39 then
              let end = next + 1 in
              if unescape then Ok (builder-bytes next-acc, end)
              else Ok (bytes-slice buf 0 end, end)
            else Err StrconvSyntax
          else unquote-quoted-loop buf next q unescape next-acc

  -- | Return the verbatim quoted string literal at the prefix of `s`.
  quoted-prefix :: String -> Result StrconvError String
  quoted-prefix s =
    let buf = string-to-bytes s in
    case unquote-prefix-core buf False of
      Err e -> Err e
      Ok (out, _) ->
        case string-from-bytes out of
          Some text -> Ok text
          None -> Err StrconvSyntax

  -- | Interpret a single-quoted, double-quoted, or backquoted literal, returning its exact unescaped bytes.
  unquote-bytes :: String -> Result StrconvError Bytes
  unquote-bytes s =
    let buf = string-to-bytes s in
    case unquote-prefix-core buf True of
      Err e -> Err e
      Ok (out, end) ->
        if end == bytes-len buf then Ok out
        else Err StrconvSyntax

  -- | Interpret a single-quoted, double-quoted, or backquoted literal as a UTF-8 string.
  unquote :: String -> Result StrconvError String
  unquote s = case unquote-bytes s of
    Err e -> Err e
    Ok raw ->
      case string-from-bytes raw of
        Some text -> Ok text
        None -> Err StrconvSyntax
