  -- | Bottom 64 bits of 192-bit normalized 5^(16*(k-22)) for k in 0..41.
  pow5-coarse-lo :: U32 -> U64
  pow5-coarse-lo k = case k of
    0 -> 8779370984975028652
    1 -> 3907751376965190627
    2 -> 12366792864984564804
    3 -> 9609203491930720603
    4 -> 13761443712501013150
    5 -> 1864104448039968717
    6 -> 11690833164181629133
    7 -> 16947191973758740733
    8 -> 5046754370605664823
    9 -> 8698609474967593155
    10 -> 2043016374578554469
    11 -> 17375326254472978276
    12 -> 10368891985241138894
    13 -> 14693917494923880210
    14 -> 16315598095635316731
    15 -> 12252412348221138266
    16 -> 7569440132901066223
    17 -> 152463534806234530
