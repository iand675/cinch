    11 -> 11679847981112819759
    12 -> 12967236152753102995
    13 -> 14396524142538228424
    14 -> 15983352577617880224
    15 -> 17745086042373215101
    16 -> 9850501549098619803
    17 -> 10936253623915059621
    18 -> 12141680576410806693
    19 -> 13479973333575319897
    20 -> 14965776766268445882
    21 -> 16615349947311448411
    22 -> 9223372036854775808
    23 -> 10240000000000000000
    24 -> 11368683772161602973
    25 -> 12621774483536188886
    26 -> 14012984643248170709
    27 -> 15557538194652854267
    28 -> 17272337110188889250
    29 -> 9588073174409622174
    30 -> 10644899600020376799
    31 -> 11818212630765741799
    32 -> 13120851772591970218
    33 -> 14567071740625403795
    34 -> 16172698447808779626
    35 -> 17955302187076837701
    36 -> 9967194951097567535
    37 -> 11065809325636130661
    38 -> 12285516299433008781
    39 -> 13639663065038175362
    40 -> 15143067982934716300
    41 -> 16812182738118149117
    _ -> 0

  -- | Middle 64 bits of 192-bit normalized 5^(16*(k-22)) for k in 0..41.
  pow5-coarse-mid :: U32 -> U64
  pow5-coarse-mid k = case k of
    0 -> 41224521807705895
    1 -> 18238200953240460069
    2 -> 9881091751837770420
    3 -> 11524923151806696212
    4 -> 5684501474941004850
    5 -> 15722703350174969551
    6 -> 18055231442152805128
    7 -> 18094982380531485284
    8 -> 11887461593424094248
    9 -> 4776009810824339053
    10 -> 8890957387685944783
    11 -> 13307468457454889596
    12 -> 6479872166822743894
    13 -> 18330958004207980480
    14 -> 12429006944274865118
    15 -> 5568164059729762005
    16 -> 1286845328412881940
    17 -> 15910522178918405146
    18 -> 4549648098962661924
    19 -> 6152128301777116498
    20 -> 7484447039699372786
    21 -> 5489534351736154547
    22 -> 0
    23 -> 0
    24 -> 17302829768357445632
    25 -> 10840359103457460224
    26 -> 4377335499248575995
    27 -> 15867153862612478214
    28 -> 14253867870959833118
