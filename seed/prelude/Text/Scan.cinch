-- Text.Scan: the literal-string scanning and formatting utilities
-- (the Ruby String surface, redesigned where our principles say so).
--
-- All scanning operates directly on UTF-8 `Bytes` with unboxed `I64`/`U64`
-- indices and 128-bit SIMD acceleration (Muła's first+last byte substring
-- filter, SIMD single-byte scan, SIMD UTF-8 non-continuation scalar counting,
-- and SIMD ASCII case mapping). Every in-place buffer mutation threads the
-- destination buffer strictly through `%1` linear ownership (`Bytes %1 -> ... -> Bytes`)
-- so Cinch's static usage checker proves single-owner non-aliased mutation on
-- every control-flow path.
--
-- SCANNING (the subject-last argument order throughout: the needle,
-- separator or pattern names what happens, the subject is last):
--   `string-index-of` / `string-contains` / `string-starts-with` /
--   `string-ends-with` over scalar indices; `string-char-index-of`
--   for a single scalar; `string-split-on` (an empty separator splits
--   into single scalars, Ruby's `split("")`); `string-join`;
--   `string-lines` (splits at LF; a single trailing empty line is
--   dropped) and its inverse `string-unlines` (each line followed by
--   LF); `string-words` (ASCII whitespace runs) and its inverse
--   `string-unwords` (single-space join); `string-take` /
--   `string-drop` / `string-split-at` cutting at a scalar count, and
--   `string-take-while` / `string-drop-while` cutting at a scalar
--   predicate. Prefix and suffix tests ARE `string-starts-with` /
--   `string-ends-with` (no separate `is-prefix-of` spelling).
--
-- FORMATTING: `format` is the template interpolation (`{}` consumes
--   the next argument in order, `{{` and `}}` are literal braces;
--   this replaces sprintf-style `%` formatting on purpose: the
--   arguments' types do the rendering through `Text.Show`).
--   `string-pad-left` / `string-pad-right` / `string-center` pad to
--   a scalar width with spaces; `string-strip` / `string-lstrip` /
--   `string-rstrip` / `string-chomp` / `string-chop` trim; the case
--   family maps ASCII letters only. The regex-driven scanning family
--   (scan, split, replace) rides the engine in `Text.Regex`.
--
-- UNICODE SCOPE, named honestly at the UTF-8 layers' boundary:
-- every operation here is scalar-value aware (indices are scalar
-- indices, lengths are scalar counts, slices cut at scalar
-- boundaries). What is NOT here: canonical normalization
-- (NFC/NFD/NFKC/NFKD) and grapheme clusters (the UTF-8 machinery
-- carries no Unicode character database), Unicode or locale-aware
-- case mapping (`string-upcase-ascii` and friends map A-Z/a-z only
-- and leave every other scalar untouched), and non-ASCII whitespace
-- classes. `string-normalize-newlines` is the one normalization
-- provided: CRLF and lone CR line endings fold to LF.
module Text.Scan where

  import Data.Nat
  import Data.List
  import Data.Option
  import Data.Result
  import Data.Char
  import Data.Bool
  import Data.Bytes
  import Data.String
  import Data.Machine
  import Data.Wide (bit-and-u128, bit-xor-u128, simd-u8x16-splat, simd-u8x16-sub, simd-u8x16-cmpeq, simd-u8x16-cmplt, simd-u8x16-movemask)
  import Text.Show

  export string-index-of, string-contains, string-starts-with, string-ends-with
  export string-char-index-of
  export string-split-on, string-join, string-lines, string-words
  export string-unlines, string-unwords
  export string-split-at, string-take, string-drop, string-take-while, string-drop-while
  export string-strip, string-lstrip, string-rstrip, string-chomp, string-chop
  export string-upcase-ascii, string-downcase-ascii, string-capitalize-ascii
  export string-pad-left, string-pad-right, string-center
  export string-normalize-newlines
  export format, FormatError, MissingFormatArgument, UnusedFormatArgument, UnmatchedFormatBrace, render-format-error

  -- -----------------------------------------------------------------
  -- Private exact index arithmetic primitives (zero Nat boxing).
  -- -----------------------------------------------------------------

  -- -----------------------------------------------------------------
  -- Private `%1`-linear buffer write boundary (single-owner mutation).
  -- -----------------------------------------------------------------

  put-u8-raw :: Bytes -> I64 -> U8 -> Bytes
  put-u8-raw b pos v =
    if 0 <= pos && pos < bytes-len-i64 b then
      let w = bytes-set-u8-at b pos v in b
    else b

  put-u8-lin :: Bytes %1 -> I64 -> U8 -> Bytes
  put-u8-lin b pos v = put-u8-raw b pos v

  put-u128-raw :: Bytes -> I64 -> U128 -> Bytes
  put-u128-raw b pos v =
    if 0 <= pos then
      let p = nat-from-i64 pos in
      if p + 16 <= bytes-len b then
        let w = bytes-store-u128 b p v in b
      else b
    else b

  put-u128-lin :: Bytes %1 -> I64 -> U128 -> Bytes
  put-u128-lin b pos v = put-u128-raw b pos v

  copy-range-raw :: Bytes -> Bytes -> Nat -> Nat -> Nat -> Bytes
  copy-range-raw dst src di si n =
    if di + n <= bytes-len dst && si + n <= bytes-len src then
      let u = bytes-copy-range dst src di si n in dst
    else dst

  copy-range-lin :: Bytes %1 -> Bytes -> Nat -> Nat -> Nat -> Bytes
  copy-range-lin dst src di si n = copy-range-raw dst src di si n

  trim-bytes-raw :: Bytes -> I64 -> Bytes
  trim-bytes-raw b n =
    if 0 <= n then
      let len = bytes-len-i64 b in
      if eq-i64 n len then b
      else
        let nn = nat-from-i64 n in
        let exact = bytes-new nn in
        if nn <= bytes-len b && nn <= bytes-len exact then
          let u = bytes-copy-range exact b 0 0 nn in exact
        else exact
    else bytes-new 0

  trim-bytes-lin :: Bytes %1 -> I64 -> Bytes
  trim-bytes-lin b n = trim-bytes-raw b n

  -- | Slice a proved valid UTF-8 byte interval `[start, end)` into a `String`
  -- through a `%1`-linear destination buffer.
  slice-bytes-to-string :: Bytes -> I64 -> I64 -> String
  slice-bytes-to-string src start end =
    if 0 <= start && lt-i64 start end then
      let len = wrapping-sub-i64 end start in
      if 0 <= len then
        let nlen = nat-from-i64 len in
        let nstart = nat-from-i64 start in
        let out = copy-range-lin (bytes-new nlen) src 0 nstart nlen in
        case string-from-bytes out of
          None -> empty-string
          Some t -> t
      else empty-string
    else empty-string

  -- | Fill a uniquely owned `%1` buffer with one repeated byte via 16-byte SIMD stores.
  fill-byte-vec-lin :: Bytes %1 -> I64 -> I64 -> U8 -> Bytes
  fill-byte-vec-lin out i lim16 byte =
    if le-i64 i lim16 then
      let out1 = put-u128-lin out i (simd-u8x16-splat byte) in
      fill-byte-vec-lin out1 (wrapping-add-i64 i 16) lim16 byte
    else fill-byte-tail-lin out i (wrapping-add-i64 lim16 16) byte

  fill-byte-tail-lin :: Bytes %1 -> I64 -> I64 -> U8 -> Bytes
  fill-byte-tail-lin out i end byte =
    if lt-i64 i end then
      let out1 = put-u8-lin out i byte in
      fill-byte-tail-lin out1 (wrapping-add-i64 i 1) end byte
    else out

  fill-spaces-lin :: Bytes %1 -> I64 -> Bytes
  fill-spaces-lin buf len =
    if 16 <= len then
      let lim16 = wrapping-sub-i64 len 16 in
      fill-byte-vec-lin buf 0 lim16 32
    else fill-byte-tail-lin buf 0 len 32

  -- | A run of spaces built directly into a `%1`-linear buffer via 16-byte SIMD.
  spaces :: Nat -> String
  spaces n =
    if n == 0 then empty-string
    else
      let buf = bytes-new n in
      let len = bytes-len-i64 buf in
      let filled = fill-spaces-lin buf len in
      case string-from-bytes filled of
        None -> empty-string
        Some t -> t

  -- -----------------------------------------------------------------
  -- Byte classification, word equality, UTF-8 scalar counting, and SIMD search.
  -- -----------------------------------------------------------------

  is-ws-u8 :: U8 -> Bool
  is-ws-u8 c = eq-u8 c 32 || (ge-u8 c 9 && le-u8 c 13)

  utf8-lead-width-u8 :: U8 -> I64
  utf8-lead-width-u8 b =
    if lt-u8 b 128 then 1
    else if lt-u8 b 224 then 2
    else if lt-u8 b 240 then 3
    else 4

  count-scalars-i64 :: Bytes -> I64 -> I64
  count-scalars-i64 raw end =
    if 16 <= end && end <= bytes-len-i64 raw then
      let end-n = nat-from-i64 end in
      let lim16 = end-n - 16 in
      count-scalars-loop16 raw lim16 0 end 0
    else count-scalars-swar8 raw 0 end 0

  -- | Count UTF-8 scalars in valid UTF-8 prefix `[0, limit)` using 16-byte SIMD
  -- + 8-byte SWAR + scalar tail (non-continuation bytes: `(b & 0xC0) != 0x80`).
  count-scalars-prefix :: Bytes -> I64 -> Nat
  count-scalars-prefix raw limit =
    let n = bytes-len-i64 raw in
    let end = if lt-i64 limit n then limit else n in
    if le-i64 end 0 then 0
    else
      let total = count-scalars-i64 raw end in
      if 0 <= total then nat-from-i64 total else 0

  count-scalars-loop16 :: using (lim16 + 16 <= bytes-len raw) => (raw :: Bytes) -> (lim16 :: Nat) -> I64 -> I64 -> I64 -> I64
  count-scalars-loop16 raw lim16 i end total =
    if 0 <= i then
      let idx = nat-from-i64 i in
      if idx <= lim16 then
        let chunk = bytes-load-u128 raw idx in
        let top = bit-and-u128 chunk (simd-u8x16-splat 192) in
        let cont = simd-u8x16-cmpeq top (simd-u8x16-splat 128) in
        let mask = simd-u8x16-movemask cont in
        let step = wrapping-sub-i64 16 (u32-to-i64 (count-ones-u32 mask)) in
        count-scalars-loop16 raw lim16 (wrapping-add-i64 i 16) end (wrapping-add-i64 total step)
      else count-scalars-swar8 raw i end total
    else count-scalars-swar8 raw i end total

  count-scalars-swar8 :: Bytes -> I64 -> I64 -> I64 -> I64
  count-scalars-swar8 raw i end total =
    if 0 <= i && le-i64 (wrapping-add-i64 i 8) end then
      let idx = nat-from-i64 i in
      if idx + 8 <= bytes-len raw then
        let word = bytes-load-le64 raw idx in
        let noncont = bit-and-u64 (bit-or-u64 (bit-not-u64 word) (wrapping-shl-u64 word 1)) 9259542123273814144 in
        let step = u32-to-i64 (count-ones-u64 noncont) in
        count-scalars-tail raw (wrapping-add-i64 i 8) end (wrapping-add-i64 total step)
      else count-scalars-tail raw i end total
    else count-scalars-tail raw i end total

  count-scalars-tail :: Bytes -> I64 -> I64 -> I64 -> I64
  count-scalars-tail raw i end total =
    if 0 <= i && i < bytes-len-i64 raw && lt-i64 i end then
      let step = if ne-u8 (bit-and-u8 (bytes-get-u8-at raw i) 192) 128 then 1 else 0 in
      count-scalars-tail raw (wrapping-add-i64 i 1) end (wrapping-add-i64 total step)
    else total

  -- | Compare `len` bytes at `a[oa..]` and `b[ob..]` using 8-byte LE64 words + tail.
  bytes-eq-at :: Bytes -> I64 -> Bytes -> I64 -> I64 -> Bool
  bytes-eq-at a oa b ob len =
    let na = bytes-len a in
    let nb = bytes-len b in
    if 8 <= na && 8 <= nb then
      bytes-eq-loop8 a (na - 8) b (nb - 8) oa ob len
    else bytes-eq-tail a oa b ob len

  bytes-eq-loop8 :: using (lima + 8 <= bytes-len a, limb + 8 <= bytes-len b) => (a :: Bytes) -> (lima :: Nat) -> (b :: Bytes) -> (limb :: Nat) -> I64 -> I64 -> I64 -> Bool
  bytes-eq-loop8 a lima b limb oa ob rem =
    if ge-i64 rem 8 && 0 <= oa && 0 <= ob then
      let ia = nat-from-i64 oa in
      let ib = nat-from-i64 ob in
      if ia <= lima && ib <= limb then
        if eq-u64 (bytes-load-le64 a ia) (bytes-load-le64 b ib) then
          bytes-eq-loop8 a lima b limb (wrapping-add-i64 oa 8) (wrapping-add-i64 ob 8) (wrapping-sub-i64 rem 8)
        else False
      else bytes-eq-tail a oa b ob rem
    else bytes-eq-tail a oa b ob rem

  bytes-eq-tail :: Bytes -> I64 -> Bytes -> I64 -> I64 -> Bool
  bytes-eq-tail a oa b ob rem =
    if le-i64 rem 0 then True
    else if 0 <= oa && oa < bytes-len-i64 a && 0 <= ob && ob < bytes-len-i64 b then
      if eq-u8 (bytes-get-u8-at a oa) (bytes-get-u8-at b ob) then
        bytes-eq-tail a (wrapping-add-i64 oa 1) b (wrapping-add-i64 ob 1) (wrapping-sub-i64 rem 1)
      else False
    else False

  -- | SIMD 16-byte single-byte scan over `buf[start..end)`; returns byte offset or `-1`.
  find-byte-from :: Bytes -> I64 -> I64 -> U8 -> I64
  find-byte-from buf start end needle =
    let n = bytes-len-i64 buf in
    let hi = if lt-i64 end n then end else n in
    if le-i64 hi start || lt-i64 start 0 then -1
    else if 16 <= hi then
      let hi-n = nat-from-i64 hi in
      if 16 <= hi-n && hi-n <= bytes-len buf then
        let lim16 = hi-n - 16 in
        find-byte-loop16 buf lim16 start hi needle
      else find-byte-tail buf start hi needle
    else find-byte-tail buf start hi needle

  find-byte-loop16 :: using (lim16 + 16 <= bytes-len buf) => (buf :: Bytes) -> (lim16 :: Nat) -> I64 -> I64 -> U8 -> I64
  find-byte-loop16 buf lim16 i end needle =
    if 0 <= i then
      let idx = nat-from-i64 i in
      if idx <= lim16 then
        let chunk = bytes-load-u128 buf idx in
        let mask = simd-u8x16-movemask (simd-u8x16-cmpeq chunk (simd-u8x16-splat needle)) in
        if ne-u32 mask 0 then
          wrapping-add-i64 i (u32-to-i64 (trailing-zeros-u32 mask))
        else find-byte-loop16 buf lim16 (wrapping-add-i64 i 16) end needle
      else find-byte-tail buf i end needle
    else find-byte-tail buf i end needle

  find-byte-tail :: Bytes -> I64 -> I64 -> U8 -> I64
  find-byte-tail buf i end needle =
    if 0 <= i && i < bytes-len-i64 buf && lt-i64 i end then
      if eq-u8 (bytes-get-u8-at buf i) needle then i
      else find-byte-tail buf (wrapping-add-i64 i 1) end needle
    else -1

  -- | Muła's 16-byte SIMD first+last byte substring filter over `hay[start..hlen)`.
  -- Returns the first matching byte offset, or `-1` if absent.
  find-bytes-from :: Bytes -> I64 -> I64 -> Bytes -> I64 -> I64
  find-bytes-from hay start hlen needle nlen =
    if eq-i64 nlen 0 then
      if le-i64 start hlen then start else -1
    else if lt-i64 start 0 || gt-i64 nlen hlen then -1
    else if eq-i64 nlen 1 then
      if 0 < bytes-len-i64 needle then
        find-byte-from hay start hlen (bytes-get-u8-at needle 0)
      else -1
    else
      let hn = bytes-len-i64 hay in
      let nn = bytes-len-i64 needle in
      if 2 <= nn && 2 <= nlen && nlen <= nn && hlen <= hn && nlen <= hlen then
        let last-off = wrapping-sub-i64 nlen 1 in
        let mid-len = wrapping-sub-i64 nlen 2 in
        if 0 <= last-off && last-off < nn then
          let first = bytes-get-u8-at needle 0 in
          let last = bytes-get-u8-at needle last-off in
          let max-pos = wrapping-sub-i64 hlen nlen in
          if gt-i64 start max-pos then -1
          else if 16 <= bytes-len hay then
            let lim16 = bytes-len hay - 16 in
            let simd-end = wrapping-sub-i64 max-pos 15 in
            if le-i64 start simd-end then
              mula-loop16 hay lim16 start max-pos needle last-off first last
            else
              mula-tail hay start max-pos needle last-off mid-len first last
          else
            mula-tail hay start max-pos needle last-off mid-len first last
        else -1
      else -1

  mula-loop16 :: using (lim16 + 16 <= bytes-len hay) => (hay :: Bytes) -> (lim16 :: Nat) -> I64 -> I64 -> Bytes -> I64 -> U8 -> U8 -> I64
  mula-loop16 hay lim16 i max-pos needle last-off first last =
    let simd-end = wrapping-sub-i64 max-pos 15 in
    let mid-len = wrapping-sub-i64 last-off 1 in
    if le-i64 i simd-end && 0 <= i then
      let ni = nat-from-i64 i in
      let j = wrapping-add-i64 i last-off in
      if ni <= lim16 && 0 <= j then
        let nj = nat-from-i64 j in
        if nj <= lim16 then
          let c0 = bytes-load-u128 hay ni in
          let c1 = bytes-load-u128 hay nj in
          let eq0 = simd-u8x16-cmpeq c0 (simd-u8x16-splat first) in
          let eq1 = simd-u8x16-cmpeq c1 (simd-u8x16-splat last) in
          let mask = simd-u8x16-movemask (bit-and-u128 eq0 eq1) in
          if eq-u32 mask 0 then
            mula-loop16 hay lim16 (wrapping-add-i64 i 16) max-pos needle last-off first last
          else
            let hit = mula-check-mask hay i mask needle mid-len in
            if ge-i64 hit 0 then hit
            else mula-loop16 hay lim16 (wrapping-add-i64 i 16) max-pos needle last-off first last
        else mula-tail hay i max-pos needle last-off mid-len first last
      else mula-tail hay i max-pos needle last-off mid-len first last
    else mula-tail hay i max-pos needle last-off mid-len first last

  mula-check-mask :: Bytes -> I64 -> U32 -> Bytes -> I64 -> I64
  mula-check-mask hay base mask needle mid-len =
    if eq-u32 mask 0 then -1
    else
      let bit = u32-to-i64 (trailing-zeros-u32 mask) in
      let cand = wrapping-add-i64 base bit in
      if eq-i64 mid-len 0 || bytes-eq-at hay (wrapping-add-i64 cand 1) needle 1 mid-len then cand
      else
        let next-mask = bit-and-u32 mask (wrapping-sub-u32 mask 1) in
        mula-check-mask hay base next-mask needle mid-len

  mula-tail :: Bytes -> I64 -> I64 -> Bytes -> I64 -> I64 -> U8 -> U8 -> I64
  mula-tail hay i max-pos needle last-off mid-len first last =
    if le-i64 i max-pos && 0 <= i && i < bytes-len-i64 hay then
      let j = wrapping-add-i64 i last-off in
      if 0 <= j && j < bytes-len-i64 hay then
        if eq-u8 (bytes-get-u8-at hay i) first && eq-u8 (bytes-get-u8-at hay j) last then
          if eq-i64 mid-len 0 || bytes-eq-at hay (wrapping-add-i64 i 1) needle 1 mid-len then i
          else mula-tail hay (wrapping-add-i64 i 1) max-pos needle last-off mid-len first last
        else mula-tail hay (wrapping-add-i64 i 1) max-pos needle last-off mid-len first last
      else -1
    else -1

  -- | Encode one Unicode scalar value into a fresh `%1`-linear 1..4 byte buffer.
  encode-char-bytes :: Char -> Bytes
  encode-char-bytes c =
    let cp = char-to-u32 c in
    if lt-u32 cp 128 then
      put-u8-lin (bytes-new 1) 0 (wrapping-u32-to-u8 cp)
    else if lt-u32 cp 2048 then
      let b0 = bit-or-u8 192 (wrapping-u32-to-u8 (wrapping-shr-u32 cp 6)) in
      let b1 = bit-or-u8 128 (bit-and-u8 (wrapping-u32-to-u8 cp) 63) in
      put-u8-lin (put-u8-lin (bytes-new 2) 0 b0) 1 b1
    else if lt-u32 cp 65536 then
      let b0 = bit-or-u8 224 (wrapping-u32-to-u8 (wrapping-shr-u32 cp 12)) in
      let b1 = bit-or-u8 128 (bit-and-u8 (wrapping-u32-to-u8 (wrapping-shr-u32 cp 6)) 63) in
      let b2 = bit-or-u8 128 (bit-and-u8 (wrapping-u32-to-u8 cp) 63) in
      put-u8-lin (put-u8-lin (put-u8-lin (bytes-new 3) 0 b0) 1 b1) 2 b2
    else
      let b0 = bit-or-u8 240 (wrapping-u32-to-u8 (wrapping-shr-u32 cp 18)) in
      let b1 = bit-or-u8 128 (bit-and-u8 (wrapping-u32-to-u8 (wrapping-shr-u32 cp 12)) 63) in
      let b2 = bit-or-u8 128 (bit-and-u8 (wrapping-u32-to-u8 (wrapping-shr-u32 cp 6)) 63) in
      let b3 = bit-or-u8 128 (bit-and-u8 (wrapping-u32-to-u8 cp) 63) in
      put-u8-lin (put-u8-lin (put-u8-lin (put-u8-lin (bytes-new 4) 0 b0) 1 b1) 2 b2) 3 b3

  -- -----------------------------------------------------------------
  -- Scanning (subject last).
  -- -----------------------------------------------------------------

  -- The scalar index where `needle` first occurs in `s` (an empty
  -- needle occurs at 0).
  string-index-of :: String -> String -> Option Nat
  string-index-of needle s =
    let nlen = string-byte-length needle in
    if nlen == 0 then Some 0
    else if nlen > string-byte-length s then None
    else
      let sb = string-to-bytes s in
      let nb = string-to-bytes needle in
      let pos = find-bytes-from sb 0 (bytes-len-i64 sb) nb (bytes-len-i64 nb) in
      if lt-i64 pos 0 then None
      else Some (count-scalars-prefix sb pos)

  -- Direct byte-level substring check (skips UTF-8 scalar counting completely).
  string-contains :: String -> String -> Bool
  string-contains needle s =
    let nlen = string-byte-length needle in
    if nlen == 0 then True
    else if nlen > string-byte-length s then False
    else
      let sb = string-to-bytes s in
      let nb = string-to-bytes needle in
      ge-i64 (find-bytes-from sb 0 (bytes-len-i64 sb) nb (bytes-len-i64 nb)) 0

  find-char-byte-pos :: Char -> Bytes -> I64 -> I64
  find-char-byte-pos c sb slen =
    let cp = char-to-u32 c in
    if lt-u32 cp 128 then find-byte-from sb 0 slen (wrapping-u32-to-u8 cp)
    else
      let nb = encode-char-bytes c in
      find-bytes-from sb 0 slen nb (bytes-len-i64 nb)

  -- The scalar index of the first occurrence of a single scalar.
  string-char-index-of :: Char -> String -> Option Nat
  string-char-index-of c s =
    if string-byte-length s == 0 then None
    else
      let sb = string-to-bytes s in
      let pos = find-char-byte-pos c sb (bytes-len-i64 sb) in
      if lt-i64 pos 0 then None
      else Some (count-scalars-prefix sb pos)

  string-starts-with :: String -> String -> Bool
  string-starts-with pre s =
    let plen = string-byte-length pre in
    if plen == 0 then True
    else if plen > string-byte-length s then False
    else
      let pb = string-to-bytes pre in
      let sb = string-to-bytes s in
      bytes-eq-at pb 0 sb 0 (bytes-len-i64 pb)

  string-ends-with :: String -> String -> Bool
  string-ends-with suf s =
    let suflen = string-byte-length suf in
    if suflen == 0 then True
    else if suflen > string-byte-length s then False
    else
      let sufb = string-to-bytes suf in
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let flen = bytes-len-i64 sufb in
      bytes-eq-at sufb 0 sb (wrapping-sub-i64 slen flen) flen

  -- Split at every occurrence of the separator (the separators are
  -- removed). Trailing empty pieces are dropped (Ruby's default) and
  -- an empty separator splits into single-scalar strings (Ruby's
  -- `split("")`).
  string-split-on :: String -> String -> List String
  string-split-on sep s =
    if string-byte-length sep == 0 then
      let sb = string-to-bytes s in
      split-scalars-loop sb 0 (bytes-len-i64 sb) Nil
    else
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let sepb = string-to-bytes sep in
      let seplen = bytes-len-i64 sepb in
      let rev-pieces = if eq-i64 seplen 1 && 0 < bytes-len-i64 sepb then split-byte-loop sb 0 slen (bytes-get-u8-at sepb 0) Nil else split-bytes-loop sb 0 slen sepb seplen Nil in
      reverse (drop-empty-head rev-pieces)

  split-scalars-loop :: Bytes -> I64 -> I64 -> List String -> List String
  split-scalars-loop sb i slen acc =
    if 0 <= i && i < bytes-len-i64 sb && lt-i64 i slen then
      let w = utf8-lead-width-u8 (bytes-get-u8-at sb i) in
      let next = wrapping-add-i64 i w in
      let piece = slice-bytes-to-string sb i next in
      split-scalars-loop sb next slen (Cons piece acc)
    else reverse acc

  split-byte-loop :: Bytes -> I64 -> I64 -> U8 -> List String -> List String
  split-byte-loop sb pos slen delim acc =
    let hit = find-byte-from sb pos slen delim in
    if lt-i64 hit 0 then
      Cons (slice-bytes-to-string sb pos slen) acc
    else
      let piece = slice-bytes-to-string sb pos hit in
      split-byte-loop sb (wrapping-add-i64 hit 1) slen delim (Cons piece acc)

  split-bytes-loop :: Bytes -> I64 -> I64 -> Bytes -> I64 -> List String -> List String
  split-bytes-loop sb pos slen sepb seplen acc =
    let hit = find-bytes-from sb pos slen sepb seplen in
    if lt-i64 hit 0 then
      Cons (slice-bytes-to-string sb pos slen) acc
    else
      let piece = slice-bytes-to-string sb pos hit in
      split-bytes-loop sb (wrapping-add-i64 hit seplen) slen sepb seplen (Cons piece acc)

  drop-empty-head :: List String -> List String
  drop-empty-head xs = case xs of
    Nil -> Nil
    Cons y ys -> if string-byte-length y == 0 then drop-empty-head ys else xs

  -- Join with a separator between every pair (tail-recursive, O(1) stack).
  string-join :: String -> List String -> String
  string-join sep items = string-concat-all (reverse (join-each-rev sep items Nil))

  join-each-rev :: String -> List String -> List String -> List String
  join-each-rev sep items acc = case items of
    Nil -> acc
    Cons y ys -> case ys of
      Nil -> Cons y acc
      _ -> join-each-rev sep ys (Cons sep (Cons y acc))

  -- The lines of a string: the segments between LF scalars, with one
  -- trailing empty segment dropped when the string ends in LF (an
  -- empty string has no lines).
  string-lines :: String -> List String
  string-lines s =
    if string-byte-length s == 0 then Nil
    else
      let sb = string-to-bytes s in
      let rev-pieces = split-byte-loop sb 0 (bytes-len-i64 sb) 10 Nil in
      case rev-pieces of
        Nil -> Nil
        Cons y ys ->
          if string-byte-length y == 0 then reverse ys
          else reverse rev-pieces

  -- The whitespace-separated words (ASCII whitespace runs delimit).
  string-words :: String -> List String
  string-words s =
    if string-byte-length s == 0 then Nil
    else
      let sb = string-to-bytes s in
      words-skip-ws sb 0 (bytes-len-i64 sb) Nil

  words-skip-ws :: Bytes -> I64 -> I64 -> List String -> List String
  words-skip-ws sb i slen acc =
    if 0 <= i && i < bytes-len-i64 sb && lt-i64 i slen then
      if is-ws-u8 (bytes-get-u8-at sb i) then
        words-skip-ws sb (wrapping-add-i64 i 1) slen acc
      else words-scan-word sb i (wrapping-add-i64 i 1) slen acc
    else reverse acc

  words-scan-word :: Bytes -> I64 -> I64 -> I64 -> List String -> List String
  words-scan-word sb start i slen acc =
    if 0 <= i && i < bytes-len-i64 sb && lt-i64 i slen then
      if is-ws-u8 (bytes-get-u8-at sb i) then
        let word = slice-bytes-to-string sb start i in
        words-skip-ws sb (wrapping-add-i64 i 1) slen (Cons word acc)
      else words-scan-word sb start (wrapping-add-i64 i 1) slen acc
    else
      let word = slice-bytes-to-string sb start slen in
      reverse (Cons word acc)

  -- The inverse of `string-lines`: every line followed by LF (tail-recursive).
  string-unlines :: List String -> String
  string-unlines lines = string-concat-all (reverse (unlines-each-rev lines Nil))

  unlines-each-rev :: List String -> List String -> List String
  unlines-each-rev lines acc = case lines of
    Nil -> acc
    Cons y ys -> unlines-each-rev ys (Cons "\n" (Cons y acc))

  -- The inverse of `string-words`: a single space between elements.
  string-unwords :: List String -> String
  string-unwords words = string-join " " words

  -- -----------------------------------------------------------------
  -- Scalar-count and predicate cutters (direct byte slicing).
  -- -----------------------------------------------------------------

  -- | Advance `rem` UTF-8 scalars from byte offset `i`, taking 16-byte SIMD
  -- ASCII fast steps whenever all 16 bytes have high bit 0.
  advance-scalars :: Bytes -> I64 -> I64 -> Nat -> I64
  advance-scalars sb i slen rem =
    if rem == 0 || ge-i64 i slen then i
    else if 16 <= bytes-len sb then
      let lim16 = bytes-len sb - 16 in
      advance-scalars-loop sb lim16 i slen rem
    else advance-scalars-one sb i slen rem

  advance-scalars-loop :: using (lim16 + 16 <= bytes-len sb) => (sb :: Bytes) -> (lim16 :: Nat) -> I64 -> I64 -> Nat -> I64
  advance-scalars-loop sb lim16 i slen rem =
    if rem == 0 || ge-i64 i slen then i
    else if 16 <= rem && 0 <= i && le-i64 (wrapping-add-i64 i 16) slen then
      let idx = nat-from-i64 i in
      if idx <= lim16 then
        let chunk = bytes-load-u128 sb idx in
        if eq-u32 (simd-u8x16-movemask chunk) 0 then
          advance-scalars-loop sb lim16 (wrapping-add-i64 i 16) slen (rem - 16)
        else
          let w = utf8-lead-width-u8 (bytes-get-u8 sb idx) in
          advance-scalars-loop sb lim16 (wrapping-add-i64 i w) slen (rem - 1)
      else advance-scalars-one sb i slen rem
    else advance-scalars-one sb i slen rem

  advance-scalars-one :: Bytes -> I64 -> I64 -> Nat -> I64
  advance-scalars-one sb i slen rem =
    if rem == 0 then i
    else if 0 <= i && i < bytes-len-i64 sb && lt-i64 i slen then
      let w = utf8-lead-width-u8 (bytes-get-u8-at sb i) in
      advance-scalars-one sb (wrapping-add-i64 i w) slen (rem - 1)
    else i

  string-split-at :: Nat -> String -> (String, String)
  string-split-at n s =
    if n == 0 then (empty-string, s)
    else if string-byte-length s == 0 then (empty-string, empty-string)
    else
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let cut = advance-scalars sb 0 slen n in
      if ge-i64 cut slen then (s, empty-string)
      else (slice-bytes-to-string sb 0 cut, slice-bytes-to-string sb cut slen)

  string-take :: Nat -> String -> String
  string-take n s =
    if n == 0 || string-byte-length s == 0 then empty-string
    else
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let cut = advance-scalars sb 0 slen n in
      if ge-i64 cut slen then s
      else slice-bytes-to-string sb 0 cut

  string-drop :: Nat -> String -> String
  string-drop n s =
    if n == 0 then s
    else if string-byte-length s == 0 then empty-string
    else
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let cut = advance-scalars sb 0 slen n in
      if ge-i64 cut slen then empty-string
      else slice-bytes-to-string sb cut slen

  -- | Decode one UTF-8 scalar directly from valid UTF-8 `Bytes` at `i`.
  decode-utf8-at :: Bytes -> I64 -> I64 -> Option (Char, I64)
  decode-utf8-at sb i slen =
    if 0 <= i && i < bytes-len-i64 sb && lt-i64 i slen then
      let b0 = bytes-get-u8-at sb i in
      if lt-u8 b0 128 then
        case u32-to-char (u8-to-u32 b0) of
          None -> None
          Some ch -> Some (ch, 1)
      else if lt-u8 b0 224 then
        let i1 = wrapping-add-i64 i 1 in
        if 0 <= i1 && i1 < bytes-len-i64 sb then
          let b1 = bytes-get-u8-at sb i1 in
          let cp = bit-or-u32 (wrapping-shl-u32 (u8-to-u32 (bit-and-u8 b0 31)) 6) (u8-to-u32 (bit-and-u8 b1 63)) in
          case u32-to-char cp of
            None -> None
            Some ch -> Some (ch, 2)
        else None
      else if lt-u8 b0 240 then
        let i1 = wrapping-add-i64 i 1 in
        let i2 = wrapping-add-i64 i 2 in
        if 0 <= i1 && i1 < bytes-len-i64 sb && 0 <= i2 && i2 < bytes-len-i64 sb then
          let b1 = bytes-get-u8-at sb i1 in
          let b2 = bytes-get-u8-at sb i2 in
          let cp = bit-or-u32 (wrapping-shl-u32 (u8-to-u32 (bit-and-u8 b0 15)) 12) (bit-or-u32 (wrapping-shl-u32 (u8-to-u32 (bit-and-u8 b1 63)) 6) (u8-to-u32 (bit-and-u8 b2 63))) in
          case u32-to-char cp of
            None -> None
            Some ch -> Some (ch, 3)
        else None
      else
        let i1 = wrapping-add-i64 i 1 in
        let i2 = wrapping-add-i64 i 2 in
        let i3 = wrapping-add-i64 i 3 in
        if 0 <= i1 && i1 < bytes-len-i64 sb && 0 <= i2 && i2 < bytes-len-i64 sb && 0 <= i3 && i3 < bytes-len-i64 sb then
          let b1 = bytes-get-u8-at sb i1 in
          let b2 = bytes-get-u8-at sb i2 in
          let b3 = bytes-get-u8-at sb i3 in
          let cp = bit-or-u32 (wrapping-shl-u32 (u8-to-u32 (bit-and-u8 b0 7)) 18) (bit-or-u32 (wrapping-shl-u32 (u8-to-u32 (bit-and-u8 b1 63)) 12) (bit-or-u32 (wrapping-shl-u32 (u8-to-u32 (bit-and-u8 b2 63)) 6) (u8-to-u32 (bit-and-u8 b3 63)))) in
          case u32-to-char cp of
            None -> None
            Some ch -> Some (ch, 4)
        else None
    else None

  scan-while-cut :: (Char -> Bool) -> Bytes -> I64 -> I64 -> I64
  scan-while-cut p sb i slen =
    case decode-utf8-at sb i slen of
      None -> i
      Some pair -> case pair of
        (ch, w) -> if p ch then scan-while-cut p sb (wrapping-add-i64 i w) slen else i

  string-take-while :: (Char -> Bool) -> String -> String
  string-take-while p s =
    if string-byte-length s == 0 then empty-string
    else
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let cut = scan-while-cut p sb 0 slen in
      if eq-i64 cut 0 then empty-string
      else if ge-i64 cut slen then s
      else slice-bytes-to-string sb 0 cut

  string-drop-while :: (Char -> Bool) -> String -> String
  string-drop-while p s =
    if string-byte-length s == 0 then empty-string
    else
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let cut = scan-while-cut p sb 0 slen in
      if eq-i64 cut 0 then s
      else if ge-i64 cut slen then empty-string
      else slice-bytes-to-string sb cut slen

  -- -----------------------------------------------------------------
  -- Trimming and case (ASCII, 16-byte SIMD + `%1`-linear output).
  -- -----------------------------------------------------------------

  scan-ws-left :: Bytes -> I64 -> I64 -> I64
  scan-ws-left sb i slen =
    if 0 <= i && i < bytes-len-i64 sb && lt-i64 i slen then
      if is-ws-u8 (bytes-get-u8-at sb i) then
        scan-ws-left sb (wrapping-add-i64 i 1) slen
      else i
    else i

  scan-ws-right :: Bytes -> I64 -> I64 -> I64
  scan-ws-right sb lo hi =
    if lt-i64 lo hi then
      let prev = wrapping-sub-i64 hi 1 in
      if 0 <= prev && prev < bytes-len-i64 sb then
        if is-ws-u8 (bytes-get-u8-at sb prev) then
          scan-ws-right sb lo prev
        else hi
      else hi
    else hi

  string-strip :: String -> String
  string-strip s =
    if string-byte-length s == 0 then s
    else
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let lo = scan-ws-left sb 0 slen in
      let hi = scan-ws-right sb lo slen in
      if eq-i64 lo 0 && eq-i64 hi slen then s
      else slice-bytes-to-string sb lo hi

  string-lstrip :: String -> String
  string-lstrip s =
    if string-byte-length s == 0 then s
    else
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let lo = scan-ws-left sb 0 slen in
      if eq-i64 lo 0 then s
      else slice-bytes-to-string sb lo slen

  string-rstrip :: String -> String
  string-rstrip s =
    if string-byte-length s == 0 then s
    else
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let hi = scan-ws-right sb 0 slen in
      if eq-i64 hi slen then s
      else slice-bytes-to-string sb 0 hi

  -- Drop one trailing line ending: LF, CRLF or CR.
  string-chomp :: String -> String
  string-chomp s =
    if string-byte-length s == 0 then s
    else
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let last-idx = wrapping-sub-i64 slen 1 in
      if 0 <= last-idx && last-idx < bytes-len-i64 sb then
        let last = bytes-get-u8-at sb last-idx in
        if eq-u8 last 10 then
          if ge-i64 slen 2 then
            let prev-idx = wrapping-sub-i64 slen 2 in
            if 0 <= prev-idx && prev-idx < bytes-len-i64 sb && eq-u8 (bytes-get-u8-at sb prev-idx) 13 then
              slice-bytes-to-string sb 0 prev-idx
            else slice-bytes-to-string sb 0 last-idx
          else slice-bytes-to-string sb 0 last-idx
        else if eq-u8 last 13 then
          slice-bytes-to-string sb 0 last-idx
        else s
      else s

  -- Drop the last scalar (walks back over at most 3 UTF-8 continuation bytes).
  string-chop :: String -> String
  string-chop s =
    if string-byte-length s == 0 then s
    else
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let cut = chop-back sb (wrapping-sub-i64 slen 1) in
      slice-bytes-to-string sb 0 cut

  chop-back :: Bytes -> I64 -> I64
  chop-back sb pos =
    if 0 <= pos && pos < bytes-len-i64 sb then
      if eq-u8 (bit-and-u8 (bytes-get-u8-at sb pos) 192) 128 then
        chop-back sb (wrapping-sub-i64 pos 1)
      else pos
    else 0

  -- | SIMD 16-byte ASCII case transform into a `%1`-linear output buffer.
  -- `base` is 97 (`'a'`) for upcase or 65 (`'A'`) for downcase; any byte `b`
  -- with `(b - base) <_u 26` is toggled by `XOR 32`.
  case-convert-bytes :: Bytes -> U8 -> Bytes
  case-convert-bytes src base =
    let len = bytes-len-i64 src in
    let n = bytes-len src in
    let out = bytes-new n in
    if 16 <= n then
      let lim16 = n - 16 in
      case-loop16-lin src lim16 0 len base out
    else case-tail-lin src 0 len base out

  case-loop16-lin :: using (lim16 + 16 <= bytes-len src) => (src :: Bytes) -> (lim16 :: Nat) -> I64 -> I64 -> U8 -> Bytes %1 -> Bytes
  case-loop16-lin src lim16 i len base out =
    if 0 <= i then
      let idx = nat-from-i64 i in
      if idx <= lim16 then
        let chunk = bytes-load-u128 src idx in
        let shifted = simd-u8x16-sub chunk (simd-u8x16-splat base) in
        let mask = simd-u8x16-cmplt shifted (simd-u8x16-splat 26) in
        let mapped = bit-xor-u128 chunk (bit-and-u128 mask (simd-u8x16-splat 32)) in
        let out1 = put-u128-lin out i mapped in
        case-loop16-lin src lim16 (wrapping-add-i64 i 16) len base out1
      else case-tail-lin src i len base out
    else case-tail-lin src i len base out

  case-tail-lin :: Bytes -> I64 -> I64 -> U8 -> Bytes %1 -> Bytes
  case-tail-lin src i len base out =
    if 0 <= i && i < bytes-len-i64 src && lt-i64 i len then
      let b = bytes-get-u8-at src i in
      let mapped = if lt-u8 (wrapping-sub-u8 b base) 26 then bit-xor-u8 b 32 else b in
      let out1 = put-u8-lin out i mapped in
      case-tail-lin src (wrapping-add-i64 i 1) len base out1
    else out

  ascii-up-u8 :: U8 -> U8
  ascii-up-u8 b = if lt-u8 (wrapping-sub-u8 b 97) 26 then bit-xor-u8 b 32 else b

  -- ASCII case mapping only (the honest boundary: no Unicode case
  -- data exists in the UTF-8 layers).
  string-upcase-ascii :: String -> String
  string-upcase-ascii s =
    if string-byte-length s == 0 then s
    else
      let out = case-convert-bytes (string-to-bytes s) 97 in
      case string-from-bytes out of
        None -> s
        Some t -> t

  string-downcase-ascii :: String -> String
  string-downcase-ascii s =
    if string-byte-length s == 0 then s
    else
      let out = case-convert-bytes (string-to-bytes s) 65 in
      case string-from-bytes out of
        None -> s
        Some t -> t

  string-capitalize-ascii :: String -> String
  string-capitalize-ascii s =
    if string-byte-length s == 0 then s
    else
      let sb = string-to-bytes s in
      let b0 = if 0 < bytes-len-i64 sb then bytes-get-u8-at sb 0 else 0 in
      let out0 = case-convert-bytes sb 65 in
      let out1 = put-u8-lin out0 0 (ascii-up-u8 b0) in
      case string-from-bytes out1 of
        None -> s
        Some t -> t

  -- -----------------------------------------------------------------
  -- Padding (scalar widths, spaces).
  -- -----------------------------------------------------------------

  string-pad-left :: Nat -> String -> String
  string-pad-left w s =
    let n = string-length s in
    if n >= w then s else string-concat (spaces (w - n)) s

  string-pad-right :: Nat -> String -> String
  string-pad-right w s =
    let n = string-length s in
    if n >= w then s else string-concat s (spaces (w - n))

  -- Center in `w` scalars; the extra space of an odd pad goes right.
  string-center :: Nat -> String -> String
  string-center w s =
    let n = string-length s in
    if n >= w then s
    else
      let total = w - n in
      let left = nat-div total 2 in
      let right = nat-div (total + 1) 2 in
      string-concat (spaces left) (string-concat s (spaces right))

  -- -----------------------------------------------------------------
  -- Line-ending normalization (CRLF and lone CR fold to LF).
  -- SIMD scans for `0x0D`; zero output allocation when no CR is present;
  -- `%1`-linear bulk-copy + single-byte LF emission otherwise.
  -- -----------------------------------------------------------------

  string-normalize-newlines :: String -> String
  string-normalize-newlines s =
    if string-byte-length s == 0 then s
    else
      let sb = string-to-bytes s in
      let slen = bytes-len-i64 sb in
      let first-cr = find-byte-from sb 0 slen 13 in
      if lt-i64 first-cr 0 then s
      else
        let out = norm-nl-loop-lin sb 0 slen first-cr (bytes-new (bytes-len sb)) 0 in
        case string-from-bytes out of
          None -> s
          Some t -> t

  copy-span-lin :: Bytes %1 -> Bytes -> I64 -> I64 -> I64 -> Bytes
  copy-span-lin out sb dst-off src-off len =
    if 0 <= dst-off && 0 <= src-off && 0 < len then
      copy-range-lin out sb (nat-from-i64 dst-off) (nat-from-i64 src-off) (nat-from-i64 len)
    else out

  norm-nl-loop-lin :: Bytes -> I64 -> I64 -> I64 -> Bytes %1 -> I64 -> Bytes
  norm-nl-loop-lin sb pos slen cr-pos out out-len =
    let run-len = if lt-i64 pos cr-pos then wrapping-sub-i64 cr-pos pos else 0 in
    let out1 = copy-span-lin out sb out-len pos run-len in
    let out-len1 = wrapping-add-i64 out-len run-len in
    let out2 = put-u8-lin out1 out-len1 10 in
    let out-len2 = wrapping-add-i64 out-len1 1 in
    let after-cr = wrapping-add-i64 cr-pos 1 in
    let next-pos = if 0 <= after-cr && after-cr < bytes-len-i64 sb && eq-u8 (bytes-get-u8-at sb after-cr) 10 then wrapping-add-i64 cr-pos 2 else after-cr in
    let next-cr = find-byte-from sb next-pos slen 13 in
    if lt-i64 next-cr 0 then
      let tail-len = if lt-i64 next-pos slen then wrapping-sub-i64 slen next-pos else 0 in
      let out3 = copy-span-lin out2 sb out-len2 next-pos tail-len in
      trim-bytes-lin out3 (wrapping-add-i64 out-len2 tail-len)
    else
      norm-nl-loop-lin sb next-pos slen next-cr out2 out-len2

  -- -----------------------------------------------------------------
  -- `format`: template interpolation over `{}` holes (byte-backed,
  -- exact scalar offsets for `UnmatchedFormatBrace`).
  -- -----------------------------------------------------------------

  data FormatError where
    MissingFormatArgument :: Nat -> FormatError
    UnusedFormatArgument :: Nat -> FormatError
    UnmatchedFormatBrace :: Nat -> FormatError

  render-format-error :: FormatError -> String
  render-format-error e = case e of
    MissingFormatArgument n -> string-concat "missing-format-argument: the template has more {} holes than arguments (hole " (string-concat (nat-to-string n) ")")
    UnusedFormatArgument n -> string-concat "unused-format-argument: " (string-concat (nat-to-string n) " argument(s) were never consumed by a {} hole")
    UnmatchedFormatBrace n -> string-concat "unmatched-format-brace: a lone { or } at template offset " (nat-to-string n)

  format :: String -> List String -> Result FormatError String
  format tmpl args =
    let tb = string-to-bytes tmpl in
    fmt-bytes-loop tb 0 0 (bytes-len-i64 tb) 0 args 0 Nil

  fmt-push-seg :: Bytes -> I64 -> I64 -> List String -> List String
  fmt-push-seg tb seg-start end acc =
    if lt-i64 seg-start end then Cons (slice-bytes-to-string tb seg-start end) acc else acc

  fmt-nat :: I64 -> Nat
  fmt-nat x = if 0 <= x then nat-from-i64 x else 0

  fmt-bytes-loop :: Bytes -> I64 -> I64 -> I64 -> I64 -> List String -> I64 -> List String -> Result FormatError String
  fmt-bytes-loop tb i seg-start tlen pos args used acc =
    if ge-i64 i tlen then
      let acc1 = fmt-push-seg tb seg-start tlen acc in
      case args of
        Nil -> Ok (string-concat-all (reverse acc1))
        Cons _ _ -> Err (UnusedFormatArgument (fmt-nat used))
    else if 0 <= i && i < bytes-len-i64 tb then
      let b = bytes-get-u8-at tb i in
      if eq-u8 b 123 then
        let acc1 = fmt-push-seg tb seg-start i acc in
        let i1 = wrapping-add-i64 i 1 in
        if 0 <= i1 && i1 < bytes-len-i64 tb && lt-i64 i1 tlen then
          let d = bytes-get-u8-at tb i1 in
          if eq-u8 d 123 then
            let i2 = wrapping-add-i64 i 2 in
            fmt-bytes-loop tb i2 i2 tlen (wrapping-add-i64 pos 2) args used (Cons "{" acc1)
          else if eq-u8 d 125 then
            case args of
              Nil -> Err (MissingFormatArgument (fmt-nat used))
              Cons a args2 ->
                let i2 = wrapping-add-i64 i 2 in
                fmt-bytes-loop tb i2 i2 tlen (wrapping-add-i64 pos 2) args2 (wrapping-add-i64 used 1) (Cons a acc1)
          else Err (UnmatchedFormatBrace (fmt-nat pos))
        else Err (UnmatchedFormatBrace (fmt-nat pos))
      else if eq-u8 b 125 then
        let acc1 = fmt-push-seg tb seg-start i acc in
        let i1 = wrapping-add-i64 i 1 in
        if 0 <= i1 && i1 < bytes-len-i64 tb && lt-i64 i1 tlen then
          let d = bytes-get-u8-at tb i1 in
          if eq-u8 d 125 then
            let i2 = wrapping-add-i64 i 2 in
            fmt-bytes-loop tb i2 i2 tlen (wrapping-add-i64 pos 2) args used (Cons "}" acc1)
          else Err (UnmatchedFormatBrace (fmt-nat pos))
        else Err (UnmatchedFormatBrace (fmt-nat pos))
      else
        let next-pos = if ne-u8 (bit-and-u8 b 192) 128 then wrapping-add-i64 pos 1 else pos in
        fmt-bytes-loop tb (wrapping-add-i64 i 1) seg-start tlen next-pos args used acc
    else Err (UnmatchedFormatBrace (fmt-nat pos))
