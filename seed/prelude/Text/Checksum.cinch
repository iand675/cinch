-- | Incremental Adler-32, CRC-32 and CRC-64 checksums over byte buffers.
-- Updates accept finished checksums: updating the checksum of a prefix with a
-- suffix equals checksumming their concatenation. Start Adler-32 at 1 and CRCs
-- at 0. Polynomial arguments use reflected representations. Text.Adler32 supplies
-- the portable parallel accumulator; IEEE and Castagnoli CRC-32 use slicing-by-four
-- static lookup tables, Koopman uses a static lookup table, and arbitrary
-- polynomials use an unrolled shift register. These checksums do not authenticate messages.
module Text.Checksum where

  import Text.Adler32 as Adler
  import Text.Crc64 as Crc
  import Data.Bytes
  import Data.Bytes.Word
  import Data.Machine
  import Data.Nat

  export adler32-sum, adler32-update
  export crc32-sum, crc32-with, crc32-update
  export crc32-ieee, crc32-castagnoli, crc32-koopman
  export crc64-sum, crc64-update, crc64-iso, crc64-ecma
  export ArmCrc32

  -- | Target-profile evidence that AArch64 CRC instructions may execute.
  -- Only profiles that guarantee the CRC extension should name this capability.
  signature ArmCrc32 where
    -- | Marker carried by target evidence; checksum callers need no dictionary.
    arm-crc32-evidence :: Unit -> Unit

  -- | Compute Adler-32 over all input bytes, starting at the standard state 1. The empty checksum is 1.
  adler32-sum :: Bytes -> U32
  adler32-sum b = Adler.adler32-sum b

  -- | Continue a finished Adler-32 checksum with another chunk. Empty input preserves the supplied state.
  adler32-update :: U32 -> Bytes -> U32
  adler32-update previous b = Adler.adler32-update previous b

  -- | The reflected IEEE CRC-32 polynomial, 0xEDB88320.
  crc32-ieee :: U32
  crc32-ieee = 0xEDB88320

  -- | The reflected Castagnoli CRC-32C polynomial, 0x82F63B78.
  crc32-castagnoli :: U32
  crc32-castagnoli = 0x82F63B78

  -- | The reflected Koopman CRC-32 polynomial, 0xEB31D82E.
  crc32-koopman :: U32
  crc32-koopman = 0xEB31D82E

  -- | Compute the IEEE CRC-32 checksum. The empty checksum is zero.
  crc32-sum :: Bytes -> U32
  crc32-sum b = crc32-with crc32-ieee b

  -- | Compute CRC-32 with the supplied reflected polynomial, starting from the finished state zero.
  crc32-with :: U32 -> Bytes -> U32
  crc32-with poly b = crc32-update poly 0 b

  -- | Continue a finished CRC-32 with another chunk. Arguments are reflected polynomial, previous checksum, and bytes; initial/final complementing is internal.
  crc32-update :: U32 -> U32 -> Bytes -> U32
  crc32-update poly previous b =
    let seed = bit-not-u32 previous in
    if eq-u32 poly crc32-ieee then
      bit-not-u32 (crc32-ieee-blocks b 0 seed)
    else if eq-u32 poly crc32-castagnoli then
      bit-not-u32 (crc32-cast-blocks b 0 seed)
    else if eq-u32 poly crc32-koopman then
      bit-not-u32 (crc32-koop-tail b 0 seed)
    else
      bit-not-u32 (crc32-blocks poly b 0 seed)

  -- | Consume four bytes per iteration using static IEEE slicing-by-four tables.
  crc32-ieee-blocks :: Bytes -> I64 -> U32 -> U32
  crc32-ieee-blocks b pos acc =
    let n = bytes-len-i64 b in
    if 4 <= n then
      let nn = nat-from-i64 n in
      let lim = nn - 4 in
      if 0 <= pos && pos <= wrapping-sub-i64 n 4 && nat-from-i64 pos <= lim then
        let w = bit-xor-u32 acc (bytes-load-le32-at b pos) in
        let b0 = wrapping-u32-to-u8 w in
        let b1 = wrapping-u32-to-u8 (wrapping-shr-u32 w 8) in
        let b2 = wrapping-u32-to-u8 (wrapping-shr-u32 w 16) in
        let b3 = wrapping-u32-to-u8 (wrapping-shr-u32 w 24) in
        let next = bit-xor-u32 (bit-xor-u32 (ieee-t3 b0) (ieee-t2 b1)) (bit-xor-u32 (ieee-t1 b2) (ieee-t0 b3)) in
        crc32-ieee-blocks b (wrapping-add-i64 pos 4) next
      else crc32-ieee-tail b pos acc
    else crc32-ieee-tail b pos acc

  -- | Finish remaining bytes with the static IEEE CRC-32 byte table.
  crc32-ieee-tail :: Bytes -> I64 -> U32 -> U32
  crc32-ieee-tail b pos acc =
    if 0 <= pos && pos < bytes-len-i64 b then
      let idx = bit-xor-u8 (wrapping-u32-to-u8 acc) (bytes-get-u8-at b pos) in
      crc32-ieee-tail b (wrapping-add-i64 pos 1) (bit-xor-u32 (ieee-t0 idx) (wrapping-shr-u32 acc 8))
    else acc

  -- | Consume four bytes per iteration using static Castagnoli slicing-by-four tables.
  crc32-cast-blocks :: Bytes -> I64 -> U32 -> U32
  crc32-cast-blocks b pos acc =
    let n = bytes-len-i64 b in
    if 4 <= n then
      let nn = nat-from-i64 n in
      let lim = nn - 4 in
      if 0 <= pos && pos <= wrapping-sub-i64 n 4 && nat-from-i64 pos <= lim then
        let w = bit-xor-u32 acc (bytes-load-le32-at b pos) in
        let b0 = wrapping-u32-to-u8 w in
        let b1 = wrapping-u32-to-u8 (wrapping-shr-u32 w 8) in
        let b2 = wrapping-u32-to-u8 (wrapping-shr-u32 w 16) in
        let b3 = wrapping-u32-to-u8 (wrapping-shr-u32 w 24) in
        let next = bit-xor-u32 (bit-xor-u32 (cast-t3 b0) (cast-t2 b1)) (bit-xor-u32 (cast-t1 b2) (cast-t0 b3)) in
        crc32-cast-blocks b (wrapping-add-i64 pos 4) next
      else crc32-cast-tail b pos acc
    else crc32-cast-tail b pos acc

  -- | Finish remaining bytes with the static Castagnoli CRC-32C byte table.
  crc32-cast-tail :: Bytes -> I64 -> U32 -> U32
  crc32-cast-tail b pos acc =
    if 0 <= pos && pos < bytes-len-i64 b then
      let idx = bit-xor-u8 (wrapping-u32-to-u8 acc) (bytes-get-u8-at b pos) in
      crc32-cast-tail b (wrapping-add-i64 pos 1) (bit-xor-u32 (cast-t0 idx) (wrapping-shr-u32 acc 8))
    else acc

  -- | Compute Koopman CRC-32 with a static lookup table over unboxed I64 indices.
  crc32-koop-tail :: Bytes -> I64 -> U32 -> U32
  crc32-koop-tail b pos acc =
    if 0 <= pos && pos < bytes-len-i64 b then
      let idx = bit-xor-u8 (wrapping-u32-to-u8 acc) (bytes-get-u8-at b pos) in
      crc32-koop-tail b (wrapping-add-i64 pos 1) (bit-xor-u32 (koop-t0 idx) (wrapping-shr-u32 acc 8))
    else acc

  -- | Consume complete eight-byte shift-register blocks without per-iteration Nat boxing.
  crc32-blocks :: U32 -> Bytes -> I64 -> U32 -> U32
  crc32-blocks poly b pos acc =
    let n = bytes-len-i64 b in
    if 8 <= n then
      let nn = nat-from-i64 n in
      let lim = nn - 8 in
      if 0 <= pos && pos <= wrapping-sub-i64 n 8 && nat-from-i64 pos <= lim then
        let w = bytes-load-le64-at b pos in
        crc32-blocks poly b (wrapping-add-i64 pos 8) (crc32-word acc w poly)
      else crc32-tail poly b pos acc
    else crc32-tail poly b pos acc

  -- | Finish remaining bytes after the final complete eight-byte shift-register block.
  crc32-tail :: U32 -> Bytes -> I64 -> U32 -> U32
  crc32-tail poly b pos acc =
    if 0 <= pos && pos < bytes-len-i64 b then
      let v = u8-to-u32 (bytes-get-u8-at b pos) in
      crc32-tail poly b (wrapping-add-i64 pos 1) (crc32-byte32 (bit-xor-u32 acc v) poly)
    else acc

  -- | Advance a reflected 32-bit CRC register by one bit using branchless masking.
  crc32-bit32 :: U32 -> U32 -> U32
  crc32-bit32 acc poly =
    let mask = wrapping-sub-u32 0 (bit-and-u32 acc 1) in
    bit-xor-u32 (wrapping-shr-u32 acc 1) (bit-and-u32 poly mask)

  -- | Advance a reflected 32-bit CRC register by eight bits.
  crc32-byte32 :: U32 -> U32 -> U32
  crc32-byte32 acc poly =
    let a1 = crc32-bit32 acc poly in let a2 = crc32-bit32 a1 poly in
    let a3 = crc32-bit32 a2 poly in let a4 = crc32-bit32 a3 poly in
    let a5 = crc32-bit32 a4 poly in let a6 = crc32-bit32 a5 poly in
    let a7 = crc32-bit32 a6 poly in crc32-bit32 a7 poly

  -- | Advance a reflected CRC-32 register inside a 64-bit word by one bit.
  crc32-bit64 :: U64 -> U64 -> U64
  crc32-bit64 acc poly =
    let mask = wrapping-sub-u64 0 (bit-and-u64 acc 1) in
    bit-xor-u64 (wrapping-shr-u64 acc 1) (bit-and-u64 poly mask)

  -- | Advance a reflected CRC-32 register inside a 64-bit word by eight bits.
  crc32-byte64 :: U64 -> U64 -> U64
  crc32-byte64 acc poly =
    let a1 = crc32-bit64 acc poly in let a2 = crc32-bit64 a1 poly in
    let a3 = crc32-bit64 a2 poly in let a4 = crc32-bit64 a3 poly in
    let a5 = crc32-bit64 a4 poly in let a6 = crc32-bit64 a5 poly in
    let a7 = crc32-bit64 a6 poly in crc32-bit64 a7 poly

  -- | Advance a reflected CRC through eight packed bytes using an unrolled shift register.
  crc32-word :: U32 -> U64 -> U32 -> U32
  crc32-word seed word poly =
    let p = u32-to-u64 poly in
    let a1 = crc32-byte64 (bit-xor-u64 (u32-to-u64 seed) word) p in
    let a2 = crc32-byte64 a1 p in let a3 = crc32-byte64 a2 p in
    let a4 = crc32-byte64 a3 p in let a5 = crc32-byte64 a4 p in
    let a6 = crc32-byte64 a5 p in let a7 = crc32-byte64 a6 p in
    wrapping-u64-to-u32 (crc32-byte64 a7 p)

  -- | The reflected ISO CRC-64 polynomial, 0xD800000000000000.
  crc64-iso :: U64
  crc64-iso = Crc.crc64-iso

  -- | The reflected ECMA CRC-64 polynomial, 0xC96C5795D7870F42.
  crc64-ecma :: U64
  crc64-ecma = Crc.crc64-ecma

  -- | Compute CRC-64 with a supplied reflected polynomial. Empty input yields zero.
  -- Reuse a prepared Text.Crc64 table when processing many chunks of one polynomial.
  crc64-sum :: U64 -> Bytes -> U64
  crc64-sum poly input = Crc.crc64-sum poly input

  -- | Continue a finished CRC-64 with the same reflected polynomial and additional bytes.
  crc64-update :: U64 -> U64 -> Bytes -> U64
  crc64-update poly previous input = Crc.crc64-update poly previous input

  -- | Static IEEE CRC-32 slice 0 table (128-entry GF(2) half-table).
  ieee-t0 :: U8 -> U32
  ieee-t0 b =
    let base = (
      case bit-and-u8 b 127 of
        0 -> 0x00000000; 1 -> 0x77073096; 2 -> 0xEE0E612C; 3 -> 0x990951BA; 4 -> 0x076DC419; 5 -> 0x706AF48F; 6 -> 0xE963A535; 7 -> 0x9E6495A3
        8 -> 0x0EDB8832; 9 -> 0x79DCB8A4; 10 -> 0xE0D5E91E; 11 -> 0x97D2D988; 12 -> 0x09B64C2B; 13 -> 0x7EB17CBD; 14 -> 0xE7B82D07; 15 -> 0x90BF1D91
        16 -> 0x1DB71064; 17 -> 0x6AB020F2; 18 -> 0xF3B97148; 19 -> 0x84BE41DE; 20 -> 0x1ADAD47D; 21 -> 0x6DDDE4EB; 22 -> 0xF4D4B551; 23 -> 0x83D385C7
        24 -> 0x136C9856; 25 -> 0x646BA8C0; 26 -> 0xFD62F97A; 27 -> 0x8A65C9EC; 28 -> 0x14015C4F; 29 -> 0x63066CD9; 30 -> 0xFA0F3D63; 31 -> 0x8D080DF5
        32 -> 0x3B6E20C8; 33 -> 0x4C69105E; 34 -> 0xD56041E4; 35 -> 0xA2677172; 36 -> 0x3C03E4D1; 37 -> 0x4B04D447; 38 -> 0xD20D85FD; 39 -> 0xA50AB56B
        40 -> 0x35B5A8FA; 41 -> 0x42B2986C; 42 -> 0xDBBBC9D6; 43 -> 0xACBCF940; 44 -> 0x32D86CE3; 45 -> 0x45DF5C75; 46 -> 0xDCD60DCF; 47 -> 0xABD13D59
        48 -> 0x26D930AC; 49 -> 0x51DE003A; 50 -> 0xC8D75180; 51 -> 0xBFD06116; 52 -> 0x21B4F4B5; 53 -> 0x56B3C423; 54 -> 0xCFBA9599; 55 -> 0xB8BDA50F
        56 -> 0x2802B89E; 57 -> 0x5F058808; 58 -> 0xC60CD9B2; 59 -> 0xB10BE924; 60 -> 0x2F6F7C87; 61 -> 0x58684C11; 62 -> 0xC1611DAB; 63 -> 0xB6662D3D
        64 -> 0x76DC4190; 65 -> 0x01DB7106; 66 -> 0x98D220BC; 67 -> 0xEFD5102A; 68 -> 0x71B18589; 69 -> 0x06B6B51F; 70 -> 0x9FBFE4A5; 71 -> 0xE8B8D433
        72 -> 0x7807C9A2; 73 -> 0x0F00F934; 74 -> 0x9609A88E; 75 -> 0xE10E9818; 76 -> 0x7F6A0DBB; 77 -> 0x086D3D2D; 78 -> 0x91646C97; 79 -> 0xE6635C01
        80 -> 0x6B6B51F4; 81 -> 0x1C6C6162; 82 -> 0x856530D8; 83 -> 0xF262004E; 84 -> 0x6C0695ED; 85 -> 0x1B01A57B; 86 -> 0x8208F4C1; 87 -> 0xF50FC457
        88 -> 0x65B0D9C6; 89 -> 0x12B7E950; 90 -> 0x8BBEB8EA; 91 -> 0xFCB9887C; 92 -> 0x62DD1DDF; 93 -> 0x15DA2D49; 94 -> 0x8CD37CF3; 95 -> 0xFBD44C65
        96 -> 0x4DB26158; 97 -> 0x3AB551CE; 98 -> 0xA3BC0074; 99 -> 0xD4BB30E2; 100 -> 0x4ADFA541; 101 -> 0x3DD895D7; 102 -> 0xA4D1C46D; 103 -> 0xD3D6F4FB
        104 -> 0x4369E96A; 105 -> 0x346ED9FC; 106 -> 0xAD678846; 107 -> 0xDA60B8D0; 108 -> 0x44042D73; 109 -> 0x33031DE5; 110 -> 0xAA0A4C5F; 111 -> 0xDD0D7CC9
        112 -> 0x5005713C; 113 -> 0x270241AA; 114 -> 0xBE0B1010; 115 -> 0xC90C2086; 116 -> 0x5768B525; 117 -> 0x206F85B3; 118 -> 0xB966D409; 119 -> 0xCE61E49F
        120 -> 0x5EDEF90E; 121 -> 0x29D9C998; 122 -> 0xB0D09822; 123 -> 0xC7D7A8B4; 124 -> 0x59B33D17; 125 -> 0x2EB40D81; 126 -> 0xB7BD5C3B; _ -> 0xC0BA6CAD
    ) in
    if ge-u8 b 128 then bit-xor-u32 base 0xEDB88320 else base

  -- | Static IEEE CRC-32 slice 1 table (128-entry GF(2) half-table).
  ieee-t1 :: U8 -> U32
  ieee-t1 b =
    let base = (
      case bit-and-u8 b 127 of
        0 -> 0x00000000; 1 -> 0x191B3141; 2 -> 0x32366282; 3 -> 0x2B2D53C3; 4 -> 0x646CC504; 5 -> 0x7D77F445; 6 -> 0x565AA786; 7 -> 0x4F4196C7
        8 -> 0xC8D98A08; 9 -> 0xD1C2BB49; 10 -> 0xFAEFE88A; 11 -> 0xE3F4D9CB; 12 -> 0xACB54F0C; 13 -> 0xB5AE7E4D; 14 -> 0x9E832D8E; 15 -> 0x87981CCF
        16 -> 0x4AC21251; 17 -> 0x53D92310; 18 -> 0x78F470D3; 19 -> 0x61EF4192; 20 -> 0x2EAED755; 21 -> 0x37B5E614; 22 -> 0x1C98B5D7; 23 -> 0x05838496
        24 -> 0x821B9859; 25 -> 0x9B00A918; 26 -> 0xB02DFADB; 27 -> 0xA936CB9A; 28 -> 0xE6775D5D; 29 -> 0xFF6C6C1C; 30 -> 0xD4413FDF; 31 -> 0xCD5A0E9E
        32 -> 0x958424A2; 33 -> 0x8C9F15E3; 34 -> 0xA7B24620; 35 -> 0xBEA97761; 36 -> 0xF1E8E1A6; 37 -> 0xE8F3D0E7; 38 -> 0xC3DE8324; 39 -> 0xDAC5B265
        40 -> 0x5D5DAEAA; 41 -> 0x44469FEB; 42 -> 0x6F6BCC28; 43 -> 0x7670FD69; 44 -> 0x39316BAE; 45 -> 0x202A5AEF; 46 -> 0x0B07092C; 47 -> 0x121C386D
        48 -> 0xDF4636F3; 49 -> 0xC65D07B2; 50 -> 0xED705471; 51 -> 0xF46B6530; 52 -> 0xBB2AF3F7; 53 -> 0xA231C2B6; 54 -> 0x891C9175; 55 -> 0x9007A034
        56 -> 0x179FBCFB; 57 -> 0x0E848DBA; 58 -> 0x25A9DE79; 59 -> 0x3CB2EF38; 60 -> 0x73F379FF; 61 -> 0x6AE848BE; 62 -> 0x41C51B7D; 63 -> 0x58DE2A3C
        64 -> 0xF0794F05; 65 -> 0xE9627E44; 66 -> 0xC24F2D87; 67 -> 0xDB541CC6; 68 -> 0x94158A01; 69 -> 0x8D0EBB40; 70 -> 0xA623E883; 71 -> 0xBF38D9C2
        72 -> 0x38A0C50D; 73 -> 0x21BBF44C; 74 -> 0x0A96A78F; 75 -> 0x138D96CE; 76 -> 0x5CCC0009; 77 -> 0x45D73148; 78 -> 0x6EFA628B; 79 -> 0x77E153CA
        80 -> 0xBABB5D54; 81 -> 0xA3A06C15; 82 -> 0x888D3FD6; 83 -> 0x91960E97; 84 -> 0xDED79850; 85 -> 0xC7CCA911; 86 -> 0xECE1FAD2; 87 -> 0xF5FACB93
        88 -> 0x7262D75C; 89 -> 0x6B79E61D; 90 -> 0x4054B5DE; 91 -> 0x594F849F; 92 -> 0x160E1258; 93 -> 0x0F152319; 94 -> 0x243870DA; 95 -> 0x3D23419B
        96 -> 0x65FD6BA7; 97 -> 0x7CE65AE6; 98 -> 0x57CB0925; 99 -> 0x4ED03864; 100 -> 0x0191AEA3; 101 -> 0x188A9FE2; 102 -> 0x33A7CC21; 103 -> 0x2ABCFD60
        104 -> 0xAD24E1AF; 105 -> 0xB43FD0EE; 106 -> 0x9F12832D; 107 -> 0x8609B26C; 108 -> 0xC94824AB; 109 -> 0xD05315EA; 110 -> 0xFB7E4629; 111 -> 0xE2657768
        112 -> 0x2F3F79F6; 113 -> 0x362448B7; 114 -> 0x1D091B74; 115 -> 0x04122A35; 116 -> 0x4B53BCF2; 117 -> 0x52488DB3; 118 -> 0x7965DE70; 119 -> 0x607EEF31
        120 -> 0xE7E6F3FE; 121 -> 0xFEFDC2BF; 122 -> 0xD5D0917C; 123 -> 0xCCCBA03D; 124 -> 0x838A36FA; 125 -> 0x9A9107BB; 126 -> 0xB1BC5478; _ -> 0xA8A76539
    ) in
    if ge-u8 b 128 then bit-xor-u32 base 0x3B83984B else base

  -- | Static IEEE CRC-32 slice 2 table (128-entry GF(2) half-table).
  ieee-t2 :: U8 -> U32
  ieee-t2 b =
    let base = (
      case bit-and-u8 b 127 of
        0 -> 0x00000000; 1 -> 0x01C26A37; 2 -> 0x0384D46E; 3 -> 0x0246BE59; 4 -> 0x0709A8DC; 5 -> 0x06CBC2EB; 6 -> 0x048D7CB2; 7 -> 0x054F1685
        8 -> 0x0E1351B8; 9 -> 0x0FD13B8F; 10 -> 0x0D9785D6; 11 -> 0x0C55EFE1; 12 -> 0x091AF964; 13 -> 0x08D89353; 14 -> 0x0A9E2D0A; 15 -> 0x0B5C473D
        16 -> 0x1C26A370; 17 -> 0x1DE4C947; 18 -> 0x1FA2771E; 19 -> 0x1E601D29; 20 -> 0x1B2F0BAC; 21 -> 0x1AED619B; 22 -> 0x18ABDFC2; 23 -> 0x1969B5F5
        24 -> 0x1235F2C8; 25 -> 0x13F798FF; 26 -> 0x11B126A6; 27 -> 0x10734C91; 28 -> 0x153C5A14; 29 -> 0x14FE3023; 30 -> 0x16B88E7A; 31 -> 0x177AE44D
        32 -> 0x384D46E0; 33 -> 0x398F2CD7; 34 -> 0x3BC9928E; 35 -> 0x3A0BF8B9; 36 -> 0x3F44EE3C; 37 -> 0x3E86840B; 38 -> 0x3CC03A52; 39 -> 0x3D025065
        40 -> 0x365E1758; 41 -> 0x379C7D6F; 42 -> 0x35DAC336; 43 -> 0x3418A901; 44 -> 0x3157BF84; 45 -> 0x3095D5B3; 46 -> 0x32D36BEA; 47 -> 0x331101DD
        48 -> 0x246BE590; 49 -> 0x25A98FA7; 50 -> 0x27EF31FE; 51 -> 0x262D5BC9; 52 -> 0x23624D4C; 53 -> 0x22A0277B; 54 -> 0x20E69922; 55 -> 0x2124F315
        56 -> 0x2A78B428; 57 -> 0x2BBADE1F; 58 -> 0x29FC6046; 59 -> 0x283E0A71; 60 -> 0x2D711CF4; 61 -> 0x2CB376C3; 62 -> 0x2EF5C89A; 63 -> 0x2F37A2AD
        64 -> 0x709A8DC0; 65 -> 0x7158E7F7; 66 -> 0x731E59AE; 67 -> 0x72DC3399; 68 -> 0x7793251C; 69 -> 0x76514F2B; 70 -> 0x7417F172; 71 -> 0x75D59B45
        72 -> 0x7E89DC78; 73 -> 0x7F4BB64F; 74 -> 0x7D0D0816; 75 -> 0x7CCF6221; 76 -> 0x798074A4; 77 -> 0x78421E93; 78 -> 0x7A04A0CA; 79 -> 0x7BC6CAFD
