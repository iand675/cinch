        88 -> 0x62AF7F08; 89 -> 0x636D153F; 90 -> 0x612BAB66; 91 -> 0x60E9C151; 92 -> 0x65A6D7D4; 93 -> 0x6464BDE3; 94 -> 0x662203BA; 95 -> 0x67E0698D
        96 -> 0x48D7CB20; 97 -> 0x4915A117; 98 -> 0x4B531F4E; 99 -> 0x4A917579; 100 -> 0x4FDE63FC; 101 -> 0x4E1C09CB; 102 -> 0x4C5AB792; 103 -> 0x4D98DDA5
        104 -> 0x46C49A98; 105 -> 0x4706F0AF; 106 -> 0x45404EF6; 107 -> 0x448224C1; 108 -> 0x41CD3244; 109 -> 0x400F5873; 110 -> 0x4249E62A; 111 -> 0x438B8C1D
        112 -> 0x54F16850; 113 -> 0x55330267; 114 -> 0x5775BC3E; 115 -> 0x56B7D609; 116 -> 0x53F8C08C; 117 -> 0x523AAABB; 118 -> 0x507C14E2; 119 -> 0x51BE7ED5
        120 -> 0x5AE239E8; 121 -> 0x5B2053DF; 122 -> 0x5966ED86; 123 -> 0x58A487B1; 124 -> 0x5DEB9134; 125 -> 0x5C29FB03; 126 -> 0x5E6F455A; _ -> 0x5FAD2F6D
    ) in
    if ge-u8 b 128 then bit-xor-u32 base 0xE1351B80 else base

  -- | Static IEEE CRC-32 slice 3 table (128-entry GF(2) half-table).
  ieee-t3 :: U8 -> U32
  ieee-t3 b =
    let base = (
      case bit-and-u8 b 127 of
        0 -> 0x00000000; 1 -> 0xB8BC6765; 2 -> 0xAA09C88B; 3 -> 0x12B5AFEE; 4 -> 0x8F629757; 5 -> 0x37DEF032; 6 -> 0x256B5FDC; 7 -> 0x9DD738B9
