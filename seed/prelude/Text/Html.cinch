-- | HTML text escaping and HTML5 named and numeric character references.
-- Escaping replaces only ampersand, both quotation marks and angle brackets.
-- Unescaping recognizes semicolon-terminated names, the documented legacy
-- semicolon-free names, decimal/hexadecimal numeric references and Windows-1252
-- numeric replacements. Unknown references remain unchanged. Reference expansion
-- is a single pass: newly decoded ampersands are not decoded again.
-- Byte APIs preserve unrelated arbitrary bytes; text APIs preserve valid UTF-8.
-- All returned byte buffers are fresh. Complete scanning blocks use LLVM SIMD;
-- private machine-counter loops retain their source until exact loads finish.
module Text.Html where

  import Data.Bytes
  import Data.Bytes.Word
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.String

  export html-escape, html-unescape, html-escape-bytes, html-unescape-bytes, html-escaped-length

  -- | Convert a complete unsigned machine word to an exact natural number.
  word-natural :: U64 -> Nat
  word-natural word = u32-to-nat (wrapping-u64-to-u32 word) + u32-to-nat (wrapping-u64-to-u32 (wrapping-shr-u64 word 32)) * 4294967296

  -- | Preserve the backing owner until a strict private traversal has returned.
  hold-source :: forall a. Bytes -> a -> a
  hold-source source value = case bytes-len source of _ -> value

  -- | Load one complete native word for order-independent SIMD classification.
  prim load-eight :: I64 -> U64 where
    unsafe llvm {
      %p = inttoptr i64 %0 to ptr
      %value = load i64, ptr %p, align 1
      ret i64 %value
    }

  -- | Load exactly one remaining source byte; no scalar fringe is overread.
  prim load-one :: I64 -> U8 where
    unsafe llvm {
      %p = inttoptr i64 %0 to ptr
      %value = load i8, ptr %p, align 1
      ret i8 %value
    }

  -- | Classify eight independent bytes; mode zero recognizes escaping bytes and mode one only ampersands.
  -- Only whether the mask is zero matters, so vector bit ordering is irrelevant.
  prim special-eight :: U64 -> U8 -> U8 where
    llvm {
      %v = bitcast i64 %0 to <8 x i8>
      %amp = icmp eq <8 x i8> %v, <i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38>
      %single = icmp eq <8 x i8> %v, <i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39>
      %double = icmp eq <8 x i8> %v, <i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34>
      %less = icmp eq <8 x i8> %v, <i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60>
      %greater = icmp eq <8 x i8> %v, <i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62>
      %quote = or <8 x i1> %single, %double
      %angle = or <8 x i1> %less, %greater
      %a = or <8 x i1> %quote, %angle
      %all = or <8 x i1> %a, %amp
      %decode = icmp ne i8 %1, 0
      %selected = select i1 %decode, <8 x i1> %amp, <8 x i1> %all
      %mask = bitcast <8 x i1> %selected to i8
      ret i8 %mask
    }

  -- | Sum exact escape expansion in eight bytes using SIMD classification and SWAR population counts.
  prim extra-eight :: U64 -> U64 where
    llvm {
      %v = bitcast i64 %0 to <8 x i8>
      %amp = icmp eq <8 x i8> %v, <i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38>
      %single = icmp eq <8 x i8> %v, <i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39, i8 39>
      %double = icmp eq <8 x i8> %v, <i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34, i8 34>
      %less = icmp eq <8 x i8> %v, <i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60>
      %greater = icmp eq <8 x i8> %v, <i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62, i8 62>
      %quotes = or <8 x i1> %single, %double
      %four = or <8 x i1> %quotes, %amp
      %three = or <8 x i1> %less, %greater
      %fm = bitcast <8 x i1> %four to i8
      %tm = bitcast <8 x i1> %three to i8
      %f = zext i8 %fm to i64
      %t = zext i8 %tm to i64
      %fs = lshr i64 %f, 1
      %ts = lshr i64 %t, 1
      %fa = and i64 %fs, 85
      %ta = and i64 %ts, 85
      %fb = sub i64 %f, %fa
      %tb = sub i64 %t, %ta
      %fc = and i64 %fb, 51
      %tc = and i64 %tb, 51
      %fd = lshr i64 %fb, 2
      %td = lshr i64 %tb, 2
      %fe = and i64 %fd, 51
      %te = and i64 %td, 51
      %ff = add i64 %fc, %fe
      %tf = add i64 %tc, %te
      %fg = lshr i64 %ff, 4
      %tg = lshr i64 %tf, 4
      %fh = add i64 %ff, %fg
      %th = add i64 %tf, %tg
      %fn = and i64 %fh, 15
      %tn = and i64 %th, 15
      %fx = mul i64 %fn, 4
      %tx = mul i64 %tn, 3
      %value = add i64 %fx, %tx
      ret i64 %value
    }

  -- | Exact extra byte count for one scalar input byte.
  extra-byte :: U8 -> U64
  extra-byte byte = if eq-u8 byte 38 || eq-u8 byte 39 || eq-u8 byte 34 then 4 else if eq-u8 byte 60 || eq-u8 byte 62 then 3 else 0

  -- | Count expansion with exact complete loads and bounded unsigned counters.
  count-extra :: I64 -> U64 -> U64 -> U64
  count-extra address remaining total =
    if ge-u64 remaining 8 then count-extra (wrapping-add-i64 address 8) (wrapping-sub-u64 remaining 8) (wrapping-add-u64 total (extra-eight (load-eight address)))
    else if ne-u64 remaining 0 then count-extra (wrapping-add-i64 address 1) (wrapping-sub-u64 remaining 1) (wrapping-add-u64 total (extra-byte (load-one address)))
    else total

  -- | Preserve exact natural arithmetic even for a conceptual buffer whose expansion exceeds one machine word.
  count-extra-natural :: Bytes -> Nat -> Nat -> Nat
  count-extra-natural input i total = if i < bytes-len input then
    count-extra-natural input (i + 1) (total + word-natural (extra-byte (wrapping-i64-to-u8 (nat-to-i64 (bytes-get input i)))))
    else total

  -- | Exact escaped byte count. Only five ASCII bytes expand; all other bytes retain their size.
  html-escaped-length :: Bytes -> Nat
  html-escaped-length input =
    let n = bytes-len input in
    if n <= 4611686018427387903 then n + word-natural (hold-source input (count-extra (bytes-data input) (wrapping-i64-to-u64 (nat-to-i64 n)) 0))
    else n + count-extra-natural input 0 0

  -- | Find a special byte in an exact fringe of at most eight bytes.
  find-fringe :: I64 -> U64 -> U8 -> U64 -> U64
  find-fringe address remaining mode count =
    if eq-u64 remaining 0 then count
    else let byte = load-one address in
      if eq-u8 byte 38 || (eq-u8 mode 0 && (eq-u8 byte 39 || eq-u8 byte 34 || eq-u8 byte 60 || eq-u8 byte 62)) then count
      else find-fringe (wrapping-add-i64 address 1) (wrapping-sub-u64 remaining 1) mode (wrapping-add-u64 count 1)

  -- | Skip complete ordinary spans in SIMD and stop before the next special byte or interval end.
  find-special :: I64 -> U64 -> U8 -> U64 -> U64
  find-special address remaining mode count =
    if ge-u64 remaining 8 then
      if eq-u8 (special-eight (load-eight address) mode) 0 then
        find-special (wrapping-add-i64 address 8) (wrapping-sub-u64 remaining 8) mode (wrapping-add-u64 count 8)
      else find-fringe address 8 mode count
    else find-fringe address remaining mode count

  -- | Return an immediately special byte without repeatedly classifying its following block.
  find-entry :: I64 -> U64 -> U8 -> U64
  find-entry address remaining mode =
    if eq-u64 remaining 0 then 0
    else if eq-u64 (find-fringe address 1 mode 0) 0 then 0
    else find-special address remaining mode 0

  -- | Return the next source byte needing interpretation, retaining its owner throughout the raw scan.
  next-special :: Bytes -> Nat -> U8 -> Nat
  next-special input start mode = if start <= bytes-len input then
    let address = wrapping-add-i64 (bytes-data input) (nat-to-i64 start) in
    start + word-natural (hold-source input (find-entry address (wrapping-i64-to-u64 (nat-to-i64 (bytes-len input - start))) mode))
    else bytes-len input

  -- | A private replacement whose low bytes are UTF-8 and whose top byte stores its byte count.
  packed-length :: U64 -> Nat
  packed-length word = u8-to-nat (wrapping-u64-to-u8 (wrapping-shr-u64 word 56))

  -- | Store only the live low replacement bytes within a checked output interval.
  store-packed :: Bytes -> Nat -> U64 -> Nat -> Unit
  store-packed out at word count =
    if count >= 4 && at + 4 <= bytes-len out then
      let written = bytes-write-le32 out at (wrapping-u64-to-u32 word) in
      store-packed out (at + 4) (wrapping-shr-u64 word 32) (count - 4)
    else if count == 1 && at < bytes-len out then bytes-set out at (u8-to-nat (wrapping-u64-to-u8 word))
    else if count > 0 && at < bytes-len out then
      let written = bytes-set out at (u8-to-nat (wrapping-u64-to-u8 word)) in
      store-packed out (at + 1) (wrapping-shr-u64 word 8) (count - 1)
    else ()

  -- | Pack the offset and byte count of one escape spelling in the private complete table.
  prim escape-span :: U8 -> U64 where
    llvm {
      %amp = icmp eq i8 %0, 38
      %single = icmp eq i8 %0, 39
      %double = icmp eq i8 %0, 34
      %less = icmp eq i8 %0, 60
      %greater = icmp eq i8 %0, 62
      %a = select i1 %greater, i64 1043, i64 0
      %b = select i1 %less, i64 1039, i64 %a
      %c = select i1 %double, i64 1290, i64 %b
      %d = select i1 %single, i64 1285, i64 %c
      %value = select i1 %amp, i64 1280, i64 %d
      ret i64 %value
    }

  -- | Copy ordinary runs once and emit only the five exact escape spellings between them.
  escape-from :: Bytes -> Nat -> Bytes -> Nat -> Bytes -> Unit
  escape-from input start out oi table =
    let stop = next-special input start 0 in
    if start <= stop && stop <= bytes-len input && oi + stop - start <= bytes-len out then
      let copied = if start < stop then bytes-copy-range out input oi start (stop - start) else () in
      let next = oi + stop - start in
      if stop < bytes-len input then
        let byte = wrapping-i64-to-u8 (nat-to-i64 (bytes-get input stop)) in
        let span = escape-span byte in
        let offset = u8-to-nat (wrapping-u64-to-u8 span) in
        let n = u8-to-nat (wrapping-u64-to-u8 (wrapping-shr-u64 span 8)) in
        if offset + n <= bytes-len table && next + n <= bytes-len out then
          let written = bytes-copy-range out table next offset n in
          escape-from input (stop + 1) out (next + n) table
        else ()
      else ()
    else ()

  -- | Allocate one exact escaped output after its complete byte count is known.
  escape-sized :: Bytes -> Nat -> Bytes
  escape-sized input size = let out = bytes-new size in
    if size == bytes-len input then let copied = bytes-copy-range out input 0 0 size in out
    else let table = string-to-bytes "&amp;&#39;&#34;&lt;&gt;" in
      let written = escape-from input 0 out 0 table in out

  -- | Escape arbitrary input bytes into fresh storage. Unrelated non-UTF-8 bytes are preserved exactly.
  html-escape-bytes :: Bytes -> Bytes
  html-escape-bytes input = escape-sized input (html-escaped-length input)

  -- | Escape ampersand, apostrophe, double quotation mark and angle brackets in UTF-8 text.
  -- Apostrophes use &#39; and double quotation marks use &#34;.
  html-escape :: String -> String
  html-escape input =
    let bytes = string-to-bytes input in let size = html-escaped-length bytes in
    if size == bytes-len bytes then input
    else case string-from-bytes (escape-sized bytes size) of
      Some result -> result
      None -> empty-string

  -- | Whether a byte is an ASCII letter or digit used in a named reference.
  entity-byte :: U8 -> Bool
  entity-byte byte = (ge-u8 byte 97 && le-u8 byte 122) || (ge-u8 byte 65 && le-u8 byte 90) || (ge-u8 byte 48 && le-u8 byte 57)

  -- | Scan a bounded name with exact byte loads and machine counters, stopping at one semicolon.
  scan-name :: I64 -> U64 -> U64 -> U64 -> U64
  scan-name address remaining limit count =
    if eq-u64 remaining 0 || eq-u64 limit 0 then count
    else let byte = load-one address in
      if entity-byte byte then scan-name (wrapping-add-i64 address 1) (wrapping-sub-u64 remaining 1) (wrapping-sub-u64 limit 1) (wrapping-add-u64 count 1)
      else if eq-u8 byte 59 then wrapping-add-u64 count 1 else count

  -- | Scan no more than the longest possible complete name plus one sentinel byte.
  named-end :: Bytes -> Nat -> Nat
  named-end input start = if start <= bytes-len input then
    let address = wrapping-add-i64 (bytes-data input) (nat-to-i64 start) in
    start + word-natural (hold-source input (scan-name address (wrapping-i64-to-u64 (nat-to-i64 (bytes-len input - start))) 33 0))
    else bytes-len input

  -- | Pack fewer than eight checked name bytes without reading beyond the source.
  name-fringe :: I64 -> U64 -> U64 -> U32 -> U64
  name-fringe address n word shift = if ne-u64 n 0 then
    let byte = u8-to-u64 (load-one address) in
    name-fringe (wrapping-add-i64 address 1) (wrapping-sub-u64 n 1) (bit-or-u64 word (wrapping-shl-u64 byte shift)) (wrapping-add-u32 shift 8)
    else word

  -- | Read one normalized little-endian name word, with zeroes beyond its checked name interval.
  name-word :: Bytes -> Nat -> Nat -> Nat -> U64
  name-word input start n offset = if offset < n then
    let at = start + offset in let remaining = n - offset in
    if remaining >= 8 && at + 8 <= bytes-len input then bytes-read-le64 input at
    else if remaining < 8 && at + remaining <= bytes-len input then
      let address = wrapping-add-i64 (bytes-data input) (nat-to-i64 at) in
      hold-source input (name-fringe address (wrapping-i64-to-u64 (nat-to-i64 remaining)) 0 0)
    else 0
    else 0

  -- | Hash four normalized words and a length with deterministic unsigned wrapping.
  -- Every generated leaf also checks the complete name, making collisions harmless.
  prim entity-name-hash :: U64 -> U64 -> U64 -> U64 -> U64 -> U64 where
    llvm {
      %a = mul i64 %0, 11400714785074694791
      %b = mul i64 %1, 14029467366897019727
      %c = mul i64 %2, 1609587929392839161
      %d = mul i64 %3, 9650029242287828579
      %ab = xor i64 %a, %b
      %cd = xor i64 %c, %d
      %both = xor i64 %ab, %cd
      %value = xor i64 %both, %4
      ret i64 %value
    }

  -- | Match one complete name using four packed source words without allocating a temporary name.
  lookup-name :: Bytes -> Nat -> Nat -> U64
  lookup-name input start n = if n > 0 && n <= 32 && start + n <= bytes-len input then
    entity-lookup (name-word input start n 0) (name-word input start n 8) (name-word input start n 16) (name-word input start n 24) (wrapping-i64-to-u64 (nat-to-i64 n))
    else 0

  -- | A decoded reference's source end and packed UTF-8 replacement; zero means no reference matched.
  data HtmlReference where
    -- | Private checked original source end and up to six replacement bytes.
    Reference :: Nat -> U64 -> HtmlReference

  -- | Try the longest supported legacy name first, never treating a partial semicolon name as complete.
  legacy-reference :: Bytes -> Nat -> Nat -> HtmlReference
  legacy-reference input start n = if n > 1 then
    let word = lookup-name input start n in
    if ne-u64 word 0 then Reference (start + n) word else legacy-reference input start (n - 1)
    else Reference start 0

  -- | Resolve an exact named reference or its longest accepted legacy prefix.
  named-reference :: Bytes -> Nat -> HtmlReference
  named-reference input start =
    let end = named-end input start in let n = saturating-sub end start in
    let word = lookup-name input start n in
    if ne-u64 word 0 then Reference end word
    else let max = if n > 7 then (6 :: Nat) else saturating-sub n 1 in legacy-reference input start max

  -- | Convert one ASCII decimal or hexadecimal digit to a bounded numeric value.
  numeric-digit :: Bool -> Nat -> Option U32
  numeric-digit hex byte =
    if byte >= 48 && byte <= 57 then Some (wrapping-i64-to-u32 (nat-to-i64 (byte - 48)))
    else if hex && byte >= 65 && byte <= 70 then Some (wrapping-i64-to-u32 (nat-to-i64 (byte - 55)))
    else if hex && byte >= 97 && byte <= 102 then Some (wrapping-i64-to-u32 (nat-to-i64 (byte - 87)))
    else None

  -- | Apply the HTML numeric reference replacements for legacy Windows-1252 values.
  numeric-replacement :: U32 -> U32
  numeric-replacement value =
    if eq-u32 value 128 then 8364 else if eq-u32 value 130 then 8218
    else if eq-u32 value 131 then 402 else if eq-u32 value 132 then 8222
    else if eq-u32 value 133 then 8230 else if eq-u32 value 134 then 8224
    else if eq-u32 value 135 then 8225 else if eq-u32 value 136 then 710
    else if eq-u32 value 137 then 8240 else if eq-u32 value 138 then 352
    else if eq-u32 value 139 then 8249 else if eq-u32 value 140 then 338
    else if eq-u32 value 142 then 381 else if eq-u32 value 145 then 8216
    else if eq-u32 value 146 then 8217 else if eq-u32 value 147 then 8220
    else if eq-u32 value 148 then 8221 else if eq-u32 value 149 then 8226
    else if eq-u32 value 150 then 8211 else if eq-u32 value 151 then 8212
    else if eq-u32 value 152 then 732 else if eq-u32 value 153 then 8482
    else if eq-u32 value 154 then 353 else if eq-u32 value 155 then 8250
    else if eq-u32 value 156 then 339 else if eq-u32 value 158 then 382
    else if eq-u32 value 159 then 376
    else if eq-u32 value 0 || (ge-u32 value 55296 && le-u32 value 57343) || gt-u32 value 1114111 then 65533
    else value

  -- | Pack one validated scalar as UTF-8 together with its exact encoded length.
  prim pack-scalar :: U32 -> U64 where
    llvm {
      %a = zext i32 %0 to i64
      %one = icmp ult i64 %a, 128
      %two = icmp ult i64 %a, 2048
      %three = icmp ult i64 %a, 65536
      %b1 = and i64 %a, 63
      %tail1 = or i64 %b1, 128
      %s1 = shl i64 %tail1, 8
      %s2 = shl i64 %tail1, 16
      %s3 = shl i64 %tail1, 24
      %a6 = lshr i64 %a, 6
      %a12 = lshr i64 %a, 12
      %a18 = lshr i64 %a, 18
      %lead2 = or i64 %a6, 192
      %v2 = or i64 %lead2, %s1
      %b2 = and i64 %a6, 63
      %tail2 = or i64 %b2, 128
      %t21 = shl i64 %tail2, 8
      %t22 = shl i64 %tail2, 16
      %lead3 = or i64 %a12, 224
      %v3a = or i64 %lead3, %t21
      %v3 = or i64 %v3a, %s2
      %b3 = and i64 %a12, 63
      %tail3 = or i64 %b3, 128
      %t31 = shl i64 %tail3, 8
      %lead4 = or i64 %a18, 240
      %v4a = or i64 %lead4, %t31
      %v4b = or i64 %v4a, %t22
      %v4 = or i64 %v4b, %s3
      %v34 = select i1 %three, i64 %v3, i64 %v4
      %v234 = select i1 %two, i64 %v2, i64 %v34
      %v = select i1 %one, i64 %a, i64 %v234
      %n34 = select i1 %three, i64 3, i64 4
      %n234 = select i1 %two, i64 2, i64 %n34
      %n = select i1 %one, i64 1, i64 %n234
      %length = shl i64 %n, 56
      %value = or i64 %v, %length
      ret i64 %value
    }

  -- | Finish numeric parsing, preserving short malformed prefixes and exact delimiter consumption.
  finish-numeric :: Nat -> Nat -> U32 -> HtmlReference
  finish-numeric amp end value =
    if end <= amp + 3 then Reference (amp + 1) 0
    else Reference end (pack-scalar (numeric-replacement value))

  -- | Consume decimal or hexadecimal digits with explicit 32-bit wrapping accumulation.
  numeric-from :: Bytes -> Nat -> Nat -> Bool -> U32 -> HtmlReference
  numeric-from input amp at hex value =
    if at < bytes-len input then
      let byte = bytes-get input at in case numeric-digit hex byte of
        Some digit -> numeric-from input amp (at + 1) hex (wrapping-add-u32 (wrapping-mul-u32 value (if hex then 16 else 10)) digit)
        None -> finish-numeric amp (if byte == 59 then at + 1 else at) value
    else finish-numeric amp at value

  -- | Parse one numeric or named reference after an ampersand, without recursive expansion.
  reference-at :: Bytes -> Nat -> HtmlReference
  reference-at input amp =
    if amp + 1 < bytes-len input then
      if bytes-get input (amp + 1) == 35 && amp + 3 < bytes-len input then
        let byte = bytes-get input (amp + 2) in
        if byte == 120 || byte == 88 then numeric-from input amp (amp + 3) True 0
        else numeric-from input amp (amp + 2) False 0
      else if bytes-get input (amp + 1) == 35 then Reference (amp + 1) 0
      else named-reference input (amp + 1)
    else Reference (amp + 1) 0

  -- | Decode one reference between bulk copies of ordinary source spans.
  unescape-from :: Bytes -> Nat -> Bytes -> Nat -> Nat
  unescape-from input start out oi =
    let stop = next-special input start 1 in
    if start <= stop && stop <= bytes-len input && oi + stop - start <= bytes-len out then
      let copied = if start < stop then bytes-copy-range out input oi start (stop - start) else () in
      let next = oi + stop - start in
      if stop < bytes-len input then case reference-at input stop of
        Reference end word ->
          if ne-u64 word 0 then
            let n = packed-length word in let written = store-packed out next word n in
            unescape-from input end out (next + n)
          else if next < bytes-len out then
            let written = bytes-set out next 38 in unescape-from input (stop + 1) out (next + 1)
          else next
      else next
    else oi

  -- | Decode from a known first ampersand, copying its ordinary prefix only once.
  -- An input with no ampersand needs only the required fresh result allocation.
  unescape-since :: Bytes -> Nat -> Bytes
  unescape-since input first =
    if first == bytes-len input then
      let result = bytes-new first in let copied = bytes-copy-range result input 0 0 first in result
    else if first < bytes-len input then
      let out = bytes-new (bytes-len input * 2) in
      if first <= bytes-len out then
        let prefix = bytes-copy-range out input 0 0 first in
        let n = unescape-from input first out first in
        if n <= bytes-len out then
          let result = bytes-new n in let copied = bytes-copy-range result out 0 0 n in result
        else bytes-new 0
      else bytes-new 0
    else bytes-new 0

  -- | Decode HTML5 references into fresh arbitrary bytes, retaining unrelated bytes exactly.
  -- Complete named references may expand: for example, &nLt; produces two scalars and six UTF-8 bytes.
  html-unescape-bytes :: Bytes -> Bytes
  html-unescape-bytes input = unescape-since input (next-special input 0 1)

  -- | Decode named and numeric HTML references once, preserving unknown reference text.
  -- Legacy names can omit a semicolon; invalid numeric scalars become U+FFFD.
  -- Numeric accumulation wraps at 32 bits before scalar replacement.
  html-unescape :: String -> String
  html-unescape input =
    let bytes = string-to-bytes input in let first = next-special bytes 0 1 in
    if first == bytes-len bytes then input
    else case string-from-bytes (unescape-since bytes first) of
      Some result -> result
      None -> empty-string

  -- | Generated packed HTML named-reference lookup; regenerate with tooling/generate_html_entities.py.
  -- Input data and licensing: tooling/data/html-entities.json and html-entities-PYTHON-LICENSE.txt.
  entity-lookup :: U64 -> U64 -> U64 -> U64 -> U64 -> U64
  entity-lookup a b c d n = entity-route (entity-name-hash a b c d n) a b c d n

  -- | Route a complete packed name through a bounded balanced machine-word search.
  entity-route :: U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64
  entity-route h a b c d n =
    if lt-u64 h 9200771162646014701 then
      if lt-u64 h 4495391819742633608 then
        if lt-u64 h 2388328299492893007 then
          if lt-u64 h 1094771620883019179 then
            if lt-u64 h 539327875249949544 then
              entity-bucket-a h a b c d n
            else
              entity-bucket-b h a b c d n
          else
            if lt-u64 h 1705229957331073954 then
              entity-bucket-c h a b c d n
