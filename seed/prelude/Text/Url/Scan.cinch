-- | Checked byte intervals and exact-load portable 16-byte SIMD scans used by URL grammars.
-- Every returned interval is a fresh buffer. Searches return the interval end
-- when absent; malformed bounds are rejected by returning the complete input end.
module Text.Url.Scan where
  import Data.Bool
  import Data.Bytes
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Wide

  export url-copy, url-slice, url-concat, url-find-byte, url-last-byte, url-find-control, url-count-byte, url-scheme-colon, url-find-invalid-user

  -- | Copy a complete input without retaining a mutable caller alias.
  url-copy :: Bytes -> Bytes
  url-copy input = let out = bytes-new (bytes-len input) in
    let copied = bytes-copy-range out input 0 0 (bytes-len input) in out

  -- | Copy a half-open interval, returning empty bytes for invalid bounds.
  url-slice :: Bytes -> Nat -> Nat -> Bytes
  url-slice input start end = if start <= end && end <= bytes-len input then
    let out = bytes-new (end - start) in
    let copied = bytes-copy-range out input 0 start (end - start) in out
    else bytes-new 0

  -- | Compute the exact aggregate capacity of independent byte chunks.
  chunks-size :: List Bytes -> Nat -> Nat
  chunks-size chunks count = case chunks of Nil -> count; Cons chunk rest -> chunks-size rest (count + bytes-len chunk)

  -- | Copy each chunk once into its proved output interval.
  chunks-write :: List Bytes -> Bytes -> Nat -> Bytes
  chunks-write chunks out at = case chunks of
    Nil -> out
    Cons chunk rest -> if at + bytes-len chunk <= bytes-len out then
      let copied = bytes-copy-range out chunk at 0 (bytes-len chunk) in chunks-write rest out (at + bytes-len chunk)
      else out

  -- | Concatenate chunks with one exact allocation and one checked copy per chunk.
  url-concat :: List Bytes -> Bytes
  url-concat chunks = chunks-write chunks (bytes-new (chunks-size chunks 0)) 0

  -- | Classify sixteen bytes for ASCII controls (0..31) and DEL (127), returning a 16-bit lane mask.
  mask-control16 :: U128 -> U32
  mask-control16 v =
    let low = simd-u8x16-cmplt v (simd-u8x16-splat 32) in
    let del = simd-u8x16-cmpeq v (simd-u8x16-splat 127) in
    simd-u8x16-movemask (bit-or-u128 low del)

  -- | Return true when all sixteen bytes are valid RFC 3986 scheme continuation bytes.
  all-scheme16 :: U128 -> Bool
  all-scheme16 v =
    let folded = bit-or-u128 v (simd-u8x16-splat 32) in
    let alpha = simd-u8x16-cmplt (simd-u8x16-sub folded (simd-u8x16-splat 97)) (simd-u8x16-splat 26) in
    let digit = simd-u8x16-cmplt (simd-u8x16-sub v (simd-u8x16-splat 48)) (simd-u8x16-splat 10) in
    let punct = bit-or-u128 (simd-u8x16-cmpeq v (simd-u8x16-splat 43))
                  (bit-or-u128 (simd-u8x16-cmpeq v (simd-u8x16-splat 45)) (simd-u8x16-cmpeq v (simd-u8x16-splat 46))) in
    let allowed = bit-or-u128 (bit-or-u128 alpha digit) punct in
    eq-u32 (simd-u8x16-movemask allowed) 65535

  -- | Return true when all sixteen bytes belong to the raw ASCII user-information alphabet.
  all-user16 :: U128 -> Bool
  all-user16 v =
    let folded = bit-or-u128 v (simd-u8x16-splat 32) in
    let alpha = simd-u8x16-cmplt (simd-u8x16-sub folded (simd-u8x16-splat 97)) (simd-u8x16-splat 26) in
    let range1 = simd-u8x16-cmplt (simd-u8x16-sub v (simd-u8x16-splat 36)) (simd-u8x16-splat 11) in
    let range2 = simd-u8x16-cmplt (simd-u8x16-sub v (simd-u8x16-splat 48)) (simd-u8x16-splat 12) in
    let p1 = bit-or-u128 (simd-u8x16-cmpeq v (simd-u8x16-splat 33)) (simd-u8x16-cmpeq v (simd-u8x16-splat 61)) in
    let p2 = bit-or-u128 (simd-u8x16-cmpeq v (simd-u8x16-splat 64)) (simd-u8x16-cmpeq v (simd-u8x16-splat 95)) in
    let punct = bit-or-u128 (bit-or-u128 p1 p2) (simd-u8x16-cmpeq v (simd-u8x16-splat 126)) in
    let allowed = bit-or-u128 (bit-or-u128 alpha range1) (bit-or-u128 range2 punct) in
    eq-u32 (simd-u8x16-movemask allowed) 65535

  -- | Recognize the raw ASCII user-information alphabet using bounded range comparisons.
  user-byte :: U8 -> Bool
  user-byte byte =
    let folded = bit-or-u8 byte 32 in
    lt-u8 (wrapping-sub-u8 folded 97) 26
    || lt-u8 (wrapping-sub-u8 byte 36) 11
    || lt-u8 (wrapping-sub-u8 byte 48) 12
    || eq-u8 byte 33 || eq-u8 byte 61 || eq-u8 byte 64 || eq-u8 byte 95 || eq-u8 byte 126

  -- | Test one exact fringe byte for the selected scan policy.
  matches :: U8 -> U8 -> U8 -> Bool
  matches byte wanted mode =
    if eq-u8 mode 1 then lt-u8 byte 32 || eq-u8 byte 127
    else if eq-u8 mode 2 then
      let folded = bit-or-u8 byte 32 in
      not (lt-u8 (wrapping-sub-u8 folded 97) 26 || lt-u8 (wrapping-sub-u8 byte 48) 10 || eq-u8 byte 43 || eq-u8 byte 45 || eq-u8 byte 46)
    else if eq-u8 mode 3 then not (user-byte byte)
    else eq-u8 byte wanted

  -- | Seek the first matching scalar fringe byte inside a bounded interval.
  fringe :: Bytes -> I64 -> I64 -> U8 -> U8 -> I64
  fringe input i stop wanted mode =
    if 0 <= i && i < stop && i < bytes-len-i64 input then
      if matches (bytes-get-u8-at input i) wanted mode then i
      else fringe input (wrapping-add-i64 i 1) stop wanted mode
    else stop

  -- | Skip complete sixteen-byte blocks using SIMD target-byte equality classification.
  forward-byte :: Bytes -> I64 -> I64 -> U128 -> U8 -> I64
  forward-byte input i end pat wanted =
    let len = bytes-len-i64 input in
    let stop = if le-i64 end len then end else len in
    if 16 <= stop && 0 <= i then
      let ns = nat-from-i64 stop in
      let nl = nat-from-i64 len in
      if 16 <= ns && ns <= nl then
        let ni = nat-from-i64 i in
        if ni <= ns - 16 then
          let chunk = bytes-load-u128-at input i in
          let mask = simd-u8x16-movemask (simd-u8x16-cmpeq chunk pat) in
          if eq-u32 mask 0 then forward-byte input (wrapping-add-i64 i 16) stop pat wanted
          else fringe input i stop wanted 0
        else fringe input i stop wanted 0
      else fringe input i stop wanted 0
    else fringe input i stop wanted 0

  -- | Skip complete sixteen-byte blocks using SIMD ASCII controls and DEL classification.
  forward-control :: Bytes -> I64 -> I64 -> I64
  forward-control input i end =
    let len = bytes-len-i64 input in
    let stop = if le-i64 end len then end else len in
    if 16 <= stop && 0 <= i then
      let ns = nat-from-i64 stop in
      let nl = nat-from-i64 len in
      if 16 <= ns && ns <= nl then
        let ni = nat-from-i64 i in
        if ni <= ns - 16 then
          let chunk = bytes-load-u128-at input i in
          if eq-u32 (mask-control16 chunk) 0 then forward-control input (wrapping-add-i64 i 16) stop
          else fringe input i stop 0 1
        else fringe input i stop 0 1
      else fringe input i stop 0 1
    else fringe input i stop 0 1

  -- | Skip complete sixteen-byte blocks using SIMD valid scheme-byte classification.
  forward-scheme :: Bytes -> I64 -> I64 -> I64
  forward-scheme input i end =
    let len = bytes-len-i64 input in
    let stop = if le-i64 end len then end else len in
    if 16 <= stop && 0 <= i then
      let ns = nat-from-i64 stop in
      let nl = nat-from-i64 len in
      if 16 <= ns && ns <= nl then
        let ni = nat-from-i64 i in
        if ni <= ns - 16 then
          let chunk = bytes-load-u128-at input i in
          if all-scheme16 chunk then forward-scheme input (wrapping-add-i64 i 16) stop
          else fringe input i stop 0 2
        else fringe input i stop 0 2
      else fringe input i stop 0 2
    else fringe input i stop 0 2

  -- | Skip raw user-information sixteen-byte blocks using a range-compressed SIMD grammar.
  forward-user :: Bytes -> I64 -> I64 -> I64
  forward-user input i end =
    let len = bytes-len-i64 input in
    let stop = if le-i64 end len then end else len in
    if 16 <= stop && 0 <= i then
      let ns = nat-from-i64 stop in
      let nl = nat-from-i64 len in
      if 16 <= ns && ns <= nl then
        let ni = nat-from-i64 i in
        if ni <= ns - 16 then
          let chunk = bytes-load-u128-at input i in
          if all-user16 chunk then forward-user input (wrapping-add-i64 i 16) stop
          else fringe input i stop 0 3
        else fringe input i stop 0 3
      else fringe input i stop 0 3
    else fringe input i stop 0 3

  -- | Search backwards through a scalar fringe inside a checked half-open interval.
  backward-fringe :: Bytes -> I64 -> I64 -> U8 -> I64
  backward-fringe input start cur wanted =
    if lt-i64 start cur && cur <= bytes-len-i64 input then
      let prev = wrapping-sub-i64 cur 1 in
      if 0 <= prev && prev < bytes-len-i64 input then
        if eq-u8 (bytes-get-u8-at input prev) wanted then prev
        else backward-fringe input start prev wanted
      else -1
    else -1

  -- | Search backwards by complete sixteen-byte SIMD blocks, then an exact reverse fringe.
  backward-blocks :: Bytes -> I64 -> I64 -> U128 -> U8 -> I64
  backward-blocks input start cur pat wanted =
    let len = bytes-len-i64 input in
    if 16 <= len then
      if 0 <= start && 16 <= cur && cur <= len then
        let at = wrapping-sub-i64 cur 16 in
        if start <= at && 0 <= at then
          let nl = nat-from-i64 len in
          if 16 <= nl then
            let na = nat-from-i64 at in
            if na <= nl - 16 then
              let chunk = bytes-load-u128-at input at in
              let mask = simd-u8x16-movemask (simd-u8x16-cmpeq chunk pat) in
              if eq-u32 mask 0 then backward-blocks input start at pat wanted
              else backward-fringe input at cur wanted
            else backward-fringe input start cur wanted
          else backward-fringe input start cur wanted
        else backward-fringe input start cur wanted
      else backward-fringe input start cur wanted
    else backward-fringe input start cur wanted

  -- | Count matching bytes across a scalar tail inside a checked interval.
  count-tail :: Bytes -> I64 -> I64 -> U8 -> U64 -> U64
  count-tail input i stop wanted total =
    if 0 <= i && i < stop && i < bytes-len-i64 input then
      let n = if eq-u8 (bytes-get-u8-at input i) wanted then (1 :: U64) else 0 in
      count-tail input (wrapping-add-i64 i 1) stop wanted (wrapping-add-u64 total n)
    else total

  -- | Count matching bytes using sixteen-byte SIMD masks and hardware population counts.
  count-blocks :: Bytes -> I64 -> I64 -> U128 -> U8 -> U64 -> U64
  count-blocks input i end pat wanted total =
    let len = bytes-len-i64 input in
    let stop = if le-i64 end len then end else len in
    if 16 <= stop && 0 <= i then
      let ns = nat-from-i64 stop in
      let nl = nat-from-i64 len in
      if 16 <= ns && ns <= nl then
        let ni = nat-from-i64 i in
        if ni <= ns - 16 then
          let chunk = bytes-load-u128-at input i in
          let mask = simd-u8x16-movemask (simd-u8x16-cmpeq chunk pat) in
          let hits = u32-to-u64 (count-ones-u32 mask) in
          count-blocks input (wrapping-add-i64 i 16) stop pat wanted (wrapping-add-u64 total hits)
        else count-tail input i stop wanted total
      else count-tail input i stop wanted total
    else count-tail input i stop wanted total

  -- | Reconstruct a nonnegative physical-buffer count outside the machine loop.
  natural-word :: U64 -> Nat
  natural-word word = u32-to-nat (wrapping-u64-to-u32 word) + 4294967296 * u32-to-nat (wrapping-u64-to-u32 (wrapping-shr-u64 word 32))

  -- | Dispatch a checked forward interval without raw pointers.
  find :: Bytes -> Nat -> Nat -> Nat -> U8 -> Nat
  find input start end wanted mode = if start <= end && end <= bytes-len input && wanted <= 255 then
    let si = nat-to-i64 start in
    let ei = nat-to-i64 end in
    let byte = wrapping-i64-to-u8 (nat-to-i64 wanted) in
    let result = (
      if eq-u8 mode 1 then forward-control input si ei
      else if eq-u8 mode 2 then forward-scheme input si ei
      else if eq-u8 mode 3 then forward-user input si ei
      else forward-byte input si ei (simd-u8x16-splat byte) byte
    ) in
    if 0 <= result then let at = nat-from-i64 result in if at <= end then at else end else end
    else bytes-len input

  -- | Find the first wanted byte in a half-open interval, or its end when absent.
  url-find-byte :: Bytes -> Nat -> Nat -> Nat -> Nat
  url-find-byte input start end wanted = find input start end wanted 0

  -- | Find the first ASCII control or DEL in a half-open interval, or its end.
  url-find-control :: Bytes -> Nat -> Nat -> Nat
  url-find-control input start end = find input start end 0 1

  -- | Find the last wanted byte in a half-open interval, or its end when absent.
  url-last-byte :: Bytes -> Nat -> Nat -> Nat -> Nat
  url-last-byte input start end wanted = if start <= end && end <= bytes-len input && wanted <= 255 then
    let si = nat-to-i64 start in
    let ei = nat-to-i64 end in
    let byte = wrapping-i64-to-u8 (nat-to-i64 wanted) in
    let result = backward-blocks input si ei (simd-u8x16-splat byte) byte in
    if 0 <= result then let at = nat-from-i64 result in if at < end then at else end else end
    else bytes-len input

  -- | Count exact wanted-byte occurrences in a half-open interval; invalid bounds yield zero.
  url-count-byte :: Bytes -> Nat -> Nat -> Nat -> Nat
  url-count-byte input start end wanted = if start <= end && end <= bytes-len input && wanted <= 255 then
    let si = nat-to-i64 start in
    let ei = nat-to-i64 end in
    let byte = wrapping-i64-to-u8 (nat-to-i64 wanted) in
    natural-word (count-blocks input si ei (simd-u8x16-splat byte) byte 0) else 0

  -- | Find an ASCII scheme colon with SIMD grammar scanning; return input length when absent or invalid.
  url-scheme-colon :: Bytes -> Nat
  url-scheme-colon input = if bytes-len input > 0 then
    let first = bytes-get input 0 in
    if first == 58 then 0
    else if (first >= 65 && first <= 90) || (first >= 97 && first <= 122) then
      let at = find input 0 (bytes-len input) 0 2 in
      if at < bytes-len input then (if bytes-get input at == 58 then at else bytes-len input) else bytes-len input
    else bytes-len input
    else 0

  -- | Find the first unsupported raw ASCII user-information byte, or the interval end.
  url-find-invalid-user :: Bytes -> Nat -> Nat -> Nat
  url-find-invalid-user input start end = find input start end 0 3
