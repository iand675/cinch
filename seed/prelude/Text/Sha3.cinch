  -- | XOR one proved complete 72-byte block of little-endian words into the rate lanes, then permute.
  keccak-absorb9 :: KeccakLanes -> I64 -> KeccakLanes
  keccak-absorb9 lanes address = case lanes of
    Lanes l0 l1 l2 l3 l4 l5 l6 l7 l8 l9 l10 l11 l12 l13 l14 l15 l16 l17 l18 l19 l20 l21 l22 l23 l24 ->
      keccak-permute (Lanes (bit-xor-u64 l0 (lane-word address 0)) (bit-xor-u64 l1 (lane-word address 8)) (bit-xor-u64 l2 (lane-word address 16)) (bit-xor-u64 l3 (lane-word address 24)) (bit-xor-u64 l4 (lane-word address 32)) (bit-xor-u64 l5 (lane-word address 40)) (bit-xor-u64 l6 (lane-word address 48)) (bit-xor-u64 l7 (lane-word address 56)) (bit-xor-u64 l8 (lane-word address 64)) l9 l10 l11 l12 l13 l14 l15 l16 l17 l18 l19 l20 l21 l22 l23 l24)

