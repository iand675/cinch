  -- | Column parity: the exclusive-or of the five lanes in one column.
  prim keccak-parity :: U64 -> U64 -> U64 -> U64 -> U64 -> U64 where
    llvm {
      %x0 = xor i64 %0, %1
      %x1 = xor i64 %x0, %2
      %x2 = xor i64 %x1, %3
      %value = xor i64 %x2, %4
      ret i64 %value
    }

  -- | Theta word for a column from the preceding column's parity and the following column's parity rotated by one.
  prim keccak-theta :: U64 -> U64 -> U64 where
    llvm {
      %r = call i64 @llvm.fshl.i64(i64 %1, i64 %1, i64 1)
      %value = xor i64 %0, %r
      ret i64 %value
    }

  -- | One output lane: theta, rho and pi applied to the three source lanes, combined by chi as b0 xor (not b1 and b2).
  prim keccak-chi :: U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 where
    llvm {
      %t0 = xor i64 %0, %1
      %b0 = call i64 @llvm.fshl.i64(i64 %t0, i64 %t0, i64 %2)
      %t1 = xor i64 %3, %4
      %b1 = call i64 @llvm.fshl.i64(i64 %t1, i64 %t1, i64 %5)
      %t2 = xor i64 %6, %7
      %b2 = call i64 @llvm.fshl.i64(i64 %t2, i64 %t2, i64 %8)
      %n1 = xor i64 %b1, -1
      %m = and i64 %n1, %b2
      %chi = xor i64 %b0, %m
      ret i64 %chi
    }

  -- | Output lane (0, 0), which additionally absorbs the round constant.
  prim keccak-chi-iota :: U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 where
    llvm {
      %t0 = xor i64 %0, %1
      %b0 = call i64 @llvm.fshl.i64(i64 %t0, i64 %t0, i64 %2)
      %t1 = xor i64 %3, %4
      %b1 = call i64 @llvm.fshl.i64(i64 %t1, i64 %t1, i64 %5)
      %t2 = xor i64 %6, %7
      %b2 = call i64 @llvm.fshl.i64(i64 %t2, i64 %t2, i64 %8)
      %n1 = xor i64 %b1, -1
      %m = and i64 %n1, %b2
      %chi = xor i64 %b0, %m
      %value = xor i64 %chi, %9
      ret i64 %value
    }
