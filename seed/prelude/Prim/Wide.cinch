  -- | Lane-wise signed less-than mask on 8 I16 lanes.
  prim simd-i16x8-cmplt :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <8 x i16>
      %vb = bitcast i128 %1 to <8 x i16>
      %vc = icmp slt <8 x i16> %va, %vb
      %vm = sext <8 x i1> %vc to <8 x i16>
      %r = bitcast <8 x i16> %vm to i128
