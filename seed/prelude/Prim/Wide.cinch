    } justify verify

  -- | Lane-wise signed minimum on 8 I16 lanes.
  prim simd-i16x8-smin :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <8 x i16>
      %vb = bitcast i128 %1 to <8 x i16>
      %vr = call <8 x i16> @llvm.smin.v8i16(<8 x i16> %va, <8 x i16> %vb)
      %r = bitcast <8 x i16> %vr to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise signed maximum on 8 I16 lanes.
  prim simd-i16x8-smax :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <8 x i16>
      %vb = bitcast i128 %1 to <8 x i16>
      %vr = call <8 x i16> @llvm.smax.v8i16(<8 x i16> %va, <8 x i16> %vb)
      %r = bitcast <8 x i16> %vr to i128
      ret i128 %r
    } justify verify

  -- | Broadcast one U32 into all 4 32-bit lanes of a U128.
  prim simd-u32x4-splat :: U32 -> U128 where
    llvm {
      %v0 = insertelement <4 x i32> poison, i32 %0, i64 0
      %v = shufflevector <4 x i32> %v0, <4 x i32> poison, <4 x i32> zeroinitializer
      %r = bitcast <4 x i32> %v to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise wrapping addition on 4 U32 lanes.
  prim simd-u32x4-add :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <4 x i32>
      %vb = bitcast i128 %1 to <4 x i32>
      %vr = add <4 x i32> %va, %vb
      %r = bitcast <4 x i32> %vr to i128
