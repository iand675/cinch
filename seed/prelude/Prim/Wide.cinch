-- | Portable 128-bit SIMD lane primitives and hardware AES/CLMUL leaf instructions over U128.
-- Every lane operation treats a U128 as a packed vector with lane 0 in the
-- least-significant bits. Target-guarded hardware bodies (AES-NI, ARMv8 AES,
-- PCLMULQDQ, PMULL) carry explicit `when` guards and portable fallbacks, and
-- are re-exported through Data.Wide.
module Prim.Wide where

  export ArmAes
  export bit-and-u128
  export simd-bitselect
  export simd-u8x16-splat, simd-u8x16-add, simd-u8x16-sub, simd-u8x16-cmpeq, simd-u8x16-cmplt, simd-u8x16-cmpgt, simd-u8x16-movemask
  export simd-u16x8-splat, simd-u16x8-add, simd-u16x8-sub, simd-u16x8-mul, simd-u16x8-shl, simd-u16x8-shr, simd-i16x8-ashr, simd-u16x8-cmpeq, simd-u16x8-cmplt, simd-i16x8-cmplt, simd-i16x8-smin, simd-i16x8-smax
  export simd-u32x4-splat, simd-u32x4-add, simd-u32x4-sub, simd-u32x4-mul, simd-u32x4-shl, simd-u32x4-shr, simd-i32x4-ashr, simd-u32x4-rotl, simd-u32x4-rotr, simd-i32x4-smin, simd-i32x4-smax, simd-u32x4-cmpeq, simd-u32x4-cmplt, simd-u32x4-pack
  export simd-u64x2-splat, simd-u64x2-add, simd-u64x2-sub, simd-u64x2-shl, simd-u64x2-shr, simd-u64x2-rotl, simd-u64x2-rotr, simd-u64x2-pack
  export aes-enc-round, aes-enc-last, aes-dec-round, aes-dec-last, clmul-u64, cpu-has-aes, cpu-has-clmul

  -- | Target-profile evidence that the ARMv8 AES and PMULL instructions may execute.
  -- Only profiles that guarantee the cryptography extension should name this capability.
  signature ArmAes where
    -- | Marker carried by target evidence; callers need no dictionary.
    arm-aes-evidence :: Unit -> Unit

  -- | Bitwise AND over two U128 values.
  prim bit-and-u128 :: U128 -> U128 -> U128 where
    llvm {
      %r = and i128 %0, %1
      ret i128 %r
    } justify verify

  rewrite bit-and-u128-zero forall (x :: U128). where
    match (bit-and-u128 x 0)
    replace 0
    justify verify

  -- | Bitwise select across 128 bits: (mask & when-one) | (~mask & when-zero).
  prim simd-bitselect :: U128 -> U128 -> U128 -> U128 where
    llvm {
      %notm = xor i128 %0, -1
      %a = and i128 %0, %1
      %c = and i128 %notm, %2
      %r = or i128 %a, %c
      ret i128 %r
    } justify verify

  -- | Broadcast one U8 into all 16 byte lanes of a U128.
  prim simd-u8x16-splat :: U8 -> U128 where
    llvm {
      %v0 = insertelement <16 x i8> poison, i8 %0, i64 0
      %v = shufflevector <16 x i8> %v0, <16 x i8> poison, <16 x i32> zeroinitializer
      %r = bitcast <16 x i8> %v to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise wrapping addition on 16 U8 lanes.
  prim simd-u8x16-add :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <16 x i8>
      %vb = bitcast i128 %1 to <16 x i8>
      %vr = add <16 x i8> %va, %vb
      %r = bitcast <16 x i8> %vr to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise wrapping subtraction on 16 U8 lanes.
  prim simd-u8x16-sub :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <16 x i8>
      %vb = bitcast i128 %1 to <16 x i8>
      %vr = sub <16 x i8> %va, %vb
      %r = bitcast <16 x i8> %vr to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise equality mask (0xFF per matching lane, 0x00 otherwise) on 16 U8 lanes.
  prim simd-u8x16-cmpeq :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <16 x i8>
      %vb = bitcast i128 %1 to <16 x i8>
      %vc = icmp eq <16 x i8> %va, %vb
      %vm = sext <16 x i1> %vc to <16 x i8>
      %r = bitcast <16 x i8> %vm to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise unsigned less-than mask on 16 U8 lanes.
  prim simd-u8x16-cmplt :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <16 x i8>
      %vb = bitcast i128 %1 to <16 x i8>
      %vc = icmp ult <16 x i8> %va, %vb
      %vm = sext <16 x i1> %vc to <16 x i8>
      %r = bitcast <16 x i8> %vm to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise unsigned greater-than mask on 16 U8 lanes.
  prim simd-u8x16-cmpgt :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <16 x i8>
      %vb = bitcast i128 %1 to <16 x i8>
      %vc = icmp ugt <16 x i8> %va, %vb
      %vm = sext <16 x i1> %vc to <16 x i8>
      %r = bitcast <16 x i8> %vm to i128
      ret i128 %r
    } justify verify

  -- | Extract the sign bit of each of the 16 byte lanes into the low 16 bits of a U32.
  prim simd-u8x16-movemask :: U128 -> U32 where
    llvm {
      %v = bitcast i128 %0 to <16 x i8>
      %m = icmp slt <16 x i8> %v, zeroinitializer
      %b16 = bitcast <16 x i1> %m to i16
      %r = zext i16 %b16 to i32
      ret i32 %r
    } justify verify

  -- | Broadcast one U16 into all 8 16-bit lanes of a U128.
  prim simd-u16x8-splat :: U16 -> U128 where
    llvm {
      %v0 = insertelement <8 x i16> poison, i16 %0, i64 0
      %v = shufflevector <8 x i16> %v0, <8 x i16> poison, <8 x i32> zeroinitializer
      %r = bitcast <8 x i16> %v to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise wrapping addition on 8 U16 lanes.
  prim simd-u16x8-add :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <8 x i16>
      %vb = bitcast i128 %1 to <8 x i16>
      %vr = add <8 x i16> %va, %vb
      %r = bitcast <8 x i16> %vr to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise wrapping subtraction on 8 U16 lanes.
  prim simd-u16x8-sub :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <8 x i16>
      %vb = bitcast i128 %1 to <8 x i16>
      %vr = sub <8 x i16> %va, %vb
      %r = bitcast <8 x i16> %vr to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise wrapping multiplication on 8 U16 lanes.
  prim simd-u16x8-mul :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <8 x i16>
      %vb = bitcast i128 %1 to <8 x i16>
      %vr = mul <8 x i16> %va, %vb
      %r = bitcast <8 x i16> %vr to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise left shift (masked modulo 16) on 8 U16 lanes.
  prim simd-u16x8-shl :: U128 -> U32 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <8 x i16>
      %m = and i32 %1, 15
      %sh = trunc i32 %m to i16
      %s0 = insertelement <8 x i16> poison, i16 %sh, i64 0
      %sv = shufflevector <8 x i16> %s0, <8 x i16> poison, <8 x i32> zeroinitializer
      %vr = shl <8 x i16> %va, %sv
      %r = bitcast <8 x i16> %vr to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise logical right shift (masked modulo 16) on 8 U16 lanes.
  prim simd-u16x8-shr :: U128 -> U32 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <8 x i16>
      %m = and i32 %1, 15
      %sh = trunc i32 %m to i16
      %s0 = insertelement <8 x i16> poison, i16 %sh, i64 0
      %sv = shufflevector <8 x i16> %s0, <8 x i16> poison, <8 x i32> zeroinitializer
      %vr = lshr <8 x i16> %va, %sv
      %r = bitcast <8 x i16> %vr to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise arithmetic right shift (masked modulo 16) on 8 signed I16 lanes.
  prim simd-i16x8-ashr :: U128 -> U32 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <8 x i16>
      %m = and i32 %1, 15
      %sh = trunc i32 %m to i16
      %s0 = insertelement <8 x i16> poison, i16 %sh, i64 0
      %sv = shufflevector <8 x i16> %s0, <8 x i16> poison, <8 x i32> zeroinitializer
      %vr = ashr <8 x i16> %va, %sv
      %r = bitcast <8 x i16> %vr to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise equality mask on 8 U16 lanes.
  prim simd-u16x8-cmpeq :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <8 x i16>
      %vb = bitcast i128 %1 to <8 x i16>
      %vc = icmp eq <8 x i16> %va, %vb
      %vm = sext <8 x i1> %vc to <8 x i16>
      %r = bitcast <8 x i16> %vm to i128
      ret i128 %r
    } justify verify

  -- | Lane-wise unsigned less-than mask on 8 U16 lanes.
  prim simd-u16x8-cmplt :: U128 -> U128 -> U128 where
    llvm {
      %va = bitcast i128 %0 to <8 x i16>
      %vb = bitcast i128 %1 to <8 x i16>
      %vc = icmp ult <8 x i16> %va, %vb
      %vm = sext <8 x i1> %vc to <8 x i16>
