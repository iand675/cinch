  -- ------------------------------------------------------------------
  -- Audited Linux inline-asm syscall primitives
  -- ------------------------------------------------------------------

  -- `io_uring_setup(entries, params)`: 425 on x86_64, 425 on aarch64.
  prim linux-io-uring-setup :: I64 -> I64 -> I64 where
    unsafe llvm {
      %r = call i64 asm sideeffect "mov x8, #425\0A svc #0", "={x0},{x0},{x1},~{x8},~{memory}"(i64 %0, i64 %1)
      ret i64 %r
    } when arch aarch64
    unsafe llvm {
      %r = call i64 asm sideeffect inteldialect "mov rax, 425\0A syscall", "={rax},{rdi},{rsi},~{rcx},~{r11},~{memory}"(i64 %0, i64 %1)
      ret i64 %r
    } when arch x86_64
    llvm {
      ret i64 -38
    }

  -- `io_uring_enter(fd, to_submit, min_complete, flags, sig, sz)`: 426 on x86_64, 426 on aarch64.
  prim linux-io-uring-enter :: I64 -> I64 -> I64 -> I64 -> I64 -> I64 -> I64 where
    unsafe llvm {
      %r = call i64 asm sideeffect "mov x8, #426\0A svc #0", "={x0},{x0},{x1},{x2},{x3},{x4},{x5},~{x8},~{memory}"(i64 %0, i64 %1, i64 %2, i64 %3, i64 %4, i64 %5)
      ret i64 %r
    } when arch aarch64
    unsafe llvm {
      %r = call i64 asm sideeffect inteldialect "mov rax, 426\0A syscall", "={rax},{rdi},{rsi},{rdx},{r10},{r8},{r9},~{rcx},~{r11},~{memory}"(i64 %0, i64 %1, i64 %2, i64 %3, i64 %4, i64 %5)
      ret i64 %r
    } when arch x86_64
    llvm {
      ret i64 -38
    }

  -- `io_uring_register(fd, opcode, arg, nr_args)`: 427 on x86_64, 427 on aarch64.
  prim linux-io-uring-register :: I64 -> I64 -> I64 -> I64 -> I64 where
    unsafe llvm {
      %r = call i64 asm sideeffect "mov x8, #427\0A svc #0", "={x0},{x0},{x1},{x2},{x3},~{x8},~{memory}"(i64 %0, i64 %1, i64 %2, i64 %3)
      ret i64 %r
    } when arch aarch64
    unsafe llvm {
      %r = call i64 asm sideeffect inteldialect "mov rax, 427\0A syscall", "={rax},{rdi},{rsi},{rdx},{r10},~{rcx},~{r11},~{memory}"(i64 %0, i64 %1, i64 %2, i64 %3)
      ret i64 %r
    } when arch x86_64
    llvm {
      ret i64 -38
    }

