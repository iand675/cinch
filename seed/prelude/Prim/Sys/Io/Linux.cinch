-- Prim.Sys.Io.Linux: high-throughput Linux OS I/O syscalls, in Cinch, on the
-- `syscall` / `svc #0` instructions.
--
-- Mirrors `Prim.Sys.Linux` for the high-throughput reactor, networking,
-- zero-copy, direct I/O, and memory-mapping surface (`io_uring`, `epoll`,
-- `eventfd2`, TCP/UDP sockets, `SO_REUSEPORT`, `UDP_SEGMENT`/`UDP_GRO`,
-- `O_DIRECT`, `splice`, `sendfile`, `mmap`, `clock_gettime`).
--
-- Every syscall primitive carries:
--   * an `aarch64` `unsafe llvm` body (`svc #0` with `~{x8},~{memory}`),
--   * an `x86_64` `unsafe llvm` body (`syscall` with `~{rcx},~{r11},~{memory}`),
--   * a portable `llvm` fallback returning `-38` (`-ENOSYS`).
--
-- All pinned syscall numbers and clobber lists are audited by `mem_contract`
-- v2 (`cinch verify-prims --audit-unsafe`) with zero violations.
--
-- Return convention (zero-allocation hot path):
--   * Non-negative `I64` (or mapped address for `sys-mmap`): success value.
--   * Negative `I64` in `[-4095, -1]`: negated Linux `errno` (`-EAGAIN`, etc.).
module Prim.Sys.Io.Linux where

  import Algebra.Arithmetic
  import Data.Bytes
  import Data.Machine
  import Data.Nat

  export IoSqringOffsets, IoCqringOffsets, IoUringParams, IoUringSqe, IoUringCqe
  export Iovec, SockAddrIn, Timespec
  export af-inet, af-inet6, sock-stream, sock-dgram, sock-nonblock, sock-cloexec
  export sol-socket, so-reuseaddr, so-reuseport, so-txtime, so-attach-reuseport-ebpf
  export ipproto-tcp, tcp-nodelay, sol-tls, sol-udp, udp-segment, udp-gro
  export at-fdcwd, o-rdonly, o-wronly, o-rdwr, o-creat, o-trunc, o-nonblock, o-cloexec
  export o-direct-amd64, o-direct-aarch64, o-direct
  export f-getfl, f-setfl
  export prot-none, prot-read, prot-write
  export map-shared, map-private, map-fixed, map-anon, map-populate
  export madv-willneed, madv-dontneed, madv-hugepage
  export ioring-setup-iopoll, ioring-setup-sqpoll, ioring-setup-sq-aff
  export ioring-setup-cqsize, ioring-setup-clamp, ioring-setup-attach-wq
  export ioring-setup-coop-taskrun, ioring-setup-single-issuer, ioring-setup-defer-taskrun
  export ioring-enter-getevents, ioring-enter-sq-wakeup, ioring-enter-sq-wait, ioring-enter-ext-arg
  export ioring-op-nop, ioring-op-readv, ioring-op-writev, ioring-op-fsync
  export ioring-op-read-fixed, ioring-op-write-fixed, ioring-op-poll-add, ioring-op-poll-remove
  export ioring-op-sendmsg, ioring-op-recvmsg, ioring-op-timeout, ioring-op-accept
  export ioring-op-async-cancel, ioring-op-connect, ioring-op-close
  export ioring-op-read, ioring-op-write, ioring-op-send, ioring-op-recv
  export ioring-op-splice, ioring-op-provide-buffers, ioring-op-send-zc
  export ioring-register-buffers, ioring-unregister-buffers
  export ioring-register-files, ioring-unregister-files
  export ioring-register-eventfd, ioring-register-pbuf-ring, ioring-unregister-pbuf-ring
  export ioring-off-sq-ring, ioring-off-cq-ring, ioring-off-sqes
  export epoll-cloexec, epoll-ctl-add, epoll-ctl-del, epoll-ctl-mod
  export epollin, epollout, epollerr, epollhup, epollet
  export efd-nonblock, efd-cloexec
  export clock-realtime, clock-monotonic
  export eintr, eagain, enosys, einprogress
  export io-is-err, io-errno, io-is-would-block, io-is-in-progress, io-is-interrupted
  export sys-io-uring-setup, sys-io-uring-enter, sys-io-uring-register
  export sys-socket, sys-bind, sys-listen, sys-accept4
  export sys-setsockopt, sys-getsockopt, sys-close, sys-fcntl
  export sys-sendto, sys-recvfrom, sys-sendmsg, sys-recvmsg
  export sys-sendmmsg, sys-recvmmsg
  export sys-read, sys-write, sys-pread, sys-pwrite
  export sys-mmap, sys-munmap, sys-madvise
  export sys-openat, sys-fallocate, sys-fdatasync, sys-fsync, sys-lseek
  export sys-splice, sys-sendfile
  export sys-eventfd2, sys-clock-gettime, sys-sched-setaffinity
  export sys-epoll-create1, sys-epoll-ctl, sys-epoll-pwait
  export sys-set-nonblocking, sys-sockaddr-in-loopback, sys-sockaddr-in-port, sys-held

  -- ------------------------------------------------------------------
  -- Linux kernel ABI structs (`#[repr(C)]`)
  -- ------------------------------------------------------------------

  -- | Linux `struct io_sqring_offsets` (40 bytes, align 8).
  #[repr(C)]
  record IoSqringOffsets where
    head :: U32
    tail :: U32
    ring-mask :: U32
    ring-entries :: U32
    flags :: U32
    dropped :: U32
    array :: U32
    resv1 :: U32
    user-addr :: U64

  -- | Linux `struct io_cqring_offsets` (40 bytes, align 8).
  #[repr(C)]
  record IoCqringOffsets where
    head :: U32
    tail :: U32
    ring-mask :: U32
    ring-entries :: U32
    overflow :: U32
    cqes :: U32
    flags :: U32
    resv1 :: U32
    user-addr :: U64

  -- | Linux `struct io_uring_params` (120 bytes, align 8).
  #[repr(C)]
  record IoUringParams where
    sq-entries :: U32
    cq-entries :: U32
    flags :: U32
    sq-thread-cpu :: U32
    sq-thread-idle :: U32
    features :: U32
    wq-fd :: U32
    resv0 :: U32
    resv1 :: U32
    resv2 :: U32
    sq-off :: IoSqringOffsets
    cq-off :: IoCqringOffsets

  -- | Linux `struct io_uring_sqe` (64 bytes, align 8).
  #[repr(C)]
  record IoUringSqe where
    opcode :: U8
    flags :: U8
    ioprio :: U16
    fd :: I32
    off :: U64
    addr :: U64
    len :: U32
    op-flags :: U32
    user-data :: U64
    buf-index :: U16
    personality :: U16
    splice-fd-in :: I32
    addr3 :: U64
    pad2 :: U64

  -- | Linux `struct io_uring_cqe` (16 bytes, align 8).
  #[repr(C)]
  record IoUringCqe where
    user-data :: U64
    res :: I32
    flags :: U32

  -- | POSIX / Linux `struct iovec` (16 bytes, align 8).
  #[repr(C)]
  record Iovec where
    iov-base :: U64
    iov-len :: U64

  -- | Linux `struct sockaddr_in` (16 bytes, align 4).
  #[repr(C)]
  record SockAddrIn where
    sin-family :: U16
    sin-port :: U16
    sin-addr :: U32
    sin-zero-lo :: U32
    sin-zero-hi :: U32

  -- | POSIX / Linux `struct timespec` (16 bytes, align 8).
  #[repr(C)]
  record Timespec where
    tv-sec :: I64
    tv-nsec :: I64

