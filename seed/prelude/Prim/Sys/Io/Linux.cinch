  -- 4-argument Linux syscall trampoline used for `pread64` (x86_64=17, aarch64=67)
  -- and `pwrite64` (x86_64=18, aarch64=68).
  prim linux-syscall4 :: I64 -> I64 -> I64 -> I64 -> I64 -> I64 where
    unsafe llvm {
      %r = call i64 asm sideeffect "mov x8, $1\0A svc #0", "={x0},{x7},{x0},{x1},{x2},{x3},~{x8},~{memory}"(i64 %0, i64 %1, i64 %2, i64 %3, i64 %4)
      ret i64 %r
    } when arch aarch64
    unsafe llvm {
      %r = call i64 asm sideeffect inteldialect "syscall", "={rax},{rax},{rdi},{rsi},{rdx},{r10},~{rcx},~{r11},~{memory}"(i64 %0, i64 %1, i64 %2, i64 %3, i64 %4)
      ret i64 %r
    } when arch x86_64
    llvm {
      ret i64 -38
    }

  nr-pread64 :: I64
  when arch aarch64 nr-pread64 = 67
  when arch x86_64 nr-pread64 = 17
  when not (arch aarch64) when not (arch x86_64) nr-pread64 = -1

  nr-pwrite64 :: I64
  when arch aarch64 nr-pwrite64 = 68
  when arch x86_64 nr-pwrite64 = 18
  when not (arch aarch64) when not (arch x86_64) nr-pwrite64 = -1

