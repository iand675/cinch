  -- ------------------------------------------------------------------
  -- Effectful wrappers & helpers
  -- ------------------------------------------------------------------

  -- | True when a syscall return value encodes a Linux `-errno` (`-4095 <= r < 0`).
  io-is-err :: I64 -> Bool
  io-is-err r = lt-i64 r 0 && le-i64 -4095 r

  -- | Positive errno extracted from a negative syscall return (or `0` on success).
  io-errno :: I64 -> I64
  io-errno r = if io-is-err r then wrapping-neg-i64 r else 0

  -- | True when the syscall returned `-EAGAIN` / `-EWOULDBLOCK`.
  io-is-would-block :: I64 -> Bool
  io-is-would-block r = eq-i64 (io-errno r) eagain

  -- | True when a non-blocking `connect` returned `-EINPROGRESS`.
  io-is-in-progress :: I64 -> Bool
  io-is-in-progress r = eq-i64 (io-errno r) einprogress

  -- | True when the syscall returned `-EINTR`.
  io-is-interrupted :: I64 -> Bool
  io-is-interrupted r = eq-i64 (io-errno r) eintr

  sys-io-uring-setup :: forall r. using (io :: Io r) => I64 -> I64 ->{IO r} I64
  sys-io-uring-setup entries params = linux-io-uring-setup entries params

  sys-io-uring-enter :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-io-uring-enter fd to-submit min-complete flags sig sz =
    linux-io-uring-enter fd to-submit min-complete flags sig sz

  sys-io-uring-register :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-io-uring-register fd opcode arg nr-args =
    linux-io-uring-register fd opcode arg nr-args

  sys-socket :: forall r. using (io :: Io r) => I64 -> I64 -> I64 ->{IO r} I64
  sys-socket domain ty proto = linux-socket domain ty proto

  sys-bind :: forall r. using (io :: Io r) => I64 -> I64 -> I64 ->{IO r} I64
  sys-bind fd addr addrlen = linux-bind fd addr addrlen

  sys-listen :: forall r. using (io :: Io r) => I64 -> I64 ->{IO r} I64
  sys-listen fd backlog = linux-listen fd backlog

  sys-accept4 :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-accept4 fd addr addrlen flags = linux-accept4 fd addr addrlen flags

  sys-setsockopt :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-setsockopt fd level optname optval optlen =
    linux-setsockopt fd level optname optval optlen

  sys-getsockopt :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-getsockopt fd level optname optval optlen =
    linux-getsockopt fd level optname optval optlen

  sys-close :: forall r. using (io :: Io r) => I64 ->{IO r} I64
  sys-close fd = linux-close fd

  sys-fcntl :: forall r. using (io :: Io r) => I64 -> I64 -> I64 ->{IO r} I64
  sys-fcntl fd cmd arg = linux-fcntl fd cmd arg

  sys-sendto :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-sendto fd buf len flags dest-addr addrlen =
    linux-sendto fd buf len flags dest-addr addrlen

  sys-recvfrom :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-recvfrom fd buf len flags src-addr addrlen =
    linux-recvfrom fd buf len flags src-addr addrlen

  sys-sendmsg :: forall r. using (io :: Io r) => I64 -> I64 -> I64 ->{IO r} I64
  sys-sendmsg fd msg flags = linux-sendmsg fd msg flags

  sys-recvmsg :: forall r. using (io :: Io r) => I64 -> I64 -> I64 ->{IO r} I64
  sys-recvmsg fd msg flags = linux-recvmsg fd msg flags

  sys-sendmmsg :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-sendmmsg fd msgvec vlen flags = linux-sendmmsg fd msgvec vlen flags

  sys-recvmmsg :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-recvmmsg fd msgvec vlen flags timeout = linux-recvmmsg fd msgvec vlen flags timeout

  sys-read :: forall r. using (io :: Io r) => I64 -> I64 -> I64 ->{IO r} I64
  sys-read fd buf count = linux-read fd buf count

  sys-write :: forall r. using (io :: Io r) => I64 -> I64 -> I64 ->{IO r} I64
  sys-write fd buf count = linux-write fd buf count

  sys-pread :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-pread fd buf count offset = linux-syscall4 nr-pread64 fd buf count offset

  sys-pwrite :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-pwrite fd buf count offset = linux-syscall4 nr-pwrite64 fd buf count offset

  sys-mmap :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-mmap addr len prot flags fd offset = linux-mmap addr len prot flags fd offset

  sys-munmap :: forall r. using (io :: Io r) => I64 -> I64 ->{IO r} I64
  sys-munmap addr len = linux-munmap addr len

  sys-madvise :: forall r. using (io :: Io r) => I64 -> I64 -> I64 ->{IO r} I64
  sys-madvise addr len advice = linux-madvise addr len advice

  sys-openat :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-openat dirfd path flags mode = linux-openat dirfd path flags mode

  sys-fallocate :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-fallocate fd mode offset len = linux-fallocate fd mode offset len

  sys-fdatasync :: forall r. using (io :: Io r) => I64 ->{IO r} I64
  sys-fdatasync fd = linux-fdatasync fd

  sys-fsync :: forall r. using (io :: Io r) => I64 ->{IO r} I64
  sys-fsync fd = linux-fsync fd

  sys-lseek :: forall r. using (io :: Io r) => I64 -> I64 -> I64 ->{IO r} I64
  sys-lseek fd off whence = linux-lseek fd off whence

  sys-splice :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-splice fd-in off-in fd-out off-out len flags =
    linux-splice fd-in off-in fd-out off-out len flags

  sys-sendfile :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-sendfile out-fd in-fd off-ptr count = linux-sendfile out-fd in-fd off-ptr count

  sys-eventfd2 :: forall r. using (io :: Io r) => I64 -> I64 ->{IO r} I64
  sys-eventfd2 initval flags = linux-eventfd2 initval flags

  sys-clock-gettime :: forall r. using (io :: Io r) => I64 -> I64 ->{IO r} I64
  sys-clock-gettime clock-id tp = linux-clock-gettime clock-id tp

  sys-sched-setaffinity :: forall r. using (io :: Io r) => I64 -> I64 -> I64 ->{IO r} I64
  sys-sched-setaffinity pid cpusetsize mask = linux-sched-setaffinity pid cpusetsize mask

  sys-epoll-create1 :: forall r. using (io :: Io r) => I64 ->{IO r} I64
  sys-epoll-create1 flags = linux-epoll-create1 flags

  sys-epoll-ctl :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-epoll-ctl epfd op fd event = linux-epoll-ctl epfd op fd event

  sys-epoll-pwait :: forall r. using (io :: Io r) => I64 -> I64 -> I64 -> I64 -> I64 -> I64 ->{IO r} I64
  sys-epoll-pwait epfd events maxevents timeout sigmask sigsetsize =
    linux-epoll-pwait epfd events maxevents timeout sigmask sigsetsize

  -- | Set `O_NONBLOCK` on an open descriptor using `F_GETFL` + `F_SETFL`.
  sys-set-nonblocking :: forall r. using (io :: Io r) => I64 ->{IO r} I64
  sys-set-nonblocking fd =
    let flags = sys-fcntl fd f-getfl 0 in
    if io-is-err flags then flags
    else sys-fcntl fd f-setfl (bit-or-i64 flags o-nonblock)

  -- | Construct a 16-byte Linux `struct sockaddr_in` for `127.0.0.1:port`.
  sys-sockaddr-in-loopback :: U16 -> Bytes
  sys-sockaddr-in-loopback port =
    let buf = bytes-new 16 in
    let p-hi = wrapping-u16-to-u8 (wrapping-shr-u16 port 8) in
    let p-lo = wrapping-u16-to-u8 port in
    let w0 = bytes-set-u8 buf 0 2 in
    let w1 = bytes-set-u8 buf 1 0 in
    let w2 = bytes-set-u8 buf 2 p-hi in
    let w3 = bytes-set-u8 buf 3 p-lo in
    let w4 = bytes-set-u8 buf 4 127 in
    let w5 = bytes-set-u8 buf 5 0 in
    let w6 = bytes-set-u8 buf 6 0 in
    let w7 = bytes-set-u8 buf 7 1 in
    buf

  -- | Decode the host-order TCP/UDP port from a 16-byte `sockaddr_in` buffer.
  sys-sockaddr-in-port :: Bytes -> U16
  sys-sockaddr-in-port buf =
    if 4 <= bytes-len buf then
      let hi = u8-to-u16 (bytes-get-u8 buf 2) in
      let lo = u8-to-u16 (bytes-get-u8 buf 3) in
      bit-or-u16 (wrapping-shl-u16 hi 8) lo
    else 0

  -- | Keep `b` alive across a syscall that receives `bytes-data b`.
  sys-held :: forall a. Bytes -> a -> a
  sys-held b x = case bytes-len b of
    _ -> x
