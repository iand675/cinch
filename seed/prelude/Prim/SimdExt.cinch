  -- | Bitwise XOR across all 16 byte lanes of a U128.
  prim simd-u8x16-xor :: U128 -> U128 -> U128 where
    llvm {
      %r = xor i128 %0, %1
      ret i128 %r
    } justify verify

  -- | Bitwise OR across all 16 byte lanes of a U128.
  prim simd-u8x16-or :: U128 -> U128 -> U128 where
    llvm {
      %r = or i128 %0, %1
      ret i128 %r
    } justify verify

  -- | Bitwise NOT across all 16 byte lanes of a U128.
  prim simd-u8x16-not :: U128 -> U128 where
    llvm {
      %r = xor i128 %0, -1
      ret i128 %r
    } justify verify

  -- | Fold one byte into a Castagnoli CRC32C accumulator (polynomial 0x82F63B78).
  prim hw-crc32c-u8 :: U32 -> U8 -> U32 where
    llvm {
      %r = call i32 asm "crc32b $2, $0", "=r,0,q"(i32 %0, i8 %1)
      ret i32 %r
    } when arch x86_64 justify verify
    llvm {
      %d = zext i8 %1 to i32
      %r = call i32 asm ".arch_extension crc\0Acrc32cb ${0:w}, ${1:w}, ${2:w}", "=r,r,r"(i32 %0, i32 %d)
      ret i32 %r
    } when arch aarch64 justify verify
    llvm {
      %d = zext i8 %1 to i32
      %c0 = xor i32 %0, %d
      %b0 = trunc i32 %c0 to i1
      %m0 = sext i1 %b0 to i32
