-- | Extended 128-bit SIMD byte-shuffle, bitwise lane, and hardware Castagnoli CRC32C primitives.
-- Every primitive carries `justify verify` and discharges to LRAT-certified `TrustTier::KernelCert`
-- across x86_64, aarch64, and the portable LLVM baseline with zero `unsafe` or `Assumed` bodies.
module Prim.SimdExt where

  export simd-u8x16-shuffle, simd-u8x16-xor, simd-u8x16-or, simd-u8x16-not
  export hw-crc32c-u8, hw-crc32c-u32, hw-crc32c-u64

  -- | 16-byte SIMD lane lookup: for each lane i in 0..15, if idx[i] >= 16 then 0 else tbl[idx[i]].
  -- Bit-identical across x86_64 (masked pshufb), aarch64 (NEON tbl), and portable LLVM across all 256 byte values.
  prim simd-u8x16-shuffle :: U128 -> U128 -> U128 where
    llvm {
      %vt = bitcast i128 %0 to <16 x i8>
      %vi = bitcast i128 %1 to <16 x i8>
      %c15_0 = insertelement <16 x i8> poison, i8 15, i64 0
      %c15 = shufflevector <16 x i8> %c15_0, <16 x i8> poison, <16 x i32> zeroinitializer
      %oob = icmp ugt <16 x i8> %vi, %c15
      %oobm = sext <16 x i1> %oob to <16 x i8>
      %vidx = or <16 x i8> %vi, %oobm
      %vr = call <16 x i8> asm "pshufb $2, $0", "=x,0,x"(<16 x i8> %vt, <16 x i8> %vidx)
      %r = bitcast <16 x i8> %vr to i128
      ret i128 %r
    } when arch x86_64 justify verify
    llvm {
      %vt = bitcast i128 %0 to <16 x i8>
      %vi = bitcast i128 %1 to <16 x i8>
      %vr = call <16 x i8> asm "tbl $0.16b, {$1.16b}, $2.16b", "=w,w,w"(<16 x i8> %vt, <16 x i8> %vi)
      %r = bitcast <16 x i8> %vr to i128
      ret i128 %r
    } when arch aarch64 justify verify
    llvm {
      %vt = bitcast i128 %0 to <16 x i8>
      %vi = bitcast i128 %1 to <16 x i8>
      %t0 = extractelement <16 x i8> %vt, i64 0
      %t1 = extractelement <16 x i8> %vt, i64 1
      %t2 = extractelement <16 x i8> %vt, i64 2
      %t3 = extractelement <16 x i8> %vt, i64 3
      %t4 = extractelement <16 x i8> %vt, i64 4
      %t5 = extractelement <16 x i8> %vt, i64 5
      %t6 = extractelement <16 x i8> %vt, i64 6
      %t7 = extractelement <16 x i8> %vt, i64 7
      %t8 = extractelement <16 x i8> %vt, i64 8
      %t9 = extractelement <16 x i8> %vt, i64 9
      %t10 = extractelement <16 x i8> %vt, i64 10
      %t11 = extractelement <16 x i8> %vt, i64 11
      %t12 = extractelement <16 x i8> %vt, i64 12
      %t13 = extractelement <16 x i8> %vt, i64 13
      %t14 = extractelement <16 x i8> %vt, i64 14
      %t15 = extractelement <16 x i8> %vt, i64 15
      %k0 = extractelement <16 x i8> %vi, i64 0
      %b0_0 = trunc i8 %k0 to i1
      %sh0_1 = lshr i8 %k0, 1
      %b0_1 = trunc i8 %sh0_1 to i1
      %sh0_2 = lshr i8 %k0, 2
      %b0_2 = trunc i8 %sh0_2 to i1
      %sh0_3 = lshr i8 %k0, 3
      %b0_3 = trunc i8 %sh0_3 to i1
      %l0_0_0 = select i1 %b0_0, i8 %t1, i8 %t0
      %l0_0_1 = select i1 %b0_0, i8 %t3, i8 %t2
      %l0_0_2 = select i1 %b0_0, i8 %t5, i8 %t4
      %l0_0_3 = select i1 %b0_0, i8 %t7, i8 %t6
      %l0_0_4 = select i1 %b0_0, i8 %t9, i8 %t8
      %l0_0_5 = select i1 %b0_0, i8 %t11, i8 %t10
      %l0_0_6 = select i1 %b0_0, i8 %t13, i8 %t12
      %l0_0_7 = select i1 %b0_0, i8 %t15, i8 %t14
