-- Data.Wide: the wide scalar types `I128` and `U128` and their
-- operations (design/wide-scalars.md).
--
-- The two types are the primitive types specification's optional
-- 128-bit extension (section 2). Their names are kernel types like every
-- machine scalar's; their operations live here, in a module a program
-- imports explicitly (`import Data.Wide`), so the core prelude and every
-- existing program are unchanged. Names follow decision D6, as in
-- `Data.Machine`: `wrapping-add-i128`, `eq-u128`.
--
-- A wide value is unboxed: an LLVM `i128` in every local, parameter and
-- result, never a word. Overflow is never implicit, exactly as for the
-- narrower types: `wrapping` is two's complement wrap modulo 2^128 and
-- `saturating` clamps to the bounds.
--
-- The bounds carry no refinement: the refinement solver's integer sorts
-- are `i128` ranges, which cannot state `U128`'s maximum (2^128 - 1), so
-- `max-bound-u128 :: U128` is declared plain until the solver carries a
-- wider sort (design/wide-scalars.md section 4).
--
-- Phase 1 of the design lands in increments. This module carries what
-- the emitter lowers so far: bounds, the checked, wrapping and saturating
-- families of addition, subtraction, multiplication and negation, checked
-- division and remainder, the bitwise operations, checked and wrapping
-- shifts, rotates, bit inspection, comparison, conversions with every
-- other numeric type and with `Int` and `Nat`, and the `Eq`, `Ord`,
-- `Bits` and `Show` instances.
module Data.Wide where

  import Data.Option
  import Relation.Eq
  import Relation.Ord
  import Algebra.Bits
  import Data.Int
  import Data.Nat
  import Data.Machine
  import Text.Show
  import Prim.Wide

  export ArmAes
  export bit-and-i128, bit-and-u128, bit-not-i128, bit-not-u128, bit-or-i128, bit-or-u128, bit-xor-i128, bit-xor-u128, checked-add-i128, checked-add-u128, checked-div-i128, checked-div-u128, checked-f32-to-i128, checked-f32-to-u128, checked-f64-to-i128, checked-f64-to-u128, checked-i128-to-i128, checked-i128-to-i16, checked-i128-to-i32, checked-i128-to-i64, checked-i128-to-i8, checked-i128-to-isize, checked-i128-to-u128, checked-i128-to-u16, checked-i128-to-u32, checked-i128-to-u64, checked-i128-to-u8, checked-i128-to-usize, checked-i16-to-i128, checked-i16-to-u128, checked-i32-to-i128, checked-i32-to-u128, checked-i64-to-i128, checked-i64-to-u128, checked-i8-to-i128, checked-i8-to-u128, checked-int-to-i128, checked-int-to-u128, checked-isize-to-i128, checked-isize-to-u128, checked-mul-i128, checked-mul-u128, checked-nat-to-i128, checked-nat-to-u128, checked-neg-i128, checked-neg-u128, checked-rem-i128, checked-rem-u128, checked-shl-i128, checked-shl-u128, checked-shr-i128, checked-shr-u128, checked-sub-i128, checked-sub-u128, checked-u128-to-i128, checked-u128-to-i16, checked-u128-to-i32, checked-u128-to-i64, checked-u128-to-i8, checked-u128-to-isize, checked-u128-to-u128, checked-u128-to-u16, checked-u128-to-u32, checked-u128-to-u64, checked-u128-to-u8, checked-u128-to-usize, checked-u16-to-i128, checked-u16-to-u128, checked-u32-to-i128, checked-u32-to-u128, checked-u64-to-i128, checked-u64-to-u128, checked-u8-to-i128, checked-u8-to-u128, checked-usize-to-i128, checked-usize-to-u128, count-ones-i128, count-ones-u128, eq-i128, eq-u128, ge-i128, ge-u128, gt-i128, gt-u128, i128-to-f32, i128-to-f64, i128-to-i128, i16-to-i128, i32-to-i128, i64-to-i128, i8-to-i128, int-from-i128, int-from-u128, int-to-i128, isize-to-i128, le-i128, le-u128, leading-zeros-i128, leading-zeros-u128, lt-i128, lt-u128, max-bound-i128, max-bound-u128, min-bound-i128, min-bound-u128, nat-from-u128, nat-to-u128, ne-i128, ne-u128, reverse-bits-i128, reverse-bits-u128, rotate-left-i128, rotate-lef