  saturating-i128-to-u32 :: I128 -> U32
  saturating-i128-to-u32 x = if lt-i128 x 0 then 0 else if gt-i128 x 4294967295 then max-bound-u32 else wrapping-i128-to-u32 x
  prim wrapping-u128-to-u32 :: U128 -> U32 where
    llvm {
      %r = trunc i128 %0 to i32
      ret i32 %r
    } justify verify
  checked-u128-to-u32 :: U128 -> Option U32
  checked-u128-to-u32 x = if gt-u128 x 4294967295 then None else Some (wrapping-u128-to-u32 x)
  saturating-u128-to-u32 :: U128 -> U32
  saturating-u128-to-u32 x = if gt-u128 x 4294967295 then max-bound-u32 else wrapping-u128-to-u32 x
  prim wrapping-i128-to-u64 :: I128 -> U64 where
    llvm {
      %r = trunc i128 %0 to i64
      ret i64 %r
    } justify verify
  checked-i128-to-u64 :: I128 -> Option U64
  checked-i128-to-u64 x = if lt-i128 x 0 || gt-i128 x 18446744073709551615 then None else Some (wrapping-i128-to-u64 x)
  saturating-i128-to-u64 :: I128 -> U64
  saturating-i128-to-u64 x = if lt-i128 x 0 then 0 else if gt-i128 x 18446744073709551615 then max-bound-u64 else wrapping-i128-to-u64 x
  prim wrapping-u128-to-u64 :: U128 -> U64 where
    llvm {
      %r = trunc i128 %0 to i64
      ret i64 %r
    } justify verify
  checked-u128-to-u64 :: U128 -> Option U64
  checked-u128-to-u64 x = if gt-u128 x 18446744073709551615 then None else Some (wrapping-u128-to-u64 x)
  saturating-u128-to-u64 :: U128 -> U64
  saturating-u128-to-u64 x = if gt-u128 x 18446744073709551615 then max-bound-u64 else wrapping-u128-to-u64 x
  wrapping-i128-to-usize :: I128 -> Usize
  wrapping-i128-to-usize x = wrapping-u64-to-usize (wrapping-i128-to-u64 x)
  checked-i128-to-usize :: I128 -> Option Usize
  checked-i128-to-usize x = case checked-i128-to-u64 x of Some v -> checked-u64-to-usize v; None -> None
  saturating-i128-to-usize :: I128 -> Usize
  saturating-i128-to-usize x = saturating-u64-to-usize (saturating-i128-to-u64 x)
  wrapping-i128-to-isize :: I128 -> Isize
  wrapping-i128-to-isize x = wrapping-i64-to-isize (wrapping-i128-to-i64 x)
  checked-i128-to-isize :: I128 -> Option Isize
  checked-i128-to-isize x = case checked-i128-to-i64 x of Some v -> checked-i64-to-isize v; None -> None
  saturating-i128-to-isize :: I128 -> Isize
  saturating-i128-to-isize x = saturating-i64-to-isize (saturating-i128-to-i64 x)
  wrapping-u128-to-usize :: U128 -> Usize
  wrapping-u128-to-usize x = wrapping-u64-to-usize (wrapping-u128-to-u64 x)
  checked-u128-to-usize :: U128 -> Option Usize
  checked-u128-to-usize x = case checked-u128-to-u64 x of Some v -> checked-u64-to-usize v; None -> None
  saturating-u128-to-usize :: U128 -> Usize
  saturating-u128-to-usize x = saturating-u64-to-usize (saturating-u128-to-u64 x)
  wrapping-u128-to-isize :: U128 -> Isize
  wrapping-u128-to-isize x = wrapping-i64-to-isize (wrapping-u128-to-i64 x)
  checked-u128-to-isize :: U128 -> Option Isize
  checked-u128-to-isize x = case checked-u128-to-i64 x of Some v -> checked-i64-to-isize v; None -> None
  saturating-u128-to-isize :: U128 -> Isize
  saturating-u128-to-isize x = saturating-i64-to-isize (saturating-u128-to-i64 x)
  prim i128-to-f32 :: I128 -> F32 where
    llvm {
      %r = sitofp i128 %0 to float
      ret float %r
    }
  prim i128-to-f64 :: I128 -> F64 where
    llvm {
      %r = sitofp i128 %0 to double
      ret double %r
    }
  prim u128-to-f32 :: U128 -> F32 where
    llvm {
      %r = uitofp i128 %0 to float
      ret float %r
    }
  prim u128-to-f64 :: U128 -> F64 where
    llvm {
      %r = uitofp i128 %0 to double
      ret double %r
    }
  prim f64-fits-i128 :: F64 -> Bool where
    llvm {
      %ge = fcmp oge double %0, 0xC7E0000000000000
      %lt = fcmp olt double %0, 0x47E0000000000000
      %ok = and i1 %ge, %lt
      %r = zext i1 %ok to i8
      ret i8 %r
    } justify verify
  prim saturating-f64-to-i128 :: F64 -> I128 where
    llvm {
      %ge = fcmp oge double %0, 0xC7E0000000000000
      %lt = fcmp olt double %0, 0x47E0000000000000
      %ok = and i1 %ge, %lt
      %safe = select i1 %ok, double %0, double 0.0
      %v = fptosi double %safe to i128
      %above = fcmp oge double %0, 0x47E0000000000000
      %below = fcmp olt double %0, 0xC7E0000000000000
      %a = select i1 %above, i128 170141183460469231731687303715884105727, i128 %v
      %r = select i1 %below, i128 -170141183460469231731687303715884105728, i128 %a
      ret i128 %r
    }
  prim f64-fits-u128 :: F64 -> Bool where
    llvm {
      %gt = fcmp ogt double %0, 0xBFF0000000000000
      %lt = fcmp olt double %0, 0x47F0000000000000
      %ok = and i1 %gt, %lt
      %r = zext i1 %ok to i8
      ret i8 %r
    } justify verify
  prim saturating-f64-to-u128 :: F64 -> U128 where
    llvm {
      %gt = fcmp ogt double %0, 0xBFF0000000000000
      %lt = fcmp olt double %0, 0x47F0000000000000
      %ok = and i1 %gt, %lt
      %safe = select i1 %ok, double %0, double 0.0
      %v = fptoui double %safe to i128
      %above = fcmp oge double %0, 0x47F0000000000000
      %below = fcmp ole double %0, 0xBFF0000000000000
      %a = select i1 %above, i128 -1, i128 %v
      %r = select i1 %below, i128 0, i128 %a
      ret i128 %r
    }
  checked-f64-to-i128 :: F64 -> Option I128
  checked-f64-to-i128 x = if f64-fits-i128 x then Some (saturating-f64-to-i128 x) else None
  checked-f64-to-u128 :: F64 -> Option U128
  checked-f64-to-u128 x = if f64-fits-u128 x then Some (saturating-f64-to-u128 x) else None
  checked-f32-to-i128 :: F32 -> Option I128
  checked-f32-to-i128 x = checked-f64-to-i128 (f32-to-f64 x)
  saturating-f32-to-i128 :: F32 -> I128
  saturating-f32-to-i128 x = saturating-f64-to-i128 (f32-to-f64 x)
  checked-f32-to-u128 :: F32 -> Option U128
  checked-f32-to-u128 x = checked-f64-to-u128 (f32-to-f64 x)
  saturating-f32-to-u128 :: F32 -> U128
  saturating-f32-to-u128 x = saturating-f64-to-u128 (f32-to-f64 x)

  -- The mathematical types. Every `I128` is an `Int` and every `U128` a
  -- `Nat`, keeping the value; the other direction states the range it
  -- needs (a guard supplies it), and the `checked` forms answer `None`
  -- outside it (primitive types specification section 7). The `I128`
  -- pair keeps the value as a refinement, as `Data.Int`'s `I64` pair does.
  -- A wide scalar has no solver sort (its range is past the solver's
  -- `i128` arithmetic), so no bound follows from its type: a guard, or a
  -- `checked` form, supplies `int-to-i128`'s range. The runtime carries
  -- the 128-bit value across with the C ABI's `__int128`.
  foreign import ccall "cinch.runtime.intFromI128" int-from-i128 :: (x :: I128) -> refined (r == x) Int
  foreign import ccall "cinch.runtime.intToI128" int-to-i128 :: using (-170141183460469231731687303715884105728 <= x, x <= 170141183460469231731687303715884105727) => (x :: Int) -> refined (r == x) I128
  foreign import ccall "cinch.runtime.natFromU128" nat-from-u128 :: U128 -> Nat
  foreign import ccall "cinch.runtime.natToU128" nat-to-u128 :: using (n <= 340282366920938463463374607431768211455) => (n :: Nat) -> U128

  checked-int-to-i128 :: Int -> Option I128
  checked-int-to-i128 x = if -170141183460469231731687303715884105728 <= x && x <= 170141183460469231731687303715884105727 then Some (int-to-i128 x) else None

  checked-nat-to-u128 :: Nat -> Option U128
  checked-nat-to-u128 n = if n <= 340282366920938463463374607431768211455 then Some (nat-to-u128 n) else None

  int-from-u128 :: U128 -> Int
  int-from-u128 x = nat-to-int (nat-from-u128 x)

  checked-int-to-u128 :: Int -> Option U128
  checked-int-to-u128 x = if 0 <= x then checked-nat-to-u128 (nat-from-int x) else None

  checked-nat-to-i128 :: Nat -> Option I128
  checked-nat-to-i128 n = checked-int-to-i128 (nat-to-int n)

  -- `Show` is the decimal of the value, through `Int`.
  implicit instance Show_I128 :: Show I128 where
    show x = int-to-string (int-from-i128 x)

  implicit instance Show_U128 :: Show U128 where
    show x = nat-to-string (nat-from-u128 x)

  -- The order instances: signed order on `I128`, unsigned on `U128`
  -- (primitive types specification section 8).
  implicit instance Eq_I128 :: Eq I128 where
    (==) x y = eq-i128 x y
    (/=) x y = ne-i128 x y

  implicit instance Ord_I128 :: Ord I128 where
    (<) x y = lt-i128 x y
    (<=) x y = le-i128 x y
    (>) x y = gt-i128 x y
    (>=) x y = ge-i128 x y

  implicit instance Eq_U128 :: Eq U128 where
    (==) x y = eq-u128 x y
    (/=) x y = ne-u128 x y

  implicit instance Ord_U128 :: Ord U128 where
    (<) x y = lt-u128 x y
    (<=) x y = le-u128 x y
    (>) x y = gt-u128 x y
    (>=) x y = ge-u128 x y

  -- The `Bits` instances, with the modulo-width shift and mask rules of
  -- `Data.Machine`'s.
  implicit instance Bits_I128 :: Bits I128 where
    bit-and x y = bit-and-i128 x y
    bit-or x y = bit-or-i128 x y
    bit-xor x y = bit-xor-i128 x y
    bit-not x = bit-not-i128 x
    shift-left x n = wrapping-shl-i128 x n
    shift-right x n = wrapping-shr-i128 x n
    rotate-left x n = rotate-left-i128 x n
    rotate-right x n = rotate-right-i128 x n
    test-bit x n = ne-i128 (bit-and-i128 x (wrapping-shl-i128 1 n)) 0
    set-bit x n = bit-or-i128 x (wrapping-shl-i128 1 n)
    clear-bit x n = bit-and-i128 x (bit-not-i128 (wrapping-shl-i128 1 n))
    complement-bit x n = bit-xor-i128 x (wrapping-shl-i128 1 n)
    count-ones x = count-ones-i128 x
    leading-zeros x = leading-zeros-i128 x
    trailing-zeros x = trailing-zeros-i128 x

  implicit instance Bits_U128 :: Bits U128 where
    bit-and x y = bit-and-u128 x y
    bit-or x y = bit-or-u128 x y
    bit-xor x y = bit-xor-u128 x y
    bit-not x = bit-not-u128 x
    shift-left x n = wrapping-shl-u128 x n
    shift-right x n = wrapping-shr-u128 x n
    rotate-left x n = rotate-left-u128 x n
    rotate-right x n = rotate-right-u128 x n
    test-bit x n = ne-u128 (bit-and-u128 x (wrapping-shl-u128 1 n)) 0
    set-bit x n = bit-or-u128 x (wrapping-shl-u128 1 n)
    clear-bit x n = bit-and-u128 x (bit-not-u128 (wrapping-shl-u128 1 n))
    complement-bit x n = bit-xor-u128 x (wrapping-shl-u128 1 n)
    count-ones x = count-ones-u128 x
    leading-zeros x = leading-zeros-u128 x
    trailing-zeros x = trailing-zeros-u128 x

  -- Kernel-verified algebraic rewrite rules (`justify verify`, LRAT-checked).
  rewrite wrapping-add-u128-zero forall (x :: U128). where
    match (wrapping-add-u128 x 0)
    replace x
    justify verify

  rewrite wrapping-add-u128-self forall (x :: U128). where
    match (wrapping-add-u128 x x)
    replace (wrapping-shl-u128 x 1)
    justify verify

  rewrite wrapping-sub-u128-self forall (x :: U128). where
    match (wrapping-sub-u128 x x)
    replace 0
    justify verify

  rewrite bit-xor-u128-self forall (x :: U128). where
    match (bit-xor-u128 x x)
    replace 0
    justify verify

  rewrite bit-xor-u128-cancel forall (x :: U128) (y :: U128). where
    match (bit-xor-u128 (bit-xor-u128 x y) y)
    replace x
    justify verify

  rewrite bit-not-u128-involution forall (x :: U128). where
    match (bit-not-u128 (bit-not-u128 x))
    replace x
    justify verify

  rewrite bit-or-u128-zero forall (x :: U128). where
    match (bit-or-u128 x 0)
    replace x
    justify verify
