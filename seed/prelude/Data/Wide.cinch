  -- I128 (128 bits).
  min-bound-i128 :: I128
  min-bound-i128 = -170141183460469231731687303715884105728
  max-bound-i128 :: I128
  max-bound-i128 = 170141183460469231731687303715884105727
  prim wrapping-add-i128 :: I128 -> I128 -> I128 where
    llvm {
      %r = add i128 %0, %1
      ret i128 %r
    } justify verify
  prim wrapping-sub-i128 :: I128 -> I128 -> I128 where
    llvm {
      %r = sub i128 %0, %1
      ret i128 %r
    } justify verify
  prim wrapping-mul-i128 :: I128 -> I128 -> I128 where
    llvm {
      %r = mul i128 %0, %1
      ret i128 %r
    } justify verify
  spec wrapping-neg-i128-spec :: I128 -> I128
  wrapping-neg-i128-spec x = wrapping-sub-i128 0 x
  prim wrapping-neg-i128 :: I128 -> I128 spec wrapping-neg-i128-spec where
    llvm {
      %r = sub i128 0, %0
      ret i128 %r
    } justify verify
  prim saturating-add-i128 :: I128 -> I128 -> I128 where
    llvm {
      %r = call i128 @llvm.sadd.sat.i128(i128 %0, i128 %1)
      ret i128 %r
    } justify verify
  prim saturating-sub-i128 :: I128 -> I128 -> I128 where
    llvm {
      %r = call i128 @llvm.ssub.sat.i128(i128 %0, i128 %1)
      ret i128 %r
    } justify verify
  prim saturating-mul-i128 :: I128 -> I128 -> I128 where
    llvm {
      %res = call { i128, i1 } @llvm.smul.with.overflow.i128(i128 %0, i128 %1)
      %val = extractvalue { i128, i1 } %res, 0
      %ov = extractvalue { i128, i1 } %res, 1
      %sa = icmp slt i128 %0, 0
      %sb = icmp slt i128 %1, 0
      %same = icmp eq i1 %sa, %sb
      %bound = select i1 %same, i128 170141183460469231731687303715884105727, i128 -170141183460469231731687303715884105728
      %r = select i1 %ov, i128 %bound, i128 %val
      ret i128 %r
    } justify verify
  prim ov-add-i128 :: I128 -> I128 -> Bool where
    llvm {
      %res = call { i128, i1 } @llvm.sadd.with.overflow.i128(i128 %0, i128 %1)
      %ov = extractvalue { i128, i1 } %res, 1
      %r = zext i1 %ov to i8
      ret i8 %r
    } justify verify
  prim ov-sub-i128 :: I128 -> I128 -> Bool where
    llvm {
      %res = call { i128, i1 } @llvm.ssub.with.overflow.i128(i128 %0, i128 %1)
      %ov = extractvalue { i128, i1 } %res, 1
      %r = zext i1 %ov to i8
      ret i8 %r
    } justify verify
  prim ov-mul-i128 :: I128 -> I128 -> Bool where
    llvm {
      %res = call { i128, i1 } @llvm.smul.with.overflow.i128(i128 %0, i128 %1)
      %ov = extractvalue { i128, i1 } %res, 1
      %r = zext i1 %ov to i8
      ret i8 %r
    } justify verify
  -- Signed 128-bit division/remainder: precondition rules out LLVM immediate UB
  -- (`%1 == 0` or `%0 == MIN && %1 == -1`), so no `unsafe` trust boundary is needed.
  prim raw-sdiv-i128 :: (a :: I128) -> refined (r /= 0 && Not (a == -170141183460469231731687303715884105728 && r == -1)) I128 -> I128 where
    llvm {
      %r = sdiv i128 %0, %1
      ret i128 %r
    } justify verify
  prim raw-srem-i128 :: (a :: I128) -> refined (r /= 0 && Not (a == -170141183460469231731687303715884105728 && r == -1)) I128 -> I128 where
    llvm {
      %r = srem i128 %0, %1
      ret i128 %r
    } justify verify
  prim bit-and-i128 :: I128 -> I128 -> I128 where
    llvm {
      %r = and i128 %0, %1
      ret i128 %r
    } justify verify
  prim bit-or-i128 :: I128 -> I128 -> I128 where
    llvm {
      %r = or i128 %0, %1
      ret i128 %r
    } justify verify
  prim bit-xor-i128 :: I128 -> I128 -> I128 where
    llvm {
      %r = xor i128 %0, %1
      ret i128 %r
    } justify verify
  spec bit-not-i128-spec :: I128 -> I128
  bit-not-i128-spec x = bit-xor-i128 x (-1)
  prim bit-not-i128 :: I128 -> I128 spec bit-not-i128-spec where
    llvm {
      %r = xor i128 %0, -1
      ret i128 %r
    } justify verify
  prim wrapping-shl-i128 :: I128 -> U32 -> I128 where
    llvm {
      %m = and i32 %1, 127
      %s = zext i32 %m to i128
      %r = shl i128 %0, %s
      ret i128 %r
    } justify verify
  prim wrapping-shr-i128 :: I128 -> U32 -> I128 where
    llvm {
      %m = and i32 %1, 127
      %s = zext i32 %m to i128
      %r = ashr i128 %0, %s
      ret i128 %r
    } justify verify
  prim rotate-left-i128 :: I128 -> U32 -> I128 where
    llvm {
      %s = zext i32 %1 to i128
      %r = call i128 @llvm.fshl.i128(i128 %0, i128 %0, i128 %s)
      ret i128 %r
    } justify verify
  prim rotate-right-i128 :: I128 -> U32 -> I128 where
    llvm {
      %s = zext i32 %1 to i128
      %r = call i128 @llvm.fshr.i128(i128 %0, i128 %0, i128 %s)
      ret i128 %r
    } justify verify
  prim count-ones-i128 :: I128 -> refined (0 <= r && r <= 128) U32 where
    llvm {
      %c = call i128 @llvm.ctpop.i128(i128 %0)
      %r = trunc i128 %c to i32
      ret i32 %r
    } justify verify
  prim leading-zeros-i128 :: I128 -> refined (0 <= r && r <= 128) U32 where
    llvm {
      %c = call i128 @llvm.ctlz.i128(i128 %0, i1 false)
      %r = trunc i128 %c to i32
      ret i32 %r
    } justify verify
  prim trailing-zeros-i128 :: I128 -> refined (0 <= r && r <= 128) U32 where
    llvm {
      %c = call i128 @llvm.cttz.i128(i128 %0, i1 false)
      %r = trunc i128 %c to i32
      ret i32 %r
    } justify verify
  prim reverse-bits-i128 :: I128 -> I128 where
    llvm {
      %r = call i128 @llvm.bitreverse.i128(i128 %0)
      ret i128 %r
    } justify verify
  prim swap-bytes-i128 :: I128 -> I128 where
    llvm {
      %r = call i128 @llvm.bswap.i128(i128 %0)
      ret i128 %r
    } justify verify
  prim eq-i128 :: I128 -> I128 -> Bool where
    llvm {
      %c = icmp eq i128 %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    } justify verify
  prim ne-i128 :: I128 -> I128 -> Bool where
    llvm {
      %c = icmp ne i128 %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    } justify verify
  prim lt-i128 :: I128 -> I128 -> Bool where
    llvm {
      %c = icmp slt i128 %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    } justify verify
  prim le-i128 :: I128 -> I128 -> Bool where
    llvm {
      %c = icmp sle i128 %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    } justify verify
  prim gt-i128 :: I128 -> I128 -> Bool where
    llvm {
      %c = icmp sgt i128 %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    } justify verify
  prim ge-i128 :: I128 -> I128 -> Bool where
    llvm {
      %c = icmp sge i128 %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    } justify verify
  checked-add-i128 :: I128 -> I128 -> Option I128
  checked-add-i128 x y = if ov-add-i128 x y then None else Some (wrapping-add-i128 x y)
  checked-sub-i128 :: I128 -> I128 -> Option I128
  checked-sub-i128 x y = if ov-sub-i128 x y then None else Some (wrapping-sub-i128 x y)
  checked-mul-i128 :: I128 -> I128 -> Option I128
  checked-mul-i128 x y = if ov-mul-i128 x y then None else Some (wrapping-mul-i128 x y)
  checked-neg-i128 :: I128 -> Option I128
  checked-neg-i128 x = if eq-i128 x min-bound-i128 then None else Some (wrapping-neg-i128 x)
  saturating-neg-i128 :: I128 -> I128
  saturating-neg-i128 x = if eq-i128 x min-bound-i128 then max-bound-i128 else wrapping-neg-i128 x
  checked-div-i128 :: I128 -> I128 -> Option I128
  checked-div-i128 x y = case decide (y /= 0 && Not (x == -170141183460469231731687303715884105728 && y == -1)) of
    Yes _ -> Some (raw-sdiv-i128 x y)
    No _ -> None
  checked-rem-i128 :: I128 -> I128 -> Option I128
  checked-rem-i128 x y = case decide (y /= 0 && Not (x == -170141183460469231731687303715884105728 && y == -1)) of
    Yes _ -> Some (raw-srem-i128 x y)
    No _ -> None
  checked-shl-i128 :: I128 -> U32 -> Option I128
  checked-shl-i128 x n = if lt-u32 n 128 then Some (wrapping-shl-i128 x n) else None
  checked-shr-i128 :: I128 -> U32 -> Option I128
  checked-shr-i128 x n = if lt-u32 n 128 then Some (wrapping-shr-i128 x n) else None

  -- U128 (128 bits).
  min-bound-u128 :: U128
  min-bound-u128 = 0
  max-bound-u128 :: U128
  max-bound-u128 = 340282366920938463463374607431768211455
  prim wrapping-add-u128 :: U128 -> U128 -> U128 where
    llvm {
      %r = add i128 %0, %1
      ret i128 %r
    } justify verify
  prim wrapping-sub-u128 :: U128 -> U128 -> U128 where
    llvm {
      %r = sub i128 %0, %1
      ret i128 %r
    } justify verify
  prim wrapping-mul-u128 :: U128 -> U128 -> U128 where
    llvm {
      %r = mul i128 %0, %1
      ret i128 %r
    } justify verify
  spec wrapping-neg-u128-spec :: U128 -> U128
  wrapping-neg-u128-spec x = wrapping-sub-u128 0 x
  prim wrapping-neg-u128 :: U128 -> U128 spec wrapping-neg-u128-spec where
    llvm {
      %r = sub i128 0, %0
      ret i128 %r
    } justify verify
  prim saturating-add-u128 :: U128 -> U128 -> U128 where
    llvm {
      %r = call i128 @llvm.uadd.sat.i128(i128 %0, i128 %1)
      ret i128 %r
    } justify verify
  prim saturating-sub-u128 :: U128 -> U128 -> U128 where
    llvm {
      %r = call i128 @llvm.usub.sat.i128(i128 %0, i128 %1)
      ret i128 %r
    } justify verify
  prim saturating-mul-u128 :: U128 -> U128 -> U128 where
    llvm {
      %res = call { i128, i1 } @llvm.umul.with.overflow.i128(i128 %0, i128 %1)
      %val = extractvalue { i128, i1 } %res, 0
      %ov = extractvalue { i128, i1 } %res, 1
      %r = select i1 %ov, i128 -1, i128 %val
      ret i128 %r
    } justify verify
  prim ov-add-u128 :: U128 -> U128 -> Bool where
    llvm {
      %res = call { i128, i1 } @llvm.uadd.with.overflow.i128(i128 %0, i128 %1)
      %ov = extractvalue { i128, i1 } %res, 1
      %r = zext i1 %ov to i8
      ret i8 %r
    } justify verify
  prim ov-sub-u128 :: U128 -> U128 -> Bool where
    llvm {
      %res = call { i128, i1 } @llvm.usub.with.overflow.i128(i128 %0, i128 %1)
      %ov = extractvalue { i128, i1 } %res, 1
      %r = zext i1 %ov to i8
      ret i8 %r
    } justify verify
  prim ov-mul-u128 :: U128 -> U128 -> Bool where
    llvm {
      %res = call { i128, i1 } @llvm.umul.with.overflow.i128(i128 %0, i128 %1)
      %ov = extractvalue { i128, i1 } %res, 1
      %r = zext i1 %ov to i8
      ret i8 %r
    } justify verify
  -- Unsigned 128-bit division/remainder: `udiv`/`urem` have immediate LLVM UB
  -- when `%1 == 0`, so the underlying prims require a `refined (r /= 0) U128`
  -- divisor (verifiable without `unsafe`) and `div-u128`/`rem-u128` expose
  -- the same `using (b /= 0)` interface as `Data.Machine.div-u64`.
  prim raw-div-u128 :: U128 -> refined (r /= 0) U128 -> U128 where
    llvm {
      %r = udiv i128 %0, %1
      ret i128 %r
    } justify verify
  prim raw-rem-u128 :: U128 -> refined (r /= 0) U128 -> U128 where
    llvm {
      %r = urem i128 %0, %1
      ret i128 %r
    } justify verify
  div-u128 :: using (b /= 0) => U128 -> (b :: U128) -> U128
  div-u128 a b = raw-div-u128 a b
  rem-u128 :: using (b /= 0) => U128 -> (b :: U128) -> U128
  rem-u128 a b = raw-rem-u128 a b
  prim bit-or-u128 :: U128 -> U128 -> U128 where
    llvm {
      %r = or i128 %0, %1
      ret i128 %r
    } justify verify
  prim bit-xor-u128 :: U128 -> U128 -> U128 where
    llvm {
      %r = xor i128 %0, %1
      ret i128 %r
    } justify verify
  spec bit-not-u128-spec :: U128 -> U128
  bit-not-u128-spec x = bit-xor-u128 x (wrapping-sub-u128 0 1)
  prim bit-not-u128 :: U128 -> U128 spec bit-not-u128-spec where
    llvm {
      %r = xor i128 %0, -1
      ret i128 %r
    } justify verify
  prim wrapping-shl-u128 :: U128 -> U32 -> U128 where
    llvm {
      %m = and i32 %1, 127
      %s = zext i32 %m to i128
      %r = shl i128 %0, %s
      ret i128 %r
    } justify verify
  prim wrapping-shr-u128 :: U128 -> U32 -> U128 where
    llvm {
      %m = and i32 %1, 127
      %s = zext i32 %m to i128
      %r = lshr i128 %0, %s
      ret i128 %r
    } justify verify
  prim rotate-left-u128 :: U128 -> U32 -> U128 where
    llvm {
      %s = zext i32 %1 to i128
