-- Data.Time.Zone.Types: the vocabulary the zone modules share
-- (design/datetime.md, layer L2, lane C).
--
-- `Data.Time.Zone` imports `Data.Time.Zone.Posix` (a zone's tail is a
-- POSIX rule), and both need `OffsetInfo` and `Ambiguous`, so the
-- shared types live here and `Data.Time.Zone` re-exports this whole
-- module. Import `Data.Time.Zone` unless you are writing a zone
-- module.
--
-- The two mappings a time zone is (T4):
--   - instant to offset: total, an `OffsetInfo` (the offset, whether
--     it is daylight saving time, and the abbreviation such as "EST").
--   - civil reading to offset: `Ambiguous`. A reading is
--     `Unambiguous o` (it occurs once, at offset `o`), a
--     `Gap before after` (it never occurs: the clocks jumped from
--     offset `before` to `after` over it), or a `Fold before after`
--     (it occurs twice: first at offset `before`, then at `after`).
--
-- Design law shape. Ambiguity is a value; a `Disambiguation` is an
-- eliminator for it, never applied silently. With `at o x` the
-- instant whose civil reading at offset `o` is `x`
-- (`offset-datetime-to-timestamp`), `ambiguous-resolve s x a` is, as
-- Temporal and Jiff define the four strategies:
--
--   a               Compatible     Earlier        Later          Reject
--   Unambiguous o   at o x         at o x         at o x         at o x
--   Gap b a         at b x         at a x         at b x         Err
--   Fold b a        at b x         at b x         at a x         Err
--
-- In a gap the reading does not exist, so it is read with the offset
-- that was in force on one side of the jump: reading it with the
-- offset BEFORE the gap gives the later instant (the reading shifted
-- forward by the gap's length, shown with the offset after it:
-- 02:30 in New York's spring gap becomes 03:30 -04:00), and reading it
-- with the offset AFTER the gap gives the earlier instant (01:30
-- -05:00). In a fold the first occurrence has the offset before the
-- transition. "Compatible" (RFC 5545's rule) is the later instant in
-- a gap and the earlier one in a fold.
-- `ambiguous-from-lookups` derives the `Ambiguous` of a reading from
-- a zone's two instant-side lookups and is the one implementation
-- every kind of zone uses, so a gap or fold is exactly the set of
-- readings that zero or two instants map back to.
--
-- NAMED REFUSALS:
--   - a default strategy: no function here picks one silently.
--   - an instant outside the timestamp range: `AmbiguityOutOfRange`
--     (only within 26 hours of the ends of the civil range).
--   - sub-second offsets and leap seconds: as `Data.Time.Offset`.
module Data.Time.Zone.Types where

  import Data.Machine
  import Data.Option
  import Data.Result
  import Relation.Eq
  import Data.Time.Timestamp
  import Data.Time.DateTime (DateTime)
  import Data.Time.DateTime as DT
  import Data.Time.Offset

  export OffsetInfo, offset-info, offset-info-offset, offset-info-is-dst
  export offset-info-abbreviation
  export Ambiguous, Unambiguous, Gap, Fold
  export Disambiguation, Compatible, Earlier, Later, Reject
  export AmbiguityError, RejectedGap, RejectedFold, AmbiguityOutOfRange
  export ambiguous-is-ambiguous, ambiguous-is-gap, ambiguous-is-fold
  export ambiguous-unambiguous, ambiguous-offset
  export ambiguous-resolve, ambiguous-compatible, ambiguous-earlier
  export ambiguous-later, ambiguous-reject
  export ambiguous-from-lookups


  -- What a zone says about one instant: the offset in force, whether
  -- it is daylight saving time, and the abbreviation ("EST", "+0330").
  -- Abstract; `offset-info` builds one (any three values are valid).
  data OffsetInfo where
    MkOffsetInfo :: Offset -> Bool -> String -> OffsetInfo

  offset-info :: Offset -> Bool -> String -> OffsetInfo
  offset-info o dst abbr = MkOffsetInfo o dst abbr

  offset-info-offset :: OffsetInfo -> Offset
  offset-info-offset i = case i of
    MkOffsetInfo o _ _ -> o

  offset-info-is-dst :: OffsetInfo -> Bool
  offset-info-is-dst i = case i of
    MkOffsetInfo _ d _ -> d

  offset-info-abbreviation :: OffsetInfo -> String
  offset-info-abbreviation i = case i of
    MkOffsetInfo _ _ a -> a

  -- The offsets a civil reading can have (T4). `Gap before after` and
  -- `Fold before after` name the offset in force before the
  -- transition and the one after it.
  data Ambiguous where
    Unambiguous :: Offset -> Ambiguous
    Gap :: Offset -> Offset -> Ambiguous
    Fold :: Offset -> Offset -> Ambiguous

  -- How to choose (the header's table).
  data Disambiguation where
    Compatible :: Disambiguation
    Earlier :: Disambiguation
    Later :: Disambiguation
    Reject :: Disambiguation

  -- Why a civil reading was not turned into an instant: `Reject` met a
  -- gap or a fold (the two offsets are the `Ambiguous` value's), or
  -- the instant is outside the timestamp range.
  data AmbiguityError where
    RejectedGap :: Offset -> Offset -> AmbiguityError
    RejectedFold :: Offset -> Offset -> AmbiguityError
    AmbiguityOutOfRange :: AmbiguityError

  -- -----------------------------------------------------------------
  -- Reading an `Ambiguous`.
  -- -----------------------------------------------------------------

  -- A gap or a fold.
  ambiguous-is-ambiguous :: Ambiguous -> Bool
  ambiguous-is-ambiguous a = case a of
    Unambiguous _ -> False
    Gap _ _ -> True
    Fold _ _ -> True

  ambiguous-is-gap :: Ambiguous -> Bool
  ambiguous-is-gap a = case a of
    Unambiguous _ -> False
    Gap _ _ -> True
    Fold _ _ -> False

  ambiguous-is-fold :: Ambiguous -> Bool
  ambiguous-is-fold a = case a of
    Unambiguous _ -> False
    Gap _ _ -> False
    Fold _ _ -> True

  -- The one offset, when there is exactly one.
  ambiguous-unambiguous :: Ambiguous -> Option Offset
  ambiguous-unambiguous a = case a of
    Unambiguous o -> Some o
    Gap _ _ -> None
    Fold _ _ -> None

  -- The offset the strategy reads the civil value with (the header's
  -- table), or `None` when `Reject` meets a gap or a fold. Note that
  -- for a gap this is the offset the reading is INTERPRETED with; the
  -- resulting instant then displays with the other one.
  ambiguous-offset :: Disambiguation -> Ambiguous -> Option Offset
  ambiguous-offset s a = case a of
    Unambiguous o -> Some o
    Gap before after -> case s of
      Compatible -> Some before
      Earlier -> Some after
      Later -> Some before
      Reject -> None
    Fold before after -> case s of
      Compatible -> Some before
      Earlier -> Some before
      Later -> Some after
      Reject -> None

  -- -----------------------------------------------------------------
  -- Eliminators: a civil reading and its `Ambiguous` to an instant.
  -- -----------------------------------------------------------------

  at-offset :: Offset -> DateTime -> Result AmbiguityError Timestamp
  at-offset o x = case offset-datetime-to-timestamp o x of
    Some t -> Ok t
    None -> Err AmbiguityOutOfRange

  ambiguous-resolve :: Disambiguation -> DateTime -> Ambiguous -> Result AmbiguityError Timestamp
  ambiguous-resolve s x a = case ambiguous-offset s a of
    Some o -> at-offset o x
    None -> case a of
      Unambiguous o -> at-offset o x
      Gap before after -> Err (RejectedGap before after)
      Fold before after -> Err (RejectedFold before after)

  -- The four strategies by name.
  ambiguous-compatible :: DateTime -> Ambiguous -> Result AmbiguityError Timestamp
  ambiguous-compatible x a = ambiguous-resolve Compatible x a

  ambiguous-earlier :: DateTime -> Ambiguous -> Result AmbiguityError Timestamp
  ambiguous-earlier x a = ambiguous-resolve Earlier x a

  ambiguous-later :: DateTime -> Ambiguous -> Result AmbiguityError Timestamp
  ambiguous-later x a = ambiguous-resolve Later x a

  ambiguous-reject :: DateTime -> Ambiguous -> Result AmbiguityError Timestamp
  ambiguous-reject x a = ambiguous-resolve Reject x a

  -- -----------------------------------------------------------------
  -- Deriving the `Ambiguous` of a reading from the instant side.
  -- -----------------------------------------------------------------

  -- `ambiguous-from-lookups offset-at next x`: for a zone given by
  -- `offset-at` (the offset in force at a Unix second) and `next` (the
  -- first transition instant strictly after a Unix second, if any).
  --
  -- With `l` the reading's position on the civil line in seconds, a
  -- period of constant offset `o` running over the instants `[s, e)`
  -- contains the reading exactly when `s <= l - o < e`. Offsets are
  -- within 93599 seconds of UTC, so the walk starts at the period
  -- holding the instant `l - 93599`, which the reading cannot precede,
  -- and steps forward while the reading is past the period's end. At
  -- the first period it is not past: if it is at or after the
  -- period's start it occurs there (and occurs again, a fold, when it
  -- is also at or after the start of the next period read with that
  -- period's offset); if it is before the start it fell between two
  -- periods, a gap. A transition that does not change the offset can
  -- produce neither. Each step moves to a strictly later transition
  -- and stops at the latest once the period's end passes `l + 93599`,
  -- so the walk ends. All sums are of Unix seconds within +-3.8e11
  -- and offsets, so none wraps.
  ambiguous-from-lookups :: (I64 -> Offset) -> (I64 -> Option I64) -> DateTime -> Ambiguous
  ambiguous-from-lookups offset-at next x = case DT.to-epoch-seconds-nanos-utc x of
    (l, _) ->
      let t = wrapping-sub-i64 l 93599 in
      let o = offset-at t in
      walk offset-at next l t o o False

  -- `t` is the current period's start (or the walk's origin when
  -- `started` is false), `o` its offset, `po` the previous period's.
  walk :: (I64 -> Offset) -> (I64 -> Option I64) -> I64 -> I64 -> Offset -> Offset -> Bool -> Ambiguous
  walk offset-at next l t o po started =
    let u = wrapping-sub-i64 l (offset-to-seconds o) in
    case next t of
      None ->
        if started && lt-i64 u t then Gap po o else Unambiguous o
      Some n ->
        if ge-i64 u n then walk offset-at next l n (offset-at n) o True
        else if started && lt-i64 u t then Gap po o
        else
          let o2 = offset-at n in
          if ge-i64 (wrapping-sub-i64 l (offset-to-seconds o2)) n then Fold o o2
          else Unambiguous o
