-- | UTF-8 decoding, validation, scalar encoding and fresh byte repair.
-- Invalid or truncated encodings consume exactly one byte as U+FFFD. End and
-- out-of-bounds positions consume zero bytes and have distinct statuses. Numeric
-- rune operations accept scalar values only; encoding invalid values emits U+FFFD.
-- Repair groups consecutive malformed bytes by default; repair-each replaces each
-- malformed byte. Replacements are arbitrary bytes and every returned buffer is
-- fresh, including empty or already valid input. Complete ASCII blocks use portable
-- 16-byte SIMD via Data.Wide and 8-byte SWAR; non-ASCII fringes enforce shortest
-- encoding, scalar bounds and checked Data.Bytes loads.
module Data.Bytes.Utf8 where
  import Data.Bool
  import Data.Bytes
  import Data.Char
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Wide

  export Utf8Status, Utf8End, Utf8Valid, Utf8Invalid, Utf8OutOfBounds, Utf8Step
  export utf8-scalar-step, utf8-end-step
  export utf8-step-char, utf8-step-width, utf8-step-status, utf8-decode-at, utf8-first, utf8-last-before, utf8-last
  export utf8-rune-error, utf8-rune-self, utf8-max-rune, utf8-max-width, utf8-rune-start, utf8-valid-rune, utf8-rune-length
  export utf8-count-between, utf8-decode-between
  export utf8-count, utf8-valid, utf8-first-invalid, utf8-full-rune, utf8-encode-rune, utf8-encode-into, utf8-append-rune
  export utf8-repair, utf8-repair-each, utf8-replace-invalid

  -- | Whether a decoding position is valid, malformed, exactly at the end, or beyond the buffer.
  data Utf8Status where
    -- | Exactly the empty suffix; no input was consumed.
    Utf8End :: Utf8Status
    -- | One shortest-form scalar encoding was consumed.
    Utf8Valid :: Utf8Status
    -- | One malformed byte was consumed as U+FFFD, including a truncated encoding.
    Utf8Invalid :: Utf8Status
    -- | The requested offset is greater than the byte length; no input was consumed.
    Utf8OutOfBounds :: Utf8Status

  -- | A decoded scalar, exact consumed byte width and explicit position status.
  data Utf8Step where
    -- | Private immutable observations; non-valid statuses carry the replacement scalar.
    DecodedStep :: Char -> Nat -> Utf8Status -> Utf8Step

  -- | Observe the decoded scalar, or U+FFFD for an invalid/end/out-of-bounds step.
  utf8-step-char :: Utf8Step -> Char
  utf8-step-char step = case step of DecodedStep value width status -> value

  -- | Observe consumed bytes: one through four for valid input, one for malformed input, zero at end or beyond.
  utf8-step-width :: Utf8Step -> Nat
  utf8-step-width step = case step of DecodedStep value width status -> width

  -- | Observe whether the position represents valid input, a malformed byte, end, or an invalid offset.
  utf8-step-status :: Utf8Step -> Utf8Status
  utf8-step-status step = case step of DecodedStep value width status -> status

  -- | The scalar emitted for a malformed byte or invalid numeric encoding input.
  utf8-rune-error :: Char
  utf8-rune-error = '\u{FFFD}'

  -- | The first byte requiring a multibyte encoding.
  utf8-rune-self :: U32
  utf8-rune-self = 128

  -- | The greatest Unicode code point, which is a valid scalar.
  utf8-max-rune :: U32
  utf8-max-rune = 1114111

  -- | Maximum bytes in a scalar's shortest UTF-8 encoding.
  utf8-max-width :: Nat
  utf8-max-width = 4

  -- | Decode a low-byte-first four-byte word with one through four available bytes.
  -- The packed result stores scalar bits 0..20, width bits 21..23, status bits 24..25
  -- and an incomplete-valid-prefix flag in bit 26. No dynamic shifts or speculative loads occur.
  decode-word :: U32 -> U8 -> U32
  decode-word word avail =
    let b0 = bit-and-u32 word 255 in
    let b1 = bit-and-u32 (wrapping-shr-u32 word 8) 255 in
    let b2 = bit-and-u32 (wrapping-shr-u32 word 16) 255 in
    let b3 = bit-and-u32 (wrapping-shr-u32 word 24) 255 in
    let c1 = eq-u32 (bit-and-u32 b1 192) 128 in
    let c2 = eq-u32 (bit-and-u32 b2 192) 128 in
    let c3 = eq-u32 (bit-and-u32 b3 192) 128 in
    let ascii = lt-u32 b0 128 in
    let two = ge-u32 b0 194 && le-u32 b0 223 in
    let three = ge-u32 b0 224 && le-u32 b0 239 in
    let four = ge-u32 b0 240 && le-u32 b0 244 in
    let e0check = if eq-u32 b0 224 then ge-u32 b1 160 else True in
    let edcheck = if eq-u32 b0 237 then lt-u32 b1 160 else True in
    let f0check = if eq-u32 b0 240 then ge-u32 b1 144 else True in
    let f4check = if eq-u32 b0 244 then lt-u32 b1 144 else True in
    let check3 = e0check && edcheck && c1 in
    let check4 = f0check && f4check && c1 in
    let second = if three then check3 else if four then check4 else c1 in
    let width = ((if ascii then 1 else if two then 2 else if three then 3 else if four then 4 else 0) :: U8) in
    let has-lead = ne-u8 width 0 in
    let complete = ge-u8 avail width in
    let second-valid = if ge-u8 width 2 then second else True in
    let third-valid = if ge-u8 width 3 then c2 else True in
    let fourth-valid = if ge-u8 width 4 then c3 else True in
    let valid = has-lead && complete && second-valid && third-valid && fourth-valid in
    let present2 = if ge-u8 avail 2 then second else True in
    let present3 = if ge-u8 avail 3 then c2 else True in
    let incomplete = has-lead && lt-u8 avail width && present2 && present3 in
    let p1 = bit-and-u32 b1 63 in
    let p2 = bit-and-u32 b2 63 in
    let p3 = bit-and-u32 b3 63 in
    let cp2 = bit-or-u32 (wrapping-shl-u32 (bit-and-u32 b0 31) 6) p1 in
    let cp3 = bit-or-u32 (bit-or-u32 (wrapping-shl-u32 (bit-and-u32 b0 15) 12) (wrapping-shl-u32 p1 6)) p2 in
    let cp4 = bit-or-u32 (bit-or-u32 (bit-or-u32 (wrapping-shl-u32 (bit-and-u32 b0 7) 18) (wrapping-shl-u32 p1 12)) (wrapping-shl-u32 p2 6)) p3 in
    let cp = if ascii then b0 else if two then cp2 else if three then cp3 else cp4 in
    let cp-out = if valid then cp else 65533 in
    let width-out = if valid then width else 1 in
    let width-bits = wrapping-shl-u32 (u8-to-u32 width-out) 21 in
    let status = ((if valid then 16777216 else 33554432) :: U32) in
    let incomplete-bits = ((if incomplete then 67108864 else 0) :: U32) in
    bit-or-u32 (bit-or-u32 (bit-or-u32 cp-out width-bits) status) incomplete-bits

  -- | Assemble only the available one-to-three tail bytes in low-byte-first order.
  tail-word :: Bytes -> I64 -> I64 -> U32
  tail-word bs end at =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      let first = u8-to-u32 (bytes-get-u8-at bs at) in
      let at1 = wrapping-add-i64 at 1 in
      if 0 <= at1 && at1 < end then
        let pair = bit-or-u32 first (wrapping-shl-u32 (u8-to-u32 (bytes-get-u8-at bs at1)) 8) in
        let at2 = wrapping-add-i64 at 2 in
        if 0 <= at2 && at2 < end then
          bit-or-u32 pair (wrapping-shl-u32 (u8-to-u32 (bytes-get-u8-at bs at2)) 16)
        else pair
      else first
    else 0

  -- | Decode one proved nonempty suffix using checked full-word or byte-tail loads.
  decode-raw :: Bytes -> I64 -> I64 -> U32
  decode-raw bs end at =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      if 4 <= end then
        let ne = nat-from-i64 end in
        if 4 <= ne then
          let lim = ne - 4 in
          let ni = nat-from-i64 at in
          if ni <= lim then
            decode-word (bytes-load-le32 bs ni) 4
          else
            let word = tail-word bs end at in
            let avail = wrapping-i64-to-u8 (wrapping-sub-i64 end at) in
            decode-word word avail
        else decode-word (tail-word bs end at) (wrapping-i64-to-u8 (wrapping-sub-i64 end at))
      else
        let word = tail-word bs end at in
        let avail = wrapping-i64-to-u8 (wrapping-sub-i64 end at) in
        decode-word word avail
    else 0

  -- | Classify one leading byte without inspecting unrelated bytes; zero requests multibyte validation.
  scan-simple :: U8 -> U8
  scan-simple byte =
    if lt-u8 byte 128 then 9
    else if ge-u8 byte 194 && le-u8 byte 244 then 0
    else 1

  -- | Recognize the complete one-byte result from a simple lead classification.
  scan-ready :: U8 -> Bool
  scan-ready value = ne-u8 value 0

  -- | Validate a plausible multibyte lead with complete four-byte lookahead, returning only width and validity.
  -- SWAR continuation masks avoid computing code points or incomplete-prefix metadata during bulk scans.
  scan-four :: U32 -> U8
  scan-four word =
    let first = bit-and-u32 word 255 in
    let second = bit-and-u32 (wrapping-shr-u32 word 8) 255 in
    let lead = ge-u32 first 194 && le-u32 first 244 in
    let two = lt-u32 first 224 in
    let three = lt-u32 first 240 in
    let cont2 = eq-u32 (bit-and-u32 word 49152) 32768 in
    let cont3 = eq-u32 (bit-and-u32 word 12632064) 8421376 in
    let cont4 = eq-u32 (bit-and-u32 word 3233857536) 2155905024 in
    let e0valid = if eq-u32 first 224 then ge-u32 second 160 else True in
    let edvalid = if eq-u32 first 237 then lt-u32 second 160 else True in
    let f0valid = if eq-u32 first 240 then ge-u32 second 144 else True in
    let f4valid = if eq-u32 first 244 then lt-u32 second 144 else True in
    let valid3 = cont3 && e0valid && edvalid in
    let valid4 = cont4 && f0valid && f4valid in
    let tail-valid = if two then cont2 else if three then valid3 else valid4 in
    let valid = lead && tail-valid in
    let width = ((if two then 2 else if three then 3 else 4) :: U8) in
    let consumed = if valid then width else 1 in
    let flag = ((if valid then 8 else 0) :: U8) in
    bit-or-u8 consumed flag

  -- | Convert an exact tail decoder result to the same minimal scan representation.
  scan-from-packed :: U32 -> U8
  scan-from-packed packed =
    let width = bit-and-u32 (wrapping-shr-u32 packed 21) 7 in
    let valid = eq-u32 (bit-and-u32 packed 50331648) 16777216 in
    let flag = ((if valid then 8 else 0) :: U32) in
    wrapping-u32-to-u8 (bit-or-u32 width flag)

  -- | Observe the consumed scan width as a machine offset.
  scan-width :: U8 -> I64
  scan-width value = u8-to-i64 (bit-and-u8 value 7)

  -- | Recognize one valid scan result without constructing a decoded scalar.
  scan-valid :: U8 -> Bool
  scan-valid value = ne-u8 (bit-and-u8 value 8) 0

  -- | Scan one proved nonempty suffix with early ASCII/invalid-lead classification and checked lookahead.
  scan-raw :: Bytes -> I64 -> I64 -> U8
  scan-raw bs end at =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      let first = bytes-get-u8-at bs at in
      let simple = scan-simple first in
      if scan-ready simple then simple
      else if 4 <= end then
        let ne = nat-from-i64 end in
        if 4 <= ne then
          let lim = ne - 4 in
          let ni = nat-from-i64 at in
          if ni <= lim then
            scan-four (bytes-load-le32 bs ni)
          else
            let word = tail-word bs end at in
            let avail = wrapping-i64-to-u8 (wrapping-sub-i64 end at) in
            scan-from-packed (decode-word word avail)
        else 1
      else
        let word = tail-word bs end at in
        let avail = wrapping-i64-to-u8 (wrapping-sub-i64 end at) in
        scan-from-packed (decode-word word avail)
    else 1

  -- | Observe a packed consumed width as a machine offset.
  packed-width :: U32 -> I64
  packed-width packed = u32-to-i64 (bit-and-u32 (wrapping-shr-u32 packed 21) 7)

  -- | Recognize a packed valid status directly, excluding the independent incomplete-prefix flag.
  packed-valid :: U32 -> Bool
  packed-valid packed = eq-u32 (bit-and-u32 packed 50331648) 16777216

  -- | Convert one verified packed result into safe scalar-facing observations.
  packed-step :: U32 -> Utf8Step
  packed-step packed =
    let raw = bit-and-u32 packed 2097151 in
    let value = case u32-to-char raw of None -> utf8-rune-error; Some scalar -> scalar in
    let w = packed-width packed in
    let width = ((if 0 <= w then nat-from-i64 w else 0) :: Nat) in
    DecodedStep value width (if packed-valid packed then Utf8Valid else Utf8Invalid)

  -- | Decode at a byte offset; a malformed nonempty suffix always consumes exactly one byte.
  utf8-decode-at :: Bytes -> Nat -> Utf8Step
  utf8-decode-at source at =
    if at < bytes-len source then
      packed-step (decode-raw source (bytes-len-i64 source) (nat-to-i64 at))
    else DecodedStep utf8-rune-error 0 (if at == bytes-len source then Utf8End else Utf8OutOfBounds)

  -- | Decode at an absolute owner offset within the half-open byte span [start,end).
  -- Invalid bounds (start > end or end > buffer length), positions before start,
  -- and positions beyond end return Utf8OutOfBounds with zero width and U+FFFD.
  -- A valid at == end returns Utf8End, including an empty span. The span is decoded
  -- independently: a leading continuation or encoding truncated by end consumes
  -- exactly one byte as Utf8Invalid. No byte outside the span is read or copied.
  utf8-decode-between :: Bytes -> Nat -> Nat -> Nat -> Utf8Step
  utf8-decode-between source start end at =
    if start <= end && end <= bytes-len source && start <= at && at <= end then
      if at == end then utf8-end-step ()
      else packed-step (decode-raw source (nat-to-i64 end) (nat-to-i64 at))
    else DecodedStep utf8-rune-error 0 Utf8OutOfBounds

  -- | Decode the first scalar or one malformed byte; an empty buffer has Utf8End status.
  utf8-first :: Bytes -> Utf8Step
  utf8-first source = utf8-decode-at source 0

  -- | Test whether a byte can start an encoding, including malformed leading bytes.
  utf8-rune-start :: U8 -> Bool
  utf8-rune-start byte = ne-u8 (bit-and-u8 byte 192) 128

  -- | Search at most three preceding continuation bytes while retaining the exact prefix bound.
  last-start :: Bytes -> I64 -> I64 -> I64
  last-start bs at remaining =
    if 0 < at && 0 < remaining && at < bytes-len-i64 bs then
      let byte = bytes-get-u8-at bs at in
      if utf8-rune-start byte then at
      else last-start bs (wrapping-sub-i64 at 1) (wrapping-sub-i64 remaining 1)
    else at

  -- | Decode immediately before a byte offset; malformed endings consume exactly the final byte.
  utf8-last-before :: Bytes -> Nat -> Utf8Step
  utf8-last-before source end =
    if end > bytes-len source then DecodedStep utf8-rune-error 0 Utf8OutOfBounds
    else if end == 0 then DecodedStep utf8-rune-error 0 Utf8End
    else
      let limit = nat-to-i64 end in
      let start = last-start source (wrapping-sub-i64 limit 1) 3 in
      let packed = decode-raw source limit start in
      let width = packed-width packed in
      if packed-valid packed && eq-i64 (wrapping-add-i64 start width) limit then
        packed-step packed
      else DecodedStep utf8-rune-error 1 Utf8Invalid

  -- | Decode the final scalar or one final malformed byte; empty input has Utf8End status.
  utf8-last :: Bytes -> Utf8Step
  utf8-last source = utf8-last-before source (bytes-len source)

  -- | Skip complete 16-byte SIMD ASCII blocks and valid non-ASCII scalars until the first malformed byte or end.
  invalid-from :: Bytes -> I64 -> I64 -> I64
  invalid-from bs end at =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      if 16 <= end then
        let ne = nat-from-i64 end in
        if 16 <= ne then
          let lim = ne - 16 in
          let ni = nat-from-i64 at in
          if ni <= lim then
            let chunk = bytes-load-u128 bs ni in
            if eq-u32 (simd-u8x16-movemask chunk) 0 then
              invalid-from bs end (wrapping-add-i64 at 16)
            else invalid-scalar bs end at
          else invalid-from-eight bs end at
        else invalid-from-tail bs end at
      else invalid-from-eight bs end at
    else at

  -- | Try one 8-byte SWAR ASCII block on the short tail before scalar validation.
  invalid-from-eight :: Bytes -> I64 -> I64 -> I64
  invalid-from-eight bs end at =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      if 8 <= end then
        let ne = nat-from-i64 end in
        if 8 <= ne then
          let lim = ne - 8 in
          let ni = nat-from-i64 at in
          if ni <= lim then
            let word = bytes-load-le64 bs ni in
            if eq-u64 (bit-and-u64 word 9259542123273814144) 0 then
              invalid-from-tail bs end (wrapping-add-i64 at 8)
            else invalid-from-tail bs end at
          else invalid-from-tail bs end at
        else invalid-from-tail bs end at
      else invalid-from-tail bs end at
    else at

  -- | Validate remaining tail scalars one by one until the first malformed byte or end.
  invalid-from-tail :: Bytes -> I64 -> I64 -> I64
  invalid-from-tail bs end at =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      let packed = scan-raw bs end at in
      if scan-valid packed then invalid-from-tail bs end (wrapping-add-i64 at (scan-width packed))
      else at
    else at

  -- | Advance one valid scalar or stop exactly at the malformed byte.
  invalid-scalar :: Bytes -> I64 -> I64 -> I64
  invalid-scalar bs end at =
    let packed = scan-raw bs end at in
    if scan-valid packed then invalid-from bs end (wrapping-add-i64 at (scan-width packed)) else at

  -- | Locate the first malformed byte, preserving end as None and never copying input.
  utf8-first-invalid :: Bytes -> Option Nat
  utf8-first-invalid source =
    let limit = bytes-len-i64 source in
    let at = invalid-from source limit 0 in
    if 0 <= at && lt-i64 at limit then Some (nat-from-i64 at) else None

  -- | Whether every byte participates in a shortest-form scalar encoding; empty input is valid.
  utf8-valid :: Bytes -> Bool
  utf8-valid source = case utf8-first-invalid source of None -> True; Some at -> False

  -- | Count decoded scalars with 16-byte SIMD ASCII blocks, treating each malformed byte as one replacement scalar.
  count-from :: Bytes -> I64 -> I64 -> I64 -> I64
  count-from bs end at count =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      if 16 <= end then
        let ne = nat-from-i64 end in
        if 16 <= ne then
          let lim = ne - 16 in
          let ni = nat-from-i64 at in
          if ni <= lim then
            let chunk = bytes-load-u128 bs ni in
            if eq-u32 (simd-u8x16-movemask chunk) 0 then
              count-from bs end (wrapping-add-i64 at 16) (wrapping-add-i64 count 16)
            else count-scalar bs end at count
          else count-from-eight bs end at count
        else count-from-tail bs end at count
      else count-from-eight bs end at count
    else count

  -- | Try one 8-byte SWAR ASCII block on the short tail before scalar counting.
  count-from-eight :: Bytes -> I64 -> I64 -> I64 -> I64
  count-from-eight bs end at count =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      if 8 <= end then
        let ne = nat-from-i64 end in
        if 8 <= ne then
          let lim = ne - 8 in
          let ni = nat-from-i64 at in
          if ni <= lim then
            let word = bytes-load-le64 bs ni in
            if eq-u64 (bit-and-u64 word 9259542123273814144) 0 then
              count-from-tail bs end (wrapping-add-i64 at 8) (wrapping-add-i64 count 8)
            else count-from-tail bs end at count
          else count-from-tail bs end at count
        else count-from-tail bs end at count
      else count-from-tail bs end at count
    else count

  -- | Count remaining tail scalars one by one without allocating a Char or step object.
  count-from-tail :: Bytes -> I64 -> I64 -> I64 -> I64
  count-from-tail bs end at count =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      let packed = scan-raw bs end at in
      count-from-tail bs end (wrapping-add-i64 at (scan-width packed)) (wrapping-add-i64 count 1)
    else count

  -- | Count one exact decoding step without allocating a Char or step object.
  count-scalar :: Bytes -> I64 -> I64 -> I64 -> I64
  count-scalar bs end at count =
    let packed = scan-raw bs end at in
    count-from bs end (wrapping-add-i64 at (scan-width packed)) (wrapping-add-i64 count 1)

  -- | Count scalars with exact one-byte progress on all malformed input and 16-byte SIMD ASCII blocks.
  utf8-count :: Bytes -> Nat
  utf8-count source =
    let total = count-from source (bytes-len-i64 source) 0 0 in
    if 0 <= total then nat-from-i64 total else 0

  -- | Count decoded scalars in the half-open byte span [start,end), without copying.
  -- Bounds are absolute owner offsets. Return None if start > end or end exceeds
  -- buffer length; valid empty spans return Some 0. Each malformed or truncated
  -- byte counts as one replacement scalar, including a continuation at start.
  -- SIMD/SWAR ASCII blocks and exact scalar fringes never read outside the span.
  utf8-count-between :: Bytes -> Nat -> Nat -> Option Nat
  utf8-count-between source start end =
    if start <= end && end <= bytes-len source then
      let total = count-from source (nat-to-i64 end) (nat-to-i64 start) 0 in
      Some ((if 0 <= total then nat-from-i64 total else 0) :: Nat)
    else None

  -- | Whether a nonempty prefix already determines a decoding step, valid or malformed.
  -- A potentially valid but incomplete sequence is false; an already invalid prefix is true.
  utf8-full-rune :: Bytes -> Bool
  utf8-full-rune source =
    if bytes-len source > 0 then
      let packed = decode-raw source (bytes-len-i64 source) 0 in
      eq-u32 (bit-and-u32 packed 67108864) 0
    else False

  -- | Whether a numeric rune is a Unicode scalar; negatives, surrogates and values above U+10FFFF are false.
  utf8-valid-rune :: I32 -> Bool
  utf8-valid-rune cp = ge-i32 cp 0 && le-i32 cp 1114111 && (lt-i32 cp 55296 || gt-i32 cp 57343)

  -- | Return the exact encoded byte width, or None for an invalid numeric rune.
  utf8-rune-length :: I32 -> Option Nat
  utf8-rune-length cp = if utf8-valid-rune cp then Some (if lt-i32 cp 128 then 1 else if lt-i32 cp 2048 then 2 else if lt-i32 cp 65536 then 3 else 4) else None

  -- | Pack a scalar encoding in low-byte-first order, placing its width in bits 32..34.
  encode-word :: I32 -> U64
  encode-word cp =
    let scalar = ((if utf8-valid-rune cp then wrapping-i32-to-u32 cp else 65533) :: U32) in
    let one = lt-u32 scalar 128 in
    let two = lt-u32 scalar 2048 in
    let three = lt-u32 scalar 65536 in
    let b0 = bit-or-u32 (bit-and-u32 scalar 63) 128 in
    let s6 = wrapping-shr-u32 scalar 6 in
    let b1 = bit-or-u32 (bit-and-u32 s6 63) 128 in
    let s12 = wrapping-shr-u32 scalar 12 in
    let b2 = bit-or-u32 (bit-and-u32 s12 63) 128 in
    let s18 = wrapping-shr-u32 scalar 18 in
    let pair = bit-or-u32 (bit-or-u32 s6 192) (wrapping-shl-u32 b0 8) in
    let triple = bit-or-u32 (bit-or-u32 (bit-or-u32 s12 224) (wrapping-shl-u32 b1 8)) (wrapping-shl-u32 b0 16) in
    let quad = bit-or-u32 (bit-or-u32 (bit-or-u32 (bit-or-u32 s18 240) (wrapping-shl-u32 b2 8)) (wrapping-shl-u32 b1 16)) (wrapping-shl-u32 b0 24) in
    let bytes = if one then scalar else if two then pair else if three then triple else quad in
    let width = ((if one then 4294967296 else if two then 8589934592 else if three then 12884901888 else 17179869184) :: U64) in
    bit-or-u64 (u32-to-u64 bytes) width

  -- | Observe the encoding width from the packed scalar encoder.
  encoded-width :: U64 -> Nat
  encoded-width packed = u32-to-nat (wrapping-u64-to-u32 (wrapping-shr-u64 packed 32))

  -- | Fill one fully checked encoding span, preserving all bytes outside it.
  write-encoded :: using (at + width <= bytes-len out) => (out :: Bytes) -> (at :: Nat) -> (width :: Nat) -> U64 -> Unit
  write-encoded out at width packed = if width > 0 then
    let a = bytes-set-u8 out at (wrapping-u64-to-u8 packed) in
    if width > 1 then let b = bytes-set-u8 out (at + 1) (wrapping-u64-to-u8 (wrapping-shr-u64 packed 8)) in
      if width > 2 then let c = bytes-set-u8 out (at + 2) (wrapping-u64-to-u8 (wrapping-shr-u64 packed 16)) in
        if width > 3 then bytes-set-u8 out (at + 3) (wrapping-u64-to-u8 (wrapping-shr-u64 packed 24)) else ()
      else ()
    else ()
    else ()

  -- | Encode into an existing buffer, returning written width; insufficient capacity or an invalid offset writes nothing.
  utf8-encode-into :: Bytes -> Nat -> I32 -> Option Nat
  utf8-encode-into out at cp = let packed = encode-word cp in let width = encoded-width packed in
    if at + width <= bytes-len out then let written = write-encoded out at width packed in Some width else None

  -- | Encode a numeric rune into fresh bytes, replacing invalid scalar inputs with U+FFFD.
  utf8-encode-rune :: I32 -> Bytes
  utf8-encode-rune cp = let packed = encode-word cp in let width = encoded-width packed in
    let out = bytes-new width in let written = write-encoded out 0 width packed in out

  -- | Append one encoded numeric rune to a fresh copy of arbitrary source bytes.
  utf8-append-rune :: Bytes -> I32 -> Bytes
  utf8-append-rune source cp = let packed = encode-word cp in let width = encoded-width packed in
    let count = bytes-len source in let out = bytes-new (count + width) in
    let copied = bytes-copy-range out source 0 0 count in
    let written = write-encoded out count width packed in out

  -- | Advance across consecutive malformed decoding positions, each consuming one byte.
  invalid-end :: Bytes -> I64 -> I64 -> I64
  invalid-end bs end at =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      let packed = scan-raw bs end at in
      if scan-valid packed then at else invalid-end bs end (wrapping-add-i64 at 1)
    else at

  -- | Calculate exact fresh repair size from valid spans and grouped or individual malformed bytes.
  repair-size :: Bytes -> I64 -> I64 -> Nat -> Nat -> Bool -> Nat
  repair-size source limit at total replacement each =
    let bad = invalid-from source limit at in
    let delta = wrapping-sub-i64 bad at in
    let span = ((if 0 <= delta then nat-from-i64 delta else 0) :: Nat) in
    if lt-i64 bad limit then
      let end = if each then wrapping-add-i64 bad 1 else invalid-end source limit (wrapping-add-i64 bad 1) in
      repair-size source limit end (total + span + replacement) replacement each
    else total + span

  -- | Copy exact valid spans and arbitrary replacement bytes through checked bulk mutations.
  repair-copy :: Bytes -> Bytes -> Bytes -> I64 -> I64 -> Nat -> Bool -> Unit
  repair-copy source replacement out limit at cursor each =
    let bad = invalid-from source limit at in
    let begin = ((if 0 <= at then nat-from-i64 at else 0) :: Nat) in
    let delta = wrapping-sub-i64 bad at in
    let span = ((if 0 <= delta then nat-from-i64 delta else 0) :: Nat) in
    if begin + span <= bytes-len source && cursor + span <= bytes-len out then
      let copied = bytes-copy-range out source cursor begin span in
      if lt-i64 bad limit then
        let next = cursor + span in
        let count = bytes-len replacement in
        if next + count <= bytes-len out then
          let replaced = bytes-copy-range out replacement next 0 count in
          let end = if each then wrapping-add-i64 bad 1 else invalid-end source limit (wrapping-add-i64 bad 1) in
          repair-copy source replacement out limit end (next + count) each
        else ()
      else ()
    else ()

  -- | Build an unconditionally fresh repair result, preserving replacement/source aliases as read-only inputs.
  repair-with :: Bytes -> Bytes -> Bool -> Bytes
  repair-with source replacement each =
    let limit = bytes-len-i64 source in
    let count = repair-size source limit 0 0 (bytes-len replacement) each in
    let out = bytes-new count in
    let copied = repair-copy source replacement out limit 0 0 each in
    out

  -- | Replace each maximal run of malformed bytes with one arbitrary byte replacement; output is always fresh.
  utf8-repair :: Bytes -> Bytes -> Bytes
  utf8-repair source replacement = repair-with source replacement False

  -- | Replace every malformed byte separately, retaining exact one-byte decoding progress; output is always fresh.
  utf8-repair-each :: Bytes -> Bytes -> Bytes
  utf8-repair-each source replacement = repair-with source replacement True

  -- | Repair every malformed byte as U+FFFD, producing fresh valid UTF-8 bytes.
  utf8-replace-invalid :: Bytes -> Bytes
  utf8-replace-invalid source = let replacement = utf8-encode-rune 65533 in utf8-repair-each source replacement

  -- | Construct a valid decoding observation for one scalar, deriving its unique encoded width.
  -- Callers cannot provide inconsistent status or width metadata.
  utf8-scalar-step :: Char -> Utf8Step
  utf8-scalar-step scalar = let code = char-to-u32 scalar in
    let width = if lt-u32 code 128 then (1 :: Nat) else if lt-u32 code 2048 then 2 else if lt-u32 code 65536 then 3 else 4 in
    DecodedStep scalar width Utf8Valid

  -- | Construct the empty-suffix observation without allocating or exposing a byte buffer.
  utf8-end-step :: Unit -> Utf8Step
  utf8-end-step unit = DecodedStep utf8-rune-error 0 Utf8End
