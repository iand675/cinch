-- Data.Array.ND: rank-polymorphic N-dimensional shape-indexed arrays powered
-- by Cinch type families and data families.
--
-- Instead of hardcoding View1 / View2 / View3 and duplicating array operations
-- per rank, shapes are represented as type-level dimension lists (`Z` for 0D
-- scalars, `Dim n sh` for prepending an axis of extent `n`). Shape algebra is
-- computed by closed type families (`Rank`, `Size`, `HeadDim`, `LastDim`,
-- `TailShape`, `InitShape`, `AppendShape`, `SnocShape`, `ReverseShape`,
-- `Transpose2`, `ReplaceLast`), element metadata by an open type family
-- (`AccumType`), and runtime shape witnesses & bounds-checked N-D coordinates
-- by open data families (`ShapeWitness sh`, `NDCoord sh`).
module Data.Array.ND where
  import Data.Core
  import Data.Array
  import Data.Array.Packed
  import Data.Tensor
  import Data.Array.Compute
  import Data.Nat
  import Data.Int
  import Data.Bool
  import Data.Machine
  import Relation.Ord
  import Algebra.Arithmetic

  export Z, MkZ, Dim, MkDim
  export Shape0, Shape1, Shape2, Shape3, Shape4
  export Rank, Size, HeadDim, LastDim, TailShape, InitShape
  export AppendShape, SnocShape, ReverseShape, Transpose2, ReplaceLast
  export AccumType
  export ShapeWitness, SWZ, SWDim
  export NDCoord, CoordZ, CoordCons
  export NDView
  export shape-rank, shape-size, shape-dims, shape-strides, shape-last-dim
  export shape-tail, shape-init, shape-append, shape-snoc, shape-reverse
  export shape-transpose2, shape-replace-last
  export nd-shape, nd-data, nd-offset, nd-strides, nd-rank, nd-size
  export nd-is-contiguous, nd-from-array, nd-from-tensor
  export nd-tabulate-f32, nd-tabulate-i32, nd-tabulate-u8
  export nd-linear-index, nd-get
  export nd-reshape, nd-transpose, nd-transpose-all, nd-slice-outer
  export nd-pack-f32, nd-pack-i32, nd-pack-u8
  export nd-map-f32, nd-map-i32, nd-zip-add-f32, nd-zip-mul-f32
  export nd-dot-f32, nd-dot-i32
  export nd-reduce-all-f32, nd-reduce-all-i32
  export nd-reduce-last-f32, nd-reduce-last-i32
  export nd-stencil2d-batch-u8, nd-histogram-last-u8

  -- ---------------------------------------------------------------------------
  -- Type-level N-dimensional shapes
  -- ---------------------------------------------------------------------------

  data Z where
    MkZ :: Z

  data Dim (n :: Nat) sh where
    MkDim :: Dim n sh

  type family Shape0 = Z
  type family Shape1 (n :: Nat) = Dim n Z
  type family Shape2 (m :: Nat) (n :: Nat) = Dim m (Dim n Z)
  type family Shape3 (f :: Nat) (h :: Nat) (w :: Nat) = Dim f (Dim h (Dim w Z))
  type family Shape4 (b :: Nat) (c :: Nat) (h :: Nat) (w :: Nat) = Dim b (Dim c (Dim h (Dim w Z)))

  -- ---------------------------------------------------------------------------
  -- Closed type families: N-dimensional shape algebra
  -- ---------------------------------------------------------------------------

  type family Rank sh :: Nat where
    Rank Z = 0
    Rank (Dim _ rest) = 1 + Rank rest

  type family Size sh :: Nat where
    Size Z = 1
    Size (Dim n rest) = n * Size rest

  type family HeadDim sh :: Nat where
    HeadDim Z = 1
    HeadDim (Dim n _) = n

  type family LastDim sh :: Nat where
    LastDim Z = 1
    LastDim (Dim n Z) = n
    LastDim (Dim _ rest) = LastDim rest

  type family TailShape sh where
    TailShape Z = Z
    TailShape (Dim _ rest) = rest

  type family InitShape sh where
    InitShape Z = Z
    InitShape (Dim _ Z) = Z
    InitShape (Dim n rest) = Dim n (InitShape rest)

  type family AppendShape s1 s2 where
    AppendShape Z s2 = s2
    AppendShape (Dim n rest) s2 = Dim n (AppendShape rest s2)

  type family SnocShape sh (k :: Nat) where
    SnocShape Z k = Dim k Z
    SnocShape (Dim n rest) k = Dim n (SnocShape rest k)

  type family ReverseShape sh where
    ReverseShape Z = Z
    ReverseShape (Dim n rest) = SnocShape (ReverseShape rest) n

  type family Transpose2 sh where
    Transpose2 (Dim m (Dim n rest)) = Dim n (Dim m rest)
    Transpose2 sh = sh

  type family ReplaceLast sh (k :: Nat) where
    ReplaceLast Z k = Dim k Z
    ReplaceLast (Dim _ Z) k = Dim k Z
    ReplaceLast (Dim n rest) k = Dim n (ReplaceLast rest k)

  -- Open type family: extensible accumulator type per element type.
  type family AccumType a :: Type
  type instance AccumType F32 = F32
  type instance AccumType F64 = F64
  type instance AccumType I32 = I32
  type instance AccumType U8 = U32
  type instance AccumType U32 = U32

  -- ---------------------------------------------------------------------------
  -- Open data families: runtime shape witnesses & bounds-checked N-D indices
  -- ---------------------------------------------------------------------------

  data family ShapeWitness sh

  data instance ShapeWitness Z where
    SWZ :: ShapeWitness Z

  data instance ShapeWitness (Dim n rest) where
    SWDim :: (d :: Nat) -> ShapeWitness rest -> ShapeWitness (Dim d rest)

  data family NDCoord sh

  data instance NDCoord Z where
    CoordZ :: NDCoord Z

  data instance NDCoord (Dim n rest) where
    CoordCons :: forall (n :: Nat) rest. Fin n -> NDCoord rest -> NDCoord (Dim n rest)

  -- One unified strided N-dimensional view for ALL ranks N >= 0.
  data NDView sh a where
    MkNDView :: Array a -> ShapeWitness sh -> Nat -> List Nat -> NDView sh a

  -- ---------------------------------------------------------------------------
  -- Rank-polymorphic shape witness operations
  -- ---------------------------------------------------------------------------

  shape-rank :: forall sh. ShapeWitness sh -> Nat
  shape-rank w = case w of
    SWZ -> 0
    SWDim _ rest -> 1 + shape-rank rest

  shape-size :: forall sh. ShapeWitness sh -> Nat
  shape-size w = case w of
    SWZ -> 1
    SWDim d rest -> d * shape-size rest

  shape-dims :: forall sh. ShapeWitness sh -> List Nat
  shape-dims w = case w of
    SWZ -> Nil
    SWDim d rest -> Cons d (shape-dims rest)

  shape-strides :: forall sh. ShapeWitness sh -> List Nat
  shape-strides w = case w of
    SWZ -> Nil
    SWDim _ rest -> Cons (shape-size rest) (shape-strides rest)

  shape-last-dim :: forall sh. ShapeWitness sh -> Nat
  shape-last-dim w = case w of
    SWZ -> 1
    SWDim d rest -> case rest of
      SWZ -> d
      SWDim d2 rest2 -> shape-last-dim (SWDim d2 rest2)

  shape-tail :: forall sh. ShapeWitness sh -> ShapeWitness (TailShape sh)
  shape-tail w = case w of
    SWZ -> SWZ
    SWDim _ rest -> rest

  shape-init :: forall sh. ShapeWitness sh -> ShapeWitness (InitShape sh)
  shape-init w = case w of
    SWZ -> SWZ
    SWDim d rest -> case rest of
      SWZ -> SWZ
      SWDim d2 rest2 -> SWDim d (shape-init (SWDim d2 rest2))

  shape-append :: forall s1 s2. ShapeWitness s1 -> ShapeWitness s2 -> ShapeWitness (AppendShape s1 s2)
  shape-append w1 w2 = case w1 of
    SWZ -> w2
    SWDim d rest -> SWDim d (shape-append rest w2)

  shape-snoc :: forall sh. ShapeWitness sh -> (k :: Nat) -> ShapeWitness (SnocShape sh k)
  shape-snoc w k = case w of
    SWZ -> SWDim k SWZ
    SWDim d rest -> SWDim d (shape-snoc rest k)

  shape-reverse :: forall sh. ShapeWitness sh -> ShapeWitness (ReverseShape sh)
  shape-reverse w = case w of
    SWZ -> SWZ
    SWDim d rest -> shape-snoc (shape-reverse rest) d

  shape-transpose2 :: forall sh. ShapeWitness sh -> ShapeWitness (Transpose2 sh)
  shape-transpose2 w = case w of
    SWZ -> SWZ
    SWDim d1 rest1 -> case rest1 of
      SWZ -> SWDim d1 SWZ
      SWDim d2 rest2 -> SWDim d2 (SWDim d1 rest2)

  shape-replace-last :: forall sh. ShapeWitness sh -> (k :: Nat) -> ShapeWitness (ReplaceLast sh k)
  shape-replace-last w k = case w of
    SWZ -> SWDim k SWZ
    SWDim d rest -> case rest of
      SWZ -> SWDim k SWZ
      SWDim d2 rest2 -> SWDim d (shape-replace-last (SWDim d2 rest2) k)

  -- ---------------------------------------------------------------------------
  -- Internal list helpers for arbitrary-rank stride & tensor validation
  -- ---------------------------------------------------------------------------

  list-nat-eq :: List Nat -> List Nat -> Bool
  list-nat-eq xs ys = case xs of
    Nil -> case ys of
      Nil -> True
      Cons _ _ -> False
    Cons a at -> case ys of
      Nil -> False
      Cons b bt -> a == b && list-nat-eq at bt

  list-nat-rev-go :: List Nat -> List Nat -> List Nat
  list-nat-rev-go xs acc = case xs of
    Nil -> acc
    Cons a rest -> list-nat-rev-go rest (Cons a acc)

  list-nat-rev :: List Nat -> List Nat
  list-nat-rev xs = list-nat-rev-go xs Nil

  list-nat-swap2 :: List Nat -> List Nat
  list-nat-swap2 xs = case xs of
    Nil -> Nil
    Cons a rest -> case rest of
      Nil -> Cons a Nil
      Cons b tail -> Cons b (Cons a tail)

  check-tensor-dims :: Array Nat -> Nat -> List Nat -> Bool
  check-tensor-dims arr idx dims = case dims of
    Nil -> idx == array-length arr
    Cons d rest -> case array-get arr idx of
      None -> False
      Some actual -> actual == d && check-tensor-dims arr (idx + 1) rest

  -- Convert flat row-major index `k` into strided source offset for arbitrary rank N.
  flat-to-strided-go :: Nat -> List Nat -> List Nat -> Nat -> Nat
  flat-to-strided-go rem-k row-strides view-strides acc = case row-strides of
    Nil -> acc
    Cons rs rrest -> case view-strides of
      Nil -> acc
      Cons vs vrest ->
        case checked-div rem-k rs of
          None -> acc
          Some coord ->
            case checked-rem rem-k rs of
              None -> acc
              Some next-rem -> flat-to-strided-go next-rem rrest vrest (acc + coord * vs)

  -- ---------------------------------------------------------------------------
  -- Accessors & checked constructors (ANY rank N)
  -- ---------------------------------------------------------------------------

  nd-shape :: forall sh a. NDView sh a -> ShapeWitness sh
  nd-shape v = case v of MkNDView _ w _ _ -> w

  nd-data :: forall sh a. NDView sh a -> Array a
  nd-data v = case v of MkNDView d _ _ _ -> d

  nd-offset :: forall sh a. NDView sh a -> Nat
  nd-offset v = case v of MkNDView _ _ off _ -> off

  nd-strides :: forall sh a. NDView sh a -> List Nat
  nd-strides v = case v of MkNDView _ _ _ st -> st

  nd-rank :: forall sh a. NDView sh a -> Nat
  nd-rank v = shape-rank (nd-shape v)

  nd-size :: forall sh a. NDView sh a -> Nat
  nd-size v = shape-size (nd-shape v)

  nd-is-contiguous :: forall sh a. NDView sh a -> Bool
  nd-is-contiguous v = case v of
    MkNDView d w off st ->
      off == 0 && array-length d == shape-size w && list-nat-eq st (shape-strides w)

  nd-from-array :: forall sh a. ShapeWitness sh -> Array a -> Option (NDView sh a)
  nd-from-array w buf =
    if array-length buf == shape-size w
    then Some (MkNDView buf w 0 (shape-strides w))
    else None

  -- Dynamic `Tensor a` entry point -> statically N-D shape-indexed `NDView sh a`.
  nd-from-tensor :: forall sh a. ShapeWitness sh -> Tensor a -> Option (NDView sh a)
  nd-from-tensor w t =
    let s = tensor-shape t
    in if check-tensor-dims s 0 (shape-dims w)
       then Some (MkNDView (tensor-data t) w 0 (shape-strides w))
       else None

  nd-tabulate-f32 :: forall sh. ShapeWitness sh -> (Nat -> F32) -> NDView sh F32
  nd-tabulate-f32 w f = MkNDView (array-tabulate-f32 (shape-size w) f) w 0 (shape-strides w)

  nd-tabulate-i32 :: forall sh. ShapeWitness sh -> (Nat -> I32) -> NDView sh I32
  nd-tabulate-i32 w f = MkNDView (array-tabulate-i32 (shape-size w) f) w 0 (shape-strides w)

  nd-tabulate-u8 :: forall sh. ShapeWitness sh -> (Nat -> U8) -> NDView sh U8
  nd-tabulate-u8 w f = MkNDView (array-tabulate-u8 (shape-size w) f) w 0 (shape-strides w)

  -- ---------------------------------------------------------------------------
  -- Bounds-checked N-dimensional indexing (Fin d_i at every axis)
  -- ---------------------------------------------------------------------------

  nd-linear-index :: forall sh. ShapeWitness sh -> List Nat -> NDCoord sh -> Nat
  nd-linear-index w strides coord = case w of
    SWZ -> case coord of
      CoordZ -> 0
    SWDim _ rest -> case coord of
      CoordCons idx rest-c -> case idx of
        Fin i _ -> case strides of
          Nil -> 0
          Cons s srest -> i * s + nd-linear-index rest srest rest-c

  nd-get :: forall sh a. NDView sh a -> NDCoord sh -> Option a
  nd-get v coord = case v of
    MkNDView d w off st -> array-get d (off + nd-linear-index w st coord)

  -- ---------------------------------------------------------------------------
  -- Zero-copy N-dimensional view transformations (ANY rank N)
  -- ---------------------------------------------------------------------------

  -- Statically verifies `Size sh1 == Size sh2` at compile time via the `Size`
  -- type family! Returns `Some` without copying when contiguous; `None` when
  -- strided/transposed until explicitly packed via `nd-pack-*`.
  nd-reshape :: forall sh1 sh2 a. using (Size sh1 == Size sh2) => NDView sh1 a -> ShapeWitness sh2 -> Option (NDView sh2 a)
  nd-reshape v w2 = case v of
    MkNDView d w1 off st ->
      if nd-is-contiguous v && shape-size w1 == shape-size w2
      then Some (MkNDView d w2 0 (shape-strides w2))
      else None

  -- Zero-copy swap of the two outermost axes for ANY rank >= 2.
  nd-transpose :: forall (m :: Nat) (n :: Nat) rest a. NDView (Dim m (Dim n rest)) a -> NDView (Transpose2 (Dim m (Dim n rest))) a
  nd-transpose v = case v of
    MkNDView d w off st -> MkNDView d (shape-transpose2 w) off (list-nat-swap2 st)

  -- Zero-copy reversal of ALL axes for ANY rank N >= 0.
  nd-transpose-all :: forall sh a. NDView sh a -> NDView (ReverseShape sh) a
  nd-transpose-all v = case v of
    MkNDView d w off st -> MkNDView d (shape-reverse w) off (list-nat-rev st)

  -- Zero-copy outermost axis slice with static `Fin n` bounds witness (rank N -> N-1).
  nd-slice-outer :: forall (n :: Nat) rest a. NDView (Dim n rest) a -> Fin n -> NDView (TailShape (Dim n rest)) a
  nd-slice-outer v idx = case v of
    MkNDView d w off st -> case idx of
      Fin i _ -> case st of
        Nil -> MkNDView d (shape-tail w) off Nil
        Cons s0 srest -> MkNDView d (shape-tail w) (off + i * s0) srest

  -- Pack an arbitrary-rank strided/transposed view into contiguous row-major storage.
  nd-pack-f32 :: forall sh. NDView sh F32 -> NDView sh F32
  nd-pack-f32 v =
    if nd-is-contiguous v then v
    else case v of
      MkNDView d w off st ->
        let rstrides = shape-strides w
        in let packed = array-tabulate-f32 (shape-size w) (\k ->
             case array-get d (off + flat-to-strided-go k rstrides st 0) of
               None -> 0.0
               Some x -> x)
        in MkNDView packed w 0 rstrides

  nd-pack-i32 :: forall sh. NDView sh I32 -> NDView sh I32
  nd-pack-i32 v =
    if nd-is-contiguous v then v
    else case v of
      MkNDView d w off st ->
        let rstrides = shape-strides w
        in let packed = array-tabulate-i32 (shape-size w) (\k ->
             case array-get d (off + flat-to-strided-go k rstrides st 0) of
               None -> 0
               Some x -> x)
        in MkNDView packed w 0 rstrides

  nd-pack-u8 :: forall sh. NDView sh U8 -> NDView sh U8
  nd-pack-u8 v =
    if nd-is-contiguous v then v
    else case v of
      MkNDView d w off st ->
        let rstrides = shape-strides w
        in let packed = array-tabulate-u8 (shape-size w) (\k ->
             case array-get d (off + flat-to-strided-go k rstrides st 0) of
               None -> 0
               Some x -> x)
        in MkNDView packed w 0 rstrides

  -- ---------------------------------------------------------------------------
  -- Rank-polymorphic parallel compute operations (ANY rank N)
  -- ---------------------------------------------------------------------------

  nd-map-f32 :: forall sh. (F32 -> F32) -> NDView sh F32 -> NDView sh F32
  nd-map-f32 f v =
    let p = nd-pack-f32 v
    in MkNDView (array-map-f32 f (nd-data p)) (nd-shape p) 0 (nd-strides p)

  nd-map-i32 :: forall sh. (I32 -> I32) -> NDView sh I32 -> NDView sh I32
  nd-map-i32 f v =
    let p = nd-pack-i32 v
    in MkNDView (array-map-i32 f (nd-data p)) (nd-shape p) 0 (nd-strides p)

  nd-zip-add-f32 :: forall sh. NDView sh F32 -> NDView sh F32 -> NDView sh F32
  nd-zip-add-f32 a b =
    let pa = nd-pack-f32 a
    in let pb = nd-pack-f32 b
    in case array-zip-binop-f32 (nd-data pa) (nd-data pb) 0 of
      None -> pa
      Some out -> MkNDView out (nd-shape pa) 0 (nd-strides pa)

  nd-zip-mul-f32 :: forall sh. NDView sh F32 -> NDView sh F32 -> NDView sh F32
  nd-zip-mul-f32 a b =
    let pa = nd-pack-f32 a
    in let pb = nd-pack-f32 b
    in case array-zip-binop-f32 (nd-data pa) (nd-data pb) 2 of
      None -> pa
      Some out -> MkNDView out (nd-shape pa) 0 (nd-strides pa)

  -- Frobenius inner product over ANY matching N-dimensional shape `sh`.
  -- Fused by Typed Array IR into a single zero-allocation dot pass.
  nd-dot-f32 :: forall sh. NDView sh F32 -> NDView sh F32 -> FloatMode -> F32
  nd-dot-f32 a b mode =
    let pa = nd-pack-f32 a
    in let pb = nd-pack-f32 b
    in case array-zip-binop-f32 (nd-data pa) (nd-data pb) 2 of
      None -> 0.0
      Some prod -> array-reduce-f32 prod (float-mode-code mode)

  nd-dot-i32 :: forall sh. NDView sh I32 -> NDView sh I32 -> I32
  nd-dot-i32 a b =
    let pa = nd-pack-i32 a
    in let pb = nd-pack-i32 b
    in case array-zip-binop-i32 (nd-data pa) (nd-data pb) 2 of
      None -> 0
      Some prod -> array-reduce-i32 prod 0

  nd-reduce-all-f32 :: forall sh. NDView sh F32 -> FloatMode -> F32
  nd-reduce-all-f32 v mode = array-reduce-f32 (nd-data (nd-pack-f32 v)) (float-mode-code mode)

  nd-reduce-all-i32 :: forall sh. NDView sh I32 -> IntReducer -> I32
  nd-reduce-all-i32 v red = array-reduce-i32 (nd-data (nd-pack-i32 v)) (int-reducer-code red)

  -- Reduce along the innermost axis of ANY rank N array:
  --   Shape1 n         -> Shape0 (Z)
  --   Shape2 m n       -> Shape1 m
  --   Shape3 f h w     -> Shape2 f h
  --   Shape4 b c h w   -> Shape3 b c h
  nd-reduce-last-f32 :: forall sh. NDView sh F32 -> FloatMode -> NDView (InitShape sh) F32
  nd-reduce-last-f32 v mode =
    let p = nd-pack-f32 v
    in let w = nd-shape p
    in let out-w = shape-init w
    in let outer = shape-size out-w
    in let inner = shape-last-dim w
    in case array-row-reduce-f32 (nd-data p) outer inner (float-mode-code mode) of
      None -> MkNDView (array-tabulate-f32 outer (\_ -> 0.0)) out-w 0 (shape-strides out-w)
      Some out -> MkNDView out out-w 0 (shape-strides out-w)

  nd-reduce-last-i32 :: forall sh. NDView sh I32 -> IntReducer -> NDView (InitShape sh) I32
  nd-reduce-last-i32 v red =
    let p = nd-pack-i32 v
    in let w = nd-shape p
    in let out-w = shape-init w
    in let outer = shape-size out-w
    in let inner = shape-last-dim w
    in case array-row-reduce-i32 (nd-data p) outer inner (int-reducer-code red) of
      None -> MkNDView (array-tabulate-i32 outer (\_ -> 0)) out-w 0 (shape-strides out-w)
      Some out -> MkNDView out out-w 0 (shape-strides out-w)

  -- Helper to extract spatial (h, w) from a `Dim h (Dim w Z)` suffix given batch prefix.
  shape-split-suffix-hw :: forall batch (h :: Nat) (w :: Nat). ShapeWitness batch -> ShapeWitness (AppendShape batch (Dim h (Dim w Z))) -> (Nat, Nat)
  shape-split-suffix-hw bw full = case bw of
    SWZ -> case full of
      SWDim dh rest1 -> case rest1 of
        SWDim dw rest2 -> (dh, dw)
    SWDim _ brest -> case full of
      SWDim _ frest -> shape-split-suffix-hw brest frest

  -- Rank-polymorphic batched 2D stencil: works for 2D single image (`batch = Z`),
  -- 3D video (`batch = Dim f Z`), 4D multi-camera video (`batch = Dim c (Dim f Z)`), etc.
  nd-stencil2d-batch-u8 :: forall batch (h :: Nat) (w :: Nat). ShapeWitness batch -> NDView (AppendShape batch (Dim h (Dim w Z))) U8 -> Array I32 -> I32 -> EdgePolicy -> Nat -> Option (NDView (AppendShape batch (Dim h (Dim w Z))) U8)
  nd-stencil2d-batch-u8 bw v weights denom policy steps =
    let p = nd-pack-u8 v
    in let frames = shape-size bw
    in let hw = shape-split-suffix-hw bw (nd-shape p)
    in case hw of
      (dh, dw) -> case array-stencil2d-u8 (nd-data p) frames dh dw weights denom (edge-policy-code policy) steps of
        None -> None
        Some out -> Some (MkNDView out (nd-shape p) 0 (nd-strides p))

  -- Rank-polymorphic histogram over the innermost axis of ANY N-D `U8` array:
  --   Shape1 w         -> Shape1 bins
  --   Shape2 h w       -> Shape2 h bins
  --   Shape3 f h w     -> Shape3 f h bins
  --   Shape4 b c h w   -> Shape4 b c h bins
  nd-histogram-last-u8 :: forall sh. NDView sh U8 -> (bins :: Nat) -> Option (NDView (ReplaceLast sh bins) U32)
  nd-histogram-last-u8 v bins =
    let p = nd-pack-u8 v
    in let w = nd-shape p
    in let out-w = shape-replace-last w bins
    in let outer = shape-size (shape-init w)
    in let inner = shape-last-dim w
    in case array-histogram-batch-u8 (nd-data p) outer 1 inner bins of
      None -> None
      Some out -> Some (MkNDView out out-w 0 (shape-strides out-w))
