-- | Complex numbers over the binary64 scalar (`F64`) with full elementary,
-- trigonometric, hyperbolic, inverse, polar and classification operations.
--
-- The carrier is fixed to `F64` (`Data.Machine`'s binary64 scalar): both parts
-- are machine floats, so mixed real/complex arithmetic is refused (`from-real`,
-- `real-part` and `imag-part` are the crossings). The `MkComplex` constructor
-- stays module-private; `complex` is the smart constructor.
--
-- Special-value handling conforms to C99 Annex G (IEC 60559 complex arithmetic):
-- signed zeros are preserved, branch cuts match standard principal values,
-- division uses Smith's scaling algorithm with infinity/zero recovery, `abs`
-- delegates to `hypot-f64`, `sqrt` rescales to avoid intermediate overflow or
-- underflow, and `tan`/`cot` use Cody-Waite and Payne-Hanek range reduction
-- with Taylor series evaluation near poles.
--
-- Class instances (`Eq`, `Add`, `Sub`, `Mul`, `Neg`) live with the type; `Eq`
-- is componentwise IEEE equality via `feq-f64` and `Complex` deliberately has
-- no `Ord` or `Div` instance.
module Data.Complex where

  import Algebra.Arithmetic
  import Relation.Eq
  import Data.Machine
  import Data.Wide
  import Data.String
  import Data.Float

  export Complex, complex, real-part, imag-part, from-real
  export add, sub, mul, div, neg, eq, to-string
  export conjugate, conj, abs, arg, phase, polar, rect, atan-approx
  export is-nan, is-inf, complex-nan, complex-inf
  export exp, log, log10, pow, sqrt
  export sin, cos, tan, cot, sinh, cosh, tanh
  export asin, acos, atan, asinh, acosh, atanh

  -- | A complex number with binary64 real and imaginary parts.
  data Complex where
    -- | Construct a complex value from real and imaginary parts.
    MkComplex :: F64 -> F64 -> Complex

  -- | Construct a complex number from its real and imaginary parts.
  complex :: F64 -> F64 -> Complex
  complex r i = MkComplex r i

  -- | The real part of a complex number.
  real-part :: Complex -> F64
  real-part z = case z of
    MkComplex r i -> r

  -- | The imaginary part of a complex number.
  imag-part :: Complex -> F64
  imag-part z = case z of
    MkComplex r i -> i

  -- | Lift a real `F64` into `Complex` with zero imaginary part.
  from-real :: F64 -> Complex
  from-real r = complex r 0

  -- | One half as a binary64 constant.
  half-f64 :: F64
  half-f64 = f64-from-bits 0x3FE0000000000000

  -- | One quarter as a binary64 constant.
  quarter-f64 :: F64
  quarter-f64 = f64-from-bits 0x3FD0000000000000

  -- | Half of pi (`pi / 2`).
  half-pi :: F64
  half-pi = div-f64 pi-f64 2

  -- | Quarter of pi (`pi / 4`).
  quarter-pi :: F64
  quarter-pi = div-f64 pi-f64 4

  -- | `2^54`, used to rescale small inputs inside `sqrt`.
  sqrt-scale-up :: F64
  sqrt-scale-up = f64-from-bits 0x4350000000000000

  -- | `2^-27`, the inverse square root of `2^54`.
  sqrt-scale-down :: F64
  sqrt-scale-down = f64-from-bits 0x3E40000000000000

  -- | `2^30`, threshold above which `reduce-pi` switches to Payne-Hanek reduction.
  reduce-pi-threshold :: F64
  reduce-pi-threshold = f64-from-bits 0x41D0000000000000

  -- | `2^-53`, machine epsilon for `tan-series` termination.
  machep-f64 :: F64
  machep-f64 = f64-from-bits 0x3CA0000000000000

  -- | Leading part of extended-precision pi for Cody-Waite reduction.
  cw-pi1 :: F64
  cw-pi1 = f64-from-bits 0x400921FB40000000

  -- | Middle part of extended-precision pi for Cody-Waite reduction.
  cw-pi2 :: F64
  cw-pi2 = f64-from-bits 0x3E84442D00000000

  -- | Trailing part of extended-precision pi for Cody-Waite reduction.
  cw-pi3 :: F64
  cw-pi3 = f64-from-bits 0x3D08469898CC5170

  -- | Complex infinity `(+Inf, +Inf)`.
  complex-inf :: Complex
  complex-inf = let inf = inf-f64 1 in complex inf inf

  -- | Complex not-a-number `(NaN, NaN)`.
  complex-nan :: Complex
  complex-nan = complex nan-f64 nan-f64

  -- | Report whether either part is an infinity.
  is-inf :: Complex -> Bool
  is-inf z = is-inf-f64 (real-part z) 0 || is-inf-f64 (imag-part z) 0

  -- | Report whether either part is NaN and neither part is an infinity.
  is-nan :: Complex -> Bool
  is-nan z =
    let r = real-part z in
    let i = imag-part z in
    if is-inf-f64 r 0 || is-inf-f64 i 0 then False
    else is-nan-f64 r || is-nan-f64 i

  -- | Componentwise addition `(a + bi) + (c + di)`.
  add :: Complex -> Complex -> Complex
  add x y =
    complex (add-f64 (real-part x) (real-part y)) (add-f64 (imag-part x) (imag-part y))

  -- | Componentwise subtraction `(a + bi) - (c + di)`.
  sub :: Complex -> Complex -> Complex
  sub x y =
    complex (sub-f64 (real-part x) (real-part y)) (sub-f64 (imag-part x) (imag-part y))

  -- | Complex multiplication `(a + bi)(c + di) = (ac - bd) + (ad + bc)i`.
  mul :: Complex -> Complex -> Complex
  mul x y =
    let a = real-part x in
    let b = imag-part x in
    let c = real-part y in
    let d = imag-part y in
    complex (sub-f64 (mul-f64 a c) (mul-f64 b d)) (add-f64 (mul-f64 a d) (mul-f64 b c))

  -- | Map an infinity to signed `1` and any other value to signed `0`.
  inf-to-one :: F64 -> F64
  inf-to-one f = copysign-f64 (if is-inf-f64 f 0 then 1 else 0) f

  -- | Smith's Algorithm 116 core ratio step for complex division.
  div-smith :: F64 -> F64 -> F64 -> F64 -> (F64, F64)
  div-smith a b c d =
    if fge-f64 (abs-f64 c) (abs-f64 d) then
      let ratio = div-f64 d c in
      let denom = add-f64 c (mul-f64 ratio d) in
      (div-f64 (add-f64 a (mul-f64 b ratio)) denom, div-f64 (sub-f64 b (mul-f64 a ratio)) denom)
    else
      let ratio = div-f64 c d in
      let denom = add-f64 d (mul-f64 ratio c) in
      (div-f64 (add-f64 (mul-f64 a ratio) b) denom, div-f64 (sub-f64 (mul-f64 b ratio) a) denom)

  -- | Overflow-safe complex division using Smith's scaling algorithm with C99
  -- Annex G.5.1 infinity and zero recovery.
  div :: Complex -> Complex -> Complex
  div x y =
    let a = real-part x in
    let b = imag-part x in
    let c = real-part y in
    let d = imag-part y in
    case div-smith a b c d of
      (e, f) ->
        if is-nan-f64 e && is-nan-f64 f then
          if feq-f64 c 0 && feq-f64 d 0 && (not (is-nan-f64 a) || not (is-nan-f64 b)) then
            let s = copysign-f64 (inf-f64 1) c in
            complex (mul-f64 s a) (mul-f64 s b)
          else if (is-inf-f64 a 0 || is-inf-f64 b 0) && is-finite-f64 c && is-finite-f64 d then
            let a1 = inf-to-one a in
            let b1 = inf-to-one b in
            let inf = inf-f64 1 in
            complex
              (mul-f64 inf (add-f64 (mul-f64 a1 c) (mul-f64 b1 d)))
              (mul-f64 inf (sub-f64 (mul-f64 b1 c) (mul-f64 a1 d)))
          else if (is-inf-f64 c 0 || is-inf-f64 d 0) && is-finite-f64 a && is-finite-f64 b then
            let c1 = inf-to-one c in
            let d1 = inf-to-one d in
            complex
              (mul-f64 0 (add-f64 (mul-f64 a c1) (mul-f64 b d1)))
              (mul-f64 0 (sub-f64 (mul-f64 b c1) (mul-f64 a d1)))
          else
            complex e f
        else
          complex e f

  -- | Componentwise additive inverse `-(a + bi) = -a - bi`.
  neg :: Complex -> Complex
  neg z = complex (neg-f64 (real-part z)) (neg-f64 (imag-part z))

  -- | The complex conjugate `a - bi` (reflection across the real axis).
  conjugate :: Complex -> Complex
  conjugate z = complex (real-part z) (neg-f64 (imag-part z))

  -- | The complex conjugate `a - bi` (alias of `conjugate`).
  conj :: Complex -> Complex
  conj z = conjugate z

  -- | The modulus `|a + bi|`, computed overflow- and underflow-safely via `hypot-f64`.
  abs :: Complex -> F64
  abs z = hypot-f64 (real-part z) (imag-part z)

  -- | Structural equality: componentwise IEEE equality via `feq-f64`.
  eq :: Complex -> Complex -> Bool
  eq x y = feq-f64 (real-part x) (real-part y) && feq-f64 (imag-part x) (imag-part y)

  -- | The phase (argument) of a complex number in `[-pi, pi]`, computed via `atan2-f64`.
  phase :: Complex -> F64
  phase z = atan2-f64 (imag-part z) (real-part z)

  -- | The four-quadrant argument of a complex number in `[-pi, pi]`.
  arg :: Complex -> F64
  arg z = phase z

  -- | Polar representation `(r, theta)` such that `z = r * e^(i * theta)` with `theta` in `[-pi, pi]`.
  polar :: Complex -> (F64, F64)
  polar z = (abs z, phase z)

  -- | Construct a complex number from polar coordinates `(r, theta)`.
  rect :: F64 -> F64 -> Complex
  rect r theta = case sincos-f64 theta of
    (s, c) -> complex (mul-f64 r c) (mul-f64 r s)

  -- | Evaluate the normal-path complex exponential `exp(re) * (cos(im) + i sin(im))`.
  exp-normal :: F64 -> F64 -> Complex
  exp-normal re im =
    let r = exp-f64 re in
    case sincos-f64 im of
      (s, c) -> complex (mul-f64 r c) (mul-f64 r s)

  -- | Complex base-e exponential `e^z`.
  exp :: Complex -> Complex
  exp z =
    let re = real-part z in
    let im = imag-part z in
    if is-inf-f64 re 0 then
      if fgt-f64 re 0 && feq-f64 im 0 then z
      else if is-inf-f64 im 0 || is-nan-f64 im then
        if flt-f64 re 0 then complex 0 (copysign-f64 0 im)
        else complex (inf-f64 1) nan-f64
      else exp-normal re im
    else if is-nan-f64 re && feq-f64 im 0 then
      complex nan-f64 im
    else
      exp-normal re im

  -- | Principal natural logarithm `log(|z|) + i * phase(z)`.
  log :: Complex -> Complex
  log z = complex (log-f64 (abs z)) (phase z)

  -- | Principal base-10 logarithm `log(z) / ln(10)`.
  log10 :: Complex -> Complex
  log10 z =
    let w = log z in
    complex (mul-f64 log10-e-f64 (real-part w)) (mul-f64 log10-e-f64 (imag-part w))

  -- | Complex exponentiation `x^y`.
  pow :: Complex -> Complex -> Complex
  pow x y =
    let rx = real-part x in
    let ix = imag-part x in
    let ry = real-part y in
    let iy = imag-part y in
    if feq-f64 rx 0 && feq-f64 ix 0 then
      if is-nan y then complex-nan
      else if feq-f64 ry 0 then complex 1 0
      else if flt-f64 ry 0 then
        if feq-f64 iy 0 then complex (inf-f64 1) 0
        else complex-inf
      else if fgt-f64 ry 0 then complex 0 0
      else complex-nan
    else
      let modulus = abs x in
      if feq-f64 modulus 0 then complex 0 0
      else
        let r0 = pow-f64 modulus ry in
        let a = phase x in
        let theta0 = mul-f64 ry a in
        let r = if fne-f64 iy 0 then mul-f64 r0 (exp-f64 (mul-f64 (neg-f64 iy) a)) else r0 in
        let theta = if fne-f64 iy 0 then add-f64 theta0 (mul-f64 iy (log-f64 modulus)) else theta0 in
        case sincos-f64 theta of
          (s, c) -> complex (mul-f64 r c) (mul-f64 r s)

  -- | Principal square root of `z`, with `real-part r >= 0` and `imag-part r` matching the sign of `imag-part z`.
  sqrt :: Complex -> Complex
  sqrt z =
    let re = real-part z in
    let im = imag-part z in
    if feq-f64 im 0 then
      if feq-f64 re 0 then complex 0 im
      else if flt-f64 re 0 then complex 0 (copysign-f64 (sqrt-f64 (neg-f64 re)) im)
      else complex (sqrt-f64 re) im
    else if is-inf-f64 im 0 then
      complex (inf-f64 1) im
    else if feq-f64 re 0 then
      if flt-f64 im 0 then
        let r = sqrt-f64 (mul-f64 (neg-f64 half-f64) im) in
        complex r (neg-f64 r)
      else
        let r = sqrt-f64 (mul-f64 half-f64 im) in
        complex r r
    else if fgt-f64 (abs-f64 re) 4 || fgt-f64 (abs-f64 im) 4 then
      sqrt-scaled (mul-f64 re quarter-f64) (mul-f64 im quarter-f64) 2
    else
      sqrt-scaled (mul-f64 re sqrt-scale-up) (mul-f64 im sqrt-scale-up) sqrt-scale-down

  -- | Scaled complex square root core avoiding intermediate overflow or underflow.
  sqrt-scaled :: F64 -> F64 -> F64 -> Complex
  sqrt-scaled a b scale =
    let r0 = hypot-f64 a b in
    if fgt-f64 a 0 then
      let t0 = sqrt-f64 (add-f64 (mul-f64 half-f64 r0) (mul-f64 half-f64 a)) in
      let t = mul-f64 t0 scale in
      let r = mul-f64 scale (abs-f64 (div-f64 (mul-f64 half-f64 b) t0)) in
      if flt-f64 b 0 then complex t (neg-f64 r) else complex t r
    else
      let r1 = sqrt-f64 (sub-f64 (mul-f64 half-f64 r0) (mul-f64 half-f64 a)) in
      let t = mul-f64 scale (abs-f64 (div-f64 (mul-f64 half-f64 b) r1)) in
      let r = mul-f64 r1 scale in
      if flt-f64 b 0 then complex t (neg-f64 r) else complex t r

  -- | Compute `(sinh x, cosh x)` simultaneously for a real `F64`.
  sinhcosh-f64 :: F64 -> (F64, F64)
  sinhcosh-f64 x =
    if fle-f64 (abs-f64 x) half-f64 then (sinh-f64 x, cosh-f64 x)
    else
      let e = exp-f64 x in
      let ei = div-f64 half-f64 e in
      let eh = mul-f64 e half-f64 in
      (sub-f64 eh ei, add-f64 eh ei)

  -- | Normal-path complex sine `sin(re)*cosh(im) + i*cos(re)*sinh(im)`.
  sin-normal :: F64 -> F64 -> Complex
  sin-normal re im =
    case sincos-f64 re of
      (s, c) ->
        case sinhcosh-f64 im of
          (sh, ch) -> complex (mul-f64 s ch) (mul-f64 c sh)

  -- | Complex circular sine.
  sin :: Complex -> Complex
  sin z =
    let re = real-part z in
    let im = imag-part z in
    if feq-f64 im 0 && (is-inf-f64 re 0 || is-nan-f64 re) then
      complex nan-f64 im
    else if is-inf-f64 im 0 then
      if feq-f64 re 0 then z
      else if is-inf-f64 re 0 || is-nan-f64 re then complex nan-f64 im
      else sin-normal re im
    else if feq-f64 re 0 && is-nan-f64 im then
      z
    else
      sin-normal re im

  -- | Normal-path complex hyperbolic sine `cos(im)*sinh(re) + i*sin(im)*cosh(re)`.
  sinh-normal :: F64 -> F64 -> Complex
  sinh-normal re im =
    case sincos-f64 im of
      (s, c) ->
        case sinhcosh-f64 re of
          (sh, ch) -> complex (mul-f64 c sh) (mul-f64 s ch)

  -- | Complex hyperbolic sine.
  sinh :: Complex -> Complex
  sinh z =
    let re = real-part z in
    let im = imag-part z in
    if feq-f64 re 0 && (is-inf-f64 im 0 || is-nan-f64 im) then
      complex re nan-f64
    else if is-inf-f64 re 0 then
      if feq-f64 im 0 then z
      else if is-inf-f64 im 0 || is-nan-f64 im then complex re nan-f64
      else sinh-normal re im
    else if feq-f64 im 0 && is-nan-f64 re then
      complex nan-f64 im
    else
      sinh-normal re im

  -- | Normal-path complex cosine `cos(re)*cosh(im) - i*sin(re)*sinh(im)`.
  cos-normal :: F64 -> F64 -> Complex
  cos-normal re im =
    case sincos-f64 re of
      (s, c) ->
        case sinhcosh-f64 im of
          (sh, ch) -> complex (mul-f64 c ch) (mul-f64 (neg-f64 s) sh)

  -- | Complex circular cosine.
  cos :: Complex -> Complex
  cos z =
    let re = real-part z in
    let im = imag-part z in
    if feq-f64 im 0 && (is-inf-f64 re 0 || is-nan-f64 re) then
      complex nan-f64 (mul-f64 (neg-f64 im) (copysign-f64 0 re))
    else if is-inf-f64 im 0 then
      if feq-f64 re 0 then complex (inf-f64 1) (mul-f64 (neg-f64 re) (copysign-f64 0 im))
      else if is-inf-f64 re 0 || is-nan-f64 re then complex (inf-f64 1) nan-f64
      else cos-normal re im
    else if feq-f64 re 0 && is-nan-f64 im then
      complex nan-f64 0
    else
      cos-normal re im

  -- | Normal-path complex hyperbolic cosine `cos(im)*cosh(re) + i*sin(im)*sinh(re)`.
  cosh-normal :: F64 -> F64 -> Complex
  cosh-normal re im =
    case sincos-f64 im of
      (s, c) ->
        case sinhcosh-f64 re of
          (sh, ch) -> complex (mul-f64 c ch) (mul-f64 s sh)

  -- | Complex hyperbolic cosine.
  cosh :: Complex -> Complex
  cosh z =
    let re = real-part z in
    let im = imag-part z in
    if feq-f64 re 0 && (is-inf-f64 im 0 || is-nan-f64 im) then
      complex nan-f64 (mul-f64 re (copysign-f64 0 im))
    else if is-inf-f64 re 0 then
      if feq-f64 im 0 then complex (inf-f64 1) (mul-f64 im (copysign-f64 0 re))
      else if is-inf-f64 im 0 || is-nan-f64 im then complex (inf-f64 1) nan-f64
      else cosh-normal re im
    else if feq-f64 im 0 && is-nan-f64 re then
      complex nan-f64 im
    else
      cosh-normal re im

  -- | 64-bit word `i` of the binary expansion of `1 / pi` for Payne-Hanek range reduction.
  mpi-word :: U64 -> U64
  mpi-word i =
    if eq-u64 i 0 then 0x0000000000000000
    else if eq-u64 i 1 then 0x517cc1b727220a94
    else if eq-u64 i 2 then 0xfe13abe8fa9a6ee0
    else if eq-u64 i 3 then 0x6db14acc9e21c820
    else if eq-u64 i 4 then 0xff28b1d5ef5de2b0
    else if eq-u64 i 5 then 0xdb92371d2126e970
    else if eq-u64 i 6 then 0x0324977504e8c90e
    else if eq-u64 i 7 then 0x7f0ef58e5894d39f
    else if eq-u64 i 8 then 0x74411afa975da242
    else if eq-u64 i 9 then 0x74ce38135a2fbf20
    else if eq-u64 i 10 then 0x9cc8eb1cc1a99cfa
    else if eq-u64 i 11 then 0x4e422fc5defc941d
    else if eq-u64 i 12 then 0x8ffc4bffef02cc07
    else if eq-u64 i 13 then 0xf79788c5ad05368f
    else if eq-u64 i 14 then 0xb69b3f6793e584db
    else if eq-u64 i 15 then 0xa7a31fb34f2ff516
    else if eq-u64 i 16 then 0xba93dd63f5f2f8bd
    else if eq-u64 i 17 then 0x9e839cfbc5294975
    else if eq-u64 i 18 then 0x35fdafd88fc6ae84
    else if eq-u64 i 19 then 0x2b0198237e3db5d5
    else 0

  -- | Extract one shifted 64-bit word from `mpi-word` without shifting by 64.
  mpi-shifted :: U64 -> U32 -> U64
  mpi-shifted idx bitshift =
    let a = mpi-word idx in
    if eq-u32 bitshift 0 then a
    else
      let b = mpi-word (wrapping-add-u64 idx 1) in
      bit-or-u64 (wrapping-shl-u64 a bitshift) (wrapping-shr-u64 b (wrapping-sub-u32 64 bitshift))

  -- | Reduce `x` modulo `pi` into `(-pi/2, pi/2]` using three-part Cody-Waite
  -- reduction below `2^30` and 1216-bit Payne-Hanek reduction above.
  reduce-pi :: F64 -> F64
  reduce-pi x =
    if flt-f64 (abs-f64 x) reduce-pi-threshold then
      let t0 = add-f64 (div-f64 x pi-f64) half-f64 in
      let t = i64-to-f64 (saturating-f64-to-i64 t0) in
      sub-f64 (sub-f64 (sub-f64 x (mul-f64 t cw-pi1)) (mul-f64 t cw-pi2)) (mul-f64 t cw-pi3)
    else
      let ix0 = f64-bits x in
      let raw-exp = bit-and-u64 (wrapping-shr-u64 ix0 52) 0x7FF in
      let exp-offset = wrapping-sub-u64 raw-exp 1011 in
      let ix = bit-or-u64 (bit-and-u64 ix0 0x000FFFFFFFFFFFFF) 0x0010000000000000 in
      let digit = wrapping-shr-u64 exp-offset 6 in
      let bitshift = wrapping-u64-to-u32 (bit-and-u64 exp-offset 63) in
      let z0 = mpi-shifted digit bitshift in
      let z1 = mpi-shifted (wrapping-add-u64 digit 1) bitshift in
      let z2 = mpi-shifted (wrapping-add-u64 digit 2) bitshift in
      let ix128 = u64-to-u128 ix in
      let p2 = wrapping-mul-u128 (u64-to-u128 z2) ix128 in
      let z2hi = wrapping-u128-to-u64 (wrapping-shr-u128 p2 64) in
      let p1 = wrapping-mul-u128 (u64-to-u128 z1) ix128 in
      let p1-plus = wrapping-add-u128 p1 (u64-to-u128 z2hi) in
      let lo = wrapping-u128-to-u64 p1-plus in
      let p1-hi = wrapping-u128-to-u64 (wrapping-shr-u128 p1-plus 64) in
      let hi = wrapping-add-u64 (wrapping-mul-u64 z0 ix) p1-hi in
      let lz = leading-zeros-u64 hi in
      let sl = wrapping-add-u32 lz 1 in
      let e = wrapping-sub-u64 1023 (u32-to-u64 sl) in
      let shifted = if ge-u32 sl 64 then lo else bit-or-u64 (wrapping-shl-u64 hi sl) (wrapping-shr-u64 lo (wrapping-sub-u32 64 sl)) in
      let frac = wrapping-shr-u64 shifted 12 in
      let x1 = f64-from-bits (bit-or-u64 frac (wrapping-shl-u64 e 52)) in
      let x2 = if fgt-f64 x1 half-f64 then sub-f64 x1 1 else x1 in
      mul-f64 pi-f64 x2

  -- | Tail-recursive Taylor series loop for `cosh(2y) - cos(2x)` near poles.
  tan-series-loop :: F64 -> F64 -> F64 -> F64 -> F64 -> F64 -> F64 -> F64
  tan-series-loop x y x2 y2 f rn d =
    let rn1 = add-f64 rn 1 in
    let f1 = mul-f64 f rn1 in
    let rn2 = add-f64 rn1 1 in
    let f2 = mul-f64 f1 rn2 in
    let x2a = mul-f64 x2 x in
    let y2a = mul-f64 y2 y in
    let t1 = div-f64 (add-f64 y2a x2a) f2 in
    let d1 = add-f64 d t1 in
    let rn3 = add-f64 rn2 1 in
    let f3 = mul-f64 f2 rn3 in
    let rn4 = add-f64 rn3 1 in
    let f4 = mul-f64 f3 rn4 in
    let x2b = mul-f64 x2a x in
    let y2b = mul-f64 y2a y in
    let t2 = div-f64 (sub-f64 y2b x2b) f4 in
    let d2 = add-f64 d1 t2 in
    if fgt-f64 (abs-f64 (div-f64 t2 d2)) machep-f64 then
      tan-series-loop x y x2b y2b f4 rn4 d2
    else d2

  -- | Taylor series expansion of `cosh(2y) - cos(2x)` when the denominator of `tan` or `cot` is small.
  tan-series :: Complex -> F64
  tan-series z =
    let x0 = reduce-pi (abs-f64 (mul-f64 2 (real-part z))) in
    let y0 = abs-f64 (mul-f64 2 (imag-part z)) in
    tan-series-loop (mul-f64 x0 x0) (mul-f64 y0 y0) 1 1 1 0 0

  -- | Complex circular tangent.
  tan :: Complex -> Complex
  tan z =
    let re = real-part z in
    let im = imag-part z in
    if is-inf-f64 im 0 then
      if is-inf-f64 re 0 || is-nan-f64 re then
        complex (copysign-f64 0 re) (copysign-f64 1 im)
      else
        complex (copysign-f64 0 (sin-f64 (mul-f64 2 re))) (copysign-f64 1 im)
    else if feq-f64 re 0 && is-nan-f64 im then
      z
    else
      let d0 = add-f64 (cos-f64 (mul-f64 2 re)) (cosh-f64 (mul-f64 2 im)) in
      let d = if flt-f64 (abs-f64 d0) quarter-f64 then tan-series z else d0 in
      if feq-f64 d 0 then complex-inf
      else complex (div-f64 (sin-f64 (mul-f64 2 re)) d) (div-f64 (sinh-f64 (mul-f64 2 im)) d)

  -- | Complex hyperbolic tangent.
  tanh :: Complex -> Complex
  tanh z =
    let re = real-part z in
    let im = imag-part z in
    if is-inf-f64 re 0 then
      if is-inf-f64 im 0 || is-nan-f64 im then
        complex (copysign-f64 1 re) (copysign-f64 0 im)
      else
        complex (copysign-f64 1 re) (copysign-f64 0 (sin-f64 (mul-f64 2 im)))
    else if feq-f64 im 0 && is-nan-f64 re then
      z
    else
      let d = add-f64 (cosh-f64 (mul-f64 2 re)) (cos-f64 (mul-f64 2 im)) in
      if feq-f64 d 0 then complex-inf
      else complex (div-f64 (sinh-f64 (mul-f64 2 re)) d) (div-f64 (sin-f64 (mul-f64 2 im)) d)

  -- | Complex circular cotangent.
  cot :: Complex -> Complex
  cot z =
    let re = real-part z in
    let im = imag-part z in
    let d0 = sub-f64 (cosh-f64 (mul-f64 2 im)) (cos-f64 (mul-f64 2 re)) in
    let d = if flt-f64 (abs-f64 d0) quarter-f64 then tan-series z else d0 in
    if feq-f64 d 0 then complex-inf
    else complex (div-f64 (sin-f64 (mul-f64 2 re)) d) (div-f64 (neg-f64 (sinh-f64 (mul-f64 2 im))) d)

  -- | Complex inverse circular sine.
  asin :: Complex -> Complex
  asin z =
    let re = real-part z in
    let im = imag-part z in
    if feq-f64 im 0 && fle-f64 (abs-f64 re) 1 then
      complex (asin-f64 re) im
    else if feq-f64 re 0 && fle-f64 (abs-f64 im) 1 then
      complex re (asinh-f64 im)
    else if is-nan-f64 im then
      if feq-f64 re 0 then complex re nan-f64
      else if is-inf-f64 re 0 then complex nan-f64 re
      else complex-nan
    else if is-inf-f64 im 0 then
      if is-nan-f64 re then z
      else if is-inf-f64 re 0 then complex (copysign-f64 quarter-pi re) im
      else complex (copysign-f64 0 re) im
    else if is-inf-f64 re 0 then
      complex (copysign-f64 half-pi re) (copysign-f64 re im)
    else
      let ct = complex (neg-f64 im) re in
      let xx = mul z z in
      let x1 = complex (sub-f64 1 (real-part xx)) (neg-f64 (imag-part xx)) in
      let x2 = sqrt x1 in
      let w = log (add ct x2) in
      complex (imag-part w) (neg-f64 (real-part w))

  -- | Complex inverse hyperbolic sine.
  asinh :: Complex -> Complex
  asinh z =
    let re = real-part z in
    let im = imag-part z in
    if feq-f64 im 0 && fle-f64 (abs-f64 re) 1 then
      complex (asinh-f64 re) im
    else if feq-f64 re 0 && fle-f64 (abs-f64 im) 1 then
      complex re (asin-f64 im)
    else if is-inf-f64 re 0 then
      if is-inf-f64 im 0 then complex re (copysign-f64 quarter-pi im)
      else if is-nan-f64 im then z
      else complex re (copysign-f64 0 im)
    else if is-nan-f64 re then
      if feq-f64 im 0 then z
      else if is-inf-f64 im 0 then complex im re
      else complex-nan
    else if is-inf-f64 im 0 then
      complex (copysign-f64 im re) (copysign-f64 half-pi im)
    else
      let xx = mul z z in
      let x1 = complex (add-f64 1 (real-part xx)) (imag-part xx) in
      log (add z (sqrt x1))

  -- | Complex inverse circular cosine.
  acos :: Complex -> Complex
  acos z =
    let w = asin z in
    complex (sub-f64 half-pi (real-part w)) (neg-f64 (imag-part w))

  -- | Complex inverse hyperbolic cosine.
  acosh :: Complex -> Complex
  acosh z =
    if feq-f64 (real-part z) 0 && feq-f64 (imag-part z) 0 then
      complex 0 (copysign-f64 half-pi (imag-part z))
    else
      let w = acos z in
      if fle-f64 (imag-part w) 0 then
        complex (neg-f64 (imag-part w)) (real-part w)
      else
        complex (imag-part w) (neg-f64 (real-part w))

  -- | Complex inverse circular tangent.
  atan :: Complex -> Complex
  atan z =
    let re = real-part z in
    let im = imag-part z in
    if feq-f64 im 0 then
      complex (atan-f64 re) im
    else if feq-f64 re 0 && fle-f64 (abs-f64 im) 1 then
      complex re (atanh-f64 im)
    else if is-inf-f64 im 0 || is-inf-f64 re 0 then
      if is-nan-f64 re then complex nan-f64 (copysign-f64 0 im)
      else complex (copysign-f64 half-pi re) (copysign-f64 0 im)
    else if is-nan-f64 re || is-nan-f64 im then
      complex-nan
    else
      let x2 = mul-f64 re re in
      let a = sub-f64 (sub-f64 1 x2) (mul-f64 im im) in
      if feq-f64 a 0 then complex-nan
      else
        let t = mul-f64 half-f64 (atan2-f64 (mul-f64 2 re) a) in
        let w = reduce-pi t in
        let tm = sub-f64 im 1 in
        let b = add-f64 x2 (mul-f64 tm tm) in
        if feq-f64 b 0 then complex-nan
        else
          let tp = add-f64 im 1 in
          let c = div-f64 (add-f64 x2 (mul-f64 tp tp)) b in
          complex w (mul-f64 quarter-f64 (log-f64 c))

  -- | Complex inverse hyperbolic tangent.
  atanh :: Complex -> Complex
  atanh z =
    let w = atan (complex (neg-f64 (imag-part z)) (real-part z)) in
    complex (imag-part w) (neg-f64 (real-part w))

  -- | Named arctangent approximation over `(-pi/2, pi/2)` retained for compatibility.
  atan-approx :: F64 -> F64
  atan-approx x =
    if sign-bit-f64 x then neg-f64 (atan-magnitude (abs-f64 x))
    else atan-magnitude (abs-f64 x)

  -- | Arctangent magnitude on `[0, +Inf)` using `atan(a) = pi/2 - atan(1/a)` for `a > 1`.
  atan-magnitude :: F64 -> F64
  atan-magnitude a =
    if fgt-f64 a 1 then sub-f64 half-pi (atan-small (div-f64 1 a))
    else atan-small a

  -- | Evaluate `atan` on `[0, 1]` via four half-angle reductions and an eight-term series.
  atan-small :: F64 -> F64
  atan-small t = mul-f64 16 (atan-series (reduce4 t))

  -- | Four half-angle reductions of `t`.
  reduce4 :: F64 -> F64
  reduce4 t = reduce (reduce (reduce (reduce t)))

  -- | Single half-angle reduction `t / (1 + sqrt(1 + t^2))`.
  reduce :: F64 -> F64
  reduce t = div-f64 t (add-f64 1 (sqrt-f64 (add-f64 1 (mul-f64 t t))))

  -- | First eight odd terms of the arctangent Maclaurin series.
  atan-series :: F64 -> F64
  atan-series t =
    let t2 = mul-f64 t t in
    let t3 = mul-f64 t2 t in
    let t5 = mul-f64 t3 t2 in
    let t7 = mul-f64 t5 t2 in
    let t9 = mul-f64 t7 t2 in
    let t11 = mul-f64 t9 t2 in
    let t13 = mul-f64 t11 t2 in
    let t15 = mul-f64 t13 t2 in
    let s1 = sub-f64 t (div-f64 t3 3) in
    let s2 = add-f64 s1 (div-f64 t5 5) in
    let s3 = sub-f64 s2 (div-f64 t7 7) in
    let s4 = add-f64 s3 (div-f64 t9 9) in
    let s5 = sub-f64 s4 (div-f64 t11 11) in
    let s6 = add-f64 s5 (div-f64 t13 13) in
    sub-f64 s6 (div-f64 t15 15)

  -- | Shortest round-trip decimal text of a binary64 value.
  decimal-text :: F64 -> String
  decimal-text v = case string-from-bytes (f64-to-decimal v) of
    Some s -> s
    None -> empty-string

  -- | Format one binary64 part with a trailing `e0` elided.
  plain-part :: F64 -> String
  plain-part v =
    let s = decimal-text v in
    let n = string-byte-length s in
    if n < 2 then s
    else if string-slice s (n - 2) n == "e0" then string-slice s 0 (n - 2)
    else s

  -- | Format a complex number in `a+bi` or `a-bi` form.
  to-string :: Complex -> String
  to-string z =
    let r = plain-part (real-part z) in
    let i = imag-part z in
    let ai = plain-part (abs-f64 i) in
    if sign-bit-f64 i then string-concat r (string-concat "-" (string-concat ai "i"))
    else string-concat r (string-concat "+" (string-concat ai "i"))

  -- | Componentwise IEEE equality for `Complex`.
  implicit instance Eq_Complex :: Eq Complex where
    (==) x y = eq x y
    (/=) x y = not (eq x y)

  -- | Componentwise addition for `Complex`.
  implicit instance Add_Complex :: Add Complex where
    (+) x y = add x y

  -- | Componentwise subtraction for `Complex`.
  implicit instance Sub_Complex :: Sub Complex where
    (-) x y = sub x y

  -- | Complex multiplication for `Complex`.
  implicit instance Mul_Complex :: Mul Complex where
    (*) x y = mul x y

  -- | Componentwise negation for `Complex`.
  implicit instance Neg_Complex :: Neg Complex where
    negate x = neg x
