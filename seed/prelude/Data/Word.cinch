-- | Fixed-width word utilities and checked double-width unsigned arithmetic.
-- Carry and borrow values use Bool. Wide products return high then low words;
-- division returns quotient then remainder and names zero-divisor/overflow errors.
-- Bit and byte reversal are supplied by Data.Machine. Wide arithmetic uses
-- Data.Machine and Data.Wide with exact double-width intermediates. Native-width
-- operations follow Usize's target width.
module Data.Word where

  import Data.Bool
  import Data.Machine
  import Data.Result
  import Data.Wide

  export WordDivisionError, WordDivideByZero, WordQuotientOverflow
  export word-bits
  export bit-length-u8, bit-length-u16, bit-length-u32, bit-length-u64, bit-length-usize
  export reverse-bytes-u16, reverse-bytes-u32, reverse-bytes-u64, reverse-bytes-usize
  export rotate-signed-u8, rotate-signed-u16, rotate-signed-u32, rotate-signed-u64, rotate-signed-usize
  export add-carry-u32, add-carry-u64, add-carry-usize
  export sub-borrow-u32, sub-borrow-u64, sub-borrow-usize
  export mul-wide-u32, mul-wide-u64, mul-wide-usize
  export div-wide-u32, div-wide-u64, div-wide-usize
  export div-wide-proven-u32, div-wide-proven-u64
  export rem-wide-u32, rem-wide-u64, rem-wide-usize

  -- | An undefined unsigned division is an explicit result, never a machine trap.
  data WordDivisionError where
    -- | The divisor is zero.
    WordDivideByZero :: WordDivisionError
    -- | The quotient cannot fit in one result word because the high dividend word is at least the divisor.
    WordQuotientOverflow :: WordDivisionError

  -- | The native unsigned word width, 32 or 64, determined by the target's Usize operations.
  word-bits :: U32
  word-bits = leading-zeros-usize 0

  -- | The significant bit count of a U8; zero has length zero.
  bit-length-u8 :: U8 -> U32
  bit-length-u8 value = wrapping-sub-u32 8 (leading-zeros-u8 value)


  -- | Rotate a U8 left by a signed count; negative counts rotate right and counts wrap by the width.
  rotate-signed-u8 :: U8 -> I64 -> U8
  rotate-signed-u8 value count = rotate-left-u8 value (wrapping-i64-to-u32 count)

  -- | The significant bit count of a U16; zero has length zero.
  bit-length-u16 :: U16 -> U32
  bit-length-u16 value = wrapping-sub-u32 16 (leading-zeros-u16 value)


  -- | Reverse byte order within a U16; bit order within each byte is preserved.
  reverse-bytes-u16 :: U16 -> U16
  reverse-bytes-u16 value = swap-bytes-u16 value

  -- | Rotate a U16 left by a signed count; negative counts rotate right and counts wrap by the width.
  rotate-signed-u16 :: U16 -> I64 -> U16
  rotate-signed-u16 value count = rotate-left-u16 value (wrapping-i64-to-u32 count)

  -- | The significant bit count of a U32; zero has length zero.
  bit-length-u32 :: U32 -> U32
  bit-length-u32 value = wrapping-sub-u32 32 (leading-zeros-u32 value)


  -- | Reverse byte order within a U32; bit order within each byte is preserved.
  reverse-bytes-u32 :: U32 -> U32
  reverse-bytes-u32 value = swap-bytes-u32 value

  -- | Rotate a U32 left by a signed count; negative counts rotate right and counts wrap by the width.
  rotate-signed-u32 :: U32 -> I64 -> U32
  rotate-signed-u32 value count = rotate-left-u32 value (wrapping-i64-to-u32 count)

  -- | The significant bit count of a U64; zero has length zero.
  bit-length-u64 :: U64 -> U32
  bit-length-u64 value = wrapping-sub-u32 64 (leading-zeros-u64 value)


  -- | Reverse byte order within a U64; bit order within each byte is preserved.
  reverse-bytes-u64 :: U64 -> U64
  reverse-bytes-u64 value = swap-bytes-u64 value

  -- | Rotate a U64 left by a signed count; negative counts rotate right and counts wrap by the width.
  rotate-signed-u64 :: U64 -> I64 -> U64
  rotate-signed-u64 value count = rotate-left-u64 value (wrapping-i64-to-u32 count)

  -- | The significant bit count of a Usize; zero has length zero.
  bit-length-usize :: Usize -> U32
  bit-length-usize value = wrapping-sub-u32 word-bits (leading-zeros-usize value)


  -- | Reverse byte order within a Usize; bit order within each byte is preserved.
  reverse-bytes-usize :: Usize -> Usize
  reverse-bytes-usize value = swap-bytes-usize value

  -- | Rotate a Usize left by a signed count; negative counts rotate right and counts wrap by the width.
  rotate-signed-usize :: Usize -> I64 -> Usize
  rotate-signed-usize value count = rotate-left-usize value (wrapping-i64-to-u32 count)

  -- | Add two 32-bit words and a carry, returning the low word and the outgoing carry.
  add-carry-u32 :: U32 -> U32 -> Bool -> (U32, Bool)
  add-carry-u32 a b carry =
    let c = if carry then (1 :: U64) else 0 in
    let total = wrapping-add-u64 (wrapping-add-u64 (u32-to-u64 a) (u32-to-u64 b)) c in
    (wrapping-u64-to-u32 total, ne-u64 (wrapping-shr-u64 total 32) 0)

  -- | Add two 64-bit words and a carry, returning the low word and the outgoing carry.
  add-carry-u64 :: U64 -> U64 -> Bool -> (U64, Bool)
  add-carry-u64 a b carry =
    let c = if carry then (1 :: U128) else 0 in
    let total = wrapping-add-u128 (wrapping-add-u128 (u64-to-u128 a) (u64-to-u128 b)) c in
    (wrapping-u128-to-u64 total, ne-u128 (wrapping-shr-u128 total 64) 0)

  -- | Subtract a 32-bit word and an incoming borrow, returning the low word and outgoing borrow.
  sub-borrow-u32 :: U32 -> U32 -> Bool -> (U32, Bool)
  sub-borrow-u32 a b borrow =
    let c = if borrow then (1 :: U64) else 0 in
    let aw = u32-to-u64 a in
    let subtrahend = wrapping-add-u64 (u32-to-u64 b) c in
    (wrapping-u64-to-u32 (wrapping-sub-u64 aw subtrahend), lt-u64 aw subtrahend)

  -- | Subtract a 64-bit word and an incoming borrow, returning the low word and outgoing borrow.
  sub-borrow-u64 :: U64 -> U64 -> Bool -> (U64, Bool)
  sub-borrow-u64 a b borrow =
    let c = if borrow then (1 :: U128) else 0 in
    let aw = u64-to-u128 a in
    let subtrahend = wrapping-add-u128 (u64-to-u128 b) c in
    (wrapping-u128-to-u64 (wrapping-sub-u128 aw subtrahend), lt-u128 aw subtrahend)

  -- | The exact 64-bit product of two 32-bit words, returned high word first.
  mul-wide-u32 :: U32 -> U32 -> (U32, U32)
  mul-wide-u32 a b = let product = wrapping-mul-u64 (u32-to-u64 a) (u32-to-u64 b) in
    (wrapping-u64-to-u32 (wrapping-shr-u64 product 32), wrapping-u64-to-u32 product)

  -- | The exact 128-bit product of two 64-bit words, returned high word first.
  mul-wide-u64 :: U64 -> U64 -> (U64, U64)
  mul-wide-u64 a b =
    let product = wrapping-mul-u128 (u64-to-u128 a) (u64-to-u128 b) in
    (wrapping-u128-to-u64 (wrapping-shr-u128 product 64), wrapping-u128-to-u64 product)

  -- | Combine high and low 32-bit words into a 64-bit unsigned dividend.
  wide-u64 :: U32 -> U32 -> U64
  wide-u64 high low = bit-or-u64 (wrapping-shl-u64 (u32-to-u64 high) 32) (u32-to-u64 low)

  -- | Combine high and low 64-bit words into a 128-bit unsigned dividend.
  wide-u128 :: U64 -> U64 -> U128
  wide-u128 high low = bit-or-u128 (wrapping-shl-u128 (u64-to-u128 high) 64) (u64-to-u128 low)

  -- | The low quotient word of checked double-width division; caller proves a nonzero divisor.
  quotient64 :: using (divisor /= 0) => U64 -> U64 -> (divisor :: U64) -> U64
  quotient64 high low divisor = wrapping-u128-to-u64 (div-u128 (wide-u128 high low) (u64-to-u128 divisor))

  -- | The remainder of double-width division; caller proves a nonzero divisor.
  remainder64 :: using (divisor /= 0) => U64 -> U64 -> (divisor :: U64) -> U64
  remainder64 high low divisor = wrapping-u128-to-u64 (rem-u128 (wide-u128 high low) (u64-to-u128 divisor))

  -- | Divide a high/low 64-bit dividend by a 32-bit divisor, with a checked one-word quotient.
  div-wide-u32 :: U32 -> U32 -> U32 -> Result WordDivisionError (U32, U32)
  div-wide-u32 high low divisor =
    case decide (divisor /= 0) of
      No witness -> Err WordDivideByZero
      Yes witness -> if high < divisor then
        let dividend = wide-u64 high low in
        let d = u32-to-u64 divisor in
        Ok (wrapping-u64-to-u32 (div-u64 dividend d), wrapping-u64-to-u32 (rem-u64 dividend d))
        else Err WordQuotientOverflow

  -- | Divide a high/low 128-bit dividend by a 64-bit divisor, with a checked one-word quotient.
  div-wide-u64 :: U64 -> U64 -> U64 -> Result WordDivisionError (U64, U64)
  div-wide-u64 high low divisor =
    case decide (divisor /= 0) of
      No witness -> Err WordDivideByZero
      Yes witness -> if high < divisor then Ok (quotient64 high low divisor, remainder64 high low divisor)
        else Err WordQuotientOverflow

  -- | Divide a double-width dividend when the caller proves a nonzero divisor
  -- and a fitting quotient. The tuple result avoids allocating an error sum.
  div-wide-proven-u32 :: using (divisor /= 0, high < divisor) => (high :: U32) -> U32 -> (divisor :: U32) -> (U32, U32)
  div-wide-proven-u32 high low divisor =
    let dividend = wide-u64 high low in
    let d = u32-to-u64 divisor in
    (wrapping-u64-to-u32 (div-u64 dividend d), wrapping-u64-to-u32 (rem-u64 dividend d))

  -- | Divide a double-width dividend under nonzero-divisor and quotient-fit proofs.
  -- The tuple result permits unboxed worker returns for already validated inputs.
  div-wide-proven-u64 :: using (divisor /= 0, high < divisor) => (high :: U64) -> U64 -> (divisor :: U64) -> (U64, U64)
  div-wide-proven-u64 high low divisor = (quotient64 high low divisor, remainder64 high low divisor)

  -- | The remainder of a high/low 64-bit dividend. The high word need not be below the divisor.
  rem-wide-u32 :: U32 -> U32 -> U32 -> Result WordDivisionError U32
  rem-wide-u32 high low divisor =
    case decide (divisor /= 0) of
      No witness -> Err WordDivideByZero
      Yes witness ->
        let dividend = wide-u64 high low in
        let d = u32-to-u64 divisor in
        Ok (wrapping-u64-to-u32 (rem-u64 dividend d))

  -- | The remainder of a high/low 128-bit dividend. The high word need not be below the divisor.
  rem-wide-u64 :: U64 -> U64 -> U64 -> Result WordDivisionError U64
  rem-wide-u64 high low divisor =
    case decide (divisor /= 0) of
      No witness -> Err WordDivideByZero
      Yes witness -> Ok (remainder64 high low divisor)

  -- | Add native words and a carry, returning the low word and outgoing carry.
  add-carry-usize :: Usize -> Usize -> Bool -> (Usize, Bool)
  add-carry-usize a b flag =
    if eq-u32 word-bits 32 then case add-carry-u32 (wrapping-usize-to-u32 a) (wrapping-usize-to-u32 b) flag of
      (value, next) -> (wrapping-u32-to-usize value, next)
    else case add-carry-u64 (wrapping-usize-to-u64 a) (wrapping-usize-to-u64 b) flag of
      (value, next) -> (wrapping-u64-to-usize value, next)

  -- | Subtract native words and a borrow, returning the low word and outgoing borrow.
  sub-borrow-usize :: Usize -> Usize -> Bool -> (Usize, Bool)
  sub-borrow-usize a b flag =
    if eq-u32 word-bits 32 then case sub-borrow-u32 (wrapping-usize-to-u32 a) (wrapping-usize-to-u32 b) flag of
      (value, next) -> (wrapping-u32-to-usize value, next)
    else case sub-borrow-u64 (wrapping-usize-to-u64 a) (wrapping-usize-to-u64 b) flag of
      (value, next) -> (wrapping-u64-to-usize value, next)

  -- | The exact double-width product of native words, returned high word first.
  mul-wide-usize :: Usize -> Usize -> (Usize, Usize)
  mul-wide-usize a b =
    if eq-u32 word-bits 32 then case mul-wide-u32 (wrapping-usize-to-u32 a) (wrapping-usize-to-u32 b) of
      (high, low) -> (wrapping-u32-to-usize high, wrapping-u32-to-usize low)
    else case mul-wide-u64 (wrapping-usize-to-u64 a) (wrapping-usize-to-u64 b) of
      (high, low) -> (wrapping-u64-to-usize high, wrapping-u64-to-usize low)

  -- | Divide a high/low native double word, checking zero and quotient overflow.
  div-wide-usize :: Usize -> Usize -> Usize -> Result WordDivisionError (Usize, Usize)
  div-wide-usize high low divisor =
    if eq-u32 word-bits 32 then case div-wide-u32 (wrapping-usize-to-u32 high) (wrapping-usize-to-u32 low) (wrapping-usize-to-u32 divisor) of
      Err error -> Err error
      Ok pair -> case pair of (q, r) -> Ok (wrapping-u32-to-usize q, wrapping-u32-to-usize r)
    else case div-wide-u64 (wrapping-usize-to-u64 high) (wrapping-usize-to-u64 low) (wrapping-usize-to-u64 divisor) of
      Err error -> Err error
      Ok pair -> case pair of (q, r) -> Ok (wrapping-u64-to-usize q, wrapping-u64-to-usize r)

  -- | The remainder of a high/low native double word, checking only for a zero divisor.
  rem-wide-usize :: Usize -> Usize -> Usize -> Result WordDivisionError Usize
  rem-wide-usize high low divisor =
    if eq-u32 word-bits 32 then case rem-wide-u32 (wrapping-usize-to-u32 high) (wrapping-usize-to-u32 low) (wrapping-usize-to-u32 divisor) of
      Err error -> Err error
      Ok value -> Ok (wrapping-u32-to-usize value)
    else case rem-wide-u64 (wrapping-usize-to-u64 high) (wrapping-usize-to-u64 low) (wrapping-usize-to-u64 divisor) of
      Err error -> Err error
      Ok value -> Ok (wrapping-u64-to-usize value)
