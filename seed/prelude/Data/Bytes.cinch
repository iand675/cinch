-- Data.Bytes: boxed byte buffers.
--
-- `Bytes` is a core runtime type: indices and lengths are `Nat`, and a
-- byte is an `InRange 0 255 Nat`. Every operation is total by
-- construction (design/no-faults.md): a read or write takes evidence
-- that its index is below `bytes-len b`, a range copy evidence that both
-- ranges end inside their buffers, a read's result carries its range and
-- a write's value must prove it. A buffer's length is fixed when it is
-- made, so a fact over `bytes-len b` survives writes to `b`, and
-- `bytes-new n` gives `bytes-len out == n` to the name it is bound to.
-- A length no allocation can hold is the heap `Exhausted` exit.
--
-- Module scheme (design/base-library.md): the type's home carries its
-- instance family: `FromList` (`[1, 2, 3]` at `Bytes` fills a buffer)
-- over `U8` elements, so a literal's numerals are range-checked as
-- bytes at compile time, and the key pair `Eq`/`Hash` (a byte slice is
-- a plausible key: a compiler's names arrive as the lexer's bytes).
module Data.Bytes where

  import Prim.Machine (u8-to-i64, u8-to-u64, u32-to-u64, wrapping-add-i64, wrapping-sub-i64, eq-i64, ne-i64, lt-i64, le-i64, wrapping-i64-to-u8, wrapping-i64-to-u64, wrapping-u64-to-i64, mask-i64, bit-xor-u64, bit-or-u64, wrapping-shl-u64)
  import Algebra.Arithmetic
  import Data.Hash
  import Data.List
  import Data.Nat

  export bytes-new, bytes-len, bytes-len-i64, bytes-get, bytes-set, bytes-get-u8, bytes-set-u8, bytes-get-u8-at, bytes-set-u8-at
  export bytes-load-le32, bytes-store-le32, bytes-load-le32-at, bytes-store-le32-at
  export bytes-load-le64, bytes-store-le64, bytes-load-le64-at, bytes-store-le64-at
  export bytes-load-u128, bytes-store-u128, bytes-load-u128-at, bytes-store-u128-at
  export bytes-data, bytes-copy-range, bytes-compare, bytes-from-list, bytes-from-u8s, sha256-bytes


  -- `nat-cmp`/`int-cmp` return the raw -1/0/1 immediate at `I64`, so
  -- equality is `eq-i64 (int-cmp a b) 0`.

  -- `Bytes`: boxed byte buffers. `bytes-len` comes first: the other
  -- signatures name it. A length is an `i64` in the runtime, so it is at
  -- most `2^63 - 1` and every index below it converts to `I64`. The
  -- index obligation is `nat-sub`'s shape: a loop's own guard (`if i <
  -- bytes-len b`), a fresh buffer's length or an enclosing `using (i <=
  -- bytes-len b)` supplies it. A string literal's read-only backing is
  -- never one of these buffers: it lives inside a `String`, and every
  -- conversion out of a `String` copies.
  foreign import ccall "cinch.runtime.bytesLen" bytes-len :: Bytes -> InRange 0 9223372036854775807 Nat
  foreign import ccall "cinch.runtime.bytesLenI64" bytes-len-i64 :: (b :: Bytes) -> refined (0 <= r && r == bytes-len b) I64
  foreign import ccall "cinch.runtime.bytesNew" bytes-new :: (n :: Nat) -> refined (bytes-len out == n) Bytes
  foreign import ccall "cinch.runtime.bytesGet" bytes-get :: using (i < bytes-len b) => (b :: Bytes) -> (i :: Nat) -> InRange 0 255 Nat
  foreign import ccall "cinch.runtime.bytesSet" bytes-set :: using (i < bytes-len b) => (b :: Bytes) -> (i :: Nat) -> InRange 0 255 Nat -> Unit
  foreign import ccall "cinch.runtime.bytesGetU8" bytes-get-u8 :: using (i < bytes-len b) => (b :: Bytes) -> (i :: Nat) -> U8
  foreign import ccall "cinch.runtime.bytesSetU8" bytes-set-u8 :: using (i < bytes-len b) => (b :: Bytes) -> (i :: Nat) -> U8 -> Unit
  foreign import ccall "cinch.runtime.bytesGetU8At" bytes-get-u8-at :: using (0 <= i, i < bytes-len-i64 b) => (b :: Bytes) -> (i :: I64) -> U8
  foreign import ccall "cinch.runtime.bytesSetU8At" bytes-set-u8-at :: using (0 <= i, i < bytes-len-i64 b) => (b :: Bytes) -> (i :: I64) -> U8 -> Unit
  foreign import ccall "cinch.runtime.bytesLoadLe32" bytes-load-le32 :: using (i + 4 <= bytes-len b) => (b :: Bytes) -> (i :: Nat) -> U32
  foreign import ccall "cinch.runtime.bytesStoreLe32" bytes-store-le32 :: using (i + 4 <= bytes-len b) => (b :: Bytes) -> (i :: Nat) -> U32 -> Unit
  foreign import ccall "cinch.runtime.bytesLoadLe32At" bytes-load-le32-at :: using (0 <= i, i + 4 <= bytes-len-i64 b) => (b :: Bytes) -> (i :: I64) -> U32
  foreign import ccall "cinch.runtime.bytesStoreLe32At" bytes-store-le32-at :: using (0 <= i, i + 4 <= bytes-len-i64 b) => (b :: Bytes) -> (i :: I64) -> U32 -> Unit
  foreign import ccall "cinch.runtime.bytesLoadLe64" bytes-load-le64 :: using (i + 8 <= bytes-len b) => (b :: Bytes) -> (i :: Nat) -> U64
  foreign import ccall "cinch.runtime.bytesStoreLe64" bytes-store-le64 :: using (i + 8 <= bytes-len b) => (b :: Bytes) -> (i :: Nat) -> U64 -> Unit
  foreign import ccall "cinch.runtime.bytesLoadLe64At" bytes-load-le64-at :: using (0 <= i, i + 8 <= bytes-len-i64 b) => (b :: Bytes) -> (i :: I64) -> U64
  foreign import ccall "cinch.runtime.bytesStoreLe64At" bytes-store-le64-at :: using (0 <= i, i + 8 <= bytes-len-i64 b) => (b :: Bytes) -> (i :: I64) -> U64 -> Unit
  foreign import ccall "cinch.runtime.bytesLoadU128" bytes-load-u128 :: using (i + 16 <= bytes-len b) => (b :: Bytes) -> (i :: Nat) -> U128
  foreign import ccall "cinch.runtime.bytesStoreU128" bytes-store-u128 :: using (i + 16 <= bytes-len b) => (b :: Bytes) -> (i :: Nat) -> U128 -> Unit
  foreign import ccall "cinch.runtime.bytesLoadU128At" bytes-load-u128-at :: using (0 <= i, i + 16 <= bytes-len-i64 b) => (b :: Bytes) -> (i :: I64) -> U128
  foreign import ccall "cinch.runtime.bytesStoreU128At" bytes-store-u128-at :: using (0 <= i, i + 16 <= bytes-len-i64 b) => (b :: Bytes) -> (i :: I64) -> U128 -> Unit

  -- `bytes-data b`: the address of the buffer's payload as a machine
  -- word. This is how a buffer reaches the operating system: a `prim`
  -- body or a `foreign import ccall` takes the address and the length
  -- separately, exactly as the C interface does. The buffer never moves
  -- and the address is valid while the handle is live, so a caller that
  -- wants a C string NUL-terminates it itself (a fresh buffer one byte
  -- longer, the bytes copied in, the last byte zeroed).
  foreign import ccall "cinch.runtime.bytesData" bytes-data :: Bytes -> I64

  -- `bytes-copy-range dst src di si n`: the `n` bytes of `src` from `si`
  -- into `dst` at `di`, as one runtime `memmove` (the two may be the
  -- same buffer and overlap). A copy loop written here would box a `Nat`
  -- for every index step, so every bulk copy goes through this.
  foreign import ccall "cinch.runtime.bytesCopy" bytes-copy-range :: using (di + n <= bytes-len dst, si + n <= bytes-len src) => (dst :: Bytes) -> (src :: Bytes) -> (di :: Nat) -> (si :: Nat) -> (n :: Nat) -> Unit

  -- The lexicographic order of two buffers' contents as the raw -1/0/1
  -- immediate (the `nat-cmp` convention), read in place: no copy and
  -- no allocation.
  foreign import ccall "cinch.runtime.bytesCompare" bytes-compare :: Bytes -> Bytes -> I64

  -- SHA-256 (FIPS 180-4) at content-addressing strength over a
  -- buffer (the P31 content identity; `seed/runtime/src/text.rs`,
  -- the `cinch.runtime.textSha256` intrinsic, nm-verified there): the
  -- digest as a fresh 32-byte buffer.
  foreign import ccall "cinch.runtime.textSha256" sha256-bytes :: Bytes -> Bytes

  -- -----------------------------------------------------------------
  -- Private safe machine primitives for zero-allocation indexing & wyhash.
  -- -----------------------------------------------------------------

  -- | 64x64->128-bit widening multiply-XOR mix (wyhash / rapidhash core).
  prim wymix-u64 :: U64 -> U64 -> U64 where
    llvm {
      %a = zext i64 %0 to i128
      %b = zext i64 %1 to i128
      %p = mul i128 %a, %b
      %lo = trunc i128 %p to i64
      %hi128 = lshr i128 %p, 64
      %hi = trunc i128 %hi128 to i64
      %r = xor i64 %lo, %hi
      ret i64 %r
    }

  -- | Extract the low 64-bit little-endian lane of a U128 word.
  prim u128-lo-u64 :: U128 -> U64 where
    llvm {
      %r = trunc i128 %0 to i64
      ret i64 %r
    }

  -- | Extract the high 64-bit little-endian lane of a U128 word.
  prim u128-hi-u64 :: U128 -> U64 where
    llvm {
      %s = lshr i128 %0, 64
      %r = trunc i128 %s to i64
      ret i64 %r
    }

  -- -----------------------------------------------------------------
  -- Private `%1`-linear buffer write boundary for list constructors.
  -- -----------------------------------------------------------------

  -- | Private raw single-byte store returning its uniquely owned buffer.
  put-u8-raw :: Bytes -> I64 -> U8 -> Bytes
  put-u8-raw b pos v =
    if 0 <= pos && pos < bytes-len-i64 b then
      let w = bytes-set-u8-at b pos v in b
    else b

  -- | Linearly store one U8 byte at an unboxed I64 offset.
  put-u8-lin :: Bytes %1 -> I64 -> U8 -> Bytes
  put-u8-lin b pos v = put-u8-raw b pos v

  -- | Private raw range-checked Nat byte store returning its buffer.
  put-nat-byte-raw :: Bytes -> I64 -> InRange 0 255 Nat -> Bytes
  put-nat-byte-raw b pos v =
    if 0 <= pos && pos < bytes-len-i64 b then
      let w = bytes-set-u8-at b pos (wrapping-i64-to-u8 (nat-to-i64 v)) in b
    else b

  -- | Linearly store one range-checked Nat byte at an unboxed I64 offset.
  put-nat-byte-lin :: Bytes %1 -> I64 -> InRange 0 255 Nat -> Bytes
  put-nat-byte-lin b pos v = put-nat-byte-raw b pos v

  -- | Count any typed element list using an unboxed I64 accumulator.
  byte-list-size-i64 :: forall a. List a -> I64 -> I64
  byte-list-size-i64 xs total = case xs of
    Nil -> total
    Cons _ rest -> byte-list-size-i64 rest (wrapping-add-i64 total 1)

  -- | Copy typed byte values in list order into one fresh `%1`-linear buffer.
  -- A tail unboxed count pass and `%1`-linear tail stores keep stack O(1).
  bytes-from-list :: List (InRange 0 255 Nat) -> Bytes
  bytes-from-list xs =
    let n = byte-list-size-i64 xs 0 in
    if 0 <= n then bytes-fill-lin (bytes-new (nat-from-i64 n)) 0 xs
    else bytes-new 0

  -- | Linearly store range-checked Nat bytes into a uniquely owned buffer.
  bytes-fill-lin :: Bytes %1 -> I64 -> List (InRange 0 255 Nat) -> Bytes
  bytes-fill-lin out i xs = case xs of
    Nil -> out
    Cons value rest ->
      let out1 = put-nat-byte-lin out i value in
      bytes-fill-lin out1 (wrapping-add-i64 i 1) rest

  -- | Copy machine byte values into one fresh `%1`-linear buffer without boxing.
  bytes-from-u8s :: List U8 -> Bytes
  bytes-from-u8s xs =
    let n = byte-list-size-i64 xs 0 in
    if 0 <= n then u8s-fill-lin (bytes-new (nat-from-i64 n)) 0 xs
    else bytes-new 0

  -- | Linearly store machine U8 bytes directly into a uniquely owned buffer.
  u8s-fill-lin :: Bytes %1 -> I64 -> List U8 -> Bytes
  u8s-fill-lin out i xs = case xs of
    Nil -> out
    Cons value rest ->
      let out1 = put-u8-lin out i value in
      u8s-fill-lin out1 (wrapping-add-i64 i 1) rest

  implicit instance FromList_Bytes :: FromList Bytes U8 where
    from-list xs = bytes-from-u8s xs

  -- Byte-for-byte equality over the backing: the in-place compare answers
  -- equal when the lengths agree and every byte agrees, reading the common
  -- prefix a word at a time. The keyed structures need `Eq` beside `Hash`
  -- (Data.HashMap's header): hashing alone cannot decide a digest
  -- collision, so an instance that hashes without comparing is not a
  -- key.
  implicit instance Eq_Bytes :: Eq Bytes where
    (==) x y = eq-i64 (bytes-compare x y) 0
    (/=) x y = ne-i64 (bytes-compare x y) 0

  -- -----------------------------------------------------------------
  -- Word-at-a-time wyhash / rapidhash-style hashing (Wang Yi / De Carli).
  --
  -- Fast paths for lengths 0, 1..3, 4..7 (two overlapping LE32 loads),
  -- 8..16 (two overlapping LE64 loads — zero loop for compiler identifiers),
  -- and a 3-lane 48-byte unrolled loop + 16-byte loop + overlapping 16-byte
  -- tail for longer buffers. All intermediate arithmetic is unboxed
  -- I64/U64/U128; the only boxed Nat allocated is the final bucket digest.
  --
  -- The digest is a bucket key, so the class law is the only obligation
  -- (Data.Hash): equal slices hash alike because the fold reads content
  -- only, the result is a pure function of the bytes (no address, no time,
  -- so it is reproducible across runs), and distinct slices may still
  -- share a digest (the bucket scan's job).
  -- -----------------------------------------------------------------

  wy-p0 :: U64
  wy-p0 = 11562461410679940143

  wy-p1 :: U64
  wy-p1 = 16646288086500911323

  wy-p2 :: U64
  wy-p2 = 10285213230658275043

  wy-p3 :: U64
  wy-p3 = 6384245875588680899

  wy-seed0 :: U64
  wy-seed0 = 14953955755779583847

  -- A 64-bit word as the `Nat` of the same value with its top bit
  -- cleared. INVARIANT: the result is in `0 .. 2^63 - 1`, which is what
  -- `nat-from-i64` requires; `mask-i64` carries that refinement, and the
  -- mask is a constant, so the cost is the single boxed `Nat` every
  -- digest returns. Clearing one bit of a 64-bit digest changes nothing
  -- about the law.
  u64-to-nat :: U64 -> Nat
  u64-to-nat w = nat-from-i64 (mask-i64 (wrapping-u64-to-i64 w) 9223372036854775807)

  wy-finalize :: U64 -> U64 -> U64 -> U64 -> Nat
  wy-finalize a b-hi seed ulen =
    let m1 = wymix-u64 (bit-xor-u64 a wy-p1) (bit-xor-u64 b-hi seed) in
    let h = wymix-u64 (bit-xor-u64 wy-p1 ulen) m1 in
    u64-to-nat h

  -- | 3-lane 48-byte unrolled loop for buffers > 48 bytes; hands off directly
  -- to the 16-byte loop and final overlapping 16-byte tail without allocating.
  wy-loop48 :: using (lim16-n + 16 <= bytes-len b) => (b :: Bytes) -> (i :: I64) -> (lim16-n :: Nat) -> (lim16 :: I64) -> U64 -> U64 -> U64 -> U64 -> Nat
  wy-loop48 b i lim16-n lim16 ulen s0 s1 s2 =
    let i16 = wrapping-add-i64 i 16 in
    let i32 = wrapping-add-i64 i 32 in
    if 0 <= i && 0 <= i16 && 0 <= i32 && nat-from-i64 i <= lim16-n && nat-from-i64 i16 <= lim16-n && nat-from-i64 i32 <= lim16-n then
      let v0 = bytes-load-u128-at b i in
      let v1 = bytes-load-u128-at b i16 in
      let v2 = bytes-load-u128-at b i32 in
      let ns0 = wymix-u64 (bit-xor-u64 (u128-lo-u64 v0) wy-p1) (bit-xor-u64 (u128-hi-u64 v0) s0) in
      let ns1 = wymix-u64 (bit-xor-u64 (u128-lo-u64 v1) wy-p2) (bit-xor-u64 (u128-hi-u64 v1) s1) in
      let ns2 = wymix-u64 (bit-xor-u64 (u128-lo-u64 v2) wy-p3) (bit-xor-u64 (u128-hi-u64 v2) s2) in
      wy-loop48 b (wrapping-add-i64 i 48) lim16-n lim16 ulen ns0 ns1 ns2
    else
      let seed = bit-xor-u64 s0 (bit-xor-u64 s1 s2) in
      wy-loop16 b i lim16-n lim16 ulen seed

  -- | 16-byte stride loop finishing with one overlapping 16-byte tail read.
  wy-loop16 :: using (lim16-n + 16 <= bytes-len b) => (b :: Bytes) -> (i :: I64) -> (lim16-n :: Nat) -> (lim16 :: I64) -> U64 -> U64 -> Nat
  wy-loop16 b i lim16-n lim16 ulen seed =
    if 0 <= i && nat-from-i64 i < lim16-n then
      let v = bytes-load-u128-at b i in
      let nseed = wymix-u64 (bit-xor-u64 (u128-lo-u64 v) wy-p1) (bit-xor-u64 (u128-hi-u64 v) seed) in
      wy-loop16 b (wrapping-add-i64 i 16) lim16-n lim16 ulen nseed
    else if 0 <= lim16 && nat-from-i64 lim16 <= lim16-n then
      let vlast = bytes-load-u128-at b lim16 in
      wy-finalize (u128-lo-u64 vlast) (u128-hi-u64 vlast) seed ulen
    else 0

  hash-bytes :: Bytes -> Nat
  hash-bytes b =
    let len = bytes-len-i64 b in
    let n = bytes-len b in
    let ulen = wrapping-i64-to-u64 len in
    if len <= 16 then
      if 8 <= len && 8 <= n then
        let off8 = wrapping-sub-i64 len 8 in
        let a = bytes-load-le64-at b 0 in
        let b-hi = if 0 <= off8 && nat-from-i64 off8 <= n - 8 then bytes-load-le64-at b off8 else 0 in
        wy-finalize a b-hi wy-seed0 ulen
      else if 4 <= len && 4 <= n then
        let off4 = wrapping-sub-i64 len 4 in
        let a = u32-to-u64 (bytes-load-le32-at b 0) in
        let b-hi = if 0 <= off4 && nat-from-i64 off4 <= n - 4 then u32-to-u64 (bytes-load-le32-at b off4) else 0 in
        wy-finalize a b-hi wy-seed0 ulen
      else if 1 <= len && 1 <= n then
        let off1 = wrapping-sub-i64 len 1 in
        let b0 = u8-to-u64 (bytes-get-u8-at b 0) in
        let b1 = if 2 <= len then u8-to-u64 (bytes-get-u8-at b 1) else b0 in
        let b2 = if 0 <= off1 && nat-from-i64 off1 < n then u8-to-u64 (bytes-get-u8-at b off1) else b0 in
        let a = bit-or-u64 (wrapping-shl-u64 b0 16) (bit-or-u64 (wrapping-shl-u64 b1 8) b2) in
        wy-finalize a 0 wy-seed0 ulen
      else
        wy-finalize 0 0 wy-seed0 0
    else if 16 <= n then
      let lim16 = wrapping-sub-i64 len 16 in
      let lim16-n = n - 16 in
      if 48 < len then
        wy-loop48 b 0 lim16-n lim16 ulen wy-seed0 wy-seed0 wy-seed0
      else
        wy-loop16 b 0 lim16-n lim16 ulen wy-seed0
    else wy-finalize 0 0 wy-seed0 0

  -- The buffer's digest (instances live with their type). `Data.String`
  -- hashes its UTF-8 backing through THIS instance, so a string and the
  -- bytes it converts to agree by construction rather than by two
  -- copies of one algorithm.
  implicit instance Hash_Bytes :: Hash Bytes where
    hash b = hash-bytes b
