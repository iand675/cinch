  wrapping-add-usize :: Usize -> Usize -> Usize
  wrapping-add-usize x y = if word-size32 0 then u32-to-usize (wrapping-add-u32 (wrapping-usize-to-u32 x) (wrapping-usize-to-u32 y)) else wrapping-u64-to-usize (wrapping-add-u64 (usize-to-u64 x) (usize-to-u64 y))
  wrapping-sub-usize :: Usize -> Usize -> Usize
  wrapping-sub-usize x y = if word-size32 0 then u32-to-usize (wrapping-sub-u32 (wrapping-usize-to-u32 x) (wrapping-usize-to-u32 y)) else wrapping-u64-to-usize (wrapping-sub-u64 (usize-to-u64 x) (usize-to-u64 y))
