  -- A mask with a non-negative mask word: the `bit-and` of any word
  -- with `m >= 0` lies in `[0, m]` (the and clears the sign bit and
  -- every bit `m` lacks), so `mask-i64 x 255` is a byte. It is the same
  -- intrinsic as `bit-and-i64`; only the declared range differs, which
  -- `bit-and-i64` itself cannot state because a negative mask (`-1`,
  -- the high bit) is an ordinary use of it.
  -- `mask-i64` is defined in and re-exported from `Prim.Machine`.

  -- The unsigned machine integers as the `Nat` of the same value: the
  -- widening conversion's range is the evidence `nat-from-i64` needs,
  -- and the result keeps it.
  u8-to-nat :: U8 -> InRange 0 255 Nat
  u8-to-nat b = let w = u8-to-i64 b in nat-from-i64 w

  u16-to-nat :: U16 -> InRange 0 65535 Nat
  u16-to-nat b = let w = u16-to-i64 b in nat-from-i64 w

  u32-to-nat :: U32 -> InRange 0 4294967295 Nat
  u32-to-nat b = let w = u32-to-i64 b in nat-from-i64 w

  -- One little-endian byte of an `I64` at shift `k` bits (the A6
  -- INTEGER column format, modules specification section 11).
  i64-le-byte :: I64 -> U32 -> InRange 0 255 Nat
  i64-le-byte x k = let b = mask-i64 (wrapping-shr-i64 x k) 255 in nat-from-i64 b

  -- The P31 text conversions of `F64` (seed/runtime/src/text.rs;
  -- the `cinch.runtime.textF64*` intrinsics, nm-verified there):
  -- one float's shortest round-trip decimal text (scientific form)
  -- and the float one decimal spelling stands for (correctly
  -- rounded). A spelling that is not a decimal number takes the
  -- defined `MalformedDecimal` fault (exit 71).
  foreign import ccall "cinch.runtime.textF64ToDecimal" f64-to-decimal :: F64 -> Bytes
  foreign import ccall "cinch.runtime.textF64FromDecimal" f64-from-decimal :: Bytes -> F64

  -- The A6 column codec for integers (decision D65's covered set):
  -- 8 bytes little-endian.
  implicit instance Codec_I64 :: Codec I64 where
    encode x =
      let out = bytes-new 8 in
      let u0 = bytes-set out 0 (i64-le-byte x 0) in
      let u1 = bytes-set out 1 (i64-le-byte x 8) in
      let u2 = bytes-set out 2 (i64-le-byte x 16) in
      let u3 = bytes-set out 3 (i64-le-byte x 24) in
      let u4 = bytes-set out 4 (i64-le-byte x 32) in
      let u5 = bytes-set out 5 (i64-le-byte x 40) in
      let u6 = bytes-set out 6 (i64-le-byte x 48) in
      let u7 = bytes-set out 7 (i64-le-byte x 56) in
      out
    decode b =
      if bytes-len b == 8 then
        let d0 = nat-to-i64 (bytes-get b 0) in
        let d1 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 1)) 8 in
        let d2 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 2)) 16 in
        let d3 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 3)) 24 in
        let d4 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 4)) 32 in
        let d5 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 5)) 40 in
        let d6 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 6)) 48 in
        let d7 = wrapping-shl-i64 (nat-to-i64 (bytes-get b 7)) 56 in
        Some (bit-or-i64 d0 (bit-or-i64 d1 (bit-or-i64 d2 (bit-or-i64 d3
          (bit-or-i64 d4 (bit-or-i64 d5 (bit-or-i64 d6 d7)))))))
      else None

  -- The A6 JSON column codec for integers (decision D65's covered
  -- set): `JsonCodec`'s round-trip law (`decode-json (encode-json x)`
  -- is `Ok x`), with the named range error.
  implicit instance JsonCodec_I64 :: JsonCodec I64 where
    encode-json x = JNum (int-from-i64 x)
    decode-json j = case j of
      -- Outside the `I64` range is the named range error (the check is
      -- the conversion's own: `checked-int-to-i64`).
      JNum n -> case checked-int-to-i64 n of
        Some v -> Ok v
        None -> Err (OutOfRange "I64")
      _ -> Err (TypeMismatch "integer")

  -- Kernel-verified algebraic rewrite rules (`justify verify`, LRAT-checked).
  rewrite wrapping-add-u32-zero forall (x :: U32). where
    match (wrapping-add-u32 x 0)
    replace x
    justify verify

  rewrite wrapping-add-u32-self forall (x :: U32). where
    match (wrapping-add-u32 x x)
    replace (wrapping-shl-u32 x 1)
    justify verify

  rewrite wrapping-sub-u32-self forall (x :: U32). where
    match (wrapping-sub-u32 x x)
    replace 0
    justify verify

  rewrite bit-xor-u32-self forall (x :: U32). where
    match (bit-xor-u32 x x)
    replace 0
    justify verify

  rewrite bit-xor-u32-cancel forall (x :: U32) (y :: U32). where
    match (bit-xor-u32 (bit-xor-u32 x y) y)
    replace x
    justify verify

  rewrite bit-not-u32-involution forall (x :: U32). where
    match (bit-not-u32 (bit-not-u32 x))
    replace x
    justify verify

  rewrite bit-and-u32-zero forall (x :: U32). where
    match (bit-and-u32 x 0)
    replace 0
    justify verify

  rewrite bit-or-u32-zero forall (x :: U32). where
    match (bit-or-u32 x 0)
    replace x
    justify verify

  rewrite wrapping-add-u64-zero forall (x :: U64). where
    match (wrapping-add-u64 x 0)
    replace x
    justify verify

  rewrite wrapping-add-u64-self forall (x :: U64). where
    match (wrapping-add-u64 x x)
    replace (wrapping-shl-u64 x 1)
    justify verify

  rewrite wrapping-sub-u64-self forall (x :: U64). where
    match (wrapping-sub-u64 x x)
    replace 0
    justify verify

  rewrite bit-xor-u64-self forall (x :: U64). where
    match (bit-xor-u64 x x)
    replace 0
    justify verify

  rewrite bit-xor-u64-cancel forall (x :: U64) (y :: U64). where
    match (bit-xor-u64 (bit-xor-u64 x y) y)
    replace x
    justify verify

  rewrite bit-not-u64-involution forall (x :: U64). where
    match (bit-not-u64 (bit-not-u64 x))
    replace x
    justify verify

  rewrite bit-and-u64-zero forall (x :: U64). where
    match (bit-and-u64 x 0)
    replace 0
    justify verify

  rewrite bit-or-u64-zero forall (x :: U64). where
    match (bit-or-u64 x 0)
    replace x
    justify verify
