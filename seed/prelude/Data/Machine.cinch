  saturating-usize-to-isize x = if word-size32 0 then i32-to-isize (saturating-u32-to-i32 (wrapping-usize-to-u32 x)) else wrapping-i64-to-isize (saturating-u64-to-i64 (usize-to-u64 x))
  wrapping-isize-to-usize :: Isize -> Usize
  wrapping-isize-to-usize x = if word-size32 0 then u32-to-usize (wrapping-i32-to-u32 (wrapping-isize-to-i32 x)) else wrapping-u64-to-usize (wrapping-i64-to-u64 (isize-to-i64 x))
  checked-isize-to-usize :: Isize -> Option Usize
  checked-isize-to-usize x = if word-size32 0 then (case checked-i32-to-u32 (wrapping-isize-to-i32 x) of Some v -> Some (u32-to-usize v); None -> None) else (case checked-i64-to-u64 (isize-to-i64 x) of Some v -> Some (wrapping-u64-to-usize v); None -> None)
  saturating-isize-to-usize :: Isize -> Usize
  saturating-isize-to-usize x = if word-size32 0 then u32-to-usize (saturating-i32-to-u32 (wrapping-isize-to-i32 x)) else wrapping-u64-to-usize (saturating-i64-to-u64 (isize-to-i64 x))
  usize-to-f32 :: Usize -> F32
  usize-to-f32 x = u64-to-f32 (usize-to-u64 x)
  usize-to-f64 :: Usize -> F64
  usize-to-f64 x = u64-to-f64 (usize-to-u64 x)
  isize-to-f32 :: Isize -> F32
  isize-to-f32 x = i64-to-f32 (isize-to-i64 x)
  isize-to-f64 :: Isize -> F64
  isize-to-f64 x = i64-to-f64 (isize-to-i64 x)
  checked-f64-to-i8 :: F64 -> Option I8
  checked-f64-to-i8 x = if f64-fits-i8 x then Some (saturating-f64-to-i8 x) else None
  checked-f32-to-i8 :: F32 -> Option I8
  checked-f32-to-i8 x = checked-f64-to-i8 (f32-to-f64 x)
  saturating-f32-to-i8 :: F32 -> I8
  saturating-f32-to-i8 x = saturating-f64-to-i8 (f32-to-f64 x)
  checked-f64-to-i16 :: F64 -> Option I16
  checked-f64-to-i16 x = if f64-fits-i16 x then Some (saturating-f64-to-i16 x) else None
  checked-f32-to-i16 :: F32 -> Option I16
  checked-f32-to-i16 x = checked-f64-to-i16 (f32-to-f64 x)
  saturating-f32-to-i16 :: F32 -> I16
  saturating-f32-to-i16 x = saturating-f64-to-i16 (f32-to-f64 x)
  checked-f64-to-i32 :: F64 -> Option I32
  checked-f64-to-i32 x = if f64-fits-i32 x then Some (saturating-f64-to-i32 x) else None
  checked-f32-to-i32 :: F32 -> Option I32
  checked-f32-to-i32 x = checked-f64-to-i32 (f32-to-f64 x)
  saturating-f32-to-i32 :: F32 -> I32
  saturating-f32-to-i32 x = saturating-f64-to-i32 (f32-to-f64 x)
  checked-f64-to-i64 :: F64 -> Option I64
  checked-f64-to-i64 x = if f64-fits-i64 x then Some (saturating-f64-to-i64 x) else None
  checked-f32-to-i64 :: F32 -> Option I64
  checked-f32-to-i64 x = checked-f64-to-i64 (f32-to-f64 x)
  saturating-f32-to-i64 :: F32 -> I64
  saturating-f32-to-i64 x = saturating-f64-to-i64 (f32-to-f64 x)
  checked-f64-to-u8 :: F64 -> Option U8
  checked-f64-to-u8 x = if f64-fits-u8 x then Some (saturating-f64-to-u8 x) else None
  checked-f32-to-u8 :: F32 -> Option U8
  checked-f32-to-u8 x = checked-f64-to-u8 (f32-to-f64 x)
  saturating-f32-to-u8 :: F32 -> U8
  saturating-f32-to-u8 x = saturating-f64-to-u8 (f32-to-f64 x)
  checked-f64-to-u16 :: F64 -> Option U16
  checked-f64-to-u16 x = if f64-fits-u16 x then Some (saturating-f64-to-u16 x) else None
  checked-f32-to-u16 :: F32 -> Option U16
  checked-f32-to-u16 x = checked-f64-to-u16 (f32-to-f64 x)
  saturating-f32-to-u16 :: F32 -> U16
  saturating-f32-to-u16 x = saturating-f64-to-u16 (f32-to-f64 x)
  checked-f64-to-u32 :: F64 -> Option U32
  checked-f64-to-u32 x = if f64-fits-u32 x then Some (saturating-f64-to-u32 x) else None
  checked-f32-to-u32 :: F32 -> Option U32
  checked-f32-to-u32 x = checked-f64-to-u32 (f32-to-f64 x)
  saturating-f32-to-u32 :: F32 -> U32
  saturating-f32-to-u32 x = saturating-f64-to-u32 (f32-to-f64 x)
  checked-f64-to-u64 :: F64 -> Option U64
  checked-f64-to-u64 x = if f64-fits-u64 x then Some (saturating-f64-to-u64 x) else None
  checked-f32-to-u64 :: F32 -> Option U64
