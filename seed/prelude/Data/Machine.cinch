  -- Fixed-width integer bounds, checked/saturating arithmetic, and shifts.
  min-bound-i8 :: refined (r == -128) I8
  min-bound-i8 = -128
  max-bound-i8 :: refined (r == 127) I8
  max-bound-i8 = 127
  checked-add-i8 :: I8 -> I8 -> Option I8
  checked-add-i8 x y = if ov-add-i8 x y then None else Some (wrapping-add-i8 x y)
  checked-sub-i8 :: I8 -> I8 -> Option I8
  checked-sub-i8 x y = if ov-sub-i8 x y then None else Some (wrapping-sub-i8 x y)
  checked-mul-i8 :: I8 -> I8 -> Option I8
  checked-mul-i8 x y = if ov-mul-i8 x y then None else Some (wrapping-mul-i8 x y)
  checked-neg-i8 :: I8 -> Option I8
  checked-neg-i8 x = if eq-i8 x min-bound-i8 then None else Some (wrapping-neg-i8 x)
  saturating-neg-i8 :: I8 -> I8
  saturating-neg-i8 x = if eq-i8 x min-bound-i8 then max-bound-i8 else wrapping-neg-i8 x
  checked-div-i8 :: I8 -> I8 -> Option I8
  checked-div-i8 x y = case decide (y /= 0 && Not (x == -128 && y == -1)) of
    Yes _ -> Some (raw-sdiv-i8 x y)
    No _ -> None
  checked-rem-i8 :: I8 -> I8 -> Option I8
  checked-rem-i8 x y = case decide (y /= 0 && Not (x == -128 && y == -1)) of
    Yes _ -> Some (raw-srem-i8 x y)
    No _ -> None
  checked-shl-i8 :: I8 -> U32 -> Option I8
