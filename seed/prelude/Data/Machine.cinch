  prim f32-bits :: F32 -> U32 where
    llvm {
      %r = bitcast float %0 to i32
      ret i32 %r
    }

  prim f32-from-bits :: U32 -> F32 where
    llvm {
      %r = bitcast i32 %0 to float
      ret float %r
    }

  prim add-f32 :: F32 -> F32 -> F32 where
    llvm {
      %r = fadd float %0, %1
      ret float %r
    }

  prim sub-f32 :: F32 -> F32 -> F32 where
    llvm {
      %r = fsub float %0, %1
      ret float %r
    }

  prim mul-f32 :: F32 -> F32 -> F32 where
    llvm {
      %r = fmul float %0, %1
      ret float %r
    }

  prim div-f32 :: F32 -> F32 -> F32 where
    llvm {
      %r = fdiv float %0, %1
      ret float %r
    }

  prim neg-f32 :: F32 -> F32 where
    llvm {
      %r = fneg float %0
      ret float %r
    }

  prim abs-f32 :: F32 -> F32 where
    llvm {
      %r = call float @llvm.fabs.f32(float %0)
      ret float %r
    }

  prim sqrt-f32 :: F32 -> F32 where
    llvm {
      %r = call float @llvm.sqrt.f32(float %0)
      ret float %r
    }

  prim copysign-f32 :: F32 -> F32 -> F32 where
    llvm {
      %r = call float @llvm.copysign.f32(float %0, float %1)
      ret float %r
    }

  prim floor-f32 :: F32 -> F32 where
    llvm {
      %r = call float @llvm.floor.f32(float %0)
      ret float %r
    }

  prim ceil-f32 :: F32 -> F32 where
    llvm {
      %r = call float @llvm.ceil.f32(float %0)
      ret float %r
    }

  prim trunc-f32 :: F32 -> F32 where
    llvm {
      %r = call float @llvm.trunc.f32(float %0)
      ret float %r
    }

  prim round-f32 :: F32 -> F32 where
    llvm {
      %r = call float @llvm.round.f32(float %0)
      ret float %r
    }

  prim round-to-even-f32 :: F32 -> F32 where
    llvm {
      %r = call float @llvm.roundeven.f32(float %0)
      ret float %r
    }

  prim feq-f32 :: F32 -> F32 -> Bool where
    llvm {
      %c = fcmp oeq float %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    }

  prim fne-f32 :: F32 -> F32 -> Bool where
    llvm {
      %c = fcmp une float %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    }

  prim flt-f32 :: F32 -> F32 -> Bool where
    llvm {
      %c = fcmp olt float %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    }

  prim fle-f32 :: F32 -> F32 -> Bool where
    llvm {
      %c = fcmp ole float %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    }

  prim fgt-f32 :: F32 -> F32 -> Bool where
    llvm {
      %c = fcmp ogt float %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    }

  prim fge-f32 :: F32 -> F32 -> Bool where
    llvm {
      %c = fcmp oge float %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    }

  is-na-nf32 :: F32 -> Bool
  is-na-nf32 x = fne-f32 x x

  is-infinite-f32 :: F32 -> Bool
  is-infinite-f32 x = eq-u32 (bit-and-u32 (f32-bits x) 2147483647) 2139095040

  is-finite-f32 :: F32 -> Bool
  is-finite-f32 x = lt-u32 (bit-and-u32 (f32-bits x) 2147483647) 2139095040

  is-normal-f32 :: F32 -> Bool
  is-normal-f32 x =
    let e = bit-and-u32 (f32-bits x) 2139095040 in
    if ne-u32 e 0 then ne-u32 e 2139095040 else False

  sign-bit-f32 :: F32 -> Bool
  sign-bit-f32 x = ne-u32 (bit-and-u32 (f32-bits x) 2147483648) 0

  minimum-f32 :: F32 -> F32 -> F32
  minimum-f32 x y =
    if is-na-nf32 x then f32-from-bits (bit-or-u32 (f32-bits x) 4194304)
    else if is-na-nf32 y then f32-from-bits (bit-or-u32 (f32-bits y) 4194304)
    else if feq-f32 x y then f32-from-bits (bit-or-u32 (f32-bits x) (f32-bits y))
    else if flt-f32 x y then x
    else y

  maximum-f32 :: F32 -> F32 -> F32
  maximum-f32 x y =
    if is-na-nf32 x then f32-from-bits (bit-or-u32 (f32-bits x) 4194304)
    else if is-na-nf32 y then f32-from-bits (bit-or-u32 (f32-bits y) 4194304)
    else if feq-f32 x y then f32-from-bits (bit-and-u32 (f32-bits x) (f32-bits y))
    else if fgt-f32 x y then x
    else y

  total-order-f32-key :: F32 -> U32
  total-order-f32-key x =
    let b = f32-bits x in
    if ne-u32 (bit-and-u32 b 2147483648) 0 then bit-not-u32 b
    else bit-or-u32 b 2147483648

  total-order-f32 :: F32 -> F32 -> Ordering
  total-order-f32 x y =
    let kx = total-order-f32-key x in
    let ky = total-order-f32-key y in
    if lt-u32 kx ky then LT else if eq-u32 kx ky then EQ else GT

