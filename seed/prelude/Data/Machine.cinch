  checked-f64-to-isize :: F64 -> Option Isize
  checked-f64-to-isize x = if word-size32 0 then (case checked-f64-to-i32 x of Some v -> Some (i32-to-isize v); None -> None) else (case checked-f64-to-i64 x of Some v -> Some (wrapping-i64-to-isize v); None -> None)
