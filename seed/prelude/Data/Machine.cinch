  -- Usize and Isize (target pointer width; pure Cinch over U32/U64 and I32/I64).
  min-bound-usize :: Usize
  min-bound-usize = 0
  max-bound-usize :: Usize
  max-bound-usize = if word-size32 0 then u32-to-usize max-bound-u32 else wrapping-u64-to-usize max-bound-u64
  min-bound-isize :: Isize
  min-bound-isize = if word-size32 0 then i32-to-isize min-bound-i32 else wrapping-i64-to-isize min-bound-i64
  max-bound-isize :: Isize
