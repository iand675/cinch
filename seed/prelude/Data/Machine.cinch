  total-order-f64-key x =
    let b = f64-bits x in
    if ne-u64 (bit-and-u64 b 9223372036854775808) 0 then bit-not-u64 b
    else bit-or-u64 b 9223372036854775808

  total-order-f64 :: F64 -> F64 -> Ordering
  total-order-f64 x y =
    let kx = total-order-f64-key x in
    let ky = total-order-f64-key y in
    if lt-u64 kx ky then LT else if eq-u64 kx ky then EQ else GT

