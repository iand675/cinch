  saturating-f32-to-u64 :: F32 -> U64
  saturating-f32-to-u64 x = saturating-f64-to-u64 (f32-to-f64 x)
  checked-f64-to-usize :: F64 -> Option Usize
  checked-f64-to-usize x = if word-size32 0 then (case checked-f64-to-u32 x of Some v -> Some (u32-to-usize v); None -> None) else (case checked-f64-to-u64 x of Some v -> Some (wrapping-u64-to-usize v); None -> None)
  saturating-f64-to-usize :: F64 -> Usize
  saturating-f64-to-usize x = if word-size32 0 then u32-to-usize (saturating-f64-to-u32 x) else wrapping-u64-to-usize (saturating-f64-to-u64 x)
