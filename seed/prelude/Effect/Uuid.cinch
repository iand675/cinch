-- | Secure UUID generation with explicit serialized version 7 ownership.
-- Entropy comes from the system random capability and time from the wall clock.
-- One shared generator orders timestamp transitions; separate generators define
-- independent sequences. Entropy acquisition occurs after releasing the state
-- cell, so overlapping calls are ordered at that transition rather than by
-- completion time. Plain blocking operations preserve the full effect row.
module Effect.Uuid where
  import Data.Core
  import Data.Nat
  import Data.Uuid
  import Effect.Random (random-bytes)
  import Effect.Clock (clock-wall-ns)
  import Effect.Concurrent.MVar

  export UuidV7Generator, uuid-new, uuid-new-v4, uuid-v7-generator, uuid-new-v7

  -- | One explicitly shared serialized timestamp sequence with no public access to its state cell.
  data UuidV7Generator where
    -- | Own the full state while allowing safe shared generator handles.
    Generator :: MVar UuidV7State -> UuidV7Generator

  -- | Generate the current default version 4 value using 16 fresh secure random bytes.
  uuid-new :: forall (r :: Region). using (io :: Io r) => Unit ->{IO r} Result UuidError Uuid
  uuid-new unit = uuid-new-v4 unit

  -- | Acquire real secure entropy and preserve 122 random bits after version/variant masking.
  uuid-new-v4 :: forall (r :: Region). using (io :: Io r) => Unit ->{IO r} Result UuidError Uuid
  uuid-new-v4 unit = uuid-v4-from-random (random-bytes 16)

  -- | Allocate one serialized version 7 sequence; retain and share this handle for shared ordering.
  uuid-v7-generator :: Unit ->{MVar} UuidV7Generator
  uuid-v7-generator unit = Generator (mvar-new uuid-v7-initial)

  -- | Sample real wall time under the state lock, commit its transition, then acquire eight secure random bytes.
  -- A whole-second clock rollback resets the ordering constraint. Same-second
  -- rollback and equal timestamps advance the logical fraction monotonically.
  -- Checked clock refusals restore the old state before returning an error.
  uuid-new-v7 :: forall (r :: Region). using (io :: Io r) => UuidV7Generator -> Unit ->{MVar, IO r, Diverge} Result UuidError Uuid
  uuid-new-v7 generator unit = case generator of
    Generator cell ->
      let previous = mvar-take cell in
      let now = clock-wall-ns () in
      case uuid-v7-advance previous now of
        Err error -> let restored = mvar-put cell previous in Err error
        Ok pair -> case pair of
          (next, tick) ->
            let committed = mvar-put cell next in
            uuid-v7-from-tick tick (random-bytes 8)
