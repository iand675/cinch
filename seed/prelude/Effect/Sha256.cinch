-- | Inspectable SHA-224/SHA-256 hashing sinks and bounded reader-to-digest copying.
-- The immutable digest state is the sink handle. Writes accept every byte and
-- never retain input buffers. Copying returns the advanced reader and the last
-- valid digest on failure, and never closes a borrowed source.
module Effect.Sha256 where

  import Effect.Stream
  import Text.Sha256
  import Data.Bytes
  import Data.Nat
  import Data.Result

  export sha256-write, sha256-hashing-writer, sha256-copy

  -- | Hash a whole chunk, returning its accepted count and the advanced immutable state.
  sha256-write :: forall r. using (io :: Io r) => Sha256State -> Bytes ->{IO r} (Nat, Sha256State)
  sha256-write state input = (bytes-len input, sha256-state-update state input)

  -- | Adapt a digest state to the generic byte-writer protocol.
  -- Use the explicit state or sha256-copy when the advanced digest must be inspected.
  sha256-hashing-writer :: forall r. using (io :: Io r) => Sha256State -> ByteWriter r
  sha256-hashing-writer state = stream-writer (\input -> case sha256-write state input of
    (count, next) -> (Ok count, sha256-hashing-writer next))

  -- | Hash successful reader chunks through EOF, preserving both advanced handles on errors.
  -- A zero chunk size is rejected before reading. Invalid source counts do not enter the digest.
  sha256-copy :: forall r. using (io :: Io r) => Nat -> ByteReader r -> Sha256State ->{IO r} (Result StreamError Nat, (ByteReader r, Sha256State))
  sha256-copy chunk source state =
    if chunk == 0 then (Err StreamInvalidChunkSize, (source, state))
    else copy-from chunk source state 0

  -- | Carry only the opaque digest state and accepted byte count through the bounded copying loop.
  copy-from :: forall r. using (io :: Io r) => Nat -> ByteReader r -> Sha256State -> Nat ->{IO r} (Result StreamError Nat, (ByteReader r, Sha256State))
  copy-from chunk source state count = case stream-read source chunk of
    (Err error, next) -> (Err error, (next, state))
    (Ok input, next) -> if bytes-len input == 0 then (Ok count, (next, state))
      else copy-from chunk next (sha256-state-update state input) (count + bytes-len input)
