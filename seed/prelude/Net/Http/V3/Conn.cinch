  #[inline(always)] #[no-alloc] h3-conn-qpack-table :: H3Conn -> QpackDynamicTable
  h3-conn-qpack-table c = c.h3c-qpack

  #[inline(always)] #[no-alloc] h3-conn-priority-sched :: H3Conn -> PriorityScheduler
