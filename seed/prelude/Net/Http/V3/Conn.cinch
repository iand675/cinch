-- | Zero-allocation (`#[no-alloc]` steady-state) RFC 9114 HTTP/3 connection
-- engine (`H3Conn`) layered cleanly over `Net.Quic.Conn` + `Net.Http.Qpack.Codec`
-- + `Net.Http.Priority` + `Net.Http.V3.Frame` (`Net.Http.V3.Conn`).
--
-- Features:
--   * Local Control (`0x00`), QPACK Encoder (`0x02`), and QPACK Decoder (`0x03`)
--     unidirectional stream initialization with initial `SETTINGS` frame
--     (`QPACK_MAX_TABLE_CAPACITY = 0` zero-HOL default, `H3_DATAGRAM = 1`,
--     `ENABLE_CONNECT_PROTOCOL = 1`).
--   * Strict RFC 9114 critical-stream & framing invariants:
--       - At most ONE peer Control, ONE peer QPACK Encoder, ONE peer QPACK Decoder
--         stream (duplicate -> `H3_STREAM_CREATION_ERROR`).
--       - First frame on peer Control stream MUST be `SETTINGS`
--         (anything else -> `H3_MISSING_SETTINGS`; second `SETTINGS` -> `H3_FRAME_UNEXPECTED`).
--       - Closing any critical unidirectional stream -> `H3_CLOSED_CRITICAL_STREAM`.
--       - `DATA` / `HEADERS` / `PUSH_PROMISE` forbidden on Control stream;
--         `SETTINGS` / `GOAWAY` / `PRIORITY_UPDATE` forbidden on Request stream;
--         forbidden HTTP/2 frame types -> `H3_FRAME_UNEXPECTED`.
--   * Request bidirectional streams: decodes `HEADERS` via `Net.Http.Qpack.Codec`
--     (zero-HOL `blocked_streams == 0` fast path + bounded dynamic interop),
--     feeds `DATA` spans, encodes responses (`HEADERS` + `DATA`) prioritized by
--     `Net.Http.Priority.PriorityScheduler`, handles `GOAWAY` graceful drain,
--     and dispatches RFC 9297 H3 Datagrams (`h3-conn-send-datagram` /
--     `h3-conn-recv-datagram`).
--   * End-to-end client/server H3-over-QUIC driver (`h3-conn-drive-quic`)
--     exchanging real protected QUIC packets between client and server.
module Net.Http.V3.Conn where

  import Data.Bool
  import Data.Core
  import Data.Machine
  import Data.Option
  import Engine.Types
  import Net.Http.Types
  import Net.Http.Priority
  import Net.Http.Qpack.StaticTable
  import Net.Http.Qpack.Codec
  import Net.Http.V3.Frame
  import Net.Quic.Types
  import Net.Quic.Varint
  import Net.Quic.Stream
  import Net.Quic.Conn
  import Prim.Atomic

  -- Roles, connection states & feed status codes
  export h3-role-client, h3-role-server
  export h3-state-init, h3-state-open, h3-state-goaway, h3-state-error, h3-state-closed
  export h3-feed-ok, h3-feed-need-more, h3-feed-headers-ready, h3-feed-data-ready
  export h3-feed-settings-ready, h3-feed-goaway, h3-feed-priority-update, h3-feed-error
  export h3-req-idle, h3-req-headers-rcvd, h3-req-body-rcvd, h3-req-resp-queued, h3-req-closed
  export h3-sid-unset, h3-slot-none

  -- Handles & POD result structs
  export H3Conn, H3FeedResult, H3FlushResult
  export h3-conn-valid, h3-conn-new, h3-conn-new-with-qpack, h3-conn-destroy
  export h3-feed-result-ok

  -- Telemetry & accessors (#[no-alloc])
  export h3-conn-role, h3-conn-state, h3-conn-last-error
  export h3-conn-peer-settings-seen, h3-conn-peer-settings, h3-conn-local-settings
  export h3-conn-peer-ctrl-count, h3-conn-peer-qenc-count, h3-conn-peer-qdec-count
  export h3-conn-local-ctrl-sid, h3-conn-local-qenc-sid, h3-conn-local-qdec-sid
  export h3-conn-peer-ctrl-sid, h3-conn-peer-qenc-sid, h3-conn-peer-qdec-sid
  export h3-conn-goaway-sent, h3-conn-goaway-recv, h3-conn-local-goaway-id, h3-conn-peer-goaway-id
  export h3-conn-active-req-count, h3-conn-total-req-opened, h3-conn-total-req-closed
  export h3-conn-decoded-hdrs-addr, h3-conn-decoded-text-addr
  export h3-conn-decoded-hdr-count, h3-conn-decoded-text-len
  export h3-conn-last-data-addr, h3-conn-last-data-len, h3-conn-last-req-sid
  export h3-conn-dgram-sent-count, h3-conn-dgram-recv-count
  export h3-conn-qpack-table, h3-conn-priority-sched
  export h3-conn-req-priority, h3-conn-req-data-total, h3-conn-req-fin-rcvd, h3-conn-req-status

  -- Direct framing & stream feed APIs (#[no-alloc])
  export h3-conn-write-initial-control-stream
  export h3-conn-feed-uni, h3-conn-feed-request
  export h3-encode-headers-frame-zero-hol, h3-encode-request-raw, h3-encode-response-raw
  export h3-conn-queue-response, h3-conn-flush-priority-dma
  export h3-conn-set-req-priority

  -- QUIC-layered HTTP/3 transport operations (#[no-alloc] + end-to-end driver)
  export h3-conn-init-quic-streams, h3-conn-poll-quic
  export h3-conn-send-request-quic, h3-conn-send-response-quic
  export h3-conn-flush-priority-quic
  export h3-conn-send-goaway-quic, h3-conn-send-priority-update-quic
  export h3-conn-send-datagram, h3-conn-recv-datagram
  export h3-conn-drive-quic

  -- =========================================================================
  -- 0. Constants, Slab Layout & #[no-alloc] Helpers
  -- =========================================================================

  #[inline(always)] #[no-alloc] b-true :: Bool
  b-true = eq-u32 0 0

  #[inline(always)] #[no-alloc] b-false :: Bool
  b-false = eq-u32 0 1

  #[inline(always)] #[no-alloc] b-not :: Bool -> Bool
  b-not x = if x then b-false else b-true

  #[inline(always)] #[no-alloc] both :: Bool -> Bool -> Bool
  both a b = if a then b else b-false

  #[inline(always)] #[no-alloc] either :: Bool -> Bool -> Bool
  either a b = if a then b-true else b

  #[inline(always)] #[no-alloc] addr-at :: U64 -> U64 -> I64
  addr-at base off = wrapping-u64-to-i64 (wrapping-add-u64 base off)

  #[inline(always)] #[no-alloc] min-u32 :: U32 -> U32 -> U32
  min-u32 a b = if lt-u32 a b then a else b

  #[inline(always)] #[no-alloc] store-u16-raw :: I64 -> U16 ->{MVar} Unit
  store-u16-raw addr v =
    let _0 = raw-store-u8 addr (wrapping-u16-to-u8 v) in
    raw-store-u8 (wrapping-add-i64 addr 1) (wrapping-u16-to-u8 (wrapping-shr-u16 v 8))

  #[inline(always)] #[no-alloc] load-u16-raw :: I64 ->{MVar} U16
  load-u16-raw addr =
    let lo = u8-to-u16 (raw-load-u8 addr) in
    let hi = u8-to-u16 (raw-load-u8 (wrapping-add-i64 addr 1)) in
    bit-or-u16 lo (wrapping-shl-u16 hi 8)

  #[inline(always)] #[no-alloc] h3-sid-unset :: U64
  h3-sid-unset = 18446744073709551615

  #[inline(always)] #[no-alloc] h3-slot-none :: U32
  h3-slot-none = 4294967295

