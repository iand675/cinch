  #[inline(always)] #[no-alloc] h3-conn-local-qenc-sid :: H3Conn ->{MVar} U64
  h3-conn-local-qenc-sid c = raw-load-u64 (addr-at c.h3c-base off-lqenc-sid)

  #[inline(always)] #[no-alloc] h3-conn-local-qdec-sid :: H3Conn ->{MVar} U64
  h3-conn-local-qdec-sid c = raw-load-u64 (addr-at c.h3c-base off-lqdec-sid)

  #[inline(always)] #[no-alloc] h3-conn-peer-ctrl-sid :: H3Conn ->{MVar} U64
  h3-conn-peer-ctrl-sid c = raw-load-u64 (addr-at c.h3c-base off-pctrl-sid)

  #[inline(always)] #[no-alloc] h3-conn-peer-qenc-sid :: H3Conn ->{MVar} U64
