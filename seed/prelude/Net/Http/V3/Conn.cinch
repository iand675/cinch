  #[inline(always)] #[no-alloc] h3-conn-peer-settings :: H3Conn ->{MVar} H3Settings
  h3-conn-peer-settings c =
    let b = c.h3c-base in
    H3Settings
      (raw-load-u64 (addr-at b off-pqpack-cap))
      (raw-load-u64 (addr-at b off-pmax-fs))
      (raw-load-u64 (addr-at b off-pqpack-blk))
      (raw-load-u8 (addr-at b off-peer-en-conn))
      (raw-load-u8 (addr-at b off-peer-h3-dg))
      0 0

  #[inline(always)] #[no-alloc] h3-conn-peer-ctrl-count :: H3Conn ->{MVar} U8
  h3-conn-peer-ctrl-count c = raw-load-u8 (addr-at c.h3c-base off-peer-ctrl-cnt)

  #[inline(always)] #[no-alloc] h3-conn-peer-qenc-count :: H3Conn ->{MVar} U8
