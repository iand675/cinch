  #[no-alloc]
  dma-copy :: I64 -> I64 -> U32 ->{MVar} Unit
  dma-copy dst src rem =
    if ge-u32 rem 16 then
      let v = raw-load-u128 src in
      let _ = raw-store-u128 dst v in
      dma-copy (wrapping-add-i64 dst 16) (wrapping-add-i64 src 16) (wrapping-sub-u32 rem 16)
    else if ge-u32 rem 8 then
      let v = raw-load-u64 src in
      let _ = raw-store-u64 dst v in
      dma-copy (wrapping-add-i64 dst 8) (wrapping-add-i64 src 8) (wrapping-sub-u32 rem 8)
    else if gt-u32 rem 0 then
      let v = raw-load-u8 src in
      let _ = raw-store-u8 dst v in
      dma-copy (wrapping-add-i64 dst 1) (wrapping-add-i64 src 1) (wrapping-sub-u32 rem 1)
    else ()

  -- Shift bytes left within buffer `buf`: `buf[0..rem) = buf[consumed..consumed+rem)`
  #[no-alloc]
  shift-left-bytes :: I64 -> U32 -> U32 -> U32 ->{MVar} Unit
  shift-left-bytes buf i consumed rem =
    if ge-u32 i rem then ()
    else
      let b = raw-load-u8 (wrapping-add-i64 buf (u32-to-i64 (wrapping-add-u32 consumed i))) in
      let _ = raw-store-u8 (wrapping-add-i64 buf (u32-to-i64 i)) b in
      shift-left-bytes buf (wrapping-add-u32 i 1) consumed rem

  -- =========================================================================
  -- 1. Core Handles & Unboxed Result Types
  -- =========================================================================

  -- | Handle to an HTTP/3 connection engine (allocated once in `h3-conn-new`;
  -- all steady-state operations run `#[no-alloc]` with zero atomic RC).
  record H3Conn where
    h3c-base :: U64
    h3c-sched :: PriorityScheduler
    h3c-qpack :: QpackDynamicTable

  -- | 32-byte POD feed result returned by `h3-conn-feed-uni`,
  -- `h3-conn-feed-request`, and `h3-conn-poll-quic`.
  #[repr(C, value)]
  record H3FeedResult where
    h3fr-stream-id :: U64
    h3fr-error :: U64
    h3fr-status :: U32
    h3fr-consumed :: U32
    h3fr-aux :: U32
    h3fr-pad :: U32

  -- | 24-byte POD result returned by `h3-conn-flush-priority-dma`.
  #[repr(C, value)]
  record H3FlushResult where
    h3fl-stream-id :: U64
    h3fl-written :: U32
    h3fl-body-sent :: U32
    h3fl-done :: U8
    h3fl-ok :: U8
    h3fl-pad :: U16
    h3fl-pad2 :: U32

  #[inline(always)]
  #[no-alloc]
  h3-feed-result-ok :: U64 -> U32 -> H3FeedResult
  h3-feed-result-ok sid consumed = H3FeedResult sid h3-err-no-error h3-feed-ok consumed 0 0

  #[inline(always)]
  #[no-alloc]
  h3-conn-valid :: H3Conn -> Bool
  h3-conn-valid c = ne-u64 c.h3c-base 0

  -- =========================================================================
  -- 2. Lifecycle (`h3-conn-new`, `h3-conn-new-with-qpack`, `h3-conn-destroy`)
  -- =========================================================================

  -- | Allocate and initialize an HTTP/3 connection (`role`: `h3-role-client` or
  -- `h3-role-server`) with configurable local `QPACK_MAX_TABLE_CAPACITY` (`0` =
  -- zero-HOL default; `> 0` = bounded dynamic QPACK interop).
  h3-conn-new-with-qpack :: U8 -> U64 ->{IO, MVar} Option H3Conn
  h3-conn-new-with-qpack role qpack-max-cap =
    let base = engine-dma-alloc h3c-slab-size 4096 in
    if eq-u64 base 0 then None
    else
      case prio-sched-new h3c-max-req of
        None ->
          let _ = engine-dma-free base h3c-slab-size in
          None
        Some sched ->
          case qpack-table-new qpack-max-cap of
            None ->
              let _0 = prio-sched-destroy sched in
              let _1 = engine-dma-free base h3c-slab-size in
              None
            Some qtbl ->
              let def = h3-settings-default () in
              let _0 = raw-store-u8 (addr-at base off-role) (if ne-u8 role 0 then 1 else 0) in
              let _1 = raw-store-u8 (addr-at base off-state) h3-state-init in
              let _2 = raw-store-u64 (addr-at base off-last-err) h3-err-no-error in
              let _3 = raw-store-u64 (addr-at base off-lctrl-sid) h3-sid-unset in
              let _4 = raw-store-u64 (addr-at base off-lqenc-sid) h3-sid-unset in
              let _5 = raw-store-u64 (addr-at base off-lqdec-sid) h3-sid-unset in
              let _6 = raw-store-u64 (addr-at base off-pctrl-sid) h3-sid-unset in
              let _7 = raw-store-u64 (addr-at base off-pqenc-sid) h3-sid-unset in
              let _8 = raw-store-u64 (addr-at base off-pqdec-sid) h3-sid-unset in
              let _9 = raw-store-u32 (addr-at base off-lctrl-qslot) h3-slot-none in
              let _a = raw-store-u32 (addr-at base off-lqenc-qslot) h3-slot-none in
              let _b = raw-store-u32 (addr-at base off-lqdec-qslot) h3-slot-none in
              let _c = raw-store-u64 (addr-at base off-pgoaway-id) h3-sid-unset in
              let _d = raw-store-u64 (addr-at base off-lgoaway-id) h3-sid-unset in
              let _e = raw-store-u64 (addr-at base off-max-preq-sid) h3-sid-unset in
              let _f = raw-store-u64 (addr-at base off-last-req-sid) h3-sid-unset in
              -- Local settings (zero-HOL default when qpack-max-cap == 0)
              let _g = raw-store-u64 (addr-at base off-lqpack-cap) qpack-max-cap in
              let _h = raw-store-u64 (addr-at base off-lmax-fs) def.h3s-max-field-section-size in
              let _i = raw-store-u64 (addr-at base off-lqpack-blk) 0 in
              let _j = raw-store-u8 (addr-at base off-local-en-conn) def.h3s-enable-connect-protocol in
              let _k = raw-store-u8 (addr-at base off-local-h3-dg) def.h3s-h3-datagram in
              -- Peer settings start at RFC 9114 initial defaults
              let _l = raw-store-u64 (addr-at base off-pqpack-cap) 0 in
              let _m = raw-store-u64 (addr-at base off-pmax-fs) 18446744073709551615 in
              let _n = raw-store-u64 (addr-at base off-pqpack-blk) 0 in
              let _o = raw-store-u8 (addr-at base off-peer-en-conn) 0 in
              let _p = raw-store-u8 (addr-at base off-peer-h3-dg) 0 in
              Some (H3Conn base sched qtbl)

  -- | Allocate and initialize a zero-HOL (`QPACK_MAX_TABLE_CAPACITY = 0`)
  -- HTTP/3 connection engine.
  h3-conn-new :: U8 ->{IO, MVar} Option H3Conn
  h3-conn-new role = h3-conn-new-with-qpack role 0

  -- | Destroy an `H3Conn`, freeing its DMA slab, `PriorityScheduler`, and QPACK table.
  h3-conn-destroy :: H3Conn ->{IO, MVar} Unit
  h3-conn-destroy conn =
    let _0 = prio-sched-destroy conn.h3c-sched in
    let _1 = qpack-table-destroy conn.h3c-qpack in
    if eq-u64 conn.h3c-base 0 then ()
    else
      let _2 = engine-dma-free conn.h3c-base h3c-slab-size in
      ()

  -- =========================================================================
  -- 3. Accessors & Telemetry (#[no-alloc])
  -- =========================================================================

  #[inline(always)] #[no-alloc] h3-conn-role :: H3Conn ->{MVar} U8
  h3-conn-role c = raw-load-u8 (addr-at c.h3c-base off-role)

  #[inline(always)] #[no-alloc] h3-conn-state :: H3Conn ->{MVar} U8
  h3-conn-state c = raw-load-u8 (addr-at c.h3c-base off-state)

  #[inline(always)] #[no-alloc] h3-conn-last-error :: H3Conn ->{MVar} U64
  h3-conn-last-error c = raw-load-u64 (addr-at c.h3c-base off-last-err)

  #[inline(always)] #[no-alloc] h3-conn-peer-settings-seen :: H3Conn ->{MVar} Bool
  h3-conn-peer-settings-seen c = ne-u8 (raw-load-u8 (addr-at c.h3c-base off-peer-settings-seen)) 0

  #[inline(always)] #[no-alloc] h3-conn-local-settings :: H3Conn ->{MVar} H3Settings
  h3-conn-local-settings c =
    let b = c.h3c-base in
    H3Settings
      (raw-load-u64 (addr-at b off-lqpack-cap))
      (raw-load-u64 (addr-at b off-lmax-fs))
      (raw-load-u64 (addr-at b off-lqpack-blk))
      (raw-load-u8 (addr-at b off-local-en-conn))
      (raw-load-u8 (addr-at b off-local-h3-dg))
