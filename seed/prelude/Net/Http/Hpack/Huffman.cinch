  -- | Return packed `(bitlen << 32) | code` for RFC 7541 Appendix B symbol `s`.
  #[no-alloc]
  hpack-huffman-entry :: U8 -> U64
  hpack-huffman-entry s =
    if lt-u8 s 128 then
      if lt-u8 s 64 then
        if lt-u8 s 32 then huff-b0 s else huff-b1 s
      else
        if lt-u8 s 96 then huff-b2 s else huff-b3 s
    else
      if lt-u8 s 192 then
        if lt-u8 s 160 then huff-b4 s else huff-b5 s
      else
        if lt-u8 s 224 then huff-b6 s else huff-b7 s

  -- | Return the canonical Huffman code (LSB-aligned, 5..30 bits) for byte `s`.
  #[inline(always)]
  #[no-alloc]
  hpack-huffman-code :: U8 -> U32
  hpack-huffman-code s = wrapping-u64-to-u32 (hpack-huffman-entry s)

  -- | Return the canonical Huffman bit length (`5..30`) for byte `s`.
  #[inline(always)]
  #[no-alloc]
  hpack-huffman-len :: U8 -> U8
  hpack-huffman-len s = wrapping-u64-to-u8 (wrapping-shr-u64 (hpack-huffman-entry s) 32)

  -- =========================================================================
  -- 2. One-Time Flat DMA Table & 2-Level 4-Bit Nibble DFA Construction
  -- =========================================================================

  #[inline(always)]
  #[no-alloc]
  trie-child-addr :: I64 -> U32 -> U32 -> I64
  trie-child-addr base node bit =
    let idx = wrapping-add-u32 (wrapping-shl-u32 node 1) bit in
    wrapping-add-i64 (wrapping-add-i64 base huff-trie-off) (wrapping-shl-i64 (u32-to-i64 idx) 2)

  #[no-alloc]
  init-trie-empty :: I64 -> U32 ->{MVar} Unit
  init-trie-empty base i =
    if ge-u32 i 512 then ()
    else
      let addr = wrapping-add-i64 (wrapping-add-i64 base huff-trie-off) (wrapping-shl-i64 (u32-to-i64 i) 2) in
      let _ = raw-store-u32 addr trie-empty in
      init-trie-empty base (wrapping-add-u32 i 1)

  #[no-alloc]
  init-encode-table :: I64 -> U32 ->{MVar} Unit
  init-encode-table base i =
    if ge-u32 i 256 then ()
    else
      let e = hpack-huffman-entry (wrapping-u32-to-u8 i) in
      let code = wrapping-u64-to-u32 e in
      let bits = wrapping-u64-to-u32 (wrapping-shr-u64 e 32) in
      let off = wrapping-shl-i64 (u32-to-i64 i) 3 in
      let _ = raw-store-u32 (wrapping-add-i64 base off) code in
      let _ = raw-store-u32 (wrapping-add-i64 base (wrapping-add-i64 off 4)) bits in
      init-encode-table base (wrapping-add-u32 i 1)

  -- Insert one symbol `(sym, code, bit-idx)` into the binary trie, returning updated `node-count`.
  #[no-alloc]
  trie-insert-bits :: I64 -> U32 -> U32 -> U32 -> U32 -> U32 ->{MVar} U32
  trie-insert-bits base cur node-count sym code bit-idx =
    let bit = bit-and-u32 (wrapping-shr-u32 code bit-idx) 1 in
    let slot = trie-child-addr base cur bit in
    if eq-u32 bit-idx 0 then
      let _ = raw-store-u32 slot (bit-or-u32 trie-leaf-bit sym) in
      node-count
    else
      let existing = raw-load-u32 slot in
      if eq-u32 existing trie-empty then
        let nxt = node-count in
        let _ = raw-store-u32 slot nxt in
        trie-insert-bits base nxt (wrapping-add-u32 node-count 1) sym code (wrapping-sub-u32 bit-idx 1)
      else
        trie-insert-bits base existing node-count sym code (wrapping-sub-u32 bit-idx 1)

  #[no-alloc]
  trie-insert-all :: I64 -> U32 -> U32 ->{MVar} U32
  trie-insert-all base sym node-count =
    if ge-u32 sym 256 then
      -- Insert EOS symbol 256 (0x3fffffff, 30 bits).
      trie-insert-bits base 0 node-count 256 hpack-huffman-eos-code 29
    else
      let off = wrapping-shl-i64 (u32-to-i64 sym) 3 in
      let code = raw-load-u32 (wrapping-add-i64 base off) in
      let bits = raw-load-u32 (wrapping-add-i64 base (wrapping-add-i64 off 4)) in
      let next-count = trie-insert-bits base 0 node-count sym code (wrapping-sub-u32 bits 1) in
      trie-insert-all base (wrapping-add-u32 sym 1) next-count

  -- Mark root (0) and the 7 all-1s EOS prefix states (depths 1..7) as accepting.
  #[no-alloc]
  mark-accept-path :: I64 -> U32 -> U32 ->{MVar} Unit
  mark-accept-path base cur rem =
    let _ = raw-store-u8 (wrapping-add-i64 (wrapping-add-i64 base huff-accept-off) (u32-to-i64 cur)) 1 in
    if eq-u32 rem 0 then ()
    else
      let nxt = raw-load-u32 (trie-child-addr base cur 1) in
      if lt-u32 nxt 256 then mark-accept-path base nxt (wrapping-sub-u32 rem 1)
      else ()

  -- Simulate one 4-bit nibble MSB-first from internal trie state `st`.
  #[no-alloc]
  build-dfa-step :: I64 -> U32 -> U32 -> U32 -> U32 -> U32 ->{MVar} U32
  build-dfa-step base cur nib bit-rem emitted esym =
    let bshift = wrapping-sub-u32 bit-rem 1 in
    let bit = bit-and-u32 (wrapping-shr-u32 nib bshift) 1 in
    let nxt = raw-load-u32 (trie-child-addr base cur bit) in
    let is-leaf = ne-u32 (bit-and-u32 nxt trie-leaf-bit) 0 in
    if is-leaf then
      let sym = bit-and-u32 nxt 511 in
      if eq-u32 sym 256 then dfa-flag-fail
      else if eq-u32 bshift 0 then
        let acc = raw-load-u8 (wrapping-add-i64 base huff-accept-off) in
        let acc-flag = if ne-u8 acc 0 then dfa-flag-accept else 0 in
        bit-or-u32 (bit-or-u32 dfa-flag-emit acc-flag) (wrapping-shl-u32 sym 8)
      else
        build-dfa-step base 0 nib bshift 1 sym
    else
      if eq-u32 bshift 0 then
        let acc = raw-load-u8 (wrapping-add-i64 (wrapping-add-i64 base huff-accept-off) (u32-to-i64 nxt)) in
        let acc-flag = if ne-u8 acc 0 then dfa-flag-accept else 0 in
        let emit-flag = if ne-u32 emitted 0 then dfa-flag-emit else 0 in
        bit-or-u32
          (bit-or-u32 (bit-and-u32 nxt 255) (wrapping-shl-u32 (bit-and-u32 esym 255) 8))
          (bit-or-u32 emit-flag acc-flag)
      else
        build-dfa-step base nxt nib bshift emitted esym

  #[no-alloc]
  build-dfa-nibbles :: I64 -> U32 -> U32 ->{MVar} Unit
  build-dfa-nibbles base st nib =
    if ge-u32 nib 16 then ()
    else
      let entry = build-dfa-step base st nib 4 0 0 in
      let idx = bit-or-u32 (wrapping-shl-u32 st 4) nib in
      let addr = wrapping-add-i64 (wrapping-add-i64 base huff-dfa-off) (wrapping-shl-i64 (u32-to-i64 idx) 2) in
      let _ = raw-store-u32 addr entry in
      build-dfa-nibbles base st (wrapping-add-u32 nib 1)

  #[no-alloc]
  build-dfa-states :: I64 -> U32 ->{MVar} Unit
  build-dfa-states base st =
    if ge-u32 st 256 then ()
    else
      let _ = build-dfa-nibbles base st 0 in
      build-dfa-states base (wrapping-add-u32 st 1)

  -- | Allocate and precompute the 4 KiB-aligned DMA Huffman encode + 2-level
  -- 4-bit nibble DFA decode tables (once per worker / codec).
  -- Check validity with `hpack-huffman-table-valid`.
  hpack-huffman-table-new :: Unit ->{IO, MVar} HpackHuffmanTable
  hpack-huffman-table-new _ =
    let slab-u64 = engine-dma-alloc huff-slab-total-bytes 4096 in
    if eq-u64 slab-u64 0 then HpackHuffmanTable 0 0
    else
      let base = wrapping-u64-to-i64 slab-u64 in
      let _ = init-encode-table base 0 in
      let _ = init-trie-empty base 0 in
      let _ = trie-insert-all base 0 1 in
      let _ = mark-accept-path base 0 7 in
      let _ = build-dfa-states base 0 in
      HpackHuffmanTable slab-u64 huff-slab-total-bytes

  -- | Release the 4 KiB-aligned DMA Huffman tables.
  hpack-huffman-table-destroy :: HpackHuffmanTable ->{IO, MVar} Unit
  hpack-huffman-table-destroy tbl =
    if eq-u64 tbl.huff-slab-addr 0 then ()
    else
      let _ = engine-dma-free tbl.huff-slab-addr tbl.huff-slab-bytes in
      ()

  -- =========================================================================
  -- 3. #[no-alloc] Fast 64-Bit Accumulator Huffman Encoder
  -- =========================================================================

  #[no-alloc]
  encode-len-loop :: I64 -> I64 -> U32 -> U32 -> U64 ->{MVar} U64
  encode-len-loop tbl-base src len i bits =
    if ge-u32 i len then bits
    else
      let b = raw-load-u8 (wrapping-add-i64 src (u32-to-i64 i)) in
      let blen = raw-load-u32 (wrapping-add-i64 tbl-base (wrapping-add-i64 (wrapping-shl-i64 (u8-to-i64 b) 3) 4)) in
      encode-len-loop tbl-base src len (wrapping-add-u32 i 1) (wrapping-add-u64 bits (u32-to-u64 blen))

  -- | Compute the exact RFC 7541 Huffman-encoded byte length for `[src, src + len)`
  -- using the precomputed flat DMA table (`#[no-alloc]`).
  #[no-alloc]
  hpack-huffman-encode-len :: HpackHuffmanTable -> I64 -> U32 ->{MVar} U32
  hpack-huffman-encode-len tbl src len =
    if hpack-huffman-table-valid tbl then
      let total-bits = encode-len-loop (wrapping-u64-to-i64 tbl.huff-slab-addr) src len 0 0 in
      wrapping-u64-to-u32 (wrapping-shr-u64 (wrapping-add-u64 total-bits 7) 3)
    else 0

  #[no-alloc]
  encode-len-pure-loop :: I64 -> U32 -> U32 -> U64 ->{MVar} U64
  encode-len-pure-loop src len i bits =
    if ge-u32 i len then bits
    else
      let b = raw-load-u8 (wrapping-add-i64 src (u32-to-i64 i)) in
      let blen = hpack-huffman-len b in
      encode-len-pure-loop src len (wrapping-add-u32 i 1) (wrapping-add-u64 bits (u8-to-u64 blen))

  -- | Compute the exact RFC 7541 Huffman-encoded byte length without a table handle (`#[no-alloc]`).
  #[no-alloc]
  hpack-huffman-encode-len-pure :: I64 -> U32 ->{MVar} U32
  hpack-huffman-encode-len-pure src len =
    let total-bits = encode-len-pure-loop src len 0 0 in
    wrapping-u64-to-u32 (wrapping-shr-u64 (wrapping-add-u64 total-bits 7) 3)

  -- Flush at most 1 byte from `(acc, nbits)` packed in `state = (nbits << 32) | out-pos`.
  -- Returns `0xFFFFFFFFFFFFFFFF` on overflow.
  #[inline(always)]
  #[no-alloc]
  flush-one-byte :: I64 -> U32 -> U64 -> U64 ->{MVar} U64
  flush-one-byte dst cap state acc =
    if eq-u64 state 18446744073709551615 then 18446744073709551615
    else
      let out-pos = wrapping-u64-to-u32 state in
      let nbits = wrapping-u64-to-u32 (wrapping-shr-u64 state 32) in
      if lt-u32 nbits 8 then state
      else if ge-u32 out-pos cap then 18446744073709551615
      else
        let next-nbits = wrapping-sub-u32 nbits 8 in
        let byte-val = wrapping-u64-to-u8 (wrapping-shr-u64 acc next-nbits) in
        let _ = raw-store-u8 (wrapping-add-i64 dst (u32-to-i64 out-pos)) byte-val in
        bit-or-u64 (wrapping-shl-u64 (u32-to-u64 next-nbits) 32) (u32-to-u64 (wrapping-add-u32 out-pos 1))

  -- Flush all complete bytes (up to 4 bytes, since nbits1 <= 37) without recursion.
  #[no-alloc]
  flush-acc-bytes :: I64 -> U32 -> U32 -> U64 -> U32 ->{MVar} U64
  flush-acc-bytes dst cap out-pos acc nbits =
    let s0 = bit-or-u64 (wrapping-shl-u64 (u32-to-u64 nbits) 32) (u32-to-u64 out-pos) in
    let s1 = flush-one-byte dst cap s0 acc in
    let s2 = flush-one-byte dst cap s1 acc in
    let s3 = flush-one-byte dst cap s2 acc in
    flush-one-byte dst cap s3 acc

  #[inline(always)]
  #[no-alloc]
  pack-hr :: U32 -> U32 -> U64
  pack-hr st len =
    bit-or-u64 (wrapping-shl-u64 (u32-to-u64 st) 32) (u32-to-u64 len)

  #[inline(always)]
  #[no-alloc]
  unpack-hr :: U64 -> HpackHuffmanResult
  unpack-hr v =
    HpackHuffmanResult (wrapping-u64-to-u32 (wrapping-shr-u64 v 32)) (wrapping-u64-to-u32 v)

  #[no-alloc]
  encode-raw-loop :: I64 -> I64 -> U32 -> U32 -> I64 -> U32 -> U32 -> U64 -> U32 ->{MVar} U64
  encode-raw-loop tbl-base src src-len i dst dst-cap out-pos acc nbits =
    if ge-u32 i src-len then
      if eq-u32 nbits 0 then pack-hr huff-ok out-pos
      else if ge-u32 out-pos dst-cap then pack-hr huff-err-buf-overflow out-pos
      else
        -- Pad remaining `pad = 8 - nbits` LSBs with 1-bits (EOS prefix, RFC 7541 §5.2).
        let pad = wrapping-sub-u32 8 nbits in
        let pad-mask = wrapping-sub-u64 (wrapping-shl-u64 1 pad) 1 in
        let last-b = wrapping-u64-to-u8 (bit-or-u64 (wrapping-shl-u64 acc pad) pad-mask) in
        let _ = raw-store-u8 (wrapping-add-i64 dst (u32-to-i64 out-pos)) last-b in
        pack-hr huff-ok (wrapping-add-u32 out-pos 1)
    else
      let b = raw-load-u8 (wrapping-add-i64 src (u32-to-i64 i)) in
      let eoff = wrapping-shl-i64 (u8-to-i64 b) 3 in
      let code = raw-load-u32 (wrapping-add-i64 tbl-base eoff) in
      let clen = raw-load-u32 (wrapping-add-i64 tbl-base (wrapping-add-i64 eoff 4)) in
      -- Invariant: nbits in 0..7, clen in 5..30 => next-nbits in 5..37 <= 64.
      let acc1 = bit-or-u64 (wrapping-shl-u64 acc clen) (u32-to-u64 code) in
      let nbits1 = wrapping-add-u32 nbits clen in
      let packed = flush-acc-bytes dst dst-cap out-pos acc1 nbits1 in
      if eq-u64 packed 18446744073709551615 then pack-hr huff-err-buf-overflow out-pos
      else
        let out1 = wrapping-u64-to-u32 packed in
        let nbits2 = wrapping-u64-to-u32 (wrapping-shr-u64 packed 32) in
        let rem-mask = if eq-u32 nbits2 0 then 0 else wrapping-sub-u64 (wrapping-shl-u64 1 nbits2) 1 in
        encode-raw-loop tbl-base src src-len (wrapping-add-u32 i 1) dst dst-cap out1 (bit-and-u64 acc1 rem-mask) nbits2

  -- | RFC 7541 Huffman-encode raw DMA bytes `[src, src + src-len)` directly into
  -- `[dst, dst + dst-cap)` using a 64-bit bit accumulator (`#[no-alloc]`).
  #[no-alloc]
  hpack-huffman-encode-raw :: HpackHuffmanTable -> I64 -> U32 -> I64 -> U32 ->{MVar} HpackHuffmanResult
  hpack-huffman-encode-raw tbl src src-len dst dst-cap =
    if hpack-huffman-table-valid tbl then
      unpack-hr (encode-raw-loop (wrapping-u64-to-i64 tbl.huff-slab-addr) src src-len 0 dst dst-cap 0 0 0)
    else HpackHuffmanResult huff-err-invalid-table 0

  -- =========================================================================
  -- 4. #[no-alloc] 2-Level 4-Bit Nibble DFA Huffman Decoder
  -- =========================================================================

  #[no-alloc]
  decode-dfa-loop :: I64 -> I64 -> U32 -> U32 -> I64 -> U32 -> U32 -> U32 -> U32 ->{MVar} U64
  decode-dfa-loop dfa-base src src-len i dst dst-cap out-pos st accept =
    if ge-u32 i src-len then
      if eq-u32 accept 0 then pack-hr huff-err-padding out-pos
      else pack-hr huff-ok out-pos
    else
      let b = raw-load-u8 (wrapping-add-i64 src (u32-to-i64 i)) in
      -- Level 1: high 4-bit nibble
      let hi = u8-to-u32 (wrapping-shr-u8 b 4) in
      let idx1 = bit-or-u32 (wrapping-shl-u32 st 4) hi in
      let e1 = raw-load-u32 (wrapping-add-i64 dfa-base (wrapping-shl-i64 (u32-to-i64 idx1) 2)) in
      if ne-u32 (bit-and-u32 e1 dfa-flag-fail) 0 then
        pack-hr huff-err-eos out-pos
      else
        let emit1 = ne-u32 (bit-and-u32 e1 dfa-flag-emit) 0 in
        if both emit1 (ge-u32 out-pos dst-cap) then
          pack-hr huff-err-buf-overflow out-pos
        else
          let out1 = (
            if emit1 then (
              let sym1 = wrapping-u32-to-u8 (wrapping-shr-u32 e1 8) in
              let _ = raw-store-u8 (wrapping-add-i64 dst (u32-to-i64 out-pos)) sym1 in
              wrapping-add-u32 out-pos 1)
            else out-pos) in
          let st1 = bit-and-u32 e1 255 in
          -- Level 2: low 4-bit nibble
          let lo = u8-to-u32 (bit-and-u8 b 15) in
          let idx2 = bit-or-u32 (wrapping-shl-u32 st1 4) lo in
          let e2 = raw-load-u32 (wrapping-add-i64 dfa-base (wrapping-shl-i64 (u32-to-i64 idx2) 2)) in
          if ne-u32 (bit-and-u32 e2 dfa-flag-fail) 0 then
            pack-hr huff-err-eos out1
          else
            let emit2 = ne-u32 (bit-and-u32 e2 dfa-flag-emit) 0 in
            if both emit2 (ge-u32 out1 dst-cap) then
              pack-hr huff-err-buf-overflow out1
            else
              let out2 = (
                if emit2 then (
                  let sym2 = wrapping-u32-to-u8 (wrapping-shr-u32 e2 8) in
                  let _ = raw-store-u8 (wrapping-add-i64 dst (u32-to-i64 out1)) sym2 in
                  wrapping-add-u32 out1 1)
                else out1) in
              let st2 = bit-and-u32 e2 255 in
              let acc2 = bit-and-u32 (wrapping-shr-u32 e2 17) 1 in
              decode-dfa-loop dfa-base src src-len (wrapping-add-u32 i 1) dst dst-cap out2 st2 acc2

  -- | Decode RFC 7541 Huffman-encoded bytes `[src, src + src-len)` directly into
  -- raw DMA `[dst, dst + dst-cap)` using the 2-level 4-bit nibble DFA (`#[no-alloc]`).
  -- Strictly enforces RFC 7541 §5.2 (rejects EOS, non-1 padding, and padding > 7 bits).
  #[no-alloc]
  hpack-huffman-decode-raw :: HpackHuffmanTable -> I64 -> U32 -> I64 -> U32 ->{MVar} HpackHuffmanResult
  hpack-huffman-decode-raw tbl src src-len dst dst-cap =
    if hpack-huffman-table-valid tbl then
      let dfa-base = wrapping-add-i64 (wrapping-u64-to-i64 tbl.huff-slab-addr) huff-dfa-off in
      unpack-hr (decode-dfa-loop dfa-base src src-len 0 dst dst-cap 0 0 1)
    else HpackHuffmanResult huff-err-invalid-table 0
