-- | RFC 7541 Appendix B Canonical Huffman Codec & 2-Level 4-Bit Nibble DFA Decoder.
--
-- Architecture & zero-allocation contract:
--   * Complete RFC 7541 Appendix B 256-symbol canonical Huffman code table
--     (exact 5..30-bit codes + EOS symbol `256` = `0x3fffffff`).
--   * `hpack-huffman-table-new` allocates a single 4 KiB-aligned DMA slab
--     holding:
--       +0     .. +2047  : 256-entry `(code :: U32, bits :: U32)` encoder table (2 KiB)
--       +2048  .. +18431 : 256-state x 16-nibble `U32` DFA decode table (16 KiB)
--       +18432 .. +20735 : one-time build scratch (binary trie + accept flags)
--   * Hot-path encoding (`hpack-huffman-encode-len`, `hpack-huffman-encode-raw`)
--     uses a 64-bit bit accumulator directly into raw DMA memory (`#[no-alloc]`).
--   * Hot-path decoding (`hpack-huffman-decode-raw`) executes a 2-level 4-bit
--     nibble DFA (high nibble -> low nibble per byte) directly over the flat
--     16 KiB L1-resident table (`#[no-alloc]`) and strictly enforces RFC 7541 §5.2:
--       - Rejects EOS (`256`) appearing anywhere in the stream (`huff-err-eos`).
--       - Rejects non-1 padding bits at end of stream (`huff-err-padding`).
--       - Rejects padding strictly longer than 7 bits (`huff-err-padding`).
module Net.Http.Hpack.Huffman where

  import Data.Bool
  import Data.Core
  import Data.Machine
  import Engine.Types
  import Prim.Atomic

  export HpackHuffmanTable, HpackHuffmanResult
  export huff-ok, huff-err-invalid-table, huff-err-buf-overflow
  export huff-err-eos, huff-err-padding
  export hpack-huffman-eos-code, hpack-huffman-eos-len
  export hpack-huffman-entry, hpack-huffman-code, hpack-huffman-len
  export hpack-huffman-table-new, hpack-huffman-table-destroy, hpack-huffman-table-valid
  export hpack-huffman-encode-len, hpack-huffman-encode-len-pure
  export hpack-huffman-encode-raw, hpack-huffman-decode-raw

  -- =========================================================================
  -- 0. Status Codes, Constants, & POD Types
  -- =========================================================================

  #[inline(always)]
  #[no-alloc]
  b-true :: Bool
  b-true = eq-u32 0 0

  #[inline(always)]
  #[no-alloc]
  b-false :: Bool
  b-false = eq-u32 0 1

  #[inline(always)]
  #[no-alloc]
  both :: Bool -> Bool -> Bool
  both a b = if a then b else b-false

  #[inline(always)]
  #[no-alloc]
  huff-ok :: U32
  huff-ok = 0

  #[inline(always)]
  #[no-alloc]
  huff-err-invalid-table :: U32
  huff-err-invalid-table = 1

  #[inline(always)]
  #[no-alloc]
  huff-err-buf-overflow :: U32
  huff-err-buf-overflow = 2

  #[inline(always)]
  #[no-alloc]
  huff-err-eos :: U32
  huff-err-eos = 3

  #[inline(always)]
  #[no-alloc]
  huff-err-padding :: U32
  huff-err-padding = 4

  #[inline(always)]
  #[no-alloc]
  hpack-huffman-eos-code :: U32
  hpack-huffman-eos-code = 1073741823 -- 0x3fffffff

  #[inline(always)]
  #[no-alloc]
  hpack-huffman-eos-len :: U8
  hpack-huffman-eos-len = 30

  -- DMA slab geometry (6 pages = 24,576 bytes, 4 KiB aligned):
  --   +0     : encode table (256 x 8B = 2048B)
  --   +2048  : DFA nibble table (256 x 16 x 4B = 16384B)
  --   +18432 : trie build scratch (256 x 2 x 4B = 2048B)
  --   +20480 : accept-state flags (256 x 1B = 256B)
  #[inline(always)]
  #[no-alloc]
  huff-slab-total-bytes :: U64
  huff-slab-total-bytes = 24576

  #[inline(always)]
  #[no-alloc]
  huff-dfa-off :: I64
  huff-dfa-off = 2048

  #[inline(always)]
  #[no-alloc]
  huff-trie-off :: I64
  huff-trie-off = 18432

  #[inline(always)]
  #[no-alloc]
  huff-accept-off :: I64
  huff-accept-off = 20480

  -- DFA entry bit flags:
  --   bits 0..7   : next-state (0..255)
  --   bits 8..15  : emitted symbol (0..255)
  --   bit 16      : FLAG_EMIT   (0x10000 = 65536)
  --   bit 17      : FLAG_ACCEPT (0x20000 = 131072)
  --   bit 18      : FLAG_FAIL   (0x40000 = 262144)
  #[inline(always)]
  #[no-alloc]
  dfa-flag-emit :: U32
  dfa-flag-emit = 65536

  #[inline(always)]
  #[no-alloc]
  dfa-flag-accept :: U32
  dfa-flag-accept = 131072

  #[inline(always)]
  #[no-alloc]
  dfa-flag-fail :: U32
  dfa-flag-fail = 262144

  #[inline(always)]
  #[no-alloc]
  trie-empty :: U32
  trie-empty = 4294967295

  #[inline(always)]
  #[no-alloc]
  trie-leaf-bit :: U32
  trie-leaf-bit = 2147483648 -- 0x80000000

  -- | 16-byte POD handle to the precomputed 4 KiB-aligned DMA Huffman tables.
  #[repr(C, value)]
  record HpackHuffmanTable where
    huff-slab-addr :: U64
    huff-slab-bytes :: U64

  -- | 8-byte POD result from `hpack-huffman-encode-raw` / `hpack-huffman-decode-raw`.
  #[repr(C, value)]
  record HpackHuffmanResult where
    hr-status :: U32
    hr-len :: U32

  #[inline(always)]
  #[no-alloc]
  hpack-huffman-table-valid :: HpackHuffmanTable -> Bool
  hpack-huffman-table-valid tbl =
    both (ne-u64 tbl.huff-slab-addr 0) (ge-u64 tbl.huff-slab-bytes huff-slab-total-bytes)

  -- =========================================================================
  -- 1. RFC 7541 Appendix B Exact 256-Symbol Canonical Huffman Table
  --    Packed as `(bitlen :: U64 << 32) | (code :: U64)`.
  -- =========================================================================

  #[inline(always)]
  #[no-alloc]
  pack-huff :: U32 -> U32 -> U64
  pack-huff code bits =
    bit-or-u64 (wrapping-shl-u64 (u32-to-u64 bits) 32) (u32-to-u64 code)

  #[no-alloc]
  huff-b0 :: U8 -> U64
  huff-b0 s =
    if eq-u8 s 0 then pack-huff 0x1ff8 13
    else if eq-u8 s 1 then pack-huff 0x7fffd8 23
    else if eq-u8 s 2 then pack-huff 0xfffffe2 28
    else if eq-u8 s 3 then pack-huff 0xfffffe3 28
    else if eq-u8 s 4 then pack-huff 0xfffffe4 28
    else if eq-u8 s 5 then pack-huff 0xfffffe5 28
    else if eq-u8 s 6 then pack-huff 0xfffffe6 28
    else if eq-u8 s 7 then pack-huff 0xfffffe7 28
    else if eq-u8 s 8 then pack-huff 0xfffffe8 28
    else if eq-u8 s 9 then pack-huff 0xffffea 24
    else if eq-u8 s 10 then pack-huff 0x3ffffffc 30
    else if eq-u8 s 11 then pack-huff 0xfffffe9 28
    else if eq-u8 s 12 then pack-huff 0xfffffea 28
    else if eq-u8 s 13 then pack-huff 0x3ffffffd 30
    else if eq-u8 s 14 then pack-huff 0xfffffeb 28
    else if eq-u8 s 15 then pack-huff 0xfffffec 28
    else if eq-u8 s 16 then pack-huff 0xfffffed 28
    else if eq-u8 s 17 then pack-huff 0xfffffee 28
    else if eq-u8 s 18 then pack-huff 0xfffffef 28
    else if eq-u8 s 19 then pack-huff 0xffffff0 28
    else if eq-u8 s 20 then pack-huff 0xffffff1 28
    else if eq-u8 s 21 then pack-huff 0xffffff2 28
    else if eq-u8 s 22 then pack-huff 0x3ffffffe 30
    else if eq-u8 s 23 then pack-huff 0xffffff3 28
    else if eq-u8 s 24 then pack-huff 0xffffff4 28
    else if eq-u8 s 25 then pack-huff 0xffffff5 28
    else if eq-u8 s 26 then pack-huff 0xffffff6 28
    else if eq-u8 s 27 then pack-huff 0xffffff7 28
    else if eq-u8 s 28 then pack-huff 0xffffff8 28
    else if eq-u8 s 29 then pack-huff 0xffffff9 28
    else if eq-u8 s 30 then pack-huff 0xffffffa 28
    else pack-huff 0xffffffb 28

  #[no-alloc]
  huff-b1 :: U8 -> U64
  huff-b1 s =
    if eq-u8 s 32 then pack-huff 0x14 6
    else if eq-u8 s 33 then pack-huff 0x3f8 10
    else if eq-u8 s 34 then pack-huff 0x3f9 10
