    else if eq-u8 s 129 then pack-huff 0x3fffd2 22
    else if eq-u8 s 130 then pack-huff 0xfffe7 20
    else if eq-u8 s 131 then pack-huff 0xfffe8 20
    else if eq-u8 s 132 then pack-huff 0x3fffd3 22
    else if eq-u8 s 133 then pack-huff 0x3fffd4 22
    else if eq-u8 s 134 then pack-huff 0x3fffd5 22
    else if eq-u8 s 135 then pack-huff 0x7fffd9 23
