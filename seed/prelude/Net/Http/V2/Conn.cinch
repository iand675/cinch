  h2-max-window-i64 = 2147483647

  -- Control slab (24 KiB, 4 KiB-aligned):
  --   +0   .. +255  : Connection state header (4 cache lines)
  --   +256 .. +2815 : Decoded HpackHeader[128] array (128 * 20 = 2560B)
  --   +4096..+12287 : Header-block reassembly buffer (8192B)
  --   +12288..+20479: Decoded header text buffer (8192B)
  --   +20480..+24575: Outbound HPACK scratch buffer (4096B)
  #[inline(always)]
  #[no-alloc]
  conn-slab-size :: U64
  conn-slab-size = 24576

  #[inline(always)]
  #[no-alloc]
  conn-off-hdrs :: I64
  conn-off-hdrs = 256

  #[inline(always)]
  #[no-alloc]
  conn-max-decoded-hdrs :: U32
  conn-max-decoded-hdrs = 128

  #[inline(always)]
  #[no-alloc]
  conn-off-hblock :: I64
  conn-off-hblock = 4096

  #[inline(always)]
  #[no-alloc]
  conn-hblock-cap :: U32
  conn-hblock-cap = 8192

  #[inline(always)]
  #[no-alloc]
  conn-off-text :: I64
  conn-off-text = 12288

  #[inline(always)]
  #[no-alloc]
  conn-text-cap :: U32
  conn-text-cap = 8192

  #[inline(always)]
  #[no-alloc]
  conn-off-tx-scratch :: I64
  conn-off-tx-scratch = 20480

