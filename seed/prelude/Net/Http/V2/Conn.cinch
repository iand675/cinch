-- | RFC 9113 Zero-Allocation HTTP/2 Server & Client Multiplexing Connection Engine.
--
-- Features:
--   * 100% `#[no-alloc]` steady-state hot path (`h2-conn-feed`,
--     `h2-conn-send-response`, `h2-conn-queue-body`, `h2-conn-flush-data`,
--     `h2-conn-frame-data-slice`).
--   * Full 24-byte client preface validation + `SETTINGS` negotiation
--     (`HEADER_TABLE_SIZE`, `ENABLE_PUSH`, `MAX_CONCURRENT_STREAMS`,
--     `INITIAL_WINDOW_SIZE`, `MAX_FRAME_SIZE`, `MAX_HEADER_LIST_SIZE`,
--     `ENABLE_CONNECT_PROTOCOL` RFC 8441) + automatic `SETTINGS ACK` & `PING ACK`.
--   * Strict `CONTINUATION` lock: any interleaved frame or mismatched
--     `stream_id` while awaiting `END_HEADERS` immediately emits
--     `GOAWAY(PROTOCOL_ERROR)` and enters `H2ConnGoAway`.
--   * Integrated `Net.Http.Hpack.Codec` (header block decode/encode) and
--     `Net.Http.Priority` (`PriorityScheduler` for fair RFC 9218 outbound
--     `DATA` scheduling across concurrent active streams).
--   * Connection-level & stream-level flow-control enforcement + automatic
--     `WINDOW_UPDATE` emission whenever consumed bytes reach half window.
--   * **CVE-2023-44487 Rapid-Reset & Control-Frame Flood Defense**: bounded
--     sliding budgets for `RST_STREAM`, `PING`, `SETTINGS`, `WINDOW_UPDATE`,
--     and empty `DATA` frames — exceeding threshold immediately emits
--     `GOAWAY(ENHANCE_YOUR_CALM)` and closes cleanly.
module Net.Http.V2.Conn where

  import Data.Bool
  import Data.Core
  import Data.Machine
  import Data.Option
  import Engine.Types
  import Engine.Mem.DmaPool
  import Net.Http.Types
  import Net.Http.Priority
  import Net.Http.Hpack.StaticTable
  import Net.Http.Hpack.Huffman
  import Net.Http.Hpack.Codec
  import Net.Http.V2.Frame
  import Net.Http.V2.Stream
  import Prim.Atomic

  -- Connection roles & states
  export h2-role-server, h2-role-client
  export h2-conn-preface, h2-conn-open, h2-conn-goaway, h2-conn-closed

  -- Feed status codes
  export h2-feed-ok, h2-feed-need-more, h2-feed-headers-ready
  export h2-feed-data-ready, h2-feed-stream-reset, h2-feed-goaway, h2-feed-error

  -- Default flood-defense budgets
  export h2-default-rst-budget, h2-default-ctrl-budget

  -- POD handles & results
  export H2Conn, H2FeedResult, H2WriteResult
  export h2-conn-empty, h2-conn-valid, h2-conn-new, h2-conn-destroy

  -- Connection state & sub-component accessors (`#[no-alloc]`)
  export h2-conn-state, h2-conn-streams, h2-conn-priority-sched
  export h2-conn-hpack-encoder, h2-conn-hpack-decoder
  export h2-conn-send-window, h2-conn-recv-window
  export h2-conn-peer-initial-window, h2-conn-peer-max-frame-size
  export h2-conn-peer-max-concurrent, h2-conn-peer-connect-enabled
  export h2-conn-cont-stream-id, h2-conn-last-peer-sid, h2-conn-goaway-error
  export h2-conn-rst-count, h2-conn-ctrl-count
  export h2-conn-set-flood-limits, h2-conn-refill-budgets
  export h2-conn-decoded-hdrs-addr, h2-conn-decoded-text-addr
  export h2-conn-decoded-hdr-count, h2-conn-decoded-text-len
  export h2-conn-last-data-off, h2-conn-last-data-len

  -- Outbound framing & incremental RX dispatcher (`#[no-alloc]`)
  export h2-conn-write-initial-settings
  export h2-conn-feed
  export h2-conn-send-response
  export h2-conn-queue-body
  export h2-conn-flush-data
  export h2-conn-frame-data-slice

  -- =========================================================================
  -- 0. Internal #[no-alloc] helpers & control slab offsets
  -- =========================================================================

  #[inline(always)]
  #[no-alloc]
  b-true :: Bool
  b-true = eq-u32 0 0

  #[inline(always)]
  #[no-alloc]
  b-false :: Bool
  b-false = eq-u32 0 1

  #[inline(always)]
  #[no-alloc]
  both :: Bool -> Bool -> Bool
  both a b = if a then b else b-false

  #[inline(always)]
  #[no-alloc]
  either :: Bool -> Bool -> Bool
  either a b = if a then b-true else b

  #[inline(always)]
  #[no-alloc]
  h2-role-server :: U8
  h2-role-server = 0

  #[inline(always)]
  #[no-alloc]
  h2-role-client :: U8
  h2-role-client = 1

  #[inline(always)]
  #[no-alloc]
  h2-conn-preface :: U8
  h2-conn-preface = 0

  #[inline(always)]
  #[no-alloc]
  h2-conn-open :: U8
  h2-conn-open = 1

