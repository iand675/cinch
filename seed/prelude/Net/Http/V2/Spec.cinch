-- | Formal Model M7 (`Http2Machine`): compile-time TLA+-style explicit-state
-- model of RFC 9113 HTTP/2 multiplexing, strict `CONTINUATION` locking,
-- flow-control window safety, monotonic stream-IDs (no closed-stream reopen),
-- CVE-2023-44487 Rapid-Reset flood defense, absorbing `GOAWAY`/`Closed`
-- states, stream completion liveness, and abstract multiplexed HTTP refinement
-- (`Net.Http.V2.Spec`).
--
-- Exhaustively verified at compile time (`max_states = 8192`, `capped: false`,
-- `0 violations` under `CINCH_MODEL_FAIL_ON_CAPPED=1`):
--   * `h2SafetyInvariants` (`always`):
--       - No `CONTINUATION` interleaving: `cont-lock /= 0 => active-cont` and
--         `not cont-interleaved`, and at most one stream holds the lock.
--       - Flow-control safety: `not send-exceeded-window` and `send-win <= 1`.
--       - No closed-stream reopen & monotonic stream IDs:
--         `not closed-reopened`, `s1-closed-ever => s1 == MSClosed`,
--         `s2-closed-ever => s2 == MSClosed`, and `max-sid` tracks opened IDs.
--       - CVE-2023-44487 Rapid-Reset flood cap:
--         `reset-budget-exceeded => (conn-phase == MGoAway || conn-phase == MClosed)`.
--   * `goawayAbsorbing` & `closedAbsorbing` (`stable`):
--       - Once `MGoAway` is entered, connection stays in `MGoAway` or `MClosed`.
--       - Once `MClosed` is entered, connection stays in `MClosed` forever.
--   * `streamsEventuallyCompleteOrGoAway` (`leads_to` with `fair_each`):
--       - Under fairness, every opened stream eventually reaches `MSClosed`
--         or cleanly terminates on `MGoAway` / `MClosed`.
--   * `refines Http2Machine AbstractMultiplexedHttp` (with strictly decreasing
--     `measure = h2-measure`):
--       - Checked stuttering simulation proving preface, `CONTINUATION`,
--         half-close, and `WINDOW_UPDATE` sub-steps refine
--         `AbstractMultiplexedHttp` without infinite stuttering.
module Net.Http.V2.Spec where

  import Data.Bool
  import Data.Nat
  import Data.Option

  export H2MPhase, MPreface, MOpen, MGoAway, MClosed
  export MStreamState, MSIdle, MSHeadersCont, MSOpen, MSHalfClosedRemote, MSClosed
  export OpenMode, OpenDirect, OpenWithCont
  export FaultKind, FaultContInterleave, FaultClosedReopen, FaultWindowOverflow
  export H2ModelState, h2-model-init, h2-mphase-eq, h2-ms-eq, h2-safety-ok
  export h2-step-preface, h2-step-open-stream, h2-step-continuation
  export h2-step-recv-end-stream, h2-step-window-update, h2-step-send-response
  export h2-step-rst-stream, h2-step-fault, h2-step-close
  export AbsH2Phase, AbsH2Active, AbsH2GoAway, AbsH2Closed
  export AbsStreamPhase, AbsSIdle, AbsSActive, AbsSDone
  export AbsH2State, abs-h2-init
  export abs-open-stream, abs-complete-stream, abs-reset-goaway
  export abs-goaway, abs-goaway-abort-stream, abs-close
  export h2-view, h2-measure

  -- =========================================================================
  -- 1. Concrete HTTP/2 Model Vocabulary
  -- =========================================================================

  data H2MPhase where
    MPreface :: H2MPhase
    MOpen :: H2MPhase
    MGoAway :: H2MPhase
    MClosed :: H2MPhase

  data MStreamState where
    MSIdle :: MStreamState
    MSHeadersCont :: MStreamState
    MSOpen :: MStreamState
    MSHalfClosedRemote :: MStreamState
    MSClosed :: MStreamState

  data OpenMode where
    OpenDirect :: OpenMode
    OpenWithCont :: OpenMode

  data FaultKind where
    FaultContInterleave :: FaultKind
    FaultClosedReopen :: FaultKind
    FaultWindowOverflow :: FaultKind

  h2-mphase-rank :: H2MPhase -> Nat
  h2-mphase-rank p = case p of
    MPreface -> 0
    MOpen -> 1
    MGoAway -> 2
    MClosed -> 3

  h2-mphase-eq :: H2MPhase -> H2MPhase -> Bool
  h2-mphase-eq a b = h2-mphase-rank a == h2-mphase-rank b

  h2-ms-rank :: MStreamState -> Nat
  h2-ms-rank st = case st of
    MSIdle -> 0
    MSHeadersCont -> 1
    MSOpen -> 2
    MSHalfClosedRemote -> 3
    MSClosed -> 4

  h2-ms-eq :: MStreamState -> MStreamState -> Bool
  h2-ms-eq a b = h2-ms-rank a == h2-ms-rank b

  fin2-val :: Fin 2 -> Nat
  fin2-val f = case f of
    Fin x _ -> x

  -- | Concrete HTTP/2 multiplexed connection state tracked by M7 `Http2Machine`.
  record H2ModelState where
    conn-phase :: H2MPhase
    s1 :: MStreamState
    s2 :: MStreamState
    max-sid :: Nat             -- monotonic highest opened stream (0..2)
    cont-lock :: Nat           -- 0 = unlocked, 1 = stream 1, 2 = stream 2
    send-win :: Nat            -- connection send flow-control credits (0..1)
    rst-count :: Nat           -- rapid-reset counter (0..2; >= 2 => GOAWAY)
    goaway-entered :: Bool     -- ghost monitor: True once MGoAway entered
    closed-entered :: Bool     -- ghost monitor: True once MClosed entered
    s1-closed-ever :: Bool     -- ghost monitor: True once stream 1 closed
    s2-closed-ever :: Bool     -- ghost monitor: True once stream 2 closed
    cont-interleaved :: Bool   -- safety ghost: must remain False
    send-exceeded-win :: Bool  -- safety ghost: must remain False
    closed-reopened :: Bool    -- safety ghost: must remain False

  h2-model-init :: H2ModelState
  h2-model-init = H2ModelState {
    conn-phase = MPreface,
    s1 = MSIdle,
    s2 = MSIdle,
    max-sid = 0,
    cont-lock = 0,
    send-win = 1,
    rst-count = 0,
    goaway-entered = False,
    closed-entered = False,
    s1-closed-ever = False,
    s2-closed-ever = False,
    cont-interleaved = False,
    send-exceeded-win = False,
    closed-reopened = False
  }

  -- =========================================================================
  -- 2. Concrete M7 Transition Actions
  -- =========================================================================

  -- | Client preface + initial SETTINGS exchange (`MPreface -> MOpen`).
  h2-step-preface :: H2ModelState -> Option H2ModelState
  h2-step-preface s = case s.conn-phase of
    MPreface ->
      Some (H2ModelState {
        conn-phase = MOpen,
        s1 = s.s1,
        s2 = s.s2,
        max-sid = s.max-sid,
        cont-lock = 0,
        send-win = s.send-win,
        rst-count = s.rst-count,
        goaway-entered = s.goaway-entered,
        closed-entered = s.closed-entered,
        s1-closed-ever = s.s1-closed-ever,
        s2-closed-ever = s.s2-closed-ever,
        cont-interleaved = s.cont-interleaved,
        send-exceeded-win = s.send-exceeded-win,
        closed-reopened = s.closed-reopened
      })
    _ -> None

  -- | Open stream 1 (`sid = 0`) or stream 2 (`sid = 1`) monotonically when
  -- `conn-phase == MOpen` and `cont-lock == 0`, either with `END_HEADERS`
  -- (`OpenDirect`) or without `END_HEADERS` (`OpenWithCont`, acquiring lock).
  h2-step-open-stream :: Fin 2 -> OpenMode -> H2ModelState -> Option H2ModelState
  h2-step-open-stream sid mode s =
    let idx = fin2-val sid in
    if not (h2-mphase-eq s.conn-phase MOpen) || s.cont-lock /= 0 then None
    else
      let target-st = (
        case mode of
          OpenDirect -> MSOpen
          OpenWithCont -> MSHeadersCont) in
      let next-lock = (
        case mode of
          OpenDirect -> 0
          OpenWithCont -> idx + 1) in
      if idx == 0 then
        if h2-ms-eq s.s1 MSIdle && s.max-sid == 0 then
          Some (H2ModelState {
            conn-phase = MOpen,
            s1 = target-st,
            s2 = s.s2,
            max-sid = 1,
            cont-lock = next-lock,
            send-win = s.send-win,
            rst-count = s.rst-count,
            goaway-entered = s.goaway-entered,
            closed-entered = s.closed-entered,
            s1-closed-ever = s.s1-closed-ever,
            s2-closed-ever = s.s2-closed-ever,
            cont-interleaved = s.cont-interleaved,
            send-exceeded-win = s.send-exceeded-win,
            closed-reopened = s.closed-reopened
          })
        else None
      else
        if h2-ms-eq s.s2 MSIdle && s.max-sid == 1 then
          Some (H2ModelState {
            conn-phase = MOpen,
            s1 = s.s1,
            s2 = target-st,
            max-sid = 2,
            cont-lock = next-lock,
            send-win = s.send-win,
            rst-count = s.rst-count,
            goaway-entered = s.goaway-entered,
            closed-entered = s.closed-entered,
            s1-closed-ever = s.s1-closed-ever,
            s2-closed-ever = s.s2-closed-ever,
            cont-interleaved = s.cont-interleaved,
            send-exceeded-win = s.send-exceeded-win,
            closed-reopened = s.closed-reopened
          })
        else None

  -- | Receive matching `CONTINUATION(END_HEADERS)` for the locked stream,
  -- releasing `cont-lock` and transitioning `MSHeadersCont -> MSOpen`.
  h2-step-continuation :: H2ModelState -> Option H2ModelState
  h2-step-continuation s =
    if not (h2-mphase-eq s.conn-phase MOpen) then None
    else if s.cont-lock == 1 && h2-ms-eq s.s1 MSHeadersCont then
      Some (H2ModelState {
        conn-phase = MOpen,
        s1 = MSOpen,
        s2 = s.s2,
        max-sid = s.max-sid,
        cont-lock = 0,
        send-win = s.send-win,
        rst-count = s.rst-count,
        goaway-entered = s.goaway-entered,
        closed-entered = s.closed-entered,
        s1-closed-ever = s.s1-closed-ever,
        s2-closed-ever = s.s2-closed-ever,
        cont-interleaved = s.cont-interleaved,
        send-exceeded-win = s.send-exceeded-win,
        closed-reopened = s.closed-reopened
      })
    else if s.cont-lock == 2 && h2-ms-eq s.s2 MSHeadersCont then
      Some (H2ModelState {
        conn-phase = MOpen,
        s1 = s.s1,
        s2 = MSOpen,
        max-sid = s.max-sid,
        cont-lock = 0,
        send-win = s.send-win,
        rst-count = s.rst-count,
        goaway-entered = s.goaway-entered,
        closed-entered = s.closed-entered,
        s1-closed-ever = s.s1-closed-ever,
        s2-closed-ever = s.s2-closed-ever,
        cont-interleaved = s.cont-interleaved,
        send-exceeded-win = s.send-exceeded-win,
        closed-reopened = s.closed-reopened
      })
    else None

  -- | Receive `DATA(END_STREAM)` on an `MSOpen` stream when `cont-lock == 0`,
  -- transitioning `MSOpen -> MSHalfClosedRemote`.
  h2-step-recv-end-stream :: Fin 2 -> H2ModelState -> Option H2ModelState
  h2-step-recv-end-stream sid s =
    let idx = fin2-val sid in
    if not (h2-mphase-eq s.conn-phase MOpen) || s.cont-lock /= 0 then None
    else if idx == 0 && h2-ms-eq s.s1 MSOpen then
      Some (H2ModelState {
        conn-phase = MOpen,
        s1 = MSHalfClosedRemote,
        s2 = s.s2,
        max-sid = s.max-sid,
        cont-lock = 0,
        send-win = s.send-win,
        rst-count = s.rst-count,
        goaway-entered = s.goaway-entered,
        closed-entered = s.closed-entered,
        s1-closed-ever = s.s1-closed-ever,
        s2-closed-ever = s.s2-closed-ever,
        cont-interleaved = s.cont-interleaved,
        send-exceeded-win = s.send-exceeded-win,
        closed-reopened = s.closed-reopened
      })
    else if idx == 1 && h2-ms-eq s.s2 MSOpen then
      Some (H2ModelState {
        conn-phase = MOpen,
        s1 = s.s1,
        s2 = MSHalfClosedRemote,
        max-sid = s.max-sid,
        cont-lock = 0,
        send-win = s.send-win,
        rst-count = s.rst-count,
        goaway-entered = s.goaway-entered,
        closed-entered = s.closed-entered,
        s1-closed-ever = s.s1-closed-ever,
        s2-closed-ever = s.s2-closed-ever,
        cont-interleaved = s.cont-interleaved,
        send-exceeded-win = s.send-exceeded-win,
        closed-reopened = s.closed-reopened
      })
    else None

  stream-awaiting-response :: MStreamState -> Bool
  stream-awaiting-response st = h2-ms-eq st MSOpen || h2-ms-eq st MSHalfClosedRemote

  -- | Receive `WINDOW_UPDATE` replenishing `send-win` (`0 -> 1`) when a stream
  -- is blocked waiting to transmit response `DATA`.
  h2-step-window-update :: H2ModelState -> Option H2ModelState
  h2-step-window-update s =
    if not (h2-mphase-eq s.conn-phase MOpen) || s.cont-lock /= 0 then None
    else if s.send-win == 0 && (stream-awaiting-response s.s1 || stream-awaiting-response s.s2) then
      Some (H2ModelState {
        conn-phase = MOpen,
        s1 = s.s1,
        s2 = s.s2,
        max-sid = s.max-sid,
        cont-lock = 0,
        send-win = 1,
        rst-count = s.rst-count,
        goaway-entered = s.goaway-entered,
        closed-entered = s.closed-entered,
        s1-closed-ever = s.s1-closed-ever,
        s2-closed-ever = s.s2-closed-ever,
        cont-interleaved = s.cont-interleaved,
        send-exceeded-win = s.send-exceeded-win,
        closed-reopened = s.closed-reopened
      })
    else None

  -- | Transmit response `HEADERS + DATA(END_STREAM)` for stream `sid`,
  -- strictly requiring `send-win > 0` and consuming 1 flow-control credit.
  h2-step-send-response :: Fin 2 -> H2ModelState -> Option H2ModelState
  h2-step-send-response sid s =
    let idx = fin2-val sid in
    let sw = s.send-win in
    if not (h2-mphase-eq s.conn-phase MOpen) || s.cont-lock /= 0 || sw == 0 then None
    else if idx == 0 && stream-awaiting-response s.s1 then
      Some (H2ModelState {
        conn-phase = MOpen,
        s1 = MSClosed,
        s2 = s.s2,
        max-sid = s.max-sid,
        cont-lock = 0,
        send-win = sw - 1,
        rst-count = s.rst-count,
        goaway-entered = s.goaway-entered,
        closed-entered = s.closed-entered,
        s1-closed-ever = True,
        s2-closed-ever = s.s2-closed-ever,
        cont-interleaved = s.cont-interleaved,
        send-exceeded-win = s.send-exceeded-win,
        closed-reopened = s.closed-reopened
      })
    else if idx == 1 && stream-awaiting-response s.s2 then
      Some (H2ModelState {
        conn-phase = MOpen,
        s1 = s.s1,
        s2 = MSClosed,
        max-sid = s.max-sid,
        cont-lock = 0,
        send-win = sw - 1,
        rst-count = s.rst-count,
        goaway-entered = s.goaway-entered,
        closed-entered = s.closed-entered,
        s1-closed-ever = s.s1-closed-ever,
        s2-closed-ever = True,
        cont-interleaved = s.cont-interleaved,
        send-exceeded-win = s.send-exceeded-win,
        closed-reopened = s.closed-reopened
      })
    else None

  -- | Client `RST_STREAM` on an open stream with CVE-2023-44487 Rapid-Reset
  -- defense: when `rst-count + 1 >= 2`, immediately emits `GOAWAY(ENHANCE_YOUR_CALM)`.
  h2-step-rst-stream :: Fin 2 -> H2ModelState -> Option H2ModelState
  h2-step-rst-stream sid s =
    let idx = fin2-val sid in
    if not (h2-mphase-eq s.conn-phase MOpen) || s.cont-lock /= 0 then None
    else
      let next-rst = if s.rst-count < 2 then s.rst-count + 1 else 2 in
      let hit-cap = next-rst >= 2 in
      let next-phase = if hit-cap then MGoAway else MOpen in
      if idx == 0 && stream-awaiting-response s.s1 then
        Some (H2ModelState {
          conn-phase = next-phase,
          s1 = MSClosed,
          s2 = s.s2,
          max-sid = s.max-sid,
          cont-lock = 0,
          send-win = s.send-win,
          rst-count = next-rst,
          goaway-entered = s.goaway-entered || hit-cap,
          closed-entered = s.closed-entered,
          s1-closed-ever = True,
          s2-closed-ever = s.s2-closed-ever,
          cont-interleaved = s.cont-interleaved,
          send-exceeded-win = s.send-exceeded-win,
          closed-reopened = s.closed-reopened
        })
      else if idx == 1 && stream-awaiting-response s.s2 then
        Some (H2ModelState {
          conn-phase = next-phase,
          s1 = s.s1,
          s2 = MSClosed,
          max-sid = s.max-sid,
          cont-lock = 0,
          send-win = s.send-win,
          rst-count = next-rst,
          goaway-entered = s.goaway-entered || hit-cap,
          closed-entered = s.closed-entered,
          s1-closed-ever = s.s1-closed-ever,
          s2-closed-ever = True,
          cont-interleaved = s.cont-interleaved,
          send-exceeded-win = s.send-exceeded-win,
          closed-reopened = s.closed-reopened
        })
      else None

  -- | Protocol violation faults (`CONTINUATION` interleaving while `cont-lock /= 0`,
  -- closed-stream reopen attempt, or `WINDOW_UPDATE` overflow) immediately
  -- trigger `GOAWAY` without ever violating safety invariants.
  h2-step-fault :: FaultKind -> H2ModelState -> Option H2ModelState
  h2-step-fault fk s =
    if not (h2-mphase-eq s.conn-phase MOpen) then None
    else case fk of
      FaultContInterleave ->
        if s.cont-lock == 1 then
          Some (H2ModelState {
            conn-phase = MGoAway,
            s1 = MSClosed,
            s2 = s.s2,
            max-sid = s.max-sid,
            cont-lock = 0,
            send-win = s.send-win,
            rst-count = s.rst-count,
            goaway-entered = True,
            closed-entered = s.closed-entered,
            s1-closed-ever = True,
            s2-closed-ever = s.s2-closed-ever,
            cont-interleaved = False,
            send-exceeded-win = s.send-exceeded-win,
            closed-reopened = s.closed-reopened
          })
        else if s.cont-lock == 2 then
          Some (H2ModelState {
            conn-phase = MGoAway,
            s1 = s.s1,
            s2 = MSClosed,
            max-sid = s.max-sid,
            cont-lock = 0,
            send-win = s.send-win,
            rst-count = s.rst-count,
            goaway-entered = True,
            closed-entered = s.closed-entered,
            s1-closed-ever = s.s1-closed-ever,
            s2-closed-ever = True,
            cont-interleaved = False,
            send-exceeded-win = s.send-exceeded-win,
            closed-reopened = s.closed-reopened
          })
        else None
      FaultClosedReopen ->
        if s.cont-lock == 0 && (s.s1-closed-ever || s.s2-closed-ever) then
          Some (H2ModelState {
            conn-phase = MGoAway,
            s1 = s.s1,
            s2 = s.s2,
            max-sid = s.max-sid,
            cont-lock = 0,
            send-win = s.send-win,
            rst-count = s.rst-count,
            goaway-entered = True,
            closed-entered = s.closed-entered,
            s1-closed-ever = s.s1-closed-ever,
            s2-closed-ever = s.s2-closed-ever,
            cont-interleaved = s.cont-interleaved,
            send-exceeded-win = s.send-exceeded-win,
            closed-reopened = False
          })
        else None
      FaultWindowOverflow ->
        if s.cont-lock == 0 then
          Some (H2ModelState {
            conn-phase = MGoAway,
            s1 = s.s1,
            s2 = s.s2,
            max-sid = s.max-sid,
            cont-lock = 0,
            send-win = s.send-win,
            rst-count = s.rst-count,
            goaway-entered = True,
            closed-entered = s.closed-entered,
            s1-closed-ever = s.s1-closed-ever,
            s2-closed-ever = s.s2-closed-ever,
            cont-interleaved = s.cont-interleaved,
            send-exceeded-win = s.send-exceeded-win,
            closed-reopened = s.closed-reopened
          })
        else None

  stream-is-active :: MStreamState -> Bool
  stream-is-active st =
    h2-ms-eq st MSHeadersCont || h2-ms-eq st MSOpen || h2-ms-eq st MSHalfClosedRemote

  -- | Clean connection close:
  --   * From `MGoAway`: closes connection and terminates any remaining open stream.
  --   * From `MOpen`: closes cleanly once no active streams remain.
  h2-step-close :: H2ModelState -> Option H2ModelState
  h2-step-close s = case s.conn-phase of
    MGoAway ->
      let next-s1 = if stream-is-active s.s1 then MSClosed else s.s1 in
      let next-s2 = if stream-is-active s.s2 then MSClosed else s.s2 in
      Some (H2ModelState {
        conn-phase = MClosed,
        s1 = next-s1,
        s2 = next-s2,
        max-sid = s.max-sid,
        cont-lock = 0,
        send-win = s.send-win,
        rst-count = s.rst-count,
        goaway-entered = s.goaway-entered,
        closed-entered = True,
        s1-closed-ever = s.s1-closed-ever || h2-ms-eq next-s1 MSClosed,
        s2-closed-ever = s.s2-closed-ever || h2-ms-eq next-s2 MSClosed,
        cont-interleaved = s.cont-interleaved,
        send-exceeded-win = s.send-exceeded-win,
        closed-reopened = s.closed-reopened
      })
    MOpen ->
      if s.cont-lock == 0 && not (stream-is-active s.s1) && not (stream-is-active s.s2) then
        Some (H2ModelState {
          conn-phase = MClosed,
          s1 = s.s1,
          s2 = s.s2,
          max-sid = s.max-sid,
          cont-lock = 0,
          send-win = s.send-win,
          rst-count = s.rst-count,
          goaway-entered = s.goaway-entered,
          closed-entered = True,
          s1-closed-ever = s.s1-closed-ever,
          s2-closed-ever = s.s2-closed-ever,
          cont-interleaved = s.cont-interleaved,
          send-exceeded-win = s.send-exceeded-win,
          closed-reopened = s.closed-reopened
        })
      else None
    _ -> None

  -- =========================================================================
  -- 3. Safety Invariants (`h2-safety-ok`)
  -- =========================================================================

  cont-lock-coherent :: H2ModelState -> Bool
  cont-lock-coherent s =
    not (h2-ms-eq s.s1 MSHeadersCont && h2-ms-eq s.s2 MSHeadersCont)
      && (if s.cont-lock == 0 then not (h2-ms-eq s.s1 MSHeadersCont) && not (h2-ms-eq s.s2 MSHeadersCont)
          else if s.cont-lock == 1 then h2-ms-eq s.s1 MSHeadersCont && h2-mphase-eq s.conn-phase MOpen
          else if s.cont-lock == 2 then h2-ms-eq s.s2 MSHeadersCont && h2-mphase-eq s.conn-phase MOpen
          else False)

  monotonic-stream-ids :: H2ModelState -> Bool
  monotonic-stream-ids s =
    s.max-sid <= 2
      && (h2-ms-eq s.s1 MSIdle || s.max-sid >= 1)
      && (h2-ms-eq s.s2 MSIdle || s.max-sid >= 2)
      && (not s.s1-closed-ever || h2-ms-eq s.s1 MSClosed)
      && (not s.s2-closed-ever || h2-ms-eq s.s2 MSClosed)

  rapid-reset-cap-ok :: H2ModelState -> Bool
  rapid-reset-cap-ok s =
    s.rst-count <= 2
      && (s.rst-count < 2 || h2-mphase-eq s.conn-phase MGoAway || h2-mphase-eq s.conn-phase MClosed)

  -- | Combined M7 safety invariant verified across every reachable state.
  h2-safety-ok :: H2ModelState -> Bool
  h2-safety-ok s =
    not s.cont-interleaved
      && not s.send-exceeded-win
      && not s.closed-reopened
      && s.send-win <= 1
      && cont-lock-coherent s
      && monotonic-stream-ids s
      && rapid-reset-cap-ok s
      && (not s.goaway-entered || h2-mphase-eq s.conn-phase MGoAway || h2-mphase-eq s.conn-phase MClosed)
      && (not s.closed-entered || h2-mphase-eq s.conn-phase MClosed)

  -- =========================================================================
  -- 4. Abstract Reference Specification (`AbstractMultiplexedHttp`) & Refinement
  -- =========================================================================

  data AbsH2Phase where
    AbsH2Active :: AbsH2Phase
    AbsH2GoAway :: AbsH2Phase
    AbsH2Closed :: AbsH2Phase

  data AbsStreamPhase where
    AbsSIdle :: AbsStreamPhase
    AbsSActive :: AbsStreamPhase
    AbsSDone :: AbsStreamPhase

  abs-h2-phase-rank :: AbsH2Phase -> Nat
  abs-h2-phase-rank p = case p of
    AbsH2Active -> 0
    AbsH2GoAway -> 1
    AbsH2Closed -> 2

  abs-h2-phase-eq :: AbsH2Phase -> AbsH2Phase -> Bool
  abs-h2-phase-eq a b = abs-h2-phase-rank a == abs-h2-phase-rank b

  abs-sp-rank :: AbsStreamPhase -> Nat
  abs-sp-rank p = case p of
    AbsSIdle -> 0
    AbsSActive -> 1
    AbsSDone -> 2

  abs-sp-eq :: AbsStreamPhase -> AbsStreamPhase -> Bool
  abs-sp-eq a b = abs-sp-rank a == abs-sp-rank b

  record AbsH2State where
    abs-conn :: AbsH2Phase
    abs-s1 :: AbsStreamPhase
    abs-s2 :: AbsStreamPhase

  abs-h2-init :: AbsH2State
  abs-h2-init = AbsH2State {
    abs-conn = AbsH2Active,
    abs-s1 = AbsSIdle,
    abs-s2 = AbsSIdle
  }

  abs-open-stream :: Fin 2 -> AbsH2State -> Option AbsH2State
  abs-open-stream sid s =
    let idx = fin2-val sid in
    if not (abs-h2-phase-eq s.abs-conn AbsH2Active) then None
    else if idx == 0 && abs-sp-eq s.abs-s1 AbsSIdle && abs-sp-eq s.abs-s2 AbsSIdle then
      Some (AbsH2State { abs-conn = AbsH2Active, abs-s1 = AbsSActive, abs-s2 = s.abs-s2 })
    else if idx == 1 && not (abs-sp-eq s.abs-s1 AbsSIdle) && abs-sp-eq s.abs-s2 AbsSIdle then
      Some (AbsH2State { abs-conn = AbsH2Active, abs-s1 = s.abs-s1, abs-s2 = AbsSActive })
    else None

  abs-complete-stream :: Fin 2 -> AbsH2State -> Option AbsH2State
  abs-complete-stream sid s =
    let idx = fin2-val sid in
    if not (abs-h2-phase-eq s.abs-conn AbsH2Active) then None
    else if idx == 0 && abs-sp-eq s.abs-s1 AbsSActive then
      Some (AbsH2State { abs-conn = AbsH2Active, abs-s1 = AbsSDone, abs-s2 = s.abs-s2 })
    else if idx == 1 && abs-sp-eq s.abs-s2 AbsSActive then
      Some (AbsH2State { abs-conn = AbsH2Active, abs-s1 = s.abs-s1, abs-s2 = AbsSDone })
    else None

  abs-reset-goaway :: Fin 2 -> AbsH2State -> Option AbsH2State
  abs-reset-goaway sid s =
    let idx = fin2-val sid in
    if not (abs-h2-phase-eq s.abs-conn AbsH2Active) then None
    else if idx == 0 && abs-sp-eq s.abs-s1 AbsSActive then
      Some (AbsH2State { abs-conn = AbsH2GoAway, abs-s1 = AbsSDone, abs-s2 = s.abs-s2 })
    else if idx == 1 && abs-sp-eq s.abs-s2 AbsSActive then
      Some (AbsH2State { abs-conn = AbsH2GoAway, abs-s1 = s.abs-s1, abs-s2 = AbsSDone })
    else None

  abs-goaway :: AbsH2State -> Option AbsH2State
  abs-goaway s =
    if abs-h2-phase-eq s.abs-conn AbsH2Active then
      Some (AbsH2State { abs-conn = AbsH2GoAway, abs-s1 = s.abs-s1, abs-s2 = s.abs-s2 })
    else None

  abs-goaway-abort-stream :: Fin 2 -> AbsH2State -> Option AbsH2State
  abs-goaway-abort-stream sid s = abs-reset-goaway sid s

  abs-close :: AbsH2State -> Option AbsH2State
  abs-close s = case s.abs-conn of
    AbsH2GoAway ->
      let n1 = if abs-sp-eq s.abs-s1 AbsSActive then AbsSDone else s.abs-s1 in
      let n2 = if abs-sp-eq s.abs-s2 AbsSActive then AbsSDone else s.abs-s2 in
      Some (AbsH2State { abs-conn = AbsH2Closed, abs-s1 = n1, abs-s2 = n2 })
    AbsH2Active ->
      if not (abs-sp-eq s.abs-s1 AbsSActive) && not (abs-sp-eq s.abs-s2 AbsSActive) then
        Some (AbsH2State { abs-conn = AbsH2Closed, abs-s1 = s.abs-s1, abs-s2 = s.abs-s2 })
      else None
    AbsH2Closed -> None

  machine AbstractMultiplexedHttp where
    state = AbsH2State
    init = abs-h2-init
    actions = [abs-open-stream, abs-complete-stream, abs-reset-goaway, abs-goaway, abs-goaway-abort-stream, abs-close]
    max_states = 256

  ms-to-abs :: MStreamState -> AbsStreamPhase
  ms-to-abs st = case st of
    MSIdle -> AbsSIdle
    MSHeadersCont -> AbsSActive
    MSOpen -> AbsSActive
    MSHalfClosedRemote -> AbsSActive
    MSClosed -> AbsSDone

  -- | Abstraction projection mapping concrete HTTP/2 states onto `AbstractMultiplexedHttp`.
  h2-view :: H2ModelState -> AbsH2State
  h2-view s =
    let ap = (
      case s.conn-phase of
        MPreface -> AbsH2Active
        MOpen -> AbsH2Active
        MGoAway -> AbsH2GoAway
        MClosed -> AbsH2Closed) in
    AbsH2State {
      abs-conn = ap,
      abs-s1 = ms-to-abs s.s1,
      abs-s2 = ms-to-abs s.s2
    }

  stream-stutter-rank :: MStreamState -> Nat
  stream-stutter-rank st = case st of
    MSHeadersCont -> 3
    MSOpen -> 2
    MSHalfClosedRemote -> 1
    MSIdle -> 0
    MSClosed -> 0

  -- | Strictly decreasing stuttering measure over preface, `CONTINUATION`,
  -- half-close, and flow-control `WINDOW_UPDATE` refill sub-steps.
  h2-measure :: H2ModelState -> Nat
  h2-measure s =
    let pref = if h2-mphase-eq s.conn-phase MPreface then 100 else 0 in
    let wref = if s.send-win == 0 then 1 else 0 in
    pref + stream-stutter-rank s.s1 * 4 + stream-stutter-rank s.s2 * 4 + wref

  -- =========================================================================
  -- 5. Formal Machine M7 (`Http2Machine`), Temporal Contracts & Refinement
  -- =========================================================================

  machine Http2Machine where
    state = H2ModelState
    init = h2-model-init
    actions = [
      h2-step-preface,
      h2-step-open-stream,
      h2-step-continuation,
      h2-step-recv-end-stream,
      h2-step-window-update,
      h2-step-send-response,
      h2-step-rst-stream,
      h2-step-fault,
      h2-step-close
    ]
    fair = [h2-step-preface, h2-step-continuation, h2-step-window-update, h2-step-close]
    fair_each = [h2-step-send-response]
    max_states = 8192

  contract safety h2SafetyInvariants for Http2Machine where
    always = (\s -> h2-safety-ok s)

  contract stability goawayAbsorbing for Http2Machine where
    stable = (\s -> not s.goaway-entered || h2-mphase-eq s.conn-phase MGoAway || h2-mphase-eq s.conn-phase MClosed)

  contract stability closedAbsorbing for Http2Machine where
    stable = (\s -> not s.closed-entered || h2-mphase-eq s.conn-phase MClosed)

  contract liveness stream1CompletesOrGoAway for Http2Machine where
    leads_to = (\s -> stream-is-active s.s1) ~> (\s -> h2-ms-eq s.s1 MSClosed || h2-mphase-eq s.conn-phase MGoAway || h2-mphase-eq s.conn-phase MClosed)
    fair = [h2-step-continuation, h2-step-window-update]
    fair_each = [h2-step-send-response]

  contract liveness stream2CompletesOrGoAway for Http2Machine where
    leads_to = (\s -> stream-is-active s.s2) ~> (\s -> h2-ms-eq s.s2 MSClosed || h2-mphase-eq s.conn-phase MGoAway || h2-mphase-eq s.conn-phase MClosed)
    fair = [h2-step-continuation, h2-step-window-update]
    fair_each = [h2-step-send-response]

  refines Http2Machine AbstractMultiplexedHttp where
    view = h2-view
    measure = h2-measure
