  -- 1. RFC 9113 Constants, Frame Types, Flags, Error Codes, SETTINGS IDs
  -- =========================================================================

  #[inline(always)]
  #[no-alloc]
  h2-frame-header-len :: U32
  h2-frame-header-len = 9

  #[inline(always)]
  #[no-alloc]
