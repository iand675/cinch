-- | RFC 9113 HTTP/2 Binary Framing Layer (`#[no-alloc]`).
--
-- Provides:
--   * Zero-allocation 9-byte RFC 9113 frame header encoder/decoder
--     (`H2FrameHeader`: 24-bit `length`, 8-bit `frame_type`, 8-bit `flags`,
--     31-bit `stream_id` with reserved bit masked on read and cleared on write).
--   * Zero-copy 9-byte headroom DMA framing (`h2-frame-write-headroom`) writing
--     the 9-byte HTTP/2 frame header directly ahead of payload in a `DmaSlice`.
--   * Complete RFC 9113 & RFC 9218 frame type, flag, SETTINGS identifier, and
--     error code vocabularies (`NO_ERROR = 0x0` .. `HTTP_1_1_REQUIRED = 0xd`).
--   * 24-byte HTTP/2 client connection preface (`PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n`)
--     word-parallel DMA validator and writer.
--   * Strict RFC 9113 frame-size, stream-id=0, and PADDED payload validation,
--     plus zero-alloc control frame writers (`SETTINGS`, `PING`, `GOAWAY`,
--     `RST_STREAM`, `WINDOW_UPDATE`).
module Net.Http.V2.Frame where

  import Data.Bool
  import Data.Core
  import Data.Machine
  import Engine.Types
  import Engine.Mem.DmaPool
  import Prim.Atomic

  -- Constants & protocol defaults
  export h2-frame-header-len, h2-client-preface-len
  export h2-default-max-frame-size, h2-max-allowed-frame-size
  export h2-default-initial-window-size, h2-max-window-size
  export h2-default-header-table-size, h2-stream-id-mask

  -- Frame types (RFC 9113 §6 & RFC 9218 §7)
  export h2-frame-data, h2-frame-headers, h2-frame-priority, h2-frame-rst-stream
  export h2-frame-settings, h2-frame-push-promise, h2-frame-ping, h2-frame-goaway
  export h2-frame-window-update, h2-frame-continuation, h2-frame-priority-update

  -- Frame flags
  export h2-flag-none, h2-flag-end-stream, h2-flag-ack
  export h2-flag-end-headers, h2-flag-padded, h2-flag-priority

  -- RFC 9113 §7 error codes (`0x0` .. `0xd`)
  export h2-err-no-error, h2-err-protocol-error, h2-err-internal-error
  export h2-err-flow-control-error, h2-err-settings-timeout, h2-err-stream-closed
  export h2-err-frame-size-error, h2-err-refused-stream, h2-err-cancel
  export h2-err-compression-error, h2-err-connect-error, h2-err-enhance-your-calm
  export h2-err-inadequate-security, h2-err-http11-required

  -- RFC 9113 §6.5.2 & RFC 8441 SETTINGS identifiers
  export h2-setting-header-table-size, h2-setting-enable-push
  export h2-setting-max-concurrent-streams, h2-setting-initial-window-size
  export h2-setting-max-frame-size, h2-setting-max-header-list-size
  export h2-setting-enable-connect-protocol

  -- Client preface match results
  export h2-preface-need-more, h2-preface-ok, h2-preface-mismatch

  -- POD records
  export H2FrameHeader, h2-frame-header-empty, h2-frame-header-make, h2-frame-header-eq
  export H2PayloadBounds, h2-payload-bounds-empty

  -- Big-endian DMA scalar helpers
  export h2-read-be16, h2-read-be24, h2-read-be32
  export h2-write-be16, h2-write-be24, h2-write-be32

  -- Preface, header codec, zero-copy headroom framing, and validation
  export h2-preface-write-dma, h2-preface-match-dma
  export h2-frame-read-header-dma, h2-frame-write-header-dma
  export h2-frame-write-headroom, h2-frame-write-headroom-raw
  export h2-frame-validate-header, h2-frame-strip-padding-dma

  -- Control frame writers (`#[no-alloc]`)
  export h2-write-settings-ack-dma, h2-write-settings-entry-dma
  export h2-write-ping-dma, h2-write-goaway-dma
  export h2-write-rst-stream-dma, h2-write-window-update-dma

  -- =========================================================================
  -- 0. Internal #[no-alloc] boolean & packing helpers
  -- =========================================================================

  #[inline(always)]
  #[no-alloc]
  b-true :: Bool
  b-true = eq-u32 0 0

  #[inline(always)]
  #[no-alloc]
  b-false :: Bool
  b-false = eq-u32 0 1

  #[inline(always)]
  #[no-alloc]
  both :: Bool -> Bool -> Bool
  both a b = if a then b else b-false

  #[inline(always)]
  #[no-alloc]
  either :: Bool -> Bool -> Bool
  either a b = if a then b-true else b

  #[inline(always)]
  #[no-alloc]
  pack-le4 :: U8 -> U8 -> U8 -> U8 -> U32
  pack-le4 c0 c1 c2 c3 =
    bit-or-u32
      (bit-or-u32 (u8-to-u32 c0) (wrapping-shl-u32 (u8-to-u32 c1) 8))
      (bit-or-u32 (wrapping-shl-u32 (u8-to-u32 c2) 16) (wrapping-shl-u32 (u8-to-u32 c3) 24))

  #[inline(always)]
  #[no-alloc]
  pack-le8 :: U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U64
  pack-le8 c0 c1 c2 c3 c4 c5 c6 c7 =
    let lo = u32-to-u64 (pack-le4 c0 c1 c2 c3) in
    let hi = u32-to-u64 (pack-le4 c4 c5 c6 c7) in
    bit-or-u64 lo (wrapping-shl-u64 hi 32)

