  qpack-err-buf-too-small = 2

  #[inline(always)]
  #[no-alloc]
  qpack-err-int-overflow :: U8
  qpack-err-int-overflow = 3

  #[inline(always)]
  #[no-alloc]
  qpack-err-huffman-invalid :: U8
  qpack-err-huffman-invalid = 4

  #[inline(always)]
  #[no-alloc]
  qpack-err-invalid-static-index :: U8
  qpack-err-invalid-static-index = 5

  #[inline(always)]
  #[no-alloc]
  qpack-err-invalid-dynamic-index :: U8
  qpack-err-invalid-dynamic-index = 6

  #[inline(always)]
  #[no-alloc]
  qpack-err-invalid-req-insert-count :: U8
  qpack-err-invalid-req-insert-count = 7

  #[inline(always)]
  #[no-alloc]
