  -- | Return packed `(bit-len << 32) | code` for RFC 7541 Huffman symbol `b`.
  #[inline(always)]
  #[no-alloc]
  huff-enc-entry :: U8 -> U64
  huff-enc-entry b =
    let page = wrapping-shr-u8 b 6 in
    let lo = bit-and-u8 b 63 in
    if eq-u8 page 0 then huff-enc-page0 lo
    else if eq-u8 page 1 then huff-enc-page1 lo
    else if eq-u8 page 2 then huff-enc-page2 lo
    else huff-enc-page3 lo

