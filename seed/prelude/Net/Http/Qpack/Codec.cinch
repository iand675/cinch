  #[no-alloc]
  huff-dfa-word :: U32 -> U64
  huff-dfa-word widx =
    let page = wrapping-shr-u32 widx 6 in
    let lo = bit-and-u32 widx 63 in
    case page of
      0 -> huff-dfa-page0 lo
      1 -> huff-dfa-page1 lo
      2 -> huff-dfa-page2 lo
      3 -> huff-dfa-page3 lo
      4 -> huff-dfa-page4 lo
      5 -> huff-dfa-page5 lo
      6 -> huff-dfa-page6 lo
      7 -> huff-dfa-page7 lo
      8 -> huff-dfa-page8 lo
      9 -> huff-dfa-page9 lo
      10 -> huff-dfa-page10 lo
      11 -> huff-dfa-page11 lo
      12 -> huff-dfa-page12 lo
      13 -> huff-dfa-page13 lo
      14 -> huff-dfa-page14 lo
      15 -> huff-dfa-page15 lo
      other -> 18446744073709551615

  -- | 1-step 4-bit nibble DFA lookup: returns packed U16:
  -- `0xFFFF` = fail (EOS), bit 15 = 1 => emit `entry & 0xFF` & next `(entry >> 8) & 0xF`,
  -- bit 15 = 0 => no emit & next `entry & 0xFF`.
  #[inline(always)]
  #[no-alloc]
  huff-dfa-step :: U8 -> U8 -> U16
  huff-dfa-step state nib =
    let widx = bit-or-u32 (wrapping-shl-u32 (u8-to-u32 state) 2) (u8-to-u32 (wrapping-shr-u8 nib 2)) in
    let lane = u8-to-u32 (bit-and-u8 nib 3) in
    let word = huff-dfa-word widx in
    wrapping-u64-to-u16 (wrapping-shr-u64 word (wrapping-shl-u32 lane 4))

  -- | True iff final DFA state corresponds to 0..7 bits of all-1s EOS padding.
  #[inline(always)]
  #[no-alloc]
  huff-dfa-is-accept :: U8 -> Bool
  huff-dfa-is-accept state = case state of
    0 -> b-true
    2 -> b-true
    6 -> b-true
    14 -> b-true
    30 -> b-true
    52 -> b-true
    70 -> b-true
    74 -> b-true
    other -> b-false

  -- =========================================================================
  -- 4. Huffman Encoder, 4-Bit Nibble DFA Decoder & N-bit String Literals
  -- =========================================================================

  #[no-alloc]
  huff-len-loop :: I64 -> U32 -> U32 -> U64 ->{MVar} U64
  huff-len-loop src i len bits =
    if ge-u32 i len then bits
    else
      let b = raw-load-u8 (wrapping-add-i64 src (u32-to-i64 i)) in
      let blen = wrapping-shr-u64 (huff-enc-entry b) 32 in
      huff-len-loop src (wrapping-add-u32 i 1) len (wrapping-add-u64 bits blen)

  -- | Exact byte length of the RFC 7541 Huffman encoding of `[src, src + len)`.
  #[no-alloc]
  qpack-huffman-encoded-len :: I64 -> U32 ->{MVar} U32
  qpack-huffman-encoded-len src len =
    let bits = huff-len-loop src 0 len 0 in
    wrapping-u64-to-u32 (wrapping-shr-u64 (wrapping-add-u64 bits 7) 3)

  #[no-alloc]
  huff-flush-bytes :: I64 -> U32 -> U32 -> U64 -> U32 ->{MVar} QpackIntResult
  huff-flush-bytes dst pos cap acc nbits =
    if lt-u32 nbits 8 then QpackIntResult acc pos qpack-ok (wrapping-u32-to-u8 nbits) 0
    else if ge-u32 pos cap then QpackIntResult 0 pos qpack-err-buf-too-small 0 0
    else
      let n2 = wrapping-sub-u32 nbits 8 in
      let byte = wrapping-u64-to-u8 (wrapping-shr-u64 acc n2) in
      let _ = raw-store-u8 (wrapping-add-i64 dst (u32-to-i64 pos)) byte in
      let mask = if eq-u32 n2 0 then 0 else wrapping-sub-u64 (wrapping-shl-u64 1 n2) 1 in
      huff-flush-bytes dst (wrapping-add-u32 pos 1) cap (bit-and-u64 acc mask) n2

  #[no-alloc]
  huff-enc-loop :: I64 -> U32 -> U32 -> I64 -> U32 -> U32 -> U64 -> U32 ->{MVar} QpackEncodeResult
  huff-enc-loop src i len dst pos cap acc nbits =
    if ge-u32 i len then
      if eq-u32 nbits 0 then QpackEncodeResult pos qpack-ok 0 0
      else if ge-u32 pos cap then QpackEncodeResult pos qpack-err-buf-too-small 0 0
      else
        let pad = wrapping-sub-u32 8 nbits in
        let pad-mask = wrapping-sub-u64 (wrapping-shl-u64 1 pad) 1 in
        let final-byte = wrapping-u64-to-u8 (bit-or-u64 (wrapping-shl-u64 acc pad) pad-mask) in
        let _ = raw-store-u8 (wrapping-add-i64 dst (u32-to-i64 pos)) final-byte in
        QpackEncodeResult (wrapping-add-u32 pos 1) qpack-ok 0 0
    else
      let b = raw-load-u8 (wrapping-add-i64 src (u32-to-i64 i)) in
      let entry = huff-enc-entry b in
      let blen = wrapping-u64-to-u32 (wrapping-shr-u64 entry 32) in
      let code = bit-and-u64 entry 4294967295 in
      let acc2 = bit-or-u64 (wrapping-shl-u64 acc blen) code in
      let nbits2 = wrapping-add-u32 nbits blen in
      let fl = huff-flush-bytes dst pos cap acc2 nbits2 in
      if ne-u8 fl.qi-err qpack-ok then QpackEncodeResult fl.qi-next fl.qi-err 0 0
      else huff-enc-loop src (wrapping-add-u32 i 1) len dst fl.qi-next cap fl.qi-val (u8-to-u32 fl.qi-pad0)

  -- | RFC 7541/9204 Huffman-encode `[src, src + len)` into `[dst + pos, dst + cap)`.
  #[no-alloc]
  qpack-huffman-encode :: I64 -> U32 -> I64 -> U32 -> U32 ->{MVar} QpackEncodeResult
  qpack-huffman-encode src len dst pos cap =
    huff-enc-loop src 0 len dst pos cap 0 0

  #[no-alloc]
  huff-dec-loop :: I64 -> U32 -> U32 -> I64 -> U32 -> U32 -> U8 ->{MVar} QpackStrResult
  huff-dec-loop src pos end dst out-pos out-cap state =
    if ge-u32 pos end then
      if huff-dfa-is-accept state then QpackStrResult out-pos pos qpack-ok 0 0
      else QpackStrResult out-pos pos qpack-err-huffman-invalid 0 0
    else
      let b = raw-load-u8 (wrapping-add-i64 src (u32-to-i64 pos)) in
      let hi = wrapping-shr-u8 b 4 in
      let lo = bit-and-u8 b 15 in
      let e0 = huff-dfa-step state hi in
      if eq-u16 e0 65535 then QpackStrResult out-pos pos qpack-err-huffman-invalid 0 0
      else
        let emit0 = ne-u16 (bit-and-u16 e0 32768) 0 in
        if both emit0 (ge-u32 out-pos out-cap) then
          QpackStrResult out-pos pos qpack-err-buf-too-small 0 0
        else
          let _ = if emit0 then raw-store-u8 (wrapping-add-i64 dst (u32-to-i64 out-pos)) (wrapping-u16-to-u8 e0) else () in
          let out1 = if emit0 then wrapping-add-u32 out-pos 1 else out-pos in
          let st1 = if emit0 then bit-and-u8 (wrapping-u16-to-u8 (wrapping-shr-u16 e0 8)) 15 else wrapping-u16-to-u8 e0 in
          let e1 = huff-dfa-step st1 lo in
          if eq-u16 e1 65535 then QpackStrResult out1 pos qpack-err-huffman-invalid 0 0
          else
            let emit1 = ne-u16 (bit-and-u16 e1 32768) 0 in
            if both emit1 (ge-u32 out1 out-cap) then
              QpackStrResult out1 pos qpack-err-buf-too-small 0 0
            else
              let _ = if emit1 then raw-store-u8 (wrapping-add-i64 dst (u32-to-i64 out1)) (wrapping-u16-to-u8 e1) else () in
              let out2 = if emit1 then wrapping-add-u32 out1 1 else out1 in
              let st2 = if emit1 then bit-and-u8 (wrapping-u16-to-u8 (wrapping-shr-u16 e1 8)) 15 else wrapping-u16-to-u8 e1 in
              huff-dec-loop src (wrapping-add-u32 pos 1) end dst out2 out-cap st2

  -- | RFC 7541/9204 4-bit nibble DFA Huffman decode `[src + pos, src + pos + enc-len)`
  -- into `[dst + out-pos, dst + out-cap)`. Returns decoded bytes written in `qs-out-len`
  -- (relative to `out-pos`) and next input offset in `qs-next`.
  #[no-alloc]
  qpack-huffman-decode :: I64 -> U32 -> U32 -> I64 -> U32 -> U32 ->{MVar} QpackStrResult
  qpack-huffman-decode src pos enc-len dst out-pos out-cap =
    let end = wrapping-add-u32 pos enc-len in
    let res = huff-dec-loop src pos end dst out-pos out-cap 0 in
    if ne-u8 res.qs-err qpack-ok then QpackStrResult 0 res.qs-next res.qs-err 0 0
    else QpackStrResult (wrapping-sub-u32 res.qs-out-len out-pos) res.qs-next qpack-ok 0 0

  -- | Encode an N-bit prefix string literal (RFC 9204 §4.1.2, `str-prefix-n` in `2..8`,
  -- typically 4, 6, or 8). `huff-mode`: `0` = never, `1` = auto (if smaller), `2` = force.
  #[no-alloc]
  qpack-encode-string :: I64 -> U32 -> U32 -> U8 -> U8 -> U8 -> I64 -> U32 ->{MVar} QpackEncodeResult
  qpack-encode-string out-addr out-pos out-cap prefix-mask str-prefix-n huff-mode src-addr src-len =
    if either (lt-u8 str-prefix-n 2) (gt-u8 str-prefix-n 8) then
      QpackEncodeResult out-pos qpack-err-invalid-prefix 0 0
    else
      let len-prefix = wrapping-sub-u8 str-prefix-n 1 in
      let h-bit = wrapping-shl-u8 1 (u8-to-u32 len-prefix) in
      let hlen = if eq-u8 huff-mode qpack-huff-never then src-len else qpack-huffman-encoded-len src-addr src-len in
      let do-huff = (
        if eq-u8 huff-mode qpack-huff-force then b-true
        else if eq-u8 huff-mode qpack-huff-auto then lt-u32 hlen src-len
        else b-false) in
      if do-huff then
        let r0 = qpack-encode-int out-addr out-pos out-cap (bit-or-u8 prefix-mask h-bit) len-prefix (u32-to-u64 hlen) in
        if ne-u8 r0.qe-err qpack-ok then r0
        else qpack-huffman-encode src-addr src-len out-addr r0.qe-written out-cap
      else
        let r0 = qpack-encode-int out-addr out-pos out-cap prefix-mask len-prefix (u32-to-u64 src-len) in
        if ne-u8 r0.qe-err qpack-ok then r0
        else if gt-u32 src-len (saturating-sub-u32 out-cap r0.qe-written) then
          QpackEncodeResult r0.qe-written qpack-err-buf-too-small 0 0
        else
          let _ = dma-copy (wrapping-add-i64 out-addr (u32-to-i64 r0.qe-written)) src-addr src-len in
          QpackEncodeResult (wrapping-add-u32 r0.qe-written src-len) qpack-ok 0 0

  -- | Decode an N-bit prefix string literal (RFC 9204 §4.1.2, `str-prefix-n` in `2..8`)
  -- from `[in-addr + in-pos, in-addr + in-len)` into `[out-addr + out-pos, out-addr + out-cap)`.
  -- Returns decoded byte count in `qs-out-len` and next input position in `qs-next`.
  #[no-alloc]
  qpack-decode-string :: I64 -> U32 -> U32 -> U8 -> I64 -> U32 -> U32 ->{MVar} QpackStrResult
  qpack-decode-string in-addr in-pos in-len str-prefix-n out-addr out-pos out-cap =
    if either (lt-u8 str-prefix-n 2) (gt-u8 str-prefix-n 8) then
      QpackStrResult 0 in-pos qpack-err-invalid-prefix 0 0
    else if ge-u32 in-pos in-len then
      QpackStrResult 0 in-pos qpack-err-truncated 0 0
    else
      let len-prefix = wrapping-sub-u8 str-prefix-n 1 in
      let h-bit = wrapping-shl-u8 1 (u8-to-u32 len-prefix) in
      let b0 = raw-load-u8 (wrapping-add-i64 in-addr (u32-to-i64 in-pos)) in
      let is-huff = ne-u8 (bit-and-u8 b0 h-bit) 0 in
      let lr = qpack-decode-int in-addr in-pos in-len len-prefix in
      if ne-u8 lr.qi-err qpack-ok then QpackStrResult 0 lr.qi-next lr.qi-err 0 0
      else
        let rem-in = u32-to-u64 (saturating-sub-u32 in-len lr.qi-next) in
        if gt-u64 lr.qi-val rem-in then QpackStrResult 0 lr.qi-next qpack-err-truncated 0 0
        else
          let enc-len = wrapping-u64-to-u32 lr.qi-val in
          if is-huff then
            qpack-huffman-decode in-addr lr.qi-next enc-len out-addr out-pos out-cap
          else if gt-u32 enc-len (saturating-sub-u32 out-cap out-pos) then
            QpackStrResult 0 lr.qi-next qpack-err-buf-too-small 0 0
          else
            let _ = dma-copy (wrapping-add-i64 out-addr (u32-to-i64 out-pos)) (wrapping-add-i64 in-addr (u32-to-i64 lr.qi-next)) enc-len in
            QpackStrResult enc-len (wrapping-add-u32 lr.qi-next enc-len) qpack-ok 0 0

  -- =========================================================================
  -- 5. RFC 9204 §4.5.1 Field Section Prefix (Required Insert Count + Base)
  -- =========================================================================

  -- | RFC 9204 §4.5.1.1: `MaxEntries = floor(max_table_cap / 32)`.
  #[inline(always)]
  #[no-alloc]
  qpack-max-entries :: U64 -> U64
  qpack-max-entries max-table-cap = wrapping-shr-u64 max-table-cap 5

  #[inline(always)]
  #[no-alloc]
  safe-rem-u64 :: U64 -> U64 -> U64
  safe-rem-u64 a b =
    if b /= 0 then rem-u64 a b else 0

  #[inline(always)]
  #[no-alloc]
  safe-div-u64 :: U64 -> U64 -> U64
  safe-div-u64 a b =
    if b /= 0 then div-u64 a b else 0

  -- | Encode RFC 9204 §4.5.1 Field Section Prefix (`Required Insert Count` + `S | Delta Base`).
  #[no-alloc]
  qpack-encode-prefix :: I64 -> U32 -> U32 -> U64 -> U64 -> U64 ->{MVar} QpackEncodeResult
  qpack-encode-prefix out-addr out-pos out-cap max-table-cap req-insert-count base =
    let max-entries = qpack-max-entries max-table-cap in
    if both (ne-u64 req-insert-count 0) (eq-u64 max-entries 0) then
      QpackEncodeResult out-pos qpack-err-invalid-req-insert-count 0 0
    else
      let enc-ric = (
        if eq-u64 req-insert-count 0 then 0
        else
          let full-range = wrapping-shl-u64 max-entries 1 in
          wrapping-add-u64 (safe-rem-u64 req-insert-count full-range) 1) in
      let r0 = qpack-encode-int out-addr out-pos out-cap 0 8 enc-ric in
      if ne-u8 r0.qe-err qpack-ok then r0
      else if ge-u64 base req-insert-count then
        qpack-encode-int out-addr r0.qe-written out-cap 0 7 (wrapping-sub-u64 base req-insert-count)
      else
        let delta = wrapping-sub-u64 (wrapping-sub-u64 req-insert-count base) 1 in
        qpack-encode-int out-addr r0.qe-written out-cap 128 7 delta

  -- | Decode RFC 9204 §4.5.1 Field Section Prefix (`Required Insert Count` + `Base`)
  -- with exact §4.5.1.1 wraparound reconstruction and §4.5.1.2 negative-Base guard.
  #[no-alloc]
  qpack-decode-prefix :: I64 -> U32 -> U32 -> U64 -> U64 ->{MVar} QpackPrefixResult
  qpack-decode-prefix in-addr in-pos in-len max-table-cap total-inserts =
    let r0 = qpack-decode-int in-addr in-pos in-len 8 in
    if ne-u8 r0.qi-err qpack-ok then
      QpackPrefixResult 0 0 r0.qi-next r0.qi-err 0 0
    else if ge-u32 r0.qi-next in-len then
      QpackPrefixResult 0 0 r0.qi-next qpack-err-truncated 0 0
    else
      let sign-byte = raw-load-u8 (wrapping-add-i64 in-addr (u32-to-i64 r0.qi-next)) in
      let sign-neg = ne-u8 (bit-and-u8 sign-byte 128) 0 in
      let r1 = qpack-decode-int in-addr r0.qi-next in-len 7 in
      if ne-u8 r1.qi-err qpack-ok then
        QpackPrefixResult 0 0 r1.qi-next r1.qi-err 0 0
      else
        let enc-ric = r0.qi-val in
        let delta = r1.qi-val in
        if eq-u64 enc-ric 0 then
          if sign-neg then QpackPrefixResult 0 0 r1.qi-next qpack-err-invalid-base 0 0
          else QpackPrefixResult 0 delta r1.qi-next qpack-ok 0 0
        else
          let max-entries = qpack-max-entries max-table-cap in
          let full-range = wrapping-shl-u64 max-entries 1 in
          if either (eq-u64 full-range 0) (gt-u64 enc-ric full-range) then
            QpackPrefixResult 0 0 r1.qi-next qpack-err-invalid-req-insert-count 0 0
          else
            let max-val = saturating-add-u64 total-inserts max-entries in
            let max-wrapped = wrapping-mul-u64 (safe-div-u64 max-val full-range) full-range in
            let ric0 = wrapping-add-u64 max-wrapped (wrapping-sub-u64 enc-ric 1) in
            let bad-wrap = both (gt-u64 ric0 max-val) (le-u64 ric0 full-range) in
            if bad-wrap then
              QpackPrefixResult 0 0 r1.qi-next qpack-err-invalid-req-insert-count 0 0
            else
              let ric = if gt-u64 ric0 max-val then wrapping-sub-u64 ric0 full-range else ric0 in
              if eq-u64 ric 0 then
                QpackPrefixResult 0 0 r1.qi-next qpack-err-invalid-req-insert-count 0 0
              else if sign-neg then
                if le-u64 ric delta then
                  QpackPrefixResult 0 0 r1.qi-next qpack-err-invalid-base 0 0
                else
                  let base = wrapping-sub-u64 (wrapping-sub-u64 ric delta) 1 in
                  QpackPrefixResult ric base r1.qi-next qpack-ok 0 0
              else if gt-u64 delta (wrapping-sub-u64 qpack-max-int62 ric) then
                QpackPrefixResult 0 0 r1.qi-next qpack-err-int-overflow 0 0
              else
                QpackPrefixResult ric (wrapping-add-u64 ric delta) r1.qi-next qpack-ok 0 0

  -- =========================================================================
  -- 6. DMA-Backed Bounded Dynamic Table Ring Buffer (RFC 9204 §3.2)
  -- =========================================================================

  -- Contiguous single-slab DMA layout:
  -- Header (128 bytes):
  --   +0   : max-cap        :: U64  (SETTINGS_QPACK_MAX_TABLE_CAPACITY)
  --   +8   : cur-cap        :: U64  (active capacity <= max-cap, starts 0)
  --   +16  : cur-size       :: U64  (sum of name_len + val_len + 32)
  --   +24  : insert-count   :: U64  (total inserts; next absolute index)
  --   +32  : dropped-count  :: U64  (total evicted; oldest live absolute index)
  --   +40  : known-received :: U64  (Known Received Count)
  --   +48  : slot-mask      :: U32  (slot_cap - 1, power of two)
  --   +52  : data-mask      :: U32  (data_cap - 1, power of two)
  --   +56  : data-head      :: U32  (circular byte ring write head)
  --   +60  : scratch-cap    :: U32  (size of temp scratch region)
  --   +64  : slab-bytes     :: U64  (total mmap size for engine-dma-free)
  --   +72  : scratch-addr   :: I64  (scratch buffer address inside slab)
  --   +80  : destroyed      :: U32  (0 = live, 1 = destroyed)
  --   +84  : blocked-streams :: U32
  -- Slot array at `slots-addr`: `slot_cap` entries x 16 bytes:
  --   +0 : name-off :: U32, +4 : name-len :: U32, +8 : val-off :: U32, +12 : val-len :: U32
  -- Byte ring at `ring-addr`: `data_cap` bytes (power of two >= max(4096, 2 * max_cap)).
  -- Scratch at `scratch-addr`: `scratch_cap` bytes (>= max(4096, 2 * max_cap)).

  data QpackDynamicTable where
    MkQpackDynamicTable :: I64 -> I64 -> I64 -> QpackDynamicTable

  #[inline(never)]
  #[no-alloc]
  tbl-hdr :: QpackDynamicTable -> I64
  tbl-hdr t = case t of MkQpackDynamicTable h _ _ -> h

  #[inline(never)]
  #[no-alloc]
  tbl-slots :: QpackDynamicTable -> I64
  tbl-slots t = case t of MkQpackDynamicTable _ s _ -> s

  #[inline(never)]
  #[no-alloc]
  tbl-ring :: QpackDynamicTable -> I64
  tbl-ring t = case t of MkQpackDynamicTable _ _ r -> r

  next-pow2-u32 :: U32 -> U32 -> U32
  next-pow2-u32 need cur =
    if ge-u32 cur need then cur
    else if ge-u32 cur 1073741824 then 2147483648
    else next-pow2-u32 need (wrapping-shl-u32 cur 1)

  -- | Allocate a DMA-backed bounded `QpackDynamicTable` with maximum capacity `max-cap`.
  -- Initial active capacity is `0` per RFC 9204 §3.2.2; pass `0` for zero-HOL mode.
  qpack-table-new :: U64 ->{IO, MVar} Option QpackDynamicTable
  qpack-table-new max-cap =
    -- Cap max-cap at 64 MiB for safe single-slab DMA allocation
    if gt-u64 max-cap 67108864 then None
    else
      let max-cap32 = wrapping-u64-to-u32 max-cap in
      let min-slots = wrapping-add-u32 (wrapping-shr-u32 max-cap32 5) 2 in
      let slot-cap = next-pow2-u32 (if lt-u32 min-slots 64 then 64 else min-slots) 64 in
      let min-data = wrapping-mul-u32 max-cap32 2 in
      let data-cap = next-pow2-u32 (if lt-u32 min-data 4096 then 4096 else min-data) 4096 in
      let scratch-cap = data-cap in
      let hdr-bytes = 128 in
      let slots-bytes = wrapping-mul-u64 (u32-to-u64 slot-cap) 16 in
      let total-bytes = wrapping-add-u64 (wrapping-add-u64 hdr-bytes slots-bytes) (wrapping-add-u64 (u32-to-u64 data-cap) (u32-to-u64 scratch-cap)) in
      let slab-u64 = engine-dma-alloc total-bytes 4096 in
      if eq-u64 slab-u64 0 then None
      else
        let hdr = wrapping-u64-to-i64 slab-u64 in
        let slots = wrapping-add-i64 hdr 128 in
        let ring = wrapping-add-i64 slots (wrapping-u64-to-i64 slots-bytes) in
        let scratch = wrapping-add-i64 ring (u32-to-i64 data-cap) in
        let _ = raw-store-u64 hdr max-cap in
        let _ = raw-store-u64 (wrapping-add-i64 hdr 8) 0 in
        let _ = raw-store-u64 (wrapping-add-i64 hdr 16) 0 in
        let _ = raw-store-u64 (wrapping-add-i64 hdr 24) 0 in
        let _ = raw-store-u64 (wrapping-add-i64 hdr 32) 0 in
        let _ = raw-store-u64 (wrapping-add-i64 hdr 40) 0 in
        let _ = raw-store-u32 (wrapping-add-i64 hdr 48) (wrapping-sub-u32 slot-cap 1) in
        let _ = raw-store-u32 (wrapping-add-i64 hdr 52) (wrapping-sub-u32 data-cap 1) in
        let _ = raw-store-u32 (wrapping-add-i64 hdr 56) 0 in
        let _ = raw-store-u32 (wrapping-add-i64 hdr 60) scratch-cap in
        let _ = raw-store-u64 (wrapping-add-i64 hdr 64) total-bytes in
        let _ = raw-store-i64 (wrapping-add-i64 hdr 72) scratch in
        let _ = raw-store-u32 (wrapping-add-i64 hdr 80) 0 in
        let _ = raw-store-u32 (wrapping-add-i64 hdr 84) 0 in
        Some (MkQpackDynamicTable hdr slots ring)

  -- | Unmap the DMA slab backing `table`.
  qpack-table-destroy :: QpackDynamicTable ->{IO, MVar} Unit
  qpack-table-destroy table =
    let hdr = tbl-hdr table in
    if eq-i64 hdr 0 then ()
    else
      let d = raw-load-u32 (wrapping-add-i64 hdr 80) in
      if ne-u32 d 0 then ()
      else
        let total = raw-load-u64 (wrapping-add-i64 hdr 64) in
        let _ = raw-store-u32 (wrapping-add-i64 hdr 80) 1 in
        let _ = engine-dma-free (wrapping-i64-to-u64 hdr) total in
        ()

  #[inline(always)]
  #[no-alloc]
  qpack-table-max-cap :: QpackDynamicTable ->{MVar} U64
  qpack-table-max-cap t = raw-load-u64 (tbl-hdr t)

  #[inline(always)]
  #[no-alloc]
  qpack-table-capacity :: QpackDynamicTable ->{MVar} U64
  qpack-table-capacity t = raw-load-u64 (wrapping-add-i64 (tbl-hdr t) 8)

  #[inline(always)]
  #[no-alloc]
  qpack-table-size :: QpackDynamicTable ->{MVar} U64
  qpack-table-size t = raw-load-u64 (wrapping-add-i64 (tbl-hdr t) 16)

  #[inline(always)]
  #[no-alloc]
  qpack-table-insert-count :: QpackDynamicTable ->{MVar} U64
  qpack-table-insert-count t = raw-load-u64 (wrapping-add-i64 (tbl-hdr t) 24)

  #[inline(always)]
  #[no-alloc]
  qpack-table-dropped-count :: QpackDynamicTable ->{MVar} U64
  qpack-table-dropped-count t = raw-load-u64 (wrapping-add-i64 (tbl-hdr t) 32)

  #[inline(always)]
  #[no-alloc]
  qpack-table-known-received :: QpackDynamicTable ->{MVar} U64
  qpack-table-known-received t = raw-load-u64 (wrapping-add-i64 (tbl-hdr t) 40)

  #[inline(always)]
  #[no-alloc]
  qpack-table-live-count :: QpackDynamicTable ->{MVar} U64
  qpack-table-live-count t =
    wrapping-sub-u64 (qpack-table-insert-count t) (qpack-table-dropped-count t)

  #[inline(always)]
  #[no-alloc]
  qpack-table-blocked-streams :: QpackDynamicTable ->{MVar} U32
  qpack-table-blocked-streams t = raw-load-u32 (wrapping-add-i64 (tbl-hdr t) 84)

  #[inline(always)]
  #[no-alloc]
  slot-ptr :: QpackDynamicTable -> U64 ->{MVar} I64
  slot-ptr t abs-idx =
    let mask = raw-load-u32 (wrapping-add-i64 (tbl-hdr t) 48) in
    let idx = bit-and-u32 (wrapping-u64-to-u32 abs-idx) mask in
    wrapping-add-i64 (tbl-slots t) (wrapping-shl-i64 (u32-to-i64 idx) 4)

  -- Circular byte ring write: copies `len` bytes from linear `src` into ring at `head`.
  -- Returns updated `head`.
  #[no-alloc]
  ring-write-bytes :: I64 -> U32 -> U32 -> I64 -> U32 ->{MVar} U32
  ring-write-bytes ring mask head src len =
    if eq-u32 len 0 then head
    else
      let cap = wrapping-add-u32 mask 1 in
      let off = bit-and-u32 head mask in
      let avail = wrapping-sub-u32 cap off in
      if le-u32 len avail then
        let _ = dma-copy (wrapping-add-i64 ring (u32-to-i64 off)) src len in
        bit-and-u32 (wrapping-add-u32 off len) mask
      else
        let _ = dma-copy (wrapping-add-i64 ring (u32-to-i64 off)) src avail in
        let rem = wrapping-sub-u32 len avail in
        let _ = dma-copy ring (wrapping-add-i64 src (u32-to-i64 avail)) rem in
        bit-and-u32 rem mask

  -- Circular byte ring read: copies `len` bytes from ring at `off` into linear `dst`.
  #[no-alloc]
  ring-read-bytes :: I64 -> U32 -> U32 -> U32 -> I64 ->{MVar} Unit
  ring-read-bytes ring mask off len dst =
    if eq-u32 len 0 then ()
    else
      let cap = wrapping-add-u32 mask 1 in
      let start = bit-and-u32 off mask in
      let avail = wrapping-sub-u32 cap start in
      if le-u32 len avail then
        dma-copy dst (wrapping-add-i64 ring (u32-to-i64 start)) len
      else
        let _ = dma-copy dst (wrapping-add-i64 ring (u32-to-i64 start)) avail in
        let rem = wrapping-sub-u32 len avail in
        dma-copy (wrapping-add-i64 dst (u32-to-i64 avail)) ring rem

  -- Evict oldest entries until `cur-size <= goal`.
  #[no-alloc]
  evict-to-size :: QpackDynamicTable -> U64 ->{MVar} Unit
  evict-to-size t goal =
    let hdr = tbl-hdr t in
    let cur-size = raw-load-u64 (wrapping-add-i64 hdr 16) in
    if le-u64 cur-size goal then ()
    else
      let dropped = raw-load-u64 (wrapping-add-i64 hdr 32) in
      let ins = raw-load-u64 (wrapping-add-i64 hdr 24) in
      if ge-u64 dropped ins then ()
      else
        let sp = slot-ptr t dropped in
        let nlen = raw-load-u32 (wrapping-add-i64 sp 4) in
        let vlen = raw-load-u32 (wrapping-add-i64 sp 12) in
        let esize = wrapping-add-u64 (wrapping-add-u64 (u32-to-u64 nlen) (u32-to-u64 vlen)) 32 in
        let _ = raw-store-u64 (wrapping-add-i64 hdr 16) (saturating-sub-u64 cur-size esize) in
        let _ = raw-store-u64 (wrapping-add-i64 hdr 32) (wrapping-add-u64 dropped 1) in
        evict-to-size t goal

  -- | Set Dynamic Table Capacity (RFC 9204 §3.2.2 / §4.3.1), evicting oldest entries
  -- if needed. Rejects `new-cap > max-cap` with `qpack-err-encoder-stream`.
  #[no-alloc]
  qpack-table-set-capacity :: QpackDynamicTable -> U64 ->{MVar} U8
  qpack-table-set-capacity t new-cap =
    let hdr = tbl-hdr t in
    let max-cap = raw-load-u64 hdr in
    if gt-u64 new-cap max-cap then qpack-err-encoder-stream
    else
      let _ = evict-to-size t new-cap in
      let _ = raw-store-u64 (wrapping-add-i64 hdr 8) new-cap in
      qpack-ok

  -- | Insert `(name, value)` into `table` (RFC 9204 §3.2.2), evicting oldest entries
  -- as required. Rejects `name-len + val-len + 32 > cur-cap` with `qpack-err-encoder-stream`.
  #[no-alloc]
  qpack-table-insert :: QpackDynamicTable -> I64 -> U32 -> I64 -> U32 ->{MVar} U8
  qpack-table-insert t name-addr name-len val-addr val-len =
    let hdr = tbl-hdr t in
    let cur-cap = raw-load-u64 (wrapping-add-i64 hdr 8) in
    let esize = wrapping-add-u64 (wrapping-add-u64 (u32-to-u64 name-len) (u32-to-u64 val-len)) 32 in
    if gt-u64 esize cur-cap then qpack-err-encoder-stream
    else
      let _ = evict-to-size t (wrapping-sub-u64 cur-cap esize) in
      let ring = tbl-ring t in
      let dmask = raw-load-u32 (wrapping-add-i64 hdr 52) in
      let head0 = raw-load-u32 (wrapping-add-i64 hdr 56) in
      let noff = bit-and-u32 head0 dmask in
      let head1 = ring-write-bytes ring dmask head0 name-addr name-len in
      let voff = bit-and-u32 head1 dmask in
      let head2 = ring-write-bytes ring dmask head1 val-addr val-len in
      let ins = raw-load-u64 (wrapping-add-i64 hdr 24) in
      let sp = slot-ptr t ins in
      let _ = raw-store-u32 sp noff in
      let _ = raw-store-u32 (wrapping-add-i64 sp 4) name-len in
      let _ = raw-store-u32 (wrapping-add-i64 sp 8) voff in
      let _ = raw-store-u32 (wrapping-add-i64 sp 12) val-len in
      let _ = raw-store-u32 (wrapping-add-i64 hdr 56) head2 in
      let cur-size = raw-load-u64 (wrapping-add-i64 hdr 16) in
      let _ = raw-store-u64 (wrapping-add-i64 hdr 16) (wrapping-add-u64 cur-size esize) in
      let _ = raw-store-u64 (wrapping-add-i64 hdr 24) (wrapping-add-u64 ins 1) in
      qpack-ok

  -- | Duplicate an existing entry by encoder-stream relative index `rel-idx`
  -- (`abs = insert_count - rel_idx - 1`, RFC 9204 §4.3.4). Safely stages name & value
  -- through the slab scratch buffer so self-eviction during duplication never clobbers data.
  #[no-alloc]
  qpack-table-duplicate :: QpackDynamicTable -> U64 ->{MVar} U8
  qpack-table-duplicate t rel-idx =
    let hdr = tbl-hdr t in
    let ins = raw-load-u64 (wrapping-add-i64 hdr 24) in
    let dropped = raw-load-u64 (wrapping-add-i64 hdr 32) in
    let live = wrapping-sub-u64 ins dropped in
    if ge-u64 rel-idx live then qpack-err-encoder-stream
    else
      let abs-idx = wrapping-sub-u64 (wrapping-sub-u64 ins rel-idx) 1 in
      let sp = slot-ptr t abs-idx in
      let noff = raw-load-u32 sp in
      let nlen = raw-load-u32 (wrapping-add-i64 sp 4) in
      let voff = raw-load-u32 (wrapping-add-i64 sp 8) in
      let vlen = raw-load-u32 (wrapping-add-i64 sp 12) in
      let scratch = raw-load-i64 (wrapping-add-i64 hdr 72) in
      let scap = raw-load-u32 (wrapping-add-i64 hdr 60) in
      if gt-u64 (wrapping-add-u64 (u32-to-u64 nlen) (u32-to-u64 vlen)) (u32-to-u64 scap) then
        qpack-err-encoder-stream
      else
        let ring = tbl-ring t in
        let dmask = raw-load-u32 (wrapping-add-i64 hdr 52) in
        let _ = ring-read-bytes ring dmask noff nlen scratch in
        let vscratch = wrapping-add-i64 scratch (u32-to-i64 nlen) in
        let _ = ring-read-bytes ring dmask voff vlen vscratch in
        qpack-table-insert t scratch nlen vscratch vlen

  -- | Copy dynamic table entry `abs-idx`'s name into `[out-addr + out-pos, out-addr + out-cap)`.
  #[no-alloc]
  qpack-table-copy-name-abs :: QpackDynamicTable -> U64 -> I64 -> U32 -> U32 ->{MVar} QpackEncodeResult
  qpack-table-copy-name-abs t abs-idx out-addr out-pos out-cap =
    let hdr = tbl-hdr t in
    let ins = raw-load-u64 (wrapping-add-i64 hdr 24) in
    let dropped = raw-load-u64 (wrapping-add-i64 hdr 32) in
    if either (lt-u64 abs-idx dropped) (ge-u64 abs-idx ins) then
      QpackEncodeResult out-pos qpack-err-invalid-dynamic-index 0 0
    else
      let sp = slot-ptr t abs-idx in
      let noff = raw-load-u32 sp in
      let nlen = raw-load-u32 (wrapping-add-i64 sp 4) in
      if gt-u32 nlen (saturating-sub-u32 out-cap out-pos) then
        QpackEncodeResult out-pos qpack-err-buf-too-small 0 0
      else
        let ring = tbl-ring t in
        let dmask = raw-load-u32 (wrapping-add-i64 hdr 52) in
        let _ = ring-read-bytes ring dmask noff nlen (wrapping-add-i64 out-addr (u32-to-i64 out-pos)) in
        QpackEncodeResult (wrapping-add-u32 out-pos nlen) qpack-ok 0 0

  -- | Copy dynamic table entry `abs-idx`'s value into `[out-addr + out-pos, out-addr + out-cap)`.
  #[no-alloc]
  qpack-table-copy-val-abs :: QpackDynamicTable -> U64 -> I64 -> U32 -> U32 ->{MVar} QpackEncodeResult
  qpack-table-copy-val-abs t abs-idx out-addr out-pos out-cap =
    let hdr = tbl-hdr t in
    let ins = raw-load-u64 (wrapping-add-i64 hdr 24) in
    let dropped = raw-load-u64 (wrapping-add-i64 hdr 32) in
    if either (lt-u64 abs-idx dropped) (ge-u64 abs-idx ins) then
      QpackEncodeResult out-pos qpack-err-invalid-dynamic-index 0 0
    else
      let sp = slot-ptr t abs-idx in
      let voff = raw-load-u32 (wrapping-add-i64 sp 8) in
      let vlen = raw-load-u32 (wrapping-add-i64 sp 12) in
      if gt-u32 vlen (saturating-sub-u32 out-cap out-pos) then
        QpackEncodeResult out-pos qpack-err-buf-too-small 0 0
      else
        let ring = tbl-ring t in
        let dmask = raw-load-u32 (wrapping-add-i64 hdr 52) in
        let _ = ring-read-bytes ring dmask voff vlen (wrapping-add-i64 out-addr (u32-to-i64 out-pos)) in
        QpackEncodeResult (wrapping-add-u32 out-pos vlen) qpack-ok 0 0

  -- | Acknowledge a field section with Required Insert Count `ric` (advancing
  -- `known-received = max(known-received, ric)` per RFC 9204 §2.1.4).
  #[no-alloc]
  qpack-table-ack-ric :: QpackDynamicTable -> U64 ->{MVar} U8
  qpack-table-ack-ric t ric =
    let hdr = tbl-hdr t in
    let ins = raw-load-u64 (wrapping-add-i64 hdr 24) in
    if either (eq-u64 ric 0) (gt-u64 ric ins) then qpack-err-decoder-stream
    else
      let kr = raw-load-u64 (wrapping-add-i64 hdr 40) in
      let _ = if gt-u64 ric kr then raw-store-u64 (wrapping-add-i64 hdr 40) ric else () in
      qpack-ok

  -- | Increment `known-received` by `inc` (RFC 9204 §4.4.3).
  -- Rejects `inc == 0` or `known-received + inc > insert-count` with `qpack-err-decoder-stream`.
  #[no-alloc]
  qpack-table-inc-known-received :: QpackDynamicTable -> U64 ->{MVar} U8
  qpack-table-inc-known-received t inc =
    if eq-u64 inc 0 then qpack-err-decoder-stream
    else
      let hdr = tbl-hdr t in
      let ins = raw-load-u64 (wrapping-add-i64 hdr 24) in
      let kr = raw-load-u64 (wrapping-add-i64 hdr 40) in
      if gt-u64 inc (saturating-sub-u64 ins kr) then qpack-err-decoder-stream
      else
        let _ = raw-store-u64 (wrapping-add-i64 hdr 40) (wrapping-add-u64 kr inc) in
        qpack-ok

  -- =========================================================================
  -- 7. RFC 9204 §4.3 Encoder Stream Instructions
  -- =========================================================================

  -- | Encode `Set Dynamic Table Capacity` (`001xxxxx`, 5-bit prefix, §4.3.1).
  #[no-alloc]
  qpack-enc-set-capacity :: I64 -> U32 -> U32 -> U64 ->{MVar} QpackEncodeResult
  qpack-enc-set-capacity out-addr out-pos out-cap cap =
    qpack-encode-int out-addr out-pos out-cap 32 5 cap

  -- | Encode `Insert With Name Reference` (`1Txxxxxx`, 6-bit prefix, §4.3.2).
  -- `is-static`: `1` = static index, `0` = dynamic relative index.
  #[no-alloc]
  qpack-enc-insert-name-ref :: I64 -> U32 -> U32 -> U8 -> U64 -> U8 -> I64 -> U32 ->{MVar} QpackEncodeResult
  qpack-enc-insert-name-ref out-addr out-pos out-cap is-static name-idx huff-mode val-addr val-len =
    let mask = if ne-u8 is-static 0 then 192 else 128 in
    let r0 = qpack-encode-int out-addr out-pos out-cap mask 6 name-idx in
    if ne-u8 r0.qe-err qpack-ok then r0
    else qpack-encode-string out-addr r0.qe-written out-cap 0 8 huff-mode val-addr val-len

  -- | Encode `Insert With Literal Name` (`01Hxxxxx`, 6-bit string name + 8-bit string value, §4.3.3).
  #[no-alloc]
  qpack-enc-insert-literal :: I64 -> U32 -> U32 -> U8 -> I64 -> U32 -> U8 -> I64 -> U32 ->{MVar} QpackEncodeResult
  qpack-enc-insert-literal out-addr out-pos out-cap name-huff name-addr name-len val-huff val-addr val-len =
    let r0 = qpack-encode-string out-addr out-pos out-cap 64 6 name-huff name-addr name-len in
    if ne-u8 r0.qe-err qpack-ok then r0
    else qpack-encode-string out-addr r0.qe-written out-cap 0 8 val-huff val-addr val-len

  -- | Encode `Duplicate` (`000xxxxx`, 5-bit prefix relative index, §4.3.4).
  #[no-alloc]
  qpack-enc-duplicate :: I64 -> U32 -> U32 -> U64 ->{MVar} QpackEncodeResult
  qpack-enc-duplicate out-addr out-pos out-cap rel-idx =
    qpack-encode-int out-addr out-pos out-cap 0 5 rel-idx

  #[no-alloc]
  process-enc-step :: QpackDynamicTable -> I64 -> U32 -> U32 ->{MVar} QpackEncodeResult
  process-enc-step t in-addr pos in-len =
    if ge-u32 pos in-len then QpackEncodeResult pos qpack-ok 0 0
    else
      let hdr = tbl-hdr t in
      let b0 = raw-load-u8 (wrapping-add-i64 in-addr (u32-to-i64 pos)) in
      if ne-u8 (bit-and-u8 b0 128) 0 then
        -- 1 T NameIndex(6+) + Value(8) : Insert With Name Reference
        let is-static = ne-u8 (bit-and-u8 b0 64) 0 in
        let ir = qpack-decode-int in-addr pos in-len 6 in
        if ne-u8 ir.qi-err qpack-ok then QpackEncodeResult pos qpack-err-encoder-stream 0 0
        else
          let scratch = raw-load-i64 (wrapping-add-i64 hdr 72) in
          let scap = raw-load-u32 (wrapping-add-i64 hdr 60) in
          if is-static then
            if ge-u64 ir.qi-val 99 then QpackEncodeResult pos qpack-err-encoder-stream 0 0
            else
              let sidx = wrapping-u64-to-u8 ir.qi-val in
              let nend = qpack-static-write-name-dma sidx scratch 0 scap in
              if gt-u32 nend scap then QpackEncodeResult pos qpack-err-encoder-stream 0 0
              else
                let vr = qpack-decode-string in-addr ir.qi-next in-len 8 scratch nend scap in
                if ne-u8 vr.qs-err qpack-ok then QpackEncodeResult pos qpack-err-encoder-stream 0 0
                else
                  let e = qpack-table-insert t scratch nend (wrapping-add-i64 scratch (u32-to-i64 nend)) vr.qs-out-len in
                  if ne-u8 e qpack-ok then QpackEncodeResult pos e 0 0
                  else process-enc-step t in-addr vr.qs-next in-len
          else
            let ins = raw-load-u64 (wrapping-add-i64 hdr 24) in
            let dropped = raw-load-u64 (wrapping-add-i64 hdr 32) in
            let live = wrapping-sub-u64 ins dropped in
            if ge-u64 ir.qi-val live then QpackEncodeResult pos qpack-err-encoder-stream 0 0
            else
              let abs-idx = wrapping-sub-u64 (wrapping-sub-u64 ins ir.qi-val) 1 in
              let nr = qpack-table-copy-name-abs t abs-idx scratch 0 scap in
              if ne-u8 nr.qe-err qpack-ok then QpackEncodeResult pos qpack-err-encoder-stream 0 0
              else
                let vr = qpack-decode-string in-addr ir.qi-next in-len 8 scratch nr.qe-written scap in
                if ne-u8 vr.qs-err qpack-ok then QpackEncodeResult pos qpack-err-encoder-stream 0 0
                else
                  let e = qpack-table-insert t scratch nr.qe-written (wrapping-add-i64 scratch (u32-to-i64 nr.qe-written)) vr.qs-out-len in
                  if ne-u8 e qpack-ok then QpackEncodeResult pos e 0 0
                  else process-enc-step t in-addr vr.qs-next in-len
      else if ne-u8 (bit-and-u8 b0 64) 0 then
        -- 0 1 H NameLen(5+) + Name + Value(8) : Insert With Literal Name
        let scratch = raw-load-i64 (wrapping-add-i64 hdr 72) in
        let scap = raw-load-u32 (wrapping-add-i64 hdr 60) in
        let nr = qpack-decode-string in-addr pos in-len 6 scratch 0 scap in
        if ne-u8 nr.qs-err qpack-ok then QpackEncodeResult pos qpack-err-encoder-stream 0 0
        else
          let vr = qpack-decode-string in-addr nr.qs-next in-len 8 scratch nr.qs-out-len scap in
          if ne-u8 vr.qs-err qpack-ok then QpackEncodeResult pos qpack-err-encoder-stream 0 0
          else
            let e = qpack-table-insert t scratch nr.qs-out-len (wrapping-add-i64 scratch (u32-to-i64 nr.qs-out-len)) vr.qs-out-len in
            if ne-u8 e qpack-ok then QpackEncodeResult pos e 0 0
            else process-enc-step t in-addr vr.qs-next in-len
      else if ne-u8 (bit-and-u8 b0 32) 0 then
        -- 0 0 1 Capacity(5+) : Set Dynamic Table Capacity
        let cr = qpack-decode-int in-addr pos in-len 5 in
        if ne-u8 cr.qi-err qpack-ok then QpackEncodeResult pos qpack-err-encoder-stream 0 0
        else
          let e = qpack-table-set-capacity t cr.qi-val in
          if ne-u8 e qpack-ok then QpackEncodeResult pos e 0 0
          else process-enc-step t in-addr cr.qi-next in-len
      else
        -- 0 0 0 Index(5+) : Duplicate
        let dr = qpack-decode-int in-addr pos in-len 5 in
        if ne-u8 dr.qi-err qpack-ok then QpackEncodeResult pos qpack-err-encoder-stream 0 0
        else
          let e = qpack-table-duplicate t dr.qi-val in
          if ne-u8 e qpack-ok then QpackEncodeResult pos e 0 0
          else process-enc-step t in-addr dr.qi-next in-len

  -- | Process all QPACK encoder stream instructions in `[in-addr + in-pos, in-addr + in-len)`.
  -- Rejects any encoder stream data when `max-cap == 0` (RFC 9204 §3.2.3).
  #[no-alloc]
  qpack-process-encoder-stream :: QpackDynamicTable -> I64 -> U32 -> U32 ->{MVar} QpackEncodeResult
  qpack-process-encoder-stream t in-addr in-pos in-len =
    if ge-u32 in-pos in-len then QpackEncodeResult in-pos qpack-ok 0 0
    else if eq-u64 (qpack-table-max-cap t) 0 then
      QpackEncodeResult in-pos qpack-err-encoder-stream 0 0
    else process-enc-step t in-addr in-pos in-len

  -- =========================================================================
  -- 8. RFC 9204 §4.4 Decoder Stream Instructions
  -- =========================================================================

  -- | Encode `Section Acknowledgment` (`1xxxxxxx`, 7-bit prefix stream ID, §4.4.1).
  #[no-alloc]
  qpack-dec-section-ack :: I64 -> U32 -> U32 -> U64 ->{MVar} QpackEncodeResult
  qpack-dec-section-ack out-addr out-pos out-cap stream-id =
    qpack-encode-int out-addr out-pos out-cap 128 7 stream-id

  -- | Encode `Stream Cancellation` (`01xxxxxx`, 6-bit prefix stream ID, §4.4.2).
  #[no-alloc]
  qpack-dec-stream-cancel :: I64 -> U32 -> U32 -> U64 ->{MVar} QpackEncodeResult
  qpack-dec-stream-cancel out-addr out-pos out-cap stream-id =
    qpack-encode-int out-addr out-pos out-cap 64 6 stream-id

  -- | Encode `Insert Count Increment` (`00xxxxxx`, 6-bit prefix increment, §4.4.3).
  -- Rejects `increment == 0` with `qpack-err-decoder-stream`.
  #[no-alloc]
  qpack-dec-insert-count-inc :: I64 -> U32 -> U32 -> U64 ->{MVar} QpackEncodeResult
  qpack-dec-insert-count-inc out-addr out-pos out-cap inc =
    if eq-u64 inc 0 then QpackEncodeResult out-pos qpack-err-decoder-stream 0 0
    else qpack-encode-int out-addr out-pos out-cap 0 6 inc

  -- | Decode one QPACK decoder stream instruction (§4.4).
  #[no-alloc]
  qpack-decode-decoder-inst :: I64 -> U32 -> U32 ->{MVar} QpackDecoderInst
  qpack-decode-decoder-inst in-addr in-pos in-len =
    if ge-u32 in-pos in-len then
      QpackDecoderInst qpack-dinst-none qpack-err-truncated 0 in-pos 0
    else
      let b0 = raw-load-u8 (wrapping-add-i64 in-addr (u32-to-i64 in-pos)) in
      if ne-u8 (bit-and-u8 b0 128) 0 then
        let r = qpack-decode-int in-addr in-pos in-len 7 in
        if ne-u8 r.qi-err qpack-ok then QpackDecoderInst qpack-dinst-none r.qi-err 0 r.qi-next 0
        else QpackDecoderInst qpack-dinst-section-ack qpack-ok 0 r.qi-next r.qi-val
      else if ne-u8 (bit-and-u8 b0 64) 0 then
        let r = qpack-decode-int in-addr in-pos in-len 6 in
        if ne-u8 r.qi-err qpack-ok then QpackDecoderInst qpack-dinst-none r.qi-err 0 r.qi-next 0
        else QpackDecoderInst qpack-dinst-stream-cancel qpack-ok 0 r.qi-next r.qi-val
      else
        let r = qpack-decode-int in-addr in-pos in-len 6 in
        if ne-u8 r.qi-err qpack-ok then QpackDecoderInst qpack-dinst-none r.qi-err 0 r.qi-next 0
        else if eq-u64 r.qi-val 0 then
          QpackDecoderInst qpack-dinst-none qpack-err-decoder-stream 0 r.qi-next 0
        else QpackDecoderInst qpack-dinst-insert-inc qpack-ok 0 r.qi-next r.qi-val

  -- | Apply a decoded `QpackDecoderInst` to `table` (`Insert Count Increment` updates
  -- `known-received`; `Stream Cancellation` is a valid no-op on table state; `Section Ack`
  -- validates cleanly and callers invoke `qpack-table-ack-ric` with the stream's RIC).
  #[no-alloc]
  qpack-apply-decoder-inst :: QpackDynamicTable -> QpackDecoderInst ->{MVar} U8
  qpack-apply-decoder-inst t inst =
    if ne-u8 inst.qdi-err qpack-ok then inst.qdi-err
    else if eq-u8 inst.qdi-kind qpack-dinst-insert-inc then
      qpack-table-inc-known-received t inst.qdi-val
    else if either (eq-u8 inst.qdi-kind qpack-dinst-section-ack) (eq-u8 inst.qdi-kind qpack-dinst-stream-cancel) then
      qpack-ok
    else qpack-err-decoder-stream

  -- =========================================================================
  -- 9. RFC 9204 §4.5 Field Line Encoders & Zero-HOL / Dynamic Section Codecs
  -- =========================================================================

  -- | Encode `Indexed Field Line` referencing static table (`11xxxxxx`, §4.5.2).
  #[no-alloc]
  qpack-encode-indexed-static :: I64 -> U32 -> U32 -> U8 ->{MVar} QpackEncodeResult
  qpack-encode-indexed-static out-addr out-pos out-cap static-idx =
    if ge-u8 static-idx qpack-static-count then
      QpackEncodeResult out-pos qpack-err-invalid-static-index 0 0
    else qpack-encode-int out-addr out-pos out-cap 192 6 (u8-to-u64 static-idx)

  -- | Encode `Indexed Field Line` referencing dynamic table (`10xxxxxx`, §4.5.2).
  #[no-alloc]
  qpack-encode-indexed-dynamic :: I64 -> U32 -> U32 -> U64 ->{MVar} QpackEncodeResult
  qpack-encode-indexed-dynamic out-addr out-pos out-cap rel-idx =
    qpack-encode-int out-addr out-pos out-cap 128 6 rel-idx

  -- | Encode `Indexed Field Line with Post-Base Index` (`0001xxxx`, §4.5.3).
  #[no-alloc]
  qpack-encode-indexed-post-base :: I64 -> U32 -> U32 -> U64 ->{MVar} QpackEncodeResult
  qpack-encode-indexed-post-base out-addr out-pos out-cap pb-idx =
    qpack-encode-int out-addr out-pos out-cap 16 4 pb-idx

  -- | Encode `Literal Field Line With Name Reference` (static `T=1`, `01N1xxxx`, §4.5.4).
  #[no-alloc]
  qpack-encode-literal-name-ref-static :: I64 -> U32 -> U32 -> U8 -> U8 -> U8 -> I64 -> U32 ->{MVar} QpackEncodeResult
  qpack-encode-literal-name-ref-static out-addr out-pos out-cap never-idx static-idx huff-mode val-addr val-len =
    if ge-u8 static-idx qpack-static-count then
      QpackEncodeResult out-pos qpack-err-invalid-static-index 0 0
    else
      let mask = if ne-u8 never-idx 0 then 112 else 80 in -- 0111_0000 (0x70) vs 0101_0000 (0x50)
      let r0 = qpack-encode-int out-addr out-pos out-cap mask 4 (u8-to-u64 static-idx) in
      if ne-u8 r0.qe-err qpack-ok then r0
      else qpack-encode-string out-addr r0.qe-written out-cap 0 8 huff-mode val-addr val-len

  -- | Encode `Literal Field Line With Name Reference` (dynamic `T=0`, `01N0xxxx`, §4.5.4).
  #[no-alloc]
  qpack-encode-literal-name-ref-dynamic :: I64 -> U32 -> U32 -> U8 -> U64 -> U8 -> I64 -> U32 ->{MVar} QpackEncodeResult
  qpack-encode-literal-name-ref-dynamic out-addr out-pos out-cap never-idx rel-idx huff-mode val-addr val-len =
    let mask = if ne-u8 never-idx 0 then 96 else 64 in -- 0110_0000 (0x60) vs 0100_0000 (0x40)
    let r0 = qpack-encode-int out-addr out-pos out-cap mask 4 rel-idx in
    if ne-u8 r0.qe-err qpack-ok then r0
    else qpack-encode-string out-addr r0.qe-written out-cap 0 8 huff-mode val-addr val-len

  -- | Encode `Literal Field Line With Post-Base Name Reference` (`0000Nxxx`, §4.5.5).
  #[no-alloc]
  qpack-encode-literal-post-base-ref :: I64 -> U32 -> U32 -> U8 -> U64 -> U8 -> I64 -> U32 ->{MVar} QpackEncodeResult
  qpack-encode-literal-post-base-ref out-addr out-pos out-cap never-idx pb-idx huff-mode val-addr val-len =
    let mask = if ne-u8 never-idx 0 then 8 else 0 in -- 0000_1000 (0x08) vs 0000_0000 (0x00)
    let r0 = qpack-encode-int out-addr out-pos out-cap mask 3 pb-idx in
    if ne-u8 r0.qe-err qpack-ok then r0
    else qpack-encode-string out-addr r0.qe-written out-cap 0 8 huff-mode val-addr val-len

  -- | Encode `Literal Field Line With Literal Name` (`001NHxxx`, §4.5.6).
  #[no-alloc]
  qpack-encode-literal-name :: I64 -> U32 -> U32 -> U8 -> U8 -> I64 -> U32 -> U8 -> I64 -> U32 ->{MVar} QpackEncodeResult
  qpack-encode-literal-name out-addr out-pos out-cap never-idx name-huff name-addr name-len val-huff val-addr val-len =
    let mask = if ne-u8 never-idx 0 then 48 else 32 in -- 0011_0000 (0x30) vs 0010_0000 (0x20)
    let r0 = qpack-encode-string out-addr out-pos out-cap mask 4 name-huff name-addr name-len in
    if ne-u8 r0.qe-err qpack-ok then r0
    else qpack-encode-string out-addr r0.qe-written out-cap 0 8 val-huff val-addr val-len

  -- Zero-HOL fast-path encoding loop over an array of `HeaderPair`s.
  #[no-alloc]
  encode-zero-hol-loop :: I64 -> U32 -> U32 -> I64 -> U8 -> I64 -> U32 -> U32 ->{MVar} QpackEncodeResult
  encode-zero-hol-loop pairs-addr i count src-base huff-mode out-addr pos out-cap =
    if ge-u32 i count then QpackEncodeResult pos qpack-ok 0 0
    else
      let hp = qpack-pair-load pairs-addr i in
      let naddr = wrapping-add-i64 src-base (u32-to-i64 hp.hp-name-off) in
      let vaddr = wrapping-add-i64 src-base (u32-to-i64 hp.hp-val-off) in
      let name-idx = (
        if ne-u8 hp.hp-known hdr-unknown then qpack-static-from-known hp.hp-known
        else qpack-static-match-name-dma naddr hp.hp-name-len) in
      let sensitive = (
        if ne-u8 hp.hp-pad0 0 then b-true
        else if ne-u8 name-idx qpack-static-none then qpack-static-is-sensitive name-idx
        else qpack-static-is-sensitive-dma hp.hp-known naddr hp.hp-name-len) in
      let never-idx = if sensitive then 1 else 0 in
      let exact-idx = (
        if either sensitive (eq-u8 name-idx qpack-static-none) then qpack-static-none
        else qpack-static-match-exact-by-name-dma name-idx vaddr hp.hp-val-len) in
      let r = (
        if ne-u8 exact-idx qpack-static-none then
          qpack-encode-indexed-static out-addr pos out-cap exact-idx
        else if ne-u8 name-idx qpack-static-none then
          qpack-encode-literal-name-ref-static out-addr pos out-cap never-idx name-idx huff-mode vaddr hp.hp-val-len
        else
          qpack-encode-literal-name out-addr pos out-cap never-idx huff-mode naddr hp.hp-name-len huff-mode vaddr hp.hp-val-len) in
      if ne-u8 r.qe-err qpack-ok then r
      else encode-zero-hol-loop pairs-addr (wrapping-add-u32 i 1) count src-base huff-mode out-addr r.qe-written out-cap

  -- | Zero-HOL Fast Path (`max_table_cap == 0`): encodes `0x00 0x00` prefix followed
  -- by static indexed / static name-ref / literal field lines with automatic `N=1`
  -- never-indexed protection on `Authorization`, `Cookie`, `Set-Cookie`, and
  -- `Proxy-Authorization` (or any pair with `hp-pad0 != 0`). 100% `#[no-alloc]`.
  #[no-alloc]
  qpack-encode-section-zero-hol :: I64 -> U32 -> I64 -> U8 -> I64 -> U32 ->{MVar} QpackEncodeResult
  qpack-encode-section-zero-hol pairs-addr header-count src-base huff-mode out-addr out-cap =
    if lt-u32 out-cap 2 then QpackEncodeResult 0 qpack-err-buf-too-small 0 0
    else
      let _ = raw-store-u8 out-addr 0 in
      let _ = raw-store-u8 (wrapping-add-i64 out-addr 1) 0 in
      encode-zero-hol-loop pairs-addr 0 header-count src-base huff-mode out-addr 2 out-cap

  -- Helper: resolve dynamic relative index against `(ric, base, table)`.
  -- Returns `QpackIntResult { qi-val = abs-idx, qi-err = ok/err }`.
  #[no-alloc]
  resolve-dyn-rel :: QpackDynamicTable -> U64 -> U64 -> U64 ->{MVar} QpackIntResult
  resolve-dyn-rel t ric base rel =
    if eq-u64 ric 0 then QpackIntResult 0 0 qpack-err-decompression-failed 0 0
    else if ge-u64 rel base then QpackIntResult 0 0 qpack-err-invalid-dynamic-index 0 0
    else
      let abs-idx = wrapping-sub-u64 (wrapping-sub-u64 base rel) 1 in
      let dropped = qpack-table-dropped-count t in
      let ins = qpack-table-insert-count t in
      if ge-u64 abs-idx ric then QpackIntResult 0 0 qpack-err-decompression-failed 0 0
      else if either (lt-u64 abs-idx dropped) (ge-u64 abs-idx ins) then
        QpackIntResult 0 0 qpack-err-invalid-dynamic-index 0 0
      else QpackIntResult abs-idx 0 qpack-ok 0 0

  -- Helper: resolve dynamic post-base index against `(ric, base, table)`.
  #[no-alloc]
  resolve-dyn-post-base :: QpackDynamicTable -> U64 -> U64 -> U64 ->{MVar} QpackIntResult
  resolve-dyn-post-base t ric base pb =
    if eq-u64 ric 0 then QpackIntResult 0 0 qpack-err-decompression-failed 0 0
    else if gt-u64 pb (wrapping-sub-u64 qpack-max-int62 base) then
      QpackIntResult 0 0 qpack-err-invalid-dynamic-index 0 0
    else
      let abs-idx = wrapping-add-u64 base pb in
      let dropped = qpack-table-dropped-count t in
      let ins = qpack-table-insert-count t in
      if ge-u64 abs-idx ric then QpackIntResult 0 0 qpack-err-decompression-failed 0 0
      else if either (lt-u64 abs-idx dropped) (ge-u64 abs-idx ins) then
        QpackIntResult 0 0 qpack-err-invalid-dynamic-index 0 0
      else QpackIntResult abs-idx 0 qpack-ok 0 0

  -- Shared Zero-HOL field-line decode loop (strictly rejects any dynamic or post-base ref).
  #[no-alloc]
  decode-zero-hol-loop :: I64 -> U32 -> U32 -> I64 -> U32 -> U32 -> I64 -> U32 -> U32 ->{MVar} QpackDecodeResult
  decode-zero-hol-loop in-addr pos in-len txt-addr txt-pos txt-cap pairs-addr hcnt pairs-cap =
    if ge-u32 pos in-len then
      QpackDecodeResult hcnt txt-pos 0 0 qpack-ok 0 0 0
    else if ge-u32 hcnt pairs-cap then
      QpackDecodeResult hcnt txt-pos 0 0 qpack-err-too-many-headers 0 0 0
    else
      let b0 = raw-load-u8 (wrapping-add-i64 in-addr (u32-to-i64 pos)) in
      if ne-u8 (bit-and-u8 b0 128) 0 then
        -- 1 T Index(6+) : Indexed Field Line
        if eq-u8 (bit-and-u8 b0 64) 0 then
          QpackDecodeResult hcnt txt-pos 0 0 qpack-err-decompression-failed 0 0 0
        else
          let ir = qpack-decode-int in-addr pos in-len 6 in
          if ne-u8 ir.qi-err qpack-ok then QpackDecodeResult hcnt txt-pos 0 0 ir.qi-err 0 0 0
          else if ge-u64 ir.qi-val 99 then
            QpackDecodeResult hcnt txt-pos 0 0 qpack-err-invalid-static-index 0 0 0
          else
            let sidx = wrapping-u64-to-u8 ir.qi-val in
            let nend = qpack-static-write-name-dma sidx txt-addr txt-pos txt-cap in
            if gt-u32 nend txt-cap then QpackDecodeResult hcnt txt-pos 0 0 qpack-err-buf-too-small 0 0 0
            else
              let vend = qpack-static-write-value-dma sidx txt-addr nend txt-cap in
              if gt-u32 vend txt-cap then QpackDecodeResult hcnt txt-pos 0 0 qpack-err-buf-too-small 0 0 0
              else
                let kh = qpack-static-known-header sidx in
                let hp = HeaderPair kh 0 0 txt-pos (wrapping-sub-u32 nend txt-pos) nend (wrapping-sub-u32 vend nend) in
                let _ = qpack-pair-store pairs-addr hcnt hp in
                decode-zero-hol-loop in-addr ir.qi-next in-len txt-addr vend txt-cap pairs-addr (wrapping-add-u32 hcnt 1) pairs-cap
      else if ne-u8 (bit-and-u8 b0 64) 0 then
        -- 0 1 N T NameIdx(4+) + Value(8) : Literal With Name Ref
        if eq-u8 (bit-and-u8 b0 16) 0 then
          QpackDecodeResult hcnt txt-pos 0 0 qpack-err-decompression-failed 0 0 0
        else
          let never-bit = if ne-u8 (bit-and-u8 b0 32) 0 then 1 else 0 in
          let ir = qpack-decode-int in-addr pos in-len 4 in
          if ne-u8 ir.qi-err qpack-ok then QpackDecodeResult hcnt txt-pos 0 0 ir.qi-err 0 0 0
          else if ge-u64 ir.qi-val 99 then
            QpackDecodeResult hcnt txt-pos 0 0 qpack-err-invalid-static-index 0 0 0
          else
            let sidx = wrapping-u64-to-u8 ir.qi-val in
            let nend = qpack-static-write-name-dma sidx txt-addr txt-pos txt-cap in
            if gt-u32 nend txt-cap then QpackDecodeResult hcnt txt-pos 0 0 qpack-err-buf-too-small 0 0 0
            else
              let vr = qpack-decode-string in-addr ir.qi-next in-len 8 txt-addr nend txt-cap in
              if ne-u8 vr.qs-err qpack-ok then QpackDecodeResult hcnt txt-pos 0 0 vr.qs-err 0 0 0
              else
                let vend = wrapping-add-u32 nend vr.qs-out-len in
                let kh = qpack-static-known-header sidx in
                let hp = HeaderPair kh never-bit 0 txt-pos (wrapping-sub-u32 nend txt-pos) nend vr.qs-out-len in
                let _ = qpack-pair-store pairs-addr hcnt hp in
                decode-zero-hol-loop in-addr vr.qs-next in-len txt-addr vend txt-cap pairs-addr (wrapping-add-u32 hcnt 1) pairs-cap
      else if ne-u8 (bit-and-u8 b0 32) 0 then
        -- 0 0 1 N H NameLen(3+) + Name + Value(8) : Literal With Literal Name
        let never-bit = if ne-u8 (bit-and-u8 b0 16) 0 then 1 else 0 in
        let nr = qpack-decode-string in-addr pos in-len 4 txt-addr txt-pos txt-cap in
        if ne-u8 nr.qs-err qpack-ok then QpackDecodeResult hcnt txt-pos 0 0 nr.qs-err 0 0 0
        else
          let nend = wrapping-add-u32 txt-pos nr.qs-out-len in
          let vr = qpack-decode-string in-addr nr.qs-next in-len 8 txt-addr nend txt-cap in
          if ne-u8 vr.qs-err qpack-ok then QpackDecodeResult hcnt txt-pos 0 0 vr.qs-err 0 0 0
          else
            let vend = wrapping-add-u32 nend vr.qs-out-len in
            let kh = known-header-match-dma (wrapping-add-i64 txt-addr (u32-to-i64 txt-pos)) nr.qs-out-len in
            let hp = HeaderPair kh never-bit 0 txt-pos nr.qs-out-len nend vr.qs-out-len in
            let _ = qpack-pair-store pairs-addr hcnt hp in
            decode-zero-hol-loop in-addr vr.qs-next in-len txt-addr vend txt-cap pairs-addr (wrapping-add-u32 hcnt 1) pairs-cap
      else
        -- 0001xxxx (Post-Base Indexed) or 0000Nxxx (Post-Base Name Ref) forbidden when max_table_cap == 0!
        QpackDecodeResult hcnt txt-pos 0 0 qpack-err-decompression-failed 0 0 0

  -- | Zero-HOL Fast Path Decoder (`max_table_cap == 0`, no dynamic table needed).
  -- Strictly rejects any non-zero Required Insert Count and any dynamic/post-base reference.
  #[no-alloc]
  qpack-decode-section-zero-hol :: I64 -> U32 -> I64 -> U32 -> I64 -> U32 ->{MVar} QpackDecodeResult
  qpack-decode-section-zero-hol in-addr in-len txt-addr txt-cap pairs-addr pairs-cap =
    let pr = qpack-decode-prefix in-addr 0 in-len 0 0 in
    if ne-u8 pr.qp-err qpack-ok then
      QpackDecodeResult 0 0 0 0 pr.qp-err 0 0 0
    else if ne-u64 pr.qp-req-insert-count 0 then
      QpackDecodeResult 0 0 pr.qp-req-insert-count pr.qp-base qpack-err-decompression-failed 0 0 0
    else
      decode-zero-hol-loop in-addr pr.qp-next in-len txt-addr 0 txt-cap pairs-addr 0 pairs-cap

  -- Full field-section decode loop (static + dynamic relative + dynamic post-base).
  #[no-alloc]
  decode-section-loop :: QpackDynamicTable -> U64 -> U64 -> I64 -> U32 -> U32 -> I64 -> U32 -> U32 -> I64 -> U32 -> U32 ->{MVar} QpackDecodeResult
  decode-section-loop t ric base in-addr pos in-len txt-addr txt-pos txt-cap pairs-addr hcnt pairs-cap =
    if ge-u32 pos in-len then
      QpackDecodeResult hcnt txt-pos ric base qpack-ok 0 0 0
    else if ge-u32 hcnt pairs-cap then
      QpackDecodeResult hcnt txt-pos ric base qpack-err-too-many-headers 0 0 0
    else
      let b0 = raw-load-u8 (wrapping-add-i64 in-addr (u32-to-i64 pos)) in
      if ne-u8 (bit-and-u8 b0 128) 0 then
        -- 1 T Index(6+) : Indexed Field Line (static or dynamic relative)
        let is-static = ne-u8 (bit-and-u8 b0 64) 0 in
        let ir = qpack-decode-int in-addr pos in-len 6 in
        if ne-u8 ir.qi-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base ir.qi-err 0 0 0
        else if is-static then
          if ge-u64 ir.qi-val 99 then QpackDecodeResult hcnt txt-pos ric base qpack-err-invalid-static-index 0 0 0
          else
            let sidx = wrapping-u64-to-u8 ir.qi-val in
            let nend = qpack-static-write-name-dma sidx txt-addr txt-pos txt-cap in
            if gt-u32 nend txt-cap then QpackDecodeResult hcnt txt-pos ric base qpack-err-buf-too-small 0 0 0
            else
              let vend = qpack-static-write-value-dma sidx txt-addr nend txt-cap in
              if gt-u32 vend txt-cap then QpackDecodeResult hcnt txt-pos ric base qpack-err-buf-too-small 0 0 0
              else
                let kh = qpack-static-known-header sidx in
                let hp = HeaderPair kh 0 0 txt-pos (wrapping-sub-u32 nend txt-pos) nend (wrapping-sub-u32 vend nend) in
                let _ = qpack-pair-store pairs-addr hcnt hp in
                decode-section-loop t ric base in-addr ir.qi-next in-len txt-addr vend txt-cap pairs-addr (wrapping-add-u32 hcnt 1) pairs-cap
        else
          let ar = resolve-dyn-rel t ric base ir.qi-val in
          if ne-u8 ar.qi-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base ar.qi-err 0 0 0
          else
            let nr = qpack-table-copy-name-abs t ar.qi-val txt-addr txt-pos txt-cap in
            if ne-u8 nr.qe-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base nr.qe-err 0 0 0
            else
              let vr = qpack-table-copy-val-abs t ar.qi-val txt-addr nr.qe-written txt-cap in
              if ne-u8 vr.qe-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base vr.qe-err 0 0 0
              else
                let nlen = wrapping-sub-u32 nr.qe-written txt-pos in
                let vlen = wrapping-sub-u32 vr.qe-written nr.qe-written in
                let kh = known-header-match-dma (wrapping-add-i64 txt-addr (u32-to-i64 txt-pos)) nlen in
                let hp = HeaderPair kh 0 0 txt-pos nlen nr.qe-written vlen in
                let _ = qpack-pair-store pairs-addr hcnt hp in
                decode-section-loop t ric base in-addr ir.qi-next in-len txt-addr vr.qe-written txt-cap pairs-addr (wrapping-add-u32 hcnt 1) pairs-cap
      else if ne-u8 (bit-and-u8 b0 64) 0 then
        -- 0 1 N T NameIdx(4+) + Value(8) : Literal With Name Ref
        let never-bit = if ne-u8 (bit-and-u8 b0 32) 0 then 1 else 0 in
        let is-static = ne-u8 (bit-and-u8 b0 16) 0 in
        let ir = qpack-decode-int in-addr pos in-len 4 in
        if ne-u8 ir.qi-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base ir.qi-err 0 0 0
        else if is-static then
          if ge-u64 ir.qi-val 99 then QpackDecodeResult hcnt txt-pos ric base qpack-err-invalid-static-index 0 0 0
          else
            let sidx = wrapping-u64-to-u8 ir.qi-val in
            let nend = qpack-static-write-name-dma sidx txt-addr txt-pos txt-cap in
            if gt-u32 nend txt-cap then QpackDecodeResult hcnt txt-pos ric base qpack-err-buf-too-small 0 0 0
            else
              let vr = qpack-decode-string in-addr ir.qi-next in-len 8 txt-addr nend txt-cap in
              if ne-u8 vr.qs-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base vr.qs-err 0 0 0
              else
                let vend = wrapping-add-u32 nend vr.qs-out-len in
                let kh = qpack-static-known-header sidx in
                let hp = HeaderPair kh never-bit 0 txt-pos (wrapping-sub-u32 nend txt-pos) nend vr.qs-out-len in
                let _ = qpack-pair-store pairs-addr hcnt hp in
                decode-section-loop t ric base in-addr vr.qs-next in-len txt-addr vend txt-cap pairs-addr (wrapping-add-u32 hcnt 1) pairs-cap
        else
          let ar = resolve-dyn-rel t ric base ir.qi-val in
          if ne-u8 ar.qi-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base ar.qi-err 0 0 0
          else
            let nr = qpack-table-copy-name-abs t ar.qi-val txt-addr txt-pos txt-cap in
            if ne-u8 nr.qe-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base nr.qe-err 0 0 0
            else
              let vr = qpack-decode-string in-addr ir.qi-next in-len 8 txt-addr nr.qe-written txt-cap in
              if ne-u8 vr.qs-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base vr.qs-err 0 0 0
              else
                let nlen = wrapping-sub-u32 nr.qe-written txt-pos in
                let vend = wrapping-add-u32 nr.qe-written vr.qs-out-len in
                let kh = known-header-match-dma (wrapping-add-i64 txt-addr (u32-to-i64 txt-pos)) nlen in
                let hp = HeaderPair kh never-bit 0 txt-pos nlen nr.qe-written vr.qs-out-len in
                let _ = qpack-pair-store pairs-addr hcnt hp in
                decode-section-loop t ric base in-addr vr.qs-next in-len txt-addr vend txt-cap pairs-addr (wrapping-add-u32 hcnt 1) pairs-cap
      else if ne-u8 (bit-and-u8 b0 32) 0 then
        -- 0 0 1 N H NameLen(3+) + Name + Value(8) : Literal With Literal Name
        let never-bit = if ne-u8 (bit-and-u8 b0 16) 0 then 1 else 0 in
        let nr = qpack-decode-string in-addr pos in-len 4 txt-addr txt-pos txt-cap in
        if ne-u8 nr.qs-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base nr.qs-err 0 0 0
        else
          let nend = wrapping-add-u32 txt-pos nr.qs-out-len in
          let vr = qpack-decode-string in-addr nr.qs-next in-len 8 txt-addr nend txt-cap in
          if ne-u8 vr.qs-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base vr.qs-err 0 0 0
          else
            let vend = wrapping-add-u32 nend vr.qs-out-len in
            let kh = known-header-match-dma (wrapping-add-i64 txt-addr (u32-to-i64 txt-pos)) nr.qs-out-len in
            let hp = HeaderPair kh never-bit 0 txt-pos nr.qs-out-len nend vr.qs-out-len in
            let _ = qpack-pair-store pairs-addr hcnt hp in
            decode-section-loop t ric base in-addr vr.qs-next in-len txt-addr vend txt-cap pairs-addr (wrapping-add-u32 hcnt 1) pairs-cap
      else if ne-u8 (bit-and-u8 b0 16) 0 then
        -- 0 0 0 1 Index(4+) : Indexed Field Line With Post-Base Index
        let ir = qpack-decode-int in-addr pos in-len 4 in
        if ne-u8 ir.qi-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base ir.qi-err 0 0 0
        else
          let ar = resolve-dyn-post-base t ric base ir.qi-val in
          if ne-u8 ar.qi-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base ar.qi-err 0 0 0
          else
            let nr = qpack-table-copy-name-abs t ar.qi-val txt-addr txt-pos txt-cap in
            if ne-u8 nr.qe-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base nr.qe-err 0 0 0
            else
              let vr = qpack-table-copy-val-abs t ar.qi-val txt-addr nr.qe-written txt-cap in
              if ne-u8 vr.qe-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base vr.qe-err 0 0 0
              else
                let nlen = wrapping-sub-u32 nr.qe-written txt-pos in
                let vlen = wrapping-sub-u32 vr.qe-written nr.qe-written in
                let kh = known-header-match-dma (wrapping-add-i64 txt-addr (u32-to-i64 txt-pos)) nlen in
                let hp = HeaderPair kh 0 0 txt-pos nlen nr.qe-written vlen in
                let _ = qpack-pair-store pairs-addr hcnt hp in
                decode-section-loop t ric base in-addr ir.qi-next in-len txt-addr vr.qe-written txt-cap pairs-addr (wrapping-add-u32 hcnt 1) pairs-cap
      else
        -- 0 0 0 0 N NameIdx(3+) + Value(8) : Literal With Post-Base Name Ref
        let never-bit = if ne-u8 (bit-and-u8 b0 8) 0 then 1 else 0 in
        let ir = qpack-decode-int in-addr pos in-len 3 in
        if ne-u8 ir.qi-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base ir.qi-err 0 0 0
        else
          let ar = resolve-dyn-post-base t ric base ir.qi-val in
          if ne-u8 ar.qi-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base ar.qi-err 0 0 0
          else
            let nr = qpack-table-copy-name-abs t ar.qi-val txt-addr txt-pos txt-cap in
            if ne-u8 nr.qe-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base nr.qe-err 0 0 0
            else
              let vr = qpack-decode-string in-addr ir.qi-next in-len 8 txt-addr nr.qe-written txt-cap in
              if ne-u8 vr.qs-err qpack-ok then QpackDecodeResult hcnt txt-pos ric base vr.qs-err 0 0 0
              else
                let nlen = wrapping-sub-u32 nr.qe-written txt-pos in
                let vend = wrapping-add-u32 nr.qe-written vr.qs-out-len in
                let kh = known-header-match-dma (wrapping-add-i64 txt-addr (u32-to-i64 txt-pos)) nlen in
                let hp = HeaderPair kh never-bit 0 txt-pos nlen nr.qe-written vr.qs-out-len in
                let _ = qpack-pair-store pairs-addr hcnt hp in
                decode-section-loop t ric base in-addr vr.qs-next in-len txt-addr vend txt-cap pairs-addr (wrapping-add-u32 hcnt 1) pairs-cap

  -- | Decode a complete RFC 9204 encoded field section against `table` (supporting both
  -- `max_table_cap == 0` Zero-HOL and bounded dynamic table with relative & post-base indexing).
  -- Returns `qpack-err-blocked` if `Required Insert Count > table.insert-count`.
  #[no-alloc]
  qpack-decode-section :: QpackDynamicTable -> I64 -> U32 -> I64 -> U32 -> I64 -> U32 ->{MVar} QpackDecodeResult
  qpack-decode-section t in-addr in-len txt-addr txt-cap pairs-addr pairs-cap =
    let max-cap = qpack-table-max-cap t in
    let ins = qpack-table-insert-count t in
    let pr = qpack-decode-prefix in-addr 0 in-len max-cap ins in
    if ne-u8 pr.qp-err qpack-ok then
      QpackDecodeResult 0 0 0 0 pr.qp-err 0 0 0
    else if both (ne-u64 pr.qp-req-insert-count 0) (eq-u64 max-cap 0) then
      QpackDecodeResult 0 0 pr.qp-req-insert-count pr.qp-base qpack-err-decompression-failed 0 0 0
    else if gt-u64 pr.qp-req-insert-count ins then
      QpackDecodeResult 0 0 pr.qp-req-insert-count pr.qp-base qpack-err-blocked 0 0 0
    else
      decode-section-loop t pr.qp-req-insert-count pr.qp-base in-addr pr.qp-next in-len txt-addr 0 txt-cap pairs-addr 0 pairs-cap
