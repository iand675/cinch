  qpack-err-decoder-stream = 12

  #[inline(always)]
  #[no-alloc]
  qpack-err-too-many-headers :: U8
  qpack-err-too-many-headers = 13

  #[inline(always)]
  #[no-alloc]
  qpack-err-invalid-prefix :: U8
  qpack-err-invalid-prefix = 14

  #[inline(always)]
  #[no-alloc]
  qpack-dinst-none :: U8
  qpack-dinst-none = 0

  #[inline(always)]
  #[no-alloc]
  qpack-dinst-section-ack :: U8
  qpack-dinst-section-ack = 1

  #[inline(always)]
  #[no-alloc]
  qpack-dinst-stream-cancel :: U8
  qpack-dinst-stream-cancel = 2

  #[inline(always)]
  #[no-alloc]
  qpack-dinst-insert-inc :: U8
  qpack-dinst-insert-inc = 3

  #[inline(always)]
  #[no-alloc]
  qpack-huff-never :: U8
  qpack-huff-never = 0

  #[inline(always)]
  #[no-alloc]
  qpack-huff-auto :: U8
  qpack-huff-auto = 1

  #[inline(always)]
  #[no-alloc]
