  qpack-huff-force = 2

  -- RFC 9204 §4.1.1 maximum 62-bit unsigned integer: (1 << 62) - 1
  #[inline(always)]
  #[no-alloc]
  qpack-max-int62 :: U64
  qpack-max-int62 = 4611686018427387903

  #[inline(always)]
  #[no-alloc]
  b-true :: Bool
  b-true = eq-u32 0 0

  #[inline(always)]
  #[no-alloc]
  b-false :: Bool
  b-false = eq-u32 0 1

  #[inline(always)]
  #[no-alloc]
  both :: Bool -> Bool -> Bool
  both a b = if a then b else b-false

  #[inline(always)]
  #[no-alloc]
  either :: Bool -> Bool -> Bool
  either a b = if a then b-true else b

  #[inline(always)]
  #[no-alloc]
  dma-copy :: I64 -> I64 -> U32 ->{MVar} Unit
  dma-copy dst src rem =
    if ge-u32 rem 16 then
      let v = raw-load-u128 src in
      let _ = raw-store-u128 dst v in
      dma-copy (wrapping-add-i64 dst 16) (wrapping-add-i64 src 16) (wrapping-sub-u32 rem 16)
    else if ge-u32 rem 8 then
      let v = raw-load-u64 src in
      let _ = raw-store-u64 dst v in
      dma-copy (wrapping-add-i64 dst 8) (wrapping-add-i64 src 8) (wrapping-sub-u32 rem 8)
    else if gt-u32 rem 0 then
      let v = raw-load-u8 src in
      let _ = raw-store-u8 dst v in
      dma-copy (wrapping-add-i64 dst 1) (wrapping-add-i64 src 1) (wrapping-sub-u32 rem 1)
    else ()

  -- =========================================================================
  -- 1. Unboxed #[repr(C, value)] POD Result Types & DMA HeaderPair Accessors
  -- =========================================================================

  #[repr(C, value)]
  record QpackIntResult where
    qi-val :: U64
    qi-next :: U32
    qi-err :: U8
    qi-pad0 :: U8
    qi-pad1 :: U16

  #[repr(C, value)]
  record QpackStrResult where
    qs-out-len :: U32
    qs-next :: U32
    qs-err :: U8
    qs-pad0 :: U8
    qs-pad1 :: U16

  #[repr(C, value)]
  record QpackPrefixResult where
    qp-req-insert-count :: U64
    qp-base :: U64
    qp-next :: U32
    qp-err :: U8
    qp-pad0 :: U8
    qp-pad1 :: U16

  #[repr(C, value)]
  record QpackEncodeResult where
    qe-written :: U32
    qe-err :: U8
    qe-pad0 :: U8
    qe-pad1 :: U16

  #[repr(C, value)]
  record QpackDecodeResult where
    qd-header-count :: U32
    qd-text-written :: U32
    qd-req-insert-count :: U64
    qd-base :: U64
    qd-err :: U8
    qd-pad0 :: U8
    qd-pad1 :: U16
    qd-pad2 :: U32

  #[repr(C, value)]
  record QpackDecoderInst where
    qdi-kind :: U8
    qdi-err :: U8
    qdi-pad0 :: U16
    qdi-next :: U32
    qdi-val :: U64

  -- | Store a 20-byte `HeaderPair` into a contiguous DMA `HeaderPair` array at `idx`.
  #[inline(always)]
  #[no-alloc]
  qpack-pair-store :: I64 -> U32 -> HeaderPair ->{MVar} Unit
  qpack-pair-store base idx hp =
    let off = wrapping-mul-i64 (u32-to-i64 idx) 20 in
    let p = wrapping-add-i64 base off in
    let w0 = bit-or-u32 (bit-or-u32 (u8-to-u32 hp.hp-known) (wrapping-shl-u32 (u8-to-u32 hp.hp-pad0) 8)) (wrapping-shl-u32 (u16-to-u32 hp.hp-pad1) 16) in
    let _ = raw-store-u32 p w0 in
    let _ = raw-store-u32 (wrapping-add-i64 p 4) hp.hp-name-off in
    let _ = raw-store-u32 (wrapping-add-i64 p 8) hp.hp-name-len in
    let _ = raw-store-u32 (wrapping-add-i64 p 12) hp.hp-val-off in
    raw-store-u32 (wrapping-add-i64 p 16) hp.hp-val-len

  -- | Load a 20-byte `HeaderPair` from a contiguous DMA `HeaderPair` array at `idx`.
  #[inline(always)]
  #[no-alloc]
  qpack-pair-load :: I64 -> U32 ->{MVar} HeaderPair
  qpack-pair-load base idx =
    let off = wrapping-mul-i64 (u32-to-i64 idx) 20 in
    let p = wrapping-add-i64 base off in
    let w0 = raw-load-u32 p in
    let known = wrapping-u32-to-u8 w0 in
    let pad0 = wrapping-u32-to-u8 (wrapping-shr-u32 w0 8) in
    let pad1 = wrapping-u32-to-u16 (wrapping-shr-u32 w0 16) in
    let noff = raw-load-u32 (wrapping-add-i64 p 4) in
    let nlen = raw-load-u32 (wrapping-add-i64 p 8) in
    let voff = raw-load-u32 (wrapping-add-i64 p 12) in
    let vlen = raw-load-u32 (wrapping-add-i64 p 16) in
    HeaderPair known pad0 pad1 noff nlen voff vlen

  -- =========================================================================
  -- 2. RFC 9204 §4.1.1 Prefixed Integer Codec (62-bit with overflow guards)
  -- =========================================================================

  #[inline(always)]
  #[no-alloc]
  prefix-max-u8 :: U8 -> U8
  prefix-max-u8 n =
    if eq-u8 n 8 then 255
    else wrapping-sub-u8 (wrapping-shl-u8 1 (u8-to-u32 n)) 1

  #[no-alloc]
  encode-int-cont :: I64 -> U32 -> U32 -> U64 ->{MVar} QpackEncodeResult
  encode-int-cont out-addr pos out-cap rem =
    if ge-u32 pos out-cap then QpackEncodeResult pos qpack-err-buf-too-small 0 0
    else if ge-u64 rem 128 then
      let b = bit-or-u8 (wrapping-u64-to-u8 (bit-and-u64 rem 127)) 128 in
      let _ = raw-store-u8 (wrapping-add-i64 out-addr (u32-to-i64 pos)) b in
      encode-int-cont out-addr (wrapping-add-u32 pos 1) out-cap (wrapping-shr-u64 rem 7)
    else
      let _ = raw-store-u8 (wrapping-add-i64 out-addr (u32-to-i64 pos)) (wrapping-u64-to-u8 rem) in
      QpackEncodeResult (wrapping-add-u32 pos 1) qpack-ok 0 0

  -- | Encode a prefixed integer (`n` in `1..8`) with leading `prefix-mask` into
  -- `[out-addr + out-pos, out-addr + out-cap)`. Returns new offset in `qe-written`.
  #[no-alloc]
  qpack-encode-int :: I64 -> U32 -> U32 -> U8 -> U8 -> U64 ->{MVar} QpackEncodeResult
  qpack-encode-int out-addr out-pos out-cap prefix-mask n val =
    if either (lt-u8 n 1) (gt-u8 n 8) then
      QpackEncodeResult out-pos qpack-err-invalid-prefix 0 0
    else if gt-u64 val qpack-max-int62 then
      QpackEncodeResult out-pos qpack-err-int-overflow 0 0
    else if ge-u32 out-pos out-cap then
      QpackEncodeResult out-pos qpack-err-buf-too-small 0 0
    else
      let pmax = prefix-max-u8 n in
      let pmax64 = u8-to-u64 pmax in
      if lt-u64 val pmax64 then
        let b0 = bit-or-u8 prefix-mask (wrapping-u64-to-u8 val) in
        let _ = raw-store-u8 (wrapping-add-i64 out-addr (u32-to-i64 out-pos)) b0 in
        QpackEncodeResult (wrapping-add-u32 out-pos 1) qpack-ok 0 0
      else
        let b0 = bit-or-u8 prefix-mask pmax in
        let _ = raw-store-u8 (wrapping-add-i64 out-addr (u32-to-i64 out-pos)) b0 in
        encode-int-cont out-addr (wrapping-add-u32 out-pos 1) out-cap (wrapping-sub-u64 val pmax64)

  #[no-alloc]
  decode-int-cont :: I64 -> U32 -> U32 -> U64 -> U32 ->{MVar} QpackIntResult
  decode-int-cont in-addr pos in-len acc shift =
    if ge-u32 pos in-len then QpackIntResult 0 pos qpack-err-truncated 0 0
    else if ge-u32 shift 63 then QpackIntResult 0 pos qpack-err-int-overflow 0 0
    else
      let b = raw-load-u8 (wrapping-add-i64 in-addr (u32-to-i64 pos)) in
      let part = u8-to-u64 (bit-and-u8 b 127) in
      let max-part = wrapping-shr-u64 qpack-max-int62 shift in
      if gt-u64 part max-part then QpackIntResult 0 pos qpack-err-int-overflow 0 0
      else
        let addend = wrapping-shl-u64 part shift in
        if gt-u64 addend (wrapping-sub-u64 qpack-max-int62 acc) then
          QpackIntResult 0 pos qpack-err-int-overflow 0 0
        else
          let next-acc = wrapping-add-u64 acc addend in
          let next-pos = wrapping-add-u32 pos 1 in
          if eq-u8 (bit-and-u8 b 128) 0 then
            QpackIntResult next-acc next-pos qpack-ok 0 0
          else
            decode-int-cont in-addr next-pos in-len next-acc (wrapping-add-u32 shift 7)

  -- | Decode a prefixed integer (`n` in `1..8`) from `[in-addr + in-pos, in-addr + in-len)`.
  -- Enforces RFC 9204 §4.1.1 62-bit limit and rejects overlong varint continuation attacks.
  #[no-alloc]
  qpack-decode-int :: I64 -> U32 -> U32 -> U8 ->{MVar} QpackIntResult
  qpack-decode-int in-addr in-pos in-len n =
    if either (lt-u8 n 1) (gt-u8 n 8) then
      QpackIntResult 0 in-pos qpack-err-invalid-prefix 0 0
    else if ge-u32 in-pos in-len then
      QpackIntResult 0 in-pos qpack-err-truncated 0 0
    else
      let pmax = prefix-max-u8 n in
      let b0 = raw-load-u8 (wrapping-add-i64 in-addr (u32-to-i64 in-pos)) in
      let v0 = bit-and-u8 b0 pmax in
      let next-pos = wrapping-add-u32 in-pos 1 in
      if lt-u8 v0 pmax then
        QpackIntResult (u8-to-u64 v0) next-pos qpack-ok 0 0
      else
        decode-int-cont in-addr next-pos in-len (u8-to-u64 pmax) 0

