-- | Zero-allocation RFC 9204 QPACK codec for HTTP/3:
--   * Prefixed integers (1..8-bit prefixes, 62-bit RFC 9204 §4.1.1 overflow guards)
--   * Self-contained RFC 7541/9204 Huffman encoder + 256-state 4-bit nibble DFA decoder
--     with strict EOS and trailing-padding validation
--   * Field Section Prefix (§4.5.1): Required Insert Count wraparound + Sign/Delta Base
--   * Zero-HOL fast path (`max_table_cap == 0`, `0x00 0x00` prefix, `blocked_streams == 0`,
--     never-indexed `N=1` protection for sensitive headers)
--   * Bounded DMA-backed ring-buffer `QpackDynamicTable` with full RFC 9204 §3.2, §4.3,
--     §4.4, §4.5 encoder/decoder stream instructions and relative + post-base indexing.
module Net.Http.Qpack.Codec where

  import Data.Bool
  import Data.Core
  import Data.Machine
  import Data.Option
  import Engine.Types
  import Net.Http.Types
  import Net.Http.Qpack.StaticTable
  import Prim.Atomic

  -- Error & instruction kind constants
  export qpack-ok, qpack-err-truncated, qpack-err-buf-too-small, qpack-err-int-overflow
  export qpack-err-huffman-invalid, qpack-err-invalid-static-index, qpack-err-invalid-dynamic-index
  export qpack-err-invalid-req-insert-count, qpack-err-invalid-base, qpack-err-blocked
  export qpack-err-decompression-failed, qpack-err-encoder-stream, qpack-err-decoder-stream
  export qpack-err-too-many-headers, qpack-err-invalid-prefix
  export qpack-dinst-none, qpack-dinst-section-ack, qpack-dinst-stream-cancel, qpack-dinst-insert-inc
  export qpack-huff-never, qpack-huff-auto, qpack-huff-force

  -- POD result structs & dynamic table handle
  export QpackIntResult, QpackStrResult, QpackPrefixResult
  export QpackEncodeResult, QpackDecodeResult, QpackDecoderInst
  export QpackDynamicTable

  -- DMA HeaderPair array helpers
  export qpack-pair-store, qpack-pair-load

  -- RFC 9204 §4.1.1 prefixed integers & §4.1.2 Huffman/string literals
  export qpack-encode-int, qpack-decode-int
  export qpack-huffman-encoded-len, qpack-huffman-encode, qpack-huffman-decode
  export qpack-encode-string, qpack-decode-string

  -- RFC 9204 §4.5.1 Field Section Prefix
  export qpack-max-entries, qpack-encode-prefix, qpack-decode-prefix

  -- Bounded DMA-backed dynamic table lifecycle, telemetry & operations
  export qpack-table-new, qpack-table-destroy
  export qpack-table-max-cap, qpack-table-capacity, qpack-table-size
  export qpack-table-insert-count, qpack-table-dropped-count, qpack-table-known-received
  export qpack-table-live-count, qpack-table-blocked-streams
  export qpack-table-set-capacity, qpack-table-insert, qpack-table-duplicate
  export qpack-table-copy-name-abs, qpack-table-copy-val-abs
  export qpack-table-ack-ric, qpack-table-inc-known-received

  -- RFC 9204 §4.3 Encoder stream instructions
  export qpack-enc-set-capacity, qpack-enc-insert-name-ref
  export qpack-enc-insert-literal, qpack-enc-duplicate
  export qpack-process-encoder-stream

  -- RFC 9204 §4.4 Decoder stream instructions
  export qpack-dec-section-ack, qpack-dec-stream-cancel, qpack-dec-insert-count-inc
  export qpack-decode-decoder-inst, qpack-apply-decoder-inst

  -- RFC 9204 §4.5 Field line encoders & Zero-HOL / Dynamic section codecs
  export qpack-encode-indexed-static, qpack-encode-indexed-dynamic, qpack-encode-indexed-post-base
  export qpack-encode-literal-name-ref-static, qpack-encode-literal-name-ref-dynamic
  export qpack-encode-literal-post-base-ref, qpack-encode-literal-name
  export qpack-encode-section-zero-hol, qpack-decode-section-zero-hol, qpack-decode-section

  -- =========================================================================
  -- 0. Error codes, constants & internal #[no-alloc] helpers
  -- =========================================================================

  #[inline(always)]
  #[no-alloc]
  qpack-ok :: U8
  qpack-ok = 0

  #[inline(always)]
  #[no-alloc]
  qpack-err-truncated :: U8
  qpack-err-truncated = 1

  #[inline(always)]
  #[no-alloc]
