  -- | Write the static header value for `idx` (`0..98`) into DMA `[base+pos, base+cap)`.
  -- Returns new `pos`, or `cap + 1` on invalid index or buffer overflow.
  #[no-alloc]
  qpack-static-write-value-dma :: U8 -> I64 -> U32 -> U32 ->{MVar} U32
  qpack-static-write-value-dma idx base pos cap =
    if ge-u8 idx qpack-static-count then wrapping-add-u32 cap 1
    else
      let need = qpack-static-value-len idx in
      if eq-u32 need 0 then pos
      else if gt-u32 need (saturating-sub-u32 cap pos) then wrapping-add-u32 cap 1
      else if lt-u8 idx 50 then write-val-unchecked-lo idx base pos
      else write-val-unchecked-hi idx base pos

  -- =========================================================================
  -- 3. O(1) DMA Name & Exact (Name + Value) Matchers
  -- =========================================================================

  -- Match the 17 QPACK-only static header names not present in `KnownHeader`.
  #[no-alloc]
  match-qpack-only-name-dma :: I64 -> U32 ->{MVar} U8
  match-qpack-only-name-dma addr len = case len of
    7 ->
      if (both (both (dma-ci4 addr 0 112 117 114 112) (dma-ci2 addr 4 111 115)) (dma-ci1 addr 6 101)) then 91
      else qpack-static-none
    9 ->
      if (both (dma-ci8 addr 0 101 120 112 101 99 116 45 99) (dma-ci1 addr 8 116)) then 87
      else if (both (dma-ci8 addr 0 102 111 114 119 97 114 100 101) (dma-ci1 addr 8 100)) then 88
      else qpack-static-none
    10 ->
      if (both (dma-ci8 addr 0 101 97 114 108 121 45 100 97) (dma-ci2 addr 8 116 97)) then 86
      else qpack-static-none
    15 ->
      if (both (both (both (dma-ci8 addr 0 120 45 102 111 114 119 97 114) (dma-ci4 addr 8 100 101 100 45)) (dma-ci2 addr 12 102 111)) (dma-ci1 addr 14 114)) then 96
      else if (both (both (both (dma-ci8 addr 0 120 45 102 114 97 109 101 45) (dma-ci4 addr 8 111 112 116 105)) (dma-ci2 addr 12 111 110)) (dma-ci1 addr 14 115)) then 97
      else qpack-static-none
    16 ->
      if (both (dma-ci8 addr 0 120 45 120 115 115 45 112 114) (dma-ci8 addr 8 111 116 101 99 116 105 111 110)) then 62
      else qpack-static-none
    19 ->
      if (both (both (both (dma-ci8 addr 0 116 105 109 105 110 103 45 97) (dma-ci8 addr 8 108 108 111 119 45 111 114 105)) (dma-ci2 addr 16 103 105)) (dma-ci1 addr 18 110)) then 93
      else qpack-static-none
    22 ->
      if (both (both (both (dma-ci8 addr 0 120 45 99 111 110 116 101 110) (dma-ci8 addr 8 116 45 116 121 112 101 45 111)) (dma-ci4 addr 16 112 116 105 111)) (dma-ci2 addr 20 110 115)) then 61
      else qpack-static-none
    23 ->
      if (both (both (both (both (dma-ci8 addr 0 99 111 110 116 101 110 116 45) (dma-ci8 addr 8 115 101 99 117 114 105 116 121)) (dma-ci4 addr 16 45 112 111 108)) (dma-ci2 addr 20 105 99)) (dma-ci1 addr 22 121)) then 85
      else qpack-static-none
    25 ->
      if (both (both (both (dma-ci8 addr 0 117 112 103 114 97 100 101 45) (dma-ci8 addr 8 105 110 115 101 99 117 114 101)) (dma-ci8 addr 16 45 114 101 113 117 101 115 116)) (dma-ci1 addr 24 115)) then 94
      else qpack-static-none
    28 ->
      if (both (both (both (dma-ci8 addr 0 97 99 99 101 115 115 45 99) (dma-ci8 addr 8 111 110 116 114 111 108 45 97)) (dma-ci8 addr 16 108 108 111 119 45 104 101 97)) (dma-ci4 addr 24 100 101 114 115)) then 33
      else if (both (both (both (dma-ci8 addr 0 97 99 99 101 115 115 45 99) (dma-ci8 addr 8 111 110 116 114 111 108 45 97)) (dma-ci8 addr 16 108 108 111 119 45 109 101 116)) (dma-ci4 addr 24 104 111 100 115)) then 76
      else qpack-static-none
    29 ->
      if (both (both (both (both (dma-ci8 addr 0 97 99 99 101 115 115 45 99) (dma-ci8 addr 8 111 110 116 114 111 108 45 101)) (dma-ci8 addr 16 120 112 111 115 101 45 104 101)) (dma-ci4 addr 24 97 100 101 114)) (dma-ci1 addr 28 115)) then 79
      else if (both (both (both (both (dma-ci8 addr 0 97 99 99 101 115 115 45 99) (dma-ci8 addr 8 111 110 116 114 111 108 45 114)) (dma-ci8 addr 16 101 113 117 101 115 116 45 109)) (dma-ci4 addr 24 101 116 104 111)) (dma-ci1 addr 28 100)) then 81
      else qpack-static-none
    30 ->
      if (both (both (both (both (dma-ci8 addr 0 97 99 99 101 115 115 45 99) (dma-ci8 addr 8 111 110 116 114 111 108 45 114)) (dma-ci8 addr 16 101 113 117 101 115 116 45 104)) (dma-ci4 addr 24 101 97 100 101)) (dma-ci2 addr 28 114 115)) then 80
      else qpack-static-none
    32 ->
      if (both (both (both (dma-ci8 addr 0 97 99 99 101 115 115 45 99) (dma-ci8 addr 8 111 110 116 114 111 108 45 97)) (dma-ci8 addr 16 108 108 111 119 45 99 114 101)) (dma-ci8 addr 24 100 101 110 116 105 97 108 115)) then 73
      else qpack-static-none
    other -> qpack-static-none

  -- | Match an ASCII header name at raw DMA `[addr, addr + len)` case-insensitively
  -- across all 52 distinct header names in the RFC 9204 static table.
  -- Returns the canonical first QPACK static index (`0..98`), or `255` if absent.
  #[no-alloc]
  qpack-static-match-name-dma :: I64 -> U32 ->{MVar} U8
  qpack-static-match-name-dma addr len =
    let kh = known-header-match-dma addr len in
    if ne-u8 kh hdr-unknown then known-header-qpack-index kh
    else match-qpack-only-name-dma addr len

  -- Exact value matcher for `:status` (entries 24..28, 63..71, all length 3).
  #[no-alloc]
  match-status-val-dma :: I64 -> U32 ->{MVar} U8
  match-status-val-dma addr len =
    if ne-u32 len 3 then qpack-static-none
    else
      let b0 = raw-load-u8 addr in
      let b1 = raw-load-u8 (wrapping-add-i64 addr 1) in
      let b2 = raw-load-u8 (wrapping-add-i64 addr 2) in
      if eq-u8 b0 50 then
        if eq-u8 b1 48 then
          if eq-u8 b2 48 then 25
          else if eq-u8 b2 52 then 64
          else if eq-u8 b2 54 then 65
          else qpack-static-none
        else qpack-static-none
      else if eq-u8 b0 51 then
        if eq-u8 b1 48 then
          if eq-u8 b2 52 then 26
          else if eq-u8 b2 50 then 66
          else qpack-static-none
        else qpack-static-none
      else if eq-u8 b0 52 then
        if eq-u8 b1 48 then
          if eq-u8 b2 52 then 27
          else if eq-u8 b2 48 then 67
          else if eq-u8 b2 51 then 68
          else qpack-static-none
        else if eq-u8 b1 50 then
          if eq-u8 b2 49 then 69
          else if eq-u8 b2 53 then 70
          else qpack-static-none
        else qpack-static-none
      else if eq-u8 b0 53 then
        if eq-u8 b1 48 then
          if eq-u8 b2 48 then 71
          else if eq-u8 b2 51 then 28
          else qpack-static-none
        else qpack-static-none
      else if eq-u8 b0 49 then
        if eq-u8 b1 48 then
          if eq-u8 b2 48 then 63
          else if eq-u8 b2 51 then 24
          else qpack-static-none
        else qpack-static-none
      else qpack-static-none

  -- | Given any valid QPACK static index `name-idx` (`0..98`) identifying the
  -- header name, match the exact case-sensitive value at `[val-addr, val-addr + val-len)`
  -- across all 99 RFC 9204 static entries. Returns exact index `0..98` or `255`.
  #[no-alloc]
  qpack-static-match-exact-by-name-dma :: U8 -> I64 -> U32 ->{MVar} U8
  qpack-static-match-exact-by-name-dma name-idx addr len =
    let cidx = static-canon-name-idx name-idx in
    case cidx of
      0 -> if eq-u32 len 0 then 0 else qpack-static-none
      1 ->
        if eq-u32 len 1 then
          if (dma-ex1 addr 0 47) then 1 else qpack-static-none
        else qpack-static-none
      2 ->
        if eq-u32 len 1 then
          if (dma-ex1 addr 0 48) then 2 else qpack-static-none
        else qpack-static-none
      3 -> if eq-u32 len 0 then 3 else qpack-static-none
      4 ->
        if eq-u32 len 1 then
          if (dma-ex1 addr 0 48) then 4 else qpack-static-none
        else qpack-static-none
      5 -> if eq-u32 len 0 then 5 else qpack-static-none
      6 -> if eq-u32 len 0 then 6 else qpack-static-none
      7 -> if eq-u32 len 0 then 7 else qpack-static-none
      8 -> if eq-u32 len 0 then 8 else qpack-static-none
      9 -> if eq-u32 len 0 then 9 else qpack-static-none
      10 -> if eq-u32 len 0 then 10 else qpack-static-none
      11 -> if eq-u32 len 0 then 11 else qpack-static-none
      12 -> if eq-u32 len 0 then 12 else qpack-static-none
      13 -> if eq-u32 len 0 then 13 else qpack-static-none
      14 -> if eq-u32 len 0 then 14 else qpack-static-none
      15 ->
        if eq-u32 len 3 then
          if (both (dma-ex2 addr 0 71 69) (dma-ex1 addr 2 84)) then 17
          else if (both (dma-ex2 addr 0 80 85) (dma-ex1 addr 2 84)) then 21
          else qpack-static-none
        else if eq-u32 len 4 then
          if (dma-ex4 addr 0 72 69 65 68) then 18
          else if (dma-ex4 addr 0 80 79 83 84) then 20
          else qpack-static-none
        else if eq-u32 len 6 then
          if (both (dma-ex4 addr 0 68 69 76 69) (dma-ex2 addr 4 84 69)) then 16 else qpack-static-none
        else if eq-u32 len 7 then
          if (both (both (dma-ex4 addr 0 67 79 78 78) (dma-ex2 addr 4 69 67)) (dma-ex1 addr 6 84)) then 15
          else if (both (both (dma-ex4 addr 0 79 80 84 73) (dma-ex2 addr 4 79 78)) (dma-ex1 addr 6 83)) then 19
          else qpack-static-none
        else qpack-static-none
      22 ->
        if eq-u32 len 4 then
          if (dma-ex4 addr 0 104 116 116 112) then 22 else qpack-static-none
        else if eq-u32 len 5 then
          if (both (dma-ex4 addr 0 104 116 116 112) (dma-ex1 addr 4 115)) then 23 else qpack-static-none
        else qpack-static-none
      24 -> match-status-val-dma addr len
      29 ->
        if eq-u32 len 3 then
          if (both (dma-ex2 addr 0 42 47) (dma-ex1 addr 2 42)) then 29 else qpack-static-none
        else if eq-u32 len 23 then
          if (both (both (both (both (dma-ex8 addr 0 97 112 112 108 105 99 97 116) (dma-ex8 addr 8 105 111 110 47 100 110 115 45)) (dma-ex4 addr 16 109 101 115 115)) (dma-ex2 addr 20 97 103)) (dma-ex1 addr 22 101)) then 30 else qpack-static-none
        else qpack-static-none
      31 ->
        if eq-u32 len 17 then
          if (both (both (dma-ex8 addr 0 103 122 105 112 44 32 100 101) (dma-ex8 addr 8 102 108 97 116 101 44 32 98)) (dma-ex1 addr 16 114)) then 31 else qpack-static-none
        else qpack-static-none
      32 ->
        if eq-u32 len 5 then
          if (both (dma-ex4 addr 0 98 121 116 101) (dma-ex1 addr 4 115)) then 32 else qpack-static-none
        else qpack-static-none
      33 ->
        if eq-u32 len 1 then
          if (dma-ex1 addr 0 42) then 75 else qpack-static-none
        else if eq-u32 len 12 then
          if (both (dma-ex8 addr 0 99 111 110 116 101 110 116 45) (dma-ex4 addr 8 116 121 112 101)) then 34 else qpack-static-none
        else if eq-u32 len 13 then
          if (both (both (dma-ex8 addr 0 99 97 99 104 101 45 99 111) (dma-ex4 addr 8 110 116 114 111)) (dma-ex1 addr 12 108)) then 33 else qpack-static-none
        else qpack-static-none
      35 ->
        if eq-u32 len 1 then
          if (dma-ex1 addr 0 42) then 35 else qpack-static-none
        else qpack-static-none
      36 ->
        if eq-u32 len 8 then
          if (dma-ex8 addr 0 110 111 45 99 97 99 104 101) then 39
          else if (dma-ex8 addr 0 110 111 45 115 116 111 114 101) then 40
          else qpack-static-none
        else if eq-u32 len 9 then
          if (both (dma-ex8 addr 0 109 97 120 45 97 103 101 61) (dma-ex1 addr 8 48)) then 36 else qpack-static-none
        else if eq-u32 len 14 then
          if (both (both (dma-ex8 addr 0 109 97 120 45 97 103 101 61) (dma-ex4 addr 8 54 48 52 56)) (dma-ex2 addr 12 48 48)) then 38 else qpack-static-none
        else if eq-u32 len 15 then
          if (both (both (both (dma-ex8 addr 0 109 97 120 45 97 103 101 61) (dma-ex4 addr 8 50 53 57 50)) (dma-ex2 addr 12 48 48)) (dma-ex1 addr 14 48)) then 37 else qpack-static-none
        else if eq-u32 len 24 then
          if (both (both (dma-ex8 addr 0 112 117 98 108 105 99 44 32) (dma-ex8 addr 8 109 97 120 45 97 103 101 61)) (dma-ex8 addr 16 51 49 53 51 54 48 48 48)) then 41 else qpack-static-none
        else qpack-static-none
      42 ->
        if eq-u32 len 2 then
          if (dma-ex2 addr 0 98 114) then 42 else qpack-static-none
        else if eq-u32 len 4 then
          if (dma-ex4 addr 0 103 122 105 112) then 43 else qpack-static-none
        else qpack-static-none
      44 ->
        if eq-u32 len 8 then
          if (dma-ex8 addr 0 116 101 120 116 47 99 115 115) then 51 else qpack-static-none
        else if eq-u32 len 9 then
          if (both (dma-ex8 addr 0 105 109 97 103 101 47 103 105) (dma-ex1 addr 8 102)) then 48
          else if (both (dma-ex8 addr 0 105 109 97 103 101 47 112 110) (dma-ex1 addr 8 103)) then 50
          else qpack-static-none
        else if eq-u32 len 10 then
          if (both (dma-ex8 addr 0 105 109 97 103 101 47 106 112) (dma-ex2 addr 8 101 103)) then 49
          else if (both (dma-ex8 addr 0 116 101 120 116 47 112 108 97) (dma-ex2 addr 8 105 110)) then 53
          else qpack-static-none
        else if eq-u32 len 16 then
          if (both (dma-ex8 addr 0 97 112 112 108 105 99 97 116) (dma-ex8 addr 8 105 111 110 47 106 115 111 110)) then 46 else qpack-static-none
        else if eq-u32 len 22 then
          if (both (both (both (dma-ex8 addr 0 97 112 112 108 105 99 97 116) (dma-ex8 addr 8 105 111 110 47 106 97 118 97)) (dma-ex4 addr 16 115 99 114 105)) (dma-ex2 addr 20 112 116)) then 45 else qpack-static-none
        else if eq-u32 len 23 then
          if (both (both (both (both (dma-ex8 addr 0 97 112 112 108 105 99 97 116) (dma-ex8 addr 8 105 111 110 47 100 110 115 45)) (dma-ex4 addr 16 109 101 115 115)) (dma-ex2 addr 20 97 103)) (dma-ex1 addr 22 101)) then 44 else qpack-static-none
        else if eq-u32 len 24 then
          if (both (both (dma-ex8 addr 0 116 101 120 116 47 104 116 109) (dma-ex8 addr 8 108 59 32 99 104 97 114 115)) (dma-ex8 addr 16 101 116 61 117 116 102 45 56)) then 52
          else if (both (both (dma-ex8 addr 0 116 101 120 116 47 112 108 97) (dma-ex8 addr 8 105 110 59 99 104 97 114 115)) (dma-ex8 addr 16 101 116 61 117 116 102 45 56)) then 54
          else qpack-static-none
        else if eq-u32 len 33 then
          if (both (both (both (both (dma-ex8 addr 0 97 112 112 108 105 99 97 116) (dma-ex8 addr 8 105 111 110 47 120 45 119 119)) (dma-ex8 addr 16 119 45 102 111 114 109 45 117)) (dma-ex8 addr 24 114 108 101 110 99 111 100 101)) (dma-ex1 addr 32 100)) then 47 else qpack-static-none
        else qpack-static-none
      55 ->
        if eq-u32 len 8 then
          if (dma-ex8 addr 0 98 121 116 101 115 61 48 45) then 55 else qpack-static-none
        else qpack-static-none
      56 ->
        if eq-u32 len 16 then
          if (both (dma-ex8 addr 0 109 97 120 45 97 103 101 61) (dma-ex8 addr 8 51 49 53 51 54 48 48 48)) then 56 else qpack-static-none
        else if eq-u32 len 35 then
          if (both (both (both (both (both (dma-ex8 addr 0 109 97 120 45 97 103 101 61) (dma-ex8 addr 8 51 49 53 51 54 48 48 48)) (dma-ex8 addr 16 59 32 105 110 99 108 117 100)) (dma-ex8 addr 24 101 115 117 98 100 111 109 97)) (dma-ex2 addr 32 105 110)) (dma-ex1 addr 34 115)) then 57 else qpack-static-none
        else if eq-u32 len 44 then
          if (both (both (both (both (both (dma-ex8 addr 0 109 97 120 45 97 103 101 61) (dma-ex8 addr 8 51 49 53 51 54 48 48 48)) (dma-ex8 addr 16 59 32 105 110 99 108 117 100)) (dma-ex8 addr 24 101 115 117 98 100 111 109 97)) (dma-ex8 addr 32 105 110 115 59 32 112 114 101)) (dma-ex4 addr 40 108 111 97 100)) then 58 else qpack-static-none
        else qpack-static-none
      59 ->
        if eq-u32 len 6 then
          if (both (dma-ex4 addr 0 111 114 105 103) (dma-ex2 addr 4 105 110)) then 60 else qpack-static-none
        else if eq-u32 len 15 then
          if (both (both (both (dma-ex8 addr 0 97 99 99 101 112 116 45 101) (dma-ex4 addr 8 110 99 111 100)) (dma-ex2 addr 12 105 110)) (dma-ex1 addr 14 103)) then 59 else qpack-static-none
        else qpack-static-none
      61 ->
        if eq-u32 len 7 then
          if (both (both (dma-ex4 addr 0 110 111 115 110) (dma-ex2 addr 4 105 102)) (dma-ex1 addr 6 102)) then 61 else qpack-static-none
        else qpack-static-none
      62 ->
        if eq-u32 len 13 then
          if (both (both (dma-ex8 addr 0 49 59 32 109 111 100 101 61) (dma-ex4 addr 8 98 108 111 99)) (dma-ex1 addr 12 107)) then 62 else qpack-static-none
        else qpack-static-none
      72 -> if eq-u32 len 0 then 72 else qpack-static-none
      73 ->
        if eq-u32 len 4 then
          if (dma-ex4 addr 0 84 82 85 69) then 74 else qpack-static-none
        else if eq-u32 len 5 then
          if (both (dma-ex4 addr 0 70 65 76 83) (dma-ex1 addr 4 69)) then 73 else qpack-static-none
        else qpack-static-none
      76 ->
        if eq-u32 len 3 then
          if (both (dma-ex2 addr 0 103 101) (dma-ex1 addr 2 116)) then 76 else qpack-static-none
        else if eq-u32 len 7 then
          if (both (both (dma-ex4 addr 0 111 112 116 105) (dma-ex2 addr 4 111 110)) (dma-ex1 addr 6 115)) then 78 else qpack-static-none
        else if eq-u32 len 18 then
          if (both (both (dma-ex8 addr 0 103 101 116 44 32 112 111 115) (dma-ex8 addr 8 116 44 32 111 112 116 105 111)) (dma-ex2 addr 16 110 115)) then 77 else qpack-static-none
        else qpack-static-none
      79 ->
        if eq-u32 len 14 then
          if (both (both (dma-ex8 addr 0 99 111 110 116 101 110 116 45) (dma-ex4 addr 8 108 101 110 103)) (dma-ex2 addr 12 116 104)) then 79 else qpack-static-none
        else qpack-static-none
      80 ->
        if eq-u32 len 12 then
          if (both (dma-ex8 addr 0 99 111 110 116 101 110 116 45) (dma-ex4 addr 8 116 121 112 101)) then 80 else qpack-static-none
        else qpack-static-none
      81 ->
        if eq-u32 len 3 then
          if (both (dma-ex2 addr 0 103 101) (dma-ex1 addr 2 116)) then 81 else qpack-static-none
        else if eq-u32 len 4 then
          if (dma-ex4 addr 0 112 111 115 116) then 82 else qpack-static-none
        else qpack-static-none
      83 ->
        if eq-u32 len 5 then
          if (both (dma-ex4 addr 0 99 108 101 97) (dma-ex1 addr 4 114)) then 83 else qpack-static-none
        else qpack-static-none
      84 -> if eq-u32 len 0 then 84 else qpack-static-none
      85 ->
        if eq-u32 len 53 then
          if (both (both (both (both (both (both (both (dma-ex8 addr 0 115 99 114 105 112 116 45 115) (dma-ex8 addr 8 114 99 32 39 110 111 110 101)) (dma-ex8 addr 16 39 59 32 111 98 106 101 99)) (dma-ex8 addr 24 116 45 115 114 99 32 39 110)) (dma-ex8 addr 32 111 110 101 39 59 32 98 97)) (dma-ex8 addr 40 115 101 45 117 114 105 32 39)) (dma-ex4 addr 48 110 111 110 101)) (dma-ex1 addr 52 39)) then 85 else qpack-static-none
        else qpack-static-none
      86 ->
        if eq-u32 len 1 then
          if (dma-ex1 addr 0 49) then 86 else qpack-static-none
        else qpack-static-none
      87 -> if eq-u32 len 0 then 87 else qpack-static-none
      88 -> if eq-u32 len 0 then 88 else qpack-static-none
      89 -> if eq-u32 len 0 then 89 else qpack-static-none
      90 -> if eq-u32 len 0 then 90 else qpack-static-none
      91 ->
        if eq-u32 len 8 then
          if (dma-ex8 addr 0 112 114 101 102 101 116 99 104) then 91 else qpack-static-none
        else qpack-static-none
      92 -> if eq-u32 len 0 then 92 else qpack-static-none
      93 ->
        if eq-u32 len 1 then
          if (dma-ex1 addr 0 42) then 93 else qpack-static-none
        else qpack-static-none
      94 ->
        if eq-u32 len 1 then
          if (dma-ex1 addr 0 49) then 94 else qpack-static-none
        else qpack-static-none
      95 -> if eq-u32 len 0 then 95 else qpack-static-none
      96 -> if eq-u32 len 0 then 96 else qpack-static-none
      97 ->
        if eq-u32 len 4 then
          if (dma-ex4 addr 0 100 101 110 121) then 97 else qpack-static-none
        else if eq-u32 len 10 then
          if (both (dma-ex8 addr 0 115 97 109 101 111 114 105 103) (dma-ex2 addr 8 105 110)) then 98 else qpack-static-none
        else qpack-static-none
      other -> qpack-static-none

  -- | Given a `Net.Http.Types.KnownHeader` ID (`0..60`) and value DMA slice,
  -- return the exact RFC 9204 static index (`0..98`) or `255`.
  #[inline(always)]
  #[no-alloc]
  qpack-static-match-known-exact-dma :: U8 -> I64 -> U32 ->{MVar} U8
  qpack-static-match-known-exact-dma known-id val-addr val-len =
    let name-idx = known-header-qpack-index known-id in
    if eq-u8 name-idx qpack-static-none then qpack-static-none
    else qpack-static-match-exact-by-name-dma name-idx val-addr val-len

  -- | Match `(name, value)` DMA slices against the RFC 9204 static table in one call.
  -- Returns packed `U16`: `(qpack-match-exact << 8) | idx` on exact match,
  -- `(qpack-match-name << 8) | name-idx` on name-only match, or `0` on miss.
  #[no-alloc]
  qpack-static-match-pair-dma :: I64 -> U32 -> I64 -> U32 ->{MVar} U16
  qpack-static-match-pair-dma name-addr name-len val-addr val-len =
    let name-idx = qpack-static-match-name-dma name-addr name-len in
    if eq-u8 name-idx qpack-static-none then 0
    else
      let exact-idx = qpack-static-match-exact-by-name-dma name-idx val-addr val-len in
      if ne-u8 exact-idx qpack-static-none then
        bit-or-u16 (wrapping-shl-u16 (u8-to-u16 qpack-match-exact) 8) (u8-to-u16 exact-idx)
      else
        bit-or-u16 (wrapping-shl-u16 (u8-to-u16 qpack-match-name) 8) (u8-to-u16 name-idx)
