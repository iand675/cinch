  -- | Write the static header name for `idx` (`0..98`) into DMA `[base+pos, base+cap)`.
  -- Returns new `pos`, or `cap + 1` on invalid index or buffer overflow.
  #[no-alloc]
  qpack-static-write-name-dma :: U8 -> I64 -> U32 -> U32 ->{MVar} U32
  qpack-static-write-name-dma idx base pos cap =
    if ge-u8 idx qpack-static-count then wrapping-add-u32 cap 1
    else
      let need = qpack-static-name-len idx in
      if gt-u32 need (saturating-sub-u32 cap pos) then wrapping-add-u32 cap 1
      else
        let cidx = static-canon-name-idx idx in
        if lt-u8 cidx 50 then write-name-unchecked-lo cidx base pos
        else write-name-unchecked-hi cidx base pos

