  -- | Map `Net.Http.Types.KnownHeader` (`0..60`) to its canonical first RFC 9204
  -- QPACK static index (`0..98`), or `qpack-static-none` (`255`) if absent.
  #[inline(always)]
  #[no-alloc]
  qpack-static-from-known :: U8 -> U8
  qpack-static-from-known known-id = known-header-qpack-index known-id

  -- | True when QPACK static index `idx` is a high-entropy sensitive credential
  -- header (`cookie`, `set-cookie`, `authorization`) that must use `N=1` never-indexed.
  #[inline(always)]
  #[no-alloc]
  qpack-static-is-sensitive :: U8 -> Bool
  qpack-static-is-sensitive idx =
    either (eq-u8 idx 5) (either (eq-u8 idx 14) (eq-u8 idx 84))

  -- | True when a header (by `KnownHeader` ID or raw DMA name) is sensitive
  -- (`authorization`, `cookie`, `set-cookie`, `proxy-authorization`).
  #[no-alloc]
  qpack-static-is-sensitive-dma :: U8 -> I64 -> U32 ->{MVar} Bool
  qpack-static-is-sensitive-dma known-id addr len =
    if either (eq-u8 known-id hdr-authorization)
      (either (eq-u8 known-id hdr-cookie)
        (either (eq-u8 known-id hdr-set-cookie) (eq-u8 known-id hdr-proxy-authorization)))
    then b-true
    else if ne-u8 known-id hdr-unknown then b-false
    else
      let k = known-header-match-dma addr len in
      either (eq-u8 k hdr-authorization)
        (either (eq-u8 k hdr-cookie)
          (either (eq-u8 k hdr-set-cookie) (eq-u8 k hdr-proxy-authorization)))

