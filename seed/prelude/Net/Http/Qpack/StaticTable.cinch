-- | Complete RFC 9204 Appendix A QPACK 99-entry static table (0-indexed: 0..98)
-- with O(1) `#[no-alloc]` bidirectional `Net.Http.Types.KnownHeader` mapping,
-- zero-copy DMA name/value writers, and exact `(name + value)` fast matchers.
module Net.Http.Qpack.StaticTable where

  import Data.Bool
  import Data.Core
  import Data.Machine
  import Data.String
  import Net.Http.Types
  import Prim.Atomic

  export qpack-static-count, qpack-static-none
  export qpack-match-none, qpack-match-name, qpack-match-exact
  export qpack-static-is-valid
  export qpack-static-name, qpack-static-value
  export qpack-static-name-len, qpack-static-value-len
  export qpack-static-known-header, qpack-static-from-known
  export qpack-static-is-sensitive, qpack-static-is-sensitive-dma
  export qpack-static-write-name-dma, qpack-static-write-value-dma
  export qpack-static-match-name-dma, qpack-static-match-exact-by-name-dma
  export qpack-static-match-known-exact-dma, qpack-static-match-pair-dma

  -- =========================================================================
  -- 0. Internal #[no-alloc] boolean & DMA byte helpers
  -- =========================================================================

  #[inline(always)]
  #[no-alloc]
  b-true :: Bool
  b-true = eq-u32 0 0

  #[inline(always)]
  #[no-alloc]
  b-false :: Bool
  b-false = eq-u32 0 1

  #[inline(always)]
  #[no-alloc]
  both :: Bool -> Bool -> Bool
  both a b = if a then b else b-false

  #[inline(always)]
  #[no-alloc]
  either :: Bool -> Bool -> Bool
  either a b = if a then b-true else b

  #[inline(always)]
  #[no-alloc]
  alpha-mask-u8 :: U8 -> U8
  alpha-mask-u8 c =
    if lt-u8 (wrapping-sub-u8 c 97) 26 then 32 else 0

  #[inline(always)]
  #[no-alloc]
  pack-le4 :: U8 -> U8 -> U8 -> U8 -> U32
  pack-le4 c0 c1 c2 c3 =
    bit-or-u32
      (bit-or-u32 (u8-to-u32 c0) (wrapping-shl-u32 (u8-to-u32 c1) 8))
      (bit-or-u32 (wrapping-shl-u32 (u8-to-u32 c2) 16) (wrapping-shl-u32 (u8-to-u32 c3) 24))

  #[inline(always)]
  #[no-alloc]
  pack-le8 :: U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U64
  pack-le8 c0 c1 c2 c3 c4 c5 c6 c7 =
    let lo = u32-to-u64 (pack-le4 c0 c1 c2 c3) in
    let hi = u32-to-u64 (pack-le4 c4 c5 c6 c7) in
    bit-or-u64 lo (wrapping-shl-u64 hi 32)

  #[inline(always)]
  #[no-alloc]
  mask-le4 :: U8 -> U8 -> U8 -> U8 -> U32
  mask-le4 c0 c1 c2 c3 =
    pack-le4 (alpha-mask-u8 c0) (alpha-mask-u8 c1) (alpha-mask-u8 c2) (alpha-mask-u8 c3)

  #[inline(always)]
  #[no-alloc]
  mask-le8 :: U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U64
  mask-le8 c0 c1 c2 c3 c4 c5 c6 c7 =
    pack-le8
      (alpha-mask-u8 c0) (alpha-mask-u8 c1) (alpha-mask-u8 c2) (alpha-mask-u8 c3)
      (alpha-mask-u8 c4) (alpha-mask-u8 c5) (alpha-mask-u8 c6) (alpha-mask-u8 c7)

  -- Case-insensitive DMA comparators (for header names)
  #[inline(always)]
  #[no-alloc]
  dma-ci1 :: I64 -> U32 -> U8 ->{MVar} Bool
  dma-ci1 addr off c0 =
    let b0 = raw-load-u8 (wrapping-add-i64 addr (u32-to-i64 off)) in
    eq-u8 (bit-or-u8 b0 (alpha-mask-u8 c0)) c0

  #[inline(always)]
  #[no-alloc]
  dma-ci2 :: I64 -> U32 -> U8 -> U8 ->{MVar} Bool
  dma-ci2 addr off c0 c1 =
    both (dma-ci1 addr off c0) (dma-ci1 addr (wrapping-add-u32 off 1) c1)

  #[inline(always)]
  #[no-alloc]
  dma-ci4 :: I64 -> U32 -> U8 -> U8 -> U8 -> U8 ->{MVar} Bool
  dma-ci4 addr off c0 c1 c2 c3 =
    let v = raw-load-u32 (wrapping-add-i64 addr (u32-to-i64 off)) in
    eq-u32 (bit-or-u32 v (mask-le4 c0 c1 c2 c3)) (pack-le4 c0 c1 c2 c3)

  #[inline(always)]
  #[no-alloc]
  dma-ci8 :: I64 -> U32 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 ->{MVar} Bool
  dma-ci8 addr off c0 c1 c2 c3 c4 c5 c6 c7 =
    let v = raw-load-u64 (wrapping-add-i64 addr (u32-to-i64 off)) in
    eq-u64 (bit-or-u64 v (mask-le8 c0 c1 c2 c3 c4 c5 c6 c7)) (pack-le8 c0 c1 c2 c3 c4 c5 c6 c7)

  -- Exact case-sensitive DMA comparators (for header values)
  #[inline(always)]
  #[no-alloc]
  dma-ex1 :: I64 -> U32 -> U8 ->{MVar} Bool
  dma-ex1 addr off c0 =
    eq-u8 (raw-load-u8 (wrapping-add-i64 addr (u32-to-i64 off))) c0

  #[inline(always)]
  #[no-alloc]
  dma-ex2 :: I64 -> U32 -> U8 -> U8 ->{MVar} Bool
  dma-ex2 addr off c0 c1 =
    both (dma-ex1 addr off c0) (dma-ex1 addr (wrapping-add-u32 off 1) c1)

  #[inline(always)]
  #[no-alloc]
  dma-ex4 :: I64 -> U32 -> U8 -> U8 -> U8 -> U8 ->{MVar} Bool
  dma-ex4 addr off c0 c1 c2 c3 =
    eq-u32 (raw-load-u32 (wrapping-add-i64 addr (u32-to-i64 off))) (pack-le4 c0 c1 c2 c3)

  #[inline(always)]
  #[no-alloc]
  dma-ex8 :: I64 -> U32 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 ->{MVar} Bool
  dma-ex8 addr off c0 c1 c2 c3 c4 c5 c6 c7 =
    eq-u64 (raw-load-u64 (wrapping-add-i64 addr (u32-to-i64 off))) (pack-le8 c0 c1 c2 c3 c4 c5 c6 c7)

  -- Zero-alloc DMA writers
  #[inline(always)]
  #[no-alloc]
  dma-put1 :: I64 -> U32 -> U8 ->{MVar} U32
  dma-put1 base pos b0 =
    let _ = raw-store-u8 (wrapping-add-i64 base (u32-to-i64 pos)) b0 in
    wrapping-add-u32 pos 1

  #[inline(always)]
  #[no-alloc]
  dma-put2 :: I64 -> U32 -> U8 -> U8 ->{MVar} U32
  dma-put2 base pos b0 b1 =
    let p1 = dma-put1 base pos b0 in
    dma-put1 base p1 b1

  #[inline(always)]
  #[no-alloc]
  dma-put4 :: I64 -> U32 -> U8 -> U8 -> U8 -> U8 ->{MVar} U32
  dma-put4 base pos b0 b1 b2 b3 =
    let _ = raw-store-u32 (wrapping-add-i64 base (u32-to-i64 pos)) (pack-le4 b0 b1 b2 b3) in
    wrapping-add-u32 pos 4

  #[inline(always)]
  #[no-alloc]
  dma-put8 :: I64 -> U32 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 ->{MVar} U32
  dma-put8 base pos b0 b1 b2 b3 b4 b5 b6 b7 =
    let _ = raw-store-u64 (wrapping-add-i64 base (u32-to-i64 pos)) (pack-le8 b0 b1 b2 b3 b4 b5 b6 b7) in
    wrapping-add-u32 pos 8

  -- =========================================================================
  -- 1. Constants & O(1) RFC 9204 Appendix A Table Accessors (indices 0..98)
  -- =========================================================================

  #[inline(always)]
  #[no-alloc]
  qpack-static-count :: U8
  qpack-static-count = 99

  #[inline(always)]
  #[no-alloc]
  qpack-static-none :: U8
  qpack-static-none = 255

  #[inline(always)]
  #[no-alloc]
  qpack-match-none :: U8
  qpack-match-none = 0

  #[inline(always)]
  #[no-alloc]
  qpack-match-name :: U8
  qpack-match-name = 1

  #[inline(always)]
  #[no-alloc]
  qpack-match-exact :: U8
  qpack-match-exact = 2

  #[inline(always)]
  #[no-alloc]
  qpack-static-is-valid :: U8 -> Bool
  qpack-static-is-valid idx = lt-u8 idx qpack-static-count

  -- | Return the canonical lowercase header name for RFC 9204 static index `0..98`,
