-- | Unified H2O-style canonical HTTP/1.1 + HTTP/2 + HTTP/3 types,
-- O(1) 61-header lookup tables with exact RFC 7541 (HPACK) & RFC 9204 (QPACK)
-- static table indices, zero-copy `#[repr(C, value)]` POD request/header views,
-- and a compile-time `%1` linear `ResponseWriter` state machine.
--
-- Every hot-path helper is `#[no-alloc]` (or auto-niched single-word `Raw`
-- enum with zero runtime heap allocation) and returns immortal (`rc == 0`)
-- data-section strings where text literals are exposed.
module Net.Http.Types where

  import Data.Bool
  import Data.Bytes
  import Data.Core
  import Data.Machine
  import Data.Nat
  import Data.String
  import Prim.Atomic

  -- HTTP Methods (auto-niched single-word enum + U8 wire codes)
  export HttpMethod, MethodGet, MethodHead, MethodPost, MethodPut, MethodDelete
  export MethodConnect, MethodOptions, MethodTrace, MethodPatch, MethodCustom
  export method-code-get, method-code-head, method-code-post, method-code-put
  export method-code-delete, method-code-connect, method-code-options
  export method-code-trace, method-code-patch, method-code-custom
  export http-method-to-u8, http-method-from-u8, http-method-name, http-method-eq

  -- HTTP Protocol Versions (auto-niched single-word enum + U8 codes)
  export HttpVersion, Http10, Http11, Http2, Http3
  export version-code-http10, version-code-http11, version-code-http2, version-code-http3
  export http-version-to-u8, http-version-from-u8, http-version-name, http-version-eq

  -- HTTP Status (2-byte #[repr(value)] POD + 17 common constructors + immortal status lines)
  export HttpStatus, status-of, status-eq
  export status-ok, status-created, status-no-content, status-partial-content
  export status-moved-permanently, status-not-modified, status-bad-request
  export status-unauthorized, status-forbidden, status-not-found
  export status-method-not-allowed, status-payload-too-large, status-too-many-requests
  export status-internal-error, status-bad-gateway, status-service-unavailable
  export status-switching-protocols
  export http-status-line

  -- KnownHeader U8 constants (0..60 + hdr-unknown = 255) & O(1) RFC 7541/9204 tables
  export known-header-count, hdr-unknown
  export hdr-authority, hdr-method, hdr-path, hdr-scheme, hdr-status
  export hdr-accept, hdr-accept-charset, hdr-accept-encoding, hdr-accept-language
  export hdr-accept-ranges, hdr-access-control-allow-origin, hdr-age, hdr-allow
  export hdr-authorization, hdr-cache-control, hdr-connection, hdr-content-disposition
  export hdr-content-encoding, hdr-content-language, hdr-content-length
  export hdr-content-location, hdr-content-range, hdr-content-type, hdr-cookie
  export hdr-date, hdr-etag, hdr-expect, hdr-expires, hdr-from, hdr-host
  export hdr-if-match, hdr-if-modified-since, hdr-if-none-match, hdr-if-range
  export hdr-if-unmodified-since, hdr-last-modified, hdr-link, hdr-location
  export hdr-max-forwards, hdr-origin, hdr-priority, hdr-proxy-authenticate
  export hdr-proxy-authorization, hdr-range, hdr-referer, hdr-refresh, hdr-retry-after
  export hdr-sec-websocket-accept, hdr-sec-websocket-key, hdr-sec-websocket-version
  export hdr-server, hdr-set-cookie, hdr-strict-transport-security, hdr-te
  export hdr-transfer-encoding, hdr-upgrade, hdr-user-agent, hdr-vary, hdr-via
  export hdr-www-authenticate, hdr-alt-svc
  export known-header-bit, known-header-hpack-index, known-header-qpack-index
  export known-header-wire-name, known-header-match-dma, known-header-match-bytes

  -- Zero-Copy HeaderPair (20B POD) & RequestHead (48B POD) + Flags
  export HeaderPair, header-pair-make, header-pair-empty
  export RequestHead, req-head-empty, req-has-header, req-has-flag
  export req-flag-keep-alive, req-flag-chunked, req-flag-has-cl
  export req-flag-expect-continue, req-flag-upgrade

  -- Linear %1 ResponseWriter state machine (types only; constructors are private!)
  export ResponseHeadPending, ResponseBodyOpen, ResponseClosed
  export response-begin, response-with-writer
  export response-write-status, response-write-header-known, response-finish-head
  export response-write-body, response-end, response-finish-closed

  -- =========================================================================
  -- 0. Internal #[no-alloc] boolean & byte-packing helpers
  -- =========================================================================

  #[inline(always)]
  #[no-alloc]
  b-true :: Bool
  b-true = eq-u32 0 0

  #[inline(always)]
  #[no-alloc]
  b-false :: Bool
  b-false = eq-u32 0 1

  #[inline(always)]
  #[no-alloc]
  both :: Bool -> Bool -> Bool
  both a b = if a then b else b-false

  #[inline(always)]
  #[no-alloc]
  ascii-lower-u8 :: U8 -> U8
  ascii-lower-u8 b =
    if lt-u8 (wrapping-sub-u8 b 65) 26 then bit-or-u8 b 32 else b

  -- Per-byte alpha mask: 0x20 if expected lowercase byte is 'a'..'z', else 0x00.
  -- Theorem: for c in 'a'..'z', (b | 0x20) == c iff b in {c, c - 32};
  -- for c in {':', '-'}, (b | 0x00) == c iff b == c. Exact across all 256 bytes!
  #[inline(always)]
  #[no-alloc]
  alpha-mask-u8 :: U8 -> U8
  alpha-mask-u8 c =
    if lt-u8 (wrapping-sub-u8 c 97) 26 then 32 else 0

  #[inline(always)]
  #[no-alloc]
  pack-le2 :: U8 -> U8 -> U32
  pack-le2 c0 c1 =
    bit-or-u32 (u8-to-u32 c0) (wrapping-shl-u32 (u8-to-u32 c1) 8)

  #[inline(always)]
  #[no-alloc]
  pack-le4 :: U8 -> U8 -> U8 -> U8 -> U32
  pack-le4 c0 c1 c2 c3 =
    bit-or-u32
      (bit-or-u32 (u8-to-u32 c0) (wrapping-shl-u32 (u8-to-u32 c1) 8))
      (bit-or-u32 (wrapping-shl-u32 (u8-to-u32 c2) 16) (wrapping-shl-u32 (u8-to-u32 c3) 24))

  #[inline(always)]
  #[no-alloc]
  pack-le8 :: U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U64
  pack-le8 c0 c1 c2 c3 c4 c5 c6 c7 =
    let lo = u32-to-u64 (pack-le4 c0 c1 c2 c3) in
    let hi = u32-to-u64 (pack-le4 c4 c5 c6 c7) in
    bit-or-u64 lo (wrapping-shl-u64 hi 32)

  #[inline(always)]
  #[no-alloc]
  mask-le4 :: U8 -> U8 -> U8 -> U8 -> U32
  mask-le4 c0 c1 c2 c3 =
    pack-le4 (alpha-mask-u8 c0) (alpha-mask-u8 c1) (alpha-mask-u8 c2) (alpha-mask-u8 c3)

  #[inline(always)]
  #[no-alloc]
  mask-le8 :: U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U8 -> U64
  mask-le8 c0 c1 c2 c3 c4 c5 c6 c7 =
    pack-le8
      (alpha-mask-u8 c0) (alpha-mask-u8 c1) (alpha-mask-u8 c2) (alpha-mask-u8 c3)
      (alpha-mask-u8 c4) (alpha-mask-u8 c5) (alpha-mask-u8 c6) (alpha-mask-u8 c7)

  -- =========================================================================
  -- 1. HttpMethod (auto-niched single-word enum + U8 wire codes)
  -- =========================================================================

  -- | Canonical HTTP request method shared across HTTP/1.1, HTTP/2, and HTTP/3.
  data HttpMethod where
    MethodGet :: HttpMethod
    MethodHead :: HttpMethod
    MethodPost :: HttpMethod
    MethodPut :: HttpMethod
    MethodDelete :: HttpMethod
    MethodConnect :: HttpMethod
    MethodOptions :: HttpMethod
    MethodTrace :: HttpMethod
    MethodPatch :: HttpMethod
    MethodCustom :: HttpMethod

  #[no-alloc]
  method-code-get :: U8
  method-code-get = 0

  #[no-alloc]
  method-code-head :: U8
  method-code-head = 1

  #[no-alloc]
  method-code-post :: U8
  method-code-post = 2

  #[no-alloc]
  method-code-put :: U8
  method-code-put = 3

  #[no-alloc]
  method-code-delete :: U8
  method-code-delete = 4

  #[no-alloc]
  method-code-connect :: U8
  method-code-connect = 5

  #[no-alloc]
  method-code-options :: U8
  method-code-options = 6

  #[no-alloc]
  method-code-trace :: U8
  method-code-trace = 7

  #[no-alloc]
  method-code-patch :: U8
  method-code-patch = 8

  #[no-alloc]
  method-code-custom :: U8
  method-code-custom = 255

  -- | Convert an `HttpMethod` to its canonical `U8` code.
  #[no-alloc]
  http-method-to-u8 :: HttpMethod -> U8
  http-method-to-u8 m = case m of
    MethodGet -> 0
    MethodHead -> 1
    MethodPost -> 2
    MethodPut -> 3
    MethodDelete -> 4
    MethodConnect -> 5
    MethodOptions -> 6
    MethodTrace -> 7
    MethodPatch -> 8
    MethodCustom -> 255

  -- | Decode a `U8` code into `HttpMethod` (auto-niched single-word Raw enum:
  -- zero runtime heap allocation).
  http-method-from-u8 :: U8 -> HttpMethod
  http-method-from-u8 code =
    if eq-u8 code 0 then MethodGet
    else if eq-u8 code 1 then MethodHead
    else if eq-u8 code 2 then MethodPost
    else if eq-u8 code 3 then MethodPut
    else if eq-u8 code 4 then MethodDelete
    else if eq-u8 code 5 then MethodConnect
    else if eq-u8 code 6 then MethodOptions
    else if eq-u8 code 7 then MethodTrace
    else if eq-u8 code 8 then MethodPatch
    else MethodCustom

  -- | Return the canonical uppercase HTTP method name as an immortal (`rc == 0`) string.
  #[no-alloc]
  http-method-name :: HttpMethod -> String
  http-method-name m = case m of
    MethodGet -> "GET"
    MethodHead -> "HEAD"
    MethodPost -> "POST"
    MethodPut -> "PUT"
    MethodDelete -> "DELETE"
    MethodConnect -> "CONNECT"
    MethodOptions -> "OPTIONS"
    MethodTrace -> "TRACE"
    MethodPatch -> "PATCH"
    MethodCustom -> ""

  #[no-alloc]
  http-method-eq :: HttpMethod -> HttpMethod -> Bool
  http-method-eq a b = eq-u8 (http-method-to-u8 a) (http-method-to-u8 b)

  -- =========================================================================
  -- 2. HttpVersion (auto-niched single-word enum + U8 wire codes)
  -- =========================================================================

  -- | Canonical HTTP protocol version.
  data HttpVersion where
    Http10 :: HttpVersion
    Http11 :: HttpVersion
    Http2 :: HttpVersion
    Http3 :: HttpVersion

  #[no-alloc]
  version-code-http10 :: U8
  version-code-http10 = 0

  #[no-alloc]
  version-code-http11 :: U8
  version-code-http11 = 1

  #[no-alloc]
  version-code-http2 :: U8
  version-code-http2 = 2

  #[no-alloc]
  version-code-http3 :: U8
  version-code-http3 = 3

  #[no-alloc]
  http-version-to-u8 :: HttpVersion -> U8
  http-version-to-u8 v = case v of
    Http10 -> 0
    Http11 -> 1
    Http2 -> 2
    Http3 -> 3

  -- Auto-niched single-word Raw enum: zero runtime heap allocation.
  http-version-from-u8 :: U8 -> HttpVersion
  http-version-from-u8 code =
    if eq-u8 code 0 then Http10
    else if eq-u8 code 1 then Http11
    else if eq-u8 code 2 then Http2
    else Http3

  #[no-alloc]
  http-version-name :: HttpVersion -> String
  http-version-name v = case v of
    Http10 -> "HTTP/1.0"
    Http11 -> "HTTP/1.1"
    Http2 -> "HTTP/2"
    Http3 -> "HTTP/3"

  #[no-alloc]
  http-version-eq :: HttpVersion -> HttpVersion -> Bool
  http-version-eq a b = eq-u8 (http-version-to-u8 a) (http-version-to-u8 b)

  -- =========================================================================
  -- 3. HttpStatus (2-byte #[repr(value)] POD + immortal status-line literals)
  -- =========================================================================

  -- | Unboxed 2-byte HTTP status code.
  #[repr(value)]
  record HttpStatus where
    status-code :: U16

  #[inline(always)]
  #[no-alloc]
  status-of :: U16 -> HttpStatus
  status-of code = HttpStatus code

  #[inline(always)]
  #[no-alloc]
  status-eq :: HttpStatus -> HttpStatus -> Bool
  status-eq a b = eq-u16 a.status-code b.status-code

  #[inline(always)]
  #[no-alloc]
  status-ok :: Unit -> HttpStatus
  status-ok _ = HttpStatus 200

  #[inline(always)]
  #[no-alloc]
  status-created :: Unit -> HttpStatus
  status-created _ = HttpStatus 201

  #[inline(always)]
  #[no-alloc]
  status-no-content :: Unit -> HttpStatus
  status-no-content _ = HttpStatus 204

  #[inline(always)]
  #[no-alloc]
  status-partial-content :: Unit -> HttpStatus
  status-partial-content _ = HttpStatus 206

  #[inline(always)]
  #[no-alloc]
  status-moved-permanently :: Unit -> HttpStatus
  status-moved-permanently _ = HttpStatus 301

  #[inline(always)]
  #[no-alloc]
  status-not-modified :: Unit -> HttpStatus
  status-not-modified _ = HttpStatus 304

  #[inline(always)]
  #[no-alloc]
  status-bad-request :: Unit -> HttpStatus
  status-bad-request _ = HttpStatus 400

  #[inline(always)]
  #[no-alloc]
  status-unauthorized :: Unit -> HttpStatus
  status-unauthorized _ = HttpStatus 401

  #[inline(always)]
  #[no-alloc]
  status-forbidden :: Unit -> HttpStatus
  status-forbidden _ = HttpStatus 403

  #[inline(always)]
  #[no-alloc]
  status-not-found :: Unit -> HttpStatus
  status-not-found _ = HttpStatus 404

  #[inline(always)]
  #[no-alloc]
  status-method-not-allowed :: Unit -> HttpStatus
  status-method-not-allowed _ = HttpStatus 405

  #[inline(always)]
  #[no-alloc]
  status-payload-too-large :: Unit -> HttpStatus
  status-payload-too-large _ = HttpStatus 413

  #[inline(always)]
  #[no-alloc]
  status-too-many-requests :: Unit -> HttpStatus
  status-too-many-requests _ = HttpStatus 429

  #[inline(always)]
  #[no-alloc]
  status-internal-error :: Unit -> HttpStatus
  status-internal-error _ = HttpStatus 500

  #[inline(always)]
  #[no-alloc]
  status-bad-gateway :: Unit -> HttpStatus
  status-bad-gateway _ = HttpStatus 502

  #[inline(always)]
  #[no-alloc]
  status-service-unavailable :: Unit -> HttpStatus
  status-service-unavailable _ = HttpStatus 503

  #[inline(always)]
  #[no-alloc]
  status-switching-protocols :: Unit -> HttpStatus
  status-switching-protocols _ = HttpStatus 101

  -- | Pre-rendered immortal (`rc == 0`) HTTP/1.1 status-line literal for standard
  -- status codes (empty string for custom/non-standard codes).
  #[no-alloc]
  http-status-line :: HttpStatus -> String
  http-status-line st =
    let c = st.status-code in
    if eq-u16 c 200 then "HTTP/1.1 200 OK\r\n"
    else if eq-u16 c 201 then "HTTP/1.1 201 Created\r\n"
    else if eq-u16 c 204 then "HTTP/1.1 204 No Content\r\n"
    else if eq-u16 c 206 then "HTTP/1.1 206 Partial Content\r\n"
    else if eq-u16 c 301 then "HTTP/1.1 301 Moved Permanently\r\n"
    else if eq-u16 c 304 then "HTTP/1.1 304 Not Modified\r\n"
    else if eq-u16 c 400 then "HTTP/1.1 400 Bad Request\r\n"
    else if eq-u16 c 401 then "HTTP/1.1 401 Unauthorized\r\n"
    else if eq-u16 c 403 then "HTTP/1.1 403 Forbidden\r\n"
    else if eq-u16 c 404 then "HTTP/1.1 404 Not Found\r\n"
    else if eq-u16 c 405 then "HTTP/1.1 405 Method Not Allowed\r\n"
    else if eq-u16 c 413 then "HTTP/1.1 413 Payload Too Large\r\n"
    else if eq-u16 c 429 then "HTTP/1.1 429 Too Many Requests\r\n"
    else if eq-u16 c 500 then "HTTP/1.1 500 Internal Server Error\r\n"
    else if eq-u16 c 502 then "HTTP/1.1 502 Bad Gateway\r\n"
    else if eq-u16 c 503 then "HTTP/1.1 503 Service Unavailable\r\n"
    else if eq-u16 c 101 then "HTTP/1.1 101 Switching Protocols\r\n"
    else ""

