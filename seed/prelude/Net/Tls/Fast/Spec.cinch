-- | Formal Model M6 (`Tls13Machine`): compile-time TLA+-style explicit-state
-- model of the TLS 1.3 server handshake, key-level monotonicity, 0-RTT
-- anti-replay guard, fatal alert absorption, and abstract secure-channel
-- refinement (`Net.Tls.Fast.Spec`).
--
-- Exhaustively verified at compile time (`max_states = 65536`, `capped: false`,
-- `0 violations` under `CINCH_MODEL_FAIL_ON_CAPPED=1`):
--   * `noAuthBypassOrReplay` (`always`):
--       - No 1-RTT application data is ever accepted before `Finished` verification.
--       - No duplicate 0-RTT ticket nonce (`Fin 3`) is ever accepted twice.
--       - Active key level progresses strictly monotonically
--         (`LevelInitial <= LevelHandshake <= LevelApp1RTT`) and matches phase.
--   * `alertAbsorbing` (`stable`):
--       - Once the server enters `HsAlert`, it stays in `HsAlert` forever.
--   * `tlsDeadlockFree` (`deadlock_free`):
--       - Every reachable state has an enabled transition.
--   * `validHandshakeConnects` (`leads_to` under `assume = (\s -> s.honest-peer)`
--     and `fair = [tls-step-recv, tls-step-send]`):
--       - Every honest TLS 1.3 handshake reaches `HsConnected` with `LevelApp1RTT`.
--   * `refines Tls13Machine AbstractSecureChannel` (with `measure = tls-measure`):
--       - Checked stuttering simulation proving all handshake sub-steps and
--         0-RTT nonce checks refine a 4-phase abstract secure channel without
--         infinite stuttering.
module Net.Tls.Fast.Spec where

  import Data.Bool
  import Data.Nat
  import Data.Option

  export HsState, HsStart, HsRecvdCH, HsSentHRR, HsWaitFin, HsConnected, HsAlert, HsClosed
  export KeyLevel, LevelInitial, LevelHandshake, LevelApp1RTT
  export SendAction, SendHrr, SendFlight
  export FaultKind, FaultEarlyAppData, FaultBadFin, FaultBadRecord
  export TlsState, tls-init
  export hs-state-eq, key-level-rank, key-level-monotone, tls-safety-ok
  export tls-step-recv, tls-step-send, tls-step-zero-rtt, tls-step-fault, tls-step-close, tls-step-terminal
  export AbsChanPhase, AbsHandshaking, AbsOpen, AbsFailed, AbsClosed
  export AbsChannelState, abs-connect, abs-fail, abs-close, abs-stutter-terminal
  export tls-view, tls-measure

  -- =========================================================================
  -- 1. Pure TLS 1.3 server handshake & encryption-level vocabulary
  -- =========================================================================

  -- | TLS 1.3 server handshake states.
  data HsState where
    HsStart :: HsState
    HsRecvdCH :: HsState
    HsSentHRR :: HsState
    HsWaitFin :: HsState
    HsConnected :: HsState
    HsAlert :: HsState
    HsClosed :: HsState

  -- | RFC 8446 / RFC 9001 encryption key levels.
  data KeyLevel where
    LevelInitial :: KeyLevel
    LevelHandshake :: KeyLevel
    LevelApp1RTT :: KeyLevel

  -- | Server flight choices after receiving `ClientHello`.
  data SendAction where
    SendHrr :: SendAction
    SendFlight :: SendAction

  -- | Adversarial / invalid peer inputs that must trigger `HsAlert` without
  -- bypassing authentication or replaying 0-RTT tickets.
  data FaultKind where
    FaultEarlyAppData :: FaultKind
    FaultBadFin :: FaultKind
    FaultBadRecord :: FaultKind

  hs-state-rank :: HsState -> Nat
  hs-state-rank st = case st of
    HsStart -> 0
    HsRecvdCH -> 1
    HsSentHRR -> 2
    HsWaitFin -> 3
    HsConnected -> 4
    HsAlert -> 5
    HsClosed -> 6

  hs-state-eq :: HsState -> HsState -> Bool
  hs-state-eq a b = hs-state-rank a == hs-state-rank b

  key-level-rank :: KeyLevel -> Nat
  key-level-rank lvl = case lvl of
    LevelInitial -> 0
    LevelHandshake -> 1
    LevelApp1RTT -> 2

  -- | Concrete TLS 1.3 server state tracked by M6 `Tls13Machine`.
  record TlsState where
    hs-state :: HsState
    key-level :: KeyLevel
    prev-key-level :: KeyLevel
    nonce-seen :: Nat          -- 3-bit bitmask of seen 0-RTT nonces in `Fin 3` (0..7)
    hrr-sent :: Bool           -- at most one HelloRetryRequest per RFC 8446 §4.1.4
    honest-peer :: Bool        -- True while peer has not triggered an adversarial fault
    alert-entered :: Bool      -- Ghost monitor: True once HsAlert has ever been entered
    app-data-before-fin :: Bool
    replay-accepted :: Bool

  tls-init :: TlsState
  tls-init = TlsState {
    hs-state = HsStart,
    key-level = LevelInitial,
    prev-key-level = LevelInitial,
    nonce-seen = 0,
    hrr-sent = False,
    honest-peer = True,
    alert-entered = False,
    app-data-before-fin = False,
    replay-accepted = False
  }

  -- =========================================================================
  -- 2. Bitmask helpers for `Fin 3` 0-RTT anti-replay nonces (`0, 1, 2`)
  -- =========================================================================

  fin3-val :: Fin 3 -> Nat
  fin3-val f = case f of
    Fin x _ -> x

  nonce-bit-is-set :: Nat -> Nat -> Bool
  nonce-bit-is-set mask idx =
    if idx == 0 then nat-rem mask 2 == 1
    else if idx == 1 then nat-rem (nat-div mask 2) 2 == 1
    else nat-rem (nat-div mask 4) 2 == 1

  nonce-bit-set :: Nat -> Nat -> Nat
  nonce-bit-set mask idx =
    if nonce-bit-is-set mask idx then mask
    else if idx == 0 then mask + 1
    else if idx == 1 then mask + 2
    else mask + 4

  nonce-popcount :: Nat -> Nat
  nonce-popcount mask =
    (if nonce-bit-is-set mask 0 then 1 else 0)
      + (if nonce-bit-is-set mask 1 then 1 else 0)
      + (if nonce-bit-is-set mask 2 then 1 else 0)

  -- =========================================================================
  -- 3. Transition actions (shared by compile-time MC and Hegel simulation)
  -- =========================================================================

  -- | Honest peer handshake receive step:
  --   * `HsStart -> HsRecvdCH` (ClientHello1)
  --   * `HsSentHRR -> HsRecvdCH` (ClientHello2 after HRR)
  --   * `HsWaitFin -> HsConnected` (verified Client Finished; upgrades to `LevelApp1RTT`)
  tls-step-recv :: TlsState -> Option TlsState
  tls-step-recv s = case s.hs-state of
    HsStart ->
      Some (TlsState {
        hs-state = HsRecvdCH,
        key-level = s.key-level,
        prev-key-level = s.key-level,
        nonce-seen = s.nonce-seen,
        hrr-sent = s.hrr-sent,
        honest-peer = s.honest-peer,
        alert-entered = s.alert-entered,
        app-data-before-fin = s.app-data-before-fin,
        replay-accepted = s.replay-accepted
      })
    HsSentHRR ->
      Some (TlsState {
        hs-state = HsRecvdCH,
        key-level = s.key-level,
        prev-key-level = s.key-level,
        nonce-seen = s.nonce-seen,
        hrr-sent = s.hrr-sent,
        honest-peer = s.honest-peer,
        alert-entered = s.alert-entered,
        app-data-before-fin = s.app-data-before-fin,
        replay-accepted = s.replay-accepted
      })
    HsWaitFin ->
      Some (TlsState {
        hs-state = HsConnected,
        key-level = LevelApp1RTT,
        prev-key-level = s.key-level,
        nonce-seen = s.nonce-seen,
        hrr-sent = s.hrr-sent,
        honest-peer = s.honest-peer,
        alert-entered = s.alert-entered,
        app-data-before-fin = s.app-data-before-fin,
        replay-accepted = s.replay-accepted
      })
    _ -> None

  -- | Server flight send step after receiving `ClientHello`:
  --   * `SendHrr`: emit `HelloRetryRequest` (at most once: `not s.hrr-sent`)
  --   * `SendFlight`: emit `SH + EE + Cert + CV + SF` and install `LevelHandshake`
  tls-step-send :: SendAction -> TlsState -> Option TlsState
  tls-step-send act s = case s.hs-state of
    HsRecvdCH -> case act of
      SendHrr ->
        if not s.hrr-sent then
          Some (TlsState {
            hs-state = HsSentHRR,
            key-level = LevelInitial,
            prev-key-level = s.key-level,
            nonce-seen = s.nonce-seen,
            hrr-sent = True,
            honest-peer = s.honest-peer,
            alert-entered = s.alert-entered,
            app-data-before-fin = s.app-data-before-fin,
            replay-accepted = s.replay-accepted
          })
        else None
      SendFlight ->
        Some (TlsState {
          hs-state = HsWaitFin,
          key-level = LevelHandshake,
          prev-key-level = s.key-level,
          nonce-seen = s.nonce-seen,
          hrr-sent = s.hrr-sent,
          honest-peer = s.honest-peer,
          alert-entered = s.alert-entered,
          app-data-before-fin = s.app-data-before-fin,
          replay-accepted = s.replay-accepted
        })
    _ -> None

  -- | 0-RTT early-data ticket nonce admission with anti-replay Bloom guard (`Fin 3`):
  --   * Fresh nonce in `HsStart` or `HsRecvdCH`: mark bit in `nonce-seen` (accepted).
  --   * Duplicate nonce (already set in `nonce-seen`): REJECTED (never accepted;
  --     triggers `HsAlert` and marks `honest-peer = False`, `replay-accepted` stays `False`).
  tls-step-zero-rtt :: Fin 3 -> TlsState -> Option TlsState
  tls-step-zero-rtt nid s =
    let idx = fin3-val nid in
    case s.hs-state of
      HsStart ->
        if nonce-bit-is-set s.nonce-seen idx then
          Some (TlsState {
            hs-state = HsAlert,
            key-level = s.key-level,
            prev-key-level = s.key-level,
            nonce-seen = s.nonce-seen,
            hrr-sent = s.hrr-sent,
            honest-peer = False,
            alert-entered = True,
            app-data-before-fin = s.app-data-before-fin,
            replay-accepted = False
          })
        else
          Some (TlsState {
            hs-state = HsStart,
            key-level = s.key-level,
            prev-key-level = s.key-level,
            nonce-seen = nonce-bit-set s.nonce-seen idx,
            hrr-sent = s.hrr-sent,
            honest-peer = s.honest-peer,
            alert-entered = s.alert-entered,
            app-data-before-fin = s.app-data-before-fin,
            replay-accepted = False
          })
      HsRecvdCH ->
        if nonce-bit-is-set s.nonce-seen idx then
          Some (TlsState {
            hs-state = HsAlert,
            key-level = s.key-level,
            prev-key-level = s.key-level,
            nonce-seen = s.nonce-seen,
            hrr-sent = s.hrr-sent,
            honest-peer = False,
            alert-entered = True,
            app-data-before-fin = s.app-data-before-fin,
            replay-accepted = False
          })
        else
          Some (TlsState {
            hs-state = HsRecvdCH,
            key-level = s.key-level,
            prev-key-level = s.key-level,
            nonce-seen = nonce-bit-set s.nonce-seen idx,
            hrr-sent = s.hrr-sent,
            honest-peer = s.honest-peer,
            alert-entered = s.alert-entered,
            app-data-before-fin = s.app-data-before-fin,
            replay-accepted = False
          })
      _ -> None

  -- | Adversarial / protocol fault transitions:
  --   * Premature 1-RTT application data before `Finished` is ALWAYS rejected -> `HsAlert`
  --   * Bad `Finished` verify_data in `HsWaitFin` -> `HsAlert`
  --   * Bad record MAC / malformed frame in any active state -> `HsAlert`
  tls-step-fault :: FaultKind -> TlsState -> Option TlsState
  tls-step-fault fk s = case s.hs-state of
    HsAlert -> None
    HsClosed -> None
    HsConnected -> case fk of
      FaultBadRecord ->
        Some (TlsState {
          hs-state = HsAlert,
          key-level = s.key-level,
          prev-key-level = s.key-level,
          nonce-seen = s.nonce-seen,
          hrr-sent = s.hrr-sent,
          honest-peer = False,
          alert-entered = True,
          app-data-before-fin = s.app-data-before-fin,
          replay-accepted = s.replay-accepted
        })
      _ -> None
    HsWaitFin ->
      Some (TlsState {
        hs-state = HsAlert,
        key-level = s.key-level,
        prev-key-level = s.key-level,
        nonce-seen = s.nonce-seen,
        hrr-sent = s.hrr-sent,
        honest-peer = False,
        alert-entered = True,
        app-data-before-fin = s.app-data-before-fin,
        replay-accepted = s.replay-accepted
      })
    _ -> case fk of
      FaultBadFin -> None
      _ ->
        Some (TlsState {
          hs-state = HsAlert,
          key-level = s.key-level,
          prev-key-level = s.key-level,
          nonce-seen = s.nonce-seen,
          hrr-sent = s.hrr-sent,
          honest-peer = False,
          alert-entered = True,
          app-data-before-fin = s.app-data-before-fin,
          replay-accepted = s.replay-accepted
        })

  -- | Graceful `close_notify` shutdown from an established 1-RTT connection.
  tls-step-close :: TlsState -> Option TlsState
  tls-step-close s = case s.hs-state of
    HsConnected ->
      Some (TlsState {
        hs-state = HsClosed,
        key-level = s.key-level,
        prev-key-level = s.key-level,
        nonce-seen = s.nonce-seen,
        hrr-sent = s.hrr-sent,
        honest-peer = s.honest-peer,
        alert-entered = s.alert-entered,
        app-data-before-fin = s.app-data-before-fin,
        replay-accepted = s.replay-accepted
      })
    _ -> None

  -- | Terminal self-loop for `HsAlert` (preserving `alertAbsorbing`) and
  -- `HsClosed` so the state machine is globally deadlock-free.
  tls-step-terminal :: TlsState -> Option TlsState
  tls-step-terminal s = case s.hs-state of
    HsAlert -> Some s
    HsClosed -> Some s
    _ -> None

  -- =========================================================================
  -- 4. Safety invariants
  -- =========================================================================

  key-level-monotone :: TlsState -> Bool
  key-level-monotone s = key-level-rank s.prev-key-level <= key-level-rank s.key-level

  phase-level-coherent :: TlsState -> Bool
  phase-level-coherent s = case s.hs-state of
    HsStart -> key-level-rank s.key-level == 0
    HsRecvdCH -> key-level-rank s.key-level == 0
    HsSentHRR -> key-level-rank s.key-level == 0 && s.hrr-sent
    HsWaitFin -> key-level-rank s.key-level == 1
    HsConnected -> key-level-rank s.key-level == 2
    HsClosed -> key-level-rank s.key-level == 2
    HsAlert -> key-level-rank s.key-level <= 2

  tls-safety-ok :: TlsState -> Bool
  tls-safety-ok s =
    not s.app-data-before-fin
      && not s.replay-accepted
      && key-level-monotone s
      && phase-level-coherent s
      && s.nonce-seen <= 7

  -- =========================================================================
  -- 5. Abstract reference specification (`AbstractSecureChannel`) & refinement
  -- =========================================================================

  data AbsChanPhase where
    AbsHandshaking :: AbsChanPhase
    AbsOpen :: AbsChanPhase
    AbsFailed :: AbsChanPhase
    AbsClosed :: AbsChanPhase

  record AbsChannelState where
    abs-phase :: AbsChanPhase

  abs-connect :: AbsChannelState -> Option AbsChannelState
  abs-connect s = case s.abs-phase of
    AbsHandshaking -> Some (AbsChannelState { abs-phase = AbsOpen })
    _ -> None

  abs-fail :: AbsChannelState -> Option AbsChannelState
  abs-fail s = case s.abs-phase of
    AbsHandshaking -> Some (AbsChannelState { abs-phase = AbsFailed })
    AbsOpen -> Some (AbsChannelState { abs-phase = AbsFailed })
    _ -> None

  abs-close :: AbsChannelState -> Option AbsChannelState
  abs-close s = case s.abs-phase of
    AbsOpen -> Some (AbsChannelState { abs-phase = AbsClosed })
    _ -> None

  abs-stutter-terminal :: AbsChannelState -> Option AbsChannelState
  abs-stutter-terminal s = case s.abs-phase of
    AbsFailed -> Some s
    AbsClosed -> Some s
    _ -> None

  machine AbstractSecureChannel where
    state = AbsChannelState
    init = AbsChannelState { abs-phase = AbsHandshaking }
    actions = [abs-connect, abs-fail, abs-close, abs-stutter-terminal]
    max_states = 64

  -- | Abstraction map projecting `TlsState` onto `AbstractSecureChannel`.
  tls-view :: TlsState -> AbsChannelState
  tls-view s = case s.hs-state of
    HsStart -> AbsChannelState { abs-phase = AbsHandshaking }
    HsRecvdCH -> AbsChannelState { abs-phase = AbsHandshaking }
    HsSentHRR -> AbsChannelState { abs-phase = AbsHandshaking }
    HsWaitFin -> AbsChannelState { abs-phase = AbsHandshaking }
    HsConnected -> AbsChannelState { abs-phase = AbsOpen }
    HsAlert -> AbsChannelState { abs-phase = AbsFailed }
    HsClosed -> AbsChannelState { abs-phase = AbsClosed }

  -- | Handshake progress rank (strictly decreases on every concrete
  -- handshaking sub-step and every fresh 0-RTT nonce admission).
  hs-progress-rank :: TlsState -> Nat
  hs-progress-rank s = case s.hs-state of
    HsStart -> 5
    HsRecvdCH -> if s.hrr-sent then 2 else 4
    HsSentHRR -> 3
    HsWaitFin -> 1
    _ -> 0

  tls-measure :: TlsState -> Nat
  tls-measure s =
    let rem-nonces = saturating-sub 3 (nonce-popcount s.nonce-seen) in
    hs-progress-rank s * 4 + rem-nonces

  -- =========================================================================
  -- 6. Formal Machine M6 (`Tls13Machine`), temporal contracts & refinement
  -- =========================================================================

  machine Tls13Machine where
    state = TlsState
    init = tls-init
    actions = [tls-step-recv, tls-step-send, tls-step-zero-rtt, tls-step-fault, tls-step-close, tls-step-terminal]
    fair = [tls-step-recv, tls-step-send]
    max_states = 65536

  contract safety noAuthBypassOrReplay for Tls13Machine where
    always = (\s -> tls-safety-ok s)

  contract stability alertAbsorbing for Tls13Machine where
    stable = (\s -> not s.alert-entered || hs-state-eq s.hs-state HsAlert)

  contract safety alertNeverExits for Tls13Machine where
    always = (\s -> not s.alert-entered || hs-state-eq s.hs-state HsAlert)

  contract safety tlsDeadlockFree for Tls13Machine where
    deadlock_free = (True)

  contract liveness validHandshakeConnects for Tls13Machine where
    leads_to = (\s -> s.honest-peer && not (hs-state-eq s.hs-state HsConnected) && not (hs-state-eq s.hs-state HsClosed) && not (hs-state-eq s.hs-state HsAlert)) ~> (\s -> hs-state-eq s.hs-state HsConnected)
    assume = (\s -> s.honest-peer)

  refines Tls13Machine AbstractSecureChannel where
    view = tls-view
