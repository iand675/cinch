-- | Zero-allocation (`#[no-alloc]` steady-state) RFC 9000 / RFC 9001 / RFC 9002 /
-- RFC 9221 QUIC v1 connection state machine (`Net.Quic.Conn`).
--
-- Wires together:
--   * `Net.Tls.QuicBridge` + `Net.Quic.Packet` + `Net.Quic.Frame`:
--       - Initial / Handshake / 1-RTT key progression with real HKDF-SHA256
--         secret derivation and AEAD + Header Protection on every packet
--       - 1-RTT `KeyUpdate` (RFC 9001 §6 key-phase bit toggle with pre-staged
--         next TX/RX keys for zero-allocation key rotation)
--       - 0-RTT early data guarded by `AntiReplayFilter`
--       - Stateless Retry token handling (RFC 9001 §5.8 Retry Integrity Tag
--         verification + Initial re-keying)
--       - Strict RFC 9000 §8.1 3x anti-amplification limit
--         (`bytes_sent <= 3 * bytes_received` before address validation)
--   * `Net.Quic.AckMap` + `Net.Quic.Recovery` + `Net.Quic.Bbr` + `Net.Quic.Pacer`:
--       - Per-PN-space 256-bit ACK tracking & RFC 9000 ACK frame generation
--       - RFC 9002 RTT estimation, packet/time-threshold loss detection, PTO
--         tail-loss probing, BBRv2 cwnd & `SO_TXTIME` pacing
--   * `Net.Quic.Stream` + RFC 9221 unreliable `DATAGRAM` TX/RX rings
--   * RFC 9000 §9 Connection Migration:
--       - Peer address change detection on authenticated 1-RTT packets
--       - 8-byte `PATH_CHALLENGE` emission & `PATH_RESPONSE` verification
--       - Per-path 3x anti-amplification enforcement prior to path validation
--       - Active peer path switch strictly upon matching `PATH_RESPONSE`
module Net.Quic.Conn where

  import Crypto.Tls
  import Data.Bool
  import Data.Bytes
  import Data.Core
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Engine.Types
  import Net.Tls.Fast
  import Net.Tls.QuicBridge
  import Net.Quic.Types
  import Net.Quic.Varint
  import Net.Quic.Frame
  import Net.Quic.Packet
  import Net.Quic.AckMap
  import Net.Quic.Recovery (RecoveryState, AckOutcome, RttEstimator, pkt-status-in-flight, pkt-status-acked, pkt-status-lost, quic-initial-rtt-ns, rtt-estimator-loss-delay-ns, rtt-estimator-pto-base-ns, recovery-new-raw, recovery-destroy-raw, recovery-set-handshake-confirmed-raw, recovery-on-packet-sent-raw, recovery-on-ack-ranges-received-raw, recovery-pto-duration-ns-raw, recovery-loss-time-ns-raw, recovery-next-timeout-ns-raw, recovery-on-loss-timeout-raw, recovery-rtt-raw, recovery-bytes-in-flight-raw, recovery-largest-acked-pn-raw)
  import Net.Quic.Bbr
  import Net.Quic.Pacer
  import Net.Quic.Stream
  import Prim.Atomic

  -- Connection state codes
  export conn-state-initial, conn-state-handshake, conn-state-established
  export conn-state-draining, conn-state-closed

  -- Ingress / timeout return codes
  export quic-rx-ok, quic-rx-dropped, quic-rx-duplicate, quic-rx-proto-err, quic-rx-retry
  export quic-timeout-none, quic-timeout-loss, quic-timeout-pto, quic-timeout-idle, quic-timeout-drained

  -- Core POD handle & TX descriptor
  export QuicConn, quic-conn-empty, quic-conn-is-valid
  export QuicTxPacket, quic-tx-packet-empty, quic-tx-packet-ok

  -- Lifecycle & cold-path handshake/key operations
  export quic-conn-new-client, quic-conn-new-server, quic-conn-destroy
  export quic-conn-set-anti-replay, quic-conn-set-zero-rtt-key
  export quic-conn-set-addr-validated, quic-conn-set-retry-token
  export quic-conn-step-crypto, quic-conn-needs-crypto-step
  export quic-conn-key-update-refresh

  -- Hot-path #[no-alloc] datagram I/O, timers, KeyUpdate, streams, DATAGRAM, migration
  export quic-conn-on-datagram, quic-conn-poll-tx, quic-conn-poll-tx-capped, quic-conn-on-timeout
  export quic-conn-next-timeout-ns
  export quic-conn-initiate-key-update
  export quic-conn-close
  export quic-conn-open-stream, quic-conn-stream-find, quic-conn-stream-write, quic-conn-stream-read
  export quic-conn-stream-reset, quic-conn-stream-readable-bytes, quic-conn-stream-fin-reached
  export quic-conn-send-datagram, quic-conn-recv-datagram, quic-conn-datagram-rx-count

  -- Inspection & telemetry (#[no-alloc])
  export quic-conn-state, quic-conn-is-server, quic-conn-is-established, quic-conn-is-closed
  export quic-conn-handshake-confirmed, quic-conn-addr-validated
  export quic-conn-active-peer-addr, quic-conn-migrating-peer-addr, quic-conn-is-path-validating
  export quic-conn-migration-count, quic-conn-local-scid, quic-conn-remote-dcid
  export quic-conn-tx-key-phase, quic-conn-rx-key-phase, quic-conn-key-update-count
  export quic-conn-zero-rtt-accepted, quic-conn-zero-rtt-rejected
  export quic-conn-bytes-recv-unvalidated, quic-conn-bytes-sent-unvalidated, quic-conn-amp-blocks
  export quic-conn-pkts-tx, quic-conn-pkts-rx, quic-conn-retransmits
  export quic-conn-streams, quic-conn-recovery, quic-conn-bbr, quic-conn-mtu

  -- =========================================================================
  -- 0. Constants & #[no-alloc] helpers
  -- =========================================================================

  #[inline(always)] #[no-alloc] b-true :: Bool
  b-true = eq-u32 0 0

  #[inline(always)] #[no-alloc] b-false :: Bool
  b-false = eq-u32 0 1

  #[inline(always)] #[no-alloc] both :: Bool -> Bool -> Bool
  both a b = if a then b else b-false

  #[inline(always)] #[no-alloc] either :: Bool -> Bool -> Bool
  either a b = if a then b-true else b

  #[inline(always)] #[no-alloc] addr-at :: U64 -> U64 -> I64
  addr-at base off = wrapping-u64-to-i64 (wrapping-add-u64 base off)

  #[inline(always)] #[no-alloc] min-u64 :: U64 -> U64 -> U64
  min-u64 a b = if lt-u64 a b then a else b

  #[inline(always)] #[no-alloc] min-u32 :: U32 -> U32 -> U32
  min-u32 a b = if lt-u32 a b then a else b

  #[inline(always)] #[no-alloc] conn-state-initial :: U8
  conn-state-initial = 0
  #[inline(always)] #[no-alloc] conn-state-handshake :: U8
  conn-state-handshake = 1
  #[inline(always)] #[no-alloc] conn-state-established :: U8
  conn-state-established = 2
  #[inline(always)] #[no-alloc] conn-state-draining :: U8
  conn-state-draining = 3
  #[inline(always)] #[no-alloc] conn-state-closed :: U8
  conn-state-closed = 4

  #[inline(always)] #[no-alloc] quic-rx-ok :: U8
  quic-rx-ok = 0
  #[inline(always)] #[no-alloc] quic-rx-dropped :: U8
  quic-rx-dropped = 1
  #[inline(always)] #[no-alloc] quic-rx-duplicate :: U8
  quic-rx-duplicate = 2
  #[inline(always)] #[no-alloc] quic-rx-proto-err :: U8
  quic-rx-proto-err = 3
  #[inline(always)] #[no-alloc] quic-rx-retry :: U8
  quic-rx-retry = 4

  #[inline(always)] #[no-alloc] quic-timeout-none :: U8
  quic-timeout-none = 0
  #[inline(always)] #[no-alloc] quic-timeout-loss :: U8
  quic-timeout-loss = 1
  #[inline(always)] #[no-alloc] quic-timeout-pto :: U8
  quic-timeout-pto = 2
  #[inline(always)] #[no-alloc] quic-timeout-idle :: U8
  quic-timeout-idle = 3
  #[inline(always)] #[no-alloc] quic-timeout-drained :: U8
  quic-timeout-drained = 4

  #[inline(always)] #[no-alloc] mix64 :: U64 -> U64
  mix64 x =
    let z0 = wrapping-add-u64 x 0x9e3779b97f4a7c15 in
    let z1 = wrapping-mul-u64 (bit-xor-u64 z0 (wrapping-shr-u64 z0 30)) 0xbf58476d1ce4e5b9 in
    let z2 = wrapping-mul-u64 (bit-xor-u64 z1 (wrapping-shr-u64 z1 27)) 0x94d049bb133111eb in
    bit-xor-u64 z2 (wrapping-shr-u64 z2 31)

  #[no-alloc]
  copy-raw :: I64 -> I64 -> U32 ->{MVar} Unit
  copy-raw dst src rem =
    if eq-u32 rem 0 then ()
    else if ge-u32 rem 8 then
      let v = raw-load-u64 src in
      let _ = raw-store-u64 dst v in
      copy-raw (wrapping-add-i64 dst 8) (wrapping-add-i64 src 8) (wrapping-sub-u32 rem 8)
    else
      let b = raw-load-u8 src in
      let _ = raw-store-u8 dst b in
      copy-raw (wrapping-add-i64 dst 1) (wrapping-add-i64 src 1) (wrapping-sub-u32 rem 1)

  -- =========================================================================
  -- 1. Core POD Handle (`QuicConn`) & Slab Layout (64 KiB DMA slab)
  -- =========================================================================

  #[repr(C, value)]
  record QuicConn where
    qc-base :: U64

  #[inline(always)] #[no-alloc] quic-conn-empty :: Unit -> QuicConn
  quic-conn-empty _ = QuicConn 0

  #[inline(always)] #[no-alloc] quic-conn-is-valid :: QuicConn -> Bool
  quic-conn-is-valid c = ne-u64 c.qc-base 0

  #[repr(C, value)]
  record QuicTxPacket where
    tx-peer-addr :: U64
    tx-release-ns :: U64
    tx-len :: U32
    tx-pkt-type :: U8
    tx-blocked-amp :: U8
    tx-blocked-pace :: U8
    tx-ok :: U8

  #[inline(always)] #[no-alloc] quic-tx-packet-empty :: Unit -> QuicTxPacket
  quic-tx-packet-empty _ = QuicTxPacket 0 0 0 pkt-type-code-invalid 0 0 0

  #[inline(always)] #[no-alloc] quic-tx-packet-ok :: QuicTxPacket -> Bool
  quic-tx-packet-ok p = ne-u8 p.tx-ok 0

  #[inline(always)] #[no-alloc] qc-slab-size :: U64
  qc-slab-size = 65536

