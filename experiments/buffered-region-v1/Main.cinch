-- | Declare actual both-effect buffered compositions while preserving independent IO-only sink operations.
module Main where
  import Effect.Buffered
  import Effect.Buffered.Core
  import Effect.Buffered.Reader
  import Effect.Buffered.Writer
  import Effect.Scanner
  import Effect.Scanner.Split
  import Effect.Io
  import Data.Bytes
  import Data.Bool
  import Data.Int
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result

  -- | A caller's genuine read callback keeps both I/O and mutation in the same region.
  accept-live :: forall (r :: Region). (Nat ->{IO r, Mut r} (ReadEvent, BufferSource r)) -> BufferSource r
  accept-live step = buffer-source-with-mutation step

  -- | The ordinary reader consumes a live source without weakening its callback's row.
  consume-reader :: forall (r :: Region). using (io :: Io r) => BufferSource r -> Nat ->{IO r, Mut r} (ReadEvent, BufferedReader r)
  consume-reader source wanted = buffered-read (buffered-reader source) wanted

  -- | The ordinary writer's ReaderFrom route accepts the same live source and preserves advanced handles.
  consume-writer :: forall (r :: Region). using (io :: Io r) => BufferedWriter r -> BufferSource r ->{IO r, Mut r} (TransferEvent, BufferedWriter r, BufferSource r)
  consume-writer writer source = buffered-read-from writer source

  -- | The ordinary scanner advances the live source under the actual combined effect row.
  consume-scanner :: forall (r :: Region). using (io :: Io r) => BufferSource r ->{IO r, Mut r} (Bool, Scanner r)
  consume-scanner source = scanner-next (scanner source)

  -- | A delegated sink transfer cannot narrow the supplied reader callback to IO alone.
  accept-reader-from :: forall (r :: Region). BufferSink r -> ((Nat ->{IO r, Mut r} ReadEvent) ->{IO r, Mut r} (TransferEvent, BufferSink r)) -> BufferSink r
  accept-reader-from sink transfer = buffer-sink-with-transfer sink transfer

  -- | A normal byte write remains available in an IO-only context.
  write-only :: forall (r :: Region). using (io :: Io r) => BufferedWriter r -> Bytes ->{IO r} (WriteEvent, BufferedWriter r)
  write-only writer input = buffered-write writer input

  -- | One-layer flushing also retains its IO-only contract.
  flush-only :: forall (r :: Region). using (io :: Io r) => BufferedWriter r ->{IO r} (Option BufferError, BufferedWriter r)
  flush-only writer = buffered-flush writer

  -- | This initial gate checks all declarations without claiming runtime adaptation or promotion.
  main :: Int
  main = 0
