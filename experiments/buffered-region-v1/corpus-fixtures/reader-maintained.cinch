  -- | Run independent observations 1 through 12 without a deep generated let spine.
  run-group0 :: forall (r :: Region). using (io :: Io r) => Unit ->{IO r, Mut r} Int
  run-group0 unit =
    let result0 = tracecase0 () in if not (result0 == 0) then result0
    else let result1 = tracecase1 () in if not (result1 == 0) then result1
    else let result2 = tracecase2 () in if not (result2 == 0) then result2
    else let result3 = tracecase3 () in if not (result3 == 0) then result3
    else let result4 = tracecase4 () in if not (result4 == 0) then result4
    else let result5 = tracecase5 () in if not (result5 == 0) then result5
    else let result6 = tracecase6 () in if not (result6 == 0) then result6
    else let result7 = tracecase7 () in if not (result7 == 0) then result7
    else let result8 = tracecase8 () in if not (result8 == 0) then result8
    else let result9 = tracecase9 () in if not (result9 == 0) then result9
    else let result10 = tracecase10 () in if not (result10 == 0) then result10
    else let result11 = tracecase11 () in if not (result11 == 0) then result11
    else 0

  -- | Print the full first mismatch and normalize every failing process exit.
  main :: Unit ->{IO r, Mut r} Int
  main unit = with (io = newIO ()) in
    let result0 = run-group0 () in if not (result0 == 0) then report-failure result0
    else 0
