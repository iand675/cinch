  -- | Run independent observations 1 through 16 without a deep generated let spine.
  run-group0 :: forall (r :: Region). using (io :: Io r) => Unit ->{IO r, Mut r} Int
  run-group0 unit =
    let result0 = batchcase0 () in if not (result0 == 0) then result0
    else let result1 = batchcase1 () in if not (result1 == 0) then result1
    else let result2 = batchcase2 () in if not (result2 == 0) then result2
    else let result3 = batchcase3 () in if not (result3 == 0) then result3
    else let result4 = batchcase4 () in if not (result4 == 0) then result4
    else let result5 = batchcase5 () in if not (result5 == 0) then result5
    else let result6 = batchcase6 () in if not (result6 == 0) then result6
    else let result7 = batchcase7 () in if not (result7 == 0) then result7
    else let result8 = batchcase8 () in if not (result8 == 0) then result8
    else let result9 = batchcase9 () in if not (result9 == 0) then result9
    else let result10 = batchcase10 () in if not (result10 == 0) then result10
    else let result11 = batchcase11 () in if not (result11 == 0) then result11
    else let result12 = batchcase12 () in if not (result12 == 0) then result12
    else let result13 = batchcase13 () in if not (result13 == 0) then result13
    else let result14 = batchcase14 () in if not (result14 == 0) then result14
    else let result15 = batchcase15 () in if not (result15 == 0) then result15
    else 0

  -- | Print the full first mismatch and normalize every failing process exit.
  main :: Unit ->{IO r, Mut r} Int
  main unit = with (io = newIO ()) in
    let result0 = run-group0 () in if not (result0 == 0) then report-failure result0
    else 0
