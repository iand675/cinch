-- | Execute fixed public HKDF expectations and preserve complete output comparisons.
module Main where
  import Crypto.Hkdf
  import Data.Bool
  import Data.Bytes
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String
  import Text.Digest
  import Text.Hex

  -- | Compare every output octet under explicit checked byte-buffer bounds.
  same-from :: Bytes -> Bytes -> Nat -> Bool
  same-from left right index =
    if index < bytes-len left && index < bytes-len right then
      bytes-get left index == bytes-get right index && same-from left right (index + 1)
    else index == bytes-len left && index == bytes-len right

  -- | Reject all provider errors and compare the complete independently expected byte string.
  result-is :: Result (HkdfError Unit) Bytes -> Bytes -> Bool
  result-is actual expected = case actual of
    Err error -> False
    Ok output -> same-from output expected 0

  -- | Preserve absent and explicitly empty fixed salts without an unchecked parse fallback.
  decode-salt :: Option String -> Result HexError (Option Bytes)
  decode-salt salt = case salt of
    None -> Ok None
    Some input -> case hex-decode input of
      Err error -> Err error
      Ok output -> Ok (Some output)

  -- | Adapt the real pure digest to the generic callback contract.
  generic-hash :: Digest -> Bytes -> Result Unit Bytes
  generic-hash selector input = Ok (digest-bytes selector input)

  -- | Adapt the real dedicated HMAC primitive to the direct provider contract.
  direct-hmac :: Bytes -> Bytes -> Result Unit Bytes
  direct-hmac key input = Ok (hmac-sha256 key input)

  -- | Check all three direct-provider operations only for their actual SHA256 implementation.
  direct-row :: Digest -> Bytes -> Option Bytes -> Bytes -> Bytes -> Bytes -> Nat -> Bool
  direct-row selector secret salt info prk output count = case selector of
    DigestSha256 ->
      result-is (hkdf-extract-hmac (hkdf-digest-size selector) direct-hmac secret salt) prk &&
      result-is (hkdf-expand-hmac (hkdf-digest-size selector) direct-hmac prk info count) output &&
      result-is (hkdf-key-hmac (hkdf-digest-size selector) direct-hmac secret salt info count) output
    _ -> True

  -- | Compare native conveniences, generic hashing and applicable direct HMAC against fixed complete keys.
  decoded-row :: Digest -> Bytes -> Option Bytes -> Bytes -> Bytes -> Bytes -> Nat -> Bool
  decoded-row selector secret salt info prk output count =
    result-is (hkdf-extract selector secret salt) prk &&
    result-is (hkdf-expand selector prk info count) output &&
    result-is (hkdf-key selector secret salt info count) output &&
    result-is (hkdf-extract-with (hkdf-digest-hash selector) (generic-hash selector) secret salt) prk &&
    result-is (hkdf-expand-with (hkdf-digest-hash selector) (generic-hash selector) prk info count) output &&
    result-is (hkdf-key-with (hkdf-digest-hash selector) (generic-hash selector) secret salt info count) output &&
    direct-row selector secret salt info prk output count

  -- | Refuse a malformed fixed fixture before invoking any cryptographic operation.
  row :: Digest -> String -> Option String -> String -> String -> String -> Nat -> Bool
  row selector secret salt info prk output count = case hex-decode secret of
    Err error -> False
    Ok input -> case decode-salt salt of
      Err error -> False
      Ok key -> case hex-decode info of
        Err error -> False
        Ok context -> case hex-decode prk of
          Err error -> False
          Ok extracted -> case hex-decode output of
            Err error -> False
            Ok expected -> decoded-row selector input key context extracted expected count

  -- | Check unchanged fixed vector rfc5869-sdk-1 through all applicable public routes.
  rfc1 :: Unit -> Bool
  rfc1 unit = row DigestSha256 "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b" (Some "000102030405060708090a0b0c") "f0f1f2f3f4f5f6f7f8f9" "077709362c2e32df0ddc3f0dc47bba6390b6c73bb50f9c3122ec844ad7c2b3e5" "3cb25f25faacd57a90434f64d0362f2a2d2d0a90cf1a5a4c5db02d56ecc4c5bf34007208d5b887185865" 42

  -- | Check unchanged fixed vector rfc5869-sdk-2 through all applicable public routes.
  rfc2 :: Unit -> Bool
  rfc2 unit = row DigestSha256 "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f" (Some "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeaf") "b0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecfd0d1d2d3d4d5d6d7d8d9dadbdcdddedfe0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff" "06a6b88c5853361a06104c9ceb35b45cef760014904671014a193f40c15fc244" "b11e398dc80327a1c8e7f78c596a49344f012eda2d4efad8a050cc4c19afa97c59045a99cac7827271cb41c65e590e09da3275600c2f09b8367793a9aca3db71cc30c58179ec3e87c14c01d5c1f3434f1d87" 82

  -- | Check unchanged fixed vector rfc5869-sdk-3 through all applicable public routes.
  rfc3 :: Unit -> Bool
  rfc3 unit = row DigestSha256 "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b" (Some "") "" "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04" "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8" 42

  -- | Check unchanged fixed vector rfc5869-sdk-4 through all applicable public routes.
  rfc4 :: Unit -> Bool
  rfc4 unit = row DigestSha256 "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b" None "" "19ef24a32c717b167f33a91d6f648bdf96596776afdb6377ac434c1c293ccb04" "8da4e775a563c18f715f802a063c5a31b8a11f5c5ee1879ec3454e5f3c738d2d9d201395faa4b61a96c8" 42

  -- | Check unchanged fixed vector rfc5869-sdk-5 through all applicable public routes.
  rfc5 :: Unit -> Bool
  rfc5 unit = row DigestSha1 "0b0b0b0b0b0b0b0b0b0b0b" (Some "000102030405060708090a0b0c") "f0f1f2f3f4f5f6f7f8f9" "9b6c18c432a7bf8f0e71c8eb88f4b30baa2ba243" "085a01ea1b10f36933068b56efa5ad81a4f14b822f5b091568a9cdd4f155fda2c22e422478d305f3f896" 42

  -- | Check unchanged fixed vector rfc5869-sdk-6 through all applicable public routes.
  rfc6 :: Unit -> Bool
  rfc6 unit = row DigestSha1 "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f404142434445464748494a4b4c4d4e4f" (Some "606162636465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9fa0a1a2a3a4a5a6a7a8a9aaabacadaeaf") "b0b1b2b3b4b5b6b7b8b9babbbcbdbebfc0c1c2c3c4c5c6c7c8c9cacbcccdcecfd0d1d2d3d4d5d6d7d8d9dadbdcdddedfe0e1e2e3e4e5e6e7e8e9eaebecedeeeff0f1f2f3f4f5f6f7f8f9fafbfcfdfeff" "8adae09a2a307059478d309b26c4115a224cfaf6" "0bd770a74d1160f7c9f12cd5912a06ebff6adcae899d92191fe4305673ba2ffe8fa3f1a4e5ad79f3f334b3b202b2173c486ea37ce3d397ed034c7f9dfeb15c5e927336d0441f4c4300e2cff0d0900b52d3b4" 82

  -- | Check unchanged fixed vector rfc5869-sdk-7 through all applicable public routes.
  rfc7 :: Unit -> Bool
  rfc7 unit = row DigestSha1 "0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b" (Some "") "" "da8c8a73c7fa77288ec6f5e7c297786aa0d32d01" "0ac1af7002b3d761d1e55298da9d0506b9ae52057220a306e07b6b87e8df21d0ea00033de03984d34918" 42

  -- | Check unchanged fixed vector rfc5869-sdk-8 through all applicable public routes.
  rfc8 :: Unit -> Bool
  rfc8 unit = row DigestSha1 "0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c0c" None "" "2adccada18779e7c2077ad2eb19d3f3e731385dd" "2c91117204d745f3500d636a62f64f0ab3bae548aa53d423b0d1f27ebba6f5e5673a081d70cce7acfc48" 42

  -- | Return the first failing fixed-vector index; zero means all sixty complete output observations agree.
  main :: Int
  main =
    if not (rfc1 ()) then 1
    else if not (rfc2 ()) then 2
    else if not (rfc3 ()) then 3
    else if not (rfc4 ()) then 4
    else if not (rfc5 ()) then 5
    else if not (rfc6 ()) then 6
    else if not (rfc7 ()) then 7
    else if not (rfc8 ()) then 8
    else 0
