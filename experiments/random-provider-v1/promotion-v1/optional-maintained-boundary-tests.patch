+//! Public random-byte boundary and ownership checks using actual OS entropy.
+
+use crate::{abi, block, heap, platform, rc};
+
+/// One live owned result, released through normal reference counting on exit.
+struct OwnedBytes(i64);
+
+impl OwnedBytes {
+    /// Draw a fresh public result and require a valid owned Bytes header.
+    fn draw(len: i64) -> Self {
+        let word = platform::cinch_random_bytes(len);
+        assert!(word > 0 && word & 1 == 0, "entropy result: {word}");
+        let owned = Self(word);
+        // SAFETY: the positive aligned result is the live result of this ABI.
+        let header = unsafe { block::read_header(word as usize as *const u8) };
+        assert_eq!(block::kind(header), block::KIND_BYTES);
+        assert_eq!(block::rc(header), block::RC_FRESH);
+        assert_eq!(unsafe { abi::cinch_bytes_len(word) }, len);
+        owned
+    }
+
+    /// Release through the raw buffer deallocator and disarm the owned guard.
+    fn free_raw(mut self) {
+        let word = std::mem::replace(&mut self.0, 0);
+        // SAFETY: this guard exclusively owns the fresh result, with no children.
+        unsafe { abi::cinch_free(word) };
+    }
+}
+
+impl Drop for OwnedBytes {
+    /// Release the guard's owned result, including during assertion unwinding.
+    fn drop(&mut self) {
+        // SAFETY: the guard retains exactly one owned reference or the null word.
+        unsafe { rc::cinch_drop(self.0) };
+    }
+}
+
+/// Invalid signed lengths return the exact named error without a header block.
+#[test]
+fn negative_lengths_return_invalid_argument_without_allocating() {
+    let before = heap::thread_header_blocks();
+    let freed = heap::thread_freed();
+    assert_eq!(platform::cinch_random_bytes(-1), -platform::INVALID_ARGUMENT);
+    assert_eq!(platform::cinch_random_bytes(i64::MIN), -platform::INVALID_ARGUMENT);
+    assert_eq!(heap::thread_header_blocks(), before);
+    assert_eq!(heap::thread_freed(), freed);
+    assert_eq!(rc::cinch_exit_check(0), 0);
+}
+
+/// Real draws retain length, distinct mutable ownership, and both release paths.
+#[test]
+fn real_public_draws_have_owned_bytes_and_release_every_result() {
+    for len in [0, 1, 16, 255, 256, 257, 4096, 1024 * 1024] {
+        let freed = heap::thread_freed();
+        let first = OwnedBytes::draw(len);
+        let second = OwnedBytes::draw(len);
+        assert_ne!(first.0, second.0, "results must own distinct header blocks");
+        if len >= 16 {
+            let differs = (0..16).any(|i| unsafe {
+                abi::cinch_bytes_get(first.0, i) != abi::cinch_bytes_get(second.0, i)
+            });
+            assert!(differs, "freshness smoke check for length {len}");
+        }
+        if len > 0 {
+            // SAFETY: both fresh buffers are live and index zero is in range.
+            unsafe {
+                let before = abi::cinch_bytes_get(second.0, 0);
+                let marker = (before + 1) & 255;
+                abi::cinch_bytes_set(first.0, 0, marker);
+                assert_eq!(abi::cinch_bytes_get(first.0, 0), marker);
+                assert_eq!(abi::cinch_bytes_get(second.0, 0), before);
+                assert!((0..=255).contains(&abi::cinch_bytes_get(first.0, len - 1)));
+            }
+        }
+        first.free_raw();
+        drop(second);
+        assert_eq!(heap::thread_freed() - freed, 2, "length {len}");
+    }
+    assert_eq!(rc::cinch_exit_check(0), 0);
+}
+
+/// Provider errors retain the structured public error vocabulary after mapping.
+#[cfg(target_os = "linux")]
+#[test]
+fn linux_provider_errors_keep_named_error_mapping() {
+    for (errno, code) in [
+        (1, platform::PERMISSION_DENIED),
+        (5, platform::IO_ERROR),
+        (13, platform::PERMISSION_DENIED),
+        (22, platform::INVALID_ARGUMENT),
+        (38, platform::IO_ERROR),
+    ] {
+        let error = std::io::Error::from_raw_os_error(errno);
+        assert_eq!(-platform::io_code(&error), -code, "errno {errno}");
+    }
+    assert_eq!(rc::cinch_exit_check(0), 0);
+}
