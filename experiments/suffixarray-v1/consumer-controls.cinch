-- | Snapshot aliases, typed callback refusals, retained subjects and genuine IO/mutation search effects.
module Main where
  import Data.Index.SuffixArray
  import Data.Bool
  import Data.Bytes
  import Data.List
  import Data.Machine
  import Data.Mutable.Var
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String
  import Effect.Process

  -- | Compare a complete result without trusting a count or fingerprint alone.
  same :: List Nat -> List Nat -> Bool
  same first second = case first of
    Nil -> case second of Nil -> True; other -> False
    Cons a more -> case second of
      Nil -> False
      Cons b rest -> if a == b then same more rest else False

  -- | Inspect all public range endpoints without depending on a private constructor.
  same-ranges :: List SuffixMatch -> List (Nat, Nat) -> Bool
  same-ranges found expected = case found of
    Nil -> case expected of Nil -> True; other -> False
    Cons value more -> case expected of
      Nil -> False
      Cons pair rest -> case pair of
        (start, end) -> if suffix-match-start value == start && suffix-match-end value == end then same-ranges more rest else False

  -- | Observe one checked byte of a clone without exposing an index backing reference.
  first-byte :: Bytes -> Nat
  first-byte source = if bytes-len source > 0 then bytes-get source 0 else 256

  -- | Mutate the original and two returned clones, retaining an independent index and third clone.
  aliases :: Unit -> Bool
  aliases unit = let original = bytes-from-list [98,97,110,97,110,97] in
    case suffix-index original of
      Err failure -> False
      Ok index ->
        let first = suffix-index-bytes index in let second = suffix-index-bytes index in
        let a = if bytes-len original > 0 then bytes-set original 0 120 else () in
        let b = if bytes-len first > 0 then bytes-set first 0 121 else () in
        let c = if bytes-len second > 0 then bytes-set second 0 122 else () in
        let fresh = suffix-index-bytes index in
        first-byte original == 120 && first-byte first == 121 && first-byte second == 122
          && first-byte fresh == 98 && same (suffix-index-lookup index (bytes-from-list [98,97,110]) AllSuffixMatches) [0]
          && same (suffix-index-lookup index (bytes-from-list [97,110,97]) (AtMostSuffixMatches 1267650600228229401496703205376)) [3,1]

  -- | Return a next empty range, including the logical end.
  empty-search :: SuffixIndex -> Nat -> Result Unit (Option SuffixMatch)
  empty-search index cursor = case suffix-match index cursor cursor of
    Err failure -> Err ()
    Ok found -> Ok (Some found)

  -- | Reject a callback with a typed payload after one accepted nonempty match.
  failing-search :: SuffixIndex -> Nat -> Result Nat (Option SuffixMatch)
  failing-search index cursor = if cursor == 0 then
    case suffix-match index 0 1 of Err failure -> Err 99; Ok found -> Ok (Some found)
    else Err 42

  -- | Deliberately return an earlier valid range so the driver must refuse overlap.
  backwards-search :: SuffixIndex -> Nat -> Result Unit (Option SuffixMatch)
  backwards-search index cursor = case suffix-match index 0 1 of
    Err failure -> Err ()
    Ok found -> Ok (Some found)

  -- | Return a valid range from a larger index, which the current subject must reject.
  foreign-range :: SuffixIndex -> Nat -> Result Unit (Option SuffixMatch)
  foreign-range ignored cursor = case suffix-index (bytes-from-list [1,2,3]) of
    Err failure -> Err ()
    Ok large -> case suffix-match large 0 3 of Err failure -> Err (); Ok found -> Ok (Some found)

  -- | Pin empty-input output, UTF8 replacement progress and partial typed failures.
  callbacks :: Unit -> Bool
  callbacks unit = case suffix-index (bytes-from-list [255,195,169,97]) of
    Err failure -> False
    Ok index ->
      let empty = case suffix-index-find-all index empty-search AllSuffixMatches of
        Err failure -> False
        Ok found -> same-ranges found [(0,0),(1,1),(3,3),(4,4)] in
      let failed = case suffix-index-find-all index failing-search AllSuffixMatches of
        Err (SuffixCallbackFailed code accepted) -> code == 42 && same-ranges accepted [(0,1)]
        other -> False in
      let backwards = case suffix-index-find-all index backwards-search AllSuffixMatches of
        Err (SuffixMatchBeforeCursor cursor start accepted) -> cursor == 1 && start == 0 && same-ranges accepted [(0,1)]
        other -> False in
      let reversed = case suffix-match index 2 1 of Err (SuffixSpanReversed start end) -> start == 2 && end == 1; other -> False in
      empty && failed && backwards && reversed

  -- | Validate a range made for another subject and preserve the empty accepted prefix.
  cross-index :: Unit -> Bool
  cross-index unit = case suffix-index (bytes-from-list [1]) of
    Err failure -> False
    Ok index -> case suffix-index-find-all index foreign-range AllSuffixMatches of
      Err (SuffixInvalidMatch (SuffixSpanPastEnd end size) accepted) -> end == 3 && size == 1 && same-ranges accepted []
      other -> False

  -- | Read an exact descending suffix order without allocating on recursive unwind.
  descending :: List Nat -> Nat -> Bool
  descending found expected = if expected > 0 then (case found of
    Nil -> False
    Cons value more -> value == expected - 1 && descending more (expected - 1))
    else case found of Nil -> True; other -> False

  -- | Stress long equal prefixes, tail construction and full overlapping output under an 8 MiB stack.
  deep :: Unit -> Bool
  deep unit = case suffix-index (bytes-new 4096) of
    Err failure -> False
    Ok index -> descending (suffix-index-lookup index (bytes-from-list [0]) AllSuffixMatches) 4096

  -- | Perform genuine IO and mutation, retaining the sealed subject beyond the callback.
  observed-search :: forall (r :: Region) (s :: Region). Io r -> Var s Nat -> Var s (Option SuffixIndex) -> SuffixIndex -> Nat ->{IO r, Mut s} Result Unit (Option SuffixMatch)
  observed-search capability count retained index cursor = with (io = capability) in
    let before = var-read count in let incremented = var-write count (before + 1) in
    let kept = var-write retained (Some index) in
    let output = ioWrite (string-to-bytes "c ") in empty-search index cursor

  -- | Reuse one closure with fresh scan progress while preserving its shared callback state.
  effects :: forall (r :: Region) (s :: Region). Io r ->{IO r, Mut s} Bool
  effects capability = case suffix-index (bytes-from-list [97,98,99]) of
    Err failure -> False
    Ok index ->
      let count = var-new 0 in let retained = var-new (None :: Option SuffixIndex) in
      let callback = observed-search capability count retained in
      let zero = suffix-index-find-all index callback (AtMostSuffixMatches 0) in let n0 = var-read count in
      let first = suffix-index-find-all index callback (AtMostSuffixMatches 2) in let n1 = var-read count in
      let second = suffix-index-find-all index callback (AtMostSuffixMatches 2) in let n2 = var-read count in
      let held = var-read retained in
      let a = case zero of Ok found -> same-ranges found []; Err failure -> False in
      let b = case first of Ok found -> same-ranges found [(0,0),(1,1)]; Err failure -> False in
      let c = case second of Ok found -> same-ranges found [(0,0),(1,1)]; Err failure -> False in
      let d = case held of None -> False; Some saved -> first-byte (suffix-index-bytes saved) == 97 in
      a && b && c && d && n0 == 0 && n1 == 2 && n2 == 4

  -- | Record even the callback whose empty result is suppressed after a nonempty match.
  observed-suppression :: forall (r :: Region) (s :: Region). Io r -> Var s Nat -> SuffixIndex -> Nat ->{IO r, Mut s} Result Unit (Option SuffixMatch)
  observed-suppression capability count index cursor = with (io = capability) in
    let before = var-read count in let incremented = var-write count (before + 1) in
    let output = ioWrite (string-to-bytes "s ") in
    let end = if cursor == 0 then 1 else cursor in
    case suffix-match index cursor end of Err failure -> Err (); Ok found -> Ok (Some found)

  -- | Count suppressed observations without counting them toward the accepted-result limit.
  suppression :: forall (r :: Region) (s :: Region). Io r ->{IO r, Mut s} Bool
  suppression capability = case suffix-index (bytes-from-list [97,98,99]) of
    Err failure -> False
    Ok index ->
      let count = var-new 0 in
      let found = suffix-index-find-all index (observed-suppression capability count) (AtMostSuffixMatches 2) in
      let calls = var-read count in
      case found of Err failure -> False; Ok accepted -> calls == 3 && same-ranges accepted [(0,1),(2,2)]

  -- | Select one bounded assertion; the effects assertion must print exactly four callback markers.
  main :: Unit ->{IO r, Mut s} Int
  main unit = let capability = newIO () in with (io = capability) in case process-args () of
    Ok (Cons mode Nil) ->
      if mode == "aliases" then (if aliases () then 0 else 1)
      else if mode == "callbacks" then (if callbacks () then 0 else 2)
      else if mode == "cross" then (if cross-index () then 0 else 3)
      else if mode == "deep" then (if deep () then 0 else 4)
      else if mode == "effects" then (let accepted = effects capability in if accepted then 0 else 5)
      else if mode == "suppression" then (let accepted = suppression capability in if accepted then 0 else 8)
      else 6
    other -> 7
