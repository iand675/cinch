module Main where
  import Effect.Index.SuffixArray
  import Data.Index.SuffixArray
  import Effect.Stream

  -- | Expose the source one byte at a time, including through the length field.
  one-byte-reader :: forall r. using (io :: Io r) => ByteReader r -> ByteReader r
  one-byte-reader source = stream-reader (\n -> case stream-read source 1 of
    (result, next) -> (result, one-byte-reader next))

  -- | Check every offered leading byte against a separate wire fixture.
  -- After the last accepted byte, switch to a detectable empty buffer sink.
  checking-writer :: forall r. using (io :: Io r) => Bytes -> Nat -> ByteWriter r
  checking-writer expected offset = if offset < bytes-len expected then
    stream-writer (\offer -> if 0 < bytes-len offer && bytes-get offer 0 == bytes-get expected offset then
      (Ok 1, checking-writer expected (offset + 1))
      else (Err (StreamClosed "unexpected byte"), writer-discard))
    else writer-buffer

  transfers :: forall r. using (io :: Io r) => SuffixIndex ->{IO r} Bool
  transfers index =
    let expected = bytes-from-u8s [83,73,88,1,0,0,0,0,0,0,0,3,255,0,255] in
    let short = case suffix-index-write (checking-writer expected 0) index of
          (Ok 15, next) -> case writer-bytes next of Some bytes -> bytes-len bytes == 0; None -> False
          _ -> False in
    let stopped = case suffix-index-write (stream-writer (\offer -> (Ok 0, writer-buffer))) index of
          (Err (StreamShortWrite 4 0), next) -> case writer-bytes next of Some _ -> True; None -> False
          _ -> False in
    let fragmented = case suffix-index-read 3 (one-byte-reader (reader-from-bytes expected)) of
          (Ok restored, next) -> case suffix-index-lookup restored (bytes-from-u8s [255]) AllSuffixMatches of
            Cons 2 (Cons 0 Nil) -> True
            _ -> False
          _ -> False in
    short && stopped && fragmented

  boundaries :: forall r. using (io :: Io r) => Unit ->{IO r} Bool
  boundaries unit =
    let framed = bytes-from-u8s [83,73,88,1,0,0,0,0,0,0,0,1,255,77] in
    let limited = case suffix-index-read 0 (reader-from-bytes framed) of
          (Err (SuffixSnapshotLimit 0 1), next) -> case stream-read-exact next 2 of
            (Ok tail, end) -> eq-i64 (bytes-compare tail (bytes-from-u8s [255,77])) 0
            _ -> False
          _ -> False in
    let trailing = case suffix-index-read 1 (reader-from-bytes framed) of
          (Ok index, next) -> case stream-read-exact next 1 of
            (Ok tail, end) -> eq-i64 (bytes-compare tail (bytes-from-u8s [77])) 0
            _ -> False
          _ -> False in
    let overflow = case suffix-index-read 0 (reader-from-bytes (bytes-from-u8s [83,73,88,1,128,0,0,0,0,0,0,0])) of
          (Err (SuffixLengthOverflow word), next) -> True
          _ -> False in
    let truncated = case suffix-index-read 1 (reader-from-bytes (bytes-from-u8s [83,73,88,1,0,0,0,0,0,0,0,1])) of
          (Err (SuffixSnapshotIo (StreamUnexpectedEnd 1 0)), next) -> True
          _ -> False in
    limited && trailing && overflow && truncated

  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in
    case suffix-index (bytes-from-u8s [255,0,255]) of
      Err error -> 1
      Ok index -> case suffix-index-write writer-buffer index of
        (Ok 15, sink) -> case writer-bytes sink of
          Some bytes -> case suffix-index-read 3 (reader-from-bytes bytes) of
            (Ok restored, end) -> if eq-i64 (bytes-compare (suffix-index-bytes restored) (suffix-index-bytes index)) 0 && boundaries () && transfers restored then 0 else 2
            _ -> 3
          None -> 4
        _ -> 5
