  -- | Select one bounded independent input, keeping every poison quarantine separate.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in case process-args () of
    Ok (Cons number Nil) -> if number == "0" then case0 () else if number == "1" then case1 () else if number == "2" then case2 () else if number == "3" then case3 () else if number == "4" then case4 () else if number == "5" then case5 () else if number == "6" then case6 () else if number == "7" then case7 () else 101
    other -> 102
