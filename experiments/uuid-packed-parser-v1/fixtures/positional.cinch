  -- | Exact wrapper/position mappings derived from their documented punctuation layout.
  forms :: List Form
  forms = [Form "f81d4fae7dec11d0a76500a0c91e6bf6" [Position 0 0, Position 1 1, Position 2 2, Position 3 3, Position 4 4, Position 5 5, Position 6 6, Position 7 7, Position 8 9, Position 9 10, Position 10 11, Position 11 12, Position 12 14, Position 13 15, Position 14 16, Position 15 17, Position 16 19, Position 17 20, Position 18 21, Position 19 22, Position 20 24, Position 21 25, Position 22 26, Position 23 27, Position 24 28, Position 25 29, Position 26 30, Position 27 31, Position 28 32, Position 29 33, Position 30 34, Position 31 35],
    Form "f81d4fae-7dec-11d0-a765-00a0c91e6bf6" [Position 0 0, Position 1 1, Position 2 2, Position 3 3, Position 4 4, Position 5 5, Position 6 6, Position 7 7, Position 9 9, Position 10 10, Position 11 11, Position 12 12, Position 14 14, Position 15 15, Position 16 16, Position 17 17, Position 19 19, Position 20 20, Position 21 21, Position 22 22, Position 24 24, Position 25 25, Position 26 26, Position 27 27, Position 28 28, Position 29 29, Position 30 30, Position 31 31, Position 32 32, Position 33 33, Position 34 34, Position 35 35],
    Form "{f81d4fae-7dec-11d0-a765-00a0c91e6bf6}" [Position 1 0, Position 2 1, Position 3 2, Position 4 3, Position 5 4, Position 6 5, Position 7 6, Position 8 7, Position 10 9, Position 11 10, Position 12 11, Position 13 12, Position 15 14, Position 16 15, Position 17 16, Position 18 17, Position 20 19, Position 21 20, Position 22 21, Position 23 22, Position 25 24, Position 26 25, Position 27 26, Position 28 27, Position 29 28, Position 30 29, Position 31 30, Position 32 31, Position 33 32, Position 34 33, Position 35 34, Position 36 35],
    Form "urn:uuid:f81d4fae-7dec-11d0-a765-00a0c91e6bf6" [Position 9 0, Position 10 1, Position 11 2, Position 12 3, Position 13 4, Position 14 5, Position 15 6, Position 16 7, Position 18 9, Position 19 10, Position 20 11, Position 21 12, Position 23 14, Position 24 15, Position 25 16, Position 26 17, Position 28 19, Position 29 20, Position 30 21, Position 31 22, Position 33 24, Position 34 25, Position 35 26, Position 36 27, Position 37 28, Position 38 29, Position 39 30, Position 40 31, Position 41 32, Position 42 33, Position 43 34, Position 44 35]]

  -- | Print a complete failure coordinate and use a nonzero exit independent of index truncation.
  main :: forall (r :: Region). Unit ->{IO r} Int
  main unit = with (io = newIO ()) in
    let bad = check-forms forms 0 in
    if bad == 0 then 0 else
      let printed = ioWrite (string-to-bytes (string-concat (nat-to-string bad) "\n")) in 1
