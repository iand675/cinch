-- | Check positional parsing and immutable receiver ownership using recorded byte classifications.
module Main where
  import Data.Core
  import Data.Nat
  import Data.Machine
  import Data.Bytes
  import Data.String
  import Data.Uuid

  -- | One actual reference classification and its observed canonical first digit.
  data ByteClass where
    -- | Retain a byte, success/refusal and a recorded lowercase output byte.
    ByteClass :: Nat -> Bool -> Nat -> ByteClass

  -- | A source position and its corresponding canonical hexadecimal position.
  data Position where
    -- | Keep punctuation offsets separate from the uniform hexadecimal-lane law.
    Position :: Nat -> Nat -> Position

  -- | One accepted wrapper with all of its32 hexadecimal positions.
  data Form where
    -- | Retain complete input text and its exact source/canonical position mapping.
    Form :: String -> List Position -> Form

  -- | Preserve the input and failed receiver while checking every successful bit after restoring the source byte.
  check-class :: Bytes -> Nat -> Nat -> ByteClass -> Bool
  check-class input at target row = case row of
    ByteClass byte valid lower ->
      let expected = string-to-bytes "f81d4fae-7dec-11d0-a765-00a0c91e6bf6" in
      if byte <= 255 && lower <= 255 && at < bytes-len input && target < bytes-len expected then
        let original = bytes-get input at in
        let changed = bytes-set input at byte in
        let prepared = bytes-set expected target lower in
        case uuid-unmarshal-text uuid-max input of
          (next, error) ->
            let restored = bytes-set input at original in
            case error of
              Some problem -> not valid && uuid-equal next uuid-max
              None -> valid && (case string-from-bytes expected of Some text -> uuid-format next == text; None -> False)
      else False

  -- | Return the first failed recorded byte index without losing the original generated project.
  check-classes :: Bytes -> Nat -> Nat -> List ByteClass -> Nat
  check-classes input at target rows = case rows of
    Nil -> 0
    Cons row rest -> if check-class input at target row then check-classes input at target rest else case row of ByteClass byte valid lower -> byte + 1

  -- | Sweep every encoded lane; a failure identifies its logical position and recorded byte.
  check-positions :: Bytes -> List Position -> Nat -> Nat
  check-positions input positions index = case positions of
    Nil -> 0
    Cons position rest -> case position of
      Position at target ->
        let bad = check-classes input at target classifications in
        if bad == 0 then check-positions input rest (index + 1) else index * 256 + bad

  -- | Check wrapper offsets, every byte classification and the complete restored input buffer.
  check-forms :: List Form -> Nat -> Nat
  check-forms rows index = case rows of
    Nil -> 0
    Cons row rest -> case row of
      Form text positions ->
        let input = string-to-bytes text in
        let bad = check-positions input positions 0 in
        if bad == 0 then
          if eq-i64 (bytes-compare input (string-to-bytes text)) 0 then check-forms rest (index + 1) else index * 8192 + 1
        else index * 8192 + bad

