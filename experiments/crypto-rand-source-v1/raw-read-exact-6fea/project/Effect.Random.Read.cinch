-- | Exact reads from raw callback sources without losing simultaneous data/status.
-- A full final prefix succeeds even when that callback also reports an error.
-- Short failure retains the advanced source. A zero-progress nonterminal source
-- is retried; a source that never progresses can therefore keep the call waiting.
-- These operations do not attest to source randomness or cryptographic quality.
module Effect.Random.Read where
  import Data.Core
  import Data.Nat
  import Data.Bytes
  import Data.Option
  import Data.Result
  import Effect.Stream
  import Effect.Buffered.Core

  export random-read-exact

  -- | Read exactly count bytes, preserving the advanced callback capability.
  -- Zero invokes no callback. Invalid signed/oversized callback counts are named errors.
  random-read-exact :: forall r. using (io :: Io r) => BufferSource r -> Nat ->{IO r} (Result BufferError Bytes, BufferSource r)
  random-read-exact source count = read source (bytes-new count) 0

  -- | Distinguish initial EOF from a final short prefix before the requested size.
  ended :: Nat -> Nat -> BufferError
  ended wanted actual = if actual == 0 then BufferEnd else BufferSourceError (StreamUnexpectedEnd wanted actual)

  -- | Snapshot accepted prefixes into the private destination and inspect status after progress.
  read :: forall r. using (io :: Io r) => BufferSource r -> Bytes -> Nat ->{IO r} (Result BufferError Bytes, BufferSource r)
  read source output got =
    if got == bytes-len output then (Ok output, source)
    else if got < bytes-len output then
      let wanted = bytes-len output - got in
      case buffer-source-read source wanted of
        (event, advanced) -> case event of
          ReadEvent actual payload status -> case buffer-read-accepted wanted event of
            Err error -> (Err error, advanced)
            Ok count ->
              if count <= wanted && count <= bytes-len payload then
                let copied = bytes-copy-range output payload got 0 count in
                let next = got + count in
                if next == bytes-len output then (Ok output, advanced)
                else case status of
                  Some BufferEnd -> (Err (ended (bytes-len output) next), advanced)
                  Some error -> (Err error, advanced)
                  None -> read advanced output next
              else (Err (BufferInvalidReadCount wanted actual (bytes-len payload)), advanced)
    else (Err (BufferInvalidReadCount (bytes-len output) (nat-to-int got) (bytes-len output)), source)
