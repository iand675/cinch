-- | Cryptographic printable tokens from the explicit system random capability.
-- Current tokens contain twenty-six independent alphabet symbols, or 130 bits
-- of entropy. The secure default may grow to maintain at least 128 bits.
-- No seed, replay state or mutable global source is exposed.
module Effect.Random.Text where
  import Data.Core
  import Data.Result
  import Data.String
  import Effect.Random
  import Effect.Stream
  import Effect.Buffered.Core
  import Effect.Random.Read
  import Text.Token

  export random-text, random-text-from, random-text-buffer-from

  -- | Generate an ASCII A-Z/2-7 secret token using actual system entropy.
  random-text :: forall r. using (io :: Io r) => Unit ->{IO r} String
  random-text unit = token-base32-symbols (random-bytes 26)

  -- | Draw a token from an explicit source, preserving its advanced handle on failure.
  -- The caller must supply uniform independent bytes for cryptographic strength;
  -- a deterministic or biased callback is suitable only for models or replay.
  random-text-from :: forall r. using (io :: Io r) => ByteReader r ->{IO r} (Result StreamError String, ByteReader r)
  random-text-from source = case stream-read-exact source 26 of
    (Err error, advanced) -> (Err error, advanced)
    (Ok bytes, advanced) -> (Ok (token-base32-symbols bytes), advanced)

  -- | Draw from a raw source with simultaneous data/status and zero-progress semantics.
  -- Cryptographic strength is the caller's responsibility for this explicit source.
  random-text-buffer-from :: forall r. using (io :: Io r) => BufferSource r ->{IO r} (Result BufferError String, BufferSource r)
  random-text-buffer-from source = case random-read-exact source 26 of
    (Err error, advanced) -> (Err error, advanced)
    (Ok bytes, advanced) -> (Ok (token-base32-symbols bytes), advanced)
