-- | Arbitrary-precision natural values decoded from owned or borrowed byte buffers.
-- Decoding is read only. Empty input denotes zero; leading zero bytes are allowed.
-- Complete eight-byte blocks use bounded packed loads and exact 64-bit conversion.
module Data.Nat.Bytes where
  import Data.Nat
  import Data.Bytes
  import Data.Bytes.Word
  import Data.Machine

  export nat-from-bytes-be, nat-from-bytes-be-masked

  -- | Decode a complete unsigned big-endian byte sequence without a machine-size limit.
  nat-from-bytes-be :: Bytes -> Nat
  nat-from-bytes-be input = nat-from-bytes-be-masked 255 input

  -- | Decode after applying a bit mask to only the first input byte; input is unchanged.
  -- This is arithmetic conversion, not a random generator or an entropy guarantee.
  nat-from-bytes-be-masked :: U8 -> Bytes -> Nat
  nat-from-bytes-be-masked mask input = decode input mask 0 0

  -- | Convert every unsigned word bit, including bit 63, to a mathematical natural.
  word-to-nat :: U64 -> Nat
  word-to-nat value = u32-to-nat (wrapping-u64-to-u32 value) + u32-to-nat (wrapping-u64-to-u32 (wrapping-shr-u64 value 32)) * 4294967296

  -- | Normalize a packed little-endian load to the input's big-endian number.
  prim reverse-word :: U64 -> U64 where
    llvm {
      %result = call i64 @llvm.bswap.i64(i64 %0)
      ret i64 %result
    }

  -- | Mask the first wire byte without modifying the input or losing other lanes.
  prim mask-first-word :: U64 -> U8 -> U64 where
    llvm {
      %mask = zext i8 %1 to i64
      %rest = and i64 %0, -256
      %first = and i64 %0, %mask
      %masked = or i64 %rest, %first
      %result = call i64 @llvm.bswap.i64(i64 %masked)
      ret i64 %result
    }

  -- | Apply one exact byte mask for a short first block.
  prim mask-byte :: U8 -> U8 -> U8 where
    llvm {
      %result = and i8 %0, %1
      ret i8 %result
    }

  -- | Accumulate eight-byte blocks followed by the bounded scalar fringe.
  decode :: Bytes -> U8 -> Nat -> Nat -> Nat
  decode input mask index value =
    if index + 8 <= bytes-len input then
      let packed = bytes-read-le64 input index in
      let word = if index == 0 then mask-first-word packed mask else reverse-word packed in
      decode input mask (index + 8) (value * 18446744073709551616 + word-to-nat word)
    else if index < bytes-len input then
      let raw = wrapping-i64-to-u8 (nat-to-i64 (bytes-get input index)) in
      let byte = if index == 0 then mask-byte raw mask else raw in
      decode input mask (index + 1) (value * 256 + u8-to-nat byte)
    else value
