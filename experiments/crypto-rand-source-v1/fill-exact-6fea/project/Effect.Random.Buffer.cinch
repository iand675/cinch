-- | Owned-buffer filling with an explicit cryptographic source capability.
-- The default always uses system entropy. Reader-based filling is explicit and
-- has only the quality of its supplied source; no mutable global source exists.
module Effect.Random.Buffer where
  import Data.Core
  import Data.Bytes
  import Data.Nat
  import Data.Result
  import Effect.Random
  import Effect.Stream
  import Effect.Buffered.Core
  import Effect.Random.Read

  export random-fill, random-fill-from, random-fill-buffer-from

  -- | Fill the destination from the system provider and return its exact length.
  -- Provider/allocation failures retain their runtime boundary. Empty requests
  -- preserve the existing provider check. The temporary owned draw is released.
  random-fill :: forall r. using (io :: Io r) => Bytes ->{IO r} Result StreamError Nat
  random-fill destination =
    let input = random-bytes (bytes-len destination) in
    copy-full destination input

  -- | Copy only after a successful exact read, returning the advanced continuation.
  -- This operation does not copy partial failures into destination; the callback
  -- remains responsible for its own mutations. Empty reads invoke no callback.
  -- Uniform cryptographic bytes remain the caller's duty.
  random-fill-from :: forall r. using (io :: Io r) => ByteReader r -> Bytes ->{IO r} (Result StreamError Nat, ByteReader r)
  random-fill-from source destination = case stream-read-exact source (bytes-len destination) of
    (Err error, advanced) -> (Err error, advanced)
    (Ok input, advanced) -> (copy-full destination input, advanced)

  -- | Fill after a complete raw-source draw, retaining its data/status-aware handle.
  -- Private prefix storage is discarded on failure. A final full prefix suppresses
  -- its simultaneous status. The callback remains responsible for its own mutations.
  random-fill-buffer-from :: forall r. using (io :: Io r) => BufferSource r -> Bytes ->{IO r} (Result BufferError Nat, BufferSource r)
  random-fill-buffer-from source destination = case random-read-exact source (bytes-len destination) of
    (Err error, advanced) -> (Err error, advanced)
    (Ok input, advanced) ->
      if bytes-len input == bytes-len destination then
        let copied = bytes-copy-range destination input 0 0 (bytes-len destination) in
        (Ok (bytes-len destination), advanced)
      else (Err (BufferInvalidReadCount (bytes-len destination) (nat-to-int (bytes-len input)) (bytes-len input)), advanced)

  -- | Prove the complete range before mutation, retaining structural source failures.
  copy-full :: Bytes -> Bytes -> Result StreamError Nat
  copy-full destination input =
    if bytes-len input == bytes-len destination then
      let copied = bytes-copy-range destination input 0 0 (bytes-len destination) in
      Ok (bytes-len destination)
    else if bytes-len input < bytes-len destination then Err (StreamUnexpectedEnd (bytes-len destination) (bytes-len input))
    else Err (StreamInvalidCount (bytes-len destination) (bytes-len input))
