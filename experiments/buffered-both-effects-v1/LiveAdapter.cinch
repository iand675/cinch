-- | Live native part and memory-file alias controls preserve actual mutation and independent prefix/error status.
module Main where
  import Experiment.Buffered.Multipart
  import Effect.Multipart
  import Text.Multipart
  import Effect.Buffered.Core
  import Effect.Buffered.Internal.Cell as Cell
  import Effect.Io
  import Data.Bool
  import Data.Bytes
  import Data.Int
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String

  -- | An opaque caller error retains an independently chosen identity until explicit bridge mapping.
  data FixtureError where
    -- | The native source owns the original numeric cause.
    FixtureError :: Nat -> FixtureError

  -- | Interpret only the explicitly chosen caller cause; unrelated native protocol errors remain observable.
  map-error :: MultipartError FixtureError -> BufferError
  map-error error = case error of
    MultipartCallerFailure cause -> case cause of
      FixtureError code -> BufferCustomError (if code == 7 then "opaque-seven" else "unexpected caller identity")
    MultipartProtocolFailure cause -> BufferCustomError (multipart-syntax-message cause)
    other -> BufferCustomError "unexpected native error family"

  -- | Copy only a checked source prefix into fresh transport storage.
  part :: Bytes -> Nat -> Nat -> Bytes
  part input at count = if at + count <= bytes-len input then
    let output = bytes-new count in let copied = bytes-copy-range output input 0 at count in output
    else bytes-new 0

  -- | Build a native source whose callback counter is independent of all adapters and part aliases.
  native-source :: forall (r :: Region). using (io :: Io r) => Bytes -> Nat -> Nat -> Option FixtureError -> Cell.IoCell r Nat -> MultipartSource r FixtureError
  native-source input at chunk failure calls = multipart-source (\wanted -> native-read input at chunk failure calls wanted)

  -- | Return actual fresh bytes with simultaneous terminal status and retain the exact advanced source cursor.
  native-read :: forall (r :: Region). using (io :: Io r) => Bytes -> Nat -> Nat -> Option FixtureError -> Cell.IoCell r Nat -> Nat ->{IO r} ((Bytes, MultipartReadStatus FixtureError), MultipartSource r FixtureError)
  native-read input at chunk failure calls wanted = let counted = Cell.cell-write calls (Cell.cell-read calls + 1) in
    if at < bytes-len input then
      let remaining = bytes-len input - at in let limited = if remaining < wanted then remaining else wanted in
      let count = if chunk > 0 && chunk < limited then chunk else limited in
      let next = at + count in let status = if next == bytes-len input then terminal failure else MultipartMore in
      ((part input at count, status), native-source input next chunk failure calls)
    else ((bytes-new 0, terminal failure), native-source input at chunk failure calls)

  -- | Keep caller failure separate from a genuine clean transport end.
  terminal :: Option FixtureError -> MultipartReadStatus FixtureError
  terminal failure = case failure of None -> MultipartEnd; Some cause -> MultipartReadFailure cause

  -- | Compare complete mutable payloads independently of any text decoder.
  same :: Bytes -> Bytes -> Bool
  same first second = eq-i64 (bytes-compare first second) 0

  -- | Check positive data and its independent terminal flag without accepting any other error family.
  prefix :: ReadEvent -> Int -> Bytes -> Bool -> Bool
  prefix event wanted payload ended = case event of
    ReadEvent count actual None -> count == wanted && same actual payload && not ended
    ReadEvent count actual (Some BufferEnd) -> count == wanted && same actual payload && ended
    other -> False

  -- | Check a mapped opaque caller error together with its exact confirmed prefix.
  failed-seven :: ReadEvent -> Int -> Bytes -> Bool
  failed-seven event wanted payload = case event of
    ReadEvent count actual (Some (BufferCustomError message)) -> count == wanted && same actual payload && message == "opaque-seven"
    other -> False

  -- | An adapter is lazy and old adapter/native aliases advance one shared real part cursor.
  live-part :: forall r. using (io :: Io r) => Unit ->{IO r, Mut r} Bool
  live-part unit = let calls = Cell.cell-new (0 :: Nat) in
    let input = string-to-bytes "--b\r\nContent-Disposition: form-data; name=\"x\"\r\n\r\nABC\r\n--b--\r\n" in
    let reader = multipart-reader (native-source input 0 4096 None calls) (string-to-bytes "b") in
    case multipart-next-raw-part reader of
      Ok (Some borrowed) -> let before = Cell.cell-read calls in let source = multipart-part-buffer-source borrowed map-error in
        let after = Cell.cell-read calls in if before == after then
          case buffer-source-read source 1 of
            (first, next) -> case multipart-part-read borrowed 1 of
              (middle, MultipartMore) -> case buffer-source-read source 1 of
                (last, advanced) -> case buffer-source-read next 1 of
                  (end, final) -> prefix first 1 (string-to-bytes "A") False && same middle (string-to-bytes "B") &&
                    prefix last 1 (string-to-bytes "C") True && prefix end 0 (bytes-new 0) True
              other -> False
        else False
      other -> False

  -- | A truncated body retains positive bytes and the original typed caller error through the explicit bridge policy.
  live-prefix-error :: forall r. using (io :: Io r) => Unit ->{IO r, Mut r} Bool
  live-prefix-error unit = let calls = Cell.cell-new (0 :: Nat) in
    let header = "--b\r\nContent-Disposition: form-data; name=\"x\"\r\n\r\n" in
    let input = string-to-bytes (string-concat header "ABC") in
    let reader = multipart-reader (native-source input 0 (bytes-len (string-to-bytes header)) (Some (FixtureError 7)) calls) (string-to-bytes "b") in
    case multipart-next-raw-part reader of
      Ok (Some borrowed) -> case buffer-source-read (multipart-part-buffer-source borrowed map-error) 64 of
        (event, next) -> case buffer-source-read next 1 of
          (again, final) -> failed-seven event 3 (string-to-bytes "ABC") && failed-seven again 0 (bytes-new 0)
      other -> False

  -- | Pin unused memory-file backend types explicitly rather than leaving a polymorphic aggregate let.
  memory-header :: forall (r :: Region). Bytes ->{Mut r} MultipartFileHeader r FixtureError Unit Unit Unit
  memory-header input = multipart-file-memory (string-to-bytes "raw") (multipart-headers Nil) input

  -- | A live memory file preserves arbitrary bytes and shared cursors through original and advanced adapter aliases.
  live-memory-file :: forall r. using (io :: Io r) => Unit ->{IO r, Mut r} Bool
  live-memory-file unit = let input = bytes-new 3 in let a = bytes-set input 0 65 in let b = bytes-set input 1 66 in let c = bytes-set input 2 255 in
    let header = memory-header input in let changed = bytes-set input 0 90 in
    case multipart-file-open header of
      Ok file -> let source = multipart-file-buffer-source file map-error in
        case buffer-source-read source 1 of
          (first, next) -> case multipart-file-read file 1 of
            (middle, MultipartMore) -> case buffer-source-read source 1 of
              (last, advanced) -> case buffer-source-read next 1 of
                (end, final) -> let invalid = bytes-new 1 in let set = bytes-set invalid 0 255 in
                  prefix first 1 (string-to-bytes "A") False && same middle (string-to-bytes "B") &&
                  prefix last 1 invalid False && prefix end 0 (bytes-new 0) True
            other -> False
      other -> False

  -- | These actual live-handle cases complement transfer priority; disk-close and retained cross-callback cases remain separate gates.
  main :: Unit ->{IO r, Mut r} Int
  main unit = with (io = newIO ()) in
    if not (live-part ()) then 1
    else if not (live-prefix-error ()) then 2
    else if not (live-memory-file ()) then 3
    else 0
