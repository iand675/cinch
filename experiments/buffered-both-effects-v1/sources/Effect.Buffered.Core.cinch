-- | Explicit byte-stream events, advanced continuations and transfer capabilities for buffered I/O.
-- Raw callbacks report signed counts and may return data together with a failure.
-- Buffered adapters validate those counts before reading or copying caller storage.
module Effect.Buffered.Core where
  import Data.Bytes
  import Data.Bool
  import Data.Int
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String
  import Effect.Stream
  import Effect.Io
  import Effect.Buffered.Internal.Cell as Cell

  export BufferError, BufferEnd, BufferFull, BufferNegativeCount
  export BufferInvalidUnreadByte, BufferInvalidUnreadRune, BufferInvalidReadCount, BufferInvalidWriteCount
  export BufferNoProgress, BufferShortWrite, BufferSourceError, BufferSinkError, BufferCustomError
  export buffer-error-message
  export ReadEvent, WriteEvent, TransferEvent
  export BufferSource, BufferSink, buffer-source, buffer-sink
  export buffer-source-with-mutation
  export buffer-source-with-transfer, buffer-sink-with-transfer
  export buffer-sink-with-text, buffer-sink-has-text, buffer-sink-write-text
  export buffer-sink-with-flush, buffer-sink-has-flush, buffer-sink-flush
  export buffer-source-has-transfer, buffer-sink-has-transfer
  export buffer-source-read, buffer-sink-write, buffer-source-transfer, buffer-sink-transfer
  export buffer-source-from-stream, buffer-sink-from-stream
  export buffer-read-accepted, buffer-write-accepted

  -- | A stream boundary, capacity refusal, invalid operation or retained transport failure.
  data BufferError where
    -- | The input has ended; a read may also return its final nonempty byte prefix.
    BufferEnd :: BufferError
    -- | The requested count exceeds the available fixed buffer; carries capacity and requested count.
    BufferFull :: Nat -> Int -> BufferError
    -- | A public signed count is negative.
    BufferNegativeCount :: Int -> BufferError
    -- | No preceding operation permits a byte to be unread.
    BufferInvalidUnreadByte :: BufferError
    -- | The preceding successful operation was not a rune read.
    BufferInvalidUnreadRune :: BufferError
    -- | A source count is negative, exceeds its request, or exceeds its supplied data length.
    BufferInvalidReadCount :: Nat -> Int -> Nat -> BufferError
    -- | A sink count is negative or exceeds the offered byte count.
    BufferInvalidWriteCount :: Nat -> Int -> BufferError
    -- | A source repeatedly returned no bytes and no terminal status.
    BufferNoProgress :: BufferError
    -- | A sink accepted a short prefix without reporting a failure.
    BufferShortWrite :: Nat -> Nat -> BufferError
    -- | A default stream source reported this original structured failure.
    BufferSourceError :: StreamError -> BufferError
    -- | A default stream sink reported this original structured failure.
    BufferSinkError :: StreamError -> BufferError
    -- | A custom transport supplied an application diagnostic.
    BufferCustomError :: String -> BufferError

  -- | Describe a buffered operation while preserving typed metadata in its original error value.
  buffer-error-message :: BufferError -> String
  buffer-error-message error = case error of
    BufferEnd -> "end of input"
    BufferFull capacity requested -> "buffer full"
    BufferNegativeCount count -> "negative buffered byte count"
    BufferInvalidUnreadByte -> "invalid byte unread"
    BufferInvalidUnreadRune -> "invalid rune unread"
    BufferInvalidReadCount wanted actual supplied -> "invalid source read count"
    BufferInvalidWriteCount wanted actual -> "invalid sink write count"
    BufferNoProgress -> "source made no progress"
    BufferShortWrite expected actual -> "short buffered write"
    BufferSourceError original -> "buffered source failed"
    BufferSinkError original -> "buffered sink failed"
    BufferCustomError message -> message

  -- | A raw source event; the signed count identifies its produced prefix and may accompany an error.
  -- Callback data is mutable. Buffered readers snapshot accepted bytes before retaining them.
  data ReadEvent where
    -- | Report a signed count, supplied bytes and optional terminal status without losing partial progress.
    ReadEvent :: Int -> Bytes -> Option BufferError -> ReadEvent

  -- | A raw sink event retaining both the accepted count and an optional failure.
  data WriteEvent where
    -- | Report a signed accepted count and optional failure; adapters validate its range.
    WriteEvent :: Int -> Option BufferError -> WriteEvent

  -- | A direct transfer's signed count and optional failure; negative reports remain observable.
  data TransferEvent where
    -- | Preserve the transport's complete signed64-bit count independently of byte-buffer indexing.
    TransferEvent :: I64 -> Option BufferError -> TransferEvent

  -- | A source continuation with an optional direct-to-sink transfer capability.
  data BufferSource r where
    -- | A private read callback returning the authoritative advanced source handle.
    SourceStep :: (Nat ->{IO r} (ReadEvent, BufferSource r)) -> BufferSource r
    -- | A live read may perform I/O and mutation in the same region without erasing either effect.
    SourceMutStep :: (Nat ->{IO r, Mut r} (ReadEvent, BufferSource r)) -> BufferSource r
    -- | Direct callbacks; the transfer writes through a supplied effectful operation.
    SourceTransferStep :: (Nat ->{IO r, Mut r} (ReadEvent, BufferSource r)) -> ((Bytes ->{IO r} WriteEvent) ->{IO r, Mut r} (TransferEvent, BufferSource r)) -> BufferSource r
    -- | Private forwarding operations observe an internal cell's current continuation and capabilities.
    SourceProxyStep :: (Nat ->{IO r, Mut r} (ReadEvent, BufferSource r)) -> (Unit ->{IO r} Bool) -> ((Bytes ->{IO r} WriteEvent) ->{IO r, Mut r} (Option TransferEvent, BufferSource r)) -> BufferSource r

  -- | A sink continuation with an optional direct-from-source transfer capability.
  data BufferSink r where
    -- | A private write callback retaining the authoritative advanced sink handle.
    SinkStep :: (Bytes ->{IO r} (WriteEvent, BufferSink r)) -> BufferSink r
    -- | Direct callbacks; the transfer reads through a supplied effectful operation.
    SinkTransferStep :: (Bytes ->{IO r} (WriteEvent, BufferSink r)) -> ((Nat ->{IO r, Mut r} ReadEvent) ->{IO r, Mut r} (TransferEvent, BufferSink r)) -> BufferSink r
    -- | Private forwarding operations preserve retained callbacks without exposing mutable cell storage.
    SinkProxyStep :: (Bytes ->{IO r} (WriteEvent, BufferSink r)) -> (Unit ->{IO r} Bool) -> ((Nat ->{IO r, Mut r} ReadEvent) ->{IO r, Mut r} (Option TransferEvent, BufferSink r)) -> (Unit ->{IO r} Bool) -> (Bytes ->{IO r} (Option WriteEvent, BufferSink r)) -> (Unit ->{IO r} Bool) -> (Unit ->{IO r} (Option (Option BufferError), BufferSink r)) -> BufferSink r
    -- | An optional raw-text write operation; its returned sink determines all subsequent capabilities.
    SinkTextStep :: BufferSink r -> (Bytes ->{IO r} (WriteEvent, BufferSink r)) -> BufferSink r
    -- | An optional flush operation retains its advanced sink, including after a failure.
    SinkFlushStep :: BufferSink r -> (Unit ->{IO r} (Option BufferError, BufferSink r)) -> BufferSink r

  -- | Construct a source whose raw events are validated by each buffered consumer before copying.
  buffer-source :: forall r. (Nat ->{IO r} (ReadEvent, BufferSource r)) -> BufferSource r
  buffer-source step = SourceStep step

  -- | Construct a live source whose native reads require both I/O and mutation in the same region.
  buffer-source-with-mutation :: forall r. (Nat ->{IO r, Mut r} (ReadEvent, BufferSource r)) -> BufferSource r
  buffer-source-with-mutation step = SourceMutStep step

  -- | Execute an IO-only callback inside a conservatively both-effect read without narrowing its type.
  widen-source-step :: forall r. (Nat ->{IO r} (ReadEvent, BufferSource r)) -> Nat ->{IO r, Mut r} (ReadEvent, BufferSource r)
  widen-source-step step wanted = step wanted


  -- | Construct a sink whose raw signed counts remain observable to buffered consumers.
  buffer-sink :: forall r. (Bytes ->{IO r} (WriteEvent, BufferSink r)) -> BufferSink r
  buffer-sink step = SinkStep step

  -- | Attach a direct transfer; the supplied write operation preserves the other handle's progress.
  buffer-source-with-transfer :: forall r. BufferSource r -> ((Bytes ->{IO r} WriteEvent) ->{IO r, Mut r} (TransferEvent, BufferSource r)) -> BufferSource r
  buffer-source-with-transfer source transfer = case source of
    SourceStep step -> SourceTransferStep (widen-source-step step) transfer
    SourceMutStep step -> SourceTransferStep step transfer
    SourceTransferStep step ignored -> SourceTransferStep step transfer
    SourceProxyStep step query ignored -> SourceTransferStep step transfer

  -- | Attach a direct transfer; the supplied read operation preserves the other handle's progress.
  buffer-sink-with-transfer :: forall r. BufferSink r -> ((Nat ->{IO r, Mut r} ReadEvent) ->{IO r, Mut r} (TransferEvent, BufferSink r)) -> BufferSink r
  buffer-sink-with-transfer sink transfer = case sink of
    SinkStep step -> SinkTransferStep step transfer
    SinkTransferStep step ignored -> SinkTransferStep step transfer
    SinkProxyStep step query ignored text-query text flush-query flush -> SinkProxyStep step (\unit -> True) (\read -> attached-sink-transfer transfer read) text-query text flush-query flush
    SinkTextStep sink text -> SinkTextStep (buffer-sink-with-transfer sink transfer) text
    SinkFlushStep sink flush -> SinkFlushStep (buffer-sink-with-transfer sink transfer) flush

  -- | Observe the current direct-transfer capability, including after a retained callback advances a proxy.
  buffer-source-has-transfer :: forall r. using (io :: Io r) => BufferSource r ->{IO r} Bool
  buffer-source-has-transfer source = case source of
    SourceStep step -> False
    SourceMutStep step -> False
    SourceTransferStep step transfer -> True
    SourceProxyStep step query transfer -> query ()

  -- | Observe the current direct-transfer capability without invoking any transport operation.
  buffer-sink-has-transfer :: forall r. using (io :: Io r) => BufferSink r ->{IO r} Bool
  buffer-sink-has-transfer sink = case sink of
    SinkStep step -> False
    SinkTransferStep step transfer -> True
    SinkProxyStep step query transfer text-query text flush-query flush -> query ()
    SinkTextStep sink text -> buffer-sink-has-transfer sink
    SinkFlushStep sink flush -> buffer-sink-has-transfer sink

  -- | Invoke one raw source callback, retaining its event and advanced handle even for malformed counts.
  buffer-source-read :: forall r. using (io :: Io r) => BufferSource r -> Nat ->{IO r, Mut r} (ReadEvent, BufferSource r)
  buffer-source-read source wanted = case source of
    SourceStep step -> step wanted
    SourceMutStep step -> step wanted
    SourceTransferStep step transfer -> step wanted
    SourceProxyStep step query transfer -> step wanted

  -- | Invoke one raw sink callback with caller-owned bytes, retaining its advanced handle on every outcome.
  buffer-sink-write :: forall r. using (io :: Io r) => BufferSink r -> Bytes ->{IO r} (WriteEvent, BufferSink r)
  buffer-sink-write sink input = case sink of
    SinkStep step -> step input
    SinkTransferStep step transfer -> step input
    SinkProxyStep step query transfer text-query text flush-query flush -> step input
    SinkTextStep sink text -> buffer-sink-write sink input
    SinkFlushStep sink flush -> buffer-sink-write sink input

  -- | Build a source proxy over a managed continuation cell without storing the proxy inside that cell.
  source-proxy :: forall r. using (io :: Io r) => Cell.IoCell r (BufferSource r) -> BufferSource r
  source-proxy cell = SourceProxyStep (\wanted -> source-proxy-read cell wanted) (\unit -> source-proxy-query cell) (\write -> source-proxy-transfer cell write)

  -- | Advance the underlying source first, then return another view of the same coherent continuation cell.
  source-proxy-read :: forall r. using (io :: Io r) => Cell.IoCell r (BufferSource r) -> Nat ->{IO r, Mut r} (ReadEvent, BufferSource r)
  source-proxy-read cell wanted = let current = Cell.cell-read cell in
    case buffer-source-read current wanted of
      (event, next) -> let stored = Cell.cell-write cell next in (event, source-proxy cell)

  -- | Observe a source proxy's actual current optional capability.
  source-proxy-query :: forall r. using (io :: Io r) => Cell.IoCell r (BufferSource r) ->{IO r} Bool
  source-proxy-query cell = let current = Cell.cell-read cell in buffer-source-has-transfer current

  -- | Preserve current source capabilities and progress when a retained transfer callback is invoked later.
  source-proxy-transfer :: forall r. using (io :: Io r) => Cell.IoCell r (BufferSource r) -> (Bytes ->{IO r} WriteEvent) ->{IO r, Mut r} (Option TransferEvent, BufferSource r)
  source-proxy-transfer cell write = let current = Cell.cell-read cell in
    case run-source-transfer current write of
      (event, next) -> let stored = Cell.cell-write cell next in (event, source-proxy cell)

  -- | Build a sink proxy whose callbacks keep the authoritative continuation in managed private storage.
  sink-proxy :: forall r. using (io :: Io r) => Cell.IoCell r (BufferSink r) -> BufferSink r
  sink-proxy cell = SinkProxyStep (\input -> sink-proxy-write cell input) (\unit -> sink-proxy-query cell) (\read -> sink-proxy-transfer cell read) (\unit -> sink-proxy-text-query cell) (\input -> sink-proxy-text cell input) (\unit -> sink-proxy-flush-query cell) (\unit -> sink-proxy-flush cell)

  -- | Advance the underlying sink without retaining a stale pre-callback continuation.
  sink-proxy-write :: forall r. using (io :: Io r) => Cell.IoCell r (BufferSink r) -> Bytes ->{IO r} (WriteEvent, BufferSink r)
  sink-proxy-write cell input = let current = Cell.cell-read cell in
    case buffer-sink-write current input of
      (event, next) -> let stored = Cell.cell-write cell next in (event, sink-proxy cell)

  -- | Observe a sink proxy's actual current optional capability.
  sink-proxy-query :: forall r. using (io :: Io r) => Cell.IoCell r (BufferSink r) ->{IO r} Bool
  sink-proxy-query cell = let current = Cell.cell-read cell in buffer-sink-has-transfer current

  -- | Keep a retained sink-transfer operation attached to its latest underlying continuation.
  sink-proxy-transfer :: forall r. using (io :: Io r) => Cell.IoCell r (BufferSink r) -> (Nat ->{IO r, Mut r} ReadEvent) ->{IO r, Mut r} (Option TransferEvent, BufferSink r)
  sink-proxy-transfer cell read = let current = Cell.cell-read cell in
    case run-sink-transfer current read of
      (event, next) -> let stored = Cell.cell-write cell next in (event, sink-proxy cell)

  -- | Invoke a source's own transfer callback without introducing a negatively recursive sink field.
  run-source-transfer :: forall r. using (io :: Io r) => BufferSource r -> (Bytes ->{IO r} WriteEvent) ->{IO r, Mut r} (Option TransferEvent, BufferSource r)
  run-source-transfer source write = case source of
    SourceStep step -> (None, source)
    SourceMutStep step -> (None, source)
    SourceTransferStep step capability -> case capability write of (event, next) -> (Some event, next)
    SourceProxyStep step query capability -> capability write

  -- | Invoke a sink's own transfer callback without introducing a negatively recursive source field.
  run-sink-transfer :: forall r. using (io :: Io r) => BufferSink r -> (Nat ->{IO r, Mut r} ReadEvent) ->{IO r, Mut r} (Option TransferEvent, BufferSink r)
  run-sink-transfer sink read = case sink of
    SinkStep step -> (None, sink)
    SinkTransferStep step capability -> case capability read of (event, next) -> (Some event, next)
    SinkProxyStep step query capability text-query text flush-query flush -> capability read
    SinkTextStep sink text -> run-sink-transfer sink read
    SinkFlushStep sink flush -> run-sink-transfer sink read

  -- | Offer through a forwarding sink whose private cell already retains the advanced continuation.
  sink-event :: forall r. using (io :: Io r) => BufferSink r -> Bytes ->{IO r} WriteEvent
  sink-event sink input = case buffer-sink-write sink input of (event, next) -> event

  -- | Read through a forwarding source whose private cell already retains the advanced continuation.
  source-event :: forall r. using (io :: Io r) => BufferSource r -> Nat ->{IO r, Mut r} ReadEvent
  source-event source wanted = case buffer-source-read source wanted of (event, next) -> event

  -- | Invoke an optional source transfer; absence performs no transport I/O and returns the original handles.
  buffer-source-transfer :: forall r. using (io :: Io r) => BufferSource r -> BufferSink r ->{IO r, Mut r} (Option TransferEvent, BufferSource r, BufferSink r)
  buffer-source-transfer source sink = if buffer-source-has-transfer source then
    let cell = Cell.cell-new sink in let proxy = sink-proxy cell in
    case run-source-transfer source (\input -> sink-event proxy input) of
      (event, next-source) -> (event, next-source, proxy)
    else (None, source, sink)

  -- | Invoke an optional sink transfer; retained read callbacks and the returned source share coherent progress.
  buffer-sink-transfer :: forall r. using (io :: Io r) => BufferSink r -> BufferSource r ->{IO r, Mut r} (Option TransferEvent, BufferSource r, BufferSink r)
  buffer-sink-transfer sink source = if buffer-sink-has-transfer sink then
    let cell = Cell.cell-new source in let proxy = source-proxy cell in
    case run-sink-transfer sink (\wanted -> source-event proxy wanted) of
      (event, next-sink) -> (event, proxy, next-sink)
    else (None, source, sink)

  -- | Validate a source's signed report before using it as a byte count or buffer index.
  buffer-read-accepted :: Nat -> ReadEvent -> Result BufferError Nat
  buffer-read-accepted wanted event = case event of
    ReadEvent actual payload status ->
      if 0 <= actual && actual <= nat-to-int wanted && actual <= nat-to-int (bytes-len payload) then Ok (nat-from-int actual)
      else Err (BufferInvalidReadCount wanted actual (bytes-len payload))

  -- | Validate a sink's signed report before advancing any buffered byte interval.
  buffer-write-accepted :: Nat -> WriteEvent -> Result BufferError Nat
  buffer-write-accepted wanted event = case event of
    WriteEvent actual status -> if 0 <= actual && actual <= nat-to-int wanted then Ok (nat-from-int actual)
      else Err (BufferInvalidWriteCount wanted actual)

  -- | Adapt an existing source while preserving its original failures and explicit next continuation.
  -- A successful empty positive read becomes end-of-input; a zero request remains nonterminal.
  buffer-source-from-stream :: forall r. using (io :: Io r) => ByteReader r -> BufferSource r
  buffer-source-from-stream source = buffer-source (\wanted -> source-stream-step source wanted)

  -- | Translate one existing source event without inventing simultaneous progress on a failure-only result.
  source-stream-step :: forall r. using (io :: Io r) => ByteReader r -> Nat ->{IO r} (ReadEvent, BufferSource r)
  source-stream-step source wanted = case stream-read source wanted of
    (Err error, next) -> (ReadEvent 0 (bytes-new 0) (Some (BufferSourceError error)), buffer-source-from-stream next)
    (Ok payload, next) -> let status = if wanted > 0 && bytes-len payload == 0 then Some BufferEnd else None in
      let count = nat-to-int (bytes-len payload) in (ReadEvent count payload status, buffer-source-from-stream next)

  -- | Adapt an existing sink, preserving its original structured errors and authoritative next handle.
  -- A failure-only stream result reports zero progress; richer raw callbacks can report data and error together.
  buffer-sink-from-stream :: forall r. using (io :: Io r) => ByteWriter r -> BufferSink r
  buffer-sink-from-stream sink = buffer-sink (\input -> sink-stream-step sink input)

  -- | Translate one existing sink event without draining a positive short write or discarding its count.
  sink-stream-step :: forall r. using (io :: Io r) => ByteWriter r -> Bytes ->{IO r} (WriteEvent, BufferSink r)
  sink-stream-step sink input = case stream-write sink input of
    (Err error, next) -> (WriteEvent 0 (Some (BufferSinkError error)), buffer-sink-from-stream next)
    (Ok count, next) -> (WriteEvent (nat-to-int count) None, buffer-sink-from-stream next)

  -- | Attach an optional text-write operation receiving arbitrary bytes, including malformed UTF-8.
  -- Its returned sink is authoritative. Ordinary byte writes retain only capabilities
  -- advertised by their own returned sink, just like direct transfer callbacks.
  buffer-sink-with-text :: forall r. BufferSink r -> (Bytes ->{IO r} (WriteEvent, BufferSink r)) -> BufferSink r
  buffer-sink-with-text sink text = case sink of
    SinkTextStep plain old -> SinkTextStep plain text
    other -> SinkTextStep sink text

  -- | Observe whether the current sink supports an independent raw-text write operation.
  buffer-sink-has-text :: forall r. using (io :: Io r) => BufferSink r ->{IO r} Bool
  buffer-sink-has-text sink = case sink of
    SinkTextStep plain text -> True
    SinkProxyStep step query transfer text-query text flush-query flush -> text-query ()
    SinkFlushStep plain flush -> buffer-sink-has-text plain
    other -> False

  -- | Invoke only an explicitly advertised raw-text operation; absence performs no transport I/O.
  buffer-sink-write-text :: forall r. using (io :: Io r) => BufferSink r -> Bytes ->{IO r} (Option WriteEvent, BufferSink r)
  buffer-sink-write-text sink input = case sink of
    SinkTextStep plain text -> case text input of (event, next) -> (Some event, next)
    SinkProxyStep step query transfer text-query text flush-query flush -> text input
    SinkFlushStep plain flush -> buffer-sink-write-text plain input
    other -> (None, sink)

  -- | Query the current underlying text capability through an advanced transfer proxy.
  sink-proxy-text-query :: forall r. using (io :: Io r) => Cell.IoCell r (BufferSink r) ->{IO r} Bool
  sink-proxy-text-query cell = let current = Cell.cell-read cell in buffer-sink-has-text current

  -- | Advance a proxy's underlying text continuation before returning another coherent view of its shared cell.
  sink-proxy-text :: forall r. using (io :: Io r) => Cell.IoCell r (BufferSink r) -> Bytes ->{IO r} (Option WriteEvent, BufferSink r)
  sink-proxy-text cell input = let current = Cell.cell-read cell in
    case buffer-sink-write-text current input of
      (event, next) -> let stored = Cell.cell-write cell next in (event, sink-proxy cell)

  -- | Attach an optional flush operation whose advanced sink remains authoritative on both success and failure.
  -- A callback flushes buffered output owned by that sink; custom transports define
  -- whether their own subordinate layers require additional explicit finalization.
  buffer-sink-with-flush :: forall r. BufferSink r -> (Unit ->{IO r} (Option BufferError, BufferSink r)) -> BufferSink r
  buffer-sink-with-flush sink flush = case sink of
    SinkFlushStep plain old -> SinkFlushStep plain flush
    other -> SinkFlushStep sink flush

  -- | Observe the current sink's flush capability without invoking a flush or transport write.
  buffer-sink-has-flush :: forall r. using (io :: Io r) => BufferSink r ->{IO r} Bool
  buffer-sink-has-flush sink = case sink of
    SinkFlushStep plain flush -> True
    SinkTextStep plain text -> buffer-sink-has-flush plain
    SinkProxyStep step query transfer text-query text flush-query flush -> flush-query ()
    other -> False

  -- | Invoke an advertised flush and return its advanced handle, preserving absence separately from successful flushing.
  -- None performs no transport I/O. Some None reports a successful flush;
  -- Some (Some failure) retains its original structured failure and continuation.
  buffer-sink-flush :: forall r. using (io :: Io r) => BufferSink r ->{IO r} (Option (Option BufferError), BufferSink r)
  buffer-sink-flush sink = case sink of
    SinkFlushStep plain flush -> case flush () of (status, next) -> (Some status, next)
    SinkTextStep plain text -> buffer-sink-flush plain
    SinkProxyStep step query transfer text-query text flush-query flush -> flush ()
    other -> (None, sink)

  -- | Query a transfer proxy's actual current flush capability, including later retained-callback advances.
  sink-proxy-flush-query :: forall r. using (io :: Io r) => Cell.IoCell r (BufferSink r) ->{IO r} Bool
  sink-proxy-flush-query cell = let current = Cell.cell-read cell in buffer-sink-has-flush current

  -- | Update a proxy's authoritative continuation before returning the flush result and another coherent proxy view.
  sink-proxy-flush :: forall r. using (io :: Io r) => Cell.IoCell r (BufferSink r) ->{IO r} (Option (Option BufferError), BufferSink r)
  sink-proxy-flush cell = let current = Cell.cell-read cell in
    case buffer-sink-flush current of
      (status, next) -> let stored = Cell.cell-write cell next in (status, sink-proxy cell)

  -- | Attach a current direct-transfer operation without dropping a proxy's independent text and flush queries.
  attached-sink-transfer :: forall r. ((Nat ->{IO r, Mut r} ReadEvent) ->{IO r, Mut r} (TransferEvent, BufferSink r)) -> (Nat ->{IO r, Mut r} ReadEvent) ->{IO r, Mut r} (Option TransferEvent, BufferSink r)
  attached-sink-transfer callback read = case callback read of (event, next) -> (Some event, next)
