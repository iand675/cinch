-- | Advanced byte-stream tokenization with bounded buffers, fresh tokens and explicit checked protocol failures.
-- Configuration is immutable and becomes fixed after the first scan. Custom
-- split callbacks receive snapshots; token getters never expose private backing.
module Effect.Scanner where
  import Effect.Buffered.Core
  import Effect.Scanner.Split
  import Effect.Io
  import Effect.Stream
  import Data.Bool
  import Data.Bytes
  import Data.Int
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String

  export Scanner, scanner, scanner-from-stream, scanner-max-token-size
  export scanner-buffer, scanner-buffer-size, scanner-split
  export scanner-next, scanner-error, scanner-token, scanner-bytes, scanner-text

  -- | Private initialized storage and the half-open unread interval.
  data ScanWindow where
    -- | The bytes before end are initialized; start is the consumed prefix.
    Window :: Bytes -> Nat -> Nat -> ScanWindow

  -- | An advanced tokenizer retains its authoritative source, split capability and last token independently.
  data Scanner r where
    -- | Source, split, maximum, private window, terminal status, token, empty count, started and final flags.
    Scanning :: BufferSource r -> ScanSplit -> Int -> ScanWindow -> Option ScanError -> Option Bytes -> Nat -> Bool -> Bool -> Scanner r

  -- | The default maximum allocated token buffer is 65,536 bytes, including any required delimiter.
  scanner-max-token-size :: Nat
  scanner-max-token-size = 65536

  -- | Construct an unstarted line scanner with lazy initial buffer allocation and the default token maximum.
  scanner :: forall r. BufferSource r -> Scanner r
  scanner source = Scanning source (scan-split scan-lines) 65536 (Window (bytes-new 0) 0 0) None None 0 False False

  -- | Adapt an existing stream reader under its established positive-empty-success end-of-input contract.
  scanner-from-stream :: forall r. using (io :: Io r) => ByteReader r -> Scanner r
  scanner-from-stream source = scanner (buffer-source-from-stream source)

  -- | Configure an initial private buffer length and a signed growth maximum before scanning begins.
  -- The supplied byte contents are ignored and never retained. Existing initial capacity may exceed the growth maximum.
  scanner-buffer :: forall r. Scanner r -> Bytes -> Int -> Result ScanError (Scanner r)
  scanner-buffer current initial maximum = scanner-buffer-size current (bytes-len initial) maximum

  -- | Select explicit initial buffer capacity without allocating or exposing caller-owned backing storage.
  scanner-buffer-size :: forall r. Scanner r -> Nat -> Int -> Result ScanError (Scanner r)
  scanner-buffer-size current capacity maximum = case current of
    Scanning source split old window error token empties started done -> if started then Err (ScanStarted "buffer")
      else Ok (Scanning source split maximum (Window (bytes-new capacity) 0 0) error token empties False done)

  -- | Select a pure custom split capability before the first scan; later changes return a checked refusal.
  scanner-split :: forall r. Scanner r -> ScanSplit -> Result ScanError (Scanner r)
  scanner-split current next = case current of
    Scanning source split maximum window error token empties started done -> if started then Err (ScanStarted "split")
      else Ok (Scanning source next maximum window error token empties False done)

  -- | Copy a complete checked interval without sharing mutable token storage.
  part :: Bytes -> Nat -> Nat -> Bytes
  part input at count = if at + count <= bytes-len input then
    let output = bytes-new count in let copied = bytes-copy-range output input 0 at count in output
    else bytes-new 0

  -- | Observe a fresh optional last token, preserving absence separately from an explicitly empty token.
  scanner-token :: forall r. Scanner r -> Option Bytes
  scanner-token current = case current of
    Scanning source split maximum window error token empties started done -> case token of
      None -> None
      Some payload -> Some (part payload 0 (bytes-len payload))

  -- | Observe fresh last-token bytes; an absent token is represented by fresh empty bytes.
  scanner-bytes :: forall r. Scanner r -> Bytes
  scanner-bytes current = case scanner-token current of None -> bytes-new 0; Some payload -> payload

  -- | Check the complete last-token bytes for UTF-8 validity without discarding malformed bytes from scanner-bytes.
  -- An absent or empty token yields Some empty text; malformed bytes yield None.
  scanner-text :: forall r. Scanner r -> Option String
  scanner-text current = string-from-bytes (scanner-bytes current)

  -- | Observe the first retained non-end error; ordinary source end-of-input is successful termination.
  scanner-error :: forall r. Scanner r -> Option ScanError
  scanner-error current = case current of
    Scanning source split maximum window error token empties started done -> case error of
      Some (ScanSourceError BufferEnd) -> None
      other -> other

  -- | Preserve the first non-end failure while allowing a later split failure to replace ordinary end-of-input.
  first-error :: Option ScanError -> ScanError -> Option ScanError
  first-error old next = case old of
    None -> Some next
    Some (ScanSourceError BufferEnd) -> Some next
    other -> other

  -- | Record a checked failure without discarding the previous token or authoritative source continuation.
  failed :: forall r. Scanner r -> ScanError -> Scanner r
  failed current failure = case current of
    Scanning source split maximum window error token empties started done -> Scanning source split maximum window (first-error error failure) token empties started done

  -- | Compact a sufficiently consumed prefix into fresh storage while preserving exact buffer capacity and read widths.
  compact :: forall r. Scanner r -> Scanner r
  compact current = case current of
    Scanning source split maximum window error token empties started done -> case window of
      Window owner start end -> if start <= end && end <= bytes-len owner then
        if start > 0 && (end == bytes-len owner || start > bytes-len owner / 2) then
          let count = end - start in let output = bytes-new (bytes-len owner) in
          if count <= bytes-len output && start + count <= bytes-len owner then
            let copied = bytes-copy-range output owner 0 start count in
            Scanning source split maximum (Window output 0 count) error token empties started done
          else failed current (ScanCustomError "invalid private compaction interval")
        else current
        else failed current (ScanCustomError "invalid private scanner window")

  -- | Grow a full buffer geometrically within both the signed source-count domain and the configured maximum.
  grow :: forall r. Scanner r -> Scanner r
  grow current = case current of
    Scanning source split maximum window error token empties started done -> case window of
      Window owner start end -> let capacity = bytes-len owner in
        if end == capacity then
          if nat-to-int capacity >= maximum || capacity > 4611686018427387903 then failed current ScanTooLong
          else if maximum > 0 && start <= end then
            let doubled = growth-capacity capacity in
            let limit = nat-from-int maximum in let size = if doubled < limit then doubled else limit in
            let output = bytes-new size in let count = end - start in
            if count <= bytes-len output && start + count <= bytes-len owner then
              let copied = bytes-copy-range output owner 0 start count in
              Scanning source split maximum (Window output 0 count) error token empties started done
            else failed current ScanTooLong
          else failed current ScanTooLong
        else current

  -- | Read into fresh private storage and retry exactly 101 empty nonterminal source events before refusing nonprogress.
  read-more :: forall r. using (io :: Io r) => Scanner r -> Nat ->{IO r, Mut r} Scanner r
  read-more current attempts = case current of
    Scanning source split maximum window error token empties started done -> case window of
      Window owner start end ->
        if end < bytes-len owner then
          let wanted = bytes-len owner - end in
          case buffer-source-read source wanted of
            (event, next-source) -> case event of
              ReadEvent actual payload status -> case buffer-read-accepted wanted event of
                Err failure -> Scanning next-source split maximum window (first-error error (ScanBadReadCount wanted actual (bytes-len payload))) token empties started done
                Ok count ->
                  if end + count <= bytes-len owner && count <= bytes-len payload then
                    let output = part owner 0 (bytes-len owner) in
                    if end + count <= bytes-len output then
                      let copied = bytes-copy-range output payload end 0 count in
                      let next-window = Window output start (end + count) in
                      case status of
                        Some failure -> Scanning next-source split maximum next-window (first-error error (ScanSourceError failure)) token empties started done
                        None -> let next = Scanning next-source split maximum next-window error token 0 started done in
                          if count > 0 then next
                          else if attempts < 100 then read-more next (attempts + 1)
                          else failed next ScanNoProgress
                    else failed current (ScanCustomError "invalid private scanner refill")
                  else Scanning next-source split maximum window (first-error error (ScanBadReadCount wanted actual (bytes-len payload))) token empties started done
        else failed current ScanTooLong

  -- | Request more input only after split processing found no token and no terminal error.
  refill :: forall r. using (io :: Io r) => Scanner r ->{IO r, Mut r} (Bool, Scanner r)
  refill current = let ready = grow (compact current) in
    case ready of
      Scanning source split maximum window error token empties started done -> case error of
        Some failure -> (False, ready)
        None -> let next = read-more ready 0 in scan-loop next

  -- | Finish an unsuccessful split at a terminal boundary without marking a final-token sentinel state.
  stop-empty :: forall r. Scanner r -> Scanner r
  stop-empty current = case current of
    Scanning source split maximum window error token empties started done -> case window of
      Window owner start end -> Scanning source split maximum (Window owner 0 0) error None empties started done

  -- | Apply one legal advance, preserving absent versus empty tokens and terminal nonprogress accounting.
  advance-token :: forall r. using (io :: Io r) => Scanner r -> Int -> Option Bytes ->{IO r, Mut r} (Bool, Scanner r)
  advance-token current advance next-token = case current of
    Scanning source split maximum window error token empties started done -> case window of
      Window owner start end -> if advance < 0 then (False, failed current (ScanNegativeAdvance advance))
        else if start <= end && advance <= nat-to-int (end - start) then
          let count = nat-from-int advance in let next-window = Window owner (start + count) end in
          case next-token of
            Some payload ->
              let next-empties = token-empty-count error advance empties in
              let next = Scanning source split maximum next-window error next-token next-empties started done in
              if next-empties > 100 then
                let stopped = Scanning source split maximum next-window (Some (empty-token-error next-empties error)) next-token next-empties started True in
                (False, stopped)
              else (True, next)
            None -> let next = Scanning source split maximum next-window error None empties started done in
              case error of
                Some failure -> (False, stop-empty next)
                None -> refill next
        else (False, failed current (ScanAdvanceTooFar advance (if start <= end then end - start else 0)))

  -- | Invoke a snapshot-isolated split callback, with final-token precedence over signed advance validation.
  evaluate :: forall r. using (io :: Io r) => Scanner r ->{IO r, Mut r} (Bool, Scanner r)
  evaluate current = case current of
    Scanning source split maximum window error token empties started done -> case window of
      Window owner start end -> let terminal = case error of None -> False; Some failure -> True in
        case scan-apply-between split owner start end terminal of
          ScanStep advance next-token status -> case status of
            Some ScanFinalToken ->
              let next = Scanning source split maximum window error next-token empties started True in
              case next-token of Some payload -> (True, next); None -> (False, next)
            Some failure -> (False, failed current failure)
            None -> advance-token current advance next-token

  -- | Continue splitting buffered bytes, offering terminal empty input only when a source has actually terminated.
  scan-loop :: forall r. using (io :: Io r) => Scanner r ->{IO r, Mut r} (Bool, Scanner r)
  scan-loop current = case current of
    Scanning source split maximum window error token empties started done -> case window of
      Window owner start end -> if end > start then evaluate current
        else case error of Some failure -> evaluate current; None -> refill current

  -- | Advance to the next token, returning an explicit authoritative scanner and a Boolean indicating token presence.
  -- Final empty tokens are delivered once. Invalid advances, counts, excessive
  -- terminal empty tokens and later configuration changes are checked named failures.
  scanner-next :: forall r. using (io :: Io r) => Scanner r ->{IO r, Mut r} (Bool, Scanner r)
  scanner-next current = case current of
    Scanning source split maximum window error token empties started done -> if done then (False, current)
      else scan-loop (Scanning source split maximum window error token empties True done)

  -- | Preserve an earlier terminal cause in a direct recursive diagnostic without hiding it inside optional recursive storage.
  empty-token-error :: Nat -> Option ScanError -> ScanError
  empty-token-error count prior = case prior of None -> ScanEmptyTokens count; Some failure -> ScanEmptyTokensAfter count failure

  -- | Compute the next geometric capacity in the natural carrier, including lazy initial allocation.
  growth-capacity :: Nat -> Nat
  growth-capacity capacity = if capacity == 0 then 4096 else capacity * 2

  -- | Count only terminal tokens that do not advance input; ordinary input progress resets this counter.
  token-empty-count :: Option ScanError -> Int -> Nat -> Nat
  token-empty-count error advance prior = case error of None -> 0; Some failure -> if advance > 0 then 0 else prior + 1
