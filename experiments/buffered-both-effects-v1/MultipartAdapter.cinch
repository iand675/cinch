-- | Review-only live multipart adapters that preserve native I/O, mutation, prefixes and caller-owned close responsibility.
module Experiment.Buffered.Multipart where
  import Effect.Buffered.Core
  import Effect.Multipart
  import Data.Bytes
  import Data.Int
  import Data.Nat
  import Data.Option

  export multipart-part-buffer-source, multipart-file-buffer-source

  -- | Translate terminal status through an explicit caller policy without inspecting or rewriting the native opaque error type.
  mapped-status :: forall e. (MultipartError e -> BufferError) -> MultipartReadStatus (MultipartError e) -> Option BufferError
  mapped-status mapper status = case status of
    MultipartMore -> None
    MultipartEnd -> Some BufferEnd
    MultipartReadFailure error -> Some (mapper error)

  -- | Retain the actual live part handle; native reads occur only when this source is invoked, preserving shared session aliases.
  -- Prefix bytes remain independent of terminal/failure status. A zero request is forwarded to the native part policy.
  multipart-part-buffer-source :: forall (r :: Region) e. MultipartPart r e -> (MultipartError e -> BufferError) -> BufferSource r
  multipart-part-buffer-source part mapper = buffer-source-with-mutation (\wanted -> multipart-part-source-step part mapper wanted)

  -- | Forward a native part read without an eager snapshot or a fabricated independent cursor.
  multipart-part-source-step :: forall (r :: Region) e. MultipartPart r e -> (MultipartError e -> BufferError) -> Nat ->{IO r, Mut r} (ReadEvent, BufferSource r)
  multipart-part-source-step part mapper wanted = case multipart-part-read part wanted of
    (payload, status) -> (ReadEvent (nat-to-int (bytes-len payload)) payload (mapped-status mapper status), multipart-part-buffer-source part mapper)

  -- | Retain a borrowed live file handle without taking ownership of closing it; every alias observes native cursor advancement.
  multipart-file-buffer-source :: forall (r :: Region) e key fileHandle state. MultipartFile r e key fileHandle state -> (MultipartError e -> BufferError) -> BufferSource r
  multipart-file-buffer-source file mapper = buffer-source-with-mutation (\wanted -> multipart-file-source-step file mapper wanted)

  -- | Preserve a native file's fresh positive prefix before reporting its independent end or mapped failure.
  multipart-file-source-step :: forall (r :: Region) e key fileHandle state. MultipartFile r e key fileHandle state -> (MultipartError e -> BufferError) -> Nat ->{IO r, Mut r} (ReadEvent, BufferSource r)
  multipart-file-source-step file mapper wanted = case multipart-file-read file wanted of
    (payload, status) -> (ReadEvent (nat-to-int (bytes-len payload)) payload (mapped-status mapper status), multipart-file-buffer-source file mapper)
