-- | A live native part read retains its actual mutation effect even before adaptation.
module Main where
  import Effect.Multipart
  import Data.Bytes
  import Data.Nat
  -- | The missing mutation label must not be concealed by any source wrapper.
  bad :: forall (r :: Region) e. MultipartPart r e -> Nat ->{IO r} (Bytes, MultipartReadStatus (MultipartError e))
  bad part wanted = multipart-part-read part wanted
  -- | Source-only refusal sentinel.
  main :: Int
  main = 0
