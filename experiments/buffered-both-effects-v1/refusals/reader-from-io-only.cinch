-- | A delegated ReaderFrom operation cannot erase mutation from its supplied read callback.
module Main where
  import Effect.Buffered.Core
  import Data.Nat
  -- | The outer IO-only row is incompatible with the actual reader operation.
  bad :: forall r. (Nat ->{IO r, Mut r} ReadEvent) -> Nat ->{IO r} ReadEvent
  bad read wanted = read wanted
  -- | Source-only refusal sentinel.
  main :: Int
  main = 0
