-- | A general live buffered reader cannot be invoked from an IO-only consuming operation.
module Main where
  import Effect.Buffered.Core
  import Effect.Buffered.Reader
  import Effect.Io
  import Data.Nat
  -- | The missing mutation label is deliberate and must be rejected.
  bad :: forall r. using (io :: Io r) => BufferedReader r -> Nat ->{IO r} (ReadEvent, BufferedReader r)
  bad reader wanted = buffered-read reader wanted
  -- | Source-only refusal sentinel.
  main :: Int
  main = 0
