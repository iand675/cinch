module Main where
  import Circuit
  import syntax "../syntax/circuit.syntax.json" as circuit
  result :: Signal 2
  result = circuit!{ register (register (multiply (input {[2, 3, 4]}, input {[5, 6, 7]}))) }
  main :: Int
  main = case Circuit.observe result of
    [0, 0, 10, 18, 28] -> 0
    _ -> 1
