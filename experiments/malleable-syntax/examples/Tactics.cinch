module Main where
  import syntax "../syntax/by.syntax.json" as by

  -- The expected Fin index supplies the goal; neither goal nor evidence
  -- names are passed to the syntax library.
  safe-index :: (i :: Nat) -> (n :: Nat) -> Option (Fin n)
  safe-index i n = case decide (i < n) of
    Yes bound -> Some (Fin i (by!{ assumption }))
    No _ -> None

  -- Two distinct local facts and Nat arithmetic are needed here.
  chained-index :: (i :: Nat) -> Nat -> (n :: Nat) -> Option (Fin n)
  chained-index i j n =
    if i <= j then
      if j + 1 <= n then Some (Fin i (by!{ assumption or linear })) else None
    else None

  -- Strictness conversion: the goal is i < n, the fact i + 1 <= n.
  next-index :: (i :: Nat) -> (n :: Nat) -> Option (Fin n)
  next-index i n =
    if i + 1 <= n then Some (Fin i (by!{ linear })) else None

  value :: forall (n :: Nat). Fin n -> Nat
  value f = case f of Fin i _ -> i

  main :: Int
  main = case (safe-index 2 5, chained-index 2 3 5, next-index 4 5) of
    (Some a, Some b, Some c) ->
      if value a == 2 && value b == 2 && value c == 4 then
        case safe-index 5 5 of
          None -> 0
          Some _ -> 2
      else 1
    _ -> 3
