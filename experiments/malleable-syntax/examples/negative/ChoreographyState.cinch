module Main where
  import LocalWire
  import syntax "../../syntax/choreography.syntax.json" as choreography
  choreography!{
    Checkout roles { Buyer; Shop; Bank; }
    prefix {
      Buyer -> Shop : Order;
      Shop -> Bank : Payment;
    }
    choice Bank {
      Approved {
        Bank -> Shop : Receipt;
        Shop -> Buyer : Confirmation;
      }
      Declined {
        Bank -> Shop : Reason;
        Shop -> Buyer : Rejection;
      }
    }
  }
  bad :: Thunk {} CheckoutShopP0 %1 -> (Thunk {} CheckoutShopP2, Thunk {} CheckoutWirePayment)
  bad endpoint = send-Checkout-Shop-Payment endpoint 42
  main :: Int
  main = 0
