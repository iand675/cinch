{
  "version": 1,
  "name": "by",
  "entry": "root",
  "rules": {
    "root": {
      "pattern": [
        {
          "capture": "proof",
          "of": {
            "choice": [
              {
                "ref": "fallback"
              },
              {
                "ref": "reflexivity"
              },
              {
                "ref": "exact"
              },
              {
                "ref": "assumption"
              },
              {
                "ref": "linear"
              }
            ]
          }
        },
        "}"
      ],
      "emit": "(${proof})"
    },
    "reflexivity": {
      "pattern": "reflexivity",
      "emit": "refl"
    },
    "exact": {
      "pattern": [
        "exact",
        {
          "capture": "term",
          "of": {
            "host": true
          }
        }
      ],
      "emit": "${term}"
    },
    "fallback": {
      "pattern": [
        "assumption",
        "or",
        "linear"
      ],
      "emit": "${@search} \"assumption linear\""
    },
    "assumption": {
      "pattern": "assumption",
      "emit": "${@search} \"assumption\""
    },
    "linear": {
      "pattern": "linear",
      "emit": "${@search} \"linear\""
    }
  },
  "helpers": {
    "search": "Proof.search"
  }
}
