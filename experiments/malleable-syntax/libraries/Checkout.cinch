module Checkout where
  import LocalWire
  import syntax "../syntax/choreography.syntax.json" as choreography
  choreography!{
    Checkout roles { Buyer; Shop; Bank; }
    prefix {
      Buyer -> Shop : Order;
      Shop -> Bank : Payment;
    }
    choice Bank {
      Approved {
        Bank -> Shop : Receipt;
        Shop -> Buyer : Confirmation;
      }
      Declined {
        Bank -> Shop : Reason;
        Shop -> Buyer : Rejection;
      }
    }
  }
