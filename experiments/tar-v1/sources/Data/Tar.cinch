-- | Immutable tape-archive metadata and named codec refusals.
-- Names and extension values retain arbitrary wire bytes. Converting them to
-- text is explicit, so legacy archives do not lose invalid UTF-8. Archive
-- timestamps distinguish missing values from the Unix epoch.
module Data.Tar where
  import Data.Core
  import Data.Bytes
  import Data.List
  import Data.Nat
  import Data.Machine
  import Data.String

  export TarText, tar-text-from-bytes, tar-text-from-range, tar-text-from-string, tar-text-bytes, tar-text-string
  export TarFormat, TarAuto, TarUstar, TarPax, TarGnu, TarFormatOther
  export TarEntryType, TarRegular, TarLegacyRegular, TarHardLink, TarSymbolicLink
  export TarCharacterDevice, TarBlockDevice, TarDirectory, TarFifo, TarContinuous
  export TarPaxLocal, TarPaxGlobal, TarLongName, TarLongLink, TarSparse, TarOther
  export tar-type-byte, tar-type-from-byte, tar-header-only
  export TarTimestamp, TarPaths, TarPermissions
  export TarTimes, TarDevice, TarRecord
  export TarAttributes, TarHeader
  export TarError, TarInvalidBlockLength, TarInvalidHeader, TarInvalidNumber
  export TarFieldTooLong, TarWriteTooLong, TarWriteAfterClose, TarInsecurePath
  export TarMissingData, TarUnreferencedData, TarInvalidSparseMap, TarMetadataLimit

  -- | An immutable snapshot of wire bytes; its backing buffer is never exposed.
  data TarText where
    -- | Retain private copied bytes, including non-text names and attribute values.
    ArchiveText :: Bytes -> TarText

  -- | Copy a complete buffer without retaining a mutable caller alias.
  copy-buffer :: Bytes -> Bytes
  copy-buffer source =
    let out = bytes-new (bytes-len source) in
    let copied = bytes-copy-range out source 0 0 (bytes-len source) in
    out

  -- | Snapshot arbitrary bytes as an immutable archive name or value.
  tar-text-from-bytes :: Bytes -> TarText
  tar-text-from-bytes source = ArchiveText (copy-buffer source)

  -- | Snapshot one proved range directly, avoiding a second intermediate byte buffer.
  tar-text-from-range :: using (start + count <= bytes-len source) => (source :: Bytes) -> (start :: Nat) -> (count :: Nat) -> TarText
  tar-text-from-range source start count =
    let out = bytes-new count in
    let copied = bytes-copy-range out source 0 start count in
    ArchiveText out

  -- | Snapshot a text value's UTF-8 encoding as archive bytes.
  tar-text-from-string :: String -> TarText
  tar-text-from-string text = ArchiveText (string-to-bytes text)

  -- | Return a fresh mutable copy, preserving the metadata value's isolation.
  tar-text-bytes :: TarText -> Bytes
  tar-text-bytes value = case value of ArchiveText source -> copy-buffer source

  -- | Decode valid UTF-8 explicitly; arbitrary legacy names may return None.
  tar-text-string :: TarText -> Option String
  tar-text-string value = case value of ArchiveText source -> string-from-bytes source

  -- | A requested output format or the public best-effort input classification.
  data TarFormat where
    -- | Select a representable output automatically, or report unclassified input.
    TarAuto :: TarFormat
    -- | POSIX fixed-field headers with a split pathname prefix.
    TarUstar :: TarFormat
    -- | Extended key-value metadata with UTF-8 and fractional timestamps.
    TarPax :: TarFormat
    -- | Binary numeric fields and long-name extension entries.
    TarGnu :: TarFormat
    -- | Preserve a combined or unfamiliar signed format mask for explicit validation.
    TarFormatOther :: I64 -> TarFormat

  -- | Every recognized entry flag, plus an exact byte for future extensions.
  data TarEntryType where
    -- | Ordinary file data, flag 48.
    TarRegular :: TarEntryType
    -- | Historical zero flag, normalized using the pathname on archive traversal.
    TarLegacyRegular :: TarEntryType
    -- | A hard-link entry with no physical body.
    TarHardLink :: TarEntryType
    -- | A symbolic-link entry with no physical body.
    TarSymbolicLink :: TarEntryType
    -- | A character device with major and minor metadata.
    TarCharacterDevice :: TarEntryType
    -- | A block device with major and minor metadata.
    TarBlockDevice :: TarEntryType
    -- | A directory with no physical body.
    TarDirectory :: TarEntryType
    -- | A named pipe with no physical body.
    TarFifo :: TarEntryType
    -- | Reserved contiguous-file flag, retained without reinterpretation.
    TarContinuous :: TarEntryType
    -- | Local extended records affecting the following entry.
    TarPaxLocal :: TarEntryType
    -- | An observable global-record entry; traversal does not persist its records.
    TarPaxGlobal :: TarEntryType
    -- | An extension carrying the following pathname.
    TarLongName :: TarEntryType
    -- | An extension carrying the following link target.
    TarLongLink :: TarEntryType
    -- | A legacy sparse-file header with physical data fragments.
    TarSparse :: TarEntryType
    -- | Preserve an unrecognized wire flag exactly.
    TarOther :: InRange 0 255 Nat -> TarEntryType

  -- | Recover the exact unsigned entry flag without relying on constructor order.
  tar-type-byte :: TarEntryType -> InRange 0 255 Nat
  tar-type-byte kind = case kind of
    TarRegular -> 48
    TarLegacyRegular -> 0
    TarHardLink -> 49
    TarSymbolicLink -> 50
    TarCharacterDevice -> 51
    TarBlockDevice -> 52
    TarDirectory -> 53
    TarFifo -> 54
    TarContinuous -> 55
    TarPaxLocal -> 120
    TarPaxGlobal -> 103
    TarLongName -> 76
    TarLongLink -> 75
    TarSparse -> 83
    TarOther flag -> flag

  -- | Classify a flag while retaining every unrecognized value.
  tar-type-from-byte :: InRange 0 255 Nat -> TarEntryType
  tar-type-from-byte flag =
    if flag == 48 then TarRegular else if flag == 0 then TarLegacyRegular
    else if flag == 49 then TarHardLink else if flag == 50 then TarSymbolicLink
    else if flag == 51 then TarCharacterDevice else if flag == 52 then TarBlockDevice
    else if flag == 53 then TarDirectory else if flag == 54 then TarFifo
    else if flag == 55 then TarContinuous else if flag == 120 then TarPaxLocal
    else if flag == 103 then TarPaxGlobal else if flag == 76 then TarLongName
    else if flag == 75 then TarLongLink else if flag == 83 then TarSparse
    else TarOther flag

  -- | Identify flags whose size field does not cause a physical data body.
  tar-header-only :: TarEntryType -> Bool
  tar-header-only kind = case kind of
    TarHardLink -> True
    TarSymbolicLink -> True
    TarCharacterDevice -> True
    TarBlockDevice -> True
    TarDirectory -> True
    TarFifo -> True
    _ -> False

  -- | Unix seconds and a normalized fractional component, independent of timezone.
  data TarTimestamp where
    -- | Represent negative instants using floor seconds and nonnegative nanoseconds.
    TarTimestamp :: I64 -> InRange 0 999999999 Nat -> TarTimestamp

  -- | Entry pathname and link target, both immutable byte strings.
  data TarPaths where
    -- | Retain the archive path independently of any extraction destination.
    TarPaths :: TarText -> TarText -> TarPaths

  -- | Full signed numeric ownership and mode fields, without host-width truncation.
  data TarPermissions where
    -- | Store mode, user ID, group ID, user name and group name in wire-field order.
    TarPermissions :: I64 -> I64 -> I64 -> TarText -> TarText -> TarPermissions

  -- | Optional modification, access and change timestamps.
  data TarTimes where
    -- | Keep absent timestamps distinct from an explicitly supplied epoch.
    TarTimes :: Option TarTimestamp -> Option TarTimestamp -> Option TarTimestamp -> TarTimes

  -- | Device identifiers retained even when the entry kind does not consume them.
  data TarDevice where
    -- | Store major and minor signed fields.
    TarDevice :: I64 -> I64 -> TarDevice

  -- | One immutable extension key/value pair; parsing and encoding define duplicate policy.
  data TarRecord where
    -- | Snapshot both byte strings before retaining caller-supplied metadata.
    TarRecord :: TarText -> TarText -> TarRecord

  -- | Extended records and compatibility attributes, isolated from mutable map aliases.
  data TarAttributes where
    -- | Retain explicit records and attribute pairs; writer precedence is validated separately.
    TarAttributes :: List TarRecord -> List TarRecord -> TarAttributes

  -- | Complete logical entry metadata, separate from physical sparse framing.
  data TarHeader where
    -- | Store paths, permissions, times, device, attributes, flag, logical size and format.
    TarHeader :: TarPaths -> TarPermissions -> TarTimes -> TarDevice -> TarAttributes -> TarEntryType -> I64 -> TarFormat -> TarHeader

  -- | Named codec and archive-state refusals; transport progress is carried by event types.
  data TarError where
    -- | A block operation requires exactly 512 bytes; retain the supplied length.
    TarInvalidBlockLength :: Nat -> TarError
    -- | Header checksum, extension framing or required layout is invalid.
    TarInvalidHeader :: TarError
    -- | A numeric field contains malformed digits or exceeds its signed wire carrier.
    TarInvalidNumber :: TarError
    -- | A selected output format cannot represent the named field.
    TarFieldTooLong :: String -> TarError
    -- | A write exceeds the current entry's declared logical body.
    TarWriteTooLong :: TarError
    -- | An operation attempted to append after the archive trailer was finished.
    TarWriteAfterClose :: TarError
    -- | A pathname fails the reader's explicit locality policy; retain the parsed header separately.
    TarInsecurePath :: TarText -> TarError
    -- | Sparse metadata references physical bytes that do not exist.
    TarMissingData :: TarError
    -- | Sparse metadata leaves physical bytes unreferenced.
    TarUnreferencedData :: TarError
    -- | Sparse fragments overlap, move backwards or exceed the logical body.
    TarInvalidSparseMap :: TarError
    -- | A metadata extension exceeds the configured bounded allocation allowance.
    TarMetadataLimit :: Nat -> TarError
