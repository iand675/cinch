-- | External code cannot bypass initialization by invoking the private cell storage constructor.
module Main where
  import Effect.Tabwriter.Internal.Cell as Cell
  import Data.Int

  -- | Intentionally refused private-constructor lookup preserves the initialized-cell boundary.
  refused :: forall (r :: Region) a. Array a -> Cell.TabCellRef r a
  refused storage = Cell.StoredTabCell storage

  -- | This negative source fixture is never an executable.
  main :: Int
  main = 0
