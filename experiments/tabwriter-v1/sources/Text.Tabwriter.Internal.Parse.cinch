-- | Incremental byte-preserving tabular parsing with sealed snapshots and exact flush checkpoints.
-- Complete eight-byte intervals use a SIMD classifier; scalar fringes never read outside the owner.
-- Cells expose only fresh byte copies, and incomplete UTF-8 is counted after all contributing chunks arrive.
module Text.Tabwriter.Internal.Parse where
  import Text.Tabwriter.Config
  import Data.Bool
  import Data.Bytes
  import Data.Bytes.Build
  import Data.Bytes.Utf8 as Utf8
  import Data.Bytes.Word
  import Data.Int
  import Data.List
  import Data.Machine
  import Data.Nat

  export TabInput, TabParser, TabCell, TabRow, TabParseStep
  export tab-input, tab-input-length, tab-parser, tab-parser-config, tab-parser-clear
  export tab-parse, tab-parse-parser, tab-parse-consumed, tab-parse-flush, tab-parse-section
  export tab-parser-finalize, tab-parser-rows, tab-row-cells, tab-row-newline
  export tab-cell-bytes, tab-cell-size, tab-cell-width, tab-cell-hard

  -- | One immutable input snapshot whose mutable storage cannot be obtained by a caller.
  data TabInput where
    -- | Private independent input owner retained through parser spans and strict scans.
    Input :: Bytes -> TabInput

  -- | One checked interval retained by a cell builder; endpoints are absolute within its private snapshot.
  data Span where
    -- | Preserve ordered endpoints and the complete fixed-size owner in the defining constructor contract.
    Span :: (raw :: Bytes) -> (start :: Nat) -> refined (start <= end && end <= bytes-len raw) Nat -> Span

  -- | A completed byte cell, its formatting width and its terminating tab classification.
  data TabCell where
    -- | Private sealed bytes; width may be negative for an unfinished raw escape finalized at end of input.
    Cell :: Bytes -> Int -> Bool -> TabCell

  -- | A complete logical line or the final unterminated line, in input cell order.
  data TabRow where
    -- | Keep line termination separate from cell contents and escape-contained newline bytes.
    Row :: List TabCell -> Bool -> TabRow

  -- | Reversed complete fragments, byte size, committed width and reversed fragments awaiting width calculation.
  data Builder where
    -- | The pending measurement may cross multiple input snapshots and is decoded only as one logical segment.
    Build :: List Span -> Nat -> Int -> List Span -> Builder

  -- | Opaque parser state with reversed completed rows/cells and an optional raw or HTML end delimiter.
  data TabParser where
    -- | The original configuration and owned fragments remain private across incremental writes.
    Parser :: TabConfig -> List TabRow -> List TabCell -> Builder -> U8 -> TabParser

  -- | Parsing yields either the whole supplied suffix or one exact consumed-input automatic-flush checkpoint.
  data TabParseStep where
    -- | The flush and section flags are independent; only a raw outside-escape formfeed sets section.
    Parsed :: TabParser -> Nat -> Bool -> Bool -> TabParseStep

  -- | Snapshot arbitrary caller bytes once before retaining them in incremental parser state.
  tab-input :: Bytes -> TabInput
  tab-input raw = Input (bytes-clone raw)

  -- | Observe input bytes without exposing the immutable snapshot backing.
  tab-input-length :: TabInput -> Nat
  tab-input-length input = case input of Input raw -> bytes-len raw

  -- | Create an empty builder with no committed or pending width.
  empty-builder :: Builder
  empty-builder = Build Nil 0 0 Nil

  -- | Create initialized parser state from an already checked configuration.
  tab-parser :: TabConfig -> TabParser
  tab-parser config = Parser config Nil Nil empty-builder 0

  -- | Observe immutable configuration without exposing input owners.
  tab-parser-config :: TabParser -> TabConfig
  tab-parser-config parser = case parser of Parser config rows cells partial end -> config

  -- | Clear all buffered layout input, including unfinished escape state, while retaining configuration.
  tab-parser-clear :: TabParser -> TabParser
  tab-parser-clear parser = tab-parser (tab-parser-config parser)

  -- | Observe parser state at the exact yield boundary.
  tab-parse-parser :: TabParseStep -> TabParser
  tab-parse-parser step = case step of Parsed parser consumed flush section -> parser

  -- | Observe the absolute byte offset after all input consumed in this step.
  tab-parse-consumed :: TabParseStep -> Nat
  tab-parse-consumed step = case step of Parsed parser consumed flush section -> consumed

  -- | Test whether output must be attempted before parsing more input bytes.
  tab-parse-flush :: TabParseStep -> Bool
  tab-parse-flush step = case step of Parsed parser consumed flush section -> flush

  -- | Test whether a successful flush must be followed by the visible section marker when debugging.
  tab-parse-section :: TabParseStep -> Bool
  tab-parse-section step = case step of Parsed parser consumed flush section -> section

  -- | Observe logical cells as opaque immutable values in input order.
  tab-row-cells :: TabRow -> List TabCell
  tab-row-cells row = case row of Row cells newline -> cells

  -- | Test whether an outside-escape line break terminates this line.
  tab-row-newline :: TabRow -> Bool
  tab-row-newline row = case row of Row cells newline -> newline

  -- | Copy cell contents into fresh storage so output callbacks cannot mutate parser state.
  tab-cell-bytes :: TabCell -> Bytes
  tab-cell-bytes cell = case cell of Cell raw width hard -> bytes-clone raw

  -- | Observe exact byte size, which differs from zero-width HTML and scalar formatting width.
  tab-cell-size :: TabCell -> Nat
  tab-cell-size cell = case cell of Cell raw width hard -> bytes-len raw

  -- | Observe the exact committed scalar formatting width, including incomplete escape finalization.
  tab-cell-width :: TabCell -> Int
  tab-cell-width cell = case cell of Cell raw width hard -> width

  -- | Test whether a horizontal hard tab, rather than a vertical soft tab, terminates this cell.
  tab-cell-hard :: TabCell -> Bool
  tab-cell-hard cell = case cell of Cell raw width hard -> hard

  -- | Sum checked private interval lengths without copying fragment storage.
  spans-size :: List Span -> Nat -> Nat
  spans-size spans size = case spans of
    Nil -> size
    Cons part rest -> case part of
      Span raw start end ->
        let following = size + (end - start) in spans-size rest following

  -- | Copy forward-ordered fragments into one exact-size fresh output through checked bulk mutations.
  spans-copy :: Bytes -> Nat -> List Span -> Unit
  spans-copy output at spans = case spans of
    Nil -> ()
    Cons part rest -> case part of
      Span raw start end ->
        let width = end - start in
        if at + width <= bytes-len output then
          let copied = bytes-copy-range output raw at start width in
          let following = at + width in spans-copy output following rest
        else ()

  -- | Coalesce reversed fragments once, preserving malformed bytes and scalar encodings split across writes.
  spans-bytes :: List Span -> Bytes
  spans-bytes reversed =
    let forward = reverse reversed in
    let size = spans-size forward 0 in
    let output = bytes-new size in
    let copied = spans-copy output 0 forward in output

  -- | Append a nonempty proved interval to both complete contents and the current width segment.
  append-span :: using (start <= end, end <= bytes-len raw) => (raw :: Bytes) -> (start :: Nat) -> (end :: Nat) -> Builder -> Builder
  append-span raw start end partial = if start == end then partial else case partial of
    Build pieces size width measure ->
      let part = Span raw start end in
      let following = size + (end - start) in
      Build (Cons part pieces) following width (Cons part measure)

  -- | Commit one ordinary or raw-escaped segment using the exact malformed-byte UTF-8 counting policy.
  commit-width :: Builder -> Builder
  commit-width partial = case partial of
    Build pieces size width measure ->
      let raw = spans-bytes measure in
      let count = Utf8.utf8-count raw in
      let following = width + nat-to-int count in Build pieces size following Nil

  -- | Finish a raw escape, tag or entity; all segment contents stay byte-for-byte intact.
  close-escape :: TabConfig -> U8 -> Builder -> Builder
  close-escape config end partial =
    if eq-u8 end 255 then case commit-width partial of
      Build pieces size width measure ->
        let following = if tab-config-strip-escape config then width else width - 2 in
        Build pieces size following Nil
    else case partial of
      Build pieces size width measure ->
        let following = if eq-u8 end 59 then width + 1 else width in
        Build pieces size following Nil

  -- | Coalesce one completed cell once; later output observations always make independent copies.
  finish-cell :: Builder -> Bool -> TabCell
  finish-cell partial hard = case partial of
    Build pieces size width measure -> let raw = spans-bytes pieces in Cell raw width hard

  -- | Observe a builder's byte size without decoding incomplete UTF-8 or completing escape state.
  builder-size :: Builder -> Nat
  builder-size partial = case partial of Build pieces size width measure -> size

  -- | Classify eight exact bytes without depending on host byte order or reading neighboring storage.
  prim ordinary-eight :: U64 -> U8 -> Bool -> Bool where
    llvm {
      %bytes = bitcast i64 %0 to <8 x i8>
      %control = icmp uge <8 x i8> %bytes, <i8 9, i8 9, i8 9, i8 9, i8 9, i8 9, i8 9, i8 9>
      %upper = icmp ule <8 x i8> %bytes, <i8 12, i8 12, i8 12, i8 12, i8 12, i8 12, i8 12, i8 12>
      %breaks = and <8 x i1> %control, %upper
      %escape = icmp eq <8 x i8> %bytes, <i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1>
      %tag = icmp eq <8 x i8> %bytes, <i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60, i8 60>
      %entity = icmp eq <8 x i8> %bytes, <i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38, i8 38>
      %html = or <8 x i1> %tag, %entity
      %filter = icmp ne i8 %2, 0
      %selected-html = select i1 %filter, <8 x i1> %html, <8 x i1> zeroinitializer
      %raw = or <8 x i1> %breaks, %escape
      %outside = or <8 x i1> %raw, %selected-html
      %head = insertelement <8 x i8> poison, i8 %1, i32 0
      %ends = shufflevector <8 x i8> %head, <8 x i8> poison, <8 x i32> zeroinitializer
      %matching = icmp eq <8 x i8> %bytes, %ends
      %escaped = icmp ne i8 %1, 0
      %special = select i1 %escaped, <8 x i1> %matching, <8 x i1> %outside
      %bits = bitcast <8 x i1> %special to i8
      %clear = icmp eq i8 %bits, 0
      %value = zext i1 %clear to i8
      ret i8 %value
    }

  -- | Recognize one scalar fringe token using the same byte-level modes as the SIMD block classifier.
  special-byte :: Bool -> U8 -> InRange 0 255 Nat -> Bool
  special-byte filter end byte = if ne-u8 end 0 then byte == u8-to-nat end else
    (9 <= byte && byte <= 12) || byte == 255 || (filter && (byte == 60 || byte == 38))

  -- | Find the next exact control/delimiter byte, skipping only fully available token-free blocks.
  find-special :: Bytes -> Nat -> Bool -> U8 -> Nat
  find-special raw at filter end = if at >= bytes-len raw then bytes-len raw else
    if at + 8 <= bytes-len raw then
      let word = bytes-read-le64 raw at in
      let ordinary = ordinary-eight word end filter in
      if ordinary then let following = at + 8 in find-special raw following filter end else
        let byte = bytes-get raw at in
        if special-byte filter end byte then at else let following = at + 1 in find-special raw following filter end
    else
      let byte = bytes-get raw at in
      if special-byte filter end byte then at else let following = at + 1 in find-special raw following filter end

  -- | Parse an immutable snapshot suffix until input end or an automatic-flush boundary.
  parse-from :: TabParser -> Bytes -> Nat -> Nat -> TabParseStep
  parse-from parser raw at start = case parser of
    Parser config rows cells partial end ->
      let filter = tab-config-filter-html config in
      let token = find-special raw at filter end in
      if token < bytes-len raw && start <= token then
        let byte = bytes-get raw token in
        let following = token + 1 in
        if ne-u8 end 0 then
          let finish = if eq-u8 end 255 && tab-config-strip-escape config then token else following in
          if start <= finish && finish <= bytes-len raw then
            let appended = append-span raw start finish partial in
            let closed = close-escape config end appended in
            let updated = Parser config rows cells closed 0 in parse-from updated raw following following
          else Parsed parser at False False
        else if byte == 255 || byte == 60 || byte == 38 then
          let appended = append-span raw start token partial in
          let committed = commit-width appended in
          let mark = ((if byte == 255 then 255 else if byte == 60 then 62 else 59) :: U8) in
          let next = if byte == 255 && tab-config-strip-escape config then following else token in
          let updated = Parser config rows cells committed mark in parse-from updated raw following next
        else
          let appended = append-span raw start token partial in
          let committed = commit-width appended in
          let cell = finish-cell committed (byte == 9) in
          let completed = Cons cell cells in
          if byte == 10 || byte == 12 then
            let row = Row (reverse completed) True in
            let updated = Parser config (Cons row rows) Nil empty-builder 0 in
            let one = case cells of
                  Nil -> True
                  Cons _ _ -> False in
            if byte == 12 || one then Parsed updated following True (byte == 12)
            else parse-from updated raw following following
          else
            let updated = Parser config rows completed empty-builder 0 in parse-from updated raw following following
      else
        let finish = bytes-len raw in
        if start <= finish then
          let appended = append-span raw start finish partial in
          Parsed (Parser config rows cells appended end) finish False False
        else Parsed parser at False False

  -- | Consume from an absolute snapshot offset; an offset beyond input is refused without changing state.
  tab-parse :: TabParser -> TabInput -> Nat -> TabParseStep
  tab-parse parser input at = case input of
    Input raw -> if at <= bytes-len raw then parse-from parser raw at at else Parsed parser at False False

  -- | Complete a nonempty final cell, treating unfinished escapes/tags/entities as complete for layout.
  -- Ordinary trailing text does not need a committed width because its cell is never an aligned column.
  tab-parser-finalize :: TabParser -> TabParser
  tab-parser-finalize parser = case parser of
    Parser config rows cells partial end -> if builder-size partial > 0 then
      let closed = if eq-u8 end 0 then partial else close-escape config end partial in
      let cell = finish-cell closed False in Parser config rows (Cons cell cells) empty-builder 0
      else parser

  -- | Observe completed rows plus the final unterminated row without exposing any private byte backing.
  tab-parser-rows :: TabParser -> List TabRow
  tab-parser-rows parser = case parser of
    Parser config rows cells partial end ->
      let final = Row (reverse cells) False in reverse (Cons final rows)
