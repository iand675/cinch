-- | Incremental aligned byte output through explicit owned output capabilities.
-- Aliases share one initialized writer state. Input and output offers are independent snapshots;
-- flushing never closes borrowed outputs, and initialization replaces pending input without flushing it.
-- Operations on one writer require external synchronization; same-call reentry is a named refusal.
module Effect.Tabwriter where
  import Text.Tabwriter.Config
  import Text.Tabwriter.Internal.Parse
  import Text.Tabwriter.Internal.Layout
  import Effect.Tabwriter.Internal.Cell as Cell
  import Data.Bool
  import Data.Bytes
  import Data.Int
  import Data.List
  import Data.Nat
  import Data.Option

  export TabOutput, tab-output, tab-output-with-mutation, tab-output-write
  export TabWriter, tab-writer, tab-writer-init, tab-writer-write, tab-writer-flush, tab-writer-as-output
  export TabWriteOutcome, tab-write-consumed, tab-write-error
  export TabWriteError, TabOutputFailure, TabShortWrite, TabLayoutFailure, TabWriterBusy

  -- | An output's exact reported count, optional original error and advanced capability are independent observations.
  data TabOutput (r :: Region) e where
    -- | Private ordinary output callback requiring only I/O in its defining region.
    Output :: (Bytes ->{IO r} (Int, Option e, TabOutput r e)) -> TabOutput r e
    -- | Private live output callback preserving both I/O and mutation in the same region.
    MutableOutput :: (Bytes ->{IO r, Mut r} (Int, Option e, TabOutput r e)) -> TabOutput r e

  -- | A checked output failure never replaces or stringifies an original callback error.
  data TabWriteError e where
    -- | Preserve the callback's exact owned error payload, even when its reported count is also malformed.
    TabOutputFailure :: e -> TabWriteError e
    -- | An output returned a count unequal to the offered length without an original error.
    TabShortWrite :: Nat -> Int -> TabWriteError e
    -- | Mathematical layout coordinates cannot safely form the next output operation.
    TabLayoutFailure :: TabLayoutError -> TabWriteError e
    -- | An output callback attempted to initialize, flush or write the currently active writer.
    TabWriterBusy :: TabWriteError e

  -- | The input checkpoint consumed by one write and its optional failure are separate from emitted-byte progress.
  data TabWriteOutcome e where
    -- | Private immutable write observations; failure retains the exact consumed-input boundary.
    WriteOutcome :: Nat -> Option (TabWriteError e) -> TabWriteOutcome e

  -- | Private parser, advanced output, retained active width path and same-call reentry flag.
  data WriterState (r :: Region) e where
    -- | Buffer contents and callback storage stay private across alias-visible replacements.
    WriterState :: TabParser -> TabOutput r e -> List Nat -> Bool -> WriterState r e

  -- | An initialized opaque mutable writer; all aliases retain the same logical state reference.
  data TabWriter (r :: Region) e where
    -- | Private state reference; neither its array nor its retained byte buffers can escape.
    Writer :: Cell.TabCellRef r (WriterState r e) -> TabWriter r e

  -- | Construct an ordinary output preserving its signed count, positive-prefix errors and advanced handle.
  tab-output :: forall (r :: Region) e. (Bytes ->{IO r} (Int, Option e, TabOutput r e)) -> TabOutput r e
  tab-output step = Output step

  -- | Construct a live output without erasing mutation or changing its I/O region identity.
  tab-output-with-mutation :: forall (r :: Region) e. (Bytes ->{IO r, Mut r} (Int, Option e, TabOutput r e)) -> TabOutput r e
  tab-output-with-mutation step = MutableOutput step

  -- | Invoke one exact output call, including empty input; this operation does not retry a short write.
  tab-output-write :: forall (r :: Region) e. TabOutput r e -> Bytes ->{IO r, Mut r} (Int, Option e, TabOutput r e)
  tab-output-write output raw = case output of
    Output step -> step raw
    MutableOutput step -> step raw

  -- | Observe how many input bytes were consumed, independently of underlying output counts.
  tab-write-consumed :: forall e. TabWriteOutcome e -> Nat
  tab-write-consumed outcome = case outcome of WriteOutcome consumed error -> consumed

  -- | Observe an original output error or named checked refusal without dropping its payload.
  tab-write-error :: forall e. TabWriteOutcome e -> Option (TabWriteError e)
  tab-write-error outcome = case outcome of WriteOutcome consumed error -> error

  -- | Construct initialized state without calling, flushing or closing the supplied output.
  tab-writer :: forall (r :: Region) e. TabConfig -> TabOutput r e ->{IO r} TabWriter r e
  tab-writer config output =
    let parser = tab-parser config in
    let storage = Cell.cell-new (WriterState parser output Nil False) in Writer storage

  -- | Replace pending input and output atomically with respect to same-call reentry; aliases retain this handle.
  -- The old output is neither flushed nor closed. Configuration is already validated before this operation.
  tab-writer-init :: forall (r :: Region) e. TabWriter r e -> TabConfig -> TabOutput r e ->{IO r} (Option (TabWriteError e), TabWriter r e)
  tab-writer-init writer config output = case writer of
    Writer storage -> case Cell.cell-read storage of
      WriterState parser previous path busy -> if busy then (Some TabWriterBusy, writer) else
        let initialized = Cell.cell-write storage (WriterState (tab-parser config) output Nil False) in (None, writer)

  -- | Invoke one fresh offer and commit the advanced output before inspecting its error or reported count.
  -- No offset, slice or subtraction uses an untrusted reported count.
  send-offer :: forall (r :: Region) e. Cell.TabCellRef r (WriterState r e) -> WriterState r e -> Bytes ->{IO r, Mut r} (Option (TabWriteError e), TabOutput r e)
  send-offer storage state raw = case state of
    WriterState parser output path busy ->
      let prepared = Cell.cell-write storage (WriterState parser output path True) in
      let (count, error, advanced) = tab-output-write output raw in
      let committed = Cell.cell-write storage (WriterState parser advanced path True) in
      case error of
        Some original -> (Some (TabOutputFailure original), advanced)
        None ->
          let wanted = bytes-len raw in
          let exact = nat-to-int wanted in
          if count == exact then (None, advanced) else (Some (TabShortWrite wanted count), advanced)

  -- | Drain exact layout offers, retaining each offered active width path when an output refuses progress.
  drain-layout :: forall (r :: Region) e. Cell.TabCellRef r (WriterState r e) -> TabLayout -> WriterState r e ->{IO r, Mut r} (Option (TabWriteError e), WriterState r e)
  drain-layout storage layout state = case state of
    WriterState parser output path busy -> case tab-layout-next layout of
      TabLayoutDone -> (None, state)
      TabLayoutRefused error -> (Some (TabLayoutFailure error), state)
      TabOffer raw next active ->
        let current = WriterState parser output active True in
        let (error, advanced) = send-offer storage current raw in
        let following = WriterState parser advanced active True in
        case error of
          Some failure -> (Some failure, following)
          None -> drain-layout storage next following

  -- | Release the same-call reentry guard while preserving the exact parser/output/path reached by a write.
  release-write :: forall (r :: Region) e. Cell.TabCellRef r (WriterState r e) -> WriterState r e -> Nat -> Option (TabWriteError e) ->{IO r} TabWriteOutcome e
  release-write storage state consumed error = case state of
    WriterState parser output path busy ->
      let released = Cell.cell-write storage (WriterState parser output path False) in WriteOutcome consumed error

  -- | Parse until each automatic flush, preserving failed-write buffers and resuming only after successful output.
  write-from :: forall (r :: Region) e. Cell.TabCellRef r (WriterState r e) -> TabInput -> Nat -> WriterState r e ->{IO r, Mut r} TabWriteOutcome e
  write-from storage input at state = case state of
    WriterState parser output path busy ->
      let parsed = tab-parse parser input at in
      let updated = tab-parse-parser parsed in
      let consumed = tab-parse-consumed parsed in
      let current = WriterState updated output path True in
      if tab-parse-flush parsed then
        let layout = tab-layout updated path in
        let (error, reached) = drain-layout storage layout current in
        case error of
          Some failure -> release-write storage reached consumed (Some failure)
          None -> case reached of
            WriterState retained advanced active guarded ->
              let cleared = tab-parser-clear updated in
              let following = WriterState cleared advanced Nil True in
              let reset = Cell.cell-write storage following in
              if tab-parse-section parsed && tab-config-debug (tab-parser-config updated) then
                let marker = bytes-from-list [45, 45, 45, 10] in
                let (marker-error, marker-output) = send-offer storage following marker in
                let marked = WriterState cleared marker-output Nil True in
                case marker-error of
                  Some failure -> release-write storage marked consumed (Some failure)
                  None -> write-from storage input consumed marked
              else write-from storage input consumed following
      else release-write storage current consumed None

  -- | Snapshot arbitrary input and write until completion or the exact automatic-flush failure checkpoint.
  -- Failed automatic output preserves buffered layout; no sticky error is invented, and aliases share progress.
  tab-writer-write :: forall (r :: Region) e. TabWriter r e -> Bytes ->{IO r, Mut r} (TabWriteOutcome e, TabWriter r e)
  tab-writer-write writer raw = case writer of
    Writer storage -> case Cell.cell-read storage of
      WriterState parser output path busy -> if busy then (WriteOutcome 0 (Some TabWriterBusy), writer) else
        let input = tab-input raw in
        let current = WriterState parser output path True in
        let activated = Cell.cell-write storage current in
        let outcome = write-from storage input 0 current in (outcome, writer)

  -- | Complete pending formatting and reset input/escape/width state even when output refuses or layout is invalid.
  -- The advanced borrowed output remains installed and reusable; this operation never closes it.
  tab-writer-flush :: forall (r :: Region) e. TabWriter r e ->{IO r, Mut r} (Option (TabWriteError e), TabWriter r e)
  tab-writer-flush writer = case writer of
    Writer storage -> case Cell.cell-read storage of
      WriterState parser output path busy -> if busy then (Some TabWriterBusy, writer) else
        let current = WriterState parser output path True in
        let activated = Cell.cell-write storage current in
        let layout = tab-layout parser path in
        let (error, reached) = drain-layout storage layout current in
        case reached of
          WriterState retained advanced active guarded ->
            let cleared = tab-parser-clear parser in
            let reset = Cell.cell-write storage (WriterState cleared advanced Nil False) in (error, writer)

  -- | Adapt this live shared writer as an output capability without flushing, closing or snapshotting its state.
  -- Input errors remain typed payloads and the returned advanced capability retains the same writer handle.
  tab-writer-as-output :: forall (r :: Region) e. TabWriter r e -> TabOutput r (TabWriteError e)
  tab-writer-as-output writer = tab-output-with-mutation (\raw ->
    let (outcome, advanced) = tab-writer-write writer raw in
    let count = nat-to-int (tab-write-consumed outcome) in
    let error = tab-write-error outcome in
    (count, error, tab-writer-as-output advanced))
