-- | Iterative elastic-column layout yielding exact fresh output offers and their active width paths.
-- Row tails share immutable cells, padding remains a compact count until offered, and no native recursion
-- grows with the number of columns. Layout arithmetic has named refusals instead of machine overflow.
module Text.Tabwriter.Internal.Layout where
  import Text.Tabwriter.Config
  import Text.Tabwriter.Internal.Parse
  import Data.Bool
  import Data.Bytes
  import Data.Int
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result

  export TabLayout, TabLayoutStep, TabOffer, TabLayoutDone, TabLayoutRefused
  export TabLayoutError, TabLayoutOverflow, TabPaddingWidth
  export tab-layout, tab-layout-next

  -- | A mathematical layout value cannot be represented by the supported output-coordinate interval.
  data TabLayoutError where
    -- | Preserve the exact value that exceeds signed64-bit coordinates.
    TabLayoutOverflow :: Int -> TabLayoutError
    -- | Preserve a cell's scalar width and the incompatible requested column width.
    TabPaddingWidth :: Int -> Nat -> TabLayoutError

  -- | A complete original row and its remaining cell tail at one column depth.
  data RowCursor where
    -- | Original cells are retained once; descending a column advances only the immutable tail.
    Cursor :: TabRow -> List TabCell -> RowCursor

  -- | Output state for one original row, without expanding padding or copying cell bytes early.
  data RowState where
    -- | Remaining cells/widths, complete active width path, newline flag, leading indentation mode and first-cell flag.
    RowState :: List TabCell -> List Nat -> List Nat -> Bool -> Bool -> Bool -> RowState

  -- | An explicit work item whose fields remain private and never expose a mutable cell owner.
  data Task where
    -- | Find contiguous column blocks and schedule shallower remainder work.
    Columns :: List RowCursor -> List Nat -> Task
    -- | Emit one original row under already resolved widths.
    RowTask :: RowState -> Task
    -- | Apply one cell's left/right padding after any debug separator.
    CellTask :: TabCell -> Option Nat -> RowState -> Task
    -- | Copy one cell only when its exact offer is requested.
    TextTask :: TabCell -> List Nat -> Task
    -- | Emit at most eight repeated bytes per call, preserving the required final empty offer for count zero.
    PadTask :: Nat -> U8 -> List Nat -> Task
    -- | Defer checked padding arithmetic until the same left/right output position where padding is required.
    PaddingFor :: Int -> Nat -> Bool -> List Nat -> Task
    -- | Emit a fresh column marker before the next cell.
    MarkerTask :: List Nat -> Task

  -- | Opaque resumable layout state with an explicit bounded-stack work list.
  data TabLayout where
    -- | Immutable configuration and pending work retain all cell owners until their final offers complete.
    Layout :: TabConfig -> List Task -> TabLayout

  -- | One fresh output offer, successful completion, or a named checked layout refusal.
  data TabLayoutStep where
    -- | The byte offer is fresh; the continuation retains no alias to that offered mutable buffer.
    TabOffer :: Bytes -> TabLayout -> List Nat -> TabLayoutStep
    -- | All buffered rows and the final outstanding empty offer have completed.
    TabLayoutDone :: TabLayoutStep
    -- | Layout cannot proceed safely; no additional underlying offer was made by this step.
    TabLayoutRefused :: TabLayoutError -> TabLayoutStep

  -- | Build initial row cursors at the active retained width depth, without copying any cell data.
  row-cursors :: List TabRow -> Nat -> List RowCursor -> List RowCursor
  row-cursors rows depth reversed = case rows of
    Nil -> reverse reversed
    Cons row rest ->
      let cells = tab-row-cells row in
      let remaining = drop depth cells in
      let current = Cursor row remaining in row-cursors rest depth (Cons current reversed)

  -- | Count active column coordinates directly as a natural offset, without an integer conversion assumption.
  width-depth :: List Nat -> Nat -> Nat
  width-depth widths depth = case widths of
    Nil -> depth
    Cons width rest -> let following = depth + 1 in width-depth rest following

  -- | Create layout over a finalized parser and an existing forward active width path.
  -- Passing a retained path preserves replay behavior after a failed automatic output flush.
  tab-layout :: TabParser -> List Nat -> TabLayout
  tab-layout parser active =
    let complete = tab-parser-finalize parser in
    let rows = tab-parser-rows complete in
    let depth = width-depth active 0 in
    let cursors = row-cursors rows depth Nil in
    let path = reverse active in Layout (tab-parser-config parser) (Cons (Columns cursors path) Nil)

  -- | Measure one contiguous block and advance its row tails at exactly one column depth.
  -- The final cell of every row is never an aligned column, even if its original delimiter was a tab.
  column-block :: TabConfig -> List RowCursor -> List RowCursor -> Nat -> Bool -> Result TabLayoutError (List RowCursor, List RowCursor, Nat, Bool)
  column-block config rows reversed width discardable = case rows of
    Nil -> Ok (reverse reversed, Nil, width, discardable)
    Cons current rest -> case current of
      Cursor original remaining -> case remaining of
        Cons cell (Cons next tail) ->
          let cell-width = tab-cell-width cell in
          let padded = cell-width + nat-to-int (tab-config-padding config) in
          if padded > 9223372036854775807 then Err (TabLayoutOverflow padded) else
            let candidate = if 0 <= padded then (nat-from-int padded :: Nat) else 0 in
            let following = if width < candidate then candidate else width in
            let soft-empty = cell-width <= 0 && not (tab-cell-hard cell) in
            let cursor = Cursor original (Cons next tail) in
            column-block config rest (Cons cursor reversed) following (discardable && soft-empty)
        _ -> Ok (reverse reversed, rows, width, discardable)

  -- | Compute repeated padding counts without overflowing a machine addition, division or multiplication.
  -- No tab offer is made when tab padding has width zero; ordinary zero padding is an observable empty offer.
  padding-spec :: TabConfig -> Int -> Nat -> Bool -> Result TabLayoutError (Option (Nat, U8))
  padding-spec config text-width column-width indentation =
    let pad = tab-config-pad-byte config in
    if eq-u8 pad 9 || indentation then
      let unit = tab-config-tab-width config in
      if unit == 0 then Ok None else
        let numerator = column-width + unit - 1 in
        case checked-div numerator unit of
          None -> Err (TabPaddingWidth text-width column-width)
          Some quotient ->
            let rounded = quotient * unit in
            let exact = nat-to-int rounded in
            if exact > 9223372036854775807 then Err (TabLayoutOverflow exact) else
              let remaining = exact - text-width in
              if 0 <= remaining then
                let count = nat-from-int remaining in
                let total = count + unit - 1 in
                case checked-div total unit of
                  None -> Err (TabPaddingWidth text-width column-width)
                  Some tabs -> Ok (Some (tabs, 9))
              else Err (TabPaddingWidth text-width column-width)
    else
      let remaining = nat-to-int column-width - text-width in
      if remaining < 0 then Err (TabPaddingWidth text-width column-width)
      else if remaining > 9223372036854775807 then Err (TabLayoutOverflow remaining)
      else Ok (Some (nat-from-int remaining, pad))

  -- | Allocate and initialize one exact padding offer through a logarithmic checked prefix fill.
  repeat-byte :: U8 -> Nat -> Bytes
  repeat-byte byte count =
    let output = bytes-new count in
    if count > 0 then
      let initialized = bytes-set output 0 (u8-to-nat byte) in
      let completed = repeat-fill output 1 in output
    else output

  -- | Extend a proved initialized prefix without reading any uninitialized or neighboring bytes.
  repeat-fill :: Bytes -> Nat -> Unit
  repeat-fill output filled = if filled > 0 && filled < bytes-len output then
    let left = bytes-len output - filled in
    let count = if filled < left then filled else left in
    if filled + count <= bytes-len output && count <= bytes-len output then
      let copied = bytes-copy-range output output filled 0 count in
      let following = filled + count in repeat-fill output following
    else ()
    else ()

  -- | Schedule one cell's text and lazy padding in exact left/right output order.
  cell-tasks :: TabConfig -> TabCell -> Option Nat -> RowState -> List Task -> List Task
  cell-tasks config cell width next rest = case next of
    RowState cells widths path newline indentation first ->
      let following = Cons (RowTask next) rest in
      let size = tab-cell-size cell in
      case width of
        None -> if size == 0 then following else Cons (TextTask cell path) following
        Some column ->
          let leading = if size == 0 then indentation else False in
          let padding = PaddingFor (tab-cell-width cell) column leading path in
          if size == 0 then Cons padding following
          else
            let text = TextTask cell path in
            if tab-config-align-right config then Cons padding (Cons text following)
            else Cons text (Cons padding following)

  -- | Yield one exact fresh output call or advance private work until the next call/refusal/completion.
  tab-layout-next :: TabLayout -> TabLayoutStep
  tab-layout-next layout = case layout of
    Layout config tasks -> case tasks of
      Nil -> TabLayoutDone
      Cons task rest -> case task of
        Columns rows reversed-widths -> case rows of
          Nil -> tab-layout-next (Layout config rest)
          Cons current following -> case current of
            Cursor original remaining -> case remaining of
              Cons cell (Cons next tail) ->
                let minimum = tab-config-min-width config in
                case column-block config rows Nil minimum True of
                  Err error -> TabLayoutRefused error
                  Ok (block, after, maximum, discardable) ->
                    let width = ((if discardable && tab-config-discard-empty-columns config then 0 else maximum) :: Nat) in
                    let below = Columns after reversed-widths in
                    let inside = Columns block (Cons width reversed-widths) in
                    tab-layout-next (Layout config (Cons inside (Cons below rest)))
              _ ->
                let forward = reverse reversed-widths in
                let state = RowState (tab-row-cells original) forward forward (tab-row-newline original) (tab-config-indent config) True in
                let following-task = Columns following reversed-widths in
                let pending = Cons (RowTask state) (Cons following-task rest) in
                tab-layout-next (Layout config pending)
        RowTask state -> case state of
          RowState cells widths path newline indentation first -> case cells of
            Nil ->
              let raw = if newline then bytes-from-list [10] else bytes-new 0 in
              TabOffer raw (Layout config rest) path
            Cons cell following ->
              let (width, remaining) = case widths of
                    Nil -> (None, Nil)
                    Cons current tail -> (Some current, tail) in
              let leading = if tab-cell-size cell == 0 then indentation else False in
              let next = RowState following remaining path newline leading False in
              let write = CellTask cell width next in
              let pending = if not first && tab-config-debug config then Cons (MarkerTask path) (Cons write rest) else Cons write rest in
              tab-layout-next (Layout config pending)
        CellTask cell width following ->
          let pending = cell-tasks config cell width following rest in tab-layout-next (Layout config pending)
        TextTask cell path -> let raw = tab-cell-bytes cell in TabOffer raw (Layout config rest) path
        MarkerTask path -> let raw = bytes-from-list [124] in TabOffer raw (Layout config rest) path
        PadTask count byte path ->
          if count > 8 then
            let remaining = count - 8 in
            let pending = Cons (PadTask remaining byte path) rest in
            let raw = repeat-byte byte 8 in TabOffer raw (Layout config pending) path
          else let raw = repeat-byte byte count in TabOffer raw (Layout config rest) path
        PaddingFor width column indentation path -> case padding-spec config width column indentation of
          Err error -> TabLayoutRefused error
          Ok None -> tab-layout-next (Layout config rest)
          Ok (Some (count, byte)) ->
            let pending = Cons (PadTask count byte path) rest in tab-layout-next (Layout config pending)
