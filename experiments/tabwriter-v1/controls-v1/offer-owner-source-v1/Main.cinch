-- | Verify fresh output ownership, explicit valid-text refusal and bounded-stack wide-column formatting.
module Main where
  import Text.Tabwriter
  import Data.Bool
  import Data.Bytes
  import Data.Bytes.Build
  import Data.Int
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Result
  import Data.String

  -- | Compare arbitrary output without text decoding or replacement.
  same :: Bytes -> Bytes -> Bool
  same first second = eq-i64 (bytes-compare first second) 0

  -- | Different newline offers must be independently mutable, and caller input mutations cannot alter prior offers.
  fresh-offers :: TabConfig -> Bool
  fresh-offers config =
    let input = bytes-from-list [65, 9, 88, 10, 66, 9, 89, 10] in
    case tab-format-offers config input of
      Err _ -> False
      Ok (Cons a (Cons pad (Cons x (Cons newline (Cons b (Cons pad2 (Cons y (Cons newline2 (Cons empty Nil))))))))) ->
        if bytes-len input > 0 && bytes-len a == 1 && bytes-len newline == 1 && bytes-len newline2 == 1 then
          let changed-input = bytes-set input 0 90 in
          let changed-newline = bytes-set newline 0 81 in
          bytes-get input 0 == 90 && bytes-get newline 0 == 81 &&
            same a (bytes-from-list [65]) && bytes-get newline2 0 == 10 && bytes-len empty == 0
        else False
      _ -> False

  -- | Valid text produces valid independent text without exposing either string's immutable backing.
  valid-text :: TabConfig -> Bool
  valid-text config = case tab-format-string config "A\tB\n" of
    Err _ -> False
    Ok output -> eq-i64 (string-compare output "A B\n") 0

  -- | Invalid padding output is retained losslessly in a named error instead of being repaired or discarded.
  invalid-text-output :: Bool
  invalid-text-output = case tab-config 0 4 1 255 0 of
    Err _ -> False
    Ok config -> case tab-format-string config "A\tB\n" of
      Err (TabTextInvalidOutput output) -> same output (bytes-from-list [65, 255, 66, 10])
      _ -> False

  -- | Ten thousand columns exercise the explicit work stack and iterative managed release under fixed consumer limits.
  wide-columns :: TabConfig -> Bool
  wide-columns config =
    let input = bytes-repeat 10000 (bytes-from-list [97, 9]) in
    let prefix = bytes-repeat 9999 (bytes-from-list [97, 32]) in
    let expected = bytes-concat (Cons prefix (Cons (bytes-from-list [97]) Nil)) in
    case tab-format-bytes config input of
      Err _ -> False
      Ok output -> same output expected

  -- | A full sixty-four-kibibyte table compares every raw output byte with an independent repeated-row expectation.
  large-table :: TabConfig -> Bool
  large-table config =
    let input = bytes-repeat 16384 (bytes-from-list [97, 9, 98, 10]) in
    let expected = bytes-repeat 16384 (bytes-from-list [97, 32, 98, 10]) in
    case tab-format-bytes config input of
      Err _ -> False
      Ok output -> same output expected

  -- | Return distinct ownership, text-policy and wide-layout failure groups.
  main :: Int
  main = case tab-config 0 4 1 32 0 of
    Err _ -> 1
    Ok config -> if not (fresh-offers config) then 2
      else if not (valid-text config) then 3
      else if not invalid-text-output then 4
      else if not (wide-columns config) then 5
      else if not (large-table config) then 6
      else 0
