-- | Verify the twelve explicit native counterparts of recorded panic and uninitialized-receiver observations.
-- These checked outcomes are deliberately distinct from a panic that returned no count.
module Main where
  import Text.Tabwriter
  import Effect.Tabwriter
  import Fixture.Tabwriter.Protocol
  import Effect.Io
  import Data.Bool
  import Data.Bytes
  import Data.Bytes.Build
  import Data.Int
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String

  -- | Match coordinate identity without deriving equality over private representations.
  same-dimension :: TabDimension -> TabDimension -> Bool
  same-dimension first second = case first of
    TabMinimumWidth -> case second of
      TabMinimumWidth -> True
      _ -> False
    TabTabWidth -> case second of
      TabTabWidth -> True
      _ -> False
    TabPadding -> case second of
      TabPadding -> True
      _ -> False

  -- | Produce an exact negative-coordinate request through the checked configuration constructor.
  negative-config :: TabDimension -> Result TabConfigError TabConfig
  negative-config coordinate = case coordinate of
    TabMinimumWidth -> tab-config (0 - 1) 4 1 32 0
    TabTabWidth -> tab-config 0 (0 - 1) 1 32 0
    TabPadding -> tab-config 0 4 (0 - 1) 32 0

  -- | A constructor refusal retains the requested coordinate and original signed value.
  negative-refusal :: TabDimension -> Bool
  negative-refusal coordinate = case negative-config coordinate of
    Err (TabConfigNegative actual original) -> same-dimension coordinate actual && original == (0 - 1)
    _ -> False

  -- | Test successful operations without consuming or replacing typed original errors.
  no-error :: forall e. Option e -> Bool
  no-error error = case error of
    None -> True
    Some _ -> False

  -- | Default bounded observation policy keeps every callback offer distinct from formatter expectations.
  ordinary-policy :: SpyPolicy
  ordinary-policy = Policy None None None 1024 4096

  -- | Invalid configuration is refused before reset can discard pending cells or switch a borrowed output.
  invalid-initialize :: forall (r :: Region). TabConfig -> TabDimension ->{IO r, Mut r} Bool
  invalid-initialize config coordinate =
    let first = spy-new ordinary-policy in
    let second = spy-new ordinary-policy in
    let output = spy-capability first in
    let writer = tab-writer config output in
    let alias = writer in
    let (outcome, advanced) = tab-writer-write writer (string-to-bytes "A\tB") in
    let refused = case negative-config coordinate of
          Err (TabConfigNegative actual original) -> same-dimension coordinate actual && original == (0 - 1)
          Ok accepted ->
            let (error, reset) = tab-writer-init advanced accepted (spy-capability second) in False
          _ -> False in
    let (error, final) = tab-writer-flush alias in
    let expected = Cons (ExpectedOffer (string-to-bytes "A") 1 1 None)
          (Cons (ExpectedOffer (string-to-bytes " ") 1 1 None)
          (Cons (ExpectedOffer (string-to-bytes "B") 1 1 None)
          (Cons (ExpectedOffer (bytes-new 0) 0 0 None) Nil))) in
    refused && no-error (tab-write-error outcome) && no-error error &&
      spy-matches first expected (string-to-bytes "A B") && spy-matches second Nil (bytes-new 0)

  -- | Exact successful replay after a checked callback failure preserves each byte and empty offer.
  replay-offers :: List ExpectedOffer
  replay-offers = Cons (ExpectedOffer (string-to-bytes "a") 1 1 None)
    (Cons (ExpectedOffer (string-to-bytes "  ") 2 2 None)
    (Cons (ExpectedOffer (string-to-bytes "b") 1 1 None)
    (Cons (ExpectedOffer (string-to-bytes "\n") 1 1 None)
    (Cons (ExpectedOffer (string-to-bytes "cc") 2 2 None)
    (Cons (ExpectedOffer (string-to-bytes " ") 1 1 None)
    (Cons (ExpectedOffer (string-to-bytes "dd") 2 2 None)
    (Cons (ExpectedOffer (string-to-bytes "\n") 1 1 None)
    (Cons (ExpectedOffer (bytes-new 0) 0 0 None) Nil))))))))

  -- | The native checked failure has a returned checkpoint; the recorded foreign panic intentionally did not.
  checked-callback-failure :: forall (r :: Region). TabConfig -> Nat ->{IO r, Mut r} Bool
  checked-callback-failure config ordinal =
    let policy = Policy None (Some (Failure ordinal (Some 0) "checked output refusal" False)) None 1024 4096 in
    let spy = spy-new policy in
    let output = spy-capability spy in
    let writer = tab-writer config output in
    let (outcome, advanced) = tab-writer-write writer (string-to-bytes "a\tb\ncc\tdd\fTAIL") in
    let failure = case tab-write-error outcome of
          Some (TabOutputFailure code) -> eq-i64 (string-compare code "checked output refusal") 0
          _ -> False in
    let (error, final) = tab-writer-flush advanced in
    let expected = if ordinal == 1 then
          Cons (ExpectedOffer (string-to-bytes "a") 0 0 (Some "checked output refusal")) replay-offers
        else if ordinal == 2 then
          Cons (ExpectedOffer (string-to-bytes "a") 1 1 None)
            (Cons (ExpectedOffer (string-to-bytes "  ") 0 0 (Some "checked output refusal")) replay-offers)
        else
          Cons (ExpectedOffer (string-to-bytes "a") 1 1 None)
            (Cons (ExpectedOffer (string-to-bytes "  ") 2 2 None)
            (Cons (ExpectedOffer (string-to-bytes "b") 0 0 (Some "checked output refusal")) replay-offers)) in
    let prefix = if ordinal == 1 then bytes-new 0 else if ordinal == 2 then string-to-bytes "a" else string-to-bytes "a  " in
    let physical = bytes-concat (Cons prefix (Cons (string-to-bytes "a  b\ncc dd\n") Nil)) in
    tab-write-consumed outcome == 10 && failure && no-error error && spy-matches spy expected physical

  -- | Recognize the exact mathematical padded width that exceeds the supported coordinate interval.
  padded-overflow :: Option (TabWriteError String) -> Bool
  padded-overflow error = case error of
    Some (TabLayoutFailure (TabLayoutOverflow value)) -> value == 9223372036854775808
    _ -> False

  -- | Excessive mathematical width is refused before any output, and explicit flush still resets failed pending rows.
  maximum-padding :: forall (r :: Region). Unit ->{IO r, Mut r} Bool
  maximum-padding unit = case tab-config 0 4 9223372036854775807 32 0 of
    Err _ -> False
    Ok config ->
      let spy = spy-new ordinary-policy in
      let output = spy-capability spy in
      let writer = tab-writer config output in
      let (outcome, advanced) = tab-writer-write writer (string-to-bytes "A\tB\f") in
      let untouched = spy-matches spy Nil (bytes-new 0) in
      let (error, reset) = tab-writer-flush advanced in
      let (next, written) = tab-writer-write reset (string-to-bytes "Z\n") in
      let (last-error, final) = tab-writer-flush written in
      let expected = Cons (ExpectedOffer (string-to-bytes "Z") 1 1 None)
            (Cons (ExpectedOffer (string-to-bytes "\n") 1 1 None)
            (Cons (ExpectedOffer (bytes-new 0) 0 0 None)
            (Cons (ExpectedOffer (bytes-new 0) 0 0 None) Nil))) in
      tab-write-consumed outcome == 4 && padded-overflow (tab-write-error outcome) && untouched && padded-overflow error &&
        no-error (tab-write-error next) && no-error last-error && spy-matches spy expected (string-to-bytes "Z\n")

  -- | Exact arithmetic defines a bounded tab offer even when a narrower intermediate computation would overflow.
  maximum-tab-width :: forall (r :: Region). Unit ->{IO r, Mut r} Bool
  maximum-tab-width unit = case tab-config 0 9223372036854775807 1 9 0 of
    Err _ -> False
    Ok config ->
      let spy = spy-new ordinary-policy in
      let output = spy-capability spy in
      let writer = tab-writer config output in
      let (outcome, advanced) = tab-writer-write writer (string-to-bytes "A\tB\f") in
      let (error, final) = tab-writer-flush advanced in
      let expected = Cons (ExpectedOffer (string-to-bytes "A") 1 1 None)
            (Cons (ExpectedOffer (string-to-bytes "\t") 1 1 None)
            (Cons (ExpectedOffer (string-to-bytes "B") 1 1 None)
            (Cons (ExpectedOffer (string-to-bytes "\n") 1 1 None)
            (Cons (ExpectedOffer (bytes-new 0) 0 0 None)
            (Cons (ExpectedOffer (bytes-new 0) 0 0 None) Nil))))) in
      tab-write-consumed outcome == 4 && no-error (tab-write-error outcome) && no-error error &&
        spy-matches spy expected (string-to-bytes "A\tB\n")

  -- | Opaque handles are always initialized: empty write is inert and empty flush makes its one actual empty offer.
  initialized-empty :: forall (r :: Region). TabConfig ->{IO r, Mut r} Bool
  initialized-empty config =
    let spy = spy-new ordinary-policy in
    let output = spy-capability spy in
    let writer = tab-writer config output in
    let (outcome, advanced) = tab-writer-write writer (bytes-new 0) in
    let inert = spy-matches spy Nil (bytes-new 0) in
    let (error, final) = tab-writer-flush advanced in
    let expected = Cons (ExpectedOffer (bytes-new 0) 0 0 None) Nil in
    tab-write-consumed outcome == 0 && no-error (tab-write-error outcome) && inert && no-error error && spy-matches spy expected (bytes-new 0)

  -- | Return distinct indices for all twelve documented adaptations without claiming panic/count equivalence.
  main :: Unit ->{IO r, Mut r} Int
  main unit = with (io = newIO ()) in
    case tab-config 0 4 1 32 0 of
      Err _ -> 13
      Ok config -> if not (negative-refusal TabMinimumWidth) then 1
        else if not (negative-refusal TabTabWidth) then 2
        else if not (negative-refusal TabPadding) then 3
        else if not (invalid-initialize config TabMinimumWidth) then 4
        else if not (invalid-initialize config TabTabWidth) then 5
        else if not (invalid-initialize config TabPadding) then 6
        else if not (checked-callback-failure config 1) then 7
        else if not (checked-callback-failure config 2) then 8
        else if not (checked-callback-failure config 3) then 9
        else if not (maximum-padding ()) then 10
        else if not (maximum-tab-width ()) then 11
        else if not (initialized-empty config) then 12
        else 0
