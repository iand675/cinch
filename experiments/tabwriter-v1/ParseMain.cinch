-- | Exercise incremental byte ownership and scalar-width boundaries before selecting the layout engine.
module Main where
  import Text.Tabwriter.Config
  import Text.Tabwriter.Internal.Parse
  import Data.Bool
  import Data.Bytes
  import Data.Int
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String

  -- | Observe one opaque cell without obtaining parser-owned mutable storage.
  first-cell :: TabParser -> Option TabCell
  first-cell parser = case tab-parser-rows parser of
    Nil -> None
    Cons row rows -> case tab-row-cells row of
      Nil -> None
      Cons cell cells -> Some cell

  -- | Compare a fresh cell observation with literal bytes and exact committed width.
  cell-equals :: TabParser -> Bytes -> Int -> Bool
  cell-equals parser expected width = case first-cell parser of
    None -> False
    Some cell ->
      let raw = tab-cell-bytes cell in
      eq-i64 (bytes-compare raw expected) 0 && tab-cell-width cell == width

  -- | A multibyte scalar split across two caller writes counts once at the following tab.
  split-scalar :: TabConfig -> Bool
  split-scalar config =
    let first = tab-input (bytes-from-list [195]) in
    let initial = tab-parse (tab-parser config) first 0 in
    let second = tab-input (bytes-from-list [169, 9, 120, 10]) in
    let final = tab-parse (tab-parse-parser initial) second 0 in
    tab-parse-consumed final == 4 && not (tab-parse-flush final) &&
      cell-equals (tab-parse-parser final) (bytes-from-list [195, 169]) 1

  -- | Escaped tabs, newlines and formfeeds remain data and contribute their scalar widths.
  raw-escape :: TabConfig -> Bool
  raw-escape config =
    let input = tab-input (bytes-from-list [255, 97, 9, 10, 12, 255, 9, 88, 10]) in
    let parsed = tab-parse (tab-parser config) input 0 in
    not (tab-parse-flush parsed) && cell-equals (tab-parse-parser parsed) (bytes-from-list [97, 9, 10, 12]) 4

  -- | HTML tags have zero width, entities one, and all raw segment bytes survive.
  html-width :: TabConfig -> Bool
  html-width config =
    let raw = string-to-bytes "<b>x</b>\t&amp;\n" in
    let parsed = tab-parse (tab-parser config) (tab-input raw) 0 in
    cell-equals (tab-parse-parser parsed) (string-to-bytes "<b>x</b>") 1

  -- | A noncolumn newline yields before later input; clearing and continuing uses the same absolute offset.
  automatic-checkpoint :: TabConfig -> Bool
  automatic-checkpoint config =
    let input = tab-input (string-to-bytes "alone\nTAIL") in
    let first = tab-parse (tab-parser config) input 0 in
    let empty = tab-parser-clear (tab-parse-parser first) in
    let final = tab-parse empty input (tab-parse-consumed first) in
    let complete = tab-parser-finalize (tab-parse-parser final) in
    tab-parse-flush first && not (tab-parse-section first) && tab-parse-consumed first == 6 &&
      tab-parse-consumed final == 10 && cell-equals complete (string-to-bytes "TAIL") 0

  -- | Mutating caller input or a returned cell copy cannot change the retained parser snapshot.
  ownership :: TabConfig -> Bool
  ownership config =
    let raw = bytes-from-list [65, 9, 66, 10] in
    let input = tab-input raw in
    if bytes-len raw > 0 then
      let changed = bytes-set raw 0 90 in
      let parsed = tab-parse (tab-parser config) input 0 in
      let parser = tab-parse-parser parsed in
      case first-cell parser of
        None -> False
        Some cell ->
          let copied = tab-cell-bytes cell in
          if bytes-len copied == 1 then
            let changed-copy = bytes-set copied 0 89 in
            cell-equals parser (bytes-from-list [65]) 1
          else False
    else False

  -- | Return distinct functional group indices, without substituting a source-only verdict for execution.
  main :: Int
  main = case tab-config 0 4 1 32 3 of
    Err _ -> 1
    Ok config -> if split-scalar config then
      if raw-escape config then
        if html-width config then
          if automatic-checkpoint config then
            if ownership config then 0 else 6
          else 5
        else 4
      else 3
      else 2
