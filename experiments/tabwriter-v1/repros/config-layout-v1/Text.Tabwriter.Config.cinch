-- | Checked dimensions and byte-level controls for aligned tabular output.
-- Width counts decoded scalar units, rather than terminal display columns.
-- Padding accepts every byte value; byte output may therefore be non-UTF-8.
module Text.Tabwriter.Config where
  import Data.Bool
  import Data.Int
  import Data.Machine
  import Data.Nat
  import Data.Result

  export TabConfig, TabConfigError, TabDimension
  export TabMinimumWidth, TabTabWidth, TabPadding
  export TabConfigNegative, TabConfigTooLarge
  export tab-config, tab-config-min-width, tab-config-tab-width, tab-config-padding
  export tab-config-pad-byte, tab-config-flags
  export tab-filter-html, tab-strip-escape, tab-align-right
  export tab-discard-empty-columns, tab-indent, tab-debug, tab-escape-byte
  export tab-config-filter-html, tab-config-strip-escape, tab-config-align-right
  export tab-config-discard-empty-columns, tab-config-indent, tab-config-debug

  -- | Ignore tag widths and count an entity segment as one scalar unit.
  tab-filter-html :: U64
  tab-filter-html = 1

  -- | Remove raw escape delimiter bytes while retaining their escaped contents.
  tab-strip-escape :: U64
  tab-strip-escape = 2

  -- | Pad before cell contents unless tab padding requires left alignment.
  tab-align-right :: U64
  tab-align-right = 4

  -- | Give an entirely empty soft-tab column zero width.
  tab-discard-empty-columns :: U64
  tab-discard-empty-columns = 8

  -- | Use tab padding for leading byte-empty cells regardless of the padding byte.
  tab-indent :: U64
  tab-indent = 16

  -- | Emit visible column and section boundary markers.
  tab-debug :: U64
  tab-debug = 32

  -- | Raw delimiter byte 255, distinct from a Unicode scalar's UTF-8 encoding.
  tab-escape-byte :: U8
  tab-escape-byte = 255

  -- | One independently validated numeric configuration coordinate.
  data TabDimension where
    -- | Minimum aligned cell width, including padding.
    TabMinimumWidth :: TabDimension
    -- | Width represented by one emitted padding tab; zero disables tab padding.
    TabTabWidth :: TabDimension
    -- | Width added before choosing a column's maximum.
    TabPadding :: TabDimension

  -- | A refused dimension retains its identity and original mathematical value.
  data TabConfigError where
    -- | A dimension is negative and cannot form a layout coordinate.
    TabConfigNegative :: TabDimension -> Int -> TabConfigError
    -- | A dimension exceeds the supported signed 64-bit layout interval.
    TabConfigTooLarge :: TabDimension -> Int -> TabConfigError

  -- | Validated immutable configuration; constructor representation stays private.
  data TabConfig where
    -- | Store nonnegative dimensions, an arbitrary padding byte and all requested flag bits.
    Config :: Nat -> Nat -> Nat -> U8 -> U64 -> TabConfig

  -- | Validate dimensions before constructing a configuration; unknown flag bits have no formatting effect.
  tab-config :: Int -> Int -> Int -> U8 -> U64 -> Result TabConfigError TabConfig
  tab-config minimum tab padding pad flags =
    if 0 <= minimum then
      if minimum <= 9223372036854775807 then
        if 0 <= tab then
          if tab <= 9223372036854775807 then
            if 0 <= padding then
              if padding <= 9223372036854775807 then
                let first = nat-from-int minimum in
                let second = nat-from-int tab in
                let third = nat-from-int padding in
                Ok (Config first second third pad flags)
              else Err (TabConfigTooLarge TabPadding padding)
            else Err (TabConfigNegative TabPadding padding)
          else Err (TabConfigTooLarge TabTabWidth tab)
        else Err (TabConfigNegative TabTabWidth tab)
      else Err (TabConfigTooLarge TabMinimumWidth minimum)
    else Err (TabConfigNegative TabMinimumWidth minimum)

  -- | Observe the minimum aligned cell width without exposing configuration storage.
  tab-config-min-width :: TabConfig -> Nat
  tab-config-min-width config = case config of Config minimum tab padding pad flags -> minimum

  -- | Observe the emitted padding tab width, including the explicit zero-width policy.
  tab-config-tab-width :: TabConfig -> Nat
  tab-config-tab-width config = case config of Config minimum tab padding pad flags -> tab

  -- | Observe the width added before selecting an aligned column width.
  tab-config-padding :: TabConfig -> Nat
  tab-config-padding config = case config of Config minimum tab padding pad flags -> padding

  -- | Observe the exact arbitrary padding byte.
  tab-config-pad-byte :: TabConfig -> U8
  tab-config-pad-byte config = case config of Config minimum tab padding pad flags -> pad

  -- | Observe requested bits, including unknown bits; effective right alignment has a separate predicate.
  tab-config-flags :: TabConfig -> U64
  tab-config-flags config = case config of Config minimum tab padding pad flags -> flags

  -- | Test one configuration bit through the established fixed-width machine primitive.
  flag :: TabConfig -> U64 -> Bool
  flag config mask = case config of Config minimum tab padding pad flags ->
    let selected = bit-and-u64 flags mask in ne-u64 selected 0

  -- | Test whether tags and entities use their special formatting widths.
  tab-config-filter-html :: TabConfig -> Bool
  tab-config-filter-html config = flag config tab-filter-html

  -- | Test whether escaped-segment delimiters are stripped from output.
  tab-config-strip-escape :: TabConfig -> Bool
  tab-config-strip-escape config = flag config tab-strip-escape

  -- | Test effective alignment; padding with tab bytes always selects left alignment.
  tab-config-align-right :: TabConfig -> Bool
  tab-config-align-right config = case config of Config minimum tab padding pad flags ->
    let tab-padding = eq-u8 pad 9 in
    if tab-padding then False else flag config tab-align-right

  -- | Test whether byte-empty, zero-width soft-tab columns may be discarded.
  tab-config-discard-empty-columns :: TabConfig -> Bool
  tab-config-discard-empty-columns config = flag config tab-discard-empty-columns

  -- | Test whether leading byte-empty cells request tab indentation.
  tab-config-indent :: TabConfig -> Bool
  tab-config-indent config = flag config tab-indent

  -- | Test whether visible column and section boundary markers are enabled.
  tab-config-debug :: TabConfig -> Bool
  tab-config-debug config = flag config tab-debug
