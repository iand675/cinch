-- | Uniform-alphabet token encoding without an entropy source or security claim.
-- Each input byte contributes its low five bits as one uppercase alphabet symbol.
-- This is not Base32 serialization: high input bits are deliberately discarded.
module Text.Token where
  import Data.Bytes
  import Data.Bytes.Word
  import Data.Nat
  import Data.Machine
  import Data.String
  import Data.Option

  export token-base32-symbols

  -- | Map bytes to equally many A-Z/2-7 symbols without changing or retaining mutable input.
  -- Output randomness depends entirely on the supplied input; this function adds none.
  token-base32-symbols :: Bytes -> String
  token-base32-symbols input =
    let output = bytes-new (bytes-len input) in
    let filled = fill input output 0 in
    case string-from-bytes output of Some text -> text; None -> empty-string

  -- | Map one proved five-bit value to its ASCII alphabet byte.
  symbol :: using (value < 32) => (value :: Nat) -> InRange 0 255 Nat
  symbol value = if value < 26 then 65 + value else 24 + value

  -- | Map eight byte lanes independently with no cross-lane carry or borrow.
  prim symbols8 :: U64 -> U64 where
    llvm {
      %value = and i64 %0, 2242545357980376863
      %letter = add i64 %value, 4702111234474983745
      %threshold = add i64 %value, 7378697629483820646
      %high = and i64 %threshold, 9259542123273814144
      %flags = lshr i64 %high, 7
      %adjust = mul i64 %flags, 41
      %result = sub i64 %letter, %adjust
      ret i64 %result
    }

  -- | Transform exactly sixteen proved source/destination bytes with portable LLVM vectors.
  -- Callers retain both owners across the private pointer boundary.
  prim write16 :: I64 -> I64 -> I64 -> U64 where
    unsafe llvm {
      %source = inttoptr i64 %0 to ptr
      %destination = inttoptr i64 %1 to ptr
      %at = getelementptr i8, ptr %source, i64 %2
      %out = getelementptr i8, ptr %destination, i64 %2
      %raw = load <16 x i8>, ptr %at, align 1
      %value = and <16 x i8> %raw, <i8 31,i8 31,i8 31,i8 31,i8 31,i8 31,i8 31,i8 31,i8 31,i8 31,i8 31,i8 31,i8 31,i8 31,i8 31,i8 31>
      %letter = add <16 x i8> %value, <i8 65,i8 65,i8 65,i8 65,i8 65,i8 65,i8 65,i8 65,i8 65,i8 65,i8 65,i8 65,i8 65,i8 65,i8 65,i8 65>
      %digit = add <16 x i8> %value, <i8 24,i8 24,i8 24,i8 24,i8 24,i8 24,i8 24,i8 24,i8 24,i8 24,i8 24,i8 24,i8 24,i8 24,i8 24,i8 24>
      %digits = icmp uge <16 x i8> %value, <i8 26,i8 26,i8 26,i8 26,i8 26,i8 26,i8 26,i8 26,i8 26,i8 26,i8 26,i8 26,i8 26,i8 26,i8 26,i8 26>
      %result = select <16 x i1> %digits, <16 x i8> %digit, <16 x i8> %letter
      store <16 x i8> %result, ptr %out, align 1
      ret i64 16
    }

  -- | Store one packed ASCII word in exact wire order without touching a tail.
  prim write8 :: I64 -> I64 -> U64 -> U64 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %at = getelementptr i8, ptr %base, i64 %1
      store i64 %2, ptr %at, align 1
      ret i64 8
    } when endian little
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %at = getelementptr i8, ptr %base, i64 %1
      %word = call i64 @llvm.bswap.i64(i64 %2)
      store i64 %word, ptr %at, align 1
      ret i64 8
    } when endian big

  -- | Retain both buffers through the strict kernel result and owner length reads.
  hold :: Bytes -> Bytes -> U64 -> U64
  hold source destination result = case bytes-len source of _ -> case bytes-len destination of _ -> result

  -- | Process proved sixteen/eight-byte blocks, then only in-range scalar bytes.
  fill :: Bytes -> Bytes -> Nat -> Unit
  fill input output index =
    if index + 16 <= bytes-len input && index + 16 <= bytes-len output then
      let written = hold input output (write16 (bytes-data input) (bytes-data output) (nat-to-i64 index)) in
      fill input output (index + 16)
    else if index + 8 <= bytes-len input && index + 8 <= bytes-len output then
      let packed = symbols8 (bytes-read-le64 input index) in
      let written = hold input output (write8 (bytes-data output) (nat-to-i64 index) packed) in
      fill input output (index + 8)
    else if index < bytes-len input && index < bytes-len output then
      let written = bytes-set output index (symbol (nat-rem (bytes-get input index) 32)) in
      fill input output (index + 1)
    else ()
