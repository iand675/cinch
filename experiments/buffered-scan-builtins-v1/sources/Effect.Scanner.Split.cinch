-- | Byte-preserving token splitters with explicit absent, empty and final token states.
-- Built-in tokens are fresh. Custom callbacks receive a private snapshot and their
-- returned tokens are snapshotted before retention. Empty nonterminal direct calls
-- request more input; they never inspect storage outside the logical byte span.
module Effect.Scanner.Split where
  import Effect.Buffered.Core
  import Effect.Buffered.Internal.Scan as Scan
  import Data.Bool
  import Data.Bytes
  import Data.Bytes.Utf8 as Utf8
  import Data.Char
  import Data.Int
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.String
  import Data.Unicode.Kernel

  export ScanError, ScanTooLong, ScanNegativeAdvance, ScanAdvanceTooFar, ScanBadReadCount
  export ScanFinalToken, ScanNoProgress, ScanEmptyTokens, ScanEmptyTokensAfter, ScanStarted, ScanSourceError, ScanCustomError
  export ScanStep, ScanSplit, scan-split, scan-apply, scan-apply-between, scan-error-message
  export scan-bytes, scan-runes, scan-lines, scan-words
  export scan-byte-split, scan-rune-split, scan-line-split, scan-word-split

  -- | A checked scanner failure, final-token sentinel, source failure or explicit custom diagnostic.
  data ScanError where
    -- | The current token cannot fit in the configured buffer capacity and maximum.
    ScanTooLong :: ScanError
    -- | A custom split callback reported a negative input advance.
    ScanNegativeAdvance :: Int -> ScanError
    -- | A custom split callback advanced beyond its supplied logical byte span.
    ScanAdvanceTooFar :: Int -> Nat -> ScanError
    -- | A source reported a negative, oversized or undersupplied byte count.
    ScanBadReadCount :: Nat -> Int -> Nat -> ScanError
    -- | A split callback requests successful termination, optionally delivering one final token.
    ScanFinalToken :: ScanError
    -- | A source returned 101 consecutive empty reads without a terminal event.
    ScanNoProgress :: ScanError
    -- | A terminal split callback returned more than 100 tokens without advancing input.
    ScanEmptyTokens :: Nat -> ScanError
    -- | Excessive terminal tokens also retain a previously observed structured source or split failure.
    ScanEmptyTokensAfter :: Nat -> ScanError -> ScanError
    -- | Buffer or split configuration was attempted after scanning had begun.
    ScanStarted :: String -> ScanError
    -- | Preserve a source's original structured terminal error; ordinary end-of-input is suppressed by scanner-error.
    ScanSourceError :: BufferError -> ScanError
    -- | A custom split callback supplied an application diagnostic.
    ScanCustomError :: String -> ScanError

  -- | Explain a scanner failure while retaining exact counts and original causes in its structured value.
  scan-error-message :: ScanError -> String
  scan-error-message error = case error of
    ScanTooLong -> "scanner token too long"
    ScanNegativeAdvance count -> "scanner split returned a negative advance"
    ScanAdvanceTooFar count available -> "scanner split advanced beyond input"
    ScanBadReadCount wanted actual supplied -> "scanner source returned an invalid count"
    ScanFinalToken -> "final scanner token"
    ScanNoProgress -> "scanner source made no progress"
    ScanEmptyTokens count -> "scanner returned too many empty tokens without progress"
    ScanEmptyTokensAfter count prior -> "scanner returned too many empty tokens without progress"
    ScanStarted operation -> "scanner configuration changed after scanning began"
    ScanSourceError cause -> buffer-error-message cause
    ScanCustomError message -> message

  -- | A signed advance, optional token and optional split error; Some empty bytes is a delivered empty token.
  data ScanStep where
    -- | Final-token errors take precedence over the advance count; other counts are checked by the scanner.
    ScanStep :: Int -> Option Bytes -> Option ScanError -> ScanStep

  -- | A pure split capability receiving owned bytes and a flag indicating any terminal source status.
  data ScanSplit where
    -- | Private callback; application mutation is contained by snapshot boundaries.
    Splitter :: (Bytes -> Bool -> ScanStep) -> ScanSplit
    -- | Private byte tokenization reads only the checked owner span and returns fresh tokens.
    ByteSplitter :: ScanSplit
    -- | Private scalar tokenization retains exact incomplete and malformed-byte semantics.
    RuneSplitter :: ScanSplit
    -- | Private line tokenization scans the bounded owner without callback input snapshots.
    LineSplitter :: ScanSplit
    -- | Private Unicode whitespace tokenization preserves arbitrary non-whitespace bytes.
    WordSplitter :: ScanSplit

  -- | Define a custom tokenization capability without exposing the scanner's private buffer.
  scan-split :: (Bytes -> Bool -> ScanStep) -> ScanSplit
  scan-split callback = Splitter callback

  -- | Copy one validated input interval into independent token storage.
  part :: Bytes -> Nat -> Nat -> Bytes
  part input at count = if at + count <= bytes-len input then
    let output = bytes-new count in let copied = bytes-copy-range output input 0 at count in output
    else bytes-new 0

  -- | Invoke a built-in on a checked span, or isolate a custom callback with fresh input and returned-token snapshots.
  scan-apply :: ScanSplit -> Bytes -> Bool -> ScanStep
  scan-apply split input terminal = scan-apply-between split input 0 (bytes-len input) terminal

  -- | Invoke a splitter over a checked owner span; built-ins return fresh tokens without copying the remaining input.
  -- Custom callbacks retain exactly one input snapshot and one returned-token snapshot.
  -- Offsets are absolute and invalid bounds return a checked error without invoking the callback.
  scan-apply-between :: ScanSplit -> Bytes -> Nat -> Nat -> Bool -> ScanStep
  scan-apply-between split input start end terminal = if start <= end && end <= bytes-len input then
    case split of
      ByteSplitter -> scan-byte-between input start end
      RuneSplitter -> scan-rune-between input start end terminal
      LineSplitter -> scan-line-between input start end terminal
      WordSplitter -> scan-word-between input start end terminal
      Splitter callback -> let snapshot = part input start (end - start) in
        case callback snapshot terminal of
          ScanStep advance token status -> case token of
            None -> ScanStep advance None status
            Some payload -> ScanStep advance (Some (part payload 0 (bytes-len payload))) status
    else ScanStep 0 None (Some (ScanCustomError "invalid split input interval"))

  -- | Split one arbitrary byte; an empty input safely requests more data or completes at end-of-input.
  scan-bytes :: Bytes -> Bool -> ScanStep
  scan-bytes input terminal = if bytes-len input > 0 then ScanStep 1 (Some (part input 0 1)) None
    else ScanStep 0 None None

  -- | Split one shortest-form Unicode scalar, replacing each malformed input byte with encoded U+FFFD.
  -- An incomplete nonterminal encoding requests more input; invalid and truncated terminal bytes consume one byte each.
  scan-runes :: Bytes -> Bool -> ScanStep
  scan-runes input terminal = if bytes-len input == 0 then ScanStep 0 None None
    else if not terminal && not (Utf8.utf8-full-rune input) then ScanStep 0 None None
    else let step = Utf8.utf8-first input in let width = Utf8.utf8-step-width step in
      case Utf8.utf8-step-status step of
        Utf8.Utf8Invalid -> ScanStep 1 (Some (Utf8.utf8-encode-rune 65533)) None
        other -> ScanStep (nat-to-int width) (Some (part input 0 width)) None

  -- | Drop one optional terminal carriage return while retaining a fresh complete token.
  drop-cr :: Bytes -> Bytes
  drop-cr input = let size = bytes-len input in
    if size > 0 then let at = size - 1 in
      if at < bytes-len input && bytes-get input at == 13 then part input 0 at else input
    else input

  -- | Split LF-terminated lines, remove one optional preceding CR, and return a final nonempty unterminated line.
  scan-lines :: Bytes -> Bool -> ScanStep
  scan-lines input terminal = case Scan.find-byte input 0 (bytes-len input) 10 of
    Some at -> ScanStep (nat-to-int (at + 1)) (Some (drop-cr (part input 0 at))) None
    None -> if terminal && bytes-len input > 0 then ScanStep (nat-to-int (bytes-len input)) (Some (drop-cr (part input 0 (bytes-len input)))) None
      else ScanStep 0 None None

  -- | Advance over complete Unicode whitespace, using machine lanes for consecutive ASCII whitespace.
  skip-space :: Bytes -> Nat -> Nat
  skip-space input at = let next = Scan.ascii-spaces input at (bytes-len input) in
    if next < bytes-len input then
      let step = Utf8.utf8-decode-at input next in let width = Utf8.utf8-step-width step in
      if unicode-is-space (Utf8.utf8-step-char step) && width > 0 && next + width <= bytes-len input then skip-space input (next + width) else next
    else next

  -- | Find a word's Unicode whitespace boundary, preserving raw bytes rather than repairing malformed encodings.
  word-end :: Bytes -> Nat -> Nat -> Bool -> ScanStep
  word-end input start at terminal = let next = Scan.ascii-word input at (bytes-len input) in
    if next < bytes-len input then
      let step = Utf8.utf8-decode-at input next in let width = Utf8.utf8-step-width step in
      if width > 0 && next + width <= bytes-len input then
        if unicode-is-space (Utf8.utf8-step-char step) && start <= next then
          ScanStep (nat-to-int (next + width)) (Some (part input start (next - start))) None
        else word-end input start (next + width) terminal
      else ScanStep (nat-to-int start) None (Some (ScanCustomError "invalid private word width"))
    else if terminal && start < bytes-len input then
      let count = bytes-len input - start in ScanStep (nat-to-int (bytes-len input)) (Some (part input start count)) None
    else ScanStep (nat-to-int start) None None

  -- | Split nonempty words on the Unicode White_Space property, retaining arbitrary non-whitespace bytes exactly.
  scan-words :: Bytes -> Bool -> ScanStep
  scan-words input terminal = let start = skip-space input 0 in word-end input start start terminal


  -- | A first-class byte splitter reads the bounded scanner span and returns one independently owned byte token.
  scan-byte-split :: ScanSplit
  scan-byte-split = ByteSplitter

  -- | A first-class scalar splitter preserves incomplete-input requests and per-byte malformed replacement without copying the unread span.
  scan-rune-split :: ScanSplit
  scan-rune-split = RuneSplitter

  -- | A first-class line splitter uses packed delimiter scans and returns fresh CR-trimmed tokens.
  scan-line-split :: ScanSplit
  scan-line-split = LineSplitter

  -- | A first-class word splitter uses Unicode whitespace and packed ASCII runs while retaining arbitrary token bytes.
  scan-word-split :: ScanSplit
  scan-word-split = WordSplitter

  -- | Return one fresh byte without exposing or copying the rest of the checked unread owner span.
  scan-byte-between :: Bytes -> Nat -> Nat -> ScanStep
  scan-byte-between input start end = if start < end && end <= bytes-len input then
    ScanStep 1 (Some (part input start 1)) None
    else ScanStep 0 None None

  -- | Split a scalar inside absolute bounds; inspect at most four copied fringe bytes only for nonterminal non-ASCII fullness.
  scan-rune-between :: Bytes -> Nat -> Nat -> Bool -> ScanStep
  scan-rune-between input start end terminal = if start < end && end <= bytes-len input then
    if bytes-get input start < 128 then ScanStep 1 (Some (part input start 1)) None
    else
      let remaining = end - start in let fringe = if remaining < 4 then remaining else 4 in
      if not terminal && not (Utf8.utf8-full-rune (part input start fringe)) then ScanStep 0 None None
      else let step = Utf8.utf8-decode-between input start end start in let width = Utf8.utf8-step-width step in
        case Utf8.utf8-step-status step of
          Utf8.Utf8Invalid -> ScanStep 1 (Some (Utf8.utf8-encode-rune 65533)) None
          other -> if width > 0 && start + width <= end then ScanStep (nat-to-int width) (Some (part input start width)) None
            else ScanStep 0 None (Some (ScanCustomError "invalid private scalar width"))
    else ScanStep 0 None None

  -- | Copy a complete bounded line token once, excluding one optional final carriage return.
  line-token-between :: Bytes -> Nat -> Nat -> Bytes
  line-token-between input start end = if start <= end && end <= bytes-len input then
    if start < end then let last = end - 1 in
      if last < bytes-len input && bytes-get input last == 13 && start <= last then part input start (last - start)
      else part input start (end - start)
    else bytes-new 0
    else bytes-new 0

  -- | Find LF with packed bounded lanes and translate the absolute endpoint into a relative consumed count.
  scan-line-between :: Bytes -> Nat -> Nat -> Bool -> ScanStep
  scan-line-between input start end terminal = if start <= end && end <= bytes-len input then
    case Scan.find-byte input start end 10 of
      Some at -> if start <= at then ScanStep (nat-to-int (at + 1 - start)) (Some (line-token-between input start at)) None
        else ScanStep 0 None (Some (ScanCustomError "invalid private line offset"))
      None -> if terminal && start < end then ScanStep (nat-to-int (end - start)) (Some (line-token-between input start end)) None
        else ScanStep 0 None None
    else ScanStep 0 None (Some (ScanCustomError "invalid private line interval"))

  -- | Skip only complete Unicode whitespace within the logical endpoint, with packed ASCII runs and scalar fringes.
  span-skip-space :: Bytes -> Nat -> Nat -> Nat
  span-skip-space input at end = let next = Scan.ascii-spaces input at end in
    if next < end && end <= bytes-len input then
      let step = Utf8.utf8-decode-between input at end next in let width = Utf8.utf8-step-width step in
      if unicode-is-space (Utf8.utf8-step-char step) && width > 0 && next + width <= end then span-skip-space input (next + width) end else next
    else next

  -- | Find a bounded word ending while reporting advances relative to the originally supplied span.
  span-word-end :: Bytes -> Nat -> Nat -> Nat -> Nat -> Bool -> ScanStep
  span-word-end input origin start at end terminal = let next = Scan.ascii-word input at end in
    if origin <= start && start <= next && next <= end && end <= bytes-len input then
      if next < end then
        let step = Utf8.utf8-decode-between input origin end next in let width = Utf8.utf8-step-width step in
        if width > 0 && next + width <= end then
          if unicode-is-space (Utf8.utf8-step-char step) then
            ScanStep (nat-to-int (next + width - origin)) (Some (part input start (next - start))) None
          else span-word-end input origin start (next + width) end terminal
        else ScanStep (nat-to-int (start - origin)) None (Some (ScanCustomError "invalid private word width"))
      else if terminal && start < end then ScanStep (nat-to-int (end - origin)) (Some (part input start (end - start))) None
      else ScanStep (nat-to-int (start - origin)) None None
    else ScanStep 0 None (Some (ScanCustomError "invalid private word interval"))

  -- | Split a nonempty word without copying skipped whitespace or the unread suffix, preserving raw malformed token bytes.
  scan-word-between :: Bytes -> Nat -> Nat -> Bool -> ScanStep
  scan-word-between input start end terminal = if start <= end && end <= bytes-len input then
    let first = span-skip-space input start end in span-word-end input start first first end terminal
    else ScanStep 0 None (Some (ScanCustomError "invalid private word interval"))
