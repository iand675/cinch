        "ReverseBytes": "Data.Word.reverse-bytes-u16/u32/u64/usize, using inline LLVM byte swaps",
        "RotateLeft": "Data.Word.rotate-signed-u8/u16/u32/u64/usize, with I64 counts reduced modulo the width",
