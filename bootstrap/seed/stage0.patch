+                (ITerm::app_fn("b.bytesLen", vec![ITerm::Var(n.clone())]), Mathematical)
+            }
+            ITerm::App(f, args) if scope.allow_measures => {
+                let ITerm::Fn(identity) = &**f else { return None };
