+                self.length_index_unify(&actual, &cod, uni, span)?;
+                Ok(Ty::fun_mult(*dom, mult, eff, *cod))
+            }
+            ITerm::MVar(_) => Err(Error::at(span, "byte-length index operand has an unsolved carrier")),
