+            ITerm::Bin(_, a, b) => {
+                let carrier = self.length_index_type(a, expected, env, uni, span)?;
+                if !matches!(uni.zonk(&carrier), Ty::Nat | Ty::Int) { return Err(Error::at(span, "byte-length index arithmetic requires Nat or Int")); }
