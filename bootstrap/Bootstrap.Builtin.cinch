-- The language's builtin vocabulary has kernel contracts, not Prelude exports.
-- Keep capability contexts, region kinds, effect rows, fresh identity
-- creation and decision evidence here, before checker elaboration.
module Bootstrap.Builtin where

  import Bootstrap.Ast (Decl, DExternal, DData, MkTypeParam, TName, TInfix, TApp, TArg, TArgsEnd, TFun, TBound, TBoundsEnd)
  import Bootstrap.RuntimeAbi (runtime-abi-int)
  import Data.Json
  import Text.Lex (Span)

  export builtin-bindings, builtin-declarations, finite-index-declaration, intrinsic-contract, array-plan, array-type-name, nat-arithmetic-extern

  nat-arithmetic-extern :: String -> Option String
  nat-arithmetic-extern symbol =
    if string-compare symbol "cinch.runtime.natAdd" == 0 then Some "cinch_nat_add"
    else if string-compare symbol "cinch.runtime.natMul" == 0 then Some "cinch_nat_mul"
    else None

  -- The selected runtime ABI's pure intrinsics. The returned scheme is checked
  -- against the declaration, not taken on trust from foreign source text.
  -- The extern is retained separately from the language-level identity.
  intrinsic-contract :: String -> Option (String, String)
  intrinsic-contract symbol =
    -- Machine primitives retain their canonical operation identity. They
    -- lower directly to LLVM, rather than naming an unchecked C function.
    if string-compare symbol "cinch.prim.eqI64" == 0 then Some ("I64 -> I64 -> Bool", symbol)
    else if string-compare symbol "cinch.prim.wrappingAddI64" == 0 then Some ("I64 -> I64 -> I64", symbol)
    else if string-compare symbol "cinch.prim.wrappingSubI64" == 0 then Some ("I64 -> I64 -> I64", symbol)
    else if string-compare symbol "cinch.runtime.textSha256" == 0 then Some ("Bytes -> Bytes", "cinch_text_sha256")
    else if string-compare symbol "cinch.runtime.textSha512" == 0 then Some ("Bytes -> Bytes", "cinch_text_sha512")
    else if string-compare symbol "cinch.runtime.textSha1" == 0 then Some ("Bytes -> Bytes", "cinch_text_sha1")
    else if string-compare symbol "cinch.runtime.textMd5" == 0 then Some ("Bytes -> Bytes", "cinch_text_md5")
    else if string-compare symbol "cinch.runtime.textHmacSha256" == 0 then Some ("Bytes -> Bytes -> Bytes", "cinch_text_hmac_sha256")
    else if string-compare symbol "cinch.runtime.textF64ToDecimal" == 0 then Some ("F64 -> Bytes", "cinch_text_f64_to_decimal")
    else if string-compare symbol "cinch.runtime.textF64FromDecimal" == 0 then Some ("Bytes -> F64", "cinch_text_f64_from_decimal")
    else if string-compare symbol "cinch.runtime.bytesLen" == 0 then Some ("Bytes -> Nat", "cinch_bytes_len")
    else if string-compare symbol "cinch.runtime.bytesGet" == 0 then Some ("Bytes -> Nat -> refined (0 <= out && out <= 255) Nat", "cinch_bytes_get")
    else if string-compare symbol "cinch.runtime.bytesNew" == 0 then Some ("Nat -> Bytes", "cinch_bytes_new")
    else case nat-arithmetic-extern symbol of
      Some external -> Some ("Nat -> Nat -> Nat", external)
      None -> case array-plan symbol of
        Some (operation, format, scheme) -> Some (scheme, array-extern operation)
        None -> None

  -- Visible spelling and canonical kernel identity. Runtime.newIO is the
  -- native compiler's qualified alias; other IO operations are unqualified.
  builtin-bindings :: List (String, String)
  builtin-bindings =
    [ ("newIO", "b.newIO"), ("Runtime.newIO", "b.newIO")
    , ("withScope", "b.withScope"), ("spawn", "b.spawn"), ("joinAllOrCancel", "b.joinAllOrCancel")
    , ("Scope", "b.Scope"), ("Task", "b.Task")
    , ("ioWrite", "b.ioWrite"), ("ioRead", "b.ioRead")
    , ("ioSleep", "b.ioSleep"), ("pollCancel", "b.pollCancel")
    , ("unrefine", "b.unrefine"), ("copyOut", "b.copyOut"), ("mutBorrow", "b.mutBorrow"), ("refSet", "b.refSet")
    , ("decide", "b.decide"), ("Yes", "b.Yes"), ("No", "b.No"), ("Dec", "b.Dec")
    , ("refl", "b.refl"), ("Fin", "b.Fin"), ("Proof.search", "b.Proof.search")
    ]

  entry :: String -> String -> String -> Bool -> Decl
  entry name operation scheme fresh = DExternal (Span 0 0 1 1)
    (string-concat "b." name) "builtin" None
    (JObj "name" (JStr name)
      (JObj "symbol" (JStr (string-concat "<builtin>." name))
        (JObj "operation" (JStr operation)
          (JObj "arity" (JNum 1)
            (JObj "runtime_abi" (JNum runtime-abi-int)
              (JObj "fresh_region" (JBool fresh)
                (JObj "scheme" (JStr scheme) JObjEnd)))))))

  -- `decide p` consumes predicate syntax and returns Dec p. It is not a
  -- first-class function taking a proof of p as an ordinary argument.
  decision-rule :: Decl
  decision-rule = DExternal (Span 0 0 1 1) "b.decide" "builtin-syntax" None
    (JObj "name" (JStr "decide")
      (JObj "operation" (JStr "Decide")
        (JObj "runtime_abi" (JNum runtime-abi-int)
          (JObj "first_class" (JBool False)
            (JObj "predicate_kind" (JStr "Prop")
              (JObj "scheme" (JStr "forall (p :: Prop). Dec p") JObjEnd))))))

  -- Dec has one Prop parameter. Both constructors bind erased evidence;
  -- the runtime choice stores only its tag, never a fabricated witness.
  decision-constructor :: String -> Int -> String -> Decl
  decision-constructor name tag scheme = DExternal (Span 0 0 1 1)
    (string-concat "b." name) "builtin-constructor" None
    (JObj "name" (JStr name)
      (JObj "family" (JStr "Dec")
        (JObj "parameter_kind" (JStr "Prop")
          (JObj "runtime_abi" (JNum runtime-abi-int)
            (JObj "tag" (JNum tag)
              (JObj "arity" (JNum 1)
                (JObj "runtime_arity" (JNum 0)
                  (JObj "erased" (JArr (JBool True) JArrEnd)
                    (JObj "scheme" (JStr scheme) JObjEnd)))))))))

  task-rule :: String -> String -> Int -> Bool -> Decl
  task-rule name operation arity variadic = DExternal (Span 0 0 1 1) (string-concat "b." name) "builtin-syntax" None
    (JObj "name" (JStr name) (JObj "operation" (JStr operation) (JObj "arity" (JNum arity) (JObj "variadic" (JBool variadic) (JObj "runtime_abi" (JNum runtime-abi-int) (JObj "first_class" (JBool False) JObjEnd))))))
  -- The checked data path retains the index and erases the bound field.
  finite-index-declaration :: Decl
  finite-index-declaration =
    let sp = Span 0 0 1 1 in
    let nat = TName sp "Nat" in
    let bound = TInfix sp "<" (TName sp "i") (TName sp "n") in
    let result = TApp sp (TName sp "b.Fin") (TArg sp (TName sp "n") (TArgsEnd sp)) in
    DData sp "b.Fin" [MkTypeParam sp "n" (Some nat) False]
      [("b.Fin", TFun sp (TBound sp "i" nat (TBoundsEnd sp))
        (TFun sp (TBound sp "bound" bound (TBoundsEnd sp)) result))]

  builtin-declarations :: List Decl
  builtin-declarations =
    [ entry "newIO" "NewIO" "forall (r :: Region). Unit -> Io r" True
    , entry "ioWrite" "IoWrite" "forall (r :: Region). using (io :: Io r) => Bytes ->{IO r} Unit" False
    , entry "ioRead" "IoRead" "forall (r :: Region). using (io :: Io r) => Nat ->{IO r, Diverge} Option Bytes" False
    , entry "ioSleep" "IoSleep" "forall (r :: Region). using (io :: Io r) => Nat ->{IO r, Cancel r} Unit" False
    , entry "pollCancel" "PollCancel" "forall (r :: Region). using (io :: Io r) => Unit ->{Cancel r} Bool" False
    , task-rule "withScope" "WithScope" 1 False
    , task-rule "spawn" "Spawn" 2 False
    , task-rule "joinAllOrCancel" "JoinAllOrCancel" 2 True
    , task-rule "unrefine" "Unrefine" 1 False
    , task-rule "copyOut" "CopyOut" 1 False
    , task-rule "mutBorrow" "MutBorrow" 1 False
    , task-rule "refSet" "RefSet" 2 False
    , decision-rule
    , task-rule "Proof.search" "ProofSearch" 1 False
    , decision-constructor "Yes" 0 "forall (p :: Prop). (h :: p) -> Dec p"
    , decision-constructor "No" 1 "forall (p :: Prop). (h :: Not p) -> Dec p"
    ]

  -- Array, Tensor and Columnar are primitive starting with ABI 6.
  array-type-name :: String -> Bool
  array-type-name name = runtime-abi-int >= 6 && (string-compare name "Array" == 0 || string-compare name "Tensor" == 0 || string-compare name "Columnar" == 0)

  -- Operation, packed format (zero means the actual element class), canonical scheme.
  -- Packed widths are the supported 64-bit bootstrap target's physical scalar widths.
  array-plan :: String -> Option (Nat, Nat, String)
  array-plan symbol = if runtime-abi-int < 6 then None else
    if string-compare symbol "cinch.runtime.arrayFromList" == 0 then Some (0, 0, "forall a. List a -> Array a")
    else if string-compare symbol "cinch.runtime.arrayReplicate" == 0 then Some (1, 0, "forall a. Nat -> a -> Array a")
    else if string-compare symbol "cinch.runtime.arrayLen" == 0 then Some (2, 0, "forall a. Array a -> Nat")
    else if string-compare symbol "cinch.runtime.arrayGet" == 0 then Some (3, 0, "forall a. Array a -> Nat -> Option a")
    else if string-compare symbol "cinch.runtime.arraySet" == 0 then Some (4, 0, "forall a. Array a -> Nat -> a -> Option (Array a)")
    else if string-compare symbol "cinch.runtime.arraySlice" == 0 then Some (5, 0, "forall a. Array a -> Nat -> Nat -> Option (Array a)")
    else if string-compare symbol "cinch.runtime.arrayAppend" == 0 then Some (6, 0, "forall a. Array a -> Array a -> Array a")
    else if string-compare symbol "cinch.runtime.tensorReshape" == 0 then Some (7, 0, "forall a. Array Nat -> Array a -> Option (Tensor a)")
    else if string-compare symbol "cinch.runtime.tensorShape" == 0 then Some (8, 0, "forall a. Tensor a -> Array Nat")
    else if string-compare symbol "cinch.runtime.tensorData" == 0 then Some (9, 0, "forall a. Tensor a -> Array a")
    else if string-compare symbol "cinch.runtime.tensorGet" == 0 then Some (10, 0, "forall a. Tensor a -> Array Nat -> Option a")
    else if string-compare symbol "cinch.runtime.tensorSet" == 0 then Some (11, 0, "forall a. Tensor a -> Array Nat -> a -> Option (Tensor a)")
    else if string-compare symbol "cinch.runtime.columnarColumn" == 0 then Some (12, 0, "forall a. Array a -> Columnar a")
    else if string-compare symbol "cinch.runtime.columnarZip" == 0 then Some (13, 0, "forall a b. Columnar a -> Columnar b -> Option (Columnar (a, b))")
    else if string-compare symbol "cinch.runtime.columnarRows" == 0 then Some (14, 0, "forall a. Columnar a -> Nat")
    else if string-compare symbol "cinch.runtime.columnarColumns" == 0 then Some (15, 0, "forall a. Columnar a -> Nat")
    else if string-compare symbol "cinch.runtime.columnarGet" == 0 then Some (16, 0, "forall a. Columnar a -> Nat -> Option a")
    else if string-compare symbol "cinch.runtime.columnarLeft" == 0 then Some (17, 0, "forall a b. Columnar (a, b) -> Option (Columnar a)")
    else if string-compare symbol "cinch.runtime.columnarRight" == 0 then Some (18, 0, "forall a b. Columnar (a, b) -> Option (Columnar b)")
    else if string-compare symbol "cinch.runtime.columnarArray" == 0 then Some (19, 0, "forall a. Columnar a -> Option (Array a)")
    else if string-compare symbol "cinch.runtime.arrayFromListI8" == 0 then Some (0, 385, "List I8 -> Array I8")
    else if string-compare symbol "cinch.runtime.arrayFromListI16" == 0 then Some (0, 386, "List I16 -> Array I16")
    else if string-compare symbol "cinch.runtime.arrayFromListI32" == 0 then Some (0, 388, "List I32 -> Array I32")
    else if string-compare symbol "cinch.runtime.arrayFromListI64" == 0 then Some (0, 392, "List I64 -> Array I64")
    else if string-compare symbol "cinch.runtime.arrayFromListU8" == 0 then Some (0, 257, "List U8 -> Array U8")
    else if string-compare symbol "cinch.runtime.arrayFromListU16" == 0 then Some (0, 258, "List U16 -> Array U16")
    else if string-compare symbol "cinch.runtime.arrayFromListU32" == 0 then Some (0, 260, "List U32 -> Array U32")
    else if string-compare symbol "cinch.runtime.arrayFromListU64" == 0 then Some (0, 264, "List U64 -> Array U64")
    else if string-compare symbol "cinch.runtime.arrayFromListF32" == 0 then Some (0, 260, "List F32 -> Array F32")
    else if string-compare symbol "cinch.runtime.arrayFromListF64" == 0 then Some (0, 264, "List F64 -> Array F64")
    else if string-compare symbol "cinch.runtime.arrayFromListChar" == 0 then Some (0, 260, "List Char -> Array Char")
    else if string-compare symbol "cinch.runtime.arrayFromListUsize" == 0 then Some (0, 264, "List Usize -> Array Usize")
    else if string-compare symbol "cinch.runtime.arrayFromListIsize" == 0 then Some (0, 392, "List Isize -> Array Isize")
    else None
  array-extern :: Nat -> String
  array-extern operation =
    if operation == 0 then "cinch_array_from_list"
    else if operation == 1 then "cinch_array_replicate"
    else if operation == 2 then "cinch_array_len"
    else if operation == 3 then "cinch_array_get"
    else if operation == 4 then "cinch_array_set"
    else if operation == 5 then "cinch_array_slice"
    else if operation == 6 then "cinch_array_append"
    else if operation == 7 then "cinch_tensor_reshape"
    else if operation == 8 then "cinch_tensor_shape"
    else if operation == 9 then "cinch_tensor_data"
    else if operation == 10 then "cinch_tensor_get"
    else if operation == 11 then "cinch_tensor_set"
    else if operation == 12 then "cinch_columnar_column"
    else if operation == 13 then "cinch_columnar_zip"
    else if operation == 14 then "cinch_columnar_rows"
    else if operation == 15 then "cinch_columnar_columns"
    else if operation == 16 then "cinch_columnar_get"
    else if operation == 17 then "cinch_columnar_child"
    else if operation == 18 then "cinch_columnar_child"
    else if operation == 19 then "cinch_columnar_array"
    else ""
