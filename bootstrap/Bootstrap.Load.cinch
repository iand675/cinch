-- Interface loading and dependency identity checks. The complete JSON
-- contract remains attached to every loaded module: loading names is not
-- permission to erase its proofs, layouts, instances or assumptions.
module Bootstrap.Load where

  import Bootstrap.Ast (TypeExpr, portable-law-syntax)
  import Bootstrap.RuntimeAbi (runtime-abi)
  import Bootstrap.Total
  import Bootstrap.Interface (iface-parse, iface-schema-version, fnv-source-hash)
  import Bootstrap.Parse (parse-scheme)
  import Bootstrap.Nominal (interface-global, resolved-entry-valid, resolved-text, resolved-nominals, resolved-measures)
  import Data.Bytes (bytes-compare, bytes-get, bytes-len)
  import Data.Json
  import Text.Json (canonical-bytes)
  import Text.Parse (ParseOutcome, Parsed, Failed)
  import Text.Lex (Span)
  import Algebra.Semigroup

  export ImportedValue, imported-name, imported-symbol, imported-arity, imported-scheme
  export imported-type
  export LoadedInterface, loaded-module, loaded-hash, loaded-contract, nominal-owner
  export loaded-values, loaded-fixities, loaded-imports
  export loaded-exports
  export load-interface, load-interface-set, validate-interface-set
  export loaded-entry, loaded-private-methods
  export InterfaceSet, load-checked-interface-set, check-interface-set, interface-set-members, interface-set-body

  data ImportedValue where
    MkImportedValue :: String -> String -> Nat -> String -> ImportedValue

  imported-name :: ImportedValue -> String
  imported-name v = case v of MkImportedValue name symbol arity scheme -> name

  imported-symbol :: ImportedValue -> String
  imported-symbol v = case v of MkImportedValue name symbol arity scheme -> symbol

  imported-arity :: ImportedValue -> Nat
  imported-arity v = case v of MkImportedValue name symbol arity scheme -> arity

  imported-scheme :: ImportedValue -> String
  imported-scheme v = case v of MkImportedValue name symbol arity scheme -> scheme

  imported-type :: ImportedValue -> ParseOutcome TypeExpr
  imported-type v = parse-scheme (imported-name v) (string-to-bytes (imported-scheme v))

  data LoadedInterface where
    MkLoadedInterface :: String -> String -> Json -> List ImportedValue
      -> List (String, String, Nat) -> List (String, String) -> LoadedInterface

  -- Only a complete dependency-validated set constructs this handle. Keep
  -- typed body graphs once, so method dispatch lookup never reparses them.
  data InterfaceSet where
    CheckedInterfaceSet :: List LoadedInterface -> List TotalGraph -> InterfaceSet
  interface-set-members :: InterfaceSet -> List LoadedInterface
  interface-set-members set = case set of CheckedInterfaceSet members bodies -> members
  interface-set-body :: String -> InterfaceSet -> Option TotalFunction
  interface-set-body native set = case set of CheckedInterfaceSet members bodies -> set-body native bodies
  set-body :: String -> List TotalGraph -> Option TotalFunction
  set-body native bodies = case bodies of Nil -> None; Cons first rest -> (case total-function-closure first native of Some actual -> Some actual; None -> set-body native rest)
  set-value-bodies :: Json -> List TotalGraph
  set-value-bodies rows = case rows of
    JArr row rest -> (case check-total-graph (field "total_body" row) of Some graph -> Cons graph (set-value-bodies rest); None -> set-value-bodies rest)
    other -> Nil
  set-method-bodies :: Json -> List TotalGraph
  set-method-bodies instances = case instances of
    JArr row rest -> set-value-bodies (field "method_bodies" row) <> set-method-bodies rest
    other -> Nil
  set-bodies :: List LoadedInterface -> List TotalGraph
  set-bodies interfaces = case interfaces of
    Nil -> Nil
    Cons first rest ->
      let exports = field "exports" (loaded-contract first) in
      set-value-bodies (field "values" exports) <> set-method-bodies (field "instances" exports) <> set-bodies rest
  check-interface-set :: List LoadedInterface -> Result String InterfaceSet
  check-interface-set loaded = case validate-interface-set loaded of Err error -> Err error; Ok members -> Ok (CheckedInterfaceSet members (set-bodies members))
  load-checked-interface-set :: List (String, String, Bytes) -> Result String InterfaceSet
  load-checked-interface-set inputs = case load-interface-set inputs of Err error -> Err error; Ok members -> Ok (CheckedInterfaceSet members (set-bodies members))

  loaded-module :: LoadedInterface -> String
  loaded-module i = case i of MkLoadedInterface name hash doc values fixes refs -> name

  loaded-hash :: LoadedInterface -> String
  loaded-hash i = case i of MkLoadedInterface name hash doc values fixes refs -> hash

  loaded-contract :: LoadedInterface -> Json
  loaded-contract i = case i of MkLoadedInterface name hash doc values fixes refs -> doc

  loaded-values :: LoadedInterface -> List ImportedValue
  loaded-values i = case i of MkLoadedInterface name hash doc values fixes refs -> values

  loaded-fixities :: LoadedInterface -> List (String, String, Nat)
  loaded-fixities i = case i of MkLoadedInterface name hash doc values fixes refs -> fixes

  loaded-imports :: LoadedInterface -> List (String, String)
  loaded-imports i = case i of MkLoadedInterface name hash doc values fixes refs -> refs

  -- Name, namespace category, defining identity. Contract-only class
  -- members are intentionally absent: only explicit export lists bind
  -- names in the importing module.
  loaded-exports :: LoadedInterface -> List (String, String, String)
  loaded-exports i =
    let exports = field "exports" (loaded-contract i) in
    value-exports (field "values" exports) <> type-exports (field "types" exports)
      <> signature-exports (field "signatures" exports)

  value-exports :: Json -> List (String, String, String)
  value-exports rows = case rows of
    JArr row rest -> Cons (text (field "name" row), "value", text (field "symbol" row)) (value-exports rest)
    other -> Nil

  named-exports :: Json -> String -> String -> List (String, String, String)
  named-exports names kind identity = case names of
    JArr (JStr name) rest -> Cons (name, kind, identity) (named-exports rest kind identity)
    other -> Nil

  ctor-exports :: Json -> List (String, String, String)
  ctor-exports rows = case rows of
    JArr row rest -> Cons (text (field "name" row), "constructor", text (field "symbol" row)) (ctor-exports rest)
    other -> Nil

  type-exports :: Json -> List (String, String, String)
  type-exports rows = case rows of
    JArr row rest -> Cons (text (field "name" row), "type", text (field "identity" row))
      (ctor-exports (field "ctors" row) <> type-exports rest)
    other -> Nil

  method-exports :: String -> Json -> List (String, String, String)
  method-exports owner rows = case rows of
    JArr row rest -> named-exports (field "exports" row) "method"
      (string-concat-all [owner, ".", text (field "name" row)]) <> method-exports owner rest
    other -> Nil

  signature-exports :: Json -> List (String, String, String)
  signature-exports rows = case rows of
    JArr row rest -> named-exports (field "exports" row) "signature" (text (field "identity" row))
      <> method-exports (text (field "identity" row)) (field "methods" row) <> signature-exports rest
    other -> Nil

  -- Recover the full contract for an exported category/identity. Public
  -- spellings are a scope concern; all aliases share this defining row.
  loaded-entry :: LoadedInterface -> String -> String -> Option Json
  loaded-entry i kind identity =
    let exports = field "exports" (loaded-contract i) in
    if same kind "value" then entry-by "symbol" identity (field "values" exports)
    else if same kind "type" then entry-by "identity" identity (field "types" exports)
    else if same kind "signature" then entry-by "identity" identity (field "signatures" exports)
    else if same kind "constructor" then ctor-entry identity (field "types" exports)
    else if same kind "method" then method-entry identity (field "signatures" exports)
    else if same kind "instance" then entry-by "id" identity (field "instances" exports)
    else None

  entry-by :: String -> String -> Json -> Option Json
  entry-by key identity rows = case rows of
    JArr row rest -> if same identity (text (field key row)) then Some row else entry-by key identity rest
    other -> None

  ctor-entry :: String -> Json -> Option Json
  ctor-entry identity rows = case rows of
    JArr row rest -> case entry-by "symbol" identity (field "ctors" row) of
      Some entry -> Some entry
      None -> ctor-entry identity rest
    other -> None

  method-in :: String -> String -> Json -> Option Json
  method-in owner identity rows = case rows of
    JArr row rest -> if same identity (string-concat-all [owner, ".", text (field "name" row)]) then
      Some (JObj "class" (JStr owner) (JObj "identity" (JStr identity) row))
      else method-in owner identity rest
    other -> None

  method-entry :: String -> Json -> Option Json
  method-entry identity rows = case rows of
    JArr row rest -> case method-in (text (field "identity" row)) identity (field "methods" row) of
      Some entry -> Some entry
      None -> method-entry identity rest
    other -> None

  loaded-private-methods :: LoadedInterface -> List (String, String, String)
  loaded-private-methods i =
    private-signature-methods (loaded-module i) (field "signatures" (field "exports" (loaded-contract i)))

  private-signature-methods :: String -> Json -> List (String, String, String)
  private-signature-methods owner rows = case rows of
    JArr row rest ->
      let identity = text (field "identity" row) in
      let inherited = private-signature-methods owner rest in
      if same owner (nominal-owner identity) then private-method-identities identity (field "methods" row) <> inherited
      else inherited
    other -> Nil

  private-method-identities :: String -> Json -> List (String, String, String)
  private-method-identities owner rows = case rows of
    JArr row rest ->
      let more = private-method-identities owner rest in
      (case field "exports" row of
        JArrEnd -> let name = text (field "name" row) in
          Cons (name, "method", string-concat-all [owner, ".", name]) more
        other -> more)
    other -> Nil

  same :: String -> String -> Bool
  same a b = string-compare a b == 0

  field :: String -> Json -> Json
  field name doc = case doc of
    JObj key value rest -> if same name key then value else field name rest
    other -> JNull

  text :: Json -> String
  text value = case value of JStr s -> s; other -> ""

  number :: Json -> Nat
  number value = case value of JNum n -> if n >= 0 then nat-from-int n else 0; other -> 0

  object-p :: Json -> Bool
  object-p value = case value of JObj k v rest -> object-p rest; JObjEnd -> True; other -> False

  array-p :: Json -> Bool
  array-p value = case value of JArr v rest -> array-p rest; JArrEnd -> True; other -> False

  string-p :: Json -> Bool
  string-p value = case value of JStr s -> True; other -> False

  nat-p :: Json -> Bool
  nat-p value = case value of JNum n -> n >= 0; other -> False

  strings-p :: Json -> Bool
  strings-p value = case value of
    JArr v rest -> string-p v && strings-p rest
    JArrEnd -> True
    other -> False

  strings :: Json -> List String
  strings value = case value of JArr v rest -> Cons (text v) (strings rest); other -> Nil

  objects-p :: Json -> Bool
  objects-p value = case value of JArr v rest -> object-p v && objects-p rest; JArrEnd -> True; other -> False

  bools-p :: Json -> Bool
  bools-p value = case value of
    JArr (JBool b) rest -> bools-p rest
    JArrEnd -> True
    other -> False

  array-length :: Json -> Nat
  array-length value = case value of JArr v rest -> 1 + array-length rest; other -> 0

  parameters-valid :: Json -> Json -> List String -> Bool
  parameters-valid parameters names seen = case parameters of
    JArr p rest -> case names of
      JArr (JStr name) more -> same name (text (field "name" p)) && not (member name seen)
        && string-length name > 0 && string-length (text (field "kind" p)) > 0
        && (case field "implicit" p of JBool b -> True; other -> False)
        && parameters-valid rest more (Cons name seen)
      other -> False
    JArrEnd -> case names of JArrEnd -> True; other -> False
    other -> False

  ctors-valid :: Json -> List String -> Bool
  ctors-valid rows seen = case rows of
    JArr row rest ->
      let name = text (field "name" row) in
      string-length name > 0 && not (member name seen)
      && string-length (text (field "symbol" row)) > 0
      && string-length (text (field "scheme" row)) > 0 && nat-p (field "tag" row)
      && resolved-entry-valid row && measure-bodies-valid (resolved-measures row)
      && strings-p (field "fields" row) && bools-p (field "erased" row)
      && array-length (field "fields" row) == array-length (field "erased" row)
      && ctors-valid rest (Cons name seen)
    JArrEnd -> True
    other -> False

  types-valid :: Json -> List String -> Bool
  types-valid rows seen = case rows of
    JArr row rest ->
      let name = text (field "name" row) in
      let kind = text (field "kind" row) in
      string-length name > 0 && not (member name seen)
      && string-length (text (field "identity" row)) > 0
      && member kind ["data", "record", "opaque", "refinement", "signature"]
      && parameters-valid (field "parameters" row) (field "params" row) Nil
      && ctors-valid (field "ctors" row) Nil && strings-p (field "fields" row)
      && (if same kind "refinement" then
        let definition = field "refinement" row in
        string-length (text (field "binder" definition)) > 0
        && string-length (text (field "carrier" definition)) > 0
        && string-length (text (field "predicate" definition)) > 0
        else case field "refinement" row of JNull -> True; other -> False)
      && types-valid rest (Cons name seen)
    JArrEnd -> True
    other -> False

  method-default-valid :: Json -> Bool
  method-default-valid row = case row of
    JObj key value rest ->
      (if same key "default" then (case value of JArr first more -> method-clauses-valid value; other -> False)
       else same key "name" || same key "slot" || same key "exports" || same key "scheme" || same key "resolved")
      && method-default-valid rest
    JObjEnd -> True
    other -> False
  method-clauses-valid :: Json -> Bool
  method-clauses-valid clauses = case clauses of
    JArr (JArr patterns (JArr body JArrEnd)) rest ->
      (case patterns of JArr first more -> True; JArrEnd -> True; other -> False)
      && (case body of JArr first more -> True; JArrEnd -> True; other -> False)
      && method-clauses-valid rest
    JArrEnd -> True
    other -> False
  checked-scheme-spelling :: Json -> Bool
  checked-scheme-spelling row = case resolved-text row of
    Some scheme -> same scheme (text (field "scheme" row))
    None -> True
  methods-valid :: Json -> List String -> Bool
  methods-valid rows seen = case rows of
    JArr row rest ->
      let name = text (field "name" row) in
      string-length name > 0 && not (member name seen)
      && string-length (text (field "scheme" row)) > 0 && strings-p (field "exports" row)
      && nat-p (field "slot" row) && number (field "slot" row) == list-length seen
      && resolved-entry-valid row && measure-bodies-valid (resolved-measures row)
      && checked-scheme-spelling row
      && method-default-valid row
      && methods-valid rest (Cons name seen)
    JArrEnd -> True
    other -> False

  law-fields-valid :: Json -> Bool
  law-fields-valid row = case row of
    JObj key value rest -> (same key "name" || same key "syntax") && law-fields-valid rest
    JObjEnd -> True
    other -> False

  class-laws-valid :: Json -> List String -> Bool
  class-laws-valid rows seen = case rows of
    JArr row rest ->
      let name = text (field "name" row) in
      string-length name > 0 && not (member name seen) && has-field "syntax" row && law-fields-valid row
      && (case field "syntax" row of
        JNull -> True
        syntax -> (case portable-law-syntax (Span 0 0 1 1) (\name -> Some name) syntax of
          Some decoded -> True
          None -> False))
      && class-laws-valid rest (Cons name seen)
    JArrEnd -> True
    other -> False

  signatures-valid :: Json -> List String -> Bool
  signatures-valid rows seen = case rows of
    JArr row rest ->
      let identity = text (field "identity" row) in
      string-length identity > 0 && not (member identity seen) && string-length (text (field "name" row)) > 0
      && strings-p (field "exports" row)
      && parameters-valid (field "parameters" row) (field "params" row) Nil
      && methods-valid (field "methods" row) Nil && class-laws-valid (field "laws" row) Nil
      && signatures-valid rest (Cons identity seen)
    JArrEnd -> True
    other -> False

  conditional-slot :: Nat -> Json -> Option String
  conditional-slot slot rows = case rows of
    JArr (JStr identity) rest -> if slot == 0 then Some identity else conditional-slot (slot - 1) rest
    other -> None
  conditional-contract-valid :: Nat -> Json -> Json -> Bool
  conditional-contract-valid slot methods row =
      let checked = field "checked" row in
      let head = field "head" checked in let implementation = field "implementation" checked in
      (case field "schema" checked of JNum 1 -> True; other -> False)
      && (not (has-field "body" implementation) || (case field "body" implementation of JObj key value rest -> True; other -> False))
      && (case (field "resolved" head, field "resolved" implementation) of (JNull, other) -> False; (other, JNull) -> False; other -> True)
      && resolved-entry-valid head && resolved-entry-valid implementation
      && measure-bodies-valid (resolved-measures head) && measure-bodies-valid (resolved-measures implementation)
      && (case (conditional-slot slot methods, field "identity" implementation) of (Some actual, JStr identity) -> same actual identity && string-length identity > 0; other -> False)
  instance-methods-valid :: Json -> Json -> List Nat -> List String -> Bool
  instance-methods-valid rows methods slots names = case rows of
    JArr row rest ->
      let slot = number (field "slot" row) in
      let name = text (field "name" row) in
      nat-p (field "slot" row) && not (member-slot slot slots)
      && string-length name > 0 && not (member name names)
      && string-length (text (field "scheme" row)) > 0
      && conditional-contract-valid slot methods row
      && instance-methods-valid rest methods (Cons slot slots) (Cons name names)
    JArrEnd -> True
    other -> False
  method-body-declaration :: List String -> String -> String
  method-body-declaration parameters result = case parameters of Nil -> result; Cons first rest -> string-concat-all ["(", first, " -> ", method-body-declaration rest result, ")"]
  method-bodies-valid :: Json -> Json -> List Nat -> List String -> Bool
  method-bodies-valid rows methods slots names = case rows of
    JArr row rest -> let slot = number (field "slot" row) in let identity = text (field "implementation" row) in
      nat-p (field "slot" row) && not (member-slot slot slots) && string-length identity > 0 && not (member identity names)
      && (case conditional-slot slot methods of Some actual -> same actual identity; None -> False)
      && resolved-entry-valid row && (case (field "nominals" (field "resolved" row), field "measures" (field "resolved" row)) of (JArrEnd, JArrEnd) -> True; other -> False)
      && (case check-total-graph (field "total_body" row) of
        Some graph -> (case total-function graph identity of
          Some function -> total-graph-for-roots graph [identity]
            && same (text (field "scheme" (field "resolved" row))) (method-body-declaration (total-parameters function) (total-result function))
          None -> False)
        None -> False)
      && method-bodies-valid rest methods (Cons slot slots) (Cons identity names)
    JArrEnd -> True
    other -> False
  optional-method-bodies-valid :: Json -> Bool
  optional-method-bodies-valid row = if not (has-field "method_bodies" row) then True else case field "method_bodies" row of
    JArr first rest -> (case (field "ctx" row, field "method_contracts" row, field "resolved" row) of
      (JArrEnd, JArrEnd, JNull) -> False
      (JArrEnd, JArrEnd, resolved) -> method-bodies-valid (field "method_bodies" row) (field "methods" row) Nil Nil
      other -> False)
    other -> False
  member-slot :: Nat -> List Nat -> Bool
  member-slot slot slots = case slots of Nil -> False; Cons first rest -> slot == first || member-slot slot rest
  instances-valid :: Json -> List String -> Bool
  instances-valid rows seen = case rows of
    JArr row rest ->
      let identity = text (field "id" row) in
      string-length identity > 0 && not (member identity seen)
      && string-length (text (field "class" row)) > 0 && string-length (text (field "target" row)) > 0
      && strings-p (field "ctx" row) && strings-p (field "methods" row)
      && (case field "implicit" row of JBool value -> True; other -> False)
      && optional-method-bodies-valid row
      && resolved-entry-valid row && measure-bodies-valid (resolved-measures row) && instance-methods-valid (field "method_contracts" row) (field "methods" row) Nil Nil
      && (case field "method_contracts" row of JArrEnd -> True; other -> (case field "resolved" row of JNull -> True; other -> False))
      && instances-valid rest (Cons identity seen)
    JArrEnd -> True
    other -> False

  has-field :: String -> Json -> Bool
  has-field name doc = case doc of JObj key value rest -> same name key || has-field name rest; other -> False
  measure-bodies-valid :: Json -> Bool
  measure-bodies-valid rows = case rows of
    JArr row rest -> (case check-total-graph (field "total_body" row) of
      Some graph -> total-graph-for-roots graph [text (field "identity" row)] && (case total-function graph (text (field "identity" row)) of Some function -> True; None -> False)
      None -> False) && measure-bodies-valid rest
    JArrEnd -> True
    other -> False
  value-body-valid :: Json -> Bool
  value-body-valid row = has-field "total_body" row && (case field "total_body" row of
    JNull -> True
    doc -> (case field "resolved" row of JNull -> False; other -> (case check-total-graph doc of
      Some graph -> (case total-function graph (text (field "symbol" row)) of
        Some function -> list-length (total-parameters function) == number (field "arity" row) && total-graph-for-roots graph [text (field "symbol" row)]
        None -> False)
      None -> False)))
  keyed-ordering-valid :: Json -> Bool
  keyed-ordering-valid row = if not (has-field "keyed_ordering" row) then True else
    case (field "total_body" row, field "resolved" row, field "arity" row) of
      (JNull, JObj key value rest, JNum 4) -> (case read-keyed-ordering (text (field "symbol" row)) (field "keyed_ordering" row) of Some function -> True; None -> False)
      other -> False
  values-valid :: Json -> List String -> Bool
  values-valid values seen = case values of
    JArr v rest ->
      let name = text (field "name" v) in
      string-length name > 0 && not (member name seen)
      && string-length (text (field "symbol" v)) > 0
      && string-length (text (field "scheme" v)) > 0
      && resolved-entry-valid v && measure-bodies-valid (resolved-measures v) && value-body-valid v && keyed-ordering-valid v
      && nat-p (field "arity" v) && values-valid rest (Cons name seen)
    JArrEnd -> True
    other -> False

  refs-valid :: Json -> List String -> Bool
  refs-valid refs seen = case refs of
    JArr r rest ->
      let name = text (field "module" r) in
      string-length name > 0 && not (member name seen)
      && string-length (text (field "iface_hash" r)) > 0 && refs-valid rest (Cons name seen)
    JArrEnd -> True
    other -> False

  fixes-valid :: Json -> List String -> Bool
  fixes-valid fixes seen = case fixes of
    JArr f rest ->
      let op = text (field "op" f) in
      let assoc = text (field "assoc" f) in
      string-length op > 0 && not (member op seen)
      && (same assoc "left" || same assoc "right" || same assoc "none")
      && nat-p (field "prec" f) && number (field "prec" f) <= 9
      && fixes-valid rest (Cons op seen)
    JArrEnd -> True
    other -> False

  member :: String -> List String -> Bool
  member name names = case names of Nil -> False; Cons n rest -> same name n || member name rest

  -- These tables remain intact in loaded-contract. Their detailed
  -- interpretation belongs to kind checking, coherence and ABI lowering.
  envelope-valid :: Json -> Bool
  envelope-valid doc =
    object-p doc && string-length (text (field "module" doc)) > 0
    && string-p (field "compiler" doc) && string-p (field "source_hash" doc)
    && same (text (field "language" doc)) "draft-0.2+amendments"
    && strings-p (field "params" doc) && objects-p (field "units" doc)
    && objects-p (field "assertions" doc) && objects-p (field "contracts" doc)
    && objects-p (field "laws" doc) && objects-p (field "upgrades" doc)
    && strings-p (field "must_use" doc)
    && (let assumptions = field "assumptions" doc in object-p assumptions
      && strings-p (field "primitives" assumptions) && strings-p (field "foreign" assumptions)
      && strings-p (field "declared" assumptions))
    && (let abi = field "abi" doc in object-p abi
      && same (text (field "convention" abi)) "uniform-word, curried apply stub"
      && strings-p (field "symbols" abi) && objects-p (field "layouts" abi))
    && (let exports = field "exports" doc in object-p exports
      && values-valid (field "values" exports) Nil && fixes-valid (field "fixities" exports) Nil
      && types-valid (field "types" exports) Nil && signatures-valid (field "signatures" exports) Nil
      && instances-valid (field "instances" exports) Nil && objects-p (field "foreign" exports))
    && refs-valid (field "imports" doc) Nil

  -- Project root fields structurally. A nested field named `compiler`
  -- or `units` is part of the contract and must never be blanked.
  contract-projection :: Json -> Json
  contract-projection doc = case doc of
    JObj key value rest -> JObj key
      (if same key "compiler" || same key "source_hash" then JStr ""
       else if same key "units" then JArrEnd else value)
      (contract-projection rest)
    other -> doc

  read-values :: Json -> List ImportedValue
  read-values values = case values of
    JArr v rest -> Cons (MkImportedValue (text (field "name" v)) (text (field "symbol" v))
      (number (field "arity" v)) (text (field "scheme" v))) (read-values rest)
    other -> Nil

  read-fixes :: Json -> List (String, String, Nat)
  read-fixes fixes = case fixes of
    JArr f rest -> Cons (text (field "op" f), text (field "assoc" f), number (field "prec" f)) (read-fixes rest)
    other -> Nil

  read-refs :: Json -> List (String, String)
  read-refs refs = case refs of
    JArr r rest -> Cons (text (field "module" r), text (field "iface_hash" r)) (read-refs rest)
    other -> Nil

  load-interface :: String -> String -> Bytes -> Result String LoadedInterface
  load-interface expected-name expected-hash src = case iface-parse src of
    None -> Err "interface is not valid JSON"
    Some doc ->
      if not (same expected-name (text (field "module" doc))) then Err "interface module name mismatch"
      else if not (nat-p (field "schema" doc)) || number (field "schema" doc) /= iface-schema-version then Err "unsupported interface schema"
      else if not (nat-p (field "runtime_abi" doc)) || number (field "runtime_abi" doc) /= runtime-abi then Err "interface runtime ABI mismatch"
      else if not (envelope-valid doc) then Err "malformed interface contract envelope"
      else let hash = fnv-source-hash (canonical-bytes (contract-projection doc)) in
        if not (same hash expected-hash) then Err "interface contract identity mismatch"
        else let exports = field "exports" doc in
          Ok (MkLoadedInterface expected-name hash doc (read-values (field "values" exports))
            (read-fixes (field "fixities" exports)) (read-refs (field "imports" doc)))

  find-interface :: String -> List LoadedInterface -> Option LoadedInterface
  find-interface name loaded = case loaded of
    Nil -> None
    Cons i rest -> if same name (loaded-module i) then Some i else find-interface name rest

  read-set :: List (String, String, Bytes) -> List LoadedInterface -> Result String (List LoadedInterface)
  read-set inputs loaded = case inputs of
    Nil -> Ok (reverse loaded)
    Cons (name, hash, src) rest -> case find-interface name loaded of
      Some previous -> Err (string-concat "duplicate interface module: " name)
      None -> case load-interface name hash src of
        Err message -> Err (string-concat-all [name, ": ", message])
        Ok i -> read-set rest (Cons i loaded)

  verify-refs :: List (String, String) -> List LoadedInterface -> Result String Unit
  verify-refs refs all = case refs of
    Nil -> Ok ()
    Cons (name, hash) rest -> case find-interface name all of
      None -> Err (string-concat "missing interface dependency: " name)
      Some i -> if same hash (loaded-hash i) then verify-refs rest all
        else Err (string-concat "stale interface dependency: " name)

  verify-set :: List LoadedInterface -> List LoadedInterface -> Result String Unit
  verify-set remaining all = case remaining of
    Nil -> Ok ()
    Cons i rest -> case verify-refs (loaded-imports i) all of
      Err message -> Err (string-concat-all [loaded-module i, ": ", message])
      Ok unit -> verify-set rest all

  refs-ready :: List (String, String) -> List String -> Bool
  refs-ready refs done = case refs of Nil -> True; Cons (name, hash) rest -> member name done && refs-ready rest done

  ready-interface :: List LoadedInterface -> List LoadedInterface -> List String -> Option (LoadedInterface, List LoadedInterface)
  ready-interface remaining before done = case remaining of
    Nil -> None
    Cons i rest -> if refs-ready (loaded-imports i) done then Some (i, reverse before <> rest)
      else ready-interface rest (Cons i before) done

  order-interfaces :: List LoadedInterface -> List LoadedInterface -> List String -> Result String (List LoadedInterface)
  order-interfaces remaining ordered done = case remaining of
    Nil -> Ok (reverse ordered)
    Cons first rest -> case ready-interface remaining Nil done of
      None -> Err (string-concat "cyclic interface dependencies involving " (loaded-module first))
      Some (i, pending) -> order-interfaces pending (Cons i ordered) (Cons (loaded-module i) done)

  load-interface-set :: List (String, String, Bytes) -> Result String (List LoadedInterface)
  load-interface-set inputs = case read-set inputs Nil of
    Err message -> Err message
    Ok loaded -> validate-interface-set loaded

  json-rows :: Json -> List Json
  json-rows rows = case rows of JArr row rest -> Cons row (json-rows rest); other -> Nil
  exported-nominals :: Json -> List Json
  exported-nominals rows = case rows of
    JArr row rest -> json-rows (resolved-nominals row) <> exported-nominals rest
    other -> Nil
  constructor-nominals :: Json -> List Json
  constructor-nominals rows = case rows of
    JArr row rest -> exported-nominals (field "ctors" row) <> constructor-nominals rest
    other -> Nil
  method-nominals :: Json -> List Json
  method-nominals rows = case rows of
    JArr row rest -> exported-nominals (field "methods" row) <> method-nominals rest
    other -> Nil
  conditional-method-nominals :: Json -> List Json
  conditional-method-nominals rows = case rows of
    JArr row rest -> let checked = field "checked" row in
      json-rows (resolved-nominals (field "head" checked)) <> json-rows (resolved-nominals (field "implementation" checked)) <> conditional-method-nominals rest
    other -> Nil
  conditional-instance-nominals :: Json -> List Json
  conditional-instance-nominals rows = case rows of
    JArr row rest -> conditional-method-nominals (field "method_contracts" row) <> conditional-instance-nominals rest
    other -> Nil
  interface-nominals :: LoadedInterface -> List Json
  interface-nominals i = let exports = field "exports" (loaded-contract i) in
    exported-nominals (field "values" exports) <> constructor-nominals (field "types" exports)
      <> method-nominals (field "signatures" exports)
      <> exported-nominals (field "instances" exports) <> conditional-instance-nominals (field "instances" exports)
  dependency-names :: List (String, String) -> List String
  dependency-names refs = case refs of Nil -> Nil; Cons (name, hash) rest -> Cons name (dependency-names rest)
  reachable-modules :: List String -> List LoadedInterface -> List String -> List String
  reachable-modules pending all seen = case pending of
    Nil -> seen
    Cons name rest -> if member name seen then reachable-modules rest all seen else
      case find-interface name all of
        None -> reachable-modules rest all (Cons name seen)
        Some i -> reachable-modules (dependency-names (loaded-imports i) <> rest) all (Cons name seen)
  nominal-owner-reversed :: List Char -> Bool -> String
  nominal-owner-reversed chars has-name = case chars of
    Nil -> ""
    Cons c rest -> if char-code c == 46 then (if has-name then pack (reverse rest) else "")
      else nominal-owner-reversed rest True
  nominal-owner :: String -> String
  nominal-owner identity = nominal-owner-reversed (reverse (unpack identity)) False
  prior-nominal :: String -> List (String, Bytes) -> Option Bytes
  prior-nominal name seen = case seen of Nil -> None; Cons (n, bytes) rest -> if same name n then Some bytes else prior-nominal name rest
  method-contracts :: Json -> Json
  method-contracts rows = case rows of
    JArr row rest -> JArr (JObj "name" (field "name" row)
      (JObj "slot" (field "slot" row) (JObj "scheme" (field "scheme" row)
        (JObj "resolved" (field "resolved" row) (JObj "default" (field "default" row) JObjEnd))))) (method-contracts rest)
    other -> JArrEnd
  signature-contract :: Json -> Json
  signature-contract row = JObj "identity" (field "identity" row)
    (JObj "parameters" (field "parameters" row) (JObj "methods" (method-contracts (field "methods" row))
      (JObj "laws" (field "laws" row) JObjEnd)))
  law-export-present :: String -> List (String, String, String) -> Bool
  law-export-present name exports = case exports of
    Nil -> False
    Cons (local, kind, identity) rest -> same name (interface-global identity) || law-export-present name rest

  law-global-present :: String -> List String -> List LoadedInterface -> Bool
  law-global-present name reachable all = case all of
    Nil -> False
    Cons i rest -> (member (loaded-module i) reachable &&
      (law-export-present name (loaded-exports i) || law-export-present name (loaded-private-methods i)))
      || law-global-present name reachable rest

  law-global :: List String -> List LoadedInterface -> String -> Option String
  law-global reachable all name = if law-kernel-name name || member name ["True", "False"]
    || law-global-present name reachable all then Some name else None
  law-kernel-name :: String -> Bool
  law-kernel-name name = case unpack name of
    Cons prefix (Cons dot rest) -> char-code prefix == 98 && char-code dot == 46
    other -> False

  class-law-references-owned :: Json -> List String -> List LoadedInterface -> Bool
  class-law-references-owned rows reachable all = case rows of
    JArr row rest -> (case field "syntax" row of
      JNull -> True
      syntax -> (case portable-law-syntax (Span 0 0 1 1) (law-global reachable all) syntax of
        Some decoded -> True
        None -> False)) && class-law-references-owned rest reachable all
    JArrEnd -> True
    other -> False

  verify-signature-contracts :: Json -> List String -> List LoadedInterface -> Result String Unit
  verify-signature-contracts rows reachable all = case rows of
    JArr row rest ->
      let identity = text (field "identity" row) in
      let owner-name = nominal-owner identity in
      if not (member owner-name reachable) then Err (string-concat "signature identity is outside the checked dependency closure: " identity)
      else case find-interface owner-name all of
        None -> Err (string-concat "missing defining signature interface: " identity)
        Some owner -> case entry-by "identity" identity (field "signatures" (field "exports" (loaded-contract owner))) of
          None -> Err (string-concat "signature identity has no defining contract: " identity)
          Some definition -> if bytes-compare (canonical-bytes (signature-contract row)) (canonical-bytes (signature-contract definition)) == 0
            then (case field "laws" definition of
              JArr first more ->
                if class-law-references-owned (JArr first more) (reachable-modules [owner-name] all Nil) all
                then verify-signature-contracts rest reachable all
                else Err (string-concat "class law references are outside the defining dependency closure: " identity)
              other -> verify-signature-contracts rest reachable all)
            else Err (string-concat "conflicting defining signature contract: " identity)
    JArrEnd -> Ok ()
    other -> Err "invalid signature contract table"
  signature-owner-valid :: Json -> List LoadedInterface -> Bool
  signature-owner-valid row all =
    let identity = text (field "identity" row) in
    case find-interface (nominal-owner identity) all of
      None -> False
      Some owner -> case entry-by "identity" identity (field "signatures" (field "exports" (loaded-contract owner))) of
        None -> not (same (text (field "kind" row)) "signature")
        Some definition -> same (text (field "kind" row)) "signature"
          && bytes-compare (canonical-bytes (field "parameters" row)) (canonical-bytes (field "parameters" definition)) == 0
  verify-nominal-rows :: List Json -> List String -> List LoadedInterface -> List (String, Bytes) -> Result String (List (String, Bytes))
  verify-nominal-rows rows reachable all seen = case rows of
    Nil -> Ok seen
    Cons row rest ->
      let identity = text (field "identity" row) in
      let bytes = canonical-bytes row in
      if not (member (nominal-owner identity) reachable) then Err (string-concat "nominal identity is outside the checked dependency closure: " identity)
      else if not (signature-owner-valid row all) then Err (string-concat "signature identity has no matching defining contract: " identity)
      else case prior-nominal identity seen of
        None -> verify-nominal-rows rest reachable all (Cons (identity, bytes) seen)
        Some prior -> if bytes-compare prior bytes == 0 then verify-nominal-rows rest reachable all seen
          else Err (string-concat "conflicting defining nominal contracts: " identity)
  verify-nominal-set :: List LoadedInterface -> List LoadedInterface -> List (String, Bytes) -> Result String Unit
  verify-nominal-set remaining all seen = case remaining of
    Nil -> Ok ()
    Cons i rest -> case verify-nominal-rows (interface-nominals i) (reachable-modules [loaded-module i] all Nil) all seen of
      Err message -> Err (string-concat-all [loaded-module i, ": ", message])
      Ok checked -> case verify-signature-contracts (field "signatures" (field "exports" (loaded-contract i))) (reachable-modules [loaded-module i] all Nil) all of
        Err message -> Err message
        Ok unit -> verify-nominal-set rest all checked

  body-declaration :: String -> Json -> Json
  body-declaration identity row = JObj "identity" (JStr identity) (JObj "resolved" (field "resolved" row) (JObj "total_body" (field "total_body" row) JObjEnd))
  value-body-declarations :: Json -> List Json
  value-body-declarations rows = case rows of
    JArr row rest -> (case field "total_body" row of JNull -> Nil; doc -> [body-declaration (text (field "symbol" row)) row])
      <> json-rows (resolved-measures row) <> value-body-declarations rest
    other -> Nil
  signature-body-declarations :: Json -> List Json
  signature-body-declarations rows = case rows of
    JArr row rest -> value-body-declarations (field "methods" row) <> signature-body-declarations rest
    other -> Nil
  method-body-declarations :: Json -> List Json
  method-body-declarations rows = case rows of
    JArr row rest -> Cons (body-declaration (text (field "implementation" row)) row) (method-body-declarations rest)
    other -> Nil
  instance-body-declarations :: Json -> List Json
  instance-body-declarations rows = case rows of
    JArr row rest -> method-body-declarations (field "method_bodies" row) <> instance-body-declarations rest
    other -> Nil
  interface-body-declarations :: LoadedInterface -> List Json
  interface-body-declarations i = let exports = field "exports" (loaded-contract i) in
    value-body-declarations (field "values" exports) <> signature-body-declarations (field "signatures" exports)
      <> value-body-declarations (field "instances" exports) <> instance-body-declarations (field "instances" exports) <> conditional-instance-body-declarations (field "instances" exports)
  -- Identity ownership is the longest module prefix followed by a dot.
  -- Compare UTF-8 bytes directly: repeatedly unpacking the whole identity
  -- rescans it for every module and every body graph node.
  body-owner-prefix :: Bytes -> Bytes -> Nat -> Bool
  body-owner-prefix prefix identity offset =
    if offset >= bytes-len prefix then True
    else if offset >= bytes-len identity then False
    else bytes-get prefix offset == bytes-get identity offset && body-owner-prefix prefix identity (offset + 1)
  body-node-owner :: String -> List LoadedInterface -> String -> String
  body-node-owner identity interfaces best = body-node-owner-bytes (string-to-bytes identity) interfaces best (bytes-len (string-to-bytes best))
  body-node-owner-bytes :: Bytes -> List LoadedInterface -> String -> Nat -> String
  body-node-owner-bytes identity interfaces best width = case interfaces of
    Nil -> best
    Cons i rest -> let name = loaded-module i in
      let size = bytes-len (string-to-bytes name) in
      if size > width && body-owner-prefix (string-to-bytes (string-concat name ".")) identity 0 then
        body-node-owner-bytes identity rest name size
      else body-node-owner-bytes identity rest best width
  verify-body-nodes :: Json -> List String -> List LoadedInterface -> List (String, Bytes) -> Result String (List (String, Bytes))
  verify-body-nodes rows reachable all seen = case rows of
    JArr row rest -> let identity = text (field "identity" row) in
      let owner = body-node-owner identity all "" in
      let key = string-concat "#total-definition:" identity in
      let bytes = canonical-bytes row in
      if string-length owner == 0 || not (member owner reachable) then Err (string-concat "total body dependency is outside the checked module closure: " identity)
      else (case prior-nominal key seen of
        None -> verify-body-nodes rest reachable all (Cons (key, bytes) seen)
        Some prior -> if bytes-compare prior bytes == 0 then verify-body-nodes rest reachable all seen
          else Err (string-concat "conflicting actual total body dependency: " identity))
    JArrEnd -> Ok seen
    other -> Err "invalid total body definition table"
  verify-body-declarations :: List Json -> List String -> List LoadedInterface -> List (String, Bytes) -> Result String (List (String, Bytes))
  verify-body-declarations declarations reachable all seen = case declarations of
    Nil -> Ok seen
    Cons row rest -> let identity = text (field "identity" row) in
      let bytes = canonical-bytes (body-declaration identity row) in
      if not (member (body-node-owner identity all "") reachable) then Err (string-concat "total body identity is outside the checked dependency closure: " identity)
      else (case find-interface (body-node-owner identity all "") all of
        None -> Err (string-concat "missing defining total body interface: " identity)
        Some owner -> (case entry-by "symbol" identity (field "values" (field "exports" (loaded-contract owner))) of
          Some definition -> if bytes-compare bytes (canonical-bytes (body-declaration identity definition)) == 0 then verify-body-consistency row rest reachable all seen bytes
            else Err (string-concat "total body disagrees with its declaring module: " identity)
          None -> verify-body-consistency row rest reachable all seen bytes))
  verify-body-consistency :: Json -> List Json -> List String -> List LoadedInterface -> List (String, Bytes) -> Bytes -> Result String (List (String, Bytes))
  verify-body-consistency row rest reachable all seen bytes = let identity = text (field "identity" row) in
    case verify-body-nodes (field "definitions" (field "total_body" row)) reachable all seen of
      Err message -> Err message
      Ok checked -> (case prior-nominal identity checked of
        None -> verify-body-declarations rest reachable all (Cons (identity, bytes) checked)
        Some prior -> if bytes-compare prior bytes == 0 then verify-body-declarations rest reachable all checked
          else Err (string-concat "conflicting defining total body declarations: " identity))
  method-body-owners-valid :: Json -> String -> List LoadedInterface -> Bool
  method-body-owners-valid rows owner all = case rows of
    JArr row rest -> same (body-node-owner (text (field "implementation" row)) all "") owner && method-body-owners-valid rest owner all
    JArrEnd -> True
    other -> False
  instance-body-owners-valid :: Json -> String -> List LoadedInterface -> Bool
  instance-body-owners-valid rows owner all = case rows of
    JArr row rest -> (case field "method_bodies" row of
      JArr first more -> same (body-node-owner (text (field "id" row)) all "") owner && method-body-owners-valid (field "method_bodies" row) owner all
      other -> True) && instance-body-owners-valid rest owner all
    JArrEnd -> True
    other -> False
  ordering-slot-present :: Nat -> Json -> Bool
  ordering-slot-present slot rows = case rows of
    JArr row rest -> number (field "slot" row) == slot || ordering-slot-present slot rest
    other -> False
  ordering-owner-valid :: String -> Json -> List String -> List LoadedInterface -> Bool
  ordering-owner-valid identity row reachable all =
    let owner = body-node-owner identity all "" in
    member owner reachable && member "Relation.Ord" reachable &&
    (case (find-interface owner all, find-interface "Relation.Ord" all, read-keyed-ordering identity (field "keyed_ordering" row)) of
      (Some provider, Some classes, Some body) -> (case (loaded-entry provider "value" identity, loaded-entry classes "signature" "Relation.Ord.Ord", keyed-ordering-slots body) of
        (Some defining, Some declaration, Some (less, greater)) ->
          bytes-compare (canonical-bytes (field "keyed_ordering" defining)) (canonical-bytes (field "keyed_ordering" row)) == 0
          && bytes-compare (canonical-bytes (field "resolved" defining)) (canonical-bytes (field "resolved" row)) == 0
          && ordering-slot-present less (field "methods" declaration) && ordering-slot-present greater (field "methods" declaration)
        other -> False)
      other -> False)
  ordering-owners-valid :: Json -> List String -> List LoadedInterface -> Bool
  ordering-owners-valid rows reachable all = case rows of
    JArr row rest -> (not (has-field "keyed_ordering" row) || ordering-owner-valid (text (field "symbol" row)) row reachable all)
      && ordering-owners-valid rest reachable all
    other -> True
  verify-body-set :: List LoadedInterface -> List LoadedInterface -> List (String, Bytes) -> Result String Unit
  verify-body-set remaining all seen = case remaining of
    Nil -> Ok ()
    Cons i rest ->
      let exports = field "exports" (loaded-contract i) in
      let reachable = reachable-modules [loaded-module i] all Nil in
      if not (instance-body-owners-valid (field "instances" exports) (loaded-module i) all) then Err "method body is not owned by its declaring dictionary module"
      else if not (ordering-owners-valid (field "values" exports) reachable all) then Err "keyed ordering body disagrees with its defining value or dictionary contract"
      else (case verify-body-declarations (interface-body-declarations i) reachable all seen of
      Err message -> Err (string-concat-all [loaded-module i, ": ", message])
      Ok checked -> verify-body-set rest all checked)

  validate-interface-set :: List LoadedInterface -> Result String (List LoadedInterface)
  validate-interface-set loaded = if duplicate-module loaded Nil then Err "duplicate interface module in resolved context"
    else case order-interfaces loaded Nil Nil of
      Err message -> case verify-set loaded loaded of
        Err dependency -> if missing-dependency loaded loaded then Err dependency else Err message
        Ok unit -> Err message
      Ok ordered -> case verify-set loaded loaded of
        Err message -> Err message
        Ok unit -> case verify-nominal-set loaded loaded Nil of Err message -> Err message; Ok checked -> (case verify-body-set loaded loaded Nil of Err message -> Err message; Ok unit -> Ok ordered)

  duplicate-module :: List LoadedInterface -> List String -> Bool
  duplicate-module loaded seen = case loaded of
    Nil -> False
    Cons i rest -> member (loaded-module i) seen || duplicate-module rest (Cons (loaded-module i) seen)

  missing-ref :: List (String, String) -> List LoadedInterface -> Bool
  missing-ref refs loaded = case refs of
    Nil -> False
    Cons (name, hash) rest -> case find-interface name loaded of
      None -> True
      Some i -> missing-ref rest loaded

  missing-dependency :: List LoadedInterface -> List LoadedInterface -> Bool
  missing-dependency remaining loaded = case remaining of
    Nil -> False
    Cons i rest -> missing-ref (loaded-imports i) loaded || missing-dependency rest loaded


  conditional-body-declarations :: Json -> List Json
  conditional-body-declarations rows = case rows of
    JArr row rest -> let checked = field "checked" row in
      json-rows (resolved-measures (field "head" checked)) <> json-rows (resolved-measures (field "implementation" checked)) <> conditional-body-declarations rest
    other -> Nil
  conditional-instance-body-declarations :: Json -> List Json
  conditional-instance-body-declarations rows = case rows of
    JArr row rest -> conditional-body-declarations (field "method_contracts" row) <> conditional-instance-body-declarations rest
    other -> Nil
