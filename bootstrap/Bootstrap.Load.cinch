-- Interface loading and dependency identity checks. The complete JSON
-- contract remains attached to every loaded module: loading names is not
-- permission to erase its proofs, layouts, instances or assumptions.
--
-- A contract is checked once, when its bytes become a `LoadedInterface`:
-- `load-interface` parses the text, checks the envelope and derives the
-- contract identity. A `DInterface` declaration carries that contract and
-- the identity it was derived to, so a consumer that reads the declaration
-- re-admits the pair with `load-interface-from-contract` instead of
-- encoding the contract to bytes and parsing it back.
module Bootstrap.Load where

  import Bootstrap.Ast (TypeExpr, portable-law-syntax)
  import Bootstrap.RuntimeAbi (runtime-abi)
  import Bootstrap.Total
  import Bootstrap.Interface (iface-parse, iface-schema-version, iface-hash, fnv-source-hash)
  import Bootstrap.Parse (parse-scheme)
  import Bootstrap.Nominal (interface-global, resolved-entry-valid, resolved-text, resolved-nominals, resolved-measures)
  import Data.Bytes (bytes-compare, bytes-get, bytes-len)
  import Data.Json
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Text.Json (canonical-bytes)
  import Text.Parse (ParseOutcome, Parsed, Failed)
  import Text.Lex (Span)
  import Algebra.Semigroup

  export ImportedValue, imported-name, imported-symbol, imported-arity, imported-scheme
  export imported-type
  export LoadedInterface, loaded-module, loaded-hash, loaded-contract, nominal-owner
  export loaded-values, loaded-fixities, loaded-imports
  export loaded-exports, loaded-identities
  export load-interface, load-interface-set, validate-interface-set
  export load-interface-from-contract, load-interface-set-from-contracts
  export load-interface-from-document, load-interface-set-from-documents
  export loaded-entry, loaded-private-methods
  export InterfaceSet, load-checked-interface-set, load-checked-interface-set-from-contracts
  export check-interface-set, interface-set-members
  export interface-set-body, interface-set-has-body

  data ImportedValue where
    MkImportedValue :: String -> String -> Nat -> String -> ImportedValue

  imported-name :: ImportedValue -> String
  imported-name v = case v of MkImportedValue name symbol arity scheme -> name

  imported-symbol :: ImportedValue -> String
  imported-symbol v = case v of MkImportedValue name symbol arity scheme -> symbol

  imported-arity :: ImportedValue -> Nat
  imported-arity v = case v of MkImportedValue name symbol arity scheme -> arity

  imported-scheme :: ImportedValue -> String
  imported-scheme v = case v of MkImportedValue name symbol arity scheme -> scheme

  imported-type :: ImportedValue -> ParseOutcome TypeExpr
  imported-type v = parse-scheme (imported-name v) (string-to-bytes (imported-scheme v))

  -- Every exported row by its defining identity, built once per interface:
  -- a consumer asking for one name probes a table instead of scanning the
  -- whole contract document. Each table keeps the first row in document
  -- order, which is the row the scan it replaces returned.
  data ExportEntries where
    MkExportEntries ::
      HashMap String Json -> HashMap String Json -> HashMap String Json
      -> HashMap String Json -> HashMap String Json -> HashMap String Json
      -> HashMap String (List (String, String, String)) -> List String
      -> ExportEntries

  -- `exports` and `private-methods` are the two row sets every consumer asks
  -- for by name, and both are read once here rather than per ask: a law
  -- closure test asks every interface for them, so deriving them per ask was
  -- queries x interfaces x rows work.
  data LoadedInterface where
    MkLoadedInterface :: String -> String -> Json -> List ImportedValue
      -> List (String, String, Nat) -> List (String, String) -> ExportEntries
      -> List (String, String, String) -> List (String, String, String) -> LoadedInterface

  -- Only a complete dependency-validated set constructs this handle. Keep
  -- typed body graphs once, so method dispatch lookup never reparses them.
  data InterfaceSet where
    CheckedInterfaceSet :: List LoadedInterface -> List (String, TotalGraph) -> InterfaceSet
  interface-set-members :: InterfaceSet -> List LoadedInterface
  interface-set-members set = case set of CheckedInterfaceSet members bodies -> members
  interface-set-body :: String -> InterfaceSet -> Option TotalFunction
  interface-set-body native set = case set of CheckedInterfaceSet members bodies -> set-body native bodies
  interface-set-has-body :: String -> InterfaceSet -> Bool
  interface-set-has-body native set = case set of CheckedInterfaceSet members bodies -> known-body native bodies
  known-body :: String -> List (String, TotalGraph) -> Bool
  known-body native bodies = case bodies of
    Nil -> False
    Cons (identity, graph) rest -> same native identity || known-body native rest
  set-body :: String -> List (String, TotalGraph) -> Option TotalFunction
  set-body native bodies = case bodies of
    Nil -> None
    Cons (identity, graph) rest -> if not (same native identity) then set-body native rest else
      (case total-function-closure graph native of Some actual -> Some actual; None -> set-body native rest)
  index-graph-bodies :: List TotalGraph -> List (String, TotalGraph)
  index-graph-bodies graphs = case graphs of
    Nil -> Nil
    Cons graph rest -> map (\name -> (name, graph)) (total-graph-symbols graph) <> index-graph-bodies rest
  set-value-bodies :: Json -> List TotalGraph
  set-value-bodies rows = case rows of
    JArr row rest -> (case check-total-graph (field "total_body" row) of Some graph -> Cons graph (set-value-bodies rest); None -> set-value-bodies rest)
    other -> Nil
  set-method-bodies :: Json -> List TotalGraph
  set-method-bodies instances = case instances of
    JArr row rest -> set-value-bodies (field "method_bodies" row) <> set-method-bodies rest
    other -> Nil
  set-bodies :: List LoadedInterface -> List TotalGraph
  set-bodies interfaces = case interfaces of
    Nil -> Nil
    Cons first rest ->
      let exports = field "exports" (loaded-contract first) in
      set-value-bodies (field "values" exports) <> set-method-bodies (field "instances" exports) <> set-bodies rest
  check-interface-set :: List LoadedInterface -> Result String InterfaceSet
  check-interface-set loaded = case validate-interface-set loaded of Err error -> Err error; Ok members -> Ok (CheckedInterfaceSet members (index-graph-bodies (set-bodies members)))
  load-checked-interface-set :: List (String, String, Bytes) -> Result String InterfaceSet
  load-checked-interface-set inputs = case load-interface-set inputs of Err error -> Err error; Ok members -> Ok (CheckedInterfaceSet members (index-graph-bodies (set-bodies members)))
  -- The same set from contracts a caller already holds parsed, each with
  -- the identity its own first load derived and checked.
  load-checked-interface-set-from-contracts :: List (String, String, Json) -> Result String InterfaceSet
  load-checked-interface-set-from-contracts inputs = case load-interface-set-from-contracts inputs of
    Err error -> Err error
    Ok members -> Ok (CheckedInterfaceSet members (index-graph-bodies (set-bodies members)))

  loaded-module :: LoadedInterface -> String
  loaded-module i = case i of MkLoadedInterface name hash doc values fixes refs entries exports private-methods -> name

  loaded-hash :: LoadedInterface -> String
  loaded-hash i = case i of MkLoadedInterface name hash doc values fixes refs entries exports private-methods -> hash

  loaded-contract :: LoadedInterface -> Json
  loaded-contract i = case i of MkLoadedInterface name hash doc values fixes refs entries exports private-methods -> doc

  loaded-values :: LoadedInterface -> List ImportedValue
  loaded-values i = case i of MkLoadedInterface name hash doc values fixes refs entries exports private-methods -> values

  loaded-fixities :: LoadedInterface -> List (String, String, Nat)
  loaded-fixities i = case i of MkLoadedInterface name hash doc values fixes refs entries exports private-methods -> fixes

  loaded-imports :: LoadedInterface -> List (String, String)
  loaded-imports i = case i of MkLoadedInterface name hash doc values fixes refs entries exports private-methods -> refs

  -- Name, namespace category, defining identity. Contract-only class
  -- members are intentionally absent: only explicit export lists bind
  -- names in the importing module. Read once, when the interface is
  -- loaded: every name a consumer binds asks for these rows, so deriving
  -- them per ask cost names x rows allocations per interface.
  loaded-exports :: LoadedInterface -> List (String, String, String)
  loaded-exports i = case i of MkLoadedInterface name hash doc values fixes refs entries exports private-methods -> exports

  -- Every global name this interface exports: `interface-global` of every
  -- exported identity and of every private method identity, encoded once
  -- when the interface was loaded. The global table of `InterfaceIndex` is
  -- built from these.
  loaded-globals :: LoadedInterface -> List String
  loaded-globals i = case i of
    MkLoadedInterface at hash doc values fixes refs entries exports private-methods -> global-entries entries

  -- The defining identities of one public name, document order, each once:
  -- the probe `public-global` and `overloads` make per name, answered from
  -- the name table the load built instead of a scan of every row.
  loaded-identities :: LoadedInterface -> String -> List String
  loaded-identities i name = case i of
    MkLoadedInterface at hash doc values fixes refs entries exports private-methods ->
      identity-list (hash-map-lookup name (name-entries entries))
  identity-list :: Option (List (String, String, String)) -> List String
  identity-list looked = case looked of
    None -> Nil
    Some rows -> identity-rows rows
  identity-rows :: List (String, String, String) -> List String
  identity-rows rows = case rows of
    Nil -> Nil
    Cons (name, kind, identity) rest -> Cons identity (identity-rows rest)

  value-exports :: Json -> List (String, String, String)
  value-exports rows = case rows of
    JArr row rest -> Cons (text (field "name" row), "value", text (field "symbol" row)) (value-exports rest)
    other -> Nil

  named-exports :: Json -> String -> String -> List (String, String, String)
  named-exports names kind identity = case names of
    JArr (JStr name) rest -> Cons (name, kind, identity) (named-exports rest kind identity)
    other -> Nil

  ctor-exports :: Json -> List (String, String, String)
  ctor-exports rows = case rows of
    JArr row rest -> Cons (text (field "name" row), "constructor", text (field "symbol" row)) (ctor-exports rest)
    other -> Nil

  type-exports :: Json -> List (String, String, String)
  type-exports rows = case rows of
    JArr row rest -> Cons (text (field "name" row), "type", text (field "identity" row))
      (if same (text (field "kind" row)) "codata" then type-exports rest
       else ctor-exports (field "ctors" row) <> type-exports rest)
    other -> Nil

  method-exports :: String -> Json -> List (String, String, String)
  method-exports owner rows = case rows of
    JArr row rest -> named-exports (field "exports" row) "method"
      (string-concat-all [owner, ".", text (field "name" row)]) <> method-exports owner rest
    other -> Nil

  signature-exports :: Json -> List (String, String, String)
  signature-exports rows = case rows of
    JArr row rest -> named-exports (field "exports" row) "signature" (text (field "identity" row))
      <> method-exports (text (field "identity" row)) (field "methods" row) <> signature-exports rest
    other -> Nil

  -- Recover the full contract for an exported category/identity. Public
  -- spellings are a scope concern; all aliases share this defining row.
  loaded-entry :: LoadedInterface -> String -> String -> Option Json
  loaded-entry i kind identity = case i of
    MkLoadedInterface name hash doc values fixes refs entries exports private-methods ->
      if same kind "value" then entry-in value-entries identity entries
      else if same kind "type" then entry-in type-entries identity entries
      else if same kind "signature" then entry-in signature-entries identity entries
      else if same kind "constructor" then entry-in constructor-entries identity entries
      else if same kind "method" then entry-in method-entries identity entries
      else if same kind "instance" then entry-in instance-entries identity entries
      else None

  name-entries :: ExportEntries -> HashMap String (List (String, String, String))
  name-entries entries = case entries of
    MkExportEntries values types signatures constructors methods instances names globals -> names
  -- The globals this interface exports, `interface-global` of every export
  -- identity and of every private method identity: the two lists the law
  -- closure compares a name against. Both are encoded once here instead of
  -- per ask, which was queries x interfaces x rows encodings. A list, not a
  -- table: `Hash String` folds `nat-mul` over the bytes, so probing with it
  -- costs more than the short `string-compare` scan it would replace
  -- (design/compilation-speed.md 2.5 measured that).
  global-entries :: ExportEntries -> List String
  global-entries entries = case entries of
    MkExportEntries values types signatures constructors methods instances names globals -> globals
  value-entries :: ExportEntries -> HashMap String Json
  value-entries entries = case entries of
    MkExportEntries values types signatures constructors methods instances names globals -> values
  type-entries :: ExportEntries -> HashMap String Json
  type-entries entries = case entries of
    MkExportEntries values types signatures constructors methods instances names globals -> types
  signature-entries :: ExportEntries -> HashMap String Json
  signature-entries entries = case entries of
    MkExportEntries values types signatures constructors methods instances names globals -> signatures
  constructor-entries :: ExportEntries -> HashMap String Json
  constructor-entries entries = case entries of
    MkExportEntries values types signatures constructors methods instances names globals -> constructors
  method-entries :: ExportEntries -> HashMap String Json
  method-entries entries = case entries of
    MkExportEntries values types signatures constructors methods instances names globals -> methods
  instance-entries :: ExportEntries -> HashMap String Json
  instance-entries entries = case entries of
    MkExportEntries values types signatures constructors methods instances names globals -> instances
  entry-in :: (ExportEntries -> HashMap String Json) -> String -> ExportEntries -> Option Json
  entry-in table identity entries = hash-map-lookup identity (table entries)

  -- The tables are built by descending to the tail first, so the head row of
  -- a repeated identity is the row that survives, as the scan's first match
  -- was. `constructors` skips codata rows: a codata type exports no
  -- constructor, and its own identity carries the row.
  -- `private-methods` is passed in because the load derives it for the
  -- interface itself; the globals table needs the same rows.
  export-entries :: List (String, String, String) -> Json -> ExportEntries
  export-entries private-methods exports =
    let rows = export-rows exports in
    MkExportEntries
      (row-table "symbol" (field "values" exports))
      (row-table "identity" (field "types" exports))
      (row-table "identity" (field "signatures" exports))
      (constructor-table (field "types" exports))
      (method-table (field "signatures" exports))
      (row-table "id" (field "instances" exports))
      (name-rows-table rows)
      (global-rows (rows <> private-methods) Nil)

  global-rows :: List (String, String, String) -> List String -> List String
  global-rows rows globals = case rows of
    Nil -> globals
    Cons row rest -> case row of
      (local, kind, identity) -> global-rows rest (Cons (interface-global identity) globals)

  -- Every exported name, its namespace category and its defining identity.
  export-rows :: Json -> List (String, String, String)
  export-rows exports =
    value-exports (field "values" exports) <> type-exports (field "types" exports)
      <> signature-exports (field "signatures" exports)

  -- A name's rows exactly as the scan this replaces read them off the
  -- export list: document order, the first row of each defining identity,
  -- consed as it went, so the identity list a caller receives is the one
  -- that scan returned. Binding a name probes this table instead of
  -- rebuilding the list and walking every row of the interface.
  name-rows-table :: List (String, String, String) -> HashMap String (List (String, String, String))
  name-rows-table rows = name-rows-fold rows hash-map-empty

  name-rows-fold :: List (String, String, String) -> HashMap String (List (String, String, String)) -> HashMap String (List (String, String, String))
  name-rows-fold rows table = case rows of
    Nil -> table
    Cons row rest -> case row of
      (name, kind, identity) -> case hash-map-lookup name table of
        None -> name-rows-fold rest (hash-map-insert name (Cons row Nil) table)
        Some prior -> if identity-held identity prior then name-rows-fold rest table
          else name-rows-fold rest (hash-map-insert name (Cons row prior) table)

  identity-held :: String -> List (String, String, String) -> Bool
  identity-held identity rows = case rows of
    Nil -> False
    Cons (name, kind, sought) rest -> (same identity sought) || identity-held identity rest

  row-table :: String -> Json -> HashMap String Json
  row-table key rows = case rows of
    JArr row rest -> hash-map-insert (text (field key row)) row (row-table key rest)
    other -> hash-map-empty

  constructor-table :: Json -> HashMap String Json
  constructor-table rows = case rows of
    JArr row rest -> constructor-rows (text (field "kind" row)) (field "ctors" row)
      (constructor-table rest)
    other -> hash-map-empty

  constructor-rows :: String -> Json -> HashMap String Json -> HashMap String Json
  constructor-rows kind rows acc = if same kind "codata" then acc else case rows of
    JArr entry rest -> hash-map-insert (text (field "symbol" entry)) entry (constructor-rows kind rest acc)
    other -> acc

  method-table :: Json -> HashMap String Json
  method-table rows = case rows of
    JArr row rest -> method-rows (text (field "identity" row)) (field "methods" row)
      (method-table rest)
    other -> hash-map-empty

  method-rows :: String -> Json -> HashMap String Json -> HashMap String Json
  method-rows owner rows acc = case rows of
    JArr row rest ->
      let identity = string-concat-all [owner, ".", text (field "name" row)] in
      hash-map-insert identity
        (JObj "class" (JStr owner) (JObj "identity" (JStr identity) row))
        (method-rows owner rest acc)
    other -> acc

  loaded-private-methods :: LoadedInterface -> List (String, String, String)
  loaded-private-methods i = case i of
    MkLoadedInterface name hash doc values fixes refs entries exports private-methods -> private-methods

  private-signature-methods :: String -> Json -> List (String, String, String)
  private-signature-methods owner rows = case rows of
    JArr row rest ->
      let identity = text (field "identity" row) in
      let inherited = private-signature-methods owner rest in
      if same owner (nominal-owner identity) then private-method-identities identity (field "methods" row) <> inherited
      else inherited
    other -> Nil

  private-method-identities :: String -> Json -> List (String, String, String)
  private-method-identities owner rows = case rows of
    JArr row rest ->
      let more = private-method-identities owner rest in
      (case field "exports" row of
        JArrEnd -> let name = text (field "name" row) in
          Cons (name, "method", string-concat-all [owner, ".", name]) more
        other -> more)
    other -> Nil

  same :: String -> String -> Bool
  same a b = string-compare a b == 0

  field :: String -> Json -> Json
  field name doc = case doc of
    JObj key value rest -> if same name key then value else field name rest
    other -> JNull

  text :: Json -> String
  text value = case value of JStr s -> s; other -> ""

  number :: Json -> Nat
  number value = case value of JNum n -> if n >= 0 then nat-from-int n else 0; other -> 0

  object-p :: Json -> Bool
  object-p value = case value of JObj k v rest -> object-p rest; JObjEnd -> True; other -> False

  array-p :: Json -> Bool
  array-p value = case value of JArr v rest -> array-p rest; JArrEnd -> True; other -> False

  string-p :: Json -> Bool
  string-p value = case value of JStr s -> True; other -> False

  nat-p :: Json -> Bool
  nat-p value = case value of JNum n -> n >= 0; other -> False

  strings-p :: Json -> Bool
  strings-p value = case value of
    JArr v rest -> string-p v && strings-p rest
    JArrEnd -> True
    other -> False

  strings :: Json -> List String
  strings value = case value of JArr v rest -> Cons (text v) (strings rest); other -> Nil

  objects-p :: Json -> Bool
  objects-p value = case value of JArr v rest -> object-p v && objects-p rest; JArrEnd -> True; other -> False

  bools-p :: Json -> Bool
  bools-p value = case value of
    JArr (JBool b) rest -> bools-p rest
    JArrEnd -> True
    other -> False

  array-length :: Json -> Nat
  array-length value = case value of JArr v rest -> 1 + array-length rest; other -> 0

  parameters-valid :: Json -> Json -> List String -> Bool
  parameters-valid parameters names seen = case parameters of
    JArr p rest -> case names of
      JArr (JStr name) more -> same name (text (field "name" p)) && not (member name seen)
        && string-length name > 0 && string-length (text (field "kind" p)) > 0
        && (case field "implicit" p of JBool b -> True; other -> False)
        && parameters-valid rest more (Cons name seen)
      other -> False
    JArrEnd -> case names of JArrEnd -> True; other -> False
    other -> False

  ctors-valid :: Json -> List String -> Bool
  ctors-valid rows seen = case rows of
    JArr row rest ->
      let name = text (field "name" row) in
      string-length name > 0 && not (member name seen)
      && string-length (text (field "symbol" row)) > 0
      && string-length (text (field "scheme" row)) > 0 && nat-p (field "tag" row)
      && resolved-entry-valid row && measure-bodies-valid (resolved-measures row)
      && strings-p (field "fields" row) && bools-p (field "erased" row)
      && array-length (field "fields" row) == array-length (field "erased" row)
      && ctors-valid rest (Cons name seen)
    JArrEnd -> True
    other -> False

  record-labels-valid :: Json -> List String -> Bool
  record-labels-valid rows seen = case rows of
    JArr (JStr label) rest -> string-length label > 0 && not (member label seen) && record-labels-valid rest (Cons label seen)
    JArrEnd -> True
    other -> False
  record-contract-valid :: Json -> Bool
  record-contract-valid row = let labels = field "fields" row in
    record-labels-valid labels Nil && (case field "ctors" row of
      JArrEnd -> True
      JArr constructor JArrEnd ->
        same (text (field "identity" row)) (text (field "symbol" constructor))
        && (case field "tag" constructor of JNum tag -> tag == 0; other -> False)
        && array-length labels == array-length (field "fields" constructor)
      other -> False)
  types-valid :: Json -> List String -> Bool
  types-valid rows seen = case rows of
    JArr row rest ->
      let name = text (field "name" row) in
      let kind = text (field "kind" row) in
      string-length name > 0 && not (member name seen)
      && string-length (text (field "identity" row)) > 0
      && member kind ["data", "record", "codata", "opaque", "refinement", "signature"]
      && parameters-valid (field "parameters" row) (field "params" row) Nil
      && ctors-valid (field "ctors" row) Nil && strings-p (field "fields" row)
      && (if same kind "codata" then
        (case field "ctors" row of JArr observation JArrEnd -> record-contract-valid row && (case field "resolved" observation of JNull -> False; other -> True); other -> False)
        else not (same kind "record") || record-contract-valid row)
      && (if same kind "refinement" then
        let definition = field "refinement" row in
        string-length (text (field "binder" definition)) > 0
        && string-length (text (field "carrier" definition)) > 0
        && string-length (text (field "predicate" definition)) > 0
        else case field "refinement" row of JNull -> True; other -> False)
      && types-valid rest (Cons name seen)
    JArrEnd -> True
    other -> False

  method-default-valid :: Json -> Bool
  method-default-valid row = case row of
    JObj key value rest ->
      (if same key "default" then (case value of JArr first more -> method-clauses-valid value; other -> False)
       else same key "name" || same key "slot" || same key "exports" || same key "scheme" || same key "resolved")
      && method-default-valid rest
    JObjEnd -> True
    other -> False
  method-clauses-valid :: Json -> Bool
  method-clauses-valid clauses = case clauses of
    JArr (JArr patterns (JArr body JArrEnd)) rest ->
      (case patterns of JArr first more -> True; JArrEnd -> True; other -> False)
      && (case body of JArr first more -> True; JArrEnd -> True; other -> False)
      && method-clauses-valid rest
    JArrEnd -> True
    other -> False
  checked-scheme-spelling :: Json -> Bool
  checked-scheme-spelling row = case resolved-text row of
    Some scheme -> same scheme (text (field "scheme" row))
    None -> True
  methods-valid :: Json -> List String -> Bool
  methods-valid rows seen = case rows of
    JArr row rest ->
      let name = text (field "name" row) in
      string-length name > 0 && not (member name seen)
      && string-length (text (field "scheme" row)) > 0 && strings-p (field "exports" row)
      && nat-p (field "slot" row) && number (field "slot" row) == list-length seen
      && resolved-entry-valid row && measure-bodies-valid (resolved-measures row)
      && checked-scheme-spelling row
      && method-default-valid row
      && methods-valid rest (Cons name seen)
    JArrEnd -> True
    other -> False

  law-fields-valid :: Json -> Bool
  law-fields-valid row = case row of
    JObj key value rest -> (same key "name" || same key "syntax") && law-fields-valid rest
    JObjEnd -> True
    other -> False

  class-laws-valid :: Json -> List String -> Bool
  class-laws-valid rows seen = case rows of
    JArr row rest ->
      let name = text (field "name" row) in
      string-length name > 0 && not (member name seen) && has-field "syntax" row && law-fields-valid row
      && (case field "syntax" row of
        JNull -> True
        syntax -> (case portable-law-syntax (Span 0 0 1 1) (\name -> Some name) syntax of
          Some decoded -> True
          None -> False))
      && class-laws-valid rest (Cons name seen)
    JArrEnd -> True
    other -> False

  signatures-valid :: Json -> List String -> Bool
  signatures-valid rows seen = case rows of
    JArr row rest ->
      let identity = text (field "identity" row) in
      string-length identity > 0 && not (member identity seen) && string-length (text (field "name" row)) > 0
      && strings-p (field "exports" row)
      && parameters-valid (field "parameters" row) (field "params" row) Nil
      && methods-valid (field "methods" row) Nil && class-laws-valid (field "laws" row) Nil
      && signatures-valid rest (Cons identity seen)
    JArrEnd -> True
    other -> False

  conditional-slot :: Nat -> Json -> Option String
  conditional-slot slot rows = case rows of
    JArr (JStr identity) rest -> if slot == 0 then Some identity else conditional-slot (slot - 1) rest
    other -> None
  conditional-contract-valid :: Nat -> Json -> Json -> Bool
  conditional-contract-valid slot methods row =
      let checked = field "checked" row in
      let head = field "head" checked in let implementation = field "implementation" checked in
      (case field "schema" checked of JNum 1 -> True; other -> False)
      && (not (has-field "body" implementation) || (case field "body" implementation of JObj key value rest -> True; other -> False))
      && (case (field "resolved" head, field "resolved" implementation) of (JNull, other) -> False; (other, JNull) -> False; other -> True)
      && resolved-entry-valid head && resolved-entry-valid implementation
      && measure-bodies-valid (resolved-measures head) && measure-bodies-valid (resolved-measures implementation)
      && (case (conditional-slot slot methods, field "identity" implementation) of (Some actual, JStr identity) -> same actual identity && string-length identity > 0; other -> False)
  instance-methods-valid :: Json -> Json -> List Nat -> List String -> Bool
  instance-methods-valid rows methods slots names = case rows of
    JArr row rest ->
      let slot = number (field "slot" row) in
      let name = text (field "name" row) in
      nat-p (field "slot" row) && not (member-slot slot slots)
      && string-length name > 0 && not (member name names)
      && string-length (text (field "scheme" row)) > 0
      && conditional-contract-valid slot methods row
      && instance-methods-valid rest methods (Cons slot slots) (Cons name names)
    JArrEnd -> True
    other -> False
  method-body-declaration :: List String -> String -> String
  method-body-declaration parameters result = case parameters of Nil -> result; Cons first rest -> string-concat-all ["(", first, " -> ", method-body-declaration rest result, ")"]
  method-bodies-valid :: Json -> Json -> List Nat -> List String -> Bool
  method-bodies-valid rows methods slots names = case rows of
    JArr row rest -> let slot = number (field "slot" row) in let identity = text (field "implementation" row) in
      nat-p (field "slot" row) && not (member-slot slot slots) && string-length identity > 0 && not (member identity names)
      && (case conditional-slot slot methods of Some actual -> same actual identity; None -> False)
      && resolved-entry-valid row && (case (field "nominals" (field "resolved" row), field "measures" (field "resolved" row)) of (JArrEnd, JArrEnd) -> True; other -> False)
      && (case check-total-graph (field "total_body" row) of
        Some graph -> (case total-function graph identity of
          Some function -> total-graph-for-roots graph [identity]
            && same (text (field "scheme" (field "resolved" row))) (method-body-declaration (total-parameters function) (total-result function))
          None -> False)
        None -> False)
      && method-bodies-valid rest methods (Cons slot slots) (Cons identity names)
    JArrEnd -> True
    other -> False
  optional-method-bodies-valid :: Json -> Bool
  optional-method-bodies-valid row = if not (has-field "method_bodies" row) then True else case field "method_bodies" row of
    JArr first rest -> (case (field "ctx" row, field "method_contracts" row, field "resolved" row) of
      (JArrEnd, JArrEnd, JNull) -> False
      (JArrEnd, JArrEnd, resolved) -> method-bodies-valid (field "method_bodies" row) (field "methods" row) Nil Nil
      other -> False)
    other -> False
  member-slot :: Nat -> List Nat -> Bool
  member-slot slot slots = case slots of Nil -> False; Cons first rest -> slot == first || member-slot slot rest
  instances-valid :: Json -> List String -> Bool
  instances-valid rows seen = case rows of
    JArr row rest ->
      let identity = text (field "id" row) in
      string-length identity > 0 && not (member identity seen)
      && string-length (text (field "class" row)) > 0 && string-length (text (field "target" row)) > 0
      && strings-p (field "ctx" row) && strings-p (field "methods" row)
      && (case field "implicit" row of JBool value -> True; other -> False)
      && optional-method-bodies-valid row
      && resolved-entry-valid row && measure-bodies-valid (resolved-measures row) && instance-methods-valid (field "method_contracts" row) (field "methods" row) Nil Nil
      && (case field "method_contracts" row of JArrEnd -> True; other -> (case field "resolved" row of JNull -> True; other -> False))
      && instances-valid rest (Cons identity seen)
    JArrEnd -> True
    other -> False

  has-field :: String -> Json -> Bool
  has-field name doc = case doc of JObj key value rest -> same name key || has-field name rest; other -> False
  measure-bodies-valid :: Json -> Bool
  measure-bodies-valid rows = case rows of
    JArr row rest -> (case check-total-graph (field "total_body" row) of
      Some graph -> total-graph-for-roots graph [text (field "identity" row)] && (case total-function graph (text (field "identity" row)) of Some function -> True; None -> False)
      None -> False) && measure-bodies-valid rest
    JArrEnd -> True
    other -> False
  value-body-valid :: Json -> Bool
  value-body-valid row = has-field "total_body" row && (case field "total_body" row of
    JNull -> True
    doc -> (case field "resolved" row of JNull -> False; other -> (case check-total-graph doc of
      Some graph -> (case total-function graph (text (field "symbol" row)) of
        Some function -> list-length (total-parameters function) == number (field "arity" row) && total-graph-for-roots graph [text (field "symbol" row)]
        None -> False)
      None -> False)))
  keyed-ordering-valid :: Json -> Bool
  keyed-ordering-valid row = if not (has-field "keyed_ordering" row) then True else
    case (field "total_body" row, field "resolved" row, field "arity" row) of
      (JNull, JObj key value rest, JNum 4) -> (case read-keyed-ordering (text (field "symbol" row)) (field "keyed_ordering" row) of Some function -> True; None -> False)
      other -> False
  values-valid :: Json -> List String -> Bool
  values-valid values seen = case values of
    JArr v rest ->
      let name = text (field "name" v) in
      string-length name > 0 && not (member name seen)
      && string-length (text (field "symbol" v)) > 0
      && string-length (text (field "scheme" v)) > 0
      && resolved-entry-valid v && measure-bodies-valid (resolved-measures v) && value-body-valid v && keyed-ordering-valid v
      && nat-p (field "arity" v) && values-valid rest (Cons name seen)
    JArrEnd -> True
    other -> False

  refs-valid :: Json -> List String -> Bool
  refs-valid refs seen = case refs of
    JArr r rest ->
      let name = text (field "module" r) in
      string-length name > 0 && not (member name seen)
      && string-length (text (field "iface_hash" r)) > 0 && refs-valid rest (Cons name seen)
    JArrEnd -> True
    other -> False

  fixes-valid :: Json -> List String -> Bool
  fixes-valid fixes seen = case fixes of
    JArr f rest ->
      let op = text (field "op" f) in
      let assoc = text (field "assoc" f) in
      string-length op > 0 && not (member op seen)
      && (same assoc "left" || same assoc "right" || same assoc "none")
      && nat-p (field "prec" f) && number (field "prec" f) <= 9
      && fixes-valid rest (Cons op seen)
    JArrEnd -> True
    other -> False

  member :: String -> List String -> Bool
  member name names = case names of Nil -> False; Cons n rest -> same name n || member name rest

  -- These tables remain intact in loaded-contract. Their detailed
  -- interpretation belongs to kind checking, coherence and ABI lowering.
  envelope-valid :: Json -> Bool
  envelope-valid doc =
    object-p doc && string-length (text (field "module" doc)) > 0
    && string-p (field "compiler" doc) && string-p (field "source_hash" doc)
    && same (text (field "language" doc)) "draft-0.2+amendments"
    && strings-p (field "params" doc) && objects-p (field "units" doc)
    && objects-p (field "assertions" doc) && objects-p (field "contracts" doc)
    && objects-p (field "laws" doc) && objects-p (field "upgrades" doc)
    && strings-p (field "must_use" doc)
    && (let assumptions = field "assumptions" doc in object-p assumptions
      && strings-p (field "primitives" assumptions) && strings-p (field "foreign" assumptions)
      && strings-p (field "declared" assumptions))
    && (let abi = field "abi" doc in object-p abi
      && same (text (field "convention" abi)) "uniform-word, curried apply stub"
      && strings-p (field "symbols" abi) && objects-p (field "layouts" abi))
    && (let exports = field "exports" doc in object-p exports
      && values-valid (field "values" exports) Nil && fixes-valid (field "fixities" exports) Nil
      && types-valid (field "types" exports) Nil && signatures-valid (field "signatures" exports) Nil
      && instances-valid (field "instances" exports) Nil && objects-p (field "foreign" exports))
    && refs-valid (field "imports" doc) Nil

  -- Project root fields structurally. A nested field named `compiler`
  -- or `units` is part of the contract and must never be blanked.
  contract-projection :: Json -> Json
  contract-projection doc = case doc of
    JObj key value rest -> JObj key
      (if same key "compiler" || same key "source_hash" then JStr ""
       else if same key "units" then JArrEnd else value)
      (contract-projection rest)
    other -> doc

  read-values :: Json -> List ImportedValue
  read-values values = case values of
    JArr v rest -> Cons (MkImportedValue (text (field "name" v)) (text (field "symbol" v))
      (number (field "arity" v)) (text (field "scheme" v))) (read-values rest)
    other -> Nil

  read-fixes :: Json -> List (String, String, Nat)
  read-fixes fixes = case fixes of
    JArr f rest -> Cons (text (field "op" f), text (field "assoc" f), number (field "prec" f)) (read-fixes rest)
    other -> Nil

  read-refs :: Json -> List (String, String)
  read-refs refs = case refs of
    JArr r rest -> Cons (text (field "module" r), text (field "iface_hash" r)) (read-refs rest)
    other -> Nil

  -- What every consumer of a contract must agree with before its rows
  -- mean anything: the module it claims to be, the schema and runtime ABI
  -- this reader understands, and the contract's own internal consistency.
  check-contract-envelope :: String -> Json -> Result String Unit
  check-contract-envelope expected-name doc =
    if not (same expected-name (text (field "module" doc))) then Err "interface module name mismatch"
    else if not (nat-p (field "schema" doc)) || number (field "schema" doc) /= iface-schema-version then Err "unsupported interface schema"
    else if not (nat-p (field "runtime_abi" doc)) || number (field "runtime_abi" doc) /= runtime-abi then Err "interface runtime ABI mismatch"
    else if not (envelope-valid doc) then Err "malformed interface contract envelope"
    else Ok ()

  -- The identity is derived from the artifact's own bytes
  -- (`Bootstrap.Interface.iface-hash`: `source_hash` and `compiler` blanked,
  -- `units` cleared, FNV-1a 64 over the result), not by re-serializing the
  -- parsed document. The two agree by construction: the artifact on disk is
  -- the canonical printer's output, and blanking a string or clearing an
  -- array changes neither key order nor any other byte, so the spliced
  -- source and the reprinted projection have the same bytes. Printing the
  -- document again cost 1.37 blocks per interface byte on a 581,881-byte
  -- interface (design/compilation-speed.md section 2.19), which was the
  -- largest single term in the interface load.
  load-interface :: String -> String -> Bytes -> Result String LoadedInterface
  load-interface expected-name expected-hash src = case iface-parse src of
    None -> Err "interface is not valid JSON"
    Some doc -> case check-contract-envelope expected-name doc of
      Err message -> Err message
      Ok unit -> case iface-hash src doc of
        None -> Err "interface contract identity mismatch"
        Some hash ->
          if not (same hash expected-hash) then Err "interface contract identity mismatch"
          else accepted-interface expected-name hash doc

  -- The contract an interface declaration carries, beside the identity the
  -- load that parsed it derived: the envelope is re-checked, and the pair
  -- is taken as the declaration states it, so no consumer re-encodes the
  -- contract to re-derive a hash it already holds.
  load-interface-from-contract :: String -> String -> Json -> Result String LoadedInterface
  load-interface-from-contract expected-name hash doc = case check-contract-envelope expected-name doc of
    Err message -> Err message
    Ok unit -> accepted-interface expected-name hash doc

  -- The contract a document states, with the identity derived from the
  -- document. An artifact that carries its interfaces as documents (the
  -- runtime object does) admits them here: canonicalising one to parse it
  -- again derived nothing the parse had not already given.
  load-interface-from-document :: String -> String -> Json -> Result String LoadedInterface
  load-interface-from-document expected-name expected-hash doc = case check-contract-envelope expected-name doc of
    Err message -> Err message
    Ok unit ->
      let hash = fnv-source-hash (canonical-bytes (contract-projection doc)) in
      if not (same hash expected-hash) then Err "interface contract identity mismatch"
      else accepted-interface expected-name hash doc

  -- A contract whose envelope and identity are settled: its rows become the
  -- loaded module's tables.
  accepted-interface :: String -> String -> Json -> Result String LoadedInterface
  accepted-interface name hash doc =
    let exports = field "exports" doc in
    let private = private-signature-methods name (field "signatures" exports) in
    Ok (MkLoadedInterface name hash doc (read-values (field "values" exports))
      (read-fixes (field "fixities" exports)) (read-refs (field "imports" doc))
      (export-entries private exports) (export-rows exports) private)

  find-interface :: String -> List LoadedInterface -> Option LoadedInterface
  find-interface name loaded = case loaded of
    Nil -> None
    Cons i rest -> if same name (loaded-module i) then Some i else find-interface name rest

  read-set :: List (String, String, Bytes) -> List LoadedInterface -> Result String (List LoadedInterface)
  read-set inputs loaded = case inputs of
    Nil -> Ok (reverse loaded)
    Cons (name, hash, src) rest -> case find-interface name loaded of
      Some previous -> Err (string-concat "duplicate interface module: " name)
      None -> case load-interface name hash src of
        Err message -> Err (string-concat-all [name, ": ", message])
        Ok i -> read-set rest (Cons i loaded)

  read-document-set :: List (String, String, Json) -> List LoadedInterface -> Result String (List LoadedInterface)
  read-document-set inputs loaded = case inputs of
    Nil -> Ok (reverse loaded)
    Cons (name, hash, doc) rest -> case find-interface name loaded of
      Some previous -> Err (string-concat "duplicate interface module: " name)
      None -> case load-interface-from-document name hash doc of
        Err message -> Err (string-concat-all [name, ": ", message])
        Ok i -> read-document-set rest (Cons i loaded)
  read-contract-set :: List (String, String, Json) -> List LoadedInterface -> Result String (List LoadedInterface)
  read-contract-set inputs loaded = case inputs of
    Nil -> Ok (reverse loaded)
    Cons (name, hash, doc) rest -> case find-interface name loaded of
      Some previous -> Err (string-concat "duplicate interface module: " name)
      None -> case load-interface-from-contract name hash doc of
        Err message -> Err (string-concat-all [name, ": ", message])
        Ok i -> read-contract-set rest (Cons i loaded)

  -- The module index a set check asks its questions of. Built once per
  -- validated set, it answers the three questions the checks ask thousands
  -- of times: which interface a module name denotes, which module exports a
  -- global name (and so whether that name is in a checked closure at all),
  -- and whether a module is in a checked closure. It also carries each
  -- module's name, its width and its `Name.` bytes, so a body node's owner
  -- is decided by comparing bytes that already exist instead of encoding a
  -- fresh prefix per module per node.
  --
  -- The two name lookups are `HashMap` probes. They were list scans until
  -- the `Hash String` instance became FNV-1a over the UTF-8 bytes in a
  -- wrapping 64-bit word (Data.Bytes, design/compilation-speed.md 2.9):
  -- the earlier bignum fold made one 20-character digest cost about 20
  -- microseconds, more than the whole scan it would have replaced, so the
  -- index lost and the scans stayed. With the word fold a digest is about
  -- two microseconds and a probe beats the scan on every set here: the
  -- module table holds every loaded module and the global table holds every
  -- exported identity of every module (thousands of names in the compiler's
  -- own set), and the law closure used to rescan all of that per law
  -- reference.
  --
  -- INVARIANT: a global name is exported by at most one module, because
  -- `interface-global` prefixes the identity with the exporting module's
  -- name. The global table therefore records one owner per name; the fold
  -- inserts the head interface last, so the first interface in the set's
  -- order wins a name, exactly as the scan it replaces answered.
  --
  -- The closure membership tests (`name-in` over `reachable`, over the
  -- ordering pass's `done`) still scan, deliberately: those sets hold tens
  -- of short names, and the scan is measured level with a probe at that
  -- size (design/compilation-speed.md 2.9).
  --
  -- No answer depends on iteration order: the ordered context a caller
  -- receives is still the list the ordering pass produced, and every other
  -- use is a membership test or a probe.
  data InterfaceIndex where
    MkInterfaceIndex :: List LoadedInterface -> HashMap String LoadedInterface -> HashMap String String -> List (String, Nat, Bytes) -> InterfaceIndex

  index-interfaces :: List LoadedInterface -> InterfaceIndex
  index-interfaces loaded =
    MkInterfaceIndex loaded (interface-table loaded hash-map-empty)
      (global-table loaded hash-map-empty) (reverse (index-prefixes loaded Nil))

  -- Module name to interface. The fold inserts the head last, so the first
  -- interface in the set's order wins a repeated module name.
  interface-table :: List LoadedInterface -> HashMap String LoadedInterface -> HashMap String LoadedInterface
  interface-table loaded table = case loaded of
    Nil -> table
    Cons i rest -> interface-table rest (hash-map-insert (loaded-module i) i table)

  -- Global name to exporting module. The head is folded in last, so the
  -- first interface in the set's order wins a repeated name.
  global-table :: List LoadedInterface -> HashMap String String -> HashMap String String
  global-table loaded table = case loaded of
    Nil -> table
    Cons i rest -> global-name-table (loaded-globals i) (loaded-module i) (global-table rest table)

  global-name-table :: List String -> String -> HashMap String String -> HashMap String String
  global-name-table globals module-name table = case globals of
    Nil -> table
    Cons name rest -> global-name-table rest module-name (hash-map-insert name module-name table)

  index-prefixes :: List LoadedInterface -> List (String, Nat, Bytes) -> List (String, Nat, Bytes)
  index-prefixes loaded acc = case loaded of
    Nil -> acc
    Cons i rest -> let name = loaded-module i in
      let prefix = string-to-bytes (string-concat name ".") in
      index-prefixes rest (Cons (name, bytes-len (string-to-bytes name), prefix) acc)

  name-set :: String -> List String -> List String
  name-set name set = Cons name set

  name-in :: String -> List String -> Bool
  name-in name set = member name set

  interface-by-name :: InterfaceIndex -> String -> Option LoadedInterface
  interface-by-name ix name = case ix of MkInterfaceIndex all by-name globals prefixes -> hash-map-lookup name by-name

  interfaces-of :: InterfaceIndex -> List LoadedInterface
  interfaces-of ix = case ix of MkInterfaceIndex all by-name globals prefixes -> all

  prefixes-of :: InterfaceIndex -> List (String, Nat, Bytes)
  prefixes-of ix = case ix of MkInterfaceIndex all by-name globals prefixes -> prefixes

  verify-refs :: List (String, String) -> InterfaceIndex -> Result String Unit
  verify-refs refs ix = case refs of
    Nil -> Ok ()
    Cons (name, hash) rest -> case interface-by-name ix name of
      None -> Err (string-concat "missing interface dependency: " name)
      Some i -> if same hash (loaded-hash i) then verify-refs rest ix
        else Err (string-concat "stale interface dependency: " name)

  verify-set :: List LoadedInterface -> InterfaceIndex -> Result String Unit
  verify-set remaining ix = case remaining of
    Nil -> Ok ()
    Cons i rest -> case verify-refs (loaded-imports i) ix of
      Err message -> Err (string-concat-all [loaded-module i, ": ", message])
      Ok unit -> verify-set rest ix

  refs-ready :: List (String, String) -> List String -> Bool
  refs-ready refs done = case refs of Nil -> True; Cons (name, hash) rest -> name-in name done && refs-ready rest done

  ready-interface :: List LoadedInterface -> List LoadedInterface -> List String -> Option (LoadedInterface, List LoadedInterface)
  ready-interface remaining before done = case remaining of
    Nil -> None
    Cons i rest -> if refs-ready (loaded-imports i) done then Some (i, reverse before <> rest)
      else ready-interface rest (Cons i before) done

  order-interfaces :: List LoadedInterface -> List LoadedInterface -> List String -> Result String (List LoadedInterface)
  order-interfaces remaining ordered done = case remaining of
    Nil -> Ok (reverse ordered)
    Cons first rest -> case ready-interface remaining Nil done of
      None -> Err (string-concat "cyclic interface dependencies involving " (loaded-module first))
      Some (i, pending) -> order-interfaces pending (Cons i ordered) (name-set (loaded-module i) done)

  load-interface-set :: List (String, String, Bytes) -> Result String (List LoadedInterface)
  load-interface-set inputs = case read-set inputs Nil of
    Err message -> Err message
    Ok loaded -> validate-interface-set loaded

  load-interface-set-from-contracts :: List (String, String, Json) -> Result String (List LoadedInterface)
  load-interface-set-from-contracts inputs = case read-contract-set inputs Nil of
    Err message -> Err message
    Ok loaded -> validate-interface-set loaded
  load-interface-set-from-documents :: List (String, String, Json) -> Result String (List LoadedInterface)
  load-interface-set-from-documents inputs = case read-document-set inputs Nil of
    Err message -> Err message
    Ok loaded -> validate-interface-set loaded

  json-rows :: Json -> List Json
  json-rows rows = case rows of JArr row rest -> Cons row (json-rows rest); other -> Nil
  exported-nominals :: Json -> List Json
  exported-nominals rows = case rows of
    JArr row rest -> json-rows (resolved-nominals row) <> exported-nominals rest
    other -> Nil
  constructor-nominals :: Json -> List Json
  constructor-nominals rows = case rows of
    JArr row rest -> exported-nominals (field "ctors" row) <> constructor-nominals rest
    other -> Nil
  method-nominals :: Json -> List Json
  method-nominals rows = case rows of
    JArr row rest -> exported-nominals (field "methods" row) <> method-nominals rest
    other -> Nil
  conditional-method-nominals :: Json -> List Json
  conditional-method-nominals rows = case rows of
    JArr row rest -> let checked = field "checked" row in
      json-rows (resolved-nominals (field "head" checked)) <> json-rows (resolved-nominals (field "implementation" checked)) <> conditional-method-nominals rest
    other -> Nil
  conditional-instance-nominals :: Json -> List Json
  conditional-instance-nominals rows = case rows of
    JArr row rest -> conditional-method-nominals (field "method_contracts" row) <> conditional-instance-nominals rest
    other -> Nil
  interface-nominals :: LoadedInterface -> List Json
  interface-nominals i = let exports = field "exports" (loaded-contract i) in
    exported-nominals (field "values" exports) <> constructor-nominals (field "types" exports)
      <> method-nominals (field "signatures" exports)
      <> exported-nominals (field "instances" exports) <> conditional-instance-nominals (field "instances" exports)
  dependency-names :: List (String, String) -> List String
  dependency-names refs = case refs of Nil -> Nil; Cons (name, hash) rest -> Cons name (dependency-names rest)
  reachable-modules :: List String -> InterfaceIndex -> List String -> List String
  reachable-modules pending ix seen = case pending of
    Nil -> seen
    Cons name rest -> if name-in name seen then reachable-modules rest ix seen else
      case interface-by-name ix name of
        None -> reachable-modules rest ix (name-set name seen)
        Some i -> reachable-modules (dependency-names (loaded-imports i) <> rest) ix (name-set name seen)
  nominal-owner-reversed :: List Char -> Bool -> String
  nominal-owner-reversed chars has-name = case chars of
    Nil -> ""
    Cons c rest -> if char-code c == 46 then (if has-name then pack (reverse rest) else "")
      else nominal-owner-reversed rest True
  nominal-owner :: String -> String
  nominal-owner identity = nominal-owner-reversed (reverse (unpack identity)) False
  prior-nominal :: String -> List (String, Bytes) -> Option Bytes
  prior-nominal name seen = case seen of Nil -> None; Cons (n, bytes) rest -> if same name n then Some bytes else prior-nominal name rest
  method-contracts :: Json -> Json
  method-contracts rows = case rows of
    JArr row rest -> JArr (JObj "name" (field "name" row)
      (JObj "slot" (field "slot" row) (JObj "scheme" (field "scheme" row)
        (JObj "resolved" (field "resolved" row) (JObj "default" (field "default" row) JObjEnd))))) (method-contracts rest)
    other -> JArrEnd
  signature-contract :: Json -> Json
  signature-contract row = JObj "identity" (field "identity" row)
    (JObj "parameters" (field "parameters" row) (JObj "methods" (method-contracts (field "methods" row))
      (JObj "laws" (field "laws" row) JObjEnd)))
  -- The probe the closure makes once per law occurrence: the set's global
  -- table says which module exports the name, and the closure says whether
  -- that module is in it. The walk this replaces rescanned every interface's
  -- exported identities per reference (queries x interfaces x rows); the
  -- table is built once per set, one digest per exported identity.
  law-global-present :: String -> List String -> InterfaceIndex -> Bool
  law-global-present name reachable ix = case ix of
    MkInterfaceIndex all by-name globals prefixes -> case hash-map-lookup name globals of
      None -> False
      Some owner -> name-in owner reachable

  law-global :: List String -> InterfaceIndex -> String -> Option String
  law-global reachable ix name = if law-kernel-name name || member name ["True", "False"]
    || law-global-present name reachable ix then Some name else None
  law-kernel-name :: String -> Bool
  law-kernel-name name = case unpack name of
    Cons prefix (Cons dot rest) -> char-code prefix == 98 && char-code dot == 46
    other -> False

  class-law-references-owned :: Json -> List String -> InterfaceIndex -> Bool
  class-law-references-owned rows reachable ix = case rows of
    JArr row rest -> (case field "syntax" row of
      JNull -> True
      syntax -> (case portable-law-syntax (Span 0 0 1 1) (law-global reachable ix) syntax of
        Some decoded -> True
        None -> False)) && class-law-references-owned rest reachable ix
    JArrEnd -> True
    other -> False

  -- `home` is the interface whose rows these are. When a row's identity is
  -- owned by `home`, the defining contract the check reads is that same row,
  -- so the projection comparison below cannot fail and both canonical forms
  -- are skipped: `canonical-bytes` is deterministic, so a value agrees with
  -- itself. An identity another interface owns is compared as before.
  verify-signature-contracts :: String -> Json -> List String -> InterfaceIndex -> Result String Unit
  verify-signature-contracts home rows reachable ix = case rows of
    JArr row rest ->
      let identity = text (field "identity" row) in
      let owner-name = nominal-owner identity in
      if not (name-in owner-name reachable) then Err (string-concat "signature identity is outside the checked dependency closure: " identity)
      else case interface-by-name ix owner-name of
        None -> Err (string-concat "missing defining signature interface: " identity)
        Some owner -> case loaded-entry owner "signature" identity of
          None -> Err (string-concat "signature identity has no defining contract: " identity)
          Some definition -> if same owner-name home || bytes-compare (canonical-bytes (signature-contract row)) (canonical-bytes (signature-contract definition)) == 0
            then (case field "laws" definition of
              JArr first more ->
                if class-law-references-owned (JArr first more) (reachable-modules [owner-name] ix Nil) ix
                then verify-signature-contracts home rest reachable ix
                else Err (string-concat "class law references are outside the defining dependency closure: " identity)
              other -> verify-signature-contracts home rest reachable ix)
            else Err (string-concat "conflicting defining signature contract: " identity)
    JArrEnd -> Ok ()
    other -> Err "invalid signature contract table"
  signature-owner-valid :: String -> Json -> InterfaceIndex -> Bool
  signature-owner-valid home row ix =
    let identity = text (field "identity" row) in
    case interface-by-name ix (nominal-owner identity) of
      None -> False
      Some owner -> case loaded-entry owner "signature" identity of
        None -> not (same (text (field "kind" row)) "signature")
        Some definition -> same (text (field "kind" row)) "signature"
          && (same (nominal-owner identity) home
            || bytes-compare (canonical-bytes (field "parameters" row)) (canonical-bytes (field "parameters" definition)) == 0)
  -- A nominal row is a mention, so the same identity recurs across the set:
  -- canonicalising each row once up front, where the scan reaches it, is the
  -- cheap order. Deferring the encoding to the first repeat was measured and
  -- costs more, because the repeat is the common case.
  verify-nominal-rows :: String -> List Json -> List String -> InterfaceIndex -> List (String, Bytes) -> Result String (List (String, Bytes))
  verify-nominal-rows home rows reachable ix seen = case rows of
    Nil -> Ok seen
    Cons row rest ->
      let identity = text (field "identity" row) in
      let bytes = canonical-bytes row in
      if not (name-in (nominal-owner identity) reachable) then Err (string-concat "nominal identity is outside the checked dependency closure: " identity)
      else if not (signature-owner-valid home row ix) then Err (string-concat "signature identity has no matching defining contract: " identity)
      else case prior-nominal identity seen of
        None -> verify-nominal-rows home rest reachable ix (Cons (identity, bytes) seen)
        Some prior -> if bytes-compare prior bytes == 0 then verify-nominal-rows home rest reachable ix seen
          else Err (string-concat "conflicting defining nominal contracts: " identity)
  verify-nominal-set :: List LoadedInterface -> InterfaceIndex -> List (String, Bytes) -> Result String Unit
  verify-nominal-set remaining ix seen = case remaining of
    Nil -> Ok ()
    Cons i rest -> let home = loaded-module i in
      let reachable = reachable-modules [home] ix Nil in
      case verify-nominal-rows home (interface-nominals i) reachable ix seen of
        Err message -> Err (string-concat-all [home, ": ", message])
        Ok checked -> case verify-signature-contracts home (field "signatures" (field "exports" (loaded-contract i))) reachable ix of
          Err message -> Err message
          Ok unit -> verify-nominal-set rest ix checked

  body-declaration :: String -> Json -> Json
  body-declaration identity row = JObj "identity" (JStr identity) (JObj "resolved" (field "resolved" row) (JObj "total_body" (field "total_body" row) JObjEnd))
  value-body-declarations :: Json -> List Json
  value-body-declarations rows = case rows of
    JArr row rest -> (case field "total_body" row of JNull -> Nil; doc -> [body-declaration (text (field "symbol" row)) row])
      <> json-rows (resolved-measures row) <> value-body-declarations rest
    other -> Nil
  signature-body-declarations :: Json -> List Json
  signature-body-declarations rows = case rows of
    JArr row rest -> value-body-declarations (field "methods" row) <> signature-body-declarations rest
    other -> Nil
  method-body-declarations :: Json -> List Json
  method-body-declarations rows = case rows of
    JArr row rest -> Cons (body-declaration (text (field "implementation" row)) row) (method-body-declarations rest)
    other -> Nil
  instance-body-declarations :: Json -> List Json
  instance-body-declarations rows = case rows of
    JArr row rest -> method-body-declarations (field "method_bodies" row) <> instance-body-declarations rest
    other -> Nil
  interface-body-declarations :: LoadedInterface -> List Json
  interface-body-declarations i = let exports = field "exports" (loaded-contract i) in
    value-body-declarations (field "values" exports) <> signature-body-declarations (field "signatures" exports)
      <> value-body-declarations (field "instances" exports) <> instance-body-declarations (field "instances" exports) <> conditional-instance-body-declarations (field "instances" exports)
  -- Identity ownership is the longest module prefix followed by a dot.
  -- Compare UTF-8 bytes directly: repeatedly unpacking the whole identity
  -- rescans it for every module and every body graph node.
  body-owner-prefix :: Bytes -> Bytes -> Nat -> Bool
  body-owner-prefix prefix identity offset =
    if offset >= bytes-len prefix then True
    else if offset >= bytes-len identity then False
    else bytes-get prefix offset == bytes-get identity offset && body-owner-prefix prefix identity (offset + 1)
  body-node-owner :: List (String, Nat, Bytes) -> String -> String -> String
  body-node-owner prefixes identity best = body-node-owner-bytes (string-to-bytes identity) prefixes best (bytes-len (string-to-bytes best))
  body-node-owner-bytes :: Bytes -> List (String, Nat, Bytes) -> String -> Nat -> String
  body-node-owner-bytes identity prefixes best width = case prefixes of
    Nil -> best
    Cons entry rest -> case entry of
      (name, size, prefix) ->
        if size > width && body-owner-prefix prefix identity 0 then
          body-node-owner-bytes identity rest name size
        else body-node-owner-bytes identity rest best width
  verify-body-nodes :: Json -> List String -> InterfaceIndex -> List (String, Bytes) -> Result String (List (String, Bytes))
  verify-body-nodes rows reachable ix seen = case rows of
    JArr row rest -> let identity = text (field "identity" row) in
      let owner = body-node-owner (prefixes-of ix) identity "" in
      let key = string-concat "#total-definition:" identity in
      let bytes = canonical-bytes row in
      if string-length owner == 0 || not (name-in owner reachable) then Err (string-concat "total body dependency is outside the checked module closure: " identity)
      else (case prior-nominal key seen of
        None -> verify-body-nodes rest reachable ix (Cons (key, bytes) seen)
        Some prior -> if bytes-compare prior bytes == 0 then verify-body-nodes rest reachable ix seen
          else Err (string-concat "conflicting actual total body dependency: " identity))
    JArrEnd -> Ok seen
    other -> Err "invalid total body definition table"
  verify-body-declarations :: List Json -> List String -> InterfaceIndex -> List (String, Bytes) -> Result String (List (String, Bytes))
  verify-body-declarations declarations reachable ix seen = case declarations of
    Nil -> Ok seen
    Cons row rest -> let identity = text (field "identity" row) in
      let bytes = canonical-bytes (body-declaration identity row) in
      let owner-name = body-node-owner (prefixes-of ix) identity "" in
      if not (name-in owner-name reachable) then Err (string-concat "total body identity is outside the checked dependency closure: " identity)
      else (case interface-by-name ix owner-name of
        None -> Err (string-concat "missing defining total body interface: " identity)
        Some owner -> (case loaded-entry owner "value" identity of
          Some definition -> if bytes-compare bytes (canonical-bytes (body-declaration identity definition)) == 0 then verify-body-consistency row rest reachable ix seen bytes
            else Err (string-concat "total body disagrees with its declaring module: " identity)
          None -> verify-body-consistency row rest reachable ix seen bytes))
  verify-body-consistency :: Json -> List Json -> List String -> InterfaceIndex -> List (String, Bytes) -> Bytes -> Result String (List (String, Bytes))
  verify-body-consistency row rest reachable ix seen bytes = let identity = text (field "identity" row) in
    case verify-body-nodes (field "definitions" (field "total_body" row)) reachable ix seen of
      Err message -> Err message
      Ok checked -> (case prior-nominal identity checked of
        None -> verify-body-declarations rest reachable ix (Cons (identity, bytes) checked)
        Some prior -> if bytes-compare prior bytes == 0 then verify-body-declarations rest reachable ix checked
          else Err (string-concat "conflicting defining total body declarations: " identity))
  method-body-owners-valid :: Json -> String -> InterfaceIndex -> Bool
  method-body-owners-valid rows owner ix = case rows of
    JArr row rest -> same (body-node-owner (prefixes-of ix) (text (field "implementation" row)) "") owner && method-body-owners-valid rest owner ix
    JArrEnd -> True
    other -> False
  instance-body-owners-valid :: Json -> String -> InterfaceIndex -> Bool
  instance-body-owners-valid rows owner ix = case rows of
    JArr row rest -> (case field "method_bodies" row of
      JArr first more -> same (body-node-owner (prefixes-of ix) (text (field "id" row)) "") owner && method-body-owners-valid (field "method_bodies" row) owner ix
      other -> True) && instance-body-owners-valid rest owner ix
    JArrEnd -> True
    other -> False
  ordering-slot-present :: Nat -> Json -> Bool
  ordering-slot-present slot rows = case rows of
    JArr row rest -> number (field "slot" row) == slot || ordering-slot-present slot rest
    other -> False
  ordering-owner-valid :: String -> Json -> List String -> InterfaceIndex -> Bool
  ordering-owner-valid identity row reachable ix =
    let owner = body-node-owner (prefixes-of ix) identity "" in
    name-in owner reachable && name-in "Relation.Ord" reachable &&
    (case (interface-by-name ix owner, interface-by-name ix "Relation.Ord", read-keyed-ordering identity (field "keyed_ordering" row)) of
      (Some provider, Some classes, Some body) -> (case (loaded-entry provider "value" identity, loaded-entry classes "signature" "Relation.Ord.Ord", keyed-ordering-slots body) of
        (Some defining, Some declaration, Some (less, greater)) ->
          bytes-compare (canonical-bytes (field "keyed_ordering" defining)) (canonical-bytes (field "keyed_ordering" row)) == 0
          && bytes-compare (canonical-bytes (field "resolved" defining)) (canonical-bytes (field "resolved" row)) == 0
          && ordering-slot-present less (field "methods" declaration) && ordering-slot-present greater (field "methods" declaration)
        other -> False)
      other -> False)
  ordering-owners-valid :: Json -> List String -> InterfaceIndex -> Bool
  ordering-owners-valid rows reachable ix = case rows of
    JArr row rest -> (not (has-field "keyed_ordering" row) || ordering-owner-valid (text (field "symbol" row)) row reachable ix)
      && ordering-owners-valid rest reachable ix
    other -> True
  verify-body-set :: List LoadedInterface -> InterfaceIndex -> List (String, Bytes) -> Result String Unit
  verify-body-set remaining ix seen = case remaining of
    Nil -> Ok ()
    Cons i rest ->
      let exports = field "exports" (loaded-contract i) in
      let reachable = reachable-modules [loaded-module i] ix Nil in
      if not (instance-body-owners-valid (field "instances" exports) (loaded-module i) ix) then Err "method body is not owned by its declaring dictionary module"
      else if not (ordering-owners-valid (field "values" exports) reachable ix) then Err "keyed ordering body disagrees with its defining value or dictionary contract"
      else (case verify-body-declarations (interface-body-declarations i) reachable ix seen of
      Err message -> Err (string-concat-all [loaded-module i, ": ", message])
      Ok checked -> verify-body-set rest ix checked)

  validate-interface-set :: List LoadedInterface -> Result String (List LoadedInterface)
  validate-interface-set loaded = let ix = index-interfaces loaded in
    if duplicate-module loaded Nil then Err "duplicate interface module in resolved context"
    else case order-interfaces loaded Nil Nil of
      Err message -> case verify-set loaded ix of
        Err dependency -> if missing-dependency loaded ix then Err dependency else Err message
        Ok unit -> Err message
      Ok ordered -> case verify-set loaded ix of
        Err message -> Err message
        Ok unit -> case verify-nominal-set loaded ix Nil of Err message -> Err message; Ok checked -> (case verify-body-set loaded ix Nil of Err message -> Err message; Ok unit -> Ok ordered)

  duplicate-module :: List LoadedInterface -> List String -> Bool
  duplicate-module loaded seen = case loaded of
    Nil -> False
    Cons i rest -> if name-in (loaded-module i) seen then True
      else duplicate-module rest (name-set (loaded-module i) seen)

  missing-ref :: List (String, String) -> InterfaceIndex -> Bool
  missing-ref refs ix = case refs of
    Nil -> False
    Cons (name, hash) rest -> case interface-by-name ix name of
      None -> True
      Some i -> missing-ref rest ix

  missing-dependency :: List LoadedInterface -> InterfaceIndex -> Bool
  missing-dependency remaining ix = case remaining of
    Nil -> False
    Cons i rest -> missing-ref (loaded-imports i) ix || missing-dependency rest ix


  conditional-body-declarations :: Json -> List Json
  conditional-body-declarations rows = case rows of
    JArr row rest -> let checked = field "checked" row in
      json-rows (resolved-measures (field "head" checked)) <> json-rows (resolved-measures (field "implementation" checked)) <> conditional-body-declarations rest
    other -> Nil
  conditional-instance-body-declarations :: Json -> List Json
  conditional-instance-body-declarations rows = case rows of
    JArr row rest -> conditional-body-declarations (field "method_contracts" row) <> conditional-instance-body-declarations rest
    other -> Nil
