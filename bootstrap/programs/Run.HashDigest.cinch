-- The digest benchmark: what one `hash` of a compiler-length name costs,
-- and what a lookup costs through a linear scan against a `HashMap`.
--
-- The names are the shapes the compiler hashes: identifiers of 8 to 40
-- letters (`8 + (i % 33)`), distinct per index (the left pad makes the
-- lengths differ or the base-26 digits differ, so the set is a set).
--
-- Run it by hand with the compiler's own driver,
--
--   cd compiler && cargo run -q --bin cinch -- build ../bootstrap/programs/Run.HashDigest.cinch -o /tmp/hash-bench
--   /tmp/hash-bench
--
-- and read the lines: `hash` (10,000 names hashed once each),
-- `scan k=<n>` (the first k names looked up in a k-name list, so a hit
-- costs about k/2 `Eq` compares), `scan-wide` (the first 200 names looked
-- up in the 10,000-name list) and `map n=10000` (10,000 names inserted
-- into a `HashMap String Nat` and looked back up). Every span is the
-- program's own monotonic clock, in nanoseconds, with the per-operation
-- figure beside it. The exit code is always 0; the numbers are the
-- artifact.

module Main where

  import Data.Hash
  import Data.HashMap
  import Effect.Clock

  -- ------------------------------------------------------------------
  -- The names
  -- ------------------------------------------------------------------

  letter :: Nat -> Char
  letter n = case char-from-code (97 + n) of
    Some c -> c
    None -> 'a'

  -- `n` in base 26, least significant digit first.
  base26 :: Nat -> List Char
  base26 n = if n < 26 then Cons (letter n) Nil
    else Cons (letter (n % 26)) (base26 (n / 26))

  -- `cs` left-padded with 'a' to `n` characters (the names are 8 to 40
  -- long, and the digit strings are at most 3, so the pad always runs).
  pad-to :: List Char -> Nat -> List Char
  pad-to cs n = case list-length cs < n of
    True -> Cons 'a' (pad-to cs (n - 1))
    False -> cs

  name-at :: Nat -> String
  name-at i = pack (pad-to (base26 i) (8 + (i % 33)))

  names-from :: Nat -> Nat -> List String
  names-from i n = if i >= n then Nil else Cons (name-at i) (names-from (i + 1) n)

  -- ------------------------------------------------------------------
  -- The two lookup disciplines over the same keys
  -- ------------------------------------------------------------------

  -- The digest of every name, summed so no fold step is dead.
  hash-all :: List String -> Nat
  hash-all xs = case xs of
    Nil -> 0
    Cons s rest -> nat-add (hash s) (hash-all rest)

  member :: String -> List String -> Bool
  member x xs = case xs of
    Nil -> False
    Cons y rest -> if y == x then True else member x rest

  scan-hits :: List String -> List String -> Nat
  scan-hits keys set = case keys of
    Nil -> 0
    Cons k rest -> if member k set then 1 + scan-hits rest set else scan-hits rest set

  map-insert-all :: List String -> HashMap String Nat -> HashMap String Nat
  map-insert-all xs m = case xs of
    Nil -> m
    Cons s rest -> map-insert-all rest (hash-map-insert s 1 m)

  map-hits :: List String -> HashMap String Nat -> Nat
  map-hits keys m = case keys of
    Nil -> 0
    Cons s rest -> case hash-map-lookup s m of
      Some v -> 1 + map-hits rest m
      None -> map-hits rest m

  -- ------------------------------------------------------------------
  -- Report lines
  -- ------------------------------------------------------------------

  -- The per-operation figure (`checked-div`: a zero count has no answer
  -- to give and never occurs here).
  per-op :: Nat -> Nat -> Nat
  per-op total count = case checked-div total count of
    Some q -> q
    None -> 0

  line3 :: String -> Nat -> Nat -> Nat -> String
  line3 label n total per =
    let a = string-concat label " total-ns=" in
    let b = string-concat a (string-concat (nat-to-string total) " per-op-ns=") in
    string-concat b (string-concat (nat-to-string per) "\n")

  -- A span between two monotonic readings (the readings never go
  -- backwards; saturating keeps the subtraction total).
  span-ns :: Nat -> Nat -> Nat
  span-ns t0 t1 = saturating-sub t1 t0

  -- One name of exactly `len` letters, hashed `n` times: the digest's
  -- cost as a function of length, with the name built once.
  hash-repeat :: String -> Nat -> Nat
  hash-repeat s n = if n == 0 then 0 else nat-add (hash s) (hash-repeat s (n - 1))

  hash-len-phase :: forall r. using (io :: Io r) => Nat -> Nat ->{IO r} String
  hash-len-phase len n =
    let one = pack (pad-to (base26 0) len) in
    let t0 = clock-monotonic-ns () in
    let h = hash-repeat one n in
    let t1 = clock-monotonic-ns () in
    let total = span-ns t0 t1 in
    line3 (string-concat "hash-len len=" (string-concat (nat-to-string len) (string-concat " checksum=" (nat-to-string (h % 1000))))) n total (per-op total n)

  hash-phase :: forall r. using (io :: Io r) => List String ->{IO r} String
  hash-phase ns =
    let t0 = clock-monotonic-ns () in
    let h = hash-all ns in
    let t1 = clock-monotonic-ns () in
    let total = span-ns t0 t1 in
    line3 (string-concat "hash checksum=" (string-concat (nat-to-string (h % 1000)) " ")) 10000 total (per-op total 10000)

  -- `k` names looked up in a list of the same `k` names.
  scan-phase :: forall r. using (io :: Io r) => String -> Nat -> List String ->{IO r} String
  scan-phase label k ns =
    let set = take k ns in
    let keys = take k ns in
    let t0 = clock-monotonic-ns () in
    let hits = scan-hits keys set in
    let t1 = clock-monotonic-ns () in
    let total = span-ns t0 t1 in
    line3 (string-concat label (string-concat " hits=" (string-concat (nat-to-string hits) " "))) k total (per-op total k)

  -- The first 200 names looked up in the whole 10,000-name list: the
  -- average position of a hit is about half the set, which is the number
  -- a scan pays per lookup at this size.
  scan-wide :: forall r. using (io :: Io r) => List String ->{IO r} String
  scan-wide ns =
    let set = ns in
    let keys = take 200 ns in
    let t0 = clock-monotonic-ns () in
    let hits = scan-hits keys set in
    let t1 = clock-monotonic-ns () in
    let total = span-ns t0 t1 in
    line3 (string-concat "scan-wide hits=" (string-concat (nat-to-string hits) " ")) 200 total (per-op total 200)

  -- 10,000 names inserted one at a time, then looked back up.
  map-phase :: forall r. using (io :: Io r) => List String ->{IO r} String
  map-phase ns =
    let t0 = clock-monotonic-ns () in
    let m = map-insert-all ns hash-map-empty in
    let t1 = clock-monotonic-ns () in
    let hits = map-hits ns m in
    let t2 = clock-monotonic-ns () in
    let ins = span-ns t0 t1 in
    let lk = span-ns t1 t2 in
    let size = hash-map-size m in
    let a = string-concat "map insert size=" (nat-to-string size) in
    let b = string-concat a (string-concat " hits=" (nat-to-string hits)) in
    let c = string-concat b (string-concat " total-ns=" (nat-to-string ins)) in
    let d = string-concat c (string-concat " per-insert-ns=" (nat-to-string (per-op ins 10000))) in
    let e = string-concat d (string-concat " lookup-total-ns=" (nat-to-string lk)) in
    string-concat e (string-concat " per-lookup-ns=" (string-concat (nat-to-string (per-op lk 10000)) "\n"))

  -- The name list is built here, once, and handed to `phases` as a
  -- PARAMETER: a `let`-bound value that several phases use is re-evaluated
  -- per use by this compiler, which would put one name build inside every
  -- timed span.
  main :: Unit ->{IO r} Int
  main u = with (io = newIO ()) in
    let t0 = clock-monotonic-ns () in
    let ns = names-from 0 10000 in
    let t1 = clock-monotonic-ns () in
    phases (span-ns t0 t1) ns

  phases :: forall r. using (io :: Io r) => Nat -> List String ->{IO r} Int
  phases build ns =
    let build-line = line3 "names" 10000 build (per-op build 10000) in
    let a = hash-phase ns in
    let a0 = hash-len-phase 0 10000 in
    let a8 = hash-len-phase 8 10000 in
    let a24 = hash-len-phase 24 10000 in
    let a40 = hash-len-phase 40 10000 in
    let b = scan-phase "scan k=64" 64 ns in
    let c = scan-phase "scan k=256" 256 ns in
    let d = scan-phase "scan k=1024" 1024 ns in
    let e = scan-wide ns in
    let f = map-phase ns in
    let lens = string-concat a0 (string-concat a8 (string-concat a24 a40)) in
    let rest = string-concat b (string-concat c (string-concat d (string-concat e f))) in
    let out = string-concat build-line (string-concat a (string-concat lens rest)) in
    case ioWrite (string-to-bytes out) of
      _ -> 0
