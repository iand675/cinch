-- The bootstrap compiler's command line. Without a mode flag it compiles,
-- links and runs, retaining the ladder's original four-path interface.
-- --compile-only links without executing the artifact. --check accepts a
-- source and diagnostics base path and stops after the frontend checks.
-- Either mode accepts --interfaces MANIFEST before the source paths.
module Main where

  import Bootstrap.Driver (read-argv)
  import Bootstrap.Report (render-diagnostic)
  import Bootstrap.Pipeline (PipelineMode, CheckOnly, EmitOnly, EmitWithInterfaces, InterfacesOnly, CompileOnly, CompileAndRun, compile-source-mode, compile-source-with-manifest-mode, compile-source-with-object, compile-source-with-object-interfaces, four-words, pipeline-bad-args)
  import Data.Path (path-from-string)

  run-words :: forall r. using (io :: Io r) => List String ->{IO r, Diverge} Int
  run-words ws = run-options CompileAndRun None None False ws

  run-options :: forall r. using (io :: Io r) => PipelineMode -> Option String -> Option String -> Bool -> List String ->{IO r, Diverge} Int
  run-options mode manifest object-config selected ws = case ws of
    Cons flag rest ->
      if string-compare flag "--check" == 0 then
        if selected then pipeline-bad-args else run-options CheckOnly manifest object-config True rest
      else if string-compare flag "--compile-only" == 0 then
        if selected then pipeline-bad-args else run-options CompileOnly manifest object-config True rest
      else if string-compare flag "--emit-ir" == 0 then
        if selected then pipeline-bad-args else run-options EmitOnly manifest object-config True rest
      else if string-compare flag "--emit-ir-with-interfaces" == 0 then
        if selected then pipeline-bad-args else run-options EmitWithInterfaces manifest object-config True rest
      else if string-compare flag "--emit-interfaces" == 0 then
        if selected then pipeline-bad-args else run-options InterfacesOnly manifest object-config True rest
      else if string-compare flag "--interfaces" == 0 then
        case (manifest, rest) of
          (None, Cons file more) -> run-options mode (Some file) object-config selected more
          other -> pipeline-bad-args
      else if string-compare flag "--objects" == 0 then
        case (object-config, rest) of
          (None, Cons file more) -> run-options mode manifest (Some file) selected more
          other -> pipeline-bad-args
      else run-selected mode manifest object-config ws
    Nil -> pipeline-bad-args

  run-selected :: forall r. using (io :: Io r) => PipelineMode -> Option String -> Option String -> List String ->{IO r, Diverge} Int
  run-selected mode manifest object-config ws = case mode of
    EmitOnly -> case ws of
      Cons source (Cons ir Nil) -> run-source mode manifest object-config source ir ir ir
      other -> pipeline-bad-args
    EmitWithInterfaces -> case ws of
      Cons source (Cons ir Nil) -> run-source mode manifest object-config source ir ir ir
      other -> pipeline-bad-args
    InterfacesOnly -> case ws of
      Cons source (Cons prefix Nil) -> run-source mode manifest object-config source prefix prefix prefix
      other -> pipeline-bad-args
    CheckOnly -> case ws of
      Cons source (Cons diagnostics Nil) -> run-source mode manifest object-config source diagnostics diagnostics diagnostics
      other -> pipeline-bad-args
    other -> case four-words ws of
      None -> pipeline-bad-args
      Some (source, ir, exe, report) -> run-source mode manifest object-config source ir exe report

  run-source :: forall r. using (io :: Io r) => PipelineMode -> Option String -> Option String -> String -> String -> String -> String ->{IO r, Diverge} Int
  run-source mode manifest object-config source ir exe report = case object-config of
    Some configuration -> (case (mode, manifest) of
      (EmitOnly, Some file) -> compile-source-with-object file configuration source (path-from-string ir)
      (EmitWithInterfaces, Some file) -> compile-source-with-object-interfaces file configuration source (path-from-string ir)
      other -> pipeline-bad-args)
    None -> case manifest of
      None -> compile-source-mode mode source (path-from-string ir) (path-from-string exe) (path-from-string report)
      Some file -> compile-source-with-manifest-mode mode file source (path-from-string ir) (path-from-string exe) (path-from-string report)

  main :: Unit ->{IO r, Diverge} Int
  main u = with (io = newIO ()) in run-cli u

  run-cli :: forall r. using (io :: Io r) => Unit ->{IO r, Diverge} Int
  run-cli u = case read-argv u of
    Ok words -> run-words words
    Err d -> case ioWrite (string-to-bytes (render-diagnostic d)) of
      _ -> pipeline-bad-args
