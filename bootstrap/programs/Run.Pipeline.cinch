-- The bootstrap compiler's command line. Without a mode flag it compiles,
-- links and runs, retaining the ladder's original four-path interface.
-- --compile-only links without executing the artifact. --check accepts a
-- source and diagnostics base path and stops after the frontend checks.
-- --emit-bodies accepts a source and output path, checks it, and writes the
-- dense typed Core body document (types in a side table) for every checked
-- definition; it writes no interfaces.
-- Either mode accepts --interfaces MANIFEST before the source paths.
-- --inline copies small units into their call sites. It is off by default:
-- measured on the ladder it removes 30 workers and 0.9 % more IR, and the
-- stage compiler it builds checks the toolkit 0.6 % faster inside the noise
-- while the emitter itself spends 2 % more, so the default keeps the
-- emitter's time.
-- With both compiled inputs selected, run takes RUNTIME PREFIX SOURCE
-- followed by the program's argument words. --rc-debug, in any position
-- before the paths, emits the program's count operations as calls to the
-- runtime's checked out-of-line entries (the rc_debug target profile).
module Main where

  import Bootstrap.Driver (read-argv)
  import Bootstrap.Report (render-diagnostic)
  import Bootstrap.Pipeline (PipelineMode, CheckOnly, BodiesOnly, EmitOnly, EmitWithInterfaces, InterfacesOnly, ObjectOnly, compile-source-library-object, CompileOnly, CompileAndRun, compile-source-mode, compile-source-with-manifest-mode, compile-source-with-object, compile-source-with-object-interfaces, four-words, pipeline-bad-args)
  import Bootstrap.Pipeline (run-source-with-object, compile-source-object, compile-source-library-object-at, report-target-refusal)
  import Bootstrap.Target (target-profile)
  import Data.Path (path-from-string)

  run-words :: forall r. using (io :: Io r) => List String ->{IO r, Diverge} Int
  run-words ws = run-options CompileAndRun None None None False False False ws

  run-options :: forall r. using (io :: Io r) => PipelineMode -> Option String -> Option String -> Option String -> Bool -> Bool -> Bool -> List String ->{IO r, Diverge} Int
  run-options mode manifest object-config wanted debug inlining selected ws = case ws of
    Cons flag rest ->
      if string-compare flag "--check" == 0 then
        if selected then pipeline-bad-args else run-options CheckOnly manifest object-config wanted debug inlining True rest
      else if string-compare flag "--emit-bodies" == 0 then
        if selected then pipeline-bad-args else run-options BodiesOnly manifest object-config wanted debug inlining True rest
      else if string-compare flag "--compile-only" == 0 then
        if selected then pipeline-bad-args else run-options CompileOnly manifest object-config wanted debug inlining True rest
      else if string-compare flag "--emit-ir" == 0 then
        if selected then pipeline-bad-args else run-options EmitOnly manifest object-config wanted debug inlining True rest
      else if string-compare flag "--emit-ir-with-interfaces" == 0 then
        if selected then pipeline-bad-args else run-options EmitWithInterfaces manifest object-config wanted debug inlining True rest
      else if string-compare flag "--emit-object" == 0 then
        if selected then pipeline-bad-args else run-options ObjectOnly manifest object-config wanted debug inlining True rest
      else if string-compare flag "--emit-interfaces" == 0 then
        if selected then pipeline-bad-args else run-options InterfacesOnly manifest object-config wanted debug inlining True rest
      else if string-compare flag "--rc-debug" == 0 then
        if debug then pipeline-bad-args else run-options mode manifest object-config wanted True inlining selected rest
      else if string-compare flag "--inline" == 0 then
        if inlining then pipeline-bad-args else run-options mode manifest object-config wanted debug True selected rest
      else if string-compare flag "--interfaces" == 0 then
        case (manifest, rest) of
          (None, Cons file more) -> run-options mode (Some file) object-config wanted debug inlining selected more
          other -> pipeline-bad-args
      else if string-compare flag "--objects" == 0 then
        case (object-config, rest) of
          (None, Cons file more) -> run-options mode manifest (Some file) wanted debug inlining selected more
          other -> pipeline-bad-args
      else if string-compare flag "--target" == 0 then
        case (wanted, rest) of
          (None, Cons triple more) -> run-options mode manifest object-config (Some triple) debug inlining selected more
          other -> pipeline-bad-args
      else if string-compare flag "run" == 0 then
        case (selected, manifest, object-config, rest) of
          (False, Some contracts, Some provider, Cons runtime (Cons prefix (Cons source words))) ->
            run-source-with-object inlining debug contracts provider runtime prefix source (program-words words)
          other -> pipeline-bad-args
      else run-selected mode manifest object-config wanted debug inlining ws
    Nil -> pipeline-bad-args

  program-words :: List String -> List String
  program-words words = case words of
    Nil -> Nil
    Cons word rest -> if string-compare word "--" == 0 then rest else Cons word (program-words rest)

  -- Debug counting changes only the typed runtime emission. Checking emits
  -- no count operations, so it ignores the flag; a mode that emits code
  -- without a runtime object refuses it.
  run-selected :: forall r. using (io :: Io r) => PipelineMode -> Option String -> Option String -> Option String -> Bool -> Bool -> List String ->{IO r, Diverge} Int
  run-selected mode manifest object-config wanted debug inlining ws = case mode of
    ObjectOnly -> case (debug, manifest, object-config, ws) of
      (False, Some contracts, Some provider, Cons source (Cons ir (Cons object (Cons abi (Cons prefix Nil))))) ->
        case target-profile wanted of
          Err message -> report-target-refusal (path-from-string ir) message
          Ok profile -> compile-source-library-object-at inlining profile contracts provider source (path-from-string ir) (path-from-string object) (path-from-string abi) prefix
      other -> pipeline-bad-args
    EmitOnly -> case ws of
      Cons source (Cons ir Nil) -> run-source mode manifest object-config wanted debug inlining source ir ir ir
      other -> pipeline-bad-args
    EmitWithInterfaces -> case ws of
      Cons source (Cons ir Nil) -> run-source mode manifest object-config wanted debug inlining source ir ir ir
      other -> pipeline-bad-args
    InterfacesOnly -> case ws of
      Cons source (Cons prefix Nil) -> run-source mode manifest object-config wanted debug inlining source prefix prefix prefix
      other -> pipeline-bad-args
    CheckOnly -> case ws of
      Cons source (Cons diagnostics Nil) -> run-source mode manifest object-config wanted debug inlining source diagnostics diagnostics diagnostics
      other -> pipeline-bad-args
    BodiesOnly -> case (debug, ws) of
      (False, Cons source (Cons out Nil)) -> run-source mode manifest object-config wanted debug inlining source out out out
      other -> pipeline-bad-args
    other -> case four-words ws of
      None -> pipeline-bad-args
      Some (source, ir, exe, report) -> run-source mode manifest object-config wanted debug inlining source ir exe report

  run-source :: forall r. using (io :: Io r) => PipelineMode -> Option String -> Option String -> Option String -> Bool -> Bool -> String -> String -> String -> String ->{IO r, Diverge} Int
  run-source mode manifest object-config wanted debug inlining source ir exe report = case object-config of
    Some configuration -> (case (mode, manifest) of
      (EmitOnly, Some file) -> compile-source-object inlining debug wanted False file configuration source (path-from-string ir)
      (EmitWithInterfaces, Some file) -> compile-source-object inlining debug wanted True file configuration source (path-from-string ir)
      other -> pipeline-bad-args)
    None -> if debug && emits-code mode then pipeline-bad-args else case manifest of
      None -> compile-source-mode inlining wanted mode source (path-from-string ir) (path-from-string exe) (path-from-string report)
      Some file -> compile-source-with-manifest-mode inlining wanted mode file source (path-from-string ir) (path-from-string exe) (path-from-string report)

  emits-code :: PipelineMode -> Bool
  emits-code mode = case mode of
    CheckOnly -> False
    BodiesOnly -> False
    InterfacesOnly -> False
    other -> True

  main :: Unit ->{IO r, Diverge} Int
  main u = with (io = newIO ()) in run-cli u

  run-cli :: forall r. using (io :: Io r) => Unit ->{IO r, Diverge} Int
  run-cli u = case read-argv u of
    Ok words -> run-words words
    Err d -> case ioWrite (string-to-bytes (render-diagnostic d)) of
      _ -> pipeline-bad-args
