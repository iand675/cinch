module Main where
  import Bootstrap.Ast
  import Bootstrap.Parse (parse-program)
  import Bootstrap.Check (check-program)
  import Bootstrap.Resolve (resolve-program)
  import Bootstrap.Infer
  import Bootstrap.Core
  import Bootstrap.Global
  import Bootstrap.Typing (TypingContext, close-typing-context-with-effects, context-effects)
  import Bootstrap.Type
  import Bootstrap.Index (IBound)
  import Bootstrap.Report (render-diagnostics)
  import Text.Lex (Span)
  import Data.Path (path-from-string)
  import Data.Nat (nat-from-int)
  import Effect.Fs (fs-read, fs-write)
  import Text.Parse (ParseOutcome, Parsed, Failed)

  sp :: Span
  sp = Span 0 0 1 1
  closed :: List CoreDefinition -> Bool
  closed definitions = case definitions of Nil -> True; Cons definition rest -> core-definition-closed definition && closed rest
  effects-closed :: List CoreEffect -> Bool
  effects-closed declarations = case declarations of Nil -> True; Cons declaration rest -> core-effect-closed declaration && effects-closed rest
  every :: List Bool -> Bool
  every values = case values of Nil -> True; Cons value rest -> value && every rest
  no-context :: Option TypingContext -> Bool
  no-context context = case context of None -> True; other -> False
  registry :: Kind -> Scheme -> CoreEffect -> Bool
  registry kind sc declaration =
    let kinds = [("Unit", KType), ("State", kind)] in
    let globals = [GlobalValue "read" "operation" sc] in
    (case close-typing-context-with-effects kinds globals [declaration] of
      Some context -> case context-effects context of Cons found Nil -> string-compare (core-effect-name found) "State" == 0; other -> False
      None -> False)
      && no-context (close-typing-context-with-effects kinds Nil [declaration])
      && no-context (close-typing-context-with-effects kinds [GlobalValue "read" "value" sc] [declaration])
      && no-context (close-typing-context-with-effects kinds [GlobalValue "other" "operation" sc] [declaration])
      && no-context (close-typing-context-with-effects kinds [GlobalValue "read" "operation" (mono (UFun (UCon "Unit" KType) (UCon "Unit" KType)))] [declaration])
      && no-context (close-typing-context-with-effects kinds globals [declaration, declaration])
      && no-context (close-typing-context-with-effects [("Unit", KType), ("State", KEffect)] globals [declaration])
  kernel :: Nat -> Bool
  kernel id =
    let region = UBound id "r" KRegion in
    let q = MkQuant id "r" KRegion False in
    let kind = KFun KRegion KEffect in
    let label = UApp (UCon "State" kind) region in
    let unit = UCon "Unit" KType in
    let row = URow (UArg label UEnd) in
    let sc = MkScheme [q] (UFunEff unit row unit) in
    let op = MkCoreOperation sp "read" 1 sc in
    let good = MkCoreEffect sp "State" kind [q] [op] in
    every
      [ registry kind sc good
      , core-effect-closed good
      , core-effect-closed (MkCoreEffect sp "State" kind [q] [op, MkCoreOperation sp "write" 2 sc])
      , not (core-effect-closed (MkCoreEffect sp "State" KType [q] [op]))
      , not (core-effect-closed (MkCoreEffect sp "Other" kind [q] [op]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] Nil))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q, q] [op]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 0 sc]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [op, MkCoreOperation sp "write" 1 sc]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [op, MkCoreOperation sp "read" 2 sc]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 1 (mono (UFunEff unit row unit))]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 1 (MkScheme [q] (UFun unit unit))]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 1 (MkScheme [q] (UFunEff unit row (UFun unit unit)))]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 1 (MkScheme [q] (UFunEff (UBound id "r" KType) row unit))]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 1 (MkScheme [q] (UFunEff (UBound (id + 1) "a" KType) row unit))]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 1 (MkScheme [q] (UFunEff unit (URow (UArg (UCon "Diverge" KEffect) UEnd)) unit))]))
      , core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "write" 1 (MkScheme [q] (UFun unit (UFunEff unit row unit)))])
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 1 (MkScheme [q] (UFunEff region row unit))]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 1 (MkScheme [q] (UFunEff UEnd row unit))]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 1 (MkScheme [q] (UFunEff unit row UEnd))]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 1 (MkScheme [q] (UFunEff (UApp unit unit) row unit))]))
      , not (core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 1 (MkScheme [q, MkQuant (id + 1) "n" (value-kind (UCon "Nat" KType)) False] (UFunEff (UApp (UCon "Sized" (KFun (value-kind (UCon "Int" KType)) KType)) (UIndex (UCon "Int" KType) (IBound (id + 1) "n"))) row unit))]))
      , core-effect-closed (MkCoreEffect sp "State" kind [q] [MkCoreOperation sp "read" 1 (MkScheme [q, MkQuant (id + 1) "n" (value-kind (UCon "Nat" KType)) False] (UFunEff (UApp (UCon "Sized" (KFun (value-kind (UCon "Nat" KType)) KType)) (UIndex (UCon "Nat" KType) (IBound (id + 1) "n"))) row unit))])
      ]
  run :: Bytes -> (Int, String)
  run source = if not (kernel (340282366920938463463374607431768211456 + bytes-len source)) then (95, "effect kernel accepted a forged declaration") else
    case parse-program "effect-source" source of
      Parsed program Nil -> case resolve-program program of
        (resolved, Nil) -> case check-program resolved of
          Nil -> let result = elaborate-program "effect-source" resolved in
            case elaboration-errors result of
              Nil -> if list-length (elaboration-effects result) > 0 && effects-closed (elaboration-effects result) && closed (elaboration-core result) then (0, "") else (94, "typed effect declaration was not retained")
              errors -> (4, render-diagnostics errors)
          errors -> (4, render-diagnostics errors)
        (resolved, errors) -> (4, render-diagnostics errors)
      other -> (2, "effect source parse failed")
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in case fs-read (path-from-string "source.cinch") of
    Err error -> 90
    Ok source -> let (status, report) = run source in case fs-write (path-from-string "effect-source-report.txt") (string-to-bytes report) of
      Err error -> 91
      Ok _ -> status
