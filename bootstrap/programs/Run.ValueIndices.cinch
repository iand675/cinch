-- Typed indices are checked with binding identities supplied after compilation.
module Main where
  import Bootstrap.Type
  import Bootstrap.Index
  import Bootstrap.Core
  import Data.Json
  import Data.Nat (nat-from-int)
  import Text.Json (parse-json)
  import Text.Parse (ParseOutcome, Parsed, Failed)
  import Text.Lex (Span)
  import Data.Path (path-from-string)
  import Effect.Fs (fs-read, fs-write)

  sp :: Span
  sp = Span 0 0 1 1
  nat :: UType
  nat = UCon "Nat" KType
  integer :: UType
  integer = UCon "Int" KType
  clean :: Store -> Bool
  clean st = case store-errors st of Nil -> True; other -> False
  equal :: Store -> UType -> UType -> Bool
  equal st a b = clean (unify sp a b st)
  is-error :: UType -> Bool
  is-error ty = case ty of UError -> True; other -> False
  reserve :: Nat -> Store -> Store
  reserve count st = if count == 0 then st else case fresh-id st of (id, next) -> reserve (count - 1) next
  start :: Nat -> Store
  start nonce = reserve nonce (empty-store "value-indices")
  indexed :: UType -> UType
  indexed index = UApp (UCon "VecNat" (KFun (value-kind nat) KType)) index
  meta-id :: UType -> Nat
  meta-id ty = case ty of UMeta id kind -> id; other -> 0
  index-equals :: Store -> UType -> IndexTerm -> Bool
  index-equals st ty expected = case index-of-type (normalize st ty) of Some value -> index-equal value expected; None -> False
  solve :: Nat -> Bool
  solve nonce = case fresh-meta (value-kind nat) (start nonce) of
    (value, before) -> let after = unify sp (indexed value) (indexed (UIndex nat (IInteger 3))) before in
      clean after && index-equals after value (IInteger 3)
  occurs :: Nat -> Bool
  occurs nonce = case fresh-meta (value-kind nat) (start nonce) of
    (value, before) -> not (clean (unify sp value (UIndex nat (IAdd (IMeta (meta-id value)) (IInteger 1))) before))
  wrong-meta-carrier :: Nat -> Bool
  wrong-meta-carrier nonce = case fresh-meta (value-kind integer) (start nonce) of
    (value, before) -> not (clean (unify sp (UIndex nat (IMeta (meta-id value))) (UIndex nat (IInteger 1)) before))
  type-meta-is-not-index :: Nat -> Bool
  type-meta-is-not-index nonce = case fresh-meta KType (start nonce) of
    (value, before) -> not (clean (unify sp (UIndex nat (IMeta (meta-id value))) (UIndex nat (IInteger 1)) before))
  hidden-unknown-meta :: Nat -> Bool
  hidden-unknown-meta nonce = not (clean (unify sp (UIndex nat (IMultiply (IInteger 0) (IMeta (nonce + 100)))) (UIndex nat (IInteger 0)) (start nonce)))
  escaping :: Nat -> Bool
  escaping nonce = case fresh-meta (value-kind nat) (start nonce) of
    (value, before) -> not (clean (unify sp value (UIndex nat (IRigid (nonce + 100) "inner" 1)) (enter-level before)))
  lowering :: Nat -> Bool
  lowering nonce = case fresh-meta (value-kind nat) (start nonce) of
    (older, first) -> case fresh-meta (value-kind nat) (enter-level first) of
      (younger, before) -> let after = unify sp older (UIndex nat (IAdd (IMeta (meta-id younger)) (IInteger 1))) before in
        clean after && not (clean (unify sp younger (UIndex nat (IRigid (nonce + 100) "inner" 1)) after))
  aliasing :: Nat -> Bool
  aliasing nonce = case fresh-meta (value-kind nat) (start nonce) of
    (a, first) -> case fresh-meta (value-kind nat) first of
      (b, before) -> let after = unify sp b (UIndex nat (IInteger 7)) (unify sp a b before) in
        clean after && index-equals after a (IInteger 7)
  structural-solve :: Nat -> Bool
  structural-solve nonce = case fresh-meta (value-kind nat) (start nonce) of
    (value, before) -> let after = unify sp (UIndex nat (IAdd (IMeta (meta-id value)) (IBound (nonce + 100) "n"))) (UIndex nat (IAdd (IInteger 3) (IBound (nonce + 100) "n"))) before in
      clean after && index-equals after value (IInteger 3)
  generalized :: Nat -> Bool
  generalized nonce = case fresh-meta (value-kind nat) (enter-level (start nonce)) of
    (value, before) -> let scheme = generalize 0 Nil (indexed value) before in
      list-length (scheme-params scheme) == 1 && scheme-closed scheme && (case instantiate scheme before of
        (opened, after) -> clean after && clean (unify sp opened (indexed (UIndex nat (IInteger 7))) after))
  substitution :: Nat -> Bool
  substitution nonce =
    let ty = UIndex (UFun nat nat) (ILambda (nonce + 2) "local" (IAdd (IBound (nonce + 1) "free") (IBound (nonce + 2) "local"))) in
    let result = substitute-bound [(nonce + 1, UBound (nonce + 2) "free" (value-kind nat))] ty in
    equal (start nonce) result (UIndex (UFun nat nat) (ILambda (nonce + 3) "renamed" (IAdd (IBound (nonce + 2) "free") (IBound (nonce + 3) "renamed"))))
  meta-substitution :: Nat -> Bool
  meta-substitution nonce = index-equals (start nonce)
    (abstract-metas [(nonce + 1, UBound (nonce + 2) "n" (value-kind nat))] (UIndex nat (IAdd (IMeta (nonce + 1)) (IInteger 1))))
    (IAdd (IBound (nonce + 2) "n") (IInteger 1))
  definition :: UType -> CoreDefinition
  definition actual = MkCoreDefinition sp "f" (mono nat) Nil Nil Nil [MkCoreClause sp Nil (CUse sp nat "callee" "global" [actual])]
  witness :: Nat -> Bool -> Bool
  witness nonce solved = case fresh-meta (value-kind nat) (start nonce) of
    (value, before) -> let after = if solved then unify sp value (UIndex nat (IInteger 3)) before else before in
      core-definition-closed (seal-definition after (definition value)) == solved
  kind-escape :: Nat -> Bool
  kind-escape nonce = case fresh-meta (value-kind (indexed (UIndex nat (IRigid (nonce + 100) "inner" 1)))) (start nonce) of
    (value, after) -> not (clean after)
  no-discarded-meta :: Nat -> Bool
  no-discarded-meta nonce = case fresh-meta (value-kind nat) (start nonce) of
    (value, before) -> not (core-definition-closed (seal-definition before (definition (UIndex nat (IMultiply (IInteger 0) (IMeta (meta-id value)))))))

  cases :: Nat -> List (String, Bool)
  cases nonce =
    let st = start nonce in
    let x = IBound (nonce + 100) "n" in
    let three = UIndex nat (IInteger 3) in
    [ ("literal index has carrier kind", kind-equal (type-kind three) (value-kind nat))
    , ("arbitrary precision natural conversion", index-equals st (UIndex nat (IAdd (IInteger 340282366920938463463374607431768211456) (IInteger (nat-to-int nonce)))) (IInteger (340282366920938463463374607431768211456 + nat-to-int nonce)))
    , ("mathematical integer subtraction", index-equals st (UIndex integer (ISubtract (IInteger 1) (IInteger 7))) (IInteger (0 - 6)))
    , ("natural subtraction with known bound", index-runtime-admissible nat (ISubtract (IInteger 7) (IInteger 1)))
    , ("natural subtraction requires a bound", not (valid-type (UIndex nat (ISubtract x (IInteger 1)))))
    , ("negative natural index rejected", not (valid-type (UIndex nat (IInteger (0 - 1)))))
    , ("natural underflow rejected", not (valid-type (UIndex nat (ISubtract (IInteger 0) (IInteger 1)))))
    , ("simplification cannot hide underflow", not (clean (unify sp (UIndex nat (IMultiply (IInteger 0) (ISubtract (IInteger 0) (IInteger 1)))) (UIndex nat (IInteger 0)) st)))
    , ("simplification cannot hide opaque evaluation", not (index-runtime-admissible nat (IMultiply (IInteger 0) (IGlobal "unsafe.partial"))))
    , ("machine arithmetic is not mathematical", not (valid-type (UIndex (UCon "U32" KType) (IAdd x (IInteger 1)))))
    , ("carriers never coerce", not (equal st three (UIndex integer (IInteger 3))))
    , ("inferred vector index", solve nonce)
    , ("index occurs check", occurs nonce)
    , ("stored carrier is authoritative", wrong-meta-carrier nonce)
    , ("type variable cannot masquerade as value", type-meta-is-not-index nonce)
    , ("zero multiplication cannot hide unknown meta", hidden-unknown-meta nonce)
    , ("rigid scope escape rejected", escaping nonce)
    , ("younger index variables lowered", lowering nonce)
    , ("transitive index aliases", aliasing nonce)
    , ("structural index equations", structural-solve nonce)
    , ("index-only metas generalize", generalized nonce)
    , ("bound substitution avoids capture", substitution nonce)
    , ("meta substitution visits expressions", meta-substitution nonce)
    , ("wrong carrier substitution rejected", is-error (substitute-bound [(nonce + 100, UIndex integer (IInteger 3))] (UIndex nat x)))
    , ("non-value substitution rejected", is-error (substitute-bound [(nonce + 100, nat)] (UIndex nat x)))
    , ("no invented Core index witness", witness nonce False)
    , ("solved Core index witness retained", witness nonce True)
    , ("opaque Core witness requires reification", not (core-definition-closed (seal-definition st (definition (UIndex nat (IGlobal "unknown.partial"))))))
    , ("typed index carrier codec", case value-carrier (value-kind (indexed three)) of Some carrier -> equal st carrier (indexed three); None -> False)
    , ("bound index normalized canonically", index-equals st (UBound (nonce + 100) "n" (value-kind nat)) x)
    , ("rigid index cannot escape through a carrier", kind-escape nonce)
    , ("reflexive natural subtraction is defined", index-runtime-admissible nat (ISubtract x x) && not (equal st (UIndex nat (ISubtract x x)) (UIndex nat (IInteger 0))))
    , ("Core cannot hide undefined subtraction", not (core-definition-closed (seal-definition st (definition (UIndex nat (IMultiply (IInteger 0) (ISubtract (IInteger 0) (IInteger 1))))))))
    , ("Core cannot hide opaque evaluation", not (core-definition-closed (seal-definition st (definition (UIndex nat (IMultiply (IInteger 0) (IGlobal "Unknown.partial")))))))
    , ("Core cannot discard an unresolved value witness", no-discarded-meta nonce)
    , ("symbolic addition needs proof", not (equal st (UIndex nat (IAdd x (IInteger 0))) (UIndex nat x)))
    , ("symbolic zero multiplication needs proof", not (equal st (UIndex nat (IMultiply (IInteger 0) x)) (UIndex nat (IInteger 0))))
    ]
  failures :: List (String, Bool) -> String
  failures rows = case rows of Nil -> ""; Cons (name, ok) rest -> string-concat (if ok then "" else string-concat name "\n") (failures rest)
  same :: String -> String -> Bool
  same a b = string-compare a b == 0
  field :: String -> Json -> Json
  field name doc = case doc of JObj key value rest -> if same name key then value else field name rest; other -> JNull
  answer :: Bool -> (Int, String)
  answer ok = (if ok then 0 else 4, "typed index result")
  decode-type :: Json -> Option UType
  decode-type doc = value-carrier (KValue doc)
  decode-pairs :: Json -> Option (List (Nat, UType))
  decode-pairs doc = case doc of
    JArrEnd -> Some Nil
    JArr (JArr (JNum id) (JArr value JArrEnd)) rest -> if id < 0 then None else
      (case (decode-type value, decode-pairs rest) of (Some ty, Some more) -> Some (Cons (nat-from-int id, ty) more); other -> None)
    other -> None
  -- These packets exercise internal conversion, not source proof admission.
  -- A source elaborator must establish actual bound/global typing and scope.
  request :: Json -> (Int, String)
  request doc = case field "mode" doc of
    JStr mode -> if same mode "selftest" then
      (case field "nonce" doc of
        JNum nonce -> if nonce < 0 then (2, "negative nonce") else let report = failures (cases (nat-from-int nonce)) in
          (if string-length report == 0 then 0 else 4, report)
        other -> (2, "invalid nonce"))
      else if same mode "unify" then
      (case (decode-type (field "left" doc), decode-type (field "right" doc)) of
        (Some left, Some right) -> answer (valid-type left && valid-type right && equal (start 0) left right)
        other -> (2, "invalid type tree"))
      else if same mode "infer" then
        (case (decode-type (field "carrier" doc), index-from-tree (field "term" doc)) of
          (Some carrier, Some term) -> case fresh-meta (value-kind carrier) (start 0) of
            (value, before) -> let after = unify sp value (UIndex carrier term) before in
              answer (index-runtime-admissible carrier term && clean after && core-definition-closed (seal-definition after (definition value)) && equal after value (UIndex carrier term))
          other -> (2, "invalid index tree"))
      else if same mode "admissible" then
        (case (decode-type (field "carrier" doc), index-from-tree (field "term" doc)) of
          (Some carrier, Some term) -> answer (index-runtime-admissible carrier term)
          other -> (2, "invalid index tree"))
      else if same mode "substitute" then
        (case (decode-pairs (field "pairs" doc), decode-type (field "type" doc), decode-type (field "result" doc)) of
          (Some pairs, Some ty, Some expected) -> let result = substitute-bound pairs ty in
            answer (valid-type result && valid-type expected && equal (start 0) result expected)
          other -> (2, "invalid substitution"))
      else (2, "unknown mode")
    other -> (2, "missing mode")
  run-input :: Bytes -> (Int, String)
  run-input input = case parse-json "typed-index-input" input of
    Parsed doc Nil -> request doc
    other -> (2, "invalid JSON")
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in case fs-read (path-from-string "case.txt") of
    Err error -> 90
    Ok input -> let (status, report) = run-input input in
      case fs-write (path-from-string "value-indices-report.txt") (string-to-bytes report) of
        Err error -> 91
        Ok _ -> status
