module Main where
  import Algebra.Semigroup
  import Bootstrap.Parse (parse-program, parse-program-with)
  import Bootstrap.Resolve (resolve-program, resolve-program-with)
  import Bootstrap.Contracts (interface-headers)
  import Bootstrap.Load (LoadedInterface, load-interface-set)
  import Bootstrap.Interface (iface-hash)
  import Bootstrap.Check (check-and-retain)
  import Bootstrap.Export (export-interfaces)
  import Bootstrap.Report (render-diagnostics)
  import Data.Json
  import Data.Path (path-from-string)
  import Effect.Fs (fs-write)
  import Text.Json (canonical-json, canonical-bytes)
  import Text.Parse (ParseOutcome, Parsed, Failed, render-bundle)

  source :: String
  source = "module A where\n  export Phantom, Exists, PackAny, Vec, VNil, VCons, positioned, row-polymorphic, closed-callback, Token, wrap, unwrap, (<+>), Parcel, Empty, Loaded, Give, give, wait, signal, ParcelWithPrivate, PublicParcel, make-parcel, inspect-scope, task-source, PublicPositive, bounded, widen, positive, PositiveParcel, PositivePacket, Refined, refine, HasWindow, capped, collide, Handle, handle-id, echo-secret, array-copy, array-size, global-source, fail-source, reentrant-source, thread-source\n  positioned :: using (0 <= x, x < y) => (x :: I64) -> (y :: I64) -> I64\n  positioned x y = x\n  row-polymorphic :: forall e. (Unit ->{|e} Unit) ->{|e} Unit\n  row-polymorphic f = f ()\n  closed-callback :: forall r. using (io :: Io r) => (Unit ->{IO r} Unit) ->{IO r} Unit\n  closed-callback f = f ()\n  foreign import ccall \"cinch.runtime.arrayReplicate\" array-copy :: forall a. Nat -> a -> Array a\n  foreign import ccall \"cinch.runtime.arrayLen\" array-size :: forall a. Array a -> Nat\n  global-source :: Unit ->{Global} Int\n  global-source unit = 42\n  fail-source :: Unit ->{Fail} Int\n  fail-source unit = 42\n  reentrant-source :: Unit ->{Reentrant} Int\n  reentrant-source unit = 42\n  thread-source :: Unit ->{ThreadAffine} Int\n  thread-source unit = 42\n  opaque type Handle a :: Type\n  opaque type PrivateHandle :: Type\n  handle-id :: forall a. Handle a -> Handle a\n  handle-id h = h\n  echo-secret :: PrivateHandle -> PrivateHandle\n  echo-secret x = x\n  capped :: (limit :: Nat) -> refined (out <= limit) Nat\n  capped limit = 0\n  collide :: (cinch-result :: Nat) -> refined (out == cinch-result) Nat\n  collide cinch-result = cinch-result\n  type PublicPositive = refine (x :: I64) with 0 < x\n  type Window (lo :: Int) (hi :: Int) a = refine (x :: a) with lo <= x && x <= hi\n  type Positive = refine (n :: Nat) with n > 0\n  data PositiveParcel where\n    PositivePacket :: Positive -> PositiveParcel\n  signature Refined a where\n    refine :: Positive -> a -> Positive\n  implicit instance RefinedNat :: Refined Nat where\n    refine n tag = n\n  signature HasWindow a where\n    window-id :: a -> a\n  implicit instance HasWindowBounded :: HasWindow (Window 0 10 Nat) where\n    window-id value = value\n  bounded :: Window 0 10 Nat\n  bounded = 1\n  widen :: Window 2 8 Nat -> Window 0 10 Nat\n  widen n = n\n  positive :: Positive\n  positive = 1\n  inspect-scope :: forall r s. Scope r s -> Int\n  inspect-scope token = 7\n  task-source :: forall s e a. Unit -> Task s e a\n  task-source unit = task-source unit\n  signature Give a where\n    give :: a -> a\n  implicit instance GiveNat :: Give Nat where\n    give n = n\n  data Values a where\n    Values :: a -> Values a\n  signature Deep a where\n    deep :: a -> a\n  signature Inner a where\n    inner :: forall b. using (deep :: Deep b) => (a -> b) -> a -> b\n  signature Evidence a where\n    evidence :: forall b. using (inner :: Inner b) => (a -> b) -> a -> b\n  signature ContextOnly a where\n    context-only :: a -> a\n  implicit instance ContextOnly_Values eq :: using (eq :: Evidence eq) => ContextOnly (Values eq) where\n    context-only values = values\n  effect Notice where\n    signal :: Nat ->{Notice} Nat\n  effect Local where\n    local-op :: Nat ->{Local} Nat\n  foreign import ccall \"cinch.runtime.textSha256\" private-digest :: Bytes -> Bytes\n  data PrivateField where\n    PrivateFieldValue :: Nat -> PrivateField\n  data ParcelWithPrivate where\n    PublicParcel :: PrivateField -> ParcelWithPrivate\n  make-parcel :: Nat -> ParcelWithPrivate\n  make-parcel n = PublicParcel (PrivateFieldValue n)\n  data Phantom {element :: Type} where {}\n  data Exists where\n    PackAny :: forall t. t -> Exists\n  data Vec (n :: Nat) a where\n    VNil :: Vec 0 a\n    VCons :: forall (k :: Nat). a -> Vec k a -> Vec (k + 1) a\n  data Token where\n    Hidden :: Nat -> Token\n  data Parcel a where\n    Empty :: Parcel a\n    Loaded :: a -> Parcel a\n  infixr 4 <^>\n  (<^>) :: Nat -> Nat -> Nat\n  (<^>) a b = a\n  wait :: Unit ->{Diverge, Blocking} Int\n  wait u = 0\n  wrap :: Nat -> Token\n  wrap n = Hidden n\n  unwrap :: Token -> Nat\n  unwrap token = case token of Hidden n -> n\n  infixl 6 <+>\n  (<+>) :: Bool -> Int -> Bool\n  (<+>) a b = a\nmodule B where\n  import A\n  import A ((<+>) as (<#>))\n  import A (PublicPositive as Positive, bounded as one, widen as wide, positive as pos, Handle as PublicHandle, handle-id as keep-handle)\n  import A (array-copy as repeat-array, array-size as count-array)\n  export keep-alpha, positioned, row-polymorphic, closed-callback, global-source, fail-source, reentrant-source, thread-source, repeat-array, count-array, Token, wrap, (<+>), (<#>), inspect-scope, task-source, Positive, one, wide, pos, Refined, refine, capped, collide, PublicHandle, keep-handle, echo-secret\n  signature Alpha a where\n    alpha-id :: a -> a\n  keep-alpha :: forall a. using (alpha :: Alpha a) => a -> a\n  keep-alpha value = value\nmodule Main where\n  import B\n  main :: Int\n  main = 0\n"
  documents :: List (String, Json) -> String
  documents rows = case rows of Nil -> ""; Cons (name, doc) rest -> string-concat-all [canonical-json doc, "\n", documents rest]
  artifacts :: List (String, Json) -> Result String (List (String, String, Bytes))
  artifacts rows = case rows of
    Nil -> Ok Nil
    Cons (name, doc) rest -> let bytes = canonical-bytes doc in case (iface-hash bytes doc, artifacts rest) of
      (Some hash, Ok more) -> Ok (Cons (name, hash, bytes) more)
      (None, other) -> Err "cannot compute actual emitted interface hash"
      (other, Err error) -> Err error
  check-client :: List LoadedInterface -> String -> Result String Unit
  check-client interfaces input = case parse-program-with "interface-client" (string-to-bytes input) (interface-headers interfaces) of
    Failed bundle -> Err (render-bundle bundle)
    Parsed program Nil -> case resolve-program-with program interfaces of
      (resolved, Nil) -> case check-and-retain resolved of Err errors -> Err (render-diagnostics errors); Ok checked -> Ok ()
      (resolved, errors) -> Err (render-diagnostics errors)
    other -> Err "recovering parse in interface client"
  validate-clients :: List (String, Json) -> Result String Unit
  validate-clients rows = case artifacts rows of
    Err error -> Err error
    Ok bytes -> case load-interface-set bytes of
      Err error -> Err error
      Ok interfaces -> case check-client interfaces "module Consumer where\n  import B\n  use :: Nat -> Token\n  use n = wrap n\n" of
        Err error -> Err error
        Ok done -> case check-client interfaces "module Intruder where\n  import B (Hidden)\n  use :: Int\n  use = 0\n" of
          Ok done -> Err "private constructor became importable"
          Err hidden -> case check-client interfaces "module Override where\n  import A\n  infixr 8 <+>\n  use :: Nat\n  use = 1 <+> 2\n" of
            Ok done -> Err "importing module overrode the defining fixity"
            Err override -> case check-client interfaces "module InstanceConsumer where\n  import A\n  use :: Nat -> Nat\n  use n = give n\n" of
              Err error -> Err error
              Ok done -> case check-client interfaces "module LayoutConsumer where\n  import A\n  use :: Nat -> ParcelWithPrivate\n  use n = make-parcel n\n" of
                Err error -> Err error
                Ok done -> case check-client interfaces "module PrivateFieldIntruder where\n  import A (PrivateFieldValue)\n  use :: Int\n  use = 0\n" of
                  Ok done -> Err "private field constructor became importable"
                  Err hidden -> validate-array-clients interfaces rows
  validate-array-clients :: List LoadedInterface -> List (String, Json) -> Result String Unit
  validate-array-clients interfaces rows =
    case check-client interfaces "module ArrayConsumer where\n  import B (repeat-array, count-array)\n  size :: Nat\n  size = count-array (repeat-array 42 True)\n  keep :: forall a. a -> Array a\n  keep value = repeat-array 2 value\n" of
      Err error -> Err error
      Ok done -> case check-client interfaces "module ArrayWrongCarrier where\n  import B (repeat-array)\n  bad :: Array Nat\n  bad = repeat-array 2 True\n" of
        Ok done -> Err "an imported array intrinsic lost its element type"
        Err refused -> validate-kernel-effect-clients interfaces rows
  validate-kernel-effect-clients :: List LoadedInterface -> List (String, Json) -> Result String Unit
  validate-kernel-effect-clients interfaces rows =
    case check-client interfaces "module KernelEffectConsumer where\n  import B\n  use-global :: Unit ->{Global} Int\n  use-global unit = global-source unit\n  use-fail :: Unit ->{Fail} Int\n  use-fail unit = fail-source unit\n  use-reentrant :: Unit ->{Reentrant} Int\n  use-reentrant unit = reentrant-source unit\n  use-thread :: Unit ->{ThreadAffine} Int\n  use-thread unit = thread-source unit\n" of
      Err error -> Err error
      Ok done -> case check-client interfaces "module ErasedKernelEffect where\n  import B\n  bad :: Unit -> Int\n  bad unit = global-source unit\n" of
        Ok done -> Err "imported Global effect disappeared from its defining contract"
        Err refused -> validate-fixity-clients interfaces rows
  validate-fixity-clients :: List LoadedInterface -> List (String, Json) -> Result String Unit
  validate-fixity-clients interfaces rows =
    case check-client interfaces "module ScopeConsumer where\n  import B\n  inspect :: forall r s. Scope r s -> Int\n  inspect token = inspect-scope token\n  alias :: forall s e a. Unit -> Task s e a\n  alias = task-source\n" of
      Err error -> Err error
      Ok done -> validate-refinement-clients interfaces rows
  validate-refinement-clients :: List LoadedInterface -> List (String, Json) -> Result String Unit
  validate-refinement-clients interfaces rows =
    case check-client interfaces "module RefinementConsumer where\n  import B\n  keep-opaque :: PublicHandle Nat -> PublicHandle Nat\n  keep-opaque h = keep-handle h\n  read :: Positive -> I64\n  read x = x\n  positive :: refined (out > 0) Nat\n  positive = pos\n  bounded :: refined (out <= 10) Nat\n  bounded = wide 3\n  use-cap :: refined (out <= 4) Nat\n  use-cap = capped 4\n  use-collision :: (n :: Nat) -> refined (out == n) Nat\n  use-collision n = collide n\n  via-method :: Nat\n  via-method = refine 1 (2 :: Nat)\n" of
      Err error -> Err error
      Ok done -> case check-client interfaces "module RefinementIntruder where\n  import B (Window)\n  main :: Int\n  main = 0\n" of
        Ok done -> Err "private refinement gained a public source name"
        Err hidden -> case check-client interfaces "module FalsePromise where\n  import B\n  bad :: refined (out > 1) Nat\n  bad = pos\n" of
          Ok done -> Err "private refinement contract supplied an unproved stronger fact"
          Err refused -> case check-client interfaces "module FalseMethodPromise where\n  import B\n  bad :: Nat\n  bad = refine 0 (2 :: Nat)\n" of
            Ok done -> Err "class method lost its private refinement precondition"
            Err method-refused -> validate-refinement-reexport interfaces rows
  validate-refinement-reexport :: List LoadedInterface -> List (String, Json) -> Result String Unit
  validate-refinement-reexport interfaces rows =
    let input = "module RefinementFacade where\n  import B (Positive as AboveZero, pos as positive, wide as widen)\n  export AboveZero, positive, widen\n" in
    let bytes = string-to-bytes input in
    case parse-program-with "separate-refinement-facade" bytes (interface-headers interfaces) of
      Parsed program Nil -> case resolve-program-with program interfaces of
        (resolved, Nil) -> case check-and-retain resolved of
          Err errors -> Err (render-diagnostics errors)
          Ok checked -> case export-interfaces checked interfaces bytes of
            Err error -> Err error
            Ok facade -> case artifacts (facade <> rows) of
              Err error -> Err error
              Ok bytes -> case load-interface-set bytes of
                Err error -> Err error
                Ok loaded -> case check-client loaded "module SeparateRefinementConsumer where\n  import RefinementFacade (AboveZero, positive as pos, widen)\n  read :: AboveZero -> I64\n  read x = x\n  positive :: refined (out > 0) Nat\n  positive = pos\n  bounded :: refined (out <= 10) Nat\n  bounded = widen 3\n" of
                  Err error -> Err error
                  Ok done -> validate-inherited-fixity-clients interfaces rows
        (resolved, errors) -> Err (render-diagnostics errors)
      other -> Err "cannot parse separate defining refinement facade"
  validate-inherited-fixity-clients :: List LoadedInterface -> List (String, Json) -> Result String Unit
  validate-inherited-fixity-clients interfaces rows =
    case check-client interfaces "module Inherited where\n  import B\n  use :: Bool\n  use = True <+> 1 + 2\nmodule Renamed where\n  import B\n  use :: Bool\n  use = True <#> 1 + 2\n" of
      Err error -> Err error
      Ok done -> case check-client interfaces "module Identical where\n  import B\n  infixl 6 <#>\n  use :: Int\n  use = 0\n" of
        Ok done -> Err "an importer redeclared an identical inherited fixity"
        Err identical -> case check-client interfaces "module Changed where\n  import B\n  infixr 8 <#>\n  use :: Int\n  use = 0\n" of
          Ok done -> Err "an importer changed a renamed operator's defining fixity"
          Err changed -> validate-separate-facade interfaces rows
  validate-separate-facade :: List LoadedInterface -> List (String, Json) -> Result String Unit
  validate-separate-facade interfaces rows =
    let input = "module Facade where\n  import B ((<#>) as (<!>), repeat-array as copies, count-array as length, global-source as external-call)\n  export (<!>), copies, length, external-call\n" in
    let bytes = string-to-bytes input in
    case parse-program-with "separate-facade" bytes (interface-headers interfaces) of
      Parsed program Nil -> case resolve-program-with program interfaces of
        (resolved, Nil) -> case check-and-retain resolved of
          Err errors -> Err (render-diagnostics errors)
          Ok checked -> case export-interfaces checked interfaces bytes of
            Err error -> Err error
            Ok facade -> case artifacts (facade <> rows) of
              Err error -> Err error
              Ok bytes -> case load-interface-set bytes of
                Err error -> Err error
                Ok imported -> check-client imported "module SeparateConsumer where\n  import Facade\n  use :: Bool\n  use = True <!> 1 + 2\n  size :: Nat\n  size = length (copies 42 True)\n  external :: Unit ->{Global} Int\n  external unit = external-call unit\n"
        (resolved, errors) -> Err (render-diagnostics errors)
      Failed bundle -> Err (render-bundle bundle)
      other -> Err "recovering parse in separate facade"
  checked-export :: String -> Result String String
  checked-export input = case parse-program "export-fixture" (string-to-bytes input) of
    Failed bundle -> Err (render-bundle bundle)
    Parsed program Nil -> case resolve-program program of
      (resolved, Nil) -> case check-and-retain resolved of
        Err errors -> Err (render-diagnostics errors)
        Ok checked -> case export-interfaces checked Nil (string-to-bytes input) of
          Err error -> Err error
          Ok rows -> case validate-clients rows of Err error -> Err error; Ok done -> Ok (documents rows)
      (resolved, errors) -> Err (render-diagnostics errors)
    other -> Err "recovering parse in interface fixture"
  main :: Unit ->{IO r} Int
  main u = with (io = newIO ()) in case fs-write (path-from-string "export-fixture.cinch") (string-to-bytes source) of
    Err failed -> 2
    Ok written -> case checked-export source of
      Err error -> case fs-write (path-from-string "export-error.txt") (string-to-bytes error) of Ok done -> 1; Err failed -> 2
      Ok doc -> case fs-write (path-from-string "exported-interfaces.jsonl") (string-to-bytes doc) of Ok done -> 0; Err failed -> 2
