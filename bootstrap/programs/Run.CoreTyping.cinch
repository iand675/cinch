module Main where
  import Bootstrap.Type
  import Algebra.Semigroup
  import Bootstrap.Index
  import Bootstrap.Core
  import Bootstrap.Global
  import Bootstrap.Kinds
  import Bootstrap.Typing
  import Bootstrap.Nominal (interface-global)
  import Bootstrap.Dictionary (resolve-dictionary-term-with)
  import Text.Lex (Span)
  import Data.Path (path-from-string)
  import Effect.Fs (fs-read)

  sp :: Span
  sp = Span 0 0 1 1
  int :: UType
  int = UCon "Int" KType
  nat :: UType
  nat = UCon "Nat" KType
  bool :: UType
  bool = UCon "Bool" KType
  unit :: UType
  unit = UCon "Unit" KType
  string :: UType
  string = UCon "String" KType
  log-row :: UType
  log-row = URow (UArg (UCon "Log" KEffect) UEnd)
  zero-row :: UType
  zero-row = URow UEnd
  truth :: CoreTerm
  truth = CUse sp bool "True" "constructor" Nil
  integer :: CoreTerm
  integer = CInt sp int "1"
  arguments :: CoreTerm -> CoreTerm -> CoreTerm
  arguments a b = CArgument sp a (CArgument sp b (CArgumentsEnd sp))
  answer :: CoreTerm -> CoreDefinition
  answer body = MkCoreDefinition sp "answer" (mono int) Nil Nil Nil [MkCoreClause sp Nil body]
  kinds :: List (String, Kind)
  kinds = [("Int", KType), ("Nat", KType), ("I64", KType), ("Bool", KType), ("Unit", KType), ("String", KType), ("Char", KType), ("Bytes", KType), ("Log", KEffect), ("Box", KType), ("At", KFun (value-kind nat) KType)]
  checks :: Nat -> List Bool
  checks nonce =
    let q = MkQuant nonce "a" KType False in let a = UBound nonce "a" KType in
    let indexed = MkScheme [MkQuant (nonce + 1) "n" (value-kind nat) False] (UApp (UCon "At" (KFun (value-kind nat) KType)) (UIndex nat (IBound (nonce + 1) "n"))) in
    let declarations =
          [ GlobalValue "answer" "value" (mono int)
          , GlobalValue "True" "constructor" (mono bool)
          , GlobalValue "id-int" "external" (mono (UFun int int))
          , GlobalValue "id-bool" "external" (mono (UFun bool bool))
          , GlobalValue "generic" "external" (MkScheme [q] (UFun a a))
          , GlobalValue "mark" "constructor" indexed
          , GlobalValue "effect" "external" (mono (UFunEff unit log-row int))
          , GlobalValue "lambda" "value" (mono (UFun int int))
          , GlobalValue "function" "value" (mono (UFun int int))
          , GlobalValue "effect-function" "value" (mono (UFunEff unit log-row int))
          ] in
    case (close-typing-context kinds declarations, close-globals declarations) of
      (Some context, Some references) ->
        let check body = typing-definition-closed context (answer body) in
        let id-int = CUse sp (UFun int int) "id-int" "external" Nil in
        let id-bool = CUse sp (UFun bool bool) "id-bool" "external" Nil in
        let operation = CUse sp (UFunEff unit log-row int) "effect" "external" Nil in
        let x = nonce + 10 in let fresh = URigid (nonce + 20) "hidden" 1 KType in
        let generic = CUse sp (UFun fresh fresh) "generic" "external" [fresh] in
        let local = CPVar sp int x "x" in
        let function body = MkCoreDefinition sp "function" (mono (UFun int int)) Nil Nil Nil [MkCoreClause sp [local] body] in
        let wrong-index = UIndex nat (IRigid x "x" 0) in
        let marked = UApp (UCon "At" (KFun (value-kind nat) KType)) wrong-index in
        let bad-primitive = CPrimitive sp int "+" (arguments truth truth) in
        let wrong-argument = CApply sp int id-int truth in
        [ check integer
        , check (CApply sp int id-int integer)
        , check (CIf sp int truth integer (CInt sp int "2"))
        , check (CPrimitive sp int "+" (arguments integer integer))
        , check (CPrimitive sp int "negate" (CArgument sp integer (CArgumentsEnd sp)))
        , global-definition-closed references (answer bad-primitive)
        , not (check bad-primitive)
        , global-definition-closed references (answer wrong-argument)
        , not (check wrong-argument)
        , not (check (CApply sp int id-bool truth))
        , not (check (CApply sp int integer integer))
        , not (check (CIf sp int integer integer integer))
        , not (check (CIf sp int truth integer (CString sp string "wrong branch")))
        , not (check (CString sp int "not an integer"))
        , not (check (CChar sp int "x"))
        , not (check (CUnit sp int))
        , not (check (CTuple sp int (CArgument sp integer (CArgumentsEnd sp))))
        , not (check (CPrimitive sp int "invented" (arguments integer integer)))
        , not (check (CPrimitive sp int "+" (CArgument sp integer (CArgumentsEnd sp))))
        , not (check (CPrimitive sp int "negate" (arguments integer integer)))
        , not (check (CApply sp int operation (CUnit sp unit)))
        , not (check (CApplyEff sp int zero-row operation (CUnit sp unit)))
        , typing-definition-closed context (MkCoreDefinition sp "effect-function" (mono (UFunEff unit log-row int)) Nil Nil Nil [MkCoreClause sp [CPVar sp unit x "u"] (CApplyEff sp int log-row operation (CLocal sp unit x "u" Nil))])
        , not (check (CApplyEff sp int log-row operation (CUnit sp unit)))
        , typing-definition-closed context (MkCoreDefinition sp "lambda" (mono (UFun int int)) Nil Nil Nil [MkCoreClause sp Nil (CLambda sp (UFun int int) local (CLocal sp int x "x" Nil))])
        , not (typing-definition-closed context (MkCoreDefinition sp "lambda" (mono (UFun int int)) Nil Nil Nil [MkCoreClause sp Nil (CLambda sp (UFun int int) (CPVar sp bool x "x") integer)]))
        , not (typing-definition-closed context (MkCoreDefinition sp "lambda" (mono (UFun int int)) Nil Nil Nil [MkCoreClause sp Nil (CLambda sp (UFun int int) local truth)]))
        , not (check (CCase sp int integer (CAlternative sp (CPConstructor sp int "True" Nil bool (CPDone sp)) integer (CAlternativesEnd sp))))
        , not (typing-definition-closed context (function (CLet sp int (x + 1) "wrong-index" (mono marked) (CUse sp marked "mark" "constructor" [wrong-index]) integer)))
        , not (check (CLet sp int x "hidden" (mono (UFun fresh fresh)) generic integer))
        , typing-definition-closed context (MkCoreDefinition sp "answer" (mono int) Nil Nil [(nonce + 20, KType)] [MkCoreClause sp Nil (CLet sp int x "hidden" (mono (UFun fresh fresh)) generic integer)])
        , not (typing-definition-closed context (MkCoreDefinition sp "answer" (mono int) Nil Nil [(nonce + 20, KType), (nonce + 20, KType)] [MkCoreClause sp Nil integer]))
        , not (type-well-formed kinds empty-type-scope (UCon "missing" KType))
        , not (type-well-formed kinds empty-type-scope (UCon "Box" (KFun KType KType)))
        , not (type-well-formed kinds empty-type-scope fresh)
        , not (scheme-well-formed kinds empty-type-scope (MkScheme [q] (UFun a (UBound (nonce + 1) "unbound" KType))))
        , not (argument-well-formed kinds empty-type-scope UEnd)
        , (case close-typing-context kinds [GlobalValue "bad" "external" (mono (UCon "missing" KType))] of None -> True; Some other -> False)
        , (case close-typing-context kinds [GlobalValue "bad" "constructor" (mono (UFunEff unit log-row int))] of None -> True; Some other -> False)
        ]
      other -> [False]
  scope-checks :: Nat -> List Bool
  scope-checks nonce =
    let q = MkQuant nonce "r" KRegion False in
    let owner = URigid (nonce + 1) "r" 1 KRegion in
    let region = URigid (nonce + 2) "s" 2 KRegion in
    let inner = URigid (nonce + 3) "nested" 3 KRegion in
    let token = scope-type owner region in
    let io ty = UApp (UCon "b.Io" (KFun KRegion KType)) ty in
    let diverge = URow (UArg (UCon "Diverge" KEffect) UEnd) in
    let bound-io = io (UBound nonce "r" KRegion) in
    let actual-io = io owner in
    let evidence = CEGiven sp actual-io "scope-io" in
    let callback = CLambda sp (UFun token int) (CPVar sp token (nonce + 10) "scope") integer in
    let good = CScope sp int region evidence callback in
    let task-kinds = Cons ("b.Io", KFun KRegion KType) (Cons ("b.Scope", scope-kind) kinds) in
    let sc row = qualified [q] [MkRequirement "io" bound-io] (UFunEff unit row int) in
    let check row body = (let declared = sc row in
      (case close-typing-context task-kinds [GlobalValue "scope-work" "value" declared, GlobalValue "effect" "external" (mono (UFunEff unit log-row int))] of
        None -> False
        Some context -> typing-definition-closed context (MkCoreDefinition sp "scope-work" declared [(nonce, owner)] [CGiven sp "scope-io" actual-io] Nil [MkCoreClause sp [CPWild sp unit] body]))) in
    let resolution supplied = (case resolve-dictionary-term-with [("b.Io", KFun KRegion KType)] Nil [CGiven sp "scope-io" actual-io] (CScope sp int region supplied callback) (empty-store "scope evidence") of
      (found, checked) -> (case store-errors checked of Nil -> check diverge found; other -> False)) in
    let effectful = CLambda sp (UFunEff token log-row int) (CPWild sp token) (CApplyEff sp int log-row (CUse sp (UFunEff unit log-row int) "effect" "external" Nil) (CUnit sp unit)) in
    let nested-token = scope-type owner inner in
    let nested = CScope sp int inner evidence (CLambda sp (UFun nested-token int) (CPWild sp nested-token) integer) in
    let repeated = CScope sp int region evidence (CLambda sp (UFun token int) (CPWild sp token) integer) in
    let escaped = CLet sp int (nonce + 11) "outside" (mono (UFun token int)) callback integer in
    [ check diverge good
    , resolution (CENeeded sp actual-io [CGiven sp "scope-io" actual-io])
    , not (resolution (CENeeded sp actual-io Nil))
    , not (resolution (CEGiven sp actual-io "missing"))
    , not (resolution (CENeeded sp (io region) [CGiven sp "scope-io" actual-io]))
    , check diverge (map-term-types (\ty -> ty) good)
    , not (check zero-row good)
    , not (check diverge (CScope sp int owner evidence (CLambda sp (UFun (scope-type owner owner) int) (CPWild sp (scope-type owner owner)) integer)))
    , not (check diverge (CScope sp int (UCon "pretend" KRegion) evidence callback))
    , not (check diverge (CScope sp int region (CEGiven sp actual-io "missing") callback))
    , not (check diverge (CScope sp int region (CEGiven sp (io region) "scope-io") callback))
    , not (check diverge (CScope sp int region evidence (CLambda sp (UFun (scope-type region region) int) (CPWild sp (scope-type region region)) integer)))
    , not (check diverge (CScope sp int region evidence (CLambda sp (UFun unit int) (CPWild sp unit) integer)))
    , not (check diverge (CScope sp int region evidence (CLambda sp (UFun (scope-type owner inner) int) (CPWild sp (scope-type owner inner)) integer)))
    , not (check diverge escaped)
    , check (union-effects diverge log-row) (CScope sp int region evidence effectful)
    , not (check diverge (CScope sp int region evidence effectful))
    , check diverge (CScope sp int region evidence (CLambda sp (UFunEff token diverge int) (CPWild sp token) nested))
    , not (check diverge (CScope sp int region evidence (CLambda sp (UFunEff token diverge int) (CPWild sp token) repeated)))
    , scope-region-closed region int
    , not (scope-region-closed region token)
    , not (scope-region-closed region (UFun unit (UTuple (UArg token UEnd))))
    , not (scope-region-closed region (URow (UArg (UApp (UCon "ScopedEffect" (KFun KRegion KEffect)) region) UEnd)))
    ]
  task-checks :: Nat -> List Bool
  task-checks nonce =
    let q = MkQuant nonce "r" KRegion False in
    let owner = URigid (nonce + 1) "r" 1 KRegion in
    let region = URigid (nonce + 2) "s" 2 KRegion in
    let other-region = URigid (nonce + 3) "other" 3 KRegion in
    let token = scope-type owner region in
    let result = task-result-type int int in
    let handle-ty = task-type region int int in
    let io ty = UApp (UCon "b.Io" (KFun KRegion KType)) ty in
    let row = URow (UArg (UApp (UCon "Async" (KFun KRegion KEffect)) owner) (UArg (UApp (UCon "Cancel" (KFun KRegion KEffect)) owner) (UArg (UCon "Diverge" KEffect) UEnd))) in
    let bound-owner = UBound nonce "r" KRegion in
    let bound-row = URow (UArg (UApp (UCon "Async" (KFun KRegion KEffect)) bound-owner) (UArg (UApp (UCon "Cancel" (KFun KRegion KEffect)) bound-owner) (UArg (UCon "Diverge" KEffect) UEnd))) in
    let declared = qualified [q] [MkRequirement "io" (io (UBound nonce "r" KRegion))] (UFunEff unit bound-row result) in
    let worker-ty = UFun unit result in
    let declarations = [GlobalValue "task-work" "value" declared, GlobalValue "task-body" "external" (mono worker-ty), GlobalValue "True" "constructor" (mono bool)] in
    let task-kinds = [("b.Io", KFun KRegion KType), ("b.Scope", scope-kind), ("b.Task", task-kind), (interface-global "Data.Core.Result", KFun KType (KFun KType KType))] <> kinds in
    let scope-id = nonce + 10 in let handle-id = nonce + 11 in
    let scope-value = CLocal sp token scope-id "s" Nil in
    let handle-value = CLocal sp handle-ty handle-id "h" Nil in
    let worker = CUse sp worker-ty "task-body" "external" Nil in
    let spawn = CSpawn sp handle-ty scope-value worker in
    let handles = CArgument sp handle-value (CArgumentsEnd sp) in
    let join = CJoin sp result scope-value handles in
    let bind next = CLet sp result handle-id "h" (mono handle-ty) spawn next in
    let wrap body = CScope sp result region (CEGiven sp (io owner) "io") (CLambda sp (UFunEff token row result) (CPVar sp token scope-id "s") body) in
    let check body = (case close-typing-context task-kinds declarations of
      None -> False
      Some context -> typing-definition-closed context (MkCoreDefinition sp "task-work" declared [(nonce, owner)] [CGiven sp "io" (io owner)] Nil [MkCoreClause sp [CPWild sp unit] body])) in
    [ check (wrap (bind join))
    , check (map-term-types (\ty -> ty) (wrap (bind join)))
    , check (wrap (bind (CIf sp result truth join join)))
    , not (check (wrap (bind (CJoin sp result scope-value (CArgument sp handle-value handles)))))
    , not (check (wrap (bind (CLet sp result (nonce + 12) "first-result" (mono result) join join))))
    , not (check (wrap (bind (CIf sp result truth join (CApply sp result worker (CUnit sp unit))))))
    , not (check (wrap (bind (CApply sp result worker (CUnit sp unit)))))
    , not (check (wrap (CLet sp result handle-id "h" (mono handle-ty) (CSpawn sp handle-ty scope-value (CLambda sp (UFun unit int) (CPWild sp unit) integer)) join)))
    , not (check (wrap (bind (CJoin sp int scope-value handles))))
    , not (check (wrap (bind (CJoin sp result scope-value (CArgumentsEnd sp)))))
    , not (check (wrap (bind (CJoin sp result (CUnit sp unit) handles))))
    , not (check (wrap (bind (CJoin sp result scope-value (CArgument sp integer (CArgumentsEnd sp))))))
    , not (check (wrap (CLet sp result handle-id "h" (mono (task-type other-region int int)) (CSpawn sp (task-type other-region int int) scope-value worker) join)))
    , not (check (wrap (CLet sp result handle-id "h" (mono handle-ty) (CSpawn sp (task-type region bool int) scope-value worker) join)))
    ]
  intrinsic-view-checks :: Nat -> List Bool
  intrinsic-view-checks nonce =
    let bytes = UCon "Bytes" KType in
    let id = nonce + 90 in
    let result = URefine id "n" nat (UCompare ">=" (UBound id "n" (value-kind nat)) (UIndex nat (IInteger 0))) in
    let raw = mono (UFun bytes nat) in
    let refined = mono (UFun bytes result) in
    let symbol = "cinch.runtime.bytesLen" in
    let declarations = add-global (GlobalValue symbol "intrinsic" raw) (add-global (GlobalValue symbol "intrinsic" refined) [GlobalValue "read" "value" (mono (UFun bytes nat)), GlobalValue "refined-read" "value" (mono (UFun bytes result))]) in
    let payload = CPVar sp bytes (nonce + 91) "bytes" in
    let argument = CLocal sp bytes (nonce + 91) "bytes" Nil in
    let define name output function = MkCoreDefinition sp name (mono (UFun bytes output)) Nil Nil Nil [MkCoreClause sp [payload] (CApply sp output function argument)] in
    let raw-use = CUse sp (UFun bytes nat) symbol "intrinsic" Nil in
    let refined-use = CUse sp (UFun bytes result) symbol "intrinsic" Nil in
    [ (case close-typing-context kinds declarations of
        Some context -> typing-definition-closed context (define "read" nat raw-use) && typing-definition-closed context (define "refined-read" result refined-use)
        None -> False)
    , (case close-globals declarations of Some references -> not (global-definition-closed references (define "read" nat (CUse sp (UFun bytes bool) symbol "intrinsic" Nil))); None -> False)
    , (case close-globals (add-global (GlobalValue "same" "value" raw) [GlobalValue "same" "value" refined]) of None -> True; Some context -> False)
    , (case close-globals (add-global (GlobalValue symbol "value" raw) [GlobalValue symbol "intrinsic" refined]) of None -> True; Some context -> False)
    , (case close-globals [GlobalIntrinsicViews symbol Nil] of None -> True; Some context -> False)
    , (case close-globals [GlobalIntrinsicViews symbol [raw, mono (UFun bytes bool)]] of None -> True; Some context -> False)
    ]
  verdict :: Int -> List Bool -> Int
  verdict next values = case values of Nil -> 0; Cons True rest -> verdict (next + 1) rest; Cons False rest -> next
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in case fs-read (path-from-string "nonce.txt") of
    Err error -> 90
    Ok input -> let nonce = 340282366920938463463374607431768211456 + bytes-len input in
      case verdict 1 (scope-checks nonce) of
        0 -> case verdict 1 (task-checks nonce) of
          0 -> case verdict 1 (intrinsic-view-checks nonce) of 0 -> verdict 1 (checks nonce); code -> 180 + code
          code -> 150 + code
        code -> 100 + code
