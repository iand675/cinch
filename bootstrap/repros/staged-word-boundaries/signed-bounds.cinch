-- | Observe exact staged machine scalar boundaries.
module Main where
  import Data.Machine
  import Data.Char

  generate do
    emit (quoteDecls where
      -- | Return zero only when the staged boundary calculation agrees.
      answer :: Int
      answer = $(quoteInt (if eq-i64 max-bound-i64 9223372036854775807 && eq-i64 min-bound-i64 (-9223372036854775808) then 0 else 1)))

  -- | Observe the generated boundary result.
  main :: Int
  main = answer
