-- | Observe exact staged machine scalar boundaries.
module Main where
  import Data.Machine
  import Data.Char

  generate do
    emit (quoteDecls where
      -- | Return zero only when the staged boundary calculation agrees.
      answer :: Int
      answer = $(quoteInt (if eq-u64 (saturating-mul-u64 18446744073709551615 18446744073709551615) 18446744073709551615 then 0 else 1)))

  -- | Observe the generated boundary result.
  main :: Int
  main = answer
