-- Recheck annotated types against actual nominal and lexical kind contexts.
-- A printed name or a cached Kind annotation never introduces a declaration.
module Bootstrap.Kinds where
  import Bootstrap.Type
  import Bootstrap.Index
  import Text.Lex (Span)

  export TypeScope, MkTypeScope, empty-type-scope, scope-bound, scope-rigid, scope-locals, add-local-scheme, add-value-parameter
  export type-well-formed, kind-well-formed, scheme-well-formed, scheme-type-scope
  export nominal-kinds-closed, add-rigid-kind
  export proper-type, argument-well-formed
  export borrow-scope-conflict, open-memo-region, in-memo-region

  data TypeScope where
    MkTypeScope :: List (Nat, Kind) -> List (Nat, Kind) -> List (Nat, Scheme) -> List Nat -> TypeScope
  empty-type-scope :: TypeScope
  empty-type-scope = MkTypeScope Nil Nil Nil Nil
  -- A polytype's binders are in scope, as bound variables, over its body.
  bind-quant-scope :: List Quant -> TypeScope -> TypeScope
  bind-quant-scope qs scope = case qs of
    Nil -> scope
    Cons q rest -> case bind-quant-scope rest scope of
      MkTypeScope bound rigid locals memos -> MkTypeScope (Cons (quant-id q, quant-kind q) bound) rigid locals memos
  scope-bound :: TypeScope -> List (Nat, Kind)
  scope-bound scope = case scope of MkTypeScope bound rigid locals memos -> bound
  scope-rigid :: TypeScope -> List (Nat, Kind)
  scope-rigid scope = case scope of MkTypeScope bound rigid locals memos -> rigid
  scope-locals :: TypeScope -> List (Nat, Scheme)
  scope-locals scope = case scope of MkTypeScope bound rigid locals memos -> locals
  scope-memos :: TypeScope -> List Nat
  scope-memos scope = case scope of MkTypeScope bound rigid locals memos -> memos
  open-memo-region :: Nat -> TypeScope -> Option TypeScope
  open-memo-region id scope = case add-rigid-kind id KRegion scope of
    Some (MkTypeScope bound rigid locals memos) -> Some (MkTypeScope bound rigid locals (Cons id memos))
    None -> None
  in-memo-region :: UType -> TypeScope -> Bool
  in-memo-region region scope = case region of
    URigid id name level KRegion -> has-memo-id id (scope-memos scope)
    other -> False
  has-memo-id :: Nat -> List Nat -> Bool
  has-memo-id id memos = case memos of
    Nil -> False
    Cons first rest -> first == id || has-memo-id id rest
  same :: String -> String -> Bool
  same a b = string-compare a b == 0
  lookup-id :: Nat -> List (Nat, Kind) -> Option Kind
  lookup-id id entries = case entries of Nil -> None; Cons (key, kind) rest -> if id == key then Some kind else lookup-id id rest
  lookup-kind :: String -> List (String, Kind) -> Option Kind
  lookup-kind name entries = case entries of Nil -> None; Cons (key, kind) rest -> if same name key then Some kind else lookup-kind name rest
  equal-type :: UType -> UType -> Bool
  equal-type a b = valid-type a && valid-type b && (case store-errors (unify (Span 0 0 1 1) (without-index-levels a) (without-index-levels b) (empty-store "kind scope")) of Nil -> True; other -> False)
  add-rigid-kind :: Nat -> Kind -> TypeScope -> Option TypeScope
  add-rigid-kind id kind scope = case lookup-id id (scope-rigid scope) of
    Some prior -> None
    None -> (case lookup-local id (scope-locals scope) of Some prior -> None; None -> Some (MkTypeScope (scope-bound scope) (Cons (id, kind) (scope-rigid scope)) (scope-locals scope) (scope-memos scope)))
  add-bound-kind :: Nat -> Kind -> TypeScope -> Option TypeScope
  add-bound-kind id kind scope = case lookup-id id (scope-bound scope) of
    Some prior -> None
    None -> Some (MkTypeScope (Cons (id, kind) (scope-bound scope)) (scope-rigid scope) (scope-locals scope) (scope-memos scope))
  lookup-local :: Nat -> List (Nat, Scheme) -> Option Scheme
  lookup-local id locals = case locals of Nil -> None; Cons (key, sc) rest -> if id == key then Some sc else lookup-local id rest
  add-local-scheme :: Nat -> Scheme -> TypeScope -> Option TypeScope
  add-local-scheme id sc scope = case (lookup-id id (scope-rigid scope), lookup-local id (scope-locals scope)) of
    (None, None) -> if borrow-scope-conflict scope (scheme-body sc) then None
      else Some (MkTypeScope (scope-bound scope) (scope-rigid scope) (Cons (id, sc) (scope-locals scope)) (scope-memos scope))
    other -> None
  borrow-scope-conflict :: TypeScope -> UType -> Bool
  borrow-scope-conflict scope ty = case borrow-regions ty of
    Nil -> False
    loans -> borrow-local-conflict loans (scope-locals scope)
  borrow-local-conflict :: List (Bool, UType) -> List (Nat, Scheme) -> Bool
  borrow-local-conflict loans locals = case locals of
    Nil -> False
    Cons (id, scheme) rest ->
      borrow-region-conflict loans (borrow-regions (scheme-body scheme)) || borrow-local-conflict loans rest
  -- A forall value has both its actual rigid index kind and a term binding
  -- at that kind's carrier. Ordinary locals still cannot shadow rigid ids.
  add-value-parameter :: Nat -> UType -> TypeScope -> Option TypeScope
  add-value-parameter id carrier scope = case (lookup-id id (scope-rigid scope), lookup-local id (scope-locals scope)) of
    (Some kind, None) -> if kind-equal kind (value-kind carrier) then Some (MkTypeScope (scope-bound scope) (scope-rigid scope) (Cons (id, mono carrier) (scope-locals scope)) (scope-memos scope)) else None
    other -> None
  highest :: Nat -> Nat -> Nat
  highest a b = if a > b then a else b
  kind-level :: Kind -> Nat
  kind-level kind = case kind of KFun a b -> highest (kind-level a) (kind-level b); KValue payload -> (case value-carrier kind of Some ty -> type-level ty; None -> 0); other -> 0
  index-level :: IndexTerm -> Nat
  index-level value = case value of
    IRigid id name level -> level
    IApply f x -> highest (index-level f) (index-level x)
    ILambda id name body -> index-level body
    IAdd a b -> highest (index-level a) (index-level b)
    ISubtract a b -> highest (index-level a) (index-level b)
    IMultiply a b -> highest (index-level a) (index-level b)
    other -> 0
  type-level :: UType -> Nat
  type-level ty = case ty of
    URigid id name level kind -> highest level (kind-level kind)
    UBound id name kind -> kind-level kind
    UCon name kind -> kind-level kind
    UMeta id kind -> kind-level kind
    UIndex carrier value -> highest (type-level carrier) (index-level value)
    URefine id name carrier predicate -> highest (type-level carrier) (type-level predicate)
    URefineFormer name ids body -> type-level body
    UPi id name a row b -> highest (type-level row) (highest (type-level a) (type-level b))
    UFunEff a row b -> highest (type-level row) (highest (type-level a) (type-level b))
    UProofFun a row b -> highest (type-level row) (highest (type-level a) (type-level b))
    UApp a b -> highest (type-level a) (type-level b)
    UFun a b -> highest (type-level a) (type-level b)
    URow labels -> type-level labels
    URowJoin a b -> highest (type-level a) (type-level b)
    UTuple fields -> type-level fields
    UForall qs body -> type-level body
    UArg a b -> highest (type-level a) (type-level b)
    UCompare op a b -> highest (type-level a) (type-level b)
    UPropAnd a b -> highest (type-level a) (type-level b)
    UPropOr a b -> highest (type-level a) (type-level b)
    URequire a b -> highest (type-level a) (type-level b)
    UPropNot body -> type-level body
    UPropNonZero body -> type-level body
    UPropNotNull body -> type-level body
    UPropAscii body -> type-level body
    UPropOrdered body -> type-level body
    UPropNonZeroPending body -> type-level body
    UIndexForget body -> type-level body
    UIndexPromote body -> type-level body
    UIndexByteLength body -> type-level body
    UIndexBorrowRead body -> type-level body
    UIndexList element fields -> highest (type-level element) (type-level fields)
    UIndexCall function args -> type-level args
    UIndexMath op a b -> highest (type-level a) (type-level b)
    other -> 0
  local-carrier :: UType -> Nat -> TypeScope -> Bool
  local-carrier carrier id scope = case lookup-local id (scope-locals scope) of
    Some sc -> (case scheme-requirements sc of
      Nil -> (case fresh-for-types [carrier, scheme-body sc] (restore-level (highest (type-level carrier) (type-level (scheme-body sc)) + 1) (empty-store "local index carrier")) of
        (fresh, prepared) -> case open-scheme False sc prepared of
          (expected, pairs, opened) -> (case store-errors (unify (Span 0 0 1 1) expected carrier opened) of Nil -> True; other -> False))
      other -> False)
    None -> False
  kind-well-formed :: List (String, Kind) -> TypeScope -> Kind -> Bool
  kind-well-formed kinds scope kind = valid-kind kind && (case kind of
    KFun domain result -> kind-well-formed kinds scope domain && kind-well-formed kinds scope result
    KValue payload -> (case value-carrier kind of Some carrier -> type-well-formed kinds scope carrier; None -> False)
    other -> True)
  index-binding :: UType -> Nat -> List (Nat, Kind) -> Bool
  index-binding carrier id entries = case lookup-id id entries of
    Some kind -> (case value-carrier kind of Some expected -> equal-type expected carrier; None -> False)
    None -> False
  index-well-formed :: List (String, Kind) -> TypeScope -> UType -> IndexTerm -> Bool
  index-well-formed kinds scope carrier value = case value of
    IInteger n -> integer-literal-valid carrier n
    IBound id name -> index-binding carrier id (scope-bound scope)
    IRigid id name level -> index-binding carrier id (scope-rigid scope) || local-carrier carrier id scope
    IAdd a b -> index-well-formed kinds scope carrier a && index-well-formed kinds scope carrier b
    ISubtract a b -> index-well-formed kinds scope carrier a && index-well-formed kinds scope carrier b
    IMultiply a b -> index-well-formed kinds scope carrier a && index-well-formed kinds scope carrier b
    other -> False
  binder-body :: List (String, Kind) -> TypeScope -> Nat -> UType -> UType -> Bool
  binder-body kinds scope id carrier body = type-well-formed kinds scope carrier && (case add-bound-kind id (value-kind carrier) scope of
    Some bound -> type-well-formed kinds bound body
    None -> False)
  type-well-formed :: List (String, Kind) -> TypeScope -> UType -> Bool
  type-well-formed kinds scope ty = valid-type ty && (case ty of
    UCon name actual -> (case lookup-kind name kinds of Some expected -> kind-equal actual expected; None -> False)
    UBound id name actual -> (case lookup-id id (scope-bound scope) of Some expected -> kind-equal actual expected; None -> False)
    URigid id name level actual -> (case lookup-id id (scope-rigid scope) of Some expected -> kind-equal actual expected; None -> case value-carrier actual of Some carrier -> type-well-formed kinds scope carrier && local-carrier carrier id scope; None -> False)
    UMeta id kind -> False
    UError -> False
    UIndex carrier value -> type-well-formed kinds scope carrier && index-runtime-admissible carrier value && index-well-formed kinds scope carrier value
    URefine id name carrier predicate -> binder-body kinds scope id carrier predicate
    URefineFormer name ids body -> (case (lookup-kind name kinds, scheme-type-scope kinds empty-type-scope (refinement-formals ids)) of
      (Some declared, Some bound) -> kind-equal declared (type-kind ty) && type-well-formed kinds bound body
      other -> False)
    UPi id name domain row result -> binder-body kinds scope id domain (UArg row (UArg result UEnd))
    UApp f x -> type-well-formed kinds scope f && type-well-formed kinds scope x
    UFun a b -> type-well-formed kinds scope a && type-well-formed kinds scope b
    UFunEff a row b -> type-well-formed kinds scope a && type-well-formed kinds scope row && type-well-formed kinds scope b
    UUsageArrow usage arrow -> type-well-formed kinds scope arrow
    UProofFun a row b -> type-well-formed kinds scope a && type-well-formed kinds scope row && type-well-formed kinds scope b
    UIndexForget value -> type-well-formed kinds scope value
    UIndexPromote value -> type-well-formed kinds scope value
    UIndexByteLength value -> type-well-formed kinds scope value
    UIndexBorrowRead value -> type-well-formed kinds scope value
    UIndexList element fields -> type-well-formed kinds scope element && type-well-formed kinds scope fields
    UIndexCall function args -> valid-type ty && type-well-formed kinds scope args
    UIndexMath op a b -> type-well-formed kinds scope a && type-well-formed kinds scope b
    URow labels -> type-well-formed kinds scope labels
    URowJoin a b -> type-well-formed kinds scope a && type-well-formed kinds scope b
    UTuple fields -> type-well-formed kinds scope fields
    UForall qs body -> type-well-formed kinds (bind-quant-scope qs scope) body
    UArg first rest -> type-well-formed kinds scope first && type-well-formed kinds scope rest
    UCompare relation a b -> type-well-formed kinds scope a && type-well-formed kinds scope b
    UPropAnd a b -> type-well-formed kinds scope a && type-well-formed kinds scope b
    UPropOr a b -> type-well-formed kinds scope a && type-well-formed kinds scope b
    UPropNot body -> type-well-formed kinds scope body
    UPropNonZero body -> type-well-formed kinds scope body
    UPropNotNull body -> type-well-formed kinds scope body
    UPropAscii body -> type-well-formed kinds scope body
    UPropOrdered body -> type-well-formed kinds scope body
    UPropNonZeroPending body -> type-well-formed kinds scope body
    URequire predicates body -> type-well-formed kinds scope predicates && type-well-formed kinds scope body
    UPropLit value -> True
    UEnd -> True)
  scheme-type-scope :: List (String, Kind) -> TypeScope -> List Quant -> Option TypeScope
  scheme-type-scope kinds scope qs = case qs of
    Nil -> Some scope
    Cons q rest -> if kind-well-formed kinds scope (quant-kind q) then
      (case add-bound-kind (quant-id q) (quant-kind q) scope of Some bound -> scheme-type-scope kinds bound rest; None -> None)
      else None
  requirements-well-formed :: List (String, Kind) -> TypeScope -> List Requirement -> Bool
  requirements-well-formed kinds scope requirements = case requirements of Nil -> True; Cons r rest -> type-well-formed kinds scope (requirement-type r) && requirements-well-formed kinds scope rest
  scheme-well-formed :: List (String, Kind) -> TypeScope -> Scheme -> Bool
  scheme-well-formed kinds scope sc = case scheme-type-scope kinds scope (scheme-params sc) of
    -- A declaration's type is a value type or a proposition: `same :: (value
    -- :: Bool) -> Eq value value` declares a proof former, whose scheme body
    -- is a goal rather than a value. `proper-type` still governs every
    -- position that must be a value.
    Some bound -> declared-type (scheme-body sc) && type-well-formed kinds bound (scheme-body sc) && requirements-well-formed kinds bound (scheme-requirements sc)
    None -> False
  declared-type :: UType -> Bool
  declared-type ty = proper-type ty || (valid-type ty && kind-equal (type-kind ty) KProp)
  proper-type :: UType -> Bool
  proper-type ty = valid-type ty && kind-equal (type-kind ty) KType && valid-kind (value-kind ty)
  argument-well-formed :: List (String, Kind) -> TypeScope -> UType -> Bool
  argument-well-formed kinds scope ty = type-well-formed kinds scope ty && (case type-kind ty of
    KType -> proper-type ty
    KValue payload -> typed-index-admissible ty
    other -> True)
  nominal-seen :: List (String, Kind) -> List (String, Kind) -> List String -> Bool
  nominal-seen all entries names = case entries of
    Nil -> True
    Cons (name, kind) rest -> string-length name > 0 && not (name-seen name names)
      && kind-well-formed all empty-type-scope kind && nominal-seen all rest (Cons name names)
  name-seen :: String -> List String -> Bool
  name-seen name names = case names of Nil -> False; Cons key rest -> same name key || name-seen name rest
  nominal-kinds-closed :: List (String, Kind) -> Bool
  nominal-kinds-closed kinds = nominal-seen kinds kinds Nil
