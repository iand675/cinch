+  -- Ordinary constructors use the public schema's nominal application
+  -- syntax. Keep the fully resolved scheme on its separate canonical path.
+  ordinary-quantifiers :: List Quant -> Bool
+  ordinary-quantifiers quants = case quants of
+    Nil -> True
+    Cons q rest -> not (quant-implicit q) && kind-equal (quant-kind q) KType && ordinary-quantifiers rest
+  ordinary-type :: UType -> Bool
+  ordinary-type ty = case ty of
+    UCon name kind -> True
+    UBound id name kind -> kind-equal kind KType
+    UApp f x -> ordinary-type f && ordinary-type x
+    UFun a b -> ordinary-type a && ordinary-type b
+    UTuple items -> ordinary-tuple items
+    other -> False
+  ordinary-tuple :: UType -> Bool
+  ordinary-tuple items = case items of
+    UEnd -> True
+    UArg first rest -> ordinary-type first && ordinary-tuple rest
+    other -> False
+  constructor-type :: List (Nat, String) -> UType -> Result String String
+  constructor-type scope ty = case ty of
+    UApp f x -> join [constructor-type scope f, Ok " ", case x of
+      UApp g y -> join [Ok "(", constructor-type scope x, Ok ")"]
+      other -> constructor-type scope x]
+    UFun a b -> join [Ok "(", constructor-type scope a, Ok " -> ", constructor-type scope b, Ok ")"]
+    UTuple items -> join [Ok "(", constructor-tuple scope items, Ok ")"]
+    other -> type-in scope ty
+  constructor-tuple :: List (Nat, String) -> UType -> Result String String
+  constructor-tuple scope items = case items of
+    UEnd -> Ok ""
+    UArg first rest -> join [constructor-type scope first, case rest of
+      UEnd -> Ok ""
+      other -> join [Ok ", ", constructor-tuple scope rest]]
+    other -> Err "invalid constructor tuple"
+  constructor-quantifiers :: List (Nat, String) -> List Quant -> (List String, List (Nat, String))
+  constructor-quantifiers scope quants = case quants of
+    Nil -> (Nil, scope)
+    Cons q rest -> let name = source-binder (fresh-name "q" (list-length scope)) (quant-name q) scope in
+      case constructor-quantifiers (Cons (quant-id q, name) scope) rest of
+        (names, bound) -> (Cons name names, bound)
+  ordinary-fields :: List (Nat, String) -> UType -> Result String (List String)
+  ordinary-fields scope ty = case ty of
+    UFun domain result -> prepend-field (constructor-type scope domain) (ordinary-fields scope result)
+    other -> Ok Nil
+  export-constructor-display :: Bool -> Scheme -> (Result String (List String), Result String String)
+  export-constructor-display hidden scheme = let quants = scheme-params scheme in let body = scheme-body scheme in
+    if hidden || not (ordinary-quantifiers quants && ordinary-type body) then (export-constructor-fields scheme, export-value-scheme scheme)
+    else case scheme-requirements scheme of
+      Cons first rest -> (export-constructor-fields scheme, export-value-scheme scheme)
+      Nil -> case constructor-quantifiers Nil quants of
+        (names, scope) -> (ordinary-fields scope body, case names of
+          Nil -> constructor-type scope body
+          other -> join [Ok "forall ", Ok (strings " " names), Ok " . ", constructor-type scope body])
