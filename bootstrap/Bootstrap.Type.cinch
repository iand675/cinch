-- Type inference shared by the elaborator. Error recovery types are used
-- only after a diagnostic; they are not evidence of type equality.
module Bootstrap.Type where

  import Bootstrap.Report (Diagnostic, MkDiagnostic, MkDeferredDiagnostic)
  import Text.Lex (Span)
  import Data.Json
  import Data.Nat (nat-from-int, nat-to-int)
  import Data.Int (int-div, int-rem)
  import Bootstrap.Index
  import Bootstrap.Nominal (interface-global, decode-identity, global-data-core-list)
  import Bootstrap.Total (TotalFunction, read-total-function, total-identity, total-parameters, total-result, total-function-document, total-function-equal)
  import Text.Show (int-to-string)
  import Algebra.Semigroup

  export Kind, KType, KProp, KRegion, KEffect, KRow, KFun, KValue, kind-equal, kind-text
  export same-shape, carrier-tree, read-carrier-tree, kind-tree, read-kind-tree
  export valid-kind, map-kind-types, value-kind, value-carrier
  export arrow-constructor-kind, type-application, refinement-view, refinement-formals
  export ArrowUsage, UsageZero, UsageOne, UsageAffine, UsageMany, parse-arrow-usage, arrow-usage-text, UUsageArrow, arrow-shape, erased-value-arrow
  export UType, UPropLit, UCompare, UPropAnd, UPropOr, UPropNot, UPropNonZero, UPropNonZeroPending, UPropNotNull, UPropAscii, UPropOrdered, UPropAscii, UPropOrdered, URequire, URefine, URefineFormer, UCon, UBound, URigid, UMeta, UIndex, UIndexForget, UIndexPromote, UIndexByteLength, UIndexBorrowRead, UIndexCall, UIndexList, UIndexMath, UPi, UApp, UFun, UFunEff, UProofFun, URow, URowJoin, UTuple, UForall, UArg, UEnd, UError
  export core-list-type, core-list-element, ascii-carrier, ordered-carrier
  export borrow-constructor-kind, borrow-type-parts, borrow-regions, borrow-region-conflict
  export thunk-kind, thunk-type, thunk-parts
  export later-kind, later-type, later-parts, deferral-parts, later-unrestricted
  export lazy-kind, lazy-type, lazy-parts
  export without-index-levels, index-of-type, index-runtime-admissible, typed-index-admissible, open-pi, open-refinement
  export type-free-bound
  export include-effects, union-effects
  export Quant, MkQuant, quant-id, quant-name, quant-kind, quant-implicit
  export Requirement, MkRequirement, requirement-name, requirement-type, map-requirements
  export Scheme, MkScheme, MkQualifiedScheme, scheme-params, scheme-body, scheme-requirements, mono, qualified
  export map-scheme-types, open-qualified
  export instantiate-params, map-quant-kinds, has-forall, quant-id-list, quant-names-text, same-quant-kinds, rename-quants, remove-ids
  export pending-number, pending-comparison, default-numbers-for, finish-numbers
  export Store, empty-store, store-errors, store-level, enter-level, restore-level
  export store-law-scope, with-law-scope
  export store-let-depth, with-let-depth
  export add-error, fresh-meta, instantiate, skolemize, open-scheme, normalize, unify, valid-type
  export type-kind, type-text, display-type-text, free-metas, scheme-metas, generalize, scheme-arity, scheme-runtime-arity
  export generalize-with, generalize-application-with, abstract-metas, substitute-rigid-types
  export fresh-id, substitute-bound, fresh-for-types, pi-dependent, unify-kind, kind-free-bound
  export type-all-ids, integer-carrier, integer-literal-valid, integer-bounds
  export number-literal-carrier, number-literal-valid, number-literal-error, float-literal-bits

  data Kind where
    KType :: Kind
    KProp :: Kind
    KRegion :: Kind
    KEffect :: Kind
    KRow :: Kind
    KFun :: Kind -> Kind -> Kind
    -- A complete tagged type tree avoids a forward-recursive Kind/UType
    -- declaration in this bootstrap language. Always use value-kind and
    -- value-carrier; malformed trees are rejected by valid-kind.
    KValue :: Json -> Kind

  data ArrowUsage where
    UsageZero :: ArrowUsage
    UsageOne :: ArrowUsage
    UsageAffine :: ArrowUsage
    UsageMany :: ArrowUsage

  data UType where
    UPropLit :: Bool -> UType
    UCompare :: String -> UType -> UType -> UType
    UPropAnd :: UType -> UType -> UType
    UPropOr :: UType -> UType -> UType
    UPropNot :: UType -> UType
    -- Structural predicate identity is retained. Logical discharge may
    -- read it as inequality to zero; type conversion must not erase it.
    UPropNonZero :: UType -> UType
    UPropNonZeroPending :: UType -> UType
    UPropNotNull :: UType -> UType
    -- The two container predicates of the closed decidable vocabulary
    -- that decide over a shape rather than a numeral: every byte of a text
    -- value below 128 (`Ascii`), every adjacent pair non-decreasing
    -- (`Ordered`). Both are structural: the checker decides them over
    -- constructor forms, the runtime decides them under `decide`.
    UPropAscii :: UType -> UType
    UPropOrdered :: UType -> UType
    -- Required propositions are part of the type, never a cast to its body.
    URequire :: UType -> UType -> UType
    -- The value binder scopes its predicate only; the runtime carrier is
    -- retained explicitly. No unification rule forgets this predicate.
    URefine :: Nat -> String -> UType -> UType -> UType
    -- A closed checked refinement abstracted over proper type parameters.
    -- Its applications keep their spine for higher-kinded inference.
    URefineFormer :: String -> List Nat -> UType -> UType
    UCon :: String -> Kind -> UType
    UBound :: Nat -> String -> Kind -> UType
    URigid :: Nat -> String -> Nat -> Kind -> UType
    UMeta :: Nat -> Kind -> UType
    UIndex :: UType -> IndexTerm -> UType
    -- Typed value-index nodes preserve the input carrier through formal
    -- substitution. Projection is not permission to weaken a binder sort.
    UIndexForget :: UType -> UType
    UIndexByteLength :: UType -> UType
    UIndexBorrowRead :: UType -> UType
    -- A checked executable body and typed argument spine retain the evidence
    -- lost by a bare IApply/IGlobal. This node does not license a source call
    -- until Core also matches its actual defining function and arguments.
    -- Nil has an empty spine. Cons records the typed head and tail.
    UIndexList :: UType -> UType -> UType
    UIndexCall :: TotalFunction -> UType -> UType
    UIndexPromote :: UType -> UType
    UIndexMath :: String -> UType -> UType -> UType
    UPi :: Nat -> String -> UType -> UType -> UType -> UType
    UApp :: UType -> UType -> UType
    UFun :: UType -> UType -> UType
    UFunEff :: UType -> UType -> UType -> UType
    -- Usage annotates a single computational arrow, preserving its row and
    -- any dependent binder. The enclosed arrow must be unannotated.
    UUsageArrow :: ArrowUsage -> UType -> UType
    -- The domain is a proposition, not a runtime carrier. Applying an
    -- erased argument still performs the call and its latent effects.
    UProofFun :: UType -> UType -> UType -> UType
    URow :: UType -> UType
    URowJoin :: UType -> UType -> UType
    UTuple :: UType -> UType
    -- A nested polymorphic type (design/rank-n-polymorphism.md): its
    -- binders are `UBound` ids unique in the store, exactly as a scheme's,
    -- so substitution never captures one. No metavariable is ever bound
    -- to a type containing it (predicativity, `bind-other`).
    UForall :: List Quant -> UType -> UType
    UArg :: UType -> UType -> UType
    UEnd :: UType
    UError :: UType

  parse-arrow-usage :: String -> Option ArrowUsage
  parse-arrow-usage text =
    if same-tag text "%0" then Some UsageZero
    else if same-tag text "%1" then Some UsageOne
    else if same-tag text "%aff" then Some UsageAffine
    else if same-tag text "%many" then Some UsageMany
    else None

  arrow-usage-text :: ArrowUsage -> String
  arrow-usage-text usage = case usage of
    UsageZero -> "%0"
    UsageOne -> "%1"
    UsageAffine -> "%aff"
    UsageMany -> "%many"

  -- Two independent single-constructor tests, not a pair: `case (x, y)`
  -- would allocate the pair block on every call.
  same-arrow-usage :: ArrowUsage -> ArrowUsage -> Bool
  same-arrow-usage first second = case first of
    UsageZero -> case second of UsageZero -> True; other -> False
    UsageOne -> case second of UsageOne -> True; other -> False
    UsageAffine -> case second of UsageAffine -> True; other -> False
    UsageMany -> case second of UsageMany -> True; other -> False

  -- Inspect one arrow's shape while retaining its usage in the owning type.
  arrow-shape :: UType -> UType
  arrow-shape ty = case ty of UUsageArrow usage arrow -> arrow; other -> ty
  erased-value-arrow :: UType -> Bool
  erased-value-arrow ty = case ty of UUsageArrow UsageZero arrow -> True; other -> False
  computational-arrow :: UType -> Bool
  computational-arrow ty = case ty of
    UFun a b -> True
    UFunEff a row b -> True
    UPi id name domain row result -> True
    other -> False

  thunk-kind :: Kind
  thunk-kind = KFun KRow (KFun KType KType)
  thunk-type :: UType -> UType -> UType
  thunk-type row result = UApp (UApp (UCon "Thunk" thunk-kind) row) result
  thunk-parts :: UType -> Option (UType, UType)
  thunk-parts ty = case ty of
    UApp (UApp (UCon name kind) row) result -> if same-tag name "Thunk" && kind-equal kind thunk-kind then Some (row, result) else None
    other -> None
  later-kind :: Kind
  later-kind = KFun KType KType
  later-type :: UType -> UType
  later-type result = UApp (UCon "Later" later-kind) result
  later-parts :: UType -> Option UType
  later-parts ty = case ty of
    UApp (UCon name kind) result -> if same-tag name "Later" && kind-equal kind later-kind then Some result else None
    other -> None
  -- Forcing a guarded value uses the same closure ABI, with a pure row.
  deferral-parts :: UType -> Option (UType, UType)
  deferral-parts ty = case later-parts ty of
    Some result -> Some (URow UEnd, result)
    None -> thunk-parts ty
  later-domain :: UType -> Bool
  later-domain ty = case later-parts ty of Some carrier -> True; None -> False
  later-unrestricted :: ArrowUsage -> UType -> Bool
  later-unrestricted usage arrow = case usage of
    UsageMany -> (case arrow of
      UFun domain result -> later-domain domain
      UFunEff domain row result -> later-domain domain
      UPi id name domain row result -> later-domain domain
      other -> False)
    other -> False
  distinct-deferrals :: UType -> UType -> Bool
  distinct-deferrals first second = case later-parts first of
    Some result -> (case thunk-parts second of Some parts -> True; None -> False)
    None -> (case (thunk-parts first, later-parts second) of (Some parts, Some result) -> True; other -> False)

  lazy-kind :: Kind
  lazy-kind = KFun KRow (KFun KRegion (KFun KType KType))
  lazy-type :: UType -> UType -> UType -> UType
  lazy-type row region result = UApp (UApp (UApp (UCon "Lazy" lazy-kind) row) region) result
  lazy-parts :: UType -> Option (UType, UType, UType)
  lazy-parts ty = case ty of
    UApp (UApp (UApp (UCon name kind) row) region) result ->
      if same-tag name "Lazy" && kind-equal kind lazy-kind then Some (row, region, result) else None
    other -> None

  value-kind :: UType -> Kind
  value-kind carrier = KValue (carrier-tree carrier)
  value-carrier :: Kind -> Option UType
  value-carrier kind = case kind of KValue payload -> read-carrier-tree payload; other -> None
  tree :: String -> List Json -> Json
  tree tag fields = JArr (JStr tag) (tree-fields fields)
  tree-fields :: List Json -> Json
  tree-fields fields = case fields of Nil -> JArrEnd; Cons field rest -> JArr field (tree-fields rest)
  kind-tree :: Kind -> Json
  kind-tree kind = case kind of
    KType -> JStr "Type"
    KProp -> JStr "Prop"
    KRegion -> JStr "Region"
    KEffect -> JStr "Effect"
    KRow -> JStr "Row"
    KFun a b -> tree "kind-fun" [kind-tree a, kind-tree b]
    KValue payload -> tree "value" [payload]
  carrier-tree :: UType -> Json
  carrier-tree ty = case ty of
    UPropLit value -> tree "prop-literal" [JBool value]
    UCompare relation left right -> tree "prop-compare" [JStr relation, carrier-tree left, carrier-tree right]
    UPropAnd left right -> tree "prop-and" [carrier-tree left, carrier-tree right]
    UPropOr left right -> tree "prop-or" [carrier-tree left, carrier-tree right]
    UPropNot body -> tree "prop-not" [carrier-tree body]
    UPropNonZero body -> tree "prop-nonzero" [carrier-tree body]
    UPropNonZeroPending body -> tree "prop-nonzero-pending" [carrier-tree body]
    UPropNotNull body -> tree "prop-not-null" [carrier-tree body]
    UPropAscii body -> tree "prop-ascii" [carrier-tree body]
    UPropOrdered body -> tree "prop-ordered" [carrier-tree body]
    URequire predicates body -> tree "required" [carrier-tree predicates, carrier-tree body]
    URefine id name carrier predicate -> tree "refined" [JNum (nat-to-int id), JStr name, carrier-tree carrier, carrier-tree predicate]
    URefineFormer name ids body -> tree "refinement-former" [JStr name, former-id-tree ids, carrier-tree body]
    UCon name kind -> tree "con" [JStr name, kind-tree kind]
    UBound id name kind -> tree "bound" [JNum (nat-to-int id), JStr name, kind-tree kind]
    URigid id name level kind -> tree "rigid" [JNum (nat-to-int id), JStr name, JNum (nat-to-int level), kind-tree kind]
    UMeta id kind -> tree "meta" [JNum (nat-to-int id), kind-tree kind]
    UIndex carrier value -> tree "index" [carrier-tree carrier, index-tree value]
    UIndexForget value -> tree "index-forget" [carrier-tree value]
    UIndexByteLength value -> tree "index-byte-length" [carrier-tree value]
    UIndexBorrowRead value -> tree "index-borrow-read" [carrier-tree value]
    UIndexList element fields -> tree "index-list" [carrier-tree element, carrier-tree fields]
    UIndexCall function args -> tree "index-total-call" [total-function-document function, JStr (total-identity function), carrier-tree args]
    UIndexPromote value -> tree "index-promote" [carrier-tree value]
    UIndexMath op left right -> tree "index-math" [JStr op, carrier-tree left, carrier-tree right]
    UPi id name domain row result -> tree "pi" [JNum (nat-to-int id), JStr name, carrier-tree domain, carrier-tree row, carrier-tree result]
    UApp f x -> tree "app" [carrier-tree f, carrier-tree x]
    UFun a b -> tree "fun" [carrier-tree a, carrier-tree b]
    UFunEff a row b -> tree "effect-fun" [carrier-tree a, carrier-tree row, carrier-tree b]
    UUsageArrow usage arrow -> tree "usage-fun" [JStr (arrow-usage-text usage), carrier-tree arrow]
    UProofFun a row b -> tree "proof-fun" [carrier-tree a, carrier-tree row, carrier-tree b]
    URow labels -> tree "row" [carrier-tree labels]
    URowJoin a b -> tree "row-join" [carrier-tree a, carrier-tree b]
    UTuple fields -> tree "tuple" [carrier-tree fields]
    UForall qs body -> tree "forall" [quant-trees qs, carrier-tree body]
    UArg a rest -> tree "arg" [carrier-tree a, carrier-tree rest]
    UEnd -> JStr "end"
    UError -> JStr "error"
  quant-trees :: List Quant -> Json
  quant-trees qs = case qs of
    Nil -> JArrEnd
    Cons (MkQuant id name kind only) rest -> JArr (tree "quant" [JNum (nat-to-int id), JStr name, kind-tree kind, JBool only]) (quant-trees rest)
  read-quant-trees :: Json -> Option (List Quant)
  read-quant-trees doc = case doc of
    JArrEnd -> Some Nil
    JArr (JArr (JStr tag) (JArr a (JArr (JStr name) (JArr k (JArr (JBool only) JArrEnd))))) rest ->
      if same-tag tag "quant" then (case (tree-natural a, read-kind-tree k, read-quant-trees rest) of
        (Some id, Some kind, Some qs) -> Some (Cons (MkQuant id name kind only) qs)
        other -> None) else None
    other -> None
  same-tag :: String -> String -> Bool
  same-tag a b = string-compare a b == 0
  tree-natural :: Json -> Option Nat
  tree-natural value = case value of JNum n -> if n < 0 then None else Some (nat-from-int n); other -> None
  former-id-tree :: List Nat -> Json
  former-id-tree ids = case ids of Nil -> JArrEnd; Cons id rest -> JArr (JNum (nat-to-int id)) (former-id-tree rest)
  read-former-ids :: Json -> Option (List Nat)
  read-former-ids doc = case doc of
    JArrEnd -> Some Nil
    JArr first rest -> case (tree-natural first, read-former-ids rest) of
      (Some id, Some ids) -> Some (Cons id ids)
      other -> None
    other -> None
  read-kind-tree :: Json -> Option Kind
  read-kind-tree doc = case doc of
    JStr tag -> if same-tag tag "Type" then Some KType else if same-tag tag "Prop" then Some KProp else if same-tag tag "Region" then Some KRegion
      else if same-tag tag "Effect" then Some KEffect else if same-tag tag "Row" then Some KRow else None
    JArr (JStr tag) (JArr payload JArrEnd) -> if same-tag tag "value" then Some (KValue payload) else None
    JArr (JStr tag) (JArr a (JArr b JArrEnd)) -> if same-tag tag "kind-fun" then
      (case (read-kind-tree a, read-kind-tree b) of (Some left, Some right) -> Some (KFun left right); other -> None) else None
    other -> None
  read-carrier-tree :: Json -> Option UType
  read-carrier-tree doc = case doc of
    JArr (JStr tag) (JArr (JBool value) JArrEnd) -> if same-tag tag "prop-literal" then Some (UPropLit value) else None
    JStr tag -> if same-tag tag "end" then Some UEnd else if same-tag tag "error" then Some UError else None
    JArr (JStr tag) (JArr a JArrEnd) -> case read-carrier-tree a of
      Some value -> if same-tag tag "row" then Some (URow value) else if same-tag tag "tuple" then Some (UTuple value) else if same-tag tag "prop-not" then Some (UPropNot value) else if same-tag tag "prop-nonzero" then Some (UPropNonZero value) else if same-tag tag "prop-nonzero-pending" then Some (UPropNonZeroPending value) else if same-tag tag "prop-not-null" then Some (UPropNotNull value) else if same-tag tag "prop-ascii" then Some (UPropAscii value) else if same-tag tag "prop-ordered" then Some (UPropOrdered value) else if same-tag tag "index-forget" then Some (UIndexForget value) else if same-tag tag "index-byte-length" then Some (UIndexByteLength value) else if same-tag tag "index-borrow-read" then Some (UIndexBorrowRead value) else if same-tag tag "index-promote" then Some (UIndexPromote value) else None
      None -> None
    JArr (JStr tag) (JArr a (JArr b JArrEnd)) ->
      if same-tag tag "con" then (case (a, read-kind-tree b) of (JStr name, Some kind) -> Some (UCon name kind); other -> None)
      else if same-tag tag "meta" then (case (tree-natural a, read-kind-tree b) of (Some id, Some kind) -> Some (UMeta id kind); other -> None)
      else if same-tag tag "index" then (case (read-carrier-tree a, index-from-tree b) of (Some carrier, Some value) -> Some (UIndex carrier value); other -> None)
      else if same-tag tag "forall" then (case (read-quant-trees a, read-carrier-tree b) of
        (Some qs, Some body) -> Some (UForall qs body)
        other -> None)
      else if same-tag tag "usage-fun" then (case (a, read-carrier-tree b) of
        (JStr marker, Some arrow) -> case parse-arrow-usage marker of
          Some usage -> if computational-arrow arrow then Some (UUsageArrow usage arrow) else None
          None -> None
        other -> None)
      else case read-carrier-tree a of
        Some left -> case read-carrier-tree b of
          Some right -> if same-tag tag "app" then Some (UApp left right) else if same-tag tag "fun" then Some (UFun left right)
            else if same-tag tag "index-list" then Some (UIndexList left right)
            else if same-tag tag "row-join" then Some (URowJoin left right) else if same-tag tag "arg" then Some (UArg left right) else if same-tag tag "prop-and" then Some (UPropAnd left right) else if same-tag tag "prop-or" then Some (UPropOr left right) else if same-tag tag "required" then Some (URequire left right) else None
          other -> None
        other -> None
    JArr (JStr tag) (JArr a (JArr b (JArr c JArrEnd))) ->
      if same-tag tag "index-total-call" then (case (b, read-carrier-tree c) of
        (JStr identity, Some args) -> (case read-total-function a identity of Some function -> Some (UIndexCall function args); None -> None)
        other -> None)
      else if same-tag tag "refinement-former" then (case (a, read-former-ids b, read-carrier-tree c) of
        (JStr name, Some ids, Some body) -> Some (URefineFormer name ids body)
        other -> None)
      else if same-tag tag "prop-compare" then (case (a, read-carrier-tree b, read-carrier-tree c) of (JStr relation, Some left, Some right) -> Some (UCompare relation left right); other -> None)
      else if same-tag tag "index-math" then (case (a, read-carrier-tree b, read-carrier-tree c) of (JStr op, Some left, Some right) -> Some (UIndexMath op left right); other -> None)
      else if same-tag tag "bound" then (case (tree-natural a, b, read-kind-tree c) of (Some id, JStr name, Some kind) -> Some (UBound id name kind); other -> None)
      else if same-tag tag "effect-fun" then (case (read-carrier-tree a, read-carrier-tree b, read-carrier-tree c) of (Some domain, Some row, Some result) -> Some (UFunEff domain row result); other -> None)
      else if same-tag tag "proof-fun" then (case (read-carrier-tree a, read-carrier-tree b, read-carrier-tree c) of (Some predicate, Some row, Some result) -> Some (UProofFun predicate row result); other -> None)
      else None
    JArr (JStr tag) (JArr a (JArr b (JArr c (JArr d JArrEnd)))) -> if same-tag tag "rigid" then
      (case (tree-natural a, b, tree-natural c, read-kind-tree d) of (Some id, JStr name, Some level, Some kind) -> Some (URigid id name level kind); other -> None)
      else if same-tag tag "refined" then (case (tree-natural a, b, read-carrier-tree c, read-carrier-tree d) of
        (Some id, JStr name, Some carrier, Some predicate) -> Some (URefine id name carrier predicate)
        other -> None) else None
    JArr (JStr tag) (JArr a (JArr b (JArr c (JArr d (JArr e JArrEnd))))) ->
      if same-tag tag "pi" then (case (tree-natural a, b, read-carrier-tree c, read-carrier-tree d, read-carrier-tree e) of
        (Some id, JStr name, Some domain, Some row, Some result) -> Some (UPi id name domain row result)
        other -> None) else None
    other -> None

  kind-equal :: Kind -> Kind -> Bool
  kind-equal a b = case a of
    KType -> case b of KType -> True; other -> False
    KProp -> case b of KProp -> True; other -> False
    KRegion -> case b of KRegion -> True; other -> False
    KEffect -> case b of KEffect -> True; other -> False
    KRow -> case b of KRow -> True; other -> False
    KFun x y -> case b of KFun u v -> kind-equal x u && kind-equal y v; other -> False
    KValue payload -> case value-carrier a of
      Some carrier -> case value-carrier b of Some other -> carrier-equal carrier other; other -> False
      other -> False

  -- Compare carriers by the existing type-conversion rules. Metas are
  -- temporarily rigid: a pure kind equality check must not solve them.
  -- Parity keeps those temporary identities separate from real rigids.
  carrier-equal :: UType -> UType -> Bool
  carrier-equal first second = carrier-type first && carrier-type second &&
    (same-shape first second || (case store-errors (unify (Span 0 0 1 1) (opaque-carrier first) (opaque-carrier second) (empty-store "kind conversion")) of Nil -> True; other -> False))
  opaque-carrier :: UType -> UType
  opaque-carrier ty = case ty of
    UPropLit value -> UPropLit value
    UCompare relation left right -> UCompare relation (opaque-carrier left) (opaque-carrier right)
    UPropAnd left right -> UPropAnd (opaque-carrier left) (opaque-carrier right)
    UPropOr left right -> UPropOr (opaque-carrier left) (opaque-carrier right)
    UPropNot body -> UPropNot (opaque-carrier body)
    UPropNonZero body -> UPropNonZero (opaque-carrier body)
    UPropNotNull body -> UPropNotNull (opaque-carrier body)
    UPropAscii body -> UPropAscii (opaque-carrier body)
    UPropOrdered body -> UPropOrdered (opaque-carrier body)
    UPropNonZeroPending body -> UPropNonZeroPending (opaque-carrier body)
    URequire predicates body -> URequire (opaque-carrier predicates) (opaque-carrier body)
    URefine id name carrier predicate -> URefine id name (opaque-carrier carrier) (opaque-carrier predicate)
    UIndexForget value -> UIndexForget (opaque-carrier value)
    UIndexByteLength value -> UIndexByteLength (opaque-carrier value)
    UIndexBorrowRead value -> UIndexBorrowRead (opaque-carrier value)
    UIndexList element fields -> UIndexList (opaque-carrier element) (opaque-carrier fields)
    UIndexCall function args -> UIndexCall function (opaque-carrier args)
    UIndexPromote value -> UIndexPromote (opaque-carrier value)
    UIndexMath op left right -> UIndexMath op (opaque-carrier left) (opaque-carrier right)
    UMeta id k -> URigid (id * 2) "#kind-meta" 0 (map-kind-types opaque-carrier k)
    URigid id name level k -> URigid (id * 2 + 1) name level (map-kind-types opaque-carrier k)
    UCon name k -> UCon name (map-kind-types opaque-carrier k)
    UBound id name k -> UBound id name (map-kind-types opaque-carrier k)
    UIndex carrier value -> UIndex (opaque-carrier carrier) (opaque-index value)
    UPi id name domain row result -> UPi id name (opaque-carrier domain) (opaque-carrier row) (opaque-carrier result)
    UApp f x -> UApp (opaque-carrier f) (opaque-carrier x)
    UFun a b -> UFun (opaque-carrier a) (opaque-carrier b)
    UFunEff a row b -> UFunEff (opaque-carrier a) (opaque-carrier row) (opaque-carrier b)
    UUsageArrow usage arrow -> UUsageArrow usage (opaque-carrier arrow)
    UProofFun a row b -> UProofFun (opaque-carrier a) (opaque-carrier row) (opaque-carrier b)
    URow labels -> URow (opaque-carrier labels)
    URowJoin a b -> URowJoin (opaque-carrier a) (opaque-carrier b)
    UTuple fields -> UTuple (opaque-carrier fields)
    UForall qs body -> UForall qs (opaque-carrier body)
    UArg first rest -> UArg (opaque-carrier first) (opaque-carrier rest)
    other -> ty
  opaque-index :: IndexTerm -> IndexTerm
  opaque-index term = case term of
    IMeta id -> IRigid (id * 2) "#kind-meta" 0
    IRigid id name level -> IRigid (id * 2 + 1) name level
    IApply f x -> IApply (opaque-index f) (opaque-index x)
    ILambda id name body -> ILambda id name (opaque-index body)
    IAdd a b -> IAdd (opaque-index a) (opaque-index b)
    ISubtract a b -> ISubtract (opaque-index a) (opaque-index b)
    IMultiply a b -> IMultiply (opaque-index a) (opaque-index b)
    other -> term

  kind-text :: Kind -> String
  kind-text k = case k of
    KType -> "Type"
    KProp -> "Prop"
    KRegion -> "Region"
    KEffect -> "Effect"
    KRow -> "Row"
    KFun a b -> string-concat-all ["(", kind-text a, " -> ", kind-text b, ")"]
    KValue payload -> case value-carrier k of Some carrier -> type-text carrier; None -> "<invalid value carrier>"

  -- The kind arms of the three whole-type maps, written as direct recursion
  -- over a kind instead of through `map-kind-types f kind`. A higher-order
  -- argument is a closure allocated at every call, and `normalize-kind` and
  -- `transform-type` are on the hottest type paths in the checker, so the
  -- partial application was 3.8 M blocks per toolkit check by itself
  -- (design/compilation-speed.md section 2.19). Each entry point keeps its
  -- own name and its own `KValue` decode/encode, so every caller of the old
  -- function has an exact replacement and no closure is built.
  map-kind-types :: (UType -> UType) -> Kind -> Kind
  map-kind-types f kind = case kind of
    KValue payload -> case value-carrier kind of Some carrier -> value-kind (f carrier); None -> kind
    KFun a b -> KFun (map-kind-types f a) (map-kind-types f b)
    other -> kind
  normalize-kind :: Store -> Kind -> Kind
  normalize-kind st kind = case kind of
    KValue payload -> case value-carrier kind of Some carrier -> value-kind (normalize st carrier); None -> kind
    KFun a b -> KFun (normalize-kind st a) (normalize-kind st b)
    other -> kind
  valid-kind :: Kind -> Bool
  valid-kind kind = case kind of
    KValue payload -> case value-carrier kind of Some carrier -> carrier-type carrier; None -> False
    KFun a b -> valid-kind a && valid-kind b
    other -> True

  -- Sequence nodes have a role inside tuples and rows, but are not
  -- standalone carrier types or application operands.
  carrier-type :: UType -> Bool
  carrier-type ty = kind-equal (type-kind ty) KType && carrier-node ty
  carrier-node :: UType -> Bool
  carrier-node ty = valid-type ty && (case ty of
    UEnd -> False
    UArg a rest -> False
    UError -> False
    UApp f x -> carrier-node f && carrier-node x
    UFun a b -> carrier-type a && carrier-type b
    UFunEff a row b -> carrier-type a && carrier-node row && carrier-type b
    UUsageArrow usage arrow -> computational-arrow arrow && carrier-type arrow
    UProofFun predicate row result -> carrier-node predicate && carrier-node row && carrier-type result
    URow labels -> carrier-spine labels False
    URowJoin a b -> carrier-node a && carrier-node b
    UTuple fields -> carrier-spine fields True
    other -> True)
  carrier-spine :: UType -> Bool -> Bool
  carrier-spine fields values = case fields of
    UEnd -> True
    UArg first rest -> (if values then carrier-type first else carrier-node first) && carrier-spine rest values
    other -> False

  data Quant where
    MkQuant :: Nat -> String -> Kind -> Bool -> Quant

  quant-id :: Quant -> Nat
  quant-id q = case q of MkQuant n name k only -> n
  quant-name :: Quant -> String
  quant-name q = case q of MkQuant n name k only -> name
  quant-kind :: Quant -> Kind
  quant-kind q = case q of MkQuant n name k only -> k
  quant-implicit :: Quant -> Bool
  quant-implicit q = case q of MkQuant n name k only -> only

  data Requirement where
    MkRequirement :: String -> UType -> Requirement
  requirement-name :: Requirement -> String
  requirement-name r = case r of MkRequirement name ty -> name
  requirement-type :: Requirement -> UType
  requirement-type r = case r of MkRequirement name ty -> ty
  map-requirements :: (UType -> UType) -> List Requirement -> List Requirement
  map-requirements f rs = case rs of Nil -> Nil; Cons (MkRequirement name ty) rest -> Cons (MkRequirement name (f ty)) (map-requirements f rest)

  data Scheme where
    MkScheme :: List Quant -> UType -> Scheme
    MkQualifiedScheme :: List Quant -> List Requirement -> UType -> Scheme

  scheme-params :: Scheme -> List Quant
  scheme-params sc = case sc of MkScheme qs ty -> qs; MkQualifiedScheme qs rs ty -> qs
  scheme-body :: Scheme -> UType
  scheme-body sc = case sc of MkScheme qs ty -> ty; MkQualifiedScheme qs rs ty -> ty
  scheme-requirements :: Scheme -> List Requirement
  scheme-requirements sc = case sc of MkScheme qs ty -> Nil; MkQualifiedScheme qs rs ty -> rs
  qualified :: List Quant -> List Requirement -> UType -> Scheme
  qualified qs rs ty = case rs of Nil -> MkScheme qs ty; other -> MkQualifiedScheme qs rs ty
  map-scheme-types :: (UType -> UType) -> Scheme -> Scheme
  map-scheme-types f sc = qualified (map-quant-kinds f (scheme-params sc)) (map-requirements f (scheme-requirements sc)) (f (scheme-body sc))
  map-quant-kinds :: (UType -> UType) -> List Quant -> List Quant
  map-quant-kinds f qs = case qs of Nil -> Nil; Cons (MkQuant id name kind only) rest -> Cons (MkQuant id name (map-kind-types f kind) only) (map-quant-kinds f rest)
  mono :: UType -> Scheme
  mono ty = MkScheme Nil ty

  data Cell where
    MkCell :: Nat -> Nat -> Kind -> Option UType -> Cell
  data PendingNumber where
    PendingNumber :: Span -> UType -> Int -> PendingNumber
    PendingComparison :: Span -> UType -> List String -> PendingNumber
  data Store where
    MkStore :: String -> Nat -> Nat -> List Cell -> List Diagnostic -> List PendingNumber -> Bool -> Nat -> Store

  empty-store :: String -> Store
  empty-store label = MkStore label 0 0 Nil Nil Nil False 0
  store-let-depth :: Store -> Nat
  store-let-depth st = case st of MkStore label next level cells errors numbers in-law depth -> depth
  with-let-depth :: Nat -> Store -> Store
  with-let-depth depth st = case st of
    MkStore label next level cells errors numbers in-law previous -> MkStore label next level cells errors numbers in-law depth
  store-law-scope :: Store -> Bool
  store-law-scope st = case st of MkStore label next level cells errors numbers in-law depth -> in-law
  with-law-scope :: Bool -> Store -> Store
  with-law-scope active st = case st of
    MkStore label next level cells errors numbers in-law depth -> MkStore label next level cells errors numbers active depth
  store-errors :: Store -> List Diagnostic
  store-errors st = case st of MkStore label next level cells errors numbers in-law depth -> reverse errors
  store-level :: Store -> Nat
  store-level st = case st of MkStore label next level cells errors numbers in-law depth -> level
  enter-level :: Store -> Store
  enter-level st = case st of MkStore label next level cells errors numbers in-law depth -> MkStore label next (level + 1) cells errors numbers in-law depth
  restore-level :: Nat -> Store -> Store
  restore-level level st = case st of MkStore label next old cells errors numbers in-law depth -> MkStore label next level cells errors numbers in-law depth
  add-error :: Span -> String -> Store -> Store
  add-error sp message st = case st of
    MkStore label next level cells errors numbers in-law depth -> MkStore label next level cells (Cons (MkDiagnostic label sp message) errors) numbers in-law depth
  -- A named diagnostic whose text is built when the report is read. A failed
  -- trial unification discards its whole error list, so a mismatch that is
  -- rolled back pays one closure instead of a rendering.
  add-deferred-error :: Span -> (Unit -> String) -> Store -> Store
  add-deferred-error sp render st = case st of
    MkStore label next level cells errors numbers in-law depth -> MkStore label next level cells (Cons (MkDeferredDiagnostic label sp render) errors) numbers in-law depth

  fresh-meta :: Kind -> Store -> (UType, Store)
  fresh-meta k original =
    let checked = validate-kind-indices (Span 0 0 1 1) k original in
    if list-length (store-errors checked) > list-length (store-errors original) then (UError, checked)
    else fresh-meta-checked k checked
  fresh-meta-checked :: Kind -> Store -> (UType, Store)
  fresh-meta-checked k st = case st of
    MkStore label next level cells errors numbers in-law depth ->
      let kind = normalize-kind st k in
      let dependencies = kind-metas st kind in
      if not (valid-kind kind) then (UError, add-error (Span 0 0 1 1) "invalid inference variable kind" st)
      else if contains-id next dependencies then (UError, add-error (Span 0 0 1 1) "an inference variable occurs in its own kind" st)
      else if not (known-metas dependencies st) then (UError, add-error (Span 0 0 1 1) "unknown inference variable in kind" st)
      else if kind-escapes level kind then (UError, add-error (Span 0 0 1 1) "an inference kind escapes its scope" st)
      else case lower level dependencies st of
        MkStore label next level lowered errors numbers in-law depth -> (UMeta next kind, MkStore label (next + 1) level (Cons (MkCell next level kind None) lowered) errors numbers in-law depth)
  known-metas :: List Nat -> Store -> Bool
  known-metas ids st = case ids of Nil -> True; Cons id rest -> (case find-cell id st of Some cell -> known-metas rest st; None -> False)
  fresh-id :: Store -> (Nat, Store)
  fresh-id st = case st of MkStore label next level cells errors numbers in-law depth -> (next, MkStore label (next + 1) level cells errors numbers in-law depth)

  cell :: Nat -> List Cell -> Option Cell
  cell id cells = case cells of
    Nil -> None
    Cons c rest -> case c of MkCell n lev k solution -> if n == id then Some c else cell id rest
  find-cell :: Nat -> Store -> Option Cell
  find-cell id st = case st of MkStore label next level cells errors numbers in-law depth -> cell id cells
  replace-cell :: Cell -> List Cell -> List Cell
  replace-cell replacement cells = case replacement of
    MkCell id lev k solution -> case cells of
      Nil -> Cons replacement Nil
      Cons c rest -> case c of MkCell n l kind old -> if id == n then Cons replacement rest else Cons c (replace-cell replacement rest)
  put-cell :: Cell -> Store -> Store
  put-cell c st = case st of MkStore label next level cells errors numbers in-law depth -> MkStore label next level (replace-cell c cells) errors numbers in-law depth

  arrow-constructor-kind :: Kind
  arrow-constructor-kind = KFun KType (KFun KType KType)
  arrow-constructor :: UType
  arrow-constructor = UCon "(->)" arrow-constructor-kind
  -- The partial application is a constructor. Once saturated it is the
  -- same checked pure arrow used by ordinary function signatures.
  type-application :: UType -> UType -> UType
  type-application head argument = case head of
    UApp (UCon name (KFun KType (KFun KType KType))) domain ->
      if same-tag name "(->)" then UFun domain argument else UApp head argument
    other -> UApp head argument
  refinement-formals :: List Nat -> List Quant
  refinement-formals ids = case ids of
    Nil -> Nil
    Cons id rest -> Cons (MkQuant id "#refinement-parameter" KType False) (refinement-formals rest)
  former-kind :: List Nat -> Kind
  former-kind ids = case ids of Nil -> KType; Cons id rest -> KFun KType (former-kind rest)
  former-spine :: UType -> List UType -> (UType, List UType)
  former-spine ty args = case ty of UApp head value -> former-spine head (Cons value args); other -> (ty, args)
  former-substitution :: List Nat -> List UType -> List (Nat, UType)
  former-substitution ids args = case (ids, args) of
    (Cons id more, Cons actual rest) -> Cons (id, actual) (former-substitution more rest)
    other -> Nil
  -- Opening the structural view is explicit. Inference and export keep the
  -- original application so that matching a higher-kinded parameter can
  -- recover the checked former and its actual arguments.
  former-witnesses :: List Nat -> Nat -> List UType
  former-witnesses ids next = case ids of
    Nil -> Nil
    Cons id rest -> Cons (UBound next "#refinement-parameter" KType) (former-witnesses rest (next + 1))
  refinement-view :: UType -> UType
  refinement-view ty = case former-spine ty Nil of
    (URefineFormer name ids body, args) ->
      if list-length ids == list-length args then substitute (former-substitution ids args) body else ty
    other -> ty
  normalize :: Store -> UType -> UType
  normalize st ty = case ty of
    UPropLit value -> UPropLit value
    UCompare relation left right -> UCompare relation (normalize st left) (normalize st right)
    UPropAnd left right -> UPropAnd (normalize st left) (normalize st right)
    UPropOr left right -> UPropOr (normalize st left) (normalize st right)
    UPropNot body -> UPropNot (normalize st body)
    UPropNonZero body -> UPropNonZero (normalize st body)
    UPropNotNull body -> UPropNotNull (normalize st body)
    UPropAscii body -> UPropAscii (normalize st body)
    UPropOrdered body -> UPropOrdered (normalize st body)
    UPropNonZeroPending body -> normalize-pending-nonzero (normalize st body)
    URequire predicates body -> URequire (normalize st predicates) (normalize st body)
    URefine id name carrier predicate -> URefine id name (normalize st carrier) (normalize st predicate)
    UIndexForget value -> UIndexForget (normalize st value)
    UIndexByteLength value -> UIndexByteLength (normalize st value)
    UIndexBorrowRead value -> UIndexBorrowRead (normalize st value)
    UIndexList element fields -> UIndexList (normalize st element) (normalize st fields)
    UIndexCall function args -> UIndexCall function (normalize st args)
    UIndexPromote value -> normalize-promoted-index (normalize st value)
    UIndexMath op left right -> make-index-math op (normalize st left) (normalize st right)
    UMeta id k -> case find-cell id st of
      Some (MkCell n lev kind (Some solved)) -> normalize st solved
      Some (MkCell n lev kind None) -> normalized-variable st (UMeta id kind)
      None -> normalized-variable st ty
    UCon name k -> normalized-variable st ty
    UBound id name k -> normalized-variable st ty
    URigid id name level k -> normalized-variable st ty
    UIndex carrier value -> normalize-value-index st (normalize st carrier) value
    UPi id name domain row result -> UPi id name (normalize st domain) (normalize st row) (normalize st result)
    UApp f x -> type-application (normalize st f) (normalize st x)
    UFun a b -> UFun (normalize st a) (normalize st b)
    UFunEff a row b -> UFunEff (normalize st a) (normalize st row) (normalize st b)
    UUsageArrow usage arrow -> UUsageArrow usage (normalize st arrow)
    UProofFun a row b -> UProofFun (normalize st a) (normalize st row) (normalize st b)
    URow labels -> URow (unique-effects (normalize st labels))
    URowJoin a b -> union-effects (normalize st a) (normalize st b)
    UTuple xs -> UTuple (normalize st xs)
    UForall qs body -> UForall qs (normalize st body)
    UArg x rest -> UArg (normalize st x) (normalize st rest)
    other -> ty

  normalized-variable :: Store -> UType -> UType
  normalized-variable st ty = case ty of
    UCon name k -> let kind = normalize-kind st k in (case value-carrier kind of Some carrier -> UIndex carrier (IGlobal name); None -> UCon name kind)
    UMeta id k -> let kind = normalize-kind st k in (case value-carrier kind of Some carrier -> UIndex carrier (IMeta id); None -> UMeta id kind)
    UBound id name k -> let kind = normalize-kind st k in (case value-carrier kind of Some carrier -> UIndex carrier (IBound id name); None -> UBound id name kind)
    URigid id name level k -> let kind = normalize-kind st k in (case value-carrier kind of Some carrier -> UIndex carrier (IRigid id name level); None -> URigid id name level kind)
    other -> ty
  index-of-type :: UType -> Option IndexTerm
  index-of-type ty = case ty of
    UIndexCall function args -> None
    UIndexByteLength value -> case index-of-type value of Some input -> Some (IApply (IGlobal "<intrinsic>.bytes-length") input); None -> None
    UIndex carrier value -> Some value
    UMeta id k -> case value-carrier k of Some carrier -> Some (IMeta id); None -> None
    UBound id name k -> case value-carrier k of Some carrier -> Some (IBound id name); None -> None
    URigid id name level k -> case value-carrier k of Some carrier -> Some (IRigid id name level); None -> None
    UCon name k -> case value-carrier k of Some carrier -> Some (IGlobal name); None -> None
    other -> None
  resolve-index :: Store -> IndexTerm -> IndexTerm
  resolve-index st value = substitute-index-metas (index-solutions st (index-free-metas value)) value
  index-solutions :: Store -> List Nat -> List (Nat, IndexTerm)
  index-solutions st ids = case ids of
    Nil -> Nil
    Cons id rest -> case find-cell id st of
      Some (MkCell key level kind (Some solution)) -> case index-of-type (normalize st solution) of
        Some value -> Cons (id, value) (index-solutions st rest)
        None -> index-solutions st rest
      other -> index-solutions st rest

  type-kind :: UType -> Kind
  type-kind ty = case ty of
    UPropLit value -> KProp
    UCompare relation left right -> KProp
    UPropAnd left right -> KProp
    UPropOr left right -> KProp
    UPropNot body -> KProp
    UPropNonZero body -> KProp
    UPropNotNull body -> KProp
    UPropAscii body -> KProp
    UPropOrdered body -> KProp
    UPropNonZeroPending body -> KProp
    URequire predicates body -> KType
    URefine id name carrier predicate -> KType
    URefineFormer name ids body -> former-kind ids
    UCon n k -> k
    UBound n name k -> k
    URigid n name lev k -> k
    UMeta n k -> k
    UIndex carrier value -> value-kind carrier
    UIndexForget value -> case typed-index-carrier value of
      Some refined -> case refinement-view refined of URefine id name carrier predicate -> value-kind carrier; other -> KType
      None -> KType
    UIndexByteLength value -> value-kind (UCon "Nat" KType)
    UIndexBorrowRead value -> (case borrow-index-parts value of
      Some (mutable, region, carrier) -> value-kind carrier
      None -> KType)
    UIndexList element fields -> value-kind (core-list-type element)
    UIndexCall function args -> value-kind (UCon (total-result function) KType)
    UIndexPromote value -> value-kind (UCon "Int" KType)
    UIndexMath op left right -> case typed-index-carrier left of Some carrier -> value-kind carrier; None -> KType
    UApp f x -> case type-kind f of KFun a b -> b; other -> KType
    -- A dependent function is a proposition exactly when its result is one,
    -- so a proof former's kind agrees with the goal it produces.
    UPi id name domain row result -> type-kind result
    URow labels -> KRow
    URowJoin a b -> KRow
    other -> KType

  -- A formal type parameter may carry NonZero before its numeric
  -- carrier is known. This node is never a mathematical proposition in
  -- the proof reifier. Specialization must validate the concrete carrier.
  pending-nonzero-carrier :: UType -> Bool
  pending-nonzero-carrier carrier = case refinement-view carrier of
    UBound id name kind -> kind-equal kind KType
    URigid id name level kind -> kind-equal kind KType
    UMeta id kind -> kind-equal kind KType
    URefine id name base predicate -> valid-type carrier && pending-nonzero-carrier base
    other -> mathematical-carrier carrier || promotable-carrier carrier
  normalize-pending-nonzero :: UType -> UType
  normalize-pending-nonzero value = case typed-index-carrier value of
    Some carrier -> if mathematical-carrier carrier then UPropNonZero value
      else if promotable-carrier carrier then UPropNonZero (normalize-promoted-index value)
      else (case refinement-view carrier of
        URefine id name base predicate -> if valid-type value then normalize-pending-nonzero (UIndexForget value) else UPropNonZeroPending value
        other -> UPropNonZeroPending value)
    None -> UPropNonZeroPending value
  core-list-type :: UType -> UType
  core-list-type element = UApp (UCon (global-data-core-list) (KFun KType KType)) element
  core-list-element :: UType -> Option UType
  core-list-element carrier = case carrier of
    UApp (UCon name (KFun KType KType)) element ->
      if same-tag name (global-data-core-list) && carrier-type element then Some element else None
    other -> None
  not-null-carrier :: UType -> Bool
  not-null-carrier carrier = case core-list-element carrier of Some element -> True; None -> False
  -- `Ascii` decides text and lists of chars: a `String` carrier, or a list
  -- whose element is `Char`. `Ordered` decides lists of numerics.
  ascii-carrier :: UType -> Bool
  ascii-carrier carrier = case carrier of
    UCon name KType -> same-tag name "String"
    other -> case core-list-element carrier of
      Some element -> same-shape element (UCon "Char" KType)
      None -> False
  ordered-carrier :: UType -> Bool
  ordered-carrier carrier = case core-list-element carrier of
    Some element -> mathematical-carrier element || promotable-carrier element
    None -> False
  list-index-field :: UType -> UType -> Bool
  list-index-field expected value = typed-index-admissible value &&
    (case typed-index-carrier value of Some actual -> carrier-equal expected actual; None -> False)
  list-index-fields :: UType -> UType -> Bool
  list-index-fields element fields = case fields of
    UEnd -> True
    UArg first rest -> list-index-field element first && list-index-field (core-list-type element) rest
    other -> False
  valid-type :: UType -> Bool
  valid-type ty = case ty of
    UPropLit value -> True
    UCompare relation left right -> valid-comparison relation left right
    UPropAnd left right -> proposition-type left && proposition-type right
    UPropOr left right -> proposition-type left && proposition-type right
    UPropNot body -> proposition-type body
    UPropNonZero body -> valid-type body && (case typed-index-carrier body of Some carrier -> mathematical-carrier carrier; None -> False)
    UPropNonZeroPending body -> valid-type body && typed-index-admissible body && (case typed-index-carrier body of Some carrier -> pending-nonzero-carrier carrier; None -> False)
    UPropNotNull body -> typed-index-admissible body && (case typed-index-carrier body of
      Some carrier -> not-null-carrier carrier
      None -> False)
    UPropAscii body -> typed-index-admissible body && (case typed-index-carrier body of
      Some carrier -> ascii-carrier carrier
      None -> False)
    UPropOrdered body -> typed-index-admissible body && (case typed-index-carrier body of
      Some carrier -> ordered-carrier carrier
      None -> False)
    URequire predicates body -> proposition-spine predicates && carrier-type body
    URefine id name carrier predicate -> valid-refinement id carrier predicate
    URefineFormer name ids body -> string-length name > 0 && list-length ids > 0
      && distinct-former-ids ids && (case body of
        URefine id binder carrier predicate -> valid-type body && former-scope (type-free-bound body) ids
        other -> False)
    UError -> False
    UCon name kind -> valid-kind kind
    UBound id name kind -> valid-kind kind
    URigid id name level kind -> valid-kind kind
    UMeta id kind -> valid-kind kind
    UIndex carrier value -> carrier-type carrier && index-shape carrier value
    UIndexForget value -> valid-type value && (case typed-index-carrier value of
      Some refined -> case refinement-view refined of URefine id name carrier predicate -> carrier-type carrier; other -> False
      None -> False)
    UIndexByteLength value -> valid-type value && (case typed-index-carrier value of Some carrier -> same-shape carrier (UCon "Bytes" KType); None -> False)
    UIndexBorrowRead value -> valid-type value && (case borrow-index-parts value of
      Some (mutable, region, carrier) -> integer-carrier carrier
      None -> False)
    UIndexList element fields -> carrier-type element && list-index-fields element fields
    UIndexCall function args -> total-call-arguments (total-parameters function) args
    UIndexPromote value -> valid-type value && (case typed-index-carrier value of Some carrier -> promotable-carrier carrier; None -> False)
    UIndexMath op left right -> valid-typed-math op left right
    -- A dependent function's result is whatever its codomain is: a value
    -- carrier for `(n :: Nat) -> Vec n Int`, and a proposition for a proof
    -- former such as `(value :: Bool) -> Eq value value`. Requiring a value
    -- carrier here refused every dependent function whose result is a goal.
    UPi id name domain row result -> not (contains-id id (type-free-bound domain)) && carrier-type domain && valid-type row && kind-equal (type-kind row) KRow
      && (carrier-type result || proposition-type result)
    UApp f x -> valid-type f && valid-type x && (case type-kind f of KFun a b -> kind-equal a (type-kind x); other -> False)
    UFun a b -> valid-type a && valid-type b && kind-equal (type-kind a) KType && kind-equal (type-kind b) KType
    UForall qs body -> list-length qs > 0 && valid-type body && kind-equal (type-kind body) KType
    UFunEff a row b -> valid-type a && valid-type row && valid-type b && kind-equal (type-kind a) KType && kind-equal (type-kind row) KRow && kind-equal (type-kind b) KType
    UUsageArrow usage arrow -> computational-arrow arrow && not (later-unrestricted usage arrow) && valid-type arrow
    UProofFun predicate row result -> proposition-type predicate && valid-type row && kind-equal (type-kind row) KRow && carrier-type result
    URow labels -> valid-effects labels
    URowJoin a b -> valid-type a && valid-type b && kind-equal (type-kind a) KRow && kind-equal (type-kind b) KRow
    UTuple xs -> valid-value-fields xs
    UArg x rest -> valid-type x && valid-type rest
    other -> True

  distinct-former-ids :: List Nat -> Bool
  distinct-former-ids ids = case ids of Nil -> True; Cons id rest -> not (contains-id id rest) && distinct-former-ids rest
  former-scope :: List Nat -> List Nat -> Bool
  former-scope free bound = case free of Nil -> True; Cons id rest -> contains-id id bound && former-scope rest bound
  valid-refinement :: Nat -> UType -> UType -> Bool
  valid-refinement id carrier predicate = carrier-type carrier && not (contains-id id (type-free-bound carrier))
    && proposition-type predicate
    && proposition-type (substitute [(id, UBound id "#refined" (value-kind carrier))] predicate)

  proposition-type :: UType -> Bool
  proposition-type ty = valid-type ty && kind-equal (type-kind ty) KProp
  proposition-spine :: UType -> Bool
  proposition-spine predicates = case predicates of UEnd -> True; UArg first rest -> proposition-type first && proposition-spine rest; other -> False
  -- Nested, not a pair scrutinee: this is one of the hottest predicates on
  -- the checking path and the pair was 1.2 M blocks per toolkit check.
  valid-comparison :: String -> UType -> UType -> Bool
  valid-comparison relation left right = case typed-index-carrier left of
    Some a -> case typed-index-carrier right of
      Some b -> valid-type left && valid-type right && carrier-equal a b &&
        (if same-tag relation "Eq" || same-tag relation "==" || same-tag relation "/=" then True
         else mathematical-carrier a && (same-tag relation "<" || same-tag relation "<=" || same-tag relation ">" || same-tag relation ">="))
      other -> False
    other -> False

  valid-value-fields :: UType -> Bool
  valid-value-fields fields = case fields of
    UEnd -> True
    UArg value rest -> valid-type value && kind-equal (type-kind value) KType && valid-value-fields rest
    other -> False

  type-text :: UType -> String
  type-text ty = case ty of
    UPropLit value -> if value then "True#Prop" else "False#Prop"
    UCompare relation left right -> if same-tag relation "Eq" then
      string-concat-all ["(Eq ", type-text left, " ", type-text right, ")"]
      else string-concat-all ["(", type-text left, " ", relation, " ", type-text right, ")"]
    UPropAnd left right -> string-concat-all ["(", type-text left, " && ", type-text right, ")"]
    UPropOr left right -> string-concat-all ["(", type-text left, " || ", type-text right, ")"]
    UPropNot body -> string-concat "not " (type-text body)
    UPropNonZero body -> string-concat "NonZero " (type-text body)
    UPropNotNull body -> string-concat "NotNull " (type-text body)
    UPropAscii body -> string-concat "Ascii " (type-text body)
    UPropOrdered body -> string-concat "Ordered " (type-text body)
    UPropNonZeroPending body -> string-concat "NonZero " (type-text body)
    URequire predicates body -> string-concat-all ["required ", type-text predicates, " => ", type-text body]
    URefine id name carrier predicate -> string-concat-all ["refine (", name, " :: ", type-text carrier, ") with ", type-text predicate]
    URefineFormer name ids body -> name
    UCon name k -> name
    UBound id name k -> name
    URigid id name lev k -> name
    UMeta id k -> string-concat "?" (nat-to-string id)
    UIndex carrier value -> index-display value
    UIndexForget value -> string-concat "forget-index " (type-text value)
    UIndexByteLength value -> string-concat "bytes-length-index " (type-text value)
    UIndexBorrowRead value -> string-concat "copyOut " (type-text value)
    UIndexList element fields -> case fields of
      UEnd -> "Nil"
      UArg first rest -> string-concat-all ["(Cons ", type-text first, " ", type-text rest, ")"]
      other -> "<invalid list index>"
    UIndexCall function args -> string-concat-all ["checked-call ", total-identity function, " ", type-text args]
    UIndexPromote value -> string-concat "integer-index " (type-text value)
    UIndexMath op left right -> string-concat-all ["(", type-text left, " ", op, " ", type-text right, ")"]
    UPi id name domain row result -> string-concat-all ["((", name, " :: ", type-text domain, ") ->", type-text row, " ", type-text result, ")"]
    UApp f x -> string-concat-all ["(", type-text f, " ", type-text x, ")"]
    UFun a b -> string-concat-all ["(", type-text a, " -> ", type-text b, ")"]
    UFunEff a row b -> string-concat-all ["(", type-text a, " ->", type-text row, " ", type-text b, ")"]
    UUsageArrow usage arrow -> let marker = arrow-usage-text usage in case arrow of
      UFun a b -> string-concat-all ["(", type-text a, " ", marker, " -> ", type-text b, ")"]
      UFunEff a row b -> string-concat-all ["(", type-text a, " ", marker, " ->", type-text row, " ", type-text b, ")"]
      UPi id name domain row result -> string-concat-all ["((", name, " :: ", type-text domain, ") ", marker, " ->", type-text row, " ", type-text result, ")"]
      other -> "<invalid usage-annotated arrow>"
    UProofFun predicate row result -> string-concat-all ["(erased ", type-text predicate, " ->", type-text row, " ", type-text result, ")"]
    URow labels -> string-concat-all ["{", type-text labels, "}"]
    URowJoin a b -> string-concat-all ["(", type-text a, " union ", type-text b, ")"]
    UTuple xs -> string-concat-all ["(", type-text xs, ")"]
    UForall qs body -> string-concat-all ["(forall", quant-names-text qs, ". ", type-text body, ")"]
    UArg x UEnd -> type-text x
    UArg x rest -> string-concat-all [type-text x, ", ", type-text rest]
    UEnd -> ""
    UError -> "_"

  contains-id :: Nat -> List Nat -> Bool
  contains-id id ids = case ids of Nil -> False; Cons n rest -> id == n || contains-id id rest
  merge-ids :: List Nat -> List Nat -> List Nat
  merge-ids xs ys = case xs of Nil -> ys; Cons n rest -> merge-ids rest (if contains-id n ys then ys else Cons n ys)
  free-metas :: Store -> UType -> List Nat
  free-metas st ty = case normalize st ty of
    UPropLit value -> Nil
    UCompare relation left right -> merge-ids (free-metas st left) (free-metas st right)
    UPropAnd left right -> merge-ids (free-metas st left) (free-metas st right)
    UPropOr left right -> merge-ids (free-metas st left) (free-metas st right)
    UPropNot body -> free-metas st body
    UPropNonZero body -> free-metas st body
    UPropNotNull body -> free-metas st body
    UPropAscii body -> free-metas st body
    UPropOrdered body -> free-metas st body
    UPropNonZeroPending body -> free-metas st body
    URequire predicates body -> merge-ids (free-metas st predicates) (free-metas st body)
    URefine id name carrier predicate -> merge-ids (free-metas st carrier) (free-metas st predicate)
    URefineFormer name ids body -> free-metas st body
    UMeta id k -> merge-ids [id] (kind-metas st k)
    UCon name k -> kind-metas st k
    UBound id name k -> kind-metas st k
    URigid id name level k -> kind-metas st k
    UIndexForget value -> free-metas st value
    UIndexByteLength value -> free-metas st value
    UIndexBorrowRead value -> free-metas st value
    UIndexList element fields -> merge-ids (free-metas st element) (free-metas st fields)
    UIndexCall function args -> free-metas st args
    UIndexPromote value -> free-metas st value
    UIndexMath op left right -> merge-ids (free-metas st left) (free-metas st right)
    UIndex carrier value -> merge-ids (free-metas st carrier) (index-free-metas value)
    UPi id name domain row result -> merge-ids (free-metas st domain) (merge-ids (free-metas st row) (free-metas st result))
    UApp f x -> merge-ids (free-metas st f) (free-metas st x)
    UFun a b -> merge-ids (free-metas st a) (free-metas st b)
    UFunEff a row b -> merge-ids (free-metas st a) (merge-ids (free-metas st row) (free-metas st b))
    UUsageArrow usage arrow -> free-metas st arrow
    UProofFun a row b -> merge-ids (free-metas st a) (merge-ids (free-metas st row) (free-metas st b))
    URow labels -> free-metas st labels
    URowJoin a b -> merge-ids (free-metas st a) (free-metas st b)
    UTuple xs -> free-metas st xs
    UForall qs body -> merge-ids (quant-metas st qs) (free-metas st body)
    UArg x rest -> merge-ids (free-metas st x) (free-metas st rest)
    other -> Nil
  kind-metas :: Store -> Kind -> List Nat
  kind-metas st kind = case kind of
    KValue payload -> case value-carrier kind of Some carrier -> free-metas st carrier; None -> Nil
    KFun a b -> merge-ids (kind-metas st a) (kind-metas st b)
    other -> Nil
  quant-metas :: Store -> List Quant -> List Nat
  quant-metas st qs = case qs of Nil -> Nil; Cons q rest -> merge-ids (kind-metas st (quant-kind q)) (quant-metas st rest)
  scheme-metas :: Store -> Scheme -> List Nat
  scheme-metas st sc = merge-ids (quant-metas st (scheme-params sc)) (merge-ids (free-metas st (scheme-body sc)) (requirement-metas st (scheme-requirements sc)))
  requirement-metas :: Store -> List Requirement -> List Nat
  requirement-metas st rs = case rs of Nil -> Nil; Cons r rest -> merge-ids (free-metas st (requirement-type r)) (requirement-metas st rest)

  -- Predicativity: whether a polytype occurs anywhere in a type. No
  -- metavariable solution may contain one.
  has-forall :: UType -> Bool
  has-forall ty = case ty of
    UForall qs body -> True
    UApp f x -> has-forall f || has-forall x
    UFun a b -> has-forall a || has-forall b
    UFunEff a row b -> has-forall a || has-forall b
    UProofFun a row b -> has-forall a || has-forall b
    UUsageArrow usage arrow -> has-forall arrow
    UPi id name domain row result -> has-forall domain || has-forall result
    UTuple xs -> has-forall xs
    UArg x rest -> has-forall x || has-forall rest
    URequire predicates body -> has-forall body
    URefine id name carrier predicate -> has-forall carrier
    other -> False
  -- Lower younger metavariables when they become part of an older one.
  -- A rigid variable from a deeper scope must never escape into it.
  escapes :: Nat -> UType -> Bool
  escapes level ty = case ty of
    UPropLit value -> False
    UCompare relation left right -> escapes level left || escapes level right
    UPropAnd left right -> escapes level left || escapes level right
    UPropOr left right -> escapes level left || escapes level right
    UPropNot body -> escapes level body
    UPropNonZero body -> escapes level body
    UPropNotNull body -> escapes level body
    UPropAscii body -> escapes level body
    UPropOrdered body -> escapes level body
    UPropNonZeroPending body -> escapes level body
    URequire predicates body -> escapes level predicates || escapes level body
    URefine id name carrier predicate -> escapes level carrier || escapes level predicate
    URefineFormer name ids body -> escapes level body
    URigid id name lev k -> lev > level || kind-escapes level k
    UCon name k -> kind-escapes level k
    UBound id name k -> kind-escapes level k
    UMeta id k -> kind-escapes level k
    UIndexForget value -> escapes level value
    UIndexByteLength value -> escapes level value
    UIndexBorrowRead value -> escapes level value
    UIndexList element fields -> escapes level element || escapes level fields
    UIndexCall function args -> escapes level args
    UIndexPromote value -> escapes level value
    UIndexMath op left right -> escapes level left || escapes level right
    UIndex carrier value -> escapes level carrier || index-escapes level value
    UPi id name domain row result -> escapes level domain || escapes level row || escapes level result
    UApp f x -> escapes level f || escapes level x
    UFun a b -> escapes level a || escapes level b
    UFunEff a row b -> escapes level a || escapes level row || escapes level b
    UUsageArrow usage arrow -> escapes level arrow
    UProofFun a row b -> escapes level a || escapes level row || escapes level b
    URow labels -> escapes level labels
    URowJoin a b -> escapes level a || escapes level b
    UTuple xs -> escapes level xs
    UForall qs body -> escapes level body
    UArg x rest -> escapes level x || escapes level rest
    other -> False
  kind-escapes :: Nat -> Kind -> Bool
  kind-escapes level kind = case kind of
    KValue payload -> case value-carrier kind of Some carrier -> escapes level carrier; None -> True
    KFun a b -> kind-escapes level a || kind-escapes level b
    other -> False
  lower :: Nat -> List Nat -> Store -> Store
  lower level ids st = case ids of
    Nil -> st
    Cons id rest -> case find-cell id st of
      Some (MkCell n lev k solution) -> lower level rest (if lev > level then put-cell (MkCell n level k solution) st else st)
      None -> lower level rest st

  bind-meta :: Span -> Nat -> Kind -> UType -> Store -> Store
  bind-meta sp id k ty st = case normalize st ty of
    UMeta n kind -> if id == n then (case find-cell id st of
      Some (MkCell key level declared solution) -> unify-kind sp k kind (unify-kind sp k declared st)
      None -> add-error sp "unknown inference variable" st)
      else bind-other sp id k (UMeta n kind) st
    other -> bind-other sp id k other st
  bind-other :: Span -> Nat -> Kind -> UType -> Store -> Store
  bind-other sp id k ty st = case find-cell id st of
    None -> add-error sp "unknown inference variable" st
    Some (MkCell n lev kind solution) ->
      let checked = unify-kind sp k (type-kind ty) (unify-kind sp k kind st) in
      let solution-type = normalize checked ty in
      if list-length (store-errors checked) > list-length (store-errors st) then checked
      else if not (valid-type solution-type) then add-error sp "invalid type in type inference" checked
      else if contains-id id (free-metas checked solution-type) then add-error sp "infinite type: inference variable occurs in its own solution" checked
      else if has-forall solution-type then add-error sp (string-concat "a type variable cannot stand for a polymorphic type; annotate the binding with its polymorphic type: " (display-type-text solution-type)) checked
      else if escapes lev solution-type then add-error sp "a quantified type variable escapes its scope" checked
      else put-cell (MkCell n lev (normalize-kind checked kind) (Some solution-type)) (lower lev (free-metas checked solution-type) checked)

  unify-kind :: Span -> Kind -> Kind -> Store -> Store
  unify-kind sp first second st =
    let a = normalize-kind st first in
    let b = normalize-kind st second in
    if not (valid-kind a && valid-kind b) then add-error sp "invalid kind in type inference" st
    else if kind-equal a b then st else case (a, b) of
      (KValue payload, KValue other) -> (case (value-carrier a, value-carrier b) of (Some carrier, Some right) -> unify sp carrier right st; other -> add-error sp "invalid value carrier" st)
      (KFun domain range, KFun input output) -> unify-kind sp range output (unify-kind sp domain input st)
      other -> add-error sp "kind mismatch in type inference" st

  unify :: Span -> UType -> UType -> Store -> Store
  unify sp first second st =
    let checked = validate-type-indices sp second (validate-type-indices sp first st) in
    let a = normalize checked first in
    let b = normalize checked second in
    if list-length (store-errors checked) > list-length (store-errors st) then checked
    else case a of
      UError -> checked
      UMeta id k -> bind-meta sp id k b checked
      UIndex carrier (IMeta id) -> if same-shape a b then checked else bind-meta sp id (value-kind carrier) b checked
      other -> case b of
        UError -> checked
        UMeta id k -> bind-meta sp id k a checked
        UIndex carrier (IMeta id) -> if same-shape a b then checked else bind-meta sp id (value-kind carrier) a checked
        other -> unify-structure sp a b checked
  mismatch :: Span -> UType -> UType -> Store -> Store
  mismatch sp a b st = add-deferred-error sp (\u -> mismatch-message a b) st
  mismatch-message :: UType -> UType -> String
  mismatch-message a b = string-concat-all ["type mismatch: expected ", display-type-text b, ", found ", display-type-text a]
  -- Diagnostic text only: every encoded nominal identity `i.` reads as the
  -- unqualified source name it encodes (Bootstrap.Nominal.decode-identity).
  -- type-text itself, and so every interface and IR spelling, keeps the
  -- encoded identity.
  display-type-text :: UType -> String
  display-type-text ty = readable-identities (type-text ty)
  readable-identities :: String -> String
  readable-identities text = pack (readable-chars True (unpack text))
  readable-chars :: Bool -> List Char -> List Char
  readable-chars boundary chars = case chars of
    Nil -> Nil
    Cons c rest -> if boundary && char-code c == 105 then
      (case rest of
        Cons dot more -> if char-code dot == 46 then
          (case decode-identity more of
            Some (name, after) -> unqualified (unpack name) Nil <> readable-chars False after
            None -> Cons c (readable-chars False rest))
          else Cons c (readable-chars False rest)
        Nil -> [c])
      else Cons c (readable-chars (not (identifier-char c)) rest)
  identifier-char :: Char -> Bool
  identifier-char c = let code = char-code c in
    (code >= 48 && code <= 57) || (code >= 65 && code <= 90) || (code >= 97 && code <= 122) || code == 45 || code == 95 || code == 46
  -- The last dotted segment, so `Data.String.String` reads `String`.
  unqualified :: List Char -> List Char -> List Char
  unqualified chars segment = case chars of
    Nil -> reverse segment
    Cons c rest -> if char-code c == 46 && list-length rest > 0 && list-length segment > 0 then unqualified rest Nil
      else unqualified rest (Cons c segment)
  -- The partial (->) constructor can represent an ordinary arrow only.
  -- An inferred row may be solved to empty before matching its application.
  unify-pure-arrow-application :: Span -> UType -> UType -> UType -> Store -> Store
  unify-pure-arrow-application sp application arrow effects st =
    let pure = unify sp effects (URow UEnd) st in
    if list-length (store-errors pure) > list-length (store-errors st) then pure
    else unify sp application arrow pure
  unify-structure :: Span -> UType -> UType -> Store -> Store
  unify-structure sp a b st = case a of
    UPropLit value -> case b of UPropLit other -> if (if value then other else not other) then st else mismatch sp a b st; other -> mismatch sp a b st
    UCompare relation left right -> case b of UCompare op x y -> if same-tag relation op then unify sp right y (unify sp left x st) else mismatch sp a b st; other -> mismatch sp a b st
    UPropAnd left right -> case b of UPropAnd x y -> unify sp right y (unify sp left x st); other -> mismatch sp a b st
    UPropOr left right -> case b of UPropOr x y -> unify sp right y (unify sp left x st); other -> mismatch sp a b st
    UPropNot body -> case b of UPropNot other -> unify sp body other st; other -> mismatch sp a b st
    UPropNonZero body -> case b of UPropNonZero other -> unify sp body other st; other -> mismatch sp a b st
    UPropNotNull body -> case b of UPropNotNull other -> unify sp body other st; other -> mismatch sp a b st
    UPropAscii body -> case b of UPropAscii other -> unify sp body other st; other -> mismatch sp a b st
    UPropOrdered body -> case b of UPropOrdered other -> unify sp body other st; other -> mismatch sp a b st
    UPropNonZeroPending body -> case b of UPropNonZeroPending other -> unify sp body other st; other -> mismatch sp a b st
    URequire predicates body -> case b of URequire ps result -> unify sp body result (unify sp predicates ps st); other -> mismatch sp a b st
    URefine id name carrier predicate -> case refinement-view b of
      URefine key other input condition -> if valid-type a && valid-type b then
        unify-pi sp (refinement-pi id name carrier predicate) (refinement-pi key other input condition) st
        else add-error sp "ill-formed refinement type" st
      other -> mismatch sp a b st
    URefineFormer name ids body -> if same-shape a b then st else mismatch sp a b st
    UIndexForget value -> case b of UIndexForget other -> unify sp value other st; other -> mismatch sp a b st
    UIndexByteLength value -> case b of UIndexByteLength other -> unify sp value other st; other -> mismatch sp a b st
    UIndexBorrowRead value -> case b of UIndexBorrowRead other -> unify sp value other st; other -> mismatch sp a b st
    UIndexList element fields -> case b of
      UIndexList other values -> unify sp fields values (unify sp element other st)
      other -> mismatch sp a b st
    UIndexCall function args -> case b of UIndexCall other values -> if total-function-equal function other then unify sp args values st else mismatch sp a b st; other -> mismatch sp a b st
    UIndexPromote value -> case b of UIndexPromote other -> unify sp value other st; other -> mismatch sp a b st
    UIndexMath op left right -> case b of UIndexMath operation a1 a2 -> if same-tag op operation then unify sp right a2 (unify sp left a1 st) else mismatch sp a b st; other -> mismatch sp a b st
    UPi id name domain row result -> unify-pi sp a (function-pi b) st
    UIndex carrier value -> case b of
      UIndex other right -> let checked = unify sp carrier other st in
        if list-length (store-errors checked) > list-length (store-errors st) then checked
        else unify-index sp (normalize checked carrier) (resolve-index checked value) (resolve-index checked right) checked
      other -> mismatch sp a b st
    UCon n k -> case b of UCon m l -> if string-compare n m == 0 then unify-kind sp k l st else mismatch sp a b st; other -> mismatch sp a b st
    UBound n name k -> case b of UBound m other l -> if n == m then unify-kind sp k l st else mismatch sp a b st; other -> mismatch sp a b st
    URigid n name lev k -> case b of URigid m other l kind -> if n == m then unify-kind sp k kind st else mismatch sp a b st; other -> mismatch sp a b st
    UApp f x -> if distinct-deferrals a b then
      add-error sp (string-concat (mismatch-message a b) " (Later and Thunk are distinct types)") st
      else (case (refinement-view a, refinement-view b) of
        (URefine id name carrier predicate, URefine key other input condition) -> unify sp (URefine id name carrier predicate) (URefine key other input condition) st
        other -> case b of
          UApp g y -> unify sp x y (unify sp f g st)
          UFun domain result -> unify sp x result (unify sp f (UApp arrow-constructor domain) st)
          UFunEff domain effects result -> unify-pure-arrow-application sp a (UFun domain result) effects st
          other -> mismatch sp a b st)
    UFun x y -> case b of
      UPi id name domain row result -> unify-pi sp (function-pi a) b st
      UFun u v -> unify sp y v (unify sp x u st)
      UFunEff u row v -> unify sp y v (unify sp x u (unify sp (URow UEnd) row st))
      UApp f result -> unify sp y result (unify sp (UApp arrow-constructor x) f st)
      other -> mismatch sp a b st
    UFunEff x row y -> case b of
      UPi id name domain effects result -> unify-pi sp (function-pi a) b st
      UFun u v -> unify sp y v (unify sp x u (unify sp row (URow UEnd) st))
      UFunEff u effects v -> unify sp y v (unify sp x u (unify sp row effects st))
      UApp f result -> unify-pure-arrow-application sp b (UFun x y) row st
      other -> mismatch sp a b st
    UUsageArrow usage arrow -> case b of
      UUsageArrow other-usage other-arrow -> if same-arrow-usage usage other-usage then unify sp arrow other-arrow st else mismatch sp a b st
      other -> mismatch sp a b st
    UProofFun predicate row result -> case b of
      UProofFun condition effects output -> unify sp result output (unify sp row effects (unify sp predicate condition st))
      other -> mismatch sp a b st
    URow labels -> case b of
      URow effects -> if valid-effects labels && valid-effects effects then
        (case match-effects sp True labels effects labels effects st of Some solved -> solved; None -> mismatch sp a b st)
        else add-error sp "malformed closed effect row" st
      other -> mismatch sp a b st
    URowJoin first second -> if valid-type a && valid-type b && kind-equal (type-kind b) KRow then
      unify-open-rows sp a b st
      else add-error sp "malformed open effect row" st
    UTuple xs -> case b of UTuple ys -> unify sp xs ys st; other -> mismatch sp a b st
    UForall qs x -> case b of UForall rs y -> unify-forall sp a b st; other -> mismatch sp a b st
    UArg x rest -> case b of UArg y tail -> unify sp rest tail (unify sp x y st); other -> mismatch sp a b st
    UEnd -> case b of UEnd -> st; other -> mismatch sp a b st
    other -> mismatch sp a b st

  -- Equal explicit labels can share a tail. Try that equation before
  -- inclusion, which requires the tail identities to be known already.
  unify-open-rows :: Span -> UType -> UType -> Store -> Store
  unify-open-rows sp a b st = case (a, b) of
    (URowJoin (URow left) tail, URowJoin (URow right) other-tail) ->
      let trial = unify sp tail other-tail (unify sp (URow left) (URow right) st) in
      if list-length (store-errors trial) == list-length (store-errors st) then trial
      else include-effects sp b a (include-effects sp a b st)
    other -> include-effects sp b a (include-effects sp a b st)

  -- Closed rows are sets, including when region variables later coincide.
  -- Search is transactional: a rejected label match cannot leave region
  -- assignments behind. The reverse pass checks equality rather than just
  -- inclusion; retaining candidates permits idempotent coalescing.
  effect-head :: UType -> Bool
  effect-head ty = case ty of UCon name kind -> True; UApp f x -> effect-head f; other -> False
  valid-effects :: UType -> Bool
  valid-effects labels = case labels of
    UEnd -> True
    UArg label rest -> effect-head label && valid-type label && kind-equal (type-kind label) KEffect && valid-effects rest
    other -> False
  -- A `case (x, y) of` scrutinee allocates the pair block before the arms
  -- run, and this function is called once per node of every kind equality,
  -- so the pair was 2.5 M blocks per toolkit check. The nested form below
  -- tests the same constructors in the same order and allocates nothing.
  same-shape :: UType -> UType -> Bool
  same-shape first second = case first of
    UPropLit a -> case second of UPropLit b -> if a then b else not b; other -> False
    UCompare rel a b -> case second of UCompare op c d -> same-tag rel op && same-shape a c && same-shape b d; other -> False
    UPropAnd a b -> case second of UPropAnd c d -> same-shape a c && same-shape b d; other -> False
    UPropOr a b -> case second of UPropOr c d -> same-shape a c && same-shape b d; other -> False
    UPropNot a -> case second of UPropNot b -> same-shape a b; other -> False
    UPropNonZero a -> case second of UPropNonZero b -> same-shape a b; other -> False
    UPropNotNull a -> case second of UPropNotNull b -> same-shape a b; other -> False
    UPropAscii a -> case second of UPropAscii b -> same-shape a b; other -> False
    UPropOrdered a -> case second of UPropOrdered b -> same-shape a b; other -> False
    UPropNonZeroPending a -> case second of UPropNonZeroPending b -> same-shape a b; other -> False
    URequire a b -> case second of URequire c d -> same-shape a c && same-shape b d; other -> False
    URefine id name carrier predicate -> case second of
      URefine key other input condition -> same-pi (refinement-pi id name carrier predicate) (refinement-pi key other input condition)
      other -> False
    URefineFormer name ids body -> case second of
      URefineFormer other keys template ->
        same-tag name other && list-length ids == list-length keys
          && (let start = largest-id (merge-ids (type-all-ids first) (type-all-ids second)) + 1 in
              let actuals = former-witnesses ids start in
              same-shape (substitute (former-substitution ids actuals) body)
                         (substitute (former-substitution keys actuals) template))
      other -> False
    UCon n k -> case second of UCon m l -> string-compare n m == 0 && kind-equal k l; other -> False
    UBound n name k -> case second of UBound m other l -> n == m && kind-equal k l; other -> False
    URigid n name level k -> case second of URigid m other outer l -> n == m && kind-equal k l; other -> False
    UMeta n k -> case second of UMeta m l -> n == m && kind-equal k l; other -> False
    UIndex carrier value -> case second of UIndex other right -> same-shape carrier other && index-equal value right; other -> False
    UIndexForget a -> case second of UIndexForget b -> same-shape a b; other -> False
    UIndexByteLength a -> case second of UIndexByteLength b -> same-shape a b; other -> False
    UIndexBorrowRead a -> case second of UIndexBorrowRead b -> same-shape a b; other -> False
    UIndexList element fields -> case second of UIndexList other values -> same-shape element other && same-shape fields values; other -> False
    UIndexCall function args -> case second of UIndexCall other values -> total-function-equal function other && same-shape args values; other -> False
    UIndexPromote a -> case second of UIndexPromote b -> same-shape a b; other -> False
    UIndexMath op a b -> case second of UIndexMath operation c d -> same-tag op operation && same-shape a c && same-shape b d; other -> False
    UPi id name domain row result -> case second of UPi key other input effects output -> same-pi first second; other -> False
    UApp f x -> case second of UApp g y -> same-shape f g && same-shape x y; other -> False
    UFun a b -> case second of UFun c d -> same-shape a c && same-shape b d; other -> False
    UFunEff a e b -> case second of UFunEff c f d -> same-shape a c && same-shape e f && same-shape b d; other -> False
    UUsageArrow usage a -> case second of UUsageArrow other b -> same-arrow-usage usage other && same-shape a b; other -> False
    UProofFun a e b -> case second of UProofFun c f d -> same-shape a c && same-shape e f && same-shape b d; other -> False
    URow a -> case second of URow b -> same-shape a b; other -> False
    URowJoin a b -> case second of URowJoin c d -> same-shape a c && same-shape b d; other -> False
    UTuple a -> case second of UTuple b -> same-shape a b; other -> False
    UForall qs a -> case second of
      UForall rs b -> list-length qs == list-length rs && same-quant-kinds qs rs && same-shape a (substitute (rename-quants rs qs) b)
      other -> False
    UArg a rest -> case second of UArg b more -> same-shape a b && same-shape rest more; other -> False
    UEnd -> case second of UEnd -> True; other -> False
    other -> False
  has-effect :: UType -> UType -> Bool
  has-effect label labels = case labels of UArg first rest -> same-shape label first || has-effect label rest; other -> False
  unique-effects :: UType -> UType
  unique-effects labels = case labels of
    UArg label rest -> let more = unique-effects rest in if has-effect label more then more else UArg label more
    other -> labels
  match-effects :: Span -> Bool -> UType -> UType -> UType -> UType -> Store -> Option Store
  match-effects sp reverse-pass remaining candidates original-left original-right st = case normalize st remaining of
    UEnd -> if reverse-pass then match-effects sp False original-right original-left UEnd UEnd st else Some st
    UArg label rest -> match-effect-candidates sp reverse-pass label rest candidates candidates original-left original-right st
    other -> None
  match-effect-candidates :: Span -> Bool -> UType -> UType -> UType -> UType -> UType -> UType -> Store -> Option Store
  match-effect-candidates sp reverse-pass label rest remaining all original-left original-right st = case normalize st remaining of
    UArg candidate more ->
      let trial = unify sp label candidate st in
      let result = if list-length (store-errors trial) == list-length (store-errors st) then
            match-effects sp reverse-pass rest all original-left original-right trial else None in
      case result of
        Some solved -> Some solved
        None -> match-effect-candidates sp reverse-pass label rest more all original-left original-right st
    other -> None
  append-effects :: UType -> UType -> UType
  append-effects first second = case first of UEnd -> second; UArg label rest -> UArg label (append-effects rest second); other -> UError
  -- Keep every known label together, independently of join association.
  -- Abstract tails retain their identities; no label is assumed to be in one.
  row-tail-present :: UType -> List UType -> Bool
  row-tail-present row tails = case tails of Nil -> False; Cons first rest -> same-shape row first || row-tail-present row rest
  merge-row-tails :: List UType -> List UType -> List UType
  merge-row-tails first second = case second of
    Nil -> first
    Cons tail rest -> merge-row-tails (if row-tail-present tail first then first else first <> [tail]) rest
  effect-row-parts :: UType -> (UType, List UType)
  effect-row-parts row = case row of
    URow labels -> (labels, Nil)
    URowJoin a b -> case (effect-row-parts a, effect-row-parts b) of
      ((first, left), (second, right)) -> (append-effects first second, merge-row-tails left right)
    other -> (UEnd, [other])
  joined-row-tails :: List UType -> UType
  joined-row-tails tails = case tails of Nil -> URow UEnd; Cons first Nil -> first; Cons first rest -> URowJoin first (joined-row-tails rest)
  union-effects :: UType -> UType -> UType
  union-effects first second = case (effect-row-parts first, effect-row-parts second) of
    ((a, left), (b, right)) -> let labels = unique-effects (append-effects a b) in let tails = merge-row-tails left right in
      case labels of
        UEnd -> joined-row-tails tails
        other -> case tails of Nil -> URow labels; more -> URowJoin (URow labels) (joined-row-tails tails)
  include-effects :: Span -> UType -> UType -> Store -> Store
  include-effects sp actual allowed st =
    let a = normalize st actual in
    let b = normalize st allowed in
    if not (valid-type a && valid-type b && kind-equal (type-kind a) KRow && kind-equal (type-kind b) KRow) then add-error sp "malformed effect row" st
    else if same-shape a b then st else include-effect-rows sp a b st
  include-effect-rows :: Span -> UType -> UType -> Store -> Store
  include-effect-rows sp actual allowed st = case (actual, allowed) of
    (URow UEnd, other) -> st
    (URow labels, URow permitted) -> (case match-effects sp False labels permitted UEnd UEnd st of
      Some solved -> solved
      None -> add-error sp (string-concat-all ["effect rows do not match: performed effects exceed the declared row (performed ", type-text actual, ", declared ", type-text allowed, ")"]) st)
    (URowJoin first second, other) -> include-effects sp second allowed (include-effects sp first allowed st)
    (other, URowJoin first second) ->
      let trial = include-effects sp actual first st in
      if list-length (store-errors trial) == list-length (store-errors st) then trial
      else include-effects sp actual second st
    other -> add-error sp "effect inclusion needs resolved rows" st

  mapped :: Nat -> List (Nat, UType) -> Option UType
  mapped id pairs = case pairs of Nil -> None; Cons (n, ty) rest -> if id == n then Some ty else mapped id rest
  data TypeSubstitution where
    ReplaceBound :: TypeSubstitution
    ReplaceMeta :: TypeSubstitution
    ReplaceRigid :: TypeSubstitution

  substitute :: List (Nat, UType) -> UType -> UType
  substitute pairs ty = transform-type ReplaceBound pairs ty
  replace-metas :: List (Nat, UType) -> UType -> UType
  replace-metas pairs ty = transform-type ReplaceMeta pairs ty
  -- The rigid opening of a term annotation has only non-value parameters.
  substitute-rigid-types :: List (Nat, UType) -> UType -> UType
  substitute-rigid-types pairs ty = transform-type ReplaceRigid pairs ty

  transform-type :: TypeSubstitution -> List (Nat, UType) -> UType -> UType
  transform-type mode pairs ty = case ty of
    UPropLit value -> UPropLit value
    UCompare relation left right -> UCompare relation (transform-type mode pairs left) (transform-type mode pairs right)
    UPropAnd left right -> UPropAnd (transform-type mode pairs left) (transform-type mode pairs right)
    UPropOr left right -> UPropOr (transform-type mode pairs left) (transform-type mode pairs right)
    UPropNot body -> UPropNot (transform-type mode pairs body)
    UPropNonZero body -> UPropNonZero (transform-type mode pairs body)
    UPropNotNull body -> UPropNotNull (transform-type mode pairs body)
    UPropAscii body -> UPropAscii (transform-type mode pairs body)
    UPropOrdered body -> UPropOrdered (transform-type mode pairs body)
    UPropNonZeroPending body -> normalize-pending-nonzero (transform-type mode pairs body)
    URequire predicates body -> URequire (transform-type mode pairs predicates) (transform-type mode pairs body)
    URefine id name carrier predicate -> substitute-refinement mode pairs id name carrier predicate
    UIndexForget value -> UIndexForget (transform-type mode pairs value)
    UIndexByteLength value -> UIndexByteLength (transform-type mode pairs value)
    UIndexBorrowRead value -> UIndexBorrowRead (transform-type mode pairs value)
    UIndexList element fields -> UIndexList (transform-type mode pairs element) (transform-type mode pairs fields)
    UIndexCall function args -> UIndexCall function (transform-type mode pairs args)
    UIndexPromote value -> UIndexPromote (transform-type mode pairs value)
    UIndexMath op left right -> make-index-math op (transform-type mode pairs left) (transform-type mode pairs right)
    UPi id name domain row result -> substitute-pi mode pairs id name domain row result
    UIndex carrier value ->
      let changed = transform-type mode pairs carrier in
      (case mode of
        ReplaceBound -> substitute-value-index False pairs changed value
        ReplaceMeta -> substitute-value-index True pairs changed value
        ReplaceRigid -> UIndex changed value)
    UBound id name k -> case (case mode of ReplaceBound -> mapped id pairs; other -> None) of
      Some replacement -> replacement
      None -> UBound id name (transform-kind mode pairs k)
    UCon name k -> UCon name (transform-kind mode pairs k)
    URigid id name level k -> case (case mode of ReplaceRigid -> mapped id pairs; other -> None) of
      Some replacement -> replacement
      None -> URigid id name level (transform-kind mode pairs k)
    UMeta id k -> case (case mode of ReplaceMeta -> mapped id pairs; other -> None) of
      Some replacement -> replacement
      None -> UMeta id (transform-kind mode pairs k)
    UApp f x -> type-application (transform-type mode pairs f) (transform-type mode pairs x)
    UFun a b -> UFun (transform-type mode pairs a) (transform-type mode pairs b)
    UFunEff a row b -> UFunEff (transform-type mode pairs a) (transform-type mode pairs row) (transform-type mode pairs b)
    UUsageArrow usage arrow -> UUsageArrow usage (transform-type mode pairs arrow)
    UProofFun a row b -> UProofFun (transform-type mode pairs a) (transform-type mode pairs row) (transform-type mode pairs b)
    URow labels -> URow (transform-type mode pairs labels)
    URowJoin a b -> union-effects (transform-type mode pairs a) (transform-type mode pairs b)
    UTuple xs -> UTuple (transform-type mode pairs xs)
    -- A polytype's own binders shadow a bound-variable substitution.
    UForall qs body -> UForall (map-quant-kinds (transform-type mode pairs) qs)
      (transform-type mode (case mode of ReplaceBound -> without-type-pairs (quant-id-list qs) pairs; other -> pairs) body)
    UArg x rest -> UArg (transform-type mode pairs x) (transform-type mode pairs rest)
    other -> ty
  -- `transform-type` over a kind: the kind arms of the map, direct rather
  -- than through `map-kind-types (transform-type mode pairs)`, which built a
  -- closure at every `UCon`/`UBound`/`URigid`/`UMeta` node.
  transform-kind :: TypeSubstitution -> List (Nat, UType) -> Kind -> Kind
  transform-kind mode pairs kind = case kind of
    KValue payload -> case value-carrier kind of Some carrier -> value-kind (transform-type mode pairs carrier); None -> kind
    KFun a b -> KFun (transform-kind mode pairs a) (transform-kind mode pairs b)
    other -> kind
  substitute-bound :: List (Nat, UType) -> UType -> UType
  substitute-bound pairs ty = substitute pairs ty
  instantiate-params :: Bool -> List Quant -> Store -> (List (Nat, UType), Store)
  instantiate-params rigid qs st = instantiate-ordered rigid qs Nil st
  instantiate-ordered :: Bool -> List Quant -> List (Nat, UType) -> Store -> (List (Nat, UType), Store)
  instantiate-ordered rigid qs earlier st = case qs of
    Nil -> (Nil, st)
    Cons q rest -> case st of
      MkStore label next level cells errors numbers in-law depth ->
        let kind = map-kind-types (substitute earlier) (quant-kind q) in
        let (ty, next-store) = if rigid then (URigid next (quant-name q) level kind, MkStore label (next + 1) level cells errors numbers in-law depth) else fresh-meta kind st in
        case instantiate-ordered rigid rest (Cons (quant-id q, ty) earlier) next-store of
          (pairs, final-store) -> (Cons (quant-id q, ty) pairs, final-store)
  instantiate :: Scheme -> Store -> (UType, Store)
  instantiate sc st = case open-scheme False sc st of (ty, pairs, next-store) -> (ty, next-store)
  skolemize :: Scheme -> Store -> (UType, Store)
  skolemize sc st = case open-scheme True sc st of (ty, pairs, next-store) -> (ty, next-store)
  open-scheme :: Bool -> Scheme -> Store -> (UType, List (Nat, UType), Store)
  open-scheme rigid sc st = case scheme-requirements sc of
    Nil -> case open-qualified rigid sc st of (ty, requirements, pairs, next-store) -> (ty, pairs, next-store)
    other -> (UError, Nil, add-error (Span 0 0 1 1) "qualified scheme needs evidence-aware instantiation" st)
  open-qualified :: Bool -> Scheme -> Store -> (UType, List Requirement, List (Nat, UType), Store)
  open-qualified rigid sc st = case instantiate-params rigid (scheme-params sc) st of
    (pairs, next-store) -> (substitute pairs (scheme-body sc), map-requirements (substitute pairs) (scheme-requirements sc), pairs, next-store)

  generalized :: Bool -> Nat -> List Nat -> List Nat -> Nat -> Store -> (List Quant, List (Nat, UType))
  generalized current level blocked ids next st = case ids of
    Nil -> (Nil, Nil)
    Cons id rest -> case find-cell id st of
      Some (MkCell n lev k None) ->
        if (lev > level || (current && lev == level)) && not (contains-id id blocked) then
          let name = string-concat "a" (nat-to-string next) in
          case generalized current level blocked rest (next + 1) st of
            -- Retain the inference variable's unique identity. Restarting
            -- ids at zero would capture an outer generalized variable in
            -- the core of an inner polymorphic let binding.
            (qs, pairs) -> (Cons (MkQuant id name (normalize-kind st k) False) qs, Cons (id, UBound id name (normalize-kind st k)) pairs)
        else generalized current level blocked rest next st
      other -> generalized current level blocked rest next st
  generalize :: Nat -> List Nat -> UType -> Store -> Scheme
  generalize level blocked ty st = case generalize-with level (\u -> blocked) ty st of (sc, pairs) -> sc
  -- `blocked` lists the metas the environment still mentions. Computing it
  -- walks every binding's scheme, so it is asked for only when some free
  -- meta of the type is young enough to generalize: the blocked list is
  -- consulted for no other meta.
  generalize-with :: Nat -> (Unit -> List Nat) -> UType -> Store -> (Scheme, List (Nat, UType))
  generalize-with level blocked ty st = generalize-at False level blocked ty st
  -- A strict application can bind its function before opening an
  -- argument's private witnesses. Retain independent instantiation
  -- variables at this level; environment and Pi-escaping metas stay fixed.
  generalize-application-with :: (Unit -> List Nat) -> UType -> Store -> (Scheme, List (Nat, UType))
  generalize-application-with blocked ty st = generalize-at True (store-level st) blocked ty st
  generalize-at :: Bool -> Nat -> (Unit -> List Nat) -> UType -> Store -> (Scheme, List (Nat, UType))
  generalize-at current level blocked ty st = case ordered-metas (free-metas st ty) st of
    None -> (mono UError, Nil)
    Some ids -> let local = pi-escaping-metas (type-pi-ids (normalize st ty)) ids st Nil in
      -- A strict let shares each unresolved literal carrier with its uses.
      -- Default and validate the carrier when the enclosing definition closes.
      let monomorphic = merge-ids local (number-meta-ids (pending-numbers st) st) in
      let environment = if generalizable-any current level ids st then blocked () else Nil in
      case generalized current level (merge-ids environment monomorphic) ids 0 st of
        (qs, pairs) -> let closed = close-pairs Nil pairs in
          (MkScheme (map-quant-kinds (replace-metas closed) qs) (replace-metas closed (normalize st ty)), closed)
  -- Whether `generalized` would test any of `ids` against the blocked list.
  generalizable-any :: Bool -> Nat -> List Nat -> Store -> Bool
  generalizable-any current level ids st = case ids of
    Nil -> False
    Cons id rest -> (case find-cell id st of
      Some (MkCell n lev k None) -> lev > level || (current && lev == level)
      other -> False) || generalizable-any current level rest st
  -- Generalize kind dependencies first. A value parameter's carrier may
  -- itself contain type or value inference variables; no raw meta is
  -- smuggled into a supposedly generalized binder's annotation.
  ordered-metas :: List Nat -> Store -> Option (List Nat)
  ordered-metas pending st = case pending of
    Nil -> Some Nil
    other -> case ready-meta pending pending st of
      None -> None
      Some id -> case ordered-metas (remove-id id pending) st of
        Some rest -> Some (Cons id rest)
        None -> None
  ready-meta :: List Nat -> List Nat -> Store -> Option Nat
  ready-meta candidates pending st = case candidates of
    Nil -> None
    Cons id rest -> let dependencies = case find-cell id st of Some (MkCell key level kind solution) -> kind-metas st kind; None -> Nil in
      if any-pending dependencies pending then ready-meta rest pending st else Some id
  any-pending :: List Nat -> List Nat -> Bool
  any-pending ids pending = case ids of Nil -> False; Cons id rest -> contains-id id pending || any-pending rest pending
  -- Polytype binder helpers (design/rank-n-polymorphism.md section 8).
  quant-id-list :: List Quant -> List Nat
  quant-id-list qs = case qs of Nil -> Nil; Cons q rest -> Cons (quant-id q) (quant-id-list rest)
  quant-names-text :: List Quant -> String
  quant-names-text qs = case qs of Nil -> ""; Cons q rest -> string-concat-all [" ", quant-name q, quant-names-text rest]
  remove-ids :: List Nat -> List Nat -> List Nat
  remove-ids gone ids = case gone of Nil -> ids; Cons id rest -> remove-ids rest (remove-id id ids)
  same-quant-kinds :: List Quant -> List Quant -> Bool
  same-quant-kinds qs rs = case (qs, rs) of
    (Nil, Nil) -> True
    (Cons q more, Cons r rest) -> kind-equal (quant-kind q) (quant-kind r) && same-quant-kinds more rest
    other -> False
  -- Rename the binders `from` to `to` positionally: alpha-equivalence of
  -- two polytypes reads both bodies over one set of binder ids.
  rename-quants :: List Quant -> List Quant -> List (Nat, UType)
  rename-quants before after = case (before, after) of
    (Cons f rest, Cons (MkQuant id name kind only) more) -> Cons (quant-id f, UBound id name kind) (rename-quants rest more)
    other -> Nil
  remove-id :: Nat -> List Nat -> List Nat
  remove-id id ids = case ids of Nil -> Nil; Cons first rest -> if id == first then remove-id id rest else Cons first (remove-id id rest)
  close-pairs :: List (Nat, UType) -> List (Nat, UType) -> List (Nat, UType)
  close-pairs earlier pending = case pending of
    Nil -> Nil
    Cons (id, ty) rest -> let closed = replace-metas earlier ty in
      Cons (id, closed) (close-pairs (Cons (id, closed) earlier) rest)
  abstract-metas :: List (Nat, UType) -> UType -> UType
  abstract-metas pairs ty = replace-metas pairs ty
  scheme-arity :: Scheme -> Nat
  scheme-arity sc = arrow-count (scheme-body sc)
  arrow-count :: UType -> Nat
  arrow-count ty = case ty of
    UPi id name domain row result -> 1 + arrow-count result
    UFun a b -> 1 + arrow-count b
    UFunEff a row b -> 1 + arrow-count b
    UUsageArrow usage arrow -> arrow-count arrow
    UProofFun predicate row result -> 1 + arrow-count result
    other -> 0
  -- Source arity retains all binders. Runtime arity drops erased slots;
  -- this count alone is not permission to remove an effectful call.
  scheme-runtime-arity :: Scheme -> Nat
  scheme-runtime-arity sc = runtime-arrow-count (scheme-body sc)
  runtime-arrow-count :: UType -> Nat
  runtime-arrow-count ty = case ty of
    UPi id name domain row result -> 1 + runtime-arrow-count result
    UFun a b -> 1 + runtime-arrow-count b
    UFunEff a row b -> 1 + runtime-arrow-count b
    UUsageArrow UsageZero arrow -> case arrow of
      UFun domain result -> runtime-arrow-count result
      UFunEff domain row result -> runtime-arrow-count result
      UPi id name domain row result -> runtime-arrow-count result
      other -> 0
    UUsageArrow usage arrow -> runtime-arrow-count arrow
    UProofFun predicate row result -> runtime-arrow-count result
    other -> 0

  index-display :: IndexTerm -> String
  index-display value = case value of
    IInteger n -> int-to-string n
    IBound id name -> name
    IRigid id name level -> name
    IMeta id -> string-concat "?index" (nat-to-string id)
    IGlobal name -> name
    IApply f x -> string-concat-all ["(", index-display f, " ", index-display x, ")"]
    ILambda id name body -> string-concat-all ["(lambda ", name, ". ", index-display body, ")"]
    IAdd a b -> string-concat-all ["(", index-display a, " + ", index-display b, ")"]
    ISubtract a b -> string-concat-all ["(", index-display a, " - ", index-display b, ")"]
    IMultiply a b -> string-concat-all ["(", index-display a, " * ", index-display b, ")"]
  mathematical-carrier :: UType -> Bool
  mathematical-carrier carrier = case carrier of UCon name KType -> same-tag name "Nat" || same-tag name "Int"; other -> False
  natural-carrier :: UType -> Bool
  natural-carrier carrier = case carrier of UCon name KType -> same-tag name "Nat"; other -> False
  integer-carrier :: UType -> Bool
  integer-carrier carrier = mathematical-carrier carrier || promotable-carrier carrier
  -- The supported bootstrap target uses 64-bit machine words.
  integer-bounds :: UType -> Option (Int, Int)
  integer-bounds carrier = case carrier of
    UCon name KType ->
      if same-tag name "I8" then Some (-128, 127)
      else if same-tag name "I16" then Some (-32768, 32767)
      else if same-tag name "I32" then Some (-2147483648, 2147483647)
      else if same-tag name "I64" || same-tag name "Isize" then Some (-9223372036854775808, 9223372036854775807)
      else if same-tag name "U8" then Some (0, 255)
      else if same-tag name "U16" then Some (0, 65535)
      else if same-tag name "U32" then Some (0, 4294967295)
      else if same-tag name "U64" || same-tag name "Usize" then Some (0, 18446744073709551615)
      else None
    other -> None
  integer-literal-valid :: UType -> Int -> Bool
  integer-literal-valid carrier value = if mathematical-carrier carrier then not (natural-carrier carrier) || value >= 0
    else case integer-bounds carrier of Some (low, high) -> low <= value && value <= high; None -> False
  float-literal-format :: UType -> Option (Int, Int, Int)
  float-literal-format carrier = case carrier of
    UCon name KType -> if same-tag name "F32" then Some (24, 127, 2147483648)
      else if same-tag name "F64" then Some (53, 1023, 9223372036854775808)
      else None
    other -> None
  number-literal-carrier :: UType -> Bool
  number-literal-carrier carrier = integer-carrier carrier || (case float-literal-format carrier of Some format -> True; None -> False)
  number-literal-valid :: UType -> Int -> Bool
  number-literal-valid carrier value = integer-literal-valid carrier value
    || (case float-literal-bits carrier value False of Some word -> True; None -> False)
  number-literal-error :: UType -> Int -> String -> String
  number-literal-error carrier value fallback = case float-literal-format carrier of
    Some format -> string-concat "integer literal is not exactly representable in " (type-text carrier)
    None -> if natural-carrier carrier || (case integer-bounds carrier of Some bounds -> True; None -> False) then
      string-concat-all ["integer literal ", int-to-string value, " is out of range for ", type-text carrier]
      else fallback
  float-odd-part :: Int -> Int -> Int -> Option (Int, Int)
  float-odd-part magnitude shift limit = if shift > limit then None
    else if int-rem magnitude 2 == 0 then float-odd-part (int-div magnitude 2) (shift + 1) limit
    else Some (magnitude, shift)
  float-bit-width :: Int -> Int -> Option Int
  float-bit-width magnitude available = if magnitude == 0 then Some 0
    else if available == 0 then None
    else case float-bit-width (int-div magnitude 2) (available - 1) of
      Some width -> Some (width + 1)
      None -> None
  float-power-of-two :: Int -> Int
  float-power-of-two exponent = if exponent <= 0 then 1 else 2 * float-power-of-two (exponent - 1)
  -- The odd part must fit the significand exactly. Compute the IEEE word
  -- in mathematical integers so code generation needs no host conversion.
  float-literal-bits :: UType -> Int -> Bool -> Option Int
  float-literal-bits carrier value negative-zero = case float-literal-format carrier of
    None -> None
    Some (precision, bias, sign) ->
      if value == 0 then Some (if negative-zero then sign else 0)
      else (case float-odd-part (if value < 0 then 0 - value else value) 0 bias of
        None -> None
        Some (odd, shift) -> case float-bit-width odd precision of
          None -> None
          Some width -> let exponent = shift + width - 1 in
            if exponent > bias then None else
              let mantissa = (odd - float-power-of-two (width - 1)) * float-power-of-two (precision - width) in
              let word = (bias + exponent) * float-power-of-two (precision - 1) + mantissa in
              Some (if value < 0 then word + sign else word))
  index-shape :: UType -> IndexTerm -> Bool
  index-shape carrier value = case value of
    IInteger n -> integer-literal-valid carrier n
    IAdd a b -> mathematical-carrier carrier && index-shape carrier a && index-shape carrier b
    ISubtract a b -> mathematical-carrier carrier && index-shape carrier a && index-shape carrier b && (not (natural-carrier carrier) || natural-subtraction-defined carrier a b)
    IMultiply a b -> mathematical-carrier carrier && index-shape carrier a && index-shape carrier b
    IGlobal name -> string-length name > 0
    ILambda id name body -> (case carrier of UFun a b -> index-shape b body; UFunEff a row b -> index-shape b body; other -> False)
    other -> True
  normalize-index :: UType -> IndexTerm -> IndexTerm
  normalize-index carrier value = if not (mathematical-carrier carrier) then value else case value of
    IAdd a b -> fold-index carrier "add" (normalize-index carrier a) (normalize-index carrier b)
    ISubtract a b -> fold-index carrier "sub" (normalize-index carrier a) (normalize-index carrier b)
    IMultiply a b -> fold-index carrier "mul" (normalize-index carrier a) (normalize-index carrier b)
    -- Arguments and lambda bodies need their own checked carriers. No
    -- untyped beta reduction or arithmetic interpretation occurs here.
    other -> value
  fold-index :: UType -> String -> IndexTerm -> IndexTerm -> IndexTerm
  fold-index carrier op a b = case (a, b) of
    (IInteger x, IInteger y) -> if same-tag op "add" then IInteger (x + y)
      else if same-tag op "mul" then IInteger (x * y)
      else if natural-carrier carrier && x < y then ISubtract a b else IInteger (x - y)
    -- Conversion is iota on numerals only (D28). Symbolic identities,
    -- including n + 0, 0 * n and n - n, need propositional evidence.
    other -> if same-tag op "add" then IAdd a b else if same-tag op "mul" then IMultiply a b else ISubtract a b
  -- This is the arithmetic part of runtime admissibility. References
  -- additionally require the actual typed scope; globals/applications and
  -- lambdas require a separately checked total/pure reifier.
  index-runtime-admissible :: UType -> IndexTerm -> Bool
  index-runtime-admissible carrier input =
    carrier-type carrier && index-shape carrier input && (case input of
      IMeta id -> False
      IGlobal name -> False
      IApply f x -> False
      ILambda id name body -> False
      IAdd a b -> index-runtime-admissible carrier a && index-runtime-admissible carrier b
      IMultiply a b -> index-runtime-admissible carrier a && index-runtime-admissible carrier b
      ISubtract a b -> index-runtime-admissible carrier a && index-runtime-admissible carrier b
      other -> True)
  natural-subtraction-defined :: UType -> IndexTerm -> IndexTerm -> Bool
  natural-subtraction-defined carrier a b = index-equal a b ||
    (case (normalize-index carrier a, normalize-index carrier b) of (IInteger x, IInteger y) -> x >= y; other -> False)

  -- The carrier `type-kind` would wrap in `KValue`, without the document
  -- round trip. The definition it must agree with is
  -- `value-carrier (type-kind value)`, and the arms below are exactly the
  -- ones `type-kind` answers with `value-kind carrier`: each returns that
  -- carrier directly instead of encoding it to a tree and decoding it
  -- back. The four kind-carrying arms and the `UApp` arm have no carrier
  -- in hand (their kind is a `Kind`, possibly already a `KValue`), so they
  -- take the same `value-carrier` step the old definition did.
  index-carrier :: UType -> Option UType
  index-carrier value = case value of
    UCon n k -> value-carrier k
    UBound id name k -> value-carrier k
    URigid id name level k -> value-carrier k
    UMeta id k -> value-carrier k
    UIndex carrier term -> Some carrier
    UIndexForget forgotten -> case index-carrier forgotten of
      Some refined -> case refinement-view refined of URefine id name carrier predicate -> Some carrier; other -> None
      None -> None
    UIndexByteLength value -> Some (UCon "Nat" KType)
    UIndexBorrowRead value -> case borrow-index-parts value of
      Some (mutable, region, carrier) -> Some carrier
      None -> None
    UIndexList element fields -> Some (core-list-type element)
    UIndexCall function args -> Some (UCon (total-result function) KType)
    UIndexPromote value -> Some (UCon "Int" KType)
    UIndexMath op left right -> index-carrier left
    UApp f x -> case type-kind f of KFun a b -> value-carrier b; other -> None
    UPi id name domain row result -> index-carrier result
    other -> None

  typed-index-carrier :: UType -> Option UType
  typed-index-carrier value = index-carrier value
  borrow-constructor-kind :: Kind
  borrow-constructor-kind = KFun KRegion (KFun KType KType)
  borrow-type-parts :: UType -> Option (Bool, UType, UType)
  borrow-type-parts ty = case ty of
    UApp (UApp (UCon name kind) region) carrier ->
      if (same-tag name "Ref" || same-tag name "Mut") && kind-equal kind borrow-constructor-kind
        && kind-equal (type-kind region) KRegion && kind-equal (type-kind carrier) KType
      then Some (same-tag name "Mut", region, carrier) else None
    other -> None
  borrow-regions :: UType -> List (Bool, UType)
  borrow-regions ty = case borrow-type-parts ty of
    Some (mutable, region, carrier) -> Cons (mutable, region) (borrow-regions carrier)
    None -> (case ty of
      UApp head argument -> borrow-regions head <> borrow-regions argument
      UFun domain result -> borrow-regions domain <> borrow-regions result
      UFunEff domain row result -> borrow-regions domain <> borrow-regions result
      UPi id name domain row result -> borrow-regions domain <> borrow-regions result
      UUsageArrow usage arrow -> borrow-regions arrow
      UProofFun predicate row result -> borrow-regions result
      URequire predicates result -> borrow-regions result
      URefine id name carrier predicate -> borrow-regions carrier
      UTuple fields -> borrow-regions fields
      UForall qs body -> borrow-regions body
      UArg first rest -> borrow-regions first <> borrow-regions rest
      other -> Nil)
  region-already-borrowed :: Bool -> UType -> List (Bool, UType) -> Bool
  region-already-borrowed mutable region loans = case loans of
    Nil -> False
    Cons (exclusive, other) rest ->
      ((mutable || exclusive) && same-shape region other) || region-already-borrowed mutable region rest
  borrow-region-conflict :: List (Bool, UType) -> List (Bool, UType) -> Bool
  borrow-region-conflict loans active = case loans of
    Nil -> False
    Cons (mutable, region) rest -> region-already-borrowed mutable region active || borrow-region-conflict rest active
  borrow-index-parts :: UType -> Option (Bool, UType, UType)
  borrow-index-parts index = case index of
    UIndex carrier (IRigid id name level) -> borrow-type-parts carrier
    other -> None
  promotable-carrier :: UType -> Bool
  promotable-carrier carrier = case carrier of UCon name KType -> same-tag name "Nat" || same-tag name "I8" || same-tag name "I16" || same-tag name "I32" || same-tag name "I64" || same-tag name "U8" || same-tag name "U16" || same-tag name "U32" || same-tag name "U64" || same-tag name "Isize" || same-tag name "Usize"; other -> False
  math-operation :: String -> Bool
  math-operation op = same-tag op "+" || same-tag op "-" || same-tag op "*"
  math-index :: String -> IndexTerm -> IndexTerm -> IndexTerm
  math-index op left right = if same-tag op "+" then IAdd left right else if same-tag op "*" then IMultiply left right else ISubtract left right
  -- Both operands' index terms, when both have one: the subtraction check
  -- below needs the pair, and a `case (x, y)` scrutinee would allocate it.
  both-index-terms :: UType -> UType -> Option (IndexTerm, IndexTerm)
  both-index-terms left right = case index-of-type left of
    Some x -> case index-of-type right of
      Some y -> Some (x, y)
      other -> None
    other -> None
  valid-typed-math :: String -> UType -> UType -> Bool
  valid-typed-math op left right = valid-type left && valid-type right && math-operation op && (case typed-index-carrier left of
    Some a -> case typed-index-carrier right of
      Some b -> mathematical-carrier a && carrier-equal a b &&
        (if same-tag op "-" && natural-carrier a then same-shape left right ||
          (case both-index-terms left right of
            Some pair -> case pair of (x, y) -> natural-subtraction-defined a x y
            other -> False)
         else True)
      other -> False
    other -> False)
  make-index-math :: String -> UType -> UType -> UType
  make-index-math op left right = if not (math-operation op) then UIndexMath op left right else case left of
    UIndex a x -> case right of
      UIndex b y -> if mathematical-carrier a && carrier-equal a b then UIndex a (normalize-index a (math-index op x y)) else UIndexMath op left right
      other -> UIndexMath op left right
    other -> UIndexMath op left right
  normalize-promoted-index :: UType -> UType
  normalize-promoted-index value = case value of
    UIndex carrier (IInteger n) -> if promotable-carrier carrier && integer-literal-valid carrier n then UIndex (UCon "Int" KType) (IInteger n) else UIndexPromote value
    other -> UIndexPromote value
  total-call-arguments :: List String -> UType -> Bool
  total-call-arguments parameters args = case (parameters, args) of
    (Nil, UEnd) -> True
    (Cons expected rest, UArg input more) -> valid-type input
      && (case typed-index-carrier input of Some actual -> same-shape actual (UCon expected KType); None -> False)
      && total-call-arguments rest more
    other -> False
  total-call-runtime-arguments :: UType -> Bool
  total-call-runtime-arguments args = case args of
    UEnd -> True
    UArg input more -> typed-index-admissible input && total-call-runtime-arguments more
    other -> False
  typed-index-admissible :: UType -> Bool
  typed-index-admissible value = valid-type value && (case value of
    UIndexForget input -> typed-index-admissible input
    UIndexByteLength input -> typed-index-admissible input
    UIndexBorrowRead input -> typed-index-admissible input
    UIndexList element fields -> True
    UIndexCall function args -> total-call-runtime-arguments args
    UIndexPromote input -> typed-index-admissible input
    UIndexMath op left right -> typed-index-admissible left && typed-index-admissible right
    other -> case (typed-index-carrier value, index-of-type value) of (Some carrier, Some term) -> index-runtime-admissible carrier term; other -> False)
  typed-index-solutions :: Store -> List Nat -> List (Nat, UType)
  typed-index-solutions st ids = case ids of
    Nil -> Nil
    Cons id rest -> case find-cell id st of
      Some (MkCell key level kind (Some solution)) -> Cons (id, normalize st solution) (typed-index-solutions st rest)
      other -> typed-index-solutions st rest
  normalize-value-index :: Store -> UType -> IndexTerm -> UType
  normalize-value-index st carrier value = case substitute-value-index True (typed-index-solutions st (index-free-metas value)) carrier value of
    UIndex actual term -> UIndex actual (normalize-index actual term)
    other -> normalize st other

  -- Index conversion solves only sorted first-order structural equations.
  -- Opaque applications/lambdas compare by alpha identity; their argument
  -- carriers and purity must be checked by the dependent elaborator.
  unify-index :: Span -> UType -> IndexTerm -> IndexTerm -> Store -> Store
  unify-index sp carrier first second st =
    let a = normalize-index carrier (resolve-index st first) in
    let b = normalize-index carrier (resolve-index st second) in
    if index-equal a b then st else case (a, b) of
      (IMeta id, right) -> bind-meta sp id (value-kind carrier) (UIndex carrier b) st
      (left, IMeta id) -> bind-meta sp id (value-kind carrier) (UIndex carrier a) st
      (IAdd x y, IAdd u v) -> unify-index sp carrier y v (unify-index sp carrier x u st)
      (ISubtract x y, ISubtract u v) -> unify-index sp carrier y v (unify-index sp carrier x u st)
      (IMultiply x y, IMultiply u v) -> unify-index sp carrier y v (unify-index sp carrier x u st)
      other -> add-error sp (string-concat (mismatch-message (UIndex carrier a) (UIndex carrier b)) " (index mismatch)") st

  validate-kind-indices :: Span -> Kind -> Store -> Store
  validate-kind-indices sp kind st = case kind of
    KValue payload -> case value-carrier kind of Some carrier -> validate-type-indices sp carrier st; None -> add-error sp "invalid value carrier" st
    KFun a b -> validate-kind-indices sp b (validate-kind-indices sp a st)
    other -> st
  validate-type-indices :: Span -> UType -> Store -> Store
  validate-type-indices sp ty st = case ty of
    UPropLit value -> st
    UCompare relation left right -> if valid-type ty then validate-type-indices sp right (validate-type-indices sp left (st)) else add-error sp "ill-formed proposition or required type" st
    UPropAnd left right -> if valid-type ty then validate-type-indices sp right (validate-type-indices sp left (st)) else add-error sp "ill-formed proposition or required type" st
    UPropOr left right -> if valid-type ty then validate-type-indices sp right (validate-type-indices sp left (st)) else add-error sp "ill-formed proposition or required type" st
    UPropNot body -> if valid-type ty then validate-type-indices sp body (st) else add-error sp "ill-formed proposition or required type" st
    UPropNonZero body -> if valid-type ty then validate-type-indices sp body (st) else add-error sp "ill-formed proposition or required type" st
    UPropNotNull body -> if valid-type ty then validate-type-indices sp body (st) else add-error sp "ill-formed proposition or required type" st
    UPropAscii body -> if valid-type ty then validate-type-indices sp body (st) else add-error sp "ill-formed proposition or required type" st
    UPropOrdered body -> if valid-type ty then validate-type-indices sp body (st) else add-error sp "ill-formed proposition or required type" st
    UPropNonZeroPending body -> if valid-type ty then validate-type-indices sp body (st) else add-error sp "ill-formed proposition or required type" st
    URequire predicates body -> if valid-type ty then validate-type-indices sp body (validate-type-indices sp predicates (st)) else add-error sp "ill-formed proposition or required type" st
    URefine id name carrier predicate -> if valid-type ty then validate-type-indices sp predicate (validate-type-indices sp carrier st) else add-error sp "ill-formed refinement type" st
    URefineFormer name ids body -> if valid-type ty then validate-type-indices sp body st else add-error sp "ill-formed refinement former" st
    UIndexForget value -> if valid-type ty then validate-type-indices sp value st else add-error sp "ill-sorted index projection" st
    UIndexByteLength value -> if valid-type ty then validate-type-indices sp value st else add-error sp "ill-sorted byte-length index" st
    UIndexBorrowRead value -> if valid-type ty then validate-type-indices sp value st else add-error sp "ill-sorted borrow read index" st
    UIndexList element fields -> if valid-type ty then validate-type-indices sp fields (validate-type-indices sp element st)
      else add-error sp "ill-sorted checked list index" st
    UIndexCall function args -> if valid-type ty then validate-type-indices sp args st else add-error sp "ill-sorted checked total call" st
    UIndexPromote value -> if valid-type ty then validate-type-indices sp value st else add-error sp "ill-sorted integer index promotion" st
    UIndexMath op left right -> if valid-type ty then validate-type-indices sp right (validate-type-indices sp left st) else add-error sp "ill-sorted typed index arithmetic" st
    UPi id name domain row result -> validate-type-indices sp result (validate-type-indices sp row (validate-type-indices sp domain st))
    UIndex carrier value ->
      let checked = validate-type-indices sp carrier st in
      if not (carrier-type carrier && index-shape carrier value) then add-error sp "ill-sorted or undefined index expression" checked
      else validate-index-references sp (Some carrier) value checked
    UCon name k -> validate-kind-indices sp k st
    UBound id name k -> validate-kind-indices sp k st
    URigid id name level k -> validate-kind-indices sp k st
    UMeta id k -> validate-kind-indices sp k st
    UApp a b -> validate-type-indices sp b (validate-type-indices sp a st)
    UFun a b -> validate-type-indices sp b (validate-type-indices sp a st)
    UFunEff a row b -> validate-type-indices sp b (validate-type-indices sp row (validate-type-indices sp a st))
    UUsageArrow usage arrow -> if computational-arrow arrow then validate-type-indices sp arrow st
      else add-error sp "usage annotation requires a computational arrow" st
    UProofFun predicate row result -> if valid-type ty then validate-type-indices sp result (validate-type-indices sp row (validate-type-indices sp predicate st)) else add-error sp "ill-formed erased proof arrow" st
    URow labels -> validate-type-indices sp labels st
    URowJoin a b -> validate-type-indices sp b (validate-type-indices sp a st)
    UTuple fields -> validate-type-indices sp fields st
    UForall qs body -> validate-type-indices sp body st
    UArg a b -> validate-type-indices sp b (validate-type-indices sp a st)
    other -> st
  validate-index-references :: Span -> Option UType -> IndexTerm -> Store -> Store
  validate-index-references sp expected term st = case term of
    IMeta id -> case find-cell id st of
      None -> add-error sp "unknown index inference variable" st
      Some (MkCell key level kind solution) -> case value-carrier kind of
        None -> add-error sp "a type inference variable cannot be used as a value index" st
        Some carrier -> case expected of Some actual -> unify sp actual carrier st; None -> st
    IAdd a b -> validate-index-references sp expected b (validate-index-references sp expected a st)
    ISubtract a b -> validate-index-references sp expected b (validate-index-references sp expected a st)
    IMultiply a b -> validate-index-references sp expected b (validate-index-references sp expected a st)
    IApply f x -> validate-index-references sp None x (validate-index-references sp None f st)
    ILambda id name body -> validate-index-references sp (index-result-carrier expected) body st
    other -> st
  index-result-carrier :: Option UType -> Option UType
  index-result-carrier expected = case expected of
    Some (UFun domain result) -> Some result
    Some (UFunEff domain row result) -> Some result
    other -> None

  value-index-pairs :: List (Nat, UType) -> List (Nat, IndexTerm)
  value-index-pairs pairs = case pairs of
    Nil -> Nil
    Cons (id, ty) rest -> case index-of-type ty of Some value -> Cons (id, value) (value-index-pairs rest); None -> value-index-pairs rest
  without-type-pairs :: List Nat -> List (Nat, UType) -> List (Nat, UType)
  without-type-pairs ids pairs = case ids of Nil -> pairs; Cons id rest -> without-type-pairs rest (without-type-pair id pairs)
  without-type-pair :: Nat -> List (Nat, UType) -> List (Nat, UType)
  without-type-pair id pairs = case pairs of Nil -> Nil; Cons (key, ty) rest -> if id == key then without-type-pair id rest else Cons (key, ty) (without-type-pair id rest)
  index-replacement-ok :: Nat -> List (Nat, UType) -> Option UType -> Bool
  index-replacement-ok id pairs expected = case mapped id pairs of
    None -> True
    Some replacement -> case (index-of-type replacement, value-carrier (type-kind replacement)) of
      (Some value, Some carrier) -> valid-type replacement && (case expected of Some actual -> carrier-equal actual carrier; None -> True)
      other -> False
  index-replacements-ok :: Bool -> List (Nat, UType) -> Option UType -> IndexTerm -> Bool
  index-replacements-ok metas pairs expected term = case term of
    IBound id name -> if metas then True else index-replacement-ok id pairs expected
    IMeta id -> if metas then index-replacement-ok id pairs expected else True
    IAdd a b -> index-replacements-ok metas pairs expected a && index-replacements-ok metas pairs expected b
    ISubtract a b -> index-replacements-ok metas pairs expected a && index-replacements-ok metas pairs expected b
    IMultiply a b -> index-replacements-ok metas pairs expected a && index-replacements-ok metas pairs expected b
    IApply f x -> index-replacements-ok metas pairs None f && index-replacements-ok metas pairs None x
    ILambda id name body -> index-replacements-ok metas (if metas then pairs else without-type-pair id pairs) (index-result-carrier expected) body
    other -> True
  substitute-value-index :: Bool -> List (Nat, UType) -> UType -> IndexTerm -> UType
  substitute-value-index metas pairs carrier value = case value of
    IBound id name -> if metas then UIndex carrier value else insert-typed-index id pairs carrier value
    IMeta id -> if metas then insert-typed-index id pairs carrier value else UIndex carrier value
    IAdd left right -> make-index-math "+" (substitute-value-index metas pairs carrier left) (substitute-value-index metas pairs carrier right)
    ISubtract left right -> make-index-math "-" (substitute-value-index metas pairs carrier left) (substitute-value-index metas pairs carrier right)
    IMultiply left right -> make-index-math "*" (substitute-value-index metas pairs carrier left) (substitute-value-index metas pairs carrier right)
    other -> if not (index-replacements-ok metas pairs (Some carrier) value) then UError
      else UIndex carrier (if metas then substitute-index-metas (value-index-pairs pairs) value else substitute-index (value-index-pairs pairs) value)
  insert-typed-index :: Nat -> List (Nat, UType) -> UType -> IndexTerm -> UType
  insert-typed-index id pairs carrier original = case mapped id pairs of
    None -> UIndex carrier original
    Some value -> if valid-type value && (case typed-index-carrier value of Some actual -> carrier-equal carrier actual; None -> False) then value else UError

  -- Pi binders scope the effect row and codomain, never their own domain.
  -- Id scans include carrier kinds and every Index namespace, so externally
  -- constructed terms cannot collide with an alpha-comparison witness.
  index-all-ids :: IndexTerm -> List Nat
  index-all-ids term = case term of
    IBound id name -> [id]
    IRigid id name level -> [id]
    IMeta id -> [id]
    ILambda id name body -> merge-ids [id] (index-all-ids body)
    IApply f x -> merge-ids (index-all-ids f) (index-all-ids x)
    IAdd a b -> merge-ids (index-all-ids a) (index-all-ids b)
    ISubtract a b -> merge-ids (index-all-ids a) (index-all-ids b)
    IMultiply a b -> merge-ids (index-all-ids a) (index-all-ids b)
    other -> Nil
  kind-all-ids :: Kind -> List Nat
  kind-all-ids kind = case kind of
    KValue payload -> case value-carrier kind of Some carrier -> type-all-ids carrier; None -> Nil
    KFun a b -> merge-ids (kind-all-ids a) (kind-all-ids b)
    other -> Nil
  type-all-ids :: UType -> List Nat
  type-all-ids ty = case ty of
    UPropLit value -> Nil
    UCompare relation left right -> merge-ids (type-all-ids left) (type-all-ids right)
    UPropAnd left right -> merge-ids (type-all-ids left) (type-all-ids right)
    UPropOr left right -> merge-ids (type-all-ids left) (type-all-ids right)
    UPropNot body -> type-all-ids body
    UPropNonZero body -> type-all-ids body
    UPropNotNull body -> type-all-ids body
    UPropAscii body -> type-all-ids body
    UPropOrdered body -> type-all-ids body
    UPropNonZeroPending body -> type-all-ids body
    URequire predicates body -> merge-ids (type-all-ids predicates) (type-all-ids body)
    URefine id name carrier predicate -> merge-ids [id] (merge-ids (type-all-ids carrier) (type-all-ids predicate))
    URefineFormer name ids body -> merge-ids ids (type-all-ids body)
    UCon name k -> kind-all-ids k
    UBound id name k -> merge-ids [id] (kind-all-ids k)
    URigid id name level k -> merge-ids [id] (kind-all-ids k)
    UMeta id k -> merge-ids [id] (kind-all-ids k)
    UIndexForget value -> type-all-ids value
    UIndexByteLength value -> type-all-ids value
    UIndexBorrowRead value -> type-all-ids value
    UIndexList element fields -> merge-ids (type-all-ids element) (type-all-ids fields)
    UIndexCall function args -> type-all-ids args
    UIndexPromote value -> type-all-ids value
    UIndexMath op left right -> merge-ids (type-all-ids left) (type-all-ids right)
    UIndex carrier value -> merge-ids (type-all-ids carrier) (index-all-ids value)
    UPi id name domain row result -> merge-ids [id] (merge-ids (type-all-ids domain) (merge-ids (type-all-ids row) (type-all-ids result)))
    UApp a b -> merge-ids (type-all-ids a) (type-all-ids b)
    UFun a b -> merge-ids (type-all-ids a) (type-all-ids b)
    UFunEff a row b -> merge-ids (type-all-ids a) (merge-ids (type-all-ids row) (type-all-ids b))
    UUsageArrow usage arrow -> type-all-ids arrow
    UProofFun a row b -> merge-ids (type-all-ids a) (merge-ids (type-all-ids row) (type-all-ids b))
    URow labels -> type-all-ids labels
    URowJoin a b -> merge-ids (type-all-ids a) (type-all-ids b)
    UTuple fields -> type-all-ids fields
    UForall qs body -> merge-ids (quant-id-list qs) (type-all-ids body)
    UArg a rest -> merge-ids (type-all-ids a) (type-all-ids rest)
    other -> Nil
  largest-id :: List Nat -> Nat
  largest-id ids = case ids of Nil -> 0; Cons id rest -> let more = largest-id rest in if id > more then id else more
  kind-free-bound :: Kind -> List Nat
  kind-free-bound kind = case kind of
    KValue payload -> case value-carrier kind of Some carrier -> type-free-bound carrier; None -> Nil
    KFun a b -> merge-ids (kind-free-bound a) (kind-free-bound b)
    other -> Nil
  type-free-bound :: UType -> List Nat
  type-free-bound ty = case ty of
    UPropLit value -> Nil
    UCompare relation left right -> merge-ids (type-free-bound left) (type-free-bound right)
    UPropAnd left right -> merge-ids (type-free-bound left) (type-free-bound right)
    UPropOr left right -> merge-ids (type-free-bound left) (type-free-bound right)
    UPropNot body -> type-free-bound body
    UPropNonZero body -> type-free-bound body
    UPropNotNull body -> type-free-bound body
    UPropAscii body -> type-free-bound body
    UPropOrdered body -> type-free-bound body
    UPropNonZeroPending body -> type-free-bound body
    URequire predicates body -> merge-ids (type-free-bound predicates) (type-free-bound body)
    URefine id name carrier predicate -> merge-ids (type-free-bound carrier) (remove-id id (type-free-bound predicate))
    URefineFormer name ids body -> Nil
    UBound id name k -> merge-ids [id] (kind-free-bound k)
    UCon name k -> kind-free-bound k
    URigid id name level k -> kind-free-bound k
    UMeta id k -> kind-free-bound k
    UIndexForget value -> type-free-bound value
    UIndexByteLength value -> type-free-bound value
    UIndexBorrowRead value -> type-free-bound value
    UIndexList element fields -> merge-ids (type-free-bound element) (type-free-bound fields)
    UIndexCall function args -> type-free-bound args
    UIndexPromote value -> type-free-bound value
    UIndexMath op left right -> merge-ids (type-free-bound left) (type-free-bound right)
    UIndex carrier value -> merge-ids (type-free-bound carrier) (index-free-bound value)
    UPi id name domain row result -> merge-ids (type-free-bound domain) (remove-id id (merge-ids (type-free-bound row) (type-free-bound result)))
    UApp a b -> merge-ids (type-free-bound a) (type-free-bound b)
    UFun a b -> merge-ids (type-free-bound a) (type-free-bound b)
    UFunEff a row b -> merge-ids (type-free-bound a) (merge-ids (type-free-bound row) (type-free-bound b))
    UUsageArrow usage arrow -> type-free-bound arrow
    UProofFun a row b -> merge-ids (type-free-bound a) (merge-ids (type-free-bound row) (type-free-bound b))
    URow labels -> type-free-bound labels
    URowJoin a b -> merge-ids (type-free-bound a) (type-free-bound b)
    UTuple fields -> type-free-bound fields
    UForall qs body -> remove-ids (quant-id-list qs) (type-free-bound body)
    UArg a rest -> merge-ids (type-free-bound a) (type-free-bound rest)
    other -> Nil
  pair-all-ids :: List (Nat, UType) -> List Nat
  pair-all-ids pairs = case pairs of Nil -> Nil; Cons (id, ty) rest -> merge-ids [id] (merge-ids (type-all-ids ty) (pair-all-ids rest))
  pair-free-bound :: List (Nat, UType) -> List Nat
  pair-free-bound pairs = case pairs of Nil -> Nil; Cons (id, ty) rest -> merge-ids (type-free-bound ty) (pair-free-bound rest)
  substitute-pi :: TypeSubstitution -> List (Nat, UType) -> Nat -> String -> UType -> UType -> UType -> UType
  substitute-pi mode pairs id name domain row result =
    let kept = case mode of ReplaceBound -> without-type-pair id pairs; other -> pairs in
    let fresh = largest-id (merge-ids (type-all-ids (UPi id name domain row result)) (pair-all-ids pairs)) + 1 in
    let captures = contains-id id (pair-free-bound kept) in
    -- The renaming witness uses the original domain. Its annotation is
    -- transformed once with the body, preserving simultaneous insertion.
    let witness = UBound fresh name (value-kind domain) in
    let scoped-row = if captures then substitute [(id, witness)] row else row in
    let scoped-result = if captures then substitute [(id, witness)] result else result in
    UPi (if captures then fresh else id) name (transform-type mode pairs domain)
      (transform-type mode kept scoped-row) (transform-type mode kept scoped-result)

  -- Reuse the checked binder machinery without identifying refinements
  -- with functions. The encoding is private and never an exported type.
  refinement-pi :: Nat -> String -> UType -> UType -> UType
  refinement-pi id name carrier predicate = UPi id name carrier (URow UEnd) (URequire (UArg predicate UEnd) carrier)
  substitute-refinement :: TypeSubstitution -> List (Nat, UType) -> Nat -> String -> UType -> UType -> UType
  substitute-refinement mode pairs id name carrier predicate = case substitute-pi mode pairs id name carrier (URow UEnd) predicate of
    UPi fresh display domain row condition -> URefine fresh display domain condition
    other -> UError
  -- Opening produces the predicate to prove about an actual checked index.
  -- It supplies no evidence and performs no carrier coercion or erasure.
  open-refinement :: Span -> UType -> UType -> Store -> (UType, Store)
  open-refinement sp refined argument st = case refinement-view (normalize st refined) of
    URefine id name carrier predicate -> if valid-type refined then
      (case open-pi sp (refinement-pi id name carrier predicate) argument st of
        (URequire (UArg condition UEnd) body, row, checked) -> (condition, checked)
        (other, row, checked) -> (UError, checked))
      else (UError, add-error sp "ill-formed refinement type" st)
    other -> (UError, add-error sp "refinement opening requires a refined type" st)

  same-pi :: UType -> UType -> Bool
  same-pi first second = case (first, second) of
    (UPi id name domain row result, UPi key other input effects output) ->
      let fresh = largest-id (merge-ids (type-all-ids first) (type-all-ids second)) + 1 in
      let witness = URigid fresh "#pi-alpha" 0 (value-kind domain) in
      same-shape domain input
        && same-shape (substitute [(id, witness)] row) (substitute [(key, witness)] effects)
        && same-shape (substitute [(id, witness)] result) (substitute [(key, witness)] output)
    other -> False
  function-pi :: UType -> UType
  function-pi ty = let fresh = largest-id (type-all-ids ty) + 1 in case ty of
    UFun domain result -> UPi fresh "_" domain (URow UEnd) result
    UFunEff domain row result -> UPi fresh "_" domain row result
    other -> ty
  reserve-type-ids :: UType -> UType -> Store -> Store
  reserve-type-ids first second st = case st of
    MkStore label next level cells errors numbers in-law depth ->
      let highest = largest-id (merge-ids (type-all-ids first) (type-all-ids second)) in
      MkStore label (if next > highest then next else highest + 1) level cells errors numbers in-law depth
  cells-level :: List Cell -> Nat
  cells-level cells = case cells of Nil -> 0; Cons (MkCell id level kind solution) rest -> let more = cells-level rest in if level > more then level else more
  pi-level :: Store -> Nat
  pi-level st = case st of MkStore label next level cells errors numbers in-law depth -> let highest = cells-level cells in (if level > highest then level else highest) + 1
  -- Two polytypes are equal when their binders agree in number and kind
  -- and their bodies unify over one shared set of rigid variables, opened
  -- one level deeper than every existing metavariable: `bind-other`'s
  -- escape check then refuses any older metavariable that would capture
  -- one (design/rank-n-polymorphism.md section 3). Polytypes are invariant.
  unify-forall :: Span -> UType -> UType -> Store -> Store
  unify-forall sp a b st = case (a, b) of
    (UForall qs x, UForall rs y) ->
      if not (list-length qs == list-length rs && same-quant-kinds qs rs) then
        add-error sp (string-concat-all ["polymorphic types differ in their quantifiers: expected ", display-type-text b, ", found ", display-type-text a]) st
      else let outer = store-level st in
        case instantiate-params True qs (enter-level st) of
          (pairs, opened) -> restore-level outer (unify sp (substitute pairs x) (substitute (shared-rigids rs pairs) y) opened)
    other -> mismatch sp a b st
  shared-rigids :: List Quant -> List (Nat, UType) -> List (Nat, UType)
  shared-rigids rs pairs = case (rs, pairs) of
    (Cons r rest, Cons (id, rigid) more) -> Cons (quant-id r, rigid) (shared-rigids rest more)
    other -> Nil
  unify-pi :: Span -> UType -> UType -> Store -> Store
  unify-pi sp first second st = case (first, second) of
    (UPi id name domain row result, UPi key other input effects output) ->
      if not (valid-type first && valid-type second) then add-error sp "ill-formed dependent function type" st
      else let checked = unify sp domain input st in
        if list-length (store-errors checked) > list-length (store-errors st) then checked
        else if not (valid-type (normalize checked first) && valid-type (normalize checked second)) then
          add-error sp "dependent domain inference captures a binder" checked
        else let outer-level = store-level checked in
          let scoped = restore-level (pi-level checked) (reserve-type-ids first second checked) in
          case fresh-id scoped of
            (fresh, prepared) ->
              -- No pre-existing meta may acquire this newly opened
              -- binder. Contextual higher-order metas need a later rule.
              let witness = URigid fresh "#pi" (store-level prepared) (value-kind (normalize checked domain)) in
              let left-row = substitute [(id, witness)] (normalize checked row) in
              let right-row = substitute [(key, witness)] (normalize checked effects) in
              let left-result = substitute [(id, witness)] (normalize checked result) in
              let right-result = substitute [(key, witness)] (normalize checked output) in
              let valid = valid-type left-row && valid-type right-row && valid-type left-result && valid-type right-result in
              let resolved = if valid then unify sp left-result right-result (unify sp left-row right-row prepared)
                    else add-error sp "invalid dependent binder substitution" prepared in
              restore-level outer-level resolved
    other -> mismatch sp first second st

  -- Apply an already checked value index to a dependent arrow. Source
  -- elaboration must provide its real argument's identity and establish
  -- scope/purity before any expression is admitted as that index.
  open-pi :: Span -> UType -> UType -> Store -> (UType, UType, Store)
  open-pi sp function argument st =
    let checked = validate-type-indices sp argument (validate-type-indices sp function st) in
    if list-length (store-errors checked) > list-length (store-errors st) then (UError, UError, checked)
    else if not (valid-type function && valid-type argument) then (UError, UError, add-error sp "invalid dependent application input" checked)
    else if escapes (store-level checked) (normalize checked function) || escapes (store-level checked) (normalize checked argument) then
      (UError, UError, add-error sp "dependent application escapes its scope" checked)
    else open-pi-normalized sp (normalize checked function) (normalize checked argument) checked
  open-pi-normalized :: Span -> UType -> UType -> Store -> (UType, UType, Store)
  open-pi-normalized sp function argument st = case arrow-shape function of
    UPi id name domain row result ->
      let checked = validate-type-indices sp argument st in
      let sorted = if valid-type argument then unify-kind sp (type-kind (normalize checked argument)) (value-kind domain) checked
            else add-error sp "invalid dependent argument index" checked in
      if list-length (store-errors sorted) > list-length (store-errors st) then (UError, UError, sorted)
      else if not (valid-type (normalize sorted function)) then
        (UError, UError, add-error sp "dependent domain inference captures a binder" sorted)
      else let pairs = [(id, normalize sorted argument)] in
        let opened-row = substitute pairs (normalize sorted row) in
        let opened-result = substitute pairs (normalize sorted result) in
        if valid-type opened-row && valid-type opened-result then (opened-result, opened-row, sorted)
        else (UError, UError, add-error sp "invalid dependent application result" sorted)
    other -> (UError, UError, add-error sp "dependent application requires a Pi type" st)

  -- A Scheme quantifies outside its whole body. Hoisting a meta whose
  -- carrier mentions a Pi-local binder would leave that quantifier's
  -- annotation outside the binder's scope. Keep it as an unresolved hole.
  kind-pi-ids :: Kind -> List Nat
  kind-pi-ids kind = case kind of
    KValue payload -> case value-carrier kind of Some carrier -> type-pi-ids carrier; None -> Nil
    KFun a b -> merge-ids (kind-pi-ids a) (kind-pi-ids b)
    other -> Nil
  type-pi-ids :: UType -> List Nat
  type-pi-ids ty = case ty of
    UPropLit value -> Nil
    UCompare relation left right -> merge-ids (type-pi-ids left) (type-pi-ids right)
    UPropAnd left right -> merge-ids (type-pi-ids left) (type-pi-ids right)
    UPropOr left right -> merge-ids (type-pi-ids left) (type-pi-ids right)
    UPropNot body -> type-pi-ids body
    UPropNonZero body -> type-pi-ids body
    UPropNotNull body -> type-pi-ids body
    UPropAscii body -> type-pi-ids body
    UPropOrdered body -> type-pi-ids body
    UPropNonZeroPending body -> type-pi-ids body
    URequire predicates body -> merge-ids (type-pi-ids predicates) (type-pi-ids body)
    URefine id name carrier predicate -> merge-ids [id] (merge-ids (type-pi-ids carrier) (type-pi-ids predicate))
    URefineFormer name ids body -> merge-ids ids (type-pi-ids body)
    UPi id name domain row result -> merge-ids [id] (merge-ids (type-pi-ids domain) (merge-ids (type-pi-ids row) (type-pi-ids result)))
    UCon name k -> kind-pi-ids k
    UBound id name k -> kind-pi-ids k
    URigid id name level k -> kind-pi-ids k
    UMeta id k -> kind-pi-ids k
    UIndexForget value -> type-pi-ids value
    UIndexByteLength value -> type-pi-ids value
    UIndexBorrowRead value -> type-pi-ids value
    UIndexList element fields -> merge-ids (type-pi-ids element) (type-pi-ids fields)
    UIndexCall function args -> type-pi-ids args
    UIndexPromote value -> type-pi-ids value
    UIndexMath op left right -> merge-ids (type-pi-ids left) (type-pi-ids right)
    UIndex carrier value -> type-pi-ids carrier
    UApp a b -> merge-ids (type-pi-ids a) (type-pi-ids b)
    UFun a b -> merge-ids (type-pi-ids a) (type-pi-ids b)
    UFunEff a row b -> merge-ids (type-pi-ids a) (merge-ids (type-pi-ids row) (type-pi-ids b))
    UUsageArrow usage arrow -> type-pi-ids arrow
    UProofFun a row b -> merge-ids (type-pi-ids a) (merge-ids (type-pi-ids row) (type-pi-ids b))
    URow labels -> type-pi-ids labels
    URowJoin a b -> merge-ids (type-pi-ids a) (type-pi-ids b)
    UTuple fields -> type-pi-ids fields
    UForall qs body -> type-pi-ids body
    UArg a rest -> merge-ids (type-pi-ids a) (type-pi-ids rest)
    other -> Nil
  pi-escaping-metas :: List Nat -> List Nat -> Store -> List Nat -> List Nat
  pi-escaping-metas binders ordered st escaped = case ordered of
    Nil -> escaped
    Cons id rest -> case find-cell id st of
      Some (MkCell key level kind solution) ->
        let local = any-pending (kind-free-bound (normalize-kind st kind)) binders || any-pending (kind-metas st kind) escaped in
        pi-escaping-metas binders rest st (if local then Cons id escaped else escaped)
      None -> pi-escaping-metas binders rest st escaped

  -- Source binders must be fresh for quantified locals too: scheme-bound
  -- identities need not have been allocated by this Store's meta supply.
  fresh-for-types :: List UType -> Store -> (Nat, Store)
  fresh-for-types types st = case types of
    Nil -> fresh-id st
    Cons ty rest -> fresh-for-types rest (reserve-type-ids (normalize st ty) UEnd st)
  pi-dependent :: UType -> Bool
  pi-dependent ty = case ty of
    UPi id name domain row result -> contains-id id (merge-ids (type-free-bound row) (type-free-bound result))
    UUsageArrow usage arrow -> pi-dependent arrow
    other -> False

  -- Core compares contracts after lexical scope checking; binder levels are
  -- inference bookkeeping, while numeric identities still determine values.
  without-index-levels :: UType -> UType
  without-index-levels ty = case ty of
    UCompare relation left right -> UCompare relation (without-index-levels left) (without-index-levels right)
    UPropAnd left right -> UPropAnd (without-index-levels left) (without-index-levels right)
    UPropOr left right -> UPropOr (without-index-levels left) (without-index-levels right)
    UPropNot body -> UPropNot (without-index-levels body)
    UPropNonZero body -> UPropNonZero (without-index-levels body)
    UPropNotNull body -> UPropNotNull (without-index-levels body)
    UPropAscii body -> UPropAscii (without-index-levels body)
    UPropOrdered body -> UPropOrdered (without-index-levels body)
    UPropNonZeroPending body -> UPropNonZeroPending (without-index-levels body)
    URequire predicates body -> URequire (without-index-levels predicates) (without-index-levels body)
    URefine id name carrier predicate -> URefine id name (without-index-levels carrier) (without-index-levels predicate)
    UIndexForget value -> UIndexForget (without-index-levels value)
    UIndexByteLength value -> UIndexByteLength (without-index-levels value)
    UIndexBorrowRead value -> UIndexBorrowRead (without-index-levels value)
    UIndexList element fields -> UIndexList (without-index-levels element) (without-index-levels fields)
    UIndexCall function args -> UIndexCall function (without-index-levels args)
    UIndexPromote value -> UIndexPromote (without-index-levels value)
    UIndexMath op left right -> UIndexMath op (without-index-levels left) (without-index-levels right)
    UPi id name domain row result -> UPi id name (without-index-levels domain) (without-index-levels row) (without-index-levels result)
    UApp f x -> UApp (without-index-levels f) (without-index-levels x)
    UFun a b -> UFun (without-index-levels a) (without-index-levels b)
    UFunEff a row b -> UFunEff (without-index-levels a) (without-index-levels row) (without-index-levels b)
    UUsageArrow usage arrow -> UUsageArrow usage (without-index-levels arrow)
    UProofFun a row b -> UProofFun (without-index-levels a) (without-index-levels row) (without-index-levels b)
    URow labels -> URow (without-index-levels labels)
    URowJoin a b -> URowJoin (without-index-levels a) (without-index-levels b)
    UTuple fields -> UTuple (without-index-levels fields)
    UForall qs body -> UForall qs (without-index-levels body)
    UArg x rest -> UArg (without-index-levels x) (without-index-levels rest)
    UIndex carrier value -> UIndex (without-index-levels carrier) (index-without-levels value)
    UCon name k -> UCon name (map-kind-types without-index-levels k)
    UBound id name k -> UBound id name (map-kind-types without-index-levels k)
    URigid id name level k -> let kind = map-kind-types without-index-levels k in
      (case value-carrier kind of
        Some carrier -> UIndex carrier (IRigid id name 0)
        None -> URigid id name level kind)
    UMeta id k -> UMeta id (map-kind-types without-index-levels k)
    other -> ty
  index-without-levels :: IndexTerm -> IndexTerm
  index-without-levels term = case term of
    IRigid id name level -> IRigid id name 0
    IApply f x -> IApply (index-without-levels f) (index-without-levels x)
    ILambda id name body -> ILambda id name (index-without-levels body)
    IAdd a b -> IAdd (index-without-levels a) (index-without-levels b)
    ISubtract a b -> ISubtract (index-without-levels a) (index-without-levels b)
    IMultiply a b -> IMultiply (index-without-levels a) (index-without-levels b)
    other -> term

  pending-number :: Span -> UType -> Int -> Store -> Store
  pending-number sp ty value st = case st of MkStore label next level cells errors numbers in-law depth -> MkStore label next level cells errors (Cons (PendingNumber sp ty value) numbers) in-law depth
  -- Primitive equality may see a literal's still-unsolved carrier through
  -- a generic call or constructor. Check it after ordinary constraints and
  -- numeric defaulting; never invent an Eq dictionary or default a skolem.
  pending-comparison :: Span -> UType -> List String -> Store -> Store
  pending-comparison sp ty allowed st = case st of
    MkStore label next level cells errors numbers in-law depth -> MkStore label next level cells errors (Cons (PendingComparison sp ty allowed) numbers) in-law depth
  pending-numbers :: Store -> List PendingNumber
  pending-numbers st = case st of MkStore label next level cells errors numbers in-law depth -> numbers
  number-meta-ids :: List PendingNumber -> Store -> List Nat
  number-meta-ids checks st = case checks of
    Nil -> Nil
    Cons (PendingNumber sp ty value) rest -> merge-ids (free-metas st ty) (number-meta-ids rest st)
    Cons (PendingComparison sp ty allowed) rest -> number-meta-ids rest st
  default-number-checks :: List Nat -> List PendingNumber -> Store -> Store
  default-number-checks wanted checks st = case checks of
    Nil -> st
    Cons (PendingComparison sp ty allowed) rest -> default-number-checks wanted rest st
    Cons (PendingNumber sp ty value) rest -> (case normalize st ty of
      UMeta id KType -> default-number-checks wanted rest (if contains-id id wanted then unify sp ty (UCon "Int" KType) st else st)
      other -> default-number-checks wanted rest st)
  default-numbers-for :: UType -> Store -> Store
  default-numbers-for wanted st = default-number-checks (free-metas st wanted) (pending-numbers st) st
  number-carrier :: UType -> UType
  number-carrier ty = case refinement-view ty of URefine id name carrier predicate -> number-carrier carrier; other -> ty
  check-number-checks :: List PendingNumber -> Store -> Store
  check-number-checks checks st = case checks of
    Nil -> st
    Cons (PendingComparison sp ty allowed) rest ->
      let valid = case normalize st ty of UCon name KType -> comparison-name name allowed; other -> False in
      check-number-checks rest (if valid then st else add-error sp "equality needs an Eq dictionary for this type" st)
    Cons (PendingNumber sp ty value) rest -> let carrier = number-carrier (normalize st ty) in
      check-number-checks rest (if number-literal-valid carrier value then st else add-error sp (number-literal-error carrier value "literal is outside its resolved integer carrier") st)
  comparison-name :: String -> List String -> Bool
  comparison-name name allowed = case allowed of Nil -> False; Cons first rest -> same-tag name first || comparison-name name rest
  finish-numbers :: Store -> Store
  finish-numbers st = let checks = pending-numbers st in
    let defaulted = default-number-checks (number-meta-ids checks st) checks st in
    let checked = check-number-checks checks defaulted in
    case checked of MkStore label next level cells errors numbers in-law depth -> MkStore label next level cells errors Nil in-law depth
