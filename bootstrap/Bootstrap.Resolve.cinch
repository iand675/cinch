-- Source-module scope elaboration. A resolved fragment has one global
-- namespace, with lexical bindings left local and module-private names
-- given distinct internal spellings. No import is discarded before its
-- source, selection, alias and export surface have been checked.
module Bootstrap.Resolve where

  import Bootstrap.Ast
  import Bootstrap.Nominal (interface-global, kernel-type-name)
  import Bootstrap.Builtin (builtin-bindings, builtin-declarations, finite-index-declaration)
  import Bootstrap.Report (Diagnostic, MkDiagnostic)
  import Bootstrap.Load (LoadedInterface, loaded-module, loaded-exports, validate-interface-set)
  import Bootstrap.Contracts (public-global, interface-headers, interface-declarations, materialize-externals, declaration-references, imported-class-references)
  import Bootstrap.Parse (exported-fixities)
  import Text.Lex (Span, span-start, span-end)
  import Data.Json
  import Algebra.Semigroup

  export resolve-program, resolve-program-with, resolve-overlay-with

  -- Visible spelling, defining module, internal global spelling.
  data Binding where
    MkBinding :: String -> String -> String -> Binding

  -- Imported path, visible qualifier, alias-only, selected surface.
  data View where
    MkView :: Span -> String -> String -> Bool -> List Binding -> View

  -- An already processed module's export surface and elaborated body.
  data Scoped where
    MkScoped :: String -> List Binding -> List Decl -> Scoped

  same :: String -> String -> Bool
  same a b = string-compare a b == 0

  cat :: List String -> String
  cat parts = string-concat-all parts

  fail :: Span -> String -> List Diagnostic
  fail sp text = Cons (MkDiagnostic "bootstrap.resolve" sp text) Nil

  has-name :: String -> List String -> Bool
  has-name name names = case names of
    Nil -> False
    Cons n rest -> same name n || has-name name rest

  lookup-binding :: String -> List Binding -> Option Binding
  lookup-binding name entries = case entries of
    Nil -> None
    Cons b rest -> case b of
      MkBinding visible owner symbol -> if same name visible then Some b else lookup-binding name rest

  binding-name :: Binding -> String
  binding-name b = case b of
    MkBinding name owner symbol -> name

  binding-symbol :: Binding -> String
  binding-symbol b = case b of
    MkBinding name owner symbol -> symbol

  kernel-bindings :: List (String, String) -> List Binding
  kernel-bindings entries = case entries of
    Nil -> Nil
    Cons (name, symbol) rest -> Cons (MkBinding name "<builtin>" symbol) (kernel-bindings rest)

  scoped-name :: Scoped -> String
  scoped-name s = case s of
    MkScoped name surface body -> name

  lookup-scoped :: String -> List Scoped -> Option Scoped
  lookup-scoped name done = case done of
    Nil -> None
    Cons s rest -> if same name (scoped-name s) then Some s else lookup-scoped name rest

  has-module :: String -> List Module -> Bool
  has-module name modules = case modules of
    Nil -> False
    Cons m rest -> same name (module-name m) || has-module name rest

  -- Decimal scalar codes separated by underscores are injective. The dot
  -- keeps these internal globals distinct from every lexical identifier.
  -- All resulting characters are legal in an unquoted LLVM name.
  encode-chars :: List Char -> String
  encode-chars chars = case chars of
    Nil -> ""
    Cons c rest -> cat [nat-to-string (char-code c), "_", encode-chars rest]

  global-name :: String -> String -> String
  global-name home name = if same home "Main" && same name "main" then "main"
    else cat ["m.", encode-chars (unpack home), ".", encode-chars (unpack name)]

  short-name :: String -> String
  short-name text = pack (short-chars (unpack text) Nil)

  short-chars :: List Char -> List Char -> List Char
  short-chars chars acc = case chars of
    Nil -> reverse acc
    Cons c rest -> if char-code c == 46 then short-chars rest Nil else short-chars rest (Cons c acc)

  qualify :: String -> List Binding -> List Binding
  qualify prefix entries = case entries of
    Nil -> Nil
    Cons (MkBinding name owner symbol) rest -> Cons (MkBinding (cat [prefix, ".", name]) owner symbol) (qualify prefix rest)

  -- A module's signature and equations name the same binding. Duplicate
  -- declarations stay in the body for the checker to diagnose.
  own-bindings :: String -> List Decl -> List Binding -> List Binding
  own-bindings home ds acc = case ds of
    Nil -> reverse acc
    Cons d rest -> case d of
      DImport s path mods alias members args -> own-bindings home rest acc
      DExport s text items -> own-bindings home rest acc
      DInstance s only name params class-app members -> own-bindings home rest (add-own home name acc)
      DClass s name params members -> own-bindings home rest (own-class-methods home (decls-of members) (add-own home name acc))
      DData s name params ctors -> own-bindings home rest (own-ctors home ctors (add-own home name acc))
      DEffect s name params ops -> own-bindings home rest (own-ctors home ops (add-own home name acc))
      DForeign s direction abi symbol name ty -> own-bindings home rest (if same direction "import" then add-own home name acc else acc)
      other -> case decl-name other of
        None -> own-bindings home rest acc
        Some name -> own-bindings home rest (add-own home name acc)

  add-own :: String -> String -> List Binding -> List Binding
  add-own home name entries = case lookup-binding name entries of
    Some b -> entries
    None -> Cons (MkBinding name home (global-name home name)) entries

  own-class-methods :: String -> List Decl -> List Binding -> List Binding
  own-class-methods home ds acc = case ds of
    Nil -> acc
    Cons (DSig s name ty) rest -> own-class-methods home rest (add-own home name acc)
    Cons other rest -> own-class-methods home rest acc

  own-ctors :: String -> List (String, TypeExpr) -> List Binding -> List Binding
  own-ctors home ctors acc = case ctors of
    Nil -> acc
    Cons (name, ty) rest -> own-ctors home rest (add-own home name acc)

  validate-modules :: List Module -> List Scoped -> List Module -> List String -> List Diagnostic
  validate-modules all interfaces remaining seen = case remaining of
    Nil -> Nil
    Cons m rest ->
      (if has-name (module-name m) seen then fail (module-span m) (cat ["duplicate module: ", module-name m]) else Nil)
      <> (case lookup-scoped (module-name m) interfaces of None -> Nil; Some i -> fail (module-span m) "source module conflicts with a loaded interface")
      <> validate-imports all interfaces (module-decls m)
      <> validate-modules all interfaces rest (Cons (module-name m) seen)

  validate-imports :: List Module -> List Scoped -> List Decl -> List Diagnostic
  validate-imports all interfaces ds = case ds of
    Nil -> Nil
    Cons d rest -> (case d of
      DImport s path mods alias members args ->
        (if has-module path all then Nil else case lookup-scoped path interfaces of
          Some i -> Nil
          None -> fail s (cat ["missing source module or checked interface: ", path]))
        <> (case mods of Nil -> Nil; Cons mode more -> fail s "modified imports require stage/module-argument elaboration")
        <> (case args of Nil -> Nil; Cons arg more -> fail s "applied imports require module-argument elaboration")
      other -> Nil) <> validate-imports all interfaces rest

  imports-ready :: List Decl -> List Scoped -> Bool
  imports-ready ds done = case ds of
    Nil -> True
    Cons d rest -> case d of
      DImport s path mods alias members args -> case lookup-scoped path done of
        None -> False
        Some ready -> imports-ready rest done
      other -> imports-ready rest done

  pick-ready :: List Module -> List Scoped -> List Module -> Option (Module, List Module)
  pick-ready remaining done before = case remaining of
    Nil -> None
    Cons m rest -> if imports-ready (module-decls m) done then Some (m, reverse before <> rest)
      else pick-ready rest done (Cons m before)

  select-members :: Span -> String -> List (String, Option String) -> List Binding -> (List Binding, List Diagnostic)
  select-members sp path members surface = case members of
    Nil -> (Nil, Nil)
    Cons (name, alias) rest -> case select-members sp path rest surface of
      (others, errors) -> case lookup-binding name surface of
        None -> (others, fail sp (cat [path, " has no exported member: ", name]) <> errors)
        Some (MkBinding visible owner symbol) ->
          (Cons (MkBinding (case alias of None -> name; Some renamed -> renamed) owner symbol) others, errors)

  import-views :: List Decl -> List Scoped -> (List View, List Diagnostic)
  import-views ds done = case ds of
    Nil -> (Nil, Nil)
    Cons d rest -> case import-views rest done of
      (views, errors) -> case d of
        DImport s path mods alias members args -> case lookup-scoped path done of
          None -> (views, fail s (cat ["module was not resolved before its importer: ", path]) <> errors)
          Some (MkScoped home surface body) -> case (case members of Nil -> (surface, Nil); Cons first more -> select-members s path members surface) of
            (selected, failures) ->
              (Cons (MkView s path (case alias of None -> short-name path; Some qualifier -> qualifier)
                (case alias of None -> False; Some qualifier -> case members of Nil -> True; Cons item more -> False) selected) views, failures <> errors)
        other -> (views, errors)

  -- Explicit imports have an eager duplicate-name rule even when an declared
  -- declaration shadows the name. Qualified-only aliases add no bare names.
  bare-imports :: List View -> List Binding -> (List Binding, List Diagnostic)
  bare-imports views acc = case views of
    Nil -> (reverse acc, Nil)
    Cons (MkView s path qualifier only selected) rest -> if only then bare-imports rest acc
      else case merge-imports s selected acc of
        (entries, errors) -> case bare-imports rest entries of
          (all, more) -> (all, errors <> more)

  merge-imports :: Span -> List Binding -> List Binding -> (List Binding, List Diagnostic)
  merge-imports sp incoming acc = case incoming of
    Nil -> (acc, Nil)
    Cons b rest -> case b of
      MkBinding name home symbol -> case lookup-binding name acc of
        None -> merge-imports sp rest (Cons b acc)
        Some (MkBinding old previous prior) -> case merge-imports sp rest acc of
          (entries, errors) -> (entries, fail sp (cat ["name ", name, " is imported from both ", previous, " and ", home]) <> errors)

  qualified-imports :: List View -> List Binding
  qualified-imports views = case views of
    Nil -> Nil
    Cons (MkView s path qualifier only selected) rest -> qualify qualifier selected <> qualified-imports rest

  qualified-duplicates :: Span -> List Binding -> List Binding -> List Diagnostic
  qualified-duplicates sp incoming seen = case incoming of
    Nil -> Nil
    Cons b rest -> case lookup-binding (binding-name b) seen of
      None -> qualified-duplicates sp rest (Cons b seen)
      Some old -> (if same (binding-symbol old) (binding-symbol b) then Nil else fail sp (cat ["ambiguous qualified import: ", binding-name b]))
        <> qualified-duplicates sp rest seen

  export-items :: List Decl -> List ExportItem
  export-items ds = case ds of
    Nil -> Nil
    Cons d rest -> case d of
      DExport s text items -> items <> export-items rest
      other -> export-items rest

  has-export-declaration :: List Decl -> Bool
  has-export-declaration declarations = case declarations of
    Nil -> False
    Cons (DExport site text items) rest -> True
    Cons other rest -> has-export-declaration rest

  lookup-view :: String -> List View -> Option View
  lookup-view name views = case views of
    Nil -> None
    Cons v rest -> case v of
      MkView s path qualifier only selected -> if same name path || same name qualifier then Some v else lookup-view name rest

  join-parts :: List String -> String
  join-parts parts = case parts of
    Nil -> ""
    Cons first Nil -> first
    Cons first rest -> cat [first, ".", join-parts rest]

  last-part :: List String -> String
  last-part parts = case parts of
    Nil -> ""
    Cons first Nil -> first
    Cons first rest -> last-part rest

  add-exports :: Span -> List Binding -> List Binding -> (List Binding, List Diagnostic)
  add-exports sp incoming acc = case incoming of
    Nil -> (acc, Nil)
    Cons b rest -> case lookup-binding (binding-name b) acc of
      None -> add-exports sp rest (Cons b acc)
      Some old -> case add-exports sp rest acc of
        (entries, errors) -> (entries, (if same (binding-symbol old) (binding-symbol b) then Nil else fail sp (cat ["duplicate export: ", binding-name b])) <> errors)

  build-exports :: List ExportItem -> List Binding -> List View -> List Binding -> (List Binding, List Diagnostic)
  build-exports items visible views acc = case items of
    Nil -> (reverse acc, Nil)
    Cons item rest -> case item of
      ExportName s parts -> case lookup-binding (join-parts parts) visible of
        None -> case build-exports rest visible views acc of
          (entries, errors) -> (entries, fail s (cat ["name is not in scope to export: ", join-parts parts]) <> errors)
        Some (MkBinding name home symbol) -> case add-exports s (Cons (MkBinding (last-part parts) home symbol) Nil) acc of
          (entries, errors) -> case build-exports rest visible views entries of
            (surface, more) -> (surface, errors <> more)
      ExportModule s name -> case lookup-view name views of
        None -> case build-exports rest visible views acc of
          (entries, errors) -> (entries, fail s (cat ["module is not imported to export: ", name]) <> errors)
        Some (MkView sp path qualifier only selected) -> case add-exports s selected acc of
          (entries, errors) -> case build-exports rest visible views entries of
            (surface, more) -> (surface, errors <> more)

  module-visibility :: Module -> List Scoped -> List Binding -> (List Binding, List Binding, List View, List Diagnostic)
  module-visibility m done base =
    let home = module-name m in
    let declared = own-bindings home (module-decls m) Nil in
    let (views, errors) = import-views (module-decls m) done in
    let (bare, clashes) = bare-imports views Nil in
    let qualified = qualified-imports views in
    let prelude-bindings = case lookup-scoped "Prelude" done of None -> base; Some (MkScoped n surface body) -> surface in
    let visible = declared <> qualify home declared <> bare <> qualified <> prelude-bindings <> kernel-bindings builtin-bindings in
    (declared, visible, views, errors <> clashes <> qualified-duplicates (module-span m) qualified Nil)
  build-scope :: Module -> List Scoped -> List Binding -> (Scoped, List Diagnostic)
  build-scope m done base =
    let home = module-name m in
    let (declared, visible, views, visibility-errors) = module-visibility m done base in
    let (surface, export-errors) = case export-items (module-decls m) of
          Nil -> (if has-export-declaration (module-decls m) then Nil else declared, Nil)
          Cons first rest -> build-exports (Cons first rest) visible views Nil in
    let (body, body-errors) = rename-decls home visible (module-decls m) in
    (MkScoped home surface body, visibility-errors <> export-errors <> body-errors)

  resolve-ordered :: List Module -> List Scoped -> List Binding -> (List Scoped, List Diagnostic)
  resolve-ordered remaining done base = case remaining of
    Nil -> (reverse done, Nil)
    Cons first rest -> case pick-ready remaining done Nil of
      None -> (reverse done, fail (module-span first) (cat ["cyclic module imports involving ", module-name first]))
      Some (m, pending) -> case build-scope m done base of
        (ready, errors) -> case resolve-ordered pending (Cons ready done) base of
          (ordered, more) -> (ordered, errors <> more)

  scoped-decls :: List Scoped -> List Decl
  scoped-decls modules = case modules of
    Nil -> Nil
    Cons (MkScoped home surface ds) rest -> ds <> scoped-decls rest

  -- Type variables and dependent binders remain local. Only names in the
  -- module's visible global surface are rewritten here; the checker owns
  -- kind checking and unknown type diagnostics.
  type-name :: List Binding -> List String -> String -> String
  type-name visible locals name = if has-name name locals then name else case lookup-binding name visible of
    None -> name
    Some b -> if has-name (annotation-type-local name) locals then name else binding-symbol b

  -- A term annotation can shadow a type name while the same spelling
  -- still resolves to a value in its body.
  annotation-type-local :: String -> String
  annotation-type-local name = string-concat "#type:" name
  annotation-type-locals :: TypeExpr -> List String
  annotation-type-locals ty = case ty of
    TForall sp binders body -> map annotation-type-local (bound-names binders)
    other -> Nil

  bound-names :: TypeExpr -> List String
  bound-names t = case t of
    TBound s name kind rest -> Cons name (bound-names rest)
    TQuantifier s name only kind rest -> Cons name (bound-names rest)
    other -> Nil

  -- A leading precondition can mention any named argument of this
  -- function. Names belonging to a callback's own arguments stay inside
  -- that callback and must not hide module globals in the outer context.
  argument-names :: TypeExpr -> List String
  argument-names t = case t of
    TFun s domain result -> bound-names domain <> argument-names result
    TFunEff s domain row result -> bound-names domain <> argument-names result
    TUsageArrow s usage arrow -> argument-names arrow
    TUsing s bounds body -> argument-names body
    TForall s binders body -> argument-names body
    other -> Nil

  -- The closed structural predicate vocabulary is syntax in a predicate
  -- position. A same-spelled refinement constructor in carrier position
  -- still resolves to its real defining module.
  rename-predicate :: List Binding -> List String -> TypeExpr -> TypeExpr
  rename-predicate visible locals syntax = case syntax of
    TName s name -> if same name "NonZero" then syntax else rename-type visible locals syntax
    TApp s (TName at name) (TArg arg input (TArgsEnd end)) ->
      if has-name name ["NonZero", "NotNull"] then TApp s (TName at name) (TArg arg (rename-type visible locals input) (TArgsEnd end))
      else rename-type visible locals syntax
    TInfix s op first second -> TInfix s op (rename-predicate visible locals first) (rename-predicate visible locals second)
    other -> rename-type visible locals syntax
  rename-proof-bounds :: List Binding -> List String -> TypeExpr -> TypeExpr
  rename-proof-bounds visible locals syntax = case syntax of
    TBound s name app rest -> TBound s name (rename-predicate visible locals app) (rename-proof-bounds visible (Cons name locals) rest)
    other -> rename-type visible locals syntax

  rename-type :: List Binding -> List String -> TypeExpr -> TypeExpr
  rename-type visible locals t = case t of
    TName s name -> TName s (type-name visible locals name)
    TIndex s digits -> t
    TNegate s x -> TNegate s (rename-type visible locals x)
    TInfix s op a b -> TInfix s op (rename-type visible locals a) (rename-type visible locals b)
    TRefined s predicate carrier -> TRefined s (rename-predicate visible locals predicate) (rename-type visible locals carrier)
    TApp s (TName at name) (TArg first a (TArg second b (TArgsEnd end))) | same name "Eq" ->
      TApp s (TName at name) (TArg first (rename-predicate visible locals a) (TArg second (rename-predicate visible locals b) (TArgsEnd end)))
    TApp s head args -> TApp s (rename-type visible locals head) (rename-type visible locals args)
    TFun s a b -> TFun s (rename-type visible locals a) (rename-type visible (bound-names a <> locals) b)
    TFunEff s a row b -> TFunEff s (rename-type visible locals a) (rename-type visible (bound-names a <> locals) row) (rename-type visible (bound-names a <> locals) b)
    TUsageArrow s usage arrow -> TUsageArrow s usage (rename-type visible locals arrow)
    TRow s labels tail -> TRow s (rename-type visible locals labels) tail
    TTuple s args -> TTuple s (rename-type visible locals args)
    TForall s binders body -> TForall s (rename-type visible locals binders) (rename-type visible (bound-names binders <> locals) body)
    TQuantifier s name only kind rest -> TQuantifier s name only (rename-type visible locals kind) (rename-type visible (Cons name locals) rest)
    TUsing s bounds body -> TUsing s (rename-proof-bounds visible (argument-names body <> locals) bounds) (rename-type visible (bound-names bounds <> locals) body)
    TArg s a rest -> TArg s (rename-type visible locals a) (rename-type visible locals rest)
    TBound s name kind rest -> TBound s name (rename-type visible locals kind) (rename-type visible (Cons name locals) rest)
    other -> t

  parameter-names :: List TypeParam -> List String
  parameter-names params = case params of
    Nil -> Nil
    Cons p rest -> Cons (param-name p) (parameter-names rest)

  rename-params :: List Binding -> List String -> List TypeParam -> List TypeParam
  rename-params visible locals params = case params of
    Nil -> Nil
    Cons (MkTypeParam s name kind only) rest ->
      Cons (MkTypeParam s name (case kind of None -> None; Some t -> Some (rename-type visible locals t)) only)
        (rename-params visible (Cons name locals) rest)

  rename-ctors :: String -> List Binding -> List String -> List (String, TypeExpr) -> List (String, TypeExpr)
  rename-ctors home visible locals ctors = case ctors of
    Nil -> Nil
    Cons (name, ty) rest -> Cons (global-name home name, rename-type visible locals ty) (rename-ctors home visible locals rest)

  -- Labels belong to the record. Only their field types use module names.
  rename-record-fields :: List Binding -> List String -> List (String, TypeExpr) -> List (String, TypeExpr)
  rename-record-fields visible locals fields = case fields of
    Nil -> Nil
    Cons (name, ty) rest -> Cons (name, rename-type visible locals ty) (rename-record-fields visible locals rest)

  pattern-names :: Pat -> List String
  pattern-names p = case p of
    PVar s name -> Cons name Nil
    PCon s name args -> pattern-names args
    PRecord s name fields -> pattern-names fields
    PRecordField s name value rest -> pattern-names value <> pattern-names rest
    PTuple s args -> pattern-names args
    PList s args -> pattern-names args
    PAs s name inner -> Cons name (pattern-names inner)
    PAnn s inner ty -> pattern-names inner
    PArg s first rest -> pattern-names first <> pattern-names rest
    other -> Nil

  patterns-names :: List Pat -> List String
  patterns-names ps = case ps of
    Nil -> Nil
    Cons p rest -> pattern-names p <> patterns-names rest

  qualifier-tail :: List Char -> List Char
  qualifier-tail chars = case chars of
    Nil -> Nil
    Cons c rest -> if char-code c == 46 then rest else qualifier-tail rest

  name-qualifier :: String -> String
  name-qualifier name = pack (reverse (qualifier-tail (reverse (unpack name))))

  visible-qualifier :: String -> List Binding -> Bool
  visible-qualifier qualifier bindings = case bindings of
    Nil -> False
    Cons binding rest -> same qualifier (name-qualifier (binding-name binding)) || visible-qualifier qualifier rest

  resolve-use :: Span -> Bool -> List Binding -> List String -> String -> (String, List Diagnostic)
  resolve-use sp constructor visible locals name = if has-name name locals && not constructor then (name, Nil)
    else case lookup-binding name visible of
      Some b -> (binding-symbol b, Nil)
      None -> if constructor && (same name "True" || same name "False") then (name, Nil)
        else let qualifier = name-qualifier name in
          if constructor && string-length qualifier > 0 && visible-qualifier qualifier visible then
            (name, fail sp (cat ["unknown constructor ", name, ": not exported into this scope"]))
          else (name, fail sp (cat ["name is not in scope: ", name]))

  list-pattern :: Span -> Pat -> Pat
  list-pattern sp fields = case fields of
    PArgsEnd at -> PCon sp (interface-global "Data.Core.Nil") (PArgsEnd sp)
    PArg at first rest -> PCon sp (interface-global "Data.Core.Cons") (PArg at first (PArg at (list-pattern sp rest) (PArgsEnd at)))
    other -> PUnmodeled sp "invalid list pattern spine"
  rename-pat :: List Binding -> Pat -> (Pat, List Diagnostic)
  rename-pat visible p = case p of
    PRecord s name fields -> case resolve-use s True visible Nil name of
      (symbol, errors) -> case rename-pat visible fields of
        (renamed, more) -> (PRecord s symbol renamed, errors <> more)
    PRecordField s name value rest -> case rename-pat visible value of
      (renamed, errors) -> case rename-pat visible rest of
        (more, others) -> (PRecordField s name renamed more, errors <> others)
    PCon s name args -> case resolve-use s True visible Nil name of
      (symbol, errors) -> case rename-pat visible args of
        (renamed, more) -> (PCon s symbol renamed, errors <> more)
    PTuple s args -> case rename-pat visible args of
      (renamed, errors) -> (PTuple s renamed, errors)
    PList s args -> case rename-pat visible args of
      (renamed, errors) -> (list-pattern s renamed, errors)
    PAs s name inner -> case rename-pat visible inner of
      (renamed, errors) -> (PAs s name renamed, errors)
    PAnn s inner ty -> case rename-pat visible inner of
      (renamed, errors) -> (PAnn s renamed (rename-type visible (pattern-names inner) ty), errors)
    PArg s first rest -> case rename-pat visible first of
      (a, errors) -> case rename-pat visible rest of
        (b, more) -> (PArg s a b, errors <> more)
    PUnmodeled s text -> (p, fail s (cat ["unmodeled pattern: ", text]))
    other -> (p, Nil)

  rename-pats :: List Binding -> List Pat -> (List Pat, List Diagnostic)
  rename-pats visible ps = case ps of
    Nil -> (Nil, Nil)
    Cons p rest -> case rename-pat visible p of
      (renamed, errors) -> case rename-pats visible rest of
        (others, more) -> (Cons renamed others, errors <> more)

  rename-bindings :: List Binding -> List String -> Expr -> (Expr, List String, List Diagnostic)
  rename-bindings visible locals bs = case bs of
    EBindingsEnd s -> (bs, locals, Nil)
    EBinding s name rhs rest -> case rename-expr visible locals rhs of
      (body, errors) -> case rename-bindings visible (Cons name locals) rest of
        (others, names, more) -> (EBinding s name body others, names, errors <> more)
    other -> (bs, locals, fail (expr-span bs) "malformed lexical binding spine")

  rename-alts :: List Binding -> List String -> Expr -> (Expr, List Diagnostic)
  rename-alts visible locals alts = case alts of
    EAltsEnd s -> (alts, Nil)
    EAlt s pat body rest -> case rename-pat visible pat of
      (renamed, errors) -> case rename-expr visible (pattern-names pat <> locals) body of
        (rhs, more) -> case rename-alts visible locals rest of
          (others, tail-errors) -> (EAlt s renamed rhs others, errors <> more <> tail-errors)
    other -> (alts, fail (expr-span alts) "malformed case alternative spine")

  builtin-decision-use :: List Binding -> List String -> Expr -> Bool
  builtin-decision-use visible locals expression = case expression of
    EVar sp name -> not (has-name name locals) && (case lookup-binding name visible of Some binding -> same (binding-symbol binding) "b.decide"; None -> False)
    other -> False
  -- In a branch test, the structural former may also have the standard
  -- refinement constructor in scope. A distinct constructor keeps its
  -- ordinary binding and type.
  branch-predicate-former :: List Binding -> String -> Bool
  branch-predicate-former visible name = has-name name ["NonZero", "NotNull"] && (case lookup-binding name visible of
    Some binding -> same name "NonZero" && same (binding-symbol binding) (interface-global "Algebra.Arithmetic.NonZero")
    None -> True)
  branch-literal :: String -> Expr -> Bool
  branch-literal expected syntax = case syntax of
    ECon sp name (EArgsEnd end) -> same name expected
    other -> False
  rename-branch-value :: List Binding -> List String -> Expr -> (Expr, List Diagnostic)
  rename-branch-value visible locals syntax = case syntax of
    ECon sp name (EArg at input (EArgsEnd end)) | branch-predicate-former visible name ->
      (case rename-expr visible locals input of
        (value, errors) -> (ECon sp ("#condition." <> name) (EArg at value (EArgsEnd end)), errors))
    EApp sp (ECon at name (EArgsEnd end)) input | branch-predicate-former visible name ->
      rename-branch-value visible locals (ECon sp name (EArg at input (EArgsEnd end)))
    EApp sp (EVar at name) input -> (case lookup-binding name visible of
      Some binding | not (has-name name locals) && same (binding-symbol binding) (interface-global "Data.Bool.not") ->
        (case rename-branch-value visible locals input of
          (value, errors) -> (EApp sp (EVar at (binding-symbol binding)) value, errors))
      other -> rename-expr visible locals syntax)
    other -> rename-expr visible locals syntax
  -- Predicate operators denote logical operations here. Ordinary applications
  -- retain their declaration-owned bindings and cannot become decision authority.
  rename-decision-syntax :: List Binding -> List String -> Expr -> (Expr, List Diagnostic)
  rename-decision-syntax visible locals syntax = case syntax of
    ECon sp name arguments -> if has-name name ["NonZero", "NotNull", "Not", "True", "False"] then
      (case rename-decision-syntax visible locals arguments of (args, errors) -> (ECon sp name args, errors)) else rename-expr visible locals syntax
    EApp sp (ECon at name (EArgsEnd end)) input -> if has-name name ["NonZero", "NotNull", "Not"] then
      (case rename-decision-syntax visible locals input of (argument, errors) -> (EApp sp (ECon at name (EArgsEnd end)) argument, errors)) else rename-expr visible locals syntax
    EApp sp (EVar at name) input -> if same name "Not" then (case rename-decision-syntax visible locals input of (argument, errors) -> (EApp sp (EVar at name) argument, errors)) else rename-expr visible locals syntax
    EBin sp operation first second -> if has-name operation ["+", "-", "*", "<", "<=", ">", ">=", "==", "/=", "&&", "||"] then
      (case rename-decision-syntax visible locals first of (left, errors) -> case rename-decision-syntax visible locals second of (right, more) -> (EBin sp operation left right, errors <> more)) else rename-expr visible locals syntax
    EIf sp condition yes no -> (case rename-decision-syntax visible locals condition of
      (test, errors) -> case rename-decision-syntax visible locals yes of
        (positive, more) -> case rename-decision-syntax visible locals no of
          (negative, others) -> (EIf sp test positive negative, errors <> more <> others))
    ENeg sp input -> (case rename-decision-syntax visible locals input of (value, errors) -> (ENeg sp value, errors))
    EAnn sp input annotation -> (case rename-decision-syntax visible locals input of (value, errors) -> (EAnn sp value (rename-type visible locals annotation), errors))
    EArg sp first rest -> (case rename-decision-syntax visible locals first of (value, errors) -> case rename-decision-syntax visible locals rest of (more, others) -> (EArg sp value more, errors <> others))
    EArgsEnd sp -> (syntax, Nil)
    other -> rename-expr visible locals syntax
  rename-do :: List Binding -> List String -> Expr -> (Expr, List Diagnostic)
  rename-do visible locals statements = case statements of
    EArgsEnd sp -> (statements, Nil)
    EArg sp (EBind at name rhs) rest -> (case rename-expr visible locals rhs of
      (value, errors) -> case rename-do visible (if same name "_" then locals else Cons name locals) rest of
        (more, others) -> (EArg sp (EBind at name value) more, errors <> others))
    EArg sp (ELet at bindings (EUnit end)) rest -> (case rename-bindings visible locals bindings of
      (values, names, errors) -> case rename-do visible names rest of
        (more, others) -> (EArg sp (ELet at values (EUnit end)) more, errors <> others))
    EArg sp first rest -> (case rename-expr visible locals first of
      (value, errors) -> case rename-do visible locals rest of (more, others) -> (EArg sp value more, errors <> others))
    other -> (other, fail (expr-span other) "malformed do statement spine")
  rename-expr :: List Binding -> List String -> Expr -> (Expr, List Diagnostic)
  rename-expr visible locals e = case e of
    ERecord s name fields -> case resolve-use s True visible Nil name of
      (symbol, errors) -> case rename-expr visible locals fields of
        (renamed, more) -> (ERecord s symbol renamed, errors <> more)
    ERecordField s name value rest -> case rename-expr visible locals value of
      (renamed, errors) -> case rename-expr visible locals rest of
        (more, others) -> (ERecordField s name renamed more, errors <> others)
    EProject s value name -> case rename-expr visible locals value of
      (renamed, errors) -> (EProject s renamed name, errors)
    EVar s name -> case resolve-use s False visible locals name of
      (symbol, errors) -> (EVar s symbol, errors)
    ECon s name args -> case resolve-use s True visible Nil name of
      (symbol, errors) -> case rename-expr visible locals args of
        (renamed, more) -> (ECon s symbol renamed, errors <> more)
    ELitInt s digits -> (e, Nil)
    ELitFloat s digits -> (e, Nil)
    ELitStr s text -> (e, Nil)
    ELitChar s text -> (e, Nil)
    EUnit s -> (e, Nil)
    ETuple s args -> case rename-expr visible locals args of
      (renamed, errors) -> (ETuple s renamed, errors)
    EList s args -> case rename-expr visible locals args of
      (renamed, errors) -> (EList s renamed, errors)
    EApp s f a -> if builtin-decision-use visible locals f then
      (case rename-expr visible locals f of (head, errors) -> case rename-decision-syntax visible locals a of (argument, more) -> (EApp s head argument, errors <> more))
      else (case rename-expr visible locals f of
        (head, errors) -> case rename-expr visible locals a of
          (arg, more) -> (EApp s head arg, errors <> more))
    EBin s op a b -> case rename-expr visible locals a of
      (left, errors) -> case rename-expr visible locals b of
        (right, more) ->
          let rewritten = case lookup-binding op visible of
                None -> EBin s op left right
                Some binding -> EApp s (EApp s (EVar s (binding-symbol binding)) left) right in
          (rewritten, errors <> more)
    ENeg s x -> case rename-expr visible locals x of
      (renamed, errors) -> (ENeg s renamed, errors)
    ELam s ps body -> case rename-pats visible ps of
      (pats, errors) -> case rename-expr visible (patterns-names ps <> locals) body of
        (rhs, more) -> (ELam s pats rhs, errors <> more)
    ELet s bs body -> case rename-bindings visible locals bs of
      (bindings, names, errors) -> case rename-expr visible names body of
        (rhs, more) -> (ELet s bindings rhs, errors <> more)
    EDo sp statements -> (case rename-do visible locals statements of (renamed, errors) -> (EDo sp renamed, errors))
    EWith s bs body -> case rename-bindings visible locals bs of
      (bindings, names, errors) -> case rename-expr visible names body of
        (rhs, more) -> (EWith s bindings rhs, errors <> more)
    EHandle s body handled-by -> case rename-expr visible locals body of
      (renamed, errors) -> case rename-expr visible locals handled-by of
        (renamed-handler, more) -> (EHandle s renamed renamed-handler, errors <> more)
    EHandler s label clauses -> case rename-expr visible locals clauses of
      (renamed, errors) -> (EHandler s (rename-type visible locals label) renamed, errors)
    EHandlerClause s name pats continuation body rest -> case rename-pats visible pats of
      (renamed-pats, errors) ->
        let local-names = (case continuation of None -> Nil; Some k -> Cons k Nil) <> patterns-names pats <> locals in
        let (operation, op-errors) = if same name "return" then (name, Nil) else resolve-use s False visible Nil name in
        case rename-expr visible local-names body of
          (renamed-body, more) -> case rename-expr visible locals rest of
            (renamed-rest, tail-errors) -> (EHandlerClause s operation renamed-pats continuation renamed-body renamed-rest, errors <> op-errors <> more <> tail-errors)
    EHandlerEnd s -> (e, Nil)
    EIf s c a b -> case rename-branch-value visible locals c of
      (condition, errors) ->
        let (yes, more) = if branch-literal "False" b then rename-branch-value visible locals a else rename-expr visible locals a in
        let (no, tail-errors) = if branch-literal "True" a then rename-branch-value visible locals b else rename-expr visible locals b in
        (EIf s condition yes no, errors <> more <> tail-errors)
    ECase s scrut alts -> case rename-branch-value visible locals scrut of
      (value, errors) -> case rename-alts visible locals alts of
        (cases, more) -> (ECase s value cases, errors <> more)
    EGuarded s guard body -> case rename-branch-value visible locals guard of
      (condition, errors) -> case rename-expr visible locals body of
        (rhs, more) -> (EGuarded s condition rhs, errors <> more)
    EAnn s x ty -> case rename-expr visible (annotation-type-locals ty <> locals) x of
      (renamed, errors) -> (EAnn s renamed (rename-type visible locals ty), errors)
    EArg s first rest -> case rename-expr visible locals first of
      (a, errors) -> case rename-expr visible locals rest of
        (b, more) -> (EArg s a b, errors <> more)
    EArgsEnd s -> (e, Nil)
    ESplice s expression -> (e, fail s "a splice is only meaningful inside a quotation")
    EUnmodeled s text -> (e, fail s (cat ["unmodeled expression: ", text]))
    other -> (e, fail (expr-span e) "this expression requires further namespace elaboration")

  rename-clauses :: List Binding -> List (List Pat, Expr) -> (List (List Pat, Expr), List Diagnostic)
  rename-clauses visible clauses = rename-member-clauses visible Nil clauses

  rename-member-clauses :: List Binding -> List String -> List (List Pat, Expr) -> (List (List Pat, Expr), List Diagnostic)
  rename-member-clauses visible locals clauses = case clauses of
    Nil -> (Nil, Nil)
    Cons (ps, body) rest -> case rename-pats visible ps of
      (pats, errors) -> case rename-expr visible (patterns-names ps <> locals) body of
        (rhs, more) -> case rename-member-clauses visible locals rest of
          (others, tail-errors) -> (Cons (pats, rhs) others, errors <> more <> tail-errors)

  -- Member names are labels of the class contract, not new module values.
  -- Dictionary elaboration checks them against that class after resolution.
  instance-head-names :: TypeExpr -> List String
  instance-head-names ty = case ty of
    TForall sp binders body -> bound-names binders <> instance-head-names body
    TUsing sp bounds body -> bound-names bounds <> instance-head-names body
    other -> Nil
  instance-method-names :: String -> List Decl -> List String
  instance-method-names name declarations = case declarations of
    Nil -> Nil
    Cons (DSig sp member ty) rest -> if same member name then instance-head-names ty else instance-method-names name rest
    Cons other rest -> instance-method-names name rest
  rename-instance-members :: List Binding -> List String -> Decl -> (Decl, List Diagnostic)
  rename-instance-members visible locals members = rename-instance-members-with visible locals (decls-of members) members
  rename-instance-members-with :: List Binding -> List String -> List Decl -> Decl -> (Decl, List Diagnostic)
  rename-instance-members-with visible locals all members = case members of
    DDecl s member rest -> case rename-instance-members-with visible locals all member of
      (renamed, errors) -> case rename-instance-members-with visible locals all rest of
        (others, more) -> (DDecl s renamed others, errors <> more)
    DDeclsEnd s -> (members, Nil)
    DSig s name ty -> (DSig s name (rename-type visible locals ty), Nil)
    DFun s name clauses -> case rename-member-clauses visible (instance-method-names name all <> locals) clauses of
      (renamed, errors) -> (DFun s name renamed, errors)
    other -> (members, fail (decl-span members) "instance member requires further declaration elaboration")

  opaque-name-reserved :: String -> Bool
  opaque-name-reserved name = kernel-type-name name || has-name name
    ["Array", "Tensor", "Columnar", "Type", "Prop", "Code", "Syntax", "Declarations", "Name", "Secret"
    , "IoCap", "FileReadCap", "FileWriteCap", "ProcCap", "Scope", "Task", "RawPtr", "Borrowed", "Retained", "Owned", "Out", "MaybeNull"
    , "CChar", "CUchar", "CShort", "CUshort", "CInt", "CUint", "CLong", "CULong", "CLongLong", "CULongLong", "CSize", "SizeT"
    , "CSsize", "CFloat", "CDouble", "CVoid", "SchemaSnapshot", "Database", "SchemaRead"]
  rename-decl :: String -> List Binding -> List Decl -> Decl -> (List Decl, List Diagnostic)
  rename-decl home visible declarations d = case d of
    DSig s name ty -> (Cons (DSig s (global-name home name) (rename-type visible Nil ty)) Nil, Nil)
    DFun s name clauses -> case rename-member-clauses visible (instance-method-names name declarations) clauses of
      (body, errors) -> (Cons (DFun s (global-name home name) body) Nil, errors)
    DOpaque s name params kind -> if opaque-name-reserved name then (Nil, fail s "an opaque declaration cannot redefine a builtin type") else
      (Cons (DOpaque s (global-name home name) (rename-params visible Nil params)
        (rename-type visible (parameter-names params) kind)) Nil, Nil)
    DData s name params ctors -> if has-name name ["Array", "Tensor", "Columnar"] then (Nil, fail s "a builtin array primitive cannot be redefined")
      else if has-name name ["Ref", "Mut", "Thunk"] then (Nil, fail s "a builtin ownership type cannot be redefined")
      else (Cons (DData s (global-name home name) (rename-params visible Nil params)
      (rename-ctors home visible (parameter-names params) ctors)) Nil, Nil)
    DRecord s name params fields -> if has-name name ["Array", "Tensor", "Columnar"] then
      (Nil, fail s "a builtin array primitive cannot be redefined as a record")
      else if has-name name ["Ref", "Mut", "Thunk"] then (Nil, fail s "a builtin ownership type cannot be redefined")
      else (Cons (DRecord s (global-name home name) (rename-params visible Nil params)
        (rename-record-fields visible (parameter-names params) fields)) Nil, Nil)
    DClass s name params members ->
      if same name "Copy" || same name "Share" then (Nil, fail s "Copy and Share are compiler-owned structural signatures and cannot be declared") else
        case rename-class-members home name visible (parameter-names params) (decls-of members) of
          (renamed, errors) -> ([DClass s (global-name home name) (rename-params visible Nil params) (decl-spine s renamed)], errors)
    DRefine s name params binder predicate ->
      let names = parameter-names params in
      let renamed-binder = case binder of MkTypeParam at local kind only -> MkTypeParam at local (case kind of None -> None; Some carrier -> Some (rename-type visible names carrier)) only in
      (Cons (DRefine s (global-name home name) (rename-params visible Nil params) renamed-binder
        (rename-predicate visible (Cons (param-name binder) names) predicate)) Nil, Nil)
    DEffect s name params ops -> (Cons (DEffect s (global-name home name) (rename-params visible Nil params)
      (rename-ctors home visible (parameter-names params) ops)) Nil, Nil)
    DInstance s only name params class-app members -> case rename-instance-members visible (instance-head-names class-app <> parameter-names params) members of
      (renamed, errors) -> (Cons (DInstance s only (global-name home name) (rename-params visible Nil params)
        (rename-type visible (parameter-names params) class-app) renamed) Nil, errors)
    DForeign s direction abi symbol name ty ->
      if same direction "import" then (Cons (DForeign s direction abi symbol (global-name home name) (rename-type visible Nil ty)) Nil, Nil)
      else case resolve-use s False visible Nil name of
        (exported-symbol, errors) -> (Cons (DForeign s direction abi symbol exported-symbol (rename-type visible Nil ty)) Nil, errors)
    DImport s path mods alias members args -> (Nil, Nil)
    DExport s text items -> (Nil, Nil)
    DFixity s assoc prec ops -> (Nil, Nil)
    DProof s body -> case rename-decl home visible declarations body of
      ([checked], errors) -> ([DProof s checked], errors)
      (other, errors) -> (Nil, errors <> fail s "a proof requires one signature or equation")
    DStage s body -> (Nil, fail s "a stage declaration requires compile-time checking")
    DGenerate s actions -> (Nil, fail s "a generate block requires compile-time expansion")
    other -> (Cons d Nil, fail (decl-span d) "this declaration requires further namespace elaboration")

  rename-class-members :: String -> String -> List Binding -> List String -> List Decl -> (List Decl, List Diagnostic)
  rename-class-members home owner visible locals ds = rename-class-members-with home owner visible locals ds ds
  declared-class-method :: String -> List Decl -> Bool
  declared-class-method name ds = case ds of
    Nil -> False
    Cons (DSig sp member ty) rest -> same name member || declared-class-method name rest
    Cons other rest -> declared-class-method name rest
  rename-class-members-with :: String -> String -> List Binding -> List String -> List Decl -> List Decl -> (List Decl, List Diagnostic)
  rename-class-members-with home owner visible locals all ds = case ds of
    Nil -> (Nil, Nil)
    Cons (DSig s name ty) rest -> case rename-class-members-with home owner visible locals all rest of
      (more, errors) -> (Cons (DMethod s name (global-name home name) (rename-type visible locals ty)) more, errors)
    Cons (DLaw s name syntax) rest -> case rename-law visible locals syntax of
      (checked, failures) -> case rename-class-members-with home owner visible locals all rest of
        (more, errors) -> (Cons (DLaw s name checked) more, failures <> errors)
    Cons (DFun s name clauses) rest -> case rename-class-members-with home owner visible locals all rest of
      (more, errors) -> if declared-class-method name all then
        (case rename-member-clauses visible (instance-method-names name all <> locals) clauses of
          (renamed, failures) -> (Cons (DFun s name renamed) more, failures <> errors))
        else (Cons (DFun s name clauses) more, fail s (cat ["`", name, "` is not a method of ", owner]) <> errors)
    Cons other rest -> case rename-class-members-with home owner visible locals all rest of
      (more, errors) -> (Cons other more, fail (decl-span other) "source signature member needs checked default or declaration elaboration" <> errors)

  rename-law :: List Binding -> List String -> LawSyntax -> (LawSyntax, List Diagnostic)
  rename-law visible locals syntax = case syntax of
    LawForall parameters rest -> case rename-law visible (parameter-names parameters <> locals) rest of
      (renamed, errors) -> (LawForall (rename-params visible locals parameters) renamed, errors)
    LawArrow domain rest -> case rename-law visible (bound-names domain <> locals) rest of
      (renamed, errors) -> (LawArrow (rename-type visible locals domain) renamed, errors)
    LawEquation left right -> case rename-expr visible locals left of
      (first, errors) -> case rename-expr visible locals right of
        (second, more) -> (LawEquation first second, errors <> more)
    LawProposition ty -> (LawProposition (rename-type visible locals ty), Nil)

  rename-decls :: String -> List Binding -> List Decl -> (List Decl, List Diagnostic)
  rename-decls home visible ds = rename-decls-with home visible ds ds
  rename-decls-with :: String -> List Binding -> List Decl -> List Decl -> (List Decl, List Diagnostic)
  rename-decls-with home visible all ds = case ds of
    Nil -> (Nil, Nil)
    Cons d rest -> case rename-decl home visible all d of
      (body, errors) -> case rename-decls-with home visible all rest of
        (others, more) -> (body <> others, errors <> more)

  resolve-program :: Program -> (Program, List Diagnostic)
  resolve-program p = resolve-program-with p Nil

  imported-bindings :: LoadedInterface -> List (String, String, String) -> List Binding -> List Binding
  imported-bindings i exports seen = case exports of
    Nil -> reverse seen
    Cons (name, kind, identity) rest -> case lookup-binding name seen of
      None -> imported-bindings i rest (Cons (MkBinding name (loaded-module i) (public-global i name)) seen)
      Some prior -> imported-bindings i rest seen

  interface-scopes :: List LoadedInterface -> List Scoped
  interface-scopes interfaces = case interfaces of
    Nil -> Nil
    Cons i rest -> Cons (MkScoped (loaded-module i) (imported-bindings i (loaded-exports i) Nil)
      (interface-declarations i)) (interface-scopes rest)

  export-references :: List Scoped -> List String
  export-references scopes = case scopes of
    Nil -> Nil
    Cons (MkScoped home surface body) rest -> binding-references surface <> export-references rest

  binding-references :: List Binding -> List String
  binding-references bindings = case bindings of
    Nil -> Nil
    Cons b rest -> Cons (binding-symbol b) (binding-references rest)

  resolve-program-with :: Program -> List LoadedInterface -> (Program, List Diagnostic)
  resolve-program-with p interfaces = case validate-interface-set interfaces of
    Err message -> (p, fail (program-span p) message)
    Ok ordered -> resolve-context p (interface-scopes ordered) (interface-headers ordered) Nil

  -- A library home may precede the Prelude facade that re-exports it.
  -- Only project facade names whose defining interface is already in the
  -- home's checked dependency closure. The facade itself is never loaded
  -- into that closure or made available as a source import.
  resolve-overlay-with :: Program -> List LoadedInterface -> LoadedInterface -> (Program, List Diagnostic)
  resolve-overlay-with p dependencies facade = case validate-interface-set dependencies of
    Err message -> (p, fail (program-span p) message)
    Ok ordered -> let base = overlay-base-bindings facade (loaded-exports facade) ordered Nil in
      resolve-context p (interface-scopes ordered) (interface-headers ordered) base

  overlay-base-bindings :: LoadedInterface -> List (String, String, String) -> List LoadedInterface -> List Binding -> List Binding
  overlay-base-bindings facade exports dependencies found = case exports of
    Nil -> reverse found
    Cons (name, kind, identity) rest ->
      let symbol = interface-global identity in
      case overlay-defining-interface (identity-owner (reverse (unpack identity))) kind identity dependencies of
        Some owner -> overlay-base-bindings facade rest dependencies
          (if same symbol (public-global facade name) then Cons (MkBinding name owner symbol) found else found)
        None -> overlay-base-bindings facade rest dependencies found

  identity-owner :: List Char -> String
  identity-owner reversed = case reversed of
    Nil -> ""
    Cons first rest -> if first == '.' then pack (reverse rest) else identity-owner rest

  overlay-defining-interface :: String -> String -> String -> List LoadedInterface -> Option String
  overlay-defining-interface owner kind identity dependencies = case dependencies of
    Nil -> None
    Cons i rest -> if same owner (loaded-module i) then
      (if exports-identity kind identity (loaded-exports i) then Some owner else None)
      else overlay-defining-interface owner kind identity rest

  exports-identity :: String -> String -> List (String, String, String) -> Bool
  exports-identity kind identity exports = case exports of
    Nil -> False
    Cons (name, category, symbol) rest -> (same kind category && same identity symbol) || exports-identity kind identity rest

  resolve-context :: Program -> List Scoped -> List Module -> List Binding -> (Program, List Diagnostic)
  resolve-context p interfaces headers base = case p of
    MkProgram sp modules -> case validate-modules modules interfaces modules Nil of
      Nil -> case resolve-ordered modules (reverse interfaces) base of
        (done, Nil) ->
          let declarations = builtin-declarations <> scoped-decls done in
          let source-surfaces = source-scopes modules done in
          let references = declaration-references declarations <> export-references source-surfaces in
          let all-references = references <> imported-class-references declarations declarations in
          let admitted = if has-name "b.Fin" all-references then Cons finite-index-declaration declarations else declarations in
          case materialize-externals all-references admitted Nil of
            (body, errors) -> (MkProgram sp (Cons (MkModule sp "Main" (decl-spine sp (source-contexts modules (modules <> headers) done source-surfaces (case lookup-scoped "Prelude" done of Some prelude -> True; None -> False) (source-record-symbols modules) base <> body))) Nil), errors)
        (done, errors) -> (p, errors)
      errors -> (p, errors)

  source-scopes :: List Module -> List Scoped -> List Scoped
  source-scopes modules done = case done of
    Nil -> Nil
    Cons s rest -> if has-module (scoped-name s) modules then Cons s (source-scopes modules rest) else source-scopes modules rest

  -- The fragment backend uses one aggregate, but checked interface output
  -- must still know each source module's public aliases and declarations.
  source-contexts :: List Module -> List Module -> List Scoped -> List Scoped -> Bool -> List String -> List Binding -> List Decl
  source-contexts modules available all-scopes scopes prelude records base = case scopes of
    Nil -> Nil
    Cons (MkScoped name surface body) rest ->
      let at = source-span name modules in
      let begin = span-start at in
      let finish = span-end at in
      Cons (DSource at name
        (record-source-context name modules all-scopes records base
        (JObj "module" (JStr name)
          (JObj "source_start" (JNum (nat-to-int begin))
            (JObj "source_end" (JNum (nat-to-int finish))
              (JObj "exports" (surface-json surface)
                (JObj "declarations" (symbols-json body)
                  (JObj "imports" (strings-json (module-imports name modules prelude base surface body))
                    (JObj "fixities" (fixity-json (exported-fixities name available (surface-names surface))) JObjEnd))))))))) (source-contexts modules available all-scopes rest prelude records base)

  source-record-symbols :: List Module -> List String
  source-record-symbols modules = case modules of
    Nil -> Nil
    Cons m rest -> declared-record-symbols (module-name m) (module-decls m) <> source-record-symbols rest
  declared-record-symbols :: String -> List Decl -> List String
  declared-record-symbols home declarations = case declarations of
    Nil -> Nil
    Cons (DRecord sp name params fields) rest -> Cons (global-name home name) (declared-record-symbols home rest)
    Cons other rest -> declared-record-symbols home rest
  visible-record-symbols :: List Binding -> List String -> List String
  visible-record-symbols bindings records = case records of
    Nil -> Nil
    Cons name rest -> if visible-record-symbol name bindings then Cons name (visible-record-symbols bindings rest) else visible-record-symbols bindings rest
  visible-record-symbol :: String -> List Binding -> Bool
  visible-record-symbol name bindings = case bindings of
    Nil -> False
    Cons binding rest -> same name (binding-symbol binding) || visible-record-symbol name rest
  record-source-context :: String -> List Module -> List Scoped -> List String -> List Binding -> Json -> Json
  record-source-context name modules scopes records base document = case records of
    Nil -> document
    other -> JObj "record_scope" (strings-json (module-record-scope name modules scopes records base)) document
  module-record-scope :: String -> List Module -> List Scoped -> List String -> List Binding -> List String
  module-record-scope name modules scopes records base = case modules of
    Nil -> Nil
    Cons m rest -> if same name (module-name m) then (case module-visibility m scopes base of
      (declared, visible, views, errors) -> visible-record-symbols visible records)
      else module-record-scope name rest scopes records base

  -- Retain consumed imports and the parser's definition-owned fixity facts
  -- before elaboration drops source declarations. Reexport metadata carries
  -- an inherited fact; it never introduces a new source fixity declaration.
  module-declarations :: String -> List Module -> List Decl
  module-declarations name modules = case modules of
    Nil -> Nil
    Cons m rest -> if same name (module-name m) then module-decls m else module-declarations name rest
  declared-imports :: List Decl -> List String -> List String
  declared-imports declarations seen = case declarations of
    Nil -> reverse seen
    Cons (DImport sp name mods alias members arguments) rest -> declared-imports rest (if has-name name seen then seen else Cons name seen)
    Cons other rest -> declared-imports rest seen
  module-imports :: String -> List Module -> Bool -> List Binding -> List Binding -> List Decl -> List String
  module-imports name modules prelude base surface body = declared-imports (module-declarations name modules)
    (if prelude && not (same name "Prelude") then ["Prelude"] else case base of
      Nil -> Nil
      other -> consumed-base-imports base (binding-references surface <> declaration-references body) Nil)
  consumed-base-imports :: List Binding -> List String -> List String -> List String
  consumed-base-imports bindings references found = case bindings of
    Nil -> found
    Cons (MkBinding name owner symbol) rest -> consumed-base-imports rest references
      (if has-name symbol references && not (has-name owner found) then Cons owner found else found)
  strings-json :: List String -> Json
  strings-json values = case values of Nil -> JArrEnd; Cons first rest -> JArr (JStr first) (strings-json rest)
  surface-names :: List Binding -> List String
  surface-names bindings = case bindings of Nil -> Nil; Cons first rest -> Cons (binding-name first) (surface-names rest)
  fixity-json :: List (String, String, Nat) -> Json
  fixity-json facts = case facts of
    Nil -> JArrEnd
    Cons (name, association, precedence) rest -> JArr (JObj "op" (JStr name)
      (JObj "assoc" (JStr association) (JObj "prec" (JNum (nat-to-int precedence)) JObjEnd))) (fixity-json rest)

  source-span :: String -> List Module -> Span
  source-span name modules = case modules of
    Nil -> Span 0 0 1 1
    Cons m rest -> if same name (module-name m) then module-span m else source-span name rest

  surface-json :: List Binding -> Json
  surface-json bindings = case bindings of
    Nil -> JArrEnd
    Cons (MkBinding name origin symbol) rest -> JArr
      (JObj "name" (JStr name) (JObj "origin" (JStr origin) (JObj "symbol" (JStr symbol) JObjEnd))) (surface-json rest)

  symbols-json :: List Decl -> Json
  symbols-json ds = case ds of
    Nil -> JArrEnd
    Cons d rest -> case decl-name d of
      Some name -> JArr (JStr name) (symbols-json rest)
      None -> symbols-json rest
