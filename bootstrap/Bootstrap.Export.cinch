-- Checked schema 10 interface production. Every public spelling is matched
-- against a retained checked binding or defining data declaration.
module Bootstrap.Export where
  import Bootstrap.Builtin (array-plan)
  import Algebra.Semigroup
  import Bootstrap.Check (CheckedProgram, checked-elaboration, checked-surface)
  import Bootstrap.Ast (Program, Module, Decl, module-decls, program-modules, DClass, DInstance, DForeign, DRefine, DRecord, DEffect, DLaw, decls-of, source-clauses-document, source-law-document, portable-law-syntax, qualify-default-clauses)
  import Bootstrap.Infer (Elaboration, elaboration-bindings, elaboration-core, elaboration-data, elaboration-contexts, elaboration-classes, elaboration-instances, elaboration-declarations, elaboration-law-observations, CheckedBinding, checked-name, checked-scheme, checked-role, checked-method-matches, checked-body-binding, checked-foreign-plan, source-class-default-symbol, source-class-default-clauses, portable-default-export-global)
  import Bootstrap.Core (CoreData, CoreConstructor, CoreDefinition, core-data-name, core-data-params, core-data-constructors, core-constructor-name, core-constructor-scheme, core-name, core-scheme, core-method-total-function, core-definition-closed)
  import Bootstrap.Typing (task-source-forwarder, task-forwarder-type)
  import Bootstrap.Instance
  import Bootstrap.Type
  import Bootstrap.Total (TotalFunction, total-identity, total-function-document, total-function-equal, total-parameters, total-result, total-source-projection)
  import Bootstrap.BodyContract (BodyBinding, binding-function, binding-scheme)
  import Bootstrap.ExportType
  import Bootstrap.Foreign (ForeignPlan, foreign-document, foreign-display-scheme)
  import Bootstrap.ExportNominal
  import Bootstrap.Load (LoadedInterface, loaded-module, loaded-hash, loaded-entry, nominal-owner)
  import Bootstrap.Interface (fnv-source-hash, iface-schema-version)
  import Bootstrap.RuntimeAbi (runtime-abi-int)
  import Data.Json
  import Data.Nat (nat-from-int, nat-to-int)
  import Text.Json (canonical-bytes)
  import Text.Lex (bytes-slice)

  export export-interfaces, interface-hash
  same :: String -> String -> Bool
  same a b = string-compare a b == 0
  field :: String -> Json -> Json
  field name doc = case doc of JObj key value rest -> if same name key then value else field name rest; other -> JNull
  text :: Json -> String
  text doc = case doc of JStr value -> value; other -> ""
  strings :: List String -> Json
  strings values = case values of Nil -> JArrEnd; Cons first rest -> JArr (JStr first) (strings rest)
  bools :: List String -> Json
  bools values = case values of Nil -> JArrEnd; Cons first rest -> JArr (JBool False) (bools rest)
  set-field :: String -> Json -> Json -> Json
  set-field key value doc = case doc of
    JObj name old rest -> if same key name then JObj name value rest else JObj name old (set-field key value rest)
    other -> JObj key value JObjEnd
  find-binding :: String -> List CheckedBinding -> Option CheckedBinding
  find-binding name rows = case rows of Nil -> None; Cons row rest -> if same name (checked-name row) then Some row else find-binding name rest
  find-data :: String -> List CoreData -> Option CoreData
  find-data name rows = case rows of Nil -> None; Cons row rest -> if same name (core-data-name row) then Some row else find-data name rest
  public-name :: String -> Json -> Option String
  public-name symbol rows = case rows of
    JArr row rest -> if same symbol (text (field "symbol" row)) then Some (text (field "name" row)) else public-name symbol rest
    other -> None
  insert-row :: String -> Json -> Json -> Json
  insert-row key row rows = case rows of
    JArr first rest -> if string-compare (text (field key row)) (text (field key first)) < 0 then JArr row rows else JArr first (insert-row key row rest)
    other -> JArr row JArrEnd
  sort-rows :: String -> Json -> Json
  sort-rows key rows = case rows of JArr row rest -> insert-row key row (sort-rows key rest); other -> JArrEnd
  append :: Json -> Json -> Json
  append first second = case first of JArr row rest -> JArr row (append rest second); other -> second
  resolved-basic-scheme :: Elaboration -> List LoadedInterface -> Scheme -> Result String Json
  resolved-basic-scheme typed interfaces scheme = case (export-scheme scheme, scheme-nominals scheme (elaboration-declarations typed) (elaboration-data typed) (elaboration-classes typed) interfaces) of
    (Ok spelling, Ok nominals) -> Ok (JObj "scheme" (JStr spelling) (JObj "nominals" nominals (JObj "measures" JArrEnd JObjEnd)))
    (Err error, other) -> Err error
    (other, Err error) -> Err error
  -- Traverse the checked type, including kinds and dictionary requirements.
  -- Only actual UIndexCall graphs create measure dependencies; names carry no
  -- authority. Match the graph against the retained defining body association.
  type-measures :: UType -> List TotalFunction
  type-measures ty = case ty of
    UIndexList element fields -> type-measures element <> type-measures fields
    UIndexCall function args -> Cons function (type-measures args)
    UCon name kind -> kind-measures kind
    UBound id name kind -> kind-measures kind
    URigid id name level kind -> kind-measures kind
    UMeta id kind -> kind-measures kind
    UIndex carrier term -> type-measures carrier
    UIndexForget input -> type-measures input
    UIndexPromote input -> type-measures input
    UIndexByteLength input -> type-measures input
    UIndexMath operation a b -> type-measures a <> type-measures b
    UCompare relation a b -> type-measures a <> type-measures b
    UPropAnd a b -> type-measures a <> type-measures b
    UPropOr a b -> type-measures a <> type-measures b
    UPropNot input -> type-measures input
    UPropNonZero input -> type-measures input
    UPropNotNull input -> type-measures input
    UPropNonZeroPending input -> type-measures input
    URequire predicates body -> type-measures predicates <> type-measures body
    URefine id name carrier predicate -> type-measures carrier <> type-measures predicate
    URefineFormer name ids body -> type-measures body
    UPi id name domain row result -> type-measures domain <> type-measures row <> type-measures result
    UApp a b -> type-measures a <> type-measures b
    UFun a b -> type-measures a <> type-measures b
    UFunEff a row b -> type-measures a <> type-measures row <> type-measures b
    UProofFun a row b -> type-measures a <> type-measures row <> type-measures b
    URow labels -> type-measures labels
    URowJoin a b -> type-measures a <> type-measures b
    UTuple fields -> type-measures fields
    UArg a b -> type-measures a <> type-measures b
    other -> Nil
  kind-measures :: Kind -> List TotalFunction
  kind-measures kind = case kind of
    KValue payload -> (case value-carrier kind of Some carrier -> type-measures carrier; None -> Nil)
    KFun a b -> kind-measures a <> kind-measures b
    other -> Nil
  parameter-measures :: List Quant -> List TotalFunction
  parameter-measures parameters = case parameters of Nil -> Nil; Cons parameter rest -> kind-measures (quant-kind parameter) <> parameter-measures rest
  requirement-measures :: List Requirement -> List TotalFunction
  requirement-measures requirements = case requirements of Nil -> Nil; Cons requirement rest -> type-measures (requirement-type requirement) <> requirement-measures rest
  scheme-measures :: Scheme -> List TotalFunction
  scheme-measures scheme = parameter-measures (scheme-params scheme) <> requirement-measures (scheme-requirements scheme) <> type-measures (scheme-body scheme)
  measure-binding :: TotalFunction -> List CheckedBinding -> Option BodyBinding
  measure-binding function bindings = case bindings of
    Nil -> None
    Cons first rest -> case checked-body-binding first of
      Some body -> if total-function-equal function (binding-function body) then Some body else measure-binding function rest
      None -> measure-binding function rest
  measure-rows :: Elaboration -> List LoadedInterface -> List String -> List TotalFunction -> Result String Json
  measure-rows typed interfaces seen functions = case functions of
    Nil -> Ok JArrEnd
    Cons function rest -> let identity = total-identity function in
      if measure-seen identity seen then measure-rows typed interfaces seen rest else
        case measure-binding function (elaboration-bindings typed) of
          None -> Err ("measure has no checked defining body: " <> identity)
          Some binding -> case (resolved-basic-scheme typed interfaces (binding-scheme binding), measure-rows typed interfaces (Cons identity seen) rest) of
            (Ok resolved, Ok more) -> (case scheme-measures (binding-scheme binding) of
              Nil -> Ok (insert-row "identity" (JObj "identity" (JStr identity) (JObj "resolved" resolved (JObj "total_body" (total-function-document function) JObjEnd))) more)
              other -> Err "a measure signature cannot depend on another observation")
            (Err error, other) -> Err error
            (other, Err error) -> Err error
  measure-seen :: String -> List String -> Bool
  measure-seen identity seen = case seen of Nil -> False; Cons first rest -> same identity first || measure-seen identity rest
  resolved-scheme :: Elaboration -> List LoadedInterface -> Scheme -> Result String Json
  resolved-scheme typed interfaces scheme = case (resolved-basic-scheme typed interfaces scheme, measure-rows typed interfaces Nil (scheme-measures scheme)) of
    (Ok resolved, Ok measures) -> Ok (set-field "measures" measures resolved)
    (Err error, other) -> Err error
    (other, Err error) -> Err error
  value-total-body :: CheckedBinding -> Json
  value-total-body binding = case checked-body-binding binding of
    Some body -> if total-source-projection (binding-function body) then JNull else total-function-document (binding-function body)
    None -> JNull
  resolved-source-scheme :: Elaboration -> List LoadedInterface -> String -> Scheme -> Result String Json
  resolved-source-scheme typed interfaces symbol scheme = case (resolved-scheme typed interfaces scheme, binding-refinements (elaboration-declarations typed) symbol) of
    (Ok resolved, Ok refinements) -> (case merge-nominals refinements (field "nominals" resolved) of
      Ok rows -> Ok (set-field "nominals" rows resolved)
      Err error -> Err error)
    (Err error, other) -> Err error
    (other, Err error) -> Err error
  resolved-value-scheme :: Elaboration -> List LoadedInterface -> String -> Scheme -> Result String Json
  resolved-value-scheme typed interfaces symbol scheme = case (resolved-source-scheme typed interfaces symbol scheme, export-resolved-value-scheme scheme) of
    (Ok resolved, Ok spelling) -> Ok (set-field "scheme" (JStr spelling) resolved)
    (Err error, other) -> Err error
    (other, Err error) -> Err error
  imported-refinement-type :: List LoadedInterface -> String -> Option Json
  imported-refinement-type interfaces symbol = case export-global symbol of
    Err error -> None
    Ok identity -> defining-refinement-type interfaces identity
  defining-refinement-type :: List LoadedInterface -> String -> Option Json
  defining-refinement-type interfaces identity = case interfaces of
    Nil -> None
    Cons first rest -> case loaded-entry first "type" identity of
      Some row -> if same (text (field "kind" row)) "refinement" || same (text (field "kind" row)) "opaque" then Some row else defining-refinement-type rest identity
      None -> defining-refinement-type rest identity
  abstract-type-row :: String -> Json -> Json
  abstract-type-row name nominal = JObj "name" (JStr name)
    (JObj "identity" (field "identity" nominal) (JObj "kind" (field "kind" nominal)
      (JObj "params" (field "params" nominal) (JObj "parameters" (field "parameters" nominal)
        (JObj "ctors" JArrEnd (JObj "fields" JArrEnd (JObj "refinement" (field "refinement" nominal) JObjEnd)))))))
  -- Interface value arity counts source arrows, dictionaries and hidden
  -- value parameters. Proof arrows remain in this contract even though
  -- executable Core erases their runtime slots.
  quantified-value-arity :: List Quant -> Nat
  quantified-value-arity parameters = case parameters of
    Nil -> 0
    Cons first rest -> (case value-carrier (quant-kind first) of Some carrier -> 1; None -> 0) + quantified-value-arity rest
  interface-value-arity :: Scheme -> Nat
  interface-value-arity scheme = scheme-arity scheme + list-length (scheme-requirements scheme) + quantified-value-arity (scheme-params scheme)
  value-row :: Elaboration -> List LoadedInterface -> String -> String -> CheckedBinding -> Result String Json
  value-row typed interfaces name symbol binding =
    if imported-symbol symbol then imported-value-row interfaces name symbol
    else if same (checked-role binding) "foreign" then foreign-value-row name symbol binding
    else if same (checked-role binding) "operation" then opaque-value-row name symbol binding
    else if same (checked-role binding) "function" || same (checked-role binding) "value" || same (checked-role binding) "intrinsic" || same (checked-role binding) "instance" || same (checked-role binding) "implicit-instance" then
      let scheme = checked-scheme binding in
      let arity = interface-value-arity scheme in
      if task-forwarder-type (scheme-body scheme) && (case default-definition symbol (elaboration-core typed) of Some definition -> task-source-forwarder definition; None -> False) then
        Err (string-concat "a task forwarding helper requires a portable checked transfer contract to be exported: " name)
      else if row-quantified (scheme-params scheme) then opaque-value-row name symbol binding else
      case (export-global symbol, resolved-value-scheme typed interfaces symbol scheme, export-display-scheme scheme) of
        (Ok identity, Ok resolved, Ok spelling) -> Ok (JObj "name" (JStr name)
          (JObj "symbol" (JStr identity) (JObj "scheme" (JStr spelling)
            (JObj "resolved" resolved (JObj "arity" (JNum (nat-to-int arity))
              (JObj "total_body" (value-total-body binding) JObjEnd))))))
        (Err error, other, more) -> Err error
        (other, Err error, more) -> Err error
        (other, more, Err error) -> Err error
    else Err (string-concat "unsupported checked value export category: " (checked-role binding))
  imported-symbol :: String -> Bool
  imported-symbol symbol = case unpack symbol of
    Cons prefix (Cons dot rest) -> char-code prefix == 105 && char-code dot == 46
    other -> False
  foreign-value-row :: String -> String -> CheckedBinding -> Result String Json
  foreign-value-row name symbol binding = case checked-foreign-plan binding of
    None -> Err "foreign binding has no checked ABI plan"
    Some plan -> case (export-global symbol, foreign-display-scheme plan) of
      (Ok identity, Ok spelling) -> Ok (JObj "name" (JStr name) (JObj "symbol" (JStr identity)
        (JObj "scheme" (JStr spelling) (JObj "resolved" JNull (JObj "arity" (JNum (nat-to-int (interface-value-arity (checked-scheme binding)))) (JObj "total_body" JNull JObjEnd))))))
      (Err error, other) -> Err error
      (other, Err error) -> Err error
  imported-value :: String -> List LoadedInterface -> Option Json
  imported-value identity interfaces = case interfaces of
    Nil -> None
    Cons first rest -> case loaded-entry first "value" identity of Some row -> Some row; None -> imported-value identity rest
  -- An admitted imported value already has its defining scheme, arity and
  -- optional executable/measure contracts. Rename its public spelling only;
  -- reprinting a display scheme would discard those defining facts.
  imported-value-row :: List LoadedInterface -> String -> String -> Result String Json
  imported-value-row interfaces name symbol = case export-global symbol of
    Err error -> Err error
    Ok identity -> case imported-value identity interfaces of
      Some row -> Ok (set-field "name" (JStr name) row)
      None -> Err (string-concat "imported value has no admitted defining export: " identity)
  -- An open row cannot supply the closed portable effect contract. Keep the
  -- checked display scheme, as for an operation whose defining handler table
  -- is unavailable, and grant no resolved contract or executable body.
  row-kind :: Kind -> Bool
  row-kind kind = case kind of KRow -> True; KFun first rest -> row-kind first || row-kind rest; other -> False
  row-quantified :: List Quant -> Bool
  row-quantified parameters = case parameters of Nil -> False; Cons first rest -> row-kind (quant-kind first) || row-quantified rest
  opaque-value-row :: String -> String -> CheckedBinding -> Result String Json
  opaque-value-row name symbol binding = let scheme = checked-scheme binding in
    let arity = interface-value-arity scheme in
    case (export-global symbol, export-display-scheme scheme) of
      (Ok identity, Ok spelling) -> Ok (JObj "name" (JStr name)
        (JObj "symbol" (JStr identity) (JObj "scheme" (JStr spelling)
          (JObj "resolved" JNull (JObj "arity" (JNum (nat-to-int arity))
            (JObj "total_body" JNull JObjEnd))))))
      (Err error, other) -> Err error
      (other, Err error) -> Err error
  constructor-result :: UType -> UType
  constructor-result ty = case ty of UFun domain result -> constructor-result result; UFunEff domain effects result -> constructor-result result; UPi id name domain effects result -> constructor-result result; UProofFun predicate effects result -> constructor-result result; URequire predicates result -> constructor-result result; other -> ty
  constructor-id-member :: Nat -> List Nat -> Bool
  constructor-id-member id ids = case ids of Nil -> False; Cons first rest -> id == first || constructor-id-member id rest
  constructor-hidden-parameters :: List Quant -> List Nat -> Bool
  constructor-hidden-parameters parameters visible = case parameters of
    Nil -> False
    Cons first rest -> not (constructor-id-member (quant-id first) visible) || constructor-hidden-parameters rest visible
  constructor-row :: Elaboration -> List LoadedInterface -> String -> Nat -> CoreConstructor -> Result String Json
  constructor-row typed interfaces name tag constructor = let scheme = core-constructor-scheme constructor in
    let hidden = constructor-hidden-parameters (scheme-params scheme) (type-free-bound (constructor-result (scheme-body scheme))) in
    let resolved = if hidden then Ok JNull else resolved-value-scheme typed interfaces (core-constructor-name constructor) scheme in
    let (fields, spelling) = export-constructor-display hidden scheme in
    case (export-global (core-constructor-name constructor), fields, resolved, spelling) of
      (Ok identity, Ok fields, Ok resolved, Ok spelling) -> Ok (JObj "name" (JStr name)
        (JObj "symbol" (JStr identity) (JObj "tag" (JNum (nat-to-int tag))
          (JObj "scheme" (JStr spelling) (JObj "resolved" resolved
            (JObj "fields" (strings fields) (JObj "erased" (bools fields) JObjEnd)))))))
      (Err error, other, more, spelling) -> Err error
      (other, Err error, more, spelling) -> Err error
      (other, more, Err error, spelling) -> Err error
      (other, more, resolved, Err error) -> Err error
  constructor-rows :: Elaboration -> List LoadedInterface -> Json -> Nat -> List CoreConstructor -> Result String Json
  constructor-rows typed interfaces surface tag constructors = case constructors of
    Nil -> Ok JArrEnd
    Cons first rest -> case public-name (core-constructor-name first) surface of
      None -> constructor-rows typed interfaces surface (tag + 1) rest
      Some name -> case (constructor-row typed interfaces name tag first, constructor-rows typed interfaces surface (tag + 1) rest) of
        (Ok row, Ok more) -> Ok (JArr row more)
        (Err error, other) -> Err error
        (other, Err error) -> Err error
  type-row :: Elaboration -> List LoadedInterface -> Json -> String -> CoreData -> Result String Json
  type-row typed interfaces surface name declaration = case (data-nominal declaration,
    constructor-rows typed interfaces surface 0 (core-data-constructors declaration)) of
      (Ok nominal, Ok constructors) -> Ok (JObj "name" (JStr name)
        (JObj "identity" (field "identity" nominal) (JObj "kind" (field "kind" nominal)
          (JObj "params" (field "params" nominal) (JObj "parameters" (field "parameters" nominal)
            (JObj "ctors" constructors (JObj "fields" JArrEnd (JObj "refinement" JNull JObjEnd))))))))
      (Err error, other) -> Err error
      (other, Err error) -> Err error
  constructor-present :: String -> List CoreData -> Bool
  constructor-present symbol declarations = case declarations of
    Nil -> False
    Cons declaration rest -> constructors-have symbol (core-data-constructors declaration) || constructor-present symbol rest
  constructors-have :: String -> List CoreConstructor -> Bool
  constructors-have symbol constructors = case constructors of Nil -> False; Cons constructor rest -> same symbol (core-constructor-name constructor) || constructors-have symbol rest
  public-names :: String -> Json -> Json
  public-names symbol rows = case rows of
    JArr row rest -> if same symbol (text (field "symbol" row)) then insert-string (text (field "name" row)) (public-names symbol rest) else public-names symbol rest
    other -> JArrEnd
  method-names :: Elaboration -> CoreClass -> CoreClassMethod -> Json -> Json
  method-names typed description member surface = case surface of
    JArr row rest -> let symbol = text (field "symbol" row) in
      (case find-binding symbol (elaboration-bindings typed) of
        Some binding -> if checked-method-matches binding symbol (class-name description) (class-method-slot member) then
          insert-string (text (field "name" row)) (method-names typed description member rest)
          else method-names typed description member rest
        None -> method-names typed description member rest)
    other -> JArrEnd
  defining-method-symbol :: List CheckedBinding -> String -> Nat -> Option String
  defining-method-symbol bindings owner slot = case bindings of
    Nil -> None
    Cons first rest -> if checked-method-matches first (checked-name first) owner slot then Some (checked-name first) else defining-method-symbol rest owner slot
  resolved-method-scheme :: Elaboration -> List LoadedInterface -> CoreClass -> CoreClassMethod -> Result String Json
  resolved-method-scheme typed interfaces description member = case defining-method-symbol (elaboration-bindings typed) (class-name description) (class-method-slot member) of
    Some symbol -> resolved-value-scheme typed interfaces symbol (class-method-scheme member)
    None -> case (resolved-scheme typed interfaces (class-method-scheme member), export-value-scheme (class-method-scheme member)) of
      (Ok resolved, Ok spelling) -> Ok (set-field "scheme" (JStr spelling) resolved)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
  admitted-method :: CoreClass -> CoreClassMethod -> List LoadedInterface -> Option Json
  admitted-method description member interfaces = case export-global (class-name description) of
    Err error -> None
    Ok owner -> case defining-signature owner interfaces of
      None -> None
      Some original -> defining-method (class-method-name member) (field "methods" original)
  method-rows :: Elaboration -> List LoadedInterface -> CoreClass -> Json -> List CoreClassMethod -> Result String Json
  method-rows typed interfaces description surface methods = case methods of
    Nil -> Ok JArrEnd
    Cons member rest -> let slot = class-method-slot member in
      case method-rows typed interfaces description surface rest of
        Err error -> Err error
        Ok more -> case admitted-method description member interfaces of
          Some original -> if (case field "slot" original of JNum actual -> actual == nat-to-int slot; other -> False) then
            Ok (JArr (set-field "exports" (method-names typed description member surface) original) more)
            else Err "admitted class method disagrees with its checked slot"
          None -> case resolved-method-scheme typed interfaces description member of
            Err error -> Err error
            Ok resolved -> case method-default typed description member interfaces
                (JObj "name" (JStr (class-method-name member))
                  (JObj "slot" (JNum (nat-to-int slot))
                    (JObj "exports" (method-names typed description member surface)
                      (JObj "scheme" (field "scheme" resolved)
                        (JObj "resolved" resolved JObjEnd))))) of
              Err error -> Err error
              Ok row -> Ok (JArr row more)
  methods-public :: Json -> Bool
  methods-public rows = case rows of
    JArr row rest -> (case field "exports" row of JArr name more -> True; other -> False) || methods-public rest
    other -> False
  last-name :: List Char -> List Char -> String
  last-name chars reversed = case chars of Nil -> pack (reverse reversed); Cons c rest -> last-name rest (if char-code c == 46 then Nil else Cons c reversed)
  defining-signature :: String -> List LoadedInterface -> Option Json
  defining-signature identity interfaces = case interfaces of Nil -> None; Cons first rest -> case loaded-entry first "signature" identity of Some row -> Some row; None -> defining-signature identity rest
  defining-method :: String -> Json -> Option Json
  defining-method name methods = case methods of JArr row rest -> if same name (text (field "name" row)) then Some row else defining-method name rest; other -> None
  default-definition :: String -> List CoreDefinition -> Option CoreDefinition
  default-definition name definitions = case definitions of
    Nil -> None
    Cons first rest -> if same name (core-name first) then Some first else default-definition name rest
  method-default :: Elaboration -> CoreClass -> CoreClassMethod -> List LoadedInterface -> Json -> Result String Json
  method-default typed description member interfaces row = case source-class-default-clauses description member (elaboration-declarations typed) of
    Some clauses -> (case default-definition (source-class-default-symbol description member) (elaboration-core typed) of
      Some definition -> if core-definition-closed definition && scheme-equivalent (core-scheme definition) (class-method-scheme member) then
        let globals = portable-default-export-global (elaboration-bindings typed) (elaboration-classes typed) in
        Ok (set-field "default" (qualify-default-clauses globals (source-clauses-document clauses)) row)
        else Err "source class default lacks its closed defining method contract"
      None -> Err "source class default has no checked definition")
    None -> (case export-global (class-name description) of
      Err error -> Err error
      Ok identity -> case defining-signature identity interfaces of
        None -> Ok row
        Some source -> case defining-method (class-method-name member) (field "methods" source) of
          None -> Ok row
          Some original -> case field "default" original of
            JArr first rest -> Ok (set-field "default" (JArr first rest) row)
            other -> Ok row)
  nominal-mentioned :: String -> Json -> Bool
  nominal-mentioned identity doc = case doc of
    JObj key value rest -> (same identity (text (field "identity" doc)) && same "signature" (text (field "kind" doc)))
      || nominal-mentioned identity value || nominal-mentioned identity rest
    JArr row rest -> nominal-mentioned identity row || nominal-mentioned identity rest
    other -> False
  has-public-method :: Elaboration -> CoreClass -> Json -> List CoreClassMethod -> Bool
  has-public-method typed description surface methods = case methods of
    Nil -> False
    Cons member rest -> (case method-names typed description member surface of JArr name more -> True; other -> False) || has-public-method typed description surface rest
  signature-needed :: Elaboration -> CoreClass -> Json -> Json -> Json -> Bool
  signature-needed typed description surface values types =
    (case public-names (class-name description) surface of JArr name more -> True; other -> False)
    || has-public-method typed description surface (class-methods description)
    || (case export-global (class-name description) of Ok identity -> nominal-mentioned identity values || nominal-mentioned identity types; Err error -> False)
  source-class-laws :: (String -> Option String) -> String -> List Decl -> Json
  source-class-laws globals owner declarations = case declarations of
    Nil -> JArrEnd
    Cons (DClass sp name parameters members) rest -> if same owner name then
      source-law-rows globals (decls-of members) else source-class-laws globals owner rest
    Cons other rest -> source-class-laws globals owner rest

  source-law-rows :: (String -> Option String) -> List Decl -> Json
  source-law-rows globals members = case members of
    Nil -> JArrEnd
    Cons (DLaw sp name syntax) rest ->
      let wire = qualify-default-clauses globals (source-law-document syntax) in
      let syntax = case portable-law-syntax sp (\name -> Some name) wire of Some checked -> wire; None -> JNull in
      JArr (JObj "name" (JStr name) (JObj "syntax" syntax JObjEnd)) (source-law-rows globals rest)
    Cons other rest -> source-law-rows globals rest

  admitted-signature-header :: String -> Json -> List LoadedInterface -> Json -> Json
  admitted-signature-header identity names interfaces row = case defining-signature identity interfaces of
    None -> row
    Some original -> set-field "exports" names (set-field "methods" (field "methods" row) original)
  signature-rows :: Elaboration -> List LoadedInterface -> Json -> Json -> Json -> List CoreClass -> Result String Json
  signature-rows typed interfaces surface values types classes = signature-closure typed interfaces surface values types classes classes JArrEnd
  -- A retained private class can itself require another private class in a
  -- method contract. Close over those contracts without publishing their
  -- names. Each growing pass adds at least one defining identity, so the
  -- complete class list also bounds the number of passes, including cycles.
  signature-closure :: Elaboration -> List LoadedInterface -> Json -> Json -> Json -> List CoreClass -> List CoreClass -> Json -> Result String Json
  signature-closure typed interfaces surface values types fuel classes rows = case fuel of
    Nil -> Ok rows
    Cons first rest -> case signature-pass typed interfaces surface values types classes rows of
      Err error -> Err error
      Ok (more, grew) -> if grew then signature-closure typed interfaces surface values types rest classes more else Ok more
  signature-retained :: String -> Json -> Bool
  signature-retained identity rows = case rows of
    JArr row rest -> same identity (text (field "identity" row)) || signature-retained identity rest
    other -> False
  -- Native's canonical signature order compares the display name first,
  -- then the defining identity. Dependency closure is keyed by identity,
  -- independently of this serialization order.
  insert-signature :: Json -> Json -> Json
  insert-signature row rows = case rows of
    JArr first rest -> let order = string-compare (text (field "name" row)) (text (field "name" first)) in
      if order < 0 || (order == 0 && string-compare (text (field "identity" row)) (text (field "identity" first)) < 0) then JArr row rows
      else JArr first (insert-signature row rest)
    other -> JArr row JArrEnd
  signature-pass :: Elaboration -> List LoadedInterface -> Json -> Json -> Json -> List CoreClass -> Json -> Result String (Json, Bool)
  signature-pass typed interfaces surface values types classes rows = case classes of
    Nil -> Ok (rows, False)
    Cons description rest -> case export-global (class-name description) of
      Err error -> Err error
      Ok identity -> if signature-retained identity rows || not (signature-needed typed description surface (JArr values (JArr rows JArrEnd)) types) then
          signature-pass typed interfaces surface values types rest rows
        else case (method-rows typed interfaces description surface (class-methods description), export-parameters (class-params description)) of
          (Err error, other) -> Err error
          (other, Err error) -> Err error
          (Ok methods, Ok parameters) -> let names = public-names (class-name description) surface in
            let globals = portable-default-export-global (elaboration-bindings typed) (elaboration-classes typed) in
            let laws = source-class-laws globals (class-name description) (elaboration-declarations typed) in
            let row = admitted-signature-header identity names interfaces (JObj "name" (JStr (last-name (unpack identity) Nil))
              (JObj "identity" (JStr identity) (JObj "exports" names (JObj "params" (parameter-names parameters)
                (JObj "parameters" (parameter-json parameters) (JObj "methods" methods (JObj "laws" laws JObjEnd))))))) in
            case signature-pass typed interfaces surface values types rest (insert-signature row rows) of
              Err error -> Err error
              Ok (more, grew) -> Ok (more, True)

  class-head :: UType -> Option String
  class-head ty = case ty of UCon name kind -> Some name; UApp f x -> class-head f; other -> None
  plain-method :: UType -> Bool
  plain-method ty = case ty of
    UFun a b -> plain-method b
    UFunEff a row b -> plain-method b
    UPi id name domain row result -> plain-method result
    URequire predicates body -> False
    UProofFun predicate row result -> False
    other -> True
  instance-method-names :: String -> List CoreClassMethod -> List CoreDictionaryField -> Result String Json
  instance-method-names identity methods fields = case (methods, fields) of
    (Nil, Nil) -> Ok JArrEnd
    (Cons member rest, Cons implementation more) ->
      if class-method-slot member /= dictionary-field-slot implementation then Err "checked instance method slot differs from defining signature"
      else if not (plain-method (scheme-body (core-scheme (dictionary-field-definition implementation)))) then Err "preconditioned instance method export requires its checked callable contract"
      else (case instance-method-names identity rest more of
        Err error -> Err error
        Ok names -> Ok (JArr (JStr (string-concat-all [identity, ".", class-method-name member])) names))
    other -> Err "checked instance has an incomplete defining method table"
  retained-body-bindings :: List CheckedBinding -> List BodyBinding
  retained-body-bindings bindings = case bindings of
    Nil -> Nil
    Cons first rest -> case checked-body-binding first of Some body -> Cons body (retained-body-bindings rest); None -> retained-body-bindings rest
  plain-total-sort :: UType -> Bool
  plain-total-sort ty = case ty of UCon name KType -> same name "Nat" || same name "Int" || same name "Bool" || same name "Bytes" || same name "I64"; other -> False
  plain-total-method-type :: UType -> Bool
  plain-total-method-type ty = case ty of
    UFun domain result -> plain-total-sort domain && plain-total-method-type result
    UFunEff domain (URow UEnd) result -> plain-total-sort domain && plain-total-method-type result
    other -> plain-total-sort ty
  total-method-declaration :: List String -> String -> String
  total-method-declaration parameters result = case parameters of Nil -> result; Cons first rest -> string-concat-all ["(", first, " -> ", total-method-declaration rest result, ")"]
  actual-method-selector :: String -> Nat -> String -> List CheckedBinding -> String
  actual-method-selector owner slot fallback bindings = case bindings of
    Nil -> fallback
    Cons first rest -> if checked-method-matches first (checked-name first) owner slot then
      (case export-global (checked-name first) of Ok actual -> actual; Err error -> fallback)
      else actual-method-selector owner slot fallback rest
  instance-method-table :: Elaboration -> String -> String -> String -> List CoreClassMethod -> List CoreDictionaryField -> List (Nat, String, String, CoreDefinition)
  instance-method-table typed owner identity declaring methods fields = case (methods, fields) of
    (Cons member rest, Cons implementation more) -> if class-method-slot member /= dictionary-field-slot implementation then Nil else
      Cons (class-method-slot member,
        actual-method-selector owner (class-method-slot member) (string-concat-all [declaring, ".", class-method-name member]) (elaboration-bindings typed),
        string-concat-all [identity, ".", class-method-name member], dictionary-field-definition implementation)
        (instance-method-table typed owner identity declaring rest more)
    other -> Nil
  instance-method-bodies :: Elaboration -> CoreInstance -> String -> List (Nat, String, String, CoreDefinition) -> List (Nat, String, String, CoreDefinition) -> Json
  instance-method-bodies typed declaration owner all remaining = case remaining of
    Cons (slot, selector, native, definition) rest ->
      let more = instance-method-bodies typed declaration owner all rest in
      if not (plain-total-method-type (scheme-body (core-scheme definition))) then more else
        (case core-method-total-function (retained-body-bindings (elaboration-bindings typed)) (elaboration-core typed)
          (instance-name declaration) owner (instance-scheme declaration) all slot of
          Some function -> JArr (JObj "slot" (JNum (nat-to-int slot))
            (JObj "implementation" (JStr native)
              (JObj "resolved" (JObj "scheme" (JStr (total-method-declaration (total-parameters function) (total-result function)))
                (JObj "nominals" JArrEnd (JObj "measures" JArrEnd JObjEnd)))
                (JObj "total_body" (total-function-document function) JObjEnd)))) more
          None -> more)
    other -> JArrEnd
  with-instance-method-bodies :: Json -> Json -> Json
  with-instance-method-bodies bodies row = case bodies of JArrEnd -> row; other -> set-field "method_bodies" bodies row
  instance-row :: Elaboration -> List LoadedInterface -> CoreInstance -> Result String Json
  instance-row typed interfaces declaration = let scheme = instance-scheme declaration in
    case class-head (scheme-body scheme) of
      None -> Err "checked instance has no defining signature head"
      Some owner -> case find-class owner (elaboration-classes typed) of
        None -> Err "checked instance has no defining signature contract"
        Some description -> case (export-global (instance-name declaration), export-global owner, resolved-source-scheme typed interfaces (instance-name declaration) scheme, export-instance-scheme scheme) of
          (Ok identity, Ok declaring, Ok resolved, Ok (head, context, spelling)) -> case instance-method-names identity (class-methods description) (instance-fields declaration) of
            Err error -> Err error
            Ok methods -> let table = instance-method-table typed owner identity declaring (class-methods description) (instance-fields declaration) in
              let bodies = case context of Nil -> instance-method-bodies typed declaration owner table table; other -> JArrEnd in
              Ok (with-instance-method-bodies bodies
              (JObj "id" (JStr identity) (JObj "class" (JStr declaring)
                (JObj "target" (JStr head) (JObj "resolved" (set-field "scheme" (JStr spelling) resolved) (JObj "ctx" (strings context)
                  (JObj "methods" methods (JObj "method_contracts" JArrEnd (JObj "implicit" (JBool (instance-implicit declaration)) JObjEnd)))))))))
          (Err error, other, more, forms) -> Err error
          (other, Err error, more, forms) -> Err error
          (other, more, Err error, forms) -> Err error
          (other, more, resolved, Err error) -> Err error
  instance-rows :: Elaboration -> List LoadedInterface -> Json -> List CoreInstance -> Result String Json
  instance-rows typed interfaces context declarations = case declarations of
    Nil -> Ok JArrEnd
    Cons declaration rest -> if has-symbol (instance-name declaration) (field "declarations" context) then
      (case (instance-row typed interfaces declaration, instance-rows typed interfaces context rest) of
        (Ok row, Ok more) -> Ok (insert-row "id" row more)
        (Err error, other) -> Err error
        (other, Err error) -> Err error)
      else instance-rows typed interfaces context rest
  -- A constructor is recorded only in its defining type's public table.
  -- Hidden constructors still occur in private nominal identity closures.
  exports :: Elaboration -> List LoadedInterface -> Json -> Json -> Result String (Json, Json)
  exports typed interfaces surface rows = case rows of
    JArr row rest -> let name = text (field "name" row) in let symbol = text (field "symbol" row) in
      case exports typed interfaces surface rest of
        Err error -> Err error
        Ok (values, types) -> case find-data symbol (elaboration-data typed) of
          Some declaration -> case type-row typed interfaces surface name declaration of
            Err error -> Err error
            Ok actual -> Ok (values, insert-row "name" actual types)
          None -> case find-class symbol (elaboration-classes typed) of
            Some description -> case class-nominal description of
              Ok nominal -> Ok (values, insert-row "name" (abstract-type-row name nominal) types)
              Err error -> Err error
            None -> case source-abstract-type (elaboration-declarations typed) symbol of
              Some (Ok nominal) -> Ok (values, insert-row "name" (abstract-type-row name nominal) types)
              Some (Err error) -> Err error
              None -> case imported-refinement-type interfaces symbol of
                Some row -> Ok (values, insert-row "name" (set-field "name" (JStr name) row) types)
                None -> if constructor-present symbol (elaboration-data typed) then Ok (values, types)
                  else case find-binding symbol (elaboration-bindings typed) of
                    None -> Err (string-concat "export has no retained checked declaration: " name)
                    -- Methods and instance factories have their own contract tables.
                    Some binding -> let role = checked-role binding in
                      if same role "method" || same role "instance" || same role "implicit-instance" then Ok (values, types)
                      else case value-row typed interfaces name symbol binding of
                        Err error -> Err error
                        Ok actual -> Ok (insert-row "name" actual values, types)
    JArrEnd -> Ok (JArrEnd, JArrEnd)
    other -> Err "module has no retained public export table"
  symbols :: Json -> Json
  symbols values = case values of
    JArr row rest -> JArr (JStr (string-concat-all [text (field "name" row), "=", text (field "symbol" row)])) (symbols rest)
    other -> JArrEnd
  insert-string :: String -> Json -> Json
  insert-string name rows = case rows of
    JArr (JStr first) rest -> let order = string-compare name first in
      if order == 0 then rows else if order < 0 then JArr (JStr name) rows else JArr (JStr first) (insert-string name rest)
    other -> JArr (JStr name) JArrEnd
  sorted-strings :: Json -> Json
  sorted-strings rows = case rows of JArr (JStr name) rest -> insert-string name (sorted-strings rest); other -> JArrEnd
  layouts :: Json -> Json
  layouts types = case types of
    JArr row rest -> JArr (JObj "type" (field "name" row) (JObj "size" (JNum 8)
      (JObj "align" (JNum 8) (JObj "fields" JArrEnd (JObj "repr" (JStr "uniform-word") JObjEnd))))) (layouts rest)
    other -> JArrEnd
  public-spelling :: String -> Json -> Bool
  public-spelling name surface = case surface of
    JArr row rest -> same name (text (field "name" row)) || public-spelling name rest
    other -> False
  public-fixities :: Json -> Json -> Json
  public-fixities surface rows = case rows of
    JArr row rest -> if public-spelling (text (field "op" row)) surface then JArr row (public-fixities surface rest) else public-fixities surface rest
    other -> JArrEnd
  lookup-hash :: String -> List (String, String) -> List LoadedInterface -> Result String String
  lookup-hash name produced interfaces = case produced of
    Cons (owner, hash) rest -> if same name owner then Ok hash else lookup-hash name rest interfaces
    Nil -> case interfaces of
      Nil -> Err (string-concat "no checked dependency interface identity: " name)
      Cons first rest -> if same name (loaded-module first) then Ok (loaded-hash first) else lookup-hash name Nil rest
  imports :: Json -> List (String, String) -> List LoadedInterface -> Result String Json
  imports names produced interfaces = case names of
    JArr (JStr name) rest -> case (lookup-hash name produced interfaces, imports rest produced interfaces) of
      (Ok hash, Ok more) -> Ok (insert-row "module" (JObj "module" (JStr name) (JObj "iface_hash" (JStr hash) JObjEnd)) more)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
    JArrEnd -> Ok JArrEnd
    other -> Err "module has no retained dependency list"
  has-symbol :: String -> Json -> Bool
  has-symbol name rows = case rows of JArr (JStr first) rest -> same name first || has-symbol name rest; other -> False
  nominal-owners :: Json -> List String
  nominal-owners rows = case rows of
    JArr row rest -> Cons (nominal-owner (text (field "identity" row))) (nominal-owners rest)
    other -> Nil
  resolved-owners :: Json -> List String
  resolved-owners rows = case rows of
    JArr row rest -> nominal-owners (field "nominals" (field "resolved" row)) <> resolved-owners rest
    other -> Nil
  constructor-owners :: Json -> List String
  constructor-owners types = case types of
    JArr row rest -> resolved-owners (field "ctors" row) <> constructor-owners rest
    other -> Nil
  signature-owners :: Json -> List String
  signature-owners signatures = case signatures of
    JArr row rest -> Cons (nominal-owner (text (field "identity" row)))
      (resolved-owners (field "methods" row) <> signature-owners rest)
    other -> Nil
  add-import-owners :: String -> List String -> Json -> Json
  add-import-owners home owners names = case owners of
    Nil -> names
    Cons owner rest -> if same home owner || has-symbol owner names then add-import-owners home rest names
      else add-import-owners home rest (JArr (JStr owner) names)
  -- The interface itself may retain a defining nominal reached through an
  -- imported signature. Record the direct checked dependency even when the
  -- original source only imported that signature's home.
  checked-imports :: String -> Json -> Json -> Json -> Json -> Json -> Json
  checked-imports home names values types signatures instances = add-import-owners home
    (resolved-owners values <> constructor-owners types <> signature-owners signatures <> resolved-owners instances) names
  source-primitives :: Json -> List Json -> Json
  source-primitives context rows = case rows of
    Nil -> JArrEnd
    Cons row rest -> if same (text (field "category" row)) "intrinsic" && has-symbol (text (field "binding" row)) (field "declarations" context) then
      insert-string (text (field "identity" row)) (source-primitives context rest)
      else source-primitives context rest
  foreign-drop-prefix :: List Char -> List Char -> Option (List Char)
  foreign-drop-prefix prefix full = case prefix of
    Nil -> Some full
    Cons first rest -> (case full of Cons actual more -> if char-code first == char-code actual then foreign-drop-prefix rest more else None; Nil -> None)
  intrinsic-empty-result :: Json
  intrinsic-empty-result = JObj "type" (JStr "") (JObj "class" (JStr "unit") (JObj "role" (JStr "value")
    (JObj "allocator" (JStr "") (JObj "nullable" (JBool False) (JObj "width" (JNum 0)
      (JObj "align" (JNum 1) (JObj "signed" (JBool False) (JObj "offsets" JArrEnd JObjEnd))))))))
  array-foreign-row :: String -> Json -> Json
  array-foreign-row local row = JObj "symbol" (JStr local) (JObj "abi" (JStr "ccall") (JObj "external" (field "identity" row) (JObj "type" (field "scheme" row) (JObj "effects" (JStr "") (JObj "notes" (JStr "") (JObj "kind" (JStr "intrinsic") (JObj "params" (JArrEnd) (JObj "result" (intrinsic-empty-result) (JObj "deallocator" (JStr "") (JObjEnd))))))))))
  source-intrinsic-foreign :: Json -> List Json -> Json
  source-intrinsic-foreign context rows = case rows of
    Nil -> JArrEnd
    Cons row rest -> let more = source-intrinsic-foreign context rest in
      if not (same (text (field "category" row)) "intrinsic" && has-symbol (text (field "binding" row)) (field "declarations" context)
        && (case array-plan (text (field "identity" row)) of Some plan -> True; None -> False)) then more else
      (case export-global (text (field "binding" row)) of
        Ok identity -> (case foreign-drop-prefix (unpack (string-concat (text (field "module" context)) ".")) (unpack identity) of
          Some local -> insert-row "symbol" (array-foreign-row (pack local) row) more
          None -> more)
        Err error -> more)
  source-foreign-rows :: String -> List CheckedBinding -> Json -> Result String Json
  source-foreign-rows owner bindings rows = case bindings of
    Nil -> Ok rows
    Cons binding rest -> case checked-foreign-plan binding of
      None -> source-foreign-rows owner rest rows
      Some plan -> case export-global (checked-name binding) of
        Err error -> Err error
        Ok identity -> case foreign-drop-prefix (unpack (string-concat owner ".")) (unpack identity) of
          None -> source-foreign-rows owner rest rows
          Some local -> case foreign-document (pack local) plan of
            Err error -> Err error
            Ok row -> source-foreign-rows owner rest (insert-row "symbol" row rows)
  foreign-assumptions :: Json -> Json
  foreign-assumptions rows = case rows of
    JArr row rest -> if same (text (field "kind" row)) "import" then insert-string (text (field "external" row)) (foreign-assumptions rest) else foreign-assumptions rest
    other -> JArrEnd
  assumptions :: Json -> Json -> Json
  assumptions primitives rows = JObj "primitives" primitives (JObj "foreign" (foreign-assumptions rows) (JObj "declared" JArrEnd JObjEnd))
  law-order :: Json -> String
  law-order row = string-concat-all [text (field "instance" row), "\n", text (field "class" row), "\n", text (field "law" row)]
  insert-law :: Json -> Json -> Json
  insert-law row rows = case rows of
    JArr first rest -> if string-compare (law-order row) (law-order first) < 0 then JArr row rows else JArr first (insert-law row rest)
    other -> JArr row JArrEnd
  law-observations :: Json -> List (String, String, String, String) -> Result String Json
  law-observations context observations = case observations of
    Nil -> Ok JArrEnd
    Cons (subject, owner, law-name, status) rest -> case law-observations context rest of
      Err error -> Err error
      Ok rows -> if has-symbol subject (field "declarations" context) then
        (case (export-global subject, export-global owner) of
          (Ok identity, Ok class) -> Ok (insert-law (JObj "instance" (JStr identity) (JObj "class" (JStr class)
            (JObj "law" (JStr law-name) (JObj "status" (JStr status) JObjEnd)))) rows)
          (Err error, other) -> Err error
          (other, Err error) -> Err error)
        else Ok rows
  document :: Json -> String -> Json -> Json -> Json -> Json -> Json -> Json -> Json -> Json -> Json
  document context source-hash dependencies values types signatures instances primitives foreign-rows laws =
    JObj "schema" (JNum (nat-to-int iface-schema-version)) (JObj "runtime_abi" (JNum runtime-abi-int)
      (JObj "language" (JStr "draft-0.2+amendments") (JObj "compiler" (JStr "cinch-self-hosted")
        (JObj "module" (field "module" context) (JObj "source_hash" (JStr source-hash)
          (JObj "imports" dependencies (JObj "params" JArrEnd
            (JObj "exports" (JObj "values" values (JObj "types" types (JObj "signatures" signatures
              (JObj "instances" instances (JObj "foreign" foreign-rows (JObj "fixities" (sort-rows "op" (public-fixities (field "exports" context) (field "fixities" context))) JObjEnd))))))
              (JObj "abi" (JObj "convention" (JStr "uniform-word, curried apply stub")
                (JObj "symbols" (sorted-strings (symbols values)) (JObj "layouts" (layouts types) JObjEnd)))
                (JObj "assumptions" (assumptions primitives foreign-rows) (JObj "assertions" JArrEnd
                  (JObj "contracts" JArrEnd (JObj "must_use" JArrEnd (JObj "laws" laws
                    (JObj "upgrades" JArrEnd (JObj "units" JArrEnd JObjEnd))))))))))))))))
  source-hash :: Bytes -> Json -> Result String String
  source-hash source context = case (field "source_start" context, field "source_end" context) of
    (JNum begin, JNum end) -> if begin >= 0 && end >= begin then
      (let lo = nat-from-int begin in let hi = nat-from-int end in
        if hi <= bytes-len source then Ok (fnv-source-hash (bytes-slice source lo hi)) else Err "module source span leaves input bytes")
      else Err "invalid module source span"
    other -> Err "module source span is missing"
  interface-hash :: Json -> String
  interface-hash doc = fnv-source-hash (canonical-bytes (set-field "units" JArrEnd
    (set-field "compiler" (JStr "") (set-field "source_hash" (JStr "") doc))))
  export-loop :: Elaboration -> List LoadedInterface -> Bytes -> List (String, String) -> List Json -> Result String (List (String, Json))
  export-loop typed interfaces source produced contexts = case contexts of
    Nil -> Ok Nil
    Cons context rest -> case field "module" context of
      JStr name -> case (exports typed interfaces (field "exports" context) (field "exports" context), source-hash source context) of
          (Ok (values, types), Ok hash) ->
            (case instance-rows typed interfaces context (elaboration-instances typed) of
              Err error -> Err error
              Ok instances -> case signature-rows typed interfaces (field "exports" context) (JArr values (JArr instances JArrEnd)) types (elaboration-classes typed) of
                Err error -> Err error
                Ok signatures -> case (imports (checked-imports name (field "imports" context) values types signatures instances) produced interfaces,
                  source-foreign-rows name (elaboration-bindings typed) (source-intrinsic-foreign context (elaboration-contexts typed)),
                  law-observations context (elaboration-law-observations typed)) of
                  (Err error, other, more) -> Err (string-concat-all [name, ": ", error])
                  (other, Err error, more) -> Err error
                  (other, more, Err error) -> Err error
                  (Ok dependencies, Ok foreign-rows, Ok laws) -> let doc = document context hash dependencies values types signatures instances (source-primitives context (elaboration-contexts typed)) foreign-rows laws in
                    (case export-loop typed interfaces source (Cons (name, interface-hash doc) produced) rest of
                      Err error -> Err error
                      Ok more -> Ok (Cons (name, doc) more))
            )
          (Err error, other) -> Err (string-concat-all [name, ": ", error])
          (other, Err error) -> Err (string-concat-all [name, ": ", error])
      other -> export-loop typed interfaces source produced rest
  export-interfaces :: CheckedProgram -> List LoadedInterface -> Bytes -> Result String (List (String, Json))
  export-interfaces checked interfaces source = let typed = checked-elaboration checked in
    case unsupported-modules (program-modules (checked-surface checked)) (elaboration-contexts typed) (elaboration-bindings typed) of
      Some message -> Err message
      None -> export-loop typed interfaces source Nil (elaboration-contexts typed)
  retained-intrinsic :: String -> String -> List Json -> Bool
  retained-intrinsic name identity rows = case rows of
    Nil -> False
    Cons row rest -> (same (text (field "category" row)) "intrinsic" && same (text (field "binding" row)) name && same (text (field "identity" row)) identity)
      || retained-intrinsic name identity rest
  unsupported-modules :: List Module -> List Json -> List CheckedBinding -> Option String
  unsupported-modules modules contexts bindings = case modules of
    Nil -> None
    Cons first rest -> case unsupported-declarations (module-decls first) contexts bindings of Some message -> Some message; None -> unsupported-modules rest contexts bindings
  unsupported-declarations :: List Decl -> List Json -> List CheckedBinding -> Option String
  unsupported-declarations declarations contexts bindings = case declarations of
    Nil -> None
    Cons declaration rest -> case declaration of
      DForeign sp direction abi symbol name syntax -> if retained-intrinsic name symbol contexts || (case find-binding name bindings of Some binding -> (case checked-foreign-plan binding of Some plan -> True; None -> False); None -> False) then unsupported-declarations rest contexts bindings else Some "foreign assumption interface production is incomplete"
      DRecord sp name parameters fields -> Some "record interface production is incomplete"
      -- A private effect grants no public type/operation names. If a public
      -- scheme mentions it, nominal export still refuses the absent contract.
      other -> unsupported-declarations rest contexts bindings
