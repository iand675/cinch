  "capability_mapping": {
    "Encoding/NewEncoding": "Opaque Base64Encoding; validated copied custom alphabets and inverse maps, returning Base64ConfigError",
    "StdEncoding/URLEncoding/RawStdEncoding/RawURLEncoding": "Four immutable public configurations",
    "StdPadding/NoPadding (value and ideal-integer records)": "Some 61 from the standard padding getter and None for no padding; raw public configurations provide common no-padding policies",
    "WithPadding/Strict": "Checked persistent base64-with-padding and base64-strict sharing immutable private tables",
    "EncodedLen/DecodedLen": "Exact encoded length and conservative decoded byte capacity bound",
    "Encode/EncodeToString/AppendEncode": "Fresh exact bytes, optional UTF-8 text, copied-prefix append and checked offset destination writes",
    "Decode/DecodeString/AppendDecode": "Whole-buffer atomic convenience plus progress-preserving byte/text, append and checked offset destination decoding",
    "CorruptInputError/Error": "Named original-byte failures with message and offset accessors; precise module-owned offset policy",
    "NewEncoder/Write/Close": "Inspectable Base64Writer, accepted-byte writes, explicit finish and advanced-sink retrieval on success/failure",
    "NewDecoder/Read": "Bounded decoding reader, copied surplus, inert zero reads and sticky delayed failures"
  },
  "deliberate_api_policies": [
    "Original-byte errors include ignored CR/LF; strict-bit errors point at the final alphabet symbol, and missing padding points at the first unfinished symbol. Incidental reference newline/pad offsets and wording are not copied.",
    "Cinch text is UTF-8, so exact custom output becomes Option String; byte APIs preserve every alphabet/padding byte.",
    "None is the no-padding policy; invalid negative padding values other than this policy are unrepresentable. Some values above255, CR/LF and alphabet collisions return named errors.",
    "Caller-buffer decoding checks its full maximum capacity bound before mutation even when padding/newlines would make the actual decoded result shorter."
  ],
  "limitations": [
    "Foreign kernel object compilation does not establish foreign runtime execution.",
    "Output still uses checked word/byte helpers; generated encode/decode SIMD math is inlined, but public loops remain slower than the independent reference pipelines.",
    "Immutable chunk, append and result ownership differs from mutable reference buffers.",
    "The Native nested-final-argument fingerprint lowering issue is avoided by explicit local sequencing; a separate compiler agent owns the general fix."
  ]
}
