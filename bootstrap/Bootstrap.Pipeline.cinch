-- Rung 6: the pipeline. Every earlier rung is one step; this module is the
-- chain that turns a source file into a RUNNING native binary: read the
-- bytes, parse to the shared tree, check the fragment, refuse with named
-- diagnostics if either stage objects, emit LLVM IR, hand the module to a
-- spawned clang, run the artifact, and report both exit codes.
--
-- See bootstrap/README.md for the ladder and design/bootstrap-ladder.md for
-- the decisions. The imports are SELECTED rather than wholesale on purpose:
-- several rungs export a helper called `rung` (and the ladder's coherence
-- test already caught two modules exporting `bytes-equal-from`), so a
-- consumer that composes them unqualified gets an ambiguity, and the
-- language's remedy is a selection.
--
-- The runnable entry reads four words from its own command line: source,
-- IR module, executable and report. Arguments are never split on whitespace.

module Bootstrap.Pipeline where

  import Bootstrap.Ast (Program, MkProgram, Module, program-modules, program-span, module-name)
  import Bootstrap.Check (CheckedProgram, check-and-retain, checked-surface, checked-elaboration)
  import Bootstrap.CoreBody (dense-claims-verified)
  import Bootstrap.Infer (elaboration-core)
  import Bootstrap.Driver (link-and-report, link-only-and-report)
  import Bootstrap.Ir (emit-checked-diagnostics, emit-checked-program)
  import Bootstrap.RuntimeIr (check-runtime-entry, emit-runtime-program, emit-runtime-program-counting, runtime-library-default-roots, emit-runtime-library-object-with-object)
  import Bootstrap.RuntimeIr (emit-runtime-program-mode, emit-runtime-program-counting-mode, emit-runtime-library-object-with-object-mode)
  import Bootstrap.Object (RuntimeObject, read-runtime-object-document, read-runtime-object-config, runtime-object-input-files, admit-runtime-object)
  import Bootstrap.Parse (parse-program)
  import Bootstrap.Parse (parse-program-with)
  import Bootstrap.Load (LoadedInterface, loaded-module, loaded-hash, loaded-contract, loaded-imports, load-interface, validate-interface-set)
  import Bootstrap.Inputs (read-interfaces, embedded-library-home, read-interface-references, load-interface-references)
  import Bootstrap.Contracts (interface-headers)
  import Bootstrap.Resolve (resolve-program, resolve-program-with, resolve-overlay-with, unshadowed-interfaces)
  import Bootstrap.Stage (expand-stages)
  import Bootstrap.Report (Diagnostic, render-diagnostics, render-source-diagnostics)
  import Bootstrap.Export (export-interfaces, interface-hash, build-manifest)
  import Bootstrap.Interface (fnv-source-hash, sha256-hex)
  import Bootstrap.Target (TargetProfile, profile-triple, target-profile, target-view-program, host-profile)
  import Algebra.Semigroup
  import Effect.Process (process-run, command)
  import Data.Json
  import Data.List (map)
  import Text.Json (canonical-bytes)
  import Data.Nat (nat-to-int)
  import Data.Path (Path, path-from-string, path-to-string, path-is-absolute, path-normalize, path-stem)
  import Data.String (string-concat, string-to-bytes)
  import Effect.Fs (fs-read, fs-write)
  import Text.Scan (string-contains)
  import Text.Parse (Bundle, Failed, ParseError, ParseOutcome, Parsed, render-bundle)

  -- Check-only preserves all frontend checks while stopping before emission.
  -- Compile-only emits and links without running the generated program.
  data PipelineMode where
    CheckOnly :: PipelineMode
    BodiesOnly :: PipelineMode
    EmitOnly :: PipelineMode
    EmitWithInterfaces :: PipelineMode
    InterfacesOnly :: PipelineMode
    ObjectOnly :: PipelineMode
    CompileOnly :: PipelineMode
    CompileAndRun :: PipelineMode

  -- ----------------------------------------------------------------- exits

  -- One code per stage, so a run says where it stopped rather than only
  -- that it stopped. The link stage's codes are the driver rung's own.

  pipeline-ok :: Int
  pipeline-ok = 0

  pipeline-bad-args :: Int
  pipeline-bad-args = 1

  pipeline-read-failed :: Int
  pipeline-read-failed = 2

  pipeline-parse-failed :: Int
  pipeline-parse-failed = 3

  pipeline-check-refused :: Int
  pipeline-check-refused = 4

  pipeline-emit-refused :: Int
  pipeline-emit-refused = 5

  pipeline-write-failed :: Int
  pipeline-write-failed = 6

  pipeline-interface-failed :: Int
  pipeline-interface-failed = 7

  -- --------------------------------------------------------------- helpers

  -- The refusal file sits beside the IR module: a `.diagnostics` suffix on
  -- the path the caller asked for, so a failed run leaves its evidence
  -- exactly where the caller looks for the module.
  refusal-path :: Path -> Path
  refusal-path ir = path-from-string (string-concat (path-to-string ir) ".diagnostics")

  -- Write a refusal's text and answer with the stage's code; a write that
  -- itself fails is its own code, because then the evidence is missing.
  write-failure :: forall r. using (io :: Io r) => Path -> String -> Int ->{IO r} Int
  write-failure ir text code = case fs-write ir (string-to-bytes "") of
    Ok cleared -> (case fs-write (refusal-path ir) (string-to-bytes text) of
      Ok u -> code
      Err e -> pipeline-write-failed)
    Err e -> pipeline-write-failed

  -- A refusal the caller reads where the artifact would have gone: the
  -- diagnostic file beside the IR path, with the stage's code.
  report-target-refusal :: forall r. using (io :: Io r) => Path -> String ->{IO r} Int
  report-target-refusal ir message = write-failure ir message pipeline-bad-args

  -- The four argument words, or None when the caller gave fewer.
  four-words :: List String -> Option (String, String, String, String)
  four-words ws = case ws of
    Cons a rest -> case rest of
      Cons b rest2 -> case rest2 of
        Cons c rest3 -> case rest3 of
          Cons d Nil -> Some (a, b, c, d)
          Cons d (Cons extra tail) -> None
          Nil -> None
        Nil -> None
      Nil -> None
    Nil -> None

  -- ------------------------------------------------------------ the chain

  -- Source to running binary. Each stage hands its artifact to the next,
  -- and the first refusal stops the run with the code that names it.
  --
  -- `target` is the `--target` triple, or `None` for the build host's own
  -- target. It reaches exactly one place: the target view applied between
  -- parsing and resolution, which drops every import and declaration whose
  -- `when` condition the profile does not satisfy. Nothing downstream of
  -- that point knows conditions exist, so a program with no `when` clause
  -- compiles to exactly the artifact it compiled to before the flag existed.
  compile-source :: forall r. using (io :: Io r) => Bool -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source inlining source ir exe report = compile-source-mode inlining None CompileAndRun source ir exe report

  compile-source-mode :: forall r. using (io :: Io r) => Bool -> Option String -> PipelineMode -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-mode inlining wanted mode source ir exe report = case target-profile wanted of
    Err message -> write-failure ir message pipeline-bad-args
    Ok profile -> case mode of
      InterfacesOnly -> compile-source-interfaces profile Nil source ir
      ObjectOnly -> pipeline-bad-args
      EmitWithInterfaces -> pipeline-bad-args
      other -> case fs-read (path-from-string source) of
        Err e -> pipeline-read-failed
        Ok src -> after-parse inlining profile mode source src (parse-program source src) ir exe report

  compile-source-with-manifest :: forall r. using (io :: Io r) => Bool -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-with-manifest inlining manifest source ir exe report = compile-source-with-manifest-mode inlining None CompileAndRun manifest source ir exe report

  compile-source-with-manifest-mode :: forall r. using (io :: Io r) => Bool -> Option String -> PipelineMode -> String -> String -> Path -> Path -> Path ->{IO r, Diverge} Int
  compile-source-with-manifest-mode inlining wanted mode manifest source ir exe report = case target-profile wanted of
    Err message -> write-failure ir message pipeline-bad-args
    Ok profile -> case read-interfaces manifest of
      Err message -> write-failure ir (string-concat "bootstrap.interfaces: " message) pipeline-interface-failed
      Ok interfaces -> case mode of
        InterfacesOnly -> compile-source-interfaces profile interfaces source ir
        ObjectOnly -> pipeline-bad-args
        EmitWithInterfaces -> pipeline-bad-args
        other -> case fs-read (path-from-string source) of
          Err error -> pipeline-read-failed
          Ok src -> after-parse-with inlining profile mode interfaces source src (parse-program-with source src (interface-headers interfaces)) ir exe report

  -- `debug` selects debug counting (`--rc-debug`): the emitted program's
  -- count operations call the runtime's checked out-of-line entries.
  -- `inlining` selects unit copying; `--no-inline` turns it off.
  compile-source-with-object :: forall r. using (io :: Io r) => Bool -> Bool -> String -> String -> String -> Path ->{IO r, Diverge} Int
  compile-source-with-object inlining debug manifest object-config source ir = compile-source-object inlining debug None False manifest object-config source ir
  compile-source-with-object-interfaces :: forall r. using (io :: Io r) => Bool -> Bool -> String -> String -> String -> Path ->{IO r, Diverge} Int
  compile-source-with-object-interfaces inlining debug manifest object-config source ir = compile-source-object inlining debug None True manifest object-config source ir
  compile-source-object :: forall r. using (io :: Io r) => Bool -> Bool -> Option String -> Bool -> String -> String -> String -> Path ->{IO r, Diverge} Int
  compile-source-object inlining debug wanted publish manifest object-config source ir = case target-profile wanted of
    Err message -> write-failure ir message pipeline-bad-args
    Ok profile -> if publish then publish-object-client inlining debug profile manifest object-config source ir else
      (case read-interfaces manifest of
        Err message -> write-failure ir ("bootstrap.interfaces: " <> message) pipeline-interface-failed
        Ok interfaces -> case read-runtime-object-document interfaces object-config of
          Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-interface-failed
          Ok (provider, metadata, object-path, code) -> emit-object-client inlining debug profile None interfaces provider source ir)

  publish-object-client :: forall r. using (io :: Io r) => Bool -> Bool -> TargetProfile -> String -> String -> String -> Path ->{IO r, Diverge} Int
  publish-object-client inlining debug profile manifest object-config source ir =
    let output = build-manifest-path ir in
    let normalize-name = \name -> path-to-string (path-normalize (path-from-string name)) in
    let outputs = map normalize-name [path-to-string ir, path-to-string (refusal-path ir), path-to-string output] in
    let direct = map normalize-name [manifest, object-config, source] in
    if not (object-paths-distinct (outputs <> direct)) then pipeline-bad-args else
      let references = read-interface-references manifest in
      let configuration = read-runtime-object-config object-config in
      let interface-inputs = (case references of Err message -> Nil; Ok rows -> interface-input-files rows) in
      let object-inputs = (case configuration of Err message -> Nil; Ok config -> runtime-object-input-files config) in
      if object-input-overlaps outputs (map normalize-name (interface-inputs <> object-inputs)) then pipeline-bad-args else
        (case fs-write output (string-to-bytes "") of
          Err error -> pipeline-write-failed
          Ok cleared -> case references of
            Err message -> write-failure ir ("bootstrap.interfaces: " <> message) pipeline-interface-failed
            Ok inputs -> case load-interface-references inputs of
              Err message -> write-failure ir ("bootstrap.interfaces: " <> message) pipeline-interface-failed
              Ok interfaces -> case configuration of
                Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-interface-failed
                Ok config -> case admit-runtime-object interfaces config of
                  Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-interface-failed
                  Ok (provider, metadata, object-path, code) ->
                    emit-object-client inlining debug profile (Some metadata) interfaces provider source ir)

  interface-input-files :: List (String, String, String) -> List String
  interface-input-files references = case references of
    Nil -> Nil
    Cons (name, digest, path) rest -> Cons path (interface-input-files rest)
  object-input-overlaps :: List String -> List String -> Bool
  object-input-overlaps outputs inputs = case inputs of
    Nil -> False
    Cons first rest -> object-path-member first outputs || object-input-overlaps outputs rest

  build-manifest-path :: Path -> Path
  build-manifest-path ir = path-from-string (path-to-string ir <> ".manifest.json")
  emit-object-client :: forall r. using (io :: Io r) => Bool -> Bool -> TargetProfile -> Option Json -> List LoadedInterface -> RuntimeObject -> String -> Path ->{IO r, Diverge} Int
  emit-object-client inlining debug profile metadata interfaces provider source ir = case fs-read (path-from-string source) of
    Err error -> write-failure ir "bootstrap.object: cannot read source" pipeline-read-failed
    Ok src -> case parse-program-with source src (interface-headers interfaces) of
      Failed bundle -> write-failure ir (render-bundle bundle) pipeline-parse-failed
      Parsed program Nil -> case target-view-program profile program of
        Err message -> write-failure ir message pipeline-check-refused
        Ok view -> case check-object-client src view interfaces of
          Err message -> write-failure ir message pipeline-check-refused
          Ok checked -> let admitted = unshadowed-interfaces (program-modules view) interfaces in
            let entry = path-stem (path-from-string source) in
            case emit-client-artifacts entry src checked admitted of
              done -> after-object-client inlining debug metadata admitted provider checked entry src ir
      Parsed program errors -> write-failure ir (render-bundle (Bundle source src errors)) pipeline-parse-failed

  -- The client compile path also leaves the driver's artifact set in the
  -- working directory's `build/`. Emission has already checked the program,
  -- so a client whose interfaces cannot be exported still emits.
  emit-client-artifacts :: forall r. using (io :: Io r) => String -> Bytes -> CheckedProgram -> List LoadedInterface ->{IO r, Diverge} Unit
  emit-client-artifacts entry src checked admitted = write-source-artifacts entry src checked admitted Nil

  -- A published interface client writes its interfaces beside the IR path
  -- and its build manifest beside them; a plain client build only emits.
  after-object-client :: forall r. using (io :: Io r) => Bool -> Bool -> Option Json -> List LoadedInterface -> RuntimeObject -> CheckedProgram -> String -> Bytes -> Path ->{IO r, Diverge} Int
  after-object-client inlining debug metadata admitted provider checked entry src ir = case metadata of
    None -> write-runtime-module ir (emit-runtime-program-counting-mode inlining debug checked (Some provider))
    Some document -> case export-interfaces checked admitted src of
      Err message -> write-failure ir ("bootstrap.export: " <> message) pipeline-emit-refused
      Ok rows -> case write-interface-output ir (Ok rows) of
        0 -> case write-runtime-module ir (emit-runtime-program-counting-mode inlining debug checked (Some provider)) of
          0 -> (case fs-write (build-manifest-path ir)
              (canonical-bytes (build-manifest entry document admitted rows)) of
            Ok written -> pipeline-ok
            Err error -> write-failure ir "bootstrap.export: cannot write build manifest" pipeline-write-failed)
          code -> code
        code -> code

  run-source-with-object :: forall r. using (io :: Io r) => Bool -> Bool -> String -> String -> String -> String -> String -> List String ->{IO r, Diverge} Int
  run-source-with-object inlining debug manifest config runtime prefix source words = run-source-with-object-at inlining debug host-profile manifest config runtime prefix source words

  run-source-with-object-at :: forall r. using (io :: Io r) => Bool -> Bool -> TargetProfile -> String -> String -> String -> String -> String -> List String ->{IO r, Diverge} Int
  run-source-with-object-at inlining debug profile manifest config runtime prefix source words =
    let ir = path-from-string (prefix <> ".ll") in
    let executable = prefix <> ".exe" in
    let object-copy = prefix <> ".library.o" in
    let normalize-path = \name -> path-to-string (path-normalize (path-from-string name)) in
    let paths = map normalize-path [manifest, config, runtime, source, path-to-string ir, path-to-string (refusal-path ir), executable, object-copy] in
    if not (object-paths-distinct paths) then pipeline-bad-args
    else case read-interfaces manifest of
      Err message -> write-failure ir ("bootstrap.interfaces: " <> message) pipeline-interface-failed
      Ok interfaces -> case read-runtime-object-document interfaces config of
        Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-interface-failed
        Ok (provider, metadata, object-path, object-bytes) ->
          if object-path-member (normalize-path object-path) paths then pipeline-bad-args
          else case emit-object-client inlining debug profile None interfaces provider source ir of
            0 -> (case fs-write (path-from-string object-copy) object-bytes of
              Err error -> pipeline-write-failed
              Ok written -> link-object-client ir executable object-copy runtime metadata words)
            code -> code
  link-object-client :: forall r. using (io :: Io r) => Path -> String -> String -> String -> Json -> List String ->{IO r, Diverge} Int
  link-object-client ir executable object-copy runtime metadata words =
    let arguments = ["-Wno-override-module", path-to-string ir, object-copy, runtime, "-o", executable] <> object-client-system-libs metadata in
    case process-run (command (path-from-string "clang") arguments) "" of
      Ok (0, output) -> let program = path-from-string executable in
        let program-path = if path-is-absolute program then program else path-from-string ("./" <> executable) in
        (case process-run (command program-path words) "" of
          Ok (status, output) -> case ioWrite output of _ -> nat-to-int status
          Err error -> write-failure ir "bootstrap.driver: cannot execute linked program" pipeline-emit-refused)
      other -> write-failure ir "bootstrap.driver: could not link executable and runtime objects" pipeline-emit-refused
  object-client-system-libs :: Json -> List String
  object-client-system-libs metadata = case object-field "target" metadata of
    JStr triple -> if string-contains "-linux" triple then ["-ldl", "-lpthread", "-lm"] else Nil
    other -> Nil

  -- The interface-only path shares the real parser, resolver and retained
  -- checker. It never asks another compiler to manufacture source contracts.
  checked-source :: Program -> List LoadedInterface -> Result (List Diagnostic) CheckedProgram
  checked-source program interfaces = check-source-phase (\input -> resolve-program-with input interfaces) program
  check-source-phase :: (Program -> (Program, List Diagnostic)) -> Program -> Result (List Diagnostic) CheckedProgram
  check-source-phase resolve program = case expand-stages resolve program of
    Err errors -> Err errors
    Ok expanded -> retain-resolved-source (resolve expanded)
  retain-resolved-source :: (Program, List Diagnostic) -> Result (List Diagnostic) CheckedProgram
  retain-resolved-source result = case result of
    (resolved, Nil) -> case check-and-retain resolved of
      Ok checked -> check-runtime-entry checked
      Err errors -> Err errors
    (resolved, errors) -> Err errors
  overlay-interface :: String -> List LoadedInterface -> Option LoadedInterface
  overlay-interface name interfaces = case interfaces of
    Nil -> None
    Cons entry rest -> if string-compare name (loaded-module entry) == 0 then Some entry else overlay-interface name rest
  overlay-dependencies :: List (String, String) -> List LoadedInterface -> List LoadedInterface -> Result String (List LoadedInterface)
  overlay-dependencies pending all found = case pending of
    Nil -> Ok found
    Cons (name, hash) rest -> case overlay-interface name found of
      Some existing -> overlay-dependencies rest all found
      None -> case overlay-interface name all of
        None -> Err (string-concat "missing source replacement dependency: " name)
        Some dependency -> overlay-dependencies (loaded-imports dependency <> rest) all (Cons dependency found)
  overlay-module :: String -> List Module -> List Module -> Option (Module, List Module)
  overlay-module name modules before = case modules of
    Nil -> None
    Cons candidate rest -> if string-compare name (module-name candidate) == 0 then Some (candidate, reverse before <> rest)
      else overlay-module name rest (Cons candidate before)
  replace-overlay-interface :: LoadedInterface -> List LoadedInterface -> List LoadedInterface
  replace-overlay-interface fresh interfaces = case interfaces of
    Nil -> Nil
    Cons previous rest -> if string-compare (loaded-module fresh) (loaded-module previous) == 0 then Cons fresh rest
      else Cons previous (replace-overlay-interface fresh rest)
  checked-overlay-source :: Program -> List LoadedInterface -> Option LoadedInterface -> Result (List Diagnostic) CheckedProgram
  checked-overlay-source program dependencies facade = case facade of
    Some entry -> check-source-phase (\input -> resolve-overlay-with input dependencies entry) program
    None -> checked-source program dependencies
  rebuild-source-interface :: Bytes -> Program -> String -> List LoadedInterface -> Option LoadedInterface -> Result String (LoadedInterface, Json)
  rebuild-source-interface source program name dependencies facade = case checked-overlay-source program dependencies facade of
    Err errors -> Err (render-source-diagnostics source errors)
    Ok checked -> case export-interfaces checked dependencies source of
      Err message -> Err (string-concat "bootstrap.export: " message)
      Ok (Cons (owner, doc) Nil) -> if string-compare owner name == 0 then
        (case load-interface owner (interface-hash doc) (canonical-bytes doc) of
          Err message -> Err (string-concat "bootstrap.interfaces: " message)
          Ok fresh -> Ok (fresh, doc))
        else Err "bootstrap.interfaces: source replacement changed the defining module"
      Ok other -> Err "bootstrap.interfaces: expected one checked source replacement"
  -- Recheck a base source home with its own dependency closure before
  -- admitting it into the cached set. This keeps the Prelude facade out
  -- of early homes and checks every retained consumer against fresh hashes.
  recheck-source-overlays :: Bytes -> Program -> List LoadedInterface -> List LoadedInterface -> List (String, Json) -> Result String (Program, List LoadedInterface, List (String, Json))
  recheck-source-overlays source program order interfaces written = case order of
    Nil -> (case written of
      Nil -> Ok (program, interfaces, Nil)
      other -> case validate-interface-set interfaces of
        Err message -> Err (string-concat "bootstrap.interfaces: " message)
        Ok checked -> Ok (program, checked, reverse written))
    Cons previous rest -> let name = loaded-module previous in
      if embedded-library-home name then
        (case overlay-module name (program-modules program) Nil of
          None -> recheck-source-overlays source program rest interfaces written
          Some (replacement, remaining) -> case overlay-dependencies (loaded-imports previous) interfaces Nil of
            Err message -> Err (string-concat "bootstrap.interfaces: " message)
            Ok dependencies -> let sp = program-span program in
              case rebuild-source-interface source (MkProgram sp [replacement]) name dependencies (overlay-interface "Prelude" interfaces) of
                Err message -> Err message
                Ok (fresh, doc) -> recheck-source-overlays source (MkProgram sp remaining) rest (replace-overlay-interface fresh interfaces) (Cons (name, doc) written))
      else recheck-source-overlays source program rest interfaces written

  -- A base-package home the client declares itself is the client's version of
  -- that module: the object's copy stays internal and unused, so the source
  -- may shadow it. Any other name the object supplies is closed, and a
  -- source module of that name would silently disagree with the object it
  -- links against.
  object-source-conflict :: List Module -> List LoadedInterface -> Option String
  object-source-conflict modules interfaces = case modules of
    Nil -> None
    Cons first rest -> let name = module-name first in
      if embedded-library-home name then object-source-conflict rest interfaces
      else (case overlay-interface name interfaces of
        Some prior -> Some name
        None -> object-source-conflict rest interfaces)

  check-object-client :: Bytes -> Program -> List LoadedInterface -> Result String CheckedProgram
  check-object-client source program interfaces = case object-source-conflict (program-modules program) interfaces of
    Some name -> Err ("bootstrap.object: module " <> name <> " is already supplied by the library object; rebuild the library to change it")
    None -> case checked-source program interfaces of
      Err errors -> Err (render-source-diagnostics source errors)
      Ok checked -> Ok checked

  compile-source-interfaces :: forall r. using (io :: Io r) => TargetProfile -> List LoadedInterface -> String -> Path ->{IO r, Diverge} Int
  compile-source-interfaces profile interfaces source prefix = case fs-read (path-from-string source) of
    Err error -> write-failure prefix "bootstrap.export: cannot read source" pipeline-read-failed
    Ok src -> case parse-program-with source src (interface-headers interfaces) of
      Failed bundle -> write-failure prefix (render-bundle bundle) pipeline-parse-failed
      Parsed program Nil -> case target-view-program profile program of
        Err message -> write-failure prefix message pipeline-check-refused
        Ok view -> (case recheck-source-overlays src view interfaces interfaces Nil of
          Err message -> write-failure prefix message pipeline-check-refused
          Ok (remaining, effective, replaced) -> case (program-modules remaining, replaced) of
            (Nil, Cons first rest) -> write-interface-output prefix (Ok replaced)
            other -> case checked-source remaining effective of
              Err errors -> write-failure prefix (render-source-diagnostics src errors) pipeline-check-refused
              Ok checked -> case export-interfaces checked effective src of
                Err message -> write-interface-output prefix (Err message)
                Ok rows -> write-interface-output prefix (Ok (replaced <> rows)))
      Parsed program errors -> write-failure prefix (render-bundle (Bundle source src errors)) pipeline-parse-failed
  write-interface-files :: forall r. using (io :: Io r) => Path -> List (String, Json) ->{IO r} Result String Unit
  write-interface-files prefix rows = case rows of
    Nil -> Ok ()
    Cons (name, doc) rest -> case fs-write (path-from-string (string-concat (path-to-string prefix) (string-concat "." (string-concat name ".cinchif")))) (canonical-bytes doc) of
      Err error -> Err "cannot write checked interface"
      Ok done -> write-interface-files prefix rest
  write-interface-output :: forall r. using (io :: Io r) => Path -> Result String (List (String, Json)) ->{IO r} Int
  write-interface-output prefix output = case output of
    Err message -> write-failure prefix (string-concat "bootstrap.export: " message) pipeline-emit-refused
    Ok rows -> case write-interface-files prefix rows of
      Err message -> write-failure prefix (string-concat "bootstrap.export: " message) pipeline-write-failed
      Ok done -> case fs-write (refusal-path prefix) (string-to-bytes "") of
        Err error -> pipeline-write-failed
        Ok written -> pipeline-ok

  -- `ParseOutcome`'s `Parsed` carries the value AND the errors a recovering
  -- parse produced, so a clean parse is `Parsed prog Nil`. This rung accepts
  -- only a clean parse: a recovered one stops the pipeline and writes the
  -- recoverable errors beside the module, because handing a half-understood
  -- tree to the checker would be the silent drop the ladder forbids.
  after-parse :: forall r. using (io :: Io r) => Bool -> TargetProfile -> PipelineMode -> String -> Bytes -> ParseOutcome Program -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-parse inlining profile mode name src outcome ir exe report = case outcome of
    Failed bundle -> write-failure ir (render-bundle bundle) pipeline-parse-failed
    Parsed prog Nil -> case target-view-program profile prog of
      Err message -> write-failure ir message pipeline-check-refused
      Ok view -> after-resolve inlining mode src view ir exe report
    Parsed prog recoverable -> write-failure ir (render-bundle (Bundle name src recoverable)) pipeline-parse-failed

  after-parse-with :: forall r. using (io :: Io r) => Bool -> TargetProfile -> PipelineMode -> List LoadedInterface -> String -> Bytes -> ParseOutcome Program -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-parse-with inlining profile mode interfaces name src outcome ir exe report = case outcome of
    Failed bundle -> write-failure ir (render-bundle bundle) pipeline-parse-failed
    Parsed prog Nil -> case target-view-program profile prog of
      Err message -> write-failure ir message pipeline-check-refused
      Ok view -> (if checks-only mode then case recheck-source-overlays src view interfaces interfaces Nil of
          Err message -> write-failure ir message pipeline-check-refused
          Ok (remaining, effective, replaced) -> case (program-modules remaining, replaced) of
            (Nil, Cons first rest) -> write-interface-output ir (Ok Nil)
            other -> after-check-artifacts inlining mode name src effective replaced (checked-source remaining effective) ir exe report
        else after-check-artifacts inlining mode name src interfaces Nil (checked-source view interfaces) ir exe report)
    Parsed prog recoverable -> write-failure ir (render-bundle (Bundle name src recoverable)) pipeline-parse-failed

  -- Modes that stop after checking and leave no interfaces behind.
  checks-only :: PipelineMode -> Bool
  checks-only mode = case mode of
    CheckOnly -> True
    BodiesOnly -> True
    other -> False

  -- A checked check, build or run leaves the driver's artifacts in the
  -- working directory's `build/`: one `<Module>.cinchif` per admitted and
  -- per checked source interface, and `<entry>.manifest.json` naming the
  -- checked module identities. Source rows are written last, so a checked
  -- source module replaces an admitted interface of the same name.
  after-check-artifacts :: forall r. using (io :: Io r) => Bool -> PipelineMode -> String -> Bytes -> List LoadedInterface -> List (String, Json) -> Result (List Diagnostic) CheckedProgram -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-check-artifacts inlining mode name src interfaces replaced result ir exe report = case (mode, result) of
    (InterfacesOnly, other) -> after-check inlining mode src result ir exe report
    (ObjectOnly, other) -> after-check inlining mode src result ir exe report
    (BodiesOnly, other) -> after-check inlining mode src result ir exe report
    (other, Err found) -> after-check inlining mode src result ir exe report
    (other, Ok checked) -> let admitted = unshadowed-interfaces (program-modules (checked-surface checked)) interfaces in
      case write-source-artifacts name src checked admitted replaced of
        done -> after-check inlining mode src result ir exe report

  -- The artifact set is best effort: the frontend's own refusal codes stay
  -- the ones a caller reads, and an interface the checker admits but cannot
  -- project does not turn a passing check into an emission failure.

  -- The first chunk of the serialization arena: one megabyte, one module's
  -- worth of rendered spellings and hash material in a phase. Growth
  -- doubles, so a wider interface set asks for another chunk instead of
  -- copying one.
  arena-first-chunk :: I64
  arena-first-chunk = 1048576

  -- The arena entries (`compiler/runtime/src/arena.rs`). The symbol
  -- namespace is reserved (D73), so a program reaches them only by
  -- spelling the intrinsic and only the checker's own intrinsic table
  -- types that spelling: nothing else in the language can obtain one.
  foreign import ccall "cinch.runtime.arenaNew" arena-new :: I64 -> I64
  foreign import ccall "cinch.runtime.arenaLeave" arena-leave :: I64 -> I64

  -- Interface serialization is the one finished phase whose whole output
  -- is files: the documents themselves are built before this scope (the
  -- manifest embeds them) and what the scope allocates is their rendering,
  -- which nothing reads once the bytes are written. So the scope can hold
  -- its own churn and free it wholesale, and no word it served outlives it.
  -- `CINCH_ARENA=1` enables the scope; unset makes both entries no-ops,
  -- so the same build measures the same phase with every block back on
  -- the counted heap.
  write-source-artifacts :: forall r. using (io :: Io r) => String -> Bytes -> CheckedProgram -> List LoadedInterface -> List (String, Json) ->{IO r, Diverge} Unit
  write-source-artifacts name src checked admitted replaced = case export-interfaces checked admitted src of
    Err message -> ()
    Ok rows -> serialize-artifacts (path-stem (path-from-string name)) admitted (replaced <> rows)

  serialize-artifacts :: forall r. using (io :: Io r) => String -> List LoadedInterface -> List (String, Json) ->{IO r, Diverge} Unit
  serialize-artifacts entry admitted rows =
    let arena = arena-new arena-first-chunk in
    let written = ignore-artifact-outcome (write-build-artifacts entry admitted rows) in
    case arena-leave arena of _ -> written

  -- The artifact write's outcome is already reported through the files it
  -- left (the caller's exit code does not read it), and the value must
  -- not leave the arena, so this reduces it to the unit word inside.
  ignore-artifact-outcome :: Result String Unit -> Unit
  ignore-artifact-outcome outcome = case outcome of
    Err message -> ()
    Ok done -> ()

  write-build-artifacts :: forall r. using (io :: Io r) => String -> List LoadedInterface -> List (String, Json) ->{IO r, Diverge} Result String Unit
  write-build-artifacts entry interfaces rows =
    case process-run (command (path-from-string "mkdir") ["-p", "build"]) "" of
      Ok (0, output) -> (case write-build-interfaces (admitted-rows interfaces <> rows) of
        Err message -> Err message
        Ok done -> case fs-write (path-from-string (string-concat "build/" (string-concat entry ".manifest.json")))
            (canonical-bytes (build-manifest entry JObjEnd interfaces rows)) of
          Ok written -> Ok ()
          Err error -> Err "cannot write build manifest")
      other -> Err "cannot create the build directory"

  admitted-rows :: List LoadedInterface -> List (String, Json)
  admitted-rows interfaces = map (\entry -> (loaded-module entry, loaded-contract entry)) interfaces

  write-build-interfaces :: forall r. using (io :: Io r) => List (String, Json) ->{IO r} Result String Unit
  write-build-interfaces rows = case rows of
    Nil -> Ok ()
    Cons (name, doc) rest -> case fs-write (path-from-string (string-concat "build/" (string-concat name ".cinchif"))) (canonical-bytes doc) of
      Err error -> Err "cannot write checked interface"
      Ok done -> write-build-interfaces rest

  after-resolve :: forall r. using (io :: Io r) => Bool -> PipelineMode -> Bytes -> Program -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-resolve inlining mode src prog ir exe report = after-check inlining mode src (check-source-phase resolve-program prog) ir exe report

  -- The dense body artifact: every checked definition, each with its own
  -- type side table. A consumer decodes one definition at a time.
  dense-bodies-document :: CheckedProgram -> Option Json
  dense-bodies-document checked = case dense-claims-verified (elaboration-core (checked-elaboration checked)) of
    Some bodies -> Some (JObj "schema" (JNum 1) (JObj "bodies" bodies JObjEnd))
    None -> None

  after-check :: forall r. using (io :: Io r) => Bool -> PipelineMode -> Bytes -> Result (List Diagnostic) CheckedProgram -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-check inlining mode src result ir exe report = case result of
    Ok prog -> case mode of
      CheckOnly -> case fs-write (refusal-path ir) (string-to-bytes "") of
        Ok written -> pipeline-ok
        Err e -> pipeline-write-failed
      BodiesOnly -> case dense-bodies-document prog of
        Some doc -> (case fs-write ir (canonical-bytes doc) of
          Ok written -> pipeline-ok
          Err e -> pipeline-write-failed)
        None -> write-failure ir "dense body document does not round trip" pipeline-emit-refused
      EmitOnly -> write-runtime-module ir (emit-runtime-program-mode inlining prog)
      other -> after-emit mode (emit-checked-diagnostics prog) prog ir exe report
    Err found -> write-failure ir (render-source-diagnostics src found) pipeline-check-refused

  after-emit :: forall r. using (io :: Io r) => PipelineMode -> List Diagnostic -> CheckedProgram -> Path -> Path -> Path ->{IO r, Diverge} Int
  after-emit mode found prog ir exe report = case found of
    Nil -> write-module mode ir (emit-checked-program prog) exe report
    Cons d rest -> write-failure ir (render-diagnostics found) pipeline-emit-refused

  -- The typed backend emits a complete shared-runtime LLVM module. Linking
  -- is separate in this mode, so an unavailable lowering cannot fall back
  -- to the standalone fragment's representation or run an old artifact.
  write-runtime-module :: forall r. using (io :: Io r) => Path -> Result (List Diagnostic) String ->{IO r} Int
  write-runtime-module ir result = case result of
    Err found -> case fs-write ir (string-to-bytes "") of
      Err e -> pipeline-write-failed
      Ok cleared -> write-failure ir (render-diagnostics found) pipeline-emit-refused
    Ok text -> case fs-write ir (string-to-bytes text) of
      Err e -> pipeline-write-failed
      Ok written -> case fs-write (refusal-path ir) (string-to-bytes "") of
        Err e -> pipeline-write-failed
        Ok cleared -> pipeline-ok

  -- The last stage: the module lands, then the driver rung links it, runs
  -- the artifact and writes the report the caller reads.
  write-module :: forall r. using (io :: Io r) => PipelineMode -> Path -> String -> Path -> Path ->{IO r, Diverge} Int
  write-module mode ir text exe report = case fs-write ir (string-to-bytes text) of
    Err e -> pipeline-write-failed
    Ok u -> case mode of
      CompileOnly -> link-only-and-report ir exe report
      CompileAndRun -> link-and-report ir exe report
      CheckOnly -> pipeline-emit-refused
      BodiesOnly -> pipeline-emit-refused
      EmitOnly -> pipeline-emit-refused
      EmitWithInterfaces -> pipeline-emit-refused
      InterfacesOnly -> pipeline-emit-refused
      ObjectOnly -> pipeline-emit-refused

  -- Library objects use this same checked frontend. The assembler and
  -- relocatable linker receive individual argument words, never a shell.
  -- A provider copy binds the linked bytes to the authenticated admission
  -- above, even when the original provider path changes during compilation.
  object-field :: String -> Json -> Json
  object-field name doc = case doc of
    JObj key value rest -> if string-compare name key == 0 then value else object-field name rest
    other -> JNull
  object-set :: String -> Json -> Json -> Json
  object-set name value doc = case doc of
    JObj key old rest -> if string-compare name key == 0 then JObj key value rest else JObj key old (object-set name value rest)
    other -> JObj name value JObjEnd
  object-append :: Json -> Json -> Json
  object-append first second = case first of JArr row rest -> JArr row (object-append rest second); JArrEnd -> second; other -> JNull
  object-words-json :: List Nat -> Json
  object-words-json words = case words of Nil -> JArrEnd; Cons word rest -> JArr (JNum (nat-to-int word)) (object-words-json rest)
  object-interface-row :: String -> String -> Json -> Json
  object-interface-row name hash doc = JObj "module" (JStr name) (JObj "iface_hash" (JStr hash) (JObj "interface" doc JObjEnd))
  object-imports :: List LoadedInterface -> Json
  object-imports interfaces = case interfaces of
    Nil -> JArrEnd
    Cons first rest -> JArr (object-interface-row (loaded-module first) (loaded-hash first) (loaded-contract first)) (object-imports rest)
  object-interface-present :: String -> Json -> Option String
  object-interface-present name rows = case rows of
    JArr row rest -> (case (object-field "module" row, object-field "iface_hash" row) of
      (JStr actual, JStr hash) -> if string-compare name actual == 0 then Some hash else object-interface-present name rest
      other -> None)
    other -> None
  object-interface-closure :: List (String, Json) -> Json -> Result String Json
  object-interface-closure rows old = case rows of
    Nil -> Ok old
    Cons (name, doc) rest -> let hash = interface-hash doc in
      case object-interface-present name old of
        Some actual -> if string-compare actual hash == 0 then object-interface-closure rest old else Err "object source disagrees with an admitted interface identity"
        None -> object-interface-closure rest (JArr (object-interface-row name hash doc) old)
  object-unit-present :: String -> Json -> Bool
  object-unit-present name rows = case rows of
    JArr row rest -> (case object-field "symbol" row of JStr actual -> string-compare name actual == 0 || object-unit-present name rest; other -> True)
    JArrEnd -> False
    other -> True
  object-distinct-units :: Json -> Json -> Bool
  object-distinct-units rows old = case rows of
    JArr row rest -> (case object-field "symbol" row of
      JStr name -> not (object-unit-present name old) && object-distinct-units rest (JArr row old)
      other -> False)
    JArrEnd -> True
    other -> False
  object-merge-fields :: Json -> Json -> Json
  object-merge-fields newer older = case newer of
    JObj key value rest -> object-merge-fields rest (object-set key value older)
    JObjEnd -> older
    other -> JNull
  object-family-remove :: String -> Json -> Json
  object-family-remove name rows = case rows of
    JArr row rest -> (case object-field "class" row of
      JStr actual -> if string-compare name actual == 0 then object-family-remove name rest else JArr row (object-family-remove name rest)
      other -> JArr row (object-family-remove name rest))
    other -> JArrEnd
  object-merge-families :: Json -> Json -> Json
  object-merge-families newer older = case newer of
    JArr row rest -> (case object-field "class" row of
      JStr name -> object-merge-families rest (JArr row (object-family-remove name older))
      other -> JNull)
    JArrEnd -> older
    other -> JNull
  object-manifest :: Json -> Json -> List Nat -> Json -> Json -> String -> Bytes -> Json
  object-manifest provider interfaces words units facts ir code =
    let actual = (object-set "method_families" (object-merge-families (object-field "method_families" facts) (object-field "method_families" provider)) (object-set "types" (object-merge-fields (object-field "types" facts) (object-field "types" provider))
      (object-set "constructors" (object-merge-fields (object-field "constructors" facts) (object-field "constructors" provider))
        (object-set "escaped_descriptors" (object-field "escaped_descriptors" facts) provider)))) in
    object-set "interfaces" interfaces
      (object-set "units" (object-append (object-field "units" provider) units)
        (object-set "layout_entries" (JNum (nat-to-int (list-length words)))
          (object-set "layout_words" (object-words-json words)
            (object-set "ir_content_hash" (JStr (fnv-source-hash (string-to-bytes ir)))
              (object-set "object_content_hash" (JStr (fnv-source-hash code)) actual)))))
  object-paths-distinct :: List String -> Bool
  object-paths-distinct paths = case paths of
    Nil -> True
    Cons first rest -> not (object-path-member first rest) && object-paths-distinct rest
  object-path-member :: String -> List String -> Bool
  object-path-member path paths = case paths of Nil -> False; Cons first rest -> string-compare path first == 0 || object-path-member path rest
  write-object-interfaces :: forall r. using (io :: Io r) => String -> List (String, Json) ->{IO r} Result String Unit
  write-object-interfaces prefix rows = case rows of
    Nil -> Ok ()
    Cons (name, doc) rest -> case fs-write (path-from-string (prefix <> name <> ".cinchif")) (canonical-bytes doc) of
      Err error -> Err "cannot write checked object interface"
      Ok done -> write-object-interfaces prefix rest
  compile-source-library-object :: forall r. using (io :: Io r) => Bool -> String -> String -> String -> Path -> Path -> Path -> String ->{IO r, Diverge} Int
  compile-source-library-object inlining manifest configuration source ir object abi prefix =
    compile-source-library-object-at inlining host-profile manifest configuration source ir object abi prefix

  compile-source-library-object-at :: forall r. using (io :: Io r) => Bool -> TargetProfile -> String -> String -> String -> Path -> Path -> Path -> String ->{IO r, Diverge} Int
  compile-source-library-object-at inlining profile manifest configuration source ir object abi prefix =
    let ir-name = path-to-string ir in let object-name = path-to-string object in let abi-name = path-to-string abi in
    if not (object-paths-distinct [manifest, configuration, source, ir-name, object-name, abi-name, object-name <> ".new.o", object-name <> ".provider.o"]) then pipeline-bad-args else
      case fs-write abi (string-to-bytes "") of
        Err error -> pipeline-write-failed
        Ok cleared -> case read-interfaces manifest of
          Err message -> write-failure ir ("bootstrap.interfaces: " <> message) pipeline-interface-failed
          Ok interfaces -> case read-runtime-object-document interfaces configuration of
            Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-interface-failed
            Ok (provider, document, provider-path, provider-code) ->
              if object-path-member provider-path [source, ir-name, object-name, abi-name, object-name <> ".new.o", object-name <> ".provider.o"] then write-failure ir "bootstrap.object: provider and output paths collide" pipeline-bad-args else
                case fs-read (path-from-string source) of
                  Err error -> write-failure ir "bootstrap.object: cannot read source" pipeline-read-failed
                  Ok bytes -> case parse-program-with source bytes (interface-headers interfaces) of
                    Failed bundle -> write-failure ir (render-bundle bundle) pipeline-parse-failed
                    Parsed program Nil -> case target-view-program profile program of
                      Err message -> write-failure ir message pipeline-check-refused
                      Ok view -> (case check-object-client bytes view interfaces of
                        Err message -> write-failure ir message pipeline-check-refused
                        Ok checked -> prepare-library-object inlining checked interfaces bytes provider document provider-code ir object abi prefix)
                    Parsed program errors -> write-failure ir (render-bundle (Bundle source bytes errors)) pipeline-parse-failed
  prepare-library-object :: forall r. using (io :: Io r) => Bool -> CheckedProgram -> List LoadedInterface -> Bytes -> RuntimeObject -> Json -> Bytes -> Path -> Path -> Path -> String ->{IO r, Diverge} Int
  prepare-library-object inlining checked interfaces source provider document provider-code ir object abi prefix = case runtime-library-default-roots checked of
    Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-emit-refused
    Ok roots -> case export-interfaces checked interfaces source of
      Err message -> write-failure ir ("bootstrap.export: " <> message) pipeline-emit-refused
      Ok exported -> case object-interface-closure exported (object-field "interfaces" document) of
        Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-emit-refused
        Ok closure -> case emit-runtime-library-object-with-object-mode inlining checked (Some provider) roots of
          Err errors -> write-failure ir (render-diagnostics errors) pipeline-emit-refused
          Ok (text, words, units, facts) -> if (case object-field "unpublished_dictionaries" facts of JBool True -> True; other -> False) then write-failure ir "bootstrap.object: reached source dictionaries require physical factory and method metadata" pipeline-emit-refused else if not (object-distinct-units units (object-field "units" document)) then write-failure ir "bootstrap.object: source and provider symbols collide" pipeline-emit-refused else
            case fs-write ir (string-to-bytes text) of
              Err error -> pipeline-write-failed
              Ok done -> case fs-write (path-from-string (path-to-string object <> ".provider.o")) provider-code of
                Err error -> pipeline-write-failed
                Ok done -> assemble-library-object document closure exported prefix text words units facts ir object abi
  assemble-library-object :: forall r. using (io :: Io r) => Json -> Json -> List (String, Json) -> String -> String -> List Nat -> Json -> Json -> Path -> Path -> Path ->{IO r, Diverge} Int
  assemble-library-object document closure exported prefix text words units facts ir object abi =
    let object-name = path-to-string object in
    case process-run (command (path-from-string "clang") ["-Wno-override-module", "-c", path-to-string ir, "-o", object-name <> ".new.o"]) "" of
      Err error -> write-failure ir "bootstrap.object: cannot start object assembler" pipeline-emit-refused
      Ok (0, output) -> (case process-run (command (path-from-string "clang") ["-r", "-nostdlib", object-name <> ".provider.o", object-name <> ".new.o", "-o", object-name]) "" of
        Err error -> write-failure ir "bootstrap.object: cannot start dependency linker" pipeline-emit-refused
        Ok (0, output) -> (case fs-read object of
          Err error -> write-failure ir "bootstrap.object: cannot read linked object" pipeline-read-failed
          Ok code -> case write-object-interfaces prefix exported of
            Err message -> write-failure ir ("bootstrap.object: " <> message) pipeline-write-failed
            Ok done -> case fs-write (refusal-path ir) (string-to-bytes "") of
              Err error -> pipeline-write-failed
              Ok done -> case fs-write abi (canonical-bytes (object-manifest document closure words units facts text code)) of
                Err error -> pipeline-write-failed
                Ok done -> pipeline-ok)
        Ok (status, output) -> write-failure ir "bootstrap.object: dependency linker refused" pipeline-emit-refused)
      Ok (status, output) -> write-failure ir "bootstrap.object: object assembler refused" pipeline-emit-refused
