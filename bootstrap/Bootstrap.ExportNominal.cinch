-- Definition-owned private type facts for checked interface output.
-- These rows grant neither constructor names nor field access to a client.
module Bootstrap.ExportNominal where
  import Algebra.Semigroup
  import Bootstrap.Type
  import Bootstrap.Core (CoreData, CoreConstructor, core-data-name, core-data-params, core-data-constructors, core-constructor-name)
  import Bootstrap.ExportType (export-global, export-parameters)
  import Bootstrap.Load (LoadedInterface, loaded-contract)
  import Bootstrap.Nominal (kernel-type-name)
  import Bootstrap.Instance (CoreClass, class-name, class-params)
  import Data.Json
  import Bootstrap.Ast (Decl, DRefine, DSig, DMethod, DFun, DData, DOpaque, DClass, DInstance, DForeign, decls-of, TypeExpr, TName, TIndex, TNegate, TInfix, TFun, TApp, TArg, TArgsEnd, TypeParam, param-name, param-kind, param-implicit, decl-name, type-expr-span)
  import Bootstrap.Contracts (declaration-references)
  import Text.Json (json-eq)

  export source-refinement, source-abstract-type, binding-refinements, merge-nominals, scheme-nominals, data-nominal, parameter-json, parameter-names

  same :: String -> String -> Bool
  same a b = string-compare a b == 0
  field :: String -> Json -> Json
  field name doc = case doc of JObj key value rest -> if same name key then value else field name rest; other -> JNull
  text :: Json -> String
  text doc = case doc of JStr value -> value; other -> ""
  present :: String -> Json -> Bool
  present name doc = case doc of JObj key value rest -> same name key || present name rest; other -> False
  parameter-json :: List (String, String, Bool) -> Json
  parameter-json rows = case rows of
    Nil -> JArrEnd
    Cons (name, kind, automatic) rest -> JArr (JObj "name" (JStr name)
      (JObj "kind" (JStr kind) (JObj "implicit" (JBool automatic) JObjEnd))) (parameter-json rest)
  parameter-names :: List (String, String, Bool) -> Json
  parameter-names rows = case rows of Nil -> JArrEnd; Cons (name, kind, automatic) rest -> JArr (JStr name) (parameter-names rest)
  constructor-names :: List CoreConstructor -> Result String Json
  constructor-names rows = case rows of
    Nil -> Ok JArrEnd
    Cons first rest -> case (export-global (core-constructor-name first), constructor-names rest) of
      (Ok name, Ok more) -> Ok (JArr (JStr name) more)
      (Err error, other) -> Err error
      (other, Err error) -> Err error
  data-nominal :: CoreData -> Result String Json
  data-nominal declaration = case (export-global (core-data-name declaration), export-parameters (core-data-params declaration), constructor-names (core-data-constructors declaration)) of
    (Ok name, Ok parameters, Ok constructors) -> Ok (JObj "identity" (JStr name)
      (JObj "kind" (JStr "data") (JObj "parameters" (parameter-json parameters)
        (JObj "params" (parameter-names parameters) (JObj "constructors" constructors
          (JObj "refinement" JNull JObjEnd))))))
    (Err error, other, more) -> Err error
    (other, Err error, more) -> Err error
    (other, more, Err error) -> Err error
  class-nominal :: CoreClass -> Result String Json
  class-nominal description = case (export-global (class-name description), export-parameters (class-params description)) of
    (Ok name, Ok parameters) -> Ok (JObj "identity" (JStr name)
      (JObj "kind" (JStr "signature") (JObj "parameters" (parameter-json parameters)
        (JObj "params" (parameter-names parameters) (JObj "constructors" JNull (JObj "refinement" JNull JObjEnd))))))
    (Err error, other) -> Err error
    (other, Err error) -> Err error

  -- Traverse checked syntax, never a search over pretty-printed names.
  combine :: Result String (List String) -> Result String (List String) -> Result String (List String)
  combine first second = case (first, second) of
    (Ok a, Ok b) -> Ok (a <> b)
    (Err error, other) -> Err error
    (other, Err error) -> Err error
  kind-references :: Kind -> Result String (List String)
  kind-references kind = case kind of
    KFun a b -> combine (kind-references a) (kind-references b)
    KValue tree -> case value-carrier kind of Some carrier -> type-references carrier; None -> Err "invalid checked value kind"
    other -> Ok Nil
  quant-references :: List Quant -> Result String (List String)
  quant-references quants = case quants of Nil -> Ok Nil; Cons q rest -> combine (kind-references (quant-kind q)) (quant-references rest)
  requirement-references :: List Requirement -> Result String (List String)
  requirement-references requirements = case requirements of Nil -> Ok Nil; Cons r rest -> combine (type-references (requirement-type r)) (requirement-references rest)
  kernel-effect :: String -> Kind -> Bool
  kernel-effect name kind =
    ((same name "Diverge" || same name "Blocking" || same name "Global" || same name "Fail" || same name "Reentrant" || same name "ThreadAffine") && kind-equal kind KEffect)
    || ((same name "IO" || same name "Async" || same name "Cancel" || same name "Eval") && kind-equal kind (KFun KRegion KEffect))
  type-references :: UType -> Result String (List String)
  type-references ty = case ty of
    UCon raw kind -> case export-global raw of
      Err error -> Err error
      Ok name -> if kernel-type-name name || same name "Io" || same name "Dec" || same name "Scope" || same name "Task" || kernel-effect name kind then kind-references kind
        else combine (Ok [name]) (kind-references kind)
    UBound id name kind -> kind-references kind
    URigid id name level kind -> kind-references kind
    UApp f x -> combine (type-references f) (type-references x)
    UFun a b -> combine (type-references a) (type-references b)
    UFunEff a row b -> combine (type-references a) (combine (type-references row) (type-references b))
    UProofFun predicate row result -> if valid-type ty then combine (type-references predicate) (combine (type-references row) (type-references result)) else Err "nominal export contains a malformed erased proof arrow"
    UPi id name a row b -> combine (type-references a) (combine (type-references row) (type-references b))
    URequire predicates body -> combine (type-references predicates) (type-references body)
    URefine id name carrier predicate -> combine (type-references carrier) (type-references predicate)
    UIndex carrier index -> type-references carrier
    UIndexForget value -> type-references value
    UIndexPromote value -> type-references value
    UIndexByteLength value -> type-references value
    -- Executable identities are emitted as checked measure contracts by
    -- Export. Only their argument types can add nominal type dependencies.
    UIndexCall function args -> type-references args
    UIndexMath op a b -> combine (type-references a) (type-references b)
    UCompare relation a b -> combine (type-references a) (type-references b)
    UPropAnd a b -> combine (type-references a) (type-references b)
    UPropOr a b -> combine (type-references a) (type-references b)
    UPropNot value -> type-references value
    UPropNonZero value -> type-references value
    URow labels -> type-references labels
    URowJoin a b -> combine (type-references a) (type-references b)
    UTuple fields -> type-references fields
    UArg first rest -> combine (type-references first) (type-references rest)
    UEnd -> Ok Nil
    UPropLit value -> Ok Nil
    other -> Err "nominal export contains unsupported checked syntax"
  insert :: String -> List String -> List String
  insert name names = case names of
    Nil -> [name]
    Cons first rest -> let order = string-compare name first in
      if order == 0 then names else if order < 0 then Cons name names else Cons first (insert name rest)
  sorted :: List String -> List String -> List String
  sorted names result = case names of Nil -> result; Cons name rest -> sorted rest (insert name result)

  -- Imported carriers may be abstract in Core. Their complete defining
  -- constructor identity table comes from the already validated artifact,
  -- including the private nominal closure of its exported contracts.
  imported-in :: String -> Json -> Option Json
  imported-in name doc = case doc of
    JObj key value rest -> if (case field "identity" doc of JStr identity -> same name identity; other -> False)
        && present "constructors" doc && present "parameters" doc then Some doc
      else (case imported-in name value of Some row -> Some row; None -> imported-in name rest)
    JArr value rest -> (case imported-in name value of Some row -> Some row; None -> imported-in name rest)
    other -> None
  imported-nominal :: String -> List LoadedInterface -> Option Json
  imported-nominal name interfaces = case interfaces of
    Nil -> None
    Cons first rest -> case imported-in name (loaded-contract first) of Some row -> Some row; None -> imported-nominal name rest
  source-class-nominal :: String -> List CoreClass -> Result String Json
  source-class-nominal name classes = case classes of
    Nil -> Err (string-concat "missing defining nominal contract: " name)
    Cons description rest -> case export-global (class-name description) of
      Ok identity -> if same name identity then class-nominal description else source-class-nominal name rest
      Err error -> Err error
  source-nominal :: String -> List Decl -> List CoreData -> List CoreClass -> Result String Json
  source-nominal name declarations datas classes = case datas of
    Nil -> case source-opaque declarations name of Some found -> found; None -> source-class-nominal name classes
    Cons declaration rest -> case export-global (core-data-name declaration) of
      Ok identity -> if same identity name then data-nominal declaration else source-nominal name declarations rest classes
      Err error -> Err error
  nominal-rows :: List String -> List Decl -> List CoreData -> List CoreClass -> List LoadedInterface -> Result String Json
  nominal-rows names declarations datas classes interfaces = case names of
    Nil -> Ok JArrEnd
    Cons name rest -> let actual = case imported-nominal name interfaces of Some row -> Ok row; None -> source-nominal name declarations datas classes in
      case (actual, nominal-rows rest declarations datas classes interfaces) of
        (Ok row, Ok more) -> Ok (JArr row more)
        (Err error, other) -> Err error
        (other, Err error) -> Err error
  scheme-nominals :: Scheme -> List Decl -> List CoreData -> List CoreClass -> List LoadedInterface -> Result String Json
  scheme-nominals scheme declarations datas classes interfaces = case combine (quant-references (scheme-params scheme))
    (combine (requirement-references (scheme-requirements scheme)) (type-references (scheme-body scheme))) of
      Err error -> Err error
      Ok names -> nominal-rows (sorted names Nil) declarations datas classes interfaces

  defining-refinement :: String -> List Decl -> Option Decl
  defining-refinement name declarations = case declarations of
    Nil -> None
    Cons (DRefine sp actual params binder predicate) rest -> if same name actual then Some (DRefine sp actual params binder predicate) else defining-refinement name rest
    Cons other rest -> defining-refinement name rest
  has-name :: String -> List String -> Bool
  has-name name names = case names of Nil -> False; Cons first rest -> same name first || has-name name rest
  source-parameter-names :: List TypeParam -> List String
  source-parameter-names params = case params of Nil -> Nil; Cons p rest -> Cons (param-name p) (source-parameter-names rest)
  primitive-observer :: String -> List Decl -> Bool
  primitive-observer name declarations = case declarations of
    Nil -> False
    Cons (DForeign sp direction abi symbol actual ty) rest -> (same name actual && same direction "import" && same abi "ccall" && same symbol "cinch.runtime.bytesLen") || primitive-observer name rest
    Cons other rest -> primitive-observer name rest
  template-text :: List Decl -> List String -> TypeExpr -> Result String String
  template-text declarations locals syntax = case syntax of
    TName sp name -> if has-name name locals || kernel-type-name name || has-name name ["Type", "Prop", "Region", "Effect", "Row", "True", "False", "NonZero"] then Ok name else export-global name
    TIndex sp literal -> Ok literal
    TNegate sp body -> case template-text declarations locals body of Ok text -> Ok (string-concat "-" text); Err error -> Err error
    TInfix sp op first second -> if has-name op ["+", "-", "*", "<", "<=", ">", ">=", "==", "/=", "&&", "||"] then
      (case (template-text declarations locals first, template-text declarations locals second) of
        (Ok a, Ok b) -> Ok (string-concat-all ["(", a, " ", op, " ", b, ")"])
        (Err error, other) -> Err error
        (other, Err error) -> Err error)
      else Err "refinement predicate has no portable checked operator"
    TFun sp first second -> (case (template-text declarations locals first, template-text declarations locals second) of
      (Ok a, Ok b) -> Ok (string-concat-all ["(", a, " -> ", b, ")"])
      (Err error, other) -> Err error
      (other, Err error) -> Err error)
    TApp sp (TName at name) (TArg arg input (TArgsEnd end)) -> if same name "NonZero" || same name "#kernel.bytes-length" || primitive-observer name declarations then
      (case template-text declarations locals input of
        Ok value -> Ok (string-concat-all ["(", if same name "NonZero" then "NonZero" else "b.bytesLen", " ", value, ")"])
        Err error -> Err error)
      else Err "refinement application needs its retained defining contract"
    other -> Err "refinement template has no portable checked representation"
  template-predicate :: List Decl -> List String -> TypeExpr -> Result String String
  template-predicate declarations locals syntax = case syntax of
    TInfix sp op first second -> case (template-text declarations locals first, template-text declarations locals second) of
      (Ok a, Ok b) -> Ok (string-concat-all [a, " ", op, " ", b])
      (Err error, other) -> Err error
      (other, Err error) -> Err error
    other -> template-text declarations locals syntax
  template-parameters :: List Decl -> List String -> List TypeParam -> Result String (List (String, String, Bool))
  template-parameters declarations locals params = case params of
    Nil -> Ok Nil
    Cons p rest -> let name = param-name p in
      case ((case param-kind p of None -> Ok "Type"; Some syntax -> template-text declarations locals syntax),
        template-parameters declarations (Cons name locals) rest) of
        (Ok kind, Ok more) -> Ok (Cons (name, kind, param-implicit p) more)
        (Err error, other) -> Err error
        (other, Err error) -> Err error
  refinement-nominal :: List Decl -> Decl -> Result String Json
  refinement-nominal declarations declaration = case declaration of
    DRefine sp name params binder predicate -> case param-kind binder of
      None -> Err "checked refinement lost its declared carrier"
      Some carrier -> let locals = source-parameter-names params in
        case (export-global name, template-parameters declarations Nil params,
          template-text declarations locals carrier, template-predicate declarations (Cons (param-name binder) locals) predicate) of
          (Ok identity, Ok parameters, Ok base, Ok condition) -> Ok (JObj "identity" (JStr identity)
            (JObj "kind" (JStr "refinement") (JObj "params" (parameter-names parameters)
              (JObj "parameters" (parameter-json parameters) (JObj "constructors" JNull
                (JObj "refinement" (JObj "binder" (JStr (param-name binder))
                  (JObj "carrier" (JStr base) (JObj "predicate" (JStr condition) JObjEnd))) JObjEnd))))))
          (Err error, other, more, last) -> Err error
          (other, Err error, more, last) -> Err error
          (other, more, Err error, last) -> Err error
          (other, more, last, Err error) -> Err error
    other -> Err "missing defining refinement declaration"
  opaque-nominal :: List Decl -> Decl -> Result String Json
  opaque-nominal declarations declaration = case declaration of
    DOpaque sp name params kind -> case (export-global name, template-parameters declarations Nil params) of
      (Ok identity, Ok parameters) -> Ok (JObj "identity" (JStr identity)
        (JObj "kind" (JStr "opaque") (JObj "parameters" (parameter-json parameters)
          (JObj "params" (parameter-names parameters) (JObj "constructors" JNull (JObj "refinement" JNull JObjEnd))))))
      (Err error, other) -> Err error
      (other, Err error) -> Err error
    other -> Err "missing checked opaque declaration"
  source-opaque :: List Decl -> String -> Option (Result String Json)
  source-opaque declarations name = find-source-opaque declarations declarations name
  find-source-opaque :: List Decl -> List Decl -> String -> Option (Result String Json)
  find-source-opaque declarations remaining name = case remaining of
    Nil -> None
    Cons (DOpaque sp actual params kind) rest -> case export-global actual of
      Ok identity -> if same name actual || same name identity then Some (opaque-nominal declarations (DOpaque sp actual params kind)) else find-source-opaque declarations rest name
      Err error -> Some (Err error)
    Cons other rest -> find-source-opaque declarations rest name
  source-abstract-type :: List Decl -> String -> Option (Result String Json)
  source-abstract-type declarations name = case source-refinement declarations name of Some found -> Some found; None -> source-opaque declarations name
  source-refinement :: List Decl -> String -> Option (Result String Json)
  source-refinement declarations name = case defining-refinement name declarations of None -> None; Some declaration -> Some (refinement-nominal declarations declaration)
  insert-nominal :: Json -> Json -> Result String Json
  insert-nominal row rows = case rows of
    JArr first rest -> let order = string-compare (text (field "identity" row)) (text (field "identity" first)) in
      if order == 0 then (if json-eq row first then Ok rows else Err "conflicting defining nominal contracts")
      else if order < 0 then Ok (JArr row rows)
      else case insert-nominal row rest of Ok more -> Ok (JArr first more); Err error -> Err error
    JArrEnd -> Ok (JArr row JArrEnd)
    other -> Err "invalid defining nominal closure"
  merge-nominals :: Json -> Json -> Result String Json
  merge-nominals first second = case first of
    JArr row rest -> (case insert-nominal row second of Ok next -> merge-nominals rest next; Err error -> Err error)
    JArrEnd -> Ok second
    other -> Err "invalid defining nominal closure"
  referenced-refinements :: List Decl -> List String -> List String -> Result String Json
  referenced-refinements declarations names seen = case names of
    Nil -> Ok JArrEnd
    Cons name rest -> if has-name name seen then referenced-refinements declarations rest seen else
      (case defining-refinement name declarations of
        None -> referenced-refinements declarations rest (Cons name seen)
        Some declaration -> case declaration of
          DRefine sp actual params binder predicate -> let refs = (declaration-references [DData sp actual params Nil, DSig sp actual predicate] <>
            (case param-kind binder of Some carrier -> declaration-references [DSig sp actual carrier]; None -> Nil)) in
            case (refinement-nominal declarations declaration, referenced-refinements declarations (refs <> rest) (Cons name seen)) of
              (Ok row, Ok more) -> insert-nominal row more
              (Err error, other) -> Err error
              (other, Err error) -> Err error
          other -> Err "invalid checked refinement provenance")
  constructor-reference-names :: String -> List (String, TypeExpr) -> List String
  constructor-reference-names name constructors = case constructors of
    Nil -> Nil
    Cons (actual, syntax) rest -> if same name actual then declaration-references [DSig (type-expr-span syntax) actual syntax] else constructor-reference-names name rest
  binding-reference-names :: String -> List Decl -> List String
  binding-reference-names name declarations = case declarations of
    Nil -> Nil
    Cons declaration rest -> (case declaration of
      DClass sp actual params members -> binding-reference-names name (decls-of members)
      DInstance sp flag actual params head-type members ->
        (if same actual name then declaration-references [DData sp actual params Nil, DSig sp actual head-type] else Nil) <> binding-reference-names name (decls-of members)
      DData sp actual params constructors -> constructor-reference-names name constructors
      other -> case decl-name declaration of
        Some actual -> if same actual name then declaration-references [declaration] else Nil
        None -> Nil) <> binding-reference-names name rest
  binding-refinements :: List Decl -> String -> Result String Json
  binding-refinements declarations name = referenced-refinements declarations (binding-reference-names name declarations) Nil
