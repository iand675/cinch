-- Rank-one elaboration. Definition-site class schemes and lexical
-- dictionaries are retained in Core. Instance selection, effects and
-- dependent obligations still require further elaboration.
module Bootstrap.Infer where

  import Bootstrap.Ast
  import Bootstrap.Type
  import Bootstrap.Foreign (ForeignPlan, foreign-plan, foreign-document, primitive-plan)
  import Bootstrap.Index
  import Bootstrap.Total
  import Bootstrap.BodyContract
  import Bootstrap.Guarded
  import Bootstrap.Proof (Proposition, PNegate, disproved)
  import Data.Nat (nat-from-int, nat-to-int)
  import Text.Show (int-to-string)
  import Text.Scan (string-words)
  import Data.Bytes (bytes-len)
  import Bootstrap.Core
  import Bootstrap.Instance
  import Bootstrap.Global
  import Bootstrap.Contracts (declaration-references, expr-references)
  import Bootstrap.Load (InterfaceSet, load-checked-interface-set-from-contracts, interface-set-body, interface-set-has-body)
  import Text.Json (canonical-bytes)
  import Bootstrap.ExportType (export-global, diagnostic-member-name, constructor-field-erasure)
  import Bootstrap.Typing
  import Bootstrap.Builtin (builtin-declarations, builtin-syntax-metadata, intrinsic-contract, array-plan, array-type-name, u32-wrapping-operation)
  import Bootstrap.RuntimeAbi (runtime-abi-int)
  import Bootstrap.Dictionary (resolve-dictionary-definition-with, resolve-dictionary-term-with, resolve-ready-term, check-instance-coherence, check-law-term-evidence, law-context-resolves)
  import Bootstrap.Parse (parse-scheme)
  import Bootstrap.Nominal (interface-global, encode-identity, resolved-entry-valid, resolved-text, resolved-nominals, qualify-resolved, qualify-refinement-predicate, resolved-measures, global-data-core-cons, global-data-core-list, global-data-core-nil, global-data-fromlist-fromlist, global-data-fromlist-fromlist-from-list, global-data-string-string, global-stage-code)
  import Bootstrap.Report (Diagnostic)
  import Data.Json
  import Text.Lex (Span, span-line, span-col)
  import Text.Parse (ParseOutcome, Parsed, Failed)
  import Algebra.Semigroup
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Bootstrap.Temporal (ContractKind, Safety, Liveness, Recurrence, Stability, contract-kind-keyword, contract-kind-operator, check-contract-shape, contract-assumption-rows, contract-formula-row, contract-formula-clause, contract-kind)
  import Bootstrap.TemporalCheck (Parameter, parameter-name, parameter-id, parameter-type, TemporalStep, TemporalOpaque, TemporalVerdict, temporal-definition-steps, temporal-definition-parameters, temporal-recursive, temporal-descent, temporal-proposition, verify-safety, verify-stability, verify-recurrence, verify-liveness, temporal-scope-sites, verdict-verified, verdict-message)

  export needs-inference, infer-program, elaborate-program
  export Elaboration, elaboration-errors, elaboration-bindings, elaboration-contexts, elaboration-core, elaboration-law-observations
  export elaboration-core-contracts-closed, elaboration-rewrite-assumptions
  export CheckedBinding, checked-name, checked-scheme, checked-role, checked-body-binding, checked-guarded-binding, checked-method-matches, checked-conditional-target
  export checked-foreign-plan, checked-intrinsic-symbol
  export elaboration-declarations, elaboration-data, elaboration-effects, elaboration-classes, elaboration-class-context, elaboration-instances
  export elaboration-temporal, TemporalRow, temporal-row-definition, temporal-row-name, temporal-row-kind
  export temporal-row-formula, temporal-row-assumptions, temporal-row-result
  export source-class-default-symbol, source-class-default-clauses, portable-default-export-global

  -- Surface templates live only in this elaboration context. Checked
  -- Core and the type engine continue to contain typed terms exclusively.
  data ByteObservation where
    ByteObservation :: String -> Option String -> ByteObservation
    TotalObservation :: String -> BodyBinding -> ByteObservation
    IdentityObservation :: String -> Scheme -> ByteObservation
    ArrayObservation :: String -> Json -> ByteObservation
  data TypeContext where
    MkTypeContext :: List (String, Kind) -> List Decl -> List String -> List ByteObservation -> List CoreEffect -> List CoreClass -> TypeContext
  context-kind :: String -> TypeContext -> Option Kind
  context-kind name context = case context of MkTypeContext kinds aliases active observers effects source-classes -> lookup-kind name kinds
  context-add-kind :: String -> Kind -> TypeContext -> TypeContext
  context-add-kind name kind context = case context of MkTypeContext kinds aliases active observers effects source-classes -> MkTypeContext (Cons (name, kind) kinds) aliases active observers effects source-classes
  context-aliases :: TypeContext -> List Decl
  context-aliases context = case context of MkTypeContext kinds aliases active observers effects source-classes -> aliases
  context-add-alias :: Decl -> TypeContext -> TypeContext
  context-add-alias alias context = case context of MkTypeContext kinds aliases active observers effects source-classes -> MkTypeContext kinds (Cons alias aliases) active observers effects source-classes
  context-enter-alias :: String -> TypeContext -> Option TypeContext
  context-enter-alias name context = case context of
    MkTypeContext kinds aliases active observers effects source-classes -> if has name active then None else Some (MkTypeContext kinds aliases (Cons name active) observers effects source-classes)

  context-effects :: TypeContext -> List CoreEffect
  context-effects context = case context of MkTypeContext kinds aliases active observers effects source-classes -> effects
  context-with-effects :: List CoreEffect -> TypeContext -> TypeContext
  context-with-effects declarations context = case context of MkTypeContext kinds aliases active observers effects source-classes -> MkTypeContext kinds aliases active observers (declarations <> effects) source-classes
  context-source-classes :: TypeContext -> List CoreClass
  context-source-classes context = case context of MkTypeContext kinds aliases active observers effects source-classes -> source-classes
  context-with-source-class :: CoreClass -> TypeContext -> TypeContext
  context-with-source-class description context = case context of MkTypeContext kinds aliases active observers effects source-classes -> MkTypeContext kinds aliases active observers effects (Cons description source-classes)
  -- The whole-environment projections the checker asks for once per name use,
  -- folded once when the module environment is sealed. A projection of an
  -- environment longer than the sealed one is the same fold over the local
  -- prefix followed by this record, because every later binding sits in front
  -- of the marker and none behind it.
  data EnvCache where
    MkEnvCache :: List (String, Scheme) -> List GuardedBinding -> List CoreGiven -> EnvCache
  cached-instances :: EnvCache -> List (String, Scheme)
  cached-instances cache = case cache of MkEnvCache instances guarded givens -> instances
  cached-guarded :: EnvCache -> List GuardedBinding
  cached-guarded cache = case cache of MkEnvCache instances guarded givens -> guarded
  cached-givens :: EnvCache -> List CoreGiven
  cached-givens cache = case cache of MkEnvCache instances guarded givens -> givens

  data CheckedBinding where
    MkCheckedBinding :: String -> Scheme -> String -> CheckedBinding
    MkForeignBinding :: String -> Scheme -> ForeignPlan -> CheckedBinding
    MkBodyBinding :: BodyBinding -> CheckedBinding
    -- The module environment's cache entry: the checked body contracts, the
    -- position of each name's first binding in the rest of the list, and the
    -- projections above. A binding cannot live in the map directly: a
    -- recursive occurrence nested inside another type constructor is outside
    -- the positivity discipline.
    MkBodyContext :: BodyBindings -> HashMap String Nat -> EnvCache -> CheckedBinding
    MkMethodBinding :: String -> Scheme -> String -> Nat -> CheckedBinding
    MkConditionalBinding :: String -> String -> Nat -> String -> UType -> Scheme -> Option GuardedBinding -> CheckedBinding
    MkGivenBinding :: String -> UType -> String -> CheckedBinding
    MkLocalBinding :: String -> Scheme -> Nat -> Nat -> CheckedBinding
    MkMemoBinding :: String -> UType -> Nat -> CheckedBinding
    -- A strict, monomorphic let whose checked RHS has a total index form.
    -- Its runtime slot remains distinct; only type conversion uses the RHS.
    MkValueBinding :: String -> Scheme -> Nat -> Nat -> UType -> CheckedBinding
    MkIntrinsicBinding :: String -> Scheme -> String -> CheckedBinding
    MkProofBinding :: Span -> Option Span -> Proposition -> CheckedBinding
    MkErasedBinding :: String -> UType -> Nat -> Span -> Option Span -> CheckedBinding
    MkSyntaxBinding :: String -> CheckedBinding
  checked-name :: CheckedBinding -> String
  checked-name b = case b of MkBodyContext context names cache -> ""; MkBodyBinding binding -> binding-name binding; MkCheckedBinding name sc role -> name; MkForeignBinding name sc plan -> name; MkMethodBinding name sc owner slot -> name; MkConditionalBinding name owner slot dictionary head sc guarded -> name; MkGivenBinding name ty symbol -> name; MkLocalBinding name sc id level -> name; MkMemoBinding name ty id -> name; MkValueBinding name sc id level value -> name; MkIntrinsicBinding name sc symbol -> name; MkProofBinding origin invalidated fact -> ""; MkErasedBinding name predicate id origin invalidated -> name; MkSyntaxBinding name -> name
  checked-scheme :: CheckedBinding -> Scheme
  checked-scheme b = case b of MkBodyContext context names cache -> mono UError; MkBodyBinding binding -> binding-scheme binding; MkCheckedBinding name sc role -> sc; MkForeignBinding name sc plan -> sc; MkMethodBinding name sc owner slot -> sc; MkConditionalBinding name owner slot dictionary head sc guarded -> sc; MkGivenBinding name ty symbol -> mono ty; MkLocalBinding name sc id level -> sc; MkMemoBinding name ty id -> mono ty; MkValueBinding name sc id level value -> sc; MkIntrinsicBinding name sc symbol -> sc; MkProofBinding origin invalidated fact -> mono UError; MkErasedBinding name predicate id origin invalidated -> mono predicate; MkSyntaxBinding name -> mono UError
  checked-role :: CheckedBinding -> String
  checked-role b = case b of MkBodyContext context names cache -> "body-context"; MkBodyBinding binding -> binding-role binding; MkCheckedBinding name sc role -> role; MkForeignBinding name sc plan -> "foreign"; MkMethodBinding name sc owner slot -> "method"; MkConditionalBinding name owner slot dictionary head sc guarded -> "external"; MkGivenBinding name ty symbol -> "dictionary"; MkLocalBinding name sc id level -> "local"; MkMemoBinding name ty id -> "local"; MkValueBinding name sc id level value -> "local"; MkIntrinsicBinding name sc symbol -> "intrinsic"; MkProofBinding origin invalidated fact -> "proof"; MkErasedBinding name predicate id origin invalidated -> "erased-proof"; MkSyntaxBinding name -> "builtin-syntax"
  -- Retain the declaring instance/slot for backend authorization. This
  -- does not introduce a source binding for the private implementation.
  checked-conditional-target :: CheckedBinding -> Option (String, String, Nat)
  checked-conditional-target binding = case binding of
    MkConditionalBinding name owner slot dictionary head sc guarded -> Some (owner, interface-global dictionary, slot)
    other -> None
  checked-method-matches :: CheckedBinding -> String -> String -> Nat -> Bool
  checked-method-matches binding name owner slot = case binding of
    MkMethodBinding actual sc declaring index -> same name actual && same owner declaring && slot == index
    other -> False
  checked-foreign-plan :: CheckedBinding -> Option ForeignPlan
  checked-foreign-plan binding = case binding of MkForeignBinding name scheme plan -> Some plan; other -> None
  -- The runtime intrinsic a checked binding names, when it is one. The
  -- canonical symbol selects the arithmetic total body the intrinsic's
  -- scheme carries.
  checked-intrinsic-symbol :: CheckedBinding -> Option String
  checked-intrinsic-symbol binding = case binding of MkIntrinsicBinding name scheme symbol -> Some symbol; other -> None
  checked-body-binding :: CheckedBinding -> Option BodyBinding
  checked-body-binding binding = case binding of MkBodyBinding body -> Some body; other -> None
  -- Checked equations remain separate from definitional conversion and
  -- from the sample observations reported by an instance.
  data CheckedRewrite where
    MkCheckedRewrite :: String -> CoreTerm -> CoreTerm -> Option CoreTerm -> Option String -> CheckedRewrite
  rewrite-assumptions :: List CheckedRewrite -> List (String, String)
  rewrite-assumptions rules = case rules of
    Nil -> Nil
    Cons (MkCheckedRewrite name lhs rhs guard (Some identity)) rest -> Cons (name, identity) (rewrite-assumptions rest)
    Cons other rest -> rewrite-assumptions rest

  -- One verified temporal contract (core specification section 10): the
  -- definition and contract it names, the kind and formula, the stated
  -- assumptions, and the verification's own argument. The rows are the
  -- interface facts and manifest rows a consumer reads.
  data TemporalRow where
    MkTemporalRow :: String -> String -> String -> String -> List String -> String -> TemporalRow

  temporal-row-definition :: TemporalRow -> String
  temporal-row-definition r = case r of MkTemporalRow definition name kind formula assumptions result -> definition

  temporal-row-name :: TemporalRow -> String
  temporal-row-name r = case r of MkTemporalRow definition name kind formula assumptions result -> name

  temporal-row-kind :: TemporalRow -> String
  temporal-row-kind r = case r of MkTemporalRow definition name kind formula assumptions result -> kind

  temporal-row-formula :: TemporalRow -> String
  temporal-row-formula r = case r of MkTemporalRow definition name kind formula assumptions result -> formula

  temporal-row-assumptions :: TemporalRow -> List String
  temporal-row-assumptions r = case r of MkTemporalRow definition name kind formula assumptions result -> assumptions

  temporal-row-result :: TemporalRow -> String
  temporal-row-result r = case r of MkTemporalRow definition name kind formula assumptions result -> result

  data Elaboration where
    MkElaboration :: List Diagnostic -> List CheckedBinding -> List Json -> List CoreDefinition -> List CoreData -> List CoreEffect -> CoreClassContext -> List CoreInstance -> List Decl -> List (String, String, String, String) -> List CheckedRewrite -> List TemporalRow -> Elaboration
  elaboration-rewrite-assumptions :: Elaboration -> List (String, String)
  elaboration-rewrite-assumptions e = case e of
    MkElaboration Nil bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> rewrite-assumptions rewrites
    other -> Nil
  elaboration-law-observations :: Elaboration -> List (String, String, String, String)
  elaboration-law-observations e = case e of MkElaboration Nil bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> observations; other -> Nil
  elaboration-errors :: Elaboration -> List Diagnostic
  elaboration-errors e = case e of MkElaboration errors bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> errors
  elaboration-bindings :: Elaboration -> List CheckedBinding
  elaboration-bindings e = case e of MkElaboration Nil bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> bindings; other -> Nil
  elaboration-contexts :: Elaboration -> List Json
  elaboration-contexts e = case e of MkElaboration errors bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> contexts
  elaboration-core :: Elaboration -> List CoreDefinition
  elaboration-core e = case e of MkElaboration Nil bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> core; other -> Nil

  -- A retained proof may cite actual helper or instance bodies. Recheck
  -- it against the same checked declaration context, not an empty world.
  -- The standalone Core API deliberately keeps its stricter empty context.
  elaboration-core-contracts-closed :: Elaboration -> Bool
  elaboration-core-contracts-closed result = case result of
    MkElaboration Nil bindings contexts definitions datas effects descriptions instances declarations observations rewrites temporal ->
      closed-elaboration-definitions (env-body-context bindings) (env-guarded-bindings bindings) definitions
    other -> False
  closed-elaboration-definitions :: BodyBindings -> List GuardedBinding -> List CoreDefinition -> Bool
  closed-elaboration-definitions bodies guards definitions = case definitions of
    Nil -> True
    Cons definition rest -> core-definition-checked-contracts-closed bodies guards definition && closed-elaboration-definitions bodies guards rest

  -- Only a successful elaboration exposes its defining declarations.
  -- Interface provenance comes from these resolved, checked definitions.
  elaboration-declarations :: Elaboration -> List Decl
  elaboration-declarations e = case e of MkElaboration Nil bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> declarations; other -> Nil

  elaboration-data :: Elaboration -> List CoreData
  elaboration-data e = case e of MkElaboration Nil bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> datas; other -> Nil

  elaboration-effects :: Elaboration -> List CoreEffect
  elaboration-effects e = case e of MkElaboration Nil bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> effects; other -> Nil

  elaboration-classes :: Elaboration -> List CoreClass
  elaboration-classes e = case e of MkElaboration Nil bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> context-classes descriptions; other -> Nil
  elaboration-class-context :: Elaboration -> CoreClassContext
  elaboration-class-context e = case e of MkElaboration Nil bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> descriptions; other -> MkCoreClassContext Nil Nil
  elaboration-instances :: Elaboration -> List CoreInstance
  elaboration-instances e = case e of MkElaboration Nil bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> instances; other -> Nil
  -- The verified temporal contracts, in declaration order (core
  -- specification section 10): the interface facts and manifest rows.
  elaboration-temporal :: Elaboration -> List TemporalRow
  elaboration-temporal e = case e of MkElaboration errors bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> temporal

  same :: String -> String -> Bool
  same a b = string-compare a b == 0
  zero :: Span
  zero = Span 0 0 1 1
  unsupported-import :: String -> String -> String
  unsupported-import category name =
    if same category "builtin" then string-concat "builtin needs region, capability and effect elaboration: " name
    else if same category "builtin-syntax" then string-concat "builtin syntax needs dependent predicate elaboration: " name
    else if same category "builtin-constructor" then string-concat "builtin constructor needs proposition instantiation and erasure checking: " name
    else string-concat-all ["imported ", category, " needs kind, constructor or dictionary elaboration: ", name]
  unsupported-decl :: Decl -> String
  unsupported-decl d = case d of
    DInstance s only name ps app members -> "instance declarations are not supported in this rung"
    DClass s name ps members -> "class declarations are not supported in this rung"
    DForeign s direction abi symbol name ty -> "foreign declarations are not supported in this rung"
    DEffect s name ps ops -> "effect declarations are not supported in this rung"
    DRefine s name ps binder predicate -> "named refinement declarations need proof checking, which is not supported in this rung"
    DImport s path mods alias members hidden args -> "module imports need interface resolution, which is not supported in this rung"
    other -> "declaration needs dictionary, effect or dependent elaboration"
  bad :: Span -> String -> Store -> (UType, Store)
  bad sp message st = (UError, add-error sp message st)
  has :: String -> List String -> Bool
  has name names = case names of Nil -> False; Cons n rest -> same name n || has name rest
  field :: String -> Json -> Json
  field name doc = case doc of JObj key value rest -> if same name key then value else field name rest; other -> JNull

  needs-type :: TypeExpr -> Bool
  needs-type ty = case ty of
    TName s name -> has name ["Nat", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F32", "F64"]
    TForall s qs body -> True
    TFun s a b -> needs-type a || needs-type b
    TFunEff s a row b -> True
    TUsageArrow s usage arrow -> True
    TBound s name carrier rest -> True
    TInfix s op a b -> True
    TApp s f xs -> predicate-syntax ty || needs-type f || needs-type xs
    TTuple s xs -> needs-type xs
    TArg s x rest -> needs-type x || needs-type rest
    TUsing s bounds body -> True
    TRefined s predicate carrier -> True
    other -> False
  needs-decls :: List Decl -> Bool
  needs-decls ds = case ds of
    Nil -> False
    Cons d rest -> (case d of
      DSig s name ty -> needs-type ty
      DClass s name ps members -> True
      DRecord s name ps fields -> True
      DCodata s name ps observations -> True
      DOpaque s name params kind -> True
      DRefine s name params binder predicate -> True
      DEffect s name params ops -> True
      DInstance s flag name params head-type members -> True
      DExternal s name category None metadata -> (same category "builtin-constructor" || same category "builtin-syntax") || (same category "type" && (case field "kind" metadata of JStr variety -> same variety "refinement"; other -> False))
      DData s name (Cons p ps) ctors -> True
      DData s name Nil ctors -> ctor-needs ctors
      DForeign s direction abi symbol name ty -> True
      DPrim s name ty bodies -> True
      DProof s body -> True
      DRewrite s name syntax -> True
      -- A temporal contract's formulas are compared over the definition's
      -- parameters (core specification section 10), which is typed work:
      -- the module goes through inference so the contract is verified.
      DContract s keyword name subject clauses -> True
      DExternal s name kind (Some ty) metadata -> needs-type ty || (case resolved-text metadata of Some text -> True; other -> False)
      DFun s name clauses -> clauses-need clauses
      other -> False) || needs-decls rest
  clauses-need :: List (List Pat, Expr) -> Bool
  clauses-need cs = case cs of Nil -> False; Cons (ps, body) rest -> expression-needs body || clauses-need rest
  expression-needs :: Expr -> Bool
  expression-needs e = case e of
    ELam s ps body -> True
    EApp s f x -> expression-needs f || expression-needs x
    ECon s name args -> expression-needs args
    ELet s bs body -> expression-needs bs || expression-needs body
    ELetScope sp body -> expression-needs body
    ELocalGroup sp bindings body -> True
    ELetRec sp bindings body -> True
    EWith s bs body -> True
    EDo sp statements -> True
    EHandle s body handled-by -> True
    EHandler s label clauses -> True
    EIf s c a b -> expression-needs c || expression-needs a || expression-needs b
    ECase s value alts -> expression-needs value || expression-needs alts
    EAnn s body ty -> needs-type ty || expression-needs body
    EBin s op a b -> expression-needs a || expression-needs b
    ENeg s x -> expression-needs x
    ETuple s xs -> expression-needs xs
    EArg s x rest -> expression-needs x || expression-needs rest
    EBinding s name rhs rest -> expression-needs rhs || expression-needs rest
    EAlt s p rhs rest -> expression-needs rhs || expression-needs rest
    EGuarded s guard body -> True
    -- A quotation is built at compile time, so the typed elaborator must
    -- see it: the legacy scalar path has no `Code` type to give it.
    EQuote s body -> True
    -- A macro call is gone by the time the elaborator runs: expansion
    -- replaced it with the code the macro produced, and that code is what
    -- decides whether the typed path is needed.
    EMacroCall s path tokens -> False
    other -> False
  ctor-needs :: List (String, TypeExpr) -> Bool
  ctor-needs cs = case cs of Nil -> False; Cons (name, ty) rest -> needs-type ty || ctor-needs rest
  needs-inference :: Program -> Bool
  needs-inference p = module-needs (program-modules p)
  module-needs :: List Module -> Bool
  module-needs ms = case ms of
    Nil -> False
    Cons m rest -> let ds = module-decls m in
      needs-decls ds || unknown-declaration-types ds (data-names ds) || module-needs rest
  unknown-type-names :: List String -> List String -> Bool
  unknown-type-names names known = case names of
    Nil -> False
    Cons name rest -> (not (primitive name) && not (has name known)) || unknown-type-names rest known
  unknown-constructor-types :: List (String, TypeExpr) -> List String -> Bool
  unknown-constructor-types cs known = case cs of
    Nil -> False
    Cons (name, ty) rest -> unknown-type-names (type-names ty) known || unknown-constructor-types rest known
  unknown-declaration-types :: List Decl -> List String -> Bool
  unknown-declaration-types ds known = case ds of
    Nil -> False
    Cons (DSig s name ty) rest -> unknown-type-names (type-names ty) known || unknown-declaration-types rest known
    Cons (DData s name ps cs) rest -> unknown-constructor-types cs (parameter-names-for-check ps <> known) || unknown-declaration-types rest known
    Cons d rest -> unknown-declaration-types rest known
  parameter-names-for-check :: List TypeParam -> List String
  parameter-names-for-check ps = case ps of Nil -> Nil; Cons p rest -> Cons (param-name p) (parameter-names-for-check rest)

  primitive :: String -> Bool
  primitive name = has name ["Int", "Nat", "Bool", "Unit", "()", "String", "Char", "Bytes", "Sym", "Isize", "Usize", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F32", "F64"]
  primitive-type :: String -> UType
  primitive-type name = UCon (if same name "()" then "Unit" else name) KType
  literal-type :: TypeContext -> String -> UType
  literal-type kinds name = if same name "String" then
    (case context-kind (global-data-string-string) kinds of
      Some KType -> UCon (global-data-string-string) KType
      other -> primitive-type name)
    else primitive-type name
  primitive-kinds :: TypeContext
  primitive-kinds = MkTypeContext ([("(->)", arrow-constructor-kind)] <> ownership-type-kinds <> foreign-pointer-kinds <> array-kinds <> Cons ("b.Scope", scope-kind) (Cons ("b.Task", task-kind) (Cons ("b.Io", KFun KRegion KType) (Cons ("b.Dec", KFun KProp KType) (map-primitive ["Int", "Nat", "Bool", "Unit", "()", "String", "Char", "Bytes", "Sym", "Isize", "Usize", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "F32", "F64"])) ))) Nil Nil [ByteObservation "#kernel.bytes-length" None] Nil Nil
  foreign-pointer-kinds :: List (String, Kind)
  foreign-pointer-kinds = [("RawPtr", KFun KType KType), ("Borrowed", KFun KType KType), ("MaybeNull", KFun KType KType)]
  array-kinds :: List (String, Kind)
  array-kinds = if array-type-name "Array" then [("Array", KFun KType KType), ("Tensor", KFun KType KType), ("Columnar", KFun KType KType)] else Nil
  map-primitive :: List String -> List (String, Kind)
  map-primitive names = case names of Nil -> Nil; Cons name rest -> Cons (name, KType) (map-primitive rest)
  lookup-kind :: String -> List (String, Kind) -> Option Kind
  lookup-kind name rows = case rows of Nil -> None; Cons (n, k) rest -> if same name n then Some k else lookup-kind name rest
  lookup-local :: String -> List (String, UType) -> Option UType
  lookup-local name locals = case locals of Nil -> None; Cons (n, ty) rest -> if same name n then Some ty else lookup-local name rest

  -- Term locals are available to dependent index conversion, but they do
  -- not shadow a separately bound type constructor in an annotation.
  -- Keep the full context for index arguments; filter only type-head uses.
  lookup-type-local :: String -> List (String, UType) -> Option UType
  lookup-type-local name locals = case locals of
    Nil -> None
    Cons (actual, value) rest -> if not (same name actual) then lookup-type-local name rest else
      (case value-carrier (type-kind value) of Some carrier -> lookup-type-local name rest; None -> Some value)

  -- A universe annotation denotes a kind. Every other annotation must
  -- elaborate to a proper carrier type in the preceding binder context.
  -- In particular, Nat -> Int is a function-valued index carrier, whereas
  -- Type -> Type classifies a type constructor.
  kind-form :: TypeExpr -> Bool
  kind-form ty = case ty of
    TName s name -> has name ["Type", "Prop", "Region", "Effect", "Row"]
    TFun s a b -> kind-form a && kind-form b
    other -> False
  kind-of :: Bool -> TypeContext -> List (String, UType) -> TypeExpr -> Store -> (Kind, Store)
  kind-of external kinds locals ty st = case ty of
    TName s name -> if same name "Type" then (KType, st)
      else if same name "Prop" then (KProp, st)
      else if same name "Region" then (KRegion, st)
      else if same name "Effect" then (KEffect, st)
      else if same name "Row" then (KRow, st)
      else carrier-kind external kinds locals ty st
    TFun s a b -> if kind-form ty then
      (case kind-of external kinds locals a st of (ka, sa) -> case kind-of external kinds locals b sa of (kb, sb) -> (KFun ka kb, sb))
      else carrier-kind external kinds locals ty st
    other -> carrier-kind external kinds locals ty st
  carrier-kind :: Bool -> TypeContext -> List (String, UType) -> TypeExpr -> Store -> (Kind, Store)
  carrier-kind external kinds locals ty st = case convert external kinds locals ty st of
    (carrier, checked) -> if valid-type carrier && kind-equal (type-kind carrier) KType then (value-kind carrier, checked)
      else (KType, add-error (type-expr-span ty) "quantifier carrier must be a proper type" checked)
  parameters :: Bool -> TypeContext -> List (String, UType) -> List TypeParam -> Nat -> List String -> Store -> (List Quant, Store)
  parameters external kinds locals ps next seen st = case ps of
    Nil -> (Nil, st)
    Cons p rest ->
      let name = param-name p in
      let sd = if has name seen then add-error (param-span p) (string-concat "duplicate quantified parameter: " name) st else st in
      let (k, sk) = case param-kind p of None -> (KType, sd); Some annotation -> kind-of external kinds locals annotation sd in
      let bound = UBound next name k in
      case parameters external kinds (Cons (name, bound) locals) rest (next + 1) (Cons name seen) sk of
        (qs, sr) -> (Cons (MkQuant next name k (param-implicit p)) qs, sr)
  kind-arrow :: List Quant -> Kind
  kind-arrow qs = case qs of Nil -> KType; Cons q rest -> KFun (quant-kind q) (kind-arrow rest)
  opaque-result-kind :: Span -> TypeExpr -> Store -> Store
  opaque-result-kind sp syntax st = case syntax of
    TName at name -> if same name "Type" then st else add-error sp "opaque declaration needs a Type result kind" st
    other -> add-error sp "opaque declaration needs a Type result kind" st
  -- KFun cannot substitute an earlier declaration parameter into a later
  -- carrier. Refuse this path until a binder-aware declaration kind is
  -- available; forall/Pi schemes retain their binders and are unaffected.
  declaration-kind-errors :: Span -> List Quant -> Store -> Store
  declaration-kind-errors sp qs st = case qs of
    Nil -> st
    Cons q rest -> case kind-free-bound (quant-kind q) of
      Nil -> declaration-kind-errors sp rest st
      other -> add-error sp "dependent declaration parameter kinds need binder-aware kind application" st
  quant-locals :: List Quant -> List (String, UType)
  quant-locals qs = case qs of Nil -> Nil; Cons q rest -> Cons (quant-name q, UBound (quant-id q) (quant-name q) (quant-kind q)) (quant-locals rest)

  append-type-arguments :: TypeExpr -> TypeExpr -> TypeExpr
  append-type-arguments first second = case first of
    TArgsEnd sp -> second
    TArg sp value rest -> TArg sp value (append-type-arguments rest second)
    other -> first
  source-type-application :: TypeExpr -> TypeExpr -> (TypeExpr, TypeExpr)
  source-type-application head args = case head of
    TApp sp function earlier -> source-type-application function (append-type-arguments earlier args)
    other -> (head, args)
  convert-type-head :: Bool -> TypeContext -> List (String, UType) -> TypeExpr -> Store -> (UType, Store)
  convert-type-head external kinds locals syntax st = case syntax of
    -- `Code` is the source spelling of the one stage code identity the
    -- expander's module declares (Bootstrap.Nominal owns the encoding), so a
    -- `Code t` a signature names unifies with a quotation's `Code t`.
    TName sp raw | same raw "Code" -> (UCon global-stage-code (KFun KType KType), st)
    TName sp name -> case lookup-type-local name locals of
      Some value -> (value, st)
      None -> case (find-refinement name (context-aliases kinds), context-kind name kinds) of
        (Some definition, Some kind) -> (UCon name kind, st)
        other -> convert external kinds locals syntax st
    other -> convert external kinds locals syntax st
  imported-refinement-parameters :: Span -> Json -> Store -> (List TypeParam, Store)
  imported-refinement-parameters sp rows st = case rows of
    JArr row rest -> case (field "name" row, field "kind" row, field "implicit" row) of
      (JStr name, JStr kind, JBool only) -> case parse-scheme "refinement parameter" (string-to-bytes kind) of
        Parsed annotation Nil -> case imported-refinement-parameters sp rest st of
          (more, checked) -> (Cons (MkTypeParam sp name (Some annotation) only) more, checked)
        other -> (Nil, add-error sp "invalid imported refinement parameter kind" st)
      other -> (Nil, add-error sp "invalid imported refinement parameter metadata" st)
    JArrEnd -> (Nil, st)
    other -> (Nil, add-error sp "missing imported refinement parameters" st)
  imported-refinement-carrier :: List String -> TypeExpr -> (TypeExpr, Bool)
  imported-refinement-carrier params syntax = case syntax of
    TName sp name -> (syntax, has name params || (primitive name && not (same name "String")))
    TApp sp (TName at name) (TArg arg (TName element element-name) (TArgsEnd end)) ->
      if same name "Data.Core.List" && (has element-name params || (primitive element-name && not (same element-name "String"))) then
        (TApp sp (TName at (interface-global name)) (TArg arg (TName element element-name) (TArgsEnd end)), True)
      else (syntax, False)
    other -> (syntax, False)
  imported-refinement-param-names :: List TypeParam -> Json -> Bool
  imported-refinement-param-names params names = case (params, names) of
    (Nil, JArrEnd) -> True
    (Cons parameter rest, JArr (JStr name) more) -> same (param-name parameter) name && imported-refinement-param-names rest more
    other -> False
  imported-refinement :: Span -> String -> Json -> Store -> (Option Decl, Store)
  imported-refinement sp owner metadata st = case (field "identity" metadata, field "binder" (field "refinement" metadata), field "carrier" (field "refinement" metadata), field "predicate" (field "refinement" metadata)) of
    (JStr identity, JStr binder, JStr carrier, JStr predicate) ->
      if not (same owner (interface-global identity)) || string-length identity == 0 || string-length binder == 0 then
        (None, add-error sp "imported refinement has an invalid defining identity or binder" st)
      else case imported-refinement-parameters sp (field "parameters" metadata) st of
        (params, checked) ->
          if not (imported-refinement-param-names params (field "params" metadata)) then
            (None, add-error sp "imported refinement parameter names disagree" checked)
          else case (parse-scheme "refinement carrier" (string-to-bytes carrier), parse-scheme "refinement predicate" (string-to-bytes predicate)) of
            (Parsed base Nil, Parsed condition Nil) -> case imported-refinement-carrier (parameter-names-for-check params) base of
              (carrier-type, True) -> (case qualify-refinement-predicate (Cons binder (parameter-names-for-check params)) condition of
                (decoded, Nil) -> (Some (DRefine sp owner params (MkTypeParam sp binder (Some carrier-type) False) decoded), checked)
                other -> (None, add-error sp "invalid imported refinement predicate operation or scope" checked))
              other -> (None, add-error sp "imported refinement carrier needs defining nominal contracts" checked)
            other -> (None, add-error sp "invalid imported refinement predicate or carrier syntax" checked)
    other -> (None, add-error sp "imported refinement is missing its defining contract" st)
  find-refinement :: String -> List Decl -> Option Decl
  find-refinement name declarations = case declarations of
    Nil -> None
    Cons (DRefine sp actual params binder predicate) rest -> if same name actual then Some (DRefine sp actual params binder predicate) else find-refinement name rest
    Cons other rest -> find-refinement name rest
  refinement-application :: UType -> List UType -> (UType, List UType)
  refinement-application ty args = case ty of UApp head value -> refinement-application head (Cons value args); other -> (ty, args)
  unfold-refinement :: Span -> TypeContext -> UType -> Store -> (UType, Store)
  unfold-refinement sp kinds value st = case refinement-application value Nil of
    (UCon name kind, actuals) -> case find-refinement name (context-aliases kinds) of
      Some (DRefine source name params binder predicate) -> case context-enter-alias name kinds of
        None -> bad sp "recursive refinement alias expansion" st
        Some scoped ->
          let (applied, checked) = case abstract-refinement sp name scoped params binder predicate st of
                (Some former, prepared) -> (Some (apply-refinement-types former actuals), prepared)
                (None, prepared) -> (None, prepared) in
          case applied of
            Some refined | valid-type (refinement-view refined) -> (refined, checked)
            -- A predicate checked over an abstract carrier may fail at the
            -- supplied arguments. Report it through the source checker.
            other -> if list-length actuals < list-length params then bad sp "unsaturated refinement alias needs a checked type former" st
              else case refinement-arguments sp scoped params actuals Nil Nil st of
                (locals, prepared) -> instantiate-refinement sp scoped locals binder predicate prepared
      other -> (value, st)
    other -> (value, st)
  apply-refinement-types :: UType -> List UType -> UType
  apply-refinement-types former actuals = case actuals of
    Nil -> former
    Cons first rest -> apply-refinement-types (UApp former first) rest
  -- A former must check with its declared type parameters abstract.
  -- Dependent or representation-sensitive templates are instantiated at
  -- their concrete arguments by the ordinary refinement checker.
  abstract-refinement :: Span -> String -> TypeContext -> List TypeParam -> TypeParam -> TypeExpr -> Store -> (Option UType, Store)
  abstract-refinement sp name kinds params binder predicate st = case params of
    Nil -> (None, st)
    Cons first rest -> case fresh-id st of
      (start, allocated) -> case parameters False kinds Nil params start Nil allocated of
        (qs, prepared) -> case abstract-refinement-ids qs of
          Some ids -> case instantiate-refinement sp kinds (quant-locals qs) binder predicate prepared of
            (body, checked) -> let former = URefineFormer name ids body in
              if list-length (store-errors checked) == list-length (store-errors st) && valid-type former then (Some former, checked)
              else (None, st)
          None -> (None, st)
  abstract-refinement-ids :: List Quant -> Option (List Nat)
  abstract-refinement-ids qs = case qs of
    Nil -> Some Nil
    Cons q rest -> if kind-equal (quant-kind q) KType then
      (case abstract-refinement-ids rest of Some ids -> Some (Cons (quant-id q) ids); None -> None)
      else None
  refinement-arguments :: Span -> TypeContext -> List TypeParam -> List UType -> List (String, UType) -> List String -> Store -> (List (String, UType), Store)
  refinement-arguments sp kinds params actuals locals seen st = case (params, actuals) of
    (Nil, Nil) -> (locals, st)
    (Cons parameter rest, Cons value more) ->
      let name = param-name parameter in
      let distinct = if has name seen then add-error sp "duplicate refinement parameter" st else st in
      let (kind, sk) = case param-kind parameter of None -> (KType, distinct); Some annotation -> kind-of False kinds locals annotation distinct in
      refinement-arguments sp kinds rest more (Cons (name, value) locals) (Cons name seen) (unify-kind sp kind (type-kind value) sk)
    other -> (locals, add-error sp "refinement alias arity mismatch" st)
  instantiate-refinement :: Span -> TypeContext -> List (String, UType) -> TypeParam -> TypeExpr -> Store -> (UType, Store)
  instantiate-refinement sp kinds locals binder predicate st = case param-kind binder of
    None -> bad sp "a named refinement needs its declared carrier" st
    Some syntax -> if has (param-name binder) (local-value-names locals) then bad sp "duplicate refinement binder" st
      else case convert False kinds locals syntax st of
        (carrier, checked) -> case fresh-for-types (Cons carrier (local-types locals)) (expect-type sp carrier checked) of
          (id, prepared) -> finish-refinement False kinds (Cons (param-name binder, UBound id (param-name binder) (value-kind carrier)) locals)
            sp id (param-name binder) carrier predicate prepared
  local-value-names :: List (String, UType) -> List String
  local-value-names locals = case locals of Nil -> Nil; Cons (name, value) rest -> Cons name (local-value-names rest)
  refinement-mentions :: String -> TypeExpr -> Bool
  refinement-mentions name syntax = case syntax of
    TName sp actual -> same name actual
    TInfix sp op left right -> refinement-mentions name left || refinement-mentions name right
    TNegate sp body -> refinement-mentions name body
    TApp sp head args -> refinement-mentions name head || refinement-mentions name args
    TArg sp first rest -> refinement-mentions name first || refinement-mentions name rest
    other -> False
  refinement-predicate-scope :: TypeContext -> List String -> TypeExpr -> Bool
  refinement-predicate-scope kinds names syntax = case syntax of
    TName sp name -> has name names || has name ["True", "False"]
    TIndex sp text -> True
    TNegate sp body -> refinement-predicate-scope kinds names body
    TInfix sp op first second -> has op ["+", "-", "*", "<", "<=", ">", ">=", "==", "/=", "&&", "||"] && refinement-predicate-scope kinds names first && refinement-predicate-scope kinds names second
    -- The prefix `Eq a b` former is the comparison the elaborator reads as
    -- index equality, so both of its operands are in predicate scope.
    TApp sp (TName at name) (TArg s1 x (TArg s2 y (TArgsEnd end))) -> same name "Eq" && refinement-predicate-scope kinds names x && refinement-predicate-scope kinds names y
    TApp sp (TName at name) (TArg arg input (TArgsEnd end)) -> (has name ["NonZero", "NotNull", "Ascii", "Ordered"] || byte-length-binding name kinds || (case context-identity-observation name kinds of Some sc -> True; None -> False)) && refinement-predicate-scope kinds names input
    other -> False
  validate-refinement :: TypeContext -> Decl -> Store -> Store
  validate-refinement kinds declaration st = case declaration of
    DRefine sp name params binder predicate -> case parameters False kinds Nil params 0 Nil st of
      (qs, prepared) -> let locals = quant-locals qs in
        if has (param-name binder) (local-value-names locals) then add-error sp "duplicate refinement binder" prepared
        else if not (refinement-mentions (param-name binder) predicate) then add-error sp "a named refinement predicate must mention its binder" prepared
        else if not (refinement-predicate-scope kinds (Cons (param-name binder) (local-value-names locals)) predicate) then add-error sp "named refinement predicate needs checked scope and semantics" prepared
        else case param-kind binder of
          None -> add-error sp "a named refinement needs its declared carrier" prepared
          Some syntax -> case convert False kinds locals syntax prepared of
            (carrier, checked) -> let proper = expect-type sp carrier checked in
              case carrier of
                UBound id name KType -> proper
                other -> case instantiate-refinement sp kinds locals binder predicate proper of (value, final) -> final
    other -> st
  validate-refinements :: TypeContext -> List Decl -> Store -> Store
  validate-refinements kinds declarations st = case declarations of
    Nil -> st
    Cons declaration rest -> validate-refinements kinds rest (validate-refinement kinds declaration st)
  convert :: Bool -> TypeContext -> List (String, UType) -> TypeExpr -> Store -> (UType, Store)
  convert external kinds locals ty st = case ty of
    TName s raw | same raw "Code" -> (UCon global-stage-code (KFun KType KType), st)
    TName s name -> case lookup-type-local name locals of
      Some found -> (found, st)
      None -> if same name "(->)" then (UCon name arrow-constructor-kind, st)
        else if same name "Io" || same name "b.Io" then (UCon "b.Io" (KFun KRegion KType), st)
        else if same name "Dec" || same name "b.Dec" then (case context-kind name kinds of Some kind -> (UCon name kind, st); None -> (UCon "b.Dec" (KFun KProp KType), st))
        else if has name ["Ref", "Mut", "Thunk", "Lazy", "Later"] then
          (case context-kind name primitive-kinds of Some kind -> (UCon name kind, st); None -> bad s "unknown kernel ownership type" st)
        else if external && same name "String" then bad s (string-concat "imported nominal scheme needs defining-module type identities: " name) st
        else if primitive name then (literal-type kinds name, st)
        else if external then bad s (string-concat "imported nominal scheme needs defining-module type identities: " name) st
        else case context-kind name kinds of Some k -> unfold-refinement s kinds (UCon name k) st; None -> bad s (string-concat "unknown type constructor or unbound type variable: " name) st
    TFun s a b -> convert-arrow external kinds locals s a None b st
    TApp s (TName at name) (TArg first a (TArg second b (TArgsEnd end))) | same name "Eq" ->
      convert-predicate external kinds locals ty st
    TApp s head args -> case source-type-application head args of
      (function, actuals) -> case convert-type-head external kinds locals function st of
        (h, sh) -> if later-arguments-valid h actuals then convert-args external kinds locals s h actuals sh
          else bad s "Later must be applied to exactly one type and takes no effect row" sh
    TTuple s args -> case convert-spine external kinds locals args st of (xs, sx) -> (UTuple xs, sx)
    TForall s qs body -> bad s "higher-rank forall needs explicit elaboration" st
    TUsing s bounds body -> bad s "using contexts need dictionary and proof elaboration" st
    TFunEff s a row b -> convert-arrow external kinds locals s a (Some row) b st
    TUsageArrow s usage arrow -> check-usage-arrow s usage (convert external kinds locals arrow st)
    TRow s labels tail -> convert-row kinds locals ty st
    TRefined s predicate carrier -> convert-refined external kinds locals s predicate carrier st
    TIndex s literal -> bad s "kind mismatch: a numeric index cannot be used as a proper type" st
    TBound s name kind rest -> bad s "dependent argument binders need index elaboration" st
    other -> bad (type-expr-span ty) "dependent or unmodeled type needs kernel elaboration" st
  later-arguments-valid :: UType -> TypeExpr -> Bool
  later-arguments-valid head arguments = case head of
    UCon name kind -> if same name "Later" && kind-equal kind later-kind then
      (case arguments of TArg sp (TRow at labels tail) rest -> False; TArg sp argument (TArgsEnd end) -> True; other -> False)
      else True
    other -> True
  unqualified-name :: String -> Bool
  unqualified-name name = no-qualifier (unpack name)
  no-qualifier :: List Char -> Bool
  no-qualifier chars = case chars of Nil -> True; Cons char rest -> not (char-code char == 46) && no-qualifier rest
  refinement-free-names :: TypeContext -> List (String, UType) -> TypeExpr -> List String
  refinement-free-names kinds locals syntax = case syntax of
    TName s name -> if has name ["True", "False"] || primitive name || not (unqualified-name name) then Nil else
      (case lookup-local name locals of Some value -> Nil; None -> case context-kind name kinds of Some kind -> Nil; None -> [name])
    TInfix s op first second -> unique-names (refinement-free-names kinds locals first <> refinement-free-names kinds locals second) Nil
    TNegate s input -> refinement-free-names kinds locals input
    -- A function head is never invented as the result binder. The typed
    -- call reifier must separately admit a predicate's applications.
    TApp s head arguments -> refinement-free-names kinds locals arguments
    TArg s first rest -> unique-names (refinement-free-names kinds locals first <> refinement-free-names kinds locals rest) Nil
    other -> Nil
  unique-names :: List String -> List String -> List String
  unique-names names seen = case names of Nil -> Nil; Cons name rest -> if has name seen then unique-names rest seen else Cons name (unique-names rest (Cons name seen))
  convert-refined :: Bool -> TypeContext -> List (String, UType) -> Span -> TypeExpr -> TypeExpr -> Store -> (UType, Store)
  convert-refined external kinds locals sp predicate syntax st =
    -- A bare closed predicate applies to this refinement's own fresh value,
    -- never to a same-spelled source binding or surrounding argument.
    let applied = case predicate of
          TName at name -> if same name "NonZero" then TApp at predicate (TArg at (TName at "#result") (TArgsEnd at)) else predicate
          other -> predicate in
    convert-refined-predicate external kinds locals sp applied syntax st
  convert-refined-predicate :: Bool -> TypeContext -> List (String, UType) -> Span -> TypeExpr -> TypeExpr -> Store -> (UType, Store)
  convert-refined-predicate external kinds locals sp predicate syntax st = case convert external kinds locals syntax st of
    (carrier, checked) -> case fresh-for-types (Cons carrier (local-types locals)) (expect-type sp carrier checked) of
      (id, prepared) -> case refinement-free-names kinds locals predicate of
        Nil -> finish-refinement external kinds locals sp id "#result" carrier predicate prepared
        Cons name Nil -> finish-refinement external kinds (Cons (name, UBound id name (value-kind carrier)) locals) sp id name carrier predicate prepared
        other -> bad sp "refinement predicate has more than one unbound value name" prepared
  finish-refinement :: Bool -> TypeContext -> List (String, UType) -> Span -> Nat -> String -> UType -> TypeExpr -> Store -> (UType, Store)
  finish-refinement external kinds locals sp id name carrier predicate st = case convert-predicate external kinds locals predicate st of
    (condition, checked) -> let out = URefine id name carrier condition in
      if valid-type out then (out, checked) else bad sp "ill-formed source refinement" checked

  -- Mathematical literal decoding never narrows through a machine word.
  number-digit :: Char -> Option Int
  number-digit char = let code = nat-to-int (char-code char) in
    if code >= 48 && code <= 57 then Some (code - 48)
    else if code >= 65 && code <= 70 then Some (code - 55)
    else if code >= 97 && code <= 102 then Some (code - 87) else None
  number-digits :: Int -> List Char -> Int -> Bool -> Bool -> Option Int
  number-digits radix chars value seen separator = case chars of
    Nil -> if seen && not separator then Some value else None
    Cons char rest -> if char-code char == 95 then
      (if seen && not separator then number-digits radix rest value seen True else None)
      else case number-digit char of
        Some digit -> if digit < radix then number-digits radix rest (value * radix + digit) True False else None
        None -> None
  number-base :: List Char -> Option Int
  number-base chars = case chars of
    Cons zero (Cons marker rest) -> if char-code zero == 48 then
      (if char-code marker == 120 || char-code marker == 88 then number-digits 16 rest 0 False False
       else if char-code marker == 98 || char-code marker == 66 then number-digits 2 rest 0 False False
       else if char-code marker == 111 || char-code marker == 79 then number-digits 8 rest 0 False False
       else number-digits 10 chars 0 False False)
      else number-digits 10 chars 0 False False
    other -> number-digits 10 chars 0 False False
  index-number :: String -> Option Int
  index-number text = case unpack text of
    Cons sign rest -> if char-code sign == 45 then (case number-base rest of Some n -> Some (0 - n); None -> None) else number-base (unpack text)
    Nil -> None
  checked-literal :: Span -> UType -> String -> Store -> (CoreTerm, Store)
  checked-literal sp carrier text st = case index-number text of
    Some value ->
      let signed-zero = value == 0 && (case unpack text of Cons first rest -> char-code first == 45; Nil -> False) in
      let digits = if signed-zero then "-0" else int-to-string value in
      (case normalize st carrier of
        UMeta id KType -> (CInt sp carrier digits, pending-number sp carrier value st)
        known -> if number-literal-valid known value then (CInt sp carrier digits, st)
          else term-error sp (number-literal-error known value "literal is outside its integer carrier") st)
    None -> term-error sp "invalid or machine-suffixed mathematical literal" st
  math-carrier :: UType -> Bool
  math-carrier carrier = case carrier of UCon name KType -> same name "Nat" || same name "Int"; other -> False
  index-math :: String -> IndexTerm -> IndexTerm -> IndexTerm
  index-math op a b = if same op "+" then IAdd a b else if same op "*" then IMultiply a b else ISubtract a b
  checked-source-index :: Span -> UType -> IndexTerm -> Store -> (UType, Store)
  checked-source-index sp carrier value st = let out = UIndex carrier value in
    if not (valid-type out && index-runtime-admissible carrier value) then bad sp "ill-sorted, partial or unchecked source index" st
    else (out, unify sp out out st)
  checked-typed-source-index :: Span -> UType -> Store -> (UType, Store)
  checked-typed-source-index sp value st = let out = normalize st value in
    if typed-index-admissible out then (out, unify sp out out st)
    else bad sp "ill-sorted, partial or unchecked typed source index" st
  context-add-byte-observation :: String -> Option String -> TypeContext -> TypeContext
  context-add-byte-observation name scheme context = case context of
    MkTypeContext kinds aliases active observers effects source-classes -> MkTypeContext kinds aliases active (Cons (ByteObservation name scheme) observers) effects source-classes
  byte-observation :: String -> List ByteObservation -> Option ByteObservation
  byte-observation name observers = case observers of
    Nil -> None
    Cons (ByteObservation binding scheme) rest -> if same name binding then Some (ByteObservation binding scheme) else byte-observation name rest
    Cons other rest -> byte-observation name rest
  context-byte-observation :: String -> TypeContext -> Option ByteObservation
  context-byte-observation name context = case context of MkTypeContext kinds aliases active observers effects source-classes -> byte-observation name observers
  byte-length-binding :: String -> TypeContext -> Bool
  byte-length-binding name context = case context-byte-observation name context of Some observer -> True; None -> False
  imported-observation-scheme :: String -> Json -> TypeContext -> Bool
  imported-observation-scheme name metadata context = case (context-byte-observation name context, field "scheme" metadata) of
    (Some (ByteObservation binding (Some declared)), JStr actual) -> same declared actual
    other -> False
  identity-observation :: String -> List ByteObservation -> Option Scheme
  identity-observation name observers = case observers of
    Nil -> None
    Cons (IdentityObservation symbol sc) rest -> if same name symbol then Some sc else identity-observation name rest
    Cons other rest -> identity-observation name rest
  context-identity-observation :: String -> TypeContext -> Option Scheme
  context-identity-observation name context = case context of MkTypeContext kinds aliases active observers effects source-classes -> identity-observation name observers
  context-add-identity :: String -> Scheme -> TypeContext -> TypeContext
  context-add-identity name sc context = case context of MkTypeContext kinds aliases active observers effects source-classes -> MkTypeContext kinds aliases active (Cons (IdentityObservation name sc) observers) effects source-classes
  identity-type-shape :: TypeExpr -> Bool
  identity-type-shape syntax = case syntax of
    TForall sp binders body -> identity-type-shape body
    TFun sp (TName first domain) (TName second result) -> same domain result
    other -> False
  identity-body :: String -> List Decl -> Bool
  identity-body name declarations = case function-clauses name declarations of
    Cons (Cons (PVar sp parameter) Nil, EVar at value) Nil -> same parameter value
    other -> False
  identity-type-parameters :: List Quant -> Bool
  identity-type-parameters params = case params of Nil -> True; Cons q rest -> kind-equal (quant-kind q) KType && identity-type-parameters rest
  identity-scheme :: Scheme -> Bool
  identity-scheme sc = identity-type-parameters (scheme-params sc) && (case (scheme-requirements sc, scheme-body sc) of
    (Nil, UFun domain result) -> same-type domain result
    other -> False)
  -- Only a complete single-clause identity definition, with its checked pure
  -- type, supplies this beta reduction. A similarly named or merely typed
  -- function, a foreign binding, or another clause supplies no authority.
  collect-source-identities :: List Decl -> List Decl -> List (String, Kind) -> TypeContext -> Store -> (TypeContext, Store)
  collect-source-identities all declarations classes kinds st = case declarations of
    Nil -> (kinds, st)
    Cons (DSig sp name syntax) rest -> if identity-type-shape syntax && identity-body name all then
      (case make-scheme False classes kinds Nil syntax st of
        (sc, checked) -> collect-source-identities all rest classes (if identity-scheme sc then context-add-identity name sc kinds else kinds) checked)
      else collect-source-identities all rest classes kinds st
    Cons other rest -> collect-source-identities all rest classes kinds st
  known-observation-input-type :: List (String, UType) -> TypeExpr -> Option UType
  known-observation-input-type locals syntax = case syntax of
    TName sp name -> (case lookup-local name locals of Some value -> value-carrier (type-kind value); None -> None)
    TApp sp function (TArg at argument (TArgsEnd end)) -> (case (known-observation-input-type locals function, known-observation-input-type locals argument) of
      (Some (UFun domain result), Some input) -> if same-type (predicate-base-carrier domain) (predicate-base-carrier input) then Some result else None
      (Some (UPi id name domain row result), Some input) -> if same-type (predicate-base-carrier domain) (predicate-base-carrier input) then Some (predicate-base-carrier result) else None
      other -> None)
    other -> None
  convert-byte-operand :: Bool -> TypeContext -> List (String, UType) -> Span -> TypeExpr -> Store -> (UType, Store)
  convert-byte-operand external kinds locals sp argument st = case argument of
    TName at binding -> case lookup-local binding locals of
      Some value -> predicate-index-value sp (primitive-type "Bytes") value st
      None -> bad sp "byte observation input has no checked local identity" st
    TApp at (TName called name) arguments -> (case (lookup-local name locals, context-identity-observation name kinds, arguments) of
      (None, Some sc, TArg arg input (TArgsEnd end)) -> (case open-scheme False sc st of
        (function, pairs, opened) -> case function of
          UFun domain result -> case convert-byte-operand external kinds locals sp input opened of
            (value, checked) -> (value, unify sp result (primitive-type "Bytes") (unify sp domain (primitive-type "Bytes") checked))
          other -> bad sp "byte observation helper needs its checked pure identity type" opened)
      (None, identity, args) -> (case context-total-observation name kinds of
        Some binding -> (case convert-total-call external kinds locals called name args st of
          (value, checked) -> predicate-index-value sp (primitive-type "Bytes") value checked)
        None -> reject-byte-application locals sp argument st)
      other -> reject-byte-application locals sp argument st)
    other -> bad sp "byte observation input needs checked pure total reification" st
  reject-byte-application :: List (String, UType) -> Span -> TypeExpr -> Store -> (UType, Store)
  reject-byte-application locals sp argument st = case known-observation-input-type locals argument of
    Some carrier -> let checked = unify sp (predicate-base-carrier carrier) (primitive-type "Bytes") st in
      if list-length (store-errors checked) > list-length (store-errors st) then (UError, checked)
      else bad sp "byte observation input needs checked pure total reification" checked
    None -> bad sp "byte observation input needs checked pure total reification" st
  convert-byte-length :: Bool -> TypeContext -> List (String, UType) -> Span -> String -> TypeExpr -> Store -> (UType, Store)
  convert-byte-length external kinds locals sp name argument st =
    if not (byte-length-binding name kinds) then bad sp "index expression needs checked scope, purity and totality" st
    else case convert-byte-operand external kinds locals sp argument st of
      (input, checked) -> checked-typed-source-index sp (UIndexByteLength input) checked
  convert-total-arguments :: Bool -> TypeContext -> List (String, UType) -> List String -> TypeExpr -> Store -> (UType, Store)
  convert-total-arguments external kinds locals parameters arguments st = case (parameters, arguments) of
    (Nil, TArgsEnd sp) -> (UEnd, st)
    (Cons sort rest, TArg sp first more) -> (case convert-index external kinds locals (primitive-type sort) first st of
      (value, checked) -> (case convert-total-arguments external kinds locals rest more checked of
        (values, done) -> (UArg value values, done)))
    other -> bad (type-expr-span arguments) "defining total call arity mismatch" st
  convert-total-call :: Bool -> TypeContext -> List (String, UType) -> Span -> String -> TypeExpr -> Store -> (UType, Store)
  convert-total-call external kinds locals sp name arguments st = case context-total-observation name kinds of
    Some binding -> (case convert-total-arguments external kinds locals (total-parameters (binding-function binding)) arguments st of
      (values, checked) -> checked-typed-source-index sp (UIndexCall (binding-function binding) values) checked)
    None -> bad sp "index application has no actual defining total body declaration" st
  convert-index :: Bool -> TypeContext -> List (String, UType) -> UType -> TypeExpr -> Store -> (UType, Store)
  convert-index external kinds locals carrier syntax st = case syntax of
    TApp sp (TName at name) arguments -> (case (byte-length-binding name kinds, arguments) of
      (True, TArg arg input (TArgsEnd end)) -> (case convert-byte-length external kinds locals sp name input st of
        (value, checked) -> (value, unify-kind sp (type-kind value) (value-kind carrier) checked))
      other -> (case convert-total-call external kinds locals sp name arguments st of
        (value, checked) -> (value, unify-kind sp (type-kind value) (value-kind carrier) checked)))
    TIndex sp text -> case index-number text of
      Some n -> checked-source-index sp carrier (IInteger n) st
      None -> bad sp "index literal is not a mathematical integer" st
    TName sp name -> case lookup-local name locals of
      Some value -> let checked = unify-kind sp (type-kind value) (value-kind carrier) st in
        checked-typed-source-index sp value checked
      None -> bad sp "source index has no checked local binding" st
    TNegate sp input -> case convert-index external kinds locals carrier input st of
      (value, checked) -> case index-of-type value of
        Some term -> checked-source-index sp carrier (ISubtract (IInteger 0) term) checked
        None -> bad sp "invalid negated index" checked
    TInfix sp op first second -> if has op ["+", "-", "*"] && math-carrier (normalize st carrier) then
      (case convert-index external kinds locals carrier first st of
        (a, sa) -> case convert-index external kinds locals carrier second sa of
          (b, sb) -> checked-typed-source-index sp (UIndexMath op a b) sb)
      else bad sp "index operator needs checked mathematical semantics" st
    other -> bad (type-expr-span syntax) "index expression needs checked scope, purity and totality" st

  -- Only real local bindings enter this context. A polymorphic local needs
  -- explicit instantiation before it can appear in a source type annotation.
  value-locals :: List CheckedBinding -> List (String, UType) -> List (String, UType)
  value-locals env locals = case env of
    Nil -> locals
    Cons (MkValueBinding name sc id level value) rest -> Cons (name, value) (value-locals rest locals)
    Cons (MkLocalBinding name sc id level) rest -> case (scheme-params sc, scheme-requirements sc) of
      (Nil, Nil) -> Cons (name, UIndex (scheme-body sc) (IRigid id name level)) (value-locals rest locals)
      other -> value-locals rest locals
    Cons binding rest -> value-locals rest locals
  find-local-id :: Nat -> List CheckedBinding -> Option CheckedBinding
  find-local-id id env = case env of
    Nil -> None
    Cons (MkLocalBinding name sc key level) rest -> if id == key then Some (MkLocalBinding name sc key level) else find-local-id id rest
    Cons (MkValueBinding name sc key level value) rest -> if id == key then Some (MkValueBinding name sc key level value) else find-local-id id rest
    Cons other rest -> find-local-id id rest
  local-actuals :: Span -> List Quant -> List UType -> List (Nat, UType) -> Store -> (List (Nat, UType), Store)
  local-actuals sp params actuals earlier st = case (params, actuals) of
    (Nil, Nil) -> (earlier, st)
    (Cons q rest, Cons actual more) -> if valid-type actual then
      (let expected = map-kind-types (substitute-bound earlier) (quant-kind q) in
       local-actuals sp rest more (Cons (quant-id q, actual) earlier) (unify-kind sp expected (type-kind actual) st))
      else (earlier, add-error sp "invalid local index instantiation" st)
    other -> (earlier, add-error sp "local index instantiation arity mismatch" st)
  reify-argument :: Span -> List CheckedBinding -> CoreTerm -> Store -> (UType, Store)
  reify-argument sp env term st = case store-errors st of
    Cons error rest -> (UError, st)
    Nil -> reify-checked-argument sp env term st
  reify-checked-argument :: Span -> List CheckedBinding -> CoreTerm -> Store -> (UType, Store)
  reify-checked-argument sp env term st =
    let gamma = proof-context env st in
    let facts = proof-facts env in
    let checked = map-term-types (normalize st) term in
    case scoped-total-call-index gamma facts checked of
      Some value -> checked-typed-source-index sp value st
      None -> case scoped-list-index gamma facts checked of
        Some value -> checked-typed-source-index sp value st
        None -> case scoped-borrow-read-index gamma checked of
          Some value -> checked-typed-source-index sp value st
          None -> reify-ordinary-argument sp env term st
  reify-ordinary-argument :: Span -> List CheckedBinding -> CoreTerm -> Store -> (UType, Store)
  reify-ordinary-argument sp env term st = case term of
    CApply source ty (CUse at function symbol role Nil) input ->
      if same symbol "cinch.runtime.bytesLen" && same role "intrinsic" && (case normalize st function of UFun domain result -> same-type domain (primitive-type "Bytes") && same-type result (normalize st ty) && same-type (predicate-base-carrier result) (primitive-type "Nat"); other -> False) then
        (case reify-argument sp env input st of
          (value, checked) -> checked-typed-source-index sp (UIndexByteLength value) checked)
      else bad sp "argument call needs checked pure total reification or a checked observation contract" st
    CForget source carrier body -> case refinement-view (normalize st (core-type body)) of
      URefine id name domain predicate -> if not (comparison-refinement (normalize st (core-type body))) then bad sp "refinement projection needs checked mathematical semantics" st
        else case body of
          CRefine at ty evidence actual -> reify-argument sp env actual (unify sp carrier domain st)
          CApply at result (CUse source function symbol role Nil) input ->
            if same symbol "cinch.runtime.bytesLen" && same role "intrinsic" then reify-argument sp env body (unify sp carrier domain st)
            else (case reify-argument sp env body st of
              (value, checked) -> checked-typed-source-index sp (UIndexForget value) (unify sp carrier domain checked))
          other -> case reify-argument sp env body st of
            (value, checked) -> checked-typed-source-index sp (UIndexForget value) (unify sp carrier domain checked)
      other -> bad sp "refinement projection needs an actual refined operand" st
    CDischarge source ty evidence body -> (case scoped-guarded-call-index (proof-context env st) (proof-facts env) (map-term-types (normalize st) term) of
      Some index -> checked-typed-source-index sp index st
      None -> bad sp "conditional argument needs checked defining body authority" st)
    CProved source ty evidence (CPrimitive at output operation (CArgument a first (CArgument b second (CArgumentsEnd end)))) ->
      if same operation "-" && same-type (normalize st ty) (primitive-type "Nat") && same-type ty output then
        (case scoped-prove-subtraction (proof-context env st) (proof-facts env) (map-term-types (normalize st) first) (map-term-types (normalize st) second) of
          Some checked -> case reify-argument sp env first st of
            (left, sl) -> case reify-argument sp env second sl of
              (right, sr) -> checked-typed-source-index sp (UIndexMath "-" left right) sr
          None -> bad sp "index subtraction needs actual scoped ordering evidence" st)
      else bad sp "certified index operation has no checked total semantics" st
    CLocal source ty id display actuals -> case find-local-id id env of
      Some (MkLocalBinding name sc key level) -> reify-local-index sp sc level actuals ty (IRigid id display level) st
      Some (MkValueBinding name sc key level value) -> if level > store-level st then bad sp "local index escapes its binding scope" st
        else case local-actuals sp (scheme-params sc) actuals Nil st of
          (pairs, prepared) -> checked-typed-source-index sp value
            (unify sp (substitute-bound pairs (scheme-body sc)) ty (unify-kind sp (type-kind value) (value-kind ty) prepared))
      other -> bad sp "index reference is not a checked local identity" st
    CInt source ty text -> case index-number text of
      Some value -> checked-source-index sp (normalize st ty) (IInteger value) st
      None -> bad sp "invalid integer argument literal" st
    CPrimitive source ty op (CArgument a first (CArgument b second (CArgumentsEnd end))) ->
      if has op ["+", "-", "*"] && math-carrier (normalize st ty) then
        (case reify-argument sp env first st of
          (left, sl) -> case reify-argument sp env second sl of
            (right, sr) -> let sorted = unify-kind sp (type-kind right) (value-kind ty) (unify-kind sp (type-kind left) (value-kind ty) sr) in
              checked-typed-source-index sp (UIndexMath op left right) sorted)
      else bad sp "index arithmetic needs mathematical primitive semantics" st
    CPrimitive source ty op (CArgument a input (CArgumentsEnd end)) -> if same op "negate" && kind-equal (type-kind ty) KType then
      (case reify-argument sp env input st of
        (value, checked) -> checked-typed-source-index sp (UIndexMath "-" (UIndex (normalize checked ty) (IInteger 0)) value) checked)
      else bad sp "unchecked unary operation in index" st
    CApply source ty (CApply partial function method first) second ->
      case scoped-numeric-method-operation (proof-context env st) (map-term-types (normalize st) method) (map-term-types (normalize st) first) (map-term-types (normalize st) second) of
        Some op -> case reify-argument sp env first st of
          (left, sl) -> case reify-argument sp env second sl of
            (right, sr) -> checked-typed-source-index sp (UIndexMath op left right) sr
        None -> bad sp "argument method needs checked mathematical semantics" st
    other -> bad sp "argument index needs checked pure total reification" st

  reify-projected-argument :: Span -> List CheckedBinding -> CoreTerm -> Store -> (UType, Store)
  reify-projected-argument sp env term st = case term of
    CRefine source ty evidence body -> reify-argument sp env body st
    CRefineProof source ty witness body -> reify-argument sp env body st
    other -> reify-argument sp env term st

  reify-local-index :: Span -> Scheme -> Nat -> List UType -> UType -> IndexTerm -> Store -> (UType, Store)
  reify-local-index sp sc level actuals ty index st =
    if level > store-level st then bad sp "local index escapes its binding scope" st
    else case scheme-requirements sc of
      Nil -> case local-actuals sp (scheme-params sc) actuals Nil st of
        (pairs, prepared) -> let checked = unify sp (substitute-bound pairs (scheme-body sc)) ty prepared in
          checked-source-index sp (normalize checked ty) index checked
      other -> bad sp "local index requires unresolved dictionary evidence" st

  let-binding :: Span -> List CheckedBinding -> String -> Scheme -> Nat -> Nat -> CoreTerm -> Store -> (CheckedBinding, Store)
  let-binding sp env name sc id level value before =
    let st = check-borrow-binding sp env (scheme-body sc) before in
    if volatile-borrow-index (normalize st (scheme-body sc)) then
      (MkLocalBinding name sc id level, add-error sp "mutable borrow evidence cannot escape into a stored value" st)
    else if not (stable-index-source value) then (MkLocalBinding name sc id level, st)
    else (case (scheme-params sc, scheme-requirements sc) of
      (Nil, Nil) -> case reify-argument sp env value st of
        (index, checked) -> case (store-errors checked, index-of-type index) of
          -- Reification can expose the mathematical carrier of a refined
          -- result (for example a byte length). It is not a definition at the
          -- refined carrier. Keep the actual local and its checked RHS fact,
          -- just as Core's scope-definitions does for a mismatched index kind.
          (Nil, witness) -> if not (volatile-borrow-index (normalize checked index)) && typed-index-admissible index && kind-equal (type-kind (normalize checked index)) (value-kind (normalize checked (scheme-body sc))) then
            (MkValueBinding name sc id level index, checked)
            else (MkLocalBinding name sc id level, st)
          other -> (MkLocalBinding name sc id level, st)
      other -> (MkLocalBinding name sc id level, st))

  check-borrow-binding :: Span -> List CheckedBinding -> UType -> Store -> Store
  check-borrow-binding sp env ty st = case borrow-regions (normalize st ty) of
    Nil -> st
    loans -> if active-borrow-conflict loans env st then add-error sp "region conflict: exclusive borrows are unique" st else st
  active-borrow-conflict :: List (Bool, UType) -> List CheckedBinding -> Store -> Bool
  active-borrow-conflict loans env st = case env of
    Nil -> False
    Cons binding rest -> let ty = (case binding of
      MkLocalBinding name sc id level -> scheme-body sc
      MkValueBinding name sc id level value -> scheme-body sc
      other -> UError) in
      borrow-region-conflict loans (borrow-regions (normalize st ty)) || active-borrow-conflict loans rest st

  bind-arrow-pattern :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Pat -> UType -> Store -> (List CheckedBinding, CorePattern, UType, UType, Store)
  bind-arrow-pattern classes kinds families env locals pat expected st = case arrow-shape (normalize st expected) of
    UProofFun predicate effects result -> case bind-proof-pattern kinds env locals pat predicate st of
      (bound, pattern, checked) -> (bound, pattern, effects, result, checked)
    UPi id name domain effects result -> case bind-arrow-value-pattern classes kinds families env locals pat expected domain st of
      (bound, pattern, checked) -> if pi-dependent (normalize checked expected) then
        (case pattern-value pattern of
          Some actual -> case reify-argument (pat-span pat) bound actual checked of
            (index, sr) -> case open-pi (pat-span pat) expected index sr of
              (out, row, done) -> (bound, pattern, row, out, done)
          None -> (bound, pattern, UError, UError, add-error (pat-span pat) "dependent pattern needs a checked argument value" checked))
        else (bound, pattern, effects, result, checked)
    other -> case arrow-parts (pat-span pat) expected st of
      (domain, row, result, checked) -> case bind-arrow-value-pattern classes kinds families env locals pat expected domain checked of
        (bound, pattern, done) -> (bound, pattern, row, result, done)

  bind-arrow-value-pattern :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Pat -> UType -> UType -> Store -> (List CheckedBinding, CorePattern, Store)
  bind-arrow-value-pattern classes kinds families env locals pat function domain st =
    if erased-value-arrow (normalize st function) then bind-erased-value-pattern kinds env locals pat domain st
    else bind-pattern classes kinds families env locals pat domain st
  bind-erased-value-pattern :: TypeContext -> List CheckedBinding -> List (String, UType) -> Pat -> UType -> Store -> (List CheckedBinding, CorePattern, Store)
  bind-erased-value-pattern kinds env locals pat domain st = case pat of
    PVar sp name -> erased-value-binding env sp name domain st
    PWild sp -> erased-value-binding env sp "#erased-argument" domain st
    PAnn sp inner annotation -> case convert False kinds (value-locals env locals) annotation st of
      (ty, checked) -> bind-erased-value-pattern kinds env locals inner domain (unify sp domain ty (expect-type sp ty checked))
    other -> (env, CPWild (pat-span pat) UError, add-error (pat-span pat) "multiplicity %0: an erased argument needs a variable or wildcard pattern" st)
  erased-value-binding :: List CheckedBinding -> Span -> String -> UType -> Store -> (List CheckedBinding, CorePattern, Store)
  erased-value-binding env sp name domain st = case fresh-id st of
    (id, fresh) -> (Cons (MkLocalBinding name (mono domain) id (store-level fresh)) env, CPErasedValue sp domain id name, fresh)

  local-types :: List (String, UType) -> List UType
  local-types locals = case locals of Nil -> Nil; Cons (name, ty) rest -> Cons ty (local-types rest)
  proof-domain :: List (String, UType) -> TypeExpr -> Bool
  proof-domain locals syntax = predicate-syntax syntax || (case syntax of
    TName sp name -> (case lookup-local name locals of Some ty -> kind-equal (type-kind ty) KProp; None -> False)
    TApp sp (TName at name) (TArg arg input (TArgsEnd end)) -> same name "Not"
    other -> False)
  record-proposition-type :: UType -> Bool
  record-proposition-type ty = valid-type ty && kind-equal (type-kind ty) KProp
  convert-domain :: Bool -> TypeContext -> List (String, UType) -> TypeExpr -> Store -> (UType, Store)
  convert-domain external kinds locals syntax st = case syntax of
    TEvidenceField sp name ty -> (case convert-domain external kinds locals ty st of
      (field-type, checked) -> if record-proposition-type field-type then (field-type, checked)
        else bad sp (string-concat-all ["an `erased` field is evidence: ", name, " needs a proposition"]) checked)
    other -> if proof-domain locals syntax then convert-predicate external kinds locals syntax st else convert external kinds locals syntax st
  convert-proof-arrow :: Bool -> TypeContext -> List (String, UType) -> Span -> UType -> Option TypeExpr -> TypeExpr -> Store -> (UType, Store)
  convert-proof-arrow external kinds locals sp predicate row result st =
    case (case row of None -> (URow UEnd, st); Some effects -> convert-row kinds locals effects st) of
      (effects, sr) -> case convert external kinds locals result sr of
        (out, done) -> let ty = UProofFun predicate effects out in
          (ty, if valid-type ty then done else add-error sp "ill-formed source erased arrow" done)
  check-usage-arrow :: Span -> String -> (UType, Store) -> (UType, Store)
  check-usage-arrow sp marker converted = case converted of
    (arrow, checked) -> case parse-arrow-usage marker of
      None -> bad sp "unknown arrow multiplicity" checked
      Some usage -> let ty = UUsageArrow usage arrow in
        if later-unrestricted usage arrow then bad sp "Later requires at most one use: %many would give it unrestricted-thunk semantics" checked
        else if valid-type ty then (ty, checked) else bad sp "a multiplicity needs a computational arrow" checked
  convert-arrow :: Bool -> TypeContext -> List (String, UType) -> Span -> TypeExpr -> Option TypeExpr -> TypeExpr -> Store -> (UType, Store)
  convert-arrow external kinds locals sp argument row result st = case argument of
    TBound s name carrier (TBoundsEnd end) -> case convert-domain external kinds locals carrier st of
      (domain, checked) -> if kind-equal (type-kind domain) KProp then convert-proof-arrow external kinds locals sp domain row result checked else
        (case fresh-for-types (Cons domain (local-types locals)) (expect-type s domain checked) of
          (id, fresh) -> let bound = Cons (name, UBound id name (value-kind domain)) locals in
            case (case row of None -> (URow UEnd, fresh); Some effects -> convert-row kinds bound effects fresh) of
              (effects, sr) -> case convert external kinds bound result sr of
                (out, done) -> let ty = UPi id name domain effects out in
                  (ty, if valid-type ty then done else add-error sp "ill-formed source dependent function" done))
    other -> case convert-domain external kinds locals argument st of
      (domain, checked) -> if kind-equal (type-kind domain) KProp then convert-proof-arrow external kinds locals sp domain row result checked else
        (case (case row of None -> (URow UEnd, checked); Some effects -> convert-row kinds locals effects checked) of
          (effects, sr) -> case convert external kinds locals result sr of
            (out, done) -> (function-type domain effects out, expect-type sp out (expect-type sp domain done)))

  expect-type :: Span -> UType -> Store -> Store
  expect-type sp ty st = if kind-equal (type-kind ty) KType then st else add-error sp "a value type must have kind Type" st
  -- A declaration's own type is a value type or a proposition: `witness ::
  -- Eq n n` declares a proof former, and the seed admits it. Everything
  -- that must be a value still goes through `expect-type`.
  expect-declared :: Span -> UType -> Store -> Store
  expect-declared sp ty st = if kind-equal (type-kind ty) KType || kind-equal (type-kind ty) KProp then st
    else add-error sp "a declaration type must have kind Type or Prop" st
  convert-row :: TypeContext -> List (String, UType) -> TypeExpr -> Store -> (UType, Store)
  convert-row kinds locals row st = case row of
    TRow s labels tail -> case convert-effects kinds locals labels st of
      (out, checked) -> case tail of
        None -> (URow out, checked)
        Some name -> case lookup-local name locals of
          Some rest -> if kind-equal (type-kind rest) KRow then (union-effects (URow out) rest, checked)
            else bad s "effect row tail must have kind Row" checked
          None -> bad s "effect row tail is not bound by this scheme" checked
    other -> bad (type-expr-span row) "malformed effect row syntax" st
  convert-effects :: TypeContext -> List (String, UType) -> TypeExpr -> Store -> (UType, Store)
  convert-effects kinds locals labels st = case labels of
    TArgsEnd s -> (UEnd, st)
    TArg s label rest -> case convert-effect kinds locals label st of
      (out, checked) -> case convert-effects kinds locals rest checked of (more, done) -> (UArg out more, done)
    other -> bad (type-expr-span labels) "malformed effect label spine" st
  convert-effect :: TypeContext -> List (String, UType) -> TypeExpr -> Store -> (UType, Store)
  convert-effect kinds locals label st = case label of
    TName s name -> if same name "IO" then (UCon "#kernel.ForeignIO" KEffect, st) else if has name ["Diverge", "Blocking", "Global", "Fail", "Reentrant", "ThreadAffine"] then (UCon name KEffect, st)
      else convert-declared-effect kinds locals label st
    TApp s (TName h name) (TArg a (TName r region) (TArgsEnd end)) ->
      if has name ["IO", "Async", "Cancel", "Eval", "Foreign", "Mut"] then (case lookup-local region locals of
        Some ty -> if kind-equal (type-kind ty) KRegion then (UApp (UCon name (KFun KRegion KEffect)) ty, st)
          else bad r "effect argument must have kind Region" st
        None -> bad r "unbound effect region" st)
      else convert-declared-effect kinds locals label st
    other -> convert-declared-effect kinds locals label st
  convert-declared-effect :: TypeContext -> List (String, UType) -> TypeExpr -> Store -> (UType, Store)
  convert-declared-effect kinds locals label st = case convert False kinds locals label st of
    (ty, checked) -> if valid-type ty && kind-equal (type-kind ty) KEffect then (ty, checked)
      else bad (type-expr-span label) "effect label must be a saturated checked effect constructor" checked
  convert-args :: Bool -> TypeContext -> List (String, UType) -> Span -> UType -> TypeExpr -> Store -> (UType, Store)
  convert-args external kinds locals sp head args st = case args of
    TArgsEnd end -> unfold-refinement sp kinds head st
    TArg s arg rest -> case type-kind (normalize st head) of
      KFun domain result -> case (case value-carrier domain of
        Some carrier -> convert-index external kinds locals carrier arg st
        None -> if kind-equal domain KProp then convert-predicate external kinds locals arg st else convert external kinds locals arg st) of
          (x, sx) -> let checked = unify-kind s domain (type-kind x) sx in
            convert-args external kinds locals sp (type-application head x) rest checked
      other -> bad sp "type constructor is applied to too many arguments" st
    other -> bad sp "malformed type argument spine" st
  convert-spine :: Bool -> TypeContext -> List (String, UType) -> TypeExpr -> Store -> (UType, Store)
  convert-spine external kinds locals xs st = case xs of
    TArgsEnd s -> (UEnd, st)
    TArg s x rest -> case convert external kinds locals x st of
      (ty, sx) -> case convert-spine external kinds locals rest (expect-type s ty sx) of (ys, sy) -> (UArg ty ys, sy)
    other -> bad (type-expr-span xs) "malformed tuple type spine" st
  -- Infer the ordinary Type -> ... -> Type constructor arity of an
  -- unannotated forall parameter. Explicit kinds remain authoritative;
  -- conversion below still checks every use against the inferred kind.
  max-arity :: Nat -> Nat -> Nat
  max-arity a b = if a > b then a else b
  flat-kind-arity :: Kind -> Nat
  flat-kind-arity kind = case kind of KFun KType rest -> 1 + flat-kind-arity rest; other -> 0
  closed-annotation-kind :: TypeExpr -> Option Kind
  closed-annotation-kind syntax = case syntax of
    TName sp name -> if same name "Type" then Some KType else if same name "Region" then Some KRegion else if same name "Prop" then Some KProp else if same name "Row" then Some KRow else if same name "Effect" then Some KEffect else None
    TFun sp a b -> case (closed-annotation-kind a, closed-annotation-kind b) of (Some first, Some second) -> Some (KFun first second); other -> None
    other -> None
  annotated-parameter-kind :: String -> List TypeParam -> Option Kind
  annotated-parameter-kind name params = case params of
    Nil -> None
    Cons p rest -> if same name (param-name p) then (case param-kind p of Some kind -> closed-annotation-kind kind; None -> None) else annotated-parameter-kind name rest
  known-head-kind :: TypeContext -> List (String, UType) -> List TypeParam -> TypeExpr -> Option Kind
  known-head-kind kinds locals params syntax = case syntax of
    TName sp name -> case lookup-local name locals of
      Some value -> Some (type-kind value)
      None -> case annotated-parameter-kind name params of Some kind -> Some kind; None -> context-kind name kinds
    other -> None
  constructor-arity-in :: TypeContext -> List (String, UType) -> List TypeParam -> String -> Nat -> TypeExpr -> Nat
  constructor-arity-in kinds locals params sought expected syntax = case syntax of
    TName sp name -> if same name sought then expected else 0
    TApp sp head spine -> case source-type-application head spine of
      (actual, argument-spine) -> let arguments = type-args-of argument-spine in let direct = case actual of TName at name -> if same name sought then list-length arguments + expected else 0; other -> constructor-arity-in kinds locals params sought 0 actual in
        max-arity direct (constructor-arity-arguments kinds locals params sought (known-head-kind kinds locals params actual) arguments)
    TFun sp a b -> max-arity (constructor-arity-in kinds locals params sought 0 a) (constructor-arity-in kinds locals params sought 0 b)
    TFunEff sp a row b -> max-arity (constructor-arity-in kinds locals params sought 0 row) (max-arity (constructor-arity-in kinds locals params sought 0 a) (constructor-arity-in kinds locals params sought 0 b))
    TUsageArrow s usage arrow -> constructor-arity-in kinds locals params sought 0 arrow
    TUsing sp bounds body -> max-arity (constructor-arity-in kinds locals params sought 0 bounds) (constructor-arity-in kinds locals params sought 0 body)
    TBound sp name annotation rest -> max-arity (constructor-arity-in kinds locals params sought 0 annotation) (constructor-arity-in kinds locals params sought 0 rest)
    TArg sp first rest -> max-arity (constructor-arity-in kinds locals params sought 0 first) (constructor-arity-in kinds locals params sought 0 rest)
    TTuple sp fields -> constructor-arity-in kinds locals params sought 0 fields
    TRow sp labels tail -> constructor-arity-in kinds locals params sought 0 labels
    TRefined sp predicate carrier -> constructor-arity-in kinds locals params sought 0 carrier
    TForall sp binders body -> if has sought (parameter-names-for-check (forall-params-of binders)) then 0 else constructor-arity-in kinds locals params sought expected body
    other -> 0
  constructor-arity-arguments :: TypeContext -> List (String, UType) -> List TypeParam -> String -> Option Kind -> List TypeExpr -> Nat
  constructor-arity-arguments kinds locals params sought head arguments = case arguments of
    Nil -> 0
    Cons first rest -> case head of
      Some (KFun domain result) -> max-arity (constructor-arity-in kinds locals params sought (flat-kind-arity domain) first) (constructor-arity-arguments kinds locals params sought (Some result) rest)
      other -> max-arity (constructor-arity-in kinds locals params sought 0 first) (constructor-arity-arguments kinds locals params sought None rest)
  constructor-kind-syntax :: Span -> Nat -> TypeExpr
  constructor-kind-syntax sp arity = if arity == 0 then TName sp "Type" else TFun sp (TName sp "Type") (constructor-kind-syntax sp (arity - 1))
  -- Only lexical row-tail occurrences determine an unannotated Row binder.
  -- Explicit kinds still pass through the ordinary conversion checks.
  row-parameter-names :: TypeExpr -> List String
  row-parameter-names syntax = case syntax of
    TRow sp labels tail -> row-parameter-names labels <> (case tail of None -> Nil; Some name -> [name])
    TFun sp a b -> row-parameter-names a <> row-parameter-names b
    TFunEff sp a row b -> row-parameter-names a <> row-parameter-names row <> row-parameter-names b
    TUsageArrow s usage arrow -> row-parameter-names arrow
    TApp sp f xs -> row-parameter-names f <> row-parameter-names xs
    TArg sp first rest -> row-parameter-names first <> row-parameter-names rest
    TTuple sp fields -> row-parameter-names fields
    TUsing sp bounds body -> row-parameter-names bounds <> row-parameter-names body
    TBound sp name annotation rest -> row-parameter-names annotation <> row-parameter-names rest
    TRefined sp predicate carrier -> row-parameter-names carrier
    TForall sp binders body -> remove-row-parameters (parameter-names-for-check (forall-params-of binders)) (row-parameter-names body)
    other -> Nil
  remove-row-parameters :: List String -> List String -> List String
  remove-row-parameters bound names = case names of
    Nil -> Nil
    Cons name rest -> if has name bound then remove-row-parameters bound rest else Cons name (remove-row-parameters bound rest)
  inferred-forall-parameters :: TypeContext -> List (String, UType) -> List TypeParam -> TypeExpr -> List TypeParam
  inferred-forall-parameters kinds locals params body = infer-forall-parameters kinds locals params params body
  infer-forall-parameters :: TypeContext -> List (String, UType) -> List TypeParam -> List TypeParam -> TypeExpr -> List TypeParam
  infer-forall-parameters kinds locals all remaining body = case remaining of
    Nil -> Nil
    Cons p rest -> Cons (case p of
      MkTypeParam sp name None only -> if has name (row-parameter-names body) then MkTypeParam sp name (Some (TName sp "Row")) only else
        let arity = constructor-arity-in kinds locals all name 0 body in
        if arity == 0 then p else MkTypeParam sp name (Some (constructor-kind-syntax sp arity)) only
      other -> p) (infer-forall-parameters kinds locals all rest body)

  make-scheme :: Bool -> List (String, Kind) -> TypeContext -> List Quant -> TypeExpr -> Store -> (Scheme, Store)
  make-scheme external classes kinds inherited ty st = case ty of
    TForall s binders body -> case parameters external kinds (quant-locals inherited)
      (inferred-forall-parameters kinds (quant-locals inherited) (region-parameters (forall-params-of binders) (region-names body)) body)
      (quant-next inherited) (quant-names inherited) (if quantifiers-ok binders then st else add-error s "malformed quantified parameter spine" st) of
        (local, checked) -> scheme-body-from external classes kinds (implicit-row-regions (inherited <> local) (latent-regions body)) body checked
    other -> scheme-body-from external classes kinds (case inherited of Nil -> implicit-row-regions Nil (latent-regions ty); more -> inherited) ty st

  term-annotation-parameters :: List Quant -> Bool
  term-annotation-parameters params = case params of
    Nil -> True
    Cons q rest -> case quant-kind q of
      KValue payload -> False
      KProp -> False
      other -> term-annotation-parameters rest
  unbound-annotation-regions :: List (String, UType) -> List String -> List String
  unbound-annotation-regions locals regions = case regions of
    Nil -> Nil
    Cons name rest -> case lookup-type-local name locals of
      Some local -> unbound-annotation-regions locals rest
      None -> Cons name (unbound-annotation-regions locals rest)
  -- Validate every instantiation under fresh rigids. Only after checking
  -- may the caller choose the representation and the concrete types.
  infer-forall-annotation :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> TypeExpr -> TypeExpr -> Store -> (CoreTerm, Store)
  infer-forall-annotation classes kinds families env locals sp expression binders body st =
    let visible = value-locals env locals in
    let explicit = region-parameters (forall-params-of binders) (region-names body) in
    case parameters False kinds visible (inferred-forall-parameters kinds visible explicit body) 0 Nil st of
      (declared, parsed) -> let params = implicit-row-regions declared (unbound-annotation-regions visible (latent-regions body)) in
        if not (quantifiers-ok binders && term-annotation-parameters params) then
          term-error sp "quantified term annotation needs ordinary type, region or effect parameters" parsed
        else case convert False kinds (quant-locals params <> visible) body parsed of
          (ty, converted) -> let scheme = MkScheme params ty in
            case open-scheme True scheme (enter-level (expect-type sp ty converted)) of
              (expected, rigids, opened) ->
                case check classes kinds families env (opened-locals params rigids <> locals) expression expected opened of
                  (value, checked) ->
                    case open-scheme False scheme (restore-level (store-level st) checked) of
                      (actual, actuals, ready) ->
                        let replacements = annotation-substitution rigids actuals in
                        (map-term-types (\t -> substitute-rigid-types replacements (normalize checked t)) value, ready)
  annotation-substitution :: List (Nat, UType) -> List (Nat, UType) -> List (Nat, UType)
  annotation-substitution rigids actuals = case (rigids, actuals) of
    (Cons (key, URigid id name level kind) more, Cons (other, ty) rest) ->
      Cons (id, ty) (annotation-substitution more rest)
    other -> Nil

  scheme-body-from :: Bool -> List (String, Kind) -> TypeContext -> List Quant -> TypeExpr -> Store -> (Scheme, Store)
  -- An imported scheme keeps its defining module's dictionary order: the
  -- requirements are read in declaration order from the recorded source
  -- contract when the producer stored no resolved form.
  scheme-body-from external classes kinds qs ty st = case ty of
    TUsing s bounds body -> case convert-requirements classes kinds (quant-locals qs) bounds Nil st of
      (requirements, sr) -> case convert-contracted external kinds (quant-locals qs) bounds body sr of
        (out, so) -> (qualified qs requirements out, expect-declared s out so)
    other -> case convert external kinds (quant-locals qs) ty st of (out, so) -> (MkScheme qs out, expect-declared (type-expr-span ty) out so)
  convert-requirements :: List (String, Kind) -> TypeContext -> List (String, UType) -> TypeExpr -> List String -> Store -> (List Requirement, Store)
  convert-requirements classes kinds locals bounds seen st = case bounds of
    TBoundsEnd s -> (Nil, st)
    TBound s name app rest -> if predicate-syntax app then convert-requirements classes kinds locals rest seen st else case convert False kinds locals app st of
      (ty, sc) ->
        let checked = if has name seen then add-error s "duplicate dictionary binder" sc
              else if checked-class-type classes ty then sc else add-error s "using constraint needs a saturated checked signature type" sc in
        case convert-requirements classes kinds locals rest (Cons name seen) checked of
          (more, done) -> (Cons (MkRequirement name ty) more, done)
    other -> (Nil, add-error (type-expr-span bounds) "using predicate needs dependent proof elaboration" st)
  checked-class-type :: List (String, Kind) -> UType -> Bool
  checked-class-type classes ty = valid-type ty && kind-equal (type-kind ty) KType && (case root-name ty of
    Some name -> (case lookup-kind name classes of Some kind -> class-head-kind ty kind; None -> False)
    None -> False)
  class-head-kind :: UType -> Kind -> Bool
  class-head-kind ty expected = case ty of UCon name kind -> kind-equal kind expected; UApp f x -> class-head-kind f expected; other -> False
  quantifiers-ok :: TypeExpr -> Bool
  quantifiers-ok qs = case qs of TQuantifier s name only k rest -> quantifier-tail rest; other -> False
  quantifier-tail :: TypeExpr -> Bool
  quantifier-tail qs = case qs of TQuantifiersEnd s -> True; TQuantifier s name only k rest -> quantifier-tail rest; other -> False
  -- Unannotated variables used by kernel capabilities or effect labels have
  -- kind Region. This does not bind otherwise free names in a using context.
  region-parameters :: List TypeParam -> List String -> List TypeParam
  region-parameters ps regions = case ps of
    Nil -> Nil
    Cons p rest -> Cons (case p of MkTypeParam s name None only -> if has name regions then MkTypeParam s name (Some (TName s "Region")) only else p; other -> p) (region-parameters rest regions)
  region-names :: TypeExpr -> List String
  region-names ty = case ty of
    TApp s (TName h name) (TArg a (TName r region) (TArg b carrier (TArgsEnd end))) ->
      if has name ["Ref", "Mut"] then Cons region (region-names carrier)
      else if has name ["Scope", "b.Scope"] then
        (case carrier of TName t inner -> [region, inner]; other -> region-names carrier)
      else region-names carrier
    TApp s (TName h name) (TArg a first (TArg b second (TArg c value (TArgsEnd end)))) ->
      if has name ["Task", "b.Task"] then (case first of TName r region -> [region]; other -> Nil)
      else if same name "Lazy" then (case second of
        TName r region -> Cons region (region-names first <> region-names value)
        other -> region-names first <> region-names value)
      else region-names first <> region-names second <> region-names value
    TApp s (TName h name) (TArg a (TName r region) (TArgsEnd end)) -> if has name ["Io", "b.Io", "IO", "Async", "Cancel", "Eval", "Foreign", "Mut"] then [region] else Nil
    TApp s f xs -> region-names f <> region-names xs
    TFun s a b -> region-names a <> region-names b
    TFunEff s a row b -> region-names a <> region-names row <> region-names b
    TUsageArrow s usage arrow -> region-names arrow
    TRow s labels tail -> region-names labels
    TUsing s bounds body -> region-names bounds <> region-names body
    TBound s name app rest -> region-names app <> region-names rest
    TArg s x rest -> region-names x <> region-names rest
    TTuple s xs -> region-names xs
    other -> Nil
  latent-regions :: TypeExpr -> List String
  latent-regions ty = case ty of
    TFun s a b -> latent-regions a <> latent-regions b
    TFunEff s a row b -> latent-regions a <> region-names row <> latent-regions b
    TUsageArrow s usage arrow -> latent-regions arrow
    TUsing s bounds body -> latent-regions body
    TApp s f xs -> latent-regions f <> latent-regions xs
    TArg s x rest -> latent-regions x <> latent-regions rest
    TTuple s xs -> latent-regions xs
    other -> Nil
  quantified-name :: String -> List Quant -> Bool
  quantified-name name qs = case qs of Nil -> False; Cons q rest -> same name (quant-name q) || quantified-name name rest
  implicit-row-regions :: List Quant -> List String -> List Quant
  implicit-row-regions qs names = case names of
    Nil -> qs
    Cons name rest -> implicit-row-regions (if quantified-name name qs then qs else qs <> [MkQuant (list-length qs) name KRegion True]) rest

  imported-kinds :: TypeContext -> Json -> Store -> (List Quant, Store)
  imported-kinds kinds rows st = case imported-kinds-from kinds Nil 0 Nil rows st of
    (qs, checked) -> (qs, declaration-kind-errors zero qs checked)
  imported-kinds-from :: TypeContext -> List (String, UType) -> Nat -> List String -> Json -> Store -> (List Quant, Store)
  imported-kinds-from kinds locals next seen rows st = case rows of
    JArr row rest -> case (field "name" row, field "kind" row, field "implicit" row) of
      (JStr name, JStr text, JBool only) -> case parse-scheme "interface-kind" (string-to-bytes text) of
        Parsed ast Nil ->
          let distinct = if has name seen then add-error zero "duplicate imported declaration parameter" st else st in
          case kind-of True kinds locals ast distinct of
            (k, sk) -> case imported-kinds-from kinds (Cons (name, UBound next name k) locals) (next + 1) (Cons name seen) rest sk of
              (qs, sr) -> (Cons (MkQuant next name k only) qs, sr)
        other -> (Nil, add-error zero "invalid imported declaration kind" st)
      other -> (Nil, add-error zero "missing imported declaration parameter metadata" st)
    JArrEnd -> (Nil, st)
    other -> (Nil, add-error zero "missing imported declaration parameters" st)
  add-kind :: Span -> String -> Kind -> TypeContext -> Store -> (TypeContext, Store)
  add-kind sp name k kinds st = case context-kind name kinds of
    Some old -> (kinds, add-error sp (string-concat "duplicate type declaration: " name) st)
    None -> (context-add-kind name k kinds, st)
  context-array-observation :: String -> TypeContext -> Option Json
  context-array-observation name context = case context of MkTypeContext kinds aliases active observers effects source-classes -> array-observation name observers
  array-observation :: String -> List ByteObservation -> Option Json
  array-observation name observers = case observers of
    Nil -> None
    Cons (ArrayObservation binding row) rest -> if same name binding then Some row else array-observation name rest
    Cons other rest -> array-observation name rest
  context-add-array-observation :: String -> Json -> TypeContext -> TypeContext
  context-add-array-observation identity row context = case context of
    MkTypeContext kinds aliases active observers effects source-classes -> MkTypeContext kinds aliases active (Cons (ArrayObservation identity row) observers) effects source-classes
  imported-array-observers :: Span -> String -> Json -> TypeContext -> Store -> (TypeContext, Store)
  imported-array-observers sp owner rows context st = case rows of
    JArr row rest -> case field "external" row of
      JStr symbol -> (case array-plan symbol of
        Some plan -> (case (field "symbol" row, field "kind" row, field "abi" row, field "effects" row, field "type" row) of
          (JStr local, JStr category, JStr abi, JStr effects, JStr syntax) ->
            if string-length local == 0 || not (same category "intrinsic" && same abi "ccall" && same effects "") then
              imported-array-observers sp owner rest context (add-error sp "invalid imported array intrinsic authority" st)
            else let identity = interface-global (string-concat-all [owner, ".", local]) in
              (case context-array-observation identity context of
                Some prior -> imported-array-observers sp owner rest context (add-error sp "duplicate imported array intrinsic authority" st)
                None -> imported-array-observers sp owner rest (context-add-array-observation identity row context) st)
          other -> imported-array-observers sp owner rest context (add-error sp "incomplete imported array intrinsic authority" st))
        None -> imported-array-observers sp owner rest context st)
      other -> imported-array-observers sp owner rest context st
    JArrEnd -> (context, st)
    other -> (context, add-error sp "invalid imported foreign contract table" st)
  array-import-binding :: String -> TypeContext -> Bool
  array-import-binding name context = case context-array-observation name context of Some row -> True; None -> False
  check-array-kernel-scheme :: Span -> Scheme -> Scheme -> Store -> Store
  check-array-kernel-scheme sp actual wanted st =
    if not (array-quantifiers-match (scheme-params actual) (scheme-params wanted)) || list-length (scheme-requirements actual) /= 0 then
      add-error sp "array intrinsic requires its exact polymorphic kernel scheme" st
    else unify sp (scheme-body actual) (scheme-body wanted) st
  register-imported-array :: Span -> String -> Scheme -> List (String, Kind) -> TypeContext -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-imported-array sp name actual classes context env st = case context-array-observation name context of
    Some row -> (case (field "external" row, field "type" row) of
      (JStr symbol, JStr declared) -> (case array-plan symbol of
        Some (operation, format, canonical) -> (case (parse-scheme symbol (string-to-bytes canonical), parse-scheme name (string-to-bytes declared)) of
          (Parsed expected Nil, Parsed cached Nil) -> (case make-scheme False classes context Nil (kernel-canonical-type expected) st of
            (wanted, ready) -> case make-scheme False classes context Nil (kernel-canonical-type cached) ready of
              (foreign-scheme, checked) ->
                let matched = check-array-kernel-scheme sp actual wanted (check-array-kernel-scheme sp foreign-scheme wanted checked) in
                case lookup-binding name env of
                  Some prior -> (env, add-error sp "duplicate imported array binding" matched)
                  None -> (Cons (MkIntrinsicBinding name actual symbol) env, matched))
          other -> (env, add-error sp "invalid imported array scheme cache" st))
        None -> (env, add-error sp "imported array operation is unavailable in this ABI" st))
      other -> (env, add-error sp "incomplete imported array binding" st))
    None -> (env, add-error sp "imported array value lacks its defining foreign authority" st)
  imported-byte-observers :: Span -> String -> Json -> TypeContext -> Store -> (TypeContext, Store)
  imported-byte-observers sp owner rows kinds st = case rows of
    JArr row rest -> case (field "kind" row, field "abi" row, field "external" row) of
      (JStr category, JStr abi, JStr external) ->
        if same category "intrinsic" && same external "cinch.runtime.bytesLen" then
          (case (field "symbol" row, field "effects" row, field "type" row) of
            (JStr name, JStr effects, JStr scheme) -> if same abi "ccall" && string-length name > 0 && string-length effects == 0 then
              let identity = interface-global (string-concat-all [owner, ".", name]) in
              imported-byte-observers sp owner rest (context-add-byte-observation identity (Some scheme) kinds) st
              else imported-byte-observers sp owner rest kinds (add-error sp "invalid imported byte observation ABI contract" st)
            other -> imported-byte-observers sp owner rest kinds (add-error sp "incomplete imported byte observation contract" st))
        else imported-byte-observers sp owner rest kinds st
      other -> imported-byte-observers sp owner rest kinds st
    JArrEnd -> (kinds, st)
    other -> (kinds, st)
  collect-kinds :: List Decl -> TypeContext -> Store -> (TypeContext, Store)
  collect-kinds ds kinds st = case ds of
    Nil -> (kinds, st)
    Cons (DInterface sp owner hash metadata) rest -> case imported-byte-observers sp owner (field "foreign" (field "exports" metadata)) kinds st of
      (more, checked) -> case imported-array-observers sp owner (field "foreign" (field "exports" metadata)) more checked of
        (complete, ready) -> case foreign-opaque-kinds sp owner (field "types" (field "exports" metadata)) complete ready of
          (with-opaque, checked-opaque) -> collect-kinds rest (context-add-alias (DInterface sp owner hash metadata) with-opaque) checked-opaque
    Cons d rest -> case d of
      -- An abstract carrier supplies a checked kind, never a constructor
      -- family. In particular it cannot justify an empty-case proof.
      DOpaque s name ps result -> case parameters False kinds Nil ps 0 Nil st of
        (qs, sq) -> case add-kind s name (kind-arrow qs) kinds (opaque-result-kind s result (declaration-kind-errors s qs sq)) of
          (ks, sk) -> collect-kinds rest (context-add-alias d ks) sk
      DRefine s name ps binder predicate -> case parameters False kinds Nil ps 0 Nil st of
        (qs, sq) -> case add-kind s name (kind-arrow qs) kinds (declaration-kind-errors s qs sq) of
          (ks, sk) -> collect-kinds rest (context-add-alias d ks) sk
      DForeign s direction abi symbol name syntax ->
        if same direction "import" && same abi "ccall" && same symbol "cinch.runtime.bytesLen" then
          collect-kinds rest (context-add-byte-observation name None kinds) st else collect-kinds rest kinds st
      DEffect s name ps ops -> case parameters False kinds Nil ps 0 Nil st of
        (qs, sq) -> case add-kind s name (source-effect-kind qs) kinds (declaration-kind-errors s qs sq) of (ks, sk) -> collect-kinds rest ks sk
      DData s name ps cs -> case parameters False kinds Nil ps 0 Nil st of
        (qs, sq) -> case add-kind s name (kind-arrow qs) kinds (declaration-kind-errors s qs sq) of (ks, sk) -> collect-kinds rest ks sk
      -- The generated single-constructor data has already checked the
      -- kind. Keep the defining labels as separate source provenance.
      DRecord s name ps fields -> collect-kinds rest (context-add-alias d kinds)
        (duplicate-names s (record-labels fields) Nil st)
      DCodata s name ps observations -> collect-kinds rest (context-add-alias d kinds) st
      DSource s name metadata -> (case field "record_scope" metadata of
        JArr first more -> collect-kinds rest (context-add-alias d kinds) st
        other -> collect-kinds rest kinds st)
      DClass s name ps members -> case parameters False kinds Nil ps 0 Nil st of
        (qs, sq) -> case add-kind s name (kind-arrow qs) kinds (declaration-kind-errors s qs sq) of (ks, sk) -> collect-kinds rest ks sk
      DExternal s name category scheme metadata ->
        if same category "signature" then
          case imported-kinds kinds (field "parameters" metadata) st of
            (qs, sq) -> case context-kind name kinds of
              Some old -> collect-kinds rest kinds sq
              None -> collect-kinds rest (context-add-kind name (kind-arrow qs) kinds) sq
        else if same category "type" then
          case field "kind" metadata of
            JStr variety ->
              if same variety "refinement" then
                (case imported-refinement s name metadata st of
                  (Some declaration, checked) -> case declaration of
                    DRefine at owner params binder predicate -> case parameters False kinds Nil params 0 Nil checked of
                      (qs, prepared) -> case add-kind s owner (kind-arrow qs) kinds (declaration-kind-errors s qs prepared) of
                        (more, final) -> collect-kinds rest (context-add-alias declaration more) final
                    other -> collect-kinds rest kinds (add-error s "invalid imported refinement declaration" checked)
                  (None, checked) -> collect-kinds rest kinds checked)
              else if same variety "data" || same variety "record" || same variety "codata" || same variety "opaque" || same variety "signature" then
                case imported-kinds kinds (field "parameters" metadata) st of
                  (qs, sq) -> case context-kind name kinds of
                    Some old -> collect-kinds rest (context-add-alias d kinds) sq
                    None -> collect-kinds rest (context-add-alias d (context-add-kind name (kind-arrow qs) kinds)) sq
              else collect-kinds rest kinds (add-error s "imported class/refinement type needs kind and proof elaboration" st)
            other -> collect-kinds rest kinds (add-error s "imported type has no declaration kind" st)
        else collect-kinds rest kinds st
      other -> collect-kinds rest kinds st

  -- The first binding named `name`. Below the module environment's cache
  -- entry the name index gives its position in the list. Positions and
  -- names survive invalidate-proof-bindings, which rebuilds the list one
  -- for one, so the binding is read from the current list.
  lookup-binding :: String -> List CheckedBinding -> Option CheckedBinding
  lookup-binding name env = case env of
    Nil -> None
    Cons b rest -> if same name (checked-name b) then Some b else case b of
      MkBodyContext context names cache -> (case hash-map-lookup name names of
        None -> None
        Some position -> binding-at rest position)
      other -> lookup-binding name rest
  binding-at :: List CheckedBinding -> Nat -> Option CheckedBinding
  binding-at env position = case env of
    Nil -> None
    Cons b rest -> if position == 0 then Some b else binding-at rest (position - 1)
  add-binding :: Span -> String -> Scheme -> String -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  add-binding sp name sc role env st = case lookup-binding name env of
    Some prior -> (env, add-error sp (string-concat "duplicate signature or constructor: " name) st)
    None -> (Cons (MkCheckedBinding name sc role) env, st)

  -- Length framing preserves exact defining contract identity even if
  -- a source spelling contains punctuation. Native emits canonical text;
  -- differing templates for the same owner are refused before inference.
  contract-part :: String -> String
  contract-part value = string-concat-all [nat-to-string (string-length value), ":", value]
  contract-text :: Json -> String
  contract-text value = case value of JStr text -> text; other -> ""
  contract-parameters :: Json -> String
  contract-parameters rows = case rows of
    JArr row rest -> string-concat-all [contract-part (contract-text (field "name" row)), contract-part (contract-text (field "kind" row)), (case field "implicit" row of JBool True -> "1"; JBool False -> "0"; other -> "?"), contract-parameters rest]
    JArrEnd -> "!"
    other -> "?"
  refinement-contract-key :: Json -> String
  refinement-contract-key row = let template = field "refinement" row in
    string-concat-all [contract-part (contract-parameters (field "parameters" row)), contract-part (contract-text (field "binder" template)), contract-part (contract-text (field "carrier" template)), contract-part (contract-text (field "predicate" template))]
  previous-contract :: String -> List (String, String) -> Option String
  previous-contract identity seen = case seen of Nil -> None; Cons (name, key) rest -> if same identity name then Some key else previous-contract identity rest
  check-refinement-row :: Span -> Json -> List (String, String) -> Store -> (List (String, String), Store)
  check-refinement-row sp row seen st = case (field "kind" row, field "identity" row) of
    (JStr kind, JStr identity) -> if not (same kind "refinement") then (seen, st)
      else let key = refinement-contract-key row in
        case previous-contract identity seen of
          None -> (Cons (identity, key) seen, st)
          Some prior -> (seen, if same key prior then st else add-error sp "conflicting defining refinement contracts" st)
    other -> (seen, st)
  check-refinement-rows :: Span -> Json -> List (String, String) -> Store -> (List (String, String), Store)
  check-refinement-rows sp rows seen st = case rows of
    JArr row rest -> case check-refinement-row sp row seen st of (more, checked) -> check-refinement-rows sp rest more checked
    other -> (seen, st)
  check-instance-refinements :: Span -> Json -> List (String, String) -> Store -> (List (String, String), Store)
  check-instance-refinements sp rows seen st = case rows of
    JArr row rest -> case check-refinement-rows sp (resolved-nominals row) seen st of
      (more, checked) -> case check-conditional-refinements sp (field "method_contracts" row) more checked of
        (all, done) -> check-instance-refinements sp rest all done
    other -> (seen, st)
  check-type-refinements :: Span -> Json -> List (String, String) -> Store -> (List (String, String), Store)
  check-type-refinements sp rows seen st = case rows of
    JArr row rest -> case check-refinement-row sp row seen st of
      (public, checked) -> case check-instance-refinements sp (field "ctors" row) public checked of
        (more, done) -> check-type-refinements sp rest more done
    other -> (seen, st)
  check-signature-refinements :: Span -> Json -> List (String, String) -> Store -> (List (String, String), Store)
  check-signature-refinements sp rows seen st = case rows of
    JArr row rest -> case check-instance-refinements sp (field "methods" row) seen st of
      (more, done) -> check-signature-refinements sp rest more done
    other -> (seen, st)
  check-imported-refinements :: List Decl -> List (String, String) -> Store -> Store
  check-imported-refinements ds seen st = case ds of
    Nil -> st
    Cons (DExternal sp name category syntax metadata) rest -> case check-refinement-row sp metadata seen st of
      (public, checked) -> case check-refinement-rows sp (resolved-nominals metadata) public checked of
        (all, done) -> check-imported-refinements rest all done
    Cons (DInterface sp name hash metadata) rest -> case check-type-refinements sp (field "types" (field "exports" metadata)) seen st of
      (public, checked) -> case check-instance-refinements sp (field "values" (field "exports" metadata)) public checked of
        (values, sv) -> case check-signature-refinements sp (field "signatures" (field "exports" metadata)) values sv of
          (methods, sm) -> case check-instance-refinements sp (field "instances" (field "exports" metadata)) methods sm of
            (all, done) -> check-imported-refinements rest all done
    Cons other rest -> check-imported-refinements rest seen st
  register-private-refinement :: Span -> String -> Json -> TypeContext -> Store -> (TypeContext, Store)
  register-private-refinement sp name row kinds st = case field "kind" row of
    JStr kind -> if not (same kind "refinement") then (kinds, st)
      else case find-refinement name (context-aliases kinds) of
        Some existing -> (kinds, st)
        None -> case imported-refinement sp name row st of
          (Some declaration, checked) -> (context-add-alias declaration kinds, checked)
          (None, checked) -> (kinds, checked)
    other -> (kinds, add-error sp "missing defining nominal kind" st)

  collect-nominal-rows :: Span -> Json -> TypeContext -> Store -> (TypeContext, Store)
  collect-nominal-rows sp rows kinds st = case rows of
    JArr row rest -> case (field "identity" row, imported-kinds kinds (field "parameters" row) st) of
      (JStr identity, (qs, sq)) ->
        let name = interface-global identity in
        let k = kind-arrow qs in
        let (registered, checked) = case context-kind name kinds of
              None -> (context-add-kind name k kinds, sq)
              Some prior -> (kinds, if kind-equal prior k then sq else add-error sp "conflicting defining nominal kinds" sq) in
        case register-private-refinement sp name row registered checked of
          (more, done) -> collect-nominal-rows sp rest more done
      other -> (kinds, add-error sp "invalid resolved nominal identity" st)
    JArrEnd -> (kinds, st)
    other -> (kinds, add-error sp "invalid resolved nominal contracts" st)
  collect-nominal-kinds :: List Decl -> TypeContext -> Store -> (TypeContext, Store)
  collect-nominal-kinds ds kinds st = case ds of
    Nil -> (kinds, st)
    Cons (DExternal s name category scheme metadata) rest -> case resolved-text metadata of
      None -> collect-nominal-kinds rest kinds st
      Some text -> if resolved-entry-valid metadata then
        (case collect-nominal-rows s (resolved-nominals metadata) kinds st of (ks, sk) -> collect-nominal-kinds rest ks sk)
        else collect-nominal-kinds rest kinds (add-error s "invalid resolved nominal contract" st)
    Cons (DInterface sp name hash metadata) rest -> case collect-instance-nominals sp (field "instances" (field "exports" metadata)) kinds st of
      (more, checked) -> case public-constructor-nominals sp (field "types" (field "exports" metadata)) more checked of
        (closed, done) -> collect-nominal-kinds rest closed done
    Cons d rest -> collect-nominal-kinds rest kinds st

  -- A returned carrier may demand its complete public layout even when no
  -- constructor was named by the client. The defining constructor schemes
  -- carry private field-type identities that must be known before that
  -- layout is checked. These facts add kinds, never source bindings or
  -- constructor visibility; only the admitted public table supplies layouts.
  public-constructor-nominals :: Span -> Json -> TypeContext -> Store -> (TypeContext, Store)
  public-constructor-nominals sp types kinds st = case types of
    JArr row rest -> case public-constructor-contracts sp (field "ctors" row) kinds st of
      (more, checked) -> public-constructor-nominals sp rest more checked
    JArrEnd -> (kinds, st)
    other -> (kinds, add-error sp "invalid public constructor type table" st)
  public-constructor-contracts :: Span -> Json -> TypeContext -> Store -> (TypeContext, Store)
  public-constructor-contracts sp constructors kinds st = case constructors of
    JArr row rest -> case collect-contract-nominals sp row kinds st of
      (more, checked) -> public-constructor-contracts sp rest more checked
    JArrEnd -> (kinds, st)
    other -> (kinds, add-error sp "invalid public constructor contract table" st)

  class-declaration-rows :: Decl -> List Json
  class-declaration-rows d = case d of
    DInterface s name hash metadata -> json-rows (field "signatures" (field "exports" metadata))
    other -> Nil
  json-rows :: Json -> List Json
  json-rows rows = case rows of JArr row rest -> Cons row (json-rows rest); other -> Nil
  class-rows :: List Decl -> List Json
  class-rows ds = case ds of Nil -> Nil; Cons d rest -> class-declaration-rows d <> class-rows rest
  find-class-row :: String -> List Json -> Option Json
  find-class-row name rows = case rows of
    Nil -> None
    Cons row rest -> case field "identity" row of JStr identity -> if same name (interface-global identity) then Some row else find-class-row name rest; other -> find-class-row name rest
  instance-syntax-owner :: TypeExpr -> Option String
  instance-syntax-owner ty = case ty of TName s name -> Some name; TApp s f xs -> instance-syntax-owner f; TUsing s bounds body -> instance-syntax-owner body; TForall s qs body -> instance-syntax-owner body; other -> None
  member-nominal-kinds :: Span -> Json -> TypeContext -> Store -> (TypeContext, Store)
  member-nominal-kinds sp methods kinds st = case methods of
    JArr row rest -> case resolved-text row of
      Some text -> case collect-nominal-rows sp (resolved-nominals row) kinds st of
        (more, checked) -> member-nominal-kinds sp rest more checked
      None -> member-nominal-kinds sp rest kinds st
    JArrEnd -> (kinds, st)
    other -> (kinds, add-error sp "invalid defining class method array" st)
  source-instance-nominals :: List Decl -> List Json -> TypeContext -> Store -> (TypeContext, Store)
  source-instance-nominals ds rows kinds st = case ds of
    Nil -> (kinds, st)
    Cons (DInstance sp flag name params head-type members) rest -> case instance-syntax-owner head-type of
      Some owner -> (case find-class-row owner rows of
        Some row -> (case member-nominal-kinds sp (field "methods" row) kinds st of (more, checked) -> source-instance-nominals rest rows more checked)
        None -> source-instance-nominals rest rows kinds st)
      None -> source-instance-nominals rest rows kinds st
    Cons other rest -> source-instance-nominals rest rows kinds st
  typed-class-methods :: Span -> List (String, Kind) -> TypeContext -> Json -> Store -> (List CoreClassMethod, Store)
  typed-class-methods sp classes kinds rows st = case rows of
    JArr row rest -> case (field "name" row, field "slot" row, resolved-text row) of
      (JStr name, JNum slot, Some text) -> if slot < 0 then (Nil, add-error sp "negative defining class method slot" st) else
        (case imported-scheme sp classes kinds (TUnmodeled sp "missing class method contract") row st of
          (sc, checked) -> case typed-class-methods sp classes kinds rest checked of (more, final) -> (Cons (MkCoreClassMethod sp name (nat-from-int slot) sc) more, final))
      other -> (Nil, add-error sp "source instance needs a portable defining contract for every class method" st)
    JArrEnd -> (Nil, st)
    other -> (Nil, add-error sp "invalid defining class method array" st)
  typed-class :: Span -> String -> List Json -> List (String, Kind) -> TypeContext -> Store -> (Option CoreClass, Store)
  typed-class sp owner rows classes kinds st = case find-class owner (context-source-classes kinds) of
    Some description -> (Some description, st)
    None -> imported-typed-class sp owner rows classes kinds st
  imported-typed-class :: Span -> String -> List Json -> List (String, Kind) -> TypeContext -> Store -> (Option CoreClass, Store)
  imported-typed-class sp owner rows classes kinds st = case (find-class-row owner rows, context-kind owner kinds) of
    (Some row, Some kind) -> case imported-kinds kinds (field "parameters" row) st of
      (params, checked) -> case typed-class-methods sp classes kinds (field "methods" row) checked of
        (methods, final) -> let description = MkCoreClass sp owner kind params methods in
          if class-closed description then (Some description, final) else (None, add-error sp "defining class contract is not closed or has inconsistent method slots" final)
    other -> (None, add-error sp "source instance has no defining class contract" st)
  -- Imported methods need their defining class even when this module creates
  -- no source instance. Probe portable contracts in a private store: an unused
  -- unported class must not add diagnostics or inference state to the module.
  -- A missing descriptor still receives an explicit runtime refusal if used.
  imported-runtime-class-kinds :: List Json -> TypeContext -> Store -> (TypeContext, Store)
  imported-runtime-class-kinds rows kinds st = case rows of
    Nil -> (kinds, st)
    Cons row rest -> case field "identity" row of
      JStr identity -> (case imported-kinds kinds (field "parameters" row) (empty-store "imported class parameters") of
        (params, checked) -> case store-errors checked of
          Nil -> let owner = interface-global identity in let kind = kind-arrow params in
            (case context-kind owner kinds of
              None -> imported-runtime-class-kinds rest (context-add-kind owner kind kinds) st
              Some old -> imported-runtime-class-kinds rest kinds (if kind-equal old kind then st else add-error zero "imported class kind disagrees with its defining parameters" st))
          other -> imported-runtime-class-kinds rest kinds st)
      other -> imported-runtime-class-kinds rest kinds st
  checked-imported-classes :: List Json -> List Json -> List (String, Kind) -> TypeContext -> List CoreClass -> List CoreClass
  checked-imported-classes remaining rows classes kinds descriptions = case remaining of
    Nil -> descriptions
    Cons row rest -> case field "identity" row of
      JStr identity -> let owner = interface-global identity in case find-class owner descriptions of
        Some description -> checked-imported-classes rest rows classes kinds descriptions
        None -> (case member-nominal-kinds zero (field "methods" row) kinds (empty-store "imported runtime class") of
          (local-kinds, prepared) -> case store-errors prepared of
            Nil -> (case imported-typed-class zero owner rows classes local-kinds prepared of
              (Some description, checked) -> case store-errors checked of
                Nil -> checked-imported-classes rest rows classes kinds (Cons description descriptions)
                other -> checked-imported-classes rest rows classes kinds descriptions
              other -> checked-imported-classes rest rows classes kinds descriptions)
            other -> checked-imported-classes rest rows classes kinds descriptions)
      other -> checked-imported-classes rest rows classes kinds descriptions
  class-kinds :: List Json -> TypeContext -> List (String, Kind) -> List (String, Kind)
  class-kinds rows kinds seen = case rows of
    Nil -> seen
    Cons row rest -> case field "identity" row of
      JStr identity -> let name = interface-global identity in
        case (context-kind name kinds, lookup-kind name seen) of
          (Some kind, None) -> class-kinds rest kinds (Cons (name, kind) seen)
          other -> class-kinds rest kinds seen
      other -> class-kinds rest kinds seen
  method-slot-valid :: String -> String -> Nat -> List Json -> Bool
  method-slot-valid owner name slot rows = case rows of
    Nil -> False
    Cons row rest -> case field "identity" row of
      JStr identity -> if same owner (interface-global identity) then method-slot-in identity name slot (field "methods" row)
        else method-slot-valid owner name slot rest
      other -> method-slot-valid owner name slot rest
  method-slot-in :: String -> String -> Nat -> Json -> Bool
  method-slot-in owner name slot rows = case rows of
    JArr row rest -> (case (field "name" row, field "slot" row) of
      (JStr method, JNum number) -> number == nat-to-int slot && same name (interface-global (string-concat-all [owner, ".", method]))
      other -> False) || method-slot-in owner name slot rest
    other -> False

  imported-scheme :: Span -> List (String, Kind) -> TypeContext -> TypeExpr -> Json -> Store -> (Scheme, Store)
  imported-scheme sp classes kinds fallback metadata st = case resolved-text metadata of
    None -> make-scheme True classes kinds Nil fallback st
    Some text -> case parse-scheme "resolved-interface" (string-to-bytes text) of
      Parsed ty Nil -> case qualify-resolved metadata ty of
        (qualified, Nil) -> make-scheme False classes kinds Nil qualified st
        other -> (mono UError, add-error sp "invalid resolved imported scheme" st)
      other -> (mono UError, add-error sp "invalid resolved imported scheme syntax" st)
  json-length :: Json -> Nat
  json-length rows = case rows of JArr row rest -> 1 + json-length rest; other -> 0
  constructor-erasure-matches :: List Bool -> Json -> Bool
  constructor-erasure-matches expected rows = case (expected, rows) of
    (Nil, JArrEnd) -> True
    (Cons first more, JArr (JBool flag) rest) -> first == flag && constructor-erasure-matches more rest
    other -> False
  ctor-in-rows :: String -> Json -> Bool
  ctor-in-rows name rows = case rows of
    JArr (JStr symbol) rest -> same name (interface-global symbol) || ctor-in-rows name rest
    other -> False
  ctor-description :: String -> Json -> Option Json
  ctor-description name rows = case rows of
    JArr row rest -> if ctor-in-rows name (field "constructors" row) then Some row
      else ctor-description name rest
    other -> None
  same-quant-kinds :: List Quant -> List Quant -> Bool
  same-quant-kinds first second = case (first, second) of
    (Nil, Nil) -> True
    (Cons a rest, Cons b more) -> kind-equal (quant-kind a) (quant-kind b) && same-quant-kinds rest more
    other -> False
  regular-imported-constructor :: Span -> String -> Scheme -> Json -> Store -> Store
  regular-imported-constructor sp owner sc description st = case imported-kinds primitive-kinds (field "parameters" description) st of
    (parameters, checked) ->
      let expected = applied-family owner (kind-arrow parameters) (scheme-params sc) in
      let result-check = unify sp (result-type (scheme-body sc)) expected (empty-store "constructor-shape") in
      if same-quant-kinds parameters (scheme-params sc) && (case store-errors result-check of Nil -> True; other -> False)
        then checked
        else add-error sp "imported constructor needs existential or indexed elaboration" checked
  check-imported-constructor :: Span -> String -> Scheme -> Json -> Store -> Store
  check-imported-constructor sp name sc metadata st =
    let sa = if scheme-arity sc == json-length (field "fields" metadata)
          && constructor-erasure-matches (constructor-field-erasure (scheme-body sc)) (field "erased" metadata) then st
          else add-error sp "imported constructor arity or erasure disagrees with its resolved scheme" st in
    case (ctor-description name (resolved-nominals metadata), root-name (result-type (scheme-body sc))) of
      (Some description, Some result) -> let owner = interface-global (case field "identity" description of JStr identity -> identity; other -> "") in
        if same owner result then regular-imported-constructor sp owner sc description sa
        else add-error sp "imported constructor returns a different defining type" sa
      other -> add-error sp "imported constructor has no defining family contract" sa
  check-imported-value :: Span -> Scheme -> Json -> Store -> Store
  check-imported-value sp sc metadata st = case field "arity" metadata of
    -- Native ABI arity includes dictionary parameters. Dependent implicit
    -- values remain unsupported by the pure scheme converter above.
    JNum arity ->
      let count = scheme-arity sc + list-length (scheme-requirements sc) in
      if arity == nat-to-int count then st else add-error sp "imported arity disagrees with its checked scheme" st
    other -> add-error sp "imported value has no arity metadata" st
  check-imported-contract :: Span -> String -> String -> Scheme -> Json -> Store -> Store
  check-imported-contract sp name category sc metadata st = if valid-type (scheme-body sc) then
    (if same category "constructor" then check-imported-constructor sp name sc metadata st else check-imported-value sp sc metadata st)
    else st
  context-total-observation :: String -> TypeContext -> Option BodyBinding
  context-total-observation name context = case context of MkTypeContext kinds aliases active observers effects source-classes -> total-observation name observers
  total-observation :: String -> List ByteObservation -> Option BodyBinding
  total-observation name observers = case observers of
    Nil -> None
    Cons (TotalObservation symbol binding) rest -> if same name symbol then Some binding else total-observation name rest
    Cons other rest -> total-observation name rest
  context-add-total :: Span -> BodyBinding -> TypeContext -> Store -> (TypeContext, Store)
  context-add-total sp binding context st = case context-total-observation (binding-name binding) context of
    Some prior -> (context, if binding-equal prior binding then st else add-error sp "conflicting defining total body declarations" st)
    None -> (case context of MkTypeContext kinds aliases active observers effects source-classes -> (MkTypeContext kinds aliases active (Cons (TotalObservation (binding-name binding) binding) observers) effects source-classes, st))
  collect-total-metadata :: Span -> String -> String -> Json -> List (String, Kind) -> TypeContext -> Store -> (TypeContext, Store)
  collect-total-metadata sp name native metadata classes kinds st = case field "keyed_ordering" metadata of
    JNull -> collect-closed-body sp name native metadata classes kinds st
    doc -> (case read-keyed-ordering native doc of
      Some function -> collect-defining-body sp name native metadata classes kinds function st
      None -> (kinds, add-error sp "invalid defining keyed ordering body" st))
  collect-defining-body :: Span -> String -> String -> Json -> List (String, Kind) -> TypeContext -> TotalFunction -> Store -> (TypeContext, Store)
  collect-defining-body sp name native metadata classes kinds function st = case imported-scheme sp classes kinds (TName sp "Int") metadata st of
    (sc, checked) -> (case check-body-binding name native "external" sc function of
      Some binding -> context-add-total sp binding kinds checked
      None -> (kinds, add-error sp "executable body disagrees with its complete defining declaration" checked))
  collect-closed-body :: Span -> String -> String -> Json -> List (String, Kind) -> TypeContext -> Store -> (TypeContext, Store)
  collect-closed-body sp name native metadata classes kinds st = case field "total_body" metadata of
    JNull -> (kinds, st)
    doc -> (case check-total-graph doc of
      Some graph -> if not (total-graph-for-roots graph [native]) then (kinds, add-error sp "total body contains unrelated definitions" st)
        else (case total-function graph native of
          Some function -> collect-defining-body sp name native metadata classes kinds function st
          None -> (kinds, add-error sp "total body has no actual defining value identity" st))
      None -> (kinds, add-error sp "invalid defining total body graph" st))
  collect-private-measures :: Span -> Json -> List (String, Kind) -> TypeContext -> Store -> (TypeContext, Store)
  collect-private-measures sp rows classes kinds st = case rows of
    JArr row rest -> (case field "identity" row of
      JStr native -> (case collect-total-metadata sp (interface-global native) native row classes kinds st of
        (more, checked) -> collect-private-measures sp rest classes more checked)
      other -> (kinds, add-error sp "defining measure has no identity" st))
    JArrEnd -> (kinds, st)
    other -> (kinds, add-error sp "invalid defining measure declarations" st)
  collect-body-contracts :: List Decl -> List (String, Kind) -> TypeContext -> Store -> (TypeContext, Store)
  collect-body-contracts ds classes kinds st = case ds of
    Nil -> (kinds, st)
    Cons (DExternal sp name category syntax metadata) rest ->
      (case collect-private-measures sp (resolved-measures metadata) classes kinds st of
        (with-private, checked) -> (case (field "total_body" metadata, field "keyed_ordering" metadata) of
          (JNull, JNull) -> collect-body-contracts rest classes with-private checked
          doc -> if not (same category "value") then (kinds, add-error sp "total bodies require actual external value declarations" checked)
            else (case field "symbol" metadata of
              JStr native -> (case collect-total-metadata sp name native metadata classes with-private checked of
                (more, done) -> collect-body-contracts rest classes more done)
              other -> (kinds, add-error sp "total body has no actual exported symbol" checked))))
    Cons (DInterface sp name hash metadata) rest -> case collect-conditional-instance-measures sp (field "instances" (field "exports" metadata)) classes kinds st of
      (more, done) -> collect-body-contracts rest classes more done
    Cons other rest -> collect-body-contracts rest classes kinds st
  observation-bindings :: List ByteObservation -> List CheckedBinding
  observation-bindings observations = case observations of
    Nil -> Nil
    Cons (TotalObservation name binding) rest -> Cons (MkBodyBinding binding) (observation-bindings rest)
    Cons other rest -> observation-bindings rest
  context-body-bindings :: TypeContext -> List CheckedBinding
  context-body-bindings context = case context of MkTypeContext kinds aliases active observers effects source-classes -> observation-bindings observers
  register-total-value :: Span -> String -> Scheme -> TypeContext -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-total-value sp name sc kinds env st = case context-total-observation name kinds of
    Some binding -> if not (binding-matches name "external" sc binding) then (env, add-error sp "actual imported value disagrees with defining total body scheme" st)
      else (case lookup-binding name env of
        Some (MkBodyBinding prior) -> (env, if binding-equal prior binding then st else add-error sp "conflicting actual body bindings" st)
        Some other -> (env, add-error sp "total body cannot replace another actual declaration" st)
        None -> (Cons (MkBodyBinding binding) env, st))
    None -> add-binding sp name sc "external" env st
  byte-length-body :: BodyBinding -> Bool
  byte-length-body binding = let wanted = (JObj "node" (JStr "primitive") (JObj "operation" (JStr "BytesLen")
    (JObj "arguments" (JArr (JObj "node" (JStr "local") (JObj "slot" (JNum 0) JObjEnd)) JArrEnd) JObjEnd))) in
    bytes-compare (canonical-bytes (total-body (binding-function binding))) (canonical-bytes wanted) == 0
  register-external :: Span -> String -> String -> TypeExpr -> Json -> List Json -> List (String, Kind) -> TypeContext -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-external sp name category ty metadata rows classes kinds env st =
    if same category "builtin" then register-kernel sp name metadata classes kinds env st
    else if same category "builtin-syntax" then register-decision-syntax sp name metadata env (check-kernel-cache sp name category ty classes kinds st)
    else if same category "builtin-constructor" then register-decision-constructor sp name metadata env (check-kernel-cache sp name category ty classes kinds st)
    else if same category "value" && (case imported-foreign-row (case field "symbol" metadata of JStr identity -> identity; other -> "") (context-aliases kinds) of Some row -> True; None -> False) then register-imported-foreign sp name ty metadata classes kinds env st
    else if same category "method" then
      case (field "class" metadata, field "slot" metadata, resolved-text metadata) of
        (JStr identity, JNum slot, Some text) -> if slot < 0 then (env, add-error sp "negative method dictionary slot" st)
          else case imported-scheme sp classes kinds ty metadata st of
            (sc, ss) -> let owner = interface-global identity in
              let checked = if method-slot-valid owner name (nat-from-int slot) rows && self-requirement owner sc then ss
                    else add-error sp "method projection disagrees with its defining signature contract" ss in
              case lookup-binding name env of
                Some prior -> (env, add-error sp "duplicate imported method" checked)
                None -> (Cons (MkMethodBinding name sc owner (nat-from-int slot)) env, checked)
        other -> (env, add-error sp "method needs a resolved dictionary contract" st)
    else if same category "value" || (same category "constructor" && (case resolved-text metadata of Some text -> True; other -> False)) then
      case imported-scheme sp classes kinds ty metadata st of
        (sc, ss) ->
          let checked = check-imported-contract sp name category sc metadata ss in
          if same category "value" && array-import-binding name kinds then register-imported-array sp name sc classes kinds env checked
          else if same category "value" && byte-length-binding name kinds then
            (if not (imported-observation-scheme name metadata kinds) then (env, add-error sp "imported byte observation foreign/value schemes disagree" checked) else case (scheme-params sc, scheme-requirements sc, scheme-body sc) of
              (Nil, Nil, UFun domain result) -> if same-type domain (primitive-type "Bytes") && same-type (predicate-base-carrier result) (primitive-type "Nat") then
                (case lookup-binding name env of
                  None -> (Cons (MkIntrinsicBinding name sc "cinch.runtime.bytesLen") env, checked)
                  Some (MkIntrinsicBinding prior-name prior-scheme prior-symbol) ->
                    if same prior-name name && same prior-symbol "cinch.runtime.bytesLen" && scheme-equivalent prior-scheme sc then (env, checked)
                    else (env, add-error sp "duplicate imported observation binding" checked)
                  Some (MkBodyBinding prior) -> if binding-matches name "external" sc prior && byte-length-body prior then
                    -- Keep the checked body for callers whose portable graphs
                    -- refer to it. Runtime reads use the independently checked
                    -- intrinsic declaration in front, not a guessed name.
                    (Cons (MkIntrinsicBinding name sc "cinch.runtime.bytesLen") env, checked)
                    else (env, add-error sp "imported byte observation body disagrees with its primitive" checked)
                  Some prior -> (env, add-error sp "duplicate imported observation binding" checked))
                else (env, add-error sp "imported byte observation disagrees with its checked value scheme" checked)
              other -> (env, add-error sp "imported byte observation requires its monomorphic pure unary scheme" checked))
          else if same category "constructor" then add-binding sp name sc "constructor" env checked
          else register-total-value sp name sc kinds env checked
    else (env, add-error sp (unsupported-import category name) st)
  self-requirement :: String -> Scheme -> Bool
  self-requirement owner sc = case scheme-requirements sc of
    Cons requirement rest -> (case root-name (requirement-type requirement) of Some name -> same name owner; None -> False)
    Nil -> False
  builtins :: List CheckedBinding
  builtins = [MkCheckedBinding "True" (mono (primitive-type "Bool")) "constructor", MkCheckedBinding "False" (mono (primitive-type "Bool")) "constructor"]

  result-type :: UType -> UType
  result-type ty = case arrow-shape ty of UPi id name a row b -> result-type b; UFun a b -> result-type b; UFunEff a row b -> result-type b; UProofFun predicate row result -> result-type result; other -> ty
  domains :: UType -> List UType
  domains ty = case arrow-shape ty of UPi id name a row b -> Cons a (domains b); UFun a b -> Cons a (domains b); UFunEff a row b -> Cons a (domains b); UProofFun predicate row result -> Cons predicate (domains result); other -> Nil
  root-name :: UType -> Option String
  root-name ty = case ty of UCon name k -> Some name; URefineFormer name ids body -> Some name; UApp f x -> root-name f; other -> None
  occurs-owner :: String -> UType -> Bool
  occurs-owner name ty = case ty of
    UCon n k -> same name n
    UApp f x -> occurs-owner name f || occurs-owner name x
    UPi id binder a row b -> occurs-owner name a || occurs-owner name row || occurs-owner name b
    UFun a b -> occurs-owner name a || occurs-owner name b
    UFunEff a row b -> occurs-owner name a || occurs-owner name b
    UUsageArrow usage arrow -> occurs-owner name arrow
    UProofFun predicate row result -> occurs-owner name predicate || occurs-owner name row || occurs-owner name result
    UTuple xs -> occurs-owner name xs
    UArg x rest -> occurs-owner name x || occurs-owner name rest
    other -> False
  positive :: String -> UType -> Bool
  positive owner ty = case ty of
    UPi id name a row b -> not (occurs-owner owner a) && positive owner b
    UFun a b -> not (occurs-owner owner a) && positive owner b
    UFunEff a row b -> not (occurs-owner owner a) && positive owner b
    UUsageArrow usage arrow -> positive owner arrow
    UProofFun predicate row result -> not (occurs-owner owner predicate || occurs-owner owner row) && positive owner result
    UApp f x -> if occurs-owner owner ty then
      (case deferral-parts ty of
        Some (row, result) -> not (occurs-owner owner row) && positive owner result
        None -> (case root-name ty of Some name -> same name owner && positive-arguments owner ty; None -> False))
      else True
    UTuple xs -> positive owner xs
    UArg x rest -> positive owner x && positive owner rest
    other -> True
  positive-arguments :: String -> UType -> Bool
  positive-arguments owner ty = case ty of UApp f x -> not (occurs-owner owner x) && positive-arguments owner f; other -> True
  check-positive :: Span -> String -> List UType -> Store -> Store
  check-positive sp owner args st = case args of Nil -> st; Cons a rest -> check-positive sp owner rest (if positive owner a then st else add-error sp "recursive field is negative or needs nested positivity evidence" st)
  applied-family :: String -> Kind -> List Quant -> UType
  applied-family name k qs = apply-quantifiers (UCon name k) qs
  apply-quantifiers :: UType -> List Quant -> UType
  apply-quantifiers head qs = case qs of Nil -> head; Cons q rest -> apply-quantifiers (UApp head (UBound (quant-id q) (quant-name q) (quant-kind q))) rest
  -- A fixed family index is not a constructor parameter. Keep explicit
  -- constructor binders, but do not quantify unused family placeholders.
  constructor-id-member :: Nat -> List Nat -> Bool
  constructor-id-member id ids = case ids of Nil -> False; Cons first rest -> id == first || constructor-id-member id rest
  constructor-parameter-member :: Nat -> List Quant -> Bool
  constructor-parameter-member id parameters = case parameters of Nil -> False; Cons first rest -> id == quant-id first || constructor-parameter-member id rest
  constructor-kind-ids :: List Quant -> List Nat
  constructor-kind-ids parameters = case parameters of Nil -> Nil; Cons first rest -> kind-free-bound (quant-kind first) <> constructor-kind-ids rest
  constructor-used-parameters :: List Quant -> List Nat -> List Quant -> List Quant
  constructor-used-parameters inherited used all = case all of
    Nil -> Nil
    Cons q rest -> if constructor-parameter-member (quant-id q) inherited && not (constructor-id-member (quant-id q) used)
      then constructor-used-parameters inherited used rest
      else Cons q (constructor-used-parameters inherited used rest)
  constructor-scheme :: List Quant -> Scheme -> Scheme
  constructor-scheme inherited sc = qualified (constructor-used-parameters inherited (type-free-bound (scheme-body sc) <> requirement-free-parameters (scheme-requirements sc) <> constructor-kind-ids (scheme-params sc)) (scheme-params sc)) (scheme-requirements sc) (scheme-body sc)
  requirement-free-parameters :: List Requirement -> List Nat
  requirement-free-parameters requirements = case requirements of Nil -> Nil; Cons first rest -> type-free-bound (requirement-type first) <> requirement-free-parameters rest
  constructor-result-arguments :: UType -> List UType -> List UType
  constructor-result-arguments result tail = case result of
    UApp function argument -> constructor-result-arguments function (Cons argument tail)
    other -> tail
  -- Only value indices may vary in a constructor's family result. Ordinary
  -- type, constructor and proposition parameters keep their declared identity.
  constructor-result-parameters :: List Quant -> List UType -> Bool
  constructor-result-parameters parameters arguments = case (parameters, arguments) of
    (Nil, Nil) -> True
    (Cons parameter rest, Cons argument tail) ->
      (case quant-kind parameter of
        KValue payload -> True
        other -> case argument of
          UBound id name kind -> id == quant-id parameter && kind-equal kind (quant-kind parameter)
          other -> False) && constructor-result-parameters rest tail
    other -> False
  register-ctors :: TypeContext -> String -> List Quant -> List (String, TypeExpr) -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-ctors kinds owner qs cs env st = case cs of
    Nil -> (env, st)
    Cons (name, ty) rest -> case make-scheme False Nil kinds qs ty st of
      (raw, ss) ->
        let sc = constructor-scheme qs raw in
        let result = result-type (scheme-body sc) in
        let shape = valid-type result && kind-equal (type-kind result) KType && (case root-name result of Some actual -> same actual owner; None -> False) in
        let sr = (if not shape then add-error (type-expr-span ty) "constructor must return its saturated declaring family" ss
          else if constructor-result-parameters qs (constructor-result-arguments result Nil) then ss
          else add-error (type-expr-span ty) "constructor result type mismatch: only value indices may differ from declaring parameters" ss) in
        let sp = check-positive (type-expr-span ty) owner (domains (scheme-body sc)) sr in
        case add-binding (type-expr-span ty) name sc "constructor" env sp of (e, se) -> register-ctors kinds owner qs rest e se
  source-effect-kind :: List Quant -> Kind
  source-effect-kind qs = case qs of Nil -> KEffect; Cons q rest -> KFun (quant-kind q) (source-effect-kind rest)
  operation-syntax :: Span -> List TypeParam -> TypeExpr -> TypeExpr
  operation-syntax sp inherited ty = case ty of
    TForall at binders body -> TForall sp (forall-param-spine sp (inherited <> forall-params-of binders)) body
    other -> case inherited of Nil -> ty; more -> TForall sp (forall-param-spine sp inherited) ty
  source-class-kinds :: List Decl -> TypeContext -> List (String, Kind) -> List (String, Kind)
  source-class-kinds ds kinds seen = case ds of
    Nil -> seen
    Cons (DClass sp name ps members) rest -> case context-kind name kinds of
      Some kind -> source-class-kinds rest kinds (Cons (name, kind) seen)
      None -> source-class-kinds rest kinds seen
    Cons other rest -> source-class-kinds rest kinds seen
  class-parameter-prefix :: Nat -> List Quant -> List Quant
  class-parameter-prefix count qs = if count == 0 then Nil else case qs of
    Nil -> Nil
    Cons first rest -> Cons first (class-parameter-prefix (count - 1) rest)
  source-class-methods :: String -> List TypeParam -> List (String, Kind) -> TypeContext -> Nat -> List Decl -> Store -> (List CoreClassMethod, Store)
  source-class-methods owner ps classes kinds slot ds st = case ds of
    Nil -> (Nil, st)
    Cons (DMethod sp label symbol syntax) rest ->
      let equation = method-equation-syntax syntax in
      let inputs = (case equation of Some declared -> law-input-type sp declared; None -> syntax) in
      (case make-scheme False classes kinds Nil (operation-syntax sp ps inputs) st of
        (sc, checked) -> let parameters = class-parameter-prefix (list-length ps) (scheme-params sc) in
          let self = applied-family owner (kind-arrow parameters) parameters in
          let actual = qualified (scheme-params sc) (Cons (MkRequirement "#self" self) (scheme-requirements sc)) (scheme-body sc) in
          let method = (case equation of
            Some declared -> MkCoreEquationMethod sp label slot actual symbol declared
            None -> MkCoreClassMethod sp label slot actual) in
          (case source-class-methods owner ps classes kinds (slot + 1) rest checked of
            (more, done) -> (Cons method more, done)))
    Cons (DFun sp name clauses) rest -> source-class-methods owner ps classes kinds slot rest st
    Cons (DLaw sp name syntax) rest -> source-class-methods owner ps classes kinds slot rest st
    Cons other rest -> source-class-methods owner ps classes kinds slot rest (add-error (decl-span other) "source signature member needs checked method elaboration" st)
  collect-source-classes :: List Decl -> List (String, Kind) -> TypeContext -> Store -> (TypeContext, Store)
  collect-source-classes ds classes kinds st = case ds of
    Nil -> (kinds, st)
    Cons (DClass sp name ps members) rest -> case parameters False kinds Nil ps 0 Nil st of
      (qs, prepared) -> case source-class-methods name ps classes kinds 0 (decls-of members) prepared of
        (methods, checked) -> let description = MkCoreClass sp name (kind-arrow qs) qs methods in
          if class-closed description then collect-source-classes rest classes (context-with-source-class description kinds) checked
          else collect-source-classes rest classes kinds (add-error sp "source signature has duplicate methods or an invalid defining scheme" checked)
    Cons other rest -> collect-source-classes rest classes kinds st
  source-method :: String -> List CoreClassMethod -> Option CoreClassMethod
  source-method name methods = case methods of
    Nil -> None
    Cons first rest -> if same name (class-method-name first) then Some first else source-method name rest
  register-source-methods :: CoreClass -> List Decl -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-source-methods description ds env st = case ds of
    Nil -> (env, st)
    Cons (DMethod sp label symbol syntax) rest -> case (source-method label (class-methods description), lookup-binding symbol env) of
      (Some method, None) -> case class-method-equation method of
        Some equation -> register-source-methods description rest env st
        None -> register-source-methods description rest (Cons (MkMethodBinding symbol (class-method-scheme method) (class-name description) (class-method-slot method)) env) st
      other -> register-source-methods description rest env (add-error sp "source method has a duplicate binding or no declaring slot" st)
    Cons (DFun sp label clauses) rest -> case source-method label (class-methods description) of
      Some (MkCoreEquationMethod at name slot telescope symbol equation) ->
        register-source-methods description rest env (add-error sp "an equality method default needs erased proof elaboration" st)
      Some member -> let name = source-class-default-symbol description member in
        (case lookup-binding name env of
          None -> register-source-methods description rest (Cons (MkCheckedBinding name (class-method-scheme member) "value") env) st
          Some previous -> register-source-methods description rest env (if scheme-equivalent (checked-scheme previous) (class-method-scheme member) then st else add-error sp "conflicting class default contract" st))
      None -> register-source-methods description rest env (add-error sp "default names an undeclared class method" st)
    Cons (DLaw sp name syntax) rest -> register-source-methods description rest env st
    Cons other rest -> register-source-methods description rest env (add-error (decl-span other) "invalid resolved source method declaration" st)
  source-class-default-symbol :: CoreClass -> CoreClassMethod -> String
  source-class-default-symbol description member = string-concat-all ["#class-default:", class-name description, ":", class-method-name member]
  source-class-default-clauses :: CoreClass -> CoreClassMethod -> List Decl -> Option (List (List Pat, Expr))
  source-class-default-clauses description member ds = case ds of
    Nil -> None
    Cons (DClass sp owner ps members) rest -> if same owner (class-name description) then
      (let declarations = decls-of members in if has-definition (class-method-name member) declarations then Some (function-clauses (class-method-name member) declarations) else None)
      else source-class-default-clauses description member rest
    Cons other rest -> source-class-default-clauses description member rest
  source-class-default-members :: CoreClass -> List Decl -> List Decl -> List String -> List Decl
  source-class-default-members description all remaining seen = case remaining of
    Nil -> Nil
    Cons (DFun sp label clauses) rest -> if has label seen then source-class-default-members description all rest seen else
      (case source-method label (class-methods description) of
        Some member -> Cons (DFun sp (source-class-default-symbol description member) (function-clauses label all)) (source-class-default-members description all rest (Cons label seen))
        None -> source-class-default-members description all rest (Cons label seen))
    Cons other rest -> source-class-default-members description all rest seen
  source-default-definitions :: List Decl -> List CoreClass -> List Decl
  source-default-definitions ds descriptions = case ds of
    Nil -> Nil
    Cons (DClass sp owner ps members) rest -> (case find-class owner descriptions of
      Some description -> let all = decls-of members in source-class-default-members description all all Nil
      None -> Nil) <> source-default-definitions rest descriptions
    Cons other rest -> source-default-definitions rest descriptions
  -- The generic default is checked independently before every instance.
  -- Recheck its already owner-resolved clauses at the specialized method
  -- contract with explicit source-binder aliases. This keeps direct self
  -- method dependencies visible to strict dictionary initialization.
  source-default-call :: String -> UType -> Nat -> Expr -> (List Pat, Expr)
  source-default-call symbol ty next call = case arrow-shape ty of
    URequire predicates body -> source-default-call symbol body next call
    UFun domain result -> source-default-call-argument symbol result next call
    UFunEff domain row result -> source-default-call-argument symbol result next call
    UProofFun predicate row result -> source-default-call-argument symbol result next call
    UPi id name domain row result -> source-default-call-argument symbol result next call
    other -> (Nil, call)
  source-default-call-argument :: String -> UType -> Nat -> Expr -> (List Pat, Expr)
  source-default-call-argument symbol result next call =
    let name = string-concat "#instance-default-argument-" (int-to-string (nat-to-int next)) in
    case source-default-call symbol result (next + 1) (EApp zero call (EVar zero name)) of
      (more, body) -> (Cons (PVar zero name) more, body)
  default-arrow-result :: Nat -> UType -> UType
  default-arrow-result count ty = if count == 0 then ty else case arrow-shape ty of
    URequire predicate body -> default-arrow-result count body
    UFun domain result -> default-arrow-result (count - 1) result
    UFunEff domain row result -> default-arrow-result (count - 1) result
    UProofFun predicate row result -> default-arrow-result (count - 1) result
    UPi id name domain row result -> default-arrow-result (count - 1) result
    other -> ty
  expand-default-clauses :: List (List Pat, Expr) -> UType -> List (List Pat, Expr)
  expand-default-clauses clauses actual = case clauses of
    Nil -> Nil
    Cons (patterns, body) rest ->
      let count = list-length patterns in
      let (more, expanded) = source-default-call "" (default-arrow-result count actual) count body in
      Cons (patterns <> more, expanded) (expand-default-clauses rest actual)
  inherited-default-clauses :: CoreClass -> CoreClassMethod -> List Decl -> Scheme -> Option (List (List Pat, Expr))
  inherited-default-clauses description member defaults actual = case source-class-default-clauses description member defaults of
    None -> None
    Some original -> Some (expand-default-clauses original (scheme-body actual))
  -- Defining source and imported bindings have distinct internal encodings.
  -- Only a resolved global or kernel identity may cross this boundary.
  portable-default-global :: String -> Option String
  portable-default-global name = case unpack name of
    Cons prefix (Cons dot rest) -> if char-code dot /= 46 then
      (if has name ["True", "False"] then Some name else None)
      else if char-code prefix == 98 then Some name
      else if char-code prefix == 109 || char-code prefix == 105 then
        (case export-global name of Ok identity -> Some (interface-global identity); Err error -> None)
      else None
    other -> None
  portable-default-method :: String -> Nat -> List CoreClassMethod -> Option String
  portable-default-method owner slot members = case members of
    Nil -> None
    Cons member rest -> if slot == class-method-slot member then
      (case export-global owner of
        Ok identity -> Some (interface-global (string-concat-all [identity, ".", class-method-name member]))
        Err error -> None)
      else portable-default-method owner slot rest
  portable-default-export-global :: List CheckedBinding -> List CoreClass -> String -> Option String
  portable-default-export-global env classes name = case lookup-binding name env of
    Some (MkMethodBinding symbol scheme owner slot) -> (case find-class owner classes of
      Some description -> portable-default-method owner slot (class-methods description)
      None -> None)
    other -> portable-default-global name
  portable-default-row :: CoreClassMethod -> Json -> Option Json
  portable-default-row member rows = case rows of
    JArr row rest -> if same (contract-text (field "name" row)) (class-method-name member)
      && (case field "slot" row of JNum slot -> slot == nat-to-int (class-method-slot member); other -> False)
      then Some row else portable-default-row member rest
    other -> None
  default-import-body :: Span -> CoreClass -> CoreClassMethod -> List Decl -> Result String (Option (List (List Pat, Expr)))
  default-import-body sp description member declarations = case find-class-row (class-name description) (class-rows declarations) of
    None -> Ok None
    Some owner -> case portable-default-row member (field "methods" owner) of
      None -> Ok None
      Some row -> case field "default" row of
        JNull -> Ok None
        syntax -> case portable-default-clauses sp portable-default-global syntax of
          Some (Cons clause rest) -> Ok (Some (Cons clause rest))
          other -> Err "imported default has unsupported or unscoped source clauses"
  checked-imported-default :: Span -> List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> CoreClass -> CoreClassMethod -> List Decl -> Scheme -> Store -> (Option (List (List Pat, Expr)), Store)
  checked-imported-default sp classes kinds families env description member defaults actual st =
    case default-import-body sp description member defaults of
      Err error -> (None, add-error sp error st)
      Ok None -> (None, st)
      Ok (Some original) ->
        let symbol = source-class-default-symbol description member in
        let binding = MkCheckedBinding symbol (class-method-scheme member) "value" in
        case check-definition-with-annotations classes kinds families (Cons binding env) sp symbol original Nil st of
          (None, failed) -> (None, failed)
          (Some generic, checked) -> case resolve-dictionary-definition-with classes (env-instances env) generic checked of
            (resolved, done) ->
              let bodies = env-body-context env in
              let guards = env-guarded-bindings env in
              let closed = seal-definition-with-checked-contracts bodies guards done resolved in
              if core-definition-checked-contracts-closed bodies guards closed then
                (Some (expand-default-clauses original (scheme-body actual)), done)
                else (None, add-error sp "imported default is not closed at its defining method scheme" done)
  source-instance-scheme :: Span -> List (String, Kind) -> TypeContext -> List TypeParam -> TypeExpr -> Store -> (Scheme, Store)
  source-instance-scheme sp classes kinds ps head-type st = case parameters False kinds Nil ps 0 Nil st of
    (qs, prepared) -> case make-scheme False classes kinds qs head-type prepared of
      (sc, checked) -> if checked-class-type classes (scheme-body sc) && contract-scheme-closed sc then (sc, checked)
        else (sc, add-error sp "source instance needs a closed saturated signature target" checked)
  register-operations :: List (String, Kind) -> TypeContext -> List TypeParam -> List (String, TypeExpr) -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-operations classes kinds ps ops env st = case ops of
    Nil -> (env, st)
    Cons (name, ty) rest -> case make-scheme False classes kinds Nil (operation-syntax (type-expr-span ty) ps ty) st of
      (sc, ss) -> case add-binding (type-expr-span ty) name sc "operation" env ss of
        (more, checked) -> register-operations classes kinds ps rest more checked
  register :: List Json -> List (String, Kind) -> TypeContext -> List Decl -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register rows classes kinds ds env st = case ds of
    Nil -> (env, st)
    Cons d rest -> case d of
      DSig s name ty -> case make-scheme False classes kinds Nil ty st of
        (sc, ss) -> case register-source-value s name sc kinds env ss of (e, se) -> register rows classes kinds rest e se
      DClass s name ps members -> case find-class name (context-source-classes kinds) of
        Some description -> case register-source-methods description (decls-of members) env st of
          (more, checked) -> register rows classes kinds rest more checked
        None -> register rows classes kinds rest env (add-error s "source signature has no checked defining contract" st)
      DInstance sp flag name ps head-type members -> case source-instance-scheme sp classes kinds ps head-type st of
        (sc, checked) -> case add-binding sp name sc (if flag then "implicit-instance" else "instance") env checked of
          (more, final) -> register rows classes kinds rest more final
      DEffect s owner ps ops -> case register-operations classes kinds ps ops env st of
        (e, se) -> register rows classes kinds rest e se
      DData s owner ps cs -> case parameters False kinds Nil ps 0 Nil st of
        (qs, sq) -> case register-ctors kinds owner qs cs env sq of (e, se) -> register rows classes kinds rest e se
      DRecord s owner ps fields -> register rows classes kinds rest env st
      DCodata s owner ps observations -> register rows classes kinds rest env st
      DForeign s direction abi symbol name ty -> case register-intrinsic s direction abi symbol name ty classes kinds env st of
        (e, se) -> register rows classes kinds rest e se
      DPrim s name ty bodies -> case make-scheme False classes kinds Nil ty st of
        (scheme, checked) -> let actual = map-scheme-types (normalize checked) scheme in
          (case (lookup-binding name env, primitive-plan name actual bodies) of
            (Some prior, result) -> register rows classes kinds rest env (add-error s "duplicate primitive binding" checked)
            (None, Err error) -> register rows classes kinds rest env (add-error s error checked)
            (None, Ok plan) -> register rows classes kinds rest (Cons (MkForeignBinding name actual plan) env) checked)
      DExternal s name category (Some ty) metadata ->
        case register-external s name category ty metadata rows classes kinds env st of (e, se) -> register rows classes kinds rest e se
      DExternal s name category None metadata -> if same category "builtin" then
        (case register-kernel s name metadata classes kinds env st of (e, se) -> register rows classes kinds rest e se)
        else if same category "builtin-constructor" then (case register-decision-constructor s name metadata env st of (e, se) -> register rows classes kinds rest e se)
        else if same category "builtin-syntax" then (case register-decision-syntax s name metadata env st of (e, se) -> register rows classes kinds rest e se)
        else if same category "type" && (case field "kind" metadata of JStr kind -> same kind "codata"; other -> False) then
          (case register-imported-codata s name classes kinds metadata env st of
            (more, checked) -> register rows classes kinds rest more checked)
        else if same category "type" || same category "signature" || same category "instance" then register rows classes kinds rest env st
        else register rows classes kinds rest env (add-error s (unsupported-import category name) st)
      DSource s name metadata -> register rows classes kinds rest env st
      DInterface s name hash metadata -> register rows classes kinds rest env st
      DFun s name clauses -> register rows classes kinds rest env st
      DProof s body -> register rows classes kinds rest env st
      DRewrite s name syntax -> register rows classes kinds rest env st
      -- Its kind was checked above. An opaque type introduces no value
      -- binding, constructor, field or closed data family.
      DOpaque s name params kind -> register rows classes kinds rest env st
      DRefine s name params binder predicate -> register rows classes kinds rest env st
      DExport s text items -> register rows classes kinds rest env st
      -- A temporal contract binds no value: it is verified after the
      -- definition it names has been elaborated (its write log and its
      -- recursion), which is the pass `temporal-contracts` runs.
      DContract s keyword name subject clauses -> register rows classes kinds rest env st
      other -> register rows classes kinds rest env (add-error (decl-span d) (unsupported-decl d) st)
  storage-observation-body :: Nat -> UType -> Option UType
  storage-observation-body remaining ty = if remaining == 0 then Some ty else
    (case ty of
      UFun observation result -> case storage-observation-body (remaining - 1) result of
        Some body -> Some (UFun (UFun (primitive-type "Unit") observation) body)
        None -> None
      other -> None)
  register-imported-codata :: Span -> String -> List (String, Kind) -> TypeContext -> Json -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-imported-codata sp owner classes kinds metadata env st =
    case field "ctors" metadata of
      JArr row JArrEnd -> case imported-scheme sp classes kinds (TUnmodeled sp "missing codata observation scheme") row st of
        (sc, checked) -> let valid = check-imported-constructor sp owner sc row checked in
          case (scheme-requirements sc, storage-observation-body (json-length (field "fields" metadata)) (scheme-body sc)) of
            (Nil, Some body) -> add-binding sp (record-storage-name True owner)
              (MkScheme (scheme-params sc) body) "constructor" env
              (check-positive sp owner (domains body) valid)
            other -> (env, add-error sp "imported codata observations need a checked observation scheme" valid)
      other -> (env, add-error sp "imported codata has no checked observation contract" st)
  register-source-value :: Span -> String -> Scheme -> TypeContext -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-source-value sp name sc kinds env st = case context-total-observation name kinds of
    Some binding -> if not (binding-matches name "value" sc binding) then (env, add-error sp "source total body disagrees with its checked defining signature" st) else
      (case lookup-binding name env of
        Some (MkBodyBinding prior) -> (env, if binding-equal prior binding then st else add-error sp "conflicting source total bodies" st)
        Some other -> (env, add-error sp "source total body cannot replace another declaration" st)
        None -> (Cons (MkBodyBinding binding) env, st))
    None -> add-binding sp name sc "value" env st
  register-intrinsic :: Span -> String -> String -> String -> String -> TypeExpr -> List (String, Kind) -> TypeContext -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-intrinsic sp direction abi symbol name syntax classes kinds env st =
    if not (same direction "import" && same abi "ccall") then (env, add-error sp "runtime intrinsic requires foreign import ccall" st)
    else case array-plan symbol of
      Some (operation, format, expected) -> register-array-intrinsic sp name symbol syntax expected classes kinds env st
      None -> register-monomorphic-intrinsic sp symbol name syntax classes kinds env st
  register-monomorphic-intrinsic :: Span -> String -> String -> TypeExpr -> List (String, Kind) -> TypeContext -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-monomorphic-intrinsic sp symbol name syntax classes kinds env st = case intrinsic-contract symbol of
      None -> register-foreign sp symbol name syntax classes kinds env st
      Some (text, external) -> case make-scheme False classes kinds Nil syntax st of
        (sc, checked) -> case (scheme-params sc, scheme-requirements sc) of
          (Nil, Nil) -> case parse-scheme symbol (string-to-bytes text) of
            Parsed expected Nil -> case convert False kinds Nil (kernel-canonical-type expected) checked of
              (ty, prepared) -> case lookup-binding name env of
                Some prior -> (env, add-error sp "duplicate intrinsic binding" prepared)
                None -> (Cons (MkIntrinsicBinding name sc symbol) env, if same symbol "cinch.runtime.bytesNew" && byte-allocation-contract (normalize prepared (scheme-body sc)) then prepared
                  else if same symbol "cinch.runtime.bytesGet" then
                    (if byte-read-contract (normalize prepared (scheme-body sc)) then prepared else add-error sp "runtime byte read refinement is not proved by its checked kernel bounds" prepared)
                  else unify sp (scheme-body sc) ty prepared)
            other -> (env, add-error sp "invalid kernel intrinsic contract" checked)
          other -> (env, add-error sp "runtime intrinsic cannot be polymorphic or constrained" checked)
  foreign-opaque-names :: List Decl -> List String
  foreign-opaque-names declarations = case declarations of
    Nil -> Nil
    Cons (DOpaque sp name params result) rest -> Cons name (foreign-opaque-names rest)
    Cons (DExternal sp name category syntax metadata) rest -> if same category "type" && (case field "kind" metadata of JStr variety -> same variety "opaque"; other -> False) then Cons name (foreign-opaque-names rest) else foreign-opaque-names rest
    Cons other rest -> foreign-opaque-names rest
  foreign-defining-owner :: List Char -> String
  foreign-defining-owner reversed = case reversed of
    Nil -> ""
    Cons first rest -> if char-code first == 46 then pack (reverse rest) else foreign-defining-owner rest
  -- Foreign display schemes deliberately carry no portable body authority.
  -- Their nominal arguments still need the actual defining opaque header,
  -- even when a client mentions only the imported function, not the type.
  -- Register its canonical identity without creating a source-visible alias,
  -- constructor, family or empty-case witness. Facades cannot redefine it.
  foreign-opaque-kinds :: Span -> String -> Json -> TypeContext -> Store -> (TypeContext, Store)
  foreign-opaque-kinds sp owner rows kinds st = case rows of
    JArr row rest -> case (field "kind" row, field "identity" row) of
      (JStr variety, JStr identity) -> if not (same variety "opaque" && same owner (foreign-defining-owner (reverse (unpack identity)))) then foreign-opaque-kinds sp owner rest kinds st else
        (case (field "ctors" row, field "fields" row) of
          (JArrEnd, JArrEnd) -> case imported-kinds kinds (field "parameters" row) st of
            (params, prepared) -> let name = interface-global identity in let expected = kind-arrow params in
              let declaration = DExternal sp name "type" None row in
              case context-kind name kinds of
                Some prior -> foreign-opaque-kinds sp owner rest (context-add-alias declaration kinds)
                  (if kind-equal prior expected then prepared else add-error sp "foreign opaque header conflicts with its defining kind" prepared)
                None -> foreign-opaque-kinds sp owner rest (context-add-alias declaration (context-add-kind name expected kinds)) prepared
          other -> foreign-opaque-kinds sp owner rest kinds (add-error sp "foreign opaque header cannot grant constructors or fields" st))
      other -> foreign-opaque-kinds sp owner rest kinds st
    JArrEnd -> (kinds, st)
    other -> (kinds, add-error sp "foreign nominal headers need an actual type table" st)
  imported-foreign-entry :: String -> String -> Json -> Option Json
  imported-foreign-entry identity owner rows = case rows of
    JArr row rest -> if (case (field "symbol" row, field "kind" row) of
      (JStr local, JStr direction) -> same identity (string-concat-all [owner, ".", local])
        && (same direction "import" || (same direction "intrinsic" && (case field "external" row of
          JStr symbol -> (case u32-wrapping-operation symbol of Some operation -> True; None -> False)
          other -> False)))
      other -> False) then Some row else imported-foreign-entry identity owner rest
    other -> None
  imported-foreign-row :: String -> List Decl -> Option Json
  imported-foreign-row identity declarations = case declarations of
    Nil -> None
    Cons (DInterface sp owner hash metadata) rest -> (case imported-foreign-entry identity owner (field "foreign" (field "exports" metadata)) of Some row -> Some row; None -> imported-foreign-row identity rest)
    Cons other rest -> imported-foreign-row identity rest
  foreign-import-nominal :: String -> List Decl -> Option String
  foreign-import-nominal identity declarations = case declarations of
    Nil -> None
    Cons (DExternal sp name category syntax metadata) rest -> if same category "type" && (case field "identity" metadata of JStr actual -> same actual identity; other -> False) then Some name else foreign-import-nominal identity rest
    Cons other rest -> foreign-import-nominal identity rest
  qualify-foreign-type :: List Decl -> TypeExpr -> TypeExpr
  qualify-foreign-type declarations syntax = case syntax of
    TName sp name -> (case foreign-import-nominal name declarations of Some actual -> TName sp actual; None -> syntax)
    TApp sp head args -> TApp sp (qualify-foreign-type declarations head) (qualify-foreign-type declarations args)
    TArg sp first rest -> TArg sp (qualify-foreign-type declarations first) (qualify-foreign-type declarations rest)
    TFun sp domain result -> TFun sp (qualify-foreign-type declarations domain) (qualify-foreign-type declarations result)
    TFunEff sp domain row result -> TFunEff sp (qualify-foreign-type declarations domain) (qualify-foreign-type declarations row) (qualify-foreign-type declarations result)
    TUsageArrow s usage arrow -> TUsageArrow s usage (qualify-foreign-type declarations arrow)
    TForall sp params body -> TForall sp params (qualify-foreign-type declarations body)
    TRow sp labels tail -> TRow sp (qualify-foreign-type declarations labels) tail
    other -> syntax
  register-imported-foreign :: Span -> String -> TypeExpr -> Json -> List (String, Kind) -> TypeContext -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-imported-foreign sp name syntax metadata classes kinds env st = case field "symbol" metadata of
    JStr identity -> case imported-foreign-row identity (context-aliases kinds) of
      None -> (env, add-error sp "imported foreign value has no defining ABI contract" st)
      Some row | (case field "kind" row of JStr category -> same category "intrinsic"; other -> False) ->
        register-imported-wrapping sp name syntax metadata row classes kinds env st
      Some row -> case (field "external" row, field "abi" row, field "resolved" metadata, field "total_body" metadata) of
        (JStr symbol, JStr abi, JNull, JNull) -> if not (same abi "ccall") then (env, add-error sp "imported foreign ABI is unsupported" st) else
          (case make-scheme False classes kinds Nil (qualify-foreign-type (context-aliases kinds) syntax) st of
            (scheme, checked) -> let actual = map-scheme-types (normalize checked) scheme in
              case foreign-plan 64 (foreign-opaque-names (context-aliases kinds)) symbol actual of
                Err error -> (env, add-error sp error checked)
                Ok plan -> case (field "symbol" row, foreign-document (case field "symbol" row of JStr local -> local; other -> "") plan) of
                  (JStr local, Ok expected) -> if bytes-compare (canonical-bytes row) (canonical-bytes expected) /= 0 then (env, add-error sp "imported foreign type and ABI contract disagree" checked) else
                    (case lookup-binding name env of
                      Some prior -> (env, add-error sp "duplicate imported foreign binding" checked)
                      None -> (Cons (MkForeignBinding name actual plan) env, check-imported-value sp actual metadata checked))
                  other -> (env, add-error sp "imported foreign contract is not representable" checked))
        other -> (env, add-error sp "foreign value cannot grant resolved total-body authority or an unchecked ABI" st)
    other -> (env, add-error sp "foreign value is missing its defining identity" st)
  register-imported-wrapping :: Span -> String -> TypeExpr -> Json -> Json -> List (String, Kind) -> TypeContext -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-imported-wrapping sp name syntax metadata row classes kinds env st =
    case (field "external" row, field "abi" row, field "effects" row, field "type" row, resolved-text metadata, field "total_body" metadata) of
      (JStr symbol, JStr abi, JStr effects, JStr foreign-type, Some checked-type, JNull) ->
        if not (same abi "ccall" && same effects "" && same foreign-type checked-type) then
          (env, add-error sp "imported wrapping intrinsic disagrees with its defining ABI" st)
        else (case imported-scheme sp classes kinds syntax metadata st of
          (actual, prepared) ->
            let word = primitive-type "U32" in
            let expected = mono (UFun word (UFun word word)) in
            if not (scheme-equivalent actual expected) then
              (env, add-error sp "imported wrapping intrinsic requires its exact U32 scheme" prepared)
            else (case lookup-binding name env of
              Some prior -> (env, add-error sp "duplicate imported wrapping intrinsic" prepared)
              None -> (Cons (MkIntrinsicBinding name actual symbol) env, check-imported-value sp actual metadata prepared)))
      other -> (env, add-error sp "incomplete imported wrapping intrinsic contract" st)
  register-foreign :: Span -> String -> String -> TypeExpr -> List (String, Kind) -> TypeContext -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-foreign sp symbol name syntax classes kinds env st = case make-scheme False classes kinds Nil syntax st of
    (scheme, checked) -> let actual = map-scheme-types (normalize checked) scheme in
      case foreign-plan 64 (foreign-opaque-names (context-aliases kinds)) symbol actual of
        Err error -> (env, add-error sp error checked)
        Ok plan -> (case lookup-binding name env of
          Some prior -> (env, add-error sp "duplicate foreign binding" checked)
          None -> (Cons (MkForeignBinding name actual plan) env, checked))
  kernel-canonical-type :: TypeExpr -> TypeExpr
  kernel-canonical-type syntax = case syntax of
    TName sp name -> if same name "List" || same name "Option" || same name "Result" then TName sp (interface-global (string-concat "Data.Core." name)) else syntax
    TForall sp qs body -> TForall sp qs (kernel-canonical-type body)
    TFun sp domain result -> TFun sp (kernel-canonical-type domain) (kernel-canonical-type result)
    TApp sp head args -> TApp sp (kernel-canonical-type head) (kernel-canonical-arguments args)
    TTuple sp fields -> TTuple sp (kernel-canonical-arguments fields)
    other -> syntax
  kernel-canonical-arguments :: TypeExpr -> TypeExpr
  kernel-canonical-arguments args = case args of TArg sp ty rest -> TArg sp (kernel-canonical-type ty) (kernel-canonical-arguments rest); other -> args
  array-quantifiers-match :: List Quant -> List Quant -> Bool
  array-quantifiers-match actual expected = case (actual, expected) of
    (Nil, Nil) -> True
    (Cons a rest, Cons b more) -> quant-id a == quant-id b && kind-equal (quant-kind a) KType && kind-equal (quant-kind b) KType && array-quantifiers-match rest more
    other -> False
  register-array-intrinsic :: Span -> String -> String -> TypeExpr -> String -> List (String, Kind) -> TypeContext -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-array-intrinsic sp name symbol syntax canonical classes kinds env st = case make-scheme False classes kinds Nil syntax st of
    (actual, checked) -> case parse-scheme symbol (string-to-bytes canonical) of
      Parsed expected Nil -> (case make-scheme False classes kinds Nil (kernel-canonical-type expected) checked of
        (wanted, ready) -> if not (array-quantifiers-match (scheme-params actual) (scheme-params wanted)) || list-length (scheme-requirements actual) /= 0 then
          (env, add-error sp "array intrinsic requires its exact polymorphic kernel scheme" ready)
          else case lookup-binding name env of
            Some prior -> (env, add-error sp "duplicate intrinsic binding" ready)
            None -> let matched = unify sp (scheme-body actual) (scheme-body wanted) ready in
              if list-length (store-errors matched) > list-length (store-errors ready) then
                (env, add-error sp "array intrinsic does not match its checked polymorphic kernel scheme" matched)
              else (Cons (MkIntrinsicBinding name actual symbol) env, matched))
      other -> (env, add-error sp "invalid array kernel intrinsic contract" checked)
  kernel-metadata :: String -> List Decl -> Option Json
  kernel-metadata name ds = case ds of
    Nil -> None
    Cons (DExternal s symbol category ty metadata) rest -> if same category "builtin" && same name symbol then Some metadata else kernel-metadata name rest
    Cons d rest -> kernel-metadata name rest
  same-kernel-fields :: List String -> Json -> Json -> Bool
  same-kernel-fields keys actual expected = case keys of
    Nil -> True
    Cons key rest -> (case (field key actual, field key expected) of
      (JStr a, JStr b) -> same a b
      (JNum a, JNum b) -> a == b
      (JBool a, JBool b) -> if a then b else not b
      other -> False) && same-kernel-fields rest actual expected
  kernel-constructor-metadata :: String -> List Decl -> Option Json
  kernel-constructor-metadata name ds = case ds of
    Nil -> None
    Cons (DExternal sp symbol category syntax metadata) rest -> if same name symbol && same category "builtin-constructor" then Some metadata else kernel-constructor-metadata name rest
    Cons other rest -> kernel-constructor-metadata name rest
  register-decision-constructor :: Span -> String -> Json -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-decision-constructor sp name metadata env st = case (decision-constructor-scheme name, kernel-constructor-metadata name builtin-declarations) of
    (Some sc, Some trusted) -> if same-kernel-fields ["name", "family", "parameter_kind", "runtime_abi", "tag", "arity", "runtime_arity", "scheme"] metadata trusted
      && (case field "erased" metadata of JArr (JBool True) JArrEnd -> True; other -> False)
      && scheme-arity sc == 1 && scheme-runtime-arity sc == 0 then add-binding sp name sc "constructor" env st
      else (env, add-error sp "decision constructor disagrees with the kernel proof/erasure contract" st)
    other -> (env, add-error sp "unknown kernel decision constructor" st)
  register-decision-syntax :: Span -> String -> Json -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-decision-syntax sp name metadata env st = if has name ["b.unrefine", "b.copyOut", "b.borrow", "b.mutBorrow", "b.refSet", "b.delay", "b.force", "b.demand", "b.Proof.search"] then register-ownership-syntax sp name metadata env st else if task-syntax-name name then register-task-syntax sp name metadata env st else if par-syntax-name name then register-par-syntax sp name metadata env st
    else if not (same name "b.decide") then (env, add-error sp "unknown kernel predicate syntax" st) else
    case builtin-syntax-metadata name of
      Some trusted -> if same-kernel-fields ["name", "operation", "runtime_abi", "first_class", "predicate_kind", "scheme"] metadata trusted then
        (case lookup-binding name env of None -> (Cons (MkSyntaxBinding name) env, st); Some prior -> (env, add-error sp "duplicate kernel predicate syntax" st))
        else (env, add-error sp "decide syntax disagrees with the kernel predicate contract" st)
      None -> (env, add-error sp "missing kernel predicate syntax contract" st)
  -- Projection consumes an actual checked refinement. The source spelling
  -- never grants authority to an ordinary local or imported function.
  register-ownership-syntax :: Span -> String -> Json -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-ownership-syntax sp name metadata env st = case builtin-syntax-metadata name of
    Some trusted -> if same-kernel-fields ["name", "operation", "arity", "variadic", "runtime_abi", "first_class"] metadata trusted then
      (case lookup-binding name env of None -> (Cons (MkSyntaxBinding name) env, st); Some prior -> (env, add-error sp "duplicate kernel ownership syntax" st))
      else (env, add-error sp "ownership syntax disagrees with its owned kernel contract" st)
    None -> (env, add-error sp "missing kernel ownership syntax contract" st)
  projection-syntax-head :: List CheckedBinding -> Expr -> Option String
  projection-syntax-head env expr = case expr of
    EVar sp name -> if has name ["b.unrefine", "b.copyOut"] then
      (case lookup-binding name env of Some (MkSyntaxBinding symbol) -> if same symbol name then Some name else None; other -> None)
      else None
    other -> None
  -- The spine is walked once by the caller, so each head check takes the head
  -- it was given instead of respining the same application.
  has-projection-head :: List CheckedBinding -> Expr -> Bool
  has-projection-head env head = case projection-syntax-head env head of Some operation -> True; None -> False
  infer-projection :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> String -> Expr -> Store -> (CoreTerm, Store)
  infer-projection classes kinds families env locals sp operation input st = case infer classes kinds families env locals input st of
    (body, checked) -> let carrier = normalize checked (core-type body) in
      if same operation "b.copyOut" then (CPrimitive sp (copy-out-type carrier) "copy-out" (CArgument sp body (CArgumentsEnd sp)), checked)
      else case refinement-view carrier of
        URefine id name base predicate -> (CForget sp base body, checked)
        other -> term-error sp "unrefine projects a refinement to its container" checked
  ownership-syntax-call :: List CheckedBinding -> Expr -> Option (String, List Expr)
  ownership-syntax-call env expr = case application-spine expr Nil of
    (EVar sp name, args) -> if has name ["b.borrow", "b.mutBorrow", "b.refSet"] then
      (case lookup-binding name env of Some (MkSyntaxBinding symbol) -> if same symbol name then Some (name, args) else None; other -> None)
      else None
    other -> None
  ownership-syntax-head :: List CheckedBinding -> Expr -> Option String
  ownership-syntax-head env head = case head of
    EVar sp name -> if has name ["b.borrow", "b.mutBorrow", "b.refSet"] then
      (case lookup-binding name env of Some (MkSyntaxBinding symbol) -> if same symbol name then Some name else None; other -> None)
      else None
    other -> None
  infer-borrow :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> String -> List Expr -> UType -> Store -> (CoreTerm, Store)
  infer-borrow classes kinds families env locals sp operation args expected st = case args of
    [input] -> let mutable = same operation "b.mutBorrow" in
      (case borrow-type-parts (normalize st expected) of
        Some (actual, region, carrier) | actual == mutable ->
          (case check classes kinds families env locals input carrier st of
            (value, ready) -> (CPrimitive sp expected (if mutable then "mut-borrow" else "borrow")
              (CArgument (expr-span input) value (CArgumentsEnd sp)), check-borrow-binding sp env expected ready))
        other -> term-error sp (if mutable then "mutBorrow needs an expected Mut region type" else "borrow needs an expected Ref region type") st)
    other -> term-error sp "borrow and mutBorrow take exactly one argument" st
  infer-ref-set :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> List Expr -> Store -> (CoreTerm, Store)
  infer-ref-set classes kinds families env locals sp args st = case args of
    [place, input] -> case infer classes kinds families env locals place st of
      (cell-term, checked) -> case mutable-borrow (normalize checked (core-type cell-term)) of
        None -> term-error (expr-span place) "refSet writes through an exclusive Mut borrow" checked
        Some (region, carrier) -> (case cell-term of
          CLocal at ty id name actuals -> (case check classes kinds families env locals input carrier checked of
            (value, ready) -> (CPrimitive sp (primitive-type "Unit") "ref-set" (CArgument at cell-term (CArgument (expr-span input) value (CArgumentsEnd sp))), ready))
          other -> term-error (expr-span place) "refSet writes through a bound Mut borrow" checked)
    other -> term-error sp "refSet takes a Mut borrow and a value" st
  thunk-syntax-operation :: List CheckedBinding -> Expr -> Option String
  thunk-syntax-operation env head = case head of
    EVar sp name -> if has name ["b.delay", "b.force"] then
      (case lookup-binding name env of Some (MkSyntaxBinding symbol) -> if same symbol name then Some name else None; other -> None)
      else None
    other -> None
  infer-thunk :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> String -> Expr -> Store -> (CoreTerm, Store)
  infer-thunk classes kinds families env locals sp operation input st = case fresh-meta KRow st of
    (row, fresh) -> case fresh-meta KType fresh of
      (result, ready) -> if same operation "b.delay" then
        (case check classes kinds families env locals input (UFunEff (primitive-type "Unit") row result) ready of
          (value, checked) -> (CPrimitive sp (thunk-type row result) "thunk-delay" (CArgument sp value (CArgumentsEnd sp)), checked))
        else case infer classes kinds families env locals input ready of
          (value, checked) -> case later-parts (normalize checked (core-type value)) of
            Some carrier -> (CPrimitive sp carrier "thunk-force" (CArgument sp value (CArgumentsEnd sp)), checked)
            None -> let expected = thunk-type row result in
              let applied = unify (expr-span input) (core-type value) expected checked in
              (CPrimitive sp result "thunk-force" (CArgument sp value (CArgumentsEnd sp)), applied)
  check-later-delay :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> UType -> Store -> (CoreTerm, Store)
  check-later-delay classes kinds families env locals sp input carrier st = case fresh-meta KRow st of
    (row, opened) -> case check classes kinds families env locals input (UFunEff (primitive-type "Unit") row carrier) opened of
      (callback, checked) ->
        let pure = unify sp row (URow UEnd) checked in
        if list-length (store-errors pure) > list-length (store-errors checked) then
          term-error sp "a `delay` building a `Later` must be pure" checked
        else (CPrimitive sp (later-type carrier) "thunk-delay" (CArgument sp callback (CArgumentsEnd sp)), pure)
  task-syntax-name :: String -> Bool
  task-syntax-name name = has name ["b.withScope", "b.spawn", "b.joinAllOrCancel"]
  -- The deterministic pure-parallelism builtins (`design/parallel-evaluation.md`
  -- sections 2.1 to 2.3). Like `spawn` they are kernel syntax rather than
  -- values: their callbacks are read literally at the call site, so a
  -- function-typed parameter or a first-class alias cannot be checked.
  par-syntax-name :: String -> Bool
  par-syntax-name name = has name ["b.parBoth", "b.parTabulate", "b.parMap"]
  par-operation :: String -> String
  par-operation name = if same name "b.parBoth" then "ParBoth"
    else if same name "b.parTabulate" then "ParTabulate"
    else "ParMap"
  -- The source spelling the diagnostics name, matching the seed's messages.
  par-spelling :: String -> String
  par-spelling name = if same name "b.parBoth" then "parBoth"
    else if same name "b.parTabulate" then "parTabulate"
    else "parMap"
  register-par-syntax :: Span -> String -> Json -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-par-syntax sp name metadata env st = case builtin-syntax-metadata name of
    Some trusted -> if same-kernel-fields ["name", "operation", "arity", "runtime_abi", "first_class", "scheme"] metadata trusted then
      (case lookup-binding name env of None -> (Cons (MkSyntaxBinding name) env, st); Some prior -> (env, add-error sp "duplicate kernel parallel syntax" st))
      else (env, add-error sp "parallel syntax disagrees with its owned kernel contract" st)
    None -> (env, add-error sp "unknown kernel parallel syntax" st)
  par-syntax-head :: List CheckedBinding -> Expr -> Bool
  par-syntax-head env expr = case application-spine expr Nil of
    (EVar sp name, args) -> par-syntax-name name && (case lookup-binding name env of Some (MkSyntaxBinding symbol) -> same name symbol; other -> False)
    other -> False
  par-syntax-at-head :: List CheckedBinding -> Expr -> Bool
  par-syntax-at-head env head = case head of
    EVar sp name -> par-syntax-name name && (case lookup-binding name env of Some (MkSyntaxBinding symbol) -> same name symbol; other -> False)
    other -> False
  register-task-syntax :: Span -> String -> Json -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-task-syntax sp name metadata env st = case builtin-syntax-metadata name of
    Some trusted -> if same-kernel-fields ["name", "operation", "arity", "variadic", "runtime_abi", "first_class"] metadata trusted then
      (case lookup-binding name env of None -> (Cons (MkSyntaxBinding name) env, st); Some prior -> (env, add-error sp "duplicate kernel task syntax" st))
      else (env, add-error sp "task syntax disagrees with its owned kernel contract" st)
    None -> (env, add-error sp "unknown kernel task syntax" st)
  task-syntax-head :: List CheckedBinding -> Expr -> Bool
  task-syntax-head env expr = case application-spine expr Nil of
    (EVar sp name, args) -> task-syntax-name name && (case lookup-binding name env of Some (MkSyntaxBinding symbol) -> same name symbol; other -> False)
    other -> False
  task-syntax-at-head :: List CheckedBinding -> Expr -> Bool
  task-syntax-at-head env head = case head of
    EVar sp name -> task-syntax-name name && (case lookup-binding name env of Some (MkSyntaxBinding symbol) -> same name symbol; other -> False)
    other -> False
  checked-kernel-cache :: Span -> TypeExpr -> Scheme -> List (String, Kind) -> TypeContext -> Store -> Store
  checked-kernel-cache sp syntax expected classes kinds st = case make-scheme False classes kinds Nil syntax st of
    (actual, checked) -> if scheme-equivalent actual expected then checked else add-error sp "cached kernel type disagrees with its owned contract" checked
  check-kernel-cache :: Span -> String -> String -> TypeExpr -> List (String, Kind) -> TypeContext -> Store -> Store
  check-kernel-cache sp name category syntax classes kinds st = if same category "builtin-constructor" then
    (case decision-constructor-scheme name of
      Some expected -> checked-kernel-cache sp syntax expected classes kinds st
      None -> add-error sp "unknown cached kernel constructor type" st)
    else case builtin-syntax-metadata name of
      Some metadata -> (case field "scheme" metadata of
        JStr text -> (case parse-scheme name (string-to-bytes text) of
          Parsed ty Nil -> (case make-scheme False classes kinds Nil (kernel-canonical-type ty) st of
            (expected, prepared) -> checked-kernel-cache sp syntax expected classes kinds prepared)
          other -> add-error sp "invalid owned kernel syntax type" st)
        other -> add-error sp "missing owned kernel syntax type" st)
      None -> add-error sp "unknown cached kernel syntax type" st
  register-kernel :: Span -> String -> Json -> List (String, Kind) -> TypeContext -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-kernel sp name metadata classes kinds env st =
    if not (has name ["b.newIO", "b.ioWrite", "b.ioRead", "b.ioSleep", "b.pollCancel"]) then (env, add-error sp (unsupported-import "builtin" name) st)
    else case kernel-metadata name builtin-declarations of
      Some trusted -> if same-kernel-fields ["name", "symbol", "operation", "arity", "runtime_abi", "fresh_region", "scheme"] metadata trusted then
        (case field "scheme" trusted of
          JStr text -> case parse-scheme name (string-to-bytes text) of
            Parsed ty Nil -> case make-scheme False classes kinds Nil (kernel-canonical-type ty) st of
              (sc, checked) -> add-binding sp name sc "builtin" env checked
            other -> (env, add-error sp "invalid kernel scheme" st)
          other -> (env, add-error sp "missing kernel scheme" st))
        else (env, add-error sp "builtin contract disagrees with the kernel" st)
      None -> (env, add-error sp "unknown kernel builtin" st)

  -- Reject mutual data recursion until SCC-wide positivity is checked.
  data-names :: List Decl -> List String
  data-names ds = case ds of Nil -> Nil; Cons (DData s name ps cs) rest -> Cons name (data-names rest); Cons d rest -> data-names rest
  type-names :: TypeExpr -> List String
  type-names ty = case ty of
    TName s name -> Cons name Nil
    TFun s a b -> type-names a <> type-names b
    TApp s f xs -> type-names f <> type-names xs
    TTuple s xs -> type-names xs
    TArg s x rest -> type-names x <> type-names rest
    TForall s qs body -> type-names body
    other -> Nil
  order-names :: Span -> List String -> List String -> List String -> Store -> Store
  order-names sp names all seen st = case names of
    Nil -> st
    Cons n rest -> order-names sp rest all seen (if has n all && not (has n seen) then add-error sp "forward data reference needs SCC positivity checking" st else st)
  order-ctors :: List (String, TypeExpr) -> List String -> List String -> Store -> Store
  order-ctors cs all seen st = case cs of Nil -> st; Cons (name, ty) rest -> order-ctors rest all seen (order-names (type-expr-span ty) (type-names ty) all seen st)
  data-order :: List Decl -> List String -> List String -> Store -> Store
  data-order ds all seen st = case ds of
    Nil -> st
    Cons (DData s name ps cs) rest -> data-order rest all (Cons name seen) (order-ctors cs all (Cons name seen) st)
    Cons d rest -> data-order rest all seen st

  term-error :: Span -> String -> Store -> (CoreTerm, Store)
  term-error sp message st = (CError sp, add-error sp message st)
  actual-types :: List (Nat, UType) -> List UType
  actual-types pairs = case pairs of Nil -> Nil; Cons (id, ty) rest -> Cons ty (actual-types rest)
  lookup-value :: Span -> String -> List CheckedBinding -> Store -> (CoreTerm, Store)
  lookup-value sp name env st = case lookup-binding name env of
    None -> term-error sp (string-concat "unbound variable or constructor: " name) st
    Some b -> case open-qualified False (checked-scheme b) st of
      (ty, requirements, pairs, ss) ->
        let evidence = case requirements of
              Nil -> Nil
              more -> needed-evidence sp (env-givens env) requirements in
        let actuals = actual-types pairs in
        case b of
          MkErasedBinding name predicate id origin invalidated -> (case invalidated of
            None -> (CProofRef sp predicate id name, ss)
            Some write -> term-error sp (stale-evidence-message origin write) ss)
          MkCheckedBinding name sc role | same role "closed-proof" ->
            term-error sp "a proof definition can only be used as erased evidence" ss
          MkSyntaxBinding symbol -> if same symbol "b.spawn" then
            term-error sp "spawn must be applied directly to check the task callback" ss
            else if par-syntax-name symbol then
              term-error sp (string-concat (par-spelling symbol) " must be applied directly to check its parallel callback (design/parallel-evaluation.md section 4.1)") ss
            else term-error sp "kernel syntax is not a first-class function" ss
          MkMethodBinding method sc owner slot -> (CMethod sp ty name owner slot actuals evidence, ss)
          MkGivenBinding source dict symbol -> (CUse sp ty symbol "dictionary" actuals, ss)
          MkLocalBinding source sc id level -> case requirements of
            Nil -> (CLocal sp ty id name actuals, ss)
            more -> term-error sp "local dictionary polymorphism needs explicit evidence" ss
          MkValueBinding source sc id level value -> (CLocal sp ty id name actuals, ss)
          MkIntrinsicBinding source sc symbol -> (CUse sp ty symbol "intrinsic" actuals, ss)
          other -> case requirements of
            Nil -> (CUse sp ty name (checked-role b) actuals, ss)
            more -> (CQualifiedUse sp ty name (checked-role b) actuals evidence, ss)
  env-givens :: List CheckedBinding -> List CoreGiven
  env-givens env = case env of
    Nil -> Nil
    Cons (MkGivenBinding name ty symbol) rest -> Cons (CGiven zero symbol ty) (env-givens rest)
    Cons (MkBodyContext context names cache) rest -> cached-givens cache
    Cons b rest -> env-givens rest
  needed-evidence :: Span -> List CoreGiven -> List Requirement -> List CoreEvidence
  needed-evidence sp scope requirements = case requirements of
    Nil -> Nil
    Cons requirement rest -> Cons (CENeeded sp (requirement-type requirement) scope) (needed-evidence sp scope rest)
  bind-requirements :: Span -> List Requirement -> List CheckedBinding -> Store -> (List CheckedBinding, List CoreGiven, Store)
  bind-requirements sp requirements env st = case requirements of
    Nil -> (env, Nil, st)
    Cons requirement rest -> case fresh-id st of
      (id, fresh) -> let symbol = string-concat "#dictionary_" (nat-to-string id) in
        let ty = requirement-type requirement in
        case bind-requirements sp rest (Cons (MkGivenBinding (requirement-name requirement) ty symbol) env) fresh of
          (bound, more, done) -> (bound, Cons (CGiven sp symbol ty) more, done)
  env-metas :: List CheckedBinding -> Store -> List Nat
  env-metas env st = case env of Nil -> Nil; Cons b rest -> scheme-metas st (checked-scheme b) <> env-metas rest st
  proof-gamma :: List CheckedBinding -> Store -> List (Nat, UType)
  proof-gamma env st = case env of
    Nil -> Nil
    Cons (MkLocalBinding name sc id level) rest -> proof-gamma-local sc id (proof-gamma rest st) st
    Cons (MkValueBinding name sc id level value) rest -> proof-gamma-local sc id (proof-gamma rest st) st
    Cons b rest -> proof-gamma rest st
  proof-gamma-local :: Scheme -> Nat -> List (Nat, UType) -> Store -> List (Nat, UType)
  proof-gamma-local sc id rest st = case (scheme-params sc, scheme-requirements sc) of
    (Nil, Nil) -> Cons (id, normalize st (scheme-body sc)) rest
    other -> rest
  proof-context :: List CheckedBinding -> Store -> ProofScope
  proof-context env st = proof-erased env st (with-guarded-bindings (env-guarded-bindings env) (with-checked-body-bindings (env-body-context env) (make-proof-scope (proof-gamma env st) (proof-values env st))))
  env-body-context :: List CheckedBinding -> BodyBindings
  env-body-context env = case env of
    Nil -> empty-body-bindings
    Cons (MkBodyContext context names cache) rest -> context
    Cons (MkBodyBinding binding) rest -> (case extend-body-bindings binding (env-body-context rest) of Some context -> context; None -> empty-body-bindings)
    Cons other rest -> env-body-context rest
  cache-body-context :: List CheckedBinding -> Store -> (List CheckedBinding, Store)
  cache-body-context env st = case check-body-bindings (env-body-bindings env) of
    Some context -> (Cons (MkBodyContext context (binding-names env) (env-cache env)) env, st)
    None -> (env, add-error zero "conflicting body contracts in proof context" st)
  -- The position of the first binding of each name in `env`.
  binding-names :: List CheckedBinding -> HashMap String Nat
  binding-names env = binding-positions env 0
  binding-positions :: List CheckedBinding -> Nat -> HashMap String Nat
  binding-positions env position = case env of
    Nil -> hash-map-empty
    Cons b rest -> hash-map-insert (checked-name b) position (binding-positions rest (position + 1))
  -- The projections of a whole environment, folded once at the seal.
  env-cache :: List CheckedBinding -> EnvCache
  env-cache env = MkEnvCache (env-instances env) (env-guarded-bindings env) (env-givens env)
  env-body-bindings :: List CheckedBinding -> List BodyBinding
  env-body-bindings env = case env of Nil -> Nil; Cons (MkBodyBinding binding) rest -> Cons binding (env-body-bindings rest); Cons other rest -> env-body-bindings rest
  proof-erased :: List CheckedBinding -> Store -> ProofScope -> ProofScope
  proof-erased env st gamma = case env of
    Nil -> gamma
    Cons (MkErasedBinding name predicate id origin None) rest -> scope-erased id (normalize st predicate) (proof-erased rest st gamma)
    Cons other rest -> proof-erased rest st gamma
  proof-values :: List CheckedBinding -> Store -> List (Nat, UType)
  proof-values env st = case env of
    Nil -> Nil
    Cons (MkValueBinding name sc id level value) rest -> case (scheme-params sc, scheme-requirements sc) of
      (Nil, Nil) -> Cons (id, normalize st value) (proof-values rest st)
      other -> proof-values rest st
    Cons binding rest -> proof-values rest st
  proof-facts :: List CheckedBinding -> List Proposition
  proof-facts env = case env of
    Nil -> Nil
    Cons (MkProofBinding origin None fact) rest -> Cons fact (proof-facts rest)
    Cons other rest -> proof-facts rest
  proof-env-after-writes :: List CheckedBinding -> List (Span, Option UType) -> Store -> List CheckedBinding
  proof-env-after-writes env writes st = case writes of
    Nil -> env
    other -> invalidate-proof-bindings (proof-context env st) env writes st
  invalidate-proof-bindings :: ProofScope -> List CheckedBinding -> List (Span, Option UType) -> Store -> List CheckedBinding
  invalidate-proof-bindings gamma env writes st = case env of
    Nil -> Nil
    Cons entry rest -> let next = invalidate-proof-bindings gamma rest writes st in
      (case entry of
        MkProofBinding origin None fact -> Cons (MkProofBinding origin (mutable-fact-write gamma writes fact) fact) next
        MkErasedBinding name predicate id origin None ->
          Cons (MkErasedBinding name predicate id origin (mutable-predicate-write writes (normalize st predicate))) next
        other -> Cons entry next)
  proof-env-after-term :: List CheckedBinding -> CoreTerm -> Store -> List CheckedBinding
  proof-env-after-term env term st = proof-env-after-writes env (core-mutable-writes (map-term-types (normalize st) term)) st
  proof-branch :: Span -> List CheckedBinding -> CoreTerm -> Bool -> Store -> List CheckedBinding
  proof-branch origin env condition positive st = let term = map-term-types (normalize st) condition in
    let introduced = (case scoped-core-branch (proof-context env st) (proof-facts env) term positive of
      Some fact -> Cons (MkProofBinding origin None fact) env
      None -> env) in
        proof-env-after-writes introduced (scoped-branch-writes term positive) st
  prepend-proof-facts :: Span -> List Proposition -> List CheckedBinding -> List CheckedBinding
  prepend-proof-facts origin facts env = case facts of
    Nil -> env
    Cons first rest -> Cons (MkProofBinding origin None first) (prepend-proof-facts origin rest env)
  proof-case-env :: Span -> List CheckedBinding -> CoreTerm -> CorePattern -> Bool -> Store -> List CheckedBinding
  proof-case-env origin env value pattern positive st = let term = map-term-types (normalize st) value in
    let introduced = scoped-core-case-facts (proof-context env st) (proof-facts env) term (map-pattern-types (normalize st) pattern) positive in
      proof-env-after-writes (prepend-proof-facts origin introduced env) (core-mutable-writes term) st
  proof-case-rest-env :: Span -> List CheckedBinding -> CoreTerm -> CorePattern -> CoreTerm -> Store -> List CheckedBinding
  proof-case-rest-env origin env value pattern body st = let checked = map-term-types (normalize st) body in
    let introduced = (scoped-core-case-rest-facts (proof-context env st) (proof-facts env) (map-term-types (normalize st) value)
      (map-pattern-types (normalize st) pattern) checked) in
        proof-env-after-writes (prepend-proof-facts origin introduced env) (guard-fallthrough-writes checked) st
  proof-let-env :: List CheckedBinding -> CheckedBinding -> Nat -> Scheme -> CoreTerm -> Store -> List CheckedBinding
  proof-let-env env binding id sc value st = let term = map-term-types (normalize st) value in
    let extended = Cons binding env in
    let introduced = (case scoped-core-let-fact (proof-context env st) (proof-facts env) id (map-scheme-types (normalize st) sc) term of
      Some fact -> Cons (MkProofBinding zero None fact) extended
      None -> extended) in
        proof-env-after-writes introduced (core-mutable-writes term) st
  stale-evidence-message :: Span -> Span -> String
  stale-evidence-message origin write = string-concat-all
    ["stale evidence: evidence derived at ", proof-position origin, " is invalidated by the write at ", proof-position write]
  proof-position :: Span -> String
  proof-position sp = string-concat-all [int-to-string (nat-to-int (span-line sp)), ":", int-to-string (nat-to-int (span-col sp))]
  stale-proof-notes :: ProofScope -> List CheckedBinding -> Store -> List (Span, Span, Proposition)
  stale-proof-notes gamma env st = case env of
    Nil -> Nil
    Cons (MkProofBinding origin (Some write) fact) rest -> Cons (origin, write, fact) (stale-proof-notes gamma rest st)
    Cons (MkErasedBinding name predicate id origin (Some write)) rest ->
      (case scoped-core-predicates gamma (UArg (normalize st predicate) UEnd) of
        Some [fact] -> Cons (origin, write, fact) (stale-proof-notes gamma rest st)
        other -> stale-proof-notes gamma rest st)
    Cons other rest -> stale-proof-notes gamma rest st
  stale-proof-message :: List CheckedBinding -> Store -> (List Proposition -> Bool) -> Option String
  stale-proof-message env st proves = stale-proof-with (proof-facts env) proves (stale-proof-notes (proof-context env st) env st)
  stale-proof-with :: List Proposition -> (List Proposition -> Bool) -> List (Span, Span, Proposition) -> Option String
  stale-proof-with live proves notes = case notes of
    Nil -> None
    Cons (origin, write, fact) rest -> if proves (Cons fact live) then Some (stale-evidence-message origin write)
      else stale-proof-with live proves rest
  mapped-local :: Nat -> List (Nat, UType) -> Option UType
  mapped-local id pairs = case pairs of Nil -> None; Cons (n, ty) rest -> if id == n then Some ty else mapped-local id rest
  opened-locals :: List Quant -> List (Nat, UType) -> List (String, UType)
  opened-locals qs pairs = case qs of
    Nil -> Nil
    Cons q rest -> case mapped-local (quant-id q) pairs of Some ty -> Cons (quant-name q, ty) (opened-locals rest pairs); None -> opened-locals rest pairs

  decision-syntax-head :: List CheckedBinding -> Expr -> Bool
  decision-syntax-head env expression = case expression of
    -- A syntax binding is named by its own symbol, so only `b.decide` can
    -- find one; other heads skip the environment scan.
    EVar sp name -> same name "b.decide" && (case lookup-binding name env of Some (MkSyntaxBinding symbol) -> same symbol "b.decide"; other -> False)
    other -> False
  decision-boolean :: Span -> Bool -> CoreTerm
  decision-boolean sp value = CPrimitive sp (primitive-type "Bool") (if value then "decision-true" else "decision-false") (CArgumentsEnd sp)
  decision-call-name :: Expr -> Option String
  decision-call-name expression = case expression of
    EVar sp name -> Some name
    EApp sp function argument -> decision-call-name function
    EAnn sp value annotation -> decision-call-name value
    other -> None
  decision-copy-out :: List CheckedBinding -> Expr -> Bool
  decision-copy-out env function = case projection-syntax-head env function of
    Some operation -> same operation "b.copyOut"
    None -> False
  decision-hint :: List CheckedBinding -> Expr -> Option UType
  decision-hint env expression = case expression of
    EVar sp name -> (case lookup-binding name env of Some binding -> let carrier = predicate-base-carrier (scheme-body (checked-scheme binding)) in if integer-carrier carrier then Some carrier else None; None -> None)
    EAnn sp value (TName at name) -> if primitive name && integer-carrier (primitive-type name) then Some (primitive-type name) else decision-hint env value
    EBin sp operation left right -> (case decision-hint env left of Some carrier -> Some carrier; None -> decision-hint env right)
    ENeg sp input -> decision-hint env input
    EApp sp function (EVar at name) | decision-copy-out env function -> (case lookup-binding name env of
      Some binding -> (case borrowed-carrier (scheme-body (checked-scheme binding)) of
        Some carrier -> if integer-carrier carrier then Some carrier else None
        None -> None)
      None -> None)
    EApp sp function input -> (case decision-call-name function of
      None -> None
      Some name -> case lookup-binding name env of
        Some (MkIntrinsicBinding display sc symbol) -> if same symbol "cinch.runtime.bytesLen" then Some (primitive-type "Nat") else None
        Some (MkBodyBinding binding) -> Some (primitive-type (total-result (binding-function binding)))
        other -> None)
    other -> None
  decision-carrier :: List CheckedBinding -> Expr -> Expr -> UType
  decision-carrier env first second = case decision-hint env first of Some carrier -> carrier; None -> (case decision-hint env second of Some carrier -> carrier; None -> primitive-type "Int")
  decision-value :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> UType -> Expr -> Store -> (CoreTerm, Store)
  decision-value classes kinds families env locals carrier syntax st = case syntax of
    ELitInt sp text -> checked-literal sp carrier text st
    ENeg sp (ELitInt at text) -> checked-literal sp carrier (string-concat "-" text) st
    ENeg sp input -> if not (same-type carrier (primitive-type "Int")) then term-error sp "decision negation needs mathematical Int semantics" st else
      (case decision-value classes kinds families env locals carrier input st of (value, done) -> (CPrimitive sp carrier "negate" (CArgument sp value (CArgumentsEnd sp)), done))
    EBin sp operation first second -> if not (has operation ["+", "-", "*"] && math-carrier carrier) then term-error sp "decision arithmetic needs checked mathematical semantics" st else
      (case decision-value classes kinds families env locals carrier first st of
        (left, sl) -> case decision-value classes kinds families env locals carrier second sl of
          (right, sr) -> let body = CPrimitive sp carrier operation (CArgument sp left (CArgument sp right (CArgumentsEnd sp))) in
            if same operation "-" && same-type carrier (primitive-type "Nat") then
              (case scoped-prove-subtraction (proof-context env sr) (proof-facts env) (map-term-types (normalize sr) left) (map-term-types (normalize sr) right) of
                Some certificate -> (CProved sp carrier certificate body, sr)
                None -> term-error sp "decision Nat subtraction needs checked ordering evidence" sr)
            else (body, sr))
    EAnn sp value annotation -> (case convert False kinds (value-locals env locals) annotation st of
      (actual, checked) -> decision-value classes kinds families env locals carrier value (unify sp carrier actual (expect-type sp actual checked)))
    EVar sp name -> (case lookup-binding name env of
      Some (MkLocalBinding display sc id level) -> decision-local sp name carrier env st
      Some (MkValueBinding display sc id level index) -> decision-local sp name carrier env st
      other -> term-error sp "decision operands need actual scoped numeric values" st)
    EApp sp function input -> (case decision-call-name function of
      None -> term-error sp "decision calls need checked pure total body authority" st
      Some name -> if not (decision-copy-out env function || byte-length-binding name kinds || (case context-total-observation name kinds of Some binding -> True; None -> False)) then term-error sp "decision calls need checked pure total body authority" st else
        (case infer classes kinds families env locals syntax st of
          (value, checked) -> let projected = project-comparison sp value checked in (projected, unify sp carrier (core-type projected) checked)))
    other -> term-error (expr-span syntax) "decision operands need checked pure total reification" st
  decision-local :: Span -> String -> UType -> List CheckedBinding -> Store -> (CoreTerm, Store)
  decision-local sp name carrier env st = case lookup-value sp name env st of
    (value, checked) -> let projected = project-comparison sp value checked in
      (projected, if integer-carrier (normalize checked (core-type projected)) then unify sp carrier (core-type projected) checked else add-error sp "decision operand is not a numeric runtime value" checked)
  decision-index :: Span -> List CheckedBinding -> UType -> CoreTerm -> Store -> (UType, Store)
  decision-index sp env carrier value st = case reify-argument sp env (map-term-types (normalize st) value) st of
    (index, checked) -> predicate-index-value sp (if same-type carrier (primitive-type "Nat") then primitive-type "Nat" else primitive-type "Int") index checked
  decision-failure :: Span -> String -> Store -> (UType, CoreTerm, Store)
  decision-failure sp message st = (UError, CError sp, add-error sp message st)
  decision-predicate :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> Store -> (UType, CoreTerm, Store)
  decision-predicate classes kinds families env locals syntax st = case syntax of
    ECon sp name (EArgsEnd end) -> if same name "True" || same name "False" then (UPropLit (same name "True"), decision-boolean sp (same name "True"), st) else decision-failure sp "predicate needs an executable checked decision procedure" st
    ECon sp name (EArg at input (EArgsEnd end)) -> decision-unary classes kinds families env locals sp name input st
    EApp sp (ECon at name (EArgsEnd end)) input -> decision-unary classes kinds families env locals sp name input st
    EApp sp (EVar at name) input -> if same name "Not" then decision-unary classes kinds families env locals sp name input st else decision-failure sp "predicate calls need checked decision authority" st
    EIf sp first second (ECon at name (EArgsEnd end)) -> if same name "False" then decision-predicate classes kinds families env locals (EBin sp "&&" first second) st
      else (case second of
        ECon yes literal (EArgsEnd done) -> if same literal "True" then decision-predicate classes kinds families env locals (EBin sp "||" first (ECon at name (EArgsEnd end))) st else decision-failure sp "conditional predicate needs checked logical form" st
        other -> decision-failure sp "conditional predicate needs checked logical form" st)
    EIf sp first (ECon at name (EArgsEnd end)) third -> if same name "True" then decision-predicate classes kinds families env locals (EBin sp "||" first third) st else decision-failure sp "conditional predicate needs checked logical form" st
    EBin sp operation first second -> if same operation "&&" || same operation "||" then
      (case decision-predicate classes kinds families env locals first st of
        (left, test, checked) -> case decision-predicate classes kinds families (proof-branch (expr-span first) env test (same operation "&&") checked) locals second checked of
          (right, other, done) -> if same operation "&&" then (UPropAnd left right, CIf sp (primitive-type "Bool") test other (decision-boolean sp False), done)
            else (UPropOr left right, CIf sp (primitive-type "Bool") test (decision-boolean sp True) other, done))
      else if has operation ["<", "<=", ">", ">=", "==", "/="] then
        (let carrier = decision-carrier env first second in
         case decision-value classes kinds families env locals carrier first st of
           (left, sl) -> case decision-value classes kinds families env locals carrier second sl of
             (right, sr) -> case decision-index sp env carrier left sr of
               (x, sx) -> case decision-index sp env carrier right sx of
                 (y, done) -> (UCompare operation x y, CPrimitive sp (primitive-type "Bool") operation (CArgument sp left (CArgument sp right (CArgumentsEnd sp))), done))
      else decision-failure sp "predicate operator has no checked decision semantics" st
    other -> decision-failure (expr-span syntax) "predicate needs an executable checked decision procedure" st
  decision-unary :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> String -> Expr -> Store -> (UType, CoreTerm, Store)
  decision-unary classes kinds families env locals sp name input st =
    if same name "Not" then (case decision-predicate classes kinds families env locals input st of
      (predicate, condition, done) -> (UPropNot predicate, CIf sp (primitive-type "Bool") condition (decision-boolean sp False) (decision-boolean sp True), done))
    else if same name "NonZero" then
      (let carrier = decision-carrier env input input in
       case decision-value classes kinds families env locals carrier input st of
         (value, checked) -> case decision-index sp env carrier value checked of
           (index, done) -> (UPropNonZero index, CPrimitive sp (primitive-type "Bool") "/=" (CArgument sp value (CArgument sp (CInt sp carrier "0") (CArgumentsEnd sp))), done))
    else if same name "NotNull" then decision-not-null classes kinds families env locals sp input st
    -- `Ascii` and `Ordered` are refinements the checker decides statically
    -- over constructor forms; a runtime `decide` needs a recursive scan
    -- whose result is a proof, which this tier does not build yet. Refused
    -- by name, never guessed at.
    else if same name "Ascii" then decision-failure sp "`decide (Ascii ...)` needs a checked recursive scan over the value, which this tier does not build: discharge `Ascii` statically (a constructor form) or carry it as a refinement predicate" st
    else if same name "Ordered" then decision-failure sp "`decide (Ordered ...)` needs a checked recursive scan over the value, which this tier does not build: discharge `Ordered` statically (a constructor form) or carry it as a refinement predicate" st
    else decision-failure sp "unknown executable predicate former" st
  decision-not-null :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Store -> (UType, CoreTerm, Store)
  decision-not-null classes kinds families env locals sp input st = case fresh-meta KType st of
    (element, opened) -> let list = collection-list element in
      case check classes kinds families env locals input list opened of
        (value, checked) -> case reify-argument sp env (map-term-types (normalize checked) value) checked of
          (index, indexed) -> case bind-pattern classes kinds families env locals (PCon sp (global-data-core-nil) (PArgsEnd sp)) list indexed of
            (empty-scope, empty, matched) ->
              let cons = PCon sp (global-data-core-cons) (pat-spine sp [PWild sp, PWild sp]) in
              case bind-pattern classes kinds families env locals cons list matched of
                (nonempty-scope, nonempty, done) ->
                  let branches = CAlternative sp empty (decision-boolean sp False) (CAlternative sp nonempty (decision-boolean sp True) (CAlternativesEnd sp)) in
                  (UPropNotNull index, CCase sp (primitive-type "Bool") value branches, done)
  infer-decision :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Store -> (CoreTerm, Store)
  infer-decision classes kinds families env locals sp syntax st = case decision-predicate classes kinds families env locals syntax st of
    (predicate, condition, checked) -> let p = normalize checked predicate in let test = map-term-types (normalize checked) condition in let ty = decision-type p in
      if scoped-decision-valid (proof-context env checked) (proof-facts env) ty p test then (CDecision sp ty p test, checked)
      else term-error sp "decision test does not establish its scoped predicate" checked

  infer-decision-expected :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> UType -> Store -> (CoreTerm, Store)
  infer-decision-expected classes kinds families env locals sp syntax expected st = case infer-decision classes kinds families env locals sp syntax st of
    (term, checked) -> case (normalize checked expected, term) of
      (UApp (UCon name kind) predicate, CDecision at ty inferred condition) -> if same name "b.Dec" && scoped-decision-valid (proof-context env checked) (proof-facts env) (normalize checked expected) predicate condition then
        (CDecision sp (normalize checked expected) predicate condition, checked) else (term, checked)
      other -> (term, checked)

  collection-list :: UType -> UType
  collection-list element = UApp (UCon (global-data-core-list) (KFun KType KType)) element
  raw-collection :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> UType -> Store -> (CoreTerm, Store)
  raw-collection classes kinds families env locals sp fields element st = let list = collection-list element in case fields of
    EArgsEnd at -> (case lookup-value at (global-data-core-nil) env st of
      (nil, checked) -> (nil, unify at (core-type nil) list checked))
    EArg at first rest -> (case check classes kinds families env locals first element st of
      (value, checked) -> (case raw-collection classes kinds families env locals sp rest element checked of
        (more, next) -> (case lookup-value at (global-data-core-cons) env next of
          (cons, ready) -> let shaped = unify at (core-type cons) (UFun element (UFun list list)) ready in
            (CApply at list (CApply at (UFun list list) cons value) more, shaped))))
    other -> term-error sp "invalid collection literal element spine" st
  infer-collection :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Option UType -> Store -> (CoreTerm, Store)
  infer-collection classes kinds families env locals sp fields expected st = case fresh-meta KType st of
    (element, fresh) -> (case (case expected of Some ty -> (ty, fresh); None -> fresh-meta KType fresh) of
      (result, next) -> (case lookup-value sp (global-data-fromlist-fromlist-from-list) env next of
        (method, opened) -> let shaped = unify sp (core-type method) (UFun (collection-list element) result) opened in
          (case method of
            CMethod at ty name owner slot actuals (Cons needed Nil) -> if not (same name (global-data-fromlist-fromlist-from-list) && same owner (global-data-fromlist-fromlist)) then term-error sp "collection literal needs its actual defining FromList method" shaped
              else (case raw-collection classes kinds families env locals sp fields element shaped of
                (items, checked) -> (CApply sp result method items, checked))
            other -> term-error sp "collection literal has no checked FromList declaration" shaped)))

  -- A typed quotation `[| e |]` (modules specification section 7) has type
  -- `Code t`, where `t` is the template's type. The template is checked in a
  -- closed scope: it may not capture the enclosing locals (decision D43),
  -- because the code it becomes must be meaningful wherever it lands. Its
  -- effects stay latent in the code (decision D44) and are checked at
  -- ordinary rules when the code is spliced into declarations.
  --
  -- A splice inside the template is a compile-time hole: its expression is
  -- elaborated in the enclosing (stage) scope, and its type must be a `Code`
  -- whose carrier is what the hole stands for.
  infer-quotation :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Option UType -> Store -> (CoreTerm, Store)
  infer-quotation classes kinds families env locals sp body expected st =
    let (element, fresh) = case expected of
          Some wanted -> (case normalize st wanted of
            UApp (UCon name _) carrier -> if same name global-stage-code then (carrier, st) else fresh-meta KType st
            other -> fresh-meta KType st)
          None -> fresh-meta KType st in
    case quote-splice-types classes kinds families env locals body fresh of
      Err message -> term-error sp message fresh
      -- The template is checked, but a quotation is compile-time data with no
      -- runtime representation, so there is no term to hand the backend. The
      -- expander reads the template off the checked surface and fills its
      -- splices where the code lands, so the placeholder never reaches
      -- emission: a stage declaration is dropped from the runtime program.
      Ok (holes, checked) -> (CError sp, checked)
  -- Every splice in a template, in the order the template writes them. A
  -- splice whose expression is not `Code t` is refused by name, and so is one
  -- whose stage differs from the quotation's.
  quote-splice-types :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> Store -> Result String (List (Span, String), Store)
  quote-splice-types classes kinds families env locals body st = quote-splice-walk classes kinds families env locals body Nil st


  quote-splice-walk :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> List (Span, String) -> Store -> Result String (List (Span, String), Store)
  quote-splice-walk classes kinds families env locals expression found st = case expression of
    ESplice at inner -> (case infer classes kinds families env locals inner st of
      (term, opened) -> case normalize opened (core-type term) of
        UApp (UCon name _) carrier -> if same name global-stage-code then Ok (Cons (at, "code") found, opened)
          else Err (string-concat "a splice must produce `Code t`, but this one produces " (law-domain-text (core-type term)))
        other -> Err (string-concat "a splice must produce `Code t`, but this one produces " (law-domain-text other)))
    _ -> Ok (found, st)

  refinement-constructor-arguments :: TypeContext -> List TypeParam -> List (String, UType) -> UType -> Store -> (UType, Store)
  refinement-constructor-arguments kinds parameters earlier head st = case parameters of
    Nil -> (head, st)
    Cons parameter rest -> let (kind, checked) = case param-kind parameter of None -> (KType, st); Some annotation -> kind-of False kinds earlier annotation st in
      (case fresh-meta kind checked of
        (actual, opened) -> refinement-constructor-arguments kinds rest (Cons (param-name parameter, actual) earlier) (UApp head actual) opened)
  refinement-constructor :: Span -> TypeContext -> String -> Store -> (CoreTerm, Store)
  refinement-constructor sp kinds name st = case (find-refinement name (context-aliases kinds), context-kind name kinds) of
    (Some (DRefine at owner parameters binder predicate), Some kind) -> (case refinement-constructor-arguments kinds parameters Nil (UCon name kind) st of
      (applied, opened) -> (case unfold-refinement sp kinds applied opened of
        (refined, checked) -> (case refinement-view (normalize checked refined) of
          URefine id display carrier condition -> (case fresh-for-types [refined] checked of
            (argument, fresh) -> (case fresh-id fresh of
              (local, next) -> (case fresh-id next of
                (proof-id, ready) ->
                  let row = URow UEnd in
                  let formal = UIndex carrier (IBound argument "#refinement-value") in
                  let actual = UIndex carrier (IRigid local "#refinement-value" (store-level ready)) in
                  let required = substitute-bound [(id, formal)] condition in
                  let opened-required = substitute-bound [(id, actual)] condition in
                  let ty = UPi argument "#refinement-value" carrier row (UProofFun required row refined) in
                  let payload = CLocal sp carrier local "#refinement-value" Nil in
                  let witness = CProofRef sp opened-required proof-id "#refinement-proof" in
                  let body = CRefineProof sp refined witness payload in
                  (CLambda sp ty (CPVar sp carrier local "#refinement-value")
                    (CLambda sp (UProofFun opened-required row refined) (CPProof sp opened-required proof-id "#refinement-proof") body), ready))))
          other -> term-error sp "named refinement has no checked constructor template" checked)))
    other -> term-error sp "transparent constructor needs its actual defining refinement" st
  lookup-expression-value :: Span -> TypeContext -> String -> List CheckedBinding -> Store -> (CoreTerm, Store)
  lookup-expression-value sp kinds name env st = case lookup-binding name env of
    Some (MkMemoBinding source ty id) -> let cell = CLocal sp ty id source Nil in
      let borrowed = memo-demand-term sp (normalize st ty) cell in
      (CPrimitive sp (copy-out-type (core-type borrowed)) "copy-out" (CArgument sp borrowed (CArgumentsEnd sp)), st)
    Some binding -> lookup-value sp name env st
    None -> case find-refinement name (context-aliases kinds) of
      Some declaration -> refinement-constructor sp kinds name st
      None -> if codata-name name (context-aliases kinds) then
        term-error sp "a codata value must use its observed construction form" st
        else lookup-value sp name env st

  infer :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> Store -> (CoreTerm, Store)
  infer classes kinds families env locals expr st = case expr of
    ERecord sp name fields -> infer-record-construction classes kinds families env locals sp name fields None st
    EProject sp value label -> infer-record-projection classes kinds families env locals sp value label st
    EVar s name -> case lookup-expression-value s kinds name env st of (term, checked) -> discharge-call classes s env term checked
    ECon sp name (EArg at input (EArgsEnd end)) | has name ["#condition.NonZero", "#condition.NotNull"] ->
      let former = if same name "#condition.NonZero" then "NonZero" else "NotNull" in
      (case decision-unary classes kinds families env locals sp former input st of
        (predicate, test, checked) -> (test, checked))
    ECon s name args -> case lookup-expression-value s kinds name env st of (term, sn) -> infer-arguments classes kinds families env locals term args sn
    EList s args -> infer-collection classes kinds families env locals s args None st
    EQuote sp body -> infer-quotation classes kinds families env locals sp body None st
    -- A macro call reaches the elaborator only when expansion did not run,
    -- so it is refused by name rather than typed as anything.
    EMacroCall sp path tokens -> term-error sp "a macro invocation requires compile-time expansion" st
    ELitInt s text -> checked-literal s (primitive-type "Int") text st
    ELitStr s text -> (CString s (literal-type kinds "String") text, st)
    ELitChar s text -> (CChar s (primitive-type "Char") text, st)
    EUnit s -> (CUnit s (primitive-type "Unit"), st)
    EApp s f x | memo-demand-head env f -> infer-memo-demand classes kinds families env locals s x st
    EApp s f x -> case thunk-syntax-operation env f of
      Some operation -> infer-thunk classes kinds families env locals s operation x st
      None -> case ownership-syntax-call env expr of
        Some (operation, args) -> if same operation "b.refSet" then infer-ref-set classes kinds families env locals s args st
          else infer-borrow classes kinds families env locals s operation args UError st
        None -> case projection-syntax-head env f of
          Some operation -> infer-projection classes kinds families env locals s operation x st
          None -> if task-syntax-head env expr then infer-task-application classes kinds families env locals s expr None st else if par-syntax-head env expr then infer-par-application classes kinds families env locals s expr None st else if decision-syntax-head env f then infer-decision classes kinds families env locals s x st else
            (case infer classes kinds families env locals f st of
              (fun, sf) -> apply-argument classes kinds families env locals s fun x sf)
    ELam s ps body -> case infer-lambda classes kinds families env locals ps body (duplicate-names s (patterns-names ps) Nil st) of
      (term, ss) -> (term, ensure-coverage s families env (take-types (list-length ps) (domains (normalize ss (core-type term)))) [ps] ss)
    EDo sp statements -> (case fresh-meta KType st of (result, ready) -> check-do classes kinds families env locals sp statements result ready)
    ELet s bindings body -> infer-let classes kinds families env locals s bindings body st
    ELetScope sp body -> scoped-let sp (infer classes kinds families env locals body) st
    ELocalGroup sp bindings body -> infer-local-group classes kinds families env locals sp bindings body None st
    ELetRec sp bindings body -> scoped-let sp (infer-recursive-group classes kinds families env locals sp bindings body None) st
    EWith s bindings body -> infer-with classes kinds families env locals bindings body None st
    EHandle sp body handled-by -> infer-handle classes kinds families env locals sp body handled-by st
    EHandler sp label clauses -> case fresh-meta KType st of
      (input, next) -> case fresh-meta KType next of
        (output, done) -> infer-source-handler classes kinds families env locals sp label clauses input output done
    EIf s condition yes no -> case fresh-meta KType st of
      (ty, ss) -> case check classes kinds families env locals condition (primitive-type "Bool") ss of
        (c, sc) -> case check classes kinds families (proof-branch (expr-span condition) env c True sc) locals yes ty sc of
          (a, sa) -> case check classes kinds families (proof-branch (expr-span condition) env c False sa) locals no ty sa of
            (b, sb) -> (CIf s ty c a b, sb)
    ECase s value alts -> case infer classes kinds families env locals value st of
      (scrut, sv) -> case fresh-meta KType sv of
        (out, so) -> case check-alternatives classes kinds families (proof-env-after-term env scrut so) locals scrut out alts (ensure-match-coverage s families env (core-type scrut) alts so) of
          (alternatives, ss) -> (CCase s out scrut alternatives, ss)
    ETuple s args -> case infer-fields classes kinds families env locals args st of
      (types, terms, ss) -> (CTuple s (tuple-type types) terms, ss)
    EAnn s body (TForall at binders annotation) -> infer-forall-annotation classes kinds families env locals s body binders annotation st
    EAnn s body annotation -> case convert False kinds (value-locals env locals) annotation st of
      (ty, ss) -> check classes kinds families env locals body ty (expect-type s ty ss)
    ENeg s value -> case check classes kinds families env locals value (primitive-type "Int") st of
      (term, ss) -> (CPrimitive s (primitive-type "Int") "negate" (CArgument s term (CArgumentsEnd s)), ss)
    EBin s op a b -> infer-operator classes kinds families env locals s op a b st
    other -> term-error (expr-span expr) "expression needs effect, dictionary or dependent elaboration" st
  check :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> UType -> Store -> (CoreTerm, Store)
  check classes kinds families env locals expr expected st = case expr of
    ELetScope sp body -> scoped-let sp (check classes kinds families env locals body expected) st
    ELetRec sp bindings body -> scoped-let sp (infer-recursive-group classes kinds families env locals sp bindings body (Some expected)) st
    other -> (case refinement-view (normalize st expected) of
      URefine id name carrier predicate -> check-refined classes kinds families env locals expr expected carrier st
      other -> case type-kind other of
        -- A goal in proposition position takes a proof term, not a value:
        -- `same value = case value of True -> refl; False -> refl` returns
        -- `refl` from each branch of a proof former, and the seed elaborates
        -- that body as evidence. A value expression is still checked the
        -- ordinary way so a genuine type error keeps its own message.
        KProp -> case proof-goal classes kinds families env locals expr other st of
          Some elaborated -> elaborated
          None -> check-unrefined classes kinds families env locals expr expected st
        kind -> check-unrefined classes kinds families env locals expr expected st)
  scoped-let :: Span -> (Store -> (CoreTerm, Store)) -> Store -> (CoreTerm, Store)
  scoped-let sp elaborate st =
    let depth = store-let-depth st in
    if depth >= 128 then term-error sp "let nesting depth limit (128) exceeded" st
    else case elaborate (with-let-depth (depth + 1) st) of
      (term, checked) -> (term, with-let-depth depth checked)
  check-unrefined :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> UType -> Store -> (CoreTerm, Store)
  check-unrefined classes kinds families env locals expr expected st = case expr of
    EDo sp statements -> check-do classes kinds families env locals sp statements expected st
    ELet sp bindings body -> infer-let-with-expected classes kinds families env locals sp bindings body (Some expected) st
    ELocalGroup sp bindings body -> infer-local-group classes kinds families env locals sp bindings body (Some expected) st
    EGuarded sp guard body -> check-alt-body classes kinds families env locals expr expected st
    ETuple sp fields -> (case normalize st expected of
      UTuple types -> (case check-tuple-elements classes kinds families env locals sp fields types st of (values, checked) -> (CTuple sp expected values, checked))
      UMeta id KType -> (case fresh-tuple-elements sp fields st of
        (types, opened) -> let shaped = unify sp expected (UTuple types) opened in
          (case check-tuple-elements classes kinds families env locals sp fields types shaped of
            (values, checked) -> (CTuple sp expected values, checked)))
      other -> check-inferred classes kinds families env locals expr expected st)
    EList s args -> infer-collection classes kinds families env locals s args (Some expected) st
    EQuote sp body -> infer-quotation classes kinds families env locals sp body (Some expected) st
    EMacroCall sp path tokens -> term-error sp "a macro invocation requires compile-time expansion" st
    EIf s condition yes no -> case check classes kinds families env locals condition (primitive-type "Bool") st of
      (c, sc) -> case check classes kinds families (proof-branch (expr-span condition) env c True sc) locals yes expected sc of
        (a, sa) -> case check classes kinds families (proof-branch (expr-span condition) env c False sa) locals no expected sa of
          (b, sb) -> (CIf s expected c a b, sb)
    ECase s value alternatives -> case infer classes kinds families env locals value st of
      (scrutinee, checked) -> case check-alternatives classes kinds families (proof-env-after-term env scrutinee checked) locals scrutinee expected alternatives (ensure-match-coverage s families env (core-type scrutinee) alternatives checked) of
        (branches, done) -> (CCase s expected scrutinee branches, done)
    ELitInt s text -> check-contextual-literal s expected text st
    ENeg s (ELitInt at text) -> check-contextual-literal s expected (string-concat "-" text) st
    ELam s ps body -> case check-lambda classes kinds families env locals ps body expected (duplicate-names s (patterns-names ps) Nil st) of
      (term, ss) -> (term, ensure-coverage s families env (take-types (list-length ps) (domains (normalize ss expected))) [ps] ss)
    EWith s bindings body -> infer-with classes kinds families env locals bindings body (Some expected) st
    other -> check-inferred classes kinds families env locals expr expected st
  check-contextual-literal :: Span -> UType -> String -> Store -> (CoreTerm, Store)
  check-contextual-literal sp expected text st =
    let carrier = normalize st expected in
    if number-literal-carrier carrier || (case carrier of UMeta id KType -> True; other -> False) then
      checked-literal sp expected text st
    else term-error sp (string-concat "type mismatch: integer literal cannot have type " (literal-carrier-name carrier)) st
  literal-carrier-name :: UType -> String
  literal-carrier-name carrier = let rendered = law-domain-text carrier in case root-name carrier of
    Some symbol -> let name = diagnostic-member-name symbol in
      if same name rendered then name else string-concat-all [name, " (", rendered, ")"]
    None -> rendered
  -- An expected tuple metavariable gets a structural skeleton before its
  -- fields are checked. Literal carriers remain open for the surrounding
  -- dictionary choice, just as they do in ordinary argument checking.
  fresh-tuple-elements :: Span -> Expr -> Store -> (UType, Store)
  fresh-tuple-elements sp fields st = case fields of
    EArgsEnd at -> (UEnd, st)
    EArg at first rest -> (case fresh-meta KType st of
      (ty, opened) -> (case fresh-tuple-elements sp rest opened of
        (more, checked) -> (UArg ty more, checked)))
    other -> (UError, add-error sp "invalid tuple literal element spine" st)
  check-tuple-elements :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> UType -> Store -> (CoreTerm, Store)
  check-tuple-elements classes kinds families env locals sp fields types st = case (fields, types) of
    (EArgsEnd at, UEnd) -> (CArgumentsEnd at, st)
    (EArg at first rest, UArg ty more) -> (case check classes kinds families env locals first ty st of
      (value, checked) -> (case check-tuple-elements classes kinds families (proof-env-after-term env value checked) locals sp rest more checked of
        (values, done) -> (CArgument at value values, done)))
    other -> term-error sp "tuple literal arity disagrees with its expected type" st
  check-inferred :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> UType -> Store -> (CoreTerm, Store)
  check-inferred classes kinds families env locals expr expected st = case infer-expected classes kinds families env locals expr expected st of
    (term, ss) -> subsume-term (expr-span expr) term expected ss
  -- Constrain a known application result before its arguments are checked.
  -- This is ordinary bidirectional type information, not proof evidence.
  -- A dependent arrow still waits for its actual argument witness.
  application-spine :: Expr -> List Expr -> (Expr, List Expr)
  application-spine expr args = case expr of
    EApp sp function argument -> application-spine function (Cons argument args)
    other -> (expr, args)
  hint-application-result :: Span -> UType -> List Expr -> UType -> Store -> Store
  hint-application-result sp ty args expected st = hint-independent-result Nil sp ty args expected st
  result-mentions-binder :: List Nat -> UType -> Bool
  result-mentions-binder binders ty = case binders of Nil -> False; Cons id rest -> contains-meta id (type-free-bound ty) || result-mentions-binder rest ty
  hint-independent-result :: List Nat -> Span -> UType -> List Expr -> UType -> Store -> Store
  hint-independent-result binders sp ty args expected st = case args of
    Nil -> if result-mentions-binder binders (normalize st ty) then st else (case normalize st expected of
      UMeta id kind -> st
      other -> let hinted = unify sp ty expected st in
        if list-length (store-errors hinted) == list-length (store-errors st) then hinted
        else (case refinement-view (normalize st ty) of
          URefine id name carrier predicate -> let base = unify sp carrier expected st in
            if list-length (store-errors base) == list-length (store-errors st) then base else st
          other -> st))
    Cons argument rest -> case arrow-shape (normalize st ty) of
      UPi id name domain row result -> hint-independent-result (Cons id binders) sp result rest expected st
      UProofFun predicate row result -> hint-independent-result binders sp result rest expected st
      URequire predicates result -> st
      other -> case arrow-parts sp ty st of
        (domain, row, result, shaped) -> hint-independent-result binders sp result rest expected shaped
  apply-spine :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> CoreTerm -> List Expr -> Store -> (CoreTerm, Store)
  apply-spine classes kinds families env locals fun args st = case args of
    Nil -> (fun, st)
    Cons arg rest -> case apply-argument classes kinds families env locals (expr-span arg) fun arg st of
      (applied, checked) -> apply-spine classes kinds families env locals applied rest checked
  expression-spine-valid :: Expr -> Bool
  expression-spine-valid fields = case fields of EArgsEnd sp -> True; EArg sp first rest -> expression-spine-valid rest; other -> False
  infer-expected :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> UType -> Store -> (CoreTerm, Store)
  infer-expected classes kinds families env locals expr expected st = case expr of
    ELetScope sp body -> scoped-let sp (infer-expected classes kinds families env locals body expected) st
    ERecord sp name fields -> infer-record-construction classes kinds families env locals sp name fields (Some expected) st
    ECon sp name fields | has name ["#condition.NonZero", "#condition.NotNull"] -> infer classes kinds families env locals expr st
    ECon sp name fields -> if not (expression-spine-valid fields) then term-error sp "malformed constructor argument spine" st else (case lookup-expression-value sp kinds name env st of
      (constructor, opened) -> let args = exprs-of fields in apply-spine classes kinds families env locals constructor args (hint-application-result sp (core-type constructor) args expected opened))
    EApp sp function argument | memo-demand-head env function -> infer-memo-demand classes kinds families env locals sp argument st
    -- One spine walk serves the ownership, projection, task and thunk checks
    -- and the argument list the application is checked against.
    EApp sp function argument -> case application-spine expr Nil of
      (head, args) -> case ownership-syntax-head env head of
        Some operation -> if same operation "b.refSet" then infer-ref-set classes kinds families env locals sp args st
          else infer-borrow classes kinds families env locals sp operation args expected st
        None -> if has-projection-head env head then infer classes kinds families env locals expr st else if task-syntax-at-head env head then infer-task-application classes kinds families env locals sp expr (Some expected) st else if par-syntax-at-head env head then infer-par-application classes kinds families env locals sp expr (Some expected) st else if decision-syntax-head env function then infer-decision-expected classes kinds families env locals sp argument expected st else
          case thunk-syntax-operation env head of
            Some operation -> (case (later-parts (normalize st expected), args) of
              (Some carrier, [input]) -> if same operation "b.delay" then check-later-delay classes kinds families env locals sp input carrier st else infer classes kinds families env locals expr st
              other -> infer classes kinds families env locals expr st)
            None -> case infer classes kinds families env locals head st of
              (fun, opened) -> apply-spine classes kinds families env locals fun args
                (hint-application-result sp (core-type fun) args expected opened)
    other -> infer classes kinds families env locals expr st
  comparison-predicate :: UType -> Bool
  -- Only comparisons and their conjunctions widen to a carrier. Structural
  -- predicates such as NonZero keep their own class instances and must be
  -- projected explicitly, including at an unsolved generic argument.
  comparison-predicate predicate = case predicate of UCompare op a b -> True; UPropAnd a b -> comparison-predicate a && comparison-predicate b; other -> False
  comparison-refinement :: UType -> Bool
  comparison-refinement ty = case refinement-view ty of URefine id name carrier predicate -> (integer-carrier carrier || same-type carrier (primitive-type "Bytes")) && comparison-predicate predicate; other -> False
  project-comparison :: Span -> CoreTerm -> Store -> CoreTerm
  project-comparison sp term st = case term of
    CLet at ty id name sc rhs body -> let result = project-comparison sp body st in
      CLet at (core-type result) id name sc rhs result
    other -> case refinement-view (normalize st (core-type term)) of
      URefine id name carrier predicate -> if comparison-refinement (normalize st (core-type term)) then CForget sp carrier term else term
      other -> term
  subsume-term :: Span -> CoreTerm -> UType -> Store -> (CoreTerm, Store)
  subsume-term sp term expected st = case refinement-view (normalize st expected) of
    URefine id name carrier predicate -> (term, unify sp (core-type term) expected st)
    other -> case forget-function-result sp term expected st of
      Some (value, opened) -> (value, unify sp (core-type value) expected opened)
      None -> let value = project-comparison sp term st in (value, unify sp (core-type value) expected st)
  -- A function value whose result is a comparison refinement flows into an
  -- arrow expecting its plain numbers (a plain result or an unsolved one):
  -- eta-expand once, applying the same value and forgetting the result's
  -- refinement. Only value references expand, so no computation is
  -- duplicated or reordered.
  forget-function-result :: Span -> CoreTerm -> UType -> Store -> Option (CoreTerm, Store)
  forget-function-result sp term expected st = if not (function-value-reference term) then None else
    case (normalize st (core-type term), normalize st expected) of
      (UFun domain result, UFun wanted-domain wanted) -> forgotten-arrow sp term domain (URow UEnd) result wanted st
      (UFunEff domain row result, UFunEff wanted-domain wanted-row wanted) -> forgotten-arrow sp term domain row result wanted st
      (UFun domain result, UFunEff wanted-domain wanted-row wanted) -> forgotten-arrow sp term domain (URow UEnd) result wanted st
      other -> None
  function-value-reference :: CoreTerm -> Bool
  function-value-reference term = case term of
    CUse s ty name role actuals -> True
    CQualifiedUse s ty name role actuals evidence -> True
    CLocal s ty id name Nil -> True
    other -> False
  forgotten-arrow :: Span -> CoreTerm -> UType -> UType -> UType -> UType -> Store -> Option (CoreTerm, Store)
  forgotten-arrow sp term domain row result wanted st =
    if not (comparison-refinement result) || is-refined-type wanted then None
    else case refinement-view result of
      URefine id name carrier predicate -> (case fresh-id st of
        (local, fresh) ->
          let argument = CLocal sp domain local "#forget-argument" Nil in
          let ty = case row of URow UEnd -> UFun domain carrier; other -> UFunEff domain row carrier in
          Some (CLambda sp ty (CPVar sp domain local "#forget-argument") (CForget sp carrier (applied-core sp result row term argument)), fresh))
      other -> None
  is-refined-type :: UType -> Bool
  is-refined-type ty = case refinement-view ty of URefine id name carrier predicate -> True; other -> False
  check-refined :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> UType -> UType -> Store -> (CoreTerm, Store)
  check-refined classes kinds families env locals expr expected carrier st = case expr of
    EDo sp statements -> check-do classes kinds families env locals sp statements expected st
    EIf s condition yes no -> check-unrefined classes kinds families env locals expr expected st
    EGuarded s guard body -> check-alt-body classes kinds families env locals expr expected st
    ECase s value alternatives -> case infer classes kinds families env locals value st of
      (scrutinee, checked) -> case check-alternatives classes kinds families (proof-env-after-term env scrutinee checked) locals scrutinee expected alternatives (ensure-match-coverage s families env (core-type scrutinee) alternatives checked) of
        (branches, done) -> (CCase s expected scrutinee branches, done)
    ELet s bindings body -> check-refined-let classes kinds families env locals s bindings body expected st
    EWith s bindings body -> infer-with classes kinds families env locals bindings body (Some expected) st
    ELitInt s text -> case checked-literal s carrier text st of (term, checked) -> introduce-refinement env s expected term checked
    ENeg s (ELitInt at text) -> case checked-literal s carrier (string-concat "-" text) st of (term, checked) -> introduce-refinement env s expected term checked
    ELam s patterns body -> case check-unrefined classes kinds families env locals expr carrier st of (term, checked) -> introduce-refinement env s expected term checked
    -- Structural refinements are actual generic carriers. Hint their full
    -- expected type before checking a call's arguments; comparison facts
    -- still infer at the container and re-enter by checked evidence.
    other -> case infer-expected classes kinds families env locals expr (if comparison-refinement (normalize st expected) then carrier else expected) st of
      (term, checked) -> refine-inferred env (expr-span expr) expected carrier term checked
  -- Check the requested result inside materialized witness scopes, then
  -- close each CLet with that requested type. No local index escapes in
  -- an outer annotation, and every RHS remains evaluated exactly once.
  refine-inferred :: List CheckedBinding -> Span -> UType -> UType -> CoreTerm -> Store -> (CoreTerm, Store)
  refine-inferred env sp expected carrier term st = case term of
    -- A conditional Nat result may have a checked mathematical equation
    -- while remaining unavailable as an unconditional type-level index.
    -- Bind it once; the independent CLet rule reconstructs that equation.
    CDischarge at ty evidence body -> materialize-refinement env sp expected carrier term st
    CLet at ty id name sc rhs body ->
      let binding = MkLocalBinding name sc id (store-level st) in
      let bound = proof-let-env env binding id sc rhs st in
      case refine-inferred bound sp expected carrier body st of
        (result, done) -> (CLet at expected id name sc rhs result, done)
    CForget at plain body -> if comparison-refinement (normalize st (core-type body)) then
      refine-inferred env sp expected carrier body st
      else introduce-refinement env sp expected term (unify sp (core-type term) carrier st)
    other -> case refinement-view (normalize st (core-type term)) of
      URefine id name domain predicate -> let direct = unify sp (core-type term) expected st in
        if list-length (store-errors direct) == list-length (store-errors st) then (term, direct)
        else materialize-refinement env sp expected carrier term st
      other -> let unified = unify sp (core-type term) carrier st in
        case introduce-refinement env sp expected term unified of
          (result, done) -> if list-length (store-errors done) == list-length (store-errors unified) || not (certified-arithmetic-operand term) then (result, done)
            -- Arithmetic over a certified Nat subtraction has no type-level
            -- index (truncating subtraction is not one), but bound once its
            -- value has the checked let equation that states it exactly.
            else materialize-refinement env sp expected carrier term st
  certified-arithmetic-operand :: CoreTerm -> Bool
  certified-arithmetic-operand term = case term of
    CProved s ty evidence body -> True
    -- A discharged source subtraction carries the checked `b <= a`
    -- obligation, so its value is arithmetic the let equation states.
    CDischarge s ty evidence body -> True
    CPrimitive s ty op (CArgument a first (CArgument b second (CArgumentsEnd end))) -> certified-arithmetic-operand first || certified-arithmetic-operand second
    CApply s ty (CApply partial function method first) second -> certified-arithmetic-operand first || certified-arithmetic-operand second
    other -> False
  -- A call's result is a value, not a stable symbolic call. Bind that
  -- result once before weakening its checked refinement. The ordinary
  -- CLet/CLocal/CForget/CRefine rules recheck the certificate under the
  -- actual fresh local identity and retain the producer's effect row.
  materialize-refinement :: List CheckedBinding -> Span -> UType -> UType -> CoreTerm -> Store -> (CoreTerm, Store)
  materialize-refinement env sp expected carrier term st = case fresh-id st of
    (id, fresh) ->
      let actual = normalize fresh (core-type term) in
      let scheme = mono actual in
      let name = "#refinement-result" in
      let binding = MkLocalBinding name scheme id (store-level fresh) in
      let bound = proof-let-env env binding id scheme term fresh in
      let local = CLocal sp actual id name Nil in
      let value = project-comparison sp local fresh in
      case introduce-refinement bound sp expected value (unify sp (core-type value) carrier fresh) of
        (result, checked) -> (CLet sp expected id name scheme term result, checked)
  introduce-refinement :: List CheckedBinding -> Span -> UType -> CoreTerm -> Store -> (CoreTerm, Store)
  introduce-refinement env sp expected term st = case store-errors st of
    Cons error rest -> (CError sp, st)
    Nil -> let gamma = proof-context env st in
      let facts = proof-facts env in
      let refined = normalize st expected in
      let value = map-term-types (normalize st) term in
      case scoped-prove-refinement gamma facts refined value of
        Some evidence -> (CRefine sp expected evidence term, st)
        None -> case stale-proof-message env st (\prior ->
          case scoped-prove-refinement gamma prior refined value of Some evidence -> True; None -> False) of
            Some message -> term-error sp message st
            None -> let message = "refinement predicate is not established for this value (undischarged refinement obligation)" in
              (case scoped-refinement-predicate gamma facts refined value of
                Some predicate -> term-error sp (missing-obligation message predicate) st
                None -> term-error sp message st)

  obligation-text :: UType -> String
  obligation-text ty = case ty of
    UCompare relation left right -> if same relation "Eq" then
      string-concat-all ["Eq ", obligation-text left, " ", obligation-text right]
      else string-concat-all [obligation-text left, " ", relation, " ", obligation-text right]
    UPropNonZero body -> "NonZero " <> obligation-text body
    UPropNonZeroPending body -> "NonZero " <> obligation-text body
    UPropNotNull body -> "NotNull " <> obligation-text body
    UPropAscii body -> "Ascii " <> obligation-text body
    UPropOrdered body -> "Ordered " <> obligation-text body
    UIndexForget value -> obligation-text value
    UIndexPromote value -> obligation-text value
    UIndexByteLength value -> string-concat-all ["(Data.Bytes.bytes-len ", obligation-text value, ")"]
    UIndexMath op left right -> string-concat-all ["(", obligation-text left, " ", op, " ", obligation-text right, ")"]
    other -> display-type-text ty
  missing-obligation :: String -> UType -> String
  missing-obligation message predicate = let shown = obligation-text predicate in
    string-concat-all [message, " because the obligation `", shown, "` needs `Dec` evidence or a branch fact at this use (discharge it in the `Dec`/`decide` world: `case decide (", shown,
      ") of Yes w -> ...`, under a branch condition that implies it (`if ... then`, a guard, or the left operand of `&&`), or pass an argument whose refinement implies it): no evidence for `", shown, "` is in scope here"]
  wrong-named-evidence :: List CheckedBinding -> List CheckedBinding -> UType -> Store -> Option String
  wrong-named-evidence remaining env wanted st = case remaining of
    Nil -> None
    Cons (MkErasedBinding name predicate id origin None) rest ->
      (case lookup-binding name env of
        Some (MkErasedBinding visible actual owner origin None) ->
          let stated = normalize st actual in
          if owner == id && not (same-type (without-index-levels stated) (without-index-levels wanted)) then
            Some (string-concat-all ["`", visible, "` is evidence of `", obligation-text stated, "`, not of `", obligation-text wanted, "`"])
          else wrong-named-evidence rest env wanted st
        other -> wrong-named-evidence rest env wanted st)
    Cons other rest -> wrong-named-evidence rest env wanted st
  -- Hoisting an actual strict value binding out of a let-generalization
  -- level changes that binding's inference depth, not its identity. Retarget
  -- only references to that witnessed local; unrelated indices and all type
  -- skolems keep their original escape boundaries.
  relocate-local-index :: Nat -> Nat -> UType -> UType
  relocate-local-index binding new-level ty = case ty of
    UCompare relation left right -> UCompare relation (relocate-local-index binding new-level left) (relocate-local-index binding new-level right)
    UPropAnd left right -> UPropAnd (relocate-local-index binding new-level left) (relocate-local-index binding new-level right)
    UPropOr left right -> UPropOr (relocate-local-index binding new-level left) (relocate-local-index binding new-level right)
    UPropNot body -> UPropNot (relocate-local-index binding new-level body)
    UPropNonZero body -> UPropNonZero (relocate-local-index binding new-level body)
    UPropNotNull body -> UPropNotNull (relocate-local-index binding new-level body)
    UPropAscii body -> UPropAscii (relocate-local-index binding new-level body)
    UPropOrdered body -> UPropOrdered (relocate-local-index binding new-level body)
    UPropNonZeroPending body -> UPropNonZeroPending (relocate-local-index binding new-level body)
    URequire predicates body -> URequire (relocate-local-index binding new-level predicates) (relocate-local-index binding new-level body)
    URefine id name carrier predicate -> URefine id name (relocate-local-index binding new-level carrier) (relocate-local-index binding new-level predicate)
    UIndexForget value -> UIndexForget (relocate-local-index binding new-level value)
    UIndexByteLength value -> UIndexByteLength (relocate-local-index binding new-level value)
    UIndexBorrowRead value -> UIndexBorrowRead (relocate-local-index binding new-level value)
    UIndexList element fields ->
      UIndexList (relocate-local-index binding new-level element) (relocate-local-index binding new-level fields)
    UIndexCall function args -> UIndexCall function (relocate-local-index binding new-level args)
    UIndexPromote value -> UIndexPromote (relocate-local-index binding new-level value)
    UIndexMath op left right -> UIndexMath op (relocate-local-index binding new-level left) (relocate-local-index binding new-level right)
    UPi id name domain row result -> UPi id name (relocate-local-index binding new-level domain) (relocate-local-index binding new-level row) (relocate-local-index binding new-level result)
    UApp f x -> UApp (relocate-local-index binding new-level f) (relocate-local-index binding new-level x)
    UFun a b -> UFun (relocate-local-index binding new-level a) (relocate-local-index binding new-level b)
    UFunEff a row b -> UFunEff (relocate-local-index binding new-level a) (relocate-local-index binding new-level row) (relocate-local-index binding new-level b)
    UUsageArrow usage arrow -> UUsageArrow usage (relocate-local-index binding new-level arrow)
    UProofFun a row b -> UProofFun (relocate-local-index binding new-level a) (relocate-local-index binding new-level row) (relocate-local-index binding new-level b)
    URow labels -> URow (relocate-local-index binding new-level labels)
    URowJoin a b -> URowJoin (relocate-local-index binding new-level a) (relocate-local-index binding new-level b)
    UTuple fields -> UTuple (relocate-local-index binding new-level fields)
    UArg x rest -> UArg (relocate-local-index binding new-level x) (relocate-local-index binding new-level rest)
    UIndex carrier value -> UIndex (relocate-local-index binding new-level carrier) (relocate-local-index-term binding new-level value)
    UCon name k -> UCon name (map-kind-types (relocate-local-index binding new-level) k)
    UBound id name k -> UBound id name (map-kind-types (relocate-local-index binding new-level) k)
    URigid id name level k -> URigid id name level (map-kind-types (relocate-local-index binding new-level) k)
    UMeta id k -> UMeta id (map-kind-types (relocate-local-index binding new-level) k)
    other -> ty
  relocate-local-index-term :: Nat -> Nat -> IndexTerm -> IndexTerm
  relocate-local-index-term binding new-level term = case term of
    IRigid id name level -> IRigid id name (if id == binding && level > new-level then new-level else level)
    IApply f x -> IApply (relocate-local-index-term binding new-level f) (relocate-local-index-term binding new-level x)
    ILambda id name body -> ILambda id name (relocate-local-index-term binding new-level body)
    IAdd a b -> IAdd (relocate-local-index-term binding new-level a) (relocate-local-index-term binding new-level b)
    ISubtract a b -> ISubtract (relocate-local-index-term binding new-level a) (relocate-local-index-term binding new-level b)
    IMultiply a b -> IMultiply (relocate-local-index-term binding new-level a) (relocate-local-index-term binding new-level b)
    other -> term

  let-result-escapes :: CoreTerm -> Bool
  let-result-escapes term = let-chain-mentions (type-all-ids (core-type term)) term
  let-chain-mentions :: List Nat -> CoreTerm -> Bool
  let-chain-mentions ids term = case term of
    CLet sp ty id name sc rhs body -> contains-meta id ids || let-chain-mentions ids body
    other -> False
  check-refined-let :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Expr -> UType -> Store -> (CoreTerm, Store)
  check-refined-let classes kinds families env locals sp bindings body expected st = case bindings of
    EBindingsEnd s -> check classes kinds families env locals body expected st
    EBinding s name rhs rest -> let level = store-level st in
      case infer classes kinds families env locals rhs (enter-level st) of
        (value, checked) -> case resolve-dictionary-term-with classes (env-instances env) (env-givens env) value checked of
          (resolved, ready) -> check-refined-binding classes kinds families env locals sp s name rest body expected level resolved ready
    other -> term-error sp "malformed let binding spine" st

  check-refined-binding :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Span -> String -> Expr -> Expr -> UType -> Nat -> CoreTerm -> Store -> (CoreTerm, Store)
  check-refined-binding classes kinds families env locals sp at name rest body expected level value st =
    if let-result-escapes value then (case value of
      CLet s ty id display sc rhs inner ->
        let binding = MkLocalBinding display sc id level in
        let bound = proof-let-env env binding id sc rhs st in
        case check-refined-binding classes kinds families bound locals sp at name rest body expected level (map-term-types (relocate-local-index id level) (map-term-types (normalize st) inner)) st of
          (result, done) -> (CLet s expected id display sc rhs result, done)
      other -> term-error at "dependent let result has no retained witness scope" st)
    else let (scheme, pairs) = generalize-with level (\u -> env-metas env st) (core-type value) st in
      case fresh-id (restore-level level st) of
        (id, fresh) -> case let-binding at env name scheme id level value fresh of
          (binding, prepared) -> case check-refined-let classes kinds families (proof-let-env env binding id scheme value prepared) locals sp rest body expected prepared of
            (result, done) -> (CLet at expected id name scheme (abstract-term st pairs value) result, done)
  infer-arguments :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> CoreTerm -> Expr -> Store -> (CoreTerm, Store)
  infer-arguments classes kinds families env locals term args st = case args of
    EArgsEnd s -> (term, st)
    EArg s x rest -> case apply-argument classes kinds families env locals s term x st of
      (applied, checked) -> infer-arguments classes kinds families env locals applied rest checked
    other -> term-error (expr-span args) "malformed constructor argument spine" st
  infer-fields :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> Store -> (UType, CoreTerm, Store)
  infer-fields classes kinds families env locals args st = case args of
    EArgsEnd s -> (UEnd, CArgumentsEnd s, st)
    EArg s x rest -> case infer classes kinds families env locals x st of
      (term, sx) -> case infer-fields classes kinds families (proof-env-after-term env term sx) locals rest sx of
        (types, terms, ss) -> (UArg (core-type term) types, CArgument s term terms, ss)
    other -> (UEnd, CError (expr-span args), add-error (expr-span args) "malformed tuple expression spine" st)
  infer-lambda :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> List Pat -> Expr -> Store -> (CoreTerm, Store)
  infer-lambda classes kinds families env locals ps body st = case ps of
    Nil -> infer classes kinds families env locals body st
    Cons p rest -> case fresh-meta KType st of
      (arg, sa) -> case bind-pattern classes kinds families (proof-env-after-writes env [(pat-span p, None)] sa) locals p arg sa of
        (bound, pattern, sb) -> case infer-lambda classes kinds families bound locals rest body sb of
          (rhs, sr) -> (CLambda (pat-span p) (function-type arg (normalize sr (core-effects rhs)) (core-type rhs)) pattern rhs, sr)
  check-lambda :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> List Pat -> Expr -> UType -> Store -> (CoreTerm, Store)
  check-lambda classes kinds families env locals ps body expected st = case ps of
    Nil -> check-required classes kinds families env locals body expected st
    Cons p rest -> case normalize st expected of
      UMeta id kind -> case infer-lambda classes kinds families env locals ps body st of
        (term, checked) -> (term, unify (pat-span p) expected (core-type term) checked)
      other -> case bind-arrow-pattern classes kinds families (proof-env-after-writes env [(pat-span p, None)] st) locals p expected st of
        (bound, pattern, row, result, checked) -> case check-lambda classes kinds families bound locals rest body result checked of
          (rhs, sr) -> (CLambda (pat-span p) expected pattern rhs, inferred-lambda-effects (expr-span body) (core-effects rhs) row sr)
  inferred-lambda-effects :: Span -> UType -> UType -> Store -> Store
  inferred-lambda-effects sp actual allowed st = case normalize st allowed of
    UMeta id KRow -> unify sp allowed (normalize st actual) st
    other -> include-effects sp actual allowed st
  function-type :: UType -> UType -> UType -> UType
  function-type a row b = case row of URow UEnd -> UFun a b; other -> UFunEff a row b
  arrow-parts :: Span -> UType -> Store -> (UType, UType, UType, Store)
  arrow-parts sp ty st = case arrow-shape (normalize st ty) of
    UPi id name a row b -> if pi-dependent (normalize st ty) then (UError, UError, UError, add-error sp "dependent arrow needs an actual argument witness" st) else (a, row, b, st)
    UFun a b -> (a, URow UEnd, b, st)
    UFunEff a row b -> (a, row, b, st)
    UProofFun predicate row result -> (predicate, row, result, st)
    other -> case fresh-meta KType st of
      (a, sa) -> case fresh-meta KType sa of
        (b, sb) -> case fresh-meta KRow sb of
          (row, sr) -> (a, row, b, unify sp ty (UFunEff a row b) sr)
  apply-argument :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> CoreTerm -> Expr -> Store -> (CoreTerm, Store)
  apply-argument classes kinds families env locals sp fun arg st = case fun of
    -- Continue a curried call inside the scopes created for its previous
    -- strict argument. The argument's equation and declaration stay in
    -- scope until the remaining preconditions are checked. Hidden names
    -- keep an inner function-expression let from capturing source args.
    CLet at ty id name sc rhs body ->
      let hidden = string-concat "#application-let:" (int-to-string (nat-to-int id)) in
      let binding = MkLocalBinding hidden sc id (store-level st) in
      let bound = proof-let-env env binding id sc rhs st in
      case apply-argument classes kinds families bound locals sp body arg st of
        (call, checked) -> (CLet at (core-type call) id name sc rhs call, checked)
    other -> apply-open-argument classes kinds families env locals sp fun arg st
  apply-open-argument :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> CoreTerm -> Expr -> Store -> (CoreTerm, Store)
  apply-open-argument classes kinds families original locals sp fun arg st =
    let env = proof-env-after-term original fun st in
    let function = normalize st (core-type fun) in
    if erased-value-arrow function then
      (case erased-argument-domain (arrow-shape function) of
        Some domain -> (case check classes kinds families env locals arg domain st of
          (value, checked) -> apply-runtime-argument classes sp env fun value checked)
        None -> term-error sp "malformed erased value arrow" st)
    else case arrow-shape function of
      UProofFun predicate effects result -> case (fun, arg) of
        -- Transparent constructors are synthesized with a scoped proof
        -- lambda. A direct decide must check the same predicate, and the
        -- payload must independently establish it before erasing the decision.
        (CApply at ty (CLambda source outer (CPVar binder domain id name)
          (CLambda witness-at inner (CPProof proof-at proposition proof-id proof-name)
            (CRefineProof construct refined reference body))) value,
         EApp decision head input) | decision-syntax-head env head ->
          (case check classes kinds families env locals arg (decision-type predicate) st of
            (checked-decision, checked) -> introduce-refinement env sp result value checked)
        other -> case erased-argument sp env arg predicate st of
          (witness, checked) -> discharge-call classes sp env (CErasedApply sp result effects fun witness) checked
      UPi id name domain effects result -> case check classes kinds families env locals arg domain st of
        (value, checked) -> apply-source-argument classes kinds families env locals sp fun arg value st checked
      other -> case arrow-parts sp (core-type fun) st of
        (a, row, b, sf) -> case check classes kinds families env locals arg a sf of
          (value, checked) -> apply-source-argument classes kinds families env locals sp fun arg value sf checked
  erased-argument-domain :: UType -> Option UType
  erased-argument-domain arrow = case arrow of
    UFun domain result -> Some domain
    UFunEff domain row result -> Some domain
    UPi id name domain row result -> Some domain
    other -> None
  -- Instantiating a generic consumer with an argument's private witness
  -- must not put that witness in the preceding function binding's type.
  -- Bind the function at its independent scheme first, then instantiate
  -- its local inside the argument's retained lets. Evaluation order stays
  -- function, argument, call; no computation becomes a type equation.
  apply-source-argument :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> CoreTerm -> Expr -> CoreTerm -> Store -> Store -> (CoreTerm, Store)
  apply-source-argument classes kinds families env locals sp fun arg value before checked =
    if not (let-chain-mentions (type-all-ids (normalize checked (core-type fun))) value) then
      apply-runtime-argument classes sp env fun value checked
    else case generalize-application-with (\u -> env-metas env before) (core-type fun) before of
      (scheme, Nil) -> apply-runtime-argument classes sp env fun value checked
      (scheme, pairs) -> case fresh-id before of
        (id, fresh) ->
          let name = "#argument-polymorphic-function" in
          let rhs = abstract-term before pairs fun in
          let binding = MkLocalBinding name scheme id (store-level fresh) in
          let bound = proof-let-env env binding id scheme rhs fresh in
          case lookup-value sp name bound fresh of
            (local, opened) -> case (case arrow-shape (normalize opened (core-type local)) of
              UPi index display domain effects result -> (domain, opened)
              other -> case arrow-parts sp (core-type local) opened of (domain, effects, result, shaped) -> (domain, shaped)) of
              (domain, shaped) -> case check classes kinds families bound locals arg domain shaped of
                (actual, ready) -> case apply-argument-lets classes sp bound local actual ready of
                  (call, done) -> (CLet sp (core-type call) id name scheme rhs call, done)
  erased-argument :: Span -> List CheckedBinding -> Expr -> UType -> Store -> (CoreTerm, Store)
  erased-argument sp env syntax expected st = case syntax of
    EVar at name -> if same name "b.refl" then
      let predicate = normalize st expected in
      if reflexive-equality predicate then (CProofRefl at predicate, st)
      else term-error at "refl requires definitionally equal operands" st
      else (case lookup-binding name env of
        Some (MkErasedBinding display predicate id origin invalidated) -> (case invalidated of
          None -> (CProofRef at predicate id name, unify sp predicate expected st)
          Some write -> term-error at (stale-evidence-message origin write) st)
        Some (MkCheckedBinding symbol sc role) | same role "closed-proof" ->
          let predicate = scheme-body sc in
          (CProofRefl at predicate, unify sp predicate expected st)
        other -> term-error sp "erased argument needs a scoped proof reference" st)
    EApp at (EVar name symbol) argument -> if same symbol "b.Proof.search" then
      (case lookup-binding symbol env of
        Some (MkSyntaxBinding owned) -> if same owned symbol then search-proof at env expected argument st
          else term-error at "unowned proof tactic" st
        other -> term-error at "unowned proof tactic" st)
      else term-error sp "erased argument needs a scoped total proof term" st
    other -> term-error sp "erased argument needs a scoped total proof term" st
  -- A proof body in goal position. The proof forms are the ones an erased
  -- argument already accepts (`refl`, a scoped evidence name, a tactic
  -- search); everything else returns None so the ordinary value checker
  -- produces its own message for a genuine type error. `case`, `if` and a
  -- `let` recurse through `check`, which is how a proof former's branches
  -- each get their own goal.
  proof-goal :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> UType -> Store -> Option (CoreTerm, Store)
  proof-goal classes kinds families env locals expr goal st = case expr of
    EVar at name -> if same name "b.refl" then
      (if reflexive-equality (normalize st goal) then Some (CProofRefl at (normalize st goal), st) else None)
      else (case lookup-binding name env of
        Some (MkErasedBinding display predicate id origin invalidated) -> (case invalidated of
          None -> Some (CProofRef at predicate id name, unify at predicate goal st)
          Some write -> Some (term-error at (stale-evidence-message origin write) st))
        Some (MkCheckedBinding symbol sc role) | same role "closed-proof" ->
          Some (CProofRefl at (scheme-body sc), unify at (scheme-body sc) goal st)
        other -> None)
    EApp at (EVar name symbol) argument -> if same symbol "b.Proof.search" then
      (case lookup-binding symbol env of
        Some (MkSyntaxBinding owned) -> if same owned symbol then Some (search-proof at env goal argument st) else None
        other -> None)
      else None
    other -> None
  tactic-steps-valid :: List String -> Bool
  tactic-steps-valid steps = case steps of
    Nil -> True
    Cons step rest -> has step ["assumption", "linear"] && tactic-steps-valid rest
  try-proof-tactics :: Span -> ProofScope -> List Proposition -> UType -> List String -> Option CoreTerm
  try-proof-tactics at scope facts goal steps = case steps of
    Nil -> None
    Cons first rest ->
      let assumption = same first "assumption" in
      case prove-erased-goal scope facts goal assumption of
        Some evidence -> Some (CProofSearch at goal assumption evidence)
        None -> try-proof-tactics at scope facts goal rest
  search-proof :: Span -> List CheckedBinding -> UType -> Expr -> Store -> (CoreTerm, Store)
  search-proof at env expected argument st = case argument of
    ELitStr sp plan -> if bytes-len (string-to-bytes plan) > 128 then term-error at "tactic plan exceeds 128 bytes" st else
      let steps = string-words plan in
      if list-length steps == 0 || list-length steps > 8 || not (tactic-steps-valid steps) then
        term-error at "tactic plan needs 1–8 steps: assumption or linear" st
      else let goal = normalize st expected in
        let gamma = proof-context env st in
        case try-proof-tactics at gamma (proof-facts env) goal steps of
          Some witness -> (witness, st)
          None -> case stale-proof-message env st (\prior ->
            case try-proof-tactics at gamma prior goal steps of Some witness -> True; None -> False) of
              Some message -> term-error at message st
              None -> term-error at (string-concat-all ["tactic plan `", plan, "` could not prove `", type-text goal, "`"]) st
    other -> term-error at "Proof.search expects one literal tactic plan" st
  applied-core :: Span -> UType -> UType -> CoreTerm -> CoreTerm -> CoreTerm
  applied-core sp result row fun arg = case row of URow UEnd -> CApply sp result fun arg; other -> CApplyEff sp result row fun arg
  source-effect :: UType -> List CoreEffect -> Option CoreEffect
  source-effect label declarations = case declarations of
    Nil -> None
    Cons declaration rest -> case source-effect-head label of
      Some name -> if same name (core-effect-name declaration) then Some declaration else source-effect label rest
      None -> None
  source-effect-head :: UType -> Option String
  source-effect-head label = case label of UCon name kind -> Some name; UApp f x -> source-effect-head f; other -> None
  source-operation-names :: List CoreOperation -> List String
  source-operation-names operations = case operations of Nil -> Nil; Cons first rest -> Cons (core-operation-name first) (source-operation-names rest)
  source-handler-shape :: Span -> List String -> List String -> Expr -> Store -> Store
  source-handler-shape sp wanted seen clauses st = case clauses of
    EHandlerEnd at -> if list-length seen == list-length wanted then st else add-error sp "handler is missing a declared operation or return clause" st
    EHandlerClause at name pats continuation body rest ->
      let checked = if has name wanted && not (has name seen) then st else add-error at "handler clause is duplicate or belongs to a different effect" st in
      source-handler-shape sp wanted (Cons name seen) rest (if same name "return" then
        (case (pats, continuation) of (Cons p Nil, None) -> checked; other -> add-error at "handler return needs exactly one pattern and no resumption" checked)
        else checked)
    other -> add-error sp "malformed handler clause spine" st
  source-handler-clause :: String -> Expr -> Option Expr
  source-handler-clause name clauses = case clauses of
    EHandlerClause sp key pats continuation body rest -> if same name key then Some clauses else source-handler-clause name rest
    other -> None
  handler-patterns-simple :: List Pat -> Bool
  handler-patterns-simple pats = case pats of
    Nil -> True
    Cons (PVar sp name) rest -> handler-patterns-simple rest
    Cons (PWild sp) rest -> handler-patterns-simple rest
    other -> False
  -- Preserve the original Pi telescope while inserting the actual final
  -- clause row. This keeps index binders scoped at their defining arrows.
  source-handler-lambda-type :: UType -> List Pat -> UType -> UType
  source-handler-lambda-type expected pats row = case pats of
    Nil -> expected
    Cons p rest -> case expected of
      UUsageArrow usage arrow -> UUsageArrow usage (source-handler-lambda-type arrow pats row)
      UFun a b -> source-handler-arrow a (URow UEnd) b rest row
      UFunEff a effects b -> source-handler-arrow a effects b rest row
      UPi id name a effects b -> UPi id name a (case rest of Nil -> row; other -> URow UEnd) (source-handler-lambda-type b rest row)
      UProofFun predicate effects b -> UProofFun predicate (case rest of Nil -> row; other -> URow UEnd) (source-handler-lambda-type b rest row)
      other -> UError
  source-handler-arrow :: UType -> UType -> UType -> List Pat -> UType -> UType
  source-handler-arrow a effects b rest row = function-type a (case rest of Nil -> row; other -> URow UEnd) (source-handler-lambda-type b rest row)
  source-handler-lambda :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> List Pat -> Expr -> UType -> Store -> (CoreTerm, UType, Store)
  source-handler-lambda classes kinds families env locals pats body expected st = case pats of
    Nil -> case check-required classes kinds families env locals body expected st of
      (value, done) -> (value, normalize done (core-effects value), done)
    Cons pat rest -> case bind-arrow-pattern classes kinds families env locals pat expected st of
      (bound, pattern, ignored, result, next) -> case source-handler-lambda classes kinds families bound locals rest body result next of
        (value, row, done) -> (CLambda (pat-span pat) (source-handler-lambda-type (normalize done expected) pats row) pattern value, row, done)
  source-handler-operations :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> CoreEffect -> UType -> UType -> Expr -> List CoreOperation -> Store -> (CoreTerm, UType, Store)
  source-handler-operations classes kinds families env locals declaration label output clauses operations st = case operations of
    Nil -> (CHandlerEnd (expr-span clauses), URow UEnd, st)
    Cons operation rest -> case source-handler-clause (core-operation-name operation) clauses of
      Some (EHandlerClause sp name pats continuation body more) -> case handler-operation-scheme declaration label operation of
        Some sc -> case open-scheme True sc st of
          (opened, openings, next) ->
            let ps = pats <> [case continuation of Some name -> PVar sp name; None -> PWild sp] in
            let shape = if list-length pats == scheme-runtime-arity sc && handler-patterns-simple ps then duplicate-names sp (patterns-names ps) Nil next else add-error sp "handler operation needs its exact variable or wildcard arguments" next in
            let expected = handler-clause-type opened output (URow UEnd) in
            case source-handler-lambda classes kinds families env locals ps body expected shape of
              (closure, row, checked) ->
                let safe = if handler-resumption-safe (normalize checked opened) (map-term-types (normalize checked) closure) then checked else add-error sp "handler resumption is repeated or escapes its one-shot scope" checked in
                case source-handler-operations classes kinds families env locals declaration label output clauses rest safe of
                  (tail, latent, done) -> (CHandlerOperation sp (core-operation-slot operation) openings row closure tail, union-effects row latent, done)
        None -> (CError sp, UError, add-error sp "handler operation has unsupported or ill-scoped declaration constraints" st)
      other -> (CError (expr-span clauses), UError, add-error (expr-span clauses) "handler is missing a declared operation" st)
  infer-source-handler :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> TypeExpr -> Expr -> UType -> UType -> Store -> (CoreTerm, Store)
  infer-source-handler classes kinds families env locals sp syntax clauses input output st = case convert-effect kinds (value-locals env locals) syntax st of
    (label, converted) -> case source-effect label (context-effects kinds) of
      Some declaration -> let shaped = source-handler-shape sp (Cons "return" (source-operation-names (core-effect-operations declaration))) Nil clauses converted in
        case source-handler-clause "return" clauses of
          Some (EHandlerClause at name pats continuation body rest) ->
            let simple = if handler-patterns-simple pats then shaped else add-error at "handler return needs a variable or wildcard pattern" shaped in
            case source-handler-lambda classes kinds families env locals pats body (UFun input output) simple of
              (returned, return-row, checked) -> case source-handler-operations classes kinds families env locals declaration label output clauses (core-effect-operations declaration) checked of
                (operations, operation-row, done) -> (CHandler sp (handler-type label input output (union-effects return-row operation-row)) returned operations, done)
          other -> term-error sp "handler is missing its return clause" shaped
      None -> term-error sp "handler needs its actual checked effect declaration" converted
  align-handler-row :: Span -> UType -> UType -> Store -> Store
  align-handler-row sp label row st = case normalize st row of
    URow labels -> align-handler-labels sp label labels st
    URowJoin a b -> align-handler-row sp label b (align-handler-row sp label a st)
    other -> st
  align-handler-labels :: Span -> UType -> UType -> Store -> Store
  align-handler-labels sp label labels st = case labels of
    UArg first rest ->
      let next = case (source-effect-head label, source-effect-head first) of
            (Some wanted, Some actual) -> if same wanted actual then
              (let trial = unify sp label first st in if list-length (store-errors trial) == list-length (store-errors st) then trial else st)
              else st
            other -> st in
      align-handler-labels sp label rest next
    other -> st
  infer-handle :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Expr -> Store -> (CoreTerm, Store)
  infer-handle classes kinds families env locals sp body handled-by st = case infer classes kinds families env locals body st of
    (value, checked) -> case fresh-meta KType checked of
      (output, fresh) -> case (case handled-by of
        EHandler at label clauses -> infer-source-handler classes kinds families env locals at label clauses (core-type value) output fresh
        other -> infer classes kinds families env locals handled-by fresh) of
        (h, next) -> case handler-parts (normalize next (core-type h)) of
          Some (label, input, result, row) -> let matched = align-handler-row sp label (core-effects value) (unify sp input (core-type value) next) in
            case handler-residual (normalize matched label) (normalize matched (core-effects value)) of
              Some residual -> case source-effect (normalize matched label) (context-effects kinds) of
                Some declaration -> if handler-body-direct (normalize matched label) (source-operation-names (core-effect-operations declaration)) (map-term-types (normalize matched) value) then (CHandle sp result label residual value h, matched)
                  else term-error sp "handled effect is performed through a called computation" matched
                None -> term-error sp "handler needs its actual checked effect declaration" matched
              None -> term-error sp "handler body needs a resolved effect row" matched
          None -> term-error sp "handle expects a checked handler value" next
  infer-with :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> Expr -> Option UType -> Store -> (CoreTerm, Store)
  infer-with classes kinds families env locals bindings body expected st = case bindings of
    EBindingsEnd s -> case expected of None -> infer classes kinds families env locals body st; Some ty -> check classes kinds families env locals body ty st
    EBinding s name rhs rest -> case infer classes kinds families env locals rhs st of
      (value, checked) -> let ty = normalize checked (core-type value) in
        if not (checked-class-type classes ty) then term-error s "with binding needs a checked signature value" checked else
        case fresh-id checked of
          (id, fresh) -> let symbol = string-concat "#capability_" (nat-to-string id) in
            case infer-with classes kinds families (Cons (MkGivenBinding name ty symbol) (proof-env-after-term env value fresh)) locals rest body expected fresh of
              (result, done) -> case resolve-dictionary-term-with classes (env-instances env) (env-givens env) (CWith s (core-type result) (CGiven s symbol ty) value result) done of
                (resolved, verified) -> (resolved, case with-region ty of Some region -> check-capability-escape s region (core-type result) verified; None -> verified)
    other -> term-error (expr-span bindings) "malformed capability binding spine" st
  with-region :: UType -> Option UType
  with-region ty = case ty of UApp (UCon name kind) region -> if same name "b.Io" && kind-equal (type-kind region) KRegion then Some region else None; other -> None
  contains-meta :: Nat -> List Nat -> Bool
  contains-meta id ids = case ids of Nil -> False; Cons first rest -> id == first || contains-meta id rest
  check-capability-escape :: Span -> UType -> UType -> Store -> Store
  check-capability-escape sp region result st = case normalize st region of
    UMeta id kind -> if contains-meta id (free-metas st result) then add-error sp "fresh capability region escapes its scope" st else st
    other -> st
  infer-let :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Expr -> Store -> (CoreTerm, Store)
  infer-let classes kinds families env locals sp bs body st = infer-let-with-expected classes kinds families env locals sp bs body None st
  infer-let-with-expected :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Expr -> Option UType -> Store -> (CoreTerm, Store)
  infer-let-with-expected classes kinds families env locals sp bs body wanted st = case bs of
    EBindingsEnd s -> case wanted of None -> infer classes kinds families env locals body st; Some expected -> check classes kinds families env locals body expected st
    EBinding s name rhs rest ->
      let level = store-level st in
      case infer classes kinds families env locals rhs (enter-level st) of
        (value, sr) -> case resolve-dictionary-term-with classes (env-instances env) (env-givens env) value sr of
          (resolved, sd) -> infer-let-binding classes kinds families env locals sp s name rest body level wanted resolved sd
    other -> term-error (expr-span bs) "malformed let binding spine" st
  infer-let-binding :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Span -> String -> Expr -> Expr -> Nat -> Option UType -> CoreTerm -> Store -> (CoreTerm, Store)
  infer-let-binding classes kinds families env locals sp at name rest body level wanted value st =
    if let-result-escapes value then (case value of
      CLet s ty id display sc rhs inner ->
        let binding = MkLocalBinding display sc id level in
        let bound = proof-let-env env binding id sc rhs st in
        case infer-let-binding classes kinds families bound locals sp at name rest body level wanted (map-term-types (relocate-local-index id level) (map-term-types (normalize st) inner)) st of
          (result, done) -> (CLet s (core-type result) id display sc rhs result, done)
      other -> term-error at "dependent let result has no retained witness scope" st)
    else let (scheme, pairs) = generalize-with level (\u -> env-metas env st) (core-type value) st in
      case fresh-id (restore-level level st) of
        (id, fresh) -> case let-binding at env name scheme id level value fresh of
          (binding, prepared) -> case infer-let-with-expected classes kinds families (proof-let-env env binding id scheme value prepared) locals sp rest body wanted prepared of
            (result, done) -> (CLet at (core-type result) id name scheme (abstract-term st pairs value) result, done)
  memo-demand-head :: List CheckedBinding -> Expr -> Bool
  memo-demand-head env expression = case expression of
    EVar sp name -> same name "b.demand" && (case lookup-binding name env of
      Some (MkSyntaxBinding symbol) -> same symbol name
      other -> False)
    other -> False
  memo-demand-term :: Span -> UType -> CoreTerm -> CoreTerm
  memo-demand-term sp cell value =
    CPrimitive sp (memo-demand-type cell) "memo-demand" (CArgument sp value (CArgumentsEnd sp))
  infer-memo-demand :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Store -> (CoreTerm, Store)
  infer-memo-demand classes kinds families env locals sp input st = case input of
    EVar at name -> (case lookup-binding name env of
      Some (MkMemoBinding source ty id) -> (memo-demand-term sp (normalize st ty) (CLocal at ty id source Nil), st)
      other -> check-memo-demand classes kinds families env locals sp input st)
    other -> check-memo-demand classes kinds families env locals sp input st
  check-memo-demand :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Store -> (CoreTerm, Store)
  check-memo-demand classes kinds families env locals sp input st = case infer classes kinds families env locals input st of
    (value, checked) -> let carrier = normalize checked (core-type value) in
      (case lazy-parts carrier of
        Some parts -> (memo-demand-term sp carrier value, checked)
        None -> term-error sp "demand expects a checked Lazy cell" checked)

  data LocalStep where
    StrictValueStep :: Span -> Nat -> String -> Scheme -> CoreTerm -> LocalStep
    StrictPatternStep :: Span -> CorePattern -> CoreTerm -> LocalStep
  data MemoLocal where
    MemoLocal :: Span -> String -> Nat -> UType -> UType -> UType -> Expr -> MemoLocal

  group-signatures :: Expr -> List (String, TypeExpr)
  group-signatures bindings = case bindings of
    ELocalSignature sp name ty rest -> Cons (name, ty) (group-signatures rest)
    ELocalStrict sp pattern value rest -> group-signatures rest
    ELocalMemo sp name value rest -> group-signatures rest
    other -> Nil
  group-signature :: String -> List (String, TypeExpr) -> Option TypeExpr
  group-signature wanted signatures = case signatures of
    Nil -> None
    Cons (name, ty) rest -> if same wanted name then Some ty else group-signature wanted rest
  checked-local-signature :: TypeContext -> List CheckedBinding -> List (String, UType) -> TypeExpr -> Store -> (UType, Store)
  checked-local-signature kinds env locals syntax st = case convert False kinds (value-locals env locals) syntax st of
    (ty, checked) -> (ty, expect-type (type-expr-span syntax) ty checked)
  open-memo-locals :: TypeContext -> List CheckedBinding -> List (String, UType) -> List (String, TypeExpr) -> UType -> Expr -> Store -> (List CheckedBinding, List MemoLocal, Store)
  open-memo-locals kinds env locals signatures region bindings st = case bindings of
    ELocalMemo sp name value rest -> case fresh-meta KRow st of
      (row, opened) -> (case (case group-signature name signatures of
        Some annotation -> checked-local-signature kinds env locals annotation opened
        None -> fresh-meta KType opened) of
        (carrier, ready) -> (case fresh-id ready of
          (id, fresh) -> let bound = Cons (MkMemoBinding name (lazy-type row region carrier) id) env in
            (case open-memo-locals kinds bound locals signatures region rest fresh of
              (complete, more, done) -> (complete, Cons (MemoLocal sp name id region row carrier value) more, done))))
    ELocalStrict sp pattern value rest -> open-memo-locals kinds env locals signatures region rest st
    ELocalSignature sp name ty rest -> open-memo-locals kinds env locals signatures region rest st
    ELocalEnd sp -> (env, Nil, st)
    other -> (env, Nil, add-error (expr-span bindings) "malformed local binding group" st)
  infer-group-rhs :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> List (String, TypeExpr) -> Pat -> Expr -> Store -> (CoreTerm, Store)
  infer-group-rhs classes kinds families env locals signatures pattern syntax st =
    case (case pattern of PVar sp name -> group-signature name signatures; other -> None) of
      Some annotation -> (case checked-local-signature kinds env locals annotation st of
        (ty, checked) -> check classes kinds families env locals syntax ty checked)
      None -> infer classes kinds families env locals syntax st
  infer-group-strict :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> List (String, TypeExpr) -> Expr -> Store -> (List CheckedBinding, List LocalStep, Store)
  infer-group-strict classes kinds families env locals signatures bindings st = case bindings of
    ELocalStrict sp pattern syntax rest -> let level = store-level st in
      (case infer-group-rhs classes kinds families env locals signatures pattern syntax (enter-level st) of
        (term, checked) -> (case resolve-dictionary-term-with classes (env-instances env) (env-givens env) term checked of
          (value, prepared) -> (case bind-group-value classes kinds families env locals sp pattern level value prepared of
            (bound, step, ready) -> (case infer-group-strict classes kinds families bound locals signatures rest ready of
              (finished, steps, done) -> (finished, Cons step steps, done)))))
    ELocalMemo sp name syntax rest -> infer-group-strict classes kinds families env locals signatures rest st
    ELocalSignature sp name ty rest -> infer-group-strict classes kinds families env locals signatures rest st
    ELocalEnd sp -> (env, Nil, st)
    other -> (env, Nil, add-error (expr-span bindings) "malformed local binding group" st)
  bind-group-value :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Pat -> Nat -> CoreTerm -> Store -> (List CheckedBinding, LocalStep, Store)
  bind-group-value classes kinds families env locals sp pattern level value st = case pattern of
    PVar at name -> let (scheme, pairs) = generalize-with level (\u -> env-metas env st) (core-type value) st in
      (case fresh-id (restore-level level st) of
        (id, fresh) -> (case let-binding at env name scheme id level value fresh of
          (binding, ready) -> (proof-let-env env binding id scheme value ready,
            StrictValueStep at id name scheme (abstract-term st pairs value), ready)))
    other -> let ty = core-type value in let written = proof-env-after-term env value st in
      (case bind-pattern classes kinds families written locals pattern ty (restore-level level st) of
        (bound, checked, ready) -> (proof-case-env sp bound value checked True ready, StrictPatternStep sp checked value,
          ensure-coverage sp families env [ty] [[pattern]] ready))
  local-step-terms :: List LocalStep -> CoreTerm -> CoreTerm
  local-step-terms steps result = case steps of
    Nil -> result
    Cons first rest -> let inside = local-step-terms rest result in
      (case first of
        StrictValueStep sp id name scheme value -> CLet sp (core-type inside) id name scheme value inside
        StrictPatternStep sp pattern value -> CCase sp (core-type inside) value (CAlternative sp pattern inside (CAlternativesEnd sp)))
  memo-allocation-terms :: List MemoLocal -> CoreTerm -> CoreTerm
  memo-allocation-terms cells result = case cells of
    Nil -> result
    Cons (MemoLocal sp name id region row carrier syntax) rest ->
      let cell = lazy-type row region carrier in
      let inside = memo-allocation-terms rest result in
      CLet sp (core-type inside) id name (mono cell) (CPrimitive sp cell "memo-alloc" (CArgumentsEnd sp)) inside
  infer-memo-bodies :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> List MemoLocal -> Store -> (List (Nat, LocalStep), Store)
  infer-memo-bodies classes kinds families env locals cells st = case cells of
    Nil -> (Nil, st)
    Cons (MemoLocal sp name id region row carrier syntax) rest ->
      let captured = proof-env-after-writes env [(sp, None)] st in
      (case check classes kinds families captured locals syntax carrier st of
        (value, checked) -> let effects = normalize checked (core-effects (map-term-types (normalize checked) value)) in
          let allowed = (if scope-region-closed region effects then unify sp row effects checked else
            add-error (expr-span syntax) "this memo binding demands its own memo group" checked) in
          (case fresh-id allowed of
            (temporary, ready) -> let cell = lazy-type row region carrier in
              let unit = primitive-type "Unit" in
              let callback = CLambda sp (UFunEff unit row carrier) (CPWild sp unit) value in
              let initial = CPrimitive sp unit "memo-init" (CArgument sp (CLocal sp cell id name Nil)
                (CArgument sp callback (CArgumentsEnd sp))) in
              (case infer-memo-bodies classes kinds families env locals rest ready of
                (more, done) -> (Cons (id, StrictValueStep sp temporary "#memo-init" (mono unit) initial) more, done))))
  step-value :: LocalStep -> CoreTerm
  step-value step = case step of StrictValueStep sp id name scheme value -> value; StrictPatternStep sp pattern value -> value
  step-span :: LocalStep -> Span
  step-span step = case step of StrictValueStep sp id name scheme value -> sp; StrictPatternStep sp pattern value -> sp
  step-ids :: LocalStep -> List Nat
  step-ids step = case step of StrictValueStep sp id name scheme value -> [id]; StrictPatternStep sp pattern value -> task-pattern-ids pattern
  strict-ids :: List LocalStep -> List Nat
  strict-ids steps = case steps of Nil -> Nil; Cons first rest -> step-ids first <> strict-ids rest
  memo-id-present :: Nat -> List Nat -> Bool
  memo-id-present id ids = case ids of Nil -> False; Cons first rest -> id == first || memo-id-present id rest
  captures-strict :: List Nat -> List (Nat, UType) -> Bool
  captures-strict unbound free = case free of
    Nil -> False
    Cons (id, ty) rest -> memo-id-present id unbound || captures-strict unbound rest
  ready-memos :: List Nat -> List (Nat, LocalStep) -> (List LocalStep, List (Nat, LocalStep))
  ready-memos unbound pending = case pending of
    Nil -> (Nil, Nil)
    Cons (id, step) rest -> case ready-memos unbound rest of
      (ready, waiting) -> if captures-strict unbound (task-free Nil (step-value step)) then
        (ready, Cons (id, step) waiting) else (Cons step ready, waiting)
  memo-links :: List (Nat, LocalStep) -> List (Nat, List Nat)
  memo-links pending = case pending of Nil -> Nil; Cons (id, step) rest -> Cons (id, [id]) (memo-links rest)
  linked-memos :: Nat -> List (Nat, List Nat) -> List Nat
  linked-memos id links = case links of Nil -> Nil; Cons (key, refs) rest -> if id == key then refs else linked-memos id rest
  referenced-memos :: List (Nat, UType) -> List (Nat, List Nat) -> List Nat
  referenced-memos free links = case free of
    Nil -> Nil
    Cons (id, ty) rest -> linked-memos id links <> referenced-memos rest links
  bind-memo-links :: List Nat -> List Nat -> List (Nat, List Nat) -> List (Nat, List Nat)
  bind-memo-links ids refs links = case ids of Nil -> links; Cons id rest -> Cons (id, refs) (bind-memo-links rest refs links)
  pending-memo-demand :: List Nat -> List (Nat, LocalStep) -> Bool
  pending-memo-demand refs waiting = case waiting of
    Nil -> False
    Cons (id, step) rest -> (case refs of Nil -> True; other -> memo-id-present id refs) || pending-memo-demand refs rest
  schedule-memo-steps :: UType -> List LocalStep -> List (Nat, LocalStep) -> List (Nat, List Nat) -> Store -> (List LocalStep, Store)
  schedule-memo-steps region strict pending links st = case ready-memos (strict-ids strict) pending of
    (ready, waiting) -> case strict of
      Nil -> (ready, st)
      Cons step rest -> let value = map-term-types (normalize st) (step-value step) in
        let refs = referenced-memos (task-free Nil value) links in
        let checked = (if not (scope-region-closed region (core-effects value)) && pending-memo-demand refs waiting then
            add-error (step-span step) "a strict binding demands a memo before its captured locals are initialized" st
          else st) in
        (case schedule-memo-steps region rest waiting (bind-memo-links (step-ids step) refs links) checked of
          (more, done) -> (ready <> Cons step more, done))
  infer-local-group :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Expr -> Option UType -> Store -> (CoreTerm, Store)
  infer-local-group classes kinds families env locals sp bindings syntax wanted st =
    let level = store-level st in
    let signatures = group-signatures bindings in
    (case fresh-id (enter-level st) of
      (id, opened) -> let region = URigid id "memo" (store-level opened) KRegion in
        (case open-memo-locals kinds env locals signatures region bindings opened of
          (memos, cells, prepared) -> (case infer-group-strict classes kinds families memos locals signatures bindings prepared of
            (bound, strict, checked) -> (case infer-memo-bodies classes kinds families bound locals cells checked of
              (initial, ready) -> (case (case wanted of
                Some expected -> check classes kinds families bound locals syntax expected ready
                None -> infer classes kinds families bound locals syntax ready) of
                (body, done) ->
                  (case cells of
                    Nil -> (local-step-terms strict body, restore-level level done)
                    other -> case schedule-memo-steps region strict initial (memo-links initial) done of
                      (steps, scheduled) ->
                        let term = memo-allocation-terms cells (local-step-terms steps body) in
                        let closed = restore-level level scheduled in
                        let result = normalize scheduled (core-type body) in
                        -- Solved row variables inside nested calls can
                        -- introduce this scope's Eval label.
                        if scope-region-closed region result then
                          (CMemoScope sp result region (map-term-types (normalize scheduled) term), closed)
                        else term-error sp "region escape: a value leaves its local memo group" closed))))))

  data RecursiveMember where
    RecursiveMember :: Span -> Nat -> String -> UType -> Expr -> RecursiveMember
  data RecursiveDefinition where
    RecursiveDefinition :: Span -> Nat -> String -> Expr -> CoreTerm -> RecursiveDefinition

  open-recursive-members :: TypeContext -> List CheckedBinding -> List CheckedBinding -> List (String, UType) -> List (String, TypeExpr) -> Expr -> Store -> (List CheckedBinding, List RecursiveMember, Store)
  open-recursive-members kinds outer env locals signatures bindings st = case bindings of
    ELocalStrict sp pattern syntax rest -> (case pattern of
      PVar at name -> open-recursive-member kinds outer env locals signatures at name syntax rest st
      PWild at -> open-recursive-member kinds outer env locals signatures at "" syntax rest st
      other -> (env, Nil, add-error sp "a letrec binding needs a name equation or a memo binding" st))
    ELocalSignature sp name ty rest -> open-recursive-members kinds outer env locals signatures rest st
    ELocalMemo sp name syntax rest -> open-recursive-members kinds outer env locals signatures rest st
    ELocalEnd sp -> (env, Nil, st)
    other -> (env, Nil, add-error (expr-span bindings) "malformed recursive binding group" st)
  open-recursive-member :: TypeContext -> List CheckedBinding -> List CheckedBinding -> List (String, UType) -> List (String, TypeExpr) -> Span -> String -> Expr -> Expr -> Store -> (List CheckedBinding, List RecursiveMember, Store)
  open-recursive-member kinds outer env locals signatures sp name syntax rest st =
    (case (case group-signature name signatures of
      Some annotation -> checked-local-signature kinds outer locals annotation st
      None -> fresh-meta KType st) of
      (ty, checked) -> case fresh-id checked of
        (id, fresh) ->
          let bound = if same name "" then env else Cons (MkLocalBinding name (mono ty) id (store-level fresh)) env in
          (case open-recursive-members kinds outer bound locals signatures rest fresh of
            (all, members, ready) -> (all, Cons (RecursiveMember sp id name ty syntax) members, ready)))
  check-recursive-members :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> List RecursiveMember -> Store -> (List RecursiveDefinition, Store)
  check-recursive-members classes kinds families env locals members st = case members of
    Nil -> (Nil, st)
    Cons (RecursiveMember sp id name ty syntax) rest -> case check classes kinds families env locals syntax ty st of
      (value, checked) -> case check-recursive-members classes kinds families env locals rest checked of
        (more, done) -> (Cons (RecursiveDefinition sp id name syntax value) more, done)

  recursive-edges :: Bool -> CoreTerm -> List (Nat, Bool)
  recursive-edges guarded term = case term of
    CLocal sp ty id name actuals -> [(id, guarded)] <> recursive-child-edges guarded (term-children term)
    CLambda sp ty pattern body -> recursive-edges True body
    CPrimitive sp ty op args -> recursive-child-edges (guarded || same op "thunk-delay") (term-children term)
    other -> recursive-child-edges guarded (term-children term)
  recursive-child-edges :: Bool -> List CoreTerm -> List (Nat, Bool)
  recursive-child-edges guarded terms = case terms of
    Nil -> Nil
    Cons first rest -> recursive-edges guarded first <> recursive-child-edges guarded rest
  recursive-graph :: List RecursiveDefinition -> List (Nat, List (Nat, Bool))
  recursive-graph definitions = case definitions of
    Nil -> Nil
    Cons (RecursiveDefinition sp id name syntax value) rest ->
      Cons (id, recursive-edges False value) (recursive-graph rest)
  edges-from :: Nat -> List (Nat, List (Nat, Bool)) -> List (Nat, Bool)
  edges-from id graph = case graph of
    Nil -> Nil
    Cons (key, edges) rest -> if id == key then edges else edges-from id rest
  reaches-recursive-member :: Nat -> List (Nat, Bool) -> List (Nat, List (Nat, Bool)) -> List Nat -> Bool
  reaches-recursive-member wanted pending graph seen = case pending of
    Nil -> False
    Cons (id, guarded) rest ->
      if id == wanted then True
      else if contains-meta id seen then reaches-recursive-member wanted rest graph seen
      else reaches-recursive-member wanted (edges-from id graph <> rest) graph (Cons id seen)
  eager-recursive-edge :: Nat -> List (Nat, Bool) -> List (Nat, List (Nat, Bool)) -> Option Nat
  eager-recursive-edge owner edges graph = case edges of
    Nil -> None
    Cons (id, guarded) rest ->
      if not guarded && (id == owner || reaches-recursive-member owner (edges-from id graph) graph Nil) then Some id
      else eager-recursive-edge owner rest graph
  recursive-memo-graph :: List (Nat, LocalStep) -> List (Nat, List (Nat, Bool))
  recursive-memo-graph initializers = case initializers of
    Nil -> Nil
    Cons (id, step) rest -> case step-value step of
      CPrimitive sp ty op (CArgument cell-span cell (CArgument callback-span callback (CArgumentsEnd end))) ->
        Cons (id, recursive-edges True callback) (recursive-memo-graph rest)
      other -> recursive-memo-graph rest
  recursive-names :: List RecursiveDefinition -> List (Nat, String)
  recursive-names definitions = case definitions of
    Nil -> Nil
    Cons (RecursiveDefinition sp id name syntax value) rest -> Cons (id, name) (recursive-names rest)
  recursive-memo-names :: List MemoLocal -> List (Nat, String)
  recursive-memo-names cells = case cells of
    Nil -> Nil
    Cons (MemoLocal sp name id region row carrier syntax) rest -> Cons (id, name) (recursive-memo-names rest)
  recursive-member-name :: Nat -> List (Nat, String) -> String
  recursive-member-name id names = case names of
    Nil -> ""
    Cons (key, name) rest -> if id == key then name else recursive-member-name id rest
  recursive-guard-error :: List RecursiveDefinition -> List (Nat, String) -> List (Nat, List (Nat, Bool)) -> Option (Span, String)
  recursive-guard-error pending names graph = case pending of
    Nil -> None
    Cons (RecursiveDefinition sp id name syntax value) rest ->
      (case eager-recursive-edge id (edges-from id graph) graph of
        Some dependency -> Some (sp, recursive-member-name dependency names)
        None -> recursive-guard-error rest names graph)

  recursive-member-ids :: List RecursiveDefinition -> List Nat
  recursive-member-ids definitions = case definitions of
    Nil -> Nil
    Cons (RecursiveDefinition sp id name syntax value) rest -> Cons id (recursive-member-ids rest)
  recursive-dependencies-ready :: List (Nat, Bool) -> List Nat -> Bool
  recursive-dependencies-ready edges pending = case edges of
    Nil -> True
    Cons (id, guarded) rest -> not (contains-meta id pending) && recursive-dependencies-ready rest pending
  recursive-member-in-order :: Nat -> List Nat -> Bool
  recursive-member-in-order id order = case order of
    Nil -> True
    Cons first rest -> id == first || not (contains-meta id rest)
  advance-recursive-order :: Nat -> List Nat -> List Nat
  advance-recursive-order id order = case order of
    Cons first rest | id == first -> rest
    other -> order
  pick-recursive-member :: List RecursiveDefinition -> List RecursiveDefinition -> List Nat -> List (Nat, List (Nat, Bool)) -> List Nat -> Option (RecursiveDefinition, List RecursiveDefinition)
  pick-recursive-member definitions before pending graph order = case definitions of
    Nil -> None
    Cons (RecursiveDefinition sp id name syntax value) rest ->
      let member = RecursiveDefinition sp id name syntax value in
      if recursive-member-in-order id order && recursive-dependencies-ready (edges-from id graph) pending
      then Some (member, reverse before <> rest)
      else pick-recursive-member rest (Cons member before) pending graph order
  order-recursive-members :: List RecursiveDefinition -> List (Nat, List (Nat, Bool)) -> List Nat -> List RecursiveDefinition -> Option (List RecursiveDefinition)
  order-recursive-members pending graph observations ordered = case pending of
    Nil -> Some (reverse ordered)
    Cons first rest -> case pick-recursive-member pending Nil (recursive-member-ids pending) graph observations of
      Some (RecursiveDefinition sp id name syntax value, more) ->
        order-recursive-members more graph (advance-recursive-order id observations)
          (Cons (RecursiveDefinition sp id name syntax value) ordered)
      None -> None
  -- Borrow reads, writes and opaque calls can observe order even when the
  -- checked effect row is empty. Only stable initializers may move past them.
  -- A group function applied to fewer arguments than it takes only builds
  -- a closure, so the application is stable.
  stable-recursive-initializer :: List RecursiveDefinition -> CoreTerm -> Bool
  stable-recursive-initializer group value = case value of
    CInt sp ty text -> True
    CString sp ty text -> True
    CChar sp ty text -> True
    CUnit sp ty -> True
    CLocal sp ty id name actuals -> True
    CLambda sp ty pattern body -> True
    CUse sp ty name role actuals -> same role "constructor"
    CApply sp ty f x -> (stable-recursive-constructor group f || partial-recursive-application group value)
      && stable-recursive-initializer group x
    CPrimitive sp ty operation args -> has operation ["+", "-", "*", "/", "<", "<=", ">", ">=", "==", "/=", "negate"]
      && stable-recursive-initializer group args
    CArgument sp value rest -> stable-recursive-initializer group value && stable-recursive-initializer group rest
    CArgumentsEnd sp -> True
    CTuple sp ty fields -> stable-recursive-initializer group fields
    CLet sp ty id name sc rhs body -> stable-recursive-initializer group rhs && stable-recursive-initializer group body
    CIf sp ty condition yes no -> stable-recursive-initializer group condition && stable-recursive-initializer group yes && stable-recursive-initializer group no
    CProved sp ty evidence body -> stable-recursive-initializer group body
    CForget sp ty body -> stable-recursive-initializer group body
    other -> False
  stable-recursive-constructor :: List RecursiveDefinition -> CoreTerm -> Bool
  stable-recursive-constructor group value = case value of
    CUse sp ty name role actuals -> same role "constructor"
    CApply sp ty f x -> stable-recursive-constructor group f && stable-recursive-initializer group x
    other -> False
  partial-recursive-application :: List RecursiveDefinition -> CoreTerm -> Bool
  partial-recursive-application group value = case application-head value 0 of
    (CLocal sp ty id name actuals, applied) -> (case recursive-callable group id 0 Nil of
      Some (callee, remaining) -> applied < remaining
      None -> False)
    other -> False
  application-head :: CoreTerm -> Nat -> (CoreTerm, Nat)
  application-head term applied = case term of
    CApply sp ty f x -> application-head f (applied + 1)
    CApplyEff sp ty row f x -> application-head f (applied + 1)
    other -> (term, applied)
  lambda-arity :: CoreTerm -> Nat
  lambda-arity value = case value of
    CLambda sp ty pattern body -> 1 + lambda-arity body
    other -> 0
  recursive-definition-value :: Nat -> List RecursiveDefinition -> Option CoreTerm
  recursive-definition-value id definitions = case definitions of
    Nil -> None
    Cons (RecursiveDefinition sp key name syntax value) rest -> if id == key then Some value else recursive-definition-value id rest
  -- Follow group aliases and partial applications to the group function a
  -- call enters, with the arguments it still needs before its body runs.
  recursive-callable :: List RecursiveDefinition -> Nat -> Nat -> List Nat -> Option (Nat, Nat)
  recursive-callable group member arguments seen =
    if contains-meta member seen then None else case recursive-definition-value member group of
      None -> None
      Some value -> case value of
        CLambda sp ty pattern body -> let arity = lambda-arity value in
          if arguments < arity then Some (member, arity - arguments) else None
        other -> case application-head value 0 of
          (CLocal sp ty alias name actuals, applied) -> recursive-callable group alias (arguments + applied) (Cons member seen)
          other -> None
  -- Uses of group members: the target, the number of enclosing suspensions
  -- (lambdas and delays), and the number of arguments applied to it.
  recursive-uses :: Nat -> CoreTerm -> List (Nat, Nat, Nat)
  recursive-uses depth term = case term of
    CLocal sp ty id name actuals -> Cons (id, depth, 0) (recursive-child-uses depth (term-children term))
    CApply sp ty f x -> recursive-application-uses depth term Nil
    CApplyEff sp ty row f x -> recursive-application-uses depth term Nil
    CLambda sp ty pattern body -> recursive-uses (depth + 1) body
    CPrimitive sp ty op args -> recursive-child-uses (if same op "thunk-delay" then depth + 1 else depth) (term-children term)
    other -> recursive-child-uses depth (term-children term)
  recursive-child-uses :: Nat -> List CoreTerm -> List (Nat, Nat, Nat)
  recursive-child-uses depth terms = case terms of
    Nil -> Nil
    Cons first rest -> recursive-uses depth first <> recursive-child-uses depth rest
  recursive-application-uses :: Nat -> CoreTerm -> List CoreTerm -> List (Nat, Nat, Nat)
  recursive-application-uses depth term arguments = case term of
    CApply sp ty f x -> recursive-application-uses depth f (Cons x arguments)
    CApplyEff sp ty row f x -> recursive-application-uses depth f (Cons x arguments)
    CLocal sp ty id name actuals -> Cons (id, depth, list-length arguments) (recursive-child-uses depth (term-children term <> arguments))
    other -> recursive-uses depth other <> recursive-child-uses depth arguments
  recursive-use-graph :: List RecursiveDefinition -> List (Nat, List (Nat, Nat, Nat))
  recursive-use-graph definitions = case definitions of
    Nil -> Nil
    Cons (RecursiveDefinition sp id name syntax value) rest -> Cons (id, recursive-uses 0 value) (recursive-use-graph rest)
  uses-from :: Nat -> List (Nat, List (Nat, Nat, Nat)) -> List (Nat, Nat, Nat)
  uses-from id graph = case graph of
    Nil -> Nil
    Cons (key, uses) rest -> if id == key then uses else uses-from id rest
  uses-at :: Nat -> List (Nat, Nat, Nat) -> List (Nat, Nat, Nat)
  uses-at depth uses = case uses of
    Nil -> Nil
    Cons (member, at, applied) rest -> if at == depth then Cons (member, at, applied) (uses-at depth rest) else uses-at depth rest
  -- Initializing a member evaluates its unsuspended uses. A saturated call
  -- of a group function also evaluates that function's body; storing a
  -- closure does not read the boxes it captures.
  required-members :: List RecursiveDefinition -> List (Nat, List (Nat, Nat, Nat)) -> List (Nat, Nat, Nat) -> List Nat -> List (Nat, Bool)
  required-members group graph pending entered = case pending of
    Nil -> Nil
    Cons (member, depth, applied) rest ->
      let entry = (if applied == 0 then None else case recursive-callable group member 0 Nil of
            Some (callee, remaining) -> if applied >= remaining && not (contains-meta callee entered) then Some callee else None
            None -> None) in
      case entry of
        Some callee -> let body = (case recursive-definition-value callee group of
              Some value -> lambda-arity value
              None -> 0) in
          Cons (member, False) (required-members group graph (uses-at body (uses-from callee graph) <> rest) (Cons callee entered))
        None -> Cons (member, False) (required-members group graph rest entered)
  recursive-dependency-graph :: List RecursiveDefinition -> List (Nat, List (Nat, Nat, Nat)) -> List RecursiveDefinition -> List (Nat, List (Nat, Bool))
  recursive-dependency-graph group graph pending = case pending of
    Nil -> Nil
    Cons (RecursiveDefinition sp id name syntax value) rest ->
      Cons (id, required-members group graph (uses-at 0 (uses-from id graph)) Nil) (recursive-dependency-graph group graph rest)
  recursive-observation-order :: Store -> List RecursiveDefinition -> List RecursiveDefinition -> List Nat
  recursive-observation-order st group definitions = case definitions of
    Nil -> Nil
    Cons (RecursiveDefinition sp id name syntax value) rest ->
      let effects = normalize st (core-effects (map-term-types (normalize st) value)) in
      let more = recursive-observation-order st group rest in
      case effects of
        URow UEnd -> if stable-recursive-initializer group value then more else Cons id more
        other -> Cons id more
  ordered-recursive-bindings :: Span -> List RecursiveDefinition -> Expr
  ordered-recursive-bindings sp definitions = case definitions of
    Nil -> ELocalEnd sp
    Cons (RecursiveDefinition at id name syntax value) rest ->
      let pattern = if same name "" then PWild at else PVar at name in
      ELocalStrict at pattern syntax (ordered-recursive-bindings sp rest)
  recursive-group-bindings :: Expr -> Expr -> Expr
  recursive-group-bindings original ordered = case original of
    ELocalStrict sp pattern syntax rest -> recursive-group-bindings rest ordered
    ELocalSignature sp name ty rest -> ELocalSignature sp name ty (recursive-group-bindings rest ordered)
    ELocalMemo sp name syntax rest -> ELocalMemo sp name syntax (recursive-group-bindings rest ordered)
    other -> ordered
  checked-recursive-closures :: List RecursiveDefinition -> Option (CoreTerm)
  checked-recursive-closures definitions = case definitions of
    Nil -> Some CRecursiveBindingsEnd
    Cons (RecursiveDefinition at id name syntax (CLambda sp ty pattern body)) rest | not (same name "") ->
      case checked-recursive-closures rest of
        Some more -> Some (CRecursiveBinding id name (CLambda sp ty pattern body) more)
        None -> None
    other -> None

  recursive-knot-name :: List RecursiveDefinition -> List (Nat, List (Nat, Bool)) -> String
  recursive-knot-name definitions graph = case definitions of
    Nil -> "letrec"
    Cons (RecursiveDefinition sp id name syntax value) rest ->
      if not (same name "") && reaches-recursive-member id (edges-from id graph) graph Nil then name else recursive-knot-name rest graph

  recursive-value-spine :: List RecursiveDefinition -> CoreTerm
  recursive-value-spine definitions = case definitions of
    Nil -> CRecursiveBindingsEnd
    Cons (RecursiveDefinition sp id name syntax value) rest -> CRecursiveBinding id name value (recursive-value-spine rest)

  infer-recursive-values :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Nat -> List RecursiveDefinition -> List (Nat, List (Nat, Bool)) -> Expr -> Option UType -> Store -> (CoreTerm, Store)
  infer-recursive-values classes kinds families env locals sp id definitions graph body wanted st =
    case order-recursive-members definitions (recursive-dependency-graph definitions (recursive-use-graph definitions) definitions) (recursive-observation-order st definitions definitions) Nil of
      None -> term-error sp "recursive initializers cannot satisfy their dependencies in source evaluation order" st
      Some ordered ->
        let members = recursive-value-spine ordered in
        let live = proof-env-after-writes env (recursive-value-writes members) st in
        let region = URigid id ("#" <> recursive-knot-name definitions graph) (store-level st) KRegion in
        (case (case wanted of
          Some expected -> check classes kinds families live locals body expected st
          None -> infer classes kinds families live locals body st) of
          (result, done) -> (CRecursiveValues sp (core-type result) region members result, done))

  infer-recursive-group :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Expr -> Option UType -> Store -> (CoreTerm, Store)
  infer-recursive-group classes kinds families env locals sp bindings body wanted st =
    let signatures = group-signatures bindings in
    (case fresh-id (enter-level st) of
      (id, opened) -> let region = URigid id "letrec" (store-level opened) KRegion in
        (case open-memo-locals kinds env locals signatures region bindings opened of
          (memos, cells, prepared) -> case open-recursive-members kinds env memos locals signatures bindings prepared of
            (bound, members, ready) -> case check-recursive-members classes kinds families bound locals members ready of
              (definitions, checked) -> (case infer-memo-bodies classes kinds families bound locals cells checked of
                (initializers, typed) ->
                  let strict-graph = recursive-graph definitions in
                  let all-edges = strict-graph <> recursive-memo-graph initializers in
                  let names = recursive-names definitions <> recursive-memo-names cells in
                  (case recursive-guard-error definitions names all-edges of
                    Some (at, name) -> term-error at ("unguarded recursion through `" <> name <> "`; wrap the use in delay or a lambda") st
                    None -> case store-errors typed of
                      Cons error rest -> (CError sp, restore-level (store-level st) typed)
                      Nil -> case order-recursive-members definitions strict-graph (recursive-observation-order typed definitions definitions) Nil of
                        -- Without a lexical order, values tie a knot: an
                        -- initializer may store a closure over a later box.
                        None -> (case (cells, checked-recursive-closures definitions) of
                          (Nil, Some closures) -> (case order-recursive-members definitions strict-graph Nil Nil of
                            None -> (case (case wanted of
                              Some expected -> check classes kinds families bound locals body expected typed
                              None -> infer classes kinds families bound locals body typed) of
                              (result, done) -> (CRecursiveFunctions sp (core-type result) closures result, restore-level (store-level st) done))
                            Some other -> term-error sp "recursive initializers cannot satisfy their dependencies in source evaluation order" st)
                          (Nil, None) -> (case infer-recursive-values classes kinds families bound locals sp id definitions strict-graph body wanted typed of
                            (result, done) -> (result, restore-level (store-level st) done))
                          other -> term-error sp "guarded recursive value bindings with memo cells need joint scope checking" st)
                        Some ordered ->
                          infer-local-group classes kinds families env locals sp
                            (recursive-group-bindings bindings (ordered-recursive-bindings sp ordered)) body wanted st))))

  infer-operator :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> String -> Expr -> Expr -> Store -> (CoreTerm, Store)
  infer-operator classes kinds families env locals sp op a b st =
    if has op ["&&", "||"] then
      case check classes kinds families env locals a (primitive-type "Bool") st of
        (first, sa) -> case check classes kinds families (proof-branch (expr-span a) env first (same op "&&") sa) locals b (primitive-type "Bool") sa of
          (second, sb) ->
            let boolean = primitive-type "Bool" in
            if same op "&&" then (CIf sp boolean first second (CUse sp boolean "False" "constructor" Nil), sb)
            else (CIf sp boolean first (CUse sp boolean "True" "constructor" Nil) second, sb)
    else if has op ["+", "-", "*", "/", "<", ">", "<=", ">="] then
      case infer classes kinds families env locals a st of
        (inferred, sa) ->
          let first = project-comparison sp inferred sa in
          let carrier = case normalize sa (core-type first) of
                UCon name KType -> if same name "Nat" then primitive-type "Nat" else primitive-type "Int"
                other -> primitive-type "Int" in
          let sorted = unify sp (core-type first) carrier sa in
          case check classes kinds families env locals b carrier sorted of
            (second, sb) -> let operation = CPrimitive sp (if has op ["+", "-", "*", "/"] then carrier else primitive-type "Bool") op (CArgument sp first (CArgument sp second (CArgumentsEnd sp))) in
              if same op "-" && same (type-text carrier) "Nat" then
                (case scoped-prove-subtraction (proof-context env sb) (proof-facts env) (map-term-types (normalize sb) first) (map-term-types (normalize sb) second) of
                  Some evidence -> (CProved sp carrier evidence operation, sb)
                  None -> term-error sp "Nat subtraction needs checked ordering evidence" sb)
              else if same op "/" then
                (case scoped-prove-division (proof-context env sb) (proof-facts env) (map-term-types (normalize sb) first) (map-term-types (normalize sb) second) of
                  Some evidence -> (CProved sp carrier evidence operation, sb)
                  None -> term-error sp "division needs checked NonZero evidence for its divisor" sb)
              else (operation, sb)
    else if has op ["==", "/="] then case infer classes kinds families env locals a st of
      (inferred, sa) -> let first = project-comparison sp inferred sa in case check classes kinds families env locals b (core-type first) sa of
        (second, sb) -> (CPrimitive sp (primitive-type "Bool") op (CArgument sp first (CArgument sp second (CArgumentsEnd sp))),
          if comparable (normalize sb (core-type first)) then sb else case normalize sb (core-type first) of
            UMeta id KType -> pending-comparison sp (core-type first) comparable-names sb
            other -> add-error sp "equality needs an Eq dictionary for this type" sb)
    else term-error sp "operator needs dictionary or NonZero proof elaboration" st
  comparable-names :: List String
  comparable-names = ["Int", "Nat", "Bool", "Unit", "String", "Char", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64", "Isize", "Usize", global-data-string-string]
  comparable :: UType -> Bool
  comparable ty = case ty of UCon name KType -> has name comparable-names; other -> False
  tuple-type :: UType -> UType
  tuple-type xs = case xs of UEnd -> primitive-type "Unit"; other -> UTuple xs

  pattern-names :: Pat -> List String
  pattern-names p = case p of
    PVar s name -> Cons name Nil
    PAs s name inner -> Cons name (pattern-names inner)
    PAnn s inner ty -> pattern-names inner
    PCon s name args -> pattern-names args
    PTuple s args -> pattern-names args
    PArg s x rest -> pattern-names x <> pattern-names rest
    other -> Nil
  duplicate-names :: Span -> List String -> List String -> Store -> Store
  duplicate-names sp names seen st = case names of
    Nil -> st
    Cons name rest -> duplicate-names sp rest (Cons name seen)
      (if has name seen then add-error sp (string-concat-all ["duplicate pattern binder: ", name, " is bound twice"]) st else st)
  patterns-names :: List Pat -> List String
  patterns-names ps = case ps of Nil -> Nil; Cons p rest -> pattern-names p <> patterns-names rest
  bind-proof-pattern :: TypeContext -> List CheckedBinding -> List (String, UType) -> Pat -> UType -> Store -> (List CheckedBinding, CorePattern, Store)
  bind-proof-pattern kinds env locals pattern predicate st = case pattern of
    PWild sp -> (case fresh-id st of (id, fresh) -> (env, CPProof sp predicate id "_", fresh))
    PVar sp name -> (case fresh-id st of (id, fresh) -> (Cons (MkErasedBinding name predicate id sp None) env, CPProof sp predicate id name, fresh))
    PAnn sp inner annotation -> (case convert-predicate False kinds (value-locals env locals) annotation st of (actual, checked) -> bind-proof-pattern kinds env locals inner predicate (unify sp predicate actual checked))
    other -> (env, CPWild (pat-span pattern) UError, add-error (pat-span pattern) "erased proof pattern cannot inspect evidence" st)
  bind-pattern :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Pat -> UType -> Store -> (List CheckedBinding, CorePattern, Store)
  bind-pattern classes kinds families env locals pat expected st = case pat of
    PWild s -> (env, CPWild s expected, st)
    PVar s name -> case fresh-id st of
      (id, fresh) -> (Cons (MkLocalBinding name (mono expected) id (store-level fresh)) env, CPVar s expected id name, check-borrow-binding s env expected fresh)
    PAs s name inner -> case fresh-id st of
      (id, fresh) -> case bind-pattern classes kinds families (Cons (MkLocalBinding name (mono expected) id (store-level fresh)) env) locals inner expected (check-borrow-binding s env expected fresh) of
        (bound, pattern, ss) -> (bound, CPAs s expected id name pattern, ss)
    PAnn s inner annotation -> case convert False kinds (value-locals env locals) annotation st of
      (ty, sa) -> bind-pattern classes kinds families env locals inner expected (unify s expected ty (expect-type s ty sa))
    PLitInt s text -> let actual = normalize st expected in
      let carrier = if integer-carrier actual || (case actual of UMeta id KType -> True; other -> False) then expected else primitive-type "Int" in
      case checked-literal s carrier text (unify s expected carrier st) of
        (CInt at ty literal, checked) -> (env, CPInt s expected literal, checked)
        (other, checked) -> (env, CPWild s UError, checked)
    PLitStr s text -> (env, CPString s expected text, unify s expected (literal-type kinds "String") st)
    PLitChar s text -> (env, CPChar s expected text, unify s expected (primitive-type "Char") st)
    PTuple s args -> case pattern-fields args st of
      (fields, sf) -> case bind-pattern-fields classes kinds families env locals args fields (check-tuple-pattern-type s expected fields sf) of
        (bound, patterns, ss) -> (bound, CPTuple s expected patterns, ss)
    PCon s name args -> case lookup-binding name env of
      Some b ->
        if same (checked-role b) "constructor" then
          case open-scheme False (checked-scheme b) st of
            (ty, pairs, ss) -> case foreign-constructor-family families (normalize ss (result-type ty)) (normalize ss expected) of
              Some owner -> (env, CPWild s UError, add-error s (string-concat-all
                ["constructor ", diagnostic-member-name name, " does not belong to type ", diagnostic-member-name owner]) ss)
              None -> case bind-constructor classes kinds families env locals s args ty expected (if list-length (pats-of args) == scheme-arity (checked-scheme b) then ss else add-error s "constructor pattern arity mismatch" ss) of
                (bound, fields, sf) -> (bound, CPConstructor s expected name (actual-types pairs) ty fields, sf)
        else (env, CPWild s UError, add-error s "pattern name is not a constructor" st)
      None -> if codata-name name (context-aliases kinds) then
        (env, CPWild s UError, add-error s "a codata value is observed, not destructured: use .field projection" st)
        else (env, CPWild s UError, add-error s (string-concat "unknown constructor: " name) st)
    PRecord s name fields -> if codata-name name (context-aliases kinds) then
      (env, CPWild s UError, add-error s "a codata value is observed, not destructured: use .field projection" st)
      else (env, CPWild s UError, add-error s "record pattern has no defining field contract" st)
    PUnmodeled s message -> (env, CPWild s UError, add-error s message st)
    other -> (env, CPWild (pat-span pat) UError, add-error (pat-span pat) "pattern needs further elaboration" st)
  foreign-constructor-family :: List (String, List String) -> UType -> UType -> Option String
  foreign-constructor-family families actual expected = case (root-name actual, root-name expected) of
    (Some source, Some owner) -> if same source owner then None else
      (case family-ctors owner families of Some constructors -> Some owner; None -> None)
    other -> None
  check-tuple-pattern-type :: Span -> UType -> UType -> Store -> Store
  check-tuple-pattern-type sp expected fields st = case normalize st expected of
    UTuple existing -> let actual = list-length (spine-list fields) in
      let wanted = list-length (spine-list existing) in
      if actual == wanted then unify sp expected (tuple-type fields) st else
        add-error sp (string-concat-all ["tuple pattern has ", nat-to-string actual,
          " components but the tuple type has ", nat-to-string wanted]) st
    other -> unify sp expected (tuple-type fields) st
  pattern-fields :: Pat -> Store -> (UType, Store)
  pattern-fields ps st = case ps of
    PArgsEnd s -> (UEnd, st)
    PArg s x rest -> case fresh-meta KType st of (ty, ss) -> case pattern-fields rest ss of (ys, sy) -> (UArg ty ys, sy)
    other -> bad (pat-span ps) "malformed pattern spine" st
  bind-pattern-fields :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Pat -> UType -> Store -> (List CheckedBinding, CorePattern, Store)
  bind-pattern-fields classes kinds families env locals ps tys st = case (ps, tys) of
    (PArgsEnd s, UEnd) -> (env, CPDone s, st)
    (PArg s p rest, UArg ty tail) -> case bind-pattern classes kinds families env locals p ty st of
      (bound, pattern, sp) -> case bind-pattern-fields classes kinds families bound locals rest tail sp of
        (final, patterns, ss) -> (final, CPField s pattern patterns, ss)
    other -> (env, CPWild (pat-span ps) UError, add-error (pat-span ps) "tuple pattern arity mismatch" st)
  -- Later fields can depend on the actual payload even when the pattern
  -- leaves it unnamed. Give such a field a private identity in Core.
  indexable-constructor-pattern :: Pat -> Pat
  indexable-constructor-pattern pat = case pat of
    PVar sp name -> pat
    PLitInt sp text -> pat
    PAs sp name inner -> pat
    PAnn sp inner ty -> PAnn sp (indexable-constructor-pattern inner) ty
    PWild sp -> PVar sp "#constructor-field"
    other -> PAs (pat-span pat) "#constructor-field" pat
  bind-constructor :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Pat -> UType -> UType -> Store -> (List CheckedBinding, CorePattern, Store)
  bind-constructor classes kinds families env locals sp ps ty expected st = case ps of
    PArgsEnd s -> (env, CPDone s, unify sp ty expected st)
    PArg s p rest -> case normalize st ty of
      UPi id name domain row result ->
        let field-pattern = if pi-dependent ty then indexable-constructor-pattern p else p in
        (case bind-arrow-pattern classes kinds families env locals field-pattern ty st of
          (bound, pattern, effects, out, checked) ->
            case bind-constructor classes kinds families bound locals sp rest out expected (include-effects s effects (URow UEnd) checked) of
              (final, patterns, done) -> (final, CPField s pattern patterns, done))
      UProofFun predicate row result -> case bind-proof-pattern kinds env locals p predicate (include-effects s row (URow UEnd) st) of
        (bound, pattern, sb) -> case bind-constructor classes kinds families bound locals sp rest result expected sb of
          (final, patterns, done) -> (final, CPField s pattern patterns, done)
      UFun a b -> case bind-pattern classes kinds families env locals p a st of
        (bound, pattern, sb) -> case bind-constructor classes kinds families bound locals sp rest b expected sb of
          (final, patterns, ss) -> (final, CPField s pattern patterns, ss)
      other -> (env, CPWild sp UError, add-error sp "too many constructor pattern arguments" st)
    other -> (env, CPWild sp UError, add-error sp "malformed constructor pattern spine" st)

  task-wanted :: Option UType -> Store -> (UType, Store)
  task-wanted wanted st = case wanted of Some ty -> (ty, st); None -> fresh-meta KType st
  inferred-scope-result-escapes :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> UType -> UType -> UType -> Store -> Bool
  inferred-scope-result-escapes classes kinds families env locals callback owner region row st =
    case fresh-meta KType st of
      (result, ready) ->
        let expected = UFunEff (scope-type owner region) row result in
        (case check classes kinds families env locals callback expected ready of
          (checked, done) -> list-length (store-errors done) == list-length (store-errors st)
            && not (scope-region-closed region (normalize done result)))
  infer-task-application :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Option UType -> Store -> (CoreTerm, Store)
  infer-task-application classes kinds families env locals sp expr wanted st = case application-spine expr Nil of
    (EVar at name, args) -> if same name "b.withScope" then (case args of
      Cons body Nil -> (case fresh-meta KRegion st of
        (owner, one) -> case task-wanted wanted one of
          (result, two) -> case fresh-meta KRow two of
            (row, three) -> let level = store-level three in
              case fresh-id (enter-level three) of
                (id, inner) -> let region = URigid id "scope" (store-level inner) KRegion in
                  let expected = UFunEff (scope-type owner region) row result in
                  case check classes kinds families env locals body expected inner of
                    (callback, done) ->
                      let failed = list-length (store-errors done) > list-length (store-errors inner) in
                      let escapes = (not (scope-region-closed region (normalize done result))
                        || (failed && inferred-scope-result-escapes classes kinds families env locals body owner region row inner)) in
                      if escapes then term-error sp "region escape: a value leaves its `withScope`" (restore-level level inner)
                      else (CScope sp result region (CENeeded sp (UApp (UCon "b.Io" (KFun KRegion KType)) owner) (env-givens env)) callback, restore-level level done))
      other -> term-error sp "withScope takes exactly one scope callback" st)
      else if same name "b.spawn" then (case args of
        Cons token (Cons body Nil) -> (case fresh-meta KRegion st of
          (owner, one) -> case fresh-meta KRegion one of
            (region, two) -> case check classes kinds families env locals token (scope-type owner region) two of
              (scope, three) -> case fresh-meta KType three of
                (failure, four) -> case fresh-meta KType four of
                  (value, five) -> case fresh-meta KRow five of
                    (row, six) -> case check classes kinds families env locals body (UFunEff (primitive-type "Unit") row (task-result-type failure value)) six of
                      (callback, done) -> let result = task-type region failure value in
                        (CSpawn sp result scope callback, case wanted of None -> done; Some expected -> unify sp result expected done))
        other -> term-error sp "spawn takes one scope and one task callback" st)
      else (case args of
        Cons token (Cons first rest) -> (case fresh-meta KRegion st of
          (owner, one) -> case fresh-meta KRegion one of
            (region, two) -> case check classes kinds families env locals token (scope-type owner region) two of
              (scope, three) -> case fresh-meta KType three of
                (failure, four) -> case check-task-handles classes kinds families env locals sp region failure (Cons first rest) four of
                  (fields, handles, done) -> let payload = case fields of UArg value UEnd -> value; other -> UTuple fields in
                    let result = task-result-type failure payload in
                    (CJoin sp result scope handles, case wanted of None -> done; Some expected -> unify sp result expected done))
        other -> term-error sp "joinAllOrCancel takes a scope and at least one task handle" st)
    other -> term-error sp "task application needs its canonical kernel operation" st
  check-task-handles :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> UType -> UType -> List Expr -> Store -> (UType, CoreTerm, Store)
  check-task-handles classes kinds families env locals sp region failure args st = case args of
    Nil -> (UEnd, CArgumentsEnd sp, st)
    Cons first rest -> case fresh-meta KType st of
      (value, fresh) -> case check classes kinds families env locals first (task-type region failure value) fresh of
        (checked-value, checked) -> case check-task-handles classes kinds families env locals sp region failure rest checked of
          (fields, handles, done) -> (UArg value fields, CArgument sp checked-value handles, done)
  -- Deterministic pure parallelism (`design/parallel-evaluation.md`
  -- sections 2.1 to 2.3). Each builtin's meaning is its sequential defining
  -- equation, so parallelism is permission and never semantics. Four
  -- obligations are checked here because none can travel through an
  -- ordinary function type (the seed's `infer_par_app` and
  -- `parallel_callback` are the reference):
  --
  -- - the callback is written literally at the call site, so its captures
  --   are visible (a function-typed parameter's are not);
  -- - its effect row is parallel-safe: the closed empty row or `{Diverge}`;
  -- - each capture is Share, or (in `parBoth` only) moves into the one
  --   branch that consumes it;
  -- - `parMap` has array storage, so its element type must be Share.
  --
  -- The capture classification runs at the end of the definition, when
  -- unification has resolved the binder types (`check-parallel-captures`).
  par-operation-name :: String -> String
  par-operation-name name = if same name "b.parBoth" then "par-both"
    else if same name "b.parTabulate" then "par-tabulate"
    else "par-map"
  infer-par-application :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Option UType -> Store -> (CoreTerm, Store)
  infer-par-application classes kinds families env locals sp expr wanted st = case application-spine expr Nil of
    (EVar at name, args) ->
      if same name "b.parBoth" then (case args of
        Cons f (Cons g Nil) -> (case fresh-meta KType st of
          (a, one) -> case fresh-meta KType one of
            (b, two) -> case fresh-meta KRow two of
              (row-f, three) -> case fresh-meta KRow three of
                (row-g, four) ->
                  let thunk-f = UFunEff (primitive-type "Unit") row-f a in
                  let thunk-g = UFunEff (primitive-type "Unit") row-g b in
                  (case parallel-callback classes kinds families env locals f thunk-f "parBoth" four of
                    (checked-f, five) -> case parallel-callback classes kinds families env locals g thunk-g "parBoth" five of
                      (checked-g, six) ->
                        let result = tuple-type (UArg a (UArg b UEnd)) in
                        (CPrimitive sp result (par-operation-name name) (CArgument sp checked-f (CArgument sp checked-g (CArgumentsEnd sp))),
                          case wanted of None -> six; Some expected -> unify sp result expected six)))
        other -> term-error sp "parBoth takes exactly two callbacks" st)
      else if same name "b.parTabulate" then (case args of
        Cons count (Cons f Nil) -> (case check classes kinds families env locals count (primitive-type "Nat") st of
          (checked-count, one) -> case fresh-meta KType one of
            (a, two) -> case fresh-meta KRow two of
              (row, three) ->
                let callback = UFunEff (primitive-type "Nat") row a in
                (case parallel-callback classes kinds families env locals f callback "parTabulate" three of
                  (checked-f, four) ->
                    let result = UApp (UCon "Array" (KFun KType KType)) a in
                    (CPrimitive sp result (par-operation-name name) (CArgument sp checked-count (CArgument sp checked-f (CArgumentsEnd sp))),
                      case wanted of None -> four; Some expected -> unify sp result expected four)))
        other -> term-error sp "parTabulate takes a count and one callback" st)
      else (case args of
        Cons f (Cons xs Nil) -> (case fresh-meta KType st of
          (elem, one) -> case fresh-meta KType one of
            (out, two) -> case fresh-meta KRow two of
              (row, three) ->
                let callback = UFunEff elem row out in
                (case parallel-callback classes kinds families env locals f callback "parMap" three of
                  (checked-f, four) -> case check classes kinds families env locals xs (core-list-type elem) four of
                    (checked-xs, five) ->
                      -- `map f xs` = `array-to-list (parMapArray f (array-from-list xs))`,
                      -- so the runtime never builds list cells (section 4.2).
                      case par-map-array-call classes env sp elem out checked-f checked-xs five of
                        (mapped, six) ->
                          let result = core-list-type out in
                          let done = (case wanted of None -> six; Some expected -> unify sp result expected six) in
                          (mapped, done)))
        other -> term-error sp "parMap takes a callback and one list" st)
    other -> term-error sp "parallel application needs its canonical kernel operation" st
  -- `array-from-list xs`, then the array primitive, then `array-to-list`:
  -- the two conversions are `Data.Array`'s own definitions, built through the
  -- ordinary call path (`lookup-value` then `apply-checked-runtime`) so their
  -- `CUse` carries the actuals and role the checked binding declares. A
  -- program using `parMap` ships `Data.Array` beside its entry (section 4.2).
  par-map-array-call :: List (String, Kind) -> List CheckedBinding -> Span -> UType -> UType -> CoreTerm -> CoreTerm -> Store -> (CoreTerm, Store)
  par-map-array-call classes env sp elem out callback xs st =
    let array-in = UApp (UCon "Array" (KFun KType KType)) elem in
    let array-out = UApp (UCon "Array" (KFun KType KType)) out in
    case prelude-call classes env sp "Data.Array" "array-from-list" xs st of
      (Ok converted, one) ->
        let mapped = CPrimitive sp array-out "par-map" (CArgument sp callback (CArgument sp converted (CArgumentsEnd sp))) in
        (case prelude-call classes env sp "Data.Array" "array-to-list" mapped one of
          (Ok listed, two) -> (listed, two)
          (Err message, two) -> (CError sp, add-error sp message two))
      (Err message, one) -> (CError sp, add-error sp message one)
  -- The checked global of a source definition, in the spelling
  -- `Bootstrap.Resolve.global-name` gives it: `m.` then the encoded module,
  -- a dot, and the encoded name. `Main.main` is the one exception, and no
  -- prelude definition is `main`.
  source-global :: String -> String -> String
  source-global home name = pack (Cons 'm' (Cons '.' (encode-identity (unpack home) (Cons '.' (encode-identity (unpack name) Nil)))))
  -- One application of a prelude definition to an already checked argument,
  -- through the same path an ordinary call takes.
  prelude-call :: List (String, Kind) -> List CheckedBinding -> Span -> String -> String -> CoreTerm -> Store -> (Result String CoreTerm, Store)
  prelude-call classes env sp home name argument st =
    case lookup-binding (source-global home name) env of
      None -> (Err (string-concat-all ["the prelude's ", home, ".", name, " is unavailable (parMap lowers through it)"]), st)
      Some binding -> case lookup-value sp (source-global home name) env st of
        (function, one) -> (case apply-checked-runtime classes sp env function argument one of
          (applied, two) -> if list-length (store-errors two) > list-length (store-errors one)
            then (Err (string-concat-all ["parMap could not apply the prelude's ", home, ".", name]), two)
            else (Ok applied, two))

  -- One parallel callback: checked against `domain ->{e} result`, refused
  -- unless it is written literally at the call site, and restricted to the
  -- parallel-safe row. The captures themselves are classified at the end of
  -- the definition (`Bootstrap.Typing`'s `par-definition-error`), where the
  -- checked data declarations that decide Share are in scope.
  parallel-callback :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> UType -> String -> Store -> (CoreTerm, Store)
  parallel-callback classes kinds families env locals arg expected op st =
    case check classes kinds families env locals arg expected st of
      (core, checked) ->
        -- The row rule runs first, as the seed's does: a row-polymorphic
        -- caller is refused by the row rule even when the callback is also
        -- a function-typed parameter (section 2.2).
        case parallel-safe-row (arrow-row-of expected) arg op checked of
          (ready, False) -> (CError (expr-span arg), ready)
          (ready, True) -> case parallel-callback-literal core of
            True -> (core, ready)
            False -> (CError (expr-span arg), add-error (expr-span arg) (parallel-callback-refusal op arg) ready)
  -- The performed row of a callback's checked type: the arrow's own row.
  arrow-row-of :: UType -> UType
  arrow-row-of ty = case arrow-shape ty of
    UFunEff domain row result -> row
    UProofFun predicate row result -> row
    UPi id name domain row result -> row
    other -> URow UEnd
  -- A callback is read literally: a lambda, a global function name, or a
  -- partial application of a global to arguments. A local binding is not
  -- admitted here, because its captures are not retained for the check.
  parallel-callback-literal :: CoreTerm -> Bool
  parallel-callback-literal core = case core of
    CLambda sp ty p body -> True
    CUse sp ty name role actuals -> True
    CApply sp ty f x -> parallel-callback-head f
    CApplyEff sp ty row f x -> parallel-callback-head f
    other -> False
  parallel-callback-head :: CoreTerm -> Bool
  parallel-callback-head core = case core of
    CUse sp ty name role actuals -> True
    CApply sp ty f x -> parallel-callback-head f
    CApplyEff sp ty row f x -> parallel-callback-head f
    other -> False
  parallel-callback-refusal :: String -> Expr -> String
  parallel-callback-refusal op arg = string-concat-all [
    par-spelling-of op, " must be applied directly to a callback written at the call site (a lambda literal, a global function, or a partial application of one)",
    (case arg of
      EVar sp name -> string-concat ": " (string-concat name " is a function-typed binding whose captures are unknown")
      other -> ""),
    " (design/parallel-evaluation.md section 2.3)"]
  par-spelling-of :: String -> String
  par-spelling-of op = if same op "parBoth" then "parBoth" else if same op "parTabulate" then "parTabulate" else "parMap"
  -- A parallel callback may perform only the parallel-safe row: the closed
  -- empty row or `{Diverge}` (section 2.2). `Diverge` is admitted because
  -- the sequential reading already permits it and the caller's row carries
  -- the label; every other label would make the schedule observable, pin a
  -- participant, or let a branch hold a resource whose operations are
  -- single-threaded. An effect handled inside the branch never appears in
  -- its row, so a branch may install its own handler.
  parallel-safe-row :: UType -> Expr -> String -> Store -> (Store, Bool)
  parallel-safe-row row arg op st = case normalize st row of
    URow UEnd -> (st, True)
    URow labels -> parallel-safe-labels labels arg op st
    URowJoin first second -> (case parallel-safe-row first arg op st of
      (ready, True) -> parallel-safe-row second arg op ready
      (ready, False) -> (ready, False))
    -- A row variable that is still rigid belongs to a row-polymorphic
    -- caller, which cannot supply a parallel callback in this slice: the
    -- scheduler would have to know the row is parallel-safe (section 2.2).
    UBound id name KRow -> (add-error (expr-span arg) (parallel-rigid-row-refusal op (UBound id name KRow)) st, False)
    URigid id name level KRow -> (add-error (expr-span arg) (parallel-rigid-row-refusal op (URigid id name level KRow)) st, False)
    other -> (parallel-row-refusal (expr-span arg) op other st, False)
  parallel-safe-labels :: UType -> Expr -> String -> Store -> (Store, Bool)
  parallel-safe-labels labels arg op st = case labels of
    UEnd -> (st, True)
    UArg label rest -> if parallel-safe-label label then parallel-safe-labels rest arg op st
      else (parallel-row-refusal (expr-span arg) op label st, False)
    -- A label spine can also end in a row variable, which is the rigid
    -- case above once it is the whole row.
    other -> (parallel-row-refusal (expr-span arg) op other st, False)
  parallel-safe-label :: UType -> Bool
  parallel-safe-label label = case label of
    UCon name kind -> same name "Diverge"
    other -> False
  parallel-row-refusal :: Span -> String -> UType -> Store -> Store
  parallel-row-refusal sp op row st = add-error sp (string-concat-all [
    "a ", op, " callback may perform only the parallel-safe row ({} or {Diverge}), but it performs ", type-text row,
    ": order, foreign state and thread affinity are not promised across a parallel call (design/parallel-evaluation.md section 2.2)"]) st
  parallel-rigid-row-refusal :: String -> UType -> String
  parallel-rigid-row-refusal op row = string-concat-all [
    "a ", op, " callback's effects must be the empty row or {Diverge}, but its row is ", type-text row,
    ", whose tail is a rigid row variable: a row-polymorphic caller cannot supply a parallel callback in this slice (design/parallel-evaluation.md section 2.2)"]
  check-do :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> UType -> Store -> (CoreTerm, Store)
  check-do classes kinds families env locals sp statements expected st = case statements of
    EArg at first (EArgsEnd end) -> (case first of
      EBind at name rhs -> term-error at "a do block must end in an expression" st
      ELet at bindings (EUnit end) -> term-error at "a do block must end in an expression" st
      other -> check classes kinds families env locals other expected st)
    EArg at (EBind location name rhs) rest -> (case infer classes kinds families env locals rhs st of
      (value, checked) -> bind-do-value classes kinds families env locals sp location name value rest expected checked)
    EArg at (ELet location bindings (EUnit end)) rest -> check-do-lets classes kinds families env locals sp bindings rest expected st
    EArg at first rest -> (case infer classes kinds families env locals first st of
      (value, checked) -> bind-do-value classes kinds families env locals sp at "_" value rest expected checked)
    EArgsEnd at -> term-error at "a do block must contain a final expression" st
    other -> term-error sp "malformed do statement spine" st
  bind-do-value :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Span -> String -> CoreTerm -> Expr -> UType -> Store -> (CoreTerm, Store)
  bind-do-value classes kinds families env locals sp at name value rest expected st = case value of
    CLet location ty id display scheme rhs inner -> if let-result-escapes value then
      (case bind-do-value classes kinds families (proof-let-env env (MkLocalBinding display scheme id (store-level st)) id scheme rhs st) locals sp at name inner rest expected st of
        (body, done) -> (CLet location expected id display scheme rhs body, done))
      else finish-do-value classes kinds families env locals sp at name value rest expected st
    other -> finish-do-value classes kinds families env locals sp at name value rest expected st
  finish-do-value :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Span -> String -> CoreTerm -> Expr -> UType -> Store -> (CoreTerm, Store)
  finish-do-value classes kinds families env locals sp at name value rest expected st = case fresh-id st of
    (id, ready) -> let scheme = mono (normalize ready (core-type value)) in
      let bound = proof-let-env env (MkLocalBinding name scheme id (store-level ready)) id scheme value ready in
      case check-do classes kinds families (if same name "_" then env else bound) locals sp rest expected (check-borrow-binding at env (scheme-body scheme) ready) of
        (body, done) -> (CLet at expected id name scheme value body, done)
  check-do-lets :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> Expr -> UType -> Store -> (CoreTerm, Store)
  check-do-lets classes kinds families env locals sp bindings rest expected st = case bindings of
    EBindingsEnd at -> check-do classes kinds families env locals sp rest expected st
    EBinding at name rhs more -> let level = store-level st in
      (case infer classes kinds families env locals rhs (enter-level st) of
        (value, checked) -> let checked-pure = include-effects at (core-effects value) (URow UEnd) checked in
          let continuation = EDo sp (case more of EBindingsEnd end -> rest; other -> EArg sp (ELet sp more (EUnit sp)) rest) in
          check-refined-binding classes kinds families env locals sp at name (EBindingsEnd at) continuation expected level value checked-pure)
    other -> term-error sp "malformed do let binding group" st

  check-alternatives :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> CoreTerm -> UType -> Expr -> Store -> (CoreTerm, Store)
  check-alternatives classes kinds families env locals scrut result alts st = case alts of
    EAltsEnd s -> (CAlternativesEnd s, st)
    EAlt s p body rest -> case bind-pattern classes kinds families env locals p (core-type scrut) (duplicate-names s (pattern-names p) Nil st) of
      (bound, pattern, sb) -> case check-alt-body classes kinds families (proof-case-env s bound scrut pattern True sb) locals body result sb of
        (rhs, sr) -> case check-alternatives classes kinds families (proof-case-rest-env s env scrut pattern rhs sr) locals scrut result rest sr of
          (more, ss) -> (CAlternative s pattern rhs more, ss)
    other -> term-error (expr-span alts) "malformed alternative spine" st
  check-alt-body :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> UType -> Store -> (CoreTerm, Store)
  check-alt-body classes kinds families env locals body result st = case body of
    EGuarded s guard rhs -> case check classes kinds families env locals guard (primitive-type "Bool") st of
      (condition, sc) -> case check classes kinds families (proof-branch (expr-span guard) env condition True sc) locals rhs result sc of
        (value, ss) -> (CGuard s result condition value, ss)
    other -> check classes kinds families env locals body result st
  -- Only the literal builtin True guard counts as an unguarded row.
  -- Arbitrary expressions that happen to evaluate to True do not cover.
  body-covers :: Expr -> Bool
  body-covers body = case body of
    ELet sp bindings value -> body-covers value
    ELetScope sp body -> body-covers body
    ELocalGroup sp bindings value -> body-covers value
    ELetRec sp bindings value -> body-covers value
    EGuarded s guard rhs -> case guard of
      ECon at name (EArgsEnd end) -> same name "True"
      other -> False
    other -> True
  alternative-rows :: Bool -> Expr -> List (List Pat)
  alternative-rows include-guards alts = case alts of
    EAlt s p body rest -> let more = alternative-rows include-guards rest in
      if include-guards || body-covers body then Cons [p] more else more
    other -> Nil

  -- A constructor-specializing coverage matrix. Nonliteral guards never
  -- cover values; specialization uses a private copy of the store.
  wildcard :: Pat -> Bool
  wildcard p = case p of PWild s -> True; PVar s name -> True; PAs s name inner -> wildcard inner; PAnn s inner ty -> wildcard inner; other -> False
  strip-pattern :: Pat -> Pat
  strip-pattern p = case p of PAs s name inner -> strip-pattern inner; PAnn s inner ty -> strip-pattern inner; other -> p
  defaults :: List (List Pat) -> List (List Pat)
  defaults rows = case rows of
    Nil -> Nil
    Cons (Cons p tail) rest -> if wildcard p then Cons tail (defaults rest) else defaults rest
    Cons Nil rest -> defaults rest
  wilds :: Nat -> List Pat
  wilds n = if n == 0 then Nil else Cons (PWild zero) (wilds (n - 1))
  specialize :: String -> Nat -> List (List Pat) -> List (List Pat)
  specialize name count rows = case rows of
    Nil -> Nil
    Cons (Cons p tail) rest -> if wildcard p then Cons (wilds count <> tail) (specialize name count rest)
      else case strip-pattern p of PCon s n args -> if same name n then Cons (pats-of args <> tail) (specialize name count rest) else specialize name count rest; other -> specialize name count rest
    Cons Nil rest -> specialize name count rest
  tuple-rows :: Nat -> List (List Pat) -> List (List Pat)
  tuple-rows count rows = case rows of
    Nil -> Nil
    Cons (Cons p tail) rest -> if wildcard p then Cons (wilds count <> tail) (tuple-rows count rest)
      else case strip-pattern p of PTuple s args -> Cons (pats-of args <> tail) (tuple-rows count rest); other -> tuple-rows count rest
    Cons Nil rest -> tuple-rows count rest
  spine-list :: UType -> List UType
  spine-list xs = case xs of UArg x rest -> Cons x (spine-list rest); other -> Nil
  family-ctors :: String -> List (String, List String) -> Option (List String)
  family-ctors name families = case families of Nil -> None; Cons (n, cs) rest -> if same name n then Some cs else family-ctors name rest
  -- Coverage can run before the patterns have inferred a scrutinee's head.
  -- Learn only its nominal/tuple shape in the coverage store, never a
  -- constructor's fixed indices. Branch checking still performs the actual
  -- unification; its local equalities cannot justify dropping other branches.
  coverage-family-shape :: UType -> Store -> (UType, Store)
  coverage-family-shape ty st = case ty of
    UApp head argument -> (case coverage-family-shape head st of
      (family, opened) -> case fresh-meta (type-kind argument) opened of
        (parameter, ready) -> (UApp family parameter, ready))
    UCon name kind -> (ty, st)
    other -> (UError, st)
  coverage-pattern-head :: List CheckedBinding -> UType -> List (List Pat) -> Store -> (UType, Store)
  coverage-pattern-head env ty rows st = case rows of
    Cons (Cons pattern tail) rest -> (case strip-pattern pattern of
      PCon sp name arguments -> (case lookup-binding name env of
        Some binding -> if same (checked-role binding) "constructor" then
          (case instantiate (checked-scheme binding) st of
            (constructor, opened) -> case coverage-family-shape (normalize opened (result-type constructor)) opened of
              (family, ready) -> (family, unify sp ty family ready))
          else coverage-pattern-head env ty rest st
        None -> coverage-pattern-head env ty rest st)
      PTuple sp arguments -> (case pattern-fields arguments st of
        (fields, ready) -> let tuple = tuple-type fields in (tuple, unify sp ty tuple ready))
      other -> coverage-pattern-head env ty rest st)
    Cons Nil rest -> coverage-pattern-head env ty rest st
    Nil -> (ty, st)
  covers :: List (String, List String) -> List CheckedBinding -> List UType -> List (List Pat) -> Store -> Bool
  covers families env tys rows st = case tys of
    Nil -> has-empty-row rows
    Cons ty rest -> (case (case normalize st ty of
      UMeta id KType -> coverage-pattern-head env ty rows st
      actual -> (actual, st)) of
        (head, shaped) -> covers-head families env head rest rows shaped)
  covers-head :: List (String, List String) -> List CheckedBinding -> UType -> List UType -> List (List Pat) -> Store -> Bool
  covers-head families env ty rest rows st = if empty-family (normalize st ty) families then True else case rows of
      Nil -> coverage-index-empty families env ty st
      other -> if only-defaults rows then covers families env rest (defaults rows) st else case normalize st ty of
        UTuple fields -> covers families env (spine-list fields <> rest) (tuple-rows (list-length (spine-list fields)) rows) st
        other -> case root-name (normalize st ty) of
          Some name -> case family-ctors name families of
            Some cs -> cover-constructors families env ty rest rows cs st
            None -> if same name "Unit" then covers families env rest (tuple-rows 0 rows) st else covers families env rest (defaults rows) st
          None -> covers families env rest (defaults rows) st
  empty-family :: UType -> List (String, List String) -> Bool
  empty-family ty families = case root-name ty of Some name -> (case family-ctors name families of Some Nil -> True; other -> False); None -> False
  only-defaults :: List (List Pat) -> Bool
  only-defaults rows = case rows of Nil -> True; Cons (Cons p ps) more -> wildcard p && only-defaults more; Cons Nil more -> False
  has-empty-row :: List (List Pat) -> Bool
  has-empty-row rows = case rows of Nil -> False; Cons Nil rest -> True; Cons row rest -> has-empty-row rest
  -- Unification failure alone is not an impossibility proof: an unknown
  -- symbolic index may still match. Only unequal checked closed integer
  -- indices of the same carrier justify omitting a constructor here.
  coverage-index-apart :: UType -> UType -> Bool
  coverage-index-apart first second = case (first, second) of
    (UApp f a, UApp g b) -> coverage-index-apart f g || coverage-index-apart a b
    (UIndex carrier (IInteger a), UIndex other (IInteger b)) -> integer-carrier carrier && same-type carrier other && a /= b
    other -> False
  coverage-no-index-constructor :: List CheckedBinding -> UType -> List String -> Store -> Bool
  coverage-no-index-constructor env ty constructors st = case constructors of
    Nil -> True
    Cons name rest -> (case lookup-binding name env of
      None -> False
      Some binding -> (case instantiate (checked-scheme binding) st of
        (constructor, opened) -> coverage-index-apart (normalize opened (result-type constructor)) (normalize opened ty)
          && coverage-no-index-constructor env ty rest st))
  coverage-index-empty :: List (String, List String) -> List CheckedBinding -> UType -> Store -> Bool
  coverage-index-empty families env ty st = case root-name (normalize st ty) of
    Some name -> (case family-ctors name families of Some constructors -> coverage-no-index-constructor env ty constructors st; None -> False)
    None -> False
  cover-constructors :: List (String, List String) -> List CheckedBinding -> UType -> List UType -> List (List Pat) -> List String -> Store -> Bool
  cover-constructors families env ty tail rows cs st = case cs of
    Nil -> True
    Cons name rest -> case lookup-binding name env of
      None -> covers families env tail (defaults rows) st
      Some b -> case instantiate (checked-scheme b) st of
        (ct, sc) -> if coverage-index-apart (normalize sc (result-type ct)) (normalize sc ty) then cover-constructors families env ty tail rows rest st else
          let su = unify zero (result-type ct) ty sc in
          covers families env (domains ct <> tail) (specialize name (scheme-arity (checked-scheme b)) rows) su && cover-constructors families env ty tail rows rest st
  ensure-coverage :: Span -> List (String, List String) -> List CheckedBinding -> List UType -> List (List Pat) -> Store -> Store
  ensure-coverage sp families env tys rows st = if covers families env tys rows st then st else add-error sp "non-exhaustive patterns" st

  -- The unguarded matrix decides coverage. Use the original rows only to
  -- name a path through that failed matrix, including guarded literals.
  coverage-literals :: List (List Pat) -> List String -> List String
  coverage-literals rows seen = case rows of
    Nil -> reverse seen
    Cons (Cons p tail) rest -> let literal = (case strip-pattern p of
      PLitInt sp text -> Some text
      PLitStr sp text -> Some (string-concat-all ["\"", text, "\""])
      PLitChar sp text -> Some (string-concat-all ["'", text, "'"])
      other -> None) in
      (case literal of
        Some text -> coverage-literals rest (if has text seen then seen else Cons text seen)
        None -> coverage-literals rest seen)
    Cons Nil rest -> coverage-literals rest seen
  coverage-literal-list :: List String -> String
  coverage-literal-list literals = case literals of
    Nil -> ""
    Cons text Nil -> text
    Cons text rest -> string-concat-all [text, ", ", coverage-literal-list rest]
  uncovered-coverage :: List (String, List String) -> List CheckedBinding -> List UType -> List (List Pat) -> List (List Pat) -> String -> Store -> String
  uncovered-coverage families env tys covered original hint st = case tys of
    Nil -> hint
    Cons ty tail -> if only-defaults original then
      uncovered-coverage families env tail (defaults covered) (defaults original) hint st
      else (case (case normalize st ty of UMeta id KType -> coverage-pattern-head env ty original st; actual -> (actual, st)) of
        (head, shaped) -> (case normalize shaped head of
          UTuple fields -> let count = list-length (spine-list fields) in
            uncovered-coverage families env (spine-list fields <> tail) (tuple-rows count covered) (tuple-rows count original) hint shaped
          other -> case root-name other of
            Some name -> (case family-ctors name families of
              Some constructors -> uncovered-constructor families env head tail covered original hint constructors shaped
              None -> uncovered-default families env tail covered original hint shaped)
            None -> uncovered-default families env tail covered original hint shaped))
  uncovered-default :: List (String, List String) -> List CheckedBinding -> List UType -> List (List Pat) -> List (List Pat) -> String -> Store -> String
  uncovered-default families env tail covered original hint st =
    let witness = (case coverage-literals original Nil of
      Nil -> hint
      literals -> string-concat "a value other than " (coverage-literal-list literals)) in
    uncovered-coverage families env tail (defaults covered) (defaults original) witness st
  uncovered-constructor :: List (String, List String) -> List CheckedBinding -> UType -> List UType -> List (List Pat) -> List (List Pat) -> String -> List String -> Store -> String
  uncovered-constructor families env ty tail covered original hint constructors st = case constructors of
    Nil -> hint
    Cons name rest -> case lookup-binding name env of
      None -> hint
      Some binding -> case instantiate (checked-scheme binding) st of
        (ctor, opened) -> if coverage-index-apart (normalize opened (result-type ctor)) (normalize opened ty) then
          uncovered-constructor families env ty tail covered original hint rest st
          else let ready = unify zero (result-type ctor) ty opened in
            let arity = scheme-arity (checked-scheme binding) in
            let rows = specialize name arity covered in
            let types = domains ctor <> tail in
            if covers families env types rows ready then uncovered-constructor families env ty tail covered original hint rest st
            else let display = diagnostic-member-name name in
              let witness = if has display ["True", "False"] && same-type (normalize ready ty) (primitive-type "Bool") then display else string-concat "constructor " display in
              (case rows of Nil -> witness; other -> uncovered-coverage families env types rows (specialize name arity original) witness ready)
  coverage-refusal :: Span -> List (String, List String) -> List CheckedBinding -> List UType -> List (List Pat) -> List (List Pat) -> String -> Store -> Store
  coverage-refusal sp families env tys covered original hint st =
    add-error sp (string-concat-all ["non-exhaustive patterns: ", uncovered-coverage families env tys covered original hint st,
      " is not covered by an unguarded row; add an unguarded final row"]) st
  ensure-match-coverage :: Span -> List (String, List String) -> List CheckedBinding -> UType -> Expr -> Store -> Store
  ensure-match-coverage sp families env ty alternatives st =
    let rows = alternative-rows False alternatives in
    if covers families env [ty] rows st then st else
      coverage-refusal sp families env [ty] rows (alternative-rows True alternatives) "a scrutinee value" st

  families-of :: List Decl -> List (String, List String)
  families-of ds = case ds of Nil -> Nil; Cons (DData s name ps cs) rest -> Cons (name, ctor-names cs) (families-of rest); Cons d rest -> families-of rest
  ctor-names :: List (String, TypeExpr) -> List String
  ctor-names cs = case cs of Nil -> Nil; Cons (name, ty) rest -> Cons name (ctor-names rest)
  external-ctor-names :: Json -> List String
  external-ctor-names rows = case rows of JArr (JStr name) rest -> Cons (interface-global name) (external-ctor-names rest); other -> Nil
  external-families :: Json -> List (String, List String)
  external-families rows = case rows of
    JArr row rest -> (case (field "identity" row, field "kind" row, field "constructors" row) of
      (JStr identity, JStr category, constructors) -> if same category "data" then Cons (interface-global identity, external-ctor-names constructors) Nil else Nil
      other -> Nil) <> external-families rest
    other -> Nil
  imported-families :: List Decl -> List (String, List String)
  imported-families ds = case ds of
    Nil -> Nil
    Cons (DExternal s name category scheme metadata) rest -> external-families (resolved-nominals metadata) <> imported-families rest
    Cons d rest -> imported-families rest
  clause-rows :: Bool -> List (List Pat, Expr) -> List (List Pat)
  clause-rows include-guards cs = case cs of
    Nil -> Nil
    Cons (ps, body) rest -> let more = clause-rows include-guards rest in
      if include-guards || body-covers body then Cons ps more else more
  ensure-equation-coverage :: Span -> List (String, List String) -> List CheckedBinding -> List UType -> List (List Pat, Expr) -> Store -> Store
  ensure-equation-coverage sp families env types clauses st =
    let rows = clause-rows False clauses in
    if covers families env types rows st then st else
      coverage-refusal sp families env types rows (clause-rows True clauses) "an argument combination" st
  check-equation :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> List (List CorePattern) -> List CorePattern -> List Pat -> Expr -> UType -> UType -> Store -> (List CorePattern, CoreTerm, Store)
  check-equation classes kinds families env locals earlier reversed ps body expected allowed st = case ps of
    Nil -> let patterns = reverse reversed in
      let bound = case earlier of
            Nil -> env
            Cons first rest -> prepend-proof-facts zero
              (scoped-core-equation-facts (proof-context env st) (normalize-equation-prefix st earlier) (normalize-patterns st patterns)) env in
      (case check-required classes kinds families bound locals body expected st of
        (rhs, ss) -> let site = expr-span body in
          let checked = include-effects site (core-effects rhs) allowed ss in
          let finished = (case reversed of
            Nil -> if list-length (store-errors checked) > list-length (store-errors ss) then
              add-error site "a nullary definition must be pure" checked else checked
            other -> checked) in
          (patterns, rhs, finished))
    Cons p rest -> case bind-arrow-pattern classes kinds families env locals p expected (include-effects (pat-span p) allowed (URow UEnd) st) of
      (bound, pattern, row, result, checked) -> check-equation classes kinds families bound locals earlier (Cons pattern reversed) rest body result row checked
  normalize-equation-prefix :: Store -> List (List CorePattern) -> List (List CorePattern)
  normalize-equation-prefix st earlier = case earlier of
    Nil -> Nil
    Cons first rest -> Cons (normalize-patterns st first) (normalize-equation-prefix st rest)
  check-clauses :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> UType -> List (List CorePattern) -> List (List Pat, Expr) -> Store -> (List CoreClause, Store)
  check-clauses classes kinds families env locals ty earlier cs st = case cs of
    Nil -> (Nil, st)
    Cons (ps, body) rest -> case check-equation classes kinds families env locals earlier Nil ps body ty (URow UEnd) (duplicate-names (expr-span body) (patterns-names ps) Nil st) of
      (patterns, rhs, sr) ->
        let writes = if core-alternative-covers rhs then Nil else guard-fallthrough-writes (map-term-types (normalize sr) rhs) in
        let remaining = proof-env-after-writes env writes sr in
        case check-clauses classes kinds families remaining locals ty (extend-equation-prefix patterns rhs earlier) rest sr of
          (clauses, ss) -> (Cons (MkCoreClause (expr-span body) patterns rhs) clauses, ss)
  bind-value-parameters :: List Quant -> List (Nat, UType) -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  bind-value-parameters params pairs env st = case params of
    Nil -> (env, st)
    Cons q rest -> case mapped-local (quant-id q) pairs of
      Some value -> (case (value-carrier (type-kind value), index-of-type value) of
        (Some carrier, Some (IRigid id name level)) -> bind-value-parameters rest pairs (Cons (MkValueBinding (quant-name q) (mono carrier) id level value) env) st
        other -> bind-value-parameters rest pairs env st)
      None -> (env, add-error zero "quantified value is missing its checked opening" st)
  check-definition :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> Span -> String -> List (List Pat, Expr) -> Store -> (Option CoreDefinition, Store)
  -- The regions a signature quantifies: its opened region parameters. The
  -- caller names each one and supplies the place in it, so a place this
  -- body builds cannot outlive it (ownership and usage design, section 4).
  caller-region-ids :: List (Nat, UType) -> List Nat
  caller-region-ids pairs = case pairs of
    Nil -> Nil
    Cons (_, URigid id name level KRegion) more -> Cons id (caller-region-ids more)
    Cons (_, other) more -> caller-region-ids more
  -- A borrow at a caller region lends a place the body constructs, which
  -- dies with the call: no checked value may contain one, wherever the
  -- value puts it (`Ref r a` in a declared type is inhabited by a place
  -- the caller passes in).
  caller-borrow-in-term :: List Nat -> CoreTerm -> Bool
  caller-borrow-in-term regions term = case term of
    CPrimitive sp ty operation args -> (case borrow-type-parts ty of
      Some (mutable, region, carrier) -> (if same operation "borrow" || same operation "mut-borrow" then caller-region-of region regions else False) || caller-borrow-in-terms regions (term-children term)
      None -> caller-borrow-in-terms regions (term-children term))
    other -> caller-borrow-in-terms regions (term-children term)
  caller-borrow-in-terms :: List Nat -> List CoreTerm -> Bool
  caller-borrow-in-terms regions terms = case terms of
    Nil -> False
    Cons first rest -> caller-borrow-in-term regions first || caller-borrow-in-terms regions rest
  caller-region-of :: UType -> List Nat -> Bool
  caller-region-of region regions = case region of
    URigid id name level KRegion -> contains-meta id regions
    other -> False
  clauses-caller-borrow-free :: List Nat -> List CoreClause -> Bool
  clauses-caller-borrow-free regions clauses = case clauses of
    Nil -> True
    Cons (MkCoreClause sp patterns body) rest -> not (caller-borrow-in-term regions body) && clauses-caller-borrow-free regions rest
  caller-borrow-error :: Span -> Store -> Store
  caller-borrow-error sp st = add-error sp "region escape: the body lends a place it constructs, but the region comes from the signature: the caller names it and supplies the place in it, so a borrow at that region must outlive the call and a place built here does not (ownership and usage design, section 4); a declared borrow is inhabited by a place the caller passes in" st
  check-definition classes kinds families env sp name cs st = check-definition-with-annotations classes kinds families env sp name cs Nil st
  open-annotation-locals :: List (String, UType) -> List (Nat, UType) -> List (String, UType)
  open-annotation-locals annotations pairs = case annotations of
    Nil -> Nil
    Cons (name, ty) rest -> Cons (name, substitute-bound pairs ty) (open-annotation-locals rest pairs)
  bind-annotation-values :: List (String, UType) -> List CheckedBinding -> List CheckedBinding
  bind-annotation-values annotations env = case annotations of
    Nil -> env
    Cons (name, value) rest -> case (value-carrier (type-kind value), index-of-type value) of
      (Some carrier, Some (IRigid id display level)) -> Cons (MkValueBinding name (mono carrier) id level value) (bind-annotation-values rest env)
      other -> bind-annotation-values rest env
  check-definition-with-annotations :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> Span -> String -> List (List Pat, Expr) -> List (String, UType) -> Store -> (Option CoreDefinition, Store)
  check-definition-with-annotations classes kinds families env sp name cs annotations st = case lookup-binding name env of
    None -> (None, add-error sp (string-concat "no signature for " name) st)
    Some (MkIntrinsicBinding source sc symbol) -> (None, add-error sp "runtime intrinsic cannot also have a source definition" st)
    Some b -> if same (checked-role b) "operation" then (None, add-error sp "effect operation cannot also have a source definition" st) else if same (checked-role b) "instance" || same (checked-role b) "implicit-instance" then (None, add-error sp "instance dictionary cannot also have an ordinary source definition" st) else
      let level = store-level st in
      case open-qualified True (checked-scheme b) (enter-level st) of
        (ty, requirements, pairs, ss) ->
          let annotation-locals = open-annotation-locals annotations pairs in
          let locals = annotation-locals <> opened-locals (scheme-params (checked-scheme b)) pairs in
          let (value-env, value-store) = bind-value-parameters (scheme-params (checked-scheme b)) pairs (bind-annotation-values annotation-locals env) ss in
          let (bound, givens, sg) = bind-requirements sp requirements value-env value-store in
          let (clauses, checked) = check-clauses classes kinds families bound locals ty Nil cs sg in
          let returned = if clauses-caller-borrow-free (caller-region-ids pairs) clauses then checked else caller-borrow-error sp checked in
          let count = case cs of Nil -> 0; Cons (ps, body) rest -> list-length ps in
          let types = domains ty in
          let same-arity = clauses-full-arity cs count && count <= list-length types in
          let covered = case cs of
                Nil -> add-error sp "a function declaration has no clauses" returned
                other -> if same-arity then ensure-equation-coverage sp families env (take-types count types) cs (check-overlap cs Nil returned)
                  else add-error sp "function clauses disagree with their declared arity" returned in
          (Some (MkCoreDefinition sp name (checked-scheme b) pairs givens Nil clauses), restore-level level covered)
  take-types :: Nat -> List UType -> List UType
  take-types count types = if count == 0 then Nil else case types of Nil -> Nil; Cons ty rest -> Cons ty (take-types (count - 1) rest)
  pat-covers :: Pat -> Pat -> Bool
  pat-covers first second = if wildcard first then True else case (strip-pattern first, strip-pattern second) of
    (PCon s name args, PCon t other xs) -> same name other && row-covers (pats-of args) (pats-of xs)
    (PTuple s args, PTuple t xs) -> row-covers (pats-of args) (pats-of xs)
    other -> False
  row-covers :: List Pat -> List Pat -> Bool
  row-covers first second = case (first, second) of
    (Nil, Nil) -> True
    (Cons p ps, Cons q qs) -> pat-covers p q && row-covers ps qs
    other -> False
  covered-by :: List (List Pat) -> List Pat -> Bool
  covered-by rows ps = case rows of Nil -> False; Cons row rest -> row-covers row ps || covered-by rest ps
  check-overlap :: List (List Pat, Expr) -> List (List Pat) -> Store -> Store
  check-overlap cs earlier st = case cs of
    Nil -> st
    Cons (ps, body) rest -> let ss = if covered-by earlier ps then add-error (expr-span body) "unreachable clause: an earlier clause already matches these patterns" st else st in
      check-overlap rest (if body-covers body then Cons ps earlier else earlier) ss
  clauses-full-arity :: List (List Pat, Expr) -> Nat -> Bool
  clauses-full-arity cs count = case cs of Nil -> True; Cons (ps, body) rest -> list-length ps == count && clauses-full-arity rest count
  has-definition :: String -> List Decl -> Bool
  has-definition name ds = case ds of
    Nil -> False
    Cons d rest -> case definition-name d of Some n -> same name n || has-definition name rest; None -> has-definition name rest
  definition-name :: Decl -> Option String
  definition-name d = case d of DFun s name cs -> Some name; other -> None
  declaration-clauses :: String -> Decl -> List (List Pat, Expr)
  declaration-clauses name d = case d of DFun s n cs -> if same name n then cs else Nil; other -> Nil
  function-clauses :: String -> List Decl -> List (List Pat, Expr)
  function-clauses name ds = collect-clauses name ds Nil
  collect-clauses :: String -> List Decl -> List (List Pat, Expr) -> List (List Pat, Expr)
  collect-clauses name ds backwards = case ds of
    Nil -> reverse backwards
    Cons d rest -> collect-clauses name rest (reverse (declaration-clauses name d) <> backwards)
  -- Keep the large declaration match out of the recursive list frame.
  -- Complete top-level signatures make each body's inference independent;
  -- seal it while its substitution cells are still near the store's head.
  check-body-declaration :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> HashMap String Nat -> HashMap String (List (List Pat, Expr)) -> Decl -> Store -> (HashMap String Nat, Option CoreDefinition, Store)
  check-body-declaration classes kinds families env seen clauses d st = case d of
    DFun s name cs -> if indexed name seen then (seen, None, st)
      else case check-definition classes kinds families env s name (indexed-clauses name clauses) st of
        (definition, ss) -> case definition of
          None -> (hash-map-insert name 0 seen, None, ss)
          Some core -> case resolve-dictionary-definition-with classes (env-instances env) core ss of
            (resolved, checked) -> let completed = default-task-failure-clauses (core-clauses resolved) checked in
              (hash-map-insert name 0 seen, Some (seal-definition-with-checked-contracts (env-body-context env) (env-guarded-bindings env) completed resolved), completed)
    DSig s name ty -> (seen, None, if indexed name clauses then st else add-error s (string-concat "signature has no definition: " name) st)
    other -> (seen, None, st)
  -- Every equation of each defined name, in declaration order (what
  -- function-clauses collects), indexed once per body pass.
  clause-index :: List Decl -> HashMap String (List (List Pat, Expr)) -> HashMap String (List (List Pat, Expr))
  clause-index ds index = case ds of
    Nil -> index
    Cons (DFun s name cs) rest -> clause-index rest (hash-map-insert name (indexed-clauses name index <> cs) index)
    Cons other rest -> clause-index rest index
  indexed-clauses :: String -> HashMap String (List (List Pat, Expr)) -> List (List Pat, Expr)
  indexed-clauses name index = case hash-map-lookup name index of Some cs -> cs; None -> Nil
  indexed :: forall v. String -> HashMap String v -> Bool
  indexed name index = case hash-map-lookup name index of Some found -> True; None -> False
  -- A set of names. The values are unused; Nat values keep to the HashMap
  -- variants the pinned library object provides.
  name-set :: List String -> HashMap String Nat
  name-set names = case names of Nil -> hash-map-empty; Cons name rest -> hash-map-insert name 0 (name-set rest)
  -- Task errors left unconstrained by the complete body are existential
  -- monotypes, not caller-selected parameters. Choose Unit only after all
  -- source constraints, numeric defaults and dictionary resolution finish.
  -- Keep public/rigid types, generalization and failed obligations intact.
  default-task-failure-clauses :: List CoreClause -> Store -> Store
  default-task-failure-clauses clauses st = case clauses of
    Nil -> st
    Cons (MkCoreClause sp patterns body) rest -> default-task-failure-clauses rest (default-task-failure-term body st)
  default-task-failure-term :: CoreTerm -> Store -> Store
  default-task-failure-term term st = let checked = default-task-failure-terms (term-children term) st in
    case term of
      CSpawn sp ty token callback -> (case task-parts (normalize checked ty) of
        Some (region, error, value) -> (case normalize checked error of
          UMeta id KType -> (case store-errors checked of Nil -> unify sp error (primitive-type "Unit") checked; other -> checked)
          other -> checked)
        None -> checked)
      other -> checked
  default-task-failure-terms :: List CoreTerm -> Store -> Store
  default-task-failure-terms terms st = case terms of Nil -> st; Cons first rest -> default-task-failure-terms rest (default-task-failure-term first st)
  check-bodies :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List String -> List Decl -> List Decl -> Store -> (List CoreDefinition, Store)
  check-bodies classes kinds families env seen all ds st = check-body-loop classes kinds families env (name-set seen) (clause-index all hash-map-empty) ds Nil st
  check-body-loop :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> HashMap String Nat -> HashMap String (List (List Pat, Expr)) -> List Decl -> List CoreDefinition -> Store -> (List CoreDefinition, Store)
  -- A failed body leaves recovery types and an undischarged store. Do not
  -- treat that store as evidence while checking later definitions: their
  -- coverage/type diagnostics would be artifacts of the original failure.
  check-body-loop classes kinds families env seen clauses ds backwards st = case store-errors st of
    Cons error rest -> (reverse backwards, st)
    Nil -> case ds of
      Nil -> (reverse backwards, st)
      Cons d rest -> case check-body-declaration classes kinds families env seen clauses d st of
        (names, definition, ss) -> check-body-loop classes kinds families env names clauses rest (case definition of None -> backwards; Some core -> Cons core backwards) ss
  contexts :: List Decl -> List Json
  contexts ds = case ds of
    Nil -> Nil
    Cons (DSource s name metadata) rest -> Cons metadata (contexts rest)
    Cons (DForeign s direction abi symbol name syntax) rest -> case intrinsic-contract symbol of
      Some (text, external) -> Cons (JObj "category" (JStr "intrinsic")
        (JObj "binding" (JStr name) (JObj "identity" (JStr symbol)
          (JObj "external" (JStr external) (JObj "runtime_abi" (JNum runtime-abi-int)
            (JObj "scheme" (JStr text) JObjEnd)))))) (contexts rest)
      None -> contexts rest
    Cons d rest -> contexts rest
  finish-binding :: Store -> CheckedBinding -> CheckedBinding
  finish-binding st b = case b of
    MkBodyBinding binding -> b
    MkBodyContext context names cache -> b
    MkCheckedBinding n sc role -> MkCheckedBinding n (map-scheme-types (normalize st) sc) role
    MkForeignBinding n sc plan -> MkForeignBinding n sc plan
    MkMethodBinding n sc owner slot -> MkMethodBinding n (map-scheme-types (normalize st) sc) owner slot
    MkConditionalBinding n owner slot dictionary head sc guarded -> MkConditionalBinding n owner slot dictionary (normalize st head) (map-scheme-types (normalize st) sc) guarded
    MkGivenBinding n ty symbol -> MkGivenBinding n (normalize st ty) symbol
    MkLocalBinding n sc id level -> MkLocalBinding n (map-scheme-types (normalize st) sc) id level
    MkMemoBinding name ty id -> MkMemoBinding name (normalize st ty) id
    MkValueBinding n sc id level value -> MkValueBinding n (map-scheme-types (normalize st) sc) id level (normalize st value)
    MkIntrinsicBinding n sc symbol -> MkIntrinsicBinding n (map-scheme-types (normalize st) sc) symbol
    MkProofBinding origin invalidated fact -> MkProofBinding origin invalidated fact
    MkErasedBinding name predicate id origin invalidated -> MkErasedBinding name (normalize st predicate) id origin invalidated
    MkSyntaxBinding name -> b
  finish-bindings :: Store -> List CheckedBinding -> List CheckedBinding
  finish-bindings st env = case env of Nil -> Nil; Cons (MkBodyContext context names cache) rest -> finish-bindings st rest; Cons b rest -> Cons (finish-binding st b) (finish-bindings st rest)
  global-bindings :: List CheckedBinding -> List CoreGlobal -> List CoreGlobal
  global-bindings bindings globals = case bindings of
    Nil -> globals
    Cons binding rest -> global-bindings rest (case binding of
      MkBodyBinding binding -> add-global (GlobalBody (GlobalValue (binding-name binding) (binding-role binding) (binding-scheme binding)) binding) globals
      MkCheckedBinding name sc role -> if same role "closed-proof" then globals else add-global (GlobalValue name role sc) globals
      MkForeignBinding name sc plan -> add-global (GlobalValue name "foreign" sc) globals
      MkMethodBinding name sc owner slot -> add-global (GlobalMethod name owner slot sc) globals
      MkConditionalBinding name owner slot dictionary head sc guarded -> add-global (case guarded of Some binding -> GlobalGuardedBody (GlobalValue name "external" sc) binding; None -> GlobalValue name "external" sc) globals
      MkIntrinsicBinding name sc symbol -> add-global (GlobalValue symbol "intrinsic" sc) globals
      other -> globals)
  field-globals :: List CoreDictionaryField -> List CoreGlobal -> List CoreGlobal
  field-globals fields globals = case fields of
    Nil -> globals
    Cons field rest -> let definition = dictionary-field-definition field in
      field-globals rest (add-global (GlobalValue (core-name definition) "instance-method" (core-scheme definition)) globals)
  instance-globals :: List CoreInstance -> List CoreGlobal -> List CoreGlobal
  instance-globals instances globals = case instances of Nil -> globals; Cons dictionary rest -> instance-globals rest (field-globals (instance-fields dictionary) globals)
  check-core-closed :: TypingContext -> List CoreDefinition -> Store -> Store
  check-core-closed globals definitions st = case definitions of
    Nil -> st
    Cons d rest -> check-core-closed globals rest (if not (core-definition-checked-contracts-closed (context-body-context globals) (context-guarded-bodies globals) d) then add-error zero (string-concat "typed core contains an unresolved scheme or error term: " (string-concat (core-name d) (string-concat ": " (case core-definition-refusal (context-body-context globals) (context-guarded-bodies globals) d of Some reason -> reason; None -> "the conjunction refused without a named clause")))) st
      else case par-definition-error globals d of
        Some (sp, message) -> add-error sp message st
        None -> case task-definition-error globals d of
          Some (sp, message) -> add-error sp message st
          None -> if typing-definition-closed globals d then st else add-error zero (string-concat "independent Core typing disagrees with the declaration or term: " (core-name d)) st)
  check-field-globals :: TypingContext -> List CoreDictionaryField -> Store -> Store
  check-field-globals globals fields st = case fields of Nil -> st; Cons field rest -> check-field-globals globals rest (check-core-closed globals [dictionary-field-definition field] st)
  check-instance-globals :: TypingContext -> List CoreInstance -> Store -> Store
  check-instance-globals globals instances st = case instances of Nil -> st; Cons dictionary rest -> check-instance-globals globals rest (check-field-globals globals (instance-fields dictionary) st)
  declared-kind-rows :: TypeContext -> List (String, Kind)
  declared-kind-rows context = case context of MkTypeContext kinds aliases active observers effects source-classes -> kinds
  check-global-core :: TypeContext -> List CheckedBinding -> List CoreInstance -> List CoreData -> List CoreDefinition -> Store -> Store
  check-global-core kinds bindings instances datas definitions st =
    let rows = declared-kind-rows kinds in
    let globals = instance-globals instances (global-bindings (finish-bindings st bindings) Nil) in
    case close-typing-context-with-definitions rows globals (context-effects kinds) datas definitions of
      Some closed -> check-instance-globals closed instances (check-core-closed closed definitions st)
      None -> add-error zero (string-concat "global declaration environment is not closed: " (closure-refusal rows globals (context-effects kinds) datas definitions)) st
  -- Reuse the schemes registered and checked above. Re-reading a surface
  -- constructor type here would discard the exact nominal identities.
  checked-constructors :: List (String, TypeExpr) -> List CheckedBinding -> Store -> (List CoreConstructor, Store)
  checked-constructors cs env st = case cs of
    Nil -> (Nil, st)
    Cons (name, ty) rest -> case lookup-binding name env of
      Some binding -> case checked-constructors rest env st of
        (more, ss) -> (Cons (MkCoreConstructor (type-expr-span ty) name (checked-scheme binding)) more, ss)
      None -> checked-constructors rest env (add-error (type-expr-span ty) "typed data constructor has no checked binding" st)
  -- A public constructor table may omit private constructors. Only a
  -- complete defining table can supply layout tags; an abstract carrier
  -- remains an owned object without inventing its hidden field maps.
  runtime-constructor-names :: Json -> Json -> Bool
  runtime-constructor-names constructors names = case (constructors, names) of
    (JArr row rest, JArr (JStr name) more) -> (case field "symbol" row of JStr actual -> same actual name; other -> False)
      && runtime-constructor-names rest more
    (JArrEnd, JArrEnd) -> True
    other -> False
  runtime-constructors-complete :: String -> Json -> Bool
  runtime-constructors-complete owner rows = case rows of
    JArr first rest -> case field "symbol" first of
      JStr symbol -> case ctor-description (interface-global symbol) (resolved-nominals first) of
        Some description -> same owner (case field "identity" description of JStr name -> interface-global name; other -> "")
          && runtime-constructor-names rows (field "constructors" description)
        None -> False
      other -> False
    JArrEnd -> True
    other -> False
  checked-imported-runtime-constructors :: Span -> String -> List (String, Kind) -> TypeContext -> Nat -> Json -> Store -> (List CoreConstructor, Store)
  checked-imported-runtime-constructors sp owner classes kinds index rows st = case rows of
    JArr row rest -> case (field "symbol" row, field "tag" row, resolved-text row) of
      (JStr symbol, JNum tag, Some text) -> let name = interface-global symbol in
        let tagged = if tag == nat-to-int index then st else add-error sp "imported runtime constructor tag disagrees with defining order" st in
        (case imported-scheme sp classes kinds (TName sp "Int") row tagged of
          (sc, checked) -> let valid = check-imported-constructor sp name sc row checked in
            case checked-imported-runtime-constructors sp owner classes kinds (index + 1) rest valid of
              (more, done) -> (Cons (MkCoreConstructor sp name sc) more, done))
      other -> (Nil, add-error sp "imported runtime constructor lacks a resolved scheme or tag" st)
    JArrEnd -> (Nil, st)
    other -> (Nil, add-error sp "invalid imported runtime constructor table" st)
  checked-data-declaration :: List (String, Kind) -> TypeContext -> List CheckedBinding -> Decl -> Store -> (Option CoreData, Store)
  checked-data-declaration classes kinds env d st = case d of
    DData s name ps cs -> case context-kind name kinds of
      Some k -> case parameters False kinds Nil ps 0 Nil st of
        (qs, sq) -> case checked-constructors cs env sq of
          (constructors, sc) -> (Some (MkCoreData s name k qs constructors), sc)
      None -> (None, add-error s "typed data declaration has no checked kind" st)
    DExternal s name category scheme metadata -> if same category "type" && (case field "kind" metadata of JStr variety -> same variety "data" || same variety "record" || same variety "codata"; other -> False) then
      (case imported-kinds kinds (field "parameters" metadata) st of
        (qs, checked) -> if (case field "kind" metadata of JStr kind -> same kind "codata"; other -> False) then
          let storage = record-storage-name True name in
          (case lookup-binding storage env of
            Some binding -> (Some (MkCoreData s name (kind-arrow qs) qs [MkCoreConstructor s storage (checked-scheme binding)]), checked)
            None -> (None, add-error s "codata has no checked observation storage" checked))
          else if runtime-constructors-complete name (field "ctors" metadata) then
            (case checked-imported-runtime-constructors s name classes kinds 0 (field "ctors" metadata) checked of
              (constructors, done) -> (Some (MkCoreData s name (kind-arrow qs) qs constructors), done))
            else (Some (MkCoreData s name (kind-arrow qs) qs Nil), checked))
      else (None, st)
    other -> (None, st)
  checked-data :: List (String, Kind) -> TypeContext -> List CheckedBinding -> List Decl -> List CoreData -> Store -> (List CoreData, Store)
  checked-data classes kinds env ds backwards st = case ds of
    Nil -> (reverse backwards, st)
    Cons d rest -> case checked-data-declaration classes kinds env d st of
      (found, ss) -> checked-data classes kinds env rest (case found of None -> backwards; Some typed -> Cons typed backwards) ss
  -- A function may return a private data carrier without importing its type
  -- name. Its resolved nominal contract still proves the word is an object;
  -- it grants neither constructor layouts nor source access to private fields.
  nominal-runtime-data :: Json -> TypeContext -> List CoreData -> Store -> (List CoreData, Store)
  nominal-runtime-data rows kinds datas st = case rows of
    JArr row rest -> (case (field "kind" row, field "identity" row) of
      (JStr variety, JStr identity) -> if same variety "data" && not (runtime-data-present (interface-global identity) datas) then
        (case imported-kinds kinds (field "parameters" row) st of
          (params, checked) -> nominal-runtime-data rest kinds (Cons (MkCoreData zero (interface-global identity) (kind-arrow params) params Nil) datas) checked)
        else nominal-runtime-data rest kinds datas st
      other -> nominal-runtime-data rest kinds datas st)
    other -> (datas, st)
  runtime-data-present :: String -> List CoreData -> Bool
  runtime-data-present name datas = case datas of Nil -> False; Cons first rest -> same name (core-data-name first) || runtime-data-present name rest
  checked-nominal-data :: List Decl -> TypeContext -> List CoreData -> Store -> (List CoreData, Store)
  checked-nominal-data ds kinds datas st = case ds of
    Nil -> (datas, st)
    Cons (DExternal sp name category syntax metadata) rest -> (case nominal-runtime-data (resolved-nominals metadata) kinds datas st of
      (more, checked) -> checked-nominal-data rest kinds more checked)
    Cons other rest -> checked-nominal-data rest kinds datas st
  replace-runtime-data :: CoreData -> List CoreData -> List CoreData
  replace-runtime-data actual datas = case datas of
    Nil -> Nil
    Cons first rest -> if same (core-data-name actual) (core-data-name first) then Cons actual rest else Cons first (replace-runtime-data actual rest)
  -- Materialization may retain a constructor use while pruning the unused
  -- source type-name declaration. Recover only complete PUBLIC defining
  -- tables for carriers already checked above. Source names remain governed
  -- by the resolver; partial/private tables remain abstract.
  complete-runtime-data-rows :: Json -> List (String, Kind) -> TypeContext -> List CoreData -> Store -> (List CoreData, Store)
  complete-runtime-data-rows rows classes kinds datas st = case rows of
    JArr row rest -> (case (field "identity" row, field "kind" row) of
      (JStr identity, JStr variety) -> let name = interface-global identity in
        if (same variety "data" || same variety "record") && runtime-data-present name datas && runtime-constructors-complete name (field "ctors" row) then
          (case checked-data-declaration classes kinds Nil (DExternal zero name "type" None row) st of
            (Some actual, checked) -> complete-runtime-data-rows rest classes kinds (replace-runtime-data actual datas) checked
            (None, checked) -> complete-runtime-data-rows rest classes kinds datas checked)
        else complete-runtime-data-rows rest classes kinds datas st
      other -> complete-runtime-data-rows rest classes kinds datas st)
    other -> (datas, st)
  complete-runtime-data :: List Decl -> List (String, Kind) -> TypeContext -> List CoreData -> Store -> (List CoreData, Store)
  complete-runtime-data ds classes kinds datas st = case ds of
    Nil -> (datas, st)
    Cons (DInterface sp name hash metadata) rest -> (case complete-runtime-data-rows (field "types" (field "exports" metadata)) classes kinds datas st of
      (more, checked) -> complete-runtime-data rest classes kinds more checked)
    Cons other rest -> complete-runtime-data rest classes kinds datas st
  check-data-closed :: List CoreData -> Store -> Store
  check-data-closed datas st = case datas of
    Nil -> st
    Cons d rest -> check-data-closed rest (if core-data-closed d then st else add-error zero "typed data contains an unresolved constructor scheme" st)
  checked-operations :: Nat -> List (String, TypeExpr) -> List CheckedBinding -> Store -> (List CoreOperation, Store)
  checked-operations next ops env st = case ops of
    Nil -> (Nil, st)
    Cons (name, syntax) rest -> case lookup-binding name env of
      Some binding -> case checked-operations (next + 1) rest env st of
        (more, checked) -> (Cons (MkCoreOperation (type-expr-span syntax) name next (checked-scheme binding)) more, checked)
      None -> checked-operations (next + 1) rest env (add-error (type-expr-span syntax) "effect operation has no checked binding" st)
  checked-effects :: TypeContext -> List CheckedBinding -> List Decl -> Store -> (List CoreEffect, Store)
  checked-effects kinds env ds st = case ds of
    Nil -> (Nil, st)
    Cons d rest -> case d of
      DEffect s name ps ops -> case parameters False kinds Nil ps 0 Nil st of
        (qs, sq) -> case context-kind name kinds of
          Some kind -> case checked-operations 1 ops env sq of
            (operations, checked) -> let declaration = MkCoreEffect s name kind qs operations in
              case checked-effects kinds env rest (if core-effect-closed declaration then checked else add-error s "effect operation must have closed binders and perform exactly its declaring effect on its last arrow" checked) of
                (more, final) -> (Cons declaration more, final)
          None -> checked-effects kinds env rest (add-error s "effect has no checked declaration kind" sq)
      other -> checked-effects kinds env rest st
  instance-member-errors :: List Decl -> List String -> List String -> Store -> Store
  instance-member-errors members wanted signatures st = case members of
    Nil -> st
    Cons d rest -> case d of
      DFun sp name clauses -> if has name wanted then instance-member-errors rest wanted signatures st else instance-member-errors rest wanted signatures (add-error sp "instance defines a method outside its declaring class" st)
      DSig sp name ty -> if has name wanted && not (has name signatures) then instance-member-errors rest wanted (Cons name signatures) st else instance-member-errors rest wanted signatures (add-error sp "instance has an extra or duplicate method signature" st)
      other -> instance-member-errors rest wanted signatures (add-error (decl-span d) "unsupported instance member declaration" st)
  class-member-names :: List CoreClassMethod -> List String
  class-member-names members = case members of Nil -> Nil; Cons member rest -> Cons (class-method-name member) (class-member-names rest)
  member-annotation :: String -> List Decl -> Option TypeExpr
  member-annotation name ds = case ds of Nil -> None; Cons (DSig sp member ty) rest -> if same member name then Some ty else member-annotation name rest; Cons other rest -> member-annotation name rest
  quant-next :: List Quant -> Nat
  quant-next qs = case qs of Nil -> 0; Cons q rest -> let more = quant-next rest in if quant-id q + 1 > more then quant-id q + 1 else more
  quant-names :: List Quant -> List String
  quant-names qs = case qs of Nil -> Nil; Cons q rest -> Cons (quant-name q) (quant-names rest)
  member-annotation-scheme :: List (String, Kind) -> TypeContext -> List Quant -> TypeExpr -> Store -> (Scheme, Store)
  member-annotation-scheme classes kinds inherited ty st = case ty of
    TForall sp binders body -> case parameters False kinds (quant-locals inherited) (inferred-forall-parameters kinds (quant-locals inherited) (region-parameters (forall-params-of binders) (region-names body)) body) (quant-next inherited) (quant-names inherited) (if quantifiers-ok binders then st else add-error sp "malformed instance method quantifiers" st) of
      (local, checked) -> scheme-body-from False classes kinds (inherited <> local) body checked
    other -> scheme-body-from False classes kinds inherited ty st
  checked-member-annotation :: List (String, Kind) -> TypeContext -> Scheme -> Scheme -> Option TypeExpr -> Store -> (Scheme, Store)
  checked-member-annotation classes kinds factory expected annotation st = case annotation of
    None -> (expected, st)
    Some syntax -> case member-annotation-scheme classes kinds (scheme-params factory) syntax st of
      (annotated, checked) -> (annotated, if scheme-equivalent expected annotated then checked else add-error (type-expr-span syntax) "instance method signature disagrees with the specialized class contract" checked)
  source-instance-fields :: Span -> List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List Decl -> CoreClass -> String -> Scheme -> List Decl -> List CoreClassMethod -> Store -> (List CoreDictionaryField, Store)
  source-instance-fields instance-span classes kinds families env defaults description symbol factory declarations methods st = case methods of
    Nil -> (Nil, st)
    Cons (MkCoreEquationMethod sp name slot telescope identity equation) rest ->
      (Nil, add-error instance-span "an equality method implementation needs erased proof elaboration" st)
    Cons member rest -> let name = class-method-name member in
      case specialize-method description factory member of
        None -> (Nil, add-error zero "cannot specialize defining class method to instance head" st)
        Some expected ->
          let (actual, prepared) = checked-member-annotation classes kinds factory expected (member-annotation name declarations) st in
          let private-name = dictionary-method-symbol symbol (class-method-slot member) in
          let implementation = implementation-scheme factory actual in
          let bound = Cons (MkCheckedBinding private-name implementation "instance-method") env in
          let existing = inherited-default-clauses description member defaults actual in
          let (clauses, with-default) = if has-definition name declarations then (Some (function-clauses name declarations), prepared) else (case existing of Some original -> (Some original, prepared); None -> checked-imported-default instance-span classes kinds families env description member defaults actual prepared) in
          let annotations = if has-definition name declarations then Some Nil else default-annotation-bindings description factory member actual in
          case (clauses, annotations) of
            (None, other) -> (Nil, add-error instance-span (string-concat-all ["instance ", diagnostic-member-name symbol, " does not define method ", name]) with-default)
            (Some body, None) -> (Nil, add-error zero "inherited default has no checked annotation-binder specialization" with-default)
            (Some body, Some aliases) -> (case check-definition-with-annotations classes kinds families bound zero private-name body aliases with-default of
              (None, failed) -> (Nil, failed)
              (Some definition, checked) -> case resolve-dictionary-definition-with classes (env-instances env) definition checked of
                (resolved, final) -> case source-instance-fields instance-span classes kinds families env defaults description symbol factory declarations rest final of
                  (more, done) -> (Cons (MkCoreDictionaryField zero (class-method-slot member) (seal-definition-with-checked-contracts (env-body-context env) (env-guarded-bindings env) done resolved)) more, done))
  checked-source-instances :: List Json -> List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List Decl -> List CoreClass -> Store -> (List CoreClass, List CoreInstance, Store)
  checked-source-instances rows classes kinds families env ds descriptions st = checked-source-instances-with rows classes kinds families env ds ds descriptions st
  checked-source-instances-with :: List Json -> List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List Decl -> List Decl -> List CoreClass -> Store -> (List CoreClass, List CoreInstance, Store)
  checked-source-instances-with rows classes kinds families env all ds descriptions st = case ds of
    Nil -> (descriptions, Nil, st)
    Cons (DInstance sp flag name ps head-type members) rest -> case lookup-binding name env of
      Some binding -> let factory = checked-scheme binding in
        (case root-name (scheme-body factory) of
          Some owner -> (case (case find-class owner descriptions of Some description -> (Some description, st); None -> typed-class sp owner rows classes kinds st) of
            (Some description, checked) -> let members-list = decls-of members in
              let prepared = instance-member-errors members-list (class-member-names (class-methods description)) Nil checked in
              (case source-instance-fields sp classes kinds families env all description name factory members-list (class-methods description) prepared of
                (fields, done) -> let constructor = MkCoreInstance sp name flag factory fields in
                  let retained = case find-class owner descriptions of Some prior -> descriptions; None -> Cons description descriptions in
                  let verified = if instance-closed (MkCoreClassContext classes retained) constructor then done else add-error sp "source dictionary constructor disagrees with its defining class or method contracts" done in
                  (case checked-source-instances-with rows classes kinds families env all rest retained verified of
                    (more, others, final) -> (more, Cons constructor others, final)))
            (None, failed) -> checked-source-instances-with rows classes kinds families env all rest descriptions failed)
          None -> checked-source-instances-with rows classes kinds families env all rest descriptions (add-error sp "instance target has no defining signature identity" st))
      None -> checked-source-instances-with rows classes kinds families env all rest descriptions (add-error sp "source instance has no registered dictionary head" st)
    Cons other rest -> checked-source-instances-with rows classes kinds families env all rest descriptions st
  -- Use the same quantified openings and dependent argument patterns as
  -- ordinary checked functions. The terminal Unit is only a binder-spine
  -- sentinel. The equation's carrier comes from the checked terms.
  law-input-type :: Span -> LawSyntax -> TypeExpr
  law-input-type sp syntax = case syntax of
    LawForall parameters body -> TForall sp (forall-param-spine sp parameters) (law-input-type sp body)
    LawArrow domain body -> TFun (type-expr-span domain) domain (law-input-type sp body)
    other -> TName sp "Unit"

  law-operands :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> UType -> LawSyntax -> Store -> (List CorePattern, Option (CoreTerm, CoreTerm), Store)
  law-operands classes kinds families env locals inputs syntax st = case syntax of
    LawForall parameters body -> law-operands classes kinds families env locals inputs body st
    LawArrow domain body ->
      let pattern = case domain of TBound sp name ty tail -> PVar sp name; other -> PWild (type-expr-span domain) in
      (case bind-arrow-pattern classes kinds families env locals pattern inputs st of
        (bound, checked, effects, result, ready) -> case law-operands classes kinds families bound locals result body ready of
          (patterns, operands, final) -> (Cons checked patterns, operands, final))
    LawEquation left right -> case infer classes kinds families env locals left st of
      (first, checked) -> case check-required classes kinds families env locals right (normalize checked (core-type first)) checked of
        (second, done) -> (Nil, Some (first, second), include-effects (expr-span right) (core-effects second) (URow UEnd)
          (include-effects (expr-span left) (core-effects first) (URow UEnd) done))
    LawProposition ty -> (Nil, None, add-error (type-expr-span ty) "class law proposition form needs checked elaboration" st)

  source-cited-law :: String -> List Decl -> Option LawSyntax
  source-cited-law member declarations = case declarations of
    Nil -> None
    Cons (DLaw sp name syntax) rest -> if same name member then Some syntax else source-cited-law member rest
    Cons other rest -> source-cited-law member rest
  declared-cited-law :: String -> String -> List Decl -> Option LawSyntax
  declared-cited-law owner member declarations = case declarations of
    Nil -> None
    Cons (DClass sp name parameters members) rest -> if same name owner then source-cited-law member (decls-of members)
      else declared-cited-law owner member rest
    Cons other rest -> declared-cited-law owner member rest
  imported-cited-law :: Span -> String -> Json -> Option LawSyntax
  imported-cited-law sp member rows = case rows of
    JArr row rest -> if same (contract-text (field "name" row)) member then
      portable-law-syntax sp portable-default-global (field "syntax" row)
      else imported-cited-law sp member rest
    other -> None
  source-equation-method :: CoreClass -> String -> Option (String, LawSyntax)
  source-equation-method description member = case source-method member (class-methods description) of
    Some method -> class-method-equation method
    None -> None
  law-assumption-identity :: String -> String -> Option String
  law-assumption-identity owner member = case export-global owner of
    Ok identity -> Some (law-owner-module (unpack identity) "" "" <> member)
    Err error -> None
  law-owner-module :: List Char -> String -> String -> String
  law-owner-module characters prefix segment = case characters of
    Nil -> prefix
    Cons first rest -> if char-code first == 46 then law-owner-module rest (prefix <> segment <> ".") ""
      else law-owner-module rest prefix (segment <> pack [first])

  rewrite-matches :: CoreTerm -> Bool
  rewrite-matches term = case term of
    CApply sp ty function argument -> rewrite-matches function
    CUse sp ty name role actuals -> True
    CQualifiedUse sp ty name role actuals evidence -> True
    CMethod sp ty name owner slot actuals evidence -> True
    CPrimitive sp ty name arguments -> True
    other -> False
  rewrite-resource-count :: Nat -> List (Nat, UType) -> Nat
  rewrite-resource-count id free = case free of
    Nil -> 0
    Cons (key, ty) rest -> (if id == key then 1 else 0) + rewrite-resource-count id rest
  rewrite-mentions-task :: UType -> Bool
  rewrite-mentions-task ty = case refinement-view ty of
    UCon name kind -> same name "b.Task"
    UApp first second -> rewrite-mentions-task first || rewrite-mentions-task second
    UFun domain result -> rewrite-mentions-task domain || rewrite-mentions-task result
    UFunEff domain row result -> rewrite-mentions-task domain || rewrite-mentions-task result
    UPi id name domain row result -> rewrite-mentions-task domain || rewrite-mentions-task result
    UUsageArrow usage arrow -> rewrite-mentions-task arrow
    URequire predicates result -> rewrite-mentions-task result
    URefine id name carrier predicate -> rewrite-mentions-task carrier
    UTuple fields -> rewrite-mentions-task fields
    UArg first rest -> rewrite-mentions-task first || rewrite-mentions-task rest
    other -> False
  rewrite-restricted-type :: UType -> Bool
  rewrite-restricted-type ty = case refinement-view ty of
    UApp (UCon name kind) carrier | same name "Later" && kind-equal kind (KFun KType KType) -> True
    carrier -> (case thunk-parts carrier of Some parts -> True; None -> rewrite-mentions-task carrier)
  rewrite-free-bound :: List (Nat, UType) -> List (Nat, UType) -> Bool
  rewrite-free-bound pattern used = case used of
    Nil -> True
    Cons (id, ty) rest -> rewrite-resource-count id pattern > 0 && rewrite-free-bound pattern rest
  rewrite-restricted-binders :: Store -> List (String, UType) -> List (Nat, UType) -> List (Nat, UType) -> Bool
  rewrite-restricted-binders st locals left right = case locals of
    Nil -> True
    Cons (name, value) rest ->
      let safe = (case (value-carrier (type-kind value), index-of-type value) of
        (Some carrier, Some (IRigid id display level)) -> not (rewrite-restricted-type (normalize st carrier))
          || (rewrite-resource-count id left == 1 && rewrite-resource-count id right == 1)
        other -> True) in
      safe && rewrite-restricted-binders st rest left right
  rewrite-resource-safe :: Store -> List (String, UType) -> CoreTerm -> CoreTerm -> Option CoreTerm -> Bool
  rewrite-resource-safe st locals lhs rhs guard =
    let left = task-free Nil lhs in
    let right = task-free Nil rhs in
    let required = (case guard of None -> Nil; Some test -> task-free Nil test) in
    rewrite-free-bound left (right <> required) && rewrite-restricted-binders st locals left right
  resolve-rewrite-term :: List (String, Kind) -> List CheckedBinding -> List CoreGiven -> CoreTerm -> Store -> (CoreTerm, Store)
  resolve-rewrite-term classes env givens term st =
    resolve-dictionary-term-with classes (env-instances env) givens term st

  check-citation-arguments :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> List CorePattern -> List Expr -> Store -> (List (Nat, CoreTerm), Store)
  check-citation-arguments classes kinds families env locals formals args st = case (formals, args) of
    (Nil, Nil) -> (Nil, st)
    (Cons (CPVar sp ty id name) rest, Cons expression more) ->
      (case check-required classes kinds families env locals expression ty st of
        (value, checked) -> case check-citation-arguments classes kinds families env locals rest more
          (include-effects (expr-span expression) (core-effects value) (URow UEnd) checked) of
            (values, done) -> (Cons (id, value) values, done))
    (Cons (CPWild sp ty) rest, Cons expression more) ->
      (case check-required classes kinds families env locals expression ty st of
        (value, checked) -> check-citation-arguments classes kinds families env locals rest more
          (include-effects (expr-span expression) (core-effects value) (URow UEnd) checked))
    other -> (Nil, add-error zero "law citation arguments disagree with its checked value parameters" st)
  resolve-citation-arguments :: List (String, Kind) -> List CheckedBinding -> List CoreGiven -> List (Nat, CoreTerm) -> Store -> (List (Nat, CoreTerm), Store)
  resolve-citation-arguments classes env givens arguments st = case arguments of
    Nil -> (Nil, st)
    Cons (id, value) rest -> case resolve-rewrite-term classes env givens value st of
      (resolved, checked) -> case resolve-citation-arguments classes env givens rest checked of
        (more, done) -> (Cons (id, resolved) more, done)
  normalize-citation-arguments :: Store -> List (Nat, CoreTerm) -> List (Nat, CoreTerm)
  normalize-citation-arguments st values = case values of
    Nil -> Nil
    Cons (id, value) rest -> Cons (id, map-term-types (normalize st) value) (normalize-citation-arguments st rest)

  check-rewrite-citation :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> List CoreGiven -> CoreClass -> LawSyntax -> List Expr -> CoreTerm -> CoreTerm -> Span -> Store -> Store
  check-rewrite-citation classes kinds families env locals givens description syntax args lhs rhs sp st =
    let (header, declared) = make-scheme False classes kinds (class-params description) (law-input-type sp syntax) st in
    let (inputs, constraints, pairs, opened) = open-qualified False header declared in
    let law-locals = opened-locals (scheme-params header) pairs in
    case law-operands classes kinds families env law-locals inputs syntax opened of
      (formals, Some (first, second), prepared) ->
        let (values, checked) = check-citation-arguments classes kinds families env locals formals args prepared in
        let (rule-left, left-store) = resolve-rewrite-term classes env givens lhs checked in
        let (rule-right, right-store) = resolve-rewrite-term classes env givens rhs left-store in
        let (law-left, first-store) = resolve-rewrite-term classes env givens first right-store in
        let (law-right, second-store) = resolve-rewrite-term classes env givens second first-store in
        let (actuals, resolved) = resolve-citation-arguments classes env givens values second-store in
        let done = finish-numbers resolved in
        let typed = map-term-types (normalize done) in
        let substitutions = normalize-citation-arguments done actuals in
        if (case store-errors done of Nil -> True; other -> False) &&
          not (rewrite-term-equal substitutions (typed rule-left) (typed law-left)
            && rewrite-term-equal substitutions (typed rule-right) (typed law-right))
        then add-error sp "the justification does not prove the rule's equation" done else done
      (formals, None, checked) -> add-error sp "rewrite citation must conclude with a checked equation" checked

  check-rewrite-evidence :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> List CoreGiven -> List Decl -> List Json -> CoreTerm -> CoreTerm -> RewriteJustification -> Store -> (Option String, Store)
  check-rewrite-evidence classes kinds families env locals givens declarations rows lhs rhs evidence st = case evidence of
    RewriteLaw sp owner member args ->
      let (definition, syntax, assumption, header) = (case find-class owner (context-source-classes kinds) of
        Some description -> (case source-equation-method description member of
          Some (symbol, equation) -> (Some description, Some equation,
            (case export-global symbol of Ok identity -> Some identity; Err error -> None), st)
          None -> (Some description, declared-cited-law owner member declarations, law-assumption-identity owner member, st))
        None -> (case find-class-row owner rows of
          Some row -> let (description, checked) = typed-class sp owner rows classes kinds st in
            (description, imported-cited-law sp member (field "laws" row), law-assumption-identity owner member, checked)
          None -> (None, None, None, st))) in
      (case (definition, syntax, assumption) of
        (Some description, Some equation, Some identity) ->
          (Some identity, check-rewrite-citation classes kinds families env locals givens description equation args lhs rhs sp header)
        other -> (None, add-error sp "rewrite citation needs a checked law from its defining signature" header))
    RewriteTerm (EVar sp name) | same name "b.refl" ->
      let (first, checked) = resolve-rewrite-term classes env givens lhs st in
      let (second, final) = resolve-rewrite-term classes env givens rhs checked in
      let done = finish-numbers final in
      (None, if rewrite-term-equal Nil (map-term-types (normalize done) first) (map-term-types (normalize done) second)
        then done else add-error sp "the justification does not prove the rule's equation" done)
    RewriteTerm expression -> (None, add-error (expr-span expression) "rewrite needs a checked equation proof" st)

  check-rewrite-guard :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Option Expr -> Store -> (Option CoreTerm, Store)
  check-rewrite-guard classes kinds families env locals guard st = case guard of
    None -> (None, st)
    Some expression -> case check-required classes kinds families env locals expression (primitive-type "Bool") st of
      (test, checked) -> (Some test, include-effects (expr-span expression) (core-effects test) (URow UEnd) checked)
  check-source-rewrite :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List Decl -> List Json -> Span -> String -> RewriteSyntax -> Store -> (Option CheckedRewrite, Store)
  check-source-rewrite classes kinds families env declarations rows sp name syntax st = case syntax of
    MkRewriteSyntax True params bounds pattern replacement guard evidence ->
      (None, add-error sp "target rewrite needs a checked target applicability condition" st)
    MkRewriteSyntax False params bounds pattern replacement guard evidence ->
      let header-syntax = TForall sp (forall-param-spine sp params) (TUsing sp bounds (TName sp "Unit")) in
      let (scheme, declared) = make-scheme False classes kinds Nil header-syntax st in
      let (body, requirements, pairs, opened) = open-qualified True scheme (enter-level declared) in
      let locals = opened-locals (scheme-params scheme) pairs in
      let (value-env, ready) = bind-value-parameters (scheme-params scheme) pairs env opened in
      let (bound, givens, scoped) = bind-requirements sp requirements value-env ready in
      let (lhs, matched) = infer classes kinds families bound locals pattern scoped in
      let (rhs, replaced) = check-required classes kinds families bound locals replacement (normalize matched (core-type lhs)) matched in
      let pure-lhs = include-effects sp (core-effects lhs) (URow UEnd) replaced in
      let pure = include-effects sp (core-effects rhs) (URow UEnd) pure-lhs in
      let (condition, guarded) = check-rewrite-guard classes kinds families bound locals guard pure in
      let checked = (if not (kind-equal (type-kind (normalize guarded (core-type lhs))) KType) then
          add-error sp "a rewrite equation must preserve a computational value type" guarded
        else if not (rewrite-matches lhs) then add-error sp "rewrite match must be headed by a defined function, constructor or primitive" guarded
        else if not (rewrite-resource-safe guarded locals lhs rhs condition) then
          add-error sp "rewrite uses an unbound value or changes the use of a restricted binder" guarded else guarded) in
      case store-errors checked of
        Cons error rest -> (None, restore-level (store-level st) checked)
        Nil -> (case check-rewrite-evidence classes kinds families bound locals givens declarations rows lhs rhs evidence checked of
          (identity, verified) -> retain-checked-rewrite classes bound givens (store-level st) name lhs rhs condition identity verified)

  retain-checked-rewrite :: List (String, Kind) -> List CheckedBinding -> List CoreGiven -> Nat -> String -> CoreTerm -> CoreTerm -> Option CoreTerm -> Option String -> Store -> (Option CheckedRewrite, Store)
  retain-checked-rewrite classes env givens level name lhs rhs guard identity st =
    let (first, checked) = resolve-rewrite-term classes env givens lhs st in
    let (second, replaced) = resolve-rewrite-term classes env givens rhs checked in
    let (condition, final) = (case guard of
      None -> (None, replaced)
      Some test -> (case resolve-rewrite-term classes env givens test replaced of
        (resolved, done) -> (Some resolved, done))) in
    let typed = map-term-types (normalize final) in
    let test = (case condition of None -> None; Some value -> Some (typed value)) in
    let done = restore-level level final in
    case store-errors done of
      Nil -> (Some (MkCheckedRewrite name (typed first) (typed second) test identity), done)
      other -> (None, done)

  check-source-rewrites :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List Decl -> List Json -> List Decl -> List String -> Store -> (List CheckedRewrite, Store)
  check-source-rewrites classes kinds families env declarations rows pending seen st = case pending of
    Nil -> (Nil, st)
    Cons (DRewrite sp name syntax) rest -> if has name seen then (Nil, add-error sp "duplicate rewrite declaration" st)
      else (case check-source-rewrite classes kinds families env declarations rows sp name syntax st of
        (Some rule, checked) -> (case check-source-rewrites classes kinds families env declarations rows rest (Cons name seen) checked of
          (more, done) -> (Cons rule more, done))
        (None, failed) -> (Nil, failed))
    Cons other rest -> check-source-rewrites classes kinds families env declarations rows rest seen st

  check-class-law :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> CoreClass -> Span -> String -> LawSyntax -> Store -> Store
  check-class-law classes kinds families env description sp name syntax st =
    let parameters = class-params description in
    case make-scheme False classes kinds parameters (law-input-type sp syntax) st of
      (sc, header) -> if list-length (store-errors header) /= list-length (store-errors st) then header else
        let self = applied-family (class-name description) (class-kind description) parameters in
        let scheme = qualified (scheme-params sc) [MkRequirement "#self" self] (scheme-body sc) in
        let level = store-level header in
        case open-qualified True scheme (enter-level header) of
          (inputs, requirements, pairs, opened) ->
            let locals = opened-locals (scheme-params scheme) pairs in
            case bind-value-parameters (scheme-params scheme) pairs env opened of
              (value-env, value-store) -> case bind-requirements sp requirements value-env value-store of
                (bound, givens, ready) -> case law-operands classes kinds families bound locals inputs syntax (with-law-scope True ready) of
                  (patterns, operands, checked) -> with-law-scope (store-law-scope st)
                    (restore-level level (case operands of
                      Some (left, right) -> check-law-term-evidence classes givens right (check-law-term-evidence classes givens left checked)
                      None -> checked))

  check-class-laws :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> CoreClass -> List Decl -> List String -> Store -> Store
  check-class-laws classes kinds families env description members seen st = case members of
    Nil -> st
    Cons (DLaw sp name syntax) rest -> check-class-laws classes kinds families env description rest (Cons name seen)
      (if has name seen then add-error sp (string-concat "duplicate class law: " name) st
       else check-class-law classes kinds families env description sp name syntax st)
    Cons (DMethod sp name symbol syntax) rest -> case source-equation-method description name of
      Some (identity, equation) -> check-class-laws classes kinds families env description rest (Cons name seen)
        (if has name seen then add-error sp (string-concat "duplicate class equation: " name) st
         else finish-numbers (check-class-law classes kinds families env description sp name equation st))
      None -> check-class-laws classes kinds families env description rest seen st
    Cons other rest -> check-class-laws classes kinds families env description rest seen st

  check-source-laws :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List Decl -> Store -> Store
  check-source-laws classes kinds families env ds st = case ds of
    Nil -> st
    Cons (DClass sp name parameters members) rest -> check-source-laws classes kinds families env rest
      (case find-class name (context-source-classes kinds) of
        Some description -> check-class-laws classes kinds families env description (decls-of members) Nil st
        None -> st)
    Cons other rest -> check-source-laws classes kinds families env rest st

  law-type-locals :: List Quant -> List UType -> List (String, UType)
  law-type-locals parameters actuals = case (parameters, actuals) of
    (Cons q rest, Cons ty more) -> Cons (quant-name q, ty) (law-type-locals rest more)
    other -> Nil

  law-local-quantifiers :: List Quant -> List Quant -> List Quant
  law-local-quantifiers inherited parameters = case (inherited, parameters) of
    (Cons first rest, Cons parameter more) -> law-local-quantifiers rest more
    other -> parameters

  check-finite-law-instance :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> LawEnvironment -> CoreClass -> CoreInstance -> Span -> String -> LawSyntax -> Store -> (String, Store)
  check-finite-law-instance classes kinds families env sampler description dictionary sp name syntax st =
    let level = store-level st in
    let (subject, requirements, actuals, factory-store) = open-qualified True (instance-scheme dictionary) (enter-level st) in
    let parameters = class-params description in
    let types = constructor-result-arguments subject Nil in
    let (header, declared) = make-scheme False classes kinds parameters (law-input-type sp syntax) factory-store in
    let law-parameters = law-local-quantifiers parameters (scheme-params header) in
    let specialized = MkScheme law-parameters (substitute-bound (law-class-arguments parameters types) (scheme-body header)) in
    let (inputs, law-requirements, law-actuals, opened) = open-qualified True specialized declared in
    let locals = opened-locals law-parameters law-actuals <> law-type-locals parameters types in
    if list-length (store-errors opened) /= list-length (store-errors st) then ("", restore-level level opened) else
      (case unsampled-law-binder families env (normalize opened inputs) opened of
        Some reason -> (unchecked-law reason, restore-level level opened)
        None -> case bind-requirements sp [MkRequirement "#self" subject] env opened of
          (bound, givens, ready) -> case law-operands classes kinds families bound locals inputs syntax ready of
            (patterns, Some (first, second), checked) -> if list-length (store-errors checked) /= list-length (store-errors st) then ("", restore-level level checked) else
              (case resolve-dictionary-term-with classes (env-instances env) givens first checked of
                (left, checked-left) -> case resolve-dictionary-term-with classes (env-instances env) givens second checked-left of
                  (right, resolved-right) -> let checked-right = finish-numbers resolved-right in
                    let done = restore-level level checked-right in
                    if list-length (store-errors done) /= list-length (store-errors st) then ("", done) else
                      report-finite-law-samples sp (law-diagnostic-owner kinds description) name families env sampler dictionary givens
                        (normalize-patterns checked-right patterns) (map-term-types (normalize checked-right) left) (map-term-types (normalize checked-right) right) done)
            (patterns, None, checked) -> (unchecked-law "the law has no checked equation", restore-level level checked))

  normalize-patterns :: Store -> List CorePattern -> List CorePattern
  normalize-patterns st patterns = case patterns of
    Nil -> Nil
    Cons p rest -> Cons (map-pattern-types (normalize st) p) (normalize-patterns st rest)

  unchecked-law :: String -> String
  unchecked-law reason = string-concat-all ["not checked (", reason, ")"]
  take-law-values :: Nat -> List LawValue -> List LawValue
  take-law-values count values = if count == 0 then Nil else case values of
    Nil -> Nil
    Cons first rest -> Cons first (take-law-values (count - 1) rest)

  finite-law-domain :: List (String, List String) -> List CheckedBinding -> UType -> Nat -> Store -> List LawValue
  finite-law-domain families env ty depth st = case ty of
    UCon carrier KType -> if same carrier "Bool" then [LawConstructor "False" LawFieldsEnd, LawConstructor "True" LawFieldsEnd]
      else if same carrier "Nat" || same carrier "Int" then [LawNumber 0, LawNumber 1, LawNumber 2]
      else if same carrier "U32" then [LawNumber 0, LawNumber 1, LawNumber 4294967295]
      else law-family-samples families env ty depth st
    UBound id name KType -> [LawOpaque 0, LawOpaque 1]
    URigid id name level KType -> [LawOpaque 0, LawOpaque 1]
    other -> law-family-samples families env ty depth st

  law-family-samples :: List (String, List String) -> List CheckedBinding -> UType -> Nat -> Store -> List LawValue
  law-family-samples families env ty depth st = if depth == 0 then Nil else case root-name ty of
    Some carrier -> (case family-ctors carrier families of
      Some constructors -> law-constructor-samples families env ty constructors (depth - 1) 4 st
      None -> Nil)
    None -> Nil

  law-constructor-samples :: List (String, List String) -> List CheckedBinding -> UType -> List String -> Nat -> Nat -> Store -> List LawValue
  law-constructor-samples families env ty constructors depth limit st = if limit == 0 then Nil else case constructors of
    Nil -> Nil
    Cons name rest ->
      let current = take-law-values limit (law-constructor-domain families env ty name depth st) in
      let consumed = list-length current in
      if consumed < limit then current <> law-constructor-samples families env ty rest depth (limit - consumed) st
      else current

  law-constructor-domain :: List (String, List String) -> List CheckedBinding -> UType -> String -> Nat -> Store -> List LawValue
  law-constructor-domain families env ty name depth st = case lookup-binding name env of
    Some binding -> if same (checked-role binding) "constructor" then
      (case scheme-requirements (checked-scheme binding) of
        Nil -> (case instantiate (checked-scheme binding) st of
          (constructor, opened) ->
            let checked = unify zero (result-type constructor) ty opened in
            case store-errors checked of
              Nil -> wrap-law-constructor name (law-constructor-fields families env (normalize checked constructor) depth checked)
              other -> Nil)
        other -> Nil)
      else Nil
    None -> Nil

  wrap-law-constructor :: String -> List LawValue -> List LawValue
  wrap-law-constructor name spines = case spines of
    Nil -> Nil
    Cons fields rest -> Cons (LawConstructor name fields) (wrap-law-constructor name rest)

  law-constructor-fields :: List (String, List String) -> List CheckedBinding -> UType -> Nat -> Store -> List LawValue
  law-constructor-fields families env constructor depth st = case constructor of
    UFun field result ->
      let samples = take-law-values 2 (finite-law-domain families env field depth st) in
      take-law-values 3 (law-field-products samples (law-constructor-fields families env result depth st))
    UPi id name field row result -> Nil
    UFunEff field row result -> Nil
    UProofFun predicate row result -> Nil
    other -> [LawFieldsEnd]

  law-field-products :: List LawValue -> List LawValue -> List LawValue
  law-field-products samples tails = case samples of
    Nil -> Nil
    Cons value rest -> prepend-law-field value tails <> law-field-products rest tails

  prepend-law-field :: LawValue -> List LawValue -> List LawValue
  prepend-law-field value tails = case tails of
    Nil -> Nil
    Cons tail rest -> Cons (LawField value tail) (prepend-law-field value rest)

  finite-law-binders :: List (String, List String) -> List CheckedBinding -> List CorePattern -> Store -> Result String (List (Nat, List LawValue))
  finite-law-binders families env patterns st = case patterns of
    Nil -> Ok Nil
    Cons (CPVar site ty id name) rest -> case finite-law-domain families env ty 2 st of
      Nil -> Err (law-binder-no-samples name ty)
      domain -> case finite-law-binders families env rest st of
        Ok more -> Ok (Cons (id, domain) more)
        Err error -> Err error
    other -> Err "the law's binders must be named: `(x :: T) -> ...`"

  law-sample-label :: CoreInstance -> String
  law-sample-label dictionary = case scheme-body (instance-scheme dictionary) of
    UApp class (UCon carrier KType) -> if same carrier "Bool" then " on a Boolean sample" else " on a finite constructor sample"
    other -> " on a finite constructor sample"

  law-diagnostic-owner :: TypeContext -> CoreClass -> String
  law-diagnostic-owner kinds description = let owner = class-name description in
    case find-class owner (context-source-classes kinds) of
      Some source -> (case export-global owner of Ok identity -> identity; Err problem -> owner)
      None -> diagnostic-member-name owner
  report-finite-law-samples :: Span -> String -> String -> List (String, List String) -> List CheckedBinding -> LawEnvironment -> CoreInstance -> List CoreGiven -> List CorePattern -> CoreTerm -> CoreTerm -> Store -> (String, Store)
  report-finite-law-samples sp owner name families env sampler dictionary givens patterns left right st = case (givens, finite-law-binders families env patterns (enter-level st)) of
    (Cons given Nil, Ok binders) -> case sample-finite-law sampler dictionary given binders left right of
      FiniteLawSamples samples -> (string-concat-all ["checked (", nat-to-string samples, " samples)"], st)
      FiniteLawCounterexample -> ("", add-error sp (string-concat-all ["instance `", diagnostic-member-name (instance-name dictionary), "` breaks class law `", owner, ".", name, "`", law-sample-label dictionary]) st)
      FiniteLawUnavailable message -> (unchecked-law message, st)
    (other, Err reason) -> (unchecked-law reason, st)
    other -> (unchecked-law "the instance's dictionaries do not resolve", st)

  finite-law-instance :: List (String, List String) -> List CheckedBinding -> CoreInstance -> Bool
  finite-law-instance families env dictionary = let factory = instance-scheme dictionary in
    case open-qualified True factory (empty-store "law instance sample") of
      (UApp (UCon class kind) carrier, Nil, actuals, opened) -> (case type-kind carrier of
        KType -> (case finite-law-domain families env carrier 2 opened of Nil -> False; other -> True)
        KFun input output -> (case root-name carrier of
          Some name -> (case family-ctors name families of Some (Cons ctor rest) -> True; other -> False)
          None -> False)
        other -> False)
      other -> False
  law-class-arguments :: List Quant -> List UType -> List (Nat, UType)
  law-class-arguments parameters actuals = case (parameters, actuals) of
    (Cons parameter rest, Cons actual more) -> Cons (quant-id parameter, actual) (law-class-arguments rest more)
    other -> Nil
  law-binder-no-samples :: String -> UType -> String
  law-binder-no-samples name ty = string-concat-all ["no samples for the law binder `", name, " :: ", law-domain-text ty, "`"]
  law-domain-text :: UType -> String
  law-domain-text ty = case ty of
    UCon name kind -> case export-global name of Ok identity -> identity; Err error -> name
    UApp function argument -> string-concat-all [law-domain-text function, " ",
      (case argument of UApp inner value -> string-concat-all ["(", law-domain-text argument, ")"]; other -> law-domain-text argument)]
    UFun domain result -> string-concat-all ["(", law-domain-text domain, " -> ", law-domain-text result, ")"]
    UTuple fields -> string-concat-all ["(", law-domain-fields fields, ")"]
    other -> type-text ty
  law-domain-fields :: UType -> String
  law-domain-fields fields = case fields of
    UArg first UEnd -> law-domain-text first
    UArg first rest -> string-concat-all [law-domain-text first, ", ", law-domain-fields rest]
    other -> type-text fields

  unsampled-law-binder :: List (String, List String) -> List CheckedBinding -> UType -> Store -> Option String
  unsampled-law-binder families env ty st = case ty of
    UPi id name domain row result -> case finite-law-domain families env domain 2 st of
      Nil -> Some (law-binder-no-samples name domain)
      values -> unsampled-law-binder families env result st
    UFun domain result -> Some "the law's binders must be named: `(x :: T) -> ...`"
    other -> None
  unsampled-law-status :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> CoreClass -> CoreInstance -> Span -> LawSyntax -> String
  unsampled-law-status classes kinds families env description dictionary sp syntax =
    let unavailable = unchecked-law "the Cinch sampler cannot evaluate this instance" in
    case make-scheme False classes kinds (class-params description) (law-input-type sp syntax) (empty-store "law observation") of
      (sc, checked) -> case store-errors checked of
        Nil -> (case open-qualified True (instance-scheme dictionary) (enter-level checked) of
          (subject, requirements, arguments, opened) ->
            let actuals = constructor-result-arguments subject Nil in
            let specialized = normalize opened (substitute-bound (law-class-arguments (class-params description) actuals) (scheme-body sc)) in
            case unsampled-law-binder families env specialized opened of
              Some reason -> unchecked-law reason
              None -> if law-context-resolves classes (env-instances env) sp requirements opened then unavailable
                else unchecked-law "the instance's dictionaries do not resolve")
        other -> unavailable

  check-law-instances :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> LawEnvironment -> List CoreInstance -> List Decl -> Store -> (List (String, String, String, String), Store)
  check-law-instances classes kinds families env sampler instances ds st = case ds of
    Nil -> (Nil, st)
    Cons (DClass sp name parameters members) rest -> case (case find-class name (context-source-classes kinds) of
      Some description -> check-law-instance-members classes kinds families env description sampler instances (decls-of members) st
      None -> (Nil, st)) of
      (facts, checked) -> case check-law-instances classes kinds families env sampler instances rest checked of
        (more, done) -> (facts <> more, done)
    Cons other rest -> check-law-instances classes kinds families env sampler instances rest st

  check-imported-instance-laws :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List Json -> List CoreClass -> LawEnvironment -> List CoreInstance -> Store -> (List (String, String, String, String), Store)
  check-imported-instance-laws classes kinds families env rows descriptions sampler instances st = case instances of
    Nil -> (Nil, st)
    Cons subject rest -> continue-imported-laws classes kinds families env rows descriptions sampler rest
      (case root-name (scheme-body (instance-scheme subject)) of
      None -> (Nil, st)
      Some owner -> (case (find-class owner descriptions, find-class-row owner rows) of
        (Some description, Some row) -> check-imported-law-rows classes kinds families env description sampler subject (field "laws" row) st
        other -> (Nil, st)))

  continue-imported-laws :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List Json -> List CoreClass -> LawEnvironment -> List CoreInstance -> (List (String, String, String, String), Store) -> (List (String, String, String, String), Store)
  continue-imported-laws classes kinds families env rows descriptions sampler rest current = case current of
    (facts, checked) -> case check-imported-instance-laws classes kinds families env rows descriptions sampler rest checked of
      (more, done) -> (facts <> more, done)

  check-imported-law-rows :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> CoreClass -> LawEnvironment -> CoreInstance -> Json -> Store -> (List (String, String, String, String), Store)
  check-imported-law-rows classes kinds families env description sampler subject rows st = case rows of
    JArr row rest ->
      let name = contract-text (field "name" row) in
      let sp = case subject of MkCoreInstance at symbol flag factory fields -> at in
      continue-imported-law-rows classes kinds families env description sampler subject rest
      (case field "syntax" row of
        JNull -> ([ (instance-name subject, class-name description, name, unchecked-law "the defining interface has no portable law syntax") ], st)
        wire -> case portable-law-syntax sp portable-default-global wire of
          None -> (Nil, add-error sp (string-concat "imported law has unsupported or unscoped syntax: " name) st)
          Some syntax ->
            let checked = check-class-law classes kinds families env description sp name syntax st in
            if list-length (store-errors checked) /= list-length (store-errors st) then (Nil, checked)
            else check-law-subjects classes kinds families env description sp name syntax sampler [subject] checked)
    other -> (Nil, st)

  continue-imported-law-rows :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> CoreClass -> LawEnvironment -> CoreInstance -> Json -> (List (String, String, String, String), Store) -> (List (String, String, String, String), Store)
  continue-imported-law-rows classes kinds families env description sampler subject rest current = case current of
    (facts, checked) -> case check-imported-law-rows classes kinds families env description sampler subject rest checked of
      (more, done) -> (facts <> more, done)

  check-law-instance-members :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> CoreClass -> LawEnvironment -> List CoreInstance -> List Decl -> Store -> (List (String, String, String, String), Store)
  check-law-instance-members classes kinds families env description sampler instances members st = case members of
    Nil -> (Nil, st)
    Cons (DLaw sp name syntax) rest -> case check-law-subjects classes kinds families env description sp name syntax sampler instances st of
      (facts, checked) -> case check-law-instance-members classes kinds families env description sampler instances rest checked of
        (more, done) -> (facts <> more, done)
    Cons other rest -> check-law-instance-members classes kinds families env description sampler instances rest st

  check-law-subjects :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> CoreClass -> Span -> String -> LawSyntax -> LawEnvironment -> List CoreInstance -> Store -> (List (String, String, String, String), Store)
  check-law-subjects classes kinds families env description sp name syntax sampler instances st = case instances of
    Nil -> (Nil, st)
    Cons dictionary rest -> let owner = class-name description in
      if (case root-name (scheme-body (instance-scheme dictionary)) of Some class -> same owner class; None -> False) then
        (case (if law-has-binders syntax && finite-law-instance families env dictionary then
          check-finite-law-instance classes kinds families env sampler description dictionary sp name syntax st
          else (unsampled-law-status classes kinds families env description dictionary sp syntax, st)) of
          (status, checked) -> case check-law-subjects classes kinds families env description sp name syntax sampler rest checked of
            (more, done) -> (Cons (instance-name dictionary, owner, name, status) more, done))
      else check-law-subjects classes kinds families env description sp name syntax sampler rest st

  law-has-binders :: LawSyntax -> Bool
  law-has-binders syntax = case syntax of
    LawForall parameters body -> law-has-binders body
    LawArrow domain body -> True
    other -> False

  proof-clauses :: String -> List Decl -> List (List Pat, Expr)
  proof-clauses name declarations = case declarations of
    Nil -> Nil
    Cons (DProof sp (DFun at symbol clauses)) rest ->
      if same name symbol then clauses <> proof-clauses name rest else proof-clauses name rest
    Cons other rest -> proof-clauses name rest
  proof-signature-present :: String -> List Decl -> Bool
  proof-signature-present name declarations = case declarations of
    Nil -> False
    Cons (DProof sp (DSig at symbol syntax)) rest -> same name symbol || proof-signature-present name rest
    Cons other rest -> proof-signature-present name rest
  closed-proof-failure :: UType -> String
  closed-proof-failure predicate = case predicate of
    UCompare relation (UIndex first (IInteger left)) (UIndex second (IInteger right))
      | same relation "Eq" && valid-type predicate && left /= right ->
        "obligation disproved: " <> type-text predicate
    other -> "kernel refl requires definitionally equal operands"
  -- Closed named evidence is checked at its declaration. Its uses carry
  -- the same independently checked Core witness as an inline refl.
  register-source-proofs :: TypeContext -> List Decl -> List Decl -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-source-proofs kinds declarations remaining env st = case remaining of
    Nil -> (env, st)
    Cons (DProof sp (DSig at name syntax)) rest ->
      case (proof-clauses name declarations, convert-predicate False kinds Nil syntax st) of
        ([(Nil, EVar location witness)], (predicate, checked)) ->
          let closed = normalize checked predicate in
          if not (same witness "b.refl") then
            register-source-proofs kinds declarations rest env
              (add-error location "a closed proof requires kernel refl" checked)
          else if reflexive-equality closed then
            (case add-binding sp name (mono closed) "closed-proof" env checked of
              (more, ready) -> register-source-proofs kinds declarations rest more ready)
          else register-source-proofs kinds declarations rest env
            (add-error location (closed-proof-failure closed) checked)
        (clauses, (predicate, checked)) -> register-source-proofs kinds declarations rest env
          (add-error sp "a closed proof needs exactly one argument-free proof equation" checked)
    Cons (DProof sp (DFun at name clauses)) rest ->
      register-source-proofs kinds declarations rest env
        (if proof-signature-present name declarations then st else add-error sp "proof equation has no proof signature" st)
    Cons (DProof sp other) rest ->
      register-source-proofs kinds declarations rest env (add-error sp "invalid proof declaration" st)
    Cons other rest -> register-source-proofs kinds declarations rest env st

  elaborate-module :: String -> Module -> Elaboration
  elaborate-module label m =
    let interfaces = load-checked-interface-set-from-contracts (total-interface-inputs (module-decls m)) in
    elaborate-module-with-source-bodies interfaces True label m
  elaborate-module-with-source-bodies :: Result String InterfaceSet -> Bool -> String -> Module -> Elaboration
  elaborate-module-with-source-bodies interfaces enable label m =
    let original = module-decls m in
    let has-codata = codata-present original in
    let declarations = if has-codata then unwrap-corec-declarations original else original in
    let ds = if record-definitions-present declarations then record-declarations declarations declarations else declarations in
    let initial = empty-store label in
    let guarded = if has-codata then check-codata-bodies original (codata-call-graph original) original initial else initial in
    let contracts = check-imported-refinements ds Nil guarded in
    let start = data-order ds (data-names ds) Nil contracts in
    let (source-kinds, source-store) = collect-kinds ds primitive-kinds start in
    let rows = class-rows ds in
    let (instance-kinds, instance-store) = source-instance-nominals ds rows source-kinds source-store in
    let (nominal-kinds, sk) = collect-nominal-kinds ds instance-kinds instance-store in
    let (runtime-kinds, runtime-store) = imported-runtime-class-kinds rows nominal-kinds sk in
    -- Copy and Share are compiler-known structural classes: their evidence is
    -- the checked shape of a type, so no module declares them.
    let classes = Cons ("b.Io", KFun KRegion KType) (Cons ("Copy", KFun KType KType) (Cons ("Share", KFun KType KType) (source-class-kinds ds runtime-kinds (class-kinds rows runtime-kinds Nil)))) in
    let (identity-kinds, identity-store) = collect-source-identities ds ds classes runtime-kinds runtime-store in
    let aliases-checked = validate-refinements identity-kinds (context-aliases identity-kinds) identity-store in
    let (class-kinds, class-store) = collect-source-classes ds classes identity-kinds aliases-checked in
    let (import-kinds, import-body-store) = collect-body-contracts ds classes class-kinds class-store in
    let (method-kinds, method-store) = collect-imported-total-methods interfaces ds rows classes import-kinds import-body-store in
    let (kinds, body-store) = if enable then add-source-bodies (source-total-bodies interfaces label m classes method-kinds) method-kinds method-store else (method-kinds, method-store) in
    let (values, sv) = register rows classes kinds ds (context-body-bindings kinds <> builtins) body-store in
    let (proofs, proof-store) = register-source-proofs kinds ds ds values sv in
    let (ordinary-env, si) = register-implicit-instances classes kinds ds proofs proof-store in
    let (uncached-env, registration-store) = register-conditional-instances rows classes kinds ds ordinary-env si in
    let (env, conditional-store) = cache-body-context uncached-env registration-store in
    let se = check-instance-coherence (env-instances env <> conditional-heads env Nil) conditional-store in
    let families = Cons ("Bool", ["True", "False"]) (Cons ("b.Dec", ["b.Yes", "b.No"]) (families-of ds <> imported-families ds)) in
    let default-decls = source-default-definitions ds (context-source-classes kinds) in
    let law-store = case store-errors se of Nil -> check-source-laws classes kinds families env ds se; other -> se in
    let (defaults, default-store) = case store-errors law-store of Nil -> check-bodies classes kinds families env Nil (default-decls <> ds) default-decls law-store; other -> (Nil, law-store) in
    let (effects, sx) = case store-errors default-store of Nil -> checked-effects kinds env ds default-store; other -> (Nil, default-store) in
    let linked-kinds = context-with-effects effects kinds in
    let (descriptions, instances, sm) = case store-errors sx of Nil -> checked-source-instances rows classes linked-kinds families env ds (context-source-classes linked-kinds) sx; other -> (Nil, Nil, sx) in
    let (ordinary-core, body-checked) = case store-errors sm of Nil -> check-bodies classes linked-kinds families env Nil ds ds sm; other -> (Nil, sm) in
    let core = defaults <> ordinary-core in
    let sampler = MkLawEnvironment instances (env-body-context env) core in
    let (source-laws, source-sampled) = case store-errors body-checked of
          Nil -> check-law-instances classes linked-kinds families env sampler instances ds body-checked
          other -> (Nil, body-checked) in
    let (imported-laws, done) = case store-errors source-sampled of
          Nil -> check-imported-instance-laws classes linked-kinds families env rows descriptions sampler instances source-sampled
          other -> (Nil, source-sampled) in
    let law-observations = source-laws <> imported-laws in
    let (rewrites, rewritten) = (case store-errors done of
      Nil -> check-source-rewrites classes linked-kinds families env ds rows ds Nil done
      other -> (Nil, done)) in
    let (declared-data, declared-store) = case store-errors rewritten of Nil -> checked-data classes linked-kinds env ds Nil rewritten; other -> (Nil, rewritten) in
    let (nominal-data, nominal-store) = case store-errors declared-store of Nil -> checked-nominal-data ds linked-kinds declared-data declared-store; other -> (declared-data, declared-store) in
    let (datas, sd) = case store-errors nominal-store of Nil -> complete-runtime-data ds classes linked-kinds nominal-data nominal-store; other -> (nominal-data, nominal-store) in
    let finished = case store-errors sd of Nil -> check-data-closed datas (check-global-core linked-kinds env instances datas core sd); other -> sd in
    let retained-classes = case store-errors finished of Nil -> checked-imported-classes rows rows classes linked-kinds descriptions; other -> descriptions in
    let (temporal-rows, temporal-store) = check-temporal-contracts (module-name m) classes linked-kinds families env ds core finished in
    MkElaboration (store-errors temporal-store) (finish-bindings temporal-store env) (contexts ds) core datas effects (MkCoreClassContext classes retained-classes) instances ds law-observations rewrites temporal-rows

  -- Records use the ordinary independently checked single-constructor
  -- representation. Labels remain in a DRecord for source provenance;
  -- field values are bound in written order before layout-order assembly.
  record-labels :: List (String, TypeExpr) -> List String
  record-labels fields = case fields of Nil -> Nil; Cons (name, ty) rest -> Cons name (record-labels rest)
  data RecordShape where
    RecordShape :: String -> List String -> Option (List (String, TypeExpr)) -> RecordShape
  record-definition :: String -> List Decl -> Option RecordShape
  record-definition name ds = case ds of
    Nil -> None
    Cons (DRecord sp actual params fields) rest -> if same name actual then Some (RecordShape actual (record-labels fields) None) else record-definition name rest
    Cons (DCodata sp actual params fields) rest -> if same name actual then Some (RecordShape actual (record-labels fields) (Some fields)) else record-definition name rest
    Cons (DExternal sp actual category syntax metadata) rest ->
      if same actual name && same category "type" then
        (case (field "kind" metadata, field "ctors" metadata) of
          (JStr variety, JArr constructor JArrEnd) ->
            if same variety "codata" then
              (case imported-observation-fields (field "fields" metadata) constructor of
                Some fields -> Some (RecordShape actual (record-labels fields) (Some fields))
                None -> record-definition name rest)
            else if same variety "record" && runtime-constructors-complete name (field "ctors" metadata)
              && (case field "symbol" constructor of JStr symbol -> same name (interface-global symbol); other -> False) then
              Some (RecordShape actual (record-context-names (field "fields" metadata)) None)
            else record-definition name rest
          other -> record-definition name rest)
      else record-definition name rest
    Cons other rest -> record-definition name rest
  imported-observation-fields :: Json -> Json -> Option (List (String, TypeExpr))
  imported-observation-fields labels row = case resolved-text row of
    Some text -> (case parse-scheme "codata observations" (string-to-bytes text) of
      Parsed syntax Nil -> observation-domains labels syntax
      other -> None)
    None -> None
  observation-domains :: Json -> TypeExpr -> Option (List (String, TypeExpr))
  observation-domains labels syntax = case (labels, syntax) of
    (other, TForall sp parameters body) -> observation-domains labels body
    (JArr (JStr name) rest, TFun sp observation result) ->
      (case observation-domains rest result of Some more -> Some (Cons (name, observation) more); None -> None)
    (JArrEnd, other) -> Some Nil
    other -> None
  has-observations :: Option (List (String, TypeExpr)) -> Bool
  has-observations observations = case observations of Some fields -> True; None -> False
  codata-name :: String -> List Decl -> Bool
  codata-name name ds = case record-definition name ds of Some (RecordShape owner fields observations) -> has-observations observations; None -> False
  unwrap-corec :: Decl -> Decl
  unwrap-corec declaration = case declaration of DCorec sp body -> body; other -> declaration
  unwrap-corec-declarations :: List Decl -> List Decl
  unwrap-corec-declarations ds = case ds of Nil -> Nil; Cons declaration rest -> Cons (unwrap-corec declaration) (unwrap-corec-declarations rest)
  codata-present :: List Decl -> Bool
  codata-present ds = case ds of
    Nil -> False
    Cons (DCodata sp owner params fields) rest -> True
    Cons (DCorec sp body) rest -> True
    Cons (DExternal sp name category syntax metadata) rest ->
      (same category "type" && (case field "kind" metadata of JStr kind -> same kind "codata"; other -> False)) || codata-present rest
    Cons other rest -> codata-present rest
  corec-marked :: String -> List Decl -> Bool
  corec-marked name ds = case ds of
    Nil -> False
    Cons (DCorec sp body) rest -> (case decl-name body of Some marked -> same marked name; None -> False) || corec-marked name rest
    Cons other rest -> corec-marked name rest
  codata-return :: TypeExpr -> Bool -> (Option String, Bool)
  codata-return syntax diverges = case syntax of
    TForall sp params body -> codata-return body diverges
    TUsing sp constraints body -> codata-return body diverges
    TUsageArrow sp usage arrow -> codata-return arrow diverges
    TFun sp input body -> codata-return body False
    TFunEff sp input row body -> codata-return body (case row of TRow at labels tail -> has "Diverge" (type-names labels); other -> False)
    TName sp name -> (Some name, diverges)
    TApp sp head arguments -> codata-return head diverges
    other -> (None, diverges)
  declared-codata-return :: String -> List Decl -> (Option String, Bool)
  declared-codata-return name ds = case ds of
    Nil -> (None, False)
    Cons declaration rest -> case unwrap-corec declaration of
      DSig sp symbol ty -> if same symbol name then codata-return ty False else declared-codata-return name rest
      other -> declared-codata-return name rest
  codata-call-graph :: List Decl -> List (String, List String)
  codata-call-graph ds = case ds of
    Nil -> Nil
    Cons declaration rest -> case unwrap-corec declaration of
      DFun sp name clauses -> Cons (name, declaration-references [declaration]) (codata-call-graph rest)
      other -> codata-call-graph rest
  codata-calls :: String -> List (String, List String) -> List String
  codata-calls name graph = case graph of
    Nil -> Nil
    Cons (symbol, refs) rest -> if same symbol name then refs <> codata-calls name rest else codata-calls name rest
  codata-reaches :: String -> List String -> List String -> List (String, List String) -> Bool
  codata-reaches destination pending seen graph = case pending of
    Nil -> False
    Cons name rest -> same name destination ||
      (if has name seen then codata-reaches destination rest seen graph
       else codata-reaches destination (codata-calls name graph <> rest) (Cons name seen) graph)
  codata-component :: String -> List (String, List String) -> List (String, List String) -> List String
  codata-component name graph candidates = case candidates of
    Nil -> Nil
    Cons (other, refs) rest -> let more = codata-component name graph rest in
      if codata-reaches name refs [other] graph && codata-reaches other (codata-calls name graph) [name] graph then Cons other more else more
  constructs-observations :: String -> Expr -> Bool
  constructs-observations owner expression = case expression of
    ERecord sp name fields -> same owner name
    EAnn sp body annotation -> constructs-observations owner body
    ELet sp bindings body -> constructs-observations owner body
    ELetScope sp body -> constructs-observations owner body
    ELocalGroup sp bindings body -> constructs-observations owner body
    ELetRec sp bindings body -> constructs-observations owner body
    EIf sp condition yes no -> constructs-observations owner yes && constructs-observations owner no
    ECase sp value (EAlt at pattern body rest) -> constructs-observations owner body && constructs-observation-alternatives owner rest
    EGuarded sp guard body -> constructs-observations owner body
    other -> False
  constructs-observation-alternatives :: String -> Expr -> Bool
  constructs-observation-alternatives owner alternatives = case alternatives of
    EAltsEnd sp -> True
    EAlt sp pattern body rest -> constructs-observations owner body && constructs-observation-alternatives owner rest
    other -> False
  data ObservationPosition where
    StrictObservationPosition :: ObservationPosition
    ObservationBody :: ObservationPosition
    DeferredObservation :: ObservationPosition
    GuardedObservation :: ObservationPosition
  data GuardFlow where
    NoGuardFlow :: GuardFlow
    CodataResultFlow :: String -> GuardFlow
    LaterResultFlow :: GuardFlow
  is-later-flow :: GuardFlow -> Bool
  is-later-flow flow = case flow of LaterResultFlow -> True; other -> False
  is-codata-flow :: String -> GuardFlow -> Bool
  is-codata-flow name flow = case flow of CodataResultFlow owner -> same name owner; other -> False
  recursive-call-allowed :: Bool -> Bool -> ObservationPosition -> Bool
  recursive-call-allowed productive diverges position = case position of
    GuardedObservation -> True
    DeferredObservation -> not productive
    ObservationBody -> False
    StrictObservationPosition -> not productive && diverges
  first-recursive-reference :: List String -> List String -> Option String
  first-recursive-reference group refs = case refs of
    Nil -> None
    Cons name rest -> if has name group then Some name else first-recursive-reference group rest
  later-observation :: String -> List (String, TypeExpr) -> Bool
  later-observation label fields = case fields of
    Nil -> False
    Cons (name, ty) rest -> if same name label then
      (case ty of TApp sp (TName at head) (TArg arg carrier (TArgsEnd end)) -> same head "Later"; other -> False)
      else later-observation label rest
  -- Only the result path of an observation can supply its Later guard.
  -- Scrutinees, strict bindings, and arguments of arbitrary calls evaluate
  -- before the guard is returned.
  guarded-recursive-reference :: List Decl -> List String -> Bool -> Bool -> ObservationPosition -> GuardFlow -> Expr -> Option (Span, String)
  guarded-recursive-reference declarations group productive diverges position flow expression =
    let nested = guarded-recursive-reference declarations group productive diverges position in
    let eager = nested NoGuardFlow in
    case expression of
      ERecord sp name values -> (case position of
        GuardedObservation -> None
        other -> (case record-definition name declarations of
          Some (RecordShape owner labels (Some fields)) -> guarded-observation-fields declarations group productive diverges (is-codata-flow owner flow) fields values
          other -> eager values))
      ERecordField sp name value rest -> first-guard-error (eager value) (eager rest)
      EApp sp (EVar at name) (ELam site patterns body) | same name "b.delay" -> (case position of
        GuardedObservation -> None
        other -> guarded-recursive-reference declarations group productive diverges
          (if is-later-flow flow then GuardedObservation else DeferredObservation) NoGuardFlow body)
      EApp sp first second -> first-guard-error (eager first) (eager second)
      EAnn sp body annotation -> nested flow body
      EIf sp condition yes no -> first-guard-error (eager condition) (first-guard-error (nested flow yes) (nested flow no))
      ECase sp value alternatives -> first-guard-error (eager value) (nested flow alternatives)
      EAlt sp pattern body rest -> first-guard-error (nested flow body) (nested flow rest)
      ELet sp bindings body -> first-guard-error (eager bindings) (nested flow body)
      ELetScope sp body -> nested flow body
      ELocalGroup sp bindings body -> first-guard-error (eager bindings) (nested flow body)
      ELetRec sp bindings body -> first-guard-error (eager bindings) (nested flow body)
      ELocalSignature sp name ty rest -> eager rest
      ELocalStrict sp pattern value rest -> first-guard-error (eager value) (eager rest)
      ELocalMemo sp name value rest -> first-guard-error (eager value) (eager rest)
      EBinding sp name rhs rest -> first-guard-error (eager rhs) (eager rest)
      EGuarded sp condition body -> first-guard-error (eager condition) (nested flow body)
      EArg sp first rest -> first-guard-error (eager first) (eager rest)
      ECon sp name arguments -> eager arguments
      EProject sp body label -> eager body
      ETuple sp fields -> eager fields
      EList sp fields -> eager fields
      EBin sp operation left right -> first-guard-error (eager left) (eager right)
      ENeg sp value -> eager value
      ELam sp patterns body -> eager body
      EForall sp names body -> nested flow body
      EUsing sp bounds body -> nested flow body
      EBind sp name rhs -> eager rhs
      EDo sp statements -> eager statements
      EWith sp bindings body -> first-guard-error (eager bindings) (nested flow body)
      EHandle sp body handler-value -> first-guard-error (eager body) (eager handler-value)
      EHandler sp label clauses -> eager clauses
      EHandlerClause sp name patterns continuation body rest -> first-guard-error (eager body) (eager rest)
      EQuote sp body -> nested flow body
      ESplice sp body -> eager body
      -- The call's own name is not a value reference, so it is no
      -- recursive reference either. Reaching here means expansion did not
      -- run, and the elaborator refuses the call by name; the walker must
      -- not invent a guard verdict for it.
      EMacroCall sp path tokens -> None
      other -> if recursive-call-allowed productive diverges position then None else case first-recursive-reference group (expr-references expression) of
        Some name -> Some (expr-span expression, name)
        None -> None
  first-guard-error :: Option (Span, String) -> Option (Span, String) -> Option (Span, String)
  first-guard-error first second = case first of Some error -> first; None -> second
  guarded-observation-fields :: List Decl -> List String -> Bool -> Bool -> Bool -> List (String, TypeExpr) -> Expr -> Option (Span, String)
  guarded-observation-fields declarations group productive diverges result fields values = case values of
    ERecordField sp label value rest -> first-guard-error
      (guarded-recursive-reference declarations group productive diverges ObservationBody
        (if result && later-observation label fields then LaterResultFlow else NoGuardFlow) value)
      (guarded-observation-fields declarations group productive diverges result fields rest)
    other -> None
  checked-codata-clauses :: List Decl -> List String -> Bool -> Bool -> String -> List (List Pat, Expr) -> Store -> Store
  checked-codata-clauses declarations group productive diverges owner clauses st = case clauses of
    Nil -> st
    Cons (patterns, body) rest -> let checked = (case guarded-recursive-reference declarations group productive diverges StrictObservationPosition (CodataResultFlow owner) body of
        Some (sp, name) -> add-error sp ("unguarded recursive call to `" <> diagnostic-member-name name <>
          (if productive then "`: a corec definition must use delay in a Later observation"
           else "`: declare Diverge to reflect the loss of productivity or delay the recursive observation")) st
        None -> if productive && not (constructs-observations owner body) then
          add-error (expr-span body) "a corec body must build its codata type at every step" st else st) in
      checked-codata-clauses declarations group productive diverges owner rest checked
  check-codata-bodies :: List Decl -> List (String, List String) -> List Decl -> Store -> Store
  check-codata-bodies declarations graph pending st = case pending of
    Nil -> st
    Cons declaration rest -> let checked = (case unwrap-corec declaration of
        DFun sp name clauses -> let productive = corec-marked name declarations in
          (case declared-codata-return name declarations of
            (Some owner, diverges) -> if codata-name owner declarations then
              checked-codata-clauses declarations (codata-component name graph graph) productive diverges owner clauses st
              else if productive then add-error sp "a corec definition must return codata" st else st
            (None, diverges) -> if productive then add-error sp "a corec definition needs a codata result signature" st else st)
        other -> st) in
      check-codata-bodies declarations graph rest checked
  record-storage-name :: Bool -> String -> String
  record-storage-name observed owner = if observed then "#codata:" <> owner else owner
  observation-storage-fields :: Span -> List (String, TypeExpr) -> List (String, TypeExpr)
  observation-storage-fields sp fields = case fields of
    Nil -> Nil
    Cons (name, ty) rest -> Cons (name, TFun sp (TName sp "Unit") ty) (observation-storage-fields sp rest)
  record-definitions-present :: List Decl -> Bool
  record-definitions-present ds = case ds of
    Nil -> False
    Cons (DRecord sp name params fields) rest -> True
    Cons (DCodata sp name params fields) rest -> True
    Cons (DExternal sp name category syntax metadata) rest ->
      (same category "type" && (case field "kind" metadata of JStr kind -> same kind "record" || same kind "codata"; other -> False)) || record-definitions-present rest
    Cons other rest -> record-definitions-present rest
  record-result :: Span -> String -> List TypeParam -> TypeExpr
  record-result sp name params = case params of
    Nil -> TName sp name
    other -> TApp sp (TName sp name) (type-arg-spine sp (record-parameter-types params))
  record-parameter-types :: List TypeParam -> List TypeExpr
  record-parameter-types params = case params of Nil -> Nil; Cons param rest -> Cons (TName (param-span param) (param-name param)) (record-parameter-types rest)
  record-constructor :: Span -> List (String, TypeExpr) -> TypeExpr -> TypeExpr
  record-constructor sp fields result = case fields of Nil -> result; Cons (name, ty) rest -> TFun sp ty (record-constructor sp rest result)
  has-record-evidence :: List (String, TypeExpr) -> Bool
  has-record-evidence fields = case fields of
    Nil -> False
    Cons (name, TEvidenceField sp label ty) rest -> True
    Cons first rest -> has-record-evidence rest
  dependent-record-constructor :: Span -> List (String, TypeExpr) -> TypeExpr -> TypeExpr
  dependent-record-constructor sp fields result = case fields of
    Nil -> result
    Cons (name, ty) rest ->
      let at = type-expr-span ty in
      TFun at (TBound at name ty (TBoundsEnd at)) (dependent-record-constructor sp rest result)
  record-declarations :: List Decl -> List Decl -> List Decl
  record-declarations all ds = case ds of
    Nil -> Nil
    Cons declaration rest -> let more = record-declarations all rest in
      case declaration of
        DRecord sp name params fields ->
          let result = record-result sp name params in
          let signature-type = if has-record-evidence fields then dependent-record-constructor sp fields result else record-constructor sp fields result in
          Cons (DData sp name params [(name, signature-type)]) (Cons declaration more)
        DCodata sp name params fields ->
          Cons (DData sp name params [(record-storage-name True name, record-constructor sp (observation-storage-fields sp fields) (record-result sp name params))])
            (Cons declaration more)
        DFun sp name clauses -> Cons (DFun sp name (record-clauses all clauses)) more
        DInstance sp flag name params head members -> Cons (DInstance sp flag name params head (decl-spine sp (record-declarations all (decls-of members)))) more
        other -> Cons declaration more
  record-clauses :: List Decl -> List (List Pat, Expr) -> List (List Pat, Expr)
  record-clauses all clauses = case clauses of
    Nil -> Nil
    Cons (patterns, body) rest -> Cons (record-patterns all patterns, record-expression all body) (record-clauses all rest)
  record-patterns :: List Decl -> List Pat -> List Pat
  record-patterns all patterns = case patterns of Nil -> Nil; Cons first rest -> Cons (record-pattern all first) (record-patterns all rest)
  record-pattern-fields :: Pat -> Option (List (String, Pat))
  record-pattern-fields fields = case fields of
    PArgsEnd sp -> Some Nil
    PRecordField sp name value rest -> (case record-pattern-fields rest of Some more -> Some (Cons (name, value) more); None -> None)
    other -> None
  record-expression-fields :: Expr -> Option (List (String, Expr))
  record-expression-fields fields = case fields of
    EArgsEnd sp -> Some Nil
    ERecordField sp name value rest -> (case record-expression-fields rest of Some more -> Some (Cons (name, value) more); None -> None)
    other -> None
  record-field-error :: List String -> List String -> List String -> Option String
  record-field-error allowed labels seen = case labels of
    Nil -> missing-record-field allowed seen
    Cons name rest ->
      if not (has name allowed) then Some (string-concat "unknown record field: " name)
      else if has name seen then Some (string-concat "duplicate record field: " name)
      else record-field-error allowed rest (Cons name seen)
  missing-record-field :: List String -> List String -> Option String
  missing-record-field allowed seen = case allowed of
    Nil -> None
    Cons name rest -> if has name seen then missing-record-field rest seen else Some (string-concat "missing field: " name)
  record-pattern-labels :: List (String, Pat) -> List String
  record-pattern-labels fields = case fields of Nil -> Nil; Cons (name, value) rest -> Cons name (record-pattern-labels rest)
  record-expression-labels :: List (String, Expr) -> List String
  record-expression-labels fields = case fields of Nil -> Nil; Cons (name, value) rest -> Cons name (record-expression-labels rest)
  record-field-pattern :: Span -> String -> List (String, Pat) -> Pat
  record-field-pattern sp label fields = case fields of
    Nil -> PUnmodeled sp "missing record pattern field"
    Cons (name, value) rest -> if same name label then value else record-field-pattern sp label rest
  record-ordered-patterns :: List Decl -> Span -> List String -> List (String, Pat) -> List Pat
  record-ordered-patterns all sp declared fields = case declared of
    Nil -> Nil
    Cons name rest -> Cons (record-pattern all (record-field-pattern sp name fields)) (record-ordered-patterns all sp rest fields)
  record-pattern :: List Decl -> Pat -> Pat
  record-pattern all pattern = case pattern of
    PRecord sp name fields -> (case (record-definition name all, record-pattern-fields fields) of
      (Some (RecordShape owner declared (Some observations)), Some values) -> pattern
      (Some (RecordShape owner declared None), Some values) -> (case record-field-error declared (record-pattern-labels values) Nil of
        Some message -> PUnmodeled sp message
        None -> PCon sp name (pat-spine sp (record-ordered-patterns all sp declared values)))
      other -> PUnmodeled sp "record pattern has no defining field contract")
    PCon sp name fields -> PCon sp name (record-pattern all fields)
    PTuple sp fields -> PTuple sp (record-pattern all fields)
    PList sp fields -> PList sp (record-pattern all fields)
    PAs sp name inner -> PAs sp name (record-pattern all inner)
    PAnn sp inner ty -> PAnn sp (record-pattern all inner) ty
    PArg sp first rest -> PArg sp (record-pattern all first) (record-pattern all rest)
    other -> pattern
  record-local-name :: String -> String
  record-local-name label = "#record-field:" <> label
  record-value-expressions :: List Decl -> Span -> List (String, Expr) -> Expr
  record-value-expressions all sp fields = case fields of
    Nil -> EArgsEnd sp
    Cons (name, value) rest -> ERecordField (expr-span value) name (record-expression all value) (record-value-expressions all sp rest)
  record-value-arguments :: Span -> List (String, UType) -> List (String, Expr) -> List Expr
  record-value-arguments sp fields written = case fields of
    Nil -> Nil
    Cons (name, ty) rest ->
      let argument = (if record-proposition-type ty then record-written-argument sp name written
        else EVar sp (record-local-name name)) in
      Cons argument (record-value-arguments sp rest written)
  record-written-argument :: Span -> String -> List (String, Expr) -> Expr
  record-written-argument sp wanted written = case written of
    Nil -> EUnmodeled sp "missing record evidence field"
    Cons (name, value) rest -> if same name wanted then value else record-written-argument sp wanted rest
  record-expression :: List Decl -> Expr -> Expr
  record-expression all expression = case expression of
    ERecord sp name fields -> (case record-expression-fields fields of
      Some values -> ERecord sp name (record-value-expressions all sp values)
      None -> expression)
    EProject sp value name -> EProject sp (record-expression all value) name
    ECon sp name args -> ECon sp name (record-expression all args)
    EApp sp f x -> EApp sp (record-expression all f) (record-expression all x)
    EBin sp op a b -> EBin sp op (record-expression all a) (record-expression all b)
    ENeg sp x -> ENeg sp (record-expression all x)
    ELam sp patterns body -> ELam sp (record-patterns all patterns) (record-expression all body)
    ELet sp bindings body -> ELet sp (record-expression all bindings) (record-expression all body)
    ELetScope sp body -> ELetScope sp (record-expression all body)
    ELocalGroup sp bindings body -> ELocalGroup sp (record-expression all bindings) (record-expression all body)
    ELetRec sp bindings body -> ELetRec sp (record-expression all bindings) (record-expression all body)
    ELocalStrict sp pattern value rest -> ELocalStrict sp (record-pattern all pattern) (record-expression all value) (record-expression all rest)
    ELocalMemo sp name value rest -> ELocalMemo sp name (record-expression all value) (record-expression all rest)
    ELocalSignature sp name ty rest -> ELocalSignature sp name ty (record-expression all rest)
    EIf sp c a b -> EIf sp (record-expression all c) (record-expression all a) (record-expression all b)
    ECase sp value alternatives -> ECase sp (record-expression all value) (record-expression all alternatives)
    EGuarded sp guard body -> EGuarded sp (record-expression all guard) (record-expression all body)
    EAnn sp value ty -> EAnn sp (record-expression all value) ty
    EForall sp names body -> EForall sp names (record-expression all body)
    EUsing sp bounds body -> EUsing sp bounds (record-expression all body)
    EBind sp name value -> EBind sp name (record-expression all value)
    EDo sp statements -> EDo sp (record-expression all statements)
    EWith sp bindings body -> EWith sp (record-expression all bindings) (record-expression all body)
    EHandle sp body handled-by -> EHandle sp (record-expression all body) (record-expression all handled-by)
    EHandler sp label clauses -> EHandler sp label (record-expression all clauses)
    EHandlerClause sp name patterns continuation body rest -> EHandlerClause sp name (record-patterns all patterns) continuation (record-expression all body) (record-expression all rest)
    ETuple sp fields -> ETuple sp (record-expression all fields)
    EList sp fields -> EList sp (record-expression all fields)
    EArg sp first rest -> EArg sp (record-expression all first) (record-expression all rest)
    EBinding sp name value rest -> EBinding sp name (record-expression all value) (record-expression all rest)
    EAlt sp pattern body rest -> EAlt sp (record-pattern all pattern) (record-expression all body) (record-expression all rest)
    other -> expression
  record-typed-fields :: List String -> List UType -> Option (List (String, UType))
  record-typed-fields fields types = case (fields, types) of
    (Nil, Nil) -> Some Nil
    (Cons name rest, Cons ty more) -> (case record-typed-fields rest more of Some tail -> Some (Cons (name, ty) tail); None -> None)
    other -> None
  -- Check each initializer in written order against its instantiated field
  -- type. Bind the checked value once, before declaration-order assembly.
  record-initializers :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> List (String, UType) -> List (String, Expr) -> Store -> (List CheckedBinding, List (Nat, String, Scheme, CoreTerm), Store)
  record-initializers classes kinds families env locals declared fields st = case fields of
    Nil -> (env, Nil, st)
    Cons (label, expression) rest -> (case lookup-local label declared of
      None -> (env, Nil, add-error (expr-span expression) "record initializer has no declared field type" st)
      Some expected | record-proposition-type expected -> record-initializers classes kinds families env locals declared rest st
      Some expected -> (case check classes kinds families env locals expression expected st of
        (value, checked) -> (case fresh-id checked of
          (id, ready) -> let name = record-local-name label in let sc = mono expected in
            (case let-binding (expr-span expression) env name sc id (store-level ready) value ready of
              (binding, prepared) ->
                let bound = proof-let-env env binding id sc value prepared in
                (case record-initializers classes kinds families bound locals declared rest prepared of
                  (finished, more, done) -> (finished, Cons (id, name, sc, value) more, done))))))
  record-initializer-lets :: Span -> List (Nat, String, Scheme, CoreTerm) -> CoreTerm -> CoreTerm
  record-initializer-lets sp fields result = case fields of
    Nil -> result
    Cons (id, name, sc, value) rest -> let body = record-initializer-lets sp rest result in
      CLet sp (core-type body) id name sc value body
  delayed-observations :: List (String, Expr) -> List (String, Expr)
  delayed-observations fields = case fields of
    Nil -> Nil
    Cons (label, value) rest -> let sp = expr-span value in
      Cons (label, ELam sp [PWild sp] value) (delayed-observations rest)
  infer-record-construction :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> String -> Expr -> Option UType -> Store -> (CoreTerm, Store)
  infer-record-construction classes kinds families env locals sp name fields wanted st = case (record-definition name (context-aliases kinds), record-expression-fields fields) of
    (Some (RecordShape owner declared observations), Some values) -> (case record-field-error declared (record-expression-labels values) Nil of
      Some message -> term-error sp message st
      None -> (case lookup-expression-value sp kinds (record-storage-name (has-observations observations) owner) env st of
        (constructor, opened) -> let ready = case wanted of None -> opened; Some expected -> unify sp (result-type (core-type constructor)) expected opened in
          (case record-typed-fields declared (domains (core-type constructor)) of
            Some types -> let initializers = if has-observations observations then delayed-observations values else values in
              (case record-initializers classes kinds families env locals types initializers ready of
                (bound, bindings, prepared) -> (case apply-spine classes kinds families bound locals constructor (record-value-arguments sp types initializers) prepared of
                  (result, done) -> (record-initializer-lets sp bindings result, done)))
            None -> term-error sp "record constructor fields disagree with the checked declaration" ready)))
    other -> term-error sp "record construction has no defining field contract" st
  record-projection-pattern :: Span -> String -> List String -> List Pat
  record-projection-pattern sp label fields = case fields of
    Nil -> Nil
    Cons name rest -> Cons (if same name label then PVar sp (record-local-name label) else PWild sp) (record-projection-pattern sp label rest)
  record-context-names :: Json -> List String
  record-context-names names = case names of JArr (JStr name) rest -> Cons name (record-context-names rest); other -> Nil
  record-scope-contains :: Span -> Span -> Bool
  record-scope-contains outer inner = case (outer, inner) of
    (Span start finish line column, Span position end row col) -> start <= position && position < finish
  record-scope-at :: Span -> List Decl -> List String
  record-scope-at sp declarations = case declarations of
    Nil -> Nil
    Cons (DSource at name metadata) rest -> if record-scope-contains at sp then record-context-names (field "record_scope" metadata) else record-scope-at sp rest
    Cons other rest -> record-scope-at sp rest
  record-field-candidates :: String -> List String -> List Decl -> List String
  record-field-candidates label visible declarations = case visible of
    Nil -> Nil
    Cons name rest -> (case record-definition name declarations of
      Some (RecordShape owner fields observations) -> if has label fields then Cons owner (record-field-candidates label rest declarations) else record-field-candidates label rest declarations
      other -> record-field-candidates label rest declarations)
  -- Match Native: a known receiver chooses its declaring record. An
  -- unknown receiver may use exactly one visible declaring record, never
  -- a private/unselected global or a guess among repeated field names.
  hint-record-receiver :: Span -> String -> UType -> TypeContext -> List CheckedBinding -> Store -> Store
  hint-record-receiver sp label receiver kinds env st = case normalize st receiver of
    UMeta id KType -> (case record-field-candidates label (record-scope-at sp (context-aliases kinds)) (context-aliases kinds) of
      Cons owner Nil -> (case lookup-expression-value sp kinds (record-storage-name (codata-name owner (context-aliases kinds)) owner) env st of
        (constructor, checked) -> unify sp receiver (result-type (core-type constructor)) checked)
      Nil -> add-error sp ("unknown record field " <> label) st
      other -> add-error sp ("ambiguous record field " <> label <> ": annotate the operand") st)
    other -> st
  infer-record-projection :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Span -> Expr -> String -> Store -> (CoreTerm, Store)
  infer-record-projection classes kinds families env locals sp value label st = case infer classes kinds families env locals value st of
    (scrutinee, inferred) -> let checked = hint-record-receiver sp label (core-type scrutinee) kinds env inferred in
      (case root-name (normalize checked (core-type scrutinee)) of
      Some owner -> (case record-definition owner (context-aliases kinds) of
        Some (RecordShape name fields observations) -> if has label fields then
          (case bind-pattern classes kinds families env locals (PCon sp (record-storage-name (has-observations observations) owner) (pat-spine sp (record-projection-pattern sp label fields))) (core-type scrutinee) checked of
            (bound, pattern, prepared) -> (case lookup-expression-value sp kinds (record-local-name label) bound prepared of
              (selected, done) -> (case (has-observations observations, thunk-function-parts (normalize done (core-type selected))) of
                (True, Some (row, result)) ->
                  let observed = CApply sp result selected (CUnit sp (primitive-type "Unit")) in
                  (CCase sp result scrutinee (CAlternative sp pattern observed (CAlternativesEnd sp)), done)
                (True, None) -> term-error sp "codata observation needs its checked closure" done
                (False, parts) -> (CCase sp (core-type selected) scrutinee (CAlternative sp pattern selected (CAlternativesEnd sp)), done))))
          else term-error sp ("unknown record field " <> label) checked
        other -> term-error sp "field projection needs the checked defining record contract" checked)
      None -> term-error sp "field projection needs a known record type" checked)
  -- Certify eligible definitions using an independent checked preliminary
  -- elaboration. Only after its actual Core reconstructs a total graph can
  -- the full elaboration use that graph in a type-level observation. The
  -- final global kernel checks the graph against the full actual bodies again.
  -- Candidate selection uses the checked carrier, so an imported/private
  -- refinement alias is handled by its defining contract, not its spelling.
  -- Selection grants no authority: actual preliminary Core, the closed graph
  -- and final independent body/context association still have to agree.
  -- The declared contracts are already parsed, and each one's identity is
  -- the hash its own load derived: the set is admitted from the pair, so
  -- elaboration neither re-encodes nor re-parses an interface.
  total-interface-inputs :: List Decl -> List (String, String, Json)
  total-interface-inputs declarations = case declarations of
    Nil -> Nil
    Cons (DInterface sp name hash metadata) rest -> Cons (name, hash, metadata) (total-interface-inputs rest)
    Cons other rest -> total-interface-inputs rest
  total-imported-methods :: InterfaceSet -> String -> CoreClass -> Scheme -> List CoreClassMethod -> TypeContext -> Store -> (TypeContext, Store)
  total-imported-methods interfaces dictionary description factory members kinds st = case members of
    Nil -> (kinds, st)
    Cons member rest -> case specialize-method description factory member of
      Some sc -> (case check-imported-method-binding interfaces dictionary (class-method-slot member) sc of
        Some binding -> (case context-add-total zero binding kinds st of (more, checked) -> total-imported-methods interfaces dictionary description factory rest more checked)
        None -> total-imported-methods interfaces dictionary description factory rest kinds st)
      None -> total-imported-methods interfaces dictionary description factory rest kinds st
  has-imported-method-body :: InterfaceSet -> Json -> Bool
  has-imported-method-body interfaces methods = case methods of
    JArr (JStr native) rest -> interface-set-has-body native interfaces || has-imported-method-body interfaces rest
    other -> False
  total-imported-instances :: InterfaceSet -> List Json -> List (String, Kind) -> Json -> TypeContext -> Store -> (TypeContext, Store)
  total-imported-instances interfaces descriptions classes instances kinds st = case instances of
    JArr row rest -> if not (has-imported-method-body interfaces (field "methods" row)) then
      total-imported-instances interfaces descriptions classes rest kinds st
      else let (factory, checked) = imported-scheme zero classes kinds (TUnmodeled zero "missing total method factory") row (empty-store "closed imported method") in
      (case (store-errors checked, scheme-params factory, scheme-requirements factory, field "id" row, root-name (scheme-body factory)) of
        (Nil, Nil, Nil, JStr native, Some owner) -> (case typed-class zero owner descriptions classes kinds checked of
          (Some description, complete) -> (case store-errors complete of
            Nil -> (case total-imported-methods interfaces (interface-global native) description factory (class-methods description) kinds st of
              (more, done) -> total-imported-instances interfaces descriptions classes rest more done)
            other -> total-imported-instances interfaces descriptions classes rest kinds st)
          other -> total-imported-instances interfaces descriptions classes rest kinds st)
        other -> total-imported-instances interfaces descriptions classes rest kinds st)
    other -> (kinds, st)
  total-imported-declarations :: InterfaceSet -> List Json -> List (String, Kind) -> List Decl -> TypeContext -> Store -> (TypeContext, Store)
  total-imported-declarations interfaces descriptions classes declarations kinds st = case declarations of
    Nil -> (kinds, st)
    Cons (DInterface sp name hash metadata) rest -> (case total-imported-instances interfaces descriptions classes (field "instances" (field "exports" metadata)) kinds st of
      (more, done) -> total-imported-declarations interfaces descriptions classes rest more done)
    Cons (DExternal sp name category syntax metadata) rest -> if not (same category "value") then total-imported-declarations interfaces descriptions classes rest kinds st else
      (case field "symbol" metadata of
        JStr native -> (case interface-set-body native interfaces of
          Some function -> (case imported-scheme sp classes kinds (case syntax of Some declared -> declared; None -> TUnmodeled sp "missing public dependency declaration") metadata (empty-store "actual imported dependency body") of
            (sc, checked) -> (case store-errors checked of
              Nil -> (case check-body-binding name native "external" sc function of
                Some binding -> (case context-add-total sp binding kinds st of
                  (more, done) -> total-imported-declarations interfaces descriptions classes rest more done)
                None -> total-imported-declarations interfaces descriptions classes rest kinds st)
              other -> total-imported-declarations interfaces descriptions classes rest kinds st))
          None -> total-imported-declarations interfaces descriptions classes rest kinds st)
        other -> total-imported-declarations interfaces descriptions classes rest kinds st)
    Cons other rest -> total-imported-declarations interfaces descriptions classes rest kinds st
  collect-imported-total-methods :: Result String InterfaceSet -> List Decl -> List Json -> List (String, Kind) -> TypeContext -> Store -> (TypeContext, Store)
  collect-imported-total-methods checked declarations descriptions classes kinds st = case checked of
    Ok interfaces -> total-imported-declarations interfaces descriptions classes declarations kinds st
    Err error -> (kinds, st)
  source-total-atom :: UType -> Bool
  source-total-atom ty = case ty of UCon name KType -> has name ["Nat", "Int", "Bool", "Bytes", "I64"]; other -> False
  source-total-type :: UType -> Bool
  source-total-type ty = case ty of
    UFun domain result -> source-total-atom domain && source-total-type result
    UFunEff domain (URow UEnd) result -> source-total-atom domain && source-total-type result
    URefine id name (UCon carrier KType) predicate -> has carrier ["Nat", "Int", "I64"]
    other -> source-total-atom ty
  source-projection-domain :: UType -> Option String
  source-projection-domain ty = case ty of
    UFun (UCon domain KType) (UCon result KType) -> if same result "Bytes" && not (primitive domain) then Some domain else None
    other -> None
  source-total-candidate :: List (String, Kind) -> TypeContext -> List Decl -> TypeExpr -> Bool
  source-total-candidate classes kinds declarations syntax = case make-scheme False classes kinds Nil syntax (empty-store "source total candidate") of
    (sc, checked) -> case (store-errors checked, scheme-params sc, scheme-requirements sc) of
      (Nil, Nil, Nil) -> source-total-type (scheme-body sc) || (case source-projection-domain (scheme-body sc) of
        Some name -> (case source-total-find-data name declarations of Some decl -> True; None -> False)
        None -> False)
      other -> False
  source-total-names :: List (String, Kind) -> TypeContext -> List Decl -> List Decl -> List String
  source-total-names classes kinds all declarations = case declarations of
    Nil -> Nil
    Cons (DSig sp name syntax) rest -> if source-total-candidate classes kinds all syntax then Cons name (source-total-names classes kinds all rest) else source-total-names classes kinds all rest
    Cons other rest -> source-total-names classes kinds all rest
  source-total-select :: List String -> List String -> List String -> List Decl -> List Decl
  source-total-select names aliases datas declarations = case declarations of
    Nil -> Nil
    Cons declaration rest -> let more = source-total-select names aliases datas rest in
      case declaration of
        DSig sp name syntax -> if has name names then Cons declaration more else more
        DFun sp name clauses -> if has name names then Cons declaration more else more
        DExternal sp name category syntax metadata -> Cons declaration more
        DInterface sp name hash metadata -> Cons declaration more
        DSource sp name metadata -> Cons declaration more
        DProof sp body -> Cons declaration more
        DRefine sp name parameters binder predicate -> if has name aliases then Cons declaration more else more
        DData sp name parameters constructors -> if has name datas then Cons declaration more else more
        DForeign sp direction abi symbol name syntax -> (case intrinsic-contract symbol of Some specification -> Cons declaration more; None -> more)
        other -> more
  source-total-selected-references :: List String -> List Decl -> List String
  source-total-selected-references names declarations = case declarations of
    Nil -> Nil
    Cons declaration rest -> let more = source-total-selected-references names rest in
      case declaration of
        DSig sp name syntax -> if has name names then declaration-references [declaration] <> more else more
        DFun sp name clauses -> if has name names then declaration-references [declaration] <> more else more
        other -> more
  source-total-find-alias :: String -> List Decl -> Option Decl
  source-total-find-alias name declarations = case declarations of
    Nil -> None
    Cons declaration rest -> case declaration of
      DRefine sp symbol parameters binder predicate -> if same symbol name then Some declaration else source-total-find-alias name rest
      other -> source-total-find-alias name rest
  source-total-find-data :: String -> List Decl -> Option Decl
  source-total-find-data name declarations = case declarations of
    Nil -> None
    Cons declaration rest -> case declaration of
      DData sp symbol Nil constructors -> if same symbol name then Some declaration else source-total-find-data name rest
      other -> source-total-find-data name rest
  source-total-data-closure :: List Decl -> List String -> List String -> (List String, List String)
  source-total-data-closure declarations pending seen = case pending of
    Nil -> (seen, Nil)
    Cons name rest -> if has name seen then source-total-data-closure declarations rest seen else
      (case source-total-find-data name declarations of
        Some declaration -> let refs = declaration-references [declaration] in
          let (datas, more) = source-total-data-closure declarations (refs <> rest) (Cons name seen) in
          (datas, refs <> more)
        None -> source-total-data-closure declarations rest seen)
  source-total-data-roots :: List String -> List Decl -> List String
  source-total-data-roots names declarations = case declarations of
    Nil -> Nil
    Cons (DSig sp name (TFun arrow (TName at domain) (TName end result))) rest ->
      if same result "Bytes" && has name names then Cons domain (source-total-data-roots names rest)
      else source-total-data-roots names rest
    Cons other rest -> source-total-data-roots names rest
  source-total-parameter-references :: List TypeParam -> List String
  source-total-parameter-references parameters = case parameters of
    Nil -> Nil
    Cons parameter rest -> (case param-kind parameter of Some syntax -> declaration-references [DSig zero "#kind" syntax]; None -> Nil) <> source-total-parameter-references rest
  source-total-alias-references :: Decl -> List String
  source-total-alias-references declaration = case declaration of
    DRefine sp name parameters binder predicate -> source-total-parameter-references (Cons binder parameters) <> declaration-references [DSig sp "#predicate" predicate]
    other -> Nil
  source-total-alias-closure :: List Decl -> List String -> List String -> List String
  source-total-alias-closure declarations pending seen = case pending of
    Nil -> seen
    Cons name rest -> if has name seen then source-total-alias-closure declarations rest seen else
      case source-total-find-alias name declarations of
        Some declaration -> source-total-alias-closure declarations (source-total-alias-references declaration <> rest) (Cons name seen)
        None -> source-total-alias-closure declarations rest seen
  source-total-refs :: String -> List Decl -> List String
  source-total-refs name declarations = case declarations of
    Nil -> Nil
    Cons (DFun sp symbol clauses) rest -> if same name symbol then declaration-references [DFun sp symbol clauses] <> source-total-refs name rest else source-total-refs name rest
    Cons other rest -> source-total-refs name rest
  source-total-relevant :: List String -> List String -> List String
  source-total-relevant names references = case references of Nil -> Nil; Cons first rest -> if has first names then Cons first (source-total-relevant names rest) else source-total-relevant names rest
  source-total-closure :: List String -> List Decl -> List String -> List String -> List String
  source-total-closure names declarations pending seen = case pending of
    Nil -> seen
    Cons first rest -> if has first seen then source-total-closure names declarations rest seen else
      source-total-closure names declarations (source-total-relevant names (source-total-refs first declarations) <> rest) (Cons first seen)
  -- One module elaboration over just the declarations these names need.
  --
  -- The retry below runs this once per name that genuinely failed, so the
  -- selection is a function of the name's own closure and never of the
  -- module: an attempt cannot see, and so cannot re-pay for, a declaration
  -- another name already resolved.
  source-total-preliminary :: Result String InterfaceSet -> String -> Module -> List String -> Elaboration
  source-total-preliminary interfaces label m names = let declarations = module-decls m in
    let refs = source-total-selected-references names declarations in
    let (datas, data-refs) = source-total-data-closure declarations (source-total-data-roots names declarations) Nil in
    let aliases = source-total-alias-closure declarations (refs <> data-refs) Nil in
    -- Source selection keeps the same complete DInterface set.
    elaborate-module-with-source-bodies interfaces False (label <> " total bodies")
      (MkModule (module-span m) (module-name m) (decl-spine (module-span m) (source-total-select names aliases datas declarations)))
  -- The elaboration's own lists, whatever its diagnostics say.
  --
  -- A module elaboration that reports an error still registers a total body
  -- for every declaration that checked before the failure: check-body-loop
  -- returns the definitions it accumulated and the store carries the
  -- bindings. The error-gated accessors above answer Nil instead, which is
  -- the right rule for a caller that may only act on a fully accepted
  -- elaboration, and the wrong one for this pass, which is reading exactly
  -- the results an errored elaboration did produce.
  elaboration-source-bindings :: Elaboration -> List CheckedBinding
  elaboration-source-bindings e = case e of MkElaboration errors bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> bindings
  elaboration-source-core :: Elaboration -> List CoreDefinition
  elaboration-source-core e = case e of MkElaboration errors bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> core
  elaboration-source-data :: Elaboration -> List CoreData
  elaboration-source-data e = case e of MkElaboration errors bindings contexts core datas effects descriptions instances declarations observations rewrites temporal -> datas
  -- The elaboration's readable surface: its bodies keyed by defining
  -- identity, built once per pass.
  --
  -- core-source-body answers one name by scanning the definition list and
  -- walking the reference graph behind the hit, so asking it per name pays
  -- the scan again for every name. The scan is what a pass over N names
  -- cannot afford; the three lists are read off the elaboration once and
  -- threaded through the per-name read instead.
  data SourceTotalSurface where
    MkSourceTotalSurface :: List BodyBinding -> List CoreDefinition -> List CoreData -> SourceTotalSurface
  source-total-surface :: Elaboration -> SourceTotalSurface
  source-total-surface checked = MkSourceTotalSurface (env-body-bindings (elaboration-source-bindings checked)) (elaboration-source-core checked) (elaboration-source-data checked)
  -- One name's total body, read off a surface this pass already built.
  source-total-checked-body :: String -> SourceTotalSurface -> Option BodyBinding
  source-total-checked-body name surface = case surface of
    MkSourceTotalSurface bodies definitions datas -> (case export-global name of
      Ok native -> core-source-body bodies definitions datas native
      Err error -> None)
  -- Every name's body from one surface, in name order, asked for once.
  --
  -- The unresolved set and the emitted list are both read off this table, so
  -- neither re-derives a body the other already has.
  source-total-entries :: List String -> SourceTotalSurface -> List (String, Option BodyBinding)
  source-total-entries names surface = case names of
    Nil -> Nil
    Cons name rest -> Cons (name, source-total-checked-body name surface) (source-total-entries rest surface)
  source-total-missing :: List (String, Option BodyBinding) -> List String
  source-total-missing entries = case entries of
    Nil -> Nil
    Cons (name, found) rest -> (case found of Some binding -> source-total-missing rest; None -> Cons name (source-total-missing rest))
  -- The bodies the module elaboration did not produce, one elaboration each.
  --
  -- Flat on purpose: an attempt elaborates one name's closure and contributes
  -- at most that name's body, so the pass cannot nest, and the number of
  -- elaborations is the number of names that genuinely failed rather than a
  -- function of the module's size. The attempt keeps its result only when it
  -- reports no error, which is the rule this pass has always applied to a
  -- re-elaboration.
  source-total-retry :: Result String InterfaceSet -> String -> Module -> List String -> List String -> List (String, Option BodyBinding)
  source-total-retry interfaces label m all names = case names of
    Nil -> Nil
    Cons name rest -> let more = source-total-retry interfaces label m all rest in
      let needed = source-total-closure all (module-decls m) [name] Nil in
      let attempt = source-total-preliminary interfaces label m needed in
      Cons (name, source-total-retry-body name attempt) more
  source-total-retry-body :: String -> Elaboration -> Option BodyBinding
  source-total-retry-body name attempt = case elaboration-errors attempt of
    Nil -> source-total-checked-body name (source-total-surface attempt)
    other -> None
  -- A clean elaboration's bodies, in name order.
  source-total-from-checked :: List String -> SourceTotalSurface -> List BodyBinding
  source-total-from-checked names surface = case names of
    Nil -> Nil
    Cons name rest -> let more = source-total-from-checked rest surface in
      (case source-total-checked-body name surface of Some binding -> Cons binding more; None -> more)
  -- The entries in name order, a retried body standing in for the name it
  -- answered for. The retried table is keyed by the same names, in the same
  -- order, so this is one step per name and not a search.
  source-total-emit :: List (String, Option BodyBinding) -> List (String, Option BodyBinding) -> List BodyBinding
  source-total-emit entries retried = case entries of
    Nil -> Nil
    Cons (name, found) rest -> case found of
      Some binding -> Cons binding (source-total-emit rest retried)
      None -> case retried of
        Cons (_, replacement) more -> (case replacement of Some binding -> Cons binding (source-total-emit rest more); None -> source-total-emit rest more)
        Nil -> source-total-emit rest Nil
  -- The module elaboration's bodies in name order, with a name's own
  -- elaboration standing in only for the names the module elaboration did
  -- not produce.
  source-total-resolved :: Result String InterfaceSet -> String -> Module -> List String -> List (String, Option BodyBinding) -> List BodyBinding
  source-total-resolved interfaces label m all entries =
    source-total-emit entries (source-total-retry interfaces label m all (source-total-missing entries))
  -- A module elaboration that reports no error needs no retry at all: every
  -- name it resolved is emitted and every name it did not is dropped, which
  -- is what this pass has always done with a clean elaboration. The retry
  -- exists only for the errored case, where the elaboration stopped early
  -- and left names unresolved that a narrower elaboration can still settle,
  -- so the table that decides who is unresolved is built on that path alone.
  source-total-bodies :: Result String InterfaceSet -> String -> Module -> List (String, Kind) -> TypeContext -> List BodyBinding
  source-total-bodies interfaces label m classes kinds = let declarations = module-decls m in
    let names = source-total-names classes kinds declarations declarations in
    case names of
      Nil -> Nil
      other -> let preliminary = source-total-preliminary interfaces label m names in
        (case elaboration-errors preliminary of
          Nil -> source-total-from-checked names (source-total-surface preliminary)
          other -> let entries = source-total-entries names (source-total-surface preliminary) in
            source-total-resolved interfaces label m names entries)
  add-source-bodies :: List BodyBinding -> TypeContext -> Store -> (TypeContext, Store)
  add-source-bodies bindings kinds st = case bindings of
    Nil -> (kinds, st)
    Cons first rest -> case context-add-total zero first kinds st of (more, checked) -> add-source-bodies rest more checked
  elaborate-modules :: String -> List Module -> Elaboration
  elaborate-modules label ms = case ms of
    Nil -> MkElaboration Nil Nil Nil Nil Nil Nil (MkCoreClassContext Nil Nil) Nil Nil Nil Nil Nil
    Cons m rest -> case (elaborate-module label m, elaborate-modules label rest) of
      (MkElaboration errors bindings ctx core datas effects descriptions instances declarations observations rewrites temporal, MkElaboration more others scopes other-core other-data other-effects other-classes other-instances other-declarations other-observations other-rewrites other-temporal) -> MkElaboration (errors <> more) (bindings <> others) (ctx <> scopes) (core <> other-core) (datas <> other-data) (effects <> other-effects) (merge-class-contexts descriptions other-classes) (instances <> other-instances) (declarations <> other-declarations) (observations <> other-observations) (rewrites <> other-rewrites) (temporal <> other-temporal)
  elaborate-program :: String -> Program -> Elaboration
  elaborate-program label p = elaborate-modules label (program-modules p)
  infer-program :: String -> Program -> List Diagnostic
  infer-program label p = elaboration-errors (elaborate-program label p)

  predicate-syntax :: TypeExpr -> Bool
  predicate-syntax syntax = case syntax of
    TInfix s op a b -> has op ["<", "<=", "==", "/=", ">=", ">", "&&", "||"]
    TName s name -> same name "True" || same name "False"
    TApp s (TName at name) (TArg first a (TArg second b (TArgsEnd end))) -> same name "Eq"
    TApp sp (TName at name) (TArg arg input (TArgsEnd end)) -> has name ["NonZero", "NotNull", "Ascii", "Ordered"]
    other -> False
  predicate-carrier :: List (String, UType) -> TypeExpr -> Option UType
  predicate-carrier locals syntax = case syntax of
    TName s name -> case lookup-local name locals of Some ty -> value-carrier (type-kind ty); None -> None
    TInfix s op a b -> merge-predicate-carriers (predicate-carrier locals a) (predicate-carrier locals b)
    TNegate s a -> predicate-carrier locals a
    other -> None
  predicate-base-carrier :: UType -> UType
  predicate-base-carrier carrier = case refinement-view carrier of URefine id name base predicate -> predicate-base-carrier base; other -> carrier
  predicate-math-carrier :: UType -> Bool
  predicate-math-carrier carrier = case predicate-base-carrier carrier of
    UCon name KType -> has name ["Nat", "Int", "I8", "I16", "I32", "I64", "U8", "U16", "U32", "U64"]
    other -> False
  merge-predicate-carriers :: Option UType -> Option UType -> Option UType
  merge-predicate-carriers first second = case (first, second) of
    (Some a, Some b) -> if predicate-math-carrier a && predicate-math-carrier b then
      Some (if same-type (predicate-base-carrier a) (primitive-type "Nat") && same-type (predicate-base-carrier b) (primitive-type "Nat") then primitive-type "Nat" else primitive-type "Int")
      else Some (if predicate-math-carrier a then b else a)
    (Some a, None) -> Some a
    other -> second
  predicate-comparison-carrier :: List (String, UType) -> TypeExpr -> TypeExpr -> UType
  predicate-comparison-carrier locals first second = case merge-predicate-carriers (predicate-carrier locals first) (predicate-carrier locals second) of
    Some carrier -> if predicate-math-carrier carrier then
      (if same-type (predicate-base-carrier carrier) (primitive-type "Nat") then primitive-type "Nat" else primitive-type "Int") else carrier
    None -> primitive-type "Int"
  predicate-arithmetic-input :: TypeContext -> List (String, UType) -> TypeExpr -> Bool
  predicate-arithmetic-input kinds locals syntax = case syntax of
    TApp sp (TName at name) arguments -> byte-length-binding name kinds || (case context-total-observation name kinds of
      Some binding -> has (total-result (binding-function binding)) ["Nat", "Int"]
      None -> False)
    -- A local fixed-width value can be read as mathematical Int in a type
    -- expression. This does not make its runtime operators proof terms.
    TName sp name -> case lookup-local name locals of Some value -> (case value-carrier (type-kind value) of Some carrier -> predicate-math-carrier carrier; None -> False); None -> False
    TInfix sp op left right -> predicate-arithmetic-input kinds locals left && predicate-arithmetic-input kinds locals right
    TNegate sp body -> predicate-arithmetic-input kinds locals body
    TIndex sp text -> True
    other -> False
  same-type :: UType -> UType -> Bool
  same-type first second = case store-errors (unify (Span 0 0 1 1) first second (empty-store "predicate sort")) of Nil -> True; other -> False
  predicate-index-value :: Span -> UType -> UType -> Store -> (UType, Store)
  predicate-index-value sp carrier value st = case value-carrier (type-kind (normalize st value)) of
    Some actual -> (case refinement-view actual of
      URefine id name base predicate -> predicate-index-value sp carrier (UIndexForget value) st
      other -> let checked = unify sp actual (normalize st carrier) st in
        if list-length (store-errors checked) == list-length (store-errors st) then checked-typed-source-index sp value checked
        else if same-type carrier (primitive-type "Int") && predicate-math-carrier actual then checked-typed-source-index sp (UIndexPromote value) st
        else bad sp (string-concat "proof predicate has incompatible carriers; expected " (type-text (normalize st carrier))) st)
    None -> bad sp "a type cannot be used as a predicate value" st
  convert-predicate-index :: Bool -> TypeContext -> List (String, UType) -> UType -> TypeExpr -> Store -> (UType, Store)
  convert-predicate-index external kinds locals carrier syntax st = case syntax of
    TApp sp (TName at name) arguments -> (case (byte-length-binding name kinds, arguments) of
      (True, TArg arg input (TArgsEnd end)) -> (case convert-byte-length external kinds locals sp name input st of
        (value, checked) -> predicate-index-value sp carrier value checked)
      other -> (case convert-total-call external kinds locals sp name arguments st of
        (value, checked) -> predicate-index-value sp carrier value checked))
    TName sp name -> case lookup-local name locals of
      Some value -> predicate-index-value sp carrier value st
      None -> bad sp "source index has no checked local binding" st
    TInfix sp op first second -> if not (predicate-arithmetic-input kinds locals syntax) then bad sp "machine arithmetic cannot enter mathematical index conversion" st
      else if has op ["+", "-", "*"] then
        (case convert-predicate-index external kinds locals carrier first st of
          (a, sa) -> case convert-predicate-index external kinds locals carrier second sa of
            (b, sb) -> checked-typed-source-index sp (UIndexMath op a b) sb)
      else bad sp "index operator needs checked mathematical semantics" st
    TNegate sp input -> if not (predicate-arithmetic-input kinds locals syntax) then bad sp "machine arithmetic cannot enter mathematical index conversion" st
      else case convert-predicate-index external kinds locals carrier input st of
        (value, checked) -> checked-typed-source-index sp (UIndexMath "-" (UIndex carrier (IInteger 0)) value) checked
    other -> convert-index external kinds locals carrier syntax st
  abstract-predicate-carrier :: UType -> Bool
  abstract-predicate-carrier carrier = case carrier of
    UBound id name kind -> kind-equal kind KType
    URigid id name level kind -> kind-equal kind KType
    UMeta id kind -> kind-equal kind KType
    other -> False
  convert-not-null :: Span -> List (String, UType) -> TypeExpr -> Store -> (UType, Store)
  convert-not-null sp locals syntax st = case syntax of
    TName at name -> (case lookup-local name locals of
      Some value -> (case value-carrier (type-kind value) of
        Some (UApp (UCon owner (KFun KType KType)) element) -> if same owner (global-data-core-list) then
          (UPropNotNull value, st)
          else bad sp "NotNull needs the checked Data.Core.List carrier" st
        other -> bad sp "NotNull needs the checked Data.Core.List carrier" st)
      None -> bad sp "NotNull needs a checked local list value" st)
    other -> bad sp "NotNull needs a checked local list value" st
  -- A structural predicate over a checked local: the value's carrier is
  -- already known, so the former is built at that carrier and `valid-type`
  -- decides whether the carrier is one the predicate decides (the seed's
  -- PredFn carrier rules: `Ascii` for text and char lists, `Ordered` for
  -- numeric lists). A wrong carrier is refused naming the predicate.
  convert-structural :: Span -> List (String, UType) -> TypeExpr -> String -> (UType -> UType) -> Store -> (UType, Store)
  convert-structural sp locals syntax label former st = case syntax of
    TName at name -> (case lookup-local name locals of
      Some value -> let predicate = former value in
        if valid-type predicate then (predicate, st)
        else bad sp (string-concat-all ["`", label, "` decides text values (`String`), lists of chars and lists of numerics, not `", display-type-text value, "` (a wrong predicate for this refinement's container is refused naming the predicate)"]) st
      None -> bad sp (string-concat-all ["`", label, "` needs a checked local value"]) st)
    other -> bad sp (string-concat-all ["`", label, "` needs a checked local value"]) st

  convert-predicate :: Bool -> TypeContext -> List (String, UType) -> TypeExpr -> Store -> (UType, Store)
  convert-predicate external kinds locals syntax st = case syntax of
    TName s name -> if same name "True" || same name "False" then (UPropLit (same name "True"), st) else
      (case lookup-local name locals of Some predicate -> if kind-equal (type-kind predicate) KProp && valid-type predicate then (predicate, st) else bad s "predicate variable must have kind Prop" st; None -> bad s "unsupported proof predicate" st)
    TApp sp (TName at name) (TArg first a (TArg second b (TArgsEnd end))) | same name "Eq" ->
      convert-predicate external kinds locals (TInfix sp "Eq" a b) st
    TApp sp (TName at name) (TArg arg input (TArgsEnd end)) ->
      if same name "Not" then (case convert-predicate external kinds locals input st of (predicate, checked) -> (UPropNot predicate, checked))
      else if same name "NotNull" then convert-not-null sp locals input st
      else if same name "Ascii" then convert-structural sp locals input "Ascii" UPropAscii st
      else if same name "Ordered" then convert-structural sp locals input "Ordered" UPropOrdered st
      else if not (same name "NonZero") then bad sp "unsupported proof predicate former" st
      else let carrier = predicate-comparison-carrier locals input input in
        if math-carrier carrier then (case convert-predicate-index external kinds locals carrier input st of
          (value, checked) -> let predicate = UPropNonZero value in
            (predicate, if valid-type predicate then checked else add-error sp "ill-sorted structural NonZero predicate" checked))
        else if abstract-predicate-carrier carrier then
          (case convert-predicate-index external kinds locals carrier input st of
            (value, checked) -> let predicate = UPropNonZeroPending value in
              (predicate, if valid-type predicate then checked else add-error sp "ill-sorted abstract NonZero predicate" checked))
        else bad sp (string-concat-all ["`NonZero` decides numeric values (`Nat`, `Int`, machine integers), not `", display-type-text carrier, "` (a wrong predicate for this refinement's container is refused naming the predicate)"]) st
    TInfix s op a b -> if same op "&&" || same op "||" then
      (case convert-predicate external kinds locals a st of
        (left, sa) -> case convert-predicate external kinds locals b sa of
          (right, sb) -> (if same op "&&" then UPropAnd left right else UPropOr left right, sb))
      -- `Eq x y` is propositional equality over any checked carrier, not a
      -- numeric comparison: the seed gives it its own arm and never asks for
      -- a mathematical carrier, so `Eq value value` at `Bool`, `Nat` or an
      -- indexed family is a well-formed goal. The `<`/`<=`/`>`/`>=`/`==`/
      -- `/=` forms below do compare numbers and keep that requirement.
      else if same op "Eq" then
        (case merge-predicate-carriers (predicate-carrier locals a) (predicate-carrier locals b) of
          Some carrier -> (case convert-predicate-index external kinds locals carrier a st of
            (left, sa) -> case convert-predicate-index external kinds locals carrier b sa of
              (right, sb) -> let out = UCompare "Eq" left right in (out, if valid-type out then sb else add-error s "ill-sorted proof predicate" sb))
          None -> (case convert-predicate-index external kinds locals (primitive-type "Int") a st of
            (left, sa) -> case convert-predicate-index external kinds locals (primitive-type "Int") b sa of
              (right, sb) -> let out = UCompare "Eq" left right in (out, if valid-type out then sb else add-error s "ill-sorted proof predicate" sb)))
      else if has op ["<", "<=", "==", "/=", ">=", ">"] then
        (let carrier = predicate-comparison-carrier locals a b in
         if math-carrier carrier then (case convert-predicate-index external kinds locals carrier a st of
           (left, sa) -> case convert-predicate-index external kinds locals carrier b sa of
             (right, sb) -> let out = UCompare op left right in (out, if valid-type out then sb else add-error s "ill-sorted proof predicate" sb))
         else bad s "proof predicate needs checked mathematical carriers" st)
      else bad s "unsupported proof predicate operator" st
    other -> bad (type-expr-span syntax) "proof predicate needs checked arithmetic" st
  convert-proof-bounds :: Bool -> TypeContext -> List (String, UType) -> TypeExpr -> Store -> (UType, Store)
  convert-proof-bounds external kinds locals bounds st = case bounds of
    TBoundsEnd s -> (UEnd, st)
    TBound s name app rest -> if predicate-syntax app then
      (if not (same name "") then bad s "named proof terms need erased proof binding elaboration" st
       else case convert-predicate external kinds locals app st of
         (p, sp) -> case convert-proof-bounds external kinds locals rest sp of (ps, done) -> (UArg p ps, done))
      else convert-proof-bounds external kinds locals rest st
    other -> bad (type-expr-span bounds) "malformed proof context" st
  -- Sink a context under its computational binders. Predicates refer to
  -- those exact Pi IDs, not fresh globals with the same printed names.
  convert-contracted :: Bool -> TypeContext -> List (String, UType) -> TypeExpr -> TypeExpr -> Store -> (UType, Store)
  convert-contracted external kinds locals bounds syntax st = case syntax of
    TFun s domain result -> convert-contracted-arrow external kinds locals bounds s domain None result st
    TFunEff s domain row result -> convert-contracted-arrow external kinds locals bounds s domain (Some row) result st
    TUsageArrow s usage arrow -> check-usage-arrow s usage (convert-contracted external kinds locals bounds arrow st)
    other -> case convert external kinds locals syntax st of
      (body, sb) -> case convert-proof-bounds external kinds locals bounds sb of
        (UEnd, done) -> (body, done)
        (predicates, done) -> let out = URequire predicates body in (out, if valid-type out then done else add-error (type-expr-span syntax) "ill-formed function proof contract" done)
  -- Class/proof contexts retain erased domains just like ordinary
  -- source arrows. A proof binder supplies no computational index local.
  convert-contracted-proof-arrow :: Bool -> TypeContext -> List (String, UType) -> TypeExpr -> Span -> UType -> Option TypeExpr -> TypeExpr -> Store -> (UType, Store)
  convert-contracted-proof-arrow external kinds locals bounds sp predicate row result st =
    case (case row of None -> (URow UEnd, st); Some effects -> convert-row kinds locals effects st) of
      (effects, sr) -> case convert-contracted external kinds locals bounds result sr of
        (body, done) -> let ty = UProofFun predicate effects body in
          (ty, if valid-type ty then done else add-error sp "ill-formed contracted erased arrow" done)
  convert-contracted-arrow :: Bool -> TypeContext -> List (String, UType) -> TypeExpr -> Span -> TypeExpr -> Option TypeExpr -> TypeExpr -> Store -> (UType, Store)
  convert-contracted-arrow external kinds locals bounds sp argument row result st = case argument of
    TBound s name carrier (TBoundsEnd end) -> case convert-domain external kinds locals carrier st of
      (domain, checked) -> if kind-equal (type-kind domain) KProp then convert-contracted-proof-arrow external kinds locals bounds sp domain row result checked else
        (case fresh-for-types (Cons domain (local-types locals)) (expect-type s domain checked) of
          (id, fresh) -> let bound = Cons (name, UBound id name (value-kind domain)) locals in
            case (case row of None -> (URow UEnd, fresh); Some effects -> convert-row kinds bound effects fresh) of
              (effects, sr) -> case convert-contracted external kinds bound bounds result sr of
                (body, done) -> (UPi id name domain effects body, done))
    other -> case convert-domain external kinds locals argument st of
      (domain, checked) -> if kind-equal (type-kind domain) KProp then convert-contracted-proof-arrow external kinds locals bounds sp domain row result checked else
        (case (case row of None -> (URow UEnd, checked); Some effects -> convert-row kinds locals effects checked) of
          (effects, sr) -> case convert-contracted external kinds locals bounds result sr of
            (body, done) -> (function-type domain effects body, done))
  introduce-facts :: List Proposition -> List CheckedBinding -> List CheckedBinding
  introduce-facts facts env = case facts of Nil -> env; Cons p rest -> Cons (MkProofBinding zero None p) (introduce-facts rest env)
  check-required :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (String, UType) -> Expr -> UType -> Store -> (CoreTerm, Store)
  check-required classes kinds families env locals body expected st = case normalize st expected of
    URequire predicates result -> case scoped-core-predicates (proof-context env st) predicates of
      Some facts -> case check-required classes kinds families (introduce-facts facts env) locals body result st of
        (term, checked) -> (CRequire (expr-span body) expected term, checked)
      None -> term-error (expr-span body) "function precondition has no checked argument scope" st
    other -> check-alt-body classes kinds families env locals body expected st
  discharge-call :: List (String, Kind) -> Span -> List CheckedBinding -> CoreTerm -> Store -> (CoreTerm, Store)
  discharge-call classes sp env input before = case resolve-ready-term classes (env-instances env) (env-givens env) input before of
    (term, st) -> discharge-checked-call sp env term st
  discharge-checked-call :: Span -> List CheckedBinding -> CoreTerm -> Store -> (CoreTerm, Store)
  discharge-checked-call sp env term st = let ty = normalize st (core-type term) in
    case ty of
      URequire predicates result -> case store-errors st of
        Nil -> let evaluated = proof-env-after-writes env (call-operand-writes (map-term-types (normalize st) term)) st in
          let gamma = proof-context evaluated st in
          (case scoped-prove-predicates gamma (proof-facts evaluated) ty of
            Some evidence -> (CDischarge sp (required-body ty) evidence term, st)
            None -> case stale-proof-message evaluated st (\prior ->
              case scoped-prove-predicates gamma prior ty of Some evidence -> True; None -> False) of
                Some message -> term-error sp message st
                None -> let message = "function precondition is not established at this call" in
                  (case first-unproved-predicate gamma (proof-facts evaluated) ty of
                    None -> term-error sp message st
                    Some predicate -> if disproved-predicate gamma predicate then
                      term-error sp (string-concat-all [message, " because the obligation `", obligation-text predicate, "` of this call is false: its arguments are known here and do not satisfy it"]) st
                      else let missing = missing-obligation message predicate in
                      (case wrong-named-evidence evaluated evaluated predicate st of
                        Some detail -> term-error sp (missing <> ". " <> detail) st
                        None -> term-error sp missing st)))
        other -> (term, st)
      other -> (term, st)
  -- The first stated predicate of a required spine, outermost first, that
  -- the facts in scope do not prove on its own.
  first-unproved-predicate :: ProofScope -> List Proposition -> UType -> Option UType
  first-unproved-predicate gamma facts ty = case ty of
    URequire predicates body -> case unproved-in-spine gamma facts predicates of
      Some predicate -> Some predicate
      None -> first-unproved-predicate gamma facts body
    other -> None
  unproved-in-spine :: ProofScope -> List Proposition -> UType -> Option UType
  unproved-in-spine gamma facts predicates = case predicates of
    UArg predicate rest -> case scoped-prove-predicates gamma facts (URequire (UArg predicate UEnd) UEnd) of
      Some evidence -> unproved-in-spine gamma facts rest
      None -> Some predicate
    other -> None
  -- A closed predicate over numerals only whose negation is proved.
  disproved-predicate :: ProofScope -> UType -> Bool
  disproved-predicate gamma predicate = case scoped-core-predicates gamma (UArg predicate UEnd) of
    Some (Cons p Nil) -> disproved p
    other -> False

  apply-dependent :: List (String, Kind) -> Span -> List CheckedBinding -> CoreTerm -> CoreTerm -> Store -> (CoreTerm, Store)
  apply-dependent classes sp env fun value st = case reify-argument sp env value st of
    (index, checked) -> case store-errors checked of
      Nil -> case open-pi sp (core-type fun) index checked of
        (out, row, done) -> discharge-call classes sp env (applied-core sp out row fun value) done
      other -> case value of
        -- A certified partial operation is a checked runtime value. Bind it
        -- once, retaining the operation certificate and its equality fact;
        -- do not smuggle symbolic Nat subtraction into type conversion.
        CProved source ty evidence body -> materialize-dependent classes sp env fun value st
        CRefine source ty evidence body -> materialize-dependent classes sp env fun value st
        CRefineProof source ty witness body -> materialize-dependent classes sp env fun value st
        CErasedApply source ty row callee witness -> materialize-dependent classes sp env fun value st
        CDischarge source ty evidence body -> materialize-dependent classes sp env fun value st
        -- The carrier projection retains a checked runtime result, even
        -- when that result has no executable symbolic body contract. Keep
        -- its original refinement on the strict binding, then project only
        -- the actual local passed to the dependent function.
        CForget source carrier body -> if comparison-refinement (normalize st (core-type body)) then
          materialize-dependent-view classes sp env fun body (Some carrier) st
          else (CError sp, checked)
        -- An ordinary checked computation can supply a runtime witness
        -- without becoming a symbolic definition. Retain its strict let
        -- scope and only accept the application if all remaining checks
        -- succeed. On failure keep the original reification diagnostic.
        other -> case materialize-dependent classes sp env fun value st of
          (call, trial) -> if list-length (store-errors trial) == list-length (store-errors st) then (call, trial)
            else (CError sp, checked)
  materialize-dependent :: List (String, Kind) -> Span -> List CheckedBinding -> CoreTerm -> CoreTerm -> Store -> (CoreTerm, Store)
  materialize-dependent classes sp env fun value st = materialize-dependent-view classes sp env fun value None st
  materialize-dependent-view :: List (String, Kind) -> Span -> List CheckedBinding -> CoreTerm -> CoreTerm -> Option UType -> Store -> (CoreTerm, Store)
  materialize-dependent-view classes sp env fun value projection st = case fresh-id st of
    (function-id, sf) -> case fresh-id sf of
      (value-id, sv) ->
        let function-scheme = mono (core-type fun) in
        let value-scheme = mono (core-type value) in
        let level = store-level sv in
        let function-name = "#dependent-function" in
        let value-name = "#dependent-argument" in
        let functions = Cons (MkLocalBinding function-name function-scheme function-id level) env in
        let binding = MkLocalBinding value-name value-scheme value-id level in
        let bound = proof-let-env functions binding value-id value-scheme value sv in
        let local = CLocal sp (core-type value) value-id value-name Nil in
        let actual = case projection of None -> local; Some carrier -> CForget sp carrier local in
        let callee = CLocal sp (core-type fun) function-id function-name Nil in
        case reify-argument sp bound actual sv of
          (index, si) -> case open-pi sp (core-type fun) index si of
            (out, row, so) -> case discharge-call classes sp bound (applied-core sp out row callee actual) so of
              (call, done) -> let result = core-type call in
                (CLet sp result function-id function-name function-scheme fun (CLet sp result value-id value-name value-scheme value call), done)

  collect-contract-nominals :: Span -> Json -> TypeContext -> Store -> (TypeContext, Store)
  collect-contract-nominals sp row kinds st = case resolved-text row of
    None -> (kinds, st)
    Some text -> if resolved-entry-valid row then collect-nominal-rows sp (resolved-nominals row) kinds st
      else (kinds, add-error sp "invalid resolved declaration nominal contract" st)
  collect-conditional-nominals :: Span -> Json -> TypeContext -> Store -> (TypeContext, Store)
  collect-conditional-nominals sp rows kinds st = case rows of
    JArr row rest -> let checked = field "checked" row in
      case collect-contract-nominals sp (field "head" checked) kinds st of
        (head, sh) -> case collect-contract-nominals sp (field "implementation" checked) head sh of
          (actual, sa) -> collect-conditional-nominals sp rest actual sa
    JArrEnd -> (kinds, st)
    other -> (kinds, st)
  collect-instance-nominals :: Span -> Json -> TypeContext -> Store -> (TypeContext, Store)
  collect-instance-nominals sp rows kinds st = case rows of
    JArr row rest -> case collect-contract-nominals sp row kinds st of
      (ordinary, checked) -> case collect-conditional-nominals sp (field "method_contracts" row) ordinary checked of
        (all, done) -> collect-instance-nominals sp rest all done
    JArrEnd -> (kinds, st)
    other -> (kinds, add-error sp "invalid instance contract array" st)
  env-instances :: List CheckedBinding -> List (String, Scheme)
  env-instances env = case env of
    Nil -> Nil
    Cons (MkCheckedBinding name sc role) rest -> if same role "implicit-instance" then Cons (name, sc) (env-instances rest) else env-instances rest
    Cons (MkBodyContext context names cache) rest -> cached-instances cache
    Cons other rest -> env-instances rest
  register-instance-rows :: List (String, Kind) -> TypeContext -> Span -> Json -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-instance-rows classes kinds sp rows env st = case rows of
    JArr row rest -> case (field "implicit" row, resolved-text row, field "id" row) of
      (JBool True, Some text, JStr identity) -> case imported-scheme sp classes kinds (TUnmodeled sp "missing resolved instance") row st of
        (sc, checked) -> if checked-class-type classes (scheme-body sc) then
          (let name = interface-global identity in case lookup-binding name env of
            None -> register-instance-rows classes kinds sp rest (Cons (MkCheckedBinding name sc "implicit-instance") env) checked
            Some prior -> register-instance-rows classes kinds sp rest env (add-error sp "duplicate implicit instance identity" checked))
          else register-instance-rows classes kinds sp rest env (add-error sp "implicit instance needs a saturated checked signature target" checked)
      other -> register-instance-rows classes kinds sp rest env st
    JArrEnd -> (env, st)
    other -> (env, add-error sp "invalid instance contract array" st)
  register-implicit-instances :: List (String, Kind) -> TypeContext -> List Decl -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-implicit-instances classes kinds ds env st = case ds of
    Nil -> (env, st)
    Cons (DInterface sp name hash metadata) rest -> case register-instance-rows classes kinds sp (field "instances" (field "exports" metadata)) env st of
      (more, checked) -> register-implicit-instances classes kinds rest more checked
    Cons other rest -> register-implicit-instances classes kinds rest env st


  -- A conditional instance supplies individual callable declarations. It is
  -- never added to env-instances: generic dictionaries remain unavailable.
  conditional-heads :: List CheckedBinding -> List String -> List (String, Scheme)
  conditional-heads env seen = case env of
    Nil -> Nil
    Cons (MkConditionalBinding name owner slot dictionary head sc guarded) rest -> let key = dictionary in
      if has key seen then conditional-heads rest seen else Cons (name, mono head) (conditional-heads rest (Cons key seen))
    Cons other rest -> conditional-heads rest seen
  conditional-member :: Nat -> List CoreClassMethod -> Option CoreClassMethod
  conditional-member slot methods = case methods of Nil -> None; Cons member rest -> if slot == class-method-slot member then Some member else conditional-member slot rest
  conditional-erasure :: UType -> UType
  conditional-erasure ty = case ty of
    URequire predicates result -> conditional-erasure result
    UFun domain result -> UFun domain (conditional-erasure result)
    UFunEff domain row result -> UFunEff domain row (conditional-erasure result)
    UUsageArrow usage arrow -> UUsageArrow usage (conditional-erasure arrow)
    UPi id name domain row result -> let output = conditional-erasure result in
      if contains-meta id (type-free-bound output) then UPi id name domain row output else function-type domain row output
    other -> ty
  conditional-precondition :: UType -> Bool
  conditional-precondition ty = case ty of
    URequire (UArg first rest) result -> True
    UFun domain result -> conditional-precondition result
    UFunEff domain row result -> conditional-precondition result
    UUsageArrow usage arrow -> conditional-precondition arrow
    UPi id name domain row result -> conditional-precondition result
    other -> False
  closed-conditional-scheme :: Scheme -> Bool
  closed-conditional-scheme sc = contract-scheme-closed sc && (case (scheme-params sc, scheme-requirements sc) of (Nil, Nil) -> True; other -> False)
  register-conditional-methods :: List Json -> List (String, Kind) -> TypeContext -> Span -> String -> Json -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-conditional-methods descriptions classes kinds sp dictionary methods env st = case methods of
    JArr row rest -> let checked = field "checked" row in
      case (field "slot" row, field "identity" (field "implementation" checked)) of
        (JNum number, JStr native) -> if number < 0 then (env, add-error sp "conditional method slot is negative" st) else
          let slot = nat-from-int number in let name = interface-global native in
          let (head, sh) = imported-scheme sp classes kinds (TUnmodeled sp "conditional head") (field "head" checked) st in
          -- The checked head carries the declaring class's canonical identity.
          let owner = case root-name (scheme-body head) of Some canonical -> canonical; None -> "" in
          let (actual, sa) = imported-scheme sp classes kinds (TUnmodeled sp "conditional implementation") (field "implementation" checked) sh in
          (case typed-class sp owner descriptions classes kinds sa of
            (Some description, sd) -> (case conditional-member slot (class-methods description) of
              Some member -> (case specialize-method description head member of
                Some expected -> if closed-conditional-scheme head && closed-conditional-scheme actual && closed-conditional-scheme expected
                  && (case root-name (scheme-body head) of Some actual-owner -> same owner actual-owner; None -> False)
                  && conditional-precondition (scheme-body actual)
                  && scheme-equivalent expected (mono (conditional-erasure (scheme-body actual))) then
                    (case lookup-binding name env of
                      None -> (case field "body" (field "implementation" checked) of
                        JNull -> register-conditional-methods descriptions classes kinds sp dictionary rest (Cons (MkConditionalBinding name owner slot dictionary (scheme-body head) actual None) env) sd
                        doc -> (case check-guarded-binding name native actual doc of
                          Some binding -> register-conditional-methods descriptions classes kinds sp dictionary rest (Cons (MkConditionalBinding name owner slot dictionary (scheme-body head) actual (Some binding)) env) sd
                          None -> (env, add-error sp "actual guarded body is not total under its callable preconditions" sd)))
                      Some prior -> (env, add-error sp "duplicate conditional implementation identity" sd))
                  else (env, add-error sp "conditional implementation disagrees with its actual class member" sd)
                None -> (env, add-error sp "conditional implementation has no checked class specialization" sd))
              None -> (env, add-error sp "conditional implementation has no actual defining method slot" sd))
            (None, failed) -> (env, failed))
        other -> (env, add-error sp "invalid checked conditional method declaration" st)
    JArrEnd -> (env, st)
    other -> (env, add-error sp "invalid conditional method array" st)
  register-conditional-rows :: List Json -> List (String, Kind) -> TypeContext -> Span -> Json -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-conditional-rows descriptions classes kinds sp rows env st = case rows of
    JArr row rest -> case (field "implicit" row, field "class" row, field "id" row) of
      (JBool True, JStr owner, JStr dictionary) -> (case register-conditional-methods descriptions classes kinds sp dictionary (field "method_contracts" row) env st of
        (more, done) -> register-conditional-rows descriptions classes kinds sp rest more done)
      other -> register-conditional-rows descriptions classes kinds sp rest env st
    JArrEnd -> (env, st)
    other -> (env, add-error sp "invalid conditional instance rows" st)
  register-conditional-instances :: List Json -> List (String, Kind) -> TypeContext -> List Decl -> List CheckedBinding -> Store -> (List CheckedBinding, Store)
  register-conditional-instances descriptions classes kinds ds env st = case ds of
    Nil -> (env, st)
    Cons (DInterface sp name hash metadata) rest -> (case register-conditional-rows descriptions classes kinds sp (field "instances" (field "exports" metadata)) env st of
      (more, done) -> register-conditional-instances descriptions classes kinds rest more done)
    Cons other rest -> register-conditional-instances descriptions classes kinds rest env st


  -- Ordinary lexical/implicit dictionaries are tried first. A conditional
  -- fallback redirects only a fully known defining class/slot to its checked
  -- private implementation. Its complete URequire type remains on the call.
  conditional-function :: Span -> String -> Nat -> UType -> UType -> List CheckedBinding -> Store -> (Option CoreTerm, Store)
  conditional-function sp owner slot wanted member env st = case env of
    Nil -> (None, st)
    Cons (MkConditionalBinding name actual-owner actual-slot dictionary head sc guarded) rest ->
      if same owner actual-owner && slot == actual-slot then
        let trial = unify sp wanted head st in
        if list-length (store-errors trial) == list-length (store-errors st)
          && scheme-equivalent (mono (normalize trial member)) (mono (conditional-erasure (scheme-body sc))) then
          (Some (CUse sp (scheme-body sc) name "external" Nil), trial)
        else conditional-function sp owner slot wanted member rest st
      else conditional-function sp owner slot wanted member rest st
    Cons other rest -> conditional-function sp owner slot wanted member rest st
  conditional-prefix :: List (String, Kind) -> Span -> List CheckedBinding -> CoreTerm -> Store -> (Option CoreTerm, Store)
  conditional-prefix classes sp env term st = case term of
    CMethod source ty name owner slot actuals evidence ->
      let (ordinary, trial) = resolve-ready-term classes (env-instances env) (env-givens env) term st in
      if list-length (store-errors trial) == list-length (store-errors st) then (Some ordinary, trial)
      else (case evidence of
        Cons (CENeeded at wanted candidates) rest -> if list-length (free-metas st wanted) == 0 then conditional-function sp owner slot (normalize st wanted) (normalize st ty) env st else (None, st)
        other -> (None, st))
    CApply source ty function argument -> (case conditional-prefix classes sp env function st of
      (Some callee, checked) -> (case apply-checked-runtime classes sp env callee argument checked of (out, done) -> (Some out, done))
      (None, checked) -> (None, checked))
    CApplyEff source ty row function argument -> (case conditional-prefix classes sp env function st of
      (Some callee, checked) -> (case apply-checked-runtime classes sp env callee argument checked of (out, done) -> (Some out, done))
      (None, checked) -> (None, checked))
    other -> (None, st)
  apply-runtime-argument :: List (String, Kind) -> Span -> List CheckedBinding -> CoreTerm -> CoreTerm -> Store -> (CoreTerm, Store)
  apply-runtime-argument classes sp env fun value st = case store-errors st of
    Nil -> (case conditional-prefix classes sp env fun st of
      (Some callee, checked) -> apply-scoped-argument classes sp env callee value checked
      (None, checked) -> apply-scoped-argument classes sp env fun value checked)
    other -> (CError sp, st)
  -- An argument can retain private witness lets in its result contract.
  -- Evaluate the function first, then open those existing strict scopes
  -- around the call. The actual result is checked while its witnesses
  -- remain in scope; no symbolic equation for an opaque call is invented.
  apply-scoped-argument :: List (String, Kind) -> Span -> List CheckedBinding -> CoreTerm -> CoreTerm -> Store -> (CoreTerm, Store)
  apply-scoped-argument classes sp env fun value st =
    if erased-value-arrow (normalize st (core-type fun)) then apply-checked-erased-value classes sp env fun value st
    else case value of
      CLet source ty id display sc rhs body -> case fresh-id st of
        (function-id, next) ->
          let name = "#argument-function" in
          let scheme = mono (core-type fun) in
          let binding = MkLocalBinding name scheme function-id (store-level next) in
          let bound = proof-let-env env binding function-id scheme fun next in
          case apply-argument-lets classes sp bound (CLocal sp (core-type fun) function-id name Nil) value next of
            (call, done) -> (CLet sp (core-type call) function-id name scheme fun call, done)
      other -> apply-checked-runtime classes sp env fun value st
  apply-argument-lets :: List (String, Kind) -> Span -> List CheckedBinding -> CoreTerm -> CoreTerm -> Store -> (CoreTerm, Store)
  apply-argument-lets classes sp env fun value st = case value of
    CLet source ty id display sc rhs body ->
      let hidden = string-concat "#argument-let:" (int-to-string (nat-to-int id)) in
      let binding = MkLocalBinding hidden sc id (store-level st) in
      let bound = proof-let-env env binding id sc rhs st in
      case apply-argument-lets classes sp bound fun body st of
        (call, done) -> (CLet source (core-type call) id display sc rhs call, done)
    other -> apply-checked-runtime classes sp env fun value st
  apply-checked-runtime :: List (String, Kind) -> Span -> List CheckedBinding -> CoreTerm -> CoreTerm -> Store -> (CoreTerm, Store)
  apply-checked-runtime classes sp env fun value st =
    let function = normalize st (core-type fun) in
    if erased-value-arrow function then apply-checked-erased-value classes sp env fun value st
    else case arrow-shape function of
      UPi id name domain effects result -> let checked = unify sp domain (core-type value) st in
        if pi-dependent (normalize checked (core-type fun)) then apply-dependent classes sp env fun value checked
        else discharge-call classes sp env (applied-core sp result effects fun value) checked
      other -> case arrow-parts sp (core-type fun) st of
        (domain, row, result, shaped) -> discharge-call classes sp env (applied-core sp result (normalize shaped row) fun value) (unify sp domain (core-type value) shaped)


  apply-checked-erased-value :: List (String, Kind) -> Span -> List CheckedBinding -> CoreTerm -> CoreTerm -> Store -> (CoreTerm, Store)
  apply-checked-erased-value classes sp env fun value st =
    let witness = map-term-types (normalize st) value in
    let function = normalize st (core-type fun) in
    if not (erasable-value-argument witness) then term-error sp "multiplicity %0: an erased argument cannot perform effects or writes" st
    else case arrow-shape function of
      UPi id name domain row result ->
        let matched = unify sp domain (core-type value) st in
        if not (pi-dependent function) then discharge-call classes sp env (CErasedApply sp result row fun value) matched
        else (case reify-argument sp env witness matched of
          (index, checked) -> case open-pi sp function index checked of
            (out, effects, done) -> discharge-call classes sp env (CErasedApply sp out effects fun value) done)
      other -> case arrow-parts sp function st of
        (domain, row, result, checked) -> discharge-call classes sp env (CErasedApply sp result row fun value) (unify sp domain (core-type value) checked)

  check-conditional-refinements :: Span -> Json -> List (String, String) -> Store -> (List (String, String), Store)
  check-conditional-refinements sp rows seen st = case rows of
    JArr row rest -> let checked = field "checked" row in
      case check-refinement-rows sp (resolved-nominals (field "head" checked)) seen st of
        (head, sh) -> case check-refinement-rows sp (resolved-nominals (field "implementation" checked)) head sh of
          (actual, sa) -> check-conditional-refinements sp rest actual sa
    other -> (seen, st)
  collect-conditional-measures :: Span -> Json -> List (String, Kind) -> TypeContext -> Store -> (TypeContext, Store)
  collect-conditional-measures sp rows classes kinds st = case rows of
    JArr row rest -> let checked = field "checked" row in
      case collect-private-measures sp (resolved-measures (field "head" checked)) classes kinds st of
        (head, sh) -> case collect-private-measures sp (resolved-measures (field "implementation" checked)) classes head sh of
          (actual, sa) -> collect-conditional-measures sp rest classes actual sa
    other -> (kinds, st)
  collect-conditional-instance-measures :: Span -> Json -> List (String, Kind) -> TypeContext -> Store -> (TypeContext, Store)
  collect-conditional-instance-measures sp rows classes kinds st = case rows of
    JArr row rest -> case collect-conditional-measures sp (field "method_contracts" row) classes kinds st of
      (more, done) -> collect-conditional-instance-measures sp rest classes more done
    other -> (kinds, st)


  env-guarded-bindings :: List CheckedBinding -> List GuardedBinding
  env-guarded-bindings env = case env of
    Nil -> Nil
    Cons (MkConditionalBinding name owner slot dictionary head sc (Some binding)) rest -> Cons binding (env-guarded-bindings rest)
    Cons (MkBodyContext context names cache) rest -> cached-guarded cache
    Cons other rest -> env-guarded-bindings rest

  checked-guarded-binding :: CheckedBinding -> Option GuardedBinding
  checked-guarded-binding binding = case binding of MkConditionalBinding name owner slot dictionary head sc guarded -> guarded; other -> None



  -- ============ temporal contracts (core specification section 10) ============
  --
  -- A `contract <kind> <name> for <def> where { ... }` claims one temporal
  -- formula over a definition's state transitions and states the
  -- assumptions it relies on. `Bootstrap.TemporalCheck` decides each kind
  -- against the definition's checked Core; this pass supplies that Core, the
  -- formula's elaboration, and the interface fact and manifest row that
  -- record the verdict.
  --
  -- The formula's scope is the definition's parameters: its pattern
  -- variables, bound as locals with the carriers its signature gave them, so
  -- a formula is checked as an ordinary boolean term over them and the
  -- proposition it reads is over the same identities the write log names.

  -- The contracts a module declares, in written order.
  module-contracts :: List Decl -> List (Span, String, String, String, List ContractClause)
  module-contracts declarations = case declarations of
    Nil -> Nil
    Cons (DContract s keyword name subject clauses) rest ->
      Cons (s, keyword, name, subject, clauses) (module-contracts rest)
    Cons other rest -> module-contracts rest

  -- The source name of a global identity: everything after its last `.`, so
  -- a row names `Main.countdown` rather than the encoded global spelling.
  source-subject :: String -> String
  source-subject identity = source-subject-from identity 0 0

  source-subject-from :: String -> Nat -> Nat -> String
  source-subject-from identity index start = case string-char-at identity index of
    None -> string-slice identity start (string-length identity)
    Some c -> if eq-char c '.' then source-subject-from identity (index + 1) (index + 1)
      else source-subject-from identity (index + 1) start

  find-core-definition :: String -> List CoreDefinition -> Option CoreDefinition
  find-core-definition name core = case core of
    Nil -> None
    Cons first rest -> if same name (core-name first) then Some first else find-core-definition name rest

  check-temporal-contracts :: String -> List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List Decl -> List CoreDefinition -> Store -> (List TemporalRow, Store)
  check-temporal-contracts home classes kinds families env declarations core st =
    temporal-contract-loop home classes kinds families env (module-contracts declarations) core Nil st

  temporal-contract-loop :: String -> List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List (Span, String, String, String, List ContractClause) -> List CoreDefinition -> List TemporalRow -> Store -> (List TemporalRow, Store)
  temporal-contract-loop home classes kinds families env pending core rows st = case store-errors st of
    Cons error rest -> (reverse rows, st)
    Nil -> case pending of
      Nil -> (reverse rows, st)
      Cons (s, keyword, name, subject, clauses) rest ->
        case check-one-temporal-contract home classes kinds families env s keyword name subject clauses core st of
          (Some row, checked) -> temporal-contract-loop home classes kinds families env rest core (Cons row rows) checked
          (None, checked) -> temporal-contract-loop home classes kinds families env rest core rows checked

  check-one-temporal-contract :: String -> List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> Span -> String -> String -> String -> List ContractClause -> List CoreDefinition -> Store -> (Option TemporalRow, Store)
  check-one-temporal-contract home classes kinds families env s keyword name subject clauses core st =
    case check-contract-shape s keyword clauses of
      Err message -> (None, add-error s message st)
      Ok (kind, body) -> case find-core-definition subject core of
        None -> (None, add-error s (string-concat-all
          ["the temporal contract `", name, "` names no definition `", home, ".", subject, "`: a contract attaches to a definition of its own module that the checker elaborates (core specification section 10)"]) st)
        Some definition -> verify-temporal home classes kinds families env definition s name kind body clauses st

  verify-temporal :: String -> List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> CoreDefinition -> Span -> String -> ContractKind -> Expr -> List ContractClause -> Store -> (Option TemporalRow, Store)
  verify-temporal home classes kinds families env definition s name kind body clauses st =
    let display = string-concat home (string-concat "." (source-subject (core-name definition))) in
    let parameters = temporal-definition-parameters (core-clauses definition) in
    let steps = temporal-definition-steps (core-name definition) (core-clauses definition) in
    let assumptions = contract-assumption-rows clauses in
    let formula = contract-formula-row kind body in
    let scope = formula-scope parameters in
    -- A liveness claim is not a state proposition: `joined` and `cleanup`
    -- name the finite structured-concurrency obligations, and anything else
    -- is refused as an unbounded eventual claim (core specification section
    -- 10). Only the safety, stability and recurrence formulas are read as
    -- comparisons over the definition's parameters, so only those are
    -- elaborated as boolean terms.
    case kind of
      Liveness -> case contract-assumed-facts classes kinds families env scope s name clauses st of
        (assumed, assumed-store) -> case store-errors assumed-store of
          Cons error rest -> (None, assumed-store)
          Nil -> finish-temporal definition s name kind formula assumptions assumed
            (verify-liveness name display (liveness-claim body) formula assumptions (temporal-scope-sites (definition-body (core-clauses definition)))) assumed-store
      Safety -> read-verified-temporal classes kinds families env definition s name kind body clauses scope steps assumptions formula display st
      Stability -> read-verified-temporal classes kinds families env definition s name kind body clauses scope steps assumptions formula display st
      Recurrence -> read-verified-temporal classes kinds families env definition s name kind body clauses scope steps assumptions formula display st

  -- The formula read as the comparison proposition it states, then the
  -- kind's decision procedure over it.
  read-verified-temporal :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> CoreDefinition -> Span -> String -> ContractKind -> Expr -> List ContractClause -> List CheckedBinding -> List TemporalStep -> List String -> String -> String -> Store -> (Option TemporalRow, Store)
  read-verified-temporal classes kinds families env definition s name kind body clauses scope steps assumptions formula display st =
    let parameters = temporal-definition-parameters (core-clauses definition) in
    case (read-formula classes kinds families env scope s name body st, contract-assumed-facts classes kinds families env scope s name clauses st) of
      ((None, formula-store), other) -> (None, formula-store)
      ((Some prop, formula-store), (assumed, assumed-store)) ->
        case store-errors assumed-store of
          Cons error rest -> (None, assumed-store)
          Nil -> finish-temporal definition s name kind formula assumptions assumed
            (temporal-verdict kind name display parameters prop steps definition assumed formula assumptions body) assumed-store

  temporal-verdict :: ContractKind -> String -> String -> List Parameter -> Proposition -> List TemporalStep -> CoreDefinition -> List Proposition -> String -> List String -> Expr -> TemporalVerdict
  temporal-verdict kind name display parameters prop steps definition assumed formula assumptions body = case kind of
    Safety -> verify-safety name display parameters prop steps assumed
    Stability -> verify-stability name display parameters prop steps
    Recurrence -> verify-recurrence name display parameters prop steps (temporal-recursive (core-name definition) (core-clauses definition)) (temporal-descent (core-name definition) (core-clauses definition))
    Liveness -> verify-liveness name display (liveness-claim body) formula assumptions (temporal-scope-sites (definition-body (core-clauses definition)))

  -- The locals a formula is checked in: the definition's parameters, bound
  -- at the identity Core gave them so the reading names the same places the
  -- write log does.
  formula-scope :: List Parameter -> List CheckedBinding
  formula-scope parameters = case parameters of
    Nil -> Nil
    Cons first rest -> Cons (MkLocalBinding (parameter-name first) (mono (parameter-type first)) (parameter-id first) 0) (formula-scope rest)

  -- The formula checked as an ordinary boolean term over the parameters, read
  -- as the comparison proposition it states.
  read-formula :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List CheckedBinding -> Span -> String -> Expr -> Store -> (Option Proposition, Store)
  read-formula classes kinds families env scope s name body st =
    case check classes kinds families (scope <> env) (formula-locals scope) body (primitive-type "Bool") st of
      (term, checked) -> case temporal-proposition term of
        Some prop -> (Some prop, checked)
        None -> (None, add-error s (string-concat-all
          ["temporal contract `", name, "`: the formula states a comparison proposition (`a < b`, `Eq a b`, ...) (core specification section 10)"]) checked)

  formula-locals :: List CheckedBinding -> List (String, UType)
  formula-locals scope = case scope of
    Nil -> Nil
    Cons (MkLocalBinding name sc id level) rest -> Cons (name, UIndex (scheme-body sc) (IRigid id name level)) (formula-locals rest)
    Cons other rest -> formula-locals rest

  -- The stated assumed facts (`assume = (P)`), read the same way.
  contract-assumed-facts :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List CheckedBinding -> Span -> String -> List ContractClause -> Store -> (List Proposition, Store)
  contract-assumed-facts classes kinds families env scope s name clauses st = assumed-loop classes kinds families env scope s name clauses Nil st

  assumed-loop :: List (String, Kind) -> TypeContext -> List (String, List String) -> List CheckedBinding -> List CheckedBinding -> Span -> String -> List ContractClause -> List Proposition -> Store -> (List Proposition, Store)
  assumed-loop classes kinds families env scope s name clauses acc st = case clauses of
    Nil -> (reverse acc, st)
    Cons first rest -> case first of
      ContractAssume at body -> case check classes kinds families (scope <> env) (formula-locals scope) body (primitive-type "Bool") st of
        (term, checked) -> case temporal-proposition term of
          Some prop -> assumed-loop classes kinds families env scope s name rest (Cons prop acc) checked
          None -> assumed-loop classes kinds families env scope s name rest acc checked
      other -> assumed-loop classes kinds families env scope s name rest acc st

  -- A liveness formula's claim: the two finite obligations name themselves,
  -- and every other formula is an unbounded eventual claim.
  liveness-claim :: Expr -> String
  liveness-claim body = case body of
    EVar s word -> if same word "joined" then "joined" else if same word "cleanup" then "cleanup" else "unbounded"
    other -> "unbounded"

  definition-body :: List CoreClause -> CoreTerm
  definition-body clauses = case clauses of
    Nil -> CUnit (Span 0 0 1 1) (primitive-type "Unit")
    Cons (MkCoreClause sp patterns body) rest -> CArgument sp body (definition-body rest)

  finish-temporal :: CoreDefinition -> Span -> String -> ContractKind -> String -> List String -> List Proposition -> TemporalVerdict -> Store -> (Option TemporalRow, Store)
  finish-temporal definition s name kind formula assumptions assumed verdict st =
    if verdict-verified verdict then
      (Some (MkTemporalRow (core-name definition) name (contract-kind-keyword kind) formula assumptions (verdict-message verdict)), st)
    else (None, add-error s (verdict-message verdict) st)
