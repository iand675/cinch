-- The parse tree the bootstrap rungs pass between them: the toolkit's spans
-- on every node, the surface forms the fragment models, and an explicit
-- honest boundary for the forms it only recognizes.
--
-- See bootstrap/README.md for the ladder, the corpus and the discipline
-- every rung follows.
--
-- Sequences are IN-TYPE SPINES with end markers, not `List X`: a Cinch data
-- type cannot nest itself inside another type constructor (`TApp :: ... ->
-- List TypeExpr -> TypeExpr` is refused by the positivity discipline), which
-- is the same constraint `Data.Json`'s `JArr`/`JArrEnd` answers. A parser
-- builds a spine from the list it already has (`type-arg-spine`); a consumer
-- takes the list back (`type-args-of`) and then has the whole `List`
-- vocabulary. A spine is well formed when its last cell is the matching end
-- marker, and the walkers below return the empty list for anything else, so
-- a malformed spine cannot fault a consumer.
--
-- Declaration order is load-bearing (a type cannot mention one declared
-- later): types, patterns, terms, declarations, modules, program.
--
-- `*Unmodeled` nodes are rung 1's coverage boundary: the parser records the
-- span and the source text of a form it does not model yet, and the checker
-- refuses it BY NAME, so coverage is a count over a corpus rather than a
-- claim. `*-unmodeled-count` computes those counts.
--
-- Names are `String` throughout (a later rung interns if it needs to). A
-- declaration's name for an operator definition is the operator text
-- (`|+|`), so a consumer tells an operator from a value with
-- `is-operator-name`.

module Bootstrap.Ast where

  import Text.Lex (Span, span-start, span-end, span-line, span-col, LToken, Token, lt-token, lt-virtual
    , TVar, TCon, TOp, TInt, TFloat, TStr, TChar, TWord, TPunct, TAttr, TPrimFrag, TTickName, TTickType, TEOF)
  import Data.Json (Json, JArr, JArrEnd, JStr, JBool, JNull)
  import Data.String (string-from-bytes, empty-string)
  import Text.Show (nat-to-string)
  import Algebra.Semigroup

  -- ------------------------------------------------------------------ spans

  -- The union of two spans: the start of the first, the end of the second.
  span-join :: Span -> Span -> Span
  span-join a b = Span (span-start a) (span-end b) (span-line a) (span-col a)

  -- A zero-width span at the start of `s`, for a node the parser synthesizes.
  span-here :: Span -> Span
  span-here s = Span (span-start s) (span-start s) (span-line s) (span-col s)

  -- Whether a declaration name is an operator (surface syntax and grammar,
  -- `operator`): the parser keeps the operator text as the name and the first
  -- character decides.
  is-operator-name :: String -> Bool
  is-operator-name s = case string-char-at s 0 of
    None -> False
    Some c -> is-operator-char c

  is-operator-char :: Char -> Bool
  is-operator-char c = is-operator-code (char-code c)

  -- The symbol set of the surface grammar's `operator` class, as code points:
  -- 33 `!` through 126 `~`, less the reserved punctuation `"` `'` `(` `)`
  -- `,` `;` `{` `}` `[` `]` and the layout characters.
  is-operator-code :: Nat -> Bool
  is-operator-code n =
    if n == 33 then True
    else if n == 35 then True
    else if n == 36 then True
    else if n == 37 then True
    else if n == 38 then True
    else if n == 42 then True
    else if n == 43 then True
    else if n == 45 then True
    else if n == 46 then True
    else if n == 47 then True
    else if n == 58 then True
    else if n == 60 then True
    else if n == 61 then True
    else if n == 62 then True
    else if n == 63 then True
    else if n == 64 then True
    else if n == 92 then True
    else if n == 94 then True
    else if n == 124 then True
    else if n == 126 then True
    else False

  -- ------------------------------------------------------------------ types

  data TypeExpr where
    TName :: Span -> String -> TypeExpr
    TIndex :: Span -> String -> TypeExpr
    TNegate :: Span -> TypeExpr -> TypeExpr
    TIndexLambda :: Span -> String -> TypeExpr -> TypeExpr
    TInfix :: Span -> String -> TypeExpr -> TypeExpr -> TypeExpr
    TRefined :: Span -> TypeExpr -> TypeExpr -> TypeExpr
    TApp :: Span -> TypeExpr -> TypeExpr -> TypeExpr
    TFun :: Span -> TypeExpr -> TypeExpr -> TypeExpr
    TFunEff :: Span -> TypeExpr -> TypeExpr -> TypeExpr -> TypeExpr
    TUsageArrow :: Span -> String -> TypeExpr -> TypeExpr
    TRow :: Span -> TypeExpr -> Option String -> TypeExpr
    TTuple :: Span -> TypeExpr -> TypeExpr
    TForall :: Span -> TypeExpr -> TypeExpr -> TypeExpr
    TQuantifier :: Span -> String -> Bool -> TypeExpr -> TypeExpr -> TypeExpr
    TQuantifiersEnd :: Span -> TypeExpr
    TNoKind :: Span -> TypeExpr
    TUsing :: Span -> TypeExpr -> TypeExpr -> TypeExpr
    TArg :: Span -> TypeExpr -> TypeExpr -> TypeExpr
    TArgsEnd :: Span -> TypeExpr
    TBound :: Span -> String -> TypeExpr -> TypeExpr -> TypeExpr
    TBoundsEnd :: Span -> TypeExpr
    TEvidenceField :: Span -> String -> TypeExpr -> TypeExpr
    TUnmodeled :: Span -> String -> TypeExpr

  type-arg-spine :: Span -> List TypeExpr -> TypeExpr
  type-arg-spine s xs = case xs of
    Nil -> TArgsEnd s
    Cons x rest -> TArg s x (type-arg-spine s rest)

  type-args-of :: TypeExpr -> List TypeExpr
  type-args-of t = case t of
    TArgsEnd s -> Nil
    TArg s x rest -> Cons x (type-args-of rest)
    other -> Nil

  type-bound-spine :: Span -> List (String, TypeExpr) -> TypeExpr
  type-bound-spine s xs = case xs of
    Nil -> TBoundsEnd s
    Cons x rest -> case x of
      (name, t) -> TBound s name t (type-bound-spine s rest)

  type-bounds-of :: TypeExpr -> List (String, TypeExpr)
  type-bounds-of t = case t of
    TBoundsEnd s -> Nil
    TBound s name ty rest -> Cons (name, ty) (type-bounds-of rest)
    other -> Nil

  type-expr-span :: TypeExpr -> Span
  type-expr-span t = case t of
    TName s n -> s
    TIndex s n -> s
    TNegate s x -> s
    TIndexLambda s name body -> s
    TInfix s op a b -> s
    TRefined s predicate carrier -> s
    TApp s h args -> s
    TFun s a b -> s
    TFunEff s a row b -> s
    TUsageArrow s usage arrow -> s
    TRow s labels tail -> s
    TTuple s xs -> s
    TForall s vs body -> s
    TQuantifier s name is-implicit kind rest -> s
    TQuantifiersEnd s -> s
    TNoKind s -> s
    TUsing s bounds body -> s
    TArg s x rest -> s
    TArgsEnd s -> s
    TBound s name ty rest -> s
    TBoundsEnd s -> s
    TEvidenceField s name ty -> s
    TUnmodeled s text -> s

  -- Declaration binders retain their kinds and implicitness. Throwing
  -- these away would make indexed and generic declarations indistinguishable.
  data TypeParam where
    MkTypeParam :: Span -> String -> Option TypeExpr -> Bool -> TypeParam

  param-name :: TypeParam -> String
  param-name p = case p of
    MkTypeParam s name kind is-implicit -> name

  param-span :: TypeParam -> Span
  param-span p = case p of
    MkTypeParam s name kind is-implicit -> s

  param-kind :: TypeParam -> Option TypeExpr
  param-kind p = case p of
    MkTypeParam s name kind is-implicit -> kind

  param-implicit :: TypeParam -> Bool
  param-implicit p = case p of
    MkTypeParam s name kind is-implicit -> is-implicit

  -- A direct recursive spine satisfies the seed's positivity discipline.
  -- The temporary parameter list must not appear nested in TypeExpr.
  forall-param-spine :: Span -> List TypeParam -> TypeExpr
  forall-param-spine sp params = case params of
    Nil -> TQuantifiersEnd sp
    Cons (MkTypeParam s name kind is-implicit) rest -> TQuantifier s name is-implicit (case kind of
      None -> TNoKind s
      Some annotation -> annotation) (forall-param-spine sp rest)

  forall-params-of :: TypeExpr -> List TypeParam
  forall-params-of binders = case binders of
    TQuantifiersEnd s -> Nil
    TQuantifier s name is-implicit kind rest -> Cons (MkTypeParam s name (case kind of
      TNoKind k -> None
      annotation -> Some annotation) is-implicit) (forall-params-of rest)
    other -> Nil

  params-unmodeled :: List TypeParam -> Nat
  params-unmodeled ps = case ps of
    Nil -> 0
    Cons p rest -> case param-kind p of
      None -> params-unmodeled rest
      Some ty -> type-unmodeled-count ty + params-unmodeled rest

  -- ---------------------------------------------------------------- patterns

  data Pat where
    PWild :: Span -> Pat
    PVar :: Span -> String -> Pat
    PCon :: Span -> String -> Pat -> Pat
    PRecord :: Span -> String -> Pat -> Pat
    PRecordField :: Span -> String -> Pat -> Pat -> Pat
    PLitInt :: Span -> String -> Pat
    PLitStr :: Span -> String -> Pat
    PLitChar :: Span -> String -> Pat
    PTuple :: Span -> Pat -> Pat
    PList :: Span -> Pat -> Pat
    PAs :: Span -> String -> Pat -> Pat
    PAnn :: Span -> Pat -> TypeExpr -> Pat
    PArg :: Span -> Pat -> Pat -> Pat
    PArgsEnd :: Span -> Pat
    PUnmodeled :: Span -> String -> Pat

  pat-spine :: Span -> List Pat -> Pat
  pat-spine s ps = case ps of
    Nil -> PArgsEnd s
    Cons p rest -> PArg s p (pat-spine s rest)

  pats-of :: Pat -> List Pat
  pats-of p = case p of
    PArgsEnd s -> Nil
    PArg s x rest -> Cons x (pats-of rest)
    other -> Nil

  pat-span :: Pat -> Span
  pat-span p = case p of
    PWild s -> s
    PVar s n -> s
    PCon s n args -> s
    PRecord s n fields -> s
    PRecordField s name value rest -> s
    PLitInt s text -> s
    PLitStr s text -> s
    PLitChar s text -> s
    PTuple s xs -> s
    PList s xs -> s
    PAs s n inner -> s
    PAnn s inner t -> s
    PArg s x rest -> s
    PArgsEnd s -> s
    PUnmodeled s text -> s

  -- ------------------------------------------------------------------- terms

  data Expr where
    EVar :: Span -> String -> Expr
    ECon :: Span -> String -> Expr -> Expr
    ERecord :: Span -> String -> Expr -> Expr
    ERecordField :: Span -> String -> Expr -> Expr -> Expr
    EProject :: Span -> Expr -> String -> Expr
    ELitInt :: Span -> String -> Expr
    ELitFloat :: Span -> String -> Expr
    ELitStr :: Span -> String -> Expr
    ELitChar :: Span -> String -> Expr
    EUnit :: Span -> Expr
    ETuple :: Span -> Expr -> Expr
    EList :: Span -> Expr -> Expr
    EApp :: Span -> Expr -> Expr -> Expr
    EBin :: Span -> String -> Expr -> Expr -> Expr
    ENeg :: Span -> Expr -> Expr
    ELam :: Span -> List Pat -> Expr -> Expr
    ELet :: Span -> Expr -> Expr -> Expr
    ELetScope :: Span -> Expr -> Expr
    ELocalGroup :: Span -> Expr -> Expr -> Expr
    ELetRec :: Span -> Expr -> Expr -> Expr
    ELocalStrict :: Span -> Pat -> Expr -> Expr -> Expr
    ELocalSignature :: Span -> String -> TypeExpr -> Expr -> Expr
    ELocalMemo :: Span -> String -> Expr -> Expr -> Expr
    ELocalEnd :: Span -> Expr
    EIf :: Span -> Expr -> Expr -> Expr -> Expr
    ECase :: Span -> Expr -> Expr -> Expr
    EGuarded :: Span -> Expr -> Expr -> Expr
    EAnn :: Span -> Expr -> TypeExpr -> Expr
    EForall :: Span -> List String -> Expr -> Expr
    EUsing :: Span -> TypeExpr -> Expr -> Expr
    EBind :: Span -> String -> Expr -> Expr
    EDo :: Span -> Expr -> Expr
    EHandle :: Span -> Expr -> Expr -> Expr
    EHandler :: Span -> TypeExpr -> Expr -> Expr
    EHandlerClause :: Span -> String -> List Pat -> Option String -> Expr -> Expr -> Expr
    EHandlerEnd :: Span -> Expr
    EWith :: Span -> Expr -> Expr -> Expr
    EArg :: Span -> Expr -> Expr -> Expr
    EArgsEnd :: Span -> Expr
    EBinding :: Span -> String -> Expr -> Expr -> Expr
    EBindingsEnd :: Span -> Expr
    EAlt :: Span -> Pat -> Expr -> Expr -> Expr
    EAltsEnd :: Span -> Expr
    -- `[| e |]`: a typed quotation, a `Code t` value built at compile time
    -- from the template `e` (modules specification, section 7). The template
    -- is checked in a closed scope (decision D43) and its effects stay
    -- latent in the code (decision D44).
    EQuote :: Span -> Expr -> Expr
    -- `$( e )`: a typed hole in a quotation template, filled at quote
    -- construction with the `Code` value of `e`.
    ESplice :: Span -> Expr -> Expr
    -- `name!(tokens)`: a macro invocation with a balanced token tree
    -- argument (grammar: `macro_call = var_path, "!", token_tree`). The
    -- tree is macro input, not a term: it becomes a term only when the
    -- expander runs the macro and splices the code it produced. `path` is
    -- the written spelling of the macro's name, before resolution.
    EMacroCall :: Span -> String -> List LToken -> Expr
    EUnmodeled :: Span -> String -> Expr

  expr-spine :: Span -> List Expr -> Expr
  expr-spine s xs = case xs of
    Nil -> EArgsEnd s
    Cons x rest -> EArg s x (expr-spine s rest)

  exprs-of :: Expr -> List Expr
  exprs-of e = case e of
    EArgsEnd s -> Nil
    EArg s x rest -> Cons x (exprs-of rest)
    other -> Nil

  binding-spine :: Span -> List (String, Expr) -> Expr
  binding-spine s bs = case bs of
    Nil -> EBindingsEnd s
    Cons b rest -> case b of
      (name, rhs) -> EBinding s name rhs (binding-spine s rest)

  bindings-of :: Expr -> List (String, Expr)
  bindings-of e = case e of
    EBindingsEnd s -> Nil
    EBinding s name rhs rest -> Cons (name, rhs) (bindings-of rest)
    other -> Nil

  alt-spine :: Span -> List (Pat, Expr) -> Expr
  alt-spine s alts = case alts of
    Nil -> EAltsEnd s
    Cons a rest -> case a of
      (p, body) -> EAlt s p body (alt-spine s rest)

  alts-of :: Expr -> List (Pat, Expr)
  alts-of e = case e of
    EAltsEnd s -> Nil
    EAlt s p body rest -> Cons (p, body) (alts-of rest)
    other -> Nil

  expr-span :: Expr -> Span
  expr-span e = case e of
    EVar s n -> s
    ECon s n args -> s
    ERecord s n fields -> s
    ERecordField s name value rest -> s
    EProject s value name -> s
    ELitInt s text -> s
    ELitFloat s text -> s
    ELitStr s text -> s
    ELitChar s text -> s
    EUnit s -> s
    ETuple s xs -> s
    EList s xs -> s
    EApp s f a -> s
    EBin s op l r -> s
    ENeg s x -> s
    ELam s ps body -> s
    ELet s bs body -> s
    ELetScope s body -> s
    ELocalGroup s bs body -> s
    ELetRec s bs body -> s
    ELocalStrict s p value rest -> s
    ELocalSignature s name ty rest -> s
    ELocalMemo s name value rest -> s
    ELocalEnd s -> s
    EIf s c t f -> s
    ECase s scrut alts -> s
    EGuarded s guard body -> s
    EAnn s x t -> s
    EForall s vs body -> s
    EUsing s bounds body -> s
    EBind s n rhs -> s
    EDo s stmts -> s
    EHandle s body h -> s
    EHandler s label clauses -> s
    EHandlerClause s name pats continuation body rest -> s
    EHandlerEnd s -> s
    EWith s bs body -> s
    EArg s x rest -> s
    EArgsEnd s -> s
    EBinding s name rhs rest -> s
    EBindingsEnd s -> s
    EAlt s p body rest -> s
    EAltsEnd s -> s
    EQuote s body -> s
    ESplice s expression -> s
    EMacroCall s path tokens -> s
    EUnmodeled s text -> s

  -- ------------------------------------------------------------ declarations

  -- `DFun`'s clauses are `(List Pat, Expr)` pairs; a pattern list inside a
  -- clause is not a recursive position of `Decl`, so it stays a `List`.
  -- Equation-local bindings are represented in the clause body.
  data ExportItem where
    ExportName :: Span -> List String -> ExportItem
    ExportModule :: Span -> String -> ExportItem

  -- A law equation contains terms, including the declaring class's methods.
  -- Keeping them distinct from its binder types preserves both scopes.
  data LawSyntax where
    LawForall :: List TypeParam -> LawSyntax -> LawSyntax
    LawArrow :: TypeExpr -> LawSyntax -> LawSyntax
    LawEquation :: Expr -> Expr -> LawSyntax
    LawProposition :: TypeExpr -> LawSyntax

  data PrimBody where
    MkPrimBody :: Span -> String -> String -> Bool -> Option Expr -> Option Expr -> List (String, TypeExpr) -> List Nat -> PrimBody

  -- A method keeps its ordinary declaration and slot. Its equality
  -- operands can be checked by the same term elaborator as an explicit law.
  method-equation-syntax :: TypeExpr -> Option LawSyntax
  method-equation-syntax ty = case ty of
    TForall sp params body -> case method-equation-syntax body of
      Some equation -> Some (LawForall (forall-params-of params) equation)
      None -> None
    TFun sp domain body -> case method-equation-syntax body of
      Some equation -> Some (LawArrow domain equation)
      None -> None
    TApp sp (TName head name) (TArg first left (TArg second right (TArgsEnd end))) ->
      if string-compare name "Eq" /= 0 then None else
        (case (index-syntax-expression left, index-syntax-expression right) of
          (Some a, Some b) -> Some (LawEquation a b)
          other -> None)
    other -> None

  index-syntax-expression :: TypeExpr -> Option Expr
  index-syntax-expression ty = case ty of
    TName sp name -> Some (if string-compare name "()" == 0 then EUnit sp else EVar sp name)
    TIndex sp digits -> Some (ELitInt sp digits)
    TNegate sp body -> case index-syntax-expression body of
      Some expression -> Some (ENeg sp expression)
      None -> None
    TIndexLambda sp name body -> case index-syntax-expression body of
      Some expression -> Some (ELam sp [PVar sp name] expression)
      None -> None
    TInfix sp operator left right -> case (index-syntax-expression left, index-syntax-expression right) of
      (Some a, Some b) -> Some (EBin sp operator a b)
      other -> None
    TApp sp head args -> case index-syntax-expression head of
      Some expression -> index-syntax-arguments expression args
      None -> None
    TBound sp name annotation (TBoundsEnd end) -> Some (EAnn sp (EVar sp name) annotation)
    other -> None

  index-syntax-arguments :: Expr -> TypeExpr -> Option Expr
  index-syntax-arguments head args = case args of
    TArgsEnd end -> Some head
    TArg at first rest -> case index-syntax-expression first of
      Some argument -> index-syntax-arguments (EApp at head argument) rest
      None -> None
    other -> None

  data RewriteJustification where
    RewriteTerm :: Expr -> RewriteJustification
    RewriteLaw :: Span -> String -> String -> List Expr -> RewriteJustification
  data RewriteSyntax where
    MkRewriteSyntax :: Bool -> List TypeParam -> TypeExpr -> Expr -> Expr -> Option Expr -> RewriteJustification -> RewriteSyntax

  -- One clause of a `contract` declaration's block (core specification
  -- section 10): the temporal formula, whose operator matches the
  -- contract's kind, and the stated assumptions a contract carries when it
  -- relies on the environment.
  data ContractClause where
    -- `<operator> = (P)`: the temporal formula.
    ContractFormula :: Span -> String -> Expr -> ContractClause
    -- `assume = (P)`: a stated assumed fact (a safety contract's
    -- establishment is one).
    ContractAssume :: Span -> Expr -> ContractClause
    -- `assume = "text"`: a stated environmental assumption (scheduler,
    -- dependency, crash, network, fairness).
    ContractAssumed :: Span -> String -> ContractClause

  contract-clause-span :: ContractClause -> Span
  contract-clause-span c = case c of
    ContractFormula s op body -> s
    ContractAssume s body -> s
    ContractAssumed s text -> s

  data Decl where
    DSource :: Span -> String -> Json -> Decl
    DInterface :: Span -> String -> String -> Json -> Decl
    DExternal :: Span -> String -> String -> Option TypeExpr -> Json -> Decl
    DSig :: Span -> String -> TypeExpr -> Decl
    -- Resolved source method: slot label and actual module binding.
    DMethod :: Span -> String -> String -> TypeExpr -> Decl
    DLaw :: Span -> String -> LawSyntax -> Decl
    DRewrite :: Span -> String -> RewriteSyntax -> Decl
    DFun :: Span -> String -> List (List Pat, Expr) -> Decl
    DData :: Span -> String -> List TypeParam -> List (String, TypeExpr) -> Decl
    DOpaque :: Span -> String -> List TypeParam -> TypeExpr -> Decl
    DRefine :: Span -> String -> List TypeParam -> TypeParam -> TypeExpr -> Decl
    DClass :: Span -> String -> List TypeParam -> Decl -> Decl
    DInstance :: Span -> Bool -> String -> List TypeParam -> TypeExpr -> Decl -> Decl
    DFixity :: Span -> String -> Nat -> List String -> Decl
    -- `import X hiding (a, b)`: the whole surface except these members, which
    -- are then out of scope bare and under the qualifier. Never combined with
    -- a selection (`members`), so a hidden list is only ever non-empty beside
    -- an empty selection.
    DImport :: Span -> String -> List String -> Option String -> List (String, Option String) -> List String -> List Expr -> Decl
    DExport :: Span -> String -> List ExportItem -> Decl
    DRecord :: Span -> String -> List TypeParam -> List (String, TypeExpr) -> Decl
    DCodata :: Span -> String -> List TypeParam -> List (String, TypeExpr) -> Decl
    DEffect :: Span -> String -> List TypeParam -> List (String, TypeExpr) -> Decl
    DForeign :: Span -> String -> String -> String -> String -> TypeExpr -> Decl
    DPrim :: Span -> String -> TypeExpr -> List PrimBody -> Decl
    DProof :: Span -> Decl -> Decl
    DCorec :: Span -> Decl -> Decl
    -- `macro name :: ty` and `macro name patterns = body`: a compile-time
    -- declaration. It carries no runtime presence; expansion marks its uses.
    DMacro :: Span -> Decl -> Decl
    DStage :: Span -> Decl -> Decl
    DGenerate :: Span -> Decl -> Decl
    DStageEmit :: Span -> Decl -> Decl
    DStageBranch :: Span -> Expr -> Decl -> Decl -> Decl
    -- `contract <kind> <name> for <def> where { ... }`: a temporal contract
    -- over a definition (core specification section 10), one of `safety`,
    -- `liveness`, `recurrence` or `stability`. The kind keyword is kept as
    -- written; its operator (`always`, `eventually`, `recur`, `stable`) is
    -- the kind's own, so the parser has already refused a formula whose
    -- operator disagrees with it.
    DContract :: Span -> String -> String -> String -> List ContractClause -> Decl
    -- `when <atom> ... <declaration>`: the declaration exists only on the
    -- targets its clause list selects (modules specification section 11).
    -- The atoms are the conjunction, and an `import X when <atom>` is the
    -- same wrapper around the `DImport`, so one pruning pass handles both.
    -- Where a clause does not hold the name is absent from the interface,
    -- from the module's exports and from code generation.
    DConditional :: Span -> List Expr -> Decl -> Decl
    DDecl :: Span -> Decl -> Decl -> Decl
    DDeclsEnd :: Span -> Decl
    DUnmodeled :: Span -> String -> Decl

  decl-spine :: Span -> List Decl -> Decl
  decl-spine s ds = case ds of
    Nil -> DDeclsEnd s
    Cons d rest -> DDecl s d (decl-spine s rest)

  decls-of :: Decl -> List Decl
  decls-of d = case d of
    DDeclsEnd s -> Nil
    DDecl s x rest -> Cons x (decls-of rest)
    other -> Nil

  decl-span :: Decl -> Span
  decl-span d = case d of
    DSource s name metadata -> s
    DInterface s name hash metadata -> s
    DExternal s name kind scheme metadata -> s
    DSig s n t -> s
    DMethod s label name t -> s
    DLaw s name syntax -> s
    DRewrite s name syntax -> s
    DFun s n clauses -> s
    DData s n params ctors -> s
    DOpaque s n params kind -> s
    DRefine s n params binder predicate -> s
    DClass s n params members -> s
    DInstance s is-implicit name params class-app members -> s
    DFixity s assoc prec ops -> s
    DImport s path mods alias members hidden args -> s
    DExport s text items -> s
    DRecord s n params fields -> s
    DCodata s n params observations -> s
    DEffect s n params ops -> s
    DForeign s direction conv symbol foreign-name t -> s
    DPrim s name ty bodies -> s
    DProof s body -> s
    DCorec s body -> s
    DConditional s clauses inner -> s
    DMacro s body -> s
    DStage s body -> s
    DGenerate s actions -> s
    DStageEmit s template -> s
    DStageBranch s condition yes no -> s
    DContract s kind name subject clauses -> s
    DDecl s x rest -> s
    DDeclsEnd s -> s
    DUnmodeled s text -> s

  -- A declaration's name, where it has one a consumer registers.
  decl-name :: Decl -> Option String
  decl-name d = case d of
    DSource s name metadata -> None
    DInterface s name hash metadata -> None
    DExternal s name kind scheme metadata -> Some name
    DSig s n t -> Some n
    DMethod s label name t -> Some name
    DLaw s name syntax -> None
    DRewrite s name syntax -> None
    DFun s n clauses -> Some n
    DData s n params ctors -> Some n
    DOpaque s n params kind -> Some n
    DRefine s n params binder predicate -> Some n
    DClass s n params members -> Some n
    DInstance s is-implicit name params class-app members -> Some name
    DFixity s assoc prec ops -> None
    DImport s path mods alias members hidden args -> Some path
    DExport s text items -> None
    DRecord s n params fields -> Some n
    DCodata s n params observations -> Some n
    DEffect s n params ops -> Some n
    DForeign s direction conv symbol foreign-name t -> Some foreign-name
    DPrim s name ty bodies -> Some name
    DDecl s x rest -> None
    DDeclsEnd s -> None
    DUnmodeled s text -> None
    DProof s body -> decl-name body
    DCorec s body -> decl-name body
    DConditional s clauses inner -> decl-name inner
    DMacro s body -> None
    DStage s body -> None
    DGenerate s actions -> None
    DStageEmit s template -> None
    DStageBranch s condition yes no -> None
    -- A contract declares no name of its own: it attaches to the definition
    -- it names, and that definition declares the name.
    DContract s kind name subject clauses -> None

  -- -------------------------------------------------------- modules, programs

  data Module where
    MkModule :: Span -> String -> Decl -> Module

  module-span :: Module -> Span
  module-span m = case m of
    MkModule s name decls -> s

  module-name :: Module -> String
  module-name m = case m of
    MkModule s name decls -> name

  -- The module's declarations, flattened out of its spine.
  module-decls :: Module -> List Decl
  module-decls m = case m of
    MkModule s name decls -> decls-of decls

  data Program where
    MkProgram :: Span -> List Module -> Program

  program-modules :: Program -> List Module
  program-modules p = case p of
    MkProgram s ms -> ms

  program-span :: Program -> Span
  program-span p = case p of
    MkProgram s ms -> s

  -- --------------------------------------- coverage: the boundary, counted

  type-unmodeled-count :: TypeExpr -> Nat
  type-unmodeled-count t = case t of
    TName s n -> 0
    TIndex s n -> 0
    TNegate s x -> type-unmodeled-count x
    TIndexLambda s name body -> type-unmodeled-count body
    TInfix s op a b -> type-unmodeled-count a + type-unmodeled-count b
    TRefined s predicate carrier -> type-unmodeled-count predicate + type-unmodeled-count carrier
    TApp s h args -> type-unmodeled-count h + type-unmodeleds (type-args-of args)
    TFun s a b -> type-unmodeled-count a + type-unmodeled-count b
    TFunEff s a row b -> type-unmodeled-count a + type-unmodeled-count row + type-unmodeled-count b
    TUsageArrow s usage arrow -> type-unmodeled-count arrow
    TRow s labels tail -> type-unmodeled-count labels
    TTuple s xs -> type-unmodeleds (type-args-of xs)
    TForall s vs body -> type-unmodeled-count vs + type-unmodeled-count body
    TQuantifier s name is-implicit kind rest -> type-unmodeled-count kind + type-unmodeled-count rest
    TQuantifiersEnd s -> 0
    TNoKind s -> 0
    TUsing s bounds body -> bounds-unmodeled (type-bounds-of bounds) + type-unmodeled-count body
    TArg s x rest -> type-unmodeled-count x + type-unmodeled-count rest
    TArgsEnd s -> 0
    TBound s name ty rest -> type-unmodeled-count ty + type-unmodeled-count rest
    TBoundsEnd s -> 0
    TUnmodeled s text -> 1
    TEvidenceField s name ty -> type-unmodeled-count ty

  type-unmodeleds :: List TypeExpr -> Nat
  type-unmodeleds ts = case ts of
    Nil -> 0
    Cons t rest -> type-unmodeled-count t + type-unmodeleds rest

  bounds-unmodeled :: List (String, TypeExpr) -> Nat
  bounds-unmodeled bs = case bs of
    Nil -> 0
    Cons b rest -> bound-unmodeled b + bounds-unmodeled rest

  bound-unmodeled :: (String, TypeExpr) -> Nat
  bound-unmodeled b = case b of
    (name, t) -> type-unmodeled-count t

  pat-unmodeled-count :: Pat -> Nat
  pat-unmodeled-count p = case p of
    PWild s -> 0
    PVar s n -> 0
    PCon s n args -> pats-unmodeled (pats-of args)
    PRecord s name fields -> pat-unmodeled-count fields
    PRecordField s name value rest -> pat-unmodeled-count value + pat-unmodeled-count rest
    PLitInt s text -> 0
    PLitStr s text -> 0
    PLitChar s text -> 0
    PTuple s xs -> pats-unmodeled (pats-of xs)
    PList s xs -> pats-unmodeled (pats-of xs)
    PAs s n inner -> pat-unmodeled-count inner
    PAnn s inner t -> pat-unmodeled-count inner + type-unmodeled-count t
    PArg s x rest -> pat-unmodeled-count x + pat-unmodeled-count rest
    PArgsEnd s -> 0
    PUnmodeled s text -> 1

  pats-unmodeled :: List Pat -> Nat
  pats-unmodeled ps = case ps of
    Nil -> 0
    Cons p rest -> pat-unmodeled-count p + pats-unmodeled rest

  expr-unmodeled-count :: Expr -> Nat
  expr-unmodeled-count e = case e of
    EVar s n -> 0
    ECon s n args -> exprs-unmodeled (exprs-of args)
    ERecord s name fields -> expr-unmodeled-count fields
    ERecordField s name value rest -> expr-unmodeled-count value + expr-unmodeled-count rest
    EProject s value name -> expr-unmodeled-count value
    ELitInt s text -> 0
    ELitFloat s text -> 0
    ELitStr s text -> 0
    ELitChar s text -> 0
    EUnit s -> 0
    ETuple s xs -> exprs-unmodeled (exprs-of xs)
    EList s xs -> exprs-unmodeled (exprs-of xs)
    EApp s f a -> expr-unmodeled-count f + expr-unmodeled-count a
    EBin s op l r -> expr-unmodeled-count l + expr-unmodeled-count r
    ENeg s x -> expr-unmodeled-count x
    ELam s ps body -> pats-unmodeled ps + expr-unmodeled-count body
    ELet s bs body -> bindings-unmodeled (bindings-of bs) + expr-unmodeled-count body
    ELetScope s body -> expr-unmodeled-count body
    ELocalGroup s bs body -> expr-unmodeled-count bs + expr-unmodeled-count body
    ELetRec s bs body -> expr-unmodeled-count bs + expr-unmodeled-count body
    ELocalStrict s p value rest -> pat-unmodeled-count p + expr-unmodeled-count value + expr-unmodeled-count rest
    ELocalSignature s name ty rest -> type-unmodeled-count ty + expr-unmodeled-count rest
    ELocalMemo s name value rest -> expr-unmodeled-count value + expr-unmodeled-count rest
    ELocalEnd s -> 0
    EIf s c t f -> expr-unmodeled-count c + expr-unmodeled-count t + expr-unmodeled-count f
    ECase s scrut alts -> expr-unmodeled-count scrut + alts-unmodeled (alts-of alts)
    EGuarded s guard body -> expr-unmodeled-count guard + expr-unmodeled-count body
    EAnn s x t -> expr-unmodeled-count x + type-unmodeled-count t
    EForall s vs body -> expr-unmodeled-count body
    EUsing s bounds body -> bounds-unmodeled (type-bounds-of bounds) + expr-unmodeled-count body
    EBind s n rhs -> expr-unmodeled-count rhs
    EDo s stmts -> exprs-unmodeled (exprs-of stmts)
    EHandle s body h -> expr-unmodeled-count body + expr-unmodeled-count h
    EHandler s label clauses -> type-unmodeled-count label + expr-unmodeled-count clauses
    EHandlerClause s name pats continuation body rest -> pats-unmodeled pats + expr-unmodeled-count body + expr-unmodeled-count rest
    EHandlerEnd s -> 0
    EWith s bs body -> bindings-unmodeled (bindings-of bs) + expr-unmodeled-count body
    EArg s x rest -> expr-unmodeled-count x + expr-unmodeled-count rest
    EArgsEnd s -> 0
    EBinding s name rhs rest -> expr-unmodeled-count rhs + expr-unmodeled-count rest
    EBindingsEnd s -> 0
    EAlt s p body rest -> pat-unmodeled-count p + expr-unmodeled-count body + expr-unmodeled-count rest
    EAltsEnd s -> 0
    EUnmodeled s text -> 1
    EQuote s body -> expr-unmodeled-count body
    ESplice s expression -> expr-unmodeled-count expression
    -- A macro call models its own form completely: the argument is a
    -- token tree the expander consumes, not an expression this rung owes
    -- a model of.
    EMacroCall s path tokens -> 0

  exprs-unmodeled :: List Expr -> Nat
  exprs-unmodeled es = case es of
    Nil -> 0
    Cons e rest -> expr-unmodeled-count e + exprs-unmodeled rest

  bindings-unmodeled :: List (String, Expr) -> Nat
  bindings-unmodeled bs = case bs of
    Nil -> 0
    Cons b rest -> binding-unmodeled b + bindings-unmodeled rest

  binding-unmodeled :: (String, Expr) -> Nat
  binding-unmodeled b = case b of
    (name, e) -> expr-unmodeled-count e

  alts-unmodeled :: List (Pat, Expr) -> Nat
  alts-unmodeled alts = case alts of
    Nil -> 0
    Cons a rest -> alt-unmodeled a + alts-unmodeled rest

  alt-unmodeled :: (Pat, Expr) -> Nat
  alt-unmodeled a = case a of
    (p, e) -> pat-unmodeled-count p + expr-unmodeled-count e

  clauses-unmodeled :: List (List Pat, Expr) -> Nat
  clauses-unmodeled cs = case cs of
    Nil -> 0
    Cons c rest -> clause-unmodeled c + clauses-unmodeled rest

  clause-unmodeled :: (List Pat, Expr) -> Nat
  clause-unmodeled c = case c of
    (pats, body) -> pats-unmodeled pats + expr-unmodeled-count body

  ctors-unmodeled :: List (String, TypeExpr) -> Nat
  ctors-unmodeled cs = case cs of
    Nil -> 0
    Cons c rest -> ctor-unmodeled c + ctors-unmodeled rest

  ctor-unmodeled :: (String, TypeExpr) -> Nat
  ctor-unmodeled c = case c of
    (name, t) -> type-unmodeled-count t

  decl-unmodeled-count :: Decl -> Nat
  decl-unmodeled-count d = case d of
    DSource s name metadata -> 0
    DInterface s name hash metadata -> 0
    DExternal s name kind scheme metadata -> 0
    DSig s n t -> type-unmodeled-count t
    DMethod s label name t -> type-unmodeled-count t
    DLaw s name syntax -> law-unmodeled-count syntax
    DRewrite s name (MkRewriteSyntax targeted params bounds pattern replacement guard evidence) ->
      params-unmodeled params + type-unmodeled-count bounds + expr-unmodeled-count pattern + expr-unmodeled-count replacement
      + (case guard of Some condition -> expr-unmodeled-count condition; None -> 0)
      + (case evidence of RewriteTerm expression -> expr-unmodeled-count expression; RewriteLaw sp owner member args -> exprs-unmodeled args)
    DFun s n clauses -> clauses-unmodeled clauses
    DData s n params ctors -> params-unmodeled params + ctors-unmodeled ctors
    DOpaque s n params kind -> params-unmodeled params + type-unmodeled-count kind
    DRefine s n params binder predicate -> params-unmodeled (Cons binder params) + type-unmodeled-count predicate
    DClass s n params members -> params-unmodeled params + decls-unmodeled (decls-of members)
    DInstance s is-implicit name params class-app members -> params-unmodeled params + type-unmodeled-count class-app + decls-unmodeled (decls-of members)
    DFixity s assoc prec ops -> 0
    DImport s path mods alias members hidden args -> exprs-unmodeled args
    DExport s text items -> 0
    DRecord s n params fields -> params-unmodeled params + ctors-unmodeled fields
    DCodata s n params observations -> params-unmodeled params + ctors-unmodeled observations
    DEffect s n params ops -> params-unmodeled params + ctors-unmodeled ops
    DForeign s direction conv symbol foreign-name t -> type-unmodeled-count t
    DPrim s name ty bodies -> type-unmodeled-count ty + prim-bodies-unmodeled bodies
    DDecl s x rest -> decl-unmodeled-count x + decl-unmodeled-count rest
    DDeclsEnd s -> 0
    DUnmodeled s text -> 1
    DProof s body -> decl-unmodeled-count body
    DCorec s body -> decl-unmodeled-count body
    DConditional s clauses inner -> exprs-unmodeled clauses + decl-unmodeled-count inner
    DMacro s body -> decl-unmodeled-count body
    DStage s body -> decl-unmodeled-count body
    DGenerate s actions -> decl-unmodeled-count actions
    DStageEmit s template -> decl-unmodeled-count template
    DStageBranch s condition yes no -> expr-unmodeled-count condition + decl-unmodeled-count yes + decl-unmodeled-count no
    DContract s kind name subject clauses -> contract-clauses-unmodeled clauses

  contract-clauses-unmodeled :: List ContractClause -> Nat
  contract-clauses-unmodeled clauses = case clauses of
    Nil -> 0
    Cons c rest -> contract-clause-unmodeled c + contract-clauses-unmodeled rest

  contract-clause-unmodeled :: ContractClause -> Nat
  contract-clause-unmodeled c = case c of
    ContractFormula s op body -> expr-unmodeled-count body
    ContractAssume s body -> expr-unmodeled-count body
    ContractAssumed s text -> 0

  prim-bodies-unmodeled :: List PrimBody -> Nat
  prim-bodies-unmodeled bodies = case bodies of
    Nil -> 0
    Cons (MkPrimBody sp family fragment unverified condition justification uses immediates) rest ->
      (case condition of Some value -> expr-unmodeled-count value; None -> 0)
        + (case justification of Some value -> expr-unmodeled-count value; None -> 0)
        + ctors-unmodeled uses + prim-bodies-unmodeled rest

  law-unmodeled-count :: LawSyntax -> Nat
  law-unmodeled-count syntax = case syntax of
    LawForall parameters rest -> params-unmodeled parameters + law-unmodeled-count rest
    LawArrow domain rest -> type-unmodeled-count domain + law-unmodeled-count rest
    LawEquation left right -> expr-unmodeled-count left + expr-unmodeled-count right
    LawProposition ty -> type-unmodeled-count ty

  decls-unmodeled :: List Decl -> Nat
  decls-unmodeled ds = case ds of
    Nil -> 0
    Cons d rest -> decl-unmodeled-count d + decls-unmodeled rest

  module-unmodeled-count :: Module -> Nat
  module-unmodeled-count m = case m of
    MkModule s name decls -> decl-unmodeled-count decls

  program-unmodeled-count :: Program -> Nat
  program-unmodeled-count p = case p of
    MkProgram s ms -> modules-unmodeled ms

  modules-unmodeled :: List Module -> Nat
  modules-unmodeled ms = case ms of
    Nil -> 0
    Cons m rest -> module-unmodeled-count m + modules-unmodeled rest

  -- Span-free constructor-tagged identity of resolved source syntax.
  -- Used only after type checking; this grants no typing or proof authority.
  -- Qualified globals and argument order remain explicit.
  source-identity-type :: TypeExpr -> Json
  source-identity-type value = case value of
    TName part0 part1 -> JArr (JStr "TName") (JArr (JStr part1) (JArrEnd))
    TIndex part0 part1 -> JArr (JStr "TIndex") (JArr (JStr part1) (JArrEnd))
    TNegate part0 part1 -> JArr (JStr "TNegate") (JArr (source-identity-type part1) (JArrEnd))
    TIndexLambda sp name body -> JArr (JStr "TIndexLambda") (JArr (JStr name) (JArr (source-identity-type body) JArrEnd))
    TInfix part0 part1 part2 part3 -> JArr (JStr "TInfix") (JArr (JStr part1) (JArr (source-identity-type part2) (JArr (source-identity-type part3) (JArrEnd))))
    TRefined part0 part1 part2 -> JArr (JStr "TRefined") (JArr (source-identity-type part1) (JArr (source-identity-type part2) (JArrEnd)))
    TApp part0 part1 part2 -> JArr (JStr "TApp") (JArr (source-identity-type part1) (JArr (source-identity-type part2) (JArrEnd)))
    TFun part0 part1 part2 -> JArr (JStr "TFun") (JArr (source-identity-type part1) (JArr (source-identity-type part2) (JArrEnd)))
    TFunEff part0 part1 part2 part3 -> JArr (JStr "TFunEff") (JArr (source-identity-type part1) (JArr (source-identity-type part2) (JArr (source-identity-type part3) (JArrEnd))))
    TUsageArrow sp usage arrow -> JArr (JStr "TUsageArrow") (JArr (JStr usage) (JArr (source-identity-type arrow) JArrEnd))
    TRow part0 part1 part2 -> JArr (JStr "TRow") (JArr (source-identity-type part1) (JArr (source-identity-optional part2) (JArrEnd)))
    TTuple part0 part1 -> JArr (JStr "TTuple") (JArr (source-identity-type part1) (JArrEnd))
    TForall part0 part1 part2 -> JArr (JStr "TForall") (JArr (source-identity-type part1) (JArr (source-identity-type part2) (JArrEnd)))
    TQuantifier part0 part1 part2 part3 part4 -> JArr (JStr "TQuantifier") (JArr (JStr part1) (JArr (JBool part2) (JArr (source-identity-type part3) (JArr (source-identity-type part4) (JArrEnd)))))
    TQuantifiersEnd part0 -> JArr (JStr "TQuantifiersEnd") (JArrEnd)
    TNoKind part0 -> JArr (JStr "TNoKind") (JArrEnd)
    TUsing part0 part1 part2 -> JArr (JStr "TUsing") (JArr (source-identity-type part1) (JArr (source-identity-type part2) (JArrEnd)))
    TArg part0 part1 part2 -> JArr (JStr "TArg") (JArr (source-identity-type part1) (JArr (source-identity-type part2) (JArrEnd)))
    TArgsEnd part0 -> JArr (JStr "TArgsEnd") (JArrEnd)
    TBound part0 part1 part2 part3 -> JArr (JStr "TBound") (JArr (JStr part1) (JArr (source-identity-type part2) (JArr (source-identity-type part3) (JArrEnd))))
    TBoundsEnd part0 -> JArr (JStr "TBoundsEnd") (JArrEnd)
    TUnmodeled part0 part1 -> JArr (JStr "TUnmodeled") (JArr (JStr part1) (JArrEnd))
    TEvidenceField s name ty -> JArr (JStr "TEvidenceField") (JArr (JStr name) (JArr (source-identity-type ty) JArrEnd))

  source-identity-pat :: Pat -> Json
  source-identity-pat value = case value of
    PWild part0 -> JArr (JStr "PWild") (JArrEnd)
    PVar part0 part1 -> JArr (JStr "PVar") (JArr (JStr part1) (JArrEnd))
    PCon part0 part1 part2 -> JArr (JStr "PCon") (JArr (JStr part1) (JArr (source-identity-pat part2) (JArrEnd)))
    PRecord part0 part1 part2 -> JArr (JStr "PRecord") (JArr (JStr part1) (JArr (source-identity-pat part2) (JArrEnd)))
    PRecordField part0 part1 part2 part3 -> JArr (JStr "PRecordField") (JArr (JStr part1) (JArr (source-identity-pat part2) (JArr (source-identity-pat part3) (JArrEnd))))
    PLitInt part0 part1 -> JArr (JStr "PLitInt") (JArr (JStr part1) (JArrEnd))
    PLitStr part0 part1 -> JArr (JStr "PLitStr") (JArr (JStr part1) (JArrEnd))
    PLitChar part0 part1 -> JArr (JStr "PLitChar") (JArr (JStr part1) (JArrEnd))
    PTuple part0 part1 -> JArr (JStr "PTuple") (JArr (source-identity-pat part1) (JArrEnd))
    PList part0 part1 -> JArr (JStr "PList") (JArr (source-identity-pat part1) (JArrEnd))
    PAs part0 part1 part2 -> JArr (JStr "PAs") (JArr (JStr part1) (JArr (source-identity-pat part2) (JArrEnd)))
    PAnn part0 part1 part2 -> JArr (JStr "PAnn") (JArr (source-identity-pat part1) (JArr (source-identity-type part2) (JArrEnd)))
    PArg part0 part1 part2 -> JArr (JStr "PArg") (JArr (source-identity-pat part1) (JArr (source-identity-pat part2) (JArrEnd)))
    PArgsEnd part0 -> JArr (JStr "PArgsEnd") (JArrEnd)
    PUnmodeled part0 part1 -> JArr (JStr "PUnmodeled") (JArr (JStr part1) (JArrEnd))

  source-identity-expr :: Expr -> Json
  source-identity-expr value = case value of
    EVar part0 part1 -> JArr (JStr "EVar") (JArr (JStr part1) (JArrEnd))
    ECon part0 part1 part2 -> JArr (JStr "ECon") (JArr (JStr part1) (JArr (source-identity-expr part2) (JArrEnd)))
    ERecord part0 part1 part2 -> JArr (JStr "ERecord") (JArr (JStr part1) (JArr (source-identity-expr part2) (JArrEnd)))
    ERecordField part0 part1 part2 part3 -> JArr (JStr "ERecordField") (JArr (JStr part1) (JArr (source-identity-expr part2) (JArr (source-identity-expr part3) (JArrEnd))))
    EProject part0 part1 part2 -> JArr (JStr "EProject") (JArr (source-identity-expr part1) (JArr (JStr part2) (JArrEnd)))
    ELitInt part0 part1 -> JArr (JStr "ELitInt") (JArr (JStr part1) (JArrEnd))
    ELitFloat part0 part1 -> JArr (JStr "ELitFloat") (JArr (JStr part1) (JArrEnd))
    ELitStr part0 part1 -> JArr (JStr "ELitStr") (JArr (JStr part1) (JArrEnd))
    ELitChar part0 part1 -> JArr (JStr "ELitChar") (JArr (JStr part1) (JArrEnd))
    EUnit part0 -> JArr (JStr "EUnit") (JArrEnd)
    ETuple part0 part1 -> JArr (JStr "ETuple") (JArr (source-identity-expr part1) (JArrEnd))
    EList part0 part1 -> JArr (JStr "EList") (JArr (source-identity-expr part1) (JArrEnd))
    EApp part0 part1 part2 -> JArr (JStr "EApp") (JArr (source-identity-expr part1) (JArr (source-identity-expr part2) (JArrEnd)))
    EBin part0 part1 part2 part3 -> JArr (JStr "EBin") (JArr (JStr part1) (JArr (source-identity-expr part2) (JArr (source-identity-expr part3) (JArrEnd))))
    ENeg part0 part1 -> JArr (JStr "ENeg") (JArr (source-identity-expr part1) (JArrEnd))
    ELam part0 part1 part2 -> JArr (JStr "ELam") (JArr (source-identity-pats part1) (JArr (source-identity-expr part2) (JArrEnd)))
    ELet part0 part1 part2 -> JArr (JStr "ELet") (JArr (source-identity-expr part1) (JArr (source-identity-expr part2) (JArrEnd)))
    ELetScope sp body -> source-identity-expr body
    ELocalGroup sp bindings body -> JArr (JStr "ELocalGroup") (JArr (source-identity-expr bindings) (JArr (source-identity-expr body) JArrEnd))
    ELetRec sp bindings body -> JArr (JStr "ELetRec") (JArr (source-identity-expr bindings) (JArr (source-identity-expr body) JArrEnd))
    ELocalStrict sp pattern value rest -> JArr (JStr "ELocalStrict") (JArr (source-identity-pat pattern) (JArr (source-identity-expr value) (JArr (source-identity-expr rest) JArrEnd)))
    ELocalSignature sp name ty rest -> JArr (JStr "ELocalSignature") (JArr (JStr name) (JArr (source-identity-type ty) (JArr (source-identity-expr rest) JArrEnd)))
    ELocalMemo sp name value rest -> JArr (JStr "ELocalMemo") (JArr (JStr name) (JArr (source-identity-expr value) (JArr (source-identity-expr rest) JArrEnd)))
    ELocalEnd sp -> JArr (JStr "ELocalEnd") JArrEnd
    EIf part0 part1 part2 part3 -> JArr (JStr "EIf") (JArr (source-identity-expr part1) (JArr (source-identity-expr part2) (JArr (source-identity-expr part3) (JArrEnd))))
    ECase part0 part1 part2 -> JArr (JStr "ECase") (JArr (source-identity-expr part1) (JArr (source-identity-expr part2) (JArrEnd)))
    EGuarded part0 part1 part2 -> JArr (JStr "EGuarded") (JArr (source-identity-expr part1) (JArr (source-identity-expr part2) (JArrEnd)))
    EAnn part0 part1 part2 -> JArr (JStr "EAnn") (JArr (source-identity-expr part1) (JArr (source-identity-type part2) (JArrEnd)))
    EForall part0 part1 part2 -> JArr (JStr "EForall") (JArr (source-identity-names part1) (JArr (source-identity-expr part2) (JArrEnd)))
    EUsing part0 part1 part2 -> JArr (JStr "EUsing") (JArr (source-identity-type part1) (JArr (source-identity-expr part2) (JArrEnd)))
    EBind part0 part1 part2 -> JArr (JStr "EBind") (JArr (JStr part1) (JArr (source-identity-expr part2) (JArrEnd)))
    EDo part0 part1 -> JArr (JStr "EDo") (JArr (source-identity-expr part1) (JArrEnd))
    EHandle part0 part1 part2 -> JArr (JStr "EHandle") (JArr (source-identity-expr part1) (JArr (source-identity-expr part2) (JArrEnd)))
    EHandler part0 part1 part2 -> JArr (JStr "EHandler") (JArr (source-identity-type part1) (JArr (source-identity-expr part2) (JArrEnd)))
    EHandlerClause part0 part1 part2 part3 part4 part5 -> JArr (JStr "EHandlerClause") (JArr (JStr part1) (JArr (source-identity-pats part2) (JArr (source-identity-optional part3) (JArr (source-identity-expr part4) (JArr (source-identity-expr part5) (JArrEnd))))))
    EHandlerEnd part0 -> JArr (JStr "EHandlerEnd") (JArrEnd)
    EWith part0 part1 part2 -> JArr (JStr "EWith") (JArr (source-identity-expr part1) (JArr (source-identity-expr part2) (JArrEnd)))
    EArg part0 part1 part2 -> JArr (JStr "EArg") (JArr (source-identity-expr part1) (JArr (source-identity-expr part2) (JArrEnd)))
    EArgsEnd part0 -> JArr (JStr "EArgsEnd") (JArrEnd)
    EBinding part0 part1 part2 part3 -> JArr (JStr "EBinding") (JArr (JStr part1) (JArr (source-identity-expr part2) (JArr (source-identity-expr part3) (JArrEnd))))
    EBindingsEnd part0 -> JArr (JStr "EBindingsEnd") (JArrEnd)
    EAlt part0 part1 part2 part3 -> JArr (JStr "EAlt") (JArr (source-identity-pat part1) (JArr (source-identity-expr part2) (JArr (source-identity-expr part3) (JArrEnd))))
    EAltsEnd part0 -> JArr (JStr "EAltsEnd") (JArrEnd)
    EUnmodeled part0 part1 -> JArr (JStr "EUnmodeled") (JArr (JStr part1) (JArrEnd))
    EQuote part0 part1 -> JArr (JStr "EQuote") (JArr (source-identity-expr part1) JArrEnd)
    -- A macro call's identity is its name and its argument's token
    -- spellings: two calls are the same source when both agree, which is
    -- what the default-clause and interface identity comparisons need.
    EMacroCall part0 part1 part2 -> JArr (JStr "EMacroCall") (JArr (JStr part1) (JArr (source-identity-tokens part2) JArrEnd))
    ESplice part0 part1 -> JArr (JStr "ESplice") (JArr (source-identity-expr part1) JArrEnd)

  source-identity-pats :: List Pat -> Json
  source-identity-pats values = case values of Nil -> JArrEnd; Cons first rest -> JArr (source-identity-pat first) (source-identity-pats rest)
  source-identity-names :: List String -> Json
  source-identity-names values = case values of Nil -> JArrEnd; Cons first rest -> JArr (JStr first) (source-identity-names rest)
  -- A token tree's identity is the tokens' own spelling. A layout-inserted
  -- token is not in the source, so it cannot distinguish two spellings.
  source-identity-tokens :: List LToken -> Json
  source-identity-tokens values = case values of
    Nil -> JArrEnd
    Cons first rest -> if lt-virtual first then source-identity-tokens rest
      else JArr (JStr (token-identity-spelling (lt-token first))) (source-identity-tokens rest)

  -- The spelling a token contributes to a source identity. Every token
  -- kind that can appear in a macro argument has one; the layout and
  -- fragment kinds are spelled by nothing, so they add the empty string,
  -- which two identical trees agree on.
  token-identity-spelling :: Token -> String
  token-identity-spelling t = case t of
    TVar s -> s
    TCon s -> s
    TOp s -> s
    TInt s -> s
    TFloat s -> s
    TStr b -> case string-from-bytes b of Some s -> s; None -> empty-string
    TChar n -> nat-to-string n
    TWord s -> s
    TPunct s -> s
    TAttr s -> s
    TPrimFrag s -> s
    TTickName s -> s
    TTickType s -> s
    TEOF -> empty-string
  source-identity-optional :: Option String -> Json
  source-identity-optional value = case value of None -> JNull; Some name -> JStr name
  source-clauses-document :: List (List Pat, Expr) -> Json
  source-clauses-document clauses = case clauses of
    Nil -> JArrEnd
    Cons (patterns, body) rest -> JArr (JArr (source-identity-pats patterns) (JArr (source-identity-expr body) JArrEnd)) (source-clauses-document rest)

  source-law-document :: LawSyntax -> Json
  source-law-document declaration = case declaration of
    LawForall parameters body ->
      JArr (JStr "LawForall") (JArr (source-law-parameters parameters) (JArr (source-law-document body) JArrEnd))
    LawArrow domain body -> (case domain of
      TBound sp name ty tail -> source-law-arrow (JStr name) ty body
      other -> source-law-arrow JNull domain body)
    LawEquation left right ->
      JArr (JStr "LawEquation") (JArr (source-identity-expr left) (JArr (source-identity-expr right) JArrEnd))
    LawProposition ty -> JNull

  source-law-arrow :: Json -> TypeExpr -> LawSyntax -> Json
  source-law-arrow name domain body = JArr (JStr "LawArrow")
    (JArr name (JArr (source-identity-type domain) (JArr (source-law-document body) JArrEnd)))

  source-law-parameters :: List TypeParam -> Json
  source-law-parameters parameters = case parameters of
    Nil -> JArrEnd
    Cons p rest -> JArr (JArr (JStr (param-name p)) (JArr (JBool (param-implicit p))
      (JArr (case param-kind p of Some kind -> source-identity-type kind; None -> JNull) JArrEnd)))
      (source-law-parameters rest)

  qualify-default-clauses :: (String -> Option String) -> Json -> Json
  qualify-default-clauses globals syntax = case syntax of
    JArr (JStr tag) (JArr (JStr name) rest) -> if default-global-tag tag then
      JArr (JStr tag) (JArr (JStr (case globals name of Some identity -> identity; None -> name)) (qualify-default-clauses globals rest))
      else JArr (JStr tag) (JArr (JStr name) (qualify-default-clauses globals rest))
    JArr first rest -> JArr (qualify-default-clauses globals first) (qualify-default-clauses globals rest)
    other -> syntax
  default-global-tag :: String -> Bool
  default-global-tag tag =
    default-tag tag "EVar" || default-tag tag "ECon" || default-tag tag "PCon"
    || default-tag tag "ERecord" || default-tag tag "PRecord" || default-tag tag "TName"

  -- The interface body is syntax, never checked Core. Decode only the
  -- portable forms and rebuild their lexical scopes before elaboration.
  default-tag :: String -> String -> Bool
  default-tag a b = string-compare a b == 0
  default-bound :: String -> List String -> Bool
  default-bound name bound = case bound of
    Nil -> False
    Cons first rest -> default-tag name first || default-bound name rest
  default-local :: String -> Bool
  default-local name = case unpack name of
    Nil -> False
    Cons first rest -> default-local-chars (Cons first rest)
  default-local-chars :: List Char -> Bool
  default-local-chars chars = case chars of
    Nil -> True
    Cons c rest -> char-code c /= 46 && default-local-chars rest
  default-reference :: (String -> Option String) -> List String -> String -> Option String
  default-reference globals bound name = if default-bound name bound then Some name else globals name

  default-pattern :: Span -> (String -> Option String) -> Json -> Option (Pat, List String)
  default-pattern sp globals syntax = case syntax of
    JArr (JStr tag) JArrEnd ->
      if default-tag tag "PWild" then Some (PWild sp, Nil)
      else if default-tag tag "PArgsEnd" then Some (PArgsEnd sp, Nil) else None
    JArr (JStr tag) (JArr (JStr name) JArrEnd) ->
      if default-tag tag "PVar" && default-local name then Some (PVar sp name, [name])
      else if default-tag tag "PLitInt" then Some (PLitInt sp name, Nil)
      else if default-tag tag "PLitChar" then Some (PLitChar sp name, Nil)
      else if default-tag tag "PLitStr" then Some (PLitStr sp name, Nil)
      else None
    JArr (JStr tag) (JArr body JArrEnd) -> case default-pattern sp globals body of
      Some (pattern, bound) -> if default-tag tag "PTuple" then Some (PTuple sp pattern, bound)
        else if default-tag tag "PList" then Some (PList sp pattern, bound) else None
      None -> None
    JArr (JStr tag) (JArr (JStr name) (JArr body JArrEnd)) -> case default-pattern sp globals body of
      Some (pattern, bound) ->
        if default-tag tag "PAs" && default-local name then Some (PAs sp name pattern, Cons name bound)
        else if default-tag tag "PCon" then
          (case globals name of Some identity -> Some (PCon sp identity pattern, bound); None -> None)
        else None
      None -> None
    JArr (JStr tag) (JArr first (JArr rest JArrEnd)) -> if not (default-tag tag "PArg") then None else
      (case (default-pattern sp globals first, default-pattern sp globals rest) of
        (Some (pattern, bound), Some (more, bindings)) -> Some (PArg sp pattern more, bound <> bindings)
        other -> None)
    other -> None

  default-patterns :: Span -> (String -> Option String) -> Json -> Option (List Pat, List String)
  default-patterns sp globals syntax = case syntax of
    JArrEnd -> Some (Nil, Nil)
    JArr first rest -> case (default-pattern sp globals first, default-patterns sp globals rest) of
      (Some (pattern, bound), Some (more, bindings)) -> Some (Cons pattern more, bound <> bindings)
      other -> None
    other -> None

  default-type :: Span -> (String -> Option String) -> Json -> Option TypeExpr
  default-type sp globals syntax = case syntax of
    JArr (JStr tag) JArrEnd -> if default-tag tag "TArgsEnd" then Some (TArgsEnd sp) else None
    JArr (JStr tag) (JArr (JStr name) JArrEnd) ->
      if default-tag tag "TIndex" then Some (TIndex sp name)
      else if default-tag tag "TName" then
        (case globals name of
          Some identity -> Some (TName sp identity)
          None -> if default-local name then Some (TName sp name) else None)
      else None
    JArr (JStr tag) (JArr left (JArr right JArrEnd)) | default-tag tag "TIndexLambda" -> case left of
      JStr name | default-local name -> (case default-type sp (\symbol -> if default-tag symbol name then None else globals symbol) right of
        Some body -> Some (TIndexLambda sp name body)
        None -> None)
      other -> None
    JArr (JStr tag) (JArr left (JArr right JArrEnd)) -> case (default-type sp globals left, default-type sp globals right) of
      (Some first, Some second) -> if default-tag tag "TFun" then Some (TFun sp first second)
        else if default-tag tag "TApp" then Some (TApp sp first second)
        else if default-tag tag "TArg" then Some (TArg sp first second) else None
      other -> None
    other -> None

  default-expression :: Span -> (String -> Option String) -> List String -> Json -> Option Expr
  default-expression sp globals bound syntax = case syntax of
    JArr (JStr tag) JArrEnd ->
      if default-tag tag "EUnit" then Some (EUnit sp)
      else if default-tag tag "EArgsEnd" then Some (EArgsEnd sp)
      else if default-tag tag "EAltsEnd" then Some (EAltsEnd sp)
      else None
    JArr (JStr tag) (JArr (JStr value) JArrEnd) ->
      if default-tag tag "EVar" then
        (case default-reference globals bound value of Some name -> Some (EVar sp name); None -> None)
      else if default-tag tag "ELitInt" then Some (ELitInt sp value)
      else if default-tag tag "ELitStr" then Some (ELitStr sp value)
      else if default-tag tag "ELitChar" then Some (ELitChar sp value)
      else None
    JArr (JStr tag) (JArr value JArrEnd) -> case default-expression sp globals bound value of
      Some body -> if default-tag tag "ETuple" then Some (ETuple sp body)
        else if default-tag tag "EList" then Some (EList sp body)
        else if default-tag tag "ENeg" then Some (ENeg sp body) else None
      None -> None
    JArr (JStr tag) (JArr (JStr name) (JArr arguments JArrEnd)) -> if not (default-tag tag "ECon") then None else
      (case (globals name, default-expression sp globals bound arguments) of
        (Some identity, Some args) -> Some (ECon sp identity args)
        other -> None)
    JArr (JStr tag) (JArr first (JArr second JArrEnd)) ->
      if default-tag tag "ELam" then
        (case default-patterns sp globals first of
          Some (patterns, locals) -> (case default-expression sp globals (locals <> bound) second of
            Some body -> Some (ELam sp patterns body)
            None -> None)
          None -> None)
      else if default-tag tag "ELet" then
        (case default-bindings sp globals bound first of
          Some (bindings, locals) -> (case default-expression sp globals locals second of
            Some body -> Some (ELet sp bindings body)
            None -> None)
          None -> None)
      else if default-tag tag "EAnn" then
        (case (default-expression sp globals bound first, default-type sp globals second) of
          (Some body, Some ty) -> Some (EAnn sp body ty)
          other -> None)
      else case (default-expression sp globals bound first, default-expression sp globals bound second) of
        (Some a, Some b) -> if default-tag tag "EApp" then Some (EApp sp a b)
          else if default-tag tag "ECase" then Some (ECase sp a b)
          else if default-tag tag "EArg" then Some (EArg sp a b)
          else if default-tag tag "EGuarded" then Some (EGuarded sp a b)
          else None
        other -> None
    JArr (JStr tag) (JArr first (JArr second (JArr third JArrEnd))) ->
      if default-tag tag "EAlt" then
        (case default-pattern sp globals first of
          Some (pattern, locals) -> (case (default-expression sp globals (locals <> bound) second, default-expression sp globals bound third) of
            (Some body, Some rest) -> Some (EAlt sp pattern body rest)
            other -> None)
          None -> None)
      else if default-tag tag "EIf" then
        (case (default-expression sp globals bound first, default-expression sp globals bound second, default-expression sp globals bound third) of
          (Some test, Some yes, Some no) -> Some (EIf sp test yes no)
          other -> None)
      else if default-tag tag "EBin" then
        (case (first, default-expression sp globals bound second, default-expression sp globals bound third) of
          (JStr op, Some left, Some right) -> Some (EBin sp op left right)
          other -> None)
      else None
    other -> None

  default-bindings :: Span -> (String -> Option String) -> List String -> Json -> Option (Expr, List String)
  default-bindings sp globals bound syntax = case syntax of
    JArr (JStr tag) JArrEnd -> if default-tag tag "EBindingsEnd" then Some (EBindingsEnd sp, bound) else None
    JArr (JStr tag) (JArr (JStr name) (JArr value (JArr rest JArrEnd))) ->
      if not (default-tag tag "EBinding" && default-local name) then None else
        (case (default-expression sp globals bound value, default-bindings sp globals (Cons name bound) rest) of
          (Some rhs, Some (more, locals)) -> Some (EBinding sp name rhs more, locals)
          other -> None)
    other -> None

  portable-law-syntax :: Span -> (String -> Option String) -> Json -> Option LawSyntax
  portable-law-syntax sp globals syntax = decode-law-syntax sp globals Nil syntax

  decode-law-syntax :: Span -> (String -> Option String) -> List String -> Json -> Option LawSyntax
  decode-law-syntax sp globals locals syntax = case syntax of
    JArr (JStr tag) (JArr first (JArr second JArrEnd)) ->
      if default-tag tag "LawForall" then
        (case decode-law-parameters sp globals first of
          Some (Cons first-param more, names) -> (case decode-law-syntax sp globals (names <> locals) second of
            Some body -> Some (LawForall (Cons first-param more) body)
            None -> None)
          other -> None)
      else if default-tag tag "LawEquation" then
        (case (default-expression sp globals locals first, default-expression sp globals locals second) of
          (Some left, Some right) -> Some (LawEquation left right)
          other -> None)
      else None
    JArr (JStr tag) (JArr name (JArr domain (JArr body JArrEnd))) ->
      if not (default-tag tag "LawArrow") then None else
        (case default-type sp globals domain of
          None -> None
          Some ty -> (case name of
            JStr local -> if not (default-local local) then None else
              (case decode-law-syntax sp globals (Cons local locals) body of
                Some more -> Some (LawArrow (TBound sp local ty (TBoundsEnd sp)) more)
                None -> None)
            JNull -> (case decode-law-syntax sp globals locals body of
              Some more -> Some (LawArrow ty more)
              None -> None)
            other -> None))
    other -> None

  decode-law-parameters :: Span -> (String -> Option String) -> Json -> Option (List TypeParam, List String)
  decode-law-parameters sp globals syntax = case syntax of
    JArr (JArr (JStr name) (JArr (JBool flag) (JArr kind JArrEnd))) rest ->
      if not (default-local name) then None else
        (case (decode-law-kind sp globals kind, decode-law-parameters sp globals rest) of
          (Some ann, Some (params, names)) ->
            if default-bound name names then None else Some (Cons (MkTypeParam sp name ann flag) params, Cons name names)
          other -> None)
    JArrEnd -> Some (Nil, Nil)
    other -> None

  decode-law-kind :: Span -> (String -> Option String) -> Json -> Option (Option TypeExpr)
  decode-law-kind sp globals syntax = case syntax of
    JNull -> Some None
    other -> (case default-type sp globals syntax of Some kind -> Some (Some kind); None -> None)

  portable-default-clauses :: Span -> (String -> Option String) -> Json -> Option (List (List Pat, Expr))
  portable-default-clauses sp globals syntax = case syntax of
    JArrEnd -> Some Nil
    JArr (JArr patterns (JArr expression JArrEnd)) rest ->
      (case (default-patterns sp globals patterns, portable-default-clauses sp globals rest) of
        (Some (arguments, bound), Some more) -> (case default-expression sp globals bound expression of
          Some body -> Some (Cons (arguments, body) more)
          None -> None)
        other -> None)
    other -> None
