-- Read a closed interface set before lexing the source's operator chains.
module Bootstrap.Inputs where

  import Bootstrap.Load (LoadedInterface, load-interface-set)
  import Data.Json
  import Data.Path (path-from-string)
  import Effect.Fs (fs-read)
  import Text.Json (parse-json)
  import Text.Parse (ParseOutcome, Parsed, Failed)

  export read-interfaces, embedded-library-home
  export read-interface-references, load-interface-references

  -- Source replacement is reserved for defining homes in the pinned
  -- compiler-owned base package. Ordinary interface collisions still refuse.
  embedded-library-home :: String -> Bool
  embedded-library-home name = embedded-home-member name embedded-homes
  embedded-home-member :: String -> List String -> Bool
  embedded-home-member name homes = case homes of
    Nil -> False
    Cons home rest -> string-compare name home == 0 || embedded-home-member name rest
  embedded-homes :: List String
  embedded-homes =
    ["Data.Core", "Data.Ordering", "Relation.Eq", "Relation.Ord",
    "Algebra.Arithmetic", "Algebra.Bits", "Function.Combinators", "Data.Nat",
    "Data.Int", "Data.Option", "Data.Result", "Data.List",
    "Data.Enum", "Data.Char", "Data.Bool", "Data.Machine",
    "Data.Bytes", "Data.Map", "Data.String", "Data.Json",
    "Data.Producer", "Data.Target", "Data.Path", "Effect.Sequencing",
    "Effect.Concurrent", "Effect.Clock", "Effect.Fs", "Effect.Process",
    "Effect.Io", "Data.FromList", "Data.FromMap", "Text.Show",
    "Data.Sym", "Prelude", "Algebra.Semigroup", "Algebra.Group",
    "Algebra.Semiring", "Algebra.Monoid", "Category.Functor", "Category.Applicative",
    "Category.Monad", "Category.Alternative", "Category.Foldable", "Category.Traversable",
    "Data.Identity", "Data.Const", "Data.Compose", "Data.NonEmpty",
    "Data.Sorted", "Data.NonZero", "Data.Ascii", "Data.Set",
    "Data.Hash", "Text.Codec", "Data.HashMap"]

  field :: String -> Json -> Json
  field name doc = case doc of
    JObj key value rest -> if string-compare name key == 0 then value else field name rest
    other -> JNull

  rows :: Json -> Result String (List (String, String, String))
  rows items = case items of
    JArr (JArr (JStr name) (JArr (JStr hash) (JArr (JStr path) JArrEnd))) rest -> case rows rest of
      Err message -> Err message
      Ok more -> Ok (Cons (name, hash, path) more)
    JArrEnd -> Ok Nil
    other -> Err "malformed interface manifest rows"

  read-files :: forall r. using (io :: Io r) => List (String, String, String) ->{IO r} Result String (List (String, String, Bytes))
  read-files inputs = case inputs of
    Nil -> Ok Nil
    Cons (name, hash, path) rest -> case fs-read (path-from-string path) of
      Err error -> Err (string-concat "cannot read interface: " path)
      Ok src -> case read-files rest of
        Err message -> Err message
        Ok others -> Ok (Cons (name, hash, src) others)

  read-interface-references :: forall r. using (io :: Io r) => String ->{IO r} Result String (List (String, String, String))
  read-interface-references path = case fs-read (path-from-string path) of
    Err error -> Err (string-concat "cannot read interface manifest: " path)
    Ok src -> case parse-json path src of
      Parsed doc Nil -> case field "schema" doc of
        JNum version ->
          if version == 1 then rows (field "interfaces" doc)
          else Err "unsupported interface manifest schema"
        other -> Err "missing interface manifest schema"
      other -> Err "interface manifest is not valid JSON"

  load-interface-references :: forall r. using (io :: Io r) => List (String, String, String) ->{IO r} Result String (List LoadedInterface)
  load-interface-references inputs = case read-files inputs of
    Err message -> Err message
    Ok files -> load-interface-set files

  read-interfaces :: forall r. using (io :: Io r) => String ->{IO r} Result String (List LoadedInterface)
  read-interfaces path = case read-interface-references path of
    Err message -> Err message
    Ok inputs -> load-interface-references inputs
