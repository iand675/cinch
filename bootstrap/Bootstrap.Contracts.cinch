-- Checked interfaces become parsing headers and external declarations.
-- The defining identity is independent of an importer's alias. Full
-- module contracts remain in the resolved program for later consumers.
module Bootstrap.Contracts where

  import Bootstrap.Ast
  import Bootstrap.Builtin (builtin-syntax-metadata)
  import Bootstrap.Load
  import Bootstrap.Parse (parse-scheme)
  import Bootstrap.Nominal (interface-global, resolved-text, qualify-resolved, encode-identity, global-data-core-cons, global-data-core-nil, global-data-fromlist-fromlist, global-data-fromlist-fromlist-from-list)
  import Bootstrap.Report (Diagnostic, MkDiagnostic)
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Data.Json
  import Text.Lex (Span)
  import Text.Parse (ParseOutcome, Parsed, Failed)
  import Algebra.Semigroup

  export interface-headers, interface-declarations, public-global
  export materialize-externals, reference-index, referenced, declaration-references, expr-references, imported-class-references, kernel-references

  same :: String -> String -> Bool
  same a b = string-compare a b == 0

  zero :: Span
  zero = Span 0 0 1 1

  public-global :: LoadedInterface -> String -> String
  public-global i name = case loaded-identities i name of
    Cons identity Nil -> interface-global identity
    other -> pack (Cons 'o' (Cons '.' (encode-identity (unpack (loaded-module i)) (Cons '.' (encode-identity (unpack name) Nil)))))

  entries :: LoadedInterface -> List (String, String, String) -> List Decl
  entries i names = case names of
    Nil -> Nil
    Cons (name, kind, identity) rest -> case loaded-entry i kind identity of
      Some metadata -> Cons (DExternal zero name kind None metadata) (entries i rest)
      None -> Cons (DUnmodeled zero (string-concat "missing exported metadata for " identity)) (entries i rest)

  fixities :: List (String, String, Nat) -> List Decl
  fixities rows = case rows of
    Nil -> Nil
    Cons (op, assoc, prec) rest -> Cons (DFixity zero
      (if same assoc "left" then "infixl" else if same assoc "right" then "infixr" else "infix")
      prec (Cons op Nil)) (fixities rest)

  interface-headers :: List LoadedInterface -> List Module
  interface-headers interfaces = case interfaces of
    Nil -> Nil
    Cons i rest -> Cons (MkModule zero (loaded-module i) (decl-spine zero
      (entries i (loaded-exports i) <> fixities (loaded-fixities i)))) (interface-headers rest)

  declarations :: LoadedInterface -> List (String, String, String) -> List Decl
  declarations i exports = case exports of
    Nil -> Nil
    Cons (name, kind, identity) rest -> case loaded-entry i kind identity of
      None -> Cons (DUnmodeled zero (string-concat "missing exported metadata for " identity)) (declarations i rest)
      Some metadata -> Cons (DExternal zero (interface-global identity) kind None metadata) (declarations i rest)

  interface-declarations :: LoadedInterface -> List Decl
  -- Canonical private slots may be reached by checked defaults and laws.
  -- Imported source names still come exclusively from loaded-exports.
  interface-declarations i = Cons (DInterface zero (loaded-module i) (loaded-hash i) (loaded-contract i))
    (declarations i (loaded-exports i <> loaded-private-methods i)
      <> overloads i (loaded-exports i) Nil)

  overloads :: LoadedInterface -> List (String, String, String) -> List String -> List Decl
  overloads i exports seen = case exports of
    Nil -> Nil
    Cons (name, kind, identity) rest -> if has name seen then overloads i rest seen
      else (case loaded-identities i name of
        Cons first (Cons second more) -> Cons (DExternal zero (public-global i name) "overload" None
          (candidate-json (loaded-identities i name))) Nil
        other -> Nil) <> overloads i rest (Cons name seen)

  candidate-json :: List String -> Json
  candidate-json candidates = case candidates of Nil -> JArrEnd; Cons id rest -> JArr (JStr id) (candidate-json rest)

  field :: String -> Json -> Json
  field name doc = case doc of
    JObj key value rest -> if same name key then value else field name rest
    other -> JNull

  has :: String -> List String -> Bool
  has name names = case names of Nil -> False; Cons n rest -> same name n || has name rest

  -- Membership in the reference list, built once. The list holds every
  -- symbol the program mentions (tens of thousands), and the passes below
  -- ask it once per imported declaration (thousands), so a scan per
  -- question is the quadratic pass: two billion `string-compare` calls on
  -- the compiler's own source. One table turns each question into a hash
  -- probe, and the hash is the digest the keyed structures already pay.
  -- INVARIANT: the fold is tail recursive. The list holds every reference
  -- the program mentions (hundreds of thousands on the compiler's own
  -- source), and a frame that kept the map across the recursion would
  -- overflow the stack long before it finished.
  reference-index :: List String -> HashMap String Bool
  reference-index names = reference-index-from names hash-map-empty

  reference-index-from :: List String -> HashMap String Bool -> HashMap String Bool
  reference-index-from names index = case names of
    Nil -> index
    Cons name rest -> reference-index-from rest (hash-map-insert name True index)

  referenced :: String -> HashMap String Bool -> Bool
  referenced name index = case hash-map-lookup name index of
    Some _ -> True
    None -> False

  materialize-externals :: HashMap String Bool -> List Decl -> List (String, String) -> (List Decl, List Diagnostic)
  materialize-externals references ds seen = materialize-externals-from references (seen-index seen) ds

  materialize-externals-from :: HashMap String Bool -> HashMap String (List String) -> List Decl -> (List Decl, List Diagnostic)
  materialize-externals-from references seen ds = case ds of
    Nil -> (Nil, Nil)
    Cons d rest -> case d of
      DExternal s name kind scheme metadata ->
        if not (referenced name references) || seen-entry name kind seen then materialize-externals-from references seen rest
        else case external-type s name kind metadata of
          (ty, errors) -> case materialize-externals-from references (seen-add name kind seen) rest of
            (others, more) -> (Cons (DExternal s name kind ty metadata) others, errors <> more)
      other -> case materialize-externals-from references seen rest of
        (others, errors) -> (Cons d others, errors)

  -- The materialized set is a table by name whose value is the kinds the
  -- name was materialized as: an identity carries one kind, and the pair
  -- is what the scan compared.
  seen-index :: List (String, String) -> HashMap String (List String)
  seen-index seen = case seen of
    Nil -> hash-map-empty
    Cons (name, kind) rest -> seen-add name kind (seen-index rest)

  seen-add :: String -> String -> HashMap String (List String) -> HashMap String (List String)
  seen-add name kind index = case hash-map-lookup name index of
    None -> hash-map-insert name (Cons kind Nil) index
    Some kinds -> hash-map-insert name (Cons kind kinds) index

  seen-entry :: String -> String -> HashMap String (List String) -> Bool
  seen-entry name kind seen = case hash-map-lookup name seen of
    None -> False
    Some kinds -> kind-member kind kinds

  kind-member :: String -> List String -> Bool
  kind-member kind kinds = case kinds of
    Nil -> False
    Cons k rest -> same kind k || kind-member kind rest

  -- A kernel declaration's scheme is compiler-owned text, so nothing in
  -- the source mentions the prelude families it names. A program that uses
  -- the builtin keeps those defining declarations, exactly as a source
  -- mention of the same family would.
  kernel-references :: List String -> List Decl -> List String
  kernel-references used ds = case ds of
    Nil -> Nil
    Cons (DExternal s symbol category ty metadata) rest ->
      (if same category "builtin" && has symbol used then
        (case field "scheme" metadata of
          JStr text -> (case parse-scheme symbol (string-to-bytes text) of
            Parsed scheme Nil -> kernel-canonical-references (type-references scheme)
            other -> Nil)
          other -> Nil)
       else Nil) <> kernel-references used rest
    Cons other rest -> kernel-references used rest
  kernel-canonical-reference :: String -> List String
  kernel-canonical-reference name = if has name ["List", "Option", "Result"] then Cons (interface-global (string-concat "Data.Core." name)) Nil else Nil
  kernel-canonical-references :: List String -> List String
  kernel-canonical-references names = case names of
    Nil -> Nil
    Cons first rest -> kernel-canonical-reference first <> kernel-canonical-references rest

  external-type :: Span -> String -> String -> Json -> (Option TypeExpr, List Diagnostic)
  external-type s name kind metadata =
    if same kind "value" || same kind "constructor" || same kind "method" then case resolved-text metadata of
      Some text -> case parse-scheme name (string-to-bytes text) of
        Parsed ty Nil -> case qualify-resolved metadata ty of (resolved, errors) -> (Some resolved, errors)
        other -> (None, [MkDiagnostic "bootstrap.resolve" s (string-concat "cannot parse resolved scheme for " name)])
      None -> display-type s name kind metadata
    else display-type s name kind metadata

  -- A kernel scheme's `List`, `Option` and `Result` name the prelude's
  -- defining identities, not a bare alias: the kernel owns those families,
  -- and the checker compares against the identity (Infer's
  -- `kernel-canonical-type` states the same rule for its own path).
  canonical-kernel-type :: TypeExpr -> TypeExpr
  canonical-kernel-type syntax = case syntax of
    TName sp name -> if same name "List" || same name "Option" || same name "Result" then TName sp (interface-global (string-concat "Data.Core." name)) else syntax
    TForall sp qs body -> TForall sp qs (canonical-kernel-type body)
    TFun sp domain result -> TFun sp (canonical-kernel-type domain) (canonical-kernel-type result)
    TApp sp head args -> TApp sp (canonical-kernel-type head) (canonical-kernel-arguments args)
    TTuple sp fields -> TTuple sp (canonical-kernel-arguments fields)
    other -> syntax
  canonical-kernel-arguments :: TypeExpr -> TypeExpr
  canonical-kernel-arguments args = case args of TArg sp ty rest -> TArg sp (canonical-kernel-type ty) (canonical-kernel-arguments rest); other -> args
  syntax-without-scheme :: String -> Bool
  syntax-without-scheme name = case builtin-syntax-metadata name of
    Some owned -> (case field "scheme" owned of JStr text -> False; other -> True)
    None -> False
  display-type :: Span -> String -> String -> Json -> (Option TypeExpr, List Diagnostic)
  display-type s name kind metadata =
    -- The owning kernel declaration decides whether syntax has a scheme.
    -- Infer checks the supplied metadata against that declaration.
    if same kind "builtin-syntax" && syntax-without-scheme name then (None, Nil)
    else if same kind "value" || same kind "constructor" || same kind "method" || same kind "builtin" || same kind "builtin-syntax" || same kind "builtin-constructor" then case field "scheme" metadata of
      JStr text -> case parse-scheme name (string-to-bytes text) of
        Parsed ty Nil -> (Some (canonical-kernel-type ty), Nil)
        other -> (None, Cons (MkDiagnostic "bootstrap.resolve" s (string-concat "cannot parse imported scheme for " name)) Nil)
      other -> (None, Cons (MkDiagnostic "bootstrap.resolve" s (string-concat "missing imported scheme for " name)) Nil)
    else (None, Nil)

  type-references :: TypeExpr -> List String
  type-references ty = case ty of
    TName s name -> Cons name Nil
    TNegate s x -> type-references x
    TIndexLambda s name body -> type-references body
    TInfix s op a b -> type-references a <> type-references b
    TRefined s p t -> type-references p <> type-references t
    TApp s f args -> type-references f <> type-references args
    TFun s a b -> type-references a <> type-references b
    TFunEff s a row b -> type-references a <> type-references row <> type-references b
    TUsageArrow s usage arrow -> type-references arrow
    TRow s labels tail -> type-references labels
    TTuple s args -> type-references args
    TForall s binders body -> type-references binders <> type-references body
    TQuantifier s name only kind rest -> type-references kind <> type-references rest
    TUsing s bounds body -> type-references bounds <> type-references body
    TArg s x rest -> type-references x <> type-references rest
    TBound s name kind rest -> type-references kind <> type-references rest
    TEvidenceField s name ty -> type-references ty
    other -> Nil

  pat-references :: Pat -> List String
  pat-references p = case p of
    PCon s name args -> Cons name (pat-references args)
    PRecord s name fields -> Cons name (pat-references fields)
    PRecordField s name value rest -> pat-references value <> pat-references rest
    PTuple s args -> pat-references args
    PList s args -> [global-data-core-nil, global-data-core-cons] <> pat-references args
    PAs s name inner -> pat-references inner
    PAnn s inner ty -> pat-references inner <> type-references ty
    PArg s x rest -> pat-references x <> pat-references rest
    other -> Nil

  patterns-references :: List Pat -> List String
  patterns-references ps = case ps of Nil -> Nil; Cons p rest -> pat-references p <> patterns-references rest

  expr-references :: Expr -> List String
  expr-references e = case e of
    EVar s name -> Cons name Nil
    -- The resolver keeps the bare predicate name only inside kernel decide.
    -- Elaborating that test needs the checked list constructors in scope.
    ECon s name args | same name "NotNull" ->
      [global-data-core-nil, global-data-core-cons] <> expr-references args
    ECon s name args -> Cons name (expr-references args)
    ERecord s name fields -> Cons name (expr-references fields)
    ERecordField s name value rest -> expr-references value <> expr-references rest
    EProject s value name -> expr-references value
    ETuple s args -> expr-references args
    EList s args -> [global-data-core-nil, global-data-core-cons, global-data-fromlist-fromlist-from-list] <> expr-references args
    EApp s f a -> expr-references f <> expr-references a
    EBin s op a b -> expr-references a <> expr-references b
    ENeg s x -> expr-references x
    ELam s ps body -> patterns-references ps <> expr-references body
    ELet s bs body -> expr-references bs <> expr-references body
    ELetScope sp body -> expr-references body
    ELocalGroup sp bindings body -> expr-references bindings <> expr-references body
    ELetRec sp bindings body -> expr-references bindings <> expr-references body
    ELocalStrict sp pattern value rest -> pat-references pattern <> expr-references value <> expr-references rest
    ELocalMemo sp name value rest -> expr-references value <> expr-references rest
    ELocalSignature sp name ty rest -> type-references ty <> expr-references rest
    EIf s c a b -> expr-references c <> expr-references a <> expr-references b
    ECase s value alts -> expr-references value <> expr-references alts
    EGuarded s guard body -> expr-references guard <> expr-references body
    EAnn s body ty -> expr-references body <> type-references ty
    EWith s bs body -> expr-references bs <> expr-references body
    EDo s statements -> expr-references statements
    EBind s name rhs -> expr-references rhs
    EHandle s body handled-by -> expr-references body <> expr-references handled-by
    EHandler s label clauses -> type-references label <> expr-references clauses
    EHandlerClause s name pats continuation body rest -> (if same name "return" then Nil else Cons name Nil)
      <> patterns-references pats <> expr-references body <> expr-references rest
    EQuote s body -> expr-references body
    EArg s x rest -> expr-references x <> expr-references rest
    EBinding s name rhs rest -> expr-references rhs <> expr-references rest
    EAlt s pat rhs rest -> pat-references pat <> expr-references rhs <> expr-references rest
    other -> Nil

  clause-references :: List (List Pat, Expr) -> List String
  clause-references clauses = case clauses of
    Nil -> Nil
    Cons (ps, body) rest -> patterns-references ps <> expr-references body <> clause-references rest

  defined-instance-method :: String -> List Decl -> Bool
  defined-instance-method name members = case members of
    Nil -> False
    Cons (DFun sp member clauses) rest -> same name member || defined-instance-method name rest
    Cons other rest -> defined-instance-method name rest

  default-method-references :: List Decl -> Json -> List String
  default-method-references members methods = case methods of
    JArr method rest ->
      let more = default-method-references members rest in
      (case field "name" method of
        JStr name -> if defined-instance-method name members then more else
          (case portable-default-clauses zero (\identity -> Some identity) (field "default" method) of
            Some clauses -> clause-references clauses <> more
            None -> more)
        other -> more)
    other -> Nil

  defining-class-contract :: String -> Json -> Option Json
  defining-class-contract owner classes = case classes of
    JArr description rest -> (case field "identity" description of
      JStr identity -> if same owner (interface-global identity) then Some description
        else defining-class-contract owner rest
      other -> defining-class-contract owner rest)
    other -> None

  imported-class-contract :: String -> List Decl -> Option Json
  imported-class-contract owner ds = case ds of
    Nil -> None
    Cons (DInterface s name hash metadata) rest ->
      (case defining-class-contract owner (field "signatures" (field "exports" metadata)) of
        Some methods -> Some methods
        None -> imported-class-contract owner rest)
    Cons other rest -> imported-class-contract owner rest

  instance-class-name :: TypeExpr -> Option String
  instance-class-name ty = case ty of
    TName sp name -> Some name
    TApp sp f args -> instance-class-name f
    TForall sp params body -> instance-class-name body
    TUsing sp requirements body -> instance-class-name body
    other -> None

  imported-law-references :: Json -> List String
  imported-law-references laws = case laws of
    JArr row rest -> (case portable-law-syntax zero (\identity -> Some identity) (field "syntax" row) of
      Some syntax -> law-references syntax
      None -> Nil) <> imported-law-references rest
    other -> Nil

  -- The source instance needs bindings for its class laws and omitted
  -- default methods. Loading an unrelated interface has no runtime demand.
  imported-class-references :: List Decl -> List Decl -> List String
  imported-class-references all ds = case ds of
    Nil -> Nil
    Cons (DInstance sp flag name params head members) rest ->
      (case instance-class-name head of
        Some owner -> (case imported-class-contract owner all of
          Some row -> default-method-references (decls-of members) (field "methods" row)
            <> imported-law-references (field "laws" row)
          None -> Nil)
        None -> Nil) <> imported-class-references all rest
    Cons other rest -> imported-class-references all rest

  ctor-references :: List (String, TypeExpr) -> List String
  ctor-references ctors = case ctors of Nil -> Nil; Cons (name, ty) rest -> type-references ty <> ctor-references rest

  param-references :: List TypeParam -> List String
  param-references params = case params of
    Nil -> Nil
    Cons p rest -> (case param-kind p of None -> Nil; Some ty -> type-references ty) <> param-references rest

  -- Keep the recursive list frame small. Putting this declaration match
  -- inside the traversal reserves every branch's native slots for every
  -- declaration still on the stack while collecting the following ones.
  law-references :: LawSyntax -> List String
  law-references syntax = case syntax of
    LawForall parameters rest -> param-references parameters <> law-references rest
    LawArrow domain rest -> type-references domain <> law-references rest
    LawEquation left right -> expr-references left <> expr-references right
    LawProposition ty -> type-references ty

  rewrite-proof-references :: RewriteJustification -> List String
  rewrite-proof-references evidence = case evidence of
    RewriteTerm expression -> expr-references expression
    RewriteLaw at owner member args -> Cons owner (expr-references (expr-spine at args))

  declaration-reference :: Decl -> List String
  declaration-reference d = case d of
    DProof sp body -> declaration-reference body
    DCorec sp body -> declaration-reference body
    DSig s name ty -> type-references ty
    DMethod s label name ty -> type-references ty
    DLaw s name syntax -> law-references syntax
    DRewrite s name (MkRewriteSyntax targeted params bounds pattern replacement guard evidence) ->
      param-references params <> type-references bounds <> expr-references pattern <> expr-references replacement
      <> (case guard of Some condition -> expr-references condition; None -> Nil)
      <> rewrite-proof-references evidence
    DClass s name params members -> param-references params <> declaration-references (decls-of members)
    DFun s name clauses -> clause-references clauses
    DOpaque s name params kind -> param-references params <> type-references kind
    DData s name params ctors -> param-references params <> ctor-references ctors
    DRecord s name params fields -> param-references params <> ctor-references fields
    DCodata s name params observations -> param-references params <> ctor-references observations
    DEffect s name params ops -> param-references params <> ctor-references ops
    DInstance s only name params class-app members -> param-references params <> type-references class-app <> declaration-references (decls-of members)
    DForeign s direction abi symbol name ty -> type-references ty <> (if same direction "export" then Cons name Nil else Nil)
    DPrim s name ty bodies -> type-references ty <> prim-body-references bodies
    -- A temporal contract's formulas are checked as ordinary terms over the
    -- definition's parameters (core specification section 10), so every
    -- global they name is a name the module uses: the comparison a formula
    -- spells `<` resolves to a loaded interface's method, and that method's
    -- external declaration has to be materialized and registered exactly as
    -- a body's own `<` materializes it. Leaving the formula out of the
    -- reference set left the method unbound in the environment the formula
    -- is checked in.
    DContract s keyword name subject clauses -> contract-clause-references clauses
    other -> Nil

  contract-clause-references :: List ContractClause -> List String
  contract-clause-references clauses = case clauses of
    Nil -> Nil
    Cons first rest -> case first of
      ContractFormula s op body -> expr-references body <> contract-clause-references rest
      ContractAssume s body -> expr-references body <> contract-clause-references rest
      ContractAssumed s text -> contract-clause-references rest

  prim-body-references :: List PrimBody -> List String
  prim-body-references bodies = case bodies of
    Nil -> Nil
    Cons (MkPrimBody sp family fragment unverified condition justification uses immediates) rest ->
      ctor-references uses <> (case justification of Some evidence -> expr-references evidence; None -> Nil) <> prim-body-references rest

  declaration-references :: List Decl -> List String
  declaration-references ds = case ds of
    Nil -> Nil
    Cons d rest -> declaration-reference d <> declaration-references rest
