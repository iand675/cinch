-- Checked pure terms. No surface expression is retained here: applications,
-- binders and constructor fields carry their inferred types, and each use
-- records the type arguments chosen by rank-one instantiation.
-- Effects, evidence and erasure need further core forms before acceptance.
module Bootstrap.Core where

  import Bootstrap.Index
  import Bootstrap.Type
  import Bootstrap.Nominal (interface-global, global-data-core-cons, global-data-core-nil, global-data-core-result, global-data-ordering-eq, global-data-ordering-gt, global-data-ordering-lt, global-data-ordering-ordering)
  import Bootstrap.Proof
  import Bootstrap.Total
  import Bootstrap.TotalSemantics (total-numeric-reading, total-bytes-reading, total-boolean-reading, total-numeric-operation, total-numeric-comparison, total-boolean-negation)
  import Bootstrap.BodyContract
  import Bootstrap.Guarded
  import Bootstrap.ExportType (export-global)
  import Data.Json
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)
  import Text.Json (canonical-bytes)
  import Data.Nat (nat-to-int)
  import Text.Lex (Span)
  import Algebra.Semigroup

  export scoped-core-case-facts, scoped-core-case-rest-facts, core-alternative-covers, opening-value-types, opening-value-patterns
  export CorePattern, CPWild, CPProof, CPErasedValue, CPVar, erased-pattern, CPAs, CPConstructor, CPInt, CPString, CPChar, CPTuple, CPField, CPDone
  export CoreTerm, CUse, CLocal, CInt, CString, CChar, CUnit, CApply, CLambda, CPolyIntro, CPolyElim, CLet, CIf, CCase, CTuple, CPrimitive, CGuard
