  export CoreEffect, MkCoreEffect, CoreOperation, MkCoreOperation
  export core-effect-name, core-effect-kind, core-effect-params, core-effect-operations
  export core-operation-name, core-operation-scheme, core-operation-slot, core-effect-closed

  -- A source effect is a typed declaration, not an unchecked foreign value.
  -- Operation order is the handler dispatch order, including private slots.
  data CoreOperation where
    MkCoreOperation :: Span -> String -> Nat -> Scheme -> CoreOperation
  data CoreEffect where
    MkCoreEffect :: Span -> String -> Kind -> List Quant -> List CoreOperation -> CoreEffect
  core-effect-name :: CoreEffect -> String
  core-effect-name d = case d of MkCoreEffect s name kind qs ops -> name
  core-effect-kind :: CoreEffect -> Kind
  core-effect-kind d = case d of MkCoreEffect s name kind qs ops -> kind
  core-effect-params :: CoreEffect -> List Quant
  core-effect-params d = case d of MkCoreEffect s name kind qs ops -> qs
  core-effect-operations :: CoreEffect -> List CoreOperation
  core-effect-operations d = case d of MkCoreEffect s name kind qs ops -> ops
  core-operation-name :: CoreOperation -> String
  core-operation-name op = case op of MkCoreOperation s name slot sc -> name
  core-operation-slot :: CoreOperation -> Nat
  core-operation-slot op = case op of MkCoreOperation s name slot sc -> slot
  core-operation-scheme :: CoreOperation -> Scheme
  core-operation-scheme op = case op of MkCoreOperation s name slot sc -> sc
  effect-kind :: List Quant -> Kind
  effect-kind qs = case qs of Nil -> KEffect; Cons q rest -> KFun (quant-kind q) (effect-kind rest)
  effect-label :: String -> Kind -> List Quant -> UType
  effect-label name kind qs = effect-arguments (UCon name kind) qs
  effect-arguments :: UType -> List Quant -> UType
  effect-arguments head qs = case qs of Nil -> head; Cons q rest -> effect-arguments (UApp head (UBound (quant-id q) (quant-name q) (quant-kind q))) rest
  effect-quant :: Nat -> List Quant -> Option Quant
  effect-quant id qs = case qs of Nil -> None; Cons q rest -> if id == quant-id q then Some q else effect-quant id rest
  effect-quant-name :: String -> List Quant -> Bool
  effect-quant-name name qs = case qs of Nil -> False; Cons q rest -> string-compare name (quant-name q) == 0 || effect-quant-name name rest
  effect-kind-scope :: List Quant -> Kind -> Bool
  effect-kind-scope qs kind = valid-kind kind && (case kind of
    KValue payload -> (case value-carrier kind of Some ty -> effect-type-scope qs ty; None -> False)
    KFun a b -> effect-kind-scope qs a && effect-kind-scope qs b
    other -> True)
  effect-quants-scoped :: List Quant -> List Quant -> Bool
  effect-quants-scoped qs bound = case qs of
    Nil -> True
    Cons q rest -> (case effect-quant (quant-id q) bound of Some old -> False; None -> True)
      && not (effect-quant-name (quant-name q) bound) && effect-kind-scope bound (quant-kind q)
      && effect-quants-scoped rest (Cons q bound)
  effect-binder :: List Quant -> Nat -> String -> UType -> UType -> Bool
  effect-binder qs id name carrier body = (case effect-quant id qs of Some q -> False; None -> True)
    && effect-proper-value carrier && effect-type-scope qs carrier && effect-type-scope (Cons (MkQuant id name (value-kind carrier) False) qs) body
  effect-index-scope :: List Quant -> UType -> IndexTerm -> Bool
  effect-index-scope qs carrier value = case value of
    IInteger n -> integer-literal-valid carrier n
    IBound id name -> case effect-quant id qs of
      Some q -> (case value-carrier (quant-kind q) of Some declared -> contract-equal carrier declared; None -> False)
      None -> False
    IAdd a b -> effect-index-scope qs carrier a && effect-index-scope qs carrier b
    ISubtract a b -> effect-index-scope qs carrier a && effect-index-scope qs carrier b
    IMultiply a b -> effect-index-scope qs carrier a && effect-index-scope qs carrier b
    other -> False
  effect-proper-value :: UType -> Bool
  effect-proper-value ty = kind-equal (type-kind ty) KType && valid-kind (value-kind ty)
  effect-type-scope :: List Quant -> UType -> Bool
  effect-type-scope qs ty = case ty of
    UBound id name kind -> case effect-quant id qs of Some q -> kind-equal kind (quant-kind q) && effect-kind-scope qs kind; None -> False
    UCon name kind -> effect-kind-scope Nil kind
    URigid id name level kind -> False
    UMeta id kind -> False
    UError -> False
    UIndex carrier value -> effect-type-scope qs carrier && effect-index-scope qs carrier value
    UIndexForget value -> effect-type-scope qs value
    UIndexPromote value -> effect-type-scope qs value
    UIndexByteLength value -> effect-type-scope qs value
    UIndexBorrowRead value -> effect-type-scope qs value
    UIndexList element fields -> effect-type-scope qs element && effect-type-scope qs fields
    UIndexCall function args -> effect-type-scope qs args
    UIndexMath op a b -> effect-type-scope qs a && effect-type-scope qs b
    URefine id name carrier predicate -> effect-binder qs id name carrier predicate
    URefineFormer name ids body -> valid-type ty && effect-type-scope (refinement-formals ids) body
    UPi id name domain row result -> effect-binder qs id name domain (UArg row (UArg result UEnd))
    UApp a b -> effect-type-scope qs a && effect-type-scope qs b
    UFun a b -> effect-proper-value a && effect-proper-value b && effect-type-scope qs a && effect-type-scope qs b
    UFunEff a row b -> effect-proper-value a && effect-proper-value b && effect-type-scope qs a && effect-type-scope qs row && effect-type-scope qs b
    UUsageArrow usage arrow -> valid-type ty && effect-type-scope qs arrow
    UProofFun a row b -> valid-type a && kind-equal (type-kind a) KProp && effect-proper-value b && effect-type-scope qs a && effect-type-scope qs row && effect-type-scope qs b
    URow labels -> effect-type-scope qs labels
    URowJoin a b -> effect-type-scope qs a && effect-type-scope qs b
    UTuple fields -> effect-type-scope qs fields
    UForall inner body -> effect-type-scope (qs <> inner) body
    UArg a rest -> effect-type-scope qs a && effect-type-scope qs rest
    UCompare relation a b -> effect-type-scope qs a && effect-type-scope qs b
    UPropAnd a b -> effect-type-scope qs a && effect-type-scope qs b
    UPropOr a b -> effect-type-scope qs a && effect-type-scope qs b
    UPropNot body -> effect-type-scope qs body
    UPropNonZero body -> effect-type-scope qs body
    UPropNotNull body -> effect-type-scope qs body
    UPropAscii body -> effect-type-scope qs body
    UPropOrdered body -> effect-type-scope qs body
    UPropNonZeroPending body -> effect-type-scope qs body
    URequire predicates body -> effect-type-scope qs predicates && effect-type-scope qs body
    UPropLit value -> True
    UEnd -> True
  effect-requirements :: List Quant -> List Requirement -> Bool
  effect-requirements qs rs = case rs of Nil -> True; Cons r rest -> effect-type-scope qs (requirement-type r) && effect-requirements qs rest
  effect-parameter-prefix :: List Quant -> List Quant -> Bool
  effect-parameter-prefix owner actual = case owner of
    Nil -> True
    Cons q rest -> case actual of
      Cons a more -> quant-id q == quant-id a && kind-equal (quant-kind q) (quant-kind a)
        && quant-implicit q == quant-implicit a && string-compare (quant-name q) (quant-name a) == 0
        && effect-parameter-prefix rest more
      Nil -> False
  operation-function :: UType -> Bool
  operation-function ty = case arrow-shape ty of UFun a b -> True; UFunEff a row b -> True; UProofFun p row b -> True; UPi id name a row b -> True; other -> False
  operation-effects :: UType -> UType -> Bool
  operation-effects label ty = case arrow-shape ty of
    UFun a b -> operation-effects label b
    UFunEff a row b -> operation-row label row b
    UProofFun predicate row result -> operation-row label row result
    UPi id name a row b -> operation-row label row b
    other -> False
  operation-row :: UType -> UType -> UType -> Bool
  operation-row label row result = if operation-function result then
    contract-equal row (URow UEnd) && operation-effects label result
    else contract-equal row (URow (UArg label UEnd))
  effect-operations-closed :: String -> Kind -> List Quant -> Nat -> List String -> List CoreOperation -> Bool
  effect-operations-closed name kind qs next names ops = case ops of
    Nil -> True
    Cons op rest -> let sc = core-operation-scheme op in let all = scheme-params sc in
      core-operation-slot op == next
      && not (effect-operation-seen (core-operation-name op) names)
      && scheme-closed sc && valid-type (scheme-body sc) && scheme-index-scope Nil sc && effect-quants-scoped all Nil
      && effect-parameter-prefix qs all && effect-type-scope all (scheme-body sc)
      && effect-requirements all (scheme-requirements sc)
      && operation-effects (effect-label name kind qs) (scheme-body sc)
      && effect-operations-closed name kind qs (next + 1) (Cons (core-operation-name op) names) rest
  effect-operation-seen :: String -> List String -> Bool
  effect-operation-seen name names = case names of Nil -> False; Cons n rest -> string-compare name n == 0 || effect-operation-seen name rest
  core-effect-closed :: CoreEffect -> Bool
  core-effect-closed declaration = case declaration of
    MkCoreEffect s name kind qs ops -> string-length name > 0 && effect-quants-scoped qs Nil
      && closed-quants qs && kind-equal kind (effect-kind qs)
      && (case ops of Nil -> False; Cons op rest -> True)
      && effect-operations-closed name kind qs 1 Nil ops

  -- Source declarations retain every constructor, including private ones.
  -- Export visibility stays in the module contexts. Imported declarations
  -- remain checked interface contracts, not reconstructed source data.
  data CoreConstructor where
    MkCoreConstructor :: Span -> String -> Scheme -> CoreConstructor
  data CoreData where
    MkCoreData :: Span -> String -> Kind -> List Quant -> List CoreConstructor -> CoreData

  core-data-name :: CoreData -> String
  core-data-name d = case d of MkCoreData s name k qs constructors -> name
  core-data-kind :: CoreData -> Kind
  core-data-kind d = case d of MkCoreData s name k qs constructors -> k
  core-data-params :: CoreData -> List Quant
  core-data-params d = case d of MkCoreData s name k qs constructors -> qs
  core-data-constructors :: CoreData -> List CoreConstructor
  core-data-constructors d = case d of MkCoreData s name k qs constructors -> constructors
  core-constructor-name :: CoreConstructor -> String
  core-constructor-name c = case c of MkCoreConstructor s name sc -> name
  core-constructor-scheme :: CoreConstructor -> Scheme
  core-constructor-scheme c = case c of MkCoreConstructor s name sc -> sc
  constructor-fields :: UType -> List UType
  constructor-fields ty = case ty of UPi id name a row b -> Cons a (constructor-fields b); UFun a b -> Cons a (constructor-fields b); UProofFun predicate row result -> constructor-fields result; other -> Nil
  core-constructor-fields :: CoreConstructor -> List UType
  core-constructor-fields c = constructor-fields (scheme-body (core-constructor-scheme c))
  constructors-closed :: List CoreConstructor -> Bool
  constructors-closed cs = case cs of
    Nil -> True
    Cons c rest -> scheme-closed (core-constructor-scheme c) && scheme-index-scope Nil (core-constructor-scheme c) && constructors-closed rest
  core-data-closed :: CoreData -> Bool
  core-data-closed d = constructors-closed (core-data-constructors d)

  data CorePattern where
    CPWild :: Span -> UType -> CorePattern
    CPVar :: Span -> UType -> Nat -> String -> CorePattern
    -- Proof binders never introduce a runtime local or value index.
    CPProof :: Span -> UType -> Nat -> String -> CorePattern
    CPErasedValue :: Span -> UType -> Nat -> String -> CorePattern
    CPAs :: Span -> UType -> Nat -> String -> CorePattern -> CorePattern
    CPConstructor :: Span -> UType -> String -> List UType -> UType -> CorePattern -> CorePattern
    CPInt :: Span -> UType -> String -> CorePattern
    CPString :: Span -> UType -> String -> CorePattern
    CPChar :: Span -> UType -> String -> CorePattern
    CPTuple :: Span -> UType -> CorePattern -> CorePattern
    CPField :: Span -> CorePattern -> CorePattern -> CorePattern
    CPDone :: Span -> CorePattern

  -- Dictionary binders have stable internal symbols, independent of the
  -- source spelling that a nested local declaration may shadow.
  data CoreGiven where
    CGiven :: Span -> String -> UType -> CoreGiven
  given-symbol :: CoreGiven -> String
  given-symbol given = case given of CGiven s name ty -> name
  given-type :: CoreGiven -> UType
  given-type given = case given of CGiven s name ty -> ty
  data CoreEvidence where
    CENeeded :: Span -> UType -> List CoreGiven -> CoreEvidence
    CEGiven :: Span -> UType -> String -> CoreEvidence
    CEInstance :: Span -> UType -> String -> List UType -> CoreEvidence -> CoreEvidence
    CEArgument :: Span -> CoreEvidence -> CoreEvidence -> CoreEvidence
    CEArgumentsEnd :: Span -> CoreEvidence
  evidence-type :: CoreEvidence -> UType
  evidence-type evidence = case evidence of CENeeded s ty scope -> ty; CEGiven s ty name -> ty; CEInstance s ty name actuals args -> ty; other -> UError
  map-givens :: (UType -> UType) -> List CoreGiven -> List CoreGiven
  map-givens f givens = case givens of Nil -> Nil; Cons (CGiven s name ty) rest -> Cons (CGiven s name (f ty)) (map-givens f rest)
  map-evidence :: (UType -> UType) -> CoreEvidence -> CoreEvidence
  map-evidence f evidence = case evidence of
    CENeeded s ty scope -> CENeeded s (f ty) (map-givens f scope)
    CEGiven s ty name -> CEGiven s (f ty) name
    CEInstance s ty name actuals args -> CEInstance s (f ty) name (map-types f actuals) (map-evidence f args)
    CEArgument s arg rest -> CEArgument s (map-evidence f arg) (map-evidence f rest)
    CEArgumentsEnd s -> evidence
  map-evidences :: (UType -> UType) -> List CoreEvidence -> List CoreEvidence
  map-evidences f evidences = case evidences of Nil -> Nil; Cons evidence rest -> Cons (map-evidence f evidence) (map-evidences f rest)

  data CoreTerm where
    CUse :: Span -> UType -> String -> String -> List UType -> CoreTerm
    CLocal :: Span -> UType -> Nat -> String -> List UType -> CoreTerm
    CProofRef :: Span -> UType -> Nat -> String -> CoreTerm
    CProofRefl :: Span -> UType -> CoreTerm
    CProofSearch :: Span -> UType -> Bool -> Proof -> CoreTerm
    CQualifiedUse :: Span -> UType -> String -> String -> List UType -> List CoreEvidence -> CoreTerm
    CMethod :: Span -> UType -> String -> String -> Nat -> List UType -> List CoreEvidence -> CoreTerm
    CInt :: Span -> UType -> String -> CoreTerm
    CString :: Span -> UType -> String -> CoreTerm
    CChar :: Span -> UType -> String -> CoreTerm
    CUnit :: Span -> UType -> CoreTerm
    CApply :: Span -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    CApplyEff :: Span -> UType -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    CErasedApply :: Span -> UType -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    -- The test is executable; the proposition is checked against that
    -- exact test in the actual value scope before it can justify a branch.
    CDecision :: Span -> UType -> UType -> CoreTerm -> CoreTerm
    CScope :: Span -> UType -> UType -> CoreEvidence -> CoreTerm -> CoreTerm
    CMemoScope :: Span -> UType -> UType -> CoreTerm -> CoreTerm
    CSpawn :: Span -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    CJoin :: Span -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    CWith :: Span -> UType -> CoreGiven -> CoreTerm -> CoreTerm -> CoreTerm
    CHandler :: Span -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    CHandle :: Span -> UType -> UType -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    CHandlerOperation :: Span -> Nat -> List (Nat, UType) -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    CHandlerEnd :: Span -> CoreTerm
    CLambda :: Span -> UType -> CorePattern -> CoreTerm -> CoreTerm
    CLet :: Span -> UType -> Nat -> String -> Scheme -> CoreTerm -> CoreTerm -> CoreTerm
    CRecursiveFunctions :: Span -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    -- The region belongs to the storage for an explicitly guarded value
    -- knot. It has no Eval effect or demand-time initialization.
    CRecursiveValues :: Span -> UType -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    CRecursiveBinding :: Nat -> String -> CoreTerm -> CoreTerm -> CoreTerm
    CRecursiveBindingsEnd :: CoreTerm
    CIf :: Span -> UType -> CoreTerm -> CoreTerm -> CoreTerm -> CoreTerm
    CCase :: Span -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    CTuple :: Span -> UType -> CoreTerm -> CoreTerm
    -- Generalisation (design/rank-n-polymorphism.md section 8): the body was
    -- checked at the rigid ids, which open the polytype's binders in order.
    -- Its evaluation is pure: it builds one dictionary slot per reached
    -- representation.
    CPolyIntro :: Span -> UType -> List Nat -> CoreTerm -> CoreTerm
    -- Instantiation: the value's polytype opened at the type arguments,
    -- with the opened body as this term's type.
    CPolyElim :: Span -> UType -> CoreTerm -> List UType -> CoreTerm
    CPrimitive :: Span -> UType -> String -> CoreTerm -> CoreTerm
    -- A checked operation obligation. The certificate contains citations,
    -- not an asserted goal or a cached hypothesis list.
    CProved :: Span -> UType -> Proof -> CoreTerm -> CoreTerm
    CRefine :: Span -> UType -> Proof -> CoreTerm -> CoreTerm
    -- Explicit erased evidence is retained and checked in its lexical scope.
    CRefineProof :: Span -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    CForget :: Span -> UType -> CoreTerm -> CoreTerm
    CRequire :: Span -> UType -> CoreTerm -> CoreTerm
    CDischarge :: Span -> UType -> List Proof -> CoreTerm -> CoreTerm
    CGuard :: Span -> UType -> CoreTerm -> CoreTerm -> CoreTerm
    CArgument :: Span -> CoreTerm -> CoreTerm -> CoreTerm
    CArgumentsEnd :: Span -> CoreTerm
    CAlternative :: Span -> CorePattern -> CoreTerm -> CoreTerm -> CoreTerm
    CAlternativesEnd :: Span -> CoreTerm
    CError :: Span -> CoreTerm

  recursive-functions :: CoreTerm -> List CoreTerm
  recursive-functions members = case members of
    CRecursiveBindingsEnd -> Nil
    CRecursiveBinding id name value rest -> Cons value (recursive-functions rest)
    other -> Nil
  recursive-function-ids :: CoreTerm -> List Nat
  recursive-function-ids members = case members of
    CRecursiveBindingsEnd -> Nil
    CRecursiveBinding id name value rest -> Cons id (recursive-function-ids rest)
    other -> Nil
  recursive-member-use :: Nat -> CoreTerm -> Bool
  recursive-member-use id term = case term of
    CLocal sp ty key name actuals -> id == key || recursive-index-use id actuals
    CUse sp ty name role actuals -> recursive-index-use id actuals
    CQualifiedUse sp ty name role actuals evidence -> recursive-index-use id actuals
    CMethod sp ty name owner slot actuals evidence -> recursive-index-use id actuals
    other -> recursive-child-use id (runtime-term-children term)
  recursive-index-use :: Nat -> List UType -> Bool
  recursive-index-use id types = case types of
    Nil -> False
    Cons first rest -> local-id id (type-all-ids first) || recursive-index-use id rest
  recursive-child-use :: Nat -> List CoreTerm -> Bool
  recursive-child-use id terms = case terms of
    Nil -> False
    Cons term rest -> recursive-member-use id term || recursive-child-use id rest
  recursive-captures :: List Nat -> CoreTerm -> Bool
  recursive-captures ids term = case ids of
    Nil -> False
    Cons id rest -> recursive-member-use id term || recursive-captures rest term
  recursive-box-slots :: CoreTerm -> List Nat
  recursive-box-slots members = recursive-slots-from members Nil
  recursive-slots-from :: CoreTerm -> List Nat -> List Nat
  recursive-slots-from members slots = case members of
    CRecursiveBinding id name value rest ->
      recursive-slots-from rest (new-recursive-slots (recursive-function-ids members) value slots)
    other -> slots
  new-recursive-slots :: List Nat -> CoreTerm -> List Nat -> List Nat
  new-recursive-slots pending value slots = case pending of
    Nil -> slots
    Cons id rest -> if not (local-id id slots) && recursive-member-use id value then
      new-recursive-slots rest value (Cons id slots)
      else new-recursive-slots rest value slots

  map-recursive-functions :: (CoreTerm -> CoreTerm) -> CoreTerm -> CoreTerm
  map-recursive-functions f members = case members of
    CRecursiveBindingsEnd -> CRecursiveBindingsEnd
    CRecursiveBinding id name value rest ->
      CRecursiveBinding id name (f value) (map-recursive-functions f rest)
    other -> members
  -- The handler constructor is private to checked Core. The label is the
  -- nominal effect declaration, followed by input, output and clause effects.
  handler-kind :: Kind
  handler-kind = KFun KEffect (KFun KType (KFun KType (KFun KRow KType)))
  handler-type :: UType -> UType -> UType -> UType -> UType
  handler-type label input output row = UApp (UApp (UApp (UApp (UCon "#kernel.Handler" handler-kind) label) input) output) row
  handler-parts :: UType -> Option (UType, UType, UType, UType)
  handler-parts ty = case ty of
    UApp (UApp (UApp (UApp (UCon name kind) label) input) output) row -> if string-compare name "#kernel.Handler" == 0 && kind-equal kind handler-kind then Some (label, input, output, row) else None
    other -> None
  map-handler-openings :: (UType -> UType) -> List (Nat, UType) -> List (Nat, UType)
  map-handler-openings f entries = case entries of Nil -> Nil; Cons (key, ty) rest -> Cons (key, f ty) (map-handler-openings f rest)
  handler-opening-metas :: Store -> List (Nat, UType) -> List (Nat, Kind)
  handler-opening-metas st entries = case entries of Nil -> Nil; Cons (key, ty) rest -> type-metas st ty <> handler-opening-metas st rest
  handler-openings-closed :: List (Nat, UType) -> Bool
  handler-openings-closed entries = case entries of Nil -> True; Cons (key, ty) rest -> closed-type ty && handler-openings-closed rest
  handler-opening-values :: List (Nat, UType) -> List Nat
  handler-opening-values entries = case entries of
    Nil -> Nil
    Cons (key, URigid id name level kind) rest -> if kind-equal kind KRegion || kind-equal kind KType || kind-equal kind KRow || kind-equal kind KEffect then handler-opening-values rest else Cons id (handler-opening-values rest)
    Cons other rest -> handler-opening-values rest
  -- Remove only an explicitly known occurrence. An opaque row variable is
  -- retained: handling one label cannot erase any unknown remaining effects.
  handler-residual :: UType -> UType -> Option UType
  handler-residual label row = if not (valid-type label && kind-equal (type-kind label) KEffect && valid-type row && kind-equal (type-kind row) KRow) then None else case row of
    URow labels -> case handler-residual-labels label labels of Some rest -> Some (URow rest); None -> None
    URowJoin a b -> case (handler-residual label a, handler-residual label b) of (Some x, Some y) -> Some (union-effects x y); other -> None
    UBound id name KRow -> Some row
    URigid id name level KRow -> Some row
    other -> None
  handler-residual-labels :: UType -> UType -> Option UType
  handler-residual-labels label labels = case labels of
    UEnd -> Some UEnd
    UArg first rest -> case handler-residual-labels label rest of Some more -> Some (if contract-equal label first then more else UArg first more); None -> None
    other -> None
  handler-label-arguments :: CoreEffect -> UType -> List UType -> Option (List UType)
  handler-label-arguments declaration label args = case label of
    UApp f x -> handler-label-arguments declaration f (Cons x args)
    UCon name kind -> if string-compare name (core-effect-name declaration) == 0 && kind-equal kind (core-effect-kind declaration) then Some args else None
    other -> None
  handler-parameter-pairs :: List Quant -> List UType -> List (Nat, UType) -> Option (List (Nat, UType))
  handler-parameter-pairs qs args pairs = case (qs, args) of
    (Nil, Nil) -> Some pairs
    (Cons q rest, Cons arg more) -> if valid-type arg && kind-equal (type-kind arg) (map-kind-types (substitute-bound pairs) (quant-kind q)) then handler-parameter-pairs rest more (Cons (quant-id q, arg) pairs) else None
    other -> None
  handler-remaining-params :: List Quant -> List Quant -> List Quant
  handler-remaining-params owner all = case owner of Nil -> all; Cons q rest -> case all of Cons first more -> handler-remaining-params rest more; Nil -> Nil
  handler-operation-scheme :: CoreEffect -> UType -> CoreOperation -> Option Scheme
  handler-operation-scheme declaration label operation = case handler-label-arguments declaration label Nil of
    Some args -> case handler-parameter-pairs (core-effect-params declaration) args Nil of
      Some pairs -> let sc = core-operation-scheme operation in
        case scheme-requirements sc of
          Nil -> Some (map-scheme-types (substitute-bound pairs) (MkScheme (handler-remaining-params (core-effect-params declaration) (scheme-params sc)) (scheme-body sc)))
          other -> None
      None -> None
    None -> None
  -- Operation arguments retain dependent binders and obligations. The
  -- continuation accepts the actual operation result and returns the handler
  -- output; invoking it is pure, as in the shared runtime's deep handlers.
  handler-clause-type :: UType -> UType -> UType -> UType
  handler-clause-type operation output row = case operation of
    UUsageArrow usage arrow -> UUsageArrow usage (handler-clause-type arrow output row)
    UFun a b -> UFun a (handler-clause-type b output row)
    UFunEff a effects b -> if operation-function b then UFun a (handler-clause-type b output row) else UFun a (UFunEff (UFun b output) row output)
    UPi id name a effects b -> if operation-function b then UPi id name a (URow UEnd) (handler-clause-type b output row) else UPi id name a (URow UEnd) (UFunEff (UFun b output) row output)
    UProofFun predicate effects b -> if operation-function b then UProofFun predicate (URow UEnd) (handler-clause-type b output row) else UProofFun predicate (URow UEnd) (UFunEff (UFun b output) row output)
    other -> UError
  handler-row-absent :: UType -> UType -> Bool
  handler-row-absent label row = case row of
    URow labels -> handler-label-absent label labels
    URowJoin a b -> handler-row-absent label a && handler-row-absent label b
    other -> False
  handler-label-absent :: UType -> UType -> Bool
  handler-label-absent label labels = case labels of UEnd -> True; UArg first rest -> not (contract-equal label first) && handler-label-absent label rest; other -> False
  handler-performs :: UType -> UType -> Bool
  handler-performs label row = case row of
    URow labels -> handler-label-present label labels
    URowJoin a b -> handler-performs label a || handler-performs label b
    other -> False
  handler-label-present :: UType -> UType -> Bool
  handler-label-present label labels = case labels of
    UArg first rest -> contract-equal label first || handler-label-present label rest
    other -> False
  handler-direct-operation :: List String -> CoreTerm -> Bool
  handler-direct-operation names term = case term of
    CUse sp ty name role actuals -> string-compare role "operation" == 0 && effect-operation-seen name names
    CApply sp ty f x -> handler-direct-operation names f
    CApplyEff sp ty row f x -> handler-direct-operation names f
    CDischarge sp ty evidence f -> handler-direct-operation names f
    other -> False
  -- D23: dispatch is lexical to this computation. An ordinary call cannot
  -- smuggle the discharged label in from a different function's body.
  handler-body-direct :: UType -> List String -> CoreTerm -> Bool
  handler-body-direct label names term = case term of
    CApplyEff sp ty row f x -> (handler-row-absent label row || handler-direct-operation names f) && handler-body-direct label names f && handler-body-direct label names x
    CApply sp ty f x -> handler-body-direct label names f && handler-body-direct label names x
    CErasedApply sp ty row f x -> handler-row-absent label row && handler-body-direct label names f && handler-body-direct label names x
    CLet sp ty id name sc rhs body -> handler-body-direct label names rhs && handler-body-direct label names body
    CRecursiveFunctions sp ty members body -> handler-body-direct label names body
    CRecursiveValues sp ty region members body -> handler-row-absent label (core-effects term)
    CIf sp ty condition yes no -> handler-body-direct label names condition && handler-body-direct label names yes && handler-body-direct label names no
    CCase sp ty value alts -> handler-body-direct label names value && handler-body-direct label names alts
    CAlternative sp pattern body rest -> handler-body-direct label names body && handler-body-direct label names rest
    CArgument sp first rest -> handler-body-direct label names first && handler-body-direct label names rest
    CTuple sp ty fields -> handler-body-direct label names fields
    CPolyIntro sp ty poly-ids fields -> handler-body-direct label names fields
    CPolyElim sp ty fields poly-args -> handler-body-direct label names fields
    CPrimitive sp ty name args -> handler-body-direct label names args
    CDecision sp ty predicate body -> handler-body-direct label names body
    CProved sp ty evidence body -> handler-body-direct label names body
    CRefine sp ty evidence body -> handler-body-direct label names body
    CRefineProof sp ty witness body -> handler-body-direct label names witness && handler-body-direct label names body
    CForget sp ty body -> handler-body-direct label names body
    CRequire sp ty body -> handler-body-direct label names body
    CDischarge sp ty evidence body -> handler-body-direct label names body
    CGuard sp ty condition body -> handler-body-direct label names condition && handler-body-direct label names body
    CScope sp ty region evidence callback -> handler-row-absent label (core-effects term) && handler-body-direct label names callback
    CMemoScope sp ty region body -> handler-row-absent label (core-effects term) && handler-body-direct label names body
    CSpawn sp ty token body -> handler-row-absent label (core-effects term) && handler-body-direct label names token && handler-body-direct label names body
    CJoin sp ty token body -> handler-row-absent label (core-effects term) && handler-body-direct label names token && handler-body-direct label names body
    CWith sp ty given value body -> handler-body-direct label names value && handler-body-direct label names body
    CHandle sp ty inner residual body handled-by -> handler-row-absent label (core-effects term)
    -- Constructing a closure or handler does not execute its body.
    other -> True
  resume-max :: Nat -> Nat -> Nat
  resume-max a b = if a > b then a else b
  -- A resumption can be called once along a path. Passing it as a value,
  -- capturing it in another closure, or storing it requires richer usage
  -- evidence and is refused here rather than treated as unrestricted.
  resume-uses :: Nat -> CoreTerm -> Nat
  resume-uses id term = case term of
    CLocal sp ty key name actuals -> if id == key then 2 else 0
    CApply sp ty (CLocal at ft key name actuals) arg -> if id == key then 1 + resume-uses id arg else resume-uses id arg
    CApply sp ty f x -> resume-uses id f + resume-uses id x
    CApplyEff sp ty row f x -> resume-uses id f + resume-uses id x
    CErasedApply sp ty row f witness -> resume-uses id f
    CLambda sp ty pattern body -> if resume-uses id body > 0 then 2 else 0
    CLet sp ty key name sc rhs body -> resume-uses id rhs + resume-uses id body
    CRecursiveFunctions sp ty members body -> recursive-resume-uses id members + resume-uses id body
    CRecursiveValues sp ty region members body -> recursive-resume-uses id members + resume-uses id body
    CIf sp ty condition yes no -> resume-uses id condition + resume-max (resume-uses id yes) (resume-uses id no)
    CCase sp ty value alts -> resume-uses id value + resume-uses id alts
    CAlternative sp pattern body rest -> resume-alternative-uses id body rest
    CArgument sp first rest -> resume-uses id first + resume-uses id rest
    CTuple sp ty fields -> resume-uses id fields
    CPolyIntro sp ty poly-ids fields -> resume-uses id fields
    CPolyElim sp ty fields poly-args -> resume-uses id fields
    CPrimitive sp ty name args -> resume-uses id args
    CDecision sp ty predicate body -> resume-uses id body
    CProved sp ty evidence body -> resume-uses id body
    CRefine sp ty evidence body -> resume-uses id body
    CRefineProof sp ty witness body -> resume-uses id witness + resume-uses id body
    CForget sp ty body -> resume-uses id body
    CRequire sp ty body -> resume-uses id body
    CDischarge sp ty evidence body -> resume-uses id body
    CGuard sp ty condition body -> resume-uses id condition + resume-uses id body
    CScope sp ty region evidence callback -> resume-uses id callback
    CMemoScope sp ty region body -> resume-uses id body
    CSpawn sp ty token body -> resume-uses id token + resume-uses id body
    CJoin sp ty token body -> resume-uses id token + resume-uses id body
    CWith sp ty given value body -> resume-uses id value + resume-uses id body
    CHandle sp ty label residual body handled-by -> resume-uses id body + resume-uses id handled-by
    CHandler sp ty returned operations -> if resume-uses id returned + resume-uses id operations > 0 then 2 else 0
    CHandlerOperation sp slot openings row closure rest -> resume-uses id closure + resume-uses id rest
    other -> 0
  recursive-resume-uses :: Nat -> CoreTerm -> Nat
  recursive-resume-uses id members = case members of
    CRecursiveBindingsEnd -> 0
    CRecursiveBinding key name value rest -> resume-uses id value + recursive-resume-uses id rest
    other -> 0
  -- A failed guard continues to later alternatives. Calls performed by
  -- the guard therefore add to calls in the later branch, rather than
  -- being counted as mutually exclusive with that branch.
  resume-alternative-uses :: Nat -> CoreTerm -> CoreTerm -> Nat
  resume-alternative-uses id body rest = case body of
    CGuard sp ty condition value -> resume-uses id condition + resume-max (resume-uses id value) (resume-uses id rest)
    CLet sp ty key name sc rhs value -> resume-uses id rhs + resume-alternative-uses id value rest
    CRequire sp ty value -> resume-alternative-uses id value rest
    CDischarge sp ty evidence value -> resume-alternative-uses id value rest
    CProved sp ty evidence value -> resume-alternative-uses id value rest
    CRefine sp ty evidence value -> resume-alternative-uses id value rest
    CForget sp ty value -> resume-alternative-uses id value rest
    other -> resume-max (resume-uses id body) (resume-uses id rest)
  handler-resumption-safe :: UType -> CoreTerm -> Bool
  handler-resumption-safe operation closure = case closure of
    CLambda sp ty pattern body -> case arrow-shape operation of
      UFun a b -> handler-resumption-safe b body
      UFunEff a row b -> if operation-function b then handler-resumption-safe b body else resume-body-safe body
      UPi id name a row b -> if operation-function b then handler-resumption-safe b body else resume-body-safe body
      UProofFun predicate row b -> if operation-function b then handler-resumption-safe b body else resume-body-safe body
      other -> False
    other -> False
  resume-body-safe :: CoreTerm -> Bool
  resume-body-safe term = case term of
    CLambda sp ty (CPVar at domain id name) body -> resume-uses id body <= 1
    CLambda sp ty (CPWild at domain) body -> True
    other -> False

  data CoreClause where
    MkCoreClause :: Span -> List CorePattern -> CoreTerm -> CoreClause
  data CoreDefinition where
    MkCoreDefinition :: Span -> String -> Scheme -> List (Nat, UType) -> List CoreGiven -> List (Nat, Kind) -> List CoreClause -> CoreDefinition

  index-local-terms :: Span -> UType -> IndexTerm -> List CoreTerm
  index-local-terms sp carrier value = case value of
    IRigid id name level -> [CLocal sp carrier id name Nil]
    IAdd first second -> index-local-terms sp carrier first <> index-local-terms sp carrier second
    ISubtract first second -> index-local-terms sp carrier first <> index-local-terms sp carrier second
    IMultiply first second -> index-local-terms sp carrier first <> index-local-terms sp carrier second
    other -> Nil
  index-value-terms :: Span -> UType -> List CoreTerm
  index-value-terms sp value = case value of
    UIndexByteLength input -> index-value-terms sp input
    UIndexForget input -> index-value-terms sp input
    UIndexPromote input -> index-value-terms sp input
    UIndexMath op first second -> index-value-terms sp first <> index-value-terms sp second
    UIndexList element fields -> case fields of
      UArg first rest -> index-value-terms sp first <> index-value-terms sp rest
      other -> Nil
    UIndexCall function arguments -> index-argument-terms sp arguments
    other -> (case (value-carrier (type-kind value), index-of-type value) of (Some carrier, Some term) -> index-local-terms sp carrier term; other -> Nil)
  index-argument-terms :: Span -> UType -> List CoreTerm
  index-argument-terms sp arguments = case arguments of UArg first rest -> index-value-terms sp first <> index-argument-terms sp rest; other -> Nil
  implicit-value-terms :: Span -> List UType -> List CoreTerm
  implicit-value-terms sp actuals = case actuals of Nil -> Nil; Cons first rest -> index-value-terms sp first <> implicit-value-terms sp rest
  term-children :: CoreTerm -> List CoreTerm
  term-children term = case term of
    CUse sp ty name role actuals -> if string-compare role "constructor" == 0 then Nil else implicit-value-terms sp actuals
    CQualifiedUse sp ty name role actuals evidence -> if string-compare role "constructor" == 0 then Nil else implicit-value-terms sp actuals
    CMethod sp ty name owner slot actuals evidence -> implicit-value-terms sp actuals
    CApply sp ty f x -> [f, x]
    CApplyEff sp ty row f x -> [f, x]
    CErasedApply sp ty row f x -> [f, x]
    CDecision sp ty predicate condition -> [condition]
    CScope sp ty region evidence callback -> [callback]
    CMemoScope sp ty region body -> [body]
    CSpawn sp ty token body -> [token, body]
    CJoin sp ty token handles -> [token, handles]
    CWith sp ty given value body -> [value, body]
    CHandler sp ty returned operations -> [returned, operations]
    CHandle sp ty label residual body handled-by -> [body, handled-by]
    CHandlerOperation sp slot openings row closure rest -> [closure, rest]
    CLambda sp ty p body -> [body]
    CLet sp ty id name sc rhs body -> [rhs, body]
    CRecursiveFunctions sp ty members body -> Cons body (recursive-functions members)
    CRecursiveValues sp ty region members body -> recursive-functions members <> [body]
    CIf sp ty condition yes no -> [condition, yes, no]
    CCase sp ty value alts -> [value, alts]
    CTuple sp ty fields -> [fields]
    CPolyIntro sp ty poly-ids fields -> [fields]
    CPolyElim sp ty fields poly-args -> [fields]
    CPrimitive sp ty op args -> [args]
    CProved sp ty certificate body -> [body]
    CRefine sp ty certificate body -> [body]
    CRefineProof sp ty witness body -> [witness, body]
    CForget sp ty body -> [body]
    CRequire sp ty body -> [body]
    CDischarge sp ty proofs body -> [body]
    CGuard sp ty guard body -> [guard, body]
    CArgument sp first rest -> [first, rest]
    CAlternative sp p body rest -> [body, rest]
    other -> Nil
  runtime-term-children :: CoreTerm -> List CoreTerm
  runtime-term-children term = case term of
    CErasedApply sp ty row f witness -> [f]
    CRefineProof sp ty witness body -> [body]
    other -> term-children term
  core-name :: CoreDefinition -> String
  core-name d = case d of MkCoreDefinition s name sc openings givens private clauses -> name
  core-scheme :: CoreDefinition -> Scheme
  core-scheme d = case d of MkCoreDefinition s name sc openings givens private clauses -> sc
  core-clauses :: CoreDefinition -> List CoreClause
  core-clauses d = case d of MkCoreDefinition s name sc openings givens private clauses -> clauses
  core-openings :: CoreDefinition -> List (Nat, UType)
  core-openings d = case d of MkCoreDefinition s name sc openings givens private clauses -> openings
  core-private-types :: CoreDefinition -> List (Nat, Kind)
  core-private-types d = case d of MkCoreDefinition s name sc openings givens private clauses -> private

  core-givens :: CoreDefinition -> List CoreGiven
  core-givens d = case d of MkCoreDefinition s name sc openings givens private clauses -> givens

  ownership-type-kinds :: List (String, Kind)
  ownership-type-kinds = [("Ref", borrow-constructor-kind), ("Mut", borrow-constructor-kind), ("Thunk", thunk-kind), ("Lazy", lazy-kind), ("Later", later-kind)]
  thunk-function-parts :: UType -> Option (UType, UType)
  thunk-function-parts ty = case ty of
    UFun (UCon name KType) result -> if string-compare name "Unit" == 0 then Some (URow UEnd, result) else None
    UFunEff (UCon name KType) row result -> if string-compare name "Unit" == 0 then Some (row, result) else None
    UPi id name (UCon domain KType) row result -> if string-compare domain "Unit" == 0 && not (pi-dependent ty) then Some (row, result) else None
    other -> None
  mutable-borrow :: UType -> Option (UType, UType)
  mutable-borrow ty = case borrow-type-parts ty of
    Some (True, region, carrier) -> Some (region, carrier)
    other -> None
  borrowed-carrier :: UType -> Option UType
  borrowed-carrier ty = case borrow-type-parts ty of
    Some (mutable, region, carrier) -> Some carrier
    None -> None
  copy-out-type :: UType -> UType
  copy-out-type input = case borrowed-carrier input of Some carrier -> carrier; None -> input

  -- Sequence nodes have no value type. They only appear in the matching
  -- tuple, primitive, pattern or alternative positions, never as values.
  -- A scope binds a genuinely fresh region only inside its callback.
  -- Neither a printed region name nor a cached kind introduces this binder.
  scope-kind :: Kind
  scope-kind = KFun KRegion (KFun KRegion KType)
  scope-type :: UType -> UType -> UType
  scope-type owner region = UApp (UApp (UCon "b.Scope" scope-kind) owner) region
  scope-region-closed :: UType -> UType -> Bool
  scope-region-closed region result = case region of
    URigid id name level KRegion -> not (local-id id (type-all-ids result))
    other -> False
  memo-label :: UType -> UType
  memo-label region = UApp (UCon "Eval" (KFun KRegion KEffect)) region
  memo-row :: UType -> UType
  memo-row region = URow (UArg (memo-label region) UEnd)
  memo-residual :: UType -> UType -> UType
  memo-residual region row = case row of
    UMeta id KRow -> row
    URowJoin first second -> union-effects (memo-residual region first) (memo-residual region second)
    other -> (case handler-residual (memo-label region) row of Some residual -> residual; None -> UError)
  memo-demand-type :: UType -> UType
  memo-demand-type cell = case lazy-parts cell of
    Some (row, region, result) -> UApp (UApp (UCon "Ref" borrow-constructor-kind) region) result
    None -> UError
  scope-callback-parts :: UType -> Option (UType, UType, UType, UType)
  scope-callback-parts ty = case ty of
    UFun domain result -> scope-domain domain (URow UEnd) result
    UFunEff domain row result -> scope-domain domain row result
    other -> None
  scope-domain :: UType -> UType -> UType -> Option (UType, UType, UType, UType)
  scope-domain domain row result = case domain of
    UApp (UApp (UCon name kind) owner) region -> if string-compare name "b.Scope" == 0 && kind-equal kind scope-kind && kind-equal (type-kind owner) KRegion && kind-equal (type-kind region) KRegion then Some (owner, region, row, result) else None
    other -> None
  task-kind :: Kind
  task-kind = KFun KRegion (KFun KType (KFun KType KType))
  task-type :: UType -> UType -> UType -> UType
  task-type region error value = UApp (UApp (UApp (UCon "b.Task" task-kind) region) error) value
  task-result-type :: UType -> UType -> UType
  task-result-type error value = UApp (UApp (UCon (global-data-core-result) (KFun KType (KFun KType KType))) error) value
  scope-parameters :: UType -> Option (UType, UType)
  scope-parameters ty = case scope-callback-parts (UFun ty (UCon "Unit" KType)) of Some (owner, region, row, result) -> Some (owner, region); None -> None
  task-parts :: UType -> Option (UType, UType, UType)
  task-parts ty = case ty of
    UApp (UApp (UApp (UCon name kind) region) error) value -> if string-compare name "b.Task" == 0 && kind-equal kind task-kind then Some (region, error, value) else None
    other -> None
  task-body-parts :: UType -> Option (UType, UType, UType)
  task-body-parts ty = case ty of
    UFun domain result -> task-body-result domain (URow UEnd) result
    UFunEff domain row result -> task-body-result domain row result
    other -> None
  task-body-result :: UType -> UType -> UType -> Option (UType, UType, UType)
  task-body-result domain row result = case result of
    UApp (UApp (UCon name kind) error) value -> if contract-equal domain (UCon "Unit" KType) && string-compare name (global-data-core-result) == 0 && kind-equal kind (KFun KType (KFun KType KType)) then Some (error, value, row) else None
    other -> None
  task-effect :: String -> UType -> UType
  task-effect name owner = URow (UArg (UApp (UCon name (KFun KRegion KEffect)) owner) UEnd)
  task-spawn-effects :: CoreTerm -> CoreTerm -> UType
  task-spawn-effects token body = case (scope-parameters (core-type token), task-body-parts (core-type body)) of
    (Some (owner, region), Some (error, value, row)) -> union-effects (task-effect "Async" owner) (union-effects row (union-effects (core-effects token) (core-effects body)))
    other -> UError
  task-join-effects :: CoreTerm -> CoreTerm -> UType
  task-join-effects token handles = case scope-parameters (core-type token) of
    Some (owner, region) -> union-effects (URow (UArg (UCon "Diverge" KEffect) UEnd)) (union-effects (task-effect "Async" owner) (union-effects (task-effect "Cancel" owner) (union-effects (core-effects token) (core-effects handles))))
    None -> UError
  task-join-result :: CoreTerm -> CoreTerm -> Option UType
  task-join-result token handles = case (scope-parameters (core-type token), handles) of
    (Some (owner, region), CArgument sp first rest) -> (case task-parts (core-type first) of
      Some (actual, error, value) -> if contract-equal region actual then (case task-join-fields region error rest of
        Some UEnd -> Some (task-result-type error value)
        Some more -> Some (task-result-type error (UTuple (UArg value more)))
        None -> None) else None
      None -> None)
    other -> None
  task-join-fields :: UType -> UType -> CoreTerm -> Option UType
  task-join-fields region error handles = case handles of
    CArgumentsEnd sp -> Some UEnd
    CArgument sp first rest -> (case task-parts (core-type first) of
      Some (actual, failure, value) -> if contract-equal region actual && contract-equal error failure then (case task-join-fields region error rest of Some more -> Some (UArg value more); None -> None) else None
      None -> None)
    other -> None
  core-type :: CoreTerm -> UType
  core-type term = case term of
    CUse s ty name role actuals -> ty
    CLocal s ty id name actuals -> ty
    CProofRef s ty id name -> ty
    CProofRefl s predicate -> predicate
    CProofSearch s predicate assumption evidence -> predicate
    CQualifiedUse s ty name role actuals evidence -> ty
    CMethod s ty name owner slot actuals evidence -> ty
    CInt s ty text -> ty
    CString s ty text -> ty
    CChar s ty text -> ty
    CUnit s ty -> ty
    CApply s ty f x -> ty
    CApplyEff s ty row f x -> ty
    CErasedApply s ty row f x -> ty
    CDecision s ty predicate condition -> ty
    CScope s ty region evidence callback -> ty
    CMemoScope s ty region body -> ty
    CSpawn s ty token body -> ty
    CJoin s ty token body -> ty
    CWith s ty given value body -> ty
    CHandler s ty returned operations -> ty
    CHandle s ty label residual body handled-by -> ty
    CLambda s ty p body -> ty
    CLet s ty id name sc rhs body -> ty
    CRecursiveFunctions s ty members body -> ty
    CRecursiveValues s ty region members body -> ty
    CIf s ty condition yes no -> ty
    CCase s ty value alts -> ty
    CTuple s ty fields -> ty
    CPolyIntro s ty ids body -> ty
    CPolyElim s ty value args -> ty
    CPrimitive s ty name args -> ty
    CProved s ty evidence body -> ty
    CRefine s ty evidence body -> ty
    CRefineProof s ty witness body -> ty
    CForget s ty body -> ty
    CRequire s ty body -> ty
    CDischarge s ty evidence body -> ty
    CGuard s ty guard rhs -> ty
    other -> UError

  -- Compare checked equations before a rule enters the optimizer. The law's
  -- formal parameters can stand for whole checked citation arguments. A
  -- lambda's locals are related by binder identity, never by spelling.
  rewrite-term-equal :: List (Nat, CoreTerm) -> CoreTerm -> CoreTerm -> Bool
  rewrite-term-equal arguments rule equation = rewrite-equal arguments Nil rule equation

  rewrite-type-equal :: UType -> UType -> Bool
  rewrite-type-equal first second = valid-type first && valid-type second && contract-equal first second
  rewrite-types-equal :: List UType -> List UType -> Bool
  rewrite-types-equal first second = case (first, second) of
    (Nil, Nil) -> True
    (Cons a rest, Cons b more) -> rewrite-type-equal a b && rewrite-types-equal rest more
    other -> False
  rewrite-evidences-equal :: List CoreEvidence -> List CoreEvidence -> Bool
  rewrite-evidences-equal first second = case (first, second) of
    (Nil, Nil) -> True
    (Cons a rest, Cons b more) -> rewrite-evidence-equal a b && rewrite-evidences-equal rest more
    other -> False
  rewrite-evidence-equal :: CoreEvidence -> CoreEvidence -> Bool
  rewrite-evidence-equal first second = case (first, second) of
    (CEGiven sp ty name, CEGiven at other symbol) ->
      string-compare name symbol == 0 && rewrite-type-equal ty other
    (CEInstance sp ty name types arguments, CEInstance at other symbol actuals supplied) ->
      string-compare name symbol == 0 && rewrite-type-equal ty other && rewrite-types-equal types actuals
        && rewrite-evidence-equal arguments supplied
    (CEArgument sp a rest, CEArgument at b more) ->
      rewrite-evidence-equal a b && rewrite-evidence-equal rest more
    (CEArgumentsEnd sp, CEArgumentsEnd at) -> True
    other -> False
  rewrite-argument :: Nat -> List (Nat, CoreTerm) -> Option CoreTerm
  rewrite-argument id arguments = case arguments of
    Nil -> None
    Cons (formal, value) rest -> if id == formal then Some value else rewrite-argument id rest
  rewrite-local-equal :: Nat -> Nat -> List (Nat, Nat) -> Bool
  rewrite-local-equal first second binders = case binders of
    Nil -> first == second
    Cons (left, right) rest ->
      if first == left || second == right then first == left && second == right
      else rewrite-local-equal first second rest
  rewrite-equal :: List (Nat, CoreTerm) -> List (Nat, Nat) -> CoreTerm -> CoreTerm -> Bool
  rewrite-equal arguments binders first second = case second of
    CLocal sp ty id name Nil -> (case rewrite-argument id arguments of
      Some actual -> rewrite-type-equal ty (core-type actual) && rewrite-structure Nil Nil first actual
      None -> rewrite-structure arguments binders first second)
    other -> rewrite-structure arguments binders first second
  rewrite-structure :: List (Nat, CoreTerm) -> List (Nat, Nat) -> CoreTerm -> CoreTerm -> Bool
  rewrite-structure arguments binders first second =
    let equal = rewrite-equal arguments binders in
    let typed = rewrite-type-equal (core-type first) (core-type second) in
    case (first, second) of
      (CLocal sp ty id name actuals, CLocal at other key display supplied) ->
        typed && rewrite-local-equal id key binders && rewrite-types-equal actuals supplied
      (CUse sp ty name role actuals, CUse at other symbol kind supplied) ->
        typed && string-compare name symbol == 0 && string-compare role kind == 0 && rewrite-types-equal actuals supplied
      (CQualifiedUse sp ty name role actuals evidence, CQualifiedUse at other symbol kind supplied proofs) ->
        typed && string-compare name symbol == 0 && string-compare role kind == 0
          && rewrite-types-equal actuals supplied && rewrite-evidences-equal evidence proofs
      (CMethod sp ty name owner slot actuals evidence, CMethod at other symbol origin field supplied proofs) ->
        typed && string-compare owner origin == 0 && string-compare name symbol == 0 && slot == field
          && rewrite-types-equal actuals supplied && rewrite-evidences-equal evidence proofs
      (CApply sp ty f x, CApply at other g y) -> typed && equal f g && equal x y
      (CLambda sp ty (CPVar site domain id name) body, CLambda at other (CPVar source carrier key display) rhs) ->
        typed && rewrite-type-equal domain carrier && rewrite-equal arguments (Cons (id, key) binders) body rhs
      (CLambda sp ty (CPWild site domain) body, CLambda at other (CPWild source carrier) rhs) ->
        typed && rewrite-type-equal domain carrier && equal body rhs
      (CInt sp ty text, CInt at other value) -> typed && string-compare text value == 0
      (CString sp ty text, CString at other value) -> typed && string-compare text value == 0
      (CChar sp ty text, CChar at other value) -> typed && string-compare text value == 0
      (CUnit sp ty, CUnit at other) -> typed
      (CIf sp ty guard yes no, CIf at other test left right) -> typed && equal guard test && equal yes left && equal no right
      (CPrimitive sp ty name args, CPrimitive at other symbol supplied) ->
        typed && string-compare name symbol == 0 && equal args supplied
      (CTuple sp ty fields, CTuple at other supplied) -> typed && equal fields supplied
      (CArgument sp value rest, CArgument at argument more) -> equal value argument && equal rest more
      (CArgumentsEnd sp, CArgumentsEnd at) -> True
      other -> False

  -- Creating a closure is pure; invoking it contributes its latent row.
  -- Supplying a capability preserves the body's effects, never handles them.
  core-effects :: CoreTerm -> UType
  core-effects term = case term of
    CHandler s ty returned operations -> union-effects (core-effects returned) (core-effects operations)
    CHandlerOperation s slot openings row closure rest -> union-effects (core-effects closure) (core-effects rest)
    CApply s ty f x -> union-effects (core-effects f) (core-effects x)
    CApplyEff s ty row f x -> union-effects row (union-effects (core-effects f) (core-effects x))
    CErasedApply s ty row f witness -> union-effects row (core-effects f)
    CDecision s ty predicate condition -> core-effects condition
    CScope s ty region evidence callback -> (case scope-callback-parts (core-type callback) of Some (owner, bound, row, result) -> union-effects (URow (UArg (UCon "Diverge" KEffect) UEnd)) (union-effects row (core-effects callback)); None -> UError)
    CMemoScope s ty region body -> memo-residual region (core-effects body)
    CSpawn s ty token body -> task-spawn-effects token body
    CJoin s ty token body -> task-join-effects token body
    CWith s ty given value body -> union-effects (core-effects value) (core-effects body)
    CHandle s ty label residual body handled-by -> case handler-parts (core-type handled-by) of
      Some (declared-label, input, output, row) -> union-effects residual (union-effects row (core-effects handled-by))
      None -> UError
    CLet s ty id name scheme rhs body -> union-effects (core-effects rhs) (core-effects body)
    CRecursiveFunctions s ty members body -> core-effects body
    CRecursiveValues s ty region members body -> recursive-value-effects members (core-effects body)
    CRecursiveBinding id name value rest -> UError
    CRecursiveBindingsEnd -> UError
    CIf s ty condition yes no -> union-effects (core-effects condition) (union-effects (core-effects yes) (core-effects no))
    CCase s ty value alternatives -> union-effects (core-effects value) (core-effects alternatives)
    CTuple s ty fields -> core-effects fields
    -- Building a polymorphic value performs nothing; its body was checked pure.
    CPolyIntro s ty ids body -> URow UEnd
    CPolyElim s ty value args -> core-effects value
    CPrimitive s ty name args -> if string-compare name "thunk-force" == 0 then
      (case args of
        CArgument at thunk (CArgumentsEnd end) -> (case deferral-parts (core-type thunk) of Some (row, result) -> union-effects (core-effects thunk) row; None -> UError)
        other -> UError)
      else if string-compare name "memo-demand" == 0 then
        (case args of
          CArgument at cell (CArgumentsEnd end) -> (case lazy-parts (core-type cell) of
            Some (row, region, result) -> union-effects (memo-row region) (union-effects (core-effects cell) row)
            None -> UError)
          other -> UError)
      -- A parallel call performs every callback's latent row, exactly as
      -- evaluating its defining equation would: `(f (), g ())`,
      -- `array-tabulate n f`, `map f xs` all invoke the callback.
      else if string-compare name "par-both" == 0 then
        (case args of
          CArgument at f (CArgument bt g (CArgumentsEnd end)) ->
            union-effects (latent-row (core-type f)) (union-effects (latent-row (core-type g))
              (union-effects (core-effects f) (core-effects g)))
          other -> UError)
      else if string-compare name "par-tabulate" == 0 then
        (case args of
          CArgument at count (CArgument bt callback (CArgumentsEnd end)) ->
            union-effects (latent-row (core-type callback)) (union-effects (core-effects count) (core-effects callback))
          other -> UError)
      else if string-compare name "par-map" == 0 then
        (case args of
          CArgument at callback (CArgument bt array (CArgumentsEnd end)) ->
            union-effects (latent-row (core-type callback)) (union-effects (core-effects callback) (core-effects array))
          other -> UError)
      else core-effects args
    CProved s ty evidence body -> core-effects body
    CRefine s ty evidence body -> core-effects body
    CRefineProof s ty witness body -> core-effects body
    CForget s ty body -> core-effects body
    CRequire s ty body -> core-effects body
    CDischarge s ty evidence body -> core-effects body
    CGuard s ty condition body -> union-effects (core-effects condition) (core-effects body)
    CArgument s value rest -> union-effects (core-effects value) (core-effects rest)
    CAlternative s pattern body rest -> union-effects (core-effects body) (core-effects rest)
    other -> URow UEnd

  -- The row a callback performs when it is invoked. A parallel builtin's
  -- defining equation invokes its callbacks, so the call carries each one's
  -- latent row; an arrow with no effect syntax is pure.
  latent-row :: UType -> UType
  latent-row ty = case arrow-shape ty of
    UFunEff domain row result -> row
    UProofFun predicate row result -> row
    UPi id name domain row result -> row
    other -> URow UEnd

  recursive-value-effects :: CoreTerm -> UType -> UType
  recursive-value-effects members continuation = case members of
    CRecursiveBindingsEnd -> continuation
    CRecursiveBinding id name value rest -> union-effects (core-effects value) (recursive-value-effects rest continuation)
    other -> UError
  recursive-value-writes :: CoreTerm -> List (Span, Option UType)
  recursive-value-writes members = child-writes (recursive-functions members)

  -- Write targets belong to checked Core. A missing region is an opaque
  -- write. A closure's body is latent and cannot write while it is created.
  core-mutable-writes :: CoreTerm -> List (Span, Option UType)
  core-mutable-writes term = case term of
    CLambda sp ty pattern body -> Nil
    CApply sp ty f x -> child-writes [f, x] <> argument-writes sp x <> opaque-call-writes sp f
    CApplyEff sp ty row f x -> child-writes [f, x] <> argument-writes sp x <> row-writes sp row <> opaque-call-writes sp f
    CErasedApply sp ty row f witness -> core-mutable-writes f <> row-writes sp row <> opaque-call-writes sp f
    CPrimitive sp ty operation (CArgument at place rest) ->
      child-writes [place, rest] <> (if string-compare operation "ref-set" == 0 then argument-writes sp place
        else if string-compare operation "thunk-force" == 0 then forced-thunk-writes sp place
        else if string-compare operation "memo-demand" == 0 then [(sp, None)] else Nil)
    CIf sp ty condition yes no -> core-mutable-writes condition <> (case write-branch-literal condition of
      Some True -> core-mutable-writes yes
      Some False -> core-mutable-writes no
      None -> child-writes [yes, no])
    CScope sp ty region evidence callback ->
      core-mutable-writes callback <> (case scope-callback-parts (core-type callback) of
        Some (owner, inner, row, result) -> row-writes sp row
        None -> [(sp, None)])
    CSpawn sp ty token body -> child-writes [token, body] <> row-writes sp (core-effects term)
    CHandle sp ty label residual body handled-by -> child-writes [handled-by, body] <> row-writes sp (core-effects term)
    other -> child-writes (term-children term)
  -- A locally constructed thunk exposes the closure's writes. An opaque
  -- thunk can capture an exclusive borrow even when its row is empty.
  forced-thunk-writes :: Span -> CoreTerm -> List (Span, Option UType)
  forced-thunk-writes sp term = case term of
    CPrimitive at ty operation (CArgument argument (CLambda fn closure pattern body) (CArgumentsEnd end)) ->
      if string-compare operation "thunk-delay" == 0 then core-mutable-writes body else [(sp, None)]
    other -> [(sp, None)]
  write-branch-literal :: CoreTerm -> Option Bool
  write-branch-literal term = case term of
    CUse sp ty name role Nil -> if bool-type ty && string-compare role "constructor" == 0 then
      (if string-compare name "True" == 0 then Some True else if string-compare name "False" == 0 then Some False else None) else None
    other -> if decision-constant True term then Some True else if decision-constant False term then Some False else None
  scoped-branch-writes :: CoreTerm -> Bool -> List (Span, Option UType)
  scoped-branch-writes term positive = case term of
    CIf sp ty condition yes no -> case (write-branch-literal yes, write-branch-literal no) of
      (Some left, Some right) | left /= right -> scoped-branch-writes condition (left == positive)
      (Some True, other) | not positive -> scoped-branch-writes condition False <> scoped-branch-writes no False
      (other, Some False) | positive -> scoped-branch-writes condition True <> scoped-branch-writes yes True
      other -> core-mutable-writes term
    other -> core-mutable-writes term
  guard-fallthrough-writes :: CoreTerm -> List (Span, Option UType)
  guard-fallthrough-writes body = case body of
    CGuard sp ty condition rhs -> scoped-branch-writes condition False
    CLet sp ty id name sc rhs inner -> if core-alternative-covers inner then Nil
      else core-mutable-writes rhs <> guard-fallthrough-writes inner
    CMemoScope sp ty region inner -> guard-fallthrough-writes inner
    CRecursiveValues sp ty region members inner -> recursive-value-writes members <> guard-fallthrough-writes inner
    CRequire sp ty inner -> guard-fallthrough-writes inner
    other -> Nil
  child-writes :: List CoreTerm -> List (Span, Option UType)
  child-writes children = case children of Nil -> Nil; Cons first rest -> core-mutable-writes first <> child-writes rest
  call-operand-writes :: CoreTerm -> List (Span, Option UType)
  call-operand-writes term = case term of
    CApply sp ty f x -> child-writes [f, x]
    CApplyEff sp ty row f x -> child-writes [f, x]
    CErasedApply sp ty row f witness -> core-mutable-writes f
    other -> Nil
  argument-writes :: Span -> CoreTerm -> List (Span, Option UType)
  argument-writes sp term = case mutable-borrow (core-type term) of
    Some (region, carrier) -> [(sp, Some region)]
    None -> Nil
  row-writes :: Span -> UType -> List (Span, Option UType)
  row-writes sp row = case row of
    URow labels -> label-writes sp labels
    URowJoin a b -> row-writes sp a <> row-writes sp b
    other -> [(sp, None)]
  label-writes :: Span -> UType -> List (Span, Option UType)
  label-writes sp labels = case labels of
    UEnd -> Nil
    UArg label rest -> effect-writes sp label <> label-writes sp rest
    other -> [(sp, None)]
  effect-writes :: Span -> UType -> List (Span, Option UType)
  effect-writes sp label = case label of
    UCon name KEffect -> effect-head-writes sp name None
    UApp (UCon name (KFun KRegion KEffect)) region -> effect-head-writes sp name (Some region)
    other -> [(sp, None)]
  effect-head-writes :: Span -> String -> Option UType -> List (Span, Option UType)
  effect-head-writes sp name region =
    if string-compare name "Foreign" == 0 || string-compare name "Eval" == 0 then [(sp, None)]
    else if string-compare name "Async" == 0 || string-compare name "Cancel" == 0 || string-compare name "Diverge" == 0
      || string-compare name "Fail" == 0 || string-compare name "ThreadAffine" == 0 || string-compare name "Blocking" == 0 then Nil
    else [(sp, region)]
  opaque-call-writes :: Span -> CoreTerm -> List (Span, Option UType)
  opaque-call-writes sp term = case term of
    CUse at ty name role actuals -> opaque-symbol-writes sp name role
    CQualifiedUse at ty name role actuals evidence -> opaque-symbol-writes sp name role
    CApply at ty f x -> opaque-call-writes sp f
    CApplyEff at ty row f x -> opaque-call-writes sp f
    CErasedApply at ty row f witness -> opaque-call-writes sp f
    CDischarge at ty evidence body -> opaque-call-writes sp body
    CLocal at ty id name actuals -> [(sp, None)]
    other -> Nil
  opaque-symbol-writes :: Span -> String -> String -> List (Span, Option UType)
  opaque-symbol-writes sp name role =
    if string-compare name bytes-len-global == 0 || string-compare name bytes-get-global == 0 then Nil
    else if string-compare role "foreign" == 0 || string-compare name "b.eval" == 0
      || (string-compare role "intrinsic" == 0 && (string-compare name "cinch.runtime.bytesSet" == 0
        || string-compare name "cinch.runtime.bytesCopy" == 0 || string-compare name "cinch.runtime.bytesNew" == 0))
      || string-compare name bytes-set-global == 0
      || string-compare name bytes-copy-range-global == 0
      || string-compare name bytes-new-global == 0 then [(sp, None)] else Nil
  -- The Data.Bytes operations as interface-global spells them, written out:
  -- every call is checked against these, and a literal is one static
  -- constant where interface-global would encode the identity again.
  bytes-len-global :: String
  bytes-len-global = "i.Data$2eBytes$2ebytes$2dlen"
  bytes-get-global :: String
  bytes-get-global = "i.Data$2eBytes$2ebytes$2dget"
  bytes-set-global :: String
  bytes-set-global = "i.Data$2eBytes$2ebytes$2dset"
  bytes-copy-range-global :: String
  bytes-copy-range-global = "i.Data$2eBytes$2ebytes$2dcopy$2drange"
  bytes-new-global :: String
  bytes-new-global = "i.Data$2eBytes$2ebytes$2dnew"

  map-types :: (UType -> UType) -> List UType -> List UType
  map-types f types = case types of Nil -> Nil; Cons ty rest -> Cons (f ty) (map-types f rest)
  map-scheme :: (UType -> UType) -> Scheme -> Scheme
  map-scheme f sc = map-scheme-types f sc
  map-pattern-types :: (UType -> UType) -> CorePattern -> CorePattern
  map-pattern-types f p = case p of
    CPWild s ty -> CPWild s (f ty)
    CPVar s ty id name -> CPVar s (f ty) id name
    CPProof s ty id name -> CPProof s (f ty) id name
    CPErasedValue s ty id name -> CPErasedValue s (f ty) id name
    CPAs s ty id name inner -> CPAs s (f ty) id name (map-pattern-types f inner)
    CPConstructor s ty name actuals constructor fields -> CPConstructor s (f ty) name (map-types f actuals) (f constructor) (map-pattern-types f fields)
    CPInt s ty text -> CPInt s (f ty) text
    CPString s ty text -> CPString s (f ty) text
    CPChar s ty text -> CPChar s (f ty) text
    CPTuple s ty fields -> CPTuple s (f ty) (map-pattern-types f fields)
    CPField s x rest -> CPField s (map-pattern-types f x) (map-pattern-types f rest)
    CPDone s -> p
  map-term-types :: (UType -> UType) -> CoreTerm -> CoreTerm
  map-term-types f term = case term of
    CUse s ty name role actuals -> CUse s (f ty) name role (map-types f actuals)
    CLocal s ty id name actuals -> CLocal s (f ty) id name (map-types f actuals)
    CProofRef s ty id name -> CProofRef s (f ty) id name
    CProofRefl s predicate -> CProofRefl s (f predicate)
    CProofSearch s predicate assumption evidence -> CProofSearch s (f predicate) assumption evidence
    CDecision s ty predicate condition -> CDecision s (f ty) (f predicate) (map-term-types f condition)
    CQualifiedUse s ty name role actuals evidence -> CQualifiedUse s (f ty) name role (map-types f actuals) (map-evidences f evidence)
    CMethod s ty name owner slot actuals evidence -> CMethod s (f ty) name owner slot (map-types f actuals) (map-evidences f evidence)
    CInt s ty text -> CInt s (f ty) text
    CString s ty text -> CString s (f ty) text
    CChar s ty text -> CChar s (f ty) text
    CUnit s ty -> CUnit s (f ty)
    CApply s ty fun arg -> CApply s (f ty) (map-term-types f fun) (map-term-types f arg)
    CErasedApply s ty row fun witness -> CErasedApply s (f ty) (f row) (map-term-types f fun) (map-term-types f witness)
    CApplyEff s ty row fun arg -> case f row of
      URow UEnd -> CApply s (f ty) (map-term-types f fun) (map-term-types f arg)
      effects -> CApplyEff s (f ty) effects (map-term-types f fun) (map-term-types f arg)
    CScope s ty region evidence callback -> CScope s (f ty) (f region) (map-evidence f evidence) (map-term-types f callback)
    CMemoScope s ty region body -> CMemoScope s (f ty) (f region) (map-term-types f body)
    CSpawn s ty token body -> CSpawn s (f ty) (map-term-types f token) (map-term-types f body)
    CJoin s ty token body -> CJoin s (f ty) (map-term-types f token) (map-term-types f body)
    CWith s ty given value body -> CWith s (f ty) (CGiven s (given-symbol given) (f (given-type given))) (map-term-types f value) (map-term-types f body)
    CHandler s ty returned operations -> CHandler s (f ty) (map-term-types f returned) (map-term-types f operations)
    CHandle s ty label residual body handled-by -> CHandle s (f ty) (f label) (f residual) (map-term-types f body) (map-term-types f handled-by)
    CHandlerOperation s slot openings row closure rest -> CHandlerOperation s slot (map-handler-openings f openings) (f row) (map-term-types f closure) (map-term-types f rest)
    CHandlerEnd s -> term
    CLambda s ty p body -> CLambda s (f ty) (map-pattern-types f p) (map-term-types f body)
    CLet s ty id name sc rhs body -> CLet s (f ty) id name (map-scheme f sc) (map-term-types f rhs) (map-term-types f body)
    CRecursiveFunctions s ty members body -> CRecursiveFunctions s (f ty) (map-recursive-functions (map-term-types f) members) (map-term-types f body)
    CRecursiveValues s ty region members body -> CRecursiveValues s (f ty) (f region) (map-term-types f members) (map-term-types f body)
    CRecursiveBinding id name value rest -> CRecursiveBinding id name (map-term-types f value) (map-term-types f rest)
    CRecursiveBindingsEnd -> term
    CIf s ty condition yes no -> CIf s (f ty) (map-term-types f condition) (map-term-types f yes) (map-term-types f no)
    CCase s ty value alts -> CCase s (f ty) (map-term-types f value) (map-term-types f alts)
    CTuple s ty fields -> CTuple s (f ty) (map-term-types f fields)
    CPolyIntro s ty ids body -> CPolyIntro s (f ty) ids (map-term-types f body)
    CPolyElim s ty value args -> CPolyElim s (f ty) (map-term-types f value) (map-types f args)
    CPrimitive s ty name args -> CPrimitive s (f ty) name (map-term-types f args)
    CProved s ty evidence body -> CProved s (f ty) evidence (map-term-types f body)
    CRefine s ty evidence body -> CRefine s (f ty) evidence (map-term-types f body)
    CRefineProof s ty witness body -> CRefineProof s (f ty) (map-term-types f witness) (map-term-types f body)
    CForget s ty body -> CForget s (f ty) (map-term-types f body)
    CRequire s ty body -> CRequire s (f ty) (map-term-types f body)
    CDischarge s ty evidence body -> CDischarge s (f ty) evidence (map-term-types f body)
    CGuard s ty guard rhs -> CGuard s (f ty) (map-term-types f guard) (map-term-types f rhs)
    CArgument s x rest -> CArgument s (map-term-types f x) (map-term-types f rest)
    CArgumentsEnd s -> term
    CAlternative s p body rest -> CAlternative s (map-pattern-types f p) (map-term-types f body) (map-term-types f rest)
    CAlternativesEnd s -> term
    CError s -> term

  abstract-type :: Store -> List (Nat, UType) -> UType -> UType
  abstract-type st pairs ty = abstract-metas pairs (normalize st ty)
  abstract-term :: Store -> List (Nat, UType) -> CoreTerm -> CoreTerm
  abstract-term st pairs term = map-term-types (abstract-type st pairs) term

  -- Any unconstrained internal monotypes become explicitly scoped rigid
  -- type names. They cannot acquire a later solution or escape through a
  -- public scheme. Public forall openings are retained separately.
  freeze-type :: Store -> UType -> UType
  freeze-type st ty = if valid-type ty then freeze (normalize st ty) else UError
  freeze :: UType -> UType
  freeze ty = case ty of
    UPropLit value -> UPropLit value
    UCompare relation left right -> UCompare relation (freeze left) (freeze right)
    UPropAnd left right -> UPropAnd (freeze left) (freeze right)
    UPropOr left right -> UPropOr (freeze left) (freeze right)
    UPropNot body -> UPropNot (freeze body)
    UPropNonZero body -> UPropNonZero (freeze body)
    UPropNotNull body -> UPropNotNull (freeze body)
    UPropAscii body -> UPropAscii (freeze body)
    UPropOrdered body -> UPropOrdered (freeze body)
    UPropNonZeroPending body -> UPropNonZeroPending (freeze body)
    URequire predicates body -> URequire (freeze predicates) (freeze body)
    URefine id name carrier predicate -> URefine id name (freeze carrier) (freeze predicate)
    UIndexForget value -> UIndexForget (freeze value)
    UIndexByteLength value -> UIndexByteLength (freeze value)
    UIndexBorrowRead value -> UIndexBorrowRead (freeze value)
    UIndexList element fields -> UIndexList (freeze element) (freeze fields)
    UIndexCall function args -> UIndexCall function (freeze args)
    UIndexPromote value -> UIndexPromote (freeze value)
    UIndexMath op left right -> UIndexMath op (freeze left) (freeze right)
    UPi id name domain row result -> UPi id name (freeze domain) (freeze row) (freeze result)
    UIndex carrier value -> case index-free-metas value of Nil -> UIndex (freeze carrier) value; other -> UError
    -- A private type name needs no runtime payload. An unsolved value
    -- index does: inventing a rigid name would fabricate its witness.
    UMeta id k -> case k of KValue carrier -> UError; other -> URigid id (string-concat "#core" (nat-to-string id)) 0 (map-kind-types freeze k)
    UCon name k -> UCon name (map-kind-types freeze k)
    UBound id name k -> UBound id name (map-kind-types freeze k)
    URigid id name level k -> URigid id name level (map-kind-types freeze k)
    UApp f x -> UApp (freeze f) (freeze x)
    UFun a b -> UFun (freeze a) (freeze b)
    UFunEff a row b -> UFunEff (freeze a) (freeze row) (freeze b)
    UUsageArrow usage arrow -> UUsageArrow usage (freeze arrow)
    UProofFun a row b -> UProofFun (freeze a) (freeze row) (freeze b)
    URow labels -> URow (freeze labels)
    URowJoin a b -> union-effects (freeze a) (freeze b)
    UTuple fields -> UTuple (freeze fields)
    UForall qs body -> UForall (map-quant-kinds freeze qs) (freeze body)
    UArg x rest -> UArg (freeze x) (freeze rest)
    other -> ty

  -- The private type declarations are collected before freezing, in first
  -- occurrence order. Their numeric ids share the checker's fresh supply.
  type-metas :: Store -> UType -> List (Nat, Kind)
  type-metas st ty = case normalize st ty of
    UPropLit value -> Nil
    UCompare relation left right -> type-metas st left <> type-metas st right
    UPropAnd left right -> type-metas st left <> type-metas st right
    UPropOr left right -> type-metas st left <> type-metas st right
    UPropNot body -> type-metas st body
    UPropNonZero body -> type-metas st body
    UPropNotNull body -> type-metas st body
    UPropAscii body -> type-metas st body
    UPropOrdered body -> type-metas st body
    UPropNonZeroPending body -> type-metas st body
    URequire predicates body -> type-metas st predicates <> type-metas st body
    URefine id name carrier predicate -> type-metas st carrier <> type-metas st predicate
    URefineFormer name ids body -> type-metas st body
    UIndexForget value -> type-metas st value
    UIndexByteLength value -> type-metas st value
    UIndexBorrowRead value -> type-metas st value
    UIndexList element fields -> type-metas st element <> type-metas st fields
    UIndexCall function args -> type-metas st args
    UIndexPromote value -> type-metas st value
    UIndexMath op left right -> type-metas st left <> type-metas st right
    UPi id name domain row result -> type-metas st domain <> type-metas st row <> type-metas st result
    UIndex carrier value -> type-metas st carrier <> index-type-metas carrier (index-free-metas value)
    UMeta id k -> Cons (id, k) (kind-type-metas st k)
    UCon name k -> kind-type-metas st k
    UBound id name k -> kind-type-metas st k
    URigid id name level k -> kind-type-metas st k
    UApp f x -> type-metas st f <> type-metas st x
    UFun a b -> type-metas st a <> type-metas st b
    UFunEff a row b -> type-metas st a <> type-metas st row <> type-metas st b
    UUsageArrow usage arrow -> type-metas st arrow
    UProofFun a row b -> type-metas st a <> type-metas st row <> type-metas st b
    URow labels -> type-metas st labels
    URowJoin a b -> type-metas st a <> type-metas st b
    UTuple fields -> type-metas st fields
    UForall qs body -> type-metas st body
    UArg x rest -> type-metas st x <> type-metas st rest
    other -> Nil
  index-type-metas :: UType -> List Nat -> List (Nat, Kind)
  index-type-metas carrier ids = case ids of Nil -> Nil; Cons id rest -> Cons (id, value-kind carrier) (index-type-metas carrier rest)
  kind-type-metas :: Store -> Kind -> List (Nat, Kind)
  kind-type-metas st kind = case kind of KValue payload -> (case value-carrier kind of Some carrier -> type-metas st carrier; None -> Nil); KFun a b -> kind-type-metas st a <> kind-type-metas st b; other -> Nil
  types-metas :: Store -> List UType -> List (Nat, Kind)
  types-metas st types = case types of Nil -> Nil; Cons ty rest -> type-metas st ty <> types-metas st rest
  given-metas :: Store -> List CoreGiven -> List (Nat, Kind)
  given-metas st givens = case givens of Nil -> Nil; Cons given rest -> type-metas st (given-type given) <> given-metas st rest
  evidence-metas :: Store -> CoreEvidence -> List (Nat, Kind)
  evidence-metas st evidence = case evidence of
    CENeeded s ty scope -> type-metas st ty <> given-metas st scope
    CEGiven s ty name -> type-metas st ty
    CEInstance s ty name actuals args -> type-metas st ty <> types-metas st actuals <> evidence-metas st args
    CEArgument s arg rest -> evidence-metas st arg <> evidence-metas st rest
    CEArgumentsEnd s -> Nil
  evidences-metas :: Store -> List CoreEvidence -> List (Nat, Kind)
  evidences-metas st evidences = case evidences of Nil -> Nil; Cons evidence rest -> evidence-metas st evidence <> evidences-metas st rest
  requirements-metas :: Store -> List Requirement -> List (Nat, Kind)
  requirements-metas st rs = case rs of Nil -> Nil; Cons r rest -> type-metas st (requirement-type r) <> requirements-metas st rest
  pattern-metas :: Store -> CorePattern -> List (Nat, Kind)
  pattern-metas st p = case p of
    CPWild s ty -> type-metas st ty
    CPVar s ty id name -> type-metas st ty
    CPProof s ty id name -> type-metas st ty
    CPErasedValue s ty id name -> type-metas st ty
    CPAs s ty id name inner -> type-metas st ty <> pattern-metas st inner
    CPConstructor s ty name actuals constructor fields -> type-metas st ty <> types-metas st actuals <> type-metas st constructor <> pattern-metas st fields
    CPInt s ty text -> type-metas st ty
    CPString s ty text -> type-metas st ty
    CPChar s ty text -> type-metas st ty
    CPTuple s ty fields -> type-metas st ty <> pattern-metas st fields
    CPField s x rest -> pattern-metas st x <> pattern-metas st rest
    CPDone s -> Nil
  term-metas :: Store -> CoreTerm -> List (Nat, Kind)
  term-metas st term = case term of
    CUse s ty name role actuals -> type-metas st ty <> types-metas st actuals
    CLocal s ty id name actuals -> type-metas st ty <> types-metas st actuals
    CProofRef s ty id name -> type-metas st ty
    CProofRefl s predicate -> type-metas st predicate
    CProofSearch s predicate assumption evidence -> type-metas st predicate
    CQualifiedUse s ty name role actuals evidence -> type-metas st ty <> types-metas st actuals <> evidences-metas st evidence
    CMethod s ty name owner slot actuals evidence -> type-metas st ty <> types-metas st actuals <> evidences-metas st evidence
    CInt s ty text -> type-metas st ty
    CString s ty text -> type-metas st ty
    CChar s ty text -> type-metas st ty
    CUnit s ty -> type-metas st ty
    CApply s ty f x -> type-metas st ty <> term-metas st f <> term-metas st x
    CApplyEff s ty row f x -> type-metas st ty <> type-metas st row <> term-metas st f <> term-metas st x
    CErasedApply s ty row f witness -> type-metas st ty <> type-metas st row <> term-metas st f <> term-metas st witness
    CDecision s ty predicate condition -> type-metas st ty <> type-metas st predicate <> term-metas st condition
    CScope s ty region evidence callback -> type-metas st ty <> type-metas st region <> evidence-metas st evidence <> term-metas st callback
    CMemoScope s ty region body -> type-metas st ty <> type-metas st region <> term-metas st body
    CSpawn s ty token body -> type-metas st ty <> term-metas st token <> term-metas st body
    CJoin s ty token body -> type-metas st ty <> term-metas st token <> term-metas st body
    CWith s ty given value body -> type-metas st ty <> type-metas st (given-type given) <> term-metas st value <> term-metas st body
    CHandler s ty returned operations -> type-metas st ty <> term-metas st returned <> term-metas st operations
    CHandle s ty label residual body handled-by -> type-metas st ty <> type-metas st label <> type-metas st residual <> term-metas st body <> term-metas st handled-by
    CHandlerOperation s slot openings row closure rest -> handler-opening-metas st openings <> type-metas st row <> term-metas st closure <> term-metas st rest
    CLambda s ty p body -> type-metas st ty <> pattern-metas st p <> term-metas st body
    CLet s ty id name sc rhs body -> type-metas st ty <> type-metas st (scheme-body sc) <> requirements-metas st (scheme-requirements sc) <> term-metas st rhs <> term-metas st body
    CRecursiveFunctions s ty members body -> type-metas st ty <> recursive-function-metas st members <> term-metas st body
    CRecursiveValues s ty region members body -> type-metas st ty <> type-metas st region <> recursive-function-metas st members <> term-metas st body
    CIf s ty condition yes no -> type-metas st ty <> term-metas st condition <> term-metas st yes <> term-metas st no
    CCase s ty value alts -> type-metas st ty <> term-metas st value <> term-metas st alts
    CTuple s ty fields -> type-metas st ty <> term-metas st fields
    CPolyIntro s ty poly-ids fields -> type-metas st ty <> term-metas st fields
    CPolyElim s ty fields poly-args -> type-metas st ty <> term-metas st fields
    CPrimitive s ty name args -> type-metas st ty <> term-metas st args
    CProved s ty evidence body -> type-metas st ty <> term-metas st body
    CRefine s ty evidence body -> type-metas st ty <> term-metas st body
    CRefineProof s ty witness body -> type-metas st ty <> term-metas st witness <> term-metas st body
    CForget s ty body -> type-metas st ty <> term-metas st body
    CRequire s ty body -> type-metas st ty <> term-metas st body
    CDischarge s ty evidence body -> type-metas st ty <> term-metas st body
    CGuard s ty guard rhs -> type-metas st ty <> term-metas st guard <> term-metas st rhs
    CArgument s x rest -> term-metas st x <> term-metas st rest
    CAlternative s p body rest -> pattern-metas st p <> term-metas st body <> term-metas st rest
    other -> Nil
  patterns-metas :: Store -> List CorePattern -> List (Nat, Kind)
  patterns-metas st patterns = case patterns of Nil -> Nil; Cons p rest -> pattern-metas st p <> patterns-metas st rest
  clauses-metas :: Store -> List CoreClause -> List (Nat, Kind)
  clauses-metas st clauses = case clauses of Nil -> Nil; Cons (MkCoreClause s ps body) rest -> patterns-metas st ps <> term-metas st body <> clauses-metas st rest
  has-id :: Nat -> List (Nat, Kind) -> Bool
  has-id id entries = case entries of Nil -> False; Cons (n, k) rest -> id == n || has-id id rest
  unique :: List (Nat, Kind) -> List (Nat, Kind) -> List (Nat, Kind)
  unique entries seen = case entries of Nil -> Nil; Cons (id, k) rest -> if has-id id seen then unique rest seen else Cons (id, k) (unique rest (Cons (id, k) seen))
  seal-patterns :: Store -> List CorePattern -> List CorePattern
  seal-patterns st ps = case ps of Nil -> Nil; Cons p rest -> Cons (map-pattern-types (freeze-type st) p) (seal-patterns st rest)
  seal-clauses :: BodyBindings -> List GuardedBinding -> Store -> List (List CorePattern) -> List CoreClause -> List CoreClause
  seal-clauses bodies guards st earlier clauses = case clauses of
    Nil -> Nil
    Cons (MkCoreClause s ps body) rest -> let patterns = seal-patterns st ps in
      let frozen = map-term-types (freeze-type st) body in
      let scope = with-guarded-bindings guards (with-checked-body-bindings bodies empty-proof-scope) in
      let gamma = proof-patterns patterns scope in
      let checked = refresh-certificates gamma (scoped-core-equation-facts gamma earlier patterns) frozen in
      Cons (MkCoreClause s patterns checked) (seal-clauses bodies guards st (extend-equation-prefix patterns checked earlier) rest)
  normalize-valid-type :: Store -> UType -> UType
  normalize-valid-type st ty = if valid-type ty then normalize st ty else UError
  seal-definition :: Store -> CoreDefinition -> CoreDefinition
  seal-definition st definition = seal-definition-with-bodies Nil st definition
  seal-definition-with-bodies :: List BodyBinding -> Store -> CoreDefinition -> CoreDefinition
  seal-definition-with-bodies bodies st definition = seal-definition-with-contracts bodies Nil st definition
  seal-definition-with-contracts :: List BodyBinding -> List GuardedBinding -> Store -> CoreDefinition -> CoreDefinition
  seal-definition-with-contracts bodies guards st definition = case check-body-bindings bodies of
    Some checked -> seal-definition-with-checked-contracts checked guards st definition
    None -> seal-definition-with-checked-contracts empty-body-bindings guards st definition
  seal-definition-with-checked-contracts :: BodyBindings -> List GuardedBinding -> Store -> CoreDefinition -> CoreDefinition
  seal-definition-with-checked-contracts bodies guards st definition = case definition of
    MkCoreDefinition s name sc openings givens private clauses ->
      MkCoreDefinition s name (map-scheme (normalize-valid-type st) sc) openings (map-givens (freeze-type st) givens)
        (unique (private <> given-metas st givens <> clauses-metas st clauses) Nil) (seal-clauses bodies guards st Nil clauses)

  closed-type :: UType -> Bool
  closed-type ty = case ty of
    UIndexForget value -> valid-type ty && typed-index-admissible ty && closed-type value
    UIndexByteLength value -> valid-type ty && typed-index-admissible ty && closed-type value
    UIndexBorrowRead value -> valid-type ty && typed-index-admissible ty && closed-type value
    UIndexList element fields -> valid-type ty && closed-type element && closed-type fields
    UIndexCall function args -> valid-type ty && typed-index-admissible ty && closed-type args
    UIndexPromote value -> valid-type ty && typed-index-admissible ty && closed-type value
    UIndexMath op left right -> valid-type ty && typed-index-admissible ty && closed-type left && closed-type right
    URefine id name carrier predicate -> valid-type ty && closed-type carrier && closed-type predicate
    URefineFormer name ids body -> valid-type ty && closed-type body
    UPropLit value -> valid-type ty && (True)
    UCompare relation left right -> valid-type ty && (closed-type left && closed-type right)
    UPropAnd left right -> valid-type ty && (closed-type left && closed-type right)
    UPropOr left right -> valid-type ty && (closed-type left && closed-type right)
    UPropNot body -> valid-type ty && (closed-type body)
    UPropNonZero body -> valid-type ty && (closed-type body)
    UPropNotNull body -> valid-type ty && (closed-type body)
    UPropAscii body -> valid-type ty && (closed-type body)
    UPropOrdered body -> valid-type ty && (closed-type body)
    UPropNonZeroPending body -> valid-type ty && (closed-type body)
    URequire predicates body -> valid-type ty && (closed-type predicates && closed-type body)
    UPi id name domain row result -> valid-type ty && closed-type domain && closed-type row && closed-type result
    UIndex carrier value -> valid-type ty && closed-type carrier && index-runtime-admissible carrier value && (case index-free-metas value of Nil -> True; other -> False)
    UMeta id k -> False
    UError -> False
    UCon name k -> valid-kind k && closed-kind k
    UBound id name k -> valid-kind k && closed-kind k
    URigid id name level k -> valid-kind k && closed-kind k
    UApp f x -> closed-type f && closed-type x
    UFun a b -> closed-type a && closed-type b
    UFunEff a row b -> closed-type a && closed-type row && closed-type b
    UUsageArrow usage arrow -> valid-type ty && closed-type arrow
    UProofFun a row b -> valid-type ty && closed-type a && closed-type row && closed-type b
    URow labels -> closed-type labels
    URowJoin a b -> closed-type a && closed-type b
    UTuple fields -> closed-type fields
    UForall qs body -> valid-type ty && closed-type body
    UArg x rest -> closed-type x && closed-type rest
    other -> True
  closed-kind :: Kind -> Bool
  closed-kind kind = case kind of KValue payload -> (case value-carrier kind of Some carrier -> closed-type carrier; None -> False); KFun a b -> closed-kind a && closed-kind b; other -> True
  closed-quants :: List Quant -> Bool
  closed-quants qs = case qs of Nil -> True; Cons q rest -> valid-kind (quant-kind q) && closed-kind (quant-kind q) && closed-quants rest
  closed-types :: List UType -> Bool
  closed-types types = case types of Nil -> True; Cons ty rest -> closed-type ty && closed-types rest
  requirements-closed :: List Requirement -> Bool
  requirements-closed rs = case rs of Nil -> True; Cons r rest -> closed-type (requirement-type r) && requirements-closed rest
  -- A value contract: the body is a value type. Operations and constructors
  -- genuinely need this (`effect-operations-closed`, `constructors-closed`,
  -- `constructor-pattern-supported`), because a constructor cannot return a
  -- proposition and an operation cannot perform one.
  scheme-closed :: Scheme -> Bool
  scheme-closed sc = kind-equal (type-kind (scheme-body sc)) KType && closed-quants (scheme-params sc) && closed-type (scheme-body sc) && requirements-closed (scheme-requirements sc)
  -- A DECLARATION contract: the body is a value type or a proposition.
  -- `same :: (value :: Bool) -> Eq value value` declares a proof former, so
  -- its body is a goal rather than a value; the seed accepts exactly that
  -- shape, and Bootstrap.Kinds' `declared-type` states the same rule. Using
  -- `scheme-closed` here refused every proof former, which is why an
  -- `Eq`-valued source function could not reach the global closure.
  declaration-scheme-closed :: Scheme -> Bool
  declaration-scheme-closed sc = declared-scheme-body (scheme-body sc) && closed-quants (scheme-params sc) && closed-type (scheme-body sc) && requirements-closed (scheme-requirements sc)
  declared-scheme-body :: UType -> Bool
  declared-scheme-body ty = valid-type ty && (if kind-equal (type-kind ty) KType then valid-kind (value-kind ty) else kind-equal (type-kind ty) KProp)
  givens-closed :: List CoreGiven -> Bool
  givens-closed givens = case givens of Nil -> True; Cons given rest -> closed-type (given-type given) && givens-closed rest
  evidence-closed :: CoreEvidence -> Bool
  evidence-closed evidence = case evidence of
    CENeeded s ty scope -> False
    CEGiven s ty name -> closed-type ty
    CEInstance s ty name actuals args -> closed-type ty && closed-types actuals && evidence-arguments-closed args
    other -> False
  evidence-arguments-closed :: CoreEvidence -> Bool
  evidence-arguments-closed args = case args of
    CEArgument s arg rest -> evidence-closed arg && evidence-arguments-closed rest
    CEArgumentsEnd s -> True
    other -> False
  evidences-closed :: List CoreEvidence -> Bool
  evidences-closed evidences = case evidences of Nil -> True; Cons evidence rest -> evidence-closed evidence && evidences-closed rest
  closed-runtime-type :: UType -> Bool
  closed-runtime-type ty = closed-type ty && kind-equal (type-kind ty) KType && (case ty of
    URequire predicates body -> False
    UArg first rest -> False
    UEnd -> False
    other -> True)

  valid-pattern :: CorePattern -> Bool
  valid-pattern p = case p of
    CPWild s ty -> closed-runtime-type ty
    CPVar s ty id name -> closed-runtime-type ty
    CPProof s ty id name -> closed-type ty && valid-type ty && kind-equal (type-kind ty) KProp
    CPErasedValue s ty id name -> closed-runtime-type ty
    CPAs s ty id name inner -> closed-runtime-type ty && valid-pattern inner
    CPConstructor s ty name actuals constructor fields -> closed-runtime-type ty && closed-types actuals && closed-type constructor && valid-pattern fields
    CPInt s ty text -> closed-runtime-type ty && valid-integer-literal ty text
    CPString s ty text -> closed-runtime-type ty
    CPChar s ty text -> closed-runtime-type ty
    CPTuple s ty fields -> closed-runtime-type ty && valid-pattern fields
    CPField s x rest -> valid-pattern x && valid-pattern rest
    CPDone s -> True
  -- Reflexivity checks the actual equality by conversion. An equality
  -- inferred with unsolved index metas cannot supply a witness.
  reflexive-equality :: UType -> Bool
  reflexive-equality predicate = closed-type predicate && valid-type predicate && (case predicate of
    UCompare relation left right -> string-compare relation "Eq" == 0 && contract-equal left right
    other -> False)
  -- Evidence is legal only in an erased operand position.
  valid-proof-reference :: CoreTerm -> Bool
  valid-proof-reference term = case term of
    CProofRef s predicate id name -> closed-type predicate && valid-type predicate && kind-equal (type-kind predicate) KProp
    CProofRefl s predicate -> reflexive-equality predicate
    CProofSearch s predicate assumption evidence -> closed-type predicate && kind-equal (type-kind predicate) KProp
    other -> False
  valid-term :: CoreTerm -> Bool
  valid-term term = case term of
    CUse s ty name role actuals -> closed-runtime-type ty && closed-types actuals
    CLocal s ty id name actuals -> closed-runtime-type ty && closed-types actuals
    CProofRef s ty id name -> False
    -- Reflexive evidence is a checked proof term, and a definition whose body
    -- is `refl` has exactly this shape: `same v = refl` declares a proof
    -- former. `valid-proof-reference` already accepts it under the same
    -- predicate, so refusing it here made every such definition fail
    -- `valid-clauses` before the proof-clause check could see it.
    CProofRefl s predicate -> reflexive-equality predicate
    CProofSearch s predicate assumption evidence -> False
    CDecision s ty predicate condition -> closed-runtime-type ty && closed-type predicate && valid-type predicate && kind-equal (type-kind predicate) KProp && valid-term condition
    CQualifiedUse s ty name role actuals evidence -> closed-runtime-type ty && closed-types actuals && evidences-closed evidence
    CMethod s ty name owner slot actuals evidence -> closed-runtime-type ty && closed-types actuals && evidences-closed evidence && (case evidence of Cons first rest -> True; Nil -> False)
    CInt s ty text -> closed-runtime-type ty && valid-number-literal ty text
    CString s ty text -> closed-runtime-type ty
    CChar s ty text -> closed-runtime-type ty
    CUnit s ty -> closed-runtime-type ty
    CApply s ty f x -> closed-runtime-type ty && valid-term f && valid-term x
    CApplyEff s ty row f x -> closed-runtime-type ty && closed-type row && kind-equal (type-kind row) KRow && valid-term f && valid-term x
    CErasedApply s ty row f witness -> closed-runtime-type ty && closed-type row && kind-equal (type-kind row) KRow && valid-term f
      && (if erased-value-arrow (core-type f) then valid-term witness && erasable-value-argument witness else valid-proof-reference witness)
    CScope s ty region evidence callback -> closed-runtime-type ty && closed-type region && scope-region-closed region ty && scope-region-closed region (core-effects term) && evidences-closed [evidence] && valid-term callback
    CMemoScope s ty region body -> closed-runtime-type ty && closed-type region && scope-region-closed region ty && scope-region-closed region (core-effects term) && valid-term body
    CSpawn s ty token body -> closed-runtime-type ty && valid-term token && valid-term body
    CJoin s ty token body -> closed-runtime-type ty && valid-term token && valid-term body
    CWith s ty given value body -> closed-runtime-type ty && closed-type (given-type given) && valid-term value && valid-term body
    CHandler s ty returned operations -> closed-runtime-type ty && valid-term returned && valid-term operations
    CHandle s ty label residual body handled-by -> closed-runtime-type ty && closed-type label && closed-type residual && valid-term body && valid-term handled-by
    CHandlerOperation s slot openings row closure rest -> closed-type row && handler-openings-closed openings && valid-term closure && valid-term rest
    CHandlerEnd s -> True
    CLambda s ty p body -> closed-runtime-type ty && valid-pattern p && valid-term body
    CLet s ty id name sc rhs body -> closed-runtime-type ty && scheme-closed sc && valid-term rhs && valid-term body
    CRecursiveFunctions s ty members body -> closed-runtime-type ty && valid-recursive-functions members && valid-term body
    CRecursiveValues s ty region members body -> closed-runtime-type ty && closed-type region
      && scope-region-closed region ty && scope-region-closed region (core-effects term)
      && valid-recursive-values members && valid-term body
    CRecursiveBinding id name value rest -> False
    CRecursiveBindingsEnd -> False
    CIf s ty condition yes no -> closed-runtime-type ty && valid-term condition && valid-term yes && valid-term no
    CCase s ty value alts -> closed-runtime-type ty && valid-term value && valid-term alts
    CTuple s ty fields -> closed-runtime-type ty && valid-term fields
    CPolyIntro s ty poly-ids fields -> closed-runtime-type ty && valid-term fields
    CPolyElim s ty fields poly-args -> closed-runtime-type ty && valid-term fields
    CPrimitive s ty name args -> closed-runtime-type ty && valid-term args
    CProved s ty evidence body -> closed-runtime-type ty && valid-term body
    CRefine s ty evidence body -> closed-runtime-type ty && valid-term body
    CRefineProof s ty witness body -> closed-runtime-type ty && valid-proof-reference witness && valid-term body
    CForget s ty body -> closed-runtime-type ty && valid-term body
    CRequire s ty body -> closed-type ty && valid-term body
    CDischarge s ty evidence body -> closed-runtime-type ty && valid-required-call body
    CGuard s ty guard rhs -> closed-runtime-type ty && valid-term guard && valid-term rhs
    CArgument s x rest -> valid-term x && valid-term rest
    CArgumentsEnd s -> True
    CAlternative s p body rest -> valid-pattern p && valid-term body && valid-term rest
    CAlternativesEnd s -> True
    CError s -> False
  recursive-function-metas :: Store -> CoreTerm -> List (Nat, Kind)
  recursive-function-metas st members = case members of
    CRecursiveBindingsEnd -> Nil
    CRecursiveBinding id name value rest -> term-metas st value <> recursive-function-metas st rest
    other -> Nil
  valid-recursive-values :: CoreTerm -> Bool
  valid-recursive-values members = case members of
    CRecursiveBindingsEnd -> True
    CRecursiveBinding id name value rest -> valid-term value && valid-recursive-values rest
    other -> False
  valid-recursive-functions :: CoreTerm -> Bool
  valid-recursive-functions members = case members of
    CRecursiveBindingsEnd -> True
    CRecursiveBinding id name (CLambda sp ty pattern body) rest ->
      valid-term (CLambda sp ty pattern body) && valid-recursive-functions rest
    other -> False
  valid-patterns :: List CorePattern -> Bool
  valid-patterns ps = case ps of Nil -> True; Cons p rest -> valid-pattern p && valid-patterns rest
  valid-clauses :: List CoreClause -> Bool
  valid-clauses clauses = case clauses of Nil -> True; Cons (MkCoreClause s ps body) rest -> valid-patterns ps && valid-term body && valid-clauses rest
  -- Local references use stable identities. Display names may shadow or
  -- change without changing binding. A let does not bind inside its RHS;
  -- lambda and case patterns extend only their own body scopes.
  local-id :: Nat -> List Nat -> Bool
  local-id id scope = case scope of Nil -> False; Cons first rest -> id == first || local-id id rest
  bind-local-id :: Nat -> List Nat -> Option (List Nat)
  bind-local-id id scope = if local-id id scope then None else Some (Cons id scope)
  recursive-id-scope :: List Nat -> List Nat -> Option (List Nat)
  recursive-id-scope ids scope = case ids of
    Nil -> Some scope
    Cons id rest -> case bind-local-id id scope of
      Some bound -> recursive-id-scope rest bound
      None -> None
  -- Value indices have their own bound/rigid namespaces. Type variables
  -- do not authorize a value index with the same printed name or number.
  kind-index-scope :: List Nat -> List Nat -> Kind -> Bool
  kind-index-scope bound rigid kind = case kind of
    KValue payload -> case value-carrier kind of Some carrier -> type-index-scope bound rigid carrier; None -> False
    KFun a b -> kind-index-scope bound rigid a && kind-index-scope bound rigid b
    other -> True
  type-index-scope :: List Nat -> List Nat -> UType -> Bool
  type-index-scope bound rigid ty = case ty of
    UPropLit value -> True
    UCompare relation left right -> type-index-scope bound rigid left && type-index-scope bound rigid right
    UPropAnd left right -> type-index-scope bound rigid left && type-index-scope bound rigid right
    UPropOr left right -> type-index-scope bound rigid left && type-index-scope bound rigid right
    UPropNot body -> type-index-scope bound rigid body
    UPropNonZero body -> type-index-scope bound rigid body
    UPropNotNull body -> type-index-scope bound rigid body
    UPropAscii body -> type-index-scope bound rigid body
    UPropOrdered body -> type-index-scope bound rigid body
    UPropNonZeroPending body -> type-index-scope bound rigid body
    URequire predicates body -> type-index-scope bound rigid predicates && type-index-scope bound rigid body
    URefine id name carrier predicate -> type-index-scope bound rigid carrier && type-index-scope (Cons id bound) rigid predicate
    URefineFormer name ids body -> type-index-scope ids Nil body
    UIndexForget value -> type-index-scope bound rigid value
    UIndexByteLength value -> type-index-scope bound rigid value
    UIndexBorrowRead value -> type-index-scope bound rigid value
    UIndexList element fields -> type-index-scope bound rigid element && type-index-scope bound rigid fields
    UIndexCall function args -> type-index-scope bound rigid args
    UIndexPromote value -> type-index-scope bound rigid value
    UIndexMath op left right -> type-index-scope bound rigid left && type-index-scope bound rigid right
    UIndex carrier value -> type-index-scope bound rigid carrier && index-scoped bound rigid Nil value
    UPi id name domain row result -> type-index-scope bound rigid domain && type-index-scope (Cons id bound) rigid row && type-index-scope (Cons id bound) rigid result
    UBound id name kind -> kind-index-scope bound rigid kind && (case value-carrier kind of Some carrier -> local-id id bound; None -> True)
    URigid id name level kind -> kind-index-scope bound rigid kind && (case value-carrier kind of Some carrier -> local-id id rigid; None -> True)
    UMeta id kind -> False
    UCon name kind -> kind-index-scope bound rigid kind && (case value-carrier kind of Some carrier -> False; None -> True)
    UApp a b -> type-index-scope bound rigid a && type-index-scope bound rigid b
    UFun a b -> type-index-scope bound rigid a && type-index-scope bound rigid b
    UFunEff a row b -> type-index-scope bound rigid a && type-index-scope bound rigid row && type-index-scope bound rigid b
    UUsageArrow usage arrow -> valid-type ty && type-index-scope bound rigid arrow
    UProofFun a row b -> type-index-scope bound rigid a && type-index-scope bound rigid row && type-index-scope bound rigid b
    URow labels -> type-index-scope bound rigid labels
    URowJoin a b -> type-index-scope bound rigid a && type-index-scope bound rigid b
    UTuple fields -> type-index-scope bound rigid fields
    UForall qs body -> type-index-scope bound rigid body
    UArg a rest -> type-index-scope bound rigid a && type-index-scope bound rigid rest
    UEnd -> True
    UError -> False
  types-index-scope :: List Nat -> List Nat -> List UType -> Bool
  types-index-scope bound rigid types = case types of Nil -> True; Cons ty rest -> type-index-scope bound rigid ty && types-index-scope bound rigid rest
  quant-index-bounds :: List Quant -> List Nat -> List Nat
  quant-index-bounds qs bound = case qs of
    Nil -> bound
    Cons q rest -> quant-index-bounds rest (case value-carrier (quant-kind q) of Some carrier -> Cons (quant-id q) bound; None -> bound)
  quant-index-scope :: List Quant -> List Nat -> List Nat -> Bool
  quant-index-scope qs bound rigid = case qs of
    Nil -> True
    Cons q rest -> kind-index-scope bound rigid (quant-kind q) && quant-index-scope rest (case value-carrier (quant-kind q) of Some carrier -> Cons (quant-id q) bound; None -> bound) rigid
  requirements-index-scope :: List Nat -> List Nat -> List Requirement -> Bool
  requirements-index-scope bound rigid rs = case rs of Nil -> True; Cons r rest -> type-index-scope bound rigid (requirement-type r) && requirements-index-scope bound rigid rest
  scheme-index-scope :: List Nat -> Scheme -> Bool
  scheme-index-scope rigid sc = scheme-index-scope-with Nil rigid sc
  scheme-index-scope-with :: List Nat -> List Nat -> Scheme -> Bool
  scheme-index-scope-with universals rigid sc = let bound = quant-index-bounds (scheme-params sc) universals in
    quant-index-scope (scheme-params sc) universals rigid && type-index-scope bound rigid (scheme-body sc) && requirements-index-scope bound rigid (scheme-requirements sc)
  opening-type :: Nat -> List (Nat, UType) -> Option UType
  opening-type id pairs = case pairs of Nil -> None; Cons (key, ty) rest -> if id == key then Some ty else opening-type id rest
  opening-value-types :: List (Nat, UType) -> List (Nat, UType)
  opening-value-types openings = case openings of
    Nil -> Nil
    Cons (key, value) rest -> (case (value-carrier (type-kind value), index-of-type value) of
      (Some carrier, Some (IRigid id name level)) -> Cons (id, carrier) (opening-value-types rest)
      other -> opening-value-types rest)
  opening-value-patterns :: Span -> List (Nat, UType) -> List CorePattern
  opening-value-patterns sp openings = value-type-patterns sp (opening-value-types openings)
  value-type-patterns :: Span -> List (Nat, UType) -> List CorePattern
  value-type-patterns sp values = case values of Nil -> Nil; Cons (id, carrier) rest -> Cons (CPVar sp carrier id "#implicit-value") (value-type-patterns sp rest)
  opening-value-ids :: List Quant -> List (Nat, UType) -> List Nat
  opening-value-ids qs pairs = case qs of
    Nil -> Nil
    Cons q rest -> let more = opening-value-ids rest pairs in case value-carrier (quant-kind q) of
      None -> more
      Some carrier -> case opening-type (quant-id q) pairs of
        Some ty -> (case index-of-type ty of Some (IRigid id name level) -> Cons id more; other -> more)
        None -> more
  givens-index-scope :: List Nat -> List CoreGiven -> Bool
  givens-index-scope rigid givens = case givens of Nil -> True; Cons given rest -> type-index-scope Nil rigid (given-type given) && givens-index-scope rigid rest
  evidence-index-scope :: List Nat -> CoreEvidence -> Bool
  evidence-index-scope rigid evidence = evidence-index-scope-with Nil rigid evidence
  evidences-index-scope :: List Nat -> List CoreEvidence -> Bool
  evidences-index-scope rigid evidence = evidences-index-scope-with Nil rigid evidence
  pattern-scope :: List Nat -> CorePattern -> List Nat -> Option (List Nat)
  pattern-scope values pattern scope = pattern-scope-with Nil values pattern scope
  patterns-scope :: List Nat -> List CorePattern -> List Nat -> Option (List Nat)
  patterns-scope values patterns scope = patterns-scope-with Nil values patterns scope
  scoped-term :: List Nat -> List Nat -> CoreTerm -> Bool
  scoped-term values scope term = scoped-term-with Nil values scope term
  -- A let scheme's value quantifiers scope over its RHS only. Keep this
  -- bound namespace separate from rigid runtime locals and the let body.
  evidence-index-scope-with :: List Nat -> List Nat -> CoreEvidence -> Bool
  evidence-index-scope-with universals rigid evidence = case evidence of
    CENeeded s ty scope -> False
    CEGiven s ty name -> type-index-scope universals rigid ty
    CEInstance s ty name actuals args -> type-index-scope universals rigid ty && types-index-scope universals rigid actuals && evidence-index-scope-with universals rigid args
    CEArgument s arg rest -> evidence-index-scope-with universals rigid arg && evidence-index-scope-with universals rigid rest
    CEArgumentsEnd s -> True
  evidences-index-scope-with :: List Nat -> List Nat -> List CoreEvidence -> Bool
  evidences-index-scope-with universals rigid evidence = case evidence of Nil -> True; Cons first rest -> evidence-index-scope-with universals rigid first && evidences-index-scope-with universals rigid rest
  pattern-scope-with :: List Nat -> List Nat -> CorePattern -> List Nat -> Option (List Nat)
  pattern-scope-with universals values pattern scope = case pattern of
    CPVar s ty id name -> if type-index-scope universals (values <> scope) ty then bind-local-id id scope else None
    CPProof s ty id name -> if type-index-scope universals (values <> scope) ty then bind-local-id id scope else None
    CPErasedValue s ty id name -> if type-index-scope universals (values <> scope) ty then bind-local-id id scope else None
    CPAs s ty id name inner -> if type-index-scope universals (values <> scope) ty then (case bind-local-id id scope of Some bound -> pattern-scope-with universals values inner bound; None -> None) else None
    CPConstructor s ty name actuals constructor fields -> if type-index-scope universals (values <> scope) ty && types-index-scope universals (values <> scope) actuals && type-index-scope universals (values <> scope) constructor then pattern-scope-with universals values fields scope else None
    CPTuple s ty fields -> if type-index-scope universals (values <> scope) ty then pattern-scope-with universals values fields scope else None
    CPField s first rest -> case pattern-scope-with universals values first scope of Some bound -> pattern-scope-with universals values rest bound; None -> None
    CPWild s ty -> if type-index-scope universals (values <> scope) ty then Some scope else None
    CPInt s ty text -> if type-index-scope universals (values <> scope) ty then Some scope else None
    CPString s ty text -> if type-index-scope universals (values <> scope) ty then Some scope else None
    CPChar s ty text -> if type-index-scope universals (values <> scope) ty then Some scope else None
    CPDone s -> Some scope
  patterns-scope-with :: List Nat -> List Nat -> List CorePattern -> List Nat -> Option (List Nat)
  patterns-scope-with universals values patterns scope = case patterns of
    Nil -> Some scope
    Cons pattern rest -> case pattern-scope-with universals values pattern scope of Some bound -> patterns-scope-with universals values rest bound; None -> None
  scoped-term-with :: List Nat -> List Nat -> List Nat -> CoreTerm -> Bool
  scoped-term-with universals values scope term =
    let rigid = values <> scope in
    let typed = case term of CHandlerOperation s slot openings row closure rest -> True; CHandlerEnd s -> True; CArgument s value rest -> True; CArgumentsEnd s -> True; CAlternative s p body rest -> True; CAlternativesEnd s -> True; other -> type-index-scope universals rigid (core-type term) in
    typed && (case term of
      CLocal s ty id name actuals -> local-id id scope && types-index-scope universals rigid actuals
      CProofRef s ty id name -> local-id id scope
      CDecision s ty predicate condition -> type-index-scope universals rigid predicate && scoped-term-with universals values scope condition
      CUse s ty name role actuals -> not (string-compare role "local" == 0) && types-index-scope universals rigid actuals
      CQualifiedUse s ty name role actuals evidence -> not (string-compare role "local" == 0) && types-index-scope universals rigid actuals && evidences-index-scope-with universals rigid evidence
      CMethod s ty name owner slot actuals evidence -> types-index-scope universals rigid actuals && evidences-index-scope-with universals rigid evidence
      CLambda s ty pattern body -> (case pattern-scope-with universals values pattern scope of Some bound -> scoped-term-with universals values bound body; None -> False)
      CLet s ty id name scheme rhs body -> scheme-index-scope-with universals rigid scheme && scoped-term-with (quant-index-bounds (scheme-params scheme) universals) values scope rhs && (case bind-local-id id scope of Some bound -> scoped-term-with universals values bound body; None -> False)
      CRecursiveFunctions s ty members body -> (case recursive-id-scope (recursive-function-ids members) scope of
        Some bound -> scoped-recursive-functions universals values bound members && scoped-term-with universals values bound body
        None -> False)
      CRecursiveValues s ty region members body -> type-index-scope universals rigid region
        && (case recursive-id-scope (recursive-function-ids members) scope of
          Some bound -> scoped-recursive-functions universals values bound members && scoped-term-with universals values bound body
          None -> False)
      CApply s ty f x -> scoped-term-with universals values scope f && scoped-term-with universals values scope x
      CApplyEff s ty row f x -> type-index-scope universals rigid row && scoped-term-with universals values scope f && scoped-term-with universals values scope x
      CErasedApply s ty row f witness -> type-index-scope universals rigid row && scoped-term-with universals values scope f && scoped-term-with universals values scope witness
      CScope s ty region evidence callback -> type-index-scope universals rigid region && evidence-index-scope-with universals rigid evidence && scoped-term-with universals values scope callback
      CMemoScope s ty region body -> type-index-scope universals rigid region && scoped-term-with universals values scope body
      CSpawn s ty token body -> scoped-term-with universals values scope token && scoped-term-with universals values scope body
      CJoin s ty token body -> scoped-term-with universals values scope token && scoped-term-with universals values scope body
      CWith s ty given value body -> type-index-scope universals rigid (given-type given) && scoped-term-with universals values scope value && scoped-term-with universals values scope body
      CHandler s ty returned operations -> scoped-term-with universals values scope returned && scoped-term-with universals values scope operations
      CHandle s ty label residual body handled-by -> type-index-scope universals rigid label && type-index-scope universals rigid residual && scoped-term-with universals values scope body && scoped-term-with universals values scope handled-by
      CHandlerOperation s slot openings row closure rest -> let opened = handler-opening-values openings <> values in
        type-index-scope universals (opened <> scope) row && scoped-term-with universals opened scope closure && scoped-term-with universals values scope rest
      CIf s ty condition yes no -> scoped-term-with universals values scope condition && scoped-term-with universals values scope yes && scoped-term-with universals values scope no
      CCase s ty value alternatives -> scoped-term-with universals values scope value && scoped-term-with universals values scope alternatives
      CTuple s ty fields -> scoped-term-with universals values scope fields
      CPolyIntro s ty poly-ids fields -> scoped-term-with universals values scope fields
      CPolyElim s ty fields poly-args -> scoped-term-with universals values scope fields
      CPrimitive s ty name args -> scoped-term-with universals values scope args
      CProved s ty evidence body -> scoped-term-with universals values scope body
      CRefine s ty evidence body -> scoped-term-with universals values scope body
      CRefineProof s ty witness body -> scoped-term-with universals values scope witness && scoped-term-with universals values scope body
      CForget s ty body -> scoped-term-with universals values scope body
      CRequire s ty body -> scoped-term-with universals values scope body
      CDischarge s ty evidence body -> scoped-term-with universals values scope body
      CGuard s ty condition body -> scoped-term-with universals values scope condition && scoped-term-with universals values scope body
      CArgument s value rest -> scoped-term-with universals values scope value && scoped-term-with universals values scope rest
      CAlternative s pattern body rest -> (case pattern-scope-with universals values pattern scope of Some bound -> scoped-term-with universals values bound body; None -> False) && scoped-term-with universals values scope rest
      other -> True)
  scoped-clauses :: List Nat -> List CoreClause -> Bool
  scoped-clauses values clauses = case clauses of
    Nil -> True
    Cons (MkCoreClause s patterns body) rest -> (case patterns-scope values patterns values of Some bound -> scoped-term values bound body; None -> False) && scoped-clauses values rest
  -- These checks cover lexical identities, index references and operation
  -- certificates. An independent full typing/kind kernel remains separate.
  core-definition-closed :: CoreDefinition -> Bool
  core-definition-closed definition = core-definition-bodies-closed Nil definition
  core-definition-bodies-closed :: List BodyBinding -> CoreDefinition -> Bool
  core-definition-bodies-closed bodies definition = core-definition-contracts-closed bodies Nil definition
  core-definition-contracts-closed :: List BodyBinding -> List GuardedBinding -> CoreDefinition -> Bool
  core-definition-contracts-closed bodies guards definition = case check-body-bindings bodies of
    Some checked -> core-definition-checked-contracts-closed checked guards definition
    None -> False
  core-definition-checked-contracts-closed :: BodyBindings -> List GuardedBinding -> CoreDefinition -> Bool
  core-definition-checked-contracts-closed checked guards definition = let bodies = body-bindings-members checked in guarded-bindings-closed guards && (case definition of
    -- A definition's scheme is a DECLARATION contract, so its body may be a
    -- proposition: `same v = refl` defines a proof former. `scheme-closed`
    -- would demand a value kind and refuse every proof former here.
    MkCoreDefinition s name sc openings givens private clauses -> let values = opening-value-ids (scheme-params sc) openings in
      declaration-scheme-closed sc && scheme-index-scope Nil sc && givens-closed givens && givens-index-scope values givens && valid-clauses clauses && scoped-clauses values clauses && body-scheme-authorized bodies sc && proof-contract-clauses-checked checked guards (opening-value-types openings) (substitute-bound openings (scheme-body sc)) clauses)

  -- The definition conjunction above folds nine tests into one `Bool`. This
  -- reports the first that refused, so a refusal names a clause instead of
  -- the whole definition.
  core-definition-refusal :: BodyBindings -> List GuardedBinding -> CoreDefinition -> Option String
  core-definition-refusal checked guards definition = let bodies = body-bindings-members checked in
    if not (guarded-bindings-closed guards) then Some "a guarded binding is not closed"
    else case definition of
      MkCoreDefinition s name sc openings givens private clauses -> let values = opening-value-ids (scheme-params sc) openings in
        if not (declaration-scheme-closed sc) then Some "the scheme body is neither a value type nor a proposition"
        else if not (scheme-index-scope Nil sc) then Some "a scheme index is out of scope"
        else if not (givens-closed givens) then Some "a given is not closed"
        else if not (givens-index-scope values givens) then Some "a given index is out of scope"
        else if not (valid-clauses clauses) then Some "a clause pattern or term is invalid"
        else if not (scoped-clauses values clauses) then Some "a clause body is not scoped"
        else if not (body-scheme-authorized bodies sc) then Some "the scheme names a body it is not authorized to"
        else if not (proof-contract-clauses-checked checked guards (opening-value-types openings) (substitute-bound openings (scheme-body sc)) clauses) then Some "a proof clause does not discharge its goal"
        else None
  -- Operation certificates are rechecked against facts derived from the
  -- retained Core control flow. Display names never identify proof values.
  number-sort :: UType -> Option String
  number-sort ty = case ty of UCon name KType -> if string-compare name "Nat" == 0 || string-compare name "Int" == 0 then Some name else None; other -> None
  nat-type :: UType -> Bool
  nat-type ty = case number-sort ty of Some name -> string-compare name "Nat" == 0; None -> False
  bool-type :: UType -> Bool
  bool-type ty = case ty of UCon name KType -> string-compare name "Bool" == 0; other -> False
  same-number-sort :: UType -> UType -> Bool
  same-number-sort a b = case (number-sort a, number-sort b) of (Some x, Some y) -> string-compare x y == 0; other -> False
  proof-variable :: Nat -> Arithmetic
  proof-variable id = AVariable (string-concat "#value:" (nat-to-string id))
  borrow-read-variable :: Nat -> Arithmetic
  borrow-read-variable id = AVariable (string-concat "#borrow-read:" (nat-to-string id))
  -- Types and checked local definitions occupy separate context fields.
  -- Elaboration may supply checked witness hints; closed Core reconstructs
  -- every definition from the actual strict let RHS before checking its body.
  data ProofScope where
    MkProofScope :: List (Nat, UType) -> List (Nat, UType) -> List (Nat, UType) -> BodyBindings -> List GuardedBinding -> ProofScope
  empty-proof-scope :: ProofScope
  empty-proof-scope = MkProofScope Nil Nil Nil empty-body-bindings Nil
  scope-bodies :: ProofScope -> List BodyBinding
  scope-bodies scope = case scope of MkProofScope types values proofs bodies guards -> body-bindings-members bodies
  with-body-bindings :: List BodyBinding -> ProofScope -> ProofScope
  with-body-bindings bindings scope = case check-body-bindings bindings of Some checked -> with-checked-body-bindings checked scope; None -> scope
  with-checked-body-bindings :: BodyBindings -> ProofScope -> ProofScope
  with-checked-body-bindings bindings scope = case scope of MkProofScope types values proofs old guards -> MkProofScope types values proofs bindings guards
  scope-types :: ProofScope -> List (Nat, UType)
  scope-types scope = case scope of MkProofScope types values proofs bodies guards -> types
  scope-entry :: Nat -> List (Nat, UType) -> Option UType
  scope-entry id entries = case entries of Nil -> None; Cons (key, value) rest -> if id == key then Some value else scope-entry id rest
  scope-value :: Nat -> ProofScope -> Option UType
  scope-value id scope = case scope of MkProofScope types values proofs bodies guards -> scope-entry id values
  scope-remove :: Nat -> List (Nat, UType) -> List (Nat, UType)
  scope-remove id entries = case entries of Nil -> Nil; Cons (key, value) rest -> if id == key then scope-remove id rest else Cons (key, value) (scope-remove id rest)
  scope-without-value :: Nat -> ProofScope -> ProofScope
  scope-without-value id scope = case scope of MkProofScope types values proofs bodies guards -> MkProofScope types (scope-remove id values) proofs bodies guards
  scope-local :: Nat -> UType -> ProofScope -> ProofScope
  scope-local id ty scope = case scope of MkProofScope types values proofs bodies guards -> MkProofScope (Cons (id, ty) types) (scope-remove id values) (scope-remove id proofs) bodies guards
  scope-index-valid :: UType -> UType -> Bool
  scope-index-valid carrier value = valid-type value && typed-index-admissible value && kind-equal (type-kind value) (value-kind carrier)
  scope-definitions :: List (Nat, UType) -> List (Nat, UType) -> List (Nat, UType)
  scope-definitions types values = case values of
    Nil -> Nil
    Cons (id, value) rest -> case scope-entry id types of
      Some carrier -> if scope-index-valid carrier value then Cons (id, value) (scope-definitions types rest) else scope-definitions types rest
      None -> scope-definitions types rest
  make-proof-scope :: List (Nat, UType) -> List (Nat, UType) -> ProofScope
  make-proof-scope types values = MkProofScope types (scope-definitions types values) Nil empty-body-bindings Nil
  scope-index :: ProofScope -> Nat -> String -> UType -> Option UType
  scope-index scope id name ty = case proof-local id scope of
    Some declared -> if not (contract-equal ty declared) then None else case scope-value id scope of
      Some value -> if scope-index-valid declared value then Some value else None
      None -> Some (UIndex ty (IRigid id name 0))
    None -> None
  -- Class identity and a method slot do not establish the selected body's
  -- numeric semantics. Such a strict RHS still binds a fresh runtime value;
  -- it cannot become a definitional arithmetic alias without body authority.
  stable-index-source :: CoreTerm -> Bool
  stable-index-source term = case term of
    CLocal sp ty id name Nil -> True
    CInt sp ty text -> True
    CRefine sp ty certificate body -> stable-index-source body
    CRefineProof sp ty witness body -> stable-index-source body
    CForget sp ty body -> stable-index-source body
    CProved sp ty certificate body -> stable-index-source body
    CDischarge sp ty certificates body -> (case core-mutable-writes body of Nil -> True; other -> False)
    CPrimitive sp ty operation (CArgument a first (CArgument b second (CArgumentsEnd end))) ->
      (string-compare operation "+" == 0 || string-compare operation "-" == 0 || string-compare operation "*" == 0) && stable-index-source first && stable-index-source second
    CPrimitive sp ty operation (CArgument a input (CArgumentsEnd end)) -> string-compare operation "negate" == 0 && stable-index-source input
    -- A numeric method application is a primitive operation on its
    -- operands; the arithmetic reading still decides whether it has an
    -- index, so an arbitrary method supplies nothing here.
    CApply sp ty (CApply partial function method first) second -> stable-index-source first && stable-index-source second
    CApply sp ty (CUse at function symbol role Nil) input -> byte-length-function ty function symbol role && stable-index-source input
    other -> False
  scoped-recursive-functions :: List Nat -> List Nat -> List Nat -> CoreTerm -> Bool
  scoped-recursive-functions universals values scope members = case members of
    CRecursiveBindingsEnd -> True
    CRecursiveBinding id name value rest ->
      scoped-term-with universals values scope value && scoped-recursive-functions universals values scope rest
    other -> False
  recursive-proof-scope :: ProofScope -> CoreTerm -> ProofScope
  recursive-proof-scope scope members = case members of
    CRecursiveBindingsEnd -> scope
    CRecursiveBinding id name value rest -> recursive-proof-scope (scope-local id (core-type value) scope) rest
    other -> scope
  scope-let :: ProofScope -> List Proposition -> Nat -> Scheme -> CoreTerm -> ProofScope
  scope-let scope facts id scheme rhs = let bound = scope-local id (scheme-body scheme) scope in
    case (scheme-params scheme, scheme-requirements scheme) of
      (Nil, Nil) -> if not (stable-index-source rhs && contract-equal (scheme-body scheme) (core-type rhs)) then bound else case actual-index scope facts rhs of
        Some value -> if not (volatile-borrow-index value) && scope-index-valid (scheme-body scheme) value then
          (case bound of MkProofScope types values proofs bodies guards -> MkProofScope types (Cons (id, value) values) proofs bodies guards) else bound
        None -> bound
      other -> bound

  scope-erased :: Nat -> UType -> ProofScope -> ProofScope
  scope-erased id predicate gamma = case gamma of
    MkProofScope types values proofs bodies guards -> MkProofScope (scope-remove id types) (scope-remove id values) (Cons (id, predicate) (scope-remove id proofs)) bodies guards

  write-matches :: Option UType -> UType -> Bool
  write-matches region actual = case region of Some wanted -> contract-equal wanted actual; None -> True
  arithmetic-mentions :: Arithmetic -> Arithmetic -> Bool
  arithmetic-mentions needle expression = case expression of
    AVariable name -> arithmetic-equal needle expression
    APlus a b -> arithmetic-mentions needle a || arithmetic-mentions needle b
    AMinus a b -> arithmetic-mentions needle a || arithmetic-mentions needle b
    ATimes a b -> arithmetic-mentions needle a || arithmetic-mentions needle b
    ACall name args -> arithmetic-mentions needle args
    AArgument first rest -> arithmetic-mentions needle first || arithmetic-mentions needle rest
    other -> False
  fact-mentions :: Arithmetic -> Proposition -> Bool
  fact-mentions needle fact = case fact of
    PCompare relation a b -> arithmetic-mentions needle a || arithmetic-mentions needle b
    PBoth a b -> fact-mentions needle a || fact-mentions needle b
    PEither a b -> fact-mentions needle a || fact-mentions needle b
    PNegate body -> fact-mentions needle body
    other -> False
  fact-written :: List (Nat, UType) -> Option UType -> Proposition -> Bool
  fact-written locals region fact = case locals of
    Nil -> False
    Cons (id, ty) rest -> (case mutable-borrow ty of
      Some (owner, carrier) -> write-matches region owner && fact-mentions (borrow-read-variable id) fact
      None -> False) || fact-written rest region fact
  mutable-fact-write :: ProofScope -> List (Span, Option UType) -> Proposition -> Option Span
  mutable-fact-write gamma writes fact = case writes of
    Nil -> None
    Cons (sp, region) rest -> if fact-written (scope-types gamma) region fact then Some sp else mutable-fact-write gamma rest fact
  borrow-index-regions :: UType -> List UType
  borrow-index-regions ty = case ty of
    UIndexBorrowRead (UIndex borrow (IRigid id name level)) -> (case mutable-borrow borrow of Some (region, carrier) -> [region]; None -> Nil)
    UCompare relation a b -> borrow-index-regions a <> borrow-index-regions b
    UPropAnd a b -> borrow-index-regions a <> borrow-index-regions b
    UPropOr a b -> borrow-index-regions a <> borrow-index-regions b
    UPropNot a -> borrow-index-regions a
    UPropNonZero a -> borrow-index-regions a
    UPropNonZeroPending a -> borrow-index-regions a
    UPropNotNull a -> borrow-index-regions a
    UPropAscii a -> borrow-index-regions a
    UPropOrdered a -> borrow-index-regions a
    UIndexForget a -> borrow-index-regions a
    UIndexByteLength a -> borrow-index-regions a
    UIndexPromote a -> borrow-index-regions a
    UIndexMath op a b -> borrow-index-regions a <> borrow-index-regions b
    UIndexCall function args -> borrow-index-regions args
    UIndexList element args -> borrow-index-regions args
    UArg a rest -> borrow-index-regions a <> borrow-index-regions rest
    URequire conditions body -> borrow-index-regions conditions <> borrow-index-regions body
    URefine id name carrier predicate -> borrow-index-regions carrier <> borrow-index-regions predicate
    URefineFormer name ids body -> borrow-index-regions body
    UIndex carrier value -> borrow-index-regions carrier
    UPi id name domain row result -> borrow-index-regions domain <> borrow-index-regions row <> borrow-index-regions result
    UApp f x -> borrow-index-regions f <> borrow-index-regions x
    UFun a b -> borrow-index-regions a <> borrow-index-regions b
    UFunEff a row b -> borrow-index-regions a <> borrow-index-regions row <> borrow-index-regions b
    UUsageArrow usage arrow -> borrow-index-regions arrow
    UProofFun a row b -> borrow-index-regions a <> borrow-index-regions row <> borrow-index-regions b
    URow labels -> borrow-index-regions labels
    URowJoin a b -> borrow-index-regions a <> borrow-index-regions b
    UTuple fields -> borrow-index-regions fields
    UForall qs body -> borrow-index-regions body
    other -> Nil
  volatile-borrow-index :: UType -> Bool
  volatile-borrow-index ty = case borrow-index-regions ty of Nil -> False; other -> True
  predicate-written :: Option UType -> List UType -> Bool
  predicate-written region regions = case regions of Nil -> False; Cons first rest -> write-matches region first || predicate-written region rest
  mutable-predicate-write :: List (Span, Option UType) -> UType -> Option Span
  mutable-predicate-write writes predicate = case writes of
    Nil -> None
    Cons (sp, region) rest -> if predicate-written region (borrow-index-regions predicate) then Some sp else mutable-predicate-write rest predicate
  facts-after-writes :: ProofScope -> List Proposition -> List (Span, Option UType) -> List Proposition
  facts-after-writes gamma facts writes = case (writes, facts) of
    (Nil, other) -> facts
    (other, Nil) -> Nil
    (other, Cons first rest) -> let live = facts-after-writes gamma rest writes in
      (case mutable-fact-write gamma writes first of None -> Cons first live; Some sp -> live)
  erased-after-writes :: List (Nat, UType) -> List (Span, Option UType) -> List (Nat, UType)
  erased-after-writes proofs writes = case proofs of
    Nil -> Nil
    Cons (id, predicate) rest -> let live = erased-after-writes rest writes in
      (case mutable-predicate-write writes predicate of None -> Cons (id, predicate) live; Some sp -> live)
  proof-after-writes :: ProofScope -> List (Span, Option UType) -> ProofScope
  proof-after-writes gamma writes = case (gamma, writes) of
    (scope, Nil) -> scope
    (MkProofScope types values proofs bodies guards, other) ->
      MkProofScope types values (erased-after-writes proofs writes) bodies guards
  scoped-proof-reference :: ProofScope -> UType -> CoreTerm -> Bool
  scoped-proof-reference gamma expected term = valid-type expected && kind-equal (type-kind expected) KProp && (case (gamma, term) of
    (MkProofScope types values proofs bodies guards, CProofRef s predicate id name) -> valid-proof-reference term && contract-equal expected predicate
      && (case scope-entry id proofs of Some declared -> valid-type declared && kind-equal (type-kind declared) KProp && contract-equal predicate declared; None -> False)
    (scope, CProofRefl s predicate) -> reflexive-equality predicate && contract-equal expected predicate
    other -> False)
  -- These identities and schemes belong to the kernel. In particular a
  -- constructor's source proof slot is absent from its runtime payload.
  decision-type :: UType -> UType
  decision-type predicate = UApp (UCon "b.Dec" (KFun KProp KType)) predicate
  decision-constructor-scheme :: String -> Option Scheme
  decision-constructor-scheme name =
    let predicate = UBound 0 "p" KProp in
    let result = decision-type predicate in
    if string-compare name "b.Yes" == 0 then Some (MkScheme [MkQuant 0 "p" KProp False] (UProofFun predicate (URow UEnd) result))
    else if string-compare name "b.No" == 0 then Some (MkScheme [MkQuant 0 "p" KProp False] (UProofFun (UPropNot predicate) (URow UEnd) result))
    else None
  decision-constant :: Bool -> CoreTerm -> Bool
  decision-constant expected term = bool-type (core-type term) && (case term of
    CPrimitive sp ty operation (CArgumentsEnd end) -> string-compare operation (if expected then "decision-true" else "decision-false") == 0
    other -> False)
  -- A global call needs its exact checked body association and complete
  -- application. A name, type annotation or opaque class projection cannot
  -- supply numeric authority for a decision.
  decision-total-operand :: ProofScope -> List Proposition -> CoreTerm -> Bool
  decision-total-operand gamma facts term = integer-carrier (core-type term)
    && contract-equal (core-effects term) (URow UEnd)
    && (case checked-total-index gamma facts term of Some index -> typed-index-admissible index; None -> False)
  decision-operand :: ProofScope -> List Proposition -> CoreTerm -> Bool
  decision-operand gamma facts term = case term of
    CInt sp ty text -> integer-carrier ty && valid-integer-literal ty text
    CLocal sp ty id name Nil -> integer-carrier ty && (case proof-local id gamma of Some declared -> contract-equal ty declared; None -> False)
    CForget sp ty body -> integer-carrier ty && forgotten gamma facts ty body && (case body of CLocal at actual id name Nil -> True; other -> decision-operand gamma facts body)
    CRefine sp ty certificate body -> certified-refinement gamma facts ty certificate body && decision-operand gamma facts body
    CRefineProof sp ty witness body -> scoped-refinement-proof gamma facts ty witness body && decision-operand gamma facts body
    CProved sp ty certificate body -> certified-operation gamma facts ty certificate body && (case body of
      CPrimitive at result operation (CArgument a first (CArgument b second (CArgumentsEnd end))) -> decision-operand gamma facts first && decision-operand gamma facts second
      other -> False)
    CPrimitive sp ty operation (CArgument a first (CArgument b second (CArgumentsEnd end))) -> same-number-sort ty (core-type first) && same-number-sort ty (core-type second)
      && (string-compare operation "+" == 0 || string-compare operation "*" == 0 || (string-compare operation "-" == 0 && not (nat-type ty)))
      && decision-operand gamma facts first && decision-operand gamma facts second
    CPrimitive sp ty operation (CArgument a first (CArgumentsEnd end)) ->
      if string-compare operation "copy-out" == 0 then
        (case local-borrow-index gamma ty first of Some reading -> True; None -> False)
      else string-compare operation "negate" == 0 && same-number-sort ty (core-type first) && not (nat-type ty) && decision-operand gamma facts first
    CApply sp ty (CUse at function symbol role Nil) (CLocal arg carrier id name Nil) ->
      (byte-length-function ty function symbol role && (case proof-local id gamma of Some declared -> contract-equal carrier declared; None -> False))
      || decision-total-operand gamma facts term
    other -> decision-total-operand gamma facts term
  decision-index-reading :: ProofScope -> List Proposition -> CoreTerm -> Option Arithmetic
  decision-index-reading gamma facts term = case actual-index gamma facts term of
    Some value -> (case typed-index-arithmetic gamma value of Some reading -> Some reading; None -> typed-index-arithmetic gamma (UIndexPromote value))
    None -> None
  decision-not-null-index :: ProofScope -> List Proposition -> CoreTerm -> Option UType
  decision-not-null-index gamma facts condition = case condition of
    CCase sp ty input (CAlternative at empty no (CAlternative next nonempty yes (CAlternativesEnd end))) ->
      (case (empty, nonempty) of
        (CPConstructor nil-at nil-type nil args nil-ctor (CPDone nil-end),
         CPConstructor cons-at cons-type cons params cons-ctor (CPField head (CPWild h-at h-type) (CPField tail (CPWild t-at t-type) (CPDone cons-end)))) ->
          if string-compare nil (global-data-core-nil) == 0 && string-compare cons (global-data-core-cons) == 0
            && contract-equal nil-type (core-type input) && contract-equal cons-type (core-type input)
            && decision-constant False no && decision-constant True yes
          then actual-index gamma facts input else None
        other -> None)
    other -> None
  decision-predicate-test :: ProofScope -> List Proposition -> UType -> CoreTerm -> Bool
  decision-predicate-test gamma facts predicate condition = case predicate of
    UPropLit value -> decision-constant value condition
    UPropNotNull input -> (case decision-not-null-index gamma facts condition of
      Some actual -> contract-equal input actual
      None -> False)
    UPropNot input -> (case condition of CIf sp ty test yes no -> decision-predicate-test gamma facts input test && decision-constant False yes && decision-constant True no; other -> False)
    UPropAnd first second -> (case condition of CIf sp ty test yes no -> decision-predicate-test gamma facts first test && decision-predicate-test (proof-after-writes gamma (scoped-branch-writes test True)) (scoped-branch-facts gamma facts test True) second yes && decision-constant False no; other -> False)
    UPropOr first second -> (case condition of CIf sp ty test yes no -> decision-predicate-test gamma facts first test && decision-constant True yes && decision-predicate-test (proof-after-writes gamma (scoped-branch-writes test False)) (scoped-branch-facts gamma facts test False) second no; other -> False)
    other -> (case condition of
      CPrimitive sp ty operation (CArgument a first (CArgument b second (CArgumentsEnd end))) -> decision-operand gamma facts first && decision-operand gamma facts second
        && (case (core-predicate gamma predicate, comparison-name operation, decision-index-reading gamma facts first, decision-index-reading gamma facts second) of
          (Some expected, Some relation, Some left, Some right) -> proposition-equal expected (PCompare relation left right)
          other -> False)
      other -> False)
  scoped-decision-valid :: ProofScope -> List Proposition -> UType -> UType -> CoreTerm -> Bool
  scoped-decision-valid gamma facts ty predicate condition = valid-type predicate && kind-equal (type-kind predicate) KProp && valid-type ty
    && contract-equal ty (decision-type predicate) && bool-type (core-type condition)
    && contract-equal (core-effects condition) (URow UEnd) && proof-term gamma facts condition
    && decision-predicate-test gamma facts predicate condition

  proof-local :: Nat -> ProofScope -> Option UType
  proof-local id gamma = scope-entry id (scope-types gamma)
  decimal-digits :: List Char -> Int -> Bool -> Option Int
  decimal-digits chars n seen = case chars of
    Nil -> if seen then Some n else None
    Cons c rest -> let code = char-code c in
      if code >= 48 && code <= 57 then decimal-digits rest (n * 10 + nat-to-int (code - 48)) True else None
  decimal-value :: String -> Option Int
  decimal-value text = case unpack text of
    Cons c rest -> if char-code c == 45 then (case decimal-digits rest 0 False of Some n -> Some (0 - n); None -> None)
      else decimal-digits (Cons c rest) 0 False
    Nil -> None
  valid-integer-literal :: UType -> String -> Bool
  valid-integer-literal carrier text = case decimal-value text of Some value -> integer-literal-valid carrier value; None -> False
  valid-number-literal :: UType -> String -> Bool
  valid-number-literal carrier text = case decimal-value text of Some value -> number-literal-valid carrier value; None -> False
  core-float-literal-word :: UType -> String -> Option Int
  core-float-literal-word carrier text = case decimal-value text of
    Some value -> float-literal-bits carrier value (string-compare text "-0" == 0)
    None -> None
  same-integer-carrier :: UType -> UType -> Bool
  same-integer-carrier first second = integer-carrier first && contract-equal first second
  ordered-id :: Nat -> List Nat -> List Nat
  ordered-id id ids = case ids of Nil -> [id]; Cons key rest -> if id == key then ids else if id < key then Cons id ids else Cons key (ordered-id id rest)
  natural-ids :: List (Nat, UType) -> List Nat
  natural-ids gamma = case gamma of Nil -> Nil; Cons (id, ty) rest -> if nat-type ty then ordered-id id (natural-ids rest) else natural-ids rest
  natural-facts :: List Nat -> List Proposition
  natural-facts ids = case ids of Nil -> Nil; Cons id rest -> Cons (PCompare AtLeast (proof-variable id) (AInteger 0)) (natural-facts rest)
  proof-assumptions :: ProofScope -> List Proposition -> List Proposition
  proof-assumptions gamma facts = natural-facts (natural-ids (refinement-gamma (scope-types gamma))) <> machine-facts (machine-ids (scope-types gamma)) (scope-types gamma) <> byte-length-facts (byte-buffer-ids (scope-types gamma)) <> refinement-facts gamma (scope-types gamma) <> erased-facts gamma <> facts
  erased-facts :: ProofScope -> List Proposition
  erased-facts gamma = case gamma of MkProofScope types values proofs bodies guards -> erased-predicates gamma proofs
  erased-predicates :: ProofScope -> List (Nat, UType) -> List Proposition
  erased-predicates gamma proofs = case proofs of
    Nil -> Nil
    Cons (id, predicate) rest -> case core-predicate gamma predicate of Some p -> Cons p (erased-predicates gamma rest); None -> erased-predicates gamma rest
  machine-ids :: List (Nat, UType) -> List Nat
  machine-ids gamma = case gamma of
    Nil -> Nil
    Cons (id, ty) rest -> case integer-bounds (numeric-carrier-view ty) of Some bounds -> ordered-id id (machine-ids rest); None -> machine-ids rest
  machine-facts :: List Nat -> List (Nat, UType) -> List Proposition
  machine-facts ids gamma = case ids of
    Nil -> Nil
    Cons id rest -> case scope-entry id gamma of
      Some ty -> case integer-bounds (numeric-carrier-view ty) of
        Some (low, high) -> Cons (PCompare AtLeast (proof-variable id) (AInteger low))
          (Cons (PCompare AtMost (proof-variable id) (AInteger high)) (machine-facts rest gamma))
        None -> machine-facts rest gamma
      None -> machine-facts rest gamma
  byte-buffer-type :: UType -> Bool
  byte-buffer-type ty = case refinement-view ty of
    UCon name KType -> string-compare name "Bytes" == 0
    URefine id name carrier predicate -> valid-type ty && byte-buffer-type carrier
    other -> False
  byte-buffer-ids :: List (Nat, UType) -> List Nat
  byte-buffer-ids gamma = case gamma of
    Nil -> Nil
    Cons (id, ty) rest -> if byte-buffer-type ty then ordered-id id (byte-buffer-ids rest) else byte-buffer-ids rest
  -- ABI 5 byte buffers have a fixed nonnegative machine-sized length.
  -- Only the typed primitive observation reifier can name these atoms.
  byte-length-facts :: List Nat -> List Proposition
  byte-length-facts ids = case ids of
    Nil -> Nil
    Cons id rest -> Cons (PCompare AtLeast (byte-length-variable id) (AInteger 0))
      (Cons (PCompare AtMost (byte-length-variable id) (AInteger 9223372036854775807)) (byte-length-facts rest))

  byte-length-variable :: Nat -> Arithmetic
  byte-length-variable id = AVariable (string-concat "#bytes-length:" (nat-to-string id))
  byte-length-function :: UType -> UType -> String -> String -> Bool
  byte-length-function result function symbol role = string-compare symbol "cinch.runtime.bytesLen" == 0 && string-compare role "intrinsic" == 0 && nat-type (numeric-carrier-view result) && (case function of UFun domain output -> contract-equal domain (UCon "Bytes" KType) && contract-equal output result; other -> False)
  byte-observation-reading :: ProofScope -> UType -> Option Arithmetic
  byte-observation-reading gamma value = if not (typed-index-admissible (UIndexByteLength value)) then None else case value of
    UIndex carrier (IRigid id name level) -> case proof-local id gamma of
      Some declared -> if not (contract-equal carrier declared) then None else case scope-value id gamma of
        Some value -> byte-observation-reading (scope-without-value id gamma) value
        None -> Some (byte-length-variable id)
      None -> None
    UIndexForget (UIndex carrier (IRigid id name level)) -> case proof-local id gamma of
      Some declared -> if not (contract-equal carrier declared) then None else case scope-value id gamma of
        Some value -> byte-observation-reading (scope-without-value id gamma) (UIndexForget value)
        None -> Some (byte-length-variable id)
      None -> None
    UIndexCall function arguments -> total-value-call-key gamma value "Bytes"
    other -> None

  core-arithmetic :: ProofScope -> List Proposition -> CoreTerm -> Option Arithmetic
  core-arithmetic gamma facts term = case checked-total-index gamma facts term of Some value -> typed-index-arithmetic gamma value; None -> ordinary-arithmetic gamma facts term
  scoped-borrow-read-index :: ProofScope -> CoreTerm -> Option UType
  scoped-borrow-read-index gamma term = case term of
    CPrimitive sp result operation (CArgument at input (CArgumentsEnd end)) ->
      if string-compare operation "copy-out" == 0 then local-borrow-index gamma result input else None
    other -> None
  local-borrow-index :: ProofScope -> UType -> CoreTerm -> Option UType
  local-borrow-index gamma result term = case term of
    CLocal sp ty id name Nil -> (case (borrow-type-parts ty, proof-local id gamma) of
      (Some (mutable, region, carrier), Some declared) ->
        if integer-carrier carrier && contract-equal ty declared && contract-equal result carrier
        then Some (UIndexBorrowRead (UIndex ty (IRigid id name 0))) else None
      other -> None)
    other -> None
  borrow-observation-reading :: ProofScope -> UType -> Option Arithmetic
  borrow-observation-reading gamma input = case input of
    UIndex ty (IRigid id name level) -> (case (borrow-type-parts ty, proof-local id gamma) of
      (Some (mutable, region, carrier), Some declared) ->
        if integer-carrier carrier && contract-equal ty declared then Some (borrow-read-variable id) else None
      other -> None)
    other -> None
  ordinary-arithmetic :: ProofScope -> List Proposition -> CoreTerm -> Option Arithmetic
  ordinary-arithmetic gamma facts term = case term of
    CDischarge sp ty certificates body -> scoped-guarded-call-reading gamma facts term
    CApply s ty (CUse at function symbol role Nil) input ->
      if byte-length-function ty function symbol role then
        (case actual-index gamma facts input of Some value -> byte-observation-reading gamma value; None -> None)
      else None
    CRefine s ty evidence body -> if certified-refinement gamma facts ty evidence body then core-arithmetic gamma facts body else None
    CRefineProof s ty witness body -> if scoped-refinement-proof gamma facts ty witness body then core-arithmetic gamma facts body else None
    CForget s ty body -> if forgotten gamma facts ty body then (case body of
      CLocal at refined id name Nil -> Some (proof-variable id)
      other -> core-arithmetic gamma facts body) else None
    CLocal s ty id name Nil -> case proof-local id gamma of
      Some declared -> if same-integer-carrier ty declared then Some (proof-variable id) else None
      None -> None
    CInt s ty text -> case decimal-value text of
      Some n -> if integer-literal-valid ty n then Some (AInteger n) else None
      None -> None
    CPrimitive s ty op (CArgument a first (CArgument b second (CArgumentsEnd end))) ->
      if same-number-sort ty (core-type first) && same-number-sort ty (core-type second) then
        (case (core-arithmetic gamma facts first, core-arithmetic gamma facts second) of
          (Some x, Some y) -> if string-compare op "+" == 0 then Some (APlus x y)
            else if string-compare op "*" == 0 then Some (ATimes x y)
            else if string-compare op "-" == 0 && not (nat-type ty) then Some (AMinus x y) else None
          other -> None)
      else None
    CPrimitive s ty op (CArgument a first (CArgumentsEnd end)) ->
      if string-compare op "copy-out" == 0 then
        (case local-borrow-index gamma ty first of Some reading -> typed-index-arithmetic gamma reading; None -> None)
      else if string-compare op "negate" == 0 && same-number-sort ty (core-type first) && not (nat-type ty) then
        (case core-arithmetic gamma facts first of Some x -> Some (AMinus (AInteger 0) x); None -> None) else None
    CApply s ty (CApply partial function method first) second -> case scoped-numeric-method-operation gamma method first second of
      Some op -> case (core-arithmetic gamma facts first, core-arithmetic gamma facts second) of
        (Some a, Some b) -> Some (if string-compare op "+" == 0 then APlus a b else if string-compare op "*" == 0 then ATimes a b else AMinus a b)
        other -> None
      None -> None
    CProved s ty evidence body -> if certified-operation gamma facts ty evidence body then
      (case body of
        CPrimitive at out op (CArgument a first (CArgument b second (CArgumentsEnd end))) ->
          (case (core-arithmetic gamma facts first, core-arithmetic gamma facts second) of (Some x, Some y) -> Some (AMinus x y); other -> None)
        other -> None) else None
    other -> None
  comparison-name :: String -> Option Comparison
  comparison-name op = if string-compare op "<" == 0 then Some Less else if string-compare op "<=" == 0 then Some AtMost
    else if string-compare op "==" == 0 then Some Equal else if string-compare op "/=" == 0 then Some Unequal
    else if string-compare op ">=" == 0 then Some AtLeast else if string-compare op ">" == 0 then Some Greater else None
  negated-condition-input :: ProofScope -> CoreTerm -> Option CoreTerm
  negated-condition-input gamma term = case total-call-spine gamma term Nil of
    Some (binding, [input]) ->
      if bool-type (core-type input) && total-boolean-negation (binding-function binding) then Some input else None
    other -> None
  scoped-core-condition :: ProofScope -> List Proposition -> CoreTerm -> Option Proposition
  scoped-core-condition gamma facts term = if not (bool-type (core-type term)) then None else case term of
    CPrimitive sp ty operation (CArgumentsEnd end) -> if string-compare operation "decision-true" == 0 then Some PTruth else if string-compare operation "decision-false" == 0 then Some PFalsehood else None
    CPrimitive s ty op (CArgument a first (CArgument b second (CArgumentsEnd end))) ->
      if same-integer-carrier (core-type first) (core-type second) then
        (case (comparison-name op, core-arithmetic gamma facts first, core-arithmetic gamma facts second) of
          (Some rel, Some x, Some y) -> Some (PCompare rel x y)
          other -> None) else None
    CApply s ty (CApply partial function method first) second -> case scoped-numeric-method-comparison gamma method first second of
      Some relation -> case (core-arithmetic gamma facts first, core-arithmetic gamma facts second) of
        (Some a, Some b) -> Some (PCompare relation a b)
        other -> None
      None -> None
    CApply s ty function input -> (case negated-condition-input gamma term of
      Some argument -> (case scoped-core-condition gamma facts argument of Some predicate -> Some (PNegate predicate); None -> None)
      None -> None)
    CUse s ty name role Nil -> if string-compare role "constructor" == 0 then
      (if string-compare name "True" == 0 then Some PTruth else if string-compare name "False" == 0 then Some PFalsehood else None) else None
    CIf s ty condition yes no -> case scoped-core-condition gamma facts condition of
      Some p -> case (scoped-core-condition gamma (Cons p facts) yes, scoped-core-condition gamma (Cons (PNegate p) facts) no) of
        (Some q, Some r) -> Some (PEither (PBoth p q) (PBoth (PNegate p) r))
        other -> None
      None -> None
    CCase s ty input alternatives -> (case decision-not-null-index gamma facts term of
      Some actual -> core-predicate gamma (UPropNotNull actual)
      None -> None)
    other -> None
  -- Exact condition readings may be negated. Partial readings retain only
  -- implications for the branch actually taken: true p && q implies both
  -- operands; false p || q implies both negations, even if one is opaque.
  -- A known test fact is in scope when reading the selected operand. Never
  -- negate a partial reading to describe the opposite branch.
  merge-branch-implications :: Option Proposition -> Option Proposition -> Option Proposition
  merge-branch-implications first second = case (first, second) of
    (other, Some PTruth) -> first
    (None, other) -> second
    (Some PTruth, other) -> second
    (Some p, None) -> first
    (Some p, Some q) -> Some (PBoth p q)
  scoped-core-branch :: ProofScope -> List Proposition -> CoreTerm -> Bool -> Option Proposition
  scoped-core-branch gamma facts condition positive = if not (bool-type (core-type condition)) then None else
    case scoped-core-condition gamma facts condition of
      Some p -> Some (if positive then p else PNegate p)
      None -> case condition of
        CApply s ty function input -> (case negated-condition-input gamma condition of
          Some argument -> scoped-core-branch gamma facts argument (not positive)
          None -> None)
        CIf sp ty test yes no -> if positive then
          (case scoped-core-condition gamma facts no of
            Some PFalsehood -> let first = scoped-core-branch gamma facts test True in
              let inside = case first of Some fact -> Cons fact facts; None -> facts in
              merge-branch-implications first (scoped-core-branch gamma inside yes True)
            other -> None)
          else (case scoped-core-condition gamma facts yes of
            Some PTruth -> let first = scoped-core-branch gamma facts test False in
              let inside = case first of Some fact -> Cons fact facts; None -> facts in
              merge-branch-implications first (scoped-core-branch gamma inside no False)
            other -> None)
        other -> None
  -- A case row states facts only about the actual checked scrutinee.
  -- Failure of a guarded row does not refute its pattern: its guard may
  -- have failed. Callers add a refutation only for covering rows.
  scoped-core-case-facts :: ProofScope -> List Proposition -> CoreTerm -> CorePattern -> Bool -> List Proposition
  scoped-core-case-facts gamma facts value pattern positive = case pattern of
    CPAs sp ty id name inner ->
      (if positive then case-value-alias gamma facts value ty id else Nil)
        <> scoped-core-case-facts gamma facts value inner positive
    CPVar sp ty id name -> if positive then case-value-alias gamma facts value ty id else Nil
    CPConstructor sp ty name Nil constructor (CPDone end) | bool-type ty && bool-type constructor && bool-type (core-type value) ->
      if string-compare name "True" == 0 || string-compare name "False" == 0 then
        (case scoped-core-branch gamma facts value (if positive then string-compare name "True" == 0 else string-compare name "False" == 0) of
          Some fact -> [fact]
          None -> Nil)
        else Nil
    CPConstructor sp ty name Nil constructor (CPDone end) | contract-equal ty ordering-result ->
      ordering-case-facts gamma facts value ty constructor name positive
    CPConstructor sp ty name actuals constructor fields -> case-list-shape gamma facts value ty name constructor fields positive
    CPInt sp ty text -> if not (contract-equal ty (core-type value)) then Nil else
      (case (core-arithmetic gamma facts value, core-arithmetic gamma facts (CInt sp ty text)) of
        (Some actual, Some literal) -> [PCompare (if positive then Equal else Unequal) actual literal]
        other -> Nil)
    other -> Nil
  ordering-result :: UType
  ordering-result = UCon (global-data-ordering-ordering) KType
  ordering-row-comparison :: String -> Option Comparison
  ordering-row-comparison name =
    if string-compare name (global-data-ordering-lt) == 0 then Some Less
    else if string-compare name (global-data-ordering-eq) == 0 then Some Equal
    else if string-compare name (global-data-ordering-gt) == 0 then Some Greater
    else None
  ordering-case-facts :: ProofScope -> List Proposition -> CoreTerm -> UType -> UType -> String -> Bool -> List Proposition
  ordering-case-facts gamma facts value ty constructor name positive =
    if not (contract-equal ty ordering-result && contract-equal constructor ordering-result && contract-equal (core-type value) ordering-result) then Nil else
      case ordering-row-comparison name of
        Some comparison -> (case ordering-operands gamma facts value of
          Some (left, right) -> let fact = PCompare comparison left right in [if positive then fact else PNegate fact]
          None -> Nil)
        None -> Nil
  -- The helper describes only control flow. Both numerical method bodies
  -- must belong to the same dictionary selected in this actual call.
  ordering-slot-proves :: ProofScope -> String -> Nat -> UType -> UType -> String -> Bool
  ordering-slot-proves gamma dictionary slot key factory relation = case selected-method-body dictionary slot (scope-bodies gamma) of
    Some binding -> ordering-method-matches dictionary slot key factory binding && (case total-numeric-comparison (binding-function binding) of
      Some actual -> string-compare actual relation == 0
      None -> False)
    None -> False
  ordering-key-reading :: ProofScope -> List Proposition -> Span -> UType -> CoreTerm -> CoreTerm -> Option Arithmetic
  ordering-key-reading gamma facts sp result key input = case key of
    CLambda at ty (CPVar binder domain id name) (CLocal use actual same-id display Nil) ->
      if id == same-id && contract-equal domain result && contract-equal actual result then core-arithmetic gamma facts input else None
    other -> core-arithmetic gamma facts (CApply sp result key input)
  ordering-operands :: ProofScope -> List Proposition -> CoreTerm -> Option (Arithmetic, Arithmetic)
  ordering-operands gamma facts term = case term of
    CApply sp result (CApply at next (CApply ap rest (CQualifiedUse source function name role [input, key] [CEInstance evidence factory dictionary Nil (CEArgumentsEnd end)]) project) first) second ->
      case body-binding name (scope-bodies gamma) of
        Some binding -> (case keyed-ordering-slots (binding-function binding) of
          Some (less, greater) ->
            if not (string-compare role "external" == 0 && string-compare (binding-role binding) role == 0
                && valid-type input && integer-carrier key && contract-equal result ordering-result
                && contract-equal function (UFun (UFun input key) (UFun input (UFun input result)))
                && contract-equal (core-type project) (UFun input key)
                && contract-equal (core-type first) input && contract-equal (core-type second) input
                && contract-equal (core-effects project) (URow UEnd)
                && ordering-slot-proves gamma dictionary less key factory "<"
                && ordering-slot-proves gamma dictionary greater key factory ">") then None else
              (case (ordering-key-reading gamma facts sp key project first, ordering-key-reading gamma facts sp key project second) of
                (Some a, Some b) -> Some (a, b)
                other -> None)
          None -> None)
        None -> None
    other -> None
  case-value-alias :: ProofScope -> List Proposition -> CoreTerm -> UType -> Nat -> List Proposition
  case-value-alias gamma facts value ty id = if not (contract-equal ty (core-type value)) then Nil else
    if integer-carrier ty then
      (case core-arithmetic gamma facts value of
        Some actual -> [PCompare Equal (proof-variable id) actual]
        None -> Nil)
    else case core-list-element ty of
      Some element -> (case actual-index gamma facts value of
        Some index -> (case list-shape-reading gamma index of
          Some actual -> [PCompare Equal (list-shape-variable id) actual]
          None -> Nil)
        None -> Nil)
      None -> Nil
  -- A list shape has its own proof identity. It is either empty (0) or
  -- nonempty (1) and never serves as a reading of the list's elements.
  list-shape-variable :: Nat -> Arithmetic
  list-shape-variable id = AVariable (string-concat "#list-shape:" (nat-to-string id))
  list-shape-reading :: ProofScope -> UType -> Option Arithmetic
  list-shape-reading gamma index = if not (typed-index-admissible index) then None else case index of
    UIndexList element UEnd -> Some (AInteger 0)
    UIndexList element (UArg first rest) -> Some (AInteger 1)
    UIndex carrier (IRigid id name level) -> (case (core-list-element carrier, proof-local id gamma) of
      (Some element, Some declared) -> if contract-equal carrier declared then Some (list-shape-variable id) else None
      other -> None)
    other -> None
  irrefutable-case-pattern :: UType -> CorePattern -> Bool
  irrefutable-case-pattern expected pattern = case pattern of
    CPWild sp ty -> contract-equal expected ty
    CPVar sp ty id name -> contract-equal expected ty
    CPAs sp ty id name inner -> contract-equal expected ty && irrefutable-case-pattern expected inner
    other -> False
  list-pattern-shape :: UType -> String -> UType -> CorePattern -> Bool -> Option Int
  list-pattern-shape ty name constructor fields positive = case (core-list-element ty, fields) of
    (Some element, CPDone end) ->
      if string-compare name (global-data-core-nil) == 0 && contract-equal constructor ty then Some (if positive then 0 else 1) else None
    (Some element, CPField sp head (CPField tail-at tail (CPDone end))) ->
      if string-compare name (global-data-core-cons) == 0 && contract-equal constructor (UFun element (UFun ty ty))
        && (positive || (irrefutable-case-pattern element head && irrefutable-case-pattern ty tail)) then Some (if positive then 1 else 0) else None
    other -> None
  case-list-shape :: ProofScope -> List Proposition -> CoreTerm -> UType -> String -> UType -> CorePattern -> Bool -> List Proposition
  case-list-shape gamma facts value ty name constructor fields positive = if not (contract-equal ty (core-type value)) then Nil else
    case list-pattern-shape ty name constructor fields positive of
      Some shape -> (case actual-index gamma facts value of
        Some index -> (case list-shape-reading gamma index of
          Some actual -> [PCompare Equal actual (AInteger shape)]
          None -> Nil)
        None -> Nil)
      None -> Nil
  core-alternative-covers :: CoreTerm -> Bool
  core-alternative-covers body = case body of
    CLet sp ty id name sc rhs inner -> core-alternative-covers inner
    CMemoScope sp ty region inner -> core-alternative-covers inner
    CRecursiveValues sp ty region members inner -> core-alternative-covers inner
    CRequire sp ty inner -> core-alternative-covers inner
    CGuard sp ty condition rhs -> (case condition of
      CUse at actual name role Nil -> bool-type actual && string-compare name "True" == 0 && string-compare role "constructor" == 0
      other -> False)
    other -> True
  case-branch-facts :: ProofScope -> List Proposition -> CoreTerm -> CorePattern -> Bool -> List Proposition
  case-branch-facts gamma facts value pattern positive =
    facts-after-writes gamma (scoped-core-case-facts gamma facts value pattern positive) (core-mutable-writes value) <> facts
  -- A pure guard on a pattern that always matches can fail only when the
  -- guard is false. Read it in the outer scope so no row binding escapes.
  scoped-core-case-rest-facts :: ProofScope -> List Proposition -> CoreTerm -> CorePattern -> CoreTerm -> List Proposition
  scoped-core-case-rest-facts gamma facts value pattern body =
    if core-alternative-covers body then scoped-core-case-facts gamma facts value pattern False
    else case body of
      CGuard sp ty condition rhs ->
        if irrefutable-case-pattern (core-type value) pattern && bool-type (core-type condition)
          && contract-equal (core-effects condition) (URow UEnd) && proof-term gamma facts condition then
          (case scoped-core-branch gamma facts condition False of Some fact -> [fact]; None -> Nil)
        else Nil
      other -> Nil
  case-rest-facts :: ProofScope -> List Proposition -> CoreTerm -> CorePattern -> CoreTerm -> List Proposition
  case-rest-facts gamma facts value pattern body = facts-after-writes gamma
    (scoped-core-case-rest-facts gamma facts value pattern body <> facts) (guard-fallthrough-writes body)
  -- A failed earlier equation refutes a column only if every other
  -- pattern always matches and the equation has no fallible guard.
  extend-equation-prefix :: List CorePattern -> CoreTerm -> List (List CorePattern) -> List (List CorePattern)
  extend-equation-prefix patterns body earlier = case body of
    CRequire sp ty inner -> extend-equation-prefix patterns inner earlier
    CError sp -> earlier
    other -> if core-alternative-covers body then Cons patterns earlier else earlier
  single-refutable-column :: List CorePattern -> List CorePattern -> Option (CorePattern, CorePattern) -> Option (CorePattern, CorePattern)
  single-refutable-column before current found = case (before, current) of
    (Nil, Nil) -> found
    (Cons old earlier, Cons new later) ->
      if irrefutable-case-pattern (pattern-type old) old then single-refutable-column earlier later found
      else (case found of
        None -> single-refutable-column earlier later (Some (old, new))
        Some pair -> None)
    other -> None
  scoped-core-equation-facts :: ProofScope -> List (List CorePattern) -> List CorePattern -> List Proposition
  scoped-core-equation-facts gamma earlier patterns = case earlier of
    Nil -> Nil
    Cons first rest ->
      (case single-refutable-column first patterns None of
        Some (prior, current) -> (case pattern-value current of
          Some value -> scoped-core-case-facts gamma Nil value prior False
          None -> Nil)
        None -> Nil) <> scoped-core-equation-facts gamma rest patterns
  scoped-branch-facts :: ProofScope -> List Proposition -> CoreTerm -> Bool -> List Proposition
  scoped-branch-facts gamma facts condition positive =
    let with-branch = (case scoped-core-branch gamma facts condition positive of
      Some p -> Cons p facts
      None -> facts) in
    facts-after-writes gamma with-branch (scoped-branch-writes condition positive)
  subtraction-goal :: ProofScope -> List Proposition -> CoreTerm -> CoreTerm -> Option Proposition
  subtraction-goal gamma facts first second = if nat-type (core-type first) && nat-type (core-type second) then
    (case (core-arithmetic gamma facts first, core-arithmetic gamma facts second) of (Some x, Some y) -> Some (PCompare AtMost y x); other -> None) else None
  operation-goal :: ProofScope -> List Proposition -> String -> CoreTerm -> CoreTerm -> Option Proposition
  operation-goal gamma facts op first second =
    if string-compare op "-" == 0 then subtraction-goal gamma facts first second
    else if string-compare op "/" == 0 && same-number-sort (core-type first) (core-type second) then
      (case core-arithmetic gamma facts second of Some divisor -> Some (PCompare Unequal divisor (AInteger 0)); None -> None)
    else None
  scoped-prove-operation :: ProofScope -> List Proposition -> String -> CoreTerm -> CoreTerm -> Option Proof
  scoped-prove-operation gamma facts op first second = case operation-obligation gamma facts op first second of
    Some (goal, hypotheses) -> case prove hypotheses goal of
      Some evidence -> if check-proof hypotheses goal evidence then Some evidence else None
      None -> None
    None -> None
  operation-obligation :: ProofScope -> List Proposition -> String -> CoreTerm -> CoreTerm -> Option (Proposition, List Proposition)
  operation-obligation gamma facts op first second = case operation-goal gamma facts op first second of
    Some goal -> let writes = child-writes [first, second] in
      (case mutable-fact-write gamma writes goal of
        Some sp -> None
        None -> Some (goal, goal-assumptions (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) [goal]))
    None -> None
  scoped-prove-subtraction :: ProofScope -> List Proposition -> CoreTerm -> CoreTerm -> Option Proof
  scoped-prove-subtraction gamma facts first second = scoped-prove-operation gamma facts "-" first second
  scoped-prove-division :: ProofScope -> List Proposition -> CoreTerm -> CoreTerm -> Option Proof
  scoped-prove-division gamma facts first second = scoped-prove-operation gamma facts "/" first second
  certified-operation :: ProofScope -> List Proposition -> UType -> Proof -> CoreTerm -> Bool
  certified-operation gamma facts ty evidence body = case body of
    CPrimitive s out op (CArgument a first (CArgument b second (CArgumentsEnd end))) ->
      same-number-sort ty out && same-number-sort out (core-type first)
      && proof-term gamma facts first && proof-after-term gamma facts first second
      && (case operation-obligation gamma facts op first second of Some (goal, hypotheses) -> check-proof hypotheses goal evidence; None -> False)
    other -> False
  scoped-core-let-fact :: ProofScope -> List Proposition -> Nat -> Scheme -> CoreTerm -> Option Proposition
  scoped-core-let-fact gamma facts id sc rhs = case (scheme-params sc, scheme-requirements sc) of
    (Nil, Nil) -> if not (stable-index-source rhs && contract-equal (scheme-body sc) (core-type rhs)) then None
      else let carrier = numeric-carrier-view (scheme-body sc) in
        if same-number-sort carrier carrier then
          (let value = if is-refinement (core-type rhs) then CForget (Span 0 0 1 1) carrier rhs else rhs in
           case core-arithmetic gamma facts value of Some reading -> Some (PCompare Equal (proof-variable id) reading); None -> None)
        else None
    other -> None
  proof-pattern :: CorePattern -> ProofScope -> ProofScope
  proof-pattern pattern gamma = case pattern of
    CPVar s ty id name -> scope-local id ty gamma
    CPProof s predicate id name -> scope-erased id predicate gamma
    CPErasedValue s ty id name -> scope-local id ty gamma
    CPAs s ty id name inner -> proof-pattern inner (scope-local id ty gamma)
    CPConstructor s ty name actuals ctor fields -> proof-pattern fields gamma
    CPTuple s ty fields -> proof-pattern fields gamma
    CPField s first rest -> proof-pattern rest (proof-pattern first gamma)
    other -> gamma
  proof-patterns :: List CorePattern -> ProofScope -> ProofScope
  proof-patterns patterns gamma = case patterns of Nil -> gamma; Cons p rest -> proof-patterns rest (proof-pattern p gamma)
  erasable-value-argument :: CoreTerm -> Bool
  erasable-value-argument argument = contract-equal (core-effects argument) (URow UEnd)
    && (case core-mutable-writes argument of Nil -> True; other -> False)
  erased-application :: ProofScope -> List Proposition -> UType -> UType -> CoreTerm -> CoreTerm -> Bool
  erased-application gamma facts ty row fun witness = proof-term gamma facts fun && (case core-type fun of
    UProofFun predicate effects result -> valid-type (core-type fun) && contract-equal result ty && contract-equal effects row
      && (let writes = core-mutable-writes fun in
        scoped-erased-witness (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) predicate witness)
    UUsageArrow UsageZero arrow -> let writes = core-mutable-writes fun in
      let scope = proof-after-writes gamma writes in
      let live = facts-after-writes gamma facts writes in
      valid-type (core-type fun) && erasable-value-argument witness && proof-term scope live witness
        && (case arrow-result scope live arrow witness of
          Some (result, effects) -> contract-equal result ty && contract-equal effects row
          None -> False)
    other -> False)
  proof-term :: ProofScope -> List Proposition -> CoreTerm -> Bool
  proof-term gamma facts term = if is-refinement (core-type term) then proof-refined-term gamma facts term else proof-ordinary-term gamma facts term
  proof-ordinary-term :: ProofScope -> List Proposition -> CoreTerm -> Bool
  proof-ordinary-term gamma facts term = case term of
    CDecision sp ty predicate condition -> scoped-decision-valid gamma facts ty predicate condition
    CProofRef s ty id name -> False
    -- `refl` discharges a goal whose two sides are definitionally equal, which
    -- is the one proof term an ordinary body may be: `same v = refl` is the
    -- canonical proof former, and refusing it here refused every one of them.
    -- The predicate is the goal itself, so reflexivity is the whole test.
    CProofRefl s predicate -> reflexive-equality predicate
    CProofSearch s predicate assumption evidence -> False
    CRefine s ty evidence body -> certified-refinement gamma facts ty evidence body
    CRefineProof s ty witness body -> scoped-refinement-proof gamma facts ty witness body
    CForget s ty body -> forgotten gamma facts ty body
    CLocal s ty id name Nil -> case proof-local id gamma of Some declared -> contract-equal ty declared; None -> False
    CErasedApply s ty row f witness -> erased-application gamma facts ty row f witness
    CInt s ty text -> valid-number-literal ty text
    CRequire s ty body -> False
    CDischarge s ty evidence body -> discharged gamma facts ty evidence body
    CProved s ty evidence body -> certified-operation gamma facts ty evidence body
    CPrimitive s ty op args -> string-compare op "/" /= 0 && not (nat-type ty && string-compare op "-" == 0) && proof-term gamma facts args
    CApply s ty f x -> proof-application gamma facts ty (URow UEnd) f x
    CApplyEff s ty row f x -> proof-application gamma facts ty row f x
    CScope s ty region evidence callback -> proof-term gamma facts callback
    CMemoScope s ty region body -> proof-term gamma facts body
    CSpawn s ty token body -> proof-term gamma facts token && proof-term gamma facts body
    CJoin s ty token body -> proof-term gamma facts token && proof-term gamma facts body
    CWith s ty given value body -> proof-term gamma facts value && proof-after-term gamma facts value body
    CHandler s ty returned operations -> proof-term gamma facts returned && proof-term gamma facts operations
    CHandle s ty label residual body handled-by -> proof-term gamma facts handled-by && proof-after-term gamma facts handled-by body
    CHandlerOperation s slot openings row closure rest -> proof-term gamma facts closure && proof-term gamma facts rest
    CLambda s ty pattern body -> let writes = [(s, (None :: Option UType))] in
      let scope = proof-pattern pattern (proof-after-writes gamma writes) in
      let live = facts-after-writes gamma facts writes in
      if contains-required ty then (case pattern-result ty pattern of Some result -> proof-expected scope live result body; None -> False)
      else proof-term scope live body
    CLet s ty id name sc rhs body -> let writes = core-mutable-writes rhs in
      let introduced = case scoped-core-let-fact gamma facts id sc rhs of Some p -> Cons p facts; None -> facts in
      proof-term gamma facts rhs && proof-term (proof-after-writes (scope-let gamma facts id sc rhs) writes)
        (facts-after-writes gamma introduced writes) body
    CRecursiveFunctions s ty members body -> let bound = recursive-proof-scope gamma members in
      recursive-proofs bound facts members && proof-term bound facts body
    CRecursiveValues s ty region members body ->
      let (bound, live) = recursive-value-proof-scope gamma facts members in
      recursive-proofs bound live members && proof-term bound live body
    CIf s ty condition yes no -> proof-term gamma facts condition
      && proof-term (proof-after-writes gamma (scoped-branch-writes condition True)) (scoped-branch-facts gamma facts condition True) yes
      && proof-term (proof-after-writes gamma (scoped-branch-writes condition False)) (scoped-branch-facts gamma facts condition False) no
    CCase s ty value alts -> let writes = core-mutable-writes value in
      proof-term gamma facts value && proof-case-alternatives (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) value alts
    CTuple s ty fields -> proof-term gamma facts fields
    CPolyIntro s ty poly-ids fields -> proof-term gamma facts fields
    CPolyElim s ty fields poly-args -> proof-term gamma facts fields
    CGuard s ty guard rhs -> proof-term gamma facts guard
      && proof-term (proof-after-writes gamma (scoped-branch-writes guard True)) (scoped-branch-facts gamma facts guard True) rhs
    CArgument s first rest -> proof-term gamma facts first && proof-after-term gamma facts first rest
    CAlternative s pattern body rest -> proof-term (proof-pattern pattern gamma) facts body && proof-term gamma facts rest
    other -> True
  recursive-value-proof-scope :: ProofScope -> List Proposition -> CoreTerm -> (ProofScope, List Proposition)
  recursive-value-proof-scope gamma facts members =
    let writes = recursive-value-writes members in
    (proof-after-writes (recursive-proof-scope gamma members) writes, facts-after-writes gamma facts writes)
  recursive-proofs :: ProofScope -> List Proposition -> CoreTerm -> Bool
  recursive-proofs gamma facts members = case members of
    CRecursiveBindingsEnd -> True
    CRecursiveBinding id name value rest ->
      proof-term gamma facts value && recursive-proofs gamma facts rest
    other -> False
  proof-after-term :: ProofScope -> List Proposition -> CoreTerm -> CoreTerm -> Bool
  proof-after-term gamma facts first rest = let writes = core-mutable-writes first in
    proof-term (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) rest
  proof-application :: ProofScope -> List Proposition -> UType -> UType -> CoreTerm -> CoreTerm -> Bool
  proof-application gamma facts ty row f x = proof-term gamma facts f && proof-after-term gamma facts f x
    && (if contains-required (core-type f) then let writes = child-writes [f, x] in
      application-type (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) ty row f x else True)
  checked-proof-application :: ProofScope -> List Proposition -> UType -> UType -> CoreTerm -> CoreTerm -> Bool
  checked-proof-application gamma facts ty row f x = let writes = child-writes [f, x] in
    proof-term gamma facts f && proof-after-term gamma facts f x
      && application-type (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) ty row f x
  proof-case-alternatives :: ProofScope -> List Proposition -> CoreTerm -> CoreTerm -> Bool
  proof-case-alternatives gamma facts value alternatives = case alternatives of
    CAlternativesEnd sp -> True
    CAlternative sp pattern body rest -> let bound = proof-pattern pattern gamma in
      proof-term bound (case-branch-facts bound facts value pattern True) body
        && proof-case-alternatives (proof-after-writes gamma (guard-fallthrough-writes body)) (case-rest-facts gamma facts value pattern body) value rest
    other -> False
  is-refinement :: UType -> Bool
  is-refinement ty = case refinement-view ty of URefine id name carrier predicate -> True; other -> False
  -- This view is for predicate checking only. It never changes a runtime
  -- local's declared type or licenses an unchecked CLocal projection.
  numeric-carrier-view :: UType -> UType
  numeric-carrier-view ty = case refinement-view ty of
    URefine id name carrier predicate -> if valid-type ty && integer-carrier carrier then carrier else ty
    other -> ty
  refinement-gamma :: List (Nat, UType) -> List (Nat, UType)
  refinement-gamma gamma = case gamma of Nil -> Nil; Cons (id, ty) rest -> Cons (id, numeric-carrier-view ty) (refinement-gamma rest)
  refinement-facts :: ProofScope -> List (Nat, UType) -> List Proposition
  refinement-facts gamma remaining = case remaining of
    Nil -> Nil
    Cons (local, ty) rest -> let more = refinement-facts gamma rest in case refinement-view ty of
      URefine id name carrier predicate ->
        if valid-type ty && not (volatile-borrow-index ty) && (integer-index-carrier carrier || byte-buffer-type carrier) then
          (case core-predicate gamma (substitute-bound [(id, UIndexForget (UIndex ty (IRigid local name 0)))] predicate) of
            Some fact -> Cons fact more
            None -> more) else more
      other -> more
  refinement-obligation :: ProofScope -> List Proposition -> UType -> CoreTerm -> Option (UType, Proposition)
  refinement-obligation gamma facts ty body = case refinement-view ty of
    URefine id name carrier predicate -> if valid-type ty && contract-equal carrier (core-type body) && proof-term gamma facts body then
      (case core-predicate gamma predicate of
        Some independent -> Some (predicate, independent)
        None -> case actual-index gamma facts body of
          Some value -> let opened = substitute-bound [(id, value)] predicate in
            (case core-predicate gamma opened of Some goal -> Some (opened, goal); None -> None)
          None -> None) else None
    other -> None
  refinement-goal :: ProofScope -> List Proposition -> UType -> CoreTerm -> Option Proposition
  refinement-goal gamma facts ty body = case refinement-obligation gamma facts ty body of
    Some (predicate, goal) -> Some goal
    None -> None
  scoped-refinement-predicate :: ProofScope -> List Proposition -> UType -> CoreTerm -> Option UType
  scoped-refinement-predicate gamma facts ty body = case refinement-obligation gamma facts ty body of
    Some (predicate, goal) -> Some predicate
    None -> None
  -- The runtime allocator returns a Bytes buffer whose immutable length is
  -- exactly the checked Nat input. Validate a foreign declaration's proposed
  -- refinement against that kernel fact; source text supplies no assumption.
  allocation-result-contract :: Nat -> UType -> Bool
  allocation-result-contract input result = case result of
    URefine output name carrier predicate -> input /= output && contract-equal carrier (UCon "Bytes" KType) && valid-type result &&
      (let nat = UCon "Nat" KType in
       let gamma = make-proof-scope [(input, nat), (output, UCon "Bytes" KType)] Nil in
       let actual = UIndex nat (IRigid input "#allocation-length" 0) in
       let opened = substitute-bound [(input, actual)] result in
       let fact = PCompare Equal (byte-length-variable output) (proof-variable input) in
       case scoped-prove-refinement gamma [fact] opened (CLocal (Span 0 0 1 1) carrier output "#allocation-result" Nil) of Some evidence -> True; None -> False)
    other -> contract-equal result (UCon "Bytes" KType)
  -- The runtime read returns a Nat between zero and 255. Check a source
  -- promise semantically, so Int-promoted aliases have the same authority
  -- as direct Nat bounds without making mutable reads stable observations.
  byte-read-result-contract :: UType -> Bool
  byte-read-result-contract result = case result of
    URefine output name carrier predicate -> contract-equal carrier (UCon "Nat" KType) && valid-type result &&
      (let gamma = make-proof-scope [(output, carrier)] Nil in
       let facts = [PCompare AtLeast (proof-variable output) (AInteger 0), PCompare AtMost (proof-variable output) (AInteger 255)] in
       case scoped-prove-refinement gamma facts result (CLocal (Span 0 0 1 1) carrier output "#byte-read-result" Nil) of Some evidence -> True; None -> False)
    other -> contract-equal result (UCon "Nat" KType)
  byte-read-contract :: UType -> Bool
  byte-read-contract ty = valid-type ty && (case ty of
    UFun input (UFun index result) -> contract-equal input (UCon "Bytes" KType) && nat-type index && byte-read-result-contract result
    other -> False)
  byte-allocation-contract :: UType -> Bool
  byte-allocation-contract ty = valid-type ty && (case ty of
    UFun domain result -> nat-type domain && contract-equal result (UCon "Bytes" KType)
    UPi input name domain row result -> nat-type domain && contract-equal row (URow UEnd) && allocation-result-contract input result
    other -> False)
  scoped-prove-refinement :: ProofScope -> List Proposition -> UType -> CoreTerm -> Option Proof
  scoped-prove-refinement gamma facts ty body = case refinement-goal gamma facts ty body of
    Some goal -> let hypotheses = goal-assumptions gamma facts [goal] in case prove hypotheses goal of
      Some evidence -> if check-proof hypotheses goal evidence then Some evidence else None
      None -> None
    None -> None
  -- Proof references carry their actual declared predicate. Opening the
  -- refinement at the checked payload supplies the expected proposition;
  -- neither a source spelling nor an annotated witness can establish it.
  scoped-refinement-proof :: ProofScope -> List Proposition -> UType -> CoreTerm -> CoreTerm -> Bool
  scoped-refinement-proof gamma facts ty witness body = case refinement-view ty of
    URefine id name carrier predicate -> valid-type ty && contract-equal carrier (core-type body) && proof-term gamma facts body
      && (case actual-index gamma facts body of
        Some value -> let writes = core-mutable-writes body in
          scoped-erased-witness (proof-after-writes gamma writes) (facts-after-writes gamma facts writes)
            (substitute-bound [(id, value)] predicate) witness
        None -> False)
    other -> False
  certified-refinement :: ProofScope -> List Proposition -> UType -> Proof -> CoreTerm -> Bool
  certified-refinement gamma facts ty evidence body = case refinement-goal gamma facts ty body of
    Some goal -> check-proof (goal-assumptions gamma facts [goal]) goal evidence
    None -> False
  forgotten :: ProofScope -> List Proposition -> UType -> CoreTerm -> Bool
  forgotten gamma facts carrier body = case refinement-view (core-type body) of
    URefine id name domain predicate -> valid-type (core-type body) && contract-equal carrier domain && proof-term gamma facts body
    other -> False
  -- Every path producing a refinement retains either its checked producer
  -- or an introduction certificate. A literal's annotated type is no proof.
  proof-refined-term :: ProofScope -> List Proposition -> CoreTerm -> Bool
  proof-refined-term gamma facts term = if not (is-refinement (core-type term) && valid-type (core-type term)) then False else case term of
    -- Global references inherit the checked source/interface scheme, just
    -- as ordinary globals do. This is still the partial scope/certificate
    -- checker, not an independent validator of the global environment.
    CUse s ty name role actuals -> not (string-compare role "local" == 0) && closed-types actuals
    CQualifiedUse s ty name role actuals evidence -> not (string-compare role "local" == 0) && closed-types actuals && evidences-closed evidence
    CMethod s ty name owner slot actuals evidence -> closed-types actuals && evidences-closed evidence && (case evidence of Cons first rest -> True; Nil -> False)
    CRefine s ty evidence body -> certified-refinement gamma facts ty evidence body
    CRefineProof s ty witness body -> scoped-refinement-proof gamma facts ty witness body
    CForget s ty body -> forgotten gamma facts ty body
    CLocal s ty id name Nil -> case proof-local id gamma of Some declared -> contract-equal ty declared; None -> False
    CErasedApply s ty row f witness -> erased-application gamma facts ty row f witness
    CApply s ty f x -> checked-proof-application gamma facts ty (URow UEnd) f x
    CApplyEff s ty row f x -> checked-proof-application gamma facts ty row f x
    CDischarge s ty evidence body -> discharged gamma facts ty evidence body
    CLet s ty id name sc rhs body -> let writes = core-mutable-writes rhs in
      let more = case scoped-core-let-fact gamma facts id sc rhs of Some p -> Cons p facts; None -> facts in
      proof-expected gamma facts (scheme-body sc) rhs &&
        proof-expected (proof-after-writes (scope-let gamma facts id sc rhs) writes) (facts-after-writes gamma more writes) ty body
    CRecursiveFunctions s ty members body -> let bound = recursive-proof-scope gamma members in
      recursive-proofs bound facts members && proof-expected bound facts ty body
    CRecursiveValues s ty region members body ->
      let (bound, live) = recursive-value-proof-scope gamma facts members in
      recursive-proofs bound live members && proof-expected bound live ty body
    CIf s ty condition yes no -> bool-type (core-type condition) && proof-term gamma facts condition
      && proof-expected (proof-after-writes gamma (scoped-branch-writes condition True)) (scoped-branch-facts gamma facts condition True) ty yes
      && proof-expected (proof-after-writes gamma (scoped-branch-writes condition False)) (scoped-branch-facts gamma facts condition False) ty no
    CCase s ty value alternatives -> let writes = core-mutable-writes value in
      proof-term gamma facts value && refined-alternatives (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) value ty alternatives
    CGuard s ty guard rhs -> bool-type (core-type guard) && proof-term gamma facts guard
      && proof-expected (proof-after-writes gamma (scoped-branch-writes guard True)) (scoped-branch-facts gamma facts guard True) ty rhs
    CScope s ty region evidence callback -> proof-term gamma facts callback
    CMemoScope s ty region body -> proof-term gamma facts body
    CSpawn s ty token body -> proof-term gamma facts token && proof-term gamma facts body
    CJoin s ty token body -> proof-term gamma facts token && proof-term gamma facts body
    CWith s ty given value body -> let writes = core-mutable-writes value in
      proof-term gamma facts value && proof-expected (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) ty body
    other -> False
  refined-alternatives :: ProofScope -> List Proposition -> CoreTerm -> UType -> CoreTerm -> Bool
  refined-alternatives gamma facts value ty alternatives = case alternatives of
    CAlternativesEnd s -> True
    CAlternative s pattern body rest -> let bound = proof-pattern pattern gamma in
      proof-expected bound (case-branch-facts bound facts value pattern True) ty body
        && refined-alternatives (proof-after-writes gamma (guard-fallthrough-writes body)) (case-rest-facts gamma facts value pattern body) value ty rest
    other -> False

  proof-clauses :: List CoreClause -> Bool
  proof-clauses clauses = case clauses of Nil -> True; Cons (MkCoreClause s patterns body) rest -> proof-term (proof-patterns patterns empty-proof-scope) Nil body && proof-clauses rest

  -- Inference may discover another local is Nat after an earlier branch
  -- has been checked. That adds a domain fact and can change citation
  -- positions. Seal against the completed types: keep a valid certificate,
  -- otherwise search again in the actual frozen context. The independent
  -- proof-term pass still checks the resulting certificate without repair.
  refresh-case-alternatives :: ProofScope -> List Proposition -> CoreTerm -> CoreTerm -> CoreTerm
  refresh-case-alternatives gamma facts value alternatives = case alternatives of
    CAlternative sp pattern body rest -> let bound = proof-pattern pattern gamma in
      CAlternative sp pattern (refresh-certificates bound (case-branch-facts bound facts value pattern True) body)
        (refresh-case-alternatives (proof-after-writes gamma (guard-fallthrough-writes body)) (case-rest-facts gamma facts value pattern body) value rest)
    other -> other
  refresh-certificates :: ProofScope -> List Proposition -> CoreTerm -> CoreTerm
  refresh-certificates gamma facts term = case term of
    CHandler s ty returned operations -> CHandler s ty (refresh-certificates gamma facts returned) (refresh-certificates gamma facts operations)
    CHandle s ty label residual body handled-by -> CHandle s ty label residual (refresh-after-term gamma facts handled-by body) (refresh-certificates gamma facts handled-by)
    CHandlerOperation s slot openings row closure rest -> CHandlerOperation s slot openings row (refresh-certificates gamma facts closure) (refresh-certificates gamma facts rest)
    CInt sp (URefine id name carrier predicate) text -> let refined = URefine id name carrier predicate in
      let value = refresh-certificates gamma facts (CInt sp carrier text) in
      (case scoped-prove-refinement gamma facts refined value of Some evidence -> CRefine sp refined evidence value; None -> CError sp)
    CRefineProof s ty witness body -> CRefineProof s ty (refresh-after-term gamma facts body witness) (refresh-certificates gamma facts body)
    CRefine s ty evidence body -> let out = refresh-certificates gamma facts body in
      if certified-refinement gamma facts ty evidence out then CRefine s ty evidence out
      else case scoped-prove-refinement gamma facts ty out of Some fresh -> CRefine s ty fresh out; None -> CError s
    CForget s ty body -> CForget s ty (refresh-certificates gamma facts body)
    CRequire s ty body -> case ty of
      URequire predicates result -> case scoped-core-predicates gamma predicates of Some ps -> CRequire s ty (refresh-certificates gamma (ps <> facts) body); None -> CError s
      other -> CError s
    CDischarge s ty evidence body -> let call = refresh-certificates gamma facts body in
      let writes = call-operand-writes call in
      case scoped-prove-predicates (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) (core-type call) of
        Some fresh -> CDischarge s ty fresh call
        None -> CError s
    CProved s ty evidence body -> let out = refresh-certificates gamma facts body in
      if certified-operation gamma facts ty evidence out then CProved s ty evidence out
      else case out of
        CPrimitive at result op (CArgument a first (CArgument b second (CArgumentsEnd end))) ->
          if same-number-sort ty result && same-number-sort result (core-type first) then
            (case scoped-prove-operation gamma facts op first second of
              Some fresh -> CProved s ty fresh out
              None -> CError s)
          else CError s
        other -> CError s
    CApply s ty f x -> CApply s ty (refresh-certificates gamma facts f) (refresh-after-term gamma facts f x)
    CApplyEff s ty row f x -> CApplyEff s ty row (refresh-certificates gamma facts f) (refresh-after-term gamma facts f x)
    CErasedApply s ty row f witness -> CErasedApply s ty row (refresh-certificates gamma facts f) (refresh-after-term gamma facts f witness)
    CProofSearch s predicate assumption evidence ->
      if scoped-erased-witness gamma facts predicate term then term else case prove-erased-goal gamma facts predicate assumption of
        Some fresh -> CProofSearch s predicate assumption fresh
        None -> CError s
    CDecision s ty predicate condition -> CDecision s ty predicate (refresh-certificates gamma facts condition)
    CScope s ty region evidence callback -> CScope s ty region evidence (refresh-certificates gamma facts callback)
    CMemoScope s ty region body -> CMemoScope s ty region (refresh-certificates gamma facts body)
    CSpawn s ty token body -> CSpawn s ty (refresh-certificates gamma facts token) (refresh-certificates gamma facts body)
    CJoin s ty token body -> CJoin s ty (refresh-certificates gamma facts token) (refresh-certificates gamma facts body)
    CWith s ty given value body -> CWith s ty given (refresh-certificates gamma facts value) (refresh-after-term gamma facts value body)
    CLambda s ty pattern body -> let writes = [(s, (None :: Option UType))] in
      CLambda s ty pattern (refresh-certificates (proof-pattern pattern (proof-after-writes gamma writes)) (facts-after-writes gamma facts writes) body)
    CLet s ty id name sc rhs body -> let value = refresh-certificates gamma facts rhs in
      let writes = core-mutable-writes value in
      let more = case scoped-core-let-fact gamma facts id sc value of Some p -> Cons p facts; None -> facts in
      CLet s ty id name sc value (refresh-certificates (proof-after-writes (scope-let gamma facts id sc value) writes) (facts-after-writes gamma more writes) body)
    CRecursiveFunctions s ty members body -> let bound = recursive-proof-scope gamma members in
      CRecursiveFunctions s ty (map-recursive-functions (refresh-certificates bound facts) members) (refresh-certificates bound facts body)
    CRecursiveValues s ty region members body ->
      let (bound, live) = recursive-value-proof-scope gamma facts members in
      CRecursiveValues s ty region (map-recursive-functions (refresh-certificates bound live) members) (refresh-certificates bound live body)
    CIf s ty condition yes no -> let c = refresh-certificates gamma facts condition in
      CIf s ty c (refresh-certificates (proof-after-writes gamma (scoped-branch-writes c True)) (scoped-branch-facts gamma facts c True) yes)
        (refresh-certificates (proof-after-writes gamma (scoped-branch-writes c False)) (scoped-branch-facts gamma facts c False) no)
    CCase s ty value alts -> let scrutinee = refresh-certificates gamma facts value in
      let writes = core-mutable-writes scrutinee in
      CCase s ty scrutinee (refresh-case-alternatives (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) scrutinee alts)
    CTuple s ty fields -> CTuple s ty (refresh-certificates gamma facts fields)
    CPolyIntro s ty ids body -> CPolyIntro s ty ids (refresh-certificates gamma facts body)
    CPolyElim s ty value args -> CPolyElim s ty (refresh-certificates gamma facts value) args
    CPrimitive s ty op args -> CPrimitive s ty op (refresh-certificates gamma facts args)
    CGuard s ty condition body -> let c = refresh-certificates gamma facts condition in
      CGuard s ty c (refresh-certificates (proof-after-writes gamma (scoped-branch-writes c True)) (scoped-branch-facts gamma facts c True) body)
    CArgument s value rest -> CArgument s (refresh-certificates gamma facts value) (refresh-after-term gamma facts value rest)
    CAlternative s pattern body rest -> CAlternative s pattern (refresh-certificates (proof-pattern pattern gamma) facts body) (refresh-certificates gamma facts rest)
    other -> term

  refresh-after-term :: ProofScope -> List Proposition -> CoreTerm -> CoreTerm -> CoreTerm
  refresh-after-term gamma facts first rest = let writes = core-mutable-writes first in
    refresh-certificates (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) rest

  -- Preconditions are proof metadata. Calls retain their obligation until a
  -- CDischarge checks it; CRequire is permitted only at a declared boundary.
  contract-equal :: UType -> UType -> Bool
  contract-equal a b = case store-errors (unify (Span 0 0 1 1) (without-index-levels a) (without-index-levels b) (empty-store "Core contract")) of Nil -> True; other -> False
  index-arithmetic :: ProofScope -> UType -> IndexTerm -> Option Arithmetic
  index-arithmetic gamma carrier value = if not (same-number-sort carrier carrier && index-runtime-admissible carrier value) then None else case value of
    IInteger n -> Some (AInteger n)
    IRigid id name level -> case proof-local id gamma of Some ty -> if same-number-sort carrier (numeric-carrier-view ty) then Some (proof-variable id) else None; None -> None
    IAdd a b -> case (index-arithmetic gamma carrier a, index-arithmetic gamma carrier b) of (Some x, Some y) -> Some (APlus x y); other -> None
    ISubtract a b -> case (index-arithmetic gamma carrier a, index-arithmetic gamma carrier b) of (Some x, Some y) -> Some (AMinus x y); other -> None
    IMultiply a b -> case (index-arithmetic gamma carrier a, index-arithmetic gamma carrier b) of (Some x, Some y) -> Some (ATimes x y); other -> None
    other -> None
  -- Projection and numeric promotion keep their input's actual carrier.
  -- A matching identifier alone cannot change the type supplied by Gamma.
  integer-index-carrier :: UType -> Bool
  integer-index-carrier carrier = same-number-sort carrier carrier || valid-type (UIndexPromote (UIndex carrier (IBound 0 "#sort")))
  typed-index-arithmetic :: ProofScope -> UType -> Option Arithmetic
  typed-index-arithmetic gamma value = if not (typed-index-admissible value) then None else case value of
    UIndexCall function args -> if not (integer-carrier (UCon (total-result function) KType)) then None else case body-function function (scope-bodies gamma) of Some binding -> (case total-index-arguments gamma (total-parameters function) args of Some values -> Some (ACall (body-call-key binding) values); None -> None); None -> None
    UIndexByteLength input -> byte-observation-reading gamma input
    UIndexBorrowRead input -> borrow-observation-reading gamma input
    UIndex carrier index -> index-arithmetic gamma carrier index
    UIndexForget (UIndex carrier (IRigid id name level)) -> case proof-local id gamma of
      Some declared -> if contract-equal carrier declared && (case refinement-view carrier of URefine key display base predicate -> integer-index-carrier base; other -> False) then Some (proof-variable id) else None
      None -> None
    UIndexPromote (UIndex carrier (IInteger n)) -> if integer-literal-valid carrier n then Some (AInteger n) else None
    UIndexPromote (UIndex carrier (IRigid id name level)) -> case proof-local id gamma of
      Some declared -> if contract-equal carrier declared then Some (proof-variable id) else None
      None -> None
    UIndexPromote input -> typed-index-arithmetic gamma input
    UIndexMath op left right -> case (typed-index-arithmetic gamma left, typed-index-arithmetic gamma right) of
      (Some a, Some b) -> Some (if string-compare op "+" == 0 then APlus a b else if string-compare op "*" == 0 then ATimes a b else AMinus a b)
      other -> None
    other -> None
  core-predicate :: ProofScope -> UType -> Option Proposition
  core-predicate gamma predicate = if not (valid-type predicate && kind-equal (type-kind predicate) KProp) then None else case predicate of
    UPropLit value -> Some (if value then PTruth else PFalsehood)
    UCompare relation left right -> case (if string-compare relation "Eq" == 0 then Some Equal else comparison-name relation,
      typed-index-arithmetic gamma left, typed-index-arithmetic gamma right) of
      (Some op, Some x, Some y) -> Some (PCompare op x y)
      other -> None
    UPropAnd a b -> case (core-predicate gamma a, core-predicate gamma b) of (Some x, Some y) -> Some (PBoth x y); other -> None
    UPropOr a b -> case (core-predicate gamma a, core-predicate gamma b) of (Some x, Some y) -> Some (PEither x y); other -> None
    UPropNot a -> case core-predicate gamma a of Some p -> Some (PNegate p); None -> None
    UPropNonZero value -> case typed-index-arithmetic gamma value of Some actual -> Some (PCompare Unequal actual (AInteger 0)); None -> None
    UPropNotNull (UIndexList element UEnd) -> Some PFalsehood
    UPropNotNull (UIndexList element (UArg first rest)) -> Some PTruth
    UPropNotNull value -> case list-shape-reading gamma value of
      Some actual -> Some (PCompare Equal actual (AInteger 1))
      None -> None
    UPropNonZeroPending value -> None
    other -> None
  scoped-core-predicates :: ProofScope -> UType -> Option (List Proposition)
  scoped-core-predicates gamma predicates = case predicates of
    UEnd -> Some Nil
    UArg first rest -> case (core-predicate gamma first, scoped-core-predicates gamma rest) of (Some p, Some ps) -> Some (Cons p ps); other -> None
    other -> None
  required-predicates :: ProofScope -> UType -> Option (List Proposition)
  required-predicates gamma ty = case ty of
    URequire predicates body -> case (scoped-core-predicates gamma predicates, required-predicates gamma body) of (Some ps, Some more) -> Some (ps <> more); other -> None
    other -> Some Nil
  required-body :: UType -> UType
  required-body ty = case ty of URequire predicates body -> required-body body; other -> ty
  scoped-prove-predicates :: ProofScope -> List Proposition -> UType -> Option (List Proof)
  scoped-prove-predicates gamma facts ty = case required-predicates gamma ty of
    Some goals -> prove-goals (goal-assumptions gamma facts goals) goals
    None -> None
  proof-fact-present :: Proposition -> List Proposition -> Bool
  proof-fact-present goal facts = case facts of
    Nil -> False
    Cons first rest -> proposition-equal goal first || proof-fact-present goal rest

  prove-erased-goal :: ProofScope -> List Proposition -> UType -> Bool -> Option Proof
  prove-erased-goal gamma facts predicate assumption = case core-predicate gamma predicate of
    Some goal ->
      let hypotheses = goal-assumptions gamma facts [goal] in
      if assumption && not (proof-fact-present goal (proof-assumptions gamma facts)) then None
      else case prove hypotheses goal of
        Some evidence -> if check-proof hypotheses goal evidence then Some evidence else None
        None -> None
    None -> None

  scoped-erased-witness :: ProofScope -> List Proposition -> UType -> CoreTerm -> Bool
  scoped-erased-witness gamma facts expected witness = case witness of
    CProofSearch sp predicate assumption evidence ->
      contract-equal expected predicate && (case core-predicate gamma expected of
        Some goal -> (not assumption || proof-fact-present goal (proof-assumptions gamma facts))
          && check-proof (goal-assumptions gamma facts [goal]) goal evidence
        None -> False)
    other -> scoped-proof-reference gamma expected witness

  prove-goals :: List Proposition -> List Proposition -> Option (List Proof)
  prove-goals hypotheses goals = case goals of
    Nil -> Some Nil
    Cons goal rest -> case prove hypotheses goal of
      Some evidence -> if check-proof hypotheses goal evidence then (case prove-goals hypotheses rest of Some more -> Some (Cons evidence more); None -> None) else None
      None -> None
  check-goals :: List Proposition -> List Proposition -> List Proof -> Bool
  check-goals hypotheses goals evidence = case (goals, evidence) of
    (Nil, Nil) -> True
    (Cons goal rest, Cons first more) -> check-proof hypotheses goal first && check-goals hypotheses rest more
    other -> False
  contains-required :: UType -> Bool
  contains-required ty = case refinement-view ty of URefine id name carrier predicate -> True; URequire predicates body -> True; UPi id name domain row result -> contains-required result; UFun domain result -> contains-required result; UFunEff domain row result -> contains-required result; UUsageArrow usage arrow -> contains-required arrow; UProofFun predicate row result -> contains-required result; other -> False
  arithmetic-index :: ProofScope -> Arithmetic -> Option IndexTerm
  arithmetic-index gamma term = case term of
    AInteger n -> Some (IInteger n)
    AVariable name -> variable-index (scope-types gamma) name
    APlus a b -> case (arithmetic-index gamma a, arithmetic-index gamma b) of (Some x, Some y) -> Some (IAdd x y); other -> None
    AMinus a b -> case (arithmetic-index gamma a, arithmetic-index gamma b) of (Some x, Some y) -> Some (ISubtract x y); other -> None
    ATimes a b -> case (arithmetic-index gamma a, arithmetic-index gamma b) of (Some x, Some y) -> Some (IMultiply x y); other -> None
    other -> None
  variable-index :: List (Nat, UType) -> String -> Option IndexTerm
  variable-index gamma name = case gamma of
    Nil -> None
    Cons (id, ty) rest -> if arithmetic-equal (proof-variable id) (AVariable name) then Some (IRigid id name 0) else variable-index rest name
  actual-math-index :: ProofScope -> List Proposition -> String -> CoreTerm -> CoreTerm -> Option UType
  actual-math-index gamma facts op first second = case (actual-index gamma facts first, actual-index gamma facts second) of
    (Some left, Some right) -> let out = normalize (empty-store "Core mathematical index") (UIndexMath op left right) in if typed-index-admissible out then Some out else None
    other -> None
  actual-index :: ProofScope -> List Proposition -> CoreTerm -> Option UType
  actual-index gamma facts term = case checked-total-index gamma facts term of
    Some value -> Some value
    None -> case scoped-list-index gamma facts term of Some value -> Some value; None -> ordinary-index gamma facts term
  scoped-list-index :: ProofScope -> List Proposition -> CoreTerm -> Option UType
  scoped-list-index gamma facts term = case term of
    CUse sp ty name role actuals | string-compare name (global-data-core-nil) == 0 && string-compare role "constructor" == 0 ->
      checked-list-index gamma facts term UEnd
    CApply sp ty (CApply at partial (CUse origin constructor name role actuals) first) rest
        | string-compare name (global-data-core-cons) == 0 && string-compare role "constructor" == 0 ->
      (case (actual-index gamma facts first, actual-index gamma facts rest) of
        (Some head, Some tail) -> checked-list-index gamma facts term (UArg head tail)
        other -> None)
    other -> None
  checked-list-index :: ProofScope -> List Proposition -> CoreTerm -> UType -> Option UType
  checked-list-index gamma facts term fields = case core-list-element (core-type term) of
    Some element -> let index = UIndexList element fields in
      if typed-index-admissible index && proof-term gamma facts term && contract-equal (core-effects term) (URow UEnd) then Some index else None
    None -> None
  ordinary-index :: ProofScope -> List Proposition -> CoreTerm -> Option UType
  ordinary-index gamma facts term = case term of
    CDischarge sp ty certificates body -> scoped-guarded-call-index gamma facts term
    CApply s ty (CUse at function symbol role Nil) input ->
      if byte-length-function ty function symbol role then
        (case actual-index gamma facts input of Some value -> (case byte-observation-reading gamma value of Some reading -> Some (UIndexByteLength value); None -> None); None -> None)
      else None
    CForget s ty body -> if forgotten gamma facts ty body then (case body of
      CRefine at refined evidence actual -> actual-index gamma facts actual
      CRefineProof at refined witness actual -> actual-index gamma facts actual
      CApply at result (CUse source function symbol role Nil) input -> if byte-length-function result function symbol role then actual-index gamma facts body
        else projected-index gamma facts ty body
      other -> projected-index gamma facts ty body) else None
    CPrimitive s ty op (CArgument a first (CArgument b second (CArgumentsEnd end))) ->
      if same-number-sort ty ty && same-number-sort ty (core-type first) && same-number-sort ty (core-type second) && proof-term gamma facts term then
        actual-math-index gamma facts op first second else None
    CPrimitive s ty op (CArgument a input (CArgumentsEnd end)) ->
      if string-compare op "copy-out" == 0 then local-borrow-index gamma ty input
      else if string-compare op "negate" == 0 && same-number-sort ty (core-type input) && not (nat-type ty) && proof-term gamma facts input then
        actual-math-index gamma facts "-" (CInt s ty "0") input else None
    CApply s ty (CApply partial function method first) second -> case scoped-numeric-method-operation gamma method first second of
      Some op -> if proof-term gamma facts first && proof-term gamma facts second then actual-math-index gamma facts op first second else None
      None -> None
    CProved s ty evidence body -> if certified-operation gamma facts ty evidence body then (case body of
      CPrimitive at output operation (CArgument a first (CArgument b second (CArgumentsEnd end))) -> actual-math-index gamma facts operation first second
      other -> None) else None
    CInt s ty text -> case decimal-value text of Some n -> if integer-literal-valid ty n then Some (UIndex ty (IInteger n)) else None; None -> None
    CLocal s ty id name Nil -> scope-index gamma id name ty
    other -> case core-arithmetic gamma facts term of
      Some value -> case arithmetic-index gamma value of Some index -> let out = UIndex (core-type term) index in if valid-type out && index-runtime-admissible (core-type term) index then Some out else None; None -> None
      None -> None
  arrow-result :: ProofScope -> List Proposition -> UType -> CoreTerm -> Option (UType, UType)
  arrow-result gamma facts fun argument = if erased-value-arrow fun then None else case arrow-shape fun of
    UPi id name domain row result -> if not (contract-equal domain (core-type argument)) then None
      else if pi-dependent fun then (case actual-index gamma facts argument of
        Some value ->
          -- The closed Core context already scopes surrounding type
          -- rigids. Re-running inference in an empty level-zero Store
          -- would incorrectly reject those valid polymorphic callers.
          let out = substitute-bound [(id, value)] result in
          let effects = substitute-bound [(id, value)] row in
          if valid-type out && valid-type effects then Some (out, effects) else None
        None -> None)
      else Some (result, row)
    UFun domain result -> if contract-equal domain (core-type argument) then Some (result, URow UEnd) else None
    UFunEff domain row result -> if contract-equal domain (core-type argument) then Some (result, row) else None
    other -> None
  required-call :: ProofScope -> List Proposition -> CoreTerm -> Bool
  required-call gamma facts term = case core-type term of
    URequire predicates result -> case term of
      CUse s ty name role actuals -> not (string-compare role "local" == 0) && closed-types actuals
      CQualifiedUse s ty name role actuals evidence -> not (string-compare role "local" == 0) && closed-types actuals && evidences-closed evidence
      CMethod s ty name owner slot actuals evidence -> closed-types actuals && evidences-closed evidence && (case evidence of Cons first rest -> True; Nil -> False)
      CApply s ty f x -> checked-proof-application gamma facts ty (URow UEnd) f x
      CApplyEff s ty row f x -> checked-proof-application gamma facts ty row f x
      CErasedApply s ty row f witness -> erased-application gamma facts ty row f witness
      other -> False
    other -> False
  application-type :: ProofScope -> List Proposition -> UType -> UType -> CoreTerm -> CoreTerm -> Bool
  application-type gamma facts result row fun argument = case arrow-result gamma facts (core-type fun) argument of
    Some (out, effects) -> contract-equal out result && contract-equal row effects && application-chain gamma facts fun
    None -> False
  application-chain :: ProofScope -> List Proposition -> CoreTerm -> Bool
  application-chain gamma facts term = case term of
    CApply s ty f x -> application-type gamma facts ty (URow UEnd) f x
    CApplyEff s ty row f x -> application-type gamma facts ty row f x
    other -> True
  discharged :: ProofScope -> List Proposition -> UType -> List Proof -> CoreTerm -> Bool
  discharged gamma facts ty evidence body = let writes = call-operand-writes body in
    let after = proof-after-writes gamma writes in
    closed-runtime-type ty && required-call gamma facts body && contract-equal ty (required-body (core-type body))
      && (case required-predicates after (core-type body) of
        Some goals -> check-goals (goal-assumptions after (facts-after-writes gamma facts writes) goals) goals evidence
        None -> False)
  valid-required-call :: CoreTerm -> Bool
  valid-required-call term = closed-type (core-type term) && (case term of
    CUse s ty name role actuals -> closed-types actuals
    CQualifiedUse s ty name role actuals evidence -> closed-types actuals && evidences-closed evidence
    CMethod s ty name owner slot actuals evidence -> closed-types actuals && evidences-closed evidence && (case evidence of Cons first rest -> True; Nil -> False)
    CApply s ty f x -> valid-term f && valid-term x
    CApplyEff s ty row f x -> closed-type row && valid-term f && valid-term x
    other -> False)
  erased-pattern :: CorePattern -> Bool
  erased-pattern pattern = case pattern of CPProof sp ty id name -> True; CPErasedValue sp ty id name -> True; other -> False
  pattern-type :: CorePattern -> UType
  pattern-type pattern = case pattern of CPVar s ty id name -> ty; CPProof s ty id name -> ty; CPErasedValue s ty id name -> ty; CPAs s ty id name inner -> ty; CPWild s ty -> ty; CPInt s ty text -> ty; CPString s ty text -> ty; CPChar s ty text -> ty; CPConstructor s ty name actuals ctor fields -> ty; CPTuple s ty fields -> ty; other -> UError
  pattern-value :: CorePattern -> Option CoreTerm
  pattern-value pattern = case pattern of
    CPVar sp ty id name -> Some (CLocal sp ty id name Nil)
    CPErasedValue sp ty id name -> Some (CLocal sp ty id name Nil)
    CPAs sp ty id name inner -> Some (CLocal sp ty id name Nil)
    CPInt sp ty text -> Some (CInt sp ty text)
    other -> None
  pattern-index :: CorePattern -> Option UType
  pattern-index pattern = case pattern of
    CPVar s ty id name -> Some (UIndex ty (IRigid id name 0))
    CPAs s ty id name inner -> Some (UIndex ty (IRigid id name 0))
    CPInt s ty text -> case decimal-value text of Some n -> Some (UIndex ty (IInteger n)); None -> None
    other -> None
  pattern-result :: UType -> CorePattern -> Option UType
  pattern-result fun pattern = case (fun, pattern) of
    (UUsageArrow UsageZero arrow, CPErasedValue sp ty id name) -> if valid-type fun then pattern-result arrow (CPVar sp ty id name) else None
    (UUsageArrow UsageZero arrow, other) -> None
    (other, CPErasedValue sp ty id name) -> None
    other -> pattern-result-runtime fun pattern
  pattern-result-runtime :: UType -> CorePattern -> Option UType
  pattern-result-runtime fun pattern = case fun of
    UProofFun predicate row result -> case pattern of CPProof s actual id name -> if valid-type predicate && kind-equal (type-kind predicate) KProp && contract-equal predicate actual then Some result else None; other -> None
    UPi id name domain row result -> if not (contract-equal domain (pattern-type pattern)) then None
      else if pi-dependent fun then (case pattern-index pattern of Some index -> Some (substitute-bound [(id, index)] result); None -> None) else Some result
    UFun domain result -> if contract-equal domain (pattern-type pattern) then Some result else None
    UFunEff domain row result -> if contract-equal domain (pattern-type pattern) then Some result else None
    UUsageArrow usage arrow -> if valid-type fun then pattern-result arrow pattern else None
    other -> None
  patterns-result :: UType -> List CorePattern -> Option UType
  patterns-result expected patterns = case patterns of Nil -> Some expected; Cons p rest -> case pattern-result expected p of Some result -> patterns-result result rest; None -> None
  -- Shared declaration closure checks. Global term typing and primitive
  -- semantics remain separate from these retained contract invariants.
  contract-quants-closed :: List Quant -> Bool
  contract-quants-closed qs = effect-quants-scoped qs Nil && closed-quants qs
  -- `contract-scheme-closed` is a six-way conjunction, so a refusal names
  -- nothing. This reports the first clause that refused; the checking form
  -- stays the one every caller uses.
  contract-scheme-refusal :: Scheme -> Option String
  contract-scheme-refusal sc =
    if not (declaration-scheme-closed sc) then Some "body kind is neither a value type nor a proposition"
    else if not (valid-type (scheme-body sc)) then Some "body is not a valid type"
    else if not (scheme-index-scope Nil sc) then Some "an index is out of scope"
    else if not (contract-quants-closed (scheme-params sc)) then Some "a quantifier is not closed"
    else if not (effect-type-scope (scheme-params sc) (scheme-body sc)) then Some "an effect row is out of scope"
    else if not (effect-requirements (scheme-params sc) (scheme-requirements sc)) then Some "a requirement is out of scope"
    else None
  contract-scheme-closed :: Scheme -> Bool
  contract-scheme-closed sc = declaration-scheme-closed sc && valid-type (scheme-body sc)
    && scheme-index-scope Nil sc && contract-quants-closed (scheme-params sc)
    && effect-type-scope (scheme-params sc) (scheme-body sc)
    && effect-requirements (scheme-params sc) (scheme-requirements sc)
  definition-clause-types :: UType -> List CoreClause -> Bool
  definition-clause-types ty clauses = case clauses of
    Nil -> True
    Cons (MkCoreClause s patterns body) rest -> (case patterns-result ty patterns of Some expected -> contract-equal expected (core-type body); None -> False) && definition-clause-types ty rest
  definition-given-types :: List Requirement -> List CoreGiven -> Bool
  definition-given-types requirements givens = case (requirements, givens) of
    (Nil, Nil) -> True
    (Cons r rest, Cons g more) -> contract-equal (requirement-type r) (given-type g) && definition-given-types rest more
    other -> False
  core-definition-result-types :: CoreDefinition -> Bool
  core-definition-result-types definition = let sc = core-scheme definition in let pairs = core-openings definition in
    (case core-clauses definition of Nil -> False; Cons first rest -> True) && definition-given-types (map-requirements (substitute-bound pairs) (scheme-requirements sc)) (core-givens definition)
      && definition-clause-types (substitute-bound pairs (scheme-body sc)) (core-clauses definition)

  proof-expected :: ProofScope -> List Proposition -> UType -> CoreTerm -> Bool
  proof-expected gamma facts expected term = case refinement-view expected of
    URefine id name carrier predicate -> contract-equal expected (core-type term) && proof-refined-term gamma facts term
    URequire predicates result -> case term of
      CRequire s ty body -> contract-equal expected ty && (case scoped-core-predicates gamma predicates of Some introduced -> proof-expected gamma (introduced <> facts) result body; None -> False)
      other -> False
    other -> proof-term gamma facts term
  proof-contract-clauses :: List BodyBinding -> List GuardedBinding -> UType -> List CoreClause -> Bool
  proof-contract-clauses bodies guards expected clauses = proof-contract-clauses-with bodies guards Nil expected clauses
  proof-contract-clauses-with :: List BodyBinding -> List GuardedBinding -> List (Nat, UType) -> UType -> List CoreClause -> Bool
  proof-contract-clauses-with bodies guards values expected clauses = case check-body-bindings bodies of
    Some checked -> proof-contract-clauses-checked checked guards values expected clauses
    None -> False
  proof-contract-clauses-checked :: BodyBindings -> List GuardedBinding -> List (Nat, UType) -> UType -> List CoreClause -> Bool
  proof-contract-clauses-checked bodies guards values expected clauses =
    proof-equations (with-guarded-bindings guards (with-checked-body-bindings bodies (make-proof-scope values Nil))) expected Nil clauses
  proof-equations :: ProofScope -> UType -> List (List CorePattern) -> List CoreClause -> Bool
  proof-equations scope expected earlier clauses = case clauses of
    Nil -> True
    Cons (MkCoreClause s patterns body) rest -> (case patterns-result expected patterns of
      Some result -> let gamma = proof-patterns patterns scope in
        proof-expected gamma (scoped-core-equation-facts gamma earlier patterns) result body
      None -> False) && proof-equations scope expected (extend-equation-prefix patterns body earlier) rest

  selected-method-function :: ProofScope -> CoreTerm -> CoreTerm -> CoreTerm -> Option TotalFunction
  selected-method-function gamma method first second = case method of
    CMethod sp ty name owner slot actuals [CEInstance at factory dictionary Nil (CEArgumentsEnd end)] -> (case selected-method-body dictionary slot (scope-bodies gamma) of
      Some binding -> if not (method-selection-matches dictionary slot name owner actuals factory binding && binding-matches (binding-name binding) "external" (mono ty) binding) then None else
        (case ty of
          UFun domain (UFun next result) -> if contract-equal domain (core-type first) && contract-equal next (core-type second) then Some (binding-function binding) else None
          other -> None)
      None -> None)
    other -> None
  scoped-numeric-method-comparison :: ProofScope -> CoreTerm -> CoreTerm -> CoreTerm -> Option Comparison
  scoped-numeric-method-comparison gamma method first second = case selected-method-function gamma method first second of
    Some function -> (case total-numeric-comparison function of Some relation -> comparison-name relation; None -> None)
    None -> None
  scoped-numeric-method-operation :: ProofScope -> CoreTerm -> CoreTerm -> CoreTerm -> Option String
  scoped-numeric-method-operation gamma method first second = case selected-method-function gamma method first second of
    Some function -> total-numeric-operation function
    None -> None
  -- A type-only caller has no selected implementation body to inspect.
  numeric-method-operation :: CoreTerm -> CoreTerm -> CoreTerm -> Option String
  numeric-method-operation method first second = None

  -- Existing type-only proof APIs keep their interface. Definition-aware
  -- elaboration uses the scoped variants; Core reconstructs those scopes.
  prove-refinement :: List (Nat, UType) -> List Proposition -> UType -> CoreTerm -> Option Proof
  prove-refinement gamma facts ty body = scoped-prove-refinement (make-proof-scope gamma Nil) facts ty body
  prove-predicates :: List (Nat, UType) -> List Proposition -> UType -> Option (List Proof)
  prove-predicates gamma facts ty = scoped-prove-predicates (make-proof-scope gamma Nil) facts ty
  core-predicates :: List (Nat, UType) -> UType -> Option (List Proposition)
  core-predicates gamma ty = scoped-core-predicates (make-proof-scope gamma Nil) ty
  core-condition :: List (Nat, UType) -> List Proposition -> CoreTerm -> Option Proposition
  core-condition gamma facts term = scoped-core-condition (make-proof-scope gamma Nil) facts term
  core-let-fact :: List (Nat, UType) -> List Proposition -> Nat -> Scheme -> CoreTerm -> Option Proposition
  core-let-fact gamma facts id sc rhs = scoped-core-let-fact (make-proof-scope gamma Nil) facts id sc rhs
  prove-subtraction :: List (Nat, UType) -> List Proposition -> CoreTerm -> CoreTerm -> Option Proof
  prove-subtraction gamma facts first second = scoped-prove-subtraction (make-proof-scope gamma Nil) facts first second

  -- A global call gets no semantics from its annotation. Lookup starts in
  -- the actual declaration-owned body context and checks the complete type.
  body-call-key :: BodyBinding -> String
  body-call-key binding = string-concat "#total-body:" (binding-native binding)
  total-call-spine :: ProofScope -> CoreTerm -> List CoreTerm -> Option (BodyBinding, List CoreTerm)
  total-call-spine gamma term arguments = case term of
    CApply sp ty function input -> total-call-spine gamma function (Cons input arguments)
    CUse sp ty name role Nil -> (case body-binding name (scope-bodies gamma) of
      Some binding -> if binding-matches name role (mono ty) binding then Some (binding, arguments) else None
      None -> None)
    other -> None
  total-call-values :: ProofScope -> List Proposition -> UType -> List CoreTerm -> Option (UType, UType)
  total-call-values gamma facts ty inputs = case inputs of
    Nil -> Some (UEnd, ty)
    Cons input rest -> (case ty of
      UFun domain result -> if contract-equal domain (core-type input) && proof-term gamma facts input then
        (case (actual-index gamma facts input, total-call-values gamma facts result rest) of
          (Some value, Some (values, output)) -> if kind-equal (type-kind value) (value-kind domain) then Some (UArg value values, output) else None
          other -> None) else None
      UFunEff domain (URow UEnd) result -> total-call-values gamma facts (UFun domain result) inputs
      other -> None)
  checked-total-index :: ProofScope -> List Proposition -> CoreTerm -> Option UType
  checked-total-index gamma facts term = case total-call-spine gamma term Nil of
    Some (binding, inputs) -> (case total-call-values gamma facts (scheme-body (binding-scheme binding)) inputs of
      Some (values, result) -> if contract-equal result (core-type term) then
        let value = UIndexCall (binding-function binding) values in
        if typed-index-admissible value then Some value else None else None
      None -> None)
    None -> None
  projected-index :: ProofScope -> List Proposition -> UType -> CoreTerm -> Option UType
  projected-index gamma facts carrier body = case actual-index gamma facts body of
    Some (UIndexCall function args) -> let value = UIndexCall function args in if kind-equal (type-kind value) (value-kind carrier) then Some value else None
    Some value -> let out = UIndexForget value in if typed-index-admissible out then Some out else None
    None -> None
  total-value-call-key :: ProofScope -> UType -> String -> Option Arithmetic
  total-value-call-key gamma value sort = case value of
    UIndexCall function arguments -> (case body-function function (scope-bodies gamma) of
      Some binding -> if not (string-compare (total-result function) sort == 0) then None else
        (case body-index-arguments gamma function arguments of
          Some keys -> if string-compare sort "Bytes" == 0 then
            (case total-bytes-reading function keys of Some length -> Some length; None -> Some (ACall (string-concat "#total-bytes-length:" (binding-native binding)) keys))
            else (case total-boolean-reading function keys of Some flag -> Some (AInteger (if flag then 1 else 0)); None -> Some (ACall (body-call-key binding) keys))
          None -> None)
      None -> None)
    other -> None
  body-index-arguments :: ProofScope -> TotalFunction -> UType -> Option Arithmetic
  body-index-arguments gamma function arguments = if total-source-projection function then
    (case (total-parameters function, arguments) of
      ([domain], UArg value UEnd) -> (case nominal-index-key gamma (UCon domain KType) value of
        Some key -> Some (AArgument key AArgumentsEnd)
        None -> None)
      other -> None)
    else total-index-arguments gamma (total-parameters function) arguments
  nominal-index-key :: ProofScope -> UType -> UType -> Option Arithmetic
  nominal-index-key gamma expected value = case value of
    UIndex carrier (IRigid id name level) -> case proof-local id gamma of
      Some declared -> if not (contract-equal expected carrier && contract-equal carrier declared) then None else
        (case scope-value id gamma of
          Some alias -> nominal-index-key (scope-without-value id gamma) expected alias
          None -> Some (AVariable ("#nominal-value:" <> nat-to-string id)))
      None -> None
    other -> None
  total-argument-key :: ProofScope -> String -> UType -> Option Arithmetic
  total-argument-key gamma sort value = if not (typed-index-admissible value && kind-equal (type-kind value) (value-kind (UCon sort KType))) then None else
    if string-compare sort "Bytes" == 0 then byte-observation-reading gamma value
    else if string-compare sort "Bool" == 0 then (case value of
      UIndex carrier (IRigid id name level) -> (case proof-local id gamma of Some declared -> if contract-equal carrier declared then Some (AVariable (string-concat "#total-bool:" (nat-to-string id))) else None; None -> None)
      other -> total-value-call-key gamma value sort)
    else typed-index-arithmetic gamma value
  total-index-arguments :: ProofScope -> List String -> UType -> Option Arithmetic
  total-index-arguments gamma sorts arguments = case (sorts, arguments) of
    (Nil, UEnd) -> Some AArgumentsEnd
    (Cons sort rest, UArg first more) -> (case (total-argument-key gamma sort first, total-index-arguments gamma rest more) of (Some value, Some others) -> Some (AArgument value others); other -> None)
    other -> None
  body-key-binding :: String -> List BodyBinding -> Option BodyBinding
  body-key-binding key bindings = case bindings of Nil -> None; Cons first rest -> if string-compare key (body-call-key first) == 0 then Some first else body-key-binding key rest
  body-application-facts :: BodyBinding -> Arithmetic -> List Proposition
  body-application-facts binding value = let function = binding-function binding in
    (if string-compare (total-result function) "Nat" == 0 then [PCompare AtLeast value (AInteger 0)] else Nil)
    <> (case total-bounds function of Some (low, high) -> [PCompare AtLeast value (AInteger low), PCompare AtMost value (AInteger high)]; None -> Nil)
  arithmetic-body-facts :: ProofScope -> Arithmetic -> List Proposition
  arithmetic-body-facts gamma value = case value of
    ACall key arguments -> (case body-key-binding key (scope-bodies gamma) of Some binding -> body-application-facts binding value <> (case total-numeric-reading (binding-function binding) arguments of Some reading -> [PCompare Equal value reading]; None -> Nil); None -> Nil) <> arithmetic-body-facts gamma arguments
    AArgument first rest -> arithmetic-body-facts gamma first <> arithmetic-body-facts gamma rest
    APlus a b -> arithmetic-body-facts gamma a <> arithmetic-body-facts gamma b
    AMinus a b -> arithmetic-body-facts gamma a <> arithmetic-body-facts gamma b
    ATimes a b -> arithmetic-body-facts gamma a <> arithmetic-body-facts gamma b
    other -> Nil
  proposition-body-facts :: ProofScope -> Proposition -> List Proposition
  proposition-body-facts gamma goal = case goal of
    PCompare relation a b -> arithmetic-body-facts gamma a <> arithmetic-body-facts gamma b
    PBoth a b -> proposition-body-facts gamma a <> proposition-body-facts gamma b
    PEither a b -> proposition-body-facts gamma a <> proposition-body-facts gamma b
    PNegate body -> proposition-body-facts gamma body
    other -> Nil
  goals-body-facts :: ProofScope -> List Proposition -> List Proposition
  goals-body-facts gamma goals = case goals of Nil -> Nil; Cons goal rest -> proposition-body-facts gamma goal <> goals-body-facts gamma rest
  goal-assumptions :: ProofScope -> List Proposition -> List Proposition -> List Proposition
  goal-assumptions gamma facts goals =
    let hypotheses = proof-assumptions gamma facts in
    -- A checked call can occur only in an existing refinement, while the
    -- requested weaker result no longer mentions it. Its actual body still
    -- supplies its bounds. Both proof search and certificate checking rebuild
    -- these facts from the same declaration-bound body authority.
    hypotheses <> goals-body-facts gamma (hypotheses <> goals)

  scoped-total-call-index :: ProofScope -> List Proposition -> CoreTerm -> Option UType
  scoped-total-call-index gamma facts term = if not (proof-term gamma facts term) then None else case actual-index gamma facts term of
    Some (UIndexCall function arguments) -> Some (UIndexCall function arguments)
    other -> None


  scope-guarded-bodies :: ProofScope -> List GuardedBinding
  scope-guarded-bodies scope = case scope of MkProofScope types values proofs bodies guards -> guards
  with-guarded-bindings :: List GuardedBinding -> ProofScope -> ProofScope
  with-guarded-bindings bindings scope = if guarded-bindings-closed bindings then (case scope of MkProofScope types values proofs bodies old -> MkProofScope types values proofs bodies bindings) else scope
  guarded-call-spine :: ProofScope -> CoreTerm -> List CoreTerm -> Option (GuardedBinding, List CoreTerm)
  guarded-call-spine gamma term arguments = case term of
    CApply sp ty function argument -> guarded-call-spine gamma function (Cons argument arguments)
    CApplyEff sp ty (URow UEnd) function argument -> guarded-call-spine gamma function (Cons argument arguments)
    CUse sp ty name role Nil -> if string-compare role "external" /= 0 then None else (case guarded-binding name (scope-guarded-bodies gamma) of
      Some binding -> if guarded-matches name role (mono ty) binding && list-length arguments == guarded-arity binding then Some (binding, arguments) else None
      None -> None)
    other -> None
  guarded-actuals :: ProofScope -> List Proposition -> List CoreTerm -> Option (List UType)
  guarded-actuals gamma facts arguments = case arguments of
    Nil -> Some Nil
    Cons first rest -> if not (nat-type (core-type first) && proof-term gamma facts first) then None else (case (actual-index gamma facts first, guarded-actuals gamma facts rest) of
      (Some value, Some more) -> Some (Cons value more)
      other -> None)
  scoped-guarded-call-index :: ProofScope -> List Proposition -> CoreTerm -> Option UType
  scoped-guarded-call-index gamma facts term = case term of
    CDischarge sp ty evidence body -> if not (nat-type ty && discharged gamma facts ty evidence body) then None else (case guarded-call-spine gamma body Nil of
      Some (binding, arguments) -> (case guarded-actuals gamma facts arguments of Some values -> guarded-index binding values; None -> None)
      None -> None)
    other -> None

  guarded-actual-readings :: ProofScope -> List Proposition -> List CoreTerm -> Option (List Arithmetic)
  guarded-actual-readings gamma facts arguments = case arguments of
    Nil -> Some Nil
    Cons first rest -> if not (nat-type (core-type first) && proof-term gamma facts first) then None else (case (core-arithmetic gamma facts first, guarded-actual-readings gamma facts rest) of
      (Some value, Some more) -> Some (Cons value more)
      other -> None)
  scoped-guarded-call-reading :: ProofScope -> List Proposition -> CoreTerm -> Option Arithmetic
  scoped-guarded-call-reading gamma facts term = case term of
    CDischarge sp ty evidence body -> if not (nat-type ty && discharged gamma facts ty evidence body) then None else (case guarded-call-spine gamma body Nil of
      Some (binding, arguments) -> (case guarded-actual-readings gamma facts arguments of Some values -> guarded-reading binding values; None -> None)
      None -> None)
    other -> None


  -- Reconstruct a closed executable graph from actual retained definitions.
  -- This supplies no authority by itself: the caller must still associate
  -- the graph with the declaration checked by the independent global kernel.
  -- Unsupported, effectful, polymorphic and cyclic bodies yield no graph.
  total-core-sort :: UType -> Option String
  total-core-sort ty = case ty of
    UCon name KType -> if string-compare name "Nat" == 0 || string-compare name "Int" == 0 || string-compare name "Bool" == 0 || string-compare name "Bytes" == 0 || string-compare name "I64" == 0 then Some name else None
    other -> None
  -- A checked result/local refinement keeps the same numeric runtime carrier.
  -- Domains remain plain sorts; this does not erase an input obligation.
  total-core-value-sort :: UType -> Option String
  total-core-value-sort ty = case refinement-view ty of
    URefine id name carrier predicate -> case total-core-sort carrier of
      Some sort -> if total-core-has sort ["Nat", "Int", "I64"] then Some sort else None
      None -> None
    other -> total-core-sort ty
  total-core-json-list :: List Json -> Json
  total-core-json-list values = case values of Nil -> JArrEnd; Cons first rest -> JArr first (total-core-json-list rest)
  total-core-text-list :: List String -> Json
  total-core-text-list values = case values of Nil -> JArrEnd; Cons first rest -> JArr (JStr first) (total-core-text-list rest)
  total-core-field :: String -> Json -> Json
  total-core-field name value = case value of JObj key item rest -> if string-compare name key == 0 then item else total-core-field name rest; other -> JNull
  total-core-text :: Json -> String
  total-core-text value = case value of JStr text -> text; other -> ""
  total-core-members :: Json -> List Json
  total-core-members values = case values of JArr first rest -> Cons first (total-core-members rest); other -> Nil
  total-core-has :: String -> List String -> Bool
  total-core-has name values = case values of Nil -> False; Cons first rest -> string-compare name first == 0 || total-core-has name rest
  -- The sorts of a curried signature, in written order.
  --
  -- The accumulator is REVERSED and flipped once at the result arm. Appending
  -- a singleton per arrow is an append of a growing list, so arity `a` cost
  -- `a^2/2` conses; a cons per arrow and one `reverse` is `a`. The list handed
  -- back is the same list in the same order, which is what the caller's
  -- `total-core-parameters` and the emitted `parameters` row observe.
  total-core-signature :: UType -> Option (List String, String)
  total-core-signature ty = total-core-signature-into Nil ty
  total-core-signature-into :: List String -> UType -> Option (List String, String)
  total-core-signature-into backwards ty = case ty of
    UFun domain result -> case total-core-sort domain of Some sort -> total-core-signature-into (Cons sort backwards) result; None -> None
    UFunEff domain (URow UEnd) result -> case total-core-sort domain of Some sort -> total-core-signature-into (Cons sort backwards) result; None -> None
    UPi id name domain (URow UEnd) result -> if pi-dependent ty then None else (case total-core-sort domain of Some sort -> total-core-signature-into (Cons sort backwards) result; None -> None)
    other -> case total-core-value-sort ty of Some sort -> Some (reverse backwards, sort); None -> None
  -- Whether an identity is already bound in the accumulator. The accumulator
  -- is reversed, and this question is about membership, so the order the scan
  -- walks is irrelevant: it is the same test the slot-indexed lookup made
  -- before the accumulator was reversed.
  total-core-scope-bound :: Nat -> List (Option Nat, String) -> Bool
  total-core-scope-bound id scope = case scope of
    Nil -> False
    Cons (Some key, sort) rest -> id == key || total-core-scope-bound id rest
    Cons (None, sort) rest -> total-core-scope-bound id rest
  total-core-local :: Nat -> List (Option Nat, String) -> Nat -> Option (Nat, String)
  total-core-local id scope slot = case scope of
    Nil -> None
    Cons (Some key, sort) rest -> if id == key then Some (slot, sort) else total-core-local id rest (slot + 1)
    Cons (None, sort) rest -> total-core-local id rest (slot + 1)
  -- The lambda scope a clause's patterns bind, in written order.
  --
  -- Same reversal as `total-core-signature`: the accumulator is built with
  -- `Cons` and flipped once at the terminal arm, so arity `a` costs `a` rather
  -- than `a^2/2`. The scope is read by slot index (`total-core-local`), so the
  -- order is observable and the flip is what preserves it.
  total-core-parameters :: List String -> List CorePattern -> Option (List (Option Nat, String))
  total-core-parameters sorts patterns = total-core-parameters-into Nil sorts patterns
  total-core-parameters-into :: List (Option Nat, String) -> List String -> List CorePattern -> Option (List (Option Nat, String))
  total-core-parameters-into backwards sorts patterns = case (sorts, patterns) of
    (Nil, Nil) -> Some (reverse backwards)
    (Cons sort rest, Cons (CPVar sp ty id name) more) -> case total-core-sort ty of
      Some actual -> if string-compare sort actual == 0 && not (total-core-scope-bound id backwards) then total-core-parameters-into (Cons (Some id, sort) backwards) rest more else None
      None -> None
    (Cons sort rest, Cons (CPWild sp ty) more) -> case total-core-sort ty of
      Some actual -> if string-compare sort actual == 0 then total-core-parameters-into (Cons (None, sort) backwards) rest more else None
      None -> None
    other -> None
  total-core-flatten :: List CorePattern -> CoreTerm -> (List CorePattern, CoreTerm)
  total-core-flatten patterns body = total-core-flatten-into (reverse patterns) body
  total-core-flatten-into :: List CorePattern -> CoreTerm -> (List CorePattern, CoreTerm)
  total-core-flatten-into backwards body = case body of
    CLambda sp ty pattern inner -> total-core-flatten-into (Cons pattern backwards) inner
    other -> (reverse backwards, body)
  total-core-definition :: String -> List CoreDefinition -> Option CoreDefinition
  total-core-definition name definitions = case definitions of
    Nil -> None
    Cons first rest -> if string-compare name (core-name first) == 0 then Some first else total-core-definition name rest
  total-core-native-definition :: String -> List CoreDefinition -> Option CoreDefinition
  total-core-native-definition name definitions = case definitions of
    Nil -> None
    Cons first rest -> case export-global (core-name first) of
      Ok native -> if string-compare name native == 0 then Some first else total-core-native-definition name rest
      Err error -> total-core-native-definition name rest
  total-core-head :: CoreTerm -> CoreTerm
  total-core-head term = case term of CApply sp ty f x -> total-core-head f; CApplyEff sp ty row f x -> total-core-head f; other -> term
  total-core-arguments :: CoreTerm -> List CoreTerm -> List CoreTerm
  total-core-arguments term rest = case term of CApply sp ty f x -> total-core-arguments f (Cons x rest); CApplyEff sp ty row f x -> total-core-arguments f (Cons x rest); other -> rest
  total-core-primitive :: String -> List Json -> Json
  total-core-primitive operation arguments = JObj "node" (JStr "primitive") (JObj "operation" (JStr operation) (JObj "arguments" (total-core-json-list arguments) JObjEnd))
  total-core-number :: String -> String -> Json
  total-core-number sort decimal = JObj "node" (JStr "number") (JObj "sort" (JStr sort) (JObj "decimal" (JStr decimal) JObjEnd))
  total-core-relation :: String -> Option String
  total-core-relation relation = if string-compare relation "==" == 0 then Some "I64Eq" else if string-compare relation "/=" == 0 then Some "I64Ne" else if string-compare relation "<" == 0 then Some "I64Lt" else if string-compare relation "<=" == 0 then Some "I64Le" else if string-compare relation ">" == 0 then Some "I64Gt" else if string-compare relation ">=" == 0 then Some "I64Ge" else None
  total-core-operation :: String -> List CoreTerm -> List Json -> Option Json
  total-core-operation operation terms values = case (terms, values) of
    ([first], [value]) -> (case total-core-sort (core-type first) of
      Some sort -> if string-compare operation "negate" == 0 && string-compare sort "Int" == 0 then Some (total-core-primitive "IntNeg" [value]) else None
      None -> None)
    ([first, second], [left, right]) -> (case (total-core-sort (core-type first), total-core-sort (core-type second)) of
      (Some sort, Some other) -> if string-compare sort other /= 0 then None else
        if string-compare sort "Nat" == 0 || string-compare sort "Int" == 0 then
          (let prefix = if string-compare sort "Nat" == 0 then "Nat" else "Int" in
           if string-compare operation "+" == 0 then Some (total-core-primitive (prefix <> "Add") [left, right])
           else if string-compare operation "*" == 0 then Some (total-core-primitive (prefix <> "Mul") [left, right])
           else if string-compare operation "-" == 0 && string-compare sort "Int" == 0 then Some (total-core-primitive "IntSub" [left, right])
           else case total-core-relation operation of
             Some relation -> Some (total-core-primitive relation [total-core-primitive (prefix <> "Cmp") [left, right], total-core-number "I64" "0"])
             None -> None)
        else if string-compare sort "I64" == 0 then (case total-core-relation operation of Some relation -> Some (total-core-primitive relation [left, right]); None -> None)
        else if string-compare sort "Bool" == 0 && (string-compare operation "==" == 0 || string-compare operation "/=" == 0) then Some (total-core-primitive (if string-compare operation "==" == 0 then "BoolEq" else "BoolNe") [left, right]) else None
      other -> None)
    other -> None
  total-core-expressions :: List BodyBinding -> TotalCoreIndex -> List (Option Nat, String) -> List CoreTerm -> Option (List Json, List String)
  total-core-expressions bindings index scope terms = case terms of
    Nil -> Some (Nil, Nil)
    Cons first rest -> case (total-core-expression bindings index scope first, total-core-expressions bindings index scope rest) of
      (Some (value, calls), Some (more, others)) -> Some (Cons value more, calls <> others)
      other -> None
  total-core-call :: List BodyBinding -> TotalCoreIndex -> List (Option Nat, String) -> CoreTerm -> Option (Json, List String)
  total-core-call bindings index scope term = case total-core-head term of
    CUse sp ty name role Nil -> (case total-core-expressions bindings index scope (total-core-arguments term Nil) of
      None -> None
      Some (arguments, references) -> if byte-length-function (core-type term) ty name role then
        (case arguments of [argument] -> Some (total-core-primitive "BytesLen" [argument], references); other -> None)
        else case total-core-indexed-definition name index of
          Some definition -> if string-compare role "value" /= 0 || not (contract-equal ty (scheme-body (core-scheme definition))) then None else
            (case export-global name of
              Ok native -> Some (JObj "node" (JStr "call") (JObj "target" (JStr native) (JObj "arguments" (total-core-json-list arguments) JObjEnd)), Cons name references)
              Err error -> None)
          None -> case body-binding name bindings of
            Some binding -> if binding-matches name role (mono ty) binding then Some (JObj "node" (JStr "call") (JObj "target" (JStr (binding-native binding)) (JObj "arguments" (total-core-json-list arguments) JObjEnd)), Cons name references) else None
            None -> None)
    CMethod sp ty name owner slot actuals [CEInstance at factory dictionary Nil (CEArgumentsEnd end)] ->
      (case selected-method-body dictionary slot bindings of
        Some binding -> if not (binding-matches (binding-name binding) "external" (mono ty) binding && method-selection-matches dictionary slot name owner actuals factory binding) then None else
          (case total-core-expressions bindings index scope (total-core-arguments term Nil) of
            Some (arguments, references) -> Some (JObj "node" (JStr "call") (JObj "target" (JStr (binding-native binding)) (JObj "arguments" (total-core-json-list arguments) JObjEnd)), Cons (binding-name binding) references)
            None -> None)
        None -> None)
    other -> None
  total-core-expression :: List BodyBinding -> TotalCoreIndex -> List (Option Nat, String) -> CoreTerm -> Option (Json, List String)
  total-core-expression bindings index scope term = if not (contract-equal (core-effects term) (URow UEnd)) then None else case term of
    CLocal sp ty id name Nil -> (case (total-core-local id scope 0, total-core-value-sort ty) of
      (Some (slot, expected), Some actual) -> if string-compare expected actual == 0 then Some (JObj "node" (JStr "local") (JObj "slot" (JNum (nat-to-int slot)) JObjEnd), Nil) else None
      other -> None)
    CInt sp ty decimal -> (case total-core-value-sort ty of Some sort -> Some (total-core-number sort decimal, Nil); None -> None)
    CIf sp ty condition yes no -> (case (total-core-expression bindings index scope condition, total-core-expression bindings index scope yes, total-core-expression bindings index scope no) of
      (Some (test, called), Some (first, left), Some (second, right)) -> Some (JObj "node" (JStr "if") (JObj "condition" test (JObj "yes" first (JObj "no" second JObjEnd))), called <> left <> right)
      other -> None)
    CLet sp ty id name sc rhs body -> if (case (scheme-params sc, scheme-requirements sc) of (Nil, Nil) -> True; other -> False) then
      (case (total-core-expression bindings index scope rhs, total-core-value-sort (scheme-body sc)) of
        (Some (value, called), Some sort) -> (case total-core-expression bindings index (scope <> [(Some id, sort)]) body of
          Some (inside, more) -> Some (JObj "node" (JStr "let") (JObj "value" value (JObj "body" inside JObjEnd)), called <> more)
          None -> None)
        other -> None) else None
    CRefine sp ty evidence body -> total-core-expression bindings index scope body
    CForget sp ty body -> total-core-expression bindings index scope body
    CPrimitive sp ty operation fields -> (case total-core-term-list fields of
      Some terms -> (case total-core-expressions bindings index scope terms of
        Some (values, references) -> (case total-core-operation operation terms values of Some value -> Some (value, references); None -> None)
        None -> None)
      None -> None)
    CUse sp ty name role Nil -> if decision-constant True term then Some (JObj "node" (JStr "bool") (JObj "value" (JBool True) JObjEnd), Nil) else if decision-constant False term then Some (JObj "node" (JStr "bool") (JObj "value" (JBool False) JObjEnd), Nil) else total-core-call bindings index scope term
    CApply sp ty f x -> total-core-call bindings index scope term
    CApplyEff sp ty row f x -> total-core-call bindings index scope term
    other -> None
  total-core-term-list :: CoreTerm -> Option (List CoreTerm)
  total-core-term-list terms = case terms of
    CArgumentsEnd sp -> Some Nil
    CArgument sp first rest -> (case total-core-term-list rest of Some more -> Some (Cons first more); None -> None)
    other -> None
  total-core-row :: List BodyBinding -> TotalCoreIndex -> CoreDefinition -> Option (Json, List String)
  total-core-row bindings index definition = if not (core-definition-closed definition && core-definition-result-types definition) then None else
    case (scheme-params (core-scheme definition), scheme-requirements (core-scheme definition), core-givens definition, core-clauses definition) of
      (Nil, Nil, Nil, [MkCoreClause sp patterns body]) -> (case (total-core-signature (scheme-body (core-scheme definition)), export-global (core-name definition), total-core-flatten patterns body) of
        (Some (parameters, result), Ok native, (arguments, inner)) -> (case total-core-parameters parameters arguments of
          Some scope -> (case total-core-expression bindings index scope inner of
            Some (value, references) -> Some (JObj "identity" (JStr native) (JObj "parameters" (total-core-text-list parameters) (JObj "result" (JStr result) (JObj "body" value JObjEnd))), references)
            None -> None)
          None -> None)
        other -> None)
      other -> None
  -- The definition list, indexed by the name a lookup asks for.
  --
  -- `total-core-gather` walked `definitions` linearly once per reference, so a
  -- closure of k rows over a list of d definitions cost k*d name comparisons
  -- before any row was built. The walk is the price of each gather, and the
  -- gather runs once per binding, so that product was the term that survived
  -- the sort-once change. One table per gather turns each of those walks into
  -- a probe. The table's value is the definition, so nothing about what a
  -- lookup answers moved; a name the list does not hold is still `None`.
  data TotalCoreIndex where
    MkTotalCoreIndex :: HashMap String CoreDefinition -> TotalCoreIndex
  total-core-index :: List CoreDefinition -> TotalCoreIndex
  total-core-index definitions = MkTotalCoreIndex (total-core-index-into definitions hash-map-empty)
  total-core-index-into :: List CoreDefinition -> HashMap String CoreDefinition -> HashMap String CoreDefinition
  total-core-index-into definitions table = case definitions of
    Nil -> table
    Cons definition rest -> total-core-index-into rest (hash-map-insert (core-name definition) definition table)
  total-core-indexed-definition :: String -> TotalCoreIndex -> Option CoreDefinition
  total-core-indexed-definition name index = case index of MkTotalCoreIndex table -> hash-map-lookup name table

  -- The table's ordering, applied once instead of per row.
  --
  -- `total-core-gather` used to insert each row into a sorted `List Json`, so a
  -- closure of k rows cost k sorted insertions into a list of up to k rows.
  -- The gather now collects the rows in dependency order and this orders them
  -- once, then applies the duplicate rule in one adjacency pass. Nothing
  -- observable moved: the order is the same identity order, and a stable sort
  -- keeps the first gathered row of an identity group first, which is the row
  -- the sorted insertion kept. A group whose canonical bytes disagree still
  -- refuses the table.
  total-core-identity :: Json -> String
  total-core-identity row = total-core-text (total-core-field "identity" row)
  total-core-halve :: List Json -> List Json -> List Json -> (List Json, List Json)
  total-core-halve slow fast left = case fast of
    Nil -> (reverse left, slow)
    Cons first rest -> case rest of
      Nil -> (reverse left, slow)
      Cons second more -> case slow of
        Nil -> (reverse left, Nil)
        Cons head tail -> total-core-halve tail more (Cons head left)
  total-core-order-merge :: List Json -> List Json -> List Json
  total-core-order-merge first second = case (first, second) of
    (Nil, other) -> other
    (other, Nil) -> other
    (Cons a left, Cons b right) -> if string-compare (total-core-identity a) (total-core-identity b) <= 0
      then Cons a (total-core-order-merge left second)
      else Cons b (total-core-order-merge first right)
  total-core-ordered :: List Json -> List Json
  total-core-ordered rows = case rows of
    Nil -> Nil
    Cons first rest -> case rest of
      Nil -> rows
      Cons second more -> (case total-core-halve rows rows Nil of
        (left, right) -> total-core-order-merge (total-core-ordered left) (total-core-ordered right))
  total-core-collapse :: List Json -> Option (List Json)
  total-core-collapse rows = case rows of
    Nil -> Some Nil
    Cons first rest -> case rest of
      Nil -> Some (Cons first Nil)
      Cons second more ->
        let order = string-compare (total-core-identity first) (total-core-identity second) in
        if order == 0 then (if bytes-compare (canonical-bytes first) (canonical-bytes second) == 0 then total-core-collapse (Cons first more) else None)
        else (case total-core-collapse rest of Some kept -> Some (Cons first kept); None -> None)
  total-core-table :: List Json -> Option (List Json)
  total-core-table rows = total-core-collapse (total-core-ordered rows)

  -- The gather, accumulating the reversed table so the walk stays linear.
  --
  -- The rows come back reversed and are flipped once, because the duplicate
  -- rule keeps the FIRST gathered row of an identity group: reversing the
  -- accumulator before the stable sort is what makes "first gathered" mean
  -- what it meant when each row was inserted in turn.
  total-core-gather :: List BodyBinding -> TotalCoreIndex -> String -> Option (List Json)
  total-core-gather bindings index name = case total-core-gather-into bindings index Nil Nil name of
    Some backwards -> Some (reverse backwards)
    None -> None
  total-core-gather-into :: List BodyBinding -> TotalCoreIndex -> List String -> List Json -> String -> Option (List Json)
  total-core-gather-into bindings index visiting tail name = if total-core-has name visiting then None else case total-core-indexed-definition name index of
    Some definition -> (case total-core-row bindings index definition of
      Some (row, references) -> (case total-core-gather-list-into bindings index (Cons name visiting) tail references of
        Some rows -> Some (Cons row rows)
        None -> None)
      None -> None)
    None -> (case body-binding name bindings of Some binding -> Some (total-core-document-into (total-core-members (total-core-field "definitions" (total-function-document (binding-function binding)))) tail); None -> None)
  total-core-document-into :: List Json -> List Json -> List Json
  total-core-document-into rows tail = case rows of
    Nil -> tail
    Cons first rest -> total-core-document-into rest (Cons first tail)
  total-core-gather-list-into :: List BodyBinding -> TotalCoreIndex -> List String -> List Json -> List String -> Option (List Json)
  total-core-gather-list-into bindings index visiting tail references = case references of
    Nil -> Some tail
    Cons first rest -> (case total-core-gather-into bindings index visiting tail first of
      Some rows -> total-core-gather-list-into bindings index visiting rows rest
      None -> None)
  core-total-function :: List BodyBinding -> List CoreDefinition -> String -> Option TotalFunction
  core-total-function bindings definitions native = case total-core-native-definition native definitions of
    Some definition -> (case total-core-gather bindings (total-core-index definitions) (core-name definition) of
      Some rows -> (case total-core-table rows of
        Some ordered -> (case check-total-graph (JObj "version" (JNum 1) (JObj "definitions" (total-core-json-list ordered) JObjEnd)) of Some graph -> total-function graph native; None -> None)
        None -> None)
      None -> None)
    None -> None

  -- A projection can only select a field through exhaustive matches on
  -- checked, monomorphic source constructors. Constructor and field
  -- identities come from the real declaration and the retained pattern.
  projection-constructor :: List CoreData -> String -> Option CoreConstructor
  projection-constructor datas name = case datas of
    Nil -> None
    Cons nominal rest -> if string-compare name (core-data-name nominal) == 0 then
      (case (core-data-kind nominal, core-data-params nominal, core-data-constructors nominal) of
        (KType, Nil, [constructor]) -> Some constructor
        other -> None)
      else projection-constructor rest name
  projection-fields :: UType -> UType -> Option (List UType)
  projection-fields expected ty = case ty of
    UFun domain result -> (case projection-fields expected result of Some fields -> Some (Cons domain fields); None -> None)
    UCon name KType -> if contract-equal expected ty then Some Nil else None
    other -> None
  projection-bindings :: String -> List (String, Nat) -> Nat -> List UType -> CorePattern -> List (Nat, UType, List (String, Nat)) -> Option (List (Nat, UType, List (String, Nat)))
  projection-bindings constructor path index fields pattern scope = case (fields, pattern) of
    (Nil, CPDone sp) -> Some scope
    (Cons ty rest, CPField sp (CPVar at actual id name) tail) -> if contract-equal ty actual then
      projection-bindings constructor path (index + 1) rest tail (Cons (id, ty, path <> [(constructor, index)]) scope) else None
    (Cons ty rest, CPField sp (CPWild at actual) tail) -> if contract-equal ty actual then
      projection-bindings constructor path (index + 1) rest tail scope else None
    other -> None
  projection-local :: Nat -> UType -> List (Nat, UType, List (String, Nat)) -> Option (List (String, Nat))
  projection-local id ty scope = case scope of
    Nil -> None
    Cons (bound, carrier, path) rest -> if id == bound then (if contract-equal ty carrier then Some path else None) else projection-local id ty rest
  projection-expression :: List CoreData -> List (Nat, UType, List (String, Nat)) -> CoreTerm -> Option (List (String, Nat))
  projection-expression datas scope term = case term of
    CLocal sp (UCon name KType) id label Nil -> if string-compare name "Bytes" == 0 then projection-local id (UCon name KType) scope else None
    CCase sp result (CLocal at (UCon carrier KType) id label Nil)
      (CAlternative arm (CPConstructor pat matched constructor Nil ctor-type fields) body (CAlternativesEnd end)) ->
        let input = UCon carrier KType in
        if not (contract-equal matched input && contract-equal result (core-type body)) then None else
          (case (projection-local id input scope, projection-constructor datas carrier) of
            (Some path, Some definition) -> let sc = core-constructor-scheme definition in
              if not (string-compare constructor (core-constructor-name definition) == 0 && contract-equal ctor-type (scheme-body sc)) then None else
                (case (scheme-params sc, scheme-requirements sc, projection-fields input ctor-type) of
                  (Nil, Nil, Some field-types) -> (case projection-bindings constructor path 0 field-types fields scope of
                    Some inner -> projection-expression datas inner body
                    None -> None)
                  other -> None)
            other -> None)
    other -> None
  core-byte-projection :: List CoreData -> CoreDefinition -> String -> Option TotalFunction
  core-byte-projection datas definition native = if not (core-definition-closed definition && core-definition-result-types definition) then None else
    let sc = core-scheme definition in
    case (scheme-params sc, scheme-requirements sc, core-givens definition, scheme-body sc, core-clauses definition) of
      (Nil, Nil, Nil, UFun (UCon domain KType) (UCon result KType), [MkCoreClause sp [CPVar at input id label] body]) ->
        if not (string-compare result "Bytes" == 0 && contract-equal input (UCon domain KType) && contract-equal (core-effects body) (URow UEnd)) then None else
          (case projection-expression datas [(id, input, Nil)] body of Some steps -> source-total-projection native domain steps; None -> None)
      other -> None
  core-source-function :: List BodyBinding -> List CoreDefinition -> List CoreData -> String -> Option TotalFunction
  core-source-function bindings definitions datas native = case core-total-function bindings definitions native of
    Some function -> Some function
    None -> (case total-core-native-definition native definitions of Some definition -> core-byte-projection datas definition native; None -> None)
  core-source-body :: List BodyBinding -> List CoreDefinition -> List CoreData -> String -> Option BodyBinding
  core-source-body bindings definitions datas native = case total-core-native-definition native definitions of
    Some definition -> (case core-source-function bindings definitions datas native of
      Some function -> check-source-body-binding (core-name definition) native (core-scheme definition) function
      None -> None)
    None -> None
  -- Apply the real closed self dictionary before reading a method body.
  -- The table is built from the checked defining class slots and actual
  -- dictionary fields. It also lets the ordinary graph checker reject
  -- recursive method cycles rather than inventing equations for a slot.
  total-method-member :: Nat -> List (Nat, String, String, CoreDefinition) -> Option (String, String, CoreDefinition)
  total-method-member slot members = case members of
    Nil -> None
    Cons (number, selector, native, definition) rest -> if slot == number then Some (selector, native, definition) else total-method-member slot rest
  total-method-types :: List UType -> List UType -> Bool
  total-method-types first second = case (first, second) of
    (Nil, Nil) -> True
    (Cons a rest, Cons b more) -> contract-equal a b && total-method-types rest more
    other -> False
  total-method-spine :: UType -> List UType -> (UType, List UType)
  total-method-spine ty arguments = case ty of UApp head argument -> total-method-spine head (Cons argument arguments); other -> (ty, arguments)
  total-method-self :: String -> String -> UType -> CoreEvidence -> Bool
  total-method-self given dictionary factory evidence = contract-equal factory (evidence-type evidence) && (case evidence of
    CEGiven sp ty symbol -> string-compare symbol given == 0
    CEInstance sp ty symbol Nil (CEArgumentsEnd end) -> string-compare symbol dictionary == 0
    other -> False)
  total-method-term :: String -> String -> String -> UType -> List (Nat, String, String, CoreDefinition) -> CoreTerm -> Option CoreTerm
  total-method-term given dictionary owner factory members term = case term of
    CUse sp ty name role actuals -> Some term
    CLocal sp ty id name actuals -> Some term
    CInt sp ty text -> Some term
    CString sp ty text -> Some term
    CChar sp ty text -> Some term
    CUnit sp ty -> Some term
    CMethod sp ty name declaring slot actuals [evidence] ->
      if total-method-self given dictionary factory evidence then
        (case (total-method-member slot members, total-method-spine factory Nil, export-global name) of
          (Some (selector, native, definition), (UCon subject kind, arguments), Ok selected) ->
            if string-compare owner declaring == 0 && string-compare owner subject == 0 && string-compare selected selector == 0
              && total-method-types actuals arguments && contract-equal ty (scheme-body (core-scheme definition)) then
                Some (CUse sp ty (interface-global native) "value" Nil)
            else None
          other -> None)
      else (case evidence of CEInstance at subject symbol Nil (CEArgumentsEnd end) -> Some term; other -> None)
    CApply sp ty function argument -> (case (total-method-term given dictionary owner factory members function, total-method-term given dictionary owner factory members argument) of
      (Some f, Some x) -> Some (CApply sp ty f x)
      other -> None)
    CApplyEff sp ty row function argument -> (case (total-method-term given dictionary owner factory members function, total-method-term given dictionary owner factory members argument) of
      (Some f, Some x) -> Some (CApplyEff sp ty row f x)
      other -> None)
    CLambda sp ty pattern body -> (case total-method-term given dictionary owner factory members body of Some out -> Some (CLambda sp ty pattern out); None -> None)
    CLet sp ty id name sc value body -> (case (total-method-term given dictionary owner factory members value, total-method-term given dictionary owner factory members body) of
      (Some first, Some rest) -> Some (CLet sp ty id name sc first rest)
      other -> None)
    CIf sp ty condition yes no -> (case (total-method-term given dictionary owner factory members condition, total-method-term given dictionary owner factory members yes, total-method-term given dictionary owner factory members no) of
      (Some c, Some y, Some n) -> Some (CIf sp ty c y n)
      other -> None)
    CRefine sp ty certificate body -> (case total-method-term given dictionary owner factory members body of Some out -> Some (CRefine sp ty certificate out); None -> None)
    CForget sp ty body -> (case total-method-term given dictionary owner factory members body of Some out -> Some (CForget sp ty out); None -> None)
    CPrimitive sp ty operation arguments -> (case total-method-term given dictionary owner factory members arguments of Some out -> Some (CPrimitive sp ty operation out); None -> None)
    CArgument sp first rest -> (case (total-method-term given dictionary owner factory members first, total-method-term given dictionary owner factory members rest) of
      (Some a, Some b) -> Some (CArgument sp a b)
      other -> None)
    CArgumentsEnd sp -> Some term
    other -> None
  total-method-clauses :: String -> String -> String -> UType -> List (Nat, String, String, CoreDefinition) -> List CoreClause -> Option (List CoreClause)
  total-method-clauses given dictionary owner factory members clauses = case clauses of
    Nil -> Some Nil
    Cons (MkCoreClause sp patterns body) rest -> (case (total-method-term given dictionary owner factory members body, total-method-clauses given dictionary owner factory members rest) of
      (Some out, Some more) -> Some (Cons (MkCoreClause sp patterns out) more)
      other -> None)
  total-method-definition :: List BodyBinding -> String -> String -> Scheme -> List (Nat, String, String, CoreDefinition) -> String -> CoreDefinition -> Option CoreDefinition
  total-method-definition bindings dictionary owner factory members native definition =
    if not (scheme-closed factory && core-definition-bodies-closed bindings definition && core-definition-result-types definition) then None else
      case (scheme-params factory, scheme-requirements factory, definition) of
        (Nil, Nil, MkCoreDefinition sp name sc Nil [given] private clauses) ->
          (case (scheme-params sc, scheme-requirements sc) of
            (Nil, [self]) -> if string-compare (requirement-name self) "#instance-self" /= 0
              || not (contract-equal (requirement-type self) (scheme-body factory) && contract-equal (given-type given) (scheme-body factory)) then None else
                (case total-method-clauses (given-symbol given) dictionary owner (scheme-body factory) members clauses of
                  Some out -> Some (MkCoreDefinition sp (interface-global native) (mono (scheme-body sc)) Nil Nil private out)
                  None -> None)
            other -> None)
        other -> None
  total-method-definitions :: List BodyBinding -> String -> String -> Scheme -> List (Nat, String, String, CoreDefinition) -> List (Nat, String, String, CoreDefinition) -> List CoreDefinition
  total-method-definitions bindings dictionary owner factory all remaining = case remaining of
    Nil -> Nil
    Cons (slot, selector, native, definition) rest -> let more = total-method-definitions bindings dictionary owner factory all rest in
      (case total-method-definition bindings dictionary owner factory all native definition of Some actual -> Cons actual more; None -> more)
  core-method-total-function :: List BodyBinding -> List CoreDefinition -> String -> String -> Scheme -> List (Nat, String, String, CoreDefinition) -> Nat -> Option TotalFunction
  core-method-total-function bindings definitions dictionary owner factory members slot = case total-method-member slot members of
    Some (selector, native, definition) -> core-total-function bindings (total-method-definitions bindings dictionary owner factory members members <> definitions) native
    None -> None
  -- Whether a total function's graph uses the definition whose identity
  -- export-global decoded as `decoded`.
  core-total-function-uses-native :: TotalFunction -> Result String String -> Bool
  core-total-function-uses-native function decoded = case decoded of
    Ok native -> if total-source-projection function then string-compare native (total-identity function) == 0
      else total-core-has-row native (total-core-members (total-core-field "definitions" (total-function-document function)))
    Err error -> False
  total-core-has-row :: String -> List Json -> Bool
  total-core-has-row native rows = case rows of
    Nil -> False
    Cons first rest -> string-compare native (total-core-text (total-core-field "identity" first)) == 0 || total-core-has-row native rest
