+  -- | Preserve the checked nominal result's exact application order before assigning any binder names.
+  result-actuals :: UType -> List UType -> Option (List UType)
+  result-actuals ty arguments = case ty of
+    UApp first last -> result-actuals first (Cons last arguments)
+    UCon name kind -> Some arguments
+    other -> None
+
+  -- | Find a quantified binder by its actual identity rather than its source spelling or position.
+  quantified-id :: Nat -> List Quant -> Option Quant
+  quantified-id id rows = case rows of Nil -> None; Cons first rest -> if id == quant-id first then Some first else quantified-id id rest
