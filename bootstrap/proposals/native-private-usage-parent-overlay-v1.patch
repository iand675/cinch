+
+  -- | Find only the defining identity of an already admitted constructor occurrence.
+  constructor-fields-for :: String -> List (String, List UType) -> Option (List UType)
+  constructor-fields-for name rows = case rows of
+    Nil -> None
+    Cons (identity, fields) rest -> if same name identity then Some fields else constructor-fields-for name rest
+
+  -- | Read ordinary actual constructor fields and verify the final owner with lexical binders preserved.
+  actual-constructor-fields :: String -> List Quant -> UType -> Option (List UType)
+  actual-constructor-fields owner params ty = case ty of
+    UFun field rest -> (case actual-constructor-fields owner params rest of Some fields -> Some (Cons field fields); None -> None)
+    UPi id name field (URow UEnd) rest -> (case actual-constructor-fields owner params rest of Some fields -> Some (Cons field fields); None -> None)
+    other -> if checked-result owner params (canonical-result-head ty) then Some Nil else None
+
+  -- | Normalize only a checked result's defining identity, leaving all arguments and roles unchanged.
+  canonical-result-head :: UType -> UType
+  canonical-result-head ty = case ty of
+    UApp first last -> UApp (canonical-result-head first) last
+    UCon name kind -> (case export-global name of Ok identity -> UCon (interface-global identity) kind; Err error -> ty)
+    other -> ty
+
+  -- | Compare closed first-order field types without inferring metas or trusting rendered spellings.
+  same-fields :: List UType -> List UType -> Bool
+  same-fields first second = case (first, second) of
+    (Nil, Nil) -> True
