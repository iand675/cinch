-- The diagnostic vocabulary every rung shares: a rung name, a span and a
-- message, rendered in the compiler's own shape (`line:col: message`).
-- Every rung reports through this type, so a failure reads the same
-- wherever in the ladder it happens. See bootstrap/README.md.
--
-- A report is a `List Diagnostic`; `List` comes from the implicit surface.

module Bootstrap.Report where

  import Text.Lex (Span, span-line, span-col, bytes-slice)
  import Data.String (utf8-valid-from)
  import Text.Scan (string-starts-with)
  import Text.Show (nat-to-string)
  import Bootstrap.Ast (span-join, span-here)

  -- A diagnostic carries its text, or the computation that produces it. The
  -- type checker pushes the pair of types it could not unify as a deferred
  -- message, because a trial unification that is rolled back throws its whole
  -- error list away: rendering a type as text and decoding its identities back
  -- for a message nothing reads was most of the cost of a failed trial.
  -- Rendering is unchanged: `diagnostic-message` runs the deferred text.
  data Diagnostic where
    MkDiagnostic :: String -> Span -> String -> Diagnostic
    MkDeferredDiagnostic :: String -> Span -> (Unit -> String) -> Diagnostic

  diagnostic-rung :: Diagnostic -> String
  diagnostic-rung d = case d of
    MkDiagnostic rung s msg -> rung
    MkDeferredDiagnostic rung s render -> rung

  diagnostic-span :: Diagnostic -> Span
  diagnostic-span d = case d of
    MkDiagnostic rung s msg -> s
    MkDeferredDiagnostic rung s render -> s

  diagnostic-message :: Diagnostic -> String
  diagnostic-message d = case d of
    MkDiagnostic rung s msg -> msg
    MkDeferredDiagnostic rung s render -> render ()

  -- `line:col`, the position a reader navigates to.
  render-position :: Span -> String
  render-position s =
    string-concat (nat-to-string (span-line s)) (string-concat ":" (nat-to-string (span-col s)))

  -- `rung:line:col: message`: the shape the compiler's own diagnostics use,
  -- with the rung name where the file name goes.
  render-diagnostic :: Diagnostic -> String
  render-diagnostic d =
    let rung = diagnostic-rung d in
    let pos = render-position (diagnostic-span d) in
    let message = diagnostic-message d in
    let rendered = (if string-starts-with "name is not in scope: " message then
      string-concat-all ["unknown name (", message, ")"] else message) in
    string-concat rung (string-concat ":" (string-concat pos (string-concat ": " rendered)))

  diagnostics-count :: List Diagnostic -> Nat
  diagnostics-count ds = case ds of
    Nil -> 0
    Cons d rest -> 1 + diagnostics-count rest

  -- One per line, newline-terminated, so a rung can write its report to a
  -- file or a stream without further formatting.
  render-diagnostics :: List Diagnostic -> String
  render-diagnostics ds = case ds of
    Nil -> empty-string
    Cons d rest -> string-concat (render-diagnostic d) (string-concat "\n" (render-diagnostics rest))

  -- Project bundles label their actual input files with column-one
  -- `-- source: <escaped path>` comments. These affect presentation only:
  -- no source name or proof authority is obtained from a label. Preserve
  -- the phase and bundled position, adding the original file and line.
  -- A newline and the label prefix are ASCII bytes. Scan forward once
  -- per lookup, decoding only the path between the prefix and the newline.
  origin-prefix :: Bytes -> Bytes -> Nat -> Nat -> Bool
  origin-prefix prefix source offset index =
    if index < bytes-len prefix then
      if offset < bytes-len source then
        if bytes-get prefix index == bytes-get source offset then origin-prefix prefix source (offset + 1) (index + 1) else False
      else False
    else True
  origin-line-end :: Bytes -> Nat -> Nat
  origin-line-end source offset =
    if offset < bytes-len source then
      if bytes-get source offset == 10 then offset else origin-line-end source (offset + 1)
    else offset
  origin-label :: Bytes -> Bytes -> Nat -> Nat -> Option String
  origin-label prefix source offset end =
    let start = offset + bytes-len prefix in
    if end <= bytes-len source then
      if start < end then
        if origin-prefix prefix source offset 0 then string-from-bytes (bytes-slice source start end) else None
      else None
    else None
  origin-at :: Nat -> Bytes -> Bytes -> Nat -> Nat -> String -> Nat -> Option (String, Nat)
  origin-at wanted-line prefix source offset line label start =
    if line == wanted-line then
      if string-length label > 0 && wanted-line > start then Some (label, wanted-line - start) else None
    else if offset >= bytes-len source then None
    else let end = origin-line-end source offset in
      case origin-label prefix source offset end of
        Some path -> origin-at wanted-line prefix source (end + 1) (line + 1) path line
        None -> origin-at wanted-line prefix source (end + 1) (line + 1) label start
  render-source-diagnostic :: Bytes -> Bytes -> Diagnostic -> String
  render-source-diagnostic prefix source diagnostic = case origin-at (span-line (diagnostic-span diagnostic)) prefix source 0 1 "" 0 of
    None -> render-diagnostic diagnostic
    Some (path, line) -> string-concat (render-diagnostic diagnostic)
      (string-concat " (in " (string-concat path (string-concat ":" (string-concat (nat-to-string line)
        (string-concat ":" (string-concat (nat-to-string (span-col (diagnostic-span diagnostic))) ")"))))))
  render-source-diagnostics-from :: Bytes -> Bytes -> List Diagnostic -> String
  render-source-diagnostics-from prefix source diagnostics = case diagnostics of
    Nil -> empty-string
    Cons first rest -> string-concat (render-source-diagnostic prefix source first)
      (string-concat "\n" (render-source-diagnostics-from prefix source rest))
  render-source-diagnostics :: Bytes -> List Diagnostic -> String
  render-source-diagnostics source diagnostics =
    if utf8-valid-from source 0 then render-source-diagnostics-from (string-to-bytes "-- source: ") source diagnostics
    else render-diagnostics diagnostics
