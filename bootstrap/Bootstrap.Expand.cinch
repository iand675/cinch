-- The syntax the macro expander moves: hygienic renaming of the binders a
-- template introduces, and the substitution that fills a template's
-- splices with the caller's syntax. Nothing here decides *whether* to
-- expand a call; `Bootstrap.Stage` owns that policy and calls in.
--
-- Hygiene (modules specification section 8): every binder a template
-- introduces is renamed to an internal spelling no source file can write.
-- The identifier scanner takes `#` as a symbol character and never an
-- identifier start, so `#helper$1` can neither be typed by a caller nor
-- collide with a caller's `helper`. The caller's spliced syntax keeps its
-- own bindings because a splice body is skipped by the rename and filled
-- afterwards.
module Bootstrap.Expand where
  import Bootstrap.Ast
  import Bootstrap.Parse (Ps, POk, PBad, Fix, parse-tree-term, parse-tree-value-fields)
  import Bootstrap.Report (Diagnostic, MkDiagnostic)
  import Text.Lex (Span, span-start, LToken, Token, lt-span, lt-token, TPunct, TVar, TCon, TOp, TInt, TFloat, TWord, TTickName, TTickType)
  import Text.Show (nat-to-string)
  import Data.String (empty-string, string-to-bytes)
  import Algebra.Semigroup

  export term-has-macro-call, decl-has-macro-call, clauses-have-macro-call
  export hygienic-term, closed-code-template
  export fill-splices, fill-splices-with, macro-name-argument, name-macro, value-macro, take-group
  export DeclarationProducer, QuotedDeclarations, ConstructDeclarations, declaration-spelling, declaration-macro, macro-parameters, template-of, syntax-template-of
  export expand-error

  same :: String -> String -> Bool
  same a b = string-compare a b == 0

  expand-error :: forall a. Span -> String -> Result (List Diagnostic) a
  expand-error site message = Err [MkDiagnostic "bootstrap.expand" site message]

  cat :: List String -> String
  cat parts = string-concat-all parts

  -- ------------------------------------------------------------ detection

  -- Does this term contain a macro invocation? A splice body is not
  -- descended into: a `$( ... )` inside a quotation belongs to the
  -- enclosing template (modules specification section 8), and the
  -- quotation is expanded when its own expansion runs.
  term-has-macro-call :: Expr -> Bool
  term-has-macro-call e = case e of
    EMacroCall s path tokens -> True
    ESyntaxCaptureUnder s key name body -> term-has-macro-call body
    ECon s name args -> term-has-macro-call args
    ERecord s name fields -> term-has-macro-call fields
    ERecordField s name value rest -> term-has-macro-call value || term-has-macro-call rest
    EProject s value name -> term-has-macro-call value
    ETuple s xs -> term-has-macro-call xs
    EList s xs -> term-has-macro-call xs
    ERange s xs -> term-has-macro-call xs
    EMap s xs -> term-has-macro-call xs
    ESupplied s f a -> term-has-macro-call f || term-has-macro-call a
    EApp s f a -> term-has-macro-call f || term-has-macro-call a
    EBin s op l r -> term-has-macro-call l || term-has-macro-call r
    ENeg s x -> term-has-macro-call x
    ELam s ps body -> term-has-macro-call body
    ELet s bs body -> term-has-macro-call bs || term-has-macro-call body
    ELetScope s body -> term-has-macro-call body
    ELocalGroup s bs body -> term-has-macro-call bs || term-has-macro-call body
    ELetRec s bs body -> term-has-macro-call bs || term-has-macro-call body
    ELocalStrict s p value rest -> term-has-macro-call value || term-has-macro-call rest
    ELocalSignature s name ty rest -> term-has-macro-call rest
    ELocalMemo s name value rest -> term-has-macro-call value || term-has-macro-call rest
    EIf s c t f -> term-has-macro-call c || term-has-macro-call t || term-has-macro-call f
    ECase s scrut alts -> term-has-macro-call scrut || term-has-macro-call alts
    EGuarded s guard body -> term-has-macro-call guard || term-has-macro-call body
    EAnn s x ty -> term-has-macro-call x
    EForall s vs body -> term-has-macro-call body
    EUsing s bounds body -> term-has-macro-call body
    EBind s name rhs -> term-has-macro-call rhs
    EDoLet s simple group -> term-has-macro-call group
    EDo s stmts -> term-has-macro-call stmts
    EHandle s body h -> term-has-macro-call body || term-has-macro-call h
    EHandler s label clauses -> term-has-macro-call clauses
    EHandlerClause s name pats continuation body rest -> term-has-macro-call body || term-has-macro-call rest
    EWith s bs body -> term-has-macro-call bs || term-has-macro-call body
    EArg s x rest -> term-has-macro-call x || term-has-macro-call rest
    EBinding s name rhs rest -> term-has-macro-call rhs || term-has-macro-call rest
    EAlt s p body rest -> term-has-macro-call body || term-has-macro-call rest
    EQuote s body -> term-has-macro-call body
    other -> False

  decl-has-macro-call :: Decl -> Bool
  decl-has-macro-call d = case d of
    DFun s name clauses -> clauses-have-macro-call clauses
    DConditional s clauses inner -> decl-has-macro-call inner
    DProof s inner -> decl-has-macro-call inner
    DCorec s inner -> decl-has-macro-call inner
    DDecl s x rest -> decl-has-macro-call x || decl-has-macro-call rest
    other -> False

  clauses-have-macro-call :: List (List Pat, Expr) -> Bool
  clauses-have-macro-call clauses = case clauses of
    Nil -> False
    Cons (patterns, body) rest -> term-has-macro-call body || clauses-have-macro-call rest

  -- ------------------------------------------------------- macro declarations

  definition-name-of :: Decl -> String
  definition-name-of declaration = case declaration of
    DFun s name clauses -> name
    DSig s name ty -> name
    other -> empty-string

  -- A `macro` declaration's parameter names, in clause order. The
  -- signature and the definition are separate marked declarations with the
  -- same name, so a caller passes the module's whole list and the
  -- definition behind the signature is what answers.
  macro-parameters :: String -> List Decl -> List String
  macro-parameters name declarations = case declarations of
    Nil -> Nil
    Cons first rest -> case first of
      DMacro s body -> if same (definition-name-of body) name then
        (case body of
          DFun at n clauses -> first-clause-parameters clauses
          other -> macro-parameters name rest)
        else macro-parameters name rest
      other -> macro-parameters name rest

  first-clause-parameters :: List (List Pat, Expr) -> List String
  first-clause-parameters clauses = case clauses of
    Nil -> Nil
    Cons (patterns, body) rest -> pattern-names-of patterns

  pattern-names-of :: List Pat -> List String
  pattern-names-of ps = case ps of
    Nil -> Nil
    Cons p rest -> pat-name-list p <> pattern-names-of rest

  pat-name-list :: Pat -> List String
  pat-name-list p = case p of
    PVar s name -> Cons name Nil
    PWild s -> Cons "#wild" Nil
    PAs s name inner -> Cons name (pat-name-list inner)
    other -> Cons "#pattern" Nil

  template-of :: String -> List Decl -> Option Expr
  template-of name declarations = syntax-template-of "" (\op -> False) name declarations

  syntax-template-of :: String -> (String -> Bool) -> String -> List Decl -> Option Expr
  syntax-template-of home available name declarations = macro-body home available name (macro-signature name declarations) declarations

  macro-signature :: String -> List Decl -> Option TypeExpr
  macro-signature name declarations = case declarations of
    Nil -> None
    Cons (DMacro site (DSig at declared ty)) rest -> if same declared name then Some ty else macro-signature name rest
    Cons other rest -> macro-signature name rest

  stage-parameters :: String -> TypeExpr -> List Pat -> Option (List (String, String))
  stage-parameters expected ty patterns = case (ty, patterns) of
    (TFun site (TName at domain) tail, Cons (PVar arg param) rest) | same domain "Syntax" || same domain "Name" -> (case stage-parameters expected tail rest of
      Some names -> if syntax-input param (map (\entry -> case entry of (name, sort) -> name) names) then None else Some (Cons (param, domain) names)
      None -> None)
    (TName at result, Nil) | same result expected -> Some Nil
    other -> None

  data DeclarationProducer where
    QuotedDeclarations :: Decl -> DeclarationProducer
    ConstructDeclarations :: Expr -> DeclarationProducer

  declaration-macro :: String -> List Decl -> Option (List (String, String), DeclarationProducer)
  declaration-macro name declarations = case macro-signature name declarations of
    Some ty -> declaration-template name ty declarations
    None -> None

  declaration-template :: String -> TypeExpr -> List Decl -> Option (List (String, String), DeclarationProducer)
  declaration-template name ty declarations = case declarations of
    Cons (DDeclarationMacro site declared patterns template) rest | same declared name -> (case stage-parameters "Declarations" ty patterns of
      Some params -> Some (params, QuotedDeclarations template)
      None -> None)
    Cons (DMacro site (DFun at declared [(patterns, rhs)])) rest | same name declared -> (case stage-parameters "Declarations" ty patterns of
      Some params -> Some (params, ConstructDeclarations rhs)
      None -> None)
    Cons other rest -> declaration-template name ty rest
    Nil -> None

  name-macro :: String -> List Decl -> Option (List (String, String), Expr)
  name-macro = value-macro "Name"

  value-macro :: String -> String -> List Decl -> Option (List (String, String), Expr)
  value-macro sort name declarations = case macro-signature name declarations of
    Some ty -> value-macro-body sort name ty declarations
    None -> None
  value-macro-body :: String -> String -> TypeExpr -> List Decl -> Option (List (String, String), Expr)
  value-macro-body sort name ty declarations = case declarations of
    Cons (DMacro site (DFun at declared [(patterns, rhs)])) rest | same name declared -> (case stage-parameters sort ty patterns of
      Some params -> Some (params, rhs)
      None -> None)
    Cons other rest -> value-macro-body sort name ty rest
    Nil -> None

  macro-body :: String -> (String -> Bool) -> String -> Option TypeExpr -> List Decl -> Option Expr
  macro-body home available name declared-type declarations = case declarations of
    Nil -> None
    Cons (DMacro site (DFun at defined [(patterns, rhs)])) rest -> if same defined name then
      let inputs = (case declared-type of Some ty -> syntax-inputs "Syntax" ty patterns; None -> Nil) in
      let names = (case declared-type of Some ty -> syntax-inputs "Name" ty patterns; None -> Nil) in
      (case (code-template home available names inputs rhs, declared-type) of
        (Some body, Some ty) -> (case fixed-code-carrier ty of
          Some carrier -> Some (EAnn (expr-span body) body carrier)
          None -> Some body)
        (result, other) -> result)
      else macro-body home available name declared-type rest
    Cons other rest -> macro-body home available name declared-type rest

  -- A monomorphic quotation carries its declared type into ordinary checking
  -- in the defining scope. Explicitly quantified macros are instantiated at
  -- their use, where their syntax operands supply the type information.
  fixed-code-carrier :: TypeExpr -> Option TypeExpr
  fixed-code-carrier ty = case ty of
    TFun at domain result -> fixed-code-carrier result
    TApp at (TName head name) (TArg slot carrier (TArgsEnd end)) | same name "Code" -> Some carrier
    other -> None

  syntax-inputs :: String -> TypeExpr -> List Pat -> List String
  syntax-inputs wanted ty patterns = case ty of
    TForall at binders body -> syntax-inputs wanted body patterns
    TFun at domain result -> (case patterns of
      Nil -> Nil
      Cons pattern rest -> let more = syntax-inputs wanted result rest in case (domain, pattern) of
        (TName s sort, PVar site param) | same sort wanted -> Cons param more
        other -> more)
    other -> Nil

  syntax-input :: String -> List String -> Bool
  syntax-input name inputs = case inputs of
    Nil -> False
    Cons first rest -> same name first || syntax-input name rest

  -- These stage operations construct scoped code directly. Their result is
  -- an ordinary term which the resolver and type checker visit at insertion.
  -- The key belongs to the allocating syntax node. The normal hygiene pass
  -- gives it a distinct lexical identity each time the template is used.
  data SyntaxHandle where
    SyntaxHandle :: String -> BindingSpelling -> SyntaxHandle
    SyntaxCode :: Expr -> SyntaxHandle
  find-syntax-local :: String -> List (String, SyntaxHandle) -> Option SyntaxHandle
  find-syntax-local name bindings = case bindings of
    Nil -> None
    Cons (local, binding-value) rest -> if same local name then Some binding-value else find-syntax-local name rest

  find-handle :: String -> List (String, SyntaxHandle) -> Option SyntaxHandle
  find-handle name bindings = case find-syntax-local name bindings of
    Some (SyntaxHandle key spelling) -> Some (SyntaxHandle key spelling)
    other -> None

  syntax-handle :: (String -> Bool) -> List String -> List (String, SyntaxHandle) -> Expr -> Option SyntaxHandle
  syntax-handle available names handles value = case value of
    EVar at local -> find-handle local handles
    EApp at (EVar site op) (EVar arg param) | same op "Syntax.newBinding" && available op && syntax-input param names ->
      Some (SyntaxHandle (cat ["#syntax-binding:", nat-to-string (span-start at)]) (ParameterSpelling param))
    EApp at (EVar site op) (EApp arg (EVar ref-site convert) (ELitSym lit name)) | same op "Syntax.newBinding" && available op && same convert "sym-to-name" && available convert ->
      Some (SyntaxHandle (cat ["#syntax-binding:", nat-to-string (span-start at)]) (LiteralSpelling name))
    other -> None

  code-template :: String -> (String -> Bool) -> List String -> List String -> Expr -> Option Expr
  code-template home available names inputs = scoped-template home available (\name -> False) names inputs Nil Nil

  -- Closed code is checked against its declared carrier when it is spliced.
  -- Keep references to other stage values until their defining scope is known.
  closed-code-template :: String -> (String -> Bool) -> (String -> Bool) -> Expr -> Option Expr
  closed-code-template home available stage-value term = case term of
    EQuote at body -> None
    other -> scoped-template home available stage-value Nil Nil Nil Nil term

  template-name :: (String -> Bool) -> List String -> Expr -> Option TemplateName
  template-name available inputs expr = case expr of
    EVar at param | syntax-input param inputs -> Some (NameInput param)
    EApp at (EVar s op) (ELitSym lit spelling) | same op "sym-to-name" && available op -> Some (NameText spelling)
    EApp at (EApp inner (EVar s op) (ELitStr lit prefix)) rest | same op "Name.prefix" && available op ->
      (case template-name available inputs rest of Some name -> Some (NameJoin (NameText prefix) name); None -> None)
    EApp at (EApp inner (EVar s op) a) b | same op "Name.append" && available op ->
      (case (template-name available inputs a, template-name available inputs b) of
        (Some first, Some second) -> Some (NameJoin first second)
        other -> None)
    other -> None

  scoped-template :: String -> (String -> Bool) -> (String -> Bool) -> List String -> List String -> List (String, SyntaxHandle) -> List String -> Expr -> Option Expr
  scoped-template home available stage-value names inputs handles introduced rhs =
    let code = scoped-template home available stage-value names inputs handles introduced in
    let handle-of = syntax-handle available names handles in case rhs of
      ELetScope at body -> code body
      ELet at (EBinding site local value (EBindingsEnd end)) body ->
        let within = \bound -> scoped-template home available stage-value (without-spelling local names) (without-spelling local inputs) (Cons (local, bound) handles) introduced body in
        (case handle-of value of
          Some binding-value -> within binding-value
          None -> (case code value of Some fragment -> within (SyntaxCode fragment); None -> None))
      EQuote at (ESplice site (EVar occurrence name)) | (case find-handle name handles of Some binding-value -> True; None -> False) ->
        Some (EUnmodeled site "SyntaxBinding cannot be spliced as Code")
      EQuote at body -> (case fill-splices-with (quotation-hole code handles) body Nil Nil of
        Ok filled -> Some filled
        Err errors -> None)
      EVar at name -> (case find-syntax-local name handles of
        Some (SyntaxCode fragment) -> Some fragment
        None -> if stage-value name then Some (ESplice at rhs) else None
        other -> None)
      EMacroCall at path tokens -> Some rhs
      EApp at (EVar sp op) requested | same op "Syntax.definition" && available op ->
        (case template-name available names requested of Some name -> Some (ESyntaxNamed at home name None); None -> None)
      EApp at (EApp inner (EVar sp op) requested) (EVar fs fields) | same op "Syntax.recordValue" && available op && syntax-input fields inputs ->
        (case template-name available names requested of Some name -> Some (ESyntaxNamed at home name (Some fields)); None -> None)
      EApp at (EVar sp op) (EVar arg param) | same op "Syntax.capture" && available op && syntax-input param inputs ->
        Some (ESplice at (EVar arg param))
      EApp at (EVar site op) arg | same op "Syntax.reference" && available op -> (case handle-of arg of
        Some (SyntaxHandle key name) -> Some (ESyntaxReference at key name)
        other -> None)
      EApp at (EApp inner (EVar sp op) binding-value) (EVar arg param) | same op "Syntax.captureUnder" && available op && syntax-input param inputs -> (case handle-of binding-value of
        Some (SyntaxHandle key name) -> Some (ESyntaxCaptureUnder at key name (EVar arg param))
        other -> None)
      EApp at (EApp inner (EVar sp op) binding-value) body | same op "Syntax.lambda" && available op -> (case handle-of binding-value of
        Some (SyntaxHandle key name) -> if syntax-input key introduced then Some (EUnmodeled at "a syntax binding was introduced twice in the same lexical scope") else
          (case scoped-template home available stage-value names inputs handles (Cons key introduced) body of
            Some result -> Some (ELam at [PVar at key] result)
            None -> None)
        other -> None)
      EApp at (EApp inner (EApp head (EVar sp op) binding-value) value) body | same op "Syntax.letIn" && available op -> (case handle-of binding-value of
        Some (SyntaxHandle key name) -> if syntax-input key introduced then Some (EUnmodeled at "a syntax binding was introduced twice in the same lexical scope") else
          (case (code value, scoped-template home available stage-value names inputs handles (Cons key introduced) body) of
            (Some bound, Some result) -> Some (ELet at (EBinding at key bound (EBindingsEnd at)) result)
            other -> None)
        other -> None)
      EApp at (EApp inner (EVar sp op) function) argument | same op "Syntax.apply" && available op ->
        (case (code function, code argument) of
          (Some head, Some value) -> Some (EApp at head value)
          other -> None)
      other -> None

  quotation-hole :: (Expr -> Option Expr) -> List (String, SyntaxHandle) -> Span -> Expr -> Result (List Diagnostic) (Option Expr)
  quotation-hole code handles site term = case term of
    EVar at name | (case find-handle name handles of Some binding -> True; None -> False) ->
      Ok (Some (EUnmodeled site "SyntaxBinding cannot be spliced as Code"))
    other -> (case code term of
      Some value -> Ok (Some value)
      None -> Ok (Some (ESplice site term)))

  -- ------------------------------------------------------------- hygiene

  -- The internal spelling a generated binder takes. `#` never starts an
  -- identifier, so no source file can write this name and no caller
  -- binding can collide with it.
  internal-name :: String -> Nat -> String
  internal-name base serial = cat ["#", base, "$", nat-to-string serial]

  lookup-rename :: String -> List (String, String) -> Option String
  lookup-rename name renames = case renames of
    Nil -> None
    Cons (spelling, renamed) rest -> if same spelling name then Some renamed else lookup-rename name rest

  -- Rename every binder this template introduces. `serial` threads the
  -- fresh counter so two binders of one spelling never share an internal
  -- name; `renames` maps the caller-visible spelling to the internal one
  -- inside the binder's scope.
  hygienic-term :: Expr -> Nat -> (Expr, Nat)
  hygienic-term e serial = hygiene e Nil serial

  hygienic-patterns :: List Pat -> List (String, String) -> Nat -> (List Pat, List (String, String), Nat)
  hygienic-patterns ps renames serial = case ps of
    Nil -> (Nil, renames, serial)
    Cons p rest -> case hygienic-pattern p renames serial of
      (renamed, inner, after) -> case hygienic-patterns rest inner after of
        (more, final, done) -> (Cons renamed more, final, done)

  hygienic-pattern :: Pat -> List (String, String) -> Nat -> (Pat, List (String, String), Nat)
  hygienic-pattern p renames serial = case p of
    PVar s name -> let internal = internal-name name serial in
      (PVar s internal, Cons (name, internal) renames, serial + 1)
    PWild s -> (p, renames, serial)
    PAs s name inner -> let internal = internal-name name serial in
      case hygienic-pattern inner (Cons (name, internal) renames) (serial + 1) of
        (renamed, more, after) -> (PAs s internal renamed, more, after)
    PCon s name args -> case hygienic-pattern args renames serial of
      (renamed, more, after) -> (PCon s name renamed, more, after)
    PRecord s name fields -> case hygienic-pattern fields renames serial of
      (renamed, more, after) -> (PRecord s name renamed, more, after)
    PRecordField s label value rest -> case hygienic-pattern value renames serial of
      (renamed-value, more, after) -> case hygienic-pattern rest more after of
        (renamed-rest, final, done) -> (PRecordField s label renamed-value renamed-rest, final, done)
    PTuple s args -> case hygienic-pattern args renames serial of
      (renamed, more, after) -> (PTuple s renamed, more, after)
    PList s args -> case hygienic-pattern args renames serial of
      (renamed, more, after) -> (PList s renamed, more, after)
    PAnn s inner ty -> case hygienic-pattern inner renames serial of
      (renamed, more, after) -> (PAnn s renamed ty, more, after)
    PArg s first rest -> case hygienic-pattern first renames serial of
      (renamed-first, more, after) -> case hygienic-pattern rest more after of
        (renamed-rest, final, done) -> (PArg s renamed-first renamed-rest, final, done)
    other -> (p, renames, serial)

  handle-identity :: String -> List (String, String) -> String
  handle-identity key renames = case lookup-rename key renames of Some internal -> internal; None -> key

  -- The rename walk. A splice body is skipped: it is the caller's syntax,
  -- not the template's, and it is filled after this walk.
  hygiene :: Expr -> List (String, String) -> Nat -> (Expr, Nat)
  hygiene e renames serial = case e of
    ESyntaxReference s key name -> (ESyntaxReference s (handle-identity key renames) name, serial)
    ESyntaxCaptureUnder s key name operand -> (ESyntaxCaptureUnder s (handle-identity key renames) name operand, serial)
    EVar s name -> case lookup-rename name renames of
      Some internal -> (EVar s internal, serial)
      None -> (e, serial)
    ECon s name args -> case hygiene args renames serial of
      (renamed, after) -> (ECon s name renamed, after)
    ERecord s name fields -> case hygiene fields renames serial of
      (renamed, after) -> (ERecord s name renamed, after)
    ERecordField s label value rest -> case hygiene value renames serial of
      (renamed-value, more) -> case hygiene rest renames more of
        (renamed-rest, after) -> (ERecordField s label renamed-value renamed-rest, after)
    EProject s value name -> case hygiene value renames serial of
      (renamed, after) -> (EProject s renamed name, after)
    ETuple s xs -> case hygiene xs renames serial of
      (renamed, after) -> (ETuple s renamed, after)
    EList s xs -> case hygiene xs renames serial of
      (renamed, after) -> (EList s renamed, after)
    ERange s xs -> case hygiene xs renames serial of
      (renamed, after) -> (ERange s renamed, after)
    EMap s xs -> case hygiene xs renames serial of
      (renamed, after) -> (EMap s renamed, after)
    ESupplied s f a -> case hygiene f renames serial of
      (renamed-f, more) -> case hygiene a renames more of
        (renamed-a, after) -> (ESupplied s renamed-f renamed-a, after)
    EApp s f a -> case hygiene f renames serial of
      (renamed-f, more) -> case hygiene a renames more of
        (renamed-a, after) -> (EApp s renamed-f renamed-a, after)
    EBin s op l r -> case hygiene l renames serial of
      (renamed-l, more) -> case hygiene r renames more of
        (renamed-r, after) -> (EBin s op renamed-l renamed-r, after)
    ENeg s x -> case hygiene x renames serial of
      (renamed, after) -> (ENeg s renamed, after)
    ELam s ps body -> case hygienic-patterns ps renames serial of
      (renamed-ps, inner, after-ps) -> case hygiene body inner after-ps of
        (renamed-body, after) -> (ELam s renamed-ps renamed-body, after)
    ELet s bs body -> case hygiene-bindings bs renames serial of
      (renamed-bs, inner, after-bs) -> case hygiene body inner after-bs of
        (renamed-body, after) -> (ELet s renamed-bs renamed-body, after)
    ELetScope s body -> case hygiene body renames serial of
      (renamed, after) -> (ELetScope s renamed, after)
    ELocalGroup s bs body -> case hygiene-bindings bs renames serial of
      (renamed-bs, inner, after-bs) -> case hygiene body inner after-bs of
        (renamed-body, after) -> (ELocalGroup s renamed-bs renamed-body, after)
    ELetRec s bs body -> case recursive-bindings bs renames serial of
      (renamed-bs, inner, after-bs) -> case hygiene body inner after-bs of
        (renamed-body, after) -> (ELetRec s renamed-bs renamed-body, after)
    ELocalStrict s p value rest -> case hygienic-pattern p renames serial of
      (renamed-p, inner, after-p) -> case hygiene value renames after-p of
        (renamed-value, more) -> case hygiene rest inner more of
          (renamed-rest, after) -> (ELocalStrict s renamed-p renamed-value renamed-rest, after)
    ELocalSignature s name ty rest -> case hygiene rest renames serial of
      (renamed, after) -> (ELocalSignature s name ty renamed, after)
    ELocalMemo s name value rest -> case hygiene value renames serial of
      (renamed-value, more) -> case hygiene rest renames more of
        (renamed-rest, after) -> (ELocalMemo s name renamed-value renamed-rest, after)
    EIf s c t f -> case hygiene c renames serial of
      (renamed-c, a) -> case hygiene t renames a of
        (renamed-t, b) -> case hygiene f renames b of
          (renamed-f, after) -> (EIf s renamed-c renamed-t renamed-f, after)
    ECase s scrut alts -> case hygiene scrut renames serial of
      (renamed-scrut, more) -> case hygiene-alts alts renames more of
        (renamed-alts, after) -> (ECase s renamed-scrut renamed-alts, after)
    EGuarded s guard body -> case hygiene guard renames serial of
      (renamed-guard, more) -> case hygiene body renames more of
        (renamed-body, after) -> (EGuarded s renamed-guard renamed-body, after)
    EAnn s x ty -> case hygiene x renames serial of
      (renamed, after) -> (EAnn s renamed ty, after)
    EForall s vs body -> case hygiene body renames serial of
      (renamed, after) -> (EForall s vs renamed, after)
    EUsing s bounds body -> case hygiene body renames serial of
      (renamed, after) -> (EUsing s bounds renamed, after)
    EBind s name rhs -> case hygiene rhs renames serial of
      (renamed, after) -> (EBind s name renamed, after)
    EDoLet s simple group -> case hygiene group renames serial of
      (renamed, after) -> (EDoLet s simple renamed, after)
    EDo s stmts -> case hygiene stmts renames serial of
      (renamed, after) -> (EDo s renamed, after)
    EHandle s body h -> case hygiene body renames serial of
      (renamed-body, more) -> case hygiene h renames more of
        (renamed-h, after) -> (EHandle s renamed-body renamed-h, after)
    EHandler s label clauses -> case hygiene clauses renames serial of
      (renamed, after) -> (EHandler s label renamed, after)
    EHandlerClause s name pats continuation body rest -> case hygiene body renames serial of
      (renamed-body, more) -> case hygiene rest renames more of
        (renamed-rest, after) -> (EHandlerClause s name pats continuation renamed-body renamed-rest, after)
    EWith s bs body -> case hygiene-bindings bs renames serial of
      (renamed-bs, inner, after-bs) -> case hygiene body inner after-bs of
        (renamed-body, after) -> (EWith s renamed-bs renamed-body, after)
    EArg s x rest -> case hygiene x renames serial of
      (renamed-x, more) -> case hygiene rest renames more of
        (renamed-rest, after) -> (EArg s renamed-x renamed-rest, after)
    EBinding s name rhs rest -> case hygiene rhs renames serial of
      (renamed-rhs, more) -> case hygiene rest renames more of
        (renamed-rest, after) -> (EBinding s name renamed-rhs renamed-rest, after)
    EAlt s p body rest -> case hygienic-pattern p renames serial of
      (renamed-p, inner, after-p) -> case hygiene body inner after-p of
        (renamed-body, more) -> case hygiene rest renames more of
          (renamed-rest, after) -> (EAlt s renamed-p renamed-body renamed-rest, after)
    EQuote s body -> case hygiene body renames serial of
      (renamed, after) -> (EQuote s renamed, after)
    other -> (e, serial)

  hygiene-bindings :: Expr -> List (String, String) -> Nat -> (Expr, List (String, String), Nat)
  hygiene-bindings bs renames serial = case bs of
    EBinding s name rhs rest -> let internal = internal-name name serial in
      case hygiene rhs renames (serial + 1) of
        (renamed-rhs, more) -> case hygiene-bindings rest (Cons (name, internal) renames) more of
          (renamed-rest, inner, after) -> (EBinding s internal renamed-rhs renamed-rest, inner, after)
    EBindingsEnd s -> (bs, renames, serial)
    other -> (bs, renames, serial)

  -- A recursive group prebinds every name, so a member sees its siblings
  -- under their internal spellings and the bodies are walked once the
  -- whole group's renames are known.
  recursive-bindings :: Expr -> List (String, String) -> Nat -> (Expr, List (String, String), Nat)
  recursive-bindings bs renames serial = case prebind bs renames serial of
    (group-renames, after-prebind) -> walk-recursive bs group-renames after-prebind

  prebind :: Expr -> List (String, String) -> Nat -> (List (String, String), Nat)
  prebind bs renames serial = case bs of
    EBinding s name rhs rest -> prebind rest (Cons (name, internal-name name serial) renames) (serial + 1)
    EBindingsEnd s -> (renames, serial)
    other -> (renames, serial)

  walk-recursive :: Expr -> List (String, String) -> Nat -> (Expr, List (String, String), Nat)
  walk-recursive bs group-renames serial = case bs of
    EBinding s name rhs rest -> case lookup-rename name group-renames of
      Some internal -> case hygiene rhs group-renames serial of
        (renamed-rhs, more) -> case walk-recursive rest group-renames more of
          (renamed-rest, inner, after) -> (EBinding s internal renamed-rhs renamed-rest, inner, after)
      None -> (bs, group-renames, serial)
    EBindingsEnd s -> (bs, group-renames, serial)
    other -> (bs, group-renames, serial)

  hygiene-alts :: Expr -> List (String, String) -> Nat -> (Expr, Nat)
  hygiene-alts alts renames serial = case alts of
    EAlt s p body rest -> case hygienic-pattern p renames serial of
      (renamed-p, inner, after-p) -> case hygiene body inner after-p of
        (renamed-body, more) -> case hygiene-alts rest renames more of
          (renamed-rest, after) -> (EAlt s renamed-p renamed-body renamed-rest, after)
    EAltsEnd s -> (alts, serial)
    other -> (alts, serial)

  -- One argument group as an ordinary expression in the caller's scope and
  -- fixities. The tree is macro input until here; this is where it becomes
  -- a term, and the tokens already carry the spans the caller wrote.
  parse-group-term :: List LToken -> List (String, Fix) -> Result (List Diagnostic) Expr
  parse-group-term tokens fix = case parse-tree-term tokens (string-to-bytes "") fix of
    POk e rest -> case rest of
      Nil -> Ok e
      Cons extra more -> expand-error (lt-span extra) (cat ["a macro argument is not one expression: trailing `", token-text (lt-token extra), "`"])
    PBad -> expand-error (group-span tokens) "a macro argument does not parse as an expression"

  group-span :: List LToken -> Span
  group-span tokens = case tokens of
    Cons first rest -> lt-span first
    Nil -> Span 0 0 1 1

  token-text :: Token -> String
  token-text tok = case tok of
    TVar s -> s
    TCon s -> s
    TOp s -> s
    TPunct s -> s
    TInt s -> s
    TFloat s -> s
    TWord s -> s
    other -> "token"

  -- ---------------------------------------------------------- substitution

  -- Fill the template's splices with the caller's syntax. A splice whose
  -- expression names one of the macro's parameters takes that parameter's
  -- group, parsed here and only here: a group the template never splices
  -- is never read as a term, so an ignored parameter costs nothing. Every
  -- other splice is left in place for the stage evaluator.
  fill-splices :: Expr -> List (String, List LToken) -> List (String, Fix) -> Result (List Diagnostic) Expr
  fill-splices e groups fix = fill-splices-with (\site expression -> Ok None) e groups fix

  macro-name-argument :: Span -> List LToken -> Result (List Diagnostic) String
  macro-name-argument site tokens = case tokens of
    [token] -> (case lt-token token of
      TVar name -> Ok name
      TCon name -> Ok name
      TOp name -> Ok name
      TTickName name -> Ok name
      TTickType name -> Ok name
      other -> expand-error site "a Name argument requires a single name")
    other -> expand-error site "a Name argument requires a single name"

  fill-name :: Span -> TemplateName -> List (String, List LToken) -> Result (List Diagnostic) String
  fill-name site name groups = case name of
    NameText literal -> Ok literal
    NameInput param -> (case take-group param groups of
      Some tokens -> macro-name-argument site tokens
      None -> expand-error site "missing Name argument for syntax construction")
    NameJoin first second -> (case (fill-name site first groups, fill-name site second groups) of
      (Ok a, Ok b) -> Ok (cat [a, b])
      (Err errors, other) -> Err errors
      (other, Err errors) -> Err errors)

  -- Labels belong to the constructor's schema. Only field values cross
  -- back into the caller's lexical, fixity and nested macro scope.
  caller-fields :: Expr -> Expr
  caller-fields fields = case fields of
    ERecordField at label value rest -> ERecordField at label (EArgumentScope at value) (caller-fields rest)
    other -> fields

  binding-spelling :: Span -> BindingSpelling -> List (String, List LToken) -> Result (List Diagnostic) BindingSpelling
  binding-spelling site origin groups = case origin of
    LiteralSpelling name -> Ok origin
    ParameterSpelling param -> (case take-group param groups of
      Some [token] -> (case lt-token token of TVar name -> Ok (LiteralSpelling name); other -> expand-error site "Syntax.newBinding requires a variable name")
      other -> expand-error site "Syntax.newBinding requires one Name argument")

  -- In a declaration name slot the argument must reify to one name.
  declaration-spelling :: Span -> Expr -> List (String, List LToken) -> List (String, Fix) -> Result (List Diagnostic) String
  declaration-spelling site expression groups fix = case expression of
    EVar at param -> (case take-group param groups of
      None -> expand-error site "a name splice has no value"
      Some tokens -> case parse-group-term tokens fix of
        Ok (ELitSym name-site name) -> Ok name
        Ok (EVar name-site name) -> Ok name
        Ok (ECon name-site name (EArgsEnd end)) -> Ok name
        other -> expand-error site "a name splice must name one declaration")
    ELitSym at name -> Ok name
    other -> expand-error site "a name splice must name one declaration"

  fill-splices-with :: (Span -> Expr -> Result (List Diagnostic) (Option Expr)) -> Expr -> List (String, List LToken) -> List (String, Fix) -> Result (List Diagnostic) Expr
  fill-splices-with reify e groups fix = case e of
    ESyntaxNamed site home name source -> (case (fill-name site name groups, source) of
      (Err errors, other) -> Err errors
      (Ok definition, None) -> Ok (EDefinitionName site home definition)
      (Ok constructor, Some param) -> (case take-group param groups of
        Some tokens -> (case parse-tree-value-fields tokens fix of
          POk fields Nil -> Ok (ERecord site constructor (caller-fields fields))
          other -> expand-error site "Syntax.recordValue requires a record field group")
        None -> expand-error site "missing Syntax argument for record fields"))
    ESyntaxReference s key param -> (case binding-spelling s param groups of
      Ok name -> Ok (ESyntaxReference s key name)
      Err errors -> Err errors)
    ESyntaxCaptureUnder s key param (EVar site operand) -> (case binding-spelling s param groups of
      Err errors -> Err errors
      Ok name -> case take-group operand groups of
        None -> expand-error site "Syntax.captureUnder requires a syntax argument"
        Some tokens -> case parse-group-term tokens fix of
          Ok term -> Ok (ESyntaxCaptureUnder s key name term)
          Err errors -> Err errors)
    ESplice s expression -> (case reify s expression of
      Err errors -> Err errors
      Ok (Some value) -> Ok value
      Ok None -> fill-syntax-splice s expression groups fix)
    ECon s name args -> fill-node reify (ECon s name) args groups fix
    ERecord s name fields -> fill-node reify (ERecord s name) fields groups fix
    EProject s value name -> case fill-splices-with reify value groups fix of
      Err errors -> Err errors
      Ok filled -> Ok (EProject s filled name)
    ETuple s xs -> fill-node reify (ETuple s) xs groups fix
    EList s xs -> fill-node reify (EList s) xs groups fix
    ERange s xs -> fill-node reify (ERange s) xs groups fix
    EMap s xs -> fill-node reify (EMap s) xs groups fix
    ENeg s x -> case fill-splices-with reify x groups fix of
      Err errors -> Err errors
      Ok filled -> Ok (ENeg s filled)
    ELam s ps body -> case fill-splices-with reify body groups fix of
      Err errors -> Err errors
      Ok filled -> Ok (ELam s ps filled)
    ELetScope s body -> case fill-splices-with reify body groups fix of
      Err errors -> Err errors
      Ok filled -> Ok (ELetScope s filled)
    ELocalSignature s name ty rest -> case fill-splices-with reify rest groups fix of
      Err errors -> Err errors
      Ok filled -> Ok (ELocalSignature s name ty filled)
    EAnn s x ty -> case fill-splices-with reify x groups fix of
      Err errors -> Err errors
      Ok filled -> Ok (EAnn s filled ty)
    EForall s vs body -> case fill-splices-with reify body groups fix of
      Err errors -> Err errors
      Ok filled -> Ok (EForall s vs filled)
    EUsing s bounds body -> case fill-splices-with reify body groups fix of
      Err errors -> Err errors
      Ok filled -> Ok (EUsing s bounds filled)
    EBind s name rhs -> case fill-splices-with reify rhs groups fix of
      Err errors -> Err errors
      Ok filled -> Ok (EBind s name filled)
    EDoLet s simple group -> case fill-splices-with reify group groups fix of
      Err problem -> Err problem
      Ok filled -> Ok (EDoLet s simple filled)
    EDo s stmts -> case fill-splices-with reify stmts groups fix of
      Err errors -> Err errors
      Ok filled -> Ok (EDo s filled)
    EHandler s label clauses -> case fill-splices-with reify clauses groups fix of
      Err errors -> Err errors
      Ok filled -> Ok (EHandler s label filled)
    EQuote s body -> case fill-splices-with reify body groups fix of
      Err errors -> Err errors
      Ok filled -> Ok (EQuote s filled)
    ESupplied s f a -> fill-two reify (\x y -> ESupplied s x y) f a groups fix
    EApp s f a -> fill-two reify (\x y -> EApp s x y) f a groups fix
    EBin s op l r -> fill-two reify (\x y -> EBin s op x y) l r groups fix
    ERecordField s label value rest -> fill-two reify (\x y -> ERecordField s label x y) value rest groups fix
    ELocalStrict s p value rest -> fill-two reify (\x y -> ELocalStrict s p x y) value rest groups fix
    ELocalMemo s name value rest -> fill-two reify (\x y -> ELocalMemo s name x y) value rest groups fix
    EGuarded s guard body -> fill-two reify (\x y -> EGuarded s x y) guard body groups fix
    EHandle s body h -> fill-two reify (\x y -> EHandle s x y) body h groups fix
    EHandlerClause s name pats continuation body rest -> fill-two reify (\x y -> EHandlerClause s name pats continuation x y) body rest groups fix
    EWith s bs body -> fill-two reify (\x y -> EWith s x y) bs body groups fix
    EArg s x rest -> fill-two reify (\x y -> EArg s x y) x rest groups fix
    EBinding s name rhs rest -> fill-two reify (\x y -> EBinding s name x y) rhs rest groups fix
    EAlt s p body rest -> fill-two reify (\x y -> EAlt s p x y) body rest groups fix
    EIf s c t f -> case fill-splices-with reify c groups fix of
      Err errors -> Err errors
      Ok filled-c -> case fill-splices-with reify t groups fix of
        Err errors -> Err errors
        Ok filled-t -> case fill-splices-with reify f groups fix of
          Err errors -> Err errors
          Ok filled-f -> Ok (EIf s filled-c filled-t filled-f)
    ECase s scrut alts -> fill-two reify (\x y -> ECase s x y) scrut alts groups fix
    ELocalGroup s bs body -> fill-two reify (\x y -> ELocalGroup s x y) bs body groups fix
    ELetRec s bs body -> fill-two reify (\x y -> ELetRec s x y) bs body groups fix
    ELet s bs body -> fill-two reify (\x y -> ELet s x y) bs body groups fix
    other -> Ok e

  fill-node :: (Span -> Expr -> Result (List Diagnostic) (Option Expr)) -> (Expr -> Expr) -> Expr -> List (String, List LToken) -> List (String, Fix) -> Result (List Diagnostic) Expr
  fill-node reify build spine groups fix = case fill-splices-with reify spine groups fix of
    Err errors -> Err errors
    Ok filled -> Ok (build filled)

  fill-two :: (Span -> Expr -> Result (List Diagnostic) (Option Expr)) -> (Expr -> Expr -> Expr) -> Expr -> Expr -> List (String, List LToken) -> List (String, Fix) -> Result (List Diagnostic) Expr
  fill-two reify build first second groups fix = case fill-splices-with reify first groups fix of
    Err errors -> Err errors
    Ok filled-first -> case fill-splices-with reify second groups fix of
      Err errors -> Err errors
      Ok filled-second -> Ok (build filled-first filled-second)

  fill-syntax-splice :: Span -> Expr -> List (String, List LToken) -> List (String, Fix) -> Result (List Diagnostic) Expr
  fill-syntax-splice s expression groups fix = case expression of
    EDefinitionName at home parameter -> (case take-group parameter groups of
      Some [token] -> (case lt-token token of
        TVar name -> Ok (EDefinitionName s home name)
        TCon name -> Ok (EDefinitionName s home name)
        other -> expand-error s "Syntax.definition requires a Name argument")
      other -> expand-error s "Syntax.definition requires a single name")
    EVar at name -> case take-group name groups of
      Some tokens -> case parse-group-term tokens fix of
        Err errors -> Err errors
        Ok term -> Ok (EArgumentScope s term)
      None -> Ok (ESplice s expression)
    other -> Ok (ESplice s expression)

  take-group :: String -> List (String, List LToken) -> Option (List LToken)
  take-group name groups = case groups of
    Nil -> None
    Cons (spelling, tokens) rest -> if same spelling name then Some tokens else take-group name rest
