-- Compile stage declarations in their local namespace, then check the
-- generated declarations as ordinary source. Scalar quotations transport
-- checked literals, with their original splice sites and carriers.
module Bootstrap.Stage where
  import Bootstrap.Ast
  import Bootstrap.Check (CheckedProgram, check-and-retain)
  import Bootstrap.Expand (decl-has-macro-call, clauses-have-macro-call, hygienic-term, closed-code-template, fill-splices as macro-fill-splices, fill-splices-with, macro-name-argument, name-macro, declaration-spelling, declaration-macro, macro-parameters, syntax-template-of, expand-error)
  import Bootstrap.Parse (Fix, macro-argument-groups, module-scope-fixes)
  import Bootstrap.Resolve (MacroNamespaces, macro-namespaces, lookup-macro, stage-operation-available)
  import Bootstrap.Report (Diagnostic, MkDiagnostic, diagnostic-span, diagnostic-rung, diagnostic-message, render-position)
  import Bootstrap.StageEval
  import Bootstrap.Nominal (stage-quotation-module, stage-code-type-name, global-stage-code)
  import Bootstrap.Type (Scheme, UType, UApp, UCon, scheme-body)
  import Algebra.Semigroup
  import Data.Int (int-neg)
  import Data.List (list-length)
  import Text.Lex (Span, span-start, span-end, LToken)
  import Text.Show (int-to-string, nat-to-string)

  export expand-stages, expand-stages-with, explain-expansion-errors

  -- The generated group leaves the surface during lexical resolution. Keep
  -- its template range and call site until ordinary checking has diagnosed
  -- the generated declarations. An ordinary source error keeps its origin.
  explain-expansion-errors :: Program -> List Diagnostic -> List Diagnostic
  explain-expansion-errors program errors = case expansion-sites (program-modules program) of
    Nil -> errors
    sites -> map (explain-expansion-error sites) errors
  expansion-sites :: List Module -> List (Span, Span, String)
  expansion-sites modules = case modules of
    Nil -> Nil
    Cons m rest -> module-expansions (module-decls m) (expansion-sites rest)
  module-expansions :: List Decl -> List (Span, Span, String) -> List (Span, Span, String)
  module-expansions ds sites = case ds of
    Nil -> sites
    Cons (DGeneratedGroup caller home name template) rest ->
      Cons (decl-span template, caller, home <> "." <> name) (module-expansions rest sites)
    Cons other rest -> module-expansions rest sites
  within-span :: Span -> Span -> Bool
  within-span location range = span-start location >= span-start range && span-start location < span-end range
  expansion-notes :: Span -> List (Span, Span, String) -> String
  expansion-notes location sites = case sites of
    Nil -> ""
    Cons (template, caller, name) rest -> let tail = expansion-notes location rest in
      if within-span location template || within-span location caller then
        " (in expansion of " <> name <> " at " <> render-position caller <> ")" <> tail
      else tail
  explain-expansion-error :: List (Span, Span, String) -> Diagnostic -> Diagnostic
  explain-expansion-error sites error = let at = diagnostic-span error in let notes = expansion-notes at sites in
    if same notes "" then error else MkDiagnostic (diagnostic-rung error) at (diagnostic-message error <> notes)

  stage-error :: forall a. Span -> String -> Result (List Diagnostic) a
  stage-error site message = Err [MkDiagnostic "bootstrap.stage" site message]

  same :: String -> String -> Bool
  same a b = string-compare a b == 0

  cat :: List String -> String
  cat parts = string-concat-all parts

  -- A module has staging work when it declares a compile-time construct or
  -- when its ordinary code calls a macro. The second half matters for a
  -- module that only *uses* a macro: it declares no `macro`, but its calls
  -- still have to be expanded before the ordinary check.
  data MacroCallers where
    RootCall :: MacroCallers
    CallerSite :: String -> List (String, Fix) -> MacroCallers -> MacroCallers
  data MacroSite where
    MkMacroSite :: String -> List (String, Fix) -> List Module -> MacroNamespaces -> MacroCallers -> MacroSite

  stage-work :: List Decl -> Bool
  stage-work declarations = case declarations of
    Nil -> False
    Cons first rest -> case first of
      DMacro site body -> True
      DDeclarationMacro site name patterns template -> True
      DStage site body -> True
      DGenerate site body -> True
      other -> decl-has-macro-call other || stage-work rest

  -- Quotation macros substitute syntax directly. Only stage values and
  -- generators need an independently resolved and checked evaluator program.
  needs-stage-check :: List Decl -> Bool
  needs-stage-check declarations = case declarations of
    Nil -> False
    Cons (DStage site body) rest -> True
    Cons (DGenerate site actions) rest -> True
    Cons other rest -> needs-stage-check rest

  probe-name :: Span -> String
  probe-name site = string-concat "#stage-probe-" (nat-to-string (span-start site))

  probe :: Span -> TypeExpr -> Expr -> List Decl
  probe site ty body = let name = probe-name site in
    [DSig site name ty, DFun site name [(Nil, body)]]

  -- One identity, spelled `#StageCode` here and `Code` in ordinary source
  -- (Bootstrap.Nominal owns the spelling and the encoded global).
  quote-type-name :: String
  quote-type-name = stage-code-type-name

  quote-type :: Span -> String -> String -> TypeExpr
  quote-type site name carrier = TApp site (TName site name) (type-arg-spine site [TName site carrier])

  -- These are ordinary checked functions in a private compile-time module.
  -- A same-spelled source binding still resolves according to normal scope.
  quote-function :: Span -> String -> String -> List Decl
  quote-function site name carrier =
    [DSig site name (TFun site (TName site carrier) (quote-type site quote-type-name carrier)),
     DFun site name [([PVar site "value"], ECon site stage-quotation-constructor (expr-spine site [EVar site "value"]))]]

  quotation-declarations :: Span -> List Decl
  quotation-declarations site =
    [DExport site "" [ExportName site [quote-type-name], ExportName site ["quoteNat"], ExportName site ["quoteInt"], ExportName site ["quoteBool"]],
     DData site quote-type-name [MkTypeParam site "a" None False]
      [(stage-quotation-constructor, TFun site (TName site "a") (quote-type site quote-type-name "a"))]]
    <> quote-function site "quoteNat" "Nat"
    <> quote-function site "quoteInt" "Int"
    <> quote-function site "quoteBool" "Bool"

  quotation-scope :: Span -> Module
  quotation-scope site = MkModule site stage-quotation-module (decl-spine site (quotation-declarations site))

  -- The carrier a splice site expects, read off the spliced expression: the
  -- `t` of a `Code t`, whether the splice names a stage function returning
  -- one or a quotation built here.
  quotation :: Span -> Expr -> Result (List Diagnostic) String
  quotation site expression = case expression of
    EApp at (EVar fn name) argument ->
      if same name "quoteNat" then Ok "Nat"
      else if same name "quoteInt" then Ok "Int"
      else if same name "quoteBool" then Ok "Bool"
      else stage-error site "this splice requires a checked scalar quotation"
    other -> stage-error site "this splice requires a checked scalar quotation"

  -- The carrier a stage declaration's checked type produces: the `t` of its
  -- `Code t`. The probe's scheme is the declaration's, so this reads the
  -- type the elaborator assigned rather than guessing from syntax.
  scheme-code-carrier :: Scheme -> Option UType
  scheme-code-carrier sc = case scheme-body sc of
    UApp (UCon name _) carrier -> if same name global-stage-code then Some carrier else None
    other -> None

  -- A probe names one splice's expression so the evaluator can run it at
  -- that span. A splice whose expression is a checked scalar reification gets
  -- one here. Anything else gets none: the surface supplies a quotation's
  -- template, and a splice that is neither is refused at expansion, where the
  -- checked program is in hand. Refusing here would be premature, because
  -- probing runs before the program is checked.
  template-clause-probes :: List (List Pat, Expr) -> Result (List Diagnostic) (List Decl)
  template-clause-probes clauses = case clauses of
    Nil -> Ok Nil
    Cons (patterns, body) rest -> case template-clause-probes rest of
      Err errors -> Err errors
      Ok tail -> (case stage-splice-probes body tail of
        Ok (checked, probes) -> Ok probes
        Err errors -> Err errors)

  stage-splice-probes :: Expr -> List Decl -> Result (List Diagnostic) (Expr, List Decl)
  stage-splice-probes term probes = case term of
    ESplice site expression -> (case quotation site expression of
      Ok carrier -> walk-children stage-splice-probes term (probe site (quote-type site (string-concat-all [stage-quotation-module, ".", quote-type-name]) carrier) expression <> probes)
      Err errors -> walk-children stage-splice-probes term probes)
    other -> walk-children stage-splice-probes term probes

  template-probes :: List Decl -> Result (List Diagnostic) (List Decl)
  template-probes declarations = case declarations of
    Nil -> Ok Nil
    Cons first rest -> case template-probes rest of
      Err errors -> Err errors
      Ok more -> case first of
        DFun site name clauses -> case template-clause-probes clauses of
          Err errors -> Err errors
          Ok found -> Ok (found <> more)
        other -> Ok more

  action-probes :: Decl -> Result (List Diagnostic) (List Decl)
  action-probes action = case action of
    DStageEmitValue site value -> Ok Nil
    DEmitMacro site path tokens -> Ok Nil
    DStageEmit site template -> template-probes (decls-of template)
    DStageBranch site condition yes no -> case (action-probes yes, action-probes no) of
      (Ok first, Ok second) -> Ok (probe site (TName site "Bool") condition <> first <> second)
      (Err errors, other) -> Err errors
      (other, Err errors) -> Err errors
    other -> stage-error (decl-span action) "invalid compile-time generator action"

  generator-probes :: List Decl -> Result (List Diagnostic) (List Decl)
  generator-probes declarations = case declarations of
    Nil -> Ok Nil
    Cons first rest -> case (action-probes first, generator-probes rest) of
      (Ok local, Ok more) -> Ok (local <> more)
      (Err errors, other) -> Err errors
      (other, Err errors) -> Err errors

  runtime-value-names :: List Decl -> List String
  runtime-value-names declarations = case declarations of
    Nil -> Nil
    Cons first rest -> case first of
      DSig site name ty -> Cons name (runtime-value-names rest)
      DFun site name body -> Cons name (runtime-value-names rest)
      other -> runtime-value-names rest

  runtime-value-name :: String -> List String -> Bool
  runtime-value-name name names = case names of
    Nil -> False
    Cons first rest -> same name first || runtime-value-name name rest

  stage-exports :: List String -> List ExportItem -> List ExportItem
  stage-exports runtime items = case items of
    Nil -> Nil
    Cons first rest -> let tail = stage-exports runtime rest in case first of
      ExportName site (Cons name Nil) -> if runtime-value-name name runtime then tail else Cons first tail
      other -> Cons first tail

  -- A stage declaration whose body is a quotation has no stage computation in
  -- it: the template is checked where the code lands (modules specification
  -- section 7), so the stage namespace keeps only its signature. Resolving
  -- the template here would refuse a name the template is entitled to, such
  -- as a runtime global it mentions, and it is not stage code to begin with.
  quotation-bodied :: Decl -> Bool
  quotation-bodied declaration = case declaration of
    DDeclarationMacro site name params template -> True
    DFun site name clauses -> case clauses of
      Cons (patterns, EQuote at body) Nil -> True
      other -> False
    other -> False

  -- Whether `name` is a quotation-bodied stage declaration in `all`. A
  -- signature and its definition are separate marked declarations, so the
  -- signature is recognised by the definition's name rather than its own
  -- shape.
  quotation-signature-of :: String -> List Decl -> Bool
  quotation-signature-of name all = case all of
    Nil -> False
    Cons first rest -> case first of
      DStage site body -> (quotation-bodied body && same (definition-name body) name) || quotation-signature-of name rest
      other -> quotation-signature-of name rest

  -- The name a marked declaration defines, whether it is the definition
  -- itself or its signature: both are `DStage`-wrapped, and both carry the
  -- same bare name before resolution.
  definition-name :: Decl -> String
  definition-name declaration = case declaration of
    DDeclarationMacro site name params template -> name
    DStage site (DFun at name clauses) -> name
    DStage site (DSig at name ty) -> name
    DFun site name clauses -> name
    DSig site name ty -> name
    other -> empty-string

  -- `all` is the module's whole declaration list, so a signature can see
  -- whether a quotation-bodied definition of the same name exists. A stage
  -- declaration and its signature are separate marked declarations, and both
  -- have to leave the stage namespace together: the template is checked where
  -- the code lands, so neither the body nor the signature is stage code.
  stage-declarations :: Bool -> List String -> List Decl -> List Decl -> Result (List Diagnostic) (List Decl)
  stage-declarations owner runtime all declarations = case declarations of
    Nil -> Ok Nil
    Cons first rest -> case stage-declarations owner runtime all rest of
      Err errors -> Err errors
      Ok tail -> case first of
        -- A macro declaration is compile-time only: it names no runtime
        -- value in any module, so the runtime program keeps no trace of it.
        DDeclarationMacro site name patterns template -> Ok (Cons (DMacroBinding site name) tail)
        DMacro site (DFun at name clauses) -> Ok (Cons (DMacroBinding site name) tail)
        DMacro site (DSig at name scheme) -> Ok (Cons (DMacroBinding site name) tail)
        DMacro site body -> stage-error site "a macro requires a signature or equation"
        DStage site (DDeclarationMacro at name params template) -> if owner then (case template-probes (decls-of template) of
          Ok probes -> Ok (Cons (DMacroBinding site name) (probes <> tail))
          Err errors -> Err errors) else Ok (Cons (DMacroBinding site name) tail)
        DStage site body -> if quotation-bodied body then Ok (Cons (DMacroBinding site (definition-name body)) tail)
          else if not owner then Ok tail
          else if quotation-signature-of (definition-name body) all then Ok tail
          else Ok (Cons body tail)
        DGenerate site actions -> if owner then (case generator-probes (decls-of actions) of
          Err errors -> Err errors
          Ok probes -> Ok (probes <> tail)) else Ok tail
        DSig site name ty -> Ok tail
        DFun site name body -> Ok tail
        DExport site text items -> if owner then Ok tail else Ok (Cons (DExport site text (stage-exports runtime items)) tail)
        other -> Ok (Cons first tail)

  stage-modules :: String -> List Module -> Result (List Diagnostic) (List Module)
  stage-modules owner modules = case modules of
    Nil -> Ok Nil
    Cons first rest -> let name = module-name first in let body = module-decls first in
      case (stage-declarations (same owner name) (runtime-value-names body) body body, stage-modules owner rest) of
        (Ok declarations, Ok tail) -> let site = module-span first in
          let visible = if same owner name then Cons (DImport site stage-quotation-module Nil None Nil Nil Nil) declarations else declarations in
          Ok (Cons (MkModule site name (decl-spine site visible)) tail)
        (Err errors, other) -> Err errors
        (other, Err errors) -> Err errors

  evaluate-probe :: CheckedProgram -> String -> Span -> Nat -> Result (List Diagnostic) (StageValue, Nat)
  evaluate-probe checked owner site fuel = evaluate-stage checked site (string-concat-all [owner, ".", probe-name site]) fuel

  literal :: Span -> String -> StageValue -> Result (List Diagnostic) Expr
  literal site carrier value = case value of
    StageInteger number -> if (same carrier "Nat" && number >= 0) || same carrier "Int" then
      let body = if number < 0 then ENeg site (ELitInt site (int-to-string (int-neg number))) else ELitInt site (int-to-string number) in
      Ok (EAnn site body (TName site carrier))
      else stage-error site "checked scalar quotation did not produce its declared carrier"
    StageBoolean boolean -> if same carrier "Bool" then Ok (ECon site (if boolean then "True" else "False") (EArgsEnd site))
      else stage-error site "checked scalar quotation did not produce its declared carrier"
    other -> stage-error site "checked scalar quotation did not produce its declared carrier"

  -- Resolve the spelling through the caller's imports and exports. The
  -- quotation's free names and carrier belong to its defining module.
  data CodeTemplate where
    CodeTemplate :: String -> List Pat -> TypeExpr -> Expr -> CodeTemplate

  surface-template :: MacroSite -> String -> Option CodeTemplate
  surface-template scope spelling = case scope of
    MkMacroSite owner fix modules names parent -> (case lookup-macro names owner spelling of
      Some (home, name) -> (case macro-module home modules of
        Some definition -> let declarations = module-decls definition in
          (case (template-equation name declarations, stage-signature name declarations) of
            (Some (parameters, body), Some ty) -> Some (CodeTemplate home parameters ty body)
            other -> None)
        None -> None)
      None -> None)

  template-equation :: String -> List Decl -> Option (List Pat, Expr)
  template-equation name declarations = case declarations of
    Cons (DStage site (DFun at declared [(parameters, EQuote span body)])) rest | same declared name -> Some (parameters, body)
    Cons other rest -> template-equation name rest
    Nil -> None

  stage-signature :: String -> List Decl -> Option TypeExpr
  stage-signature name declarations = case declarations of
    Cons (DStage site (DSig at declared ty)) rest | same declared name -> Some ty
    Cons other rest -> stage-signature name rest
    Nil -> None

  code-carrier :: TypeExpr -> Option TypeExpr
  code-carrier ty = case ty of
    TForall site parameters body -> (case code-carrier body of
      Some carrier -> Some (TForall site parameters carrier)
      None -> None)
    TApp site (TName at name) (TArg arg carrier (TArgsEnd end)) | same name "Code" -> Some carrier
    other -> None

  data ExpandScope where
    MkExpandScope :: MacroSite -> List Decl -> ExpandScope

  scope-site :: ExpandScope -> MacroSite
  scope-site scope = case scope of MkExpandScope site template -> site

  defining-scope :: String -> ExpandScope -> ExpandScope
  defining-scope home scope = case scope-site scope of
    MkMacroSite owner fix modules names parent ->
      MkExpandScope (MkMacroSite home (module-scope-fixes home modules Nil) modules names (CallerSite owner fix parent)) Nil

  scope-template :: ExpandScope -> List Decl
  scope-template scope = case scope of MkExpandScope site template -> template

  scope-with-template :: List Decl -> ExpandScope -> ExpandScope
  scope-with-template declarations scope = MkExpandScope (scope-site scope) declarations

  expand-clause :: CheckedProgram -> String -> ExpandScope -> Expr -> Nat -> Result (List Diagnostic) (Expr, Nat)
  expand-clause checked owner scope body fuel = case body of
    ESplice site expression -> expand-code checked owner scope site expression fuel
    other -> walk-children (expand-clause checked owner scope) body fuel

  expand-code :: CheckedProgram -> String -> ExpandScope -> Span -> Expr -> Nat -> Result (List Diagnostic) (Expr, Nat)
  expand-code checked owner scope site expression fuel = code-application checked owner scope site expression expression Nil fuel

  code-application :: CheckedProgram -> String -> ExpandScope -> Span -> Expr -> Expr -> List Expr -> Nat -> Result (List Diagnostic) (Expr, Nat)
  code-application checked owner scope site original expression args fuel = if fuel == 0 || fuel > macro-budget then stage-error site "compile-time quotation exhausted its work budget" else case expression of
    EApp at function argument -> code-application checked owner scope site original function (Cons argument args) (fuel - 1)
    EQuote at body -> (case args of Nil -> expand-clause checked owner scope body (fuel - 1); other -> stage-error site "a quotation does not take arguments")
    EVar at name -> (case surface-template (scope-site scope) name of
      Some (CodeTemplate home parameters ty body) -> (case hygienic-term body (macro-budget - fuel) of
        (renamed, serial) -> if serial + 1 > macro-budget then stage-error site "compile-time quotation exhausted its work budget" else
          (case apply-code-template checked owner scope home site parameters ty args Nil renamed (macro-budget - (serial + 1)) of
            Ok (result, remaining) -> Ok (ETemplateScope site home result, remaining)
            Err errors -> Err errors))
      None -> splice-value checked owner site original (fuel - 1))
    other -> splice-value checked owner site original (fuel - 1)

  -- A Code operand is a suspended runtime expression. The checked thunk
  -- preserves its caller's bindings, validates even unused operands and
  -- executes only at the splice sites that the quotation actually reaches.
  apply-code-template :: CheckedProgram -> String -> ExpandScope -> String -> Span -> List Pat -> TypeExpr -> List Expr -> List (String, String) -> Expr -> Nat -> Result (List Diagnostic) (Expr, Nat)
  apply-code-template checked owner scope home site parameters ty arguments names body fuel = case (parameters, arguments, ty) of
    (Nil, Nil, result) -> (case code-carrier result of
      Some carrier -> (case template-holes checked home (defining-scope home scope) names body fuel of
        Ok (expanded, remaining) -> Ok (EAnn site expanded carrier, remaining)
        Err errors -> Err errors)
      None -> stage-error site "a quoted stage definition must return Code")
    (Cons (PVar at name) rest, Cons argument more, TFun arrow domain result) -> (case code-carrier domain of
      Some carrier -> (case expand-code checked owner scope (expr-span argument) argument fuel of
        Ok (value, next) -> let key = cat ["#stage-operand-", nat-to-string (span-start site), "-", nat-to-string (list-length rest)] in
          (case apply-code-template checked owner scope home site rest result more (Cons (name, key) names) body next of
            Ok (expanded, remaining) -> let thunk = ELam site [PAnn site (PWild site) (TName site "Unit")] (EAnn site (EArgumentScope site value) carrier) in
              Ok (ELet site (EBinding site key thunk (EBindingsEnd site)) expanded, remaining)
            Err errors -> Err errors)
        Err errors -> Err errors)
      None -> stage-error site "a quotation parameter must have a Code carrier")
    other -> stage-error site "quotation arguments disagree with the stage definition"

  template-holes :: CheckedProgram -> String -> ExpandScope -> List (String, String) -> Expr -> Nat -> Result (List Diagnostic) (Expr, Nat)
  template-holes checked home scope names term fuel = case term of
    ESplice site (EVar at name) -> (case code-operand name names of
      Some key -> Ok (EApp site (EVar site key) (EUnit site), fuel)
      None -> expand-code checked home scope site (EVar at name) fuel)
    ESplice site expression -> expand-code checked home scope site expression fuel
    EMacroCall site path tokens -> expand-call (scope-site scope) site path tokens fuel
    other -> walk-children (template-holes checked home scope names) term fuel

  code-operand :: String -> List (String, String) -> Option String
  code-operand name names = case names of
    Cons (parameter, key) rest -> if same name parameter then Some key else code-operand name rest
    Nil -> None

  -- A splice whose expression is a stage computation: evaluate it and reify
  -- the code it produced.
  splice-value :: CheckedProgram -> String -> Span -> Expr -> Nat -> Result (List Diagnostic) (Expr, Nat)
  splice-value checked owner site expression fuel = case quotation site expression of
    Err errors -> Err errors
    Ok carrier -> case evaluate-probe checked owner site fuel of
      Err errors -> Err errors
      Ok (StageQuoted value, remaining) -> case literal site carrier value of
        Err errors -> Err errors
        Ok term -> Ok (term, remaining)
      Ok (StageCode template, remaining) -> Ok (template-body template, remaining)
      Ok other -> stage-error site "splice did not produce checked code"

  expand-clauses :: CheckedProgram -> String -> ExpandScope -> List (List Pat, Expr) -> Nat -> Result (List Diagnostic) (List (List Pat, Expr), Nat)
  expand-clauses checked owner scope clauses fuel = case clauses of
    Nil -> Ok (Nil, fuel)
    Cons (patterns, body) rest -> case expand-clause checked owner scope body fuel of
      Err errors -> Err errors
      Ok (term, remaining) -> case expand-clauses checked owner scope rest remaining of
        Err errors -> Err errors
        Ok (more, done) -> Ok (Cons (patterns, term) more, done)

  expand-template-declaration :: CheckedProgram -> String -> ExpandScope -> Decl -> Nat -> Result (List Diagnostic) (Decl, Nat)
  expand-template-declaration checked owner scope declaration fuel = case declaration of
    DFun site name body -> case expand-clauses checked owner scope body fuel of
      Err errors -> Err errors
      Ok (value, remaining) -> Ok (DFun site name value, remaining)
    other -> Ok (declaration, fuel)

  expand-template :: CheckedProgram -> String -> ExpandScope -> Nat -> Result (List Diagnostic) (List Decl, Nat)
  expand-template checked owner scope fuel = case scope-template scope of
    Nil -> Ok (Nil, fuel)
    Cons first rest -> case expand-template-declaration checked owner scope first fuel of
      Err errors -> Err errors
      Ok (value, remaining) -> case expand-template checked owner (scope-with-template rest scope) remaining of
        Err errors -> Err errors
        Ok (more, done) -> Ok (Cons value more, done)

  stored-declarations :: String -> List Decl -> Option Decl
  stored-declarations name declarations = case declarations of
    Cons (DStage at (DDeclarationMacro site declared Nil template)) rest | same declared name -> Some template
    Cons other rest -> stored-declarations name rest
    Nil -> None

  emit-stage-value :: CheckedProgram -> ExpandScope -> Span -> Expr -> Nat -> Result (List Diagnostic) (List Decl, Nat)
  emit-stage-value checked scope site value fuel = case (scope-site scope, value) of
    (MkMacroSite owner fix modules names parent, EVar at spelling) -> (case lookup-macro names owner spelling of
      Some (home, name) -> (case macro-module home modules of
        Some definition -> let declarations = module-decls definition in (case (stored-declarations name declarations, stage-signature name declarations) of
          (Some template, Some (TName at carrier)) | same carrier "Declarations" ->
            let destination = defining-scope home scope in (case expand-template checked home (scope-with-template (decls-of template) destination) fuel of
              Err errors -> Err errors
              Ok (expanded, remaining) -> (case fill-declarations (scope-site destination) fix (MacroOperands Nil Nil) expanded remaining of
                Err errors -> Err errors
                Ok (filled, done) -> Ok ([DGeneratedGroup site home name (decl-spine (decl-span template) filled)], done)))
          other -> stage-error site "emit requires a stage value of type Declarations")
        None -> stage-error site "stage declaration module is unavailable")
      None -> stage-error site "stage declaration value is not in scope")
    other -> stage-error site "emit requires a stage value of type Declarations"

  expand-action :: MacroSite -> CheckedProgram -> String -> ExpandScope -> Decl -> Nat -> Result (List Diagnostic) (List Decl, Nat)
  expand-action context checked owner scope action fuel = case action of
    DStageEmitValue site value -> emit-stage-value checked scope site value fuel
    DEmitMacro site path tokens -> expand-declaration-call context site path tokens fuel
    DStageEmit site template -> expand-template checked owner (scope-with-template (decls-of template) scope) fuel
    DStageBranch site condition yes no -> case evaluate-probe checked owner site fuel of
      Err errors -> Err errors
      Ok (StageBoolean selected, remaining) -> expand-action context checked owner scope (if selected then yes else no) remaining
      Ok other -> stage-error site "checked generator branch did not produce Bool"
    other -> stage-error (decl-span action) "invalid compile-time generator action"

  expand-actions :: MacroSite -> CheckedProgram -> String -> ExpandScope -> List Decl -> Nat -> Result (List Diagnostic) (List Decl, Nat)
  expand-actions context checked owner scope actions fuel = case actions of
    Nil -> Ok (Nil, fuel)
    Cons first rest -> case expand-action context checked owner scope first fuel of
      Err errors -> Err errors
      Ok (generated, remaining) -> case expand-actions context checked owner scope rest remaining of
        Err errors -> Err errors
        Ok (more, done) -> Ok (generated <> more, done)

  macro-module :: String -> List Module -> Option Module
  macro-module home modules = case modules of
    Nil -> None
    Cons m rest -> if same (module-name m) home then Some m else macro-module home rest

  -- A macro declaration is compile-time only: it names no runtime value in
  -- any module, so the runtime program keeps no trace of it. It is not
  -- dropped without work, though: its calls elsewhere in the module are
  -- expanded by `expand-term`, which reads the declaration's parameters and
  -- template from `module-decls`.
  --
  -- A quotation-bodied stage declaration leaves no runtime trace: its
  -- signature would name a value that never exists, so the signature goes with
  -- it. The template is read from the checked surface at each splice that
  -- names it, which is why nothing has to survive here.
  expand-declaration :: Option CheckedProgram -> MacroSite -> String -> List Decl -> Decl -> Nat -> Result (List Diagnostic) (List Decl, Nat)
  expand-declaration evaluator site-context owner module-decls declaration fuel = case declaration of
    DDeclarationMacro site name patterns template -> Ok ([DMacroBinding site name], fuel)
    DMacro site (DFun at name clauses) -> Ok ([DMacroBinding site name], fuel)
    DMacro site (DSig at name scheme) -> Ok ([DMacroBinding site name], fuel)
    DMacro site body -> stage-error site "a macro requires a signature or equation"
    DStage site body -> Ok (if quotation-bodied body then [DMacroBinding site (definition-name body)] else Nil, fuel)
    DGenerate site actions -> (case evaluator of
      Some checked -> expand-actions site-context checked owner (MkExpandScope site-context Nil) (decls-of actions) fuel
      None -> stage-error site "generator requires a checked stage program")
    DSig site name ty -> if quotation-signature-of name module-decls then Ok (Nil, fuel) else Ok ([declaration], fuel)
    DFun site name clauses -> if clauses-have-macro-call clauses then
      (case macro-expand-clauses site-context clauses fuel of
        Err errors -> Err errors
        Ok (expanded, remaining) -> Ok ([DFun site name expanded], remaining))
      else Ok ([declaration], fuel)
    DConditional site clauses inner -> case expand-declaration evaluator site-context owner module-decls inner fuel of
      Err errors -> Err errors
      Ok (Nil, remaining) -> Ok (Nil, remaining)
      Ok (expanded, remaining) -> Ok ([DConditional site clauses (decl-spine site expanded)], remaining)
    other -> Ok ([declaration], fuel)

  -- Every clause of an ordinary definition: macro calls in ordinary code
  -- expand before the ordinary check, so the check runs on expanded syntax
  -- (modules specification section 8: an expansion is checked under the
  -- same rules as written code).
  macro-expand-clauses :: MacroSite -> List (List Pat, Expr) -> Nat -> Result (List Diagnostic) (List (List Pat, Expr), Nat)
  macro-expand-clauses site-context clauses fuel = case clauses of
    Nil -> Ok (Nil, fuel)
    Cons (patterns, body) rest -> case expand-term site-context body fuel of
      Err errors -> Err errors
      Ok (expanded, remaining) -> case macro-expand-clauses site-context rest remaining of
        Err errors -> Err errors
        Ok (more, done) -> Ok (Cons (patterns, expanded) more, done)

  -- One term, with every macro call in it replaced by its expansion. The
  -- walk visits every expression position, because a call can stand
  -- anywhere a term can.
  expand-term :: MacroSite -> Expr -> Nat -> Result (List Diagnostic) (Expr, Nat)
  expand-term site-context e fuel = case e of
    ESyntaxCaptureUnder at key name argument -> (case site-context of
      MkMacroSite home fix modules names (CallerSite owner caller-fix parent) -> walk-one (expand-term (MkMacroSite owner caller-fix modules names parent)) (ESyntaxCaptureUnder at key name) argument fuel
      other -> stage-error at "Syntax.captureUnder outside its expansion")
    EArgumentScope at argument -> (case site-context of
      MkMacroSite home fix modules names (CallerSite owner caller-fix parent) -> walk-one (expand-term (MkMacroSite owner caller-fix modules names parent)) (EArgumentScope at) argument fuel
      other -> stage-error at "macro argument outside its expansion")
    EMacroCall site path tokens -> expand-call site-context site path tokens fuel
    other -> walk-children (expand-term site-context) e fuel

  walk-children :: forall s. (Expr -> s -> Result (List Diagnostic) (Expr, s)) -> Expr -> s -> Result (List Diagnostic) (Expr, s)
  walk-children visit e state = case e of
    ESplice s operand -> walk-one visit (ESplice s) operand state
    ECon s name args -> walk-one visit (ECon s name) args state
    ERecord s name fields -> walk-one visit (ERecord s name) fields state
    EProject s value name -> walk-one visit (\x -> EProject s x name) value state
    ETuple s xs -> walk-one visit (ETuple s) xs state
    EList s xs -> walk-one visit (EList s) xs state
    ENeg s x -> walk-one visit (ENeg s) x state
    ELam s ps body -> walk-one visit (ELam s ps) body state
    ELetScope s body -> walk-one visit (ELetScope s) body state
    ELocalSignature s name ty rest -> walk-one visit (ELocalSignature s name ty) rest state
    EAnn s x ty -> walk-one visit (\y -> EAnn s y ty) x state
    EForall s vs body -> walk-one visit (EForall s vs) body state
    EUsing s bounds body -> walk-one visit (EUsing s bounds) body state
    EBind s name rhs -> walk-one visit (EBind s name) rhs state
    EDoLet s simple stmts -> walk-one visit (EDoLet s simple) stmts state
    EDo s stmts -> walk-one visit (EDo s) stmts state
    EHandler s label clauses -> walk-one visit (EHandler s label) clauses state
    EQuote s body -> walk-one visit (EQuote s) body state
    ESupplied s f a -> walk-two visit (\x y -> ESupplied s x y) f a state
    EApp s f a -> walk-two visit (\x y -> EApp s x y) f a state
    EBin s op l r -> walk-two visit (\x y -> EBin s op x y) l r state
    ERecordField s label value rest -> walk-two visit (\x y -> ERecordField s label x y) value rest state
    ELocalStrict s p value rest -> walk-two visit (\x y -> ELocalStrict s p x y) value rest state
    ELocalMemo s name value rest -> walk-two visit (\x y -> ELocalMemo s name x y) value rest state
    EGuarded s guard body -> walk-two visit (\x y -> EGuarded s x y) guard body state
    EHandle s body h -> walk-two visit (\x y -> EHandle s x y) body h state
    EHandlerClause s name pats continuation body rest -> walk-two visit (\x y -> EHandlerClause s name pats continuation x y) body rest state
    EWith s bs body -> walk-two visit (\x y -> EWith s x y) bs body state
    EArg s x rest -> walk-two visit (\x y -> EArg s x y) x rest state
    EBinding s name rhs rest -> walk-two visit (\x y -> EBinding s name x y) rhs rest state
    EAlt s p body rest -> walk-two visit (\x y -> EAlt s p x y) body rest state
    ECase s scrut alts -> walk-two visit (\x y -> ECase s x y) scrut alts state
    ELocalGroup s bs body -> walk-two visit (\x y -> ELocalGroup s x y) bs body state
    ELetRec s bs body -> walk-two visit (\x y -> ELetRec s x y) bs body state
    ELet s bs body -> walk-two visit (\x y -> ELet s x y) bs body state
    EIf s c t f -> case visit c state of
      Err errors -> Err errors
      Ok (expanded-c, a) -> case visit t a of
        Err errors -> Err errors
        Ok (expanded-t, b) -> case visit f b of
          Err errors -> Err errors
          Ok (expanded-f, after) -> Ok (EIf s expanded-c expanded-t expanded-f, after)
    other -> Ok (e, state)

  walk-one :: forall s. (Expr -> s -> Result (List Diagnostic) (Expr, s)) -> (Expr -> Expr) -> Expr -> s -> Result (List Diagnostic) (Expr, s)
  walk-one visit build first state = case visit first state of
    Err errors -> Err errors
    Ok (expanded, next) -> Ok (build expanded, next)

  walk-two :: forall s. (Expr -> s -> Result (List Diagnostic) (Expr, s)) -> (Expr -> Expr -> Expr) -> Expr -> Expr -> s -> Result (List Diagnostic) (Expr, s)
  walk-two visit build first second state = case visit first state of
    Err errors -> Err errors
    Ok (left, next) -> walk-one visit (build left) second next

  -- One invocation: bind the token tree's groups to the macro's parameters,
  -- rename the template's own binders apart, fill its splices with the
  -- caller's syntax, then expand whatever the filled template still calls.
  -- A template that is not a quotation is a compile-time computation, which
  -- this rung refuses by name rather than typing.
  macro-budget :: Nat
  macro-budget = 8192

  expand-call :: MacroSite -> Span -> String -> List LToken -> Nat -> Result (List Diagnostic) (Expr, Nat)
  expand-call caller site path tokens fuel = if fuel == 0 || fuel > macro-budget then expand-error site "macro expansion exhausted its work budget" else
    case caller of
      MkMacroSite owner fix modules names parent -> case lookup-macro names owner path of
        None -> expand-error site (cat ["`", path, "` is not a macro (only `macro` definitions take `!(...)` token-tree arguments)"])
        Some (home, name) -> case macro-module home modules of
          None -> expand-error site (cat ["unavailable macro module ", home])
          Some definition -> let declarations = module-decls definition in case syntax-template-of home (stage-operation-available names home) name declarations of
            None -> expand-error site (cat ["macro `", path, "` has no quotation template; only a `[| ... |]` macro body expands in this rung"])
            Some template -> let parameters = macro-parameters name declarations in
              let groups = macro-argument-groups tokens (list-length parameters) in
              if list-length groups /= list-length parameters then
                expand-error site (cat ["macro `", path, "` takes ", nat-to-string (list-length parameters), " token-tree argument(s), but the invocation supplies ", nat-to-string (list-length groups)])
              else let (renamed, serial) = hygienic-term template (macro-budget - fuel) in
                if serial + 1 > macro-budget then expand-error site "macro expansion exhausted its work budget" else case macro-fill-splices renamed (zip-parameters parameters groups) fix of
                  Err errors -> Err errors
                  Ok filled -> let scope = MkMacroSite home (if same owner home then fix else module-scope-fixes home modules Nil) modules names (CallerSite owner fix parent) in
                    case expand-term scope filled (macro-budget - (serial + 1)) of
                      Err errors -> Err errors
                      Ok (expanded, remaining) -> Ok (ETemplateScope site home expanded, remaining)

  -- Name arguments reify a single token at the call site. Syntax arguments
  -- preserve their token trees until a template splices them.
  data MacroOperands where
    MacroOperands :: List (String, String) -> List (String, List LToken) -> MacroOperands
  bind-operands :: Span -> List (String, String) -> List (List LToken) -> Result (List Diagnostic) MacroOperands
  bind-operands site params groups = case (params, groups) of
    (Nil, Nil) -> Ok (MacroOperands Nil Nil)
    (Cons (param, sort) rest, Cons tokens more) -> (case bind-operands site rest more of
      Err errors -> Err errors
      Ok (MacroOperands names syntax) -> if same sort "Name" then
        (case macro-name-argument site tokens of
          Err errors -> Err errors
          Ok spelling -> Ok (MacroOperands (Cons (param, spelling) names) syntax))
        else Ok (MacroOperands names (Cons (param, tokens) syntax)))
    other -> expand-error site "macro token-tree arity mismatch"

  data ReifiedName where
    NameValue :: String -> ReifiedName
    SymbolValue :: String -> ReifiedName
  reified-spelling :: ReifiedName -> String
  reified-spelling value = case value of NameValue name -> name; SymbolValue name -> name
  name-operand :: String -> List (String, String) -> Option ReifiedName
  name-operand param locals = case locals of
    Nil -> None
    Cons (name, spelling) rest -> if same name param then Some (NameValue spelling) else name-operand param rest

  reify-name :: MacroSite -> MacroOperands -> Expr -> Nat -> Result (List Diagnostic) (Option ReifiedName)
  reify-name scope operands expr fuel = if fuel == 0 then expand-error (expr-span expr) "macro expansion exhausted its work budget" else
    case (scope, operands) of
      (MkMacroSite owner fix modules namespaces parent, MacroOperands locals syntax) -> (case expr of
        EVar site name -> Ok (name-operand name locals)
        ELitSym site name -> Ok (Some (SymbolValue name))
        EApp site (EVar op-site op) argument | (same op "name-to-sym" || same op "sym-to-name") && stage-operation-available namespaces owner op ->
          (case reify-name scope operands argument (fuel - 1) of
            Err errors -> Err errors
            Ok result -> (case (op, result) of
              (member, Some (NameValue spelling)) | same member "name-to-sym" -> Ok (Some (SymbolValue spelling))
              (member, Some (SymbolValue spelling)) | same member "sym-to-name" -> Ok (Some (NameValue spelling))
              other -> expand-error site ("invalid stage operand for " <> op)))
        EMacroCall site path tokens -> (case lookup-macro namespaces owner path of
          None -> expand-error site ("macro is not in scope: " <> path)
          Some (home, name) -> case macro-module home modules of
            None -> expand-error site ("unavailable macro module " <> home)
            Some definition -> case name-macro name (module-decls definition) of
              None -> Ok None
              Some (params, body) -> case bind-operands site params (macro-argument-groups tokens (list-length params)) of
                Err errors -> Err errors
                Ok args -> let nested = MkMacroSite home (if same owner home then fix else module-scope-fixes home modules Nil) modules namespaces (CallerSite owner fix parent) in
                  (case reify-name nested args body (fuel - 1) of
                    Ok (Some (NameValue spelling)) -> Ok (Some (NameValue spelling))
                    Err errors -> Err errors
                    other -> expand-error site "macro declared to return Name produced a different value"))
        other -> Ok None)

  reify-term-splice :: MacroSite -> MacroOperands -> Nat -> Span -> Expr -> Result (List Diagnostic) (Option Expr)
  reify-term-splice scope operands fuel site expression = case reify-name scope operands expression fuel of
    Ok (Some value) -> Ok (Some (ELitSym site (reified-spelling value)))
    Ok None -> Ok None
    Err errors -> Err errors

  reify-declaration-name :: MacroSite -> MacroOperands -> List (String, Fix) -> Nat -> Span -> Expr -> Result (List Diagnostic) String
  reify-declaration-name scope operands fix fuel site expression = case reify-name scope operands expression fuel of
    Ok (Some value) -> Ok (reified-spelling value)
    Err errors -> Err errors
    Ok None -> (case operands of MacroOperands names syntax -> declaration-spelling site expression syntax fix)

  expand-declaration-call :: MacroSite -> Span -> String -> List LToken -> Nat -> Result (List Diagnostic) (List Decl, Nat)
  expand-declaration-call caller site path tokens fuel = if fuel == 0 || fuel > macro-budget then expand-error site "macro expansion exhausted its work budget" else case caller of
    MkMacroSite owner fix modules names parent -> (case lookup-macro names owner path of
      None -> expand-error site (cat ["declaration macro is not in scope: ", path])
      Some (home, name) -> case macro-module home modules of
        None -> expand-error site (cat ["unavailable macro module ", home])
        Some definition -> case declaration-macro name (module-decls definition) of
          None -> expand-error site "emit requires a macro producing Declarations"
          Some (params, template) -> let groups = macro-argument-groups tokens (list-length params) in
            if list-length groups /= list-length params then expand-error site "declaration macro token-tree arity mismatch" else
              let scope = MkMacroSite home (if same owner home then fix else module-scope-fixes home modules Nil) modules names (CallerSite owner fix parent) in
              (case bind-operands site params groups of
                Err errors -> Err errors
                Ok operands -> case fill-declarations scope fix operands (decls-of template) (fuel - 1) of
                  Err errors -> Err errors
                  Ok (decls, remaining) -> Ok ([DGeneratedGroup site home name (decl-spine (decl-span template) decls)], remaining)))

  fill-declarations :: MacroSite -> List (String, Fix) -> MacroOperands -> List Decl -> Nat -> Result (List Diagnostic) (List Decl, Nat)
  fill-declarations scope fix operands declarations fuel = case declarations of
    Nil -> Ok (Nil, fuel)
    Cons first rest -> (case fill-declaration scope fix operands first fuel of
      Err errors -> Err errors
      Ok (declared, remaining) -> case fill-declarations scope fix operands rest remaining of
        Err errors -> Err errors
        Ok (tail, done) -> Ok (Cons declared tail, done))

  fill-declaration :: MacroSite -> List (String, Fix) -> MacroOperands -> Decl -> Nat -> Result (List Diagnostic) (Decl, Nat)
  fill-declaration scope fix operands declaration fuel = case declaration of
    DNamedDeclaration site hole body -> (case reify-declaration-name scope operands fix fuel site hole of
      Err errors -> Err errors
      Ok spelling -> case body of
        DSig at name ty -> Ok (DSig at spelling ty, fuel)
        DFun at name clauses -> fill-declaration scope fix operands (DFun at spelling clauses) fuel
        other -> expand-error site "a name splice names a value declaration")
    DFun site name clauses -> (case fill-declared-clauses scope fix operands clauses fuel of
      Err errors -> Err errors
      Ok (expanded, remaining) -> Ok (DFun site name expanded, remaining))
    DSig site name ty -> Ok (declaration, fuel)
    DData site name params constructors -> Ok (declaration, fuel)
    DRecord site name params fields -> Ok (declaration, fuel)
    other -> expand-error (decl-span declaration) "unsupported declaration in a quoted group"

  fill-declared-clauses :: MacroSite -> List (String, Fix) -> MacroOperands -> List (List Pat, Expr) -> Nat -> Result (List Diagnostic) (List (List Pat, Expr), Nat)
  fill-declared-clauses scope fix operands clauses fuel = if fuel > macro-budget then expand-error (Span 0 0 1 1) "macro expansion exhausted its work budget" else case clauses of
    Nil -> Ok (Nil, fuel)
    Cons (patterns, rhs) rest -> let site = expr-span rhs in
      (case hygienic-term (ELam site patterns rhs) (macro-budget - fuel) of
        (ELam at ps body, serial) -> if serial > macro-budget then expand-error site "macro expansion exhausted its work budget" else (case fill-declaration-term scope operands fix (macro-budget - serial) body of
          Err errors -> Err errors
          Ok filled -> case expand-term scope filled (macro-budget - serial) of
            Err errors -> Err errors
            Ok (expanded, remaining) -> case fill-declared-clauses scope fix operands rest remaining of
              Err errors -> Err errors
              Ok (more, done) -> Ok (Cons (ps, expanded) more, done))
        other -> expand-error site "invalid quoted equation")

  fill-declaration-term :: MacroSite -> MacroOperands -> List (String, Fix) -> Nat -> Expr -> Result (List Diagnostic) Expr
  fill-declaration-term scope operands fix fuel body = case operands of
    MacroOperands names syntax -> fill-splices-with (reify-term-splice scope operands fuel) body syntax fix

  zip-parameters :: List String -> List (List LToken) -> List (String, List LToken)
  zip-parameters names groups = case (names, groups) of
    (Cons name rest, Cons tokens more) -> Cons (name, tokens) (zip-parameters rest more)
    other -> Nil

  -- Two declaration lists with different jobs, named for those jobs so the
  -- record's fields alone cannot save a caller from handing the walk's
  -- remainder to the lookup.
  --
  --   `module-decls` is the module's WHOLE declaration list, carried
  --   unchanged through every recursion, because the template lookup resolves
  --   a name anywhere in the module. A suffix would answer a different
  --   question and miss a declaration the walk has already passed.
  --   `declarations` is only the walk's remaining work.
  expand-declarations :: Option CheckedProgram -> MacroSite -> String -> List Decl -> List Decl -> Nat -> Result (List Diagnostic) (List Decl, Nat)
  expand-declarations evaluator site-context owner module-decls declarations fuel = case declarations of
    Nil -> Ok (Nil, fuel)
    Cons first rest -> case expand-declaration evaluator site-context owner module-decls first fuel of
      Err errors -> Err errors
      Ok (local, remaining) -> case expand-declarations evaluator site-context owner module-decls rest remaining of
        Err errors -> Err errors
        Ok (more, done) -> Ok (local <> more, done)

  expand-module :: (Program -> (Program, List Diagnostic)) -> Program -> List Module -> MacroNamespaces -> Module -> Nat -> Result (List Diagnostic) (Module, Nat)
  expand-module resolve program headers names current fuel =
    let declarations = module-decls current in
    if not (stage-work declarations) then Ok (current, fuel) else
      let owner = module-name current in
      let finish = \evaluator -> case expand-declarations evaluator (MkMacroSite owner (module-scope-fixes owner headers Nil) headers names RootCall) owner declarations declarations fuel of
            Err errors -> Err errors
            Ok (body, remaining) -> let site = module-span current in Ok (MkModule site owner (decl-spine site body), remaining) in
      if not (needs-stage-check declarations) then finish None else case stage-modules owner (program-modules program) of
        Err errors -> Err errors
        Ok modules -> let site = program-span program in case resolve (MkProgram site (Cons (quotation-scope site) modules)) of
          (resolved, Nil) -> case check-and-retain resolved of
            Err errors -> Err errors
            Ok checked -> finish (Some checked)
          (resolved, errors) -> Err errors

  expand-modules :: (Program -> (Program, List Diagnostic)) -> Program -> List Module -> MacroNamespaces -> List Module -> Nat -> Result (List Diagnostic) (List Module, Nat)
  expand-modules resolve program headers names modules fuel = case modules of
    Nil -> Ok (Nil, fuel)
    Cons first rest -> case expand-module resolve program headers names first fuel of
      Err errors -> Err errors
      Ok (expanded, remaining) -> case expand-modules resolve program headers names rest remaining of
        Err errors -> Err errors
        Ok (tail, done) -> Ok (Cons expanded tail, done)

  modules-have-stage-work :: List Module -> Bool
  modules-have-stage-work modules = case modules of
    Nil -> False
    Cons first rest -> stage-work (module-decls first) || modules-have-stage-work rest

  expand-stages :: (Program -> (Program, List Diagnostic)) -> Program -> Result (List Diagnostic) Program
  expand-stages resolve program = expand-stages-with resolve (\unit -> Nil) program

  stage-code-carrier :: String -> List Decl -> Option TypeExpr
  stage-code-carrier name declarations = case stage-signature name declarations of
    Some ty -> code-carrier ty
    None -> None

  prepare-stage-code :: String -> (String -> Bool) -> List Decl -> Decl -> Decl
  prepare-stage-code home available declarations declaration = case declaration of
    DStage site (DFun at name [(Nil, body)]) -> (case stage-code-carrier name declarations of
      Some carrier -> (case closed-code-template home available (\spelling -> case stage-code-carrier spelling declarations of Some actual -> True; None -> False) body of
        Some template -> DStage site (DFun at name [(Nil, EQuote at template)])
        None -> declaration)
      None -> declaration)
    other -> declaration

  prepare-stage-module :: MacroNamespaces -> Module -> Module
  prepare-stage-module names m = let declarations = module-decls m in
    if not (needs-stage-check declarations) then m else let home = module-name m in
      let site = module-span m in MkModule site home (decl-spine site (map (prepare-stage-code home (stage-operation-available names home) declarations) declarations))

  expand-stages-with :: (Program -> (Program, List Diagnostic)) -> (Unit -> List Module) -> Program -> Result (List Diagnostic) Program
  expand-stages-with resolve import-headers program = let modules = program-modules program in
    if not (modules-have-stage-work modules) then Ok program else
      let imports = import-headers () in let names = macro-namespaces modules imports in
      let prepared = map (prepare-stage-module names) modules in
      case expand-modules resolve (MkProgram (program-span program) prepared) (prepared <> imports) names prepared macro-budget of
        Err errors -> Err errors
        Ok (expanded, fuel) -> Ok (MkProgram (program-span program) expanded)
