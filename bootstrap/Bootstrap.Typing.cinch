-- Core typing is checked after elaboration, using declarations and lexical
-- scopes rather than the producer's cached application/branch annotations.
-- Numeric reflection authority, totality and usage still need their own checks.
module Bootstrap.Typing where
  import Bootstrap.Type
  import Bootstrap.Index
  import Bootstrap.Core
  import Bootstrap.Global
  import Bootstrap.Instance (scheme-equivalent)
  import Bootstrap.BodyContract
  import Bootstrap.Guarded
  import Bootstrap.Kinds
  import Bootstrap.Proof (Proposition, PNegate)
  import Bootstrap.Nominal (interface-global)
  import Bootstrap.Builtin (array-type-name)
  import Text.Lex (Span)
  import Algebra.Semigroup

  export close-typing-context-with-effects, close-typing-context-with-data, context-effects, task-definition-safe, task-definition-error
  export TypingContext, close-typing-context, typing-definition-closed, context-bodies, context-guarded-bodies
  export context-body-context, close-typing-context-with-definitions
  export task-source-forwarder, task-forwarder-type
  data TypingContext where
    CheckedTypingContext :: List (String, Kind) -> CoreGlobals -> List CoreEffect -> List CoreData -> List String -> TypingContext
  context-data :: TypingContext -> List CoreData
  context-data context = case context of CheckedTypingContext kinds globals effects datas forwarders -> datas
  context-declarations :: TypingContext -> List CoreGlobal
  context-declarations context = case context of CheckedTypingContext kinds globals effects datas forwarders -> globals-declarations globals
  context-effects :: TypingContext -> List CoreEffect
  context-effects context = case context of CheckedTypingContext kinds globals effects datas forwarders -> effects
  context-bodies :: TypingContext -> List BodyBinding
  context-bodies context = case context of CheckedTypingContext kinds globals effects datas forwarders -> globals-bodies globals
  context-body-context :: TypingContext -> BodyBindings
  context-body-context context = case context of CheckedTypingContext kinds globals effects datas forwarders -> globals-body-context globals
  context-guarded-bodies :: TypingContext -> List GuardedBinding
  context-guarded-bodies context = case context of CheckedTypingContext kinds globals effects datas forwarders -> globals-guarded-bodies globals
  context-kinds :: TypingContext -> List (String, Kind)
  context-kinds context = case context of CheckedTypingContext kinds globals effects datas forwarders -> kinds
  context-task-forwarder :: TypingContext -> String -> Bool
  context-task-forwarder context name = case context of CheckedTypingContext kinds globals effects datas forwarders -> has name forwarders
  same :: String -> String -> Bool
  same a b = string-compare a b == 0
  equal-type :: UType -> UType -> Bool
  equal-type a b = valid-type a && valid-type b && (case store-errors (unify (Span 0 0 1 1) (without-index-levels a) (without-index-levels b) (empty-store "Core typing")) of Nil -> True; other -> False)
  has :: String -> List String -> Bool
  has name names = case names of Nil -> False; Cons key rest -> same name key || has name rest
  empty-row :: UType
  empty-row = URow UEnd
  effects-fit :: UType -> UType -> Bool
  effects-fit actual allowed = case store-errors (include-effects (Span 0 0 1 1) actual allowed (empty-store "Core effects")) of Nil -> True; other -> False
  type-is :: String -> UType -> Bool
  type-is name ty = equal-type (UCon name KType) ty
  string-type :: UType -> Bool
  string-type ty = type-is "String" ty || type-is (interface-global "Data.String.String") ty
  constructor-pure :: UType -> Bool
  constructor-pure ty = case ty of
    UFun a b -> constructor-pure b
    UFunEff a row b -> effects-fit row empty-row && constructor-pure b
    UProofFun predicate row result -> effects-fit row empty-row && constructor-pure result
    UPi id name a row b -> effects-fit row empty-row && constructor-pure b
    other -> True
  global-schemes-well-formed :: List (String, Kind) -> List Scheme -> Bool
  global-schemes-well-formed kinds schemes = case schemes of Nil -> True; Cons sc rest -> scheme-well-formed kinds empty-type-scope sc && global-schemes-well-formed kinds rest
  global-types :: List (String, Kind) -> List CoreGlobal -> Bool
  global-types kinds declarations = case declarations of
    Nil -> True
    Cons declaration rest -> global-schemes-well-formed kinds (global-schemes declaration)
      && (case declaration of GlobalValue name role sc -> not (same role "constructor") || constructor-pure (scheme-body sc); other -> True)
      && global-types kinds rest
  kernel-effect-kinds :: List (String, Kind)
  kernel-effect-kinds = [("#kernel.Handler", handler-kind), ("#kernel.ForeignIO", KEffect), ("Foreign", KFun KRegion KEffect), ("Diverge", KEffect), ("Blocking", KEffect), ("Global", KEffect), ("Fail", KEffect), ("Reentrant", KEffect), ("ThreadAffine", KEffect), ("IO", KFun KRegion KEffect), ("Async", KFun KRegion KEffect), ("Cancel", KFun KRegion KEffect), ("Eval", KFun KRegion KEffect)]
  close-typing-context :: List (String, Kind) -> List CoreGlobal -> Option TypingContext
  close-typing-context kinds declarations = close-typing-context-with-effects kinds declarations Nil
  effect-kind-declared :: String -> Kind -> List (String, Kind) -> Bool
  effect-kind-declared name kind kinds = case kinds of Nil -> False; Cons (key, actual) rest -> if same key name then kind-equal kind actual else effect-kind-declared name kind rest
  operation-registered :: CoreOperation -> List CoreGlobal -> Bool
  operation-registered operation declarations = case declarations of
    Nil -> False
    Cons (GlobalValue name role sc) rest -> if same name (core-operation-name operation) then same role "operation" && scheme-equivalent sc (core-operation-scheme operation) else operation-registered operation rest
    Cons other rest -> operation-registered operation rest
  operations-registered :: List CoreOperation -> List CoreGlobal -> Bool
  operations-registered operations declarations = case operations of Nil -> True; Cons first rest -> operation-registered first declarations && operations-registered rest declarations
  effects-registered :: List (String, Kind) -> List CoreGlobal -> List String -> List CoreEffect -> Bool
  effects-registered kinds globals seen declarations = case declarations of
    Nil -> True
    Cons declaration rest -> let name = core-effect-name declaration in
      not (has name seen) && core-effect-closed declaration
        && effect-kind-declared name (core-effect-kind declaration) kinds
        && operations-registered (core-effect-operations declaration) globals
        && effects-registered kinds globals (Cons name seen) rest
  close-typing-context-with-effects :: List (String, Kind) -> List CoreGlobal -> List CoreEffect -> Option TypingContext
  close-typing-context-with-effects kinds declarations effects = close-typing-context-with-data kinds declarations effects Nil
  close-typing-context-with-data :: List (String, Kind) -> List CoreGlobal -> List CoreEffect -> List CoreData -> Option TypingContext
  close-typing-context-with-data kinds declarations effects datas = close-typing-context-with-definitions kinds declarations effects datas Nil
  close-typing-context-with-definitions :: List (String, Kind) -> List CoreGlobal -> List CoreEffect -> List CoreData -> List CoreDefinition -> Option TypingContext
  close-typing-context-with-definitions kinds declarations effects datas definitions = let all = kernel-effect-kinds <> kinds in
    if nominal-kinds-closed all && global-types all declarations && effects-registered all declarations Nil effects && task-data-closed all datas then
      (case close-globals-with-source-data declarations definitions datas of Some globals -> Some (CheckedTypingContext all globals effects datas (task-forwarder-names definitions)); None -> None)
    else None
  wf :: TypingContext -> TypeScope -> UType -> Bool
  wf context scope ty = body-type-authorized (context-bodies context) ty && type-well-formed (context-kinds context) scope ty
  actual-types :: TypingContext -> TypeScope -> List UType -> Bool
  actual-types context scope types = case types of Nil -> True; Cons ty rest -> body-type-authorized (context-bodies context) ty && argument-well-formed (context-kinds context) scope ty && actual-types context scope rest
  evidence-types :: TypingContext -> TypeScope -> CoreEvidence -> Bool
  evidence-types context scope evidence = case evidence of
    CEGiven sp ty symbol -> wf context scope ty
    CEInstance sp ty symbol actuals args -> wf context scope ty && actual-types context scope actuals && evidence-types context scope args
    CEArgument sp first rest -> evidence-types context scope first && evidence-types context scope rest
    CEArgumentsEnd sp -> True
    other -> False
  evidences-types :: TypingContext -> TypeScope -> List CoreEvidence -> Bool
  evidences-types context scope evidence = case evidence of Nil -> True; Cons first rest -> evidence-types context scope first && evidences-types context scope rest
  pattern-type :: CorePattern -> UType
  pattern-type pattern = case pattern of
    CPWild sp ty -> ty
    CPVar sp ty id name -> ty
    CPProof sp ty id name -> ty
    CPAs sp ty id name inner -> ty
    CPConstructor sp ty name actuals constructor fields -> ty
    CPInt sp ty text -> ty
    CPString sp ty text -> ty
    CPChar sp ty text -> ty
    CPTuple sp ty fields -> ty
    other -> UError
  char-value :: String -> Bool
  char-value text = case unpack text of Cons first Nil -> True; other -> False
  tuple-fields :: UType -> Option UType
  tuple-fields ty = case ty of UTuple fields -> Some fields; UCon name KType -> if same name "Unit" then Some UEnd else None; other -> None
  pattern-scope :: TypingContext -> TypeScope -> UType -> CorePattern -> Option TypeScope
  pattern-scope context scope expected pattern = if not (wf context scope expected && equal-type expected (pattern-type pattern)) then None else if kind-equal (type-kind expected) KProp then (case pattern of CPProof sp predicate id name -> add-local-scheme id (mono predicate) scope; other -> None) else if not (proper-type expected) then None else case pattern of
    CPWild sp ty -> Some scope
    CPVar sp ty id name -> add-local-scheme id (mono ty) scope
    CPAs sp ty id name inner -> case add-local-scheme id (mono ty) scope of Some bound -> pattern-scope context bound expected inner; None -> None
    CPConstructor sp ty name actuals constructor fields -> if wf context scope constructor && actual-types context scope actuals then constructor-fields context scope expected constructor fields else None
    CPTuple sp ty fields -> case tuple-fields ty of Some types -> tuple-patterns context scope types fields; None -> None
    CPInt sp ty text -> if integer-carrier ty then Some scope else None
    CPString sp ty text -> if string-type ty then Some scope else None
    CPChar sp ty text -> if type-is "Char" ty && char-value text then Some scope else None
    other -> None
  tuple-patterns :: TypingContext -> TypeScope -> UType -> CorePattern -> Option TypeScope
  tuple-patterns context scope types patterns = case (types, patterns) of
    (UEnd, CPDone sp) -> Some scope
    (UArg ty rest, CPField sp first more) -> case pattern-scope context scope ty first of Some bound -> tuple-patterns context bound rest more; None -> None
    other -> None
  arrow-domain :: UType -> Option (UType, UType)
  arrow-domain ty = case ty of
    UFun a b -> Some (a, empty-row)
    UFunEff a row b -> Some (a, row)
    UProofFun predicate row result -> Some (predicate, row)
    UUsageArrow usage arrow -> if valid-type ty then arrow-domain arrow else None
    UPi id name a row b -> Some (a, row)
    other -> None
  constructor-fields :: TypingContext -> TypeScope -> UType -> UType -> CorePattern -> Option TypeScope
  constructor-fields context scope expected ty fields = case fields of
    CPDone sp -> if equal-type expected ty then Some scope else None
    CPField sp first rest -> case arrow-domain ty of
      Some (domain, row) -> if not (effects-fit row empty-row) then None else
        (case pattern-scope context scope domain first of Some bound -> (case pattern-result ty first of Some result -> constructor-fields context bound expected result rest; None -> None); None -> None)
      None -> None
    other -> None
  lookup-local :: Nat -> List (Nat, Scheme) -> Option Scheme
  lookup-local id locals = case locals of Nil -> None; Cons (key, sc) rest -> if key == id then Some sc else lookup-local id rest
  application-result :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> CoreTerm -> Option (UType, UType)
  application-result context scope gamma facts function argument = case arrow-result gamma facts function argument of
    Some result -> Some result
    None -> (case (arrow-shape function, argument) of
      (UPi id name domain row result, CLocal sp ty key display actuals) -> if not (equal-type domain ty) then None else
        (case lookup-local key (scope-locals scope) of
          Some sc -> (case scheme-params sc of
            Cons q rest -> let value = UIndex ty (IRigid key display 0) in
              if wf context scope value then Some (substitute-bound [(id, value)] result, substitute-bound [(id, value)] row) else None
            Nil -> None)
          None -> None)
      other -> None)
  checked-application :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> UType -> CoreTerm -> CoreTerm -> Bool
  checked-application context scope gamma facts ty row f x = let before-argument = core-mutable-writes f in
    let before-call = before-argument <> core-mutable-writes x in
    (case core-type f of UUsageArrow UsageMany arrow -> task-shareable context Nil 64 (core-type x); other -> True)
      && checked-term context scope gamma facts f
      && checked-term context scope (proof-after-writes gamma before-argument) (facts-after-writes gamma facts before-argument) x
      && (case application-result context scope (proof-after-writes gamma before-call) (facts-after-writes gamma facts before-call) (core-type f) x of
        Some (result, effects) -> equal-type result ty && equal-type effects row
        None -> False)
  tuple-terms :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> CoreTerm -> Bool
  tuple-terms context scope gamma facts types terms = case (types, terms) of
    (UEnd, CArgumentsEnd sp) -> True
    (UArg ty rest, CArgument sp first more) -> equal-type ty (core-type first) && checked-term context scope gamma facts first && tuple-terms context scope (proof-after-writes gamma (core-mutable-writes first)) (facts-after-writes gamma facts (core-mutable-writes first)) rest more
    other -> False
  mathematical :: UType -> Bool
  mathematical ty = type-is "Int" ty || type-is "Nat" ty
  comparable :: UType -> Bool
  comparable ty = integer-carrier ty || type-is "Bool" ty || type-is "Unit" ty || type-is "Char" ty || string-type ty
  primitive-types :: UType -> String -> CoreTerm -> Bool
  primitive-types ty name arguments = case arguments of
    CArgumentsEnd sp -> type-is "Bool" ty && has name ["decision-true", "decision-false"]
    CArgument sp first (CArgumentsEnd end) ->
      if same name "thunk-delay" then (case thunk-function-parts (core-type first) of
        Some (row, result) -> equal-type ty (thunk-type row result)
        None -> False)
      else if same name "thunk-force" then (case thunk-parts (core-type first) of
        Some (row, result) -> equal-type ty result
        None -> False)
      else same name "negate" && type-is "Int" ty && equal-type ty (core-type first)
    CArgument sp first (CArgument at second (CArgumentsEnd end)) -> let carrier = core-type first in
      equal-type carrier (core-type second) && (if has name ["+", "-", "*", "/"] then mathematical carrier && equal-type ty carrier
        else if has name ["<", "<=", ">", ">="] then integer-carrier carrier && type-is "Bool" ty
        else if has name ["==", "/="] then comparable carrier && type-is "Bool" ty
        else False)
    other -> False
  argument-terms :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> CoreTerm -> Bool
  argument-terms context scope gamma facts terms = case terms of CArgumentsEnd sp -> True; CArgument sp first rest -> checked-term context scope gamma facts first && argument-terms context scope (proof-after-writes gamma (core-mutable-writes first)) (facts-after-writes gamma facts (core-mutable-writes first)) rest; other -> False
  alternatives-typed :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> CoreTerm -> UType -> CoreTerm -> Bool
  alternatives-typed context scope gamma facts scrutinee expected alternatives = case alternatives of
    CAlternativesEnd sp -> True
    CAlternative sp pattern body rest -> (case pattern-scope context scope (core-type scrutinee) pattern of
      Some bound -> let row-scope = proof-pattern pattern gamma in
        let introduced = facts-after-writes row-scope (scoped-core-case-facts row-scope facts scrutinee pattern True) (core-mutable-writes scrutinee) in
        equal-type expected (core-type body) && checked-term context bound row-scope (introduced <> facts) body
      None -> False) && (let writes = guard-fallthrough-writes body in
        let introduced = scoped-core-case-rest-facts gamma facts scrutinee pattern body <> facts in
        alternatives-typed context scope (proof-after-writes gamma writes) (facts-after-writes gamma introduced writes) scrutinee expected rest)
    other -> False
  checked-term :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> CoreTerm -> Bool
  checked-term context scope gamma facts term = proper-type (core-type term) && wf context scope (core-type term) && (case term of
    CUse sp ty name role actuals -> actual-types context scope actuals
    CLocal sp ty id name actuals -> actual-types context scope actuals
    CQualifiedUse sp ty name role actuals evidence -> actual-types context scope actuals && evidences-types context scope evidence
    CMethod sp ty name owner slot actuals evidence -> actual-types context scope actuals && evidences-types context scope evidence
    CInt sp ty value -> number-literal-carrier ty
    CString sp ty value -> string-type ty
    CChar sp ty value -> type-is "Char" ty && char-value value
    CUnit sp ty -> type-is "Unit" ty
    CApply sp ty f x -> checked-application context scope gamma facts ty empty-row f x
    CApplyEff sp ty row f x -> wf context scope row && checked-application context scope gamma facts ty row f x
    CHandler sp ty returned operations -> checked-handler context scope gamma facts ty returned operations
    CHandle sp ty label residual body handled-by -> checked-handle context scope gamma facts ty label residual body handled-by
    CDecision sp ty predicate condition -> wf context scope predicate && checked-term context scope gamma facts condition && scoped-decision-valid gamma facts ty predicate condition
    CErasedApply sp ty row f witness -> wf context scope row && checked-term context scope gamma facts f
      && (case core-type f of
        UProofFun predicate effects result -> let writes = core-mutable-writes f in
          equal-type result ty && equal-type effects row && wf context scope predicate
          && scoped-erased-witness (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) predicate witness
        other -> False)
    CLambda sp ty pattern body -> (case (arrow-domain ty, pattern-result ty pattern) of
      (Some (domain, row), Some result) -> (case pattern-scope context scope domain pattern of
        Some bound -> let writes = [(sp, (None :: Option UType))] in equal-type result (core-type body)
          && checked-term context bound (proof-pattern pattern (proof-after-writes gamma writes)) (facts-after-writes gamma facts writes) body
          && effects-fit (core-effects body) row && pattern-usage-allowed context ty pattern body
        None -> False)
      other -> False)
    CScope sp ty region evidence callback -> checked-scope context scope gamma facts ty region evidence callback
    CSpawn sp ty token body -> checked-spawn ty token body && checked-term context scope gamma facts token && checked-term context scope gamma facts body
    CJoin sp ty token handles -> (case task-join-result token handles of Some result -> equal-type ty result; None -> False) && checked-term context scope gamma facts token && argument-terms context scope gamma facts handles
    CWith sp ty given value body -> wf context scope (given-type given) && equal-type (given-type given) (core-type value)
      && equal-type ty (core-type body) && checked-term context scope gamma facts value
      && checked-term context scope (proof-after-writes gamma (core-mutable-writes value)) (facts-after-writes gamma facts (core-mutable-writes value)) body
    CLet sp ty id name sc rhs body -> checked-let context scope gamma facts ty id sc rhs body
    CIf sp ty condition yes no -> type-is "Bool" (core-type condition) && equal-type ty (core-type yes) && equal-type ty (core-type no)
      && checked-term context scope gamma facts condition
      && checked-term context scope (proof-after-writes gamma (scoped-branch-writes condition True)) (scoped-branch-facts gamma facts condition True) yes
      && checked-term context scope (proof-after-writes gamma (scoped-branch-writes condition False)) (scoped-branch-facts gamma facts condition False) no
    CCase sp ty value alternatives -> let writes = core-mutable-writes value in
      checked-term context scope gamma facts value
        && alternatives-typed context scope (proof-after-writes gamma writes) (facts-after-writes gamma facts writes) value ty alternatives
    CTuple sp ty fields -> (case tuple-fields ty of Some types -> tuple-terms context scope gamma facts types fields; None -> False)
    CPrimitive sp ty name args -> (if same name "copy-out" then copy-out-checked context ty args else if same name "mut-borrow" then mut-borrow-checked ty args else if same name "ref-set" then ref-set-checked ty args else primitive-types ty name args)
      && argument-terms context scope gamma facts args
    CProved sp ty certificate body -> equal-type ty (core-type body) && checked-term context scope gamma facts body
    CRefine sp ty certificate body -> (case refinement-view ty of URefine id name carrier predicate -> equal-type carrier (core-type body) && checked-term context scope gamma facts body; other -> False)
    CRefineProof sp ty witness body -> wf context scope (core-type witness) && checked-term context scope gamma facts body && scoped-refinement-proof gamma facts ty witness body
    CForget sp ty body -> (case refinement-view (core-type body) of URefine id name carrier predicate -> equal-type carrier ty && checked-term context scope gamma facts body; other -> False)
    CRequire sp ty body -> (case ty of URequire predicates result -> equal-type result (core-type body) && (case scoped-core-predicates gamma predicates of Some introduced -> checked-term context scope gamma (introduced <> facts) body; None -> False); other -> False)
    CDischarge sp ty certificates body -> equal-type ty (required-body (core-type body)) && checked-term context scope gamma facts body
    CGuard sp ty condition body -> type-is "Bool" (core-type condition) && equal-type ty (core-type body) && checked-term context scope gamma facts condition && checked-term context scope (proof-after-writes gamma (scoped-branch-writes condition True)) (scoped-branch-facts gamma facts condition True) body
    other -> False)
  task-data-closed :: List (String, Kind) -> List CoreData -> Bool
  task-data-closed kinds datas = case datas of
    Nil -> True
    Cons d rest -> core-data-closed d && effect-kind-declared (core-data-name d) (core-data-kind d) kinds && task-data-closed kinds rest
  task-data :: String -> List CoreData -> Option CoreData
  task-data name datas = case datas of Nil -> None; Cons d rest -> if same name (core-data-name d) then Some d else task-data name rest
  task-base :: UType -> UType
  task-base ty = case refinement-view ty of URefine id name carrier predicate -> task-base carrier; URequire predicates body -> task-base body; other -> ty
  task-type-spine :: UType -> List UType -> (UType, List UType)
  task-type-spine ty args = case task-base ty of UApp f x -> task-type-spine f (Cons x args); other -> (other, args)
  task-actuals :: List Quant -> List UType -> List (Nat, UType)
  task-actuals qs args = case (qs, args) of (Cons q rest, Cons a more) -> Cons (quant-id q, a) (task-actuals rest more); other -> Nil
  task-seen-type :: UType -> List UType -> Bool
  task-seen-type ty seen = case seen of Nil -> False; Cons old rest -> equal-type ty old || task-seen-type ty rest
  -- A partial imported constructor table or an opaque resource supplies no
  -- structural Copy evidence.
  copyable-type :: TypingContext -> List UType -> Nat -> UType -> Bool
  copyable-type context seen fuel ty = if fuel == 0 then False else let remaining = fuel - 1 in case task-base ty of
    UTuple fields -> copyable-tuple context seen remaining fields
    UApp (UCon name (KFun KType KType)) element -> if array-type-name name then copyable-type context seen remaining element
      else copyable-data context seen remaining ty
    UApp (UApp (UCon name kind) region) carrier -> if same name "Ref" then
      (case borrowed-carrier (task-base ty) of Some payload -> True; None -> False)
      else copyable-data context seen remaining ty
    UCon name KType -> has name ["Int", "Nat", "Bool", "Unit", "Char", "I8", "I16", "I32", "I64", "Isize", "U8", "U16", "U32", "U64", "Usize", "F32", "F64"]
      || copyable-data context seen remaining ty
    other -> copyable-data context seen remaining ty
  copyable-tuple :: TypingContext -> List UType -> Nat -> UType -> Bool
  copyable-tuple context seen fuel fields = case fields of
    UEnd -> True
    UArg first rest -> copyable-type context seen fuel first && copyable-tuple context seen fuel rest
    other -> False
  copyable-data :: TypingContext -> List UType -> Nat -> UType -> Bool
  copyable-data context seen fuel ty = if task-seen-type ty seen then True else case task-type-spine ty Nil of
    (UCon name kind, args) -> (case task-data name (context-data context) of
      Some d -> (case core-data-constructors d of
        Nil -> False
        constructors -> list-length args == list-length (core-data-params d)
          && copyable-constructors context (Cons ty seen) fuel (task-actuals (core-data-params d) args) constructors)
      None -> False)
    other -> False
  copyable-constructors :: TypingContext -> List UType -> Nat -> List (Nat, UType) -> List CoreConstructor -> Bool
  copyable-constructors context seen fuel pairs constructors = case constructors of
    Nil -> True
    Cons constructor rest -> copyable-fields context seen fuel pairs (core-constructor-fields constructor)
      && copyable-constructors context seen fuel pairs rest
  copyable-fields :: TypingContext -> List UType -> Nat -> List (Nat, UType) -> List UType -> Bool
  copyable-fields context seen fuel pairs fields = case fields of
    Nil -> True
    Cons first rest -> copyable-type context seen fuel (substitute-bound pairs first) && copyable-fields context seen fuel pairs rest
  copy-out-checked :: TypingContext -> UType -> CoreTerm -> Bool
  copy-out-checked context result args = case args of
    CArgument sp value (CArgumentsEnd end) -> equal-type result (copy-out-type (core-type value)) && copyable-type context Nil 64 result
    other -> False
  mut-borrow-checked :: UType -> CoreTerm -> Bool
  mut-borrow-checked result args = case (mutable-borrow result, args) of
    (Some (region, carrier), CArgument sp value (CArgumentsEnd end)) -> equal-type carrier (core-type value)
    other -> False
  ref-set-checked :: UType -> CoreTerm -> Bool
  ref-set-checked result args = type-is "Unit" result && (case args of
    CArgument sp (CLocal at ty id name actuals) (CArgument bt value (CArgumentsEnd end)) ->
      (case mutable-borrow ty of Some (region, carrier) -> equal-type carrier (core-type value); None -> False)
    other -> False)
  task-signature :: String -> List CoreGlobal -> Bool
  task-signature owner declarations = case declarations of
    Nil -> False
    Cons (GlobalMethod name class slot sc) rest -> same owner class || task-signature owner rest
    Cons (GlobalBody d body) rest -> task-signature owner [d] || task-signature owner rest
    Cons (GlobalGuardedBody d body) rest -> task-signature owner [d] || task-signature owner rest
    Cons other rest -> task-signature owner rest
  -- Structural Copy/Share uses checked complete data declarations. Unknown
  -- carriers and mutable buffers do not acquire sharing from a printed name.
  task-shareable :: TypingContext -> List UType -> Nat -> UType -> Bool
  task-shareable context seen fuel ty = if fuel == 0 then False else case task-base ty of
    UCon name KType -> if has name ["Int", "Nat", "Bool", "Unit", "Char", "String", "I8", "I16", "I32", "I64", "Isize", "U8", "U16", "U32", "U64", "Usize", "F32", "F64"] || same name (interface-global "Data.String.String") then True else task-data-property context True seen fuel ty
    UTuple fields -> task-fields-property context True seen fuel fields
    UApp (UCon name kind) owner -> if same name "b.Io" then True else task-data-property context True seen fuel ty
    UApp (UApp (UCon name kind) owner) region -> if same name "b.Scope" then True else task-data-property context True seen fuel ty
    URigid id name level KRegion -> True
    UBound id name KRegion -> True
    other -> task-data-property context True seen fuel ty
  -- A closed scalar/data value cannot hide a scoped closure. This allows
  -- ordinary saturated calls to return such values without inventing loans.
  task-region-free-type :: TypingContext -> List UType -> Nat -> UType -> Bool
  task-region-free-type context seen fuel ty = if fuel == 0 then False else case task-base ty of
    UCon name KType -> if has name ["Int", "Nat", "Bool", "Unit", "Char", "String", "Bytes", "Sym", "I8", "I16", "I32", "I64", "Isize", "U8", "U16", "U32", "U64", "Usize", "F32", "F64"] || same name (interface-global "Data.String.String") then True else task-data-property context False seen fuel ty
    UTuple fields -> task-fields-property context False seen fuel fields
    other -> task-data-property context False seen fuel ty
  task-property :: TypingContext -> Bool -> List UType -> Nat -> UType -> Bool
  task-property context sharing seen fuel ty = if sharing then task-shareable context seen fuel ty else task-region-free-type context seen fuel ty
  task-fields-property :: TypingContext -> Bool -> List UType -> Nat -> UType -> Bool
  task-fields-property context sharing seen fuel fields = case fields of UEnd -> True; UArg ty more -> task-property context sharing seen fuel ty && task-fields-property context sharing seen fuel more; other -> False
  task-types-property :: TypingContext -> Bool -> List UType -> Nat -> List UType -> Bool
  task-types-property context sharing seen fuel types = case types of Nil -> True; Cons ty rest -> task-property context sharing seen fuel ty && task-types-property context sharing seen fuel rest
  task-data-property :: TypingContext -> Bool -> List UType -> Nat -> UType -> Bool
  task-data-property context sharing seen fuel ty = if fuel == 0 then False else if task-seen-type ty seen then True else case task-type-spine ty Nil of
    (UCon name kind, args) -> if sharing && task-signature name (context-declarations context) then task-types-property context True seen (fuel - 1) args else
      (case task-data name (context-data context) of
        None -> False
        Some d -> list-length args == list-length (core-data-params d) && (case core-data-constructors d of Nil -> False; other -> True)
          && task-constructors-property context sharing (Cons ty seen) (fuel - 1) (task-actuals (core-data-params d) args) (core-data-constructors d))
    other -> False
  task-constructors-property :: TypingContext -> Bool -> List UType -> Nat -> List (Nat, UType) -> List CoreConstructor -> Bool
  task-constructors-property context sharing seen fuel pairs ctors = case ctors of
    Nil -> True
    Cons ctor rest -> task-types-property context sharing seen fuel (map-task-types pairs (core-constructor-fields ctor)) && task-constructors-property context sharing seen fuel pairs rest
  map-task-types :: List (Nat, UType) -> List UType -> List UType
  map-task-types pairs types = case types of Nil -> Nil; Cons ty rest -> Cons (substitute-bound pairs ty) (map-task-types pairs rest)
  data TaskLocal where
    TaskLocal :: Nat -> UType -> List UType -> Bool -> TaskLocal
  data TaskTrace where
    TaskTrace :: Option (Span, String) -> List UType -> Bool -> TaskTrace
  task-trace-error :: TaskTrace -> Option (Span, String)
  task-trace-error result = case result of TaskTrace error regions shared -> error
  task-trace-regions :: TaskTrace -> List UType
  task-trace-regions result = case result of TaskTrace error regions shared -> regions
  task-trace-shared :: TaskTrace -> Bool
  task-trace-shared result = case result of TaskTrace error regions shared -> shared
  first-task-error :: Option (Span, String) -> Option (Span, String) -> Option (Span, String)
  first-task-error first second = case first of None -> second; Some error -> first
  require-task :: Bool -> Span -> String -> Option (Span, String)
  require-task valid sp message = if valid then None else Some (sp, message)
  task-use-error :: Span -> Option (Span, String)
  task-use-error sp = Some (sp, "task handle must be consumed exactly once")
  task-drop-error :: Span -> Option (Span, String)
  task-drop-error sp = Some (sp, "task handle must be joined exactly once")
  task-local :: Nat -> List TaskLocal -> Option TaskLocal
  task-local id env = case env of Nil -> None; Cons (TaskLocal key ty regions shared) rest -> if id == key then Some (TaskLocal key ty regions shared) else task-local id rest
  task-pattern-ids :: CorePattern -> List Nat
  task-pattern-ids p = case p of CPVar sp ty id name -> [id]; CPProof sp ty id name -> [id]; CPAs sp ty id name inner -> Cons id (task-pattern-ids inner); CPConstructor sp ty name actuals constructor fields -> task-pattern-ids fields; CPTuple sp ty fields -> task-pattern-ids fields; CPField sp first rest -> task-pattern-ids first <> task-pattern-ids rest; other -> Nil
  task-id-present :: Nat -> List Nat -> Bool
  task-id-present id ids = case ids of Nil -> False; Cons key rest -> id == key || task-id-present id rest
  task-pattern-env :: CorePattern -> List UType -> Bool -> List TaskLocal -> List TaskLocal
  task-pattern-env p regions shared env = case p of
    CPVar sp ty id name -> Cons (TaskLocal id ty regions shared) env
    CPProof sp ty id name -> env
    CPAs sp ty id name inner -> Cons (TaskLocal id ty regions shared) (task-pattern-env inner regions shared env)
    CPConstructor sp ty name actuals constructor fields -> task-pattern-env fields regions shared env
    CPTuple sp ty fields -> task-pattern-env fields regions shared env
    CPField sp first rest -> task-pattern-env rest regions shared (task-pattern-env first regions shared env)
    other -> env
  task-regions :: UType -> List UType
  task-regions ty = case task-base ty of
    URigid id name level KRegion -> [ty]
    UBound id name KRegion -> [ty]
    UApp f x -> task-regions f <> task-regions x
    UFun a b -> task-regions a <> task-regions b
    UFunEff a row b -> task-regions a <> task-regions row <> task-regions b
    UPi id name a row b -> task-regions a <> task-regions row <> task-regions b
    UTuple fields -> task-regions fields
    UArg first rest -> task-regions first <> task-regions rest
    URow labels -> task-regions labels
    URowJoin a b -> task-regions a <> task-regions b
    other -> Nil
  task-region-present :: UType -> List UType -> Bool
  task-region-present region regions = case regions of Nil -> False; Cons first rest -> equal-type region first || task-region-present region rest
  task-outlives :: List UType -> UType -> UType -> UType -> Bool
  task-outlives scopes owner destination captured = if equal-type owner captured || equal-type destination captured then True
    else if not (task-region-present captured scopes) then task-region-present destination scopes
    else task-enclosing scopes destination captured
  task-enclosing :: List UType -> UType -> UType -> Bool
  task-enclosing scopes destination captured = case scopes of Nil -> False; Cons first rest -> if equal-type destination first then task-region-present captured rest else task-enclosing rest destination captured
  task-capture-regions :: List UType -> UType -> UType -> List UType -> Bool
  task-capture-regions scopes owner destination regions = case regions of Nil -> True; Cons region rest -> task-outlives scopes owner destination region && task-capture-regions scopes owner destination rest
  task-evidence-regions :: CoreEvidence -> List UType
  task-evidence-regions evidence = case evidence of
    CEGiven sp ty name -> task-regions ty
    CEInstance sp ty symbol actuals args -> task-regions ty <> task-evidence-regions args
    CEArgument sp first rest -> task-evidence-regions first <> task-evidence-regions rest
    other -> Nil
  task-evidences-regions :: List CoreEvidence -> List UType
  task-evidences-regions evidence = case evidence of Nil -> Nil; Cons first rest -> task-evidence-regions first <> task-evidences-regions rest
  task-scoped-type :: UType -> Bool
  task-scoped-type ty = case (scope-parameters (task-base ty), task-parts (task-base ty)) of (None, None) -> False; other -> True
  task-handle-type :: UType -> Bool
  task-handle-type ty = case task-parts (task-base ty) of Some parts -> True; None -> False
  task-free :: List Nat -> CoreTerm -> List (Nat, UType)
  task-free bound term = case term of
    CLocal sp ty id name actuals -> if task-id-present id bound then Nil else [(id, ty)]
    CLambda sp ty p body -> task-free (task-pattern-ids p <> bound) body
    CLet sp ty id name sc rhs body -> task-free bound rhs <> task-free (Cons id bound) body
    CAlternative sp p body rest -> task-free (task-pattern-ids p <> bound) body <> task-free bound rest
    other -> task-free-children bound (term-children term)
  task-free-children :: List Nat -> List CoreTerm -> List (Nat, UType)
  task-free-children bound terms = case terms of Nil -> Nil; Cons first rest -> task-free bound first <> task-free-children bound rest
  task-free-regions :: List TaskLocal -> List (Nat, UType) -> List UType
  task-free-regions env free = case free of
    Nil -> Nil
    Cons (id, ty) rest -> task-regions ty <> (case task-local id env of Some (TaskLocal key declared regions shared) -> regions; None -> Nil) <> task-free-regions env rest
  task-free-sharing :: TypingContext -> List (Nat, UType) -> Bool
  task-free-sharing context free = case free of Nil -> True; Cons (id, ty) rest -> (task-handle-type ty || task-shareable context Nil 64 ty) && task-free-sharing context rest
  task-free-scopes :: List TaskLocal -> List (Nat, UType) -> Bool
  task-free-scopes env free = case free of
    Nil -> True
    Cons (id, ty) rest -> not (task-scoped-type ty) && (case task-local id env of Some (TaskLocal key declared regions shared) -> (case regions of Nil -> True; other -> False); None -> True) && task-free-scopes env rest
  -- The bounds describe the least and most uses on the reachable paths.
  -- None marks a use captured by a closure with unknown invocation count.
  use-count-sequence :: Option (Nat, Nat) -> Option (Nat, Nat) -> Option (Nat, Nat)
  use-count-sequence a b = case (a, b) of (Some (low, high), Some (more-low, more-high)) -> Some (low + more-low, high + more-high); other -> None
  use-count-choice :: Option (Nat, Nat) -> Option (Nat, Nat) -> Option (Nat, Nat)
  use-count-choice a b = case (a, b) of
    (Some (left-low, left-high), Some (right-low, right-high)) ->
      Some (if left-low < right-low then left-low else right-low, if left-high > right-high then left-high else right-high)
    other -> None
  -- Effects can stop before their one-shot continuation. Count that path
  -- too when checking multiplicities. The task trace has its own rules for
  -- transferring captures to an independently running callback.
  use-count-after :: Bool -> CoreTerm -> Option (Nat, Nat) -> Option (Nat, Nat) -> Option (Nat, Nat)
  use-count-after interrupted first uses next = use-count-sequence uses
    (if interrupted && not (effects-fit (core-effects first) empty-row) then use-count-choice (Some (0, 0)) next else next)
  use-count-list :: Bool -> Nat -> List CoreTerm -> Option (Nat, Nat)
  use-count-list interrupted id terms = case terms of
    Nil -> Some (0, 0)
    Cons first rest -> use-count-after interrupted first (use-count interrupted id first) (use-count-list interrupted id rest)
  use-count-once :: Bool -> Nat -> CoreTerm -> Option (Nat, Nat)
  use-count-once interrupted id callback = case callback of
    CLambda sp ty p body -> if task-id-present id (task-pattern-ids p) then Some (0, 0) else use-count interrupted id body
    other -> use-count interrupted id callback
  use-count :: Bool -> Nat -> CoreTerm -> Option (Nat, Nat)
  use-count interrupted id term = case term of
    CLocal sp ty key name actuals -> if id == key then Some (1, 1) else Some (0, 0)
    CLambda sp ty p body -> if task-id-present id (task-pattern-ids p) then Some (0, 0) else (case use-count interrupted id body of Some (0, 0) -> Some (0, 0); other -> None)
    CLet sp ty key name sc rhs body -> use-count-after interrupted rhs (use-count interrupted id rhs) (if id == key then Some (0, 0) else use-count interrupted id body)
    CIf sp ty condition yes no -> use-count-after interrupted condition (use-count interrupted id condition) (use-count-choice (use-count interrupted id yes) (use-count interrupted id no))
    CCase sp ty value alts -> use-count-after interrupted value (use-count interrupted id value) (use-count-alternatives interrupted id alts)
    CScope sp ty region evidence callback -> use-count-once interrupted id callback
    CSpawn sp ty token callback ->
      let uses = use-count-once interrupted id callback in
      use-count-after interrupted token (use-count interrupted id token) (if interrupted then use-count-choice (Some (0, 0)) uses else uses)
    CHandle sp ty label residual body handled-by -> use-count-list interrupted id [handled-by, body]
    CErasedApply sp ty row f witness -> use-count interrupted id f
    CRefineProof sp ty witness body -> use-count interrupted id body
    other -> use-count-list interrupted id (term-children term)
  use-pattern-total :: CorePattern -> Bool
  use-pattern-total p = case p of CPWild sp ty -> True; CPVar sp ty id name -> True; CPAs sp ty id name inner -> use-pattern-total inner; other -> False
  use-count-row :: Bool -> Nat -> CoreTerm -> CoreTerm -> Option (Nat, Nat)
  use-count-row interrupted id body rest = case body of
    CGuard sp ty guard value ->
      let branch = use-count interrupted id value in
      let next = if core-alternative-covers body then branch else use-count-choice branch (use-count-alternatives interrupted id rest) in
      use-count-after interrupted guard (use-count interrupted id guard) next
    CLet sp ty key name sc rhs value -> use-count-after interrupted rhs (use-count interrupted id rhs) (use-count-row interrupted id value rest)
    CRequire sp ty value -> use-count-row interrupted id value rest
    CDischarge sp ty evidence value -> use-count-row interrupted id value rest
    CProved sp ty evidence value -> use-count-row interrupted id value rest
    CRefine sp ty evidence value -> use-count-row interrupted id value rest
    CRefineProof sp ty witness value -> use-count-row interrupted id value rest
    CForget sp ty value -> use-count-row interrupted id value rest
    other -> use-count interrupted id body
  use-count-alternatives :: Bool -> Nat -> CoreTerm -> Option (Nat, Nat)
  use-count-alternatives interrupted id alts = case alts of
    CAlternative sp p body (CAlternativesEnd end) -> use-count interrupted id body
    CAlternative sp p body rest -> if task-id-present id (task-pattern-ids p) then use-count-alternatives interrupted id rest
      else if use-pattern-total p then use-count-row interrupted id body rest
      else use-count-choice (use-count-row interrupted id body rest) (use-count-alternatives interrupted id rest)
    other -> None
  -- Pattern matching consumes the outer value of a destructuring pattern.
  -- A variable, or an alias for a wildcard, instead exposes that value to
  -- the body. Other alias forms need joint accounting for the alias and
  -- the inner pattern before they can check a restricted argument.
  pattern-use-count :: CorePattern -> CoreTerm -> Option (Nat, Nat)
  pattern-use-count pattern body = case pattern of
    CPVar sp ty id name -> use-count True id body
    CPWild sp ty -> Some (0, 0)
    CPAs sp ty id name (CPWild at inner) -> use-count True id body
    CPAs sp ty id name inner -> None
    CPConstructor sp ty name actuals ctor fields -> Some (1, 1)
    CPTuple sp ty fields -> Some (1, 1)
    CPInt sp ty text -> Some (1, 1)
    CPString sp ty text -> Some (1, 1)
    CPChar sp ty text -> Some (1, 1)
    other -> None
  use-count-fits :: ArrowUsage -> Option (Nat, Nat) -> Bool
  use-count-fits usage count = case (usage, count) of
    (UsageZero, Some (0, 0)) -> True
    (UsageOne, Some (1, 1)) -> True
    (UsageAffine, Some (low, high)) -> high <= 1
    other -> False
  -- A strict alias moves the value. The source must satisfy its own
  -- obligation and the new binding inherits the same obligation.
  aliases-use-allowed :: ArrowUsage -> Nat -> CoreTerm -> Bool
  aliases-use-allowed usage id term = case term of
    CLet sp ty key name sc (CLocal at carrier original display Nil) body ->
      (if id == original then use-count-fits usage (use-count True key body) && aliases-use-allowed usage key body else True)
        && aliases-use-allowed usage id body
    other -> alias-children-allowed usage id (term-children term)
  alias-children-allowed :: ArrowUsage -> Nat -> List CoreTerm -> Bool
  alias-children-allowed usage id children = case children of
    Nil -> True
    Cons first rest -> aliases-use-allowed usage id first && alias-children-allowed usage id rest
  pattern-aliases-allowed :: ArrowUsage -> CorePattern -> CoreTerm -> Bool
  pattern-aliases-allowed usage pattern body = case pattern of
    CPVar sp ty id name -> aliases-use-allowed usage id body
    CPAs sp ty id name (CPWild at carrier) -> aliases-use-allowed usage id body
    other -> True
  pattern-usage-allowed :: TypingContext -> UType -> CorePattern -> CoreTerm -> Bool
  pattern-usage-allowed context function pattern body = case function of
    UUsageArrow UsageMany arrow -> task-shareable context Nil 64 (pattern-type pattern)
    UUsageArrow usage arrow -> use-count-fits usage (pattern-use-count pattern body) && pattern-aliases-allowed usage pattern body
    other -> True
  annotated-arrow :: UType -> Bool
  annotated-arrow ty = case ty of UUsageArrow usage arrow -> True; other -> False
  usage-message :: ArrowUsage -> String
  usage-message usage = case usage of
    UsageZero -> "multiplicity %0: an erased argument must never be used at runtime"
    UsageOne -> "multiplicity %1: the argument must be used exactly once on every path"
    UsageAffine -> "multiplicity %aff: the argument must be used at most once on every path"
    UsageMany -> "multiplicity %many: the argument needs structural Share evidence"
  pattern-usage-error :: TypingContext -> Span -> UType -> CorePattern -> CoreTerm -> Option (Span, String)
  pattern-usage-error context sp function pattern body = case function of
    UUsageArrow usage arrow -> if pattern-usage-allowed context function pattern body then None else
      let site = case pattern of CPVar at ty id name -> at; CPWild at ty -> at; CPAs at ty id name inner -> at; other -> sp in
      Some (site, usage-message usage)
    other -> None
  -- Before a guard commits to this equation, a later equation can still
  -- receive the same argument. An owned argument cannot move on that path.
  guard-falls-through :: CoreTerm -> Bool
  guard-falls-through body = case body of
    CGuard sp ty guard value -> not (core-alternative-covers body)
    CLet sp ty id name sc rhs value -> guard-falls-through value
    CRequire sp ty value -> guard-falls-through value
    CDischarge sp ty evidence value -> guard-falls-through value
    CProved sp ty evidence value -> guard-falls-through value
    CRefine sp ty evidence value -> guard-falls-through value
    CRefineProof sp ty witness value -> guard-falls-through value
    CForget sp ty value -> guard-falls-through value
    other -> False
  guard-uses :: Nat -> CoreTerm -> Option (Nat, Nat)
  guard-uses id body = case body of
    CGuard sp ty guard value -> use-count True id guard
    CLet sp ty key name sc rhs value -> use-count-after True rhs (use-count True id rhs) (guard-uses id value)
    CRequire sp ty value -> guard-uses id value
    CDischarge sp ty evidence value -> guard-uses id value
    CProved sp ty evidence value -> guard-uses id value
    CRefine sp ty evidence value -> guard-uses id value
    CRefineProof sp ty witness value -> guard-uses id value
    CForget sp ty value -> guard-uses id value
    other -> Some (0, 0)
  guard-uses-none :: List Nat -> CoreTerm -> Bool
  guard-uses-none binders body = case binders of
    Nil -> True
    Cons id rest -> case guard-uses id body of Some (0, 0) -> guard-uses-none rest body; other -> False
  guarded-argument-error :: Span -> UType -> CorePattern -> CoreTerm -> Option (Span, String)
  guarded-argument-error sp function pattern body = case function of
    UUsageArrow UsageMany arrow -> None
    UUsageArrow usage arrow -> require-task (not (guard-falls-through body) || guard-uses-none (task-pattern-ids pattern) body) sp
      (string-concat-all ["multiplicity ", arrow-usage-text usage, ": the argument can be consumed before a guard falls through"])
    other -> None
  usage-parameter-error :: TypingContext -> Span -> Bool -> UType -> List CorePattern -> CoreTerm -> Option (Span, String)
  usage-parameter-error context sp fallthrough function patterns body = case patterns of
    Nil -> None
    Cons pattern rest -> case pattern-usage-error context sp function pattern body of
      Some error -> Some error
      None -> case (if fallthrough then guarded-argument-error sp function pattern body else None) of
        Some error -> Some error
        None -> (case pattern-result function pattern of
          Some result -> usage-parameter-error context sp fallthrough result rest body
          None -> None)
  has-annotated-parameter :: UType -> Bool
  has-annotated-parameter ty = case ty of
    UUsageArrow usage arrow -> True
    UFun domain result -> has-annotated-parameter result
    UFunEff domain row result -> has-annotated-parameter result
    UPi id name domain row result -> has-annotated-parameter result
    UProofFun predicate row result -> has-annotated-parameter result
    other -> False
  usage-equations-error :: TypingContext -> UType -> List CoreClause -> Option (Span, String)
  usage-equations-error context function clauses = case clauses of
    Nil -> None
    Cons (MkCoreClause sp patterns body) rest ->
      let fallthrough = case rest of Nil -> False; other -> True in
      case usage-parameter-error context sp fallthrough function patterns body of
        Some error -> Some error
        None -> usage-equations-error context function rest
  affine-thunk :: UType -> Bool
  affine-thunk ty = case thunk-parts (task-base ty) of Some parts -> True; None -> False
  thunk-use-error :: Span -> Option (Span, String)
  thunk-use-error sp = Some (sp, "multiplicity %aff: a thunk must be used at most once")
  task-bound-error :: Span -> Nat -> UType -> CoreTerm -> Option (Span, String)
  task-bound-error sp id ty body =
    if task-handle-type ty then (case use-count False id body of
      Some (1, 1) -> None
      Some (0, 0) -> task-drop-error sp
      other -> task-use-error sp)
    else if affine-thunk ty then (case use-count True id body of
      Some (low, high) -> if high <= 1 then None else thunk-use-error sp
      None -> thunk-use-error sp)
    else None
  task-pattern-use-error :: CorePattern -> CoreTerm -> Option (Span, String)
  task-pattern-use-error p body = case p of
    CPVar sp ty id name -> task-bound-error sp id ty body
    CPWild sp ty -> if task-handle-type ty then task-drop-error sp else None
    CPAs sp ty id name inner -> if affine-thunk ty && (case inner of CPWild at carrier -> False; other -> True) then thunk-use-error sp
      else first-task-error (task-bound-error sp id ty body) (task-pattern-use-error inner body)
    CPConstructor sp ty name actuals constructor fields -> task-pattern-use-error fields body
    CPTuple sp ty fields -> task-pattern-use-error fields body
    CPField sp first rest -> first-task-error (task-pattern-use-error first body) (task-pattern-use-error rest body)
    other -> None
  task-traces-merge :: TaskTrace -> TaskTrace -> TaskTrace
  task-traces-merge a b = TaskTrace (first-task-error (task-trace-error a) (task-trace-error b)) (task-trace-regions a <> task-trace-regions b) (task-trace-shared a && task-trace-shared b)
  task-trace-list :: TypingContext -> List TaskLocal -> List UType -> Bool -> List CoreTerm -> TaskTrace
  task-trace-list context env scopes consuming terms = case terms of Nil -> TaskTrace None Nil True; Cons first rest -> task-traces-merge (task-trace context env scopes consuming first) (task-trace-list context env scopes consuming rest)
  task-result-trace :: TypingContext -> UType -> TaskTrace -> TaskTrace
  task-result-trace context ty trace = TaskTrace (task-trace-error trace) (if task-region-free-type context Nil 64 ty then Nil else task-hidden-regions ty (task-trace-regions trace)) (task-trace-shared trace)
  task-hidden-regions :: UType -> List UType -> List UType
  task-hidden-regions ty regions = case regions of Nil -> Nil; Cons region rest -> if task-region-present region (task-regions ty) then task-hidden-regions ty rest else Cons region (task-hidden-regions ty rest)
  task-free-evidence :: List String -> CoreTerm -> List UType
  task-free-evidence bound term = case term of
    CQualifiedUse sp ty name role actuals evidence -> task-free-evidences bound evidence
    CMethod sp ty name owner slot actuals evidence -> task-free-evidences bound evidence
    CScope sp ty region evidence callback -> task-evidence-types bound evidence <> task-free-evidence bound callback
    CWith sp ty given value body -> task-free-evidence bound value <> task-free-evidence (Cons (given-symbol given) bound) body
    other -> task-free-evidence-list bound (term-children term)
  task-evidence-types :: List String -> CoreEvidence -> List UType
  task-evidence-types bound evidence = case evidence of
    CEGiven sp ty name -> if has name bound then Nil else [ty]
    CEInstance sp ty name actuals args -> task-evidence-types bound args
    CEArgument sp first rest -> task-evidence-types bound first <> task-evidence-types bound rest
    other -> Nil
  task-free-evidences :: List String -> List CoreEvidence -> List UType
  task-free-evidences bound evidence = case evidence of Nil -> Nil; Cons first rest -> task-evidence-types bound first <> task-free-evidences bound rest
  task-free-evidence-list :: List String -> List CoreTerm -> List UType
  task-free-evidence-list bound terms = case terms of Nil -> Nil; Cons first rest -> task-free-evidence bound first <> task-free-evidence-list bound rest
  task-capture-types :: List UType -> List UType
  task-capture-types types = case types of Nil -> Nil; Cons ty rest -> task-regions ty <> task-capture-types rest
  task-active-regions :: List UType -> List UType -> List UType
  task-active-regions scopes regions = case regions of Nil -> Nil; Cons region rest -> if task-region-present region scopes then Cons region (task-active-regions scopes rest) else task-active-regions scopes rest
  -- A checked source forwarder delegates its capture and lifetime checks to
  -- a saturated call in the same compilation. It cannot escape as a value.
  task-arrow-output :: UType -> UType
  task-arrow-output ty = case ty of UFun domain output -> output; UFunEff domain row output -> output; UPi id name domain row output -> output; other -> UError
  task-forwarder-type :: UType -> Bool
  task-forwarder-type ty = task-handle-type (task-arrow-output (task-arrow-output ty))
  task-source-forwarder :: CoreDefinition -> Bool
  task-source-forwarder definition =
    case (opening-value-types (core-openings definition), core-givens definition, core-clauses definition) of
      (Nil, Nil, [MkCoreClause sp [CPVar token-at token-ty token-id token-name, CPVar body-at body-ty body-id body-name] (CSpawn spawn-at result (CLocal token-use scope key scope-name Nil) (CLocal body-use callback body-key callback-name Nil))]) ->
        token-id == key && body-id == body-key && token-id /= body-id
          && task-forwarder-type (scheme-body (core-scheme definition)) && checked-spawn result (CLocal token-use scope key scope-name Nil) (CLocal body-use callback body-key callback-name Nil)
      other -> False
  task-forwarder-names :: List CoreDefinition -> List String
  task-forwarder-names definitions = case definitions of
    Nil -> Nil
    Cons definition rest -> if task-source-forwarder definition then Cons (core-name definition) (task-forwarder-names rest) else task-forwarder-names rest
  task-reference-forwarder :: TypingContext -> CoreTerm -> Bool
  task-reference-forwarder context term = case term of
    CUse sp ty name role actuals -> context-task-forwarder context name
    CQualifiedUse sp ty name role actuals Nil -> context-task-forwarder context name
    other -> False
  task-forwarded-scope :: TypingContext -> CoreTerm -> Option CoreTerm
  task-forwarded-scope context partial = case partial of
    CApply sp ty callee token -> if task-reference-forwarder context callee then Some token else None
    CApplyEff sp ty row callee token -> if task-reference-forwarder context callee then Some token else None
    other -> None
  task-global-trace :: TypingContext -> List TaskLocal -> List UType -> Span -> UType -> CoreTerm -> List CoreEvidence -> TaskTrace
  task-global-trace context env scopes sp ty term evidence =
    let required = require-task (not (task-reference-forwarder context term)) sp "a task forwarding helper must be fully applied in its source compilation" in
    task-result-trace context ty (task-traces-merge (TaskTrace required (task-evidences-regions evidence) True) (task-trace-list context env scopes False (term-children term)))
  task-callable :: TypingContext -> List TaskLocal -> List UType -> Bool -> Span -> CoreTerm -> TaskTrace
  task-callable context env scopes spawning site callback = case callback of
    CLambda sp ty p body -> let free = task-free (task-pattern-ids p) body in
      let inside = task-trace context (task-pattern-env p Nil False env) scopes True body in
      let valid-capture = not spawning || (task-free-sharing context free && task-types-property context True Nil 64 (task-free-evidence Nil body)) in
      let capture-error = require-task valid-capture sp "a task capture crosses the task boundary without shareable evidence" in
      let failure = first-task-error (pattern-usage-error context sp ty p body)
        (first-task-error (task-pattern-use-error p body) (first-task-error (task-trace-error inside) capture-error)) in
      TaskTrace failure (task-trace-regions inside) (task-trace-shared inside)
    other -> let checked = task-trace context env scopes False callback in
      let capture-error = require-task (not spawning || task-trace-shared checked) site "a task callback crosses the task boundary without shareable evidence" in
      let failure = first-task-error (task-trace-error checked) capture-error in
      task-result-trace context (case scope-callback-parts (core-type callback) of Some (owner, region, row, result) -> result; None -> case task-body-parts (core-type callback) of Some (error, value, row) -> task-result-type error value; None -> UError)
        (TaskTrace failure (task-trace-regions checked <> task-regions (core-type callback)) (task-trace-shared checked))
  task-trace :: TypingContext -> List TaskLocal -> List UType -> Bool -> CoreTerm -> TaskTrace
  task-trace context env scopes consuming term =
    if task-handle-type (core-type term) && not consuming then
      TaskTrace (task-use-error (case term of CLocal sp ty id name actuals -> sp; CSpawn sp ty token body -> sp; other -> Span 0 0 1 1)) Nil False
    else case term of
      CLocal sp ty id name actuals -> (case task-local id env of Some (TaskLocal key declared regions shared) -> TaskTrace None regions shared; None -> TaskTrace None Nil False)
      CScope sp ty region evidence callback -> let inside = task-callable context env (Cons region scopes) False sp callback in
        let escape = require-task (not (task-region-present region (task-trace-regions inside))) sp "region escape: a scoped capture leaves its `withScope`" in
        let failure = first-task-error (task-trace-error inside) escape in
        TaskTrace failure (task-trace-regions inside) (task-trace-shared inside)
      CSpawn sp ty token callback -> task-spawn-trace context env scopes sp token callback
      CJoin sp ty token handles -> let scope-value = task-trace context env scopes False token in
        let consumed = task-trace-list context env scopes True (case handles of CArgument sp first rest -> task-argument-values handles; other -> Nil) in
        task-result-trace context ty (task-traces-merge scope-value consumed)
      CPrimitive sp ty op args -> let checked = task-trace context env scopes False args in
        if same op "copy-out" && not (copy-out-checked context ty args) then
          TaskTrace (Some (sp, string-concat "copyOut requires structural Copy evidence for " (type-text ty))) Nil False
        else task-result-trace context ty checked
      CLambda sp ty p body -> let free = task-free (task-pattern-ids p) body in
        let inside = task-trace context (task-pattern-env p Nil False env) scopes True body in
        let escape = require-task (task-free-scopes env free) sp "region escape: a closure captures a value from a structured scope" in
        let failure = first-task-error (pattern-usage-error context sp ty p body)
          (first-task-error (task-pattern-use-error p body) (first-task-error escape (task-trace-error inside))) in
        TaskTrace failure (task-free-regions env free <> task-active-regions scopes (task-capture-types (task-free-evidence Nil body))) (task-free-sharing context free && task-types-property context True Nil 64 (task-free-evidence Nil body))
      CLet sp ty id name sc rhs body -> let value = task-trace context env scopes True rhs in
        let result = task-trace context (Cons (TaskLocal id (scheme-body sc) (task-trace-regions value) (task-trace-shared value)) env) scopes consuming body in
        let failure = first-task-error (task-bound-error sp id (scheme-body sc) body) (first-task-error (task-trace-error value) (task-trace-error result)) in
        TaskTrace failure (task-trace-regions result) (task-trace-shared result)
      CApply sp ty f x -> task-call-trace context env scopes sp ty f x
      CApplyEff sp ty row f x -> task-call-trace context env scopes sp ty f x
      CIf sp ty condition yes no -> let test = task-trace context env scopes False condition in
        let result = task-traces-merge (task-trace context env scopes consuming yes) (task-trace context env scopes consuming no) in
        TaskTrace (first-task-error (task-trace-error test) (task-trace-error result)) (task-trace-regions result) (task-trace-shared result)
      CCase sp ty value alts -> let input = task-trace context env scopes False value in
        let result = task-alternatives-trace context env scopes consuming input alts in
        TaskTrace (first-task-error (task-trace-error input) (task-trace-error result)) (task-trace-regions result) (task-trace-shared result)
      CUse sp ty name role actuals -> task-global-trace context env scopes sp ty term Nil
      CQualifiedUse sp ty name role actuals evidence -> task-global-trace context env scopes sp ty term evidence
      CMethod sp ty name owner slot actuals evidence -> task-result-trace context ty (task-traces-merge (TaskTrace None (task-evidences-regions evidence) True) (task-trace-list context env scopes False (term-children term)))
      CWith sp ty given value body -> let supplied = task-trace context env scopes False value in
        let result = task-trace context env scopes consuming body in
        TaskTrace (first-task-error (task-trace-error supplied) (task-trace-error result)) (task-trace-regions result) (task-trace-shared result)
      other -> task-result-trace context (core-type term) (task-trace-list context env scopes False (term-children term))
  task-spawn-trace :: TypingContext -> List TaskLocal -> List UType -> Span -> CoreTerm -> CoreTerm -> TaskTrace
  task-spawn-trace context env scopes sp token callback = let scope-value = task-trace context env scopes False token in
    let inside = task-callable context env scopes True sp callback in
    let regions = (case callback of CLambda at ft p body -> task-free-regions env (task-free (task-pattern-ids p) body) <> task-capture-types (task-free-evidence Nil body); other -> task-trace-regions (task-trace context env scopes False callback)) in
    let lifetime = case scope-parameters (core-type token) of Some (owner, destination) -> task-capture-regions scopes owner destination regions; None -> False in
    let escape = require-task lifetime sp "region escape: a task capture does not outlive the destination scope" in
    let failure = first-task-error (task-trace-error scope-value) (first-task-error (task-trace-error inside) escape) in
    TaskTrace failure (task-trace-regions inside) True
  task-call-trace :: TypingContext -> List TaskLocal -> List UType -> Span -> UType -> CoreTerm -> CoreTerm -> TaskTrace
  task-call-trace context env scopes sp result f x = case task-forwarded-scope context f of
    Some token -> task-spawn-trace context env scopes sp token x
    None -> let function = task-trace context env scopes False f in
      let input = task-trace context env scopes False x in
      task-result-trace context result (TaskTrace (first-task-error (task-trace-error function) (task-trace-error input))
        (task-trace-regions function <> task-trace-regions input <> task-regions (core-type x))
        (task-trace-shared function && task-trace-shared input && task-shareable context Nil 64 (core-type x)))
  task-argument-values :: CoreTerm -> List CoreTerm
  task-argument-values terms = case terms of CArgumentsEnd sp -> Nil; CArgument sp first rest -> Cons first (task-argument-values rest); other -> Nil
  task-alternatives-trace :: TypingContext -> List TaskLocal -> List UType -> Bool -> TaskTrace -> CoreTerm -> TaskTrace
  task-alternatives-trace context env scopes consuming input alts = case alts of
    CAlternativesEnd sp -> TaskTrace None Nil True
    CAlternative sp p body rest ->
      let inside = task-trace context (task-pattern-env p (task-trace-regions input) (task-trace-shared input) env) scopes consuming body in
      let failure = first-task-error (task-pattern-use-error p body) (task-trace-error inside) in
      task-traces-merge (TaskTrace failure (task-trace-regions inside) (task-trace-shared inside)) (task-alternatives-trace context env scopes consuming input rest)
    other -> TaskTrace (Some (Span 0 0 1 1, "malformed task case alternatives")) Nil False
  task-code-present :: TypingContext -> CoreTerm -> Bool
  task-code-present context term = annotated-arrow (core-type term) || task-scoped-type (core-type term) || affine-thunk (core-type term) || (case term of
    CScope sp ty region evidence callback -> True
    CSpawn sp ty token callback -> True
    CJoin sp ty token handles -> True
    CPrimitive sp ty op args -> has op ["copy-out", "thunk-force", "thunk-delay"] || task-code-present context args
    CUse sp ty name role actuals -> task-reference-forwarder context term || task-code-list context (term-children term)
    CQualifiedUse sp ty name role actuals evidence -> task-reference-forwarder context term || task-code-list context (term-children term)
    other -> task-code-list context (term-children term))
  task-code-list :: TypingContext -> List CoreTerm -> Bool
  task-code-list context terms = case terms of Nil -> False; Cons first rest -> task-code-present context first || task-code-list context rest
  task-pattern-error :: TypingContext -> List TaskLocal -> Span -> List CorePattern -> CoreTerm -> Option (Span, String)
  task-pattern-error context env sp patterns body = case patterns of
    Nil -> task-trace-error (task-trace context env Nil True body)
    Cons p rest -> first-task-error (task-pattern-use-error p body) (task-pattern-error context (task-pattern-env p Nil False env) sp rest body)
  task-definition-safe :: TypingContext -> CoreDefinition -> Bool
  task-definition-safe context d = case task-definition-error context d of None -> True; Some error -> False
  task-definition-error :: TypingContext -> CoreDefinition -> Option (Span, String)
  task-definition-error context d =
    let declared = scheme-body (core-scheme d) in
    let clauses = core-clauses d in
    case (if has-annotated-parameter declared then usage-equations-error context (substitute-bound (core-openings d) declared) clauses else None) of
      Some error -> Some error
      None -> if context-task-forwarder context (core-name d) && task-source-forwarder d then None
        else task-clauses-error context (opening-value-patterns (Span 0 0 1 1) (core-openings d)) clauses
  task-clauses-error :: TypingContext -> List CorePattern -> List CoreClause -> Option (Span, String)
  task-clauses-error context prefix clauses = case clauses of
    Nil -> None
    Cons (MkCoreClause sp patterns body) rest -> let bound = prefix <> patterns in
      let failure = if task-code-present context body || task-patterns-present bound then task-pattern-error context Nil sp bound body else None in
      case failure of Some error -> failure; None -> task-clauses-error context prefix rest
  task-patterns-present :: List CorePattern -> Bool
  task-patterns-present patterns = case patterns of Nil -> False; Cons p rest -> task-scoped-type (pattern-type p) || task-patterns-present rest
  checked-spawn :: UType -> CoreTerm -> CoreTerm -> Bool
  checked-spawn expected token body = case (scope-parameters (core-type token), task-body-parts (core-type body)) of
    (Some (owner, region), Some (error, value, row)) -> equal-type expected (task-type region error value)
    other -> False
  checked-scope :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> UType -> CoreEvidence -> CoreTerm -> Bool
  checked-scope context scope gamma facts expected region evidence callback = case (region, scope-callback-parts (core-type callback)) of
    (URigid id name level KRegion, Some (owner, bound, row, result)) -> equal-type region bound && equal-type expected result
      && scope-region-closed region expected && scope-region-closed region row
      && evidence-types context scope evidence && equal-type (evidence-type evidence) (UApp (UCon "b.Io" (KFun KRegion KType)) owner)
      && (case add-rigid-kind id KRegion scope of Some opened -> checked-term context opened gamma facts callback; None -> False)
    other -> False
  effect-for-label :: UType -> List CoreEffect -> Option CoreEffect
  effect-for-label label declarations = case declarations of
    Nil -> None
    Cons declaration rest -> case handler-label-name label of
      Some name -> if same name (core-effect-name declaration) then Some declaration else effect-for-label label rest
      None -> None
  handler-label-name :: UType -> Option String
  handler-label-name label = case label of UCon name kind -> Some name; UApp f x -> handler-label-name f; other -> None
  handler-openings-match :: List Quant -> List (Nat, UType) -> List (Nat, UType) -> Bool
  handler-openings-match qs entries prior = case (qs, entries) of
    (Nil, Nil) -> True
    (Cons q rest, Cons (key, URigid id name level kind) more) -> key == quant-id q
      && kind-equal kind (map-kind-types (substitute-bound prior) (quant-kind q))
      && handler-openings-match rest more (Cons (key, URigid id name level kind) prior)
    other -> False
  handler-return-row :: UType -> Option UType
  handler-return-row ty = case ty of UFun a b -> Some empty-row; UFunEff a row b -> Some row; other -> None
  handler-operation-rows :: CoreTerm -> UType
  handler-operation-rows operations = case operations of
    CHandlerEnd sp -> empty-row
    CHandlerOperation sp slot openings row closure rest -> union-effects row (handler-operation-rows rest)
    other -> UError
  handler-operations-typed :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> CoreEffect -> UType -> UType -> List CoreOperation -> CoreTerm -> Bool
  handler-operations-typed context scope gamma facts declaration label output expected operations = case (expected, operations) of
    (Nil, CHandlerEnd sp) -> True
    (Cons operation more, CHandlerOperation sp slot openings row closure rest) -> slot == core-operation-slot operation
      && (case handler-operation-scheme declaration label operation of
        Some sc -> handler-openings-match (scheme-params sc) openings Nil
          && (case openings-scope context scope openings of
            Some opened -> let actual = substitute-bound openings (scheme-body sc) in
              wf context opened row && equal-type (handler-clause-type actual output row) (core-type closure)
                && checked-term context opened gamma facts closure && handler-resumption-safe actual closure
            None -> False)
        None -> False)
      && handler-operations-typed context scope gamma facts declaration label output more rest
    other -> False
  checked-handler :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> CoreTerm -> CoreTerm -> Bool
  checked-handler context scope gamma facts ty returned operations = case (handler-parts ty, handler-return-row (core-type returned)) of
    (Some (label, input, output, row), Some returned-row) ->
      wf context scope label && wf context scope input && wf context scope output && wf context scope row
      && equal-type (UFunEff input returned-row output) (core-type returned)
      && checked-term context scope gamma facts returned
      && equal-type row (union-effects returned-row (handler-operation-rows operations))
      && (case effect-for-label label (context-effects context) of
        Some declaration -> handler-operations-typed context scope gamma facts declaration label output (core-effect-operations declaration) operations
        None -> False)
    other -> False
  handler-operation-names :: List CoreOperation -> List String
  handler-operation-names operations = case operations of Nil -> Nil; Cons first rest -> Cons (core-operation-name first) (handler-operation-names rest)
  checked-handle :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> UType -> UType -> CoreTerm -> CoreTerm -> Bool
  checked-handle context scope gamma facts ty label residual body handled-by = wf context scope label && wf context scope residual
    && checked-term context scope gamma facts body && checked-term context scope gamma facts handled-by
    && (case effect-for-label label (context-effects context) of Some declaration -> handler-body-direct label (handler-operation-names (core-effect-operations declaration)) body; None -> False)
    && (case handler-parts (core-type handled-by) of
      Some (declared, input, output, row) -> equal-type label declared && equal-type input (core-type body) && equal-type output ty
        && (case handler-residual label (core-effects body) of Some actual -> equal-type actual residual; None -> False)
      None -> False)
  checked-let :: TypingContext -> TypeScope -> ProofScope -> List Proposition -> UType -> Nat -> Scheme -> CoreTerm -> CoreTerm -> Bool
  checked-let context scope gamma facts ty id sc rhs body = body-scheme-authorized (context-bodies context) sc && scheme-well-formed (context-kinds context) scope sc
    && not (volatile-borrow-index (scheme-body sc)) && (case scheme-requirements sc of Nil -> True; other -> False)
    && equal-type (scheme-body sc) (core-type rhs) && equal-type ty (core-type body)
    && (case scheme-type-scope (context-kinds context) scope (scheme-params sc) of Some universal -> checked-term context universal gamma facts rhs; None -> False)
    && (case add-local-scheme id sc scope of
      Some bound -> let writes = core-mutable-writes rhs in
        let next = proof-after-writes (scope-let gamma facts id sc rhs) writes in
        let more = case scoped-core-let-fact gamma facts id sc rhs of Some p -> Cons p facts; None -> facts in
        checked-term context bound next (facts-after-writes gamma more writes) body
      None -> False)
  openings-scope :: TypingContext -> TypeScope -> List (Nat, UType) -> Option TypeScope
  openings-scope context scope openings = case openings of
    Nil -> Some scope
    Cons (key, URigid id name level kind) rest -> if body-kind-authorized (context-bodies context) kind && kind-well-formed (context-kinds context) scope kind then
      (case add-rigid-kind id kind scope of Some bound -> openings-scope context bound rest; None -> None) else None
    Cons (key, UIndex carrier (IRigid id name level)) rest -> if body-type-authorized (context-bodies context) carrier && wf context scope carrier then
      (case add-rigid-kind id (value-kind carrier) scope of Some bound -> openings-scope context bound rest; None -> None) else None
    other -> None
  private-scope :: TypeScope -> List (Nat, Kind) -> Option TypeScope
  private-scope scope entries = case entries of Nil -> Some scope; Cons (id, kind) rest -> case add-rigid-kind id kind scope of Some bound -> private-scope bound rest; None -> None
  private-kinds :: TypingContext -> TypeScope -> List (Nat, Kind) -> Bool
  private-kinds context scope entries = case entries of Nil -> True; Cons (id, kind) rest -> body-kind-authorized (context-bodies context) kind && kind-well-formed (context-kinds context) scope kind && private-kinds context scope rest
  givens-typed :: TypingContext -> TypeScope -> List CoreGiven -> Bool
  givens-typed context scope givens = case givens of Nil -> True; Cons given rest -> wf context scope (given-type given) && givens-typed context scope rest
  clause-typed :: TypingContext -> TypeScope -> ProofScope -> UType -> UType -> List CorePattern -> CoreTerm -> Bool
  clause-typed context scope gamma expected allowed patterns body = case patterns of
    Nil -> equal-type expected (core-type body) && checked-term context scope gamma Nil body && effects-fit (core-effects body) allowed
    Cons pattern rest -> effects-fit allowed empty-row && (case (arrow-domain expected, pattern-result expected pattern) of
      (Some (domain, row), Some result) -> pattern-usage-allowed context expected pattern body
        && (case pattern-scope context scope domain pattern of Some bound -> clause-typed context bound (proof-pattern pattern gamma) result row rest body; None -> False)
      other -> False)
  value-parameters-scope :: TypeScope -> List (Nat, UType) -> Option TypeScope
  value-parameters-scope scope values = case values of
    Nil -> Some scope
    Cons (id, carrier) rest -> (case add-value-parameter id carrier scope of Some next -> value-parameters-scope next rest; None -> None)
  clauses-typed :: TypingContext -> TypeScope -> UType -> List CoreClause -> Bool
  clauses-typed context scope expected clauses = clauses-typed-with context scope Nil expected clauses
  clauses-typed-with :: TypingContext -> TypeScope -> List (Nat, UType) -> UType -> List CoreClause -> Bool
  clauses-typed-with context scope values expected clauses = case clauses of
    Nil -> True
    Cons (MkCoreClause sp patterns body) rest -> clause-typed context scope (with-guarded-bindings (context-guarded-bodies context) (with-checked-body-bindings (context-body-context context) (make-proof-scope values Nil))) expected empty-row patterns body && clauses-typed-with context scope values expected rest
  typing-definition-closed :: TypingContext -> CoreDefinition -> Bool
  typing-definition-closed context definition = (case context of CheckedTypingContext kinds globals effects datas forwarders -> global-definition-closed globals definition)
    && core-definition-checked-contracts-closed (context-body-context context) (context-guarded-bodies context) definition
    && task-definition-safe context definition
    && (case openings-scope context empty-type-scope (core-openings definition) of
      Some opened -> (case private-scope opened (core-private-types definition) of
        Some scope -> private-kinds context scope (core-private-types definition) && givens-typed context scope (core-givens definition)
          && (case value-parameters-scope scope (opening-value-types (core-openings definition)) of
            Some values -> clauses-typed-with context values (opening-value-types (core-openings definition)) (substitute-bound (core-openings definition) (scheme-body (core-scheme definition))) (core-clauses definition)
            None -> False)
        None -> False)
      None -> False)
