-- Checked physical library objects. Source visibility still comes exclusively
-- from the independently loaded interface set, never from this unit inventory.
module Bootstrap.Object where
  import Bootstrap.Load (LoadedInterface, ImportedValue, loaded-module, loaded-hash, loaded-contract, load-object-interfaces-with-known, loaded-values, imported-symbol)
  import Bootstrap.Interface (fnv-source-hash, sha256-hex)
  import Bootstrap.RuntimeAbi (runtime-abi-int)
  import Bootstrap.Builtin (scalar-intrinsic)
  import Bootstrap.Infer (scalar-interface-contract-matches)
  import Bootstrap.Nominal (interface-global, global-data-string-string)
  import Data.Json
  import Data.Nat (nat-from-int)
  import Text.Json (parse-json, canonical-bytes)
  import Text.Parse (ParseOutcome, Parsed, Failed)
  import Algebra.Semigroup
  import Data.Path (path-from-string)
  import Effect.Fs (fs-read)

  export RuntimeObject, RuntimeUnit, parse-runtime-object, read-runtime-object
  export read-runtime-object-document, read-runtime-object-mode, admit-runtime-object-mode
  export RuntimeObjectConfig, read-runtime-object-config, runtime-object-input-files, admit-runtime-object
  export object-unit, unit-symbol, unit-closure, unit-params, unit-result
  export read-object-unit-roots
  export llvm-object-symbol
  export object-variant, object-dictionary, object-family, object-conditional-unit, object-closed-method-unit
  export object-string-layout, llvm-data-bytes

  data RuntimeUnit where
    RuntimeUnit :: String -> String -> String -> List Nat -> Option Nat -> RuntimeUnit
  data RuntimeObject where
    RuntimeObject :: List RuntimeUnit -> List String -> List String -> Json -> Json -> Json -> RuntimeObject
  unit-symbol :: RuntimeUnit -> String
  unit-symbol value = case value of RuntimeUnit name key closure params result -> name
  unit-key :: RuntimeUnit -> String
  unit-key value = case value of RuntimeUnit name key closure params result -> key
  unit-closure :: RuntimeUnit -> String
  unit-closure value = case value of RuntimeUnit name key closure params result -> closure
  unit-params :: RuntimeUnit -> List Nat
  unit-params value = case value of RuntimeUnit name key closure params result -> params
  unit-result :: RuntimeUnit -> Option Nat
  unit-result value = case value of RuntimeUnit name key closure params result -> result
  same :: String -> String -> Bool
  same a b = string-compare a b == 0
  field :: String -> Json -> Json
  field name doc = case doc of JObj key value rest -> if same name key then value else field name rest; other -> JNull
  has :: String -> List String -> Bool
  has name names = case names of Nil -> False; Cons first rest -> same name first || has name rest
  find-unit :: String -> List RuntimeUnit -> Option RuntimeUnit
  find-unit name units = case units of
    Nil -> None
    Cons first rest -> if same name (unit-key first) then Some first else find-unit name rest
  -- Inventory membership is insufficient: require an actual loaded value
  -- export as well. Private helpers and dictionary workers do not bind names.
  object-unit :: String -> RuntimeObject -> Option RuntimeUnit
  object-unit name value = object-variant name Nil value
  -- The variant suffix in the identity spelling: `@` is the one escaped
  -- character and the class letters are plain, so appending the suffix to an
  -- encoded name is the encoding of the concatenation, character for
  -- character. Escaping `R`, `O` and `T` as if they needed it produced a
  -- spelling no producer writes, and every non-empty variant lookup missed.
  encoded-classes :: List Nat -> String
  encoded-classes codes = case codes of Nil -> ""; Cons code rest -> (if code == 0 then "R" else if code == 1 then "O" else if code == 2 then "T" else "W") <> encoded-classes rest
  encoded-variant :: List Nat -> String
  encoded-variant codes = case codes of Nil -> ""; other -> "$40" <> encoded-classes codes
  object-variant :: String -> List Nat -> RuntimeObject -> Option RuntimeUnit
  object-variant name codes value = case value of
    RuntimeObject units exports instances dictionaries families constructors -> if has name exports then find-unit (name <> encoded-variant codes) units else None
  instance-symbols :: Json -> List String
  instance-symbols rows = case rows of
    JArr row rest -> (case field "id" row of JStr name -> Cons (interface-global name) (instance-symbols rest); other -> instance-symbols rest)
    other -> Nil
  exported-instances :: List LoadedInterface -> List String
  exported-instances interfaces = case interfaces of
    Nil -> Nil
    Cons first rest -> instance-symbols (field "instances" (field "exports" (loaded-contract first))) <> exported-instances rest
  dictionary-row :: String -> Json -> Option (String, Json)
  dictionary-row name rows = case rows of
    JObj key value rest -> if same name key then Some (key, value) else dictionary-row name rest
    other -> None
  -- Factory workers do not bind ordinary source values. Their authority is
  -- a checked instance export and its actual selected native inventory row.
  object-dictionary :: String -> List Nat -> RuntimeObject -> Option (RuntimeUnit, String, Nat, List Nat)
  object-dictionary name codes value = case value of
    RuntimeObject units exports instances dictionaries families constructors -> if not (has name instances) then None else
      (case dictionary-row (name <> encoded-variant codes) dictionaries of
        Some (key, row) -> (case (field "class" row, field "context_arity" row, classes (field "fields" row), find-unit (key <> "$2emk") units) of
          (JStr owner, JNum count, Some fields, Some unit) -> if count < 0 then None else Some (unit, interface-global owner, nat-from-int count, fields)
          other -> None)
        None -> None)
  conditional-method-at :: Nat -> Json -> Option String
  conditional-method-at index rows = case rows of
    JArr (JStr name) rest -> if index == 0 then Some name else conditional-method-at (index - 1) rest
    other -> None
  -- A closed conditional method is callable through its actual exported
  -- instance and checked declaring slot, never through ordinary value scope.
  object-conditional-unit :: String -> String -> Nat -> String -> List Nat -> RuntimeObject -> Option RuntimeUnit
  object-conditional-unit owner dictionary slot name codes value = case (codes, value) of
    (Nil, RuntimeObject units exports instances dictionaries families constructors) -> if not (has dictionary instances) then None else
      (case dictionary-row dictionary dictionaries of
        Some (key, row) -> (case (field "class" row, field "context_arity" row, conditional-method-at slot (field "methods" row)) of
          (JStr actual-owner, JNum 0, Some method) -> if same owner (interface-global actual-owner) && same name (interface-global method) then find-unit name units else None
          other -> None)
        None -> None)
    other -> None
  -- A closed factory containing only actual function workers has no
  -- strict value initialization to preserve. Select its private worker
  -- through the exported instance and exact declaring slot, never as an
  -- ordinary value export. A zero-argument worker is a strict value and
  -- keeps the normal dictionary construction path.
  closed-function-fields :: List RuntimeUnit -> List Nat -> Json -> Bool
  closed-function-fields units fields methods = case (fields, methods) of
    (Nil, JArrEnd) -> True
    (Cons 1 rest, JArr (JStr name) more) -> (case find-unit (interface-global name) units of
      Some unit -> (case unit-params unit of Nil -> False; other -> True) && closed-function-fields units rest more
      None -> False)
    other -> False
  object-closed-method-unit :: String -> String -> Nat -> RuntimeObject -> Option RuntimeUnit
  object-closed-method-unit owner factory slot value = case value of
    RuntimeObject units exports instances dictionaries families constructors -> if not (has factory instances) then None else
      (case dictionary-row factory dictionaries of
        Some (key, row) -> (case (field "class" row, field "context_arity" row, classes (field "fields" row)) of
          (JStr actual-owner, JNum 0, Some fields) -> if not (same owner (interface-global actual-owner) && closed-function-fields units fields (field "methods" row)) then None else
            (case conditional-method-at slot (field "methods" row) of
              Some method -> find-unit (interface-global method) units
              None -> None)
          other -> None)
        None -> None)
  own-classes :: String -> Nat -> Option (List Nat)
  own-classes text index = let bytes = string-to-bytes text in if index < bytes-len bytes then
    (let byte = bytes-get bytes index in if byte /= 82 && byte /= 79 && byte /= 84 && byte /= 87 then None else
      case own-classes text (index + 1) of Some rest -> Some (Cons (if byte == 82 then 0 else if byte == 79 then 1 else if byte == 84 then 2 else 3) rest); None -> None)
    else if index == bytes-len bytes then Some Nil else None
  root-row-fields :: Json -> Bool
  root-row-fields row = case row of
    JObjEnd -> True
    JObj key value rest -> (same key "symbol" || same key "classes") && root-row-fields rest
    other -> False
  unit-root-rows :: Json -> Result String (List (String, List Nat))
  unit-root-rows rows = case rows of
    JArrEnd -> Ok Nil
    JArr row rest -> (case (field "symbol" row, field "classes" row) of
      (JStr name, JStr letters) -> if not (root-row-fields row) then Err "unknown object root field" else
        (case (own-classes letters 0, unit-root-rows rest) of
          (Some codes, Ok more) -> Ok (Cons (name, codes) more)
          (None, other) -> Err "object root vectors contain only R/O/T/W"
          (other, Err message) -> Err message)
      other -> Err "object unit root requires a symbol and classes")
    other -> Err "object unit roots must be an array"
  unit-root-fields :: Json -> Result String (List (String, List Nat))
  unit-root-fields doc = case doc of
    JObjEnd -> Ok Nil
    JObj key value rest -> case unit-root-fields rest of
      Err message -> Err message
      Ok more -> if same key "schema" then Ok more
        else if same key "units" then (case unit-root-rows value of Ok rows -> Ok (rows <> more); Err message -> Err message)
        else if same key "dictionaries" || same key "methods" then
          (case value of JArrEnd -> Ok more; other -> Err "explicit dictionary and method specialization roots are not implemented")
        else Err "unknown object roots field"
    other -> Err "object roots must be a JSON object"
  read-object-unit-roots :: forall r. using (io :: Io r) => String ->{IO r} Result String (List (String, List Nat))
  read-object-unit-roots path = case fs-read (path-from-string path) of
    Err error -> Err "cannot read object roots"
    Ok bytes -> case parse-json path bytes of
      Parsed doc Nil -> (case field "schema" doc of JNum 1 -> unit-root-fields doc; other -> Err "object roots require schema 1")
      other -> Err "object roots are not valid JSON"

  family-slots :: Json -> Nat -> Nat -> Option (List (Nat, Nat, List Nat))
  family-slots rows declared next = case rows of
    JArr row rest -> (case (field "logical" row, field "physical" row, field "own" row) of
      (JNum logical, JNum physical, JStr text) -> if logical < 0 || nat-from-int logical >= declared || physical /= nat-to-int next then None else
        (case (own-classes text 0, family-slots rest declared (next + 1)) of
          (Some codes, Some more) -> Some (Cons (nat-from-int logical, next, codes) more)
          other -> None)
      other -> None)
    JArrEnd -> Some Nil
    other -> None
  find-family :: String -> Json -> Option (Nat, List (Nat, Nat, List Nat))
  find-family owner rows = case rows of
    JArr row rest -> (case (field "class" row, field "declared_methods" row) of
      (JStr name, JNum count) -> if not (same owner name) then find-family owner rest else
        if count < 0 then None else case family-slots (field "slots" row) (nat-from-int count) 0 of
          Some slots -> Some (nat-from-int count, slots)
          None -> None
      other -> None)
    other -> None
  object-family :: String -> RuntimeObject -> Option (Nat, List (Nat, Nat, List Nat))
  object-family owner value = case value of RuntimeObject units exports instances dictionaries families constructors -> find-family owner families
  -- Runtime String is the defining library's private one-Bytes wrapper.
  -- Check its actual description: an inline tag 0 whose one field (the
  -- Bytes) is counted, header layout field 256. This does not bind StrBuf
  -- in source.
  object-string-layout :: String -> RuntimeObject -> Option Nat
  object-string-layout name value = case value of
    RuntimeObject units exports instances dictionaries families constructors -> if not (same name (global-data-string-string)) then None else
      (case (field "descriptor" (field "Data.String.StrBuf" constructors), field "escaped" (field "Data.String.StrBuf" constructors), field "arity" (field "Data.String.StrBuf" constructors), field "tag" (field "Data.String.StrBuf" constructors)) of
        (JNum descriptor, JBool False, JNum 1, JNum 0) -> if descriptor == 256 then Some (nat-from-int descriptor) else None
        other -> None)
  class-code :: Json -> Option Nat
  class-code doc = case doc of
    -- `W` is the wide scalars' class (design/wide-scalars.md): never counted,
    -- two payload words, an `i128` at a call.
    JStr name -> if same name "R" then Some 0 else if same name "O" then Some 1 else if same name "T" then Some 2 else if same name "W" then Some 3 else None

    other -> None
  classes :: Json -> Option (List Nat)
  classes doc = case doc of
    JArr first rest -> (case (class-code first, classes rest) of (Some code, Some more) -> Some (Cons code more); other -> None)
    JArrEnd -> Some Nil
    other -> None
  units :: Json -> List String -> Result String (List RuntimeUnit)
  units doc seen = case doc of
    JArr row rest -> (case (field "symbol" row, field "closure_entry" row, field "arity" row, classes (field "params" row)) of
      (JStr name, JStr closure, JNum arity, Some params) -> if string-length name == 0 || not (same closure (name <> ".object-closure")) || has name seen || arity < 0 || nat-from-int arity /= list-length params then Err "invalid or duplicate runtime object unit" else
        (case (field "result" row, class-code (field "result" row)) of
          (JNull, other) -> add-unit name closure params None rest seen
          (other, Some result) -> add-unit name closure params (Some result) rest seen
          other -> Err "invalid runtime object result class")
      other -> Err "malformed runtime object unit")
    JArrEnd -> Ok Nil
    other -> Err "malformed runtime object units"
  add-unit :: String -> String -> List Nat -> Option Nat -> Json -> List String -> Result String (List RuntimeUnit)
  add-unit name closure params result rest seen = case units rest (Cons name seen) of
    Err message -> Err message
    Ok more -> Ok (Cons (RuntimeUnit name (interface-global name) closure params result) more)
  -- Canonical names are encoded once at admission. Re-encoding the entire
  -- inventory on every call repeatedly scans UTF-8 strings in large builds.
  encode-dictionary-keys :: Json -> Json
  encode-dictionary-keys rows = case rows of
    JObj key value rest -> JObj (interface-global key) value (encode-dictionary-keys rest)
    other -> other
  encode-family-row :: Json -> Json
  encode-family-row row = case row of
    JObj key (JStr value) rest -> JObj key (JStr (if same key "class" then interface-global value else value)) (encode-family-row rest)
    JObj key value rest -> JObj key value (encode-family-row rest)
    other -> other
  encode-families :: Json -> Json
  encode-families rows = case rows of JArr row rest -> JArr (encode-family-row row) (encode-families rest); other -> other
  -- The contracts the object carries, as the documents it already parsed:
  -- canonicalising each one and parsing it back derived nothing the document
  -- does not state, and the load derives its identity from the document
  -- itself (`load-interface-from-document`).
  interface-files :: Json -> Result String (List (String, String, Json))
  interface-files doc = case doc of
    JArr row rest -> (case (field "module" row, field "iface_hash" row, field "interface" row) of
      (JStr name, JStr hash, JObj key value tail) -> (case interface-files rest of
        Err message -> Err message
        Ok more -> Ok (Cons (name, hash, field "interface" row) more))
      other -> Err "malformed object interface closure")
    JArrEnd -> Ok Nil
    other -> Err "missing object interface closure"
  -- A C import has no implementation in the Cinch provider object. Permit
  -- separately admitted foreign-only contracts, including facade aliases,
  -- while retaining exact object identities for every represented module.
  -- This only classifies physical dependencies: Infer independently checks
  -- the defining foreign scheme, effects and complete ABI before any call.
  foreign-symbol-row :: String -> String -> Json -> Bool
  foreign-symbol-row symbol owner rows = case rows of
    JArr row rest -> (case (field "symbol" row, field "kind" row, field "abi" row, field "external" row) of
      (JStr name, JStr direction, JStr abi, JStr external) ->
        (same symbol (owner <> "." <> name) && same direction "import" && same abi "ccall" && string-length external > 0) || foreign-symbol-row symbol owner rest
      other -> foreign-symbol-row symbol owner rest)
    other -> False
  foreign-symbol :: String -> List LoadedInterface -> Bool
  foreign-symbol symbol interfaces = case interfaces of
    Nil -> False
    Cons first rest -> foreign-symbol-row symbol (loaded-module first) (field "foreign" (field "exports" (loaded-contract first))) || foreign-symbol symbol rest
  foreign-values-only :: Json -> List LoadedInterface -> Bool
  foreign-values-only rows interfaces = case rows of
    JArr row rest -> (case (field "symbol" row, field "resolved" row, field "total_body" row) of
      (JStr symbol, JNull, JNull) -> foreign-symbol symbol interfaces && foreign-values-only rest interfaces
      other -> False)
    JArrEnd -> True
    other -> False
  opaque-types-only :: Json -> Bool
  opaque-types-only rows = case rows of
    JArr row rest -> (case (field "kind" row, field "ctors" row, field "fields" row, field "refinement" row) of
      (JStr kind, JArrEnd, JArrEnd, JNull) -> same kind "opaque" && opaque-types-only rest
      other -> False)
    JArrEnd -> True
    other -> False
  foreign-interface-only :: LoadedInterface -> List LoadedInterface -> Bool
  foreign-interface-only wanted interfaces = let exports = field "exports" (loaded-contract wanted) in
    case (field "instances" exports, field "signatures" exports) of
      (JArrEnd, JArrEnd) -> opaque-types-only (field "types" exports) && foreign-values-only (field "values" exports) interfaces
      other -> False
  -- | Ignore only the local alias spelling when comparing an exact represented value contract.
  scalar-reexport-contract :: Json -> Json
  scalar-reexport-contract row = case row of
    JObj key value rest -> if same key "name" then scalar-reexport-contract rest
      else JObj key value (scalar-reexport-contract rest)
    other -> other
  -- | Find a pure supported scalar declaration under its exact represented defining identity.
  scalar-reexport-foreign :: String -> Json -> String -> Json -> Bool
  scalar-reexport-foreign identity value owner rows = case rows of
    JArr row rest -> (case (field "symbol" row, field "kind" row, field "abi" row, field "effects" row, field "type" row, field "external" row) of
      (JStr local, JStr category, JStr abi, JStr effects, JStr actual, JStr opcode) ->
        (same identity (owner <> "." <> local) && same category "intrinsic" && same abi "ccall" && same effects ""
          && scalar-interface-contract-matches value row && (case scalar-intrinsic opcode of Some operation -> True; None -> False))
          || scalar-reexport-foreign identity value owner rest
      other -> scalar-reexport-foreign identity value owner rest)
    other -> False
  -- | Match every non-name field against an actual value in the same represented defining module.
  scalar-reexport-row :: Json -> LoadedInterface -> Json -> Bool
  scalar-reexport-row wanted defining rows = case rows of
    JArr row rest ->
      (case (field "symbol" row, field "scheme" row, field "resolved" row, field "total_body" row) of
        (JStr identity, JStr scheme, JObj key value tail, JNull) ->
          bytes-compare (canonical-bytes (scalar-reexport-contract wanted)) (canonical-bytes (scalar-reexport-contract row)) == 0
            && scalar-reexport-foreign identity row (loaded-module defining) (field "foreign" (field "exports" (loaded-contract defining)))
        other -> False) || scalar-reexport-row wanted defining rest
    other -> False
  -- | Resolve a scalar alias only through the provider's already checked interface inventory.
  scalar-reexport-value :: Json -> List LoadedInterface -> Bool
  scalar-reexport-value wanted represented = case represented of
    Nil -> False
    Cons defining rest -> scalar-reexport-row wanted defining (field "values" (field "exports" (loaded-contract defining)))
      || scalar-reexport-value wanted rest
  -- | Require exact represented contracts for every scalar exported by a code-free facade.
  scalar-reexport-values :: Json -> List LoadedInterface -> Bool
  scalar-reexport-values rows represented = case rows of
    JArr row rest -> scalar-reexport-value row represented && scalar-reexport-values rest represented
    JArrEnd -> True
    other -> False
  -- | Admit only implementation-free scalar aliases; ordinary values and new defining contracts still require an object.
  scalar-reexport-only :: LoadedInterface -> List LoadedInterface -> Bool
  scalar-reexport-only wanted represented = let doc = loaded-contract wanted in let exports = field "exports" doc in
    case (field "types" exports, field "instances" exports, field "signatures" exports, field "foreign" exports, field "units" doc) of
      (JArrEnd, JArrEnd, JArrEnd, JArrEnd, JArrEnd) -> scalar-reexport-values (field "values" exports) represented
      other -> False
  -- | Preserve represented module hashes and separately classify code-free external aliases.
  matching-interface :: LoadedInterface -> List LoadedInterface -> List LoadedInterface -> Bool
  matching-interface wanted actual interfaces = matching-interface-provider wanted actual interfaces actual
  -- | Retain the complete represented inventory while searching for an exact module hash match.
  matching-interface-provider :: LoadedInterface -> List LoadedInterface -> List LoadedInterface -> List LoadedInterface -> Bool
  matching-interface-provider wanted remaining interfaces represented = case remaining of
    Nil -> foreign-interface-only wanted interfaces || scalar-reexport-only wanted represented
    Cons first rest -> if same (loaded-module wanted) (loaded-module first) then same (loaded-hash wanted) (loaded-hash first)
      else matching-interface-provider wanted rest interfaces represented
  matching-interfaces :: List LoadedInterface -> List LoadedInterface -> Bool
  matching-interfaces wanted actual = matching-interface-list wanted actual wanted
  matching-interface-list :: List LoadedInterface -> List LoadedInterface -> List LoadedInterface -> Bool
  matching-interface-list wanted actual interfaces = case wanted of Nil -> True; Cons first rest -> matching-interface first actual interfaces && matching-interface-list rest actual interfaces
  exported-symbols :: List LoadedInterface -> List String
  exported-symbols interfaces = case interfaces of
    Nil -> Nil
    Cons first rest -> value-symbols (loaded-values first) <> exported-symbols rest
  value-symbols :: List ImportedValue -> List String
  value-symbols values = case values of Nil -> Nil; Cons first rest -> Cons (interface-global (imported-symbol first)) (value-symbols rest)
  -- The runtime object a manifest document states. The caller parses the
  -- manifest once and passes the document on, because the same bytes are also
  -- the artifact it returns: parsing them a second time to recover them was
  -- one whole manifest parse per compile.
  parse-runtime-object :: String -> List LoadedInterface -> Bytes -> Json -> Result String RuntimeObject
  parse-runtime-object = parse-runtime-object-mode True
  parse-runtime-object-mode :: Bool -> String -> List LoadedInterface -> Bytes -> Json -> Result String RuntimeObject
  parse-runtime-object-mode reclaim expected-triple interfaces code doc =
    if not (case (field "schema" doc, field "runtime_abi" doc, field "word_size" doc, field "endian" doc, field "reclaim" doc, field "target" doc, field "self_describing" doc) of
      (JNum 1, JNum actual-abi, JNum bits, JStr endian, JBool counted, JStr actual, JBool True) -> counted == reclaim && actual-abi == runtime-abi-int && same endian "little" && same expected-triple actual && bits == (if same actual "wasm32-unknown-unknown" then 32 else 64)
      other -> False) then Err "runtime object target, ownership or block ABI mismatch" else
      (case field "object_content_hash" doc of
        JStr hash -> if not (same hash (fnv-source-hash code)) then Err "runtime object code identity mismatch" else
          (case (units (field "units" doc) Nil, interface-files (field "interfaces" doc)) of
            (Ok functions, Ok files) -> (case load-object-interfaces-with-known interfaces files of
                Err message -> Err message
                Ok checked -> if matching-interfaces interfaces checked then Ok (RuntimeObject functions (exported-symbols interfaces) (exported-instances interfaces) (encode-dictionary-keys (field "dictionaries" doc)) (encode-families (field "method_families" doc)) (field "constructors" doc)) else Err "runtime object checked interface identity mismatch")
            (Err message, other-files) -> Err message
            (other-units, Err message) -> Err message)
        other -> Err "runtime object has no code identity")

  -- The build driver supplies cryptographic identities for both artifacts.
  -- Paths remain individual words; no shell expansion participates in loading.
  read-runtime-object :: forall r. using (io :: Io r) => List LoadedInterface -> String ->{IO r} Result String RuntimeObject
  read-runtime-object interfaces path = case read-runtime-object-document interfaces path of
    Err message -> Err message
    Ok (provider, doc, object-file, code) -> Ok provider

  -- Keep the manifest and object bytes from the same authenticated read.
  -- Object production must not reopen unchecked metadata after admission.
  read-runtime-object-document :: forall r. using (io :: Io r) => List LoadedInterface -> String ->{IO r} Result String (RuntimeObject, Json, String, Bytes)
  read-runtime-object-document = read-runtime-object-mode True
  read-runtime-object-mode :: forall r. using (io :: Io r) => Bool -> List LoadedInterface -> String ->{IO r} Result String (RuntimeObject, Json, String, Bytes)
  read-runtime-object-mode reclaim interfaces path = case read-runtime-object-config path of
    Err message -> Err message
    Ok configuration -> admit-runtime-object-mode reclaim interfaces configuration

  data RuntimeObjectConfig where
    MkRuntimeObjectConfig :: String -> String -> String -> String -> String -> RuntimeObjectConfig
  runtime-object-input-files :: RuntimeObjectConfig -> List String
  runtime-object-input-files configuration = case configuration of
    MkRuntimeObjectConfig triple object-file metadata-file object-hash metadata-hash -> [object-file, metadata-file]
  read-runtime-object-config :: forall r. using (io :: Io r) => String ->{IO r} Result String RuntimeObjectConfig
  read-runtime-object-config path = case fs-read (path-from-string path) of
    Err error -> Err "cannot read runtime object configuration"
    Ok bytes -> case parse-json path bytes of
      Parsed doc Nil -> (case (field "schema" doc, field "target" doc, field "object" doc, field "metadata" doc, field "object_sha256" doc, field "metadata_sha256" doc) of
        (JNum 1, JStr expected-triple, JStr object-file, JStr metadata-file, JStr object-hash, JStr metadata-hash) ->
          Ok (MkRuntimeObjectConfig expected-triple object-file metadata-file object-hash metadata-hash)
        other -> Err "malformed runtime object configuration")
      other -> Err "runtime object configuration is not valid JSON"

  admit-runtime-object :: forall r. using (io :: Io r) => List LoadedInterface -> RuntimeObjectConfig ->{IO r} Result String (RuntimeObject, Json, String, Bytes)
  admit-runtime-object = admit-runtime-object-mode True
  admit-runtime-object-mode :: forall r. using (io :: Io r) => Bool -> List LoadedInterface -> RuntimeObjectConfig ->{IO r} Result String (RuntimeObject, Json, String, Bytes)
  admit-runtime-object-mode reclaim interfaces configuration = case configuration of
    MkRuntimeObjectConfig expected-triple object-file metadata-file object-hash metadata-hash ->
      (case (fs-read (path-from-string object-file), fs-read (path-from-string metadata-file)) of
        (Ok code, Ok metadata) -> if same (sha256-hex code) object-hash && same (sha256-hex metadata) metadata-hash then
          (case parse-json metadata-file metadata of
            Parsed artifact Nil -> (case parse-runtime-object-mode reclaim expected-triple interfaces code artifact of
              Err message -> Err message
              Ok provider -> Ok (provider, artifact, object-file, code))
            other -> Err "runtime object manifest is not valid JSON")
          else Err "runtime object artifact digest mismatch"
        other -> Err "cannot read runtime object artifacts")

  -- Encode every UTF-8 byte, so source operators and non-ASCII names cannot
  -- become LLVM syntax. No platform-specific alias spellings are assumed.
  hex-digit :: Nat -> InRange 0 255 Nat
  hex-digit n = if n < 10 then 48 + n else if n < 16 then 55 + n else 48

  write-llvm-bytes :: Bytes -> Nat -> Bytes -> Nat -> Unit
  write-llvm-bytes input index output pos =
    if index < bytes-len input && pos + 2 < bytes-len output then
      let byte = bytes-get input index in
      let slash = bytes-set output pos 92 in
      let high = bytes-set output (pos + 1) (hex-digit (byte / 16)) in
      let low = bytes-set output (pos + 2) (hex-digit (byte % 16)) in
      write-llvm-bytes input (index + 1) output (pos + 3)
    else ()

  -- Each byte becomes exactly three ASCII bytes, including the backslash.
  llvm-bytes :: Bytes -> String
  llvm-bytes bytes = let output = bytes-new (3 * bytes-len bytes) in
    let filled = write-llvm-bytes bytes 0 output 0 in
    case string-from-bytes output of Some text -> text; None -> ""
  llvm-object-symbol :: String -> String
  llvm-object-symbol name = "@\"" <> llvm-bytes (string-to-bytes name) <> "\""
  llvm-data-bytes :: String -> String
  llvm-data-bytes text = let bytes = string-to-bytes text in
    if plain-llvm-bytes bytes 0 then text else llvm-bytes bytes
  plain-llvm-bytes :: Bytes -> Nat -> Bool
  plain-llvm-bytes bytes offset = if offset < bytes-len bytes then
    let byte = bytes-get bytes offset in
    byte >= 32 && byte <= 126 && byte /= 34 && byte /= 92 && plain-llvm-bytes bytes (offset + 1)
    else True
