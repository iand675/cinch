-- Typed Core to LLVM using the shared runtime ABI. Each generated value
-- owns one reference; local reads duplicate, scope exits drop, and direct
-- calls transfer arguments to the callee. Mathematical numbers remain
-- runtime words throughout. Unsupported Core produces errors, never IR.
module Bootstrap.RuntimeIr where
  import Bootstrap.Check (CheckedProgram, checked-elaboration)
  import Bootstrap.Infer (elaboration-core, elaboration-data, elaboration-effects, elaboration-classes, elaboration-instances, elaboration-bindings, CheckedBinding, checked-name, checked-scheme, checked-role, checked-method-matches, checked-conditional-target, checked-foreign-plan)
  import Bootstrap.Object (RuntimeObject, RuntimeUnit, object-words, object-unit, object-variant, object-dictionary, object-family, object-conditional-unit, object-closed-method-unit, object-string-layout, unit-symbol, unit-closure, unit-params, unit-result, llvm-object-symbol, llvm-data-bytes)
  import Bootstrap.Core
  import Bootstrap.Foreign
  import Bootstrap.Builtin (array-plan, array-type-name, nat-arithmetic-extern, u32-wrapping-operation, platform-intrinsic)
  import Bootstrap.Index
  import Bootstrap.ExportType (export-global)
  import Bootstrap.Nominal (interface-global, global-data-core-cons, global-data-core-err, global-data-core-list, global-data-core-nil, global-data-core-none, global-data-core-ok, global-data-core-option, global-data-core-result, global-data-core-some)
  import Bootstrap.Instance
  import Bootstrap.Type
  import Bootstrap.Report
  import Algebra.Semigroup
  import Text.Builder
  import Text.Show (nat-to-string, int-to-string)
  import Text.Scan (string-split-on, string-lines, string-unlines, string-index-of, string-take, string-drop, string-starts-with)
  import Text.Lex (Span)
  import Data.Json
  import Data.HashMap (HashMap, hash-map-empty, hash-map-insert, hash-map-lookup)

  export emit-runtime-program, emit-runtime-program-with-object, emit-runtime-program-counting, check-runtime-entry
  export emit-runtime-program-mode, emit-runtime-program-with-object-mode, emit-runtime-program-counting-mode
  export emit-runtime-library-with-object, emit-runtime-library-artifact-with-object
  export emit-runtime-library-with-object-mode
  export emit-runtime-library-object-with-object-mode, emit-runtime-library-artifact-with-object-mode
  export runtime-library-default-roots, emit-runtime-library-object-with-object

  -- Named families and anonymous tuples share one table, but distinct
  -- group caches: a tuple must retain tag0 even when a named constructor
  -- has the same field map at another tag.
  data LayoutPlan where
    LayoutPlan :: Nat -> List (Nat, Nat) -> List (String, Nat) -> List (Nat, Nat) -> LayoutPlan
  data Local where
    Local :: Nat -> UType -> String -> Local
    Discard :: UType -> String -> Local
    Borrowed :: Nat -> UType -> String -> Local
    KnotLocal :: Nat -> UType -> UType -> String -> Local
    GivenLocal :: String -> UType -> String -> Local
    SelfValue :: String -> Nat -> UType -> String -> Local
    KnownSelf :: String -> String -> List Nat -> List CoreGiven -> Local

    -- A binder whose value is a constructor application that has not been
    -- built. A non-case use builds it; a case on it folds without building.
    DeferredConstructor :: Nat -> UType -> String -> List UType -> List CoreTerm -> Local

  data RecursiveWorker where
    RecursiveWorker :: Nat -> UType -> String -> List CorePattern -> CoreTerm -> RecursiveWorker

  data TailContext where
    LocalTail :: List RecursiveWorker -> List Local -> Nat -> TailContext
    GlobalTail :: Nat -> Nat -> TailContext

  data Demand where
    Demand :: String -> List Nat -> Demand
    ConstructorDemand :: String -> List Nat -> Demand
    LambdaDemand :: String -> List (Nat, Nat) -> List (Nat, Nat) -> List Local -> CorePattern -> CoreTerm -> Demand
    RecursiveDemand :: RecursiveWorker -> List RecursiveWorker -> List (Nat, Nat) -> List (Nat, Nat) -> List Local -> Demand
    StubDemand :: String -> List Nat -> Demand
    DictionaryDemand :: String -> List Nat -> Demand
    ArrayDemand :: String -> List Nat -> Demand
    BuiltinDemand :: String -> Demand
    MemoWorker :: Demand
    ExternalDemand :: RuntimeUnit -> Demand
    ForeignDemand :: ForeignPlan -> Demand
    PrimitiveIntrinsicDemand :: String -> Demand
  -- Bound scheme ids and opened rigid ids are separate namespaces.
  -- A worker is shared by all actual types with the same class vector.
  data MethodVersion where
    MethodVersion :: String -> Nat -> List Nat -> MethodVersion
  data MethodSlot where
    MethodSlot :: Nat -> Nat -> List Nat -> MethodSlot
  -- The checked bindings with their foreign plans indexed once: every word
  -- classification asks whether a foreign ABI passes the type opaquely,
  -- and every call asks whether its target is foreign. The map keeps the
  -- first binding of each name, as a scan in binding order would.
  data BindingIndex where
    BindingIndex :: List CheckedBinding -> List ForeignPlan -> HashMap String (Option ForeignPlan) -> BindingIndex
  data ProgramInfo where
    ProgramInfo :: List CoreData -> List CoreClass -> List CoreInstance -> BindingIndex -> List MethodVersion -> Option RuntimeObject -> Option (List String) -> List CoreEffect -> HashMap String (Nat, Nat) -> ProgramInfo
  -- The units a sweep may copy at their call sites, whether copying is on
  -- at all, and the unfolding stack. The names are fixed before emission, so
  -- the decision at a site depends on nothing but the unit's name; the stack
  -- is what makes the recursion terminate, because a unit already being
  -- unfolded is never unfolded again.
  data InlinePlan where
    InlinePlan :: Bool -> List String -> List String -> InlinePlan
    NoInline :: InlinePlan
  -- What the unfoldable class recorded about one body: whether it calls a
  -- unit at the head of an application (a link the recursive rule may
  -- expand) and how many decisions it carries (at most one).
  data UnfoldShape where
    MkUnfoldShape :: Bool -> Nat -> UnfoldShape
  data RuntimeContext where
    RuntimeContext :: ProgramInfo -> List (Nat, Nat) -> List (Nat, Nat) -> List Demand -> List Demand -> InlinePlan -> RuntimeContext
  data Writer where
    Writer :: Nat -> Builder -> Builder -> List Diagnostic -> LayoutPlan -> RuntimeContext -> Writer

  cat :: List String -> String
  cat xs = string-concat-all xs
  same :: String -> String -> Bool
  same a b = string-compare a b == 0
  line :: Writer -> String -> Writer
  line w text = case w of Writer next globals code errors layouts datas -> Writer next globals (builder-add-line text code) errors layouts datas
  emit-lines :: Writer -> List String -> Writer
  emit-lines w texts = case texts of Nil -> w; Cons first rest -> emit-lines (line w first) rest
  global :: Writer -> String -> Writer
  global w text = case w of Writer next globals code errors layouts datas -> Writer next (builder-add-line text globals) code errors layouts datas
  fresh :: Writer -> String -> (Writer, String)
  fresh w prefix = case w of Writer next globals code errors layouts datas -> (Writer (next + 1) globals code errors layouts datas, cat [prefix, nat-to-string next])
  refuse :: Writer -> Span -> String -> Writer
  refuse w sp text = case w of Writer next globals code errors layouts datas -> Writer next globals code (Cons (MkDiagnostic "bootstrap.runtime-ir" sp text) errors) layouts datas
  unsupported :: Writer -> Span -> String -> (Writer, String)
  unsupported w sp text = (refuse w sp text, "0")
  symbol :: String -> String
  symbol name = cat ["@\"cinch.typed.", name, "\""]
  base :: UType -> UType
  base ty = case refinement-view ty of URefine id name carrier predicate -> base carrier; URequire predicates body -> base body; other -> ty
  named :: UType -> String -> Bool
  named ty name = case base ty of UCon actual KType -> same actual name; other -> False
  number :: UType -> Bool
  number ty = named ty "Int" || named ty "Nat"
  raw-integer :: UType -> Bool
  raw-integer ty = named ty "I8" || named ty "I16" || named ty "I32" || named ty "I64" || named ty "Isize" || named ty "U8" || named ty "U16" || named ty "U32" || named ty "U64" || named ty "Usize"
  scalar :: UType -> Bool
  scalar ty = number ty || named ty "Bool" || named ty "Unit" || raw-integer ty || named ty "Char"
  writer-context :: Writer -> RuntimeContext
  writer-context w = case w of Writer next globals code errors layouts context -> context
  writer-program :: Writer -> ProgramInfo
  writer-program w = case writer-context w of RuntimeContext info bounds rigids pending done inlining -> info
  program-data :: ProgramInfo -> List CoreData
  program-data info = case info of ProgramInfo datas descriptions instances bindings versions provider exposed effects tail-groups -> datas
  program-classes :: ProgramInfo -> List CoreClass
  program-classes info = case info of ProgramInfo datas descriptions instances bindings versions provider exposed effects tail-groups -> descriptions
  program-instances :: ProgramInfo -> List CoreInstance
  program-instances info = case info of ProgramInfo datas descriptions instances bindings versions provider exposed effects tail-groups -> instances
  program-bindings :: ProgramInfo -> List CheckedBinding
  program-bindings info = case info of ProgramInfo datas descriptions instances (BindingIndex bindings plans names) versions provider exposed effects tail-groups -> bindings
  program-foreign-plans :: ProgramInfo -> List ForeignPlan
  program-foreign-plans info = case info of ProgramInfo datas descriptions instances (BindingIndex bindings plans names) versions provider exposed effects tail-groups -> plans
  -- The foreign plan of the first binding named `name`, if that binding is foreign.
  program-foreign-binding :: String -> ProgramInfo -> Option ForeignPlan
  program-foreign-binding name info = case info of
    ProgramInfo datas descriptions instances (BindingIndex bindings plans names) versions provider exposed effects tail-groups -> case hash-map-lookup name names of
      Some plan -> plan
      None -> None
  index-bindings :: List CheckedBinding -> BindingIndex
  index-bindings bindings = case foreign-index bindings of (plans, names) -> BindingIndex bindings plans names
  foreign-index :: List CheckedBinding -> (List ForeignPlan, HashMap String (Option ForeignPlan))
  foreign-index bindings = case bindings of
    Nil -> (Nil, hash-map-empty)
    Cons binding rest -> case foreign-index rest of
      (plans, names) -> let plan = checked-foreign-plan binding in
        ((case plan of Some found -> Cons found plans; None -> plans), hash-map-insert (checked-name binding) plan names)
  program-versions :: ProgramInfo -> List MethodVersion
  program-versions info = case info of ProgramInfo datas descriptions instances bindings versions provider exposed effects tail-groups -> versions
  program-object :: ProgramInfo -> Option RuntimeObject
  program-object info = case info of ProgramInfo datas descriptions instances bindings versions provider exposed effects tail-groups -> provider
  program-effects :: ProgramInfo -> List CoreEffect
  program-effects info = case info of ProgramInfo datas descriptions instances bindings versions provider exposed effects tail-groups -> effects
  with-versions :: List MethodVersion -> ProgramInfo -> ProgramInfo
  with-versions versions info = case info of ProgramInfo datas descriptions instances bindings old provider exposed effects tail-groups -> ProgramInfo datas descriptions instances bindings versions provider exposed effects tail-groups
  program-tail-groups :: ProgramInfo -> HashMap String (Nat, Nat)
  program-tail-groups info = case info of ProgramInfo datas descriptions instances bindings versions provider exposed effects groups -> groups
  with-tail-groups :: HashMap String (Nat, Nat) -> ProgramInfo -> ProgramInfo
  with-tail-groups groups info = case info of
    ProgramInfo datas descriptions instances bindings versions provider exposed effects old ->
      ProgramInfo datas descriptions instances bindings versions provider exposed effects groups
  exposed-worker :: String -> List String -> Bool
  exposed-worker name names = case names of Nil -> False; Cons first rest -> same name first || exposed-worker name rest
  worker-linkage :: Writer -> String -> String
  worker-linkage w name = case writer-program w of
    ProgramInfo datas descriptions instances bindings versions provider exposed effects tail-groups -> case exposed of
      None -> ""
      Some names -> if exposed-worker name names then "" else "internal "
  same-classes :: List Nat -> List Nat -> Bool
  same-classes first second = case (first, second) of
    (Nil, Nil) -> True
    (Cons a rest, Cons b more) -> a == b && same-classes rest more
    other -> False
  version-present :: String -> Nat -> List Nat -> List MethodVersion -> Bool
  version-present owner slot classes versions = case versions of
    Nil -> False
    Cons (MethodVersion name index actual) rest -> (same owner name && slot == index && same-classes classes actual) || version-present owner slot classes rest
  note-version :: String -> Nat -> List Nat -> Writer -> Writer
  note-version owner slot classes w = case w of
    Writer next globals code errors layouts (RuntimeContext info bounds rigids pending done inlining) ->
      if list-length classes == 0 || version-present owner slot classes (program-versions info) then w else
        Writer next globals code errors layouts (RuntimeContext (with-versions (program-versions info <> [MethodVersion owner slot classes]) info) bounds rigids pending done inlining)
  method-class-ids :: CoreClassMethod -> List Nat
  method-class-ids member = case scheme-requirements (class-method-scheme member) of Cons self rest -> type-free-bound (requirement-type self); Nil -> Nil
  id-present :: Nat -> List Nat -> Bool
  id-present id ids = case ids of Nil -> False; Cons first rest -> id == first || id-present id rest
  own-quants :: List Nat -> List Quant -> List Quant
  own-quants inherited qs = case qs of Nil -> Nil; Cons q rest -> if id-present (quant-id q) inherited then own-quants inherited rest else Cons q (own-quants inherited rest)
  own-actuals :: List Nat -> List Quant -> List UType -> List UType
  own-actuals inherited qs actuals = case (qs, actuals) of
    (Cons q rest, Cons actual more) -> if id-present (quant-id q) inherited then own-actuals inherited rest more else Cons actual (own-actuals inherited rest more)
    other -> Nil
  method-own-quants :: CoreClassMethod -> List Quant
  method-own-quants member = own-quants (method-class-ids member) (scheme-params (class-method-scheme member))
  method-own-classes :: Writer -> CoreClassMethod -> List UType -> Option (List Nat)
  method-own-classes w member actuals = if list-length actuals /= list-length (scheme-params (class-method-scheme member)) then None else
    scheme-classes (writer-context w) (method-own-quants member) (own-actuals (method-class-ids member) (scheme-params (class-method-scheme member)) actuals)
  default-own :: List Quant -> List Nat
  default-own qs = case qs of Nil -> Nil; Cons q rest -> if kind-equal (quant-kind q) KType then Cons 1 (default-own rest) else default-own rest
  selected-versions :: String -> Nat -> List MethodVersion -> List (List Nat)
  selected-versions owner slot versions = case versions of
    Nil -> Nil
    Cons (MethodVersion name index classes) rest -> if same owner name && slot == index then Cons classes (selected-versions owner slot rest) else selected-versions owner slot rest
  classes-before :: List Nat -> List Nat -> Bool
  classes-before first second = case (first, second) of
    (Nil, Cons b more) -> True
    (Cons a rest, Cons b more) -> a < b || (a == b && classes-before rest more)
    other -> False
  insert-version :: List Nat -> List (List Nat) -> List (List Nat)
  insert-version classes versions = case versions of
    Nil -> [classes]
    Cons first rest -> if classes-before classes first then Cons classes versions else Cons first (insert-version classes rest)
  sort-versions :: List (List Nat) -> List (List Nat)
  sort-versions versions = case versions of Nil -> Nil; Cons first rest -> insert-version first (sort-versions rest)
  member-versions :: Writer -> String -> CoreClassMethod -> List (List Nat)
  member-versions w owner member = case selected-versions owner (class-method-slot member) (program-versions (writer-program w)) of
    Nil -> [default-own (method-own-quants member)]
    found -> sort-versions found
  primary-method-slots :: Writer -> String -> List CoreClassMethod -> List MethodSlot
  primary-method-slots w owner members = case members of
    Nil -> Nil
    Cons member rest -> let classes = case member-versions w owner member of Cons first more -> first; Nil -> Nil in
      Cons (MethodSlot (class-method-slot member) (class-method-slot member) classes) (primary-method-slots w owner rest)
  extra-method-versions :: Nat -> Nat -> List (List Nat) -> (Nat, List MethodSlot)
  extra-method-versions slot next versions = case versions of
    Nil -> (next, Nil)
    Cons first rest -> case extra-method-versions slot (next + 1) rest of
      (finish, more) -> (finish, Cons (MethodSlot slot next first) more)
  extra-method-slots :: Writer -> String -> Nat -> List CoreClassMethod -> List MethodSlot
  extra-method-slots w owner next members = case members of
    Nil -> Nil
    Cons member rest -> let versions = case member-versions w owner member of Cons first more -> more; Nil -> Nil in
      case extra-method-versions (class-method-slot member) next versions of
        (finish, own-codes) -> own-codes <> extra-method-slots w owner finish rest
  class-method-slots :: Writer -> CoreClass -> List MethodSlot
  class-method-slots w description = case program-object (writer-program w) of
    Some provider -> (case object-family (class-name description) provider of
      Some (declared, slots) -> if declared == list-length (class-methods description) then imported-method-slots slots else Nil
      None -> source-method-slots w description)
    None -> source-method-slots w description
  imported-method-slots :: List (Nat, Nat, List Nat) -> List MethodSlot
  imported-method-slots slots = case slots of Nil -> Nil; Cons (logical, physical, codes) rest -> Cons (MethodSlot logical physical codes) (imported-method-slots rest)
  source-method-slots :: Writer -> CoreClass -> List MethodSlot
  source-method-slots w description = primary-method-slots w (class-name description) (class-methods description)
    <> extra-method-slots w (class-name description) (list-length (class-methods description)) (class-methods description)
  method-physical-slot :: Nat -> List Nat -> List MethodSlot -> Option Nat
  method-physical-slot slot own-codes plans = case plans of
    Nil -> None
    Cons (MethodSlot logical physical classes) rest -> if slot == logical && same-classes own-codes classes then Some physical else method-physical-slot slot own-codes rest
  take-classes :: Nat -> List Nat -> List Nat
  take-classes count classes = if count == 0 then Nil else case classes of Nil -> Nil; Cons first rest -> Cons first (take-classes (count - 1) rest)
  type-param-count :: List Quant -> Nat
  type-param-count qs = case qs of Nil -> 0; Cons q rest -> (if kind-equal (quant-kind q) KType then 1 else 0) + type-param-count rest
  method-reference :: String -> String -> Nat -> List CheckedBinding -> Bool
  method-reference name owner slot bindings = case bindings of Nil -> False; Cons first rest -> checked-method-matches first name owner slot || method-reference name owner slot rest
  writer-data :: Writer -> List CoreData
  writer-data w = program-data (writer-program w)
  data-declaration :: String -> List CoreData -> Option CoreData
  data-declaration name datas = case datas of
    Nil -> None
    Cons d rest -> if same name (core-data-name d) then Some d else data-declaration name rest
  type-head :: UType -> UType
  type-head ty = case base ty of UApp f x -> type-head f; other -> other
  representation :: Nat -> List (Nat, Nat) -> Option Nat
  representation id entries = case entries of Nil -> None; Cons (key, code) rest -> if key == id then Some code else representation id rest
  -- Kernel Dec stores a tag only. Its checked proposition is erased;
  -- source datatypes cannot supply this builtin identity or its layout.
  decision-word-type :: UType -> Bool
  decision-word-type ty = case base ty of
    UApp (UCon name kind) predicate -> same name "b.Dec" && kind-equal kind (KFun KProp KType) && kind-equal (type-kind predicate) KProp && valid-type predicate
    other -> False
  program-info :: RuntimeContext -> ProgramInfo
  program-info context = case context of RuntimeContext info bounds rigids pending done inlining -> info
  foreign-type-equal :: UType -> UType -> Bool
  foreign-type-equal first second = valid-type first && valid-type second && (case store-errors (unify (Span 0 0 1 1) first second (empty-store "foreign ABI type")) of Nil -> True; other -> False)
  foreign-parameter-matches :: UType -> ForeignParameter -> Bool
  foreign-parameter-matches ty parameter = same (foreign-class parameter) "ptr" && foreign-type-equal ty (foreign-parameter-type parameter)
  opaque-foreign-params :: UType -> List ForeignParameter -> Bool
  opaque-foreign-params ty params = case params of Nil -> False; Cons first rest -> foreign-parameter-matches ty first || opaque-foreign-params ty rest
  opaque-foreign-word :: UType -> List ForeignPlan -> Bool
  opaque-foreign-word ty plans = case plans of
    Nil -> False
    Cons plan rest -> opaque-foreign-params ty (foreign-parameters plan) || foreign-parameter-matches ty (foreign-result plan) || opaque-foreign-word ty rest
  checked-string-word :: String -> ProgramInfo -> Bool
  checked-string-word name info = case program-object info of
    Some provider -> case object-string-layout name provider of Some descriptor -> True; None -> False
    None -> False
  word-class :: RuntimeContext -> UType -> Option Nat
  word-class context ty = case mutable-borrow (base ty) of
    Some place -> Some 1
    None -> case borrowed-carrier (base ty) of
      Some carrier -> word-class context carrier
      None -> case (deferral-parts (base ty), lazy-parts (base ty)) of
        (None, None) -> value-word-class context ty
        other -> Some 1
  handler-word-type :: UType -> Bool
  handler-word-type ty = case handler-parts (base ty) of Some parts -> True; None -> False
  -- Sym is an immortal runtime handle, classified Raw by the object ABI.
  value-word-class :: RuntimeContext -> UType -> Option Nat
  value-word-class context ty = if foreign-pointer ty || opaque-foreign-word ty (program-foreign-plans (program-info context)) then Some 0 else if decision-word-type ty || handler-word-type ty then Some 1 else if number ty then Some 2 else if named ty "Bool" || named ty "Unit" || raw-integer ty || named ty "Char" || named ty "Sym" || named ty "F32" || named ty "F64" then Some 0 else case context of
    RuntimeContext datas bounds rigids pending done inlining -> case base ty of
      UBound id name KType -> representation id bounds
      URigid id name level KType -> representation id rigids
      UFun domain result -> Some 1
      UFunEff domain row result -> Some 1
      UUsageArrow usage arrow -> Some 1
      UProofFun predicate row result -> Some 1
      UPi id name domain row result -> Some 1
      -- A polymorphic value is its class-indexed bundle: one block.
      UForall qs body -> Some 1
      UTuple fields -> if field-types context fields 0 then Some 1 else None
      other -> case type-head ty of
        UCon name kind -> if (same name "b.Io" && kind-equal kind (KFun KRegion KType)) || (same name "b.Scope" && kind-equal kind scope-kind) || (same name "b.Task" && kind-equal kind task-kind) then Some 0
          else if array-type-name name && kind-equal kind (KFun KType KType) then Some 1
          else if (same name "Bytes" || same name "String") && kind-equal kind KType then Some 1 else
          (case data-declaration name (program-data datas) of
            Some d -> Some 1
            None -> if kind-equal kind KType && checked-string-word name datas then Some 1
              else case find-class name (program-classes datas) of Some description -> Some 1; None -> None)
        UBound id name kind -> applied-former-class ty kind (representation id bounds)
        URigid id name level kind -> applied-former-class ty kind (representation id rigids)
        other -> None
  applied-former-class :: UType -> Kind -> Option Nat -> Option Nat
  applied-former-class ty kind code = if former-kind kind && kind-equal (type-kind ty) KType then code else None
  word-type :: RuntimeContext -> UType -> Bool
  word-type context ty = case word-class context ty of Some code -> True; None -> False
  field-types :: RuntimeContext -> UType -> Nat -> Bool
  field-types context fields count = case fields of
    UEnd -> True
    UArg first rest -> count < 16 && word-type context first && field-types context rest (count + 1)
    other -> False
  class-vector :: RuntimeContext -> List UType -> Option (List Nat)
  class-vector context actuals = case actuals of
    Nil -> Some Nil
    Cons ty rest -> case (word-class context ty, class-vector context rest) of
      (Some code, Some more) -> Some (Cons code more)
      other -> None
  class-text :: List Nat -> String
  class-text classes = case classes of Nil -> ""; Cons code rest -> cat [nat-to-string code, class-text rest]
  native-classes :: List Nat -> String
  native-classes classes = case classes of Nil -> ""; Cons code rest -> cat [if code == 0 then "R" else if code == 1 then "O" else "T", native-classes rest]
  specialized-name :: String -> List Nat -> String
  specialized-name name classes = case classes of Nil -> name; other -> cat [name, ".r", class-text classes]
  erased-kind :: Kind -> Bool
  erased-kind kind = case kind of KRegion -> True; KEffect -> True; KRow -> True; KProp -> True; other -> False
  -- Native represents a type former and an abstract application of it
  -- as Obj. Keep its position in the specialization vector.
  former-kind :: Kind -> Bool
  former-kind kind = case kind of
    KFun input result -> kind-equal result KType || former-kind result
    other -> False
  quant-word-class :: RuntimeContext -> Kind -> UType -> Option Nat
  quant-word-class context kind ty = if kind-equal kind KType then word-class context ty
    else if former-kind kind && kind-equal kind (type-kind ty) then Some 1 else None
  scheme-classes :: RuntimeContext -> List Quant -> List UType -> Option (List Nat)
  scheme-classes context qs actuals = case (qs, actuals) of
    (Nil, Nil) -> Some Nil
    (Cons q rest, Cons actual more) -> if erased-kind (quant-kind q) then scheme-classes context rest more else
      (case (quant-word-class context (quant-kind q) actual, scheme-classes context rest more) of
        (Some code, Some tail) -> Some (Cons code tail)
        other -> None)
    other -> None
  source-scheme-classes :: RuntimeContext -> List Quant -> List UType -> Option (List Nat)
  source-scheme-classes context qs actuals = case (qs, actuals) of
    (Nil, Nil) -> Some Nil
    (Cons q rest, Cons actual more) -> (case value-carrier (quant-kind q) of
      Some carrier -> if typed-index-admissible actual then source-scheme-classes context rest more else None
      None -> if erased-kind (quant-kind q) then source-scheme-classes context rest more else
        (case (quant-word-class context (quant-kind q) actual, source-scheme-classes context rest more) of
          (Some code, Some tail) -> Some (Cons code tail)
          other -> None))
    other -> None
  class-bindings :: List Quant -> List Nat -> Option (List (Nat, Nat))
  class-bindings qs classes = case qs of
    Nil -> case classes of Nil -> Some Nil; other -> None
    Cons q rest -> if erased-kind (quant-kind q) || (case value-carrier (quant-kind q) of Some carrier -> True; None -> False) then class-bindings rest classes else
      (case classes of
        Cons code more -> let kind = quant-kind q in
          if (kind-equal kind KType && code < 3) || (former-kind kind && code == 1) then
          (case class-bindings rest more of Some tail -> Some (Cons (quant-id q, code) tail); None -> None) else None
        Nil -> None)
  rigid-bindings :: List (Nat, UType) -> List (Nat, Nat) -> Option (List (Nat, Nat))
  rigid-bindings openings bounds = case openings of
    Nil -> Some Nil
    Cons (key, URigid id name level kind) rest -> if erased-kind kind || (case value-carrier kind of Some carrier -> True; None -> False) then rigid-bindings rest bounds else
      (case (representation key bounds, rigid-bindings rest bounds) of
        (Some code, Some more) -> Some (Cons (id, code) more)
        other -> None)
    Cons (key, UIndex carrier (IRigid id name level)) rest -> rigid-bindings rest bounds
    other -> None
  -- Unconstrained body-local Type variables are sealed by Core typing.
  -- Choose Unit's word class for their internal specializations.
  private-word-classes :: List (Nat, Kind) -> List (Nat, Nat)
  private-word-classes entries = case entries of
    Nil -> Nil
    Cons (id, KType) rest -> Cons (id, 0) (private-word-classes rest)
    Cons other rest -> private-word-classes rest
  definition-rigids :: CoreDefinition -> List (Nat, Nat) -> Option (List (Nat, Nat))
  definition-rigids d bounds = case rigid-bindings (core-openings d) bounds of
    None -> None
    Some opened -> Some (opened <> private-word-classes (core-private-types d))
  with-representations :: List (Nat, Nat) -> List (Nat, Nat) -> Writer -> Writer
  with-representations bounds rigids w = case w of
    Writer next globals code errors layouts (RuntimeContext datas old-bound old-rigid pending done inlining) ->
      Writer next globals code errors layouts (RuntimeContext datas bounds rigids pending done inlining)
  demand-seen :: String -> List Demand -> Bool
  demand-seen key demands = case demands of Nil -> False; Cons first rest -> same key (demand-key first) || demand-seen key rest
  demand-key :: Demand -> String
  demand-key demand = case demand of
    Demand name classes -> specialized-name name classes
    ConstructorDemand name classes -> specialized-name name classes
    LambdaDemand name bounds rigids saved parameter body -> name
    RecursiveDemand (RecursiveWorker id ty name parameters body) group bounds rigids saved -> name
    StubDemand name classes -> cat [name, ".app"]
    DictionaryDemand name classes -> dictionary-name name classes
    ArrayDemand name classes -> array-symbol name classes
    BuiltinDemand name -> name
    MemoWorker -> "runtime:memo"
    ExternalDemand unit -> cat ["external:", unit-symbol unit]
    ForeignDemand plan -> cat ["foreign:", foreign-symbol plan]
    PrimitiveIntrinsicDemand symbol -> cat ["inline intrinsic:", symbol]
  request-demand :: Demand -> Writer -> Writer
  request-demand demand w = case w of
    Writer next globals code errors layouts (RuntimeContext datas bounds rigids pending done inlining) ->
      if demand-seen (demand-key demand) (pending <> done) then w else
        Writer next globals code errors layouts (RuntimeContext datas bounds rigids (Cons demand pending) done inlining)
  demand-worker :: String -> List Nat -> Writer -> Writer
  demand-worker name classes w = request-demand (Demand name classes) w
  runtime-number :: UType -> String
  runtime-number ty = if named ty "Nat" then "nat" else "int"
  -- Count operations call the module's alwaysinline helpers (count-helpers),
  -- the inline fast paths of design/reclamation.md sections 3, 4 and 8.
  -- A constant operand is 0, a raw word or an immediate, never a block.
  count-call :: Bool -> String -> String
  count-call duplicate value = cat ["  call void @cinch.typed.rc.", if duplicate then "dup" else "drop", "(i64 ", value, ")"]
  constant-word :: String -> Bool
  constant-word value = case string-char-at value 0 of
    Some c -> let code = char-code c in (code >= 48 && code <= 57) || code == 45
    None -> False
  count-op :: Bool -> UType -> String -> Writer -> Writer
  count-op duplicate ty value w = case word-class (writer-context w) ty of
    Some 0 -> w
    Some code -> if constant-word value then w else line w (count-call duplicate value)
    None -> refuse w (Span 0 0 1 1) "reference operation needs a checked runtime representation"
  drop-locals :: List Local -> Writer -> Writer
  drop-locals locals w = case locals of
    Nil -> w
    Cons (Local id ty value) rest -> count-op False ty value (drop-locals rest w)
    Cons (Discard ty value) rest -> count-op False ty value (drop-locals rest w)
    Cons (Borrowed id ty value) rest -> drop-locals rest w
    Cons (KnotLocal id region ty value) rest -> drop-locals rest w
    Cons (GivenLocal name ty value) rest -> drop-locals rest w
    Cons (KnownSelf symbol name classes context) rest -> drop-locals rest w
    Cons (DeferredConstructor id ty name actuals args) rest -> drop-locals rest w
    Cons (SelfValue owner slot ty word) rest -> drop-locals rest w
  local :: Nat -> List Local -> Option (UType, String)
  local id locals = case locals of
    Nil -> None
    Cons (Local key ty value) rest -> if key == id then Some (ty, value) else local id rest
    Cons (Discard ty value) rest -> local id rest
    Cons (Borrowed key ty value) rest -> if key == id then Some (ty, value) else local id rest
    Cons (KnotLocal key region ty value) rest -> local id rest
    Cons (GivenLocal name ty value) rest -> local id rest
    Cons (KnownSelf symbol name classes context) rest -> local id rest
    Cons (SelfValue owner slot ty word) rest -> local id rest
    Cons (DeferredConstructor key ty name actuals args) rest -> local id rest

  field-map :: RuntimeContext -> List UType -> Nat -> Option Nat
  field-map datas fields factor = case fields of
    Nil -> Some 0
    Cons first rest -> case (word-class datas first, field-map datas rest (factor * 4)) of
      (Some code, Some more) -> Some (code * factor + more)
      other -> None
  term-types :: List CoreTerm -> List UType
  term-types terms = case terms of Nil -> Nil; Cons term rest -> Cons (core-type term) (term-types rest)
  known-layout :: Nat -> List (Nat, Nat) -> Option Nat
  known-layout packed layouts = case layouts of
    Nil -> None
    Cons (id, entry-word) rest -> if packed == entry-word then Some id else known-layout packed rest
  named-layout :: String -> List (String, Nat) -> Option Nat
  named-layout name groups = case groups of Nil -> None; Cons (owner, id) rest -> if same owner name then Some id else named-layout name rest
  request-layout :: Span -> List CoreTerm -> Writer -> (Writer, Nat)
  request-layout sp fields w = case w of
    Writer next globals code errors (LayoutPlan groups tuples names cells) datas ->
      case field-map datas (term-types fields) 4294967296 of
        None -> (refuse w sp "tuple fields need checked runtime representations", 0)
        Some bits -> let packed = list-length fields + bits in case known-layout packed tuples of
          Some id -> (w, id)
          None -> if list-length fields > 16 || groups >= 1022 then
            (refuse w sp "tuple layout needs an extended runtime descriptor", 0)
            else let id = 64 * (groups + 1) in
              (Writer next globals code errors (LayoutPlan (groups + 1) (Cons (id, packed) tuples) names (Cons (id, packed) cells)) datas, id)
  decision-layout :: Span -> Writer -> (Writer, Nat)
  decision-layout sp w = case w of
    Writer next globals code errors (LayoutPlan groups tuples names cells) context -> case named-layout "b.Dec" names of
      Some id -> (w, id)
      None -> if groups >= 1022 then (refuse w sp "decision layout exceeds the shared runtime table", 0) else
        let id = 64 * (groups + 1) in
        (Writer next globals code errors (LayoutPlan (groups + 1) tuples (Cons ("b.Dec", id) names) (Cons (id, 0) (Cons (id + 1, 0) cells))) context, id)
  decision-constructor :: Span -> Bool -> Writer -> (Writer, String)
  decision-constructor sp positive w = case decision-layout sp w of
    (planned, base-id) -> allocate planned (base-id + (if positive then 0 else 1)) Nil
  decision-expression :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> (Writer, String)
  decision-expression definitions locals w sp test = case expression definitions locals w test of
    (tested, condition) ->
      let (one, predicate) = fresh tested "%v" in
      let (two, yes) = fresh one "decision-yes" in
      let (three, no) = fresh two "decision-no" in
      let (four, joined) = fresh three "decision-join" in
      let split = line (line four (cat ["  ", predicate, " = icmp ne i64 ", condition, ", 0"])) (cat ["  br i1 ", predicate, ", label %", yes, ", label %", no]) in
      let (left, yes-value) = decision-constructor sp True (line split (cat [yes, ":"])) in
      let middle = line (line left (cat ["  br label %", joined])) (cat [no, ":"]) in
      let (right, no-value) = decision-constructor sp False middle in
      let (ready, result) = fresh (line (line right (cat ["  br label %", joined])) (cat [joined, ":"])) "%v" in
      (line ready (cat ["  ", result, " = phi i64 [ ", yes-value, ", %", yes, " ], [ ", no-value, ", %", no, " ]"]), result)
  erased-decision-fields :: CorePattern -> Bool
  erased-decision-fields fields = case fields of
    CPField sp (CPProof at predicate id name) (CPDone end) -> True
    other -> False
  layout-count :: LayoutPlan -> Nat
  layout-count plan = case plan of LayoutPlan groups tuples names cells -> if groups == 0 then 0 else 64 * (groups + 1)
  layout-word :: Nat -> List (Nat, Nat) -> Nat
  layout-word index cells = case cells of
    Nil -> 0
    Cons (id, packed) rest -> if id == index then packed else layout-word index rest
  layout-words :: Nat -> Nat -> List (Nat, Nat) -> Builder -> Builder
  layout-words index end cells code = if index == end then code else
    layout-words (index + 1) end cells (builder-add-string (cat [if index == 0 then "" else ", ", "i64 ", nat-to-string (layout-word index cells)]) code)
  layout-table :: LayoutPlan -> String
  layout-table plan = case plan of
    LayoutPlan 0 tuples names cells -> ""
    LayoutPlan groups tuples names cells -> let count = layout-count plan in
      let words = builder-run (layout-words 0 count cells builder-new) in
      cat ["@cinch.typed.layouts = internal constant [", nat-to-string count, " x i64] [", words, "]\n",
        "define internal void @cinch.typed.layouts.init() {\nentry:\n  call void @cinch_layouts_register(ptr @cinch.typed.layouts, i64 ", nat-to-string count, ")\n  ret void\n}\n",
        "@llvm.global_ctors = appending global [1 x { i32, ptr, ptr }] [{ i32, ptr, ptr } { i32 65535, ptr @cinch.typed.layouts.init, ptr null }]\n"]
  regular-parameters :: List Quant -> List Quant -> Bool
  regular-parameters expected actual = case (expected, actual) of
    (Nil, Nil) -> True
    (Cons q rest, Cons p more) -> if quant-id q == quant-id p then
      kind-equal (quant-kind q) (quant-kind p) && (kind-equal (quant-kind q) KType || (case value-carrier (quant-kind q) of Some carrier -> True; None -> False)) && regular-parameters rest more
      else (case value-carrier (quant-kind q) of Some carrier -> regular-parameters rest actual; None -> False)
    (Cons q rest, Nil) -> (case value-carrier (quant-kind q) of Some carrier -> regular-parameters rest Nil; None -> False)
    other -> False
  data-result :: CoreData -> UType
  data-result d = data-result-args (UCon (core-data-name d) (core-data-kind d)) (core-data-params d)
  data-result-args :: UType -> List Quant -> UType
  data-result-args result qs = case qs of Nil -> result; Cons q rest -> data-result-args (UApp result (UBound (quant-id q) (quant-name q) (quant-kind q))) rest
  constructor-shape :: RuntimeContext -> UType -> UType -> Bool
  constructor-shape context result ty = case ty of
    UFun domain more -> word-type context domain && constructor-shape context result more
    UPi id name domain (URow UEnd) more -> word-type context domain && constructor-shape context result more
    UProofFun predicate (URow UEnd) more -> valid-type predicate && kind-equal (type-kind predicate) KProp
      && constructor-shape context result more
    other -> same-data-result ty result
  same-data-result :: UType -> UType -> Bool
  same-data-result first second = case (first, second) of
    (UCon a ka, UCon b kb) -> same a b && kind-equal ka kb
    (UBound a an ka, UBound b bn kb) -> a == b && kind-equal ka kb
    -- Normalization represents a bound value index as UIndex/IBound.
    -- Compare the same binder and its checked carrier, never an arbitrary
    -- computed or constructor-local index with a family parameter.
    (UBound a an ka, UIndex carrier (IBound b bn)) -> a == b && (case value-carrier ka of Some expected -> runtime-type-equal expected carrier; None -> False)
    (UIndex carrier (IBound a an), UBound b bn kb) -> a == b && (case value-carrier kb of Some expected -> runtime-type-equal carrier expected; None -> False)
    (UIndex carrier (IBound a an), UIndex input (IBound b bn)) -> a == b && runtime-type-equal carrier input
    (UApp f x, UApp g y) -> same-data-result f g && (same-data-result x y || erased-layout-index x y)
    other -> False
  -- A checked value index does not choose a runtime representation.
  -- Ordinary type parameters still retain their exact declared identity;
  -- family/constructor quantifier identity and every field representation
  -- are checked separately below. This permits Signal 1/Signal 2 to share
  -- one tagged family layout without reifying their phantom Nat index.
  erased-layout-index :: UType -> UType -> Bool
  erased-layout-index actual parameter = case (value-carrier (type-kind actual), value-carrier (type-kind parameter)) of
    (Some carrier, Some expected) -> typed-index-admissible actual && runtime-type-equal carrier expected
    other -> False
  constructor-supported :: RuntimeContext -> CoreData -> CoreConstructor -> Bool
  constructor-supported context d c = let sc = core-constructor-scheme c in
    regular-parameters (core-data-params d) (scheme-params sc)
    && (case scheme-requirements sc of Nil -> True; other -> False)
    && constructor-shape context (data-result d) (scheme-body sc) && list-length (core-constructor-fields c) <= 16
  add-constructor-layouts :: RuntimeContext -> CoreData -> Nat -> Nat -> List CoreConstructor -> Writer -> Writer
  add-constructor-layouts context d base-id tag constructors w = case constructors of
    Nil -> w
    Cons c rest -> if not (constructor-supported context d c) then
      add-constructor-layouts context d base-id (tag + 1) rest (refuse w (Span 0 0 1 1) "constructor needs dependent, existential or extended runtime lowering")
      else case field-map context (core-constructor-fields c) 4294967296 of
        None -> add-constructor-layouts context d base-id (tag + 1) rest (refuse w (Span 0 0 1 1) "constructor field representation is unknown")
        Some bits -> case w of
          Writer next globals code errors (LayoutPlan groups tuples names cells) original ->
            let packed = list-length (core-constructor-fields c) + bits in
            add-constructor-layouts context d base-id (tag + 1) rest (Writer next globals code errors (LayoutPlan groups tuples names (Cons (base-id + tag, packed) cells)) original)
  request-data :: Span -> CoreData -> List Nat -> Writer -> (Writer, Nat)
  request-data sp d classes w = case class-bindings (core-data-params d) classes of
    None -> (refuse w sp "data parameters need first-order runtime representation classes", 0)
    Some bounds -> case w of
      Writer next globals code errors (LayoutPlan groups tuples names cells) (RuntimeContext datas old-bound rigids pending done inlining) ->
        let key = specialized-name (core-data-name d) classes in
        case named-layout key names of
          Some id -> (w, id)
          None -> let count = list-length (core-data-constructors d) in
            let id = 64 * (groups + 1) in
            if count >= 16777216 || id + count >= 16777216 then
              (refuse w sp "data family exceeds the runtime descriptor tag or index capacity", 0)
            else let reserved = if count == 0 then count + 1 else (count + 63) / 64 in
              -- Preserve the existing shared-table bound: admitted objects
              -- may have branch-free reads for their regular families.
              if groups + reserved > 1022 then
                (refuse w sp "data family exceeds the supported shared runtime layout table", 0)
              else let planned = Writer next globals code errors (LayoutPlan (groups + reserved) tuples (Cons (key, id) names) cells) (writer-context w) in
                (add-constructor-layouts (RuntimeContext datas bounds Nil pending done inlining) d id 0 (core-data-constructors d) planned, id)
  -- The runtime's escaped descriptor stores the table index in bits40..63
  -- and the full tag in bits16..39; 65535 marks the header escape. Every
  -- constructor of an escaped family uses it, including tags below64.
  data-descriptor :: CoreData -> Nat -> Nat -> Nat
  data-descriptor d base-id tag =
    if list-length (core-data-constructors d) <= 64 && base-id < 65472 then base-id + tag
    else (base-id + tag) * 1099511627776 + tag * 65536 + 65535
  constructor-in :: String -> Nat -> List CoreConstructor -> Option (Nat, CoreConstructor)
  constructor-in name index constructors = case constructors of
    Nil -> None
    Cons c rest -> if same name (core-constructor-name c) then Some (index, c) else constructor-in name (index + 1) rest
  constructor :: String -> List CoreData -> Option (String, Nat, CoreConstructor)
  constructor name datas = case datas of
    Nil -> None
    Cons d rest -> case constructor-in name 0 (core-data-constructors d) of
      Some (tag, c) -> Some (core-data-name d, tag, c)
      None -> constructor name rest
  definition :: String -> List CoreDefinition -> Option CoreDefinition
  definition name definitions = case definitions of Nil -> None; Cons d rest -> if same name (core-name d) then Some d else definition name rest
  join :: List String -> String
  join words = case words of Nil -> ""; Cons word Nil -> word; Cons word rest -> cat [word, ", ", join rest]
  argument-words :: List String -> List String
  argument-words values = case values of Nil -> Nil; Cons value rest -> Cons (cat ["i64 ", value]) (argument-words rest)
  call :: Writer -> String -> List String -> (Writer, String)
  call w name args = let (next, result) = fresh w "%v" in
    (line next (cat ["  ", result, " = call i64 ", name, "(", join (argument-words args), ")"]), result)
  -- A literal in the runtime ABI's immediate range is its own word,
  -- v * 2 + 1 for a Nat in 0..2^63-1 or an Int in -2^62..2^62-1 (the word
  -- cinch_*_from_decimal returns for the same value, compiler/runtime/src/abi.rs).
  -- Other literals parse their decimal text through the runtime.
  decimal :: Writer -> UType -> String -> (Writer, String)
  decimal w ty text = case immediate-literal (named ty "Nat") text of
    Some word -> (w, word)
    None ->
      let (next, name) = fresh w "@number" in
      let len = nat-to-string (string-length text) in
      let declared = global next (cat [name, " = private unnamed_addr constant [", len, " x i8] c\"", text, "\""]) in
      let (ready, result) = fresh declared "%v" in
      (line ready (cat ["  ", result, " = call i64 @cinch_", runtime-number ty, "_from_decimal(ptr ", name, ", i64 ", len, ")"]), result)
  decimal-digits :: List Char -> Nat -> Option Nat
  decimal-digits chars value = case chars of
    Nil -> Some value
    Cons c rest -> let code = char-code c in
      if code >= 48 && code <= 57 then decimal-digits rest (value * 10 + (code - 48)) else None
  -- The immediate word of a decimal literal, printed as an unsigned (Nat)
  -- or signed (Int) i64 constant.
  immediate-literal :: Bool -> String -> Option String
  immediate-literal natural text = case unpack text of
    Nil -> None
    Cons sign rest -> if char-code sign == 45 then
        (if natural then None else case rest of
          Nil -> None
          Cons first more -> case decimal-digits rest 0 of
            Some magnitude -> if magnitude == 0 then Some "1" else if magnitude <= 4611686018427387904 then Some (cat ["-", nat-to-string (2 * magnitude - 1)]) else None
            None -> None)
      else case decimal-digits (Cons sign rest) 0 of
        Some value -> if value <= (if natural then 9223372036854775807 else 4611686018427387903) then Some (nat-to-string (2 * value + 1)) else None
        None -> None
  char-word :: String -> Option String
  char-word text = case unpack text of Cons c Nil -> Some (nat-to-string (char-code c)); other -> None
  -- An immortal header word: rc 0, then kind at bit 40 and layout at bit 48.
  static-header :: Nat -> Nat -> Nat
  static-header kind layout = layout * 281474976710656 + kind * 1099511627776
  struct-field :: String -> String -> Nat -> String
  struct-field shape storage index = cat ["getelementptr inbounds (", shape, ", ptr ", storage, ", i64 0, i32 ", nat-to-string index, ")"]
  -- A string literal is one shared read-only data-section object, as in
  -- compiler/src/codegen.rs (Core::ConstString): the String constructor
  -- block { bytes } and the Bytes block { len; data } it wraps, each after
  -- an immortal header, then the data. The Bytes kind is
  -- KIND_BYTES_STATIC, so a write faults instead of touching constant data.
  -- An escaped descriptor goes in the word before the String header.
  string-literal :: Writer -> Span -> UType -> String -> (Writer, String)
  string-literal w sp ty text = case (base ty, program-object (writer-program w)) of
    (UCon name KType, Some provider) -> (case object-string-layout name provider of
      Some descriptor ->
        let escaped = descriptor >= 65535 in
        let layout = if escaped then (65535 :: Nat) else descriptor in
        let at = if escaped then (1 :: Nat) else 0 in
        let (one, storage) = fresh w "@text" in
        let size = nat-to-string (bytes-len (string-to-bytes text)) in
        let contents = if same size "0" then "[0 x i8] zeroinitializer" else cat ["[", size, " x i8] c\"", llvm-data-bytes text, "\""] in
        let shape = cat ["{ ", if escaped then "i64, " else "", "i64, ptr, i64, i64, ptr, [", size, " x i8] }"] in
        let declared = global one (cat [storage, " = private unnamed_addr constant ", shape, " { ",
          if escaped then cat ["i64 ", nat-to-string descriptor, ", "] else "",
          "i64 ", nat-to-string (static-header 1 layout), ", ptr ", struct-field shape storage (at + 3),
          ", i64 ", nat-to-string (static-header 9 2), ", i64 ", size, ", ptr ", struct-field shape storage (at + 5),
          ", ", contents, " }, align 8"]) in
        let (done, result) = fresh declared "%v" in
        (line done (cat ["  ", result, " = ptrtoint ptr ", struct-field shape storage (at + 1), " to i64"]), result)
      None -> unsupported w sp "String literal has no checked defining wrapper layout")
    other -> unsupported w sp "String literal needs its checked library object layout"
  string-bytes :: Writer -> String -> (Writer, String)
  string-bytes w word = let (one, pointer) = fresh w "%ptr" in
    let (two, bytes) = fresh one "%v" in
    (line (line two (cat ["  ", pointer, " = inttoptr i64 ", word, " to ptr"])) (cat ["  ", bytes, " = load i64, ptr ", pointer]), bytes)
  string-pattern :: Writer -> Span -> UType -> String -> String -> String -> (Writer, List Local)
  string-pattern w sp ty value text failed = case string-literal w sp ty text of
    (literal, word) -> case string-bytes literal value of
      (one, actual) -> case string-bytes one word of
        (two, expected) -> case call two "@cinch_bytes_compare" [actual, expected] of
          (compared, order) -> case compare-word (count-op False ty word compared) "eq" order "0" of
            (ready, condition) -> (continue-if ready condition failed, Nil)
  head :: CoreTerm -> CoreTerm
  head term = case term of CApply sp ty f x -> head f; CApplyEff sp ty row f x -> head f; other -> term
  arguments :: CoreTerm -> List CoreTerm -> List CoreTerm
  arguments term more = case term of CApply sp ty f x -> arguments f (Cons x more); CApplyEff sp ty row f x -> arguments f (Cons x more); other -> more
  function-type :: RuntimeContext -> UType -> Bool
  function-type datas ty =
    let function = base ty in
    let erased-domain = erased-value-arrow function in
    case arrow-shape function of
      UFun domain result -> (erased-domain || word-type datas domain) && function-type datas result
      UFunEff domain row result -> (erased-domain || word-type datas domain) && function-type datas result
      UProofFun predicate row result -> kind-equal (type-kind predicate) KProp && valid-type predicate && function-type datas result
      UPi id name domain row result -> (erased-domain || word-type datas domain) && function-type datas result
      other -> word-type datas ty
  arity :: UType -> Nat
  arity ty = case arrow-shape ty of UFun domain result -> 1 + arity result; other -> 0
  -- Word-level workers share code by representation class. Concrete numeric
  -- semantics stay on checked Core; a TObj parameter is never assumed Int.
  scheme-supported :: RuntimeContext -> Scheme -> Bool
  scheme-supported context sc = function-type context (scheme-body sc)
  -- Generalized function values are instantiated at each checked local use,
  -- as in the Native frontend. Only values are copied: a strict computation
  -- must keep its original once-evaluated let and cannot enter this path.
  local-function-value :: CoreTerm -> Bool
  local-function-value value = case value of
    CLambda sp ty pattern body -> True
    CLocal sp ty id name actuals -> True
    CUse sp ty name role actuals -> True
    CQualifiedUse sp ty name role actuals evidence -> True
    CMethod sp ty name owner slot actuals evidence -> True
    other -> False
  specialize-local :: Nat -> Scheme -> CoreTerm -> CoreTerm -> CoreTerm
  specialize-local id scheme value term = case term of
    CLocal sp ty key name actuals -> if id == key then map-term-types (substitute-bound (actual-pairs (scheme-params scheme) actuals)) value else term
    CApply sp ty f x -> CApply sp ty (specialize-local id scheme value f) (specialize-local id scheme value x)
    CApplyEff sp ty row f x -> CApplyEff sp ty row (specialize-local id scheme value f) (specialize-local id scheme value x)
    CErasedApply sp ty row f x -> CErasedApply sp ty row (specialize-local id scheme value f) (specialize-local id scheme value x)
    CDecision sp ty predicate condition -> CDecision sp ty predicate (specialize-local id scheme value condition)
    CScope sp ty region evidence callback -> CScope sp ty region evidence (specialize-local id scheme value callback)
    CMemoScope sp ty region body -> CMemoScope sp ty region (specialize-local id scheme value body)
    CSpawn sp ty token body -> CSpawn sp ty (specialize-local id scheme value token) (specialize-local id scheme value body)
    CJoin sp ty token body -> CJoin sp ty (specialize-local id scheme value token) (specialize-local id scheme value body)
    CWith sp ty given rhs body -> CWith sp ty given (specialize-local id scheme value rhs) (specialize-local id scheme value body)
    CHandler sp ty returned operations -> CHandler sp ty (specialize-local id scheme value returned) (specialize-local id scheme value operations)
    CHandle sp ty label residual body handled-by -> CHandle sp ty label residual (specialize-local id scheme value body) (specialize-local id scheme value handled-by)
    CHandlerOperation sp slot openings row closure rest -> CHandlerOperation sp slot openings row (specialize-local id scheme value closure) (specialize-local id scheme value rest)
    CLambda sp ty pattern body -> if pattern-binds id pattern then term else CLambda sp ty pattern (specialize-local id scheme value body)
    CLet sp ty key name sc rhs body -> CLet sp ty key name sc (specialize-local id scheme value rhs) (if id == key then body else specialize-local id scheme value body)
    CRecursiveFunctions sp ty members body -> if local-in-recursive-functions id members then term else
      CRecursiveFunctions sp ty (map-recursive-functions (specialize-local id scheme value) members) (specialize-local id scheme value body)
    CRecursiveValues sp ty region members body -> if local-in-recursive-functions id members then term else
      CRecursiveValues sp ty region (map-recursive-functions (specialize-local id scheme value) members) (specialize-local id scheme value body)
    CIf sp ty condition yes no -> CIf sp ty (specialize-local id scheme value condition) (specialize-local id scheme value yes) (specialize-local id scheme value no)
    CCase sp ty input alternatives -> CCase sp ty (specialize-local id scheme value input) (specialize-local id scheme value alternatives)
    CTuple sp ty fields -> CTuple sp ty (specialize-local id scheme value fields)
    CPolyIntro sp ty ids body -> CPolyIntro sp ty ids (specialize-local id scheme value body)
    CPolyElim sp ty input args -> CPolyElim sp ty (specialize-local id scheme value input) args
    CPrimitive sp ty name args -> CPrimitive sp ty name (specialize-local id scheme value args)
    CProved sp ty certificate body -> CProved sp ty certificate (specialize-local id scheme value body)
    CRefine sp ty certificate body -> CRefine sp ty certificate (specialize-local id scheme value body)
    CRefineProof sp ty witness body -> CRefineProof sp ty (specialize-local id scheme value witness) (specialize-local id scheme value body)
    CForget sp ty body -> CForget sp ty (specialize-local id scheme value body)
    CRequire sp ty body -> CRequire sp ty (specialize-local id scheme value body)
    CDischarge sp ty evidence body -> CDischarge sp ty evidence (specialize-local id scheme value body)
    CGuard sp ty condition body -> CGuard sp ty (specialize-local id scheme value condition) (specialize-local id scheme value body)
    CArgument sp first rest -> CArgument sp (specialize-local id scheme value first) (specialize-local id scheme value rest)
    CAlternative sp pattern body rest -> CAlternative sp pattern (if pattern-binds id pattern then body else specialize-local id scheme value body) (specialize-local id scheme value rest)
    other -> term
  -- The checked effect declaration numbers operation slots from one.
  -- The handler stores its return closure in slot zero.
  handler-fields :: CoreTerm -> Nat -> Option CoreTerm
  handler-fields fields index = case fields of
    CHandlerEnd sp -> Some (CArgumentsEnd sp)
    CHandlerOperation sp slot openings row closure rest -> if slot /= index then None else
      (case handler-fields rest (index + 1) of Some more -> Some (CArgument sp closure more); None -> None)
    other -> None
  handler-operations :: UType -> List CoreEffect -> Option (List CoreOperation)
  handler-operations label effects = case (type-head label, effects) of
    (UCon name kind, Cons declaration rest) ->
      if same name (core-effect-name declaration) && kind-equal kind (core-effect-kind declaration) then Some (core-effect-operations declaration)
      else handler-operations label rest
    other -> None
  handler-operation-slot :: String -> List CoreOperation -> Option Nat
  handler-operation-slot name operations = case operations of
    Nil -> None
    Cons first rest -> if same name (core-operation-name first) then Some (core-operation-slot first) else handler-operation-slot name rest
  handler-field :: Span -> UType -> CoreTerm -> Nat -> CoreTerm
  handler-field sp ty value slot =
    CPrimitive sp ty "#handler-field" (CArgument sp value (CArgument sp (CInt sp (UCon "I64" KType) (nat-to-string slot)) (CArgumentsEnd sp)))
  handler-largest :: Nat -> Nat -> Nat
  handler-largest first second = if first > second then first else second
  handler-pattern-id :: CorePattern -> Nat
  handler-pattern-id pattern = case pattern of
    CPVar sp ty id name -> id
    CPProof sp ty id name -> id
    CPErasedValue sp ty id name -> id
    CPAs sp ty id name nested -> handler-largest id (handler-pattern-id nested)
    CPConstructor sp ty name args scheme fields -> handler-pattern-id fields
    CPTuple sp ty fields -> handler-pattern-id fields
    CPField sp field rest -> handler-largest (handler-pattern-id field) (handler-pattern-id rest)
    other -> 0
  handler-term-id :: CoreTerm -> Nat
  handler-term-id term = let inside = handler-terms-id (term-children term) in case term of
    CLocal sp ty id name actuals -> id
    CLet sp ty id name scheme rhs body -> handler-largest id inside
    CLambda sp ty pattern body -> handler-largest (handler-pattern-id pattern) inside
    CAlternative sp pattern body rest -> handler-largest (handler-pattern-id pattern) inside
    other -> inside
  handler-terms-id :: List CoreTerm -> Nat
  handler-terms-id terms = case terms of
    Nil -> 0
    Cons first rest -> handler-largest (handler-term-id first) (handler-terms-id rest)
  handler-local-id :: List Local -> Nat
  handler-local-id locals = case locals of
    Nil -> 0
    Cons (Local id ty value) rest -> handler-largest id (handler-local-id rest)
    Cons (Borrowed id ty value) rest -> handler-largest id (handler-local-id rest)
    Cons other rest -> handler-local-id rest
  data HandlerLowering where
    HandlerLowering :: UType -> UType -> UType -> CoreTerm -> List CoreOperation -> HandlerLowering
  -- Fresh synthetic bindings are above every local in the handled tree.
  -- The record is evaluated once, outside the extent it handles.
  lower-handler :: List CoreEffect -> List Local -> Span -> UType -> UType -> CoreTerm -> CoreTerm -> Result String CoreTerm
  lower-handler effects locals sp output label body handled-by = case (handler-parts (core-type handled-by), handler-operations label effects) of
    (Some (actual, input, result, row), Some operations) ->
      let id = 1 + handler-largest (handler-local-id locals) (handler-terms-id [body, handled-by]) in
      let frame = CLocal sp (core-type handled-by) id "#handler" Nil in
      let prompt value cursor = Ok (CApply sp output (handler-field sp (UFunEff input row output) frame 0) value, cursor) in
      (case handler-cps (HandlerLowering label output row frame operations) sp body prompt (id + 1) of
        Ok (lowered, cursor) -> Ok (CLet sp output id "#handler" (mono (core-type handled-by)) handled-by lowered)
        Err message -> Err message)
    other -> Err "handle needs its checked effect declaration and clause record"
  handler-bind :: Span -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-bind sp value next cursor =
    let ty = core-type value in
    case next (CLocal sp ty cursor "#handled-value" Nil) (cursor + 1) of
      Ok (body, fresh) -> Ok (CLet sp (core-type body) cursor "#handled-value" (mono ty) value body, fresh)
      Err message -> Err message
  handler-arguments :: Span -> List CoreTerm -> CoreTerm
  handler-arguments sp values = case values of
    Nil -> CArgumentsEnd sp
    Cons first rest -> CArgument sp first (handler-arguments sp rest)
  handler-values :: HandlerLowering -> Span -> List CoreTerm -> (List CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-values context sp values next cursor = case values of
    Nil -> next Nil cursor
    Cons first rest -> handler-cps context sp first (\value fresh -> handler-values context sp rest (\tail after -> next (Cons value tail) after) fresh) cursor
  handler-apply :: Span -> CoreTerm -> List CoreTerm -> Option CoreTerm
  handler-apply sp fun values = case values of
    Nil -> Some fun
    Cons first rest -> case arrow-shape (core-type fun) of
      UFun input result -> handler-apply sp (CApply sp result fun first) rest
      UFunEff input row result -> handler-apply sp (CApplyEff sp result row fun first) rest
      UPi id name input row result -> handler-apply sp (CApplyEff sp result row fun first) rest
      other -> None
  handler-dispatch :: HandlerLowering -> Span -> UType -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-dispatch context sp response term next cursor = case (context, head term) of
    (HandlerLowering label output row frame operations, CUse at operation name role actuals) ->
      if not (same role "operation") then Err "handled effect escaped its lexical operation call" else
      (case handler-operation-slot name operations of
        None -> Err "handled operation has no checked dispatch slot"
        Some slot -> handler-values context sp (arguments term Nil) (\values fresh ->
          let resumed = CLocal sp response fresh "#resume-argument" Nil in
          case next resumed (fresh + 1) of
            Err message -> Err message
            Ok (body, after) ->
              let continuation = CLambda sp (UFun response output) (CPVar sp response fresh "#resume-argument") body in
              let clause = handler-field sp (handler-clause-type operation output row) frame slot in
              (case handler-apply sp clause (values <> [continuation]) of
                Some called -> Ok (called, after)
                None -> Err "handled operation arguments do not fit the checked clause")) cursor)
    other -> Err "handled effect needs a direct checked operation call"
  -- The continuation is ordinary Core and therefore uses the existing
  -- closure and reference-counting path. Only the operation clause can
  -- enter it, so aborting drops the captured continuation without running it.
  handler-cps :: HandlerLowering -> Span -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-cps context at term next cursor = case context of
    HandlerLowering label output row frame operations ->
      if not (handler-performs label (core-effects term)) then handler-bind at term next cursor else case term of
        CApplyEff sp ty performed f x -> if handler-performs label performed then handler-dispatch context sp ty term next cursor
          else handler-cps-apply context sp ty f x next cursor
        CApply sp ty f x -> handler-cps-apply context sp ty f x next cursor
        CLet sp ty id name sc rhs body -> if not (handler-performs label (core-effects rhs)) then
          (case handler-cps context sp body next cursor of
            Ok (lowered, fresh) -> Ok (CLet sp output id name sc rhs lowered, fresh)
            Err message -> Err message)
          else handler-cps context sp rhs (\value fresh -> case handler-cps context sp body next fresh of
            Ok (lowered, after) -> Ok (CLet sp output id name sc value lowered, after)
            Err message -> Err message) cursor
        CRecursiveFunctions sp ty members body -> case handler-cps context sp body next cursor of
          Ok (lowered, fresh) -> Ok (CRecursiveFunctions sp output members lowered, fresh)
          Err message -> Err message
        CIf sp ty condition yes no -> handler-cps context sp condition (\test fresh -> case handler-cps context sp yes next fresh of
          Err message -> Err message
          Ok (left, after) -> case handler-cps context sp no next after of
            Ok (right, done) -> Ok (CIf sp output test left right, done)
            Err message -> Err message) cursor
        CCase sp ty value alternatives -> handler-cps context sp value (\scrutinee fresh -> handler-cps-case context sp output scrutinee alternatives next fresh) cursor
        CWith sp ty given value body -> handler-cps context sp value (\word fresh -> case handler-cps context sp body next fresh of
          Ok (lowered, after) -> Ok (CWith sp output given word lowered, after)
          Err message -> Err message) cursor
        CTuple sp ty fields -> handler-cps-fields context sp fields (\values fresh -> handler-bind sp (CTuple sp ty values) next fresh) cursor
        CPolyIntro sp ty ids body -> Err "a polymorphic value inside a handled computation is not supported yet"
        CPolyElim sp ty value args -> Err "a polymorphic value inside a handled computation is not supported yet"
        CPrimitive sp ty operation fields -> if same operation "thunk-force" && (case fields of
          CArgument at thunk (CArgumentsEnd end) -> (case deferral-parts (core-type thunk) of Some (latent, result) -> handler-performs label latent; None -> True)
          other -> True) then Err "handled effect needs a direct checked operation call"
          else handler-cps-fields context sp fields (\values fresh -> handler-bind sp (CPrimitive sp ty operation values) next fresh) cursor
        CDecision sp ty predicate test -> handler-cps context sp test (\value fresh -> handler-bind sp (CDecision sp ty predicate value) next fresh) cursor
        CProved sp ty evidence body -> handler-cps context sp body (\value fresh -> next (CProved sp ty evidence value) fresh) cursor
        CRefine sp ty evidence body -> handler-cps context sp body (\value fresh -> next (CRefine sp ty evidence value) fresh) cursor
        CRefineProof sp ty evidence body -> handler-cps context sp body (\value fresh -> next (CRefineProof sp ty evidence value) fresh) cursor
        CForget sp ty body -> handler-cps context sp body (\value fresh -> next (CForget sp ty value) fresh) cursor
        CRequire sp ty body -> handler-cps context sp body (\value fresh -> next (CRequire sp ty value) fresh) cursor
        CDischarge sp ty evidence body -> handler-cps context sp body (\value fresh -> next (CDischarge sp ty evidence value) fresh) cursor
        other -> Err "handled operation occurs in a Core form without continuation lowering"
  handler-cps-apply :: HandlerLowering -> Span -> UType -> CoreTerm -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-cps-apply context sp ty fun arg next cursor =
    handler-cps context sp fun (\function fresh -> handler-cps context sp arg (\value after -> handler-bind sp (CApply sp ty function value) next after) fresh) cursor
  handler-cps-fields :: HandlerLowering -> Span -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-cps-fields context sp fields next cursor = case term-fields fields of
    Some values -> handler-values context sp values (\lowered fresh -> next (handler-arguments sp lowered) fresh) cursor
    None -> Err "handled computation has a malformed argument spine"
  handler-cps-case :: HandlerLowering -> Span -> UType -> CoreTerm -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-cps-case context sp output value alternatives next cursor = case alternatives of
    CAlternativesEnd at -> Ok (CCase sp output value alternatives, cursor)
    CAlternative at pattern body rest -> case handler-cps-case context sp output value rest next cursor of
      Err message -> Err message
      Ok (fallback, fresh) -> case handler-cps-row context output body fallback next fresh of
        Err message -> Err message
        Ok (success, after) -> let other = CAlternative at (CPWild at (core-type value)) fallback (CAlternativesEnd at) in
          Ok (CCase sp output value (CAlternative at pattern success other), after)
    other -> Err "handled computation has a malformed case alternative spine"
  handler-cps-row :: HandlerLowering -> UType -> CoreTerm -> CoreTerm -> (CoreTerm -> Nat -> Result String (CoreTerm, Nat)) -> Nat -> Result String (CoreTerm, Nat)
  handler-cps-row context output body fallback next cursor = case body of
    CGuard sp ty condition value -> handler-cps context sp condition (\test fresh -> case handler-cps-row context output value fallback next fresh of
      Err message -> Err message
      Ok (success, after) -> Ok (CIf sp output test success fallback, after)) cursor
    other -> handler-cps context (Span 0 0 1 1) body next cursor

  expression :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> (Writer, String)
  expression definitions locals w term = case term of
    CInt sp ty text -> if number ty then decimal w ty text else if raw-integer ty then (w, text)
      else (case core-float-literal-word ty text of
        Some bits -> (w, int-to-string bits)
        None -> unsupported w sp "integer carrier needs runtime lowering")
    CChar sp ty text -> if named ty "Char" then (case char-word text of Some word -> (w, word); None -> unsupported w sp "invalid typed character literal") else unsupported w sp "character literal has no checked Char carrier"
    CString sp ty text -> string-literal w sp ty text
    CUnit sp ty -> (w, "0")
    CLocal sp ty id name Nil -> case deferred-constructor id locals of
      Some (ctor, actuals, args) -> direct-call definitions locals w sp ctor actuals args
      None -> case knot-local id locals of
        Some (declared, slot) -> knot-read w declared slot
        None -> case local id locals of
          Some (declared, value) -> (count-op True declared value w, value)
          None -> unsupported w sp "runtime local is absent from its lexical scope"
    CUse sp ty name role actuals ->
      if named ty "Bool" && same name "True" then (w, "1")
      else if named ty "Bool" && same name "False" then (w, "0")
      else direct-call definitions locals w sp name actuals Nil
    CQualifiedUse sp ty name role actuals evidence -> case evidences definitions locals w evidence of
      (ready, values) -> call-name definitions locals ready sp name actuals values Nil
    CMethod sp ty name owner slot actuals evidence -> method-value definitions locals w sp ty name owner slot actuals evidence
    CScope sp ty region evidence callback -> scope-expression definitions locals w sp evidence callback
    CMemoScope sp ty region body -> memo-scope definitions locals (request-demand MemoWorker w) body
    CSpawn sp ty token body -> if task-result-abi w then (case expressions definitions locals w [token, body] of (ready, [scope, closure]) -> call ready "@cinch_task_spawn" [scope, closure]; other -> unsupported w sp "malformed task spawn") else unsupported w sp "tasks require the canonical checked Result error/success ABI"
    CJoin sp ty token body -> if task-result-abi w then join-expression definitions locals w sp ty token body else unsupported w sp "tasks require the canonical checked Result error/success ABI"
    CWith sp ty given value body -> case expression definitions locals w value of
      (ready, word) -> case expression definitions (Cons (GivenLocal (given-symbol given) (given-type given) word) locals) ready body of
        (done, result) -> (count-op False (given-type given) word done, result)
    CHandler sp ty returned operations -> case handler-fields operations 1 of
      Some fields -> tuple definitions locals w sp (CArgument sp returned fields)
      None -> unsupported w sp "handler fields need their checked declaration order and runtime representations"
    CHandle sp ty label residual body handled-by -> case lower-handler (program-effects (writer-program w)) locals sp ty label body handled-by of
      Ok lowered -> expression definitions locals w lowered
      Err message -> unsupported w sp message
    CApplyEff sp ty row f x -> application definitions locals w sp term f x
    CApply sp ty f x -> application definitions locals w sp term f x
    CLambda sp ty pattern body -> lambda definitions locals w sp pattern body
    CRecursiveFunctions sp ty members body -> recursive-expression definitions locals w sp members body
    CRecursiveValues sp ty region members body -> knot-expression definitions locals w sp region members body
    CLet sp ty id name sc rhs body -> if (case scheme-params sc of Nil -> False; other -> True) && local-function-value rhs && (case scheme-requirements sc of Nil -> True; other -> False) then
      expression definitions locals w (specialize-local id sc rhs body)
      else if deferred-let w id sc rhs body then (case deferred-value (writer-data w) rhs of
        Some (ctor, actuals, args) -> expression definitions (Cons (DeferredConstructor id (scheme-body sc) ctor actuals args) locals) w body
        None -> unsupported w sp "deferred constructor let failed its checked representation")
      else if (case scheme-params sc of Nil -> True; other -> False) && scheme-supported (writer-context w) sc && word-type (writer-context w) (scheme-body sc) then
      (case expression definitions locals w rhs of
        (bound, value) -> case expression definitions (Cons (Local id (scheme-body sc) value) locals) bound body of
          (done, result) -> (count-op False (scheme-body sc) value done, result))
      else unsupported w sp "polymorphic or aggregate let needs runtime lowering"
    CIf sp ty test yes no -> branch definitions locals w sp test yes no
    CTuple sp ty fields -> tuple definitions locals w sp fields
    CPolyIntro sp ty ids body -> poly-bundle definitions locals w sp ty ids body
    CPolyElim sp ty value args -> poly-project definitions locals w sp ty value args
    CCase sp ty value alternatives -> case fold-known-case definitions locals w value alternatives of
      Some folded -> folded
      None -> case expression definitions locals w value of
        (ready, word) -> case-value definitions locals ready (core-type value) word alternatives
    CPrimitive sp ty op args -> primitive definitions locals w sp ty op args
    CProved sp ty evidence body -> expression definitions locals w body
    CRefine sp ty evidence body -> expression definitions locals w body
    CRefineProof sp ty witness body -> expression definitions locals w body
    CForget sp ty body -> expression definitions locals w body
    CRequire sp ty body -> expression definitions locals w body
    CDischarge sp ty evidence body -> expression definitions locals w body
    CDecision sp ty predicate condition -> if decision-word-type ty then decision-expression definitions locals w sp condition else unsupported w sp "decision has no checked kernel result type"
    CErasedApply sp ty row f witness -> case f of
      CUse at function name role actuals ->
        if same role "constructor" && decision-word-type ty && (same name "b.Yes" || same name "b.No") then
          decision-constructor sp (same name "b.Yes") w
        else erased-constructor-or-function definitions locals w sp f
      other -> erased-constructor-or-function definitions locals w sp f
    other -> unsupported w (Span 0 0 1 1) "Core form needs typed runtime lowering"
  application :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> CoreTerm -> CoreTerm -> (Writer, String)
  application definitions locals w sp term f x = case head term of
      CUse at function name role actuals -> direct-call definitions locals w sp name actuals (arguments term Nil)
      CMethod at function name owner slot actuals evidence ->
        (case static-instance-method w name owner slot actuals evidence of
          Some (codes, own-codes, d) -> function-call definitions locals (note-version owner slot own-codes w) sp d Nil codes Nil (arguments term Nil)
          None -> case evidence of
            [CEInstance location receiver factory Nil (CEArgumentsEnd end)] ->
              (case closed-method-unit w name owner slot actuals factory of
                Some unit -> if list-length (arguments term Nil) == list-length (unit-params unit) then
                  external-call-unit definitions locals (note-version owner slot Nil w) sp unit (mono function) Nil (arguments term Nil)
                  else indirect-application definitions locals w f x
                None -> indirect-application definitions locals w f x)
            other -> indirect-application definitions locals w f x)
      other -> (case erased-constructor-call term Nil of
        Some (name, actuals, args) -> direct-call definitions locals w sp name actuals args
        None -> indirect-application definitions locals w f x)
  -- A checked proposition argument occupies no runtime field. Continue
  -- gathering positional values through proof applications of constructors.
  erased-constructor-call :: CoreTerm -> List CoreTerm -> Option (String, List UType, List CoreTerm)
  erased-constructor-call term args = case term of
    CUse sp ty name role actuals -> if same role "constructor" then Some (name, actuals, args) else None
    CApply sp ty f x -> erased-constructor-call f (Cons x args)
    CApplyEff sp ty row f x -> erased-constructor-call f (Cons x args)
    CErasedApply sp ty row f witness -> erased-constructor-call f args
    other -> None
  erased-constructor-or-function :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> (Writer, String)
  erased-constructor-or-function definitions locals w sp function = case erased-constructor-call function Nil of
    Some (name, actuals, args) -> direct-call definitions locals w sp name actuals args
    None -> erased-application definitions locals w function
  indirect-application :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> CoreTerm -> (Writer, String)
  indirect-application definitions locals w f x = case expression definitions locals w f of
    (callee, function) -> case expression definitions locals callee x of
      (ready, value) -> apply-one ready function value
  closed-method-unit :: Writer -> String -> String -> Nat -> List UType -> String -> Option RuntimeUnit
  closed-method-unit w name owner slot actuals factory = case (program-object (writer-program w), find-class owner (program-classes (writer-program w)), instance-binding factory (program-bindings (writer-program w))) of
    (Some provider, Some description, Some binding) -> if not (method-reference name owner slot (program-bindings (writer-program w))) then None else
      (case (scheme-params (checked-scheme binding), scheme-requirements (checked-scheme binding), class-owner (scheme-body (checked-scheme binding)), method-at slot (class-methods description)) of
        (Nil, Nil, Some actual-owner, Some member) -> if not (same owner actual-owner) then None else
          (case method-own-classes w member actuals of
            Some Nil -> object-closed-method-unit owner factory slot provider
            other -> None)
        other -> None)
    other -> None
  task-result-abi :: Writer -> Bool
  task-result-abi w = case data-declaration (global-data-core-result) (writer-data w) of
    Some d -> (case (core-data-params d, core-data-constructors d) of
      ([error, value], [first, second]) -> same (core-constructor-name first) (global-data-core-err) && same (core-constructor-name second) (global-data-core-ok)
        && (case (core-constructor-fields first, core-constructor-fields second) of
          ([UBound left name KType], [UBound right other KType]) -> left == quant-id error && right == quant-id value
          other -> False)
      other -> False)
    None -> False
  scope-expression :: List CoreDefinition -> List Local -> Writer -> Span -> CoreEvidence -> CoreTerm -> (Writer, String)
  scope-expression definitions locals w sp evidence callback = case evidences definitions locals w [evidence] of
    (supplied, [capability]) -> (case expression definitions locals supplied callback of
      (ready, closure) -> case call ready "@cinch_scope_open" Nil of
        (opened, scope) -> case apply-one opened closure scope of
          (called, result) -> case call called "@cinch_scope_close" [scope] of
            (closed, ignored) -> (count-op False (evidence-type evidence) capability closed, result))
    other -> unsupported w sp "scope requires one checked Io capability"
  task-stack-array :: Writer -> List String -> (Writer, String, String)
  task-stack-array w values = let (one, pointer) = fresh w "%ptr" in
    let (two, word) = fresh one "%v" in
    let allocated = line two (cat ["  ", pointer, " = alloca i64, i64 ", nat-to-string (list-length values)]) in
    let filled = store-fields allocated pointer 0 values in
    (line filled (cat ["  ", word, " = ptrtoint ptr ", pointer, " to i64"]), pointer, word)
  task-zero-words :: Nat -> List String
  task-zero-words count = if count == 0 then Nil else Cons "0" (task-zero-words (count - 1))
  task-load-words :: Writer -> String -> Nat -> Nat -> (Writer, List String)
  task-load-words w pointer index count = if count == 0 then (w, Nil) else case load-word w pointer (nat-to-string index) of
    (loaded, value) -> case task-load-words loaded pointer (index + 1) (count - 1) of (done, rest) -> (done, Cons value rest)
  task-result-types :: UType -> Option (UType, UType)
  task-result-types ty = case ty of UApp (UApp (UCon name kind) error) value -> if same name (global-data-core-result) then Some (error, value) else None; other -> None
  task-tuple-types :: UType -> Option (List UType)
  task-tuple-types ty = case ty of UTuple fields -> task-tuple-fields fields; other -> None
  task-tuple-fields :: UType -> Option (List UType)
  task-tuple-fields fields = case fields of UEnd -> Some Nil; UArg ty more -> (case task-tuple-fields more of Some rest -> Some (Cons ty rest); None -> None); other -> None
  task-join-success :: Writer -> Span -> UType -> List String -> (Writer, String)
  task-join-success w sp ty values = case task-result-types ty of
    Some (error, payload) -> (case (task-tuple-types payload, data-declaration (global-data-core-result) (writer-data w)) of
      (Some types, Some d) -> (case class-vector (writer-context w) types of
        Some classes -> (case request-object-shape sp classes w of
          (planned, descriptor) -> case allocate planned descriptor values of
            (made, tuple) -> case scheme-classes (writer-context made) (core-data-params d) [error, payload] of
              Some result-classes -> (case request-data sp d result-classes made of (ready, base-id) -> allocate ready (data-descriptor d base-id 1) [tuple])
              None -> unsupported made sp "joined Result needs checked runtime representations")
        None -> unsupported w sp "joined tuple needs checked runtime representations")
      other -> unsupported w sp "joined task result must use its checked tuple and Result declarations")
    None -> unsupported w sp "join has no checked Result carrier"
  join-expression :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> CoreTerm -> (Writer, String)
  join-expression definitions locals w sp ty token handles = case term-fields handles of
    None -> unsupported w sp "malformed join handle spine"
    Some terms -> if list-length terms == 0 then unsupported w sp "join needs at least one handle" else
      (case expression definitions locals w token of
        (scoped, scope) -> case expressions definitions locals scoped terms of
          (evaluated, values) -> case task-stack-array evaluated values of
            (array, input-pointer, input-word) -> case task-stack-array array (task-zero-words (list-length values)) of
              (output, output-pointer, output-word) -> case call output "@cinch_task_join_all_or_cancel" [scope, input-word, nat-to-string (list-length values), output-word] of
                (joined, status) -> if list-length values == 1 then load-word joined output-pointer "0" else task-join-branches joined sp ty output-pointer status (list-length values))
  task-join-branches :: Writer -> Span -> UType -> String -> String -> Nat -> (Writer, String)
  task-join-branches w sp ty output status count =
    let (one, failed) = fresh w "%v" in let (two, slot) = fresh one "%ptr" in
    let (three, failure) = fresh two "taskfail" in let (four, success) = fresh three "taskok" in let (five, end) = fresh four "taskdone" in
    let split = line (line (line five (cat ["  ", slot, " = alloca i64"])) (cat ["  ", failed, " = icmp slt i64 ", status, ", 0"])) (cat ["  br i1 ", failed, ", label %", failure, ", label %", success]) in
    case load-word (line split (cat [failure, ":"])) output "0" of
      (bad, error) -> let next = line (line (line bad (cat ["  store i64 ", error, ", ptr ", slot])) (cat ["  br label %", end])) (cat [success, ":"]) in
        case task-load-words next output 0 count of
          (loaded, values) -> case task-join-success loaded sp ty values of
            (good, result) -> let merged = line (line (line good (cat ["  store i64 ", result, ", ptr ", slot])) (cat ["  br label %", end])) (cat [end, ":"]) in
              case fresh merged "%v" of (done, word) -> (line done (cat ["  ", word, " = load i64, ptr ", slot]), word)
  expressions :: List CoreDefinition -> List Local -> Writer -> List CoreTerm -> (Writer, List String)
  expressions definitions locals w terms = case terms of
    Nil -> (w, Nil)
    Cons term rest -> case expression definitions locals w term of
      (first, value) -> case expressions definitions locals first rest of (done, values) -> (done, Cons value values)
  -- A shape entry includes the three raw ABI prefix words and every
  -- parameter class. The allocation itself holds only the filled prefix.
  class-bits :: List Nat -> Nat -> Nat
  class-bits classes factor = case classes of Nil -> 0; Cons first rest -> first * factor + class-bits rest (factor * 4)
  request-shape :: Span -> List Nat -> Writer -> (Writer, Nat)
  request-shape sp classes w = case w of
    Writer next globals code errors (LayoutPlan groups tuples names cells) context ->
      let packed = 3 + list-length classes + class-bits classes 274877906944 in
      case known-layout packed tuples of
        Some id -> (w, id)
        None -> if list-length classes > 13 || groups >= 1022 then
          (refuse w sp "closure shape needs an extended runtime descriptor", 0)
          else let id = 64 * (groups + 1) in
            (Writer next globals code errors (LayoutPlan (groups + 1) (Cons (id, packed) tuples) names (Cons (id, packed) cells)) context, id)
  closure :: Span -> String -> List Nat -> List String -> Writer -> (Writer, String)
  closure sp name classes values w = case values of
    Nil -> case static-closure sp name classes w of
      (planned, payload) -> let (done, word) = fresh planned "%v" in
        (line done (cat ["  ", word, " = ptrtoint ptr ", payload, " to i64"]), word)
    other -> case request-shape sp classes (request-demand (StubDemand name classes) w) of
      (planned, descriptor) ->
        let (one, pointer) = fresh planned "%ptr" in
        let allocated = line one (cat ["  ", pointer, " = call ptr @cinch_alloc_shaped(i64 ", nat-to-string (8 * (3 + list-length values)), ", i64 2, i64 ", nat-to-string descriptor, ")"]) in
        let prefix = [cat ["ptrtoint (ptr ", symbol (cat [name, ".app"]), " to i64)"], nat-to-string (list-length classes), nat-to-string (list-length values)] in
        let (done, word) = fresh (store-fields allocated pointer 0 (prefix <> values)) "%v" in
        (line done (cat ["  ", word, " = ptrtoint ptr ", pointer, " to i64"]), word)
  -- A closure that saves nothing is one immortal data-section block
  -- { app; arity; 0 } (compiler/src/codegen.rs, clo_def). The result is the
  -- constant payload address.
  static-closure :: Span -> String -> List Nat -> Writer -> (Writer, String)
  static-closure sp name classes w = case request-shape sp classes (request-demand (StubDemand name classes) w) of
    (planned, descriptor) ->
      let (declared, storage) = fresh planned "@closure" in
      let stored = global declared (cat [storage, " = private unnamed_addr constant [4 x i64] [i64 ", nat-to-string (static-header 2 descriptor),
        ", i64 ptrtoint (ptr ", symbol (cat [name, ".app"]), " to i64), i64 ", nat-to-string (list-length classes), ", i64 0], align 8"]) in
      (stored, cat ["getelementptr inbounds ([4 x i64], ptr ", storage, ", i64 0, i64 1)"])
  apply-one :: Writer -> String -> String -> (Writer, String)
  apply-one w function value =
    let (one, argv) = fresh w "%ptr" in
    let (two, result) = fresh one "%v" in
    let stored = line (line two (cat ["  ", argv, " = alloca i64"])) (cat ["  store i64 ", value, ", ptr ", argv]) in
    (line stored (cat ["  ", result, " = call i64 @__apply(i64 ", function, ", i64 1, ptr ", argv, ")"]), result)
  -- A proof lambda is a delayed zero-argument closure. Its body starts only
  -- at the checked erased application, never when the closure is created.
  erased-application :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> (Writer, String)
  erased-application definitions locals w f = case expression definitions locals w f of
    (callee, function) -> let (one, argv) = fresh callee "%ptr" in
      let (two, result) = fresh one "%v" in
      (line (line two (cat ["  ", argv, " = alloca i64"])) (cat ["  ", result, " = call i64 @__apply(i64 ", function, ", i64 0, ptr ", argv, ")"]), result)
  apply-terms :: List CoreDefinition -> List Local -> Writer -> String -> List CoreTerm -> (Writer, String)
  apply-terms definitions locals w function terms = case terms of
    Nil -> (w, function)
    Cons first rest -> case expression definitions locals w first of
      (ready, value) -> case apply-one ready function value of
        (applied, result) -> apply-terms definitions locals applied result rest
  take-terms :: Nat -> List CoreTerm -> List CoreTerm
  take-terms count terms = if count == 0 then Nil else case terms of Nil -> Nil; Cons first rest -> Cons first (take-terms (count - 1) rest)
  drop-terms :: Nat -> List CoreTerm -> List CoreTerm
  drop-terms count terms = if count == 0 then terms else case terms of Nil -> Nil; Cons first rest -> drop-terms (count - 1) rest
  definition-parameters :: CoreDefinition -> List CorePattern
  definition-parameters d = runtime-prefix (definition-all-parameters d)
  definition-all-parameters :: CoreDefinition -> List CorePattern
  definition-all-parameters d = case core-clauses d of Nil -> Nil; Cons (MkCoreClause sp parameters body) rest -> parameters
  runtime-prefix :: List CorePattern -> List CorePattern
  runtime-prefix parameters = case parameters of
    Nil -> Nil
    Cons first rest -> if erased-pattern first then Nil else Cons first (runtime-prefix rest)
  runtime-parameters :: List CorePattern -> List CorePattern
  runtime-parameters parameters = case parameters of
    Nil -> Nil
    Cons first rest -> if erased-pattern first then runtime-parameters rest else Cons first (runtime-parameters rest)
  -- An erased application advances one stage with zero runtime words.
  -- Preserve all equations until the last stage, so later computational
  -- patterns still dispatch together.
  proof-stage-arities :: List CorePattern -> Nat -> List Nat
  proof-stage-arities parameters count = case parameters of
    Nil -> [count]
    Cons first rest -> if erased-pattern first then Cons count (proof-stage-arities rest count) else proof-stage-arities rest (count + 1)
  proof-stage-name :: String -> Nat -> String
  proof-stage-name name rung = if rung == 0 then name else cat [name, ".$proof.", nat-to-string rung]
  take-types :: Nat -> List UType -> List UType
  take-types count types = if count == 0 then Nil else case types of
    Nil -> Nil
    Cons first rest -> Cons first (take-types (count - 1) rest)
  pattern-types :: List CorePattern -> List UType
  pattern-types patterns = case patterns of Nil -> Nil; Cons first rest -> Cons (pattern-type first) (pattern-types rest)
  definition-context :: CoreDefinition -> List Nat -> Writer -> Option RuntimeContext
  definition-context d classes w = case class-bindings (scheme-params (core-scheme d)) classes of
    None -> None
    Some bounds -> case definition-rigids d bounds of
      None -> None
      Some rigids -> Some (RuntimeContext (writer-program w) bounds rigids Nil Nil NoInline)
  constructor-context :: CoreData -> List Nat -> Writer -> Option RuntimeContext
  constructor-context d classes w = case class-bindings (core-data-params d) classes of
    None -> None
    Some bounds -> Some (RuntimeContext (writer-program w) bounds Nil Nil Nil NoInline)
  -- Array workers specialize on checked element classes; packed constructors
  -- carry their fixed format in their canonical operation identity.
  array-binder-field :: CoreData -> UType -> Bool
  array-binder-field d field = case (core-data-params d, field) of
    ([parameter], UBound id name KType) -> quant-id parameter == id && kind-equal (quant-kind parameter) KType
    other -> False
  array-list-abi :: Writer -> Bool
  array-list-abi w = case (data-declaration (global-data-core-list) (writer-data w), constructor (global-data-core-nil) (writer-data w), constructor (global-data-core-cons) (writer-data w)) of
    (Some d, Some (nil-owner, 0, nil-constructor), Some (cons-owner, 1, cons-constructor)) ->
      same nil-owner (core-data-name d) && same cons-owner nil-owner && list-length (core-data-constructors d) == 2 && list-length (core-constructor-fields nil-constructor) == 0 &&
      (case core-constructor-fields cons-constructor of
        [element, UApp (UCon owner (KFun KType KType)) tail] -> same owner nil-owner && array-binder-field d element && array-binder-field d tail
        other -> False)
    other -> False
  array-head-class :: List Nat -> Nat
  array-head-class classes = case classes of Cons first rest -> first; Nil -> 0
  array-argument-classes :: Nat -> List Nat -> List Nat
  array-argument-classes operation classes = let element = array-head-class classes in
    if operation == 0 then [1] else if operation == 1 then [2, element]
    else if operation == 3 || operation == 16 then [1, 2]
    else if operation == 4 then [1, 2, element]
    else if operation == 5 then [1, 2, 2]
    else if operation == 6 || operation == 7 || operation == 10 || operation == 13 then [1, 1]
    else if operation == 11 then [1, 1, element] else [1]
  array-symbol :: String -> List Nat -> String
  array-symbol name classes = specialized-name name classes
  array-call :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List UType -> List String -> List CoreTerm -> (Writer, String)
  array-call definitions locals w sp name actuals givens args = case array-plan name of
    Some (operation, format, scheme) -> case class-vector (writer-context w) actuals of
      Some classes -> if list-length givens /= 0 || list-length classes /= (if format /= 0 then 0 else if operation == 13 || operation == 17 || operation == 18 then 2 else 1) then
        unsupported w sp "array intrinsic needs its exact checked representation parameters" else
        let parameters = array-argument-classes operation classes in
        let count = list-length parameters in
        let worker = array-symbol name classes in
        case expressions definitions locals (request-demand (ArrayDemand name classes) w) (take-terms count args) of
          (ready, values) -> if list-length values < count then closure sp worker parameters values ready else
            case call ready (symbol worker) values of (done, result) -> apply-terms definitions locals done result (drop-terms count args)
      None -> unsupported w sp "array element needs a checked runtime representation"
    None -> unsupported w sp "array operation is unavailable in the selected ABI"
  array-drop-arguments :: List Nat -> Nat -> Writer -> Writer
  array-drop-arguments classes index w = case classes of
    Nil -> w
    Cons first rest -> array-drop-arguments rest (index + 1) (if first == 0 then w else line w (count-call False (cat ["%arg", nat-to-string index])))
  array-option :: Writer -> Span -> Nat -> String -> String -> List String -> (Writer, String)
  array-option w sp payload-class invalid runtime arguments =
    case (constructor (global-data-core-some) (writer-data w), constructor (global-data-core-none) (writer-data w)) of
      (Some (owner, some-tag, some-constructor), Some (none-owner, none-tag, none-constructor)) ->
        if not (same owner (global-data-core-option) && same owner none-owner) || some-tag /= 1 || none-tag /= 0 || list-length (core-constructor-fields some-constructor) /= 1 || list-length (core-constructor-fields none-constructor) /= 0 then unsupported w sp "array result needs its checked Option declaration" else
        (case data-declaration owner (writer-data w) of
          Some d -> if list-length (core-data-constructors d) /= 2 || not (case core-constructor-fields some-constructor of [field] -> array-binder-field d field; other -> False) then unsupported w sp "array Option payload disagrees with its checked parameter" else (case request-data sp d [payload-class] w of
            (planned, descriptor) ->
              let (one, failure) = fresh planned "arraynone" in let (two, success) = fresh one "arraysome" in
              let (three, end) = fresh two "arraydone" in let (four, slot) = fresh three "%ptr" in
              let (five, predicate) = fresh four "%v" in
              let split = line (line (line five (cat ["  ", slot, " = alloca i64"])) (cat ["  ", predicate, " = icmp ne i64 ", invalid, ", 0"])) (cat ["  br i1 ", predicate, ", label %", failure, ", label %", success]) in
              case allocate (line split (cat [failure, ":"])) (data-descriptor d descriptor none-tag) Nil of
                (absent, none) -> let next = line (line (line absent (cat ["  store i64 ", none, ", ptr ", slot])) (cat ["  br label %", end])) (cat [success, ":"]) in
                  case (if same runtime "" then (next, case arguments of Cons value rest -> value; Nil -> "0") else call next runtime arguments) of
                    (read, payload) -> case allocate read (data-descriptor d descriptor some-tag) [payload] of
                      (present, some) -> let joined = line (line (line present (cat ["  store i64 ", some, ", ptr ", slot])) (cat ["  br label %", end])) (cat [end, ":"]) in
                        let (ready, value) = fresh joined "%v" in (line ready (cat ["  ", value, " = load i64, ptr ", slot]), value))
          None -> unsupported w sp "array result has no defining Option family")
      other -> unsupported w sp "array result has no checked Option constructors"
  array-null-option :: Writer -> Span -> String -> String -> List String -> (Writer, String)
  array-null-option w sp runtime result arguments = case call w runtime arguments of
    (made, value) -> case compare-word made "eq" value "0" of
      (checked, invalid) -> array-option checked sp 1 invalid "" [value]
  array-lower :: Writer -> Nat -> Nat -> List Nat -> (Writer, String)
  array-lower w operation format classes =
    let sp = Span 0 0 1 1 in let element = array-head-class classes in
    let storage = nat-to-string (if format == 0 then element else format) in
    if operation == 0 then (if array-list-abi w then call w "@cinch_array_from_list" ["%arg0", storage] else unsupported w sp "array input disagrees with the checked List ABI")
    else if operation == 1 then (case call w "@cinch_nat_to_len" ["%arg0"] of (ready, count) -> call ready "@cinch_array_replicate" [count, "%arg1", storage])
    else if operation == 2 || operation == 14 || operation == 15 then
      (case call w (if operation == 2 then "@cinch_array_len" else if operation == 14 then "@cinch_columnar_rows" else "@cinch_columnar_columns") ["%arg0"] of
        (measured, count) -> call measured "@cinch_nat_from_i64" [count])
    else if operation == 3 || operation == 16 then
      (case call w "@cinch_nat_to_len" ["%arg1"] of
        (indexed, index) -> case (if operation == 3 then
          (case call indexed "@cinch_array_has" ["%arg0", index] of (ready, valid) -> compare-word ready "eq" valid "0")
          else case call indexed "@cinch_columnar_rows" ["%arg0"] of (ready, count) -> compare-word ready "uge" index count) of
          (checked, invalid) -> array-option checked sp element invalid (if operation == 3 then "@cinch_array_get" else "@cinch_columnar_get") ["%arg0", index])
    else if operation == 4 then (case call w "@cinch_nat_to_len" ["%arg1"] of
      (ready, index) -> array-null-option ready sp "@cinch_array_set" "" ["%arg0", index, "%arg2"])
    else if operation == 5 then (case call w "@cinch_nat_to_len" ["%arg1"] of
      (indexed, index) -> case call indexed "@cinch_nat_to_len" ["%arg2"] of
        (ready, count) -> array-null-option ready sp "@cinch_array_slice" "" ["%arg0", index, count])
    else if operation == 6 then call w "@cinch_array_append" ["%arg0", "%arg1"]
    else if operation == 7 then array-null-option w sp "@cinch_tensor_reshape" "" ["%arg0", "%arg1"]
    else if operation == 8 || operation == 9 then call w (if operation == 8 then "@cinch_tensor_shape" else "@cinch_tensor_data") ["%arg0"]
    else if operation == 10 || operation == 11 then
      (case call w "@cinch_tensor_index" ["%arg0", "%arg1"] of
        (indexed, index) -> case compare-word indexed "slt" index "0" of
          (checked, invalid) -> array-option checked sp (if operation == 10 then element else 1) invalid
            (if operation == 10 then "@cinch_tensor_get" else "@cinch_tensor_set") (if operation == 10 then ["%arg0", index] else ["%arg0", index, "%arg2"]))
    else if operation == 12 then call w "@cinch_columnar_column" ["%arg0"]
    else if operation == 13 then (case request-object-shape sp classes w of
      (ready, descriptor) -> array-null-option ready sp "@cinch_columnar_zip" "" ["%arg0", "%arg1", nat-to-string descriptor])
    else if operation == 17 || operation == 18 then array-null-option w sp "@cinch_columnar_child" "" ["%arg0", if operation == 18 then "1" else "0"]
    else if operation == 19 then array-null-option w sp "@cinch_columnar_array" "" ["%arg0"]
    else unsupported w sp "unknown checked array operation"
  array-worker :: String -> List Nat -> Writer -> Writer
  array-worker name classes w = case array-plan name of
    None -> refuse w (Span 0 0 1 1) "array worker unavailable in selected ABI"
    Some (operation, format, scheme) ->
      let parameters = array-argument-classes operation classes in
      let started = line (line w (cat ["define ", worker-linkage w (array-symbol name classes), "i64 ", symbol (array-symbol name classes), "(", join (argument-words (value-parameters (list-length parameters) 0)), ") {"])) "entry:" in
      case array-lower started operation format classes of
        (made, result) -> let done = array-drop-arguments parameters 0 made in line (line done (cat ["  ret i64 ", result])) "}"

  builtin-known :: String -> Bool
  builtin-known name = machine-integer-builtin name || nat-arithmetic-builtin name || same name "b.newIO" || same name "b.ioWrite" || same name "b.ioRead" || same name "b.ioSleep" || same name "b.pollCancel" || same name "cinch.runtime.bytesNew" || same name "cinch.runtime.bytesLen" || same name "cinch.runtime.bytesGet" || same name "cinch.runtime.textF64FromDecimal" || same name "cinch.runtime.textF64ToDecimal" || (case platform-intrinsic name of Some plan -> True; None -> False)
  machine-integer-builtin :: String -> Bool
  machine-integer-builtin name = same name "cinch.prim.eqI64" || same name "cinch.prim.neI64" || (case wrapping-worker-plan name of Some plan -> True; None -> False)
  wrapping-worker-plan :: String -> Option (String, Bool)
  wrapping-worker-plan name = case u32-wrapping-operation name of
    Some operation -> Some (operation, True)
    None -> if same name "cinch.prim.wrappingAddI64" then Some ("add", False)
      else if same name "cinch.prim.wrappingSubI64" then Some ("sub", False)
      else None
  wrapping-word-worker :: Writer -> String -> Bool -> (Writer, String)
  wrapping-word-worker w operation unsigned-narrow =
    let (ready, value) = fresh w "%v" in
    let computed = line ready (cat ["  ", value, " = ", operation, " i64 %arg0, %arg1"]) in
    if unsigned-narrow then
      (let (narrowed, result) = fresh computed "%v" in
       (line narrowed (cat ["  ", result, " = and i64 ", value, ", 4294967295"]), result))
    else (computed, value)
  nat-arithmetic-builtin :: String -> Bool
  nat-arithmetic-builtin name = case nat-arithmetic-extern name of Some external -> True; None -> False
  builtin-classes :: String -> List Nat
  builtin-classes name = if machine-integer-builtin name then [0, 0] else if nat-arithmetic-builtin name then [2, 2] else if same name "b.newIO" then [0] else if same name "b.ioWrite" then [0, 1] else if same name "b.ioRead" || same name "b.ioSleep" then [0, 2] else if same name "b.pollCancel" then [0, 0] else if same name "cinch.runtime.bytesGet" then [1, 2] else if same name "cinch.runtime.bytesNew" then [2] else if same name "cinch.runtime.textF64ToDecimal" then [0] else case platform-intrinsic name of
    Some (scheme, external, arguments, result) -> platform-classes arguments
    None -> [1]
  -- A Unit argument the extern does not take is still the worker's raw word.
  platform-classes :: List Nat -> List Nat
  platform-classes codes = case codes of Nil -> Nil; Cons code rest -> Cons (if code == 3 then 0 else code) (platform-classes rest)
  platform-arguments :: Writer -> List Nat -> Nat -> (Writer, List String)
  platform-arguments w codes index = case codes of
    Nil -> (w, Nil)
    Cons code rest -> let argument = cat ["%arg", nat-to-string index] in
      (case (if code == 2 then call w "@cinch_nat_to_len" [argument] else (w, argument)) of
        (converted, value) -> case platform-arguments converted rest (index + 1) of
          (done, values) -> (done, if code == 3 then values else Cons value values))
  -- The externs borrow their Bytes and Nat arguments; the worker owns them.
  platform-drops :: Writer -> List Nat -> Nat -> Writer
  platform-drops w codes index = case codes of
    Nil -> w
    Cons code rest -> platform-drops (if code == 1 || code == 2 then line w (count-call False (cat ["%arg", nat-to-string index])) else w) rest (index + 1)
  platform-worker :: Writer -> String -> List Nat -> Nat -> (Writer, String)
  platform-worker w external codes result = case platform-arguments w codes 0 of
    (converted, values) -> case call converted (cat ["@", external]) values of
      (called, raw) -> let dropped = platform-drops called codes 0 in
        if result == 0 then (dropped, raw)
        else if result == 1 then call dropped "@cinch_nat_from_i64" [raw]
        else platform-result dropped raw result
  result-binder-fields :: CoreData -> CoreConstructor -> CoreConstructor -> Bool
  result-binder-fields d failure success = case (core-data-params d, core-constructor-fields failure, core-constructor-fields success) of
    ([first, second], [UBound failure-id failure-name KType], [UBound success-id success-name KType]) ->
      quant-id first == failure-id && quant-id second == success-id && kind-equal (quant-kind first) KType && kind-equal (quant-kind second) KType
    other -> False
  -- The prelude `Result I64 a` a boundary word stands for: a negative word
  -- is `Err` over its positive code, any other word is `Ok` over the payload
  -- its result code names (platform-intrinsic).
  platform-result :: Writer -> String -> Nat -> (Writer, String)
  platform-result w raw result = let sp = Span 0 0 1 1 in
    case (constructor (global-data-core-err) (writer-data w), constructor (global-data-core-ok) (writer-data w)) of
      (Some (owner, err-tag, err-constructor), Some (ok-owner, ok-tag, ok-constructor)) ->
        if not (same owner (global-data-core-result) && same owner ok-owner) || err-tag /= 0 || ok-tag /= 1 then unsupported w sp "runtime result needs its checked Result declaration" else
        (case data-declaration owner (writer-data w) of
          Some d -> if list-length (core-data-constructors d) /= 2 || not (result-binder-fields d err-constructor ok-constructor) then unsupported w sp "runtime Result fields disagree with their checked parameters" else
            (case request-data sp d [0, if result == 3 then 2 else if result == 4 then 1 else 0] w of
              (planned, descriptor) ->
                let (one, failure) = fresh planned "resulterr" in let (two, success) = fresh one "resultok" in
                let (three, end) = fresh two "resultdone" in let (four, slot) = fresh three "%ptr" in
                let (five, negative) = fresh four "%v" in let (six, code) = fresh five "%v" in
                let split = emit-lines six [cat ["  ", slot, " = alloca i64"], cat ["  ", negative, " = icmp slt i64 ", raw, ", 0"],
                  cat ["  br i1 ", negative, ", label %", failure, ", label %", success], cat [failure, ":"], cat ["  ", code, " = sub i64 0, ", raw]] in
                case allocate split (data-descriptor d descriptor err-tag) [code] of
                  (failed, err-word) -> let next = emit-lines failed [cat ["  store i64 ", err-word, ", ptr ", slot], cat ["  br label %", end], cat [success, ":"]] in
                    case (if result == 3 then call next "@cinch_nat_from_i64" [raw] else (next, if result == 5 then "0" else raw)) of
                      (ready, payload) -> case allocate ready (data-descriptor d descriptor ok-tag) [payload] of
                        (succeeded, value) -> let joined = emit-lines succeeded [cat ["  store i64 ", value, ", ptr ", slot], cat ["  br label %", end], cat [end, ":"]] in
                          let (done, loaded) = fresh joined "%v" in (line done (cat ["  ", loaded, " = load i64, ptr ", slot]), loaded))
          None -> unsupported w sp "runtime result has no defining Result family")
      other -> unsupported w sp "runtime result has no checked Result constructors"
  builtin-call :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List UType -> List String -> List CoreTerm -> (Writer, String)
  builtin-call definitions locals w sp name actuals givens args =
    let classes = builtin-classes name in
    let prepared = request-demand (BuiltinDemand name) w in
    let count = list-length classes in
    let supplied = list-length givens in
    if supplied > count then unsupported w sp "builtin context exceeds its checked ABI arity" else
      let missing = count - supplied in
      (case expressions definitions locals prepared (take-terms missing args) of
        (ready, values) -> let all = givens <> values in
          if list-length all < list-length classes then closure sp name classes all ready else
            (case call ready (symbol name) all of
              (done, result) -> apply-terms definitions locals done result (drop-terms missing args)))
  builtin-worker :: String -> Writer -> Writer
  builtin-worker name w =
    let classes = builtin-classes name in
    let started = line (line w (cat ["define ", worker-linkage w name, "i64 ", symbol name, "(", join (argument-words (value-parameters (list-length classes) 0)), ") {"])) "entry:" in
    let lowered = (if same name "b.newIO" then (started, "0")
      else if same name "cinch.prim.eqI64" then compare-word started "eq" "%arg0" "%arg1"
      else if same name "cinch.prim.neI64" then compare-word started "ne" "%arg0" "%arg1"
      else if machine-integer-builtin name then
        (case wrapping-worker-plan name of
          Some (operation, unsigned-narrow) -> wrapping-word-worker started operation unsigned-narrow
          None -> unsupported started (Span 0 0 1 1) "checked machine worker has no wrapping operation")
      else if same name "b.ioWrite" then (case call started "@cinch_io_write" ["%arg1"] of (done, result) -> (line done (count-call False "%arg1"), "0"))
      else if same name "b.ioRead" then (case call started "@cinch_nat_to_len" ["%arg1"] of
        (converted, length) -> case call converted "@cinch_io_read" [length] of
          (read, bytes) -> case compare-word (line read (count-call False "%arg1")) "eq" bytes "0" of
            (checked, absent) -> array-option checked (Span 0 0 1 1) 1 absent "" [bytes])
      else if same name "b.ioSleep" then (case call started "@cinch_nat_to_len" ["%arg1"] of
        (converted, length) -> case call converted "@cinch_io_sleep" [length] of (done, result) -> (line done (count-call False "%arg1"), "0"))
      else if same name "b.pollCancel" then call started "@cinch_task_poll_cancel" Nil
      else if same name "cinch.runtime.bytesNew" then (case call started "@cinch_nat_to_len" ["%arg0"] of
        (converted, length) -> case call converted "@cinch_bytes_new" [length] of (done, result) -> (line done (count-call False "%arg0"), result))
      else if same name "cinch.runtime.bytesGet" then (case call started "@cinch_nat_to_len" ["%arg1"] of
        (converted, index) -> case call converted "@cinch_bytes_get" ["%arg0", index] of
          (read, byte) -> case call read "@cinch_nat_from_i64" [byte] of
            (done, result) -> (line (line done (count-call False "%arg0")) (count-call False "%arg1"), result))
      else if same name "cinch.runtime.textF64ToDecimal" then
        (let (one, value) = fresh started "%float" in
         let converted = line one (cat ["  ", value, " = bitcast i64 %arg0 to double"]) in
         let (two, result) = fresh converted "%v" in
         (line two (cat ["  ", result, " = call i64 @cinch_text_f64_to_decimal(double ", value, ")"]), result))
      else if same name "cinch.runtime.textF64FromDecimal" then
        (let (one, value) = fresh started "%float" in
         let decoded = line one (cat ["  ", value, " = call double @cinch_text_f64_from_decimal(i64 %arg0)"]) in
         let (two, result) = fresh (line decoded (count-call False "%arg0")) "%v" in
         (line two (cat ["  ", result, " = bitcast double ", value, " to i64"]), result))
      else case platform-intrinsic name of
        Some (scheme, external, arguments, result) -> platform-worker started external arguments result
        None -> case nat-arithmetic-extern name of
          Some external -> case call started (cat ["@", external]) ["%arg0", "%arg1"] of
            (done, result) ->
              let nat = UCon "Nat" KType in
              (count-op False nat "%arg1" (count-op False nat "%arg0" done), result)
          None -> (case call started "@cinch_bytes_len" ["%arg0"] of
            (measured, length) -> case call measured "@cinch_nat_from_i64" [length] of (done, result) -> (line done (count-call False "%arg0"), result))) in
    case lowered of (done, result) -> line (line done (cat ["  ret i64 ", result])) "}"
  direct-call :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List UType -> List CoreTerm -> (Writer, String)
  direct-call definitions locals w sp name actuals args = call-name definitions locals w sp name actuals Nil args
  call-name :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List UType -> List String -> List CoreTerm -> (Writer, String)
  call-name definitions locals w sp name actuals givens args = if (case program-foreign-binding name (writer-program w) of Some plan -> True; None -> False) then foreign-call definitions locals w sp name givens args else if (case array-plan name of Some plan -> True; None -> False) then array-call definitions locals w sp name actuals givens args else if builtin-known name then builtin-call definitions locals w sp name actuals givens args else
    case instance-named name (program-instances (writer-program w)) of
      Some factory -> case scheme-classes (writer-context w) (scheme-params (instance-scheme factory)) actuals of
        Some classes -> if (case args of Nil -> True; other -> False) && list-length givens == list-length (scheme-requirements (instance-scheme factory)) then
          call (request-demand (DictionaryDemand name classes) w) (symbol-for-dictionary name classes) givens else unsupported w sp "factory constructor arguments disagree with its checked context"
        None -> unsupported w sp "factory needs runtime representation specialization"
      None -> case constructor name (writer-data w) of
        Some (owner, tag, c) -> case data-declaration owner (writer-data w) of
          Some d -> case source-scheme-classes (writer-context w) (scheme-params (core-constructor-scheme c)) actuals of
            None -> unsupported w sp "constructor parameters need runtime representation classes"
            Some classes -> case constructor-context d classes w of
              None -> unsupported w sp "constructor parameters need first-order representation classes"
              Some context -> if list-length args == list-length (core-constructor-fields c) then
                (case request-data sp d classes w of
                  (planned, descriptor) -> case expressions definitions locals planned args of
                    (ready, values) -> allocate ready (data-descriptor d descriptor tag) values)
                else if list-length args < list-length (core-constructor-fields c) then
                  (case class-vector context (core-constructor-fields c) of
                    Some parameters -> case expressions definitions locals (request-demand (ConstructorDemand name classes) w) args of
                      (ready, values) -> closure sp (specialized-name name classes) parameters values ready
                    None -> unsupported w sp "constructor fields need known closure parameter representations")
                else unsupported w sp "constructor application exceeds its checked arity"
          None -> unsupported w sp "constructor has no defining runtime declaration"
        None -> case definition name definitions of
          Some d -> case source-scheme-classes (writer-context w) (scheme-params (core-scheme d)) actuals of
            Some classes -> case inline-call definitions locals w sp d classes givens args of
              Some copied -> copied
              None -> function-call definitions locals w sp d actuals classes givens args
            None -> unsupported w sp "function parameters need first-order or erased representation classes"
          None -> external-call definitions locals w sp name actuals givens args
  foreign-parameter-types :: List ForeignParameter -> List String
  foreign-parameter-types params = case params of
    Nil -> Nil
    Cons first rest -> if same (foreign-class first) "unit" then foreign-parameter-types rest else Cons (foreign-llvm-type first) (foreign-parameter-types rest)
  foreign-worker :: ForeignPlan -> Writer -> Writer
  foreign-worker plan w = let result = foreign-llvm-type (foreign-result plan) in
    let arguments = foreign-parameter-types (foreign-parameters plan) in
    let symbol = foreign-symbol plan in
    case foreign-inline plan of
      None -> global w (cat ["declare ", result, " ", llvm-object-symbol symbol, "(", join arguments, ")"])
      Some (InlinePrimitiveBody fragment symbols immediates assembly) ->
        let required = primitive-intrinsics symbols w in
        let defined = primitive-worker symbol result arguments fragment immediates required in
        case assembly of
          None -> defined
          Some (AssemblyFragment template indices) ->
            let owner = string-drop-llvm-suffix symbol in
            let constraints = string-concat-all ["=", primitive-register result, primitive-registers arguments] in
            let body = cat ["  call void @llvm.sideeffect()\n  %asmresult = call ", result, " asm sideeffect \"",
              llvm-data-bytes template, "\", \"", constraints, "\"(", join (primitive-arguments arguments 0), ")\n  ret ", result, " %asmresult"] in
            primitive-worker (cat [owner, ".asm"]) result arguments body indices (request-demand (PrimitiveIntrinsicDemand "@llvm.sideeffect") defined)
  string-drop-llvm-suffix :: String -> String
  string-drop-llvm-suffix symbol = pack (reverse (drop 5 (reverse (unpack symbol))))
  primitive-register :: String -> String
  primitive-register ty = if same ty "float" || same ty "double" then "f" else "r"
  primitive-registers :: List String -> String
  primitive-registers arguments = case arguments of
    Nil -> ""
    Cons ty rest -> cat [",", primitive-register ty, primitive-registers rest]
  primitive-arguments :: List String -> Nat -> List String
  primitive-arguments arguments index = case arguments of
    Nil -> Nil
    Cons ty rest -> Cons (cat [ty, " %", nat-to-string index]) (primitive-arguments rest (index + 1))
  primitive-worker :: String -> String -> List String -> String -> List Nat -> Writer -> Writer
  primitive-worker name result arguments body immediates w =
    let (ready, attachment) = primitive-immediate-metadata immediates w in
    global ready (cat ["define internal ", result, " ", llvm-object-symbol name, "(", join (primitive-arguments arguments 0),
      ")", attachment, " {\n", body, "\n}"])
  primitive-immediate-metadata :: List Nat -> Writer -> (Writer, String)
  primitive-immediate-metadata indices w = case indices of
    Nil -> (w, "")
    other -> let (next, name) = fresh w "!" in
      (global next (cat [name, " = !{", join (map (\index -> cat ["i32 ", nat-to-string index]) indices), "}"]), cat [" !immarg ", name])
  primitive-intrinsics :: List String -> Writer -> Writer
  primitive-intrinsics symbols w = case symbols of
    Nil -> w
    Cons symbol rest -> primitive-intrinsics rest (request-demand (PrimitiveIntrinsicDemand symbol) w)
  primitive-intrinsic-worker :: String -> Writer -> Writer
  primitive-intrinsic-worker symbol w = if same symbol "@llvm.sideeffect" then global w "declare void @llvm.sideeffect()" else
    (case reverse (string-split-on "." symbol) of
      Cons ty rest -> global w (cat ["declare { ", ty, ", i1 } ", symbol, "(", ty, ", ", ty, ")"])
      Nil -> refuse w (Span 0 0 1 1) "inline intrinsic is missing its checked result width")
  foreign-abi-compatible :: ForeignPlan -> ForeignPlan -> Bool
  foreign-abi-compatible first second = same (foreign-llvm-type (foreign-result first)) (foreign-llvm-type (foreign-result second))
    && same (join (foreign-parameter-types (foreign-parameters first))) (join (foreign-parameter-types (foreign-parameters second)))
  foreign-abi-coherent :: ForeignPlan -> List ForeignPlan -> Bool
  foreign-abi-coherent plan plans = case plans of
    Nil -> True
    Cons other rest -> (not (same (foreign-symbol plan) (foreign-symbol other)) || foreign-abi-compatible plan other) && foreign-abi-coherent plan rest
  foreign-argument-types :: List ForeignParameter -> List CoreTerm -> Bool
  foreign-argument-types params args = case (params, args) of
    (Nil, Nil) -> True
    (Cons first rest, Cons value more) -> foreign-type-equal (foreign-parameter-type first) (core-type value) && foreign-argument-types rest more
    other -> False
  foreign-marshal :: Writer -> List ForeignParameter -> List String -> (Writer, List String)
  foreign-marshal w params values = case (params, values) of
    (Nil, Nil) -> (w, Nil)
    (Cons first rest, Cons value more) -> if same (foreign-class first) "unit" then foreign-marshal w rest more else
      (case foreign-marshal-one w first value of
        (converted, argument) -> case foreign-marshal converted rest more of
          (done, tail) -> (done, Cons (cat [foreign-llvm-type first, " ", argument]) tail))
    other -> (refuse w (Span 0 0 1 1) "foreign ABI argument vector differs from its checked plan", Nil)
  foreign-marshal-one :: Writer -> ForeignParameter -> String -> (Writer, String)
  foreign-marshal-one w parameter value = let ty = foreign-llvm-type parameter in
    if same ty "i64" then (w, value)
    else if same ty "ptr" then let (next, result) = fresh w "%foreign" in (line next (cat ["  ", result, " = inttoptr i64 ", value, " to ptr"]), result)
    else if same ty "double" then let (next, result) = fresh w "%foreign" in (line next (cat ["  ", result, " = bitcast i64 ", value, " to double"]), result)
    else if same ty "float" then
      let (next, bits) = fresh w "%foreign" in let narrow = line next (cat ["  ", bits, " = trunc i64 ", value, " to i32"]) in
      let (ready, result) = fresh narrow "%foreign" in (line ready (cat ["  ", result, " = bitcast i32 ", bits, " to float"]), result)
    else let (next, result) = fresh w "%foreign" in (line next (cat ["  ", result, " = trunc i64 ", value, " to ", ty]), result)
  foreign-pointer-check :: Writer -> ForeignParameter -> String -> Writer
  foreign-pointer-check w parameter value = if foreign-nullable parameter then w else
    let (next, condition) = fresh w "%foreign" in let tested = line next (cat ["  ", condition, " = icmp ne ptr ", value, ", null"]) in
    let (a, yes) = fresh tested "foreign_nonnull" in let (b, no) = fresh a "foreign_null" in
    emit-lines b [cat ["  br i1 ", condition, ", label %", yes, ", label %", no], cat [no, ":"], "  call void @llvm.trap()", "  unreachable", cat [yes, ":"]]
  foreign-result-word :: Writer -> ForeignParameter -> String -> (Writer, String)
  foreign-result-word w parameter value = let ty = foreign-llvm-type parameter in
    if same ty "i64" then (w, value)
    else if same ty "ptr" then
      let guarded = foreign-pointer-check w parameter value in
      let (next, result) = fresh guarded "%foreign" in (line next (cat ["  ", result, " = ptrtoint ptr ", value, " to i64"]), result)
    else if same ty "double" then let (next, result) = fresh w "%foreign" in (line next (cat ["  ", result, " = bitcast double ", value, " to i64"]), result)
    else if same ty "float" then
      let (next, bits) = fresh w "%foreign" in let narrow = line next (cat ["  ", bits, " = bitcast float ", value, " to i32"]) in
      let (ready, result) = fresh narrow "%foreign" in (line ready (cat ["  ", result, " = zext i32 ", bits, " to i64"]), result)
    else let (next, result) = fresh w "%foreign" in
      (line next (cat ["  ", result, " = ", if foreign-signed parameter then "sext " else "zext ", ty, " ", value, " to i64"]), result)
  foreign-call :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List String -> List CoreTerm -> (Writer, String)
  foreign-call definitions locals w sp name givens args = case program-foreign-binding name (writer-program w) of
    None -> unsupported w sp "foreign call has no checked ABI plan"
    Some plan -> if list-length givens /= 0 || not (foreign-argument-types (foreign-parameters plan) args) then unsupported w sp "foreign call must supply every checked ABI argument"
      else if not (foreign-abi-coherent plan (program-foreign-plans (writer-program w))) then unsupported w sp "foreign symbol has conflicting ABI contracts"
      else if not (primitive-immediate-arguments (foreign-inline plan) args) then unsupported w sp "an immarg primitive operand must be an immediate literal"
      else case expressions definitions locals (request-demand (ForeignDemand plan) w) args of
        (evaluated, values) -> case foreign-marshal evaluated (foreign-parameters plan) values of
          (ready, arguments) -> let result = foreign-result plan in let ty = foreign-llvm-type result in
            if same ty "void" then (line ready (cat ["  call void ", llvm-object-symbol (foreign-symbol plan), "(", join arguments, ")"]), "0")
            else let (next, value) = fresh ready "%foreign" in
              foreign-result-word (line next (cat ["  ", value, " = call ", ty, " ", llvm-object-symbol (foreign-symbol plan), "(", join arguments, ")"])) result value
  primitive-immediate-arguments :: Option InlinePrimitive -> List CoreTerm -> Bool
  primitive-immediate-arguments plan args = case plan of
    None -> True
    Some (InlinePrimitiveBody fragment symbols indices assembly) -> immediate-operands indices args
  immediate-operands :: List Nat -> List CoreTerm -> Bool
  immediate-operands indices args = case indices of
    Nil -> True
    Cons index rest -> immediate-operand index args && immediate-operands rest args
  immediate-operand :: Nat -> List CoreTerm -> Bool
  immediate-operand index args = case args of
    Nil -> False
    Cons first rest -> if index == 0 then (case first of CInt sp ty text -> True; other -> False)
      else immediate-operand (index - 1) rest
  external-binding :: String -> List CheckedBinding -> Option CheckedBinding
  external-binding name bindings = case bindings of Nil -> None; Cons first rest -> if same name (checked-name first) && same (checked-role first) "external" then Some first else external-binding name rest
  external-shape :: Nat -> UType -> List UType -> Option (List UType, UType)
  external-shape count ty params = if count == 0 then Some (params, ty) else case arrow-shape (base ty) of
    UFun domain result -> external-shape (count - 1) result (params <> [domain])
    UFunEff domain row result -> external-shape (count - 1) result (params <> [domain])
    UPi id name domain row result -> external-shape (count - 1) result (params <> [domain])
    other -> None
  external-param-types :: List Nat -> List String
  external-param-types params = case params of Nil -> Nil; Cons first rest -> Cons "i64" (external-param-types rest)
  external-worker :: RuntimeUnit -> Writer -> Writer
  external-worker unit w = global (global w (cat ["declare i64 ", llvm-object-symbol (unit-symbol unit), "(", join (external-param-types (unit-params unit)), ")"]))
    (cat ["declare i64 ", llvm-object-symbol (unit-closure unit), "()"])
  requirement-types :: List Requirement -> List UType
  requirement-types requirements = case requirements of Nil -> Nil; Cons first rest -> Cons (requirement-type first) (requirement-types rest)
  apply-words :: Writer -> String -> List String -> (Writer, String)
  apply-words w function values = case values of
    Nil -> (w, function)
    Cons first rest -> case apply-one w function first of (next, result) -> apply-words next result rest
  actual-pairs :: List Quant -> List UType -> List (Nat, UType)
  actual-pairs qs actuals = case (qs, actuals) of
    (Cons q rest, Cons actual more) -> Cons (quant-id q, actual) (actual-pairs rest more)
    other -> Nil
  concrete-scheme :: Scheme -> List UType -> Scheme
  concrete-scheme sc actuals = let pairs = actual-pairs (scheme-params sc) actuals in
    qualified Nil (map-requirements (substitute-bound pairs) (scheme-requirements sc)) (substitute-bound pairs (scheme-body sc))
  external-call :: List CoreDefinition -> List Local -> Writer -> Span -> String -> List UType -> List String -> List CoreTerm -> (Writer, String)
  external-call definitions locals w sp name actuals givens args = case program-object (writer-program w) of
    None -> unsupported w sp (cat ["external runtime implementation is unavailable: ", name])
    Some provider -> (case external-binding name (program-bindings (writer-program w)) of
      Some binding -> (case scheme-classes (writer-context w) (scheme-params (checked-scheme binding)) actuals of
        Some codes -> (let variant = (case checked-conditional-target binding of
          Some (owner, dictionary, slot) -> object-conditional-unit owner dictionary slot name codes provider
          None -> object-variant name codes provider) in
          case variant of
          Some unit -> external-call-unit definitions locals w sp unit (concrete-scheme (checked-scheme binding) actuals) givens args
          None -> unsupported w sp (cat ["checked external variant is absent from the runtime object: ", name, " [", native-classes codes, "]"]))
        None -> unsupported w sp "external function needs checked representation specialization")
      None -> unsupported w sp (cat ["external runtime implementation is unavailable: ", name]))
  external-call-unit :: List CoreDefinition -> List Local -> Writer -> Span -> RuntimeUnit -> Scheme -> List String -> List CoreTerm -> (Writer, String)
  external-call-unit definitions locals w sp unit sc givens args =
        let evidence-count = list-length (scheme-requirements sc) in
        let native-count = list-length (unit-params unit) in
        if list-length givens /= evidence-count then unsupported w sp "external function context disagrees with its checked scheme" else
        if evidence-count <= native-count then
        (case external-shape (native-count - evidence-count) (scheme-body sc) Nil of
          Some (params, result-type) -> (case (class-vector (writer-context w) (requirement-types (scheme-requirements sc) <> params), word-class (writer-context w) result-type, unit-result unit) of
            (Some expected, Some result, Some actual-result) -> if not (same-classes expected (unit-params unit)) || result /= actual-result then unsupported w sp "external function word ABI disagrees with its checked scheme" else
              let ready = request-demand (ExternalDemand unit) w in
              if list-length args == list-length params then
                (case expressions definitions locals ready args of (next, values) -> call next (llvm-object-symbol (unit-symbol unit)) (givens <> values))
              else if list-length args < list-length params then
                (case call ready (llvm-object-symbol (unit-closure unit)) Nil of
                  (next, closure-value) -> case apply-words next closure-value givens of (applied, value) -> apply-terms definitions locals applied value args)
              else (case expressions definitions locals ready (take-terms (list-length params) args) of
                (next, values) -> case call next (llvm-object-symbol (unit-symbol unit)) (givens <> values) of
                  (called, value) -> apply-terms definitions locals called value (drop-terms (list-length params) args))
            other -> unsupported w sp (cat ["external function lacks concrete checked word representations: ",
              unit-symbol unit, " with checked type ", type-text (scheme-body sc)]))
          None -> unsupported w sp "external unit arity exceeds its checked function telescope")
        else unsupported w sp "external function context disagrees with its checked scheme"
  runtime-type-equal :: UType -> UType -> Bool
  runtime-type-equal first second = valid-type first && valid-type second && (case store-errors (unify (Span 0 0 1 1) (without-index-levels first) (without-index-levels second) (empty-store "runtime index carrier")) of Nil -> True; other -> False)
  index-expression :: List Local -> Writer -> Span -> UType -> (Writer, String)
  index-expression locals w sp value = if not (typed-index-admissible value) then unsupported w sp "implicit value argument has no solved checked index witness" else case value of
    UIndexByteLength input -> (case index-expression locals w sp input of
      (ready, bytes) -> case call ready "@cinch_bytes_len" [bytes] of
        (measured, length) -> case call measured "@cinch_nat_from_i64" [length] of
          (done, result) -> (case value-carrier (type-kind input) of Some carrier -> (count-op False carrier bytes done, result); None -> unsupported done sp "byte index input has no actual carrier"))
    UIndexForget input -> index-expression locals w sp input
    UIndexPromote input -> (case value-carrier (type-kind input) of
      Some carrier -> if named carrier "Nat" then (case index-expression locals w sp input of
        (ready, natural) -> case call ready "@cinch_int_from_nat" [natural] of (done, result) -> (count-op False carrier natural done, result))
        else if named carrier "Int" then index-expression locals w sp input else unsupported w sp "index promotion needs its checked mathematical carrier"
      None -> unsupported w sp "index promotion has no actual input carrier")
    UIndexMath op first second -> (case value-carrier (type-kind first) of
      Some carrier -> index-math-expression locals w sp carrier op first second
      None -> unsupported w sp "index arithmetic has no checked carrier")
    other -> (case (value-carrier (type-kind value), index-of-type value) of
      (Some carrier, Some (IRigid id name level)) -> read-index-local locals w sp id carrier
      (Some carrier, Some (IInteger n)) -> if number carrier then decimal w carrier (int-to-string n) else if raw-integer carrier then (w, int-to-string n) else unsupported w sp "index literal needs a runtime integer carrier"
      (Some carrier, Some (IAdd first second)) -> index-math-expression locals w sp carrier "+" (UIndex carrier first) (UIndex carrier second)
      (Some carrier, Some (ISubtract first second)) -> index-math-expression locals w sp carrier "-" (UIndex carrier first) (UIndex carrier second)
      (Some carrier, Some (IMultiply first second)) -> index-math-expression locals w sp carrier "*" (UIndex carrier first) (UIndex carrier second)
      other -> unsupported w sp "index witness needs checked runtime reification")
  index-math-expression :: List Local -> Writer -> Span -> UType -> String -> UType -> UType -> (Writer, String)
  index-math-expression locals w sp carrier operation first second = if not (number carrier) then unsupported w sp "index arithmetic requires a mathematical runtime carrier" else
    let suffix = if same operation "+" then "add" else if same operation "*" then "mul" else "sub" in
    case index-expression locals w sp first of
      (one, a) -> case index-expression locals one sp second of
        (two, b) -> case call two (cat ["@cinch_", runtime-number carrier, "_", suffix]) [a, b] of
          (done, result) -> (count-op False carrier b (count-op False carrier a done), result)
  implicit-value-words :: List Local -> Writer -> Span -> List Quant -> List UType -> (Writer, List String)
  implicit-value-words locals w sp params actuals = case (params, actuals) of
    (Nil, Nil) -> (w, Nil)
    (Cons q rest, Cons actual more) -> (case value-carrier (quant-kind q) of
      Some carrier -> (case index-expression locals w sp actual of
        (ready, word) -> case implicit-value-words locals ready sp rest more of (done, values) -> (done, Cons word values))
      None -> implicit-value-words locals w sp rest more)
    other -> (refuse w sp "implicit value argument arity disagrees with the checked scheme", Nil)
  value-types :: List (Nat, UType) -> List UType
  value-types values = case values of Nil -> Nil; Cons (id, ty) rest -> Cons ty (value-types rest)
  runtime-index-locals :: List (Nat, UType) -> Nat -> List Local
  runtime-index-locals values index = case values of Nil -> Nil; Cons (id, ty) rest -> Cons (Local id ty (cat ["%arg", nat-to-string index])) (runtime-index-locals rest (index + 1))
  function-call :: List CoreDefinition -> List Local -> Writer -> Span -> CoreDefinition -> List UType -> List Nat -> List String -> List CoreTerm -> (Writer, String)
  function-call definitions locals w sp d actuals classes givens args = case definition-context d classes w of
    Some context -> let parameters = definition-parameters d in
      let required = runtime-givens w d in
      let dependencies = definition-value-dependencies w d in
      let indices = opening-value-types (core-openings d) in
      let all-types = value-field-types dependencies <> given-types required <> value-types indices <> pattern-types parameters in
      let count = list-length parameters in
      if list-length givens > list-length required then unsupported w sp "function context exceeds its checked ABI" else
        if list-length givens < list-length required && (list-length args > 0 || list-length indices > 0) then unsupported w sp "implicit values require the complete checked dictionary context" else
        if list-length indices > 0 && (case field-owner (core-name d) (program-instances (writer-program w)) of Some owner -> True; None -> False) then unsupported w sp "dictionary method value parameters need their checked runtime ABI" else
        case definition-self-values d locals w of
          (prepared, saved) -> case (if list-length indices == 0 then (prepared, Nil) else implicit-value-words locals prepared sp (scheme-params (core-scheme d)) actuals) of
            (indexed, witnesses) -> if list-length givens < list-length required || list-length args < count then
              (case class-vector context all-types of
                Some parameter-classes -> case expressions definitions locals (demand-worker (core-name d) classes indexed) args of
                  (ready, values) -> closure sp (specialized-name (core-name d) classes) parameter-classes (saved <> givens <> witnesses <> values) ready
                None -> unsupported indexed sp "function parameters need known closure representations")
              else case expressions definitions locals (demand-worker (core-name d) classes indexed) (take-terms count args) of
                (ready, values) -> case call ready (symbol (specialized-name (core-name d) classes)) (saved <> givens <> witnesses <> values) of
                  (called, result) -> apply-terms definitions locals called result (drop-terms count args)
    None -> unsupported w sp "function parameters need first-order or erased representation classes"
  instance-definitions :: List CoreInstance -> List CoreDefinition
  instance-definitions instances = case instances of Nil -> Nil; Cons first rest -> field-definitions (instance-fields first) <> instance-definitions rest
  field-definitions :: List CoreDictionaryField -> List CoreDefinition
  field-definitions fields = case fields of Nil -> Nil; Cons first rest -> Cons (dictionary-field-definition first) (field-definitions rest)
  instance-named :: String -> List CoreInstance -> Option CoreInstance
  instance-named name instances = case instances of Nil -> None; Cons first rest -> if same name (instance-name first) then Some first else instance-named name rest
  field-named :: String -> List CoreDictionaryField -> Option CoreDictionaryField
  field-named name fields = case fields of Nil -> None; Cons first rest -> if same name (core-name (dictionary-field-definition first)) then Some first else field-named name rest
  field-owner :: String -> List CoreInstance -> Option CoreInstance
  field-owner name instances = case instances of Nil -> None; Cons first rest -> case field-named name (instance-fields first) of Some field -> Some first; None -> field-owner name rest
  field-at :: Nat -> List CoreDictionaryField -> Option CoreDictionaryField
  field-at slot fields = case fields of Nil -> None; Cons first rest -> if dictionary-field-slot first == slot then Some first else field-at slot rest
  take-givens :: Nat -> List CoreGiven -> List CoreGiven
  take-givens count givens = if count == 0 then Nil else case givens of Nil -> Nil; Cons first rest -> Cons first (take-givens (count - 1) rest)
  drop-givens :: Nat -> List CoreGiven -> List CoreGiven
  drop-givens count givens = if count == 0 then givens else case givens of Nil -> Nil; Cons first rest -> drop-givens (count - 1) rest
  remove-given :: Nat -> List CoreGiven -> List CoreGiven
  remove-given index givens = case givens of Nil -> Nil; Cons first rest -> if index == 0 then rest else Cons first (remove-given (index - 1) rest)
  runtime-givens :: Writer -> CoreDefinition -> List CoreGiven
  runtime-givens w d = case field-owner (core-name d) (program-instances (writer-program w)) of
    Some owner -> remove-given (list-length (scheme-requirements (instance-scheme owner))) (core-givens d)
    None -> core-givens d
  given-types :: List CoreGiven -> List UType
  given-types givens = case givens of Nil -> Nil; Cons first rest -> Cons (given-type first) (given-types rest)
  given-bindings :: List CoreGiven -> Nat -> List Local
  given-bindings givens index = case givens of Nil -> Nil; Cons first rest -> Cons (GivenLocal (given-symbol first) (given-type first) (cat ["%arg", nat-to-string index])) (given-bindings rest (index + 1))
  given-roots :: List CoreGiven -> Nat -> List Local
  given-roots givens index = case givens of Nil -> Nil; Cons first rest -> Cons (Discard (given-type first) (cat ["%arg", nat-to-string index])) (given-roots rest (index + 1))
  given-word :: String -> List Local -> Option (UType, String)
  given-word symbol locals = case locals of
    Nil -> None
    Cons (GivenLocal name ty word) rest -> if same name symbol then Some (ty, word) else given-word symbol rest
    Cons other rest -> given-word symbol rest
  known-self :: String -> List Local -> Option Local
  known-self symbol locals = case locals of
    Nil -> None
    Cons (KnownSelf name owner classes context) rest -> if same symbol name then Some (KnownSelf name owner classes context) else known-self symbol rest
    Cons other rest -> known-self symbol rest
  self-binding :: Writer -> CoreDefinition -> List Nat -> List Local
  self-binding w d classes = case field-owner (core-name d) (program-instances (writer-program w)) of
    Some owner -> let count = list-length (scheme-requirements (instance-scheme owner)) in
      (case drop-givens count (core-givens d) of
        Cons self rest -> [KnownSelf (given-symbol self) (instance-name owner) (take-classes (type-param-count (scheme-params (instance-scheme owner))) classes) (take-givens count (core-givens d))]
        Nil -> Nil)
    None -> Nil
  field-present :: Nat -> List CoreDictionaryField -> Bool
  field-present slot fields = case fields of Nil -> False; Cons first rest -> dictionary-field-slot first == slot || field-present slot rest
  merge-value-fields :: List CoreDictionaryField -> List CoreDictionaryField -> List CoreDictionaryField
  merge-value-fields first second = case first of
    Nil -> second
    Cons field rest -> if field-present (dictionary-field-slot field) second then merge-value-fields rest second else Cons field (merge-value-fields rest second)
  method-seen :: String -> List String -> Bool
  method-seen name names = case names of Nil -> False; Cons first rest -> same name first || method-seen name rest
  value-dependencies :: Writer -> CoreInstance -> CoreDefinition -> List String -> List CoreDictionaryField
  value-dependencies w owner d seen = if method-seen (core-name d) seen then Nil else
    case drop-givens (list-length (scheme-requirements (instance-scheme owner))) (core-givens d) of
      Cons self rest -> clause-value-dependencies w owner (given-symbol self) (Cons (core-name d) seen) (core-clauses d)
      Nil -> Nil
  clause-value-dependencies :: Writer -> CoreInstance -> String -> List String -> List CoreClause -> List CoreDictionaryField
  clause-value-dependencies w owner key seen clauses = case clauses of
    Nil -> Nil
    Cons (MkCoreClause sp patterns body) rest -> merge-value-fields (term-value-dependencies w owner key seen body) (clause-value-dependencies w owner key seen rest)
  term-value-dependencies :: Writer -> CoreInstance -> String -> List String -> CoreTerm -> List CoreDictionaryField
  term-value-dependencies w owner key seen term = case term of
    CMethod sp ty name description slot actuals (Cons (CEGiven at given-ty symbol) extra) ->
      if same key symbol then (case field-at slot (instance-fields owner) of
        Some field -> if strict-value-field w owner field then [field] else value-dependencies w owner (dictionary-field-definition field) seen
        None -> Nil) else Nil
    CApply sp ty first second -> merge-value-fields (term-value-dependencies w owner key seen first) (term-value-dependencies w owner key seen second)
    CApplyEff sp ty row first second -> merge-value-fields (term-value-dependencies w owner key seen first) (term-value-dependencies w owner key seen second)
    CErasedApply sp ty row f witness -> term-value-dependencies w owner key seen f
    CLambda sp ty pattern body -> term-value-dependencies w owner key seen body
    CLet sp ty id name sc value body -> merge-value-fields (term-value-dependencies w owner key seen value) (term-value-dependencies w owner key seen body)
    CRecursiveFunctions sp ty members body ->
      recursive-value-dependencies w owner key seen (Cons body (recursive-functions members))
    CRecursiveValues sp ty region members body ->
      recursive-value-dependencies w owner key seen (recursive-functions members <> [body])
    CScope sp ty region evidence callback -> term-value-dependencies w owner key seen callback
    CMemoScope sp ty region body -> term-value-dependencies w owner key seen body
    CSpawn sp ty token body -> merge-value-fields (term-value-dependencies w owner key seen token) (term-value-dependencies w owner key seen body)
    CJoin sp ty token body -> merge-value-fields (term-value-dependencies w owner key seen token) (term-value-dependencies w owner key seen body)
    CWith sp ty given value body -> merge-value-fields (term-value-dependencies w owner key seen value) (term-value-dependencies w owner key seen body)
    CIf sp ty condition yes no -> merge-value-fields (term-value-dependencies w owner key seen condition) (merge-value-fields (term-value-dependencies w owner key seen yes) (term-value-dependencies w owner key seen no))
    CCase sp ty value alternatives -> merge-value-fields (term-value-dependencies w owner key seen value) (term-value-dependencies w owner key seen alternatives)
    CTuple sp ty fields -> term-value-dependencies w owner key seen fields
    CPolyIntro sp ty poly-ids fields -> term-value-dependencies w owner key seen fields
    CPolyElim sp ty fields poly-args -> term-value-dependencies w owner key seen fields
    CPrimitive sp ty op args -> term-value-dependencies w owner key seen args
    CProved sp ty evidence body -> term-value-dependencies w owner key seen body
    CRefine sp ty evidence body -> term-value-dependencies w owner key seen body
    CForget sp ty body -> term-value-dependencies w owner key seen body
    CRequire sp ty body -> term-value-dependencies w owner key seen body
    CDischarge sp ty evidence body -> term-value-dependencies w owner key seen body
    CGuard sp ty guard body -> merge-value-fields (term-value-dependencies w owner key seen guard) (term-value-dependencies w owner key seen body)
    CArgument sp first rest -> merge-value-fields (term-value-dependencies w owner key seen first) (term-value-dependencies w owner key seen rest)
    CAlternative sp pattern body rest -> merge-value-fields (term-value-dependencies w owner key seen body) (term-value-dependencies w owner key seen rest)
    other -> Nil
  recursive-value-dependencies :: Writer -> CoreInstance -> String -> List String -> List CoreTerm -> List CoreDictionaryField
  recursive-value-dependencies w owner key seen terms = case terms of
    Nil -> Nil
    Cons first rest -> merge-value-fields (term-value-dependencies w owner key seen first)
      (recursive-value-dependencies w owner key seen rest)
  definition-value-dependencies :: Writer -> CoreDefinition -> List CoreDictionaryField
  definition-value-dependencies w d = case field-owner (core-name d) (program-instances (writer-program w)) of
    Some owner -> value-dependencies w owner d Nil
    None -> Nil
  value-field-types :: List CoreDictionaryField -> List UType
  value-field-types fields = case fields of Nil -> Nil; Cons first rest -> Cons (scheme-body (core-scheme (dictionary-field-definition first))) (value-field-types rest)
  self-value-word :: String -> Nat -> List Local -> Option (UType, String)
  self-value-word owner slot locals = case locals of
    Nil -> None
    Cons (SelfValue name index ty word) rest -> if same owner name && slot == index then Some (ty, word) else self-value-word owner slot rest
    Cons other rest -> self-value-word owner slot rest
  copy-self-values :: String -> List CoreDictionaryField -> List Local -> Writer -> (Writer, List String)
  copy-self-values owner fields locals w = case fields of
    Nil -> (w, Nil)
    Cons field rest -> case self-value-word owner (dictionary-field-slot field) locals of
      Some (ty, word) -> case copy-self-values owner rest locals (count-op True ty word w) of (done, values) -> (done, Cons word values)
      None -> (refuse w (Span 0 0 1 1) "self value dependency is absent from its initialized environment", Nil)
  definition-self-values :: CoreDefinition -> List Local -> Writer -> (Writer, List String)
  definition-self-values d locals w = case field-owner (core-name d) (program-instances (writer-program w)) of
    Some owner -> copy-self-values (instance-name owner) (definition-value-dependencies w d) locals w
    None -> (w, Nil)
  self-value-bindings :: String -> List CoreDictionaryField -> Nat -> List Local
  self-value-bindings owner fields index = case fields of
    Nil -> Nil
    Cons first rest -> Cons (SelfValue owner (dictionary-field-slot first) (scheme-body (core-scheme (dictionary-field-definition first))) (cat ["%arg", nat-to-string index])) (self-value-bindings owner rest (index + 1))
  worker-self-values :: Writer -> CoreDefinition -> List CoreDictionaryField -> List Local
  worker-self-values w d fields = case field-owner (core-name d) (program-instances (writer-program w)) of Some owner -> self-value-bindings (instance-name owner) fields 0; None -> Nil
  self-values-used :: String -> CoreTerm -> List Local -> Bool
  self-values-used owner body locals = case locals of
    Nil -> False
    Cons (KnownSelf key name classes context) rest -> (same owner name && given-uses key body) || self-values-used owner body rest
    Cons other rest -> self-values-used owner body rest
  strict-fields :: Writer -> CoreInstance -> List CoreDictionaryField -> List CoreDictionaryField
  strict-fields w owner fields = case fields of Nil -> Nil; Cons first rest -> if strict-value-field w owner first then Cons first (strict-fields w owner rest) else strict-fields w owner rest
  values-ready :: String -> List CoreDictionaryField -> List Local -> Bool
  values-ready owner fields locals = case fields of Nil -> True; Cons first rest -> (case self-value-word owner (dictionary-field-slot first) locals of Some value -> True; None -> False) && values-ready owner rest locals
  ready-value :: Writer -> CoreInstance -> List Local -> List CoreDictionaryField -> List CoreDictionaryField -> Option (CoreDictionaryField, List CoreDictionaryField)
  ready-value w owner locals before fields = case fields of
    Nil -> None
    Cons first rest -> if values-ready (instance-name owner) (value-dependencies w owner (dictionary-field-definition first) Nil) locals then Some (first, before <> rest) else ready-value w owner locals (before <> [first]) rest
  initialize-values :: List CoreDefinition -> CoreInstance -> List Nat -> List CoreGiven -> List Local -> String -> List CoreDictionaryField -> Writer -> (Writer, List Local)
  initialize-values definitions owner classes context locals pointer fields w = case fields of
    Nil -> (w, locals)
    Cons first rest -> case ready-value w owner locals Nil fields of
      None -> (refuse w (Span 0 0 1 1) "cyclic strict dictionary values need recursive environment lowering", locals)
      Some (selected, pending) -> let d = dictionary-field-definition selected in
        case copy-givens context locals w of
          (copied, values) -> case function-call definitions locals copied (Span 0 0 1 1) d Nil classes values Nil of
            (ready, word) -> initialize-values definitions owner classes context (Cons (SelfValue (instance-name owner) (dictionary-field-slot selected) (scheme-body (core-scheme d)) word) locals) pointer pending (store-one ready pointer (1 + dictionary-field-slot selected) word)
  dictionary-name :: String -> List Nat -> String
  dictionary-name name classes = cat [specialized-name name classes, ".dictionary"]
  copy-givens :: List CoreGiven -> List Local -> Writer -> (Writer, List String)
  copy-givens givens locals w = case givens of
    Nil -> (w, Nil)
    Cons first rest -> case given-word (given-symbol first) locals of
      Some (ty, value) -> case copy-givens rest locals (count-op True ty value w) of (done, values) -> (done, Cons value values)
      None -> (refuse w (Span 0 0 1 1) "factory context is absent from its actual lexical scope", Nil)
  evidence-values :: List CoreDefinition -> List Local -> Writer -> CoreEvidence -> (Writer, List String)
  evidence-values definitions locals w args = case args of
    CEArgumentsEnd sp -> (w, Nil)
    CEArgument sp first rest -> case evidence-value definitions locals w first of
      (ready, value) -> case evidence-values definitions locals ready rest of (done, values) -> (done, Cons value values)
    other -> (refuse w (Span 0 0 1 1) "malformed dictionary evidence argument spine", Nil)
  evidences :: List CoreDefinition -> List Local -> Writer -> List CoreEvidence -> (Writer, List String)
  evidences definitions locals w args = case args of
    Nil -> (w, Nil)
    Cons first rest -> case evidence-value definitions locals w first of
      (ready, value) -> case evidences definitions locals ready rest of (done, values) -> (done, Cons value values)
  strict-value-field :: Writer -> CoreInstance -> CoreDictionaryField -> Bool
  strict-value-field w owner field = let d = dictionary-field-definition field in
    list-length (definition-parameters d) == 0 && list-length (runtime-givens w d) == list-length (scheme-requirements (instance-scheme owner))
  has-strict-values :: Writer -> CoreInstance -> List CoreDictionaryField -> Bool
  has-strict-values w owner fields = case fields of Nil -> False; Cons first rest -> strict-value-field w owner first || has-strict-values w owner rest
  evidence-value :: List CoreDefinition -> List Local -> Writer -> CoreEvidence -> (Writer, String)
  evidence-value definitions locals w evidence = case evidence of
    CEGiven sp ty symbol -> (case known-self symbol locals of
      Some (KnownSelf name owner classes context) -> case instance-named owner (program-instances (writer-program w)) of
        Some factory -> if has-strict-values w factory (instance-fields factory) then unsupported w sp "materializing self evidence with strict value fields needs initialization dependencies" else
          (case copy-givens context locals w of (ready, values) -> call (request-demand (DictionaryDemand owner classes) ready) (symbol-for-dictionary owner classes) values)
        None -> unsupported w sp "self evidence has no checked factory factory"
      other -> case given-word symbol locals of
        Some (actual, word) -> (count-op True actual word w, word)
        None -> unsupported w sp "dictionary evidence is absent from its lexical scope")
    CEInstance sp ty name actuals args -> case instance-named name (program-instances (writer-program w)) of
      Some factory -> case scheme-classes (writer-context w) (scheme-params (instance-scheme factory)) actuals of
        Some classes -> case evidence-values definitions locals w args of
          (ready, values) -> if list-length values == list-length (scheme-requirements (instance-scheme factory)) then
            call (request-demand (DictionaryDemand name classes) ready) (symbol-for-dictionary name classes) values
            else unsupported ready sp "factory factory context arity disagrees with checked evidence"
        None -> unsupported w sp "factory factory needs runtime representation specialization"
      None -> external-evidence definitions locals w sp ty name actuals args
    other -> unsupported w (Span 0 0 1 1) "unresolved dictionary evidence cannot be lowered"
  instance-binding :: String -> List CheckedBinding -> Option CheckedBinding
  instance-binding name bindings = case bindings of
    Nil -> None
    Cons first rest -> if same name (checked-name first) && (same (checked-role first) "instance" || same (checked-role first) "implicit-instance") then Some first else instance-binding name rest
  extend-context :: List (Nat, Nat) -> RuntimeContext -> RuntimeContext
  extend-context bindings context = case context of RuntimeContext info bounds rigids pending done inlining -> RuntimeContext info (bindings <> bounds) rigids pending done inlining
  external-field-map :: Writer -> CoreClass -> Scheme -> List Nat -> List (Nat, Nat, List Nat) -> Option (List Nat)
  external-field-map w description factory factory-codes slots = case slots of
    Nil -> Some Nil
    Cons (logical, physical, codes) rest -> (case method-at logical (class-methods description) of
      Some member -> (case specialize-method description factory member of
        Some sc -> (case class-bindings (scheme-params sc) (factory-codes <> codes) of
          Some bindings -> (case (word-class (extend-context bindings (writer-context w)) (scheme-body sc), external-field-map w description factory factory-codes rest) of
            (Some code, Some more) -> Some (Cons (if list-length (scheme-requirements sc) == 0 then code else 1) more)
            other -> None)
          None -> None)
        None -> None)
      None -> None)
  external-evidence :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> String -> List UType -> CoreEvidence -> (Writer, String)
  external-evidence definitions locals w sp ty name actuals args = case (program-object (writer-program w), instance-binding name (program-bindings (writer-program w))) of
    (Some provider, Some binding) -> (case scheme-classes (writer-context w) (scheme-params (checked-scheme binding)) actuals of
      Some codes -> (case object-dictionary name codes provider of
        Some (unit, owner, context-count, fields) ->
          let factory = checked-scheme binding in
          let sc = concrete-scheme factory actuals in
          (case (class-owner (scheme-body sc), find-class owner (program-classes (writer-program w)), object-family owner provider) of
            (Some actual-owner, Some description, Some (declared, slots)) -> if not (same owner actual-owner) || declared /= list-length (class-methods description) || context-count /= list-length (scheme-requirements sc) then unsupported w sp "external factory disagrees with its checked class or context" else
              -- Specialize the closed declaration. The instantiated use can
              -- contain caller-local rigid variables, including phantom types.
              (case (external-field-map w description factory codes slots, class-vector (writer-context w) (requirement-types (scheme-requirements sc)), unit-result unit) of
                (Some expected-fields, Some expected-params, Some 1) -> if not (same-classes expected-fields fields && same-classes expected-params (unit-params unit)) then unsupported w sp "external factory word ABI disagrees with its checked class fields" else
                  (case evidence-values definitions locals w args of
                    (ready, values) -> if list-length values /= context-count then unsupported ready sp "external factory context arity disagrees with checked evidence" else
                      call (request-demand (ExternalDemand unit) ready) (llvm-object-symbol (unit-symbol unit)) values)
                other -> unsupported w sp "external factory lacks checked runtime field representations")
            other -> unsupported w sp "external factory has no matching checked method family")
        None -> unsupported w sp (cat ["checked factory variant is absent from the runtime object: ", name, " [", native-classes codes, "]"]))
      None -> unsupported w sp "external factory needs checked representation specialization")
    other -> unsupported w sp (cat ["checked factory has no executable source factory: ", name])
  symbol-for-dictionary :: String -> List Nat -> String
  symbol-for-dictionary name classes = symbol (dictionary-name name classes)
  method-at :: Nat -> List CoreClassMethod -> Option CoreClassMethod
  method-at slot methods = case methods of Nil -> None; Cons first rest -> if class-method-slot first == slot then Some first else method-at slot rest
  class-owner :: UType -> Option String
  class-owner ty = case type-head ty of UCon name kind -> Some name; other -> None
  -- A static instance names its method's defining unit, so a projection
  -- out of the instance dictionary followed by an indirect apply is a
  -- direct call to that unit at the method's own representation. The
  -- result is the representation codes to specialize the unit with and the
  -- unit itself; a factory with a context, a strict value field or a
  -- method the unit cannot be reached from keeps the projection.
  static-instance-method :: Writer -> String -> String -> Nat -> List UType -> List CoreEvidence -> Option (List Nat, List Nat, CoreDefinition)
  static-instance-method w name owner slot actuals evidence = case evidence of
    Cons first Nil -> case first of
      CEInstance sp ty factory factory-actuals (CEArgumentsEnd end) -> static-instance-method-at w name owner slot actuals factory factory-actuals
      other -> None
    other -> None
  static-instance-method-at :: Writer -> String -> String -> Nat -> List UType -> String -> List UType -> Option (List Nat, List Nat, CoreDefinition)
  static-instance-method-at w name owner slot actuals factory factory-actuals =
      if not (method-reference name owner slot (program-bindings (writer-program w))) then None else
      (case instance-named factory (program-instances (writer-program w)) of
        Some candidate -> if (case scheme-requirements (instance-scheme candidate) of Nil -> True; other -> False) then
          (case class-owner (scheme-body (instance-scheme candidate)) of
            Some actual -> if not (same owner actual) then None else
              (case field-at slot (instance-fields candidate) of
                Some field -> if strict-value-field w candidate field then None else
                  (case (find-class owner (program-classes (writer-program w)), method-at slot (class-methods-of owner w)) of
                    (Some description, Some member) -> (case (method-own-classes w member actuals, scheme-classes (writer-context w) (scheme-params (instance-scheme candidate)) factory-actuals) of
                      (Some own-codes, Some classes) -> let codes = classes <> own-codes in let d = dictionary-field-definition field in
                        if (case runtime-givens w d of Nil -> True; other -> False)
                          && (case definition-value-dependencies w d of Nil -> True; other -> False)
                          && (case core-openings d of Nil -> True; other -> False)
                          && (case core-clauses d of Nil -> False; other -> True)
                          && (case definition-context d codes w of Some context -> True; None -> False)
                          then Some (codes, own-codes, d) else None
                      other -> None)
                    other -> None)
                None -> None)
            None -> None)
          else None
        None -> None)
  -- The declared methods of a class, in slot order, without demanding the
  -- class again at each caller.
  class-methods-of :: String -> Writer -> List CoreClassMethod
  class-methods-of owner w = case find-class owner (program-classes (writer-program w)) of
    Some description -> class-methods description
    None -> Nil
  method-value :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> String -> String -> Nat -> List UType -> List CoreEvidence -> (Writer, String)
  method-value definitions locals w sp ty name owner slot actuals evidence =
    case static-instance-method w name owner slot actuals evidence of
      Some (codes, own-codes, d) -> function-call definitions locals (note-version owner slot own-codes w) sp d Nil codes Nil Nil
      None -> projected-method-value definitions locals w sp ty name owner slot actuals evidence
  projected-method-value :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> String -> String -> Nat -> List UType -> List CoreEvidence -> (Writer, String)
  projected-method-value definitions locals w sp ty name owner slot actuals evidence = case find-class owner (program-classes (writer-program w)) of
    Some description -> case method-at slot (class-methods description) of
      Some member -> if not (method-reference name owner slot (program-bindings (writer-program w))) then unsupported w sp (cat ["dictionary field does not belong to the checked global method: ", name]) else
        (case method-own-classes w member actuals of
          None -> unsupported w sp "method type arguments need runtime representation classes"
          Some own-codes -> let prepared = note-version owner slot own-codes w in
            (case evidence of
              Cons self rest -> case self of
                CEGiven at given-ty given-name -> (case known-self given-name locals of
                  Some (KnownSelf key instance-name classes context) ->
                    self-method definitions locals prepared sp ty name owner slot classes own-codes instance-name context rest
                  other -> project-method definitions locals prepared sp ty description slot own-codes self rest)
                other -> project-method definitions locals prepared sp ty description slot own-codes self rest
              Nil -> unsupported w sp "method has no checked receiver evidence"))
      None -> unsupported w sp "method slot is absent from its declaring class"
    None -> unsupported w sp (cat ["method has no checked declaring class: ", owner, ".", name])
  self-method :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> String -> String -> Nat -> List Nat -> List Nat -> String -> List CoreGiven -> List CoreEvidence -> (Writer, String)
  self-method definitions locals w sp ty name owner slot classes own-codes factory context extra = case instance-named factory (program-instances (writer-program w)) of
    Some factory -> if (case class-owner (scheme-body (instance-scheme factory)) of Some actual -> same owner actual; None -> False) then
      (case field-at slot (instance-fields factory) of
        Some field -> if strict-value-field w factory field then
          if list-length own-codes > 0 then unsupported w sp "polymorphic strict self values need representation-indexed initialization" else
          (case self-value-word (instance-name factory) slot locals of
            Some (actual, word) -> if list-length extra == 0 then (count-op True actual word w, word) else unsupported w sp "a strict value field cannot consume extra method evidence"
            None -> unsupported w sp "self value was used before its dictionary slot was initialized")
          else case copy-givens context locals w of
            (copied, prefix) -> case evidences definitions locals copied extra of
              (ready, more) -> function-call definitions locals ready sp (dictionary-field-definition field) Nil (classes <> own-codes) (prefix <> more) Nil
        None -> unsupported w sp "self method is absent from its actual factory")
      else unsupported w sp "self evidence disagrees with the selected declaring class"
    None -> unsupported w sp "self method has no actual checked factory"
  project-method :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreClass -> Nat -> List Nat -> CoreEvidence -> List CoreEvidence -> (Writer, String)
  project-method definitions locals w sp ty description slot own-codes receiver extra = case method-physical-slot slot own-codes (class-method-slots w description) of
    Some physical -> dynamic-method definitions locals w sp ty physical receiver extra
    None -> unsupported w sp (cat ["method representation has no planned declaring-class slot: ", class-name description, ":", nat-to-string slot, " [", native-classes own-codes, "]"])
  dynamic-method :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> Nat -> CoreEvidence -> List CoreEvidence -> (Writer, String)
  dynamic-method definitions locals w sp ty slot receiver extra = case evidence-value definitions locals w receiver of
    (ready, dictionary) -> let (one, pointer) = fresh ready "%ptr" in
      case load-word (line one (cat ["  ", pointer, " = inttoptr i64 ", dictionary, " to ptr"])) pointer (nat-to-string (1 + slot)) of
        (loaded, field) ->
          let field-ty = case extra of Nil -> ty; other -> UFun (UCon "Unit" KType) ty in
          let retained = count-op True field-ty field loaded in
          let released = count-op False (evidence-type receiver) dictionary retained in
          case evidences definitions locals released extra of
            (given, values) -> apply-values given field values
  apply-values :: Writer -> String -> List String -> (Writer, String)
  apply-values w function values = case values of Nil -> (w, function); Cons first rest -> case apply-one w function first of (done, result) -> apply-values done result rest
  field-map-codes :: List Nat -> Nat -> Nat
  field-map-codes codes factor = case codes of Nil -> 0; Cons first rest -> first * factor + field-map-codes rest (factor * 4)
  request-object-shape :: Span -> List Nat -> Writer -> (Writer, Nat)
  request-object-shape sp classes w = case w of
    Writer next globals code errors (LayoutPlan groups tuples names cells) context ->
      let packed = list-length classes + field-map-codes classes 4294967296 in
      case known-layout packed tuples of
        Some id -> (w, id)
        None -> if list-length classes > 16 || groups >= 1022 then (refuse w sp "dictionary needs an extended runtime descriptor", 0) else
          let id = 64 * (groups + 1) in
          (Writer next globals code errors (LayoutPlan (groups + 1) (Cons (id, packed) tuples) names (Cons (id, packed) cells)) context, id)
  dictionary-map :: CoreInstance -> List MethodSlot -> Writer -> Option (List Nat)
  dictionary-map owner fields w = case fields of
    Nil -> Some Nil
    Cons (MethodSlot logical physical own-codes) rest -> case field-at logical (instance-fields owner) of
      Some field -> let d = dictionary-field-definition field in
        (case dictionary-map owner rest w of
          Some more -> if strict-value-field w owner field then
            if list-length own-codes > 0 then None else (case word-class (writer-context w) (scheme-body (core-scheme d)) of Some code -> Some (Cons code more); None -> None)
            else Some (Cons 1 more)
          None -> None)
      None -> None
  factory-bindings :: List Requirement -> Nat -> List CoreGiven
  factory-bindings requirements index = case requirements of Nil -> Nil; Cons first rest -> Cons (CGiven (Span 0 0 1 1) (cat ["#factory-", nat-to-string index]) (requirement-type first)) (factory-bindings rest (index + 1))
  dictionary-fields :: List CoreDefinition -> CoreInstance -> List Nat -> List CoreGiven -> List Local -> String -> List MethodSlot -> Writer -> Writer
  dictionary-fields definitions owner classes context locals pointer fields w = case fields of
    Nil -> w
    Cons (MethodSlot logical physical own-codes) rest -> case field-at logical (instance-fields owner) of
      Some field -> if strict-value-field w owner field then dictionary-fields definitions owner classes context locals pointer rest w else
        let d = dictionary-field-definition field in
        (case copy-givens context locals w of
          (copied, values) -> case function-call definitions locals copied (Span 0 0 1 1) d Nil (classes <> own-codes) values Nil of
            (ready, value) -> let stored = store-one ready pointer (1 + physical) value in
              dictionary-fields definitions owner classes context locals pointer rest stored)
      None -> refuse w (Span 0 0 1 1) "planned dictionary slot has no actual instance method"
  store-one :: Writer -> String -> Nat -> String -> Writer
  store-one w pointer index value = let (ready, slot) = fresh w "%ptr" in
    line (line ready (cat ["  ", slot, " = getelementptr i64, ptr ", pointer, ", i64 ", nat-to-string index])) (cat ["  store i64 ", value, ", ptr ", slot])
  zeros :: Nat -> List String
  zeros count = if count == 0 then Nil else Cons "0" (zeros (count - 1))
  dictionary-worker :: List CoreDefinition -> String -> List Nat -> Writer -> Writer
  dictionary-worker definitions name classes w = case instance-named name (program-instances (writer-program w)) of
    Some factory -> case class-owner (scheme-body (instance-scheme factory)) of
      Some owner -> (case find-class owner (program-classes (writer-program w)) of
        Some description -> dictionary-worker-planned definitions factory classes (class-method-slots w description) w
        None -> refuse w (Span 0 0 1 1) "dictionary has no checked declaring class")
      None -> refuse w (Span 0 0 1 1) "dictionary target has no declaring class identity"
    None -> refuse w (Span 0 0 1 1) "factory has no checked source implementation"
  dictionary-worker-planned :: List CoreDefinition -> CoreInstance -> List Nat -> List MethodSlot -> Writer -> Writer
  dictionary-worker-planned definitions factory classes plans w = case class-bindings (scheme-params (instance-scheme factory)) classes of
      Some bounds ->
        let scoped = with-representations bounds Nil w in
        let context = factory-bindings (scheme-requirements (instance-scheme factory)) 0 in
        case dictionary-map factory plans scoped of
          Some fields -> case request-object-shape (Span 0 0 1 1) (Cons 0 fields) scoped of
            (planned, descriptor) ->
              let started = line (line planned (cat ["define ", worker-linkage planned (dictionary-name (instance-name factory) classes), "i64 ", symbol-for-dictionary (instance-name factory) classes, "(", join (argument-words (value-parameters (list-length context) 0)), ") {"])) "entry:" in
              let count = list-length fields in
              let fixed = if list-length context == 0 && not (has-strict-values started factory (instance-fields factory)) then static-dictionary-fields factory classes count plans started else None in
              case fixed of
                Some (ready, words) ->
                  let (declared, storage) = fresh ready "@dictionary" in
                  let block = cat ["[", nat-to-string (count + 2), " x i64]"] in
                  let stored = global declared (cat [storage, " = private unnamed_addr constant ", block, " [i64 ", nat-to-string (static-header 3 descriptor), ", i64 ", nat-to-string count, static-words (physical-words 0 count words), "], align 8"]) in
                  let (done, result) = fresh stored "%v" in
                  line (line (line done (cat ["  ", result, " = ptrtoint ptr getelementptr inbounds (", block, ", ptr ", storage, ", i64 0, i64 1) to i64"])) (cat ["  ret i64 ", result])) "}"
                None ->
                  let (one, pointer) = fresh started "%ptr" in
                  let allocated = line one (cat ["  ", pointer, " = call ptr @cinch_alloc_shaped(i64 ", nat-to-string (8 * (1 + count)), ", i64 3, i64 ", nat-to-string descriptor, ")"]) in
                  let initialized = store-fields allocated pointer 0 (Cons (nat-to-string count) (zeros count)) in
                  case initialize-values definitions factory classes context (given-bindings context 0) pointer (strict-fields initialized factory (instance-fields factory)) initialized of
                    (values, locals) -> let filled = dictionary-fields definitions factory classes context locals pointer plans values in
                      let (done, result) = fresh (drop-locals (given-roots context 0) filled) "%v" in
                      line (line (line done (cat ["  ", result, " = ptrtoint ptr ", pointer, " to i64"])) (cat ["  ret i64 ", result])) "}"
          None -> refuse scoped (Span 0 0 1 1) "dictionary field has no runtime representation"
      None -> refuse w (Span 0 0 1 1) "factory factory needs first-order or erased parameters"
  -- A factory without context whose every method lowers to a closure that
  -- saves nothing returns one immortal data-section dictionary
  -- { nmeth; methods... } whose methods are static closures.
  static-dictionary-fields :: CoreInstance -> List Nat -> Nat -> List MethodSlot -> Writer -> Option (Writer, List (Nat, String))
  static-dictionary-fields owner classes count plans w = case plans of
    Nil -> Some (w, Nil)
    Cons (MethodSlot logical physical own-codes) rest -> if physical >= count then None else case field-at logical (instance-fields owner) of
      Some field -> let d = dictionary-field-definition field in
        let actual = classes <> own-codes in
        (case static-method w d actual of
          Some parameter-classes -> (case static-closure (Span 0 0 1 1) (specialized-name (core-name d) actual) parameter-classes (demand-worker (core-name d) actual w) of
            (planned, payload) -> case static-dictionary-fields owner classes count rest planned of
              Some (done, words) -> Some (done, Cons (physical, cat ["ptrtoint (ptr ", payload, " to i64)"]) words)
              None -> None)
          None -> None)
      None -> None
  -- The parameter classes of a method that function-call lowers, with no
  -- context and no arguments, to a closure saving nothing: no self value
  -- dependencies, no implicit index values, and some given or parameter
  -- still to come.
  static-method :: Writer -> CoreDefinition -> List Nat -> Option (List Nat)
  static-method w d classes = case definition-context d classes w of
    Some context ->
      let parameters = definition-parameters d in
      let required = runtime-givens w d in
      let quiet = list-length (definition-value-dependencies w d) == 0 && list-length (opening-value-types (core-openings d)) == 0 in
      if quiet && (list-length required > 0 || list-length parameters > 0) then class-vector context (given-types required <> pattern-types parameters) else None
    None -> None
  physical-words :: Nat -> Nat -> List (Nat, String) -> List String
  physical-words index count words = if index >= count then Nil else Cons (physical-word index words) (physical-words (index + 1) count words)
  physical-word :: Nat -> List (Nat, String) -> String
  physical-word index words = case words of Nil -> "0"; Cons (slot, word) rest -> if slot == index then word else physical-word index rest
  static-words :: List String -> String
  static-words words = case words of Nil -> ""; Cons first rest -> cat [", i64 ", first, static-words rest]
  pattern-binds :: Nat -> CorePattern -> Bool
  pattern-binds id pattern = case pattern of
    CPVar sp ty key name -> id == key
    CPProof sp ty key name -> id == key
    CPErasedValue sp ty key name -> id == key
    CPAs sp ty key name inner -> id == key || pattern-binds id inner
    CPTuple sp ty fields -> pattern-binds id fields
    CPConstructor sp ty name actuals sc fields -> pattern-binds id fields
    CPField sp first rest -> pattern-binds id first || pattern-binds id rest
    other -> False
  term-uses :: Nat -> CoreTerm -> Bool
  term-uses id term = case term of
    CLocal sp ty key name actuals -> id == key
    CApply sp ty first second -> term-uses id first || term-uses id second
    CApplyEff sp ty row first second -> term-uses id first || term-uses id second
    CScope sp ty region evidence callback -> term-uses id callback
    CMemoScope sp ty region body -> term-uses id body
    CSpawn sp ty token body -> term-uses id token || term-uses id body
    CJoin sp ty token body -> term-uses id token || term-uses id body
    CWith sp ty given value body -> term-uses id value || term-uses id body
    CLambda sp ty pattern body -> not (pattern-binds id pattern) && term-uses id body
    CLet sp ty key name sc rhs body -> term-uses id rhs || (id /= key && term-uses id body)
    CRecursiveFunctions sp ty members body -> not (local-in-recursive-functions id members)
      && index-term-uses id (Cons body (recursive-functions members))
    CRecursiveValues sp ty region members body -> not (local-in-recursive-functions id members)
      && index-term-uses id (Cons body (recursive-functions members))
    CIf sp ty test yes no -> term-uses id test || term-uses id yes || term-uses id no
    CCase sp ty value alternatives -> term-uses id value || term-uses id alternatives
    CTuple sp ty fields -> term-uses id fields
    CPolyIntro sp ty poly-ids fields -> term-uses id fields
    CPolyElim sp ty fields poly-args -> term-uses id fields
    CPrimitive sp ty op args -> term-uses id args
    CProved sp ty evidence body -> term-uses id body
    CRefine sp ty evidence body -> term-uses id body
    CForget sp ty body -> term-uses id body
    CRequire sp ty body -> term-uses id body
    CDischarge sp ty evidence body -> term-uses id body
    CGuard sp ty guard body -> term-uses id guard || term-uses id body
    CArgument sp first rest -> term-uses id first || term-uses id rest
    CAlternative sp pattern body rest -> (not (pattern-binds id pattern) && term-uses id body) || term-uses id rest
    other -> index-term-uses id (runtime-term-children term)
  local-in-recursive-functions :: Nat -> CoreTerm -> Bool
  local-in-recursive-functions id members = case members of
    CRecursiveBindingsEnd -> False
    CRecursiveBinding key name value rest -> id == key || local-in-recursive-functions id rest
    other -> False
  index-term-uses :: Nat -> List CoreTerm -> Bool
  index-term-uses id terms = case terms of Nil -> False; Cons first rest -> term-uses id first || index-term-uses id rest
  evidence-uses :: String -> CoreEvidence -> Bool
  evidence-uses name evidence = case evidence of
    CEGiven sp ty symbol -> same name symbol
    CEInstance sp ty symbol actuals args -> evidence-uses name args
    CEArgument sp first rest -> evidence-uses name first || evidence-uses name rest
    other -> False
  evidences-use :: String -> List CoreEvidence -> Bool
  evidences-use name evidence = case evidence of Nil -> False; Cons first rest -> evidence-uses name first || evidences-use name rest
  given-uses :: String -> CoreTerm -> Bool
  given-uses name term = case term of
    CQualifiedUse sp ty symbol role actuals evidence -> evidences-use name evidence
    CMethod sp ty symbol owner slot actuals evidence -> evidences-use name evidence
    CApply sp ty first second -> given-uses name first || given-uses name second
    CApplyEff sp ty row first second -> given-uses name first || given-uses name second
    CErasedApply sp ty row f witness -> given-uses name f
    CLambda sp ty pattern body -> given-uses name body
    CLet sp ty key symbol sc rhs body -> given-uses name rhs || given-uses name body
    CRecursiveFunctions sp ty members body -> recursive-given-uses name (Cons body (recursive-functions members))
    CRecursiveValues sp ty region members body -> recursive-given-uses name (Cons body (recursive-functions members))
    CScope sp ty region evidence callback -> evidence-uses name evidence || given-uses name callback
    CMemoScope sp ty region body -> given-uses name body
    CSpawn sp ty token body -> given-uses name token || given-uses name body
    CJoin sp ty token body -> given-uses name token || given-uses name body
    CWith sp ty given value body -> given-uses name value || (not (same name (given-symbol given)) && given-uses name body)
    CHandler sp ty returned operations -> given-uses name returned || given-uses name operations
    CHandlerOperation sp slot openings row closure rest -> given-uses name closure || given-uses name rest
    CHandle sp ty label residual body frame -> given-uses name frame || given-uses name body
    CIf sp ty test yes no -> given-uses name test || given-uses name yes || given-uses name no
    CCase sp ty value alternatives -> given-uses name value || given-uses name alternatives
    CTuple sp ty fields -> given-uses name fields
    CPolyIntro sp ty poly-ids fields -> given-uses name fields
    CPolyElim sp ty fields poly-args -> given-uses name fields
    CPrimitive sp ty op args -> given-uses name args
    CProved sp ty evidence body -> given-uses name body
    CRefine sp ty evidence body -> given-uses name body
    CForget sp ty body -> given-uses name body
    CRequire sp ty body -> given-uses name body
    CDischarge sp ty evidence body -> given-uses name body
    CGuard sp ty guard body -> given-uses name guard || given-uses name body
    CArgument sp first rest -> given-uses name first || given-uses name rest
    CAlternative sp pattern body rest -> given-uses name body || given-uses name rest
    other -> False
  recursive-given-uses :: String -> List CoreTerm -> Bool
  recursive-given-uses name terms = case terms of
    Nil -> False
    Cons first rest -> given-uses name first || recursive-given-uses name rest
  given-in :: String -> List CoreGiven -> Bool
  given-in name givens = case givens of Nil -> False; Cons first rest -> same name (given-symbol first) || given-in name rest
  self-context-uses :: String -> CoreTerm -> List Local -> Bool
  self-context-uses name body locals = case locals of
    Nil -> False
    Cons (KnownSelf key owner classes context) rest -> (given-uses key body && given-in name context) || self-context-uses name body rest
    Cons other rest -> self-context-uses name body rest
  captures-from :: CorePattern -> CoreTerm -> List Local -> List Local -> List Local
  captures-from parameter body all locals = case locals of
    Nil -> Nil
    Cons (Local id ty value) rest -> if not (pattern-binds id parameter) && term-uses id body then Cons (Local id ty value) (captures-from parameter body all rest) else captures-from parameter body all rest
    Cons (Borrowed id ty value) rest -> if not (pattern-binds id parameter) && term-uses id body then Cons (Local id ty value) (captures-from parameter body all rest) else captures-from parameter body all rest
    Cons (KnotLocal id region ty slot) rest -> if not (pattern-binds id parameter) && recursive-member-use id body then
      Cons (KnotLocal id region ty slot) (captures-from parameter body all rest)
      else captures-from parameter body all rest
    Cons (GivenLocal name ty value) rest -> if given-uses name body || self-context-uses name body all then Cons (GivenLocal name ty value) (captures-from parameter body all rest) else captures-from parameter body all rest
    Cons (KnownSelf key owner classes context) rest -> if given-uses key body then Cons (KnownSelf key owner classes context) (captures-from parameter body all rest) else captures-from parameter body all rest
    Cons (SelfValue owner slot ty value) rest -> if self-values-used owner body all then Cons (SelfValue owner slot ty value) (captures-from parameter body all rest) else captures-from parameter body all rest
    Cons (Discard ty value) rest -> captures-from parameter body all rest
    Cons (DeferredConstructor id ty name actuals args) rest -> captures-from parameter body all rest
  capture-types :: List Local -> List UType
  capture-types locals = case locals of
    Nil -> Nil
    Cons (Local id ty value) rest -> Cons ty (capture-types rest)
    Cons (KnotLocal id region ty slot) rest -> Cons (knot-slot-type region ty) (capture-types rest)
    Cons (GivenLocal name ty value) rest -> Cons ty (capture-types rest)
    Cons (SelfValue owner slot ty value) rest -> Cons ty (capture-types rest)
    Cons other rest -> capture-types rest
  capture-values :: List Local -> Writer -> (Writer, List String)
  capture-values locals w = case locals of
    Nil -> (w, Nil)
    Cons (Local id ty value) rest -> case capture-values rest (count-op True ty value w) of
      (done, values) -> (done, Cons value values)
    Cons (Borrowed id ty value) rest -> case capture-values rest (count-op True ty value w) of
      (done, values) -> (done, Cons value values)
    Cons (KnotLocal id region ty slot) rest -> case capture-values rest (count-op True (knot-slot-type region ty) slot w) of
      (done, values) -> (done, Cons slot values)
    Cons (GivenLocal name ty value) rest -> case capture-values rest (count-op True ty value w) of
      (done, values) -> (done, Cons value values)
    Cons (SelfValue owner slot ty value) rest -> case capture-values rest (count-op True ty value w) of
      (done, values) -> (done, Cons value values)
    Cons (KnownSelf key owner classes context) rest -> capture-values rest w
    other -> (refuse w (Span 0 0 1 1) "malformed closure capture list", Nil)
  captured-bindings :: List Local -> Nat -> List Local
  captured-bindings saved index = case saved of
    Nil -> Nil
    Cons (Local id ty value) rest -> Cons (Borrowed id ty (cat ["%arg", nat-to-string index])) (captured-bindings rest (index + 1))
    Cons (KnotLocal id region ty slot) rest -> Cons (KnotLocal id region ty (cat ["%arg", nat-to-string index])) (captured-bindings rest (index + 1))
    Cons (GivenLocal name ty value) rest -> Cons (GivenLocal name ty (cat ["%arg", nat-to-string index])) (captured-bindings rest (index + 1))
    Cons (SelfValue owner slot ty value) rest -> Cons (SelfValue owner slot ty (cat ["%arg", nat-to-string index])) (captured-bindings rest (index + 1))
    Cons (KnownSelf key owner classes context) rest -> Cons (KnownSelf key owner classes context) (captured-bindings rest index)
    Cons other rest -> captured-bindings rest index
  capture-roots :: List UType -> Nat -> List Local
  capture-roots types index = case types of Nil -> Nil; Cons ty rest -> Cons (Discard ty (cat ["%arg", nat-to-string index])) (capture-roots rest (index + 1))
  lambda :: List CoreDefinition -> List Local -> Writer -> Span -> CorePattern -> CoreTerm -> (Writer, String)
  lambda definitions locals w sp parameter body =
    let saved = captures-from parameter body locals locals in
    let parameters = if erased-pattern parameter then Nil else [pattern-type parameter] in
    case class-vector (writer-context w) (capture-types saved <> parameters) of
      None -> unsupported w sp "lambda parameters need known runtime representations"
      Some classes -> let (named, name) = fresh w ".lambda" in
        (case writer-context named of
          RuntimeContext datas bounds rigids pending done inlining ->
            let planned = request-demand (LambdaDemand name bounds rigids saved parameter body) named in
            case capture-values saved planned of
              (ready, values) -> closure sp name classes values ready)
  recursive-parameters :: List CorePattern -> CoreTerm -> (List CorePattern, CoreTerm)
  recursive-parameters parameters term = case term of
    CLambda sp ty pattern body -> if erased-pattern pattern then
      (case parameters of Nil -> ([pattern], body); other -> (reverse parameters, term))
      else recursive-parameters (Cons pattern parameters) body
    other -> (reverse parameters, term)
  plan-recursive-workers :: CoreTerm -> Writer -> (Writer, List RecursiveWorker)
  plan-recursive-workers members w = case members of
    CRecursiveBindingsEnd -> (w, Nil)
    CRecursiveBinding id display value rest -> let (named, name) = fresh w ".rec" in
      let (parameters, body) = recursive-parameters Nil value in
      case plan-recursive-workers rest named of
        (done, more) -> (done, Cons (RecursiveWorker id (core-type value) name parameters body) more)
    other -> (refuse w (Span 0 0 1 1) "malformed recursive function group", Nil)
  request-recursive-workers :: List RecursiveWorker -> List RecursiveWorker -> List Local -> Writer -> Writer
  request-recursive-workers group pending saved w = case pending of
    Nil -> w
    Cons member rest -> case writer-context w of
      RuntimeContext datas bounds rigids earlier done inlining ->
        request-recursive-workers group rest saved (request-demand (RecursiveDemand member group bounds rigids saved) w)
  -- The sibling closures save only the group's outer environment. Rebuild
  -- a closure when its worker needs that value without an owning cycle.
  recursive-locals :: Span -> List UType -> List Local -> List RecursiveWorker -> CoreTerm -> Writer -> (Writer, List Local)
  recursive-locals sp captures saved group used w = case group of
    Nil -> (w, Nil)
    Cons (RecursiveWorker id ty name patterns body) rest -> if not (term-uses id used) then
      recursive-locals sp captures saved rest used w
      else (case class-vector (writer-context w) (captures <> pattern-types (runtime-parameters patterns)) of
        None -> (refuse w sp "recursive closure needs checked runtime representations", Nil)
        Some classes -> case capture-values saved w of
          (captured, values) -> case closure sp name classes values captured of
            (ready, word) -> case recursive-locals sp captures saved rest used ready of
              (done, more) -> (done, Cons (Local id ty word) more))
  recursive-expression :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> CoreTerm -> (Writer, String)
  recursive-expression definitions locals w sp members body =
    let unit = UCon "Unit" KType in
    let scope = CRecursiveFunctions sp unit members (CUnit sp unit) in
    let saved = captures-from (CPWild sp unit) scope locals locals in
    case plan-recursive-workers members w of
      (named, group) -> let planned = request-recursive-workers group group saved named in
        (case recursive-locals sp (capture-types saved) saved group body planned of
          (ready, bound) -> case expression definitions (bound <> locals) ready body of
            (done, result) -> (drop-locals bound done, result))
  -- App stubs consume the closure and argv. A closure's code word points at
  -- the `app` stub, which merges the filled words and the incoming words
  -- into a frame of exactly `arity` words: a static alloca, never a dynamic
  -- one, because LLVM's AArch64 stack probe mishandles a dynamic alloca once
  -- a caller inlines the stub. Saved fields are duplicated before the
  -- original closure is dropped; argv fields transfer directly.
  load-word :: Writer -> String -> String -> (Writer, String)
  load-word w pointer index =
    let (one, slot) = fresh w "%ptr" in
    let (two, value) = fresh one "%v" in
    (line (line two (cat ["  ", slot, " = getelementptr i64, ptr ", pointer, ", i64 ", index])) (cat ["  ", value, " = load i64, ptr ", slot]), value)
  saved-dups :: List Nat -> Nat -> String -> String -> Writer -> Writer
  saved-dups classes index filled merged w = case classes of
    Nil -> w
    Cons first rest -> if first == 0 then saved-dups rest (index + 1) filled merged w else
      let (one, condition) = fresh w "%v" in
      let (two, duplicate) = fresh one "saveddup" in
      let (three, next) = fresh two "savednext" in
      let started = line (line (line three (cat ["  ", condition, " = icmp ult i64 ", nat-to-string index, ", ", filled])) (cat ["  br i1 ", condition, ", label %", duplicate, ", label %", next])) (cat [duplicate, ":"]) in
      case load-word started merged (nat-to-string index) of
        (loaded, word) -> saved-dups rest (index + 1) filled merged (line (line (line loaded (count-call True word)) (cat ["  br label %", next])) (cat [next, ":"]))
  load-arguments :: Nat -> Nat -> String -> Writer -> (Writer, List String)
  load-arguments count index merged w = if count == 0 then (w, Nil) else case load-word w merged (nat-to-string index) of
    (loaded, word) -> case load-arguments (count - 1) (index + 1) merged loaded of (done, words) -> (done, Cons word words)
  -- One merged frame slot: the closure's saved word while the slot is below
  -- the filled count, the matching argv word otherwise. The argv address is
  -- a non-inbounds byte GEP: a slot that selects a saved word still computes
  -- the pointer it does not load.
  merge-words :: Writer -> String -> Nat -> Nat -> String -> String -> Writer
  merge-words w frame index count filled saved-bytes = if index == count then w else
    let (one, saved) = fresh w "%ptr" in
    let saved-line = line one (cat ["  ", saved, " = getelementptr i8, ptr %self, i64 ", nat-to-string (24 + index * 8)]) in
    let (two, offset) = fresh saved-line "%v" in
    let offset-line = line two (cat ["  ", offset, " = sub i64 ", nat-to-string (index * 8), ", ", saved-bytes]) in
    let (three, argument) = fresh offset-line "%ptr" in
    let argument-line = line three (cat ["  ", argument, " = getelementptr i8, ptr %argv, i64 ", offset]) in
    let (four, has) = fresh argument-line "%v" in
    let has-line = line four (cat ["  ", has, " = icmp ult i64 ", nat-to-string index, ", ", filled]) in
    let (five, source) = fresh has-line "%ptr" in
    let source-line = line five (cat ["  ", source, " = select i1 ", has, ", ptr ", saved, ", ptr ", argument]) in
    let (six, word) = fresh source-line "%v" in
    let word-line = line six (cat ["  ", word, " = load i64, ptr ", source]) in
    let (seven, slot) = fresh word-line "%ptr" in
    let slot-line = line seven (cat ["  ", slot, " = getelementptr i8, ptr ", frame, ", i64 ", nat-to-string (index * 8)]) in
    merge-words (line slot-line (cat ["  store i64 ", word, ", ptr ", slot])) frame (index + 1) count filled saved-bytes
  -- The grow half: fewer words than the arity, so build a closure whose
  -- payload is the `filled` saved words followed by the `%argc` incoming
  -- ones and whose code word is this same stub, so the next application
  -- enters it again. No frame is involved: these two copies are the only
  -- dynamic lengths in the stub, and neither reads past the words its
  -- source holds.
  app-partial :: String -> List Nat -> Nat -> String -> String -> Writer -> Writer
  app-partial name classes descriptor total filled w =
    let arity = list-length classes in
    let (one, words) = fresh w "%v" in
    let (two, bytes) = fresh one "%v" in
    let (three, pointer) = fresh two "%ptr" in
    let allocated = line (line (line three (cat ["  ", words, " = add i64 ", total, ", 3"])) (cat ["  ", bytes, " = mul i64 ", words, ", 8"])) (cat ["  ", pointer, " = call ptr @cinch_alloc_shaped(i64 ", bytes, ", i64 2, i64 ", nat-to-string descriptor, ")"]) in
    let prefix = [cat ["ptrtoint (ptr ", symbol (cat [name, ".app"]), " to i64)"], nat-to-string arity, total] in
    let stored = store-fields allocated pointer 0 prefix in
    let (four, destination) = fresh stored "%ptr" in
    let (five, saved-bytes) = fresh four "%v" in
    let (six, saved) = fresh five "%ptr" in
    let (seven, incoming-bytes) = fresh six "%v" in
    let (eight, incoming) = fresh seven "%ptr" in
    let copied = line (line eight (cat ["  ", destination, " = getelementptr i64, ptr ", pointer, ", i64 3"])) (cat ["  ", saved-bytes, " = mul i64 ", filled, ", 8"]) in
    let saved-copy = line (line copied (cat ["  ", saved, " = getelementptr i64, ptr %self, i64 3"])) (cat ["  call ptr @memcpy(ptr ", destination, ", ptr ", saved, ", i64 ", saved-bytes, ")"]) in
    let argv-copy = line (line saved-copy (cat ["  ", incoming-bytes, " = mul i64 %argc, 8"])) (cat ["  ", incoming, " = getelementptr i8, ptr ", destination, ", i64 ", saved-bytes]) in
    let (nine, self-word) = fresh (saved-dups classes 0 filled destination (line argv-copy (cat ["  call ptr @memcpy(ptr ", incoming, ", ptr %argv, i64 ", incoming-bytes, ")"]))) "%v" in
    let released = line (line nine (cat ["  ", self-word, " = ptrtoint ptr %self to i64"])) (count-call False self-word) in
    let (ten, closure-word) = fresh released "%v" in
    line (line ten (cat ["  ", closure-word, " = ptrtoint ptr ", pointer, " to i64"])) (cat ["  ret i64 ", closure-word])
  -- The saturated call: `frame` holds the merged words and `total` is the
  -- filled count plus the incoming one, so the excess continues at
  -- `argv + (arity - filled)` words, inside argv whenever there is one.
  app-saturate :: String -> List Nat -> String -> String -> String -> String -> Writer -> Writer
  app-saturate name classes frame filled saved-bytes total w = case load-arguments (list-length classes) 0 frame w of
    (ready, args) -> case call ready (symbol name) args of
      (called, result) ->
        let (one, excess) = fresh called "%v" in
        let (two, more) = fresh one "%v" in
        let (three, over-label) = fresh two "overapplied" in
        let (four, return-label) = fresh three "appreturn" in
        let saturated = line (line (line (line (line four (cat ["  ", excess, " = sub i64 ", total, ", ", nat-to-string (list-length classes)])) (cat ["  ", more, " = icmp ne i64 ", excess, ", 0"])) (cat ["  br i1 ", more, ", label %", over-label, ", label %", return-label])) (cat [return-label, ":"])) (cat ["  ret i64 ", result]) in
        let (five, tail-offset) = fresh (line saturated (cat [over-label, ":"])) "%v" in
        let (six, tail) = fresh five "%ptr" in
        let (seven, out) = fresh six "%v" in
        line (line (line (line (line seven (cat ["  ", tail-offset, " = sub i64 ", nat-to-string (list-length classes * 8), ", ", saved-bytes])) (cat ["  ", tail, " = getelementptr i8, ptr %argv, i64 ", tail-offset])) (cat ["  ", out, " = call i64 @__apply(i64 ", result, ", i64 ", excess, ", ptr ", tail, ")"])) (cat ["  ret i64 ", out])) "}"
  -- The apply stub: one entry per function, whatever argument count it is
  -- handed. It reads the merged total, then branches once: at or above the
  -- arity it merges the filled words and the incoming ones into a frame of
  -- exactly `arity` words and saturates, below it it grows a closure. The
  -- merge is inside the saturated path because only there does every frame
  -- slot have a word behind it; the grow path copies the two sources
  -- directly. The frame is a static alloca, never a dynamic one, because
  -- LLVM's AArch64 stack probe mishandles a dynamic alloca once a caller
  -- inlines the stub. Saved fields are duplicated before the original
  -- closure is dropped; argv fields transfer directly.
  app-stub :: String -> List Nat -> Writer -> Writer
  app-stub name classes w = case request-shape (Span 0 0 1 1) classes w of
    (planned, descriptor) ->
      let arity = list-length classes in
      let header = line (line planned (cat ["define ", worker-linkage planned (cat [name, ".app"]), "i64 ", symbol (cat [name, ".app"]), "(ptr %self, i64 %argc, ptr %argv) {"])) "entry:" in
      let (loaded, filled) = load-word header "%self" "2" in
      let (one, total) = fresh loaded "%v" in
      let total-line = line one (cat ["  ", total, " = add i64 ", filled, ", %argc"]) in
      if arity == 0 then saturated-stub name classes filled total total-line else
        let (two, full) = fresh total-line "%v" in
        let (three, partial-label) = fresh two "partial" in
        let (four, full-label) = fresh three "saturated" in
        let split = line (line (line four (cat ["  ", full, " = icmp uge i64 ", total, ", ", nat-to-string arity])) (cat ["  br i1 ", full, ", label %", full-label, ", label %", partial-label])) (cat [partial-label, ":"]) in
        let partial = app-partial name classes descriptor total filled split in
        saturated-stub name classes filled total (line partial (cat [full-label, ":"]))
  -- The static frame the saturated path merges into: exactly `arity`
  -- words, allocated in the entry block.
  merged-frame :: Writer -> Nat -> String -> String -> (Writer, String)
  merged-frame w arity filled saved-bytes =
    let (one, frame) = fresh w "%ptr" in
    let frame-line = line one (cat ["  ", frame, " = alloca [", nat-to-string arity, " x i64]"]) in
    (merge-words frame-line frame 0 arity filled saved-bytes, frame)
  -- The saturated half of the stub: merge the frame, take the saved words
  -- it copied, drop the closure, then call the function. A nullary unit
  -- needs no frame: every slot count is zero, so `%self` stands in and no
  -- alloca is emitted.
  saturated-stub :: String -> List Nat -> String -> String -> Writer -> Writer
  saturated-stub name classes filled total started =
    let arity = list-length classes in
    let (one, saved-bytes) = fresh started "%v" in
    let saved-line = line one (cat ["  ", saved-bytes, " = mul i64 ", filled, ", 8"]) in
    let (merged, frame) = if arity == 0 then (saved-line, "%self") else merged-frame saved-line arity filled saved-bytes in
    let (two, self-word) = fresh (saved-dups classes 0 filled frame merged) "%v" in
    let released = line (line two (cat ["  ", self-word, " = ptrtoint ptr %self to i64"])) (count-call False self-word) in
    app-saturate name classes frame filled saved-bytes total released
  term-fields :: CoreTerm -> Option (List CoreTerm)
  term-fields fields = case fields of
    CArgumentsEnd sp -> Some Nil
    CArgument sp first rest -> case term-fields rest of Some more -> Some (Cons first more); None -> None
    other -> None
  field-words :: RuntimeContext -> List CoreTerm -> Bool
  field-words datas fields = case fields of Nil -> True; Cons first rest -> word-type datas (core-type first) && field-words datas rest
  -- design/rank-n-polymorphism.md section 8. A polymorphic value is a
  -- class-indexed bundle: one block whose component i is the body lowered
  -- with its type binders at the i-th class vector, in lexicographic order
  -- of the Raw/Obj/TObj codes. A lambda body becomes one specialised
  -- closure per vector; any other body is evaluated once per vector, which
  -- its checked purity makes unobservable. Row and region binders carry no
  -- class. An instantiation loads the component its arguments' classes
  -- select. The Rust compiler instead keeps a demand-driven family slot
  -- table; the two never meet, because no library export has a polytype.
  poly-bundle :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> List Nat -> CoreTerm -> (Writer, String)
  poly-bundle definitions locals w sp ty ids body = case ty of
    UForall qs inner -> let binders = poly-class-binders qs ids in
      if list-length binders > 2 then unsupported w sp "a polymorphic value with more than two type binders needs an extended runtime descriptor (its 3^k bundle exceeds 16 words)" else
      case poly-components definitions locals w sp binders body (class-vectors (list-length binders)) of
        (built, values, classes) -> if list-length (writer-errors built) > list-length (writer-errors w) then (built, "0") else
          (case request-class-layout sp classes built of
            (planned, descriptor) -> allocate planned descriptor values)
    other -> unsupported w sp "a generalisation needs a polymorphic type"
  poly-class-binders :: List Quant -> List Nat -> List Nat
  poly-class-binders qs ids = case (qs, ids) of
    (Cons q rest, Cons id more) -> if poly-class-kind (quant-kind q) then Cons id (poly-class-binders rest more) else poly-class-binders rest more
    other -> Nil
  poly-class-positions :: List Quant -> Nat -> List Nat
  poly-class-positions qs index = case qs of
    Nil -> Nil
    Cons q rest -> if poly-class-kind (quant-kind q) then Cons index (poly-class-positions rest (index + 1)) else poly-class-positions rest (index + 1)
  poly-class-kind :: Kind -> Bool
  poly-class-kind kind = case kind of KType -> True; KFun a b -> True; other -> False
  class-vectors :: Nat -> List (List Nat)
  class-vectors k = if k == 0 then [Nil] else prefix-classes [0, 1, 2] (class-vectors (k - 1))
  prefix-classes :: List Nat -> List (List Nat) -> List (List Nat)
  prefix-classes codes tails = case codes of Nil -> Nil; Cons code rest -> prefix-each code tails <> prefix-classes rest tails
  prefix-each :: Nat -> List (List Nat) -> List (List Nat)
  prefix-each code tails = case tails of Nil -> Nil; Cons tail more -> Cons (Cons code tail) (prefix-each code more)
  vector-index :: List Nat -> Nat
  vector-index v = vector-index-from v 0
  vector-index-from :: List Nat -> Nat -> Nat
  vector-index-from v acc = case v of Nil -> acc; Cons code rest -> vector-index-from rest (acc * 3 + code)
  select-positions :: List Nat -> List UType -> List UType
  select-positions positions args = select-from positions args 0
  select-from :: List Nat -> List UType -> Nat -> List UType
  select-from positions args index = case args of
    Nil -> Nil
    Cons arg rest -> if has-nat index positions then Cons arg (select-from positions rest (index + 1)) else select-from positions rest (index + 1)
  has-nat :: Nat -> List Nat -> Bool
  has-nat n xs = case xs of Nil -> False; Cons x rest -> x == n || has-nat n rest
  -- Lower the body once per class vector, with the type binders' rigid ids
  -- mapped to that vector for the body alone.
  poly-components :: List CoreDefinition -> List Local -> Writer -> Span -> List Nat -> CoreTerm -> List (List Nat) -> (Writer, List String, List Nat)
  poly-components definitions locals w sp binders body vectors = case vectors of
    Nil -> (w, Nil, Nil)
    Cons v rest ->
      let original = writer-rigids w in
      let opened = with-writer-rigids (zip-classes binders v <> original) w in
      case expression definitions locals opened body of
        (lowered, value) -> let code = case word-class (writer-context lowered) (core-type body) of Some c -> c; None -> 1 in
          let restored = with-writer-rigids original lowered in
          case poly-components definitions locals restored sp binders body rest of
            (done, values, classes) -> (done, Cons value values, Cons code classes)
  zip-classes :: List Nat -> List Nat -> List (Nat, Nat)
  zip-classes ids codes = case (ids, codes) of
    (Cons id rest, Cons code more) -> Cons (id, code) (zip-classes rest more)
    other -> Nil
  writer-rigids :: Writer -> List (Nat, Nat)
  writer-rigids w = case writer-context w of RuntimeContext info bounds rigids pending done inlining -> rigids
  with-writer-rigids :: List (Nat, Nat) -> Writer -> Writer
  with-writer-rigids rigids w = case w of
    Writer next globals code errors layouts (RuntimeContext info bounds old pending done inlining) ->
      Writer next globals code errors layouts (RuntimeContext info bounds rigids pending done inlining)
  writer-errors :: Writer -> List Diagnostic
  writer-errors w = case w of Writer next globals code errors layouts context -> errors
  poly-project :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> List UType -> (Writer, String)
  poly-project definitions locals w sp ty value args = case core-type value of
    UForall qs inner -> (case class-vector (writer-context w) (select-positions (poly-class-positions qs 0) args) of
      None -> unsupported w sp "an instantiation needs known runtime representations"
      Some v -> case expression definitions locals w value of
        (evaluated, bundle) -> let (named, pointer) = fresh evaluated "%poly" in
          let addressed = line named (cat ["  ", pointer, " = inttoptr i64 ", bundle, " to ptr"]) in
          case load-word addressed pointer (nat-to-string (vector-index v)) of
            -- The component outlives the bundle it came from.
            (loaded, selected) -> (count-op False (core-type value) bundle (count-op True ty selected loaded), selected))
    other -> unsupported w sp "an instantiation needs a polymorphic value"
  -- A tuple layout from the components' classes directly: the bundle's
  -- components have different classes per vector, so no single context
  -- types them all.
  request-class-layout :: Span -> List Nat -> Writer -> (Writer, Nat)
  request-class-layout sp classes w = case w of
    Writer next globals code errors (LayoutPlan groups tuples names cells) datas ->
      let packed = list-length classes + class-field-map classes 4294967296 in case known-layout packed tuples of
        Some id -> (w, id)
        None -> if list-length classes > 16 || groups >= 1022 then
          (refuse w sp "polymorphic bundle layout needs an extended runtime descriptor", 0)
          else let id = 64 * (groups + 1) in
            (Writer next globals code errors (LayoutPlan (groups + 1) (Cons (id, packed) tuples) names (Cons (id, packed) cells)) datas, id)
  class-field-map :: List Nat -> Nat -> Nat
  class-field-map classes factor = case classes of Nil -> 0; Cons code rest -> code * factor + class-field-map rest (factor * 4)
  tuple :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> (Writer, String)
  tuple definitions locals w sp fields = case term-fields fields of
    Some actual -> if list-length actual > 16 || not (field-words (writer-context w) actual) then unsupported w sp "tuple fields need an extended or polymorphic runtime layout" else
      (case expressions definitions locals w actual of
        (evaluated, values) ->
          let (planned, descriptor) = request-layout sp actual evaluated in
          allocate planned descriptor values)
    None -> unsupported w sp "malformed tuple argument spine"
  -- A fieldless value is a static Obj. The header uses rc=0 and kind=1,
  -- with the layout in bits48..63. Escaped blocks put the descriptor
  -- before the header, so the payload address still has the header at -8.
  --
  -- The name is the descriptor, not a fresh counter, because a nullary
  -- block's bytes are a pure function of its descriptor: same descriptor,
  -- same two or three words. Naming by descriptor makes symbol identity
  -- mean block identity, which is the rule the Rust seed already uses
  -- (`dedupe_static_blocks` keeps the first line per symbol, and its
  -- symbols are one per constructor unit). A per-site name made every
  -- construction site its own definition: 7,126 definitions for 96
  -- distinct blocks in the compiler's own module. `dedupe-globals` below
  -- then drops the repeats, so each block is defined once per module and
  -- every site references that one definition.
  static-constructor :: Writer -> Nat -> (Writer, String)
  static-constructor w descriptor =
    let escaped = descriptor >= 65535 in
    let layout = if escaped then (65535 :: Nat) else descriptor in
    let header = nat-to-string (layout * 281474976710656 + 1099511627776) in
    let words = if escaped then "3" else "2" in
    let offset = if escaped then "2" else "1" in
    let prefix = if escaped then cat ["i64 ", nat-to-string descriptor, ", "] else "" in
    let storage = cat ["@empty-ctor", nat-to-string descriptor] in
    let block = cat ["[", words, " x i64]"] in
    let declared = global w (cat [storage, " = private unnamed_addr constant ", block,
      " [", prefix, "i64 ", header, ", i64 0], align 8"]) in
    let (ready, result) = fresh declared "%v" in
    (line ready (cat ["  ", result, " = ptrtoint ptr getelementptr inbounds (", block,
      ", ptr ", storage, ", i64 0, i64 ", offset, ") to i64"]), result)
  -- Drop repeated global definitions, keeping the first line per symbol.
  -- `static-constructor` names a nullary block by its descriptor, so two
  -- construction sites emit the same line and this keeps one of them.
  -- This is the rule the Rust seed's `dedupe_static_blocks` applies, and
  -- it is safe for the same reason: the line's text is the whole
  -- definition, so two lines with one name are the same constant. A name
  -- that appears once (every non-nullary global) is passed through
  -- unchanged.
  dedupe-globals :: String -> String
  dedupe-globals text = string-unlines (dedupe-lines (string-lines text) hash-map-empty)
  dedupe-lines :: List String -> HashMap String Nat -> List String
  dedupe-lines lines seen = case lines of
    Nil -> Nil
    Cons text rest -> case global-name text of
      None -> Cons text (dedupe-lines rest seen)
      Some name -> case hash-map-lookup name seen of
        Some _ -> dedupe-lines rest seen
        None -> Cons text (dedupe-lines rest (hash-map-insert name 1 seen))
  -- The symbol of a nullary static block definition line, which is the
  -- text from the `@` to the first space (`@empty-ctor<N> = ...`). Every
  -- other global returns `None` and is passed through, so the filter can
  -- only ever remove a repeated static block: the seed's
  -- `dedupe_static_blocks` is scoped the same way, to `.blk#h` lines.
  global-name :: String -> Option String
  global-name text = if string-starts-with "@empty-ctor" text
    then case string-index-of " " text of
      None -> None
      Some stop -> Some (string-take stop text)
    else None
  allocate :: Writer -> Nat -> List String -> (Writer, String)
  allocate w descriptor values = case values of
    Nil -> static-constructor w descriptor
    Cons first rest ->
      let (allocated, pointer) = fresh w "%ptr" in
      let ready = line allocated (cat ["  ", pointer, " = call ptr @cinch_alloc_ctor(i64 ", nat-to-string (8 * list-length values), ", i64 ", nat-to-string descriptor, ")"]) in
      let filled = store-fields ready pointer 0 values in
      let (done, result) = fresh filled "%v" in
      (line done (cat ["  ", result, " = ptrtoint ptr ", pointer, " to i64"]), result)
  store-fields :: Writer -> String -> Nat -> List String -> Writer
  store-fields w pointer index values = case values of
    Nil -> w
    Cons value rest -> let (ready, slot) = fresh w "%ptr" in
      let pointed = line ready (cat ["  ", slot, " = getelementptr i64, ptr ", pointer, ", i64 ", nat-to-string index]) in
      store-fields (line pointed (cat ["  store i64 ", value, ", ptr ", slot])) pointer (index + 1) rest
  pattern-type :: CorePattern -> UType
  pattern-type pattern = case pattern of
    CPVar sp ty id name -> ty
    CPWild sp ty -> ty
    CPAs sp ty id name inner -> ty
    CPTuple sp ty fields -> ty
    CPConstructor sp ty name actuals constructor fields -> ty
    CPInt sp ty text -> ty
    CPChar sp ty text -> ty
    CPString sp ty text -> ty
    other -> UError
  continue-if :: Writer -> String -> String -> Writer
  continue-if w condition failed =
    let (one, flag) = fresh w "%v" in
    let (two, succeeded) = fresh one "matched" in
    line (line (line two (cat ["  ", flag, " = icmp ne i64 ", condition, ", 0"])) (cat ["  br i1 ", flag, ", label %", succeeded, ", label %", failed])) (cat [succeeded, ":"])
  constructor-tag :: Writer -> String -> (Writer, String)
  constructor-tag w value =
    let (one, pointer) = fresh w "%ptr" in
    let (two, slot) = fresh one "%ptr" in
    let (three, header) = fresh two "%v" in
    let (four, layout) = fresh three "%v" in
    let (five, escaped) = fresh four "%v" in
    let (six, extended-label) = fresh five "escaped-tag" in
    let (seven, regular-label) = fresh six "regular-tag" in
    let (eight, joined-label) = fresh seven "tag-join" in
    let (nine, extended-slot) = fresh eight "%ptr" in
    let (ten, descriptor) = fresh nine "%v" in
    let (eleven, shifted) = fresh ten "%v" in
    let (twelve, extended-tag) = fresh eleven "%v" in
    let (thirteen, regular-tag) = fresh twelve "%v" in
    let (fourteen, tag) = fresh thirteen "%v" in
    let address = line (line fourteen (cat ["  ", pointer, " = inttoptr i64 ", value, " to ptr"])) (cat ["  ", slot, " = getelementptr i64, ptr ", pointer, ", i64 -1"]) in
    let loaded = line address (cat ["  ", header, " = load atomic i64, ptr ", slot, " monotonic, align 8"]) in
    (emit-lines loaded [
      cat ["  ", layout, " = lshr i64 ", header, ", 48"],
      cat ["  ", escaped, " = icmp eq i64 ", layout, ", 65535"],
      cat ["  br i1 ", escaped, ", label %", extended-label, ", label %", regular-label],
      cat [extended-label, ":"],
      cat ["  ", extended-slot, " = getelementptr i64, ptr ", pointer, ", i64 -2"],
      cat ["  ", descriptor, " = load i64, ptr ", extended-slot],
      cat ["  ", shifted, " = lshr i64 ", descriptor, ", 16"],
      cat ["  ", extended-tag, " = and i64 ", shifted, ", 16777215"],
      cat ["  br label %", joined-label],
      cat [regular-label, ":"],
      cat ["  ", regular-tag, " = and i64 ", layout, ", 63"],
      cat ["  br label %", joined-label],
      cat [joined-label, ":"],
      cat ["  ", tag, " = phi i64 [ ", extended-tag, ", %", extended-label, " ], [ ", regular-tag, ", %", regular-label, " ]"]], tag)
  match-pattern :: CorePattern -> String -> String -> Writer -> (Writer, List Local)
  match-pattern pattern value failed w = if not (word-type (writer-context w) (pattern-type pattern)) then
    (refuse w (Span 0 0 1 1) "pattern needs typed runtime match lowering", Nil)
    else case pattern of
      CPVar sp ty id name -> (w, [Borrowed id ty value])
      CPWild sp ty -> (w, Nil)
      CPAs sp ty id name inner -> case match-pattern inner value failed w of
        (done, bindings) -> (done, Cons (Borrowed id ty value) bindings)
      CPTuple sp ty fields -> case fields of
        CPDone end -> (w, Nil)
        other -> let (ready, pointer) = fresh w "%ptr" in
          match-fields fields pointer 0 failed (line ready (cat ["  ", pointer, " = inttoptr i64 ", value, " to ptr"]))
      CPConstructor sp ty name actuals sc fields ->
        if decision-word-type ty && (same name "b.Yes" || same name "b.No") && erased-decision-fields fields then
          (case constructor-tag w value of
            (loaded, actual) -> case compare-word loaded "eq" actual (if same name "b.Yes" then "0" else "1") of
              (compared, condition) -> (continue-if compared condition failed, Nil))
        else if named ty "Bool" && (same name "True" || same name "False") then
          (case compare-word w "eq" value (if same name "True" then "1" else "0") of
            (ready, condition) -> (continue-if ready condition failed, Nil))
        else case constructor name (writer-data w) of
          Some (owner, tag, c) -> if list-length (core-constructor-fields c) <= 16 && tag < 16777216 then
            (case constructor-tag w value of
              (loaded, actual) -> case compare-word loaded "eq" actual (nat-to-string tag) of
                (compared, condition) -> let (ready, pointer) = fresh (continue-if compared condition failed) "%ptr" in
                  match-fields fields pointer 0 failed (line ready (cat ["  ", pointer, " = inttoptr i64 ", value, " to ptr"])))
            else (refuse w sp "constructor pattern needs a specialized runtime representation", Nil)
          None -> (refuse w sp "constructor pattern has no defining runtime declaration", Nil)
      CPInt sp ty text -> if number ty then
        (case decimal w ty text of
          (literal, word) -> case call literal (cat ["@cinch_", runtime-number ty, "_cmp"]) [value, word] of
            (compared, order) -> case compare-word (count-op False ty word compared) "eq" order "0" of
              (ready, condition) -> (continue-if ready condition failed, Nil))
        else if raw-integer ty then (case compare-word w "eq" value text of (ready, condition) -> (continue-if ready condition failed, Nil))
        else (refuse w sp "literal pattern needs mathematical runtime comparison", Nil)
      CPChar sp ty text -> if named ty "Char" then (case char-word text of
        Some word -> (case compare-word w "eq" value word of (ready, condition) -> (continue-if ready condition failed, Nil))
        None -> (refuse w sp "invalid typed character pattern", Nil)) else (refuse w sp "character pattern has no checked Char carrier", Nil)
      CPString sp ty text -> string-pattern w sp ty value text failed
      other -> (refuse w (Span 0 0 1 1) "pattern form needs typed runtime match lowering", Nil)
  match-fields :: CorePattern -> String -> Nat -> String -> Writer -> (Writer, List Local)
  match-fields fields pointer index failed w = case fields of
    CPDone end -> (w, Nil)
    CPField sp (CPProof at predicate id name) rest -> match-fields rest pointer index failed w
    CPField sp first rest ->
      let (one, slot) = fresh w "%ptr" in
      let (two, value) = fresh one "%v" in
      let loaded = line (line two (cat ["  ", slot, " = getelementptr i64, ptr ", pointer, ", i64 ", nat-to-string index])) (cat ["  ", value, " = load i64, ptr ", slot]) in
      case match-pattern first value failed loaded of
        (bound, bindings) -> case match-fields rest pointer (index + 1) failed bound of
          (done, more) -> (done, bindings <> more)
    other -> (refuse w (Span 0 0 1 1) "malformed tuple pattern spine", Nil)
  guarded-expression :: List CoreDefinition -> List Local -> Writer -> String -> CoreTerm -> (Writer, String)
  guarded-expression definitions locals w failed term = case term of
    CRequire sp ty body -> guarded-expression definitions locals w failed body
    CGuard sp ty condition body -> if core-alternative-covers term then guarded-expression definitions locals w failed body
      else (case expression definitions locals w condition of
        (ready, value) -> guarded-expression definitions locals (continue-if ready value failed) failed body)
    CLet sp ty id name sc rhs body -> if row-guarded body then guarded-let definitions locals w failed sp id sc rhs body
      else expression definitions locals w term
    other -> expression definitions locals w term
  row-guarded :: CoreTerm -> Bool
  row-guarded term = case term of
    CLet sp ty id name sc rhs body -> row-guarded body
    CRequire sp ty body -> row-guarded body
    CGuard sp ty condition body -> True
    other -> False
  guarded-let :: List CoreDefinition -> List Local -> Writer -> String -> Span -> Nat -> Scheme -> CoreTerm -> CoreTerm -> (Writer, String)
  guarded-let definitions locals w failed sp id sc rhs body = case scheme-params sc of
    Nil -> if scheme-supported (writer-context w) sc && word-type (writer-context w) (scheme-body sc) then
      (case expression definitions locals w rhs of
        (bound, value) ->
          let bound-locals = Cons (Local id (scheme-body sc) value) locals in
          let release = count-op False (scheme-body sc) value in
          if core-alternative-covers body then (case guarded-expression definitions bound-locals bound failed body of
            (done, result) -> (release done, result))
          else let (one, cleanup) = fresh bound "guardcleanup" in
            let (two, next) = fresh one "guardpassed" in
            let (done, result) = guarded-expression definitions bound-locals two cleanup body in
            let missed = line (line (release done) (cat ["  br label %", next])) (cat [cleanup, ":"]) in
            (line (line (release missed) (cat ["  br label %", failed])) (cat [next, ":"]), result))
      else unsupported w sp "guarded where binding needs a runtime word"
    other -> if local-function-value rhs && (case scheme-requirements sc of Nil -> True; other -> False) then
      guarded-expression definitions locals w failed (specialize-local id sc rhs body)
      else unsupported w sp "guarded where binding needs runtime specialization"
  -- A case whose scrutinee is a saturated constructor application already
  -- knows its alternative. Evaluating the scrutinee allocates a cell the
  -- case takes apart at once, so the alternative is lowered with the
  -- applied arguments in place of its binders, and those arguments are
  -- released where the allocation would have owned them. An alternative
  -- that reads the scrutinee as a whole cannot be expressed this way, and
  -- an alternative guarded by a row keeps the allocating path because a
  -- failed guard must reach the alternatives after it.
  data CaseFold where
    FoldCase :: CorePattern -> CoreTerm -> CaseFold
    FoldAbsent :: CaseFold
    FoldBlocked :: CaseFold
  fold-known-case :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> CoreTerm -> Option (Writer, String)
  fold-known-case definitions locals w value alternatives = case erased-constructor-call value Nil of
    Some (name, actuals, args) -> fold-known-application definitions locals w (core-type value) name args alternatives
    None -> case value of
      CLocal lsp lty id lname Nil -> case deferred-constructor id locals of
        Some (ctor, actuals, args) -> fold-known-application definitions locals w (core-type value) ctor args alternatives
        None -> case inline-scrutinee definitions w value of
          Some (name, args) -> fold-known-application definitions locals w (core-type value) name args alternatives
          None -> None
      other -> case inline-scrutinee definitions w value of
        Some (name, args) -> fold-known-application definitions locals w (core-type value) name args alternatives
        None -> None
  deferred-constructor :: Nat -> List Local -> Option (String, List UType, List CoreTerm)
  deferred-constructor id locals = case locals of
    Nil -> None
    Cons (DeferredConstructor key ty name actuals args) rest -> if key == id then Some (name, actuals, args) else deferred-constructor id rest
    Cons other rest -> deferred-constructor id rest
  -- A let-bound constructor application is deferred only when its single
  -- use is a case scrutinee and every argument is already a value: then
  -- nothing between the binder and that case can observe when the
  -- arguments were read or that the cell was never built.
  deferred-let :: Writer -> Nat -> Scheme -> CoreTerm -> CoreTerm -> Bool
  deferred-let w id sc rhs body =
    (case scheme-params sc of Nil -> True; other -> False) && (case scheme-requirements sc of Nil -> True; other -> False)
      && scheme-supported (writer-context w) sc && word-type (writer-context w) (scheme-body sc)
      && case-scrutinee-only id body && (case deferred-value (writer-data w) rhs of Some plan -> True; None -> False)
  deferred-value :: List CoreData -> CoreTerm -> Option (String, List UType, List CoreTerm)
  deferred-value datas rhs = case erased-constructor-call rhs Nil of
    Some (name, actuals, args) -> if trivial-arguments args && (case constructor name datas of Some found -> True; None -> False) then Some (name, actuals, args) else None
    None -> None
  trivial-arguments :: List CoreTerm -> Bool
  trivial-arguments args = case args of
    Nil -> True
    Cons first rest -> trivial-term first && trivial-arguments rest
  trivial-term :: CoreTerm -> Bool
  trivial-term term = case term of
    CLocal sp ty id name Nil -> True
    CInt sp ty text -> True
    CString sp ty text -> True
    CChar sp ty text -> True
    CUnit sp ty -> True
    CProofRef sp ty id name -> True
    CProofRefl sp ty -> True
    CUse sp ty name role actuals -> same role "constructor"
    other -> False
  -- Exactly one use of the binder, and that use is a case scrutinee.
  case-scrutinee-only :: Nat -> CoreTerm -> Bool
  case-scrutinee-only id body = not (other-local-use id body) && case-scrutinee-count id body == 1
  other-local-use :: Nat -> CoreTerm -> Bool
  other-local-use id term = case term of
    CLocal sp ty key name actuals -> key == id
    CCase sp ty value alternatives -> case-local-use id value || other-local-use id alternatives
    -- A closure rebuilds its environment from captures, and a deferred
    -- constructor carries no word to capture. A use inside one is therefore
    -- never the scrutinee deferral is admitted for, even when it is that
    -- closure's case scrutinee.
    CLambda sp ty pattern body -> term-uses id term
    CRecursiveFunctions sp ty members body -> term-uses id term
    CRecursiveValues sp ty region members body -> term-uses id term
    other -> other-local-use-any id (runtime-term-children term)
  case-local-use :: Nat -> CoreTerm -> Bool
  case-local-use id value = case value of
    CLocal sp ty key name Nil -> False
    other -> other-local-use id other
  other-local-use-any :: Nat -> List CoreTerm -> Bool
  other-local-use-any id terms = case terms of
    Nil -> False
    Cons first rest -> other-local-use id first || other-local-use-any id rest
  case-scrutinee-count :: Nat -> CoreTerm -> Nat
  case-scrutinee-count id term = case term of
    CCase sp ty value alternatives -> case-scrutinee-value id value + case-scrutinee-count-any id (runtime-term-children term)
    other -> case-scrutinee-count-any id (runtime-term-children term)
  case-scrutinee-count-any :: Nat -> List CoreTerm -> Nat
  case-scrutinee-count-any id terms = case terms of
    Nil -> 0
    Cons first rest -> case-scrutinee-count id first + case-scrutinee-count-any id rest
  case-scrutinee-value :: Nat -> CoreTerm -> Nat
  case-scrutinee-value id value = case value of
    CLocal sp ty key name Nil -> if key == id then 1 else 0
    other -> 0
  fold-known-application :: List CoreDefinition -> List Local -> Writer -> UType -> String -> List CoreTerm -> CoreTerm -> Option (Writer, String)
  fold-known-application definitions locals w ty name args alternatives = case known-constructor-fields w ty name of
    Some count -> if count == list-length args then (case fold-alternatives alternatives name count of
        FoldCase fields body -> if row-guarded body then None else Some (fold-case-body definitions locals w args fields body)
        other -> None)
      else None
    None -> None
  -- The runtime field count of a constructor whose declared representation
  -- the allocating path supports, so folding never admits a case the
  -- ordinary path refuses.
  known-constructor-fields :: Writer -> UType -> String -> Option Nat
  known-constructor-fields w ty name =
    if named ty "Bool" && (same name "True" || same name "False") then Some 0
    else if decision-word-type ty && (same name "b.Yes" || same name "b.No") then Some 0
    else case constructor name (writer-data w) of
      Some (owner, tag, c) -> if list-length (core-constructor-fields c) <= 16 && tag < 16777216 then Some (list-length (core-constructor-fields c)) else None
      None -> None
  fold-alternatives :: CoreTerm -> String -> Nat -> CaseFold
  fold-alternatives alternatives name count = case alternatives of
    CAlternative sp pattern body rest -> case fold-alternative pattern name count body of
      FoldAbsent -> fold-alternatives rest name count
      other -> other
    other -> FoldBlocked
  fold-alternative :: CorePattern -> String -> Nat -> CoreTerm -> CaseFold
  fold-alternative pattern name count body = case pattern of
    CPWild sp ty -> FoldCase (CPDone sp) body
    CPVar sp ty id binder -> if term-local-use id body then FoldBlocked else FoldCase (CPDone sp) body
    CPAs sp ty id binder inner -> if term-local-use id body then FoldBlocked else fold-alternative inner name count body
    CPConstructor sp ty cname actuals sc fields ->
      if same cname name then
        if runtime-field-count fields 0 == count && fold-field-check fields body then FoldCase fields body else FoldBlocked
      else FoldAbsent
    other -> FoldAbsent
  -- A field pattern this transform can bind is a variable, a wildcard, or
  -- an as-pattern over one: every binder is then a whole argument word. A
  -- nested constructor or tuple pattern stays refused, and a field binder
  -- the body reads as a whole value keeps the allocating path.
  runtime-field-count :: CorePattern -> Nat -> Nat
  runtime-field-count fields count = case fields of
    CPDone sp -> count
    CPField sp (CPProof at predicate id binder) rest -> runtime-field-count rest count
    CPField sp first rest -> runtime-field-count rest (count + 1)
    other -> count
  -- A field pattern binds whole argument words, so any binder may be used:
  -- only a nested constructor, tuple or literal pattern has no word to bind
  -- and keeps the allocating path.
  fold-field-check :: CorePattern -> CoreTerm -> Bool
  fold-field-check fields body = case fields of
    CPDone sp -> True
    CPField sp (CPProof at predicate id binder) rest -> fold-field-check rest body
    CPField sp first rest -> fold-leaf-check first && fold-field-check rest body
    other -> False
  fold-leaf-check :: CorePattern -> Bool
  fold-leaf-check pattern = case pattern of
    CPWild sp ty -> True
    CPVar sp ty id binder -> True
    CPAs sp ty id binder inner -> fold-leaf-check inner
    other -> False
  term-local-use :: Nat -> CoreTerm -> Bool
  term-local-use id term = case term of
    CLocal sp ty key name actuals -> key == id
    other -> term-local-use-any id (runtime-term-children term)
  term-local-use-any :: Nat -> List CoreTerm -> Bool
  term-local-use-any id terms = case terms of
    Nil -> False
    Cons first rest -> term-local-use id first || term-local-use-any id rest
  fold-case-body :: List CoreDefinition -> List Local -> Writer -> List CoreTerm -> CorePattern -> CoreTerm -> (Writer, String)
  fold-case-body definitions locals w args fields body =
    case expressions definitions locals w args of
      (evaluated, words) -> case expression definitions (fold-field-locals fields words <> locals) evaluated body of
        (done, result) -> (release-terms (term-types args) words done, result)
  -- The binders of a folded alternative, in argument order, as borrowed
  -- reads of the evaluated arguments. Only reached after the field check
  -- admitted the spine, so the walk consumes every word that is there.
  fold-field-locals :: CorePattern -> List String -> List Local
  fold-field-locals fields words = case fields of
    CPDone sp -> Nil
    CPField sp (CPProof at predicate id binder) rest -> fold-field-locals rest words
    CPField sp first rest -> case words of
      Nil -> Nil
      Cons word more -> case first of
        CPWild wspan wty -> fold-field-locals rest more
        CPVar vspan vty id binder -> Cons (Borrowed id vty word) (fold-field-locals rest more)
        CPAs aspan atyp id binder (CPWild ispan ity) -> Cons (Borrowed id atyp word) (fold-field-locals rest more)
        CPAs aspan atyp id binder (CPVar ispan ity iid ibinder) -> Cons (Borrowed id atyp word) (Cons (Borrowed iid ity word) (fold-field-locals rest more))
        other -> Nil
    other -> Nil
  release-terms :: List UType -> List String -> Writer -> Writer
  release-terms types words w = case (types, words) of
    (Cons first rest, Cons word more) -> release-terms rest more (count-op False first word w)
    other -> w
  -- A unit small enough to copy is copied at each of its call sites. The
  -- copy binds its arguments where the call would pass them and releases
  -- them where the callee's worker releases its parameters, so the copy
  -- counts references exactly as the call did. Copying is bounded by a node
  -- budget of two percent of the program, and no admitted unit may name
  -- another admitted unit: that fixed point is the loop-breaker rule, and
  -- it is what keeps a recursive group out.
  inline-body-shape :: CoreDefinition -> Option (List CorePattern, CoreTerm)
  inline-body-shape d = case (core-givens d, core-openings d, core-clauses d) of
    (Nil, Nil, [MkCoreClause sp patterns body]) -> if variable-patterns patterns && not (row-guarded body) then Some (patterns, body) else None
    other -> None
  variable-patterns :: List CorePattern -> Bool
  variable-patterns patterns = case patterns of
    Nil -> True
    Cons first rest -> (case first of CPVar sp ty id name -> True; other -> False) && variable-patterns rest
  term-nodes :: CoreTerm -> Nat
  term-nodes term = 1 + term-nodes-any (runtime-term-children term)
  term-nodes-any :: List CoreTerm -> Nat
  term-nodes-any terms = case terms of Nil -> 0; Cons first rest -> term-nodes first + term-nodes-any rest
  definition-nodes :: CoreDefinition -> Nat
  definition-nodes d = clause-nodes (core-clauses d)
  clause-nodes :: List CoreClause -> Nat
  clause-nodes clauses = case clauses of
    Nil -> 0
    Cons (MkCoreClause sp patterns body) rest -> term-nodes body + clause-nodes rest
  program-nodes :: List CoreDefinition -> Nat
  program-nodes definitions = case definitions of
    Nil -> 0
    Cons first rest -> definition-nodes first + program-nodes rest
  -- The copy limit is the seed's: two percent of the program, never less
  -- than a thousand nodes, so a small program still admits its wrappers.
  inline-limit :: List CoreDefinition -> Nat
  inline-limit definitions = let total = program-nodes definitions in if total / 50 < 1000 then 1000 else total / 50
  inline-candidates :: List CoreDefinition -> List (String, CoreTerm) -> List (String, CoreTerm)
  inline-candidates definitions entries = case definitions of
    Nil -> entries
    Cons d rest -> case inline-body-shape d of
      Some (patterns, body) -> if term-nodes body <= 40 then inline-candidates rest (Cons (core-name d, body) entries) else inline-candidates rest entries
      None -> inline-candidates rest entries
  inline-admitted-names :: List CoreDefinition -> List String
  inline-admitted-names definitions = inline-class-names definitions (inline-spend definitions (inline-candidates definitions Nil) (inline-limit definitions) Nil)
  -- Admit entries while the budget lasts, then drop every entry whose body
  -- names an admitted entry, until nothing changes. The result names units
  -- no admitted unit reaches, so a copy can only reference units that are
  -- not copied, and no cycle of copies can exist.
  inline-spend :: List CoreDefinition -> List (String, CoreTerm) -> Nat -> List String -> List String
  inline-spend definitions entries budget names = case entries of
    Nil -> inline-settle definitions (inline-remove-referenced definitions names names Nil) names
    Cons (name, body) rest -> let cost = term-nodes body in
      if budget < cost then inline-spend definitions rest budget names else inline-spend definitions rest (budget - cost) (Cons name names)
  inline-settle :: List CoreDefinition -> List String -> List String -> List String
  inline-settle definitions names previous = if list-length names == list-length previous then names else
    inline-settle definitions (inline-remove-referenced definitions names names Nil) names
  inline-remove-referenced :: List CoreDefinition -> List String -> List String -> List String -> List String
  inline-remove-referenced definitions names admitted kept = case names of
    Nil -> kept
    Cons name rest -> if inline-unit-references admitted definitions name then inline-remove-referenced definitions rest admitted kept else inline-remove-referenced definitions rest admitted (Cons name kept)
  name-listed :: String -> List String -> Bool
  name-listed name names = case names of Nil -> False; Cons first rest -> same name first || name-listed name rest
  term-refers :: List String -> CoreTerm -> Bool
  term-refers names term = case term of
    CUse sp ty name role actuals -> name-listed name names || term-refers-any names (runtime-term-children term)
    CQualifiedUse sp ty name role actuals evidence -> name-listed name names || term-refers-any names (runtime-term-children term)
    other -> term-refers-any names (runtime-term-children term)
  term-refers-any :: List String -> List CoreTerm -> Bool
  term-refers-any names terms = case terms of
    Nil -> False
    Cons first rest -> term-refers names first || term-refers-any names rest
  clauses-refer :: List String -> List CoreClause -> Bool
  clauses-refer names clauses = case clauses of
    Nil -> False
    Cons (MkCoreClause sp patterns body) rest -> term-refers names body || clauses-refer names rest
  inline-unit-references :: List String -> List CoreDefinition -> String -> Bool
  inline-unit-references names definitions name = case definitions of
    Nil -> False
    Cons d rest -> if same name (core-name d) then clauses-refer names (core-clauses d) else inline-unit-references names rest name
  -- The unfoldable class: a body whose every node is work the code
  -- generator performs at the site of the node. A unit in the class is
  -- copied to every call site, whatever the site count, because a copy
  -- replaces a call and its frame with the instruction itself. The class
  -- excludes every node whose copy creates a scope or an allocation site:
  -- a lambda, a recursive group, a scope, a handler, a join, a `let` (whose
  -- binder is a slot of the defining unit), a construction, and a decision
  -- whose scrutinee is unknown here. A decision over a known constructor is
  -- admitted because it folds, which is the shallow case rule.
  --
  -- Admission is the class plus a size cap: 12 nodes for a body of
  -- projections and primitives, 40 when it calls another unit (a link the
  -- recursive rule expands, so a chain can close), and 24 with a decision.
  -- A directly recursive body is refused; an indirect cycle is broken at
  -- emission by the plan's unfolding stack.
  unfold-shape :: CoreTerm -> Option UnfoldShape
  unfold-shape term = case term of
    CInt sp ty text -> Some (MkUnfoldShape False 0)
    CString sp ty text -> Some (MkUnfoldShape False 0)
    CChar sp ty text -> Some (MkUnfoldShape False 0)
    CUnit sp ty -> Some (MkUnfoldShape False 0)
    -- A constructor use is a block build: one allocation per copy.
    CUse sp ty name role actuals -> if same role "constructor" then None else Some (MkUnfoldShape False 0)
    CQualifiedUse sp ty name role actuals evidence -> if same role "constructor" then None else Some (MkUnfoldShape False 0)
    CLocal sp ty key name actuals -> Some (MkUnfoldShape False 0)
    CProofRef sp ty index name -> Some (MkUnfoldShape False 0)
    CProofRefl sp ty -> Some (MkUnfoldShape False 0)
    CProofSearch sp ty decide warrant -> Some (MkUnfoldShape False 0)
    CApply sp ty f x -> case unfold-merge (unfold-shape f) (unfold-shape x) of
      Some (MkUnfoldShape chain cases) -> Some (MkUnfoldShape (chain || is-unit-spine f) cases)
      None -> None
    CErasedApply sp ty row f witness -> unfold-merge (unfold-shape f) (unfold-shape witness)
    CDecision sp ty predicate condition -> unfold-shape condition
    CPrimitive sp ty name arg -> unfold-shape arg
    CProved sp ty warrant body -> unfold-shape body
    CRefine sp ty warrant body -> unfold-shape body
    CRefineProof sp ty warrant body -> unfold-merge (unfold-shape warrant) (unfold-shape body)
    CDischarge sp ty warrants body -> unfold-shape body
    CForget sp ty body -> unfold-shape body
    CIf sp ty test yes no -> unfold-merge (unfold-merge (unfold-shape test) (unfold-shape yes)) (unfold-shape no)
    CArgument sp first rest -> unfold-merge (unfold-shape first) (unfold-shape rest)
    CArgumentsEnd sp -> Some (MkUnfoldShape False 0)
    other -> None
  unfold-merge :: Option UnfoldShape -> Option UnfoldShape -> Option UnfoldShape
  unfold-merge a b = case (a, b) of
    (Some (MkUnfoldShape chain-a cases-a), Some (MkUnfoldShape chain-b cases-b)) -> Some (MkUnfoldShape (chain-a || chain-b) (cases-a + cases-b))
    (other, more) -> None
  -- An application spine whose head names a unit: the link a copy may
  -- expand. It only widens the cap, so a false positive costs nothing.
  is-unit-spine :: CoreTerm -> Bool
  is-unit-spine term = case term of
    CUse sp ty name role actuals -> True
    CQualifiedUse sp ty name role actuals evidence -> True
    CApply sp ty f x -> is-unit-spine f
    CApplyEff sp ty row f x -> is-unit-spine f
    CErasedApply sp ty row f witness -> is-unit-spine f
    other -> False
  -- Twelve nodes is the whole class cap on this side. The measurement is
  -- what set it: admitting a body with a unit call up to forty nodes copied
  -- a twenty-node body with calls in both branches four hundred times, and
  -- the self-hosted IR grew by 3.6 % with two thousand more allocation
  -- sites. A wrapper that delegates to another unit is two to seven nodes,
  -- so the wider cap bought nothing the target class needs.
  inline-class-candidate :: CoreDefinition -> Option UnfoldShape
  inline-class-candidate d = case inline-body-shape d of
    Some (patterns, body) ->
      if term-refers (Cons (core-name d) Nil) body then None else
        (case unfold-shape body of
          Some shape -> if term-nodes body <= 12 then Some shape else None
          None -> None)
    None -> None
  inline-class-names :: List CoreDefinition -> List String -> List String
  inline-class-names definitions known = case definitions of
    Nil -> known
    Cons d rest -> case inline-class-candidate d of
      Some shape -> inline-class-names rest (Cons (core-name d) known)
      None -> inline-class-names rest known
  inline-plan :: Bool -> List CoreDefinition -> ProgramInfo -> InlinePlan
  inline-plan enabled definitions info = if enabled then InlinePlan True (inline-admitted-names definitions) Nil else NoInline
  with-inline :: InlinePlan -> Writer -> Writer
  with-inline plan w = case w of Writer next globals code errors layouts context -> Writer next globals code errors layouts (context-inline plan context)
  context-inline :: InlinePlan -> RuntimeContext -> RuntimeContext
  context-inline plan context = case context of RuntimeContext info bounds rigids pending done current -> RuntimeContext info bounds rigids pending done plan
  inline-admitted :: RuntimeContext -> String -> Bool
  inline-admitted context name = case context of
    RuntimeContext info bounds rigids pending done plan -> case plan of
      InlinePlan enabled names stack -> enabled && name-listed name names && not (name-listed name stack)
      NoInline -> False
  -- The unfolding stack and its one bound: a unit already on the stack is
  -- refused, so a cycle of admitted units cannot recurse without end, and
  -- the depth cap bounds a long acyclic chain.
  inline-stack :: RuntimeContext -> List String
  inline-stack context = case context of
    RuntimeContext info bounds rigids pending done plan -> case plan of
      InlinePlan enabled names stack -> stack
      NoInline -> Nil
  inline-depth :: RuntimeContext -> Nat
  inline-depth context = list-length (inline-stack context)
  context-push-inline :: String -> RuntimeContext -> RuntimeContext
  context-push-inline name context = case context of
    RuntimeContext info bounds rigids pending done plan -> case plan of
      InlinePlan enabled names stack -> RuntimeContext info bounds rigids pending done (InlinePlan enabled names (Cons name stack))
      NoInline -> context
  push-inline :: String -> Writer -> Writer
  push-inline name w = case w of Writer next globals code errors layouts context -> Writer next globals code errors layouts (context-push-inline name context)
  -- The push is only in scope while the copy is being emitted. Popping the
  -- head restores the plan the site was reached with, because every nested
  -- push inside the copy has already popped itself.
  context-pop-inline :: RuntimeContext -> RuntimeContext
  context-pop-inline context = case context of
    RuntimeContext info bounds rigids pending done plan -> case plan of
      InlinePlan enabled names (Cons first stack) -> RuntimeContext info bounds rigids pending done (InlinePlan enabled names stack)
      other -> context
  pop-inline :: Writer -> Writer
  pop-inline w = case w of Writer next globals code errors layouts context -> Writer next globals code errors layouts (context-pop-inline context)
  inline-call :: List CoreDefinition -> List Local -> Writer -> Span -> CoreDefinition -> List Nat -> List String -> List CoreTerm -> Option (Writer, String)
  inline-call definitions locals w sp d classes givens args =
    if not (inline-admitted (writer-context w) (core-name d)) then None
    else if inline-depth (writer-context w) >= 6 then None
    else if (case givens of Nil -> True; other -> False) then
      (case inline-body-shape d of
        Some (patterns, body) -> if list-length args == list-length patterns then
          (case definition-context d classes w of
            Some (RuntimeContext info bounds rigids pending done inlining) ->
              (case inline-copy definitions locals (push-inline (core-name d) (with-representations bounds rigids w)) args patterns body of
                (done, result) -> Some (pop-inline done, result))
            None -> None)
          else None
        None -> None)
    else None
  inline-copy :: List CoreDefinition -> List Local -> Writer -> List CoreTerm -> List CorePattern -> CoreTerm -> (Writer, String)
  inline-copy definitions locals w args patterns body =
    case expressions definitions locals w args of
      (evaluated, words) -> case expression definitions (parameter-locals patterns words <> locals) evaluated body of
        (done, result) -> (release-terms (term-types args) words done, result)
  parameter-locals :: List CorePattern -> List String -> List Local
  parameter-locals patterns words = case (patterns, words) of
    (Cons (CPVar sp ty id name) rest, Cons word more) -> Cons (Borrowed id ty word) (parameter-locals rest more)
    other -> Nil
  -- The scrutinee of a case can be a call whose unit answers with a
  -- constructor application of its own parameters in order: the applied
  -- arguments are then the fields, and the case folds without the block
  -- the call would have allocated.
  call-spine :: CoreTerm -> List CoreTerm -> Option (String, List UType, List CoreTerm)
  call-spine term args = case term of
    CUse sp ty name role actuals -> if same role "constructor" then None else Some (name, actuals, args)
    CApply sp ty f x -> call-spine f (Cons x args)
    CApplyEff sp ty row f x -> call-spine f (Cons x args)
    CErasedApply sp ty row f witness -> call-spine f args
    other -> None
  identity-arguments :: List CorePattern -> List CoreTerm -> Bool
  identity-arguments patterns args = case (patterns, args) of
    (Cons (CPVar sp ty id name) rest, Cons (CLocal at aty key kname Nil) more) -> id == key && identity-arguments rest more
    (other, Nil) -> True
    other -> False
  inline-scrutinee :: List CoreDefinition -> Writer -> CoreTerm -> Option (String, List CoreTerm)
  inline-scrutinee definitions w value = case call-spine value Nil of
    Some (name, actuals, args) -> if not (inline-admitted (writer-context w) name) then None else case definition name definitions of
      Some d -> case inline-body-shape d of
        Some (patterns, body) -> if list-length args /= list-length patterns then None else case erased-constructor-call body Nil of
          Some (ctor, ctor-actuals, ctor-args) -> if identity-arguments patterns ctor-args then Some (ctor, args) else None
          None -> None
        None -> None
      None -> None
    None -> None
  -- A case dispatches once when every alternative is a plain constructor
  -- test: the tag is read once and one switch selects the arm, so an arm
  -- costs the same wherever it sits. Guards, refutable nested fields,
  -- repeated tags and mixed shapes keep the chain, whose source order then
  -- decides which arm runs.
  data CaseClass where
    UnsetClass :: CaseClass
    HeaderClass :: CaseClass
    ImmediateClass :: CaseClass
    MixedClass :: CaseClass
  data CaseDispatch where
    -- The switch tests the header tag. Its payload is the switch's case
    -- list, whose labels derive from the base name and the arm's position.
    HeaderDispatch :: String -> CaseDispatch
    -- The switch tests the value itself: the Bool and decision kernels
    -- already hold their tag as the word.
    ImmediateDispatch :: String -> CaseDispatch
    -- The alternatives are tested in source order, one at a time.
    ChainDispatch :: CaseDispatch
  data ArmPlan where
    -- The switch selects this tag, and the arm binds its fields from the
    -- cell the tag selected.
    TagArm :: String -> ArmPlan
    -- The switch tests this constant against the value, and the arm binds
    -- nothing: no field of such a pattern survives erasure.
    WordArm :: String -> ArmPlan
    NoArm :: ArmPlan
  -- One case's join: where the arms deliver their words, where an unmatched
  -- tag goes, the switch's label base, the scrutinee's type, and the word
  -- every arm releases once it holds its own result.
  data SwitchJoin where
    SwitchJoin :: String -> String -> String -> UType -> String -> SwitchJoin
  -- A pattern that cannot fail once the switch has selected its arm, so the
  -- arm needs no test of its own.
  irrefutable-pattern :: CorePattern -> Bool
  irrefutable-pattern pattern = case pattern of
    CPVar sp ty id name -> True
    CPWild sp ty -> True
    CPAs sp ty id name inner -> irrefutable-pattern inner
    CPTuple sp ty fields -> irrefutable-fields fields
    other -> False
  irrefutable-fields :: CorePattern -> Bool
  irrefutable-fields fields = case fields of
    CPDone sp -> True
    CPField sp (CPProof at ty id name) rest -> irrefutable-fields rest
    CPField sp first rest -> irrefutable-pattern first && irrefutable-fields rest
    other -> False
  -- The tag a pattern names, when a switch can test it. The constant is the
  -- one this alternative's own pattern tests, never a neighbouring one's.
  arm-plan :: Writer -> CorePattern -> ArmPlan
  arm-plan w pattern = if not (word-type (writer-context w) (pattern-type pattern)) then NoArm
    else case pattern of
      -- A decision value is a produced constructor, not a tag: its word is
      -- not the 0/1 the chain's kernel test compares, so the switch keeps
      -- the chain for it rather than naming cases no value can have.
      CPConstructor sp ty name actuals sc fields ->
        if decision-word-type ty then NoArm
        else if named ty "Bool" && (same name "True" || same name "False") then
          WordArm (if same name "True" then "1" else "0")
        else case constructor name (writer-data w) of
          Some (owner, tag, c) -> if list-length (core-constructor-fields c) <= 16 && tag < 16777216 && irrefutable-fields fields then TagArm (nat-to-string tag) else NoArm
          None -> NoArm
      other -> NoArm
  -- The dispatch a case can use. The switch's case list is fixed before any
  -- arm is emitted, so the switch can name labels the arms have not yet
  -- produced.
  case-dispatch :: Writer -> CoreTerm -> String -> CaseDispatch
  case-dispatch w alternatives base = case dispatch-spine w alternatives UnsetClass Nil "" base 0 of
    (HeaderClass, entries) -> HeaderDispatch entries
    (ImmediateClass, entries) -> ImmediateDispatch entries
    other -> ChainDispatch
  dispatch-spine :: Writer -> CoreTerm -> CaseClass -> List String -> String -> String -> Nat -> (CaseClass, String)
  dispatch-spine w alternatives so-far tags entries base index = case alternatives of
    CAlternativesEnd sp -> (so-far, entries)
    CAlternative sp pattern body rest -> case pattern of
      CPVar at ty id name -> dispatch-default w body rest so-far entries
      CPWild at ty -> dispatch-default w body rest so-far entries
      other -> if row-guarded body then (MixedClass, entries) else case arm-plan w pattern of
        TagArm tag -> dispatch-arm w rest HeaderClass tag so-far tags entries base index
        WordArm tag -> dispatch-arm w rest ImmediateClass tag so-far tags entries base index
        NoArm -> (MixedClass, entries)
    other -> (MixedClass, entries)
  dispatch-default :: Writer -> CoreTerm -> CoreTerm -> CaseClass -> String -> (CaseClass, String)
  dispatch-default w body rest so-far entries = case rest of
    -- A default alternative captures every remaining tag, so only the last
    -- one can be the switch's default label.
    CAlternativesEnd sp -> (if row-guarded body then MixedClass else so-far, entries)
    other -> (MixedClass, entries)
  dispatch-arm :: Writer -> CoreTerm -> CaseClass -> String -> CaseClass -> List String -> String -> String -> Nat -> (CaseClass, String)
  dispatch-arm w rest class tag so-far tags entries base index =
    if tag-listed tag tags || not (compatible-class so-far class) then (MixedClass, entries)
      else dispatch-spine w rest class (Cons tag tags)
        (cat [entries, "\n  i64 ", tag, ", label %", base, ".", nat-to-string index]) base (index + 1)
  -- A repeated tag would make the switch ill formed, and the chain's first
  -- test is the one that runs.
  tag-listed :: String -> List String -> Bool
  tag-listed tag tags = case tags of Nil -> False; Cons first rest -> same tag first || tag-listed tag rest
  compatible-class :: CaseClass -> CaseClass -> Bool
  compatible-class so-far next = case so-far of
    UnsetClass -> True
    HeaderClass -> case next of HeaderClass -> True; other -> False
    ImmediateClass -> case next of ImmediateClass -> True; other -> False
    other -> False
  case-value :: List CoreDefinition -> List Local -> Writer -> UType -> String -> CoreTerm -> (Writer, String)
  case-value definitions locals w ty value alternatives =
    let (one, base) = fresh w "alt" in
    case case-dispatch one alternatives base of
      HeaderDispatch entries -> switch-value definitions locals one ty value True base entries alternatives
      ImmediateDispatch entries -> switch-value definitions locals one ty value False base entries alternatives
      ChainDispatch -> case-chain definitions locals one ty value alternatives
  -- The chain tests one alternative at a time and stores the taken arm's
  -- word in the join's slot. Any shape reaches a slot, guarded or not, so
  -- this is the fallback for everything a single dispatch cannot take.
  case-chain :: List CoreDefinition -> List Local -> Writer -> UType -> String -> CoreTerm -> (Writer, String)
  case-chain definitions locals w ty value alternatives =
    let (one, slot) = fresh w "%slot" in
    let (two, joined) = fresh one "casejoin" in
    let finished = case-rows definitions locals (line two (cat ["  ", slot, " = alloca i64"])) ty value slot joined alternatives in
    let (ready, result) = fresh (line finished (cat [joined, ":"])) "%v" in
    (line ready (cat ["  ", result, " = load i64, ptr ", slot]), result)
  case-rows :: List CoreDefinition -> List Local -> Writer -> UType -> String -> String -> String -> CoreTerm -> Writer
  case-rows definitions locals w ty value slot joined alternatives = case alternatives of
    CAlternativesEnd end -> line w "  unreachable"
    CAlternative sp pattern body rest ->
      let (one, failed) = fresh w "nextalt" in
      case match-pattern pattern value failed one of
        (matched, bindings) -> case guarded-expression definitions (bindings <> locals) matched failed body of
          (done, result) -> let stored = line (count-op False ty value done) (cat ["  store i64 ", result, ", ptr ", slot]) in
            let next = line (line stored (cat ["  br label %", joined])) (cat [failed, ":"]) in
            case-rows definitions locals next ty value slot joined rest
    other -> line (refuse w (Span 0 0 1 1) "malformed case alternative spine") "  unreachable"
  -- One switch for the whole case, then one block per arm. Each arm leaves
  -- through a block of its own, so the join names every predecessor and
  -- becomes a phi rather than a slot.
  switch-value :: List CoreDefinition -> List Local -> Writer -> UType -> String -> Bool -> String -> String -> CoreTerm -> (Writer, String)
  switch-value definitions locals w ty value header base entries alternatives =
    let (one, missed) = fresh w "switchmiss" in
    let (two, joined) = fresh one "casejoin" in
    let join = SwitchJoin joined missed base ty value in
    if header then (case constructor-tag w value of
      (loaded, tag) -> switch-arms definitions locals (line loaded (cat ["  switch i64 ", tag, ", label %", missed, " [", entries, "\n]"])) join alternatives 0 "" False)
    else switch-arms definitions locals (line w (cat ["  switch i64 ", value, ", label %", missed, " [", entries, "\n]"])) join alternatives 0 "" False
  switch-arms :: List CoreDefinition -> List Local -> Writer -> SwitchJoin -> CoreTerm -> Nat -> String -> Bool -> (Writer, String)
  switch-arms definitions locals w join alternatives index incoming defaulted = case join of
    SwitchJoin joined missed base ty value -> case alternatives of
      CAlternativesEnd sp -> if defaulted then switch-join w join incoming
        else switch-join (line (line w (cat [missed, ":"])) "  unreachable") join incoming
      CAlternative sp pattern body rest -> case pattern of
        CPVar at pty id name -> switch-default-arm definitions (Cons (Borrowed id pty value) locals) w join body rest index incoming
        CPWild at pty -> switch-default-arm definitions locals w join body rest index incoming
        other -> case arm-plan w pattern of
          TagArm tag -> switch-tag-arm definitions locals w join pattern body rest index incoming defaulted
          WordArm tag -> switch-word-arm definitions locals w join body rest index incoming defaulted
          NoArm -> (line (refuse w sp "case alternative disagrees with the dispatch it was chosen for") "  unreachable", incoming)
      other -> (line (refuse w (Span 0 0 1 1) "malformed case alternative spine") "  unreachable", incoming)
  switch-join :: Writer -> SwitchJoin -> String -> (Writer, String)
  switch-join w join incoming = case join of
    SwitchJoin joined missed base ty value -> let (ready, result) = fresh (line w (cat [joined, ":"])) "%v" in
      (line ready (cat ["  ", result, " = phi i64 ", incoming]), result)
  -- A default arm captures the scrutinee whole, so it needs no cell.
  switch-default-arm :: List CoreDefinition -> List Local -> Writer -> SwitchJoin -> CoreTerm -> CoreTerm -> Nat -> String -> (Writer, String)
  switch-default-arm definitions locals w join body rest index incoming = case join of
    SwitchJoin joined missed base ty value ->
      let (one, out) = fresh w "armout" in
      let entry = line one (cat [missed, ":"]) in
      case guarded-expression definitions locals entry missed body of
        (done, result) -> switch-leave definitions locals done join out result rest index incoming True
  -- A constructor arm reached by the switch: its fields are read from the
  -- cell the tag selected. Every field pattern is irrefutable, so no field
  -- can reach the miss block.
  switch-tag-arm :: List CoreDefinition -> List Local -> Writer -> SwitchJoin -> CorePattern -> CoreTerm -> CoreTerm -> Nat -> String -> Bool -> (Writer, String)
  switch-tag-arm definitions locals w join pattern body rest index incoming defaulted = case join of
    SwitchJoin joined missed base ty value -> case pattern of
      CPConstructor sp aty name actuals sc fields ->
        let (one, out) = fresh w "armout" in
        let entry = line one (cat [base, ".", nat-to-string index, ":"]) in
        let (pointed, pointer) = fresh entry "%ptr" in
        let cell = line pointed (cat ["  ", pointer, " = inttoptr i64 ", value, " to ptr"]) in
        case match-fields fields pointer 0 missed cell of
          (bound, bindings) -> case guarded-expression definitions (bindings <> locals) bound missed body of
            (done, result) -> switch-leave definitions locals done join out result rest index incoming defaulted
      other -> (line (refuse w (Span 0 0 1 1) "dispatched arm is not a constructor pattern") "  unreachable", incoming)
  switch-word-arm :: List CoreDefinition -> List Local -> Writer -> SwitchJoin -> CoreTerm -> CoreTerm -> Nat -> String -> Bool -> (Writer, String)
  switch-word-arm definitions locals w join body rest index incoming defaulted = case join of
    SwitchJoin joined missed base ty value ->
      let (one, out) = fresh w "armout" in
      let entry = line one (cat [base, ".", nat-to-string index, ":"]) in
      case guarded-expression definitions locals entry missed body of
        (done, result) -> switch-leave definitions locals done join out result rest index incoming defaulted
  -- Deliver one arm's word to the join. The arm's own block names the join's
  -- predecessor, so the join reaches it without a slot.
  switch-leave :: List CoreDefinition -> List Local -> Writer -> SwitchJoin -> String -> String -> CoreTerm -> Nat -> String -> Bool -> (Writer, String)
  switch-leave definitions locals w join out result rest index incoming defaulted = case join of
    SwitchJoin joined missed base ty value ->
      let released = count-op False ty value w in
      let left = line (line released (cat ["  br label %", out])) (cat [out, ":"]) in
      switch-arms definitions locals (line left (cat ["  br label %", joined])) join rest (index + 1)
        (cat [incoming, if index == 0 then "" else ", ", "[ ", result, ", %", out, " ]"]) defaulted
  -- A word an arm contributes without emitting code and without a reference
  -- operation. Only then may a select choose between the arms: an operation
  -- emitted for both would run for the arm not taken.
  static-word :: List Local -> Writer -> CoreTerm -> Option String
  static-word locals w term = case term of
    CUnit sp ty -> if static-carrier (writer-context w) ty "0" then Some "0" else None
    CChar sp ty text -> if named ty "Char" then (case char-word text of
      Some word -> if static-carrier (writer-context w) ty word then Some word else None
      None -> None) else None
    CInt sp ty text -> if number ty then (case immediate-literal (named ty "Nat") text of
      Some word -> if static-carrier (writer-context w) ty word then Some word else None
      None -> None) else if raw-integer ty then (if static-carrier (writer-context w) ty text then Some text else None) else None
    CUse sp ty name role actuals -> if named ty "Bool" && same name "True" then (if static-carrier (writer-context w) ty "1" then Some "1" else None)
      else if named ty "Bool" && same name "False" then (if static-carrier (writer-context w) ty "0" then Some "0" else None) else None
    CLocal sp ty id name Nil -> case local id locals of
      Some (declared, word) -> if static-carrier (writer-context w) declared word then Some word else None
      None -> None
    other -> None
  -- A word needs no reference operation when its carrier is an immediate, or
  -- when the word is a constant, which is never a block.
  static-carrier :: RuntimeContext -> UType -> String -> Bool
  static-carrier context ty word = case word-class context ty of
    Some 0 -> True
    Some code -> constant-word word
    None -> False
  branch :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> CoreTerm -> CoreTerm -> (Writer, String)
  branch definitions locals w sp test yes no =
    let (tested, condition) = expression definitions locals w test in
    case static-word locals tested yes of
      Some left -> case static-word locals tested no of
        Some right -> branch-select tested condition left right
        None -> branch-diamond definitions locals tested condition yes no
      None -> branch-diamond definitions locals tested condition yes no
  -- Both arms are already words, so one select chooses between them and the
  -- branch disappears.
  branch-select :: Writer -> String -> String -> String -> (Writer, String)
  branch-select w condition left right =
    let (one, predicate) = fresh w "%v" in
    let (two, result) = fresh one "%v" in
    (line (line two (cat ["  ", predicate, " = icmp ne i64 ", condition, ", 0"])) (cat ["  ", result, " = select i1 ", predicate, ", i64 ", left, ", i64 ", right]), result)
  -- An arm that needs code of its own gets a block, and each arm leaves
  -- through a block of its own so the join is a phi.
  branch-diamond :: List CoreDefinition -> List Local -> Writer -> String -> CoreTerm -> CoreTerm -> (Writer, String)
  branch-diamond definitions locals w condition yes no =
    let (one, predicate) = fresh w "%v" in
    let (two, left) = fresh one "yes" in
    let (three, right) = fresh two "no" in
    let (four, left-out) = fresh three "yesout" in
    let (five, right-out) = fresh four "noout" in
    let (six, end) = fresh five "join" in
    let split = line (line six (cat ["  ", predicate, " = icmp ne i64 ", condition, ", 0"])) (cat ["  br i1 ", predicate, ", label %", left, ", label %", right]) in
    let (first, a) = expression definitions locals (line split (cat [left, ":"])) yes in
    let middle = line (line (line (line first (cat ["  br label %", left-out])) (cat [left-out, ":"])) (cat ["  br label %", end])) (cat [right, ":"]) in
    let (second, b) = expression definitions locals middle no in
    let joined = line (line (line (line second (cat ["  br label %", right-out])) (cat [right-out, ":"])) (cat ["  br label %", end])) (cat [end, ":"]) in
    let (ready, result) = fresh joined "%v" in
    (line ready (cat ["  ", result, " = phi i64 [ ", a, ", %", left-out, " ], [ ", b, ", %", right-out, " ]"]), result)
  -- A knot slot is an owned block, irrespective of its stored value's
  -- representation. Closures retain the slot and read it on invocation.
  knot-slot-type :: UType -> UType -> UType
  knot-slot-type region ty = UApp (UApp (UCon "Mut" (KFun KRegion (KFun KType KType))) region) ty

  knot-local :: Nat -> List Local -> Option (UType, String)
  knot-local id locals = case locals of
    Nil -> None
    Cons (KnotLocal key region ty slot) rest -> if id == key then Some (ty, slot) else knot-local id rest
    Cons other rest -> knot-local id rest

  knot-pointer :: Writer -> String -> (Writer, String)
  knot-pointer w slot =
    let (ready, pointer) = fresh w "%ptr" in
    (line ready (cat ["  ", pointer, " = inttoptr i64 ", slot, " to ptr"]), pointer)

  read-index-local :: List Local -> Writer -> Span -> Nat -> UType -> (Writer, String)
  read-index-local locals w sp id carrier = case knot-local id locals of
    Some (declared, slot) -> if runtime-type-equal carrier declared then knot-read w declared slot
      else unsupported w sp "recursive local disagrees with its checked carrier"
    None -> case local id locals of
      Some (declared, value) -> if runtime-type-equal carrier declared then (count-op True declared value w, value)
        else unsupported w sp "runtime index local disagrees with its checked carrier"
      None -> unsupported w sp "runtime index local is absent from its lexical scope"

  knot-read :: Writer -> UType -> String -> (Writer, String)
  knot-read w ty slot = case knot-pointer w slot of
    (pointed, pointer) -> case load-word pointed pointer "0" of
      (loaded, state) ->
        let (one, fault) = fresh loaded "knotfault" in
        let (two, ready) = fresh one "knotready" in
        let (three, predicate) = fresh two "%v" in
        let checked = line three (cat ["  ", predicate, " = icmp eq i64 ", state, ", 1"]) in
        let branched = line checked (cat ["  br i1 ", predicate, ", label %", ready, ", label %", fault]) in
        let refused = line (line (line branched (cat [fault, ":"])) "  call void @cinch_blackhole()") "  unreachable" in
        (case load-word (line refused (cat [ready, ":"])) pointer "1" of
          (done, value) -> (count-op True ty value done, value))

  allocate-knots :: UType -> List Nat -> CoreTerm -> Writer -> (Writer, List Local)
  allocate-knots region slots members w = case members of
    CRecursiveBindingsEnd -> (w, Nil)
    CRecursiveBinding id name value rest -> if not (id-present id slots) then allocate-knots region slots rest w else
      (case call w "@cinch_alloc" ["16", "5"] of
        (allocated, slot) -> case knot-pointer allocated slot of
          (pointed, pointer) -> case allocate-knots region slots rest (store-fields pointed pointer 0 ["0", "0"]) of
            (done, more) -> (done, Cons (KnotLocal id region (core-type value) slot) more))
    other -> (refuse w (Span 0 0 1 1) "malformed recursive value bindings", Nil)

  evaluate-knot-members :: List CoreDefinition -> List Local -> CoreTerm -> CoreTerm -> Writer -> (Writer, String)
  evaluate-knot-members definitions locals members body w = case members of
    CRecursiveBindingsEnd -> expression definitions locals w body
    CRecursiveBinding id name value rest -> case expression definitions locals w value of
      (evaluated, word) -> case knot-local id locals of
        Some (ty, slot) -> case knot-pointer evaluated slot of
          (pointed, pointer) ->
            let filled = store-fields pointed pointer 1 [word] in
            evaluate-knot-members definitions locals rest body (store-fields filled pointer 0 ["1"])
        None ->
          let ty = core-type value in
          if same name "" then evaluate-knot-members definitions locals rest body (count-op False ty word evaluated)
          else (case evaluate-knot-members definitions (Cons (Local id ty word) locals) rest body evaluated of
            (done, result) -> (count-op False ty word done, result))
    other -> unsupported w (Span 0 0 1 1) "malformed recursive value bindings"

  -- Invalidate the slot before dropping its stored value. That value
  -- can own closures which themselves hold references to this slot.
  clear-knots :: List Local -> Writer -> Writer
  clear-knots knots w = case knots of
    Nil -> w
    Cons (KnotLocal id region ty slot) rest -> case knot-pointer w slot of
      (pointed, pointer) -> case load-word pointed pointer "1" of
        (loaded, value) ->
          let cleared = store-fields loaded pointer 0 ["0", "0"] in
          let released = count-op False ty value cleared in
          clear-knots rest (count-op False (knot-slot-type region ty) slot released)
    other -> refuse w (Span 0 0 1 1) "malformed recursive slot cleanup"

  knot-expression :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> CoreTerm -> (Writer, String)
  knot-expression definitions locals w sp region members body = case allocate-knots region (recursive-box-slots members) members w of
    (allocated, knots) -> case evaluate-knot-members definitions (knots <> locals) members body allocated of
      (done, result) -> (clear-knots (reverse knots) done, result)

  primitive :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> String -> CoreTerm -> (Writer, String)
  primitive definitions locals w sp ty op args = case args of
    CArgument at input (CArgumentsEnd end) -> if same op "copy-out" then copy-out-word definitions locals w ty input
      else if same op "memo-demand" then memo-demand definitions locals w sp ty input
      else if same op "borrow" || same op "thunk-delay" then expression definitions locals w input
      else if same op "thunk-force" then (case expression definitions locals w input of
        (ready, closure-word) -> apply-one ready closure-word "0")
      else if same op "mut-borrow" then (case expression definitions locals w input of
        (ready, value) -> let (planned, descriptor) = request-layout sp [input] ready in allocate planned descriptor [value])
      else if same op "negate" && named (core-type input) "Int" then
      (case expression definitions locals w input of
        (ready, value) -> case call ready "@cinch_int_neg" [value] of (done, result) -> (count-op False (core-type input) value done, result))
      else unsupported w sp "unary primitive needs runtime lowering"
    CArgument at first (CArgument bt second (CArgumentsEnd end)) ->
      if same op "par-both" then par-both definitions locals w sp ty first second
      else if same op "par-tabulate" then par-tabulate definitions locals w sp ty first second
      else if same op "par-map" then par-map definitions locals w sp ty first second
      else if same op "#handler-field" then
        (case second of
          CInt offset offset-type slot -> case expression definitions locals w first of
            (ready, frame) -> let (one, pointer) = fresh ready "%ptr" in
              (case load-word (line one (cat ["  ", pointer, " = inttoptr i64 ", frame, " to ptr"])) pointer slot of
                (loaded, field) -> (count-op False (core-type first) frame (count-op True ty field loaded), field))
          other -> unsupported w sp "handler field has no checked slot")
      else if same op "memo-init" then memo-init definitions locals w sp first second
      else if same op "ref-set" then write-borrow-word definitions locals w sp first second
      else if number (core-type first) then binary definitions locals w sp op first second
      else if (same op "==" || same op "/=") && scalar (core-type first) then
        (case expressions definitions locals w [first, second] of
          (ready, [a, b]) -> compare-word ready (if same op "==" then "eq" else "ne") a b
          other -> unsupported w sp "malformed scalar equality arguments")
      else unsupported w sp "primitive carrier needs runtime lowering"
    CArgumentsEnd end -> if same op "decision-true" then (w, "1") else if same op "decision-false" then (w, "0") else unsupported w sp "nullary primitive needs runtime lowering"
    other -> unsupported w sp "primitive arity needs runtime lowering"
  -- Deterministic pure parallelism (design/parallel-evaluation.md sections
  -- 2 and 4.3): the units wrap the runtime's work-stealing entries of
  -- `compiler/runtime/src/par.rs`, or their sequential readings on the
  -- cooperative backend (`cinch_coop_par_*`). The callback closures are
  -- borrowed (the caller drops them after the call) and the runtime
  -- duplicates one reference per invocation, marking at publication.
  -- Every class here is an immediate baked into the body, so the emission
  -- depends only on the checked program, never on a schedule.
  -- The pooled entries. The cooperative (Wasm) backend's sequential
  -- readings exist in the runtime (`cinch_coop_par_*`) but the self-hosted
  -- compiler emits one native profile, so it names the pooled entries; the
  -- artifact profile is the driver's, not this emitter's.
  par-entry :: String -> String
  par-entry base = cat ["@cinch_", base]
  -- The two result words are owned by the caller, and the pair takes the
  -- two component classes' exact pointer map, so no mask and no shaped-join
  -- limit apply (section 4.3).
  par-both :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> CoreTerm -> (Writer, String)
  par-both definitions locals w sp ty f g = case expressions definitions locals w [f, g] of
    (ready, Cons f-word (Cons g-word Nil)) -> case pair-classes (writer-context w) ty of
      None -> unsupported ready sp "parBoth result needs its checked pair representation"
      Some classes ->
        let (one, out) = fresh ready "%out" in
        let (two, out-word) = fresh one "%v" in
        let pointed = line two (cat ["  ", out, " = alloca [2 x i64]"])
        in let addressed = line pointed (cat ["  ", out-word, " = ptrtoint ptr ", out, " to i64"])
        in case call addressed (par-entry "par_both") [f-word, g-word, out-word] of
          (called, _) ->
            -- The callbacks are borrowed: the caller keeps them alive across
            -- the call and drops them afterwards (section 3.3).
            let released = count-op False (core-type f) f-word (count-op False (core-type g) g-word called) in
            case load-word released out "0" of
              (first-loaded, first) -> case load-word first-loaded out "1" of
                (second-loaded, second) -> case request-object-shape sp classes second-loaded of
                  (planned, descriptor) -> allocate planned descriptor [first, second]
    (ready, other) -> unsupported ready sp "parBoth takes exactly two callbacks"
  pair-classes :: RuntimeContext -> UType -> Option (List Nat)
  pair-classes context ty = case ty of
    UTuple fields -> (case spine-types fields of
      Cons first (Cons second Nil) -> class-vector context [first, second]
      other -> None)
    other -> None
  spine-types :: UType -> List UType
  spine-types fields = case fields of UEnd -> Nil; UArg first rest -> Cons first (spine-types rest); other -> Nil
  -- `n` crosses as a length (`cinch_nat_to_len`), and the element class as
  -- the scan code the array constructors take.
  par-tabulate :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> CoreTerm -> (Writer, String)
  par-tabulate definitions locals w sp ty count callback = case expression definitions locals w count of
    (counted, count-word) -> case expression definitions locals counted callback of
      (ready, closure) -> case array-element-class (writer-context w) ty of
        None -> unsupported ready sp "parTabulate result needs its checked element representation"
        Some class ->
          case call ready "@cinch_nat_to_len" [count-word] of
            (converted, length) -> case call converted (par-entry "par_tabulate") [length, closure, nat-to-string class] of
              -- The callback is borrowed and dropped after the call.
              (called, built) -> (count-op False (core-type callback) closure called, built)
  -- `parMap`'s array primitive: the elaboration has already put
  -- `array-from-list` in front and `array-to-list` behind it, so the
  -- runtime never builds list cells.
  par-map :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> CoreTerm -> (Writer, String)
  par-map definitions locals w sp ty callback array = case expressions definitions locals w [callback, array] of
    (ready, Cons closure (Cons input Nil)) -> case array-element-class (writer-context w) ty of
      None -> unsupported ready sp "parMap result needs its checked element representation"
      Some class -> case call ready (par-entry "par_map_array") [closure, input, nat-to-string class] of
        -- Both the callback and the input array are borrowed; the caller
        -- drops them after the call, and owns the result.
        (called, mapped) -> (count-op False (core-type callback) closure (count-op False (core-type array) input called), mapped)
    (ready, other) -> unsupported ready sp "parMap takes a callback and one array"
  -- The element class of an `Array a` result, as the scan code the array
  -- constructors take.
  array-element-class :: RuntimeContext -> UType -> Option Nat
  array-element-class context ty = case ty of
    UApp (UCon name kind) element -> if same name "Array" && kind-equal kind (KFun KType KType) then word-class context element else None
    other -> None
  -- The leading lets hold the group's cells until the continuation exits.
  -- Clear their scanned slot in reverse allocation order, breaking cycles
  -- between unforced closures before dropping the owning cell references.
  memo-scope :: List CoreDefinition -> List Local -> Writer -> CoreTerm -> (Writer, String)
  memo-scope definitions locals w term = case term of
    CLet sp ty id name sc (CPrimitive at cell op (CArgumentsEnd end)) body ->
      if same op "memo-alloc" then
        (case call w "@cinch_alloc" ["24", "4"] of
          (allocated, word) -> case memo-scope definitions (Cons (Local id cell word) locals) allocated body of
            (done, result) -> let (one, pointer) = fresh done "%ptr" in
              let pointed = line one (cat ["  ", pointer, " = inttoptr i64 ", word, " to ptr"]) in
              (case load-word pointed pointer "1" of
                (loaded, owned) -> let cleared = store-fields loaded pointer 1 ["0"] in
                  let released = line cleared (count-call False owned) in
                  (count-op False cell word released, result)))
      else expression definitions locals w term
    other -> expression definitions locals w term
  memo-init :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> CoreTerm -> (Writer, String)
  memo-init definitions locals w sp cell callback = case expressions definitions locals w [cell, callback] of
    (ready, [word, closure]) -> let (one, pointer) = fresh ready "%ptr" in
      let pointed = line one (cat ["  ", pointer, " = inttoptr i64 ", word, " to ptr"]) in
      (count-op False (core-type cell) word (store-fields pointed pointer 1 [closure]), "0")
    other -> unsupported w sp "memo initialization needs a cell and a closure"
  memo-demand :: List CoreDefinition -> List Local -> Writer -> Span -> UType -> CoreTerm -> (Writer, String)
  memo-demand definitions locals w sp result cell = case word-class (writer-context w) result of
    None -> unsupported w sp "memo demand needs a checked result representation"
    Some code -> case expression definitions locals (request-demand MemoWorker w) cell of
      (ready, word) -> case call ready "@cinch.typed.memo.demand" [word, if code == 0 then "0" else "1"] of
        (loaded, value) -> (count-op False (core-type cell) word (count-op True result value loaded), value)
  memo-worker :: Writer -> Writer
  memo-worker w = global w (cat [
    "define internal i64 @cinch.typed.memo.demand(i64 %cell, i64 %counted) {\nentry:\n",
    "  %p = inttoptr i64 %cell to ptr\n  %owned = getelementptr i64, ptr %p, i64 1\n  %cache = getelementptr i64, ptr %p, i64 2\n",
    "  %state = load i64, ptr %p\n  switch i64 %state, label %bad [ i64 0, label %eval i64 2, label %done ]\n",
    "eval:\n  %thunk = load i64, ptr %owned\n  %empty = icmp eq i64 %thunk, 0\n  br i1 %empty, label %bad, label %force\n",
    "force:\n  store i64 1, ptr %p\n  store i64 0, ptr %owned\n  %argv = alloca i64\n  store i64 0, ptr %argv\n",
    "  %value = call i64 @__apply(i64 %thunk, i64 1, ptr %argv)\n",
    "  %tag = and i64 %value, 1\n  %even = icmp eq i64 %tag, 0\n  %heap = icmp ne i64 %counted, 0\n",
    "  %keep = and i1 %heap, %even\n  %child = select i1 %keep, i64 %value, i64 0\n  store i64 %child, ptr %owned\n",
    "  store i64 %value, ptr %cache\n  store i64 2, ptr %p\n  ret i64 %value\n",
    "done:\n  %cached = load i64, ptr %cache\n  ret i64 %cached\n",
    "bad:\n  call void @cinch_blackhole()\n  unreachable\n}\n"])
  copy-out-word :: List CoreDefinition -> List Local -> Writer -> UType -> CoreTerm -> (Writer, String)
  copy-out-word definitions locals w ty input = case mutable-borrow (core-type input) of
    None -> expression definitions locals w input
    Some place -> case expression definitions locals w input of
      (ready, cell) -> let (one, pointer) = fresh ready "%ptr" in
        (case load-word (line one (cat ["  ", pointer, " = inttoptr i64 ", cell, " to ptr"])) pointer "0" of
          (loaded, value) -> (count-op False (core-type input) cell (count-op True ty value loaded), value))
  write-borrow-word :: List CoreDefinition -> List Local -> Writer -> Span -> CoreTerm -> CoreTerm -> (Writer, String)
  write-borrow-word definitions locals w sp cell-term input = case mutable-borrow (core-type cell-term) of
    None -> unsupported w sp "mutable write needs a checked cell carrier"
    Some (region, carrier) -> case expression definitions locals w cell-term of
      (held, cell) -> case expression definitions locals held input of
        (ready, value) -> let (one, pointer) = fresh ready "%ptr" in
          (case load-word (line one (cat ["  ", pointer, " = inttoptr i64 ", cell, " to ptr"])) pointer "0" of
            (loaded, old) -> let replaced = store-fields loaded pointer 0 [value] in
              (count-op False (core-type cell-term) cell (count-op False carrier old replaced), "0"))
  compare-word :: Writer -> String -> String -> String -> (Writer, String)
  compare-word w predicate a b = let (one, flag) = fresh w "%v" in let (two, result) = fresh one "%v" in
    (line (line two (cat ["  ", flag, " = icmp ", predicate, " i64 ", a, ", ", b])) (cat ["  ", result, " = zext i1 ", flag, " to i64"]), result)
  comparison :: String -> Option String
  comparison op = if same op "==" then Some "eq" else if same op "/=" then Some "ne" else if same op "<" then Some "slt" else if same op "<=" then Some "sle" else if same op ">" then Some "sgt" else if same op ">=" then Some "sge" else None
  binary :: List CoreDefinition -> List Local -> Writer -> Span -> String -> CoreTerm -> CoreTerm -> (Writer, String)
  binary definitions locals w sp op first second = case expressions definitions locals w [first, second] of
    (ready, [a, b]) ->
      let ty = core-type first in
      let prefix = cat ["@cinch_", runtime-number ty, "_"] in
      let operation = if same op "+" then Some "add" else if same op "-" then Some "sub" else if same op "*" then Some "mul" else if same op "/" then Some "div" else None in
      let lowered = (case operation of
            Some suffix -> call ready (cat [prefix, suffix]) [a, b]
            None -> case comparison op of
              Some predicate -> case call ready (cat [prefix, "cmp"]) [a, b] of (compared, order) -> compare-word compared predicate order "0"
              None -> unsupported ready sp "numeric primitive needs runtime lowering") in
      case lowered of (done, result) -> (count-op False ty b (count-op False ty a done), result)
    other -> unsupported w sp "malformed numeric arguments"
  parameter-words :: List CorePattern -> Nat -> List String
  parameter-words patterns index = case patterns of
    Nil -> Nil
    Cons first rest -> Cons (cat ["i64 %arg", nat-to-string index]) (parameter-words rest (index + 1))
  parameter-roots :: List CorePattern -> Nat -> List Local
  parameter-roots patterns index = case patterns of
    Nil -> Nil
    Cons first rest -> Cons (Discard (pattern-type first) (cat ["%arg", nat-to-string index])) (parameter-roots rest (index + 1))
  match-parameters :: List CorePattern -> Nat -> String -> Writer -> (Writer, List Local)
  match-parameters patterns index failed w = case patterns of
    Nil -> (w, Nil)
    Cons first rest -> if erased-pattern first then match-parameters rest index failed w else case match-pattern first (cat ["%arg", nat-to-string index]) failed w of
      (matched, bindings) -> case match-parameters rest (index + 1) failed matched of
        (done, more) -> (done, bindings <> more)
  take-parameter-root :: String -> List Local -> Option (List Local)
  take-parameter-root returned roots = case roots of
    Nil -> None
    Cons root rest -> case root of
      Discard ty word | same returned word -> Some rest
      other -> case take-parameter-root returned rest of
        Some remaining -> Some (Cons root remaining)
        None -> None
  projection-return :: List Local -> List Local -> CoreTerm -> Option (String, List Local)
  projection-return locals roots body = case body of
    CForget at ty (CLocal sp original id name Nil) -> (case local id locals of
      Some (declared, word) -> (case take-parameter-root word roots of
        Some remaining -> Some (word, remaining)
        None -> None)
      None -> None)
    other -> None
  worker-result :: List CoreDefinition -> List Local -> List Local -> Writer -> String -> CoreTerm -> (Writer, String)
  worker-result definitions locals roots w failed body = case projection-return locals roots body of
    -- The returning argument already owns a reference. Move that
    -- reference to the result and release the other parameters.
    Some (word, remaining) -> (drop-locals remaining w, word)
    None -> case guarded-expression definitions locals w failed body of
      (done, word) -> (drop-locals roots done, word)
  worker-clauses :: List CoreDefinition -> List Local -> List Local -> Nat -> List CoreClause -> Writer -> Writer
  worker-clauses definitions prefix roots offset clauses w = case clauses of
    Nil -> line w "  unreachable"
    Cons (MkCoreClause sp patterns body) rest ->
      let (one, failed) = fresh w "nexteq" in
      case match-parameters patterns offset failed one of
        (matched, bindings) -> case worker-result definitions (bindings <> prefix) roots matched failed body of
          (done, result) -> let returned = line done (cat ["  ret i64 ", result]) in
            worker-clauses definitions prefix roots offset rest (line returned (cat [failed, ":"]))
  worker :: List CoreDefinition -> List Nat -> Writer -> CoreDefinition -> Writer
  worker definitions classes w d = case d of
    MkCoreDefinition sp name sc openings givens private clauses -> case class-bindings (scheme-params sc) classes of
      None -> refuse w sp "definition needs first-order runtime representation specialization"
      Some bounds -> case definition-rigids d bounds of
        None -> refuse w sp "definition runtime representation openings are invalid"
        Some rigids -> let scoped = with-representations bounds rigids w in
          if not (scheme-supported (writer-context scoped) sc) then refuse scoped sp (cat ["definition needs dictionary or unsupported runtime lowering: ", name])
          else case clauses of
            Cons (MkCoreClause at patterns body) rest ->
              let context = runtime-givens scoped d in
              let dependencies = definition-value-dependencies scoped d in
              let hidden = list-length dependencies in
              let index-offset = hidden + list-length context in
              let indices = opening-value-types openings in
              let offset = index-offset + list-length indices in
              let prefix = worker-self-values scoped d dependencies <> given-bindings context hidden <> runtime-index-locals indices index-offset <> self-binding scoped d classes in
              let parameters = runtime-parameters patterns in
              let roots = capture-roots (value-field-types dependencies) 0 <> given-roots context hidden <> runtime-index-locals indices index-offset <> parameter-roots parameters offset in
              let types = value-field-types dependencies <> given-types context <> value-types indices <> pattern-types parameters in
              case hash-map-lookup name (program-tail-groups (writer-program scoped)) of
                Some (group, width) -> global-tail-worker definitions d classes prefix roots scoped group width (list-length parameters)
                None -> proof-worker-stages definitions classes d prefix roots offset types (proof-stage-arities patterns offset) 0 scoped
            Nil -> refuse scoped sp "runtime definition has no checked equations"
  proof-worker-stages :: List CoreDefinition -> List Nat -> CoreDefinition -> List Local -> List Local -> Nat -> List UType -> List Nat -> Nat -> Writer -> Writer
  proof-worker-stages definitions classes d prefix roots offset types arities rung w = case arities of
    Nil -> refuse w (Span 0 0 1 1) "runtime function has no checked proof stage"
    Cons count rest ->
      let name = proof-stage-name (specialized-name (core-name d) classes) rung in
      let started = line (line w (cat ["define ", worker-linkage w name, "i64 ", symbol name, "(", join (argument-words (value-parameters count 0)), ") {"])) "entry:" in
      (case rest of
        Nil -> line (worker-clauses definitions prefix roots offset (core-clauses d) started) "}"
        Cons next-count more -> case class-vector (writer-context started) (take-types next-count types) of
          None -> refuse started (Span 0 0 1 1) "proof continuation needs checked runtime parameter representations"
          Some next-classes -> case closure (Span 0 0 1 1) (proof-stage-name (specialized-name (core-name d) classes) (rung + 1)) next-classes (value-parameters count 0) started of
            (ready, result) -> let returned = line (line ready (cat ["  ret i64 ", result])) "}" in
              proof-worker-stages definitions classes d prefix roots offset types rest (rung + 1) returned)
  value-parameters :: Nat -> Nat -> List String
  value-parameters count index = if count == 0 then Nil else Cons (cat ["%arg", nat-to-string index]) (value-parameters (count - 1) (index + 1))
  constructor-worker :: String -> List Nat -> Writer -> Writer
  constructor-worker name classes w = case constructor name (writer-data w) of
    Some (owner, tag, c) -> case data-declaration owner (writer-data w) of
      Some d -> case constructor-context d classes w of
        Some context -> case context of
          RuntimeContext datas bounds rigids pending done inlining ->
            let scoped = with-representations bounds rigids w in
            case request-data (Span 0 0 1 1) d classes scoped of
              (planned, descriptor) ->
                let count = list-length (core-constructor-fields c) in
                let values = value-parameters count 0 in
                let started = line (line planned (cat ["define ", worker-linkage planned (specialized-name name classes), "i64 ", symbol (specialized-name name classes), "(", join (argument-words values), ") {"])) "entry:" in
                case allocate started (data-descriptor d descriptor tag) values of
                  (allocated, result) -> line (line allocated (cat ["  ret i64 ", result])) "}"
        None -> refuse w (Span 0 0 1 1) "constructor worker needs representation specialization"
      None -> refuse w (Span 0 0 1 1) "constructor worker has no defining data"
    None -> refuse w (Span 0 0 1 1) "constructor worker has no checked constructor"
  lambda-worker :: List CoreDefinition -> String -> List (Nat, Nat) -> List (Nat, Nat) -> List Local -> CorePattern -> CoreTerm -> Writer -> Writer
  lambda-worker definitions name bounds rigids saved parameter body w =
    let scoped = with-representations bounds rigids w in
    if not (word-type (writer-context scoped) (core-type body)) then refuse scoped (Span 0 0 1 1) "lambda result needs a checked runtime representation" else
      let types = capture-types saved in
      let offset = list-length types in
      if erased-pattern parameter then
        let started = line (line scoped (cat ["define ", worker-linkage w name, "i64 ", symbol name, "(", join (argument-words (value-parameters offset 0)), ") {"])) "entry:" in
        (case expression definitions (captured-bindings saved 0) started body of
          (done, result) -> line (line (drop-locals (capture-roots types 0) done) (cat ["  ret i64 ", result])) "}")
      else
        let roots = capture-roots types 0 <> parameter-roots [parameter] offset in
        let started = line (line scoped (cat ["define ", worker-linkage w name, "i64 ", symbol name, "(", join (argument-words (value-parameters (offset + 1) 0)), ") {"])) "entry:" in
        line (worker-clauses definitions (captured-bindings saved 0) roots offset [MkCoreClause (Span 0 0 1 1) [parameter] body] started) "}"
  recursive-width :: List RecursiveWorker -> Nat
  recursive-width group = case group of
    Nil -> 0
    Cons (RecursiveWorker id ty name patterns body) rest ->
      let arity = list-length (runtime-parameters patterns) in
      let remaining = recursive-width rest in
      if arity > remaining then arity else remaining

  tail-worker-name :: String -> String
  tail-worker-name name = cat [name, "#tail"]

  padding-words :: Nat -> List String
  padding-words count = if count == 0 then Nil else Cons "0" (padding-words (count - 1))

  recursive-target :: List RecursiveWorker -> Nat -> Nat -> Option String
  recursive-target group id arity = case group of
    Nil -> None
    Cons (RecursiveWorker member ty name patterns body) rest -> if member == id then
      (if arity == list-length (runtime-parameters patterns) then Some (tail-worker-name name) else None)
      else recursive-target rest id arity

  recursive-call :: List RecursiveWorker -> CoreTerm -> Option (String, List CoreTerm)
  recursive-call group term = case term of
    CErasedApply sp ty row (CLocal at function id name Nil) witness -> case recursive-target group id 0 of
      Some callee -> Some (callee, Nil)
      None -> None
    other -> case head term of
      CLocal at function id name Nil -> case arguments term Nil of
        Nil -> None
        args -> case recursive-target group id (list-length args) of
          Some callee -> Some (callee, args)
          None -> None
      other -> None

  -- A direct call transfers its new arguments and captures before it
  -- releases this frame's roots. LLVM requires the following ret.
  transfer-tail-call :: List CoreDefinition -> List Local -> List Local -> List Local -> Nat -> Writer -> String -> List CoreTerm -> Writer
  transfer-tail-call definitions locals roots saved width w callee args = case expressions definitions locals w args of
    (evaluated, values) -> case capture-values saved evaluated of
      (copied, captures) ->
        let count = list-length values in
        if count <= width then
          let passed = captures <> values <> padding-words (width - count) in
          let (ready, result) = fresh (drop-locals roots copied) "%v" in
          line (line ready (cat ["  ", result, " = musttail call i64 ", symbol callee, "(", join (argument-words passed), ")"])) (cat ["  ret i64 ", result])
        else refuse copied (Span 0 0 1 1) "tail call exceeds its checked worker width"

  -- Only source workers in the same direct tail cycle share a prototype.
  -- A call that crosses an object boundary keeps the checked public ABI.
  global-tail-call :: List CoreDefinition -> Nat -> Writer -> CoreTerm -> Option (String, List Nat, List CoreTerm)
  global-tail-call definitions group w term = case head term of
    CUse sp ty name role actuals -> case hash-map-lookup name (program-tail-groups (writer-program w)) of
      Some (callee, width) -> if callee == group then
        (case definition name definitions of
          Some d -> let args = arguments term Nil in
            if list-length args == list-length (definition-parameters d) then
              (case source-scheme-classes (writer-context w) (scheme-params (core-scheme d)) actuals of
                Some classes -> Some (name, classes, args)
                None -> None)
            else None
          None -> None)
        else None
      None -> None
    other -> None

  tail-result :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> String -> CoreTerm -> Writer
  tail-result definitions locals roots context w failed term = case term of
    CIf sp ty test yes no -> case expression definitions locals w test of
      (tested, condition) ->
        let (one, otherwise) = fresh tested "tailno" in
        let selected = continue-if one condition otherwise in
        let first = tail-result definitions locals roots context selected failed yes in
        tail-result definitions locals roots context (line first (cat [otherwise, ":"])) failed no
    CCase sp ty value alternatives -> case expression definitions locals w value of
      (ready, word) -> tail-rows definitions locals roots context ready (core-type value) word alternatives
    CGuard sp ty condition body -> if core-alternative-covers term then
      tail-result definitions locals roots context w failed body
      else (case expression definitions locals w condition of
        (ready, value) -> tail-result definitions locals roots context (continue-if ready value failed) failed body)
    CLet sp ty id name sc rhs body -> case scheme-params sc of
      Nil -> if scheme-supported (writer-context w) sc && word-type (writer-context w) (scheme-body sc) then
        (case expression definitions locals w rhs of
          (ready, value) ->
            let bound = Local id (scheme-body sc) value in
            tail-binding definitions locals roots context ready failed bound (scheme-body sc) value body)
        else tail-return definitions locals roots w failed term
      other -> if local-function-value rhs && (case scheme-requirements sc of Nil -> True; other -> False) then
        tail-result definitions locals roots context w failed (specialize-local id sc rhs body)
        else tail-return definitions locals roots w failed term
    CWith sp ty given value body -> case expression definitions locals w value of
      (ready, word) ->
        let bound = GivenLocal (given-symbol given) (given-type given) word in
        tail-binding definitions locals roots context ready failed bound (given-type given) word body
    CRequire sp ty body -> tail-result definitions locals roots context w failed body
    CProved sp ty evidence body -> tail-result definitions locals roots context w failed body
    CRefine sp ty evidence body -> tail-result definitions locals roots context w failed body
    CRefineProof sp ty witness body -> tail-result definitions locals roots context w failed body
    CDischarge sp ty evidence body -> tail-result definitions locals roots context w failed body
    CForget sp ty body -> case projection-return locals roots term of
      Some (word, remaining) -> line (drop-locals remaining w) (cat ["  ret i64 ", word])
      None -> tail-result definitions locals roots context w failed body
    other -> case context of
      LocalTail group saved width -> case recursive-call group term of
        Some (callee, args) -> transfer-tail-call definitions locals roots saved width w callee args
        None -> tail-return definitions locals roots w failed term
      GlobalTail group width -> case global-tail-call definitions group w term of
        Some (name, classes, args) ->
          transfer-tail-call definitions locals roots Nil width (demand-worker name classes w) (tail-worker-name (specialized-name name classes)) args
        None -> tail-return definitions locals roots w failed term

  tail-return :: List CoreDefinition -> List Local -> List Local -> Writer -> String -> CoreTerm -> Writer
  tail-return definitions locals roots w failed body = case worker-result definitions locals roots w failed body of
    (done, word) -> line done (cat ["  ret i64 ", word])

  tail-binding :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> String -> Local -> UType -> String -> CoreTerm -> Writer
  tail-binding definitions locals roots context w failed bound ty word body =
    let scoped = Cons bound locals in
    let owned = Cons (Discard ty word) roots in
    let (one, cleanup) = fresh w "tailcleanup" in
    let emitted = tail-result definitions scoped owned context one cleanup body in
    let released = count-op False ty word (line emitted (cat [cleanup, ":"])) in
    line released (cat ["  br label %", failed])

  tail-rows :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> CoreTerm -> Writer
  tail-rows definitions locals roots context w ty value alternatives =
    let (one, base) = fresh w "alt" in
    case case-dispatch one alternatives base of
      HeaderDispatch entries -> tail-switch definitions locals roots context one ty value True base entries alternatives
      ImmediateDispatch entries -> tail-switch definitions locals roots context one ty value False base entries alternatives
      ChainDispatch -> tail-chain definitions locals roots context one ty value alternatives
  -- The tail case dispatches once too: an arm returns from its own block, so
  -- an unmatched tag reaches the default arm, or no continuation at all.
  tail-switch :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> Bool -> String -> String -> CoreTerm -> Writer
  tail-switch definitions locals roots context w ty value header base entries alternatives =
    let (one, missed) = fresh w "tailmiss" in
    if header then (case constructor-tag w value of
      (loaded, tag) -> tail-switch-arms definitions locals roots context (line loaded (cat ["  switch i64 ", tag, ", label %", missed, " [", entries, "\n]"])) ty value base missed alternatives 0 False)
    else tail-switch-arms definitions locals roots context (line w (cat ["  switch i64 ", value, ", label %", missed, " [", entries, "\n]"])) ty value base missed alternatives 0 False
  tail-switch-arms :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> String -> String -> CoreTerm -> Nat -> Bool -> Writer
  tail-switch-arms definitions locals roots context w ty value base missed alternatives index defaulted = case alternatives of
    CAlternativesEnd sp -> if defaulted then w
      else line (line w (cat [missed, ":"])) "  unreachable"
    CAlternative sp pattern body rest -> case pattern of
      CPVar at pty id name -> tail-switch-default definitions (Cons (Borrowed id pty value) locals) roots context w ty value base missed body rest
      CPWild at pty -> tail-switch-default definitions locals roots context w ty value base missed body rest
      other -> case arm-plan w pattern of
        TagArm tag -> tail-switch-tag definitions locals roots context w ty value base missed pattern body rest index
        WordArm tag -> tail-switch-word definitions locals roots context w ty value base missed body rest index
        NoArm -> line (refuse w sp "case alternative disagrees with the dispatch it was chosen for") "  unreachable"
    other -> line (refuse w (Span 0 0 1 1) "malformed case alternative spine") "  unreachable"
  tail-switch-default :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> String -> String -> CoreTerm -> CoreTerm -> Writer
  tail-switch-default definitions locals roots context w ty value base missed body rest =
    let owned = Cons (Discard ty value) roots in
    tail-switch-arms definitions locals roots context
      (tail-result definitions locals owned context (line w (cat [missed, ":"])) missed body) ty value base missed rest 0 True
  tail-switch-tag :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> String -> String -> CorePattern -> CoreTerm -> CoreTerm -> Nat -> Writer
  tail-switch-tag definitions locals roots context w ty value base missed pattern body rest index = case pattern of
    CPConstructor sp aty name actuals sc fields ->
      let entry = line w (cat [base, ".", nat-to-string index, ":"]) in
      let (pointed, pointer) = fresh entry "%ptr" in
      let cell = line pointed (cat ["  ", pointer, " = inttoptr i64 ", value, " to ptr"]) in
      case match-fields fields pointer 0 missed cell of
        (bound, bindings) -> let owned = Cons (Discard ty value) roots in
          tail-switch-arms definitions (bindings <> locals) roots context (tail-result definitions (bindings <> locals) owned context bound missed body) ty value base missed rest (index + 1) False
    other -> line (refuse w (Span 0 0 1 1) "dispatched arm is not a constructor pattern") "  unreachable"
  tail-switch-word :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> String -> String -> CoreTerm -> CoreTerm -> Nat -> Writer
  tail-switch-word definitions locals roots context w ty value base missed body rest index =
    let owned = Cons (Discard ty value) roots in
    tail-switch-arms definitions locals roots context
      (tail-result definitions locals owned context (line w (cat [base, ".", nat-to-string index, ":"])) missed body) ty value base missed rest (index + 1) False
  tail-chain :: List CoreDefinition -> List Local -> List Local -> TailContext -> Writer -> UType -> String -> CoreTerm -> Writer
  tail-chain definitions locals roots context w ty value alternatives = case alternatives of
    CAlternativesEnd end -> line w "  unreachable"
    CAlternative sp pattern body rest ->
      let (one, failed) = fresh w "nexttailalt" in
      case match-pattern pattern value failed one of
        (matched, bindings) ->
          let owned = Cons (Discard ty value) roots in
          let done = tail-result definitions (bindings <> locals) owned context matched failed body in
          tail-chain definitions locals roots context (line done (cat [failed, ":"])) ty value rest
    other -> line (refuse w (Span 0 0 1 1) "malformed case alternative spine") "  unreachable"

  start-tail-worker :: String -> Nat -> Nat -> Writer -> Writer
  start-tail-worker name arity width w =
    if arity <= width then
      let entry = value-parameters arity 0 in
      let callee = tail-worker-name name in
      let widened = value-parameters width 0 in
      let wrapper = line (line w (cat ["define ", worker-linkage w name, "i64 ", symbol name, "(", join (argument-words entry), ") {"])) "entry:" in
      case call wrapper (symbol callee) (entry <> padding-words (width - arity)) of
        (called, result) ->
          let wrapped = line (line called (cat ["  ret i64 ", result])) "}" in
          line (line wrapped (cat ["define private i64 ", symbol callee, "(", join (argument-words widened), ") {"])) "entry:"
    else refuse w (Span 0 0 1 1) "tail wrapper exceeds its checked worker width"

  global-tail-clauses :: List CoreDefinition -> List Local -> List Local -> TailContext -> List CoreClause -> Writer -> Writer
  global-tail-clauses definitions prefix roots context clauses w = case clauses of
    Nil -> line w "  unreachable"
    Cons (MkCoreClause sp patterns body) rest ->
      let (one, failed) = fresh w "nexttaileq" in
      case match-parameters patterns 0 failed one of
        (matched, bindings) ->
          let returned = tail-result definitions (bindings <> prefix) roots context matched failed body in
          global-tail-clauses definitions prefix roots context rest (line returned (cat [failed, ":"]))

  global-tail-worker :: List CoreDefinition -> CoreDefinition -> List Nat -> List Local -> List Local -> Writer -> Nat -> Nat -> Nat -> Writer
  global-tail-worker definitions d classes prefix roots w group width arity =
    let started = start-tail-worker (specialized-name (core-name d) classes) arity width w in
    line (global-tail-clauses definitions prefix roots (GlobalTail group width) (core-clauses d) started) "}"

  recursive-worker :: List CoreDefinition -> RecursiveWorker -> List RecursiveWorker -> List (Nat, Nat) -> List (Nat, Nat) -> List Local -> Writer -> Writer
  recursive-worker definitions member group bounds rigids saved w = case member of
    RecursiveWorker id ty name patterns body ->
      let sp = Span 0 0 1 1 in
      let scoped = with-representations bounds rigids w in
      let captures = capture-types saved in
      let offset = list-length captures in
      let parameters = runtime-parameters patterns in
      let arity = list-length parameters in
      let width = recursive-width group in
      let prefix = captured-bindings saved 0 in
      if not (word-type (writer-context scoped) (core-type body)) then refuse scoped sp "recursive worker result needs a runtime representation" else
        let (started, failed) = fresh (start-tail-worker name (offset + arity) (offset + width) scoped) "tailmiss" in
        (case match-parameters patterns offset failed started of
          (matched, bindings) -> case recursive-locals sp captures prefix group body matched of
            (ready, siblings) ->
              let roots = capture-roots captures 0 <> parameter-roots parameters offset <> siblings in
              let done = tail-result definitions (bindings <> siblings <> prefix) roots (LocalTail group prefix width) ready failed body in
              line (line (line done (cat [failed, ":"])) "  unreachable") "}")
  workers :: List CoreDefinition -> Writer -> Writer
  workers definitions w = case w of
    Writer next globals code errors layouts (RuntimeContext datas bounds rigids pending done inlining) -> case pending of
      Nil -> w
      Cons demand rest ->
        let claimed = Writer next globals code errors layouts (RuntimeContext datas Nil Nil rest (Cons demand done) inlining) in
        case demand of
          Demand name classes -> case definition name definitions of
            Some d -> workers definitions (worker definitions classes claimed d)
            None -> workers definitions (refuse claimed (Span 0 0 1 1) "demanded runtime definition is absent")
          ConstructorDemand name classes -> workers definitions (constructor-worker name classes claimed)
          LambdaDemand name saved-bound saved-rigid saved parameter body -> workers definitions (lambda-worker definitions name saved-bound saved-rigid saved parameter body claimed)
          RecursiveDemand member group saved-bound saved-rigid saved -> workers definitions (recursive-worker definitions member group saved-bound saved-rigid saved claimed)
          StubDemand name classes -> workers definitions (app-stub name classes claimed)
          DictionaryDemand name classes -> workers definitions (dictionary-worker definitions name classes claimed)
          ArrayDemand name classes -> workers definitions (array-worker name classes claimed)
          BuiltinDemand name -> workers definitions (builtin-worker name claimed)
          MemoWorker -> workers definitions (memo-worker claimed)
          ExternalDemand unit -> workers definitions (external-worker unit claimed)
          ForeignDemand plan -> workers definitions (foreign-worker plan claimed)
          PrimitiveIntrinsicDemand symbol -> workers definitions (primitive-intrinsic-worker symbol claimed)
  declarations :: String
  declarations = declarations-counting False
  -- The four pooled parallel entries (runtime ABI 8). They are declared
  -- only when the program contains a parallel primitive, so a program that
  -- uses none emits the same IR bytes as before the builtins existed
  -- (design/parallel-evaluation.md section 4.2).
  par-declarations :: String
  par-declarations = "declare i64 @cinch_par_both(i64, i64, i64)\ndeclare i64 @cinch_par_tabulate(i64, i64, i64)\ndeclare i64 @cinch_par_map_array(i64, i64, i64)\ndeclare i64 @cinch_par_set_workers(i64)\n"
  par-used :: List CoreDefinition -> Bool
  par-used definitions = case definitions of
    Nil -> False
    Cons d rest -> definition-par-used d || par-used rest
  definition-par-used :: CoreDefinition -> Bool
  definition-par-used d = case core-clauses d of
    Nil -> False
    Cons (MkCoreClause sp patterns body) rest -> term-par-used body || definition-par-used (MkCoreDefinition sp (core-name d) (core-scheme d) (core-openings d) (core-givens d) Nil rest)
  term-par-used :: CoreTerm -> Bool
  term-par-used term = case term of
    CPrimitive sp ty op args -> par-operation op || children-par-used (term-children term)
    CLambda sp ty p body -> term-par-used body
    other -> children-par-used (runtime-term-children term)
  children-par-used :: List CoreTerm -> Bool
  children-par-used terms = case terms of Nil -> False; Cons first rest -> term-par-used first || children-par-used rest
  par-operation :: String -> Bool
  par-operation op = same op "par-both" || same op "par-tabulate" || same op "par-map"
  par-preamble :: List CoreDefinition -> String
  par-preamble definitions = if par-used definitions then par-declarations else ""
  -- The module prelude. Debug counting swaps only the two count helpers,
  -- so every other declaration and every call site is the same bytes.
  declarations-counting :: Bool -> String
  declarations-counting debug = cat [
    "declare i64 @cinch_alloc(i64, i64)\ndeclare void @cinch_blackhole() noreturn\n",
    "declare void @llvm.trap()\ndeclare ptr @cinch_alloc_ctor(i64, i64)\ndeclare ptr @cinch_alloc_shaped(i64, i64, i64)\ndeclare ptr @memcpy(ptr, ptr, i64)\ndeclare void @cinch_layouts_register(ptr, i64)\n",
    "declare void @cinch_dup_mt(i64)\ndeclare void @cinch_drop_mt(i64)\ndeclare void @cinch_drop_slow(i64)\ndeclare void @cinch_reclaim_enable()\ndeclare i64 @cinch_exit_check(i64)\n",
    if debug then debug-count-helpers else count-helpers,
    "declare i64 @cinch_nat_to_len(i64)\ndeclare i64 @cinch_nat_from_i64(i64)\ndeclare i64 @cinch_int_from_nat(i64)\ndeclare i64 @cinch_bytes_new(i64)\ndeclare i64 @cinch_bytes_len(i64)\ndeclare i64 @cinch_bytes_get(i64, i64)\ndeclare i64 @cinch_bytes_from_data(ptr, i64)\ndeclare i64 @cinch_bytes_compare(i64, i64)\ndeclare i64 @cinch_io_write(i64)\ndeclare i64 @cinch_io_sleep(i64)\ndeclare i64 @cinch_task_poll_cancel()\ndeclare i64 @cinch_scope_open()\ndeclare i64 @cinch_scope_close(i64)\ndeclare i64 @cinch_task_spawn(i64, i64)\ndeclare i64 @cinch_task_join_all_or_cancel(i64, i64, i64, i64)\n",
    "declare i64 @cinch_array_from_list(i64, i64)\ndeclare i64 @cinch_array_replicate(i64, i64, i64)\ndeclare i64 @cinch_array_len(i64)\ndeclare i64 @cinch_array_has(i64, i64)\ndeclare i64 @cinch_array_get(i64, i64)\ndeclare i64 @cinch_array_set(i64, i64, i64)\ndeclare i64 @cinch_array_slice(i64, i64, i64)\ndeclare i64 @cinch_array_append(i64, i64)\ndeclare i64 @cinch_tensor_reshape(i64, i64)\ndeclare i64 @cinch_tensor_shape(i64)\ndeclare i64 @cinch_tensor_data(i64)\ndeclare i64 @cinch_tensor_index(i64, i64)\ndeclare i64 @cinch_tensor_get(i64, i64)\ndeclare i64 @cinch_tensor_set(i64, i64, i64)\ndeclare i64 @cinch_columnar_column(i64)\ndeclare i64 @cinch_columnar_zip(i64, i64, i64)\ndeclare i64 @cinch_columnar_rows(i64)\ndeclare i64 @cinch_columnar_columns(i64)\ndeclare i64 @cinch_columnar_get(i64, i64)\ndeclare i64 @cinch_columnar_child(i64, i64)\ndeclare i64 @cinch_columnar_array(i64)\n",
    "declare i64 @cinch_text_f64_to_decimal(double)\ndeclare double @cinch_text_f64_from_decimal(i64)\n",
    "declare i64 @cinch_io_read(i64)\ndeclare i64 @cinch_text_sha256(i64)\ndeclare i64 @cinch_text_sha512(i64)\ndeclare i64 @cinch_text_sha1(i64)\ndeclare i64 @cinch_text_md5(i64)\ndeclare i64 @cinch_text_hmac_sha256(i64, i64)\n",
    "declare i64 @cinch_random_bytes(i64)\ndeclare i64 @cinch_fs_mkdir(i64, i64)\ndeclare i64 @cinch_fs_remove(i64, i64)\ndeclare i64 @cinch_fs_temp_dir()\ndeclare i64 @cinch_signal_send(i64, i64)\ndeclare i64 @cinch_arena_new(i64)\ndeclare i64 @cinch_arena_leave(i64)\ndeclare i64 @cinch_argv_count()\n",
    "declare i64 @cinch_net_tcp_connect(i64, i64)\ndeclare i64 @cinch_net_read(i64, i64)\ndeclare i64 @cinch_net_write(i64, i64)\ndeclare i64 @cinch_net_close(i64)\ndeclare i64 @cinch_net_resolve(i64, i64)\n",
    "declare i64 @cinch_process_spawn(i64, i64, i64, i64)\ndeclare i64 @cinch_process_write_stdin(i64, i64)\ndeclare i64 @cinch_process_close_stdin(i64)\ndeclare i64 @cinch_process_read(i64, i64, i64)\ndeclare i64 @cinch_process_wait(i64)\ndeclare i64 @cinch_process_close(i64)\n",
    "declare i64 @cinch_pty_open()\ndeclare i64 @cinch_pty_spawn(i64, i64, i64, i64, i64)\ndeclare i64 @cinch_pty_read(i64, i64)\ndeclare i64 @cinch_pty_write(i64, i64)\ndeclare i64 @cinch_pty_wait(i64)\ndeclare i64 @cinch_pty_close(i64)\ndeclare i64 @cinch_pty_resize(i64, i64, i64)\n",
    "declare i64 @cinch_argv_init(i64, ptr)\ndeclare i64 @cinch_run_main(ptr)\n",
    "declare i64 @cinch_int_from_decimal(ptr, i64)\ndeclare i64 @cinch_nat_from_decimal(ptr, i64)\ndeclare i64 @cinch_int_to_i64(i64)\n",
    "declare i64 @cinch_int_add(i64, i64)\ndeclare i64 @cinch_int_sub(i64, i64)\ndeclare i64 @cinch_int_mul(i64, i64)\ndeclare i64 @cinch_int_div(i64, i64)\ndeclare i64 @cinch_int_neg(i64)\ndeclare i64 @cinch_int_cmp(i64, i64)\n",
    "declare i64 @cinch_nat_add(i64, i64)\ndeclare i64 @cinch_nat_sub(i64, i64)\ndeclare i64 @cinch_nat_mul(i64, i64)\ndeclare i64 @cinch_nat_div(i64, i64)\ndeclare i64 @cinch_nat_cmp(i64, i64)\n"]
  -- The inline count operations of compiler/src/codegen.rs (rc_op), as two
  -- alwaysinline helpers. A word that is 0 or odd (an immediate) owns no
  -- block. Otherwise the header at -8 holds the signed count in its low
  -- 40 bits; shifted left by 24 it compares as the count itself: positive
  -- is a count only this thread changes, updated in place; negative is a
  -- block shared with other tasks (the runtime's atomic paths); 0 is an
  -- immortal block, never written. A drop of the last reference calls
  -- cinch_drop_slow, which releases the block.
  count-helpers :: String
  count-helpers = cat [
    "define internal void @cinch.typed.rc.dup(i64 %w) alwaysinline {\nentry:\n",
    "  %lo = and i64 %w, 1\n  %null = icmp eq i64 %w, 0\n  %imm = icmp ne i64 %lo, 0\n  %skip = or i1 %null, %imm\n  br i1 %skip, label %done, label %block\nblock:\n",
    "  %p = inttoptr i64 %w to ptr\n  %hp = getelementptr inbounds i8, ptr %p, i64 -8\n  %h = load atomic i64, ptr %hp monotonic, align 8\n  %top = shl i64 %h, 24\n",
    "  %plain = icmp sgt i64 %top, 0\n  br i1 %plain, label %inc, label %other\ninc:\n  %h1 = add i64 %h, 1\n  store i64 %h1, ptr %hp\n  br label %done\n",
    "other:\n  %shared = icmp ne i64 %top, 0\n  br i1 %shared, label %mt, label %done\nmt:\n  call void @cinch_dup_mt(i64 %w)\n  br label %done\ndone:\n  ret void\n}\n",
    "define internal void @cinch.typed.rc.drop(i64 %w) alwaysinline {\nentry:\n",
    "  %lo = and i64 %w, 1\n  %null = icmp eq i64 %w, 0\n  %imm = icmp ne i64 %lo, 0\n  %skip = or i1 %null, %imm\n  br i1 %skip, label %done, label %block\nblock:\n",
    "  %p = inttoptr i64 %w to ptr\n  %hp = getelementptr inbounds i8, ptr %p, i64 -8\n  %h = load atomic i64, ptr %hp monotonic, align 8\n  %top = shl i64 %h, 24\n",
    "  %plain = icmp sgt i64 %top, 16777216\n  br i1 %plain, label %dec, label %other\ndec:\n  %h1 = sub i64 %h, 1\n  store i64 %h1, ptr %hp\n  br label %done\n",
    "other:\n  switch i64 %top, label %mt [\n    i64 0, label %done\n    i64 16777216, label %slow\n  ]\n",
    "slow:\n  call void @cinch_drop_slow(i64 %w)\n  br label %done\nmt:\n  call void @cinch_drop_mt(i64 %w)\n  br label %done\ndone:\n  ret void\n}\n"]
  -- The reference count debugging build (TargetProfile::rc_debug in
  -- compiler/src/core.rs): both helpers call the runtime's out-of-line
  -- cinch_dup and cinch_drop, so CINCH_RC_DEBUG=1 checks every count
  -- operation this module performs against a live header. The helpers are
  -- the only count operations the module emits, so no inline path stays.
  debug-count-helpers :: String
  debug-count-helpers = cat [
    "declare void @cinch_dup(i64)\ndeclare void @cinch_drop(i64)\n",
    "define internal void @cinch.typed.rc.dup(i64 %w) {\nentry:\n  call void @cinch_dup(i64 %w)\n  ret void\n}\n",
    "define internal void @cinch.typed.rc.drop(i64 %w) {\nentry:\n  call void @cinch_drop(i64 %w)\n  ret void\n}\n"]
  apply-entry :: String
  apply-entry = apply-entry-with-linkage ""
  apply-entry-with-linkage :: String -> String
  apply-entry-with-linkage linkage = cat ["define ", linkage, "i64 @__apply(i64 %closure, i64 %argc, ptr %argv) {\nentry:\n",
    "  %self = inttoptr i64 %closure to ptr\n  %code = load i64, ptr %self\n  %function = inttoptr i64 %code to ptr\n",
    "  %result = call i64 %function(ptr %self, i64 %argc, ptr %argv)\n  ret i64 %result\n}\n"]
  entry :: Nat -> String
  entry mode =
    let invocation = (if mode == 0 then cat ["  %result = call i64 ", symbol "main", "()\n"]
      else if mode == 1 then cat ["  %result = call i64 ", symbol "main", "(i64 0)\n"]
      else if mode == 3 then cat ["  %function = call i64 ", symbol "main", "()\n  %result = call i64 @__apply(i64 %function, i64 0, ptr null)\n"]
      else cat ["  %function = call i64 ", symbol "main", "()\n  %argv = alloca i64\n  store i64 0, ptr %argv\n  %result = call i64 @__apply(i64 %function, i64 1, ptr %argv)\n"]) in
    cat ["define i64 @cinch.typed.exit() {\nentry:\n", invocation,
    "  %exit = call i64 @cinch_int_to_i64(i64 %result)\n  call void @cinch.typed.rc.drop(i64 %result)\n  ret i64 %exit\n}\n",
    "define i32 @main(i32 %argc, ptr %argv) {\nentry:\n  call void @cinch_reclaim_enable()\n  %count = sext i32 %argc to i64\n  call i64 @cinch_argv_init(i64 %count, ptr %argv)\n",
    "  %exit = call i64 @cinch_run_main(ptr @cinch.typed.exit)\n  %checked = call i64 @cinch_exit_check(i64 %exit)\n  %code = trunc i64 %checked to i32\n  ret i32 %code\n}\n"]
  entry-parameters :: List Quant -> Bool
  entry-parameters qs = case qs of Nil -> True; Cons q rest -> erased-kind (quant-kind q) && entry-parameters rest
  entry-mode :: CoreDefinition -> Option Nat
  entry-mode d = if not (entry-parameters (scheme-params (core-scheme d))) || list-length (core-givens d) > 0 then None else
    if named (scheme-body (core-scheme d)) "Int" && list-length (definition-parameters d) == 0 then Some 0 else
      let function = base (scheme-body (core-scheme d)) in
      let ty = arrow-shape function in
      let valid = (case ty of
        UFun domain result -> named domain "Unit" && named result "Int"
        UFunEff domain row result -> named domain "Unit" && named result "Int"
        UPi id name domain row result -> named domain "Unit" && named result "Int"
        other -> False) in
      if not valid then None else if erased-value-arrow function then Some 3
      else if list-length (definition-parameters d) == 1 then Some 1 else if list-length (definition-parameters d) == 0 then Some 2 else None
  check-runtime-entry :: CheckedProgram -> Result (List Diagnostic) CheckedProgram
  check-runtime-entry checked = case definition "main" (elaboration-core (checked-elaboration checked)) of
    None -> Ok checked
    Some d -> case entry-mode d of
      Some mode -> Ok checked
      None -> case d of
        MkCoreDefinition sp name scheme openings givens private clauses ->
          Err [MkDiagnostic "bootstrap.check" sp "main must have type Int or Unit ->{e} Int, without external evidence"]
  empty-writer :: ProgramInfo -> Writer
  empty-writer info = empty-writer-with-plan info NoInline
  empty-writer-with-plan :: ProgramInfo -> InlinePlan -> Writer
  empty-writer-with-plan info plan = Writer 0 builder-new builder-new Nil (object-layouts (program-object info)) (RuntimeContext info Nil Nil Nil Nil plan)
  prefix-cells :: Nat -> List Nat -> List (Nat, Nat)
  prefix-cells index words = case words of Nil -> Nil; Cons first rest -> Cons (index, first) (prefix-cells (index + 1) rest)
  object-layouts :: Option RuntimeObject -> LayoutPlan
  object-layouts provider = case provider of
    None -> LayoutPlan 0 Nil Nil Nil
    Some value -> let words = object-words value in
      if list-length words == 0 then LayoutPlan 0 Nil Nil Nil else
        LayoutPlan ((list-length words + 63) / 64) Nil Nil (prefix-cells 0 words)
  -- Reached method vectors grow monotonically in a finite Raw/Obj/TObj
  -- space. Plan to a fixed point before emitting dictionary layouts, so
  -- every instance and every indirect projection uses one class slot table.
  -- The emission of `roots`: tail groups, then worker passes until the
  -- method versions settle. A pass that adds no version ran with exactly
  -- the versions a further pass would start from, so its writer is the
  -- emission itself.
  settled-workers :: List CoreDefinition -> List (String, List Nat) -> ProgramInfo -> Writer
  settled-workers definitions roots info = settled-workers-with-plan NoInline definitions roots info
  settled-workers-with-plan :: InlinePlan -> List CoreDefinition -> List (String, List Nat) -> ProgramInfo -> Writer
  settled-workers-with-plan plan definitions roots info = settle-method-versions plan definitions roots (plan-tail-groups definitions info)
  settle-method-versions :: InlinePlan -> List CoreDefinition -> List (String, List Nat) -> ProgramInfo -> Writer
  settle-method-versions plan definitions roots info =
    let emitted = workers definitions (demand-roots roots (empty-writer-with-plan info plan)) in
    if list-length (program-versions (writer-program emitted)) == list-length (program-versions info) then emitted
    else settle-method-versions plan definitions roots (writer-program emitted)
  root-symbols :: List (String, List Nat) -> List String
  root-symbols roots = case roots of Nil -> Nil; Cons (name, classes) rest -> Cons (specialized-name name classes) (root-symbols rest)
  demand-roots :: List (String, List Nat) -> Writer -> Writer
  demand-roots roots w = case roots of
    Nil -> w
    Cons (name, classes) rest -> demand-roots rest (case constructor name (writer-data w) of
      Some found -> request-demand (ConstructorDemand name classes) w
      None -> demand-worker name classes w)
  -- Group only direct, saturated source calls in return position. An
  -- edge through an erased stage, dictionary, or external ABI has no
  -- shared internal worker and stays on the ordinary application path.
  source-tail-arities :: List CoreDefinition -> Writer -> HashMap String Nat
  source-tail-arities definitions w = case definitions of
    Nil -> hash-map-empty
    Cons d rest ->
      let name = core-name d in
      let arity = list-length (definition-parameters d) in
      let arities = source-tail-arities rest w in
      if arity == 0 || arity /= list-length (definition-all-parameters d) || builtin-known name then arities else
        (case (runtime-givens w d, opening-value-types (core-openings d), field-owner name (program-instances (writer-program w))) of
          (Nil, Nil, None) -> hash-map-insert name arity arities
          other -> arities)

  source-tail-edges :: HashMap String Nat -> CoreTerm -> List String -> List String
  source-tail-edges arities term next = case term of
    CIf sp ty test yes no -> source-tail-edges arities yes (source-tail-edges arities no next)
    CCase sp ty input alternatives -> source-tail-alternatives arities alternatives next
    CGuard sp ty test body -> source-tail-edges arities body next
    CLet sp ty id name sc value body -> source-tail-edges arities body next
    CWith sp ty given value body -> source-tail-edges arities body next
    CRequire sp ty body -> source-tail-edges arities body next
    CProved sp ty evidence body -> source-tail-edges arities body next
    CRefine sp ty evidence body -> source-tail-edges arities body next
    CRefineProof sp ty evidence body -> source-tail-edges arities body next
    CForget sp ty body -> source-tail-edges arities body next
    CDischarge sp ty evidence body -> source-tail-edges arities body next
    other -> case head term of
      CUse sp ty name role actuals -> (case hash-map-lookup name arities of
        Some arity -> if arity == list-length (arguments term Nil) && not (exposed-worker name next) then Cons name next else next
        None -> next)
      other -> next

  source-tail-alternatives :: HashMap String Nat -> CoreTerm -> List String -> List String
  source-tail-alternatives arities alternatives next = case alternatives of
    CAlternative sp pattern body rest -> source-tail-edges arities body (source-tail-alternatives arities rest next)
    other -> next

  source-tail-clauses :: HashMap String Nat -> List CoreClause -> List String
  source-tail-clauses arities clauses = case clauses of
    Nil -> Nil
    Cons (MkCoreClause sp patterns body) rest -> source-tail-edges arities body (source-tail-clauses arities rest)

  tail-neighbors :: HashMap String (List String) -> String -> List String
  tail-neighbors graph name = case hash-map-lookup name graph of Some edges -> edges; None -> Nil

  reverse-tail-edges :: String -> List String -> HashMap String (List String) -> HashMap String (List String)
  reverse-tail-edges name edges reversed = case edges of
    Nil -> reversed
    Cons callee rest -> reverse-tail-edges name rest (hash-map-insert callee (Cons name (tail-neighbors reversed callee)) reversed)

  source-tail-graphs :: List CoreDefinition -> HashMap String Nat -> HashMap String (List String) -> HashMap String (List String) -> List String -> (HashMap String (List String), HashMap String (List String), List String)
  source-tail-graphs definitions arities graph reversed vertices = case definitions of
    Nil -> (graph, reversed, vertices)
    Cons d rest ->
      let name = core-name d in
      case hash-map-lookup name arities of
        Some arity ->
          let edges = source-tail-clauses arities (core-clauses d) in
          source-tail-graphs rest arities (hash-map-insert name edges graph) (reverse-tail-edges name edges reversed) (Cons name vertices)
        None -> source-tail-graphs rest arities graph reversed vertices

  -- Visit the transpose in decreasing forward finish order. Each walk
  -- then reaches exactly the members of one strongly connected component.
  tail-finish-order :: HashMap String (List String) -> List String -> HashMap String (List String) -> List String -> (HashMap String (List String), List String)
  tail-finish-order graph vertices seen order = case vertices of
    Nil -> (seen, order)
    Cons name rest -> case hash-map-lookup name seen of
      Some ignored -> tail-finish-order graph rest seen order
      None -> case tail-finish-order graph (tail-neighbors graph name) (hash-map-insert name Nil seen) order of
        (visited, children) -> tail-finish-order graph rest visited (Cons name children)

  tail-group-width :: HashMap String Nat -> List String -> Nat
  tail-group-width arities members = case members of
    Nil -> 0
    Cons name rest ->
      let width = tail-group-width arities rest in
      case hash-map-lookup name arities of Some count -> if count > width then count else width; None -> width

  record-tail-group :: List String -> Nat -> Nat -> HashMap String (Nat, Nat) -> HashMap String (Nat, Nat)
  record-tail-group members group width groups = case members of
    Nil -> groups
    Cons name rest -> record-tail-group rest group width (hash-map-insert name (group, width) groups)

  source-tail-groups :: HashMap String Nat -> HashMap String (List String) -> HashMap String (List String) -> List String -> HashMap String (List String) -> Nat -> HashMap String (Nat, Nat) -> HashMap String (Nat, Nat)
  source-tail-groups arities graph reversed order seen group groups = case order of
    Nil -> groups
    Cons name rest -> case hash-map-lookup name seen of
      Some ignored -> source-tail-groups arities graph reversed rest seen group groups
      None -> case tail-finish-order reversed [name] seen Nil of
        (visited, members) ->
          let cyclic = case members of [member] -> exposed-worker member (tail-neighbors graph member); other -> True in
          let planned = if cyclic then record-tail-group members group (tail-group-width arities members) groups else groups in
          source-tail-groups arities graph reversed rest visited (group + 1) planned

  plan-tail-groups :: List CoreDefinition -> ProgramInfo -> ProgramInfo
  plan-tail-groups definitions info =
    let arities = source-tail-arities definitions (empty-writer info) in
    case source-tail-graphs definitions arities hash-map-empty hash-map-empty Nil of
      (graph, reversed, vertices) -> case tail-finish-order graph vertices hash-map-empty Nil of
        (seen, order) -> with-tail-groups (source-tail-groups arities graph reversed order hash-map-empty 0 hash-map-empty) info

  -- The caller selects checked definitions and explicit Raw/Obj/TObj
  -- specializations. Every root and reached helper uses the same checked
  -- worker/layout planner as an executable, without an entry requirement.
  -- Only selected roots have external linkage. Generated helpers and the
  -- closure dispatcher stay local; descriptor namespaces still require a
  -- compatible provider layout prefix. Physical ABI metadata is separate.
  -- The inliner is opt-in, as it is for a program: the plain entries emit
  -- every worker the roots reach, and a `-mode` entry takes the flag.
  emit-runtime-library-with-object :: CheckedProgram -> Option RuntimeObject -> List (String, List Nat) -> Result (List Diagnostic) String
  emit-runtime-library-with-object checked provider roots = emit-runtime-library-with-object-mode False checked provider roots
  emit-runtime-library-with-object-mode :: Bool -> CheckedProgram -> Option RuntimeObject -> List (String, List Nat) -> Result (List Diagnostic) String
  emit-runtime-library-with-object-mode inlining checked provider roots =
    let typed = checked-elaboration checked in
    let definitions = elaboration-core typed <> instance-definitions (elaboration-instances typed) in
    let info = ProgramInfo (elaboration-data typed) (elaboration-classes typed) (elaboration-instances typed) (index-bindings (elaboration-bindings typed)) Nil provider (Some (root-symbols roots)) (elaboration-effects typed) hash-map-empty in
    let plan = inline-plan inlining definitions info in
    case settled-workers-with-plan plan definitions roots info of
      Writer next globals code Nil layouts datas -> Ok (cat [declarations, par-preamble definitions, dedupe-globals (builder-run globals), layout-table layouts, apply-entry-with-linkage "internal ", builder-run code])
      Writer next globals code errors layouts datas -> Err errors
  -- Public ABI bridges and their metadata share this checked physical plan.
  -- The parameter prefix includes eager method values, dictionaries and
  -- quantified value indices; a proof stage returns an owned continuation.
  library-root-shape :: Writer -> CoreDefinition -> List Nat -> Option (List Nat, Nat)
  library-root-shape w d classes = case definition-context d classes w of
    None -> None
    Some context -> case core-clauses d of
      Nil -> None
      Cons (MkCoreClause sp patterns body) rest ->
        let types = value-field-types (definition-value-dependencies w d) <> given-types (runtime-givens w d) <> value-types (opening-value-types (core-openings d)) <> pattern-types (definition-parameters d) in
        let result = (case proof-stage-arities patterns 0 of Cons first (Cons second more) -> Some 1; other -> word-class context (core-type body)) in
        case (class-vector context types, result) of
          (Some params, Some returned) -> Some (params, returned)
          other -> None
  library-class :: Nat -> Json
  library-class code = JStr (if code == 0 then "R" else if code == 1 then "O" else "T")
  library-classes :: List Nat -> Json
  library-classes codes = case codes of Nil -> JArrEnd; Cons first rest -> JArr (library-class first) (library-classes rest)
  library-unit :: String -> List Nat -> Nat -> Json
  library-unit name params result = JObj "symbol" (JStr name)
    (JObj "closure_entry" (JStr (cat [name, ".object-closure"]))
      (JObj "arity" (JNum (nat-to-int (list-length params)))
        (JObj "params" (library-classes params) (JObj "result" (library-class result) JObjEnd))))
  library-symbol-conflict :: String -> String -> Bool
  library-symbol-conflict a b = same a b || same a (cat [b, ".object-closure"]) || same (cat [a, ".object-closure"]) b
  library-root-seen :: String -> List Nat -> String -> List (String, List Nat, String) -> Option Bool
  library-root-seen name classes public seen = case seen of
    Nil -> None
    Cons (other, codes, alias) rest -> if library-symbol-conflict public alias then
      Some (same public alias && same name other && same-classes classes codes)
      else library-root-seen name classes public rest
  library-public-symbol :: String -> Bool
  library-public-symbol name = let bytes = string-to-bytes name in
    bytes-len bytes > 0 && not (library-typed-prefix bytes 0)
  library-typed-prefix :: Bytes -> Nat -> Bool
  library-typed-prefix name index = let prefix = string-to-bytes "cinch.typed." in
    if index >= bytes-len prefix then index == bytes-len prefix else
      index < bytes-len name && bytes-get name index == bytes-get prefix index && library-typed-prefix name (index + 1)
  library-selected-roots :: List (String, List Nat, String) -> List (String, List Nat)
  library-selected-roots roots = case roots of Nil -> Nil; Cons (name, classes, public) rest -> Cons (name, classes) (library-selected-roots rest)
  library-bridge :: String -> String -> List Nat -> Writer -> Writer
  library-bridge public worker params w =
    let arguments = value-parameters (list-length params) 0 in
    let started = line (line w (cat ["define i64 ", llvm-object-symbol public, "(", join (argument-words arguments), ") {"])) "entry:" in
    case call started (symbol worker) arguments of
      (called, value) ->
        let returned = line (line called (cat ["  ret i64 ", value])) "}" in
        let accessor = line (line returned (cat ["define i64 ", llvm-object-symbol (cat [public, ".object-closure"]), "() {"])) "entry:" in
        case closure (Span 0 0 1 1) worker params Nil accessor of
          (ready, closure-value) -> line (line ready (cat ["  ret i64 ", closure-value])) "}"
  library-checked-shape :: List CoreDefinition -> Writer -> String -> List Nat -> Option (List Nat, Nat)
  library-checked-shape definitions w name classes = case definition name definitions of
    Some d -> library-root-shape w d classes
    None -> case constructor name (writer-data w) of
      Some (owner, tag, c) -> (case data-declaration owner (writer-data w) of
        Some d -> (case constructor-context d classes w of
          Some context -> if not (constructor-supported context d c) then None else
            (case class-vector context (core-constructor-fields c) of Some fields -> Some (fields, 1); None -> None)
          None -> None)
        None -> None)
      None -> None
  library-bridges :: List CoreDefinition -> List (String, List Nat, String) -> List (String, List Nat, String) -> Writer -> (Writer, Json)
  library-bridges definitions roots seen w = case roots of
    Nil -> (w, JArrEnd)
    Cons (name, classes, public) rest -> case library-root-seen name classes public seen of
      Some True -> library-bridges definitions rest seen w
      Some False -> (refuse w (Span 0 0 1 1) "library ABI export symbols collide", JArrEnd)
      None -> if not (library-public-symbol public) then (refuse w (Span 0 0 1 1) "library ABI export symbol is empty or collides with typed workers", JArrEnd) else
        if (case (definition name definitions, constructor name (writer-data w)) of (None, None) -> True; other -> False) then
          (refuse w (Span 0 0 1 1) "library ABI root has no checked definition", JArrEnd) else
          case library-checked-shape definitions w name classes of
            None -> (refuse w (Span 0 0 1 1) "library ABI root has no checked physical parameter/result shape", JArrEnd)
            Some (params, result) ->
              let bridged = library-bridge public (specialized-name name classes) params w in
              case library-bridges definitions rest (Cons (name, classes, public) seen) bridged of
                (done, units) -> (done, JArr (library-unit public params result) units)
  library-new-cells :: Nat -> List (Nat, Nat) -> List (Nat, Nat)
  library-new-cells prefix cells = case cells of
    Nil -> Nil
    Cons (index, word) rest -> if index < prefix then library-new-cells prefix rest else Cons (index, word) (library-new-cells prefix rest)
  library-layout-tail :: Nat -> Nat -> List (Nat, Nat) -> List Nat
  library-layout-tail index end cells = if index >= end then Nil else Cons (layout-word index cells) (library-layout-tail (index + 1) end cells)
  library-layout-words :: Writer -> LayoutPlan -> List Nat
  library-layout-words w layouts = case layouts of
    LayoutPlan groups tuples names cells ->
      let prefix = (case program-object (writer-program w) of None -> Nil; Some provider -> object-words provider) in
      let count = list-length prefix in
      prefix <> library-layout-tail count (layout-count layouts) (library-new-cells count cells)
  -- Like the Native object collector, every non-generic checked definition
  -- is a physical root. This inventory grants no source visibility: exports
  -- remain in the independently checked interfaces. Do not synthesize a
  -- Cartesian set of variants for generic definitions.
  library-default-definitions :: List CoreDefinition -> Result String (List (String, List Nat, String))
  library-default-definitions definitions = case definitions of
    Nil -> Ok Nil
    Cons d rest -> case library-default-definitions rest of
      Err message -> Err message
      Ok more -> if type-param-count (scheme-params (core-scheme d)) > 0 then Ok more else
        (case export-global (core-name d) of
          Err message -> Err message
          Ok public -> if same public "Main.main" then Err "library objects cannot contain the process entry" else Ok (Cons (core-name d, Nil, public) more))
  runtime-library-default-roots :: CheckedProgram -> Result String (List (String, List Nat, String))
  runtime-library-default-roots checked =
    let typed = checked-elaboration checked in
    let info = ProgramInfo (elaboration-data typed) (elaboration-classes typed) (elaboration-instances typed) (index-bindings (elaboration-bindings typed)) Nil None (Some Nil) (elaboration-effects typed) hash-map-empty in
    case (library-default-definitions (elaboration-core typed), library-default-constructors (elaboration-data typed) (empty-writer info)) of
      (Ok definitions, Ok constructors) -> Ok (definitions <> constructors)
      (Err message, other) -> Err message
      (other, Err message) -> Err message
  library-source-name :: String -> Bool
  library-source-name name = let bytes = string-to-bytes name in
    bytes-len bytes > 2 && bytes-get bytes 0 == 109 && bytes-get bytes 1 == 46
  library-default-constructors :: List CoreData -> Writer -> Result String (List (String, List Nat, String))
  library-default-constructors datas w = case datas of
    Nil -> Ok Nil
    Cons d rest -> case library-default-constructors rest w of
      Err message -> Err message
      Ok more -> if not (library-source-name (core-data-name d)) then Ok more else library-default-data-constructors d (core-data-constructors d) w more
  library-default-data-constructors :: CoreData -> List CoreConstructor -> Writer -> List (String, List Nat, String) -> Result String (List (String, List Nat, String))
  library-default-data-constructors d constructors w more = case constructors of
    Nil -> Ok more
    Cons c rest -> case library-default-data-constructors d rest w more of
      Err message -> Err message
      Ok tail -> case class-vector (writer-context w) (core-constructor-fields c) of
        None -> Ok tail
        Some fields -> case export-global (core-constructor-name c) of
          Err message -> Err message
          Ok public -> Ok (Cons (core-constructor-name c, default-own (core-data-params d), public) tail)

  -- The named layout cache is the authority for emitted nominal descriptors.
  -- Decode only the planner's own representation suffix, never source text.
  library-key-prefix :: Bytes -> Bytes -> Nat -> Bool
  library-key-prefix prefix key index = if index >= bytes-len prefix then True else
    index < bytes-len key && bytes-get prefix index == bytes-get key index && library-key-prefix prefix key (index + 1)
  library-key-codes :: Bytes -> Nat -> Option (List Nat)
  library-key-codes key index = if index < bytes-len key then
    (let byte = bytes-get key index in if byte < 48 || byte > 50 then None else case library-key-codes key (index + 1) of
      None -> None
      Some rest -> Some (Cons (byte - 48) rest))
    else if index == bytes-len key then Some Nil else None
  library-key-classes :: String -> String -> Option (List Nat)
  library-key-classes name key = if same name key then Some Nil else
    let prefix = string-to-bytes (cat [name, ".r"]) in let bytes = string-to-bytes key in
    if bytes-len bytes <= bytes-len prefix || not (library-key-prefix prefix bytes 0) then None else library-key-codes bytes (bytes-len prefix)
  library-layout-data :: String -> List CoreData -> Option (CoreData, List Nat)
  library-layout-data key datas = case datas of
    Nil -> None
    Cons d rest -> case library-key-classes (core-data-name d) key of
      Some codes -> Some (d, codes)
      None -> library-layout-data key rest
  library-public-name :: String -> List Nat -> Result String String
  library-public-name name codes = case export-global name of
    Err message -> Err message
    Ok public -> Ok (cat [public, if list-length codes == 0 then "" else cat ["@", native-classes codes]])
  library-type-facts :: List (String, Nat) -> List CoreData -> Json
  library-type-facts names datas = case names of
    Nil -> JObjEnd
    Cons (key, descriptor) rest -> case library-layout-data key datas of
      None -> library-type-facts rest datas
      Some (d, codes) -> case library-public-name (core-data-name d) codes of
        Err message -> library-type-facts rest datas
        Ok public -> JObj public (if list-length (core-data-constructors d) <= 64 && descriptor < 65472 then JObj "group" (JNum (nat-to-int (descriptor / 64))) JObjEnd else
          JObj "base" (JNum (nat-to-int descriptor)) (JObj "shared" (JBool False) JObjEnd)) (library-type-facts rest datas)
  library-constructor-facts :: CoreData -> List Nat -> Nat -> Nat -> List CoreConstructor -> Json -> Json
  library-constructor-facts d codes descriptor tag constructors rest = case constructors of
    Nil -> rest
    Cons c more -> case library-public-name (core-constructor-name c) codes of
      Err message -> library-constructor-facts d codes descriptor (tag + 1) more rest
      Ok public -> JObj public (JObj "tag" (JNum (nat-to-int tag))
        (JObj "arity" (JNum (nat-to-int (list-length (core-constructor-fields c))))
          (JObj "descriptor" (JNum (nat-to-int (data-descriptor d descriptor tag))) JObjEnd)))
        (library-constructor-facts d codes descriptor (tag + 1) more rest)
  library-constructor-layout-facts :: List (String, Nat) -> List CoreData -> Json
  library-constructor-layout-facts names datas = case names of
    Nil -> JObjEnd
    Cons (key, descriptor) rest -> case library-layout-data key datas of
      None -> library-constructor-layout-facts rest datas
      Some (d, codes) -> library-constructor-facts d codes descriptor 0 (core-data-constructors d) (library-constructor-layout-facts rest datas)
  library-escaped :: List (String, Nat) -> List CoreData -> Bool
  library-escaped names datas = case names of
    Nil -> False
    Cons (key, descriptor) rest -> (case library-layout-data key datas of Some (d, codes) -> list-length (core-data-constructors d) > 64 || descriptor >= 65472; None -> False) || library-escaped rest datas
  library-method-slot-facts :: List MethodSlot -> Json
  library-method-slot-facts plans = case plans of
    Nil -> JArrEnd
    Cons (MethodSlot logical physical own-codes) rest -> JArr (JObj "logical" (JNum (nat-to-int logical))
      (JObj "physical" (JNum (nat-to-int physical)) (JObj "own" (JStr (native-classes own-codes)) JObjEnd))) (library-method-slot-facts rest)
  library-method-family-facts :: Writer -> List CoreClass -> Json
  library-method-family-facts w descriptions = case descriptions of
    Nil -> JArrEnd
    Cons description rest -> case export-global (class-name description) of
      Err message -> library-method-family-facts w rest
      Ok public -> JArr (JObj "class" (JStr public)
        (JObj "declared_methods" (JNum (nat-to-int (list-length (class-methods description))))
          (JObj "slots" (library-method-slot-facts (class-method-slots w description)) JObjEnd))) (library-method-family-facts w rest)
  library-has-dictionary-demand :: List Demand -> Bool
  library-has-dictionary-demand demands = case demands of
    Nil -> False
    Cons (DictionaryDemand name codes) rest -> True
    Cons first rest -> library-has-dictionary-demand rest
  library-object-facts :: Writer -> Json
  library-object-facts w = case w of
    Writer next globals code errors (LayoutPlan groups tuples names cells) context ->
      let datas = program-data (writer-program w) in
      let dictionary-demand = (case context of RuntimeContext info bounds rigids pending done inlining -> library-has-dictionary-demand done) in
      JObj "method_families" (library-method-family-facts w (program-classes (writer-program w))) (JObj "unpublished_dictionaries" (JBool dictionary-demand) (JObj "types" (library-type-facts names datas)
        (JObj "constructors" (library-constructor-layout-facts names datas)
          (JObj "escaped_descriptors" (JBool (library-escaped names datas)) JObjEnd))))

  -- The alias in each root is a physical symbol chosen by the caller from
  -- checked export identities. The pipeline owns that source-name authority.
  -- These are physical unit/layout facts, not a completed object manifest.
  emit-runtime-library-artifact-with-object :: CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, List Nat, Json)
  emit-runtime-library-artifact-with-object checked provider roots = case emit-runtime-library-artifact True False checked provider roots of
    Err errors -> Err errors
    Ok (ir, words, units, facts) -> Ok (ir, words, units)
  -- A closed dependency object never installs a shorter layout table from a
  -- global constructor. The final consumer registers its complete compatible
  -- prefix, including this object's actual descriptors, once before use.
  emit-runtime-library-object-with-object :: CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, List Nat, Json, Json)
  emit-runtime-library-object-with-object checked provider roots = emit-runtime-library-artifact False False checked provider roots
  -- The inlining switch is the plan's first field: a measured run takes the
  -- same library with the copies turned off.
  emit-runtime-library-object-with-object-mode :: Bool -> CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, List Nat, Json, Json)
  emit-runtime-library-object-with-object-mode inlining checked provider roots = emit-runtime-library-artifact False inlining checked provider roots
  emit-runtime-library-artifact-with-object-mode :: Bool -> CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, List Nat, Json)
  emit-runtime-library-artifact-with-object-mode inlining checked provider roots = case emit-runtime-library-artifact True inlining checked provider roots of
    Err errors -> Err errors
    Ok (ir, words, units, facts) -> Ok (ir, words, units)
  emit-runtime-library-artifact :: Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> List (String, List Nat, String) -> Result (List Diagnostic) (String, List Nat, Json, Json)
  emit-runtime-library-artifact register inlining checked provider roots =
    let typed = checked-elaboration checked in
    let definitions = elaboration-core typed <> instance-definitions (elaboration-instances typed) in
    let selected = library-selected-roots roots in
    let info = ProgramInfo (elaboration-data typed) (elaboration-classes typed) (elaboration-instances typed) (index-bindings (elaboration-bindings typed)) Nil provider (Some Nil) (elaboration-effects typed) hash-map-empty in
    let plan = inline-plan inlining definitions info in
    case library-bridges definitions roots Nil (settled-workers-with-plan plan definitions selected info) of
      (bridged, units) -> case workers definitions bridged of
        Writer next globals code Nil layouts context ->
          let ir = cat [declarations, par-preamble definitions, dedupe-globals (builder-run globals), if register then layout-table layouts else "", apply-entry-with-linkage "internal ", builder-run code] in
          Ok (ir, library-layout-words bridged layouts, units, if register then JObjEnd else library-object-facts (Writer next globals code Nil layouts context))
        Writer next globals code errors layouts context -> Err errors
  emit-runtime-program :: CheckedProgram -> Result (List Diagnostic) String
  emit-runtime-program checked = emit-runtime-program-with-object checked None
  emit-runtime-program-mode :: Bool -> CheckedProgram -> Result (List Diagnostic) String
  emit-runtime-program-mode inlining checked = emit-runtime-program-with-object-mode inlining checked None
  emit-runtime-program-with-object :: CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-runtime-program-with-object checked provider = emit-runtime-program-counting False checked provider
  emit-runtime-program-with-object-mode :: Bool -> CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-runtime-program-with-object-mode inlining checked provider = emit-runtime-program-counting-mode inlining False checked provider
  -- A debug-counting program routes its own count operations through the
  -- runtime's checked entries; a linked provider object keeps the counts
  -- it was compiled with. The inliner is opt-in, so the plain entry emits
  -- every worker a root reaches and a `-mode` entry takes the flag.
  emit-runtime-program-counting :: Bool -> CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-runtime-program-counting debug checked provider = emit-runtime-program-counting-mode False debug checked provider
  emit-runtime-program-counting-mode :: Bool -> Bool -> CheckedProgram -> Option RuntimeObject -> Result (List Diagnostic) String
  emit-runtime-program-counting-mode inlining debug checked provider =
    let typed = checked-elaboration checked in
    let definitions = elaboration-core typed <> instance-definitions (elaboration-instances typed) in
    let datas = elaboration-data typed in
    let info = ProgramInfo datas (elaboration-classes typed) (elaboration-instances typed) (index-bindings (elaboration-bindings typed)) Nil provider None (elaboration-effects typed) hash-map-empty in
    case definition "main" definitions of
      None -> Err [MkDiagnostic "bootstrap.runtime-ir" (Span 0 0 1 1) "runtime entry has no main definition"]
      Some d -> case entry-mode d of
        None -> Err [MkDiagnostic "bootstrap.runtime-ir" (Span 0 0 1 1) "runtime entry must be main :: Int or Unit -> Int, optionally effectful, without external evidence"]
        -- The planning roots demand `main` as a worker unless a constructor
        -- shares the name; only then does the entry need its own pass.
        Some mode -> let plan = inline-plan inlining definitions info in
          let settled = settled-workers-with-plan plan definitions [("main", Nil)] info in
          case (case constructor "main" datas of Some found -> workers definitions (demand-worker "main" Nil (empty-writer-with-plan (writer-program settled) plan)); None -> settled) of
            Writer next globals code Nil layouts datas -> Ok (cat [declarations-counting debug, par-preamble definitions, dedupe-globals (builder-run globals), layout-table layouts, apply-entry, builder-run code, entry mode])
            Writer next globals code errors layouts datas -> Err errors
