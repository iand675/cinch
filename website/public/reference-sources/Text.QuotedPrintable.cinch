-- | Quoted-printable byte codecs with explicit newline modes and continuation state.
-- Text mode normalizes CR, LF and CRLF to CRLF; binary mode escapes them.
-- Encoded lines contain at most 76 symbols, including a soft-break marker.
-- Continuations snapshot unfinished input. Returned byte buffers are fresh and
-- may be mutated without changing a continuation or another returned buffer.
-- Decoding accepts lowercase hex, raw high bytes and malformed non-newline
-- escapes as literals; precise errors retain the successfully decoded prefix.
module Text.QuotedPrintable where

  import Algebra.Semigroup
  import Data.Bool
  import Data.Bytes
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String
  import Data.Wide
  import Text.Show

  export QuotedPrintableMode, QuotedPrintableText, QuotedPrintableBinary
  export QuotedPrintableEncoder, quoted-printable-encoder, quoted-printable-encoder-mode
  export quoted-printable-encoder-policy
  export quoted-printable-encoder-feed, quoted-printable-encoder-finish
  export quoted-printable-encoder-events, quoted-printable-encoder-finish-events
  export quoted-printable-encode, quoted-printable-encode-bytes
  export QuotedPrintableError, QuotedPrintableInvalidByte, QuotedPrintableInvalidHex
  export QuotedPrintableIncompleteEscape, QuotedPrintableInvalidSoftBreak, QuotedPrintableLineTooLong
  export quoted-printable-error-offset, quoted-printable-error-message
  export QuotedPrintableDecoder, quoted-printable-decoder, quoted-printable-decoder-feed
  export quoted-printable-decoder-error, quoted-printable-decoder-capacity, quoted-printable-decoder-position
  export quoted-printable-decoder-end, quoted-printable-decoder-finish
  export quoted-printable-decode-prefix, quoted-printable-decode-bytes

  -- | Newline policy for subsequent input; mode changes preserve pending bytes and CR carry.
  data QuotedPrintableMode where
    -- | Normalize input line endings to CRLF and quote only trailing whitespace.
    QuotedPrintableText :: QuotedPrintableMode
    -- | Treat CR and LF as binary bytes and encode them as hexadecimal escapes.
    QuotedPrintableBinary :: QuotedPrintableMode

  -- | Private fixed-size line storage, including room for a soft marker and CRLF.
  type EncoderLine = refine (b :: Bytes) with bytes-len b == 78

  -- | Immutable encoding continuation. Feeds clone its private line before writing.
  data QuotedPrintableEncoder where
    -- | Private mode, fixed line, bounded payload cursor and preceding text CR flag.
    EncodeState :: QuotedPrintableMode -> EncoderLine -> InRange 0 75 Nat -> Bool -> QuotedPrintableEncoder

  -- | Private bounded line position, CR carry and reversed output events.
  data EncodeWork where
    -- | Preserve the cursor proof across helper results and pattern matching.
    EncodeWork :: InRange 0 75 Nat -> Bool -> List (Nat, Bytes) -> EncodeWork

  -- | Begin encoding with empty line state under an explicit newline policy.
  quoted-printable-encoder :: QuotedPrintableMode -> QuotedPrintableEncoder
  quoted-printable-encoder mode = EncodeState mode (bytes-new 78) 0 False

  -- | Change the policy for later feeds without flushing or changing pending input.
  quoted-printable-encoder-mode :: QuotedPrintableMode -> QuotedPrintableEncoder -> QuotedPrintableEncoder
  quoted-printable-encoder-mode mode state = case state of
    EncodeState old line pos cr -> EncodeState mode line pos cr

  -- | Observe the policy used for subsequent feeds without advancing or copying state.
  quoted-printable-encoder-policy :: QuotedPrintableEncoder -> QuotedPrintableMode
  quoted-printable-encoder-policy state = case state of
    EncodeState mode line pos cr -> mode

  -- | Whether CR and LF must be encoded as bytes rather than normalized.
  binary-mode :: QuotedPrintableMode -> Bool
  binary-mode mode = case mode of
    QuotedPrintableText -> False
    QuotedPrintableBinary -> True

  -- | Copy an exact checked interval into independent byte storage.
  part :: Bytes -> Nat -> Nat -> Bytes
  part input at count = if at + count <= bytes-len input then
    let out = bytes-new count in
    let copied = bytes-copy-range out input 0 at count in out
    else bytes-new 0

  -- | Snapshot private fixed line storage before advancing an immutable continuation.
  clone-line :: EncoderLine -> EncoderLine
  clone-line old = let out = bytes-new 78 in
    let copied = bytes-copy-range out old 0 0 78 in out

  -- | Uppercase hexadecimal ASCII for a nibble. Out-of-range private calls yield zero.
  hex-digit :: Nat -> InRange 0 255 Nat
  hex-digit n = if n < 10 then n + 48 else if n < 16 then n + 55 else 48

  -- | Recognize horizontal whitespace whose last byte must be quoted before a hard ending.
  whitespace :: Nat -> Bool
  whitespace b = b == 32 || b == 9

  -- | Recognize one byte accepted by the writer's plain-input batch path.
  raw-byte :: QuotedPrintableMode -> Nat -> Bool
  raw-byte mode b =
    (b >= 33 && b <= 126 && b /= 61) || whitespace b ||
    (if binary-mode mode then False else b == 13 || b == 10)

  -- | Recognize one byte in a writer batch, decoded literal run or physical-line scan.
  good-byte :: U8 -> Nat -> Bool
  good-byte kind byte =
    if eq-u8 kind 3 then byte /= 10
    else if eq-u8 kind 2 then byte /= 61 && ((byte >= 32 && byte /= 127) || byte == 9 || byte == 13 || byte == 10)
    else raw-byte (if eq-u8 kind 0 then QuotedPrintableText else QuotedPrintableBinary) byte

  -- | Find the first byte outside one selected class within an explicit bound.
  -- Complete sixteen-byte windows use portable 128-bit SIMD; the exact final fringe is scalar.
  scan-end :: using (at <= limit, limit <= bytes-len input) => U8 -> (input :: Bytes) -> (at :: Nat) -> (limit :: Nat) -> refined (at <= r && r <= limit) Nat
  scan-end kind input at limit =
    let start = nat-to-i64 at in
    let bound = nat-to-i64 limit in
    let found = (
      if eq-u8 kind 3 then scan-lf-at input start bound
      else if eq-u8 kind 2 then scan-body-at input start bound
      else if eq-u8 kind 1 then scan-binary-at input start bound
      else scan-text-at input start bound) in
    if 0 <= found then
      let pos = nat-from-i64 found in
      if at <= pos && pos <= limit then pos else at
    else at

  -- | Find a maximal raw writer batch, including CR/LF only under text policy.
  raw-end :: using (at <= limit, limit <= bytes-len input) => QuotedPrintableMode -> (input :: Bytes) -> (at :: Nat) -> (limit :: Nat) -> refined (at <= r && r <= limit) Nat
  raw-end mode input at limit = scan-end (if binary-mode mode then 1 else 0) input at limit

  -- | Snapshot one completed soft line; every write is within the private 78-byte allocation.
  soft-line :: EncoderLine -> InRange 0 75 Nat -> Bytes
  soft-line line pos =
    let marker = bytes-set line pos 61 in
    let cr = bytes-set line (pos + 1) 13 in
    let lf = bytes-set line (pos + 2) 10 in
    part line 0 (pos + 3)

  -- | Snapshot one completed hard line after its last whitespace byte was encoded.
  hard-line :: EncoderLine -> InRange 0 75 Nat -> Bytes
  hard-line line pos =
    let cr = bytes-set line pos 13 in
    let lf = bytes-set line (pos + 1) 10 in
    part line 0 (pos + 2)

  -- | Append one escape, first emitting a soft line when three symbols do not fit.
  -- Escaping deliberately preserves the preceding text CR flag across mode changes.
  plan-escape :: EncoderLine -> Nat -> InRange 0 255 Nat -> InRange 0 75 Nat -> Bool -> List (Nat, Bytes) -> EncodeWork
  plan-escape line checkpoint byte pos cr events =
    if pos <= 72 then
      let marker = bytes-set line pos 61 in
      let high = bytes-set line (pos + 1) (hex-digit (nat-div byte 16)) in
      let low = bytes-set line (pos + 2) (hex-digit (nat-rem byte 16)) in
      EncodeWork ((pos + 3) :: Nat) cr events
    else plan-escape line checkpoint byte 0 cr (Cons (checkpoint, soft-line line pos) events)

  -- | Encode the last horizontal whitespace byte before a hard ending or finish.
  plan-last :: EncoderLine -> Nat -> InRange 0 75 Nat -> Bool -> List (Nat, Bytes) -> EncodeWork
  plan-last line checkpoint pos cr events =
    if pos > 0 then
      let byte = bytes-get line (pos - 1) in
      if whitespace byte then plan-escape line checkpoint byte ((pos - 1) :: Nat) cr events
      else EncodeWork pos cr events
    else EncodeWork pos cr events

  -- | Normalize one text newline, handling a carried CRLF and any whitespace-induced soft line.
  plan-newline :: EncoderLine -> Nat -> Nat -> InRange 0 75 Nat -> Bool -> List (Nat, Bytes) -> EncodeWork
  plan-newline line checkpoint byte pos cr events =
    if cr && byte == 10 then EncodeWork pos False events
    else case plan-last line checkpoint pos cr events of
      EncodeWork next carry emitted -> EncodeWork 0 (byte == 13) (Cons (checkpoint, hard-line line next) emitted)

  -- | Append a proven raw input batch. Literal runs copy in bulk into the
  -- bounded line; CR/LF and wrapping retain their ordered scalar semantics.
  plan-raw :: using (at <= end, end <= bytes-len input) => EncoderLine -> (input :: Bytes) -> (at :: Nat) -> (end :: Nat) -> Nat -> InRange 0 75 Nat -> Bool -> List (Nat, Bytes) -> EncodeWork
  plan-raw line input at end checkpoint pos cr events =
    if at < end then
      let byte = bytes-get input at in
      if byte == 13 || byte == 10 then case plan-newline line checkpoint byte pos cr events of
        EncodeWork next carry emitted -> plan-raw line input (at + 1) end checkpoint next carry emitted
      else if pos == 75 then plan-raw line input at end checkpoint 0 cr (Cons (checkpoint, soft-line line pos) events)
      else
        let limit = if end < at + (75 - pos) then end else at + (75 - pos) in
        if at <= limit && limit <= end then
          let stop = raw-end QuotedPrintableBinary input at limit in
          let count = stop - at in
          if count > 0 && pos + count <= 75 && at + count <= end then
            let copied = bytes-copy-range line input pos at count in
            plan-raw line input (at + count) end checkpoint ((pos + count) :: Nat) False events
          else
            let stored = bytes-set line pos byte in
            plan-raw line input (at + 1) end checkpoint ((pos + 1) :: Nat) False events
        else
          let stored = bytes-set line pos byte in
          plan-raw line input (at + 1) end checkpoint ((pos + 1) :: Nat) False events
    else EncodeWork pos cr events

  -- | Preserve the writer's input-count checkpoints at transitions from raw runs to escapes.
  plan-input :: using (at <= bytes-len input) => QuotedPrintableMode -> EncoderLine -> (input :: Bytes) -> (at :: Nat) -> InRange 0 75 Nat -> Bool -> List (Nat, Bytes) -> (List (Nat, Bytes), QuotedPrintableEncoder)
  plan-input mode line input at pos cr events =
    let end = raw-end mode input at (bytes-len input) in
    case plan-raw line input at end at pos cr events of
      EncodeWork next carry emitted ->
        if end < bytes-len input then case plan-escape line end (bytes-get input end) next carry emitted of
          EncodeWork after nextCarry complete -> plan-input mode line input (end + 1) after nextCarry complete
        else (reverse emitted, EncodeState mode line next carry)

  -- | Encode a feed as complete sink-write events and an advanced continuation.
  -- Each event carries the input prefix reportable if its sink write fails.
  -- No event or retained state aliases the caller's mutable input.
  quoted-printable-encoder-events :: QuotedPrintableEncoder -> Bytes -> (List (Nat, Bytes), QuotedPrintableEncoder)
  quoted-printable-encoder-events state input = case state of
    EncodeState mode old pos cr -> plan-input mode (clone-line old) input 0 pos cr Nil

  -- | Flush the final line as fresh events, quoting its last space or tab.
  -- The zero-length final event records a logical flush; byte streams may
  -- treat it as an inert empty write under their existing protocol.
  quoted-printable-encoder-finish-events :: QuotedPrintableEncoder -> List (Nat, Bytes)
  quoted-printable-encoder-finish-events state = case state of
    EncodeState mode old pos cr ->
      let line = clone-line old in
      case plan-last line 0 pos cr Nil of
        EncodeWork next carry emitted -> reverse (Cons (0, part line 0 next) emitted)

  -- | Add the exact lengths of complete output events without visiting their bytes.
  events-length :: List (Nat, Bytes) -> Nat -> Nat
  events-length events total = case events of
    Nil -> total
    Cons event rest -> case event of
      (checkpoint, bytes) -> events-length rest (total + bytes-len bytes)

  -- | Copy whole event buffers into the aggregate allocated from their exact total.
  copy-events :: Bytes -> Nat -> List (Nat, Bytes) -> Unit
  copy-events out pos events = case events of
    Nil -> ()
    Cons event rest -> case event of
      (checkpoint, bytes) ->
        if pos + bytes-len bytes <= bytes-len out then
          let copied = bytes-copy-range out bytes pos 0 (bytes-len bytes) in
          copy-events out (pos + bytes-len bytes) rest
        else ()

  -- | Flatten complete events once into fresh bytes; event buffers remain independent.
  events-output :: List (Nat, Bytes) -> Bytes
  events-output events = let out = bytes-new (events-length events 0) in
    let copied = copy-events out 0 events in out

  -- | Encode complete lines from one feed and retain only the unfinished private line.
  quoted-printable-encoder-feed :: QuotedPrintableEncoder -> Bytes -> (Bytes, QuotedPrintableEncoder)
  quoted-printable-encoder-feed state input = case quoted-printable-encoder-events state input of
    (events, next) -> (events-output events, next)

  -- | Finish an immutable continuation and return the independent final encoded bytes.
  quoted-printable-encoder-finish :: QuotedPrintableEncoder -> Bytes
  quoted-printable-encoder-finish state = events-output (quoted-printable-encoder-finish-events state)

  -- | Encode a complete buffer as fresh ASCII bytes using an explicit newline policy.
  quoted-printable-encode-bytes :: QuotedPrintableMode -> Bytes -> Bytes
  quoted-printable-encode-bytes mode input = case quoted-printable-encoder-events (quoted-printable-encoder mode) input of
    (events, next) -> events-output (events <> quoted-printable-encoder-finish-events next)

  -- | Encode a complete buffer as ASCII text; all possible input bytes are representable.
  quoted-printable-encode :: QuotedPrintableMode -> Bytes -> String
  quoted-printable-encode mode input = case string-from-bytes (quoted-printable-encode-bytes mode input) of
    Some text -> text
    None -> empty-string

  -- | Malformed input or an overlong physical line. Prefix APIs retain all
  -- decoded bytes preceding the failure; offsets count original input bytes.
  data QuotedPrintableError where
    -- | An unescaped control or DEL byte, with its absolute original offset.
    QuotedPrintableInvalidByte :: Nat -> InRange 0 255 Nat -> QuotedPrintableError
    -- | A non-hexadecimal CR/LF byte in an escape that cannot be taken literally.
    QuotedPrintableInvalidHex :: Nat -> InRange 0 255 Nat -> QuotedPrintableError
    -- | A final escape in a completed soft line has too few hexadecimal digits.
    QuotedPrintableIncompleteEscape :: Nat -> QuotedPrintableError
    -- | Invalid transport bytes after a soft marker, retained as immutable escaped text.
    QuotedPrintableInvalidSoftBreak :: Nat -> String -> QuotedPrintableError
    -- | The next input offset after a full 4096-byte physical-line fragment.
    QuotedPrintableLineTooLong :: Nat -> QuotedPrintableError

  -- | The absolute original input position associated with a codec failure.
  quoted-printable-error-offset :: QuotedPrintableError -> Nat
  quoted-printable-error-offset error = case error of
    QuotedPrintableInvalidByte offset byte -> offset
    QuotedPrintableInvalidHex offset byte -> offset
    QuotedPrintableIncompleteEscape offset -> offset
    QuotedPrintableInvalidSoftBreak offset suffix -> offset
    QuotedPrintableLineTooLong offset -> offset

  -- | Lowercase ASCII hexadecimal for a nibble used in diagnostics.
  lower-hex-digit :: Nat -> InRange 0 255 Nat
  lower-hex-digit n = if n < 10 then n + 48 else if n < 16 then n + 87 else 48

  -- | Render one diagnostic byte as two lowercase hexadecimal symbols.
  byte-hex :: InRange 0 255 Nat -> String
  byte-hex byte = let out = bytes-new 2 in
    let high = bytes-set out 0 (lower-hex-digit (nat-div byte 16)) in
    let low = bytes-set out 1 (lower-hex-digit (nat-rem byte 16)) in
    case string-from-bytes out of Some text -> text; None -> empty-string

  -- | Render a soft-break suffix using explicit quoted control escapes.
  suffix-text :: Bytes -> Nat -> String
  suffix-text input at = if at < bytes-len input then
    let byte = bytes-get input at in
    string-concat (if byte == 13 then "\\r" else if byte == 10 then "\\n" else if byte == 9 then "\\t" else if byte == 32 then " " else string-concat "\\x" (byte-hex byte)) (suffix-text input (at + 1))
    else empty-string

  -- | Human-readable diagnostics preserving the exact offending byte or transport suffix.
  quoted-printable-error-message :: QuotedPrintableError -> String
  quoted-printable-error-message error = case error of
    QuotedPrintableInvalidByte offset byte -> string-concat "quotedprintable: invalid unescaped byte 0x" (string-concat (byte-hex byte) " in body")
    QuotedPrintableInvalidHex offset byte -> string-concat "quotedprintable: invalid hex byte 0x" (byte-hex byte)
    QuotedPrintableIncompleteEscape offset -> "unexpected EOF"
    QuotedPrintableInvalidSoftBreak offset suffix -> string-concat "quotedprintable: invalid bytes after =: \"" (string-concat suffix "\"")
    QuotedPrintableLineTooLong offset -> "quoted-printable physical line buffer is full"

  -- | Private physical-line storage matching the default 4096-byte decoding boundary.
  type DecoderLine = refine (b :: Bytes) with bytes-len b == 4096

  -- | Private decoded-line storage, including room to restore a hard CRLF ending.
  type DecoderOutput = refine (b :: Bytes) with bytes-len b == 4098

  -- | Immutable decoder continuation owning its unfinished physical-line snapshot.
  -- Feed results count consumed input separately from the failure's precise offset.
  data QuotedPrintableDecoder where
    -- | Private line, initialized cursor, absolute line origin and sticky first failure.
    DecodeState :: DecoderLine -> InRange 0 4096 Nat -> Nat -> Option QuotedPrintableError -> QuotedPrintableDecoder

  -- | Private decoded prefix length with its first inline escape/body failure.
  data DecodeWork where
    -- | Retain the initialized output bound across decoding helper results.
    DecodeWork :: InRange 0 4096 Nat -> Option QuotedPrintableError -> DecodeWork

  -- | Begin independent decoding with original offsets starting at zero.
  quoted-printable-decoder :: QuotedPrintableDecoder
  quoted-printable-decoder = DecodeState (bytes-new 4096) 0 0 None

  -- | Observe the first sticky codec failure without advancing the continuation.
  quoted-printable-decoder-error :: QuotedPrintableDecoder -> Option QuotedPrintableError
  quoted-printable-decoder-error state = case state of
    DecodeState line count origin error -> error

  -- | Number of bytes that may be fetched without reading past the decoder's
  -- current physical-line buffer capacity. Failed decoders request no input.
  quoted-printable-decoder-capacity :: QuotedPrintableDecoder -> Nat
  quoted-printable-decoder-capacity state = case state of
    DecodeState line count origin error -> case error of
      Some failure -> 0
      None -> 4096 - count

  -- | Original input bytes consumed so far, including the unfinished physical line.
  quoted-printable-decoder-position :: QuotedPrintableDecoder -> Nat
  quoted-printable-decoder-position state = case state of
    DecodeState line count origin error -> origin + count

  -- | Copy a private physical-line buffer before advancing an immutable state.
  clone-decoder-line :: DecoderLine -> DecoderLine
  clone-decoder-line old = let out = bytes-new 4096 in
    let copied = bytes-copy-range out old 0 0 4096 in out

  -- | Whitespace discarded from the end of every complete or final physical line.
  discard-whitespace :: Nat -> Bool
  discard-whitespace byte = byte == 10 || byte == 13 || byte == 32 || byte == 9

  -- | Find the initialized non-whitespace suffix boundary without reading slack bytes.
  trim-right :: DecoderLine -> InRange 0 4096 Nat -> InRange 0 4096 Nat
  trim-right line count = if count > 0 then
    if discard-whitespace (bytes-get line (count - 1)) then trim-right line ((count - 1) :: Nat) else count
    else count

  -- | Skip only horizontal transport padding after a soft marker.
  skip-horizontal :: using (at <= end, end <= 4096) => DecoderLine -> (at :: Nat) -> (end :: Nat) -> refined (at <= r && r <= end) Nat
  skip-horizontal line at end = if at < end then
    if whitespace (bytes-get line at) then skip-horizontal line (at + 1) end else at
    else at

  -- | Classify one ASCII hexadecimal digit as an unpacked value or the sentinel sixteen.
  hex-value-word :: U8 -> U32
  hex-value-word byte =
    let digit = wrapping-sub-u8 byte 48 in
    if lt-u8 digit 10 then u8-to-u32 digit
    else
      let letter = wrapping-sub-u8 (bit-or-u8 byte 32) 97 in
      if lt-u8 letter 6 then u8-to-u32 (wrapping-add-u8 letter 10)
      else 16

  -- | Decode both bounded bytes with the shared unpacked classifier; 256 means invalid.
  escape-value :: using (at + 3 <= end, end <= 4096) => DecoderLine -> (at :: Nat) -> (end :: Nat) -> U32
  escape-value line at end =
    let high = hex-value-word (bytes-get-u8 line (at + 1)) in
    let low = hex-value-word (bytes-get-u8 line (at + 2)) in
    if lt-u32 high 16 && lt-u32 low 16 then bit-or-u32 (wrapping-shl-u32 high 4) low else 256

  -- | Recover a malformed non-newline escape as literal equals, or retain the precise error.
  decode-equals :: using (at < end, end <= 4096, written <= at) => DecoderLine -> DecoderOutput -> Nat -> (at :: Nat) -> (end :: Nat) -> (written :: InRange 0 4096 Nat) -> DecodeWork
  decode-equals line out origin at end written =
    if at + 1 < end then
      let next = bytes-get line (at + 1) in
      if next /= 13 && next /= 10 then
        let stored = bytes-set out written 61 in
        decode-inline line out origin (at + 1) end ((written + 1) :: Nat)
      else if at + 2 < end then DecodeWork written (Some (QuotedPrintableInvalidHex (origin + at + 1) next))
      else DecodeWork written (Some (QuotedPrintableIncompleteEscape (origin + at)))
    else DecodeWork written (Some (QuotedPrintableIncompleteEscape (origin + at)))

  -- | Decode initialized line content. Complete literal windows classify and copy
  -- in bulk; escapes and the first invalid byte retain ordered scalar behavior.
  decode-inline :: using (at <= end, end <= 4096, written <= at) => DecoderLine -> DecoderOutput -> Nat -> (at :: Nat) -> (end :: Nat) -> (written :: InRange 0 4096 Nat) -> DecodeWork
  decode-inline line out origin at end written =
    if at < end then
      let stop = scan-end 2 line at end in
      if stop > at then
        let count = stop - at in
        let copied = bytes-copy-range out line written at count in
        decode-inline line out origin stop end ((written + count) :: Nat)
      else
        let byte = bytes-get line at in
        if byte == 61 then
          if at + 3 <= end then
            let decoded = u32-to-nat (escape-value line at end) in
            if decoded <= 255 then
              let stored = bytes-set out written decoded in
              decode-inline line out origin (at + 3) end ((written + 1) :: Nat)
            else decode-equals line out origin at end written
          else decode-equals line out origin at end written
        else if good-byte 2 byte then
          let stored = bytes-set out written byte in
          decode-inline line out origin (at + 1) end ((written + 1) :: Nat)
        else DecodeWork written (Some (QuotedPrintableInvalidByte (origin + at) byte))
    else DecodeWork written None

  -- | Validate a trimmed soft marker against transport padding and the actual
  -- end condition. An interrupted source is distinct from genuine EOF.
  soft-error :: using (marker < count, count <= 4096) => DecoderLine -> Nat -> (marker :: Nat) -> (count :: Nat) -> Bool -> Option QuotedPrintableError
  soft-error line origin marker count eof =
    let right = skip-horizontal line (marker + 1) count in
    let lf = right < count && bytes-get line right == 10 in
    let crlf = right + 1 < count && bytes-get line right == 13 && bytes-get line (right + 1) == 10 in
    if lf || crlf || (eof && right == count && marker > 0) then None
    else Some (QuotedPrintableInvalidSoftBreak (origin + marker) (suffix-text (part line right (count - right)) 0))

  -- | Decode one physical line, dropping transport whitespace and restoring only
  -- its hard ending. Inline errors precede a delayed line/source-buffer error.
  decode-physical-line :: DecoderLine -> DecoderOutput -> (count :: InRange 0 4096 Nat) -> Nat -> Bool -> Bool -> (Bytes, Option QuotedPrintableError)
  decode-physical-line line out count origin eof full =
    let trimmed = trim-right line count in
    let soft = trimmed > 0 && bytes-get line (trimmed - 1) == 61 in
    let content = if soft && trimmed > 0 then ((trimmed - 1) :: Nat) else trimmed in
    let error = if soft && trimmed > 0 && trimmed <= count then soft-error line origin (trimmed - 1) count eof else if full then Some (QuotedPrintableLineTooLong (origin + count)) else None in
    if content <= 4096 then
      case decode-inline line out origin 0 content 0 of
        DecodeWork written inlineError -> case inlineError of
          Some failure -> (part out 0 written, Some failure)
          None ->
            let lf = count > 0 && bytes-get line (count - 1) == 10 in
            let crlf = count > 1 && bytes-get line (count - 2) == 13 && bytes-get line (count - 1) == 10 in
            if not soft && lf then
              if crlf then
                let cr = bytes-set out written 13 in
                let nl = bytes-set out (written + 1) 10 in
                (part out 0 (written + 2), error)
              else
                let nl = bytes-set out written 10 in
                (part out 0 (written + 1), error)
            else (part out 0 written, error)
    else (bytes-new 0, Some (QuotedPrintableLineTooLong (origin + count)))

  -- | Lazily allocate one private output scratch per feed, then reuse it
  -- across completed lines. Every emitted prefix is copied before reuse.
  decoder-output :: Option DecoderOutput -> DecoderOutput
  decoder-output output = case output of
    None -> bytes-new 4098
    Some scratch -> scratch

  -- | Fill remaining physical-line capacity in bulk and decode complete lines.
  -- A full non-newline fragment is terminal and does not consume later input.
  decode-feed :: using (at <= bytes-len input) => DecoderLine -> Option DecoderOutput -> InRange 0 4096 Nat -> Nat -> (input :: Bytes) -> (at :: Nat) -> List (Nat, Bytes) -> (Bytes, (Nat, QuotedPrintableDecoder))
  decode-feed line output count origin input at chunks =
    if count == 4096 then
      let scratch = decoder-output output in
      case decode-physical-line line scratch count origin False True of
        (out, error) -> (events-output (reverse (Cons (0, out) chunks)), (at, DecodeState line 0 (origin + count) error))
    else if at < bytes-len input then
      let limit = if bytes-len input < at + (4096 - count) then bytes-len input else at + (4096 - count) in
      if at <= limit && limit <= bytes-len input then
        let stop = scan-end 3 input at limit in
        let end = if stop < limit then stop + 1 else stop in
        if at <= end && end <= limit then
          let take = end - at in
          if take > 0 && count + take <= 4096 then
            let copied = bytes-copy-range line input count at take in
            let next = ((count + take) :: Nat) in
            let lf = end > at && bytes-get input (end - 1) == 10 in
            if lf || next == 4096 then
              let scratch = decoder-output output in
              case decode-physical-line line scratch next origin False (not lf) of
                (out, error) -> case error of
                  Some failure -> (events-output (reverse (Cons (0, out) chunks)), (end, DecodeState line 0 (origin + next) error))
                  None -> decode-feed line (Some scratch) 0 (origin + next) input end (Cons (0, out) chunks)
            else decode-feed line output (next :: Nat) origin input end chunks
          else decode-feed-byte line output count origin input at chunks
        else decode-feed-byte line output count origin input at chunks
      else decode-feed-byte line output count origin input at chunks
    else (events-output (reverse chunks), (at, DecodeState line count origin None))

  -- | Scalar progress for an incomplete SIMD fringe, preserving all capacity checks.
  decode-feed-byte :: using (at < bytes-len input) => DecoderLine -> Option DecoderOutput -> (count :: InRange 0 4096 Nat) -> Nat -> (input :: Bytes) -> (at :: Nat) -> List (Nat, Bytes) -> (Bytes, (Nat, QuotedPrintableDecoder))
  decode-feed-byte line output count origin input at chunks =
    if count < 4096 then
      let byte = bytes-get input at in
      let stored = bytes-set line count byte in
      if byte == 10 || count + 1 == 4096 then
        let scratch = decoder-output output in
        case decode-physical-line line scratch ((count + 1) :: Nat) origin False (byte /= 10) of
          (out, error) -> case error of
            Some failure -> (events-output (reverse (Cons (0, out) chunks)), (at + 1, DecodeState line 0 (origin + count + 1) error))
            None -> decode-feed line (Some scratch) 0 (origin + count + 1) input (at + 1) (Cons (0, out) chunks)
      else decode-feed line output ((count + 1) :: Nat) origin input (at + 1) chunks
    else decode-feed line output count origin input at chunks

  -- | Decode complete physical lines from a feed, returning fresh prefix bytes,
  -- the consumed input count, and an advanced immutable continuation. Input after
  -- a terminal error remains unconsumed; previously returned buffers never alias state.
  quoted-printable-decoder-feed :: QuotedPrintableDecoder -> Bytes -> (Bytes, (Nat, QuotedPrintableDecoder))
  quoted-printable-decoder-feed state input = case state of
    DecodeState old count origin error -> case error of
      Some failure -> (bytes-new 0, (0, state))
      None -> decode-feed (clone-decoder-line old) None count origin input 0 Nil

  -- | End an unfinished physical line, distinguishing genuine EOF from an
  -- interrupted source. A codec error may supersede a pending source failure.
  quoted-printable-decoder-end :: Bool -> QuotedPrintableDecoder -> (Bytes, Option QuotedPrintableError)
  quoted-printable-decoder-end eof state = case state of
    DecodeState line count origin error -> case error of
      Some failure -> (bytes-new 0, error)
      None -> decode-physical-line line (bytes-new 4098) count origin eof False

  -- | Finish at genuine EOF, preserving decoded prefix bytes before a final error.
  quoted-printable-decoder-finish :: QuotedPrintableDecoder -> (Bytes, Option QuotedPrintableError)
  quoted-printable-decoder-finish state = quoted-printable-decoder-end True state

  -- | Decode a complete buffer to fresh bytes and an optional first error.
  quoted-printable-decode-prefix :: Bytes -> (Bytes, Option QuotedPrintableError)
  quoted-printable-decode-prefix input = case quoted-printable-decoder-feed quoted-printable-decoder input of
    (out, pair) -> case pair of
      (consumed, state) -> case quoted-printable-decoder-finish state of
        (tail, error) -> (events-output (Cons (0, out) (Cons (0, tail) Nil)), error)

  -- | Return fresh decoded bytes or the first failure under the decoder
  -- acceptance rules. Lowercase hex and malformed non-newline escapes are accepted.
  -- Use decode-prefix when the successfully decoded bytes before an error matter.
  quoted-printable-decode-bytes :: Bytes -> Result QuotedPrintableError Bytes
  quoted-printable-decode-bytes input = case quoted-printable-decode-prefix input of
    (out, None) -> Ok out
    (out, Some error) -> Err error

  -- | Compute the sixteen-lane invalid-byte mask for text-mode raw encoder bytes.
  text-invalid-lanes :: U128 -> U128
  text-invalid-lanes v =
    let low = simd-u8x16-cmplt v (simd-u8x16-splat 32) in
    let ok-ctl = bit-or-u128 (simd-u8x16-cmpeq v (simd-u8x16-splat 9)) (bit-or-u128 (simd-u8x16-cmpeq v (simd-u8x16-splat 10)) (simd-u8x16-cmpeq v (simd-u8x16-splat 13))) in
    let bad-ctl = bit-and-u128 low (bit-not-u128 ok-ctl) in
    let hi = simd-u8x16-cmpgt v (simd-u8x16-splat 126) in
    let eq-b = simd-u8x16-cmpeq v (simd-u8x16-splat 61) in
    bit-or-u128 (bit-or-u128 bad-ctl hi) eq-b

  -- | Compute the sixteen-lane invalid-byte mask for binary-mode raw encoder bytes.
  binary-invalid-lanes :: U128 -> U128
  binary-invalid-lanes v =
    let bad-ctl = bit-and-u128 (simd-u8x16-cmplt v (simd-u8x16-splat 32)) (bit-not-u128 (simd-u8x16-cmpeq v (simd-u8x16-splat 9))) in
    let hi = simd-u8x16-cmpgt v (simd-u8x16-splat 126) in
    let eq-b = simd-u8x16-cmpeq v (simd-u8x16-splat 61) in
    bit-or-u128 (bit-or-u128 bad-ctl hi) eq-b

  -- | Compute the sixteen-lane invalid-byte mask for decoded body literal runs.
  body-invalid-lanes :: U128 -> U128
  body-invalid-lanes v =
    let low = simd-u8x16-cmplt v (simd-u8x16-splat 32) in
    let ok-ctl = bit-or-u128 (simd-u8x16-cmpeq v (simd-u8x16-splat 9)) (bit-or-u128 (simd-u8x16-cmpeq v (simd-u8x16-splat 10)) (simd-u8x16-cmpeq v (simd-u8x16-splat 13))) in
    let bad-ctl = bit-and-u128 low (bit-not-u128 ok-ctl) in
    let del = simd-u8x16-cmpeq v (simd-u8x16-splat 127) in
    let eq-b = simd-u8x16-cmpeq v (simd-u8x16-splat 61) in
    bit-or-u128 (bit-or-u128 bad-ctl del) eq-b

  -- | Compute the sixteen-lane invalid-byte mask for physical-line scanning up to LF.
  lf-invalid-lanes :: U128 -> U128
  lf-invalid-lanes v = simd-u8x16-cmpeq v (simd-u8x16-splat 10)

  -- | Classify sixteen packed bytes under the selected quoted-printable mode, returning the 16-bit invalid-lane mask.
  classify-sixteen-mask :: U128 -> U8 -> U32
  classify-sixteen-mask v mode =
    if eq-u8 mode 3 then simd-u8x16-movemask (lf-invalid-lanes v)
    else if eq-u8 mode 2 then simd-u8x16-movemask (body-invalid-lanes v)
    else if eq-u8 mode 1 then simd-u8x16-movemask (binary-invalid-lanes v)
    else simd-u8x16-movemask (text-invalid-lanes v)

  -- | Scan text-mode raw encoder bytes (tab, CR, LF, 32..126 excluding '=') sixteen bytes at a time.
  scan-text-at :: Bytes -> I64 -> I64 -> I64
  scan-text-at input i limit =
    let n = bytes-len-i64 input in
    let bound = if lt-i64 limit n then limit else n in
    if 16 <= n && 16 <= bound && 0 <= i && i <= wrapping-sub-i64 bound 16 && i <= wrapping-sub-i64 n 16 then
      let nn = nat-from-i64 n in
      if 16 <= nn then
        let lim = nn - 16 in
        let ni = nat-from-i64 i in
        if ni <= lim then
          let mask = simd-u8x16-movemask (text-invalid-lanes (bytes-load-u128-at input i)) in
          if eq-u32 mask 0 then scan-text-at input (wrapping-add-i64 i 16) limit
          else wrapping-add-i64 i (u32-to-i64 (trailing-zeros-u32 mask))
        else scan-text-tail input i bound
      else scan-text-tail input i bound
    else scan-text-tail input i bound

  -- | Scalar tail for text-mode raw encoder bytes.
  scan-text-tail :: Bytes -> I64 -> I64 -> I64
  scan-text-tail input i bound =
    if 0 <= i && i < bound && i < bytes-len-i64 input then
      let b = bytes-get-u8-at input i in
      if (ge-u8 b 32 && le-u8 b 126 && ne-u8 b 61) || eq-u8 b 9 || eq-u8 b 10 || eq-u8 b 13 then
        scan-text-tail input (wrapping-add-i64 i 1) bound
      else i
    else i

  -- | Scan binary-mode raw encoder bytes (tab and 32..126 excluding '=') sixteen bytes at a time.
  scan-binary-at :: Bytes -> I64 -> I64 -> I64
  scan-binary-at input i limit =
    let n = bytes-len-i64 input in
    let bound = if lt-i64 limit n then limit else n in
    if 16 <= n && 16 <= bound && 0 <= i && i <= wrapping-sub-i64 bound 16 && i <= wrapping-sub-i64 n 16 then
      let nn = nat-from-i64 n in
      if 16 <= nn then
        let lim = nn - 16 in
        let ni = nat-from-i64 i in
        if ni <= lim then
          let mask = simd-u8x16-movemask (binary-invalid-lanes (bytes-load-u128-at input i)) in
          if eq-u32 mask 0 then scan-binary-at input (wrapping-add-i64 i 16) limit
          else wrapping-add-i64 i (u32-to-i64 (trailing-zeros-u32 mask))
        else scan-binary-tail input i bound
      else scan-binary-tail input i bound
    else scan-binary-tail input i bound

  -- | Scalar tail for binary-mode raw encoder bytes.
  scan-binary-tail :: Bytes -> I64 -> I64 -> I64
  scan-binary-tail input i bound =
    if 0 <= i && i < bound && i < bytes-len-i64 input then
      let b = bytes-get-u8-at input i in
      if (ge-u8 b 32 && le-u8 b 126 && ne-u8 b 61) || eq-u8 b 9 then
        scan-binary-tail input (wrapping-add-i64 i 1) bound
      else i
    else i

  -- | Scan decoded body literal runs (tab, CR, LF, and bytes >= 32 excluding '=' and DEL) sixteen bytes at a time.
  scan-body-at :: Bytes -> I64 -> I64 -> I64
  scan-body-at input i limit =
    let n = bytes-len-i64 input in
    let bound = if lt-i64 limit n then limit else n in
    if 16 <= n && 16 <= bound && 0 <= i && i <= wrapping-sub-i64 bound 16 && i <= wrapping-sub-i64 n 16 then
      let nn = nat-from-i64 n in
      if 16 <= nn then
        let lim = nn - 16 in
        let ni = nat-from-i64 i in
        if ni <= lim then
          let mask = simd-u8x16-movemask (body-invalid-lanes (bytes-load-u128-at input i)) in
          if eq-u32 mask 0 then scan-body-at input (wrapping-add-i64 i 16) limit
          else wrapping-add-i64 i (u32-to-i64 (trailing-zeros-u32 mask))
        else scan-body-tail input i bound
      else scan-body-tail input i bound
    else scan-body-tail input i bound

  -- | Scalar tail for decoded body literal runs.
  scan-body-tail :: Bytes -> I64 -> I64 -> I64
  scan-body-tail input i bound =
    if 0 <= i && i < bound && i < bytes-len-i64 input then
      let b = bytes-get-u8-at input i in
      if ne-u8 b 61 && ((ge-u8 b 32 && ne-u8 b 127) || eq-u8 b 9 || eq-u8 b 13 || eq-u8 b 10) then
        scan-body-tail input (wrapping-add-i64 i 1) bound
      else i
    else i

  -- | Scan physical-line bytes up to the next LF sixteen bytes at a time.
  scan-lf-at :: Bytes -> I64 -> I64 -> I64
  scan-lf-at input i limit =
    let n = bytes-len-i64 input in
    let bound = if lt-i64 limit n then limit else n in
    if 16 <= n && 16 <= bound && 0 <= i && i <= wrapping-sub-i64 bound 16 && i <= wrapping-sub-i64 n 16 then
      let nn = nat-from-i64 n in
      if 16 <= nn then
        let lim = nn - 16 in
        let ni = nat-from-i64 i in
        if ni <= lim then
          let mask = simd-u8x16-movemask (lf-invalid-lanes (bytes-load-u128-at input i)) in
          if eq-u32 mask 0 then scan-lf-at input (wrapping-add-i64 i 16) limit
          else wrapping-add-i64 i (u32-to-i64 (trailing-zeros-u32 mask))
        else scan-lf-tail input i bound
      else scan-lf-tail input i bound
    else scan-lf-tail input i bound

  -- | Scalar tail for physical-line scanning up to the next LF.
  scan-lf-tail :: Bytes -> I64 -> I64 -> I64
  scan-lf-tail input i bound =
    if 0 <= i && i < bound && i < bytes-len-i64 input then
      if ne-u8 (bytes-get-u8-at input i) 10 then scan-lf-tail input (wrapping-add-i64 i 1) bound else i
    else i
