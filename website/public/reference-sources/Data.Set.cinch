-- Data.Set: the ordered set.
--
-- A height-augmented AVL tree over `Ord a`: `set-insert` keeps the
-- left subtree strictly smaller and the right strictly greater (so a
-- repeated element keeps one copy) and rebalances on the way out, so
-- the operations are O(log n) and the tree is never deeper than
-- ~1.44 log2(n). The earlier family was the documented UNBALANCED
-- bootstrap BST (decision D105's shape, "a balanced tree is a later
-- family, same surface"): this is that later family, and the
-- observable semantics are exactly as before (a repeated element
-- keeps one copy, insert/lookup round trip, `set-to-list` lists the
-- tree's elements in ascending order, each exactly once).
--
-- The node carries its cached height (`Bin h x l r`): the balanced
-- family needs O(1) balance metadata, so the bootstrap's three-field
-- node grows its height field (an observable shape change, reported
-- with P34; the operations' semantics are unchanged and no test
-- constructs a node by hand). A hand-built `Bin` tree is still a
-- correct search tree for every operation (`set-member`,
-- `set-to-list`, `set-size` never read heights), and `set-insert`
-- repairs the heights along the path it rebuilds; heights a hand-built
-- node lies about may cost it a rebalance, never correctness.
--
-- Named refusals (boundaries this module deliberately does not
-- cross):
--   an arbitrary-height join: `balance` fixes subtrees that differ by
--     at most two levels, so the ordered operations that drop a node
--     rejoin through the right subtree's minimum (`set-glue`), and
--     `set-filter`/`set-map` rebuild through `set-from-list` rather
--     than a structural rejoin. That rebuild is why `set-filter`
--     states `Ord a` where Data.Set's `filter` needs nothing;
--   a size-augmented node: the node carries the height (AVL), so
--     `set-size` stays the O(n) walk it has always been.
--
-- The bootstrap's deletion and union refusals are over: the family now
-- ships `set-delete`, `set-union`, `set-intersection`,
-- `set-difference`, `set-subset`, `set-map`, `set-filter` and
-- `set-fold` (the union behavior the bootstrap asserted test-locally
-- in compiler/tests/prelude_split.rs is now the family's own).
--
-- Module scheme (design/base-library.md): the type's home carries its
-- `FromList` instance (`[a, b, c]` at `Set a` folds `set-insert`).
module Data.Set where

  export Set, Tip, Bin, set-empty, set-insert, set-member, set-to-list, set-size, set-from-list
  export set-delete, set-is-empty, set-union, set-intersection, set-difference, set-subset
  export set-map, set-filter, set-fold

  -- The ordered set: a height-augmented AVL tree over `Ord a`.
  data Set a where
    Tip :: Set a
    Bin :: Nat -> a -> Set a -> Set a -> Set a

  set-empty :: forall a. Set a
  set-empty = Tip

  -- A node's cached height (leaves are height 0).
  set-height :: forall a. Set a -> Nat
  set-height s = case s of
    Tip -> 0
    Bin h _ _ _ -> h

  -- The node with its height computed from the subtrees: every
  -- rebuild on the insert path goes through here, so heights stay
  -- honest over the shapes `set-insert` builds.
  bin :: forall a. a -> Set a -> Set a -> Set a
  bin x l r = case set-height l < set-height r of
    True -> Bin (1 + set-height r) x l r
    False -> Bin (1 + set-height l) x l r

  -- Rebalance a node whose subtrees' heights differ by at most two
  -- after an insertion (the AVL fixup: a single rotation for the
  -- outer case, a double rotation for the inner one).
  balance :: forall a. a -> Set a -> Set a -> Set a
  balance x l r =
    let hl = set-height l in
    let hr = set-height r in
    if hr + 1 < hl then rotate-right x l r
    else if hl + 1 < hr then rotate-left x l r
    else bin x l r

  -- The left-heavy case.
  rotate-right :: forall a. a -> Set a -> Set a -> Set a
  rotate-right x l r = case l of
    Tip -> bin x l r
    Bin _ y ll lr -> case set-height lr <= set-height ll of
      True -> bin y ll (bin x lr r)
      False -> case lr of
        Tip -> bin x l r
        Bin _ z lrl lrr -> bin z (bin y ll lrl) (bin x lrr r)

  -- The right-heavy case (symmetric).
  rotate-left :: forall a. a -> Set a -> Set a -> Set a
  rotate-left x l r = case r of
    Tip -> bin x l r
    Bin _ y rl rr -> case set-height rl >= set-height rr of
      True -> bin y (bin x l rl) rr
      False -> case rl of
        Tip -> bin x l r
        Bin _ z rll rrr -> bin z (bin x l rll) (bin y rrr rr)

  set-insert :: forall a. using (ord :: Ord a) => a -> Set a -> Set a
  set-insert x s = case s of
    Tip -> bin x Tip Tip
    Bin _ y l r ->
      if x < y then balance y (set-insert x l) r
      else if y < x then balance y l (set-insert x r)
      else bin x l r

  set-member :: forall a. using (ord :: Ord a) => a -> Set a -> Bool
  set-member x s = case s of
    Tip -> False
    Bin _ y l r ->
      if x < y then set-member x l
      else if y < x then set-member x r
      else True

  -- The elements in ascending order, each exactly once.
  set-to-list-into :: forall a. Set a -> List a -> List a
  set-to-list-into s acc = case s of
    Tip -> acc
    Bin _ y l r -> set-to-list-into l (Cons y (set-to-list-into r acc))

  set-to-list :: forall a. Set a -> List a
  set-to-list s = set-to-list-into s Nil

  set-size :: forall a. Set a -> Nat
  set-size s = case s of
    Tip -> 0
    Bin _ _ l r -> 1 + set-size l + set-size r

  set-from-list :: forall a. using (ord :: Ord a) => List a -> Set a
  set-from-list xs = case xs of
    Nil -> Tip
    Cons y ys -> set-insert y (set-from-list ys)

  -- Removal: the search descends as `set-member` does, and a found
  -- node's subtrees rejoin through the right subtree's smallest element
  -- (the AVL delete), so the height invariant survives. An absent
  -- element rebuilds the same tree.
  set-delete :: forall a. using (ord :: Ord a) => a -> Set a -> Set a
  set-delete x s = case s of
    Tip -> Tip
    Bin _ y l r ->
      if x < y then balance y (set-delete x l) r
      else if y < x then balance y l (set-delete x r)
      else set-glue l r

  -- Rejoin two trees where every element of the first is below every
  -- element of the second: the right tree's smallest element becomes
  -- the root. The node a delete or filter dropped took one level from
  -- each side at most, so the subtrees handed to `balance` differ by at
  -- most two levels, exactly what it fixes.
  set-glue :: forall a. Set a -> Set a -> Set a
  set-glue l r = case set-min r of
    None -> l
    Some y -> balance y l (set-delete-min r)

  -- The smallest element, read down the left spine (no comparison).
  set-min :: forall a. Set a -> Option a
  set-min s = case s of
    Tip -> None
    Bin _ y l _ -> case l of
      Tip -> Some y
      Bin _ _ _ _ -> set-min l

  -- The same tree without its smallest element, rebalancing on the way
  -- back up.
  set-delete-min :: forall a. Set a -> Set a
  set-delete-min s = case s of
    Tip -> Tip
    Bin _ y l r -> case l of
      Tip -> r
      Bin _ _ _ _ -> balance y (set-delete-min l) r

  -- Named `set-is-empty` because the bare `is-empty` is the list's
  -- (`List a -> Bool`) and there is no overloading to share one
  -- spelling; the module prefix is how the family disambiguates.
  set-is-empty :: forall a. Set a -> Bool
  set-is-empty s = case s of
    Tip -> True
    Bin _ _ _ _ -> False

  -- The union inserts the left set's ascending listing into the right;
  -- `set-insert` keeps one copy per element and rebalances, so the
  -- result is a proper AVL tree. The result is symmetric in its
  -- elements but the cost is not: O(m log n) for m and n elements.
  set-union :: forall a. using (ord :: Ord a) => Set a -> Set a -> Set a
  set-union a b = set-insert-all (set-to-list a) b

  set-insert-all :: forall a. using (ord :: Ord a) => List a -> Set a -> Set a
  set-insert-all xs s = case xs of
    Nil -> s
    Cons y ys -> set-insert-all ys (set-insert y s)

  -- The elements of the left set that the right set also holds.
  set-intersection :: forall a. using (ord :: Ord a) => Set a -> Set a -> Set a
  set-intersection a b = set-keep-member (set-to-list a) b set-empty

  set-keep-member :: forall a. using (ord :: Ord a) => List a -> Set a -> Set a -> Set a
  set-keep-member xs b acc = case xs of
    Nil -> acc
    Cons y ys -> case set-member y b of
      True -> set-keep-member ys b (set-insert y acc)
      False -> set-keep-member ys b acc

  -- The elements of the left set that the right set does NOT hold.
  set-difference :: forall a. using (ord :: Ord a) => Set a -> Set a -> Set a
  set-difference a b = set-drop-member (set-to-list a) b set-empty

  set-drop-member :: forall a. using (ord :: Ord a) => List a -> Set a -> Set a -> Set a
  set-drop-member xs b acc = case xs of
    Nil -> acc
    Cons y ys -> case set-member y b of
      True -> set-drop-member ys b acc
      False -> set-drop-member ys b (set-insert y acc)

  -- Whether every element of the first set is in the second (Data.Set's
  -- `isSubsetOf`, kept under the module prefix, which is how every
  -- other ordered operation here names itself).
  set-subset :: forall a. using (ord :: Ord a) => Set a -> Set a -> Bool
  set-subset a b = set-subset-of (set-to-list a) b

  set-subset-of :: forall a. using (ord :: Ord a) => List a -> Set a -> Bool
  set-subset-of xs b = case xs of
    Nil -> True
    Cons y ys -> if set-member y b then set-subset-of ys b else False

  -- The image of a set under a function (Data.Set's `map`): every
  -- element is rewritten and reinserted, so two elements that collide
  -- keep one copy and the result is ordered by the NEW values, hence
  -- `Ord b` and never `Ord a`.
  set-map :: forall a b. using (ord :: Ord b) => (a -> b) -> Set a -> Set b
  set-map f s = set-from-list (map f (set-to-list s))

  -- The elements the predicate accepts, rebuilt from the surviving
  -- ascending listing. The rebuild is why this states `Ord a` where
  -- Data.Set's `filter` needs nothing: `balance` only fixes subtrees
  -- that differ by at most two levels, so a structural filter (which
  -- can empty one whole side) has no join to use and reinserts
  -- instead. The rebuild also means duplicates cannot appear and the
  -- ascending order is re-derived.
  set-filter :: forall a. using (ord :: Ord a) => (a -> Bool) -> Set a -> Set a
  set-filter p s = set-from-list (set-keep-if p (set-to-list s))

  set-keep-if :: forall a. (a -> Bool) -> List a -> List a
  set-keep-if p xs = case xs of
    Nil -> Nil
    Cons y ys -> case p y of
      True -> Cons y (set-keep-if p ys)
      False -> set-keep-if p ys

  -- A RIGHT fold in ascending order (Data.Set's `foldr`): folding with
  -- `Cons` rebuilds `set-to-list`, and the empty set is the identity.
  set-fold :: forall a b. (a -> b -> b) -> b -> Set a -> b
  set-fold f z s = case s of
    Tip -> z
    Bin _ y l r -> set-fold f (f y (set-fold f z r)) l

  -- Collection literals at `Set` (surface grammar local amendments
  -- section 10).
  implicit instance FromList_Set a :: using (ord :: Ord a) => FromList (Set a) a where
    from-list xs = set-from-list xs
