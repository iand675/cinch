  -- | Exponential strip i: the width per unit of the unsigned 32-bit position.
  exp-w :: U64 -> F32
  exp-w i = if eq-u64 (bit-and-u64 i 128) 0 then exp-w-lo i else exp-w-hi i

  -- | Exponential strip i: the density at the strip's outer edge. (strips 0..127).
