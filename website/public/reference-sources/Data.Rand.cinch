-- | Pseudorandom generation over explicit sources: the PCG and ChaCha8 generators, and every distribution a
-- program needs from them (uniform integers in a range, floats in [0, 1), permutations and shuffles, standard
-- normal and exponential variates, and Zipf-distributed integers).
--
-- A source is any value that yields a 64-bit draw together with the source to draw from next (the Source
-- signature); PCG and ChaCha8 are instances. Every function takes a source and returns its result with the next
-- source, so generation is deterministic and replayable, and different parts of a program can hold independent
-- streams. Seed sources from Effect.Random when unpredictability matters; ChaCha8 is the one to use when the
-- outputs must also be hard to predict from earlier outputs.
--
-- PCG is the 128-bit linear congruential generator with the DXSM ("double xorshift multiply") output function:
-- one 128-bit multiply-add per draw and the reference generator's constants and encoding. Bounded integers use
-- Lemire's multiply-and-reject method (an unbiased result from one 64x64-bit product, redrawing only when the
-- low half lands in the biased sliver), with a mask for powers of two; results are those of a 64-bit host.
-- Normal and exponential variates use the Marsaglia-Tsang ziggurat with 128 and 256 strips; the tables are
-- derived from the construction by tooling/generate_rand_kernels.py and read as constant vectors. Zipf variates
-- use rejection-inversion. Outputs match the reference generators draw for draw.
--
-- Cost: each draw returns a new source value, and the current compiler boxes it (a single-field wrapper, or a
-- pair holding a 128-bit word, is a small heap object), so a draw costs one allocation: about 25 ns per raw
-- PCG draw on amd64, where the reference's mutable generator takes about 2 ns. The arithmetic itself is one
-- 128-bit multiply-add and the DXSM fold.
module Data.Rand where

  import Data.Bytes
  import Data.Bytes.Word
  import Data.Array
  import Data.ChaCha8
  import Data.Float
  import Data.List
  import Data.Nat
  import Data.Option
  import Data.Result

  export Source, source-uint64
  export Pcg, PcgError, PcgBadEncoding, pcg-error-message, pcg-new, pcg-seed, pcg-uint64, pcg-marshal, pcg-unmarshal
  export rand-uint64, rand-int64, rand-uint32, rand-int32, rand-uint64-n, rand-int64-n, rand-uint32-n, rand-int32-n
  export rand-float64, rand-float32, rand-perm, rand-shuffle, rand-norm-float64, rand-exp-float64
  export Zipf, zipf-new, zipf-uint64

  -- ---------------------------------------------------------------------
  -- Sources.
  -- ---------------------------------------------------------------------

  -- | A source of uniformly distributed 64-bit values: a draw and the source to draw from next.
  signature Source s where
    -- | The next uniform 64-bit value and the source after it.
    source-uint64 :: s -> (U64, s)

  -- | The PCG generator's 128-bit state.
  data Pcg where
    -- | The state, high word first.
    Pcg :: U128 -> Pcg

  -- | Why a PCG encoding was refused.
  data PcgError where
    -- | Not 20 bytes beginning "pcg:".
    PcgBadEncoding :: PcgError

  -- | A readable description of an error.
  pcg-error-message :: PcgError -> String
  pcg-error-message e = case e of PcgBadEncoding -> "invalid PCG encoding"

  -- | Two words as a 128-bit value, the first high.
  prim pack128 :: U64 -> U64 -> U128 where
    llvm {
      %h = zext i64 %0 to i128
      %l = zext i64 %1 to i128
      %s = shl i128 %h, 64
      %r = or i128 %s, %l
      ret i128 %r
    }

  -- | The high word of a 128-bit value.
  prim high64 :: U128 -> U64 where
    llvm {
      %s = lshr i128 %0, 64
      %h = trunc i128 %s to i64
      ret i64 %h
    }

  -- | The low word of a 128-bit value.
  prim low64 :: U128 -> U64 where
    llvm {
      %l = trunc i128 %0 to i64
      ret i64 %l
    }

  -- | One PCG step: state * 0x2360ED051FC65DA44385DF649FCCF645 + 0x5851F42D4C957F2D14057B7EF767814F, mod 2^128.
  prim pcg-advance :: U128 -> U128 where
    llvm {
      %m = mul i128 %0, 47026247687942121848144207491837523525
      %s = add i128 %m, 117397592171526113268558934119004209487
      ret i128 %s
    }

  -- | The DXSM output of a state: the high word folded and multiplied by a constant and by the odd low word.
  prim pcg-dxsm :: U128 -> U64 where
    llvm {
      %s = lshr i128 %0, 64
      %hi = trunc i128 %s to i64
      %lo = trunc i128 %0 to i64
      %a = lshr i64 %hi, 32
      %b = xor i64 %hi, %a
      %c = mul i64 %b, 15750249268501108917
      %d = lshr i64 %c, 48
      %e = xor i64 %c, %d
      %f = or i64 %lo, 1
      %g = mul i64 %e, %f
      ret i64 %g
    }

  -- | A PCG generator from two seed words (the state's high and low halves).
  pcg-new :: U64 -> U64 -> Pcg
  pcg-new seed1 seed2 = Pcg (pack128 seed1 seed2)

  -- | The generator reseeded with two words (the same as a new generator).
  pcg-seed :: Pcg -> U64 -> U64 -> Pcg
  pcg-seed p seed1 seed2 = pcg-new seed1 seed2

  -- | The next 64-bit value and generator.
  pcg-uint64 :: Pcg -> (U64, Pcg)
  pcg-uint64 p = case p of Pcg s -> let t = pcg-advance s in (pcg-dxsm t, Pcg t)

  -- | The state encoding: "pcg:" and the two halves big-endian (20 bytes).
  pcg-marshal :: Pcg -> Bytes
  pcg-marshal p = case p of
    Pcg s ->
      let out = bytes-new 20 in
      let a = put-tag out in
      let b = (if 12 <= bytes-len out then bytes-write-le64 out 4 (swap-bytes-u64 (high64 s)) else ()) in
      let c = (if 20 <= bytes-len out then bytes-write-le64 out 12 (swap-bytes-u64 (low64 s)) else ()) in
      out

  -- | Write the "pcg:" tag.
  put-tag :: Bytes -> Unit
  put-tag out = if 4 <= bytes-len out then (let a = bytes-set out 0 112 in let b = bytes-set out 1 99 in let c = bytes-set out 2 103 in bytes-set out 3 58) else ()

  -- | A generator from its encoding.
  pcg-unmarshal :: Bytes -> Result PcgError Pcg
  pcg-unmarshal b =
    if not (bytes-len b == 20) then Err PcgBadEncoding
    else if not (bytes-get b 0 == 112 && bytes-get b 1 == 99 && bytes-get b 2 == 103 && bytes-get b 3 == 58) then Err PcgBadEncoding
    else Ok (Pcg (pack128 (swap-bytes-u64 (bytes-read-le64 b 4)) (swap-bytes-u64 (bytes-read-le64 b 12))))

  -- | PCG as a source.
  implicit instance Source_Pcg :: Source Pcg where
    source-uint64 p = pcg-uint64 p

  -- | ChaCha8 as a source.
  implicit instance Source_ChaCha8 :: Source ChaCha8 where
    source-uint64 g = chacha8-uint64 g

  -- ---------------------------------------------------------------------
  -- Integers.
  -- ---------------------------------------------------------------------

  -- | A uniform 64-bit value.
  rand-uint64 :: forall s. using (src :: Source s) => s -> (U64, s)
  rand-uint64 g = source-uint64 g

  -- | A uniform non-negative 64-bit integer (63 random bits).
  rand-int64 :: forall s. using (src :: Source s) => s -> (I64, s)
  rand-int64 g = case source-uint64 g of (x, h) -> (wrapping-u64-to-i64 (wrapping-shr-u64 (wrapping-shl-u64 x 1) 1), h)

  -- | A uniform 32-bit value (the draw's high half).
  rand-uint32 :: forall s. using (src :: Source s) => s -> (U32, s)
  rand-uint32 g = case source-uint64 g of (x, h) -> (wrapping-u64-to-u32 (wrapping-shr-u64 x 32), h)

  -- | A uniform non-negative 32-bit integer (31 random bits).
  rand-int32 :: forall s. using (src :: Source s) => s -> (I32, s)
  rand-int32 g = case source-uint64 g of (x, h) -> (wrapping-u64-to-i32 (wrapping-shr-u64 x 33), h)

  -- | The high word of a 64 by 64-bit product.
  prim mul-high :: U64 -> U64 -> U64 where
    llvm {
      %a = zext i64 %0 to i128
      %b = zext i64 %1 to i128
      %p = mul i128 %a, %b
      %s = lshr i128 %p, 64
      %h = trunc i128 %s to i64
      ret i64 %h
    }

  -- | The unsigned remainder (the divisor is nonzero).
  prim rem-u64 :: U64 -> U64 -> U64 where
    llvm {
      %r = urem i64 %0, %1
      ret i64 %r
    }

  -- | A uniform value in [0, n) for n > 0: a mask for powers of two, otherwise multiply and reject.
  uint64n :: forall s. using (src :: Source s) => s -> U64 -> (U64, s)
  uint64n g n =
    if eq-u64 (bit-and-u64 n (wrapping-sub-u64 n 1)) 0 then (case source-uint64 g of (x, h) -> (bit-and-u64 x (wrapping-sub-u64 n 1), h))
    else (case source-uint64 g of (x, h) -> lemire h n (mul-high x n) (wrapping-mul-u64 x n))

  -- | Accept the product unless its low half falls below n, where the threshold decides.
  lemire :: forall s. using (src :: Source s) => s -> U64 -> U64 -> U64 -> (U64, s)
  lemire g n hi lo = if lt-u64 lo n then lemire-retry g n hi lo (rem-u64 (wrapping-neg-u64 n) n) else (hi, g)

  -- | Redraw while the low half is below the threshold 2^64 mod n.
  lemire-retry :: forall s. using (src :: Source s) => s -> U64 -> U64 -> U64 -> U64 -> (U64, s)
  lemire-retry g n hi lo thresh =
    if lt-u64 lo thresh then (case source-uint64 g of (x, h) -> lemire-retry h n (mul-high x n) (wrapping-mul-u64 x n) thresh)
    else (hi, g)

  -- | A uniform value in [0, n), or None when n is 0.
  rand-uint64-n :: forall s. using (src :: Source s) => s -> U64 -> Option (U64, s)
  rand-uint64-n g n = if eq-u64 n 0 then None else Some (uint64n g n)

  -- | A uniform integer in [0, n), or None when n is not positive.
  rand-int64-n :: forall s. using (src :: Source s) => s -> I64 -> Option (I64, s)
  rand-int64-n g n = if le-i64 n 0 then None else (case uint64n g (wrapping-i64-to-u64 n) of (x, h) -> Some (wrapping-u64-to-i64 x, h))

  -- | A uniform 32-bit value in [0, n), or None when n is 0.
  rand-uint32-n :: forall s. using (src :: Source s) => s -> U32 -> Option (U32, s)
  rand-uint32-n g n = if eq-u32 n 0 then None else (case uint64n g (u32-to-u64 n) of (x, h) -> Some (wrapping-u64-to-u32 x, h))

  -- | A uniform 32-bit integer in [0, n), or None when n is not positive.
  rand-int32-n :: forall s. using (src :: Source s) => s -> I32 -> Option (I32, s)
  rand-int32-n g n = if le-i32 n 0 then None else (case uint64n g (wrapping-i32-to-u64 n) of (x, h) -> Some (wrapping-u64-to-i32 x, h))

  -- ---------------------------------------------------------------------
  -- Floats.
  -- ---------------------------------------------------------------------

  -- | A uniform value in [0, 1) with 53 random bits.
  rand-float64 :: forall s. using (src :: Source s) => s -> (F64, s)
  rand-float64 g = case source-uint64 g of (x, h) -> (mul-f64 (u64-to-f64 (wrapping-shr-u64 (wrapping-shl-u64 x 11) 11)) (f64-from-bits 0x3CA0000000000000), h)

  -- | A uniform binary32 value in [0, 1) with 24 random bits.
  rand-float32 :: forall s. using (src :: Source s) => s -> (F32, s)
  rand-float32 g = case rand-uint32 g of (x, h) -> (mul-f32 (u32-to-f32 (wrapping-shr-u32 (wrapping-shl-u32 x 8) 8)) (f32-from-bits 0x33800000), h)

  -- ---------------------------------------------------------------------
  -- Permutations.
  -- ---------------------------------------------------------------------

  -- | A Nat index from a small machine value.
  index :: U64 -> Nat
  index w = nat-from-i64 (mask-i64 (wrapping-u64-to-i64 w) 9223372036854775807)

  -- | A random permutation of 0 .. n-1.
  rand-perm :: forall s. using (src :: Source s) => s -> Nat -> (List I64, s)
  rand-perm g n = case shuffled g n of (buf, h) -> (perm-list buf 0 n Nil, h)

  -- | The list's elements in a uniformly random order (the same order rand-perm's indices give).
  rand-shuffle :: forall a s. using (src :: Source s) => s -> List a -> (List a, s)
  rand-shuffle g xs = let items = array-from-list xs in case shuffled g (list-length xs) of (buf, h) -> (gather items buf 0 (list-length xs), h)

  -- | The Fisher-Yates swaps applied to the identity: entry i of the result is the source index for slot i.
  shuffled :: forall s. using (src :: Source s) => s -> Nat -> (Bytes, s)
  shuffled g n = let buf = identity n in (buf, swaps g buf (if n > 0 then n - 1 else 0))

  -- | Indices 0 .. n-1 as little-endian words.
  identity :: Nat -> Bytes
  identity n = let buf = bytes-new (8 * n) in let f = fill buf 0 n in buf

  -- | Store i at slot i from an index.
  fill :: Bytes -> Nat -> Nat -> Unit
  fill buf i n = if i >= n then () else let w = (if 8 * i + 8 <= bytes-len buf then bytes-write-le64 buf (8 * i) (wrapping-i64-to-u64 (nat-to-i64-or i)) else ()) in fill buf (i + 1) n

  -- | A small Nat as a machine integer.
  nat-to-i64-or :: Nat -> I64
  nat-to-i64-or n = if n < 4611686018427387904 then nat-to-i64 n else 0

  -- | Swap slot i with a uniform slot in [0, i], for i from the top down to 1.
  swaps :: forall s. using (src :: Source s) => s -> Bytes -> Nat -> s
  swaps g buf i = if i == 0 then g else (case uint64n g (wrapping-i64-to-u64 (nat-to-i64-or (i + 1))) of (j, h) -> let s = swap buf i (index j) in swaps h buf (i - 1))

  -- | Exchange two slots.
  swap :: Bytes -> Nat -> Nat -> Unit
  swap buf i j =
    if 8 * i + 8 <= bytes-len buf && 8 * j + 8 <= bytes-len buf then
      (let a = bytes-read-le64 buf (8 * i) in let b = bytes-read-le64 buf (8 * j) in let x = bytes-write-le64 buf (8 * i) b in bytes-write-le64 buf (8 * j) a)
    else ()

  -- | Slots from the top down, consed into a list.
  perm-list :: Bytes -> Nat -> Nat -> List I64 -> List I64
  perm-list buf i n acc = if i >= n then reverse acc else perm-list buf (i + 1) n (Cons (slot buf i) acc)

  -- | The index at a slot.
  slot :: Bytes -> Nat -> I64
  slot buf i = if 8 * i + 8 <= bytes-len buf then wrapping-u64-to-i64 (bytes-read-le64 buf (8 * i)) else 0

  -- | The elements in slot order.
  gather :: forall a. Array a -> Bytes -> Nat -> Nat -> List a
  gather items buf i n = if i >= n then Nil else (case array-get items (index (wrapping-i64-to-u64 (slot buf i))) of
    Some x -> Cons x (gather items buf (i + 1) n)
    None -> gather items buf (i + 1) n)

  -- ---------------------------------------------------------------------
  -- Normal and exponential variates.
  -- ---------------------------------------------------------------------

  -- | The ziggurat's base strip edge for the normal distribution.
  normal-edge :: F64
  normal-edge = f64-from-bits 0x400B8A7C476D2BE8

  -- | Its reciprocal.
  normal-edge-inverse :: F64
  normal-edge-inverse = f64-from-bits 0x3FD2972A8AFC6175

  -- | The ziggurat's base strip edge for the exponential distribution.
  exp-edge :: F64
  exp-edge = f64-from-bits 0x401EC9D9297EBB83

  -- | A standard normal variate (mean 0, standard deviation 1).
  rand-norm-float64 :: forall s. using (src :: Source s) => s -> (F64, s)
  rand-norm-float64 g = case source-uint64 g of (u, h) -> normal-try u h

  -- | One ziggurat attempt from a draw: strip i from bits 32-38, a signed 32-bit position from the low bits.
  normal-try :: forall s. using (src :: Source s) => U64 -> s -> (F64, s)
  normal-try u h =
    let j = wrapping-u64-to-i32 u in
    let i = bit-and-u64 (wrapping-shr-u64 u 32) 127 in
    let x = mul-f64 (i32-to-f64 j) (f32-to-f64 (normal-w i)) in
    if lt-u32 (abs-u32 j) (normal-k i) then (x, h)
    else if eq-u64 i 0 then normal-base (gt-i32 j 0) h
    else normal-wedge i x h

  -- | The magnitude of a 32-bit integer as unsigned.
  abs-u32 :: I32 -> U32
  abs-u32 j = wrapping-i32-to-u32 (if lt-i32 j 0 then wrapping-neg-i32 j else j)

  -- | The wedge test under the density for strips above the base.
  normal-wedge :: forall s. using (src :: Source s) => U64 -> F64 -> s -> (F64, s)
  normal-wedge i x h = case rand-float64 h of
    (r, h2) -> if flt-f32 (add-f32 (normal-f i) (mul-f32 (f64-to-f32 r) (sub-f32 (normal-f (wrapping-sub-u64 i 1)) (normal-f i)))) (f64-to-f32 (exp-f64 (mul-f64 (mul-f64 (f64-from-bits 0xBFE0000000000000) x) x))) then (x, h2) else rand-norm-float64 h2

  -- | The tail beyond the base strip, by Marsaglia's exponential rejection.
  normal-base :: forall s. using (src :: Source s) => Bool -> s -> (F64, s)
  normal-base positive h = case rand-float64 h of
    (r1, h1) -> (case rand-float64 h1 of
      (r2, h2) -> normal-tail positive (mul-f64 (neg-f64 (log-f64 r1)) normal-edge-inverse) (neg-f64 (log-f64 r2)) h2)

  -- | Accept the tail point when 2y >= x^2.
  normal-tail :: forall s. using (src :: Source s) => Bool -> F64 -> F64 -> s -> (F64, s)
  normal-tail positive x y h =
    if fge-f64 (add-f64 y y) (mul-f64 x x) then (if positive then add-f64 normal-edge x else sub-f64 (neg-f64 normal-edge) x, h)
    else normal-base positive h

  -- | A standard exponential variate (rate 1).
  rand-exp-float64 :: forall s. using (src :: Source s) => s -> (F64, s)
  rand-exp-float64 g = case source-uint64 g of (u, h) -> exp-try u h

  -- | One ziggurat attempt: strip i from bits 32-39, an unsigned 32-bit position from the low bits.
  exp-try :: forall s. using (src :: Source s) => U64 -> s -> (F64, s)
  exp-try u h =
    let j = wrapping-u64-to-u32 u in
    let i = bit-and-u64 (wrapping-shr-u64 u 32) 255 in
    let x = mul-f64 (u32-to-f64 j) (f32-to-f64 (exp-w i)) in
    if lt-u32 j (exp-k i) then (x, h)
    else if eq-u64 i 0 then (case rand-float64 h of (r, h2) -> (sub-f64 exp-edge (log-f64 r), h2))
    else exp-wedge i x h

  -- | The wedge test under the density for strips above the base.
  exp-wedge :: forall s. using (src :: Source s) => U64 -> F64 -> s -> (F64, s)
  exp-wedge i x h = case rand-float64 h of
    (r, h2) -> if flt-f32 (add-f32 (exp-f i) (mul-f32 (f64-to-f32 r) (sub-f32 (exp-f (wrapping-sub-u64 i 1)) (exp-f i)))) (f64-to-f32 (exp-f64 (neg-f64 x))) then (x, h2) else rand-exp-float64 h2

  -- ---------------------------------------------------------------------
  -- Zipf variates.
  -- ---------------------------------------------------------------------

  -- | A Zipf distribution over [0, imax] with P(k) proportional to (v + k)^-s: imax, v, s, the acceptance
  -- slack, 1 - s, its reciprocal, H(imax + 1/2) and H(1/2) - v^-s - H(imax + 1/2).
  data Zipf where
    -- | Fields in the order listed above.
    Zipf :: F64 -> F64 -> F64 -> F64 -> F64 -> F64 -> F64 -> F64 -> Zipf

  -- | The integral H(x) = (v + x)^(1 - s) / (1 - s).
  zipf-h :: F64 -> F64 -> F64 -> F64
  zipf-h one-minus-q v x = mul-f64 (exp-f64 (mul-f64 one-minus-q (log-f64 (add-f64 v x)))) (div-f64 1 one-minus-q)

  -- | Its inverse.
  zipf-hinv :: F64 -> F64 -> F64 -> F64
  zipf-hinv one-minus-q v x = sub-f64 (exp-f64 (mul-f64 (div-f64 1 one-minus-q) (log-f64 (mul-f64 one-minus-q x)))) v

  -- | The distribution for s > 1 and v >= 1 (None otherwise) over [0, imax].
  zipf-new :: F64 -> F64 -> U64 -> Option Zipf
  zipf-new s v imax =
    if fle-f64 s 1 || flt-f64 v 1 then None
    else Some (zipf-build (u64-to-f64 imax) v s (sub-f64 1 s))

  -- | The distribution's constants.
  zipf-build :: F64 -> F64 -> F64 -> F64 -> Zipf
  zipf-build imax v q omq =
    let hxm = zipf-h omq v (add-f64 imax (f64-from-bits 0x3FE0000000000000)) in
    let hx0 = sub-f64 (sub-f64 (zipf-h omq v (f64-from-bits 0x3FE0000000000000)) (exp-f64 (mul-f64 (log-f64 v) (neg-f64 q)))) hxm in
    let slack = sub-f64 1 (zipf-hinv omq v (sub-f64 (zipf-h omq v (f64-from-bits 0x3FF8000000000000)) (exp-f64 (mul-f64 (neg-f64 q) (log-f64 (add-f64 v 1)))))) in
    Zipf imax v q slack omq (div-f64 1 omq) hxm hx0

  -- | A Zipf-distributed integer, by rejection-inversion.
  zipf-uint64 :: forall s. using (src :: Source s) => Zipf -> s -> (U64, s)
  zipf-uint64 z g = case rand-float64 g of
    (r, h) -> (case z of
      Zipf imax v q slack omq omqi hxm hx0 ->
        let ur = add-f64 hxm (mul-f64 r hx0) in
        let x = zipf-hinv omq v ur in
        let k = floor-f64 (add-f64 x (f64-from-bits 0x3FE0000000000000)) in
        if fle-f64 (sub-f64 k x) slack then (saturating-f64-to-u64 k, h)
        else if fge-f64 ur (sub-f64 (zipf-h omq v (add-f64 k (f64-from-bits 0x3FE0000000000000))) (exp-f64 (mul-f64 (neg-f64 (log-f64 (add-f64 k v))) q))) then (saturating-f64-to-u64 k, h)
        else zipf-uint64 z h)

  -- ---------------------------------------------------------------------
  -- Generated ziggurat tables follow (tooling/generate_rand_kernels.py).
  -- ---------------------------------------------------------------------

  -- Generated ziggurat tables.

  -- | Normal strip i: the 31-bit threshold below which a point lies wholly under the density.
  prim normal-k :: U64 -> U32 where
    llvm {
