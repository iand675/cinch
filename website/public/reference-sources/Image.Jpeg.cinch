  -- | Column pass output row 5 from the eight row-pass results, quantized by the eight 16-bit divisors of the last argument with rounding away from zero at halves.
  prim fdct-quant5 :: U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 where
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = sext <8 x i16> %v1 to <8 x i32>
      %v3 = mul <8 x i32> <i32 6437, i32 6437, i32 6437, i32 6437, i32 6437, i32 6437, i32 6437, i32 6437>, %v2
