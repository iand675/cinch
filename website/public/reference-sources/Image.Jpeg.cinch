      %v38 = shufflevector <4 x i8> %v36, <4 x i8> <i8 0, i8 0, i8 0, i8 0>, <8 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7>
      %v39 = shufflevector <8 x i8> %v37, <8 x i8> %v38, <16 x i32> <i32 0, i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15>
      %v40 = shufflevector <16 x i8> %v39, <16 x i8> poison, <16 x i32> <i32 15, i32 14, i32 13, i32 12, i32 11, i32 10, i32 9, i32 8, i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v41 = bitcast <16 x i8> %v40 to i128
      ret i128 %v41
    } when endian big

  -- | Rounded means of the eight 2x2 neighbourhoods spanned by two rows of sixteen chroma samples.
  prim chroma-down :: U128 -> U128 -> U64 where
    llvm {
      %v1 = bitcast i128 %0 to <16 x i8>
      %v2 = zext <16 x i8> %v1 to <16 x i16>
      %v3 = bitcast i128 %1 to <16 x i8>
      %v4 = zext <16 x i8> %v3 to <16 x i16>
      %v5 = add <16 x i16> %v2, %v4
      %v6 = shufflevector <16 x i16> %v5, <16 x i16> poison, <8 x i32> <i32 0, i32 2, i32 4, i32 6, i32 8, i32 10, i32 12, i32 14>
      %v7 = shufflevector <16 x i16> %v5, <16 x i16> poison, <8 x i32> <i32 1, i32 3, i32 5, i32 7, i32 9, i32 11, i32 13, i32 15>
      %v8 = add <8 x i16> %v6, %v7
      %v9 = add <8 x i16> %v8, <i16 2, i16 2, i16 2, i16 2, i16 2, i16 2, i16 2, i16 2>
      %v10 = lshr <8 x i16> %v9, <i16 2, i16 2, i16 2, i16 2, i16 2, i16 2, i16 2, i16 2>
      %v11 = trunc <8 x i16> %v10 to <8 x i8>
      %v12 = bitcast <8 x i8> %v11 to i64
      ret i64 %v12
    } when endian little
    llvm {
      %v1 = bitcast i128 %0 to <16 x i8>
      %v2 = shufflevector <16 x i8> %v1, <16 x i8> poison, <16 x i32> <i32 15, i32 14, i32 13, i32 12, i32 11, i32 10, i32 9, i32 8, i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = zext <16 x i8> %v2 to <16 x i16>
      %v4 = bitcast i128 %1 to <16 x i8>
      %v5 = shufflevector <16 x i8> %v4, <16 x i8> poison, <16 x i32> <i32 15, i32 14, i32 13, i32 12, i32 11, i32 10, i32 9, i32 8, i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v6 = zext <16 x i8> %v5 to <16 x i16>
      %v7 = add <16 x i16> %v3, %v6
      %v8 = shufflevector <16 x i16> %v7, <16 x i16> poison, <8 x i32> <i32 0, i32 2, i32 4, i32 6, i32 8, i32 10, i32 12, i32 14>
      %v9 = shufflevector <16 x i16> %v7, <16 x i16> poison, <8 x i32> <i32 1, i32 3, i32 5, i32 7, i32 9, i32 11, i32 13, i32 15>
      %v10 = add <8 x i16> %v8, %v9
      %v11 = add <8 x i16> %v10, <i16 2, i16 2, i16 2, i16 2, i16 2, i16 2, i16 2, i16 2>
      %v12 = lshr <8 x i16> %v11, <i16 2, i16 2, i16 2, i16 2, i16 2, i16 2, i16 2, i16 2>
      %v13 = trunc <8 x i16> %v12 to <8 x i8>
      %v14 = shufflevector <8 x i8> %v13, <8 x i8> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v15 = bitcast <8 x i8> %v14 to i64
      ret i64 %v15
    } when endian big

  -- | The forward transform's row pass over eight samples, as eight signed 16-bit lanes.
  prim fdct-row :: U64 -> U128 where
    llvm {
      %v1 = bitcast i64 %0 to <8 x i8>
      %v2 = zext <8 x i8> %v1 to <8 x i32>
      %v3 = shufflevector <8 x i32> %v2, <8 x i32> poison, <8 x i32> <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>
      %v4 = mul <8 x i32> %v3, <i32 4, i32 11363, i32 10703, i32 9633, i32 4, i32 6437, i32 4433, i32 2260>
      %v5 = add <8 x i32> <i32 -4096, i32 1024, i32 1024, i32 1024, i32 0, i32 1024, i32 1024, i32 1024>, %v4
      %v6 = shufflevector <8 x i32> %v2, <8 x i32> poison, <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>
      %v7 = mul <8 x i32> %v6, <i32 4, i32 9633, i32 4433, i32 -2259, i32 -4, i32 -11362, i32 -10704, i32 -6436>
      %v8 = add <8 x i32> %v5, %v7
      %v9 = shufflevector <8 x i32> %v2, <8 x i32> poison, <8 x i32> <i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2>
      %v10 = mul <8 x i32> %v9, <i32 4, i32 6437, i32 -4433, i32 -11362, i32 -4, i32 2261, i32 10704, i32 9633>
      %v11 = add <8 x i32> %v8, %v10
      %v12 = shufflevector <8 x i32> %v2, <8 x i32> poison, <8 x i32> <i32 3, i32 3, i32 3, i32 3, i32 3, i32 3, i32 3, i32 3>
      %v13 = mul <8 x i32> %v12, <i32 4, i32 2260, i32 -10703, i32 -6436, i32 4, i32 9633, i32 -4433, i32 -11363>
      %v14 = add <8 x i32> %v11, %v13
      %v15 = shufflevector <8 x i32> %v2, <8 x i32> poison, <8 x i32> <i32 4, i32 4, i32 4, i32 4, i32 4, i32 4, i32 4, i32 4>
      %v16 = mul <8 x i32> %v15, <i32 4, i32 -2260, i32 -10703, i32 6436, i32 4, i32 -9633, i32 -4433, i32 11363>
      %v17 = add <8 x i32> %v14, %v16
      %v18 = shufflevector <8 x i32> %v2, <8 x i32> poison, <8 x i32> <i32 5, i32 5, i32 5, i32 5, i32 5, i32 5, i32 5, i32 5>
      %v19 = mul <8 x i32> %v18, <i32 4, i32 -6437, i32 -4433, i32 11362, i32 -4, i32 -2261, i32 10704, i32 -9633>
      %v20 = add <8 x i32> %v17, %v19
      %v21 = shufflevector <8 x i32> %v2, <8 x i32> poison, <8 x i32> <i32 6, i32 6, i32 6, i32 6, i32 6, i32 6, i32 6, i32 6>
      %v22 = mul <8 x i32> %v21, <i32 4, i32 -9633, i32 4433, i32 2259, i32 -4, i32 11362, i32 -10704, i32 6436>
      %v23 = add <8 x i32> %v20, %v22
      %v24 = shufflevector <8 x i32> %v2, <8 x i32> poison, <8 x i32> <i32 7, i32 7, i32 7, i32 7, i32 7, i32 7, i32 7, i32 7>
      %v25 = mul <8 x i32> %v24, <i32 4, i32 -11363, i32 10703, i32 -9633, i32 4, i32 -6437, i32 4433, i32 -2260>
      %v26 = add <8 x i32> %v23, %v25
      %v27 = ashr <8 x i32> %v26, <i32 0, i32 11, i32 11, i32 11, i32 0, i32 11, i32 11, i32 11>
      %v28 = trunc <8 x i32> %v27 to <8 x i16>
      %v29 = bitcast <8 x i16> %v28 to i128
      ret i128 %v29
    } when endian little
    llvm {
      %v1 = bitcast i64 %0 to <8 x i8>
      %v2 = shufflevector <8 x i8> %v1, <8 x i8> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = zext <8 x i8> %v2 to <8 x i32>
      %v4 = shufflevector <8 x i32> %v3, <8 x i32> poison, <8 x i32> <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>
      %v5 = mul <8 x i32> %v4, <i32 4, i32 11363, i32 10703, i32 9633, i32 4, i32 6437, i32 4433, i32 2260>
      %v6 = add <8 x i32> <i32 -4096, i32 1024, i32 1024, i32 1024, i32 0, i32 1024, i32 1024, i32 1024>, %v5
      %v7 = shufflevector <8 x i32> %v3, <8 x i32> poison, <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>
      %v8 = mul <8 x i32> %v7, <i32 4, i32 9633, i32 4433, i32 -2259, i32 -4, i32 -11362, i32 -10704, i32 -6436>
      %v9 = add <8 x i32> %v6, %v8
      %v10 = shufflevector <8 x i32> %v3, <8 x i32> poison, <8 x i32> <i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2>
      %v11 = mul <8 x i32> %v10, <i32 4, i32 6437, i32 -4433, i32 -11362, i32 -4, i32 2261, i32 10704, i32 9633>
      %v12 = add <8 x i32> %v9, %v11
      %v13 = shufflevector <8 x i32> %v3, <8 x i32> poison, <8 x i32> <i32 3, i32 3, i32 3, i32 3, i32 3, i32 3, i32 3, i32 3>
      %v14 = mul <8 x i32> %v13, <i32 4, i32 2260, i32 -10703, i32 -6436, i32 4, i32 9633, i32 -4433, i32 -11363>
      %v15 = add <8 x i32> %v12, %v14
      %v16 = shufflevector <8 x i32> %v3, <8 x i32> poison, <8 x i32> <i32 4, i32 4, i32 4, i32 4, i32 4, i32 4, i32 4, i32 4>
      %v17 = mul <8 x i32> %v16, <i32 4, i32 -2260, i32 -10703, i32 6436, i32 4, i32 -9633, i32 -4433, i32 11363>
      %v18 = add <8 x i32> %v15, %v17
      %v19 = shufflevector <8 x i32> %v3, <8 x i32> poison, <8 x i32> <i32 5, i32 5, i32 5, i32 5, i32 5, i32 5, i32 5, i32 5>
      %v20 = mul <8 x i32> %v19, <i32 4, i32 -6437, i32 -4433, i32 11362, i32 -4, i32 -2261, i32 10704, i32 -9633>
      %v21 = add <8 x i32> %v18, %v20
      %v22 = shufflevector <8 x i32> %v3, <8 x i32> poison, <8 x i32> <i32 6, i32 6, i32 6, i32 6, i32 6, i32 6, i32 6, i32 6>
      %v23 = mul <8 x i32> %v22, <i32 4, i32 -9633, i32 4433, i32 2259, i32 -4, i32 11362, i32 -10704, i32 6436>
      %v24 = add <8 x i32> %v21, %v23
      %v25 = shufflevector <8 x i32> %v3, <8 x i32> poison, <8 x i32> <i32 7, i32 7, i32 7, i32 7, i32 7, i32 7, i32 7, i32 7>
      %v26 = mul <8 x i32> %v25, <i32 4, i32 -11363, i32 10703, i32 -9633, i32 4, i32 -6437, i32 4433, i32 -2260>
      %v27 = add <8 x i32> %v24, %v26
      %v28 = ashr <8 x i32> %v27, <i32 0, i32 11, i32 11, i32 11, i32 0, i32 11, i32 11, i32 11>
      %v29 = trunc <8 x i32> %v28 to <8 x i16>
      %v30 = shufflevector <8 x i16> %v29, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v31 = bitcast <8 x i16> %v30 to i128
      ret i128 %v31
    } when endian big

  -- | Column pass output row 0 from the eight row-pass results, quantized by the eight 16-bit divisors of the last argument with rounding away from zero at halves.
  prim fdct-quant0 :: U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 where
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = sext <8 x i16> %v1 to <8 x i32>
      %v3 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v2
      %v4 = add <8 x i32> <i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2>, %v3
      %v5 = bitcast i128 %1 to <8 x i16>
      %v6 = sext <8 x i16> %v5 to <8 x i32>
      %v7 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v6
      %v8 = add <8 x i32> %v4, %v7
      %v9 = bitcast i128 %2 to <8 x i16>
      %v10 = sext <8 x i16> %v9 to <8 x i32>
      %v11 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v10
      %v12 = add <8 x i32> %v8, %v11
      %v13 = bitcast i128 %3 to <8 x i16>
      %v14 = sext <8 x i16> %v13 to <8 x i32>
      %v15 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v14
      %v16 = add <8 x i32> %v12, %v15
      %v17 = bitcast i128 %4 to <8 x i16>
      %v18 = sext <8 x i16> %v17 to <8 x i32>
      %v19 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v18
      %v20 = add <8 x i32> %v16, %v19
      %v21 = bitcast i128 %5 to <8 x i16>
      %v22 = sext <8 x i16> %v21 to <8 x i32>
      %v23 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v22
      %v24 = add <8 x i32> %v20, %v23
      %v25 = bitcast i128 %6 to <8 x i16>
      %v26 = sext <8 x i16> %v25 to <8 x i32>
      %v27 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v26
      %v28 = add <8 x i32> %v24, %v27
      %v29 = bitcast i128 %7 to <8 x i16>
      %v30 = sext <8 x i16> %v29 to <8 x i32>
      %v31 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v30
      %v32 = add <8 x i32> %v28, %v31
      %v33 = ashr <8 x i32> %v32, <i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2>
      %v34 = bitcast i128 %8 to <8 x i16>
      %v35 = zext <8 x i16> %v34 to <8 x i32>
      %v36 = icmp slt <8 x i32> %v33, <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>
      %v37 = sub <8 x i32> <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>, %v33
      %v38 = select <8 x i1> %v36, <8 x i32> %v37, <8 x i32> %v33
      %v39 = lshr <8 x i32> %v35, <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>
      %v40 = add <8 x i32> %v38, %v39
      %v41 = uitofp <8 x i32> %v40 to <8 x double>
      %v42 = uitofp <8 x i32> %v35 to <8 x double>
      %v43 = fdiv <8 x double> %v41, %v42
      %v44 = fptoui <8 x double> %v43 to <8 x i32>
      %v45 = sub <8 x i32> <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>, %v44
      %v46 = select <8 x i1> %v36, <8 x i32> %v45, <8 x i32> %v44
      %v47 = trunc <8 x i32> %v46 to <8 x i16>
      %v48 = bitcast <8 x i16> %v47 to i128
      ret i128 %v48
    } when endian little
    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = shufflevector <8 x i16> %v1, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = sext <8 x i16> %v2 to <8 x i32>
      %v4 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v3
      %v5 = add <8 x i32> <i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2>, %v4
      %v6 = bitcast i128 %1 to <8 x i16>
      %v7 = shufflevector <8 x i16> %v6, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v8 = sext <8 x i16> %v7 to <8 x i32>
      %v9 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v8
      %v10 = add <8 x i32> %v5, %v9
      %v11 = bitcast i128 %2 to <8 x i16>
      %v12 = shufflevector <8 x i16> %v11, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v13 = sext <8 x i16> %v12 to <8 x i32>
      %v14 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v13
      %v15 = add <8 x i32> %v10, %v14
      %v16 = bitcast i128 %3 to <8 x i16>
      %v17 = shufflevector <8 x i16> %v16, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v18 = sext <8 x i16> %v17 to <8 x i32>
      %v19 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v18
      %v20 = add <8 x i32> %v15, %v19
      %v21 = bitcast i128 %4 to <8 x i16>
      %v22 = shufflevector <8 x i16> %v21, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v23 = sext <8 x i16> %v22 to <8 x i32>
      %v24 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v23
      %v25 = add <8 x i32> %v20, %v24
      %v26 = bitcast i128 %5 to <8 x i16>
      %v27 = shufflevector <8 x i16> %v26, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v28 = sext <8 x i16> %v27 to <8 x i32>
      %v29 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v28
      %v30 = add <8 x i32> %v25, %v29
      %v31 = bitcast i128 %6 to <8 x i16>
      %v32 = shufflevector <8 x i16> %v31, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v33 = sext <8 x i16> %v32 to <8 x i32>
      %v34 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v33
      %v35 = add <8 x i32> %v30, %v34
      %v36 = bitcast i128 %7 to <8 x i16>
      %v37 = shufflevector <8 x i16> %v36, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v38 = sext <8 x i16> %v37 to <8 x i32>
      %v39 = mul <8 x i32> <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>, %v38
      %v40 = add <8 x i32> %v35, %v39
      %v41 = ashr <8 x i32> %v40, <i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2, i32 2>
      %v42 = bitcast i128 %8 to <8 x i16>
      %v43 = shufflevector <8 x i16> %v42, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v44 = zext <8 x i16> %v43 to <8 x i32>
      %v45 = icmp slt <8 x i32> %v41, <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>
      %v46 = sub <8 x i32> <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>, %v41
      %v47 = select <8 x i1> %v45, <8 x i32> %v46, <8 x i32> %v41
      %v48 = lshr <8 x i32> %v44, <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>
      %v49 = add <8 x i32> %v47, %v48
      %v50 = uitofp <8 x i32> %v49 to <8 x double>
      %v51 = uitofp <8 x i32> %v44 to <8 x double>
      %v52 = fdiv <8 x double> %v50, %v51
      %v53 = fptoui <8 x double> %v52 to <8 x i32>
      %v54 = sub <8 x i32> <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>, %v53
