    llvm {
      %v1 = bitcast i128 %0 to <8 x i16>
      %v2 = shufflevector <8 x i16> %v1, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v3 = sext <8 x i16> %v2 to <8 x i32>
      %v4 = mul <8 x i32> <i32 2260, i32 2260, i32 2260, i32 2260, i32 2260, i32 2260, i32 2260, i32 2260>, %v3
      %v5 = add <8 x i32> <i32 16384, i32 16384, i32 16384, i32 16384, i32 16384, i32 16384, i32 16384, i32 16384>, %v4
      %v6 = bitcast i128 %1 to <8 x i16>
      %v7 = shufflevector <8 x i16> %v6, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v8 = sext <8 x i16> %v7 to <8 x i32>
      %v9 = mul <8 x i32> <i32 -6436, i32 -6436, i32 -6436, i32 -6436, i32 -6436, i32 -6436, i32 -6436, i32 -6436>, %v8
      %v10 = add <8 x i32> %v5, %v9
      %v11 = bitcast i128 %2 to <8 x i16>
      %v12 = shufflevector <8 x i16> %v11, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v13 = sext <8 x i16> %v12 to <8 x i32>
      %v14 = mul <8 x i32> <i32 9633, i32 9633, i32 9633, i32 9633, i32 9633, i32 9633, i32 9633, i32 9633>, %v13
      %v15 = add <8 x i32> %v10, %v14
      %v16 = bitcast i128 %3 to <8 x i16>
      %v17 = shufflevector <8 x i16> %v16, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v18 = sext <8 x i16> %v17 to <8 x i32>
      %v19 = mul <8 x i32> <i32 -11363, i32 -11363, i32 -11363, i32 -11363, i32 -11363, i32 -11363, i32 -11363, i32 -11363>, %v18
      %v20 = add <8 x i32> %v15, %v19
      %v21 = bitcast i128 %4 to <8 x i16>
      %v22 = shufflevector <8 x i16> %v21, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v23 = sext <8 x i16> %v22 to <8 x i32>
      %v24 = mul <8 x i32> <i32 11363, i32 11363, i32 11363, i32 11363, i32 11363, i32 11363, i32 11363, i32 11363>, %v23
      %v25 = add <8 x i32> %v20, %v24
      %v26 = bitcast i128 %5 to <8 x i16>
      %v27 = shufflevector <8 x i16> %v26, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v28 = sext <8 x i16> %v27 to <8 x i32>
      %v29 = mul <8 x i32> <i32 -9633, i32 -9633, i32 -9633, i32 -9633, i32 -9633, i32 -9633, i32 -9633, i32 -9633>, %v28
      %v30 = add <8 x i32> %v25, %v29
      %v31 = bitcast i128 %6 to <8 x i16>
      %v32 = shufflevector <8 x i16> %v31, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v33 = sext <8 x i16> %v32 to <8 x i32>
      %v34 = mul <8 x i32> <i32 6436, i32 6436, i32 6436, i32 6436, i32 6436, i32 6436, i32 6436, i32 6436>, %v33
      %v35 = add <8 x i32> %v30, %v34
      %v36 = bitcast i128 %7 to <8 x i16>
      %v37 = shufflevector <8 x i16> %v36, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v38 = sext <8 x i16> %v37 to <8 x i32>
      %v39 = mul <8 x i32> <i32 -2260, i32 -2260, i32 -2260, i32 -2260, i32 -2260, i32 -2260, i32 -2260, i32 -2260>, %v38
      %v40 = add <8 x i32> %v35, %v39
      %v41 = ashr <8 x i32> %v40, <i32 15, i32 15, i32 15, i32 15, i32 15, i32 15, i32 15, i32 15>
      %v42 = bitcast i128 %8 to <8 x i16>
      %v43 = shufflevector <8 x i16> %v42, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v44 = zext <8 x i16> %v43 to <8 x i32>
      %v45 = icmp slt <8 x i32> %v41, <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>
      %v46 = sub <8 x i32> <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>, %v41
      %v47 = select <8 x i1> %v45, <8 x i32> %v46, <8 x i32> %v41
      %v48 = lshr <8 x i32> %v44, <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>
      %v49 = add <8 x i32> %v47, %v48
      %v50 = uitofp <8 x i32> %v49 to <8 x double>
      %v51 = uitofp <8 x i32> %v44 to <8 x double>
      %v52 = fdiv <8 x double> %v50, %v51
      %v53 = fptoui <8 x double> %v52 to <8 x i32>
      %v54 = sub <8 x i32> <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>, %v53
      %v55 = select <8 x i1> %v45, <8 x i32> %v54, <8 x i32> %v53
      %v56 = trunc <8 x i32> %v55 to <8 x i16>
      %v57 = shufflevector <8 x i16> %v56, <8 x i16> poison, <8 x i32> <i32 7, i32 6, i32 5, i32 4, i32 3, i32 2, i32 1, i32 0>
      %v58 = bitcast <8 x i16> %v57 to i128
      ret i128 %v58
    } when endian big

  -- | The index of the first 0xFF among the sixteen bytes at base + offset, or 16 when there is none.
  prim ff-span :: I64 -> I64 -> I64 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %at = getelementptr i8, ptr %base, i64 %1
      %v = load <16 x i8>, ptr %at, align 1
      %hit = icmp eq <16 x i8> %v, <i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1, i8 -1>
      %pos = select <16 x i1> %hit, <16 x i8> <i8 0, i8 1, i8 2, i8 3, i8 4, i8 5, i8 6, i8 7, i8 8, i8 9, i8 10, i8 11, i8 12, i8 13, i8 14, i8 15>, <16 x i8> <i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16, i8 16>
      %m = call i8 @llvm.vector.reduce.umin.v16i8(<16 x i8> %pos)
      %r = zext i8 %m to i64
      ret i64 %r
    }

  -- | Resolve one Huffman code from a table at the first address: the 64-bit word is the little-endian load at the byte
  -- holding the bit position and the third argument is the bit offset within it (0 to 7). The table holds a 256-entry
  -- lookup of eight-bit prefixes (value * 256 + length + 1, zero for longer codes) at offset 0, the code values at
  -- 512, sixteen limits at 768 (one past the largest code of each length, left-justified to sixteen bits and
  -- capped at 2^16; a sixteen-bit window below limit l holds a code of length l + 1 when no shorter one matches)
  -- and sixteen value-index offsets at 832. The fourth argument chooses the
  -- magnitude size in its low two bits (0 for none, 1 for the code value itself as DC differences use, 2 for its low
  -- four bits as AC coefficients use) and a left shift for the magnitude in the next four; higher bits are ignored.
  -- The result is length + 256 * value + 65536 * shifted extended magnitude (a wrapping 32-bit field), or zero when
  -- no code of at most sixteen bits matches.
  prim huff-decode :: I64 -> U64 -> I64 -> I64 -> I64 where
    unsafe llvm {
      %tab = inttoptr i64 %0 to ptr
      %w = call i64 @llvm.bswap.i64(i64 %1)
      %win = shl i64 %w, %2
      %top = lshr i64 %win, 56
      %lutp = getelementptr i16, ptr %tab, i64 %top
      %lraw = load i16, ptr %lutp, align 1
      %lut = add i16 %lraw, 0
      %lut64 = zext i16 %lut to i64
      %fast = icmp ne i64 %lut64, 0
      %flen = and i64 %lut64, 255
      %fn = sub i64 %flen, 1
      %fval = lshr i64 %lut64, 8
      %top16 = lshr i64 %win, 48
      %w16 = trunc i64 %top16 to i32
      %ins = insertelement <16 x i32> poison, i32 %w16, i64 0
      %wv = shufflevector <16 x i32> %ins, <16 x i32> poison, <16 x i32> zeroinitializer
      %limp = getelementptr i8, ptr %tab, i64 768
      %limraw = load <16 x i32>, ptr %limp, align 1
      %lim = add <16 x i32> %limraw, zeroinitializer
      %ok = icmp ult <16 x i32> %wv, %lim
      %okb = select <16 x i1> %ok, <16 x i32> <i32 1, i32 2, i32 4, i32 8, i32 16, i32 32, i32 64, i32 128, i32 256, i32 512, i32 1024, i32 2048, i32 4096, i32 8192, i32 16384, i32 32768>, <16 x i32> zeroinitializer
      %okw = call i32 @llvm.vector.reduce.or.v16i32(<16 x i32> %okb)
      %okx = or i32 %okw, 65536
      %first = call i32 @llvm.cttz.i32(i32 %okx, i1 true)
      %found = icmp ult i32 %first, 16
      %li = and i32 %first, 15
      %cs = sub i32 15, %li
      %code = lshr i32 %w16, %cs
      %offp0 = getelementptr i8, ptr %tab, i64 832
      %li64 = zext i32 %li to i64
      %offp = getelementptr i32, ptr %offp0, i64 %li64
      %offraw = load i32, ptr %offp, align 1
      %off = add i32 %offraw, 0
      %vi = add i32 %code, %off
      %vim = and i32 %vi, 255
      %vi64 = zext i32 %vim to i64
      %valsp0 = getelementptr i8, ptr %tab, i64 512
      %valsp = getelementptr i8, ptr %valsp0, i64 %vi64
      %sval8 = load i8, ptr %valsp, align 1
      %sval = zext i8 %sval8 to i64
      %slen = add i64 %li64, 1
      %sn = select i1 %found, i64 %slen, i64 0
      %n = select i1 %fast, i64 %fn, i64 %sn
      %val = select i1 %fast, i64 %fval, i64 %sval
      %kind = and i64 %3, 3
      %isdc = icmp eq i64 %kind, 1
      %isac = icmp eq i64 %kind, 2
      %al0 = lshr i64 %3, 2
      %al = and i64 %al0, 15
      %low4 = and i64 %val, 15
      %dcsize = select i1 %isdc, i64 %val, i64 0
      %t0 = select i1 %isac, i64 %low4, i64 %dcsize
      %tbig = icmp ugt i64 %t0, 16
      %t = select i1 %tbig, i64 0, i64 %t0
      %after = shl i64 %win, %n
      %tz = icmp eq i64 %t, 0
      %rs = sub i64 64, %t
      %rs2 = select i1 %tz, i64 63, i64 %rs
      %raw0 = lshr i64 %after, %rs2
      %raw = select i1 %tz, i64 0, i64 %raw0
      %tm1 = sub i64 %t, 1
      %tm1s = select i1 %tz, i64 0, i64 %tm1
      %half = shl i64 1, %tm1s
      %neg = icmp ult i64 %raw, %half
      %full = shl i64 1, %t
      %adj = sub i64 %raw, %full
      %adj1 = add i64 %adj, 1
      %negt = and i1 %neg, true
      %use = select i1 %tz, i1 false, i1 %negt
      %ext = select i1 %use, i64 %adj1, i64 %raw
      %exts = shl i64 %ext, %al
      %ext32 = and i64 %exts, 4294967295
      %vs = shl i64 %val, 8
      %es = shl i64 %ext32, 16
      %r0 = or i64 %n, %vs
      %r1 = or i64 %r0, %es
      %nz = icmp eq i64 %n, 0
      %r = select i1 %nz, i64 0, i64 %r1
      ret i64 %r
    } when endian little
    unsafe llvm {
      %tab = inttoptr i64 %0 to ptr
      %w = call i64 @llvm.bswap.i64(i64 %1)
      %win = shl i64 %w, %2
      %top = lshr i64 %win, 56
      %lutp = getelementptr i16, ptr %tab, i64 %top
      %lraw = load i16, ptr %lutp, align 1
      %lut = call i16 @llvm.bswap.i16(i16 %lraw)
      %lut64 = zext i16 %lut to i64
      %fast = icmp ne i64 %lut64, 0
      %flen = and i64 %lut64, 255
      %fn = sub i64 %flen, 1
      %fval = lshr i64 %lut64, 8
      %top16 = lshr i64 %win, 48
      %w16 = trunc i64 %top16 to i32
      %ins = insertelement <16 x i32> poison, i32 %w16, i64 0
      %wv = shufflevector <16 x i32> %ins, <16 x i32> poison, <16 x i32> zeroinitializer
      %limp = getelementptr i8, ptr %tab, i64 768
      %limraw = load <16 x i32>, ptr %limp, align 1
      %lim = call <16 x i32> @llvm.bswap.v16i32(<16 x i32> %limraw)
      %ok = icmp ult <16 x i32> %wv, %lim
      %okb = select <16 x i1> %ok, <16 x i32> <i32 1, i32 2, i32 4, i32 8, i32 16, i32 32, i32 64, i32 128, i32 256, i32 512, i32 1024, i32 2048, i32 4096, i32 8192, i32 16384, i32 32768>, <16 x i32> zeroinitializer
      %okw = call i32 @llvm.vector.reduce.or.v16i32(<16 x i32> %okb)
      %okx = or i32 %okw, 65536
      %first = call i32 @llvm.cttz.i32(i32 %okx, i1 true)
      %found = icmp ult i32 %first, 16
      %li = and i32 %first, 15
      %cs = sub i32 15, %li
      %code = lshr i32 %w16, %cs
      %offp0 = getelementptr i8, ptr %tab, i64 832
      %li64 = zext i32 %li to i64
      %offp = getelementptr i32, ptr %offp0, i64 %li64
      %offraw = load i32, ptr %offp, align 1
      %off = call i32 @llvm.bswap.i32(i32 %offraw)
      %vi = add i32 %code, %off
      %vim = and i32 %vi, 255
      %vi64 = zext i32 %vim to i64
      %valsp0 = getelementptr i8, ptr %tab, i64 512
      %valsp = getelementptr i8, ptr %valsp0, i64 %vi64
      %sval8 = load i8, ptr %valsp, align 1
      %sval = zext i8 %sval8 to i64
      %slen = add i64 %li64, 1
      %sn = select i1 %found, i64 %slen, i64 0
      %n = select i1 %fast, i64 %fn, i64 %sn
      %val = select i1 %fast, i64 %fval, i64 %sval
      %kind = and i64 %3, 3
      %isdc = icmp eq i64 %kind, 1
      %isac = icmp eq i64 %kind, 2
      %al0 = lshr i64 %3, 2
      %al = and i64 %al0, 15
      %low4 = and i64 %val, 15
      %dcsize = select i1 %isdc, i64 %val, i64 0
      %t0 = select i1 %isac, i64 %low4, i64 %dcsize
      %tbig = icmp ugt i64 %t0, 16
      %t = select i1 %tbig, i64 0, i64 %t0
      %after = shl i64 %win, %n
      %tz = icmp eq i64 %t, 0
      %rs = sub i64 64, %t
      %rs2 = select i1 %tz, i64 63, i64 %rs
      %raw0 = lshr i64 %after, %rs2
      %raw = select i1 %tz, i64 0, i64 %raw0
      %tm1 = sub i64 %t, 1
      %tm1s = select i1 %tz, i64 0, i64 %tm1
      %half = shl i64 1, %tm1s
      %neg = icmp ult i64 %raw, %half
      %full = shl i64 1, %t
      %adj = sub i64 %raw, %full
      %adj1 = add i64 %adj, 1
      %negt = and i1 %neg, true
      %use = select i1 %tz, i1 false, i1 %negt
      %ext = select i1 %use, i64 %adj1, i64 %raw
      %exts = shl i64 %ext, %al
      %ext32 = and i64 %exts, 4294967295
      %vs = shl i64 %val, 8
      %es = shl i64 %ext32, 16
      %r0 = or i64 %n, %vs
      %r1 = or i64 %r0, %es
      %nz = icmp eq i64 %n, 0
      %r = select i1 %nz, i64 0, i64 %r1
      ret i64 %r
    } when endian big

  -- | One step of a first-scan AC band: resolve the Huffman code at bit position p (third argument) of the destuffed
  -- segment at the second address with the table at the first (its zig-zag order at offset 960); the fourth
  -- argument holds the point transform (bits 0-3), the band's last index (4-9) and the current index (10-16).
  -- The result packs the bits consumed (0-5), the next index (6-12), the kind (13-14: 0 a coefficient at a
  -- natural position, 1 a skip, 2 an end-of-band run, 3 the band already finished), the natural position or
  -- the end-of-band run (16-31) and the shifted coefficient as a wrapping 32-bit field (32-63); zero when no
  -- code matches.
  prim ac-decode :: I64 -> I64 -> I64 -> I64 -> I64 where
    unsafe llvm {
      %tab = inttoptr i64 %0 to ptr
      %seg = inttoptr i64 %1 to ptr
      %byte = lshr i64 %2, 3
      %sh = and i64 %2, 7
      %wp = getelementptr i8, ptr %seg, i64 %byte
      %wraw = load i64, ptr %wp, align 1
      %w = call i64 @llvm.bswap.i64(i64 %wraw)
      %win = shl i64 %w, %sh
      %top = lshr i64 %win, 56
      %lutp = getelementptr i16, ptr %tab, i64 %top
      %lraw = load i16, ptr %lutp, align 1
      %lut = add i16 %lraw, 0
      %lut64 = zext i16 %lut to i64
      %fast = icmp ne i64 %lut64, 0
      %flen = and i64 %lut64, 255
      %fn = sub i64 %flen, 1
      %fval = lshr i64 %lut64, 8
      %top16 = lshr i64 %win, 48
      %w16 = trunc i64 %top16 to i32
      %ins = insertelement <16 x i32> poison, i32 %w16, i64 0
      %wv = shufflevector <16 x i32> %ins, <16 x i32> poison, <16 x i32> zeroinitializer
      %limp = getelementptr i8, ptr %tab, i64 768
      %limraw = load <16 x i32>, ptr %limp, align 1
      %lim = add <16 x i32> %limraw, zeroinitializer
      %ok = icmp ult <16 x i32> %wv, %lim
      %okb = select <16 x i1> %ok, <16 x i32> <i32 1, i32 2, i32 4, i32 8, i32 16, i32 32, i32 64, i32 128, i32 256, i32 512, i32 1024, i32 2048, i32 4096, i32 8192, i32 16384, i32 32768>, <16 x i32> zeroinitializer
      %okw = call i32 @llvm.vector.reduce.or.v16i32(<16 x i32> %okb)
      %okx = or i32 %okw, 65536
      %first = call i32 @llvm.cttz.i32(i32 %okx, i1 true)
      %found = icmp ult i32 %first, 16
      %li = and i32 %first, 15
      %cs = sub i32 15, %li
      %code = lshr i32 %w16, %cs
      %offp0 = getelementptr i8, ptr %tab, i64 832
      %li64 = zext i32 %li to i64
      %offp = getelementptr i32, ptr %offp0, i64 %li64
      %offraw = load i32, ptr %offp, align 1
      %off = add i32 %offraw, 0
      %vi = add i32 %code, %off
      %vim = and i32 %vi, 255
      %vi64 = zext i32 %vim to i64
      %valsp0 = getelementptr i8, ptr %tab, i64 512
      %valsp = getelementptr i8, ptr %valsp0, i64 %vi64
      %sval8 = load i8, ptr %valsp, align 1
      %sval = zext i8 %sval8 to i64
      %slen = add i64 %li64, 1
      %sn = select i1 %found, i64 %slen, i64 0
      %n = select i1 %fast, i64 %fn, i64 %sn
      %val = select i1 %fast, i64 %fval, i64 %sval
      %al = and i64 %3, 15
      %ze0 = lshr i64 %3, 4
      %ze = and i64 %ze0, 63
      %zig0 = lshr i64 %3, 10
      %zig = and i64 %zig0, 127
      %done = icmp ugt i64 %zig, %ze
      %size = and i64 %val, 15
      %run = lshr i64 %val, 4
      %z = add i64 %zig, %run
      %hasv = icmp ne i64 %size, 0
      %over = icmp ugt i64 %z, %ze
      %zrl = icmp eq i64 %run, 15
      %t = select i1 %hasv, i64 %size, i64 %run
      %after = shl i64 %win, %n
      %tz = icmp eq i64 %t, 0
      %rs = sub i64 64, %t
      %rs2 = select i1 %tz, i64 63, i64 %rs
      %raw0 = lshr i64 %after, %rs2
      %raw = select i1 %tz, i64 0, i64 %raw0
      %tm1 = sub i64 %t, 1
      %tm1s = select i1 %tz, i64 0, i64 %tm1
      %half = shl i64 1, %tm1s
      %neg = icmp ult i64 %raw, %half
      %full = shl i64 1, %t
      %adj = sub i64 %raw, %full
      %adj1 = add i64 %adj, 1
      %ext = select i1 %neg, i64 %adj1, i64 %raw
      %exts = shl i64 %ext, %al
      %value = and i64 %exts, 4294967295
      %zm = and i64 %z, 63
      %zzp0 = getelementptr i8, ptr %tab, i64 960
      %zzp = getelementptr i8, ptr %zzp0, i64 %zm
      %nat8 = load i8, ptr %zzp, align 1
      %nat = zext i8 %nat8 to i64
      %eob = add i64 %full, %raw
      %ccons = add i64 %n, %size
      %cnext = add i64 %z, 1
      %ze1 = add i64 %ze, 1
      %zig16 = add i64 %zig, 16
      %erun = add i64 %n, %run
      %vcons = select i1 %over, i64 %n, i64 %ccons
      %vnext = select i1 %over, i64 %ze1, i64 %cnext
      %vkind = select i1 %over, i64 1, i64 0
      %zcons = select i1 %zrl, i64 %n, i64 %erun
      %znext = select i1 %zrl, i64 %zig16, i64 0
      %zkind = select i1 %zrl, i64 1, i64 2
      %cons = select i1 %hasv, i64 %vcons, i64 %zcons
      %next = select i1 %hasv, i64 %vnext, i64 %znext
      %kind = select i1 %hasv, i64 %vkind, i64 %zkind
      %isv = and i1 %hasv, true
      %placing = icmp eq i64 %kind, 0
      %field0 = select i1 %placing, i64 %nat, i64 0
      %iseob = icmp eq i64 %kind, 2
      %field = select i1 %iseob, i64 %eob, i64 %field0
      %valf = select i1 %placing, i64 %value, i64 0
      %p1 = shl i64 %next, 6
      %p2 = shl i64 %kind, 13
      %p3 = shl i64 %field, 16
      %p4 = shl i64 %valf, 32
      %q1 = or i64 %cons, %p1
      %q2 = or i64 %q1, %p2
      %q3 = or i64 %q2, %p3
      %q4 = or i64 %q3, %p4
      %none = icmp eq i64 %n, 0
      %r0 = select i1 %none, i64 0, i64 %q4
      %r = select i1 %done, i64 24576, i64 %r0
      ret i64 %r
    } when endian little
    unsafe llvm {
      %tab = inttoptr i64 %0 to ptr
      %seg = inttoptr i64 %1 to ptr
      %byte = lshr i64 %2, 3
      %sh = and i64 %2, 7
      %wp = getelementptr i8, ptr %seg, i64 %byte
      %wraw = load i64, ptr %wp, align 1
      %w = add i64 %wraw, 0
      %win = shl i64 %w, %sh
      %top = lshr i64 %win, 56
      %lutp = getelementptr i16, ptr %tab, i64 %top
      %lraw = load i16, ptr %lutp, align 1
      %lut = call i16 @llvm.bswap.i16(i16 %lraw)
      %lut64 = zext i16 %lut to i64
      %fast = icmp ne i64 %lut64, 0
      %flen = and i64 %lut64, 255
      %fn = sub i64 %flen, 1
      %fval = lshr i64 %lut64, 8
      %top16 = lshr i64 %win, 48
      %w16 = trunc i64 %top16 to i32
      %ins = insertelement <16 x i32> poison, i32 %w16, i64 0
      %wv = shufflevector <16 x i32> %ins, <16 x i32> poison, <16 x i32> zeroinitializer
      %limp = getelementptr i8, ptr %tab, i64 768
      %limraw = load <16 x i32>, ptr %limp, align 1
      %lim = call <16 x i32> @llvm.bswap.v16i32(<16 x i32> %limraw)
      %ok = icmp ult <16 x i32> %wv, %lim
      %okb = select <16 x i1> %ok, <16 x i32> <i32 1, i32 2, i32 4, i32 8, i32 16, i32 32, i32 64, i32 128, i32 256, i32 512, i32 1024, i32 2048, i32 4096, i32 8192, i32 16384, i32 32768>, <16 x i32> zeroinitializer
      %okw = call i32 @llvm.vector.reduce.or.v16i32(<16 x i32> %okb)
      %okx = or i32 %okw, 65536
      %first = call i32 @llvm.cttz.i32(i32 %okx, i1 true)
      %found = icmp ult i32 %first, 16
      %li = and i32 %first, 15
      %cs = sub i32 15, %li
      %code = lshr i32 %w16, %cs
      %offp0 = getelementptr i8, ptr %tab, i64 832
      %li64 = zext i32 %li to i64
      %offp = getelementptr i32, ptr %offp0, i64 %li64
      %offraw = load i32, ptr %offp, align 1
      %off = call i32 @llvm.bswap.i32(i32 %offraw)
      %vi = add i32 %code, %off
      %vim = and i32 %vi, 255
      %vi64 = zext i32 %vim to i64
      %valsp0 = getelementptr i8, ptr %tab, i64 512
      %valsp = getelementptr i8, ptr %valsp0, i64 %vi64
      %sval8 = load i8, ptr %valsp, align 1
      %sval = zext i8 %sval8 to i64
      %slen = add i64 %li64, 1
      %sn = select i1 %found, i64 %slen, i64 0
      %n = select i1 %fast, i64 %fn, i64 %sn
      %val = select i1 %fast, i64 %fval, i64 %sval
      %al = and i64 %3, 15
      %ze0 = lshr i64 %3, 4
      %ze = and i64 %ze0, 63
      %zig0 = lshr i64 %3, 10
      %zig = and i64 %zig0, 127
      %done = icmp ugt i64 %zig, %ze
      %size = and i64 %val, 15
      %run = lshr i64 %val, 4
      %z = add i64 %zig, %run
      %hasv = icmp ne i64 %size, 0
      %over = icmp ugt i64 %z, %ze
      %zrl = icmp eq i64 %run, 15
      %t = select i1 %hasv, i64 %size, i64 %run
      %after = shl i64 %win, %n
      %tz = icmp eq i64 %t, 0
      %rs = sub i64 64, %t
      %rs2 = select i1 %tz, i64 63, i64 %rs
      %raw0 = lshr i64 %after, %rs2
      %raw = select i1 %tz, i64 0, i64 %raw0
      %tm1 = sub i64 %t, 1
      %tm1s = select i1 %tz, i64 0, i64 %tm1
      %half = shl i64 1, %tm1s
      %neg = icmp ult i64 %raw, %half
      %full = shl i64 1, %t
      %adj = sub i64 %raw, %full
      %adj1 = add i64 %adj, 1
      %ext = select i1 %neg, i64 %adj1, i64 %raw
      %exts = shl i64 %ext, %al
      %value = and i64 %exts, 4294967295
      %zm = and i64 %z, 63
      %zzp0 = getelementptr i8, ptr %tab, i64 960
      %zzp = getelementptr i8, ptr %zzp0, i64 %zm
      %nat8 = load i8, ptr %zzp, align 1
      %nat = zext i8 %nat8 to i64
      %eob = add i64 %full, %raw
      %ccons = add i64 %n, %size
      %cnext = add i64 %z, 1
      %ze1 = add i64 %ze, 1
      %zig16 = add i64 %zig, 16
      %erun = add i64 %n, %run
      %vcons = select i1 %over, i64 %n, i64 %ccons
      %vnext = select i1 %over, i64 %ze1, i64 %cnext
      %vkind = select i1 %over, i64 1, i64 0
      %zcons = select i1 %zrl, i64 %n, i64 %erun
      %znext = select i1 %zrl, i64 %zig16, i64 0
      %zkind = select i1 %zrl, i64 1, i64 2
      %cons = select i1 %hasv, i64 %vcons, i64 %zcons
      %next = select i1 %hasv, i64 %vnext, i64 %znext
      %kind = select i1 %hasv, i64 %vkind, i64 %zkind
      %isv = and i1 %hasv, true
      %placing = icmp eq i64 %kind, 0
      %field0 = select i1 %placing, i64 %nat, i64 0
      %iseob = icmp eq i64 %kind, 2
      %field = select i1 %iseob, i64 %eob, i64 %field0
      %valf = select i1 %placing, i64 %value, i64 0
      %p1 = shl i64 %next, 6
      %p2 = shl i64 %kind, 13
      %p3 = shl i64 %field, 16
      %p4 = shl i64 %valf, 32
      %q1 = or i64 %cons, %p1
      %q2 = or i64 %q1, %p2
      %q3 = or i64 %q2, %p3
      %q4 = or i64 %q3, %p4
      %none = icmp eq i64 %n, 0
      %r0 = select i1 %none, i64 0, i64 %q4
      %r = select i1 %done, i64 24576, i64 %r0
      ret i64 %r
    } when endian big

  -- | Bit z set when the coefficient at zig-zag position z of the natural-order block of sixty-four little-endian i16 values at the address is nonzero.
  prim zz-mask :: I64 -> I64 where
    unsafe llvm {
      %p = inttoptr i64 %0 to ptr
      %v = load <64 x i16>, ptr %p, align 1
      %g0 = shufflevector <64 x i16> %v, <64 x i16> poison, <16 x i32> <i32 0, i32 1, i32 8, i32 16, i32 9, i32 2, i32 3, i32 10, i32 17, i32 24, i32 32, i32 25, i32 18, i32 11, i32 4, i32 5>
      %n0 = icmp ne <16 x i16> %g0, zeroinitializer
      %b0 = select <16 x i1> %n0, <16 x i16> <i16 1, i16 2, i16 4, i16 8, i16 16, i16 32, i16 64, i16 128, i16 256, i16 512, i16 1024, i16 2048, i16 4096, i16 8192, i16 16384, i16 -32768>, <16 x i16> zeroinitializer
      %m0 = call i16 @llvm.vector.reduce.or.v16i16(<16 x i16> %b0)
      %w0 = zext i16 %m0 to i64
      %s0 = shl i64 %w0, 0
      %g1 = shufflevector <64 x i16> %v, <64 x i16> poison, <16 x i32> <i32 12, i32 19, i32 26, i32 33, i32 40, i32 48, i32 41, i32 34, i32 27, i32 20, i32 13, i32 6, i32 7, i32 14, i32 21, i32 28>
      %n1 = icmp ne <16 x i16> %g1, zeroinitializer
      %b1 = select <16 x i1> %n1, <16 x i16> <i16 1, i16 2, i16 4, i16 8, i16 16, i16 32, i16 64, i16 128, i16 256, i16 512, i16 1024, i16 2048, i16 4096, i16 8192, i16 16384, i16 -32768>, <16 x i16> zeroinitializer
      %m1 = call i16 @llvm.vector.reduce.or.v16i16(<16 x i16> %b1)
      %w1 = zext i16 %m1 to i64
      %s1 = shl i64 %w1, 16
      %a1 = or i64 %s0, %s1
      %g2 = shufflevector <64 x i16> %v, <64 x i16> poison, <16 x i32> <i32 35, i32 42, i32 49, i32 56, i32 57, i32 50, i32 43, i32 36, i32 29, i32 22, i32 15, i32 23, i32 30, i32 37, i32 44, i32 51>
      %n2 = icmp ne <16 x i16> %g2, zeroinitializer
      %b2 = select <16 x i1> %n2, <16 x i16> <i16 1, i16 2, i16 4, i16 8, i16 16, i16 32, i16 64, i16 128, i16 256, i16 512, i16 1024, i16 2048, i16 4096, i16 8192, i16 16384, i16 -32768>, <16 x i16> zeroinitializer
      %m2 = call i16 @llvm.vector.reduce.or.v16i16(<16 x i16> %b2)
      %w2 = zext i16 %m2 to i64
      %s2 = shl i64 %w2, 32
      %a2 = or i64 %a1, %s2
      %g3 = shufflevector <64 x i16> %v, <64 x i16> poison, <16 x i32> <i32 58, i32 59, i32 52, i32 45, i32 38, i32 31, i32 39, i32 46, i32 53, i32 60, i32 61, i32 54, i32 47, i32 55, i32 62, i32 63>
      %n3 = icmp ne <16 x i16> %g3, zeroinitializer
      %b3 = select <16 x i1> %n3, <16 x i16> <i16 1, i16 2, i16 4, i16 8, i16 16, i16 32, i16 64, i16 128, i16 256, i16 512, i16 1024, i16 2048, i16 4096, i16 8192, i16 16384, i16 -32768>, <16 x i16> zeroinitializer
      %m3 = call i16 @llvm.vector.reduce.or.v16i16(<16 x i16> %b3)
      %w3 = zext i16 %m3 to i64
      %s3 = shl i64 %w3, 48
      %a3 = or i64 %a2, %s3
      ret i64 %a3
    }

  -- | The coefficient at zig-zag position z (third argument) of the natural-order block at the first address, through the zig-zag order at the second, sign-extended.
  prim zz-coef :: I64 -> I64 -> I64 -> I64 where
    unsafe llvm {
      %coef = inttoptr i64 %0 to ptr
      %order = inttoptr i64 %1 to ptr
      %zm = and i64 %2, 63
      %op = getelementptr i8, ptr %order, i64 %zm
      %n8 = load i8, ptr %op, align 1
      %n = zext i8 %n8 to i64
      %cp = getelementptr i16, ptr %coef, i64 %n
      %raw = load i16, ptr %cp, align 1
      %c = add i16 %raw, 0
      %r = sext i16 %c to i64
      ret i64 %r
    } when endian little
    unsafe llvm {
      %coef = inttoptr i64 %0 to ptr
      %order = inttoptr i64 %1 to ptr
      %zm = and i64 %2, 63
      %op = getelementptr i8, ptr %order, i64 %zm
      %n8 = load i8, ptr %op, align 1
      %n = zext i8 %n8 to i64
      %cp = getelementptr i16, ptr %coef, i64 %n
      %raw = load i16, ptr %cp, align 1
      %c = call i16 @llvm.bswap.i16(i16 %raw)
      %r = sext i16 %c to i64
      ret i64 %r
    } when endian big

  -- | The Huffman code for a zero run (second argument) and the size of a signed value (third), from the 256-entry table of length * 2^24 + code words at the address, followed by the value's magnitude bits (one's complement when negative): (bits << 6) | total length.
  prim rle-bits :: I64 -> I64 -> I64 -> I64 where
    unsafe llvm {
      %tab = inttoptr i64 %0 to ptr
      %neg = icmp slt i64 %2, 0
      %nv = sub i64 0, %2
      %a = select i1 %neg, i64 %nv, i64 %2
      %a32 = trunc i64 %a to i32
      %lz = call i32 @llvm.ctlz.i32(i32 %a32, i1 false)
      %nb32 = sub i32 32, %lz
      %nb = zext i32 %nb32 to i64
      %runs = shl i64 %1, 4
      %sym0 = or i64 %runs, %nb
      %sym = and i64 %sym0, 255
      %ep = getelementptr i32, ptr %tab, i64 %sym
      %eraw = load i32, ptr %ep, align 1
      %e32 = add i32 %eraw, 0
      %e = zext i32 %e32 to i64
      %clen = lshr i64 %e, 24
      %code = and i64 %e, 16777215
      %one = shl i64 1, %nb
      %mask = sub i64 %one, 1
      %vm1 = sub i64 %2, 1
      %mag0 = select i1 %neg, i64 %vm1, i64 %2
      %mag = and i64 %mag0, %mask
      %cs = shl i64 %code, %nb
      %bits = or i64 %cs, %mag
      %len = add i64 %clen, %nb
      %bs = shl i64 %bits, 6
      %r = or i64 %bs, %len
      ret i64 %r
    } when endian little
    unsafe llvm {
      %tab = inttoptr i64 %0 to ptr
      %neg = icmp slt i64 %2, 0
      %nv = sub i64 0, %2
      %a = select i1 %neg, i64 %nv, i64 %2
      %a32 = trunc i64 %a to i32
      %lz = call i32 @llvm.ctlz.i32(i32 %a32, i1 false)
      %nb32 = sub i32 32, %lz
      %nb = zext i32 %nb32 to i64
      %runs = shl i64 %1, 4
      %sym0 = or i64 %runs, %nb
      %sym = and i64 %sym0, 255
      %ep = getelementptr i32, ptr %tab, i64 %sym
      %eraw = load i32, ptr %ep, align 1
      %e32 = call i32 @llvm.bswap.i32(i32 %eraw)
      %e = zext i32 %e32 to i64
      %clen = lshr i64 %e, 24
      %code = and i64 %e, 16777215
      %one = shl i64 1, %nb
      %mask = sub i64 %one, 1
      %vm1 = sub i64 %2, 1
      %mag0 = select i1 %neg, i64 %vm1, i64 %2
      %mag = and i64 %mag0, %mask
      %cs = shl i64 %code, %nb
      %bits = or i64 %cs, %mag
      %len = add i64 %clen, %nb
      %bs = shl i64 %bits, 6
      %r = or i64 %bs, %len
      ret i64 %r
    } when endian big
