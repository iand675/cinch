      %v9 = bitcast i128 %2 to <8 x i16>
      %v10 = sext <8 x i16> %v9 to <8 x i32>
      %v11 = mul <8 x i32> <i32 9633, i32 9633, i32 9633, i32 9633, i32 9633, i32 9633, i32 9633, i32 9633>, %v10
      %v12 = add <8 x i32> %v8, %v11
      %v13 = bitcast i128 %3 to <8 x i16>
      %v14 = sext <8 x i16> %v13 to <8 x i32>
      %v15 = mul <8 x i32> <i32 -11363, i32 -11363, i32 -11363, i32 -11363, i32 -11363, i32 -11363, i32 -11363, i32 -11363>, %v14
      %v16 = add <8 x i32> %v12, %v15
      %v17 = bitcast i128 %4 to <8 x i16>
      %v18 = sext <8 x i16> %v17 to <8 x i32>
      %v19 = mul <8 x i32> <i32 11363, i32 11363, i32 11363, i32 11363, i32 11363, i32 11363, i32 11363, i32 11363>, %v18
      %v20 = add <8 x i32> %v16, %v19
      %v21 = bitcast i128 %5 to <8 x i16>
      %v22 = sext <8 x i16> %v21 to <8 x i32>
      %v23 = mul <8 x i32> <i32 -9633, i32 -9633, i32 -9633, i32 -9633, i32 -9633, i32 -9633, i32 -9633, i32 -9633>, %v22
      %v24 = add <8 x i32> %v20, %v23
      %v25 = bitcast i128 %6 to <8 x i16>
      %v26 = sext <8 x i16> %v25 to <8 x i32>
      %v27 = mul <8 x i32> <i32 6436, i32 6436, i32 6436, i32 6436, i32 6436, i32 6436, i32 6436, i32 6436>, %v26
      %v28 = add <8 x i32> %v24, %v27
      %v29 = bitcast i128 %7 to <8 x i16>
      %v30 = sext <8 x i16> %v29 to <8 x i32>
      %v31 = mul <8 x i32> <i32 -2260, i32 -2260, i32 -2260, i32 -2260, i32 -2260, i32 -2260, i32 -2260, i32 -2260>, %v30
      %v32 = add <8 x i32> %v28, %v31
      %v33 = ashr <8 x i32> %v32, <i32 15, i32 15, i32 15, i32 15, i32 15, i32 15, i32 15, i32 15>
      %v34 = bitcast i128 %8 to <8 x i16>
      %v35 = zext <8 x i16> %v34 to <8 x i32>
      %v36 = icmp slt <8 x i32> %v33, <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>
      %v37 = sub <8 x i32> <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>, %v33
      %v38 = select <8 x i1> %v36, <8 x i32> %v37, <8 x i32> %v33
      %v39 = lshr <8 x i32> %v35, <i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1, i32 1>
      %v40 = add <8 x i32> %v38, %v39
      %v41 = uitofp <8 x i32> %v40 to <8 x double>
      %v42 = uitofp <8 x i32> %v35 to <8 x double>
      %v43 = fdiv <8 x double> %v41, %v42
      %v44 = fptoui <8 x double> %v43 to <8 x i32>
      %v45 = sub <8 x i32> <i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0, i32 0>, %v44
      %v46 = select <8 x i1> %v36, <8 x i32> %v45, <8 x i32> %v44
      %v47 = trunc <8 x i32> %v46 to <8 x i16>
      %v48 = bitcast <8 x i16> %v47 to i128
      ret i128 %v48
