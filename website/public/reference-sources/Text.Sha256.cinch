-- | SHA-224 and SHA-256 digests, persistent streaming states and binary checkpoints.
-- Compression expands four schedule words per step in portable 128-bit SIMD lanes
-- and evaluates all sixty-four ordered rounds in registers with native rotates.
-- Updates read checked 64-byte blocks directly from the input buffer and copy
-- pending tails into private storage. Retaining a state branches the computation.
-- Digest and checkpoint words use network order; byte counts wrap at 64 bits.
-- Checkpoint input and returned buffers never alias the state.
module Text.Sha256 where

  import Data.Bytes
  import Data.Machine
  import Data.Nat
  import Data.Result
  import Data.String
  import Data.Wide (bit-or-u128, bit-xor-u128, simd-u32x4-add, simd-u32x4-rotr, simd-u32x4-shr, simd-u64x2-pack, u64-to-u128, wrapping-shl-u128, wrapping-shr-u128, wrapping-u128-to-u32, wrapping-u128-to-u64)
  import Text.Binary

  export sha256-size, sha224-size, sha256-block-size, sha256-sum, sha224-sum
  export Sha256State, sha256-state, sha224-state, sha256-state-update, sha256-state-reset
  export sha256-state-size, sha256-state-block-size, sha256-state-sum, sha256-state-append
  export sha256-state-save, sha256-state-append-save, sha256-state-load
  export Sha256StateError, InvalidSha256StateIdentifier, InvalidSha256StateSize, sha256-state-error-message

  -- | SHA-256 digest size in bytes, always 32.
  sha256-size :: Nat
  sha256-size = 32

  -- | SHA-224 digest size in bytes, always 28.
  sha224-size :: Nat
  sha224-size = 28

  -- | Compression block size in bytes for both variants, always 64.
  sha256-block-size :: Nat
  sha256-block-size = 64

  -- | Private complete chaining value; raw word pairs permit ordinary constructor reuse.
  data Sha256Words where
    -- | Eight unsigned 32-bit words, packed first word low in each U64 pair.
    ShaWords :: U64 -> U64 -> U64 -> U64 -> Sha256Words

  -- | An immutable variant, wrapping byte count, copied partial block and chaining value.
  data Sha256State where
    -- | Private pending bytes have length count modulo 64, always below one full block.
    State256 :: Bool -> U64 -> Bytes -> Sha256Words -> Sha256State

  -- | Initial SHA-256 state with the FIPS 180-4 chaining value and no pending bytes.
  sha256-state :: Sha256State
  sha256-state = State256 False 0 (bytes-new 0) (sha256-initial-words False)

  -- | Initial SHA-224 state with its distinct FIPS 180-4 chaining value and no pending bytes.
  sha224-state :: Sha256State
  sha224-state = State256 True 0 (bytes-new 0) (sha256-initial-words True)

  -- | Compute a fresh 32-byte network-order SHA-256 digest of a complete input.
  sha256-sum :: Bytes -> Bytes
  sha256-sum input = one-shot False input

  -- | Compute a fresh 28-byte network-order SHA-224 digest of a complete input.
  sha224-sum :: Bytes -> Bytes
  sha224-sum input = one-shot True input

  -- | Process a complete input directly, copying its tail only into the final padding block.
  -- The shared streaming representation remains unnecessary for this whole-buffer operation.
  one-shot :: Bool -> Bytes -> Bytes
  one-shot short input =
    let n = bytes-len input in
    let count = wrapping-i64-to-u64 (nat-to-i64 n) in
    let words = blocks-from (sha256-initial-words short) input 0 in
    let tail = nat-rem n 64 in
    if tail <= n then
      let final = finish-interval count input (n - tail) tail words in render-words short final
    else render-words short words

  -- | Consume a complete chunk without mutating any previous state or retaining the input buffer.
  -- Empty chunks preserve the supplied state. Counts use explicit unsigned 64-bit wrapping.
  sha256-state-update :: Sha256State -> Bytes -> Sha256State
  sha256-state-update state input = if bytes-len input == 0 then state else case state of
    State256 short count pending words -> update-fields short count pending words input

  -- | Transfer fields out of the outer state before processing potentially many compression blocks.
  update-fields :: Bool -> U64 -> Bytes -> Sha256Words -> Bytes -> Sha256State
  update-fields short count pending words input =
    let total = wrapping-add-u64 count (wrapping-i64-to-u64 (nat-to-i64 (bytes-len input))) in
    let have = bytes-len pending in
    if have < 64 then
      if have == 0 then process-from short total words input 0
      else
        let needed = 64 - have in
        if bytes-len input < needed then State256 short total (join pending input) words
        else
          let block = bytes-new 64 in
          let first = bytes-copy-range block pending 0 0 have in
          let last = bytes-copy-range block input have 0 needed in
          let next = blocks-from words block 0 in
          process-from short total next input needed
    else State256 short count pending words

  -- | Process the complete suffix blocks and retain only a fresh final partial block.
  process-from :: Bool -> U64 -> Sha256Words -> Bytes -> Nat -> Sha256State
  process-from short total words input start =
    if start <= bytes-len input then
      let remaining = bytes-len input - start in
      let next = blocks-from words input (nat-to-i64 start) in
      let tail = nat-rem remaining 64 in
      if tail <= bytes-len input then
        let from = bytes-len input - tail in
        State256 short total (part input from tail) next
      else State256 short total (bytes-new 0) next
    else State256 short total (bytes-new 0) words

  -- | Copy an exact interval into fresh storage without retaining a mutable source alias.
  part :: Bytes -> Nat -> Nat -> Bytes
  part input start count = if start + count <= bytes-len input then
    let out = bytes-new count in let copied = bytes-copy-range out input 0 start count in out
    else bytes-new 0

  -- | Concatenate two intervals in fresh storage, preserving both inputs.
  join :: Bytes -> Bytes -> Bytes
  join first last =
    let n = bytes-len first in let out = bytes-new (n + bytes-len last) in
    let a = bytes-copy-range out first 0 0 n in
    let b = bytes-copy-range out last n 0 (bytes-len last) in out

  -- | Return the initial state for the same variant, preserving the supplied state.
  sha256-state-reset :: Sha256State -> Sha256State
  sha256-state-reset state = case state of State256 short count pending words -> if short then sha224-state else sha256-state

  -- | Digest size in bytes, bounded by 28 and 32 and fixed by the state's selected variant.
  sha256-state-size :: Sha256State -> InRange 28 32 Nat
  sha256-state-size state = case state of State256 short count pending words -> digest-size short

  -- | Keep the selected output size within the proved bounds used by digest stores.
  digest-size :: Bool -> InRange 28 32 Nat
  digest-size short = if short then 28 else 32

  -- | Compression block size in bytes, always 64 for either variant.
  sha256-state-block-size :: Sha256State -> Nat
  sha256-state-block-size state = sha256-block-size

  -- | Choose one or two complete finalization blocks without a partial block allocation.
  padding-size :: Nat -> InRange 64 128 Nat
  padding-size pending = if pending < 56 then 64 else 128

  -- | Pad the retained partial block and append the wrapping network-order bit count.
  finish-words :: U64 -> Bytes -> Sha256Words -> Sha256Words
  finish-words count pending words =
    let n = bytes-len pending in
    if n < 64 then
      let size = padding-size n in let padding = bytes-new size in
      let copied = bytes-copy-range padding pending 0 0 n in
      let mark = bytes-set padding n 128 in
      let length = binary-put-u64 BigEndian padding (size - 8) (wrapping-shl-u64 count 3) in
      blocks-from words padding 0
    else words

  -- | Copy an exactly bounded source tail into one or two private finalization blocks.
  -- The interval contains fewer than 64 bytes; the appended bit count uses U64 wrapping.
  finish-interval :: U64 -> Bytes -> Nat -> Nat -> Sha256Words -> Sha256Words
  finish-interval count input start n words =
    if n < 64 && start + n <= bytes-len input then
      let size = padding-size n in let padding = bytes-new size in
      let copied = bytes-copy-range padding input 0 start n in
      let mark = bytes-set padding n 128 in
      let length = binary-put-u64 BigEndian padding (size - 8) (wrapping-shl-u64 count 3) in
      blocks-from words padding 0
    else words

  -- | Convert a numeric pair to little-endian storage whose bytes contain both words in network order.
  wire-pair :: U64 -> U64
  wire-pair pair = rotate-left-u64 (swap-bytes-u64 pair) 32

  -- | Store two network-order chaining words only within a checked complete destination interval.
  put-pair :: Bytes -> Nat -> U64 -> Unit
  put-pair out pos pair = if pos + 8 <= bytes-len out then bytes-store-le64 out pos (wire-pair pair) else ()

  -- | Render all eight chaining words into an existing complete network-order interval.
  put-words :: Bytes -> Nat -> Sha256Words -> Unit
  put-words out pos words = case words of
    ShaWords ab cd ef gh ->
      let a = put-pair out pos ab in let b = put-pair out (pos + 8) cd in
      let c = put-pair out (pos + 16) ef in put-pair out (pos + 24) gh

  -- | Return the selected network-order digest in fresh storage without changing the state.
  sha256-state-sum :: Sha256State -> Bytes
  sha256-state-sum state = case state of
    State256 short count pending words ->
      let final = finish-words count pending words in
      let size = sha256-state-size state in let out = bytes-new size in
      case final of
        ShaWords ab cd ef gh ->
          let a = put-pair out 0 ab in let b = put-pair out 8 cd in
          let c = put-pair out 16 ef in
          let d = if size == 32 then put-pair out 24 gh else bytes-store-le32 out 24 (wrapping-u64-to-u32 (wire-pair gh)) in out

  -- | Dispatch to a fixed-size renderer before allocating the result buffer.
  render-words :: Bool -> Sha256Words -> Bytes
  render-words short words = if short then render-short words else render-full words

  -- | Render all eight finalized words into a fresh buffer with statically complete store bounds.
  render-full :: Sha256Words -> Bytes
  render-full words = case words of
    ShaWords ab cd ef gh ->
      let out = bytes-new 32 in
      let a = bytes-store-le64 out 0 (wire-pair ab) in
      let b = bytes-store-le64 out 8 (wire-pair cd) in
      let c = bytes-store-le64 out 16 (wire-pair ef) in
      let d = bytes-store-le64 out 24 (wire-pair gh) in out

  -- | Render the first seven finalized words with an exact four-byte final store.
  render-short :: Sha256Words -> Bytes
  render-short words = case words of
    ShaWords ab cd ef gh ->
      let out = bytes-new 28 in
      let a = bytes-store-le64 out 0 (wire-pair ab) in
      let b = bytes-store-le64 out 8 (wire-pair cd) in
      let c = bytes-store-le64 out 16 (wire-pair ef) in
      let d = bytes-store-le32 out 24 (wrapping-u64-to-u32 (wire-pair gh)) in out

  -- | Append the selected digest to a copied prefix, preserving the state and caller buffer.
  sha256-state-append :: Bytes -> Sha256State -> Bytes
  sha256-state-append prefix state = join prefix (sha256-state-sum state)

  -- | Return 108 checkpoint bytes: sha, variant byte 2/3, chaining words, zero-padded tail and count.
  -- Variant 2 is SHA-224 and variant 3 is SHA-256. Every numeric field uses network order.
  sha256-state-save :: Sha256State -> Bytes
  sha256-state-save state = case state of
    State256 short count pending words ->
      let out = bytes-new 108 in
      let h0 = bytes-set out 0 115 in let h1 = bytes-set out 1 104 in
      let h2 = bytes-set out 2 97 in let h3 = bytes-set out 3 (if short then 2 else 3) in
      let w = put-words out 4 words in
      let p = if bytes-len pending < 64 then bytes-copy-range out pending 36 0 (bytes-len pending) else () in
      let n = binary-put-u64 BigEndian out 100 count in out

  -- | Append the complete checkpoint to a copied prefix without mutating either input.
  sha256-state-append-save :: Bytes -> Sha256State -> Bytes
  sha256-state-append-save prefix state = join prefix (sha256-state-save state)

  -- | A checkpoint's complete variant identifier or exact byte length is invalid.
  data Sha256StateError where
    -- | The four-byte sha/variant identifier is absent or differs from the template.
    InvalidSha256StateIdentifier :: Sha256StateError
    -- | Expected complete checkpoint length and actual input length, in that order.
    InvalidSha256StateSize :: Nat -> Nat -> Sha256StateError

  -- | Render identifier errors or complete required and actual checkpoint byte lengths.
  sha256-state-error-message :: Sha256StateError -> String
  sha256-state-error-message error = case error of
    InvalidSha256StateIdentifier -> "SHA-2 state identifier is invalid"
    InvalidSha256StateSize expected actual -> string-concat "SHA-2 state requires " (string-concat (nat-to-string expected) (string-concat " bytes; received " (nat-to-string actual)))

  -- | Read two network-order chaining words after checking their complete interval.
  read-pair :: Bytes -> Nat -> U64
  read-pair input pos = if pos + 8 <= bytes-len input then wire-pair (bytes-load-le64 input pos) else 0

  -- | Restore every chaining/count bit, copying only the live partial block into private storage.
  -- The template selects the variant. Identifier checks precede exact-size checks;
  -- unused checkpoint tail bytes are ignored and serialized as zeros on the next save.
  sha256-state-load :: Sha256State -> Bytes -> Result Sha256StateError Sha256State
  sha256-state-load template input = case template of
    State256 short old-count old-pending old-words ->
      if 4 <= bytes-len input then
        if bytes-get input 0 == 115 && bytes-get input 1 == 104 && bytes-get input 2 == 97 && bytes-get input 3 == (if short then 2 else 3) then
          if bytes-len input == 108 then case binary-read-u64 BigEndian input 100 of
            Err error -> Err (InvalidSha256StateSize 108 (bytes-len input))
            Ok count ->
              let n = u8-to-nat (wrapping-u64-to-u8 (bit-and-u64 count 63)) in
              let words = ShaWords (read-pair input 4) (read-pair input 12) (read-pair input 20) (read-pair input 28) in
              Ok (State256 short count (part input 36 n) words)
          else Err (InvalidSha256StateSize 108 (bytes-len input))
        else Err InvalidSha256StateIdentifier
      else Err InvalidSha256StateIdentifier

  -- | Extract the low U32 lane from a packed pair of chaining words.
  word-low :: U64 -> U32
  word-low pair = wrapping-u64-to-u32 pair

  -- | Extract the high U32 lane from a packed pair of chaining words.
  word-high :: U64 -> U32
  word-high pair = wrapping-u64-to-u32 (wrapping-shr-u64 pair 32)

  -- | Pack two chaining words with the first word in the low 32 bits.
  pack-pair :: U32 -> U32 -> U64
  pack-pair lo hi = bit-or-u64 (u32-to-u64 lo) (wrapping-shl-u64 (u32-to-u64 hi) 32)

  -- | Select schedule lane 0 from a packed four-word SIMD group.
  lane0 :: U128 -> U32
  lane0 group = wrapping-u128-to-u32 group

  -- | Select schedule lane 1 from a packed four-word SIMD group.
  lane1 :: U128 -> U32
  lane1 group = wrapping-u128-to-u32 (wrapping-shr-u128 group 32)

  -- | Select schedule lane 2 from a packed four-word SIMD group.
  lane2 :: U128 -> U32
  lane2 group = wrapping-u128-to-u32 (wrapping-shr-u128 group 64)

  -- | Select schedule lane 3 from a packed four-word SIMD group.
  lane3 :: U128 -> U32
  lane3 group = wrapping-u128-to-u32 (wrapping-shr-u128 group 96)

  -- | Load sixteen input bytes as four network-order U32 lanes packed into one U128.
  load-group :: Bytes -> I64 -> U128
  load-group input offset =
    let n = bytes-len-i64 input in
    if 0 <= offset && 16 <= n then
      if nat-from-i64 offset <= nat-from-i64 n - 16 then
        let raw = bytes-load-u128-at input offset in
        let lo = wire-pair (wrapping-u128-to-u64 raw) in
        let hi = wire-pair (wrapping-u128-to-u64 (wrapping-shr-u128 raw 64)) in
        simd-u64x2-pack lo hi
      else u64-to-u128 0
    else u64-to-u128 0

  -- | Expand four SHA-256 schedule words in portable 128-bit SIMD lanes.
  sha256-schedule :: U128 -> U128 -> U128 -> U128 -> U128
  sha256-schedule g0 g1 g2 g3 =
    let a = bit-or-u128 (wrapping-shr-u128 g0 32) (wrapping-shl-u128 g1 96) in
    let b = bit-or-u128 (wrapping-shr-u128 g2 32) (wrapping-shl-u128 g3 96) in
    let c = wrapping-shr-u128 g3 64 in
    let s0 = bit-xor-u128 (bit-xor-u128 (simd-u32x4-rotr a 7) (simd-u32x4-rotr a 18)) (simd-u32x4-shr a 3) in
    let s1 = bit-xor-u128 (bit-xor-u128 (simd-u32x4-rotr c 17) (simd-u32x4-rotr c 19)) (simd-u32x4-shr c 10) in
    let first = simd-u32x4-add (simd-u32x4-add (simd-u32x4-add g0 b) s0) s1 in
    let upper = wrapping-shl-u128 first 64 in
    let s2 = bit-xor-u128 (bit-xor-u128 (simd-u32x4-rotr upper 17) (simd-u32x4-rotr upper 19)) (simd-u32x4-shr upper 10) in
    simd-u32x4-add first s2

  -- | Compute the choice, upper sigma and message contribution to one SHA-256 round.
  sha256-t1 :: U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32
  sha256-t1 e f g h w k =
    let s1 = bit-xor-u32 (bit-xor-u32 (rotate-right-u32 e 6) (rotate-right-u32 e 11)) (rotate-right-u32 e 25) in
    let ch = bit-xor-u32 (bit-and-u32 e f) (bit-and-u32 (bit-not-u32 e) g) in
    wrapping-add-u32 (wrapping-add-u32 (wrapping-add-u32 (wrapping-add-u32 h s1) ch) k) w

  -- | Compute the majority and lower sigma contribution to one SHA-256 round.
  sha256-t2 :: U32 -> U32 -> U32 -> U32
  sha256-t2 a b c =
    let s0 = bit-xor-u32 (bit-xor-u32 (rotate-right-u32 a 2) (rotate-right-u32 a 13)) (rotate-right-u32 a 22) in
    let maj = bit-xor-u32 (bit-xor-u32 (bit-and-u32 a b) (bit-and-u32 a c)) (bit-and-u32 b c) in
    wrapping-add-u32 s0 maj

  -- | FIPS 180-4 SHA-256 round constants K[0..63], lowered to a constant lookup table.
  sha256-k :: U32 -> U32
  sha256-k r = case r of
    0 -> 1116352408
    1 -> 1899447441
    2 -> 3049323471
    3 -> 3921009573
    4 -> 961987163
    5 -> 1508970993
    6 -> 2453635748
    7 -> 2870763221
    8 -> 3624381080
    9 -> 310598401
    10 -> 607225278
    11 -> 1426881987
    12 -> 1925078388
    13 -> 2162078206
    14 -> 2614888103
    15 -> 3248222580
    16 -> 3835390401
    17 -> 4022224774
    18 -> 264347078
    19 -> 604807628
    20 -> 770255983
    21 -> 1249150122
    22 -> 1555081692
    23 -> 1996064986
    24 -> 2554220882
    25 -> 2821834349
    26 -> 2952996808
    27 -> 3210313671
    28 -> 3336571891
    29 -> 3584528711
    30 -> 113926993
    31 -> 338241895
    32 -> 666307205
    33 -> 773529912
    34 -> 1294757372
    35 -> 1396182291
    36 -> 1695183700
    37 -> 1986661051
    38 -> 2177026350
    39 -> 2456956037
    40 -> 2730485921
    41 -> 2820302411
    42 -> 3259730800
    43 -> 3345764771
    44 -> 3516065817
    45 -> 3600352804
    46 -> 4094571909
    47 -> 275423344
    48 -> 430227734
    49 -> 506948616
    50 -> 659060556
    51 -> 883997877
    52 -> 958139571
    53 -> 1322822218
    54 -> 1537002063
    55 -> 1747873779
    56 -> 1955562222
    57 -> 2024104815
    58 -> 2227730452
    59 -> 2361852424
    60 -> 2428436474
    61 -> 2756734187
    62 -> 3204031479
    63 -> 3329325298
    _ -> 0

  -- | Compress every complete 64-byte block starting at offset without allocating per block.
  blocks-from :: Sha256Words -> Bytes -> I64 -> Sha256Words
  blocks-from words input offset = case words of
    ShaWords ab cd ef gh ->
      blocks-loop input offset (bytes-len-i64 input)
        (word-low ab) (word-high ab) (word-low cd) (word-high cd)
        (word-low ef) (word-high ef) (word-low gh) (word-high gh)

  -- | Outer multi-block compression loop holding all eight chaining words unboxed in registers.
  blocks-loop :: Bytes -> I64 -> I64 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> Sha256Words
  blocks-loop input offset len h0 h1 h2 h3 h4 h5 h6 h7 =
    if 0 <= offset && 64 <= len && offset <= wrapping-sub-i64 len 64 then
      let g0 = load-group input offset in
      let g1 = load-group input (wrapping-add-i64 offset 16) in
      let g2 = load-group input (wrapping-add-i64 offset 32) in
      let g3 = load-group input (wrapping-add-i64 offset 48) in
      sha256-rounds input (wrapping-add-i64 offset 64) len 0
        h0 h1 h2 h3 h4 h5 h6 h7
        h0 h1 h2 h3 h4 h5 h6 h7
        g0 g1 g2 g3
    else ShaWords (pack-pair h0 h1) (pack-pair h2 h3) (pack-pair h4 h5) (pack-pair h6 h7)

  -- | Inner four-round compression loop over the sliding SIMD schedule window, returning to blocks-loop.
  sha256-rounds :: Bytes -> I64 -> I64 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U128 -> U128 -> U128 -> U128 -> Sha256Words
  sha256-rounds input next-off len r h0 h1 h2 h3 h4 h5 h6 h7 a b c d e f g h g0 g1 g2 g3 =
    if ge-u32 r 64 then
      blocks-loop input next-off len
        (wrapping-add-u32 h0 a) (wrapping-add-u32 h1 b) (wrapping-add-u32 h2 c) (wrapping-add-u32 h3 d)
        (wrapping-add-u32 h4 e) (wrapping-add-u32 h5 f) (wrapping-add-u32 h6 g) (wrapping-add-u32 h7 h)
    else
      let w0 = lane0 g0 in
      let w1 = lane1 g0 in
      let w2 = lane2 g0 in
      let w3 = lane3 g0 in
      let t10 = sha256-t1 e f g h w0 (sha256-k r) in
      let t20 = sha256-t2 a b c in
      let a0 = wrapping-add-u32 t10 t20 in
      let e0 = wrapping-add-u32 d t10 in
      let t11 = sha256-t1 e0 e f g w1 (sha256-k (wrapping-add-u32 r 1)) in
      let t21 = sha256-t2 a0 a b in
      let a1 = wrapping-add-u32 t11 t21 in
      let e1 = wrapping-add-u32 c t11 in
      let t12 = sha256-t1 e1 e0 e f w2 (sha256-k (wrapping-add-u32 r 2)) in
      let t22 = sha256-t2 a1 a0 a in
      let a2 = wrapping-add-u32 t12 t22 in
      let e2 = wrapping-add-u32 b t12 in
      let t13 = sha256-t1 e2 e1 e0 e w3 (sha256-k (wrapping-add-u32 r 3)) in
      let t23 = sha256-t2 a2 a1 a0 in
      let a3 = wrapping-add-u32 t13 t23 in
      let e3 = wrapping-add-u32 a t13 in
      let g4 = if lt-u32 r 48 then sha256-schedule g0 g1 g2 g3 else g0 in
      sha256-rounds input next-off len (wrapping-add-u32 r 4)
        h0 h1 h2 h3 h4 h5 h6 h7
        a3 a2 a1 a0 e3 e2 e1 e0
        g1 g2 g3 g4

  -- | Initial chaining words derived from the exact FIPS 180-4 prime-root definitions.
  sha256-initial-words :: Bool -> Sha256Words
  sha256-initial-words short =
    if short then ShaWords 3926247204440088280 17802264479202860311 7518782744944446257 13761399178871279527
    else ShaWords 13503953895726638695 11912009169889063794 11170449402626986623 6620516960021240235
