  -- | The angle of the point (x, y) from the positive x axis, in [-pi, pi], with signed-zero and infinite cases resolved by quadrant.
  prim atan2-f64 :: F64 -> F64 -> F64 where
    llvm {
      %v1 = fcmp uno double %0, 0.0
