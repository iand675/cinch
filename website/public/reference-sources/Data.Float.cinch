-- | Binary64 mathematics: constants, classification, exact rounding and bit-level splitting, and the
-- elementary functions (roots, exponentials, logarithms, powers, trigonometric, inverse trigonometric and
-- hyperbolic functions).
--
-- Results are deterministic to the bit on every target: the functions use only IEEE-754 round-to-nearest
-- additions, multiplications, divisions and square roots (never fused multiply-adds or the host's libm), so the
-- same input gives the same output on 64-bit ARM, WebAssembly and big-endian machines alike. The algorithms
-- are the classic ones: argument reduction by a split ln 2 with minimax polynomials for exp, expm1, log and
-- log1p; rational approximations after reduction by a three-part pi/4 for the trigonometric functions, with
-- Payne-Hanek reduction against a 1216-bit 4/pi from 2^29 up; rational approximations for the arctangent and
-- the hyperbolic functions; and exact bit manipulation for frexp, ldexp, modf, nextafter and the roundings.
-- The special functions follow the same lineage: rational approximations for erf and erfc over five
-- intervals, the inverse error function by three rational fits, Gamma by its rational form on [2, 3) with
-- recurrence, Stirling's series and reflection, lgamma by interval polynomials and the reflection through
-- sin(pi x), Bessel functions of orders 0 and 1 by polynomials near zero and Hankel asymptotic forms beyond 2,
-- and of order n by forward recurrence, a continued fraction with backward recurrence, or the large-argument
-- form (J1 stays odd for tiny arguments: J1(x) = x/2 below 2^-27 for either sign). FMA is computed exactly in
-- 128-bit integer arithmetic and rounded once.
-- Special values follow the C99 conventions: signed zeros are preserved, NaN propagates, and infinities and
-- poles are exact.
--
-- Every function is implemented in pure Cinch over Data.Machine and Data.Wide. Rounding to integers uses the
-- Data.Machine floor, ceil, trunc, round and round-to-even operations, which lower to single instructions
-- where the target has them.
module Data.Float where

  import Data.Wide (u64-to-u128, wrapping-u128-to-u64, wrapping-mul-u128, wrapping-shr-u128)

  export pi-f64, e-f64, phi-f64, sqrt2-f64, sqrt-e-f64, sqrt-pi-f64, sqrt-phi-f64, ln2-f64, log2-e-f64, ln10-f64
  export log10-e-f64, max-f64, smallest-f64, max-f32, smallest-f32
  export f64-bits, f64-from-bits, f32-bits, f32-from-bits, inf-f64, nan-f64, is-nan-f64, is-inf-f64
  export copysign-f64, floor-f64, ceil-f64, trunc-f64, round-f64, round-to-even-f64
  export frexp-f64, ldexp-f64, modf-f64, ilogb-f64, logb-f64, nextafter-f64, nextafter-f32
  export mod-f64, remainder-f64, dim-f64, max-of-f64, min-of-f64
  export cbrt-f64, hypot-f64, exp-f64, exp2-f64, expm1-f64, log-f64, log2-f64, log10-f64, log1p-f64
  export pow-f64, pow10-f64, sin-f64, cos-f64, tan-f64, sincos-f64, asin-f64, acos-f64, atan-f64, atan2-f64
  export sinh-f64, cosh-f64, tanh-f64, asinh-f64, acosh-f64, atanh-f64
  export erf-f64, erfc-f64, erfinv-f64, erfcinv-f64, gamma-f64, lgamma-f64, fma-f64
  export j0-f64, j1-f64, jn-f64, y0-f64, y1-f64, yn-f64

  -- ---------------------------------------------------------------------
  -- Bit and wide-integer helpers.
  -- ---------------------------------------------------------------------

  -- | Unsigned 64-bit left shift returning zero when the shift count is 64 or more.
  shl-u64 :: U64 -> U64 -> U64
  shl-u64 x s = if ge-u64 s 64 then 0 else wrapping-shl-u64 x (wrapping-u64-to-u32 s)

  -- | Unsigned 64-bit right shift returning zero when the shift count is 64 or more.
  shr-u64 :: U64 -> U64 -> U64
  shr-u64 x s = if ge-u64 s 64 then 0 else wrapping-shr-u64 x (wrapping-u64-to-u32 s)

  -- | Leading zero count of an unsigned 64-bit word, as U64.
  clz-u64 :: U64 -> U64
  clz-u64 x = u32-to-u64 (leading-zeros-u64 x)

  -- | Exact 64-by-64 unsigned product as (high word, low word).
  mul-u64-wide :: U64 -> U64 -> (U64, U64)
  mul-u64-wide a b =
    let p = wrapping-mul-u128 (u64-to-u128 a) (u64-to-u128 b) in
    (wrapping-u128-to-u64 (wrapping-shr-u128 p 64), wrapping-u128-to-u64 p)

  -- | Scale a subnormal binary64 value into the normal range, returning the value and exponent adjustment.
  normalize-f64 :: F64 -> (F64, I64)
  normalize-f64 x =
    if flt-f64 (abs-f64 x) (f64-from-bits 0x0010000000000000) then (mul-f64 x (f64-from-bits 0x4330000000000000), wrapping-neg-i64 52)
    else (x, 0)

  -- ---------------------------------------------------------------------
  -- Constants.
  -- ---------------------------------------------------------------------

  -- | pi, the nearest binary64 value.
  pi-f64 :: F64
  pi-f64 = f64-from-bits 0x400921FB54442D18

  -- | e, the base of natural logarithms.
  e-f64 :: F64
  e-f64 = f64-from-bits 0x4005BF0A8B145769

  -- | The golden ratio.
  phi-f64 :: F64
  phi-f64 = f64-from-bits 0x3FF9E3779B97F4A8

  -- | The square root of 2.
  sqrt2-f64 :: F64
  sqrt2-f64 = f64-from-bits 0x3FF6A09E667F3BCD

  -- | The square root of e.
  sqrt-e-f64 :: F64
  sqrt-e-f64 = f64-from-bits 0x3FFA61298E1E069C

  -- | The square root of pi.
  sqrt-pi-f64 :: F64
  sqrt-pi-f64 = f64-from-bits 0x3FFC5BF891B4EF6B

  -- | The square root of the golden ratio.
  sqrt-phi-f64 :: F64
  sqrt-phi-f64 = f64-from-bits 0x3FF45A3146A88456

  -- | The natural logarithm of 2.
  ln2-f64 :: F64
  ln2-f64 = f64-from-bits 0x3FE62E42FEFA39EF

  -- | The binary logarithm of e.
  log2-e-f64 :: F64
  log2-e-f64 = f64-from-bits 0x3FF71547652B82FE

  -- | The natural logarithm of 10.
  ln10-f64 :: F64
  ln10-f64 = f64-from-bits 0x40026BB1BBB55516

  -- | The decimal logarithm of e.
  log10-e-f64 :: F64
  log10-e-f64 = f64-from-bits 0x3FDBCB7B1526E50E

  -- | The largest finite binary64 value.
  max-f64 :: F64
  max-f64 = f64-from-bits 0x7FEFFFFFFFFFFFFF

  -- | The smallest positive (subnormal) binary64 value.
  smallest-f64 :: F64
  smallest-f64 = f64-from-bits 1

  -- | The largest finite binary32 value.
  max-f32 :: F32
  max-f32 = f32-from-bits 0x7F7FFFFF

  -- | The smallest positive (subnormal) binary32 value.
  smallest-f32 :: F32
  smallest-f32 = f32-from-bits 1

  -- | One half.
  half :: F64
  half = f64-from-bits 0x3FE0000000000000

  -- | Negative zero.
  neg-zero :: F64
  neg-zero = f64-from-bits 0x8000000000000000

  -- | Positive infinity.
  pos-inf :: F64
  pos-inf = f64-from-bits 0x7FF0000000000000

  -- | Negative infinity.
  neg-inf :: F64
  neg-inf = f64-from-bits 0xFFF0000000000000

  -- | Half the largest finite value.
  half-max :: F64
  half-max = f64-from-bits 0x7FDFFFFFFFFFFFFF

  -- | 2^29, where trigonometric arguments switch to Payne-Hanek reduction.
  reduce-threshold :: F64
  reduce-threshold = f64-from-bits 0x41C0000000000000

  -- | High part of ln 2 for argument reduction.
  ln2-hi :: F64
  ln2-hi = f64-from-bits 0x3FE62E42FEE00000

  -- | Low part of ln 2 for argument reduction.
  ln2-lo :: F64
  ln2-lo = f64-from-bits 0x3DEA39EF35793C76

  -- | pi / 2.
  pi-half :: F64
  pi-half = f64-from-bits 0x3FF921FB54442D18

  -- | pi / 4.
  pi-quarter :: F64
  pi-quarter = f64-from-bits 0x3FE921FB54442D18

  -- | 3 pi / 4.
  three-pi-quarter :: F64
  three-pi-quarter = f64-from-bits 0x4002D97C7F3321D2

  -- ---------------------------------------------------------------------
  -- Classification, signs and rounding.
  -- ---------------------------------------------------------------------

  -- | Positive infinity for a sign of zero or more, negative infinity otherwise.
  inf-f64 :: I64 -> F64
  inf-f64 sign = if ge-i64 sign 0 then pos-inf else neg-inf

  -- | A quiet NaN.
  nan-f64 :: F64
  nan-f64 = f64-from-bits 0x7FF8000000000001

  -- | Whether a value is NaN.
  is-nan-f64 :: F64 -> Bool
  is-nan-f64 x = fne-f64 x x

  -- | Whether a value is an infinity of a sign: positive for a sign above zero, negative below, either for zero.
  is-inf-f64 :: F64 -> I64 -> Bool
  is-inf-f64 x sign = (ge-i64 sign 0 && fgt-f64 x max-f64) || (le-i64 sign 0 && flt-f64 x (neg-f64 max-f64))

  -- copysign-f64, floor-f64, ceil-f64, trunc-f64, round-f64, round-to-even-f64 are re-exported from Data.Machine.

  -- | The fraction in [1/2, 1) and exponent with x = fraction * 2^exponent; zeros, infinities and NaN return
  -- themselves with exponent 0.
  frexp-f64 :: F64 -> (F64, I64)
  frexp-f64 f =
    if feq-f64 f 0 || is-nan-f64 f || feq-f64 (abs-f64 f) pos-inf then (f, 0)
    else (case normalize-f64 f of
      (g, e) ->
        let x = f64-bits g in
        let e2 = wrapping-sub-i64 (wrapping-add-i64 e (wrapping-u64-to-i64 (bit-and-u64 (wrapping-shr-u64 x 52) 2047))) 1022 in
        let m = bit-or-u64 (bit-and-u64 x 0x800FFFFFFFFFFFFF) (wrapping-shl-u64 1022 52) in
        (f64-from-bits m, e2))

  -- | fraction * 2^exponent, rounded once (gradual underflow, overflow to infinity).
  ldexp-f64 :: F64 -> I64 -> F64
  ldexp-f64 frac exp0 =
    if feq-f64 frac 0 || is-nan-f64 frac || feq-f64 (abs-f64 frac) pos-inf then frac
    else (case normalize-f64 frac of
      (g, e) ->
        let x = f64-bits g in
        let e1 = wrapping-sub-i64 (wrapping-add-i64 (wrapping-add-i64 exp0 e) (wrapping-u64-to-i64 (bit-and-u64 (wrapping-shr-u64 x 52) 2047))) 1023 in
        if lt-i64 e1 (wrapping-neg-i64 1075) then copysign-f64 0 g
        else if gt-i64 e1 1023 then (if flt-f64 g 0 then neg-inf else pos-inf)
        else
          let sub = lt-i64 e1 (wrapping-neg-i64 1022) in
          let e2 = if sub then wrapping-add-i64 e1 53 else e1 in
          let m = if sub then (f64-from-bits 0x3CA0000000000000) else 1 in
          let bits = bit-or-u64 (bit-and-u64 x 0x800FFFFFFFFFFFFF) (wrapping-shl-u64 (wrapping-i64-to-u64 (wrapping-add-i64 e2 1023)) 52) in
          mul-f64 m (f64-from-bits bits))

  -- | Split a non-negative value of magnitude at least 1 into integer and fractional parts.
  modf-ge1 :: F64 -> (F64, F64)
  modf-ge1 f =
    let x = f64-bits f in
    let e = wrapping-sub-u64 (bit-and-u64 (wrapping-shr-u64 x 52) 2047) 1023 in
    let x2 = if lt-u64 e 52 then bit-and-u64 x (bit-not-u64 (wrapping-sub-u64 (shl-u64 1 (wrapping-sub-u64 52 e)) 1)) else x in
    let i = f64-from-bits x2 in
    (i, sub-f64 f i)

  -- | The integer and fractional parts, both carrying the sign of x.
  modf-f64 :: F64 -> (F64, F64)
  modf-f64 f =
    if flt-f64 f 1 then
      if flt-f64 f 0 then
        let g = neg-f64 f in
        if flt-f64 g 1 then (neg-zero, f)
        else (case modf-ge1 g of (a, b) -> (neg-f64 a, neg-f64 b))
      else if feq-f64 f 0 then (f, f)
      else (0, f)
    else modf-ge1 f

  -- | The unbiased binary exponent of a finite nonzero value.
  ilogb-kernel :: F64 -> I64
  ilogb-kernel x =
    case normalize-f64 x of
      (y, e) -> wrapping-add-i64 (wrapping-sub-i64 (wrapping-u64-to-i64 (bit-and-u64 (wrapping-shr-u64 (f64-bits y) 52) 2047)) 1023) e

  -- | The binary exponent of x as an integer: the least 32-bit integer for zero, the greatest for infinities
  -- and NaN.
  ilogb-f64 :: F64 -> I64
  ilogb-f64 x =
    if feq-f64 x 0 then wrapping-neg-i64 2147483648
    else if is-nan-f64 x || is-inf-f64 x 0 then 2147483647
    else ilogb-kernel x

  -- | The binary exponent of x as a value: negative infinity for zero, positive infinity for infinities.
  logb-f64 :: F64 -> F64
  logb-f64 x =
    if feq-f64 x 0 then neg-inf
    else if is-inf-f64 x 0 then pos-inf
    else if is-nan-f64 x then x
    else i64-to-f64 (ilogb-kernel x)

  -- | The next representable value after x toward y.
  nextafter-f64 :: F64 -> F64 -> F64
  nextafter-f64 x y =
    if is-nan-f64 x || is-nan-f64 y then nan-f64
    else if feq-f64 x y then x
    else if feq-f64 x 0 then copysign-f64 (f64-from-bits 1) y
    else if same (fgt-f64 y x) (fgt-f64 x 0) then f64-from-bits (wrapping-add-u64 (f64-bits x) 1)
    else f64-from-bits (wrapping-sub-u64 (f64-bits x) 1)

  -- | The next representable binary32 value after x toward y.
  nextafter-f32 :: F32 -> F32 -> F32
  nextafter-f32 x y =
    if is-na-nf32 x || is-na-nf32 y then f32-from-bits 0x7FC00000
    else if feq-f32 x y then x
    else if feq-f32 x 0 then (if sign-bit-f32 y then f32-from-bits 0x80000001 else f32-from-bits 1)
    else if same (fgt-f32 y x) (fgt-f32 x 0) then f32-from-bits (wrapping-add-u32 (f32-bits x) 1)
    else f32-from-bits (wrapping-sub-u32 (f32-bits x) 1)

  -- | Whether two truth values agree.
  same :: Bool -> Bool -> Bool
  same a b = if a then b else not b

  -- | The positive difference: x - y when positive, otherwise zero.
  dim-f64 :: F64 -> F64 -> F64
  dim-f64 x y = let v = sub-f64 x y in if fle-f64 v 0 then 0 else v

  -- | The larger value: positive infinity if either is, then NaN if either is; +0 beats -0.
  max-of-f64 :: F64 -> F64 -> F64
  max-of-f64 x y =
    if is-inf-f64 x 1 || is-inf-f64 y 1 then pos-inf
    else if is-nan-f64 x || is-nan-f64 y then nan-f64
    else if feq-f64 x 0 && feq-f64 x y then (if sign-bit-f64 x then y else x)
    else if fgt-f64 x y then x else y

  -- | The smaller value: negative infinity if either is, then NaN if either is; -0 beats +0.
  min-of-f64 :: F64 -> F64 -> F64
  min-of-f64 x y =
    if is-inf-f64 x (wrapping-neg-i64 1) || is-inf-f64 y (wrapping-neg-i64 1) then neg-inf
    else if is-nan-f64 x || is-nan-f64 y then nan-f64
    else if feq-f64 x 0 && feq-f64 x y then (if sign-bit-f64 x then x else y)
    else if flt-f64 x y then x else y

  -- ---------------------------------------------------------------------
  -- Remainders.
  -- ---------------------------------------------------------------------

  -- | The remainder of x / y with the sign of x (truncated division); NaN when y is zero or x is infinite.
  mod-f64 :: F64 -> F64 -> F64
  mod-f64 x y =
    if feq-f64 y 0 || is-inf-f64 x 0 || is-nan-f64 x || is-nan-f64 y then nan-f64
    else mod-signed x (mod-start (if flt-f64 x 0 then neg-f64 x else x) (abs-f64 y))

  -- | The magnitude's remainder against |y|, from the split of |y|.
  mod-start :: F64 -> F64 -> F64
  mod-start r y = case frexp-f64 y of (yfr, yexp) -> mod-loop r y yfr yexp

  -- | Subtract scaled copies of y until r is below it.
  mod-loop :: F64 -> F64 -> F64 -> I64 -> F64
  mod-loop r y yfr yexp = if fge-f64 r y then mod-loop (mod-step r y yfr yexp) y yfr yexp else r

  -- | One step of the remainder: subtract the largest y * 2^k not above r.
  mod-step :: F64 -> F64 -> F64 -> I64 -> F64
  mod-step r y yfr yexp =
    case frexp-f64 r of
      (rfr, rexp0) ->
        let rexp = if flt-f64 rfr yfr then wrapping-sub-i64 rexp0 1 else rexp0 in
        sub-f64 r (ldexp-f64 y (wrapping-sub-i64 rexp yexp))

  -- | The remainder with the dividend's sign.
  mod-signed :: F64 -> F64 -> F64
  mod-signed x r = if flt-f64 x 0 then neg-f64 r else r

  -- | The IEEE remainder x - n*y with n the integer nearest x / y (halves to even).
  remainder-f64 :: F64 -> F64 -> F64
  remainder-f64 x y =
    if is-nan-f64 x || is-nan-f64 y || is-inf-f64 x 0 || feq-f64 y 0 then nan-f64
    else if is-inf-f64 y 0 then x
    else remainder-finite x (if flt-f64 x 0 then neg-f64 x else x) (if flt-f64 y 0 then neg-f64 y else y)

  -- | The remainder of finite magnitudes.
  remainder-finite :: F64 -> F64 -> F64 -> F64
  remainder-finite x ax ay =
    if feq-f64 ax ay then copysign-f64 0 x
    else remainder-fix (if fle-f64 ay half-max then mod-f64 ax (add-f64 ay ay) else ax) ay x

  -- | The IEEE remainder's final correction of x mod 2y into [-y/2, y/2], with the sign of the dividend.
  remainder-fix :: F64 -> F64 -> F64 -> F64
  remainder-fix x0 y orig =
    let x = (if flt-f64 y (f64-from-bits 0x0020000000000000) then
        (if fgt-f64 (add-f64 x0 x0) y then
          let x1 = sub-f64 x0 y in
          if fge-f64 (add-f64 x1 x1) y then sub-f64 x1 y else x1
        else x0)
      else
        let yhalf = mul-f64 half y in
        if fgt-f64 x0 yhalf then
          let x1 = sub-f64 x0 y in
          if fge-f64 x1 yhalf then sub-f64 x1 y else x1
        else x0) in
    if flt-f64 orig 0 then neg-f64 x else x

  -- ---------------------------------------------------------------------
  -- Roots and hypotenuse.
  -- ---------------------------------------------------------------------

  -- | The cube root, exact for perfect cubes of moderate size.
  cbrt-f64 :: F64 -> F64
  cbrt-f64 x0 =
    if feq-f64 x0 0 || is-nan-f64 x0 || feq-f64 (abs-f64 x0) pos-inf then x0
    else
      let sign = flt-f64 x0 0 in
      let x = abs-f64 x0 in
      let t0 = (if flt-f64 x (f64-from-bits 0x0010000000000000) then
          let scaled = mul-f64 (f64-from-bits 0x4350000000000000) x in
          f64-from-bits (wrapping-add-u64 (div-u64 (f64-bits scaled) 3) (wrapping-shl-u64 696219795 32))
        else f64-from-bits (wrapping-add-u64 (div-u64 (f64-bits x) 3) (wrapping-shl-u64 715094163 32))) in
      let r0 = div-f64 (mul-f64 t0 t0) x in
      let s0 = add-f64 (f64-from-bits 0x3FE15F15F15F15F1) (mul-f64 r0 t0) in
      let t1 = mul-f64 t0 (add-f64 (f64-from-bits 0x3FD6DB6DB6DB6DB7) (div-f64 (f64-from-bits 0x3FF9B6DB6DB6DB6E) (add-f64 (add-f64 s0 (f64-from-bits 0x3FF6A0EA0EA0EA0F)) (div-f64 (f64-from-bits 0xBFE691DE2532C834) s0)))) in
      let t2 = f64-from-bits (wrapping-add-u64 (bit-and-u64 (f64-bits t1) (wrapping-shl-u64 0xFFFFFFFFC 28)) (wrapping-shl-u64 1 30)) in
      let s1 = mul-f64 t2 t2 in
      let r1 = div-f64 x s1 in
      let w = add-f64 t2 t2 in
      let r2 = div-f64 (sub-f64 r1 t2) (add-f64 w r1) in
      let t3 = add-f64 t2 (mul-f64 t2 r2) in
      if sign then neg-f64 t3 else t3

  -- | The length of the hypotenuse, sqrt(p*p + q*q), without undue overflow or underflow.
  hypot-f64 :: F64 -> F64 -> F64
  hypot-f64 p0 q0 =
    let ap = abs-f64 p0 in
    let aq = abs-f64 q0 in
    if feq-f64 ap pos-inf || feq-f64 aq pos-inf then pos-inf
    else if is-nan-f64 ap || is-nan-f64 aq then nan-f64
    else
      let p = if flt-f64 ap aq then aq else ap in
      let q = if flt-f64 ap aq then ap else aq in
      if feq-f64 p 0 then 0
      else
        let r = div-f64 q p in
        mul-f64 p (sqrt-f64 (add-f64 1 (mul-f64 r r)))

  -- ---------------------------------------------------------------------
  -- Exponentials and logarithms.
  -- ---------------------------------------------------------------------

  -- | Multiply a positive normal y by 2^k in two factors so gradual underflow rounds once.
  scale-pow2 :: F64 -> I64 -> F64
  scale-pow2 y k =
    let k1 = wrapping-shr-i64 k 1 in
    let k2 = wrapping-sub-i64 k k1 in
    let f1 = f64-from-bits (wrapping-shl-u64 (wrapping-i64-to-u64 (wrapping-add-i64 k1 1023)) 52) in
    let f2 = f64-from-bits (wrapping-shl-u64 (wrapping-i64-to-u64 (wrapping-add-i64 k2 1023)) 52) in
    mul-f64 (mul-f64 y f1) f2

  -- | Evaluate e^(hi - lo) * 2^k via minimax rational approximation.
  expmulti :: F64 -> F64 -> I64 -> F64
  expmulti hi lo k =
    let r = sub-f64 hi lo in
    let t = mul-f64 r r in
    let poly = add-f64 (f64-from-bits 0x3FC5555555555555) (mul-f64 t (add-f64 (f64-from-bits 0xBF66C16C16BEBD93) (mul-f64 t (add-f64 (f64-from-bits 0x3F11566AAF25DE2C) (mul-f64 t (add-f64 (f64-from-bits 0xBEBBBD41C5D26BF1) (mul-f64 t (f64-from-bits 0x3E66376972BEA4D0)))))))) in
    let cv = sub-f64 r (mul-f64 t poly) in
    let y = sub-f64 1 (sub-f64 (sub-f64 lo (div-f64 (mul-f64 r cv) (sub-f64 2 cv))) hi) in
    scale-pow2 y k

  -- | The natural exponential, e to the power x.
  exp-f64 :: F64 -> F64
  exp-f64 x =
    if is-nan-f64 x || feq-f64 x pos-inf then x
    else if feq-f64 x neg-inf then 0
    else if fgt-f64 x (f64-from-bits 0x40862E42FEFA39EF) then pos-inf
    else if flt-f64 x (f64-from-bits 0xC0874910D52D3051) then 0
    else if fgt-f64 x (f64-from-bits 0xBE30000000000000) && flt-f64 x (f64-from-bits 0x3E30000000000000) then add-f64 1 x
    else
      let k = (if flt-f64 x 0 then saturating-f64-to-i64 (sub-f64 (mul-f64 (f64-from-bits 0x3FF71547652B82FE) x) half)
        else if fgt-f64 x 0 then saturating-f64-to-i64 (add-f64 (mul-f64 (f64-from-bits 0x3FF71547652B82FE) x) half)
        else 0) in
      let fk = i64-to-f64 k in
      expmulti (sub-f64 x (mul-f64 fk ln2-hi)) (mul-f64 fk ln2-lo) k

  -- | Two to the power x.
  exp2-f64 :: F64 -> F64
  exp2-f64 x =
    if is-nan-f64 x || feq-f64 x pos-inf then x
    else if feq-f64 x neg-inf then 0
    else if fgt-f64 x (f64-from-bits 0x408FFFFFFFFFFFFF) then pos-inf
    else if flt-f64 x (f64-from-bits 0xC090C80000000000) then 0
    else
      let k = (if fgt-f64 x 0 then saturating-f64-to-i64 (add-f64 x half)
        else if flt-f64 x 0 then saturating-f64-to-i64 (sub-f64 x half)
        else 0) in
      let t = sub-f64 x (i64-to-f64 k) in
      expmulti (mul-f64 t ln2-hi) (mul-f64 (neg-f64 t) ln2-lo) k

  -- | Final polynomial and reconstruction step of expm1 for reduced x, correction c and exponent k.
  expm1-finish :: F64 -> F64 -> I64 -> F64
  expm1-finish x cv k =
    let hfx = mul-f64 half x in
    let hxs = mul-f64 x hfx in
    let r1 = add-f64 1 (mul-f64 hxs (add-f64 (f64-from-bits 0xBFA11111111110F4) (mul-f64 hxs (add-f64 (f64-from-bits 0x3F5A01A019FE5585) (mul-f64 hxs (add-f64 (f64-from-bits 0xBF14CE199EAADBB7) (mul-f64 hxs (add-f64 (f64-from-bits 0x3ED0CFCA86E65239) (mul-f64 hxs (f64-from-bits 0xBE8AFDB76E09C32D)))))))))) in
    let t = sub-f64 3 (mul-f64 r1 hfx) in
    let e0 = mul-f64 hxs (div-f64 (sub-f64 r1 t) (sub-f64 6 (mul-f64 x t))) in
    if eq-i64 k 0 then sub-f64 x (sub-f64 (mul-f64 x e0) hxs)
    else
      let e1 = sub-f64 (sub-f64 (mul-f64 x (sub-f64 e0 cv)) cv) hxs in
      if eq-i64 k (wrapping-neg-i64 1) then sub-f64 (mul-f64 half (sub-f64 x e1)) half
      else if eq-i64 k 1 then
        (if flt-f64 x (f64-from-bits 0xBFD0000000000000) then mul-f64 (f64-from-bits 0xC000000000000000) (sub-f64 e1 (add-f64 x half))
        else add-f64 1 (mul-f64 2 (sub-f64 x e1)))
      else if le-i64 k (wrapping-neg-i64 2) || gt-i64 k 56 then
        let y0 = sub-f64 1 (sub-f64 e1 x) in
        let y1 = f64-from-bits (wrapping-add-u64 (f64-bits y0) (wrapping-shl-u64 (wrapping-i64-to-u64 k) 52)) in
        sub-f64 y1 1
      else if lt-i64 k 20 then
        let tk = f64-from-bits (wrapping-sub-u64 0x3FF0000000000000 (shr-u64 0x20000000000000 (wrapping-i64-to-u64 k))) in
        let y0 = sub-f64 tk (sub-f64 e1 x) in
        f64-from-bits (wrapping-add-u64 (f64-bits y0) (wrapping-shl-u64 (wrapping-i64-to-u64 k) 52))
      else
        let tk = f64-from-bits (wrapping-shl-u64 (wrapping-i64-to-u64 (wrapping-sub-i64 1023 k)) 52) in
        let y0 = add-f64 (sub-f64 x (add-f64 e1 tk)) 1 in
        f64-from-bits (wrapping-add-u64 (f64-bits y0) (wrapping-shl-u64 (wrapping-i64-to-u64 k) 52))

  -- | e to the power x, minus one, accurate when x is near zero.
  expm1-f64 :: F64 -> F64
  expm1-f64 x =
    if feq-f64 x pos-inf || is-nan-f64 x then x
    else if feq-f64 x neg-inf then (f64-from-bits 0xBFF0000000000000)
    else
      let absx = abs-f64 x in
      let sign = flt-f64 x 0 in
      if fge-f64 absx (f64-from-bits 0x4043687A9F1AF2B1) && sign then (f64-from-bits 0xBFF0000000000000)
      else if fge-f64 absx (f64-from-bits 0x40862E42FEFA39EF) && not sign then pos-inf
      else if fgt-f64 absx (f64-from-bits 0x3FD62E42FEFA39EF) then
        if flt-f64 absx (f64-from-bits 0x3FF0A2B23F3BAB73) then
          let hi = if sign then add-f64 x ln2-hi else sub-f64 x ln2-hi in
          let lo = if sign then neg-f64 ln2-lo else ln2-lo in
          let k = if sign then wrapping-neg-i64 1 else 1 in
          let xr = sub-f64 hi lo in
          expm1-finish xr (sub-f64 (sub-f64 hi xr) lo) k
        else
          let k = if sign then saturating-f64-to-i64 (sub-f64 (mul-f64 (f64-from-bits 0x3FF71547652B82FE) x) half) else saturating-f64-to-i64 (add-f64 (mul-f64 (f64-from-bits 0x3FF71547652B82FE) x) half) in
          let t = i64-to-f64 k in
          let hi = sub-f64 x (mul-f64 t ln2-hi) in
          let lo = mul-f64 t ln2-lo in
          let xr = sub-f64 hi lo in
          expm1-finish xr (sub-f64 (sub-f64 hi xr) lo) k
      else if flt-f64 absx (f64-from-bits 0x3C90000000000000) then x
      else expm1-finish x 0 0

  -- | The natural logarithm.
  log-f64 :: F64 -> F64
  log-f64 x =
    if is-nan-f64 x || feq-f64 x pos-inf then x
    else if flt-f64 x 0 then nan-f64
    else if feq-f64 x 0 then neg-inf
    else (case frexp-f64 x of
      (f0, k0) ->
        let small = flt-f64 f0 (f64-from-bits 0x3FE6A09E667F3BCD) in
        let f1 = if small then mul-f64 f0 2 else f0 in
        let ki = if small then wrapping-sub-i64 k0 1 else k0 in
        let f = sub-f64 f1 1 in
        let k = i64-to-f64 ki in
        let s = div-f64 f (add-f64 2 f) in
        let s2 = mul-f64 s s in
        let s4 = mul-f64 s2 s2 in
        let t1 = mul-f64 s2 (add-f64 (f64-from-bits 0x3FE5555555555593) (mul-f64 s4 (add-f64 (f64-from-bits 0x3FD2492494229359) (mul-f64 s4 (add-f64 (f64-from-bits 0x3FC7466496CB03DE) (mul-f64 s4 (f64-from-bits 0x3FC2F112DF3E5244))))))) in
        let t2 = mul-f64 s4 (add-f64 (f64-from-bits 0x3FD999999997FA04) (mul-f64 s4 (add-f64 (f64-from-bits 0x3FCC71C51D8E78AF) (mul-f64 s4 (f64-from-bits 0x3FC39A09D078C69F))))) in
        let r = add-f64 t1 t2 in
        let hfsq = mul-f64 (mul-f64 half f) f in
        sub-f64 (mul-f64 k ln2-hi) (sub-f64 (sub-f64 hfsq (add-f64 (mul-f64 s (add-f64 hfsq r)) (mul-f64 k ln2-lo))) f))

  -- | The decimal logarithm.
  log10-f64 :: F64 -> F64
  log10-f64 x = mul-f64 (log-f64 x) (f64-from-bits 0x3FDBCB7B1526E50E)

  -- | The binary logarithm, exact for powers of two.
  log2-f64 :: F64 -> F64
  log2-f64 x =
    case frexp-f64 x of
      (frac, e) ->
        if feq-f64 frac half then i64-to-f64 (wrapping-sub-i64 e 1)
        else add-f64 (mul-f64 (log-f64 frac) (f64-from-bits 0x3FF71547652B82FE)) (i64-to-f64 e)

  -- | Finish log1p from reduced f, correction c, mantissa bits iu and exponent k.
  log1p-finish :: F64 -> F64 -> U64 -> I64 -> F64
  log1p-finish f cv iu k =
    let hfsq = mul-f64 (mul-f64 half f) f in
    if eq-u64 iu 0 then
      if feq-f64 f 0 then
        (if eq-i64 k 0 then 0
        else add-f64 (mul-f64 (i64-to-f64 k) ln2-hi) (add-f64 cv (mul-f64 (i64-to-f64 k) ln2-lo)))
      else
        let r = mul-f64 hfsq (sub-f64 1 (mul-f64 (f64-from-bits 0x3FE5555555555555) f)) in
        if eq-i64 k 0 then sub-f64 f r
        else sub-f64 (mul-f64 (i64-to-f64 k) ln2-hi) (sub-f64 (sub-f64 r (add-f64 (mul-f64 (i64-to-f64 k) ln2-lo) cv)) f)
    else
      let s = div-f64 f (add-f64 2 f) in
      let z = mul-f64 s s in
      let r = mul-f64 z (add-f64 (f64-from-bits 0x3FE5555555555593) (mul-f64 z (add-f64 (f64-from-bits 0x3FD999999997FA04) (mul-f64 z (add-f64 (f64-from-bits 0x3FD2492494229359) (mul-f64 z (add-f64 (f64-from-bits 0x3FCC71C51D8E78AF) (mul-f64 z (add-f64 (f64-from-bits 0x3FC7466496CB03DE) (mul-f64 z (add-f64 (f64-from-bits 0x3FC39A09D078C69F) (mul-f64 z (f64-from-bits 0x3FC2F112DF3E5244))))))))))))) in
      if eq-i64 k 0 then sub-f64 f (sub-f64 hfsq (mul-f64 s (add-f64 hfsq r)))
      else sub-f64 (mul-f64 (i64-to-f64 k) ln2-hi) (sub-f64 (sub-f64 hfsq (add-f64 (mul-f64 s (add-f64 hfsq r)) (add-f64 (mul-f64 (i64-to-f64 k) ln2-lo) cv))) f)

  -- | Reduce x for log1p when k != 0.
  log1p-reduce :: F64 -> F64 -> F64
  log1p-reduce x absx =
    let small53 = flt-f64 absx (f64-from-bits 0x4340000000000000) in
    let u0 = if small53 then add-f64 1 x else x in
    let iu0 = f64-bits u0 in
    let k0 = wrapping-u64-to-i64 (wrapping-sub-u64 (wrapping-shr-u64 iu0 52) 1023) in
    let cv = (if small53 then
        div-f64 (if gt-i64 k0 0 then sub-f64 1 (sub-f64 u0 x) else sub-f64 x (sub-f64 u0 1)) u0
      else 0) in
    let iu1 = bit-and-u64 iu0 0x000FFFFFFFFFFFFF in
    if lt-u64 iu1 0x0006A09E667F3BCD then
      let u1 = f64-from-bits (bit-or-u64 iu1 0x3FF0000000000000) in
      log1p-finish (sub-f64 u1 1) cv iu1 k0
    else
      let u1 = f64-from-bits (bit-or-u64 iu1 0x3FE0000000000000) in
      let iu2 = wrapping-shr-u64 (wrapping-sub-u64 0x0010000000000000 iu1) 2 in
      log1p-finish (sub-f64 u1 1) cv iu2 (wrapping-add-i64 k0 1)

  -- | The natural logarithm of 1 + x, accurate when x is near zero.
  log1p-f64 :: F64 -> F64
  log1p-f64 x =
    if flt-f64 x (f64-from-bits 0xBFF0000000000000) || is-nan-f64 x then nan-f64
    else if feq-f64 x (f64-from-bits 0xBFF0000000000000) then neg-inf
    else if feq-f64 x pos-inf then pos-inf
    else
      let absx = abs-f64 x in
      if flt-f64 absx (f64-from-bits 0x3FDA827999FCEF32) then
        if flt-f64 absx (f64-from-bits 0x3E20000000000000) then
          if flt-f64 absx (f64-from-bits 0x3C90000000000000) then x
          else sub-f64 x (mul-f64 (mul-f64 x x) half)
        else if fgt-f64 x (f64-from-bits 0xBFD2BEC333018867) then log1p-finish x 0 1 0
        else log1p-reduce x absx
      else log1p-reduce x absx

  -- ---------------------------------------------------------------------
  -- Powers.
  -- ---------------------------------------------------------------------

  -- | Whether an exponent y with integer/fractional parts (yi, yf) is an odd integer.
  is-odd-int :: F64 -> F64 -> F64 -> Bool
  is-odd-int y yi yf =
    flt-f64 (abs-f64 y) (f64-from-bits 0x4340000000000000) && feq-f64 yf 0 && eq-u64 (bit-and-u64 (wrapping-i64-to-u64 (saturating-f64-to-i64 yi)) 1) 1 && feq-f64 y y

  -- | x to the power y, with the C99 special cases (pow(x, 0) = 1 and pow(1, y) = 1 even for NaN; negative
  -- bases need integer exponents; signed zeros and infinities by parity).
  pow-f64 :: F64 -> F64 -> F64
  pow-f64 x y =
    if feq-f64 y 0 || feq-f64 x 1 then 1
    else if feq-f64 y 1 then x
    else if is-nan-f64 x || is-nan-f64 y then nan-f64
    else (case modf-f64 (abs-f64 y) of
      (yi, yf) ->
        if feq-f64 x 0 then
          let odd-y = is-odd-int y yi yf in
          let neg-x = eq-u64 (wrapping-shr-u64 (f64-bits x) 63) 1 in
          if flt-f64 y 0 then (if neg-x && odd-y then neg-inf else pos-inf)
          else if neg-x && odd-y then x
          else 0
        else if feq-f64 (abs-f64 y) pos-inf then
          if feq-f64 x (f64-from-bits 0xBFF0000000000000) then 1
          else if same (flt-f64 (abs-f64 x) 1) (feq-f64 y pos-inf) then 0
          else pos-inf
        else if feq-f64 (abs-f64 x) pos-inf then
          if feq-f64 x neg-inf then
            let odd-y = is-odd-int y yi yf in
            if flt-f64 y 0 then (if odd-y then neg-zero else 0)
            else if odd-y then neg-inf
            else pos-inf
          else if flt-f64 y 0 then 0
          else pos-inf
        else if feq-f64 y half then sqrt-f64 x
        else if feq-f64 y (f64-from-bits 0xBFE0000000000000) then div-f64 1 (sqrt-f64 x)
        else if fne-f64 yf 0 && flt-f64 x 0 then nan-f64
        else if fge-f64 yi (f64-from-bits 0x43E0000000000000) then
          if feq-f64 x (f64-from-bits 0xBFF0000000000000) then 1
          else if same (flt-f64 (abs-f64 x) 1) (fgt-f64 y 0) then 0
          else pos-inf
        else pow-general x y yi yf)

  -- | The general method: the fractional power, then repeated squaring of the split base.
  pow-general :: F64 -> F64 -> F64 -> F64 -> F64
  pow-general x y yi0 yf0 =
    let adj = fne-f64 yf0 0 && fgt-f64 yf0 half in
    let yf = if adj then sub-f64 yf0 1 else yf0 in
    let yi = if adj then add-f64 yi0 1 else yi0 in
    let a1 = if fne-f64 yf0 0 then exp-f64 (mul-f64 yf (log-f64 x)) else 1 in
    let count = wrapping-i64-to-u64 (saturating-f64-to-i64 yi) in
    case frexp-f64 x of (x1, xe) -> pow-loop a1 0 x1 xe count y

  -- | One squaring step: the accumulated fraction and exponent, the squared base and its exponent, and the
  -- remaining integer power.
  pow-loop :: F64 -> I64 -> F64 -> I64 -> U64 -> F64 -> F64
  pow-loop a1 ae x1 xe i y =
    if eq-u64 i 0 then pow-end a1 ae y
    else if lt-i64 xe (wrapping-neg-i64 4096) || lt-i64 4096 xe then pow-end a1 (wrapping-add-i64 ae xe) y
    else pow-square (pow-take a1 x1 i) (pow-take-exp ae xe i) (mul-f64 x1 x1) (wrapping-shl-i64 xe 1) (wrapping-shr-u64 i 1) y

  -- | The fraction after an odd bit takes the base.
  pow-take :: F64 -> F64 -> U64 -> F64
  pow-take a1 x1 i = if eq-u64 (bit-and-u64 i 1) 1 then mul-f64 a1 x1 else a1

  -- | The exponent after an odd bit takes the base.
  pow-take-exp :: I64 -> I64 -> U64 -> I64
  pow-take-exp ae xe i = if eq-u64 (bit-and-u64 i 1) 1 then wrapping-add-i64 ae xe else ae

  -- | Renormalize the squared base into [1/2, 1).
  pow-square :: F64 -> I64 -> F64 -> I64 -> U64 -> F64 -> F64
  pow-square a1 ae x2 xe i y = if flt-f64 x2 half then pow-loop a1 ae (add-f64 x2 x2) (wrapping-sub-i64 xe 1) i y else pow-loop a1 ae x2 xe i y

  -- | The result: inverted for negative exponents, then scaled.
  pow-end :: F64 -> I64 -> F64 -> F64
  pow-end a1 ae y = if flt-f64 y 0 then ldexp-f64 (div-f64 1 a1) (wrapping-neg-i64 ae) else ldexp-f64 a1 ae

  -- | Ten to an integer power, from exact tables.
  pow10-f64 :: I64 -> F64
  pow10-f64 n =
    if ge-i64 n 0 && le-i64 n 308 then
      let u = wrapping-i64-to-u64 n in
      mul-f64 (p10-pos32 (wrapping-shr-u64 u 5)) (p10-unit (bit-and-u64 u 31))
    else if ge-i64 n (wrapping-neg-i64 323) && le-i64 n 0 then
      let u = wrapping-i64-to-u64 (wrapping-neg-i64 n) in
      div-f64 (p10-neg32 (wrapping-shr-u64 u 5)) (p10-unit (bit-and-u64 u 31))
    else if gt-i64 n 0 then pos-inf
    else 0

  -- ---------------------------------------------------------------------
  -- Trigonometry.
  -- ---------------------------------------------------------------------

  -- | Cody-Waite three-part pi/4 argument reduction for non-negative x below 2^29.
  reduce-small :: F64 -> (U64, F64)
  reduce-small x =
    let j0 = saturating-f64-to-u64 (mul-f64 x (f64-from-bits 0x3FF45F306DC9C883)) in
    let y0 = u64-to-f64 j0 in
    let odd-j = eq-u64 (bit-and-u64 j0 1) 1 in
    let j = bit-and-u64 (if odd-j then wrapping-add-u64 j0 1 else j0) 7 in
    let y = if odd-j then add-f64 y0 1 else y0 in
    let z = sub-f64 (sub-f64 (sub-f64 x (mul-f64 y (f64-from-bits 0x3FE921FB40000000))) (mul-f64 y (f64-from-bits 0x3E64442D00000000))) (mul-f64 y (f64-from-bits 0x3CE8469898CC5170)) in
    (j, z)

  -- | Payne-Hanek 1216-bit 4/pi argument reduction for large non-negative x.
  reduce-large :: F64 -> (U64, F64)
  reduce-large x =
    if flt-f64 x pi-quarter then (0, x)
    else
      let ix0 = f64-bits x in
      let e = wrapping-sub-i64 (wrapping-sub-i64 (wrapping-u64-to-i64 (bit-and-u64 (wrapping-shr-u64 ix0 52) 2047)) 1023) 52 in
      let ix = bit-or-u64 (bit-and-u64 ix0 (bit-not-u64 (wrapping-shl-u64 2047 52))) (wrapping-shl-u64 1 52) in
      let ep = wrapping-i64-to-u64 (wrapping-add-i64 e 61) in
      let digit = wrapping-shr-u64 ep 6 in
      let shift = bit-and-u64 ep 63 in
      let inv = wrapping-sub-u64 64 shift in
      let d0 = mpi4 digit in
      let d1 = mpi4 (wrapping-add-u64 digit 1) in
      let d2 = mpi4 (wrapping-add-u64 digit 2) in
      let d3 = mpi4 (wrapping-add-u64 digit 3) in
      let z0 = bit-or-u64 (shl-u64 d0 shift) (shr-u64 d1 inv) in
      let z1 = bit-or-u64 (shl-u64 d1 shift) (shr-u64 d2 inv) in
      let z2 = bit-or-u64 (shl-u64 d2 shift) (shr-u64 d3 inv) in
      case mul-u64-wide z2 ix of
        (z2hi, z2lo) -> (case mul-u64-wide z1 ix of
          (z1hi, z1lo) ->
            let z0lo = wrapping-mul-u64 z0 ix in
            let lo = wrapping-add-u64 z1lo z2hi in
            let carry = if lt-u64 lo z1lo then (1 :: U64) else 0 in
            let hi0 = wrapping-add-u64 (wrapping-add-u64 z0lo z1hi) carry in
            let j0 = wrapping-shr-u64 hi0 61 in
            let hi1 = bit-or-u64 (wrapping-shl-u64 hi0 3) (wrapping-shr-u64 lo 61) in
            let lz = clz-u64 hi1 in
            let lz1 = wrapping-add-u64 lz 1 in
            let ex = wrapping-sub-u64 1023 lz1 in
            let hi2 = bit-or-u64 (shl-u64 hi1 lz1) (shr-u64 lo (wrapping-sub-u64 64 lz1)) in
            let hi3 = bit-or-u64 (wrapping-shr-u64 hi2 12) (wrapping-shl-u64 ex 52) in
            let z = f64-from-bits hi3 in
            if eq-u64 (bit-and-u64 j0 1) 1 then (bit-and-u64 (wrapping-add-u64 j0 1) 7, mul-f64 (sub-f64 z 1) pi-quarter)
            else (j0, mul-f64 z pi-quarter))

  -- | Reduce a non-negative argument into an octant and residual in [-pi/4, pi/4].
  reduce-trig :: F64 -> (U64, F64)
  reduce-trig x = if flt-f64 x reduce-threshold then reduce-small x else reduce-large x

  -- | Minimax polynomial for sin(z) on [-pi/4, pi/4].
  sin-poly :: F64 -> F64
  sin-poly z =
    let zz = mul-f64 z z in
    add-f64 z (mul-f64 (mul-f64 z zz) (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (f64-from-bits 0x3DE5D8FD1FD19CCD) zz) (f64-from-bits 0xBE5AE5E5A9291F5D)) zz) (f64-from-bits 0x3EC71DE3567D48A1)) zz) (f64-from-bits 0xBF2A01A019BFDF03)) zz) (f64-from-bits 0x3F8111111110F7D0)) zz) (f64-from-bits 0xBFC5555555555548)))

  -- | Minimax polynomial for cos(z) on [-pi/4, pi/4].
  cos-poly :: F64 -> F64
  cos-poly z =
    let zz = mul-f64 z z in
    add-f64 (sub-f64 1 (mul-f64 half zz)) (mul-f64 (mul-f64 zz zz) (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (f64-from-bits 0xBDA8FA49A0861A9B) zz) (f64-from-bits 0x3E21EE9D7B4E3F05)) zz) (f64-from-bits 0xBE927E4F7EAC4BC6)) zz) (f64-from-bits 0x3EFA01A019C844F5)) zz) (f64-from-bits 0xBF56C16C16C14F91)) zz) (f64-from-bits 0x3FA555555555554B)))

  -- | Reconstruct sine from octant j and residual z.
  sin-octant :: U64 -> F64 -> F64
  sin-octant j0 z =
    let flip = gt-u64 j0 3 in
    let j = if flip then wrapping-sub-u64 j0 4 else j0 in
    let y = if eq-u64 j 1 || eq-u64 j 2 then cos-poly z else sin-poly z in
    if flip then neg-f64 y else y

  -- | Reconstruct cosine from octant j and residual z.
  cos-octant :: U64 -> F64 -> F64
  cos-octant j0 z =
    let gt3 = gt-u64 j0 3 in
    let j = if gt3 then wrapping-sub-u64 j0 4 else j0 in
    let flip = if gt-u64 j 1 then not gt3 else gt3 in
    let y = if eq-u64 j 1 || eq-u64 j 2 then sin-poly z else cos-poly z in
    if flip then neg-f64 y else y

  -- | Reconstruct tangent from octant j and residual z.
  tan-octant :: U64 -> F64 -> F64
  tan-octant j z =
    let zz = mul-f64 z z in
    let y = (if fgt-f64 zz (f64-from-bits 0x3D06849B86A12B9B) then
        let num = add-f64 (mul-f64 (add-f64 (mul-f64 (f64-from-bits 0xC0C992D8D24F3F38) zz) (f64-from-bits 0x413199ECA5FC9DDD)) zz) (f64-from-bits 0xC1711FEAD3299176) in
