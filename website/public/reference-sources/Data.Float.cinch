      %v9 = select i1 %v3, double %v8, double %0
      %v10 = fmul double 0x3FE0000000000000, %1
      %v11 = fcmp ogt double %0, %v10
      %v12 = fsub double %0, %1
      %v13 = fcmp oge double %v12, %v10
      %v14 = fsub double %v12, %1
