            let u = sub-f64 t 5 in
            let z1 = add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (f64-from-bits 0x3E8AFB74D693BF93) u) (f64-from-bits 0x3EFC6EC6CC59E02A)) u) (f64-from-bits 0x3F545C1908425345)) u) (f64-from-bits 0x3F9B2B41193B4EE7)) u) (f64-from-bits 0x3FD2FAD9315255CF)) u) (f64-from-bits 0x3FFC8EA6461FA445)) u) (f64-from-bits 0x4015DAEA6E875003)) u) (f64-from-bits 0x401AA1B1C13EE526) in
            let z2 = add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (f64-from-bits 0x3CEA0A3FB665CB0A) u) (f64-from-bits 0x3E8AFB693C174D20)) u) (f64-from-bits 0x3EFB61164A01861A)) u) (f64-from-bits 0x3F523B6CF8EC177A)) u) (f64-from-bits 0x3F958AB4FD6BCD50)) u) (f64-from-bits 0x3FC8C975F4D2F24B)) u) (f64-from-bits 0x3FEB2532D5CD90E5)) u) (f64-from-bits 0x3FF6A09E667F3BCD) in
            div-f64 z1 z2
          else
            let u = sub-f64 t (f64-from-bits 0x3FF999999999999A) in
            let z1 = add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (f64-from-bits 0x3F49615AC0B7ACE9) u) (f64-from-bits 0x3F9744EB6C45EC67)) u) (f64-from-bits 0x3FCEF2ABB9B85C37)) u) (f64-from-bits 0x3FF453CC085375B2)) u) (f64-from-bits 0x400D2ECB1A3D02C4)) u) (f64-from-bits 0x401713F71462256A)) u) (f64-from-bits 0x4012857748CAB19B)) u) (f64-from-bits 0x3FF6C665FDE9526A) in
            let z2 = add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (f64-from-bits 0x3E19876E6013E192) u) (f64-from-bits 0x3F496042AB9205BE)) u) (f64-from-bits 0x3F960290AF9F12BC)) u) (f64-from-bits 0x3FCACF476A756D3D)) u) (f64-from-bits 0x3FEF371E4F4DE1A0)) u) (f64-from-bits 0x4002F7543FF6BA47)) u) (f64-from-bits 0x40073AAD9BCA5405)) u) (f64-from-bits 0x3FF6A09E667F3BCD) in
            div-f64 z1 z2
        else
          let r = sub-f64 (f64-from-bits 0x3FC71EB851EB851F) (mul-f64 (mul-f64 (f64-from-bits 0x3FD0000000000000) x) x) in
          let num = mul-f64 x (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (f64-from-bits 0x408BB8C0A7936704) r) (f64-from-bits 0x40C715BF25FF1D11)) r) (f64-from-bits 0x40D73982A6012AFB)) r) (f64-from-bits 0x40CFB5EE66E5A285)) r) (f64-from-bits 0x40B2F6E30B2EC51E)) r) (f64-from-bits 0x4085C88056B01502)) r) (f64-from-bits 0x4047894DD814BFA3)) r) (f64-from-bits 0x3FF32917A42157D1)) in
          let den = add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (f64-from-bits 0x40B46A7ECA984B69) r) (f64-from-bits 0x40DC0E457CB1AE76)) r) (f64-from-bits 0x40E3317CAA64F4BE)) r) (f64-from-bits 0x40D4B772D5D65266)) r) (f64-from-bits 0x40B512322E75C89F)) r) (f64-from-bits 0x4085797EFDC8B3F7)) r) (f64-from-bits 0x4045281B386E1AB5)) r) (f64-from-bits 0x3FF0000000000000) in
          div-f64 num den) in
