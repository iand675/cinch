      %v51 = select i1 %v48, double %v50, double %1
      %v52 = select i1 %v48, i1 true, i1 %v35
      %v53 = icmp sgt i64 %v47, 1023
      %v54 = fcmp olt double %v40, 0x0000000000000000
      %v55 = select i1 %v52, double %v51, double 0xFFF0000000000000
      %v56 = select i1 %v54, double %v55, double %v51
      %v57 = select i1 %v54, i1 true, i1 %v52
      %v58 = select i1 %v57, double %v56, double 0x7FF0000000000000
      %v59 = select i1 %v53, double %v58, double %v51
