      %v20 = select i1 %v18, i1 true, i1 false
      %v21 = select i1 %v20, double %v19, double %v17
      ret double %v21
    }

  -- | The sine for arguments below 2^29 in magnitude.
  prim sin-small :: F64 -> F64 where
    llvm {
      %v1 = fcmp oeq double %0, 0x0000000000000000
      %v2 = fcmp uno double %0, 0.0
