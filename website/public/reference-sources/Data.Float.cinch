  y0-f64 x =
    if flt-f64 x 0 || is-nan-f64 x then nan-f64
    else if feq-f64 x pos-inf then 0
    else if feq-f64 x 0 then neg-inf
    else if fge-f64 x 2 then
      (case bessel-phase0 x of
        (ss, cc) ->
          if fle-f64 x (f64-from-bits 0x4800000000000000) then div-f64 (mul-f64 (f64-from-bits 0x3FE20DD750429B6D) (add-f64 (mul-f64 (pzero x) ss) (mul-f64 (qzero x) cc))) (sqrt-f64 x)
          else div-f64 (mul-f64 (f64-from-bits 0x3FE20DD750429B6D) ss) (sqrt-f64 x))
    else if fle-f64 x (f64-from-bits 0x3E40000000000000) then add-f64 (f64-from-bits 0xBFB2E4D699CBD01F) (mul-f64 (f64-from-bits 0x3FE45F306DC9C883) (log-f64 x))
    else
      let z = mul-f64 x x in
      let u = add-f64 (f64-from-bits 0xBFB2E4D699CBD01F) (mul-f64 z (add-f64 (f64-from-bits 0x3FC69D019DE9E3FC) (mul-f64 z (add-f64 (f64-from-bits 0xBF8C4CE8B16CFA97) (mul-f64 z (add-f64 (f64-from-bits 0x3F36C54D20B29B6B) (mul-f64 z (add-f64 (f64-from-bits 0xBECFFEA773D25CAD) (mul-f64 z (add-f64 (f64-from-bits 0x3E5500573B4EABD4) (mul-f64 z (f64-from-bits 0xBDC5E43D693FB3C8)))))))))))) in
      let v = add-f64 1 (mul-f64 z (add-f64 (f64-from-bits 0x3F8A127091C9C71A) (mul-f64 z (add-f64 (f64-from-bits 0x3F13ECBBF578C6C1) (mul-f64 z (add-f64 (f64-from-bits 0x3E91642D7FF202FD) (mul-f64 z (f64-from-bits 0x3DFE50183BD6D9EF)))))))) in
      add-f64 (div-f64 u v) (mul-f64 (mul-f64 (f64-from-bits 0x3FE45F306DC9C883) (j0-poly x)) (log-f64 x))

  -- | The Bessel function of the first kind of order one.
  j1-f64 :: F64 -> F64
  j1-f64 x0 =
    if is-nan-f64 x0 then x0
    else if feq-f64 (abs-f64 x0) pos-inf || feq-f64 x0 0 then 0
    else
      let sign = flt-f64 x0 0 in
      let x = if sign then neg-f64 x0 else x0 in
      let z = (if fge-f64 x 2 then
          (case bessel-phase1 x of
            (ss, cc) ->
              if fle-f64 x (f64-from-bits 0x4800000000000000) then div-f64 (mul-f64 (f64-from-bits 0x3FE20DD750429B6D) (sub-f64 (mul-f64 (pone x) cc) (mul-f64 (qone x) ss))) (sqrt-f64 x)
              else div-f64 (mul-f64 (f64-from-bits 0x3FE20DD750429B6D) cc) (sqrt-f64 x))
        else j1-poly x) in
      if sign then neg-f64 z else z

  -- | The Bessel function of the second kind of order one; NaN for negative x, -Inf at zero.
  y1-f64 :: F64 -> F64
  y1-f64 x =
    if flt-f64 x 0 || is-nan-f64 x then nan-f64
    else if feq-f64 x pos-inf then 0
    else if feq-f64 x 0 then neg-inf
    else if fge-f64 x 2 then
      (case bessel-phase1 x of
        (ss, cc) ->
          if fle-f64 x (f64-from-bits 0x4800000000000000) then div-f64 (mul-f64 (f64-from-bits 0x3FE20DD750429B6D) (add-f64 (mul-f64 (pone x) ss) (mul-f64 (qone x) cc))) (sqrt-f64 x)
          else div-f64 (mul-f64 (f64-from-bits 0x3FE20DD750429B6D) ss) (sqrt-f64 x))
    else if fle-f64 x (f64-from-bits 0x3C90000000000000) then div-f64 (neg-f64 (f64-from-bits 0x3FE45F306DC9C883)) x
    else
      let z = mul-f64 x x in
      let u = add-f64 (f64-from-bits 0xBFC91866143CBC8A) (mul-f64 z (add-f64 (f64-from-bits 0x3FA9D3C776292CD1) (mul-f64 z (add-f64 (f64-from-bits 0xBF5F55E54844F50F) (mul-f64 z (add-f64 (f64-from-bits 0x3EF8AB038FA6B88E) (mul-f64 z (f64-from-bits 0xBE78AC00569105B8)))))))) in
      let v = add-f64 1 (mul-f64 z (add-f64 (f64-from-bits 0x3F94650D3F4DA9F0) (mul-f64 z (add-f64 (f64-from-bits 0x3F2A8C896C257764) (mul-f64 z (add-f64 (f64-from-bits 0x3EB6C05A894E8CA6) (mul-f64 z (add-f64 (f64-from-bits 0x3E3ABF1D5BA69A86) (mul-f64 z (f64-from-bits 0x3DB25039DACA772A)))))))))) in
      add-f64 (mul-f64 x (div-f64 u v)) (mul-f64 (f64-from-bits 0x3FE45F306DC9C883) (sub-f64 (mul-f64 (j1-poly x) (log-f64 x)) (div-f64 1 x)))

  -- | The large-argument form of the first kind: sin and cos combined by n mod 4, over sqrt(pi x).
  bessel-asymptotic :: I64 -> F64 -> F64
  bessel-asymptotic n x =
    case sincos-f64 x of
      (s, cv) ->
        let q = bit-and-i64 n 3 in
        let t = (if eq-i64 q 0 then add-f64 cv s
          else if eq-i64 q 1 then add-f64 (neg-f64 cv) s
          else if eq-i64 q 2 then sub-f64 (neg-f64 cv) s
          else sub-f64 cv s) in
        div-f64 (mul-f64 (f64-from-bits 0x3FE20DD750429B6D) t) (sqrt-f64 x)

  -- | The large-argument form of the second kind: sin and cos combined by n mod 4, over sqrt(pi x).
  bessel-asymptotic-second :: I64 -> F64 -> F64
  bessel-asymptotic-second n x =
    case sincos-f64 x of
      (s, cv) ->
        let q = bit-and-i64 n 3 in
        let t = (if eq-i64 q 0 then sub-f64 s cv
          else if eq-i64 q 1 then sub-f64 (neg-f64 s) cv
          else if eq-i64 q 2 then add-f64 (neg-f64 s) cv
          else add-f64 s cv) in
        div-f64 (mul-f64 (f64-from-bits 0x3FE20DD750429B6D) t) (sqrt-f64 x)

  -- | Whether an integer is odd.
  odd :: I64 -> Bool
  odd n = eq-i64 (bit-and-i64 n 1) 1

  -- | The Bessel function of the first kind of integer order n.
  jn-f64 :: I64 -> F64 -> F64
  jn-f64 n x =
    if is-nan-f64 x then x
    else if is-inf-f64 x 0 then 0
    else if eq-i64 n 0 then j0-f64 x
    else if feq-f64 x 0 then 0
    else if lt-i64 n 0 then jn-order (wrapping-neg-i64 n) (neg-f64 x)
    else jn-order n x

  -- | Order one directly; higher orders on |x| with the sign of an odd order.
  jn-order :: I64 -> F64 -> F64
  jn-order n x = if eq-i64 n 1 then j1-f64 x else jn-signed (flt-f64 x 0 && odd n) n (abs-f64 x)

  -- | A magnitude with its sign applied.
  jn-signed :: Bool -> I64 -> F64 -> F64
  jn-signed sign n x = let b = jn-magnitude n x in if sign then neg-f64 b else b

  -- | J_n(x) for n >= 2 and x > 0: forward recurrence when n <= x, the power series start for tiny x, otherwise
  -- the continued fraction with backward recurrence.
  jn-magnitude :: I64 -> F64 -> F64
  jn-magnitude n x =
    if fle-f64 (i64-to-f64 n) x then (if fge-f64 x (f64-from-bits 0x52D0000000000000) then bessel-asymptotic n x else jn-up (j0-f64 x) (j1-f64 x) 1 n x)
    else if flt-f64 x (f64-from-bits 0x3E20000000000000) then (if gt-i64 n 33 then 0 else jn-tiny (mul-f64 x half) (mul-f64 x half) 1 2 n)
    else jn-backward n x

  -- | Forward recurrence J_{i+1} = (2i/x) J_i - J_{i-1} up to order n.
  jn-up :: F64 -> F64 -> I64 -> I64 -> F64 -> F64
  jn-up a b i n x = if lt-i64 i n then jn-up b (sub-f64 (mul-f64 b (div-f64 (i64-to-f64 (wrapping-add-i64 i i)) x)) a) (wrapping-add-i64 i 1) n x else b

  -- | The leading power-series term (x/2)^n / n!.
  jn-tiny :: F64 -> F64 -> F64 -> I64 -> I64 -> F64
  jn-tiny temp b a i n = if le-i64 i n then jn-tiny temp (mul-f64 b temp) (mul-f64 a (i64-to-f64 i)) (wrapping-add-i64 i 1) n else div-f64 b a

  -- | The continued fraction for J_n / J_{n-1}, then backward recurrence normalized by J_0.
  jn-backward :: I64 -> F64 -> F64
  jn-backward n x =
    let w = div-f64 (i64-to-f64 (wrapping-add-i64 n n)) x in
    let h = div-f64 2 x in
    let k = cf-terms w (sub-f64 (mul-f64 w (add-f64 w h)) 1) (add-f64 w h) h 1 in
    let t = cf-value 0 (wrapping-mul-i64 2 (wrapping-add-i64 n k)) (wrapping-add-i64 n n) x in
    jn-normalize n x t

  -- | The number of continued-fraction terms: until the recurrence passes 10^9.
  cf-terms :: F64 -> F64 -> F64 -> F64 -> I64 -> I64
  cf-terms q0 q1 z h k = if flt-f64 q1 (f64-from-bits 0x41CDCD6500000000) then cf-terms q1 (sub-f64 (mul-f64 (add-f64 z h) q1) q0) (add-f64 z h) h (wrapping-add-i64 k 1) else k

  -- | The continued fraction evaluated from its tail.
  cf-value :: F64 -> I64 -> I64 -> F64 -> F64
  cf-value t i m x = if ge-i64 i m then cf-value (div-f64 1 (sub-f64 (div-f64 (i64-to-f64 i) x) t)) (wrapping-sub-i64 i 2) m x else t

  -- | The backward recurrence from (t, 1), rescaled when it could overflow, then normalized by J_0.
  jn-normalize :: I64 -> F64 -> F64 -> F64
  jn-normalize n x t =
    let tmp = mul-f64 (i64-to-f64 n) (log-f64 (abs-f64 (mul-f64 (div-f64 2 x) (i64-to-f64 n)))) in
    if flt-f64 tmp (f64-from-bits 0x40862E42FEFA39EF) then div-f64 (mul-f64 t (j0-f64 x)) (down-plain t 1 (wrapping-sub-i64 n 1) x)
    else (case down-scaled t 1 (wrapping-sub-i64 n 1) x t of (b, s) -> div-f64 (mul-f64 s (j0-f64 x)) b)

  -- | Backward recurrence J_{i-1} = (2i/x) J_i - J_{i+1} down to order 1.
  down-plain :: F64 -> F64 -> I64 -> F64 -> F64
  down-plain a b i x = if gt-i64 i 0 then down-plain b (down-next a b i x) (wrapping-sub-i64 i 1) x else b

  -- | One backward step.
  down-next :: F64 -> F64 -> I64 -> F64 -> F64
  down-next a b i x = sub-f64 (div-f64 (mul-f64 b (i64-to-f64 (wrapping-add-i64 i i))) x) a

  -- | The backward recurrence rescaling by the latest value whenever it passes 10^100; the final value and the
  -- rescaled start.
  down-scaled :: F64 -> F64 -> I64 -> F64 -> F64 -> (F64, F64)
  down-scaled a b i x t = if gt-i64 i 0 then down-rescale b (down-next a b i x) i x t else (b, t)

  -- | Rescale after a step when the value is large.
  down-rescale :: F64 -> F64 -> I64 -> F64 -> F64 -> (F64, F64)
  down-rescale b nb i x t = if fgt-f64 nb (f64-from-bits 0x54B249AD2594C37D) then down-scaled (div-f64 b nb) 1 (wrapping-sub-i64 i 1) x (div-f64 t nb) else down-scaled b nb (wrapping-sub-i64 i 1) x t

  -- | The Bessel function of the second kind of integer order n; NaN for negative x.
  yn-f64 :: I64 -> F64 -> F64
  yn-f64 n x =
    if flt-f64 x 0 || is-nan-f64 x then nan-f64
    else if is-inf-f64 x 1 then 0
    else if eq-i64 n 0 then y0-f64 x
    else if feq-f64 x 0 then (if lt-i64 n 0 && odd n then pos-inf else neg-inf)
    else yn-order (lt-i64 n 0 && odd n) (if lt-i64 n 0 then wrapping-neg-i64 n else n) x

  -- | Y_n for a positive order, with a sign applied.
  yn-order :: Bool -> I64 -> F64 -> F64
  yn-order sign n x = let b = (if eq-i64 n 1 then y1-f64 x else yn-magnitude n x) in if sign then neg-f64 b else b

  -- | The large-argument form, or forward recurrence from Y_0 and Y_1.
  yn-magnitude :: I64 -> F64 -> F64
  yn-magnitude n x = if fge-f64 x (f64-from-bits 0x52D0000000000000) then bessel-asymptotic-second n x else yn-up (y0-f64 x) (y1-f64 x) 1 n x

  -- | Forward recurrence until order n or -Inf.
  yn-up :: F64 -> F64 -> I64 -> I64 -> F64 -> F64
  yn-up a b i n x = if lt-i64 i n && not (is-inf-f64 b (wrapping-neg-i64 1)) then yn-up b (sub-f64 (mul-f64 (div-f64 (i64-to-f64 (wrapping-add-i64 i i)) x) b) a) (wrapping-add-i64 i 1) n x else b

  -- ---------------------------------------------------------------------
  -- Exact fused multiply-add.
  -- ---------------------------------------------------------------------

  -- | 1 when x is zero, 0 otherwise.
  fma-zero :: U64 -> U64
  fma-zero x = if eq-u64 x 0 then 1 else 0

  -- | 0 when x is zero, 1 otherwise.
  fma-nonzero :: U64 -> U64
  fma-nonzero x = if eq-u64 x 0 then 0 else 1

  -- | 128-bit left shift of (u1, u2) by n bits.
  fma-shl :: U64 -> U64 -> U64 -> (U64, U64)
  fma-shl u1 u2 n =
    (bit-or-u64 (bit-or-u64 (shl-u64 u1 n) (shr-u64 u2 (wrapping-sub-u64 64 n))) (shl-u64 u2 (wrapping-sub-u64 n 64)), shl-u64 u2 n)

  -- | 128-bit right shift of (u1, u2) by n bits.
  fma-shr :: U64 -> U64 -> U64 -> (U64, U64)
  fma-shr u1 u2 n =
    (shr-u64 u1 n, bit-or-u64 (bit-or-u64 (shr-u64 u2 n) (shl-u64 u1 (wrapping-sub-u64 64 n))) (shr-u64 u1 (wrapping-sub-u64 n 64)))

  -- | 128-bit right shift of (u1, u2) by n bits with sticky bit folded into bit 0.
  fma-shrcompress :: U64 -> U64 -> U64 -> (U64, U64)
  fma-shrcompress u1 u2 n =
    if eq-u64 n 0 then (u1, u2)
    else if eq-u64 n 64 then (0, bit-or-u64 u1 (fma-nonzero u2))
    else if ge-u64 n 128 then (0, fma-nonzero (bit-or-u64 u1 u2))
    else (case fma-shr u1 u2 n of
      (r1, r2) ->
        let sticky = (if lt-u64 n 64 then fma-nonzero (bit-and-u64 u2 (wrapping-sub-u64 (shl-u64 1 n) 1))
          else fma-nonzero (bit-or-u64 (bit-and-u64 u1 (wrapping-sub-u64 (shl-u64 1 (wrapping-sub-u64 n 64)) 1)) u2)) in
        (r1, bit-or-u64 r2 sticky))

  -- | Leading zeros of a 128-bit unsigned integer (u1, u2).
  fma-lz :: U64 -> U64 -> I64
  fma-lz u1 u2 =
    let l = u32-to-i64 (leading-zeros-u64 u1) in
    if eq-i64 l 64 then wrapping-add-i64 l (u32-to-i64 (leading-zeros-u64 u2)) else l

  -- | Split a finite nonzero binary64 word into (sign bit, normalized biased exponent, 53-bit significand).
  fma-split :: U64 -> (U64, I64, U64)
  fma-split b =
    let sign = wrapping-shr-u64 b 63 in
    let e = wrapping-u64-to-i64 (bit-and-u64 (wrapping-shr-u64 b 52) 2047) in
    let m = bit-and-u64 b 0x000FFFFFFFFFFFFF in
    if eq-i64 e 0 then
      let shift = wrapping-sub-u64 (clz-u64 m) 11 in
      (sign, wrapping-sub-i64 1 (wrapping-u64-to-i64 shift), shl-u64 m shift)
    else (sign, e, bit-or-u64 m (wrapping-shl-u64 1 52))

  -- | Round and pack the normalized FMA significand and exponent.
  fma-round :: U64 -> I64 -> U64 -> F64
  fma-round ps pe0 m0 =
    if gt-i64 pe0 2045 || (eq-i64 pe0 2045 && eq-u64 (wrapping-shr-u64 (wrapping-add-u64 m0 512) 63) 1) then
      f64-from-bits (bit-or-u64 (wrapping-shl-u64 ps 63) 0x7FF0000000000000)
    else
      let neg-e = lt-i64 pe0 0 in
      let n = wrapping-i64-to-u64 (wrapping-neg-i64 pe0) in
      let m1 = if neg-e then bit-or-u64 (shr-u64 m0 n) (fma-nonzero (bit-and-u64 m0 (wrapping-sub-u64 (shl-u64 1 n) 1))) else m0 in
      let pe1 = if neg-e then (0 :: I64) else pe0 in
      let m2 = bit-and-u64 (wrapping-shr-u64 (wrapping-add-u64 m1 512) 10) (bit-not-u64 (fma-zero (bit-xor-u64 (bit-and-u64 m1 1023) 512))) in
      let pe2 = bit-and-i64 pe1 (wrapping-neg-i64 (wrapping-u64-to-i64 (fma-nonzero m2))) in
      f64-from-bits (wrapping-add-u64 (wrapping-add-u64 (wrapping-shl-u64 ps 63) (wrapping-shl-u64 (wrapping-i64-to-u64 pe2) 52)) m2)

  -- | Add or subtract the aligned FMA product (ps, pe, pm1, pm2) and addend (zs, ze, zm1, zm2) where product >= addend.
  fma-combine :: U64 -> I64 -> U64 -> U64 -> U64 -> I64 -> U64 -> U64 -> F64
  fma-combine ps pe pm1 pm2 zs ze zm1 zm2 =
    if not (eq-u64 ps zs) && eq-i64 pe ze && eq-u64 pm1 zm1 && eq-u64 pm2 zm2 then 0
    else (case fma-shrcompress zm1 zm2 (wrapping-i64-to-u64 (wrapping-sub-i64 pe ze)) of
      (az1, az2) ->
        if eq-u64 ps zs then
          let lo = wrapping-add-u64 pm2 az2 in
          let carry = if lt-u64 lo pm2 then (1 :: U64) else 0 in
          let hi = wrapping-add-u64 (wrapping-add-u64 pm1 az1) carry in
          let pe1 = wrapping-sub-i64 pe (wrapping-u64-to-i64 (wrapping-shr-u64 (bit-not-u64 hi) 63)) in
          case fma-shrcompress hi lo (wrapping-add-u64 64 (wrapping-shr-u64 hi 63)) of
            (r1, m) -> fma-round ps pe1 m
        else
          let lo = wrapping-sub-u64 pm2 az2 in
          let borrow = if lt-u64 pm2 az2 then (1 :: U64) else 0 in
          let hi = wrapping-sub-u64 (wrapping-sub-u64 pm1 az1) borrow in
          let nz = fma-lz hi lo in
          let pe1 = wrapping-sub-i64 pe nz in
          case fma-shl hi lo (wrapping-i64-to-u64 (wrapping-sub-i64 nz 1)) of
            (m0, rem2) -> fma-round ps pe1 (bit-or-u64 m0 (fma-nonzero rem2)))

  -- | x * y + z computed exactly and rounded once (round to nearest, ties to even).
  fma-f64 :: F64 -> F64 -> F64 -> F64
  fma-f64 x y z =
    let bx = f64-bits x in
    let by = f64-bits y in
    let bz = f64-bits z in
    if feq-f64 x 0 || feq-f64 y 0 || feq-f64 z 0 || eq-u64 (bit-and-u64 bx 0x7FF0000000000000) 0x7FF0000000000000 || eq-u64 (bit-and-u64 by 0x7FF0000000000000) 0x7FF0000000000000 then
      add-f64 (mul-f64 x y) z
    else if eq-u64 (bit-and-u64 bz 0x7FF0000000000000) 0x7FF0000000000000 then z
    else (case fma-split bx of
      (xs, xe, xm) -> (case fma-split by of
        (ys, ye, ym) -> (case fma-split bz of
          (zs, ze, zm) ->
            let pe0 = wrapping-add-i64 (wrapping-sub-i64 (wrapping-add-i64 xe ye) 1023) 1 in
            case mul-u64-wide (wrapping-shl-u64 xm 10) (wrapping-shl-u64 ym 11) of
              (pm1a, pm2a) ->
                let zm1 = wrapping-shl-u64 zm 10 in
                let ps = bit-xor-u64 xs ys in
                let is62zero = bit-and-u64 (wrapping-shr-u64 (bit-not-u64 pm1a) 62) 1 in
                case fma-shl pm1a pm2a is62zero of
                  (pm1, pm2) ->
                    let pe = wrapping-sub-i64 pe0 (wrapping-u64-to-i64 is62zero) in
                    if lt-i64 pe ze || (eq-i64 pe ze && lt-u64 pm1 zm1) then
                      fma-combine zs ze zm1 0 ps pe pm1 pm2
                    else fma-combine ps pe pm1 pm2 zs ze zm1 0)))

  -- ---------------------------------------------------------------------
  -- Constant lookup tables.
  -- ---------------------------------------------------------------------

  -- | 1216-bit binary expansion of 4/pi (20 words) for Payne-Hanek trigonometric reduction.
  mpi4 :: U64 -> U64
  mpi4 i = case wrapping-u64-to-u32 i of
    0 -> 0x0000000000000001
    1 -> 0x45F306DC9C882A53
    2 -> 0xF84EAFA3EA69BB81
    3 -> 0xB6C52B3278872083
    4 -> 0xFCA2C757BD778AC3
    5 -> 0x6E48DC74849BA5C0
    6 -> 0x0C925DD413A32439
    7 -> 0xFC3BD63962534E7D
    8 -> 0xD1046BEA5D768909
    9 -> 0xD338E04D68BEFC82
    10 -> 0x7323AC7306A673E9
    11 -> 0x3908BF177BF25076
    12 -> 0x3FF12FFFBC0B301F
    13 -> 0xDE5E2316B414DA3E
    14 -> 0xDA6CFD9E4F96136E
    15 -> 0x9E8C7ECD3CBFD45A
    16 -> 0xEA4F758FD7CBE2F6
    17 -> 0x7A0E73EF14A525D4
    18 -> 0xD7F6BF623F1ABA10
    19 -> 0xAC06608DF8F6D757
    _ -> 0

  -- | Exact powers of ten 10^0 .. 10^31.
  p10-unit :: U64 -> F64
  p10-unit i = f64-from-bits (case wrapping-u64-to-u32 (bit-and-u64 i 31) of
    0 -> 0x3FF0000000000000
    1 -> 0x4024000000000000
    2 -> 0x4059000000000000
    3 -> 0x408F400000000000
    4 -> 0x40C3880000000000
    5 -> 0x40F86A0000000000
    6 -> 0x412E848000000000
    7 -> 0x416312D000000000
    8 -> 0x4197D78400000000
    9 -> 0x41CDCD6500000000
    10 -> 0x4202A05F20000000
    11 -> 0x42374876E8000000
    12 -> 0x426D1A94A2000000
    13 -> 0x42A2309CE5400000
    14 -> 0x42D6BCC41E900000
    15 -> 0x430C6BF526340000
    16 -> 0x4341C37937E08000
    17 -> 0x4376345785D8A000
    18 -> 0x43ABC16D674EC800
    19 -> 0x43E158E460913D00
    20 -> 0x4415AF1D78B58C40
    21 -> 0x444B1AE4D6E2EF50
    22 -> 0x4480F0CF064DD592
    23 -> 0x44B52D02C7E14AF6
    24 -> 0x44EA784379D99DB4
    25 -> 0x45208B2A2C280291
    26 -> 0x4554ADF4B7320335
    27 -> 0x4589D971E4FE8402
    28 -> 0x45C027E72F1F1281
    29 -> 0x45F431E0FAE6D721
    30 -> 0x46293E5939A08CEA
    31 -> 0x465F8DEF8808B024
    _ -> 0)

  -- | Exact powers of ten 10^(32*k) for k in 0 .. 9.
  p10-pos32 :: U64 -> F64
  p10-pos32 i = f64-from-bits (case wrapping-u64-to-u32 i of
    0 -> 0x3FF0000000000000
    1 -> 0x4693B8B5B5056E17
    2 -> 0x4D384F03E93FF9F5
    3 -> 0x53DDF67562D8B363
    4 -> 0x5A827748F9301D32
    5 -> 0x6126C2D4256FFCC3
    6 -> 0x67CC0E1EF1A724EB
    7 -> 0x6E714A52DFFC6799
    8 -> 0x75154FDD7F73BF3C
    9 -> 0x7BBA44DF832B8D46
    _ -> 0)

  -- | Exact powers of ten 10^(-32*k) for k in 0 .. 10.
  p10-neg32 :: U64 -> F64
  p10-neg32 i = f64-from-bits (case wrapping-u64-to-u32 i of
    0 -> 0x3FF0000000000000
    1 -> 0x3949F623D5A8A733
    2 -> 0x32A50FFD44F4A73D
    3 -> 0x2C0116805EFFAEAA
    4 -> 0x255BBA08CF8C979D
    5 -> 0x1EB67E9C127B6E74
    6 -> 0x18123FF06EEA847A
    7 -> 0x116D9CA79D89462A
    8 -> 0x0AC8062864AC6F43
    9 -> 0x04237D99CC506D59
    10 -> 0x00000000000007E8
    _ -> 0)
