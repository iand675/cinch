  -- | The inverse complementary error function: erfinv(1 - x).
  erfcinv-f64 :: F64 -> F64
  erfcinv-f64 x = erfinv-f64 (sub-f64 1 x)

  -- ---------------------------------------------------------------------
  -- Special functions: Gamma and lgamma.
  -- ---------------------------------------------------------------------

  -- | -sin(pi * x) for positive x, used by lgamma's reflection formula.
  sin-pi :: F64 -> F64
  sin-pi x =
    if flt-f64 x (f64-from-bits 0x3FD0000000000000) then neg-f64 (sin-small (mul-f64 pi-f64 x))
    else
      let z = floor-f64 x in
      let yn = (if not (feq-f64 z x) then
          let y = sub-f64 x (mul-f64 2 (floor-f64 (mul-f64 x half))) in
          (y, saturating-f64-to-i64 (mul-f64 y 4))
        else if fge-f64 x (f64-from-bits 0x4340000000000000) then (0, 0)
        else
          let zz = if flt-f64 x (f64-from-bits 0x4330000000000000) then add-f64 x (f64-from-bits 0x4330000000000000) else z in
          let n0 = wrapping-u64-to-i64 (bit-and-u64 1 (f64-bits zz)) in
          (i64-to-f64 n0, wrapping-shl-i64 n0 2)) in
      case yn of
        (y, n) ->
          let v = (if eq-i64 n 0 then sin-small (mul-f64 pi-f64 y)
            else if eq-i64 n 1 || eq-i64 n 2 then cos-small (mul-f64 pi-f64 (sub-f64 half y))
            else if eq-i64 n 3 || eq-i64 n 4 then sin-small (mul-f64 pi-f64 (sub-f64 1 y))
            else if eq-i64 n 5 || eq-i64 n 6 then neg-f64 (cos-small (mul-f64 pi-f64 (sub-f64 y (f64-from-bits 0x3FF8000000000000))))
            else sin-small (mul-f64 pi-f64 (sub-f64 y 2))) in
          neg-f64 v

  -- | Interval polynomial approximation for lgamma on (0, 2).
  lgamma-lt2 :: F64 -> F64
  lgamma-lt2 x =
    let base = if fle-f64 x (f64-from-bits 0x3FECCCCCCCCCCCCD) then neg-f64 (log-f64 x) else 0 in
    let yi = (if fle-f64 x (f64-from-bits 0x3FECCCCCCCCCCCCD) then
        if fge-f64 x (f64-from-bits 0x3FE76987D0EAED22) then (sub-f64 1 x, (0 :: I64))
        else if fge-f64 x (f64-from-bits 0x3FC88766F1C02F69) then (sub-f64 x (f64-from-bits 0x3FDD8B618D5AF8FC), 1)
        else (x, 2)
      else if fge-f64 x (f64-from-bits 0x3FFBB4C3E8757691) then (sub-f64 2 x, 0)
      else if fge-f64 x (f64-from-bits 0x3FF310ECDE3805ED) then (sub-f64 x (f64-from-bits 0x3FF762D86356BE3F), 1)
      else (sub-f64 x 1, 2)) in
    case yi of
      (y, i) ->
        let d = (if eq-i64 i 0 then
            let z = mul-f64 y y in
            let p1 = add-f64 (f64-from-bits 0x3FB3C467E37DB0C8) (mul-f64 z (add-f64 (f64-from-bits 0x3FB13E001A5562A7) (mul-f64 z (add-f64 (f64-from-bits 0x3F7E404FB68FEFE8) (mul-f64 z (add-f64 (f64-from-bits 0x3F538A94116F3F5D) (mul-f64 z (add-f64 (f64-from-bits 0x3F2CF2ECED10E54D) (mul-f64 z (f64-from-bits 0x3EFA7074428CFA52)))))))))) in
            let p2 = mul-f64 z (add-f64 (f64-from-bits 0x3FD4A34CC4A60FAD) (mul-f64 z (add-f64 (f64-from-bits 0x3F951322AC92547B) (mul-f64 z (add-f64 (f64-from-bits 0x3F67ADD8CCB7926B) (mul-f64 z (add-f64 (f64-from-bits 0x3F40B6C689B99C00) (mul-f64 z (add-f64 (f64-from-bits 0x3F1C5088987DFB07) (mul-f64 z (f64-from-bits 0x3F07858E90A45837))))))))))) in
            sub-f64 (add-f64 (mul-f64 y p1) p2) (mul-f64 half y)
          else if eq-i64 i 1 then
            let z = mul-f64 y y in
            let w = mul-f64 z y in
            let t1 = add-f64 (f64-from-bits 0x3FDEF72BC8EE38A2) (mul-f64 w (add-f64 (f64-from-bits 0xBFA0C9A8DF35B713) (mul-f64 w (add-f64 (f64-from-bits 0x3F78FCE0E370E344) (mul-f64 w (add-f64 (f64-from-bits 0xBF56FE8EBF2D1AF1) (mul-f64 w (f64-from-bits 0x3F34AF6D6C0EBBF7)))))))) in
            let t2 = add-f64 (f64-from-bits 0xBFC2E4278DC6C509) (mul-f64 w (add-f64 (f64-from-bits 0x3F9266E7970AF9EC) (mul-f64 w (add-f64 (f64-from-bits 0xBF6E2EFFB3E914D7) (mul-f64 w (add-f64 (f64-from-bits 0x3F4CDF0CEF61A8E9) (mul-f64 w (f64-from-bits 0xBF347F24ECC38C38)))))))) in
            let t3 = add-f64 (f64-from-bits 0x3FB08B4294D5419B) (mul-f64 w (add-f64 (f64-from-bits 0xBF851F9FBA91EC6A) (mul-f64 w (add-f64 (f64-from-bits 0x3F6282D32E15C915) (mul-f64 w (add-f64 (f64-from-bits 0xBF41A6109C73E0EC) (mul-f64 w (f64-from-bits 0x3F35FD3EE8C2D3F4)))))))) in
            add-f64 (f64-from-bits 0xBFBF19B9BCC38A42) (sub-f64 (mul-f64 z t1) (sub-f64 (f64-from-bits 0xBC50C7CAA48A971F) (mul-f64 w (add-f64 t2 (mul-f64 y t3)))))
          else
            let u1 = mul-f64 y (add-f64 (f64-from-bits 0xBFB3C467E37DB0C8) (mul-f64 y (add-f64 (f64-from-bits 0x3FE4401E8B005DFF) (mul-f64 y (add-f64 (f64-from-bits 0x3FF7475CD119BD6F) (mul-f64 y (add-f64 (f64-from-bits 0x3FEF497644EA8450) (mul-f64 y (add-f64 (f64-from-bits 0x3FCD4EAEF6010924) (mul-f64 y (f64-from-bits 0x3F8B678BBF2BAB09))))))))))) in
            let u2 = add-f64 1 (mul-f64 y (add-f64 (f64-from-bits 0x4003A5D7C2BD619C) (mul-f64 y (add-f64 (f64-from-bits 0x40010725A42B18F5) (mul-f64 y (add-f64 (f64-from-bits 0x3FE89DFBE45050AF) (mul-f64 y (add-f64 (f64-from-bits 0x3FBAAE55D6537C88) (mul-f64 y (f64-from-bits 0x3F6A5ABB57D0CF61)))))))))) in
            add-f64 (mul-f64 (f64-from-bits 0xBFE0000000000000) y) (div-f64 u1 u2)) in
        add-f64 base d

  -- | Rational approximation plus factorial shift for lgamma on [2, 8).
  lgamma-lt8 :: F64 -> F64
  lgamma-lt8 x =
    let k = saturating-f64-to-i64 x in
    let y = sub-f64 x (i64-to-f64 k) in
    let p = mul-f64 y (add-f64 (f64-from-bits 0xBFB3C467E37DB0C8) (mul-f64 y (add-f64 (f64-from-bits 0x3FCB848B36E20878) (mul-f64 y (add-f64 (f64-from-bits 0x3FD4D98F4F139F59) (mul-f64 y (add-f64 (f64-from-bits 0x3FC2BB9CBEE5F2F7) (mul-f64 y (add-f64 (f64-from-bits 0x3F9B481C7E939961) (mul-f64 y (add-f64 (f64-from-bits 0x3F5E26B67368F239) (mul-f64 y (f64-from-bits 0x3F00BFECDD17E945))))))))))))) in
    let q = add-f64 1 (mul-f64 y (add-f64 (f64-from-bits 0x3FF645A762C4AB74) (mul-f64 y (add-f64 (f64-from-bits 0x3FE71A1893D3DCDC) (mul-f64 y (add-f64 (f64-from-bits 0x3FC601EDCCFBDF27) (mul-f64 y (add-f64 (f64-from-bits 0x3F9317EA742ED475) (mul-f64 y (add-f64 (f64-from-bits 0x3F497DDACA41A95B) (mul-f64 y (f64-from-bits 0x3EDEBAF7A5B38140)))))))))))) in
    let lg0 = add-f64 (mul-f64 half y) (div-f64 p q) in
    if ge-i64 k 3 then
      let z0 = if eq-i64 k 7 then mul-f64 1 (add-f64 y 6) else 1 in
      let z1 = if ge-i64 k 6 then mul-f64 z0 (add-f64 y 5) else z0 in
      let z2 = if ge-i64 k 5 then mul-f64 z1 (add-f64 y 4) else z1 in
      let z3 = if ge-i64 k 4 then mul-f64 z2 (add-f64 y 3) else z2 in
      let z4 = mul-f64 z3 (add-f64 y 2) in
      add-f64 lg0 (log-f64 z4)
    else lg0

  -- | lgamma for positive finite x not equal to 1 or 2.
  lgamma-pos :: F64 -> F64
  lgamma-pos x =
    if flt-f64 x 2 then lgamma-lt2 x
    else if flt-f64 x 8 then lgamma-lt8 x
    else if flt-f64 x (f64-from-bits 0x4390000000000000) then
      let t = log-f64 x in
      let z = div-f64 1 x in
      let y = mul-f64 z z in
      let w = add-f64 (f64-from-bits 0x3FDACFE390C97D69) (mul-f64 z (add-f64 (f64-from-bits 0x3FB555555555553B) (mul-f64 y (add-f64 (f64-from-bits 0xBF66C16C16B02E5C) (mul-f64 y (add-f64 (f64-from-bits 0x3F4A019F98CF38B6) (mul-f64 y (add-f64 (f64-from-bits 0xBF4380CB8C0FE741) (mul-f64 y (add-f64 (f64-from-bits 0x3F4B67BA4CDAD5D1) (mul-f64 y (f64-from-bits 0xBF5AB89D0B9E43E4)))))))))))) in
      add-f64 (mul-f64 (sub-f64 x half) (sub-f64 t 1)) w
    else mul-f64 x (sub-f64 (log-f64 x) 1)

  -- | ln |Gamma(x)| and the sign of Gamma(x) (1 or -1); +Inf at zero and the non-positive integers.
  lgamma-f64 :: F64 -> (F64, I64)
  lgamma-f64 x0 =
    if is-nan-f64 x0 || feq-f64 (abs-f64 x0) pos-inf then (x0, 1)
    else if feq-f64 x0 0 then (pos-inf, 1)
    else
      let neg = flt-f64 x0 0 in
      let x = if neg then neg-f64 x0 else x0 in
      if flt-f64 x (f64-from-bits 0x3B90000000000000) then (neg-f64 (log-f64 x), if neg then wrapping-neg-i64 1 else 1)
      else if neg then
        if fge-f64 x (f64-from-bits 0x4330000000000000) then (pos-inf, 1)
        else
          let t = sin-pi x in
          if feq-f64 t 0 then (pos-inf, 1)
          else
            let nadj = log-f64 (div-f64 pi-f64 (abs-f64 (mul-f64 t x))) in
            let sign = if flt-f64 t 0 then wrapping-neg-i64 1 else 1 in
            if feq-f64 x 1 || feq-f64 x 2 then (0, sign)
            else (sub-f64 nadj (lgamma-pos x), sign)
      else if feq-f64 x 1 || feq-f64 x 2 then (0, 1)
      else (lgamma-pos x, 1)

  -- | Gamma's rational approximation on [2, 3): z * P(x - 2) / Q(x - 2).
  gamma-poly :: F64 -> F64 -> F64
  gamma-poly x0 z =
    let x = sub-f64 x0 2 in
    let p = add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (f64-from-bits 0x3F24FCB839982153) x) (f64-from-bits 0x3F5384E3E686BFAB)) x) (f64-from-bits 0x3F8557CDE9DB14B0)) x) (f64-from-bits 0x3FA863D918C423D3)) x) (f64-from-bits 0x3FCA8DA9DCAE7D31)) x) (f64-from-bits 0x3FDFA1373993E312)) x) (f64-from-bits 0x3FF0000000000000) in
    let q = add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (f64-from-bits 0xBEF8487A8400D3AF) x) (f64-from-bits 0x3F41AE8A29152573)) x) (f64-from-bits 0xBF7240E4E750B44A)) x) (f64-from-bits 0x3F8831ED5B1BB117)) x) (f64-from-bits 0x3FA25779E33FDE67)) x) (f64-from-bits 0xBFCE071A9D4287C2)) x) (f64-from-bits 0x3FB24944C9CD3C51)) x) (f64-from-bits 0x3FF0000000000000) in
    div-f64 (mul-f64 z p) q

  -- | Gamma near zero: z / ((1 + Euler x) x), infinite at zero.
  gamma-tiny :: F64 -> F64 -> F64
  gamma-tiny x z =
    if feq-f64 x 0 then pos-inf
    else div-f64 z (mul-f64 (add-f64 1 (mul-f64 (f64-from-bits 0x3FE2788CFC6FB619) x)) x)

  -- | The Stirling series correction 1 + w(1/x).
  stirling-w :: F64 -> F64
  stirling-w x =
    let w = div-f64 1 x in
    add-f64 1 (mul-f64 w (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (add-f64 (mul-f64 (f64-from-bits 0x3F49CC72592D7293) w) (f64-from-bits 0xBF2E166B27E61D7C)) w) (f64-from-bits 0xBF65F72607D44FD7)) w) (f64-from-bits 0x3F6C71C71B98C5FD)) w) (f64-from-bits 0x3FB5555555555986)))

  -- | The Gamma function; NaN at the negative integers and -Inf, signed infinities at the zeros.
  gamma-f64 :: F64 -> F64
  gamma-f64 x =
    if is-negative-integer x || is-inf-f64 x (wrapping-neg-i64 1) || is-nan-f64 x then nan-f64
    else if is-inf-f64 x 1 then pos-inf
    else if feq-f64 x 0 then (if sign-bit-f64 x then neg-inf else pos-inf)
    else if fgt-f64 (abs-f64 x) 33 then gamma-large x (abs-f64 x) (floor-f64 (abs-f64 x))
    else gamma-up x 1

  -- | Whether x is a negative integer.
  is-negative-integer :: F64 -> Bool
  is-negative-integer x = flt-f64 x 0 && (case modf-f64 x of (i, f) -> feq-f64 f 0)

  -- | Stirling's formula for large positive x; the reflection formula for large negative x.
  gamma-large :: F64 -> F64 -> F64 -> F64
  gamma-large x q p = if fge-f64 x 0 then (case stirling x of (a, b) -> mul-f64 a b) else gamma-reflect q (if fle-f64 p (f64-from-bits 0x4340000000000000) && odd (saturating-f64-to-i64 p) then 1 else wrapping-neg-i64 1) (reflect-fraction q p)

  -- | The distance from q to its nearest integer below or above, as the reflection uses it.
  reflect-fraction :: F64 -> F64 -> F64
  reflect-fraction q p = let z = sub-f64 q p in if fgt-f64 z half then sub-f64 q (add-f64 p 1) else z

  -- | pi / (q sin(pi z) Gamma(q)), with the sign of Gamma at -q.
  gamma-reflect :: F64 -> I64 -> F64 -> F64
  gamma-reflect q sg z0 =
    let z = mul-f64 q (sin-f64 (mul-f64 pi-f64 z0)) in
    if feq-f64 z 0 then inf-f64 sg
    else (case stirling q of (sq1, sq2) -> gamma-reflect-end sg (abs-f64 z) sq1 sq2)

  -- | The reflected value, dividing in steps when the product overflows.
  gamma-reflect-end :: I64 -> F64 -> F64 -> F64 -> F64
  gamma-reflect-end sg absz sq1 sq2 =
    let d = mul-f64 (mul-f64 absz sq1) sq2 in
    mul-f64 (i64-to-f64 sg) (if is-inf-f64 d 0 then div-f64 (div-f64 (div-f64 pi-f64 absz) sq1) sq2 else div-f64 pi-f64 d)

  -- | Stirling's formula as two factors (their product is Gamma(x)), split above 143 to avoid overflow.
  stirling :: F64 -> (F64, F64)
  stirling x = if fgt-f64 x 200 then (pos-inf, 1) else stirling-factors x (stirling-w x) (exp-f64 x)

  -- | The two factors from the series correction and e^x.
  stirling-factors :: F64 -> F64 -> F64 -> (F64, F64)
  stirling-factors x w ex =
    if fgt-f64 x (f64-from-bits 0x4061E083BA3443D4) then stirling-split w ex (pow-f64 x (sub-f64 (mul-f64 half x) (f64-from-bits 0x3FD0000000000000)))
    else (div-f64 (pow-f64 x (sub-f64 x half)) ex, mul-f64 (mul-f64 (f64-from-bits 0x40040D931FF62706) w) 1)

  -- | The split factors x^(x/2 - 1/4) and sqrt(2 pi) w x^(x/2 - 1/4) / e^x.
  stirling-split :: F64 -> F64 -> F64 -> (F64, F64)
  stirling-split w ex v = (v, mul-f64 (mul-f64 (f64-from-bits 0x40040D931FF62706) w) (div-f64 v ex))

  -- | Reduce x below 3 by Gamma(x) = (x - 1) Gamma(x - 1).
  gamma-up :: F64 -> F64 -> F64
  gamma-up x z = if fge-f64 x 3 then gamma-up (sub-f64 x 1) (mul-f64 z (sub-f64 x 1)) else gamma-negative x z

  -- | Raise negative x toward zero by Gamma(x) = Gamma(x + 1) / x.
  gamma-negative :: F64 -> F64 -> F64
  gamma-negative x z = if flt-f64 x 0 then (if fgt-f64 x (f64-from-bits 0xBE112E0BE826D695) then gamma-tiny x z else gamma-negative (add-f64 x 1) (div-f64 z x)) else gamma-low x z

  -- | Raise x into [2, 3), then the rational approximation.
  gamma-low :: F64 -> F64 -> F64
  gamma-low x z = if flt-f64 x 2 then (if flt-f64 x (f64-from-bits 0x3E112E0BE826D695) then gamma-tiny x z else gamma-low (add-f64 x 1) (div-f64 z x)) else if feq-f64 x 2 then z else gamma-poly x z

  -- ---------------------------------------------------------------------
  -- Special functions: Bessel functions.
  -- ---------------------------------------------------------------------

  -- | Hankel asymptotic amplitude polynomial P_0(x) for x >= 2.
  pzero :: F64 -> F64
