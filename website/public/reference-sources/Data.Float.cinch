    case sincos-f64 x of
      (s, cv) ->
        let ss0 = sub-f64 s cv in
        let cc0 = add-f64 s cv in
        if flt-f64 x half-max then
          let z = neg-f64 (cos-f64 (add-f64 x x)) in
          if flt-f64 (mul-f64 s cv) 0 then (ss0, div-f64 z ss0)
          else (div-f64 z cc0, cc0)
        else (ss0, cc0)

