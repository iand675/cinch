  -- | The IEEE remainder's final correction of x mod 2y into [-y/2, y/2], with the sign of the dividend.
  prim remainder-fix :: F64 -> F64 -> F64 -> F64 where
    llvm {
      %v1 = fcmp olt double %1, 0x0020000000000000
      %v2 = fadd double %0, %0
      %v3 = fcmp ogt double %v2, %1
