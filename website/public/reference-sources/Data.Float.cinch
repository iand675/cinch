      %v32 = fcmp oeq double %v31, 0x7FF0000000000000
      %v33 = or i1 %v29, %v30
      %v34 = or i1 %v33, %v32
      %v35 = select i1 %v34, i1 true, i1 false
      %v36 = call double @llvm.fabs.f64(double %1)
      %v37 = fcmp olt double %v36, 0x0010000000000000
      %v38 = fmul double %1, 0x4330000000000000
      %v39 = select i1 %v37, i1 true, i1 false
