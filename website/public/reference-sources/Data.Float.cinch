  -- | The Bessel function of the first kind of order zero.
  j0-f64 :: F64 -> F64
  j0-f64 x0 =
    if is-nan-f64 x0 then x0
    else if feq-f64 (abs-f64 x0) pos-inf then 0
    else if feq-f64 x0 0 then 1
    else
      let x = abs-f64 x0 in
      if fge-f64 x 2 then
