      %v10 = select i1 %v8, double %v9, double %v3
      %v11 = select i1 %v8, i1 true, i1 %v7
      %v12 = fcmp ogt double %v3, 0x40862E42FEFA39EF
      %v13 = select i1 %v11, double %v10, double 0x7FF0000000000000
