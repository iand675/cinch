  -- | The hyperbolic sine.
  prim sinh-f64 :: F64 -> F64 where
    llvm {
      %v1 = fcmp olt double %0, 0x0000000000000000
      %v2 = fneg double %0
      %v3 = select i1 %v1, double %v2, double %0
      %v4 = fcmp uno double %v3, 0.0
      %v5 = fcmp oeq double %v3, 0x7FF0000000000000
      %v6 = or i1 %v4, %v5
