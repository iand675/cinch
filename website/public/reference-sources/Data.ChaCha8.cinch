      %v62 = shl <4 x i32> %v61, <i32 12, i32 12, i32 12, i32 12>
      %v63 = lshr <4 x i32> %v61, <i32 20, i32 20, i32 20, i32 20>
      %v64 = or <4 x i32> %v62, %v63
      %v65 = add <4 x i32> %v55, %v64
      %v66 = xor <4 x i32> %v59, %v65
