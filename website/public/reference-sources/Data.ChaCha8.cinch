-- | ChaCha8: a fast, seekable-by-state, cryptographically strong pseudorandom generator producing 64-bit
-- values from a 32-byte seed, with byte reads and a compact binary encoding of its state.
--
-- The generator runs four ChaCha blocks with eight rounds at a time, word-interleaved so every quarter
-- round is one <4 x i32> vector operation per word via Data.Wide SIMD; one block call computes all sixteen
-- output vectors in a single pass and yields thirty-two 64-bit outputs. After four calls the last four
-- outputs of the fourth become the next seed instead of being returned, so earlier outputs cannot be
-- recovered from a captured state. A state is an immutable value: drawing returns the value and the next
-- state, so a retained state replays exactly. The encoding records the seed and the number of outputs used
-- within the current reseed period, plus any bytes a partial read left unread.
module Data.ChaCha8 where

  import Data.Bytes
  import Data.Bytes.Build
  import Data.Machine
  import Data.Nat
  import Data.Result
  import Data.String
  import Data.Wide (bit-xor-u128, simd-u32x4-add, simd-u32x4-pack, simd-u32x4-rotl, simd-u32x4-splat, wrapping-shr-u128, wrapping-u128-to-u32)

  export ChaCha8, ChaCha8Error, ChaCha8SeedSize, ChaCha8BadEncoding, ChaCha8BadReadBuffer, chacha8-error-message
  export chacha8-new, chacha8-reseed, chacha8-uint64, chacha8-read, chacha8-marshal, chacha8-unmarshal

  -- | Why a seed or an encoding was refused.
  data ChaCha8Error where
    -- | The seed is not 32 bytes (its length is given).
    ChaCha8SeedSize :: Nat -> ChaCha8Error
    -- | The state encoding is malformed.
    ChaCha8BadEncoding :: ChaCha8Error
    -- | The encoding's unread-byte section is malformed.
    ChaCha8BadReadBuffer :: ChaCha8Error

  -- | A readable description of an error.
  chacha8-error-message :: ChaCha8Error -> String
  chacha8-error-message e = case e of
    ChaCha8SeedSize n -> "chacha8: seed must be 32 bytes"
    ChaCha8BadEncoding -> "invalid ChaCha8 encoding"
    ChaCha8BadReadBuffer -> "invalid ChaCha8 Read buffer encoding"

  -- | A generator state: the current block's thirty-two outputs, the seed (as two U128 halves), the next output
  -- index, how many outputs the block offers (28 in the last block of a period), the block counter (0, 4, 8 or
  -- 12) and the bytes a partial read left unread.
  data ChaCha8 where
    -- | Fields in the order listed above.
    ChaCha8 :: Bytes -> U128 -> U128 -> Nat -> Nat -> Nat -> Bytes -> ChaCha8

  -- | A 64-bit word from eight little-endian bytes at an offset (zero outside the buffer).
  get64 :: Bytes -> Nat -> U64
  get64 b o = if o + 8 <= bytes-len b then bytes-load-le64 b o else 0

  -- | A U128 from sixteen little-endian bytes at an offset (zero outside the buffer).
  get128 :: Bytes -> Nat -> U128
  get128 b o = if o + 16 <= bytes-len b then bytes-load-u128 b o else (0 :: U128)

  -- | Store a U128 as sixteen little-endian bytes when they fit.
  put128 :: Bytes -> Nat -> U128 -> Unit
  put128 b o v = if o + 16 <= bytes-len b then bytes-store-u128 b o v else ()

  -- | A value below 2^62 as a machine integer.
  small :: Nat -> I64
  small n = if n < 4611686018427387904 then nat-to-i64 n else 0

  -- | Extract lane i (0..3) of a U128 and splat it across all four 32-bit SIMD lanes.
  splat-lane :: U128 -> U32 -> U128
  splat-lane v shift = simd-u32x4-splat (wrapping-u128-to-u32 (wrapping-shr-u128 v shift))

  -- | One block call: compute all sixteen interleaved 4-way ChaCha8 output vectors in one pass.
  block :: U128 -> U128 -> Nat -> Bytes
  block s01 s23 counter =
    let out = bytes-new 256 in
    let c32 = wrapping-i64-to-u32 (small counter) in
    let v0 = simd-u32x4-splat 1634760805 in
    let v1 = simd-u32x4-splat 857760878 in
    let v2 = simd-u32x4-splat 2036477234 in
    let v3 = simd-u32x4-splat 1797285236 in
    let v4 = simd-u32x4-splat (wrapping-u128-to-u32 s01) in
    let v5 = splat-lane s01 32 in
    let v6 = splat-lane s01 64 in
    let v7 = splat-lane s01 96 in
    let v8 = simd-u32x4-splat (wrapping-u128-to-u32 s23) in
    let v9 = splat-lane s23 32 in
    let v10 = splat-lane s23 64 in
    let v11 = splat-lane s23 96 in
    let v12 = simd-u32x4-add (simd-u32x4-splat c32) (simd-u32x4-pack 0 1 2 3) in
    let z = (0 :: U128) in
    let done = chacha8-rounds 4 out s01 s23 v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 z z z in
    out

  -- | Run remaining ChaCha8 double-rounds across four interleaved blocks and store all sixteen output vectors.
  chacha8-rounds :: using (bytes-len out == 256) => I64 -> (out :: Bytes) -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> Unit
  chacha8-rounds rem out s01 s23 x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10 x11 x12 x13 x14 x15 =
    if eq-i64 rem 0 then
      let f4 = simd-u32x4-add x4 (simd-u32x4-splat (wrapping-u128-to-u32 s01)) in
      let f5 = simd-u32x4-add x5 (splat-lane s01 32) in
      let f6 = simd-u32x4-add x6 (splat-lane s01 64) in
      let f7 = simd-u32x4-add x7 (splat-lane s01 96) in
      let f8 = simd-u32x4-add x8 (simd-u32x4-splat (wrapping-u128-to-u32 s23)) in
      let f9 = simd-u32x4-add x9 (splat-lane s23 32) in
      let f10 = simd-u32x4-add x10 (splat-lane s23 64) in
      let f11 = simd-u32x4-add x11 (splat-lane s23 96) in
      let w0 = bytes-store-u128-at out 0 x0 in
      let w1 = bytes-store-u128-at out 16 x1 in
      let w2 = bytes-store-u128-at out 32 x2 in
      let w3 = bytes-store-u128-at out 48 x3 in
      let w4 = bytes-store-u128-at out 64 f4 in
      let w5 = bytes-store-u128-at out 80 f5 in
      let w6 = bytes-store-u128-at out 96 f6 in
      let w7 = bytes-store-u128-at out 112 f7 in
      let w8 = bytes-store-u128-at out 128 f8 in
      let w9 = bytes-store-u128-at out 144 f9 in
      let w10 = bytes-store-u128-at out 160 f10 in
      let w11 = bytes-store-u128-at out 176 f11 in
      let w12 = bytes-store-u128-at out 192 x12 in
      let w13 = bytes-store-u128-at out 208 x13 in
      let w14 = bytes-store-u128-at out 224 x14 in
      bytes-store-u128-at out 240 x15
    else
      -- Column 0: (0, 4, 8, 12)
      let c0a1 = simd-u32x4-add x0 x4 in
      let c0d1 = simd-u32x4-rotl (bit-xor-u128 x12 c0a1) 16 in
      let c0c1 = simd-u32x4-add x8 c0d1 in
      let c0b1 = simd-u32x4-rotl (bit-xor-u128 x4 c0c1) 12 in
      let a0 = simd-u32x4-add c0a1 c0b1 in
      let a12 = simd-u32x4-rotl (bit-xor-u128 c0d1 a0) 8 in
      let a8 = simd-u32x4-add c0c1 a12 in
      let a4 = simd-u32x4-rotl (bit-xor-u128 c0b1 a8) 7 in
      -- Column 1: (1, 5, 9, 13)
      let c1a1 = simd-u32x4-add x1 x5 in
      let c1d1 = simd-u32x4-rotl (bit-xor-u128 x13 c1a1) 16 in
      let c1c1 = simd-u32x4-add x9 c1d1 in
      let c1b1 = simd-u32x4-rotl (bit-xor-u128 x5 c1c1) 12 in
      let a1 = simd-u32x4-add c1a1 c1b1 in
      let a13 = simd-u32x4-rotl (bit-xor-u128 c1d1 a1) 8 in
      let a9 = simd-u32x4-add c1c1 a13 in
      let a5 = simd-u32x4-rotl (bit-xor-u128 c1b1 a9) 7 in
      -- Column 2: (2, 6, 10, 14)
      let c2a1 = simd-u32x4-add x2 x6 in
      let c2d1 = simd-u32x4-rotl (bit-xor-u128 x14 c2a1) 16 in
      let c2c1 = simd-u32x4-add x10 c2d1 in
      let c2b1 = simd-u32x4-rotl (bit-xor-u128 x6 c2c1) 12 in
      let a2 = simd-u32x4-add c2a1 c2b1 in
      let a14 = simd-u32x4-rotl (bit-xor-u128 c2d1 a2) 8 in
      let a10 = simd-u32x4-add c2c1 a14 in
      let a6 = simd-u32x4-rotl (bit-xor-u128 c2b1 a10) 7 in
      -- Column 3: (3, 7, 11, 15)
      let c3a1 = simd-u32x4-add x3 x7 in
      let c3d1 = simd-u32x4-rotl (bit-xor-u128 x15 c3a1) 16 in
      let c3c1 = simd-u32x4-add x11 c3d1 in
      let c3b1 = simd-u32x4-rotl (bit-xor-u128 x7 c3c1) 12 in
      let a3 = simd-u32x4-add c3a1 c3b1 in
      let a15 = simd-u32x4-rotl (bit-xor-u128 c3d1 a3) 8 in
      let a11 = simd-u32x4-add c3c1 a15 in
      let a7 = simd-u32x4-rotl (bit-xor-u128 c3b1 a11) 7 in
      -- Diagonal 0: (0, 5, 10, 15)
      let d0a1 = simd-u32x4-add a0 a5 in
      let d0d1 = simd-u32x4-rotl (bit-xor-u128 a15 d0a1) 16 in
      let d0c1 = simd-u32x4-add a10 d0d1 in
      let d0b1 = simd-u32x4-rotl (bit-xor-u128 a5 d0c1) 12 in
      let b0 = simd-u32x4-add d0a1 d0b1 in
      let b15 = simd-u32x4-rotl (bit-xor-u128 d0d1 b0) 8 in
      let b10 = simd-u32x4-add d0c1 b15 in
      let b5 = simd-u32x4-rotl (bit-xor-u128 d0b1 b10) 7 in
      -- Diagonal 1: (1, 6, 11, 12)
      let d1a1 = simd-u32x4-add a1 a6 in
      let d1d1 = simd-u32x4-rotl (bit-xor-u128 a12 d1a1) 16 in
      let d1c1 = simd-u32x4-add a11 d1d1 in
      let d1b1 = simd-u32x4-rotl (bit-xor-u128 a6 d1c1) 12 in
      let b1 = simd-u32x4-add d1a1 d1b1 in
      let b12 = simd-u32x4-rotl (bit-xor-u128 d1d1 b1) 8 in
      let b11 = simd-u32x4-add d1c1 b12 in
      let b6 = simd-u32x4-rotl (bit-xor-u128 d1b1 b11) 7 in
      -- Diagonal 2: (2, 7, 8, 13)
      let d2a1 = simd-u32x4-add a2 a7 in
      let d2d1 = simd-u32x4-rotl (bit-xor-u128 a13 d2a1) 16 in
      let d2c1 = simd-u32x4-add a8 d2d1 in
      let d2b1 = simd-u32x4-rotl (bit-xor-u128 a7 d2c1) 12 in
      let b2 = simd-u32x4-add d2a1 d2b1 in
      let b13 = simd-u32x4-rotl (bit-xor-u128 d2d1 b2) 8 in
      let b8 = simd-u32x4-add d2c1 b13 in
      let b7 = simd-u32x4-rotl (bit-xor-u128 d2b1 b8) 7 in
      -- Diagonal 3: (3, 4, 9, 14)
      let d3a1 = simd-u32x4-add a3 a4 in
      let d3d1 = simd-u32x4-rotl (bit-xor-u128 a14 d3a1) 16 in
      let d3c1 = simd-u32x4-add a9 d3d1 in
      let d3b1 = simd-u32x4-rotl (bit-xor-u128 a4 d3c1) 12 in
      let b3 = simd-u32x4-add d3a1 d3b1 in
      let b14 = simd-u32x4-rotl (bit-xor-u128 d3d1 b3) 8 in
      let b9 = simd-u32x4-add d3c1 b14 in
      let b4 = simd-u32x4-rotl (bit-xor-u128 d3b1 b9) 7 in
      chacha8-rounds (wrapping-sub-i64 rem 1) out s01 s23 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15

  -- | The state at the start of a seed's first block.
  start :: U128 -> U128 -> ChaCha8
  start s01 s23 = ChaCha8 (block s01 s23 0) s01 s23 0 32 0 (bytes-new 0)

  -- | A generator from a 32-byte seed (four little-endian 64-bit words).
  chacha8-new :: Bytes -> Result ChaCha8Error ChaCha8
  chacha8-new seed = if bytes-len seed == 32 then Ok (start (get128 seed 0) (get128 seed 16)) else Err (ChaCha8SeedSize (bytes-len seed))

  -- | Start over from a new 32-byte seed, dropping unread bytes.
  chacha8-reseed :: ChaCha8 -> Bytes -> Result ChaCha8Error ChaCha8
  chacha8-reseed state seed = chacha8-new seed

  -- | The next 64-bit value and the following state.
  chacha8-uint64 :: ChaCha8 -> (U64, ChaCha8)
  chacha8-uint64 state = case state of
    ChaCha8 buf s01 s23 i n c pending ->
      if i < n then (get64 buf (8 * i), ChaCha8 buf s01 s23 (i + 1) n c pending)
      else chacha8-uint64 (refill state)

  -- | The next block: the counter advances by four, and after the fourth block the last four outputs become the
  -- new seed and the counter restarts.
  refill :: ChaCha8 -> ChaCha8
  refill state = case state of
    ChaCha8 buf s01 s23 i n c pending ->
      let next = c + 4 in
      let ns01 = if next == 16 then get128 buf 224 else s01 in
      let ns23 = if next == 16 then get128 buf 240 else s23 in
      let counter = if next == 16 then (0 :: Nat) else next in
      ChaCha8 (block ns01 ns23 counter) ns01 ns23 0 (if counter == 12 then (28 :: Nat) else (32 :: Nat)) counter pending

  -- | Read n pseudorandom bytes: unread bytes first, then whole values little-endian; a final partial value keeps
  -- its remaining bytes for the next read.
  chacha8-read :: ChaCha8 -> Nat -> (Bytes, ChaCha8)
  chacha8-read state n = case state of
    ChaCha8 buf s01 s23 i k c pending ->
      let out = bytes-new n in
      let used = if bytes-len pending < n then bytes-len pending else n in
      let copied = if used <= bytes-len pending && used <= bytes-len out then bytes-copy-range out pending 0 0 used else () in
      let rest = slice pending used (minus (bytes-len pending) used) in
      fill out used (ChaCha8 buf s01 s23 i k c rest)

  -- | Fill the output from offset o.
  fill :: Bytes -> Nat -> ChaCha8 -> (Bytes, ChaCha8)
  fill out o state =
    if o >= bytes-len out then (out, state)
    else case chacha8-uint64 state of
      (v, next) ->
        if o + 8 <= bytes-len out then
          let w = bytes-store-le64 out o v in
          fill out (o + 8) next
        else
          let word = bytes-new 8 in
          let w = bytes-store-le64 word 0 v in
          let count = minus (bytes-len out) o in
          let c = if o + count <= bytes-len out && count <= bytes-len word then bytes-copy-range out word o 0 count else () in
          (out, with-pending next (slice word count (minus 8 count)))

  -- | A state with other unread bytes.
  with-pending :: ChaCha8 -> Bytes -> ChaCha8
  with-pending state pending = case state of
    ChaCha8 buf s01 s23 i n c old -> ChaCha8 buf s01 s23 i n c pending

  -- | n bytes from an offset, copied.
  slice :: Bytes -> Nat -> Nat -> Bytes
  slice b o n = let out = bytes-new n in let c = (if o + n <= bytes-len b then bytes-copy-range out b 0 o n else ()) in out

  -- | Saturating subtraction.
  minus :: Nat -> Nat -> Nat
  minus a b = if b <= a then a - b else 0

  -- | The state's encoding: "readbuf:", a length byte and the unread bytes when there are any, then "chacha8:",
  -- the outputs used in this reseed period (big-endian 64-bit) and the seed (four little-endian 64-bit words).
  chacha8-marshal :: ChaCha8 -> Bytes
  chacha8-marshal state = case state of
    ChaCha8 buf s01 s23 i n c pending ->
      let core = bytes-new 48 in
      let used = 32 * nat-div c 4 + i in
      let tag = copy-text core 0 "chacha8:" in
      let count = be64 core 8 used in
      let a = put128 core 16 s01 in
      let b = put128 core 32 s23 in
      if bytes-len pending == 0 then core
      else bytes-concat [string-to-bytes "readbuf:", one-byte (bytes-len pending), pending, core]

  -- | A single byte.
  one-byte :: Nat -> Bytes
  one-byte v = let out = bytes-new 1 in let s = (if v < 256 then bytes-set out 0 v else ()) in out

  -- | Copy a string's bytes to an offset.
  copy-text :: Bytes -> Nat -> String -> Unit
  copy-text out o s = let b = string-to-bytes s in if o + bytes-len b <= bytes-len out then bytes-copy-range out b o 0 (bytes-len b) else ()

  -- | Store a value as eight big-endian bytes.
  be64 :: Bytes -> Nat -> Nat -> Unit
  be64 out o v = be-from out (o + 7) v 8

  -- | Store the low bytes of v from position p backwards, k of them.
  be-from :: Bytes -> Nat -> Nat -> Nat -> Unit
  be-from out p v k = if k == 0 then ()
    else
      let s = if p < bytes-len out then bytes-set out p (nat-rem v 256) else () in
      be-from out (minus p 1) (nat-div v 256) (minus k 1)

  -- | Read a big-endian 64-bit value.
  read-be64 :: Bytes -> Nat -> Nat
  read-be64 b o = read-be-from b o 8 0

  -- | Accumulate k big-endian bytes from o.
  read-be-from :: Bytes -> Nat -> Nat -> Nat -> Nat
  read-be-from b o k acc = if k == 0 then acc else read-be-from b (o + 1) (minus k 1) (256 * acc + (if o < bytes-len b then bytes-get b o else 0))

  -- | Whether bytes at an offset spell a string.
  starts :: Bytes -> Nat -> String -> Bool
  starts b o s = let t = string-to-bytes s in o + bytes-len t <= bytes-len b && eq-i64 (bytes-compare (slice b o (bytes-len t)) t) 0

  -- | Restore a state from its encoding.
  chacha8-unmarshal :: Bytes -> Result ChaCha8Error ChaCha8
  chacha8-unmarshal encoded =
    if starts encoded 0 "readbuf:" then
      (let n = if bytes-len encoded > 8 then bytes-get-or encoded 8 else 0 in
      if bytes-len encoded < 9 || bytes-len encoded < 9 + n || n > 8 then Err ChaCha8BadReadBuffer
      else case core (slice encoded (9 + n) (minus (bytes-len encoded) (9 + n))) of
        Ok s -> Ok (with-pending s (slice encoded 9 n))
        Err e -> Err e)
    else core encoded

  -- | The byte at an index, zero outside the buffer.
  bytes-get-or :: Bytes -> Nat -> Nat
  bytes-get-or b i = if i < bytes-len b then bytes-get b i else 0

  -- | The 48-byte core encoding.
  core :: Bytes -> Result ChaCha8Error ChaCha8
  core b =
    if not (bytes-len b == 48) || not (starts b 0 "chacha8:") then Err ChaCha8BadEncoding
    else
      let used = read-be64 b 8 in
      if used > 124 then Err ChaCha8BadEncoding
      else
        let s01 = get128 b 16 in
        let s23 = get128 b 32 in
        let c = 4 * nat-div used 32 in
        Ok (ChaCha8 (block s01 s23 c) s01 s23 (nat-rem used 32) (if c == 12 then (28 :: Nat) else (32 :: Nat)) c (bytes-new 0))
