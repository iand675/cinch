      %v55 = add <4 x i32> <i32 2036477234, i32 2036477234, i32 2036477234, i32 2036477234>, %v5
      %v56 = xor <4 x i32> <i32 0, i32 0, i32 0, i32 0>, %v55
      %v57 = shl <4 x i32> %v56, <i32 16, i32 16, i32 16, i32 16>
