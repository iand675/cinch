      %v75 = add <4 x i32> <i32 1797285236, i32 1797285236, i32 1797285236, i32 1797285236>, %v6
      %v76 = xor <4 x i32> <i32 0, i32 0, i32 0, i32 0>, %v75
      %v77 = shl <4 x i32> %v76, <i32 16, i32 16, i32 16, i32 16>
