      %v140 = add <4 x i32> %v30, %v139
      %v141 = xor <4 x i32> %v94, %v140
      %v142 = shl <4 x i32> %v141, <i32 12, i32 12, i32 12, i32 12>
      %v143 = lshr <4 x i32> %v141, <i32 20, i32 20, i32 20, i32 20>
      %v144 = or <4 x i32> %v142, %v143
