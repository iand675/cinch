    Ok v -> value-as-null-string v

  -- | Scan a nullable `Bytes` column at index `idx`, returning a fresh copy when present.
  scan-null-bytes :: SqlRow -> Nat -> Result SqlError (Option Bytes)
  scan-null-bytes row idx = case row-get row idx of
