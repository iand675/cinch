  scan-null-timestamp :: SqlRow -> Nat -> Result SqlError (Option I64)
  scan-null-timestamp row idx = case row-get row idx of
    Err e -> Err e
    Ok v -> value-as-null-timestamp v

  -- | Scan a non-null `I64` column by column name.
  scan-i64-by-name :: SqlRow -> String -> Result SqlError I64
  scan-i64-by-name row name = case row-get-by-name row name of
    Err e -> Err e
    Ok v -> value-as-i64 v

