-- Data.Int: the mathematical integers.
--
-- `Int` is a core runtime type (primitive types specification section
-- 1): a boxed bignum, distinct from every machine scalar. Division
-- and remainder are total by construction: the divisor is a `NonZero
-- Int` (see Data.Nat).
--
-- Module scheme (design/base-library.md): the type's home carries its
-- instance family. `Int` gets no `Semigroup` instance (two monoids
-- live on it, chosen by `Sum`/`Product` in Algebra.Monoid); its
-- `Semiring` names both operations, and its `Group` is the additive
-- group of that semiring (`invert` is `int-neg`, the only total
-- inversion on `Int`).
module Data.Int where

  import Data.Core
  import Algebra.Arithmetic
  import Algebra.Group
  import Algebra.Semiring
  import Data.Hash

  export int-add, int-sub, int-mul, int-div, int-rem, int-neg, int-cmp, int-from-i64, int-to-i64, checked-int-to-i64, int-mod-nat

  foreign import ccall "cinch.runtime.intAdd" int-add :: Int -> Int -> Int
  foreign import ccall "cinch.runtime.intSub" int-sub :: Int -> Int -> Int
  foreign import ccall "cinch.runtime.intMul" int-mul :: Int -> Int -> Int
  foreign import ccall "cinch.runtime.intDiv" int-div :: Int -> NonZero Int -> Int
  foreign import ccall "cinch.runtime.intRem" int-rem :: Int -> NonZero Int -> Int
  foreign import ccall "cinch.runtime.intNeg" int-neg :: Int -> Int
  foreign import ccall "cinch.runtime.intCmp" int-cmp :: Int -> Int -> I64
  -- The `I64` conversions keep the value; an `Int` past the `I64`
  -- range is no `I64`, so `int-to-i64` states the range it needs (a
  -- guard or a conversion result supplies it) and `checked-int-to-i64`
  -- answers `None` outside it.
  foreign import ccall "cinch.runtime.intFromI64" int-from-i64 :: (x :: I64) -> refined (r == x) Int
  foreign import ccall "cinch.runtime.intToI64" int-to-i64 :: using (-9223372036854775808 <= x, x <= 9223372036854775807) => (x :: Int) -> refined (r == x) I64

  checked-int-to-i64 :: Int -> Option I64
  checked-int-to-i64 x =
    if -9223372036854775808 <= x && x <= 9223372036854775807 then Some (int-to-i64 x) else None

  -- The floored residue of `x` modulo `d` as a `Nat`, `0 <= r < d`
  -- for every `x` (a negative `x` counts up from `d`): an encoding into
  -- `d` values that needs no range of `x`.
  int-mod-nat :: Int -> NonZero Nat -> Nat
  int-mod-nat x d =
    if x < 0 then
      let m = nat-rem (nat-from-int (0 - x)) d in
      if m == 0 then 0 else unrefine d - m
    else nat-rem (nat-from-int x) d

  -- Primitive types specification, section 8: class instances. Eq and
  -- Ord cover Bool, Char, the mathematical Nat and Int, every machine
  -- integer type, Usize and Isize; the order is numeric on the integer
  -- types and code point order on Char. F32 and F64 have none of these
  -- instances.

  -- Mathematical `Int` and `Nat` instances (primitive types
  -- specification, section 1): comparison through the cmp prims'
  -- immediates, arithmetic through the runtime. `-` on `Int` needs no
  -- evidence; `-` on `Nat` is the exact difference and requires
  -- `b <= a` (see Data.Nat).

  implicit instance Eq_Int :: Eq Int where
    (==) x y = eq-i64 (int-cmp x y) 0
    (/=) x y = ne-i64 (int-cmp x y) 0

  implicit instance Ord_Int :: Ord Int where
    (<) x y = lt-i64 (int-cmp x y) 0
    (<=) x y = le-i64 (int-cmp x y) 0
    (>) x y = gt-i64 (int-cmp x y) 0
    (>=) x y = ge-i64 (int-cmp x y) 0

  implicit instance Add_Int :: Add Int where
    (+) x y = int-add x y

  implicit instance Sub_Int :: Sub Int where
    (-) x y = int-sub x y

  implicit instance Mul_Int :: Mul Int where
    (*) x y = int-mul x y

  implicit instance Neg_Int :: Neg Int where
    negate x = int-neg x

  implicit instance Rem_Int :: Rem Int where
    (%) x y = int-rem x y

  implicit instance Div_Int :: Div Int where
    (/) x y = int-div x y

  -- The additive group of the integers: `invert x` is `-x` (the group
  -- inverse laws are asserted over samples in
  -- compiler/tests/prelude_split.rs; instances live with their type).
  implicit instance Group_Int :: Group Int where
    invert x = int-neg x

  -- The semiring of integers: addition and multiplication with their
  -- identities (see the header).
  implicit instance Semiring_Int :: Semiring Int where
    zero = 0
    one = 1
    add x y = int-add x y
    mul x y = int-mul x y

  -- The magnitude's digest: equal integers hash alike (the `Hash` law
  -- holds by construction; instances live with their type). The
  -- magnitude is the `Nat` of the same value, of any size, hashed as a
  -- `Nat` is (no `I64` in between).
  implicit instance Hash_Int :: Hash Int where
    hash x = if x < 0 then nat-from-int (0 - x) else nat-from-int x

  -- The enumeration of mathematical integers (Data.Enum): total in
  -- both directions, codes consecutive (instances live with their
  -- type).
  implicit instance Enum_Int :: Enum Int where
    succ n = int-add n 1
    pred n = Some (int-sub n 1)
    to-enum n = Some n
    from-enum n = n
