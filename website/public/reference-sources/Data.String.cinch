-- Data.String: runtime strings, UTF-8 over Bytes.
--
-- `String` is the runtime text type (decision D88). It is distinct
-- from the staging interpreter's compile-time string values, which
-- are the same type observed at compile time (D43's deferral
-- resolved). A `"..."` literal in a term is a runtime `String`: the
-- lexer's decoded bytes in one shared read-only data-section constant
-- (immutability makes the sharing semantics-transparent: every
-- evaluation references the same object and nothing allocates).
--
-- THE IMMUTABILITY CONTRACT: a `String` never changes and no API ever
-- exposes its backing mutably. Conversions copy on the way in
-- (`string-from-bytes`) and on the way out (`string-to-bytes`);
-- mutation exists only on plain `Bytes`. The representation
-- constructor and the backing reader are module-private, so once a
-- buffer is wrapped no alias can mutate it, and a literal's backing
-- (the read-only data-section constant itself) never reaches a write:
-- outside this module it cannot be named, and in it every use of a
-- backing is a read or the source of a copy.
--
-- The functions here are the REFERENCE SEMANTICS for UTF-8. The
-- runtime provides SIMD-accelerated implementations of the same rules
-- (`cinch_utf8_*` in `seed/runtime/src/string.rs`), tested to agree
-- with this code; the acceleration is a representation detail behind
-- the primitive operations chapter's justified bodies (D89).
--
-- Module scheme (design/base-library.md): the type's home carries its
-- instance family (the parked-instance deviation of D159 is over).
module Data.String where

  import Algebra.Arithmetic
  import Data.Nat
  import Data.Option
  import Data.List
  import Data.Bytes
  import Prim.Machine (wrapping-add-i64, wrapping-sub-i64, ge-i64, lt-i64, bit-and-u8, ne-u8, eq-u64, bit-and-u64, bit-or-u64, bit-not-u64, wrapping-shl-u64, count-ones-u64, count-ones-u32, u32-to-i64)
  import Prim.Wide
  import Data.Char
  import Data.Hash
  import Algebra.Semigroup
  import Algebra.Monoid

  export String, compare-bytes-from, copy-bytes-into, empty-string, pack, string-byte-index-from, string-byte-length, string-char-at, string-char-at-from, string-clone, string-compare, string-concat, string-concat-all, string-from-bytes, string-join, string-length, string-length-from, string-repeat, string-slice, string-to-bytes, string-utf8-first, string-utf8-last, unpack, utf8-at, utf8-char, utf8-cont, utf8-encode-into, utf8-encode-width, utf8-lead-payload, utf8-min, utf8-valid-from, utf8-width


  -- ---------------------------------------------------------------------------
  -- Runtime strings: UTF-8 over Bytes.
  --
  -- `String` is the runtime text type (decision D88). It is distinct
  -- from the staging interpreter's compile-time string values, which are
  -- the same type observed at compile time (D43's deferral resolved).
  -- A `"..."` literal in a term is a runtime `String`: the lexer's
  -- decoded bytes in one shared read-only data-section constant (the
  -- sharing is semantics-transparent: every evaluation references the
  -- same object and nothing allocates).
  --
  -- THE IMMUTABILITY CONTRACT (the rules below implement it): a
  -- `String` never changes and no API ever exposes its backing mutably.
  -- Conversions copy on the way in (`string-from-bytes`) and on the way
  -- out (`string-to-bytes`); mutation exists only on plain `Bytes`.
  --
  -- The functions here are the REFERENCE SEMANTICS for UTF-8. The
  -- runtime provides SIMD-accelerated implementations of the same rules
  -- (`cinch_utf8_*` in `seed/runtime/src/string.rs`), tested to agree
  -- with this code; the acceleration is a representation detail behind
  -- the primitive operations chapter's justified bodies (D89).

  -- The representation constructor: module-private (the immutability
  -- contract: no API hands out a string's backing). A `StrBuf` wraps a
  -- buffer that is either fresh (`bytes-new` filled here) or a copy,
  -- never one a caller retains.
  data String where
    StrBuf :: Bytes -> String

  -- The backing buffer, for read-only internal use only (NOT
  -- exported): the functions below read it in place and never hand it
  -- out.
  string-bytes-raw :: String -> Bytes
  string-bytes-raw s = case s of
    StrBuf b -> b

  -- A private copy of a buffer (the wrap/copy discipline).
  bytes-copy :: Bytes -> Bytes
  bytes-copy b =
    let out = bytes-new (bytes-len b) in
    let u = copy-bytes-into out b 0 0 (bytes-len b) in
    out

  -- | Copy a string into independent immutable UTF-8 storage, including empty input.
  -- The mutable backing remains private and cannot alias any caller-owned byte buffer.
  string-clone :: String -> String
  string-clone text = StrBuf (bytes-copy (string-bytes-raw text))

  -- A copy of the backing (the conversion out copies: the caller may
  -- mutate its copy freely and the `String` never changes).
  string-to-bytes :: String -> Bytes
  string-to-bytes s = bytes-copy (string-bytes-raw s)

  -- UTF-8 decoding rules: a lead byte gives the width; continuation
  -- bytes are 10xxxxxx; overlong encodings, surrogates, and values above
  -- 0x10FFFF are malformed.
  utf8-width :: Nat -> Nat
  utf8-width x =
    if x < 128 then 1
    else if x < 192 then 0
    else if x < 224 then 2
    else if x < 240 then 3
    else if x < 248 then 4
    else 0

  utf8-min :: Nat -> Nat
  utf8-min w =
    if w == 2 then 128
    else if w == 3 then 2048
    else if w == 4 then 65536
    else 0

  -- The `k` continuation bytes from `i`: the caller has checked that
  -- they lie inside the buffer (`i + k <= bytes-len b`), so each read
  -- is in bounds and the obligation steps with the index.
  utf8-cont :: using (i + k <= bytes-len b) => (b :: Bytes) -> (i :: Nat) -> (k :: Nat) -> Nat -> Option Nat
  utf8-cont b i k cp =
    if k == 0 then Some cp
    else
      let y = bytes-get b i in
      if y < 128 then None
      else if y >= 192 then None
      else utf8-cont b (i + 1) (k - 1) (cp * 64 + (y - 128))

  -- The lead byte's payload bits: `x - 192`, `x - 224`, `x - 240` for
  -- the lead byte of a two-, three- and four-byte sequence, written as
  -- the low bits, which is the same number for every lead byte
  -- `utf8-width` admits and needs no `x >= 192` evidence.
  utf8-lead-payload :: Nat -> Nat -> Nat
  utf8-lead-payload x w =
    if w == 2 then x % 32
    else if w == 3 then x % 16
    else x % 8

  utf8-at :: Bytes -> Nat -> Option (Char, Nat)
  utf8-at b i =
    if i >= bytes-len b then None
    else
      let x = bytes-get b i in
      let w = utf8-width x in
      if w == 0 then None
      else if w == 1 then utf8-char x 1
      else if i + w > bytes-len b then None
      else case utf8-cont b (i + 1) (w - 1) (utf8-lead-payload x w) of
        None -> None
        Some cp -> if cp < utf8-min w then None else utf8-char cp w

  utf8-char :: Nat -> Nat -> Option (Char, Nat)
  utf8-char cp w =
    case char-from-code cp of
      None -> None
      Some c -> Some (c, w)

  -- | Validate UTF-8 from a byte boundary. Complete ASCII words are checked
  -- with SWAR; non-ASCII sequences and tails retain scalar validation.
  utf8-valid-from :: Bytes -> Nat -> Bool
  utf8-valid-from b i =
    if i >= bytes-len b then True
    else if i + 8 <= bytes-len b && ascii-block b i then utf8-valid-from b (i + 8)
    else case utf8-at b i of
      None -> False
      Some p -> case p of
        (c, w) -> utf8-valid-from b (i + w)

  string-from-bytes :: Bytes -> Option String
  string-from-bytes b =
    -- The conversion in copies (the wrap/copy discipline): after
    -- wrapping, no alias of the caller's buffer can mutate the string.
    if utf8-valid-from b 0 then Some (StrBuf (bytes-copy b)) else None

  empty-string :: String
  empty-string = StrBuf (bytes-new 0)

  string-byte-length :: String -> Nat
  string-byte-length s = bytes-len (string-bytes-raw s)

  -- | Observe the first scalar and its encoded byte width without copying private backing.
  -- Empty text has no scalar; every present width is between one and four bytes.
  string-utf8-first :: String -> Option (Char, Nat)
  string-utf8-first text = utf8-at (string-bytes-raw text) 0

  -- | Find the final scalar by checking at most four preceding bytes of valid UTF-8.
  string-last-scalar-from :: Bytes -> Nat -> Nat -> Option (Char, Nat)
  string-last-scalar-from raw pos left = if pos > 0 && left > 0 then
    let previous = pos - 1 in
    if previous < bytes-len raw then
      let byte = bytes-get raw previous in
      if byte < 128 || byte >= 192 then utf8-at raw previous else
        let remaining = left - 1 in string-last-scalar-from raw previous remaining
    else None
    else None

  -- | Observe the final scalar and its encoded byte width without scanning or copying the prefix.
  -- Empty text has no scalar; reverse lookup reads at most four bytes before decoding it.
  string-utf8-last :: String -> Option (Char, Nat)
  string-utf8-last text = let raw = string-bytes-raw text in
    string-last-scalar-from raw (bytes-len raw) 4

  -- Length in Unicode scalar values (O(n) scan).
  string-length-from :: Bytes -> Nat -> Nat -> Nat
  string-length-from b i n =
    if i >= bytes-len b then n
    else case utf8-at b i of
      None -> n
      Some p -> case p of
        (c, w) -> string-length-from b (i + w) (n + 1)

  -- | Count Unicode scalars in sealed-valid UTF-8 using packed leading-byte classification.
  -- Private SIMD/SWAR blocks count non-continuation bytes; exact scalar fringes never overread.
  string-length :: String -> Nat
  string-length text =
    let raw = string-bytes-raw text in
    let end = bytes-len-i64 raw in
    let count = string-count-from raw 0 end 0 in
    if 0 <= count then nat-from-i64 count else 0

  -- The scalar value at code point index `n`, by scan (O(n)).
  string-char-at-from :: Bytes -> Nat -> Nat -> Option Char
  string-char-at-from b i n =
    if i >= bytes-len b then None
    else case utf8-at b i of
      None -> None
      Some p -> case p of
        (c, w) -> if n == 0 then Some c else string-char-at-from b (i + w) (n - 1)

  string-char-at :: String -> Nat -> Option Char
  string-char-at s n = string-char-at-from (string-bytes-raw s) 0 n

  utf8-encode-width :: Nat -> InRange 1 4 Nat
  utf8-encode-width cp =
    if cp < 128 then 1
    else if cp < 2048 then 2
    else if cp < 65536 then 3
    else 4

  -- Encode one scalar value at `pos` (bytes are raw values; division is
  -- the `nat-div`/`nat-rem` function family). The caller proves the
  -- encoding fits (`pos + utf8-encode-width cp <= bytes-len b`, a
  -- buffer sized with `utf8-encode-width`), and the branches test that
  -- same width, so each one knows how many bytes it may write. Every
  -- byte is taken modulo its field width, which is the same number for
  -- every value its width admits (`cp < 128` in the first branch, `cp /
  -- 64 < 32` in the second, `cp / 4096 < 16` in the third, and `cp <
  -- 2^22` in the last, past which the unmasked lead byte did not fit a
  -- byte at all).
  utf8-encode-into :: using (pos + utf8-encode-width cp <= bytes-len b) => (b :: Bytes) -> (pos :: Nat) -> (cp :: Nat) -> Nat
  utf8-encode-into b pos cp =
    if utf8-encode-width cp <= 1 then
      let u = bytes-set b pos (nat-rem cp 128) in 0
    else if utf8-encode-width cp <= 2 then
      let u = bytes-set b pos (192 + nat-rem (nat-div cp 64) 32) in
      let v = bytes-set b (pos + 1) (128 + nat-rem cp 64) in 0
    else if utf8-encode-width cp <= 3 then
      let u = bytes-set b pos (224 + nat-rem (nat-div cp 4096) 16) in
      let v = bytes-set b (pos + 1) (128 + nat-rem (nat-div cp 64) 64) in
      let w = bytes-set b (pos + 2) (128 + nat-rem cp 64) in 0
    else
      let u = bytes-set b pos (240 + nat-rem (nat-div cp 262144) 16) in
      let v = bytes-set b (pos + 1) (128 + nat-rem (nat-div cp 4096) 64) in
      let w = bytes-set b (pos + 2) (128 + nat-rem (nat-div cp 64) 64) in
      let x = bytes-set b (pos + 3) (128 + nat-rem cp 64) in 0

  -- Concatenation (O(n + m) copies). The range copy is the runtime's
  -- `memmove` (`bytes-copy-range`, with its two range obligations): a
  -- loop here boxed a `Nat` for every index step.
  copy-bytes-into :: using (di + n <= bytes-len dst, si + n <= bytes-len src) => (dst :: Bytes) -> (src :: Bytes) -> (di :: Nat) -> (si :: Nat) -> (n :: Nat) -> Unit
  copy-bytes-into dst src di si n = bytes-copy-range dst src di si n

  string-concat :: String -> String -> String
  string-concat a b =
    let x = string-bytes-raw a in
    let y = string-bytes-raw b in
    let out = bytes-new (bytes-len x + bytes-len y) in
    let u = copy-bytes-into out x 0 0 (bytes-len x) in
    let v = copy-bytes-into out y (bytes-len x) 0 (bytes-len y) in
    StrBuf out

  -- | Concatenate every string in list order into one fresh immutable backing.
  -- A tail-recursive size pass and a checked bulk-copy pass use bounded traversal
  -- stack, including lists of empty strings. Concatenation preserves valid UTF-8.
  string-concat-all :: List String -> String
  string-concat-all xs =
    let size = concat-size xs 0 in
    let out = bytes-new size in
    let copied = concat-copy out 0 xs in
    StrBuf out

  -- | Count exact UTF-8 backing bytes without retaining recursive return frames.
  concat-size :: List String -> Nat -> Nat
  concat-size xs total = case xs of
    Nil -> total
    Cons s rest ->
      let size = bytes-len (string-bytes-raw s) in
      let next = total + size in
      concat-size rest next

  -- | Copy each immutable piece once into the pre-sized private result buffer.
  -- Every write stays inside an explicit complete-interval check; no backing escapes.
  concat-copy :: Bytes -> Nat -> List String -> Unit
  concat-copy out pos xs = case xs of
    Nil -> ()
    Cons s rest ->
      let source = string-bytes-raw s in
      let size = bytes-len source in
      if pos + size <= bytes-len out then
        let copied = copy-bytes-into out source pos 0 size in
        let next = pos + size in
        concat-copy out next rest
      else ()

  -- | Count exact UTF-8 bytes and separators before allocating a joined result.
  join-size :: List String -> Nat -> Nat -> Bool -> Nat
  join-size pieces gap total first = case pieces of
    Nil -> total
    Cons text rest ->
      let width = bytes-len (string-bytes-raw text) in
      let next = total + width + (if first then 0 else gap) in
      join-size rest gap next False

  -- | Copy each immutable piece and its adjacent separator into checked output intervals.
  join-copy :: Bytes -> Bytes -> Nat -> List String -> Unit
  join-copy out separator pos pieces = case pieces of
    Nil -> ()
    Cons text rest ->
      let source = string-bytes-raw text in let width = bytes-len source in
      if pos + width <= bytes-len out then
        let copied = copy-bytes-into out source pos 0 width in let following = pos + width in
        case rest of
          Nil -> ()
          Cons _ _ -> let gap = bytes-len separator in
            if following + gap <= bytes-len out then
              let separated = copy-bytes-into out separator following 0 gap in
              let next = following + gap in join-copy out separator next rest
            else ()
      else ()

  -- | Join valid UTF-8 pieces with separators into one fresh immutable backing.
  -- Empty pieces contribute adjacent separators; an empty list produces empty text.
  string-join :: List String -> String -> String
  string-join pieces separator =
    let gap = string-bytes-raw separator in
    if bytes-len gap == 0 then string-concat-all pieces else
      let size = join-size pieces (bytes-len gap) 0 True in let out = bytes-new size in
      let copied = join-copy out gap 0 pieces in StrBuf out

  -- | Repeat a string the requested natural count into one fresh immutable backing.
  -- A complete first copy seeds checked prefix doubling, giving logarithmically
  -- many bulk-copy steps and linear copied bytes. Empty results need no fill loop.
  string-repeat :: Nat -> String -> String
  string-repeat n s =
    let source = string-bytes-raw s in
    let size = bytes-len source in
    let out = bytes-new (n * size) in
    if size > 0 && size <= bytes-len out then
      let seeded = copy-bytes-into out source 0 0 size in
      let copied = repeat-double out size in
      StrBuf out
    else StrBuf out

  -- | Double the initialized repetition prefix, copying only the final remaining fringe.
  -- The private result is both source and destination of the checked bulk copy;
  -- its initialized prefix remains immutable until each non-overlapping copy ends.
  repeat-double :: Bytes -> Nat -> Unit
  repeat-double out filled =
    if filled > 0 && filled < bytes-len out then
      let remaining = bytes-len out - filled in
      let count = if filled < remaining then filled else remaining in
      if filled + count <= bytes-len out && count <= bytes-len out then
        let copied = copy-bytes-into out out filled 0 count in
        let next = filled + count in
        repeat-double out next
      else ()
    else ()

  -- Byte offset of code point `n` from offset `i`; the byte length when
  -- `n` reaches past the end. The offset never moves backwards and never
  -- passes the end, and the result says so. A sequence whose width runs
  -- past the end is malformed, as `utf8-at` decides; the step restates
  -- that end test, so it answers `i` as a malformed sequence does.
  string-byte-index-from :: using (i <= bytes-len b) => (b :: Bytes) -> (i :: Nat) -> Nat -> refined (i <= r && r <= bytes-len b) Nat
  string-byte-index-from b i n =
    if i >= bytes-len b then i
    else if n == 0 then i
    else case utf8-at b i of
      None -> i
      Some p -> case p of
        (c, w) -> if i + w <= bytes-len b then string-byte-index-from b (i + w) (n - 1) else i

  -- The code point range [start, end); indices past the end clamp and a
  -- reversed range yields the empty string (the span's subtraction
  -- takes its `start < end` evidence from the test).
  string-slice :: String -> Nat -> Nat -> String
  string-slice s start end =
    let b = string-bytes-raw s in
    let i0 = string-byte-index-from b 0 start in
    let span = if end > start then end - start else 0 in
    let i1 = string-byte-index-from b i0 span in
    let out = bytes-new (i1 - i0) in
    let u = copy-bytes-into out b 0 i0 (i1 - i0) in
    StrBuf out

  -- | Encode a list of Unicode scalar values into one fresh immutable UTF-8 backing.
  -- A tail size pass and a checked tail encoding pass keep traversal stack bounded.
  pack :: List Char -> String
  pack cs =
    let size = pack-size cs 0 in
    let out = bytes-new size in
    let encoded = pack-copy out 0 cs in
    StrBuf out

  -- | Count exact scalar encoding widths before allocating the complete result.
  pack-size :: List Char -> Nat -> Nat
  pack-size cs total = case cs of
    Nil -> total
    Cons c rest ->
      let width = utf8-encode-width (char-code c) in
      let next = total + width in
      pack-size rest next

  -- | Encode each scalar directly into its checked interval in the private output.
  pack-copy :: Bytes -> Nat -> List Char -> Unit
  pack-copy out pos cs = case cs of
    Nil -> ()
    Cons c rest ->
      let cp = char-code c in
      let width = utf8-encode-width cp in
      if pos + utf8-encode-width cp <= bytes-len out then
        let encoded = utf8-encode-into out pos cp in
        let next = pos + width in
        pack-copy out next rest
      else ()

  unpack :: String -> List Char
  unpack s = unpack-from (string-bytes-raw s) 0 Nil

  -- The scalar value of a character (the encoding family above).
  char-code :: Char -> Nat
  char-code c = nat-from-i64 (u32-to-i64 (char-to-u32 c))

  -- Advance by the decoded byte width so each scalar is decoded once.
  unpack-from :: Bytes -> Nat -> List Char -> List Char
  unpack-from b i acc = case utf8-at b i of
    None -> reverse acc
    Some (c, width) -> unpack-from b (i + width) (Cons c acc)

  -- Byte-wise comparison; UTF-8 preserves scalar value order under
  -- byte-wise lexicographic order, so this is also code point order.
  compare-bytes-from :: Bytes -> Bytes -> Nat -> I64
  compare-bytes-from a b i =
    if i >= bytes-len a then
      (if i >= bytes-len b then 0 else -1)
    else if i >= bytes-len b then 1
    else case nat-cmp (bytes-get a i) (bytes-get b i) of
      0 -> compare-bytes-from a b (i + 1)
      c -> c

  -- Compares the two backings in place: `string-to-bytes` would copy
  -- both operands first, and the lexer's keyword table compares every
  -- identifier against dozens of literals.
  string-compare :: String -> String -> I64
  string-compare a b = bytes-compare (string-bytes-raw a) (string-bytes-raw b)

  implicit instance Eq_String :: Eq String where
    (==) x y = eq-i64 (string-compare x y) 0
    (/=) x y = ne-i64 (string-compare x y) 0

  implicit instance Ord_String :: Ord String where
    (<) x y = lt-i64 (string-compare x y) 0
    (<=) x y = le-i64 (string-compare x y) 0
    (>) x y = gt-i64 (string-compare x y) 0
    (>=) x y = ge-i64 (string-compare x y) 0

  -- Strings under concatenation over the UTF-8 Bytes backing (moved
  -- from Algebra.Semigroup at the prelude split; the instance lives
  -- with its type).
  implicit instance Semigroup_String :: Semigroup String where
    (<>) x y = string-concat x y

  -- `empty-string` is the identity (moved from Algebra.Monoid); `mconcat`
  -- overrides the class's balanced fold with the one-pass concatenation.
  implicit instance Monoid_String :: Monoid String where
    mempty = empty-string
    mconcat xs = string-concat-all xs

  -- The digest of the UTF-8 backing through the `Bytes` instance
  -- (Data.Bytes owns the byte fold, so the two instances agree by
  -- construction instead of keeping two copies of one algorithm).
  -- `string-bytes-raw` reads the backing in place: hashing copies
  -- nothing.
  implicit instance Hash_String :: Hash String where
    hash s = hash (string-bytes-raw s)

  -- | Validate exactly eight available ASCII bytes using one unaligned word load.
  -- No byte beyond the proved range is touched; the high-bit mask works in either host byte order.
  ascii-block :: using (i + 8 <= bytes-len b) => (b :: Bytes) -> (i :: Nat) -> Bool
  ascii-block b i = eq-u64 (bit-and-u64 (bytes-load-le64 b i) 9259542123273814144) 0

  -- | Add bounded private machine counters without imported object calls inside scans.
  string-count-add :: I64 -> I64 -> I64
  string-count-add a b = wrapping-add-i64 a b

  -- | Check a remaining complete-block width using private signed machine offsets.
  string-count-wide :: I64 -> I64 -> I64 -> Bool
  string-count-wide at end width = ge-i64 (wrapping-sub-i64 end at) width

  -- | Check whether an exact scalar fringe still has an available byte.
  string-count-more :: I64 -> I64 -> Bool
  string-count-more at end = lt-i64 at end

  -- | Count exact leading bytes in sixteen proved available sealed-valid UTF-8 bytes.
  -- SIMD byte-lane comparisons identify continuation bytes and popcount subtracts them from sixteen.
  -- The reduction counts bytes in either host order and never returns a backing address.
  string-count-sixteen :: using (0 <= at, at + 16 <= bytes-len-i64 raw) => (raw :: Bytes) -> (at :: I64) -> I64
  string-count-sixteen raw at =
    let chunk = bytes-load-u128-at raw at in
    let top = bit-and-u128 chunk (simd-u8x16-splat 192) in
    let cont = simd-u8x16-cmpeq top (simd-u8x16-splat 128) in
    let mask = simd-u8x16-movemask cont in
    wrapping-sub-i64 16 (u32-to-i64 (count-ones-u32 mask))

  -- | Count exact leading bytes in eight proved available bytes with order-independent SWAR.
  string-count-eight :: using (0 <= at, at + 8 <= bytes-len-i64 raw) => (raw :: Bytes) -> (at :: I64) -> I64
  string-count-eight raw at =
    let word = bytes-load-le64-at raw at in
    let noncont = bit-and-u64 (bit-or-u64 (bit-not-u64 word) (wrapping-shl-u64 word 1)) 9259542123273814144 in
    u32-to-i64 (count-ones-u64 noncont)

  -- | Classify exactly one proved available fringe byte without a wide speculative load.
  string-count-one :: using (0 <= at, at < bytes-len-i64 raw) => (raw :: Bytes) -> (at :: I64) -> I64
  string-count-one raw at =
    if ne-u8 (bit-and-u8 (bytes-get-u8-at raw at) 192) 128 then 1 else 0

  -- | Traverse complete SIMD/SWAR blocks with unboxed counters and proved bounds.
  string-count-from :: Bytes -> I64 -> I64 -> I64 -> I64
  string-count-from raw at end total =
    let n = bytes-len raw in
    if 16 <= n then
      let lim = n - 16 in
      string-count-loop16 raw at end lim total
    else string-count-eight-or-tail raw at end total

  -- | Tight 16-byte SIMD loop once the 16-byte upper bound is established.
  string-count-loop16 :: using (lim + 16 <= bytes-len raw) => (raw :: Bytes) -> (at :: I64) -> (end :: I64) -> (lim :: Nat) -> I64 -> I64
  string-count-loop16 raw at end lim total =
    if 0 <= at then
      let na = nat-from-i64 at in
      if na <= lim && string-count-wide at end 16 then
        let count = string-count-sixteen raw at in
        let next-total = string-count-add total count in
        let next = string-count-add at 16 in
        string-count-loop16 raw next end lim next-total
      else string-count-eight-or-tail raw at end total
    else total

  -- | Consume one 8-byte SWAR block if available, then count the remaining scalar fringe.
  string-count-eight-or-tail :: Bytes -> I64 -> I64 -> I64 -> I64
  string-count-eight-or-tail raw at end total =
    let n = bytes-len raw in
    if 8 <= n && 0 <= at then
      let lim8 = n - 8 in
      let na = nat-from-i64 at in
      if na <= lim8 && string-count-wide at end 8 then
        let count = string-count-eight raw at in
        let next-total = string-count-add total count in
        let next = string-count-add at 8 in
        string-count-tail raw next end next-total
      else string-count-tail raw at end total
    else string-count-tail raw at end total

  -- | Count only the final available bytes after all complete packed blocks.
  string-count-tail :: Bytes -> I64 -> I64 -> I64 -> I64
  string-count-tail raw at end total =
    if 0 <= at && at < bytes-len-i64 raw && string-count-more at end then
      let count = string-count-one raw at in
      let next-total = string-count-add total count in
      let next = string-count-add at 1 in
      string-count-tail raw next end next-total
    else total
