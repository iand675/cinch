-- | Portable lexical operations and shell patterns for slash-separated UTF-8 paths.
-- Only / separates components; backslashes, drive letters and NUL are ordinary
-- path text. Cleaning resolves dots lexically without touching the filesystem.
-- Matching supports *, ?, escaped literals and nonempty Unicode range classes.
-- Stars never consume /; classes can explicitly match it. Patterns are checked
-- completely before matching, including patterns whose first term fails.
-- Complete scans use inline LLVM SIMD lanes with retained owners and exact tails.
module Text.Path where

  import Data.Bool
  import Data.Bytes
  import Data.Char
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String

  export path-clean, path-base, path-dir, path-ext, path-is-absolute, path-join, path-split
  export PathPatternError, InvalidPathPattern, path-pattern-error-message
  export PathPattern, path-pattern, path-pattern-match, path-match

  -- | Copy an exact byte interval, preserving UTF-8 whenever its boundaries separate path components.
  interval :: Bytes -> Nat -> Nat -> Bytes
  interval input start end = if start <= end && end <= bytes-len input then
    let out = bytes-new (end - start) in
    let copied = bytes-copy-range out input 0 start (end - start) in out
    else bytes-new 0

  -- | Convert an already checked UTF-8 path interval to independent immutable text.
  text-interval :: Bytes -> Nat -> Nat -> String
  text-interval input start end = case string-from-bytes (interval input start end) of
    Some text -> text
    None -> empty-string

  -- | Hold a private backing owner until its borrowed machine-counter traversal has completed.
  hold-path-buffer :: forall a. Bytes -> a -> a
  hold-path-buffer owner value = case bytes-len owner of _ -> value

  -- | Convert a checked physical-buffer result to a natural offset outside the machine loop.
  path-index :: I64 -> Nat
  path-index value = if 0 <= value then nat-from-i64 value else 0

  -- | Read exactly eight proved bytes without alignment assumptions; the checked caller retains the owner.
  prim load-path-word :: I64 -> I64 -> U64 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %at = getelementptr i8, ptr %base, i64 %1
      %value = load i64, ptr %at, align 1
      ret i64 %value
    }

  -- | Read one proved byte from a retained private backing interval.
  prim load-path-byte :: I64 -> I64 -> U8 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %at = getelementptr i8, ptr %base, i64 %1
      %value = load i8, ptr %at, align 1
      ret i8 %value
    }

  -- | Recognize any slash in a complete packed word using SIMD byte classification.
  prim word-has-slash :: U64 -> Bool where
    llvm {
      %bytes = bitcast i64 %0 to <8 x i8>
      %matches = icmp eq <8 x i8> %bytes, <i8 47, i8 47, i8 47, i8 47, i8 47, i8 47, i8 47, i8 47>
      %mask = bitcast <8 x i1> %matches to i8
      %found = icmp ne i8 %mask, 0
      %result = zext i1 %found to i8
      ret i8 %result
    }

  -- | Recognize a complete slash run with one packed equality comparison.
  prim word-all-slashes :: U64 -> Bool where
    llvm {
      %all = icmp eq i64 %0, 3399988123389603631
      %result = zext i1 %all to i8
      ret i8 %result
    }

  -- | Recognize a slash or dot in a complete eight-byte word with SIMD classification.
  prim word-has-slash-or-dot :: U64 -> Bool where
    llvm {
      %bytes = bitcast i64 %0 to <8 x i8>
      %slash = icmp eq <8 x i8> %bytes, <i8 47, i8 47, i8 47, i8 47, i8 47, i8 47, i8 47, i8 47>
      %dot = icmp eq <8 x i8> %bytes, <i8 46, i8 46, i8 46, i8 46, i8 46, i8 46, i8 46, i8 46>
      %matches = or <8 x i1> %slash, %dot
      %mask = bitcast <8 x i1> %matches to i8
      %found = icmp ne i8 %mask, 0
      %result = zext i1 %found to i8
      ret i8 %result
    }

  -- | Recognize shell metacharacters in eight independent byte lanes; lane order is irrelevant.
  prim word-has-meta :: U64 -> Bool where
    llvm {
      %bytes = bitcast i64 %0 to <8 x i8>
      %star = icmp eq <8 x i8> %bytes, <i8 42, i8 42, i8 42, i8 42, i8 42, i8 42, i8 42, i8 42>
      %question = icmp eq <8 x i8> %bytes, <i8 63, i8 63, i8 63, i8 63, i8 63, i8 63, i8 63, i8 63>
      %class = icmp eq <8 x i8> %bytes, <i8 91, i8 91, i8 91, i8 91, i8 91, i8 91, i8 91, i8 91>
      %escape = icmp eq <8 x i8> %bytes, <i8 92, i8 92, i8 92, i8 92, i8 92, i8 92, i8 92, i8 92>
      %a = or <8 x i1> %star, %question
      %b = or <8 x i1> %class, %escape
      %matches = or <8 x i1> %a, %b
      %mask = bitcast <8 x i1> %matches to i8
      %found = icmp ne i8 %mask, 0
      %result = zext i1 %found to i8
      ret i8 %result
    }

  -- | Dispatch once before the machine-only forward traversal; all intervals are caller-proved.
  scan-forward :: I64 -> I64 -> I64 -> U8 -> I64
  scan-forward base start end mode =
    if eq-u8 mode 0 then seek-forward base start end
    else if eq-u8 mode 1 then skip-forward base start end
    else meta-forward base start end

  -- | Seek a slash using exact complete words and fixed-width counters, without owner operations inside the loop.
  seek-forward :: I64 -> I64 -> I64 -> I64
  seek-forward base at end =
    if ge-i64 (wrapping-sub-i64 end at) 8 then
      if word-has-slash (load-path-word base at) then forward-tail base at end 0
      else seek-forward base (wrapping-add-i64 at 8) end
    else forward-tail base at end 0

  -- | Skip only complete slash words before the first non-slash scalar byte.
  skip-forward :: I64 -> I64 -> I64 -> I64
  skip-forward base at end =
    if ge-i64 (wrapping-sub-i64 end at) 8 then
      if word-all-slashes (load-path-word base at) then skip-forward base (wrapping-add-i64 at 8) end
      else forward-tail base at end 1
    else forward-tail base at end 1

  -- | Seek the first shell metacharacter using SIMD classification and machine-only loop state.
  meta-forward :: I64 -> I64 -> I64 -> I64
  meta-forward base at end =
    if ge-i64 (wrapping-sub-i64 end at) 8 then
      if word-has-meta (load-path-word base at) then forward-tail base at end 2
      else meta-forward base (wrapping-add-i64 at 8) end
    else forward-tail base at end 2

  -- | Finish the first matching forward word or short tail using exact one-byte reads.
  forward-tail :: I64 -> I64 -> I64 -> U8 -> I64
  forward-tail base at end mode =
    if lt-i64 at end then
      let byte = load-path-byte base at in
      let stop = if eq-u8 mode 0 then eq-u8 byte 47 else if eq-u8 mode 1 then not (eq-u8 byte 47) else eq-u8 byte 42 || eq-u8 byte 63 || eq-u8 byte 91 || eq-u8 byte 92 in
      if stop then at else forward-tail base (wrapping-add-i64 at 1) end mode
    else end

  -- | Dispatch once before the machine-only backwards traversal; all prefixes are caller-proved.
  scan-backward :: I64 -> I64 -> U8 -> I64
  scan-backward base end mode =
    if eq-u8 mode 0 then trim-backward base end
    else if eq-u8 mode 1 then seek-backward base end
    else extension-backward base end end

  -- | Trim complete trailing slash words before an exact scalar boundary check.
  trim-backward :: I64 -> I64 -> I64
  trim-backward base end =
    if ge-i64 end 8 then
      if word-all-slashes (load-path-word base (wrapping-sub-i64 end 8)) then trim-backward base (wrapping-sub-i64 end 8)
      else backward-tail base end end 0
    else backward-tail base end end 0

  -- | Seek the final slash using complete backwards words and machine counters.
  seek-backward :: I64 -> I64 -> I64
  seek-backward base end =
    if ge-i64 end 8 then
      if word-has-slash (load-path-word base (wrapping-sub-i64 end 8)) then backward-tail base end end 1
      else seek-backward base (wrapping-sub-i64 end 8)
    else backward-tail base end end 1

  -- | Seek the last component's final dot, preserving the original no-extension sentinel.
  extension-backward :: I64 -> I64 -> I64 -> I64
  extension-backward base end original =
    if ge-i64 end 8 then
      if word-has-slash-or-dot (load-path-word base (wrapping-sub-i64 end 8)) then backward-tail base end original 2
      else extension-backward base (wrapping-sub-i64 end 8) original
    else backward-tail base end original 2

  -- | Finish a backwards matching word or short prefix without reading before its start.
  backward-tail :: I64 -> I64 -> I64 -> U8 -> I64
  backward-tail base end original mode =
    if gt-i64 end 0 then
      let previous = wrapping-sub-i64 end 1 in let byte = load-path-byte base previous in
      if eq-u8 mode 0 then
        if eq-u8 byte 47 then backward-tail base previous original mode else end
      else if eq-u8 mode 1 then
        if eq-u8 byte 47 then end else backward-tail base previous original mode
      else if eq-u8 byte 46 then previous
      else if eq-u8 byte 47 then original
      else backward-tail base previous original mode
    else if eq-u8 mode 2 then original else 0

  -- | Find the next slash while retaining the complete borrowed backing interval.
  next-slash :: Bytes -> Nat -> Nat
  next-slash input i =
    if i <= bytes-len input then
      path-index (hold-path-buffer input (scan-forward (bytes-data input) (nat-to-i64 i) (nat-to-i64 (bytes-len input)) 0))
    else bytes-len input

  -- | Skip repeated separators in complete words and then an exact scalar fringe.
  skip-slashes :: Bytes -> Nat -> Nat
  skip-slashes input i =
    if i <= bytes-len input then
      path-index (hold-path-buffer input (scan-forward (bytes-data input) (nat-to-i64 i) (nat-to-i64 (bytes-len input)) 1))
    else bytes-len input

  -- | Remove trailing slash bytes, preserving their original byte interval for callers.
  trim-slashes :: Bytes -> Nat -> Nat
  trim-slashes input end =
    if end <= bytes-len input then path-index (hold-path-buffer input (scan-backward (bytes-data input) (nat-to-i64 end) 0)) else 0

  -- | Find the byte immediately after the last slash in a complete prefix, or zero.
  after-last-slash :: Bytes -> Nat -> Nat
  after-last-slash input end =
    if end <= bytes-len input then path-index (hold-path-buffer input (scan-backward (bytes-data input) (nat-to-i64 end) 1)) else 0

  -- | Whether a path starts with /; no normalization or filesystem lookup is performed.
  path-is-absolute :: String -> Bool
  path-is-absolute path = case string-char-at path 0 of Some char -> char-code char == 47; None -> False

  -- | Return the final nonempty component, / for slash-only paths, and . for empty input.
  path-base :: String -> String
  path-base path =
    let input = string-to-bytes path in let end = trim-slashes input (bytes-len input) in
    if end == 0 then (if bytes-len input == 0 then "." else "/")
    else text-interval input (after-last-slash input end) end

  -- | Split immediately after the final slash, preserving repeated and trailing separators.
  path-split :: String -> (String, String)
  path-split path =
    let input = string-to-bytes path in let n = bytes-len input in
    let at = after-last-slash input n in (text-interval input 0 at, text-interval input at n)

  -- | Return the cleaned directory portion, using . when no directory is present.
  path-dir :: String -> String
  path-dir path =
    let input = string-to-bytes path in clean-bytes (interval input 0 (after-last-slash input (bytes-len input)))

  -- | Find the final dot in the last component, stopping at a slash.
  extension-start :: Bytes -> Nat -> Nat
  extension-start input end =
    if end <= bytes-len input then path-index (hold-path-buffer input (scan-backward (bytes-data input) (nat-to-i64 end) 2)) else bytes-len input

  -- | Return the final dot and following bytes of the last component, or empty text.
  -- Leading dots count as extensions; a path ending in / has no extension.
  path-ext :: String -> String
  path-ext path = let input = string-to-bytes path in text-interval input (extension-start input (bytes-len input)) (bytes-len input)

  -- | Lexically collapse separators and dot components; an empty result becomes .
  -- Rooted parent components stop at /; leading relative parent components are retained.
  path-clean :: String -> String
  path-clean path = clean-bytes (string-to-bytes path)

  -- | Clean an owned input byte buffer into one private output stack of at most its length.
  clean-bytes :: Bytes -> String
  clean-bytes input =
    if bytes-len input == 0 then "."
    else let out = bytes-new (bytes-len input) in
      let rooted = bytes-get input 0 == 47 in
      if rooted then
        let first = bytes-set out 0 47 in clean-from input 1 out 1 1 True
      else clean-from input 0 out 0 0 False

  -- | Pop one unprotected component from the private output stack.
  pop-component :: Bytes -> Nat -> Nat -> Nat
  pop-component out end barrier =
    if end > barrier && end <= bytes-len out then
      let at = after-last-slash out (end - 1) in if at > barrier then at - 1 else barrier
    else barrier

  -- | Resolve complete components while carrying the protected root or leading-parent prefix.
  clean-from :: Bytes -> Nat -> Bytes -> Nat -> Nat -> Bool -> String
  clean-from input at out end barrier rooted =
    let start = skip-slashes input at in
    if start >= bytes-len input then
      if end == 0 then "." else text-interval out 0 end
    else let next = next-slash input start in
      if start <= next then
        let n = next - start in
        if n == 1 && start < bytes-len input && bytes-get input start == 46 then
          clean-from input next out end barrier rooted
        else if n == 2 && start + 2 <= bytes-len input && bytes-get input start == 46 && bytes-get input (start + 1) == 46 then
          if end > barrier then clean-from input next out (pop-component out end barrier) barrier rooted
          else if rooted then clean-from input next out end barrier rooted
          else append-component input start next out end barrier rooted True
        else append-component input start next out end barrier rooted False
      else "."

  -- | Append a complete component, inserting one separator and optionally protecting a leading parent.
  append-component :: Bytes -> Nat -> Nat -> Bytes -> Nat -> Nat -> Bool -> Bool -> String
  append-component input start next out end barrier rooted protect =
    let separator = end > 0 && not (rooted && end == 1) in
    let oi = if separator then end + 1 else end in
    if start <= next && next <= bytes-len input && oi + (next - start) <= bytes-len out then
      let slash = if separator && end < bytes-len out then bytes-set out end 47 else () in
      let copied = bytes-copy-range out input oi start (next - start) in
      let result = oi + (next - start) in
      clean-from input next out result (if protect then result else barrier) rooted
    else "."

  -- | Compute a once-allocated join size, ignoring empty elements and counting only inserted separators.
  join-size :: List String -> Nat -> Bool -> Nat
  join-size elements total seen = case elements of
    Nil -> total
    Cons first rest -> if string-byte-length first == 0 then join-size rest total seen
      else join-size rest (total + string-byte-length first + (if seen then 1 else 0)) True

  -- | Copy nonempty join elements once into a private exact-size destination.
  join-into :: List String -> Bytes -> Nat -> Bool -> Unit
  join-into elements out at seen = case elements of
    Nil -> ()
    Cons first rest -> if string-byte-length first == 0 then join-into rest out at seen
      else let source = string-to-bytes first in
        let oi = if seen then at + 1 else at in
        if oi + bytes-len source <= bytes-len out then
          let slash = if seen && at < bytes-len out then bytes-set out at 47 else () in
          let copied = bytes-copy-range out source oi 0 (bytes-len source) in
          join-into rest out (oi + bytes-len source) True
        else ()

  -- | Join nonempty path elements with / and clean the result; all-empty input returns empty text.
  -- Later absolute-looking elements do not discard preceding elements.
  path-join :: List String -> String
  path-join elements =
    let n = join-size elements 0 False in
    if n == 0 then empty-string else
      let out = bytes-new n in let copied = join-into elements out 0 False in clean-bytes out

  -- | A shell pattern contains an incomplete escape or malformed Unicode range class.
  data PathPatternError where
    -- | The complete pattern cannot be interpreted by the shell-pattern grammar.
    InvalidPathPattern :: PathPatternError

  -- | Render the stable malformed-pattern diagnostic.
  path-pattern-error-message :: PathPatternError -> String
  path-pattern-error-message error = "syntax error in pattern"

  -- | One private compiled matching term; literal byte runs preserve exact UTF-8 wire values.
  data PathTerm where
    -- | Match any sequence of non-slash bytes.
    GlobStar :: PathTerm
    -- | Match one Unicode scalar other than slash.
    GlobQuestion :: PathTerm
    -- | Match an exact private byte run, including escaped metacharacters.
    GlobLiteral :: Bytes -> PathTerm
    -- | Match a Unicode range union, optionally complemented.
    GlobClass :: Bool -> List (Nat, Nat) -> PathTerm

  -- | An immutable, fully checked shell pattern reusable across independent path names.
  data PathPattern where
    -- | Private complete list of compiled terms and owned literal buffers.
    CompiledPattern :: List PathTerm -> PathPattern

  -- | Find the next metacharacter with a machine-counter SIMD loop and a retained owner.
  literal-end :: Bytes -> Nat -> Nat
  literal-end pattern at =
    if at <= bytes-len pattern then
      path-index (hold-path-buffer pattern (scan-forward (bytes-data pattern) (nat-to-i64 at) (nat-to-i64 (bytes-len pattern)) 2))
    else bytes-len pattern

  -- | Parse a complete pattern, rejecting malformed suffixes even when an earlier term cannot match.
  path-pattern :: String -> Result PathPatternError PathPattern
  path-pattern pattern = parse-pattern (string-to-bytes pattern) 0 Nil

  -- | Build matching terms without exposing mutable pattern or lookup storage.
  parse-pattern :: Bytes -> Nat -> List PathTerm -> Result PathPatternError PathPattern
  parse-pattern pattern at reversed = if at < bytes-len pattern then
    let byte = bytes-get pattern at in
    if byte == 42 then parse-pattern pattern (at + 1) (Cons GlobStar reversed)
    else if byte == 63 then parse-pattern pattern (at + 1) (Cons GlobQuestion reversed)
    else if byte == 92 then
      if at + 1 < bytes-len pattern then
        parse-pattern pattern (at + 2) (Cons (GlobLiteral (interval pattern (at + 1) (at + 2))) reversed)
      else Err InvalidPathPattern
    else if byte == 91 then
      let start = at + 1 in
      let negated = if start < bytes-len pattern then bytes-get pattern start == 94 else False in
      case parse-class pattern (if negated then start + 1 else start) Nil of
        Err error -> Err error
        Ok pair -> case pair of (next, ranges) -> parse-pattern pattern next (Cons (GlobClass negated ranges) reversed)
    else let end = literal-end pattern at in
      parse-pattern pattern end (Cons (GlobLiteral (interval pattern at end)) reversed)
    else Ok (CompiledPattern (reverse reversed))

  -- | Parse one optionally escaped class scalar, requiring a following range delimiter.
  class-scalar :: Bytes -> Nat -> Result PathPatternError (Nat, Nat)
  class-scalar pattern at = if at < bytes-len pattern then
    let byte = bytes-get pattern at in
    if byte == 45 || byte == 93 then Err InvalidPathPattern
    else let start = if byte == 92 then at + 1 else at in
      case utf8-at pattern start of
        None -> Err InvalidPathPattern
        Some pair -> case pair of
          (char, width) -> if start + width < bytes-len pattern then Ok (char-code char, start + width) else Err InvalidPathPattern
    else Err InvalidPathPattern

  -- | Parse a nonempty range union through its closing bracket; descending ranges remain empty ranges.
  parse-class :: Bytes -> Nat -> List (Nat, Nat) -> Result PathPatternError (Nat, List (Nat, Nat))
  parse-class pattern at reversed =
    if at < bytes-len pattern then
      if bytes-get pattern at == 93 && list-length reversed > 0 then Ok (at + 1, reverse reversed)
      else case class-scalar pattern at of
        Err error -> Err error
        Ok first -> case first of
          (low, next) -> if next < bytes-len pattern && bytes-get pattern next == 45 then
            case class-scalar pattern (next + 1) of
              Err error -> Err error
              Ok last -> case last of (high, end) -> parse-class pattern end (Cons (low, high) reversed)
            else parse-class pattern next (Cons (low, low) reversed)
    else Err InvalidPathPattern

  -- | Decode a scalar at an arbitrary byte position; a skipped UTF-8 continuation is one replacement scalar.
  match-scalar :: Bytes -> Nat -> (Nat, Nat)
  match-scalar name at = case utf8-at name at of
    Some pair -> case pair of (char, width) -> (char-code char, width)
    None -> (65533, 1)

  -- | Match one Unicode scalar against an immutable union of inclusive ranges.
  in-ranges :: Nat -> List (Nat, Nat) -> Bool
  in-ranges char ranges = case ranges of
    Nil -> False
    Cons pair rest -> case pair of (low, high) -> if low <= char && char <= high then True else in-ranges char rest

  -- | Compare exact borrowed literal intervals in complete native words, retaining owners at the checked caller.
  equal-literal :: I64 -> I64 -> I64 -> Bool
  equal-literal left right remaining =
    if ge-i64 remaining 8 then
      if eq-u64 (load-path-word left 0) (load-path-word right 0) then
        equal-literal (wrapping-add-i64 left 8) (wrapping-add-i64 right 8) (wrapping-sub-i64 remaining 8)
      else False
    else equal-literal-tail left right remaining

  -- | Compare the exact final bytes with machine-only tail-loop state and no overread.
  equal-literal-tail :: I64 -> I64 -> I64 -> Bool
  equal-literal-tail left right remaining =
    if gt-i64 remaining 0 then
      if eq-u8 (load-path-byte left 0) (load-path-byte right 0) then
        equal-literal-tail (wrapping-add-i64 left 1) (wrapping-add-i64 right 1) (wrapping-sub-i64 remaining 1)
      else False
    else True

  -- | Check a complete literal interval and retain both backing owners around its raw traversal.
  literal-matches :: Bytes -> Bytes -> Nat -> Bool
  literal-matches literal name at =
    if at + bytes-len literal <= bytes-len name then
      hold-path-buffer literal (hold-path-buffer name (equal-literal (bytes-data literal) (wrapping-add-i64 (bytes-data name) (nat-to-i64 at)) (nat-to-i64 (bytes-len literal))))
    else False

  -- | Match a star-free compiled chunk at one candidate byte position.
  match-chunk :: List PathTerm -> Bytes -> Nat -> Option Nat
  match-chunk terms name at = case terms of
    Nil -> Some at
    Cons first rest -> case first of
      GlobStar -> None
      GlobLiteral literal ->
        if at + bytes-len literal <= bytes-len name && literal-matches literal name at then match-chunk rest name (at + bytes-len literal) else None
      GlobQuestion -> if at < bytes-len name then
        if bytes-get name at == 47 then None else case match-scalar name at of
          (char, width) -> match-chunk rest name (at + width)
        else None
      GlobClass negated ranges ->
        if at < bytes-len name then
          (case match-scalar name at of (char, width) -> if in-ranges char ranges /= negated then match-chunk rest name (at + width) else None)
        else None

  -- | Collect the next star-free chunk without copying its literal buffers.
  take-chunk :: List PathTerm -> List PathTerm -> (List PathTerm, List PathTerm)
  take-chunk terms reversed = case terms of
    Nil -> (reverse reversed, Nil)
    Cons first rest -> case first of
      GlobStar -> (reverse reversed, terms)
      other -> take-chunk rest (Cons first reversed)

  -- | Consume repeated leading stars and retain whether they allow candidate advancement.
  drop-stars :: List PathTerm -> Bool -> (Bool, List PathTerm)
  drop-stars terms seen = case terms of
    Nil -> (seen, Nil)
    Cons first rest -> case first of GlobStar -> drop-stars rest True; other -> (seen, terms)

  -- | Check whether a compiled suffix has any further matching chunks.
  has-terms :: List PathTerm -> Bool
  has-terms terms = case terms of Nil -> False; Cons first rest -> True

  -- | Search later candidates without allowing a star to consume a slash byte.
  search-chunk :: List PathTerm -> List PathTerm -> Bytes -> Nat -> Bool
  search-chunk chunk rest name at =
    if at < bytes-len name && bytes-get name at /= 47 then
      let next = at + 1 in case match-chunk chunk name next of
        Some end -> if end == bytes-len name || has-terms rest then match-terms rest name end else search-chunk chunk rest name next
        None -> search-chunk chunk rest name next
    else False

  -- | Match complete compiled chunks using earliest successful star advancement.
  match-terms :: List PathTerm -> Bytes -> Nat -> Bool
  match-terms terms name at = case drop-stars terms False of
    (star, remaining) -> if not (has-terms remaining) then
      if star then next-slash name at == bytes-len name else at == bytes-len name
      else case take-chunk remaining Nil of
        (chunk, rest) -> case match-chunk chunk name at of
          Some end -> if end == bytes-len name || has-terms rest then match-terms rest name end
            else if star then search-chunk chunk rest name at else False
          None -> if star then search-chunk chunk rest name at else False

  -- | Match a reusable checked pattern against an entire path name.
  -- Pattern state and path text remain immutable across repeated calls.
  path-pattern-match :: PathPattern -> String -> Bool
  path-pattern-match pattern name = case pattern of CompiledPattern terms -> match-terms terms (string-to-bytes name) 0

  -- | Check and match a shell pattern against the entire UTF-8 path name.
  path-match :: String -> String -> Result PathPatternError Bool
  path-match pattern name = case path-pattern pattern of
    Err error -> Err error
    Ok compiled -> Ok (path-pattern-match compiled name)
