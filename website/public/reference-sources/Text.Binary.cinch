-- | Unsigned fixed-width integers and signed/unsigned variable-length wire encodings.
-- Reads accept zero-based byte offsets and return named errors for short input.
-- Varint reads also return the number of consumed bytes, excluding the offset.
-- Encoders allocate fresh buffers; put operations check the complete destination
-- range before writing. Signed varints use zigzag encoding across the full I64
-- range. Fixed-width words use byte swaps; varint prefix detection
-- and payload compaction use SWAR, with an exact scalar tail.
module Text.Binary where

  import Data.Bytes
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Result

  export ByteOrder, LittleEndian, BigEndian
  export BinaryError, UnexpectedBinaryEnd, BinaryVarintOverflow
  export binary-u16, binary-u32, binary-u64
  export binary-read-u16, binary-read-u32, binary-read-u64
  export binary-put-u16, binary-put-u32, binary-put-u64
  export binary-uvarint, binary-varint, binary-read-uvarint, binary-read-varint

  -- | Byte significance for fixed-width wire encodings; independent of host byte order.
  data ByteOrder where
    -- | Store the least significant byte first.
    LittleEndian :: ByteOrder
    -- | Store the most significant byte first.
    BigEndian :: ByteOrder

  -- | A binary input or destination cannot satisfy the requested operation.
  data BinaryError where
    -- | The complete fixed-width field, destination range or terminated varint is unavailable.
    UnexpectedBinaryEnd :: BinaryError
    -- | A varint would require more than 64 payload bits, including an invalid tenth byte.
    BinaryVarintOverflow :: BinaryError

  -- | Expand the low word into exactly the requested number of little-endian bytes.
  word-bytes :: U64 -> Nat -> List (InRange 0 255 Nat)
  word-bytes x n =
    if n == 0 then Nil
    else Cons (u8-to-nat (wrapping-u64-to-u8 x)) (word-bytes (wrapping-shr-u64 x 8) (n - 1))

  -- | Allocate a fixed-width encoding, reversing byte order when the wire format requires it.
  encode-word :: ByteOrder -> U64 -> Nat -> Bytes
  encode-word order x n = case order of
    LittleEndian -> bytes-from-list (word-bytes x n)
    BigEndian -> bytes-from-list (reverse (word-bytes x n))

  -- | Allocate exactly 2 bytes encoding an unsigned 16-bit value in the selected byte order.
  binary-u16 :: ByteOrder -> U16 -> Bytes
  binary-u16 order x = encode-word order (u16-to-u64 x) 2

  -- | Allocate exactly 4 bytes encoding an unsigned 32-bit value in the selected byte order.
  binary-u32 :: ByteOrder -> U32 -> Bytes
  binary-u32 order x =
    let out = bytes-new 4 in
    let stored = bytes-store-le32 out 0 (ordered32 order x) in
    out

  -- | Allocate exactly 8 bytes encoding an unsigned 64-bit value in the selected byte order.
  binary-u64 :: ByteOrder -> U64 -> Bytes
  binary-u64 order x =
    let out = bytes-new 8 in
    let stored = bytes-store-le64 out 0 (ordered64 order x) in
    out

  -- | Read a short fixed-width field while preserving the requested byte order; stop with a named error at the first missing byte.
  read-word :: ByteOrder -> Bytes -> Nat -> Nat -> U32 -> U64 -> Result BinaryError U64
  read-word order b pos n shift acc =
    if n == 0 then Ok acc
    else if pos < bytes-len b then
      let v = wrapping-i64-to-u64 (nat-to-i64 (bytes-get b pos)) in
      case order of
        LittleEndian -> read-word order b (pos + 1) (n - 1) (wrapping-add-u32 shift 8) (bit-or-u64 acc (wrapping-shl-u64 v shift))
        BigEndian -> read-word order b (pos + 1) (n - 1) shift (bit-or-u64 (wrapping-shl-u64 acc 8) v)
    else Err UnexpectedBinaryEnd

  -- | Read an unsigned 16-bit field at the zero-based byte offset. Fewer than 2 available bytes returns UnexpectedBinaryEnd; trailing bytes are untouched.
  binary-read-u16 :: ByteOrder -> Bytes -> Nat -> Result BinaryError U16
  binary-read-u16 order b pos = case read-word order b pos 2 0 0 of
    Err e -> Err e
    Ok x -> Ok (wrapping-u64-to-u16 x)

  -- | Read an unsigned 32-bit field at the zero-based byte offset. Fewer than 4 available bytes returns UnexpectedBinaryEnd; trailing bytes are untouched.
  binary-read-u32 :: ByteOrder -> Bytes -> Nat -> Result BinaryError U32
  binary-read-u32 order b pos =
    if pos + 4 <= bytes-len b then Ok (ordered32 order (bytes-load-le32 b pos))
    else Err UnexpectedBinaryEnd

  -- | Read an unsigned 64-bit field at the zero-based byte offset. Fewer than 8 available bytes returns UnexpectedBinaryEnd; trailing bytes are untouched.
  binary-read-u64 :: ByteOrder -> Bytes -> Nat -> Result BinaryError U64
  binary-read-u64 order b pos =
    if pos + 8 <= bytes-len b then Ok (ordered64 order (bytes-load-le64 b pos))
    else Err UnexpectedBinaryEnd

  -- | Copy a complete encoded field only after proving that its entire destination range fits.
  put-word :: Bytes -> Nat -> Bytes -> Result BinaryError Unit
  put-word dst pos src =
    if pos + bytes-len src <= bytes-len dst then Ok (bytes-copy-range dst src pos 0 (bytes-len src))
    else Err UnexpectedBinaryEnd

  -- | Write an unsigned 16-bit field into an existing buffer at the zero-based offset. Check all 2 destination bytes before mutation; failure leaves the buffer unchanged.
  binary-put-u16 :: ByteOrder -> Bytes -> Nat -> U16 -> Result BinaryError Unit
  binary-put-u16 order dst pos x = put-word dst pos (binary-u16 order x)

  -- | Write an unsigned 32-bit field into an existing buffer at the zero-based offset. Check all 4 destination bytes before mutation; failure leaves the buffer unchanged.
  binary-put-u32 :: ByteOrder -> Bytes -> Nat -> U32 -> Result BinaryError Unit
  binary-put-u32 order dst pos x =
    if pos + 4 <= bytes-len dst then Ok (bytes-store-le32 dst pos (ordered32 order x))
    else Err UnexpectedBinaryEnd

  -- | Write an unsigned 64-bit field into an existing buffer at the zero-based offset. Check all 8 destination bytes before mutation; failure leaves the buffer unchanged.
  binary-put-u64 :: ByteOrder -> Bytes -> Nat -> U64 -> Result BinaryError Unit
  binary-put-u64 order dst pos x =
    if pos + 8 <= bytes-len dst then Ok (bytes-store-le64 dst pos (ordered64 order x))
    else Err UnexpectedBinaryEnd

  -- | Emit seven payload bits per byte, setting continuation bits until the remaining payload is below 128.
  uvarint-bytes :: U64 -> List (InRange 0 255 Nat)
  uvarint-bytes x =
    if lt-u64 x 128 then Cons (u8-to-nat (wrapping-u64-to-u8 x)) Nil
    else Cons (u8-to-nat (wrapping-u64-to-u8 (bit-or-u64 (bit-and-u64 x 127) 128))) (uvarint-bytes (wrapping-shr-u64 x 7))

  -- | Encode a U64 in one to ten little-endian base-128 bytes, with the high bit marking continuation. The emitted representation is minimal.
  binary-uvarint :: U64 -> Bytes
  binary-uvarint x = bytes-from-list (uvarint-bytes x)

  -- | Zigzag-encode an I64, then encode it as an unsigned varint. Zero maps to 0, -1 to 1, and 1 to 2; both I64 extrema are supported.
  binary-varint :: I64 -> Bytes
  binary-varint x = binary-uvarint (bit-xor-u64 (wrapping-shl-u64 (wrapping-i64-to-u64 x) 1) (wrapping-i64-to-u64 (wrapping-shr-i64 x 63)))

  -- | Read at most ten scalar bytes; reject overflow before a wrapping shift could discard payload bits.
  read-uvarint :: Bytes -> Nat -> Nat -> U32 -> U64 -> Result BinaryError (U64, Nat)
  read-uvarint b pos used shift acc =
    if pos < bytes-len b then
      let v = bytes-get b pos in
      if used == 9 && v > 1 then Err BinaryVarintOverflow
      else
        let w = wrapping-i64-to-u64 (nat-to-i64 (nat-rem v 128)) in
        let next = bit-or-u64 acc (wrapping-shl-u64 w shift) in
        if v < 128 then Ok (next, used + 1)
        else read-uvarint b (pos + 1) (used + 1) (wrapping-add-u32 shift 7) next
    else Err UnexpectedBinaryEnd

  -- | Read a terminated unsigned varint at the byte offset and return (value, bytes-consumed). Nonminimal encodings are accepted; incomplete input and 64-bit overflow are distinct errors.
  binary-read-uvarint :: Bytes -> Nat -> Result BinaryError (U64, Nat)
  binary-read-uvarint b pos =
    if pos + 8 <= bytes-len b then
      let word = bytes-load-le64 b pos in
      let ends = bit-and-u64 (bit-not-u64 word) 0x8080808080808080 in
      if eq-u64 ends 0 then read-uvarint b pos 0 0 0
      else
        let n = nat-div (u32-to-nat (trailing-zeros-u64 ends)) 8 + 1 in
        let shift = wrapping-i64-to-u32 (nat-to-i64 (nat-rem (n * 7) 64)) in
        let mask = wrapping-sub-u64 (wrapping-shl-u64 1 shift) 1 in
        Ok (bit-and-u64 (compress-varint8 word) mask, n)
    else read-uvarint b pos 0 0 0

  -- | Read and inverse-zigzag an unsigned varint at the byte offset, returning (signed-value, bytes-consumed). Shares the unsigned decoder's truncation and overflow errors.
  binary-read-varint :: Bytes -> Nat -> Result BinaryError (I64, Nat)
  binary-read-varint b pos = case binary-read-uvarint b pos of
    Err e -> Err e
    Ok (u, n) ->
      let x = wrapping-u64-to-i64 (wrapping-shr-u64 u 1) in
      if eq-u64 (bit-and-u64 u 1) 1 then Ok (bit-not-i64 x, n) else Ok (x, n)

  -- | Convert a wire byte order to the packed little-endian word convention.
  ordered32 :: ByteOrder -> U32 -> U32
  ordered32 order x = case order of
    LittleEndian -> x
    BigEndian -> swap-bytes-u32 x

  -- | Convert a wire byte order to the packed little-endian word convention.
  ordered64 :: ByteOrder -> U64 -> U64
  ordered64 order x = case order of
    LittleEndian -> x
    BigEndian -> swap-bytes-u64 x

  -- | Compact eight seven-bit payloads in a packed word; continuation-bit detection is done separately.
  compress-varint8 :: U64 -> U64
  compress-varint8 word =
    let step1 = bit-or-u64 (bit-and-u64 word 0x007f007f007f007f) (wrapping-shr-u64 (bit-and-u64 word 0x7f007f007f007f00) 1) in
    let step2 = bit-or-u64 (bit-and-u64 step1 0x00003fff00003fff) (wrapping-shr-u64 (bit-and-u64 step1 0x3fff00003fff0000) 2) in
    bit-or-u64 (bit-and-u64 step2 0x000000000fffffff) (wrapping-shl-u64 (wrapping-shr-u64 step2 32) 28)
