-- | Deterministic 32-, 64- and 128-bit FNV-1 and FNV-1a hashing over bytes.
-- Overflow wraps explicitly. Update functions accept a finished hash, so chunked
-- and concatenated input agree. Empty input yields the offset basis, and empty
-- updates leave the state unchanged. Inline LLVM unrolls eight ordered steps at
-- a time; the recurrence stays sequential. These non-cryptographic hashes are
-- separate from the collection hashing vocabulary in Data.Hash.
module Text.Fnv where

  import Data.Bool
  import Data.Bytes
  import Data.Bytes.Word
  import Data.Machine
  import Data.Nat

  export fnv32, fnv32a, fnv64, fnv64a, fnv128, fnv128a
  export fnv32-update, fnv32a-update, fnv64-update, fnv64a-update, fnv128-update, fnv128a-update

  -- | Compute 32-bit FNV-1, multiplying before xor, with offset basis 0x811C9DC5.
  fnv32 :: Bytes -> U32
  fnv32 b = fnv32-update 0x811C9DC5 b

  -- | Compute 32-bit FNV-1a, xor before multiplying, with offset basis 0x811C9DC5.
  fnv32a :: Bytes -> U32
  fnv32a b = fnv32a-update 0x811C9DC5 b

  -- | Compute 64-bit FNV-1, multiplying before xor, with offset basis 0xCBF29CE484222325.
  fnv64 :: Bytes -> U64
  fnv64 b = fnv64-update 0xCBF29CE484222325 b

  -- | Compute 64-bit FNV-1a, xor before multiplying, with offset basis 0xCBF29CE484222325.
  fnv64a :: Bytes -> U64
  fnv64a b = fnv64a-update 0xCBF29CE484222325 b

  -- | Continue a finished 32-bit FNV-1 hash with more bytes; an empty update preserves the hash.
  fnv32-update :: U32 -> Bytes -> U32
  fnv32-update previous b = fold32 False b 0 previous

  -- | Continue a finished 32-bit FNV-1a hash with more bytes; an empty update preserves the hash.
  fnv32a-update :: U32 -> Bytes -> U32
  fnv32a-update previous b = fold32 True b 0 previous

  -- | Continue a finished 64-bit FNV-1 hash with more bytes; an empty update preserves the hash.
  fnv64-update :: U64 -> Bytes -> U64
  fnv64-update previous b = fold64 0 b previous

  -- | Continue a finished 64-bit FNV-1a hash with more bytes; an empty update preserves the hash.
  fnv64a-update :: U64 -> Bytes -> U64
  fnv64a-update previous b = fold64 1 b previous

  -- | Hash native eight-byte blocks in order, then the exact byte tail; the flag selects xor-before-multiply.
  fold32 :: Bool -> Bytes -> Nat -> U32 -> U32
  fold32 alternate b i acc =
    if i + 8 <= bytes-len b then
      fold32 alternate b (i + 8) (fnv32-word acc (bytes-read-le64 b i) (if alternate then 1 else 0))
    else if i < bytes-len b then
      let v = wrapping-i64-to-u32 (nat-to-i64 (bytes-get b i)) in
      let next = if alternate then wrapping-mul-u32 (bit-xor-u32 acc v) 0x01000193 else bit-xor-u32 (wrapping-mul-u32 acc 0x01000193) v in
      fold32 alternate b (i + 1) next
    else acc

  -- | Borrow the payload once. Native offsets stay in the unboxed machine
  -- representation and the buffer remains live throughout both loops.
  fold64 :: U8 -> Bytes -> U64 -> U64
  fold64 alternate b initial =
    let end = nat-to-i64 (bytes-len b) in
    let complete = wrapping-sub-i64 end 7 in
    let result = fold64-blocks alternate (bytes-data b) 0 complete end initial in
    case bytes-len b of _ -> result

  -- | Consume complete eight-byte blocks, then pass the remaining bytes to the tail loop.
  fold64-blocks :: U8 -> I64 -> I64 -> I64 -> I64 -> U64 -> U64
  fold64-blocks alternate address offset complete end acc =
    if lt-i64 offset complete then
      fold64-blocks alternate address (wrapping-add-i64 offset 8) complete end
        (fnv64-word acc (fnv64-load-word address offset) alternate)
    else fold64-tail alternate address offset end acc

  -- | Fold the final zero through seven bytes in input order.
  fold64-tail :: U8 -> I64 -> I64 -> I64 -> U64 -> U64
  fold64-tail alternate address offset end acc =
    if lt-i64 offset end then
      fold64-tail alternate address (wrapping-add-i64 offset 1) end
        (fnv64-byte acc (fnv64-load-byte address offset) alternate)
    else acc

  -- | Load a complete eight-byte block in low-byte-first order at the checked offset.
  prim fnv64-load-word :: I64 -> I64 -> U64 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %address = getelementptr i8, ptr %base, i64 %1
      %word = load i64, ptr %address, align 1
      ret i64 %word
    } when endian little
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %address = getelementptr i8, ptr %base, i64 %1
      %word = load i64, ptr %address, align 1
      %ordered = call i64 @llvm.bswap.i64(i64 %word)
      ret i64 %ordered
    } when endian big

  -- | Load one checked tail byte and zero-extend it to a 64-bit word.
  prim fnv64-load-byte :: I64 -> I64 -> U64 where
    unsafe llvm {
      %base = inttoptr i64 %0 to ptr
      %address = getelementptr i8, ptr %base, i64 %1
      %byte = load i8, ptr %address, align 1
      %word = zext i8 %byte to i64
      ret i64 %word
    }

  -- | Advance one FNV-1 or FNV-1a byte step with wrapping multiplication.
  prim fnv64-byte :: U64 -> U64 -> U8 -> U64 where
    llvm {
      %alternate = icmp ne i8 %2, 0
      %before = select i1 %alternate, i64 %1, i64 0
      %after = select i1 %alternate, i64 0, i64 %1
      %mixed = xor i64 %0, %before
      %scaled = mul i64 %mixed, 1099511628211
      %result = xor i64 %scaled, %after
      ret i64 %result
    }

  -- | Unroll eight ordered FNV steps; the recurrence is sequential, so lanes must not be reassociated.
  prim fnv32-word :: U32 -> U64 -> U8 -> U32 where
    llvm {
      %alternate = icmp ne i8 %2, 0
      %s0 = lshr i64 %1, 0
      %v0 = and i64 %s0, 255
      %b0 = trunc i64 %v0 to i32
      %x0 = xor i32 %0, %b0
      %a0 = mul i32 %x0, 16777619
      %m0 = mul i32 %0, 16777619
      %f0 = xor i32 %m0, %b0
      %r0 = select i1 %alternate, i32 %a0, i32 %f0
      %s1 = lshr i64 %1, 8
      %v1 = and i64 %s1, 255
      %b1 = trunc i64 %v1 to i32
      %x1 = xor i32 %r0, %b1
      %a1 = mul i32 %x1, 16777619
      %m1 = mul i32 %r0, 16777619
      %f1 = xor i32 %m1, %b1
      %r1 = select i1 %alternate, i32 %a1, i32 %f1
      %s2 = lshr i64 %1, 16
      %v2 = and i64 %s2, 255
      %b2 = trunc i64 %v2 to i32
      %x2 = xor i32 %r1, %b2
      %a2 = mul i32 %x2, 16777619
      %m2 = mul i32 %r1, 16777619
      %f2 = xor i32 %m2, %b2
      %r2 = select i1 %alternate, i32 %a2, i32 %f2
      %s3 = lshr i64 %1, 24
      %v3 = and i64 %s3, 255
      %b3 = trunc i64 %v3 to i32
      %x3 = xor i32 %r2, %b3
      %a3 = mul i32 %x3, 16777619
      %m3 = mul i32 %r2, 16777619
      %f3 = xor i32 %m3, %b3
      %r3 = select i1 %alternate, i32 %a3, i32 %f3
      %s4 = lshr i64 %1, 32
      %v4 = and i64 %s4, 255
      %b4 = trunc i64 %v4 to i32
      %x4 = xor i32 %r3, %b4
      %a4 = mul i32 %x4, 16777619
      %m4 = mul i32 %r3, 16777619
      %f4 = xor i32 %m4, %b4
      %r4 = select i1 %alternate, i32 %a4, i32 %f4
      %s5 = lshr i64 %1, 40
      %v5 = and i64 %s5, 255
      %b5 = trunc i64 %v5 to i32
      %x5 = xor i32 %r4, %b5
      %a5 = mul i32 %x5, 16777619
      %m5 = mul i32 %r4, 16777619
      %f5 = xor i32 %m5, %b5
      %r5 = select i1 %alternate, i32 %a5, i32 %f5
      %s6 = lshr i64 %1, 48
      %v6 = and i64 %s6, 255
      %b6 = trunc i64 %v6 to i32
      %x6 = xor i32 %r5, %b6
      %a6 = mul i32 %x6, 16777619
      %m6 = mul i32 %r5, 16777619
      %f6 = xor i32 %m6, %b6
      %r6 = select i1 %alternate, i32 %a6, i32 %f6
      %s7 = lshr i64 %1, 56
      %v7 = and i64 %s7, 255
      %b7 = trunc i64 %v7 to i32
      %x7 = xor i32 %r6, %b7
      %a7 = mul i32 %x7, 16777619
      %m7 = mul i32 %r6, 16777619
      %f7 = xor i32 %m7, %b7
      %r7 = select i1 %alternate, i32 %a7, i32 %f7
      ret i32 %r7
    }

  -- | Unroll eight ordered FNV steps; the recurrence is sequential, so lanes must not be reassociated.
  prim fnv64-word :: U64 -> U64 -> U8 -> U64 where
    llvm {
      %alternate = icmp ne i8 %2, 0
      %s0 = lshr i64 %1, 0
      %v0 = and i64 %s0, 255
      %before0 = select i1 %alternate, i64 %v0, i64 0
      %after0 = select i1 %alternate, i64 0, i64 %v0
      %mixed0 = xor i64 %0, %before0
      %scaled0 = mul i64 %mixed0, 1099511628211
      %r0 = xor i64 %scaled0, %after0
      %s1 = lshr i64 %1, 8
      %v1 = and i64 %s1, 255
      %before1 = select i1 %alternate, i64 %v1, i64 0
      %after1 = select i1 %alternate, i64 0, i64 %v1
      %mixed1 = xor i64 %r0, %before1
      %scaled1 = mul i64 %mixed1, 1099511628211
      %r1 = xor i64 %scaled1, %after1
      %s2 = lshr i64 %1, 16
      %v2 = and i64 %s2, 255
      %before2 = select i1 %alternate, i64 %v2, i64 0
      %after2 = select i1 %alternate, i64 0, i64 %v2
      %mixed2 = xor i64 %r1, %before2
      %scaled2 = mul i64 %mixed2, 1099511628211
      %r2 = xor i64 %scaled2, %after2
      %s3 = lshr i64 %1, 24
      %v3 = and i64 %s3, 255
      %before3 = select i1 %alternate, i64 %v3, i64 0
      %after3 = select i1 %alternate, i64 0, i64 %v3
      %mixed3 = xor i64 %r2, %before3
      %scaled3 = mul i64 %mixed3, 1099511628211
      %r3 = xor i64 %scaled3, %after3
      %s4 = lshr i64 %1, 32
      %v4 = and i64 %s4, 255
      %before4 = select i1 %alternate, i64 %v4, i64 0
      %after4 = select i1 %alternate, i64 0, i64 %v4
      %mixed4 = xor i64 %r3, %before4
      %scaled4 = mul i64 %mixed4, 1099511628211
      %r4 = xor i64 %scaled4, %after4
      %s5 = lshr i64 %1, 40
      %v5 = and i64 %s5, 255
      %before5 = select i1 %alternate, i64 %v5, i64 0
      %after5 = select i1 %alternate, i64 0, i64 %v5
      %mixed5 = xor i64 %r4, %before5
      %scaled5 = mul i64 %mixed5, 1099511628211
      %r5 = xor i64 %scaled5, %after5
      %s6 = lshr i64 %1, 48
      %v6 = and i64 %s6, 255
      %before6 = select i1 %alternate, i64 %v6, i64 0
      %after6 = select i1 %alternate, i64 0, i64 %v6
      %mixed6 = xor i64 %r5, %before6
      %scaled6 = mul i64 %mixed6, 1099511628211
      %r6 = xor i64 %scaled6, %after6
      %s7 = lshr i64 %1, 56
      %v7 = and i64 %s7, 255
      %before7 = select i1 %alternate, i64 %v7, i64 0
      %after7 = select i1 %alternate, i64 0, i64 %v7
      %mixed7 = xor i64 %r6, %before7
      %scaled7 = mul i64 %mixed7, 1099511628211
      %r7 = xor i64 %scaled7, %after7
      ret i64 %r7
    }

  -- | Compute 128-bit FNV-1 with the standard offset basis, returning high word then low word.
  -- Two U64 words preserve the full hash on every target without a wide-scalar ABI dependency.
  fnv128 :: Bytes -> (U64, U64)
  fnv128 b = fnv128-update (0x6c62272e07bb0142, 0x62b821756295c58d) b

  -- | Compute 128-bit FNV-1a, returning high word then low word.
  -- This deterministic hash is non-cryptographic; serialization byte order is chosen separately.
  fnv128a :: Bytes -> (U64, U64)
  fnv128a b = fnv128a-update (0x6c62272e07bb0142, 0x62b821756295c58d) b

  -- | Continue a 128-bit FNV-1 state given as high and low words. Empty input preserves both words.
  fnv128-update :: (U64, U64) -> Bytes -> (U64, U64)
  fnv128-update previous b = case previous of (high, low) -> fold128 False b 0 high low

  -- | Continue a high/low 128-bit FNV-1a state; arbitrary input chunking preserves the final result.
  fnv128a-update :: (U64, U64) -> Bytes -> (U64, U64)
  fnv128a-update previous b = case previous of (high, low) -> fold128 True b 0 high low

  -- | Consume eight-byte blocks in order, then an exact scalar tail, with modulo-2^128 overflow.
  -- No reassociation across byte positions is valid for this recurrence.
  fold128 :: Bool -> Bytes -> Nat -> U64 -> U64 -> (U64, U64)
  fold128 alternate b i high low =
    if i + 8 <= bytes-len b then
      let word = bytes-read-le64 b i in
      let upper = if alternate then fnv128a-high high low word else fnv128-high high low word in
      let lower = if alternate then fnv128a-low high low word else fnv128-low high low word in
      fold128 alternate b (i + 8) upper lower
    else if i < bytes-len b then
      let v = wrapping-i64-to-u8 (nat-to-i64 (bytes-get b i)) in
      let upper = fnv128-step-high high low v (if alternate then 1 else 0) in
      let lower = if alternate then wrapping-mul-u64 (bit-xor-u64 low (u8-to-u64 v)) 315 else bit-xor-u64 (wrapping-mul-u64 low 315) (u8-to-u64 v) in
      fold128 alternate b (i + 1) upper lower
    else (high, low)

  -- | Compute one high-word step with the xor order selected before the wide multiply.
  prim fnv128-step-high :: U64 -> U64 -> U8 -> U8 -> U64 where
    llvm {
      %byte = zext i8 %2 to i64
      %xored = xor i64 %1, %byte
      %alternate = icmp ne i8 %3, 0
      %lo = select i1 %alternate, i64 %xored, i64 %1
      %hi = zext i64 %0 to i128
      %shifted = shl i128 %hi, 64
      %low = zext i64 %lo to i128
      %state = or i128 %shifted, %low
      %product = mul i128 %state, 309485009821345068724781371
      %upper = lshr i128 %product, 64
      %result = trunc i128 %upper to i64
      ret i64 %result
    }

  -- | Compute the low word of eight ordered FNV-1 steps.
  -- Fixed-width arguments keep the fragment portable across primitive ABI targets.
  prim fnv128-low :: U64 -> U64 -> U64 -> U64 where
    llvm {
      %upper = zext i64 %0 to i128
      %shifted = shl i128 %upper, 64
      %lower = zext i64 %1 to i128
      %state = or i128 %shifted, %lower
      %s0 = lshr i64 %2, 0
      %v0 = and i64 %s0, 255
      %b0 = zext i64 %v0 to i128
      %m0 = mul i128 %state, 309485009821345068724781371
      %r0 = xor i128 %m0, %b0
      %s1 = lshr i64 %2, 8
      %v1 = and i64 %s1, 255
      %b1 = zext i64 %v1 to i128
      %m1 = mul i128 %r0, 309485009821345068724781371
      %r1 = xor i128 %m1, %b1
      %s2 = lshr i64 %2, 16
      %v2 = and i64 %s2, 255
      %b2 = zext i64 %v2 to i128
      %m2 = mul i128 %r1, 309485009821345068724781371
      %r2 = xor i128 %m2, %b2
      %s3 = lshr i64 %2, 24
      %v3 = and i64 %s3, 255
      %b3 = zext i64 %v3 to i128
      %m3 = mul i128 %r2, 309485009821345068724781371
      %r3 = xor i128 %m3, %b3
      %s4 = lshr i64 %2, 32
      %v4 = and i64 %s4, 255
      %b4 = zext i64 %v4 to i128
      %m4 = mul i128 %r3, 309485009821345068724781371
      %r4 = xor i128 %m4, %b4
      %s5 = lshr i64 %2, 40
      %v5 = and i64 %s5, 255
      %b5 = zext i64 %v5 to i128
      %m5 = mul i128 %r4, 309485009821345068724781371
      %r5 = xor i128 %m5, %b5
      %s6 = lshr i64 %2, 48
      %v6 = and i64 %s6, 255
      %b6 = zext i64 %v6 to i128
      %m6 = mul i128 %r5, 309485009821345068724781371
      %r6 = xor i128 %m6, %b6
      %s7 = lshr i64 %2, 56
      %v7 = and i64 %s7, 255
      %b7 = zext i64 %v7 to i128
      %m7 = mul i128 %r6, 309485009821345068724781371
      %r7 = xor i128 %m7, %b7
      %result = trunc i128 %r7 to i64
      ret i64 %result
    }

  -- | Compute the high word of eight ordered FNV-1 steps.
  -- Fixed-width arguments keep the fragment portable across primitive ABI targets.
  prim fnv128-high :: U64 -> U64 -> U64 -> U64 where
    llvm {
      %upper = zext i64 %0 to i128
      %shifted = shl i128 %upper, 64
      %lower = zext i64 %1 to i128
      %state = or i128 %shifted, %lower
      %s0 = lshr i64 %2, 0
      %v0 = and i64 %s0, 255
      %b0 = zext i64 %v0 to i128
      %m0 = mul i128 %state, 309485009821345068724781371
      %r0 = xor i128 %m0, %b0
      %s1 = lshr i64 %2, 8
      %v1 = and i64 %s1, 255
      %b1 = zext i64 %v1 to i128
      %m1 = mul i128 %r0, 309485009821345068724781371
      %r1 = xor i128 %m1, %b1
      %s2 = lshr i64 %2, 16
      %v2 = and i64 %s2, 255
      %b2 = zext i64 %v2 to i128
      %m2 = mul i128 %r1, 309485009821345068724781371
      %r2 = xor i128 %m2, %b2
      %s3 = lshr i64 %2, 24
      %v3 = and i64 %s3, 255
      %b3 = zext i64 %v3 to i128
      %m3 = mul i128 %r2, 309485009821345068724781371
      %r3 = xor i128 %m3, %b3
      %s4 = lshr i64 %2, 32
      %v4 = and i64 %s4, 255
      %b4 = zext i64 %v4 to i128
      %m4 = mul i128 %r3, 309485009821345068724781371
      %r4 = xor i128 %m4, %b4
      %s5 = lshr i64 %2, 40
      %v5 = and i64 %s5, 255
      %b5 = zext i64 %v5 to i128
      %m5 = mul i128 %r4, 309485009821345068724781371
      %r5 = xor i128 %m5, %b5
      %s6 = lshr i64 %2, 48
      %v6 = and i64 %s6, 255
      %b6 = zext i64 %v6 to i128
      %m6 = mul i128 %r5, 309485009821345068724781371
      %r6 = xor i128 %m6, %b6
      %s7 = lshr i64 %2, 56
      %v7 = and i64 %s7, 255
      %b7 = zext i64 %v7 to i128
      %m7 = mul i128 %r6, 309485009821345068724781371
      %r7 = xor i128 %m7, %b7
      %high = lshr i128 %r7, 64
      %result = trunc i128 %high to i64
      ret i64 %result
    }

  -- | Compute the low word of eight ordered FNV-1a steps.
  -- Fixed-width arguments keep the fragment portable across primitive ABI targets.
  prim fnv128a-low :: U64 -> U64 -> U64 -> U64 where
    llvm {
      %upper = zext i64 %0 to i128
      %shifted = shl i128 %upper, 64
      %lower = zext i64 %1 to i128
      %state = or i128 %shifted, %lower
      %s0 = lshr i64 %2, 0
      %v0 = and i64 %s0, 255
      %b0 = zext i64 %v0 to i128
      %x0 = xor i128 %state, %b0
      %r0 = mul i128 %x0, 309485009821345068724781371
      %s1 = lshr i64 %2, 8
      %v1 = and i64 %s1, 255
      %b1 = zext i64 %v1 to i128
      %x1 = xor i128 %r0, %b1
      %r1 = mul i128 %x1, 309485009821345068724781371
      %s2 = lshr i64 %2, 16
      %v2 = and i64 %s2, 255
      %b2 = zext i64 %v2 to i128
      %x2 = xor i128 %r1, %b2
      %r2 = mul i128 %x2, 309485009821345068724781371
      %s3 = lshr i64 %2, 24
      %v3 = and i64 %s3, 255
      %b3 = zext i64 %v3 to i128
      %x3 = xor i128 %r2, %b3
      %r3 = mul i128 %x3, 309485009821345068724781371
      %s4 = lshr i64 %2, 32
      %v4 = and i64 %s4, 255
      %b4 = zext i64 %v4 to i128
      %x4 = xor i128 %r3, %b4
      %r4 = mul i128 %x4, 309485009821345068724781371
      %s5 = lshr i64 %2, 40
      %v5 = and i64 %s5, 255
      %b5 = zext i64 %v5 to i128
      %x5 = xor i128 %r4, %b5
      %r5 = mul i128 %x5, 309485009821345068724781371
      %s6 = lshr i64 %2, 48
      %v6 = and i64 %s6, 255
      %b6 = zext i64 %v6 to i128
      %x6 = xor i128 %r5, %b6
      %r6 = mul i128 %x6, 309485009821345068724781371
      %s7 = lshr i64 %2, 56
      %v7 = and i64 %s7, 255
      %b7 = zext i64 %v7 to i128
      %x7 = xor i128 %r6, %b7
      %r7 = mul i128 %x7, 309485009821345068724781371
      %result = trunc i128 %r7 to i64
      ret i64 %result
    }

  -- | Compute the high word of eight ordered FNV-1a steps.
  -- Fixed-width arguments keep the fragment portable across primitive ABI targets.
  prim fnv128a-high :: U64 -> U64 -> U64 -> U64 where
    llvm {
      %upper = zext i64 %0 to i128
      %shifted = shl i128 %upper, 64
      %lower = zext i64 %1 to i128
      %state = or i128 %shifted, %lower
      %s0 = lshr i64 %2, 0
      %v0 = and i64 %s0, 255
      %b0 = zext i64 %v0 to i128
      %x0 = xor i128 %state, %b0
      %r0 = mul i128 %x0, 309485009821345068724781371
      %s1 = lshr i64 %2, 8
      %v1 = and i64 %s1, 255
      %b1 = zext i64 %v1 to i128
      %x1 = xor i128 %r0, %b1
      %r1 = mul i128 %x1, 309485009821345068724781371
      %s2 = lshr i64 %2, 16
      %v2 = and i64 %s2, 255
      %b2 = zext i64 %v2 to i128
      %x2 = xor i128 %r1, %b2
