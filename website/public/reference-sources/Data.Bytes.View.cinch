-- | Bounded mutable aliases retaining an entire fixed byte-buffer owner.
-- Views share observable mutations with their owner and overlapping views.
-- A small view retains the complete owner allocation until the view is released.
-- Snapshots and clones copy into fresh storage. Private backing and addresses
-- are never exposed; all reads, writes and range copies carry checked bounds.
module Data.Bytes.View where
  import Data.Bytes
  import Data.Bytes.Utf8 as Utf8
  import Data.Bool
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.Wide

  export ByteView, ByteViewError, ByteViewReversedRange, ByteViewPastEnd, ByteViewShortDestination
  export bytes-view, bytes-view-range, byte-view-slice, byte-view-length, byte-view-is-empty
  export byte-view-get, byte-view-set, byte-view-snapshot, byte-view-clone, byte-view-copy-into
  export byte-view-take, byte-view-drop
  export byte-view-utf8-at
  export byte-view-index-byte
  export byte-view-ascii-space-run-end
  export BytePattern, bytes-compile-pattern, byte-pattern-length, byte-pattern-bytes
  export byte-view-index-pattern, byte-view-last-index-pattern, byte-view-contains-pattern
  export byte-view-has-prefix-pattern, byte-view-has-suffix-pattern
  export byte-view-count-pattern, byte-view-equal, byte-view-compare
  export byte-view-index, byte-view-last-index, byte-view-contains, byte-view-count, byte-view-has-prefix, byte-view-has-suffix
  export byte-view-cut, byte-view-cut-last, byte-view-cut-prefix, byte-view-cut-suffix
  export bytes-index, bytes-last-index, bytes-contains, bytes-count, bytes-has-prefix, bytes-has-suffix
  export bytes-cut, bytes-cut-last, bytes-cut-prefix, bytes-cut-suffix
  export byte-view-cut-pattern, byte-view-cut-last-pattern, byte-view-cut-prefix-pattern, byte-view-cut-suffix-pattern

  -- | An opaque fixed range whose endpoint refinements preserve the owner's bounds.
  data ByteView where
    -- | Retain the complete fixed owner and an ordered pair of bounded endpoints.
    View :: (raw :: Bytes) -> (start :: Nat) -> refined (start <= end && end <= bytes-len raw) Nat -> ByteView

  -- | A refused view range or complete-copy destination; refusals never mutate storage.
  data ByteViewError where
    -- | The requested starting coordinate exceeds the requested ending coordinate.
    ByteViewReversedRange :: Nat -> Nat -> ByteViewError
    -- | The requested coordinate exceeds the available logical range length.
    ByteViewPastEnd :: Nat -> Nat -> ByteViewError
    -- | A destination offset, required byte count and available buffer length do not fit.
    ByteViewShortDestination :: Nat -> Nat -> Nat -> ByteViewError

  -- | Retain the whole fixed mutable buffer without copying its contents.
  bytes-view :: Bytes -> ByteView
  bytes-view raw = View raw 0 (bytes-len raw)

  -- | Retain an explicitly checked half-open owner range, including empty ranges at the end.
  bytes-view-range :: Bytes -> Nat -> Nat -> Result ByteViewError ByteView
  bytes-view-range raw start end = if start > end then Err (ByteViewReversedRange start end)
    else if end > bytes-len raw then Err (ByteViewPastEnd end (bytes-len raw))
    else Ok (View raw start end)

  -- | Count logical bytes in a view without copying or releasing its retained owner.
  byte-view-length :: ByteView -> Nat
  byte-view-length view = case view of View raw start end -> end - start

  -- | Test whether a retained range has no logical bytes.
  byte-view-is-empty :: ByteView -> Bool
  byte-view-is-empty view = byte-view-length view == 0

  -- | Retain a checked half-open subrange relative to this view, preserving shared mutations.
  byte-view-slice :: ByteView -> Nat -> Nat -> Result ByteViewError ByteView
  byte-view-slice view begin finish = case view of
    View raw start end ->
      let size = end - start in
      if begin > finish then Err (ByteViewReversedRange begin finish)
      else if finish > size then Err (ByteViewPastEnd finish size)
      else let first = start + begin in let last = start + finish in Ok (View raw first last)

  -- | Read an exact relative byte, or no value when the coordinate is outside the view.
  byte-view-get :: ByteView -> Nat -> Option U8
  byte-view-get view at = case view of
    View raw start end -> if at < end - start then
      let absolute = start + at in Some (bytes-get-u8 raw absolute)
      else None

  -- | Write one exact relative byte and report whether it fit; refusal leaves all aliases unchanged.
  byte-view-set :: ByteView -> Nat -> U8 -> Bool
  byte-view-set view at value = case view of
    View raw start end -> if at < end - start then
      let absolute = start + at in let written = bytes-set-u8 raw absolute value in True
      else False

  -- | Copy exactly the logical range into fresh mutable storage without retaining the source owner.
  byte-view-snapshot :: ByteView -> Bytes
  byte-view-snapshot view = case view of
    View raw start end -> let size = end - start in let out = bytes-new size in
      let copied = bytes-copy-range out raw 0 start size in out

  -- | Clone a view into a new independent whole-buffer view, including empty ranges.
  byte-view-clone :: ByteView -> ByteView
  byte-view-clone view = bytes-view (byte-view-snapshot view)

  -- | Copy a complete view into a checked destination interval with overlap-safe range copying.
  -- Destination refusal is atomic; the required and available sizes are preserved in the error.
  byte-view-copy-into :: Bytes -> Nat -> ByteView -> Result ByteViewError Nat
  byte-view-copy-into destination at view = case view of
    View raw start end -> let size = end - start in
      if at > bytes-len destination then Err (ByteViewShortDestination at size (bytes-len destination))
      else if size > bytes-len destination - at then Err (ByteViewShortDestination at size (bytes-len destination))
      else let copied = bytes-copy-range destination raw at start size in Ok size

  -- | Retain up to the requested leading bytes, clamping the count to this view's length.
  byte-view-take :: Nat -> ByteView -> ByteView
  byte-view-take count view = case view of
    View raw start end -> if count < end - start then
      let finish = start + count in View raw start finish
      else view

  -- | Drop up to the requested leading bytes, clamping at an empty view of the original end.
  byte-view-drop :: Nat -> ByteView -> ByteView
  byte-view-drop count view = case view of
    View raw start end ->
      let begin = ((if count < end - start then start + count else end) :: Nat) in
      case bytes-view-range raw begin end of
        Ok result -> result
        Err error -> view

  -- | Observe one bounded scalar at a relative byte position without copying or exposing backing storage.
  -- The logical end returns Utf8End; positions past it return Utf8OutOfBounds.
  -- Each malformed or view-truncated byte returns U+FFFD with width one and Utf8Invalid.
  byte-view-utf8-at :: ByteView -> Nat -> Utf8.Utf8Step
  byte-view-utf8-at view at = case view of
    View raw start end -> if at <= end - start then
      let absolute = start + at in Utf8.utf8-decode-between raw start end absolute
      else let past = end + 1 in Utf8.utf8-decode-between raw start end past

  -- | A stable private needle snapshot and its complete proper-prefix failure table.
  data BytePattern where
    -- | Own both immutable-by-interface buffers; neither has an outward mutable alias.
    Pattern :: Bytes -> Bytes -> BytePattern

  -- | Read an already initialized private failure entry through checked word access.
  prefix-entry :: Bytes -> Nat -> Nat
  prefix-entry table index = let at = index * 8 in
    if at + 8 <= bytes-len table then
      let word = bytes-load-le64 table at in let value = wrapping-u64-to-i64 word in
      if 0 <= value then nat-from-i64 value else 0
    else 0

  -- | Store one bounded failure entry with checked little-endian word stores.
  prefix-store :: Bytes -> Nat -> Nat -> Unit
  prefix-store table index value = let at = index * 8 in
    if at + 8 <= bytes-len table && value <= 9223372036854775807 then
      bytes-store-le64 table at (wrapping-i64-to-u64 (nat-to-i64 value))
    else ()

  -- | Follow already computed proper prefixes until the next needle byte can extend them.
  prefix-fallback :: Bytes -> Bytes -> Nat -> InRange 0 255 Nat -> Nat
  prefix-fallback needle table matched byte =
    if matched > 0 && matched < bytes-len needle then
      if bytes-get needle matched == byte then matched else
        let previous = matched - 1 in let next = prefix-entry table previous in
        if next < matched then prefix-fallback needle table next byte else 0
    else 0

  -- | Build the proper-prefix table in linear time without recursive return frames.
  prefix-fill :: Bytes -> Bytes -> Nat -> Nat -> Unit
  prefix-fill needle table at matched = if at < bytes-len needle then
    let byte = bytes-get needle at in let fallback = prefix-fallback needle table matched byte in
    let extended = ((if fallback < bytes-len needle then
      if bytes-get needle fallback == byte then fallback + 1 else 0
      else 0) :: Nat) in
    let written = prefix-store table at extended in
    let next = at + 1 in prefix-fill needle table next extended
    else ()

  -- | Compile an independent needle snapshot and a reusable linear-search failure table.
  -- Caller mutation after compilation never changes this pattern or its later search results.
  bytes-compile-pattern :: Bytes -> BytePattern
  bytes-compile-pattern input = let size = bytes-len input in let needle = bytes-new size in
    let copied = bytes-copy-range needle input 0 0 size in
    let table = bytes-new (size * 8) in let filled = prefix-fill needle table 1 0 in
    Pattern needle table

  -- | Count exact needle bytes without exposing private snapshot storage.
  byte-pattern-length :: BytePattern -> Nat
  byte-pattern-length pattern = case pattern of Pattern needle table -> bytes-len needle

  -- | Copy the compiled needle into fresh caller-owned storage.
  byte-pattern-bytes :: BytePattern -> Bytes
  byte-pattern-bytes pattern = case pattern of
    Pattern needle table -> let size = bytes-len needle in let out = bytes-new size in
      let copied = bytes-copy-range out needle 0 0 size in out

  -- | Find a matching first byte before entering complete sixteen-byte SIMD scans.
  index-forward :: Bytes -> I64 -> I64 -> U8 -> I64
  index-forward bs at end byte =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      if eq-u8 (bytes-get-u8-at bs at) byte then at
      else index-forward-blocks bs (wrapping-add-i64 at 1) end byte
    else -1

  -- | Find the first matching sixteen-byte SIMD block or fall through to the exact scalar fringe.
  index-forward-blocks :: Bytes -> I64 -> I64 -> U8 -> I64
  index-forward-blocks bs at end byte =
    if 16 <= end && end <= bytes-len-i64 bs then
      let ne = nat-from-i64 end in
      if 16 <= ne then
        let lim = ne - 16 in
        if 0 <= at then
          let ni = nat-from-i64 at in
          if ni <= lim then
            let chunk = bytes-load-u128 bs ni in
            let mask = simd-u8x16-movemask (simd-u8x16-cmpeq chunk (simd-u8x16-splat byte)) in
            if ne-u32 mask 0 then
              wrapping-add-i64 at (u32-to-i64 (trailing-zeros-u32 mask))
            else
              index-forward-blocks bs (wrapping-add-i64 at 16) end byte
          else index-forward-tail bs at end byte
        else -1
      else -1
    else index-forward-tail bs at end byte

  -- | Read only remaining scalar bytes after complete sixteen-byte forward blocks.
  index-forward-tail :: Bytes -> I64 -> I64 -> U8 -> I64
  index-forward-tail bs at end byte =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      if eq-u8 (bytes-get-u8-at bs at) byte then at
      else index-forward-tail bs (wrapping-add-i64 at 1) end byte
    else -1

  -- | Search complete sixteen-byte suffix blocks without reading before the view's starting bound.
  last-byte-range :: Bytes -> I64 -> I64 -> U8 -> I64
  last-byte-range bs begin end byte =
    if 0 <= begin && 16 <= end && end <= bytes-len-i64 bs && le-i64 begin (wrapping-sub-i64 end 16) then
      let ne = nat-from-i64 end in
      if 16 <= ne then
        let start-nat = ne - 16 in
        let start = wrapping-sub-i64 end 16 in
        let chunk = bytes-load-u128 bs start-nat in
        let mask = simd-u8x16-movemask (simd-u8x16-cmpeq chunk (simd-u8x16-splat byte)) in
        if ne-u32 mask 0 then
          let lane = wrapping-sub-i64 31 (u32-to-i64 (leading-zeros-u32 mask)) in
          wrapping-add-i64 start lane
        else
          last-byte-range bs begin start byte
      else -1
    else last-byte-tail bs begin end byte

  -- | Search only the exact leading bytes remaining inside a bounded suffix scan.
  last-byte-tail :: Bytes -> I64 -> I64 -> U8 -> I64
  last-byte-tail bs begin end byte =
    if 0 <= begin && begin < end && end <= bytes-len-i64 bs then
      let previous = wrapping-sub-i64 end 1 in
      if 0 <= previous && previous < bytes-len-i64 bs then
        if eq-u8 (bytes-get-u8-at bs previous) byte then previous
        else last-byte-tail bs begin previous byte
      else -1
    else -1

  -- | Count matching lanes across complete sixteen-byte SIMD blocks with an unboxed accumulator.
  count-forward :: Bytes -> I64 -> I64 -> U8 -> I64 -> I64
  count-forward bs at end byte total =
    if 16 <= end && end <= bytes-len-i64 bs then
      let ne = nat-from-i64 end in
      if 16 <= ne then
        let lim = ne - 16 in
        if 0 <= at then
          let ni = nat-from-i64 at in
          if ni <= lim then
            let chunk = bytes-load-u128 bs ni in
            let mask = simd-u8x16-movemask (simd-u8x16-cmpeq chunk (simd-u8x16-splat byte)) in
            let hits = u32-to-i64 (count-ones-u32 mask) in
            count-forward bs (wrapping-add-i64 at 16) end byte (wrapping-add-i64 total hits)
          else count-tail bs at end byte total
        else total
      else total
    else count-tail bs at end byte total

  -- | Count only available scalar-fringe bytes without reading past the view end.
  count-tail :: Bytes -> I64 -> I64 -> U8 -> I64 -> I64
  count-tail bs at end byte total =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      let next-total = if eq-u8 (bytes-get-u8-at bs at) byte then wrapping-add-i64 total 1 else total in
      count-tail bs (wrapping-add-i64 at 1) end byte next-total
    else total

  -- | Load one initialized failure entry; its value is strictly below the matched prefix length.
  failure-word :: Bytes -> I64 -> I64
  failure-word table index =
    let off = wrapping-shl-i64 index 3 in
    let n = bytes-len-i64 table in
    if 8 <= n && 0 <= off then
      let nn = nat-from-i64 n in
      if 8 <= nn then
        let lim = nn - 8 in
        let no = nat-from-i64 off in
        if no <= lim then wrapping-u64-to-i64 (bytes-load-le64 table no) else 0
      else 0
    else 0

  -- | Compare sixteen checked bytes from two buffers using portable SIMD equality.
  same-sixteen :: Bytes -> I64 -> Bytes -> I64 -> Bool
  same-sixteen left a right b =
    let nl = bytes-len-i64 left in
    let nr = bytes-len-i64 right in
    if 16 <= nl && 16 <= nr && 0 <= a && 0 <= b then
      let nnl = nat-from-i64 nl in
      let nnr = nat-from-i64 nr in
      if 16 <= nnl && 16 <= nnr then
        let na = nat-from-i64 a in
        let nb = nat-from-i64 b in
        if na <= nnl - 16 && nb <= nnr - 16 then
          let x = bytes-load-u128 left na in
          let y = bytes-load-u128 right nb in
          eq-u32 (simd-u8x16-movemask (simd-u8x16-cmpeq x y)) 65535
        else False
      else False
    else False

  -- | Compare eight checked bytes from two buffers in little-endian word order.
  same-eight :: Bytes -> I64 -> Bytes -> I64 -> Bool
  same-eight left a right b =
    let nl = bytes-len-i64 left in
    let nr = bytes-len-i64 right in
    if 8 <= nl && 8 <= nr && 0 <= a && 0 <= b then
      let nnl = nat-from-i64 nl in
      let nnr = nat-from-i64 nr in
      if 8 <= nnl && 8 <= nnr then
        let na = nat-from-i64 a in
        let nb = nat-from-i64 b in
        if na <= nnl - 8 && nb <= nnr - 8 then
          eq-u64 (bytes-load-le64 left na) (bytes-load-le64 right nb)
        else False
      else False
    else False

  -- | Find a first-byte candidate through the fast SIMD scanner before displaced endpoint blocks.
  endpoint-first :: Bytes -> I64 -> I64 -> I64 -> U8 -> U8 -> I64
  endpoint-first bs at limit delta first-byte last-byte =
    let found = index-forward bs at limit first-byte in
    if lt-i64 found 0 then -1 else
      let final = wrapping-add-i64 found delta in
      if 0 <= final && final < bytes-len-i64 bs then
        if eq-u8 (bytes-get-u8-at bs final) last-byte then found
        else endpoint-blocks bs (wrapping-add-i64 found 1) limit delta first-byte last-byte
      else -1

  -- | Skip sixteen possible starts using exact first/final-byte SIMD lane intersections.
  -- The exclusive start limit includes the final-byte displacement, bounding both complete loads.
  endpoint-blocks :: Bytes -> I64 -> I64 -> I64 -> U8 -> U8 -> I64
  endpoint-blocks bs at limit delta first-byte last-byte =
    let n = bytes-len-i64 bs in
    if 16 <= limit && 16 <= n && limit <= n then
      let nlim = nat-from-i64 limit in
      let nn = nat-from-i64 n in
      if 16 <= nlim && 16 <= nn then
        if 0 <= at then
          let na = nat-from-i64 at in
          if na <= nlim - 16 then
            let a = bytes-load-u128 bs na in
            let starts = simd-u8x16-movemask (simd-u8x16-cmpeq a (simd-u8x16-splat first-byte)) in
            if ne-u32 starts 0 then
              let final = wrapping-add-i64 at delta in
              if 0 <= final then
                let nf = nat-from-i64 final in
                if nf <= nn - 16 then
                  let b = bytes-load-u128 bs nf in
                  let ends = simd-u8x16-movemask (simd-u8x16-cmpeq b (simd-u8x16-splat last-byte)) in
                  let matches = bit-and-u32 starts ends in
                  if ne-u32 matches 0 then
                    wrapping-add-i64 at (u32-to-i64 (trailing-zeros-u32 matches))
                  else
                    endpoint-blocks bs (wrapping-add-i64 at 16) limit delta first-byte last-byte
                else endpoint-tail bs at limit delta first-byte last-byte
              else -1
            else endpoint-first bs (wrapping-add-i64 at 16) limit delta first-byte last-byte
          else endpoint-tail bs at limit delta first-byte last-byte
        else -1
      else endpoint-tail bs at limit delta first-byte last-byte
    else endpoint-tail bs at limit delta first-byte last-byte

  -- | Read only exact remaining candidate endpoints after complete SIMD blocks.
  endpoint-tail :: Bytes -> I64 -> I64 -> I64 -> U8 -> U8 -> I64
  endpoint-tail bs at limit delta first-byte last-byte =
    if 0 <= at && at < limit && limit <= bytes-len-i64 bs then
      let final = wrapping-add-i64 at delta in
      if 0 <= final && final < bytes-len-i64 bs then
        if eq-u8 (bytes-get-u8-at bs at) first-byte && eq-u8 (bytes-get-u8-at bs final) last-byte then at
        else endpoint-tail bs (wrapping-add-i64 at 1) limit delta first-byte last-byte
      else -1
    else -1

  -- | Filter only the initial start region, then retain the complete linear failure traversal.
  -- Endpoint misses cannot begin a full match; fallback never restarts verification at every candidate.
  search-first-candidates :: Bytes -> I64 -> I64 -> Bytes -> Bytes -> I64
  search-first-candidates bs begin end needle table =
    let size = bytes-len-i64 needle in
    if 0 < size then
      let first-byte = bytes-get-u8-at needle 0 in
      if le-i64 size 1 then index-forward bs begin end first-byte else
        let delta = wrapping-sub-i64 size 1 in
        if 0 <= delta && delta < size then
          let last-byte = bytes-get-u8-at needle delta in
          let limit = wrapping-sub-i64 end delta in
          let candidate = endpoint-first bs begin limit delta first-byte last-byte in
          if lt-i64 candidate 0 then -1 else
            search-first bs (wrapping-add-i64 candidate 1) end needle table 1
        else -1
    else -1

  -- | Extend a matched prefix or follow strictly smaller failure links for one current byte.
  search-step :: Bytes -> Bytes -> I64 -> U8 -> I64
  search-step needle table matched byte =
    if 0 <= matched && matched < bytes-len-i64 needle then
      let expected = bytes-get-u8-at needle matched in
      if eq-u8 expected byte then wrapping-add-i64 matched 1
      else if gt-i64 matched 0 then
        let next = failure-word table (wrapping-sub-i64 matched 1) in
        search-step needle table next byte
      else 0
    else 0

  -- | Find the first complete match with SIMD skipping and wide prefix comparisons.
  search-first :: Bytes -> I64 -> I64 -> Bytes -> Bytes -> I64 -> I64
  search-first bs at end needle table matched =
    let size = bytes-len-i64 needle in
    if eq-i64 matched 0 then
      if 0 < size then
        let found = index-forward bs at end (bytes-get-u8-at needle 0) in
        if lt-i64 found 0 then -1 else if le-i64 size 1 then found else
          search-first bs (wrapping-add-i64 found 1) end needle table 1
      else -1
    else if lt-i64 at end then
      if ge-i64 (wrapping-sub-i64 size matched) 16 && ge-i64 (wrapping-sub-i64 end at) 16 && same-sixteen bs at needle matched then
        let next = wrapping-add-i64 at 16 in let advanced = wrapping-add-i64 matched 16 in
        if ge-i64 advanced size then wrapping-sub-i64 next size
        else search-first bs next end needle table advanced
      else if ge-i64 (wrapping-sub-i64 size matched) 8 && ge-i64 (wrapping-sub-i64 end at) 8 && same-eight bs at needle matched then
        let next = wrapping-add-i64 at 8 in let advanced = wrapping-add-i64 matched 8 in
        if ge-i64 advanced size then wrapping-sub-i64 next size
        else search-first bs next end needle table advanced
      else if 0 <= at && at < bytes-len-i64 bs then
        let byte = bytes-get-u8-at bs at in
        let advanced = search-step needle table matched byte in
        let next = wrapping-add-i64 at 1 in
        if ge-i64 advanced size then wrapping-sub-i64 next size
        else search-first bs next end needle table advanced
      else -1
    else -1

  -- | Find the final complete match with wide prefix comparisons, retaining overlaps.
  search-last :: Bytes -> I64 -> I64 -> Bytes -> Bytes -> I64 -> I64 -> I64
  search-last bs at end needle table matched best =
    let size = bytes-len-i64 needle in
    if eq-i64 matched 0 then
      if 0 < size then
        let found = index-forward bs at end (bytes-get-u8-at needle 0) in
        if lt-i64 found 0 then best else
          search-last bs (wrapping-add-i64 found 1) end needle table 1 best
      else best
    else if lt-i64 at end then
      if ge-i64 (wrapping-sub-i64 size matched) 16 && ge-i64 (wrapping-sub-i64 end at) 16 && same-sixteen bs at needle matched then
        let next = wrapping-add-i64 at 16 in let advanced = wrapping-add-i64 matched 16 in
        if ge-i64 advanced size then
          let found = wrapping-sub-i64 next size in
          let fallback = failure-word table (wrapping-sub-i64 size 1) in
          search-last bs next end needle table fallback found
        else search-last bs next end needle table advanced best
      else if ge-i64 (wrapping-sub-i64 size matched) 8 && ge-i64 (wrapping-sub-i64 end at) 8 && same-eight bs at needle matched then
        let next = wrapping-add-i64 at 8 in let advanced = wrapping-add-i64 matched 8 in
        if ge-i64 advanced size then
          let found = wrapping-sub-i64 next size in
          let fallback = failure-word table (wrapping-sub-i64 size 1) in
          search-last bs next end needle table fallback found
        else search-last bs next end needle table advanced best
      else if 0 <= at && at < bytes-len-i64 bs then
        let byte = bytes-get-u8-at bs at in
        let advanced = search-step needle table matched byte in
        let next = wrapping-add-i64 at 1 in
        if ge-i64 advanced size then
          let found = wrapping-sub-i64 next size in
          let fallback = failure-word table (wrapping-sub-i64 size 1) in
          search-last bs next end needle table fallback found
        else search-last bs next end needle table advanced best
      else best
    else best

  -- | Compare sixteen-byte SIMD blocks across two fixed buffer intervals before falling to the tail.
  search-equal :: Bytes -> I64 -> Bytes -> I64 -> I64 -> Bool
  search-equal left at right pos end =
    let nl = bytes-len-i64 left in
    if 16 <= end && end <= bytes-len-i64 right && 16 <= nl then
      let ne = nat-from-i64 end in
      let nnl = nat-from-i64 nl in
      if 16 <= ne && 16 <= nnl then
        if 0 <= pos && 0 <= at then
          let np = nat-from-i64 pos in
          let na = nat-from-i64 at in
          if np <= ne - 16 && na <= nnl - 16 then
            let x = bytes-load-u128 left na in
            let y = bytes-load-u128 right np in
            if eq-u32 (simd-u8x16-movemask (simd-u8x16-cmpeq x y)) 65535 then
              search-equal left (wrapping-add-i64 at 16) right (wrapping-add-i64 pos 16) end
            else False
          else search-equal-eight left at right pos end
        else False
      else search-equal-tail left at right pos end
    else search-equal-eight left at right pos end

  -- | Compare one optional eight-byte word before examining the final scalar bytes.
  search-equal-eight :: Bytes -> I64 -> Bytes -> I64 -> I64 -> Bool
  search-equal-eight left at right pos end =
    let nl = bytes-len-i64 left in
    if 8 <= end && end <= bytes-len-i64 right && 8 <= nl && 0 <= pos && 0 <= at then
      let ne = nat-from-i64 end in
      let nnl = nat-from-i64 nl in
      if 8 <= ne && 8 <= nnl then
        let np = nat-from-i64 pos in
        let na = nat-from-i64 at in
        if np <= ne - 8 && na <= nnl - 8 then
          if eq-u64 (bytes-load-le64 left na) (bytes-load-le64 right np) then
            search-equal-tail left (wrapping-add-i64 at 8) right (wrapping-add-i64 pos 8) end
          else False
        else search-equal-tail left at right pos end
      else search-equal-tail left at right pos end
    else search-equal-tail left at right pos end

  -- | Compare exact remaining scalar bytes across two bounded buffer intervals.
  search-equal-tail :: Bytes -> I64 -> Bytes -> I64 -> I64 -> Bool
  search-equal-tail left at right pos end =
    if 0 <= pos && pos < end && end <= bytes-len-i64 right then
      if 0 <= at && at < bytes-len-i64 left then
        if eq-u8 (bytes-get-u8-at left at) (bytes-get-u8-at right pos) then
          search-equal-tail left (wrapping-add-i64 at 1) right (wrapping-add-i64 pos 1) end
        else False
      else False
    else True

  -- | Convert a private absolute match sentinel into an exact relative view offset.
  relative-match :: I64 -> I64 -> Option Nat
  relative-match absolute start = if absolute >= start then
    let offset = wrapping-sub-i64 absolute start in if 0 <= offset then Some (nat-from-i64 offset) else None
    else None

  -- | Find the first exact byte relative to the checked view, or None when it is absent.
  -- Every byte value is compared directly, including malformed UTF-8 bytes; current aliases remain observable.
  byte-view-index-byte :: ByteView -> U8 -> Option Nat
  byte-view-index-byte view value = case view of
    View raw start end -> if start == end then None else
      let begin = nat-to-i64 start in let finish = nat-to-i64 end in
      let found = index-forward raw begin finish value in
      relative-match found begin

  -- | Find the first compiled needle match relative to the view; an empty needle matches zero.
  byte-view-index-pattern :: ByteView -> BytePattern -> Option Nat
  byte-view-index-pattern view pattern = case view of
    View raw start end -> case pattern of
      Pattern needle table -> let size = bytes-len needle in
        if size == 0 then Some 0 else if size > end - start then None else
          let begin = nat-to-i64 start in let finish = nat-to-i64 end in
          let found = search-first-candidates raw begin finish needle table in
          relative-match found begin

  -- | Find the final compiled match, including overlaps; an empty needle matches the view end.
  byte-view-last-index-pattern :: ByteView -> BytePattern -> Option Nat
  byte-view-last-index-pattern view pattern = case view of
    View raw start end -> case pattern of
      Pattern needle table -> let size = bytes-len needle in
        if size == 0 then Some (end - start) else if size > end - start then None
        else if byte-view-has-suffix-pattern view pattern then let at = end - start - size in Some at
        else
          let begin = nat-to-i64 start in let finish = nat-to-i64 end in
          let found = (if size == 1 then
            last-byte-range raw begin finish (bytes-get-u8 needle 0)
          else
            search-last raw begin finish needle table 0 (-1)) in
          relative-match found begin

  -- | Test whether a compiled needle occurs, including the empty needle in an empty view.
  byte-view-contains-pattern :: ByteView -> BytePattern -> Bool
  byte-view-contains-pattern view pattern = case byte-view-index-pattern view pattern of None -> False; Some at -> True

  -- | Test an exact compiled prefix using SIMD block comparisons and checked view lengths.
  byte-view-has-prefix-pattern :: ByteView -> BytePattern -> Bool
  byte-view-has-prefix-pattern view pattern = case view of
    View raw start end -> case pattern of
      Pattern needle table -> if bytes-len needle <= end - start then
        search-equal raw (nat-to-i64 start) needle 0 (nat-to-i64 (bytes-len needle))
        else False

  -- | Test an exact compiled suffix without copying or scanning the unrelated prefix.
  byte-view-has-suffix-pattern :: ByteView -> BytePattern -> Bool
  byte-view-has-suffix-pattern view pattern = case view of
    View raw start end -> case pattern of
      Pattern needle table -> if bytes-len needle <= end - start then
        let begin = end - bytes-len needle in
        search-equal raw (nat-to-i64 begin) needle 0 (nat-to-i64 (bytes-len needle))
        else False

  -- | Split around an already found bounded match into two owner-retaining mutable aliases.
  cut-at :: ByteView -> Nat -> Nat -> Option (ByteView, ByteView)
  cut-at view at width = case view of
    View raw start end -> if at + width <= end - start then
      let middle = start + at in let following = middle + width in
      Some (View raw start middle, View raw following end)
      else None

  -- | Cut around the first compiled match; empty needles produce empty-before and the complete view.
  byte-view-cut-pattern :: ByteView -> BytePattern -> Option (ByteView, ByteView)
  byte-view-cut-pattern view pattern = case byte-view-index-pattern view pattern of
    None -> None
    Some at -> cut-at view at (byte-pattern-length pattern)

  -- | Cut around the final compiled match, preserving overlapping last-match semantics.
  byte-view-cut-last-pattern :: ByteView -> BytePattern -> Option (ByteView, ByteView)
  byte-view-cut-last-pattern view pattern = case byte-view-last-index-pattern view pattern of
    None -> None
    Some at -> cut-at view at (byte-pattern-length pattern)

  -- | Remove an exact compiled prefix as an owner-retaining alias, or report no match.
  byte-view-cut-prefix-pattern :: ByteView -> BytePattern -> Option ByteView
  byte-view-cut-prefix-pattern view pattern = if byte-view-has-prefix-pattern view pattern then
    Some (byte-view-drop (byte-pattern-length pattern) view) else None

  -- | Remove an exact compiled suffix as an owner-retaining alias, or report no match.
  byte-view-cut-suffix-pattern :: ByteView -> BytePattern -> Option ByteView
  byte-view-cut-suffix-pattern view pattern = let size = byte-view-length view in let width = byte-pattern-length pattern in
    if width <= size && byte-view-has-suffix-pattern view pattern then
      let kept = size - width in Some (byte-view-take kept view)
    else None

  -- | Count nonoverlapping complete matches with SIMD skipping and wide prefix comparisons.
  search-count :: Bytes -> I64 -> I64 -> Bytes -> Bytes -> I64 -> I64 -> I64
  search-count bs at end needle table matched count =
    let size = bytes-len-i64 needle in
    if eq-i64 matched 0 then
      if 0 < size then
        let found = index-forward bs at end (bytes-get-u8-at needle 0) in
        if lt-i64 found 0 then count else
          search-count bs (wrapping-add-i64 found 1) end needle table 1 count
      else count
    else if lt-i64 at end then
      if ge-i64 (wrapping-sub-i64 size matched) 16 && ge-i64 (wrapping-sub-i64 end at) 16 && same-sixteen bs at needle matched then
        let next = wrapping-add-i64 at 16 in let advanced = wrapping-add-i64 matched 16 in
        if ge-i64 advanced size then
          search-count bs next end needle table 0 (wrapping-add-i64 count 1)
        else search-count bs next end needle table advanced count
      else if ge-i64 (wrapping-sub-i64 size matched) 8 && ge-i64 (wrapping-sub-i64 end at) 8 && same-eight bs at needle matched then
        let next = wrapping-add-i64 at 8 in let advanced = wrapping-add-i64 matched 8 in
        if ge-i64 advanced size then
          search-count bs next end needle table 0 (wrapping-add-i64 count 1)
        else search-count bs next end needle table advanced count
      else if 0 <= at && at < bytes-len-i64 bs then
        let byte = bytes-get-u8-at bs at in
        let advanced = search-step needle table matched byte in
        let next = wrapping-add-i64 at 1 in
        if ge-i64 advanced size then
          search-count bs next end needle table 0 (wrapping-add-i64 count 1)
        else search-count bs next end needle table advanced count
      else count
    else count

  -- | Count nonoverlapping compiled matches; an empty pattern counts bounded decoded scalars plus one.
  -- Malformed or view-truncated bytes each make one replacement-scalar step without copying the view.
  byte-view-count-pattern :: ByteView -> BytePattern -> Nat
  byte-view-count-pattern view pattern = case view of
    View raw start end -> case pattern of
      Pattern needle table -> let size = bytes-len needle in
        if size == 0 then case Utf8.utf8-count-between raw start end of Some count -> count + 1; None -> 0
        else if size > end - start then 0 else
          let begin = nat-to-i64 start in let finish = nat-to-i64 end in
          let count = (if size == 1 then
            count-forward raw begin finish (bytes-get-u8 needle 0) 0
          else
            search-count raw begin finish needle table 0 0) in
          if 0 <= count then nat-from-i64 count else 0

  -- | Compare two exact view ranges using SIMD blocks and scalar fringes, preserving shared mutations.
  byte-view-equal :: ByteView -> ByteView -> Bool
  byte-view-equal a b = case a of
    View left first last -> case b of
      View right begin end -> if last - first == end - begin then
        search-equal left (nat-to-i64 first) right (nat-to-i64 begin) (nat-to-i64 end)
        else False

  -- | Find the first unequal byte relative to two bounded intervals using 16-byte SIMD, or their common length.
  compare-prefix :: Bytes -> I64 -> Bytes -> I64 -> I64 -> I64 -> I64
  compare-prefix a begin b start at size =
    let na = bytes-len-i64 a in
    let nb = bytes-len-i64 b in
    if 16 <= size && 16 <= na && 16 <= nb then
      let ns = nat-from-i64 size in
      let nna = nat-from-i64 na in
      let nnb = nat-from-i64 nb in
      if 16 <= ns && 16 <= nna && 16 <= nnb && 0 <= at then
        let nat-at = nat-from-i64 at in
        if nat-at <= ns - 16 then
          let left = wrapping-add-i64 begin at in
          let right = wrapping-add-i64 start at in
          if 0 <= left && 0 <= right then
            let nleft = nat-from-i64 left in
            let nright = nat-from-i64 right in
            if nleft <= nna - 16 && nright <= nnb - 16 then
              let x = bytes-load-u128 a nleft in
              let y = bytes-load-u128 b nright in
              let mask = simd-u8x16-movemask (simd-u8x16-cmpeq x y) in
              if eq-u32 mask 65535 then
                compare-prefix a begin b start (wrapping-add-i64 at 16) size
              else
                let diff = bit-xor-u32 mask 65535 in
                wrapping-add-i64 at (u32-to-i64 (trailing-zeros-u32 diff))
            else compare-prefix-tail a begin b start at size
          else compare-prefix-tail a begin b start at size
        else compare-prefix-tail a begin b start at size
      else compare-prefix-tail a begin b start at size
    else compare-prefix-tail a begin b start at size

  -- | Compare only available bytes until the first mismatch or the bounded common end.
  compare-prefix-tail :: Bytes -> I64 -> Bytes -> I64 -> I64 -> I64 -> I64
  compare-prefix-tail a begin b start at size =
    if 0 <= at && at < size then
      let left = wrapping-add-i64 begin at in
      let right = wrapping-add-i64 start at in
      if 0 <= left && left < bytes-len-i64 a && 0 <= right && right < bytes-len-i64 b then
        if eq-u8 (bytes-get-u8-at a left) (bytes-get-u8-at b right) then
          compare-prefix-tail a begin b start (wrapping-add-i64 at 1) size
        else at
      else size
    else size

  -- | Compare raw view bytes lexicographically, returning exactly negative one, zero or one.
  byte-view-compare :: ByteView -> ByteView -> I64
  byte-view-compare a b = case a of
    View left first last -> case b of
      View right begin end ->
        let size-a = last - first in
        let size-b = end - begin in
        let common = ((if size-a < size-b then size-a else size-b) :: Nat) in
        if common <= 9223372036854775807 then
          let lim = nat-to-i64 common in
          let f0 = nat-to-i64 first in
          let b0 = nat-to-i64 begin in
          let at = compare-prefix left f0 right b0 0 lim in
          if lt-i64 at lim then
            let lx = wrapping-add-i64 f0 at in
            let rx = wrapping-add-i64 b0 at in
            if 0 <= lx && lx < bytes-len-i64 left && 0 <= rx && rx < bytes-len-i64 right then
              if lt-u8 (bytes-get-u8-at left lx) (bytes-get-u8-at right rx) then -1 else 1
            else 0
          else if size-a < size-b then -1 else if size-a > size-b then 1 else 0
        else 0

  -- | Find a raw needle relative to a retained view, compiling one stable snapshot for this query.
  byte-view-index :: ByteView -> Bytes -> Option Nat
  byte-view-index view needle = byte-view-index-pattern view (bytes-compile-pattern needle)

  -- | Find the last raw needle, including overlapping matches and the empty end position.
  byte-view-last-index :: ByteView -> Bytes -> Option Nat
  byte-view-last-index view needle = byte-view-last-index-pattern view (bytes-compile-pattern needle)

  -- | Test exact raw needle containment without copying the view.
  byte-view-contains :: ByteView -> Bytes -> Bool
  byte-view-contains view needle = byte-view-contains-pattern view (bytes-compile-pattern needle)

  -- | Count a raw needle with bounded malformed-byte counting for empty patterns.
  byte-view-count :: ByteView -> Bytes -> Nat
  byte-view-count view needle = byte-view-count-pattern view (bytes-compile-pattern needle)

  -- | Test an exact raw prefix with SIMD block comparisons and no snapshots or pattern allocation.
  byte-view-has-prefix :: ByteView -> Bytes -> Bool
  byte-view-has-prefix view needle = case view of
    View raw start end -> if bytes-len needle <= end - start then
      search-equal raw (nat-to-i64 start) needle 0 (nat-to-i64 (bytes-len needle))
      else False

  -- | Test an exact raw suffix with no snapshots, pattern allocation or unrelated prefix scan.
  byte-view-has-suffix :: ByteView -> Bytes -> Bool
  byte-view-has-suffix view needle = case view of
    View raw start end -> if bytes-len needle <= end - start then
      let begin = end - bytes-len needle in
      search-equal raw (nat-to-i64 begin) needle 0 (nat-to-i64 (bytes-len needle))
      else False

  -- | Cut at the first raw match into aliases that retain the complete original owner.
  byte-view-cut :: ByteView -> Bytes -> Option (ByteView, ByteView)
  byte-view-cut view needle = byte-view-cut-pattern view (bytes-compile-pattern needle)

  -- | Cut at the final raw match, including overlapping candidates.
  byte-view-cut-last :: ByteView -> Bytes -> Option (ByteView, ByteView)
  byte-view-cut-last view needle = byte-view-cut-last-pattern view (bytes-compile-pattern needle)

  -- | Remove a raw prefix as an owner-retaining alias, including an unchanged empty prefix.
  byte-view-cut-prefix :: ByteView -> Bytes -> Option ByteView
  byte-view-cut-prefix view needle = if byte-view-has-prefix view needle then
    Some (byte-view-drop (bytes-len needle) view) else None

  -- | Remove a raw suffix as an owner-retaining alias, including an unchanged empty suffix.
  byte-view-cut-suffix :: ByteView -> Bytes -> Option ByteView
  byte-view-cut-suffix view needle = let size = byte-view-length view in let width = bytes-len needle in
    if width <= size && byte-view-has-suffix view needle then
      let kept = size - width in Some (byte-view-take kept view)
    else None

  -- | Find the first raw needle in a complete fixed buffer as an optional byte offset.
  bytes-index :: Bytes -> Bytes -> Option Nat
  bytes-index input needle = byte-view-index (bytes-view input) needle

  -- | Find the last raw needle in a complete fixed buffer, including overlaps.
  bytes-last-index :: Bytes -> Bytes -> Option Nat
  bytes-last-index input needle = byte-view-last-index (bytes-view input) needle

  -- | Test raw needle containment in a complete fixed buffer.
  bytes-contains :: Bytes -> Bytes -> Bool
  bytes-contains input needle = byte-view-contains (bytes-view input) needle

  -- | Count nonoverlapping raw matches, or decoded scalars plus one for an empty needle.
  bytes-count :: Bytes -> Bytes -> Nat
  bytes-count input needle = byte-view-count (bytes-view input) needle

  -- | Test whether a complete fixed buffer starts with exact raw bytes.
  bytes-has-prefix :: Bytes -> Bytes -> Bool
  bytes-has-prefix input needle = byte-view-has-prefix (bytes-view input) needle

  -- | Test whether a complete fixed buffer ends with exact raw bytes.
  bytes-has-suffix :: Bytes -> Bytes -> Bool
  bytes-has-suffix input needle = byte-view-has-suffix (bytes-view input) needle

  -- | Cut a complete fixed buffer at its first raw match into retained mutable aliases.
  bytes-cut :: Bytes -> Bytes -> Option (ByteView, ByteView)
  bytes-cut input needle = byte-view-cut (bytes-view input) needle

  -- | Cut a complete fixed buffer at its final raw match into retained mutable aliases.
  bytes-cut-last :: Bytes -> Bytes -> Option (ByteView, ByteView)
  bytes-cut-last input needle = byte-view-cut-last (bytes-view input) needle

  -- | Remove an exact prefix from a complete buffer while retaining its whole owner.
  bytes-cut-prefix :: Bytes -> Bytes -> Option ByteView
  bytes-cut-prefix input needle = byte-view-cut-prefix (bytes-view input) needle

  -- | Remove an exact suffix from a complete buffer while retaining its whole owner.
  bytes-cut-suffix :: Bytes -> Bytes -> Option ByteView
  bytes-cut-suffix input needle = byte-view-cut-suffix (bytes-view input) needle

  -- | Produce a 16-bit lane mask marking every lane that is ASCII and matches the requested whitespace class.
  ascii-space-mask :: U128 -> Bool -> U32
  ascii-space-mask chunk spaces =
    let delta = simd-u8x16-sub chunk (simd-u8x16-splat 9) in
    let controls = simd-u8x16-cmplt delta (simd-u8x16-splat 5) in
    let blanks = simd-u8x16-cmpeq chunk (simd-u8x16-splat 32) in
    let whitespace = bit-or-u128 controls blanks in
    let matching = (if spaces then whitespace
      else bit-and-u128 (bit-not-u128 whitespace) (simd-u8x16-cmplt chunk (simd-u8x16-splat 128))) in
    simd-u8x16-movemask matching

  -- | Classify one byte as ASCII whitespace or ASCII non-whitespace.
  ascii-space-byte :: U8 -> Bool -> Bool
  ascii-space-byte byte spaces =
    let delta = wrapping-sub-u8 byte 9 in
    let whitespace = le-u8 delta 4 || eq-u8 byte 32 in
    let ascii = lt-u8 byte 128 in
    if spaces then whitespace else (if whitespace then False else ascii)

  -- | Find the first opposite-class or non-ASCII byte in an exact scalar fringe.
  ascii-space-tail :: Bytes -> I64 -> I64 -> Bool -> I64
  ascii-space-tail bs at end spaces =
    if 0 <= at && at < end && end <= bytes-len-i64 bs then
      if ascii-space-byte (bytes-get-u8-at bs at) spaces then
        ascii-space-tail bs (wrapping-add-i64 at 1) end spaces
      else at
    else at

  -- | Skip complete matching 16-byte SIMD blocks, finding any in-block mismatch directly via bitmask.
  ascii-space-blocks :: Bytes -> I64 -> I64 -> Bool -> I64
  ascii-space-blocks bs at end spaces =
    if 16 <= end && end <= bytes-len-i64 bs then
      let ne = nat-from-i64 end in
      if 16 <= ne then
        let lim = ne - 16 in
        if 0 <= at then
          let ni = nat-from-i64 at in
          if ni <= lim then
            let chunk = bytes-load-u128 bs ni in
            let mask = ascii-space-mask chunk spaces in
            if eq-u32 mask 65535 then
              ascii-space-blocks bs (wrapping-add-i64 at 16) end spaces
            else
              let miss = bit-xor-u32 mask 65535 in
              wrapping-add-i64 at (u32-to-i64 (trailing-zeros-u32 miss))
          else ascii-space-tail bs at end spaces
        else at
      else ascii-space-tail bs at end spaces
    else ascii-space-tail bs at end spaces

  -- | End a maximal ASCII whitespace or non-whitespace run from a relative position.
  -- True selects exactly TAB through CR and SPACE; False selects other ASCII bytes.
  -- A non-ASCII byte ends either run. End positions are valid; positions past the view return None.
  -- Observes current aliases, retains the whole owner and never reads outside the logical view.
  byte-view-ascii-space-run-end :: ByteView -> Nat -> Bool -> Option Nat
  byte-view-ascii-space-run-end view position spaces = case view of
    View raw start end -> if position > end - start then None else
      let absolute = start + position in
      let begin = nat-to-i64 absolute in
      let finish = nat-to-i64 end in
      let found = ascii-space-blocks raw begin finish spaces in
      let origin = nat-to-i64 start in relative-match found origin
