-- | Exact raw-byte searching with bounded machine loops and portable 16-byte SIMD classification.
-- Complete sixteen-byte blocks use portable Data.Wide vector comparisons and bitmasks.
-- Scalar fringes read only their available bytes through checked Data.Bytes loads.
-- Public results are zero-based byte offsets; every byte value, including malformed UTF-8,
-- is compared exactly.
module Data.Bytes.Search where

  import Data.Bytes
  import Data.Bool
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Wide

  export bytes-index-byte, bytes-last-index-byte, bytes-contains-byte, bytes-count-byte

  -- | Find a matching first byte before entering complete sixteen-byte SIMD scans.
  index-forward :: Bytes -> U8 -> I64
  index-forward bs byte =
    if 0 < bytes-len-i64 bs then
      if eq-u8 (bytes-get-u8-at bs 0) byte then 0
      else index-forward-blocks bs 1 byte
    else -1

  -- | Find the first matching sixteen-byte SIMD block or fall through to the exact scalar fringe.
  index-forward-blocks :: Bytes -> I64 -> U8 -> I64
  index-forward-blocks bs at byte =
    let n = bytes-len-i64 bs in
    if 16 <= n then
      let nn = nat-from-i64 n in
      if 16 <= nn then
        let lim = nn - 16 in
        if 0 <= at then
          let ni = nat-from-i64 at in
          if ni <= lim then
            let chunk = bytes-load-u128 bs ni in
            let mask = simd-u8x16-movemask (simd-u8x16-cmpeq chunk (simd-u8x16-splat byte)) in
            if ne-u32 mask 0 then
              wrapping-add-i64 at (u32-to-i64 (trailing-zeros-u32 mask))
            else
              index-forward-blocks bs (wrapping-add-i64 at 16) byte
          else index-forward-tail bs at byte
        else -1
      else -1
    else index-forward-tail bs at byte

  -- | Read only remaining scalar bytes after complete sixteen-byte forward blocks.
  index-forward-tail :: Bytes -> I64 -> U8 -> I64
  index-forward-tail bs at byte =
    if 0 <= at && at < bytes-len-i64 bs then
      if eq-u8 (bytes-get-u8-at bs at) byte then at
      else index-forward-tail bs (wrapping-add-i64 at 1) byte
    else -1

  -- | Find a matching final byte before entering complete sixteen-byte suffix scans.
  index-backward :: Bytes -> U8 -> I64
  index-backward bs byte =
    let n = bytes-len-i64 bs in
    if 0 < n then
      let last = wrapping-sub-i64 n 1 in
      if 0 <= last && last < bytes-len-i64 bs then
        if eq-u8 (bytes-get-u8-at bs last) byte then last
        else index-backward-blocks bs last byte
      else -1
    else -1

  -- | Find the last matching byte by reading complete sixteen-byte suffix blocks before the leading fringe.
  index-backward-blocks :: Bytes -> I64 -> U8 -> I64
  index-backward-blocks bs end byte =
    if 16 <= end && end <= bytes-len-i64 bs then
      let ne = nat-from-i64 end in
      if 16 <= ne then
        let start-nat = ne - 16 in
        let start = wrapping-sub-i64 end 16 in
        let chunk = bytes-load-u128 bs start-nat in
        let mask = simd-u8x16-movemask (simd-u8x16-cmpeq chunk (simd-u8x16-splat byte)) in
        if ne-u32 mask 0 then
          let lane = wrapping-sub-i64 31 (u32-to-i64 (leading-zeros-u32 mask)) in
          wrapping-add-i64 start lane
        else
          index-backward-blocks bs start byte
      else -1
    else index-backward-tail bs end byte

  -- | Read only the leading scalar fringe while searching backward.
  index-backward-tail :: Bytes -> I64 -> U8 -> I64
  index-backward-tail bs end byte =
    if 0 < end && end <= bytes-len-i64 bs then
      let prev = wrapping-sub-i64 end 1 in
      if 0 <= prev && prev < bytes-len-i64 bs then
        if eq-u8 (bytes-get-u8-at bs prev) byte then prev
        else index-backward-tail bs prev byte
      else -1
    else -1

  -- | Count matching lanes across complete sixteen-byte SIMD blocks with an unboxed accumulator.
  count-forward :: Bytes -> I64 -> U8 -> I64 -> I64
  count-forward bs at byte total =
    let n = bytes-len-i64 bs in
    if 16 <= n then
      let nn = nat-from-i64 n in
      if 16 <= nn then
        let lim = nn - 16 in
        if 0 <= at then
          let ni = nat-from-i64 at in
          if ni <= lim then
            let chunk = bytes-load-u128 bs ni in
            let mask = simd-u8x16-movemask (simd-u8x16-cmpeq chunk (simd-u8x16-splat byte)) in
            let hits = u32-to-i64 (count-ones-u32 mask) in
            count-forward bs (wrapping-add-i64 at 16) byte (wrapping-add-i64 total hits)
          else count-tail bs at byte total
        else total
      else total
    else count-tail bs at byte total

  -- | Count only available scalar-fringe bytes without reading past the buffer end.
  count-tail :: Bytes -> I64 -> U8 -> I64 -> I64
  count-tail bs at byte total =
    if 0 <= at && at < bytes-len-i64 bs then
      let next-total = if eq-u8 (bytes-get-u8-at bs at) byte then wrapping-add-i64 total 1 else total in
      count-tail bs (wrapping-add-i64 at 1) byte next-total
    else total

  -- | Convert a private signed search sentinel into an optional exact public byte offset.
  found-offset :: I64 -> Option Nat
  found-offset value = if 0 <= value then Some (nat-from-i64 value) else None

  -- | Find the first exact byte value, returning no offset when the input contains no match.
  bytes-index-byte :: Bytes -> U8 -> Option Nat
  bytes-index-byte input byte = found-offset (index-forward input byte)

  -- | Find the last exact byte value without decoding or changing the input.
  bytes-last-index-byte :: Bytes -> U8 -> Option Nat
  bytes-last-index-byte input byte = found-offset (index-backward input byte)

  -- | Test whether any exact byte value occurs, including zero and high-bit byte values.
  bytes-contains-byte :: Bytes -> U8 -> Bool
  bytes-contains-byte input byte = ge-i64 (index-forward input byte) 0

  -- | Count every exact matching byte using sixteen-lane SIMD masks and a bounded scalar fringe.
  bytes-count-byte :: Bytes -> U8 -> Nat
  bytes-count-byte input byte =
    let count = count-forward input 0 byte 0 in
    if 0 <= count then nat-from-i64 count else 0
