            Poly (ib-sum a0 b0) (ib-sum a1 b1) (ib-sum a2 b2) (ib-sum a3 b3) (ib-sum a4 b4) (ib-sum a5 b5) (ib-sum a6 b6) (ib-sum a7 b7) (ib-sum a8 b8) (ib-sum a9 b9) (ib-sum a10 b10) (ib-sum a11 b11) (ib-sum a12 b12) (ib-sum a13 b13) (ib-sum a14 b14) (ib-sum a15 b15) (ib-sum a16 b16) (ib-sum a17 b17) (ib-sum a18 b18) (ib-sum a19 b19) (ib-sum a20 b20) (ib-sum a21 b21) (ib-sum a22 b22) (ib-sum a23 b23) (ib-sum a24 b24) (ib-sum a25 b25) (ib-sum a26 b26) (ib-sum a27 b27) (ib-sum a28 b28) (ib-sum a29 b29) (ib-sum a30 b30) (ib-sum a31 b31)

  -- | Coefficient-wise difference modulo q.
  poly-sub :: Poly -> Poly -> Poly
  poly-sub p q =
    case p of
      Poly a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24 a25 a26 a27 a28 a29 a30 a31 ->
        case q of
          Poly b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16 b17 b18 b19 b20 b21 b22 b23 b24 b25 b26 b27 b28 b29 b30 b31 ->
            Poly (sub-q a0 b0) (sub-q a1 b1) (sub-q a2 b2) (sub-q a3 b3) (sub-q a4 b4) (sub-q a5 b5) (sub-q a6 b6) (sub-q a7 b7) (sub-q a8 b8) (sub-q a9 b9) (sub-q a10 b10) (sub-q a11 b11) (sub-q a12 b12) (sub-q a13 b13) (sub-q a14 b14) (sub-q a15 b15) (sub-q a16 b16) (sub-q a17 b17) (sub-q a18 b18) (sub-q a19 b19) (sub-q a20 b20) (sub-q a21 b21) (sub-q a22 b22) (sub-q a23 b23) (sub-q a24 b24) (sub-q a25 b25) (sub-q a26 b26) (sub-q a27 b27) (sub-q a28 b28) (sub-q a29 b29) (sub-q a30 b30) (sub-q a31 b31)

  -- | Accumulate the NTT-domain product of two polynomials (FIPS 203 Algorithm 11) into acc.
  poly-basemul-add :: Poly -> Poly -> Poly -> Poly
  poly-basemul-add acc p r =
    case acc of
      Poly c0 c1 c2 c3 c4 c5 c6 c7 c8 c9 c10 c11 c12 c13 c14 c15 c16 c17 c18 c19 c20 c21 c22 c23 c24 c25 c26 c27 c28 c29 c30 c31 ->
        case p of
          Poly a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15 a16 a17 a18 a19 a20 a21 a22 a23 a24 a25 a26 a27 a28 a29 a30 a31 ->
            case r of
              Poly b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16 b17 b18 b19 b20 b21 b22 b23 b24 b25 b26 b27 b28 b29 b30 b31 ->
                Poly (basemul-add c0 a0 b0 17 3312 2761 568) (basemul-add c1 a1 b1 583 2746 2649 680) (basemul-add c2 a2 b2 1637 1692 723 2606) (basemul-add c3 a3 b3 2288 1041 1100 2229) (basemul-add c4 a4 b4 1409 1920 2662 667) (basemul-add c5 a5 b5 3281 48 233 3096) (basemul-add c6 a6 b6 756 2573 2156 1173) (basemul-add c7 a7 b7 3015 314 3050 279) (basemul-add c8 a8 b8 1703 1626 1651 1678) (basemul-add c9 a9 b9 2789 540 1789 1540) (basemul-add c10 a10 b10 1847 1482 952 2377) (basemul-add c11 a11 b11 1461 1868 2687 642) (basemul-add c12 a12 b12 939 2390 2308 1021) (basemul-add c13 a13 b13 2437 892 2388 941) (basemul-add c14 a14 b14 733 2596 2337 992) (basemul-add c15 a15 b15 268 3061 641 2688) (basemul-add c16 a16 b16 1584 1745 2298 1031) (basemul-add c17 a17 b17 2037 1292 3220 109) (basemul-add c18 a18 b18 375 2954 2549 780) (basemul-add c19 a19 b19 2090 1239 1645 1684) (basemul-add c20 a20 b20 1063 2266 319 3010) (basemul-add c21 a21 b21 2773 556 757 2572) (basemul-add c22 a22 b22 2099 1230 561 2768) (basemul-add c23 a23 b23 2466 863 2594 735) (basemul-add c24 a24 b24 2804 525 1092 2237) (basemul-add c25 a25 b25 403 2926 1026 2303) (basemul-add c26 a26 b26 1143 2186 2150 1179) (basemul-add c27 a27 b27 2775 554 886 2443) (basemul-add c28 a28 b28 1722 1607 1212 2117) (basemul-add c29 a29 b29 1874 1455 1029 2300) (basemul-add c30 a30 b30 2110 1219 2935 394) (basemul-add c31 a31 b31 885 2444 2154 1175)

  -- | Eight 16-bit lanes all equal to q = 3329.
  q-vec :: U128
  q-vec = simd-u16x8-splat 3329

  -- | Four 32-bit lanes all equal to q = 3329.
  q32-vec :: U128
  q32-vec = simd-u32x4-splat 3329

  -- | Four 32-bit lanes holding the Barrett multiplier floor(2^27 / 3329) = 40317.
  barrett-m32 :: U128
  barrett-m32 = simd-u32x4-splat 40317

  -- | Mask keeping the low 16 bits of each 32-bit lane (even 16-bit coefficients).
  mask-lo16 :: U128
  mask-lo16 = simd-u32x4-splat 65535

  -- | Mask keeping the low 32 bits of each 64-bit lane (pairs 0-1 and 4-5).
  mask-lo32 :: U128
  mask-lo32 = simd-u64x2-splat 4294967295

  -- | Reduce eight 16-bit lanes in [0, 2q) into [0, q) without branching.
  reduce-q :: U128 -> U128
  reduce-q v =
    let lt = simd-u16x8-cmplt v q-vec in
    simd-bitselect lt v (simd-u16x8-sub v q-vec)

  -- | Reduce four 32-bit lanes in [0, 2q) into [0, q) without branching.
  reduce-u32x4 :: U128 -> U128
  reduce-u32x4 v =
    let lt = simd-u32x4-cmplt v q32-vec in
    simd-bitselect lt v (simd-u32x4-sub v q32-vec)

  -- | Constant-time Barrett reduction of four 32-bit lanes in [0, 2 * 3328^2 + q] into [0, 2q).
  barrett-u32x4 :: U128 -> U128
  barrett-u32x4 p =
    let qest = simd-u32x4-shr (simd-u32x4-mul (simd-u32x4-shr p 8) barrett-m32) 19 in
    simd-u32x4-sub p (simd-u32x4-mul qest q32-vec)

  -- | Constant-time exact floor(r / 3329) across four 32-bit lanes in [0, 2 * 3328^2 + q].
  divq-u32x4 :: U128 -> U128
  divq-u32x4 r =
    let q0 = simd-u32x4-shr (simd-u32x4-mul (simd-u32x4-shr r 8) barrett-m32) 19 in
    let rem = simd-u32x4-sub r (simd-u32x4-mul q0 q32-vec) in
    let lt = simd-u32x4-cmplt rem q32-vec in
    simd-u32x4-add q0 (simd-u32x4-shr (bit-not-u128 lt) 31)

  -- | Multiply eight 16-bit lanes modulo q by four 32-bit twiddles (applied to even/odd pairs).
  mulmod-u32x4-vec :: U128 -> U128 -> U128
  mulmod-u32x4-vec a zv =
    let ae = bit-and-u128 a mask-lo16 in
    let ao = simd-u32x4-shr a 16 in
    let re = barrett-u32x4 (simd-u32x4-mul ae zv) in
    let ro = barrett-u32x4 (simd-u32x4-mul ao zv) in
    reduce-q (bit-or-u128 re (simd-u32x4-shl ro 16))

  -- | Lane-wise a + b modulo q (also the inverse butterfly sum).
  ib-sum :: U128 -> U128 -> U128
  ib-sum a b = reduce-q (simd-u16x8-add a b)

  -- | Lane-wise a - b modulo q.
  sub-q :: U128 -> U128 -> U128
  sub-q a b = reduce-q (simd-u16x8-sub (simd-u16x8-add a q-vec) b)

  -- | Lane-wise multiplication by a constant modulo q.
  scale :: U128 -> U32 -> U128
  scale a z = mulmod-u32x4-vec a (simd-u32x4-splat z)

  -- | Inverse butterfly difference: zeta * (b - a) modulo q in every lane.
  ib-diff :: U128 -> U128 -> U32 -> U128
  ib-diff a b z = scale (sub-q b a) z

  -- | The forward layer of length four inside a lane: coefficients 0-3 against 4-7.
  ntt4 :: U128 -> U32 -> U128
  ntt4 x z =
    let lo = u64-to-u128 (low64 x) in
    let t = scale (u64-to-u128 (high64 x)) z in
    simd-u64x2-pack (low64 (ib-sum lo t)) (low64 (sub-q lo t))

  -- | The inverse layer of length four inside a lane.
  inv4 :: U128 -> U32 -> U128
  inv4 x z =
    let lo = u64-to-u128 (low64 x) in
    let hi = u64-to-u128 (high64 x) in
    simd-u64x2-pack (low64 (ib-sum lo hi)) (low64 (ib-diff lo hi z))

  -- | The forward layer of length two inside a lane, with one twiddle per half.
  ntt2 :: U128 -> U32 -> U32 -> U128
  ntt2 x z0 z1 =
    let a = bit-and-u128 x mask-lo32 in
    let c = simd-u64x2-shr x 32 in
    let t = mulmod-u32x4-vec c (simd-u32x4-pack z0 0 z1 0) in
    let s = ib-sum a t in
    let d = sub-q a t in
    bit-or-u128 s (simd-u64x2-shl d 32)

  -- | The inverse layer of length two inside a lane, with one twiddle per half.
  inv2 :: U128 -> U32 -> U32 -> U128
  inv2 x z0 z1 =
    let a = bit-and-u128 x mask-lo32 in
    let c = simd-u64x2-shr x 32 in
    let s = ib-sum a c in
    let d = mulmod-u32x4-vec (sub-q c a) (simd-u32x4-pack z0 0 z1 0) in
    bit-or-u128 s (simd-u64x2-shl d 32)

  -- | acc + a * b for four degree-one products modulo X^2 - gamma (FIPS 203 Algorithm 12).
  basemul-add :: U128 -> U128 -> U128 -> U32 -> U32 -> U32 -> U32 -> U128
  basemul-add acc a b g0 g1 g2 g3 =
    let ae = bit-and-u128 a mask-lo16 in
    let ao = simd-u32x4-shr a 16 in
    let be = bit-and-u128 b mask-lo16 in
    let bo = simd-u32x4-shr b 16 in
    let gv = simd-u32x4-pack g0 g1 g2 g3 in
    let odd-prod = reduce-u32x4 (barrett-u32x4 (simd-u32x4-mul ao bo)) in
    let even = barrett-u32x4 (simd-u32x4-add (simd-u32x4-mul ae be) (simd-u32x4-mul odd-prod gv)) in
    let cross = barrett-u32x4 (simd-u32x4-add (simd-u32x4-mul ae bo) (simd-u32x4-mul ao be)) in
    ib-sum acc (reduce-q (bit-or-u128 even (simd-u32x4-shl cross 16)))

  -- | One when every lane is below q, else zero.
  below-q :: U128 -> I64
  below-q x = if eq-u128 (simd-u16x8-cmplt x q-vec) max-bound-u128 then 1 else 0

  -- | Pack eight 12-bit lanes into 96 bits (ByteEncode_12 of one lane).
  pack12 :: U128 -> U128
  pack12 x =
    let f0 = bit-and-u128 x 4095 in
    let f1 = bit-and-u128 (wrapping-shr-u128 x 16) 4095 in
    let f2 = bit-and-u128 (wrapping-shr-u128 x 32) 4095 in
    let f3 = bit-and-u128 (wrapping-shr-u128 x 48) 4095 in
    let f4 = bit-and-u128 (wrapping-shr-u128 x 64) 4095 in
    let f5 = bit-and-u128 (wrapping-shr-u128 x 80) 4095 in
    let f6 = bit-and-u128 (wrapping-shr-u128 x 96) 4095 in
    let f7 = bit-and-u128 (wrapping-shr-u128 x 112) 4095 in
    let p01 = bit-or-u128 f0 (wrapping-shl-u128 f1 12) in
    let p23 = bit-or-u128 (wrapping-shl-u128 f2 24) (wrapping-shl-u128 f3 36) in
    let p45 = bit-or-u128 (wrapping-shl-u128 f4 48) (wrapping-shl-u128 f5 60) in
    let p67 = bit-or-u128 (wrapping-shl-u128 f6 72) (wrapping-shl-u128 f7 84) in
    bit-or-u128 (bit-or-u128 p01 p23) (bit-or-u128 p45 p67)

  -- | Unpack 96 bits into eight 12-bit lanes (ByteDecode_12 before reduction).
  unpack12 :: U128 -> U128
  unpack12 x =
    let f0 = bit-and-u128 x 4095 in
    let f1 = bit-and-u128 (wrapping-shr-u128 x 12) 4095 in
    let f2 = bit-and-u128 (wrapping-shr-u128 x 24) 4095 in
    let f3 = bit-and-u128 (wrapping-shr-u128 x 36) 4095 in
    let f4 = bit-and-u128 (wrapping-shr-u128 x 48) 4095 in
    let f5 = bit-and-u128 (wrapping-shr-u128 x 60) 4095 in
    let f6 = bit-and-u128 (wrapping-shr-u128 x 72) 4095 in
    let f7 = bit-and-u128 (wrapping-shr-u128 x 84) 4095 in
    let p01 = bit-or-u128 f0 (wrapping-shl-u128 f1 16) in
    let p23 = bit-or-u128 (wrapping-shl-u128 f2 32) (wrapping-shl-u128 f3 48) in
    let p45 = bit-or-u128 (wrapping-shl-u128 f4 64) (wrapping-shl-u128 f5 80) in
    let p67 = bit-or-u128 (wrapping-shl-u128 f6 96) (wrapping-shl-u128 f7 112) in
    bit-or-u128 (bit-or-u128 p01 p23) (bit-or-u128 p45 p67)

  -- | Compress_d of eight 16-bit lanes, packed at d bits per coefficient (d in {1, 4, 5, 10, 11}).
  compress-d :: U32 -> U32 -> U128 -> U128
  compress-d d mask x =
    let ae = bit-and-u128 x mask-lo16 in
    let ao = simd-u32x4-shr x 16 in
    let mv = simd-u32x4-splat mask in
    let half = simd-u32x4-splat 1664 in
    let ce = bit-and-u128 (divq-u32x4 (simd-u32x4-add (simd-u32x4-shl ae d) half)) mv in
    let co = bit-and-u128 (divq-u32x4 (simd-u32x4-add (simd-u32x4-shl ao d) half)) mv in
    let pair = bit-or-u128 ce (simd-u32x4-shl co d) in
    let p0 = bit-and-u128 pair 4294967295 in
    let p1 = bit-and-u128 (wrapping-shr-u128 pair 32) 4294967295 in
    let p2 = bit-and-u128 (wrapping-shr-u128 pair 64) 4294967295 in
    let p3 = wrapping-shr-u128 pair 96 in
    let d2 = wrapping-shl-u32 d 1 in
    let d4 = wrapping-shl-u32 d 2 in
    let d6 = wrapping-add-u32 d4 d2 in
    bit-or-u128 (bit-or-u128 p0 (wrapping-shl-u128 p1 d2)) (bit-or-u128 (wrapping-shl-u128 p2 d4) (wrapping-shl-u128 p3 d6))

  -- | Decompress_d of eight packed d-bit fields into 16-bit lanes (d in {1, 4, 5, 10, 11}).
  decompress-d :: U32 -> U32 -> U128 -> U128
  decompress-d d mask v =
    let m = u32-to-u128 mask in
    let d2 = wrapping-shl-u32 d 1 in
    let d3 = wrapping-add-u32 d2 d in
    let d4 = wrapping-shl-u32 d 2 in
    let d5 = wrapping-add-u32 d4 d in
    let d6 = wrapping-add-u32 d4 d2 in
    let d7 = wrapping-add-u32 d6 d in
    let f0 = wrapping-u128-to-u32 (bit-and-u128 v m) in
    let f1 = wrapping-u128-to-u32 (bit-and-u128 (wrapping-shr-u128 v d) m) in
    let f2 = wrapping-u128-to-u32 (bit-and-u128 (wrapping-shr-u128 v d2) m) in
    let f3 = wrapping-u128-to-u32 (bit-and-u128 (wrapping-shr-u128 v d3) m) in
    let f4 = wrapping-u128-to-u32 (bit-and-u128 (wrapping-shr-u128 v d4) m) in
    let f5 = wrapping-u128-to-u32 (bit-and-u128 (wrapping-shr-u128 v d5) m) in
    let f6 = wrapping-u128-to-u32 (bit-and-u128 (wrapping-shr-u128 v d6) m) in
    let f7 = wrapping-u128-to-u32 (bit-and-u128 (wrapping-shr-u128 v d7) m) in
    let fe = simd-u32x4-pack f0 f2 f4 f6 in
    let fo = simd-u32x4-pack f1 f3 f5 f7 in
    let half = simd-u32x4-splat (wrapping-shl-u32 1 (wrapping-sub-u32 d 1)) in
    let de = simd-u32x4-shr (simd-u32x4-add (simd-u32x4-mul fe q32-vec) half) d in
    let d-odd = simd-u32x4-shr (simd-u32x4-add (simd-u32x4-mul fo q32-vec) half) d in
    bit-or-u128 de (simd-u32x4-shl d-odd 16)

  -- | Decompress_1 of eight message bits: each bit becomes 0 or 1665.
  message-lane :: I64 -> U128
  message-lane raw =
    let w = wrapping-i64-to-u32 raw in
    let b0 = bit-and-u32 w 1 in
    let b1 = bit-and-u32 (wrapping-shr-u32 w 1) 1 in
    let b2 = bit-and-u32 (wrapping-shr-u32 w 2) 1 in
    let b3 = bit-and-u32 (wrapping-shr-u32 w 3) 1 in
    let b4 = bit-and-u32 (wrapping-shr-u32 w 4) 1 in
    let b5 = bit-and-u32 (wrapping-shr-u32 w 5) 1 in
    let b6 = bit-and-u32 (wrapping-shr-u32 w 6) 1 in
    let b7 = bit-and-u32 (wrapping-shr-u32 w 7) 1 in
    let bits = simd-u32x4-pack (bit-or-u32 b0 (wrapping-shl-u32 b1 16)) (bit-or-u32 b2 (wrapping-shl-u32 b3 16)) (bit-or-u32 b4 (wrapping-shl-u32 b5 16)) (bit-or-u32 b6 (wrapping-shl-u32 b7 16)) in
    simd-u16x8-mul bits (simd-u16x8-splat 1665)

  -- | Eight centered binomial coefficients (eta = 2) from 32 bits, modulo q.
  cbd2 :: I64 -> U128
  cbd2 raw =
    let w = wrapping-i64-to-u32 raw in
    let t = wrapping-add-u32 (bit-and-u32 w 1431655765) (bit-and-u32 (wrapping-shr-u32 w 1) 1431655765) in
    let x0 = bit-and-u32 t 3 in let y0 = bit-and-u32 (wrapping-shr-u32 t 2) 3 in
    let x1 = bit-and-u32 (wrapping-shr-u32 t 4) 3 in let y1 = bit-and-u32 (wrapping-shr-u32 t 6) 3 in
    let x2 = bit-and-u32 (wrapping-shr-u32 t 8) 3 in let y2 = bit-and-u32 (wrapping-shr-u32 t 10) 3 in
    let x3 = bit-and-u32 (wrapping-shr-u32 t 12) 3 in let y3 = bit-and-u32 (wrapping-shr-u32 t 14) 3 in
    let x4 = bit-and-u32 (wrapping-shr-u32 t 16) 3 in let y4 = bit-and-u32 (wrapping-shr-u32 t 18) 3 in
    let x5 = bit-and-u32 (wrapping-shr-u32 t 20) 3 in let y5 = bit-and-u32 (wrapping-shr-u32 t 22) 3 in
    let x6 = bit-and-u32 (wrapping-shr-u32 t 24) 3 in let y6 = bit-and-u32 (wrapping-shr-u32 t 26) 3 in
    let x7 = bit-and-u32 (wrapping-shr-u32 t 28) 3 in let y7 = bit-and-u32 (wrapping-shr-u32 t 30) 3 in
    let xv = simd-u32x4-pack (bit-or-u32 x0 (wrapping-shl-u32 x1 16)) (bit-or-u32 x2 (wrapping-shl-u32 x3 16)) (bit-or-u32 x4 (wrapping-shl-u32 x5 16)) (bit-or-u32 x6 (wrapping-shl-u32 x7 16)) in
    let yv = simd-u32x4-pack (bit-or-u32 y0 (wrapping-shl-u32 y1 16)) (bit-or-u32 y2 (wrapping-shl-u32 y3 16)) (bit-or-u32 y4 (wrapping-shl-u32 y5 16)) (bit-or-u32 y6 (wrapping-shl-u32 y7 16)) in
    sub-q xv yv

  -- | A U128 from its low and high halves.
  join64 :: U64 -> U64 -> U128
  join64 lo hi = simd-u64x2-pack lo hi

  -- | The low half of a U128.
  low64 :: U128 -> U64
  low64 x = wrapping-u128-to-u64 x

  -- | The high half of a U128.
  high64 :: U128 -> U64
  high64 x = wrapping-u128-to-u64 (wrapping-shr-u128 x 64)
