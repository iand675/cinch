  -- | Initial chaining words for a checkpoint variant code, derived exactly from the standard definitions.
  -- Code 4 is SHA-384, 5 is SHA-512/224, 6 is SHA-512/256 and every other code is SHA-512.
  sha512-initial-words :: Nat -> Sha512Words
  sha512-initial-words variant =
    if variant == 4 then Words512 14680500436340154072 7105036623409894663 10473403895298186519 1526699215303891257 7436329637833083697 10282925794625328401 15784041429090275239 5167115440072839076
    else if variant == 5 then Words512 10105294471447203234 8350123849800275158 2160240930085379202 7466358040605728719 1111592415079452072 8638871050018654530 4583966954114332360 1230299281376055969
    else if variant == 6 then Words512 2463787394917988140 11481187982095705282 2563595384472711505 10824532655140301501 10819967247969091555 13717434660681038226 3098927326965381290 1060366662362279074
    else Words512 7640891576956012808 13503953896175478587 4354685564936845355 11912009170470909681 5840696475078001361 11170449401992604703 2270897969802886507 6620516959819538809

  -- | Select word 0 of a packed pair without narrowing the other word's bits.
  prim sha512-lane0 :: U128 -> U64 where
    llvm {
      %value = trunc i128 %0 to i64
      ret i64 %value
    }

  -- | Select word 1 of a packed pair without narrowing the other word's bits.
  prim sha512-lane1 :: U128 -> U64 where
    llvm {
      %shift = lshr i128 %0, 64
      %value = trunc i128 %shift to i64
      ret i64 %value
    }

  -- | Pack two consecutive message words with the first word in the low half.
  prim sha512-group :: U64 -> U64 -> U128 where
    llvm {
      %valuel = zext i64 %0 to i128
      %valueh = zext i64 %1 to i128
      %valueu = shl i128 %valueh, 64
      %value = or i128 %valuel, %valueu
      ret i128 %value
    }

  -- | Evaluate one ordered round over a..h, the message word and the round constant; return new a low and new e high.
  prim sha512-round :: U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U128 where
    llvm {
      %s1a = call i64 @llvm.fshr.i64(i64 %4, i64 %4, i64 14)
      %s1b = call i64 @llvm.fshr.i64(i64 %4, i64 %4, i64 18)
      %s1c = call i64 @llvm.fshr.i64(i64 %4, i64 %4, i64 41)
      %s1ab = xor i64 %s1a, %s1b
      %s1 = xor i64 %s1ab, %s1c
      %ef = and i64 %4, %5
      %not = xor i64 %4, -1
      %ng = and i64 %not, %6
      %ch = xor i64 %ef, %ng
      %t1a = add i64 %7, %s1
      %t1b = add i64 %t1a, %ch
      %t1c = add i64 %t1b, %8
      %t1 = add i64 %t1c, %9
      %s0a = call i64 @llvm.fshr.i64(i64 %0, i64 %0, i64 28)
      %s0b = call i64 @llvm.fshr.i64(i64 %0, i64 %0, i64 34)
      %s0c = call i64 @llvm.fshr.i64(i64 %0, i64 %0, i64 39)
      %s0ab = xor i64 %s0a, %s0b
      %s0 = xor i64 %s0ab, %s0c
      %ab = and i64 %0, %1
      %ac = and i64 %0, %2
      %bc = and i64 %1, %2
      %pair = xor i64 %ab, %ac
      %maj = xor i64 %pair, %bc
      %t2 = add i64 %s0, %maj
      %na = add i64 %t1, %t2
      %ne = add i64 %3, %t1
      %valuel = zext i64 %na to i128
      %valueh = zext i64 %ne to i128
      %valueu = shl i128 %valueh, 64
      %value = or i128 %valuel, %valueu
      ret i128 %value
    }

  -- | Expand two schedule words in independent SIMD lanes from five earlier word pairs.
  prim sha512-schedule :: U128 -> U128 -> U128 -> U128 -> U128 -> U128 where
    llvm {
      %p16lo = trunc i128 %0 to i64
      %p16s = lshr i128 %0, 64
      %p16hi = trunc i128 %p16s to i64
      %p16v0 = insertelement <2 x i64> poison, i64 %p16lo, i64 0
      %p16 = insertelement <2 x i64> %p16v0, i64 %p16hi, i64 1
      %p14lo = trunc i128 %1 to i64
      %p14s = lshr i128 %1, 64
      %p14hi = trunc i128 %p14s to i64
      %p14v0 = insertelement <2 x i64> poison, i64 %p14lo, i64 0
      %p14 = insertelement <2 x i64> %p14v0, i64 %p14hi, i64 1
      %p8lo = trunc i128 %2 to i64
      %p8s = lshr i128 %2, 64
      %p8hi = trunc i128 %p8s to i64
      %p8v0 = insertelement <2 x i64> poison, i64 %p8lo, i64 0
      %p8 = insertelement <2 x i64> %p8v0, i64 %p8hi, i64 1
      %p6lo = trunc i128 %3 to i64
      %p6s = lshr i128 %3, 64
      %p6hi = trunc i128 %p6s to i64
      %p6v0 = insertelement <2 x i64> poison, i64 %p6lo, i64 0
      %p6 = insertelement <2 x i64> %p6v0, i64 %p6hi, i64 1
      %p2lo = trunc i128 %4 to i64
      %p2s = lshr i128 %4, 64
      %p2hi = trunc i128 %p2s to i64
      %p2v0 = insertelement <2 x i64> poison, i64 %p2lo, i64 0
      %p2 = insertelement <2 x i64> %p2v0, i64 %p2hi, i64 1
      %w15 = shufflevector <2 x i64> %p16, <2 x i64> %p14, <2 x i32> <i32 1, i32 2>
      %w7 = shufflevector <2 x i64> %p8, <2 x i64> %p6, <2 x i32> <i32 1, i32 2>
      %s0a = call <2 x i64> @llvm.fshr.v2i64(<2 x i64> %w15, <2 x i64> %w15, <2 x i64> <i64 1, i64 1>)
      %s0b = call <2 x i64> @llvm.fshr.v2i64(<2 x i64> %w15, <2 x i64> %w15, <2 x i64> <i64 8, i64 8>)
      %s0c = lshr <2 x i64> %w15, <i64 7, i64 7>
      %s0ab = xor <2 x i64> %s0a, %s0b
      %s0 = xor <2 x i64> %s0ab, %s0c
      %s1a = call <2 x i64> @llvm.fshr.v2i64(<2 x i64> %p2, <2 x i64> %p2, <2 x i64> <i64 19, i64 19>)
      %s1b = call <2 x i64> @llvm.fshr.v2i64(<2 x i64> %p2, <2 x i64> %p2, <2 x i64> <i64 61, i64 61>)
      %s1c = lshr <2 x i64> %p2, <i64 6, i64 6>
      %s1ab = xor <2 x i64> %s1a, %s1b
      %s1 = xor <2 x i64> %s1ab, %s1c
      %base0 = add <2 x i64> %p16, %s0
      %base1 = add <2 x i64> %base0, %w7
      %complete = add <2 x i64> %base1, %s1
      %low = extractelement <2 x i64> %complete, i64 0
      %high = extractelement <2 x i64> %complete, i64 1
      %valuel = zext i64 %low to i128
      %valueh = zext i64 %high to i128
      %valueu = shl i128 %valueh, 64
      %value = or i128 %valuel, %valueu
      ret i128 %value
    }
