-- | Inspectable SHA-384/SHA-512 family hashing sinks and bounded reader-to-digest copying.
-- The immutable digest state is the sink handle. Writes accept every byte and
-- never retain input buffers. Copying returns the advanced reader and the last
-- valid digest on failure, and never closes a borrowed source.
module Effect.Sha512 where

  import Effect.Stream
  import Text.Sha512
  import Data.Bytes
  import Data.Nat
  import Data.Result

  export sha512-write, sha512-hashing-writer, sha512-copy

  -- | Hash a whole chunk, returning its accepted count and the advanced immutable state.
  sha512-write :: forall r. using (io :: Io r) => Sha512State -> Bytes ->{IO r} (Nat, Sha512State)
  sha512-write state input = (bytes-len input, sha512-state-update state input)

  -- | Adapt a digest state to the generic byte-writer protocol.
  -- Use the explicit state or sha512-copy when the advanced digest must be inspected.
  sha512-hashing-writer :: forall r. using (io :: Io r) => Sha512State -> ByteWriter r
  sha512-hashing-writer state = stream-writer (\input -> case sha512-write state input of
    (count, next) -> (Ok count, sha512-hashing-writer next))

  -- | Hash successful reader chunks through EOF, preserving both advanced handles on errors.
  -- A zero chunk size is rejected before reading. Invalid source counts do not enter the digest.
  sha512-copy :: forall r. using (io :: Io r) => Nat -> ByteReader r -> Sha512State ->{IO r} (Result StreamError Nat, (ByteReader r, Sha512State))
  sha512-copy chunk source state =
    if chunk == 0 then (Err StreamInvalidChunkSize, (source, state))
    else copy-from chunk source state 0

  -- | Carry only the opaque digest state and accepted byte count through the bounded copying loop.
  copy-from :: forall r. using (io :: Io r) => Nat -> ByteReader r -> Sha512State -> Nat ->{IO r} (Result StreamError Nat, (ByteReader r, Sha512State))
  copy-from chunk source state count = case stream-read source chunk of
    (Err error, next) -> (Err error, (next, state))
    (Ok input, next) -> if bytes-len input == 0 then (Ok count, (next, state))
      else copy-from chunk next (sha512-state-update state input) (count + bytes-len input)
