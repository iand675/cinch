  export http-set-cookie
  export HttpVersion, HttpVersion, http10, http11, http-version-major, http-version-minor, http-version-string, http-parse-version
  export HttpWireRequest, HttpWireRequest, http-new-request, req-method, req-request-uri, req-host, req-path, req-raw-path
  export req-raw-query, req-proto-major, req-proto-minor, req-proto, req-headers, req-header, req-header-values
