  export status-misdirected-request, status-unprocessable-entity, status-locked, status-failed-dependency
  export status-too-early, status-upgrade-required, status-precondition-required, status-too-many-requests
  export status-request-header-fields-too-large, status-unavailable-for-legal-reasons
  export status-internal-server-error, status-not-implemented, status-bad-gateway, status-service-unavailable
  export status-gateway-timeout, status-http-version-not-supported, status-variant-also-negotiates
  export status-insufficient-storage, status-loop-detected, status-not-extended, status-network-authentication-required
  export http-status-text
  export method-get, method-head, method-post, method-put, method-patch, method-delete, method-connect, method-options, method-trace
  export HttpProtoError, HttpProtoIncomplete, HttpProtoBadRequestLine, HttpProtoBadStatusLine, HttpProtoBadHeader
  export HttpProtoInvalidVersion, HttpProtoInvalidContentLength, HttpProtoConflictingContentLength
  export HttpProtoUnsupportedTransferEncoding, HttpProtoBadChunk, HttpProtoTruncatedBody, HttpProtoTooLarge
