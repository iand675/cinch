-- | ChaCha20 and XChaCha20 stream encryption, the Poly1305 one-time authenticator, and the
-- ChaCha20-Poly1305 and XChaCha20-Poly1305 authenticated ciphers (RFC 8439 and the extended-nonce
-- construction through HChaCha20).
--
-- A ChaCha20 keystream block is the state after twenty rounds plus the initial state, computed in a single
-- pass as four <4 x i32> SIMD rows via Data.Wide: column rounds are vector quarter rounds and diagonal rounds
-- rotate rows one, two and three lanes with endian-portable 128-bit rotations. Poly1305 keeps its accumulator
-- in radix-2^64 limbs (h0, h1, h2 <= 4), multiplies via 64x64->128-bit Data.Wide products, reduces modulo
-- 2^130 - 5 once per block and fully at the end in constant time with no data-dependent branches. Tags are
-- compared in constant time and nothing is decrypted before the tag verifies. Every returned buffer is fresh.
module Crypto.ChaCha20Poly1305 where

  import Data.Bytes
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Result
  import Data.String
  import Data.Wide (bit-or-u128, bit-xor-u128, rotate-left-u128, simd-u32x4-add, simd-u32x4-pack, simd-u32x4-rotl, simd-u64x2-pack, u64-to-u128, u8-to-u128, wrapping-add-u128, wrapping-mul-u128, wrapping-shl-u128, wrapping-shr-u128, wrapping-u128-to-u64)
  import Crypto.ConstantTime (constant-bytes-equal)

  export ChaChaError, ChaChaKeySize, ChaChaNonceSize, ChaChaTooLarge, ChaChaAuthentication, chacha-error-message
  export chacha20-xor, xchacha20-xor, hchacha20, poly1305-mac, poly1305-verify
  export chacha20poly1305-seal, chacha20poly1305-open, xchacha20poly1305-seal, xchacha20poly1305-open
  export chacha-key-size, chacha-nonce-size, xchacha-nonce-size, poly1305-tag-size

  -- | Why a ChaCha20 or Poly1305 operation was refused.
  data ChaChaError where
    -- | The key is not 32 bytes (its length is given).
    ChaChaKeySize :: Nat -> ChaChaError
    -- | The nonce has the wrong length (its length is given).
    ChaChaNonceSize :: Nat -> ChaChaError
    -- | The message would run the 32-bit block counter past its end.
    ChaChaTooLarge :: ChaChaError
    -- | The tag does not authenticate the ciphertext and additional data.
    ChaChaAuthentication :: ChaChaError

  -- | A readable description of an error.
  chacha-error-message :: ChaChaError -> String
  chacha-error-message e = case e of
    ChaChaKeySize n -> "chacha20: key must be 32 bytes"
    ChaChaNonceSize n -> "chacha20: wrong nonce size"
    ChaChaTooLarge -> "chacha20: message too large for the block counter"
    ChaChaAuthentication -> "chacha20poly1305: message authentication failed"

  -- | Key bytes.
  chacha-key-size :: Nat
  chacha-key-size = 32

  -- | ChaCha20 and ChaCha20-Poly1305 nonce bytes.
  chacha-nonce-size :: Nat
  chacha-nonce-size = 12

  -- | XChaCha20 and XChaCha20-Poly1305 nonce bytes.
  xchacha-nonce-size :: Nat
  xchacha-nonce-size = 24

  -- | Poly1305 tag bytes.
  poly1305-tag-size :: Nat
  poly1305-tag-size = 16

  -- | Radix-2^64 Poly1305 accumulator (h0 + h1 * 2^64 + h2 * 2^128, with h2 <= 4).
  data PolyAcc where
    -- | Low 64 bits, middle 64 bits, and high carry limb (0..4).
    PolyAcc :: U64 -> U64 -> U64 -> PolyAcc

  -- ---------------------------------------------------------------------
  -- Helpers.
  -- ---------------------------------------------------------------------

  -- | The ChaCha20 sigma constant row ("expand 32-byte k").
  sigma-row :: U128
  sigma-row = simd-u32x4-pack 1634760805 857760878 2036477234 1797285236

  -- | Sixteen bytes as a little-endian U128 (missing bytes read as zero).
  get128 :: Bytes -> Nat -> U128
  get128 b o =
    if o + 16 <= bytes-len b then bytes-load-u128 b o
    else tail128 b o 0 (0 :: U128)

  -- | The bytes from o + i onwards (below the buffer end and o + 16) placed into an accumulator.
  tail128 :: Bytes -> Nat -> Nat -> U128 -> U128
  tail128 b o i acc =
    if i >= 16 || o + i >= bytes-len b then acc
    else tail128 b o (i + 1) (bit-or-u128 acc (wrapping-shl-u128 (u8-to-u128 (bytes-get-u8 b (o + i))) (word (8 * i))))

  -- | A value below 2^32 as a 32-bit word.
  word :: Nat -> U32
  word n = if n < 4294967296 then wrapping-i64-to-u32 (nat-to-i64 n) else 0

  -- | Store the first n (at most 16) bytes of a U128 at an offset, as far as they fit.
  put128 :: Bytes -> Nat -> U128 -> Nat -> Unit
  put128 b o v n =
    if n >= 16 && o + 16 <= bytes-len b then bytes-store-u128 b o v
    else put-bytes b o v 0 n

  -- | Store bytes i onwards (below n) of a U128 one at a time.
  put-bytes :: Bytes -> Nat -> U128 -> Nat -> Nat -> Unit
  put-bytes b o v i n = if i >= n || i >= 16 then ()
    else
      let s = if o + i < bytes-len b then bytes-set-u8 b (o + i) (wrapping-u64-to-u8 (wrapping-u128-to-u64 (wrapping-shr-u128 v (word (8 * i))))) else () in
      put-bytes b o v (i + 1) n

  -- | A U128 as sixteen fresh bytes.
  bytes-of128 :: U128 -> Bytes
  bytes-of128 v = let out = bytes-new 16 in let s = bytes-store-u128 out 0 v in out

  -- | Copy a range into a fresh buffer.
  slice :: Bytes -> Nat -> Nat -> Bytes
  slice b o n = let out = bytes-new n in let c = (if o + n <= bytes-len b then bytes-copy-range out b 0 o n else ()) in out

  -- | Saturating subtraction.
  minus :: Nat -> Nat -> Nat
  minus a b = if b <= a then a - b else 0

  -- | The counter-and-nonce row: the counter in word 0 and the twelve nonce bytes after it.
  counter-row :: Nat -> Bytes -> Nat -> U128
  counter-row counter nonce o =
    let w0 = word counter in
    let n0 = if o + 4 <= bytes-len nonce then bytes-load-le32 nonce o else 0 in
    let n1 = if o + 8 <= bytes-len nonce then bytes-load-le32 nonce (o + 4) else 0 in
    let n2 = if o + 12 <= bytes-len nonce then bytes-load-le32 nonce (o + 8) else 0 in
    simd-u32x4-pack w0 n0 n1 n2

  -- | The next block counter (lane 0 incremented modulo 2^32 without carrying into lane 1).
  bump :: U128 -> U128
  bump row = simd-u32x4-add row (u64-to-u128 1)

  -- ---------------------------------------------------------------------
  -- ChaCha20.
  -- ---------------------------------------------------------------------

  -- | XOR a message with the ChaCha20 keystream for a 32-byte key and 12-byte nonce, starting at a block counter.
  chacha20-xor :: Bytes -> Bytes -> Nat -> Bytes -> Result ChaChaError Bytes
  chacha20-xor key nonce counter input =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if not (bytes-len nonce == 12) then Err (ChaChaNonceSize (bytes-len nonce))
    else if counter + nat-div (bytes-len input + 63) 64 > 4294967296 then Err ChaChaTooLarge
    else Ok (keystream-xor (get128 key 0) (get128 key 16) nonce 0 counter input)

  -- | XOR with the keystream of the key halves and the nonce at an offset, from a block counter.
  keystream-xor :: U128 -> U128 -> Bytes -> Nat -> Nat -> Bytes -> Bytes
  keystream-xor k0 k1 nonce no counter input =
    let n = bytes-len input in
    let out = bytes-new n in
    let row3 = counter-row counter nonce no in
    let done = (if 64 <= n then
        let lim = n - 64 in
        xor-blocks-fast sigma-row k0 k1 row3 input out lim 0
      else if 0 < n then chacha-xor-tail 10 sigma-row k0 k1 row3 sigma-row k0 k1 row3 input out 0
      else ()) in
    out

  -- | Process all full 64-byte blocks with unboxed I64 offsets, then one final partial block if needed.
  xor-blocks-fast :: using (lim + 64 <= bytes-len input, lim + 64 <= bytes-len out) => U128 -> U128 -> U128 -> U128 -> (input :: Bytes) -> (out :: Bytes) -> (lim :: Nat) -> I64 -> Unit
  xor-blocks-fast r0 k0 k1 row3 input out lim o =
    if 0 <= o then
      let no = nat-from-i64 o in
      if no <= lim then
        let done = chacha-xor-full 10 r0 k0 k1 row3 r0 k0 k1 row3 input out no in
        xor-blocks-fast r0 k0 k1 (bump row3) input out lim (wrapping-add-i64 o 64)
      else if no < bytes-len input then
        chacha-xor-tail 10 r0 k0 k1 row3 r0 k0 k1 row3 input out no
      else ()
    else ()

  -- | Run remaining ChaCha20 double-rounds on four <4 x i32> rows and XOR a complete 64-byte block into out.
  chacha-xor-full :: using (o + 64 <= bytes-len input, o + 64 <= bytes-len out) => I64 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> (input :: Bytes) -> (out :: Bytes) -> (o :: Nat) -> Unit
  chacha-xor-full rem i0 i1 i2 i3 a b c d input out o =
    if eq-i64 rem 0 then
      let s0 = simd-u32x4-add a i0 in
      let s1 = simd-u32x4-add b i1 in
      let s2 = simd-u32x4-add c i2 in
      let s3 = simd-u32x4-add d i3 in
      let w0 = bytes-store-u128 out o (bit-xor-u128 (bytes-load-u128 input o) s0) in
      let w1 = bytes-store-u128 out (o + 16) (bit-xor-u128 (bytes-load-u128 input (o + 16)) s1) in
      let w2 = bytes-store-u128 out (o + 32) (bit-xor-u128 (bytes-load-u128 input (o + 32)) s2) in
      bytes-store-u128 out (o + 48) (bit-xor-u128 (bytes-load-u128 input (o + 48)) s3)
    else
      -- Column round
      let a1 = simd-u32x4-add a b in
      let d1 = simd-u32x4-rotl (bit-xor-u128 d a1) 16 in
      let c1 = simd-u32x4-add c d1 in
      let b1 = simd-u32x4-rotl (bit-xor-u128 b c1) 12 in
      let a2 = simd-u32x4-add a1 b1 in
      let d2 = simd-u32x4-rotl (bit-xor-u128 d1 a2) 8 in
      let c2 = simd-u32x4-add c1 d2 in
      let b2 = simd-u32x4-rotl (bit-xor-u128 b1 c2) 7 in
      -- Rotate rows 1, 2, 3 left by 1, 2, 3 lanes for diagonal round
      let b3 = rotate-left-u128 b2 96 in
      let c3 = rotate-left-u128 c2 64 in
      let d3 = rotate-left-u128 d2 32 in
      -- Diagonal round
      let a4 = simd-u32x4-add a2 b3 in
      let d4 = simd-u32x4-rotl (bit-xor-u128 d3 a4) 16 in
      let c4 = simd-u32x4-add c3 d4 in
      let b4 = simd-u32x4-rotl (bit-xor-u128 b3 c4) 12 in
      let a5 = simd-u32x4-add a4 b4 in
      let d5 = simd-u32x4-rotl (bit-xor-u128 d4 a5) 8 in
      let c5 = simd-u32x4-add c4 d5 in
      let b5 = simd-u32x4-rotl (bit-xor-u128 b4 c5) 7 in
      -- Un-rotate rows 1, 2, 3 back
      let b6 = rotate-left-u128 b5 32 in
      let c6 = rotate-left-u128 c5 64 in
      let d6 = rotate-left-u128 d5 96 in
      chacha-xor-full (wrapping-sub-i64 rem 1) i0 i1 i2 i3 a5 b6 c6 d6 input out o

  -- | Run remaining ChaCha20 double-rounds and XOR a final partial (1..63 byte) block into out.
  chacha-xor-tail :: I64 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> Bytes -> Bytes -> Nat -> Unit
  chacha-xor-tail rem i0 i1 i2 i3 a b c d input out o =
    if eq-i64 rem 0 then
      let s0 = simd-u32x4-add a i0 in
      let s1 = simd-u32x4-add b i1 in
      let s2 = simd-u32x4-add c i2 in
      let s3 = simd-u32x4-add d i3 in
      let w0 = xor-row input out o s0 in
      let w1 = xor-row input out (o + 16) s1 in
      let w2 = xor-row input out (o + 32) s2 in
      xor-row input out (o + 48) s3
    else
      let a1 = simd-u32x4-add a b in
      let d1 = simd-u32x4-rotl (bit-xor-u128 d a1) 16 in
      let c1 = simd-u32x4-add c d1 in
      let b1 = simd-u32x4-rotl (bit-xor-u128 b c1) 12 in
      let a2 = simd-u32x4-add a1 b1 in
      let d2 = simd-u32x4-rotl (bit-xor-u128 d1 a2) 8 in
      let c2 = simd-u32x4-add c1 d2 in
      let b2 = simd-u32x4-rotl (bit-xor-u128 b1 c2) 7 in
      let b3 = rotate-left-u128 b2 96 in
      let c3 = rotate-left-u128 c2 64 in
      let d3 = rotate-left-u128 d2 32 in
      let a4 = simd-u32x4-add a2 b3 in
      let d4 = simd-u32x4-rotl (bit-xor-u128 d3 a4) 16 in
      let c4 = simd-u32x4-add c3 d4 in
      let b4 = simd-u32x4-rotl (bit-xor-u128 b3 c4) 12 in
      let a5 = simd-u32x4-add a4 b4 in
      let d5 = simd-u32x4-rotl (bit-xor-u128 d4 a5) 8 in
      let c5 = simd-u32x4-add c4 d5 in
      let b5 = simd-u32x4-rotl (bit-xor-u128 b4 c5) 7 in
      let b6 = rotate-left-u128 b5 32 in
      let c6 = rotate-left-u128 c5 64 in
      let d6 = rotate-left-u128 d5 96 in
      chacha-xor-tail (wrapping-sub-i64 rem 1) i0 i1 i2 i3 a5 b6 c6 d6 input out o

  -- | XOR sixteen keystream bytes (fewer at the end) into the output.
  xor-row :: Bytes -> Bytes -> Nat -> U128 -> Unit
  xor-row input out o ks = if o >= bytes-len input then () else put128 out o (bit-xor-u128 (get128 input o) ks) (minus (bytes-len input) o)

  -- | HChaCha20 of a 32-byte key and the first 16 bytes of a nonce: rows 0 and 3 of the state after twenty
  -- rounds without the final addition, as a 32-byte subkey.
  hchacha20 :: Bytes -> Bytes -> Result ChaChaError Bytes
  hchacha20 key nonce =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if bytes-len nonce < 16 then Err (ChaChaNonceSize (bytes-len nonce))
    else Ok (subkey key nonce)

  -- | The HChaCha20 subkey for a valid key and nonce.
  subkey :: Bytes -> Bytes -> Bytes
  subkey key nonce =
    let out = bytes-new 32 in
    let done = hchacha-rounds 10 sigma-row (get128 key 0) (get128 key 16) (get128 nonce 0) out in
    out

  -- | Run remaining ChaCha20 double-rounds for HChaCha20 and store rows 0 and 3 into a 32-byte subkey.
  hchacha-rounds :: using (bytes-len out == 32) => I64 -> U128 -> U128 -> U128 -> U128 -> (out :: Bytes) -> Unit
  hchacha-rounds rem a b c d out =
    if eq-i64 rem 0 then
      let w0 = bytes-store-u128-at out 0 a in
      bytes-store-u128-at out 16 d
    else
      let a1 = simd-u32x4-add a b in
      let d1 = simd-u32x4-rotl (bit-xor-u128 d a1) 16 in
      let c1 = simd-u32x4-add c d1 in
      let b1 = simd-u32x4-rotl (bit-xor-u128 b c1) 12 in
      let a2 = simd-u32x4-add a1 b1 in
      let d2 = simd-u32x4-rotl (bit-xor-u128 d1 a2) 8 in
      let c2 = simd-u32x4-add c1 d2 in
      let b2 = simd-u32x4-rotl (bit-xor-u128 b1 c2) 7 in
      let b3 = rotate-left-u128 b2 96 in
      let c3 = rotate-left-u128 c2 64 in
      let d3 = rotate-left-u128 d2 32 in
      let a4 = simd-u32x4-add a2 b3 in
      let d4 = simd-u32x4-rotl (bit-xor-u128 d3 a4) 16 in
      let c4 = simd-u32x4-add c3 d4 in
      let b4 = simd-u32x4-rotl (bit-xor-u128 b3 c4) 12 in
      let a5 = simd-u32x4-add a4 b4 in
      let d5 = simd-u32x4-rotl (bit-xor-u128 d4 a5) 8 in
      let c5 = simd-u32x4-add c4 d5 in
      let b5 = simd-u32x4-rotl (bit-xor-u128 b4 c5) 7 in
      let b6 = rotate-left-u128 b5 32 in
      let c6 = rotate-left-u128 c5 64 in
      let d6 = rotate-left-u128 d5 96 in
      hchacha-rounds (wrapping-sub-i64 rem 1) a5 b6 c6 d6 out

  -- | XOR with the XChaCha20 keystream of a 32-byte key and 24-byte nonce: ChaCha20 under the HChaCha20 subkey of
  -- the first sixteen nonce bytes, with four zero bytes and the last eight nonce bytes as its nonce.
  xchacha20-xor :: Bytes -> Bytes -> Nat -> Bytes -> Result ChaChaError Bytes
  xchacha20-xor key nonce counter input =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if not (bytes-len nonce == 24) then Err (ChaChaNonceSize (bytes-len nonce))
    else chacha20-xor (subkey key nonce) (short-nonce nonce) counter input

  -- | Four zero bytes then the last eight bytes of an extended nonce.
  short-nonce :: Bytes -> Bytes
  short-nonce nonce = let out = bytes-new 12 in let c = (if bytes-len nonce == 24 then bytes-copy-range out nonce 4 16 8 else ()) in out

  -- ---------------------------------------------------------------------
  -- Poly1305.
  -- ---------------------------------------------------------------------

  -- | The Poly1305 tag of a message under a 32-byte one-time key.
  poly1305-mac :: Bytes -> Bytes -> Result ChaChaError Bytes
  poly1305-mac key message =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else Ok (bytes-of128 (mac key message))

  -- | Whether a tag authenticates a message under a one-time key, compared in constant time.
  poly1305-verify :: Bytes -> Bytes -> Bytes -> Bool
  poly1305-verify key message tag = bytes-len key == 32 && bytes-len tag == 16 && constant-bytes-equal (bytes-of128 (mac key message)) tag

  -- | Clamped low 64-bit limb of Poly1305 r (mask 0x0ffffffc0fffffff).
  clamp-r0 :: U128 -> U64
  clamp-r0 rk = bit-and-u64 (wrapping-u128-to-u64 rk) 1152921487695413247

  -- | Clamped high 64-bit limb of Poly1305 r (mask 0x0ffffffc0ffffffc, always divisible by 4).
  clamp-r1 :: U128 -> U64
  clamp-r1 rk = bit-and-u64 (wrapping-u128-to-u64 (wrapping-shr-u128 rk 64)) 1152921487695413244

  -- | Precomputed 5 * (r1 / 4) for radix-2^64 reduction modulo 2^130 - 5.
  poly-s1 :: U64 -> U64
  poly-s1 r1 = wrapping-add-u64 r1 (wrapping-shr-u64 r1 2)

  -- | The tag of a message: full sixteen-byte blocks with the 2^128 bit, the final partial block with a 0x01 after it.
  mac :: Bytes -> Bytes -> U128
  mac key message =
    let rk = get128 key 0 in
    let r0 = clamp-r0 rk in
    let r1 = clamp-r1 rk in
    let s1 = poly-s1 r1 in
    let s = get128 key 16 in
    let n = bytes-len message in
    if 16 <= n then
      let lim = n - 16 in
      absorb-mac-blocks r0 r1 s1 s message lim 0 0 0 0
    else absorb-mac-tail r0 r1 s1 s message 0 0 0 0

  -- | Absorb all complete 16-byte blocks with unboxed I64 offsets, then finalize with any partial tail.
  absorb-mac-blocks :: using (lim + 16 <= bytes-len message) => U64 -> U64 -> U64 -> U128 -> (message :: Bytes) -> (lim :: Nat) -> I64 -> U64 -> U64 -> U64 -> U128
  absorb-mac-blocks r0 r1 s1 s message lim o h0 h1 h2 =
    if 0 <= o then
      let no = nat-from-i64 o in
      if no <= lim then
        let m = bytes-load-u128-at message o in
        let m0 = wrapping-u128-to-u64 m in
        let m1 = wrapping-u128-to-u64 (wrapping-shr-u128 m 64) in
        let t0 = wrapping-add-u128 (u64-to-u128 h0) (u64-to-u128 m0) in
        let a0 = wrapping-u128-to-u64 t0 in
        let t1 = wrapping-add-u128 (wrapping-add-u128 (u64-to-u128 h1) (u64-to-u128 m1)) (wrapping-shr-u128 t0 64) in
        let a1 = wrapping-u128-to-u64 t1 in
        let a2 = wrapping-add-u64 (wrapping-add-u64 h2 1) (wrapping-u128-to-u64 (wrapping-shr-u128 t1 64)) in
        let ua0 = u64-to-u128 a0 in
        let ua1 = u64-to-u128 a1 in
        let d0 = wrapping-add-u128 (wrapping-mul-u128 ua0 (u64-to-u128 r0)) (wrapping-mul-u128 ua1 (u64-to-u128 s1)) in
        let p0 = wrapping-u128-to-u64 d0 in
        let d1a = wrapping-add-u128 (wrapping-mul-u128 ua0 (u64-to-u128 r1)) (wrapping-mul-u128 ua1 (u64-to-u128 r0)) in
        let d1b = wrapping-add-u128 (u64-to-u128 (wrapping-mul-u64 a2 s1)) (wrapping-shr-u128 d0 64) in
        let d1 = wrapping-add-u128 d1a d1b in
        let p1 = wrapping-u128-to-u64 d1 in
        let d2 = wrapping-add-u64 (wrapping-mul-u64 a2 r0) (wrapping-u128-to-u64 (wrapping-shr-u128 d1 64)) in
        let h2lo = bit-and-u64 d2 3 in
        let c = wrapping-shr-u64 d2 2 in
        let fivec = wrapping-add-u64 c (wrapping-shl-u64 c 2) in
        let u0 = wrapping-add-u128 (u64-to-u128 p0) (u64-to-u128 fivec) in
        let nh0 = wrapping-u128-to-u64 u0 in
        let u1 = wrapping-add-u128 (u64-to-u128 p1) (wrapping-shr-u128 u0 64) in
        let nh1 = wrapping-u128-to-u64 u1 in
        let nh2 = wrapping-add-u64 h2lo (wrapping-u128-to-u64 (wrapping-shr-u128 u1 64)) in
        absorb-mac-blocks r0 r1 s1 s message lim (wrapping-add-i64 o 16) nh0 nh1 nh2
      else if no < bytes-len message then
        absorb-mac-tail r0 r1 s1 s message no h0 h1 h2
      else poly-finish h0 h1 h2 s
    else poly-finish h0 h1 h2 s

  -- | Absorb a trailing 0..15 byte Poly1305 message tail with 0x01 sentinel and finalize.
  absorb-mac-tail :: U64 -> U64 -> U64 -> U128 -> Bytes -> Nat -> U64 -> U64 -> U64 -> U128
  absorb-mac-tail r0 r1 s1 s message o h0 h1 h2 =
    if o >= bytes-len message then poly-finish h0 h1 h2 s
    else
      let n = minus (bytes-len message) o in
      let m = bit-or-u128 (get128 message o) (wrapping-shl-u128 (u64-to-u128 1) (word (8 * n))) in
      let m0 = wrapping-u128-to-u64 m in
      let m1 = wrapping-u128-to-u64 (wrapping-shr-u128 m 64) in
      case poly-step r0 r1 s1 h0 h1 h2 m0 m1 0 of
        PolyAcc nh0 nh1 nh2 -> poly-finish nh0 nh1 nh2 s

  -- | Absorb one 16-byte block (m0, m1, hibit) into (h0, h1, h2), reducing once modulo 2^130 - 5.
  poly-step :: U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> PolyAcc
  poly-step r0 r1 s1 h0 h1 h2 m0 m1 hibit =
    let t0 = wrapping-add-u128 (u64-to-u128 h0) (u64-to-u128 m0) in
    let a0 = wrapping-u128-to-u64 t0 in
    let t1 = wrapping-add-u128 (wrapping-add-u128 (u64-to-u128 h1) (u64-to-u128 m1)) (wrapping-shr-u128 t0 64) in
    let a1 = wrapping-u128-to-u64 t1 in
    let a2 = wrapping-add-u64 (wrapping-add-u64 h2 hibit) (wrapping-u128-to-u64 (wrapping-shr-u128 t1 64)) in
    let ua0 = u64-to-u128 a0 in
    let ua1 = u64-to-u128 a1 in
    let d0 = wrapping-add-u128 (wrapping-mul-u128 ua0 (u64-to-u128 r0)) (wrapping-mul-u128 ua1 (u64-to-u128 s1)) in
    let p0 = wrapping-u128-to-u64 d0 in
    let d1a = wrapping-add-u128 (wrapping-mul-u128 ua0 (u64-to-u128 r1)) (wrapping-mul-u128 ua1 (u64-to-u128 r0)) in
    let d1b = wrapping-add-u128 (u64-to-u128 (wrapping-mul-u64 a2 s1)) (wrapping-shr-u128 d0 64) in
    let d1 = wrapping-add-u128 d1a d1b in
    let p1 = wrapping-u128-to-u64 d1 in
    let d2 = wrapping-add-u64 (wrapping-mul-u64 a2 r0) (wrapping-u128-to-u64 (wrapping-shr-u128 d1 64)) in
    let h2lo = bit-and-u64 d2 3 in
    let c = wrapping-shr-u64 d2 2 in
    let fivec = wrapping-add-u64 c (wrapping-shl-u64 c 2) in
    let u0 = wrapping-add-u128 (u64-to-u128 p0) (u64-to-u128 fivec) in
    let nh0 = wrapping-u128-to-u64 u0 in
    let u1 = wrapping-add-u128 (u64-to-u128 p1) (wrapping-shr-u128 u0 64) in
    let nh1 = wrapping-u128-to-u64 u1 in
    let nh2 = wrapping-add-u64 h2lo (wrapping-u128-to-u64 (wrapping-shr-u128 u1 64)) in
    PolyAcc nh0 nh1 nh2

  -- | Absorb a buffer as zero-padded sixteen-byte blocks, all with the 2^128 bit.
  absorb-padded :: U64 -> U64 -> U64 -> Bytes -> U64 -> U64 -> U64 -> PolyAcc
  absorb-padded r0 r1 s1 msg h0 h1 h2 =
    let n = bytes-len msg in
    if 16 <= n then
      let lim = n - 16 in
      absorb-padded-blocks r0 r1 s1 msg lim 0 h0 h1 h2
    else if 0 < n then
      let m = get128 msg 0 in
      poly-step r0 r1 s1 h0 h1 h2 (wrapping-u128-to-u64 m) (wrapping-u128-to-u64 (wrapping-shr-u128 m 64)) 1
    else PolyAcc h0 h1 h2

  -- | Absorb complete 16-byte blocks with unboxed I64 offsets, then one zero-padded tail if present.
  absorb-padded-blocks :: using (lim + 16 <= bytes-len msg) => U64 -> U64 -> U64 -> (msg :: Bytes) -> (lim :: Nat) -> I64 -> U64 -> U64 -> U64 -> PolyAcc
  absorb-padded-blocks r0 r1 s1 msg lim o h0 h1 h2 =
    if 0 <= o then
      let no = nat-from-i64 o in
      if no <= lim then
        let m = bytes-load-u128-at msg o in
        let m0 = wrapping-u128-to-u64 m in
        let m1 = wrapping-u128-to-u64 (wrapping-shr-u128 m 64) in
        let t0 = wrapping-add-u128 (u64-to-u128 h0) (u64-to-u128 m0) in
        let a0 = wrapping-u128-to-u64 t0 in
        let t1 = wrapping-add-u128 (wrapping-add-u128 (u64-to-u128 h1) (u64-to-u128 m1)) (wrapping-shr-u128 t0 64) in
        let a1 = wrapping-u128-to-u64 t1 in
        let a2 = wrapping-add-u64 (wrapping-add-u64 h2 1) (wrapping-u128-to-u64 (wrapping-shr-u128 t1 64)) in
        let ua0 = u64-to-u128 a0 in
        let ua1 = u64-to-u128 a1 in
        let d0 = wrapping-add-u128 (wrapping-mul-u128 ua0 (u64-to-u128 r0)) (wrapping-mul-u128 ua1 (u64-to-u128 s1)) in
        let p0 = wrapping-u128-to-u64 d0 in
        let d1a = wrapping-add-u128 (wrapping-mul-u128 ua0 (u64-to-u128 r1)) (wrapping-mul-u128 ua1 (u64-to-u128 r0)) in
        let d1b = wrapping-add-u128 (u64-to-u128 (wrapping-mul-u64 a2 s1)) (wrapping-shr-u128 d0 64) in
        let d1 = wrapping-add-u128 d1a d1b in
        let p1 = wrapping-u128-to-u64 d1 in
        let d2 = wrapping-add-u64 (wrapping-mul-u64 a2 r0) (wrapping-u128-to-u64 (wrapping-shr-u128 d1 64)) in
        let h2lo = bit-and-u64 d2 3 in
        let c = wrapping-shr-u64 d2 2 in
        let fivec = wrapping-add-u64 c (wrapping-shl-u64 c 2) in
        let u0 = wrapping-add-u128 (u64-to-u128 p0) (u64-to-u128 fivec) in
        let nh0 = wrapping-u128-to-u64 u0 in
        let u1 = wrapping-add-u128 (u64-to-u128 p1) (wrapping-shr-u128 u0 64) in
        let nh1 = wrapping-u128-to-u64 u1 in
        let nh2 = wrapping-add-u64 h2lo (wrapping-u128-to-u64 (wrapping-shr-u128 u1 64)) in
        absorb-padded-blocks r0 r1 s1 msg lim (wrapping-add-i64 o 16) nh0 nh1 nh2
      else if no < bytes-len msg then
        let m = get128 msg no in
        poly-step r0 r1 s1 h0 h1 h2 (wrapping-u128-to-u64 m) (wrapping-u128-to-u64 (wrapping-shr-u128 m 64)) 1
      else PolyAcc h0 h1 h2
    else PolyAcc h0 h1 h2

  -- | Fully reduce (h0, h1, h2) modulo 2^130 - 5 in constant time and add s modulo 2^128.
  poly-finish :: U64 -> U64 -> U64 -> U128 -> U128
  poly-finish h0 h1 h2 s =
    let c = wrapping-shr-u64 h2 2 in
    let f2lo = bit-and-u64 h2 3 in
    let fivec = wrapping-add-u64 c (wrapping-shl-u64 c 2) in
    let t0 = wrapping-add-u128 (u64-to-u128 h0) (u64-to-u128 fivec) in
    let f0 = wrapping-u128-to-u64 t0 in
    let t1 = wrapping-add-u128 (u64-to-u128 h1) (wrapping-shr-u128 t0 64) in
    let f1 = wrapping-u128-to-u64 t1 in
    let f2 = wrapping-add-u64 f2lo (wrapping-u128-to-u64 (wrapping-shr-u128 t1 64)) in
    let g0t = wrapping-add-u128 (u64-to-u128 f0) (u64-to-u128 5) in
    let g0 = wrapping-u128-to-u64 g0t in
    let g1t = wrapping-add-u128 (u64-to-u128 f1) (wrapping-shr-u128 g0t 64) in
    let g1 = wrapping-u128-to-u64 g1t in
    let g2 = wrapping-add-u64 f2 (wrapping-u128-to-u64 (wrapping-shr-u128 g1t 64)) in
    let mask = wrapping-neg-u64 (wrapping-shr-u64 g2 2) in
    let nmask = bit-not-u64 mask in
    let o0 = bit-or-u64 (bit-and-u64 g0 mask) (bit-and-u64 f0 nmask) in
    let o1 = bit-or-u64 (bit-and-u64 g1 mask) (bit-and-u64 f1 nmask) in
    wrapping-add-u128 (simd-u64x2-pack o0 o1) s

  -- ---------------------------------------------------------------------
  -- ChaCha20-Poly1305.
  -- ---------------------------------------------------------------------

  -- | The AEAD tag: Poly1305 under the first 32 bytes of keystream block 0 over the padded additional data, the
  -- padded ciphertext and their 64-bit little-endian lengths.
  aead-tag :: U128 -> U128 -> Bytes -> Nat -> Bytes -> Bytes -> U128
  aead-tag k0 k1 nonce no aad ct =
    let row0 = counter-row 0 nonce no in
    aead-otk-rounds 10 sigma-row k0 k1 row0 sigma-row k0 k1 row0 aad ct

  -- | Run remaining ChaCha20 double-rounds for AEAD block 0, derive one-time Poly1305 key (r, s), and compute tag.
  aead-otk-rounds :: I64 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> U128 -> Bytes -> Bytes -> U128
  aead-otk-rounds rem i0 i1 i2 i3 a b c d aad ct =
    if eq-i64 rem 0 then
      let rk = simd-u32x4-add a i0 in
      let s = simd-u32x4-add b i1 in
      let r0 = clamp-r0 rk in
      let r1 = clamp-r1 rk in
      let s1 = poly-s1 r1 in
      case absorb-padded r0 r1 s1 aad 0 0 0 of
        PolyAcc h0 h1 h2 -> case absorb-padded r0 r1 s1 ct h0 h1 h2 of
          PolyAcc l0 l1 l2 -> case poly-step r0 r1 s1 l0 l1 l2 (u64-of (bytes-len aad)) (u64-of (bytes-len ct)) 1 of
            PolyAcc f0 f1 f2 -> poly-finish f0 f1 f2 s
    else
      let a1 = simd-u32x4-add a b in
      let d1 = simd-u32x4-rotl (bit-xor-u128 d a1) 16 in
      let c1 = simd-u32x4-add c d1 in
      let b1 = simd-u32x4-rotl (bit-xor-u128 b c1) 12 in
      let a2 = simd-u32x4-add a1 b1 in
      let d2 = simd-u32x4-rotl (bit-xor-u128 d1 a2) 8 in
      let c2 = simd-u32x4-add c1 d2 in
      let b2 = simd-u32x4-rotl (bit-xor-u128 b1 c2) 7 in
      let b3 = rotate-left-u128 b2 96 in
      let c3 = rotate-left-u128 c2 64 in
      let d3 = rotate-left-u128 d2 32 in
      let a4 = simd-u32x4-add a2 b3 in
      let d4 = simd-u32x4-rotl (bit-xor-u128 d3 a4) 16 in
      let c4 = simd-u32x4-add c3 d4 in
      let b4 = simd-u32x4-rotl (bit-xor-u128 b3 c4) 12 in
      let a5 = simd-u32x4-add a4 b4 in
      let d5 = simd-u32x4-rotl (bit-xor-u128 d4 a5) 8 in
      let c5 = simd-u32x4-add c4 d5 in
      let b5 = simd-u32x4-rotl (bit-xor-u128 b4 c5) 7 in
      let b6 = rotate-left-u128 b5 32 in
      let c6 = rotate-left-u128 c5 64 in
      let d6 = rotate-left-u128 d5 96 in
      aead-otk-rounds (wrapping-sub-i64 rem 1) i0 i1 i2 i3 a5 b6 c6 d6 aad ct

  -- | A number below 2^63 as a 64-bit word (zero otherwise; larger lengths are refused before this is reached).
  u64-of :: Nat -> U64
  u64-of n = if n < 9223372036854775808 then wrapping-i64-to-u64 (nat-to-i64 n) else 0

  -- | Encrypt and authenticate: the ciphertext followed by the sixteen-byte tag.
  chacha20poly1305-seal :: Bytes -> Bytes -> Bytes -> Bytes -> Result ChaChaError Bytes
  chacha20poly1305-seal key nonce plaintext aad =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if not (bytes-len nonce == 12) then Err (ChaChaNonceSize (bytes-len nonce))
    else if bytes-len plaintext > 274877906880 then Err ChaChaTooLarge
    else Ok (seal-with (get128 key 0) (get128 key 16) nonce 0 plaintext aad)

  -- | Seal under key halves and the nonce at an offset.
  seal-with :: U128 -> U128 -> Bytes -> Nat -> Bytes -> Bytes -> Bytes
  seal-with k0 k1 nonce no plaintext aad =
    let ct = keystream-xor k0 k1 nonce no 1 plaintext in
    let out = bytes-new (bytes-len ct + 16) in
    let c = if bytes-len ct <= bytes-len out then bytes-copy-range out ct 0 0 (bytes-len ct) else () in
    let t = put128 out (bytes-len ct) (aead-tag k0 k1 nonce no aad ct) 16 in
    out

  -- | Verify and decrypt a sealed message; nothing is decrypted unless the tag verifies.
  chacha20poly1305-open :: Bytes -> Bytes -> Bytes -> Bytes -> Result ChaChaError Bytes
  chacha20poly1305-open key nonce sealed aad =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if not (bytes-len nonce == 12) then Err (ChaChaNonceSize (bytes-len nonce))
    else if bytes-len sealed < 16 then Err ChaChaAuthentication
    else open-with (get128 key 0) (get128 key 16) nonce 0 sealed aad

  -- | Open under key halves and the nonce at an offset.
  open-with :: U128 -> U128 -> Bytes -> Nat -> Bytes -> Bytes -> Result ChaChaError Bytes
  open-with k0 k1 nonce no sealed aad =
    let n = minus (bytes-len sealed) 16 in
    let ct = slice sealed 0 n in
    if constant-bytes-equal (bytes-of128 (aead-tag k0 k1 nonce no aad ct)) (slice sealed n 16) then Ok (keystream-xor k0 k1 nonce no 1 ct)
    else Err ChaChaAuthentication

  -- | XChaCha20-Poly1305 sealing with a 24-byte nonce.
  xchacha20poly1305-seal :: Bytes -> Bytes -> Bytes -> Bytes -> Result ChaChaError Bytes
  xchacha20poly1305-seal key nonce plaintext aad =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if not (bytes-len nonce == 24) then Err (ChaChaNonceSize (bytes-len nonce))
    else chacha20poly1305-seal (subkey key nonce) (short-nonce nonce) plaintext aad

  -- | XChaCha20-Poly1305 opening with a 24-byte nonce.
  xchacha20poly1305-open :: Bytes -> Bytes -> Bytes -> Bytes -> Result ChaChaError Bytes
  xchacha20poly1305-open key nonce sealed aad =
    if not (bytes-len key == 32) then Err (ChaChaKeySize (bytes-len key))
    else if not (bytes-len nonce == 24) then Err (ChaChaNonceSize (bytes-len nonce))
    else chacha20poly1305-open (subkey key nonce) (short-nonce nonce) sealed aad
