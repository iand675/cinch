-- | SHA-1 digests, persistent streaming states and binary checkpoints.
-- SHA-1 is broken for collision resistance: use it only to interoperate with
-- existing formats and protocols, never for new signatures or integrity checks.
-- Compression expands four schedule words per step in portable 128-bit SIMD lanes
-- and evaluates all eighty ordered rounds in registers with native rotates.
-- Updates read checked 64-byte blocks directly from the input buffer and copy
-- pending tails into private storage. Retaining a state branches the computation.
-- Digest and checkpoint words use network order; byte counts wrap at 64 bits.
module Text.Sha1 where

  import Data.Bytes
  import Data.Machine
  import Data.Nat
  import Data.Result
  import Data.String
  import Data.Wide (bit-or-u128, bit-xor-u128, simd-u32x4-rotl, simd-u64x2-pack, u32-to-u128, u64-to-u128, wrapping-shl-u128, wrapping-shr-u128, wrapping-u128-to-u32, wrapping-u128-to-u64)
  import Text.Binary

  export sha1-size, sha1-block-size, sha1-sum
  export Sha1State, sha1-state, sha1-state-update, sha1-state-reset, sha1-state-size, sha1-state-block-size
  export sha1-state-sum, sha1-state-append, sha1-state-save, sha1-state-append-save, sha1-state-load
  export Sha1StateError, InvalidSha1StateIdentifier, InvalidSha1StateSize, sha1-state-error-message

  -- | Digest size in bytes, always 20.
  sha1-size :: Nat
  sha1-size = 20

  -- | Compression block size in bytes, always 64.
  sha1-block-size :: Nat
  sha1-block-size = 64

  -- | Private chaining value: five unsigned 32-bit words a through e.
  data Sha1Words where
    -- | The working or chaining words in round order.
    Words160 :: U32 -> U32 -> U32 -> U32 -> U32 -> Sha1Words

  -- | An immutable wrapping byte count, copied partial block and chaining value.
  data Sha1State where
    -- | Private pending bytes have length count modulo 64, always below one full block.
    State160 :: U64 -> Bytes -> Sha1Words -> Sha1State

  -- | The standard initial chaining value.
  initial-words :: Sha1Words
  initial-words = Words160 1732584193 4023233417 2562383102 271733878 3285377520

  -- | Initial state with no pending bytes.
  sha1-state :: Sha1State
  sha1-state = State160 0 (bytes-new 0) initial-words

  -- | Compute a fresh 20-byte network-order digest of a complete input.
  sha1-sum :: Bytes -> Bytes
  sha1-sum input =
    let n = bytes-len input in
    let count = wrapping-i64-to-u64 (nat-to-i64 n) in
    let words = blocks-from initial-words input 0 in
    let tail = nat-rem n 64 in
    if tail <= n then render (finish-interval count input (n - tail) tail words) else render words

  -- | Consume a complete chunk without mutating any previous state or retaining the input buffer.
  -- Empty chunks preserve the supplied state. Counts use explicit unsigned 64-bit wrapping.
  sha1-state-update :: Sha1State -> Bytes -> Sha1State
  sha1-state-update state input = if bytes-len input == 0 then state else case state of
    State160 count pending words ->
      let total = wrapping-add-u64 count (wrapping-i64-to-u64 (nat-to-i64 (bytes-len input))) in
      let have = bytes-len pending in
      if have < 64 then
        if have == 0 then process-from total words input 0
        else
          let needed = 64 - have in
          if bytes-len input < needed then State160 total (join pending input) words
          else
            let block = bytes-new 64 in
            let first = bytes-copy-range block pending 0 0 have in
            let last = bytes-copy-range block input have 0 needed in
            let next = blocks-from words block 0 in
            process-from total next input needed
      else state

  -- | Process every complete suffix block and retain only a fresh final partial block.
  process-from :: U64 -> Sha1Words -> Bytes -> Nat -> Sha1State
  process-from total words input start =
    if start <= bytes-len input then
      let remaining = bytes-len input - start in
      let next = blocks-from words input (nat-to-i64 start) in
      let tail = nat-rem remaining 64 in
      if tail <= bytes-len input then State160 total (part input (bytes-len input - tail) tail) next
      else State160 total (bytes-new 0) next
    else State160 total (bytes-new 0) words

  -- | Reverse the bytes of a word so an explicit little-endian store writes network order.
  wire-word :: U32 -> U32
  wire-word word = swap-bytes-u32 word

  -- | Copy an exact interval into fresh storage without retaining a mutable source alias.
  part :: Bytes -> Nat -> Nat -> Bytes
  part input start count = if start + count <= bytes-len input then
    let out = bytes-new count in let copied = bytes-copy-range out input 0 start count in out
    else bytes-new 0

  -- | Concatenate two intervals in fresh storage, preserving both inputs.
  join :: Bytes -> Bytes -> Bytes
  join first last =
    let n = bytes-len first in let out = bytes-new (n + bytes-len last) in
    let a = bytes-copy-range out first 0 0 n in
    let b = bytes-copy-range out last n 0 (bytes-len last) in out

  -- | Return the initial state, preserving the supplied state.
  sha1-state-reset :: Sha1State -> Sha1State
  sha1-state-reset state = sha1-state

  -- | Digest size in bytes, always 20.
  sha1-state-size :: Sha1State -> Nat
  sha1-state-size state = sha1-size

  -- | Compression block size in bytes, always 64.
  sha1-state-block-size :: Sha1State -> Nat
  sha1-state-block-size state = sha1-block-size

  -- | Choose one or two complete finalization blocks: the 0x80 mark and 8 length bytes must fit.
  padding-size :: Nat -> InRange 64 128 Nat
  padding-size pending = if pending < 56 then 64 else 128

  -- | Pad an exact interval of fewer than 64 bytes and append the wrapping network-order bit count.
  finish-interval :: U64 -> Bytes -> Nat -> Nat -> Sha1Words -> Sha1Words
  finish-interval count input start n words =
    if n < 64 && start + n <= bytes-len input then
      let size = padding-size n in let padding = bytes-new size in
      let copied = bytes-copy-range padding input 0 start n in
      let mark = bytes-set padding n 128 in
      let length = binary-put-u64 BigEndian padding (size - 8) (wrapping-shl-u64 count 3) in
      blocks-from words padding 0
    else words

  -- | Store one network-order word only within a checked complete destination interval.
  put-word :: Bytes -> Nat -> U32 -> Unit
  put-word out pos word = if pos + 4 <= bytes-len out then bytes-store-le32 out pos (wire-word word) else ()

  -- | Render all five words into an existing complete network-order interval.
  put-words :: Bytes -> Nat -> Sha1Words -> Unit
  put-words out pos words = case words of
    Words160 a b c d e ->
      let wa = put-word out pos a in let wb = put-word out (pos + 4) b in
      let wc = put-word out (pos + 8) c in let wd = put-word out (pos + 12) d in put-word out (pos + 16) e

  -- | Render finalized words as a fresh 20-byte digest.
  render :: Sha1Words -> Bytes
  render words = let out = bytes-new 20 in let written = put-words out 0 words in out

  -- | Return the network-order digest in fresh storage without changing the state.
  sha1-state-sum :: Sha1State -> Bytes
  sha1-state-sum state = case state of
    State160 count pending words -> render (finish-interval count pending 0 (bytes-len pending) words)

  -- | Append the digest to a copied prefix, preserving the state and caller buffer.
  sha1-state-append :: Bytes -> Sha1State -> Bytes
  sha1-state-append prefix state = join prefix (sha1-state-sum state)

  -- | Return 96 checkpoint bytes: ASCII sha, version byte 1, chaining words, zero-padded tail and count.
  -- Every numeric field uses network order.
  sha1-state-save :: Sha1State -> Bytes
  sha1-state-save state = case state of
    State160 count pending words ->
      let out = bytes-new 96 in
      let h0 = bytes-set out 0 115 in let h1 = bytes-set out 1 104 in
      let h2 = bytes-set out 2 97 in let h3 = bytes-set out 3 1 in
      let w = put-words out 4 words in
      let p = if bytes-len pending < 64 then bytes-copy-range out pending 24 0 (bytes-len pending) else () in
      let n = binary-put-u64 BigEndian out 88 count in out

  -- | Append the complete checkpoint to a copied prefix without mutating either input.
  sha1-state-append-save :: Bytes -> Sha1State -> Bytes
  sha1-state-append-save prefix state = join prefix (sha1-state-save state)

  -- | A checkpoint's identifier or exact byte length is invalid.
  data Sha1StateError where
    -- | The four-byte sha/version identifier is absent or does not match.
    InvalidSha1StateIdentifier :: Sha1StateError
    -- | Expected complete checkpoint length and actual input length, in that order.
    InvalidSha1StateSize :: Nat -> Nat -> Sha1StateError

  -- | Render identifier errors or complete required and actual checkpoint byte lengths.
  sha1-state-error-message :: Sha1StateError -> String
  sha1-state-error-message error = case error of
    InvalidSha1StateIdentifier -> "SHA-1 state identifier is invalid"
    InvalidSha1StateSize expected actual -> string-concat "SHA-1 state requires " (string-concat (nat-to-string expected) (string-concat " bytes; received " (nat-to-string actual)))

  -- | Read one network-order chaining word after checking its complete interval.
  read-word :: Bytes -> Nat -> U32
  read-word input pos = if pos + 4 <= bytes-len input then wire-word (bytes-load-le32 input pos) else 0

  -- | Restore every chaining and count bit, copying only the live partial block into private storage.
  -- Identifier checks precede exact-size checks; unused tail bytes are ignored and saved as zeros.
  sha1-state-load :: Bytes -> Result Sha1StateError Sha1State
  sha1-state-load input =
    if 4 <= bytes-len input then
      if bytes-get input 0 == 115 && bytes-get input 1 == 104 && bytes-get input 2 == 97 && bytes-get input 3 == 1 then
        if bytes-len input == 96 then case binary-read-u64 BigEndian input 88 of
          Err error -> Err (InvalidSha1StateSize 96 (bytes-len input))
          Ok count ->
            let n = u8-to-nat (wrapping-u64-to-u8 (bit-and-u64 count 63)) in
            let words = Words160 (read-word input 4) (read-word input 8) (read-word input 12) (read-word input 16) (read-word input 20) in
            Ok (State160 count (part input 24 n) words)
        else Err (InvalidSha1StateSize 96 (bytes-len input))
      else Err InvalidSha1StateIdentifier
    else Err InvalidSha1StateIdentifier

  -- | Swap bytes inside each packed 32-bit lane of a little-endian U64 pair.
  swap-u32-pair :: U64 -> U64
  swap-u32-pair pair = rotate-left-u64 (swap-bytes-u64 pair) 32

  -- | Load sixteen input bytes as four network-order U32 lanes packed into one U128.
  load-group :: Bytes -> I64 -> U128
  load-group input offset =
    let n = bytes-len-i64 input in
    if 0 <= offset && 16 <= n then
      if nat-from-i64 offset <= nat-from-i64 n - 16 then
        let raw = bytes-load-u128-at input offset in
        let lo = swap-u32-pair (wrapping-u128-to-u64 raw) in
        let hi = swap-u32-pair (wrapping-u128-to-u64 (wrapping-shr-u128 raw 64)) in
        simd-u64x2-pack lo hi
      else u64-to-u128 0
    else u64-to-u128 0

  -- | Select schedule lane 0 from a packed four-word SIMD group.
  lane0 :: U128 -> U32
  lane0 group = wrapping-u128-to-u32 group

  -- | Select schedule lane 1 from a packed four-word SIMD group.
  lane1 :: U128 -> U32
  lane1 group = wrapping-u128-to-u32 (wrapping-shr-u128 group 32)

  -- | Select schedule lane 2 from a packed four-word SIMD group.
  lane2 :: U128 -> U32
  lane2 group = wrapping-u128-to-u32 (wrapping-shr-u128 group 64)

  -- | Select schedule lane 3 from a packed four-word SIMD group.
  lane3 :: U128 -> U32
  lane3 group = wrapping-u128-to-u32 (wrapping-shr-u128 group 96)

  -- | Expand four SHA-1 schedule words in portable 128-bit SIMD lanes.
  -- Lane 3 depends on lane 0; rotating left by one distributes over XOR, so one scalar rotate completes lane 3.
  sha1-schedule :: U128 -> U128 -> U128 -> U128 -> U128
  sha1-schedule g0 g1 g2 g3 =
    let w3 = wrapping-shr-u128 g3 32 in
    let w14 = bit-or-u128 (wrapping-shr-u128 g0 64) (wrapping-shl-u128 g1 64) in
    let x = bit-xor-u128 (bit-xor-u128 (bit-xor-u128 w3 g2) w14) g0 in
    let r = simd-u32x4-rotl x 1 in
    let fix = wrapping-shl-u128 (u32-to-u128 (rotate-left-u32 (wrapping-u128-to-u32 r) 1)) 96 in
    bit-xor-u128 r fix

  -- | Combine rotl(a, 5) with the round nonlinear value, e, message word and constant.
  sha1-step-a :: U32 -> U32 -> U32 -> U32 -> U32 -> U32
  sha1-step-a a f e w k =
    wrapping-add-u32 (wrapping-add-u32 (wrapping-add-u32 (wrapping-add-u32 (rotate-left-u32 a 5) f) e) w) k

  -- | SHA-1 rounds 0..19 choice function: (b and c) xor (not b and d).
  fn-choose :: U32 -> U32 -> U32 -> U32
  fn-choose b c d = bit-xor-u32 (bit-and-u32 b c) (bit-and-u32 (bit-not-u32 b) d)

  -- | SHA-1 rounds 20..39 and 60..79 parity function: b xor c xor d.
  fn-parity :: U32 -> U32 -> U32 -> U32
  fn-parity b c d = bit-xor-u32 (bit-xor-u32 b c) d

  -- | SHA-1 rounds 40..59 majority function: (b and c) or (b and d) or (c and d).
  fn-majority :: U32 -> U32 -> U32 -> U32
  fn-majority b c d = bit-or-u32 (bit-or-u32 (bit-and-u32 b c) (bit-and-u32 b d)) (bit-and-u32 c d)

  -- | Compress every complete 64-byte block starting at offset without allocating per block.
  blocks-from :: Sha1Words -> Bytes -> I64 -> Sha1Words
  blocks-from words input offset = case words of
    Words160 h0 h1 h2 h3 h4 ->
      blocks-loop input offset (bytes-len-i64 input) h0 h1 h2 h3 h4

  -- | Outer multi-block compression loop holding all five chaining words unboxed in registers.
  blocks-loop :: Bytes -> I64 -> I64 -> U32 -> U32 -> U32 -> U32 -> U32 -> Sha1Words
  blocks-loop input offset len h0 h1 h2 h3 h4 =
    if 0 <= offset && 64 <= len && offset <= wrapping-sub-i64 len 64 then
      let g0 = load-group input offset in
      let g1 = load-group input (wrapping-add-i64 offset 16) in
      let g2 = load-group input (wrapping-add-i64 offset 32) in
      let g3 = load-group input (wrapping-add-i64 offset 48) in
      sha1-rounds input (wrapping-add-i64 offset 64) len 0
        h0 h1 h2 h3 h4
        h0 h1 h2 h3 h4
        g0 g1 g2 g3
    else Words160 h0 h1 h2 h3 h4

  -- | Inner four-round compression loop over the sliding SIMD schedule window, returning to blocks-loop.
  sha1-rounds :: Bytes -> I64 -> I64 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U32 -> U128 -> U128 -> U128 -> U128 -> Sha1Words
  sha1-rounds input next-off len r h0 h1 h2 h3 h4 a b c d e g0 g1 g2 g3 =
    if ge-u32 r 80 then
      blocks-loop input next-off len
        (wrapping-add-u32 h0 a) (wrapping-add-u32 h1 b) (wrapping-add-u32 h2 c)
        (wrapping-add-u32 h3 d) (wrapping-add-u32 h4 e)
    else
      let g4 = if lt-u32 r 64 then sha1-schedule g0 g1 g2 g3 else g0 in
      let next-r = wrapping-add-u32 r 4 in
      if lt-u32 r 20 then
        let a0 = sha1-step-a a (fn-choose b c d) e (lane0 g0) 1518500249 in
        let b0 = rotate-left-u32 b 30 in
        let a1 = sha1-step-a a0 (fn-choose a b0 c) d (lane1 g0) 1518500249 in
        let b1 = rotate-left-u32 a 30 in
        let a2 = sha1-step-a a1 (fn-choose a0 b1 b0) c (lane2 g0) 1518500249 in
        let b2 = rotate-left-u32 a0 30 in
        let a3 = sha1-step-a a2 (fn-choose a1 b2 b1) b0 (lane3 g0) 1518500249 in
        let b3 = rotate-left-u32 a1 30 in
        sha1-rounds input next-off len next-r h0 h1 h2 h3 h4 a3 a2 b3 b2 b1 g1 g2 g3 g4
      else if lt-u32 r 40 then
        let a0 = sha1-step-a a (fn-parity b c d) e (lane0 g0) 1859775393 in
        let b0 = rotate-left-u32 b 30 in
        let a1 = sha1-step-a a0 (fn-parity a b0 c) d (lane1 g0) 1859775393 in
        let b1 = rotate-left-u32 a 30 in
        let a2 = sha1-step-a a1 (fn-parity a0 b1 b0) c (lane2 g0) 1859775393 in
        let b2 = rotate-left-u32 a0 30 in
        let a3 = sha1-step-a a2 (fn-parity a1 b2 b1) b0 (lane3 g0) 1859775393 in
        let b3 = rotate-left-u32 a1 30 in
        sha1-rounds input next-off len next-r h0 h1 h2 h3 h4 a3 a2 b3 b2 b1 g1 g2 g3 g4
      else if lt-u32 r 60 then
        let a0 = sha1-step-a a (fn-majority b c d) e (lane0 g0) 2400959708 in
        let b0 = rotate-left-u32 b 30 in
        let a1 = sha1-step-a a0 (fn-majority a b0 c) d (lane1 g0) 2400959708 in
        let b1 = rotate-left-u32 a 30 in
        let a2 = sha1-step-a a1 (fn-majority a0 b1 b0) c (lane2 g0) 2400959708 in
        let b2 = rotate-left-u32 a0 30 in
        let a3 = sha1-step-a a2 (fn-majority a1 b2 b1) b0 (lane3 g0) 2400959708 in
        let b3 = rotate-left-u32 a1 30 in
        sha1-rounds input next-off len next-r h0 h1 h2 h3 h4 a3 a2 b3 b2 b1 g1 g2 g3 g4
      else
        let a0 = sha1-step-a a (fn-parity b c d) e (lane0 g0) 3395469782 in
        let b0 = rotate-left-u32 b 30 in
        let a1 = sha1-step-a a0 (fn-parity a b0 c) d (lane1 g0) 3395469782 in
        let b1 = rotate-left-u32 a 30 in
        let a2 = sha1-step-a a1 (fn-parity a0 b1 b0) c (lane2 g0) 3395469782 in
        let b2 = rotate-left-u32 a0 30 in
        let a3 = sha1-step-a a2 (fn-parity a1 b2 b1) b0 (lane3 g0) 3395469782 in
        let b3 = rotate-left-u32 a1 30 in
        sha1-rounds input next-off len next-r h0 h1 h2 h3 h4 a3 a2 b3 b2 b1 g1 g2 g3 g4
