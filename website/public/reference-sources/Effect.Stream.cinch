-- | Composable byte readers and writers with explicit continuation state.
-- Every operation returns its advanced handle, including on failure. A positive
-- read returning an empty buffer means end of input; zero-length reads never
-- invoke a source. Writers report the number accepted and may write a prefix.
-- Range copies use the byte-buffer bulk primitive. Memory sources snapshot
-- their input, and memory sinks snapshot each accepted chunk, so later mutation
-- cannot alter data retained by a stream. Descriptor adapters borrow their
-- descriptor: the caller remains responsible for closing it.
module Effect.Stream where

  import Algebra.Semigroup
  import Data.Bytes
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String
  import Prim.Sys

  export ByteReader, ByteWriter, StreamError
  export StreamSystemError, StreamUnexpectedEnd, StreamShortWrite, StreamInvalidCount, StreamInvalidChunkSize
  export StreamEncodingError, StreamClosed
  export stream-reader, stream-writer, stream-read, stream-write
  export reader-from-bytes, reader-from-string, reader-from-fd
  export reader-limit, reader-concat, reader-tee, reader-tee-writer
  export writer-buffer, writer-discard, writer-from-fd, writer-concat, writer-bytes, writer-components
  export stream-read-exact, stream-read-at-least, stream-read-all
  export stream-write-all, stream-write-string, stream-copy, stream-copy-n

  -- | A source whose callback returns both its result and next continuation.
  -- A callback must return no more than the requested number of bytes.
  data ByteReader r where
    -- | Private callback representation; construct validated handles with stream-reader.
    ReaderStep :: (Nat ->{IO r} (Result StreamError Bytes, ByteReader r)) -> ByteReader r
    -- | A source and mirror sink whose advanced state can be inspected explicitly.
    TeeSource :: ByteReader r -> ByteWriter r -> ByteReader r

  -- | A sink accepting chunks. The advanced handle is returned after every write.
  data ByteWriter r where
    -- | Private callback representation; the callback may accept a prefix of a chunk.
    WriterStep :: (Bytes ->{IO r} (Result StreamError Nat, ByteWriter r)) -> ByteWriter r
    -- | Persistent memory sink holding copied chunks in reverse order and their total length.
    BufferedSink :: Nat -> List Bytes -> ByteWriter r
    -- | A sink that accepts and discards every byte without allocation.
    DiscardSink :: ByteWriter r
    -- | Ordered child sinks; updated children remain observable after writes.
    BroadcastSink :: WriterChain r -> ByteWriter r

  -- | Private direct recursive spine for persistent broadcast children.
  -- Its explicit positive structure keeps the representation independently checkable.
  data WriterChain r where
    -- | No further broadcast children.
    WriterEnd :: WriterChain r
    -- | One child and the remaining ordered children.
    WriterLink :: ByteWriter r -> WriterChain r -> WriterChain r

  -- | Named stream failures. Short operations carry their actual progress.
  data StreamError where
    -- | A borrowed operating-system descriptor reported a named system error.
    StreamSystemError :: SysError -> StreamError
    -- | Input ended before the requested minimum; carries required and received counts.
    StreamUnexpectedEnd :: Nat -> Nat -> StreamError
    -- | A sink stopped accepting bytes; carries expected and accepted counts.
    StreamShortWrite :: Nat -> Nat -> StreamError
    -- | A callback or system operation reported more bytes than its request permits.
    StreamInvalidCount :: Nat -> Nat -> StreamError
    -- | A copying/read-all chunk size must be positive.
    StreamInvalidChunkSize :: StreamError
    -- | A transforming reader found malformed input: format name, absolute byte offset and diagnostic.
    StreamEncodingError :: String -> Nat -> String -> StreamError
    -- | A named stream adapter has already been finished or closed.
    StreamClosed :: String -> StreamError

  -- | Wrap a custom effectful reader. stream-read validates its result length.
  stream-reader :: forall r. (Nat ->{IO r} (Result StreamError Bytes, ByteReader r)) -> ByteReader r
  stream-reader step = ReaderStep step

  -- | Wrap a custom effectful writer. stream-write validates its accepted count.
  stream-writer :: forall r. (Bytes ->{IO r} (Result StreamError Nat, ByteWriter r)) -> ByteWriter r
  stream-writer step = WriterStep step

  -- | Read at most n bytes and always return the advanced reader. An empty
  -- successful positive read means EOF. A zero request leaves the reader alone.
  stream-read :: forall r. using (io :: Io r) => ByteReader r -> Nat ->{IO r} (Result StreamError Bytes, ByteReader r)
  stream-read reader n =
    if n == 0 then (Ok (bytes-new 0), reader)
    else case reader of
      TeeSource source sink -> tee-read source sink n
      ReaderStep step -> case step n of
        (Err e, next) -> (Err e, next)
        (Ok b, next) ->
          if bytes-len b <= n then (Ok b, next)
          else (Err (StreamInvalidCount n (bytes-len b)), next)

  -- | Copy an entire buffer into fresh storage with a single bulk copy.
  snapshot :: Bytes -> Bytes
  snapshot input =
    let out = bytes-new (bytes-len input) in
    let copied = bytes-copy-range out input 0 0 (bytes-len input) in
    out

  -- | Snapshot a byte buffer and start reading at its beginning.
  reader-from-bytes :: forall r. using (io :: Io r) => Bytes -> ByteReader r
  reader-from-bytes b = memory-reader (snapshot b) 0

  -- | Read UTF-8 bytes of text, starting at its beginning.
  reader-from-string :: forall r. using (io :: Io r) => String -> ByteReader r
  reader-from-string text = memory-reader (string-to-bytes text) 0

  -- | Build a memory-source continuation whose cursor stays within the buffer.
  memory-reader :: forall r. using (io :: Io r) => Bytes -> Nat -> ByteReader r
  memory-reader b pos = ReaderStep (\n -> memory-read b pos n)

  -- | Copy the requested available prefix and advance by exactly its length.
  memory-read :: forall r. using (io :: Io r) => Bytes -> Nat -> Nat ->{IO r} (Result StreamError Bytes, ByteReader r)
  memory-read b pos n =
    if pos + n <= bytes-len b then memory-span b pos n
    else if pos < bytes-len b then memory-span b pos (bytes-len b - pos)
    else (Ok (bytes-new 0), memory-reader b pos)

  -- | Copy a proved source range and retain the exact advanced cursor.
  memory-span :: forall r. using (io :: Io r, pos + count <= bytes-len b) => (b :: Bytes) -> (pos :: Nat) -> (count :: Nat) ->{IO r} (Result StreamError Bytes, ByteReader r)
  memory-span b pos count =
    let out = bytes-new count in
    let copied = bytes-copy-range out b 0 pos count in
    (Ok out, memory-reader b (pos + count))

  -- | Borrow a descriptor at its current position. Reads advance its OS cursor;
  -- duplicating this reader shares that cursor. This adapter never closes it.
  reader-from-fd :: forall r. using (io :: Io r) => I64 -> ByteReader r
  reader-from-fd fd = ReaderStep (\n -> descriptor-read fd n)

  -- | Read a bounded OS-sized chunk and trim a short read without exposing slack.
  descriptor-read :: forall r. using (io :: Io r) => I64 -> Nat ->{IO r} (Result StreamError Bytes, ByteReader r)
  descriptor-read fd n =
    let count = bounded-chunk n in
    let out = bytes-new count in
    case sys-read fd out 0 (nat-to-i64 count) of
      Err e -> (Err (StreamSystemError e), reader-from-fd fd)
      Ok actual ->
        if actual < 0 then (Err (StreamInvalidCount count 0), reader-from-fd fd)
        else
          let got = nat-from-i64 actual in
          if got > count then (Err (StreamInvalidCount count got), reader-from-fd fd)
          else if got == count then (Ok out, reader-from-fd fd)
          else
            let trimmed = bytes-new got in
            let copied = bytes-copy-range trimmed out 0 0 got in
            (Ok trimmed, reader-from-fd fd)

  -- | Expose at most limit more bytes without reading beyond that limit.
  reader-limit :: forall r. using (io :: Io r) => Nat -> ByteReader r -> ByteReader r
  reader-limit limit source = ReaderStep (\n -> limited-read limit source n)

  -- | Retain the source continuation while reducing the remaining byte allowance.
  limited-read :: forall r. using (io :: Io r) => Nat -> ByteReader r -> Nat ->{IO r} (Result StreamError Bytes, ByteReader r)
  limited-read limit source n =
    if limit == 0 then (Ok (bytes-new 0), reader-limit 0 source)
    else case stream-read source (if n < limit then n else limit) of
      (Err e, next) -> (Err e, reader-limit limit next)
      (Ok b, next) ->
        if bytes-len b <= limit then (Ok b, reader-limit (limit - bytes-len b) next)
        else (Err (StreamInvalidCount limit (bytes-len b)), reader-limit limit next)

  -- | Read sources in order, skipping exhausted sources. An empty list is EOF.
  reader-concat :: forall r. using (io :: Io r) => List (ByteReader r) -> ByteReader r
  reader-concat sources = ReaderStep (\n -> concatenated-read sources n)

  -- | Advance only the current source, then remove it at EOF.
  concatenated-read :: forall r. using (io :: Io r) => List (ByteReader r) -> Nat ->{IO r} (Result StreamError Bytes, ByteReader r)
  concatenated-read sources n = case sources of
    Nil -> (Ok (bytes-new 0), reader-concat Nil)
    Cons source rest -> case stream-read source n of
      (Err e, next) -> (Err e, reader-concat (Cons next rest))
      (Ok b, next) ->
        if bytes-len b == 0 then concatenated-read rest n
        else (Ok b, reader-concat (Cons next rest))

  -- | Create an empty persistent memory sink. Inspect its contents with writer-bytes.
  writer-buffer :: forall r. ByteWriter r
  writer-buffer = BufferedSink 0 Nil

  -- | Create a sink that accepts all input without retaining it.
  writer-discard :: forall r. ByteWriter r
  writer-discard = DiscardSink

  -- | Borrow a descriptor for writing; the caller retains close responsibility.
  writer-from-fd :: forall r. using (io :: Io r) => I64 -> ByteWriter r
  writer-from-fd fd = WriterStep (\b -> descriptor-write fd b)

  -- | Write a bounded prefix, preserving short-write counts for the caller.
  descriptor-write :: forall r. using (io :: Io r) => I64 -> Bytes ->{IO r} (Result StreamError Nat, ByteWriter r)
  descriptor-write fd b =
    let count = bounded-chunk (bytes-len b) in
    case sys-write fd b 0 (nat-to-i64 count) of
      Err e -> (Err (StreamSystemError e), writer-from-fd fd)
      Ok actual ->
        if actual < 0 then (Err (StreamInvalidCount count 0), writer-from-fd fd)
        else (Ok (nat-from-i64 actual), writer-from-fd fd)

  -- | Bound OS requests to a machine-sized one-mebibyte chunk, carrying that proof.
  bounded-chunk :: Nat -> InRange 0 1048576 Nat
  bounded-chunk n = if n > 1048576 then 1048576 else n

  -- | Attempt one write and return the advanced sink. Empty input does not invoke
  -- callbacks. Counts larger than the input are rejected as protocol errors.
  stream-write :: forall r. using (io :: Io r) => ByteWriter r -> Bytes ->{IO r} (Result StreamError Nat, ByteWriter r)
  stream-write sink b =
    if bytes-len b == 0 then (Ok 0, sink)
    else case sink of
      DiscardSink -> (Ok (bytes-len b), sink)
      BroadcastSink sinks -> broadcast-write (chain-writers sinks) b Nil
      BufferedSink total chunks -> (Ok (bytes-len b), BufferedSink (total + bytes-len b) (Cons (snapshot b) chunks))
      WriterStep step -> case step b of
        (Err e, next) -> (Err e, next)
        (Ok n, next) ->
          if n <= bytes-len b then (Ok n, next)
          else (Err (StreamInvalidCount (bytes-len b) n), next)

  -- | Flatten copied memory chunks once into a fresh buffer. Other sinks return None.
  writer-bytes :: forall r. ByteWriter r -> Option Bytes
  writer-bytes sink = case sink of
    BufferedSink total chunks -> Some (join-chunks total (reverse chunks))
    _ -> None

  -- | Allocate the exact aggregate size and copy each chunk once.
  join-chunks :: Nat -> List Bytes -> Bytes
  join-chunks total chunks =
    let out = bytes-new total in
    let copied = copy-chunks out 0 chunks in
    out

  -- | Copy validated chunk ranges; the defensive guard protects custom callers.
  copy-chunks :: Bytes -> Nat -> List Bytes -> Unit
  copy-chunks out pos chunks = case chunks of
    Nil -> ()
    Cons b rest ->
      if pos + bytes-len b <= bytes-len out then
        let copied = bytes-copy-range out b pos 0 (bytes-len b) in
        copy-chunks out (pos + bytes-len b) rest
      else ()

  -- | Write a full chunk despite short writes. Zero progress becomes a named
  -- short-write error instead of an infinite retry. The next sink is retained.
  stream-write-all :: forall r. using (io :: Io r) => ByteWriter r -> Bytes ->{IO r} (Result StreamError Nat, ByteWriter r)
  stream-write-all sink b = write-rest sink b 0

  -- | Write the remaining suffix and accumulate the accepted prefix length.
  write-rest :: forall r. using (io :: Io r) => ByteWriter r -> Bytes -> Nat ->{IO r} (Result StreamError Nat, ByteWriter r)
  write-rest sink b sent =
    if sent < bytes-len b then
      let remaining = bytes-len b - sent in
      let tail = bytes-new remaining in
      let copied = bytes-copy-range tail b 0 sent remaining in
      case stream-write sink tail of
        (Err e, next) -> (Err e, next)
        (Ok n, next) ->
          if n == 0 then (Err (StreamShortWrite (bytes-len b) sent), next)
          else write-rest next b (sent + n)
    else (Ok sent, sink)

  -- | Encode text as UTF-8 and completely write the resulting bytes.
  stream-write-string :: forall r. using (io :: Io r) => ByteWriter r -> String ->{IO r} (Result StreamError Nat, ByteWriter r)
  stream-write-string sink text = stream-write-all sink (string-to-bytes text)

  -- | Broadcast each chunk in list order. Empty lists accept and discard it.
  -- An error stops before subsequent sinks, retaining already advanced sinks.
  writer-concat :: forall r. using (io :: Io r) => List (ByteWriter r) -> ByteWriter r
  writer-concat sinks = BroadcastSink (writer-chain sinks)

  -- | Store ordered children in the direct recursive representation.
  writer-chain :: forall r. List (ByteWriter r) -> WriterChain r
  writer-chain children = case children of
    Nil -> WriterEnd
    Cons child rest -> WriterLink child (writer-chain rest)

  -- | Expose ordered child handles without changing their continuation state.
  chain-writers :: forall r. WriterChain r -> List (ByteWriter r)
  chain-writers children = case children of
    WriterEnd -> Nil
    WriterLink child rest -> Cons child (chain-writers rest)

  -- | Inspect the advanced children of a broadcast sink. Other sink types return None.
  writer-components :: forall r. ByteWriter r -> Option (List (ByteWriter r))
  writer-components sink = case sink of
    BroadcastSink children -> Some (chain-writers children)
    _ -> None

  -- | Rebuild a broadcaster with the advanced prefix after success or failure.
  broadcast-write :: forall r. using (io :: Io r) => List (ByteWriter r) -> Bytes -> List (ByteWriter r) ->{IO r} (Result StreamError Nat, ByteWriter r)
  broadcast-write sinks b done = case sinks of
    Nil -> (Ok (bytes-len b), writer-concat (reverse done))
    Cons sink rest -> case stream-write-all sink b of
      (Err e, next) -> (Err e, writer-concat (reverse (Cons next done) <> rest))
      (Ok _, next) -> broadcast-write rest b (Cons next done)

  -- | Read exactly n bytes or report how many were obtained before EOF.
  stream-read-exact :: forall r. using (io :: Io r) => ByteReader r -> Nat ->{IO r} (Result StreamError Bytes, ByteReader r)
  stream-read-exact source n = read-minimum source n n 0 Nil

  -- | Read a minimum into a maximum-sized result. A minimum greater than the
  -- maximum is rejected before invoking the reader.
  stream-read-at-least :: forall r. using (io :: Io r) => ByteReader r -> Nat -> Nat ->{IO r} (Result StreamError Bytes, ByteReader r)
  stream-read-at-least source minimum maximum =
    if minimum > maximum then (Err (StreamInvalidCount maximum minimum), source)
    else read-minimum source minimum maximum 0 Nil

  -- | Accumulate only until the requested minimum is reached; never overread maximum.
  read-minimum :: forall r. using (io :: Io r) => ByteReader r -> Nat -> Nat -> Nat -> List Bytes ->{IO r} (Result StreamError Bytes, ByteReader r)
  read-minimum source minimum maximum got chunks =
    if got >= minimum then (Ok (join-chunks got (reverse chunks)), source)
    else if got <= maximum then case stream-read source (maximum - got) of
      (Err e, next) -> (Err e, next)
      (Ok b, next) ->
        if bytes-len b == 0 then (Err (StreamUnexpectedEnd minimum got), next)
        else read-minimum next minimum maximum (got + bytes-len b) (Cons b chunks)
    else (Err (StreamInvalidCount maximum got), source)

  -- | Read until EOF using positive-sized chunks. Every chunk is copied once
  -- into the final output; failures still return the advanced reader.
  stream-read-all :: forall r. using (io :: Io r) => Nat -> ByteReader r ->{IO r} (Result StreamError Bytes, ByteReader r)
  stream-read-all chunk source =
    if chunk == 0 then (Err StreamInvalidChunkSize, source)
    else read-all-chunks chunk source 0 Nil

  -- | Collect sequential chunks without repeatedly copying the existing prefix.
  read-all-chunks :: forall r. using (io :: Io r) => Nat -> ByteReader r -> Nat -> List Bytes ->{IO r} (Result StreamError Bytes, ByteReader r)
  read-all-chunks chunk source total chunks = case stream-read source chunk of
    (Err e, next) -> (Err e, next)
    (Ok b, next) ->
      if bytes-len b == 0 then (Ok (join-chunks total (reverse chunks)), next)
      else read-all-chunks chunk next (total + bytes-len b) (Cons b chunks)

  -- | Copy until EOF with a positive chunk size. Return bytes transferred and
  -- both advanced handles; failures preserve those handles as well.
  stream-copy :: forall r. using (io :: Io r) => Nat -> ByteReader r -> ByteWriter r ->{IO r} (Result StreamError Nat, (ByteReader r, ByteWriter r))
  stream-copy chunk source sink =
    if chunk == 0 then (Err StreamInvalidChunkSize, (source, sink))
    else copy-chunks-to chunk source sink 0

  -- | Transfer one chunk completely before asking the source for the next one.
  copy-chunks-to :: forall r. using (io :: Io r) => Nat -> ByteReader r -> ByteWriter r -> Nat ->{IO r} (Result StreamError Nat, (ByteReader r, ByteWriter r))
  copy-chunks-to chunk source sink transferred = case stream-read source chunk of
    (Err e, next) -> (Err e, (next, sink))
    (Ok b, next) ->
      if bytes-len b == 0 then (Ok transferred, (next, sink))
      else case stream-write-all sink b of
        (Err e, advanced) -> (Err e, (next, advanced))
        (Ok n, advanced) -> copy-chunks-to chunk next advanced (transferred + n)

  -- | Copy exactly count bytes without reading beyond that boundary. An early
  -- EOF is a named error. Both returned handles reflect completed operations.
  stream-copy-n :: forall r. using (io :: Io r) => Nat -> Nat -> ByteReader r -> ByteWriter r ->{IO r} (Result StreamError Nat, (ByteReader r, ByteWriter r))
  stream-copy-n chunk count source sink =
    if chunk == 0 then (Err StreamInvalidChunkSize, (source, sink))
    else copy-count chunk count source sink 0

  -- | Bound each source request by the remaining transfer allowance.
  copy-count :: forall r. using (io :: Io r) => Nat -> Nat -> ByteReader r -> ByteWriter r -> Nat ->{IO r} (Result StreamError Nat, (ByteReader r, ByteWriter r))
  copy-count chunk count source sink transferred =
    if transferred >= count then (Ok transferred, (source, sink))
    else case stream-read source (if chunk < count - transferred then chunk else count - transferred) of
      (Err e, next) -> (Err e, (next, sink))
      (Ok b, next) ->
        if bytes-len b == 0 then (Err (StreamUnexpectedEnd count transferred), (next, sink))
        else case stream-write-all sink b of
          (Err e, advanced) -> (Err e, (next, advanced))
          (Ok n, advanced) -> copy-count chunk count next advanced (transferred + n)

  -- | Mirror every returned chunk to a sink before delivering it to the reader.
  -- No buffering occurs; a sink failure is returned with both continuations advanced.
  reader-tee :: forall r. using (io :: Io r) => ByteReader r -> ByteWriter r -> ByteReader r
  reader-tee source sink = TeeSource source sink

  -- | Inspect a tee reader's advanced mirror sink, including after read failures.
  -- This exposes persistent memory-sink results without implicit shared mutation.
  reader-tee-writer :: forall r. ByteReader r -> Option (ByteWriter r)
  reader-tee-writer source = case source of
    TeeSource _ sink -> Some sink
    _ -> None

  -- | Finish the mirror write before exposing the chunk to the consumer.
  tee-read :: forall r. using (io :: Io r) => ByteReader r -> ByteWriter r -> Nat ->{IO r} (Result StreamError Bytes, ByteReader r)
  tee-read source sink n = case stream-read source n of
    (Err e, next) -> (Err e, reader-tee next sink)
    (Ok b, next) -> case stream-write-all sink b of
      (Err e, advanced) -> (Err e, reader-tee next advanced)
      (Ok _, advanced) -> (Ok b, reader-tee next advanced)
