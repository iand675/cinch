-- | DES and Triple DES (FIPS 46-3, SP 800-67) block ciphers with ECB, CBC and CTR over 64-bit blocks.
-- These ciphers exist for interoperation with legacy formats and protocols: DES
-- keys are far too short, and Triple DES has a 64-bit block, so neither should
-- protect new data. Each block runs a 5-step butterfly initial permutation,
-- sixteen Feistel rounds using combined S-box and P-permutation lookup tables,
-- and the inverse 5-step butterfly final permutation. Table lookups depend on
-- data, so timing is not constant. Triple DES is encrypt-decrypt-encrypt with
-- three independent keys (a 24-byte key). Every returned buffer is fresh;
-- inputs are never retained or mutated.
module Crypto.Des where

  import Data.Bytes
  import Data.Machine
  import Data.Nat
  import Data.Result
  import Data.String
  import Text.Show (nat-to-string)

  export DesCipher, des-cipher, triple-des-cipher, des-block-size
  export DesError, DesInvalidKeySize, DesInvalidInputSize, DesInvalidIvSize, des-error-message
  export des-encrypt-block, des-decrypt-block, des-encrypt-ecb, des-decrypt-ecb
  export des-cbc-encrypt, des-cbc-decrypt, des-ctr-xor

  -- | A rejected key, input or initialization vector.
  data DesError where
    -- | DES keys are 8 bytes and Triple DES keys 24; the length given.
    DesInvalidKeySize :: Nat -> DesError
    -- | Block modes need a whole number of 8-byte blocks (a single-block call exactly one); the length given.
    DesInvalidInputSize :: Nat -> DesError
    -- | Initialization vectors and counters are 8 bytes; the length given.
    DesInvalidIvSize :: Nat -> DesError

  -- | Render an error.
  des-error-message :: DesError -> String
  des-error-message error = case error of
    DesInvalidKeySize n -> string-concat "des: invalid key size " (nat-to-string n)
    DesInvalidInputSize n -> string-concat "des: input is not a whole number of blocks: " (nat-to-string n)
    DesInvalidIvSize n -> string-concat "des: invalid IV size " (nat-to-string n)

  -- | Sixteen 48-bit DES round subkeys packed in the low 48 bits of each U64.
  data DesSchedule where
    -- | Round keys k0 through k15 in encryption order.
    DesSchedule :: U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> DesSchedule

  -- | A keyed cipher: one schedule for DES, three for Triple DES (applied encrypt, decrypt, encrypt).
  data DesCipher where
    -- | Single DES.
    SingleDes :: DesSchedule -> DesCipher
    -- | Triple DES with its three schedules in key order.
    TripleDes :: DesSchedule -> DesSchedule -> DesSchedule -> DesCipher

  -- | The block size in bytes.
  des-block-size :: Nat
  des-block-size = 8

  -- | Key DES with an 8-byte key (parity bits are ignored).
  des-cipher :: Bytes -> Result DesError DesCipher
  des-cipher key = if bytes-len key == 8 then Ok (SingleDes (schedule key 0)) else Err (DesInvalidKeySize (bytes-len key))

  -- | Key Triple DES with a 24-byte key: three DES keys in order.
  triple-des-cipher :: Bytes -> Result DesError DesCipher
  triple-des-cipher key =
    if bytes-len key == 24 then Ok (TripleDes (schedule key 0) (schedule key 8) (schedule key 16))
    else Err (DesInvalidKeySize (bytes-len key))

  -- | Rotate a 28-bit key half left by n bits.
  rot28 :: U64 -> U32 -> U64
  rot28 h n = bit-and-u64 (bit-or-u64 (wrapping-shl-u64 h n) (wrapping-shr-u64 h (wrapping-sub-u32 28 n))) 268435455

  -- | Derive one 48-bit round subkey from the PC-1 halves and a cumulative left rotation.
  subkey-at :: U64 -> U64 -> U32 -> U64
  subkey-at c d shift = pc2-permute (bit-or-u64 (wrapping-shl-u64 (rot28 c shift) 28) (rot28 d shift))

  -- | Build the sixteen round subkeys from the 8 key bytes at an offset.
  schedule :: Bytes -> Nat -> DesSchedule
  schedule key at =
    let word = if at + 8 <= bytes-len key then swap-bytes-u64 (bytes-load-le64 key at) else 0 in
    let cd = pc1-permute word in
    let c = wrapping-shr-u64 cd 28 in
    let d = bit-and-u64 cd 268435455 in
    DesSchedule
      (subkey-at c d 1) (subkey-at c d 2) (subkey-at c d 4) (subkey-at c d 6)
      (subkey-at c d 8) (subkey-at c d 10) (subkey-at c d 12) (subkey-at c d 14)
      (subkey-at c d 15) (subkey-at c d 17) (subkey-at c d 19) (subkey-at c d 21)
      (subkey-at c d 23) (subkey-at c d 25) (subkey-at c d 27) (subkey-at c d 28)

  -- | Write a word when it fits.
  store :: Bytes -> Nat -> U64 -> Unit
  store out at w = if at + 8 <= bytes-len out then bytes-store-le64 out at w else ()

  -- | Read a word, zero when it does not fit.
  load :: Bytes -> Nat -> U64
  load b at = if at + 8 <= bytes-len b then bytes-load-le64 b at else 0

  -- | Apply the DES initial permutation via five delta-swap butterfly steps, returning (L0, R0).
  ip-permute :: U32 -> U32 -> (U32, U32)
  ip-permute l0 r0 =
    let t0 = bit-and-u32 (bit-xor-u32 (wrapping-shr-u32 l0 4) r0) 252645135 in
    let r1 = bit-xor-u32 r0 t0 in
    let l1 = bit-xor-u32 l0 (wrapping-shl-u32 t0 4) in
    let t1 = bit-and-u32 (bit-xor-u32 (wrapping-shr-u32 l1 16) r1) 65535 in
    let r2 = bit-xor-u32 r1 t1 in
    let l2 = bit-xor-u32 l1 (wrapping-shl-u32 t1 16) in
    let t2 = bit-and-u32 (bit-xor-u32 (wrapping-shr-u32 r2 2) l2) 858993459 in
    let l3 = bit-xor-u32 l2 t2 in
    let r3 = bit-xor-u32 r2 (wrapping-shl-u32 t2 2) in
    let t3 = bit-and-u32 (bit-xor-u32 (wrapping-shr-u32 r3 8) l3) 16711935 in
    let l4 = bit-xor-u32 l3 t3 in
    let r4 = bit-xor-u32 r3 (wrapping-shl-u32 t3 8) in
    let t4 = bit-and-u32 (bit-xor-u32 (wrapping-shr-u32 l4 1) r4) 1431655765 in
    let r5 = bit-xor-u32 r4 t4 in
    let l5 = bit-xor-u32 l4 (wrapping-shl-u32 t4 1) in
    (l5, r5)

  -- | Apply the DES final permutation via the inverse five butterfly steps, packing into a big-endian U64.
  fp-permute :: U32 -> U32 -> U64
  fp-permute l0 r0 =
    let t0 = bit-and-u32 (bit-xor-u32 (wrapping-shr-u32 l0 1) r0) 1431655765 in
    let r1 = bit-xor-u32 r0 t0 in
    let l1 = bit-xor-u32 l0 (wrapping-shl-u32 t0 1) in
    let t1 = bit-and-u32 (bit-xor-u32 (wrapping-shr-u32 r1 8) l1) 16711935 in
    let l2 = bit-xor-u32 l1 t1 in
    let r2 = bit-xor-u32 r1 (wrapping-shl-u32 t1 8) in
    let t2 = bit-and-u32 (bit-xor-u32 (wrapping-shr-u32 r2 2) l2) 858993459 in
    let l3 = bit-xor-u32 l2 t2 in
    let r3 = bit-xor-u32 r2 (wrapping-shl-u32 t2 2) in
    let t3 = bit-and-u32 (bit-xor-u32 (wrapping-shr-u32 l3 16) r3) 65535 in
    let r4 = bit-xor-u32 r3 t3 in
    let l4 = bit-xor-u32 l3 (wrapping-shl-u32 t3 16) in
    let t4 = bit-and-u32 (bit-xor-u32 (wrapping-shr-u32 l4 4) r4) 252645135 in
    let r5 = bit-xor-u32 r4 t4 in
    let l5 = bit-xor-u32 l4 (wrapping-shl-u32 t4 4) in
    bit-or-u64 (wrapping-shl-u64 (u32-to-u64 l5) 32) (u32-to-u64 r5)

  -- | One DES Feistel round function: expansion E, XOR with 48-bit subkey, and combined S-box + P lookups.
  feistel :: U32 -> U64 -> U32
  feistel r k =
    let r1 = rotate-right-u32 r 1 in
    let r2 = rotate-left-u32 r 1 in
    let x0 = bit-xor-u32 (bit-and-u32 (wrapping-shr-u32 r1 26) 63) (bit-and-u32 (wrapping-u64-to-u32 (wrapping-shr-u64 k 42)) 63) in
    let x1 = bit-xor-u32 (bit-and-u32 (wrapping-shr-u32 r1 22) 63) (bit-and-u32 (wrapping-u64-to-u32 (wrapping-shr-u64 k 36)) 63) in
    let x2 = bit-xor-u32 (bit-and-u32 (wrapping-shr-u32 r1 18) 63) (bit-and-u32 (wrapping-u64-to-u32 (wrapping-shr-u64 k 30)) 63) in
    let x3 = bit-xor-u32 (bit-and-u32 (wrapping-shr-u32 r1 14) 63) (bit-and-u32 (wrapping-u64-to-u32 (wrapping-shr-u64 k 24)) 63) in
    let x4 = bit-xor-u32 (bit-and-u32 (wrapping-shr-u32 r1 10) 63) (bit-and-u32 (wrapping-u64-to-u32 (wrapping-shr-u64 k 18)) 63) in
    let x5 = bit-xor-u32 (bit-and-u32 (wrapping-shr-u32 r1 6) 63) (bit-and-u32 (wrapping-u64-to-u32 (wrapping-shr-u64 k 12)) 63) in
    let x6 = bit-xor-u32 (bit-and-u32 (wrapping-shr-u32 r1 2) 63) (bit-and-u32 (wrapping-u64-to-u32 (wrapping-shr-u64 k 6)) 63) in
    let x7 = bit-xor-u32 (bit-and-u32 r2 63) (bit-and-u32 (wrapping-u64-to-u32 k) 63) in
    let p01 = bit-xor-u32 (sp0 x0) (sp1 x1) in
    let p23 = bit-xor-u32 (sp2 x2) (sp3 x3) in
    let p45 = bit-xor-u32 (sp4 x4) (sp5 x5) in
    let p67 = bit-xor-u32 (sp6 x6) (sp7 x7) in
    bit-xor-u32 (bit-xor-u32 p01 p23) (bit-xor-u32 p45 p67)

  -- | Execute sixteen DES rounds on a little-endian block word using the sixteen round subkeys in order.
  des-apply :: U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64 -> U64
  des-apply k0 k1 k2 k3 k4 k5 k6 k7 k8 k9 k10 k11 k12 k13 k14 k15 block =
    let b = swap-bytes-u64 block in
    case ip-permute (wrapping-u64-to-u32 (wrapping-shr-u64 b 32)) (wrapping-u64-to-u32 b) of
      (l0, r0) ->
        let r1 = bit-xor-u32 l0 (feistel r0 k0) in
        let r2 = bit-xor-u32 r0 (feistel r1 k1) in
        let r3 = bit-xor-u32 r1 (feistel r2 k2) in
        let r4 = bit-xor-u32 r2 (feistel r3 k3) in
        let r5 = bit-xor-u32 r3 (feistel r4 k4) in
        let r6 = bit-xor-u32 r4 (feistel r5 k5) in
        let r7 = bit-xor-u32 r5 (feistel r6 k6) in
        let r8 = bit-xor-u32 r6 (feistel r7 k7) in
        let r9 = bit-xor-u32 r7 (feistel r8 k8) in
        let r10 = bit-xor-u32 r8 (feistel r9 k9) in
        let r11 = bit-xor-u32 r9 (feistel r10 k10) in
        let r12 = bit-xor-u32 r10 (feistel r11 k11) in
        let r13 = bit-xor-u32 r11 (feistel r12 k12) in
        let r14 = bit-xor-u32 r12 (feistel r13 k13) in
        let r15 = bit-xor-u32 r13 (feistel r14 k14) in
        let r16 = bit-xor-u32 r14 (feistel r15 k15) in
        swap-bytes-u64 (fp-permute r16 r15)

  -- | Run the round kernel over a schedule; forward encrypts, otherwise decrypts.
  rounds :: DesSchedule -> Bool -> U64 -> U64
  rounds s is-forward block = case s of
    DesSchedule k0 k1 k2 k3 k4 k5 k6 k7 k8 k9 k10 k11 k12 k13 k14 k15 ->
      if is-forward then des-apply k0 k1 k2 k3 k4 k5 k6 k7 k8 k9 k10 k11 k12 k13 k14 k15 block
      else des-apply k15 k14 k13 k12 k11 k10 k9 k8 k7 k6 k5 k4 k3 k2 k1 k0 block

  -- | Encrypt one block word.
  forward :: DesCipher -> U64 -> U64
  forward c block = case c of
    SingleDes s -> rounds s True block
    TripleDes a b z -> rounds z True (rounds b False (rounds a True block))

  -- | Decrypt one block word.
  backward :: DesCipher -> U64 -> U64
  backward c block = case c of
    SingleDes s -> rounds s False block
    TripleDes a b z -> rounds a False (rounds b True (rounds z False block))

  -- | Encrypt exactly one 8-byte block.
  des-encrypt-block :: DesCipher -> Bytes -> Result DesError Bytes
  des-encrypt-block c input = if bytes-len input == 8 then Ok (word-bytes (forward c (load input 0))) else Err (DesInvalidInputSize (bytes-len input))

  -- | Decrypt exactly one 8-byte block.
  des-decrypt-block :: DesCipher -> Bytes -> Result DesError Bytes
  des-decrypt-block c input = if bytes-len input == 8 then Ok (word-bytes (backward c (load input 0))) else Err (DesInvalidInputSize (bytes-len input))

  -- | A word as 8 fresh bytes.
  word-bytes :: U64 -> Bytes
  word-bytes w = let out = bytes-new 8 in let s = store out 0 w in out

  -- | Encrypt each block independently.
  des-encrypt-ecb :: DesCipher -> Bytes -> Result DesError Bytes
  des-encrypt-ecb c input = whole input (let out = bytes-new (bytes-len input) in let done = ecb c True input out 0 in out)

  -- | Decrypt each block independently.
  des-decrypt-ecb :: DesCipher -> Bytes -> Result DesError Bytes
  des-decrypt-ecb c input = whole input (let out = bytes-new (bytes-len input) in let done = ecb c False input out 0 in out)

  -- | The result when the input is a whole number of blocks.
  whole :: Bytes -> Bytes -> Result DesError Bytes
  whole input out = if nat-rem (bytes-len input) 8 == 0 then Ok out else Err (DesInvalidInputSize (bytes-len input))

  -- | Transform blocks independently from an offset.
  ecb :: DesCipher -> Bool -> Bytes -> Bytes -> Nat -> Unit
  ecb c enc input out at =
    if at + 8 > bytes-len input then ()
    else
      let w = load input at in
      let s = store out at (if enc then forward c w else backward c w) in
      ecb c enc input out (at + 8)

  -- | CBC encryption: each plaintext block is XORed with the previous ciphertext block (the IV first).
  des-cbc-encrypt :: DesCipher -> Bytes -> Bytes -> Result DesError Bytes
  des-cbc-encrypt c iv input =
    if not (bytes-len iv == 8) then Err (DesInvalidIvSize (bytes-len iv))
    else whole input (let out = bytes-new (bytes-len input) in let done = cbc-enc c input out 0 (load iv 0) in out)

  -- | CBC encryption from an offset with the chaining word.
  cbc-enc :: DesCipher -> Bytes -> Bytes -> Nat -> U64 -> Unit
  cbc-enc c input out at chain =
    if at + 8 > bytes-len input then ()
    else
      let e = forward c (bit-xor-u64 (load input at) chain) in
      let s = store out at e in
      cbc-enc c input out (at + 8) e

  -- | CBC decryption.
  des-cbc-decrypt :: DesCipher -> Bytes -> Bytes -> Result DesError Bytes
  des-cbc-decrypt c iv input =
    if not (bytes-len iv == 8) then Err (DesInvalidIvSize (bytes-len iv))
    else whole input (let out = bytes-new (bytes-len input) in let done = cbc-dec c input out 0 (load iv 0) in out)

  -- | CBC decryption from an offset with the chaining word.
  cbc-dec :: DesCipher -> Bytes -> Bytes -> Nat -> U64 -> Unit
  cbc-dec c input out at chain =
    if at + 8 > bytes-len input then ()
    else
      let w = load input at in
      let s = store out at (bit-xor-u64 (backward c w) chain) in
      cbc-dec c input out (at + 8) w

  -- | CTR mode: XOR the input (any length) with encryptions of the counter block, which increments as a
  -- big-endian 64-bit integer. Encryption and decryption are the same operation.
  des-ctr-xor :: DesCipher -> Bytes -> Bytes -> Result DesError Bytes
  des-ctr-xor c iv input =
    if not (bytes-len iv == 8) then Err (DesInvalidIvSize (bytes-len iv))
    else
      let out = bytes-new (bytes-len input) in
      let done = ctr c input out 0 (swap-bytes-u64 (load iv 0)) in
      Ok out

  -- | CTR from an offset; the counter is held as its big-endian value.
  ctr :: DesCipher -> Bytes -> Bytes -> Nat -> U64 -> Unit
  ctr c input out at counter =
    if at >= bytes-len input then ()
    else
      let pad = forward c (swap-bytes-u64 counter) in
      let next = wrapping-add-u64 counter 1 in
      if at + 8 <= bytes-len input then
        let s = store out at (bit-xor-u64 (load input at) pad) in
        ctr c input out (at + 8) next
      else tail-xor input out at (word-bytes pad) 0

  -- | XOR the final partial block with the leading pad bytes.
  tail-xor :: Bytes -> Bytes -> Nat -> Bytes -> Nat -> Unit
  tail-xor input out at pad i =
    if at + i >= bytes-len input || i >= bytes-len pad || at + i >= bytes-len out then ()
    else
      let v = u8-to-nat (bit-xor-u8 (bytes-get-u8 input (at + i)) (bytes-get-u8 pad i)) in
      let w = if v < 256 then bytes-set out (at + i) v else () in
      tail-xor input out at pad (i + 1)

  -- | Apply DES PC-1 (64-bit key to 56 key-schedule bits).
  pc1-permute :: U64 -> U64
  pc1-permute x =
    let t0 = wrapping-shr-u64 (bit-and-u64 x 1152921504606846976) 60 in
    let t1 = wrapping-shr-u64 (bit-and-u64 x 576460752303423488) 55 in
    let t2 = wrapping-shr-u64 (bit-and-u64 x 4503599627370496) 51 in
    let t3 = wrapping-shr-u64 (bit-and-u64 x 290482175965396992) 46 in
    let t4 = wrapping-shr-u64 (bit-and-u64 x 17592186044416) 42 in
    let t5 = wrapping-shr-u64 (bit-and-u64 x 145249884075720704) 37 in
    let t6 = wrapping-shr-u64 (bit-and-u64 x 68719476736) 33 in
    let t7 = wrapping-shr-u64 (bit-and-u64 x 2305843009213693952) 29 in
    let t8 = wrapping-shr-u64 (bit-and-u64 x 567382359670784) 28 in
    let t9 = wrapping-shr-u64 (bit-and-u64 x 4611686018427387904) 22 in
    let t10 = wrapping-shr-u64 (bit-and-u64 x 9007199254740992) 20 in
    let t11 = wrapping-shr-u64 (bit-and-u64 x 2216337342464) 19 in
    let t12 = wrapping-shr-u64 (bit-and-u64 x 9223372036854775808) 15 in
    let t13 = wrapping-shr-u64 (bit-and-u64 x 18014398509481984) 13 in
    let t14 = wrapping-shr-u64 (bit-and-u64 x 35184372088832) 11 in
    let t15 = wrapping-shr-u64 (bit-and-u64 x 8657567744) 10 in
    let t16 = wrapping-shr-u64 (bit-and-u64 x 36028797018963968) 6 in
    let t17 = wrapping-shr-u64 (bit-and-u64 x 70368744177664) 4 in
    let t18 = wrapping-shr-u64 (bit-and-u64 x 137438953472) 2 in
    let t19 = wrapping-shr-u64 (bit-and-u64 x 33818624) 1 in
    let t20 = bit-and-u64 x 268435456 in
    let t21 = wrapping-shl-u64 (bit-and-u64 x 140737488355328) 3 in
    let t22 = wrapping-shl-u64 (bit-and-u64 x 274877906944) 5 in
    let t23 = wrapping-shl-u64 (bit-and-u64 x 536870912) 7 in
    let t24 = wrapping-shl-u64 (bit-and-u64 x 132104) 8 in
    let t25 = wrapping-shl-u64 (bit-and-u64 x 1048576) 9 in
    let t26 = wrapping-shl-u64 (bit-and-u64 x 549755813888) 12 in
    let t27 = wrapping-shl-u64 (bit-and-u64 x 1073741824) 14 in
    let t28 = wrapping-shl-u64 (bit-and-u64 x 2097152) 16 in
    let t29 = wrapping-shl-u64 (bit-and-u64 x 516) 17 in
    let t30 = wrapping-shl-u64 (bit-and-u64 x 4096) 18 in
    let t31 = wrapping-shl-u64 (bit-and-u64 x 2147483648) 21 in
    let t32 = wrapping-shl-u64 (bit-and-u64 x 4194304) 23 in
    let t33 = wrapping-shl-u64 (bit-and-u64 x 8192) 25 in
    let t34 = wrapping-shl-u64 (bit-and-u64 x 2) 26 in
    let t35 = wrapping-shl-u64 (bit-and-u64 x 16) 27 in
    let t36 = wrapping-shl-u64 (bit-and-u64 x 8388608) 30 in
    let t37 = wrapping-shl-u64 (bit-and-u64 x 16384) 32 in
    let t38 = wrapping-shl-u64 (bit-and-u64 x 32) 34 in
    let t39 = wrapping-shl-u64 (bit-and-u64 x 32768) 39 in
    let t40 = wrapping-shl-u64 (bit-and-u64 x 64) 41 in
    let t41 = wrapping-shl-u64 (bit-and-u64 x 128) 48 in
    let u0 = bit-or-u64 t0 t1 in
    let u1 = bit-or-u64 t2 t3 in
    let u2 = bit-or-u64 t4 t5 in
    let u3 = bit-or-u64 t6 t7 in
    let u4 = bit-or-u64 t8 t9 in
    let u5 = bit-or-u64 t10 t11 in
    let u6 = bit-or-u64 t12 t13 in
    let u7 = bit-or-u64 t14 t15 in
    let u8 = bit-or-u64 t16 t17 in
    let u9 = bit-or-u64 t18 t19 in
    let u10 = bit-or-u64 t20 t21 in
    let u11 = bit-or-u64 t22 t23 in
    let u12 = bit-or-u64 t24 t25 in
    let u13 = bit-or-u64 t26 t27 in
    let u14 = bit-or-u64 t28 t29 in
    let u15 = bit-or-u64 t30 t31 in
    let u16 = bit-or-u64 t32 t33 in
    let u17 = bit-or-u64 t34 t35 in
    let u18 = bit-or-u64 t36 t37 in
    let u19 = bit-or-u64 t38 t39 in
    let u20 = bit-or-u64 t40 t41 in
    let u21 = bit-or-u64 u0 u1 in
    let u22 = bit-or-u64 u2 u3 in
    let u23 = bit-or-u64 u4 u5 in
    let u24 = bit-or-u64 u6 u7 in
    let u25 = bit-or-u64 u8 u9 in
    let u26 = bit-or-u64 u10 u11 in
    let u27 = bit-or-u64 u12 u13 in
    let u28 = bit-or-u64 u14 u15 in
    let u29 = bit-or-u64 u16 u17 in
    let u30 = bit-or-u64 u18 u19 in
    let u31 = bit-or-u64 u21 u22 in
    let u32 = bit-or-u64 u23 u24 in
    let u33 = bit-or-u64 u25 u26 in
    let u34 = bit-or-u64 u27 u28 in
    let u35 = bit-or-u64 u29 u30 in
    let u36 = bit-or-u64 u31 u32 in
    let u37 = bit-or-u64 u33 u34 in
    let u38 = bit-or-u64 u35 u20 in
    let u39 = bit-or-u64 u36 u37 in
    bit-or-u64 u39 u38

  -- | Apply DES PC-2 (56 rotated key-schedule bits to a 48-bit round subkey).
  pc2-permute :: U64 -> U64
  pc2-permute x =
    let t0 = wrapping-shr-u64 (bit-and-u64 x 18014398509481984) 30 in
    let t1 = wrapping-shr-u64 (bit-and-u64 x 134217728) 26 in
    let t2 = wrapping-shr-u64 (bit-and-u64 x 16777216) 24 in
    let t3 = wrapping-shr-u64 (bit-and-u64 x 562949953421312) 21 in
    let t4 = wrapping-shr-u64 (bit-and-u64 x 4503599627370496) 20 in
    let t5 = wrapping-shr-u64 (bit-and-u64 x 290271070781440) 18 in
    let t6 = wrapping-shr-u64 (bit-and-u64 x 4194304) 15 in
    let t7 = wrapping-shr-u64 (bit-and-u64 x 46161896180547584) 12 in
    let t8 = wrapping-shr-u64 (bit-and-u64 x 18691697672192) 11 in
