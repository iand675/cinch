  prim word-size32 :: U32 -> Bool where
    llvm {
      ret i8 1
    } when word-size 32
    llvm {
      ret i8 0
    }
  prim usize-to-u64 :: (x :: Usize) -> refined (r == x) U64 where
    llvm {
      %r = zext i32 %0 to i64
      ret i64 %r
    } when word-size 32
    llvm {
      ret i64 %0
    }
  prim isize-to-i64 :: (x :: Isize) -> refined (r == x) I64 where
    llvm {
      %r = sext i32 %0 to i64
      ret i64 %r
    } when word-size 32
    llvm {
      ret i64 %0
    }
  prim u64-to-usize :: (x :: U64) -> refined (r == x) Usize where
    llvm {
      %r = trunc i64 %0 to i32
      ret i32 %r
    } when word-size 32
    llvm {
      ret i64 %0
    }
  prim i64-to-isize :: (x :: I64) -> refined (r == x) Isize where
    llvm {
      %r = trunc i64 %0 to i32
      ret i32 %r
    } when word-size 32
    llvm {
      ret i64 %0
    }
  prim wrapping-u64-to-usize :: U64 -> Usize where
    llvm {
      %r = trunc i64 %0 to i32
      ret i32 %r
    } when word-size 32
    llvm {
      ret i64 %0
    }
  prim wrapping-i64-to-isize :: I64 -> Isize where
    llvm {
      %r = trunc i64 %0 to i32
      ret i32 %r
    } when word-size 32
    llvm {
      ret i64 %0
    }
  prim wrapping-usize-to-u32 :: Usize -> U32 where
    llvm {
      ret i32 %0
    } when word-size 32
    llvm {
      %r = trunc i64 %0 to i32
      ret i32 %r
    }
  prim wrapping-isize-to-i32 :: Isize -> I32 where
    llvm {
      ret i32 %0
    } when word-size 32
    llvm {
      %r = trunc i64 %0 to i32
      ret i32 %r
    }
  prim i8-to-isize :: (x :: I8) -> refined (InRange (-128) 127 r && r == x) Isize where
    llvm {
      %r = sext i8 %0 to i32
      ret i32 %r
    } when word-size 32
    llvm {
      %r = sext i8 %0 to i64
      ret i64 %r
    }
  prim i16-to-isize :: (x :: I16) -> refined (InRange (-32768) 32767 r && r == x) Isize where
    llvm {
      %r = sext i16 %0 to i32
      ret i32 %r
    } when word-size 32
    llvm {
      %r = sext i16 %0 to i64
      ret i64 %r
    }
  prim i32-to-isize :: (x :: I32) -> refined (InRange (-2147483648) 2147483647 r && r == x) Isize where
    llvm {
      ret i32 %0
    } when word-size 32
    llvm {
      %r = sext i32 %0 to i64
      ret i64 %r
    }
  prim u8-to-usize :: (x :: U8) -> refined (InRange 0 255 r && r == x) Usize where
    llvm {
      %r = zext i8 %0 to i32
      ret i32 %r
    } when word-size 32
    llvm {
      %r = zext i8 %0 to i64
      ret i64 %r
    }
  prim u8-to-isize :: (x :: U8) -> refined (InRange 0 255 r && r == x) Isize where
    llvm {
      %r = zext i8 %0 to i32
      ret i32 %r
    } when word-size 32
    llvm {
      %r = zext i8 %0 to i64
      ret i64 %r
    }
  prim u16-to-usize :: (x :: U16) -> refined (InRange 0 65535 r && r == x) Usize where
    llvm {
      %r = zext i16 %0 to i32
      ret i32 %r
    } when word-size 32
    llvm {
      %r = zext i16 %0 to i64
      ret i64 %r
    }
  prim u16-to-isize :: (x :: U16) -> refined (InRange 0 65535 r && r == x) Isize where
    llvm {
      %r = zext i16 %0 to i32
      ret i32 %r
    } when word-size 32
    llvm {
      %r = zext i16 %0 to i64
      ret i64 %r
    }
  prim u32-to-usize :: (x :: U32) -> refined (InRange 0 4294967295 r && r == x) Usize where
    llvm {
      ret i32 %0
    } when word-size 32
    llvm {
      %r = zext i32 %0 to i64
      ret i64 %r
    }
  prim u32-to-isize :: (x :: U32) -> refined (InRange 0 4294967295 r && r == x) Isize where
    llvm {
      ret i32 %0
    } when word-size 32
    llvm {
      %r = zext i32 %0 to i64
      ret i64 %r
    }
  prim wrapping-add-i8 :: I8 -> I8 -> I8 where
    llvm {
      %r = add i8 %0, %1
      ret i8 %r
    }
  prim wrapping-sub-i8 :: I8 -> I8 -> I8 where
    llvm {
      %r = sub i8 %0, %1
      ret i8 %r
    }
  prim wrapping-mul-i8 :: I8 -> I8 -> I8 where
    llvm {
      %r = mul i8 %0, %1
      ret i8 %r
    }
  prim wrapping-neg-i8 :: I8 -> I8 where
    llvm {
      %r = sub i8 0, %0
      ret i8 %r
    }
  prim saturating-add-i8 :: I8 -> I8 -> I8 where
    llvm {
      %r = call i8 @llvm.sadd.sat.i8(i8 %0, i8 %1)
      ret i8 %r
    }
  prim saturating-sub-i8 :: I8 -> I8 -> I8 where
    llvm {
      %r = call i8 @llvm.ssub.sat.i8(i8 %0, i8 %1)
      ret i8 %r
    }
  prim saturating-mul-i8 :: I8 -> I8 -> I8 where
    llvm {
      %res = call { i8, i1 } @llvm.smul.with.overflow.i8(i8 %0, i8 %1)
      %val = extractvalue { i8, i1 } %res, 0
      %ov = extractvalue { i8, i1 } %res, 1
      %sa = icmp slt i8 %0, 0
      %sb = icmp slt i8 %1, 0
      %same = icmp eq i1 %sa, %sb
      %bound = select i1 %same, i8 127, i8 -128
      %r = select i1 %ov, i8 %bound, i8 %val
      ret i8 %r
    }
  prim ov-add-i8 :: I8 -> I8 -> Bool where
    llvm {
      %res = call { i8, i1 } @llvm.sadd.with.overflow.i8(i8 %0, i8 %1)
      %ov = extractvalue { i8, i1 } %res, 1
      %r = zext i1 %ov to i8
      ret i8 %r
    }
  prim ov-sub-i8 :: I8 -> I8 -> Bool where
    llvm {
      %res = call { i8, i1 } @llvm.ssub.with.overflow.i8(i8 %0, i8 %1)
      %ov = extractvalue { i8, i1 } %res, 1
      %r = zext i1 %ov to i8
      ret i8 %r
    }
  prim ov-mul-i8 :: I8 -> I8 -> Bool where
    llvm {
      %res = call { i8, i1 } @llvm.smul.with.overflow.i8(i8 %0, i8 %1)
      %ov = extractvalue { i8, i1 } %res, 1
      %r = zext i1 %ov to i8
      ret i8 %r
    }
  prim raw-sdiv-i8 :: I8 -> I8 -> I8 where
    llvm {
      %r = sdiv i8 %0, %1
      ret i8 %r
    }
  prim raw-srem-i8 :: I8 -> I8 -> I8 where
    llvm {
      %r = srem i8 %0, %1
      ret i8 %r
    }
  prim bit-and-i8 :: I8 -> I8 -> I8 where
    llvm {
      %r = and i8 %0, %1
      ret i8 %r
    }
  prim bit-or-i8 :: I8 -> I8 -> I8 where
    llvm {
      %r = or i8 %0, %1
      ret i8 %r
    }
  prim bit-xor-i8 :: I8 -> I8 -> I8 where
    llvm {
      %r = xor i8 %0, %1
      ret i8 %r
    }
  prim bit-not-i8 :: I8 -> I8 where
    llvm {
      %r = xor i8 %0, -1
      ret i8 %r
    }
  prim wrapping-shl-i8 :: I8 -> U32 -> I8 where
    llvm {
      %m = and i32 %1, 7
      %s = trunc i32 %m to i8
      %r = shl i8 %0, %s
      ret i8 %r
    }
  prim wrapping-shr-i8 :: I8 -> U32 -> I8 where
    llvm {
      %m = and i32 %1, 7
      %s = trunc i32 %m to i8
      %r = ashr i8 %0, %s
      ret i8 %r
    }
  prim rotate-left-i8 :: I8 -> U32 -> I8 where
    llvm {
      %s = trunc i32 %1 to i8
      %r = call i8 @llvm.fshl.i8(i8 %0, i8 %0, i8 %s)
      ret i8 %r
    }
  prim rotate-right-i8 :: I8 -> U32 -> I8 where
    llvm {
      %s = trunc i32 %1 to i8
      %r = call i8 @llvm.fshr.i8(i8 %0, i8 %0, i8 %s)
      ret i8 %r
    }
  prim count-ones-i8 :: I8 -> U32 where
    llvm {
      %c = call i8 @llvm.ctpop.i8(i8 %0)
      %r = zext i8 %c to i32
      ret i32 %r
    }
  prim leading-zeros-i8 :: I8 -> U32 where
    llvm {
      %c = call i8 @llvm.ctlz.i8(i8 %0, i1 false)
      %r = zext i8 %c to i32
      ret i32 %r
    }
  prim trailing-zeros-i8 :: I8 -> U32 where
    llvm {
      %c = call i8 @llvm.cttz.i8(i8 %0, i1 false)
      %r = zext i8 %c to i32
      ret i32 %r
    }
  prim reverse-bits-i8 :: I8 -> I8 where
    llvm {
      %r = call i8 @llvm.bitreverse.i8(i8 %0)
      ret i8 %r
    }
  prim eq-i8 :: I8 -> I8 -> Bool where
    llvm {
      %c = icmp eq i8 %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    }
  prim ne-i8 :: I8 -> I8 -> Bool where
    llvm {
      %c = icmp ne i8 %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    }
  prim lt-i8 :: I8 -> I8 -> Bool where
    llvm {
      %c = icmp slt i8 %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    }
  prim le-i8 :: I8 -> I8 -> Bool where
    llvm {
      %c = icmp sle i8 %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    }
  prim gt-i8 :: I8 -> I8 -> Bool where
    llvm {
      %c = icmp sgt i8 %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    }
  prim ge-i8 :: I8 -> I8 -> Bool where
    llvm {
      %c = icmp sge i8 %0, %1
      %r = zext i1 %c to i8
      ret i8 %r
    }
  prim wrapping-add-i16 :: I16 -> I16 -> I16 where
    llvm {
      %r = add i16 %0, %1
      ret i16 %r
    }
  prim wrapping-sub-i16 :: I16 -> I16 -> I16 where
    llvm {
      %r = sub i16 %0, %1
      ret i16 %r
    }
  prim wrapping-mul-i16 :: I16 -> I16 -> I16 where
    llvm {
      %r = mul i16 %0, %1
      ret i16 %r
    }
  prim wrapping-neg-i16 :: I16 -> I16 where
    llvm {
      %r = sub i16 0, %0
      ret i16 %r
    }
  prim saturating-add-i16 :: I16 -> I16 -> I16 where
    llvm {
      %r = call i16 @llvm.sadd.sat.i16(i16 %0, i16 %1)
      ret i16 %r
    }
  prim saturating-sub-i16 :: I16 -> I16 -> I16 where
    llvm {
      %r = call i16 @llvm.ssub.sat.i16(i16 %0, i16 %1)
      ret i16 %r
    }
  prim saturating-mul-i16 :: I16 -> I16 -> I16 where
    llvm {
      %res = call { i16, i1 } @llvm.smul.with.overflow.i16(i16 %0, i16 %1)
      %val = extractvalue { i16, i1 } %res, 0
      %ov = extractvalue { i16, i1 } %res, 1
      %sa = icmp slt i16 %0, 0
      %sb = icmp slt i16 %1, 0
      %same = icmp eq i1 %sa, %sb
      %bound = select i1 %same, i16 32767, i16 -32768
      %r = select i1 %ov, i16 %bound, i16 %val
      ret i16 %r
    }
  prim ov-add-i16 :: I16 -> I16 -> Bool where
    llvm {
      %res = call { i16, i1 } @llvm.sadd.with.overflow.i16(i16 %0, i16 %1)
      %ov = extractvalue { i16, i1 } %res, 1
      %r = zext i1 %ov to i8
      ret i8 %r
    }
  prim ov-sub-i16 :: I16 -> I16 -> Bool where
    llvm {
      %res = call { i16, i1 } @llvm.ssub.with.overflow.i16(i16 %0, i16 %1)
      %ov = extractvalue { i16, i1 } %res, 1
      %r = zext i1 %ov to i8
      ret i8 %r
    }
  prim ov-mul-i16 :: I16 -> I16 -> Bool where
    llvm {
      %res = call { i16, i1 } @llvm.smul.with.overflow.i16(i16 %0, i16 %1)
      %ov = extractvalue { i16, i1 } %res, 1
      %r = zext i1 %ov to i8
      ret i8 %r
    }
  prim raw-sdiv-i16 :: I16 -> I16 -> I16 where
    llvm {
      %r = sdiv i16 %0, %1
      ret i16 %r
    }
  prim raw-srem-i16 :: I16 -> I16 -> I16 where
    llvm {
      %r = srem i16 %0, %1
      ret i16 %r
    }
  prim bit-and-i16 :: I16 -> I16 -> I16 where
    llvm {
      %r = and i16 %0, %1
      ret i16 %r
    }
  prim bit-or-i16 :: I16 -> I16 -> I16 where
    llvm {
      %r = or i16 %0, %1
      ret i16 %r
    }
  prim bit-xor-i16 :: I16 -> I16 -> I16 where
    llvm {
      %r = xor i16 %0, %1
      ret i16 %r
