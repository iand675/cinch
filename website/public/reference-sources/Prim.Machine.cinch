  prim rotate-right-i16 :: I16 -> U32 -> I16 where
    llvm {
      %s = trunc i32 %1 to i16
      %r = call i16 @llvm.fshr.i16(i16 %0, i16 %0, i16 %s)
      ret i16 %r
