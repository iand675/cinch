  prim f64-fits-i8 :: F64 -> Bool where
    llvm {
      %lo = fcmp ogt double %0, 0xC060200000000000
      %hi = fcmp olt double %0, 0x4060000000000000
      %ok = and i1 %lo, %hi
      %r = zext i1 %ok to i8
      ret i8 %r
    }
