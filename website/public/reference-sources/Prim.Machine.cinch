  prim wrapping-shl-i16 :: I16 -> U32 -> I16 where
    llvm {
      %m = and i32 %1, 15
      %s = trunc i32 %m to i16
      %r = shl i16 %0, %s
      ret i16 %r
    }
  prim wrapping-shr-i16 :: I16 -> U32 -> I16 where
    llvm {
      %m = and i32 %1, 15
      %s = trunc i32 %m to i16
      %r = ashr i16 %0, %s
      ret i16 %r
