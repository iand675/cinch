  -- | Multiply two GHASH field elements with PCLMULQDQ. Callers select it only after detection succeeds; other targets keep the identity body, which is never selected.
  prim ghash-multiply-clmul :: U128 -> U128 -> U128 where
    unsafe llvm {
      %g1 = call i128 @llvm.bswap.i128(i128 %0)
      %g2 = call i128 @llvm.bswap.i128(i128 %1)
      %g3 = bitcast i128 %g1 to <2 x i64>
      %g4 = bitcast i128 %g2 to <2 x i64>
      %q5 = call <2 x i64> asm "pclmulqdq $$0, $2, $0", "=x,0,x"(<2 x i64> %g3, <2 x i64> %g4)
      %q6 = call <2 x i64> asm "pclmulqdq $$17, $2, $0", "=x,0,x"(<2 x i64> %g3, <2 x i64> %g4)
      %q7 = call <2 x i64> asm "pclmulqdq $$1, $2, $0", "=x,0,x"(<2 x i64> %g3, <2 x i64> %g4)
      %q8 = call <2 x i64> asm "pclmulqdq $$16, $2, $0", "=x,0,x"(<2 x i64> %g3, <2 x i64> %g4)
      %g9 = xor <2 x i64> %q7, %q8
      %l10 = extractelement <2 x i64> %q5, i64 0
      %l11 = extractelement <2 x i64> %q5, i64 1
      %l12 = extractelement <2 x i64> %g9, i64 0
      %g13 = xor i64 %l11, %l12
      %l14 = extractelement <2 x i64> %q6, i64 0
      %l15 = extractelement <2 x i64> %g9, i64 1
      %g16 = xor i64 %l14, %l15
      %l17 = extractelement <2 x i64> %q6, i64 1
      %n18 = shl i64 %l17, 1
      %n19 = lshr i64 %g16, 63
      %n20 = or i64 %n18, %n19
      %n21 = shl i64 %g16, 1
      %n22 = lshr i64 %g13, 63
      %n23 = or i64 %n21, %n22
      %n24 = shl i64 %g13, 1
      %n25 = lshr i64 %l10, 63
      %n26 = or i64 %n24, %n25
      %n27 = shl i64 %l10, 1
      %n28 = lshr i64 %n27, 1
      %n29 = xor i64 %n27, %n28
      %n30 = lshr i64 %n27, 2
      %n31 = lshr i64 %n27, 7
      %n32 = xor i64 %n30, %n31
      %n33 = xor i64 %n29, %n32
      %n34 = xor i64 %n23, %n33
      %n35 = shl i64 %n27, 63
      %n36 = shl i64 %n27, 62
      %n37 = xor i64 %n35, %n36
      %n38 = shl i64 %n27, 57
      %n39 = xor i64 %n37, %n38
      %n40 = xor i64 %n26, %n39
      %n41 = lshr i64 %n40, 1
      %n42 = xor i64 %n40, %n41
      %n43 = lshr i64 %n40, 2
      %n44 = lshr i64 %n40, 7
      %n45 = xor i64 %n43, %n44
      %n46 = xor i64 %n42, %n45
      %n47 = xor i64 %n20, %n46
      %n48 = shl i64 %n40, 63
      %n49 = shl i64 %n40, 62
      %n50 = xor i64 %n48, %n49
      %n51 = shl i64 %n40, 57
      %n52 = xor i64 %n50, %n51
      %n53 = xor i64 %n34, %n52
      %n54 = zext i64 %n53 to i128
      %n55 = zext i64 %n47 to i128
      %n56 = shl i128 %n55, 64
      %n57 = or i128 %n54, %n56
      %n58 = call i128 @llvm.bswap.i128(i128 %n57)
      ret i128 %n58
    } when arch x86_64
    llvm {
      ret i128 %0
    }

  -- | Report CPUID's PCLMULQDQ bit on x86-64 and zero elsewhere; detection never depends on key or message bytes.
  prim clmul-available :: U32 -> U32 where
    unsafe llvm {
      %regs = call { i32, i32, i32, i32 } asm "cpuid", "={ax},={bx},={cx},={dx},{ax},{cx}"(i32 1, i32 0)
      %ecx = extractvalue { i32, i32, i32, i32 } %regs, 2
      %bit = and i32 %ecx, 2
      ret i32 %bit
    } when arch x86_64
    llvm {
      ret i32 0
    }
