-- | Pure color values, explicit conversion models and immutable palettes.
-- Standard representations retain raw channel widths and model identity.
-- Canonical observation yields premultiplied16-bit RGBA in wider machine words.
-- Conversion rounding, first palette ties and zero-alpha behavior are explicit.
module Image.Color where

  import Data.Bool
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option

  export Color, ColorKind, ColorModel, ColorPalette
  export Rgba8Kind, Rgba16Kind, Nrgba8Kind, Nrgba16Kind, Alpha8Kind, Alpha16Kind, Gray8Kind, Gray16Kind, YcbcrKind, YcbcraKind, CmykKind, RgbaSourceKind
  export color-kind, color-source, color-rgba
  export color-model, color-model-total, color-model-kind, color-convert
  export color-palette, color-palette-colors, color-palette-index, color-palette-convert, color-palette-model
  export color-rgb-to-ycbcr, color-ycbcr-to-rgb, color-rgb-to-cmyk, color-cmyk-to-rgb
  export color-ycbcra-base, color-black, color-white, color-transparent, color-opaque
  export color-rgba8, color-rgba8-components, color-rgba8-model
  export color-rgba16, color-rgba16-components, color-rgba16-model
  export color-nrgba8, color-nrgba8-components, color-nrgba8-model
  export color-nrgba16, color-nrgba16-components, color-nrgba16-model
  export color-alpha8, color-alpha8-components, color-alpha8-model
  export color-alpha16, color-alpha16-components, color-alpha16-model
  export color-gray8, color-gray8-components, color-gray8-model
  export color-gray16, color-gray16-components, color-gray16-model
  export color-ycbcr, color-ycbcr-components, color-ycbcr-model
  export color-ycbcra, color-ycbcra-components, color-ycbcra-model
  export color-cmyk, color-cmyk-components, color-cmyk-model

  -- | Observable identity of each standard representation or custom channel source.
  data ColorKind where
    -- | The premultiplied8-bit red, green, blue and alpha representation.
    Rgba8Kind :: ColorKind
    -- | The premultiplied16-bit red, green, blue and alpha representation.
    Rgba16Kind :: ColorKind
    -- | The straight8-bit red, green, blue and alpha representation.
    Nrgba8Kind :: ColorKind
    -- | The straight16-bit red, green, blue and alpha representation.
    Nrgba16Kind :: ColorKind
    -- | The 8-bit alpha representation.
    Alpha8Kind :: ColorKind
    -- | The 16-bit alpha representation.
    Alpha16Kind :: ColorKind
    -- | The opaque8-bit gray representation.
    Gray8Kind :: ColorKind
    -- | The opaque16-bit gray representation.
    Gray16Kind :: ColorKind
    -- | The opaque8-bit luma and chroma representation.
    YcbcrKind :: ColorKind
    -- | The straight8-bit luma, chroma and alpha representation.
    YcbcraKind :: ColorKind
    -- | The opaque8-bit cyan, magenta, yellow and black representation.
    CmykKind :: ColorKind
    -- | A caller-supplied pure source of canonical premultiplied channels.
    RgbaSourceKind :: ColorKind

  -- | Opaque immutable color retaining its source identity and exact raw fields.
  data Color where
    -- | A standard representation with fixed-width channels in a logical packed word.
    StoredColor :: ColorKind -> U64 -> Color
    -- | A retained pure callback returning the four bounded canonical channels.
    SourceColor :: (Unit -> U64) -> Color

  -- | Explicit pure conversion capability with optional output for absent conversions.
  data ColorModel where
    -- | A standard conversion retaining its observable target kind.
    StandardModel :: ColorKind -> ColorModel
    -- | A retained caller callback whose absent result remains absent.
    CallbackModel :: (Color -> Option Color) -> ColorModel
    -- | An immutable palette returning the actual nearest original value.
    PaletteModel :: ColorPalette -> ColorModel

  -- | An immutable sequence; construction and observation preserve color identities.
  data ColorPalette where
    -- | Private sequence storage shared without mutable byte buffers.
    Palette :: List Color -> ColorPalette

  -- | Compare only explicit representation tags, without a global equality policy.
  same-kind :: ColorKind -> ColorKind -> Bool
  same-kind left right = case left of
    Rgba8Kind -> case right of Rgba8Kind -> True; _ -> False
    Rgba16Kind -> case right of Rgba16Kind -> True; _ -> False
    Nrgba8Kind -> case right of Nrgba8Kind -> True; _ -> False
    Nrgba16Kind -> case right of Nrgba16Kind -> True; _ -> False
    Alpha8Kind -> case right of Alpha8Kind -> True; _ -> False
    Alpha16Kind -> case right of Alpha16Kind -> True; _ -> False
    Gray8Kind -> case right of Gray8Kind -> True; _ -> False
    Gray16Kind -> case right of Gray16Kind -> True; _ -> False
    YcbcrKind -> case right of YcbcrKind -> True; _ -> False
    YcbcraKind -> case right of YcbcraKind -> True; _ -> False
    CmykKind -> case right of CmykKind -> True; _ -> False
    RgbaSourceKind -> case right of RgbaSourceKind -> True; _ -> False

  -- | Observe the retained representation without forcing a custom channel callback.
  color-kind :: Color -> ColorKind
  color-kind value = case value of StoredColor kind word -> kind; SourceColor callback -> RgbaSourceKind

  -- | Retain a pure callback; channels are sixteen-bit premultiplied values, not copied eagerly.
  color-source :: (Unit -> (U16, U16, U16, U16)) -> Color
  color-source callback = SourceColor (\unit -> case callback () of (r, g, b, a) -> pack16 r g b a)

  -- | Pack four bytes in logical low-to-high order, independent of memory endianness.
  pack8 :: U8 -> U8 -> U8 -> U8 -> U64
  pack8 r g b a = bit-or-u64 (u8-to-u64 r) (bit-or-u64 (wrapping-shl-u64 (u8-to-u64 g) 8) (bit-or-u64 (wrapping-shl-u64 (u8-to-u64 b) 16) (wrapping-shl-u64 (u8-to-u64 a) 24)))

  -- | Pack four sixteen-bit channels in logical low-to-high order.
  pack16 :: U16 -> U16 -> U16 -> U16 -> U64
  pack16 r g b a = bit-or-u64 (u16-to-u64 r) (bit-or-u64 (wrapping-shl-u64 (u16-to-u64 g) 16) (bit-or-u64 (wrapping-shl-u64 (u16-to-u64 b) 32) (wrapping-shl-u64 (u16-to-u64 a) 48)))

  -- | Extract a wrapped byte offset from a private logical packed representation.
  byte-at :: U64 -> U32 -> U8
  byte-at word shift = wrapping-u64-to-u8 (wrapping-shr-u64 word shift)

  -- | Extract a wrapped sixteen-bit offset from a private logical packed representation.
  short-at :: U64 -> U32 -> U16
  short-at word shift = wrapping-u64-to-u16 (wrapping-shr-u64 word shift)

  -- | Construct premultiplied8-bit red, green, blue and alpha; raw channels are retained without alpha clamping.
  color-rgba8 :: U8 -> U8 -> U8 -> U8 -> Color
  color-rgba8 r g b a = StoredColor Rgba8Kind (pack8 r g b a)

  -- | Observe exact raw rgba8 fields, returning absent for other representations.
  color-rgba8-components :: Color -> Option (U8, U8, U8, U8)
  color-rgba8-components value = case value of
    StoredColor Rgba8Kind word -> Some ((byte-at word 0, byte-at word 8, byte-at word 16, byte-at word 24))
    _ -> None

  -- | Convert to the rgba8 representation; already matching values retain their fields.
  color-rgba8-model :: ColorModel
  color-rgba8-model = StandardModel Rgba8Kind

  -- | Construct premultiplied16-bit red, green, blue and alpha; raw channels are retained without alpha clamping.
  color-rgba16 :: U16 -> U16 -> U16 -> U16 -> Color
  color-rgba16 r g b a = StoredColor Rgba16Kind (pack16 r g b a)

  -- | Observe exact raw rgba16 fields, returning absent for other representations.
  color-rgba16-components :: Color -> Option (U16, U16, U16, U16)
  color-rgba16-components value = case value of
    StoredColor Rgba16Kind word -> Some ((short-at word 0, short-at word 16, short-at word 32, short-at word 48))
    _ -> None

  -- | Convert to the rgba16 representation; already matching values retain their fields.
  color-rgba16-model :: ColorModel
  color-rgba16-model = StandardModel Rgba16Kind

  -- | Construct straight8-bit red, green, blue and alpha; raw channels are retained without alpha clamping.
  color-nrgba8 :: U8 -> U8 -> U8 -> U8 -> Color
  color-nrgba8 r g b a = StoredColor Nrgba8Kind (pack8 r g b a)

  -- | Observe exact raw nrgba8 fields, returning absent for other representations.
  color-nrgba8-components :: Color -> Option (U8, U8, U8, U8)
  color-nrgba8-components value = case value of
    StoredColor Nrgba8Kind word -> Some ((byte-at word 0, byte-at word 8, byte-at word 16, byte-at word 24))
    _ -> None

  -- | Convert to the nrgba8 representation; already matching values retain their fields.
  color-nrgba8-model :: ColorModel
  color-nrgba8-model = StandardModel Nrgba8Kind

  -- | Construct straight16-bit red, green, blue and alpha; raw channels are retained without alpha clamping.
  color-nrgba16 :: U16 -> U16 -> U16 -> U16 -> Color
  color-nrgba16 r g b a = StoredColor Nrgba16Kind (pack16 r g b a)

  -- | Observe exact raw nrgba16 fields, returning absent for other representations.
  color-nrgba16-components :: Color -> Option (U16, U16, U16, U16)
  color-nrgba16-components value = case value of
    StoredColor Nrgba16Kind word -> Some ((short-at word 0, short-at word 16, short-at word 32, short-at word 48))
    _ -> None

  -- | Convert to the nrgba16 representation; already matching values retain their fields.
  color-nrgba16-model :: ColorModel
  color-nrgba16-model = StandardModel Nrgba16Kind

  -- | Construct 8-bit alpha; raw channels are retained without alpha clamping.
  color-alpha8 :: U8 -> Color
  color-alpha8 channel = StoredColor Alpha8Kind (pack8 channel 0 0 0)

  -- | Observe exact raw alpha8 fields, returning absent for other representations.
  color-alpha8-components :: Color -> Option U8
  color-alpha8-components value = case value of
    StoredColor Alpha8Kind word -> Some (byte-at word 0)
    _ -> None

  -- | Convert to the alpha8 representation; already matching values retain their fields.
  color-alpha8-model :: ColorModel
  color-alpha8-model = StandardModel Alpha8Kind

  -- | Construct 16-bit alpha; raw channels are retained without alpha clamping.
  color-alpha16 :: U16 -> Color
  color-alpha16 channel = StoredColor Alpha16Kind (pack16 channel 0 0 0)

  -- | Observe exact raw alpha16 fields, returning absent for other representations.
  color-alpha16-components :: Color -> Option U16
  color-alpha16-components value = case value of
    StoredColor Alpha16Kind word -> Some (short-at word 0)
    _ -> None

  -- | Convert to the alpha16 representation; already matching values retain their fields.
  color-alpha16-model :: ColorModel
  color-alpha16-model = StandardModel Alpha16Kind

  -- | Construct opaque8-bit gray; raw channels are retained without alpha clamping.
  color-gray8 :: U8 -> Color
  color-gray8 channel = StoredColor Gray8Kind (pack8 channel 0 0 0)

  -- | Observe exact raw gray8 fields, returning absent for other representations.
  color-gray8-components :: Color -> Option U8
  color-gray8-components value = case value of
    StoredColor Gray8Kind word -> Some (byte-at word 0)
    _ -> None

  -- | Convert to the gray8 representation; already matching values retain their fields.
  color-gray8-model :: ColorModel
  color-gray8-model = StandardModel Gray8Kind

  -- | Construct opaque16-bit gray; raw channels are retained without alpha clamping.
  color-gray16 :: U16 -> Color
  color-gray16 channel = StoredColor Gray16Kind (pack16 channel 0 0 0)

  -- | Observe exact raw gray16 fields, returning absent for other representations.
  color-gray16-components :: Color -> Option U16
  color-gray16-components value = case value of
    StoredColor Gray16Kind word -> Some (short-at word 0)
    _ -> None

  -- | Convert to the gray16 representation; already matching values retain their fields.
  color-gray16-model :: ColorModel
  color-gray16-model = StandardModel Gray16Kind

  -- | Construct opaque8-bit luma and chroma; raw channels are retained without alpha clamping.
  color-ycbcr :: U8 -> U8 -> U8 -> Color
  color-ycbcr y cb cr = StoredColor YcbcrKind (pack8 y cb cr 0)

  -- | Observe exact raw ycbcr fields, returning absent for other representations.
  color-ycbcr-components :: Color -> Option (U8, U8, U8)
  color-ycbcr-components value = case value of
    StoredColor YcbcrKind word -> Some ((byte-at word 0, byte-at word 8, byte-at word 16))
    _ -> None

  -- | Convert to the ycbcr representation; already matching values retain their fields.
  color-ycbcr-model :: ColorModel
  color-ycbcr-model = StandardModel YcbcrKind

  -- | Construct straight8-bit luma, chroma and alpha; raw channels are retained without alpha clamping.
  color-ycbcra :: U8 -> U8 -> U8 -> U8 -> Color
  color-ycbcra y cb cr a = StoredColor YcbcraKind (pack8 y cb cr a)

  -- | Observe exact raw ycbcra fields, returning absent for other representations.
  color-ycbcra-components :: Color -> Option (U8, U8, U8, U8)
  color-ycbcra-components value = case value of
    StoredColor YcbcraKind word -> Some ((byte-at word 0, byte-at word 8, byte-at word 16, byte-at word 24))
    _ -> None

  -- | Convert to the ycbcra representation; already matching values retain their fields.
  color-ycbcra-model :: ColorModel
  color-ycbcra-model = StandardModel YcbcraKind

  -- | Construct opaque8-bit cyan, magenta, yellow and black; raw channels are retained without alpha clamping.
  color-cmyk :: U8 -> U8 -> U8 -> U8 -> Color
  color-cmyk c m y k = StoredColor CmykKind (pack8 c m y k)

  -- | Observe exact raw cmyk fields, returning absent for other representations.
  color-cmyk-components :: Color -> Option (U8, U8, U8, U8)
  color-cmyk-components value = case value of
    StoredColor CmykKind word -> Some ((byte-at word 0, byte-at word 8, byte-at word 16, byte-at word 24))
    _ -> None

  -- | Convert to the cmyk representation; already matching values retain their fields.
  color-cmyk-model :: ColorModel
  color-cmyk-model = StandardModel CmykKind

  -- | Observe the embedded luma/chroma value without changing the independent alpha channel.
  color-ycbcra-base :: Color -> Option Color
  color-ycbcra-base value = case value of
    StoredColor YcbcraKind word -> Some (color-ycbcr (byte-at word 0) (byte-at word 8) (byte-at word 16))
    _ -> None

  -- | Preserve the conventional opaque black grayscale representation.
  color-black :: Color
  color-black = color-gray16 0

  -- | Preserve the conventional opaque white grayscale representation.
  color-white :: Color
  color-white = color-gray16 65535

  -- | Preserve the zero-alpha-only representation of transparency.
  color-transparent :: Color
  color-transparent = color-alpha16 0

  -- | Preserve the full-alpha-only representation of opacity.
  color-opaque :: Color
  color-opaque = color-alpha16 65535

  -- | Retain a pure model callback including its possible absent result.
  color-model :: (Color -> Option Color) -> ColorModel
  color-model callback = CallbackModel callback

  -- | Retain a total pure model callback, wrapping its returned color as present.
  color-model-total :: (Color -> Color) -> ColorModel
  color-model-total callback = CallbackModel (\value -> Some (callback value))

  -- | Observe a standard target kind; callbacks and palettes have no standard target tag.
  color-model-kind :: ColorModel -> Option ColorKind
  color-model-kind model = case model of StandardModel kind -> Some kind; _ -> None

  -- | Dispatch an explicit conversion without adding mutable state or hidden registration.
  color-convert :: ColorModel -> Color -> Option Color
  color-convert model value = case model of
    StandardModel kind -> Some (convert-standard kind value)
    CallbackModel callback -> callback value
    PaletteModel palette -> color-palette-convert palette value

  -- | Observe sixteen-bit premultiplied channels widened for multiplication without overflow.
  color-rgba :: Color -> (U32, U32, U32, U32)
  color-rgba value = let word = rgba-word value in
    (u16-to-u32 (short-at word 0), u16-to-u32 (short-at word 16), u16-to-u32 (short-at word 32), u16-to-u32 (short-at word 48))

  -- | Expand a bounded scalar channel into all four sixteen-bit lanes.
  repeated-word :: U16 -> U64
  repeated-word channel = pack16 channel channel channel channel

  -- | Observe the exact16-bit value without an intervening8-bit conversion.
  rgba-word :: Color -> U64
  rgba-word value = case value of
    SourceColor callback -> callback ()
    StoredColor kind word -> case kind of
      Rgba8Kind -> expand8 word
      Rgba16Kind -> word
      Nrgba8Kind -> premultiply (expand8 word)
      Nrgba16Kind -> premultiply word
      Alpha8Kind -> repeated-word (wrapping-mul-u16 (u8-to-u16 (byte-at word 0)) 257)
      Alpha16Kind -> repeated-word (short-at word 0)
      Gray8Kind -> let y = wrapping-mul-u16 (u8-to-u16 (byte-at word 0)) 257 in pack16 y y y 65535
      Gray16Kind -> let y = short-at word 0 in pack16 y y y 65535
      YcbcrKind -> ycbcr16 word
      YcbcraKind -> let rgb = ycbcr16 word in premultiply (pack16 (short-at rgb 0) (short-at rgb 16) (short-at rgb 32) (wrapping-mul-u16 (u8-to-u16 (byte-at word 24)) 257))
      CmykKind -> cmyk16 word
      RgbaSourceKind -> word

  -- | Reduce high bytes only after all sixteen-bit arithmetic is complete.
  narrow8 :: U64 -> U64
  narrow8 word = pack8 (wrapping-u16-to-u8 (wrapping-shr-u16 (short-at word 0) 8)) (wrapping-u16-to-u8 (wrapping-shr-u16 (short-at word 16) 8)) (wrapping-u16-to-u8 (wrapping-shr-u16 (short-at word 32) 8)) (wrapping-u16-to-u8 (wrapping-shr-u16 (short-at word 48) 8))

  -- | Preserve same-model fields, otherwise perform the exact target rounding sequence.
  convert-standard :: ColorKind -> Color -> Color
  convert-standard kind value = if same-kind kind (color-kind value) then value else
    let word = rgba-word value in
    case kind of
      Rgba8Kind -> StoredColor kind (narrow8 word)
      Rgba16Kind -> StoredColor kind word
      Nrgba8Kind -> StoredColor kind (narrow8 (if eq-u16 (short-at word 48) 0 then 0 else unpremultiply word))
      Nrgba16Kind -> StoredColor kind (if eq-u16 (short-at word 48) 0 then 0 else unpremultiply word)
      Alpha8Kind -> color-alpha8 (wrapping-u16-to-u8 (wrapping-shr-u16 (short-at word 48) 8))
      Alpha16Kind -> color-alpha16 (short-at word 48)
      Gray8Kind -> color-gray8 (wrapping-u32-to-u8 (wrapping-shr-u32 (gray-sum word) 24))
      Gray16Kind -> color-gray16 (wrapping-u32-to-u16 (wrapping-shr-u32 (gray-sum word) 16))
      YcbcrKind -> StoredColor kind (rgb-ycbcr (narrow8 word))
      YcbcraKind -> case value of
        StoredColor YcbcrKind raw -> StoredColor kind (bit-or-u64 raw 4278190080)
        _ -> StoredColor kind (bit-or-u64 (rgb-ycbcr (narrow8 (unpremultiply word))) (wrapping-shl-u64 (u8-to-u64 (wrapping-u16-to-u8 (wrapping-shr-u16 (short-at word 48) 8))) 24))
      CmykKind -> StoredColor kind (rgb-cmyk (narrow8 word))
      RgbaSourceKind -> value

  -- | Convert an8-bit RGB triple with exact fixed-point luma/chroma rounding.
  color-rgb-to-ycbcr :: U8 -> U8 -> U8 -> (U8, U8, U8)
  color-rgb-to-ycbcr r g b = let word = rgb-ycbcr (pack8 r g b 0) in (byte-at word 0, byte-at word 8, byte-at word 16)

  -- | Convert an8-bit luma/chroma triple with saturated channels and y-dependent rounding.
  color-ycbcr-to-rgb :: U8 -> U8 -> U8 -> (U8, U8, U8)
  color-ycbcr-to-rgb y cb cr = let word = narrow8 (ycbcr16 (pack8 y cb cr 0)) in (byte-at word 0, byte-at word 8, byte-at word 16)

  -- | Convert an8-bit RGB triple with the explicit all-black singularity.
  color-rgb-to-cmyk :: U8 -> U8 -> U8 -> (U8, U8, U8, U8)
  color-rgb-to-cmyk r g b = let word = rgb-cmyk (pack8 r g b 0) in (byte-at word 0, byte-at word 8, byte-at word 16, byte-at word 24)

  -- | Convert8-bit ink channels through16-bit products before reducing precision.
  color-cmyk-to-rgb :: U8 -> U8 -> U8 -> U8 -> (U8, U8, U8)
  color-cmyk-to-rgb c m y k = let word = narrow8 (cmyk16 (pack8 c m y k)) in (byte-at word 0, byte-at word 8, byte-at word 16)

  -- | Capture an immutable color sequence, including an explicit empty palette.
  color-palette :: List Color -> ColorPalette
  color-palette colors = Palette colors

  -- | Observe the same immutable color values in their original order.
  color-palette-colors :: ColorPalette -> List Color
  color-palette-colors palette = case palette of Palette colors -> colors

  -- | Treat a palette as an explicit model; empty conversion remains absent.
  color-palette-model :: ColorPalette -> ColorModel
  color-palette-model palette = PaletteModel palette

  -- | Return the first nearest index using all four premultiplied channels; empty is zero.
  color-palette-index :: ColorPalette -> Color -> Nat
  color-palette-index palette value = case palette of
    Palette colors -> case nearest colors (rgba-word value) 0 4294967295 None of
      None -> 0
      Some (index, selected) -> index

  -- | Return the original nearest color, with absence for an empty palette.
  color-palette-convert :: ColorPalette -> Color -> Option Color
  color-palette-convert palette value = case palette of
    Palette colors -> case colors of
      Nil -> None
      Cons first tail -> case nearest colors (rgba-word value) 0 4294967295 None of
        None -> None
        Some (index, selected) -> Some selected

  -- | Traverse in order; per-channel squared distances are truncated before summing.
  nearest :: List Color -> U64 -> Nat -> U32 -> Option (Nat, Color) -> Option (Nat, Color)
  nearest colors query index best selected = case colors of
    Nil -> selected
    Cons candidate tail -> let distance = distance4 query (rgba-word candidate) in
      if lt-u32 distance best then
        if eq-u32 distance 0 then Some (index, candidate)
        else nearest tail query (index + 1) distance (Some (index, candidate))
      else nearest tail query (index + 1) best selected

  -- | Clamp a signed 32-bit value to the inclusive range [lo, hi].
  clamp-i32 :: I32 -> I32 -> I32 -> I32
  clamp-i32 x lo hi = if lt-i32 x lo then lo else if gt-i32 x hi then hi else x

  -- | Expand four packed bytes to sixteen-bit lanes by exact byte duplication.
  expand8 :: U64 -> U64
  expand8 w =
    let lo16 = bit-and-u64 w 65535 in
    let hi16 = bit-and-u64 w 4294901760 in
    let s1 = bit-or-u64 lo16 (wrapping-shl-u64 hi16 16) in
    let ev = bit-and-u64 s1 1095216660735 in
    let od = bit-and-u64 s1 280375465148160 in
    let s2 = bit-or-u64 ev (wrapping-shl-u64 od 8) in
    bit-or-u64 s2 (wrapping-shl-u64 s2 8)

  -- | Multiply straight RGB by alpha with exact truncating division; alpha stays unchanged.
  premultiply :: U64 -> U64
  premultiply w =
    let a16 = short-at w 48 in
    let a = u16-to-u32 a16 in
    let r = wrapping-u32-to-u16 (div-u32 (wrapping-mul-u32 (u16-to-u32 (short-at w 0)) a) 65535) in
    let g = wrapping-u32-to-u16 (div-u32 (wrapping-mul-u32 (u16-to-u32 (short-at w 16)) a) 65535) in
    let b = wrapping-u32-to-u16 (div-u32 (wrapping-mul-u32 (u16-to-u32 (short-at w 32)) a) 65535) in
    pack16 r g b a16

  -- | Unpremultiply bounded channels; zero alpha leaves the input for explicit caller policy.
  unpremultiply :: U64 -> U64
  unpremultiply w =
    let a16 = short-at w 48 in
    let a = u16-to-u32 a16 in
    if a /= 0 then
      let r = wrapping-u32-to-u16 (div-u32 (wrapping-mul-u32 (u16-to-u32 (short-at w 0)) 65535) a) in
      let g = wrapping-u32-to-u16 (div-u32 (wrapping-mul-u32 (u16-to-u32 (short-at w 16)) 65535) a) in
      let b = wrapping-u32-to-u16 (div-u32 (wrapping-mul-u32 (u16-to-u32 (short-at w 32)) 65535) a) in
      pack16 r g b a16
    else w

  -- | Accumulate exact grayscale coefficients and rounding within the proved32-bit bound.
  gray-sum :: U64 -> U32
  gray-sum w =
    let r = wrapping-mul-u32 (u16-to-u32 (short-at w 0)) 19595 in
    let g = wrapping-mul-u32 (u16-to-u32 (short-at w 16)) 38470 in
    let b = wrapping-mul-u32 (u16-to-u32 (short-at w 32)) 7471 in
    wrapping-add-u32 (wrapping-add-u32 (wrapping-add-u32 r g) b) 32768

  -- | Convert packed luma/chroma directly to saturated16-bit RGB with full fixed-point precision.
  ycbcr16 :: U64 -> U64
  ycbcr16 w =
    let yy = wrapping-mul-i32 (u8-to-i32 (byte-at w 0)) 65793 in
    let cb = wrapping-sub-i32 (u8-to-i32 (byte-at w 8)) 128 in
    let cr = wrapping-sub-i32 (u8-to-i32 (byte-at w 16)) 128 in
    let rterm = wrapping-add-i32 yy (wrapping-mul-i32 cr 91881) in
    let gterm = wrapping-sub-i32 yy (wrapping-add-i32 (wrapping-mul-i32 cb 22554) (wrapping-mul-i32 cr 46802)) in
    let bterm = wrapping-add-i32 yy (wrapping-mul-i32 cb 116130) in
    let r = wrapping-i32-to-u16 (clamp-i32 (wrapping-shr-i32 rterm 8) 0 65535) in
    let g = wrapping-i32-to-u16 (clamp-i32 (wrapping-shr-i32 gterm 8) 0 65535) in
    let b = wrapping-i32-to-u16 (clamp-i32 (wrapping-shr-i32 bterm 8) 0 65535) in
    pack16 r g b 65535

  -- | Convert8-bit RGB to fixed-point luma/chroma with explicit saturated rounding.
  rgb-ycbcr :: U64 -> U64
  rgb-ycbcr w =
    let r = u8-to-i32 (byte-at w 0) in
    let g = u8-to-i32 (byte-at w 8) in
    let b = u8-to-i32 (byte-at w 16) in
    let ysum = wrapping-add-i32 (wrapping-add-i32 (wrapping-add-i32 (wrapping-mul-i32 r 19595) (wrapping-mul-i32 g 38470)) (wrapping-mul-i32 b 7471)) 32768 in
    let cbsum = wrapping-add-i32 (wrapping-add-i32 (wrapping-add-i32 (wrapping-mul-i32 r (-11056)) (wrapping-mul-i32 g (-21712))) (wrapping-mul-i32 b 32768)) 8421376 in
    let crsum = wrapping-add-i32 (wrapping-add-i32 (wrapping-add-i32 (wrapping-mul-i32 r 32768) (wrapping-mul-i32 g (-27440))) (wrapping-mul-i32 b (-5328))) 8421376 in
    let y = wrapping-i32-to-u8 (clamp-i32 (wrapping-shr-i32 ysum 16) 0 255) in
    let cb = wrapping-i32-to-u8 (clamp-i32 (wrapping-shr-i32 cbsum 16) 0 255) in
    let cr = wrapping-i32-to-u8 (clamp-i32 (wrapping-shr-i32 crsum 16) 0 255) in
    pack8 y cb cr 0

  -- | Return the larger of two unsigned 32-bit values.
  max-u32 :: U32 -> U32 -> U32
  max-u32 a b = if gt-u32 a b then a else b

  -- | Convert RGB through its maximum channel, keeping all-black division explicitly guarded.
  rgb-cmyk :: U64 -> U64
  rgb-cmyk w =
    let r = u8-to-u32 (byte-at w 0) in
    let g = u8-to-u32 (byte-at w 8) in
    let b = u8-to-u32 (byte-at w 16) in
    let white = max-u32 (max-u32 r g) b in
    let k = wrapping-u32-to-u8 (wrapping-sub-u32 255 white) in
    if white /= 0 then
      let c = wrapping-u32-to-u8 (div-u32 (wrapping-mul-u32 (wrapping-sub-u32 white r) 255) white) in
      let m = wrapping-u32-to-u8 (div-u32 (wrapping-mul-u32 (wrapping-sub-u32 white g) 255) white) in
      let y = wrapping-u32-to-u8 (div-u32 (wrapping-mul-u32 (wrapping-sub-u32 white b) 255) white) in
      pack8 c m y k
    else pack8 0 0 0 k

  -- | Convert ink channels through full16-bit products before any8-bit reduction.
  cmyk16 :: U64 -> U64
  cmyk16 w =
    let white = wrapping-sub-u32 65535 (wrapping-mul-u32 (u8-to-u32 (byte-at w 24)) 257) in
    let r = wrapping-u32-to-u16 (div-u32 (wrapping-mul-u32 (wrapping-sub-u32 65535 (wrapping-mul-u32 (u8-to-u32 (byte-at w 0)) 257)) white) 65535) in
    let g = wrapping-u32-to-u16 (div-u32 (wrapping-mul-u32 (wrapping-sub-u32 65535 (wrapping-mul-u32 (u8-to-u32 (byte-at w 8)) 257)) white) 65535) in
    let b = wrapping-u32-to-u16 (div-u32 (wrapping-mul-u32 (wrapping-sub-u32 65535 (wrapping-mul-u32 (u8-to-u32 (byte-at w 16)) 257)) white) 65535) in
    pack16 r g b 65535

  -- | Compute one channel's truncated squared 16-bit difference.
  sq-diff-u16 :: U16 -> U16 -> U32
  sq-diff-u16 x y =
    let d = wrapping-sub-u32 (u16-to-u32 x) (u16-to-u32 y) in
    wrapping-shr-u32 (wrapping-mul-u32 d d) 2

  -- | Sum four squared16-bit differences after per-lane truncation, without overflowing32 bits.
  distance4 :: U64 -> U64 -> U32
  distance4 left right =
    let r = sq-diff-u16 (short-at left 0) (short-at right 0) in
    let g = sq-diff-u16 (short-at left 16) (short-at right 16) in
    let b = sq-diff-u16 (short-at left 32) (short-at right 32) in
    let a = sq-diff-u16 (short-at left 48) (short-at right 48) in
    wrapping-add-u32 (wrapping-add-u32 r g) (wrapping-add-u32 b a)
