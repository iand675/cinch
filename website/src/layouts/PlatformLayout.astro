---
import Brand from '../components/Brand.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import ThemeInit from '../components/ThemeInit.astro';
import ThemeControl from '../components/ThemeControl.astro';
import { project } from '../lib/project';
import '../styles/custom.css';
import '../styles/platform.css';
import '../styles/platform-theme.css';
interface Props { title:string; description:string; section?:string; sample?:boolean; }
const {title,description,section='',sample=true}=Astro.props;
---
<!doctype html>
<html lang="en" class="cinch-platform" data-theme="light">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <title>{title} — Cinch</title><meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    {sample&&<meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#191a17" /><link rel="icon" href="/favicon.svg" />
    <ThemeInit />
    <link rel="preload" href="/fonts/momo-trust-display.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="platform-skip" href="#main">Skip to content</a>
    <header class="platform-header"><Brand /><SiteNavigation current={section}/><ThemeControl /></header>
    <main id="main" class="platform-main"><slot /></main>
    <footer class="platform-footer"><Brand /><div><a href="/overview/">Documentation</a><a href="/packages/">Packages</a><a href="/downloads/">Downloads</a><a href={project.repository}>GitHub ↗</a></div></footer>
  </body>
</html>
