---
// The checked `payload` from src/data/examples/payload-checked.cinch, run
// against one fixed message. The dial sets the message's length byte; the
// screen shows which bytes the copy would cover and what payload returns.
const payloadText = 'hello';
const maxClaim = 7;
const initial = 3;
---
<section class="contract-console" aria-labelledby="console-title">
  <div class="case-fittings" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="case-spine" aria-hidden="true"><i></i><span></span><i></i></div>
  <div class="console-label"><span class="mono" id="console-title">INTERACTIVE EXAMPLE</span><span class="console-vents" aria-hidden="true"></span></div>
  <div class="display-bezel">
    <div class="contract-screen" data-contract-screen>
      <div class="screen-header mono"><span>payload.cinch</span><span>msg = 6 bytes</span></div>
      <div class="screen-signature"><span>payload</span> <span class="screen-colon">:: Bytes → Option Bytes</span><br /><span class="screen-type">if 1 + n &lt;= bytes-len msg</span></div>
      <div class="message-strip" aria-hidden="true">
        <div class="message-cells">
          <span class="message-cell is-length" data-length-cell>{initial}</span>
          {[...payloadText].map((ch, i) => <span class="message-cell" data-byte-cell={i + 1} style={`--i:${i + 1}`}>{ch}</span>)}
          {[0, 1].map((i) => <span class="message-cell is-outside" data-byte-cell={payloadText.length + 1 + i} style={`--i:${payloadText.length + 1 + i}`}></span>)}
        </div>
        <div class="message-scale mono"><span>n</span><span>payload</span><span>past the end</span></div>
      </div>
      <div class="contract-result" aria-live="polite" aria-atomic="true">
        <div class="result-heading"><span class="result-lamp" aria-hidden="true"></span><strong data-result-title>Some "hel"</strong><span class="mono" data-result-equation>1 + 3 ≤ 6</span></div>
        <p data-result-description>The length byte fits the message, so payload copies 3 bytes.</p>
      </div>
    </div>
  </div>
  <div class="console-controls">
    <div class="length-control"><label class="mono" for="claim-length">LENGTH BYTE</label><div class="length-keys"><button type="button" data-length-step="-1" aria-label="Decrease the length byte">−</button><div class="length-dial"><output for="claim-length" id="length-readout">{initial}</output></div><button type="button" data-length-step="1" aria-label="Increase the length byte">+</button></div><input id="claim-length" type="range" min="0" max={maxClaim} value={initial} aria-label="Length byte" /></div>
    <a href="#bounds" class="example-key"><span class="mono">THE SOURCE</span><span>Why this matters <span aria-hidden="true">↓</span></span></a>
  </div>
  <div class="console-bottom mono"><span>Raise the length byte past 5 to claim more than the message holds.</span></div>
</section>
<script define:vars={{ payloadText, maxClaim }}>
  const range = document.querySelector('#claim-length');
  if (range) {
    const total = payloadText.length + 1;
    const steps = document.querySelectorAll('[data-length-step]');
    const render = () => {
      const n = Number(range.value);
      const fits = 1 + n <= total;
      document.querySelector('.length-dial')?.style.setProperty('--dial-angle', `${-120 + n * (240 / maxClaim)}deg`);
      document.querySelector('[data-contract-screen]')?.classList.toggle('is-empty', !fits);
      document.querySelector('#length-readout').textContent = String(n);
      document.querySelector('[data-length-cell]').textContent = String(n);
      document.querySelectorAll('[data-byte-cell]').forEach((cell) => {
        const i = Number(cell.dataset.byteCell);
        cell.classList.toggle('is-copied', i <= n && fits);
        cell.classList.toggle('is-overrun', i <= n && !fits);
      });
      document.querySelector('[data-result-title]').textContent = fits ? `Some "${payloadText.slice(0, n)}"` : 'None';
      document.querySelector('[data-result-equation]').textContent = `1 + ${n} ${fits ? '≤' : '>'} ${total}`;
      document.querySelector('[data-result-description]').textContent = fits
        ? `The length byte fits the message, so payload copies ${n} ${n === 1 ? 'byte' : 'bytes'}.`
        : `The message claims ${n} bytes but carries ${payloadText.length}. The check fails and nothing is copied. Without the check, the copy does not compile.`;
      steps.forEach((button) => { button.disabled = Number(button.dataset.lengthStep) < 0 ? n === 0 : n === maxClaim; });
    };
    range.addEventListener('input', render);
    steps.forEach((button) => button.addEventListener('click', () => {
      range.value = String(Math.min(maxClaim, Math.max(0, Number(range.value) + Number(button.dataset.lengthStep))));
      render();
    }));
    render();
  }
</script>
