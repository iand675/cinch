---
import CodeExcerpt from './CodeExcerpt.astro';
import '../styles/language-tour.css';
const proofViews=[
  {id:'bounds',label:'Validated input',title:'Check once at the edge. Skip every check downstream.',description:'<code>checkedIndex</code> compares <code>i</code> against <code>n</code> once at run time. On success it returns a <code>Fin n</code>, an index the compiler knows is strictly below <code>n</code>, so every lookup downstream compiles without a bounds check. On failure it returns <code>None</code> and forces the caller to handle it.',code:String.raw`checkedIndex :: (n :: Nat) -> Nat -> Option (Fin n)
checkedIndex n i = case decide (i < n) of
  Yes bound -> Some (Fin i bound)
  No _ -> None`,caption:'The comparison runs once at the boundary. The evidence erases completely before code generation.',href:'/learn/13-refinements-and-safe-operations/',link:'Refinements and runtime checks'},
  {id:'refinements',label:'Refinement types',title:'Attach a guarantee without changing memory layout.',description:'<code>NonEmpty a</code> is an ordinary <code>List a</code> with one checked predicate attached. It has the exact same representation in memory and zero wrapper allocation. Operations preserve the fact whenever they maintain it, so appending two nonempty lists stays nonempty.',code:String.raw`type NonEmpty a =
  refine (xs :: List a) with NotNull xs

from-list :: List a -> Option (NonEmpty a)`,caption:'Refinements carry erased facts on existing representations; newtypes create distinct identities.',href:'/reference/06-refinements/',link:'Refinements and their laws'},
];
const bits=[1,0,1,1,0,0,1,0];
const consText=(values:number[])=>`${values.slice(0,3).map(v=>`Cons ${v?'True':'False'} (`).join('')}…${')'.repeat(3)}`;
const bitsText=(values:number[])=>`0b${values.join('')}`;
const representation=String.raw`implicit instance Bits :: Represent (List Bool) BitList where
  -- Builders and a view connect the two representations.
  Nil       = bit-list-empty
  Cons b bs = bit-list-cons b bs

  -- Fast paths keep the same public operations.
  specialize length = bit-list-length
  specialize index  = bit-list-index`;
const xs=[1,2,3,4,5,6];
const macroSourceValid=String.raw`import Ui
import syntax Ui.Html as html

-- Collides with Ui.text? Never. Macros are hygienic.
text :: Int
text = 99

person :: String -> Html
person name = html!{<li>{name}</li>}

view :: String -> List String -> Html
view title people = html!{
  <section class="people">
    <h1>{title}</h1>
    {person <$> people}
    <Button onClick={\() -> 42}>Refresh &amp; retry</Button>
  </section>
}`;
const macroSourceBroken=String.raw`import Ui
import syntax Ui.Html as html

-- Collides with Ui.text? Never. Macros are hygienic.
text :: Int
text = 99

person :: String -> Html
person name = html!{<li>{name}</li>}

view :: String -> List String -> Html
view title people = html!{
  <section class="people">
    <h1>{title}</h1>
    {person <$> people}
    <Button onClick={42}>Refresh &amp; retry</Button>
  </section>
}`;
const macroExpanded=String.raw`-- Expanded to ordinary, type-checked Cinch.
-- Ui.text resolves where the macro was defined.
view :: String -> List String -> Html
view title people = Ui.fragment
  [ Ui.element "section" [Ui.attribute "class" "people"]
    [ Ui.element "h1" [] [Ui.child title]
    , Ui.child (person <$> people)
    , Ui.component-Button
        (Ui.ButtonProps { onClick = \() -> 42 })
        [Ui.text "Refresh & retry"]
    ]
  ]`;
const macroDiagnostic=String.raw`-- Rejected by the ordinary Cinch type checker.
-- Provenance maps straight back to the markup hole:
View.cinch:16:22 (in expansion of html! at 12:21):
  type mismatch in ButtonProps.onClick
  expected: Unit -> Int
  got:      Int

-- No opaque temp files: editors highlight {42}
-- right inside the TSX-style tag.`;
const simdBlocks=(count:number)=>{const full=Math.floor(count/4);return [...Array.from({length:full},(_,b)=>({tail:false,label:`VECTOR ${b+1}`,items:[0,1,2,3].map(i=>b*4+i)})),...(count%4?[{tail:true,label:'SCALAR TAIL',items:Array.from({length:count%4},(_,i)=>full*4+i)}]:[])];};
const simdCaption=(count:number)=>{const full=Math.floor(count/4),tail=count%4;return `${count} ${count===1?'element':'elements'}, 4 lanes: ${full} vector ${full===1?'load':'loads'} and ${tail} scalar ${tail===1?'element':'elements'}. No load reads past the end of the array.`;};
const rewrite=String.raw`rewrite mapMap forall (f :: Int -> Int)
                      (g :: Int -> Int)
                      (xs :: List Int). where
  match List.map f (List.map g xs)
  replace List.map (\x -> f (g x)) xs
  justify mapFusion f g xs`;
---
<section class="evidence-section language-section light-section" id="proofs" aria-labelledby="evidence-title">
  <div class="tour-heading"><h2 id="evidence-title">Start plain.<br />Tighten as you go.</h2><p>Begin with ordinary functional types, then formalize invariants incrementally right beside the code you ship. Validate a value once at the boundary and let its type carry the checked fact everywhere downstream at zero runtime cost.</p></div>
  <div class="proof-selector" role="group" aria-label="Guarantee example">{proofViews.map((view,i)=><button type="button" data-proof-view={view.id} aria-pressed={i===0?'true':'false'} aria-controls={`proof-view-${view.id}`}><span class="mono">0{i+1}</span>{view.label}</button>)}</div>
  <div class="proof-views">{proofViews.map((view,i)=><div id={`proof-view-${view.id}`} data-proof-panel={view.id} hidden={i!==0} class="proof-view"><div class="proof-view-copy"><h3>{view.title}</h3><p set:html={view.description} /><a class="text-link" href={view.href}>{view.link}<span>↗</span></a></div><CodeExcerpt code={view.code} caption={view.caption}/></div>)}</div>
  <div class="automation-rail"><div><span class="mono">KERNEL-CHECKED AUTOMATION</span><h3>Routine facts settled.<br />Every claim re-checked.</h3><p>Linear arithmetic, array bounds, and branch narrowing are discharged automatically from your types and pattern matches. Whatever the automation derives is re-checked by a small, independent kernel, so a solver bug can never let broken code through. Missing facts stop the build by name rather than timing out into silent assumptions.</p><a class="text-link" href="/reference/08-dependent-types-and-proofs/">Dependent types and kernel checking <span>↗</span></a></div><ol aria-label="How a fact is checked"><li><span class="mono">01 / DERIVE</span><strong>Derive the fact</strong><small>From types, pattern matches, and linear arithmetic.</small></li><li><span class="mono">02 / WITNESS</span><strong>Build a witness</strong><small>A concrete checkable term, erased before codegen.</small></li><li><span class="mono">03 / VERIFY</span><strong>Re-check in the kernel</strong><small>A small independent kernel confirms it before code emits.</small></li></ol></div>
</section>

<section class="specialization-section language-section" id="specialization" aria-labelledby="specialization-title">
  <div class="tour-heading"><h2 id="specialization-title">Same type.<br />Cheaper layout.</h2><p>Write clean high-level data types, then choose how they sit in memory without changing a single caller. Here a <code>List Bool</code> packs into one bit per element instead of a heap node and pointer per boolean, while the compiler verifies that both representations convert back and forth without losing meaning.</p></div>
  <figure class="representation-figure" aria-label="A List Bool and the packed BitList that stores it. Press a bit to flip it.">
    <div class="representation-source"><span class="mono">WHAT YOUR CODE SEES</span><strong>List Bool</strong><div class="cons-chain" aria-hidden="true">{bits.map(bit=><span class:list={['cons-cell',{'is-true':bit===1}]} data-cons><b>{bit?'T':'F'}</b><i></i></span>)}<span class="cons-nil">Nil</span></div><code data-bits-source>{consText(bits)}</code></div>
    <div class="representation-bridge"><span aria-hidden="true">⇄</span><span class="mono">BUILD / VIEW</span></div>
    <div class="representation-carrier"><span class="mono">WHAT IS STORED</span><strong>BitList</strong><div class="bit-strip" role="group" aria-label="Packed bits, one per list element">{bits.map((bit,i)=><button type="button" class="packed-bit" data-bit={i} aria-pressed={bit?'true':'false'} aria-label={`Element ${i+1}`}>{bit}</button>)}</div><code class="bit-readout" data-bits-readout>{bitsText(bits)}</code></div>
  </figure>
  <div class="specialization-detail"><CodeExcerpt code={representation} label="REPRESENTATION INSTANCE (EXCERPT)"/><div class="specialization-notes"><article><h3>Checked round-trip equivalence.</h3><p>Converting from <code>List Bool</code> to <code>BitList</code> and back must recover the exact original list, and each specialized operation (<code>length</code>, <code>index</code>) is checked against the generic version it replaces.</p></article><article><h3>Predictable memory, zero tracing GC.</h3><p>Compiler-inserted reference counting reclaims memory deterministically and reuses uniquely held nodes in place. Non-escaping allocations stay on the stack, and concrete generic call paths specialize straight into native machine code.</p></article><a class="text-link" href="/reference/24-type-layout/">Type layout and specialization <span>↗</span></a></div></div>
</section>

<section class="staging-section language-section" id="staging" aria-labelledby="staging-title">
  <div class="tour-heading"><h2 id="staging-title">Hygienic macros.<br />Even TSX-style UI.</h2><p>Libraries can ship their own embedded syntax, from TSX-style UI markup and typed queries to state machines and binary formats, with zero special cases in the compiler. Macros are hygienic: internal helper names never collide with your local variables, embedded expressions keep their caller scope, and expanded code passes through the exact same type, effect, and ownership checks as hand-written Cinch. Paired with WebAssembly, Cinch even works as a viable frontend language.</p></div>
  <div class="staging-workbench">
    <div class="staging-source">
      <div class="stage-panel" data-stage-source="valid"><CodeExcerpt code={macroSourceValid} label="TSX-STYLE SYNTAX MACRO" caption="Imported explicitly with import syntax Ui.Html as html. Paired tags, fragments, auto-escaping, and typed components."/></div>
      <div class="stage-panel stage-panel--broken" data-stage-source="broken" hidden><CodeExcerpt code={macroSourceBroken} label="TSX-STYLE SYNTAX MACRO" caption="Passing onClick={42} instead of a callback fails the ordinary type checker inside the markup hole."/></div>
    </div>
    <div class="staging-expansion">
      <span class="expansion-arrow" aria-hidden="true">↳</span>
      <div class="gadget-controls stage-controls">
        <span class="mono" data-stage-status>CHECKED EXPANSION</span>
        <button type="button" class="gadget-key" data-stage-toggle aria-pressed="false">Break onClick <span aria-hidden="true">▸</span></button>
      </div>
      <div class="stage-panel" data-stage-output="valid"><CodeExcerpt code={macroExpanded} label="EXPANDED CINCH" caption="Local text = 99 never shadows Ui.text. Text nodes and attributes auto-escape, and ButtonProps checks onClick."/></div>
      <div class="stage-panel stage-panel--diagnostic" data-stage-output="broken" hidden><CodeExcerpt code={macroDiagnostic} label="CHECKER DIAGNOSTIC" caption="Source maps preserve expansion provenance so errors point straight back to the expression you wrote."/></div>
    </div>
  </div>
  <div class="staging-properties">
    <article><h3>Hygienic by default</h3><p>Macro-introduced helpers resolve where the macro was defined, never clashing with your variables, while embedded expressions keep their caller scope, effects, and linear ownership.</p></article>
    <article><h3>Viable on the frontend</h3><p>Combine TSX-style components with typed state machines (<code>machine!</code>) and compile straight to compact, GC-free WebAssembly, sharing domain types and refinements across server and browser.</p></article>
    <article><h3>Scoped, replayable codegen</h3><p>Compile-time generators (<code>generate do</code>) read schemas or run build tools through explicit capabilities and record every input in a snapshot so CI reproduces identical generated code.</p></article>
  </div>
  <a class="text-link" href="/learn/18-staging-and-macros/">Hygienic macros and compile-time staging <span>↗</span></a>
</section>

<section class="optimization-section language-section light-section" id="optimization" aria-labelledby="optimization-title">
  <div class="tour-heading"><h2 id="optimization-title">Static knowledge<br />turns into speed.</h2><p>Because the compiler knows which bounds hold, which divisors are nonzero, and which regions are pure, it strips runtime checks away and unlocks aggressive optimization. Libraries ship domain-specific rewrite rules with checked justification, applied only where effects and totality allow.</p></div>
  <div class="optimization-grid"><div><CodeExcerpt code={rewrite} label="REWRITE RULE"/><a class="text-link" href="/reference/12-rewrites-and-optimization/">Rewrites and optimization <span>↗</span></a></div><div class="fusion-explanation"><span class="mono">PURE MAP FUSION</span><div class="fusion-equation"><code>map f (map g xs)</code><span aria-hidden="true">↓</span><code>map (\x → f (g x)) xs</code></div><div class="fusion-bench" data-fusion><div class="gadget-controls"><span class="mono">REWRITE</span><button type="button" class="gadget-key" data-fusion-toggle aria-pressed="false">Apply mapMap <span aria-hidden="true">▸</span></button></div><div class="fusion-track" aria-hidden="true">{[['xs',xs],['map g',xs.map(x=>2*x)],['map f',xs.map(x=>2*x+1)]].map(([name,row],r)=><div class:list={['fusion-row',`row-${r}`]}><span class="mono">{name}</span>{(row as number[]).map((v,i)=><b style={`--i:${i}`}>{v}</b>)}</div>)}</div><p class="fusion-readout mono" data-fusion-readout aria-live="polite">2 traversals · 1 intermediate list</p><p class="fusion-key">With <code>g x = 2 * x</code> and <code>f x = x + 1</code>.</p></div><p>The rewrite collapses two traversals and an intermediate allocation into one tight pass. Because effect rows separate pure functions from effectful ones, it fires only where reordering cannot alter I/O or mutation.</p><p>Combined with whole-program specialization, erased runtime checks, and LLVM contract attributes, clean functional pipelines compile down to native machine code that rivals or beats hand-tuned systems code.</p></div></div>
  <div class="target-detail"><div><span class="mono">TARGET-CHECKED SIMD</span><h3>Vectorize loops without<br />out-of-bounds reads.</h3><p>Vectorized loops are where off-by-one memory bugs hide. The compiler verifies that every vector load stays inside the array, handles the scalar tail explicitly, checks CPU feature availability, and distinguishes wrapping integer arithmetic from floating-point reductions.</p><a class="text-link" href="/reference/19-targets-and-components/">Targets, SIMD, and components <span>↗</span></a></div><figure class="simd-figure" data-simd><div class="gadget-controls"><span class="mono">ELEMENTS</span><div class="gadget-stepper"><button type="button" data-simd-step="-1" aria-label="Fewer elements">−</button><output data-simd-count aria-live="polite">10</output><button type="button" data-simd-step="1" aria-label="More elements">+</button></div><button type="button" class="gadget-key" data-simd-run>Run the loop <span aria-hidden="true">▸</span></button></div><div class="simd-lanes" data-simd-lanes aria-hidden="true">{simdBlocks(10).map(block=><div class:list={['simd-block',{'scalar-tail':block.tail}]} style={`flex:${block.items.length}`}>{block.items.map(i=><span>{i}</span>)}<small class="mono">{block.label}</small></div>)}</div><figcaption data-simd-caption>{simdCaption(10)}</figcaption></figure></div>
</section>
<script>
  const proofSection=document.querySelector('#proofs');
  const buttons=proofSection?.querySelectorAll<HTMLButtonElement>('[data-proof-view]');
  const panels=proofSection?.querySelectorAll<HTMLElement>('[data-proof-panel]');
  buttons?.forEach(button=>button.addEventListener('click',()=>{
    buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
    panels?.forEach(panel=>{panel.hidden=panel.dataset.proofPanel!==button.dataset.proofView;});
  }));

  const calm=()=>matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait=(ms:number)=>new Promise(resolve=>setTimeout(resolve,calm()?0:ms));

  // List Bool and BitList: one set of values, two layouts.
  const bitsFigure=document.querySelector('#specialization .representation-figure');
  const bitButtons=bitsFigure?.querySelectorAll<HTMLButtonElement>('[data-bit]');
  const consCells=bitsFigure?.querySelectorAll<HTMLElement>('[data-cons]');
  bitButtons?.forEach(button=>button.addEventListener('click',()=>{
    const i=Number(button.dataset.bit);
    const on=button.getAttribute('aria-pressed')!=='true';
    button.setAttribute('aria-pressed',String(on));
    button.textContent=on?'1':'0';
    const cell=consCells?.[i];
    if(cell){cell.classList.toggle('is-true',on);cell.querySelector('b')!.textContent=on?'T':'F';cell.classList.remove('is-flipped');void cell.offsetWidth;cell.classList.add('is-flipped');}
    const values=[...bitButtons].map(b=>b.getAttribute('aria-pressed')==='true'?1:0);
    bitsFigure!.querySelector('[data-bits-readout]')!.textContent=`0b${values.join('')}`;
    bitsFigure!.querySelector('[data-bits-source]')!.textContent=`${values.slice(0,3).map(v=>`Cons ${v?'True':'False'} (`).join('')}…)))`;
  }));

  // SIMD: four lanes per load, scalar steps for the remainder.
  const simd=document.querySelector<HTMLElement>('[data-simd]');
  if(simd){
    let count=10, running=false;
    const lanes=simd.querySelector<HTMLElement>('[data-simd-lanes]')!;
    const draw=()=>{
      const full=Math.floor(count/4), tail=count%4;
      lanes.replaceChildren(...Array.from({length:full+(tail?1:0)},(_,b)=>{
        const block=document.createElement('div');
        const isTail=b===full;
        block.className=`simd-block${isTail?' scalar-tail':''}`;
        const size=isTail?tail:4;
        block.style.flex=String(size);
        for(let i=0;i<size;i++){const cell=document.createElement('span');cell.textContent=String(b*4+i);block.append(cell);}
        const label=document.createElement('small');label.className='mono';label.textContent=isTail?'SCALAR TAIL':`VECTOR ${b+1}`;block.append(label);
        return block;
      }));
      simd.querySelector('[data-simd-count]')!.textContent=String(count);
      simd.querySelector('[data-simd-caption]')!.textContent=`${count} ${count===1?'element':'elements'}, 4 lanes: ${full} vector ${full===1?'load':'loads'} and ${tail} scalar ${tail===1?'element':'elements'}. No load reads past the end of the array.`;
      sync();
    };
    function sync(){simd!.querySelectorAll<HTMLButtonElement>('[data-simd-step]').forEach(b=>{b.disabled=running||(Number(b.dataset.simdStep)<0?count===1:count===16);});}
    simd.querySelectorAll<HTMLButtonElement>('[data-simd-step]').forEach(b=>b.addEventListener('click',()=>{count=Math.min(16,Math.max(1,count+Number(b.dataset.simdStep)));draw();}));
    simd.querySelector<HTMLButtonElement>('[data-simd-run]')!.addEventListener('click',async()=>{
      if(running)return; running=true; draw();
      lanes.querySelectorAll('.is-done,.is-active').forEach(el=>el.classList.remove('is-done','is-active'));
      for(const block of lanes.querySelectorAll<HTMLElement>('.simd-block')){
        if(block.classList.contains('scalar-tail')){
          for(const cell of block.querySelectorAll('span')){cell.classList.add('is-active');await wait(320);cell.classList.replace('is-active','is-done');}
        } else {block.classList.add('is-active');await wait(520);block.classList.replace('is-active','is-done');}
      }
      running=false; sync();
    });
  }

  // Hygienic macros: toggle valid callback vs. wrong prop type inside html!{...}.
  const staging=document.querySelector<HTMLElement>('#staging');
  if(staging){
    const toggle=staging.querySelector<HTMLButtonElement>('[data-stage-toggle]');
    const status=staging.querySelector<HTMLElement>('[data-stage-status]');
    const sources=staging.querySelectorAll<HTMLElement>('[data-stage-source]');
    const outputs=staging.querySelectorAll<HTMLElement>('[data-stage-output]');
    staging.querySelectorAll<HTMLElement>('[data-stage-source="broken"] .excerpt-number').forEach(n=>{
      if(n.textContent==='42') n.classList.add('is-spliced');
    });
    toggle?.addEventListener('click',()=>{
      const broken=toggle.getAttribute('aria-pressed')!=='true';
      const mode=broken?'broken':'valid';
      toggle.setAttribute('aria-pressed',String(broken));
      toggle.firstChild!.textContent=broken?'Restore callback ':'Break onClick ';
      if(status) status.textContent=broken?'EXPANSION REJECTED':'CHECKED EXPANSION';
      sources.forEach(el=>{el.hidden=el.dataset.stageSource!==mode;});
      outputs.forEach(el=>{
        const show=el.dataset.stageOutput===mode;
        el.hidden=!show;
        if(show){
          const fig=el.querySelector<HTMLElement>('.language-excerpt');
          if(fig){fig.classList.remove('is-regenerated');void fig.offsetWidth;fig.classList.add('is-regenerated');}
        }
      });
    });
  }

  // Map fusion: two passes and an intermediate list, or one pass.
  const fusion=document.querySelector<HTMLElement>('[data-fusion]');
  if(fusion){
    const toggle=fusion.querySelector<HTMLButtonElement>('[data-fusion-toggle]')!;
    let token=0;
    const play=async(mode:string)=>{
      const run=++token;
      fusion.dataset.mode=mode;
      const cells=(r:number)=>[...fusion.querySelectorAll<HTMLElement>(`.row-${r} b`)];
      fusion.querySelectorAll('.fusion-row b').forEach(b=>b.classList.remove('is-lit'));
      fusion.querySelector('[data-fusion-readout]')!.textContent=mode==='one'?'1 traversal · no intermediate list':'2 traversals · 1 intermediate list';
      cells(0).forEach(b=>b.classList.add('is-lit'));
      const passes=mode==='one'?[2]:[1,2];
      for(const r of passes){for(const b of cells(r)){if(run!==token)return;await wait(90);b.classList.add('is-lit');}await wait(200);}
    };
    toggle.addEventListener('click',()=>{
      const fused=toggle.getAttribute('aria-pressed')!=='true';
      toggle.setAttribute('aria-pressed',String(fused));
      toggle.firstChild!.textContent=fused?'Undo the rewrite ':'Apply mapMap ';
      play(fused?'one':'two');
    });
    fusion.dataset.mode='two';
    fusion.querySelectorAll('.fusion-row b').forEach(b=>b.classList.add('is-lit'));
  }
</script>
