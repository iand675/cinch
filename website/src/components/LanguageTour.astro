---
import CodeExcerpt from './CodeExcerpt.astro';
import '../styles/language-tour.css';
const proofViews=[
  {id:'bounds',label:'Runtime evidence',title:'Turn a checked value into a usable guarantee.',description:'A successful bounds check returns a Fin n: an index together with evidence that it fits. The caller handles invalid input explicitly; code that requires a bounded index receives the stronger type.',code:String.raw`checkedIndex :: (n :: Nat) -> Nat -> Option (Fin n)
checkedIndex n i = case decide (i < n) of
  Yes bound -> Some (Fin i bound)
  No _ -> None`,caption:'The comparison runs. The successful proof is erased.',href:'/tutorials/02-proofs-and-runtime-checks/',link:'Proofs and runtime checks'},
  {id:'induction',label:'Structural proofs',title:'Prove the relationship for every input.',description:'An equality can be established by induction over a natural number. Each recursive step uses a smaller value; congr carries the smaller equality through Succ. The proof is checked before it is erased.',code:String.raw`proof plusZero :: (n :: Nat) -> Eq (n + 0) n
proof plusZero n = case n of
  Zero -> refl
  Succ k -> congr Succ (plusZero k)`,caption:'Proof code must be total. Looping cannot manufacture evidence.',href:'/tutorials/02-proofs-and-runtime-checks/#prove-a-general-statement',link:'Read the induction example'},
  {id:'refinements',label:'Refinement types',title:'Refine a type without changing its data.',description:'NonEmpty describes a list whose predicate has been established. The evidence is erased and the list keeps its representation. Methods are available when their contracts preserve the refinement: appending nonempty lists stays nonempty; an empty identity would not.',code:String.raw`type NonEmpty a =
  refine (xs :: List a) with NotNull xs

from-list :: List a -> Option (NonEmpty a)`,caption:'Refinements express facts about values; newtypes give values a distinct identity.',href:'/design/refinement-types/',link:'Refinements and their laws'},
];
const bits=[1,0,1,1,0,0,1,0];
const consText=(values:number[])=>`${values.slice(0,3).map(v=>`Cons ${v?'True':'False'} (`).join('')}…${')'.repeat(3)}`;
const bitsText=(values:number[])=>`0b${values.join('')}`;
const representation=String.raw`implicit instance Bits :: Represent (List Bool) BitList where
  -- Builders and a view connect the two representations.
  Nil       = bit-list-empty
  Cons b bs = bit-list-cons b bs

  -- Fast paths keep the same public operations.
  specialize length = bit-list-length
  specialize index  = bit-list-index`;
const xs=[1,2,3,4,5,6];
const generator=String.raw`stage addOne :: Code Int -> Code Int
stage addOne body = [| let x = $(body) in x + 1 |]

generate do
  emit (quoteDecls where
    answer :: Int
    answer = $(addOne [| 21 |]))`;
const generated=String.raw`answer :: Int
answer = let x = 21 in x + 1`;
const simdBlocks=(count:number)=>{const full=Math.floor(count/4);return [...Array.from({length:full},(_,b)=>({tail:false,label:`VECTOR ${b+1}`,items:[0,1,2,3].map(i=>b*4+i)})),...(count%4?[{tail:true,label:'SCALAR TAIL',items:Array.from({length:count%4},(_,i)=>full*4+i)}]:[])];};
const simdCaption=(count:number)=>{const full=Math.floor(count/4),tail=count%4;return `${count} ${count===1?'element':'elements'}, 4 lanes: ${full} vector ${full===1?'load':'loads'} and ${tail} scalar ${tail===1?'element':'elements'}. No load reads past the end of the array.`;};
const rewrite=String.raw`rewrite mapMap forall (f :: Int -> Int)
                      (g :: Int -> Int)
                      (xs :: List Int). where
  match List.map f (List.map g xs)
  replace List.map (\x -> f (g x)) xs
  justify mapFusion f g xs`;
---
<section class="evidence-section language-section light-section" id="proofs" aria-labelledby="evidence-title">
  <div class="section-index mono"><span>PROOFS AND REFINEMENTS</span></div>
  <div class="tour-heading"><h2 id="evidence-title">Put the guarantee<br />in the type.</h2><p>Check a concrete input, prove a general law, or refine an existing type. The evidence becomes part of what another function can rely on.</p></div>
  <div class="proof-selector" role="group" aria-label="Proof example">{proofViews.map((view,i)=><button type="button" data-proof-view={view.id} aria-pressed={i===0?'true':'false'} aria-controls={`proof-view-${view.id}`}><span class="mono">0{i+1}</span>{view.label}</button>)}</div>
  <div class="proof-views">{proofViews.map((view,i)=><div id={`proof-view-${view.id}`} data-proof-panel={view.id} hidden={i!==0} class="proof-view"><div class="proof-view-copy"><h3>{view.title}</h3><p>{view.description}</p><a class="text-link" href={view.href}>{view.link}<span>↗</span></a></div><CodeExcerpt code={view.code} caption={view.caption}/></div>)}</div>
  <div class="automation-rail"><div><span class="mono">PROOF AUTOMATION</span><h3>Automation finds proofs.<br />The kernel checks them.</h3><p>Tactics are ordinary Cinch programs that run at compile time. Arithmetic bounds, algebraic identities, and bit-vector laws each have their own strategy. Whatever a tactic finds, a small kernel checks before the compiler accepts it, so a buggy tactic cannot sneak in a false proof. A goal no tactic solves stays open until you write the proof.</p><a class="text-link" href="/design/proof-automation/">How proof automation works <span>↗</span></a></div><ol aria-label="Proof automation pipeline"><li><span class="mono">01 / SEARCH</span><strong>Tactic or solver</strong><small>Find an argument for the goal.</small></li><li><span class="mono">02 / EVIDENCE</span><strong>Term or certificate</strong><small>Return something checkable.</small></li><li><span class="mono">03 / CHECK</span><strong>Small proof kernel</strong><small>Validate it against the proposition.</small></li></ol></div>
</section>

<section class="specialization-section language-section" id="specialization" aria-labelledby="specialization-title">
  <div class="section-index mono"><span>TYPE SPECIALIZATION</span></div>
  <div class="tour-heading"><h2 id="specialization-title">Generic code.<br />Specific layouts.</h2><p>Write ordinary code against <code>List Bool</code> and let the compiler store it as packed bits. Construction and pattern matching still look like an ordinary list; the instance supplies the conversion.</p></div>
  <figure class="representation-figure" aria-labelledby="representation-caption">
    <div class="representation-source"><span class="mono">WHAT YOUR CODE SEES</span><strong>List Bool</strong><div class="cons-chain" aria-hidden="true">{bits.map(bit=><span class:list={['cons-cell',{'is-true':bit===1}]} data-cons><b>{bit?'T':'F'}</b><i></i></span>)}<span class="cons-nil">Nil</span></div><code data-bits-source>{consText(bits)}</code></div>
    <div class="representation-bridge"><span aria-hidden="true">⇄</span><span class="mono">BUILD / VIEW</span></div>
    <div class="representation-carrier"><span class="mono">WHAT IS STORED</span><strong>BitList</strong><div class="bit-strip" role="group" aria-label="Packed bits, one per list element">{bits.map((bit,i)=><button type="button" class="packed-bit" data-bit={i} aria-pressed={bit?'true':'false'} aria-label={`Element ${i+1}`}>{bit}</button>)}</div><code class="bit-readout" data-bits-readout>{bitsText(bits)}</code></div>
    <figcaption id="representation-caption">Press a bit to flip it. Eight list cells, each with a pointer to the next, become eight bits. The public type stays <code>List Bool</code>; round-trip laws connect the packed form to <code>Nil</code> and <code>Cons</code>.</figcaption>
  </figure>
  <div class="specialization-detail"><CodeExcerpt code={representation} label="REPRESENTATION INSTANCE (EXCERPT)"/><div class="specialization-notes"><article><h3>The packed version must mean the same thing.</h3><p>Converting to <code>BitList</code> and back has to give the original list, and the compiler requires a proof of that. Each specialized function is checked against the generic one it replaces.</p></article><article><h3>Only the versions a program uses get built.</h3><p>The compiler follows concrete types through generic code and builds the versions it reaches. A recursive type that would grow without bound is boxed at that point; code that forbids allocation gets an error instead.</p></article><a class="text-link" href="/design/layouts-and-specialization/">Layouts, representations, and specialization <span>↗</span></a></div></div>
  <p class="specialization-footnote">A representation keeps the meaning of the code, not its cost: a packed list is faster for some operations and slower for others. Pick a named representation with <code>via</code>, and add fast paths where the generic version would be slow.</p>
</section>

<section class="staging-section language-section" id="staging" aria-labelledby="staging-title">
  <div class="section-index mono"><span>TYPED STAGING</span></div>
  <div class="tour-heading"><h2 id="staging-title">Generate code<br />that gets checked.</h2><p>Generators build code from typed quotations. What they produce is type-checked and proof-checked like code written by hand.</p></div>
  <div class="staging-workbench"><CodeExcerpt code={generator} label="COMPILE-TIME GENERATOR"/><div class="staging-expansion"><span class="expansion-arrow" aria-hidden="true">↳</span><div class="gadget-controls stage-controls"><span class="mono">SPLICED VALUE</span><div class="gadget-stepper"><button type="button" data-stage-step="-1" aria-label="Decrease the spliced value">−</button><output data-stage-value aria-live="polite">21</output><button type="button" data-stage-step="1" aria-label="Increase the spliced value">+</button></div></div><CodeExcerpt code={generated} label="GENERATED CODE" caption="answer evaluates to 22."/></div></div>
  <div class="staging-properties"><article><h3>Hygienic names</h3><p>Names in a macro resolve where the macro is defined. Capturing a caller’s name has to be written out explicitly.</p></article><article><h3>Compile-time I/O</h3><p>A generator can read a schema or run a tool, through capabilities scoped to the build. The connection handle and the secret that opened it stay out of the generated code.</p></article><article><h3>Reproducible builds</h3><p>The build records what each generator read and where it came from, so the same build can be replayed. Types generated from a schema describe the recorded schema.</p></article></div>
  <a class="text-link" href="/tutorials/08-staging-and-schema-generation/">Staging and schema generation <span>↗</span></a>
</section>

<section class="optimization-section language-section light-section" id="optimization" aria-labelledby="optimization-title">
  <div class="section-index mono"><span>VERIFIED OPTIMIZATION</span></div>
  <div class="tour-heading"><h2 id="optimization-title">Teach the compiler<br />why a shortcut works.</h2><p>Package an optimization with the law that justifies it. The compiler checks the rule’s types, evidence, and resource conditions before applying it.</p></div>
  <div class="optimization-grid"><div><CodeExcerpt code={rewrite} label="REWRITE RULE"/><a class="text-link" href="/tutorials/07-rewrites-and-stream-fusion/">The map-fusion proof and rewrite <span>↗</span></a></div><div class="fusion-explanation"><span class="mono">PURE MAP FUSION</span><div class="fusion-equation"><code>map f (map g xs)</code><span aria-hidden="true">↓</span><code>map (\x → f (g x)) xs</code></div><div class="fusion-bench" data-fusion><div class="gadget-controls"><span class="mono">REWRITE</span><button type="button" class="gadget-key" data-fusion-toggle aria-pressed="false">Apply mapMap <span aria-hidden="true">▸</span></button></div><div class="fusion-track" aria-hidden="true">{[['xs',xs],['map g',xs.map(x=>2*x)],['map f',xs.map(x=>2*x+1)]].map(([name,row],r)=><div class:list={['fusion-row',`row-${r}`]}><span class="mono">{name}</span>{(row as number[]).map((v,i)=><b style={`--i:${i}`}>{v}</b>)}</div>)}</div><p class="fusion-readout mono" data-fusion-readout aria-live="polite">2 traversals · 1 intermediate list</p><p class="fusion-key">With <code>g x = 2 * x</code> and <code>f x = x + 1</code>.</p></div><p>Compose the callbacks into one traversal. The theorem is about pure, finite lists with total callbacks; it cannot justify changing the order of logging or other effects.</p><p>Stream fusion works the same way for producers and loops: the intermediate collections disappear and the result stays the same.</p></div></div>
  <div class="target-detail"><div><span class="mono">SIMD</span><h3>Then prove the machine-level step.</h3><p>SIMD specialization adds obligations for lane arithmetic, memory access, capability availability, and the tail. A wrapping-integer sum needs a different theorem from a floating-point reduction.</p><a class="text-link" href="/tutorials/10-platform-specific-simd/">Platform proofs and SIMD <span>↗</span></a></div><figure class="simd-figure" data-simd><div class="gadget-controls"><span class="mono">ELEMENTS</span><div class="gadget-stepper"><button type="button" data-simd-step="-1" aria-label="Fewer elements">−</button><output data-simd-count aria-live="polite">10</output><button type="button" data-simd-step="1" aria-label="More elements">+</button></div><button type="button" class="gadget-key" data-simd-run>Run the loop <span aria-hidden="true">▸</span></button></div><div class="simd-lanes" data-simd-lanes aria-hidden="true">{simdBlocks(10).map(block=><div class:list={['simd-block',{'scalar-tail':block.tail}]} style={`flex:${block.items.length}`}>{block.items.map(i=><span>{i}</span>)}<small class="mono">{block.label}</small></div>)}</div><figcaption data-simd-caption>{simdCaption(10)}</figcaption></figure></div>
</section>
<script>
  const proofSection=document.querySelector('#proofs');
  const buttons=proofSection?.querySelectorAll<HTMLButtonElement>('[data-proof-view]');
  const panels=proofSection?.querySelectorAll<HTMLElement>('[data-proof-panel]');
  buttons?.forEach(button=>button.addEventListener('click',()=>{
    buttons.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
    panels?.forEach(panel=>{panel.hidden=panel.dataset.proofPanel!==button.dataset.proofView;});
  }));

  const calm=()=>matchMedia('(prefers-reduced-motion: reduce)').matches;
  const wait=(ms:number)=>new Promise(resolve=>setTimeout(resolve,calm()?0:ms));

  // List Bool and BitList: one set of values, two layouts.
  const bitsFigure=document.querySelector('#specialization .representation-figure');
  const bitButtons=bitsFigure?.querySelectorAll<HTMLButtonElement>('[data-bit]');
  const consCells=bitsFigure?.querySelectorAll<HTMLElement>('[data-cons]');
  bitButtons?.forEach(button=>button.addEventListener('click',()=>{
    const i=Number(button.dataset.bit);
    const on=button.getAttribute('aria-pressed')!=='true';
    button.setAttribute('aria-pressed',String(on));
    button.textContent=on?'1':'0';
    const cell=consCells?.[i];
    if(cell){cell.classList.toggle('is-true',on);cell.querySelector('b')!.textContent=on?'T':'F';cell.classList.remove('is-flipped');void cell.offsetWidth;cell.classList.add('is-flipped');}
    const values=[...bitButtons].map(b=>b.getAttribute('aria-pressed')==='true'?1:0);
    bitsFigure!.querySelector('[data-bits-readout]')!.textContent=`0b${values.join('')}`;
    bitsFigure!.querySelector('[data-bits-source]')!.textContent=`${values.slice(0,3).map(v=>`Cons ${v?'True':'False'} (`).join('')}…)))`;
  }));

  // SIMD: four lanes per load, scalar steps for the remainder.
  const simd=document.querySelector<HTMLElement>('[data-simd]');
  if(simd){
    let count=10, running=false;
    const lanes=simd.querySelector<HTMLElement>('[data-simd-lanes]')!;
    const draw=()=>{
      const full=Math.floor(count/4), tail=count%4;
      lanes.replaceChildren(...Array.from({length:full+(tail?1:0)},(_,b)=>{
        const block=document.createElement('div');
        const isTail=b===full;
        block.className=`simd-block${isTail?' scalar-tail':''}`;
        const size=isTail?tail:4;
        block.style.flex=String(size);
        for(let i=0;i<size;i++){const cell=document.createElement('span');cell.textContent=String(b*4+i);block.append(cell);}
        const label=document.createElement('small');label.className='mono';label.textContent=isTail?'SCALAR TAIL':`VECTOR ${b+1}`;block.append(label);
        return block;
      }));
      simd.querySelector('[data-simd-count]')!.textContent=String(count);
      simd.querySelector('[data-simd-caption]')!.textContent=`${count} ${count===1?'element':'elements'}, 4 lanes: ${full} vector ${full===1?'load':'loads'} and ${tail} scalar ${tail===1?'element':'elements'}. No load reads past the end of the array.`;
      sync();
    };
    function sync(){simd!.querySelectorAll<HTMLButtonElement>('[data-simd-step]').forEach(b=>{b.disabled=running||(Number(b.dataset.simdStep)<0?count===1:count===16);});}
    simd.querySelectorAll<HTMLButtonElement>('[data-simd-step]').forEach(b=>b.addEventListener('click',()=>{count=Math.min(16,Math.max(1,count+Number(b.dataset.simdStep)));draw();}));
    simd.querySelector<HTMLButtonElement>('[data-simd-run]')!.addEventListener('click',async()=>{
      if(running)return; running=true; draw();
      lanes.querySelectorAll('.is-done,.is-active').forEach(el=>el.classList.remove('is-done','is-active'));
      for(const block of lanes.querySelectorAll<HTMLElement>('.simd-block')){
        if(block.classList.contains('scalar-tail')){
          for(const cell of block.querySelectorAll('span')){cell.classList.add('is-active');await wait(320);cell.classList.replace('is-active','is-done');}
        } else {block.classList.add('is-active');await wait(520);block.classList.replace('is-active','is-done');}
      }
      running=false; sync();
    });
  }

  // Staging: the spliced literal flows into the generated declaration.
  const staging=document.querySelector<HTMLElement>('#staging');
  if(staging){
    const spliced=[...staging.querySelectorAll<HTMLElement>('.excerpt-number')].filter(n=>n.textContent==='21');
    spliced.forEach(n=>n.classList.add('is-spliced'));
    const generated=staging.querySelector<HTMLElement>('.staging-expansion .language-excerpt');
    const caption=generated?.querySelector('.excerpt-caption');
    let value=21;
    const steps=staging.querySelectorAll<HTMLButtonElement>('[data-stage-step]');
    steps.forEach(b=>b.addEventListener('click',()=>{
      value=Math.min(99,Math.max(0,value+Number(b.dataset.stageStep)));
      spliced.forEach(n=>{n.textContent=String(value);});
      staging.querySelector('[data-stage-value]')!.textContent=String(value);
      if(caption)caption.textContent=`answer evaluates to ${value+1}.`;
      steps.forEach(s=>{s.disabled=Number(s.dataset.stageStep)<0?value===0:value===99;});
      if(generated){generated.classList.remove('is-regenerated');void generated.offsetWidth;generated.classList.add('is-regenerated');}
    }));
  }

  // Map fusion: two passes and an intermediate list, or one pass.
  const fusion=document.querySelector<HTMLElement>('[data-fusion]');
  if(fusion){
    const toggle=fusion.querySelector<HTMLButtonElement>('[data-fusion-toggle]')!;
    let token=0;
    const play=async(mode:string)=>{
      const run=++token;
      fusion.dataset.mode=mode;
      const cells=(r:number)=>[...fusion.querySelectorAll<HTMLElement>(`.row-${r} b`)];
      fusion.querySelectorAll('.fusion-row b').forEach(b=>b.classList.remove('is-lit'));
      fusion.querySelector('[data-fusion-readout]')!.textContent=mode==='one'?'1 traversal · no intermediate list':'2 traversals · 1 intermediate list';
      cells(0).forEach(b=>b.classList.add('is-lit'));
      const passes=mode==='one'?[2]:[1,2];
      for(const r of passes){for(const b of cells(r)){if(run!==token)return;await wait(90);b.classList.add('is-lit');}await wait(200);}
    };
    toggle.addEventListener('click',()=>{
      const fused=toggle.getAttribute('aria-pressed')!=='true';
      toggle.setAttribute('aria-pressed',String(fused));
      toggle.firstChild!.textContent=fused?'Undo the rewrite ':'Apply mapMap ';
      play(fused?'one':'two');
    });
    fusion.dataset.mode='two';
    fusion.querySelectorAll('.fusion-row b').forEach(b=>b.classList.add('is-lit'));
  }
</script>
