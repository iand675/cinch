---
import CodeExcerpt from './CodeExcerpt.astro';
import life from '../data/examples/life.cinch?raw';
import bridge from '../data/examples/life-abi.cinch?raw';

const module = life.trimEnd();
const exports = bridge.split('\n').filter((line) => line.trimStart().startsWith('foreign export ')).map((line) => line.trimStart()).join('\n');
---
<div class="life-reload" data-life>
  <div class="life-workbench">
    <div class="life-head">
      <span class="mono" data-life-version>VERSION 1</span>
      <span class="mono" data-life-generation>GENERATION 0</span>
      <span class="mono" data-life-size></span>
      <div class="life-keys">
        <button type="button" class="gadget-key" data-life-run disabled aria-pressed="false">Run <span aria-hidden="true">▸</span></button>
        <button type="button" class="gadget-key" data-life-step disabled>Step</button>
        <button type="button" class="gadget-key" data-life-reset disabled>Reset</button>
        <button type="button" class="gadget-key" data-life-reseed disabled>Reseed</button>
      </div>
    </div>
    <canvas class="life-board" data-life-board role="img" aria-label="Game of Life board. Click a cell to switch it."></canvas>
    <div class="life-editor">
      <pre class="life-paint" aria-hidden="true"><code data-life-paint>{module}</code></pre>
      <textarea class="life-input" data-life-source disabled spellcheck="false" autocapitalize="off" autocomplete="off" aria-label="Editable Life.cinch source code" aria-describedby="life-status">{module}</textarea>
    </div>
    <p class="life-status" id="life-status" data-life-status aria-live="polite">Loading the precompiled board…</p>
  </div>
  <p class="life-note">Edit the Life module and Cinch compiles it in your browser. The runtime switches versions between generations, keeping the generation count and the ages of cells that fit. Inspired by <a href="https://github.com/indexable-inc/blaze#demo-a-game-of-life-you-can-edit">Blaze’s live-editable Life demo</a>.</p>
  <details class="life-exports"><summary>WebAssembly exports</summary><CodeExcerpt code={exports} label="LIFE-ABI.CINCH" /></details>
</div>
<script>
  import { tokenize } from '../lib/highlight';
  import { Life } from '../lib/life';
  import boardUrl from '../data/examples/life-board.wasm?url';
  import type { CompileReply, CompileRequest } from '../lib/life-compiler.worker';

  const root = document.querySelector<HTMLElement>('[data-life]');
  if (root) {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-life-board]')!;
    const source = root.querySelector<HTMLTextAreaElement>('[data-life-source]')!;
    const paint = root.querySelector<HTMLElement>('[data-life-paint]')!;
    const backdrop = paint.parentElement!;
    const status = root.querySelector<HTMLElement>('[data-life-status]')!;
    const versionLabel = root.querySelector<HTMLElement>('[data-life-version]')!;
    const generationLabel = root.querySelector<HTMLElement>('[data-life-generation]')!;
    const sizeLabel = root.querySelector<HTMLElement>('[data-life-size]')!;
    const runKey = root.querySelector<HTMLButtonElement>('[data-life-run]')!;
    const ctx = canvas.getContext('2d')!;

    let life: Life | undefined;
    let version = 1;
    let loaded = source.value;
    let running = false;
    let visible = true;
    let timer = 0;
    let frame = 0;
    let palette: string[] = [];

    const refreshBoard = (board: Life) => {
      const { colors, width, height } = board.settings;
      palette = colors.map((color) => `#${color.toString(16).padStart(6, '0')}`);
      canvas.style.aspectRatio = `${width} / ${height}`;
      canvas.setAttribute('aria-label', `Game of Life board, ${width} columns by ${height} rows. Click a cell to switch it.`);
      sizeLabel.textContent = `${width} × ${height}`;
    };

    const geometry = (box: DOMRect, columns: number, rows: number) => {
      const size = Math.min(box.width / columns, box.height / rows);
      return { size, left: (box.width - size * columns) / 2, top: (box.height - size * rows) / 2 };
    };

    const draw = () => {
      if (!life) return;
      const { width, height } = life.settings;
      const ages = life.ages;
      const ratio = window.devicePixelRatio || 1;
      const box = canvas.getBoundingClientRect();
      if (!box.width || !box.height) return;
      const pixelWidth = Math.round(box.width * ratio), pixelHeight = Math.round(box.height * ratio);
      if (canvas.width !== pixelWidth) canvas.width = pixelWidth;
      if (canvas.height !== pixelHeight) canvas.height = pixelHeight;
      ctx.setTransform(pixelWidth / box.width, 0, 0, pixelHeight / box.height, 0, 0);
      const { size, left, top } = geometry(box, width, height);
      ctx.fillStyle = '#1a2117';
      ctx.fillRect(0, 0, box.width, box.height);
      for (let y = 0; y < height; y++) for (let x = 0; x < width; x++) {
        const age = ages[y * width + x];
        ctx.fillStyle = age ? palette[age - 1] : '#283222';
        const inset = age ? size * 0.1 : size * 0.42;
        ctx.fillRect(left + x * size + inset, top + y * size + inset, size - inset * 2, size - inset * 2);
      }
      generationLabel.textContent = `GENERATION ${life.generation}`;
    };
    const advance = () => {
      try {
        life?.step();
        draw();
      } catch {
        setRunning(false);
        status.textContent = 'The board stopped. Reset it to try again.';
      }
    };
    const advanceFrame = () => {
      advance();
      if (running) frame = window.requestAnimationFrame(advanceFrame);
    };
    const schedule = () => {
      window.clearInterval(timer);
      window.cancelAnimationFrame(frame);
      if (!life || !running || !visible || document.hidden) return;
      const { stepMs } = life.settings;
      if (stepMs === 0) frame = window.requestAnimationFrame(advanceFrame);
      else timer = window.setInterval(advance, stepMs);
    };
    const setRunning = (on: boolean) => {
      running = on;
      runKey.setAttribute('aria-pressed', String(on));
      runKey.firstChild!.textContent = on ? 'Pause ' : 'Run ';
      schedule();
    };

    // The board only runs while it is on screen and the tab is visible.
    new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; schedule(); }).observe(canvas);
    document.addEventListener('visibilitychange', schedule);
    new ResizeObserver(draw).observe(canvas);

    runKey.addEventListener('click', () => setRunning(!running));
    root.querySelector('[data-life-step]')!.addEventListener('click', () => { setRunning(false); advance(); });
    root.querySelector('[data-life-reset]')!.addEventListener('click', () => { life?.reset(); draw(); });
    root.querySelector('[data-life-reseed]')!.addEventListener('click', () => { life?.reseed(); draw(); });
    canvas.addEventListener('click', (event) => {
      if (!life) return;
      const { width, height } = life.settings;
      const box = canvas.getBoundingClientRect();
      const { size, left, top } = geometry(box, width, height);
      const x = Math.floor((event.clientX - box.left - left) / size);
      const y = Math.floor((event.clientY - box.top - top) / size);
      if (x >= 0 && x < width && y >= 0 && y < height) { life.toggle(x, y); draw(); }
    });

    // The textarea owns the scrollbars and the editable text. Mirror its
    // viewport so the highlighted copy lays out the same lines.
    const syncViewport = () => {
      backdrop.style.width = `${source.clientWidth}px`;
      backdrop.style.height = `${source.clientHeight}px`;
      backdrop.scrollLeft = source.scrollLeft;
      backdrop.scrollTop = source.scrollTop;
    };
    source.addEventListener('scroll', syncViewport);
    new ResizeObserver(syncViewport).observe(source);

    const repaint = () => {
      paint.replaceChildren(...tokenize(source.value).map(({ text, kind }) => {
        const span = document.createElement('span');
        if (kind) span.className = `excerpt-${kind}`;
        span.textContent = text;
        return span;
      }));
      if (source.value.endsWith('\n')) paint.append('​');
      syncViewport();
    };
    let worker: Worker | undefined;
    let edit = 0;
    let pending = 0;
    let request: CompileRequest | undefined;
    let active: CompileRequest | undefined;
    let deadline = 0;

    const finish = (reply: CompileReply) => {
      if (reply.id !== active?.id) return;
      const compiled = active;
      active = undefined;
      window.clearTimeout(deadline);
      if ('error' in reply && reply.restart) {
        worker?.terminate();
        worker = undefined;
      }
      if (compiled.id === edit && life) {
        if ('error' in reply) {
          status.textContent = `Version ${version} is still running. ${reply.error}`;
        } else {
          try {
            const { stepMs, width, height } = life.settings;
            version = life.install(reply.settings);
            refreshBoard(life);
            draw();
            if (reply.settings.stepMs !== stepMs) schedule();
            loaded = compiled.source;
            versionLabel.textContent = `VERSION ${version}`;
            const resized = width !== life.settings.width || height !== life.settings.height;
            const stateMessage = resized ? 'Grid resized. Cells within its bounds were kept.' : 'Board state preserved.';
            status.textContent = `Version ${version} loaded at generation ${life.generation}. ${stateMessage}`;
          } catch (error) {
            status.textContent = error instanceof Error ? error.message : 'The runtime refused the update.';
          }
        }
      }
      dispatch();
    };

    function getWorker(): Worker {
      if (!worker) {
        worker = new Worker(new URL('../lib/life-compiler.worker.ts', import.meta.url), { type: 'module' });
        worker.onmessage = ({ data }: MessageEvent<CompileReply>) => finish(data);
        worker.onerror = () => {
          if (active) finish({ id: active.id, error: 'Could not start the Cinch compiler.', restart: true });
          else { worker?.terminate(); worker = undefined; }
        };
      }
      return worker;
    }

    function dispatch() {
      if (active || !request || request.id !== edit) return;
      const candidate = request;
      request = undefined;
      active = candidate;
      status.textContent = `Compiling. Version ${version} continues to run.`;
      try {
        getWorker().postMessage(candidate);
        deadline = window.setTimeout(() => finish({
          id: candidate.id, error: 'This edit took too long to compile.', restart: true,
        }), 15000);
      } catch {
        finish({ id: candidate.id, error: 'Could not start the Cinch compiler.', restart: true });
      }
    }

    source.addEventListener('input', () => {
      repaint();
      const id = ++edit;
      window.clearTimeout(pending);
      request = undefined;
      if (source.value === loaded) {
        status.textContent = `Version ${version} is running.`;
        return;
      }
      pending = window.setTimeout(() => {
        request = { id, source: source.value };
        dispatch();
      }, 350);
    });

    repaint();
    void Life.load(boardUrl).then((board) => {
      life = board;
      refreshBoard(board);
      versionLabel.textContent = 'VERSION 1';
      root.querySelectorAll<HTMLButtonElement>('.life-keys button').forEach((button) => { button.disabled = false; });
      source.disabled = false;
      status.textContent = 'Version 1 is loaded. Edit Life.cinch to compile a new version.';
      draw();
    }).catch(() => {
      status.textContent = 'The WebAssembly board could not be loaded. Reload the page to retry.';
    });
  }
</script>
