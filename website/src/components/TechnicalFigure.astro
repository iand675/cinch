---
import '../styles/technical-figure.css';
interface Props { id?: string; }
const { id = 'vector-contract' } = Astro.props;
---
<figure class="technical-figure not-content" aria-labelledby={`${id}-caption`}>
  <div class="figure-running-head"><span>FIG. 01 / DEPENDENT TYPES</span><span>INPUT → BORROWED RESULT</span></div>
  <div class="figure-drawing">
    <svg viewBox="0 0 720 310" role="img" aria-labelledby={`${id}-title ${id}-description`}>
      <title id={`${id}-title`}>A three-element vector and a reference to its first element</title>
      <desc id={`${id}-description`}>Three cells form one vector. The first cell is highlighted. The remaining two cells form the tail. A result reference points back to the first cell, borrowing its value rather than copying it.</desc>
      <defs>
        <pattern id={`${id}-hatch`} width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(35)"><path d="M0 0V5" stroke="currentColor" stroke-width=".6" opacity=".38" /></pattern>
        <marker id={`${id}-arrow`} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M1 1L7 4 1 7" fill="none" stroke="currentColor" stroke-width="1" /></marker>
      </defs>
      <g class="figure-construction" fill="none" stroke="currentColor" stroke-width=".8" stroke-dasharray="3 4">
        <path d="M172 109V53M536 109V53M172 224H536M172 109H536M172 109V224M536 109V224" />
        <path d="M280 121L306 105M280 189L306 173" />
      </g>
      <g fill="none" stroke="currentColor" stroke-width="1">
        <path d="M178 60H530" marker-start={`url(#${id}-arrow)`} marker-end={`url(#${id}-arrow)`} />
        <path d="M172 54V66M536 54V66" />
      </g>
      <text class="figure-dimension" x="354" y="43" text-anchor="middle">n + 1 = 3</text>
      <g stroke="currentColor" stroke-width="1.25" stroke-linejoin="round">
        <path class="figure-first-top" d="M167 135L201 113H287L253 135Z" />
        <path class="figure-first-front" d="M167 135H253V200H167Z" />
        <path class="figure-first-side" d="M253 135L287 113V178L253 200Z" />
        <path d="M167 135H253V200H167Z" fill={`url(#${id}-hatch)`} />
        <path class="figure-cell" d="M307 135L341 113H427L393 135Z" />
        <path class="figure-cell" d="M307 135H393V200H307Z" />
        <path class="figure-cell-side" d="M393 135L427 113V178L393 200Z" />
        <path class="figure-cell" d="M415 135L449 113H535L501 135Z" />
        <path class="figure-cell" d="M415 135H501V200H415Z" />
        <path class="figure-cell-side" d="M501 135L535 113V178L501 200Z" />
        <path d="M157 219H511L548 195M157 219V230M511 219V230" fill="none" />
      </g>
      <g class="figure-value" text-anchor="middle"><text x="210" y="175">x</text><text x="350" y="175">y</text><text x="458" y="175">z</text></g>
      <g fill="none" stroke="currentColor" stroke-width="1.1">
        <path d="M82 95H127L167 134" /><circle cx="69" cy="95" r="12" />
        <path d="M625 93H587L481 124" /><circle cx="638" cy="93" r="12" />
        <path d="M83 273H146L204 203" marker-end={`url(#${id}-arrow)`} /><circle cx="70" cy="273" r="12" />
        <path d="M307 245H535M307 239V251M535 239V251" />
      </g>
      <g class="figure-callout" text-anchor="middle"><text x="69" y="99">1</text><text x="638" y="97">2</text><text x="70" y="277">3</text></g>
      <text class="figure-dimension" x="421" y="273" text-anchor="middle">n = 2</text>
    </svg>
  </div>
  <ol class="figure-legend">
    <li><span>Input</span><code>Ref region<br /> (Vec (n + 1) a)</code></li>
    <li><span>Remaining tail</span><p>n elements</p></li>
    <li><span>Borrowed result</span><code>Ref region a</code></li>
  </ol>
  <figcaption id={`${id}-caption`}><strong>Figure 01. A nonempty vector.</strong> The illustrated input has length 3, so n = 2. The result refers to the first element and cannot outlive the input.</figcaption>
</figure>
