---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { data, id } = Astro.locals.starlightRoute.entry;
const section = id.startsWith('tutorials/') ? 'Learn Cinch' : id.startsWith('specifications/') ? 'Language reference' : id.startsWith('design/') ? 'Design notes' : 'Overview';
const { source, exported, added } = data as {
  source?: string;
  exported?: string;
  added?: string;
};

const isUrl = source ? /^https?:\/\//.test(source) : false;
const exportedLabel = exported ? new Date(exported) : undefined;
const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const exportedText =
  exportedLabel && !Number.isNaN(exportedLabel.getTime())
    ? dateFormat.format(exportedLabel)
    : exported;
---

<div class="doc-title-rail" aria-hidden="true"><span></span><i></i><span></span></div>
<div class="doc-eyebrow"><a href="/overview/">CINCH</a><span>/</span><span>{section}</span><span class="doc-draft">DRAFT</span></div>
<Default><slot /></Default>

{
  source && (
    <p class="doc-provenance">
      {exported || added ? (
        <span>
          {exported ? 'Exported' : 'Added'} {exportedText ?? added}
        </span>
      ) : null}
      {exported || added ? <span class="separator" aria-hidden="true">·</span> : null}
      <span>
        Source:{' '}
        {isUrl ? (
          <a href={source} rel="noreferrer">
            original page
          </a>
        ) : (
          source
        )}
      </span>
    </p>
  )
}
