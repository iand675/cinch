---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { data, id } = Astro.locals.starlightRoute.entry;
const isReaderGuide = id === 'documentation' || /^(learn|reference|library)\//.test(id);
const section = id.startsWith('learn/') ? 'Language tutorial' : id.startsWith('reference/') ? 'Compiler user’s guide' : id.startsWith('library/') ? 'Library reference' : isReaderGuide ? 'Documentation' : 'Design archive';
const { source, exported, added } = data as {
  source?: string;
  exported?: string;
  added?: string;
};

const isUrl = source ? /^https?:\/\//.test(source) : false;
const exportedLabel = exported ? new Date(exported) : undefined;
const dateFormat = new Intl.DateTimeFormat('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const exportedText =
  exportedLabel && !Number.isNaN(exportedLabel.getTime())
    ? dateFormat.format(exportedLabel)
    : exported;
---

<div class="doc-title-rail" aria-hidden="true"><span></span><i></i><span></span></div>
<div class="doc-eyebrow"><a href="/documentation/">CINCH</a><span>/</span><span>{section}</span><span class="doc-draft">{isReaderGuide ? 'RUST COMPILER' : 'DESIGN ARCHIVE'}</span></div>
<Default><slot /></Default>
{!isReaderGuide && <p class="doc-archive-note">This page belongs to the original design archive. For current Rust compiler behaviour, read the <a href="/documentation/">documentation</a> and <a href="/reference/16-support-and-roadmap/">support matrix</a>. Planned behaviour is marked Coming soon in the reader guides.</p>}

{
  source && (
    <p class="doc-provenance">
      {exported || added ? (
        <span>
          {exported ? 'Exported' : 'Added'} {exportedText ?? added}
        </span>
      ) : null}
      {exported || added ? <span class="separator" aria-hidden="true">·</span> : null}
      <span>
        Source:{' '}
        {isUrl ? (
          <a href={source} rel="noreferrer">
            original page
          </a>
        ) : (
          source
        )}
      </span>
    </p>
  )
}
