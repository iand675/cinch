module Main where
  import Data.List
  import Data.NonEmpty

  -- Average order value. Needs at least one order.
  average :: NonEmpty Int -> Int
  average orders =
    sum-list 0 (unrefine orders) / length (unrefine orders)

  -- Matching on the list is evidence: in the Cons branch it is not empty.
  report :: List Int -> Option Int
  report orders = case orders of
    Nil -> None
    Cons first rest -> Some (average orders)

  main :: Int
  main = 0
