module Life where
  import Data.Machine

  data Cell where
    Dead :: Cell
    Alive :: Cell

  -- What a cell becomes, given how many of its eight neighbours are alive.
  rule :: Cell -> Int -> Cell
  rule cell n = case cell of
    Alive -> if n == 2 || n == 3 then Alive else Dead
    Dead -> if n == 3 then Alive else Dead

  -- One compiled bit for each pair (cell, neighbour count).
  cell-bit :: Cell -> U32
  cell-bit cell = case cell of
    Alive -> 1
    Dead -> 0

  rule-bits :: Cell -> U32 -> U32
  rule-bits cell count =
    if eq-u32 count 9 then 0 else
      let bit = cell-bit (rule cell (int-from-i64 (u32-to-i64 count))) in
      bit-or-u32 (wrapping-shl-u32 bit count) (rule-bits cell (wrapping-add-u32 count 1))

  initial-rule :: Unit -> U32
  initial-rule () = bit-or-u32 (rule-bits Dead 0) (wrapping-shl-u32 (rule-bits Alive 0) 9)

  -- Three packed rows slide past the current cell. Bits beyond the board
  -- are zero, so neighbours beyond the edges count as dead.
  neighbourhood :: U64 -> U32
  neighbourhood row = count-ones-u64 (bit-and-u64 row 7)

  scan-row :: U32 -> U32 -> U64 -> U64 -> U64 -> U64 -> U64
  scan-row rules column above row below next =
    if eq-u32 column 40 then next else
      let live = wrapping-u64-to-u32 (bit-and-u64 (wrapping-shr-u64 row 1) 1) in
      let total = wrapping-add-u32 (wrapping-add-u32 (neighbourhood above) (neighbourhood row)) (neighbourhood below) in
      let neighbours = wrapping-sub-u32 total live in
      let index = wrapping-add-u32 neighbours (wrapping-mul-u32 9 live) in
      let result = wrapping-u32-to-u64 (bit-and-u32 (wrapping-shr-u32 rules index) 1) in
      scan-row rules (wrapping-add-u32 column 1)
        (wrapping-shr-u64 above 1) (wrapping-shr-u64 row 1) (wrapping-shr-u64 below 1)
        (bit-or-u64 next (wrapping-shl-u64 result column))

  step-row :: U32 -> U64 -> U64 -> U64 -> U64
  step-row rules above row below =
    scan-row rules 0 (wrapping-shl-u64 above 1) (wrapping-shl-u64 row 1) (wrapping-shl-u64 below 1) 0

  foreign export ccall "life_initial_rule" initial-rule :: Unit -> U32
  foreign export ccall "life_step_row" step-row :: U32 -> U64 -> U64 -> U64 -> U64
