module Life where
  import Data.Machine

  -- Age 0 is dead. Living cells have ages 1 through 32.
  -- Try n == 3 || n == 6 in the birth branch for HighLife.
  next-age :: Int -> Int -> Int
  next-age age n =
    if age == 0 then
      if n == 3 then 1 else 0
    else
      if n == 2 || n == 3 then
        if age < 32 then age + 1 else age
      else 0

  -- Bits 0–2 are above, 3–4 beside, and 5–7 below.
  neighbour-count :: U32 -> Int
  neighbour-count mask = count-bits mask

  count-bits :: U32 -> Int
  count-bits mask =
    if eq-u32 mask 0 then 0 else
      let bit = if eq-u32 (bit-and-u32 mask 1) 0 then 0 else 1 in
      bit + count-bits (wrapping-shr-u32 mask 1)

  -- Join the opposite sides of the board.
  wrap-edges :: Bool
  wrap-edges = True

  -- Live cell colour, as 0xRRGGBB.
  cell-color :: Int -> Int
  cell-color age =
    if age == 1 then 0xffd69c else
    if age < 4 then 0xe9b071 else
    if age < 12 then 0xaab680 else 0x829866

  -- Milliseconds per step. Use 0 for one step per frame.
  step-ms :: Int
  step-ms = 80
