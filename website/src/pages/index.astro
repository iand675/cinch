---
import Brand from '../components/Brand.astro';
import HeroHeadline from '../components/HeroHeadline.astro';
import ContractConsole from '../components/ContractConsole.astro';
import AverageFigure from '../components/AverageFigure.astro';
import averageSource from '../data/examples/average-report.cinch?raw';
import RunnableSource from '../components/RunnableSource.astro';
import CompilerPrintout from '../components/CompilerPrintout.astro';
import uncheckedSource from '../data/examples/average-unchecked.cinch?raw';
import LanguageTour from '../components/LanguageTour.astro';
import LiveEvolution from '../components/LiveEvolution.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import { project } from '../lib/project';
import PremiumPagePreview from '../components/PremiumPagePreview.astro';
import FreePagePreview from '../components/FreePagePreview.astro';
import '../styles/custom.css';
import '../styles/landing.css';
const tutorial = '/learn/01-first-program/';
// What each remedy in the compiler's message means for this code (all three are checked examples).
const printoutLegend = [
  { title: 'Decide it', text: 'Test at run time and keep the evidence. <code>report</code> does this with <code>non-empty</code>, which returns <code>None</code> for an empty list.' },
  { title: 'Branch on it', text: 'Match on the list. In the <code>Cons</code> branch the compiler knows it has an element.' },
  { title: 'Pass it in', text: 'Ask for a <code>NonEmpty Int</code> in <code>report</code>’s own type, and let its caller decide.' },
];
const features = [
  { n: '01', title: 'Ownership and effects', text: 'A signature lists the effects a function can perform and the data it borrows. A higher-order function takes on the effects of its callback, so mapping a logging function over a list is a logging computation, and the type says so.', href: '/learn/12-ownership-and-regions/', link: 'Tutorial 12: Ownership, borrowing, and regions' },
  { n: '02', title: 'Structured concurrency', text: 'Every task belongs to a scope and finishes before the scope does, so a request handler cannot leak background work. Channels are bounded and move ownership of what they carry, which means a full channel slows its sender down. Cancellation, joining, and cleanup each have their own contract.', href: '/learn/17-structured-concurrency/', link: 'Tutorial 17: Structured tasks and cancellation' },
  { n: '03', title: 'Temporal contracts', text: 'State what a service must never do and what it must eventually do: a payment is never captured twice, and every accepted order is eventually shipped or refunded. Assumptions about the scheduler and the network are written into the contract, where a reviewer can see them.', href: '/learn/21-upgrades-and-contracts/', link: 'Tutorial 21: State evolution and temporal contracts' },
  { n: '04', title: 'Productive streams', text: 'A stream can be infinite, like a feed of log lines or market ticks. The compiler checks that each stream always produces its next element, so a consumer never hangs waiting. A search that might never find a match gets a weaker type, because it might never return.', href: '/learn/15-streams-and-producers/', link: 'Tutorial 15: Productive streams and partial producers' },
  { n: '05', title: 'Foreign code and Wasm', text: 'Keep the C and Rust libraries you already depend on. A foreign call declares its ABI, who owns each pointer, and how it fails, so the unsafe boundary is written down in one place. WebAssembly component interfaces carry the same information.', href: '/learn/20-foreign-code-and-targets/', link: 'Tutorial 20: Foreign code, layouts, and target profiles' },
];
---
<!doctype html>
<html lang="en" class="cinch-landing" data-theme="dark">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <title>Cinch — Bulletproof code.</title>
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <meta name="description" content="Bulletproof code. Cinch is a functional language for the programs you ship. If a Cinch program compiles, it does not crash, and anything that can still go wrong shows up in its type." />
    <meta name="theme-color" content="#191a17" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/momo-trust-display.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-400.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="landing-skip" href="#main">Skip to content</a>
    <header class="landing-header">
      <div class="header-identity"><Brand /></div>
      <SiteNavigation />
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
                <div class="hero-grid">
          <div class="hero-copy">
            <div class="hero-runhead"><div class="hero-stripes" aria-hidden="true"><span></span><span></span><span></span></div><p class="mono">Software from the future we were promised</p></div>
            <HeroHeadline />
            <p class="hero-description">A functional language for the programs you ship.</p>
            <p class="hero-detail">If a Cinch program compiles, it does not crash. Anything that can still go wrong, like a missing file or a dropped connection, shows up in its type. The compiler works out most guarantees from your types and pattern matches, and when one is missing it tells you how to supply it.</p>
            <div class="hero-actions"><a class="button button-primary" href="/downloads/">Get Cinch <span>↗</span></a><a class="text-link" href={tutorial}>Write your first program <span>→</span></a></div>
            <p class="hero-note">Prebuilt for macOS, Linux, and Windows. The tutorial assumes no Haskell.</p>
          </div>
          <ContractConsole />
        </div>
        <div class="hero-baseline mono"><a href="#why-cinch">INSIDE THE LANGUAGE <span>↓</span></a></div>
      </section>
      <section class="manifesto light-section" id="why-cinch" aria-labelledby="manifesto-title">
        <div class="section-index mono"><span>THE LANGUAGE</span></div>
        <div class="manifesto-grid"><h2 id="manifesto-title">Familiar code.<br /><span>Stronger types.</span></h2><div class="manifesto-copy"><p>If you have written Haskell or OCaml, most Cinch code will look familiar. What changes is how much a type can say, and that the compiler holds the code to it.</p><p>Algebraic data types, pattern matching, higher-order functions, and instances work as you would expect. Evaluation is strict, and ownership and borrowing manage memory, files, and sockets without a tracing garbage collector.</p><p>When you need a stronger guarantee, such as an index that is in bounds or a list that is never empty, you write it in the type and the compiler checks it. Linear arithmetic like <code>i + 1 &lt;= length xs</code> is checked for you.</p><a class="text-link" href="/specifications/core-language-specification/">Core language specification <span>↗</span></a></div></div>
        <nav class="language-jump" aria-label="Explore language features"><a href="#proofs">Checked data ↓</a><a href="#specialization">Type specialization ↓</a><a href="#staging">Typed staging ↓</a><a href="#optimization">Optimization ↓</a><a href="#live-development">Incremental builds and hot reload ↓</a><a href="#runtime-contracts">Runtime contracts ↓</a></nav>
      </section>
      <div class="panel-joint" aria-hidden="true"><span></span><i></i><span></span></div>
      <section class="proof-section" id="average" aria-labelledby="proof-title">
        <div class="section-index mono"><span>REFINEMENT TYPES</span></div>
        <div class="proof-grid">
          <div class="proof-copy"><h2 id="proof-title">The empty&#8209;list <br />crash <em>never ships.</em></h2><p>Every codebase has a function like this: average order value, mean response time, the failure rate of last night’s jobs. It passes every test. Then a customer with no orders opens the dashboard and it divides by zero.</p><p class="muted">In Cinch, division takes a divisor that cannot be zero. <code>average</code> asks for a <code>NonEmpty</code> list, whose length is never zero, so it needs no check of its own. Code holding an ordinary list has to decide, once, what an empty history means.</p><a class="text-link" href="/learn/13-refinements-and-safe-operations/">Refinements and safe operations <span>↗</span></a></div>
          <RunnableSource file="average-report.cinch" source={averageSource}><div class="code-note"><span class="proof-check">↳</span><p><strong>Hand it an ordinary list</strong><br /><code>report orders = average orders</code> asks for a fact the compiler cannot see.</p><button type="button" class="gadget-key" data-print aria-pressed="false">Check it <span aria-hidden="true">▸</span></button></div><CompilerPrintout file="average-unchecked.cinch" source={uncheckedSource} legend={printoutLegend} /></RunnableSource>
        </div>
        <AverageFigure id="landing-average-figure" />
      </section>
      <LanguageTour />
      <LiveEvolution />
      <section class="feature-section light-section" id="runtime-contracts" aria-labelledby="features-title">
        <div class="section-index mono"><span>RUNTIME CONTRACTS</span></div>
        <h2 id="features-title">Carry the contract<br />into a running system.</h2>
        <div class="feature-list">{features.map(feature => <article class="feature-row"><span class="feature-number mono" aria-hidden="true">{feature.n}</span><div><h3>{feature.title}</h3></div><div><p>{feature.text}</p><a class="text-link" href={feature.href}>{feature.link}<span>↗</span></a></div></article>)}</div>
      </section>
      <section class="reading-section" aria-labelledby="reading-title">
        <div class="section-index mono"><span>DOCUMENTATION</span></div>
        <div class="reading-heading"><h2 id="reading-title">Learn the<br />language.</h2><p>Start with a working program.<br />Keep the compiler guide nearby.</p></div>
        <div class="reading-links"><a href={tutorial}><h3>Tutorials</h3><p>22 chapters, from a first executable to concurrency and live upgrades, each with worked programs and exercises.</p><span class="reading-arrow" aria-hidden="true">↗</span></a><a href="/reference/00-guide/"><h3>Compiler guide</h3><p>Syntax, commands, and the checking rule behind each error the compiler reports.</p><span class="reading-arrow" aria-hidden="true">↗</span></a><a href="/library/00-index/"><h3>Library reference</h3><p>Every module that ships with the compiler, documented from its checked interface.</p><span class="reading-arrow" aria-hidden="true">↗</span></a></div>
        
      </section>
      <section class="closing"><div class="mono">TUTORIAL 1 / BUILD AND RUN A PROGRAM</div><a href={tutorial}><h2>Write your<br /><span>first program.</span></h2><span class="closing-arrow" aria-hidden="true">↗</span></a><p class="closing-note">Chapter 1 starts from an empty directory and ends with a running program.</p></section>
    </main>
    <footer class="landing-footer"><Brand /><div><a href="/documentation/">Documentation</a><a href="/packages/">Packages</a><a href="/downloads/">Downloads</a><a href={project.repository}>GitHub ↗</a><a href="#main">Back to top ↑</a></div></footer>
    <PremiumPagePreview />
    <FreePagePreview />
  </body>
</html>
