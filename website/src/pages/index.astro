---
import Brand from '../components/Brand.astro';
import HeroHeadline from '../components/HeroHeadline.astro';
import ContractConsole from '../components/ContractConsole.astro';
import AverageFigure from '../components/AverageFigure.astro';
import averageSource from '../data/examples/average-report.cinch?raw';
import RunnableSource from '../components/RunnableSource.astro';
import CompilerPrintout from '../components/CompilerPrintout.astro';
import AgentLoop from '../components/AgentLoop.astro';
import FeedbackToolbar from '../components/FeedbackToolbar.astro';
import uncheckedSource from '../data/examples/average-unchecked.cinch?raw';
import LanguageTour from '../components/LanguageTour.astro';
import LiveEvolution from '../components/LiveEvolution.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import { project } from '../lib/project';
import PremiumPagePreview from '../components/PremiumPagePreview.astro';
import FreePagePreview from '../components/FreePagePreview.astro';
import '../styles/custom.css';
import '../styles/landing.css';
const tutorial = '/learn/01-first-program/';
// Why an agent does better in Cinch. Each claim is backed by the compiler or the design documents linked.
const agentReasons = [
  { title: 'Errors that tell you the fix', text: 'When a build fails, the compiler names the exact missing check and lists the ways to satisfy it. An agent reads one error and makes one clean edit instead of guessing from a production crash.', href: '/reference/06-refinements/', link: 'Refinements and obligations' },
  { title: 'Add strictness one function at a time', text: 'Start with plain lists, records, and <code>Option</code>. When a rule actually matters, add a type like <code>NonEmpty</code> or <code>Discount</code> to one function and let the compiler flag every caller that needs updating.', href: '/learn/13-refinements-and-safe-operations/', link: 'Refine values step by step' },
  { title: 'No escape hatches to cheat with', text: 'A small standalone kernel double-checks every claim the compiler proves, and there is no escape hatch like <code>as any</code> to silence an error. A passing build means the rule really holds.', href: '/reference/08-dependent-types-and-proofs/', link: 'Dependent types and checks' },
  { title: 'Read the contract, not the whole file', text: 'Every module produces a compact <code>.cinchif</code> summary of its types, side effects, and safety rules. Agents and reviewers can understand a module’s guarantees without reading thousands of lines of implementation.', href: '/reference/18-artifacts-and-incremental/', link: 'Compiled interfaces' },
  { title: 'Side effects you can see at a glance', text: 'A function can only perform the side effects written in its type (like <code>IO</code> for disk or network), using handles explicitly passed in. If a signature does not mention <code>IO</code>, that code literally cannot open a socket or read a file.', href: '/learn/10-effects-and-io/', link: 'Effects and capabilities' },
  { title: 'Fast without a second rewrite', text: 'Because Cinch compiles straight to native machine code with deterministic reference counting and no garbage collector, the first correct version you or an agent writes is already fast enough for production.', href: '/learn/19-rewrites-and-performance/', link: 'Laws, rewrites, and performance' },
];
// What each remedy in the compiler's message means for this code (all three are checked examples).
const printoutLegend = [
  { title: 'Check once at the edge', text: 'Validate the list once and keep the proof. <code>report</code> calls <code>non-empty</code>, which returns <code>None</code> when the list is empty.' },
  { title: 'Branch on the list', text: 'Pattern match on the list directly. Inside the non-empty branch, the compiler already knows it has at least one item.' },
  { title: 'Push it to the caller', text: 'Take <code>NonEmpty Int</code> in <code>report</code>’s own signature and let the caller decide what no orders means.' },
];
const features = [
  { n: '01', title: 'Effects and capabilities', text: 'Know at a glance whether a function can touch the disk, network, or clock. Functions list allowed side effects on their arrow (<code>-&gt;{IO r}</code>) and receive runtime handles explicitly (<code>using (io :: Io r)</code>). Pure code cannot sneak in hidden I/O, and mocking in tests is just passing a different handle.', href: '/learn/10-effects-and-io/', link: 'Tutorial 10: Effects and capabilities' },
  { n: '02', title: 'Linear ownership and regions', text: 'Make resource leaks and double-frees compile errors. Mark a file handle, lock, or permit as linear (<code>%1</code>) so it must be closed exactly once, or affine (<code>%aff</code>) so it can be used at most once without copying. Borrowed references (<code>Ref</code>, <code>Mut</code>) are checked at compile time with no garbage collector.', href: '/learn/12-ownership-and-regions/', link: 'Tutorial 12: Ownership, borrowing, and regions' },
  { n: '03', title: 'Structured concurrency and STM', text: 'No more leaked background tasks or mystery race conditions. Every spawned task belongs to a lexical scope and returns a linear handle you have to join before leaving. Cancellation is cooperative, bounded channels pass ownership with backpressure, and software transactional memory (STM) handles shared state.', href: '/learn/17-structured-concurrency/', link: 'Tutorial 17: Structured tasks and cancellation' },
  { n: '04', title: 'Temporal contracts and safety profiles', text: 'Check rules that span time (like "every opened checkout eventually completes or rolls back") right on your real service using <code>always</code>, <code>stable</code>, <code>eventually</code>, and <code>recur</code>. For embedded or latency-critical code, opt into compile-time budgets like <code>#[no-alloc]</code>, <code>#[stack "constant"]</code>, and <code>#[profile "jpl"]</code>.', href: '/learn/21-upgrades-and-contracts/', link: 'Tutorial 21: State evolution and temporal contracts' },
  { n: '05', title: 'Zero-libc static binaries', text: 'Ship a single self-contained binary with zero runtime dependencies. Like Go, Cinch talks directly to the OS kernel through its own syscall layer, so binaries need no <code>glibc</code> or C runtime and drop straight into empty scratch containers. When you do call C libraries, <code>foreign import</code> keeps the boundary explicit and auditable.', href: '/reference/15-ffi-layout-and-attributes/', link: 'FFI, syscalls, and layouts' },
  { n: '06', title: 'Incremental adoption and C++ bindgen', text: 'You never have to rewrite an existing codebase to use Cinch. Add one <code>foreign export ccall</code> line and run <code>cinch build --shared</code> to get a standard C library callable from C, Rust, Go, or Python with no GC fighting your host. For C++17, <code>cinch cxx</code> generates two-way bindings, normal C++ classes with constructors and destructors, and Godot GDExtensions.', href: '/reference/15-ffi-layout-and-attributes/#linking-native-objects-libraries-and-c', link: 'Foreign exports, shared libraries, and C++' },
  { n: '07', title: 'WebAssembly, WASI, and browser UIs', text: 'Compile straight to small, GC-free WebAssembly modules, WASI components (WIT), and browser bundles. Combined with TSX-style syntax macros, you can share the exact same domain types and validation rules between backend and browser while sandboxing untrusted native libraries.', href: '/reference/19-targets-and-components/', link: 'Targets, SIMD, and Wasm components' },
  { n: '08', title: 'GPU and data-parallel kernels', text: 'Run heavy numeric and ML workloads without stepping outside the language. Pure <code>Array</code> and <code>Tensor</code> pipelines carry static shapes, checked bounds, and no data races, fusing and compiling straight to GPU kernels while the type system checks the CPU-to-GPU boundary.', href: '/packages/stdlib/Data.Tensor/', link: 'Tensors and data-parallel arrays' },
  { n: '09', title: 'Strict by default, lazy when you ask', text: 'Code evaluates when you write it, so memory usage stays predictable under load instead of silently piling up deferred work. When you actually want lazy evaluation or infinite feeds like log streams and market ticks, opt in with one-shot thunks, scoped memo cells, or guarded streams checked not to hang.', href: '/learn/15-streams-and-producers/', link: 'Tutorial 15: Productive streams and partial producers' },
  { n: '10', title: 'Thoughtful syntax and explicit instances', text: 'Small details you type thousands of times a day: hyphenated <code>kebab-case</code> names (fewer Shift presses), <code>?</code> and <code>!</code> in names for boolean checks (<code>empty?</code>) and side effects (<code>print!</code>), and built-in <code>[...]</code> and <code>{ k =&gt; v }</code> literals. Named explicit <code>instance</code> blocks sit alongside automatic <code>implicit instance</code> resolution, so you never get blocked when one type needs two different sort orders or serializers.', href: '/learn/09-signatures-and-instances/', link: 'Tutorial 09: Signatures and instances' },
];
---
<!doctype html>
<html lang="en" class="cinch-landing" data-theme="dark">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <title>Cinch — Bulletproof code.</title>
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <meta name="description" content="Cinch is a compiled language where bugs that normally crash in production cannot compile. Fast native binaries with no garbage-collector pauses, incremental safety rules, C/C++ interop, WebAssembly, and GPU kernels." />
    <meta name="theme-color" content="#191a17" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/momo-trust-display.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-400.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="landing-skip" href="#main">Skip to content</a>
    <header class="landing-header">
      <div class="header-identity"><Brand /></div>
      <SiteNavigation />
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
                <div class="hero-grid">
          <div class="hero-copy">
            <div class="hero-runhead"><div class="hero-stripes" aria-hidden="true"><span></span><span></span><span></span></div><p class="mono">Software from the future we were promised</p></div>
            <HeroHeadline />
            <p class="hero-description">Fast native software where common production crashes cannot compile.</p>
            <p class="hero-detail">Null dereferences, empty-list bugs, out-of-bounds reads, and forgotten cleanup usually show up in production. Cinch catches them before your code ever runs, while keeping memory fast and predictable with no garbage-collector pauses. One compiler targets standalone static binaries, C/C++ libraries, WebAssembly, and GPU kernels.</p>
            <div class="hero-actions"><a class="button button-primary" href="/downloads/">Get Cinch <span>↗</span></a><a class="text-link" href={tutorial}>Write your first program <span>→</span></a></div>
            <p class="hero-note">Static binaries for Linux and macOS with no libc needed. Written for working developers, with no Haskell or formal-methods background required.</p>
          </div>
          <ContractConsole />
        </div>
        <div class="hero-baseline mono"><a href="#why-cinch">INSIDE THE LANGUAGE <span>↓</span></a></div>
      </section>
      <section class="manifesto light-section" id="why-cinch" aria-labelledby="manifesto-title">
        <div class="manifesto-grid"><h2 id="manifesto-title">Code that can’t<br /><span>lie to you.</span></h2><div class="manifesto-copy"><p>In most codebases, the rules that keep production up live in comments, tests, and hope: this list is never empty, this function won’t touch the network, this lock always gets released. When someone breaks one six months later, you find out from an outage.</p><p>Cinch is built around a simple standard: if a rule matters, the compiler should check it, and a function’s signature should tell the whole truth about what can fail, what side effects it performs, and what resources it owns. Because it tackles safety, native speed, hot reload, and formal checks together, there is more here than in a tiny language. You do not need all of it on day one: start with ordinary lists, records, and <code>Option</code>, tighten rules only where bugs hurt, and drop Cinch into an existing C, Rust, or C++ project one module at a time.</p><p>Most safe high-level languages trade away predictable latency for a tracing garbage collector. Cinch runs code eagerly (never lazily by surprise) and uses compiler-inserted reference counting with in-place reuse, so memory is freed immediately with no GC pauses. Every check the compiler proves ahead of time disappears from the final machine code.</p><a class="text-link" href="/reference/04-types-and-kinds/">Types, kinds, and refinements <span>↗</span></a></div></div>
        <nav class="language-jump" aria-label="Explore language features"><a href="#agents">For coding agents ↓</a><a href="#proofs">Checked rules ↓</a><a href="#specialization">Memory &amp; speed ↓</a><a href="#staging">Custom syntax &amp; UI ↓</a><a href="#optimization">Optimization ↓</a><a href="#live-development">Fast builds &amp; hot reload ↓</a><a href="#runtime-contracts">Systems &amp; targets ↓</a></nav>
      </section>
      <div class="panel-joint" aria-hidden="true"><span></span><i></i><span></span></div>
      <section class="proof-section" id="average" aria-labelledby="proof-title">
        <div class="proof-grid">
          <div class="proof-copy"><h2 id="proof-title">Crashing code<br /><em>never ships.</em></h2><p>Every codebase has a function like this: average order value, mean latency, failure rate of last night’s batch. It passes every test with sample data. Then a brand-new customer with zero orders opens the dashboard and it divides by zero.</p><p class="muted">In most languages, division silently throws or crashes at runtime unless you remember to guard every call site. In Cinch, operations that can crash simply do not exist: division requires a nonzero divisor, and <code>average</code> asks for a <code>NonEmpty</code> list. Any caller holding an ordinary list has to handle the empty case once (returning an <code>Option</code> or a fallback like <code>"no orders yet"</code>), and the compiler removes the runtime check from the division itself.</p><a class="text-link" href="/learn/13-refinements-and-safe-operations/">Refinements and safe operations <span>↗</span></a></div>
          <RunnableSource file="average-report.cinch" source={averageSource} stopBefore="regular ::"><div class="code-note"><span class="proof-check">↳</span><p><strong>What if you forget to check?</strong><br />Calling <code>average orders</code> on a plain <code>List Int</code> stops the build and explains how to fix it.</p><button type="button" class="gadget-key" data-print aria-pressed="false">Check it <span aria-hidden="true">▸</span></button></div><CompilerPrintout file="average-unchecked.cinch" source={uncheckedSource} legend={printoutLegend} /></RunnableSource>
        </div>
        <AverageFigure id="landing-average-figure" />
      </section>
      <section class="agents-section language-section" id="agents" aria-labelledby="agents-title">
        <div class="tour-heading"><h2 id="agents-title">Your LLM’s new<br />favorite language.</h2><p>AI coding agents work in a loop: write code, run the compiler, read the error, try again. In loosely typed languages (or languages with <code>any</code> and unsafe casts), models learn to make tests pass by papering over bugs. In Cinch, a green build proves the contract actually holds, so an agent can iterate fast while you review the signatures.</p></div>
        <AgentLoop />
        <div class="agent-reasons">{agentReasons.map(r => <article><h3>{r.title}</h3><p set:html={r.text} /><a class="text-link" href={r.href}>{r.link} <span>↗</span></a></article>)}</div>
      </section>
      <LanguageTour />
      <LiveEvolution />
      <section class="feature-section light-section" id="runtime-contracts" aria-labelledby="features-title">
        <h2 id="features-title">Systems features,<br />built in.</h2>
        <div class="feature-list">{features.map((feature, i) => <article class="feature-row"><span class="feature-number mono" aria-hidden="true" style={`--filled:${i + 1};--total:${features.length}`}>{feature.n}</span><div><h3>{feature.title}</h3></div><div><p set:html={feature.text} /><a class="text-link" href={feature.href}>{feature.link}<span>↗</span></a></div></article>)}</div>
      </section>
      <section class="reading-section" aria-labelledby="reading-title">
        <div class="reading-heading"><h2 id="reading-title">Learn the<br />language.</h2><p>One idea per chapter, with worked code and exercises. Written for working programmers, with no Haskell or type-theory background assumed. Syntax and details are still moving while the language settles.</p></div>
        <div class="reading-links"><a href={tutorial}><h3>Tutorials</h3><p>22 chapters, from your first static binary to refinements, structured concurrency, and live upgrades.</p><span class="reading-arrow" aria-hidden="true">↗</span></a><a href="/reference/00-guide/"><h3>Compiler guide</h3><p>29 reference chapters covering syntax, refinements, effects, memory layout, safety profiles, and CLI tooling.</p><span class="reading-arrow" aria-hidden="true">↗</span></a><a href="/packages/stdlib/"><h3>Standard library</h3><p>288 standard library modules with Hoogle-style type-signature search, documented from checked compiler interfaces.</p><span class="reading-arrow" aria-hidden="true">↗</span></a></div>
        
      </section>
      <section class="closing"><a href={tutorial}><h2>Write your<br /><span>first program.</span></h2><span class="closing-arrow" aria-hidden="true">↗<span class="closing-orbit"><i></i></span></span></a></section>
    </main>
    <footer class="landing-footer"><Brand /><div><a href="/documentation/">Documentation</a><a href="/packages/">Packages</a><a href="/downloads/">Downloads</a><a href={project.repository}>GitHub ↗</a><a href="#main">Back to top ↑</a></div></footer>
    <PremiumPagePreview />
    <FreePagePreview />
    <FeedbackToolbar />
  </body>
</html>
