---
import Brand from '../components/Brand.astro';
import HeroHeadline from '../components/HeroHeadline.astro';
import ContractConsole from '../components/ContractConsole.astro';
import AverageFigure from '../components/AverageFigure.astro';
import averageSource from '../data/examples/average-report.cinch?raw';
import RunnableSource from '../components/RunnableSource.astro';
import CompilerPrintout from '../components/CompilerPrintout.astro';
import AgentLoop from '../components/AgentLoop.astro';
import FeedbackToolbar from '../components/FeedbackToolbar.astro';
import uncheckedSource from '../data/examples/average-unchecked.cinch?raw';
import LanguageTour from '../components/LanguageTour.astro';
import LiveEvolution from '../components/LiveEvolution.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import { project } from '../lib/project';
import PremiumPagePreview from '../components/PremiumPagePreview.astro';
import FreePagePreview from '../components/FreePagePreview.astro';
import '../styles/custom.css';
import '../styles/landing.css';
const tutorial = '/learn/01-first-program/';
// Why an agent does better in Cinch. Each claim is backed by the compiler or the design documents linked.
const agentReasons = [
  { title: 'Errors that name the fix', text: 'A rejected build pinpoints the exact missing fact and lists the concrete ways to supply it. An agent reads one diagnostic and makes one targeted edit instead of guessing from a production stack trace.', href: '/reference/06-refinements/', link: 'Refinements and obligations' },
  { title: 'Tighten invariants step by step', text: 'Start with plain lists, records, and <code>Option</code>. When a rule matters, add a refinement like <code>NonEmpty</code> or <code>InRange</code> to one signature and let the compiler walk the agent through every caller that needs to uphold it.', href: '/learn/13-refinements-and-safe-operations/', link: 'Refine values step by step' },
  { title: 'No escape hatches to fake', text: 'A small, independent kernel re-checks everything the automation derives, and no annotation switches a check off. An agent cannot bluff past the compiler, so a green build means the contract actually holds.', href: '/reference/08-dependent-types-and-proofs/', link: 'Dependent types and checks' },
  { title: 'Contracts without the bodies', text: 'Every module compiles to a <code>.cinchif</code> interface carrying its types, effect rows, refinements, safety assertions, and upgrade rows. Agents read the whole contract without burning context on thousands of lines of implementation.', href: '/reference/18-artifacts-and-incremental/', link: 'Compiled interfaces' },
  { title: 'Auditable effect boundaries', text: 'Generated code can perform only the effects its arrow lists and only with capabilities passed in scope. A function without <code>IO</code> cannot open a file or a socket, so review starts and often ends at the signature.', href: '/learn/10-effects-and-io/', link: 'Effects and capabilities' },
  { title: 'Fast on the first pass', text: 'Strict evaluation, precise reference counting with reuse, erased runtime checks, target-checked SIMD, and LLVM codegen mean the first correct version an agent writes is already native-speed code with no rewrite.', href: '/learn/19-rewrites-and-performance/', link: 'Laws, rewrites, and performance' },
];
// What each remedy in the compiler's message means for this code (all three are checked examples).
const printoutLegend = [
  { title: 'Decide at the edge', text: 'Check the runtime value once and keep the evidence. <code>report</code> calls <code>non-empty</code>, which yields <code>None</code> for an empty list.' },
  { title: 'Branch on structure', text: 'Pattern match on the list. Inside the <code>Cons</code> branch, the compiler already knows it has at least one element.' },
  { title: 'Push it to the caller', text: 'Take <code>NonEmpty Int</code> in <code>report</code>’s own signature and let its caller decide what no orders means.' },
];
const features = [
  { n: '01', title: 'Effects and capabilities', text: 'An effect row on the arrow (<code>-&gt;{IO r}</code>) declares what a function may do; a lexical capability (<code>using (io :: Io r)</code>) grants the authority to do it. Pure code carries neither, higher-order functions propagate callback effects automatically, and testing or tracing is swapping a capability.', href: '/learn/10-effects-and-io/', link: 'Tutorial 10: Effects and capabilities' },
  { n: '02', title: 'Linear ownership and regions', text: 'Usage annotations enforce resource protocols directly in the type: linear (<code>%1</code>) values must be used exactly once so a handle, permit, or lock cannot be forgotten or released twice, and affine (<code>%aff</code>) values can be used at most once without copying. Lexical regions (<code>Ref</code>, <code>Mut</code>) check borrows statically with no tracing garbage collector.', href: '/learn/12-ownership-and-regions/', link: 'Tutorial 12: Ownership, borrowing, and regions' },
  { n: '03', title: 'Structured concurrency and STM', text: 'Every task belongs to a lexical scope and returns a linear handle that must be joined before the scope exits, so handlers cannot leak background work. Cancellation is cooperative, bounded channels transfer ownership with backpressure, and STM handles composable shared state.', href: '/learn/17-structured-concurrency/', link: 'Tutorial 17: Structured tasks and cancellation' },
  { n: '04', title: 'Temporal contracts and safety profiles', text: 'State safety and liveness invariants (<code>always</code>, <code>stable</code>, <code>eventually</code>, <code>recur</code>) directly on your services so specifications never drift from production code. Enforce flight-software rules at compile time with <code>#[no-alloc]</code>, <code>#[stack "constant"]</code>, and <code>#[profile "jpl"]</code>, hashed into module interfaces.', href: '/learn/21-upgrades-and-contracts/', link: 'Tutorial 21: State evolution and temporal contracts' },
  { n: '05', title: 'Zero-libc static binaries', text: 'Cinch talks directly to the kernel through its own syscall layer, so static binaries carry no <code>glibc</code> or C runtime dependency and drop straight into scratch containers. When you call existing C or C++ libraries, <code>foreign import</code> puts ABI, ownership, and failure boundaries in one auditable place.', href: '/reference/15-ffi-layout-and-attributes/', link: 'FFI, syscalls, and layouts' },
  { n: '06', title: 'WebAssembly and WASI components', text: 'Compile directly to core Wasm modules, WASI component-model (WIT) interfaces, and browser adapters. Capabilities map cleanly onto Wasm imports, contracts are checked at component edges, and untrusted foreign libraries run inside a sandbox where a trap becomes a typed failure.', href: '/reference/19-targets-and-components/', link: 'Targets, SIMD, and Wasm components' },
  { n: '07', title: 'GPU and data-parallel kernels', text: 'Pure, effect-free <code>Array</code> and <code>Tensor</code> computations carry statically known shapes, verified bounds, and zero aliasing races. Data-parallel pipelines fuse and compile straight to GPU and accelerator kernels while the same type system checks the host-to-device boundary.', href: '/library/Data.Tensor/', link: 'Tensors and data-parallel arrays' },
  { n: '08', title: 'Productive streams and explicit laziness', text: 'Evaluation is strict by default so long-running servers never build silent thunk leaks. When you want delayed work or infinite feeds like log lines and market ticks, choose one-shot suspended computations (affine thunks), block-scoped memo cells, or guarded streams checked to produce every next element without hanging.', href: '/learn/15-streams-and-producers/', link: 'Tutorial 15: Productive streams and partial producers' },
];
---
<!doctype html>
<html lang="en" class="cinch-landing" data-theme="dark">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <title>Cinch — Bulletproof code.</title>
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <meta name="description" content="Bulletproof code. Cinch is a strict, GC-free functional language where well-typed programs do not crash, invariants grow incrementally beside your code, and one compiler targets zero-libc static binaries, WebAssembly, and GPU kernels." />
    <meta name="theme-color" content="#191a17" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/momo-trust-display.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-400.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="landing-skip" href="#main">Skip to content</a>
    <header class="landing-header">
      <div class="header-identity"><Brand /></div>
      <SiteNavigation />
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
                <div class="hero-grid">
          <div class="hero-copy">
            <div class="hero-runhead"><div class="hero-stripes" aria-hidden="true"><span></span><span></span><span></span></div><p class="mono">Software from the future we were promised</p></div>
            <HeroHeadline />
            <p class="hero-description">A strict, GC-free functional language for software that refuses to crash.</p>
            <p class="hero-detail">Start with ordinary functional code and tighten your guarantees as invariants matter. Partial operations, unchecked bounds, and silent runtime traps are gone; anything that can fail shows up in the type. Compiles directly to zero-libc static binaries, WebAssembly components, and GPU kernels.</p>
            <div class="hero-actions"><a class="button button-primary" href="/downloads/">Get Cinch <span>↗</span></a><a class="text-link" href={tutorial}>Write your first program <span>→</span></a></div>
            <p class="hero-note">Static binaries for Linux and macOS with no libc dependency. The tutorial assumes no Haskell or type theory.</p>
          </div>
          <ContractConsole />
        </div>
        <div class="hero-baseline mono"><a href="#why-cinch">INSIDE THE LANGUAGE <span>↓</span></a></div>
      </section>
      <section class="manifesto light-section" id="why-cinch" aria-labelledby="manifesto-title">
        <div class="manifesto-grid"><h2 id="manifesto-title">One language.<br /><span>All the way down.</span></h2><div class="manifesto-copy"><p>Most teams split their work across worlds that drift apart: a formal spec or model checker on one side, a fast systems language on the other, and fragile glue holding production together.</p><p>Cinch puts them under one roof. Unifying memory safety, effect tracking, live upgrades, and formal guarantees makes the language richer than a minimalist one, so it is built to scale in layers: start with plain lists, records, and <code>Option</code>, then reach for zero-cost refinements, linear resources, and temporal contracts only where an invariant earns its keep.</p><p>Evaluation is strict and memory is managed by compiler-inserted reference counting with in-place reuse, so there is no tracing garbage collector. Because the compiler knows which bounds hold, which regions are pure, and which allocations never escape, it strips runtime checks away and compiles straight to zero-libc static binaries, WebAssembly, and GPU kernels.</p><a class="text-link" href="/reference/04-types-and-kinds/">Types, kinds, and refinements <span>↗</span></a></div></div>
        <nav class="language-jump" aria-label="Explore language features"><a href="#agents">For language models ↓</a><a href="#proofs">Incremental guarantees ↓</a><a href="#specialization">Layouts and speed ↓</a><a href="#staging">Typed staging ↓</a><a href="#optimization">Verified optimization ↓</a><a href="#live-development">Fast builds and hot reload ↓</a><a href="#runtime-contracts">Systems and targets ↓</a></nav>
      </section>
      <div class="panel-joint" aria-hidden="true"><span></span><i></i><span></span></div>
      <section class="proof-section" id="average" aria-labelledby="proof-title">
        <div class="proof-grid">
          <div class="proof-copy"><h2 id="proof-title">Crashing code<br /><em>never ships.</em></h2><p>Every codebase has a function like this: average order value, mean latency, failure rate of last night’s batch. It passes every test with fixture data. Then a new customer with zero orders opens the dashboard and it divides by zero.</p><p class="muted">Cinch separates typed failures (<code>Option</code>, <code>Result</code>, resource limits) from faults, and removes faulting operations from the language. Division requires a <code>NonZero</code> divisor. <code>average</code> asks for a <code>NonEmpty</code> list, whose length cannot be zero, so the division inside needs no runtime check and no crash path exists. Code holding an ordinary list has to decide once what an empty history means.</p><a class="text-link" href="/learn/13-refinements-and-safe-operations/">Refinements and safe operations <span>↗</span></a></div>
          <RunnableSource file="average-report.cinch" source={averageSource}><div class="code-note"><span class="proof-check">↳</span><p><strong>Pass an ordinary list</strong><br /><code>report orders = average orders</code> is missing the <code>NotNull</code> fact, so the build stops.</p><button type="button" class="gadget-key" data-print aria-pressed="false">Check it <span aria-hidden="true">▸</span></button></div><CompilerPrintout file="average-unchecked.cinch" source={uncheckedSource} legend={printoutLegend} /></RunnableSource>
        </div>
        <AverageFigure id="landing-average-figure" />
      </section>
      <section class="agents-section language-section" id="agents" aria-labelledby="agents-title">
        <div class="tour-heading"><h2 id="agents-title">Your LLM’s new<br />favorite language.</h2><p>Coding agents work in a loop: write code, run the compiler, read the diagnostic, fix the gap. In an unsound language, models learn to silence the checker with casts and escape hatches. Cinch turns every turn of that loop into real verification, so code that passes the build satisfies its contract.</p></div>
        <AgentLoop />
        <div class="agent-reasons">{agentReasons.map(r => <article><h3>{r.title}</h3><p set:html={r.text} /><a class="text-link" href={r.href}>{r.link} <span>↗</span></a></article>)}</div>
      </section>
      <LanguageTour />
      <LiveEvolution />
      <section class="feature-section light-section" id="runtime-contracts" aria-labelledby="features-title">
        <h2 id="features-title">Built for real systems,<br />from bare metal to GPUs.</h2>
        <div class="feature-list">{features.map((feature, i) => <article class="feature-row"><span class="feature-number mono" aria-hidden="true" style={`--filled:${i + 1};--total:${features.length}`}>{feature.n}</span><div><h3>{feature.title}</h3></div><div><p set:html={feature.text} /><a class="text-link" href={feature.href}>{feature.link}<span>↗</span></a></div></article>)}</div>
      </section>
      <section class="reading-section" aria-labelledby="reading-title">
        <div class="reading-heading"><h2 id="reading-title">Learn the<br />language.</h2><p>One idea per chapter, each with worked code and exercises. Written for working programmers, with no Haskell or type-theory background assumed.</p></div>
        <div class="reading-links"><a href={tutorial}><h3>Tutorials</h3><p>22 chapters, from your first static binary to refinements, structured concurrency, and live upgrades.</p><span class="reading-arrow" aria-hidden="true">↗</span></a><a href="/reference/00-guide/"><h3>Compiler guide</h3><p>29 reference chapters covering syntax, refinements, effects, memory layout, safety profiles, and CLI tooling.</p><span class="reading-arrow" aria-hidden="true">↗</span></a><a href="/library/00-index/"><h3>Library reference</h3><p>288 standard library modules with Hoogle-style type-signature search, extracted from checked compiler interfaces.</p><span class="reading-arrow" aria-hidden="true">↗</span></a></div>
        
      </section>
      <section class="closing"><a href={tutorial}><h2>Write your<br /><span>first program.</span></h2><span class="closing-arrow" aria-hidden="true">↗<span class="closing-orbit"><i></i></span></span></a></section>
    </main>
    <footer class="landing-footer"><Brand /><div><a href="/documentation/">Documentation</a><a href="/packages/">Packages</a><a href="/downloads/">Downloads</a><a href={project.repository}>GitHub ↗</a><a href="#main">Back to top ↑</a></div></footer>
    <PremiumPagePreview />
    <FreePagePreview />
    <FeedbackToolbar />
  </body>
</html>
