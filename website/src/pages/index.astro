---
import Brand from '../components/Brand.astro';
import HeroHeadline from '../components/HeroHeadline.astro';
import ContractConsole from '../components/ContractConsole.astro';
import AverageFigure from '../components/AverageFigure.astro';
import averageSource from '../data/examples/average-report.cinch?raw';
import RunnableSource from '../components/RunnableSource.astro';
import CompilerPrintout from '../components/CompilerPrintout.astro';
import AgentLoop from '../components/AgentLoop.astro';
import FeedbackToolbar from '../components/FeedbackToolbar.astro';
import uncheckedSource from '../data/examples/average-unchecked.cinch?raw';
import LanguageTour from '../components/LanguageTour.astro';
import LiveEvolution from '../components/LiveEvolution.astro';
import SiteNavigation from '../components/SiteNavigation.astro';
import { project } from '../lib/project';
import PremiumPagePreview from '../components/PremiumPagePreview.astro';
import FreePagePreview from '../components/FreePagePreview.astro';
import '../styles/custom.css';
import '../styles/landing.css';
const tutorial = '/learn/01-first-program/';
// Why an agent does better in Cinch. Each claim is backed by the compiler or the design documents linked.
const agentReasons = [
  { title: 'Errors that name the fix', text: 'A rejected build names the missing fact and lists the ways to supply it. An agent reads one error and makes one edit instead of guessing from a stack trace.', href: '/reference/06-refinements/', link: 'Refinements and obligations' },
  { title: 'Tighten invariants step by step', text: 'Start with plain lists, records, and <code>Option</code>. When a rule matters, put <code>NonEmpty</code> or <code>InRange</code> on one signature and let the compiler point the agent to every caller that breaks.', href: '/learn/13-refinements-and-safe-operations/', link: 'Refine values step by step' },
  { title: 'No escape hatches to fake', text: 'A small standalone kernel re-checks everything the automation derives, and no pragma turns a check off. An agent cannot bluff past the build.', href: '/reference/08-dependent-types-and-proofs/', link: 'Dependent types and checks' },
  { title: 'Contracts without the bodies', text: 'Every module emits a <code>.cinchif</code> file with its types, effects, refinements, safety rules, and upgrade contracts. An agent can read the interface without loading thousands of lines of implementation into context.', href: '/reference/18-artifacts-and-incremental/', link: 'Compiled interfaces' },
  { title: 'Auditable effect boundaries', text: 'Code can only run the effects listed on its arrow, using capabilities passed into scope. A function without <code>IO</code> cannot touch the disk or network, so code review often starts and ends at the signature.', href: '/learn/10-effects-and-io/', link: 'Effects and capabilities' },
  { title: 'Fast on the first pass', text: 'Strict evaluation, reference counting with reuse, erased checks, SIMD, and LLVM codegen mean the first working version an agent produces is already native speed.', href: '/learn/19-rewrites-and-performance/', link: 'Laws, rewrites, and performance' },
];
// What each remedy in the compiler's message means for this code (all three are checked examples).
const printoutLegend = [
  { title: 'Decide at the edge', text: 'Check the runtime value once and keep the evidence. <code>report</code> calls <code>non-empty</code>, which yields <code>None</code> for an empty list.' },
  { title: 'Branch on structure', text: 'Pattern match on the list. Inside the <code>Cons</code> branch, the compiler already knows it has at least one element.' },
  { title: 'Push it to the caller', text: 'Take <code>NonEmpty Int</code> in <code>report</code>’s own signature and let its caller decide what no orders means.' },
];
const features = [
  { n: '01', title: 'Effects and capabilities', text: 'An effect row on the arrow (<code>-&gt;{IO r}</code>) says what a function can do; a lexical capability (<code>using (io :: Io r)</code>) grants permission to do it. Pure code carries neither, higher-order functions propagate callback effects automatically, and testing or tracing is just swapping a capability.', href: '/learn/10-effects-and-io/', link: 'Tutorial 10: Effects and capabilities' },
  { n: '02', title: 'Linear ownership and regions', text: 'Usage annotations put resource protocols right in the type: linear (<code>%1</code>) values must be used once so handles and locks cannot leak or double-close, and affine (<code>%aff</code>) values can be used at most once without copying. Lexical regions (<code>Ref</code>, <code>Mut</code>) check borrows at compile time with no GC.', href: '/learn/12-ownership-and-regions/', link: 'Tutorial 12: Ownership, borrowing, and regions' },
  { n: '03', title: 'Structured concurrency and STM', text: 'Every task lives inside a lexical scope and returns a linear handle you have to join before leaving, so background work cannot leak. Cancellation is cooperative, bounded channels move ownership with backpressure, and STM handles shared state.', href: '/learn/17-structured-concurrency/', link: 'Tutorial 17: Structured tasks and cancellation' },
  { n: '04', title: 'Temporal contracts and safety profiles', text: 'Write safety and liveness properties (<code>always</code>, <code>stable</code>, <code>eventually</code>, <code>recur</code>) right on your services so specs stay next to the code. Enforce flight-software rules at compile time with <code>#[no-alloc]</code>, <code>#[stack "constant"]</code>, and <code>#[profile "jpl"]</code>, hashed into the module interface.', href: '/learn/21-upgrades-and-contracts/', link: 'Tutorial 21: State evolution and temporal contracts' },
  { n: '05', title: 'Zero-libc static binaries', text: 'Cinch talks straight to the kernel through its own syscall layer, so static binaries need no <code>glibc</code> or C runtime and drop right into scratch containers. When you do call C libraries, <code>foreign import</code> puts the ABI, ownership, and failure boundary in one place.', href: '/reference/15-ffi-layout-and-attributes/', link: 'FFI, syscalls, and layouts' },
  { n: '06', title: 'Incremental adoption and C++ bindgen', text: 'You do not have to rewrite a codebase to try Cinch. One <code>foreign export ccall</code> line and <code>cinch build --shared</code> emits a self-contained C library callable from C, Rust, Go, or Python, with no GC fighting the host. For C++17, <code>cinch cxx</code> generates bidirectional bindings, C++ classes with constructors and destructors, and Godot GDExtensions from explicit <code>.abi.json</code> contracts.', href: '/reference/15-ffi-layout-and-attributes/#linking-native-objects-libraries-and-c', link: 'Foreign exports, shared libraries, and C++' },
  { n: '07', title: 'WebAssembly, WASI, and browser UIs', text: 'Compile to small, GC-free Wasm modules, WASI components (WIT), and browser adapters. Together with hygienic TSX-style macros, Cinch works in the browser too, sharing domain types across server and client while sandboxing untrusted native code.', href: '/reference/19-targets-and-components/', link: 'Targets, SIMD, and Wasm components' },
  { n: '08', title: 'GPU and data-parallel kernels', text: 'Pure <code>Array</code> and <code>Tensor</code> code carries static shapes, checked bounds, and no aliasing races. Data-parallel pipelines fuse and compile to GPU kernels while the same type system checks the host-to-device boundary.', href: '/packages/stdlib/Data.Tensor/', link: 'Tensors and data-parallel arrays' },
  { n: '09', title: 'Productive streams and explicit laziness', text: 'Evaluation is strict by default, so long-running servers do not build up silent thunk leaks. When you actually want deferred work or infinite streams like log feeds and market ticks, opt in with one-shot affine thunks, scoped memo cells, or guarded streams checked not to hang.', href: '/learn/15-streams-and-producers/', link: 'Tutorial 15: Productive streams and partial producers' },
  { n: '10', title: 'Ergonomic syntax and explicit instances', text: 'Small daily details matter: <code>kebab-case</code> identifiers save your Shift key, <code>?</code> and <code>!</code> mark predicates (<code>empty?</code>) and effectful functions (<code>print!</code>), and <code>[...]</code> and <code>{ k =&gt; v }</code> literals overload through <code>FromList</code> and <code>FromMap</code>. Named explicit <code>instance</code> declarations live alongside <code>implicit instance</code> resolution, so you do not get stuck on orphan-instance conflicts when a type needs more than one policy.', href: '/learn/09-signatures-and-instances/', link: 'Tutorial 09: Signatures and instances' },
];
---
<!doctype html>
<html lang="en" class="cinch-landing" data-theme="dark">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <title>Cinch — Bulletproof code.</title>
    <link rel="canonical" href={new URL('/', Astro.site)} />
    <meta name="description" content="Cinch is a strict, GC-free functional language where well-typed code cannot crash. Start with plain types, tighten invariants where they matter, and compile to static binaries, C/C++ libraries, WebAssembly, or GPU kernels." />
    <meta name="theme-color" content="#191a17" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/momo-trust-display.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/dm-sans-400.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body>
    <a class="landing-skip" href="#main">Skip to content</a>
    <header class="landing-header">
      <div class="header-identity"><Brand /></div>
      <SiteNavigation />
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
                <div class="hero-grid">
          <div class="hero-copy">
            <div class="hero-runhead"><div class="hero-stripes" aria-hidden="true"><span></span><span></span><span></span></div><p class="mono">Software from the future we were promised</p></div>
            <HeroHeadline />
            <p class="hero-description">A strict, GC-free functional language for code that doesn’t crash.</p>
            <p class="hero-detail">Write normal functional code, then add stronger guarantees where you actually want them. There is no null, no silent out-of-bounds read, and no divide-by-zero trap: anything that can fail has to appear in the type. One compiler emits zero-libc static binaries, C/C++ libraries, WebAssembly, and GPU kernels.</p>
            <div class="hero-actions"><a class="button button-primary" href="/downloads/">Get Cinch <span>↗</span></a><a class="text-link" href={tutorial}>Write your first program <span>→</span></a></div>
            <p class="hero-note">Static binaries for Linux and macOS with no libc dependency. The tutorial assumes no Haskell or type theory.</p>
          </div>
          <ContractConsole />
        </div>
        <div class="hero-baseline mono"><a href="#why-cinch">INSIDE THE LANGUAGE <span>↓</span></a></div>
      </section>
      <section class="manifesto light-section" id="why-cinch" aria-labelledby="manifesto-title">
        <div class="manifesto-grid"><h2 id="manifesto-title">One language.<br /><span>All the way down.</span></h2><div class="manifesto-copy"><p>Most projects keep their specs in one tool, their fast code in another, and hope the two still match six months later.</p><p>Cinch does more than a minimalist language because it tries to solve memory safety, effect tracking, live upgrades, and formal checking in one place. You do not have to take all of it on day one. Write plain lists, records, and <code>Option</code> until a function actually needs refinements or linear ownership. You can also drop Cinch into an existing C, Rust, or C++ codebase one module at a time through C shared libraries or generated C++17 bindings.</p><p>Evaluation is strict and memory runs on compiler-inserted reference counting with in-place reuse, with no tracing GC. Because the compiler already knows which bounds hold, which regions are pure, and which values never escape, it drops the runtime checks and emits tight native code.</p><a class="text-link" href="/reference/04-types-and-kinds/">Types, kinds, and refinements <span>↗</span></a></div></div>
        <nav class="language-jump" aria-label="Explore language features"><a href="#agents">For language models ↓</a><a href="#proofs">Incremental guarantees ↓</a><a href="#specialization">Layouts and speed ↓</a><a href="#staging">Hygienic macros ↓</a><a href="#optimization">Verified optimization ↓</a><a href="#live-development">Fast builds and hot reload ↓</a><a href="#runtime-contracts">Systems and targets ↓</a></nav>
      </section>
      <div class="panel-joint" aria-hidden="true"><span></span><i></i><span></span></div>
      <section class="proof-section" id="average" aria-labelledby="proof-title">
        <div class="proof-grid">
          <div class="proof-copy"><h2 id="proof-title">Crashing code<br /><em>never ships.</em></h2><p>Every codebase has a function like this: average order value, mean latency, failure rate of last night’s batch. It passes every test with fixture data. Then a new customer with zero orders opens the dashboard and it divides by zero.</p><p class="muted">Cinch removes faulting operations from the language and turns expected failures into ordinary values (<code>Option</code>, <code>Result</code>). Division takes a <code>NonZero</code> divisor. <code>average</code> takes a <code>NonEmpty</code> list, whose length cannot be zero, so the division compiles with no runtime check and no crash path. Any caller holding a plain list has to handle the empty case once.</p><a class="text-link" href="/learn/13-refinements-and-safe-operations/">Refinements and safe operations <span>↗</span></a></div>
          <RunnableSource file="average-report.cinch" source={averageSource}><div class="code-note"><span class="proof-check">↳</span><p><strong>Pass an ordinary list</strong><br /><code>report orders = average orders</code> is missing the <code>NotNull</code> fact, so the build stops.</p><button type="button" class="gadget-key" data-print aria-pressed="false">Check it <span aria-hidden="true">▸</span></button></div><CompilerPrintout file="average-unchecked.cinch" source={uncheckedSource} legend={printoutLegend} /></RunnableSource>
        </div>
        <AverageFigure id="landing-average-figure" />
      </section>
      <section class="agents-section language-section" id="agents" aria-labelledby="agents-title">
        <div class="tour-heading"><h2 id="agents-title">Your LLM’s new<br />favorite language.</h2><p>Coding agents work in a loop: edit, compile, read the error, repeat. In an unsound language, a model can shut the checker up with a cast or an escape hatch. Cinch gives it nowhere to hide, so a passing build means the code actually matches its type.</p></div>
        <AgentLoop />
        <div class="agent-reasons">{agentReasons.map(r => <article><h3>{r.title}</h3><p set:html={r.text} /><a class="text-link" href={r.href}>{r.link} <span>↗</span></a></article>)}</div>
      </section>
      <LanguageTour />
      <LiveEvolution />
      <section class="feature-section light-section" id="runtime-contracts" aria-labelledby="features-title">
        <h2 id="features-title">Systems features,<br />built in.</h2>
        <div class="feature-list">{features.map((feature, i) => <article class="feature-row"><span class="feature-number mono" aria-hidden="true" style={`--filled:${i + 1};--total:${features.length}`}>{feature.n}</span><div><h3>{feature.title}</h3></div><div><p set:html={feature.text} /><a class="text-link" href={feature.href}>{feature.link}<span>↗</span></a></div></article>)}</div>
      </section>
      <section class="reading-section" aria-labelledby="reading-title">
        <div class="reading-heading"><h2 id="reading-title">Learn the<br />language.</h2><p>One idea per chapter, with worked code and exercises. Written for working programmers, with no Haskell or type-theory background assumed. Syntax and details are still moving while the language settles.</p></div>
        <div class="reading-links"><a href={tutorial}><h3>Tutorials</h3><p>22 chapters, from your first static binary to refinements, structured concurrency, and live upgrades.</p><span class="reading-arrow" aria-hidden="true">↗</span></a><a href="/reference/00-guide/"><h3>Compiler guide</h3><p>29 reference chapters covering syntax, refinements, effects, memory layout, safety profiles, and CLI tooling.</p><span class="reading-arrow" aria-hidden="true">↗</span></a><a href="/packages/stdlib/"><h3>Standard library</h3><p>288 standard library modules with Hoogle-style type-signature search, documented from checked compiler interfaces.</p><span class="reading-arrow" aria-hidden="true">↗</span></a></div>
        
      </section>
      <section class="closing"><a href={tutorial}><h2>Write your<br /><span>first program.</span></h2><span class="closing-arrow" aria-hidden="true">↗<span class="closing-orbit"><i></i></span></span></a></section>
    </main>
    <footer class="landing-footer"><Brand /><div><a href="/documentation/">Documentation</a><a href="/packages/">Packages</a><a href="/downloads/">Downloads</a><a href={project.repository}>GitHub ↗</a><a href="#main">Back to top ↑</a></div></footer>
    <PremiumPagePreview />
    <FreePagePreview />
    <FeedbackToolbar />
  </body>
</html>
