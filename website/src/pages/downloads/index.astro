---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import {project} from '../../lib/project';
import {targets,releases,artifacts} from '../../lib/downloads';
const selected=artifacts[0];
const clientArtifacts=artifacts.map(({bytes,...a})=>a);
// One entry per system, then the architectures that system ships. Both lists are
// derived from `targets`, so adding a target makes its picker options appear.
const systems=[...new Map(targets.map(t=>[t.os,t.name])).entries()].map(([id,name])=>({id,name}));
const architectures=[...new Map(targets.map(t=>[t.arch,t.architecture])).entries()].map(([id,label])=>({id,label}));
const available=Object.fromEntries(systems.map(s=>[s.id,targets.filter(t=>t.os===s.id).map(t=>t.arch)]));
const verifyCommands=[
 {os:'macos',label:'macOS',command:'shasum -a 256'},
 {os:'linux',label:'Linux',command:'sha256sum'},
 {os:'windows',label:'Windows',command:'certutil -hashfile'},
];
---
<PlatformLayout title="Downloads" description="Choose a Cinch toolchain build, inspect release details, or get the source." section="downloads">
  <section class="platform-banner downloads-banner"><h1>Get Cinch.</h1></section>
  <section class="platform-content downloads-content">
    <div class="download-controls"><div><span class="section-rule mono">01 / RELEASE CHANNEL</span><div class="release-switch" role="group" aria-label="Release channel">{releases.map((r,i)=><button type="button" data-channel={r.id} aria-pressed={i===0}>{r.name}</button>)}</div></div></div>
    <div class="download-pickers">
      <fieldset class="platform-choices" data-os-fieldset><legend class="section-rule mono">02 / SYSTEM</legend><div>{systems.map((s,i)=><label class="platform-choice"><input type="radio" name="os" value={s.id} checked={i===0}/><span class="platform-symbol" aria-hidden="true">{s.name[0]}</span><span><strong>{s.name}</strong></span><i aria-hidden="true"></i></label>)}</div></fieldset>
      <fieldset class="platform-choices" data-arch-fieldset><legend class="section-rule mono">03 / ARCHITECTURE</legend><div>{architectures.map(a=><label class="platform-choice" data-arch-choice={a.id}><input type="radio" name="arch" value={a.id}/><span><strong>{a.label}</strong></span><i aria-hidden="true"></i></label>)}</div></fieldset>
    </div>
    <div class="download-body">
      <article class="download-plate"><div class="download-plate-top mono"><span data-release-name>{selected.release.name} release</span><span>SAMPLE BUNDLE</span></div><h2 data-release-version>{selected.release.version}</h2><p class="download-platform" data-platform-name>{selected.target.name} · {selected.target.architecture}</p><div class="download-file"><span class="mono">ARCHIVE</span><code data-filename>{selected.filename}</code></div><a class="download-button" data-download href={selected.url} download={selected.filename}>Download sample bundle <span aria-hidden="true">↓</span></a></article>
      <aside class="download-verification"><div class="section-rule mono">04 / VERIFY THE FILE</div><h2>Check the checksum.</h2><p>The hash below belongs to the selected sample archive. A different file produces a different hash.</p><label class="mono" for="archive-hash">SHA-256</label><textarea id="archive-hash" readonly rows="3">{selected.sha256}</textarea><div class="checksum-actions"><button type="button" data-copy-checksum>Copy checksum</button><a data-checksum href={`${selected.url}.sha256`}>Checksum file ↗</a></div><div class="verify-commands"><span class="mono">COMPARE IT YOURSELF</span>{verifyCommands.map(v=><div class="verify-command" data-verify-os={v.os}><span class="mono">{v.label}</span><code data-verify-command={v.os}>{v.command} {selected.filename}</code></div>)}</div><span class="copy-status mono" aria-live="polite" data-copy-status></span></aside>
    </div>
    <section class="source-build" id="source"><div class="section-rule mono">05 / SOURCE CODE</div><div><h2>Build from source.</h2><div><p>The project repository contains the compiler, runtime, base library, examples, and language design documents.</p><p>The toolchain needs Rust, Cargo, and Clang. The ladder builds the compiler in Cinch stages, each stage compiling the next.</p><div class="source-actions"><a href={project.sourceArchive}>Download source archive ↗</a><a href={project.repository}>Open GitHub ↗</a><a href={project.releases}>GitHub releases ↗</a></div></div></div><pre><code>{`git clone https://github.com/iand675/cinch.git
cd cinch
tooling/bootstrap.sh build --stage 0   # fixed Rust seed
tooling/bootstrap.sh build --stage 1   # Cinch compiler built by stage 0
tooling/bootstrap.sh build --stage 2   # the same sources built by stage 1
tooling/bootstrap.sh check             # stage 3, fixed point and changed-source probe
tooling/bootstrap.sh status`}</code></pre><p class="source-note">Stage 2 is the current boundary: a refusal there is a recorded bootstrap blocker, so <code>check</code> does not yet reach stage 3. <code>status</code> reports how far the ladder gets on the tree you cloned.</p></section>
  </section>
</PlatformLayout>
<script is:inline define:vars={{artifacts:clientArtifacts,available,verifyCommands}}>
(()=>{
 const params=new URL(location.href).searchParams;
 const find=id=>artifacts.find(a=>a.target.id===id);
 let channel=['preview','nightly'].includes(params.get('channel'))?params.get('channel'):'preview';
 let target=find(params.get('platform'))?params.get('platform'):artifacts[0].target.id;
 let selected;
 const text=(selector,value)=>{const el=document.querySelector(selector);if(el)el.textContent=value;};
 const split=id=>{const found=find(id);return found?{os:found.target.os,arch:found.target.arch}:{os:'macos',arch:'arm64'};};
 function archChoices(os){
   document.querySelectorAll('[data-arch-choice]').forEach(label=>{
     const offered=available[os].includes(label.dataset.archChoice);
     const input=label.querySelector('input');
     label.hidden=!offered;input.disabled=!offered;
   });
 }
 function update(){
   const pair=split(target);
   archChoices(pair.os);
   selected=artifacts.find(a=>a.release.id===channel&&a.target.id===target);
   document.querySelectorAll('[data-channel]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.channel===channel)));
   document.querySelectorAll('input[name="os"]').forEach(r=>r.checked=r.value===pair.os);
   document.querySelectorAll('input[name="arch"]').forEach(r=>r.checked=r.value===pair.arch);
   text('[data-release-name]',`${selected.release.name} release`);
   text('[data-release-version]',selected.release.version);
   text('[data-platform-name]',`${selected.target.name} · ${selected.target.architecture}`);
   text('[data-filename]',selected.filename);
   document.querySelectorAll('[data-verify-command]').forEach(code=>{
     const spec=verifyCommands.find(v=>v.os===code.dataset.verifyCommand);
     code.textContent=`${spec.command} ${selected.filename}`;
   });
   document.querySelectorAll('[data-verify-os]').forEach(row=>{
     row.hidden=row.dataset.verifyOs!==pair.os;
   });
   const link=document.querySelector('[data-download]');link.href=selected.url;link.download=selected.filename;
   document.querySelector('[data-checksum]').href=`${selected.url}.sha256`;
   document.querySelector('#archive-hash').value=selected.sha256;
   text('[data-copy-status]','');
   const url=new URL(location.href);url.searchParams.set('channel',channel);url.searchParams.set('platform',target);
   history.replaceState(null,'',url);
 }
 const idFor=(os,arch)=>{
   const exact=artifacts.find(a=>a.target.os===os&&a.target.arch===arch);
   const first=artifacts.find(a=>a.target.os===os);
   return (exact||first).target.id;
 };
 document.querySelectorAll('[data-channel]').forEach(b=>b.addEventListener('click',()=>{channel=b.dataset.channel;update();}));
 document.querySelectorAll('input[name="os"]').forEach(r=>r.addEventListener('change',()=>{
   const pair=split(target);
   const wants=available[r.value].includes(pair.arch)?pair.arch:available[r.value][0];
   target=idFor(r.value,wants);update();
 }));
 document.querySelectorAll('input[name="arch"]').forEach(r=>r.addEventListener('change',()=>{target=idFor(split(target).os,r.value);update();}));
 document.querySelector('[data-copy-checksum]').addEventListener('click',async()=>{try{await navigator.clipboard.writeText(selected.sha256);text('[data-copy-status]','Copied.');}catch{document.querySelector('#archive-hash').select();text('[data-copy-status]','Select and copy the checksum.');}});
 window.addEventListener('popstate',()=>{
   const query=new URL(location.href).searchParams;
   channel=['preview','nightly'].includes(query.get('channel'))?query.get('channel'):'preview';
   target=find(query.get('platform'))?query.get('platform'):artifacts[0].target.id;
   update();
 });
 update();
})();
</script>
