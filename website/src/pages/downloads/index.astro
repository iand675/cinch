---
import PlatformLayout from '../../layouts/PlatformLayout.astro';
import {project} from '../../lib/project';
import {loadNightly, targets} from '../../lib/downloads';
let nightly = null;
try { nightly = await loadNightly(); }
catch (error) { console.warn('[downloads] Could not refresh nightlies:', String(error)); }
const selected = nightly?.artifacts[0];
---
<PlatformLayout title="Downloads" description="Download the latest checked Cinch nightly compiler for Linux or macOS, with checksums and source." section="downloads" sample={false}>
  <section class="platform-banner downloads-banner"><h1>Get Cinch.</h1></section>
  <section class="platform-content downloads-content" data-nightly-downloads>
    <div class="download-controls"><div><span class="section-rule mono">01 / NIGHTLY BUILDS</span><p>Native compiler builds from the latest successful nightly release.</p><p>Linux x86-64, Linux ARM64, and Apple Silicon macOS.</p></div><a href={project.releases}>All releases ↗</a></div>
    <p role="status" aria-live="polite" data-release-status>{nightly ? `Published ${new Date(nightly.publishedAt).toLocaleDateString('en-GB', {timeZone: 'UTC'})}. Checking for newer builds…` : 'Checking for the latest nightly release…'}</p>
    <fieldset class="platform-choices"><legend class="section-rule mono">02 / YOUR SYSTEM</legend><div>{targets.map((target, index) => <label class="platform-choice"><input type="radio" name="platform" value={target.id} checked={index === 0}/><span class="platform-symbol" aria-hidden="true">{target.name[0]}</span><span><strong>{target.name}</strong><small>{target.architecture}</small></span><i aria-hidden="true"></i></label>)}</div></fieldset>
    <div class="download-body" data-release-body hidden={!nightly}>
      <article class="download-plate">
        <div class="download-plate-top mono"><span>Nightly compiler</span><span>NATIVE BINARY</span></div>
        <h2 data-release-version>{nightly?.tag}</h2>
        <p class="download-platform" data-platform-name>{selected ? `${selected.target.name} · ${selected.target.architecture}` : ''}</p>
        <div class="download-file"><span class="mono">EXECUTABLE</span><code data-filename>{selected?.filename}</code><p data-file-size>{selected ? `${(selected.size / 1024 / 1024).toFixed(1)} MiB` : ''}</p></div>
        <a class="download-button" data-download href={selected?.url}>Download compiler <span aria-hidden="true">↓</span></a>
        <p class="nightly-details"><a data-release-link href={nightly?.url}>Release notes ↗</a> · <a data-revision-link href={nightly ? `${project.repository}/commit/${nightly.revision}` : undefined}>Source <span data-revision>{nightly?.revision.slice(0, 12)}</span> ↗</a></p>
      </article>
      <aside class="download-verification">
        <div class="section-rule mono">03 / VERIFY THE FILE</div><h2>Check the checksum.</h2><p>The hash belongs to the selected compiler binary. Verify it before running the compiler.</p>
        <label class="mono" for="archive-hash">SHA-256</label><textarea id="archive-hash" readonly rows="3">{selected?.sha256}</textarea>
        <div class="checksum-actions"><button type="button" data-copy-checksum>Copy checksum</button><a data-checksum href={selected?.checksumUrl}>Checksum file ↗</a></div>
        <div class="verify-commands"><span class="mono">COMPARE IT YOURSELF</span><code data-verify-command>{selected ? `shasum -a 256 -c ${selected.filename}.sha256` : ''}</code></div><span class="copy-status mono" aria-live="polite" data-copy-status></span>
      </aside>
    </div>
    <noscript><p>Enable JavaScript to check for newer nightlies, or <a href={project.releases}>browse releases on GitHub</a>.</p></noscript>
    <section class="source-build" id="install"><div class="section-rule mono">04 / RUN THE COMPILER</div><div><h2>Use a nightly.</h2><div><p>Download the executable for your system, verify its checksum, and make it executable. The compiler runs directly on your machine.</p><p>These development builds contain the checked Stage 3 compiler. Linux binaries are statically linked; macOS binaries use system libraries. Linking generated programs also needs Clang 20.</p></div></div><pre><code data-install-command>{selected ? `chmod +x ${selected.filename}
./${selected.filename} --check Main.cinch check
./${selected.filename} --emit-ir-only Main.cinch program.ll` : `chmod +x cinch-SYSTEM
./cinch-SYSTEM --check Main.cinch check`}</code></pre><p>A named refusal writes <code>check.diagnostics</code>. Release notes and build metadata identify the exact source revision.</p></section>
    <section class="source-build" id="source"><div class="section-rule mono">05 / SOURCE CODE</div><div><h2>Build from source.</h2><div><p>The repository contains the compiler, runtime, base library, examples, and language documentation.</p><p>The bootstrap checks the fixed point, stage smokes, interface consumption, and changed-source behavior before a nightly release is published.</p><div class="source-actions"><a href={project.sourceArchive}>Download source archive ↗</a><a href={project.repository}>Open GitHub ↗</a><a href={project.releases}>GitHub releases ↗</a></div></div></div><pre><code>{`git clone https://github.com/iand675/cinch.git
cd cinch
tooling/bootstrap.sh check`}</code></pre></section>
  </section>
  <script type="application/json" id="nightly-snapshot" set:html={JSON.stringify(nightly).replace(/</g, '\\u003c')} />
</PlatformLayout>
<script>
import {loadNightly, targets, type NightlyRelease} from '../../lib/downloads';
import {project} from '../../lib/project';
const root = document.querySelector<HTMLElement>('[data-nightly-downloads]')!;
let release: NightlyRelease | null = JSON.parse(document.querySelector('#nightly-snapshot')!.textContent!);
const params = new URL(location.href).searchParams;
let target = targets.find(value => value.id === params.get('platform'))?.id ?? targets[0].id;
const field = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
const text = (selector: string, value: string) => { field(selector).textContent = value; };
function update() {
  root.querySelectorAll<HTMLInputElement>('input[name="platform"]').forEach(input => { input.checked = input.value === target; });
  field<HTMLElement>('[data-release-body]').hidden = !release;
  if (!release) return;
  const selected = release.artifacts.find(value => value.target.id === target)!;
  text('[data-release-version]', release.tag);
  text('[data-platform-name]', `${selected.target.name} · ${selected.target.architecture}`);
  text('[data-filename]', selected.filename);
  text('[data-file-size]', `${(selected.size / 1024 / 1024).toFixed(1)} MiB`);
  field<HTMLAnchorElement>('[data-download]').href = selected.url;
  field<HTMLAnchorElement>('[data-checksum]').href = selected.checksumUrl;
  field<HTMLTextAreaElement>('#archive-hash').value = selected.sha256;
  field<HTMLAnchorElement>('[data-release-link]').href = release.url;
  field<HTMLAnchorElement>('[data-revision-link]').href = `${project.repository}/commit/${release.revision}`;
  text('[data-revision]', release.revision.slice(0, 12));
  text('[data-verify-command]', `${selected.target.os === 'macos' ? 'shasum -a 256' : 'sha256sum'} -c ${selected.filename}.sha256`);
  text('[data-install-command]', `chmod +x ${selected.filename}\n./${selected.filename} --check Main.cinch check\n./${selected.filename} --emit-ir-only Main.cinch program.ll`);
  text('[data-copy-status]', '');
}
root.querySelectorAll<HTMLInputElement>('input[name="platform"]').forEach(input => input.addEventListener('change', () => {
  target = targets.find(value => value.id === input.value)!.id;
  const url = new URL(location.href); url.searchParams.set('platform', target); history.replaceState(null, '', url);
  update();
}));
field<HTMLButtonElement>('[data-copy-checksum]').addEventListener('click', async () => {
  try { await navigator.clipboard.writeText(field<HTMLTextAreaElement>('#archive-hash').value); text('[data-copy-status]', 'Copied.'); }
  catch { field<HTMLTextAreaElement>('#archive-hash').select(); text('[data-copy-status]', 'Select and copy the checksum.'); }
});
update();
async function refresh() {
try {
  const current = await loadNightly();
  if (current) release = current;
  update();
  text('[data-release-status]', release
    ? `Published ${new Date(release.publishedAt).toLocaleString('en-GB', {timeZone: 'UTC'})} UTC.`
    : 'No successful nightly has been published yet. Browse the source below or check GitHub releases.');
} catch {
  text('[data-release-status]', release
    ? 'Showing the release recorded when this page was built. GitHub could not be refreshed; check All releases for newer builds.'
    : 'GitHub releases are temporarily unavailable. Use All releases to check for a nightly, or build from source below.');
}
}
void refresh();
</script>
<style>
  [data-release-body][hidden] { display: none; }
  .download-controls p { margin: .6rem 0; max-width: 45rem; }
  [data-release-status] { color: var(--platform-muted); margin-bottom: 2rem; }
  .download-plate h2 { font-size: clamp(1.6rem, 2.7vw, 2.8rem); }
  .nightly-details { font-size: .8rem; line-height: 1.8; overflow-wrap: anywhere; margin-top: 1.5rem; }
  .verify-commands code { display: block; overflow-wrap: anywhere; margin-top: .8rem; }
</style>
