+  -- | Adjust both links in one pinned dense array, destructuring each transferred node once.
+  -- The caller keeps this storage stable until the loop finishes; no callback
+  -- or arena transfer occurs inside this private traversal.
+  offset-links :: forall a. Array (RingNode a) -> U64 -> U64 -> U64 -> Unit
+  offset-links nodes offset index count = if eq-u64 index count then () else
+    case slots-read nodes index of
+      Node value links ->
+        let shifted = offset-pair (slots-read links 0) (slots-read links 1) offset in
+        let previous = wrapping-u128-to-u64 shifted in
+        let following = wrapping-u128-to-u64 (wrapping-shr-u128 shifted 64) in
+        let left = slots-write links 0 previous in
+        let right = slots-write links 1 following in
+        offset-links nodes offset (successor index) count
 
