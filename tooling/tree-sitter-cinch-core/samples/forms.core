-- A hand written Core file covering every form the grammar accepts. The
-- printer's golden files live in compiler/tests/core/; this sample exists
-- so the whole file parse check has a Core input before those land.
unit Main.map :: forall a b. (a->b)->List a->List b @borrowed(1,2)
  @span Main.cinch:20:3
  @specialised(<Nat, Int>) from List.map
  @params f :: a->b @borrowed, xs :: List a @borrowed
  body
    (case (local xs)
      (((Nil) (global Nil))
       ((Cons (h) (t))
        (app (global Cons)
          (app (local f) (local h))
          (app (global Main.map) (local f) (local t))))))
end

unit $d.Ord.Nat :: Ord Nat @immortal
