  @captures(env)
  @tailrec
  body
    (let n :: Nat @owned
      (int 1)
      (release n (moved) (rest)
        (let slot :: Nat @lent
          (boxget (local n))
          (app (if (bool true)
                 (boxinit cell (int 2))
                 (boxclear cell))
               (quote 1 (splice 2))
               (syntaxlit 3)
               (demand (foreign "cinch_now"))
               (prim i64.add)
               (ctor Cons 0 2)
               (proj (local n) field)
               (refset cell (nat "18446744073709551616"))
               (bytes "\x00\xff" 2)
               (string "tab\there" 8)
               (sym 'sym+name')
               (unit)))))
end

