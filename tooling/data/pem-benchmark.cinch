-- | Public PEM pipelines with bounded machine iteration/checksum loops and observable results.
module Main where
  import Text.Pem
  import Data.Bytes
  import Data.Bool
  import Data.Char
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String
  import Effect.Clock
  import Effect.Process
  import Effect.Stream

  -- | Prepare two live source variants outside the measured interval.
  data Inputs where
    -- | Immutable blocks and corresponding mutable encoded inputs retained across the timed loop.
    Prepared :: PemBlock -> PemBlock -> Bytes -> Bytes -> Inputs

  -- | Advance a bounded iteration without natural-remainder or optional arithmetic allocation.
  prim bump :: U32 -> U32 where
    llvm { %next = add i32 %0, 1
      ret i32 %next
    }

  -- | Compare bounded iteration counters directly.
  prim before :: U32 -> U32 -> Bool where
    llvm { %yes = icmp ult i32 %0, %1
      %result = zext i1 %yes to i8
      ret i8 %result
    }

  -- | Alternate two prepared sources without introducing a checked-remainder result.
  prim phase :: U32 -> Bool where
    llvm { %bit = and i32 %0, 1
      %yes = icmp eq i32 %bit, 0
      %result = zext i1 %yes to i8
      ret i8 %result
    }

  -- | Accumulate a complete wraparound checksum of observable operation results.
  prim mix :: U64 -> U64 -> U64 where
    llvm { %a = xor i64 %0, %1
      %b = mul i64 %a, 1099511628211
      ret i64 %b
    }

  -- | Count immutable header observations with a machine accumulator.
  prim plus :: U64 -> U64 -> U64 where
    llvm { %result = add i64 %0, %1
      ret i64 %result
    }

  -- | Observe a bounded natural result without signed truncation.
  word :: Nat -> U64
  word value = if value <= 9223372036854775807 then let raw = nat-to-i64 value in wrapping-i64-to-u64 raw else 0

  -- | Observe a complete unsigned checksum for decimal reporting.
  natural :: U64 -> Nat
  natural value = let low = wrapping-u64-to-u32 value in let shifted = wrapping-shr-u64 value 32 in
    let high = wrapping-u64-to-u32 shifted in u32-to-nat low + u32-to-nat high * 4294967296

  -- | Parse validated nonnegative harness metadata outside the measured interval.
  decimal :: List Char -> Nat -> Nat
  decimal chars value = case chars of Nil -> value; Cons char rest -> case digit-value char of None -> 0; Some digit -> decimal rest (value * 10 + digit)

  -- | Sample only present bytes and keep allocation length plus label/body positions observable.
  sample :: Bytes -> Nat -> Nat
  sample bytes at = if at < bytes-len bytes then bytes-get bytes at else 0

  -- | Fingerprint public byte results without a second full traversal that would obscure codec work.
  fingerprint :: Bytes -> U64
  fingerprint bytes = let size = bytes-len bytes in
    word (size + sample bytes 0 + sample bytes 11 + sample bytes (nat-div size 2) + sample bytes (saturating-sub size 1))

  -- | Observe logical metadata size without cloning immutable header keys.
  count-headers :: List PemHeader -> U64 -> U64
  count-headers headers count = case headers of Nil -> count; Cons header rest -> let next = plus count 1 in count-headers rest next

  -- | Observe all decoded field classes through the ordinary fresh mutable byte getters.
  decoded :: Bytes -> U64
  decoded input = case pem-decode input of
    (None, rest) -> plus 4294967296 (fingerprint rest)
    (Some block, rest) ->
      let payload = fingerprint (pem-block-bytes block) in let label = fingerprint (pem-block-type block) in
      let headers = count-headers (pem-block-headers block) 0 in
      let a = plus payload label in let b = plus a headers in plus b (fingerprint rest)

  -- | Select a prepared immutable source without reconstructing or copying it in the timed loop.
  selected-block :: Inputs -> Bool -> PemBlock
  selected-block inputs first = case inputs of Prepared a b x y -> if first then a else b

  -- | Select the matching encoded owner for a decoded or allocation-control operation.
  selected-input :: Inputs -> Bool -> Bytes
  selected-input inputs first = case inputs of Prepared a b x y -> if first then x else y

  -- | Measure the public fresh-memory encoder, retaining every output's observable allocation.
  encode-loop :: Inputs -> U32 -> U32 -> U64 -> U64
  encode-loop inputs count index hash = if before index count then
    let first = phase index in let block = selected-block inputs first in
    let value = case pem-encode-bytes block of Err error -> 4294967295; Ok output -> fingerprint output in
    let next = bump index in let result = mix hash value in encode-loop inputs count next result
    else hash

  -- | Measure full public parsing and owned field observations on live prepared sources.
  decode-loop :: Inputs -> U32 -> U32 -> U64 -> U64
  decode-loop inputs count index hash = if before index count then
    let first = phase index in let source = selected-input inputs first in let value = decoded source in
    let next = bump index in let result = mix hash value in decode-loop inputs count next result
    else hash

  -- | Measure an unrelated fresh allocation/copy pipeline over the same encoded owners.
  copy-loop :: Inputs -> U32 -> U32 -> U64 -> U64
  copy-loop inputs count index hash = if before index count then
    let first = phase index in let source = selected-input inputs first in let output = bytes-new (bytes-len source) in
    let copied = bytes-copy-range output source 0 0 (bytes-len source) in let value = fingerprint output in
    let next = bump index in let result = mix hash value in copy-loop inputs count next result
    else hash

  -- | Measure the public writer to an inspectable memory sink, preserving exact output allocation.
  writer-loop :: forall r. using (io :: Io r) => Inputs -> U32 -> U32 -> U64 ->{IO r} U64
  writer-loop inputs count index hash = if before index count then
    let first = phase index in let block = selected-block inputs first in
    case pem-write writer-buffer block of
      (Err error, next) -> let following = bump index in let result = mix hash 4294967295 in writer-loop inputs count following result
      (Ok unit, next) -> let value = case writer-bytes next of None -> 4294967295; Some output -> fingerprint output in
        let following = bump index in let result = mix hash value in writer-loop inputs count following result
    else hash

  -- | Fill deterministic arbitrary payload bytes; setup and its natural arithmetic are outside timing.
  fill :: Bytes -> Nat -> Unit
  fill out at = if at < bytes-len out then
    let value = nat-rem (at * 73 + 19) 256 in
    if value <= 255 then let changed = bytes-set out at value in fill out (at + 1) else ()
    else ()

  -- | Make many distinct named headers outside the operation loop.
  headers :: Nat -> List PemHeader -> List PemHeader
  headers count result = if count > 0 then
    let next = count - 1 in let name = string-to-bytes (string-concat "k" (nat-to-string next)) in
    headers next (Cons (pem-header name name) result)
    else result

  -- | Snapshot a short binary join outside timing, including malformed-candidate recovery prefixes.
  join :: Bytes -> Bytes -> Bytes
  join a b = let out = bytes-new (bytes-len a + bytes-len b) in
    let x = bytes-copy-range out a 0 0 (bytes-len a) in let y = bytes-copy-range out b (bytes-len a) 0 (bytes-len b) in out

  -- | Prepare normal, adversarial-dash or newline preambles without changing envelope bytes.
  preamble :: Nat -> Nat -> Bytes
  preamble size pattern = let char = if pattern == 0 then "p" else if pattern == 1 then "-" else "\n" in
    string-to-bytes (string-concat (string-repeat size char) "\n")

  -- | Add the selected decoding scenario while retaining matching public source variants.
  scenario :: String -> Nat -> Nat -> Bytes -> Bytes
  scenario mode size pattern encoded = if mode == "preamble" then join (preamble size pattern) encoded
    else if mode == "recovery" then join (string-to-bytes "-----BEGIN BAD-----\n?\n-----END BAD-----\n") (join (preamble size pattern) encoded)
    else encoded

  -- | Prepare immutable blocks and encoded inputs before the clock starts.
  prepare :: String -> Nat -> Nat -> Inputs
  prepare mode size pattern = let payload = bytes-new size in let filled = fill payload 0 in
    let metadata = if pattern == 0 then Nil else if pattern == 1 then [pem-header (string-to-bytes "Z") (string-to-bytes "last"),pem-header (string-to-bytes "A") (string-to-bytes "first"),pem-header (string-to-bytes "Proc-Type") (string-to-bytes "4,ENCRYPTED"),pem-header (string-to-bytes "DEK-Info") (string-to-bytes "NONE")] else headers 256 Nil in
    let a = pem-block (string-to-bytes "DATA") metadata payload in let b = pem-block (string-to-bytes "EATA") metadata payload in
    let x = case pem-encode-bytes a of Err error -> bytes-new 0; Ok output -> scenario mode size pattern output in
    let y = case pem-encode-bytes b of Err error -> bytes-new 0; Ok output -> scenario mode size pattern output in Prepared a b x y

  -- | Choose one concrete operation loop before evaluating any timed iteration.
  perform :: forall r. using (io :: Io r) => String -> Inputs -> U32 ->{IO r} U64
  perform mode inputs count = if mode == "encode" then encode-loop inputs count 0 14695981039346656037
    else if mode == "writer" then writer-loop inputs count 0 14695981039346656037
    else if mode == "copy" then copy-loop inputs count 0 14695981039346656037
    else decode-loop inputs count 0 14695981039346656037

  -- | Dispatch once outside each bounded machine loop and report elapsed nanoseconds plus checksum.
  measure :: forall r. using (io :: Io r) => String -> Nat -> Nat -> Nat ->{IO r} Int
  measure mode size iterations pattern = if iterations <= 4294967295 then
    let inputs = prepare mode size pattern in let count = wrapping-i64-to-u32 (nat-to-i64 iterations) in
    let start = clock-monotonic-ns () in
    let hash = perform mode inputs count in
    let end = clock-monotonic-ns () in let elapsed = saturating-sub end start in
    let printed = ioWrite (string-to-bytes (string-concat (nat-to-string elapsed) (string-concat " " (string-concat (nat-to-string (natural hash)) "\n")))) in 0
    else 2

  -- | Read validated operation, payload size, bounded iteration count and metadata/preamble pattern.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in case process-args () of
    Err error -> 2
    Ok args -> case args of
      Cons mode (Cons size (Cons iterations (Cons pattern Nil))) -> measure mode (decimal (unpack size) 0) (decimal (unpack iterations) 0) (decimal (unpack pattern) 0)
      other -> 2
