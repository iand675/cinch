-- | Public scalar Unicode pipelines with bounded machine counters and observable wraparound checksums.
module Main where
  import Data.Unicode
  import Data.Bool
  import Data.Char
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String
  import Effect.Clock
  import Effect.Process

  -- | Parse validated decimal harness arguments outside the operation timer.
  decimal :: String -> Nat
  decimal text = decimal-from (unpack text) 0

  -- | Accumulate only ASCII argument digits; malformed harness input maps to zero.
  decimal-from :: List Char -> Nat -> Nat
  decimal-from chars value = case chars of Nil -> value; Cons cp rest -> case digit-value cp of None -> 0; Some digit -> decimal-from rest (value * 10 + digit)

  -- | Advance one bounded machine iteration without allocation or imported arithmetic calls.
  prim bump :: U32 -> U32 where
    llvm {
      %next = add i32 %0, 1
      ret i32 %next
    }

  -- | Test the bounded machine iteration domain directly.
  prim before :: U32 -> U32 -> Bool where
    llvm {
      %yes = icmp ult i32 %0, %1
      %result = zext i1 %yes to i8
      ret i8 %result
    }

  -- | Select one of sixteen stable numeric input/partner observations.
  prim phase :: U32 -> U32 where
    llvm {
      %result = and i32 %0, 15
      ret i32 %result
    }

  -- | Include valid and invalid numeric case selectors without modulo or optional arithmetic.
  prim selector :: U32 -> I32 where
    llvm {
      %result = and i32 %0, 3
      ret i32 %result
    }

  -- | Observe the complete two's-complement word of a signed public result.
  prim as-word :: I32 -> U32 where
    llvm {
      ret i32 %0
    }

  -- | Combine independent boolean result bits without a provider call.
  prim or-word :: U32 -> U32 -> U32 where
    llvm {
      %result = or i32 %0, %1
      ret i32 %result
    }

  -- | Retain every result word through deterministic unsigned wraparound arithmetic.
  prim mix :: U64 -> U32 -> U64 where
    llvm {
      %wide = zext i32 %1 to i64
      %changed = xor i64 %0, %wide
      %result = mul i64 %changed, 1099511628211
      ret i64 %result
    }

  -- | Select one boolean observation bit without allocating an optional value.
  flag :: Bool -> U32 -> U32
  flag value mask = if value then mask else 0

  -- | Convert the final unsigned checksum once, after timing, without signed truncation.
  word-natural :: U64 -> Nat
  word-natural word = u32-to-nat (wrapping-u64-to-u32 word) + u32-to-nat (wrapping-u64-to-u32 (wrapping-shr-u64 word 32)) * 4294967296

  -- | Read one immutable bounded sample without constructing a runtime list.
  sample :: U32 -> U32 -> I32
  sample pattern index = case pattern of
    0 -> sample-a index
    1 -> sample-b index
    2 -> sample-c index
    3 -> sample-d index
    other -> 0

  -- | One complete shallow sample page for numeric pattern 0.
  sample-a :: U32 -> I32
  sample-a index = case index of
    0 -> 0
    1 -> 9
    2 -> 32
    3 -> 48
    4 -> 65
    5 -> 73
    6 -> 75
    7 -> 90
    8 -> 97
    9 -> 105
    10 -> 107
    11 -> 122
    12 -> 127
    13 -> 64
    14 -> 33
    15 -> 95
    other -> 0

