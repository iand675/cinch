  -- | Observe all named scalar predicates together, including numeric scalar-domain policy.
  classification :: I32 -> U32
  classification cp =
    let yes-a = unicode-is-control-code cp in let bit-a = flag yes-a 1 in
    let flags-a = bit-a in
    let yes-b = unicode-is-digit-code cp in let bit-b = flag yes-b 2 in
    let flags-b = or-word flags-a bit-b in
    let yes-c = unicode-is-letter-code cp in let bit-c = flag yes-c 4 in
    let flags-c = or-word flags-b bit-c in
    let yes-d = unicode-is-lower-code cp in let bit-d = flag yes-d 8 in
    let flags-d = or-word flags-c bit-d in
    let yes-e = unicode-is-upper-code cp in let bit-e = flag yes-e 16 in
    let flags-e = or-word flags-d bit-e in
    let yes-f = unicode-is-title-code cp in let bit-f = flag yes-f 32 in
    let flags-f = or-word flags-e bit-f in
    let yes-g = unicode-is-mark-code cp in let bit-g = flag yes-g 64 in
    let flags-g = or-word flags-f bit-g in
    let yes-h = unicode-is-number-code cp in let bit-h = flag yes-h 128 in
    let flags-h = or-word flags-g bit-h in
    let yes-i = unicode-is-punct-code cp in let bit-i = flag yes-i 256 in
    let flags-i = or-word flags-h bit-i in
    let yes-j = unicode-is-symbol-code cp in let bit-j = flag yes-j 512 in
    let flags-j = or-word flags-i bit-j in
    let yes-k = unicode-is-graphic-code cp in let bit-k = flag yes-k 1024 in
    let flags-k = or-word flags-j bit-k in
    let yes-l = unicode-is-print-code cp in let bit-l = flag yes-l 2048 in
    let flags-l = or-word flags-k bit-l in
    let yes-m = unicode-is-space-code cp in let bit-m = flag yes-m 4096 in
    let flags-m = or-word flags-l bit-m in
    let yes-n = unicode-is-scalar-code cp in let bit-n = flag yes-n 8192 in
    let flags-n = or-word flags-m bit-n in
    flags-n

  -- | Resolve rotating exact public catalog keys, including unknown names, during the operation.
  catalog :: U32 -> I32 -> U32
  catalog index cp = let selected = selector index in let found = catalog-lookup selected index in
    case found of None -> 0; Some table -> let yes = unicode-range-contains-code table cp in if yes then 3 else 1

  -- | Dispatch catalog setup with direct machine scalar cases rather than imported comparisons.
  catalog-lookup :: I32 -> U32 -> Option UnicodeRangeTable
  catalog-lookup selected index = case selected of
    0 -> unicode-category (if before index 8 then "L" else "NoSuchCategory")
    1 -> unicode-script (if before index 8 then "Greek" else "Adlam")
    2 -> unicode-property (if before index 8 then "White_Space" else "Noncharacter_Code_Point")
    other -> unicode-fold-category (if before index 8 then "Ll" else "NoSuchFold")

  -- | Observe exact returned case-range fields, retaining the public indexed API's allocations.
  case-observation :: U32 -> U64 -> U64
  case-observation index checksum = case unicode-case-range-at (u32-to-nat index) of
    None -> mix checksum 4294967295
    Some value -> let a = mix checksum (unicode-case-range-low value) in
      let b = mix a (unicode-case-range-high value) in
      let upper = as-word (unicode-case-range-upper value) in let c = mix b upper in
      let lower = as-word (unicode-case-range-lower value) in let d = mix c lower in
      let title = as-word (unicode-case-range-title value) in mix d title

  -- | Execute public predicates, mappings, fold equivalence, table queries or copied observations.
  operation :: U32 -> UnicodeRangeTable -> List UnicodeRangeTable -> UnicodeSpecialCase -> U32 -> I32 -> I32 -> U64 -> U64
  operation mode table tables special index cp other checksum = case mode of
    0 -> let yes = unicode-is-letter-code cp in let word = flag yes 1 in mix checksum word
    1 -> let yes = unicode-is-space-code cp in let word = flag yes 1 in mix checksum word
    2 -> let word = classification cp in mix checksum word
    3 ->
      let upper = as-word (unicode-to-upper-code cp) in let a = mix checksum upper in
      let lower = as-word (unicode-to-lower-code cp) in let b = mix a lower in
      let title = as-word (unicode-to-title-code cp) in let c = mix b title in
      let selected = selector index in let generic = as-word (unicode-to-code selected cp) in mix c generic
    4 -> let folded = as-word (unicode-simple-fold-code cp) in
      let a = mix checksum folded in let same = unicode-equal-fold-code cp other in let word = flag same 1 in mix a word
    5 -> let yes = unicode-range-contains-code table cp in let word = flag yes 1 in mix checksum word
    6 -> let yes = unicode-range-contains-code table cp in let word = flag yes 1 in mix checksum word
    7 -> let yes = unicode-range-contains-code table cp in let word = flag yes 1 in mix checksum word
    8 -> let yes = unicode-range-contains-code table cp in let word = flag yes 1 in mix checksum word
    9 -> let yes = unicode-range-contains-code table cp in let word = flag yes 1 in mix checksum word
    10 -> let a = unicode-in-code cp tables in let b = unicode-is-one-of-code tables cp in
      let first = flag a 1 in let second = flag b 2 in let word = or-word first second in mix checksum word
    11 -> let word = catalog index cp in mix checksum word
    12 -> special-operation special cp checksum
    13 -> special-operation special cp checksum
    14 -> case-observation index checksum
    other -> let word = as-word cp in mix checksum word

  -- | Observe all three public special-case mappings with the same bounded checksum protocol.
  special-operation :: UnicodeSpecialCase -> I32 -> U64 -> U64
  special-operation special cp checksum = let upper = as-word (unicode-special-to-upper-code special cp) in
    let a = mix checksum upper in let lower = as-word (unicode-special-to-lower-code special cp) in
    let b = mix a lower in let title = as-word (unicode-special-to-title-code special cp) in mix b title

  -- | Dispatch once per sample, keeping unrelated workload branches outside each scalar loop.
  repeat :: U32 -> U32 -> UnicodeRangeTable -> List UnicodeRangeTable -> UnicodeSpecialCase -> U32 -> U32 -> U64 -> U64
  repeat mode pattern table tables special iterations index checksum = case mode of
    0 -> repeat-a pattern table tables special iterations index checksum
    1 -> repeat-b pattern table tables special iterations index checksum
    2 -> repeat-c pattern table tables special iterations index checksum
    3 -> repeat-d pattern table tables special iterations index checksum
    4 -> repeat-e pattern table tables special iterations index checksum
    5 -> repeat-f pattern table tables special iterations index checksum
    6 -> repeat-g pattern table tables special iterations index checksum
    7 -> repeat-h pattern table tables special iterations index checksum
    8 -> repeat-i pattern table tables special iterations index checksum
    9 -> repeat-j pattern table tables special iterations index checksum
    10 -> repeat-k pattern table tables special iterations index checksum
    11 -> repeat-l pattern table tables special iterations index checksum
    12 -> repeat-m pattern table tables special iterations index checksum
    13 -> repeat-n pattern table tables special iterations index checksum
    14 -> repeat-o pattern table tables special iterations index checksum
    15 -> repeat-p pattern table tables special iterations index checksum
    other -> checksum

  -- | Run only public workload 0 with bounded machine state and no inner workload dispatch.
  repeat-a :: U32 -> UnicodeRangeTable -> List UnicodeRangeTable -> UnicodeSpecialCase -> U32 -> U32 -> U64 -> U64
  repeat-a pattern table tables special iterations index checksum = if before index iterations then
    let at = phase index in let cp = sample pattern at in let other = partner pattern at in
    let next = operation 0 table tables special at cp other checksum in let following = bump index in
    repeat-a pattern table tables special iterations following next
    else checksum

  -- | Run only public workload 1 with bounded machine state and no inner workload dispatch.
  repeat-b :: U32 -> UnicodeRangeTable -> List UnicodeRangeTable -> UnicodeSpecialCase -> U32 -> U32 -> U64 -> U64
  repeat-b pattern table tables special iterations index checksum = if before index iterations then
    let at = phase index in let cp = sample pattern at in let other = partner pattern at in
    let next = operation 1 table tables special at cp other checksum in let following = bump index in
    repeat-b pattern table tables special iterations following next
    else checksum

  -- | Run only public workload 2 with bounded machine state and no inner workload dispatch.
  repeat-c :: U32 -> UnicodeRangeTable -> List UnicodeRangeTable -> UnicodeSpecialCase -> U32 -> U32 -> U64 -> U64
  repeat-c pattern table tables special iterations index checksum = if before index iterations then
    let at = phase index in let cp = sample pattern at in let other = partner pattern at in
    let next = operation 2 table tables special at cp other checksum in let following = bump index in
    repeat-c pattern table tables special iterations following next
    else checksum

  -- | Run only public workload 3 with bounded machine state and no inner workload dispatch.
  repeat-d :: U32 -> UnicodeRangeTable -> List UnicodeRangeTable -> UnicodeSpecialCase -> U32 -> U32 -> U64 -> U64
  repeat-d pattern table tables special iterations index checksum = if before index iterations then
    let at = phase index in let cp = sample pattern at in let other = partner pattern at in
    let next = operation 3 table tables special at cp other checksum in let following = bump index in
    repeat-d pattern table tables special iterations following next
    else checksum

  -- | Run only public workload 4 with bounded machine state and no inner workload dispatch.
  repeat-e :: U32 -> UnicodeRangeTable -> List UnicodeRangeTable -> UnicodeSpecialCase -> U32 -> U32 -> U64 -> U64
  repeat-e pattern table tables special iterations index checksum = if before index iterations then
    let at = phase index in let cp = sample pattern at in let other = partner pattern at in
