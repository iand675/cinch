  -- | Select the checked public workload before entering the timer.
  mode-code :: String -> U32
  mode-code name =
    if name == "letter" then 0
    else if name == "space" then 1
    else if name == "classify" then 2
    else if name == "case" then 3
    else if name == "fold" then 4
    else if name == "table-letter" then 5
    else if name == "table-surrogates" then 6
    else if name == "table-greek" then 7
    else if name == "table-space" then 8
    else if name == "table-custom" then 9
    else if name == "table-union" then 10
    else if name == "catalog" then 11
    else if name == "special-turkish" then 12
    else if name == "special-custom" then 13
    else if name == "case-observe" then 14
    else if name == "harness" then 15
    else 99

  -- | Select immutable built-ins or a validated synthetic table outside the timer.
  choose-table :: U32 -> Option UnicodeRangeTable
  choose-table mode = if eq-u32 mode 6 then unicode-category "Cs" else if eq-u32 mode 7 then unicode-script "Greek"
    else if eq-u32 mode 8 then unicode-property "White_Space"
    else if eq-u32 mode 9 then (case unicode-range-table [MkUnicodeRange16 65 90 2, MkUnicodeRange16 931 963 16, MkUnicodeRange16 55296 57343 257] [MkUnicodeRange32 65536 1114111 17] of Err error -> None; Ok table -> Some table)
    else unicode-category "L"

  -- | Build an explicit identity override, Latin mapping, alternating pair and supplementary rule.
  custom-special :: Unit -> Result UnicodeCaseError UnicodeSpecialCase
  custom-special unit = unicode-special-case [MkUnicodeCaseRange 65 90 0 0 0, MkUnicodeCaseRange 233 233 (-145) (-145) (-145), MkUnicodeCaseRange 256 257 1114112 1114112 1114112, MkUnicodeCaseRange 66600 66639 (-40) 0 (-40)]

  -- | Time only public operations and allocation-free machine loop/checksum bookkeeping.
  measure :: forall r. using (io :: Io r) => U32 -> U32 -> U32 -> UnicodeRangeTable -> List UnicodeRangeTable -> UnicodeSpecialCase ->{IO r} Int
  measure mode pattern iterations table tables special =
    let start = clock-monotonic-ns () in let checksum = repeat mode pattern table tables special iterations 0 14695981039346656037 in let end = clock-monotonic-ns () in
    let elapsed = saturating-sub end start in let result = word-natural checksum in
    let printed = ioWrite (string-to-bytes (string-concat (nat-to-string elapsed) (string-concat " " (string-concat (nat-to-string result) "\n")))) in 0

  -- | Resolve all table/name/rule setup before the monotonic operation timer.
  prepare :: forall r. using (io :: Io r) => U32 -> U32 -> U32 ->{IO r} Int
  prepare mode pattern iterations = case choose-table mode of
    None -> 3
    Some table -> case unicode-property "White_Space" of
      None -> 3
      Some white -> case custom-special () of
        Err error -> 3
        Ok custom -> let tables = [table, white] in let special = if eq-u32 mode 13 then custom else unicode-turkish-case in
          measure mode pattern iterations table tables special

  -- | Validate bounded host inputs before constructing public library contexts.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in case process-args () of
    Err error -> 2
    Ok args -> case args of
      Cons name (Cons pattern (Cons iterations Nil)) -> let mode = mode-code name in
        let p = decimal pattern in let n = decimal iterations in
        if before mode 16 && p <= 3 && n <= 10000000 then
          let raw-pattern = wrapping-i64-to-u32 (nat-to-i64 p) in let raw-count = wrapping-i64-to-u32 (nat-to-i64 n) in
          prepare mode raw-pattern raw-count
        else 2
      other -> 2
