    else checksum

  -- | Run only public workload 5 with bounded machine state and no inner workload dispatch.
  repeat-f :: U32 -> UnicodeRangeTable -> List UnicodeRangeTable -> UnicodeSpecialCase -> U32 -> U32 -> U64 -> U64
  repeat-f pattern table tables special iterations index checksum = if before index iterations then
    let at = phase index in let cp = sample pattern at in let other = partner pattern at in
