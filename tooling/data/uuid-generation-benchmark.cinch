-- | Real secure entropy and clock/state generation pipelines with bounded observation loops.
module Main where
  import Data.Core
  import Data.Nat
  import Data.Machine
  import Data.Bytes
  import Data.String
  import Data.Char
  import Data.Uuid
  import Effect.Uuid
  import Effect.Clock
  import Effect.Process

  -- | Advance bounded loop metadata without natural counter allocation.
  prim bump :: U32 -> U32 where
    llvm { %next = add i32 %0, 1
      ret i32 %next
    }

  -- | Compare bounded loop counters directly.
  prim before :: U32 -> U32 -> Bool where
    llvm { %yes = icmp ult i32 %0, %1
      %result = zext i1 %yes to i8
      ret i8 %result
    }

  -- | Accumulate only the checked result invariant, never a predicted random payload.
  prim add :: U64 -> U64 -> U64 where
    llvm { %result = add i64 %0, %1
      ret i64 %result
    }

  -- | Retain a full variable random-output fingerprint separately from the invariant count.
  prim mix :: U64 -> U64 -> U64 where
    llvm { %a = xor i64 %0, %1
      %result = mul i64 %a, 1099511628211
      ret i64 %result
    }

  -- | Convert bounded observation bytes to unsigned words.
  word :: Nat -> U64
  word value = if value <= 9223372036854775807 then wrapping-i64-to-u64 (nat-to-i64 value) else 0

  -- | Preserve all unsigned observation bits in decimal reporting outside timing.
  natural :: U64 -> Nat
  natural value = u32-to-nat (wrapping-u64-to-u32 value) + u32-to-nat (wrapping-u64-to-u32 (wrapping-shr-u64 value 32)) * 4294967296

  -- | Select the actual public generation operation; no time or entropy provider is substituted.
  draw :: forall (r :: Region). using (io :: Io r) => String -> UuidV7Generator ->{IO r, MVar, Diverge} Result UuidError Uuid
  draw mode generator = if mode == "default" then uuid-new () else if mode == "v4" then uuid-new-v4 () else uuid-new-v7 generator ()

  -- | Observe complete-buffer ownership and RFC fields while leaving random/time payloads nondeterministic.
  observe :: Nat -> Uuid -> (U64, U64)
  observe version value =
    let bytes = uuid-to-bytes value in
    if bytes-len bytes == 16 then
      let valid = nat-div (bytes-get bytes 6) 16 == version && nat-div (bytes-get bytes 8) 64 == 2 in
      (if valid then 1 else 0, word (bytes-get bytes 0 + bytes-get bytes 7 + bytes-get bytes 8 + bytes-get bytes 15))
    else (0, 0)

  -- | Include every real generation and fresh mutable snapshot in the measured public pipeline.
  loop :: forall (r :: Region). using (io :: Io r) => String -> UuidV7Generator -> Nat -> U32 -> U32 -> U64 -> U64 ->{IO r, MVar, Diverge} (U64, U64)
  loop mode generator version count index valid checksum =
    if before index count then case draw mode generator of
      Err error -> loop mode generator version count (bump index) valid (mix checksum 4294967295)
      Ok value -> case observe version value of
        (accepted, bits) -> loop mode generator version count (bump index) (add valid accepted) (mix checksum bits)
    else (valid, checksum)

  -- | Parse bounded iteration metadata before sampling the real monotonic clock.
  decimal :: List Char -> Nat -> Nat
  decimal chars value = case chars of Nil -> value; Cons char rest -> case digit-value char of None -> 0; Some digit -> decimal rest (value * 10 + digit)

  -- | Prepare explicit generator ownership outside timing and report elapsed/count/random observations separately.
  measure :: forall (r :: Region). using (io :: Io r) => String -> Nat ->{IO r, MVar, Diverge} Int
  measure mode iterations = if iterations <= 4294967295 then
    let generator = uuid-v7-generator () in
    let count = wrapping-i64-to-u32 (nat-to-i64 iterations) in
    let version = if mode == "v7" then 7 else 4 in
    let start = clock-monotonic-ns () in
    let result = loop mode generator version count 0 0 14695981039346656037 in
    let end = clock-monotonic-ns () in
    case result of (valid, checksum) ->
      let line = string-concat (nat-to-string (saturating-sub end start)) (string-concat " " (string-concat (nat-to-string (natural valid)) (string-concat " " (string-concat (nat-to-string (natural checksum)) "\n")))) in
      let printed = ioWrite (string-to-bytes line) in if natural valid == iterations then 0 else 1
    else 2

  -- | Keep actual IO and MVar effects explicit on the benchmark entry.
  main :: forall (r :: Region). Unit ->{IO r, MVar, Diverge} Int
  main unit = with (io = newIO ()) in case process-args () of Err error -> 2; Ok args -> case args of Cons mode (Cons count Nil) -> measure mode (decimal (unpack count) 0); other -> 2
