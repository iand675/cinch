-- | Public buffered byte pipelines with bounded machine loops and observable owned results.
module Main where
  import Effect.Buffered.Core
  import Effect.Buffered.Reader
  import Effect.Buffered.Writer
  import Effect.Scanner
  import Effect.Scanner.Split
  import Effect.Clock
  import Effect.Process
  import Effect.Stream
  import Data.Bool
  import Data.Bytes
  import Data.Char
  import Data.Int
  import Data.List
  import Data.Machine
  import Data.Nat
  import Data.Option
  import Data.Result
  import Data.String

  -- | Two independent prepared input owners remain live outside the timed interval.
  data Inputs where
    -- | Alternating variants differ at their first byte when nonempty.
    Prepared :: Bytes -> Bytes -> Inputs

  -- | Advance a bounded iteration without natural-remainder or optional arithmetic allocation.
  prim bump :: U32 -> U32 where
    llvm { %next = add i32 %0, 1
      ret i32 %next
    }

  -- | Compare bounded iteration counters directly.
  prim before :: U32 -> U32 -> Bool where
    llvm { %yes = icmp ult i32 %0, %1
      %result = zext i1 %yes to i8
      ret i8 %result
    }

  -- | Alternate two prepared sources without introducing a checked-remainder result.
  prim phase :: U32 -> Bool where
    llvm { %bit = and i32 %0, 1
      %yes = icmp eq i32 %bit, 0
      %result = zext i1 %yes to i8
      ret i8 %result
    }

  -- | Accumulate a complete wraparound checksum of observable operation results.
  prim mix :: U64 -> U64 -> U64 where
    llvm { %a = xor i64 %0, %1
      %b = mul i64 %a, 1099511628211
      ret i64 %b
    }

  -- | Count immutable header observations with a machine accumulator.
  prim plus :: U64 -> U64 -> U64 where
    llvm { %result = add i64 %0, %1
      ret i64 %result
    }

  -- | Observe a bounded natural result without signed truncation.
  word :: Nat -> U64
  word value = if value <= 9223372036854775807 then let raw = nat-to-i64 value in wrapping-i64-to-u64 raw else 0

  -- | Observe a complete unsigned checksum for decimal reporting.
  natural :: U64 -> Nat
  natural value = let low = wrapping-u64-to-u32 value in let shifted = wrapping-shr-u64 value 32 in
    let high = wrapping-u64-to-u32 shifted in u32-to-nat low + u32-to-nat high * 4294967296

  -- | Parse validated nonnegative harness metadata outside the measured interval.
  decimal :: List Char -> Nat -> Nat
  decimal chars value = case chars of Nil -> value; Cons char rest -> case digit-value char of None -> 0; Some digit -> decimal rest (value * 10 + digit)

  -- | Sample only present bytes and keep allocation length plus byte positions observable.
  sample :: Bytes -> Nat -> Nat
  sample bytes at = if at < bytes-len bytes then bytes-get bytes at else 0

  -- | Fingerprint public byte results without a second full traversal that would obscure buffered pipeline work.
  fingerprint :: Bytes -> U64
  fingerprint bytes = let size = bytes-len bytes in
    word (size + sample bytes 0 + sample bytes 11 + sample bytes (nat-div size 2) + sample bytes (saturating-sub size 1))


  -- | Copy one checked interval into a fresh transport event or allocation control.
  part :: Bytes -> Nat -> Nat -> Bytes
  part input at count = if at + count <= bytes-len input then
    let output = bytes-new count in let copied = bytes-copy-range output input 0 at count in output
    else bytes-new 0

  -- | Construct a plain source with no hidden direct-transfer capability.
  source :: forall r. using (io :: Io r) => Bytes -> Nat -> BufferSource r
  source input at = buffer-source (\wanted -> source-read input at wanted)

  -- | Return fresh bounded byte prefixes, with end-of-input reported on the next request after the final nonempty prefix.
  source-read :: forall r. using (io :: Io r) => Bytes -> Nat -> Nat ->{IO r} (ReadEvent, BufferSource r)
  source-read input at wanted = if at < bytes-len input then
    let remaining = bytes-len input - at in let count = if remaining < wanted then remaining else wanted in
    (ReadEvent (nat-to-int count) (part input at count) None, source input (at + count))
    else (ReadEvent 0 (bytes-new 0) (Some BufferEnd), source input at)

  -- | Construct an inspectable memory sink with only the ordinary byte-write capability.
  sink :: forall r. using (io :: Io r) => Bytes -> Nat -> BufferSink r
  sink output at = buffer-sink (\input -> sink-write output at input)

  -- | Confirm complete bounded writes and return the authoritative advanced output cursor.
  sink-write :: forall r. using (io :: Io r) => Bytes -> Nat -> Bytes ->{IO r} (WriteEvent, BufferSink r)
  sink-write output at input = let count = bytes-len input in
    if at + count <= bytes-len output then
      let copied = bytes-copy-range output input at 0 count in
      (WriteEvent (nat-to-int count) None, sink output (at + count))
    else (WriteEvent 0 (Some (BufferShortWrite count 0)), sink output at)

  -- | Consume each public byte observation with a machine checksum and no unrelated optional counter arithmetic.
  read-bytes :: forall r. using (io :: Io r) => BufferedReader r -> U64 ->{IO r} U64
  read-bytes reader hash = case buffered-read-byte reader of
    (Ok byte, next) -> let value = wrapping-u8-to-u64 byte in let result = plus hash value in read-bytes next result
    (Err BufferEnd, next) -> hash
    other -> 4294967295

  -- | Consume decoded scalars and their actual malformed-byte progress through the public rune reader.
  read-runes :: forall r. using (io :: Io r) => BufferedReader r -> U64 ->{IO r} U64
  read-runes reader hash = case buffered-read-rune reader of
    (Ok (value, width), next) -> let code = char-to-u32 value in let scalar = wrapping-u32-to-u64 code in
      let count = word width in let total = plus scalar count in let result = plus hash total in read-runes next result
    (Err BufferEnd, next) -> hash
    other -> 4294967295

  -- | Observe every public line fragment, including prefix state and independently owned byte output.
  read-lines :: forall r. using (io :: Io r) => BufferedReader r -> U64 ->{IO r} U64
  read-lines reader hash = case buffered-read-line reader of
    (LineEvent payload prefix None, next) -> let value = fingerprint payload in
      let marker = if prefix then plus value 1 else value in let result = mix hash marker in read-lines next result
    (LineEvent payload prefix (Some BufferEnd), next) -> hash
    other -> 4294967295

  -- | Consume fresh public scanner token snapshots; configuration and final error remain observable.
  scan-tokens :: forall r. using (io :: Io r) => Scanner r -> U64 ->{IO r} U64
  scan-tokens scanner hash = case scanner-next scanner of
    (False, next) -> case scanner-error next of None -> hash; other -> 4294967295
    (True, next) -> let token = scanner-bytes next in let value = fingerprint token in
      let result = mix hash value in scan-tokens next result

  -- | Include public writer creation, raw write, one-layer flush and inspectable fresh destination ownership.
  write-once :: forall r. using (io :: Io r) => Bytes ->{IO r} U64
  write-once input = let output = bytes-new (bytes-len input) in
    let writer = buffered-writer-sized 4096 (sink output 0) in
    case buffered-write writer input of
      (WriteEvent count None, next) -> case buffered-flush next of
        (None, final) -> if 0 <= count then let accepted = word (nat-from-int count) in
          let value = fingerprint output in plus value accepted else 4294967295
        other -> 4294967295
      other -> 4294967295

  -- | Include the full public reader-to-sink transfer with its returned count and fresh destination bytes.
  transfer-once :: forall r. using (io :: Io r) => Bytes ->{IO r} U64
  transfer-once input = let output = bytes-new (bytes-len input) in
    let reader = buffered-reader-sized 4096 (source input 0) in
    case buffered-write-to reader (sink output 0) of
      (TransferEvent count None, next, destination) -> if ge-i64 count 0 then
        let accepted = wrapping-i64-to-u64 count in let value = fingerprint output in plus value accepted
        else 4294967295
      other -> 4294967295

  -- | Select one prepared input owner without copying or rebuilding it inside the operation loop.
  selected :: Inputs -> Bool -> Bytes
  selected inputs first = case inputs of Prepared a b -> if first then a else b

  -- | Run the public byte pipeline on alternating live owners with bounded machine iteration state.
  byte-loop :: forall r. using (io :: Io r) => Inputs -> U32 -> U32 -> U64 ->{IO r} U64
  byte-loop inputs count index hash = if before index count then
    let first = phase index in let input = selected inputs first in
    let value = let reader = buffered-reader-sized 4096 (source input 0) in read-bytes reader 0 in
    let next = bump index in let result = mix hash value in byte-loop inputs count next result
    else hash

  -- | Run the public rune pipeline on alternating live owners with bounded machine iteration state.
  rune-loop :: forall r. using (io :: Io r) => Inputs -> U32 -> U32 -> U64 ->{IO r} U64
  rune-loop inputs count index hash = if before index count then
    let first = phase index in let input = selected inputs first in
    let value = let reader = buffered-reader-sized 4096 (source input 0) in read-runes reader 0 in
    let next = bump index in let result = mix hash value in rune-loop inputs count next result
    else hash

  -- | Run the public line pipeline on alternating live owners with bounded machine iteration state.
  line-loop :: forall r. using (io :: Io r) => Inputs -> U32 -> U32 -> U64 ->{IO r} U64
  line-loop inputs count index hash = if before index count then
    let first = phase index in let input = selected inputs first in
    let value = let reader = buffered-reader-sized 4096 (source input 0) in read-lines reader 0 in
    let next = bump index in let result = mix hash value in line-loop inputs count next result
    else hash

  -- | Run the public write pipeline on alternating live owners with bounded machine iteration state.
  write-loop :: forall r. using (io :: Io r) => Inputs -> U32 -> U32 -> U64 ->{IO r} U64
  write-loop inputs count index hash = if before index count then
    let first = phase index in let input = selected inputs first in
    let value = write-once input in
    let next = bump index in let result = mix hash value in write-loop inputs count next result
    else hash

  -- | Run the public transfer pipeline on alternating live owners with bounded machine iteration state.
  transfer-loop :: forall r. using (io :: Io r) => Inputs -> U32 -> U32 -> U64 ->{IO r} U64
  transfer-loop inputs count index hash = if before index count then
    let first = phase index in let input = selected inputs first in
    let value = transfer-once input in
    let next = bump index in let result = mix hash value in transfer-loop inputs count next result
    else hash

  -- | Run the public scan-line pipeline on alternating live owners with bounded machine iteration state.
  scan-line-loop :: forall r. using (io :: Io r) => Inputs -> U32 -> U32 -> U64 ->{IO r} U64
  scan-line-loop inputs count index hash = if before index count then
    let first = phase index in let input = selected inputs first in
    let value = let tokenizer = scanner (source input 0) in scan-tokens tokenizer 0 in
    let next = bump index in let result = mix hash value in scan-line-loop inputs count next result
    else hash

  -- | Run the public scan-rune pipeline on alternating live owners with bounded machine iteration state.
  scan-rune-loop :: forall r. using (io :: Io r) => Inputs -> U32 -> U32 -> U64 ->{IO r} U64
  scan-rune-loop inputs count index hash = if before index count then
    let first = phase index in let input = selected inputs first in
    let value = let tokenizer = scanner (source input 0) in (case scanner-split tokenizer (scan-split scan-runes) of Ok configured -> scan-tokens configured 0; other -> 4294967295) in
    let next = bump index in let result = mix hash value in scan-rune-loop inputs count next result
    else hash

  -- | Run the public scan-word pipeline on alternating live owners with bounded machine iteration state.
  scan-word-loop :: forall r. using (io :: Io r) => Inputs -> U32 -> U32 -> U64 ->{IO r} U64
  scan-word-loop inputs count index hash = if before index count then
    let first = phase index in let input = selected inputs first in
    let value = let tokenizer = scanner (source input 0) in (case scanner-split tokenizer (scan-split scan-words) of Ok configured -> scan-tokens configured 0; other -> 4294967295) in
    let next = bump index in let result = mix hash value in scan-word-loop inputs count next result
    else hash

  -- | Run the public copy pipeline on alternating live owners with bounded machine iteration state.
  copy-loop :: forall r. using (io :: Io r) => Inputs -> U32 -> U32 -> U64 ->{IO r} U64
  copy-loop inputs count index hash = if before index count then
    let first = phase index in let input = selected inputs first in
    let value = let output = part input 0 (bytes-len input) in fingerprint output in
    let next = bump index in let result = mix hash value in copy-loop inputs count next result
    else hash

  -- | Select one cold prepared byte from ASCII lines, truncated mixed UTF-8 or arbitrary byte patterns.
  pattern-byte :: Bytes -> Nat -> Nat -> Nat
  pattern-byte unicode pattern at = if pattern == 1 then
    let index = nat-rem at 11 in if index < bytes-len unicode then bytes-get unicode index else 0
    else if pattern == 2 then nat-rem (at * 13 + 7) 256
    else if nat-rem at 64 == 63 then 10 else 65 + nat-rem at 26

  -- | Prepare complete byte owners outside the measured interval.
  fill :: Bytes -> Bytes -> Nat -> Nat -> Bytes
  fill output unicode pattern at = if at < bytes-len output then
    let value = pattern-byte unicode pattern at in
    let stored = if value <= 255 then bytes-set output at value else () in fill output unicode pattern (at + 1)
    else output

  -- | Keep two prepared owners live; their first-byte variants prevent whole-operation constant folding.
  prepare :: Nat -> Nat -> Inputs
  prepare size pattern = let unicode = string-to-bytes "Aé β😀\n" in
    let first = fill (bytes-new size) unicode pattern 0 in let second = part first 0 size in
    if 0 < bytes-len first && 0 < bytes-len second then
      let a = bytes-set first 0 65 in let b = bytes-set second 0 66 in Prepared first second
    else Prepared first second

  -- | Dispatch outside the measured operation loops.
  perform :: forall r. using (io :: Io r) => String -> Inputs -> U32 ->{IO r} U64
  perform mode inputs count = if mode == "byte" then byte-loop inputs count 0 14695981039346656037
    else if mode == "rune" then rune-loop inputs count 0 14695981039346656037
    else if mode == "line" then line-loop inputs count 0 14695981039346656037
    else if mode == "write" then write-loop inputs count 0 14695981039346656037
    else if mode == "transfer" then transfer-loop inputs count 0 14695981039346656037
    else if mode == "scan-line" then scan-line-loop inputs count 0 14695981039346656037
    else if mode == "scan-rune" then scan-rune-loop inputs count 0 14695981039346656037
    else if mode == "scan-word" then scan-word-loop inputs count 0 14695981039346656037
    else if mode == "copy" then copy-loop inputs count 0 14695981039346656037
    else 0

  -- | Keep input preparation and command parsing outside timing, then report nanoseconds and an unsigned checksum.
  measure :: forall r. using (io :: Io r) => String -> Nat -> Nat -> Nat ->{IO r} Int
  measure mode size iterations pattern = if size <= 65536 && iterations <= 4294967295 then
    let inputs = prepare size pattern in let raw = nat-to-i64 iterations in let count = wrapping-i64-to-u32 raw in
    let start = clock-monotonic-ns () in let hash = perform mode inputs count in let end = clock-monotonic-ns () in
    let elapsed = saturating-sub end start in let result = natural hash in
    let printed = ioWrite (string-to-bytes (string-concat (nat-to-string elapsed) (string-concat " " (string-concat (nat-to-string result) "\n")))) in 0
    else 2

  -- | Read validated operation, byte length, iteration count and byte-pattern metadata.
  main :: Unit ->{IO r} Int
  main unit = with (io = newIO ()) in case process-args () of
    Err error -> 2
    Ok args -> case args of
      Cons mode (Cons size (Cons iterations (Cons pattern Nil))) -> measure mode (decimal (unpack size) 0) (decimal (unpack iterations) 0) (decimal (unpack pattern) 0)
      other -> 2
