+  -- | Extract the packed previous-link lane without a provider call or a wide result allocation.
+  prim offset-low :: U128 -> U64 where
+    llvm {
+      %low = trunc i128 %0 to i64
+      ret i64 %low
+    }
+
+  -- | Extract the packed following-link lane by its numeric position, independently of host endianness.
+  prim offset-high :: U128 -> U64 where
