%YAML 1.2
---
# SafeLang syntax for Sublime Text.
# Reserved words: specifications/surface-syntax-and-grammar.md (identical
# to compiler/src/lexer.rs `keyword`).
name: SafeLang
file_extensions: [lang]
scope: source.safelang

variables:
  ident_char: '[A-Za-z0-9_''-]'
  dash_ident: '[a-z_][A-Za-z0-9_''-]*'
  con_ident: '[A-Z][A-Za-z0-9_''-]*'

contexts:
  main:
    - include: comments
    - include: strings
    - include: literals
    - include: attributes
    - include: keywords
    - include: operators
    - include: identifiers

  comments:
    - match: '--.*$'
      scope: comment.line.double-dash.safelang
    - match: '\{-'
      scope: punctuation.definition.comment.safelang
      push:
        - meta_scope: comment.block.safelang
        - match: '\{-'
          push: block-comment-inner
        - match: '-\}'
          pop: true
  block-comment-inner:
    - meta_scope: comment.block.safelang
    - match: '\{-'
      push: block-comment-inner
    - match: '-\}'
      pop: true

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.safelang
      push:
        - meta_scope: string.quoted.double.safelang
        - match: '\\[\\\"''nrt]|\\u\{[0-9A-Fa-f]+\}'
          scope: constant.character.escape.safelang
        - match: '"'
          scope: punctuation.definition.string.end.safelang
          pop: true

  literals:
    # Tick rule (D123): tick, one character, tick is a Char and wins.
    - match: '''\([^''\\]|\\[\\''\"nrt]|\\u\{[0-9A-Fa-f]+\}\)'''
      scope: constant.character.safelang
    - match: "''{{con_ident}}"
      scope: entity.name.type.safelang
    - match: '''{{dash_ident}}'
      scope: constant.other.symbol.safelang
    - match: '-?\d[\d_]*(\.\d[\d_]*)?([eE][+-]?\d+)?'
      scope: constant.numeric.safelang
    - match: '-?0[xX][0-9A-Fa-f_]+'
      scope: constant.numeric.hex.safelang

  attributes:
    - match: '#\[[A-Za-z_][A-Za-z0-9_.-]*'
      scope: meta.annotation.safelang
      push:
        - meta_scope: meta.annotation.safelang
        - match: '\]'
          pop: true

  keywords:
    - match: '\b(module|import|export|as)\b'
      scope: keyword.control.import.safelang
    - match: '\b(data|record|codata|effect|signature|instance|implicit|opaque|type|foreign|ccall|component|prim|law|contract|rewrite|target|upgrade|generate|infix|infixl|infixr|proof|spec|stage|corec|macro)\b'
      scope: storage.type.declaration.safelang
    - match: '\b(forall|Sigma|using|in|let|letrec|where|of)\b'
      scope: keyword.other.safelang
    - match: '\b(if|then|else|case)\b'
      scope: keyword.control.conditional.safelang
    - match: '\b(do)\b'
      scope: keyword.control.loop.safelang
    - match: '\b(handle|with|match|replace|require|justify|to)\b'
      scope: keyword.control.safelang
    - match: '\b(safety|liveness|recurrence|stability|always|eventually|recur|stable|assume)\b'
      scope: keyword.other.contract.safelang
    - match: '\b(erased|own)\b'
      scope: storage.modifier.safelang
    - match: '\b(return|resume)\b'
      scope: keyword.control.flow.safelang
    # Contextual words (usable as identifiers elsewhere; D221-D227).
    - match: '\b(handler|unsafe|when|uses|immarg|for|migrate|related|attributes|replaceable|specialized|llvm|wasm|asm|clr|jvm)\b'
      scope: variable.other.contextual.safelang

  operators:
    # `$` continues an operator run (`<$>`) but never starts one.
    - match: '[!#%&*+/<=>?@^|~:-]+|\$[!#%&*+/<=>?@^|~:$-]+'
      scope: keyword.operator.safelang
    - match: '[()\[\]{},;\\]'
      scope: punctuation.separator.safelang

  identifiers:
    - match: '{{con_ident}}'
      scope: entity.name.type.safelang
    - match: '{{dash_ident}}'
      scope: variable.other.safelang
