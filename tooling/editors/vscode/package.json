{
  "name": "safelang",
  "displayName": "SafeLang",
  "description": "SafeLang surface syntax (draft 0.2 plus local amendments) with LSP hookup",
  "version": "0.1.0",
  "publisher": "safelang-design-repo",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:safelang"],
  "contributes": {
    "languages": [
      {
        "id": "safelang",
        "aliases": ["SafeLang", "safelang"],
        "extensions": [".lang"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "safelang",
        "scopeName": "source.safelang",
        "path": "./syntaxes/safelang.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "SafeLang",
      "properties": {
        "safelang.lsp.command": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command that runs the SafeLang language server over stdio. Empty uses this extension's launcher, which drives `safelang::lsp::LspServer::run` via `tooling/lsp-driver` (the compiler binary has no `lsp` subcommand today). Set to `safelang lsp` once that subcommand lands."
        },
        "safelang.lsp.trace": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
