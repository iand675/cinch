{
  "name": "cinch",
  "displayName": "Cinch",
  "description": "Cinch surface syntax (draft 0.2 plus local amendments) with LSP hookup",
  "version": "0.1.0",
  "publisher": "cinch-design-repo",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:cinch"],
  "contributes": {
    "languages": [
      {
        "id": "cinch",
        "aliases": ["Cinch", "cinch"],
        "extensions": [".cinch"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cinch",
        "scopeName": "source.cinch",
        "path": "./syntaxes/cinch.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Cinch",
      "properties": {
        "cinch.lsp.command": {
          "type": "string",
          "default": "",
          "markdownDescription": "Command that runs the Cinch language server over stdio. Empty uses this extension's launcher, which drives `cinch::lsp::LspServer::run` via `tooling/lsp-driver` (the compiler binary has no `lsp` subcommand today). Set to `cinch lsp` once that subcommand lands."
        },
        "cinch.lsp.trace": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
