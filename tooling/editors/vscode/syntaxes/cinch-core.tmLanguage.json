{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Cinch Core",
  "scopeName": "source.cinch-core",
  "fileTypes": ["core"],
  "firstLineMatch": "^core \\d+$",
  "patterns": [
    { "include": "#comments" },
    { "include": "#header" },
    { "include": "#units" },
    { "include": "#classes" },
    { "include": "#annotations" },
    { "include": "#literals" },
    { "include": "#forms" },
    { "include": "#keywords" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-dash.cinch-core", "match": "--.*$" }
      ]
    },
    "header": {
      "patterns": [
        { "name": "keyword.other.header.cinch-core", "match": "^core\\b" },
        {
          "match": "^(module)\\s+(\\S+)",
          "captures": {
            "1": { "name": "keyword.other.header.cinch-core" },
            "2": { "name": "entity.name.namespace.cinch-core" }
          }
        },
        {
          "match": "^(target)\\s+(\\S+)\\s+(opt-level)\\s+(\\d+)",
          "captures": {
            "1": { "name": "keyword.other.header.cinch-core" },
            "2": { "name": "constant.other.triple.cinch-core" },
            "3": { "name": "keyword.other.header.cinch-core" },
            "4": { "name": "constant.numeric.version.cinch-core" }
          }
        },
        {
          "match": "^(source)\\s+(sha256:[0-9A-Fa-f]+)",
          "captures": {
            "1": { "name": "keyword.other.header.cinch-core" },
            "2": { "name": "constant.other.digest.cinch-core" }
          }
        }
      ]
    },
    "units": {
      "patterns": [
        {
          "match": "^(unit)\\s+(\\$d\\.[^\\s:]+)",
          "captures": {
            "1": { "name": "keyword.other.unit.cinch-core" },
            "2": { "name": "variable.other.dictionary.cinch-core" }
          }
        },
        {
          "match": "^(unit)\\s+([^\\s:]+)\\s*(::)",
          "captures": {
            "1": { "name": "keyword.other.unit.cinch-core" },
            "2": { "name": "entity.name.function.cinch-core" },
            "3": { "name": "keyword.operator.type.cinch-core" }
          }
        },
        { "name": "keyword.other.unit.cinch-core", "match": "^end$" },
        {
          "match": "^\\s+(body|params)\\b",
          "captures": { "1": { "name": "keyword.other.unit.cinch-core" } }
        },
        { "name": "keyword.other.unit.cinch-core", "match": "^\\s+static\\b" },
        {
          "name": "variable.other.dictionary.cinch-core",
          "match": "\\$d\\.[A-Za-z0-9_.]+"
        },
        { "name": "variable.other.dictionary.cinch-core", "match": "\\$static\\b" }
      ]
    },
    "classes": {
      "patterns": [
        {
          "match": "@(owned|borrowed|lent|uncounted|immortal)\\b",
          "captures": {
            "1": { "name": "storage.modifier.ownership.cinch-core" }
          }
        },
        {
          "name": "storage.modifier.ownership.cinch-core",
          "match": "\\b(owned|borrowed|lent|uncounted|immortal)\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        { "name": "storage.type.annotation.cinch-core", "match": "@[A-Za-z_]+" }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "string.quoted.double.bytes.cinch-core",
          "match": "\\bb(\")((?:[^\"\\\\]|\\\\.)*)(\")",
          "captures": {
            "1": { "name": "punctuation.definition.string.begin.cinch-core" },
            "3": { "name": "punctuation.definition.string.end.cinch-core" }
          }
        },
        {
          "name": "string.quoted.double.cinch-core",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.cinch-core",
              "match": "\\\\[\\\\\"nt]|\\\\x[0-9A-Fa-f]{2}"
            }
          ]
        },
        { "name": "constant.numeric.cinch-core", "match": "-?\\b\\d+\\b" }
      ]
    },
    "forms": {
      "patterns": [
        {
          "match": "(?<=\\()(int|nat|bytes|string|sym|bool|unit|local|global|ctor|prim|foreign|app|lam|dictproj|proj|instdict|let|if|case|alt|pat|dup|drop|release|boxinit|boxget|boxclear|refset|quote|splice|syntaxlit|demand)\\b",
          "captures": {
            "1": { "name": "support.function.form.cinch-core" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.other.type.cinch-core", "match": "\\b(forall|refine|with)\\b" },
        {
          "name": "constant.language.boolean.cinch-core",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "keyword.other.unit.cinch-core",
          "match": "\\b(moved|rest|from)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.cinch-core", "match": "->|::|=>|<=|>=" },
        { "name": "keyword.operator.cinch-core", "match": "[-<>=|:,]" },
        { "name": "punctuation.section.group.cinch-core", "match": "[][(){}]" }
      ]
    }
  }
}
