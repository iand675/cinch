#!/usr/bin/env bash
# Launch the SafeLang language server over stdio.
#
# This is the real LSP invocation: `safelang::lsp::LspServer::run` over
# stdio with Content-Length framed JSON-RPC (see compiler/src/lsp.rs and
# compiler/tests/lsp.rs). The compiler binary has no `lsp` subcommand
# today, so this builds and runs the driver crate in tooling/lsp-driver.
# Inside the devenv shell `cargo` and `rustc` are provided.
set -euo pipefail

root="$(cd "$(dirname "$0")/../../.." && pwd)"
driver="$root/tooling/lsp-driver"

if command -v safelang >/dev/null 2>&1 && safelang lsp --help >/dev/null 2>&1; then
  # The subcommand exists (future): use it verbatim.
  exec safelang lsp
fi

cargo run --quiet --manifest-path "$driver/Cargo.toml" --release -- "$@"
