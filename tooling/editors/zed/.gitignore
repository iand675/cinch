# Zed compiles a dev extension inside its source directory: the extension
# wasm, the crate's target dir, the grammar clones it makes, and the compiled
# grammars all land here.
target/
extension.wasm
grammars/
# sync-grammar.sh builds one throwaway repository per grammar (grammar-repo
# for cinch, grammar-repo-core for cinch-core) and pins the revision in
# extension.toml. Both are machine-local build products.
grammar-repo/
grammar-repo-core/
